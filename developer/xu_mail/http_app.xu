@main

#encoding/json
#net
#net/http
#os
#strings

struct Api {
    status int
    ctype string
    body string
}

fn json_err(status int, msg string) Api {
    << Api{status: status, ctype: "application/json; charset=utf-8", body: "{\"ok\":false,\"error\":" + json.quote(&msg) + "}"}
}

fn json_ok_body(body string) Api {
    << Api{status: 200, ctype: "application/json; charset=utf-8", body: body}
}

fn json_ok() Api {
    << json_ok_body("{\"ok\":true}")
}

fn current_user(q string) string {
    u := form_val(&q, "user")
    if u.len == 0 {
        << "ada"
    }
    << sanitize_mailbox(u)
}

fn mail_item_json(id string, from_addr string, to_addr string, subject string, folder string, date_ns int, spam int, score int, body string, with_body bool) string {
    dt := format_ns(date_ns)
    mut out := "{"
    out = out + "\"id\":" + json.quote(&id)
    out = out + ",\"from\":" + json.quote(&from_addr)
    out = out + ",\"to\":" + json.quote(&to_addr)
    out = out + ",\"subject\":" + json.quote(&subject)
    out = out + ",\"folder\":" + json.quote(&folder)
    out = out + ",\"date\":" + json.quote(&dt)
    out = out + ",\"date_ns\":" + str(date_ns)
    out = out + ",\"spam\":" + str(spam)
    out = out + ",\"score\":" + str(score)
    if with_body {
        out = out + ",\"body\":" + json.quote(&body)
    }
    out = out + "}"
    << out
}

fn api_meta(user string) Api {
    in_n := count_folder(&user, "inbox")
    se_n := count_folder(&user, "sent")
    sp_n := count_folder(&user, "spam")
    gs := list_groups()
    mut glist := "["
    for i in 0:gs.len {
        if i > 0 {
            glist = glist + ","
        }
        nm := gs[i].name + ""
        glist = glist + json.quote(&nm)
    }
    glist = glist + "]"
    body := "{\"ok\":true,\"user\":" + json.quote(&user) + ",\"domain\":\"xu.local\",\"inbox\":" + str(in_n) + ",\"sent\":" + str(se_n) + ",\"spam\":" + str(sp_n) + ",\"groups\":" + glist + ",\"threshold\":" + str(spam_threshold()) + "}"
    << json_ok_body(body)
}

fn api_mails(user string, folder string, group string) Api {
    ms := list_mails(&user, folder[0:folder.len])
    mut arr := "["
    mut n := 0
    for i in 0:ms.len {
        id := ms[i].id + ""
        from_addr := ms[i].from_addr + ""
        to_addr := ms[i].to_addr + ""
        subject := ms[i].subject + ""
        fold := ms[i].folder + ""
        body := ms[i].body + ""
        if group.len > 0 {
            ct := find_contact(&from_addr)
            if ct.group_name != group {
                ->
            }
        }
        if n > 0 {
            arr = arr + ","
        }
        n = n + 1
        arr = arr + mail_item_json(id, from_addr, to_addr, subject, fold, ms[i].date_ns, ms[i].spam, ms[i].score, body, false)
    }
    arr = arr + "]"
    body := "{\"ok\":true,\"folder\":" + json.quote(&folder) + ",\"mails\":" + arr + "}"
    << json_ok_body(body)
}

fn api_mail(user string, id string) Api {
    m := load_mail(id) or (err) {
        << json_err(404, err.msg())
    }
    if m.mailbox != user {
        << json_err(403, "这封信不属于当前用户")
    }
    id2 := m.id + ""
    from_addr := m.from_addr + ""
    to_addr := m.to_addr + ""
    subject := m.subject + ""
    fold := m.folder + ""
    body := m.body + ""
    item := mail_item_json(id2, from_addr, to_addr, subject, fold, m.date_ns, m.spam, m.score, body, true)
    << json_ok_body("{\"ok\":true,\"mail\":" + item + "}")
}

fn api_compose(user string, raw string) Api {
    msg := do_compose(user + "", raw)
    if msg.len > 0 {
        << json_err(400, msg)
    }
    << json_ok()
}

fn do_compose(user string, raw string) string {
    mut from := form_val(&raw, "from")
    to := form_val(&raw, "to")
    subject := form_val(&raw, "subject")
    body := form_val(&raw, "body")
    if from.len == 0 {
        from = user[0:user.len] + "@xu/local"
    }
    tos := split_addrs(&to)
    if tos.len == 0 {
        << "请填写收件人"
    }
    for i in 0:tos.len {
        dest := tos[i] + ""
        box := addr_mailbox(&dest)
        if box.len == 0 {
            << "只投递 @xu/local 地址：" + dest
        }
        deliver_local(from[0:from.len], dest[0:dest.len], subject[0:subject.len], body[0:body.len], "inbox") or (err) {
            << err.msg()
        }
    }
    mut sent := empty_mail()
    sent.id = alloc_id(user[0:user.len] + "-sent")
    sent.from_addr = from
    sent.to_addr = to
    sent.subject = subject
    sent.body = body
    sent.date_ns = now_ns()
    sent.mailbox = user[0:user.len]
    sent.folder = "sent"
    save_mail(&sent) or (err) {
        << err.msg()
    }
    << ""
}

fn api_contacts() Api {
    cs := list_contacts()
    mut arr := "["
    for i in 0:cs.len {
        if i > 0 {
            arr = arr + ","
        }
        em := cs[i].email + ""
        nm := cs[i].name + ""
        g := cs[i].group_name + ""
        arr = arr + "{\"email\":" + json.quote(&em) + ",\"name\":" + json.quote(&nm) + ",\"group\":" + json.quote(&g) + "}"
    }
    arr = arr + "]"
    << json_ok_body("{\"ok\":true,\"contacts\":" + arr + "}")
}

fn api_groups() Api {
    gs := list_groups()
    mut arr := "["
    for i in 0:gs.len {
        if i > 0 {
            arr = arr + ","
        }
        nm := gs[i].name + ""
        arr = arr + json.quote(&nm)
    }
    arr = arr + "]"
    << json_ok_body("{\"ok\":true,\"groups\":" + arr + "}")
}

fn api_rules() Api {
    rs := list_rules()
    mut arr := "["
    for i in 0:rs.len {
        if i > 0 {
            arr = arr + ","
        }
        w := rs[i] + ""
        arr = arr + json.quote(&w)
    }
    arr = arr + "]"
    << json_ok_body("{\"ok\":true,\"rules\":" + arr + ",\"threshold\":" + str(spam_threshold()) + "}")
}

fn api_dispatch(method string, path string, user string, q string, raw string) Api {
    if method == "GET" && path == "/api/meta" {
        << api_meta(user + "")
    }
    if method == "GET" && path == "/api/mails" {
        << api_mails(user + "", form_val(&q, "folder"), form_val(&q, "group"))
    }
    if method == "GET" && path == "/api/mail" {
        << api_mail(user + "", form_val(&q, "id"))
    }
    if method == "GET" && path == "/api/contacts" {
        << api_contacts()
    }
    if method == "GET" && path == "/api/groups" {
        << api_groups()
    }
    if method == "GET" && path == "/api/rules" {
        << api_rules()
    }
    if method == "POST" && path == "/api/compose" {
        << api_compose(user + "", raw)
    }
    mut id := form_val(&raw, "id")
    if id.len == 0 {
        id = form_val(&q, "id")
    }
    if method == "POST" && path == "/api/mail/delete" {
        delete_mail(id)
        << json_ok()
    }
    if method == "POST" && path == "/api/mail/spam" {
        set_folder(id, "spam") or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    if method == "POST" && path == "/api/mail/ham" {
        set_folder(id, "inbox") or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    if method == "POST" && path == "/api/contacts" {
        add_contact(form_val(&raw, "email"), form_val(&raw, "name"), form_val(&raw, "group")) or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    if method == "POST" && path == "/api/contacts/delete" {
        del_contact(form_val(&raw, "email")) or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    if method == "POST" && path == "/api/groups" {
        add_group(form_val(&raw, "name")) or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    if method == "POST" && path == "/api/groups/delete" {
        del_group(form_val(&raw, "name")) or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    if method == "POST" && path == "/api/rules" {
        add_rule(form_val(&raw, "word")) or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    if method == "POST" && path == "/api/rules/delete" {
        del_rule(form_val(&raw, "word")) or (err) {
            << json_err(400, err.msg())
        }
        << json_ok()
    }
    << json_err(404, "no such api")
}

fn static_name(path string) string {
    if path == "/" || path == "/index.html" {
        << "index.html"
    }
    if path == "/app.css" {
        << "app.css"
    }
    if path == "/app.js" {
        << "app.js"
    }
    if path == "/xu_classic.svg" {
        << "xu_classic.svg"
    }
    << ""
}

fn static_ctype(name string) string {
    if name == "index.html" {
        << "text/html; charset=utf-8"
    }
    if name == "app.css" {
        << "text/css; charset=utf-8"
    }
    if name == "app.js" {
        << "text/javascript; charset=utf-8"
    }
    if name == "xu_classic.svg" {
        << "image/svg+xml"
    }
    << "application/octet-stream"
}

fn serve_static(path string) Api {
    name := static_name(path)
    if name.len == 0 {
        << Api{status: 404, ctype: "text/plain; charset=utf-8", body: "not found\n"}
    }
    full := www_root() + "/" + name
    raw := os.read(full) or (err) {
        << Api{status: 404, ctype: "text/plain; charset=utf-8", body: "missing " + name + "\n"}
    }
    << Api{status: 200, ctype: static_ctype(name), body: raw}
}

fn cut_url_path(p string) string {
    mut i := 0
    while i < p.len {
        if (p[i] & 255) == 63 {
            << p[0:i]
        }
        i = i + 1
    }
    << p
}

fn cut_url_query(p string) string {
    mut i := 0
    while i < p.len {
        if (p[i] & 255) == 63 {
            << p[(i + 1):p.len]
        }
        i = i + 1
    }
    << ""
}

fn handle_http(fd int) {
    mut req := http.new_request()
    req.read(fd) or (err) {
        msg := err.msg()
        http.write(fd, 400, "text/plain; charset=utf-8", &msg) or (e2) { << }
        net.conn_close(fd) or (e3) { << }
        <<
    }
    qraw := req.path()
    method := req.method()
    raw := req.body()
    path := cut_url_path(qraw[0:qraw.len])
    q := cut_url_query(qraw[0:qraw.len])
    user := current_user(q + "")
    mut out := Api{status: 404, ctype: "text/plain; charset=utf-8", body: "not found\n"}
    if strings.has_prefix(&path, "/api/") {
        out = api_dispatch(method, path, user + "", q + "", raw)
    } else if method == "GET" || method == "HEAD" {
        out = serve_static(path)
    } else {
        out = Api{status: 405, ctype: "text/plain; charset=utf-8", body: "method not allowed\n"}
    }
    http.write(fd, out.status, out.ctype, &out.body) or (err) { << }
    net.conn_close(fd) or (err) { << }
}
