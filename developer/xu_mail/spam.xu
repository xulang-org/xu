@main

#strings

fn count_urls(s &string) int {
    a := strings.count(s, "http://")
    b := strings.count(s, "https://")
    << a + b
}

fn caps_ratio(s &string) int {
    mut letters := 0
    mut upper := 0
    for i in 0:s.len {
        c := s[i] & 255
        if c >= 65 && c <= 90 {
            letters = letters + 1
            upper = upper + 1
        } else if c >= 97 && c <= 122 {
            letters = letters + 1
        }
    }
    if letters < 8 {
        << 0
    }
    den := letters
    if den < 1 {
        << 0
    }
    << (upper * 100) / den
}

fn spam_score(from_addr string, subject string, body string) int {
    mut score := 0
    blob_src := from_addr + "\n" + subject + "\n" + body
    blob := strings.to_lower(&blob_src)
    rules := list_rules()
    for i in 0:rules.len {
        w := rules[i] + ""
        wl := strings.to_lower(&w)
        if wl.len == 0 {
            ->
        }
        if strings.contains(&blob, wl) {
            score = score + 12
        }
    }
    sub := subject + ""
    cap := caps_ratio(&sub)
    if cap >= 80 {
        score = score + 18
    }
    urls := count_urls(&body)
    if urls >= 4 {
        score = score + 16
    } else if urls >= 2 {
        score = score + 6
    }
    if strings.trim_space(&from_addr).len == 0 {
        score = score + 20
    }
    if strings.trim_space(&subject).len == 0 {
        score = score + 8
    }
    ang := extract_angle(from_addr + "")
    c := find_contact(&ang)
    if c.email.len > 0 {
        g := c.group_name + ""
        if g == "其它" {
            score = score - 4
        } else {
            score = score - 22
        }
    }
    if score < 0 {
        << 0
    }
    << score
}

fn spam_threshold() int {
    << 28
}

fn apply_spam(m &mut Mail) {
    sc := spam_score(m.from_addr + "", m.subject + "", m.body + "")
    m.score = sc
    if sc >= spam_threshold() {
        m.spam = 1
        if m.folder == "inbox" {
            m.folder = "spam"
        }
    } else {
        m.spam = 0
    }
}

fn deliver_local(from_addr string, to_addr string, subject string, body string, folder string) Mail {
    mut m := empty_mail()
    m.from_addr = from_addr + ""
    m.to_addr = to_addr + ""
    m.subject = subject + ""
    m.body = body + ""
    m.date_ns = now_ns()
    mut box := addr_mailbox(&to_addr)
    if box.len == 0 {
        box = sanitize_mailbox(to_addr + "")
    }
    m.mailbox = box + ""
    mut fold := folder + ""
    if fold.len == 0 {
        fold = "inbox"
    }
    m.folder = fold + ""
    m.id = alloc_id(box + "-" + fold)
    if m.folder == "inbox" {
        apply_spam(mut &m)
    }
    save_mail(&m) or (err) {
        >> err
    }
    << m
}
