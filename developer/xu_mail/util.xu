@main

#errors
#net
#net/url
#os
#strings

fn data_root() string {
    av := args()
    if av.len >= 2 {
        a1 := av[1] + ""
        if a1 != "send" && a1 != "serve" && a1 != "smtp" && a1 != "pop3" {
            << a1
        }
        if av.len >= 3 && (a1 == "serve" || a1 == "smtp" || a1 == "pop3") {
            << av[2] + ""
        }
    }
    env := os.getenv("XU_MAIL_DATA")
    if env.len > 0 {
        << env
    }
    << "developer/xu_mail/data"
}

fn mail_dir() string {
    << data_root() + "/mail"
}

fn contacts_path() string {
    << data_root() + "/contacts.txt"
}

fn groups_path() string {
    << data_root() + "/groups.txt"
}

fn rules_path() string {
    << data_root() + "/spam_rules.txt"
}

fn www_root() string {
    env := os.getenv("XU_MAIL_WWW")
    if env.len > 0 {
        << env
    }
    << "developer/xu_mail/www"
}

fn crlf() string {
    << "\r\n"
}

fn read_or_empty(path string) string {
    << os.read(path) or (err) {
        << ""
    }
}

fn write_text(path string, data string) int {
    << os.write(path, data) or (err) {
        >> err
    }
}

fn append_line(path string, line string) int {
    mut f := os.open_append(path) or (err) {
        >> err
    }
    row := line + "\n"
    f.write(row) or (err) {
        >> err
    }
    f.close() or (err) {
        << 0
    }
    << 0
}

fn is_ident_char(c int) bool {
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 46 || c == 95 || c == 45 {
        << true
    }
    << false
}

fn sanitize_id(s string) string {
    mut out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if is_ident_char(c) {
            out = out + string_from_byte(c)
        }
    }
    << out
}

fn sanitize_mailbox(s string) string {
    raw := strings.trim_space(&s)
    at := strings.last_index(&raw, "@")
    mut local := raw[0:raw.len]
    if at > 0 {
        local = raw[0:at]
    }
    id := sanitize_id(local)
    if id.len == 0 {
        << "ada"
    }
    low := strings.to_lower(&id)
    << low
}

fn addr_mailbox(addr &string) string {
    raw := strings.trim_space(addr)
    at := strings.last_index(&raw, "@")
    if at <= 0 {
        << sanitize_mailbox(raw)
    }
    user := raw[0:at] + ""
    domain := raw[(at + 1):raw.len] + ""
    dlow := strings.to_lower(&domain)
    if dlow == "xu/local" || dlow == "localhost" || dlow == "127.0.0.1" {
        << sanitize_mailbox(user)
    }
    << ""
}

fn extract_angle(s string) string {
    src := strings.trim_space(&s)
    lt := strings.index_of(&src, "<")
    if lt >= 0 {
        gt := strings.last_index(&src, ">")
        if gt > lt {
            inner := src[(lt + 1):gt] + ""
            << strings.trim_space(&inner)
        }
    }
    << src
}

fn header_get(raw &string, name string) string {
    want := strings.to_lower(&name)
    src := raw + ""
    mut i := 0
    mut last_key := ""
    mut last_val := ""
    mut found := ""
    while i < src.len {
        mut line_end := i
        while line_end < src.len {
            if (src[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        mut line := ""
        if line_end > i {
            line = src[i:line_end] + ""
        }
        if line.len > 0 && (line[line.len - 1] & 255) == 13 {
            line = line[0:(line.len - 1)] + ""
        }
        if line.len == 0 {
            << found
        }
        c0 := line[0] & 255
        if (c0 == 32 || c0 == 9) && last_key.len > 0 {
            extra := strings.trim_space(&line)
            last_val = last_val + " " + extra
            if last_key == want {
                found = last_val + ""
            }
        } else {
            col := strings.index_of(&line, ":")
            if col > 0 {
                kpart := line[0:col] + ""
                vpart := line[(col + 1):line.len] + ""
                last_key = strings.to_lower(&kpart)
                last_val = strings.trim_space(&vpart)
                if last_key == want {
                    found = last_val + ""
                }
            }
        }
        i = line_end + 1
    }
    << found
}

fn body_of(raw &string) string {
    src := raw + ""
    mut i := 0
    while i + 1 < src.len {
        if (src[i] & 255) == 10 && (src[i + 1] & 255) == 10 {
            << src[(i + 2):src.len] + ""
        }
        if i + 3 < src.len {
            if (src[i] & 255) == 13 && (src[i + 1] & 255) == 10 && (src[i + 2] & 255) == 13 && (src[i + 3] & 255) == 10 {
                << src[(i + 4):src.len] + ""
            }
        }
        i = i + 1
    }
    << ""
}

fn form_val(raw &string, key string) string {
    mut q := url.new_query()
    src := raw + ""
    q.parse(src) or (err) {
        << ""
    }
    prefix := key + "="
    for i in 0:q.len() {
        p := q.at(i)
        if strings.has_prefix(&p, prefix) {
            << p[prefix.len:p.len] + ""
        }
    }
    << ""
}

fn pad2(n int) string {
    if n < 10 {
        << "0" + str(n)
    }
    << str(n)
}

fn format_ns(ns int) string {
    mut sec := ns / 1000000000
    if sec < 0 {
        sec = 0
    }
    days := sec / 86400
    rem := sec % 86400
    hh := rem / 3600
    mm := (rem % 3600) / 60
    ss := rem % 60
    z := days + 719468
    era := z / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    mut y := yoe + era * 400
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    d := doy - (153 * mp + 2) / 5 + 1
    mut m := mp + 3
    if mp >= 10 {
        m = mp - 9
    }
    if m <= 2 {
        y = y + 1
    }
    << str(y) + "-" + pad2(m) + "-" + pad2(d) + " " + pad2(hh) + ":" + pad2(mm) + ":" + pad2(ss)
}

fn new_mail_id() string {
    << "m" + str(now_ns())
}

fn split_addrs(s &string) []string {
    mut out := []string{}
    mut cur := ""
    src := s + ""
    for i in 0:src.len {
        c := src[i] & 255
        if c == 44 || c == 59 {
            t := strings.trim_space(&cur)
            if t.len > 0 {
                out.push(extract_angle(t))
            }
            cur = ""
        } else {
            cur = cur + string_from_byte(c)
        }
    }
    t2 := strings.trim_space(&cur)
    if t2.len > 0 {
        out.push(extract_angle(t2))
    }
    << out
}

fn cmd_verb(line &string) string {
    src := strings.trim_space(line)
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 32 || c == 9 || c == 58 {
            <-
        }
        i = i + 1
    }
    mut verb := src[0:src.len]
    if i > 0 {
        verb = src[0:i]
    }
    << strings.to_upper(&verb)
}

fn cmd_arg(line &string) string {
    src := strings.trim_space(line)
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 32 || c == 9 || c == 58 {
            rest := src[(i + 1):src.len] + ""
            << strings.trim_space(&rest)
        }
        i = i + 1
    }
    << ""
}

struct LineConn {
    fd int
    buf string
}

fn (c &mut LineConn) read_line() string {
    for round in 0:4096 {
        mut i := 0
        while i < c.buf.len {
            if (c.buf[i] & 255) == 10 {
                mut end := i
                if end > 0 && (c.buf[end - 1] & 255) == 13 {
                    end = end - 1
                }
                mut line := ""
                if end > 0 {
                    line = c.buf[0:end] + ""
                }
                rest := c.buf[(i + 1):c.buf.len] + ""
                c.buf = rest
                << line
            }
            i = i + 1
        }
        chunk := net.conn_read(c.fd, 4096) or (err) {
            >> err
        }
        if chunk.len == 0 {
            >> errors.new("peer closed")
        }
        if c.buf.len + chunk.len > 2097152 {
            >> errors.new("line buffer too large")
        }
        c.buf = c.buf + chunk
    }
    >> errors.new("line too long")
}

fn (c &LineConn) write_raw(s string) int {
    msg := s + ""
    << net.conn_write(c.fd, &msg) or (err) {
        >> err
    }
}

fn (c &LineConn) write_line(s string) int {
    msg := s + crlf()
    << c.write_raw(msg)
}

fn (c &mut LineConn) close() {
    net.conn_close(c.fd) or (err) {
        <<
    }
    c.fd = -1
}

fn sort_ids_desc(ids &mut []string) {
    n := ids.len
    for pass in 0:n {
        for j in 0:n - 1 {
            a := ids[j] + ""
            b := ids[j + 1] + ""
            if strings.compare(&a, &b) < 0 {
                ids[j] = b
                ids[j + 1] = a
            }
        }
    }
}

fn q_escape(s &string) string {
    << url.query_escape(s)
}
