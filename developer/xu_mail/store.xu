@main

#errors
#os
#strconv
#strings

struct Mail {
    id string
    from_addr string
    to_addr string
    subject string
    date_ns int
    folder string
    mailbox string
    spam int
    score int
    body string
}

struct Contact {
    email string
    name string
    group_name string
}

struct Group {
    name string
}

fn mail_path(id &string) string {
    << mail_dir() + "/" + (id + "") + ".eml"
}

fn alloc_id(tag string) string {
    stem := "m" + str(now_ns()) + "-" + sanitize_id(tag)
    mut n := 0
    while n < 16 {
        mut id := stem[0:stem.len]
        if n > 0 {
            id = id + "-" + str(n)
        }
        if read_or_empty(mail_path(&id)).len == 0 {
            << id
        }
        n = n + 1
    }
    << stem
}

fn empty_mail() Mail {
    << Mail{
        id: "",
        from_addr: "",
        to_addr: "",
        subject: "",
        date_ns: 0,
        folder: "inbox",
        mailbox: "ada",
        spam: 0,
        score: 0,
        body: ""
    }
}

fn parse_int_or(s string, fallback int) int {
    t := strings.trim_space(&s)
    if t.len == 0 {
        << fallback
    }
    << strconv.atoi(&t) or (err) {
        << fallback
    }
}

fn set_folder(id0 string, folder string) int {
    mut m := load_mail(id0) or (err) {
        >> err
    }
    m.folder = folder + ""
    if folder == "spam" {
        m.spam = 1
    }
    if folder == "inbox" {
        m.spam = 0
    }
    << save_mail(&m)
}

fn parse_eml(id string, raw string) Mail {
    mut m := empty_mail()
    m.id = id + ""
    src := raw + ""
    from_h := header_get(&src, "From")
    to_h := header_get(&src, "To")
    sub_h := header_get(&src, "Subject")
    fold_h := header_get(&src, "X-Xu-Folder")
    box_h := header_get(&src, "X-Xu-Mailbox")
    spam_h := header_get(&src, "X-Xu-Spam")
    score_h := header_get(&src, "X-Xu-Score")
    date_h := header_get(&src, "X-Xu-Date")
    m.from_addr = extract_angle(from_h)
    m.to_addr = to_h + ""
    m.subject = sub_h + ""
    m.folder = fold_h + ""
    if m.folder.len == 0 {
        m.folder = "inbox"
    }
    m.mailbox = sanitize_mailbox(box_h)
    m.spam = parse_int_or(spam_h, 0)
    m.score = parse_int_or(score_h, 0)
    m.date_ns = parse_int_or(date_h, 0)
    m.body = body_of(&src)
    << m
}

fn render_eml(m &Mail) string {
    mut out := ""
    out = out + "From: " + (m.from_addr + "") + "\n"
    out = out + "To: " + (m.to_addr + "") + "\n"
    out = out + "Subject: " + (m.subject + "") + "\n"
    out = out + "Date: " + format_ns(m.date_ns) + " +0000\n"
    out = out + "Message-ID: <" + (m.id + "") + "@xu/local>\n"
    out = out + "X-Xu-Mailbox: " + (m.mailbox + "") + "\n"
    out = out + "X-Xu-Folder: " + (m.folder + "") + "\n"
    out = out + "X-Xu-Spam: " + str(m.spam) + "\n"
    out = out + "X-Xu-Score: " + str(m.score) + "\n"
    out = out + "X-Xu-Date: " + str(m.date_ns) + "\n"
    out = out + "MIME-Version: 1.0\n"
    out = out + "Content-Type: text/plain; charset=utf-8\n"
    out = out + "\n"
    out = out + (m.body + "")
    << out
}

fn save_mail(m &Mail) int {
    mid := m.id + ""
    p := mail_path(&mid)
    raw := render_eml(m)
    << write_text(p, raw)
}

fn load_mail(id0 string) Mail {
    id := sanitize_id(id0)
    if id.len == 0 {
        >> errors.new("missing mail id")
    }
    p := mail_path(&id)
    raw := os.read(p) or (err) {
        >> err
    }
    << parse_eml(id, raw)
}

fn delete_mail(id0 string) int {
    id := sanitize_id(id0)
    p := mail_path(&id)
    os.remove(p) or (err) {
        << 0
    }
    << 0
}

fn list_mail_ids() []string {
    ents := os.entries(mail_dir()) or (err) {
        << []string{}
    }
    mut ids := []string{}
    for i in 0:ents.len {
        nm := ents[i].name + ""
        if strings.has_suffix(&nm, ".eml") {
            stem := nm[0:(nm.len - 4)] + ""
            ids.push(stem)
        }
    }
    sort_ids_desc(mut &ids)
    << ids
}

fn list_mails(mailbox &string, folder string) []Mail {
    ids := list_mail_ids()
    box := sanitize_mailbox(mailbox + "")
    mut out := []Mail{}
    for i in 0:ids.len {
        id := ids[i] + ""
        m := load_mail(id) or (err) {
            ->
        }
        if m.mailbox != box {
            ->
        }
        if folder.len > 0 && m.folder != folder {
            ->
        }
        out.push(m)
    }
    << out
}

fn count_folder(mailbox &string, folder string) int {
    ms := list_mails(mailbox, folder)
    << ms.len
}

fn parse_contact_line(line string) Contact {
    parts := strings.split(&line, "|")
    mut email := ""
    mut name := ""
    mut g := "其它"
    if parts.len > 0 {
        email = parts[0] + ""
    }
    if parts.len > 1 {
        name = parts[1] + ""
    }
    if parts.len > 2 {
        g = parts[2] + ""
    }
    << Contact{email: strings.trim_space(&email), name: strings.trim_space(&name), group_name: strings.trim_space(&g)}
}

fn list_contacts() []Contact {
    raw := read_or_empty(contacts_path())
    lines := strings.split(&raw, "\n")
    mut out := []Contact{}
    for i in 0:lines.len {
        raw_ln := lines[i] + ""
        ln := strings.trim_space(&raw_ln)
        if ln.len == 0 {
            ->
        }
        c := parse_contact_line(ln)
        if c.email.len == 0 {
            ->
        }
        out.push(c)
    }
    << out
}

fn save_contacts(cs []Contact) int {
    mut out := ""
    for i in 0:cs.len {
        e := cs[i].email + ""
        n := cs[i].name + ""
        g := cs[i].group_name + ""
        out = out + e + "|" + n + "|" + g + "\n"
    }
    << write_text(contacts_path(), out)
}

fn add_contact(email string, name string, group_name string) int {
    em := strings.trim_space(&email)
    if em.len == 0 {
        >> errors.new("联系人邮箱不能为空")
    }
    mut cs := list_contacts()
    mut found := 0
    for i in 0:cs.len {
        if cs[i].email == em {
            cs[i].name = strings.trim_space(&name)
            cs[i].group_name = strings.trim_space(&group_name)
            found = 1
        }
    }
    if found == 0 {
        cs.push(Contact{email: em, name: strings.trim_space(&name), group_name: strings.trim_space(&group_name)})
    }
    << save_contacts(cs)
}

fn del_contact(email string) int {
    em := strings.trim_space(&email)
    mut cs := list_contacts()
    mut keep := []Contact{}
    for i in 0:cs.len {
        if cs[i].email != em {
            keep.push(Contact{email: cs[i].email + "", name: cs[i].name + "", group_name: cs[i].group_name + ""})
        }
    }
    << save_contacts(keep)
}

fn find_contact(email &string) Contact {
    want0 := email + ""
    want := strings.to_lower(&want0)
    cs := list_contacts()
    for i in 0:cs.len {
        e := cs[i].email + ""
        el := strings.to_lower(&e)
        if el == want {
            << Contact{email: cs[i].email + "", name: cs[i].name + "", group_name: cs[i].group_name + ""}
        }
        a := extract_angle(e)
        al := strings.to_lower(&a)
        if al == want {
            << Contact{email: cs[i].email + "", name: cs[i].name + "", group_name: cs[i].group_name + ""}
        }
    }
    << Contact{email: "", name: "", group_name: ""}
}

fn list_groups() []Group {
    raw := read_or_empty(groups_path())
    lines := strings.split(&raw, "\n")
    mut out := []Group{}
    mut seen := ""
    for i in 0:lines.len {
        raw_ln := lines[i] + ""
        nm := strings.trim_space(&raw_ln)
        if nm.len == 0 {
            ->
        }
        key := "|" + nm + "|"
        if strings.contains(&seen, key) {
            ->
        }
        seen = seen + key
        out.push(Group{name: nm})
    }
    cs := list_contacts()
    for i in 0:cs.len {
        nm := cs[i].group_name + ""
        if nm.len == 0 {
            ->
        }
        key := "|" + nm + "|"
        if strings.contains(&seen, key) {
            ->
        }
        seen = seen + key
        out.push(Group{name: nm})
    }
    << out
}

fn save_groups(gs []Group) int {
    mut out := ""
    for i in 0:gs.len {
        out = out + gs[i].name + "\n"
    }
    << write_text(groups_path(), out)
}

fn add_group(name string) int {
    nm := strings.trim_space(&name)
    if nm.len == 0 {
        >> errors.new("分组名不能为空")
    }
    mut gs := list_groups()
    for i in 0:gs.len {
        if gs[i].name == nm {
            << 0
        }
    }
    gs.push(Group{name: nm})
    << save_groups(gs)
}

fn del_group(name string) int {
    nm := strings.trim_space(&name)
    mut gs := list_groups()
    mut keep := []Group{}
    for i in 0:gs.len {
        if gs[i].name != nm {
            keep.push(Group{name: gs[i].name + ""})
        }
    }
    save_groups(keep) or (err) {
        >> err
    }
    mut cs := list_contacts()
    for i in 0:cs.len {
        if cs[i].group_name == nm {
            cs[i].group_name = "其它"
        }
    }
    << save_contacts(cs)
}

fn list_rules() []string {
    raw := read_or_empty(rules_path())
    lines := strings.split(&raw, "\n")
    mut out := []string{}
    for i in 0:lines.len {
        raw_ln := lines[i] + ""
        ln := strings.trim_space(&raw_ln)
        if ln.len == 0 {
            ->
        }
        if strings.has_prefix(&ln, "#") {
            ->
        }
        out.push(ln)
    }
    << out
}

fn save_rules(rs []string) int {
    mut out := ""
    for i in 0:rs.len {
        out = out + rs[i] + "\n"
    }
    << write_text(rules_path(), out)
}

fn add_rule(word string) int {
    w := strings.trim_space(&word)
    if w.len == 0 {
        >> errors.new("规则不能为空")
    }
    low := strings.to_lower(&w)
    mut rs := list_rules()
    for i in 0:rs.len {
        cur := rs[i] + ""
        cl := strings.to_lower(&cur)
        if cl == low {
            << 0
        }
    }
    rs.push(w)
    << save_rules(rs)
}

fn del_rule(word string) int {
    w := strings.trim_space(&word)
    low := strings.to_lower(&w)
    mut rs := list_rules()
    mut keep := []string{}
    for i in 0:rs.len {
        cur := rs[i] + ""
        cl := strings.to_lower(&cur)
        if cl != low {
            keep.push(cur)
        }
    }
    << save_rules(keep)
}

fn seed_if_empty() {
    ids := list_mail_ids()
    if ids.len > 0 {
        <<
    }
    now := now_ns()
    mut w := empty_mail()
    w.id = "mwelcome"
    w.from_addr = "xu@xu.local"
    w.to_addr = "ada@xu.local"
    w.subject = "欢迎使用 Xu Mail"
    w.date_ns = now
    w.folder = "inbox"
    w.mailbox = "ada"
