}

fn ensure_layout() int {
    root := data_root()
    os.mkdir_all(root) or (err) {
        >> err
    }
    os.mkdir_all(mail_dir()) or (err) {
        >> err
    }
    if read_or_empty(groups_path()).len == 0 {
        write_text(groups_path(), "家人\n同事\n客户\n其它\n") or (err) {
            >> err
        }
    }
    if read_or_empty(contacts_path()).len == 0 {
        write_text(contacts_path(), "ada@xu.local|Ada|同事\nbob@xu.local|Bob|同事\ncarol@xu.local|Carol|家人\nwinner@evil.test|可疑发件人|其它\n") or (err) {
            >> err
        }
    }
    if read_or_empty(rules_path()).len == 0 {
        write_text(rules_path(), "viagra\ncialis\nwinner\nlottery\nfree money\nclick here\nact now\nlimited time\nbitcoin giveaway\ncryptocurrency\nnigerian\ninvoice attached\n中奖\n发票\n加微信\n免费领取\n点击链接\n") or (err) {
            >> err
        }
    }
    seed_if_empty()
    << 0
}
