@main

#net
#net/http
#os

fn env_or(name string, fallback string) string {
    v := os.getenv(name)
    if v.len > 0 {
        << v
    }
    << fallback
}

fn cli_send() int {
    av := args()
    if av.len < 6 {
        println("usage: xu_mail send <from> <to> <subject> <body>")
        << 2
    }
    ensure_layout() or (err) {
        println(err.msg())
        << 1
    }
    from := av[2] + ""
    to := av[3] + ""
    subject := av[4] + ""
    body := av[5] + ""
    m := deliver_local(from, to, subject, body, "inbox") or (err) {
        println(err.msg())
        << 1
    }
    println("delivered " + m.id + " -> " + m.mailbox + " folder=" + m.folder + " spam=" + str(m.spam) + " score=" + str(m.score))
    << 0
}

fn start_sidecar(role string) {
    av := args()
    if av.len < 1 {
        <<
    }
    self := av[0] + ""
    line := self + " " + role + " &"
    os_system(line)
}

fn serve_smtp() int {
    ensure_layout() or (err) {
        println(err.msg())
        << 1
    }
    smtp_addr := env_or("XU_MAIL_SMTP", "127.0.0.1:2525")
    bind := smtp_addr[0:smtp_addr.len]
    smtp_fd := net.listen(bind) or (err) {
        println("smtp listen: " + err.msg())
        << 1
    }
    println("Xu Mail SMTP  " + smtp_addr)
    smtp_accept_loop(smtp_fd)
    << 0
}

fn serve_pop3() int {
    ensure_layout() or (err) {
        println(err.msg())
        << 1
    }
    pop_addr := env_or("XU_MAIL_POP3", "127.0.0.1:1110")
    bind := pop_addr[0:pop_addr.len]
    pop_fd := net.listen(bind) or (err) {
        println("pop3 listen: " + err.msg())
        << 1
    }
    println("Xu Mail POP3  " + pop_addr)
    pop_accept_loop(pop_fd)
    << 0
}

fn serve() int {
    ensure_layout() or (err) {
        println(err.msg())
        << 1
    }
    http_addr := env_or("XU_MAIL_HTTP", "127.0.0.1:8088")
    smtp_addr := env_or("XU_MAIL_SMTP", "127.0.0.1:2525")
    pop_addr := env_or("XU_MAIL_POP3", "127.0.0.1:1110")
    bind := http_addr[0:http_addr.len]
    web := http_addr[0:http_addr.len]
    smtp_show := smtp_addr[0:smtp_addr.len]
    pop_show := pop_addr[0:pop_addr.len]
    mut s := http.new_server()
    s.listen(bind) or (err) {
        println(err.msg())
        << 1
    }
    start_sidecar("smtp")
    start_sidecar("pop3")
    println("Xu Mail")
    println("  data  " + data_root())
    println("  www   " + www_root())
    println("  web   http://" + web)
    println("  smtp  " + smtp_show)
    println("  pop3  " + pop_show)
    mut running := true
    while running {
        fd := s.accept() or (err) {
            ->
        }
        xu handle_http(fd)
    }
    << 0
}

fn main() int {
    av := args()
    if av.len >= 2 {
        cmd := av[1] + ""
        if cmd == "send" {
            << cli_send()
        }
        if cmd == "smtp" {
            << serve_smtp()
        }
        if cmd == "pop3" {
            << serve_pop3()
        }
    }
    << serve()
}
