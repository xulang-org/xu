@main

#errors
#net
#os
#strings

fn strip_path_kw(arg string) string {
    a := strings.trim_space(&arg)
    up := strings.to_upper(&a)
    if strings.has_prefix(&up, "FROM:") {
        rest := a[5:a.len] + ""
        t := strings.trim_space(&rest)
        << extract_angle(t)
    }
    if strings.has_prefix(&up, "TO:") {
        rest := a[3:a.len] + ""
        t := strings.trim_space(&rest)
        << extract_angle(t)
    }
    << extract_angle(a)
}

fn smtp_reply(c &LineConn, code int, text string) int {
    << c.write_line(str(code) + " " + text)
}

fn smtp_ehlo(c &LineConn) int {
    c.write_line("250-xu.local Xu Mail") or (err) {
        >> err
    }
    c.write_line("250-SIZE 1048576") or (err) {
        >> err
    }
    c.write_line("250-8BITMIME") or (err) {
        >> err
    }
    << c.write_line("250 PIPELINING")
}

fn smtp_read_data(c &mut LineConn) string {
    mut data := ""
    for round in 0:200000 {
        line := c.read_line() or (err) {
            >> err
        }
        if line == "." {
            << data
        }
        mut payload := line + ""
        if payload.len > 0 && (payload[0] & 255) == 46 {
            payload = payload[1:payload.len] + ""
        }
        if data.len > 0 {
            data = data + "\n"
        }
        data = data + payload
        if data.len > 1048576 {
            >> errors.new("message too large")
        }
    }
    >> errors.new("data too long")
}

fn smtp_subject_of(raw &string) string {
    src := raw + ""
    s := header_get(&src, "Subject")
    if s.len > 0 {
        << s
    }
    << "(no subject)"
}

fn smtp_deliver(from_addr string, rcpts string, data string) int {
    tos := split_addrs(&rcpts)
    if tos.len == 0 {
        >> errors.new("no recipients")
    }
    src := data + ""
    sub := smtp_subject_of(&src)
    mut body := body_of(&src)
    if body.len == 0 {
        body = src + ""
    }
    from := extract_angle(from_addr)
    mut delivered := 0
    for i in 0:tos.len {
        to := tos[i] + ""
        box := addr_mailbox(&to)
        if box.len == 0 {
            ->
        }
        deliver_local(from + "", to, sub + "", body + "", "inbox") or (err) {
            >> err
        }
        delivered = delivered + 1
    }
    if delivered == 0 {
        >> errors.new("no local recipients (@xu/local)")
    }
    << delivered
}

fn smtp_session(fd int) {
    mut c := LineConn{fd: fd, buf: ""}
    c.write_line("220 xu.local Xu Mail SMTP ready") or (err) {
        c.close()
        <<
    }
    mut from_addr := ""
    mut rcpts := ""
    mut running := true
    while running {
        line := c.read_line() or (err) {
            running = false
            <-
        }
        verb := cmd_verb(&line)
        if verb == "HELO" || verb == "EHLO" {
            smtp_ehlo(&c) or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "MAIL" {
            arg := cmd_arg(&line)
            from_addr = strip_path_kw(arg)
            rcpts = ""
            smtp_reply(&c, 250, "OK") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "RCPT" {
            arg := cmd_arg(&line)
            to := strip_path_kw(arg)
            if to.len == 0 {
                smtp_reply(&c, 501, "need RCPT TO") or (err) {
                    running = false
                    <-
                }
                ->
            }
            if rcpts.len > 0 {
                rcpts = rcpts + ","
            }
            rcpts = rcpts + to
            smtp_reply(&c, 250, "OK") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "DATA" {
            if from_addr.len == 0 || rcpts.len == 0 {
                smtp_reply(&c, 503, "need MAIL/RCPT") or (err) {
                    running = false
                    <-
                }
                ->
            }
            smtp_reply(&c, 354, "end with .") or (err) {
                running = false
                <-
            }
            data := smtp_read_data(mut &c) or (err) {
                smtp_reply(&c, 552, err.msg()) or (e2) {
                    running = false
                    <-
                }
                ->
            }
            smtp_deliver(from_addr, rcpts, data) or (err) {
                smtp_reply(&c, 550, err.msg()) or (e2) {
                    running = false
                    <-
                }
                ->
            }
            from_addr = ""
            rcpts = ""
            smtp_reply(&c, 250, "queued") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "RSET" {
            from_addr = ""
            rcpts = ""
            smtp_reply(&c, 250, "OK") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "NOOP" {
            smtp_reply(&c, 250, "OK") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "VRFY" || verb == "HELP" {
            smtp_reply(&c, 214, "HELO MAIL RCPT DATA RSET NOOP QUIT") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "QUIT" {
            smtp_reply(&c, 221, "bye") or (err) {
                running = false
                <-
            }
            running = false
            <-
        }
        smtp_reply(&c, 502, "command not implemented") or (err) {
            running = false
            <-
        }
    }
    c.close()
}

fn smtp_accept_loop(lfd int) {
    mut running := true
    while running {
        cfd := net.accept(lfd) or (err) {
            ->
        }
        xu smtp_session(cfd)
    }
}

fn run_smtp() {
    mut addr := os.getenv("XU_MAIL_SMTP")
    if addr.len == 0 {
        addr = "127.0.0.1:2525"
    }
    lfd := net.listen(addr) or (err) {
        println("smtp listen: " + err.msg())
        <<
    }
    smtp_accept_loop(lfd)
}
