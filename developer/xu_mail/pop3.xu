@main

#errors
#net
#os
#strings

fn pop_ok(c &LineConn, text string) int {
    << c.write_line("+OK " + text)
}

fn pop_err(c &LineConn, text string) int {
    << c.write_line("-ERR " + text)
}

fn pop_box_mails(mailbox string) []Mail {
    << list_mails(&mailbox, "inbox")
}

fn pop_session(fd int) {
    mut c := LineConn{fd: fd, buf: ""}
    pop_ok(&c, "Xu Mail POP3") or (err) {
        c.close()
        <<
    }
    mut user := ""
    mut authed := 0
    mut running := true
    while running {
        line := c.read_line() or (err) {
            running = false
            <-
        }
        verb := cmd_verb(&line)
        arg := cmd_arg(&line)
        if verb == "USER" {
            user = sanitize_mailbox(arg)
            pop_ok(&c, "user") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "PASS" {
            if user.len == 0 {
                pop_err(&c, "need USER") or (err) {
                    running = false
                    <-
                }
                ->
            }
            authed = 1
            pop_ok(&c, "logged in") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "QUIT" {
            pop_ok(&c, "bye") or (err) {
                running = false
                <-
            }
            running = false
            <-
        }
        if verb == "NOOP" || verb == "CAPA" {
            if verb == "CAPA" {
                c.write_line("+OK") or (err) {
                    running = false
                    <-
                }
                c.write_line("USER") or (err) {
                    running = false
                    <-
                }
                c.write_line("UIDL") or (err) {
                    running = false
                    <-
                }
                c.write_line(".") or (err) {
                    running = false
                    <-
                }
                ->
            }
            pop_ok(&c, "") or (err) {
                running = false
                <-
            }
            ->
        }
        if authed == 0 {
            pop_err(&c, "auth required") or (err) {
                running = false
                <-
            }
            ->
        }
        ms := pop_box_mails(user)
        if verb == "STAT" {
            mut bytes := 0
            for i in 0:ms.len {
                bytes = bytes + ms[i].body.len + 80
            }
            pop_ok(&c, str(ms.len) + " " + str(bytes)) or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "LIST" || verb == "UIDL" {
            pop_ok(&c, str(ms.len) + " messages") or (err) {
                running = false
                <-
            }
            for i in 0:ms.len {
                id := ms[i].id + ""
                mut row := str(i + 1) + " "
                if verb == "UIDL" {
                    row = row + id
                } else {
                    row = row + str(ms[i].body.len + 80)
                }
                c.write_line(row) or (err) {
                    running = false
                    <-
                }
            }
            c.write_line(".") or (err) {
                running = false
                <-
            }
            ->
        }
        if verb == "RETR" || verb == "TOP" || verb == "DELE" {
            n := parse_int_or(arg, 0)
            if n < 1 || n > ms.len {
                pop_err(&c, "no such message") or (err) {
                    running = false
                    <-
                }
                ->
            }
            id := ms[n - 1].id + ""
            if verb == "DELE" {
                delete_mail(id)
                pop_ok(&c, "deleted") or (err) {
                    running = false
                    <-
                }
                ->
            }
            m := load_mail(id) or (err) {
                pop_err(&c, err.msg()) or (e2) {
                    running = false
                    <-
                }
                ->
            }
            raw := render_eml(&m)
            pop_ok(&c, str(raw.len) + " octets") or (err) {
                running = false
                <-
            }
            c.write_raw(raw) or (err) {
                running = false
                <-
            }
            c.write_raw(crlf() + "." + crlf()) or (err) {
                running = false
                <-
            }
            ->
        }
        pop_err(&c, "unknown") or (err) {
            running = false
            <-
        }
    }
    c.close()
}

fn pop_accept_loop(lfd int) {
    mut running := true
    while running {
        cfd := net.accept(lfd) or (err) {
            ->
        }
        xu pop_session(cfd)
    }
}

fn run_pop3() {
    mut addr := os.getenv("XU_MAIL_POP3")
    if addr.len == 0 {
        addr = "127.0.0.1:1110"
    }
    lfd := net.listen(addr) or (err) {
        println("pop3 listen: " + err.msg())
        <<
    }
    pop_accept_loop(lfd)
}
