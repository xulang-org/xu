@main

#ui
#ui/webview
#os
#os/exec
#path/filepath
#strconv
#strings
#errors

// Xu Flow — WebView + SVG CFG. Sibling `xu-map --graph` supplies N/E lines;
// HTML draws nodes/edges. Pack with --webview.
//   xu-desktop pack developer/xu_flow --target macos-arm64 --webview -o /tmp/XuFlow

struct Node {
    pub id int
    pub shape int
    pub label string
    pub note string
}

struct Edge {
    pub a int
    pub b int
    pub lab string
}

struct Graph {
    pub nodes []Node
    pub edges []Edge
    pub err string
}

fn trim_nl(s string) string {
    mut e := s.len
    while e > 0 {
        c := s[e - 1] & 255
        if c == 10 || c == 13 || c == 32 {
            e = e - 1
        } else {
            << s[0:e]
        }
    }
    << s[0:e]
}

fn starts_fn(s &string) bool {
    if s.len < 3 {
        << false
    }
    << s[0] == 102 && s[1] == 110 && s[2] == 32
}

fn atoi_s(s string) int {
    t := s + ""
    << strconv.atoi(&t) or (err) {
        << 0
    }
}

fn dir_of(p0 string) string {
    p := p0 + ""
    mut cut := 0 - 1
    for i in 0:p.len {
        if (p[i] & 255) == 47 {
            cut = i
        }
    }
    if cut <= 0 {
        << ""
    }
    << p[0:cut]
}

fn exe_dir() string {
    av := args()
    if av.len == 0 {
        << ""
    }
    << dir_of(av[0] + "")
}

fn file_ok(p string) int {
    os.stat(p + "") or (err) {
        << 0
    }
    << 1
}

fn has_xu(p string) int {
    if file_ok(p + "/main.xu") == 1 {
        << 1
    }
    n := p.len
    if n >= 3 {
        if p[n - 3] == 46 && p[n - 2] == 120 && p[n - 1] == 117 {
            << file_ok(p + "")
        }
    }
    << 0
}

fn pick_root() string {
    av := args()
    if av.len > 1 {
        r := av[1] + ""
        << filepath.abs(&r)
    }
    ed := exe_dir()
    if ed.len > 0 {
        bundled := ed + "/sample"
        if has_xu(bundled + "") == 1 {
            << bundled
        }
    }
    local := "developer/xu_flow/sample"
    if has_xu(local + "") == 1 {
        << filepath.abs(&local)
    }
    a := "../xu-examples/examples/03_control_flow"
    if has_xu(a + "") == 1 {
        << filepath.abs(&a)
    }
    << filepath.abs(&local)
}

fn pick_map() string {
    ed := exe_dir()
    if ed.len > 0 {
        cand := ed + "/xu-map"
        if file_ok(cand + "") == 1 {
            << cand
        }
    }
    found := exec.look_path("xu-map") or (err) {
        << ""
    }
    if found.len > 0 {
        << found
    }
    if file_ok("bin/xu-map") == 1 {
        << "bin/xu-map"
    }
    << "xu-map"
}

fn is_kw(s string) bool {
    if s == "if" || s == "match" || s == "while" || s == "for" {
        << true
    }
    if s == "in" || s == "else" || s == "fn" || s == "true" {
        << true
    }
    if s == "false" || s == "done" || s == "loop" || s == "next" {
        << true
    }
    if s == "join" || s == "int" || s == "string" || s == "bool" {
        << true
    }
    if s == "mut" || s == "pub" || s == "return" || s == "call" {
        << true
    }
    << false
}

fn is_letter(c int) bool {
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 65 && c <= 90 {
        << true
    }
    << c == 95
}

fn first_ident(s string) string {
    mut i := 0
    n := s.len
    while i < n {
        c := s[i] & 255
        if is_letter(c) {
            mut j := i + 1
            while j < n {
                d := s[j] & 255
                if is_letter(d) || (d >= 48 && d <= 57) {
                    j = j + 1
                } else {
                    <-
                }
            }
            w := s[i:j]
            if !is_kw(w + "") {
                << w
            }
            i = j
        } else {
            i = i + 1
        }
    }
    << ""
}

fn fn_name_of(lab0 string) string {
    lab := lab0 + ""
    if !starts_fn(&lab) {
        << ""
    }
    rest := lab[3:lab.len]
    mut i := 0
    n := rest.len
    while i < n && rest[i] == 32 {
        i = i + 1
    }
    if i < n {
        if rest[i] == 40 {
            while i < n && rest[i] != 41 {
                i = i + 1
            }
            if i < n {
                i = i + 1
            }
            while i < n && rest[i] == 32 {
                i = i + 1
            }
        }
    }
    mut j := i
    while j < n {
        c := rest[j] & 255
        if is_letter(c) {
            j = j + 1
        } else {
            if c >= 48 && c <= 57 {
                j = j + 1
            } else {
                <-
            }
        }
    }
    if j > i {
        << rest[i:j]
    }
    << ""
}

fn fn_params_inner(lab string) string {
    mut a := 0 - 1
    mut b := 0 - 1
    for k in 0:lab.len {
        if lab[k] == 40 {
            a = k + 1
        }
        if lab[k] == 41 {
            b = k
        }
    }
    if a >= 0 && b > a {
        << lab[a:b]
    }
    << ""
}

fn node_bind_name(g &mut Graph, ni int) string {
    lab := g.nodes[ni].label + ""
    if starts_fn(&lab) {
        << first_ident(fn_params_inner(lab))
    }
    w := first_ident(lab)
    if w.len > 0 {
        << w
    }
    id := g.nodes[ni].id
    for e in 0:g.edges.len {
        if g.edges[e].a == id {
            w2 := first_ident(g.edges[e].lab + "")
            if w2.len > 0 {
                << w2
            }
        }
    }
    << ""
}

fn clean_field(s string) string {
    mut out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if c == 10 || c == 13 || c == 30 {
            out = out + " "
        } else {
            out = out + s[i:i + 1]
        }
    }
    << out
}

fn rec_sep() string {
    << string_from_byte(30)
}

fn load_graph(root string) Graph {
    bin := pick_map()
    mut c := exec.command(bin, "--graph", root)
    raw := c.combined_output() or (err) {
        << Graph{nodes: []Node{}, edges: []Edge{}, err: "xu-map: " + err.msg()}
    }
    mut g := Graph{nodes: []Node{}, edges: []Edge{}, err: ""}
    lines := strings.split(&raw, "\n")
    for i in 0:lines.len {
        ln := trim_nl(lines[i] + "")
        if ln.len < 3 {
            ->
        }
        parts := strings.split_n(&ln, "\t", 4)
        tag := parts[0] + ""
        if tag == "N" {
            if parts.len >= 4 {
                ids := parts[1] + ""
                shs := parts[2] + ""
                lab := clean_field(parts[3] + "")
                g.nodes.push(Node{id: atoi_s(ids), shape: atoi_s(shs), label: lab, note: ""})
            }
        } else {
            if tag == "E" {
                if parts.len >= 3 {
                    a := parts[1] + ""
                    b := parts[2] + ""
                    mut lab := ""
                    if parts.len >= 4 {
                        lab = clean_field(parts[3] + "")
                    }
                    g.edges.push(Edge{a: atoi_s(a), b: atoi_s(b), lab: lab})
                }
            } else {
                if tag == "C" {
                    cp := strings.split_n(&ln, "\t", 3)
                    if cp.len >= 3 {
                        nid := atoi_s(cp[1] + "")
                        note := clean_field(cp[2] + "")
                        for j in 0:g.nodes.len {
                            if g.nodes[j].id == nid {
                                g.nodes[j].note = note
                                <-
                            }
                        }
                    }
                }
            }
        }
    }
    if g.nodes.len == 0 {
        if g.err.len == 0 {
            g.err = "no nodes — set a .xu path"
        }
    }
    << g
}

fn parse_dump(raw string) Graph {
    mut g := Graph{nodes: []Node{}, edges: []Edge{}, err: ""}
    sep := rec_sep()
    recs := strings.split(&raw, sep)
    for i in 0:recs.len {
        ln := recs[i] + ""
        if ln.len < 2 {
            ->
        }
        parts := strings.split_n(&ln, "\t", 4)
        tag := parts[0] + ""
        if tag == "ERR" {
            if parts.len >= 2 {
                g.err = parts[1] + ""
            }
        } else {
            if tag == "N" {
                if parts.len >= 4 {
                    ids := parts[1] + ""
                    shs := parts[2] + ""
                    lab := parts[3] + ""
                    g.nodes.push(Node{id: atoi_s(ids), shape: atoi_s(shs), label: lab, note: ""})
                }
            } else {
                if tag == "E" {
                    if parts.len >= 3 {
                        a := parts[1] + ""
                        b := parts[2] + ""
                        mut lab := ""
                        if parts.len >= 4 {
                            lab = parts[3] + ""
                        }
                        g.edges.push(Edge{a: atoi_s(a), b: atoi_s(b), lab: lab})
                    }
                } else {
                    if tag == "C" {
                        cp := strings.split_n(&ln, "\t", 3)
                        if cp.len >= 3 {
                            nid := atoi_s(cp[1] + "")
                            note := cp[2] + ""
                            for j in 0:g.nodes.len {
                                if g.nodes[j].id == nid {
                                    g.nodes[j].note = note
                                    <-
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    << g
}

fn dump_graph(g &mut Graph, root string, keys &mut []string, vals &mut []string) string {
    sep := rec_sep()
    mut t := "ROOT\t" + clean_field(root)
    if g.err.len > 0 {
        t = t + sep + "ERR\t" + clean_field(g.err)
    }
    for i in 0:g.nodes.len {
        t = t + sep + "N\t" + str(g.nodes[i].id) + "\t" + str(g.nodes[i].shape) + "\t" + g.nodes[i].label
    }
    for e in 0:g.edges.len {
        t = t + sep + "E\t" + str(g.edges[e].a) + "\t" + str(g.edges[e].b) + "\t" + g.edges[e].lab
    }
    for i in 0:g.nodes.len {
        note := g.nodes[i].note + ""
        if note.len == 0 {
            ->
        }
        t = t + sep + "C\t" + str(g.nodes[i].id) + "\t" + clean_field(note)
    }
    mut n := keys.len
    if vals.len < n {
        n = vals.len
    }
    for i in 0:n {
        t = t + sep + "S\t" + clean_field(keys[i] + "") + "\t" + clean_field(vals[i] + "")
    }
    << t
}

fn is_call_lab(s string) bool {
    << s == "call"
}

fn lookup(keys &mut []string, vals &mut []string, name &string) string {
    want := name + ""
    for i in 0:keys.len {
        if keys[i] == want {
            << vals[i] + ""
        }
    }
    << ""
}

fn set_bind(keys &mut []string, vals &mut []string, name &string, val &string) {
    n := name + ""
    if n.len == 0 {
        <<
    }
    v := val + ""
    for i in 0:keys.len {
        if keys[i] == n {
            vals[i] = v + ""
            <<
        }
    }
    keys.push(n + "")
    vals.push(v + "")
}

fn rhs_of_assign(lab string) string {
    n := lab.len
    mut i := 0
    while i + 1 < n {
        if (lab[i] & 255) == 58 {
            if (lab[i + 1] & 255) == 61 {
                << trim_nl(lab[i + 2:n])
            }
        }
        i = i + 1
    }
    << ""
}

fn seed_for(g &mut Graph, keys &mut []string, vals &mut []string, name &string) string {
    got := lookup(keys, vals, name)
    if got.len > 0 {
        << got
    }
    want := name + ""
    for i in 0:g.nodes.len {
        nm := node_bind_name(g, i)
        if nm == want {
            rhs := rhs_of_assign(g.nodes[i].label + "")
            if rhs.len > 0 {
                << rhs
            }
        }
    }
    << ""
}

fn cmp_ints(l int, op string, r int) int {
    if op == "==" {
        if l == r {
            << 1
        }
        << 0
    }
    if op == "!=" {
        if l != r {
            << 1
        }
        << 0
    }
    if op == ">=" {
        if l >= r {
            << 1
        }
        << 0
    }
    if op == "<=" {
        if l <= r {
            << 1
        }
        << 0
    }
    if op == ">" {
        if l > r {
            << 1
        }
        << 0
    }
    if op == "<" {
        if l < r {
            << 1
        }
        << 0
    }
    << 0 - 1
}

fn range_cut(s string) int {
    n := s.len
    mut i := 0
    while i + 1 < n {
        a := s[i] & 255
        b := s[i + 1] & 255
        if a == 45 && b == 45 {
            << i
        }
        if a == 46 && b == 46 {
            << i
        }
        i = i + 1
    }
    << 0 - 1
}

fn all_digits(s string) bool {
    if s.len == 0 {
        << false
    }
    for i in 0:s.len {
        c := s[i] & 255
        if c < 48 || c > 57 {
            << false
        }
    }
    << true
}

fn eval_edge(lab string, keys &mut []string, vals &mut []string, match_var string) int {
    s := trim_nl(lab)
    if s.len == 0 {
        << 1
    }
    if s == "else" || s == "done" || s == "false" {
        << 0
    }
    if s == "true" || s == "loop" || s == "next" {
        << 1
    }
    if match_var.len > 0 {
        got := lookup(keys, vals, &match_var)
        if got.len == 0 {
            << 0 - 1
        }
        gv := atoi_s(got)
        if s == "else" {
            << 0
        }
        rc := range_cut(s + "")
        if rc >= 0 {
            lo := atoi_s(trim_nl(s[0:rc]))
            hi := atoi_s(trim_nl(s[rc + 2:s.len]))
            if gv >= lo && gv <= hi {
                << 1
            }
            << 0
        }
        if all_digits(s + "") {
            if gv == atoi_s(s + "") {
                << 1
            }
            << 0
        }
        << 0
    }
    mut op := ""
    mut cut := 0 - 1
    if s.len >= 2 {
        for i in 0:s.len - 1 {
            a := s[i]
            b := s[i + 1]
            if a == 62 && b == 61 {
                op = ">="
                cut = i
                <-
            }
            if a == 60 && b == 61 {
                op = "<="
                cut = i
                <-
            }
            if a == 61 && b == 61 {
                op = "=="
                cut = i
                <-
            }
            if a == 33 && b == 61 {
                op = "!="
                cut = i
                <-
            }
        }
    }
    if cut < 0 {
        for i in 0:s.len {
            c := s[i]
            if c == 62 {
                op = ">"
                cut = i
                <-
            }
            if c == 60 {
                op = "<"
                cut = i
                <-
            }
        }
    }
    if cut < 0 {
        << 0 - 1
    }
    lhs := trim_nl(s[0:cut])
    mut rhs := ""
    if op.len == 2 {
        rhs = trim_nl(s[cut + 2:s.len])
    } else {
        rhs = trim_nl(s[cut + 1:s.len])
    }
    lv := lookup(keys, vals, &lhs)
    if lv.len == 0 {
        << 0 - 1
    }
    << cmp_ints(atoi_s(lv), op, atoi_s(rhs))
}

fn match_var_of(lab string) string {
    if lab.len >= 6 {
        if lab[0] == 109 && lab[1] == 97 && lab[2] == 116 && lab[3] == 99 && lab[4] == 104 && lab[5] == 32 {
            << trim_nl(lab[6:lab.len])
        }
    }
    << ""
}

fn on_path(path &[]int, id int) bool {
    for i in 0:path.len {
        if path[i] == id {
            << true
        }
    }
    << false
}

fn node_cond(lab string) string {
    if lab.len > 6 {
        if lab[0:6] == "while " {
            << trim_nl(lab[6:lab.len])
        }
    }
    << ""
}

fn eval_from(g &mut Graph, cur int, lab0 string, keys &mut []string, vals &mut []string) int {
    s := trim_nl(lab0)
    mut nlab := ""
    for i in 0:g.nodes.len {
        if g.nodes[i].id == cur {
            nlab = g.nodes[i].label + ""
        }
    }
    mv := match_var_of(nlab + "")
    cond := node_cond(nlab + "")
    if s.len == 0 {
        << 1
    }
    if s == "loop" || s == "next" {
        << 1
    }
    if s == "true" {
        if cond.len > 0 {
            << eval_edge(cond, keys, vals, "")
        }
        << 0 - 1
    }
    if s == "false" {
        if cond.len > 0 {
            v := eval_edge(cond, keys, vals, "")
            if v == 1 {
                << 0
            }
            if v == 0 {
                << 1
            }
            << 0 - 1
        }
        << 0 - 1
    }
    if s == "else" || s == "done" {
        << 0
    }
    << eval_edge(s, keys, vals, mv)
}

fn pick_next(g &mut Graph, cur int, keys &mut []string, vals &mut []string) int {
    mut next := 0 - 1
    mut else_to := 0 - 1
    mut unknown := 0
    for e in 0:g.edges.len {
        if g.edges[e].a == cur {
            lab := g.edges[e].lab + ""
            if is_call_lab(lab + "") {
                ->
            }
            b := g.edges[e].b
            if lab == "else" || lab == "false" || lab == "done" {
                else_to = b
            } else {
                v := eval_from(g, cur, lab, keys, vals)
                if v == 1 {
                    next = b
                    <-
                }
                if v == 0 - 1 {
                    unknown = 1
                }
            }
        }
    }
    if next < 0 {
        if unknown == 0 {
            next = else_to
        }
    }
    << next
}

fn node_ix(g &mut Graph, id int) int {
    for i in 0:g.nodes.len {
        if g.nodes[i].id == id {
            << i
        }
    }
    << 0 - 1
}

fn is_branch_id(g &mut Graph, id int) bool {
    i := node_ix(g, id)
    if i < 0 {
        << false
    }
    if g.nodes[i].shape == 1 {
        << true
    }
    << false
}

fn find_edge(g &mut Graph, a int, b int) int {
    for e in 0:g.edges.len {
        if g.edges[e].a == a {
            if g.edges[e].b == b {
                << e
            }
        }
    }
    << 0 - 1
}

fn mark_runs(g &mut Graph, keys &mut []string, vals &mut []string) []int {
    n := g.edges.len
    mut lit := []int{}
    for i in 0:n {
        lit.push(0)
    }
    nn := g.nodes.len
    for i in 0:nn {
        if g.nodes[i].shape != 1 {
            ->
        }
        cur := g.nodes[i].id
        nxt := pick_next(g, cur, keys, vals)
        if nxt < 0 {
            ->
        }
        e0 := find_edge(g, cur, nxt)
        if e0 >= 0 {
            lit[e0] = 1
        }
        mut p := nxt
        mut guard := 0
        while guard < nn + 8 {
            guard = guard + 1
            if is_branch_id(g, p) {
                <-
            }
            n2 := pick_next(g, p, keys, vals)
            if n2 < 0 {
                <-
            }
            e1 := find_edge(g, p, n2)
            if e1 >= 0 {
                lit[e1] = 1
            }
            p = n2
        }
    }
    << lit
}

fn walk(g &mut Graph, start int, keys &mut []string, vals &mut []string) []int {
    mut path := []int{}
    if start < 0 {
        << path
    }
    n := g.nodes.len
    mut cur := start
    mut guard := 0
    while cur >= 0 && guard < n + 8 {
        guard = guard + 1
        path.push(cur)
        next := pick_next(g, cur, keys, vals)
        if next < 0 {
            <-
        }
        if next == cur {
            <-
        }
        cur = next
    }
    << path
}

fn mark_call_edges(g &mut Graph, lit &mut []int, path &[]int, keys &mut []string, vals &mut []string) {
    mut hot := []int{}
    for i in 0:path.len {
        hot.push(path[i])
    }
    mut guard := 0
    nn := g.nodes.len
    while guard < nn + 4 {
        guard = guard + 1
        mut grew := 0
        for e in 0:g.edges.len {
            el := g.edges[e].lab + ""
            if !is_call_lab(el + "") {
                ->
            }
            src := g.edges[e].a
            mut src_hot := 0
            if on_path(&hot, src) {
                src_hot = 1
            }
            if src_hot == 0 {
                for e2 in 0:g.edges.len {
                    if g.edges[e2].b == src {
                        el2 := g.edges[e2].lab + ""
                        if is_call_lab(el2 + "") {
                            ->
                        }
                        if e2 < lit.len {
                            if lit[e2] == 1 {
                                src_hot = 1
                            }
                        }
                    }
                }
            }
            if src_hot == 0 {
                ->
            }
            if e < lit.len {
                if lit[e] == 0 {
                    lit[e] = 1
                    grew = 1
                }
            }
            dst := g.edges[e].b
            if !on_path(&hot, dst) {
                hot.push(dst)
                grew = 1
                extra := walk(g, dst, keys, vals)
                for p in 0:extra.len {
                    id := extra[p]
                    if !on_path(&hot, id) {
                        hot.push(id)
                    }
                }
            }
        }
        if grew == 0 {
            <-
        }
    }
}

fn simulate(g &mut Graph, keys &mut []string, vals &mut []string) []int {
    n := g.nodes.len
    mut cur := 0 - 1
    mut fallback := 0 - 1
    for i in 0:n {
        lab := g.nodes[i].label + ""
        if starts_fn(&lab) {
            if fallback < 0 {
                fallback = g.nodes[i].id
            }
            nm := fn_name_of(lab + "")
            if nm == "main" {
                cur = g.nodes[i].id
                <-
            }
        }
    }
    if cur < 0 {
        cur = fallback
    }
    if cur < 0 {
        if n > 0 {
            cur = g.nodes[0].id
        }
    }
    << walk(g, cur, keys, vals)
}

fn collect_names(g &mut Graph, keys &mut []string, vals &mut []string) {
    for i in 0:g.nodes.len {
        name := node_bind_name(g, i)
        if name.len > 0 {
            empty := ""
            set_bind(keys, vals, &name, &empty)
        }
    }
}

fn join_lit(lit &[]int) string {
    mut t := ""
    for i in 0:lit.len {
        if lit[i] == 1 {
            if t.len > 0 {
                t = t + ","
            }
            t = t + str(i)
        }
    }
    << t
}

fn apply_payload(pl string, keys &mut []string, vals &mut []string) {
    s := trim_nl(pl)
    if s.len == 0 {
        <<
    }
    parts := strings.split(&s, ";")
    for i in 0:parts.len {
        item := parts[i] + ""
        kv := strings.split_n(&item, "=", 2)
        if kv.len >= 2 {
            k := trim_nl(kv[0] + "")
            v := trim_nl(kv[1] + "")
            set_bind(keys, vals, &k, &v)
        }
    }
}

fn cache_path() string {
    << ui.host_tmp() + "/xu_flow_g.txt"
}

fn read_cache() string {
    << read_file(cache_path()) or (err) {
        << ""
    }
}

fn seed_all(g &mut Graph, keys &mut []string, vals &mut []string) {
    collect_names(g, keys, vals)
    for i in 0:keys.len {
        nm := keys[i] + ""
        seed := seed_for(g, keys, vals, &nm)
        if seed.len > 0 {
            set_bind(keys, vals, &nm, &seed)
        }
    }
}

fn cmd_graph(payload string) string {
    mut root := trim_nl(payload)
    if root.len == 0 {
        root = pick_root()
    }
    mut g := load_graph(root + "")
    mut keys := []string{}
    mut vals := []string{}
    seed_all(mut &g, mut &keys, mut &vals)
    d := dump_graph(mut &g, root + "", mut &keys, mut &vals)
    _ := write_file(cache_path(), d + "") or (err) {
        << d
    }
    << d
}

fn cmd_sim(payload string) string {
    mut raw := read_cache()
    if raw.len == 0 {
        raw = cmd_graph("")
    }
    mut g := parse_dump(raw + "")
    mut keys := []string{}
    mut vals := []string{}
    seed_all(mut &g, mut &keys, mut &vals)
    apply_payload(payload, mut &keys, mut &vals)
    mut lit := mark_runs(mut &g, mut &keys, mut &vals)
    path := simulate(mut &g, mut &keys, mut &vals)
    mark_call_edges(mut &g, mut &lit, &path, mut &keys, mut &vals)
    << join_lit(&lit)
}

fn route(name string, payload string) string {
    if name == "graph" {
        << cmd_graph(payload)
    }
    if name == "sim" {
        << cmd_sim(payload)
    }
    if name == "ping" {
        << "pong"
    }
    << "err:unknown"
}

fn demo_www() string {
    if env_get("XU_UI_WWW") == ":mem:" || env_get("XU_UI_PACK") == "1" {
        << ":mem:"
    }
    << "www"
}

fn ipc_boot(emit_ch chan string, shell_ch chan ui.Event) {
    webview.bind_ipc_www(demo_www(), route, emit_ch, shell_ch) or (err) {
        eprintln(err.msg())
        <<
    }
}

fn watch_shell(shell_ch chan ui.Event) {
    while true {
        _ := <-shell_ch
    }
}

fn main() int {
    emit_ch := chan string{cap: 64}
    shell_ch := chan ui.Event{cap: 4096}
    mut app := ui.new_app_events(shell_ch)
    app.set_icon(ui.icon_from_file("brand/xu_app_logo.png"))
    webview.stage_www_root(demo_www()) or (err) {
        println(err.msg())
        << 1
    }
    xu watch_shell(shell_ch)
    xu ipc_boot(emit_ch, shell_ch)
    sleep_ns(50000000)
    mut win := app.new_window(ui.WindowOpts{title: "Xu Flow", width: 1280, height: 800})
    r := mut &win
    mut wv := webview.attach(r)
    wv.on("graph")
    wv.on("sim")
    wv.on("ping")
    wv.load_url(webview.app_scheme_url()) or (err) {
        println(err.msg())
        << 1
    }
    app.run() or (err) {
        println(err.msg())
        << 1
    }
    << 0
}
