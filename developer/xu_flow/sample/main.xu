@main

// Ticket fare: functions call each other so Xu Flow can
// draw boxed regions and call arrows between them.

// Clip n into [lo, hi].
fn clamp(n int, lo int, hi int) int {
    if n < lo {
        << lo
    }
    if n > hi {
        << hi
    }
    << n
}

// Age band: 0 child / 1 teen / 2 adult / 3 senior.
fn band(age int) int {
    a := clamp(age, 0, 120)
    if a < 13 { // child
        << 0
    }
    if a < 18 { // teen
        << 1
    }
    if a < 65 { // adult
        << 2
    }
    << 3
}

// List price by band.
fn price(b int) int {
    match b {
        0 {
            << 0
        }
        1 {
            << 12
        }
        2 {
            << 20
        }
        else {
            << 8
        }
    }
}

// Child rides free; senior gets 8 off.
fn discount(b int, p int) int {
    if b == 0 {
        << 0
    }
    if b == 3 {
        << p - 8
    }
    << p
}

// One person's fare: band → price → discount.
fn fare(age int) int {
    b := band(age)
    p := price(b)
    << discount(b, p)
}

// Sum fare across `count` tickets.
fn total(age int, count int) int {
    mut left := count
    mut sum := 0
    while left > 0 { // remaining tickets
        sum += fare(age)
        left -= 1
    }
    << sum
}

// Demo: a 16-year-old buying two tickets.
fn main() int {
    age := 16
    tickets := 2
    s := total(age, tickets)
    println(s)
    << 0
}
