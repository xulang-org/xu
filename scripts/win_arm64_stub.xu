@main

// Windows ARM64 launcher: rust-emitted argv is intact, gen3 collect_args is not.
// Pack the user's command into one quoted argument so the child's last token
// (the only one that survives the old per-token alloc) is the full CLI.

fn win_quote(s string) string {
    mut need := 0
    for i in 0:s.len {
        c := s[i]
        if c == 32 { need = 1 }
        if c == 9 { need = 1 }
        if c == 34 { need = 1 }
    }
    if need == 0 {
        << s + ""
    }
    mut o := "\""
    for i in 0:s.len {
        if s[i] == 34 {
            o = o + "\\"
            o = o + "\""
        } else {
            o = o + s[i:i + 1]
        }
    }
    << o + "\""
}

fn core_from_stub(exe string) string {
    n := exe.len
    if n < 4 {
        << exe + ".core.exe"
    }
    << exe[0:n - 4] + ".core.exe"
}

fn main() int {
    av := args()
    if av.len < 1 {
        eprintln("xu: empty argv")
        << 1
    }
    mut rest := ""
    mut i := 1
    while i < av.len {
        if rest.len > 0 {
            rest = rest + " "
        }
        rest = rest + av[i]
        i = i + 1
    }
    core := core_from_stub(av[0] + "")
    mut cmd := win_quote(core + "")
    if rest.len > 0 {
        cmd = cmd + " " + win_quote(rest + "")
    }
    rc := os_system(cmd)
    if rc == 127 {
        eprintln("xu: cannot start " + core)
        eprintln("    keep xu.windows.arm64.core.exe next to this exe")
    }
    << rc
}
