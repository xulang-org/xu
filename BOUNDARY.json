{
  "schema": 1,
  "contract": "bootstrap-xu-selfhost",
  "contract_version": "1.0",
  "effective_date": "2026-09-01",
  "scope": {
    "compiler_chain": [
      "bootstrap/crates/xun",
      "bootstrap/crates/xuasm",
      "bootstrap/crates/xubin",
      "bootstrap/crates/xuvm",
      "bootstrap/crates/xubackend",
      "bootstrap/crates/xuparse",
      "bootstrap/crates/xu",
      "bootstrap/crates/xuhir",
      "bootstrap/crates/xumir",
      "bootstrap/crates/xuemit",
      "bootstrap/crates/xurt",
      "src/cmd/compile",
      "src/xu"
    ],
    "auxiliary_bootstrap_consumers": [
      "bootstrap/crates/xuplay",
      "scripts/build-xu-play-wasm.sh",
      "scripts/emit_xu_extra.sh"
    ],
    "bootstrap_workspace": {
      "manifest": "bootstrap/Cargo.toml",
      "compiler_members": [
        "xun",
        "xuasm",
        "xubin",
        "xuvm",
        "xubackend",
        "xuparse",
        "xuhir",
        "xumir",
        "xurt",
        "xuemit",
        "xu"
      ],
      "auxiliary_members": [
        "xuplay"
      ],
      "exact": true
    },
    "auxiliary_note": "Auxiliary consumers have their own target-specific gate and are not compiler product evidence."
  },
  "roles": {
    "bootstrap": {
      "root": "bootstrap",
      "stage": "Gen0",
      "authority": [
        "primer for producing Gen1",
        "frozen correctness oracle",
        "cross-target reference and P0 recovery path"
      ],
      "product_artifact": false
    },
    "xu": {
      "root": "src",
      "stage": "Gen1/Gen2/Gen3/Gen4",
      "authority": [
        "hosted product compiler",
        "hosted runtime and ABI policy",
        "optimization policy and released bin/xu"
      ],
      "product_artifact": true
    }
  },
  "generation": {
    "gen0": {
      "producer": "bootstrap/target/debug/xu",
      "input": "scripts/gen1_sources.sh",
      "mode": "-O0",
      "profile": "primer_oracle",
      "output": "Gen1"
    },
    "gen1": {
      "producer": "Gen0",
      "input": "scripts/gen1_sources.sh",
      "mode": "hosted product-default profile (compiler defaults; acceptance profile is explicit)",
      "profile": "hosted_product",
      "acceptance_profile": "hosted_acceptance",
      "output": "Gen2"
    },
    "gen2": {
      "producer": "Gen1",
      "input": "scripts/gen1_sources.sh",
      "mode": "hosted product-default profile (compiler defaults; acceptance profile is explicit)",
      "profile": "hosted_product",
      "acceptance_profile": "hosted_acceptance",
      "output": "Gen3"
    },
    "gen3": {
      "producer": "Gen2",
      "input": "scripts/gen1_sources.sh",
      "mode": "hosted product-default profile (compiler defaults; acceptance profile is explicit)",
      "profile": "hosted_product",
      "acceptance_profile": "hosted_acceptance",
      "output": "Gen4"
    },
    "warmup": {
      "artifact": "Gen2",
      "rule": "Gen2 is the first hosted output and may carry a one-time primer-to-hosted lowering transition; compare it with Gen3 before confirming the product.",
      "max_transient_hops": 1
    },
    "fixed_point": "If Gen2 and Gen3 are byte-identical, install Gen3 and skip Gen4; otherwise Gen3 and Gen4 must be byte-identical before installing Gen4"
  },
  "profiles": {
    "primer_oracle": {
      "args": [
        "-O0"
      ],
      "lane": "oracle",
      "purpose": "Gen0 primer compiles Gen1 without relying on a new optimizer pass"
    },
    "hosted_product": {
      "args": [],
      "defaults": {
        "opt_level": 1,
        "ra": "auto"
      },
      "lane": "product",
      "purpose": "hosted product chain uses the compiler's versioned defaults"
    },
    "hosted_acceptance": {
      "args": [
        "-O1",
        "--ra=1"
      ],
      "lane": "acceptance",
      "purpose": "deterministic LLVM-style vreg/SSA acceptance matrix"
    }
  },
  "experimental_primer_slices": [
    {
      "id": "vreg-ssa-tier",
      "paths": [
        "bootstrap/crates/xuemit/src/vreg_alloc.rs",
        "bootstrap/crates/xuemit/src/lib.rs",
        "bootstrap/crates/xumir/src/lib.rs",
        "bootstrap/crates/xuemit/tests/vreg_matrix.rs"
      ],
      "kind": "llvm-style-vreg-ssa-allocator",
      "lane": "oracle-experimental",
      "status": "open",
      "sync_id": "SYNC-F14",
      "mirror_paths": [
        "src/cmd/compile/emit_frame.xu",
        "src/cmd/compile/emit_ra_ls.xu",
        "src/xu/types/mir_17_opt_promote.xu",
        "src/xu/types/mir_19_verify.xu"
      ],
      "product_evidence": false,
      "promotion": "Prove hosted Xu parity and a product fixed point (Gen2==Gen3, or Gen3==Gen4 after a Gen2 warm-up transition) before any Rust allocator change can be release evidence."
    },
    {
      "id": "oracle-string-intrinsic-compat",
      "paths": [
        "bootstrap/crates/xu/src/string_compat.rs",
        "bootstrap/crates/xu/src/string_compat.xu"
      ],
      "kind": "existing-stdlib-correctness-bridge",
      "lane": "oracle-experimental",
      "status": "open",
      "sync_id": "SYNC-F19",
      "mirror_paths": [
        "src/xu/types/check_12_call.xu",
        "src/cmd/compile/rt_string.xu",
        "src/cmd/compile/rt_array.xu"
      ],
      "product_evidence": false,
      "promotion": "Oracle-only declarations for existing product intrinsics; require string fixture and fail-loud parity. Never inject this source into the hosted product chain."
    },
    {
      "id": "oracle-diagnostics-parity",
      "paths": [
        "bootstrap/crates/xu/src/check_risks.rs",
        "bootstrap/crates/xu/src/run_pat.rs",
        "bootstrap/crates/xuhir/src/names.rs"
      ],
      "kind": "oracle-diagnostic-and-check-parity",
      "lane": "oracle-experimental",
      "status": "open",
      "sync_id": "SYNC-F15",
      "mirror_paths": [
        "src/xu/types/check_00_names.xu",
        "src/xu/types/check_16_risks.xu",
        "src/xu/types/run_pat.xu"
      ],
      "product_evidence": false,
      "promotion": "Keep Xu files as product authority; Rust helpers may only validate an existing contract until hosted parity is demonstrated."
    }
  ],
  "auxiliary_bootstrap_slices": [
    {
      "id": "watermark-build-bridge",
      "paths": [
        "bootstrap/crates/xu/build.rs"
      ],
      "kind": "primer-build-plumbing",
      "lane": "oracle-build",
      "status": "accepted",
      "sync_id": "SYNC-H01",
      "mirror_paths": [],
      "product_evidence": false,
      "promotion": "Build-only bridge; no generated source may enter src/ or the hosted product chain."
    },
    {
      "id": "xuplay-wasm",
      "paths": [
        "bootstrap/crates/xuplay/Cargo.toml",
        "bootstrap/crates/xuplay/src/interp.rs",
        "bootstrap/crates/xuplay/src/lib.rs"
      ],
      "kind": "playground-auxiliary",
      "lane": "auxiliary",
      "status": "accepted",
      "sync_id": "SYNC-F16",
      "mirror_paths": [],
      "product_evidence": false,
      "promotion": "Playground/WASM only; its interpreter and exports are not compiler fixed-point evidence."
    }
  ],
  "untracked_policy": {
    "implementation_suffixes": [
      ".rs",
      "Cargo.toml"
    ],
    "normal_mode": "warn",
    "strict_mode": "fail",
    "strict_requires_registration": true
  },
  "source_manifest": {
    "script": "scripts/gen1_sources.sh",
    "seed_domains": [
      "src/cmd/compile",
      "src/xu/ast",
      "src/xu/scanner",
      "src/xu/parser",
      "src/xu/printer",
      "src/xu/format",
      "src/xu/types"
    ],
    "main_first": "src/cmd/compile/main.xu",
    "stdlib_root": "src",
    "closure": {
      "kind": "transitive-import-closure",
      "module_directive": "#<module-id>",
      "directory_members": "all-direct-xu",
      "exclude_seed": true,
      "extensions": [
        ".xu"
      ]
    },
    "stdlib_modules": [
      "compress/flate",
      "context",
      "crypto/ed25519",
      "crypto/rand",
      "crypto/sha256",
      "crypto/sha512",
      "crypto/subtle",
      "encoding/base64",
      "encoding/hex",
      "encoding/json",
      "errors",
      "hash/crc32",
      "internal/dependency",
      "internal/modulepath",
      "internal/modulezip",
      "internal/semver",
      "internal/sumdb",
      "io",
      "math",
      "math/big",
      "os",
      "os/exec",
      "path",
      "path/filepath",
      "strconv",
      "strings",
      "time",
      "unicode",
      "unicode/utf8"
    ],
    "note": "The seed list is the compiler input contract; the transitive stdlib closure is the complete source provenance set. A seed count alone must never be reported as a complete compiler source manifest."
  },
  "required_paths": [
    "bootstrap/BOUNDARY.json",
    ".github/workflows/ci.yml",
    ".github/workflows/windows.yml",
    ".github/workflows/oracle.yml",
    "bootstrap/Cargo.toml",
    "bootstrap/FROZEN.md",
    "bootstrap/SYNC_DIFF.md",
    "Makefile",
    "docs/BOOTSTRAP.md",
    "docs/audit/BOOTSTRAP_XU_BOUNDARY.md",
    "tests/test_bootstrap_boundary_contract.py",
    "scripts/check_bootstrap_xu_boundary.py",
    "bootstrap/crates/xu/src",
    "bootstrap/crates/xuhir/src",
    "bootstrap/crates/xumir/src",
    "bootstrap/crates/xuemit/src",
    "bootstrap/crates/xurt/src",
    "src/cmd/compile/main.xu",
    "src/xu",
    "src/runtime",
    "scripts/gen1_sources.sh",
    "scripts/build_hosted_chain.sh",
    "scripts/xu_host_seed.sh",
    "scripts/run_product_compiler.sh",
    "scripts/build_platform_xu.sh",
    "scripts/build_product_tools.sh",
    "scripts/pack_developer_xu.sh",
    "scripts/cli_platform_test.sh",
    "scripts/deploy_xu_server.sh",
    "scripts/deploy_xu_remote.sh",
    "scripts/pack_macos_ui_app.py",
    "scripts/pack_macos_ui_oneexe.py",
    "scripts/pack_linux_ui_oneexe.py",
    "scripts/pack_windows_ui_oneexe.py",
    "scripts/xu_doctor.py",
    "scripts/programs_cross_check.sh",
    "scripts/run_fixtures.sh",
    "scripts/platform_test.sh",
    "tests/platform_contract.sh",
    "scripts/e2_qemu_hello.sh",
    "scripts/product_math_x64_test.sh",
    "scripts/product_algorithm_x64_test.sh",
    "scripts/tls_cross_compile_test.sh",
    "scripts/tls_interop_test.sh",
    "scripts/x509_revocation_test.sh",
    "scripts/check_crypto_constant_time_codegen.py",
    "scripts/scheduler_stress.py",
    "scripts/language_eval.py"
  ],
  "product_consumers": [
    "scripts/run_product_compiler.sh",
    "scripts/build_product_tools.sh",
    "scripts/build_platform_xu.sh",
    "scripts/pack_developer_xu.sh",
    "scripts/cli_platform_test.sh",
    "scripts/deploy_xu_server.sh",
    "scripts/pack_macos_ui_oneexe.py",
    "scripts/pack_linux_ui_oneexe.py",
    "scripts/pack_windows_ui_oneexe.py",
    "scripts/product_math_x64_test.sh",
    "scripts/product_algorithm_x64_test.sh",
    "scripts/tls_cross_compile_test.sh",
    "scripts/tls_interop_test.sh",
    "scripts/x509_revocation_test.sh",
    "scripts/check_crypto_constant_time_codegen.py"
  ],
  "product_seed_consumers": {
    "lane": "product",
    "explicit_only": true,
    "paths": [
      "scripts/product_math_x64_test.sh",
      "scripts/product_algorithm_x64_test.sh",
      "scripts/tls_cross_compile_test.sh",
      "scripts/tls_interop_test.sh",
      "scripts/x509_revocation_test.sh",
      "scripts/check_crypto_constant_time_codegen.py"
    ],
    "rule": "These product-facing regressions/benchmarks resolve bin/xu or a hosted snapshot through xu_host_seed.sh and compile product work through run_product_compiler.sh; primer/cargo fallback is forbidden. Any primer diagnostic branch must be explicit and cannot be product evidence."
  },
  "product_orchestrators": [
    {
      "path": "scripts/deploy_xu_remote.sh",
      "delegates_to": "scripts/deploy_xu_server.sh",
      "lane": "product",
      "purpose": "remote deployment must inherit the local product compiler seam"
    },
    {
      "path": "scripts/pack_macos_ui_app.py",
      "delegates_to": "scripts/pack_macos_ui_oneexe.py",
      "lane": "product",
      "purpose": "app bundle wrapper must inherit the oneexe product compiler seam"
    }
  ],
  "oracle_consumers": {
    "explicit_only": true,
    "paths": [
      "scripts/gen1_test.sh",
      "scripts/gen1_platform_test.sh",
      "scripts/hardening_gate.sh",
      "scripts/safety_test.sh",
      "scripts/safety_cross_target.sh",
      "scripts/safety_embedded.sh",
      "scripts/safety_escape_test.sh",
      "scripts/test_runtime_data_alignment.sh",
      "scripts/test_runtime_lifetime_policy.sh",
      "scripts/test_string_temp_lifetime.sh",
      "scripts/test_vreg_matrix.sh",
      "scripts/test_vreg_selfhost.sh"
    ],
    "rule": "These scripts may build/use bootstrap only as explicitly labelled oracle or diagnostic evidence; they must never install bin/xu or satisfy product-selfhost."
  },
  "diagnostic_consumers": {
    "lane": "oracle",
    "explicit_only": true,
    "paths": [
      "tests/platform_contract.sh",
      "scripts/e2_qemu_hello.sh"
    ],
    "rule": "These benchmark and target-contract scripts intentionally exercise the frozen bootstrap primer; their timings, ELF checks, and diagnostics are oracle evidence only and cannot establish hosted product support."
  },
  "dual_consumers": {
    "lane": "dual",
    "explicit_only": true,
    "paths": [
      "scripts/programs_cross_check.sh",
      "scripts/run_fixtures.sh",
      "scripts/platform_test.sh",
      "scripts/scheduler_stress.py",
      "scripts/language_eval.py"
    ],
    "product_compile_paths": [
      "scripts/programs_cross_check.sh",
      "scripts/run_fixtures.sh",
      "scripts/platform_test.sh",
      "scripts/scheduler_stress.py"
    ],
    "rule": "These harnesses compare or exercise compiler lanes. Bootstrap is labelled oracle and a hosted --xu/product selection is labelled product; no single result is a product fixed-point proof."
  },
  "product_probes": {
    "lane": "product",
    "explicit_only": true,
    "paths": [
      "scripts/xu_doctor.py"
    ],
    "rule": "Product-facing probes must resolve a hosted seed through xu_host_seed.sh, reject bootstrap in the product lane, and expose oracle only as an explicit diagnostic mode; they must never invoke cargo as a fallback."
  },
  "boundary_infrastructure": {
    "paths": [
      {
        "path": "scripts/xu_host_seed.sh",
        "kind": "seed-resolver",
        "lanes": [
          "product",
          "oracle-recovery"
        ]
      },
      {
        "path": "scripts/build_hosted_chain.sh",
        "kind": "generation-orchestrator",
        "lanes": [
          "product",
          "oracle-recovery"
        ]
      },
      {
        "path": "scripts/run_product_compiler.sh",
        "kind": "product-wrapper",
        "lanes": [
          "product"
        ]
      },
      {
        "path": "scripts/check_bootstrap_xu_boundary.py",
        "kind": "policy-checker",
        "lanes": [
          "all"
        ]
      },
      {
        "path": "scripts/gen1_sources.sh",
        "kind": "source-manifest",
        "lanes": [
          "oracle",
          "product"
        ]
      },
      {
        "path": "Makefile",
        "kind": "top-level-entrypoints",
        "lanes": [
          "product",
          "oracle"
        ]
      }
    ],
    "rule": "These six files define the executable boundary itself; changing a resolver, chain hop, source manifest, or top-level lane requires the strict checker before any product or oracle claim."
  },
  "mirrors": [
    {
      "id": "frontend",
      "product_paths": [
        "src/xu/ast",
        "src/xu/scanner",
        "src/xu/parser",
        "src/xu/printer",
        "src/xu/format",
        "src/xu/types"
      ],
      "primer_paths": [
        "bootstrap/crates/xuparse/src",
        "bootstrap/crates/xuhir/src",
        "bootstrap/crates/xumir/src"
      ],
      "evidence": "shared fixtures, oracle diagnostics, and the hosted fixed-point gate"
    },
    {
      "id": "emitter-and-targets",
      "product_paths": [
        "src/cmd/compile"
      ],
      "primer_paths": [
        "bootstrap/crates/xuasm/src",
        "bootstrap/crates/xubackend/src",
        "bootstrap/crates/xubin/src",
        "bootstrap/crates/xuemit/src"
      ],
      "evidence": "target matrix plus Gen1/Gen2/Gen3/Gen4 output checks"
    }
  ],
  "runtime_contract_registry": {
    "schema": 1,
    "registry": "src/runtime/ABI.json",
    "generated": "src/xu/types/runtime_abi_generated.xu",
    "generator": "scripts/generate_runtime_abi_registry.py"
  },
  "runtime_abi": [
    {
      "id": "allocator-and-ledger",
      "product_paths": [
        "src/cmd/compile/rt_heap_sync.xu"
      ],
      "primer_paths": [
        "bootstrap/crates/xurt/src/lib.rs"
      ],
      "symbols": [
        "_rt_alloc",
        "_rt_free",
        "_rt_heap_stats",
        "_rt_heap_record_alloc",
        "_rt_heap_record_free"
      ],
      "policy": "same ABI; Gen1 strict ledger remains capability-off until parity is proven"
    },
    {
      "id": "strings",
      "product_paths": [
        "src/cmd/compile/rt_string_base.xu",
        "src/cmd/compile/rt_string.xu"
      ],
      "primer_paths": [
        "bootstrap/crates/xurt/src/lib.rs"
      ],
      "symbols": [
        "_rt_str_concat",
        "_rt_push_str",
        "_rt_str_clone",
        "_rt_str_slice",
        "_rt_str_eq"
      ],
      "policy": "descriptor bounds and fail-closed diagnostics are a dual-ended contract"
    },
    {
      "id": "arrays",
      "product_paths": [
        "src/cmd/compile/rt_array.xu"
      ],
      "primer_paths": [
        "bootstrap/crates/xurt/src/lib.rs"
      ],
      "symbols": [
        "_rt_arr_push",
        "_rt_arr_grow",
        "_rt_array_slice",
        "_rt_array_slice_str"
      ],
      "policy": "descriptor layout, overflow checks, and ownership/drop behavior must stay compatible"
    },
    {
      "id": "channels-and-scheduler",
      "product_paths": [
        "src/cmd/compile/rt_chan.xu",
        "src/cmd/compile/rt_pthread.xu"
      ],
      "primer_paths": [
        "bootstrap/crates/xurt/src/lib.rs"
      ],
      "symbols": [
        "_rt_chan_new",
        "_rt_chan_send",
        "_rt_chan_recv",
        "_rt_chan_close",
        "_rt_chan_try_send",
        "_rt_chan_try_recv",
        "_rt_xu",
        "_rt_g_start",
        "_rt_gogo",
        "_rt_park_until"
      ],
      "policy": "state transitions and wake-up behavior require bounded stress evidence; no formal safety claim"
    }
  ],
  "invariants": {
    "product_source_must_not_import_bootstrap": true,
    "product_source_must_not_reference_primer": true,
    "oracle_requires_frozen_primer": true,
    "frozen_primer_paths": [
      "bootstrap/target/debug/xu",
      "bootstrap/target/debug/xu.exe",
      "bootstrap/target/release/xu",
      "bootstrap/target/release/xu.exe"
    ],
    "oracle_path_guard_scripts": [
      "scripts/cli_platform_test.sh",
      "scripts/check_crypto_constant_time_codegen.py",
      "scripts/deploy_xu_server.sh",
      "scripts/hardening_gate.sh",
      "scripts/language_eval.py",
      "scripts/platform_test.sh",
      "scripts/run_fixtures.sh",
      "scripts/scheduler_stress.py",
      "scripts/xu_doctor.py"
    ],
    "oracle_strict_resolver_scripts": [
      "scripts/e2_qemu_hello.sh",
      "scripts/gen1_platform_test.sh",
      "scripts/gen1_test.sh",
      "scripts/programs_cross_check.sh",
      "scripts/safety_cross_target.sh",
      "scripts/safety_embedded.sh",
      "scripts/safety_escape_test.sh",
      "scripts/safety_test.sh",
      "scripts/test_runtime_data_alignment.sh",
      "scripts/test_runtime_lifetime_policy.sh",
      "scripts/test_string_temp_lifetime.sh",
      "scripts/test_vreg_matrix.sh",
      "scripts/test_vreg_selfhost.sh",
      "tests/platform_contract.sh"
    ],
    "gen1_heap_ledger_enabled_default": 0,
    "product_seed_must_not_fallback_to_bootstrap": true,
    "watermark_source_allowlist": [
      "bootstrap/crates/xu/src/xu_mark.rs",
      "bootstrap/crates/xurt/src/lib.rs",
      "bootstrap/crates/xu/tests/e2e.rs"
    ]
  }
}
