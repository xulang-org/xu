# ===================================================================
# 11. OS / IDE / toolchain junk & legal filings
# ===================================================================
/软件著作权申请资料/
.DS_Store
Thumbs.db
Desktop.ini

# Python
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.pytest_cache/

# Editors & IDEs
*.swp
*.swo
*~
.idea/
/.vscode/
*.vsix
.codex-tmp/
/.codex/
/.claude/
/.cache/
