/build/
/xu
/xx2
target/
*.xin
*.o
*.a
*.dylib
*.so
*.dll
server.md
.agents
.cursor

# Bootstrap Rust build cache
bootstrap/target/

# LLVM source tree (vendored, never committed)
/llvm-project-*/

# ===================================================================
# 2. Distribution / packaging (generated, large binaries)
# ===================================================================
# Distribution archives, application bundles and staging trees stay local.
/dist/

