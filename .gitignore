node_modules/

# Local environment files; only empty/example templates belong in Git.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# ===================================================================
# 12. Xu server config (contains secrets)
# ===================================================================

# External modules are owned by the independent packages repository.
/packages/

# Frozen Rust primer sources belong to the sibling bootstrap repository.
/bootstrap/

# The VS Code extension is maintained in the sibling vscode repository.
/editors/vscode/
# Independent companion checkouts created only by GitHub Actions.
.ci/

# Kernel transaction lock files have process lifetime ownership.
.xu-deps.lck
.xu-lock.lck
