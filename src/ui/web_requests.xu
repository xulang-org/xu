@ui

#errors

pub const REQUEST_WEBVIEW_EVAL = 8
pub const REQUEST_WEBVIEW_FIND = 9
pub const REQUEST_WEBVIEW_COOKIES_GET = 10
pub const REQUEST_WEBVIEW_COOKIE_SET = 11
pub const REQUEST_WEBVIEW_COOKIES_CLEAR = 12

// Same deadline, cancellation, generation and terminal-result contract as other
// desktop services. Native side effects already performed cannot be undone.
pub fn webview_request_async(target &CanvasEvent,kind int,value &string,options &RequestOptions) Request {
    if kind < REQUEST_WEBVIEW_EVAL || kind > REQUEST_WEBVIEW_COOKIES_CLEAR { >> errors.new("ui: invalid WebView request kind") }
    empty := ""
    << submit_request(target,kind,&empty,value,options.timeout_ms,0) or >>
}
pub fn webview_request_wait(target &CanvasEvent,kind int,value &string,options &RequestOptions) RequestResult {
    if kind < REQUEST_WEBVIEW_EVAL || kind > REQUEST_WEBVIEW_COOKIES_CLEAR { >> errors.new("ui: invalid WebView request kind") }
    empty := ""
    request := submit_request(target,kind,&empty,value,options.timeout_ms,1) or >>
    << wait_request(&request) or >>
}
