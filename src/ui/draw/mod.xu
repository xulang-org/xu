@ui/draw

#ui

// Immediate-mode canvas (Love2D / Raylib / Cairo-style) on `#ui` content_draw.
// No WebView. Origin is top-left, pixels. begin() clears the display list
// and resets the pen; present() commits a complete display list. The last
// committed frame remains visible while the next is built; cancel() discards it.
// Clicks/prompt/scroll/drag: poll(app.event_ch) / poll_click / prompt —
// `#ui` owns the host event pump; this package does not read the shell event file.
//
// Color: "#RRGGBB" or "#RRGGBBAA". "-" skips a fill or stroke.
// Pen (host-side, like love.graphics.setColor): set_color / set_fill /
// set_stroke / set_width, then rect/circle/ellipse/triangle.
// Transform stack (CTM): push / pop / origin / translate / rotate / scale.
// scale(sx,sy) is percent (100 = 1x). rotate is degrees, clockwise.


pub struct Point {
    pub x int
    pub y int
}

pub struct Click {
    pub x int
    pub y int
    pub ok int
}

pub const IN_NONE = 0
pub const IN_CLICK = 1
pub const IN_SCROLL = 2
pub const IN_DRAG = 3

pub struct Input {
    pub kind int
    pub x int
    pub y int
    pub dx int
    pub dy int
}

fn clean(s string) string {
    mut out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if c == 9 || c == 10 || c == 13 {
            out = out + " "
        } else {
            out = out + string_from_byte(c)
        }
    }
    << out
}

fn cmd(line string) int {
    << ui.append_content_cmd(line) or (err) {
        << 0 - 1
    }
}

fn hex_or_dash(s string) string {
    if s.len == 0 {
        << "-"
    }
    << s + ""
}

// Attach the draw canvas to a window (registers the content_draw plugin).
pub fn attach(w &mut ui.Window) int {
    << ui.use_draw_content(w)
}

// Opt in to pointer/key events on the shared ui event channel.
pub fn set_input_enabled(on int) int {
    << cmd("input_enabled\t" + str(on))
}

// Cursor: default, text, crosshair, hand, horizontal/vertical resize.
pub fn set_cursor(cursor int) int {
    if cursor < 0 || cursor > 5 { << 0 - 1 }
    << cmd("cursor\t" + str(cursor))
}

// Built-in camera movement is off by default on every desktop platform.
// Pass 1 to enable drag/wheel panning; disabling resets the camera offset.
// Pointer/key events are controlled independently by set_input_enabled.
pub fn set_pan_enabled(on int) int {
    << cmd("pan_enabled\t" + str(on))
}

pub fn begin() int {
    << cmd("begin")
}

pub fn present() int {
    << cmd("present")
}

pub fn cancel() int {
    << cmd("cancel")
}

pub fn clear() int {
    << cmd("draw_clear")
}

pub fn set_bg(hex string) int {
    << cmd("bgcolor\t" + hex_or_dash(hex))
}

pub fn set_color(hex string) int {
    << cmd("color\t" + hex_or_dash(hex))
}

pub fn set_fill(hex string) int {
    << cmd("fill\t" + hex_or_dash(hex))
}

pub fn set_stroke(hex string) int {
    << cmd("stroke\t" + hex_or_dash(hex))
}

pub fn set_width(w int) int {
    << cmd("width\t" + str(w))
}

pub fn push() int {
    << cmd("push")
}

pub fn pop() int {
    << cmd("pop")
}

// Intersect the current clip with a rectangle in the current transform.
// push/pop save and restore the clip together with transform and pen.
pub fn clip_rect(x int, y int, w int, h int) int {
    if w < 0 || h < 0 { << 0 - 1 }
    << cmd("clip_rect\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h))
}

pub fn origin() int {
    << cmd("origin")
}

pub fn translate(dx int, dy int) int {
    << cmd("translate\t" + str(dx) + "\t" + str(dy))
}

pub fn rotate(deg int) int {
    << cmd("rotate\t" + str(deg))
}

pub fn scale(sx int, sy int) int {
    << cmd("scale\t" + str(sx) + "\t" + str(sy))
}

pub fn fill_rect(x int, y int, w int, h int, hex string) int {
    << cmd("fill_rect\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h) + "\t" + hex_or_dash(hex))
}

pub fn stroke_rect(x int, y int, w int, h int, hex string, width int) int {
    << cmd("stroke_rect\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h) + "\t" + hex_or_dash(hex) + "\t" + str(width))
}

pub fn round_rect(x int, y int, w int, h int, radius int, fill string, stroke string, width int) int {
    << cmd("round_rect\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h) + "\t" + str(radius) + "\t" + hex_or_dash(fill) + "\t" + hex_or_dash(stroke) + "\t" + str(width))
}

pub fn diamond(x int, y int, w int, h int, fill string, stroke string, width int) int {
    << cmd("diamond\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h) + "\t" + hex_or_dash(fill) + "\t" + hex_or_dash(stroke) + "\t" + str(width))
}

pub fn line(x1 int, y1 int, x2 int, y2 int, hex string, width int) int {
    << cmd("line\t" + str(x1) + "\t" + str(y1) + "\t" + str(x2) + "\t" + str(y2) + "\t" + hex_or_dash(hex) + "\t" + str(width))
}

pub fn text(x int, y int, size int, hex string, s string) int {
    << cmd("text\t" + str(x) + "\t" + str(y) + "\t" + str(size) + "\t" + hex_or_dash(hex) + "\t" + clean(s))
}

pub fn arrow(x1 int, y1 int, x2 int, y2 int, hex string, width int) int {
    col := hex + ""
    a0 := line(x1, y1, x2, y2, col + "", width)
    dx := x2 - x1
    dy := y2 - y1
    mut sx := 0
    mut sy := 0
    if dx > 4 {
        sx = 10
    } else {
        if dx < 0 - 4 {
            sx = 0 - 10
        }
    }
    if dy > 4 {
        sy = 10
    } else {
        if dy < 0 - 4 {
            sy = 0 - 10
        }
    }
    a1 := line(x2, y2, x2 - sx + sy / 2, y2 - sy - sx / 2, col + "", width)
    if a0 + a1 < 0 {
    }
    << line(x2, y2, x2 - sx - sy / 2, y2 - sy + sx / 2, col, width)
}

pub fn rect(x int, y int, w int, h int) int {
    << cmd("rect\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h))
}

pub fn rect_line(x int, y int, w int, h int) int {
    << cmd("rect_line\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h))
}

pub fn circle(cx int, cy int, r int) int {
    << cmd("circle\t" + str(cx) + "\t" + str(cy) + "\t" + str(r))
}

pub fn circle_line(cx int, cy int, r int) int {
    << cmd("circle_line\t" + str(cx) + "\t" + str(cy) + "\t" + str(r))
}

pub fn fill_circle(cx int, cy int, r int, hex string) int {
    << cmd("circle\t" + str(cx) + "\t" + str(cy) + "\t" + str(r) + "\t" + hex_or_dash(hex) + "\t-\t1")
}

pub fn stroke_circle(cx int, cy int, r int, hex string, width int) int {
    << cmd("circle\t" + str(cx) + "\t" + str(cy) + "\t" + str(r) + "\t-\t" + hex_or_dash(hex) + "\t" + str(width))
}

pub fn ellipse(x int, y int, w int, h int) int {
    << cmd("ellipse\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h))
}

pub fn ellipse_line(x int, y int, w int, h int) int {
    << cmd("ellipse_line\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h))
}

pub fn fill_ellipse(x int, y int, w int, h int, hex string) int {
    << cmd("ellipse\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h) + "\t" + hex_or_dash(hex) + "\t-\t1")
}

pub fn stroke_ellipse(x int, y int, w int, h int, hex string, width int) int {
    << cmd("ellipse\t" + str(x) + "\t" + str(y) + "\t" + str(w) + "\t" + str(h) + "\t-\t" + hex_or_dash(hex) + "\t" + str(width))
}

pub fn triangle(x1 int, y1 int, x2 int, y2 int, x3 int, y3 int) int {
    << cmd("triangle\t" + str(x1) + "\t" + str(y1) + "\t" + str(x2) + "\t" + str(y2) + "\t" + str(x3) + "\t" + str(y3))
}

pub fn triangle_line(x1 int, y1 int, x2 int, y2 int, x3 int, y3 int) int {
    << cmd("triangle_line\t" + str(x1) + "\t" + str(y1) + "\t" + str(x2) + "\t" + str(y2) + "\t" + str(x3) + "\t" + str(y3))
}

pub fn fill_triangle(x1 int, y1 int, x2 int, y2 int, x3 int, y3 int, hex string) int {
    << cmd("triangle\t" + str(x1) + "\t" + str(y1) + "\t" + str(x2) + "\t" + str(y2) + "\t" + str(x3) + "\t" + str(y3) + "\t" + hex_or_dash(hex) + "\t-\t1")
}

pub fn stroke_triangle(x1 int, y1 int, x2 int, y2 int, x3 int, y3 int, hex string, width int) int {
    << cmd("triangle\t" + str(x1) + "\t" + str(y1) + "\t" + str(x2) + "\t" + str(y2) + "\t" + str(x3) + "\t" + str(y3) + "\t-\t" + hex_or_dash(hex) + "\t" + str(width))
}

pub fn poly(pts &[]Point, fill string, stroke string, width int) int {
    mut line := "poly\t" + hex_or_dash(fill) + "\t" + hex_or_dash(stroke) + "\t" + str(width)
    for i in 0:pts.len {
        line = line + "\t" + str(pts[i].x) + "\t" + str(pts[i].y)
    }
    << cmd(line)
}

pub fn arc(cx int, cy int, r int, deg0 int, deg1 int, hex string, width int) int {
    << cmd("arc\t" + str(cx) + "\t" + str(cy) + "\t" + str(r) + "\t" + str(deg0) + "\t" + str(deg1) + "\t" + hex_or_dash(hex) + "\t" + str(width))
}

pub fn point(x int, y int, hex string, r int) int {
    mut rad := r
    if rad < 1 {
        rad = 1
    }
    << fill_circle(x, y, rad, hex)
}

pub fn click_of(ev ui.Event) Click {
    if ev.kind == ui.EV_CLICK {
        << Click{x: ev.width, y: ev.height, ok: 1}
    }
    << Click{x: 0, y: 0, ok: 0}
}

// Next UI event if it is a canvas click (ok=0 otherwise). Uses App.event_ch.
pub fn poll_click(ech chan ui.Event) Click {
    << click_of(ui.poll_chan(ech))
}

// Click, trackpad/mouse-wheel scroll, or drag-to-pan. Other events → in_none.
pub fn poll(ech chan ui.Event) Input {
    ev := ui.poll_chan(ech)
    if ev.kind == ui.EV_CLICK {
        << Input{kind: IN_CLICK, x: ev.width, y: ev.height, dx: 0, dy: 0}
    }
    if ev.kind == ui.EV_SCROLL {
        << Input{kind: IN_SCROLL, x: 0, y: 0, dx: ev.width, dy: ev.height}
    }
    if ev.kind == ui.EV_DRAG {
        << Input{kind: IN_DRAG, x: 0, y: 0, dx: ev.width, dy: ev.height}
    }
    << Input{kind: IN_NONE, x: 0, y: 0, dx: 0, dy: 0}
}

// Compatibility: returns empty text on cancel/failure/timeout. Use ui.prompt_async
// for explicit outcomes. The event channel is preserved, including unrelated events.
pub fn prompt(ech chan ui.Event, title string, seed string) string {
    target := ui.default_canvas() or (err) { << "" }
    options := ui.PromptOptions{title: title, seed: seed, timeout_ms: 10000}
    result := ui.prompt_wait(&target, &options) or (err) { << "" }
    if result.status == ui.REQUEST_COMPLETED { << result.value }
    << ""
}

pub fn in_rect(c Click, x int, y int, w int, h int) bool {
    if c.ok == 0 {
        << false
    }
    if c.x < x {
        << false
    }
    if c.y < y {
        << false
    }
    if c.x >= x + w {
        << false
    }
    if c.y >= y + h {
        << false
    }
    << true
}

pub fn in_circle(c Click, cx int, cy int, r int) bool {
    if c.ok == 0 {
        << false
    }
    dx := c.x - cx
    dy := c.y - cy
    << dx * dx + dy * dy <= r * r
}
