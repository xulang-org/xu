@ui/draw

#errors
#math

// Speech bubble / tooltip callout box with a pointer tail on DIR_UP, DIR_RIGHT, DIR_DOWN, or DIR_LEFT.
// tail_pos in [0, 1] positions the tail along the chosen edge.
pub fn (path $&Path) callout(x f64, y f64, width f64, height f64, radius f64, side int, tail_pos f64, tail_width f64, tail_height f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       !valid_scalar(radius) || side < DIR_UP || side > DIR_LEFT ||
       !valid_scalar(tail_pos) || !valid_extent(tail_width) || !valid_extent(tail_height) {
        >> errors.new("draw: invalid callout geometry")
    }
    r := clamp_corner_radius(radius, math.min(width, height) * 0.4)
    k := r * bezier_kappa()
    u := math.max(0.15, math.min(0.85, clamp_unit(tail_pos)))
    tw := math.min(tail_width * 0.5, math.max(2.0, (math.min(width, height) - r * 2.0) * 0.35))
    tx := x + r + (width - r * 2.0) * u
    ty := y + r + (height - r * 2.0) * u

    path.move_to(x + r, y) or >>
    if side == DIR_UP {
        path.line_to(math.max(x + r, tx - tw), y) or >>
        path.line_to(tx, y - tail_height) or >>
        path.line_to(math.min(x + width - r, tx + tw), y) or >>
    }
    path.line_to(x + width - r, y) or >>
    if r > 0.0 {
        path.cubic_to(x + width - r + k, y, x + width, y + r - k, x + width, y + r) or >>
    }
    if side == DIR_RIGHT {
        path.line_to(x + width, math.max(y + r, ty - tw)) or >>
        path.line_to(x + width + tail_height, ty) or >>
        path.line_to(x + width, math.min(y + height - r, ty + tw)) or >>
    }
    path.line_to(x + width, y + height - r) or >>
    if r > 0.0 {
        path.cubic_to(x + width, y + height - r + k, x + width - r + k, y + height, x + width - r, y + height) or >>
    }
    if side == DIR_DOWN {
        path.line_to(math.min(x + width - r, tx + tw), y + height) or >>
        path.line_to(tx, y + height + tail_height) or >>
        path.line_to(math.max(x + r, tx - tw), y + height) or >>
    }
    path.line_to(x + r, y + height) or >>
    if r > 0.0 {
        path.cubic_to(x + r - k, y + height, x, y + height - r + k, x, y + height - r) or >>
    }
    if side == DIR_LEFT {
        path.line_to(x, math.min(y + height - r, ty + tw)) or >>
        path.line_to(x - tail_height, ty) or >>
        path.line_to(x, math.max(y + r, ty - tw)) or >>
    }
    path.line_to(x, y + r) or >>
    if r > 0.0 {
        path.cubic_to(x, y + r - k, x + r - k, y, x + r, y) or >>
    }
    path.close() or >>
    << 0
}

pub fn (frame $&Frame) fill_callout(x f64, y f64, width f64, height f64, radius f64, side int, tail_pos f64, tail_width f64, tail_height f64, color Color) int {
    $path := new_path(512)
    path.callout(x, y, width, height, radius, side, tail_pos, tail_width, tail_height) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_callout(x f64, y f64, width f64, height f64, radius f64, side int, tail_pos f64, tail_width f64, tail_height f64, color Color, line_width f64) int {
    $path := new_path(512)
    path.callout(x, y, width, height, radius, side, tail_pos, tail_width, tail_height) or >>
    options := round_stroke(line_width)
    << frame.stroke_path(&path, color, &options) or >>
}

// Horizontal cubic Bezier Sankey / flow ribbon connecting [x1, y1_top..y1_bot] to [x2, y2_top..y2_bot].
pub fn (path $&Path) ribbon(x1 f64, y1_top f64, y1_bot f64, x2 f64, y2_top f64, y2_bot f64) int {
    if !valid_scalar(x1) || !valid_scalar(y1_top) || !valid_scalar(y1_bot) ||
       !valid_scalar(x2) || !valid_scalar(y2_top) || !valid_scalar(y2_bot) {
        >> errors.new("draw: invalid ribbon coordinates")
    }
    mx := (x1 + x2) * 0.5
    path.move_to(x1, y1_top) or >>
    path.cubic_to(mx, y1_top, mx, y2_top, x2, y2_top) or >>
    path.line_to(x2, y2_bot) or >>
    path.cubic_to(mx, y2_bot, mx, y1_bot, x1, y1_bot) or >>
    path.close() or >>
    << 0
}

pub fn (frame $&Frame) fill_ribbon(x1 f64, y1_top f64, y1_bot f64, x2 f64, y2_top f64, y2_bot f64, color Color) int {
    $path := new_path(256)
    path.ribbon(x1, y1_top, y1_bot, x2, y2_top, y2_bot) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_ribbon(x1 f64, y1_top f64, y1_bot f64, x2 f64, y2_top f64, y2_bot f64, color Color, width f64) int {
    $path := new_path(256)
    path.ribbon(x1, y1_top, y1_bot, x2, y2_top, y2_bot) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) heart(cx f64, cy f64, size f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(size) {
        >> errors.new("draw: invalid heart geometry")
    }
    r := size * 0.5
    top_y := cy - r * 0.32
    bot_y := cy + r * 0.88
    path.move_to(cx, bot_y) or >>
    path.cubic_to(cx - r * 1.15, cy + r * 0.22, cx - r * 1.05, cy - r * 0.82, cx - r * 0.48, cy - r * 0.82) or >>
    path.cubic_to(cx - r * 0.16, cy - r * 0.82, cx, cy - r * 0.54, cx, top_y) or >>
    path.cubic_to(cx, cy - r * 0.54, cx + r * 0.16, cy - r * 0.82, cx + r * 0.48, cy - r * 0.82) or >>
    path.cubic_to(cx + r * 1.05, cy - r * 0.82, cx + r * 1.15, cy + r * 0.22, cx, bot_y) or >>
    path.close() or >>
    << 0
}

pub fn (frame $&Frame) fill_heart(cx f64, cy f64, size f64, color Color) int {
    $path := new_path(256)
    path.heart(cx, cy, size) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_heart(cx f64, cy f64, size f64, color Color, width f64) int {
    $path := new_path(256)
    path.heart(cx, cy, size) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) shield(cx f64, cy f64, width f64, height f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(width) || !valid_extent(height) {
        >> errors.new("draw: invalid shield geometry")
    }
    hw := width * 0.5
    hh := height * 0.5
    top := cy - hh
    mid := cy - hh * 0.15
    bot := cy + hh
    path.move_to(cx, top) or >>
    path.line_to(cx + hw, top + hh * 0.22) or >>
    path.line_to(cx + hw, mid) or >>
    path.cubic_to(cx + hw, cy + hh * 0.48, cx + hw * 0.45, cy + hh * 0.82, cx, bot) or >>
    path.cubic_to(cx - hw * 0.45, cy + hh * 0.82, cx - hw, cy + hh * 0.48, cx - hw, mid) or >>
    path.line_to(cx - hw, top + hh * 0.22) or >>
    path.close() or >>
    << 0
}

pub fn (frame $&Frame) fill_shield(cx f64, cy f64, width f64, height f64, color Color) int {
    $path := new_path(256)
    path.shield(cx, cy, width, height) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_shield(cx f64, cy f64, width f64, height f64, color Color, line_width f64) int {
    $path := new_path(256)
    path.shield(cx, cy, width, height) or >>
    options := round_stroke(line_width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) gear(cx f64, cy f64, outer_radius f64, inner_radius f64, hole_radius f64, teeth int) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(outer_radius) ||
       !valid_extent(inner_radius) || outer_radius <= inner_radius ||
       !valid_scalar(hole_radius) || hole_radius < 0.0 || hole_radius >= inner_radius ||
       teeth < 4 || teeth > 128 {
        >> errors.new("draw: invalid gear geometry")
    }
    step := (2.0 * math.pi()) / f64(teeth)
    q := step * 0.25
    for i in 0:teeth {
        base := f64(i) * step
        a0 := base
        a1 := base + q * 0.65
        a2 := base + q * 1.85
        a3 := base + q * 2.50
        p0x := cx + inner_radius * math.cos(a0)
        p0y := cy + inner_radius * math.sin(a0)
        if i == 0 { path.move_to(p0x, p0y) or >> }
        else { path.line_to(p0x, p0y) or >> }
        path.line_to(cx + outer_radius * math.cos(a1), cy + outer_radius * math.sin(a1)) or >>
        path.line_to(cx + outer_radius * math.cos(a2), cy + outer_radius * math.sin(a2)) or >>
        path.line_to(cx + inner_radius * math.cos(a3), cy + inner_radius * math.sin(a3)) or >>
    }
    path.close() or >>
    if hole_radius > 0.5 {
        k := hole_radius * bezier_kappa()
        path.move_to(cx + hole_radius, cy) or >>
        path.cubic_to(cx + hole_radius, cy - k, cx + k, cy - hole_radius, cx, cy - hole_radius) or >>
        path.cubic_to(cx - k, cy - hole_radius, cx - hole_radius, cy - k, cx - hole_radius, cy) or >>
        path.cubic_to(cx - hole_radius, cy + k, cx - k, cy + hole_radius, cx, cy + hole_radius) or >>
        path.cubic_to(cx + k, cy + hole_radius, cx + hole_radius, cy + k, cx + hole_radius, cy) or >>
        path.close() or >>
    }
    << 0
}

pub fn (frame $&Frame) fill_gear(cx f64, cy f64, outer_radius f64, inner_radius f64, hole_radius f64, teeth int, color Color) int {
    $path := new_path(teeth * 96 + 256)
    path.gear(cx, cy, outer_radius, inner_radius, hole_radius, teeth) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_gear(cx f64, cy f64, outer_radius f64, inner_radius f64, hole_radius f64, teeth int, color Color, width f64) int {
    $path := new_path(teeth * 96 + 256)
    path.gear(cx, cy, outer_radius, inner_radius, hole_radius, teeth) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) spiral(cx f64, cy f64, start_radius f64, end_radius f64, turns f64, rotation_deg f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_scalar(start_radius) || start_radius < 0.0 ||
       !valid_extent(end_radius) || !valid_extent(turns) || turns > 64.0 || !valid_scalar(rotation_deg) {
        >> errors.new("draw: invalid spiral geometry")
    }
    $steps := int(math.ceil(turns * 36.0))
    if steps < 16 { steps = 16 }
    if steps > 2048 { steps = 2048 }
    base := rotation_deg * deg_to_rad()
    total_rad := turns * 2.0 * math.pi()
    for i in 0:(steps + 1) {
        u := f64(i) / f64(steps)
        r := start_radius + (end_radius - start_radius) * u
        a := base + total_rad * u
        px := cx + r * math.cos(a)
        py := cy + r * math.sin(a)
        if i == 0 { path.move_to(px, py) or >> }
        else { path.line_to(px, py) or >> }
    }
    << 0
}

pub fn (frame $&Frame) spiral(cx f64, cy f64, start_radius f64, end_radius f64, turns f64, rotation_deg f64, color Color, width f64) int {
    $path := new_path(2048)
    path.spiral(cx, cy, start_radius, end_radius, turns, rotation_deg) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

// Clipped diagonal hatch lines inside [x, y, width, height].
pub fn (frame $&Frame) hatch_rect(x f64, y f64, width f64, height f64, spacing f64, reverse bool, color Color, line_width f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       !valid_extent(spacing) || spacing < 2.0 {
        >> errors.new("draw: invalid hatch_rect parameters")
    }
    frame.push() or >>
    frame.clip_rect(x, y, width, height) or >>
    span := width + height
    $d := 0.0
    $count := 0
    while d <= span && count < 2048 {
        if reverse {
            frame.line(x + d, y, x + d - height, y + height, color, line_width) or >>
        } else {
            frame.line(x + d - height, y, x + d, y + height, color, line_width) or >>
        }
        d = d + spacing
        count = count + 1
    }
    frame.pop() or >>
    << 0
}

pub fn (frame $&Frame) cross_hatch_rect(x f64, y f64, width f64, height f64, spacing f64, color Color, line_width f64) int {
    frame.hatch_rect(x, y, width, height, spacing, false, color, line_width) or >>
    frame.hatch_rect(x, y, width, height, spacing, true, color, line_width) or >>
    << 0
}

pub fn (frame $&Frame) dot_grid(x f64, y f64, width f64, height f64, spacing f64, dot_radius f64, color Color) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       !valid_extent(spacing) || spacing < 3.0 || !valid_extent(dot_radius) {
        >> errors.new("draw: invalid dot_grid parameters")
    }
    cols := int(math.floor(width / spacing))
    rows := int(math.floor(height / spacing))
    if cols > 256 || rows > 256 { >> errors.new("draw: dot_grid density exceeds limit") }
    frame.set_fill(color) or >>
    for r in 0:(rows + 1) {
        py := y + f64(r) * spacing
        for c in 0:(cols + 1) {
            px := x + f64(c) * spacing
            frame.circle(px, py, dot_radius) or >>
        }
    }
    << 0
}
