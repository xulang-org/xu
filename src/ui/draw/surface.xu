@ui/draw

#errors
#math
#strings

// An immutable transparent raster layer, scoped to the source frame's canvas.
// Explicit resolution makes cache quality and memory use predictable. Reuse
// this handle in any number of frames; update by creating a replacement first.
// Accepted frames retain old pixels across dispose. Copies share one handle.
pub struct Surface {
    pub width f64
    pub height f64
    pub pixel_width int
    pub pixel_height int
    image Image
}

// Render once, without presenting to the window or using its camera/DPI.
// Source coordinates cover [0,width] x [0,height]; scale determines backing
// pixels (ceil per dimension). The default clear is transparent; set_bg makes
// an opaque clear. The frame remains sealed for present or another snapshot.
pub fn (frame &mut Frame) snapshot(width f64, height f64, scale f64) Surface {
    << frame.snapshot_recording(width,height,scale,false) or >>
}

fn (frame &mut Frame) snapshot_recording(width f64,height f64,scale f64,child bool) Surface {
    size := surface_size(width, height, scale) or >>
    pw := size.width
    ph := size.height
    if child { frame.seal_recording() or >> }
    else { frame.seal() or >> }
    id := reserve_image() or >>
    mut header := strings.new_byte_builder(40)
    header.write_str("XUS1")
    image_word(mut &header, 1, 4)
    image_word(mut &header, id, 8)
    image_word(mut &header, pw, 4)
    image_word(mut &header, ph, 4)
    image_word(mut &header, frame_float_word(width), 8)
    image_word(mut &header, frame_float_word(height), 8)
    wire := header.to_string() + frame.buffer.to_string()
    accepted := write_file(":xu:/__surface_upload", wire) or (err) {
        abandon_image(id)
        >> errors.new("draw: Surface transport failed")
    }
    if accepted != wire.len {
        abandon_image(id)
        >> errors.new("draw: Surface rejected (closed canvas, invalid resources, memory limit or unavailable renderer)")
    }
    context := Context{canvas_id: frame.canvas_id, generation: frame.generation}
    resource := image_metadata(&context, id) or (err) {
        discard_image(id, frame.canvas_id, frame.generation)
        >> errors.new("draw: Surface canvas closed during snapshot")
    }
    << Surface{width: width, height: height, pixel_width: pw, pixel_height: ph, image: resource}
}

pub fn (surface &mut Surface) dispose() int {
    resource := mut &surface.image
    << resource.dispose() or >>
}

// Independent, straight sRGB RGBA8 copy, in top-left row order. The native
// immutable bitmap stays owned by this Surface; editing the copy is safe.
pub fn (surface &Surface) rgba_bytes() string {
    resource := &surface.image
    if resource.id <= 0 { >> errors.new("draw: Surface is disposed") }
    data := read_file(":xu:/__image_rgba/" + str(resource.id) + "/" + str(resource.canvas_id) + "/" + str(resource.generation)) or >>
    if data.len != surface.pixel_width * surface.pixel_height * 4 {
        >> errors.new("draw: Surface pixels unavailable")
    }
    << data
}

// Group opacity is applied once to the cached layer. Destination geometry and
// clipping follow this frame's CTM; source frame transforms are already baked.
pub fn (frame &mut Frame) surface(surface &Surface, x f64, y f64, width f64, height f64, opacity f64, sampler int) int {
    source := ImageRect{x: 0.0, y: 0.0, width: f64(surface.pixel_width), height: f64(surface.pixel_height)}
    destination := ImageRect{x: x, y: y, width: width, height: height}
    << frame.image_region(&surface.image, &source, &destination, opacity, sampler) or >>
}

struct SurfaceSize {
    width int
    height int
}
fn surface_size(width f64, height f64, scale f64) SurfaceSize {
    if math.is_nan(width) || math.is_inf(width) || width <= 0.0 || width > 1000000000.0 ||
       math.is_nan(height) || math.is_inf(height) || height <= 0.0 || height > 1000000000.0 ||
       math.is_nan(scale) || math.is_inf(scale) || scale <= 0.0 || scale > 1000000000.0 ||
       width * scale > f64(MAX_IMAGE_DIMENSION) || height * scale > f64(MAX_IMAGE_DIMENSION) {
        >> errors.new("draw: invalid Surface extent or resolution")
    }
    pw := int(math.ceil(width * scale))
    ph := int(math.ceil(height * scale))
    if pw < 1 || ph < 1 || pw * ph * 4 > MAX_IMAGE_BYTES { >> errors.new("draw: Surface exceeds pixel budget") }
    << SurfaceSize{width: pw, height: ph}
}
