@ui/draw

#errors
#math
#ui/internal/codec

// 2D affine transformation matrix:
// [ a  c  tx ]
// [ b  d  ty ]
// [ 0  0  1  ]
pub struct Matrix2D {
    pub a f64
    pub b f64
    pub c f64
    pub d f64
    pub tx f64
    pub ty f64
}

pub fn identity_matrix() Matrix2D {
    << Matrix2D{a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: 0.0, ty: 0.0}
}

pub fn translation_matrix(tx f64, ty f64) Matrix2D {
    << Matrix2D{a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: tx, ty: ty}
}

pub fn scaling_matrix(sx f64, sy f64) Matrix2D {
    << Matrix2D{a: sx, b: 0.0, c: 0.0, d: sy, tx: 0.0, ty: 0.0}
}

pub fn rotation_matrix(degrees f64) Matrix2D {
    rad := degrees * deg_to_rad()
    cs := math.cos(rad)
    sn := math.sin(rad)
    << Matrix2D{a: cs, b: sn, c: 0.0 - sn, d: cs, tx: 0.0, ty: 0.0}
}

pub fn skew_matrix(skew_x_deg f64, skew_y_deg f64) Matrix2D {
    rx := skew_x_deg * deg_to_rad()
    ry := skew_y_deg * deg_to_rad()
    << Matrix2D{a: 1.0, b: math.tan(ry), c: math.tan(rx), d: 1.0, tx: 0.0, ty: 0.0}
}

pub fn (m &Matrix2D) multiply(other &Matrix2D) Matrix2D {
    << Matrix2D{
        a: m.a * other.a + m.c * other.b,
        b: m.b * other.a + m.d * other.b,
        c: m.a * other.c + m.c * other.d,
        d: m.b * other.c + m.d * other.d,
        tx: m.a * other.tx + m.c * other.ty + m.tx,
        ty: m.b * other.tx + m.d * other.ty + m.ty
    }
}

pub fn (m &Matrix2D) translate(tx f64, ty f64) Matrix2D {
    t := translation_matrix(tx, ty)
    << m.multiply(&t)
}

pub fn (m &Matrix2D) scale(sx f64, sy f64) Matrix2D {
    s := scaling_matrix(sx, sy)
    << m.multiply(&s)
}

pub fn (m &Matrix2D) rotate(degrees f64) Matrix2D {
    r := rotation_matrix(degrees)
    << m.multiply(&r)
}

pub fn (m &Matrix2D) determinant() f64 {
    << m.a * m.d - m.b * m.c
}

pub fn (m &Matrix2D) is_invertible() bool {
    det := m.determinant()
    << !math.is_nan(det) && !math.is_inf(det) && math.abs(det) > 0.000000001
}

pub fn (m &Matrix2D) inverse() Matrix2D {
    det := m.determinant()
    if math.is_nan(det) || math.is_inf(det) || math.abs(det) <= 0.000000001 {
        >> errors.new("draw: singular 2D matrix is not invertible")
    }
    inv := 1.0 / det
    na := m.d * inv
    nb := (0.0 - m.b) * inv
    nc := (0.0 - m.c) * inv
    nd := m.a * inv
    ntx := (m.c * m.ty - m.d * m.tx) * inv
    nty := (m.b * m.tx - m.a * m.ty) * inv
    << Matrix2D{a: na, b: nb, c: nc, d: nd, tx: ntx, ty: nty}
}

pub fn (m &Matrix2D) map_point(x f64, y f64) PathPoint {
    << PathPoint{
        x: m.a * x + m.c * y + m.tx,
        y: m.b * x + m.d * y + m.ty
    }
}

pub fn (m &Matrix2D) map_bounds(rect &ImageRect) ImageRect {
    p0 := m.map_point(rect.x, rect.y)
    p1 := m.map_point(rect.x + rect.width, rect.y)
    p2 := m.map_point(rect.x + rect.width, rect.y + rect.height)
    p3 := m.map_point(rect.x, rect.y + rect.height)
    min_x := math.min(math.min(p0.x, p1.x), math.min(p2.x, p3.x))
    min_y := math.min(math.min(p0.y, p1.y), math.min(p2.y, p3.y))
    max_x := math.max(math.max(p0.x, p1.x), math.max(p2.x, p3.x))
    max_y := math.max(math.max(p0.y, p1.y), math.max(p2.y, p3.y))
    << ImageRect{x: min_x, y: min_y, width: max_x - min_x, height: max_y - min_y}
}

pub fn (frame $&Frame) rotate_around(cx f64, cy f64, degrees f64) int {
    frame.translate(cx, cy) or >>
    frame.rotate(degrees) or >>
    frame.translate(0.0 - cx, 0.0 - cy) or >>
    << 0
}

pub fn (frame $&Frame) scale_around(cx f64, cy f64, sx f64, sy f64) int {
    frame.translate(cx, cy) or >>
    frame.scale(sx, sy) or >>
    frame.translate(0.0 - cx, 0.0 - cy) or >>
    << 0
}

pub fn (path &Path) clone() Path {
    $cap := path.buffer.len
    if cap < 20 { cap = 20 }
    $out := new_path(cap)
    raw := path.buffer.to_string()
    $off := 0
    while off < raw.len {
        verb := codec.read_word32(&raw, off)
        if verb == 1 {
            x := codec.read_float64(&raw, off + 4) or (err) { <- }
            y := codec.read_float64(&raw, off + 12) or (err) { <- }
            out.move_to(x, y) or (err) { <- }
            off = off + 20
        } else if verb == 2 {
            x := codec.read_float64(&raw, off + 4) or (err) { <- }
            y := codec.read_float64(&raw, off + 12) or (err) { <- }
            out.line_to(x, y) or (err) { <- }
            off = off + 20
        } else if verb == 3 {
            cx := codec.read_float64(&raw, off + 4) or (err) { <- }
            cy := codec.read_float64(&raw, off + 12) or (err) { <- }
            x := codec.read_float64(&raw, off + 20) or (err) { <- }
            y := codec.read_float64(&raw, off + 28) or (err) { <- }
            out.quad_to(cx, cy, x, y) or (err) { <- }
            off = off + 36
        } else if verb == 4 {
            c1x := codec.read_float64(&raw, off + 4) or (err) { <- }
            c1y := codec.read_float64(&raw, off + 12) or (err) { <- }
            c2x := codec.read_float64(&raw, off + 20) or (err) { <- }
            c2y := codec.read_float64(&raw, off + 28) or (err) { <- }
            x := codec.read_float64(&raw, off + 36) or (err) { <- }
            y := codec.read_float64(&raw, off + 44) or (err) { <- }
            out.cubic_to(c1x, c1y, c2x, c2y, x, y) or (err) { <- }
            off = off + 52
        } else if verb == 5 {
            out.close() or (err) { <- }
            off = off + 4
        } else {
            <-
        }
    }
    << out
}

pub fn (path $&Path) append_transformed(other &Path, m &Matrix2D) int {
    if other.failed { >> errors.new("draw: cannot append failed path") }
    raw := other.buffer.to_string()
    $off := 0
    while off < raw.len {
        verb := codec.read_word32(&raw, off)
        if verb == 1 {
            x := codec.read_float64(&raw, off + 4) or >>
            y := codec.read_float64(&raw, off + 12) or >>
            p := m.map_point(x, y)
            path.move_to(p.x, p.y) or >>
            off = off + 20
        } else if verb == 2 {
            x := codec.read_float64(&raw, off + 4) or >>
            y := codec.read_float64(&raw, off + 12) or >>
            p := m.map_point(x, y)
            path.line_to(p.x, p.y) or >>
            off = off + 20
        } else if verb == 3 {
            cx := codec.read_float64(&raw, off + 4) or >>
            cy := codec.read_float64(&raw, off + 12) or >>
            x := codec.read_float64(&raw, off + 20) or >>
            y := codec.read_float64(&raw, off + 28) or >>
            pc := m.map_point(cx, cy)
            p := m.map_point(x, y)
            path.quad_to(pc.x, pc.y, p.x, p.y) or >>
            off = off + 36
        } else if verb == 4 {
            c1x := codec.read_float64(&raw, off + 4) or >>
            c1y := codec.read_float64(&raw, off + 12) or >>
            c2x := codec.read_float64(&raw, off + 20) or >>
            c2y := codec.read_float64(&raw, off + 28) or >>
            x := codec.read_float64(&raw, off + 36) or >>
            y := codec.read_float64(&raw, off + 44) or >>
            p1 := m.map_point(c1x, c1y)
            p2 := m.map_point(c2x, c2y)
            p := m.map_point(x, y)
            path.cubic_to(p1.x, p1.y, p2.x, p2.y, p.x, p.y) or >>
            off = off + 52
        } else if verb == 5 {
            path.close() or >>
            off = off + 4
        } else {
            >> errors.new("draw: corrupted path verb")
        }
    }
    << 0
}

pub fn (path $&Path) append(other &Path) int {
    id := identity_matrix()
    << path.append_transformed(other, &id) or >>
}

pub fn (path $&Path) transform(m &Matrix2D) int {
    snapshot := path.clone()
    path.clear()
    << path.append_transformed(&snapshot, m) or >>
}

pub fn (path $&Path) translate(dx f64, dy f64) int {
    m := translation_matrix(dx, dy)
    << path.transform(&m) or >>
}

pub fn (path $&Path) scale(sx f64, sy f64) int {
    m := scaling_matrix(sx, sy)
    << path.transform(&m) or >>
}

pub fn (path $&Path) rotate(degrees f64) int {
    m := rotation_matrix(degrees)
    << path.transform(&m) or >>
}

pub fn (path $&Path) rotate_around(cx f64, cy f64, degrees f64) int {
    t1 := translation_matrix(cx, cy)
    r := t1.rotate(degrees)
    m := r.translate(0.0 - cx, 0.0 - cy)
    << path.transform(&m) or >>
}

pub fn (path &Path) bounds() ImageRect {
    if path.failed || path.count == 0 {
        << ImageRect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}
    }
    raw := path.buffer.to_string()
    $off := 0
    $first := true
    $min_x := 0.0
    $min_y := 0.0
    $max_x := 0.0
    $max_y := 0.0
    while off < raw.len {
        verb := codec.read_word32(&raw, off)
        $pairs := 0
        if verb == 1 || verb == 2 { pairs = 1 }
        else if verb == 3 { pairs = 2 }
        else if verb == 4 { pairs = 3 }
        else if verb == 5 { pairs = 0 }
        else { <- }
        for i in 0:pairs {
            px := codec.read_float64(&raw, off + 4 + i * 16) or (err) { <- }
            py := codec.read_float64(&raw, off + 12 + i * 16) or (err) { <- }
            if first {
                min_x = px
                min_y = py
                max_x = px
                max_y = py
                first = false
            } else {
                min_x = math.min(min_x, px)
                min_y = math.min(min_y, py)
                max_x = math.max(max_x, px)
                max_y = math.max(max_y, py)
            }
        }
        off = off + 4 + pairs * 16
    }
    << ImageRect{x: min_x, y: min_y, width: max_x - min_x, height: max_y - min_y}
}
