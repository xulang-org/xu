@ui/draw

#errors
#math
#ui/internal/codec

pub fn bezier_quad_point(x1 f64, y1 f64, cx f64, cy f64, x2 f64, y2 f64, t f64) PathPoint {
    u := clamp_unit(t)
    inv := 1.0 - u
    b0 := inv * inv
    b1 := 2.0 * inv * u
    b2 := u * u
    << PathPoint{
        x: b0 * x1 + b1 * cx + b2 * x2,
        y: b0 * y1 + b1 * cy + b2 * y2
    }
}

pub fn bezier_cubic_point(x1 f64, y1 f64, c1x f64, c1y f64, c2x f64, c2y f64, x2 f64, y2 f64, t f64) PathPoint {
    u := clamp_unit(t)
    inv := 1.0 - u
    b0 := inv * inv * inv
    b1 := 3.0 * inv * inv * u
    b2 := 3.0 * inv * u * u
    b3 := u * u * u
    << PathPoint{
        x: b0 * x1 + b1 * c1x + b2 * c2x + b3 * x2,
        y: b0 * y1 + b1 * c1y + b2 * c2y + b3 * y2
    }
}

pub fn bezier_cubic_tangent(x1 f64, y1 f64, c1x f64, c1y f64, c2x f64, c2y f64, x2 f64, y2 f64, t f64) PathPoint {
    u := clamp_unit(t)
    inv := 1.0 - u
    d0 := 3.0 * inv * inv
    d1 := 6.0 * inv * u
    d2 := 3.0 * u * u
    << PathPoint{
        x: d0 * (c1x - x1) + d1 * (c2x - c1x) + d2 * (x2 - c2x),
        y: d0 * (c1y - y1) + d1 * (c2y - c1y) + d2 * (y2 - c2y)
    }
}

pub fn point_in_rect(px f64, py f64, x f64, y f64, width f64, height f64) bool {
    << width > 0.0 && height > 0.0 && px >= x && px <= x + width && py >= y && py <= y + height
}

pub fn point_in_circle(px f64, py f64, cx f64, cy f64, radius f64) bool {
    if radius <= 0.0 { << false }
    dx := px - cx
    dy := py - cy
    << dx * dx + dy * dy <= radius * radius
}

pub fn point_in_ellipse(px f64, py f64, cx f64, cy f64, rx f64, ry f64) bool {
    if rx <= 0.0 || ry <= 0.0 { << false }
    nx := (px - cx) / rx
    ny := (py - cy) / ry
    << nx * nx + ny * ny <= 1.0
}

pub fn point_in_round_rect(px f64, py f64, x f64, y f64, width f64, height f64, radius f64) bool {
    if !point_in_rect(px, py, x, y, width, height) { << false }
    r := clamp_corner_radius(radius, math.min(width, height) * 0.5)
    if r <= 0.0 { << true }
    if px < x + r && py < y + r { << point_in_circle(px, py, x + r, y + r, r) }
    if px > x + width - r && py < y + r { << point_in_circle(px, py, x + width - r, y + r, r) }
    if px > x + width - r && py > y + height - r { << point_in_circle(px, py, x + width - r, y + height - r, r) }
    if px < x + r && py > y + height - r { << point_in_circle(px, py, x + r, y + height - r, r) }
    << true
}

pub fn point_in_round_rect_corners(px f64, py f64, x f64, y f64, width f64, height f64, tl f64, tr f64, br f64, bl f64) bool {
    if !point_in_rect(px, py, x, y, width, height) { << false }
    radii := css_corner_radii(width, height, tl, tr, br, bl)
    rtl := radii[0]
    rtr := radii[1]
    rbr := radii[2]
    rbl := radii[3]
    if rtl <= 0.0 && rtr <= 0.0 && rbr <= 0.0 && rbl <= 0.0 { << true }
    if rtl > 0.0 && px < x + rtl && py < y + rtl { << point_in_circle(px, py, x + rtl, y + rtl, rtl) }
    if rtr > 0.0 && px > x + width - rtr && py < y + rtr { << point_in_circle(px, py, x + width - rtr, y + rtr, rtr) }
    if rbr > 0.0 && px > x + width - rbr && py > y + height - rbr { << point_in_circle(px, py, x + width - rbr, y + height - rbr, rbr) }
    if rbl > 0.0 && px < x + rbl && py > y + height - rbl { << point_in_circle(px, py, x + rbl, y + height - rbl, rbl) }
    << true
}

pub fn point_in_triangle(px f64, py f64, x1 f64, y1 f64, x2 f64, y2 f64, x3 f64, y3 f64) bool {
    area2 := (x2 - x1) * (y3 - y1) - (x3 - x1) * (y2 - y1)
    if math.abs(area2) <= 0.000000000001 { << false }
    d1 := (px - x2) * (y1 - y2) - (x1 - x2) * (py - y2)
    d2 := (px - x3) * (y2 - y3) - (x2 - x3) * (py - y3)
    d3 := (px - x1) * (y3 - y1) - (x3 - x1) * (py - y1)
    has_neg := (d1 < 0.0) || (d2 < 0.0) || (d3 < 0.0)
    has_pos := (d1 > 0.0) || (d2 > 0.0) || (d3 > 0.0)
    << !(has_neg && has_pos)
}

pub fn point_in_polygon(px f64, py f64, points &[]PathPoint) bool {
    n := points.len
    if n < 3 { << false }
    $inside := false
    $j := n - 1
    for i in 0:n {
        xi := points[i].x
        yi := points[i].y
        xj := points[j].x
        yj := points[j].y
        dy := yj - yi
        if ((yi > py) != (yj > py)) && math.abs(dy) > 0.000000001 {
            x_intersect := (xj - xi) * (py - yi) / dy + xi
            if px < x_intersect { inside = !inside }
        }
        j = i
    }
    << inside
}

fn normalize_deg_positive(deg f64) f64 {
    $a := math.mod(deg, 360.0)
    if a < 0.0 { a = a + 360.0 }
    << a
}

pub fn point_in_sector(px f64, py f64, cx f64, cy f64, inner_radius f64, outer_radius f64, start_deg f64, sweep_deg f64) bool {
    if outer_radius <= 0.0 || outer_radius <= inner_radius || math.abs(sweep_deg) <= 0.000001 { << false }
    dx := px - cx
    dy := py - cy
    dist := math.hypot(dx, dy)
    $r_in := inner_radius
    if r_in < 0.0 { r_in = 0.0 }
    if dist < r_in || dist > outer_radius { << false }
    if math.abs(sweep_deg) >= 359.999 { << true }
    angle := normalize_deg_positive(math.atan2(dy, dx) * 180.0 / math.pi())
    if sweep_deg > 0.0 {
        start := normalize_deg_positive(start_deg)
        delta := normalize_deg_positive(angle - start)
        << delta <= sweep_deg
    }
    start := normalize_deg_positive(start_deg + sweep_deg)
    delta := normalize_deg_positive(angle - start)
    << delta <= math.abs(sweep_deg)
}

pub fn distance_to_segment(px f64, py f64, x1 f64, y1 f64, x2 f64, y2 f64) f64 {
    dx := x2 - x1
    dy := y2 - y1
    len_sq := dx * dx + dy * dy
    if len_sq <= 0.000000000001 {
        << math.hypot(px - x1, py - y1)
    }
    $t := ((px - x1) * dx + (py - y1) * dy) / len_sq
    if t < 0.0 { t = 0.0 }
    if t > 1.0 { t = 1.0 }
    proj_x := x1 + t * dx
    proj_y := y1 + t * dy
    << math.hypot(px - proj_x, py - proj_y)
}

pub fn point_near_segment(px f64, py f64, x1 f64, y1 f64, x2 f64, y2 f64, tolerance f64) bool {
    << tolerance >= 0.0 && distance_to_segment(px, py, x1, y1, x2, y2) <= tolerance
}

pub fn point_near_polyline(px f64, py f64, points &[]PathPoint, tolerance f64) bool {
    if points.len < 2 || tolerance < 0.0 { << false }
    for i in 0:(points.len - 1) {
        if distance_to_segment(px, py, points[i].x, points[i].y, points[i + 1].x, points[i + 1].y) <= tolerance {
            << true
        }
    }
    << false
}

fn point_in_subpaths_evenodd(px f64, py f64, subpaths &[][]PathPoint) bool {
    $inside := false
    for s in 0:subpaths.len {
        pts := &subpaths[s]
        n := pts.len
        if n < 3 { -> }
        $j := n - 1
        for i in 0:n {
            xi := pts[i].x
            yi := pts[i].y
            xj := pts[j].x
            yj := pts[j].y
            dy := yj - yi
            if ((yi > py) != (yj > py)) && math.abs(dy) > 0.000000001 {
                x_intersect := (xj - xi) * (py - yi) / dy + xi
                if px < x_intersect { inside = !inside }
            }
            j = i
        }
    }
    << inside
}

fn is_left(x0 f64, y0 f64, x1 f64, y1 f64, px f64, py f64) f64 {
    << (x1 - x0) * (py - y0) - (px - x0) * (y1 - y0)
}

fn point_in_subpaths_nonzero(px f64, py f64, subpaths &[][]PathPoint) bool {
    $winding := 0
    for s in 0:subpaths.len {
        pts := &subpaths[s]
        n := pts.len
        if n < 3 { -> }
        for i in 0:n {
            $next := i + 1
            if next == n { next = 0 }
            yi := pts[i].y
            yn := pts[next].y
            if yi <= py {
                if yn > py && is_left(pts[i].x, yi, pts[next].x, yn, px, py) > 0.0 {
                    winding = winding + 1
                }
            } else {
                if yn <= py && is_left(pts[i].x, yi, pts[next].x, yn, px, py) < 0.0 {
                    winding = winding - 1
                }
            }
        }
    }
    << winding != 0
}

fn copy_path_points(pts &[]PathPoint) []PathPoint {
    $out := []PathPoint{}
    for i in 0:pts.len { out.push(PathPoint{x: pts[i].x, y: pts[i].y}) }
    << out
}

// Flattens a Path into separate subpaths (one slice per move_to figure).
pub fn (path &Path) flatten_subpaths(tolerance f64) [][]PathPoint {
    $subpaths := [][]PathPoint{}
    if path.failed || path.count == 0 { << subpaths }
    $tol := tolerance
    if math.is_nan(tol) || tol <= 0.005 { tol = 0.5 }
    step_denom := math.max(0.05, tol * 4.0)
    raw := path.buffer.to_string()
    $off := 0
    $cur_x := 0.0
    $cur_y := 0.0
    $start_x := 0.0
    $start_y := 0.0
    $current := []PathPoint{}
    while off < raw.len {
        verb := codec.read_word32(&raw, off)
        if verb == 1 {
            if current.len > 0 { subpaths.push(copy_path_points(&current)) }
            current = []PathPoint{}
            x := codec.read_float64(&raw, off + 4) >>> (err) { <- }
            y := codec.read_float64(&raw, off + 12) >>> (err) { <- }
            current.push(PathPoint{x: x, y: y})
            cur_x = x
            cur_y = y
            start_x = x
            start_y = y
            off = off + 20
        } else if verb == 2 {
            x := codec.read_float64(&raw, off + 4) >>> (err) { <- }
            y := codec.read_float64(&raw, off + 12) >>> (err) { <- }
            current.push(PathPoint{x: x, y: y})
            cur_x = x
            cur_y = y
            off = off + 20
        } else if verb == 3 {
            cx := codec.read_float64(&raw, off + 4) >>> (err) { <- }
            cy := codec.read_float64(&raw, off + 12) >>> (err) { <- }
            x := codec.read_float64(&raw, off + 20) >>> (err) { <- }
            y := codec.read_float64(&raw, off + 28) >>> (err) { <- }
            chord := math.hypot(cx - cur_x, cy - cur_y) + math.hypot(x - cx, y - cy)
            $steps := int(math.ceil(chord / step_denom))
            if steps < 2 { steps = 2 }
            if steps > 128 { steps = 128 }
            for s in 1:(steps + 1) {
                pt := bezier_quad_point(cur_x, cur_y, cx, cy, x, y, f64(s) / f64(steps))
                current.push(pt)
            }
            cur_x = x
            cur_y = y
            off = off + 36
        } else if verb == 4 {
            c1x := codec.read_float64(&raw, off + 4) >>> (err) { <- }
            c1y := codec.read_float64(&raw, off + 12) >>> (err) { <- }
            c2x := codec.read_float64(&raw, off + 20) >>> (err) { <- }
            c2y := codec.read_float64(&raw, off + 28) >>> (err) { <- }
            x := codec.read_float64(&raw, off + 36) >>> (err) { <- }
            y := codec.read_float64(&raw, off + 44) >>> (err) { <- }
            chord := math.hypot(c1x - cur_x, c1y - cur_y) + math.hypot(c2x - c1x, c2y - c1y) + math.hypot(x - c2x, y - c2y)
            $steps := int(math.ceil(chord / step_denom))
            if steps < 4 { steps = 4 }
            if steps > 128 { steps = 128 }
            for s in 1:(steps + 1) {
                pt := bezier_cubic_point(cur_x, cur_y, c1x, c1y, c2x, c2y, x, y, f64(s) / f64(steps))
                current.push(pt)
            }
            cur_x = x
            cur_y = y
            off = off + 52
        } else if verb == 5 {
            if math.hypot(cur_x - start_x, cur_y - start_y) > 0.000000001 {
                current.push(PathPoint{x: start_x, y: start_y})
            }
            cur_x = start_x
            cur_y = start_y
            off = off + 4
        } else {
            <-
        }
    }
    if current.len > 0 { subpaths.push(copy_path_points(&current)) }
    << subpaths
}

// Flattens a Path into a polyline of anchor points by adaptive subdivision of curves.
pub fn (path &Path) flatten(tolerance f64) []PathPoint {
    $out := []PathPoint{}
    subs := path.flatten_subpaths(tolerance)
    for s in 0:subs.len {
        for pt in subs[s] { out.push(pt) }
    }
    << out
}

pub fn (path &Path) contains_with_rule(px f64, py f64, rule int) bool {
    subs := path.flatten_subpaths(0.5)
    if rule == FILL_NONZERO { << point_in_subpaths_nonzero(px, py, &subs) }
    << point_in_subpaths_evenodd(px, py, &subs)
}

pub fn (path &Path) contains(px f64, py f64) bool {
    << path.contains_with_rule(px, py, FILL_EVENODD)
}

pub fn (path &Path) hit_stroke(px f64, py f64, tolerance f64) bool {
    if tolerance < 0.0 { << false }
    subs := path.flatten_subpaths(0.5)
    for s in 0:subs.len {
        sub := &subs[s]
        if sub.len == 1 {
            if math.hypot(px - sub[0].x, py - sub[0].y) <= tolerance { << true }
        } else if point_near_polyline(px, py, sub, tolerance) {
            << true
        }
    }
    << false
}
