@ui/draw

#errors
#strconv
#strings
#ui/internal/codec

// Immutable vector fragment. Captures current resource versions and compiles
// native paths once. Copies share one handle. Dispose explicitly; queued frames
// retain it. Draw under the caller's CTM/clip with isolated default pen state.
// Background-clearing commands cannot be captured: use an explicit rectangle.
pub struct DisplayList {
    id int
    canvas_id int
    generation int
}

pub fn (frame $&Frame) freeze() DisplayList {
    frame.seal() or >>
    token := read_file(":xu:/__display_list_id") or >>
    if token.len != 20 { >> errors.new("draw: DisplayList host is unavailable") }
    id := strconv.atoi(&token) or >>
    if id <= 0 { >> errors.new("draw: DisplayList capacity is exhausted") }
    $header := strings.new_byte_builder(16)
    header.write_str("XDL1")
    image_word($&header,1,4)
    image_word($&header,id,8)
    data := header.to_string() + frame.buffer.to_string()
    accepted := write_file(":xu:/__display_list_upload",data) or (err) {
        abandon_display_list(id)
        >> errors.new("draw: DisplayList transport failed")
    }
    if accepted != data.len {
        abandon_display_list(id)
        >> errors.new("draw: DisplayList rejected (background command, invalid resources, nesting/work/memory limit or closed canvas)")
    }
    info := read_file(":xu:/__display_list_info/" + str(id)) or (err) {
        discard_display_list(id,frame.canvas_id,frame.generation)
        >> errors.new("draw: DisplayList metadata unavailable")
    }
    if info.len != 8 || codec.read_word32(&info,4) == 0 {
        discard_display_list(id,frame.canvas_id,frame.generation)
        >> errors.new("draw: DisplayList canvas closed during capture")
    }
    << DisplayList{id: id,canvas_id: frame.canvas_id,generation: codec.read_word32(&info,0)}
}

pub fn (list $&DisplayList) dispose() int {
    if list.id == 0 { << 0 }
    wire := str(list.id)+"\t"+str(list.canvas_id)+"\t"+str(list.generation)
    accepted := write_file(":xu:/__display_list_dispose",wire) or >>
    if accepted != wire.len { >> errors.new("draw: DisplayList is no longer live") }
    list.id = 0
    << 0
}

pub fn (frame $&Frame) display_list(list &DisplayList) int {
    if list.id <= 0 || list.canvas_id != frame.canvas_id ||
       (list.generation > 0 && frame.generation > 0 && list.generation != frame.generation) {
        << frame.fail("draw: DisplayList belongs to another or closed canvas") or >>
    }
    frame.record(25,8) or >>
    frame.word64(list.id)
    << 0
}

pub fn (list &DisplayList) snapshot(width f64,height f64,scale f64) Surface {
    context := Context{canvas_id: list.canvas_id,generation: list.generation}
    $frame := context.new_frame(64)
    frame.begin() or >>
    frame.display_list(list) or >>
    << frame.snapshot(width,height,scale) or >>
}

fn abandon_display_list(id int) {
    write_file(":xu:/__display_list_abandon",str(id)) or (err) { << }
}
fn discard_display_list(id int,canvas int,generation int) {
    write_file(":xu:/__display_list_dispose",str(id)+"\t"+str(canvas)+"\t"+str(generation)) or (err) { << }
}
