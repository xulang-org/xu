@ui/draw

#errors
#strings

pub const blend_source_over = 0
pub const blend_copy = 1
pub const blend_destination_in = 2
pub const blend_destination_out = 3
pub const blend_multiply = 4
pub const blend_screen = 5
pub const blend_add = 6
pub const blend_xor = 7

// Same logical bounds and backing resolution are required. This Surface is the
// backdrop, source is the foreground. Produces an immutable cache; original
// pixels are unchanged. The caller explicitly owns/disposes the returned handle.
pub fn (backdrop &Surface) composite(source &Surface, mode int, opacity f64) Surface {
    if backdrop.image.id <= 0 || source.image.id <= 0 || backdrop.image.canvas_id != source.image.canvas_id ||
       (backdrop.image.generation > 0 && source.image.generation > 0 && backdrop.image.generation != source.image.generation) || backdrop.width != source.width || backdrop.height != source.height ||
       backdrop.pixel_width != source.pixel_width || backdrop.pixel_height != source.pixel_height ||
       mode < blend_source_over || mode > blend_xor || !gradient_coordinate(opacity) || opacity < 0.0 || opacity > 1.0 {
        >> errors.new("draw: incompatible Surface inputs, blend mode or opacity")
    }
    id := reserve_image() or >>
    mut wire := strings.new_byte_builder(48)
    wire.write_str("XUC1")
    image_word(mut &wire,1,4)
    image_word(mut &wire,id,8)
    image_word(mut &wire,backdrop.image.canvas_id,4)
    image_word(mut &wire,backdrop.image.generation,4)
    image_word(mut &wire,backdrop.image.id,8)
    image_word(mut &wire,source.image.id,8)
    image_word(mut &wire,mode,4)
    image_word(mut &wire,int(opacity*65535.0+0.5),4)
    data := wire.to_string()
    accepted := write_file(":xu:/__surface_composite",data) or (err) {
        abandon_image(id)
        >> errors.new("draw: Surface composition transport failed")
    }
    if accepted != data.len {
        abandon_image(id)
        >> errors.new("draw: Surface composition rejected (closed canvas, incompatible inputs or pixel budget)")
    }
    context := Context{canvas_id: backdrop.image.canvas_id,generation: backdrop.image.generation}
    resource := image_metadata(&context,id) or (err) {
        discard_image(id,context.canvas_id,context.generation)
        >> errors.new("draw: Surface canvas closed during composition")
    }
    << Surface{width: backdrop.width,height: backdrop.height,pixel_width: backdrop.pixel_width,
        pixel_height: backdrop.pixel_height,image: resource}
}

// Gradient coordinates are local to bounds. Path coordinates remain in the
// caller's current logical space. Explicit density controls raster quality;
// parent CTM/clip apply when the generated painted Path is composited.
pub fn (frame &mut Frame) fill_path_gradient(path &Path,paint &Gradient,bounds &ImageRect,scale f64,rule int) int {
    frame.writable() or >>
    if path.failed || (rule != fill_evenodd && rule != fill_nonzero) || !gradient_coordinate(bounds.x) ||
       !gradient_coordinate(bounds.y) || frame.temporary_images.len >= 256 {
        << frame.fail("draw: invalid gradient Path, bounds or transient resource capacity") or >>
    }
    context := Context{canvas_id: frame.canvas_id,generation: frame.generation}
    mut gradient := context.gradient(bounds.width,bounds.height,scale,paint) or >>
    mut mask_frame := context.new_frame(path.byte_len()+128)
    mask_frame.begin() or >>
    mask_frame.translate(0.0-bounds.x,0.0-bounds.y) or (err) {
        discard_image(gradient.image.id,context.canvas_id,context.generation)
        >> errors.new("draw: gradient mask transform rejected")
    }
    mask_frame.fill_path(path,rgb(255,255,255),rule) or (err) {
        discard_image(gradient.image.id,context.canvas_id,context.generation)
        >> errors.new("draw: gradient mask Path rejected")
    }
    mut mask := mask_frame.snapshot(bounds.width,bounds.height,scale) or (err) {
        discard_image(gradient.image.id,context.canvas_id,context.generation)
        >> errors.new("draw: gradient mask snapshot rejected")
    }
    result := gradient.composite(&mask,blend_destination_in,1.0) or (err) {
        discard_image(gradient.image.id,context.canvas_id,context.generation)
        discard_image(mask.image.id,context.canvas_id,context.generation)
        >> errors.new("draw: gradient mask composition rejected")
    }
    discard_image(gradient.image.id,context.canvas_id,context.generation)
    discard_image(mask.image.id,context.canvas_id,context.generation)
    frame.temporary_images.push(result.image.id)
    << frame.surface(&result,bounds.x,bounds.y,bounds.width,bounds.height,1.0,sampler_linear) or >>
}
