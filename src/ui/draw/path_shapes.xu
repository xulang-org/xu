@ui/draw

#errors
#math

pub fn bezier_kappa() f64 { << 0.5522847498307936 }
pub fn deg_to_rad() f64 { << 0.017453292519943295 }

pub struct PathPoint {
    pub x f64
    pub y f64
}

pub fn path_point(x f64, y f64) PathPoint {
    << PathPoint{x: x, y: y}
}

fn valid_extent(v f64) bool {
    << !math.is_nan(v) && !math.is_inf(v) && v > 0.0 && v <= 1000000000.0
}

fn valid_scalar(v f64) bool {
    << !math.is_nan(v) && !math.is_inf(v) && v >= -1000000000.0 && v <= 1000000000.0
}

fn clamp_corner_radius(r f64, limit f64) f64 {
    if math.is_nan(r) || r <= 0.0 { << 0.0 }
    if r >= limit { << limit }
    << r
}

pub fn (path $&Path) rect(x f64, y f64, width f64, height f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) {
        >> errors.new("draw: invalid path rect geometry")
    }
    path.move_to(x, y) or >>
    path.line_to(x + width, y) or >>
    path.line_to(x + width, y + height) or >>
    path.line_to(x, y + height) or >>
    path.close() or >>
    << 0
}

pub fn (path $&Path) round_rect_corners(x f64, y f64, width f64, height f64, tl f64, tr f64, br f64, bl f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       !valid_scalar(tl) || !valid_scalar(tr) || !valid_scalar(br) || !valid_scalar(bl) {
        >> errors.new("draw: invalid path rounded rect geometry")
    }
    limit := math.min(width, height) * 0.5
    rtl := clamp_corner_radius(tl, limit)
    rtr := clamp_corner_radius(tr, limit)
    rbr := clamp_corner_radius(br, limit)
    rbl := clamp_corner_radius(bl, limit)
    if rtl <= 0.0 && rtr <= 0.0 && rbr <= 0.0 && rbl <= 0.0 {
        << path.rect(x, y, width, height) or >>
    }
    ktl := rtl * bezier_kappa()
    ktr := rtr * bezier_kappa()
    kbr := rbr * bezier_kappa()
    kbl := rbl * bezier_kappa()
    path.move_to(x + rtl, y) or >>
    path.line_to(x + width - rtr, y) or >>
    if rtr > 0.0 {
        path.cubic_to(x + width - rtr + ktr, y, x + width, y + rtr - ktr, x + width, y + rtr) or >>
    }
    path.line_to(x + width, y + height - rbr) or >>
    if rbr > 0.0 {
        path.cubic_to(x + width, y + height - rbr + kbr, x + width - rbr + kbr, y + height, x + width - rbr, y + height) or >>
    }
    path.line_to(x + rbl, y + height) or >>
    if rbl > 0.0 {
        path.cubic_to(x + rbl - kbl, y + height, x, y + height - rbl + kbl, x, y + height - rbl) or >>
    }
    path.line_to(x, y + rtl) or >>
    if rtl > 0.0 {
        path.cubic_to(x, y + rtl - ktl, x + rtl - ktl, y, x + rtl, y) or >>
    }
    path.close() or >>
    << 0
}

pub fn (path $&Path) round_rect(x f64, y f64, width f64, height f64, radius f64) int {
    << path.round_rect_corners(x, y, width, height, radius, radius, radius, radius) or >>
}

pub fn (path $&Path) capsule(x f64, y f64, width f64, height f64) int {
    radius := math.min(width, height) * 0.5
    << path.round_rect(x, y, width, height, radius) or >>
}

pub fn (path $&Path) ellipse(cx f64, cy f64, rx f64, ry f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(rx) || !valid_extent(ry) {
        >> errors.new("draw: invalid path ellipse geometry")
    }
    kx := rx * bezier_kappa()
    ky := ry * bezier_kappa()
    path.move_to(cx + rx, cy) or >>
    path.cubic_to(cx + rx, cy + ky, cx + kx, cy + ry, cx, cy + ry) or >>
    path.cubic_to(cx - kx, cy + ry, cx - rx, cy + ky, cx - rx, cy) or >>
    path.cubic_to(cx - rx, cy - ky, cx - kx, cy - ry, cx, cy - ry) or >>
    path.cubic_to(cx + kx, cy - ry, cx + rx, cy - ky, cx + rx, cy) or >>
    path.close() or >>
    << 0
}

pub fn (path $&Path) circle(cx f64, cy f64, radius f64) int {
    << path.ellipse(cx, cy, radius, radius) or >>
}

pub fn (path $&Path) diamond(cx f64, cy f64, rx f64, ry f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(rx) || !valid_extent(ry) {
        >> errors.new("draw: invalid path diamond geometry")
    }
    path.move_to(cx, cy - ry) or >>
    path.line_to(cx + rx, cy) or >>
    path.line_to(cx, cy + ry) or >>
    path.line_to(cx - rx, cy) or >>
    path.close() or >>
    << 0
}

fn append_arc_beziers(path $&Path, cx f64, cy f64, rx f64, ry f64, start_deg f64, sweep_deg f64, move_first bool) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(rx) || !valid_extent(ry) ||
       !valid_scalar(start_deg) || !valid_scalar(sweep_deg) {
        >> errors.new("draw: invalid path arc geometry")
    }
    $sweep := sweep_deg
    if sweep > 360.0 { sweep = 360.0 }
    if sweep < -360.0 { sweep = -360.0 }
    a0 := start_deg * deg_to_rad()
    sx := cx + rx * math.cos(a0)
    sy := cy + ry * math.sin(a0)
    if move_first { path.move_to(sx, sy) or >> }
    else { path.line_to(sx, sy) or >> }
    if math.abs(sweep) <= 0.000001 { << 0 }
    $segments := int(math.ceil(math.abs(sweep) / 90.0))
    if segments < 1 { segments = 1 }
    step_rad := (sweep / f64(segments)) * deg_to_rad()
    alpha := (4.0 / 3.0) * math.tan(step_rad * 0.25)
    for i in 0:segments {
        t0 := a0 + f64(i) * step_rad
        t1 := t0 + step_rad
        c0 := math.cos(t0)
        s0 := math.sin(t0)
        c1 := math.cos(t1)
        s1 := math.sin(t1)
        p0x := cx + rx * c0
        p0y := cy + ry * s0
        p3x := cx + rx * c1
        p3y := cy + ry * s1
        p1x := p0x - alpha * rx * s0
        p1y := p0y + alpha * ry * c0
        p2x := p3x + alpha * rx * s1
        p2y := p3y - alpha * ry * c1
        path.cubic_to(p1x, p1y, p2x, p2y, p3x, p3y) or >>
    }
    << 0
}

pub fn (path $&Path) ellipse_arc(cx f64, cy f64, rx f64, ry f64, start_deg f64, sweep_deg f64) int {
    << append_arc_beziers(path, cx, cy, rx, ry, start_deg, sweep_deg, true) or >>
}

pub fn (path $&Path) arc(cx f64, cy f64, radius f64, start_deg f64, sweep_deg f64) int {
    << append_arc_beziers(path, cx, cy, radius, radius, start_deg, sweep_deg, true) or >>
}

pub fn (path $&Path) sector(cx f64, cy f64, radius f64, start_deg f64, sweep_deg f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(radius) ||
       !valid_scalar(start_deg) || !valid_scalar(sweep_deg) {
        >> errors.new("draw: invalid path sector geometry")
    }
    if math.abs(sweep_deg) >= 359.999 {
        << path.circle(cx, cy, radius) or >>
    }
    path.move_to(cx, cy) or >>
    append_arc_beziers(path, cx, cy, radius, radius, start_deg, sweep_deg, false) or >>
    path.close() or >>
    << 0
}

pub fn (path $&Path) ring_sector(cx f64, cy f64, inner_radius f64, outer_radius f64, start_deg f64, sweep_deg f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_scalar(inner_radius) ||
       inner_radius < 0.0 || !valid_extent(outer_radius) || outer_radius <= inner_radius ||
       !valid_scalar(start_deg) || !valid_scalar(sweep_deg) {
        >> errors.new("draw: invalid path ring sector geometry")
    }
    if inner_radius <= 0.000001 {
        << path.sector(cx, cy, outer_radius, start_deg, sweep_deg) or >>
    }
    $sweep := sweep_deg
    if sweep > 359.999 { sweep = 359.999 }
    if sweep < -359.999 { sweep = -359.999 }
    append_arc_beziers(path, cx, cy, outer_radius, outer_radius, start_deg, sweep, true) or >>
    append_arc_beziers(path, cx, cy, inner_radius, inner_radius, start_deg + sweep, -sweep, false) or >>
    path.close() or >>
    << 0
}

pub fn (path $&Path) polyline(points &[]PathPoint) int {
    if points.len < 2 { >> errors.new("draw: polyline requires at least 2 points") }
    path.move_to(points[0].x, points[0].y) or >>
    for i in 1:points.len {
        path.line_to(points[i].x, points[i].y) or >>
    }
    << 0
}

pub fn (path $&Path) polygon(points &[]PathPoint) int {
    if points.len < 3 { >> errors.new("draw: polygon requires at least 3 points") }
    path.polyline(points) or >>
    path.close() or >>
    << 0
}

pub fn (path $&Path) regular_polygon(cx f64, cy f64, radius f64, sides int, rotation_deg f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(radius) ||
       sides < 3 || sides > 1024 || !valid_scalar(rotation_deg) {
        >> errors.new("draw: invalid regular polygon geometry")
    }
    base := rotation_deg * deg_to_rad()
    step := (2.0 * math.pi()) / f64(sides)
    for i in 0:sides {
        angle := base + f64(i) * step
        px := cx + radius * math.cos(angle)
        py := cy + radius * math.sin(angle)
        if i == 0 { path.move_to(px, py) or >> }
        else { path.line_to(px, py) or >> }
    }
    path.close() or >>
    << 0
}

pub fn (path $&Path) star(cx f64, cy f64, outer_radius f64, inner_radius f64, points int, rotation_deg f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(outer_radius) ||
       !valid_extent(inner_radius) || points < 3 || points > 512 || !valid_scalar(rotation_deg) {
        >> errors.new("draw: invalid star geometry")
    }
    base := rotation_deg * deg_to_rad()
    total := points * 2
    step := math.pi() / f64(points)
    for i in 0:total {
        angle := base + f64(i) * step
        $r := outer_radius
        if (i % 2) == 1 { r = inner_radius }
        px := cx + r * math.cos(angle)
        py := cy + r * math.sin(angle)
        if i == 0 { path.move_to(px, py) or >> }
        else { path.line_to(px, py) or >> }
    }
    path.close() or >>
    << 0
}
