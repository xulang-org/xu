@ui/draw

#errors

// Owns keyed immutable vector records in one canvas domain. Replacements are
// captured before retiring the old handle; queued/captured scenes retain their
// resource versions. The native process-wide list/memory limits still apply.
pub struct DisplayListPool {
    canvas_id int
    generation int
    keys []int
    ids []int
    revisions []int
}
pub fn (context &Context) display_list_pool() DisplayListPool {
    << DisplayListPool{canvas_id: context.canvas_id,generation: context.generation,keys: []int{},ids: []int{},revisions: []int{}}
}
fn (pool &DisplayListPool) find(key int) int {
    for i in 0:pool.keys.len { if pool.keys[i] == key { << i } }
    << -1
}
pub fn (pool &DisplayListPool) is_current(key int,revision int) bool {
    index := pool.find(key)
    << key > 0 && revision > 0 && index >= 0 && pool.ids[index] > 0 && pool.revisions[index] == revision
}
pub fn (pool $&DisplayListPool) capture(key int,revision int,frame $&Frame) int {
    if key <= 0 || revision <= 0 || frame.canvas_id != pool.canvas_id ||
       (pool.generation != 0 && frame.generation != 0 && frame.generation != pool.generation) {
        >> errors.new("draw: invalid DisplayList pool key, revision or canvas")
    }
    replacement := frame.freeze() or >>
    if pool.generation > 0 && replacement.generation != pool.generation {
        discard_display_list(replacement.id,replacement.canvas_id,replacement.generation)
        >> errors.new("draw: DisplayList pool canvas generation was revoked")
    }
    pool.generation = replacement.generation
    $index := pool.find(key)
    if index < 0 {
        for i in 0:pool.keys.len { if pool.keys[i] == 0 { index = i
            <- } }
        if index < 0 {
            index = pool.keys.len
            pool.keys.push(0)
            pool.ids.push(0)
            pool.revisions.push(0)
        }
    }
    if pool.ids[index] > 0 { discard_display_list(pool.ids[index],pool.canvas_id,pool.generation) }
    pool.keys[index] = key
    pool.ids[index] = replacement.id
    pool.revisions[index] = revision
    << 0
}
pub fn (pool $&DisplayListPool) remove(key int) {
    index := pool.find(key)
    if index < 0 { << }
    if pool.ids[index] > 0 { discard_display_list(pool.ids[index],pool.canvas_id,pool.generation) }
    pool.keys[index] = 0
    pool.ids[index] = 0
    pool.revisions[index] = 0
}
pub fn (pool $&DisplayListPool) dispose() {
    for i in 0:pool.keys.len {
        if pool.ids[i] > 0 { discard_display_list(pool.ids[i],pool.canvas_id,pool.generation) }
        pool.keys[i] = 0
        pool.ids[i] = 0
        pool.revisions[i] = 0
    }
}
pub fn (frame $&Frame) pooled_display_list(pool &DisplayListPool,key int) int {
    index := pool.find(key)
    if key <= 0 || index < 0 || pool.ids[index] <= 0 { >> errors.new("draw: missing retained DisplayList") }
    list := DisplayList{id: pool.ids[index],canvas_id: pool.canvas_id,generation: pool.generation}
    << frame.display_list(&list) or >>
}
