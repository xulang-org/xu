@ui/draw

#errors
#math

pub const DIR_UP = 0
pub const DIR_RIGHT = 1
pub const DIR_DOWN = 2
pub const DIR_LEFT = 3

// C1-continuous Cardinal / Catmull-Rom spline converted to cubic Beziers.
// tension=0 produces a standard Catmull-Rom spline; tension=1 produces lines.
pub fn (path $&Path) smooth_spline(points &[]PathPoint, tension f64, closed bool) int {
    n := points.len
    if (closed && n < 3) || (!closed && n < 2) {
        >> errors.new("draw: smooth_spline requires at least 2 points (3 when closed)")
    }
    if !valid_scalar(tension) { >> errors.new("draw: invalid spline tension") }
    if n == 2 && !closed {
        path.move_to(points[0].x, points[0].y) or >>
        path.line_to(points[1].x, points[1].y) or >>
        << 0
    }
    s := (1.0 - clamp_unit(tension)) / 6.0
    path.move_to(points[0].x, points[0].y) or >>
    $seg_count := n - 1
    if closed { seg_count = n }
    for i in 0:seg_count {
        $i0 := i - 1
        if closed {
            if i0 < 0 { i0 = n - 1 }
        } else {
            if i0 < 0 { i0 = 0 }
        }
        i1 := i
        $i2 := i + 1
        if i2 >= n { i2 = i2 - n }
        $i3 := i + 2
        if closed {
            if i3 >= n { i3 = i3 - n }
        } else {
            if i3 >= n { i3 = n - 1 }
        }
        p0 := &points[i0]
        p1 := &points[i1]
        p2 := &points[i2]
        p3 := &points[i3]
        c1x := p1.x + (p2.x - p0.x) * s
        c1y := p1.y + (p2.y - p0.y) * s
        c2x := p2.x - (p3.x - p1.x) * s
        c2y := p2.y - (p3.y - p1.y) * s
        path.cubic_to(c1x, c1y, c2x, c2y, p2.x, p2.y) or >>
    }
    if closed { path.close() or >> }
    << 0
}

pub fn (frame $&Frame) smooth_curve(points &[]PathPoint, tension f64, color Color, width f64) int {
    $path := new_path(points.len * 56 + 32)
    path.smooth_spline(points, tension, false) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) fill_smooth_closed(points &[]PathPoint, tension f64, color Color) int {
    $path := new_path(points.len * 56 + 48)
    path.smooth_spline(points, tension, true) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_smooth_closed(points &[]PathPoint, tension f64, color Color, width f64) int {
    $path := new_path(points.len * 56 + 48)
    path.smooth_spline(points, tension, true) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) rounded_polyline(points &[]PathPoint, radius f64) int {
    n := points.len
    if n < 2 { >> errors.new("draw: rounded_polyline requires at least 2 points") }
    if !valid_scalar(radius) || radius <= 0.0 || n == 2 {
        << path.polyline(points) or >>
    }
    path.move_to(points[0].x, points[0].y) or >>
    for i in 1:(n - 1) {
        prev_idx := i - 1
        next_idx := i + 1
        prev := &points[prev_idx]
        curr := &points[i]
        next := &points[next_idx]
        dx1 := curr.x - prev.x
        dy1 := curr.y - prev.y
        len1 := math.hypot(dx1, dy1)
        dx2 := next.x - curr.x
        dy2 := next.y - curr.y
        len2 := math.hypot(dx2, dy2)
        if len1 <= 0.000001 || len2 <= 0.000001 {
            path.line_to(curr.x, curr.y) or >>
        } else {
            cut := math.min(radius, math.min(len1, len2) * 0.45)
            in_x := curr.x - (dx1 / len1) * cut
            in_y := curr.y - (dy1 / len1) * cut
            out_x := curr.x + (dx2 / len2) * cut
            out_y := curr.y + (dy2 / len2) * cut
            path.line_to(in_x, in_y) or >>
            path.quad_to(curr.x, curr.y, out_x, out_y) or >>
        }
    }
    path.line_to(points[n - 1].x, points[n - 1].y) or >>
    << 0
}

pub fn (path $&Path) rounded_polygon(points &[]PathPoint, radius f64) int {
    n := points.len
    if n < 3 { >> errors.new("draw: rounded_polygon requires at least 3 points") }
    if !valid_scalar(radius) || radius <= 0.0 {
        << path.polygon(points) or >>
    }
    for i in 0:n {
        $prev_idx := i - 1
        if prev_idx < 0 { prev_idx = n - 1 }
        $next_idx := i + 1
        if next_idx >= n { next_idx = 0 }
        prev := &points[prev_idx]
        curr := &points[i]
        next := &points[next_idx]
        dx1 := curr.x - prev.x
        dy1 := curr.y - prev.y
        len1 := math.hypot(dx1, dy1)
        dx2 := next.x - curr.x
        dy2 := next.y - curr.y
        len2 := math.hypot(dx2, dy2)
        if len1 <= 0.000001 || len2 <= 0.000001 {
            if i == 0 { path.move_to(curr.x, curr.y) or >> }
            else { path.line_to(curr.x, curr.y) or >> }
        } else {
            cut := math.min(radius, math.min(len1, len2) * 0.45)
            in_x := curr.x - (dx1 / len1) * cut
            in_y := curr.y - (dy1 / len1) * cut
            out_x := curr.x + (dx2 / len2) * cut
            out_y := curr.y + (dy2 / len2) * cut
            if i == 0 { path.move_to(in_x, in_y) or >> }
            else { path.line_to(in_x, in_y) or >> }
            path.quad_to(curr.x, curr.y, out_x, out_y) or >>
        }
    }
    path.close() or >>
    << 0
}

pub fn (frame $&Frame) rounded_polyline(points &[]PathPoint, radius f64, color Color, width f64) int {
    $path := new_path(points.len * 60 + 32)
    path.rounded_polyline(points, radius) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) fill_rounded_polygon(points &[]PathPoint, radius f64, color Color) int {
    $path := new_path(points.len * 60 + 48)
    path.rounded_polygon(points, radius) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_rounded_polygon(points &[]PathPoint, radius f64, color Color, width f64) int {
    $path := new_path(points.len * 60 + 48)
    path.rounded_polygon(points, radius) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

// Full 360-degree annular ring using opposite winding subpaths.
pub fn (path $&Path) ring(cx f64, cy f64, inner_radius f64, outer_radius f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(inner_radius) ||
       !valid_extent(outer_radius) || outer_radius <= inner_radius {
        >> errors.new("draw: invalid ring radii")
    }
    path.circle(cx, cy, outer_radius) or >>
    k := inner_radius * bezier_kappa()
    path.move_to(cx + inner_radius, cy) or >>
    path.cubic_to(cx + inner_radius, cy - k, cx + k, cy - inner_radius, cx, cy - inner_radius) or >>
    path.cubic_to(cx - k, cy - inner_radius, cx - inner_radius, cy - k, cx - inner_radius, cy) or >>
    path.cubic_to(cx - inner_radius, cy + k, cx - k, cy + inner_radius, cx, cy + inner_radius) or >>
    path.cubic_to(cx + k, cy + inner_radius, cx + inner_radius, cy + k, cx + inner_radius, cy) or >>
    path.close() or >>
    << 0
}

pub fn (frame $&Frame) fill_ring(cx f64, cy f64, inner_radius f64, outer_radius f64, color Color) int {
    $path := new_path(512)
    path.ring(cx, cy, inner_radius, outer_radius) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_ring(cx f64, cy f64, inner_radius f64, outer_radius f64, color Color, width f64) int {
    $path := new_path(512)
    path.ring(cx, cy, inner_radius, outer_radius) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) wave(x f64, y f64, width f64, amplitude f64, wavelength f64, phase_deg f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) ||
       !valid_scalar(amplitude) || !valid_extent(wavelength) || !valid_scalar(phase_deg) {
        >> errors.new("draw: invalid wave parameters")
    }
    $steps := int(math.ceil((width / wavelength) * 16.0))
    if steps < 8 { steps = 8 }
    if steps > 1024 { steps = 1024 }
    phase := phase_deg * deg_to_rad()
    freq := (2.0 * math.pi()) / wavelength
    for i in 0:(steps + 1) {
        px := x + width * f64(i) / f64(steps)
        py := y + amplitude * math.sin((px - x) * freq + phase)
        if i == 0 { path.move_to(px, py) or >> }
        else { path.line_to(px, py) or >> }
    }
    << 0
}

pub fn (frame $&Frame) wave(x f64, y f64, width f64, amplitude f64, wavelength f64, phase_deg f64, color Color, line_width f64) int {
    $path := new_path(2048)
    path.wave(x, y, width, amplitude, wavelength, phase_deg) or >>
    options := round_stroke(line_width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) cross(cx f64, cy f64, size f64, thickness f64) int {
    if !valid_scalar(cx) || !valid_scalar(cy) || !valid_extent(size) ||
       !valid_extent(thickness) || thickness >= size {
        >> errors.new("draw: invalid cross geometry")
    }
    h := size * 0.5
    t := thickness * 0.5
    path.move_to(cx - t, cy - h) or >>
    path.line_to(cx + t, cy - h) or >>
    path.line_to(cx + t, cy - t) or >>
    path.line_to(cx + h, cy - t) or >>
    path.line_to(cx + h, cy + t) or >>
    path.line_to(cx + t, cy + t) or >>
    path.line_to(cx + t, cy + h) or >>
    path.line_to(cx - t, cy + h) or >>
    path.line_to(cx - t, cy + t) or >>
    path.line_to(cx - h, cy + t) or >>
    path.line_to(cx - h, cy - t) or >>
    path.line_to(cx - t, cy - t) or >>
    path.close() or >>
    << 0
}

pub fn (frame $&Frame) fill_cross(cx f64, cy f64, size f64, thickness f64, color Color) int {
    $path := new_path(320)
    path.cross(cx, cy, size, thickness) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_cross(cx f64, cy f64, size f64, thickness f64, color Color, width f64) int {
    $path := new_path(320)
    path.cross(cx, cy, size, thickness) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) checkmark(x f64, y f64, size f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(size) {
        >> errors.new("draw: invalid checkmark geometry")
    }
    path.move_to(x + size * 0.16, y + size * 0.52) or >>
    path.line_to(x + size * 0.42, y + size * 0.78) or >>
    path.line_to(x + size * 0.86, y + size * 0.24) or >>
    << 0
}

pub fn (frame $&Frame) checkmark(x f64, y f64, size f64, color Color, width f64) int {
    $path := new_path(96)
    path.checkmark(x, y, size) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (path $&Path) chevron(x f64, y f64, width f64, height f64, direction int) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       direction < DIR_UP || direction > DIR_LEFT {
        >> errors.new("draw: invalid chevron geometry or direction")
    }
    if direction == DIR_UP {
        path.move_to(x, y + height) or >>
        path.line_to(x + width * 0.5, y) or >>
        path.line_to(x + width, y + height) or >>
    } else if direction == DIR_RIGHT {
        path.move_to(x, y) or >>
        path.line_to(x + width, y + height * 0.5) or >>
        path.line_to(x, y + height) or >>
    } else if direction == DIR_DOWN {
        path.move_to(x, y) or >>
        path.line_to(x + width * 0.5, y + height) or >>
        path.line_to(x + width, y) or >>
    } else {
        path.move_to(x + width, y) or >>
        path.line_to(x, y + height * 0.5) or >>
        path.line_to(x + width, y + height) or >>
    }
    << 0
}

pub fn (frame $&Frame) chevron(x f64, y f64, width f64, height f64, direction int, color Color, line_width f64) int {
    $path := new_path(96)
    path.chevron(x, y, width, height, direction) or >>
    options := round_stroke(line_width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) double_arrow(x1 f64, y1 f64, x2 f64, y2 f64, head_size f64, color Color, width f64) int {
    if !valid_scalar(x1) || !valid_scalar(y1) || !valid_scalar(x2) || !valid_scalar(y2) || !valid_extent(head_size) {
        >> errors.new("draw: invalid double_arrow geometry")
    }
    mx := (x1 + x2) * 0.5
    my := (y1 + y2) * 0.5
    frame.arrow(mx, my, x1, y1, head_size, color, width) or >>
    frame.arrow(mx, my, x2, y2, head_size, color, width) or >>
    << 0
}
