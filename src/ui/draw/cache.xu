@ui/draw

#errors

// Owns one rasterized DisplayList. A changed immutable list ID, logical size,
// density or canvas generation replaces it only after the new snapshot succeeds.
// Explicitly dispose when retiring the cache. No caller-owned Surface is freed.
pub struct SurfaceCache {
    surface Surface
    source_id int
    canvas_id int
    generation int
    scale f64
}
pub fn new_surface_cache() SurfaceCache {
    image := Image{width: 0,height: 0,id: 0,canvas_id: 0,generation: 0}
    surface := Surface{width: 0.0,height: 0.0,pixel_width: 0,pixel_height: 0,image: image}
    << SurfaceCache{surface: surface,source_id: 0,canvas_id: 0,generation: 0,scale: 0.0}
}
pub fn (cache $&SurfaceCache) dispose() {
    if cache.surface.image.id > 0 {
        discard_image(cache.surface.image.id,cache.surface.image.canvas_id,cache.surface.image.generation)
    }
    cache.surface.image.id = 0
    cache.source_id = 0
}
pub fn (cache $&SurfaceCache) invalidate() { cache.source_id = 0 }

// Returns true only when pixels were regenerated. A failed replacement leaves
// the previous cache intact. Image updates do not mutate an already frozen list;
// freeze a replacement list to intentionally change that content/version.
pub fn (cache $&SurfaceCache) update(list &DisplayList,width f64,height f64,scale f64) bool {
    if list.id <= 0 { >> errors.new("draw: cache requires a live DisplayList handle") }
    if cache.source_id == list.id && cache.canvas_id == list.canvas_id && cache.generation == list.generation &&
       cache.surface.width == width && cache.surface.height == height && cache.scale == scale && cache.surface.image.id > 0 {
        << false
    }
    replacement := list.snapshot(width,height,scale) or >>
    cache.dispose()
    cache.surface = replacement
    cache.source_id = list.id
    cache.canvas_id = list.canvas_id
    cache.generation = list.generation
    cache.scale = scale
    << true
}

pub fn (frame $&Frame) cached_display_list(cache $&SurfaceCache,list &DisplayList,
    x f64,y f64,width f64,height f64,scale f64,opacity f64,sampler int) int {
    frame.writable() or >>
    cache.update(list,width,height,scale) or >>
    << frame.surface(&cache.surface,x,y,width,height,opacity,sampler) or >>
}
