@ui/draw

#errors
#strings
#strconv
#math
#ui
#image

pub const sampler_nearest = 0
pub const sampler_linear = 1
pub const max_image_bytes = 67108864
pub const max_image_dimension = 16384

// A canvas-scoped resource. Explicitly dispose when no longer needed. Accepted
// frames retain immutable versions, so update/dispose cannot alter those frames.
pub struct Image {
    pub width int
    pub height int
    id int
    canvas_id int
    generation int
}

pub struct ImageRect {
    pub x f64
    pub y f64
    pub width f64
    pub height f64
}

fn image_word(b &mut strings.ByteBuilder, value int, size int) {
    for i in 0:size { b.write_byte((value >> (i * 8)) & 255) }
}

fn image_upload(id int, canvas int, generation int, width int, height int, stride int, format int, data &string) int {
    mut header := strings.new_byte_builder(40)
    header.write_str("XUI1")
    image_word(mut &header, 1, 2)
    image_word(mut &header, format, 2)
    image_word(mut &header, id, 8)
    image_word(mut &header, canvas, 4)
    image_word(mut &header, generation, 4)
    image_word(mut &header, width, 4)
    image_word(mut &header, height, 4)
    image_word(mut &header, stride, 4)
    image_word(mut &header, 0, 4)
    // Only the small header uses []int storage. Binary pixels are copied once
    // into the transport string, avoiding eight-byte slots for every pixel byte.
    wire := header.to_string() + data
    accepted := write_file(":xu:/__image_upload", wire) or >>
    if accepted != wire.len { >> errors.new("draw: image host did not accept upload") }
    << 0
}

fn image_stride(width int, height int, stride int, length int) int {
    if width < 1 || height < 1 || width > max_image_dimension || height > max_image_dimension ||
       width * height * 4 > max_image_bytes { >> errors.new("draw: image dimensions exceed limits") }
    mut row := stride
    if row == 0 { row = width * 4 }
    if row < width * 4 || row > max_image_bytes || row * height > max_image_bytes ||
       row * height != length { >> errors.new("draw: image requires complete RGBA8 rows") }
    << row
}

fn abandon_image(id int) {
    write_file(":xu:/__image_abandon", str(id)) or (err) { << }
}

fn discard_image(id int, canvas int, generation int) {
    write_file(":xu:/__image_dispose", str(id) + "\t" + str(canvas) + "\t" + str(generation)) or (err) { << }
}

fn reserve_image() int {
    if ui.host_tmp() != ":xu:" { >> errors.new("draw: images require the in-process UI host") }
    token := read_file(":xu:/__image_id") or >>
    if token.len != 20 { >> errors.new("draw: image host is not linked") }
    id := strconv.atoi(&token) or >>
    if id <= 0 { >> errors.new("draw: image resource capacity is exhausted") }
    << id
}

// Top-left, straight sRGB RGBA8. stride=0 means width*4; otherwise include every
// row's padding in data. Input is borrowed; the native resource owns its copy.
pub fn (context &Context) image_rgba(width int, height int, stride int, data &string) Image {
    row := image_stride(width, height, stride, data.len) or >>
    id := reserve_image() or >>
    image_upload(id, context.canvas_id, context.generation, width, height, row, 0, data) or (err) {
        abandon_image(id)
        >> errors.new("draw: image creation rejected (closed canvas or memory limit)")
    }
    << Image{width: width, height: height, id: id, canvas_id: context.canvas_id, generation: context.generation}
}

// Interoperate with #image's CPU pixel buffers, including nonzero rect origins.
// These are the same straight RGBA8 bytes used by its PNG/JPEG decoder paths.
pub fn (context &Context) image_pixels(bitmap &image.RGBA) Image {
    width := bitmap.rect.max.x - bitmap.rect.min.x
    height := bitmap.rect.max.y - bitmap.rect.min.y
    image_stride(width, height, bitmap.stride, bitmap.pix.len) or >>
    bytes := string_from_bytes(bitmap.pix)
    << context.image_rgba(width, height, bitmap.stride, &bytes) or >>
}

fn image_metadata(context &Context, id int) Image {
    info := read_file(":xu:/__image_info/" + str(id)) or >>
    fields := strings.split(&info, "\t")
    if info.len != 32 || fields.len != 3 { >> errors.new("draw: invalid image metadata") }
    width := strconv.atoi(&fields[0]) or >>
    height := strconv.atoi(&fields[1]) or >>
    generation := strconv.atoi(&fields[2]) or >>
    if width < 1 || height < 1 { >> errors.new("draw: image canvas closed during load") }
    << Image{width: width, height: height, id: id, canvas_id: context.canvas_id, generation: generation}
}

fn load_encoded_image(context &Context, format int, data &string) Image {
    id := reserve_image() or >>
    image_upload(id, context.canvas_id, context.generation, 0, 0, 0, format, data) or (err) {
        abandon_image(id)
        >> errors.new("draw: unable to load PNG/JPEG (invalid data, closed canvas or resource limit)")
    }
    result := image_metadata(context, id) or (err) {
        discard_image(id, context.canvas_id, context.generation)
        >> errors.new("draw: image metadata unavailable")
    }
    << result
}

// Decode PNG/JPEG once at load time. Palette/gray/interlaced PNG and progressive
// JPEG share the same bounded native decoder on all three hosts.
pub fn (context &Context) image_encoded(data &string) Image {
    if data.len < 1 || data.len > max_image_bytes { >> errors.new("draw: encoded image exceeds limits") }
    << load_encoded_image(context, 1, data) or >>
}

// Bounded native file read; Windows paths are UTF-8 and opened with CreateFileW.
// Only regular files up to 64 MiB are accepted. The input buffer also counts
// toward the shared decoder scratch budget while decoding.
pub fn (context &Context) load_image(path &string) Image {
    if path.len < 1 || path.len > 4096 { >> errors.new("draw: invalid image file path") }
    << load_encoded_image(context, 3, path) or >>
}

pub fn (context &Context) load_embedded_image(path &string) Image {
    encoded := ui.load_embedded_asset(path) or >>
    << context.image_encoded(&encoded) or >>
}

// Same dimensions, new immutable version. Existing accepted frames keep their
// old pixels; the next successful present captures the new version.
pub fn (image &Image) update_rgba(stride int, data &string) int {
    if image.id <= 0 { >> errors.new("draw: image is disposed") }
    row := image_stride(image.width, image.height, stride, data.len) or >>
    << image_upload(image.id, image.canvas_id, image.generation, image.width, image.height, row, 2, data) or >>
}

pub fn (image &mut Image) dispose() int {
    if image.id == 0 { << 0 }
    wire := str(image.id) + "\t" + str(image.canvas_id) + "\t" + str(image.generation)
    accepted := write_file(":xu:/__image_dispose", wire) or >>
    if accepted != wire.len { >> errors.new("draw: image is no longer live") }
    image.id = 0
    << 0
}

// Source coordinates are pixels; destination coordinates follow the frame CTM.
// Opacity is 0...1; sampler_nearest/linear are explicit and portable.
pub fn (frame &mut Frame) image_region(image &Image, source &ImageRect, destination &ImageRect, opacity f64, sampler int) int {
    if image.id <= 0 || image.canvas_id != frame.canvas_id ||
       (image.generation > 0 && frame.generation > 0 && image.generation != frame.generation) {
        << frame.fail("draw: image belongs to another or closed canvas") or >>
    }
    if math.is_nan(opacity) || math.is_inf(opacity) || opacity < 0.0 || opacity > 1.0 ||
       (sampler != sampler_nearest && sampler != sampler_linear) {
        << frame.fail("draw: invalid image opacity or sampler") or >>
    }
    if source.x < 0.0 || source.y < 0.0 || source.width <= 0.0 || source.height <= 0.0 ||
       source.x + source.width > f64(image.width) || source.y + source.height > f64(image.height) {
        << frame.fail("draw: image source region is outside its pixels") or >>
    }
    frame.record(22, 76) or >>
    frame.word64(image.id)
    frame.scalar(source.x, 1) or >>
    frame.scalar(source.y, 1) or >>
    frame.scalar(source.width, 2) or >>
    frame.scalar(source.height, 2) or >>
    frame.scalar(destination.x, 0) or >>
    frame.scalar(destination.y, 0) or >>
    frame.scalar(destination.width, 1) or >>
    frame.scalar(destination.height, 1) or >>
    frame.word32(int(opacity * 65535.0 + 0.5) | (sampler << 16))
    << 0
}

pub fn (frame &mut Frame) image(image &Image, x f64, y f64, width f64, height f64) int {
    source := ImageRect{x: 0.0, y: 0.0, width: f64(image.width), height: f64(image.height)}
    destination := ImageRect{x: x, y: y, width: width, height: height}
    << frame.image_region(image, &source, &destination, 1.0, sampler_linear) or >>
}
