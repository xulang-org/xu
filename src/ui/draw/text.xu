@ui/draw

#errors
#strings
#strconv
#math
#ui
#ui/internal/codec

pub const TEXT_LEFT = 0
pub const TEXT_CENTER = 1
pub const TEXT_RIGHT = 2

pub struct TextOptions {
    pub family string
    pub size f64
    pub width f64
    pub weight int
    pub italic bool
    pub align int
    pub line_height f64
}

pub struct TextMetrics {
    pub width f64
    pub height f64
    pub baseline f64
    pub lines int
    pub ink_x f64
    pub ink_y f64
    pub ink_width f64
    pub ink_height f64
}

pub fn text_options(size f64) TextOptions {
    << TextOptions{family: "", size: size, width: 0.0, weight: 400, italic: false, align: TEXT_LEFT, line_height: 0.0}
}

// Metrics and drawing share one native layout, including shaping, fallback,
// wrapping and trailing empty lines. Font sizes/positions use logical pixels.
// A Frame retains its layout even after this user handle is disposed.
pub struct TextLayout {
    pub metrics TextMetrics
    id int
    canvas_id int
    generation int
}

// A shaped cluster and its logical edge. Keep index/trailing together at soft
// wraps and bidi boundaries. index/length count UTF-8 bytes, never UTF-16 units.
pub struct TextHit {
    pub index int
    pub length int
    pub trailing bool
    pub inside bool
    pub x f64
    pub y f64
    pub height f64
}

pub fn (hit &TextHit) byte_index() int {
    if hit.trailing { << hit.index + hit.length }
    << hit.index
}

// Bind the same immutable layout that is drawn at x/y. Its text must equal the
// input snapshot's display_value(), including preedit, at this revision.
// The session retains the layout after dispose(); edits invalidate the binding.
pub fn (layout &TextLayout) bind_input(input &ui.TextInput, revision int, x f64, y f64) int {
    transform := ui.text_input_translation(x, y)
    << layout.bind_input_transform(input, revision, &transform, false) or >>
}
pub fn (layout &TextLayout) bind_input_transform(input &ui.TextInput, revision int, transform &ui.TextInputTransform, upstream bool) int {
    if layout.id <= 0 || layout.canvas_id != input.canvas_id ||
       (layout.generation != 0 && layout.generation != input.generation) { >> errors.new("draw: input/layout canvas identity mismatch") }
    << input.bind_layout_handle(layout.id, revision, transform, upstream) or >>
}

fn text_hex_float(value f64) string {
    bits := frame_float_word(value)
    digits := "0123456789abcdef"
    mut result := strings.new_byte_builder(16)
    for i in 0:16 { result.write_byte(digits[(bits >> ((15 - i) * 4)) & 15]) }
    << result.to_string()
}

fn (layout &TextLayout) query_text(suffix string) TextHit {
    if layout.id <= 0 { >> errors.new("draw: text layout is disposed") }
    data := read_file(suffix) or >>
    if data.len != 72 || data[0:4] != "XTH1" || text_u32(&data, 4) != 1 {
        >> errors.new("draw: text query unavailable (closed layout, invalid byte boundary or native backend error)")
    }
    index := int(text_f64(&data, 16) or >>)
    length := int(text_f64(&data, 24) or >>)
    trailing := text_f64(&data, 32) or >> != 0.0
    inside := text_f64(&data, 40) or >> != 0.0
    x := text_f64(&data, 48) or >>
    y := text_f64(&data, 56) or >>
    height := text_f64(&data, 64) or >>
    << TextHit{index: index, length: length, trailing: trailing, inside: inside, x: x, y: y, height: height}
}

// Coordinates are relative to this layout's top-left before the frame CTM.
// Outside points return the nearest edge and inside=false.
pub fn (layout &TextLayout) hit_test(x f64, y f64) TextHit {
    if math.is_nan(x) || math.is_nan(y) || math.is_inf(x) || math.is_inf(y) ||
       math.abs(x) > 1048576.0 || math.abs(y) > 1048576.0 { >> errors.new("draw: invalid text hit coordinates") }
    path := ":xu:/__text_hit/" + str(layout.id) + "/" + str(layout.canvas_id) + "/" + str(layout.generation) +
        "/" + text_hex_float(x) + "/" + text_hex_float(y)
    << layout.query_text(path) or >>
}

// Scalar boundaries inside a shaped cluster normalize to that cluster. Byte
// offsets inside a UTF-8 encoding are rejected; trailing selects its far edge.
pub fn (layout &TextLayout) caret(index int, trailing bool) TextHit {
    if index < 0 || index > 16384 { >> errors.new("draw: invalid text caret index") }
    mut edge := "0"
    if trailing { edge = "1" }
    path := ":xu:/__text_caret/" + str(layout.id) + "/" + str(layout.canvas_id) + "/" + str(layout.generation) +
        "/" + str(index) + "/" + edge
    << layout.query_text(path) or >>
}

fn text_u32(data &string, offset int) int { << codec.read_word32(data, offset) }
fn text_f64(data &string, offset int) f64 { << codec.read_float64(data, offset) or >> }

fn text_metadata(id int, canvas int) TextLayout {
    data := read_file(":xu:/__text_info/" + str(id)) or >>
    if data.len != 80 || data[0:4] != "XTM1" || text_u32(&data, 4) != 1 {
        >> errors.new("draw: text layout closed during creation")
    }
    metrics := TextMetrics{width: text_f64(&data, 16) or >>, height: text_f64(&data, 24) or >>,
        baseline: text_f64(&data, 32) or >>, lines: int(text_f64(&data, 40) or >>),
        ink_x: text_f64(&data, 48) or >>, ink_y: text_f64(&data, 56) or >>,
        ink_width: text_f64(&data, 64) or >>, ink_height: text_f64(&data, 72) or >>}
    << TextLayout{metrics: metrics, id: id, canvas_id: canvas, generation: text_u32(&data, 8)}
}

fn text_drop(id int, canvas int, generation int) {
    write_file(":xu:/__text_dispose", str(id) + "\t" + str(canvas) + "\t" + str(generation)) or (err) { << }
}
fn text_abandon(id int) {
    write_file(":xu:/__text_abandon", str(id)) or (err) { << }
}

// Empty family uses the platform UI font. size=0 selects 14px; weight=0 selects
// 400. width=0 disables wrapping; center/right require an explicit width.
// Maximum text is 16 KiB UTF-8 and family 256 bytes. Live layout identities
// grow dynamically within the host's byte budget. Native
// coordinate/shaping limits also bound size*(byte_length+1) to 262144.
pub fn (context &Context) layout_text(value &string, options &TextOptions) TextLayout {
    if ui.host_tmp() != ":xu:" { >> errors.new("draw: text layouts require the in-process UI host") }
    mut size := options.size
    if size == 0.0 { size = 14.0 }
    mut weight := options.weight
    if weight == 0 { weight = 400 }
    if value.len > 16384 || options.family.len > 256 || math.is_nan(size) || math.is_inf(size) || size < 1.0 || size > 512.0 ||
       size * f64(value.len + 1) > 262144.0 || math.is_nan(options.width) || math.is_inf(options.width) ||
       options.width < 0.0 || options.width > 262144.0 || weight < 100 || weight > 900 ||
       options.align < 0 || options.align > 2 || (options.width == 0.0 && options.align != 0) ||
       math.is_nan(options.line_height) || math.is_inf(options.line_height) || options.line_height < 0.0 ||
       (options.line_height > 0.0 && options.line_height < size) || options.line_height > 1024.0 ||
       options.line_height * f64(value.len + 1) > 262144.0 {
        >> errors.new("draw: invalid text options or layout exceeds limits")
    }
    token := read_file(":xu:/__text_id") or >>
    if token.len != 20 { >> errors.new("draw: native text layout backend is unavailable") }
    id := strconv.atoi(&token) or >>
    if id <= 0 { >> errors.new("draw: text layout capacity exhausted or backend unavailable") }
    mut wire := strings.new_byte_builder(80)
    wire.write_str("XTL1")
    image_word(mut &wire, 1, 2)
    image_word(mut &wire, 0, 2)
    image_word(mut &wire, id, 8)
    image_word(mut &wire, context.canvas_id, 4)
    image_word(mut &wire, context.generation, 4)
    image_word(mut &wire, frame_float_word(size), 8)
    image_word(mut &wire, frame_float_word(options.width), 8)
    image_word(mut &wire, frame_float_word(f64(weight)), 8)
    mut italic := 0
    if options.italic { italic = 1 }
    image_word(mut &wire, frame_float_word(f64(italic)), 8)
    image_word(mut &wire, frame_float_word(f64(options.align)), 8)
    image_word(mut &wire, frame_float_word(options.line_height), 8)
    image_word(mut &wire, options.family.len, 4)
    image_word(mut &wire, value.len, 4)
    body := wire.to_string() + options.family + value
    accepted := write_file(":xu:/__text_upload", body) or (err) {
        text_abandon(id)
        >> errors.new("draw: text layout upload failed (canvas " + str(context.canvas_id) + ", generation " + str(context.generation) + ")")
    }
    if accepted != body.len {
        text_abandon(id)
        >> errors.new("draw: text layout rejected (invalid UTF-8, closed canvas or resource limit)")
    }
    layout := text_metadata(id, context.canvas_id) or (err) {
        text_drop(id, context.canvas_id, context.generation)
        >> errors.new("draw: text layout metadata unavailable")
    }
    << layout
}

pub fn (layout &mut TextLayout) dispose() int {
    if layout.id == 0 { << 0 }
    body := str(layout.id) + "\t" + str(layout.canvas_id) + "\t" + str(layout.generation)
    accepted := write_file(":xu:/__text_dispose", body) or >>
    if accepted != body.len { >> errors.new("draw: text layout is no longer live") }
    layout.id = 0
    << 0
}

pub fn (frame &mut Frame) text_layout(layout &TextLayout, x f64, y f64, color Color) int {
    if layout.id <= 0 || layout.canvas_id != frame.canvas_id ||
       (layout.generation > 0 && frame.generation > 0 && layout.generation != frame.generation) {
        << frame.fail("draw: text layout belongs to another or closed canvas") or >>
    }
    frame.record(23, 28) or >>
    frame.word64(layout.id)
    frame.scalar(x, 0) or >>
    frame.scalar(y, 0) or >>
    frame.word32(color.packed)
    << 0
}

// Canvas-independent layout rectangles for a UTF-8 selection. The host batches
// shaped cluster queries and coalesces touching rectangles on each visual line.
pub struct TextSelectionRect { pub x f64
    pub y f64
    pub width f64
    pub height f64 }
pub fn (layout &TextLayout) selection_rects(start int,end int) []TextSelectionRect {
    if start < 0 || end < start || end > 16384 { >> errors.new("draw: invalid selection range") }
    path := ":xu:/__text_selection/" + str(layout.id) + "/" + str(layout.canvas_id) + "/" + str(layout.generation) + "/" + str(start) + "/" + str(end)
    data := read_file(path) or >>
    if data.len < 12 || data[0:4] != "XTS1" || text_u32(&data,4) != 1 { >> errors.new("draw: selection geometry unavailable") }
    count := text_u32(&data,8)
    if count > 16384 || data.len != 12 + count * 32 { >> errors.new("draw: invalid selection geometry") }
    mut result := []TextSelectionRect{}
    for i in 0:count { offset := 12 + i * 32
        result.push(TextSelectionRect{x: text_f64(&data,offset) or >>,y: text_f64(&data,offset + 8) or >>,
            width: text_f64(&data,offset + 16) or >>,height: text_f64(&data,offset + 24) or >>}) }
    << result
}
