@ui/draw

#errors
#math

pub const MAX_LAYER_DEPTH = 16

struct LayerState {
    wire string
    count int
    depth int
    x f64
    y f64
    width f64
    height f64
    scale f64
    opacity f64
}

fn (frame $&Frame) clear_temporary_images() {
    for id in frame.temporary_images { discard_image(id,frame.canvas_id,frame.generation) }
    frame.temporary_images = []int{}
}

// Isolated transparent child frame, with its own white pen, identity CTM and
// [0,width]x[0,height] bounds. Parent state/clip are restored at end_layer and
// apply to the resulting image at (x,y). Rasterization occurs once at end_layer.
// begin/cancel/dispose discard every open child and owned temporary resource.
pub fn (frame $&Frame) begin_layer(bounds &ImageRect, scale f64, opacity f64) int {
    frame.writable() or >>
    surface_size(bounds.width,bounds.height,scale) or >>
    if !gradient_coordinate(bounds.x) || !gradient_coordinate(bounds.y) ||
       !gradient_coordinate(opacity) || opacity < 0.0 || opacity > 1.0 ||
       frame.layer_depth >= MAX_LAYER_DEPTH || frame.layer_bytes > MAX_FRAME_BYTES - frame.buffer.len {
        << frame.fail("draw: invalid layer bounds, opacity, nesting or saved-frame budget") or >>
    }
    wire := frame.buffer.to_string()
    state := LayerState{wire: wire,count: frame.count,depth: frame.depth,x: bounds.x,y: bounds.y,
        width: bounds.width,height: bounds.height,scale: scale,opacity: opacity}
    if frame.layer_depth == frame.layer_stack.len {
        frame.layer_stack.push(LayerState{wire: "",count: 0,depth: 0,x: 0.0,y: 0.0,width: 0.0,height: 0.0,scale: 0.0,opacity: 0.0})
    }
    frame.layer_stack[frame.layer_depth] = state
    frame.layer_depth = frame.layer_depth + 1
    frame.layer_bytes = frame.layer_bytes + frame.buffer.len
    << frame.reset_recording() or >>
}

pub fn (frame $&Frame) end_layer() int {
    if frame.layer_depth == 0 { << frame.fail("draw: layer stack underflow") or >> }
    n := frame.layer_depth - 1
    wire := frame.layer_stack[n].wire + ""
    count := frame.layer_stack[n].count
    depth := frame.layer_stack[n].depth
    x := frame.layer_stack[n].x
    y := frame.layer_stack[n].y
    width := frame.layer_stack[n].width
    height := frame.layer_stack[n].height
    scale := frame.layer_stack[n].scale
    opacity := frame.layer_stack[n].opacity
    if count >= MAX_FRAME_COMMANDS || wire.len > MAX_FRAME_BYTES - 84 || frame.temporary_images.len >= 256 {
        << frame.fail("draw: layer result exceeds frame or resource capacity") or >>
    }
    cached := frame.snapshot_recording(width,height,scale,true) or >>
    frame.temporary_images.push(cached.image.id)
    frame.layer_depth = n
    frame.layer_stack[n] = LayerState{wire: "",count: 0,depth: 0,x: 0.0,y: 0.0,width: 0.0,height: 0.0,scale: 0.0,opacity: 0.0}
    frame.layer_bytes = frame.layer_bytes - wire.len
    frame.buffer.len = 0
    frame.reserve(wire.len)
    frame.bytes(wire)
    frame.count = count
    frame.depth = depth
    frame.active = true
    frame.sealed = false
    frame.failed = false
    << frame.surface(&cached,x,y,width,height,opacity,SAMPLER_LINEAR) or >>
}

// A Frame can own transient native images after end_layer/gradient fills.
// Explicitly retire a recorder that will not be presented or reused.
pub fn (frame $&Frame) dispose() { frame.cancel() }
