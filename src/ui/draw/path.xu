@ui/draw

#errors
#strings
#math
#ui/internal/codec

pub const max_path_bytes = 2097152
pub const max_path_segments = 32768
pub const fill_nonzero = 0
pub const fill_evenodd = 1
pub const cap_butt = 0
pub const cap_round = 1
pub const cap_square = 2
pub const join_miter = 0
pub const join_round = 1
pub const join_bevel = 2

// Reusable CPU recorder. A failed operation poisons the path until clear().
// Frame operations copy a snapshot, so later edits cannot alter recorded work.
pub struct Path {
    buffer strings.ByteBuilder
    count int
    open bool
    failed bool
}
pub fn new_path(capacity int) Path {
    mut size := capacity
    if size < 20 { size = 1024 }
    if size > max_path_bytes { size = max_path_bytes }
    << Path{buffer: strings.new_byte_builder(size), count: 0, open: false, failed: false}
}
pub fn (path &mut Path) clear() {
    path.buffer.len = 0
    path.count = 0
    path.open = false
    path.failed = false
}
pub fn (path &Path) byte_len() int { << path.buffer.len }
pub fn (path &Path) capacity() int { << path.buffer.buf.len }
pub fn (path &Path) segment_count() int { << path.count }
fn path_pair(x f64, y f64) bool {
    << !math.is_nan(x) && !math.is_inf(x) && !math.is_nan(y) && !math.is_inf(y) &&
        math.abs(x) <= 1000000000.0 && math.abs(y) <= 1000000000.0
}
fn (path &mut Path) invalid() int {
    path.failed = true
    >> errors.new("draw: invalid path coordinate, sequence or capacity")
}
fn (path &mut Path) path_word(value int, size int) {
    base := path.buffer.len
    for i in 0:size { path.buffer.buf[base + i] = (value >> (i * 8)) & 255 }
    path.buffer.len = base + size
}
fn (path &mut Path) path_record(verb int, size int) int {
    if path.failed || path.count >= max_path_segments || path.buffer.len > max_path_bytes-size ||
       (verb != 1 && !path.open) { << path.invalid() or >> }
    buffer := mut &path.buffer
    buffer.reserve(size)
    path.path_word(verb, 4)
    path.count = path.count + 1
    path.open = verb != 5
    << 0
}
fn (path &mut Path) path_scalar(value f64) {
    path.path_word(codec.finite_f64_bits(value), 8)
}
pub fn (path &mut Path) move_to(x f64, y f64) int {
    if !path_pair(x, y) { << path.invalid() or >> }
    path.path_record(1, 20) or >>
    path.path_scalar(x)
    path.path_scalar(y)
    << 0
}
pub fn (path &mut Path) line_to(x f64, y f64) int {
    if !path_pair(x, y) { << path.invalid() or >> }
    path.path_record(2, 20) or >>
    path.path_scalar(x)
    path.path_scalar(y)
    << 0
}
pub fn (path &mut Path) quad_to(cx f64, cy f64, x f64, y f64) int {
    if !path_pair(cx, cy) || !path_pair(x, y) { << path.invalid() or >> }
    path.path_record(3, 36) or >>
    path.path_scalar(cx)
    path.path_scalar(cy)
    path.path_scalar(x)
    path.path_scalar(y)
    << 0
}
pub fn (path &mut Path) cubic_to(c1x f64, c1y f64, c2x f64, c2y f64, x f64, y f64) int {
    if !path_pair(c1x, c1y) || !path_pair(c2x, c2y) || !path_pair(x, y) { << path.invalid() or >> }
    path.path_record(4, 52) or >>
    path.path_scalar(c1x)
    path.path_scalar(c1y)
    path.path_scalar(c2x)
    path.path_scalar(c2y)
    path.path_scalar(x)
    path.path_scalar(y)
    << 0
}
// Ends this figure. Start another with move_to before adding more segments.
// Filling implicitly closes open figures; stroking preserves their open ends.
pub fn (path &mut Path) close() int { << path.path_record(5, 4) or >> }

pub struct StrokeOptions {
    pub width f64
    pub cap int
    pub join int
    pub miter_limit f64
    pub dashes []f64
    pub dash_offset f64
    // Logical-unit error bound for the shared curved-dash approximation.
    // Continuous curves stay native. Reduce this when magnifying a path.
    pub flatten_tolerance f64
}
pub fn stroke_options(width f64) StrokeOptions {
    << StrokeOptions{width: width, cap: cap_butt, join: join_miter, miter_limit: 10.0,
        dashes: []f64{}, dash_offset: 0.0, flatten_tolerance: 0.1}
}
fn stroke_valid(style &StrokeOptions) bool {
    if !path_pair(style.width, style.miter_limit) || style.width < 0.000001 || style.width > 16384.0 ||
       style.miter_limit < 1.0 || style.miter_limit > 1024.0 || style.cap < 0 || style.cap > 2 || style.join < 0 || style.join > 2 ||
       !path_pair(style.dash_offset, style.flatten_tolerance) || style.flatten_tolerance < 0.000001 || style.flatten_tolerance > 16.0 ||
       style.dashes.len > 32 || style.dashes.len % 2 != 0 { << false }
    for length in style.dashes {
        if math.is_nan(length) || math.is_inf(length) || length < 0.000001 || length > 16384.0 { << false }
    }
    << true
}
fn (frame &mut Frame) path_header(path &Path, color Color, flags int, dashes int) int {
    if path.failed { << frame.fail("draw: path is invalid; clear before reuse") or >> }
    frame.record(24, 48 + dashes * 8 + path.buffer.len) or >>
    frame.word32(flags)
    frame.word32(color.packed)
    frame.word32(path.count)
    frame.word32(dashes)
    << 0
}
fn (frame &mut Frame) path_bytes(path &Path) {
    base := frame.buffer.len
    for i in 0:path.buffer.len { frame.buffer.buf[base + i] = path.buffer.buf[i] }
    frame.buffer.len = base + path.buffer.len
}
pub fn (frame &mut Frame) fill_path(path &Path, color Color, rule int) int {
    if rule != fill_nonzero && rule != fill_evenodd { << frame.fail("draw: invalid path fill rule") or >> }
    frame.path_header(path, color, rule << 1, 0) or >>
    for i in 0:4 { frame.word64(0) }
    frame.path_bytes(path)
    << 0
}
// Dash lengths are positive, even-count on/off pairs in logical units. Phase
// restarts for each figure. Cap/join apply to generated dash figures too.
// Host admission rejects excessive flattening/dash work atomically; no partial
// path is displayed, and the previous scene remains intact.
pub fn (frame &mut Frame) stroke_path(path &Path, color Color, style &StrokeOptions) int {
    if !stroke_valid(style) { << frame.fail("draw: invalid path stroke options") or >> }
    frame.path_header(path, color, 1 | (style.cap << 2) | (style.join << 4), style.dashes.len) or >>
    frame.word64(codec.finite_f64_bits(style.width))
    frame.word64(codec.finite_f64_bits(style.miter_limit))
    frame.word64(codec.finite_f64_bits(style.dash_offset))
    frame.word64(codec.finite_f64_bits(style.flatten_tolerance))
    for length in style.dashes { frame.word64(codec.finite_f64_bits(length)) }
    frame.path_bytes(path)
    << 0
}
