@ui/draw

#errors
#math
#strings

pub const SPREAD_PAD = 0
pub const SPREAD_REPEAT = 1
pub const SPREAD_REFLECT = 2

pub struct GradientStop {
    pub offset f64
    pub color Color
}
pub struct Gradient {
    pub spread int
    pub stops []GradientStop
    kind int
    x0 f64
    y0 f64
    x1 f64
    y1 f64
    radius f64
}

pub fn linear_gradient(x0 f64, y0 f64, x1 f64, y1 f64, stops []GradientStop) Gradient {
    << Gradient{kind: 0, spread: SPREAD_PAD, stops: stops, x0: x0, y0: y0, x1: x1, y1: y1, radius: 0.0}
}
pub fn radial_gradient(x f64, y f64, radius f64, stops []GradientStop) Gradient {
    << Gradient{kind: 1, spread: SPREAD_PAD, stops: stops, x0: x, y0: y, x1: 0.0, y1: 0.0, radius: radius}
}

fn gradient_coordinate(value f64) bool {
    << !math.is_nan(value) && !math.is_inf(value) && math.abs(value) <= 1000000000.0
}

// Rasterize once at explicit density, using pixel centers in logical units.
// 2...32 strictly increasing stops, first=0 and last=1. Interpolation uses
// premultiplied encoded sRGB; transparent stop RGB has no influence. This is a
// reusable raster paint layer; scaling it later samples its cached resolution.
pub fn (context &Context) gradient(width f64, height f64, scale f64, paint &Gradient) Surface {
    size := surface_size(width, height, scale) or >>
    if paint.stops.len < 2 || paint.stops.len > 32 || paint.spread < SPREAD_PAD || paint.spread > SPREAD_REFLECT ||
       !gradient_coordinate(paint.x0) || !gradient_coordinate(paint.y0) ||
       !gradient_coordinate(paint.x1) || !gradient_coordinate(paint.y1) || !gradient_coordinate(paint.radius) {
        >> errors.new("draw: invalid gradient geometry or stop count")
    }
    dx := paint.x1 - paint.x0
    dy := paint.y1 - paint.y0
    if (paint.kind == 0 && dx * dx + dy * dy < 0.000000000001) ||
       (paint.kind == 1 && paint.radius < 0.000001) {
        >> errors.new("draw: degenerate gradient")
    }
    mut previous := 0.0 - 1.0
    for stop in paint.stops {
        if !gradient_coordinate(stop.offset) || stop.offset < 0.0 || stop.offset > 1.0 || stop.offset <= previous {
            >> errors.new("draw: gradient stops must increase strictly within 0...1")
        }
        previous = stop.offset
    }
    if paint.stops[0].offset != 0.0 || paint.stops[paint.stops.len - 1].offset != 1.0 {
        >> errors.new("draw: gradient requires endpoint stops at 0 and 1")
    }
    id := reserve_image() or >>
    mut wire := strings.new_byte_builder(104 + paint.stops.len * 16)
    wire.write_str("XUG1")
    image_word(mut &wire, 1, 4)
    image_word(mut &wire, id, 8)
    image_word(mut &wire, context.canvas_id, 4)
    image_word(mut &wire, context.generation, 4)
    image_word(mut &wire, size.width, 4)
    image_word(mut &wire, size.height, 4)
    image_word(mut &wire, frame_float_word(width), 8)
    image_word(mut &wire, frame_float_word(height), 8)
    image_word(mut &wire, paint.kind, 4)
    image_word(mut &wire, paint.spread, 4)
    image_word(mut &wire, paint.stops.len, 4)
    image_word(mut &wire, 0, 4)
    for value in [paint.x0, paint.y0, paint.x1, paint.y1, paint.radius] { image_word(mut &wire, frame_float_word(value), 8) }
    for stop in paint.stops {
        image_word(mut &wire, frame_float_word(stop.offset), 8)
        image_word(mut &wire, stop.color.packed, 4)
        image_word(mut &wire, 0, 4)
    }
    data := wire.to_string()
    accepted := write_file(":xu:/__gradient_upload", data) or (err) {
        abandon_image(id)
        >> errors.new("draw: gradient transport failed")
    }
    if accepted != data.len {
        abandon_image(id)
        >> errors.new("draw: gradient rejected (closed canvas, invalid data or pixel budget)")
    }
    resource := image_metadata(context, id) or (err) {
        discard_image(id, context.canvas_id, context.generation)
        >> errors.new("draw: gradient canvas closed during creation")
    }
    << Surface{width: width, height: height, pixel_width: size.width, pixel_height: size.height, image: resource}
}
