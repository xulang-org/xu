@ui/draw

#errors
#math

pub const FIT_FILL = 0
pub const FIT_CONTAIN = 1
pub const FIT_COVER = 2
pub const FIT_CENTER = 3

pub fn text_options_styled(family string, size f64, weight int, italic bool) TextOptions {
    << TextOptions{family: family + "", size: size, width: 0.0, weight: weight, italic: italic, align: TEXT_LEFT, line_height: 0.0}
}

pub fn text_options_wrapped(size f64, width f64, align int) TextOptions {
    << TextOptions{family: "", size: size, width: width, weight: 400, italic: false, align: align, line_height: 0.0}
}

// Measures text metrics using a temporary native layout that is immediately disposed.
pub fn (context &Context) measure_text(value &string, size f64) TextMetrics {
    options := text_options(size)
    $layout := context.layout_text(value, &options) or >>
    metrics := layout.metrics
    layout.dispose() or >>
    << metrics
}

// Draws a shaped TextLayout aligned within [x, x+width] x [y, y+height] using align_x, align_y in [0, 1].
pub fn (frame $&Frame) text_aligned(layout &TextLayout, x f64, y f64, width f64, height f64, align_x f64, align_y f64, color Color) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_scalar(width) || !valid_scalar(height) ||
       width < 0.0 || height < 0.0 {
        >> errors.new("draw: invalid text_aligned box")
    }
    ax := clamp_unit(align_x)
    ay := clamp_unit(align_y)
    tx := x + (width - layout.metrics.width) * ax
    ty := y + (height - layout.metrics.height) * ay
    << frame.text_layout(layout, tx, ty, color) or >>
}

// Draws a rounded pill badge around a TextLayout with background, optional border, and foreground color.
pub fn (frame $&Frame) text_pill(layout &TextLayout, x f64, y f64, pad_x f64, pad_y f64, bg Color, border Color, fg Color) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_scalar(pad_x) || !valid_scalar(pad_y) ||
       pad_x < 0.0 || pad_y < 0.0 {
        >> errors.new("draw: invalid text_pill parameters")
    }
    w := math.max(1.0, layout.metrics.width + pad_x * 2.0)
    h := math.max(1.0, layout.metrics.height + pad_y * 2.0)
    if bg.a() > 0 {
        frame.fill_capsule(x, y, w, h, bg) or >>
    }
    if border.a() > 0 {
        frame.stroke_capsule(x, y, w, h, border, 1.0) or >>
    }
    << frame.text_layout(layout, x + pad_x, y + pad_y, fg) or >>
}

// Draws an Image into [x, y, width, height] using FIT_FILL, FIT_CONTAIN, FIT_COVER, or FIT_CENTER.
pub fn (frame $&Frame) image_fit(image &Image, x f64, y f64, width f64, height f64, fit_mode int, opacity f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       image.width < 1 || image.height < 1 || fit_mode < FIT_FILL || fit_mode > FIT_CENTER {
        >> errors.new("draw: invalid image_fit parameters")
    }
    iw := f64(image.width)
    ih := f64(image.height)
    if fit_mode == FIT_FILL {
        source := ImageRect{x: 0.0, y: 0.0, width: iw, height: ih}
        destination := ImageRect{x: x, y: y, width: width, height: height}
        << frame.image_region(image, &source, &destination, opacity, SAMPLER_LINEAR) or >>
    }
    if fit_mode == FIT_CONTAIN {
        scale := math.min(width / iw, height / ih)
        dw := iw * scale
        dh := ih * scale
        dx := x + (width - dw) * 0.5
        dy := y + (height - dh) * 0.5
        source := ImageRect{x: 0.0, y: 0.0, width: iw, height: ih}
        destination := ImageRect{x: dx, y: dy, width: dw, height: dh}
        << frame.image_region(image, &source, &destination, opacity, SAMPLER_LINEAR) or >>
    }
    if fit_mode == FIT_COVER {
        scale := math.max(width / iw, height / ih)
        sw := math.min(iw, width / scale)
        sh := math.min(ih, height / scale)
        sx := (iw - sw) * 0.5
        sy := (ih - sh) * 0.5
        source := ImageRect{x: sx, y: sy, width: sw, height: sh}
        destination := ImageRect{x: x, y: y, width: width, height: height}
        << frame.image_region(image, &source, &destination, opacity, SAMPLER_LINEAR) or >>
    }
    // FIT_CENTER: unscaled centered crop/pad
    dw := math.min(width, iw)
    dh := math.min(height, ih)
    sx := math.max(0.0, (iw - width) * 0.5)
    sy := math.max(0.0, (ih - height) * 0.5)
    dx := x + math.max(0.0, (width - iw) * 0.5)
    dy := y + math.max(0.0, (height - ih) * 0.5)
    source := ImageRect{x: sx, y: sy, width: dw, height: dh}
    destination := ImageRect{x: dx, y: dy, width: dw, height: dh}
    << frame.image_region(image, &source, &destination, opacity, SAMPLER_LINEAR) or >>
}
