@ui/draw

#errors
#math
#strings

pub fn (c &Color) r() int { << (c.packed >> 24) & 255 }
pub fn (c &Color) g() int { << (c.packed >> 16) & 255 }
pub fn (c &Color) b() int { << (c.packed >> 8) & 255 }
pub fn (c &Color) a() int { << c.packed & 255 }

fn clamp_unit(t f64) f64 {
    if math.is_nan(t) || t <= 0.0 { << 0.0 }
    if t >= 1.0 { << 1.0 }
    << t
}

fn clamp_channel_float(v f64) int {
    if math.is_nan(v) || v <= 0.0 { << 0 }
    if v >= 255.0 { << 255 }
    << int(v + 0.5)
}

// Scales the existing alpha channel by opacity in [0, 1].
pub fn (c &Color) with_opacity(opacity f64) Color {
    scaled := f64(c.a()) * clamp_unit(opacity)
    << c.with_alpha(clamp_channel_float(scaled))
}

// Sets the alpha channel directly from a unit opacity in [0, 1].
pub fn (c &Color) opacity(alpha_unit f64) Color {
    << c.with_alpha(clamp_channel_float(clamp_unit(alpha_unit) * 255.0))
}

pub fn lerp_color(a Color, b Color, t f64) Color {
    u := clamp_unit(t)
    nr := clamp_channel_float(f64(a.r()) + (f64(b.r()) - f64(a.r())) * u)
    ng := clamp_channel_float(f64(a.g()) + (f64(b.g()) - f64(a.g())) * u)
    nb := clamp_channel_float(f64(a.b()) + (f64(b.b()) - f64(a.b())) * u)
    na := clamp_channel_float(f64(a.a()) + (f64(b.a()) - f64(a.a())) * u)
    << rgba(nr, ng, nb, na)
}

pub fn (c &Color) lighten(amount f64) Color {
    << lerp_color(Color{packed: c.packed}, rgba(255, 255, 255, c.a()), amount)
}

pub fn (c &Color) darken(amount f64) Color {
    << lerp_color(Color{packed: c.packed}, rgba(0, 0, 0, c.a()), amount)
}

fn hex_nibble(ch int) int {
    if ch >= 48 && ch <= 57 { << ch - 48 }
    if ch >= 65 && ch <= 70 { << ch - 55 }
    if ch >= 97 && ch <= 102 { << ch - 87 }
    >> errors.new("draw: invalid hex color digit")
}

fn hex_pair(raw &string, index int) int {
    hi := hex_nibble(raw[index] & 255) or >>
    lo := hex_nibble(raw[index + 1] & 255) or >>
    << (hi << 4) | lo
}

// Parses #RGB, #RGBA, #RRGGBB, or #RRGGBBAA (leading '#' is optional).
pub fn hex(code string) Color {
    trimmed := strings.trim_space(&code)
    $start := 0
    if trimmed.len > 0 && (trimmed[0] & 255) == 35 { start = 1 }
    n := trimmed.len - start
    if n == 3 {
        r := hex_nibble(trimmed[start] & 255) or >>
        g := hex_nibble(trimmed[start + 1] & 255) or >>
        b := hex_nibble(trimmed[start + 2] & 255) or >>
        << rgb((r << 4) | r, (g << 4) | g, (b << 4) | b)
    }
    if n == 4 {
        r := hex_nibble(trimmed[start] & 255) or >>
        g := hex_nibble(trimmed[start + 1] & 255) or >>
        b := hex_nibble(trimmed[start + 2] & 255) or >>
        a := hex_nibble(trimmed[start + 3] & 255) or >>
        << rgba((r << 4) | r, (g << 4) | g, (b << 4) | b, (a << 4) | a)
    }
    if n == 6 {
        r := hex_pair(&trimmed, start) or >>
        g := hex_pair(&trimmed, start + 2) or >>
        b := hex_pair(&trimmed, start + 4) or >>
        << rgb(r, g, b)
    }
    if n == 8 {
        r := hex_pair(&trimmed, start) or >>
        g := hex_pair(&trimmed, start + 2) or >>
        b := hex_pair(&trimmed, start + 4) or >>
        a := hex_pair(&trimmed, start + 6) or >>
        << rgba(r, g, b, a)
    }
    >> errors.new("draw: invalid hex color length")
}

fn hue_to_rgb(p f64, q f64, t_in f64) f64 {
    $t := t_in
    if t < 0.0 { t = t + 1.0 }
    if t > 1.0 { t = t - 1.0 }
    if t < 1.0 / 6.0 { << p + (q - p) * 6.0 * t }
    if t < 0.5 { << q }
    if t < 2.0 / 3.0 { << p + (q - p) * (2.0 / 3.0 - t) * 6.0 }
    << p
}

// Converts HSL (hue in degrees, saturation and lightness in [0, 1]) to Color.
pub fn hsla(h f64, s f64, l f64, a f64) Color {
    if math.is_nan(h) || math.is_inf(h) { << rgba(0, 0, 0, 0) }
    sat := clamp_unit(s)
    lig := clamp_unit(l)
    alp := clamp_channel_float(clamp_unit(a) * 255.0)
    if sat <= 0.000001 {
        gray := clamp_channel_float(lig * 255.0)
        << rgba(gray, gray, gray, alp)
    }
    $hue := math.mod(h, 360.0) / 360.0
    if hue < 0.0 { hue = hue + 1.0 }
    $q := lig + sat - lig * sat
    if lig < 0.5 { q = lig * (1.0 + sat) }
    p := 2.0 * lig - q
    r := clamp_channel_float(hue_to_rgb(p, q, hue + 1.0 / 3.0) * 255.0)
    g := clamp_channel_float(hue_to_rgb(p, q, hue) * 255.0)
    b := clamp_channel_float(hue_to_rgb(p, q, hue - 1.0 / 3.0) * 255.0)
    << rgba(r, g, b, alp)
}

pub fn hsl(h f64, s f64, l f64) Color {
    << hsla(h, s, l, 1.0)
}

pub fn round_stroke(width f64) StrokeOptions {
    $options := stroke_options(width)
    options.cap = CAP_ROUND
    options.join = JOIN_ROUND
    << options
}

pub fn dashed_stroke(width f64, dash_len f64, gap_len f64) StrokeOptions {
    $options := stroke_options(width)
    options.dashes = [dash_len, gap_len]
    << options
}

pub fn gradient_stop(offset f64, color Color) GradientStop {
    << GradientStop{offset: offset, color: color}
}

pub fn two_stop_linear(x1 f64, y1 f64, x2 f64, y2 f64, start_color Color, end_color Color) Gradient {
    << linear_gradient(x1, y1, x2, y2, [GradientStop{offset: 0.0, color: start_color}, GradientStop{offset: 1.0, color: end_color}])
}

pub fn two_stop_radial(cx f64, cy f64, radius f64, inner_color Color, outer_color Color) Gradient {
    << radial_gradient(cx, cy, radius, [GradientStop{offset: 0.0, color: inner_color}, GradientStop{offset: 1.0, color: outer_color}])
}
