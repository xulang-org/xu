@ui/draw

#errors
#math

pub const PALETTE_VIRIDIS = 0
pub const PALETTE_PLASMA = 1
pub const PALETTE_COOLWARM = 2
pub const PALETTE_OCEAN = 3
pub const PALETTE_SUNSET = 4
pub const PALETTE_FOREST = 5

pub fn palette_colors(kind int) []Color {
    if kind == PALETTE_PLASMA {
        << [rgb(13, 8, 135), rgb(126, 3, 168), rgb(204, 71, 120), rgb(248, 149, 64), rgb(240, 249, 33)]
    }
    if kind == PALETTE_COOLWARM {
        << [rgb(59, 76, 192), rgb(141, 176, 254), rgb(221, 221, 221), rgb(244, 154, 123), rgb(180, 4, 38)]
    }
    if kind == PALETTE_OCEAN {
        << [rgb(11, 29, 58), rgb(21, 82, 130), rgb(20, 148, 168), rgb(78, 205, 196), rgb(209, 250, 229)]
    }
    if kind == PALETTE_SUNSET {
        << [rgb(45, 27, 78), rgb(124, 45, 115), rgb(207, 68, 92), rgb(245, 130, 69), rgb(253, 216, 112)]
    }
    if kind == PALETTE_FOREST {
        << [rgb(16, 42, 32), rgb(29, 89, 58), rgb(52, 138, 82), rgb(116, 196, 118), rgb(217, 240, 163)]
    }
    // Default: PALETTE_VIRIDIS
    << [rgb(68, 1, 84), rgb(59, 82, 139), rgb(33, 145, 140), rgb(94, 201, 98), rgb(253, 231, 37)]
}

pub fn sample_color_stops(colors &[]Color, t f64) Color {
    n := colors.len
    if n == 0 { << rgba(0, 0, 0, 0) }
    if n == 1 { << colors[0] }
    u := clamp_unit(t)
    scaled := u * f64(n - 1)
    $idx := int(math.floor(scaled))
    if idx < 0 { idx = 0 }
    if idx >= n - 1 { << colors[n - 1] }
    frac := scaled - f64(idx)
    << lerp_color(colors[idx], colors[idx + 1], frac)
}

pub fn sample_palette(kind int, t f64) Color {
    stops := palette_colors(kind)
    << sample_color_stops(&stops, t)
}

pub fn multi_stop_linear(x0 f64, y0 f64, x1 f64, y1 f64, colors &[]Color) Gradient {
    n := colors.len
    if n < 2 || n > 32 { >> errors.new("draw: multi_stop_linear requires 2..32 colors") }
    $stops := []GradientStop{}
    for i in 0:n {
        stops.push(GradientStop{offset: f64(i) / f64(n - 1), color: colors[i]})
    }
    << linear_gradient(x0, y0, x1, y1, stops)
}

pub fn multi_stop_radial(cx f64, cy f64, radius f64, colors &[]Color) Gradient {
    n := colors.len
    if n < 2 || n > 32 { >> errors.new("draw: multi_stop_radial requires 2..32 colors") }
    $stops := []GradientStop{}
    for i in 0:n {
        stops.push(GradientStop{offset: f64(i) / f64(n - 1), color: colors[i]})
    }
    << radial_gradient(cx, cy, radius, stops)
}
