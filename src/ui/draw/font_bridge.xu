@ui/draw

#errors
#strings
#ui
#ui/font

// Returns a pure-Xu font stack initialized with the embedded geometric fallback face.
pub fn default_font_stack() font.FontStack {
    $stack := font.new_font_stack()
    stack.ensure_builtin_fallback(1) or >>
    << stack
}

// Parses a TrueType/OpenType font payload and registers it onto stack.
pub fn add_ttf_face(stack $&font.FontStack, ttf_bytes &[]u8, font_index int, face_id int) int {
    face := font.parse_ttf(ttf_bytes, font_index, face_id) or >>
    << stack.add_face(face) or >>
}

// Converts pure-Xu font metrics into draw.TextMetrics.
pub fn font_metrics_to_draw(m &font.TextMetrics) TextMetrics {
    << TextMetrics{
        width: m.width,
        height: m.height,
        baseline: m.baseline,
        lines: m.lines,
        ink_x: m.ink_x,
        ink_y: m.ink_y,
        ink_width: m.ink_width,
        ink_height: m.ink_height
    }
}

// Shapes UTF-8 text in pure Xu without requiring the ':xu:' native host.
pub fn layout_font_text(stack &font.FontStack, value &string, options &TextOptions, masked bool) font.TextLayout {
    norm := normalize_valid_text_options(value, options) or >>
    $fopts := font.default_options(norm.size)
    fopts.width = norm.width
    fopts.align = norm.align
    fopts.line_height = norm.line_height
    fopts.masked = masked
    if stack.face_count() > 0 {
        << font.layout_text(stack, value, &fopts) or >>
    }
    fallback := default_font_stack() or >>
    << font.layout_text(&fallback, value, &fopts) or >>
}

// Measures UTF-8 text using ':xu:' when active, or pure-Xu #ui/font when hostless.
pub fn (context &Context) measure_text_options(value &string, options &TextOptions, masked bool) TextMetrics {
    if ui.host_tmp() != ":xu:" {
        stack := default_font_stack() or >>
        ly := layout_font_text(&stack, value, options, masked) or >>
        << font_metrics_to_draw(&ly.metrics)
    }
    $layout := context.layout_text_mode(value, options, masked) or >>
    metrics := layout.metrics
    layout.dispose() or >>
    << metrics
}

// Emits positioned per-line XDF_OP_TEXT records from a pure-Xu font.TextLayout.
pub fn (frame $&Frame) text_font_layout(ly &font.TextLayout, value &string, x f64, y f64, color Color) int {
    frame.writable() or >>
    if !valid_scalar(x) || !valid_scalar(y) {
        << frame.fail("draw: invalid text position") or >>
    }
    if ly.text_len != value.len {
        << frame.fail("draw: font layout text length mismatch") or >>
    }
    for i in 0:ly.lines.len {
        line := ly.lines[i]
        if line.byte_end <= line.byte_start { -> }
        if ly.masked {
            $mb := strings.new_byte_builder((line.byte_end - line.byte_start) * 3)
            for pos in line.byte_start:line.byte_end {
                if (value[pos] & 192) != 128 {
                    mb.write_str("•")
                }
            }
            seg := mb.to_string()
            if seg.len > 0 {
                frame.text(x + line.x, y + line.y, ly.size, color, &seg) or >>
            }
        } else {
            seg := value[line.byte_start:line.byte_end]
            if seg.len > 0 {
                frame.text(x + line.x, y + line.y, ly.size, color, &seg) or >>
            }
        }
    }
    << 0
}
