pub fn (frame $&Frame) fill_ellipse_gradient(cx f64, cy f64, rx f64, ry f64, gradient &Gradient, scale f64) int {
    $path := new_path(256)
    path.ellipse(cx, cy, rx, ry) >>>
    bounds := ImageRect{x: cx - rx, y: cy - ry, width: rx * 2.0, height: ry * 2.0}
    << frame.fill_path_gradient(&path, gradient, &bounds, scale, FILL_NONZERO) >>>
}

pub fn (frame $&Frame) fill_polygon_gradient(points &[]PathPoint, gradient &Gradient, scale f64) int {
    $path := new_path(points.len * 24 + 48)
    path.polygon(points) >>>
    $min_x := points[0].x
    $min_y := points[0].y
    $max_x := min_x
    $max_y := min_y
    for i in 1:points.len {
        px := points[i].x
        py := points[i].y
        min_x = math.min(min_x, px)
        min_y = math.min(min_y, py)
        max_x = math.max(max_x, px)
        max_y = math.max(max_y, py)
    }
    w := max_x - min_x
    h := max_y - min_y
    if w <= 0.0 || h <= 0.0 {
        >> errors.new("draw: degenerate polygon bounds for gradient fill")
    }
    bounds := ImageRect{x: min_x, y: min_y, width: w, height: h}
    << frame.fill_path_gradient(&path, gradient, &bounds, scale, FILL_NONZERO) >>>
}
