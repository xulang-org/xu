    $path := new_path(256)
    path.circle(cx, cy, radius) >>>
    << frame.stroke_path(&path, color, options) >>>
}

pub fn (frame $&Frame) stroke_round_rect_styled(x f64, y f64, width f64, height f64, radius f64, color Color, options &StrokeOptions) int {
    $path := new_path(400)
    path.round_rect(x, y, width, height, radius) >>>
    << frame.stroke_path(&path, color, options) >>>
}

pub fn (frame $&Frame) dashed_round_rect(x f64, y f64, width f64, height f64, radius f64, dash_len f64, gap_len f64, color Color, line_width f64) int {
    if radius <= 0.0 {
        << frame.dashed_rect(x, y, width, height, dash_len, gap_len, color, line_width) >>>
    }
    $path := new_path(400)
    path.round_rect(x, y, width, height, radius) >>>
    options := dashed_stroke(line_width, dash_len, gap_len)
    << frame.stroke_path(&path, color, &options) >>>
}

pub fn (frame $&Frame) dashed_circle(cx f64, cy f64, radius f64, dash_len f64, gap_len f64, color Color, line_width f64) int {
    $path := new_path(256)
    path.circle(cx, cy, radius) >>>
    options := dashed_stroke(line_width, dash_len, gap_len)
    << frame.stroke_path(&path, color, &options) >>>
}

pub fn (frame $&Frame) fill_and_stroke_path(path &Path, fill_color Color, stroke_color Color, options &StrokeOptions, rule int) int {
    if fill_color.a() > 0 {
        frame.fill_path(path, fill_color, rule) >>>
    }
    if stroke_color.a() > 0 && options.width > 0.0 {
        frame.stroke_path(path, stroke_color, options) >>>
    }
    << 0
}

pub fn (frame $&Frame) fill_and_stroke_round_rect(x f64, y f64, width f64, height f64, radius f64, fill_color Color, stroke_color Color, line_width f64) int {
    $path := new_path(400)
    path.round_rect(x, y, width, height, radius) >>>
    if line_width <= 0.0 || stroke_color.a() == 0 {
        if fill_color.a() > 0 {
            << frame.fill_path(&path, fill_color, FILL_NONZERO) >>>
        }
        << 0
    }
    options := stroke_options(line_width)
    << frame.fill_and_stroke_path(&path, fill_color, stroke_color, &options, FILL_NONZERO) >>>
}

pub fn (frame $&Frame) fill_rect_gradient_scaled(x f64, y f64, width f64, height f64, gradient &Gradient, scale f64) int {
    $path := new_path(160)
    path.rect(x, y, width, height) >>>
    bounds := ImageRect{x: x, y: y, width: width, height: height}
    << frame.fill_path_gradient(&path, gradient, &bounds, scale, FILL_NONZERO) >>>
}

pub fn (frame $&Frame) fill_rect_gradient(x f64, y f64, width f64, height f64, gradient &Gradient) int {
    << frame.fill_rect_gradient_scaled(x, y, width, height, gradient, 1.0) >>>
}

