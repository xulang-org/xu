pub fn (frame $&Frame) dashed_line(x1 f64, y1 f64, x2 f64, y2 f64, dash_len f64, gap_len f64, color Color, width f64) int {
    if !valid_scalar(x1) || !valid_scalar(y1) || !valid_scalar(x2) || !valid_scalar(y2) ||
       !valid_extent(dash_len) || !valid_scalar(gap_len) || gap_len < 0.0 {
        >> errors.new("draw: invalid dashed line parameters")
    }
    if gap_len <= 0.000001 {
        << frame.line(x1, y1, x2, y2, color, width) >>>
    }
    dx := x2 - x1
    dy := y2 - y1
    total := math.hypot(dx, dy)
    if total <= 0.000001 { << 0 }
    if dash_len >= total {
        << frame.line(x1, y1, x2, y2, color, width) >>>
    }
    $path := new_path(64)
    path.move_to(x1, y1) >>>
    path.line_to(x2, y2) >>>
    options := dashed_stroke(width, math.min(dash_len, 16384.0), math.min(gap_len, 16384.0))
    << frame.stroke_path(&path, color, &options) >>>
}

pub fn (frame $&Frame) dashed_rect(x f64, y f64, width f64, height f64, dash_len f64, gap_len f64, color Color, line_width f64) int {
    $path := new_path(160)
    path.rect(x, y, width, height) >>>
    options := dashed_stroke(line_width, dash_len, gap_len)
    << frame.stroke_path(&path, color, &options) >>>
}

pub fn (frame $&Frame) arrow(x1 f64, y1 f64, x2 f64, y2 f64, head_size f64, color Color, width f64) int {
    if !valid_scalar(x1) || !valid_scalar(y1) || !valid_scalar(x2) || !valid_scalar(y2) || !valid_extent(head_size) {
        >> errors.new("draw: invalid arrow geometry")
    }
    dx := x2 - x1
    dy := y2 - y1
    length := math.sqrt(dx * dx + dy * dy)
    if length <= 0.000001 { << 0 }
    ux := dx / length
    uy := dy / length
    head := math.min(head_size, length * 0.75)
    wing := head * 0.55
    bx := x2 - ux * head
    by := y2 - uy * head
    frame.line(x1, y1, bx + ux * (head * 0.25), by + uy * (head * 0.25), color, width) >>>
    lx := bx - uy * wing
    ly := by + ux * wing
    rx := bx + uy * wing
    ry := by - ux * wing
    << frame.fill_triangle(x2, y2, lx, ly, rx, ry, color) >>>
}

pub fn (frame $&Frame) grid(x f64, y f64, width f64, height f64, cols int, rows int, color Color, line_width f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       cols < 1 || cols > 1024 || rows < 1 || rows > 1024 {
        >> errors.new("draw: invalid grid parameters")
    }
    for c in 0:(cols + 1) {
        gx := x + width * f64(c) / f64(cols)
        frame.line(gx, y, gx, y + height, color, line_width) >>>
    }
    for r in 0:(rows + 1) {
        gy := y + height * f64(r) / f64(rows)
        frame.line(x, gy, x + width, gy, color, line_width) >>>
    }
    << 0
}

pub fn (frame $&Frame) box_shadow(x f64, y f64, width f64, height f64, radius f64, offset_x f64, offset_y f64, blur f64, spread f64, color Color) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       !valid_scalar(radius) || !valid_scalar(offset_x) || !valid_scalar(offset_y) ||
       !valid_scalar(blur) || blur < 0.0 || !valid_scalar(spread) {
        >> errors.new("draw: invalid box shadow parameters")
    }
    if color.a() <= 0 { << 0 }
    if blur <= 0.000001 {
        sw := width + spread * 2.0
        sh := height + spread * 2.0
        if sw > 0.0 && sh > 0.0 {
            << frame.fill_round_rect(x + offset_x - spread, y + offset_y - spread, sw, sh, math.max(0.0, radius + spread), color) >>>
        }
        << 0
    }
    $steps := int(math.ceil(blur * 0.5))
    if steps < 4 { steps = 4 }
    if steps > 16 { steps = 16 }
    target := math.min(0.995, f64(color.a()) / 255.0)
    $total_w := 0.0
    for i in 0:steps {
        u := f64(i + 1) / f64(steps)
        total_w = total_w + u * u
    }
    $drawn := false
    for i in 0:steps {
        t := f64(steps - 1 - i) / f64(steps - 1)
        s := spread + blur * t
        sx := x + offset_x - s
        sy := y + offset_y - s
        sw := width + s * 2.0
        sh := height + s * 2.0
        if sw > 0.0 && sh > 0.0 {
            u := f64(i + 1) / f64(steps)
            w_i := u * u
            layer_a := 1.0 - math.pow_f64(1.0 - target, w_i / total_w)
            $alpha := clamp_channel_float(layer_a * 255.0)
            if i == steps - 1 && !drawn && alpha == 0 { alpha = 1 }
            if alpha > 0 {
                frame.fill_round_rect(sx, sy, sw, sh, math.max(0.0, radius + s), color.with_alpha(alpha)) >>>
                drawn = true
            }
        }
    }
    << 0
}

