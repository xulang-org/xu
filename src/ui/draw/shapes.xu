pub fn (frame $&Frame) cubic_curve(x1 f64, y1 f64, c1x f64, c1y f64, c2x f64, c2y f64, x2 f64, y2 f64, color Color, width f64) int {
    $path := new_path(128)
    path.move_to(x1, y1) or >>
    path.cubic_to(c1x, c1y, c2x, c2y, x2, y2) or >>
    options := round_stroke(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) dashed_line(x1 f64, y1 f64, x2 f64, y2 f64, dash_len f64, gap_len f64, color Color, width f64) int {
    if !valid_scalar(x1) || !valid_scalar(y1) || !valid_scalar(x2) || !valid_scalar(y2) ||
       !valid_extent(dash_len) || !valid_scalar(gap_len) || gap_len < 0.0 {
        >> errors.new("draw: invalid dashed line parameters")
    }
    if gap_len <= 0.000001 {
        << frame.line(x1, y1, x2, y2, color, width) or >>
    }
    dx := x2 - x1
    dy := y2 - y1
    total := math.sqrt(dx * dx + dy * dy)
    if total <= 0.000001 { << 0 }
    ux := dx / total
    uy := dy / total
    stride := dash_len + gap_len
    $dist := 0.0
    $steps := 0
    while dist < total && steps < 4096 {
        end_d := math.min(total, dist + dash_len)
        frame.line(x1 + ux * dist, y1 + uy * dist, x1 + ux * end_d, y1 + uy * end_d, color, width) or >>
        dist = dist + stride
        steps = steps + 1
    }
    << 0
}

pub fn (frame $&Frame) dashed_rect(x f64, y f64, width f64, height f64, dash_len f64, gap_len f64, color Color, line_width f64) int {
    $path := new_path(160)
    path.rect(x, y, width, height) or >>
    options := dashed_stroke(line_width, dash_len, gap_len)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) arrow(x1 f64, y1 f64, x2 f64, y2 f64, head_size f64, color Color, width f64) int {
    if !valid_scalar(x1) || !valid_scalar(y1) || !valid_scalar(x2) || !valid_scalar(y2) || !valid_extent(head_size) {
        >> errors.new("draw: invalid arrow geometry")
    }
    dx := x2 - x1
    dy := y2 - y1
    length := math.sqrt(dx * dx + dy * dy)
    if length <= 0.000001 { << 0 }
    ux := dx / length
    uy := dy / length
    head := math.min(head_size, length * 0.75)
    wing := head * 0.55
    bx := x2 - ux * head
    by := y2 - uy * head
    frame.line(x1, y1, bx + ux * (head * 0.25), by + uy * (head * 0.25), color, width) or >>
    lx := bx - uy * wing
    ly := by + ux * wing
    rx := bx + uy * wing
    ry := by - ux * wing
    << frame.fill_triangle(x2, y2, lx, ly, rx, ry, color) or >>
}

pub fn (frame $&Frame) grid(x f64, y f64, width f64, height f64, cols int, rows int, color Color, line_width f64) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       cols < 1 || cols > 1024 || rows < 1 || rows > 1024 {
        >> errors.new("draw: invalid grid parameters")
    }
    for c in 0:(cols + 1) {
        gx := x + width * f64(c) / f64(cols)
        frame.line(gx, y, gx, y + height, color, line_width) or >>
    }
    for r in 0:(rows + 1) {
        gy := y + height * f64(r) / f64(rows)
        frame.line(x, gy, x + width, gy, color, line_width) or >>
    }
    << 0
}

pub fn (frame $&Frame) box_shadow(x f64, y f64, width f64, height f64, radius f64, offset_x f64, offset_y f64, blur f64, spread f64, color Color) int {
    if !valid_scalar(x) || !valid_scalar(y) || !valid_extent(width) || !valid_extent(height) ||
       !valid_scalar(radius) || !valid_scalar(offset_x) || !valid_scalar(offset_y) ||
       !valid_scalar(blur) || blur < 0.0 || !valid_scalar(spread) {
        >> errors.new("draw: invalid box shadow parameters")
    }
    if color.a() <= 0 { << 0 }
    $steps := 1
    if blur > 0.0 { steps = 8 }
    for i in 0:steps {
        s := spread + blur * f64(steps - i) / f64(steps)
        sx := x + offset_x - s
        sy := y + offset_y - s
        sw := width + s * 2.0
        sh := height + s * 2.0
        if sw > 0.0 && sh > 0.0 {
            alpha := int(f64(color.a()) / f64(steps))
            if alpha > 0 {
                frame.fill_round_rect(sx, sy, sw, sh, math.max(0.0, radius + s), color.with_alpha(alpha)) or >>
            }
        }
    }
    << 0
}

pub fn (frame $&Frame) fill_rect_gradient(x f64, y f64, width f64, height f64, gradient &Gradient) int {
    $path := new_path(160)
    path.rect(x, y, width, height) or >>
    bounds := ImageRect{x: x, y: y, width: width, height: height}
    << frame.fill_path_gradient(&path, gradient, &bounds, 1.0, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) fill_round_rect_gradient(x f64, y f64, width f64, height f64, radius f64, gradient &Gradient) int {
    $path := new_path(400)
    path.round_rect(x, y, width, height, radius) or >>
    bounds := ImageRect{x: x, y: y, width: width, height: height}
    << frame.fill_path_gradient(&path, gradient, &bounds, 1.0, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) fill_circle_gradient(cx f64, cy f64, radius f64, gradient &Gradient) int {
    $path := new_path(256)
    path.circle(cx, cy, radius) or >>
    bounds := ImageRect{x: cx - radius, y: cy - radius, width: radius * 2.0, height: radius * 2.0}
    << frame.fill_path_gradient(&path, gradient, &bounds, 1.0, FILL_NONZERO) or >>
}
