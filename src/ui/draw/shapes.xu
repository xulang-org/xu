@ui/draw

#errors
#math

pub fn (frame $&Frame) fill_circle(cx f64, cy f64, radius f64, color Color) int {
    frame.set_fill(color) or >>
    << frame.circle(cx, cy, radius) or >>
}

pub fn (frame $&Frame) stroke_circle(cx f64, cy f64, radius f64, color Color, width f64) int {
    $path := new_path(256)
    path.circle(cx, cy, radius) or >>
    options := stroke_options(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) fill_ellipse(cx f64, cy f64, rx f64, ry f64, color Color) int {
    frame.set_fill(color) or >>
    << frame.ellipse(cx, cy, rx, ry) or >>
}

pub fn (frame $&Frame) stroke_ellipse(cx f64, cy f64, rx f64, ry f64, color Color, width f64) int {
    $path := new_path(256)
    path.ellipse(cx, cy, rx, ry) or >>
    options := stroke_options(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) fill_triangle(x1 f64, y1 f64, x2 f64, y2 f64, x3 f64, y3 f64, color Color) int {
    frame.set_fill(color) or >>
    << frame.triangle(x1, y1, x2, y2, x3, y3) or >>
}

pub fn (frame $&Frame) stroke_triangle(x1 f64, y1 f64, x2 f64, y2 f64, x3 f64, y3 f64, color Color, width f64) int {
    $path := new_path(160)
    path.move_to(x1, y1) or >>
    path.line_to(x2, y2) or >>
    path.line_to(x3, y3) or >>
    path.close() or >>
    options := stroke_options(width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) fill_round_rect_corners(x f64, y f64, width f64, height f64, tl f64, tr f64, br f64, bl f64, color Color) int {
    if tl <= 0.0 && tr <= 0.0 && br <= 0.0 && bl <= 0.0 {
        << frame.fill_rect(x, y, width, height, color) or >>
    }
    $path := new_path(400)
    path.round_rect_corners(x, y, width, height, tl, tr, br, bl) or >>
    << frame.fill_path(&path, color, FILL_NONZERO) or >>
}

pub fn (frame $&Frame) stroke_round_rect_corners(x f64, y f64, width f64, height f64, tl f64, tr f64, br f64, bl f64, color Color, line_width f64) int {
    if tl <= 0.0 && tr <= 0.0 && br <= 0.0 && bl <= 0.0 {
        << frame.stroke_rect(x, y, width, height, color, line_width) or >>
    }
    $path := new_path(400)
    path.round_rect_corners(x, y, width, height, tl, tr, br, bl) or >>
    options := stroke_options(line_width)
    << frame.stroke_path(&path, color, &options) or >>
}

pub fn (frame $&Frame) fill_round_rect(x f64, y f64, width f64, height f64, radius f64, color Color) int {
    << frame.fill_round_rect_corners(x, y, width, height, radius, radius, radius, radius, color) or >>
}

pub fn (frame $&Frame) stroke_round_rect(x f64, y f64, width f64, height f64, radius f64, color Color, line_width f64) int {
    << frame.stroke_round_rect_corners(x, y, width, height, radius, radius, radius, radius, color, line_width) or >>
}

pub fn (frame $&Frame) round_rect(x f64, y f64, width f64, height f64, radius f64, color Color) int {
    << frame.fill_round_rect(x, y, width, height, radius, color) or >>
}

pub fn (frame $&Frame) fill_capsule(x f64, y f64, width f64, height f64, color Color) int {
    radius := math.min(width, height) * 0.5
    << frame.fill_round_rect(x, y, width, height, radius, color) or >>
}

pub fn (frame $&Frame) stroke_capsule(x f64, y f64, width f64, height f64, color Color, line_width f64) int {
    radius := math.min(width, height) * 0.5
    << frame.stroke_round_rect(x, y, width, height, radius, color, line_width) or >>
}

