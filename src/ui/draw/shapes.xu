pub fn (frame $&Frame) fill_circle_gradient_scaled(cx f64, cy f64, radius f64, gradient &Gradient, scale f64) int {
    $path := new_path(256)
    path.circle(cx, cy, radius) >>>
    bounds := ImageRect{x: cx - radius, y: cy - radius, width: radius * 2.0, height: radius * 2.0}
    << frame.fill_path_gradient(&path, gradient, &bounds, scale, FILL_NONZERO) >>>
}

pub fn (frame $&Frame) fill_circle_gradient(cx f64, cy f64, radius f64, gradient &Gradient) int {
