@ui/webview

#ui
#errors
#encoding/hex
#strconv
#unicode/utf8

fn (wv &WebView) request_target() ui.CanvasEvent {
    if wv.window_id <= 0 || wv.generation <= 0 { >> errors.new("webview: expected a live checked window") }
    << ui.CanvasEvent{window_id: wv.window_id,canvas_id: wv.window_id,generation: wv.generation}
}
pub fn (wv &WebView) eval_async(script &string,options &ui.RequestOptions) ui.Request {
    target := wv.request_target() or >>
    << ui.webview_request_async(&target,ui.request_webview_eval,script,options) or >>
}
pub fn (wv &WebView) find_async(text &string,options &ui.RequestOptions) ui.Request {
    target := wv.request_target() or >>
    << ui.webview_request_async(&target,ui.request_webview_find,text,options) or >>
}
pub fn (wv &WebView) cookies_async(options &ui.RequestOptions) ui.Request {
    target := wv.request_target() or >>
    empty := ""
    << ui.webview_request_async(&target,ui.request_webview_cookies_get,&empty,options) or >>
}
fn cookie_request(name &string,value &string,domain &string) string {
    if name.len == 0 || name.len > 8192 || value.len > 8192 || domain.len == 0 || domain.len > 1024 { >> errors.new("webview: invalid cookie fields") }
    for field in [name + "",value + "",domain + ""] { if !utf8.valid(&field) { >> errors.new("webview: cookie fields must be UTF-8") }
        for i in 0:field.len { if (field[i] & 255) == 0 { >> errors.new("webview: cookie fields contain NUL") } } }
    << "C1\t" + hex.encode(name) + "\t" + hex.encode(value) + "\t" + hex.encode(domain)
}
pub fn (wv &WebView) set_cookie_async(name &string,value &string,domain &string,options &ui.RequestOptions) ui.Request {
    target := wv.request_target() or >>
    body := cookie_request(name,value,domain) or >>
    << ui.webview_request_async(&target,ui.request_webview_cookie_set,&body,options) or >>
}
pub fn (wv &WebView) clear_cookies_async(options &ui.RequestOptions) ui.Request {
    target := wv.request_target() or >>
    empty := ""
    << ui.webview_request_async(&target,ui.request_webview_cookies_clear,&empty,options) or >>
}
fn default_web_request(kind int,value &string) string {
    target := ui.default_canvas() or >>
    options := ui.RequestOptions{timeout_ms: 5000}
    result := ui.webview_request_wait(&target,kind,value,&options) or >>
    if result.status != ui.request_completed { >> errors.new("webview: request did not complete: " + str(result.status)) }
    << result.value + ""
}
