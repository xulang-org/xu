@ui/webview

#ui
#ui/internal/codec
#unicode/utf8
#strings
#errors
#strconv

// This identity belongs to one native document request. A reply after window
// closure, navigation, cancellation or deadline expiry is discarded by the host.
pub struct InvokeRequest {
    pub id int
    pub window_id int
    pub generation int
    pub name string
    pub payload string
}
// Snapshot the exact requesting component while this callback is active.
pub fn (request &InvokeRequest) target() ui.CanvasEvent {
    token := read_file(":xu:/__web_invoke_target/" + str(request.id)) or >>
    if token.len != 12 || codec.read_word32(&token,0) != request.window_id || codec.read_word32(&token,8) != request.generation {
        >> errors.new("webview: invoke target is no longer active")
    }
    << ui.CanvasEvent{window_id: request.window_id,canvas_id: codec.read_word32(&token,4),generation: request.generation}
}
fn dispatch_running() bool { << read_file_or_empty(":xu:/__web_dispatch_running") != "0" }
fn decode_invoke_request(packet &string) InvokeRequest {
    if packet.len < 32 || packet[0:4] != "XWI1" || codec.read_word32(packet,4) != 1 || codec.read_word32(packet,24) > 1048576 || packet.len != 32 + codec.read_word32(packet,24) { >> errors.new("webview: invalid dispatch packet") }
    body := packet[32:packet.len]
    mut name := ""
    mut payload := ""
    if body.len >= 16 && body[0:4] == "XWV1" {
        n := codec.read_word32(&body,8)
        p := codec.read_word32(&body,12)
        if n == 0 || n > 256 || n + p != body.len - 16 { >> errors.new("webview: invalid dispatch body") }
        name = body[16:16 + n]
        payload = body[16 + n:body.len]
        if !utf8.valid(&name) || !utf8.valid(&payload) { >> errors.new("webview: invalid dispatch UTF-8") }
    } else {
        name = ipc_decode_name(body + "")
        payload = ipc_decode_payload(body + "")
        if name.len == 0 { name = split_invoke(body + "")
            payload = invoke_payload(body + "") }
    }
    << InvokeRequest{id: codec.read_word64(packet,8),window_id: codec.read_word32(packet,16),generation: codec.read_word32(packet,20),name: name,payload: payload}
}
fn reply_invoke(packet &string,value string,status int) {
    if packet.len < 32 { << }
    mut output := value + ""
    mut state := status
    if output.len > 1048576 || !utf8.valid(&output) { output = "WebView response exceeds 1 MiB or is not UTF-8"
        state = 4 }
    body := packet[32:packet.len]
    if !(body.len >= 16 && body[0:4] == "XWV1") { output = ipc_encode_result(state == 0,output,"") }
    if output.len > 1048576 { output = "WebView response exceeds 1 MiB"
        state = 4 }
    mut header := strings.new_byte_builder(16)
    header.write_str("XWR1")
    codec.word(mut &header,codec.read_word64(packet,8),8)
    codec.word(mut &header,state,4)
    wire := header.to_string() + output
    write_file(":xu:/__web_invoke_reply",wire) or (err) { << }
}
fn dispatch_scoped_invoke(id int,dispatch fn(InvokeRequest) string) {
    packet := read_file_or_empty(":xu:/__web_invoke_packet/" + str(id))
    if packet.len == 0 { << }
    request := decode_invoke_request(&packet) or (err) { reply_invoke(&packet,"invalid WebView request",4)
        << }
    reply_invoke(&packet,dispatch(request),0)
}
// Runs on a Xu worker, separate from App.run(). At most 64 dispatch leases are
// active across windows. Cancelling a request does not forcibly interrupt user
// code; its lease remains occupied until that callback returns.
pub fn bind_ipc_requests_www(www_dir string,dispatch fn(InvokeRequest) string,emit_ch chan string,shell_ch chan ui.Event) int {
    stage_www_root(www_dir) or >>
    ipc_mailbox_prime()
    xu ipc_emit_drain_loop(emit_ch,shell_ch)
    while dispatch_running() {
        id := next_dispatch_id()
        if id > 0 { xu dispatch_scoped_invoke(id,dispatch) }
        else { ipc_idle_park() }
    }
    << 0
}

fn next_dispatch_id() int {
    token := read_file_or_empty(":xu:/__web_invoke_id")
    << strconv.atoi(&token) or (err) { << 0 }
}
