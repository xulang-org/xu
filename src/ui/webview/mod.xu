@ui/webview

#errors
#ui
#os
#strings
#strconv
#ui/internal/codec
#unicode/utf8

// Content backend for ui.Window: system WebView + IPC (`#ui/webview`).
// attach() registers a ContentPlugin with per-OS host sources; #ui shell picks
// the current OS at App.run(). Shell/window/menu/tray stay in #ui.
//
// two content modes (no local HTTP server in either):
//   1. Local — stage_www_root / bind_ipc_www + xu://app/ (scheme flag "xu"; host intercepts).
//      Packed oneexe sets XU_UI_WWW=:mem: and serves www/icon from the binary (no TEMP extract).
//   2. Remote — load_url("http(s)://…"); we do not serve that origin. Adapted remote pages
//      may still call xu://app/__xu/* (and optional xu://app/ static) into the app.
// UI host must be statically linked (pack_*ui_oneexe.py); no external host process.

// Maximum WebView invoke request body accepted from IPC, in bytes.
const MAX_INVOKE_BODY_BYTES = 65536
// Maximum WebView event queue read for delivery to the host, in bytes.
const MAX_EMIT_QUEUE_BYTES = 1048576

pub struct WebView {
    generation int
    pub id int
    pub window_id int
    pub html string
    pub url string
    pub ipc_names []string
    pub emit_q []string
    pub sim int
}

pub fn attach(w &mut ui.Window) WebView {
    id := w.id
    _ := ui.register_content_plugin(ui.content_plugin_webview())
    w.bind_content(ui.CONTENT_WEBVIEW,id) or (err) { << WebView{generation: 0,id: 0,window_id: 0,html: "",url: "",ipc_names: []string{},emit_q: []string{},sim: 0} }
    << WebView{generation: w.generation,id: id, window_id: w.id, html: "", url: "", ipc_names: []string{}, emit_q: []string{}, sim: 0}
}

fn require_wv_host() int {
    os := ui.target_os()
    if os != ui.OS_MACOS && os != ui.OS_LINUX && os != ui.OS_WINDOWS {
        >> errors.new("webview: unsupported on this target")
    }
    if env_get("XU_UI_SIM") == "1" {
        << 1
    }
    if !ui.host_enabled() {
        >> errors.new("webview: host not available")
    }
    << 2
}

// Same mailbox as #ui host. Pack → ":xu:"; real XU_UI_TMP only for non-pack/dev.
fn wv_tmp() string {
    d := env_get("XU_UI_TMP")
    if d.len > 0 && d != ":xu:" && d != ":mem:" {
        << d + ""
    }
    if env_get("XU_UI_PACK") == "1" || env_get("XU_UI_WWW") == ":mem:" {
        << ":xu:"
    }
    << tmp_dir()
}

fn worker_trace(step string) {
    // Pack: no disk worker trace (mailbox-only). Optional when XU_UI_TMP is a real dir.
    d := env_get("XU_UI_TMP")
    if d.len == 0 || d == ":xu:" {
        <<
    }
    _ := write_file(d + "/xu_worker_trace.txt", step + "\n") or (err) {
        <<
    }
}

fn page_html_path() string {
    << wv_tmp() + "/xu_ui_page.html"
}

fn page_url_path() string {
    << wv_tmp() + "/xu_ui_page.url"
}

fn ipc_req_path() string {
    << wv_tmp() + "/xu_ui_ipc_req.txt"
}

fn ipc_resp_path() string {
    << wv_tmp() + "/xu_ui_ipc_resp.txt"
}

fn emit_q_path() string {
    << wv_tmp() + "/xu_ui_emit_q.txt"
}

fn scheme_flag_path() string {
    << wv_tmp() + "/xu_ui_scheme.txt"
}

fn www_root_flag_path() string {
    << wv_tmp() + "/xu_ui_www_root.txt"
}

fn bridge_js_path() string {
    << wv_tmp() + "/xu_ui_bridge.js"
}

pub fn www_root_path() string {
    << www_root_flag_path()
}

fn www_has_index(dir &string) bool {
    _ := read_file(dir + "/index.html") or (err) {
        << false
    }
    << true
}

fn abs_www_dir(dir &string) string {
    d := dir + ""
    if d.len == 0 {
        << d
    }
    b0 := d[0] & 255
    if b0 == 47 {
        << d
    }
    // Windows drive: C:\ or C:/
    if d.len >= 3 {
        b1 := d[1] & 255
        b2 := d[2] & 255
        if b1 == 58 && (b2 == 92 || b2 == 47) {
            << d
        }
    }
    wd := os.getwd()
    if wd.len == 0 {
        << d
    }
    << wd + "/" + d
}

fn pack_www_mem() bool {
    env := env_get("XU_UI_WWW")
    if env == ":mem:" {
        << true
    }
    if env_get("XU_UI_PACK") == "1" {
        << true
    }
    << false
}

// Resolve www dir: pack/:mem: always wins (never materialize www/ under TEMP).
// Else: XU_UI_WWW path > explicit dir with index.html > ./www/index.html.
pub fn resolve_www_dir(want string) string {
    if pack_www_mem() {
        << ":mem:"
    }
    env := env_get("XU_UI_WWW")
    if env == ":mem:" {
        << ":mem:"
    }
    if env.len > 0 {
        if !www_has_index(&env) {
            >> errors.new("webview: XU_UI_WWW missing index.html: " + env)
        }
        << abs_www_dir(&env)
    }
    if want == ":mem:" {
        << ":mem:"
    }
    if want.len > 0 && www_has_index(&want) {
        << abs_www_dir(&want)
    }
    w := "www"
    if www_has_index(&w) {
        << abs_www_dir(&w)
    }
    // Packed oneexe / missing disk tree: host serves xu_pack_www_files from the binary.
    << ":mem:"
}

fn ensure_bridge_ref(dir &string) int {
    d := dir + ""
    if d == ":mem:" {
        << 0
    }
    idx_path := d + "/index.html"
    body := read_file(idx_path) or >>
    // Page may mention window.__XU__ without loading the bridge — require explicit script.
    if strings.contains(&body, "__xu/bridge") {
        << 0
    }
    tag := "<script src=\"xu://app/__xu/bridge.js\"></script>\n"
    mut out := body + ""
    if strings.contains(&out, "</head>") {
        out = strings.replace(&out, "</head>", tag + "</head>", 1)
    } else {
        out = tag + out
    }
    // Staged index overlay under TMP; host prefers it for / and /index.html.
    write_file(wv_tmp() + "/xu_ui_www_index.html", out) or >>
    << 0
}

pub fn stage_www_root(dir0 string) int {
    dir := resolve_www_dir(dir0) or >>
    write_file(www_root_flag_path(), dir + "") or >>
    write_file(page_url_path(), app_scheme_url()) or >>
    write_file(scheme_flag_path(), "xu") or >>
    if dir == ":mem:" {
        // Pack serves www + __xu/bridge.js from PE. Do not write www tree / bridge / brand to TEMP.
        << 0
    }
    // Dev / disk www: bridge file for host inject + optional brand copy.
    write_file(bridge_js_path(), bridge_script()) or >>
    ovr := write_file(wv_tmp() + "/xu_ui_www_index.html", "") or (err) {
        << 0
    }
    if ovr < 0 {
    }
    br := ensure_bridge_ref(&dir) or (err) {
        << 0
    }
    if br < 0 {
    }
    if wv_tmp() != ":xu:" {
        write_file(ipc_req_path(), "") or >>
        write_file(ipc_resp_path(), "") or >>
        write_file(emit_q_path(), "") or >>
    }
    // Fallback single-file page (host uses if www miss).
    idx := read_file(dir + "/index.html") or (err) {
        << 0
    }
    pg := write_file(page_html_path(), idx) or (err) {
        << 0
    }
    if pg < 0 {
    }
    mk := os.mkdir_all(wv_tmp() + "/brand") or (err) {
        << 0
    }
    if mk < 0 {
    }
    stage_brand_named("xu_app_logo.png")
    stage_brand_named("xu_app_icon.png")
    stage_brand_named("xu_classic.svg")
    stage_brand_named("xu_classic.png")
    stage_brand_named("icon.png")
    << 0
}

fn stage_page_and_assets(page string) int {
    // Compat: materialize inline HTML as a one-file www tree under TMP.
    base := wv_tmp() + "/xu_ui_www"
    mk2 := os.mkdir_all(base + "") or (err) {
        << 0
    }
    if mk2 < 0 {
    }
    write_file(base + "/index.html", page + "") or >>
    << stage_www_root(base + "") or >>
}

// --- XUN wire format for IPC (https://github.com/qorm/xun) ---
// Request / emit event:
//   name: ping
//   payload: hi
// Response:
//   ok: true
//   result: pong:hi

fn xun_needs_s_tag(s string) bool {
    if s.len == 0 {
        << true
    }
    mut i := 0
    while i < s.len {
        b := s[i] & 255
        if b == 10 || b == 13 || b == 9 || b == 35 || b == 58 {
            << true
        }
        if i == 0 && (b == 32 || b == 33 || b == 64 || b == 36) {
            << true
        }
        i = i + 1
    }
    << false
}

fn xun_scalar(s string) string {
    t := s + ""
    if xun_needs_s_tag(t + "") {
        << "!s " + t
    }
    << t + ""
}

pub fn ipc_encode_xun(name string, payload string) string {
    << "name: " + xun_scalar(name) + "\npayload: " + xun_scalar(payload) + "\n"
}

pub fn ipc_encode_result(ok bool, result string, err string) string {
    if ok {
        << "ok: true\nresult: " + xun_scalar(result) + "\n"
    }
    << "ok: false\nerror: " + xun_scalar(err) + "\n"
}

fn ipc_line_field(line0 string, key string) string {
    line := trim_shell_cr(line0 + "")
    // Strip leading spaces (host/bridge never indent; tolerate anyway).
    mut s := line + ""
    while s.len > 0 {
        b := s[0] & 255
        if b == 32 || b == 9 {
            s = s[1:s.len]
        } else {
            <-
        }
    }
    pref := key + ": "
    if s.len >= pref.len {
        mut ok := true
        mut i := 0
        while i < pref.len {
            if (s[i] & 255) != (pref[i] & 255) {
                ok = false
                <-
            }
            i = i + 1
        }
        if ok {
            v := s[pref.len:s.len]
            if v.len >= 3 {
                if (v[0] & 255) == 33 && (v[1] & 255) == 115 && (v[2] & 255) == 32 {
                    << v[3:v.len]
                }
            }
            << v
        }
    }
    pref2 := key + ":"
    if s == pref2 {
        << ""
    }
    << ""
}

// IPC wire format is a tiny XUN subset (name/payload/ok/result/error lines).
// Do NOT run the full encoding/xun tree parser here — untrusted/misrouted
// bodies (HTML, JS, binary) have caused index-OOB in Doc accessors on Windows.
fn ipc_decode_field(raw0 &string, key string) string {
    raw := raw0 + ""
    if raw.len == 0 {
        << ""
    }
    mut i := 0
    mut start := 0
    while i <= raw.len {
        mut hit := false
        if i == raw.len {
            hit = true
        } else {
            b := raw[i] & 255
            if b == 10 || b == 13 {
                hit = true
            }
        }
        if hit {
            if i > start {
                v := ipc_line_field(raw[start:i], key)
                // Distinguish "missing key" from "key: " empty value: check prefix.
                line := trim_shell_cr(raw[start:i])
                mut s := line + ""
                while s.len > 0 {
                    b0 := s[0] & 255
                    if b0 == 32 || b0 == 9 {
                        s = s[1:s.len]
                    } else {
                        <-
                    }
                }
                pref := key + ":"
                if s.len >= pref.len {
                    mut matched := true
                    mut j := 0
                    while j < pref.len {
                        if (s[j] & 255) != (pref[j] & 255) {
                            matched = false
                            <-
                        }
                        j = j + 1
                    }
                    if matched {
                        << v
                    }
                }
            }
            if i < raw.len {
                b := raw[i] & 255
                i = i + 1
                if b == 13 && i < raw.len {
                    if (raw[i] & 255) == 10 {
                        i = i + 1
                    }
                }
            } else {
                i = i + 1
            }
            start = i
        } else {
            i = i + 1
        }
    }
    << ""
}

pub fn ipc_decode_name(raw string) string {
    << ipc_decode_field(&raw, "name")
}

pub fn ipc_decode_payload(raw string) string {
    << ipc_decode_field(&raw, "payload")
}

pub fn ipc_decode_result(raw string) string {
    // Prefer simple line decode; fall back to raw text for diagnostics.
    ok := ipc_decode_field(&raw, "ok")
    if ok == "false" || ok == "0" {
        e := ipc_decode_field(&raw, "error")
        if e.len > 0 {
            << e
        }
        << "error"
    }
    r := ipc_decode_field(&raw, "result")
    if r.len > 0 || ok == "true" || ok == "1" {
        << r
    }
    << raw + ""
}

// Same-origin xu://app bridge; bodies are XUN documents.
// macOS: WKScriptMessageHandlerWithReply (postMessage → Promise). Emit is host-pushed.
pub fn bridge_script() string {
    // Generated from host/xu_webview_bridge.js.
    << "/* Embedded by sync_ui_webview_bridge.py; keep bridge and native protocol together. */\nwindow.__XU__=window.__XU__||{};\n(function(X){\n  'use strict';\n  var B='xu://app/__xu',pending=new Map(),listeners=new Map(),closed=false;\n  var encoder=new TextEncoder(),decoder=new TextDecoder('utf-8',{fatal:true});\n  function error(name,message){var e=new Error(message);e.name=name;return e;}\n  X._deliver=function(name,payload){var callback=listeners.get(name);if(callback)try{callback(payload);}catch(e){setTimeout(function(){throw e;},0);}};\n  X._accept=function(text){var o={};String(text||'').split('\\n').forEach(function(line){var i=line.indexOf(': ');if(i>0){var value=line.slice(i+2);o[line.slice(0,i)]=value.indexOf('!s ')===0?value.slice(3):value;}});if(o.name!=null)X._deliver(o.name,o.payload||'');};\n  X.listen=function(name,callback){if(typeof callback!=='function')throw new TypeError('listener must be a function');name=String(name);listeners.set(name,callback);return function(){if(listeners.get(name)===callback)listeners.delete(name);};};\n  X.invoke=function(name,payload,options){\n    options=options||{};var timeout=options.timeoutMs==null?30000:Number(options.timeoutMs),signal=options.signal;\n    if(closed)return Promise.reject(error('AbortError','page closed'));\n    if(pending.size>=64)return Promise.reject(error('QuotaExceededError','64 requests already pending'));\n    if(!Number.isInteger(timeout)||timeout<1||timeout>3600000)return Promise.reject(new RangeError('timeoutMs must be 1..3600000'));\n    if(signal&&signal.aborted)return Promise.reject(error('AbortError','request cancelled'));\n    var n=encoder.encode(String(name==null?'':name)),p=encoder.encode(String(payload==null?'':payload));\n    if(!n.length||n.length>256||16+n.length+p.length>1048576)return Promise.reject(new RangeError('invoke exceeds the 1 MiB request limit'));\n    var random=new Uint8Array(16);crypto.getRandomValues(random);var id=Array.from(random,function(b){return b.toString(16).padStart(2,'0');}).join('');\n    var body=new Uint8Array(16+n.length+p.length),view=new DataView(body.buffer);\n    body.set([88,87,86,49]);view.setUint32(4,timeout,true);view.setUint32(8,n.length,true);view.setUint32(12,p.length,true);body.set(n,16);body.set(p,16+n.length);\n    var controller=new AbortController(),settled=false,timer,abortListener,resolve,reject;\n    var promise=new Promise(function(a,b){resolve=a;reject=b;});\n    function finish(failed,value){if(settled)return false;settled=true;pending.delete(id);clearTimeout(timer);if(signal&&abortListener)signal.removeEventListener('abort',abortListener);if(failed)reject(value);else resolve(value);return true;}\n    function cancel(name){if(settled)return false;fetch(B+'/cancel2/'+id,{method:'POST'}).catch(function(){});controller.abort();return finish(true,error(name||'AbortError',name==='TimeoutError'?'request timed out':'request cancelled'));}\n    promise.id=id;promise.cancel=function(){return cancel('AbortError');};pending.set(id,promise);\n    timer=setTimeout(function(){cancel('TimeoutError');},timeout);\n    if(signal){abortListener=function(){cancel('AbortError');};signal.addEventListener('abort',abortListener,{once:true});}\n    fetch(B+'/invoke2/'+id,{method:'POST',headers:{'Content-Type':'application/octet-stream'},body:body,signal:controller.signal}).then(function(response){return response.arrayBuffer();}).then(function(buffer){\n      if(settled)return;var bytes=new Uint8Array(buffer),v=new DataView(buffer);\n      if(bytes.length<12||decoder.decode(bytes.subarray(0,4))!=='XWO1'||v.getUint32(8,true)!==bytes.length-12)throw new Error('invalid native response');\n      var status=v.getUint32(4,true),value=decoder.decode(bytes.subarray(12));\n      if(status)finish(true,error(status===1?'AbortError':status===2?'TimeoutError':'Error',value||'native request failed'));else finish(false,value);\n    }).catch(function(e){finish(true,e);});\n    return promise;\n  };\n  addEventListener('pagehide',function(){closed=true;Array.from(pending.values()).forEach(function(p){p.cancel();});});\n  addEventListener('pageshow',function(){closed=false;});\n  window.invoke=X.invoke;window.listen=X.listen;\n})(window.__XU__);\n"
}

pub fn app_scheme_url() string {
    << "xu://app/"
}

// Deprecated: TCP IPC address (use bind_ipc + xu://app/).
pub fn default_ipc_addr() string {
    << "127.0.0.1:19287"
}

pub fn default_ipc_port() string {
    << "19287"
}

pub fn (wv &mut WebView) load_html(html string) int {
    mode := require_wv_host() or >>
    wv.html = html + ""
    wv.url = ""
    if mode == 2 {
        ui.write_window_slot(wv.window_id,wv.generation,"xu_ui_page.html",html) or >>
        ui.write_window_slot(wv.window_id,wv.generation,"xu_ui_page.url","") or >>
    }
    wv.sim = 1
    << 0
}

pub fn (wv &mut WebView) load_url(url string) int {
    mode := require_wv_host() or >>
    wv.url = url + ""
    wv.html = ""
    if mode == 2 {
        ui.write_window_slot(wv.window_id,wv.generation,"xu_ui_page.url",url) or >>
        // Remote http(s): clear local-scheme flag so host does not force xu://app/.
        if starts_with(url, "http://") || starts_with(url, "https://") {
            if !starts_with(url, "http://app.xu") && !starts_with(url, "https://app.xu") {
                ui.write_window_slot(wv.window_id,wv.generation,"xu_ui_scheme.txt","") or >>
                ui.write_window_slot(wv.window_id,wv.generation,"xu_ui_page.html","") or >>
                wv.sim = 1
                << 0
            }
        }
        // xu://app/ (local intercept) — do not wipe www / staged page.
        if !starts_with(url, "xu://") && !starts_with(url, "http://app.xu") {
            ui.write_window_slot(wv.window_id,wv.generation,"xu_ui_page.html","") or >>
        }
    }
    wv.sim = 1
    << 0
}

// load_remote: remote HTTP(S) document; Xu does not host it. xu:// IPC still available to adapted pages.
pub fn (wv &mut WebView) load_remote(url string) int {
    << wv.load_url(url) or >>
}

pub fn (wv &mut WebView) load_file(path string) int {
    body := ui.load_asset(path) or >>
    << wv.load_html(body) or >>
}

fn eval_js_path() string {
    << wv_tmp() + "/xu_ui_eval.js"
}

// Queue JS for the native WKWebView host (file bridge). No-op under XU_UI_SIM=1.
pub fn native_eval(js string) int {
    if env_get("XU_UI_SIM") == "1" {
        << 0
    }
    write_file(eval_js_path(),js + "") or >>
    << 0
}

