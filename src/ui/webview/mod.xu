// Returns lines "name=value;domain=…;path=…".
pub fn native_cookies_get() string {
    if !ui.host_enabled() {
        << ""
    }
    write_file(ui.host_tmp() + "/xu_ui_cookies.txt", "__XU_COOKIES_PENDING__") or (err) {
        << ""
    }
    _ := ui.append_wv_cmd("cookies_get") or (err) {
        << ""
    }
    mut i := 0
    while i < 40 {
        sleep_ns(100000000)
        body := read_file(ui.host_tmp() + "/xu_ui_cookies.txt") or (err) {
            << ""
        }
        if body != "__XU_COOKIES_PENDING__" {
            << body
        }
        i = i + 1
    }
    << ""
}

