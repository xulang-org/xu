// Returns lines "name=value;domain=…;path=…".
pub fn native_cookies_get() string {
    empty := ""
    << default_web_request(ui.REQUEST_WEBVIEW_COOKIES_GET,&empty) or (err) { << "" }
}

pub fn native_cookies_clear() int {
    empty := ""
    _ := default_web_request(ui.REQUEST_WEBVIEW_COOKIES_CLEAR,&empty) or (err) { << -1 }
    << 0
}

pub fn native_cookie_set(name string, value string, domain string) int {
    mut target := domain + ""
    if target.len == 0 { target = "127.0.0.1" }
    body := cookie_request(&name,&value,&target) or (err) { << -1 }
    _ := default_web_request(ui.REQUEST_WEBVIEW_COOKIE_SET,&body) or (err) { << -1 }
    << 0
}


pub fn (wv &mut WebView) eval(js string) string {
    target := wv.request_target() or >>
    options := ui.RequestOptions{timeout_ms: 5000}
    result := ui.webview_request_wait(&target,ui.REQUEST_WEBVIEW_EVAL,&js,&options) or >>
    if result.status != ui.REQUEST_COMPLETED { >> errors.new("webview: evaluation failed") }
    << result.value + ""
}

pub fn (wv &mut WebView) on(name string) {
    wv.ipc_names.push(name + "")
}

pub fn (wv &mut WebView) invoke(name string, payload string, dispatch fn(string, string) string) string {
    n := wv.ipc_names.len
    if n < 0 {
        << ""
    }
    << dispatch(name, payload)
}

pub fn bus_emit(emit_ch chan string, name string, payload string) {
    emit_ch <- ipc_encode_xun(name, payload)
}

fn append_native_record(record string, wait bool) int {
    if wv_tmp() != ":xu:" { >> errors.new("webview: native notifications require the in-process host") }
    protocol := read_file(":xu:/__ui_protocol") or >>
    if protocol != "XUI2" { >> errors.new("webview: notification host protocol is unavailable") }
    if record.len == 0 || record.len > MAX_EMIT_QUEUE_BYTES { >> errors.new("webview: notification is too large") }
    mut path := ":xu:/__emit_append"
    if wait { path = ":xu:/__emit_append_wait" }
    accepted := write_file(path, record) or >>
    if accepted != record.len { >> errors.new("webview: notification queue rejected the record") }
    << 0
}

// Nonblocking enqueue. A full/closed queue or oversize record returns an error.
// The existing XUN payload format is retained; record boundaries are atomic.
pub fn native_emit(name string, payload string) int {
    << append_native_record(ipc_encode_xun(name, payload), false) or >>
}

pub fn retry_emit(event &ui.Event) int {
    if event.kind != ui.EV_EMIT_FAILED { >> errors.new("webview: expected an emit failure") }
    << append_native_record(event.menu_id + "", false) or >>
}

pub fn (wv &mut WebView) emit(name string, payload string) int {
    js := "window.__XU_EMIT__&&window.__XU_EMIT__(" + json_str(name) + "," + json_str(payload) + ");"
    wv.emit_q.push(js)
    << 0
}

pub fn (wv &mut WebView) emit_pending_count() int {
    << wv.emit_q.len
}

pub fn (wv &mut WebView) clear_emits() {
    wv.emit_q = []string{}
}

fn json_str(s string) string {
    << "\"" + s + "\""
}

fn path_only(p string) string {
    mut i := 0
    while i < p.len {
        if (p[i] & 255) == 63 {
            << p[0:i]
        }
        i = i + 1
    }
    << p + ""
}

fn split_invoke(body string) string {
    mut i := 0
    while i < body.len {
        if (body[i] & 255) == 10 {
            << body[0:i]
        }
        i = i + 1
    }
    << body + ""
}

fn invoke_payload(body string) string {
    mut i := 0
    while i < body.len {
        if (body[i] & 255) == 10 {
            << body[(i + 1):body.len]
        }
        i = i + 1
    }
    << ""
}

fn shell_event_path() string {
    << wv_tmp() + "/xu_ui_shell_event.txt"
}

fn trim_shell_cr(s string) string {
    mut out := s + ""
    while out.len > 0 {
        c := out[out.len - 1] & 255
        if c == 13 {
            out = out[0:out.len - 1]
        } else {
            <-
        }
    }
    << out
}

fn push_shell_payload(shell_ch chan ui.Event, pl0 string) {
    pl := trim_shell_cr(pl0 + "")
    if pl.len > 0 {
        mut preview := pl + ""
        if preview.len > 48 {
            preview = preview[0:48]
        }
        worker_trace("push_shell [" + preview + "]")
    }
    ui.push_host_event(shell_ch, pl0)
}

fn stage_brand_named(name string) {
    body := read_file_or_empty("brand/" + name)
    if body.len == 0 {
        <<
    }
    w := write_file(wv_tmp() + "/brand/" + name, body) or (err) {
        <<
    }
    if w < 0 {
    }
}

fn read_file_or_empty(path string) string {
    body := read_file(path) or (err) {
        << ""
    }
    << body
}

fn ipc_idle_park() {
    // Invoke-only park; the host bridges notifications across predicate/wait.
    n := write_file(":xu:/__ipc_wait", "50") or (err) {
        sleep_ns(10000000)
        <<
    }
    if n == 0 {
        sleep_ns(10000000)
    }
}

// The registry retains a dispatch lease after cancellation until this worker
// returns, so cancelling slow handlers cannot create unbounded worker tasks.
fn dispatch_web_request(id int,dispatch fn(string,string) string) {
    packet := read_file_or_empty(":xu:/__web_invoke_packet/" + str(id))
    if packet.len == 0 { << }
    request := decode_invoke_request(&packet) or (err) { reply_invoke(&packet,"invalid WebView request",4)
        << }
    reply_invoke(&packet,dispatch(request.name,request.payload),0)
}

fn process_one_invoke(dispatch fn(string, string) string, emit_ch chan string, shell_ch chan ui.Event) {
    id := next_dispatch_id()
    if id > 0 { xu dispatch_web_request(id,dispatch)
        << }
    // Scheme invoke: Host xu_ui_invoke_sync ↔ __invoke_take / __invoke_reply (no req/resp files).
    mut sync := 0
    mut raw := read_file_or_empty(":xu:/__invoke_take")
    if raw.len > 0 {
        sync = 1
    } else {
        // Legacy: menu/tray may still post xu_ui_ipc_req.txt
        raw = read_file_or_empty(ipc_req_path())
        if raw.len == 0 {
            <<
        }
        write_file(ipc_req_path(), "") or (err) {
            <<
        }
    }
    // Cap runaway bodies (misrouted HTML/binary must not enter decode).
    if raw.len > MAX_INVOKE_BODY_BYTES {
        worker_trace("invoke reject huge len=" + str(raw.len))
        enc := ipc_encode_result(false, "", "invoke body too large")
        if sync == 1 {
            write_file(":xu:/__invoke_reply", enc) or (err) { << }
        } else {
            write_file(ipc_resp_path(), enc) or (err) { << }
        }
        <<
    }
    mut preview := raw + ""
    if preview.len > 80 {
        preview = preview[0:80]
    }
    worker_trace("invoke len=" + str(raw.len) + " preview=[" + preview + "]")
    raw = trim_shell_cr(raw + "")
    worker_trace("invoke decode")
    mut name := ipc_decode_name(raw + "")
    mut payload := ipc_decode_payload(raw + "")
    // Legacy fallback: name\\npayload (pre-XUN).
    if name.len == 0 {
        name = split_invoke(raw + "")
        payload = invoke_payload(raw + "")
        // If legacy split returned the whole blob as "name", treat as unknown.
        if name.len > 64 || strings.contains(&name, "<") || strings.contains(&name, "{") {
            name = ""
            payload = ""
        }
    }
    name = trim_shell_cr(name + "")
    payload = trim_shell_cr(payload + "")
    worker_trace("invoke name=[" + name + "]")
    is_menu := name == "menu"
    is_tray := name == "tray"
    is_shell := name == "shell"
    worker_trace("invoke dispatch")
    out := dispatch(name + "", payload + "")
    worker_trace("invoke dispatched")
    if is_menu || is_tray {
        mut kind := ui.EV_MENU_CLICKED
        if is_tray {
            kind = ui.EV_TRAY_MENU_CLICKED
        }
        mid := payload + ""
        shell_ch <- ui.Event{kind: kind, window_id: 0, menu_id: mid, width: 0, height: 0}
        select {
            emit_ch <- ipc_encode_xun(name + "", payload + "") {
            }
            else {
            }
        }
    }
    if is_shell {
        push_shell_payload(shell_ch, payload + "")
    }
    enc := ipc_encode_result(true, out + "", "")
    if sync == 1 {
        write_file(":xu:/__invoke_reply", enc) or (err) {
            <<
        }
    } else {
        write_file(ipc_resp_path(), enc) or (err) {
            <<
        }
    }
    worker_trace("invoke done")
}

fn report_emit_failure(msg &string, reason int, shell_ch chan ui.Event) {
    shell_ch <- ui.Event{kind: ui.EV_EMIT_FAILED, window_id: 0, menu_id: *msg + "", width: msg.len, height: reason}
}

fn write_emit_record(msg string, shell_ch chan ui.Event) {
    if msg.len > MAX_EMIT_QUEUE_BYTES {
        report_emit_failure(&msg, 1, shell_ch)
        <<
    }
    if wv_tmp() == ":xu:" {
        // Wait for bounded native capacity on this dedicated emit worker.
        // The message remains owned here and the channel supplies backpressure.
        append_native_record(msg + "", true) or (err) {
            report_emit_failure(&msg, 2, shell_ch)
            <<
        }
        <<
    }
    // Explicit file mode remains a development compatibility path.
    cur := read_file_or_empty(emit_q_path())
    if cur.len + msg.len + 1 > MAX_EMIT_QUEUE_BYTES {
        report_emit_failure(&msg, 2, shell_ch)
        <<
    }
    write_file(emit_q_path(), cur + (msg + "") + string_from_byte(30)) or (err) {
        report_emit_failure(&msg, 2, shell_ch)
        <<
    }
}

fn ipc_mailbox_prime() {
    // A live in-process host may already have published input or requests.
    if wv_tmp() == ":xu:" { << }
    // Ensure ":xu:" slots exist so idle poll does not hit missing-slot paths.
    write_file(shell_event_path(), "") or (err) { << }
    write_file(ipc_req_path(), "") or (err) { << }
    write_file(ipc_resp_path(), "") or (err) { << }
    write_file(emit_q_path(), "") or (err) { << }
}

// bind_ipc_www: #ui/webview xu://app/ scheme intercept. Host serves static files from www_dir;
// this loop handles XUN invoke + emit (no TCP listen in Xu).
// Host shell events are pumped by #ui (new_app / new_app_events), not here.
fn ipc_emit_drain_loop(emit_ch chan string, shell_ch chan ui.Event) {
    while true {
        msg := <-emit_ch
        if msg.len == 0 { << }
        write_emit_record(msg, shell_ch)
    }
}

pub fn bind_ipc_www(www_dir string, dispatch fn(string, string) string, emit_ch chan string, shell_ch chan ui.Event) int {
    worker_trace("bind_ipc_www begin")
    stage_www_root(www_dir) or >>
    ipc_mailbox_prime()
    // Emit drain MUST NOT share the invoke thread.
    xu ipc_emit_drain_loop(emit_ch, shell_ch)
    worker_trace("bind_ipc_www loop")
    while true {
        if !dispatch_running() { <- }
        process_one_invoke(dispatch, emit_ch, shell_ch)
        ipc_idle_park()
    }
    << 0
}

// bind_ipc: inline HTML → TMP www/index.html, then same as bind_ipc_www.
pub fn bind_ipc(page string, dispatch fn(string, string) string, emit_ch chan string, shell_ch chan ui.Event) int {
    stage_page_and_assets(page) or >>
    ipc_mailbox_prime()
    xu ipc_emit_drain_loop(emit_ch, shell_ch)
    while true {
        if !dispatch_running() { <- }
        process_one_invoke(dispatch, emit_ch, shell_ch)
        ipc_idle_park()
    }
    << 0
}

// Deprecated: TCP listen IPC. Use bind_ipc_www / bind_ipc + xu://app/.
pub fn serve_ipc(addr string, page string, dispatch fn(string, string) string, emit_ch chan string, shell_ch chan ui.Event) int {
    >> errors.new("webview: serve_ipc removed; use bind_ipc_www + xu://app/")
}
