@ui

#errors
#math
#unicode
#unicode/utf8

pub struct TextRange {
    pub start int
    pub end int
}

pub fn clipboard_primary_modifier() int {
    if target_os() == OS_MACOS { << MOD_META }
    << MOD_CONTROL
}

pub fn is_clipboard_modifier(modifiers int) bool {
    if (modifiers & MOD_ALT) != 0 { << false }
    if target_os() == OS_NONE { << (modifiers & (MOD_CONTROL | MOD_META)) != 0 }
    << (modifiers & clipboard_primary_modifier()) != 0
}

pub struct ClickTracker {
    last_ns int
    last_x f64
    last_y f64
    last_button int
    streak int
}

pub fn click_tracker() ClickTracker {
    << ClickTracker{last_ns: 0,last_x: 0.0,last_y: 0.0,last_button: 0,streak: 0}
}

pub fn (t $&ClickTracker) reset() {
    t.last_ns = 0
    t.last_x = 0.0
    t.last_y = 0.0
    t.last_button = 0
    t.streak = 0
}

// Track single, double, and triple clicks consistently across hosts, including
// platforms whose native double-click resets click_count on the third press.
pub fn (t $&ClickTracker) record(event &InputEvent) int {
    if event.button != BUTTON_LEFT {
        t.reset()
        << 1
    }
    same_spot := t.last_button == event.button && math.abs(event.x - t.last_x) <= 6.0 && math.abs(event.y - t.last_y) <= 6.0
    within_time := event.time_ns > 0 && t.last_ns > 0 && event.time_ns >= t.last_ns && event.time_ns - t.last_ns <= 500000000
    $count := 1
    if event.click_count >= 2 {
        $reported := event.click_count
        if same_spot && within_time && t.streak >= 3 { reported = t.streak + 1 }
        count = ((reported - 1) % 3) + 1
    } else if same_spot && within_time && t.streak >= 1 {
        count = (t.streak % 3) + 1
    }
    t.last_ns = event.time_ns
    t.last_x = event.x
    t.last_y = event.y
    t.last_button = event.button
    t.streak = count
    << count
}

pub fn utf8_clamp_boundary(text &string,index int) int {
    $pos := index
    if pos <= 0 { << 0 }
    if pos >= text.len { << text.len }
    while pos > 0 && !utf8.rune_start(text[pos] & 255) { pos = pos - 1 }
    << pos
}

pub fn utf8_prev_char(text &string,index int) int {
    $pos := utf8_clamp_boundary(text,index)
    if pos <= 0 { << 0 }
    pos = pos - 1
    while pos > 0 && !utf8.rune_start(text[pos] & 255) { pos = pos - 1 }
    << pos
}

pub fn utf8_next_char(text &string,index int) int {
    pos := utf8_clamp_boundary(text,index)
    if pos >= text.len { << text.len }
    w := utf8.decode_width(text,pos) >>> (err) { << pos + 1 }
    next := pos + w
    if next > text.len { << text.len }
    << next
}

fn rune_word_class(cp int) int {
    if cp == 10 || cp == 13 { << 0 }
    if cp == 32 || cp == 9 || cp == 160 || cp == 12288 || unicode.is_space(cp) { << 1 }
    if (cp >= 48 && cp <= 57) || (cp >= 65 && cp <= 90) || (cp >= 97 && cp <= 122) || cp == 95 { << 2 }
    if unicode.is_punct(cp) || unicode.is_symbol(cp) || (cp >= 12289 && cp <= 12351) || (cp >= 65281 && cp <= 65374 && !unicode.is_letter(cp) && !unicode.is_number(cp)) { << 3 }
    << 4
}

pub fn text_word_range(text &string,index int) TextRange {
    if text.len == 0 { << TextRange{start: 0,end: 0} }
    $probe := utf8_clamp_boundary(text,index)
    if probe >= text.len { probe = utf8_prev_char(text,text.len) }
    cp := utf8.decode(text,probe) >>> (err) { << TextRange{start: probe,end: utf8_next_char(text,probe)} }
    cls := rune_word_class(cp)
    $start := probe
    $end := utf8_next_char(text,probe)
    if cls == 0 || cls == 3 {
        if cls == 3 {
            while start > 0 {
                prev := utf8_prev_char(text,start)
                pcp := utf8.decode(text,prev) >>> (err) { <- }
                if pcp != cp { <- }
                start = prev
            }
            while end < text.len {
                ncp := utf8.decode(text,end) >>> (err) { <- }
                if ncp != cp { <- }
                end = utf8_next_char(text,end)
            }
        }
        << TextRange{start: start,end: end}
    }
    while start > 0 {
        prev := utf8_prev_char(text,start)
        pcp := utf8.decode(text,prev) >>> (err) { <- }
        if rune_word_class(pcp) != cls { <- }
        start = prev
    }
    while end < text.len {
        ncp := utf8.decode(text,end) >>> (err) { <- }
        if rune_word_class(ncp) != cls { <- }
        end = utf8_next_char(text,end)
    }
    << TextRange{start: start,end: end}
}

pub fn text_line_range(text &string,index int) TextRange {
    if text.len == 0 { << TextRange{start: 0,end: 0} }
    $probe := utf8_clamp_boundary(text,index)
    if probe >= text.len { probe = utf8_prev_char(text,text.len) }
    $start := probe
    while start > 0 {
        prev := utf8_prev_char(text,start)
        if (text[prev] & 255) == 10 { <- }
        start = prev
    }
    $end := probe
    while end < text.len {
        b := text[end] & 255
        if b == 10 || b == 13 { <- }
        end = utf8_next_char(text,end)
    }
    << TextRange{start: start,end: end}
}
