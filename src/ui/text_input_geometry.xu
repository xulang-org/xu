@ui

#errors
#strings
#math
#ui/internal/codec

// Maps the layout's top-left to canvas logical coordinates, before camera and
// DPI. Use the same cumulative matrix as Frame.text_layout, including x/y.
pub struct TextInputTransform {
    pub a f64
    pub b f64
    pub c f64
    pub d f64
    pub tx f64
    pub ty f64
}
pub fn text_input_translation(x f64, y f64) TextInputTransform {
    << TextInputTransform{a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: x, ty: y}
}
pub struct TextInputGeometry {
    pub index int
    pub length int
    pub trailing bool
    pub inside bool
    pub rect TextInputRect
}
pub fn (hit &TextInputGeometry) byte_index() int {
    if hit.trailing { << hit.index + hit.length }
    << hit.index
}

// Bridge for #ui/draw.TextLayout. Applications normally bind through the typed
// layout handle. Text, revision, canvas generation and transform are checked
// together by the host; a failed bind leaves the previous binding untouched.
pub fn (input &TextInput) bind_layout_handle(layout int, revision int, transform &TextInputTransform, upstream bool) int {
    if input.id <= 0 || layout <= 0 || revision <= 0 { >> errors.new("ui: invalid layout binding identity") }
    << input.write_layout_binding(layout, revision, transform, upstream, 0) or >>
}
fn (input &TextInput) write_layout_binding(layout int, revision int, transform &TextInputTransform, upstream bool, mode int) int {
    if input.id <= 0 || revision <= 0 { >> errors.new("ui: invalid layout binding identity") }
    values := [transform.a, transform.b, transform.c, transform.d, transform.tx, transform.ty]
    for value in values {
        if math.is_nan(value) || math.is_inf(value) || math.abs(value) > 1000000000.0 { >> errors.new("ui: invalid layout binding transform") }
    }
    mut wire := strings.new_byte_builder(96)
    wire.write_str("XIB1")
    codec.word(mut &wire, 1, 2)
    codec.word(mut &wire, mode, 2)
    codec.word(mut &wire, input.id, 8)
    codec.word(mut &wire, input.canvas_id, 4)
    codec.word(mut &wire, input.generation, 4)
    codec.word(mut &wire, revision, 8)
    codec.word(mut &wire, layout, 8)
    for value in values { codec.word(mut &wire, codec.finite_f64_bits(value), 8) }
    mut edge := 0
    if upstream { edge = 1 }
    codec.word(mut &wire, edge, 4)
    codec.word(mut &wire, 0, 4)
    body := wire.to_string()
    accepted := write_file(":xu:/__text_input_bind", body) or >>
    if accepted != body.len { >> errors.new("ui: layout binding rejected (stale revision, different display text, invalid transform or native geometry unavailable)") }
    << 0
}
// Keeps the application's explicit caret rectangle as fallback. Ending/editing the
// session also drops the binding; selection changes require a new revision.
pub fn (input &TextInput) unbind_layout(revision int) int {
    zero := TextInputTransform{a: 0.0, b: 0.0, c: 0.0, d: 0.0, tx: 0.0, ty: 0.0}
    << input.write_layout_binding(0, revision, &zero, false, 1) or >>
}
fn input_geometry_hex(value f64) string {
    bits := codec.finite_f64_bits(value)
    digits := "0123456789abcdef"
    mut result := strings.new_byte_builder(16)
    for i in 0:16 { result.write_byte(digits[(bits >> ((15 - i) * 4)) & 15]) }
    << result.to_string()
}
fn (input &TextInput) query_geometry(revision int, kind string, tail string) TextInputGeometry {
    if input.id <= 0 || revision <= 0 { >> errors.new("ui: invalid text geometry identity") }
    path := ":xu:/__text_input_" + kind + "/" + str(input.id) + "/" + str(input.canvas_id) + "/" + str(input.generation) + "/" + str(revision) + "/" + tail
    data := read_file(path) or >>
    if data.len != 80 || data[0:4] != "XIG1" || codec.read_word32(&data, 4) != 1 || codec.read_word64(&data, 8) != revision {
        >> errors.new("ui: text geometry unavailable (missing binding, stale revision or native query error)")
    }
    index := int(codec.read_float64(&data, 16) or >>)
    length := int(codec.read_float64(&data, 24) or >>)
    trailing := codec.read_float64(&data, 32) or >> != 0.0
    inside := codec.read_float64(&data, 40) or >> != 0.0
    rect := TextInputRect{x: codec.read_float64(&data, 48) or >>, y: codec.read_float64(&data, 56) or >>,
        width: codec.read_float64(&data, 64) or >>, height: codec.read_float64(&data, 72) or >>}
    if index < 0 || length < 0 || index + length > 16384 || !edit_caret_valid(&rect) { >> errors.new("ui: invalid text geometry response") }
    << TextInputGeometry{index: index, length: length, trailing: trailing, inside: inside, rect: rect}
}
// x/y use canvas logical coordinates; outside points return the nearest edge.
// Returned offsets address display_value(), including the preedit overlay.
pub fn (input &TextInput) hit_test(revision int, x f64, y f64) TextInputGeometry {
    if math.is_nan(x) || math.is_nan(y) || math.is_inf(x) || math.is_inf(y) || math.abs(x) > 1048576.0 || math.abs(y) > 1048576.0 {
        >> errors.new("ui: invalid text hit point")
    }
    << input.query_geometry(revision, "hit", input_geometry_hex(x) + "/" + input_geometry_hex(y)) or >>
}
pub fn (input &TextInput) caret(revision int, index int, trailing bool) TextInputGeometry {
    if index < 0 || index > 16384 { >> errors.new("ui: invalid text caret index") }
    mut edge := "0"
    if trailing { edge = "1" }
    << input.query_geometry(revision, "caret", str(index) + "/" + edge) or >>
}
// The first shaped cluster's axis-aligned canvas rectangle. A newline/EOF has
// a one-pixel logical caret box. This is not a multi-line selection rectangle.
pub fn (input &TextInput) character_rect(revision int, index int) TextInputGeometry {
    if index < 0 || index > 16384 { >> errors.new("ui: invalid text character index") }
    << input.query_geometry(revision, "rect", str(index) + "/0") or >>
}
