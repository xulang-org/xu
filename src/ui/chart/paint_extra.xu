@ui/chart

#ui/draw
#ui/layout
#ui/widgets
#math

fn (c &Chart) stroke_circle(frame $&draw.Frame,cx f64,cy f64,radius f64,color draw.Color,width f64) int {
    if radius <= 0.5 { << 0 }
    << frame.stroke_circle(cx,cy,radius,color,math.max(0.5,width)) or >>
}

fn chart_arc_band(path $&draw.Path,cx f64,cy f64,inner f64,outer f64,start f64,sweep f64) int {
    deg_scale := 180.0 / math.pi()
    $inner_r := inner
    if inner_r <= 0.5 { inner_r = 0.0 }
    << path.ring_sector(cx,cy,inner_r,outer,start * deg_scale,sweep * deg_scale) or >>
}

fn (c &Chart) paint_donut(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    total := c.donut_total()
    if total <= 0.0 { << 0 }
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.5
    radius := math.min(c.plot.width,c.plot.height) * 0.44
    is_pie := c.pie()
    is_rose := c.rose()
    $inner := radius * c.appearance.inner_radius
    if is_pie { inner = 0.0 }
    else if is_rose { inner = radius * 0.16 }
    if is_rose && c.appearance.grid {
        for ring in 1:4 {
            r := inner + (radius - inner) * (f64(ring) / 3.0)
            c.stroke_circle(frame,cx,cy,r,widgets.fade_color(style.palette.border,0.45),1.0) or >>
        }
    }
    visible_count := max_int(1,c.funnel_visible_count())
    max_v := math.max(0.000001,c.funnel_max())
    $angle := 0.0 - math.pi() * 0.5
    for i in 0:c.data.len {
        if !c.datum_visible(i) || c.data[i].y <= 0.0 { -> }
        p_opacity := c.data[i].opacity
        $sweep := c.donut_value(i) / total * math.pi() * 2.0
        $outer_radius := radius
        if is_rose {
            sweep = math.pi() * 2.0 / f64(visible_count)
            outer_radius = inner + (radius - inner) * (c.donut_value(i) / max_v)
        }
        $off_x := 0.0
        $off_y := 0.0
        if i == c.hot || i == c.selected {
            boost := 5.0 * c.emphasis.value()
            outer_radius = outer_radius + boost
            if is_pie {
                mid := angle + sweep * 0.5
                off_x = math.cos(mid) * boost * 0.7
                off_y = math.sin(mid) * boost * 0.7
            }
        }
        $path := draw.new_path(4096) or >>
        chart_arc_band($&path,cx + off_x,cy + off_y,inner,outer_radius,angle,sweep) or >>
        frame.fill_path(&path,widgets.fade_color(c.series_color(i,styles),p_opacity),draw.FILL_NONZERO) or >>
        if is_pie || is_rose {
            stroke := draw.stroke_options(math.max(1.0,1.2 * styles.density))
            frame.stroke_path(&path,style.palette.normal,&stroke) or >>
        }
        angle = angle + sweep
    }
    << 0
}

fn (c $&Chart) paint_radar(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    axes := c.radar_axes()
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.5
    radius := math.min(c.plot.width,c.plot.height) * 0.36
    if radius <= 4.0 { << 0 }
    if c.appearance.grid {
        rings := max_int(2,min_int(6,c.appearance.ticks))
        grid_color := widgets.fade_color(style.palette.border,0.55)
        for r in 1:rings + 1 {
            ring_r := radius * f64(r) / f64(rings)
            frame.stroke_regular_polygon(cx,cy,ring_r,axes,-90.0,grid_color,1.0) or >>
        }
        for k in 0:axes {
            a := 0.0 - math.pi() * 0.5 + math.pi() * 2.0 * f64(k) / f64(axes)
            frame.line(cx,cy,cx + math.cos(a) * radius,cy + math.sin(a) * radius,grid_color,1.0) or >>
        }
    }
    for k in 0:min_int(axes,16) {
        a := 0.0 - math.pi() * 0.5 + math.pi() * 2.0 * f64(k) / f64(axes)
        $spoke_label := "#" + str(k + 1)
        if c.series.len > 0 && k < c.series[0].points.len && c.series[0].points[k].label.len > 0 {
            spoke_label = c.series[0].points[k].label + ""
        }
        label_r := radius + 22.0 * styles.density
        lx := cx + math.cos(a) * label_r
        ly := cy + math.sin(a) * label_r
        w := 96.0 * styles.text_scale
        h := 22.0 * styles.text_scale
        box := layout.Rect{x: lx - w * 0.5,y: ly - h * 0.5,width: w,height: h}
        c.label(100 + k,&spoke_label,frame,&box,styles,style.palette.muted,0.5) or >>
    }
    for si in 0:c.series.len {
        if !c.series_is_visible(si) { -> }
        series_id := c.series[si].id
        line_width := c.series[si].line_width
        symbol_size := c.series[si].symbol_size
        color := c.series_color(si,styles)
        $poly := draw.new_path(1024) or >>
        $count := 0
        $alpha := 1.0
        for i in 0:c.data.len {
            if c.data[i].series == series_id && c.data[i].opacity > 0.001 && c.data[i].target_opacity > 0.0 {
                v := c.radar_vertex(i)
                alpha = c.data[i].opacity
                if count == 0 { poly.move_to(v.x,v.y) or >> }
                else { poly.line_to(v.x,v.y) or >> }
                count = count + 1
            }
        }
        if count >= 3 {
            poly.close() or >>
            frame.fill_path(&poly,widgets.fade_color(color,c.appearance.area_opacity * alpha),draw.FILL_NONZERO) or >>
            stroke := draw.stroke_options(line_width * styles.density)
            frame.stroke_path(&poly,widgets.fade_color(color,alpha),&stroke) or >>
        }
        for i in 0:c.data.len {
            if c.data[i].series == series_id && c.data[i].opacity > 0.001 && c.data[i].target_opacity > 0.0 {
                v := c.radar_vertex(i)
                frame.set_fill(widgets.fade_color(color,c.data[i].opacity)) or >>
                frame.circle(v.x,v.y,math.max(2.5,symbol_size) * styles.density) or >>
            }
        }
    }
    << 0
}

fn (c $&Chart) paint_gauge(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.54
    radius := math.min(c.plot.width,c.plot.height) * 0.42
    if radius <= 8.0 { << 0 }
    start_angle := 0.0 - math.pi() * 1.25
    total_sweep := math.pi() * 1.5
    count := c.gauge_visible_count()
    if c.appearance.grid {
        ticks := c.appearance.ticks * 2
        for t in 0:ticks + 1 {
            a := start_angle + total_sweep * f64(t) / f64(ticks)
            $tick_len := 5.0 * styles.density
            if (t % 2) == 0 { tick_len = 9.0 * styles.density }
            r_out := radius + 8.0 * styles.density
            r_in := r_out - tick_len
            frame.line(cx + math.cos(a) * r_in,cy + math.sin(a) * r_in,cx + math.cos(a) * r_out,cy + math.sin(a) * r_out,widgets.fade_color(style.palette.muted,0.6),1.2 * styles.density) or >>
        }
    }
    $active_index := c.hot
    if active_index < 0 { active_index = c.selected }
    $rank := 0
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 {
            if active_index < 0 { active_index = i }
            radii := c.gauge_ring_radii(rank,count)
            $r_in := radii.x
            $r_out := radii.y
            if i == c.hot || i == c.selected { r_out = r_out + 2.5 * c.emphasis.value() }
            $track := draw.new_path(2048) or >>
            chart_arc_band($&track,cx,cy,r_in,r_out,start_angle,total_sweep) or >>
            frame.fill_path(&track,widgets.fade_color(style.palette.border,0.32),draw.FILL_NONZERO) or >>
            frac := c.gauge_fraction(i)
            if frac > 0.002 {
                $arc := draw.new_path(2048) or >>
                chart_arc_band($&arc,cx,cy,r_in,r_out,start_angle,total_sweep * frac) or >>
                frame.fill_path(&arc,widgets.fade_color(c.series_color(rank,styles),c.data[i].opacity),draw.FILL_NONZERO) or >>
            }
            rank = rank + 1
        }
    }
    if active_index >= 0 && active_index < c.data.len {
        frac := c.gauge_fraction(active_index)
        needle_a := start_angle + total_sweep * frac
        inner_most := c.gauge_ring_radii(count - 1,count).x
        needle_len := math.max(12.0,inner_most * 0.86)
        perp := needle_a + math.pi() * 0.5
        half_base := 3.5 * styles.density
        tip_x := cx + math.cos(needle_a) * needle_len
        tip_y := cy + math.sin(needle_a) * needle_len
        frame.set_fill(style.palette.foreground) or >>
        frame.triangle(tip_x,tip_y,cx + math.cos(perp) * half_base,cy + math.sin(perp) * half_base,
            cx - math.cos(perp) * half_base,cy - math.sin(perp) * half_base) or >>
        frame.circle(cx,cy,6.0 * styles.density) or >>
        val_num := c.number(c.data[active_index].y) or >>
        val_text := val_num + c.appearance.y_unit
        val_box := layout.Rect{x: cx - 80.0 * styles.text_scale,y: cy + radius * 0.34,width: 160.0 * styles.text_scale,height: 26.0 * styles.text_scale}
        c.label(120,&val_text,frame,&val_box,styles,style.palette.foreground,0.5) or >>
    }
    << 0
}

fn (c $&Chart) paint_polar_bar(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.5
    radius := math.min(c.plot.width,c.plot.height) * 0.42
    if radius <= 8.0 { << 0 }
    start_angle := 0.0 - math.pi() * 0.5
    max_sweep := math.pi() * 1.65
    count := c.gauge_visible_count()
    if c.appearance.grid {
        for s in 0:6 {
            a := start_angle + max_sweep * f64(s) / 5.0
            frame.line(cx,cy,cx + math.cos(a) * (radius + 6.0 * styles.density),cy + math.sin(a) * (radius + 6.0 * styles.density),widgets.fade_color(style.palette.border,0.4),1.0) or >>
        }
    }
    $rank := 0
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 {
            radii := c.gauge_ring_radii(rank,count)
            $r_in := radii.x
            $r_out := radii.y
            if i == c.hot || i == c.selected { r_out = r_out + 2.5 * c.emphasis.value() }
            $track := draw.new_path(2048) or >>
            chart_arc_band($&track,cx,cy,r_in,r_out,start_angle,max_sweep) or >>
            frame.fill_path(&track,widgets.fade_color(style.palette.border,0.26),draw.FILL_NONZERO) or >>
            frac := c.gauge_fraction(i)
            if frac > 0.002 {
                $arc := draw.new_path(2048) or >>
                chart_arc_band($&arc,cx,cy,r_in,r_out,start_angle,max_sweep * frac) or >>
                frame.fill_path(&arc,widgets.fade_color(c.series_color(rank,styles),c.data[i].opacity),draw.FILL_NONZERO) or >>
            }
            if rank < 8 {
                $lbl := c.data[i].label + ""
                if lbl.len == 0 { lbl = "#" + str(rank + 1) }
                r_mid := (r_in + r_out) * 0.5
                lbox := layout.Rect{x: cx - radius - 12.0 * styles.density,y: cy - r_mid - 10.0 * styles.text_scale,width: radius - 6.0 * styles.density,height: 20.0 * styles.text_scale}
                c.label(160 + rank,&lbl,frame,&lbox,styles,style.palette.muted,1.0) or >>
            }
            rank = rank + 1
        }
    }
    << 0
}

fn (c $&Chart) paint_treemap(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    $rank := 0
    for i in 0:c.data.len {
        if !c.datum_visible(i) || c.data[i].y <= 0.0 { -> }
        tile := c.treemap_tile_bounds(i)
        if tile.width <= 1.0 || tile.height <= 1.0 { -> }
        p_opacity := c.data[i].opacity
        color := c.series_color(rank,styles)
        $alpha := p_opacity * 0.84
        if i == c.hot || i == c.selected { alpha = p_opacity }
        rad := math.min(5.0 * styles.density,math.min(tile.width,tile.height) * 0.16)
        widgets.rounded_fill(frame,&tile,rad,widgets.fade_color(color,alpha)) or >>
        if i == c.hot || i == c.selected {
            frame.stroke_round_rect(tile.x,tile.y,tile.width,tile.height,rad,style.palette.foreground,2.0 * styles.density) or >>
        }
        if tile.width >= 42.0 * styles.text_scale && tile.height >= 20.0 * styles.text_scale && rank < 16 {
            num := c.number(c.data[i].y) or >>
            $txt := num + c.appearance.y_unit
            if c.data[i].label.len > 0 && tile.width >= 76.0 * styles.text_scale {
                txt = c.data[i].label + " · " + txt
            }
            box := layout.Rect{x: tile.x + 6.0,y: tile.y + 4.0,width: math.max(0.0,tile.width - 12.0),height: math.max(0.0,tile.height - 8.0)}
            ink := color.contrasting_ink(draw.rgb(250,252,255),draw.rgb(16,20,28))
            c.label(170 + rank,&txt,frame,&box,styles,ink,0.5) or >>
        }
        rank = rank + 1
    }
    << 0
}

fn (c $&Chart) paint_sankey(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    node_w := 12.0 * styles.density
    x_left := c.plot.x + 12.0 * styles.density
    x_right := c.plot.x + c.plot.width - 12.0 * styles.density - node_w
    if x_right <= x_left + node_w + 16.0 { << 0 }
    $src0_min := 1000000000.0
    $src0_max := 0.0 - 1000000000.0
    $src1_min := 1000000000.0
    $src1_max := 0.0 - 1000000000.0
    $rank := 0
    for i in 0:c.data.len {
        if !c.datum_visible(i) || c.data[i].y <= 0.0 { -> }
        rb := c.sankey_ribbon_bounds(i)
        p_opacity := c.data[i].opacity
        color := c.series_color(rank,styles)
        $rib_alpha := p_opacity * 0.44
        if i == c.hot || i == c.selected { rib_alpha = p_opacity * 0.76 }
        thick := math.max(2.0,rb.x_max - rb.x_min)
        frame.fill_ribbon(x_left + node_w,rb.x_min,rb.x_max,x_right,rb.y_min,rb.y_max,widgets.fade_color(color,rib_alpha)) or >>
        dst_rect := layout.Rect{x: x_right,y: rb.y_min,width: node_w,height: thick}
        widgets.rounded_fill(frame,&dst_rect,math.min(3.0,node_w * 0.25),widgets.fade_color(color,p_opacity)) or >>
        if (rank % 2) == 0 {
            src0_min = math.min(src0_min,rb.x_min)
            src0_max = math.max(src0_max,rb.x_max)
        } else {
            src1_min = math.min(src1_min,rb.x_min)
            src1_max = math.max(src1_max,rb.x_max)
        }
        if thick >= 14.0 * styles.text_scale && rank < 12 {
            num := c.number(c.data[i].y) or >>
            $txt := num + c.appearance.y_unit
            if c.data[i].label.len > 0 { txt = c.data[i].label + " · " + txt }
            lbox := layout.Rect{x: x_right - 140.0 * styles.text_scale - 6.0 * styles.density,y: rb.y_min - 2.0,width: 140.0 * styles.text_scale,height: thick + 4.0}
            c.label(186 + rank,&txt,frame,&lbox,styles,style.palette.foreground,1.0) or >>
        }
        rank = rank + 1
    }
    if src0_max > src0_min {
        s0 := layout.Rect{x: x_left,y: src0_min,width: node_w,height: src0_max - src0_min}
        widgets.rounded_fill(frame,&s0,math.min(3.0,node_w * 0.25),c.series_color(0,styles)) or >>
    }
    if src1_max > src1_min {
        s1 := layout.Rect{x: x_left,y: src1_min,width: node_w,height: src1_max - src1_min}
        widgets.rounded_fill(frame,&s1,math.min(3.0,node_w * 0.25),c.series_color(1,styles)) or >>
    }
    << 0
}

fn (c $&Chart) paint_funnel(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    cx := c.plot.x + c.plot.width * 0.5
    $rank := 0
    for i in 0:c.data.len {
        if !c.datum_visible(i) || c.data[i].y <= 0.0 { -> }
        $extra := 0.0
        if i == c.hot || i == c.selected { extra = 10.0 * c.emphasis.value() }
        stage := c.funnel_stage(i,extra)
        p_opacity := c.data[i].opacity
        p_y := c.data[i].y
        p_label := c.data[i].label + ""
        $trap := draw.new_path(256) or >>
        trap.move_to(cx - stage.x_min * 0.5,stage.y_min) or >>
        trap.line_to(cx + stage.x_min * 0.5,stage.y_min) or >>
        trap.line_to(cx + stage.x_max * 0.5,stage.y_max) or >>
        trap.line_to(cx - stage.x_max * 0.5,stage.y_max) or >>
        trap.close() or >>
        frame.fill_path(&trap,widgets.fade_color(c.series_color(i,styles),p_opacity),draw.FILL_NONZERO) or >>
        if stage.y_max - stage.y_min >= 18.0 * styles.text_scale && rank < 16 {
            num := c.number(p_y) or >>
            $text := num + c.appearance.y_unit
            if p_label.len > 0 { text = p_label + " · " + text }
            box := layout.Rect{x: c.plot.x + 8.0,y: stage.y_min,width: math.max(0.0,c.plot.width - 16.0),height: stage.y_max - stage.y_min}
            c.label(130 + rank,&text,frame,&box,styles,style.palette.foreground,0.5) or >>
        }
        rank = rank + 1
    }
    << 0
}

fn (c &Chart) paint_boxplot_datum(frame $&draw.Frame,index int,color draw.Color,styles &widgets.Styles) int {
    p := &c.data[index]
    b := c.bar_bounds(index)
    cx := b.x + b.width * 0.5
    pos_low := c.data_position(p.x,datum_box_low(p))
    pos_q1 := c.data_position(p.x,datum_box_q1(p))
    pos_med := c.data_position(p.x,datum_box_median(p))
    pos_q3 := c.data_position(p.x,datum_box_q3(p))
    pos_high := c.data_position(p.x,datum_box_high(p))
    stroke_c := widgets.fade_color(color,p.opacity)
    fill_c := widgets.fade_color(color,p.opacity * 0.30)
    lw := math.max(1.2,1.5 * styles.density)
    frame.line(cx,pos_high.y,cx,pos_q3.y,stroke_c,lw) or >>
    frame.line(cx,pos_q1.y,cx,pos_low.y,stroke_c,lw) or >>
    cap_w := math.max(4.0,b.width * 0.56)
    frame.line(cx - cap_w * 0.5,pos_high.y,cx + cap_w * 0.5,pos_high.y,stroke_c,lw) or >>
    frame.line(cx - cap_w * 0.5,pos_low.y,cx + cap_w * 0.5,pos_low.y,stroke_c,lw) or >>
    box_top := math.min(pos_q3.y,pos_q1.y)
    box_h := math.max(2.0,math.abs(pos_q1.y - pos_q3.y))
    frame.fill_rect(b.x,box_top,b.width,box_h,fill_c) or >>
    frame.stroke_rect(b.x,box_top,b.width,box_h,stroke_c,lw) or >>
    frame.line(b.x,pos_med.y,b.x + b.width,pos_med.y,stroke_c,lw * 1.4) or >>
    << 0
}

fn (c &Chart) paint_violin_datum(frame $&draw.Frame,index int,color draw.Color,styles &widgets.Styles,style &widgets.ControlStyle) int {
    p := &c.data[index]
    b := c.bar_bounds(index)
    cx := b.x + b.width * 0.5
    hw := math.max(3.0,b.width * 0.5)
    pos_low := c.data_position(p.x,datum_box_low(p))
    pos_q1 := c.data_position(p.x,datum_box_q1(p))
    pos_med := c.data_position(p.x,datum_box_median(p))
    pos_q3 := c.data_position(p.x,datum_box_q3(p))
    pos_high := c.data_position(p.x,datum_box_high(p))
    $vpath := draw.new_path(1024) or >>
    vpath.move_to(cx,pos_high.y) or >>
    vpath.cubic_to(cx + hw * 0.45,pos_q3.y,cx + hw,pos_med.y - (pos_med.y - pos_q3.y) * 0.35,cx + hw,pos_med.y) or >>
    vpath.cubic_to(cx + hw,pos_med.y + (pos_q1.y - pos_med.y) * 0.35,cx + hw * 0.45,pos_q1.y,cx,pos_low.y) or >>
    vpath.cubic_to(cx - hw * 0.45,pos_q1.y,cx - hw,pos_med.y + (pos_q1.y - pos_med.y) * 0.35,cx - hw,pos_med.y) or >>
    vpath.cubic_to(cx - hw,pos_med.y - (pos_med.y - pos_q3.y) * 0.35,cx - hw * 0.45,pos_q3.y,cx,pos_high.y) or >>
    vpath.close() or >>
    stroke_c := widgets.fade_color(color,p.opacity)
    fill_c := widgets.fade_color(color,p.opacity * 0.32)
    frame.fill_path(&vpath,fill_c,draw.FILL_NONZERO) or >>
    stroke := draw.stroke_options(math.max(1.2,1.5 * styles.density))
    frame.stroke_path(&vpath,stroke_c,&stroke) or >>
    iqr_w := math.max(3.0 * styles.density,b.width * 0.22)
    iqr_top := math.min(pos_q3.y,pos_q1.y)
    iqr_h := math.max(2.0,math.abs(pos_q1.y - pos_q3.y))
    frame.fill_rect(cx - iqr_w * 0.5,iqr_top,iqr_w,iqr_h,widgets.fade_color(color,p.opacity * 0.78)) or >>
    frame.fill_circle(cx,pos_med.y,math.max(2.2,2.8 * styles.density),style.palette.normal) or >>
    << 0
}

fn (c &Chart) paint_bullet_datum(frame $&draw.Frame,index int,color draw.Color,styles &widgets.Styles,style &widgets.ControlStyle) int {
    p := &c.data[index]
    b := c.bar_bounds(index)
    d := c.visible_domain()
    zero := c.data_position(p.x,0.0)
    max_pos := c.data_position(p.x,d.y_max)
    val_pos := c.data_position(p.x,p.y)
    target_pos := c.data_position(p.x,datum_bullet_target(p))
    track_x := math.max(c.plot.x,math.min(zero.x,max_pos.x))
    track_w := math.max(4.0,math.min(c.plot.x + c.plot.width,math.max(zero.x,max_pos.x)) - track_x)
    band_c := style.palette.border
    rad := math.min(3.0,b.height * 0.18)
    b1 := layout.Rect{x: track_x,y: b.y,width: track_w,height: b.height}
    b2 := layout.Rect{x: track_x,y: b.y,width: track_w * 0.82,height: b.height}
    b3 := layout.Rect{x: track_x,y: b.y,width: track_w * 0.58,height: b.height}
    widgets.rounded_fill(frame,&b1,rad,widgets.fade_color(band_c,0.18 * p.opacity)) or >>
    widgets.rounded_fill(frame,&b2,rad,widgets.fade_color(band_c,0.26 * p.opacity)) or >>
    widgets.rounded_fill(frame,&b3,rad,widgets.fade_color(band_c,0.34 * p.opacity)) or >>
    bar_h := math.max(3.0,b.height * 0.46)
    bar_left := math.max(c.plot.x,math.min(zero.x,val_pos.x))
    bar_right := math.min(c.plot.x + c.plot.width,math.max(zero.x,val_pos.x))
    perf := layout.Rect{x: bar_left,y: b.y + (b.height - bar_h) * 0.5,width: math.max(2.0,bar_right - bar_left),height: bar_h}
    widgets.rounded_fill(frame,&perf,math.min(2.0,bar_h * 0.25),widgets.fade_color(color,p.opacity)) or >>
    tx := math.max(c.plot.x + 2.0,math.min(c.plot.x + c.plot.width - 2.0,target_pos.x))
    frame.line(tx,b.y + b.height * 0.12,tx,b.y + b.height * 0.88,widgets.fade_color(style.palette.foreground,p.opacity),math.max(2.0,2.5 * styles.density)) or >>
    << 0
}

fn (c &Chart) paint_lollipop_datum(frame $&draw.Frame,index int,color draw.Color,styles &widgets.Styles,style &widgets.ControlStyle) int {
    p := &c.data[index]
    si := c.series_index(p.series)
    b := c.bar_bounds(index)
    cx := b.x + b.width * 0.5
    zero := c.data_position(p.x,0.0)
    pos := c.data_position(p.x,p.y)
    base_y := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,zero.y))
    tip_y := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,pos.y))
    stroke_c := widgets.fade_color(color,p.opacity)
    frame.line(cx,base_y,cx,tip_y,stroke_c,math.max(1.8,2.2 * styles.density)) or >>
    r := math.max(4.5,c.series[si].symbol_size * 1.35) * styles.density
    frame.fill_circle(cx,tip_y,r,stroke_c) or >>
    frame.fill_circle(cx,tip_y,r * 0.42,style.palette.normal) or >>
    << 0
}

fn (c &Chart) paint_dumbbell_datum(frame $&draw.Frame,index int,color draw.Color,styles &widgets.Styles,style &widgets.ControlStyle) int {
    p := &c.data[index]
    b := c.bar_bounds(index)
    cx := b.x + b.width * 0.5
    pos_low := c.data_position(p.x,datum_box_low(p))
    pos_high := c.data_position(p.x,datum_box_high(p))
    y_low := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,pos_low.y))
    y_high := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,pos_high.y))
    frame.line(cx,y_low,cx,y_high,widgets.fade_color(style.palette.muted,0.65 * p.opacity),math.max(2.2,3.0 * styles.density)) or >>
    r := 5.2 * styles.density
    low_c := widgets.fade_color(c.series_color(1,styles),p.opacity)
    high_c := widgets.fade_color(color,p.opacity)
    frame.fill_circle(cx,y_low,r * 0.88,low_c) or >>
    frame.fill_circle(cx,y_high,r,high_c) or >>
    frame.fill_circle(cx,y_high,r * 0.38,style.palette.normal) or >>
    << 0
}

fn (c &Chart) paint_pareto(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    bar_color := c.series_color(0,styles)
    line_color := c.series_color(1,styles)
    if c.appearance.grid {
        y80 := c.plot.y + c.plot.height * 0.2
        frame.dashed_line(c.plot.x,y80,c.plot.x + c.plot.width,y80,4.0 * styles.density,3.0 * styles.density,widgets.fade_color(line_color,0.55),1.2 * styles.density) or >>
    }
    $curve_pts := []draw.PathPoint{}
    for i in 0:c.data.len {
        if !c.datum_visible(i) { -> }
        p_opacity := c.data[i].opacity
        b := c.bar_bounds(i)
        widgets.rounded_fill(frame,&b,math.min(3.0,b.width * 0.2),widgets.fade_color(bar_color,p_opacity * 0.86)) or >>
        ratio := c.pareto_ratio(i)
        cx := b.x + b.width * 0.5
        cy := c.plot.y + c.plot.height * (1.0 - ratio)
        curve_pts.push(draw.path_point(cx,cy))
    }
    if curve_pts.len >= 2 {
        frame.smooth_curve(&curve_pts,0.45,line_color,2.2 * styles.density) or >>
    }
    for pt in curve_pts {
        frame.fill_circle(pt.x,pt.y,3.8 * styles.density,line_color) or >>
        frame.fill_circle(pt.x,pt.y,1.6 * styles.density,style.palette.normal) or >>
    }
    << 0
}

fn (c &Chart) paint_candlestick_datum(frame $&draw.Frame,index int,styles &widgets.Styles) int {
    p := &c.data[index]
    b := c.bar_bounds(index)
    cx := b.x + b.width * 0.5
    open := datum_candle_open(p)
    close := datum_candle_close(p)
    low := datum_candle_low(p)
    high := datum_candle_high(p)
    pos_open := c.data_position(p.x,open)
    pos_close := c.data_position(p.x,close)
    pos_low := c.data_position(p.x,low)
    pos_high := c.data_position(p.x,high)
    $color := c.series_color(2,styles)
    if close < open { color = c.series_color(0,styles) }
    stroke_c := widgets.fade_color(color,p.opacity)
    lw := math.max(1.2,1.5 * styles.density)
    frame.line(cx,pos_high.y,cx,pos_low.y,stroke_c,lw) or >>
    body_top := math.min(pos_open.y,pos_close.y)
    body_h := math.max(2.0 * styles.density,math.abs(pos_close.y - pos_open.y))
    body := layout.Rect{x: b.x,y: body_top,width: b.width,height: body_h}
    widgets.rounded_fill(frame,&body,math.min(2.0,b.width * 0.15),stroke_c) or >>
    << 0
}

fn (c &Chart) paint_waterfall(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    $has_prev := false
    $prev_right := 0.0
    $prev_end_y := 0.0
    for i in 0:c.data.len {
        if !c.datum_visible(i) { -> }
        p := &c.data[i]
        b := c.bar_bounds(i)
        span := c.waterfall_span(i)
        pos_end := c.data_position(p.x,span.y)
        $color := c.series_color(2,styles)
        if p.size > 0.0 { color = c.series_color(1,styles) }
        else if p.y < 0.0 { color = c.series_color(0,styles) }
        if has_prev && b.x > prev_right {
            frame.dashed_line(prev_right,prev_end_y,b.x,prev_end_y,3.0 * styles.density,2.5 * styles.density,widgets.fade_color(style.palette.muted,0.65 * p.opacity),1.0 * styles.density) or >>
        }
        widgets.rounded_fill(frame,&b,math.min(3.0,b.width * 0.2),widgets.fade_color(color,p.opacity)) or >>
        prev_right = b.x + b.width
        prev_end_y = pos_end.y
        has_prev = true
    }
    << 0
}

fn (c $&Chart) paint_heatmap(frame $&draw.Frame,styles &widgets.Styles,style &widgets.ControlStyle) int {
    range := c.heatmap_range()
    span := math.max(0.000001,range.y - range.x)
    low_c := c.series_color(1,styles)
    mid_c := c.series_color(2,styles)
    high_c := c.series_color(0,styles)
    $label_slot := 0
    for i in 0:c.data.len {
        if !c.datum_visible(i) { -> }
        cell := c.heatmap_cell_bounds(i)
        val := c.heatmap_value(i)
        p_opacity := c.data[i].opacity
        t := math.max(0.0,math.min(1.0,(val - range.x) / span))
        $base_color := draw.lerp_color(low_c,mid_c,t * 2.0)
        if t > 0.5 { base_color = draw.lerp_color(mid_c,high_c,(t - 0.5) * 2.0) }
        fill := widgets.fade_color(base_color,p_opacity * (0.28 + 0.68 * t))
        widgets.rounded_fill(frame,&cell,math.min(4.0 * styles.density,math.min(cell.width,cell.height) * 0.18),fill) or >>
        if cell.width >= 36.0 * styles.text_scale && cell.height >= 18.0 * styles.text_scale && label_slot < 24 {
            txt := c.number(val) or >>
            c.label(140 + label_slot,&txt,frame,&cell,styles,widgets.fade_color(style.palette.foreground,p_opacity),0.5) or >>
            label_slot = label_slot + 1
        }
    }
    << 0
}

fn (c &Chart) tooltip_value(index int) string {
    p_x := c.data[index].x
    p_y := c.data[index].y
    p_size := c.data[index].size
    si := c.series_index(c.data[index].series)
    kind := c.series[si].kind
    y_text := c.number(p_y) or >>
    if c.slice_chart() || c.gauge() || c.funnel() || c.polar_bar() || c.treemap() || c.sankey() { << y_text + c.appearance.y_unit }
    if kind == CHART_BOXPLOT || kind == CHART_VIOLIN {
        low_t := c.number(datum_box_low(&c.data[index])) or >>
        med_t := c.number(datum_box_median(&c.data[index])) or >>
        high_t := c.number(datum_box_high(&c.data[index])) or >>
        << low_t + " .. " + high_t + " (med " + med_t + ")" + c.appearance.y_unit
    }
    if kind == CHART_DUMBBELL {
        low_t := c.number(datum_box_low(&c.data[index])) or >>
        high_t := c.number(datum_box_high(&c.data[index])) or >>
        << low_t + " → " + high_t + c.appearance.y_unit
    }
    if kind == CHART_BULLET {
        target_t := c.number(datum_bullet_target(&c.data[index])) or >>
        << y_text + c.appearance.y_unit + " (target " + target_t + c.appearance.y_unit + ")"
    }
    if kind == CHART_PARETO {
        pct_t := c.number(c.pareto_ratio(index) * 100.0) or >>
        << y_text + c.appearance.y_unit + " · Σ " + pct_t + "%"
    }
    if kind == CHART_CANDLESTICK {
        open_t := c.number(datum_candle_open(&c.data[index])) or >>
        high_t := c.number(datum_candle_high(&c.data[index])) or >>
        low_t := c.number(datum_candle_low(&c.data[index])) or >>
        close_t := c.number(datum_candle_close(&c.data[index])) or >>
        << "O " + open_t + " · H " + high_t + " · L " + low_t + " · C " + close_t + c.appearance.y_unit
    }
    x_text := c.number(p_x) or >>
    if kind == CHART_BUBBLE {
        $b_val := p_size
        if b_val <= 0.0 { b_val = math.abs(p_y) }
        s_text := c.number(b_val) or >>
        << x_text + c.appearance.x_unit + " · " + y_text + c.appearance.y_unit + " · ⌀ " + s_text
    }
    if kind == CHART_HEATMAP {
        row_t := c.number(c.heatmap_row(index)) or >>
        val_t := c.number(c.heatmap_value(index)) or >>
        << x_text + c.appearance.x_unit + " × " + row_t + "  ·  " + val_t + c.appearance.y_unit
    }
    << x_text + c.appearance.x_unit + "  ·  " + y_text + c.appearance.y_unit
}
