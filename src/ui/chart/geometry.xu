@ui/chart

#ui/layout
#math

fn (c &Chart) donut() bool { << c.series.len == 1 && c.series[0].kind == CHART_DONUT }
fn (c &Chart) pie() bool { << c.series.len == 1 && c.series[0].kind == CHART_PIE }
fn (c &Chart) rose() bool { << c.series.len == 1 && c.series[0].kind == CHART_ROSE }
fn (c &Chart) slice_chart() bool { << c.donut() || c.pie() || c.rose() }
fn (c &Chart) radar() bool { << c.series.len > 0 && c.series[0].kind == CHART_RADAR }
fn (c &Chart) gauge() bool { << c.series.len == 1 && c.series[0].kind == CHART_GAUGE }
fn (c &Chart) funnel() bool { << c.series.len == 1 && c.series[0].kind == CHART_FUNNEL }
fn (c &Chart) polar_bar() bool { << c.series.len == 1 && c.series[0].kind == CHART_POLAR_BAR }
fn (c &Chart) treemap() bool { << c.series.len == 1 && c.series[0].kind == CHART_TREEMAP }
fn (c &Chart) sankey() bool { << c.series.len == 1 && c.series[0].kind == CHART_SANKEY }
fn (c &Chart) polar_or_radial() bool {
    << c.slice_chart() || c.radar() || c.gauge() || c.funnel() || c.polar_bar() || c.treemap() || c.sankey()
}
fn (c &Chart) horizontal() bool {
    << c.series.len > 0 && (c.series[0].kind == CHART_HORIZONTAL_BAR || c.series[0].kind == CHART_BULLET)
}
fn (c &Chart) heatmap() bool { << c.series.len > 0 && c.series[0].kind == CHART_HEATMAP }
fn (c &Chart) range_chart() bool {
    << c.series.len > 0 && (c.series[0].kind == CHART_BOXPLOT || c.series[0].kind == CHART_CANDLESTICK ||
       c.series[0].kind == CHART_VIOLIN || c.series[0].kind == CHART_DUMBBELL)
}
fn (c &Chart) series_uses_bar_step(si int) bool {
    if si < 0 || si >= c.series.len { << false }
    k := c.series[si].kind
    << k == CHART_BAR || k == CHART_STACKED_BAR || k == CHART_HORIZONTAL_BAR ||
       k == CHART_HISTOGRAM || k == CHART_BOXPLOT || k == CHART_CANDLESTICK || k == CHART_WATERFALL ||
       k == CHART_VIOLIN || k == CHART_BULLET || k == CHART_LOLLIPOP || k == CHART_DUMBBELL || k == CHART_PARETO
}
fn datum_uses_bar_bounds(kind int) bool {
    << kind == CHART_BAR || kind == CHART_STACKED_BAR || kind == CHART_HORIZONTAL_BAR ||
       kind == CHART_HISTOGRAM || kind == CHART_BOXPLOT || kind == CHART_CANDLESTICK || kind == CHART_WATERFALL ||
       kind == CHART_VIOLIN || kind == CHART_BULLET || kind == CHART_LOLLIPOP || kind == CHART_DUMBBELL || kind == CHART_PARETO
}
fn datum_bullet_target(p &ChartDatum) f64 {
    if datum_has_range(p) && p.high > 0.0 { << p.high }
    << math.max(0.0,p.y) * 1.15
}

fn (c &Chart) stacked_y(index int) ChartCoordinate {
    p := &c.data[index]
    si := c.series_index(p.series)
    if si < 0 { << ChartCoordinate{x: 0.0,y: p.y} }
    kind := c.series[si].kind
    if kind != CHART_STACKED_AREA && kind != CHART_STACKED_BAR {
        << ChartCoordinate{x: 0.0,y: p.y}
    }
    $base := 0.0
    for j in 0:c.data.len {
        if j != index && c.datum_visible(j) {
            other := &c.data[j]
            sj := c.series_index(other.series)
            if sj >= 0 && sj < si && c.series[sj].kind == kind && math.abs(other.x - p.x) < 0.0001 {
                same_sign := kind == CHART_STACKED_AREA || (p.y >= 0.0 && other.y >= 0.0) || (p.y < 0.0 && other.y < 0.0)
                if same_sign { base = base + other.y * other.opacity }
            }
        }
    }
    << ChartCoordinate{x: base,y: base + p.y * p.opacity}
}

fn (c &Chart) waterfall_span(index int) ChartCoordinate {
    $running := 0.0
    for i in 0:c.data.len {
        if c.datum_visible(i) {
            p := &c.data[i]
            $start := running
            $end := running + p.y * p.opacity
            if p.size > 0.0 {
                start = 0.0
                if p.y != 0.0 { end = p.y * p.opacity }
                else { end = running }
            }
            if i == index { << ChartCoordinate{x: start,y: end} }
            running = end
        }
    }
    p := &c.data[index]
    << ChartCoordinate{x: 0.0,y: p.y}
}

fn (c &Chart) bubble_radius(index int,density f64) f64 {
    p := &c.data[index]
    $min_s := 1000000000000.0
    $max_s := 0.0
    for i in 0:c.data.len {
        if c.datum_visible(i) {
            q := &c.data[i]
            $val := q.size
            if val <= 0.0 { val = math.abs(q.y) }
            min_s = math.min(min_s,val)
            max_s = math.max(max_s,val)
        }
    }
    $val := p.size
    if val <= 0.0 { val = math.abs(p.y) }
    $ratio := 0.5
    if max_s - min_s > 0.000001 { ratio = math.max(0.0,math.min(1.0,(val - min_s) / (max_s - min_s))) }
    << (6.0 + ratio * 16.0) * density * math.max(0.2,p.opacity)
}

fn (c &Chart) bar_bounds(index int) layout.Rect {
    p := &c.data[index]
    si := c.series_index(p.series)
    kind := c.series[si].kind
    d := c.visible_domain()
    $step := 1.0
    if si >= 0 && si < c.bar_steps.len { step = c.bar_steps[si] }
    if kind == CHART_HORIZONTAL_BAR || kind == CHART_BULLET {
        $end_val := p.y
        if kind == CHART_BULLET { end_val = math.max(p.y,datum_bullet_target(p)) }
        position := c.data_position(p.x,end_val)
        zero := c.data_position(p.x,0.0)
        $count := 0
        $order := 0
        for j in 0:c.series.len { s := &c.series[j]
            if s.kind == kind && c.series_is_visible(j) {
                if s.id < p.series { order = order + 1 }
                count = count + 1
            }
        }
        count = max_int(1,count)
        total_h := math.min(c.plot.height * 0.7,step / (d.x_max - d.x_min) * c.plot.height * c.appearance.bar_ratio)
        bar_h := math.max(0.5,total_h / f64(count))
        left := math.max(c.plot.x,math.min(c.plot.x + c.plot.width,math.min(position.x,zero.x)))
        right := math.max(c.plot.x,math.min(c.plot.x + c.plot.width,math.max(position.x,zero.x)))
        top := math.max(0.0 - 100000000.0,math.min(100000000.0,position.y - total_h * 0.5 + f64(order) * bar_h))
        << layout.Rect{x: left,y: top,width: math.max(0.0,right - left),height: math.min(100000000.0,math.max(0.5,bar_h - 2.0))}
    }
    $y_start := 0.0
    $y_end := p.y
    if kind == CHART_STACKED_BAR {
        stack := c.stacked_y(index)
        y_start = stack.x
        y_end = stack.y
    } else if kind == CHART_WATERFALL {
        span := c.waterfall_span(index)
        y_start = span.x
        y_end = span.y
    } else if kind == CHART_BOXPLOT || kind == CHART_VIOLIN || kind == CHART_DUMBBELL {
        y_start = datum_box_low(p)
        y_end = datum_box_high(p)
    } else if kind == CHART_CANDLESTICK {
        y_start = datum_candle_low(p)
        y_end = datum_candle_high(p)
    }
    pos_end := c.data_position(p.x,y_end)
    pos_start := c.data_position(p.x,y_start)
    $ratio := c.appearance.bar_ratio
    if kind == CHART_HISTOGRAM { ratio = 0.96 }
    total_width := math.min(c.plot.width * 0.7,step / (d.x_max - d.x_min) * c.plot.width * ratio)
    $count := 1
    $order := 0
    if kind == CHART_BAR || kind == CHART_BOXPLOT || kind == CHART_VIOLIN || kind == CHART_LOLLIPOP || kind == CHART_DUMBBELL {
        $grouped := 0
        for j in 0:c.series.len { s := &c.series[j]
            if s.kind == kind && c.series_is_visible(j) {
                if s.id < p.series { order = order + 1 }
                grouped = grouped + 1
            }
        }
        count = max_int(1,grouped)
    }
    width := math.max(0.5,total_width / f64(count))
    $gap := 2.0
    if kind == CHART_HISTOGRAM { gap = 1.0 }
    top := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,math.min(pos_end.y,pos_start.y)))
    bottom := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,math.max(pos_end.y,pos_start.y)))
    << layout.Rect{x: math.max(0.0 - 100000000.0,math.min(100000000.0,pos_end.x - total_width * 0.5 + f64(order) * width)),y: top,
        width: math.min(100000000.0,math.max(0.5,width - gap)),height: math.max(2.0,bottom - top)}
}

fn (c &Chart) heatmap_value(index int) f64 {
    p := &c.data[index]
    if p.size != 0.0 || p.target_size != 0.0 { << p.size }
    << p.y
}
fn (c &Chart) heatmap_row(index int) f64 {
    p := &c.data[index]
    if p.size != 0.0 || p.target_size != 0.0 { << p.y }
    si := c.series_index(p.series)
    << f64(max_int(0,si) + 1)
}
fn (c &Chart) heatmap_range() ChartCoordinate {
    $min_v := 1000000000000.0
    $max_v := 0.0 - 1000000000000.0
    $found := false
    for i in 0:c.data.len {
        if c.datum_visible(i) {
            v := c.heatmap_value(i)
            min_v = math.min(min_v,v)
            max_v = math.max(max_v,v)
            found = true
        }
    }
    if !found { << ChartCoordinate{x: 0.0,y: 1.0} }
    if max_v - min_v < 0.000001 { << ChartCoordinate{x: min_v - 0.5,y: max_v + 0.5} }
    << ChartCoordinate{x: min_v,y: max_v}
}
fn (c &Chart) heatmap_cell_bounds(index int) layout.Rect {
    p := &c.data[index]
    si := c.series_index(p.series)
    $step := 1.0
    if si >= 0 && si < c.bar_steps.len { step = c.bar_steps[si] }
    row := c.heatmap_row(index)
    top_left := c.data_position(p.x - step * 0.46,row + 0.44)
    bottom_right := c.data_position(p.x + step * 0.46,row - 0.44)
    x := math.min(top_left.x,bottom_right.x)
    y := math.min(top_left.y,bottom_right.y)
    w := math.max(2.0,math.abs(bottom_right.x - top_left.x))
    h := math.max(2.0,math.abs(bottom_right.y - top_left.y))
    << layout.Rect{x: x,y: y,width: w,height: h}
}

fn (c &Chart) radar_axes() int {
    $axes := 0
    for si in 0:c.series.len {
        if c.series_is_visible(si) { axes = max_int(axes,c.series[si].points.len) }
    }
    << max_int(3,axes)
}
fn (c &Chart) radar_spoke_index(index int) int {
    target_series := c.data[index].series
    $rank := 0
    for i in 0:index {
        if c.data[i].series == target_series && c.data[i].target_opacity > 0.0 { rank = rank + 1 }
    }
    << rank
}
fn (c &Chart) radar_vertex(index int) ChartCoordinate {
    p := &c.data[index]
    axes := c.radar_axes()
    if axes <= 0 { << ChartCoordinate{x: 0.0,y: 0.0} }
    spoke := c.radar_spoke_index(index) % axes
    angle := 0.0 - math.pi() * 0.5 + math.pi() * 2.0 * f64(spoke) / f64(axes)
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.5
    radius := math.min(c.plot.width,c.plot.height) * 0.36
    d := c.visible_domain()
    span := math.max(0.000001,d.y_max - math.min(0.0,d.y_min))
    ratio := math.max(0.0,math.min(1.0,(p.y - math.min(0.0,d.y_min)) / span)) * p.opacity
    << ChartCoordinate{x: cx + math.cos(angle) * radius * ratio,y: cy + math.sin(angle) * radius * ratio}
}

fn (c &Chart) gauge_visible_count() int {
    $count := 0
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 { count = count + 1 }
    }
    << max_int(1,count)
}
fn (c &Chart) gauge_rank(index int) int {
    $rank := 0
    for i in 0:index {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 { rank = rank + 1 }
    }
    << rank
}
fn (c &Chart) gauge_fraction(index int) f64 {
    p := &c.data[index]
    d := c.visible_domain()
    span := math.max(0.000001,d.y_max - d.y_min)
    << math.max(0.0,math.min(1.0,(p.y - d.y_min) / span)) * p.opacity
}
fn (c &Chart) gauge_ring_radii(rank int,count int) ChartCoordinate {
    radius := math.min(c.plot.width,c.plot.height) * 0.42
    inner_limit := radius * math.max(0.28,c.appearance.inner_radius * 0.72)
    available := math.max(8.0,radius - inner_limit)
    slot := available / f64(max_int(1,count))
    thickness := math.max(4.0,slot * 0.72)
    outer := radius - f64(rank) * slot
    << ChartCoordinate{x: math.max(4.0,outer - thickness),y: outer}
}

fn (c &Chart) funnel_visible_count() int {
    $count := 0
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].y > 0.0 { count = count + 1 }
    }
    << count
}
fn (c &Chart) funnel_max() f64 {
    $max_v := 0.0
    for i in 0:c.data.len {
        if c.datum_visible(i) { max_v = math.max(max_v,c.donut_value(i)) }
    }
    << max_v
}
fn (c &Chart) funnel_stage(index int,extra f64) ChartDomain {
    count := max_int(1,c.funnel_visible_count())
    max_v := math.max(0.000001,c.funnel_max())
    $rank := 0
    $next_val := c.donut_value(index) * 0.6
    $found := false
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].y > 0.0 {
            if i < index { rank = rank + 1 }
            else if i > index && !found {
                next_val = c.donut_value(i)
                found = true
            }
        }
    }
    pad_y := 8.0
    usable_h := math.max(16.0,c.plot.height - pad_y * 2.0)
    stage_h := usable_h / f64(count)
    gap := math.min(4.0,stage_h * 0.12)
    top_y := c.plot.y + pad_y + f64(rank) * stage_h
    bottom_y := top_y + math.max(2.0,stage_h - gap)
    max_w := c.plot.width * 0.78
    top_w := math.min(c.plot.width - 8.0,math.max(18.0,max_w * (c.donut_value(index) / max_v) + extra))
    bottom_w := math.min(c.plot.width - 8.0,math.max(14.0,max_w * (next_val / max_v) + extra))
    << ChartDomain{x_min: top_w,x_max: bottom_w,y_min: top_y,y_max: bottom_y}
}

fn (c &Chart) treemap_tile_bounds(index int) layout.Rect {
    $rx := c.plot.x + 2.0
    $ry := c.plot.y + 2.0
    $rw := math.max(8.0,c.plot.width - 4.0)
    $rh := math.max(8.0,c.plot.height - 4.0)
    $rem := math.max(0.000001,c.donut_total())
    $vis_rem := c.funnel_visible_count()
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].y > 0.0 {
            val := c.donut_value(i)
            frac := math.max(0.0,math.min(1.0,val / math.max(0.000001,rem)))
            $tx := rx
            $ty := ry
            $tw := rw
            $th := rh
            if vis_rem > 1 {
                if rw >= rh {
                    tw = math.max(4.0,rw * frac)
                    rx = rx + tw
                    rw = math.max(4.0,rw - tw)
                } else {
                    th = math.max(4.0,rh * frac)
                    ry = ry + th
                    rh = math.max(4.0,rh - th)
                }
            }
            if i == index {
                gap := 2.0
                << layout.Rect{x: tx + gap,y: ty + gap,width: math.max(2.0,tw - gap * 2.0),height: math.max(2.0,th - gap * 2.0)}
            }
            rem = math.max(0.0,rem - val)
            vis_rem = vis_rem - 1
        }
    }
    << layout.Rect{x: c.plot.x,y: c.plot.y,width: 0.0,height: 0.0}
}

fn (c &Chart) sankey_ribbon_bounds(index int) ChartDomain {
    count := max_int(1,c.funnel_visible_count())
    total := math.max(0.000001,c.donut_total())
    usable_h := math.max(32.0,c.plot.height - 20.0)
    top_y := c.plot.y + 10.0
    gap_r := math.min(8.0,usable_h / f64(count) * 0.16)
    avail_h := math.max(16.0,usable_h - gap_r * f64(max_int(0,count - 1)))
    $src0_total := 0.0
    $rank_check := 0
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].y > 0.0 {
            if (rank_check % 2) == 0 { src0_total = src0_total + c.donut_value(i) }
            rank_check = rank_check + 1
        }
    }
    gap_l := math.min(20.0,usable_h * 0.12)
    src0_h := avail_h * (src0_total / total)
    $cur_src0 := top_y + (usable_h - avail_h - gap_l) * 0.5
    if count <= 1 { cur_src0 = top_y + (usable_h - avail_h) * 0.5 }
    $cur_src1 := cur_src0 + src0_h + gap_l
    $cur_dst := top_y
    $rank := 0
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].y > 0.0 {
            h := math.max(3.0,avail_h * (c.donut_value(i) / total))
            $sy0 := cur_src0
            if (rank % 2) == 0 {
                sy0 = cur_src0
                cur_src0 = cur_src0 + h
            } else {
                sy0 = cur_src1
                cur_src1 = cur_src1 + h
            }
            dy0 := cur_dst
            cur_dst = cur_dst + h + gap_r
            if i == index { << ChartDomain{x_min: sy0,x_max: sy0 + h,y_min: dy0,y_max: dy0 + h} }
            rank = rank + 1
        }
    }
    << ChartDomain{x_min: top_y,x_max: top_y + 4.0,y_min: top_y,y_max: top_y + 4.0}
}

fn (c &Chart) pareto_ratio(index int) f64 {
    total := math.max(0.000001,c.donut_total())
    $cum := 0.0
    for i in 0:index + 1 {
        if c.datum_visible(i) && c.data[i].y > 0.0 { cum = cum + c.donut_value(i) }
    }
    << math.max(0.0,math.min(1.0,cum / total))
}

fn (c &Chart) slice_centroid(index int) ChartCoordinate {
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.5
    radius := math.min(c.plot.width,c.plot.height) * 0.44
    if c.rose() {
        count := max_int(1,c.funnel_visible_count())
        max_v := math.max(0.000001,c.funnel_max())
        $rank := 0
        for i in 0:index {
            if c.datum_visible(i) && c.data[i].y > 0.0 { rank = rank + 1 }
        }
        sweep := math.pi() * 2.0 / f64(count)
        mid := 0.0 - math.pi() * 0.5 + (f64(rank) + 0.5) * sweep
        inner := radius * 0.16
        outer := inner + (radius - inner) * (c.donut_value(index) / max_v)
        r_mid := (inner + outer) * 0.55
        << ChartCoordinate{x: cx + math.cos(mid) * r_mid,y: cy + math.sin(mid) * r_mid}
    }
    total := math.max(0.000001,c.donut_total())
    $angle := 0.0 - math.pi() * 0.5
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].y > 0.0 {
            sweep := c.donut_value(i) / total * math.pi() * 2.0
            if i == index {
                mid := angle + sweep * 0.5
                $inner := radius * c.appearance.inner_radius
                if c.pie() { inner = 0.0 }
                r_mid := inner + (radius - inner) * 0.55
                << ChartCoordinate{x: cx + math.cos(mid) * r_mid,y: cy + math.sin(mid) * r_mid}
            }
            angle = angle + sweep
        }
    }
    << ChartCoordinate{x: cx,y: cy}
}

fn (c &Chart) datum_position(index int) ChartCoordinate {
    p := &c.data[index]
    si := c.series_index(p.series)
    if si < 0 { << c.data_position(p.x,p.y) }
    kind := c.series[si].kind
    if kind == CHART_DONUT || kind == CHART_PIE || kind == CHART_ROSE { << c.slice_centroid(index) }
    if kind == CHART_RADAR { << c.radar_vertex(index) }
    if kind == CHART_GAUGE {
        cx := c.plot.x + c.plot.width * 0.5
        cy := c.plot.y + c.plot.height * 0.54
        count := c.gauge_visible_count()
        rank := c.gauge_rank(index)
        radii := c.gauge_ring_radii(rank,count)
        r_mid := (radii.x + radii.y) * 0.5
        angle := 0.0 - math.pi() * 1.25 + math.pi() * 1.5 * c.gauge_fraction(index)
        << ChartCoordinate{x: cx + math.cos(angle) * r_mid,y: cy + math.sin(angle) * r_mid}
    }
    if kind == CHART_FUNNEL {
        stage := c.funnel_stage(index,0.0)
        << ChartCoordinate{x: c.plot.x + c.plot.width * 0.5,y: (stage.y_min + stage.y_max) * 0.5}
    }
    if kind == CHART_POLAR_BAR {
        cx := c.plot.x + c.plot.width * 0.5
        cy := c.plot.y + c.plot.height * 0.5
        count := c.gauge_visible_count()
        rank := c.gauge_rank(index)
        radii := c.gauge_ring_radii(rank,count)
        r_mid := (radii.x + radii.y) * 0.5
        angle := 0.0 - math.pi() * 0.5 + math.pi() * 1.65 * c.gauge_fraction(index)
        << ChartCoordinate{x: cx + math.cos(angle) * r_mid,y: cy + math.sin(angle) * r_mid}
    }
    if kind == CHART_TREEMAP {
        tile := c.treemap_tile_bounds(index)
        << ChartCoordinate{x: tile.x + tile.width * 0.5,y: tile.y + tile.height * 0.5}
    }
    if kind == CHART_SANKEY {
        rb := c.sankey_ribbon_bounds(index)
        << ChartCoordinate{x: c.plot.x + c.plot.width * 0.5,y: ((rb.x_min + rb.x_max) * 0.5 + (rb.y_min + rb.y_max) * 0.5) * 0.5}
    }
    if kind == CHART_HEATMAP {
        cell := c.heatmap_cell_bounds(index)
        << ChartCoordinate{x: cell.x + cell.width * 0.5,y: cell.y + cell.height * 0.5}
    }
    if kind == CHART_STACKED_AREA || kind == CHART_STACKED_BAR {
        stack := c.stacked_y(index)
        << c.data_position(p.x,stack.y)
    }
    if kind == CHART_WATERFALL {
        span := c.waterfall_span(index)
        << c.data_position(p.x,span.y)
    }
    if kind == CHART_BOXPLOT || kind == CHART_VIOLIN {
        b := c.bar_bounds(index)
        pos := c.data_position(p.x,datum_box_median(p))
        << ChartCoordinate{x: b.x + b.width * 0.5,y: pos.y}
    }
    if kind == CHART_DUMBBELL {
        b := c.bar_bounds(index)
        pos := c.data_position(p.x,datum_box_high(p))
        << ChartCoordinate{x: b.x + b.width * 0.5,y: pos.y}
    }
    if kind == CHART_LOLLIPOP {
        b := c.bar_bounds(index)
        pos := c.data_position(p.x,p.y)
        << ChartCoordinate{x: b.x + b.width * 0.5,y: pos.y}
    }
    if kind == CHART_CANDLESTICK { << c.data_position(p.x,datum_candle_close(p)) }
    << c.data_position(p.x,p.y)
}
