@ui

#errors
#strings
#strconv
#math
#ui/layout
#ui/internal/codec
#encoding/hex
#unicode/utf8

pub const EV_NATIVE_VIEW = 98
// A native child shares its parent's OS window, with its own non-repeating
// canvas identity. Copies are revoked together on dispose or parent closure.
pub struct NativeView {
    pub id int
    pub generation int
    pub window_id int
    pub parent_generation int
    bounds layout.Rect
    clip layout.Rect
    radius f64
    flags int
    epoch int
    placed bool
    disposed bool
}
pub struct NativeViewEvent {
    pub identity CanvasEvent
    pub payload string
}
pub fn native_view(parent &CanvasEvent,kind int) NativeView {
    if kind != CONTENT_WEBVIEW || parent.window_id != parent.canvas_id || parent.generation <= 0 {
        >> errors.new("ui: native children require a live draw window")
    }
    _ := register_content_plugin(content_plugin_webview())
    token := read_file(":xu:/__native_view_reserve/" + str(parent.window_id) + "/" + str(parent.generation) + "/" + str(kind)) or >>
    if token.len != 8 { >> errors.new("ui: native view registry is unavailable") }
    id := codec.read_word32(&token,0)
    generation := codec.read_word32(&token,4)
    if id == 0 || generation == 0 { >> errors.new("ui: native view allocation failed or capacity exceeded") }
    empty := layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}
    << NativeView{id: id,generation: generation,window_id: parent.window_id,parent_generation: parent.generation,
        bounds: empty,clip: empty,radius: 0.0,flags: 2,epoch: 0,placed: false,disposed: false}
}
pub fn (view &NativeView) identity() CanvasEvent {
    << CanvasEvent{window_id: view.window_id,canvas_id: view.id,generation: view.generation}
}
pub fn (view &NativeView) is_open() bool {
    if view.disposed { << false }
    data := read_file(":xu:/__native_view_info/" + str(view.id) + "/" + str(view.generation)) or (err) { << false }
    << data.len == 32 && codec.read_word32(&data,0) == view.id && codec.read_word32(&data,4) == view.generation && codec.read_word32(&data,20) > 0
}
pub fn (view &NativeView) is_ready() bool {
    if view.disposed { << false }
    data := read_file(":xu:/__native_view_info/" + str(view.id) + "/" + str(view.generation)) or (err) { << false }
    << data.len == 32 && codec.read_word32(&data,0) == view.id && codec.read_word32(&data,4) == view.generation && codec.read_word32(&data,20) == 2
}
fn native_view_rect_valid(rect &layout.Rect) bool {
    for value in [rect.x,rect.y,rect.width,rect.height] {
        if math.is_nan(value) || math.is_inf(value) || math.abs(value) > 1000000.0 { << false }
    }
    << rect.width >= 0.0 && rect.height >= 0.0
}
fn native_rect_equal(a &layout.Rect,b &layout.Rect) bool {
    << a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}
pub fn (view &mut NativeView) update(bounds &layout.Rect,clip &layout.Rect,radius f64,visible bool,enabled bool,focused bool) int {
    if view.disposed { >> errors.new("ui: native view is disposed") }
    if !native_view_rect_valid(bounds) || !native_view_rect_valid(clip) || math.is_nan(radius) || math.is_inf(radius) || radius < 0.0 || radius > 256.0 {
        >> errors.new("ui: invalid native view geometry")
    }
    mut flags := 0
    if visible { flags = flags | 1 }
    if enabled { flags = flags | 2 }
    if focused { flags = flags | 4 }
    if view.placed && view.flags == flags && view.radius == radius && native_rect_equal(&view.bounds,bounds) && native_rect_equal(&view.clip,clip) { if !view.is_open() { >> errors.new("ui: native view is closed") }
        << 0 }
    mut epoch := view.epoch
    if (view.flags & 4) != (flags & 4) { epoch = (epoch + 1) % 4294967296 }
    mut wire := strings.new_byte_builder(96)
    wire.write_str("XNV1")
    for value in [1,view.id,view.generation,flags,epoch] { codec.word(mut &wire,value,4) }
    for value in [bounds.x,bounds.y,bounds.width,bounds.height,clip.x,clip.y,clip.width,clip.height,radius] {
        codec.word(mut &wire,codec.finite_f64_bits(value),8)
    }
    payload := wire.to_string()
    accepted := write_file(":xu:/__native_view_update",payload) or >>
    if accepted != payload.len { >> errors.new("ui: native view update rejected") }
    view.bounds = layout.Rect{x: bounds.x,y: bounds.y,width: bounds.width,height: bounds.height}
    view.clip = layout.Rect{x: clip.x,y: clip.y,width: clip.width,height: clip.height}
    view.radius = radius
    view.flags = flags
    view.epoch = epoch
    view.placed = true
    << 0
}
pub fn write_native_view_slot(id int,generation int,name string,body string) int {
    if name.len > 64 || body.len > 1048576 { >> errors.new("ui: native view slot capacity exceeded") }
    mut wire := strings.new_byte_builder(24 + name.len + body.len)
    wire.write_str("XVS1")
    for value in [1,id,generation,name.len,body.len] { codec.word(mut &wire,value,4) }
    wire.write_str(name)
    wire.write_str(body)
    payload := wire.to_string()
    accepted := write_file(":xu:/__native_view_slot",payload) or >>
    if accepted != payload.len { >> errors.new("ui: native view slot write rejected") }
    << 0
}
pub fn (view &NativeView) write_slot(name string,body string) int {
    if view.disposed { >> errors.new("ui: native view is disposed") }
    << write_native_view_slot(view.id,view.generation,name,body) or >>
}
pub fn native_view_command(id int,generation int,line string) int {
    payload := str(id) + "\t" + str(generation) + "\t" + line
    accepted := write_file(":xu:/__native_view_command",payload) or >>
    if accepted != payload.len { >> errors.new("ui: native view command rejected") }
    << 0
}
pub fn (view &NativeView) command(line string) int {
    if view.disposed { >> errors.new("ui: native view is disposed") }
    << native_view_command(view.id,view.generation,line) or >>
}
pub fn (view &mut NativeView) dispose() int {
    if view.disposed { << 0 }
    mut wire := strings.new_byte_builder(8)
    codec.word(mut &wire,view.id,4)
    codec.word(mut &wire,view.generation,4)
    accepted := write_file(":xu:/__native_view_close",wire.to_string()) or >>
    if accepted != 8 { >> errors.new("ui: native view disposal rejected") }
    view.disposed = true
    << 0
}
fn decode_native_view_event(record &string) NativeViewEvent {
    fields := strings.split(record,"\t")
    if fields.len != 5 || fields[0] != "view" || fields[4].len > 131072 { >> errors.new("ui: invalid native view event") }
    window := strconv.atoi(&fields[1]) or >>
    id := strconv.atoi(&fields[2]) or >>
    generation := strconv.atoi(&fields[3]) or >>
    if window <= 0 || window >= 1073741824 || id <= 1073741824 || id > 2147483647 || generation <= 0 || generation > 4294967295 {
        >> errors.new("ui: invalid native view identity")
    }
    payload := hex.decode(&fields[4]) or >>
    if !utf8.valid(&payload) { >> errors.new("ui: invalid native event UTF-8") }
    << NativeViewEvent{identity: CanvasEvent{window_id: window,canvas_id: id,generation: generation},payload: payload}
}
pub fn native_view_event_of(event &Event) NativeViewEvent {
    if event.kind != EV_NATIVE_VIEW { >> errors.new("ui: expected a native view event") }
    result := decode_native_view_event(&event.menu_id) or >>
    if result.identity.window_id != event.window_id { >> errors.new("ui: inconsistent native view event") }
    << result
}
// Decode the scoped WebView lifecycle into the existing shell event vocabulary.
pub fn (event &NativeViewEvent) content_event() Event {
    queue := chan Event{cap: 4}
    push_host_event(queue,event.payload + "")
    mut result := poll_chan(queue)
    result.window_id = event.identity.window_id
    << result
}
