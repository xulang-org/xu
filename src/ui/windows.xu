@ui

#errors
#strings
#ui/internal/codec

// Checked native allocation. All windows share App's event channel; event.window_id
// identifies the sender. At most 64 live windows, with non-repeating identities.
pub fn (a $&App) open_window(opts WindowOpts) Window {
    << a.open_content_window(opts,CONTENT_NONE) or >>
}

pub fn (a $&App) open_content_window(opts WindowOpts,kind int) Window {
    $title := opts.title + ""
    if title.len == 0 { title = "Xu" }
    $width := opts.width
    $height := opts.height
    if width <= 0 { width = 800 }
    if height <= 0 { height = 600 }
    if width < 40 || height < 40 || width > 16384 || height > 16384 || title.len > 4096 || kind < 0 || kind > CONTENT_DRAW {
        >> errors.new("ui: invalid window options")
    }
    for i in 0:title.len { if (title[i] & 255) == 0 { >> errors.new("ui: window title contains NUL") } }
    if sim_enabled() || ui_tmp() != ":xu:" {
        id := a.alloc_id()
        if !a.has_window { a.win_title = title + ""
            a.win_w = width
            a.win_h = height
            a.has_window = true }
        << Window{id: id,generation: 0,title: title,width: width,height: height,content_kind: kind,content_backend_id: 0,closed: 0}
    }
    identity := read_file(":xu:/__window_reserve") or >>
    if identity.len != 8 { >> errors.new("ui: window registry is unavailable") }
    id := codec.read_word32(&identity,0)
    generation := codec.read_word32(&identity,4)
    if id == 0 || generation == 0 { >> errors.new("ui: window capacity exceeded") }
    $wire := strings.new_byte_builder(32 + title.len)
    wire.write_str("XUW1")
    codec.word($&wire,1,4)
    codec.word($&wire,id,4)
    codec.word($&wire,generation,4)
    codec.word($&wire,width,4)
    codec.word($&wire,height,4)
    codec.word($&wire,kind,4)
    codec.word($&wire,title.len,4)
    wire.write_str(title + "")
    payload := wire.to_string()
    accepted := write_file(":xu:/__window_open",payload) or (err) { abandon_window(id,generation)
        >> err }
    if accepted != payload.len { abandon_window(id,generation)
        >> errors.new("ui: window registration failed") }
    if !a.has_window { a.win_title = title + ""
        a.win_w = width
        a.win_h = height
        a.has_window = true }
    if a.next_id <= id { a.next_id = id + 1 }
    << Window{id: id,generation: generation,title: title,width: width,height: height,content_kind: kind,content_backend_id: 0,closed: 0}
}

fn abandon_window(id int,generation int) {
    $wire := strings.new_byte_builder(8)
    codec.word($&wire,id,4)
    codec.word($&wire,generation,4)
    write_file(":xu:/__window_abandon",wire.to_string()) or (err) { << }
}

pub fn (w &Window) command(line string) int {
    if w.closed != 0 || w.id <= 0 { >> errors.new("ui: window is closed") }
    if sim_enabled() { << 0 }
    if w.generation == 0 {
        if w.id != 1 { >> errors.new("ui: multiple windows require the in-process host") }
        << append_shell_cmd(line) or >>
    }
    payload := str(w.id) + "\t" + str(w.generation) + "\tshell." + line
    accepted := write_file(":xu:/__window_command",payload) or >>
    if accepted != payload.len { >> errors.new("ui: window command rejected") }
    << 0
}

pub fn (w &Window) content_command(line string) int {
    if w.closed != 0 || w.id <= 0 { >> errors.new("ui: window is closed") }
    if sim_enabled() { << 0 }
    if w.generation == 0 {
        if w.id != 1 { >> errors.new("ui: multiple windows require the in-process host") }
        << append_content_cmd(line) or >>
    }
    payload := str(w.id) + "\t" + str(w.generation) + "\tcontent." + line
    accepted := write_file(":xu:/__window_command",payload) or >>
    if accepted != payload.len { >> errors.new("ui: content command rejected") }
    << 0
}

pub fn (w $&Window) bind_content(kind int,backend_id int) int {
    if w.closed != 0 || kind < 1 || kind > CONTENT_DRAW { >> errors.new("ui: invalid content binding") }
    if w.content_kind != 0 && w.content_kind != kind { >> errors.new("ui: window content is already bound") }
    if w.generation != 0 {
        $wire := strings.new_byte_builder(12)
        codec.word($&wire,w.id,4)
        codec.word($&wire,w.generation,4)
        codec.word($&wire,kind,4)
        payload := wire.to_string()
        accepted := write_file(":xu:/__window_bind",payload) or >>
        if accepted != payload.len { >> errors.new("ui: content binding rejected") }
    }
    w.content_kind = kind
    w.content_backend_id = backend_id
    << 0
}

pub fn (w &Window) show() int { << w.command("show") or >> }
pub fn (w &Window) hide() int { << w.command("hide") or >> }
pub fn (w &Window) focus() int { << w.command("show") or >> }
pub fn (w $&Window) resize(width int,height int) int {
    if width < 40 || height < 40 || width > 16384 || height > 16384 { >> errors.new("ui: invalid window size") }
    w.command("size\t" + str(width) + "\t" + str(height)) or >>
    w.width = width
    w.height = height
    << 0
}
pub fn (w $&Window) request_close() int {
    w.command("close") or >>
    << 0
}

// Per-window native configuration. Late writes are rejected by the registry.
pub fn write_window_slot(id int,generation int,name string,body string) int {
    if generation == 0 {
        if id != 1 { >> errors.new("ui: multiple windows require the in-process host") }
        << write_file(ui_tmp() + "/" + name,body) or >>
    }
    if name.len > 64 || body.len > 1048576 { >> errors.new("ui: window slot capacity exceeded") }
    $wire := strings.new_byte_builder(24 + name.len + body.len)
    wire.write_str("XWS1")
    codec.word($&wire,1,4)
    codec.word($&wire,id,4)
    codec.word($&wire,generation,4)
    codec.word($&wire,name.len,4)
    codec.word($&wire,body.len,4)
    wire.write_str(name)
    wire.write_str(body)
    payload := wire.to_string()
    accepted := write_file(":xu:/__window_slot",payload) or >>
    if accepted != payload.len { >> errors.new("ui: window slot write rejected") }
    << 0
}

pub fn (w &Window) write_slot(name string,body string) int {
    if w.closed != 0 { >> errors.new("ui: window is closed") }
    << write_window_slot(w.id,w.generation,name,body) or >>
}

// Allocation is asynchronous. is_open includes queued/creating windows; ready
// additionally requires native creation. Native close revokes every copied handle.
pub fn (w &Window) is_open() bool {
    if w.closed != 0 || w.id <= 0 { << false }
    if w.generation == 0 { << true }
    data := read_file(":xu:/__window_info/" + str(w.id) + "/" + str(w.generation)) or (err) { << false }
    << data.len == 24 && codec.read_word32(&data,0) == w.id && codec.read_word32(&data,4) == w.generation && codec.read_word32(&data,20) >= 2
}
pub fn (w &Window) is_ready() bool {
    if w.closed != 0 || w.id <= 0 || w.generation == 0 { << false }
    data := read_file(":xu:/__window_info/" + str(w.id) + "/" + str(w.generation)) or (err) { << false }
    << data.len == 24 && codec.read_word32(&data,0) == w.id && codec.read_word32(&data,4) == w.generation && codec.read_word32(&data,20) == 4
}
