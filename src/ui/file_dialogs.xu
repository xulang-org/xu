@ui

#errors
#strings
#strconv
#encoding/hex

pub const request_open_files = 4
pub const request_save_file = 5
pub const request_select_folders = 6

pub struct FileFilter {
    pub label string
    // Extensions without a leading dot; "*" allows all files.
    pub extensions []string
}

pub struct FileDialogOptions {
    pub title string
    pub directory string
    pub name string
    pub filters []FileFilter
    pub multiple bool
    // Zero selects 300000 ms. Selecting a save path does not write a file.
    pub timeout_ms int
}

pub fn file_dialog_options() FileDialogOptions {
    << FileDialogOptions{title: "",directory: "",name: "",filters: []FileFilter{},multiple: false,timeout_ms: 300000}
}

fn file_absolute(path &string) bool {
    if path.len == 0 { << false }
    if (path[0] & 255) == 47 { << true }
    if path.len < 3 { << false }
    a := path[0] & 255
    if a == 92 && (path[1] & 255) == 92 { << true }
    << ((a >= 65 && a <= 90) || (a >= 97 && a <= 122)) && (path[1] & 255) == 58 &&
       ((path[2] & 255) == 47 || (path[2] & 255) == 92)
}

fn file_extension(ext &string) bool {
    if ext.len == 1 && (ext[0] & 255) == 42 { << true }
    if ext.len == 0 || ext.len > 32 || (ext[0] & 255) == 46 || (ext[ext.len - 1] & 255) == 46 { << false }
    mut last := 0
    for i in 0:ext.len {
        c := ext[i] & 255
        if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) ||
             c == 95 || c == 45 || c == 43 || (c == 46 && last != 46)) { << false }
        last = c
    }
    << true
}

fn submit_file_dialog(target &CanvasEvent, kind int, options &FileDialogOptions) Request {
    if options.title.len > 4096 || options.directory.len > 8192 || options.name.len > 1024 || options.filters.len > 16 ||
       !request_text_valid(&options.title) || !request_text_valid(&options.directory) || !request_text_valid(&options.name) {
        >> errors.new("ui: file options exceed UTF-8 limits")
    }
    if options.directory.len > 0 && !file_absolute(&options.directory) { >> errors.new("ui: initial directory must be absolute") }
    if (kind == request_save_file && options.multiple) || (kind != request_save_file && options.name.len > 0) ||
       (kind == request_select_folders && options.filters.len > 0) || options.name == "." || options.name == ".." {
        >> errors.new("ui: incompatible file options")
    }
    for i in 0:options.name.len {
        c := options.name[i] & 255
        if c == 47 || c == 92 { >> errors.new("ui: suggested name must be a single filename") }
    }
    mut multiple := 0
    if options.multiple { multiple = 1 }
    mut seed := "F1\t" + str(multiple) + "\t" + hex.encode(&options.directory) + "\t" + hex.encode(&options.name) + "\t" + str(options.filters.len)
    for i in 0:options.filters.len {
        label := options.filters[i].label + ""
        count := options.filters[i].extensions.len
        if label.len == 0 || label.len > 256 || !request_text_valid(&label) || count == 0 || count > 16 {
            >> errors.new("ui: invalid file filter")
        }
        seed = seed + "\t" + hex.encode(&label) + "\t" + str(count)
        for j in 0:count {
            ext := options.filters[i].extensions[j] + ""
            if !file_extension(&ext) { >> errors.new("ui: invalid file extension") }
            seed = seed + "\t" + ext
        }
    }
    mut timeout := options.timeout_ms
    if timeout == 0 { timeout = 300000 }
    << submit_request(target,kind,&options.title,&seed,timeout,0) or >>
}

// Results arrive through ev_request. Paths are decoded only after completion.
pub fn open_files_async(target &CanvasEvent, options &FileDialogOptions) Request {
    << submit_file_dialog(target,request_open_files,options) or >>
}

pub fn save_file_async(target &CanvasEvent, options &FileDialogOptions) Request {
    << submit_file_dialog(target,request_save_file,options) or >>
}

pub fn select_folders_async(target &CanvasEvent, options &FileDialogOptions) Request {
    << submit_file_dialog(target,request_select_folders,options) or >>
}

// Encoded path elements preserve filename tabs/newlines. Never split paths on
// whitespace or infer cancellation from an empty filename.
pub fn file_paths(result &RequestResult) []string {
    if result.status != request_completed || result.request.kind < request_open_files || result.request.kind > request_select_folders || result.value.len > 65536 {
        >> errors.new("ui: expected a completed file dialog result")
    }
    fields := strings.split(&result.value,"\t")
    if fields.len < 3 || fields[0] != "XUF1" { >> errors.new("ui: invalid file result") }
    count := strconv.atoi(&fields[1]) or >>
    if count < 1 || count > 64 || fields[1] != str(count) || fields.len != count + 2 ||
       (result.request.kind == request_save_file && count != 1) { >> errors.new("ui: invalid file result count") }
    mut paths := []string{}
    for i in 0:count {
        index := i + 2
        path := hex.decode(&fields[index]) or >>
        if !request_text_valid(&path) || !file_absolute(&path) { >> errors.new("ui: invalid selected path") }
        paths.push(path)
    }
    << paths
}
