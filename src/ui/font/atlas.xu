@ui/font

#errors
#math

pub struct AtlasEntry {
    pub u0 f64
    pub v0 f64
    pub u1 f64
    pub v1 f64
    pub offset_x int
    pub offset_y int
    pub w int
    pub h int
    pub has_ink bool
    font_id int
    glyph_id int
    px_q int
}

pub struct GlyphBitmap {
    pub w int
    pub h int
    pub offset_x int
    pub offset_y int
    pub pixels []u8
}

pub struct GlyphAtlas {
    pub width int
    pub height int
    pub max_width int
    pub max_height int
    pub revision int
    pub pixels []u8
    pub entries []AtlasEntry
    cursor_x int
    cursor_y int
    shelf_h int
    index map[int]int
}

fn atlas_entry_key(font_id int, glyph_id int, px_q int) int {
    << ((font_id & 65535) << 40) | ((glyph_id & 1048575) << 20) | (px_q & 1048575)
}

pub fn new_glyph_atlas(init_w int, init_h int, max_w int, max_h int) GlyphAtlas {
    if init_w <= 0 || init_h <= 0 || max_w < init_w || max_h < init_h {
        >> errors.new("ui/font: invalid atlas dimensions")
    }
    if init_w > 8192 || init_h > 8192 || max_w > 8192 || max_h > 8192 {
        >> errors.new("ui/font: atlas dimensions too large")
    }
    $pixels := []u8{}
    n := init_w * init_h
    for i in 0:n {
        pixels.push(u8(0))
    }
    << GlyphAtlas{
        width: init_w,
        height: init_h,
        max_width: max_w,
        max_height: max_h,
        revision: 1,
        pixels: pixels,
        entries: []AtlasEntry{},
        cursor_x: 1,
        cursor_y: 1,
        shelf_h: 0,
        index: map[int]int{}
    }
}

pub fn default_glyph_atlas() GlyphAtlas {
    << new_glyph_atlas(DEFAULT_ATLAS_INIT, DEFAULT_ATLAS_INIT, DEFAULT_ATLAS_MAX, DEFAULT_ATLAS_MAX) or >>
}

pub fn (atlas &GlyphAtlas) entry_index(font_id int, glyph_id int, size f64) int {
    px_q := quantize_px_size(size) or (err) {
        << -1
    }
    key := atlas_entry_key(font_id, glyph_id, px_q)
    if atlas.index.has(key) {
        << atlas.index[key]
    }
    << -1
}

fn (atlas $&GlyphAtlas) set_entry_uv(idx int, x int, y int, w int, h int) {
    wf := f64(atlas.width)
    hf := f64(atlas.height)
    $e := atlas.entries[idx]
    e.u0 = f64(x) / wf
    e.v0 = f64(y) / hf
    e.u1 = f64(x + w) / wf
    e.v1 = f64(y + h) / hf
    atlas.entries[idx] = e
}

fn (atlas $&GlyphAtlas) grow(need_w int, need_h int) int {
    $nw := atlas.width
    $nh := atlas.height
    while nw < need_w || nh < need_h {
        $grew := false
        if nw < atlas.max_width && nw < need_w {
            $next := nw * 2
            if next > atlas.max_width {
                next = atlas.max_width
            }
            if next > nw {
                nw = next
                grew = true
            }
        }
        if nh < atlas.max_height && nh < need_h {
            $next2 := nh * 2
            if next2 > atlas.max_height {
                next2 = atlas.max_height
            }
            if next2 > nh {
                nh = next2
                grew = true
            }
        }
        if !grew {
            if nw < need_w && nw < atlas.max_width {
                nw = atlas.max_width
                grew = true
            }
            if nh < need_h && nh < atlas.max_height {
                nh = atlas.max_height
                grew = true
            }
        }
        if !grew {
            >> errors.new("ui/font: atlas capacity exhausted")
        }
    }
    if nw == atlas.width && nh == atlas.height {
        << 0
    }
    $np := []u8{}
    total := nw * nh
    for i in 0:total {
        np.push(u8(0))
    }
    for y in 0:atlas.height {
        for x in 0:atlas.width {
            np[y * nw + x] = atlas.pixels[y * atlas.width + x]
        }
    }
    // Rebuild UVs for existing entries from previous UV * old size.
    old_w := atlas.width
    old_h := atlas.height
    atlas.pixels = np
    atlas.width = nw
    atlas.height = nh
    for i in 0:atlas.entries.len {
        $e := atlas.entries[i]
        if e.has_ink && e.w > 0 && e.h > 0 {
            x := int(math.round(e.u0 * f64(old_w)))
            y := int(math.round(e.v0 * f64(old_h)))
            e.u0 = f64(x) / f64(nw)
            e.v0 = f64(y) / f64(nh)
            e.u1 = f64(x + e.w) / f64(nw)
            e.v1 = f64(y + e.h) / f64(nh)
            atlas.entries[i] = e
        }
    }
    atlas.revision = atlas.revision + 1
    << 0
}

fn (atlas $&GlyphAtlas) alloc_xy(w int, h int, out_x $&int, out_y $&int) int {
    pad := 1
    bw := w + pad
    bh := h + pad
    if bw >= atlas.max_width || bh >= atlas.max_height {
        >> errors.new("ui/font: glyph larger than atlas max")
    }
    for attempt in 0:8 {
        if atlas.cursor_x + bw >= atlas.width {
            atlas.cursor_x = 1
            atlas.cursor_y = atlas.cursor_y + atlas.shelf_h + pad
            atlas.shelf_h = 0
        }
        if atlas.cursor_y + bh >= atlas.height {
            $need_w := atlas.width
            need_h := atlas.cursor_y + bh + 1
            if need_w < bw + 2 {
                need_w = bw + 2
            }
            atlas.grow(need_w, need_h) or >>
            ->
        }
        if atlas.cursor_x + bw >= atlas.width {
            atlas.grow(atlas.cursor_x + bw + 1, atlas.height) or >>
            ->
        }
        *out_x = atlas.cursor_x
        *out_y = atlas.cursor_y
        atlas.cursor_x = atlas.cursor_x + bw
        if bh > atlas.shelf_h {
            atlas.shelf_h = bh
        }
        << 0
    }
    >> errors.new("ui/font: failed to pack glyph")
}

fn (atlas $&GlyphAtlas) blit(x int, y int, bmp &GlyphBitmap) int {
    if bmp.w <= 0 || bmp.h <= 0 {
        << 0
    }
    if bmp.pixels.len < bmp.w * bmp.h {
        >> errors.new("ui/font: bitmap pixel length mismatch")
    }
    for row in 0:bmp.h {
        dst := (y + row) * atlas.width + x
        src := row * bmp.w
        for col in 0:bmp.w {
            atlas.pixels[dst + col] = bmp.pixels[src + col]
        }
    }
    << 0
}

pub fn (atlas $&GlyphAtlas) insert_bitmap(rg ResolvedGlyph, size f64, bmp &GlyphBitmap) int {
    px_q := quantize_px_size(size) or >>
    key := atlas_entry_key(rg.font_id, rg.glyph_id, px_q)
    if atlas.index.has(key) {
        << atlas.index[key]
    }
    has_ink := bmp.w > 0 && bmp.h > 0
    $x := 0
    $y := 0
    if has_ink {
        atlas.alloc_xy(bmp.w, bmp.h, $&x, $&y) or >>
        atlas.blit(x, y, bmp) or >>
    }
    $entry := AtlasEntry{
        u0: 0.0,
        v0: 0.0,
        u1: 0.0,
        v1: 0.0,
        offset_x: bmp.offset_x,
        offset_y: bmp.offset_y,
        w: bmp.w,
        h: bmp.h,
        has_ink: has_ink,
        font_id: rg.font_id,
        glyph_id: rg.glyph_id,
        px_q: px_q
    }
    idx := atlas.entries.len
    atlas.entries.push(entry)
    if has_ink {
        atlas.set_entry_uv(idx, x, y, bmp.w, bmp.h)
    }
    atlas.index[key] = idx
    atlas.revision = atlas.revision + 1
    << idx
}

pub fn (atlas $&GlyphAtlas) get_or_rasterize(stack &FontStack, rg ResolvedGlyph, size f64) AtlasEntry {
    idx := atlas.entry_index(rg.font_id, rg.glyph_id, size)
    if idx >= 0 {
        << atlas.entries[idx]
    }
    px_q := quantize_px_size(size) or >>
    q_size := f64(px_q) / 4.0
    bmp := stack.rasterize(rg, q_size) or >>
    ni := atlas.insert_bitmap(rg, size, &bmp) or >>
    << atlas.entries[ni]
}
