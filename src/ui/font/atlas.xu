@ui/font

#errors
#math

pub struct AtlasEntry {
    pub font_id int
    pub glyph_id int
    pub px_size_q int
    pub x int
    pub y int
    pub w int
    pub h int
    pub offset_x int
    pub offset_y int
    pub advance_x f64
    pub u0 f64
    pub v0 f64
    pub u1 f64
    pub v1 f64
    pub has_ink bool
}

pub struct GlyphAtlas {
    pub width int
    pub height int
    pub max_width int
    pub max_height int
    pub revision int
    pub pixels []u8
    pub entries []AtlasEntry
    shelf_x int
    shelf_y int
    shelf_h int
    buckets []int
}

pub fn quantize_px_size(px_size f64) int {
    if math.is_nan(px_size) || math.is_inf(px_size) || px_size <= 0.0 {
        >> errors.new("font: invalid pixel size")
    }
    $q := int(math.floor(px_size * 4.0 + 0.5))
    if q < 4 { q = 4 }
    << q
}

fn hash_triple(font_id int, glyph_id int, px_q int) int {
    $h := font_id * 1000003 + glyph_id * 9176 + px_q * 131
    h = h ^ (h >> 16)
    if h < 0 { h = 0 - h }
    << h
}

fn empty_buckets(cap int) []int {
    $b := []int{}
    for i in 0:cap {
        b.push(-1)
    }
    << b
}

pub fn new_glyph_atlas(width int, height int, max_width int, max_height int) GlyphAtlas {
    if width < 64 || height < 64 || max_width < width || max_height < height ||
       max_width > 4096 || max_height > 4096 {
        >> errors.new("font: invalid glyph atlas dimensions")
    }
    $pixels := []u8{}
    total := width * height
    for i in 0:total {
        pixels.push(u8(0))
    }
    << GlyphAtlas{
        width: width,
        height: height,
        max_width: max_width,
        max_height: max_height,
        revision: 1,
        pixels: pixels,
        entries: []AtlasEntry{},
        shelf_x: 1,
        shelf_y: 1,
        shelf_h: 0,
        buckets: empty_buckets(256)
    }
}

pub fn default_glyph_atlas() GlyphAtlas {
    << new_glyph_atlas(512, 512, 2048, 2048) >>>
}

pub fn (atlas $&GlyphAtlas) clear() {
    for i in 0:atlas.pixels.len {
        atlas.pixels[i] = u8(0)
    }
    atlas.entries = []AtlasEntry{}
    atlas.shelf_x = 1
    atlas.shelf_y = 1
    atlas.shelf_h = 0
    for i in 0:atlas.buckets.len {
        atlas.buckets[i] = -1
    }
    atlas.revision += 1
}

fn (atlas &GlyphAtlas) lookup_index(font_id int, glyph_id int, px_q int) int {
    n := atlas.buckets.len
    if n <= 0 {
        << -1
    }
    mask := n - 1
    $slot := hash_triple(font_id, glyph_id, px_q) & mask
    for step in 0:n {
        idx := atlas.buckets[slot]
        if idx < 0 {
            << -1
        }
        e := atlas.entries[idx]
        if e.font_id == font_id && e.glyph_id == glyph_id && e.px_size_q == px_q {
            << idx
        }
        slot = (slot + 1) & mask
    }
    << -1
}

fn (atlas $&GlyphAtlas) rebuild_buckets(new_cap int) {
    $nb := empty_buckets(new_cap)
    mask := new_cap - 1
    for i in 0:atlas.entries.len {
        e := atlas.entries[i]
        $slot := hash_triple(e.font_id, e.glyph_id, e.px_size_q) & mask
        while nb[slot] >= 0 {
            slot = (slot + 1) & mask
        }
        nb[slot] = i
    }
    atlas.buckets = nb
}

fn (atlas $&GlyphAtlas) insert_bucket(entry_idx int, font_id int, glyph_id int, px_q int) {
    if (atlas.entries.len + 1) * 2 >= atlas.buckets.len {
        $next_cap := atlas.buckets.len * 2
        if next_cap < 256 { next_cap = 256 }
        atlas.rebuild_buckets(next_cap)
    }
    n := atlas.buckets.len
    mask := n - 1
    $slot := hash_triple(font_id, glyph_id, px_q) & mask
    while atlas.buckets[slot] >= 0 {
        slot = (slot + 1) & mask
    }
    atlas.buckets[slot] = entry_idx
}

fn (atlas $&GlyphAtlas) grow(need_w int, need_h int) bool {
    $next_w := atlas.width
    $next_h := atlas.height
    if (need_w > atlas.width - 2 || (atlas.width <= atlas.height && atlas.width * 2 <= atlas.max_width)) &&
       atlas.width * 2 <= atlas.max_width {
        next_w = atlas.width * 2
    } else if atlas.height * 2 <= atlas.max_height {
        next_h = atlas.height * 2
    } else if atlas.width * 2 <= atlas.max_width {
        next_w = atlas.width * 2
    } else {
        << false
    }
    if next_w == atlas.width && next_h == atlas.height {
        << false
    }

    $npix := []u8{}
    for i in 0:(next_w * next_h) {
        npix.push(u8(0))
    }
    for row in 0:atlas.height {
        src_base := row * atlas.width
        dst_base := row * next_w
        for col in 0:atlas.width {
            npix[dst_base + col] = atlas.pixels[src_base + col]
        }
    }
    atlas.pixels = npix
    atlas.width = next_w
    atlas.height = next_h

    fw := f64(next_w)
    fh := f64(next_h)
    for i in 0:atlas.entries.len {
        e := atlas.entries[i]
        if e.has_ink {
            atlas.entries[i] = AtlasEntry{
                font_id: e.font_id,
                glyph_id: e.glyph_id,
                px_size_q: e.px_size_q,
                x: e.x,
                y: e.y,
                w: e.w,
                h: e.h,
                offset_x: e.offset_x,
                offset_y: e.offset_y,
                advance_x: e.advance_x,
                u0: f64(e.x) / fw,
                v0: f64(e.y) / fh,
                u1: f64(e.x + e.w) / fw,
                v1: f64(e.y + e.h) / fh,
                has_ink: true
            }
        }
    }
    atlas.revision += 1
    << true
}

struct AtlasPos {
    x int
    y int
}

fn (atlas $&GlyphAtlas) alloc_rect(w int, h int) AtlasPos {
    $attempt := 0
    while attempt < 8 {
        if w + 2 <= atlas.width && h + 2 <= atlas.height {
            if atlas.shelf_x + w + 1 > atlas.width {
                atlas.shelf_y += atlas.shelf_h + 1
                atlas.shelf_x = 1
                atlas.shelf_h = 0
            }
            if atlas.shelf_y + h + 1 <= atlas.height {
                px := atlas.shelf_x
                py := atlas.shelf_y
                atlas.shelf_x += w + 1
                if h > atlas.shelf_h {
                    atlas.shelf_h = h
                }
                << AtlasPos{x: px, y: py}
            }
        }
        if !atlas.grow(w + 2, h + 2) {
            >> errors.new("font: glyph atlas capacity exceeded")
        }
        attempt += 1
    }
    >> errors.new("font: glyph atlas allocation failed")
}

pub fn (atlas &GlyphAtlas) entry_index(font_id int, glyph_id int, px_size f64) int {
    px_q := quantize_px_size(px_size) >>> (err) { << -1 }
    << atlas.lookup_index(font_id, glyph_id, px_q)
}

fn (atlas $&GlyphAtlas) insert_bitmap_quantized(glyph ResolvedGlyph, px_q int, bmp &GlyphBitmap) AtlasEntry {
    existing := atlas.lookup_index(glyph.font_id, glyph.glyph_id, px_q)
    if existing >= 0 {
        << atlas.entries[existing]
    }
    if bmp.width <= 0 || bmp.height <= 0 || bmp.pixels.len == 0 {
        entry := AtlasEntry{
            font_id: glyph.font_id,
            glyph_id: glyph.glyph_id,
            px_size_q: px_q,
            x: 0,
            y: 0,
            w: 0,
            h: 0,
            offset_x: 0,
            offset_y: 0,
            advance_x: bmp.advance_x,
            u0: 0.0,
            v0: 0.0,
            u1: 0.0,
            v1: 0.0,
            has_ink: false
        }
        idx := atlas.entries.len
        atlas.entries.push(entry)
        atlas.insert_bucket(idx, glyph.font_id, glyph.glyph_id, px_q)
        << entry
    }

    pos := atlas.alloc_rect(bmp.width, bmp.height) >>>
    px := pos.x
    py := pos.y
    for row in 0:bmp.height {
        src_base := row * bmp.width
        dst_base := (py + row) * atlas.width + px
        for col in 0:bmp.width {
            atlas.pixels[dst_base + col] = bmp.pixels[src_base + col]
        }
    }
    atlas.revision += 1

    fw := f64(atlas.width)
    fh := f64(atlas.height)
    entry := AtlasEntry{
        font_id: glyph.font_id,
        glyph_id: glyph.glyph_id,
        px_size_q: px_q,
        x: px,
        y: py,
        w: bmp.width,
        h: bmp.height,
        offset_x: bmp.offset_x,
        offset_y: bmp.offset_y,
        advance_x: bmp.advance_x,
        u0: f64(px) / fw,
        v0: f64(py) / fh,
        u1: f64(px + bmp.width) / fw,
        v1: f64(py + bmp.height) / fh,
        has_ink: true
    }
    idx := atlas.entries.len
    atlas.entries.push(entry)
    atlas.insert_bucket(idx, glyph.font_id, glyph.glyph_id, px_q)
    << entry
}

pub fn (atlas $&GlyphAtlas) insert_bitmap(glyph ResolvedGlyph, px_size f64, bmp &GlyphBitmap) AtlasEntry {
    px_q := quantize_px_size(px_size) >>>
    << atlas.insert_bitmap_quantized(glyph, px_q, bmp) >>>
}

pub fn (atlas $&GlyphAtlas) get_or_rasterize(stack &FontStack, glyph ResolvedGlyph, px_size f64) AtlasEntry {
    px_q := quantize_px_size(px_size) >>>
    existing := atlas.lookup_index(glyph.font_id, glyph.glyph_id, px_q)
    if existing >= 0 {
        << atlas.entries[existing]
    }

    q_size := f64(px_q) / 4.0
    bmp := stack.rasterize(glyph, q_size) >>>
    << atlas.insert_bitmap_quantized(glyph, px_q, &bmp) >>>
}

pub fn (atlas $&GlyphAtlas) get_codepoint(stack &FontStack, codepoint int, px_size f64) AtlasEntry {
    glyph := stack.resolve(codepoint) >>>
    << atlas.get_or_rasterize(stack, glyph, px_size) >>>
}

pub fn (atlas &GlyphAtlas) entry_count() int {
    << atlas.entries.len
}

pub fn (atlas &GlyphAtlas) sample_alpha(px int, py int) int {
    if px < 0 || py < 0 || px >= atlas.width || py >= atlas.height {
        << 0
    }
    << int(atlas.pixels[py * atlas.width + px]) & 255
}

pub fn (atlas &GlyphAtlas) to_rgba8_white() []u8 {
    $out := []u8{}
    for i in 0:atlas.pixels.len {
        a := atlas.pixels[i]
        out.push(u8(255))
        out.push(u8(255))
        out.push(u8(255))
        out.push(a)
    }
    << out
}
