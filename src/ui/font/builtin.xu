@ui/font

#errors
#math

const BUILTIN_UPM = 16
const BUILTIN_ASCENT = 12
const BUILTIN_DESCENT = -4
const BUILTIN_CELL_W = 8
const BUILTIN_CELL_H = 16

const BUILTIN_ASCII = ""

fn make_builtin_face(font_id int, priority int) FontFace {
    << FontFace{
        font_id: font_id,
        face_index: 0,
        priority: priority,
        kind: FACE_BUILTIN,
        units_per_em: BUILTIN_UPM,
        ascent: BUILTIN_ASCENT,
        descent: BUILTIN_DESCENT,
        line_gap: 0,
        num_glyphs: 95,
        ttf_bytes: []u8{},
        cmap_starts: []int{},
        cmap_ends: []int{},
        cmap_deltas: []int{},
        cmap_offsets: []int{},
        cmap_glyph_ids: []int{},
        advances: []int{},
        left_bearings: []int{},
        loca: []int{},
        glyf_off: 0,
        glyf_len: 0,
        is_short_loca: false
    }
}

fn builtin_lookup(cp int) int {
    if cp >= 32 && cp <= 126 {
        << cp
    }
    << -1
}

fn builtin_advance_em(glyph_id int) int {
    << BUILTIN_CELL_W
}

fn builtin_hex(data &string, at int, digits int) int {
    $v := 0
    for i in 0:digits {
        if at + i >= data.len {
            << v
        }
        c := data[at + i]
        $d := c - 48
        if c >= 97 {
            d = c - 87
        } else if c >= 65 {
            d = c - 55
        }
        v = (v << 4) | d
    }
    << v
}

fn builtin_row_bits(glyph_id int, row int) int {
    if row < 0 || row >= BUILTIN_CELL_H {
        << 0
    }
    if glyph_id < 32 || glyph_id > 126 {
        << 0
    }
    ascii := BUILTIN_ASCII
    << builtin_hex(&ascii, ((glyph_id - 32) * BUILTIN_CELL_H + row) * 2, 2)
}

fn builtin_rasterize(face &FontFace, glyph_id int, px_size f64) GlyphBitmap {
    scale := px_size / f64(BUILTIN_UPM)
    $dw := int(math.round(f64(BUILTIN_CELL_W) * scale))
    $dh := int(math.round(f64(BUILTIN_CELL_H) * scale))
    if dw < 1 {
        dw = 1
    }
    if dh < 1 {
        dh = 1
    }
    ox := 0
    oy := -int(math.round(f64(BUILTIN_ASCENT) * scale))
    if glyph_id == 32 || glyph_id < 32 || glyph_id > 126 {
        << GlyphBitmap{
            w: 0,
            h: 0,
            offset_x: 0,
            offset_y: 0,
            pixels: []u8{}
        }
    }
    $pixels := []u8{}
    for y in 0:dh {
        $src_y := int(f64(y) * f64(BUILTIN_CELL_H) / f64(dh))
        if src_y >= BUILTIN_CELL_H {
            src_y = BUILTIN_CELL_H - 1
        }
        bits := builtin_row_bits(glyph_id, src_y)
        for x in 0:dw {
            $src_x := int(f64(x) * f64(BUILTIN_CELL_W) / f64(dw))
            if src_x >= BUILTIN_CELL_W {
                src_x = BUILTIN_CELL_W - 1
            }
            on := ((bits >> (7 - src_x)) & 1) != 0
            if on {
                pixels.push(u8(255))
            } else {
                pixels.push(u8(0))
            }
        }
    }
    << GlyphBitmap{
        w: dw,
        h: dh,
        offset_x: ox,
        offset_y: oy,
        pixels: pixels
    }
}
