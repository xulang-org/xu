@ui/font

#math

pub fn builtin_font(face_id int) FontFace {
    metrics := FontMetrics{
        units_per_em: 1000,
        ascent: 820,
        descent: -220,
        line_gap: 110,
        x_min: 0,
        y_min: -220,
        x_max: 600,
        y_max: 820,
        num_glyphs: 97
    }
    << FontFace{
        id: face_id,
        metrics: metrics,
        is_builtin: true,
        num_hmetrics: 97,
        index_to_loc_format: 0,
        cmap_format: 4,
        cmap_ranges: []CmapRange{},
        cmap_glyph_ids: []int{},
        hmtx: []u8{},
        loca: []u8{},
        glyf: []u8{},
        kern_pairs: []KernPair{}
    }
}

pub fn builtin_glyph_index(codepoint int) int {
    if codepoint >= 32 && codepoint <= 126 {
        << (codepoint - 32) + 1
    }
    if codepoint == 8226 {
        << 96
    }
    << 0
}

fn builtin_glyph_advance(glyph_id int) int {
    if glyph_id == 1 {
        << 340
    }
    // Narrow punctuation / thin letters
    cp := glyph_id + 31
    if glyph_id >= 2 && glyph_id <= 95 {
        if cp == 33 || cp == 39 || cp == 44 || cp == 46 || cp == 58 || cp == 59 || cp == 105 || cp == 108 || cp == 124 {
            << 340
        }
        if cp == 102 || cp == 106 || cp == 114 || cp == 116 || cp == 40 || cp == 41 || cp == 91 || cp == 93 || cp == 123 || cp == 125 || cp == 73 {
            << 440
        }
        if cp == 77 || cp == 87 || cp == 109 || cp == 119 || cp == 64 || cp == 37 {
            << 640
        }
    }
    << 560
}

pub fn builtin_glyph_metrics(glyph_id int) GlyphMetrics {
    adv := builtin_glyph_advance(glyph_id)
    if glyph_id == 1 {
        << GlyphMetrics{glyph_id: glyph_id, advance_width: adv, left_side_bearing: 0}
    }
    << GlyphMetrics{glyph_id: glyph_id, advance_width: adv, left_side_bearing: 60}
}

fn append_ccw_box(points $&[]ContourPoint, ends $&[]int, x0 f64, y0 f64, x1 f64, y1 f64) {
    points.push(ContourPoint{x: x0, y: y0, on_curve: true})
    points.push(ContourPoint{x: x1, y: y0, on_curve: true})
    points.push(ContourPoint{x: x1, y: y1, on_curve: true})
    points.push(ContourPoint{x: x0, y: y1, on_curve: true})
    ends.push(points.len - 1)
}

fn append_cw_box(points $&[]ContourPoint, ends $&[]int, x0 f64, y0 f64, x1 f64, y1 f64) {
    points.push(ContourPoint{x: x0, y: y0, on_curve: true})
    points.push(ContourPoint{x: x0, y: y1, on_curve: true})
    points.push(ContourPoint{x: x1, y: y1, on_curve: true})
    points.push(ContourPoint{x: x1, y: y0, on_curve: true})
    ends.push(points.len - 1)
}

fn append_dot_octagon(points $&[]ContourPoint, ends $&[]int, cx f64, cy f64, r f64) {
    d := r * 0.70710678
    points.push(ContourPoint{x: cx + r, y: cy, on_curve: true})
    points.push(ContourPoint{x: cx + d, y: cy + d, on_curve: true})
    points.push(ContourPoint{x: cx, y: cy + r, on_curve: true})
    points.push(ContourPoint{x: cx - d, y: cy + d, on_curve: true})
    points.push(ContourPoint{x: cx - r, y: cy, on_curve: true})
    points.push(ContourPoint{x: cx - d, y: cy - d, on_curve: true})
    points.push(ContourPoint{x: cx, y: cy - r, on_curve: true})
    points.push(ContourPoint{x: cx + d, y: cy - d, on_curve: true})
    ends.push(points.len - 1)
}

fn append_capsule_stroke(points $&[]ContourPoint, ends $&[]int,
                         x0 f64, y0 f64, x1 f64, y1 f64, hw f64) {
    dx := x1 - x0
    dy := y1 - y0
    len2 := dx * dx + dy * dy
    if len2 <= 1.0 {
        append_dot_octagon(points, ends, x0, y0, hw * 1.15)
        <<
    }
    inv := 1.0 / math.sqrt(len2)
    tx := dx * inv
    ty := dy * inv
    nx := 0.0 - ty
    ny := tx
    cap := hw * 0.5
    b_x := x0 - tx * cap
    b_y := y0 - ty * cap
    e_x := x1 + tx * cap
    e_y := y1 + ty * cap
    // CCW around directed stroke (dx, dy): right side -> tip -> left side -> back
    points.push(ContourPoint{x: b_x - nx * hw * 0.75, y: b_y - ny * hw * 0.75, on_curve: true})
    points.push(ContourPoint{x: x0 - nx * hw, y: y0 - ny * hw, on_curve: true})
    points.push(ContourPoint{x: x1 - nx * hw, y: y1 - ny * hw, on_curve: true})
    points.push(ContourPoint{x: e_x - nx * hw * 0.75, y: e_y - ny * hw * 0.75, on_curve: true})
    points.push(ContourPoint{x: e_x + nx * hw * 0.75, y: e_y + ny * hw * 0.75, on_curve: true})
    points.push(ContourPoint{x: x1 + nx * hw, y: y1 + ny * hw, on_curve: true})
    points.push(ContourPoint{x: x0 + nx * hw, y: y0 + ny * hw, on_curve: true})
    points.push(ContourPoint{x: b_x + nx * hw * 0.75, y: b_y + ny * hw * 0.75, on_curve: true})
    ends.push(points.len - 1)
}

fn builtin_glyph_spec(glyph_id int) string {
    // Grid: x in 0..16, y in -4..20 (y=0 baseline, y=14 x-height, y=20 cap height)
    if glyph_id == 96 { << "8,10 8,10" }
    cp := glyph_id + 31
    // Punctuation 33..47
    if cp == 33 { << "8,20 8,6; 8,1 8,1" }
    if cp == 34 { << "5,20 5,14; 11,20 11,14" }
    if cp == 35 { << "5,2 7,18; 11,2 13,18; 2,13 15,13; 1,7 14,7" }
    if cp == 36 { << "14,16 11,18 5,18 2,15 2,12 14,9 14,4 11,2 5,2 2,4; 8,20 8,0" }
    if cp == 37 { << "2,2 14,18; 3,17 4,17; 12,3 13,3" }
    if cp == 38 { << "14,2 3,13 3,18 6,20 10,20 12,17 12,14 2,8 2,3 5,0 10,0 15,6" }
    if cp == 39 { << "8,20 8,14" }
    if cp == 40 { << "11,21 6,16 4,10 6,4 11,-1" }
    if cp == 41 { << "5,21 10,16 12,10 10,4 5,-1" }
    if cp == 42 { << "8,18 8,6; 3,15 13,9; 13,15 3,9" }
    if cp == 43 { << "2,10 14,10; 8,16 8,4" }
    if cp == 44 { << "8,3 8,0 6,-3" }
    if cp == 45 { << "2,10 14,10" }
    if cp == 46 { << "8,1 8,1" }
    if cp == 47 { << "2,0 14,20" }
    // Digits 48..57
    if cp == 48 { << "4,0 12,0 15,4 15,16 12,20 4,20 1,16 1,4 4,0; 3,4 13,16" }
    if cp == 49 { << "4,16 8,20 8,0; 4,0 13,0" }
    if cp == 50 { << "2,16 5,20 11,20 14,16 14,12 2,0 14,0" }
    if cp == 51 { << "2,17 5,20 11,20 14,17 14,13 10,10 6,10; 10,10 14,7 14,3 11,0 5,0 2,3" }
    if cp == 52 { << "12,0 12,20 1,7 15,7" }
    if cp == 53 { << "14,20 3,20 3,11 11,11 14,8 14,3 11,0 5,0 2,2" }
    if cp == 54 { << "13,19 9,20 4,17 2,12 2,4 5,0 11,0 14,4 14,8 11,11 4,11 2,8" }
    if cp == 55 { << "2,20 14,20 6,0" }
    if cp == 56 { << "5,10 2,13 2,17 5,20 11,20 14,17 14,13 11,10 5,10 2,7 2,3 5,0 11,0 14,3 14,7 11,10" }
    if cp == 57 { << "3,1 7,0 12,3 14,8 14,16 11,20 5,20 2,16 2,12 5,9 12,9 14,12" }
    // Punctuation 58..64
    if cp == 58 { << "8,12 8,12; 8,1 8,1" }
    if cp == 59 { << "8,12 8,12; 8,3 8,0 6,-3" }
    if cp == 60 { << "13,16 3,10 13,4" }
    if cp == 61 { << "2,13 14,13; 2,7 14,7" }
    if cp == 62 { << "3,16 13,10 3,4" }
    if cp == 63 { << "3,16 6,20 11,20 14,17 14,13 8,10 8,6; 8,1 8,1" }
    if cp == 64 { << "13,2 10,0 5,0 1,4 1,15 5,19 11,19 15,15 15,7 12,5 10,7 10,13 6,13 5,11 5,7 7,5 10,7" }
    // Uppercase A..Z (65..90)
    if cp == 65 { << "1,0 8,20 15,0; 3,7 13,7" }
    if cp == 66 { << "2,0 2,20 11,20 14,17 14,13 11,10 2,10; 11,10 15,7 15,3 11,0 2,0" }
    if cp == 67 { << "14,16 11,20 5,20 1,15 1,5 5,0 11,0 14,4" }
    if cp == 68 { << "2,0 2,20 10,20 15,15 15,5 10,0 2,0" }
    if cp == 69 { << "14,20 2,20 2,0 14,0; 2,10 11,10" }
    if cp == 70 { << "14,20 2,20 2,0; 2,10 11,10" }
    if cp == 71 { << "14,16 11,20 5,20 1,15 1,5 5,0 11,0 15,4 15,10 9,10" }
    if cp == 72 { << "2,0 2,20; 14,0 14,20; 2,10 14,10" }
    if cp == 73 { << "4,20 12,20; 8,20 8,0; 4,0 12,0" }
    if cp == 74 { << "13,20 13,5 10,0 5,0 2,4" }
    if cp == 75 { << "2,0 2,20; 14,20 2,9; 6,13 14,0" }
    if cp == 76 { << "2,20 2,0 14,0" }
    if cp == 77 { << "1,0 1,20 8,7 15,20 15,0" }
    if cp == 78 { << "2,0 2,20 14,0 14,20" }
    if cp == 79 { << "5,0 11,0 15,5 15,15 11,20 5,20 1,15 1,5 5,0" }
    if cp == 80 { << "2,0 2,20 11,20 15,17 15,12 11,9 2,9" }
    if cp == 81 { << "5,0 11,0 15,5 15,15 11,20 5,20 1,15 1,5 5,0; 9,5 16,-2" }
    if cp == 82 { << "2,0 2,20 11,20 15,17 15,12 11,9 2,9; 9,9 15,0" }
    if cp == 83 { << "14,17 11,20 5,20 2,17 2,13 14,8 14,3 11,0 5,0 2,3" }
    if cp == 84 { << "1,20 15,20; 8,20 8,0" }
    if cp == 85 { << "2,20 2,5 5,0 11,0 14,5 14,20" }
    if cp == 86 { << "1,20 8,0 15,20" }
    if cp == 87 { << "1,20 4,0 8,12 12,0 15,20" }
    if cp == 88 { << "2,20 14,0; 14,20 2,0" }
    if cp == 89 { << "2,20 8,10 14,20; 8,10 8,0" }
    if cp == 90 { << "2,20 14,20 2,0 14,0" }
    // Brackets 91..96
    if cp == 91 { << "12,21 6,21 6,-1 12,-1" }
    if cp == 92 { << "2,20 14,0" }
    if cp == 93 { << "4,21 10,21 10,-1 4,-1" }
    if cp == 94 { << "3,14 8,20 13,14" }
    if cp == 95 { << "1,-2 15,-2" }
    if cp == 96 { << "6,20 10,16" }
    // Lowercase a..z (97..122)
    if cp == 97 { << "3,12 6,14 11,14 14,11 14,0; 14,8 5,8 2,5 2,2 5,0 10,0 14,3" }
    if cp == 98 { << "2,20 2,0 11,0 14,3 14,11 11,14 2,14" }
    if cp == 99 { << "14,11 11,14 5,14 2,11 2,3 5,0 11,0 14,3" }
    if cp == 100 { << "14,20 14,0 5,0 2,3 2,11 5,14 14,14" }
    if cp == 101 { << "13,2 10,0 5,0 2,3 2,11 5,14 11,14 14,11 14,7 2,7" }
    if cp == 102 { << "12,19 9,20 6,17 6,0; 2,13 11,13" }
    if cp == 103 { << "14,14 5,14 2,11 2,3 5,0 14,0; 14,14 14,-2 11,-5 4,-5" }
    if cp == 104 { << "2,20 2,0; 2,11 6,14 11,14 14,11 14,0" }
    if cp == 105 { << "8,14 8,0; 8,19 8,19" }
    if cp == 106 { << "10,14 10,-2 7,-5 4,-4; 10,19 10,19" }
    if cp == 107 { << "2,20 2,0; 13,14 2,5; 6,9 14,0" }
    if cp == 108 { << "7,20 7,2 10,0" }
    if cp == 109 { << "1,14 1,0; 1,11 5,14 8,11 8,0; 8,11 12,14 15,11 15,0" }
    if cp == 110 { << "2,14 2,0; 2,11 6,14 11,14 14,11 14,0" }
    if cp == 111 { << "5,0 11,0 14,3 14,11 11,14 5,14 2,11 2,3 5,0" }
    if cp == 112 { << "2,-5 2,14 11,14 14,11 14,3 11,0 2,0" }
    if cp == 113 { << "14,-5 14,14 5,14 2,11 2,3 5,0 14,0" }
    if cp == 114 { << "4,14 4,0; 4,10 8,14 12,13" }
    if cp == 115 { << "13,12 10,14 5,14 2,12 2,9 14,5 14,2 10,0 5,0 2,2" }
    if cp == 116 { << "7,19 7,3 10,0 13,1; 3,14 12,14" }
    if cp == 117 { << "2,14 2,3 5,0 11,0 14,3 14,14" }
    if cp == 118 { << "2,14 8,0 14,14" }
    if cp == 119 { << "1,14 4,0 8,9 12,0 15,14" }
    if cp == 120 { << "2,14 14,0; 14,14 2,0" }
    if cp == 121 { << "2,14 8,1; 14,14 5,-5" }
    if cp == 122 { << "2,14 14,14 2,0 14,0" }
    // Braces 123..126
    if cp == 123 { << "12,21 8,19 8,12 4,10 8,8 8,1 12,-1" }
    if cp == 124 { << "8,21 8,-2" }
    if cp == 125 { << "4,21 8,19 8,12 12,10 8,8 8,1 4,-1" }
    if cp == 126 { << "1,9 5,12 11,8 15,11" }
    << ""
}

struct ParsedInt {
    val int
    next int
}

fn parse_signed_int(s &string, start int) ParsedInt {
    $i := start
    $neg := false
    if i < s.len && s[i] == 45 {
        neg = true
        i += 1
    }
    $v := 0
    while i < s.len && s[i] >= 48 && s[i] <= 57 {
        v = v * 10 + (s[i] - 48)
        i += 1
    }
    if neg {
        << ParsedInt{val: 0 - v, next: i}
    }
    << ParsedInt{val: v, next: i}
}

fn add_spec_outlines(spec &string, x_scale f64, x_off f64, y_scale f64, hw f64,
                     points $&[]ContourPoint, ends $&[]int) {
    $i := 0
    $has_prev := false
    $px := 0.0
    $py := 0.0
    while i < spec.len {
        c := spec[i]
        if c == 32 {
            i += 1
        } else if c == 59 {
            has_prev = false
            i += 1
        } else {
            px_res := parse_signed_int(spec, i)
            gx := px_res.val
            $i2 := px_res.next
            if i2 < spec.len && spec[i2] == 44 { i2 += 1 }
            py_res := parse_signed_int(spec, i2)
            gy := py_res.val
            i = py_res.next
            fx := f64(gx) * x_scale + x_off
            fy := f64(gy) * y_scale
            if !has_prev {
                px = fx
                py = fy
                has_prev = true
                // Handle single-point segment (e.g. "8,1 8,1" or lone point at end of spec)
                if i >= spec.len || spec[i] == 59 {
                    append_dot_octagon(points, ends, fx, fy, hw * 1.15)
                }
            } else {
                append_capsule_stroke(points, ends, px, py, fx, fy, hw)
                px = fx
                py = fy
            }
        }
    }
}

pub fn builtin_glyph_outline(glyph_id int) GlyphOutline {
    gm := builtin_glyph_metrics(glyph_id)
    $points := []ContourPoint{}
    $ends := []int{}

    if glyph_id == 0 {
        // .notdef tofu box
        append_ccw_box($&points, $&ends, 70.0, 0.0, 490.0, 720.0)
        append_cw_box($&points, $&ends, 140.0, 70.0, 420.0, 650.0)
    } else if glyph_id != 1 {
        spec := builtin_glyph_spec(glyph_id)
        adv := f64(gm.advance_width)
        $x_scale := 26.0
        $x_off := 72.0
        if adv < 400.0 {
            x_scale = 13.0
            x_off = 66.0
        } else if adv < 500.0 {
            x_scale = 19.0
            x_off = 68.0
        } else if adv > 600.0 {
            x_scale = 31.0
            x_off = 72.0
        }
        $hw := 38.0
        if glyph_id == 96 {
            hw = 115.0
        }
        add_spec_outlines(&spec, x_scale, x_off, 36.0, hw, $&points, $&ends)
    }

    $x_min := 0.0
    $y_min := 0.0
    $x_max := 0.0
    $y_max := 0.0
    if points.len > 0 {
        x_min = points[0].x
        x_max = points[0].x
        y_min = points[0].y
        y_max = points[0].y
        for i in 1:points.len {
            p := points[i]
            if p.x < x_min { x_min = p.x }
            if p.x > x_max { x_max = p.x }
            if p.y < y_min { y_min = p.y }
            if p.y > y_max { y_max = p.y }
        }
    }

    << GlyphOutline{
        points: points,
        contour_ends: ends,
        units_per_em: 1000.0,
        advance_width: f64(gm.advance_width),
        left_side_bearing: f64(gm.left_side_bearing),
        x_min: x_min,
        y_min: y_min,
        x_max: x_max,
        y_max: y_max
    }
}
