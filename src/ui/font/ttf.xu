@ui/font

#errors
#math
#encoding/binary

fn be() binary.Endian {
    << binary.big_endian()
}

fn tag_eq(data &[]u8, off int, a int, b int, c int, d int) bool {
    if off + 4 > data.len {
        << false
    }
    << int(data[off]) == a && int(data[off + 1]) == b &&
        int(data[off + 2]) == c && int(data[off + 3]) == d
}

fn find_table(data &[]u8, tag_a int, tag_b int, tag_c int, tag_d int, out_off $&int, out_len $&int) int {
    if !try_find_table(data, tag_a, tag_b, tag_c, tag_d, out_off, out_len) {
        >> errors.new("ui/font: required TTF table missing")
    }
    << 0
}

fn try_find_table(data &[]u8, tag_a int, tag_b int, tag_c int, tag_d int, out_off $&int, out_len $&int) bool {
    if data.len < 12 {
        << false
    }
    e := be()
    num := e.get_u16_bytes(data, 4) or (err) {
        << false
    }
    if num <= 0 || num > 64 {
        << false
    }
    if data.len < 12 + num * 16 {
        << false
    }
    for i in 0:num {
        off := 12 + i * 16
        if tag_eq(data, off, tag_a, tag_b, tag_c, tag_d) {
            toff := e.get_u32_bytes(data, off + 8) or (err) {
                << false
            }
            tlen := e.get_u32_bytes(data, off + 12) or (err) {
                << false
            }
            if toff < 0 || tlen < 0 || toff + tlen > data.len {
                << false
            }
            *out_off = toff
            *out_len = tlen
            << true
        }
    }
    << false
}

fn clone_ttf_bytes(src &[]u8) []u8 {
    $out := []u8{}
    for b in src {
        out.push(b)
    }
    << out
}

fn parse_cmap_format4(data &[]u8, off int, len int, face $&FontFace) int {
    e := be()
    if len < 16 {
        >> errors.new("ui/font: cmap format 4 too short")
    }
    $length := e.get_u16_bytes(data, off + 2) or >>
    if length > len {
        length = len
    }
    seg_count_x2 := e.get_u16_bytes(data, off + 6) or >>
    seg_count := seg_count_x2 / 2
    if seg_count <= 0 || seg_count > 1024 {
        >> errors.new("ui/font: invalid cmap segment count")
    }
    end_off := off + 14
    start_off := end_off + seg_count_x2 + 2
    delta_off := start_off + seg_count_x2
    range_off := delta_off + seg_count_x2
    if range_off + seg_count_x2 > off + length {
        >> errors.new("ui/font: cmap format 4 truncated")
    }
    $starts := []int{}
    $ends := []int{}
    $deltas := []int{}
    $offsets := []int{}
    $glyph_ids := []int{}
    for i in 0:seg_count {
        ends.push(e.get_u16_bytes(data, end_off + i * 2) or >>)
        starts.push(e.get_u16_bytes(data, start_off + i * 2) or >>)
        // delta is signed int16
        raw := e.get_u16_bytes(data, delta_off + i * 2) or >>
        $delta := raw
        if raw >= 32768 {
            delta = raw - 65536
        }
        deltas.push(delta)
        offsets.push(e.get_u16_bytes(data, range_off + i * 2) or >>)
    }
    // Optional glyphIdArray follows rangeOffset array.
    $glyph_array_off := range_off + seg_count_x2
    while glyph_array_off + 2 <= off + length {
        glyph_ids.push(e.get_u16_bytes(data, glyph_array_off) or >>)
        glyph_array_off = glyph_array_off + 2
    }
    face.cmap_starts = starts
    face.cmap_ends = ends
    face.cmap_deltas = deltas
    face.cmap_offsets = offsets
    face.cmap_glyph_ids = glyph_ids
    << 0
}

fn parse_cmap(data &[]u8, off int, len int, face $&FontFace) int {
    e := be()
    if len < 4 {
        >> errors.new("ui/font: cmap too short")
    }
    num := e.get_u16_bytes(data, off + 2) or >>
    if num <= 0 || num > 64 || 4 + num * 8 > len {
        >> errors.new("ui/font: invalid cmap subtable count")
    }
    $best_off := -1
    $best_len := 0
    $best_score := -1
    for i in 0:num {
        plat := e.get_u16_bytes(data, off + 4 + i * 8) or >>
        enc := e.get_u16_bytes(data, off + 4 + i * 8 + 2) or >>
        soff := e.get_u32_bytes(data, off + 4 + i * 8 + 4) or >>
        if soff < 0 || soff + 4 > len {
            ->
        }
        $score := -1
        if plat == 3 && enc == 10 {
            score = 3
        } else if plat == 3 && enc == 1 {
            score = 2
        } else if plat == 0 {
            score = 1
        }
        if score > best_score {
            best_score = score
            best_off = off + soff
            best_len = len - soff
        }
    }
    if best_off < 0 {
        >> errors.new("ui/font: no usable cmap subtable")
    }
    fmt := e.get_u16_bytes(data, best_off) or >>
    if fmt == 4 {
        << parse_cmap_format4(data, best_off, best_len, face) or >>
    }
    // Format 12 / others: accept face without cmap segments; lookup returns -1.
    << 0
}

fn parse_hmtx(data &[]u8, off int, len int, num_glyphs int, num_hm0 int, face $&FontFace) int {
    e := be()
    $num_hm := num_hm0
    if num_hm <= 0 {
        num_hm = 1
    }
    if num_glyphs <= 0 {
        >> errors.new("ui/font: invalid glyph count")
    }
    need := num_hm * 4 + (num_glyphs - num_hm) * 2
    if need > len {
        >> errors.new("ui/font: hmtx truncated")
    }
    $advances := []int{}
    $bearings := []int{}
    $last_adv := 0
    for i in 0:num_glyphs {
        if i < num_hm {
            last_adv = e.get_u16_bytes(data, off + i * 4) or >>
            raw := e.get_u16_bytes(data, off + i * 4 + 2) or >>
            $bear := raw
            if raw >= 32768 {
                bear = raw - 65536
            }
            advances.push(last_adv)
            bearings.push(bear)
        } else {
            raw := e.get_u16_bytes(data, off + num_hm * 4 + (i - num_hm) * 2) or >>
            $bear := raw
            if raw >= 32768 {
                bear = raw - 65536
            }
            advances.push(last_adv)
            bearings.push(bear)
        }
    }
    face.advances = advances
    face.left_bearings = bearings
    << 0
}

fn parse_loca(data &[]u8, off int, len int, num_glyphs int, short bool, face $&FontFace) int {
    e := be()
    $loca := []int{}
    count := num_glyphs + 1
    if short {
        if count * 2 > len {
            >> errors.new("ui/font: loca truncated")
        }
        for i in 0:count {
            loca.push((e.get_u16_bytes(data, off + i * 2) or >>) * 2)
        }
    } else {
        if count * 4 > len {
            >> errors.new("ui/font: loca truncated")
        }
        for i in 0:count {
            loca.push(e.get_u32_bytes(data, off + i * 4) or >>)
        }
    }
    face.loca = loca
    face.is_short_loca = short
    << 0
}

pub fn parse_ttf(ttf_bytes &[]u8, face_index int, priority int) FontFace {
    if ttf_bytes.len < 12 {
        >> errors.new("ui/font: TTF too short")
    }
    if face_index != 0 {
        // TrueType Collection support is out of scope for the hostless path.
        if !(tag_eq(ttf_bytes, 0, 116, 116, 99, 102) || tag_eq(ttf_bytes, 0, 116, 116, 99, 70)) {
            >> errors.new("ui/font: non-zero face_index requires a font collection")
        }
        >> errors.new("ui/font: TTC collections are not supported yet")
    }
    // Accept TrueType (0x00010000) or 'OTTO' / 'true' / 'typ1'.
    e := be()
    sfnt := e.get_u32_bytes(ttf_bytes, 0) or >>
    ok_scaler := sfnt == 65536 || tag_eq(ttf_bytes, 0, 79, 84, 84, 79) ||
        tag_eq(ttf_bytes, 0, 116, 114, 117, 101) || tag_eq(ttf_bytes, 0, 116, 121, 112, 49)
    if !ok_scaler {
        >> errors.new("ui/font: not a TrueType/OpenType font")
    }

    $head_off := 0
    $head_len := 0
    find_table(ttf_bytes, 104, 101, 97, 100, $&head_off, $&head_len) or >>
    $hhea_off := 0
    $hhea_len := 0
    find_table(ttf_bytes, 104, 104, 101, 97, $&hhea_off, $&hhea_len) or >>
    $maxp_off := 0
    $maxp_len := 0
    find_table(ttf_bytes, 109, 97, 120, 112, $&maxp_off, $&maxp_len) or >>
    $cmap_off := 0
    $cmap_len := 0
    find_table(ttf_bytes, 99, 109, 97, 112, $&cmap_off, $&cmap_len) or >>
    $hmtx_off := 0
    $hmtx_len := 0
    find_table(ttf_bytes, 104, 109, 116, 120, $&hmtx_off, $&hmtx_len) or >>

    if head_len < 54 || hhea_len < 36 || maxp_len < 6 {
        >> errors.new("ui/font: required TTF tables truncated")
    }
    units := e.get_u16_bytes(ttf_bytes, head_off + 18) or >>
    if units <= 0 {
        >> errors.new("ui/font: invalid unitsPerEm")
    }
    index_to_loc := e.get_u16_bytes(ttf_bytes, head_off + 50) or >>
    asc_raw := e.get_u16_bytes(ttf_bytes, hhea_off + 4) or >>
    desc_raw := e.get_u16_bytes(ttf_bytes, hhea_off + 6) or >>
    gap_raw := e.get_u16_bytes(ttf_bytes, hhea_off + 8) or >>
    num_hm := e.get_u16_bytes(ttf_bytes, hhea_off + 34) or >>
    $ascent := asc_raw
    if asc_raw >= 32768 {
        ascent = asc_raw - 65536
    }
    $descent := desc_raw
    if desc_raw >= 32768 {
        descent = desc_raw - 65536
    }
    $line_gap := gap_raw
    if gap_raw >= 32768 {
        line_gap = gap_raw - 65536
    }
    num_glyphs := e.get_u16_bytes(ttf_bytes, maxp_off + 4) or >>
    if num_glyphs <= 0 || num_glyphs > 65535 {
        >> errors.new("ui/font: invalid numGlyphs")
    }

    $face := FontFace{
        font_id: 0,
        face_index: face_index,
        priority: priority,
        kind: FACE_TTF,
        units_per_em: units,
        ascent: ascent,
        descent: descent,
        line_gap: line_gap,
        num_glyphs: num_glyphs,
        ttf_bytes: clone_ttf_bytes(ttf_bytes),
        cmap_starts: []int{},
        cmap_ends: []int{},
        cmap_deltas: []int{},
        cmap_offsets: []int{},
        cmap_glyph_ids: []int{},
        advances: []int{},
        left_bearings: []int{},
        loca: []int{},
        glyf_off: 0,
        glyf_len: 0,
        is_short_loca: index_to_loc == 0
    }
    parse_cmap(ttf_bytes, cmap_off, cmap_len, $&face) or >>
    parse_hmtx(ttf_bytes, hmtx_off, hmtx_len, num_glyphs, num_hm, $&face) or >>

    $glyf_off := 0
    $glyf_len := 0
    if try_find_table(ttf_bytes, 103, 108, 121, 102, $&glyf_off, $&glyf_len) {
        $loca_off := 0
        $loca_len := 0
        find_table(ttf_bytes, 108, 111, 99, 97, $&loca_off, $&loca_len) or >>
        parse_loca(ttf_bytes, loca_off, loca_len, num_glyphs, index_to_loc == 0, $&face) or >>
        face.glyf_off = glyf_off
        face.glyf_len = glyf_len
    }
    << face
}

fn ttf_lookup(face &FontFace, cp int) int {
    if face.cmap_starts.len == 0 {
        << -1
    }
    for i in 0:face.cmap_starts.len {
        if cp < face.cmap_starts[i] || cp > face.cmap_ends[i] {
            ->
        }
        ro := face.cmap_offsets[i]
        if ro == 0 {
            $gid0 := cp + face.cmap_deltas[i]
            if gid0 < 0 {
                << -1
            }
            gid0 = gid0 & 65535
            if gid0 == 0 {
                << -1
            }
            << gid0
        }
        // glyphId = *(idRangeOffset/2 + (cp - start) + &idRangeOffset)
        // Relative to range offset entry i.
        index := ro / 2 + (cp - face.cmap_starts[i]) - (face.cmap_offsets.len - i)
        if index < 0 || index >= face.cmap_glyph_ids.len {
            << -1
        }
        $gid := face.cmap_glyph_ids[index]
        if gid == 0 {
            << -1
        }
        gid = (gid + face.cmap_deltas[i]) & 65535
        if gid == 0 {
            << -1
        }
        << gid
    }
    << -1
}

fn ttf_rasterize(face &FontFace, glyph_id int, px_size f64) GlyphBitmap {
    adv := face_advance_em(face, glyph_id)
    $aw := int(math.round(scale_em(adv, px_size, face.units_per_em)))
    if aw < 1 {
        aw = 1
    }
    // Empty / whitespace-like glyphs with tiny advance.
    if adv <= 0 || (glyph_id == 0 && adv < face.units_per_em / 8) {
        << GlyphBitmap{w: 0, h: 0, offset_x: 0, offset_y: 0, pixels: []u8{}}
    }

    // Prefer a metrics-based synthesized ink mask. Full glyf scan-conversion
    // is intentionally deferred; layout/atlas paths still get usable coverage.
    $ink_w := aw
    if ink_w > 2 {
        ink_w = aw - 1
    }
    $ink_h := int(math.round(px_size * 0.7))
    if ink_h < 1 {
        ink_h = 1
    }
    if ink_w < 1 {
        ink_w = 1
    }
    $pixels := []u8{}
    for y in 0:ink_h {
        for x in 0:ink_w {
            edge := x == 0 || y == 0 || x == ink_w - 1 || y == ink_h - 1
            if edge {
                pixels.push(u8(220))
            } else {
                pixels.push(u8(40))
            }
        }
    }
    oy := -int(math.round(scale_em(face_ascent_em(face), px_size, face.units_per_em)))
    $bear := 0
    if glyph_id >= 0 && glyph_id < face.left_bearings.len {
        bear = int(math.round(scale_em(face.left_bearings[glyph_id], px_size, face.units_per_em)))
    }
    << GlyphBitmap{
        w: ink_w,
        h: ink_h,
        offset_x: bear,
        offset_y: oy + int(math.round(px_size * 0.15)),
        pixels: pixels
    }
}
