@ui/font

#errors
#math

pub struct FontMetrics {
    pub units_per_em int
    pub ascent int
    pub descent int
    pub line_gap int
    pub x_min int
    pub y_min int
    pub x_max int
    pub y_max int
    pub num_glyphs int
}

pub struct GlyphMetrics {
    pub glyph_id int
    pub advance_width int
    pub left_side_bearing int
}

pub struct ContourPoint {
    pub x f64
    pub y f64
    pub on_curve bool
}

pub struct GlyphOutline {
    pub points []ContourPoint
    pub contour_ends []int
    pub units_per_em f64
    pub advance_width f64
    pub left_side_bearing f64
    pub x_min f64
    pub y_min f64
    pub x_max f64
    pub y_max f64
}

pub struct KernPair {
    pub key int
    pub value int
}

struct CmapRange {
    start_cp int
    end_cp int
    start_gid int
    delta int
    id_range_offset int
    range_word_index int
}

struct CompositeTransform {
    a f64
    b f64
    c f64
    d f64
    dx f64
    dy f64
}

pub struct FontFace {
    pub id int
    pub metrics FontMetrics
    pub is_builtin bool
    num_hmetrics int
    index_to_loc_format int
    cmap_format int
    cmap_ranges []CmapRange
    cmap_glyph_ids []int
    hmtx []u8
    loca []u8
    glyf []u8
    kern_pairs []KernPair
}

pub fn (face &FontFace) clone() FontFace {
    $ranges := []CmapRange{}
    for r in face.cmap_ranges {
        ranges.push(CmapRange{start_cp: r.start_cp,end_cp: r.end_cp,start_gid: r.start_gid,delta: r.delta,id_range_offset: r.id_range_offset,range_word_index: r.range_word_index})
    }
    $gids := []int{}
    for g in face.cmap_glyph_ids { gids.push(g) }
    $hmtx := []u8{}
    for b in face.hmtx { hmtx.push(b) }
    $loca := []u8{}
    for b in face.loca { loca.push(b) }
    $glyf := []u8{}
    for b in face.glyf { glyf.push(b) }
    $kerns := []KernPair{}
    for k in face.kern_pairs { kerns.push(KernPair{key: k.key,value: k.value}) }
    << FontFace{
        id: face.id,
        metrics: face.metrics,
        is_builtin: face.is_builtin,
        num_hmetrics: face.num_hmetrics,
        index_to_loc_format: face.index_to_loc_format,
        cmap_format: face.cmap_format,
        cmap_ranges: ranges,
        cmap_glyph_ids: gids,
        hmtx: hmtx,
        loca: loca,
        glyf: glyf,
        kern_pairs: kerns
    }
}

pub fn bytes_from_string(s &string) []u8 {
    $out := []u8{}
    for i in 0:s.len {
        out.push(u8(s[i] & 255))
    }
    << out
}

fn check_range(total int, off int, need int, label string) int {
    if off < 0 || need < 0 || off > total || need > total - off {
        >>> errors.new("font: " + label + " out of bounds")
    }
    << 0
}

fn read_u8(data &[]u8, off int, label string) int {
    check_range(data.len, off, 1, label) >>>
    << int(data[off]) & 255
}

fn read_u16(data &[]u8, off int, label string) int {
    check_range(data.len, off, 2, label) >>>
    b0 := int(data[off]) & 255
    b1 := int(data[off + 1]) & 255
    << (b0 << 8) | b1
}

fn read_i16(data &[]u8, off int, label string) int {
    v := read_u16(data, off, label) >>>
    if v >= 32768 {
        << v - 65536
    }
    << v
}

fn read_u32(data &[]u8, off int, label string) int {
    check_range(data.len, off, 4, label) >>>
    b0 := int(data[off]) & 255
    b1 := int(data[off + 1]) & 255
    b2 := int(data[off + 2]) & 255
    b3 := int(data[off + 3]) & 255
    << (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

fn read_f2dot14(data &[]u8, off int, label string) f64 {
    v := read_i16(data, off, label) >>>
    << f64(v) / 16384.0
}

fn slice_bytes(data &[]u8, off int, length int, label string) []u8 {
    check_range(data.len, off, length, label) >>>
    $out := []u8{}
    for i in 0:length {
        out.push(data[off + i])
    }
    << out
}

const TAG_TTCF = 0x74746366
const TAG_OTTO = 0x4F54544F
const TAG_SFNT_10 = 0x00010000
const TAG_SFNT_TRUE = 0x74727565
const TAG_SFNT_TYP1 = 0x74797031
const TAG_HEAD = 0x68656164
const TAG_MAXP = 0x6D617870
const TAG_HHEA = 0x68686561
const TAG_HMTX = 0x686D7478
const TAG_CMAP = 0x636D6170
const TAG_LOCA = 0x6C6F6361
const TAG_GLYF = 0x676C7966
const TAG_KERN = 0x6B65726E
const TAG_CFF  = 0x43464620
const TAG_CFF2 = 0x43464632

pub fn ttc_font_count(data &[]u8) int {
    if data.len < 12 {
        >>> errors.new("font: truncated header")
    }
    tag := read_u32(data, 0, "header tag") >>>
    if tag == TAG_TTCF {
        n := read_u32(data, 8, "ttc font count") >>>
        if n <= 0 || n > 256 {
            >>> errors.new("font: invalid ttc font count")
        }
        check_range(data.len, 12, n * 4, "ttc offset table") >>>
        << n
    }
    if tag == TAG_OTTO {
        >>> errors.new("font: CFF/OTF outlines unsupported; use TTF/TTC")
    }
    if tag == TAG_SFNT_10 || tag == TAG_SFNT_TRUE || tag == TAG_SFNT_TYP1 {
        << 1
    }
    >>> errors.new("font: unrecognized SFNT/TTC header")
}

fn resolve_sfnt_offset(data &[]u8, font_index int) int {
    if font_index < 0 {
        >>> errors.new("font: negative font index")
    }
    if data.len < 12 {
        >>> errors.new("font: truncated header")
    }
    tag := read_u32(data, 0, "header tag") >>>
    $sfnt_off := 0
    if tag == TAG_TTCF {
        n := read_u32(data, 8, "ttc font count") >>>
        if n <= 0 || n > 256 || font_index >= n {
            >>> errors.new("font: ttc font index out of range")
        }
        sfnt_off = read_u32(data, 12 + font_index * 4, "ttc sfnt offset") >>>
    } else if tag == TAG_OTTO {
        >>> errors.new("font: CFF/OTF outlines unsupported; use TTF/TTC")
    } else if tag == TAG_SFNT_10 || tag == TAG_SFNT_TRUE || tag == TAG_SFNT_TYP1 {
        if font_index != 0 {
            >>> errors.new("font: non-TTC font requires font_index 0")
        }
        sfnt_off = 0
    } else {
        >>> errors.new("font: unrecognized SFNT/TTC header")
    }
    check_range(data.len, sfnt_off, 12, "sfnt header") >>>
    sfnt_ver := read_u32(data, sfnt_off, "sfnt version") >>>
    if sfnt_ver == TAG_OTTO {
        >>> errors.new("font: CFF/OTF outlines unsupported; use TTF/TTC")
    }
    if sfnt_ver != TAG_SFNT_10 && sfnt_ver != TAG_SFNT_TRUE && sfnt_ver != TAG_SFNT_TYP1 {
        >>> errors.new("font: unsupported sfnt version")
    }
    << sfnt_off
}

fn cmap_priority(platform int, encoding int, format int) int {
    if format == 12 {
        if platform == 3 && encoding == 10 { << 100 }
        if platform == 0 && (encoding == 4 || encoding == 3) { << 90 }
        << 70
    }
    if format == 4 {
        if platform == 3 && encoding == 1 { << 60 }
        if platform == 0 && (encoding == 3 || encoding == 0 || encoding == 1 || encoding == 2) { << 50 }
        << 30
    }
    << 0
}

fn parse_cmap_format4(cmap &[]u8, sub_off int, num_glyphs int,
                      ranges $&[]CmapRange, glyph_ids $&[]int) int {
    length := read_u16(cmap, sub_off + 2, "cmap f4 length") >>>
    if length < 16 {
        >>> errors.new("font: invalid cmap format 4 length")
    }
    check_range(cmap.len, sub_off, length, "cmap f4 body") >>>
    seg_count_x2 := read_u16(cmap, sub_off + 6, "cmap f4 segCountX2") >>>
    if seg_count_x2 < 2 || (seg_count_x2 & 1) != 0 {
        >>> errors.new("font: invalid cmap format 4 segCount")
    }
    seg_count := seg_count_x2 / 2
    end_off := sub_off + 14
    start_off := end_off + seg_count * 2 + 2
    delta_off := start_off + seg_count * 2
    range_off := delta_off + seg_count * 2
    glyph_arr_off := range_off + seg_count * 2
    if glyph_arr_off > sub_off + length {
        >>> errors.new("font: cmap format 4 tables exceed subtable length")
    }
    glyph_bytes := (sub_off + length) - glyph_arr_off
    glyph_words := glyph_bytes / 2
    for g in 0:glyph_words {
        gid := read_u16(cmap, glyph_arr_off + g * 2, "cmap f4 glyphIdArray") >>>
        if gid >= num_glyphs {
            glyph_ids.push(0)
        } else {
            glyph_ids.push(gid)
        }
    }
    for i in 0:seg_count {
        end_cp := read_u16(cmap, end_off + i * 2, "cmap f4 endCode") >>>
        start_cp := read_u16(cmap, start_off + i * 2, "cmap f4 startCode") >>>
        delta := read_i16(cmap, delta_off + i * 2, "cmap f4 idDelta") >>>
        ro := read_u16(cmap, range_off + i * 2, "cmap f4 idRangeOffset") >>>
        if start_cp > end_cp {
            >>> errors.new("font: cmap format 4 unsorted segment")
        }
        $word_idx := 0
        if ro != 0 {
            if (ro & 1) != 0 {
                >>> errors.new("font: cmap format 4 unaligned idRangeOffset")
            }
            // Offset in bytes from current idRangeOffset slot minus distance to glyph_arr_off.
            slot_pos := range_off + i * 2
            target := slot_pos + ro
            if target < glyph_arr_off {
                >>> errors.new("font: cmap format 4 idRangeOffset before glyphIdArray")
            }
            word_idx = (target - glyph_arr_off) / 2
            span := end_cp - start_cp
            if word_idx + span >= glyph_ids.len {
                >>> errors.new("font: cmap format 4 glyphIdArray out of range")
            }
        }
        ranges.push(CmapRange{
            start_cp: start_cp,
            end_cp: end_cp,
            start_gid: 0,
            delta: delta,
            id_range_offset: ro,
            range_word_index: word_idx
        })
    }
    << 4
}

fn parse_cmap_format12(cmap &[]u8, sub_off int, num_glyphs int, ranges $&[]CmapRange) int {
    check_range(cmap.len, sub_off, 16, "cmap f12 header") >>>
    length := read_u32(cmap, sub_off + 4, "cmap f12 length") >>>
    if length < 16 {
        >>> errors.new("font: invalid cmap format 12 length")
    }
    check_range(cmap.len, sub_off, length, "cmap f12 body") >>>
    num_groups := read_u32(cmap, sub_off + 12, "cmap f12 numGroups") >>>
    if num_groups < 0 || num_groups > 131072 || 16 + num_groups * 12 > length {
        >>> errors.new("font: invalid cmap format 12 numGroups")
    }
    for i in 0:num_groups {
        goff := sub_off + 16 + i * 12
        start_cp := read_u32(cmap, goff, "cmap f12 startCharCode") >>>
        end_cp := read_u32(cmap, goff + 4, "cmap f12 endCharCode") >>>
        $start_gid := read_u32(cmap, goff + 8, "cmap f12 startGlyphID") >>>
        if start_cp > end_cp || start_gid < 0 {
            >>> errors.new("font: invalid cmap format 12 group")
        }
        if start_gid >= num_glyphs {
            start_gid = 0
        }
        ranges.push(CmapRange{
            start_cp: start_cp,
            end_cp: end_cp,
            start_gid: start_gid,
            delta: 0,
            id_range_offset: 0,
            range_word_index: 0
        })
    }
    << 12
}

fn parse_cmap_into(cmap &[]u8, num_glyphs int, ranges $&[]CmapRange, glyph_ids $&[]int) int {
    if cmap.len < 4 {
        >>> errors.new("font: truncated cmap")
    }
    num_tables := read_u16(cmap, 2, "cmap numTables") >>>
    if num_tables <= 0 || num_tables > 64 || 4 + num_tables * 8 > cmap.len {
        >>> errors.new("font: invalid cmap numTables")
    }
    $best_prio := 0
    $best_off := -1
    $best_fmt := 0
    for i in 0:num_tables {
        rec_off := 4 + i * 8
        plat := read_u16(cmap, rec_off, "cmap platformID") >>>
        enc := read_u16(cmap, rec_off + 2, "cmap encodingID") >>>
        sub_off := read_u32(cmap, rec_off + 4, "cmap subtable offset") >>>
        if sub_off >= 0 && sub_off + 2 <= cmap.len {
            fmt := read_u16(cmap, sub_off, "cmap subtable format") >>>
            if fmt == 4 || fmt == 12 {
                prio := cmap_priority(plat, enc, fmt)
                if prio > best_prio {
                    best_prio = prio
                    best_off = sub_off
                    best_fmt = fmt
                }
            }
        }
    }
    if best_off < 0 {
        >>> errors.new("font: no supported cmap Format 4 or Format 12 subtable found")
    }
    if best_fmt == 12 {
        << parse_cmap_format12(cmap, best_off, num_glyphs, ranges) >>>
    }
    << parse_cmap_format4(cmap, best_off, num_glyphs, ranges, glyph_ids) >>>
}

fn parse_kern_format0(kern &[]u8) []KernPair {
    $pairs := []KernPair{}
    if kern.len < 4 {
        << pairs
    }
    version := read_u16(kern, 0, "kern version") >>> (err) { << pairs }
    if version != 0 {
        // Non-Microsoft kern (e.g. AAT) is skipped cleanly.
        << pairs
    }
    n_tables := read_u16(kern, 2, "kern nTables") >>> (err) { << pairs }
    $off := 4
    $limit := n_tables
    if limit > 16 { limit = 16 }
    for t in 0:limit {
        if off + 6 > kern.len { <- }
        sub_ver := read_u16(kern, off, "kern subtable version") >>> (err) { <- }
        sub_len := read_u16(kern, off + 2, "kern subtable length") >>> (err) { <- }
        coverage := read_u16(kern, off + 4, "kern coverage") >>> (err) { <- }
        if sub_len < 6 || off + sub_len > kern.len { <- }
        fmt := coverage >> 8
        horiz := (coverage & 1) != 0
        cross := (coverage & 4) != 0
        override := (coverage & 8) != 0
        if sub_ver == 0 && fmt == 0 && horiz && !cross && !override && sub_len >= 14 {
            n_pairs := read_u16(kern, off + 6, "kern nPairs") >>> (err) { <- }
            if n_pairs > 0 && off + 14 + n_pairs * 6 <= off + sub_len && n_pairs <= 65536 {
                $prev_key := -1
                $sorted := true
                for p in 0:n_pairs {
                    poff := off + 14 + p * 6
                    left := read_u16(kern, poff, "kern left") >>> (err) { <- }
                    right := read_u16(kern, poff + 2, "kern right") >>> (err) { <- }
                    val := read_i16(kern, poff + 4, "kern value") >>> (err) { <- }
                    k := (left << 16) | right
                    if k < prev_key { sorted = false }
                    prev_key = k
                    pairs.push(KernPair{key: k, value: val})
                }
                if !sorted {
                    // Insertion/merge sort only if malformed order; normally already sorted.
                    sort_kern_pairs($&pairs)
                }
                << pairs
            }
        }
        off += sub_len
    }
    << pairs
}

fn sort_kern_pairs(pairs $&[]KernPair) {
    $i := 1
    while i < pairs.len {
        cur := pairs[i]
        $j := i - 1
        while j >= 0 && pairs[j].key > cur.key {
            pairs[j + 1] = pairs[j]
            j -= 1
        }
        pairs[j + 1] = cur
        i += 1
    }
}

pub fn parse_ttf(data &[]u8, font_index int, face_id int) FontFace {
    sfnt_off := resolve_sfnt_offset(data, font_index) >>>
    num_tables := read_u16(data, sfnt_off + 4, "numTables") >>>
    if num_tables <= 0 || num_tables > 128 {
        >>> errors.new("font: invalid numTables")
    }
    check_range(data.len, sfnt_off + 12, num_tables * 16, "table directory") >>>

    $head_off := -1
    $head_len := 0
    $maxp_off := -1
    $maxp_len := 0
    $hhea_off := -1
    $hhea_len := 0
    $hmtx_off := -1
    $hmtx_len := 0
    $cmap_off := -1
    $cmap_len := 0
    $loca_off := -1
    $loca_len := 0
    $glyf_off := -1
    $glyf_len := 0
    $kern_off := -1
    $kern_len := 0
    $has_cff := false

    for i in 0:num_tables {
        rec := sfnt_off + 12 + i * 16
        tag := read_u32(data, rec, "table tag") >>>
        toff := read_u32(data, rec + 8, "table offset") >>>
        tlen := read_u32(data, rec + 12, "table length") >>>
        check_range(data.len, toff, tlen, "table payload") >>>
        if tag == TAG_HEAD {
            head_off = toff
            head_len = tlen
        } else if tag == TAG_MAXP {
            maxp_off = toff
            maxp_len = tlen
        } else if tag == TAG_HHEA {
            hhea_off = toff
            hhea_len = tlen
        } else if tag == TAG_HMTX {
            hmtx_off = toff
            hmtx_len = tlen
        } else if tag == TAG_CMAP {
            cmap_off = toff
            cmap_len = tlen
        } else if tag == TAG_LOCA {
            loca_off = toff
            loca_len = tlen
        } else if tag == TAG_GLYF {
            glyf_off = toff
            glyf_len = tlen
        } else if tag == TAG_KERN {
            kern_off = toff
            kern_len = tlen
        } else if tag == TAG_CFF || tag == TAG_CFF2 {
            has_cff = true
        }
    }

    if glyf_off < 0 || loca_off < 0 {
        if has_cff {
            >>> errors.new("font: CFF/OTF outlines unsupported; use TTF/TTC")
        }
        >>> errors.new("font: missing required glyf/loca tables")
    }
    if head_off < 0 || maxp_off < 0 || hhea_off < 0 || hmtx_off < 0 || cmap_off < 0 {
        >>> errors.new("font: missing required SFNT tables (head/maxp/hhea/hmtx/cmap)")
    }
    if head_len < 54 || maxp_len < 6 || hhea_len < 36 {
        >>> errors.new("font: truncated head/maxp/hhea table")
    }

    units_per_em := read_u16(data, head_off + 18, "head unitsPerEm") >>>
    if units_per_em < 16 || units_per_em > 16384 {
        >>> errors.new("font: invalid unitsPerEm")
    }
    x_min := read_i16(data, head_off + 36, "head xMin") >>>
    y_min := read_i16(data, head_off + 38, "head yMin") >>>
    x_max := read_i16(data, head_off + 40, "head xMax") >>>
    y_max := read_i16(data, head_off + 42, "head yMax") >>>
    loca_fmt := read_i16(data, head_off + 50, "head indexToLocFormat") >>>
    if loca_fmt != 0 && loca_fmt != 1 {
        >>> errors.new("font: invalid indexToLocFormat")
    }

    num_glyphs := read_u16(data, maxp_off + 4, "maxp numGlyphs") >>>
    if num_glyphs <= 0 || num_glyphs > 65535 {
        >>> errors.new("font: invalid maxp numGlyphs")
    }

    ascent := read_i16(data, hhea_off + 4, "hhea ascent") >>>
    descent := read_i16(data, hhea_off + 6, "hhea descent") >>>
    line_gap := read_i16(data, hhea_off + 8, "hhea lineGap") >>>
    num_hmetrics := read_u16(data, hhea_off + 34, "hhea numOfLongHorMetrics") >>>
    if num_hmetrics <= 0 || num_hmetrics > num_glyphs {
        >>> errors.new("font: invalid hhea numOfLongHorMetrics")
    }

    need_hmtx := num_hmetrics * 4 + (num_glyphs - num_hmetrics) * 2
    if hmtx_len < need_hmtx {
        >>> errors.new("font: truncated hmtx table")
    }
    $need_loca := (num_glyphs + 1) * 4
    if loca_fmt == 0 {
        need_loca = (num_glyphs + 1) * 2
    }
    if loca_len < need_loca {
        >>> errors.new("font: truncated loca table")
    }

    cmap_bytes := slice_bytes(data, cmap_off, cmap_len, "cmap") >>>
    $cmap_ranges := []CmapRange{}
    $cmap_glyph_ids := []int{}
    cmap_fmt := parse_cmap_into(&cmap_bytes, num_glyphs, $&cmap_ranges, $&cmap_glyph_ids) >>>
    hmtx_bytes := slice_bytes(data, hmtx_off, need_hmtx, "hmtx") >>>
    loca_bytes := slice_bytes(data, loca_off, need_loca, "loca") >>>
    glyf_bytes := slice_bytes(data, glyf_off, glyf_len, "glyf") >>>
    $kern_pairs := []KernPair{}
    if kern_off >= 0 && kern_len >= 4 {
        kern_bytes := slice_bytes(data, kern_off, kern_len, "kern") >>>
        kern_pairs = parse_kern_format0(&kern_bytes)
    }

    metrics := FontMetrics{
        units_per_em: units_per_em,
        ascent: ascent,
        descent: descent,
        line_gap: line_gap,
        x_min: x_min,
        y_min: y_min,
        x_max: x_max,
        y_max: y_max,
        num_glyphs: num_glyphs
    }
    << FontFace{
        id: face_id,
        metrics: metrics,
        is_builtin: false,
        num_hmetrics: num_hmetrics,
        index_to_loc_format: loca_fmt,
        cmap_format: cmap_fmt,
        cmap_ranges: cmap_ranges,
        cmap_glyph_ids: cmap_glyph_ids,
        hmtx: hmtx_bytes,
        loca: loca_bytes,
        glyf: glyf_bytes,
        kern_pairs: kern_pairs
    }
}

pub fn (face &FontFace) glyph_index(codepoint int) int {
    if face.is_builtin {
        << builtin_glyph_index(codepoint)
    }
    if codepoint < 0 {
        << 0
    }
    if face.cmap_format == 4 && codepoint > 65535 {
        << 0
    }
    $lo := 0
    $hi := face.cmap_ranges.len - 1
    while lo <= hi {
        mid := lo + (hi - lo) / 2
        seg := face.cmap_ranges[mid]
        if codepoint < seg.start_cp {
            hi = mid - 1
        } else if codepoint > seg.end_cp {
            lo = mid + 1
        } else {
            if face.cmap_format == 12 {
                gid := seg.start_gid + (codepoint - seg.start_cp)
                if gid < 0 || gid >= face.metrics.num_glyphs { << 0 }
                << gid
            }
            if seg.id_range_offset == 0 {
                gid := (codepoint + seg.delta) & 65535
                if gid < 0 || gid >= face.metrics.num_glyphs { << 0 }
                << gid
            }
            word_idx := seg.range_word_index + (codepoint - seg.start_cp)
            if word_idx < 0 || word_idx >= face.cmap_glyph_ids.len { << 0 }
            raw := face.cmap_glyph_ids[word_idx]
            if raw == 0 { << 0 }
            gid := (raw + seg.delta) & 65535
            if gid < 0 || gid >= face.metrics.num_glyphs { << 0 }
            << gid
        }
    }
    << 0
}

pub fn (face &FontFace) glyph_metrics(glyph_id int) GlyphMetrics {
    if face.is_builtin {
        << builtin_glyph_metrics(glyph_id)
    }
    if glyph_id < 0 || glyph_id >= face.metrics.num_glyphs {
        >>> errors.new("font: glyph index out of range")
    }
    if glyph_id < face.num_hmetrics {
        off := glyph_id * 4
        adv := read_u16(&face.hmtx, off, "hmtx advanceWidth") >>>
        lsb := read_i16(&face.hmtx, off + 2, "hmtx lsb") >>>
        << GlyphMetrics{glyph_id: glyph_id, advance_width: adv, left_side_bearing: lsb}
    }
    last_off := (face.num_hmetrics - 1) * 4
    adv := read_u16(&face.hmtx, last_off, "hmtx last advanceWidth") >>>
    lsb_off := face.num_hmetrics * 4 + (glyph_id - face.num_hmetrics) * 2
    lsb := read_i16(&face.hmtx, lsb_off, "hmtx trailing lsb") >>>
    << GlyphMetrics{glyph_id: glyph_id, advance_width: adv, left_side_bearing: lsb}
}

pub fn (face &FontFace) kerning(left_gid int, right_gid int) int {
    if face.is_builtin || face.kern_pairs.len == 0 || left_gid <= 0 || right_gid <= 0 {
        << 0
    }
    target := (left_gid << 16) | right_gid
    $lo := 0
    $hi := face.kern_pairs.len - 1
    while lo <= hi {
        mid := lo + (hi - lo) / 2
        k := face.kern_pairs[mid].key
        if target < k {
            hi = mid - 1
        } else if target > k {
            lo = mid + 1
        } else {
            << face.kern_pairs[mid].value
        }
    }
    << 0
}

struct LocaSpan {
    off0 int
    off1 int
}

fn loca_span(face &FontFace, glyph_id int) LocaSpan {
    if glyph_id < 0 || glyph_id >= face.metrics.num_glyphs {
        >>> errors.new("font: glyph index out of range")
    }
    if face.index_to_loc_format == 0 {
        off0 := read_u16(&face.loca, glyph_id * 2, "loca16") >>>
        off1 := read_u16(&face.loca, (glyph_id + 1) * 2, "loca16 next") >>>
        << LocaSpan{off0: off0 * 2, off1: off1 * 2}
    }
    off0 := read_u32(&face.loca, glyph_id * 4, "loca32") >>>
    off1 := read_u32(&face.loca, (glyph_id + 1) * 4, "loca32 next") >>>
    << LocaSpan{off0: off0, off1: off1}
}

fn append_simple_glyph(face &FontFace, goff int, gend int, num_contours int,
                       xf CompositeTransform, points $&[]ContourPoint, ends $&[]int) int {
    if num_contours == 0 {
        << 0
    }
    if num_contours > 4096 || goff + 10 + num_contours * 2 + 2 > gend {
        >>> errors.new("font: invalid simple glyph header")
    }
    $raw_ends := []int{}
    $prev_end := -1
    for c in 0:num_contours {
        ep := read_u16(&face.glyf, goff + 10 + c * 2, "glyf endPtsOfContours") >>>
        if ep <= prev_end || ep >= 65535 {
            >>> errors.new("font: invalid glyf contour endpoints")
        }
        prev_end = ep
        raw_ends.push(ep)
    }
    n_points := prev_end + 1
    inst_off := goff + 10 + num_contours * 2
    inst_len := read_u16(&face.glyf, inst_off, "glyf instructionLength") >>>
    $pos := inst_off + 2 + inst_len
    if pos > gend {
        >>> errors.new("font: glyf instructions exceed glyph bounds")
    }

    $flags := []int{}
    while flags.len < n_points {
        f := read_u8(&face.glyf, pos, "glyf flags") >>>
        pos += 1
        flags.push(f)
        if (f & 8) != 0 {
            rep := read_u8(&face.glyf, pos, "glyf flag repeat") >>>
            pos += 1
            if flags.len + rep > n_points {
                >>> errors.new("font: glyf flag repeat exceeds nPoints")
            }
            for r in 0:rep {
                flags.push(f)
            }
        }
    }

    $xs := []int{}
    $cx := 0
    for i in 0:n_points {
        f := flags[i]
        if (f & 2) != 0 {
            dx := read_u8(&face.glyf, pos, "glyf x short") >>>
            pos += 1
            if (f & 16) != 0 { cx += dx } else { cx -= dx }
        } else if (f & 16) == 0 {
            dx := read_i16(&face.glyf, pos, "glyf x long") >>>
            pos += 2
            cx += dx
        }
        xs.push(cx)
    }

    $ys := []int{}
    $cy := 0
    for i in 0:n_points {
        f := flags[i]
        if (f & 4) != 0 {
            dy := read_u8(&face.glyf, pos, "glyf y short") >>>
            pos += 1
            if (f & 32) != 0 { cy += dy } else { cy -= dy }
        } else if (f & 32) == 0 {
            dy := read_i16(&face.glyf, pos, "glyf y long") >>>
            pos += 2
            cy += dy
        }
        ys.push(cy)
    }

    if pos > gend {
        >>> errors.new("font: glyf coordinates exceed glyph bounds")
    }

    base_idx := points.len
    for i in 0:n_points {
        fx := f64(xs[i])
        fy := f64(ys[i])
        px := xf.a * fx + xf.c * fy + xf.dx
        py := xf.b * fx + xf.d * fy + xf.dy
        points.push(ContourPoint{x: px, y: py, on_curve: (flags[i] & 1) != 0})
    }
    for c in 0:raw_ends.len {
        ends.push(base_idx + raw_ends[c])
    }
    << 0
}

fn append_glyph_recursive(face &FontFace, glyph_id int, xf CompositeTransform,
                          depth int, points $&[]ContourPoint, ends $&[]int) int {
    if depth > 8 {
        >>> errors.new("font: composite glyph depth limit exceeded")
    }
    span := loca_span(face, glyph_id) >>>
    off0 := span.off0
    off1 := span.off1
    if off0 < 0 || off1 < off0 || off1 > face.glyf.len {
        >>> errors.new("font: loca span out of bounds")
    }
    if off0 == off1 {
        << 0
    }
    if off0 + 10 > off1 {
        >>> errors.new("font: truncated glyf header")
    }
    num_contours := read_i16(&face.glyf, off0, "glyf numberOfContours") >>>
    if num_contours >= 0 {
        << append_simple_glyph(face, off0, off1, num_contours, xf, points, ends) >>>
    }

    $pos := off0 + 10
    $more := true
    while more {
        if pos + 4 > off1 {
            >>> errors.new("font: truncated composite glyph")
        }
        cflags := read_u16(&face.glyf, pos, "comp flags") >>>
        comp_gid := read_u16(&face.glyf, pos + 2, "comp glyphIndex") >>>
        pos += 4

        $arg1 := 0
        $arg2 := 0
        if (cflags & 1) != 0 {
            arg1 = read_i16(&face.glyf, pos, "comp arg1 word") >>>
            arg2 = read_i16(&face.glyf, pos + 2, "comp arg2 word") >>>
            pos += 4
        } else {
            b1 := read_u8(&face.glyf, pos, "comp arg1 byte") >>>
            b2 := read_u8(&face.glyf, pos + 1, "comp arg2 byte") >>>
            pos += 2
            if (cflags & 2) != 0 {
                if b1 >= 128 { arg1 = b1 - 256 } else { arg1 = b1 }
                if b2 >= 128 { arg2 = b2 - 256 } else { arg2 = b2 }
            }
        }

        $dx := 0.0
        $dy := 0.0
        if (cflags & 2) != 0 {
            dx = f64(arg1)
            dy = f64(arg2)
        }

        $la := 1.0
        $lb := 0.0
        $lc := 0.0
        $ld := 1.0
        if (cflags & 8) != 0 {
            s := read_f2dot14(&face.glyf, pos, "comp scale") >>>
            pos += 2
            la = s
            ld = s
        } else if (cflags & 64) != 0 {
            la = read_f2dot14(&face.glyf, pos, "comp xscale") >>>
            ld = read_f2dot14(&face.glyf, pos + 2, "comp yscale") >>>
            pos += 4
        } else if (cflags & 128) != 0 {
            la = read_f2dot14(&face.glyf, pos, "comp a") >>>
            lb = read_f2dot14(&face.glyf, pos + 2, "comp b") >>>
            lc = read_f2dot14(&face.glyf, pos + 4, "comp c") >>>
            ld = read_f2dot14(&face.glyf, pos + 6, "comp d") >>>
            pos += 8
        }

        $eff_dx := dx
        $eff_dy := dy
        if (cflags & 2048) != 0 {
            eff_dx = la * dx + lc * dy
            eff_dy = lb * dx + ld * dy
        }

        child_xf := CompositeTransform{
            a: xf.a * la + xf.c * lb,
            b: xf.b * la + xf.d * lb,
            c: xf.a * lc + xf.c * ld,
            d: xf.b * lc + xf.d * ld,
            dx: xf.a * eff_dx + xf.c * eff_dy + xf.dx,
            dy: xf.b * eff_dx + xf.d * eff_dy + xf.dy
        }
        append_glyph_recursive(face, comp_gid, child_xf, depth + 1, points, ends) >>>
        more = (cflags & 32) != 0
    }
    << 0
}

pub fn (face &FontFace) glyph_outline(glyph_id int) GlyphOutline {
    if face.is_builtin {
        << builtin_glyph_outline(glyph_id)
    }
    gm := face.glyph_metrics(glyph_id) >>>
    $points := []ContourPoint{}
    $ends := []int{}
    id_xf := CompositeTransform{a: 1.0, b: 0.0, c: 0.0, d: 1.0, dx: 0.0, dy: 0.0}
    append_glyph_recursive(face, glyph_id, id_xf, 0, $&points, $&ends) >>>

    $x_min := 0.0
    $y_min := 0.0
    $x_max := 0.0
    $y_max := 0.0
    if points.len > 0 {
        x_min = points[0].x
        x_max = points[0].x
        y_min = points[0].y
        y_max = points[0].y
        for i in 1:points.len {
            p := points[i]
            if p.x < x_min { x_min = p.x }
            if p.x > x_max { x_max = p.x }
            if p.y < y_min { y_min = p.y }
            if p.y > y_max { y_max = p.y }
        }
    }

    << GlyphOutline{
        points: points,
        contour_ends: ends,
        units_per_em: f64(face.metrics.units_per_em),
        advance_width: f64(gm.advance_width),
        left_side_bearing: f64(gm.left_side_bearing),
        x_min: x_min,
        y_min: y_min,
        x_max: x_max,
        y_max: y_max
    }
}
