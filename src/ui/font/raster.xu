@ui/font

#errors
#math

pub struct GlyphBitmap {
    pub width int
    pub height int
    pub offset_x int
    pub offset_y int
    pub advance_x f64
    pub pixels []u8
}

struct EdgeSeg {
    x0 f64
    y0 f64
    x1 f64
    y1 f64
}

fn flatten_quad(x0 f64, y0 f64, cx f64, cy f64, x1 f64, y1 f64,
                depth int, edges $&[]EdgeSeg) {
    mx := 0.5 * (x0 + x1)
    my := 0.5 * (y0 + y1)
    dx := cx - mx
    dy := cy - my
    if depth >= 8 || (dx * dx + dy * dy) <= 0.04 {
        edges.push(EdgeSeg{x0: x0, y0: y0, x1: x1, y1: y1})
        <<
    }
    ax := 0.5 * (x0 + cx)
    ay := 0.5 * (y0 + cy)
    bx := 0.5 * (cx + x1)
    by := 0.5 * (cy + y1)
    qx := 0.5 * (ax + bx)
    qy := 0.5 * (ay + by)
    flatten_quad(x0, y0, ax, ay, qx, qy, depth + 1, edges)
    flatten_quad(qx, qy, bx, by, x1, y1, depth + 1, edges)
}

fn flatten_contour(points &[]ContourPoint, start int, end_idx int, scale f64, edges $&[]EdgeSeg) {
    n := (end_idx - start) + 1
    if n < 2 {
        <<
    }
    first := points[start]
    last := points[end_idx]
    $sx := 0.0
    $sy := 0.0
    $i := 0
    if first.on_curve {
        sx = first.x * scale
        sy = (0.0 - first.y) * scale
        i = 1
    } else if last.on_curve {
        sx = last.x * scale
        sy = (0.0 - last.y) * scale
        i = 0
    } else {
        sx = 0.5 * (first.x + last.x) * scale
        sy = (0.0 - 0.5 * (first.y + last.y)) * scale
        i = 0
    }

    start_x := sx
    start_y := sy
    $cur_x := sx
    $cur_y := sy
    $step := 0
    while step < n {
        $wrap1 := i + step
        if wrap1 >= n { wrap1 -= n }
        pt := points[start + wrap1]
        px := pt.x * scale
        py := (0.0 - pt.y) * scale
        if pt.on_curve {
            edges.push(EdgeSeg{x0: cur_x, y0: cur_y, x1: px, y1: py})
            cur_x = px
            cur_y = py
            step += 1
        } else if step + 1 < n {
            $wrap2 := i + step + 1
            while wrap2 >= n { wrap2 -= n }
            next_pt := points[start + wrap2]
            nx := next_pt.x * scale
            ny := (0.0 - next_pt.y) * scale
            if next_pt.on_curve {
                flatten_quad(cur_x, cur_y, px, py, nx, ny, 0, edges)
                cur_x = nx
                cur_y = ny
                step += 2
            } else {
                mx := 0.5 * (px + nx)
                my := 0.5 * (py + ny)
                flatten_quad(cur_x, cur_y, px, py, mx, my, 0, edges)
                cur_x = mx
                cur_y = my
                step += 1
            }
        } else {
            flatten_quad(cur_x, cur_y, px, py, start_x, start_y, 0, edges)
            cur_x = start_x
            cur_y = start_y
            step += 1
        }
    }
    if cur_x != start_x || cur_y != start_y {
        edges.push(EdgeSeg{x0: cur_x, y0: cur_y, x1: start_x, y1: start_y})
    }
}

fn clamp_int(v int, lo int, hi int) int {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

pub fn rasterize_outline(outline &GlyphOutline, px_size f64) GlyphBitmap {
    if math.is_nan(px_size) || math.is_inf(px_size) || px_size <= 0.0 || outline.units_per_em <= 0.0 {
        >> errors.new("font: invalid pixel size or units_per_em")
    }
    scale := px_size / outline.units_per_em
    adv := outline.advance_width * scale

    $edges := []EdgeSeg{}
    $start := 0
    for c in 0:outline.contour_ends.len {
        end_idx := outline.contour_ends[c]
        if end_idx >= start && end_idx < outline.points.len {
            flatten_contour(&outline.points, start, end_idx, scale, $&edges)
        }
        start = end_idx + 1
    }

    if edges.len == 0 {
        << GlyphBitmap{width: 0, height: 0, offset_x: 0, offset_y: 0, advance_x: adv, pixels: []u8{}}
    }

    $min_x := edges[0].x0
    $max_x := edges[0].x0
    $min_y := edges[0].y0
    $max_y := edges[0].y0
    for e_idx in 0:edges.len {
        e := edges[e_idx]
        if e.x0 < min_x { min_x = e.x0 }
        if e.x0 > max_x { max_x = e.x0 }
        if e.x1 < min_x { min_x = e.x1 }
        if e.x1 > max_x { max_x = e.x1 }
        if e.y0 < min_y { min_y = e.y0 }
        if e.y0 > max_y { max_y = e.y0 }
        if e.y1 < min_y { min_y = e.y1 }
        if e.y1 > max_y { max_y = e.y1 }
    }

    ix0 := int(math.floor(min_x))
    iy0 := int(math.floor(min_y))
    ix1 := int(math.ceil(max_x))
    iy1 := int(math.ceil(max_y))
    $w := ix1 - ix0
    $h := iy1 - iy0
    if w <= 0 { w = 1 }
    if h <= 0 { h = 1 }
    if w > 2048 || h > 2048 {
        >> errors.new("font: rasterized glyph exceeds 2048px limit")
    }

    $cover := []f64{}
    for i in 0:(w * h) {
        cover.push(0.0)
    }
    $delta := []f64{}
    for i in 0:(h * (w + 1)) {
        delta.push(0.0)
    }

    fx0 := f64(ix0)
    fy0 := f64(iy0)
    fh := f64(h)
    fw := f64(w)

    for e_idx in 0:edges.len {
        e := edges[e_idx]
        $sx0 := e.x0 - fx0
        $sy0 := e.y0 - fy0
        $sx1 := e.x1 - fx0
        $sy1 := e.y1 - fy0
        if sy0 != sy1 {
            $dir := 1.0
            if sy1 < sy0 {
                dir = -1.0
                tx := sx0
                ty := sy0
                sx0 = sx1
                sy0 = sy1
                sx1 = tx
                sy1 = ty
            }
            if sy1 > 0.0 && sy0 < fh {
                full_dy := sy1 - sy0
                if full_dy > 0.0 {
                    inv_dy := 1.0 / full_dy
                    r0 := clamp_int(int(math.floor(math.max(0.0, sy0))), 0, h - 1)
                    r1 := clamp_int(int(math.floor(math.min(fh - 1.0e-9, sy1))), 0, h - 1)
                    for r in r0:(r1 + 1) {
                        ya := math.max(sy0, f64(r))
                        yb := math.min(sy1, f64(r + 1))
                        if yb > ya {
                            xa := sx0 + (sx1 - sx0) * ((ya - sy0) * inv_dy)
                            xb := sx0 + (sx1 - sx0) * ((yb - sy0) * inv_dy)
                            sdy := dir * (yb - ya)
                            row_cov := r * w
                            row_del := r * (w + 1)
                            xmin := math.min(xa, xb)
                            xmax := math.max(xa, xb)
                            span_x := xmax - xmin
                            if span_x <= 1.0e-9 {
                                xm := 0.5 * (xa + xb)
                                cx := int(math.floor(xm))
                                if cx < 0 {
                                    delta[row_del] = delta[row_del] + sdy
                                } else if cx < w {
                                    cover[row_cov + cx] = cover[row_cov + cx] + (f64(cx + 1) - xm) * sdy
                                    delta[row_del + cx + 1] = delta[row_del + cx + 1] + sdy
                                }
                            } else {
                                if xmax <= 0.0 {
                                    delta[row_del] = delta[row_del] + sdy
                                } else if xmin < fw {
                                    if xmin < 0.0 {
                                        left_frac := (math.min(xmax, 0.0) - xmin) / span_x
                                        delta[row_del] = delta[row_del] + sdy * left_frac
                                    }
                                    c_lo := clamp_int(int(math.floor(math.max(0.0, xmin))), 0, w - 1)
                                    c_hi := clamp_int(int(math.floor(math.min(fw - 1.0e-9, xmax))), 0, w - 1)
                                    for c in c_lo:(c_hi + 1) {
                                        seg_x0 := math.max(xmin, f64(c))
                                        seg_x1 := math.min(xmax, f64(c + 1))
                                        if seg_x1 > seg_x0 {
                                            sub_dy := sdy * ((seg_x1 - seg_x0) / span_x)
                                            xm := 0.5 * (seg_x0 + seg_x1)
                                            cover[row_cov + c] = cover[row_cov + c] + (f64(c + 1) - xm) * sub_dy
                                            delta[row_del + c + 1] = delta[row_del + c + 1] + sub_dy
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    $pixels := []u8{}
    for r in 0:h {
        $acc := 0.0
        row_cov := r * w
        row_del := r * (w + 1)
        for c in 0:w {
            acc = acc + delta[row_del + c]
            $cov := math.abs(acc + cover[row_cov + c])
            if cov > 1.0 { cov = 1.0 }
            v := clamp_int(int(math.floor(cov * 255.0 + 0.5)), 0, 255)
            pixels.push(u8(v))
        }
    }

    << GlyphBitmap{
        width: w,
        height: h,
        offset_x: ix0,
        offset_y: iy0,
        advance_x: adv,
        pixels: pixels
    }
}

pub struct ResolvedGlyph {
    pub face_index int
    pub font_id int
    pub glyph_id int
}

pub struct LineMetrics {
    pub ascent f64
    pub descent f64
    pub line_gap f64
    pub line_height f64
}

pub struct FontStack {
    pub faces []FontFace
}

pub fn new_font_stack() FontStack {
    << FontStack{faces: []FontFace{}}
}

pub fn (stack $&FontStack) add_face(face FontFace) int {
    idx := stack.faces.len
    stack.faces.push(face)
    << idx
}

pub fn (stack $&FontStack) ensure_builtin_fallback(face_id int) int {
    for i in 0:stack.faces.len {
        if stack.faces[i].is_builtin {
            << i
        }
    }
    stack.faces.push(builtin_font(face_id))
    << stack.faces.len - 1
}

pub fn (stack &FontStack) face_count() int {
    << stack.faces.len
}

pub fn (stack &FontStack) clone() FontStack {
    $faces := []FontFace{}
    for i in 0:stack.faces.len {
        faces.push(stack.faces[i].clone())
    }
    << FontStack{faces: faces}
}

pub fn (stack &FontStack) line_metrics(px_size f64) LineMetrics {
    if stack.faces.len == 0 {
        >> errors.new("font: empty font stack")
    }
    m := stack.faces[0].metrics
    if m.units_per_em <= 0 {
        >> errors.new("font: invalid unitsPerEm")
    }
    scale := px_size / f64(m.units_per_em)
    asc := f64(m.ascent) * scale
    desc := math.abs(f64(m.descent)) * scale
    gap := math.max(0.0, f64(m.line_gap) * scale)
    $lh := asc + desc + gap
    if lh < px_size {
        lh = px_size
    }
    << LineMetrics{ascent: asc, descent: desc, line_gap: gap, line_height: lh}
}

pub fn (stack &FontStack) resolve(codepoint int) ResolvedGlyph {
    if stack.faces.len == 0 {
        >> errors.new("font: empty font stack")
    }
    for i in 0:stack.faces.len {
        gid := stack.faces[i].glyph_index(codepoint)
        if gid > 0 {
            << ResolvedGlyph{face_index: i, font_id: stack.faces[i].id, glyph_id: gid}
        }
    }
    << ResolvedGlyph{face_index: 0, font_id: stack.faces[0].id, glyph_id: 0}
}

pub fn (stack &FontStack) advance_px(glyph ResolvedGlyph, px_size f64) f64 {
    if glyph.face_index < 0 || glyph.face_index >= stack.faces.len {
        >> errors.new("font: resolved face_index out of range")
    }
    m := stack.faces[glyph.face_index].metrics
    if m.units_per_em <= 0 {
        >> errors.new("font: invalid unitsPerEm")
    }
    gm := stack.faces[glyph.face_index].glyph_metrics(glyph.glyph_id) or >>
    << f64(gm.advance_width) * (px_size / f64(m.units_per_em))
}

pub fn (stack &FontStack) kerning_px(left ResolvedGlyph, right ResolvedGlyph, px_size f64) f64 {
    if left.face_index != right.face_index || left.face_index < 0 || left.face_index >= stack.faces.len {
        << 0.0
    }
    m := stack.faces[left.face_index].metrics
    if m.units_per_em <= 0 {
        << 0.0
    }
    k := stack.faces[left.face_index].kerning(left.glyph_id, right.glyph_id)
    << f64(k) * (px_size / f64(m.units_per_em))
}

pub fn (stack &FontStack) rasterize(glyph ResolvedGlyph, px_size f64) GlyphBitmap {
    if glyph.face_index < 0 || glyph.face_index >= stack.faces.len {
        >> errors.new("font: resolved face_index out of range")
    }
    outline := stack.faces[glyph.face_index].glyph_outline(glyph.glyph_id) or >>
    << rasterize_outline(&outline, px_size) or >>
}
