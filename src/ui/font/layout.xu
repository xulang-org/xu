@ui/font

#errors
#math
#unicode/utf8

pub const TEXT_LEFT = 0
pub const TEXT_CENTER = 1
pub const TEXT_RIGHT = 2

pub struct LayoutOptions {
    pub size f64
    pub width f64
    pub align int
    pub line_height f64
    pub masked bool
    pub disable_kerning bool
}

pub fn default_options(size f64) LayoutOptions {
    << LayoutOptions{
        size: size,
        width: 0.0,
        align: TEXT_LEFT,
        line_height: 0.0,
        masked: false,
        disable_kerning: false
    }
}

pub fn wrapped_options(size f64, width f64, align int) LayoutOptions {
    << LayoutOptions{
        size: size,
        width: width,
        align: align,
        line_height: 0.0,
        masked: false,
        disable_kerning: false
    }
}

pub struct TextMetrics {
    pub width f64
    pub height f64
    pub baseline f64
    pub lines int
    pub ink_x f64
    pub ink_y f64
    pub ink_width f64
    pub ink_height f64
}

pub struct TextHit {
    pub index int
    pub length int
    pub trailing bool
    pub inside bool
    pub x f64
    pub y f64
    pub height f64
}

pub fn (hit &TextHit) byte_index() int {
    if hit.trailing {
        << hit.index + hit.length
    }
    << hit.index
}

pub struct TextRect {
    pub x f64
    pub y f64
    pub width f64
    pub height f64
}

pub struct PositionedGlyph {
    pub byte_index int
    pub byte_length int
    pub codepoint int
    pub render_codepoint int
    pub face_index int
    pub font_id int
    pub glyph_id int
    pub x f64
    pub y f64
    pub baseline_y f64
    pub advance f64
    pub line_index int
    pub is_newline bool
    pub is_space bool
}

pub struct LineBox {
    pub line_index int
    pub start_item int
    pub end_item int
    pub byte_start int
    pub byte_end int
    pub byte_end_with_newline int
    pub x f64
    pub y f64
    pub baseline_y f64
    pub width f64
    pub height f64
}

pub struct TextLayout {
    pub metrics TextMetrics
    pub size f64
    pub width f64
    pub align int
    pub line_height f64
    pub text_len int
    pub masked bool
    pub glyphs []PositionedGlyph
    pub lines []LineBox
}

fn is_cjk_or_breakable(cp int) bool {
    if cp >= 0x4E00 && cp <= 0x9FFF { << true }
    if cp >= 0x3400 && cp <= 0x4DBF { << true }
    if cp >= 0x20000 && cp <= 0x2A6DF { << true }
    if cp >= 0x3000 && cp <= 0x30FF { << true }
    if cp >= 0xAC00 && cp <= 0xD7AF { << true }
    if cp >= 0xFF00 && cp <= 0xFFEF { << true }
    << false
}

fn is_horizontal_space(cp int) bool {
    << cp == 32 || cp == 9
}

struct TokenItem {
    byte_index int
    byte_length int
    codepoint int
    render_cp int
    resolved ResolvedGlyph
    advance f64
    is_newline bool
    is_space bool
}

pub fn layout_text(stack &FontStack, text &string, options &LayoutOptions) TextLayout {
    if stack.face_count() <= 0 {
        >>> errors.new("font: cannot layout text with empty FontStack")
    }
    if !utf8.valid(text) {
        >>> errors.new("font: invalid UTF-8 in text")
    }

    $size := options.size
    if size == 0.0 { size = 14.0 }
    if math.is_nan(size) || math.is_inf(size) || size < 1.0 || size > 512.0 {
        >>> errors.new("font: invalid text size")
    }
    if math.is_nan(options.width) || math.is_inf(options.width) || options.width < 0.0 || options.width > 262144.0 {
        >>> errors.new("font: invalid text wrap width")
    }
    if options.align < 0 || options.align > 2 || (options.width == 0.0 && options.align != 0) {
        >>> errors.new("font: invalid text align or align without explicit width")
    }
    lm := stack.line_metrics(size) >>>
    $lh := options.line_height
    if lh == 0.0 {
        lh = lm.line_height
    } else if math.is_nan(lh) || math.is_inf(lh) || lh < size || lh > 1024.0 {
        >>> errors.new("font: invalid line_height")
    }

    $tokens := []TokenItem{}
    $pos := 0
    while pos < text.len {
        b0 := text[pos] & 255
        if b0 == 13 {
            $blen := 1
            if pos + 1 < text.len && (text[pos + 1] & 255) == 10 {
                blen = 2
            }
            tokens.push(TokenItem{
                byte_index: pos,
                byte_length: blen,
                codepoint: 10,
                render_cp: 0,
                resolved: ResolvedGlyph{face_index: 0, font_id: 0, glyph_id: 0},
                advance: 0.0,
                is_newline: true,
                is_space: false
            })
            pos += blen
        } else if b0 == 10 {
            tokens.push(TokenItem{
                byte_index: pos,
                byte_length: 1,
                codepoint: 10,
                render_cp: 0,
                resolved: ResolvedGlyph{face_index: 0, font_id: 0, glyph_id: 0},
                advance: 0.0,
                is_newline: true,
                is_space: false
            })
            pos += 1
        } else {
            cp := utf8.decode(text, pos)
            blen := utf8.decode_width(text, pos)
            $rcp := cp
            $space := is_horizontal_space(cp)
            if options.masked {
                rcp = 8226
                space = false
            } else if cp == 9 {
                rcp = 32
            }
            rg := stack.resolve(rcp) >>>
            $adv := stack.advance_px(rg, size) >>>
            if cp == 9 && !options.masked {
                adv = adv * 4.0
            }
            tokens.push(TokenItem{
                byte_index: pos,
                byte_length: blen,
                codepoint: cp,
                render_cp: rcp,
                resolved: rg,
                advance: adv,
                is_newline: false,
                is_space: space
            })
            pos += blen
        }
    }

    $glyphs := []PositionedGlyph{}
    $lines := []LineBox{}

    $idx := 0
    $line_no := 0
    $has_pending_empty_line := tokens.len == 0

    while idx < tokens.len || has_pending_empty_line {
        if has_pending_empty_line && idx >= tokens.len {
            y_top := f64(line_no) * lh
            baseline := y_top + lm.ascent
            $lx := 0.0
            if options.align == TEXT_CENTER { lx = options.width * 0.5 }
            else if options.align == TEXT_RIGHT { lx = options.width }
            lines.push(LineBox{
                line_index: line_no,
                start_item: glyphs.len,
                end_item: glyphs.len,
                byte_start: text.len,
                byte_end: text.len,
                byte_end_with_newline: text.len,
                x: lx,
                y: y_top,
                baseline_y: baseline,
                width: 0.0,
                height: lh
            })
            has_pending_empty_line = false
            line_no += 1
        } else {
            line_byte_start := tokens[idx].byte_index
            $p_end := idx
            while p_end < tokens.len && !tokens[p_end].is_newline {
                p_end += 1
            }

            if idx == p_end {
                // Empty line terminating with a newline token
                nl := tokens[p_end]
                y_top := f64(line_no) * lh
                baseline := y_top + lm.ascent
                $lx := 0.0
                if options.align == TEXT_CENTER { lx = options.width * 0.5 }
                else if options.align == TEXT_RIGHT { lx = options.width }
                item_start := glyphs.len
                glyphs.push(PositionedGlyph{
                    byte_index: nl.byte_index,
                    byte_length: nl.byte_length,
                    codepoint: nl.codepoint,
                    render_codepoint: 0,
                    face_index: 0,
                    font_id: 0,
                    glyph_id: 0,
                    x: lx,
                    y: y_top,
                    baseline_y: baseline,
                    advance: 0.0,
                    line_index: line_no,
                    is_newline: true,
                    is_space: false
                })
                lines.push(LineBox{
                    line_index: line_no,
                    start_item: item_start,
                    end_item: item_start + 1,
                    byte_start: nl.byte_index,
                    byte_end: nl.byte_index,
                    byte_end_with_newline: nl.byte_index + nl.byte_length,
                    x: lx,
                    y: y_top,
                    baseline_y: baseline,
                    width: 0.0,
                    height: lh
                })
                idx = p_end + 1
                line_no += 1
                if idx == tokens.len {
                    has_pending_empty_line = true
                }
            } else {
                // Non-empty paragraph [idx .. p_end): wrap into >= 1 visual lines
                $cur := idx
                while cur < p_end {
                    $run_w := 0.0
                    $last_break := -1
                    $j := cur
                    $end_item := p_end
                    $wrapped := false
                    while j < p_end {
                        tok := tokens[j]
                        if j > cur {
                            prev := tokens[j - 1]
                            if prev.is_space || is_cjk_or_breakable(tok.codepoint) || is_cjk_or_breakable(prev.codepoint) {
                                last_break = j
                            }
                        }
                        $kern := 0.0
                        if j > cur && !options.disable_kerning && !options.masked {
                            kern = stack.kerning_px(tokens[j - 1].resolved, tok.resolved, size)
                        }
                        cand_w := run_w + kern + tok.advance
                        if options.width > 0.0 && j > cur && cand_w > options.width {
                            if !tok.is_space && last_break > cur {
                                end_item = last_break
                            } else {
                                end_item = j
                            }
                            wrapped = true
                            <-
                        }
                        run_w = cand_w
                        j += 1
                    }

                    // Compute exact widths (trimmed trailing whitespace width when wrapped for clean alignment)
                    $full_w := 0.0
                    $vis_end := end_item
                    if wrapped {
                        while vis_end > cur + 1 && tokens[vis_end - 1].is_space {
                            vis_end -= 1
                        }
                    }
                    $vis_w := 0.0
                    for t in cur:end_item {
                        $k := 0.0
                        if t > cur && !options.disable_kerning && !options.masked {
                            k = stack.kerning_px(tokens[t - 1].resolved, tokens[t].resolved, size)
                        }
                        full_w += k + tokens[t].advance
                        if t < vis_end {
                            vis_w += k + tokens[t].advance
                        }
                    }

                    y_top := f64(line_no) * lh
                    baseline := y_top + lm.ascent
                    $lx := 0.0
                    if options.align == TEXT_CENTER {
                        lx = 0.5 * (options.width - vis_w)
                    } else if options.align == TEXT_RIGHT {
                        lx = options.width - vis_w
                    }

                    item_start := glyphs.len
                    $pen_x := lx
                    for t in cur:end_item {
                        tok := tokens[t]
                        if t > cur && !options.disable_kerning && !options.masked {
                            pen_x += stack.kerning_px(tokens[t - 1].resolved, tok.resolved, size)
                        }
                        glyphs.push(PositionedGlyph{
                            byte_index: tok.byte_index,
                            byte_length: tok.byte_length,
                            codepoint: tok.codepoint,
                            render_codepoint: tok.render_cp,
                            face_index: tok.resolved.face_index,
                            font_id: tok.resolved.font_id,
                            glyph_id: tok.resolved.glyph_id,
                            x: pen_x,
                            y: y_top,
                            baseline_y: baseline,
                            advance: tok.advance,
                            line_index: line_no,
                            is_newline: false,
                            is_space: tok.is_space
                        })
                        pen_x += tok.advance
                    }

                    $b_end := tokens[end_item - 1].byte_index + tokens[end_item - 1].byte_length
                    $b_end_nl := b_end
                    if end_item == p_end && p_end < tokens.len && tokens[p_end].is_newline {
                        nl := tokens[p_end]
                        glyphs.push(PositionedGlyph{
                            byte_index: nl.byte_index,
                            byte_length: nl.byte_length,
                            codepoint: nl.codepoint,
                            render_codepoint: 0,
                            face_index: 0,
                            font_id: 0,
                            glyph_id: 0,
                            x: lx + vis_w,
                            y: y_top,
                            baseline_y: baseline,
                            advance: 0.0,
                            line_index: line_no,
                            is_newline: true,
                            is_space: false
                        })
                        b_end_nl = nl.byte_index + nl.byte_length
                    }

                    lines.push(LineBox{
                        line_index: line_no,
                        start_item: item_start,
                        end_item: glyphs.len,
                        byte_start: tokens[cur].byte_index,
                        byte_end: b_end,
                        byte_end_with_newline: b_end_nl,
                        x: lx,
                        y: y_top,
                        baseline_y: baseline,
                        width: vis_w,
                        height: lh
                    })
                    cur = end_item
                    line_no += 1
                }

                if p_end < tokens.len && tokens[p_end].is_newline {
                    idx = p_end + 1
                    if idx == tokens.len {
                        has_pending_empty_line = true
                    }
                } else {
                    idx = p_end
                }
            }
        }
    }

    $max_w := 0.0
    for i in 0:lines.len {
        if lines[i].width > max_w {
            max_w = lines[i].width
        }
    }
    total_h := f64(lines.len) * lh

    $has_ink := false
    $ink_x0 := 0.0
    $ink_y0 := 0.0
    $ink_x1 := 0.0
    $ink_y1 := 0.0
    for i in 0:glyphs.len {
        g := glyphs[i]
        if !g.is_newline && !g.is_space {
            outline := stack.faces[g.face_index].glyph_outline(g.glyph_id) >>>
            if outline.units_per_em > 0.0 && outline.points.len > 0 {
                sc := size / outline.units_per_em
                gx0 := g.x + outline.x_min * sc
                gx1 := g.x + outline.x_max * sc
                gy0 := g.baseline_y - outline.y_max * sc
                gy1 := g.baseline_y - outline.y_min * sc
                if !has_ink {
                    ink_x0 = gx0
                    ink_x1 = gx1
                    ink_y0 = gy0
                    ink_y1 = gy1
                    has_ink = true
                } else {
                    if gx0 < ink_x0 { ink_x0 = gx0 }
                    if gx1 > ink_x1 { ink_x1 = gx1 }
                    if gy0 < ink_y0 { ink_y0 = gy0 }
                    if gy1 > ink_y1 { ink_y1 = gy1 }
                }
            }
        }
    }

    $ink_w := 0.0
    $ink_h := 0.0
    if has_ink {
        ink_w = math.max(0.0, ink_x1 - ink_x0)
        ink_h = math.max(0.0, ink_y1 - ink_y0)
    }
    $baseline0 := lm.ascent
    if lines.len > 0 {
        baseline0 = lines[0].baseline_y
    }

    metrics := TextMetrics{
        width: max_w,
        height: total_h,
        baseline: baseline0,
        lines: lines.len,
        ink_x: ink_x0,
        ink_y: ink_y0,
        ink_width: ink_w,
        ink_height: ink_h
    }

    << TextLayout{
        metrics: metrics,
        size: size,
        width: options.width,
        align: options.align,
        line_height: lh,
        text_len: text.len,
        masked: options.masked,
        glyphs: glyphs,
        lines: lines
    }
}

pub fn (layout &TextLayout) glyph_count() int {
    << layout.glyphs.len
}

pub fn (layout &TextLayout) glyph_at(i int) PositionedGlyph {
    << layout.glyphs[i]
}

pub fn (layout &TextLayout) line_count() int {
    << layout.lines.len
}

pub fn (layout &TextLayout) line_at(i int) LineBox {
    << layout.lines[i]
}

pub fn (layout &TextLayout) populate_atlas(atlas $&GlyphAtlas, stack &FontStack) int {
    $count := 0
    for i in 0:layout.glyphs.len {
        g := layout.glyphs[i]
        if !g.is_newline {
            rg := ResolvedGlyph{face_index: g.face_index, font_id: g.font_id, glyph_id: g.glyph_id}
            atlas.get_or_rasterize(stack, rg, layout.size) >>>
            count += 1
        }
    }
    << count
}

pub fn (layout &TextLayout) caret(byte_index int, trailing bool) TextHit {
    if byte_index < 0 || byte_index > layout.text_len {
        >>> errors.new("font: caret byte offset out of range")
    }
    if byte_index == layout.text_len {
        if layout.lines.len == 0 {
            << TextHit{index: byte_index, length: 0, trailing: false, inside: true, x: 0.0, y: 0.0, height: layout.line_height}
        }
        last_line := layout.lines[layout.lines.len - 1]
        << TextHit{
            index: byte_index,
            length: 0,
            trailing: false,
            inside: true,
            x: last_line.x + last_line.width,
            y: last_line.y,
            height: last_line.height
        }
    }

    for i in 0:layout.glyphs.len {
        g := layout.glyphs[i]
        if byte_index >= g.byte_index && byte_index < g.byte_index + g.byte_length {
            if byte_index != g.byte_index {
                >>> errors.new("font: caret offset lies inside a UTF-8 sequence")
            }
            line := layout.lines[g.line_index]
            if g.is_newline {
                if trailing && g.line_index + 1 < layout.lines.len {
                    next_line := layout.lines[g.line_index + 1]
                    << TextHit{
                        index: g.byte_index,
                        length: g.byte_length,
                        trailing: true,
                        inside: true,
                        x: next_line.x,
                        y: next_line.y,
                        height: next_line.height
                    }
                }
                << TextHit{
                    index: g.byte_index,
                    length: g.byte_length,
                    trailing: false,
                    inside: true,
                    x: line.x + line.width,
                    y: line.y,
                    height: line.height
                }
            }
            $cx := g.x
            if trailing {
                cx = g.x + g.advance
            }
            << TextHit{
                index: g.byte_index,
                length: g.byte_length,
                trailing: trailing,
                inside: true,
                x: cx,
                y: line.y,
                height: line.height
            }
        }
    }
    >>> errors.new("font: failed to locate caret offset")
}

pub fn (layout &TextLayout) hit_test(x f64, y f64) TextHit {
    if math.is_nan(x) || math.is_nan(y) || math.is_inf(x) || math.is_inf(y) {
        >>> errors.new("font: invalid hit_test coordinates")
    }
    if layout.lines.len == 0 {
        << TextHit{index: 0, length: 0, trailing: false, inside: false, x: 0.0, y: 0.0, height: layout.line_height}
    }

    $target := layout.lines.len - 1
    if y < layout.lines[0].y {
        target = 0
    } else {
        for li in 0:layout.lines.len {
            lb := layout.lines[li]
            if y >= lb.y && y < lb.y + lb.height {
                target = li
                <-
            }
        }
    }

    line := layout.lines[target]
    y_inside := y >= line.y && y < line.y + line.height
    x_inside := x >= line.x && x <= line.x + line.width
    inside := y_inside && x_inside

    // Empty line (no non-newline items)
    $first_text := -1
    $last_text := -1
    for gi in line.start_item:line.end_item {
        if !layout.glyphs[gi].is_newline {
            if first_text < 0 { first_text = gi }
            last_text = gi
        }
    }

    if first_text < 0 {
        << TextHit{
            index: line.byte_start,
            length: 0,
            trailing: false,
            inside: inside,
            x: line.x,
            y: line.y,
            height: line.height
        }
    }

    first_g := layout.glyphs[first_text]
    if x <= first_g.x {
        << TextHit{
            index: first_g.byte_index,
            length: first_g.byte_length,
            trailing: false,
            inside: inside,
            x: first_g.x,
            y: line.y,
            height: line.height
        }
    }

    for gi in first_text:(last_text + 1) {
        g := layout.glyphs[gi]
        if x >= g.x && x < g.x + g.advance {
            mid := g.x + g.advance * 0.5
            tr := x >= mid
            $hx := g.x
            if tr { hx = g.x + g.advance }
            << TextHit{
                index: g.byte_index,
                length: g.byte_length,
                trailing: tr,
                inside: inside,
                x: hx,
                y: line.y,
                height: line.height
            }
        }
    }

    last_g := layout.glyphs[last_text]
    << TextHit{
        index: last_g.byte_index,
        length: last_g.byte_length,
        trailing: true,
        inside: inside,
        x: last_g.x + last_g.advance,
        y: line.y,
        height: line.height
    }
}

fn (layout &TextLayout) x_on_line_at(li int, byte_pos int) f64 {
    line := layout.lines[li]
    if byte_pos <= line.byte_start {
        << line.x
    }
    if byte_pos >= line.byte_end {
        << line.x + line.width
    }
    for gi in line.start_item:line.end_item {
        g := layout.glyphs[gi]
        if !g.is_newline {
            if byte_pos == g.byte_index {
                << g.x
            }
            if byte_pos == g.byte_index + g.byte_length {
                << g.x + g.advance
            }
        }
    }
    << line.x + line.width
}

fn validate_boundary(layout &TextLayout, byte_pos int) int {
    if byte_pos < 0 || byte_pos > layout.text_len {
        >>> errors.new("font: selection offset out of range")
    }
    if byte_pos == layout.text_len {
        << 0
    }
    for i in 0:layout.glyphs.len {
        g := layout.glyphs[i]
        if byte_pos >= g.byte_index && byte_pos < g.byte_index + g.byte_length {
            if byte_pos != g.byte_index {
                >>> errors.new("font: selection offset lies inside a UTF-8 sequence")
            }
            << 0
        }
    }
    << 0
}

pub fn (layout &TextLayout) selection_rects(start_byte int, end_byte int) []TextRect {
    validate_boundary(layout, start_byte) >>>
    validate_boundary(layout, end_byte) >>>
    $rects := []TextRect{}
    if start_byte == end_byte {
        << rects
    }
    $lo := start_byte
    $hi := end_byte
    if lo > hi {
        tmp := lo
        lo = hi
        hi = tmp
    }
    for li in 0:layout.lines.len {
        line := layout.lines[li]
        seg_a := lo
        $a := line.byte_start
        if seg_a > a { a = seg_a }
        $b := line.byte_end_with_newline
        if hi < b { b = hi }
        if a < b {
            x0 := layout.x_on_line_at(li, a)
            $x1 := layout.x_on_line_at(li, b)
            if b > line.byte_end {
                x1 = math.max(x1, line.x + line.width + layout.size * 0.25)
            }
            w := math.max(0.0, x1 - x0)
            rects.push(TextRect{x: x0, y: line.y, width: w, height: line.height})
        }
    }
    << rects
}
