@ui/font

#errors
#math
#unicode/utf8

pub struct LaidGlyph {
    pub face_index int
    pub font_id int
    pub glyph_id int
    pub x f64
    pub baseline_y f64
    pub advance f64
    pub is_newline bool
    pub byte_index int
    pub byte_length int
}

pub struct TextLayout {
    pub size f64
    pub metrics TextMetrics
    pub line_height f64
    glyphs []LaidGlyph
    text_len int
}

pub fn default_options(size f64) Options {
    << Options{size: size, width: 0.0, align: TEXT_LEFT, line_height: 0.0}
}

pub fn wrapped_options(size f64, width f64, align int) Options {
    $a := align
    if a < TEXT_LEFT || a > TEXT_RIGHT {
        a = TEXT_LEFT
    }
    << Options{size: size, width: width, align: a, line_height: 0.0}
}

fn effective_line_height(opts &Options) f64 {
    if opts.line_height > 0.0 {
        << opts.line_height
    }
    << opts.size * 1.25
}

fn stack_primary_face(stack &FontStack) int {
    if stack.faces.len == 0 {
        << -1
    }
    << 0
}

fn glyph_advance(stack &FontStack, rg ResolvedGlyph, size f64) f64 {
    idx := stack.face_by_font_id(rg.font_id)
    if idx < 0 {
        << size * 0.5
    }
    face := &stack.faces[idx]
    << scale_em(face_advance_em(face, rg.glyph_id), size, face.units_per_em)
}

struct LineMetrics {
    ascent f64
    descent f64
}

fn face_line_metrics(stack &FontStack, size f64) LineMetrics {
    idx := stack_primary_face(stack)
    if idx < 0 {
        << LineMetrics{ascent: size * 0.8, descent: size * 0.2}
    }
    face := &stack.faces[idx]
    asc := scale_em(face_ascent_em(face), size, face.units_per_em)
    $desc := scale_em(-face_descent_em(face), size, face.units_per_em)
    if desc < 0.0 {
        desc = -desc
    }
    << LineMetrics{ascent: asc, descent: desc}
}

fn is_space_cp(cp int) bool {
    << cp == 32 || cp == 9
}

fn align_line(glyphs $&[]LaidGlyph, start int, end int, line_width f64, opts &Options) {
    if opts.width <= 0.0 || opts.align == TEXT_LEFT || end <= start {
        <<
    }
    $shift := 0.0
    if opts.align == TEXT_CENTER {
        shift = (opts.width - line_width) * 0.5
    } else if opts.align == TEXT_RIGHT {
        shift = opts.width - line_width
    }
    if shift == 0.0 {
        <<
    }
    for i in start:end {
        $g := glyphs[i]
        if !g.is_newline {
            g.x = g.x + shift
            glyphs[i] = g
        }
    }
}

pub fn layout_text(stack &FontStack, text &string, opts &Options) TextLayout {
    if stack.faces.len == 0 {
        >> errors.new("ui/font: empty font stack")
    }
    if math.is_nan(opts.size) || math.is_inf(opts.size) || opts.size <= 0.0 || opts.size > max_px_size() {
        >> errors.new("ui/font: invalid layout size")
    }
    if math.is_nan(opts.width) || math.is_inf(opts.width) || opts.width < 0.0 {
        >> errors.new("ui/font: invalid layout width")
    }
    if text.len > 65536 {
        >> errors.new("ui/font: text too long")
    }
    if !utf8.valid(text) {
        >> errors.new("ui/font: invalid UTF-8")
    }

    lh := effective_line_height(opts)
    lm := face_line_metrics(stack, opts.size)
    ascent := lm.ascent
    $glyphs := []LaidGlyph{}
    $pen_x := 0.0
    $baseline := ascent
    $line_start := 0
    $line_width := 0.0
    $max_width := 0.0
    $lines := 1
    wrap_w := opts.width

    $i := 0
    while i < text.len {
        if text[i] == 10 {
            glyphs.push(LaidGlyph{
                face_index: 0,
                font_id: 0,
                glyph_id: 0,
                x: pen_x,
                baseline_y: baseline,
                advance: 0.0,
                is_newline: true,
                byte_index: i,
                byte_length: 1
            })
            end_align := glyphs.len - 1
            align_line($&glyphs, line_start, end_align, line_width, opts)
            if line_width > max_width {
                max_width = line_width
            }
            pen_x = 0.0
            line_width = 0.0
            baseline = baseline + lh
            lines = lines + 1
            line_start = glyphs.len
            i = i + 1
            ->
        }
        if text[i] == 13 {
            i = i + 1
            ->
        }
        cp := utf8.decode(text, i) or >>
        w := utf8.rune_len(cp) or >>
        rg := stack.resolve_codepoint(cp)
        adv := glyph_advance(stack, rg, opts.size)
        if wrap_w > 0.0 && pen_x > 0.0 && pen_x + adv > wrap_w && !is_space_cp(cp) {
            end_wrap := glyphs.len
            align_line($&glyphs, line_start, end_wrap, line_width, opts)
            if line_width > max_width {
                max_width = line_width
            }
            pen_x = 0.0
            line_width = 0.0
            baseline = baseline + lh
            lines = lines + 1
            line_start = glyphs.len
        }
        glyphs.push(LaidGlyph{
            face_index: rg.face_index,
            font_id: rg.font_id,
            glyph_id: rg.glyph_id,
            x: pen_x,
            baseline_y: baseline,
            advance: adv,
            is_newline: false,
            byte_index: i,
            byte_length: w
        })
        pen_x = pen_x + adv
        line_width = pen_x
        i = i + w
    }
    end_final := glyphs.len
    align_line($&glyphs, line_start, end_final, line_width, opts)
    if line_width > max_width {
        max_width = line_width
    }
    if wrap_w > 0.0 && opts.align != TEXT_LEFT && max_width < wrap_w {
        max_width = wrap_w
    }
    $height := f64(lines) * lh
    if glyphs.len == 0 {
        height = lh
        lines = 1
    }
    << TextLayout{
        size: opts.size,
        metrics: TextMetrics{
            width: max_width,
            height: height,
            baseline: ascent,
            lines: lines
        },
        line_height: lh,
        glyphs: glyphs,
        text_len: text.len
    }
}

pub fn (ly &TextLayout) glyph_count() int {
    << ly.glyphs.len
}

pub fn (ly &TextLayout) glyph_at(i int) LaidGlyph {
    if i < 0 || i >= ly.glyphs.len {
        << LaidGlyph{
            face_index: 0,
            font_id: 0,
            glyph_id: 0,
            x: 0.0,
            baseline_y: 0.0,
            advance: 0.0,
            is_newline: false,
            byte_index: 0,
            byte_length: 0
        }
    }
    << ly.glyphs[i]
}

pub fn (ly &TextLayout) populate_atlas(atlas $&GlyphAtlas, stack &FontStack) int {
    for i in 0:ly.glyphs.len {
        g := ly.glyphs[i]
        if g.is_newline {
            ->
        }
        rg := ResolvedGlyph{face_index: g.face_index, font_id: g.font_id, glyph_id: g.glyph_id}
        atlas.get_or_rasterize(stack, rg, ly.size) or >>
    }
    << 0
}

fn layout_empty_hit(ly &TextLayout, index int, trailing bool, inside bool) TextHit {
    << TextHit{
        index: index,
        length: 0,
        trailing: trailing,
        inside: inside,
        x: 0.0,
        y: 0.0,
        height: ly.line_height
    }
}

pub fn (ly &TextLayout) caret(byte_index int, trailing bool) TextHit {
    if byte_index < 0 || byte_index > ly.text_len + 1 {
        >> errors.new("ui/font: invalid caret index")
    }
    if ly.glyphs.len == 0 {
        << layout_empty_hit(ly, 0, false, false)
    }
    $best := -1
    for i in 0:ly.glyphs.len {
        g := ly.glyphs[i]
        if g.is_newline {
            if byte_index == g.byte_index {
                << TextHit{
                    index: g.byte_index,
                    length: g.byte_length,
                    trailing: false,
                    inside: true,
                    x: g.x,
                    y: g.baseline_y - ly.metrics.baseline,
                    height: ly.line_height
                }
            }
            ->
        }
        if byte_index < g.byte_index {
            <-
        }
        best = i
        if byte_index == g.byte_index {
            $x := g.x
            $tr := trailing
            if tr {
                x = g.x + g.advance
            }
            << TextHit{
                index: g.byte_index,
                length: g.byte_length,
                trailing: tr,
                inside: true,
                x: x,
                y: g.baseline_y - ly.metrics.baseline,
                height: ly.line_height
            }
        }
        if byte_index > g.byte_index && byte_index < g.byte_index + g.byte_length {
            >> errors.new("ui/font: caret inside UTF-8 sequence")
        }
    }
    if best >= 0 {
        g := ly.glyphs[best]
        if !g.is_newline && byte_index >= g.byte_index + g.byte_length {
            << TextHit{
                index: g.byte_index,
                length: g.byte_length,
                trailing: true,
                inside: true,
                x: g.x + g.advance,
                y: g.baseline_y - ly.metrics.baseline,
                height: ly.line_height
            }
        }
    }
    last := ly.glyphs[ly.glyphs.len - 1]
    << TextHit{
        index: ly.text_len,
        length: 0,
        trailing: false,
        inside: true,
        x: last.x + last.advance,
        y: last.baseline_y - ly.metrics.baseline,
        height: ly.line_height
    }
}

pub fn (ly &TextLayout) hit_test(x f64, y f64) TextHit {
    if math.is_nan(x) || math.is_nan(y) || math.is_inf(x) || math.is_inf(y) {
        >> errors.new("ui/font: invalid hit coordinates")
    }
    if ly.glyphs.len == 0 {
        << layout_empty_hit(ly, 0, false, false)
    }
    $inside := y >= 0.0 && y <= ly.metrics.height
    $line_idx := 0
    if y > 0.0 {
        line_idx = int(y / ly.line_height)
    }
    if line_idx < 0 {
        line_idx = 0
        inside = false
    }
    if line_idx >= ly.metrics.lines {
        line_idx = ly.metrics.lines - 1
        inside = false
    }
    target_baseline := ly.metrics.baseline + f64(line_idx) * ly.line_height

    $line_first := -1
    $line_last := -1
    for i in 0:ly.glyphs.len {
        g := ly.glyphs[i]
        if math.abs(g.baseline_y - target_baseline) < ly.line_height * 0.5 {
            if line_first < 0 {
                line_first = i
            }
            line_last = i
        }
    }
    if line_first < 0 {
        << ly.caret(0, false) or >>
    }

    if x <= ly.glyphs[line_first].x {
        g := ly.glyphs[line_first]
        << TextHit{
            index: g.byte_index,
            length: g.byte_length,
            trailing: false,
            inside: inside,
            x: g.x,
            y: g.baseline_y - ly.metrics.baseline,
            height: ly.line_height
        }
    }

    for i in line_first:line_last + 1 {
        g := ly.glyphs[i]
        if g.is_newline {
            << TextHit{
                index: g.byte_index,
                length: g.byte_length,
                trailing: false,
                inside: inside,
                x: g.x,
                y: g.baseline_y - ly.metrics.baseline,
                height: ly.line_height
            }
        }
        mid := g.x + g.advance * 0.5
        right := g.x + g.advance
        if x < mid {
            << TextHit{
                index: g.byte_index,
                length: g.byte_length,
                trailing: false,
                inside: inside,
                x: g.x,
                y: g.baseline_y - ly.metrics.baseline,
                height: ly.line_height
            }
        }
        if x < right || i == line_last {
            << TextHit{
                index: g.byte_index,
                length: g.byte_length,
                trailing: true,
                inside: inside,
                x: right,
                y: g.baseline_y - ly.metrics.baseline,
                height: ly.line_height
            }
        }
    }
    g := ly.glyphs[line_last]
    << TextHit{
        index: g.byte_index,
        length: g.byte_length,
        trailing: true,
        inside: inside,
        x: g.x + g.advance,
        y: g.baseline_y - ly.metrics.baseline,
        height: ly.line_height
    }
}
