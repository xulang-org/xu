@ui/font

#errors
#math

pub const TEXT_LEFT = 0
pub const TEXT_CENTER = 1
pub const TEXT_RIGHT = 2

pub const FACE_BUILTIN = 0
pub const FACE_TTF = 1

pub const MAX_PX_SIZE_I = 512
pub const DEFAULT_ATLAS_INIT = 512
pub const DEFAULT_ATLAS_MAX = 2048

fn max_px_size() f64 {
    << f64(MAX_PX_SIZE_I)
}

pub struct ResolvedGlyph {
    pub face_index int
    pub font_id int
    pub glyph_id int
}

pub struct TextMetrics {
    pub width f64
    pub height f64
    pub baseline f64
    pub lines int
}

pub struct TextHit {
    pub index int
    pub length int
    pub trailing bool
    pub inside bool
    pub x f64
    pub y f64
    pub height f64
}

pub fn (hit &TextHit) byte_index() int {
    if hit.trailing {
        << hit.index + hit.length
    }
    << hit.index
}

pub struct Options {
    pub size f64
    pub width f64
    pub align int
    pub line_height f64
}

pub struct FontFace {
    pub font_id int
    pub face_index int
    pub priority int
    kind int
    units_per_em int
    ascent int
    descent int
    line_gap int
    num_glyphs int
    // Builtin: glyph_id == Unicode codepoint for U+0020..U+007E.
    // TTF: raw SFNT bytes plus parsed cmap / hmtx tables.
    ttf_bytes []u8
    cmap_starts []int
    cmap_ends []int
    cmap_deltas []int
    cmap_offsets []int
    cmap_glyph_ids []int
    advances []int
    left_bearings []int
    loca []int
    glyf_off int
    glyf_len int
    is_short_loca bool
}

pub struct FontStack {
    faces []FontFace
    next_font_id int
    has_builtin bool
}

pub fn new_font_stack() FontStack {
    << FontStack{faces: []FontFace{}, next_font_id: 1, has_builtin: false}
}

pub fn (stack $&FontStack) add_face(face FontFace) {
    $f := face
    if f.font_id <= 0 {
        f.font_id = stack.next_font_id
        stack.next_font_id = stack.next_font_id + 1
    } else if f.font_id >= stack.next_font_id {
        stack.next_font_id = f.font_id + 1
    }
    // Append only; resolve_codepoint selects by priority then insertion order.
    stack.faces.push(f)
}

pub fn (stack $&FontStack) ensure_builtin_fallback(priority int) {
    if stack.has_builtin {
        <<
    }
    face := make_builtin_face(stack.next_font_id, priority)
    stack.next_font_id = stack.next_font_id + 1
    stack.add_face(face)
    stack.has_builtin = true
}

pub fn (stack &FontStack) resolve_codepoint(cp int) ResolvedGlyph {
    $best_i := -1
    $best_pri := -2147483647
    $best_gid := -1
    for i in 0:stack.faces.len {
        face := &stack.faces[i]
        gid := face_lookup_glyph(face, cp)
        if gid < 0 {
            ->
        }
        if best_i < 0 || face.priority > best_pri {
            best_i = i
            best_pri = face.priority
            best_gid = gid
        }
    }
    if best_i >= 0 {
        face := &stack.faces[best_i]
        << ResolvedGlyph{face_index: face.face_index, font_id: face.font_id, glyph_id: best_gid}
    }
    if cp != 63 {
        << stack.resolve_codepoint(63)
    }
    if stack.faces.len > 0 {
        face := &stack.faces[0]
        << ResolvedGlyph{face_index: face.face_index, font_id: face.font_id, glyph_id: 0}
    }
    << ResolvedGlyph{face_index: 0, font_id: 0, glyph_id: 0}
}

pub fn (stack &FontStack) face_by_font_id(font_id int) int {
    for i in 0:stack.faces.len {
        if stack.faces[i].font_id == font_id {
            << i
        }
    }
    << -1
}

pub fn (stack &FontStack) rasterize(rg ResolvedGlyph, px_size f64) GlyphBitmap {
    if math.is_nan(px_size) || math.is_inf(px_size) || px_size <= 0.0 || px_size > max_px_size() {
        >> errors.new("ui/font: invalid rasterize size")
    }
    idx := stack.face_by_font_id(rg.font_id)
    if idx < 0 {
        >> errors.new("ui/font: unknown font_id")
    }
    face := &stack.faces[idx]
    if face.kind == FACE_BUILTIN {
        << builtin_rasterize(face, rg.glyph_id, px_size) or >>
    }
    << ttf_rasterize(face, rg.glyph_id, px_size) or >>
}

pub fn quantize_px_size(size f64) int {
    if math.is_nan(size) || math.is_inf(size) || size <= 0.0 || size > max_px_size() {
        >> errors.new("ui/font: px size out of range")
    }
    q := int(math.round(size * 4.0))
    if q <= 0 {
        >> errors.new("ui/font: quantized size is zero")
    }
    << q
}

fn face_lookup_glyph(face &FontFace, cp int) int {
    if face.kind == FACE_BUILTIN {
        << builtin_lookup(cp)
    }
    << ttf_lookup(face, cp)
}

fn face_advance_em(face &FontFace, glyph_id int) int {
    if face.kind == FACE_BUILTIN {
        << builtin_advance_em(glyph_id)
    }
    if glyph_id < 0 || glyph_id >= face.advances.len {
        if face.advances.len > 0 {
            << face.advances[0]
        }
        << face.units_per_em / 2
    }
    << face.advances[glyph_id]
}

fn face_ascent_em(face &FontFace) int {
    if face.ascent != 0 {
        << face.ascent
    }
    << face.units_per_em
}

fn face_descent_em(face &FontFace) int {
    << face.descent
}

fn scale_em(v int, px_size f64, units int) f64 {
    if units <= 0 {
        << 0.0
    }
    << f64(v) * px_size / f64(units)
}
