@ui/layout

#errors
#math

// Layout uses logical pixels, with the same finite extent limit as draw.Frame.
// A parent supplies Constraints; children return a Size within those constraints.
pub const max_extent = 1000000000
pub struct Size {
    pub width f64
    pub height f64
}
pub struct Rect {
    pub x f64
    pub y f64
    pub width f64
    pub height f64
}
pub struct Insets {
    pub left f64
    pub top f64
    pub right f64
    pub bottom f64
}
pub struct Constraints {
    pub min_width f64
    pub max_width f64
    pub min_height f64
    pub max_height f64
}

fn extent(value f64) bool {
    << !math.is_nan(value) && !math.is_inf(value) && value >= 0.0 && value <= f64(max_extent)
}
fn coordinate(value f64) bool {
    << !math.is_nan(value) && !math.is_inf(value) && math.abs(value) <= f64(max_extent)
}
pub fn (c &Constraints) validate() int {
    if !extent(c.min_width) || !extent(c.max_width) || !extent(c.min_height) || !extent(c.max_height) ||
       c.min_width > c.max_width || c.min_height > c.max_height {
        >> errors.new("layout: invalid constraints")
    }
    << 0
}
pub fn constraints(min_width f64,max_width f64,min_height f64,max_height f64) Constraints {
    value := Constraints{min_width: min_width,max_width: max_width,min_height: min_height,max_height: max_height}
    value.validate() or >>
    << value
}
pub fn tight(width f64,height f64) Constraints {
    << constraints(width,width,height,height) or >>
}
pub fn loose(max_width f64,max_height f64) Constraints {
    << constraints(0.0,max_width,0.0,max_height) or >>
}
pub fn (c &Constraints) loosen() Constraints {
    c.validate() or >>
    << Constraints{min_width: 0.0,max_width: c.max_width,min_height: 0.0,max_height: c.max_height}
}
pub fn (c &Constraints) constrain(size &Size) Size {
    c.validate() or >>
    if !extent(size.width) || !extent(size.height) { >> errors.new("layout: invalid child size") }
    << Size{width: math.max(c.min_width,math.min(c.max_width,size.width)),height: math.max(c.min_height,math.min(c.max_height,size.height))}
}
pub fn (c &Constraints) contains(size &Size) bool {
    c.validate() or >>
    << extent(size.width) && extent(size.height) && size.width >= c.min_width && size.width <= c.max_width &&
       size.height >= c.min_height && size.height <= c.max_height
}
pub fn (padding &Insets) validate() int {
    if !extent(padding.left) || !extent(padding.top) || !extent(padding.right) || !extent(padding.bottom) ||
       padding.left + padding.right > f64(max_extent) || padding.top + padding.bottom > f64(max_extent) {
        >> errors.new("layout: invalid padding")
    }
    << 0
}
pub fn insets(all f64) Insets {
    value := Insets{left: all,top: all,right: all,bottom: all}
    value.validate() or >>
    << value
}
pub fn (c &Constraints) deflate(padding &Insets) Constraints {
    c.validate() or >>
    padding.validate() or >>
    width := padding.left + padding.right
    height := padding.top + padding.bottom
    << Constraints{min_width: math.max(0.0,c.min_width - width),max_width: math.max(0.0,c.max_width - width),
                   min_height: math.max(0.0,c.min_height - height),max_height: math.max(0.0,c.max_height - height)}
}
// Return the parent's constrained size after the child has been laid out.
pub fn (c &Constraints) wrap_padding(child &Size,padding &Insets) Size {
    padding.validate() or >>
    if !extent(child.width) || !extent(child.height) { >> errors.new("layout: invalid child size") }
    size := Size{width: child.width + padding.left + padding.right,height: child.height + padding.top + padding.bottom}
    << c.constrain(&size) or >>
}
// Alignment -1/0/1 means start/center/end. An oversized child may overflow its
// parent; clipping is a separate rendering decision. Edges are half-open.
pub fn align(parent &Rect,child &Size,x_alignment f64,y_alignment f64) Rect {
    if !coordinate(parent.x) || !coordinate(parent.y) || !extent(parent.width) || !extent(parent.height) ||
       !extent(child.width) || !extent(child.height) || !coordinate(x_alignment) || !coordinate(y_alignment) ||
       math.abs(x_alignment) > 1.0 || math.abs(y_alignment) > 1.0 {
        >> errors.new("layout: invalid alignment")
    }
    x := parent.x + (parent.width - child.width) * (x_alignment + 1.0) * 0.5
    y := parent.y + (parent.height - child.height) * (y_alignment + 1.0) * 0.5
    if !coordinate(x) || !coordinate(y) { >> errors.new("layout: alignment exceeds coordinate range") }
    << Rect{x: x,y: y,width: child.width,height: child.height}
}
pub fn (rect &Rect) contains(x f64,y f64) bool {
    << coordinate(x) && coordinate(y) && coordinate(rect.x) && coordinate(rect.y) && extent(rect.width) && extent(rect.height) &&
       x >= rect.x && y >= rect.y && x - rect.x < rect.width && y - rect.y < rect.height
}
pub fn intersect(first &Rect,second &Rect) Rect {
    if !coordinate(first.x) || !coordinate(first.y) || !coordinate(second.x) || !coordinate(second.y) ||
       !extent(first.width) || !extent(first.height) || !extent(second.width) || !extent(second.height) {
        >> errors.new("layout: invalid rectangle")
    }
    x := math.max(first.x,second.x)
    y := math.max(first.y,second.y)
    right := math.min(first.x + first.width,second.x + second.width)
    bottom := math.min(first.y + first.height,second.y + second.height)
    << Rect{x: x,y: y,width: math.max(0.0,right - x),height: math.max(0.0,bottom - y)}
}
