@ui/layout

#errors
#math

pub const box_leaf = 0
pub const box_row = 1
pub const box_column = 2
pub const box_stack = 3
pub const box_padding = 4
pub const max_tree_nodes = 4096
pub const max_tree_depth = 64
pub struct Offset {
    pub x f64
    pub y f64
}

// Negative one means natural size. Fixed sizes are still constrained by the
// parent. Configuration contains no persistent identity or rendering resources.
pub struct BoxStyle {
    pub kind int
    pub width f64
    pub height f64
    pub padding Insets
    pub gap f64
    pub main_alignment int
    pub cross_alignment int
    pub align_x f64
    pub align_y f64
    pub clip bool
    pub hidden bool
}
pub fn box_style(kind int) BoxStyle {
    << BoxStyle{kind: kind,width: -1.0,height: -1.0,padding: Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0},gap: 0.0,
                main_alignment: main_start,cross_alignment: cross_start,align_x: -1.0,align_y: -1.0,clip: false,hidden: false}
}
pub fn (style &BoxStyle) validate() int {
    style.padding.validate() or >>
    if style.kind < box_leaf || style.kind > box_padding || (style.width != -1.0 && !extent(style.width)) ||
       (style.height != -1.0 && !extent(style.height)) || !extent(style.gap) ||
       style.main_alignment < main_start || style.main_alignment > main_space_evenly ||
       style.cross_alignment < cross_start || style.cross_alignment > cross_stretch ||
       !coordinate(style.align_x) || !coordinate(style.align_y) || math.abs(style.align_x) > 1.0 || math.abs(style.align_y) > 1.0 {
        >> errors.new("layout: invalid box style")
    }
    << 0
}
fn copy_style(style &BoxStyle) BoxStyle {
    << BoxStyle{kind: style.kind,width: style.width,height: style.height,
                padding: Insets{left: style.padding.left,top: style.padding.top,right: style.padding.right,bottom: style.padding.bottom},
                gap: style.gap,main_alignment: style.main_alignment,cross_alignment: style.cross_alignment,
                align_x: style.align_x,align_y: style.align_y,clip: style.clip,hidden: style.hidden}
}
fn same_style(a &BoxStyle,b &BoxStyle) bool {
    << a.kind == b.kind && a.width == b.width && a.height == b.height && a.padding.left == b.padding.left &&
       a.padding.top == b.padding.top && a.padding.right == b.padding.right && a.padding.bottom == b.padding.bottom &&
       a.gap == b.gap && a.main_alignment == b.main_alignment && a.cross_alignment == b.cross_alignment &&
       a.align_x == b.align_x && a.align_y == b.align_y && a.clip == b.clip && a.hidden == b.hidden
}
fn copy_constraints(c &Constraints) Constraints {
    << Constraints{min_width: c.min_width,max_width: c.max_width,min_height: c.min_height,max_height: c.max_height}
}
fn same_constraints(a &Constraints,b &Constraints) bool {
    << a.min_width == b.min_width && a.max_width == b.max_width && a.min_height == b.min_height && a.max_height == b.max_height
}
struct BoxNode {
    id int
    parent int
    first int
    last int
    next int
    previous int
    depth int
    style_kind int
    style_width f64
    style_height f64
    style_gap f64
    style_main_alignment int
    style_cross_alignment int
    style_align_x f64
    style_align_y f64
    style_clip bool
    style_hidden bool
    padding_left f64
    padding_top f64
    padding_right f64
    padding_bottom f64
    intrinsic_width f64
    intrinsic_height f64
    bounds_x f64
    bounds_y f64
    bounds_width f64
    bounds_height f64
    offset_x f64
    offset_y f64
    scroll_x f64
    scroll_y f64
    constraints_min_width f64
    constraints_max_width f64
    constraints_min_height f64
    constraints_max_height f64
    measured bool
    layout_dirty bool
    paint_revision int
}
// The arena stores scalar fields; value objects are constructed at its API boundary.
fn (tree &Tree) node_style(index int) BoxStyle {
    << BoxStyle{kind: tree.nodes[index].style_kind,width: tree.nodes[index].style_width,height: tree.nodes[index].style_height,
        gap: tree.nodes[index].style_gap,main_alignment: tree.nodes[index].style_main_alignment,cross_alignment: tree.nodes[index].style_cross_alignment,
        align_x: tree.nodes[index].style_align_x,align_y: tree.nodes[index].style_align_y,clip: tree.nodes[index].style_clip,hidden: tree.nodes[index].style_hidden,
        padding: Insets{left: tree.nodes[index].padding_left,top: tree.nodes[index].padding_top,
                       right: tree.nodes[index].padding_right,bottom: tree.nodes[index].padding_bottom}}
}
fn (tree &Tree) node_constraints(index int) Constraints {
    << Constraints{min_width: tree.nodes[index].constraints_min_width,max_width: tree.nodes[index].constraints_max_width,min_height: tree.nodes[index].constraints_min_height,max_height: tree.nodes[index].constraints_max_height}
}
pub struct LayoutStats {
    pub measured int
    pub reused int
}
// A bounded flat arena. IDs never repeat, including after remove/reuse of an
// arena slot. Traversal uses indices; public handles are checked at the boundary.
pub struct Tree {
    nodes []BoxNode
    lookup map[int]int
    root int
    next_id int
    revision int
    measured int
    reused int
}
pub fn tree() Tree {
    << Tree{nodes: []BoxNode{},lookup: map[int]int{},root: -1,next_id: 0,revision: 0,measured: 0,reused: 0}
}
fn (tree &Tree) index(id int) int {
    found := tree.lookup.get_or(id,0)
    if id > 0 && found > 0 { << found - 1 }
    >> errors.new("layout: stale or unknown node")
}
pub fn (tree &Tree) contains(id int) bool {
    << id > 0 && tree.lookup.has(id)
}
fn (tree &mut Tree) paint_changed(index int) {
    tree.revision = tree.revision + 1
    mut current := index
    while current >= 0 {
        tree.nodes[current].paint_revision = tree.revision
        current = tree.nodes[current].parent
    }
}
fn (tree &mut Tree) layout_changed(index int) {
    mut current := index
    while current >= 0 {
        tree.nodes[current].layout_dirty = true
        current = tree.nodes[current].parent
    }
    tree.paint_changed(index)
}
pub fn (tree &mut Tree) add(parent int,style &BoxStyle,intrinsic &Size) int {
    style.validate() or >>
    if !extent(intrinsic.width) || !extent(intrinsic.height) || tree.next_id >= 2147483647 {
        >> errors.new("layout: invalid intrinsic size or exhausted identity")
    }
    mut owner := -1
    mut depth := 0
    if parent == 0 {
        if tree.root >= 0 { >> errors.new("layout: tree already has a root") }
    } else {
        owner = tree.index(parent) or >>
        if tree.nodes[owner].style_kind == box_leaf || (tree.nodes[owner].style_kind == box_padding && tree.nodes[owner].first >= 0) {
            >> errors.new("layout: parent cannot accept another child")
        }
        depth = tree.nodes[owner].depth + 1
        if depth >= max_tree_depth { >> errors.new("layout: tree depth exceeded") }
    }
    mut slot := -1
    for i in 0:tree.nodes.len { if tree.nodes[i].id == 0 { slot = i
        <- } }
    if slot < 0 && tree.nodes.len >= max_tree_nodes { >> errors.new("layout: node capacity exceeded") }
    tree.next_id = tree.next_id + 1
    node := BoxNode{id: tree.next_id,parent: owner,first: -1,last: -1,next: -1,previous: -1,depth: depth,
        style_kind: style.kind,style_width: style.width,style_height: style.height,style_gap: style.gap,
        style_main_alignment: style.main_alignment,style_cross_alignment: style.cross_alignment,
        style_align_x: style.align_x,style_align_y: style.align_y,style_clip: style.clip,style_hidden: style.hidden,
        padding_left: style.padding.left,padding_top: style.padding.top,padding_right: style.padding.right,padding_bottom: style.padding.bottom,
        intrinsic_width: intrinsic.width,intrinsic_height: intrinsic.height,bounds_x: 0.0,bounds_y: 0.0,bounds_width: 0.0,bounds_height: 0.0,
        offset_x: 0.0,offset_y: 0.0,scroll_x: 0.0,scroll_y: 0.0,
        constraints_min_width: 0.0,constraints_max_width: 0.0,constraints_min_height: 0.0,constraints_max_height: 0.0,
        measured: false,layout_dirty: true,paint_revision: 0}
    if slot < 0 { slot = tree.nodes.len
        tree.nodes.push(node) }
    else { tree.nodes[slot] = node }
    tree.lookup[tree.next_id] = slot + 1
    if owner < 0 { tree.root = slot }
    else {
        last := tree.nodes[owner].last
        tree.nodes[slot].previous = last
        if last >= 0 { tree.nodes[last].next = slot }
        else { tree.nodes[owner].first = slot }
        tree.nodes[owner].last = slot
    }
    tree.layout_changed(slot)
    << tree.next_id
}
pub fn (tree &Tree) style(id int) BoxStyle { index := tree.index(id) or >>
    << tree.node_style(index) }
pub fn (tree &mut Tree) set_style(id int,style &BoxStyle) int {
    style.validate() or >>
    index := tree.index(id) or >>
    if style.kind != tree.nodes[index].style_kind { >> errors.new("layout: node kind is immutable") }
    old := tree.node_style(index)
    if same_style(&old,style) { << 0 }
    // Clip alone changes paint/hit testing, without changing measurement.
    mut comparison := copy_style(style)
    comparison.clip = old.clip
    paint_only := same_style(&old,&comparison)
    tree.nodes[index].style_kind = style.kind
    tree.nodes[index].style_width = style.width
    tree.nodes[index].style_height = style.height
    tree.nodes[index].style_gap = style.gap
    tree.nodes[index].style_main_alignment = style.main_alignment
    tree.nodes[index].style_cross_alignment = style.cross_alignment
    tree.nodes[index].style_align_x = style.align_x
    tree.nodes[index].style_align_y = style.align_y
    tree.nodes[index].style_clip = style.clip
    tree.nodes[index].style_hidden = style.hidden
    tree.nodes[index].padding_left = style.padding.left
    tree.nodes[index].padding_top = style.padding.top
    tree.nodes[index].padding_right = style.padding.right
    tree.nodes[index].padding_bottom = style.padding.bottom
    if paint_only { tree.paint_changed(index) }
    else { tree.layout_changed(index) }
    << 0
}
pub fn (tree &mut Tree) set_intrinsic(id int,size &Size) int {
    if !extent(size.width) || !extent(size.height) { >> errors.new("layout: invalid intrinsic size") }
    index := tree.index(id) or >>
    if tree.nodes[index].intrinsic_width != size.width || tree.nodes[index].intrinsic_height != size.height {
        tree.nodes[index].intrinsic_width = size.width
        tree.nodes[index].intrinsic_height = size.height
        tree.layout_changed(index)
    }
    << 0
}
pub fn (tree &mut Tree) invalidate_paint(id int) int { index := tree.index(id) or >>
    tree.paint_changed(index)
    << 0 }
// Placement/composition never changes child measurement or its own paint record.
pub fn (tree &mut Tree) set_offset(id int,x f64,y f64) int {
    if !coordinate(x) || !coordinate(y) { >> errors.new("layout: invalid node offset") }
    index := tree.index(id) or >>
    owner := tree.nodes[index].parent
    if owner < 0 { >> errors.new("layout: root offset is fixed at the canvas origin") }
    if tree.nodes[index].offset_x != x || tree.nodes[index].offset_y != y {
        tree.nodes[index].offset_x = x
        tree.nodes[index].offset_y = y
        tree.paint_changed(owner)
    }
    << 0
}
pub fn (tree &mut Tree) set_scroll(id int,x f64,y f64) int {
    if !extent(x) || !extent(y) { >> errors.new("layout: invalid content scroll offset") }
    index := tree.index(id) or >>
    if tree.nodes[index].scroll_x != x || tree.nodes[index].scroll_y != y {
        tree.nodes[index].scroll_x = x
        tree.nodes[index].scroll_y = y
        tree.paint_changed(index)
    }
    << 0
}
pub fn (tree &Tree) scroll_offset(id int) Offset {
    index := tree.index(id) or >>
    << Offset{x: tree.nodes[index].scroll_x,y: tree.nodes[index].scroll_y}
}
pub fn (tree &Tree) paint_revision(id int) int { index := tree.index(id) or >>
    << tree.nodes[index].paint_revision }
pub fn (tree &Tree) parent(id int) int { index := tree.index(id) or >>
    owner := tree.nodes[index].parent
    if owner < 0 { << 0 }
    << tree.nodes[owner].id }
pub fn (tree &Tree) children(id int) []int {
    index := tree.index(id) or >>
    mut result := []int{}
    mut child := tree.nodes[index].first
    while child >= 0 { result.push(tree.nodes[child].id)
        child = tree.nodes[child].next }
    << result
}
fn (tree &mut Tree) retire(index int) {
    mut child := tree.nodes[index].first
    while child >= 0 { next := tree.nodes[child].next
        tree.retire(child)
        child = next }
    id := tree.nodes[index].id
    lookup := mut &tree.lookup
    lookup.delete(id)
    tree.nodes[index].id = 0
}
pub fn (tree &mut Tree) remove(id int) int {
    index := tree.index(id) or >>
    owner := tree.nodes[index].parent
    previous := tree.nodes[index].previous
    next := tree.nodes[index].next
    if previous >= 0 { tree.nodes[previous].next = next }
    else if owner >= 0 { tree.nodes[owner].first = next }
    if next >= 0 { tree.nodes[next].previous = previous }
    else if owner >= 0 { tree.nodes[owner].last = previous }
    tree.retire(index)
    if owner >= 0 { tree.layout_changed(owner) }
    else { tree.root = -1 }
    << 0
}
pub fn (tree &Tree) needs_layout() bool { << tree.root >= 0 && tree.nodes[tree.root].layout_dirty }
pub fn (tree &Tree) layout_stats() LayoutStats { << LayoutStats{measured: tree.measured,reused: tree.reused} }
fn (tree &mut Tree) place(index int,x f64,y f64) {
    if tree.nodes[index].bounds_x != x || tree.nodes[index].bounds_y != y {
        tree.nodes[index].bounds_x = x
        tree.nodes[index].bounds_y = y
        owner := tree.nodes[index].parent
        if owner >= 0 { tree.paint_changed(owner) }
    }
}
fn (tree &mut Tree) measure(index int,incoming &Constraints) Size {
    cached := tree.node_constraints(index)
    if !tree.nodes[index].layout_dirty && tree.nodes[index].measured && same_constraints(&cached,incoming) {
        tree.reused = tree.reused + 1
        << Size{width: tree.nodes[index].bounds_width,height: tree.nodes[index].bounds_height}
    }
    tree.measured = tree.measured + 1
    style := tree.node_style(index)
    mut size := Size{width: 0.0,height: 0.0}
    if !style.hidden {
        mut own := copy_constraints(incoming)
        if style.width >= 0.0 { width := math.max(own.min_width,math.min(own.max_width,style.width))
            own.min_width = width
            own.max_width = width }
        if style.height >= 0.0 { height := math.max(own.min_height,math.min(own.max_height,style.height))
            own.min_height = height
            own.max_height = height }
        inner := own.deflate(&style.padding) or >>
        mut child_constraints := inner.loosen() or >>
        if style.kind == box_row { child_constraints.max_width = f64(max_extent)
            if style.cross_alignment == cross_stretch { child_constraints.min_height = inner.max_height } }
        if style.kind == box_column { child_constraints.max_height = f64(max_extent)
            if style.cross_alignment == cross_stretch { child_constraints.min_width = inner.max_width } }
        mut ids := []int{}
        mut sizes := []Size{}
        mut natural := Size{width: tree.nodes[index].intrinsic_width,height: tree.nodes[index].intrinsic_height}
        mut child := tree.nodes[index].first
        while child >= 0 {
            if !tree.nodes[child].style_hidden {
                measured := tree.measure(child,&child_constraints) or >>
                ids.push(child)
                sizes.push(measured)
                if style.kind == box_stack || style.kind == box_padding {
                    natural.width = math.max(natural.width,measured.width)
                    natural.height = math.max(natural.height,measured.height)
                }
            }
            child = tree.nodes[child].next
        }
        if style.kind == box_row || style.kind == box_column {
            mut positions := Flow{size: Size{width: 0.0,height: 0.0},children: []Rect{},overflow_x: false,overflow_y: false}
            if style.kind == box_row { positions = row(&inner,&sizes,style.gap,style.main_alignment,style.cross_alignment) or >> }
            else { positions = column(&inner,&sizes,style.gap,style.main_alignment,style.cross_alignment) or >> }
            natural = Size{width: positions.size.width,height: positions.size.height}
            for i in 0:ids.len { tree.place(ids[i],style.padding.left + positions.children[i].x,style.padding.top + positions.children[i].y) }
        }
        size = own.wrap_padding(&natural,&style.padding) or >>
        if style.kind == box_stack || style.kind == box_padding {
            area := Rect{x: style.padding.left,y: style.padding.top,width: math.max(0.0,size.width - style.padding.left - style.padding.right),
                         height: math.max(0.0,size.height - style.padding.top - style.padding.bottom)}
            for i in 0:ids.len { position := align(&area,&sizes[i],style.align_x,style.align_y) or >>
                tree.place(ids[i],position.x,position.y) }
        }
    }
    if tree.nodes[index].bounds_width != size.width || tree.nodes[index].bounds_height != size.height { tree.paint_changed(index) }
    tree.nodes[index].bounds_width = size.width
    tree.nodes[index].bounds_height = size.height
    tree.nodes[index].constraints_min_width = incoming.min_width
    tree.nodes[index].constraints_max_width = incoming.max_width
    tree.nodes[index].constraints_min_height = incoming.min_height
    tree.nodes[index].constraints_max_height = incoming.max_height
    tree.nodes[index].measured = true
    tree.nodes[index].layout_dirty = false
    << size
}
pub fn (tree &mut Tree) layout(constraints &Constraints) Size {
    constraints.validate() or >>
    if tree.root < 0 { >> errors.new("layout: tree has no root") }
    tree.measured = 0
    tree.reused = 0
    size := tree.measure(tree.root,constraints) or (err) {
        tree.nodes[tree.root].layout_dirty = true
        >> err
    }
    << size
}
pub fn (tree &Tree) bounds(id int) Rect {
    index := tree.index(id) or >>
    x := tree.nodes[index].bounds_x + tree.nodes[index].offset_x
    y := tree.nodes[index].bounds_y + tree.nodes[index].offset_y
    if !coordinate(x) || !coordinate(y) { >> errors.new("layout: positioned coordinate range exceeded") }
    << Rect{x: x,y: y,width: tree.nodes[index].bounds_width,height: tree.nodes[index].bounds_height}
}
pub fn (tree &Tree) visible(id int) bool {
    mut index := tree.index(id) or >>
    while index >= 0 {
        if tree.nodes[index].style_hidden { << false }
        index = tree.nodes[index].parent
    }
    << true
}
pub fn (tree &Tree) global_bounds(id int) Rect {
    index := tree.index(id) or >>
    mut result := tree.bounds(id) or >>
    mut owner := tree.nodes[index].parent
    while owner >= 0 {
        result.x = result.x + tree.nodes[owner].bounds_x + tree.nodes[owner].offset_x - tree.nodes[owner].scroll_x
        result.y = result.y + tree.nodes[owner].bounds_y + tree.nodes[owner].offset_y - tree.nodes[owner].scroll_y
        owner = tree.nodes[owner].parent
    }
    if !coordinate(result.x) || !coordinate(result.y) { >> errors.new("layout: global coordinate range exceeded") }
    << result
}
fn (tree &Tree) hit(index int,x f64,y f64) int {
    if tree.nodes[index].style_hidden { << 0 }
    local := Rect{x: 0.0,y: 0.0,width: tree.nodes[index].bounds_width,height: tree.nodes[index].bounds_height}
    inside := local.contains(x,y)
    if tree.nodes[index].style_clip && !inside { << 0 }
    mut child := tree.nodes[index].last
    while child >= 0 {
        found := tree.hit(child,x + tree.nodes[index].scroll_x - tree.nodes[child].bounds_x - tree.nodes[child].offset_x,y + tree.nodes[index].scroll_y - tree.nodes[child].bounds_y - tree.nodes[child].offset_y)
        if found != 0 { << found }
        child = tree.nodes[child].previous
    }
    if inside { << tree.nodes[index].id }
    << 0
}
pub fn (tree &Tree) hit_test(x f64,y f64) int {
    if tree.root < 0 || tree.needs_layout() || !tree.nodes[tree.root].measured || !coordinate(x) || !coordinate(y) {
        >> errors.new("layout: hit testing requires a current layout and finite coordinates")
    }
    << tree.hit(tree.root,x,y)
}
