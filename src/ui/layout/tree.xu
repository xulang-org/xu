@ui/layout

#errors
#math

pub const BOX_LEAF = 0
pub const BOX_ROW = 1
pub const BOX_COLUMN = 2
pub const BOX_STACK = 3
pub const BOX_PADDING = 4
pub const BOX_WRAP = 5
pub const BOX_GRID = 6
pub const MAX_TREE_NODES = 4096
pub const MAX_TREE_DEPTH = 64
pub struct Offset {
    pub x f64
    pub y f64
}

// Negative one means natural/unconstrained. Fixed sizes are still constrained by the
// parent. Configuration contains no persistent identity or rendering resources.
pub struct BoxStyle {
    pub kind int
    pub width f64
    pub height f64
    pub min_width f64
    pub max_width f64
    pub min_height f64
    pub max_height f64
    pub width_pct f64
    pub height_pct f64
    pub aspect_ratio f64
    pub flex_grow f64
    pub flex_shrink f64
    pub padding Insets
    pub gap f64
    pub run_gap f64
    pub columns int
    pub col_span int
    pub min_col_width f64
    pub col_weights []f64
    pub order int
    pub main_alignment int
    pub cross_alignment int
    pub align_self int
    pub align_x f64
    pub align_y f64
    pub stack_align_x f64
    pub stack_align_y f64
    pub clip bool
    pub hidden bool
}
pub fn box_style(kind int) BoxStyle {
    << BoxStyle{kind: kind,width: -1.0,height: -1.0,min_width: 0.0,max_width: -1.0,min_height: 0.0,max_height: -1.0,
                width_pct: -1.0,height_pct: -1.0,aspect_ratio: 0.0,
                flex_grow: 0.0,flex_shrink: 0.0,padding: Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0},
                gap: 0.0,run_gap: 0.0,columns: 1,col_span: 1,min_col_width: 0.0,col_weights: []f64{},order: 0,
                main_alignment: MAIN_START,cross_alignment: CROSS_START,align_self: -1,align_x: -1.0,align_y: -1.0,
                stack_align_x: -2.0,stack_align_y: -2.0,clip: false,hidden: false}
}
fn valid_pct(value f64) bool {
    << value == -1.0 || (!math.is_nan(value) && !math.is_inf(value) && value >= 0.0 && value <= 1.0)
}
fn same_floats(a &[]f64,b &[]f64) bool {
    if a.len != b.len { << false }
    for i in 0:a.len {
        if a[i] != b[i] { << false }
    }
    << true
}
fn clone_floats(src &[]f64) []f64 {
    $out := []f64{}
    for v in src { out.push(v) }
    << out
}
pub fn (style &BoxStyle) validate() int {
    style.padding.validate() or >>
    if style.kind < BOX_LEAF || style.kind > BOX_GRID || (style.width != -1.0 && !extent(style.width)) ||
       (style.height != -1.0 && !extent(style.height)) || !extent(style.min_width) || !extent(style.min_height) ||
       (style.max_width != -1.0 && (!extent(style.max_width) || style.max_width < style.min_width)) ||
       (style.max_height != -1.0 && (!extent(style.max_height) || style.max_height < style.min_height)) ||
       !valid_pct(style.width_pct) || !valid_pct(style.height_pct) ||
       math.is_nan(style.aspect_ratio) || math.is_inf(style.aspect_ratio) || style.aspect_ratio < 0.0 || style.aspect_ratio > 1000.0 ||
       math.is_nan(style.flex_grow) || math.is_inf(style.flex_grow) || style.flex_grow < 0.0 || style.flex_grow > 1000.0 ||
       math.is_nan(style.flex_shrink) || math.is_inf(style.flex_shrink) || style.flex_shrink < 0.0 || style.flex_shrink > 1000.0 ||
       !extent(style.gap) || !extent(style.run_gap) || style.columns < 1 || style.columns > 256 ||
       style.col_span < 1 || style.col_span > 256 || !extent(style.min_col_width) ||
       (style.col_weights.len != 0 && style.min_col_width <= 0.0 && style.col_weights.len != style.columns) ||
       style.order < -1000000 || style.order > 1000000 ||
       style.main_alignment < MAIN_START || style.main_alignment > MAIN_SPACE_EVENLY ||
       style.cross_alignment < CROSS_START || style.cross_alignment > CROSS_STRETCH ||
       style.align_self < -1 || style.align_self > CROSS_STRETCH ||
       !coordinate(style.align_x) || !coordinate(style.align_y) || math.abs(style.align_x) > 1.0 || math.abs(style.align_y) > 1.0 ||
       (style.stack_align_x != -2.0 && (!coordinate(style.stack_align_x) || math.abs(style.stack_align_x) > 1.0)) ||
       (style.stack_align_y != -2.0 && (!coordinate(style.stack_align_y) || math.abs(style.stack_align_y) > 1.0)) {
        >> errors.new("layout: invalid box style")
    }
    for w in style.col_weights {
        if math.is_nan(w) || math.is_inf(w) || w <= 0.0 || w > 10000.0 {
            >> errors.new("layout: invalid box grid weight")
        }
    }
    << 0
}
fn copy_style(style &BoxStyle) BoxStyle {
    << BoxStyle{kind: style.kind,width: style.width,height: style.height,
                min_width: style.min_width,max_width: style.max_width,min_height: style.min_height,max_height: style.max_height,
                width_pct: style.width_pct,height_pct: style.height_pct,aspect_ratio: style.aspect_ratio,
                flex_grow: style.flex_grow,flex_shrink: style.flex_shrink,
                padding: Insets{left: style.padding.left,top: style.padding.top,right: style.padding.right,bottom: style.padding.bottom},
                gap: style.gap,run_gap: style.run_gap,columns: style.columns,col_span: style.col_span,
                min_col_width: style.min_col_width,col_weights: clone_floats(&style.col_weights),order: style.order,
                main_alignment: style.main_alignment,cross_alignment: style.cross_alignment,align_self: style.align_self,
                align_x: style.align_x,align_y: style.align_y,stack_align_x: style.stack_align_x,stack_align_y: style.stack_align_y,
                clip: style.clip,hidden: style.hidden}
}
fn same_style(a &BoxStyle,b &BoxStyle) bool {
    << a.kind == b.kind && a.width == b.width && a.height == b.height &&
       a.min_width == b.min_width && a.max_width == b.max_width && a.min_height == b.min_height && a.max_height == b.max_height &&
       a.width_pct == b.width_pct && a.height_pct == b.height_pct && a.aspect_ratio == b.aspect_ratio &&
       a.flex_grow == b.flex_grow && a.flex_shrink == b.flex_shrink &&
       a.padding.left == b.padding.left && a.padding.top == b.padding.top && a.padding.right == b.padding.right && a.padding.bottom == b.padding.bottom &&
       a.gap == b.gap && a.run_gap == b.run_gap && a.columns == b.columns && a.col_span == b.col_span &&
       a.min_col_width == b.min_col_width && same_floats(&a.col_weights,&b.col_weights) && a.order == b.order &&
       a.main_alignment == b.main_alignment && a.cross_alignment == b.cross_alignment && a.align_self == b.align_self &&
       a.align_x == b.align_x && a.align_y == b.align_y && a.stack_align_x == b.stack_align_x && a.stack_align_y == b.stack_align_y &&
       a.clip == b.clip && a.hidden == b.hidden
}
fn copy_constraints(c &Constraints) Constraints {
    << Constraints{min_width: c.min_width,max_width: c.max_width,min_height: c.min_height,max_height: c.max_height}
}
fn same_constraints(a &Constraints,b &Constraints) bool {
    << a.min_width == b.min_width && a.max_width == b.max_width && a.min_height == b.min_height && a.max_height == b.max_height
}
struct BoxNode {
    id int
    parent int
    first int
    last int
    next int
    previous int
    depth int
    style_kind int
    style_width f64
    style_height f64
    style_min_width f64
    style_max_width f64
    style_min_height f64
    style_max_height f64
    style_width_pct f64
    style_height_pct f64
    style_aspect_ratio f64
    style_flex_grow f64
    style_flex_shrink f64
    style_gap f64
    style_run_gap f64
    style_columns int
    style_col_span int
    style_min_col_width f64
    style_order int
    style_main_alignment int
    style_cross_alignment int
    style_align_self int
    style_align_x f64
    style_align_y f64
    style_stack_align_x f64
    style_stack_align_y f64
    style_clip bool
    style_hidden bool
    padding_left f64
    padding_top f64
    padding_right f64
    padding_bottom f64
    intrinsic_width f64
    intrinsic_height f64
    bounds_x f64
    bounds_y f64
    bounds_width f64
    bounds_height f64
    offset_x f64
    offset_y f64
    scroll_x f64
    scroll_y f64
    constraints_min_width f64
    constraints_max_width f64
    constraints_min_height f64
    constraints_max_height f64
    measured bool
    layout_dirty bool
    paint_revision int
}
// The arena stores scalar fields; value objects are constructed at its API boundary.
fn (tree &Tree) node_style(index int) BoxStyle {
    $ws := []f64{}
    nid := tree.nodes[index].id
    if tree.col_weights.has(nid) { ws = clone_floats(&tree.col_weights[nid]) }
    << BoxStyle{kind: tree.nodes[index].style_kind,width: tree.nodes[index].style_width,height: tree.nodes[index].style_height,
        min_width: tree.nodes[index].style_min_width,max_width: tree.nodes[index].style_max_width,
        min_height: tree.nodes[index].style_min_height,max_height: tree.nodes[index].style_max_height,
        width_pct: tree.nodes[index].style_width_pct,height_pct: tree.nodes[index].style_height_pct,
        aspect_ratio: tree.nodes[index].style_aspect_ratio,
        flex_grow: tree.nodes[index].style_flex_grow,flex_shrink: tree.nodes[index].style_flex_shrink,
        gap: tree.nodes[index].style_gap,run_gap: tree.nodes[index].style_run_gap,
        columns: tree.nodes[index].style_columns,col_span: tree.nodes[index].style_col_span,
        min_col_width: tree.nodes[index].style_min_col_width,col_weights: ws,order: tree.nodes[index].style_order,
        main_alignment: tree.nodes[index].style_main_alignment,cross_alignment: tree.nodes[index].style_cross_alignment,
        align_self: tree.nodes[index].style_align_self,
        align_x: tree.nodes[index].style_align_x,align_y: tree.nodes[index].style_align_y,
        stack_align_x: tree.nodes[index].style_stack_align_x,stack_align_y: tree.nodes[index].style_stack_align_y,
        clip: tree.nodes[index].style_clip,hidden: tree.nodes[index].style_hidden,
        padding: Insets{left: tree.nodes[index].padding_left,top: tree.nodes[index].padding_top,
                       right: tree.nodes[index].padding_right,bottom: tree.nodes[index].padding_bottom}}
}
fn (tree &Tree) node_constraints(index int) Constraints {
    << Constraints{min_width: tree.nodes[index].constraints_min_width,max_width: tree.nodes[index].constraints_max_width,min_height: tree.nodes[index].constraints_min_height,max_height: tree.nodes[index].constraints_max_height}
}
pub struct LayoutStats {
    pub measured int
    pub reused int
}
// A bounded flat arena. IDs never repeat, including after remove/reuse of an
// arena slot. Traversal uses indices; public handles are checked at the boundary.
pub struct Tree {
    nodes []BoxNode
    free_slots []int
    lookup map[int]int
    col_weights map[int][]f64
    root int
    next_id int
    revision int
    measured int
    reused int
}
pub fn tree() Tree {
    << Tree{nodes: []BoxNode{},free_slots: []int{},lookup: map[int]int{},col_weights: map[int][]f64{},root: -1,next_id: 0,revision: 0,measured: 0,reused: 0}
}
fn (tree &Tree) index(id int) int {
    found := tree.lookup.get_or(id,0)
    if id > 0 && found > 0 { << found - 1 }
    >> errors.new("layout: stale or unknown node")
}
pub fn (tree &Tree) contains(id int) bool {
    << id > 0 && tree.lookup.has(id)
}
fn (tree $&Tree) paint_changed(index int) {
    tree.revision = tree.revision + 1
    $current := index
    while current >= 0 {
        tree.nodes[current].paint_revision = tree.revision
        current = tree.nodes[current].parent
    }
}
fn (tree $&Tree) layout_changed(index int) {
    $current := index
    while current >= 0 {
        tree.nodes[current].layout_dirty = true
        current = tree.nodes[current].parent
    }
    tree.paint_changed(index)
}
pub fn (tree $&Tree) add(parent int,style &BoxStyle,intrinsic &Size) int {
    style.validate() or >>
    if !extent(intrinsic.width) || !extent(intrinsic.height) || tree.next_id >= 2147483647 {
        >> errors.new("layout: invalid intrinsic size or exhausted identity")
    }
    $owner := -1
    $depth := 0
    if parent == 0 {
        if tree.root >= 0 { >> errors.new("layout: tree already has a root") }
    } else {
        owner = tree.index(parent) or >>
        if tree.nodes[owner].style_kind == BOX_LEAF || (tree.nodes[owner].style_kind == BOX_PADDING && tree.nodes[owner].first >= 0) {
            >> errors.new("layout: parent cannot accept another child")
        }
        depth = tree.nodes[owner].depth + 1
        if depth >= MAX_TREE_DEPTH { >> errors.new("layout: tree depth exceeded") }
    }
    $slot := -1
    if tree.free_slots.len > 0 {
        slot = tree.free_slots[tree.free_slots.len - 1]
        if tree.free_slots.len <= 1 { tree.free_slots = []int{} }
        else { tree.free_slots = tree.free_slots[0:tree.free_slots.len - 1] }
    }
    if slot < 0 && tree.nodes.len >= MAX_TREE_NODES { >> errors.new("layout: node capacity exceeded") }
    tree.next_id = tree.next_id + 1
    node := BoxNode{id: tree.next_id,parent: owner,first: -1,last: -1,next: -1,previous: -1,depth: depth,
        style_kind: style.kind,style_width: style.width,style_height: style.height,
        style_min_width: style.min_width,style_max_width: style.max_width,
        style_min_height: style.min_height,style_max_height: style.max_height,
        style_width_pct: style.width_pct,style_height_pct: style.height_pct,style_aspect_ratio: style.aspect_ratio,
        style_flex_grow: style.flex_grow,style_flex_shrink: style.flex_shrink,
        style_gap: style.gap,style_run_gap: style.run_gap,
        style_columns: style.columns,style_col_span: style.col_span,
        style_min_col_width: style.min_col_width,style_order: style.order,
        style_main_alignment: style.main_alignment,style_cross_alignment: style.cross_alignment,
        style_align_self: style.align_self,
        style_align_x: style.align_x,style_align_y: style.align_y,
        style_stack_align_x: style.stack_align_x,style_stack_align_y: style.stack_align_y,
        style_clip: style.clip,style_hidden: style.hidden,
        padding_left: style.padding.left,padding_top: style.padding.top,padding_right: style.padding.right,padding_bottom: style.padding.bottom,
        intrinsic_width: intrinsic.width,intrinsic_height: intrinsic.height,bounds_x: 0.0,bounds_y: 0.0,bounds_width: 0.0,bounds_height: 0.0,
        offset_x: 0.0,offset_y: 0.0,scroll_x: 0.0,scroll_y: 0.0,
        constraints_min_width: 0.0,constraints_max_width: 0.0,constraints_min_height: 0.0,constraints_max_height: 0.0,
        measured: false,layout_dirty: true,paint_revision: 0}
    if slot < 0 { slot = tree.nodes.len
        tree.nodes.push(node) }
    else { tree.nodes[slot] = node }
    tree.lookup[tree.next_id] = slot + 1
    if style.col_weights.len > 0 {
        cws := $&tree.col_weights
        cws[tree.next_id] = clone_floats(&style.col_weights)
    }
    if owner < 0 { tree.root = slot }
    else {
        last := tree.nodes[owner].last
        tree.nodes[slot].previous = last
        if last >= 0 { tree.nodes[last].next = slot }
        else { tree.nodes[owner].first = slot }
        tree.nodes[owner].last = slot
    }
    tree.layout_changed(slot)
    << tree.next_id
}
pub fn (tree &Tree) style(id int) BoxStyle { index := tree.index(id) or >>
    << tree.node_style(index) }
pub fn (tree $&Tree) set_style(id int,style &BoxStyle) int {
    style.validate() or >>
    index := tree.index(id) or >>
    if style.kind != tree.nodes[index].style_kind { >> errors.new("layout: node kind is immutable") }
    old := tree.node_style(index)
    if same_style(&old,style) { << 0 }
    // Clip alone changes paint/hit testing, without changing measurement.
    $comparison := copy_style(style)
    comparison.clip = old.clip
    paint_only := same_style(&old,&comparison)
    tree.nodes[index].style_kind = style.kind
    tree.nodes[index].style_width = style.width
    tree.nodes[index].style_height = style.height
    tree.nodes[index].style_min_width = style.min_width
    tree.nodes[index].style_max_width = style.max_width
    tree.nodes[index].style_min_height = style.min_height
    tree.nodes[index].style_max_height = style.max_height
    tree.nodes[index].style_width_pct = style.width_pct
    tree.nodes[index].style_height_pct = style.height_pct
    tree.nodes[index].style_aspect_ratio = style.aspect_ratio
    tree.nodes[index].style_flex_grow = style.flex_grow
    tree.nodes[index].style_flex_shrink = style.flex_shrink
    tree.nodes[index].style_gap = style.gap
    tree.nodes[index].style_run_gap = style.run_gap
    tree.nodes[index].style_columns = style.columns
    tree.nodes[index].style_col_span = style.col_span
    tree.nodes[index].style_min_col_width = style.min_col_width
    tree.nodes[index].style_order = style.order
    tree.nodes[index].style_main_alignment = style.main_alignment
    tree.nodes[index].style_cross_alignment = style.cross_alignment
    tree.nodes[index].style_align_self = style.align_self
    tree.nodes[index].style_align_x = style.align_x
    tree.nodes[index].style_align_y = style.align_y
    tree.nodes[index].style_stack_align_x = style.stack_align_x
    tree.nodes[index].style_stack_align_y = style.stack_align_y
    tree.nodes[index].style_clip = style.clip
    tree.nodes[index].style_hidden = style.hidden
    tree.nodes[index].padding_left = style.padding.left
    tree.nodes[index].padding_top = style.padding.top
    tree.nodes[index].padding_right = style.padding.right
    tree.nodes[index].padding_bottom = style.padding.bottom
    cws := $&tree.col_weights
    if style.col_weights.len > 0 { cws[id] = clone_floats(&style.col_weights) }
    else if cws.has(id) { cws.delete(id) }
    if paint_only { tree.paint_changed(index) }
    else { tree.layout_changed(index) }
    << 0
}
pub fn (tree $&Tree) set_intrinsic(id int,size &Size) int {
    if !extent(size.width) || !extent(size.height) { >> errors.new("layout: invalid intrinsic size") }
    index := tree.index(id) or >>
    if tree.nodes[index].intrinsic_width != size.width || tree.nodes[index].intrinsic_height != size.height {
        tree.nodes[index].intrinsic_width = size.width
        tree.nodes[index].intrinsic_height = size.height
        tree.layout_changed(index)
    }
    << 0
}
pub fn (tree $&Tree) invalidate_paint(id int) int { index := tree.index(id) or >>
    tree.paint_changed(index)
    << 0 }
// Placement/composition never changes child measurement or its own paint record.
pub fn (tree $&Tree) set_offset(id int,x f64,y f64) int {
    if !coordinate(x) || !coordinate(y) { >> errors.new("layout: invalid node offset") }
    index := tree.index(id) or >>
    owner := tree.nodes[index].parent
    if owner < 0 { >> errors.new("layout: root offset is fixed at the canvas origin") }
    if tree.nodes[index].offset_x != x || tree.nodes[index].offset_y != y {
        tree.nodes[index].offset_x = x
        tree.nodes[index].offset_y = y
        tree.paint_changed(owner)
    }
    << 0
}
pub fn (tree $&Tree) set_scroll(id int,x f64,y f64) int {
    if !extent(x) || !extent(y) { >> errors.new("layout: invalid content scroll offset") }
    index := tree.index(id) or >>
    if tree.nodes[index].scroll_x != x || tree.nodes[index].scroll_y != y {
        tree.nodes[index].scroll_x = x
        tree.nodes[index].scroll_y = y
        tree.paint_changed(index)
    }
    << 0
}
pub fn (tree &Tree) scroll_offset(id int) Offset {
    index := tree.index(id) or >>
    << Offset{x: tree.nodes[index].scroll_x,y: tree.nodes[index].scroll_y}
}
pub fn (tree &Tree) paint_revision(id int) int { index := tree.index(id) or >>
    << tree.nodes[index].paint_revision }
pub fn (tree &Tree) parent(id int) int { index := tree.index(id) or >>
    owner := tree.nodes[index].parent
    if owner < 0 { << 0 }
    << tree.nodes[owner].id }
pub fn (tree &Tree) children(id int) []int {
    index := tree.index(id) or >>
    $result := []int{}
    $child := tree.nodes[index].first
    while child >= 0 { result.push(tree.nodes[child].id)
        child = tree.nodes[child].next }
    << result
}
fn (tree $&Tree) retire(index int) {
    $child := tree.nodes[index].first
    while child >= 0 { next := tree.nodes[child].next
        tree.retire(child)
        child = next }
    id := tree.nodes[index].id
    lookup := $&tree.lookup
    lookup.delete(id)
    if tree.col_weights.has(id) {
        cws := $&tree.col_weights
        cws.delete(id)
    }
    tree.nodes[index].id = 0
    fs := $&tree.free_slots
    fs.push(index)
}
pub fn (tree $&Tree) remove(id int) int {
    index := tree.index(id) or >>
    owner := tree.nodes[index].parent
    previous := tree.nodes[index].previous
    next := tree.nodes[index].next
    if previous >= 0 { tree.nodes[previous].next = next }
    else if owner >= 0 { tree.nodes[owner].first = next }
    if next >= 0 { tree.nodes[next].previous = previous }
    else if owner >= 0 { tree.nodes[owner].last = previous }
    tree.retire(index)
    if owner >= 0 { tree.layout_changed(owner) }
    else { tree.root = -1 }
    << 0
}
pub fn (tree &Tree) needs_layout() bool { << tree.root >= 0 && tree.nodes[tree.root].layout_dirty }
pub fn (tree &Tree) layout_stats() LayoutStats { << LayoutStats{measured: tree.measured,reused: tree.reused} }
fn (tree $&Tree) place(index int,x f64,y f64) {
    if tree.nodes[index].bounds_x != x || tree.nodes[index].bounds_y != y {
        tree.nodes[index].bounds_x = x
        tree.nodes[index].bounds_y = y
        owner := tree.nodes[index].parent
        if owner >= 0 { tree.paint_changed(owner) }
    }
}
fn (tree &Tree) sorted_visible_children(index int) []int {
    $ids := []int{}
    $has_order := false
    $child := tree.nodes[index].first
    while child >= 0 {
        if !tree.nodes[child].style_hidden {
            ids.push(child)
            if tree.nodes[child].style_order != 0 { has_order = true }
        }
        child = tree.nodes[child].next
    }
    if has_order && ids.len > 1 {
        for i in 1:ids.len {
            key := ids[i]
            key_ord := tree.nodes[key].style_order
            $j := i - 1
            while j >= 0 && tree.nodes[ids[j]].style_order > key_ord {
                ids[j + 1] = ids[j]
                j = j - 1
            }
            ids[j + 1] = key
        }
    }
    << ids
}
fn (tree &Tree) apply_child_pct_constraints(cid int,cc $&Constraints,ref_w f64,ref_h f64,apply_w bool,apply_h bool) bool {
    $locked_w := false
    if apply_w && tree.nodes[cid].style_width < 0.0 && tree.nodes[cid].style_width_pct >= 0.0 && ref_w < f64(MAX_EXTENT) {
        $rw := ref_w * tree.nodes[cid].style_width_pct
        rw = math.max(tree.nodes[cid].style_min_width,rw)
        if tree.nodes[cid].style_max_width >= 0.0 { rw = math.min(tree.nodes[cid].style_max_width,rw) }
        cc.min_width = math.max(cc.min_width,math.min(cc.max_width,rw))
        cc.max_width = math.min(cc.max_width,cc.min_width)
        locked_w = true
    }
    if apply_h && tree.nodes[cid].style_height < 0.0 && tree.nodes[cid].style_height_pct >= 0.0 && ref_h < f64(MAX_EXTENT) {
        $rh := ref_h * tree.nodes[cid].style_height_pct
        rh = math.max(tree.nodes[cid].style_min_height,rh)
        if tree.nodes[cid].style_max_height >= 0.0 { rh = math.min(tree.nodes[cid].style_max_height,rh) }
        cc.min_height = math.max(cc.min_height,math.min(cc.max_height,rh))
        cc.max_height = math.min(cc.max_height,cc.min_height)
    }
    << locked_w
}
fn apply_box_aspect_ratio(size &Size,own &Constraints,style &BoxStyle) Size {
    ar := style.aspect_ratio
    if ar <= 0.0 { << Size{width: size.width,height: size.height} }
    $w := size.width
    $h := size.height
    w_locked := style.width >= 0.0 || (own.min_width == own.max_width && own.max_width < f64(MAX_EXTENT))
    h_locked := style.height >= 0.0 || (own.min_height == own.max_height && own.max_height < f64(MAX_EXTENT))
    if w_locked && !h_locked {
        h = w / ar
    } else if h_locked && !w_locked {
        w = h * ar
    } else if !w_locked && !h_locked {
        if w > 0.0 { h = w / ar }
        else if h > 0.0 { w = h * ar }
        else if own.max_width < f64(MAX_EXTENT) {
            w = own.max_width
            h = w / ar
        }
    }
    w = math.max(own.min_width,math.min(own.max_width,w))
    h = math.max(own.min_height,math.min(own.max_height,h))
    << Size{width: math.max(0.0,w),height: math.max(0.0,h)}
}
fn (tree $&Tree) measure(index int,incoming &Constraints) Size {
    cached := tree.node_constraints(index)
    if !tree.nodes[index].layout_dirty && tree.nodes[index].measured && same_constraints(&cached,incoming) {
        tree.reused = tree.reused + 1
        << Size{width: tree.nodes[index].bounds_width,height: tree.nodes[index].bounds_height}
    }
    tree.measured = tree.measured + 1
    style := tree.node_style(index)
    $size := Size{width: 0.0,height: 0.0}
    if !style.hidden {
        $own := copy_constraints(incoming)
        own.min_width = math.max(own.min_width,math.min(own.max_width,style.min_width))
        if style.max_width >= 0.0 { own.max_width = math.max(own.min_width,math.min(own.max_width,style.max_width)) }
        own.min_height = math.max(own.min_height,math.min(own.max_height,style.min_height))
        if style.max_height >= 0.0 { own.max_height = math.max(own.min_height,math.min(own.max_height,style.max_height)) }
        if style.width >= 0.0 { width := math.max(own.min_width,math.min(own.max_width,style.width))
            own.min_width = width
            own.max_width = width }
        else if style.width_pct >= 0.0 && incoming.max_width < f64(MAX_EXTENT) {
            pw := math.max(own.min_width,math.min(own.max_width,incoming.max_width * style.width_pct))
            own.min_width = pw
            own.max_width = pw
        }
        if style.height >= 0.0 { height := math.max(own.min_height,math.min(own.max_height,style.height))
            own.min_height = height
            own.max_height = height }
        else if style.height_pct >= 0.0 && incoming.max_height < f64(MAX_EXTENT) {
            ph := math.max(own.min_height,math.min(own.max_height,incoming.max_height * style.height_pct))
            own.min_height = ph
            own.max_height = ph
        }
        inner := own.deflate(&style.padding) or >>
        base_child := inner.loosen() or >>
        ordered := tree.sorted_visible_children(index)
        $ids := []int{}
        $sizes := []Size{}
        $spans := []int{}
        $natural := Size{width: tree.nodes[index].intrinsic_width,height: tree.nodes[index].intrinsic_height}
        if style.kind == BOX_GRID {
            eff_cols := effective_grid_columns(inner.max_width,style.columns,style.gap,style.min_col_width)
            $eff_weights := []f64{}
            if style.col_weights.len == eff_cols { eff_weights = clone_floats(&style.col_weights) }
            has_bounded_w := inner.max_width < f64(MAX_EXTENT)
            $track_ws := []f64{}
            if has_bounded_w { track_ws = grid_track_widths(inner.max_width,eff_cols,&eff_weights,style.gap) }
            $align_selfs := []int{}
            $cur_col := 0
            for oi in 0:ordered.len {
                child := ordered[oi]
                $sp := tree.nodes[child].style_col_span
                if sp < 1 { sp = 1 }
                if sp > eff_cols { sp = eff_cols }
                if cur_col > 0 && cur_col + sp > eff_cols { cur_col = 0 }
                $c_align := tree.nodes[child].style_align_self
                if c_align < 0 { c_align = style.cross_alignment }
                $cc := copy_constraints(&base_child)
                $cell_w := inner.max_width
                if has_bounded_w {
                    $cw := style.gap * f64(sp - 1)
                    for k in cur_col:(cur_col + sp) { cw = cw + track_ws[k] }
                    cell_w = cw
                    cc.max_width = math.min(cc.max_width,cw)
                    if c_align == CROSS_STRETCH { cc.min_width = math.min(cc.max_width,cw) }
                }
                _ := tree.apply_child_pct_constraints(child,$&cc,cell_w,inner.max_height,true,true)
                measured := tree.measure(child,&cc) or >>
                ids.push(child)
                sizes.push(measured)
                spans.push(sp)
                align_selfs.push(tree.nodes[child].style_align_self)
                cur_col = cur_col + sp
            }
            positions := grid_weighted(&inner,&sizes,&spans,&align_selfs,eff_cols,&eff_weights,style.gap,style.run_gap,style.cross_alignment) or >>
            natural = Size{width: positions.size.width,height: positions.size.height}
            for i in 0:ids.len {
                r := positions.children[i]
                $ca := align_selfs[i]
                if ca < 0 { ca = style.cross_alignment }
                if ca == CROSS_STRETCH && (r.width != sizes[i].width || r.height != sizes[i].height) {
                    _ := tree.measure(ids[i],&Constraints{min_width: r.width,max_width: r.width,min_height: r.height,max_height: r.height}) or >>
                }
                tree.place(ids[i],style.padding.left + r.x,style.padding.top + r.y)
            }
        } else {
            for oi in 0:ordered.len {
                child := ordered[oi]
                $cc := copy_constraints(&base_child)
                $c_align := tree.nodes[child].style_align_self
                if c_align < 0 { c_align = style.cross_alignment }
                has_pct_w := tree.apply_child_pct_constraints(child,$&cc,inner.max_width,inner.max_height,true,true)
                if style.kind == BOX_ROW {
                    if !has_pct_w { cc.max_width = f64(MAX_EXTENT) }
                    if c_align == CROSS_STRETCH && inner.max_height < f64(MAX_EXTENT) && tree.nodes[child].style_height_pct < 0.0 { cc.min_height = inner.max_height }
                } else if style.kind == BOX_COLUMN {
                    if tree.nodes[child].style_height_pct < 0.0 { cc.max_height = f64(MAX_EXTENT) }
                    if c_align == CROSS_STRETCH && inner.max_width < f64(MAX_EXTENT) && tree.nodes[child].style_width_pct < 0.0 { cc.min_width = inner.max_width }
                }
                measured := tree.measure(child,&cc) or >>
                ids.push(child)
                sizes.push(measured)
                if style.kind == BOX_STACK || style.kind == BOX_PADDING {
                    natural.width = math.max(natural.width,measured.width)
                    natural.height = math.max(natural.height,measured.height)
                }
            }
            if style.kind == BOX_ROW || style.kind == BOX_COLUMN {
                is_col := style.kind == BOX_COLUMN
                $avail_main := inner.max_width
                if is_col { avail_main = inner.max_height }
                if ids.len > 0 && avail_main < f64(MAX_EXTENT) {
                    $total_grow := 0.0
                    $total_shrink := 0.0
                    $used_main := 0.0
                    if ids.len > 1 { used_main = style.gap * f64(ids.len - 1) }
                    for i in 0:ids.len {
                        cid := ids[i]
                        if is_col { used_main += sizes[i].height } else { used_main += sizes[i].width }
                        total_grow += tree.nodes[cid].style_flex_grow
                        total_shrink += tree.nodes[cid].style_flex_shrink
                    }
                    if used_main < avail_main && total_grow > 0.0 {
                        $targets := []f64{}
                        $frozen := []bool{}
                        for i in 0:ids.len {
                            cid := ids[i]
                            if is_col { targets.push(sizes[i].height) } else { targets.push(sizes[i].width) }
                            frozen.push(tree.nodes[cid].style_flex_grow <= 0.0)
                        }
                        $remaining := avail_main - used_main
                        for _pass in 0:ids.len {
                            if remaining <= 0.001 { <- }
                            $active_grow := 0.0
                            for i in 0:ids.len {
                                if !frozen[i] { active_grow += tree.nodes[ids[i]].style_flex_grow }
                            }
                            if active_grow <= 0.0 { <- }
                            $any_clamped := false
                            $next_remaining := remaining
                            for i in 0:ids.len {
                                if frozen[i] { -> }
                                cid := ids[i]
                                cand := targets[i] + remaining * (tree.nodes[cid].style_flex_grow / active_grow)
                                $mn := tree.nodes[cid].style_min_width
                                $mx := tree.nodes[cid].style_max_width
                                if is_col {
                                    mn = tree.nodes[cid].style_min_height
                                    mx = tree.nodes[cid].style_max_height
                                }
                                if (mx >= 0.0 && cand > mx) || cand < mn {
                                    $clamped := math.max(mn,cand)
                                    if mx >= 0.0 { clamped = math.min(mx,clamped) }
                                    delta := clamped - targets[i]
                                    targets[i] = clamped
                                    next_remaining -= delta
                                    frozen[i] = true
                                    any_clamped = true
                                }
                            }
                            if !any_clamped {
                                for i in 0:ids.len {
                                    if !frozen[i] {
                                        targets[i] = targets[i] + remaining * (tree.nodes[ids[i]].style_flex_grow / active_grow)
                                    }
                                }
                                remaining = 0.0
                                <-
                            }
                            remaining = math.max(0.0,next_remaining)
                        }
                        for i in 0:ids.len {
                            cid := ids[i]
                            if tree.nodes[cid].style_flex_grow > 0.0 {
                                target := targets[i]
                                $c_align := tree.nodes[cid].style_align_self
                                if c_align < 0 { c_align = style.cross_alignment }
                                $cc := copy_constraints(&base_child)
                                _ := tree.apply_child_pct_constraints(cid,$&cc,inner.max_width,inner.max_height,!is_col,is_col)
                                if !is_col {
                                    cc.min_width = target
                                    cc.max_width = target
                                    if c_align == CROSS_STRETCH && inner.max_height < f64(MAX_EXTENT) && tree.nodes[cid].style_height_pct < 0.0 { cc.min_height = inner.max_height }
                                } else {
                                    cc.min_height = target
                                    cc.max_height = target
                                    if c_align == CROSS_STRETCH && inner.max_width < f64(MAX_EXTENT) && tree.nodes[cid].style_width_pct < 0.0 { cc.min_width = inner.max_width }
                                }
                                sizes[i] = tree.measure(cid,&cc) or >>
                            }
                        }
                    } else if used_main > avail_main && total_shrink > 0.0 {
                        $targets := []f64{}
                        $frozen := []bool{}
                        for i in 0:ids.len {
                            cid := ids[i]
                            if is_col { targets.push(sizes[i].height) } else { targets.push(sizes[i].width) }
                            frozen.push(tree.nodes[cid].style_flex_shrink <= 0.0)
                        }
                        $remaining := used_main - avail_main
                        for _pass in 0:ids.len {
                            if remaining <= 0.001 { <- }
                            $active_shrink := 0.0
                            for i in 0:ids.len {
                                if !frozen[i] { active_shrink += tree.nodes[ids[i]].style_flex_shrink }
                            }
                            if active_shrink <= 0.0 { <- }
                            $any_clamped := false
                            $next_remaining := remaining
                            for i in 0:ids.len {
                                if frozen[i] { -> }
                                cid := ids[i]
                                cand := targets[i] - remaining * (tree.nodes[cid].style_flex_shrink / active_shrink)
                                $mn := tree.nodes[cid].style_min_width
                                if is_col { mn = tree.nodes[cid].style_min_height }
                                if cand < mn {
                                    clamped := math.min(targets[i],mn)
                                    delta := targets[i] - clamped
                                    targets[i] = clamped
                                    next_remaining -= delta
                                    frozen[i] = true
                                    any_clamped = true
                                }
                            }
                            if !any_clamped {
                                for i in 0:ids.len {
                                    if !frozen[i] {
                                        cid := ids[i]
                                        $mn := tree.nodes[cid].style_min_width
                                        if is_col { mn = tree.nodes[cid].style_min_height }
                                        targets[i] = math.max(mn,targets[i] - remaining * (tree.nodes[cid].style_flex_shrink / active_shrink))
                                    }
                                }
                                remaining = 0.0
                                <-
                            }
                            remaining = math.max(0.0,next_remaining)
                        }
                        for i in 0:ids.len {
                            cid := ids[i]
                            if tree.nodes[cid].style_flex_shrink > 0.0 {
                                target := targets[i]
                                $c_align := tree.nodes[cid].style_align_self
                                if c_align < 0 { c_align = style.cross_alignment }
                                $cc := copy_constraints(&base_child)
                                _ := tree.apply_child_pct_constraints(cid,$&cc,inner.max_width,inner.max_height,!is_col,is_col)
                                if !is_col {
                                    cc.min_width = target
                                    cc.max_width = target
                                    if c_align == CROSS_STRETCH && inner.max_height < f64(MAX_EXTENT) && tree.nodes[cid].style_height_pct < 0.0 { cc.min_height = inner.max_height }
                                } else {
                                    cc.min_height = target
                                    cc.max_height = target
                                    if c_align == CROSS_STRETCH && inner.max_width < f64(MAX_EXTENT) && tree.nodes[cid].style_width_pct < 0.0 { cc.min_width = inner.max_width }
                                }
                                sizes[i] = tree.measure(cid,&cc) or >>
                            }
                        }
                    }
                }
                $positions := Flow{size: Size{width: 0.0,height: 0.0},children: []Rect{},overflow_x: false,overflow_y: false}
                if !is_col { positions = row(&inner,&sizes,style.gap,style.main_alignment,style.cross_alignment) or >> }
                else { positions = column(&inner,&sizes,style.gap,style.main_alignment,style.cross_alignment) or >> }
                natural = Size{width: positions.size.width,height: positions.size.height}
                for i in 0:ids.len {
                    cid := ids[i]
                    $rx := positions.children[i].x
                    $ry := positions.children[i].y
                    self_a := tree.nodes[cid].style_align_self
                    if self_a >= 0 {
                        if !is_col {
                            avail_c := positions.size.height
                            ch := sizes[i].height
                            if self_a == CROSS_START { ry = 0.0 }
                            else if self_a == CROSS_END { ry = avail_c - ch }
                            else if self_a == CROSS_CENTER { ry = (avail_c - ch) * 0.5 }
                            else if self_a == CROSS_STRETCH {
                                ry = 0.0
                                if avail_c != ch {
                                    _ := tree.measure(cid,&Constraints{min_width: sizes[i].width,max_width: sizes[i].width,min_height: avail_c,max_height: avail_c}) or >>
                                }
                            }
                        } else {
                            avail_c := positions.size.width
                            cw := sizes[i].width
                            if self_a == CROSS_START { rx = 0.0 }
                            else if self_a == CROSS_END { rx = avail_c - cw }
                            else if self_a == CROSS_CENTER { rx = (avail_c - cw) * 0.5 }
                            else if self_a == CROSS_STRETCH {
                                rx = 0.0
                                if avail_c != cw {
                                    _ := tree.measure(cid,&Constraints{min_width: avail_c,max_width: avail_c,min_height: sizes[i].height,max_height: sizes[i].height}) or >>
                                }
                            }
                        }
                    }
                    tree.place(cid,style.padding.left + rx,style.padding.top + ry)
                }
            } else if style.kind == BOX_WRAP {
                $wrap_aligns := []int{}
                for i in 0:ids.len { wrap_aligns.push(tree.nodes[ids[i]].style_align_self) }
                positions := wrap_aligned(&inner,&sizes,&wrap_aligns,style.gap,style.run_gap,style.main_alignment,style.cross_alignment) or >>
                natural = Size{width: positions.size.width,height: positions.size.height}
                for i in 0:ids.len {
                    r := positions.children[i]
                    $ca := wrap_aligns[i]
                    if ca < 0 { ca = style.cross_alignment }
                    if ca == CROSS_STRETCH && (r.width != sizes[i].width || r.height != sizes[i].height) {
                        _ := tree.measure(ids[i],&Constraints{min_width: r.width,max_width: r.width,min_height: r.height,max_height: r.height}) or >>
                    }
                    tree.place(ids[i],style.padding.left + r.x,style.padding.top + r.y)
                }
            }
        }
        size = own.wrap_padding(&natural,&style.padding) or >>
        size = apply_box_aspect_ratio(&size,&own,&style)
        if style.kind == BOX_STACK || style.kind == BOX_PADDING {
            area := Rect{x: style.padding.left,y: style.padding.top,width: math.max(0.0,size.width - style.padding.left - style.padding.right),
                         height: math.max(0.0,size.height - style.padding.top - style.padding.bottom)}
            for i in 0:ids.len {
                cid := ids[i]
                $ax := tree.nodes[cid].style_stack_align_x
                $ay := tree.nodes[cid].style_stack_align_y
                if ax < -1.0 { ax = style.align_x }
                if ay < -1.0 { ay = style.align_y }
                position := align(&area,&sizes[i],ax,ay) or >>
                tree.place(cid,position.x,position.y)
            }
        }
    }
    if tree.nodes[index].bounds_width != size.width || tree.nodes[index].bounds_height != size.height { tree.paint_changed(index) }
    tree.nodes[index].bounds_width = size.width
    tree.nodes[index].bounds_height = size.height
    tree.nodes[index].constraints_min_width = incoming.min_width
    tree.nodes[index].constraints_max_width = incoming.max_width
    tree.nodes[index].constraints_min_height = incoming.min_height
    tree.nodes[index].constraints_max_height = incoming.max_height
    tree.nodes[index].measured = true
    tree.nodes[index].layout_dirty = false
    << size
}
pub fn (tree $&Tree) layout(constraints &Constraints) Size {
    constraints.validate() or >>
    if tree.root < 0 { >> errors.new("layout: tree has no root") }
    tree.measured = 0
    tree.reused = 0
    size := tree.measure(tree.root,constraints) or (err) {
        tree.nodes[tree.root].layout_dirty = true
        >> err
    }
    << size
}
pub fn (tree &Tree) bounds(id int) Rect {
    index := tree.index(id) or >>
    x := tree.nodes[index].bounds_x + tree.nodes[index].offset_x
    y := tree.nodes[index].bounds_y + tree.nodes[index].offset_y
    if !coordinate(x) || !coordinate(y) { >> errors.new("layout: positioned coordinate range exceeded") }
    << Rect{x: x,y: y,width: tree.nodes[index].bounds_width,height: tree.nodes[index].bounds_height}
}
pub fn (tree &Tree) visible(id int) bool {
    $index := tree.index(id) or >>
    while index >= 0 {
        if tree.nodes[index].style_hidden { << false }
        index = tree.nodes[index].parent
    }
    << true
}
pub fn (tree &Tree) global_bounds(id int) Rect {
    index := tree.index(id) or >>
    $result := tree.bounds(id) or >>
    $owner := tree.nodes[index].parent
    while owner >= 0 {
        result.x = result.x + tree.nodes[owner].bounds_x + tree.nodes[owner].offset_x - tree.nodes[owner].scroll_x
        result.y = result.y + tree.nodes[owner].bounds_y + tree.nodes[owner].offset_y - tree.nodes[owner].scroll_y
        owner = tree.nodes[owner].parent
    }
    if !coordinate(result.x) || !coordinate(result.y) { >> errors.new("layout: global coordinate range exceeded") }
    << result
}
fn (tree &Tree) hit(index int,x f64,y f64) int {
    if tree.nodes[index].style_hidden { << 0 }
    local := Rect{x: 0.0,y: 0.0,width: tree.nodes[index].bounds_width,height: tree.nodes[index].bounds_height}
    inside := local.contains(x,y)
    if tree.nodes[index].style_clip && !inside { << 0 }
    $child := tree.nodes[index].last
    while child >= 0 {
        found := tree.hit(child,x + tree.nodes[index].scroll_x - tree.nodes[child].bounds_x - tree.nodes[child].offset_x,y + tree.nodes[index].scroll_y - tree.nodes[child].bounds_y - tree.nodes[child].offset_y)
        if found != 0 { << found }
        child = tree.nodes[child].previous
    }
    if inside { << tree.nodes[index].id }
    << 0
}
pub fn (tree &Tree) hit_test(x f64,y f64) int {
    if tree.root < 0 || tree.needs_layout() || !tree.nodes[tree.root].measured || !coordinate(x) || !coordinate(y) {
        >> errors.new("layout: hit testing requires a current layout and finite coordinates")
    }
    << tree.hit(tree.root,x,y)
}
