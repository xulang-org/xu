@ui/layout

#errors
#math

pub const MAIN_START = 0
pub const MAIN_END = 1
pub const MAIN_CENTER = 2
pub const MAIN_SPACE_BETWEEN = 3
pub const MAIN_SPACE_AROUND = 4
pub const MAIN_SPACE_EVENLY = 5
pub const CROSS_START = 0
pub const CROSS_END = 1
pub const CROSS_CENTER = 2
pub const CROSS_STRETCH = 3
pub const MAX_CHILDREN = 4096

pub struct Flow {
    pub size Size
    pub children []Rect
    pub overflow_x bool
    pub overflow_y bool
}

// Position already-measured children. A control runtime measures children before
// this phase and uses these same local rectangles for painting and hit testing.
fn flow(parent &Constraints,children &[]Size,gap f64,main_alignment int,cross_alignment int,vertical bool) Flow {
    parent.validate() or >>
    if children.len > MAX_CHILDREN || !extent(gap) || main_alignment < MAIN_START || main_alignment > MAIN_SPACE_EVENLY ||
       cross_alignment < CROSS_START || cross_alignment > CROSS_STRETCH {
        >> errors.new("layout: invalid flow options")
    }
    mut natural_main := 0.0
    mut natural_cross := 0.0
    for child in children {
        if !extent(child.width) || !extent(child.height) { >> errors.new("layout: invalid child size") }
        mut main := child.width
        mut cross := child.height
        if vertical { main = child.height
            cross = child.width }
        natural_main = natural_main + main
        natural_cross = math.max(natural_cross,cross)
    }
    if children.len > 1 { natural_main = natural_main + gap * f64(children.len - 1) }
    if !extent(natural_main) { >> errors.new("layout: flow exceeds coordinate capacity") }
    mut natural := Size{width: natural_main,height: natural_cross}
    if vertical { natural = Size{width: natural_cross,height: natural_main} }
    size := parent.constrain(&natural) or >>
    mut available_main := size.width
    mut available_cross := size.height
    if vertical { available_main = size.height
        available_cross = size.width }
    free := math.max(0.0,available_main - natural_main)
    mut leading := 0.0
    mut spacing := gap
    if main_alignment == MAIN_END { leading = free }
    else if main_alignment == MAIN_CENTER { leading = free * 0.5 }
    else if main_alignment == MAIN_SPACE_BETWEEN && children.len > 1 { spacing = spacing + free / f64(children.len - 1) }
    else if main_alignment == MAIN_SPACE_AROUND && children.len > 0 { spacing = spacing + free / f64(children.len)
        leading = free / f64(children.len) * 0.5 }
    else if main_alignment == MAIN_SPACE_EVENLY && children.len > 0 { leading = free / f64(children.len + 1)
        spacing = spacing + leading }
    mut rectangles := []Rect{}
    mut position := leading
    for child in children {
        mut main := child.width
        mut cross := child.height
        if vertical { main = child.height
            cross = child.width }
        mut cross_position := 0.0
        if cross_alignment == CROSS_END { cross_position = available_cross - cross }
        else if cross_alignment == CROSS_CENTER { cross_position = (available_cross - cross) * 0.5 }
        else if cross_alignment == CROSS_STRETCH { cross = available_cross }
        mut rect := Rect{x: position,y: cross_position,width: main,height: cross}
        if vertical { rect = Rect{x: cross_position,y: position,width: cross,height: main} }
        rectangles.push(rect)
        position = position + main + spacing
    }
    << Flow{size: size,children: rectangles,overflow_x: natural.width > size.width,overflow_y: natural.height > size.height}
}

pub fn row(parent &Constraints,children &[]Size,gap f64,main_alignment int,cross_alignment int) Flow {
    << flow(parent,children,gap,main_alignment,cross_alignment,false) or >>
}
pub fn column(parent &Constraints,children &[]Size,gap f64,main_alignment int,cross_alignment int) Flow {
    << flow(parent,children,gap,main_alignment,cross_alignment,true) or >>
}

pub struct VisibleRange {
    pub start int
    pub end int
    pub offset f64
    pub content_extent f64
}
// Fixed-height/width viewport range, with a half-open index interval. The runtime
// builds only [start,end), preserving item keys outside the recycled view objects.
pub fn visible_range(count int,item_extent f64,gap f64,viewport f64,offset f64,overscan int) VisibleRange {
    if count < 0 || count > 1000000000 || !extent(item_extent) || item_extent == 0.0 || !extent(gap) || !extent(viewport) ||
       !coordinate(offset) || overscan < 0 || overscan > MAX_CHILDREN {
        >> errors.new("layout: invalid viewport")
    }
    stride := item_extent + gap
    mut content := 0.0
    if count > 0 { content = f64(count) * stride - gap }
    if !extent(content) { >> errors.new("layout: content exceeds coordinate capacity") }
    clamped := math.max(0.0,math.min(offset,math.max(0.0,content - viewport)))
    mut first := int(math.min(f64(count),math.floor(clamped / stride)))
    mut last := count
    if clamped + viewport < content { last = int(math.ceil((clamped + viewport) / stride)) }
    // A viewport starting in an inter-item gap does not include the preceding item.
    if first < count && f64(first) * stride + item_extent <= clamped { first = first + 1 }
    if viewport == 0.0 || count == 0 { << VisibleRange{start: first,end: first,offset: clamped,content_extent: content} }
    first = first - overscan
    last = last + overscan
    if first < 0 { first = 0 }
    if last > count { last = count }
    if first > last { first = last }
    if last - first > MAX_CHILDREN { >> errors.new("layout: visible child capacity exceeded") }
    << VisibleRange{start: first,end: last,offset: clamped,content_extent: content}
}
