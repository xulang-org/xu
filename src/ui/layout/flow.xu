@ui/layout

#errors
#math

pub const MAIN_START = 0
pub const MAIN_END = 1
pub const MAIN_CENTER = 2
pub const MAIN_SPACE_BETWEEN = 3
pub const MAIN_SPACE_AROUND = 4
pub const MAIN_SPACE_EVENLY = 5
pub const CROSS_START = 0
pub const CROSS_END = 1
pub const CROSS_CENTER = 2
pub const CROSS_STRETCH = 3
pub const MAX_CHILDREN = 4096

pub struct Flow {
    pub size Size
    pub children []Rect
    pub overflow_x bool
    pub overflow_y bool
}

// Position already-measured children. A control runtime measures children before
// this phase and uses these same local rectangles for painting and hit testing.
fn flow(parent &Constraints,children &[]Size,gap f64,main_alignment int,cross_alignment int,vertical bool) Flow {
    parent.validate() >>>
    if children.len > MAX_CHILDREN || !extent(gap) || main_alignment < MAIN_START || main_alignment > MAIN_SPACE_EVENLY ||
       cross_alignment < CROSS_START || cross_alignment > CROSS_STRETCH {
        >> errors.new("layout: invalid flow options")
    }
    $natural_main := 0.0
    $natural_cross := 0.0
    for child in children {
        if !extent(child.width) || !extent(child.height) { >> errors.new("layout: invalid child size") }
        $main := child.width
        $cross := child.height
        if vertical { main = child.height
            cross = child.width }
        natural_main = natural_main + main
        natural_cross = math.max(natural_cross,cross)
    }
    if children.len > 1 { natural_main = natural_main + gap * f64(children.len - 1) }
    if !extent(natural_main) { >> errors.new("layout: flow exceeds coordinate capacity") }
    $natural := Size{width: natural_main,height: natural_cross}
    if vertical { natural = Size{width: natural_cross,height: natural_main} }
    size := parent.constrain(&natural) >>>
    $available_main := size.width
    $available_cross := size.height
    if vertical { available_main = size.height
        available_cross = size.width }
    free := math.max(0.0,available_main - natural_main)
    $leading := 0.0
    $spacing := gap
    if main_alignment == MAIN_END { leading = free }
    else if main_alignment == MAIN_CENTER { leading = free * 0.5 }
    else if main_alignment == MAIN_SPACE_BETWEEN && children.len > 1 { spacing = spacing + free / f64(children.len - 1) }
    else if main_alignment == MAIN_SPACE_AROUND && children.len > 0 { spacing = spacing + free / f64(children.len)
        leading = free / f64(children.len) * 0.5 }
    else if main_alignment == MAIN_SPACE_EVENLY && children.len > 0 { leading = free / f64(children.len + 1)
        spacing = spacing + leading }
    $rectangles := []Rect{}
    $position := leading
    for child in children {
        $main := child.width
        $cross := child.height
        if vertical { main = child.height
            cross = child.width }
        $cross_position := 0.0
        if cross_alignment == CROSS_END { cross_position = available_cross - cross }
        else if cross_alignment == CROSS_CENTER { cross_position = (available_cross - cross) * 0.5 }
        else if cross_alignment == CROSS_STRETCH { cross = available_cross }
        $rect := Rect{x: position,y: cross_position,width: main,height: cross}
        if vertical { rect = Rect{x: cross_position,y: position,width: cross,height: main} }
        rectangles.push(rect)
        position = position + main + spacing
    }
    << Flow{size: size,children: rectangles,overflow_x: natural.width > size.width,overflow_y: natural.height > size.height}
}

pub fn row(parent &Constraints,children &[]Size,gap f64,main_alignment int,cross_alignment int) Flow {
    << flow(parent,children,gap,main_alignment,cross_alignment,false) >>>
}
pub fn column(parent &Constraints,children &[]Size,gap f64,main_alignment int,cross_alignment int) Flow {
    << flow(parent,children,gap,main_alignment,cross_alignment,true) >>>
}

pub fn wrap(parent &Constraints,children &[]Size,gap f64,run_gap f64,main_alignment int,cross_alignment int) Flow {
    << wrap_aligned(parent,children,&[]int{},gap,run_gap,main_alignment,cross_alignment) >>>
}

fn wrap_aligned(parent &Constraints,children &[]Size,align_selfs &[]int,gap f64,run_gap f64,main_alignment int,cross_alignment int) Flow {
    parent.validate() >>>
    if children.len > MAX_CHILDREN || !extent(gap) || !extent(run_gap) || main_alignment < MAIN_START || main_alignment > MAIN_SPACE_EVENLY ||
       cross_alignment < CROSS_START || cross_alignment > CROSS_STRETCH {
        >> errors.new("layout: invalid wrap options")
    }
    if children.len == 0 {
        zero := Size{width: 0.0,height: 0.0}
        << Flow{size: parent.constrain(&zero) >>>,children: []Rect{},overflow_x: false,overflow_y: false}
    }
    for child in children {
        if !extent(child.width) || !extent(child.height) { >> errors.new("layout: invalid child size") }
    }
    $run_starts := []int{}
    $run_ends := []int{}
    $run_widths := []f64{}
    $run_heights := []f64{}
    $cur_start := 0
    $cur_w := 0.0
    $cur_h := 0.0
    $natural_w := 0.0
    $natural_h := 0.0
    limit_w := parent.max_width
    for i in 0:children.len {
        cw := children[i].width
        ch := children[i].height
        $next_w := cw
        if i > cur_start { next_w = cur_w + gap + cw }
        if i > cur_start && limit_w < f64(MAX_EXTENT) && next_w > limit_w {
            run_starts.push(cur_start)
            run_ends.push(i)
            run_widths.push(cur_w)
            run_heights.push(cur_h)
            natural_w = math.max(natural_w,cur_w)
            natural_h = natural_h + cur_h
            cur_start = i
            cur_w = cw
            cur_h = ch
        } else {
            cur_w = next_w
            cur_h = math.max(cur_h,ch)
        }
    }
    run_starts.push(cur_start)
    run_ends.push(children.len)
    run_widths.push(cur_w)
    run_heights.push(cur_h)
    natural_w = math.max(natural_w,cur_w)
    natural_h = natural_h + cur_h
    if run_heights.len > 1 { natural_h = natural_h + run_gap * f64(run_heights.len - 1) }
    if !extent(natural_w) || !extent(natural_h) { >> errors.new("layout: wrap exceeds coordinate capacity") }
    natural := Size{width: natural_w,height: natural_h}
    size := parent.constrain(&natural) >>>
    $rectangles := []Rect{}
    $y := 0.0
    for r in 0:run_starts.len {
        start := run_starts[r]
        end := run_ends[r]
        count := end - start
        rw := run_widths[r]
        rh := run_heights[r]
        free := math.max(0.0,size.width - rw)
        $leading := 0.0
        $spacing := gap
        if main_alignment == MAIN_END { leading = free }
        else if main_alignment == MAIN_CENTER { leading = free * 0.5 }
        else if main_alignment == MAIN_SPACE_BETWEEN && count > 1 { spacing = spacing + free / f64(count - 1) }
        else if main_alignment == MAIN_SPACE_AROUND && count > 0 { spacing = spacing + free / f64(count)
            leading = free / f64(count) * 0.5 }
        else if main_alignment == MAIN_SPACE_EVENLY && count > 0 { leading = free / f64(count + 1)
            spacing = spacing + leading }
        $x := leading
        for i in start:end {
            cw := children[i].width
            $ch := children[i].height
            $cy := y
            $ca := cross_alignment
            if i < align_selfs.len && align_selfs[i] >= 0 { ca = align_selfs[i] }
            if ca == CROSS_END { cy = y + (rh - ch) }
            else if ca == CROSS_CENTER { cy = y + (rh - ch) * 0.5 }
            else if ca == CROSS_STRETCH { ch = rh }
            rectangles.push(Rect{x: x,y: cy,width: cw,height: ch})
            x = x + cw + spacing
        }
        y = y + rh + run_gap
    }
    << Flow{size: size,children: rectangles,overflow_x: natural.width > size.width,overflow_y: natural.height > size.height}
}

pub fn grid(parent &Constraints,children &[]Size,spans &[]int,columns int,col_gap f64,row_gap f64,cross_alignment int) Flow {
    << grid_weighted(parent,children,spans,&[]int{},columns,&[]f64{},col_gap,row_gap,cross_alignment) >>>
}

fn grid_aligned(parent &Constraints,children &[]Size,spans &[]int,align_selfs &[]int,columns int,col_gap f64,row_gap f64,cross_alignment int) Flow {
    << grid_weighted(parent,children,spans,align_selfs,columns,&[]f64{},col_gap,row_gap,cross_alignment) >>>
}

pub fn effective_grid_columns(avail_width f64,columns int,col_gap f64,min_col_width f64) int {
    $cols := columns
    if cols < 1 { cols = 1 }
    if cols > 256 { cols = 256 }
    if min_col_width <= 0.0 || avail_width >= f64(MAX_EXTENT) || math.is_nan(avail_width) || math.is_inf(avail_width) { << cols }
    denom := min_col_width + math.max(0.0,col_gap)
    $fit := 1
    if denom > 0.0 { fit = int(math.floor((avail_width + math.max(0.0,col_gap)) / denom)) }
    if fit < 1 { fit = 1 }
    if fit > 256 { fit = 256 }
    << fit
}

pub fn grid_track_widths(avail_width f64,columns int,col_weights &[]f64,col_gap f64) []f64 {
    $out := []f64{}
    if columns <= 0 { << out }
    $weights := []f64{}
    $total_w := 0.0
    for c in 0:columns {
        $w := 1.0
        if col_weights.len == columns { w = col_weights[c] }
        weights.push(w)
        total_w = total_w + w
    }
    track_space := math.max(0.0,avail_width - col_gap * f64(columns - 1))
    $unit := 0.0
    if total_w > 0.0 { unit = track_space / total_w }
    for c in 0:columns { out.push(unit * weights[c]) }
    << out
}

pub fn grid_weighted(parent &Constraints,children &[]Size,spans &[]int,align_selfs &[]int,columns int,col_weights &[]f64,col_gap f64,row_gap f64,cross_alignment int) Flow {
    << grid_aligned_weighted(parent,children,spans,align_selfs,columns,col_weights,col_gap,row_gap,MAIN_START,cross_alignment) >>>
}

pub fn grid_aligned_weighted(parent &Constraints,children &[]Size,spans &[]int,align_selfs &[]int,columns int,col_weights &[]f64,col_gap f64,row_gap f64,main_alignment int,cross_alignment int) Flow {
    << grid_full(parent,children,spans,align_selfs,&[]int{},columns,col_weights,col_gap,row_gap,main_alignment,cross_alignment) >>>
}

pub fn grid_full(parent &Constraints,children &[]Size,spans &[]int,align_selfs &[]int,justify_selfs &[]int,columns int,col_weights &[]f64,col_gap f64,row_gap f64,main_alignment int,cross_alignment int) Flow {
    parent.validate() >>>
    if children.len > MAX_CHILDREN || columns < 1 || columns > 256 || !extent(col_gap) || !extent(row_gap) ||
       main_alignment < MAIN_START || main_alignment > MAIN_SPACE_EVENLY ||
       cross_alignment < CROSS_START || cross_alignment > CROSS_STRETCH ||
       (col_weights.len != 0 && col_weights.len != columns) {
        >> errors.new("layout: invalid grid options")
    }
    $norm_weights := []f64{}
    $total_weight := 0.0
    if col_weights.len == columns {
        for w in col_weights {
            if math.is_nan(w) || math.is_inf(w) || w <= 0.0 || w > 10000.0 {
                >> errors.new("layout: invalid grid column weight")
            }
            norm_weights.push(w)
            total_weight = total_weight + w
        }
    } else {
        for _c in 0:columns {
            norm_weights.push(1.0)
            total_weight = total_weight + 1.0
        }
    }
    if children.len == 0 {
        zero := Size{width: 0.0,height: 0.0}
        << Flow{size: parent.constrain(&zero) >>>,children: []Rect{},overflow_x: false,overflow_y: false}
    }
    $norm_spans := []int{}
    for i in 0:children.len {
        if !extent(children[i].width) || !extent(children[i].height) { >> errors.new("layout: invalid child size") }
        $sp := 1
        if i < spans.len && spans[i] > 1 { sp = spans[i] }
        if sp > columns { sp = columns }
        norm_spans.push(sp)
    }
    $item_row := []int{}
    $item_col := []int{}
    $row_heights := []f64{}
    $cur_row := 0
    $cur_col := 0
    $cur_row_h := 0.0
    for i in 0:children.len {
        sp := norm_spans[i]
        if cur_col > 0 && cur_col + sp > columns {
            row_heights.push(cur_row_h)
            cur_row = cur_row + 1
            cur_col = 0
            cur_row_h = 0.0
        }
        item_row.push(cur_row)
        item_col.push(cur_col)
        cur_row_h = math.max(cur_row_h,children[i].height)
        cur_col = cur_col + sp
    }
    row_heights.push(cur_row_h)
    $row_y := []f64{}
    $acc_y := 0.0
    for r in 0:row_heights.len {
        row_y.push(acc_y)
        acc_y = acc_y + row_heights[r]
        if r + 1 < row_heights.len { acc_y = acc_y + row_gap }
    }
    $unit_w := 0.0
    if parent.max_width < f64(MAX_EXTENT) {
        track_space := math.max(0.0,parent.max_width - col_gap * f64(columns - 1))
        if total_weight > 0.0 { unit_w = track_space / total_weight }
    } else {
        for i in 0:children.len {
            c := item_col[i]
            sp := norm_spans[i]
            $span_wt := 0.0
            for k in c:(c + sp) { span_wt = span_wt + norm_weights[k] }
            if span_wt > 0.0 {
                cand_u := math.max(0.0,(children[i].width - col_gap * f64(sp - 1)) / span_wt)
                unit_w = math.max(unit_w,cand_u)
            }
        }
    }
    $col_widths := []f64{}
    $col_xs := []f64{}
    $acc_x := 0.0
    for c in 0:columns {
        cw := unit_w * norm_weights[c]
        col_widths.push(cw)
        col_xs.push(acc_x)
        acc_x = acc_x + cw + col_gap
    }
    $total_tracks_w := 0.0
    for c in 0:columns { total_tracks_w = total_tracks_w + col_widths[c] }
    natural_w := total_tracks_w + col_gap * f64(columns - 1)
    natural_h := acc_y
    if !extent(natural_w) || !extent(natural_h) { >> errors.new("layout: grid exceeds coordinate capacity") }
    natural := Size{width: natural_w,height: natural_h}
    size := parent.constrain(&natural) >>>
    $rectangles := []Rect{}
    for i in 0:children.len {
        r := item_row[i]
        c := item_col[i]
        sp := norm_spans[i]
        rh := row_heights[r]
        $cell_w := col_gap * f64(sp - 1)
        for k in c:(c + sp) { cell_w = cell_w + col_widths[k] }
        $x := col_xs[c]
        $w := math.min(cell_w,children[i].width)
        $h := children[i].height
        $y := row_y[r]
        $ca := cross_alignment
        if i < align_selfs.len && align_selfs[i] >= 0 { ca = align_selfs[i] }
        if ca == CROSS_END { y = row_y[r] + (rh - h) }
        else if ca == CROSS_CENTER { y = row_y[r] + (rh - h) * 0.5 }
        else if ca == CROSS_STRETCH {
            w = cell_w
            h = rh
        }
        $ja := main_alignment
        if i < justify_selfs.len && justify_selfs[i] >= 0 { ja = justify_selfs[i] }
        if ca != CROSS_STRETCH && w < cell_w {
            if ja == MAIN_CENTER { x = col_xs[c] + (cell_w - w) * 0.5 }
            else if ja == MAIN_END { x = col_xs[c] + (cell_w - w) }
        }
        rectangles.push(Rect{x: x,y: y,width: w,height: h})
    }
    << Flow{size: size,children: rectangles,overflow_x: natural.width > size.width,overflow_y: natural.height > size.height}
}

pub struct VisibleRange {
    pub start int
    pub end int
    pub offset f64
    pub content_extent f64
}
// Fixed-height/width viewport range, with a half-open index interval. The runtime
// builds only [start,end), preserving item keys outside the recycled view objects.
pub fn visible_range(count int,item_extent f64,gap f64,viewport f64,offset f64,overscan int) VisibleRange {
    if count < 0 || count > 1000000000 || !extent(item_extent) || item_extent == 0.0 || !extent(gap) || !extent(viewport) ||
       !coordinate(offset) || overscan < 0 || overscan > MAX_CHILDREN {
        >> errors.new("layout: invalid viewport")
    }
    stride := item_extent + gap
    $content := 0.0
    if count > 0 { content = f64(count) * stride - gap }
    if !extent(content) { >> errors.new("layout: content exceeds coordinate capacity") }
    clamped := math.max(0.0,math.min(offset,math.max(0.0,content - viewport)))
    $first := int(math.min(f64(count),math.floor(clamped / stride)))
    $last := count
    if clamped + viewport < content { last = int(math.ceil((clamped + viewport) / stride)) }
    // A viewport starting in an inter-item gap does not include the preceding item.
    if first < count && f64(first) * stride + item_extent <= clamped { first = first + 1 }
    if viewport == 0.0 || count == 0 { << VisibleRange{start: first,end: first,offset: clamped,content_extent: content} }
    first = first - overscan
    last = last + overscan
    if first < 0 { first = 0 }
    if last > count { last = count }
    if first > last { first = last }
    if last - first > MAX_CHILDREN { >> errors.new("layout: visible child capacity exceeded") }
    << VisibleRange{start: first,end: last,offset: clamped,content_extent: content}
}
