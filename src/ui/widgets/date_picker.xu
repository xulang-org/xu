@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors
#math

fn validate_picker_time(value time.Time) int {
    // Check epoch bounds before calendar decomposition, whose year walk is
    // intentionally simple and must never run on an unbounded input here.
    first := time.date(1,1,1,0,0,0,0)
    end := time.date(10000,1,1,0,0,0,0)
    if value.nsec < 0 || value.nsec >= time.second() || value.sec < first.sec || value.sec >= end.sec {
        >> errors.new("widgets: date/time value must be normalized, year 1..9999")
    }
    << 0
}
fn picker_day(value time.Time) time.Time { << time.date(value.year(),value.month(),value.day(),0,0,0,0) }
fn picker_pad(value int) string {
    if value < 10 { << "0" + str(value) }
    << str(value)
}
fn picker_date_text(value time.Time) string {
    mut year := str(value.year())
    while year.len < 4 { year = "0" + year }
    << year + "-" + picker_pad(value.month()) + "-" + picker_pad(value.day())
}
// A date field with an overlay calendar. Time and nanoseconds are preserved;
// dates are interpreted in UTC, matching time.Time's calendar accessors.
pub struct DatePicker {
    locale Locale
    control Button
    val time.Time
    has_value bool
    clearable bool
    today time.Time
    has_today bool
    cursor time.Time
    month time.Time
    minimum time.Time
    maximum time.Time
    open_state bool
    above bool
    hot int
    armed int
    cell_h f64
    popup_w f64
    gap f64
    labels TextCache
}
pub fn date_picker(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value time.Time) DatePicker {
    validate_picker_time(value) or >>
    if !context.matches_canvas(identity) { >> errors.new("widgets: date picker context mismatch") }
    control := button(identity,id,bounds) or >>
    labels := text_cache(context)
    << DatePicker{locale: locale_default(),control: control,val: value,has_value: true,clearable: false,today: value,has_today: false,cursor: value,month: time.date(value.year(),value.month(),1,0,0,0,0),
        minimum: time.date(1,1,1,0,0,0,0),maximum: time.date(9999,12,31,0,0,0,0),open_state: false,above: false,
        hot: -1,armed: -1,cell_h: 36.0,popup_w: 280.0,gap: 4.0,labels: labels}
}
pub fn (picker &DatePicker) id() int { << picker.control.id }
pub fn (picker &DatePicker) bounds() layout.Rect { << picker.control.bounds() }
pub fn (picker &DatePicker) value() time.Time { << picker.val }
pub fn (picker &DatePicker) is_open() bool { << picker.open_state }
pub fn (picker &DatePicker) needs_paint() bool { << picker.control.dirty }
pub fn (picker &DatePicker) visual_state() int { << picker.control.visual_state() }
pub fn (picker &DatePicker) style_or(styles &Styles) ControlStyle {
    if picker.control.has_style() { << picker.control.style_or(styles) }
    << styles.input.clone()
}
pub fn (picker &mut DatePicker) set_style(style &ControlStyle) int {
    control := mut &picker.control
    << control.set_style(style) or >>
}
pub fn (picker &mut DatePicker) set_enabled(enabled bool) {
    control := mut &picker.control
    control.set_enabled(enabled)
    if !enabled { picker.open_state = false }
}
pub fn (picker &mut DatePicker) set_read_only(read_only bool) int {
    if picker.control.closed { >> errors.new("widgets: date picker is disposed") }
    control := mut &picker.control
    control.set_read_only(read_only)
    if read_only { picker.open_state = false }
    << 0
}
pub fn (picker &mut DatePicker) set_invalid(invalid bool) {
    control := mut &picker.control
    control.set_invalid(invalid)
}
pub fn (picker &mut DatePicker) set_focus(focused bool) {
    control := mut &picker.control
    control.set_focus(focused)
    if !focused { picker.open_state = false
        picker.armed = -1 }
}
pub fn (picker &mut DatePicker) set_bounds(bounds &layout.Rect) int {
    old := picker.bounds()
    control := mut &picker.control
    control.set_bounds(bounds) or >>
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height { picker.armed = -1 }
    << 0
}
pub fn (picker &mut DatePicker) set_value(value time.Time) int {
    validate_picker_time(value) or >>
    day := picker_day(value)
    if day.sec < picker.minimum.sec || day.sec > picker.maximum.sec { >> errors.new("widgets: date outside range") }
    picker.val = value
    picker.has_value=true
    picker.armed = -1
    picker.hot = -1
    picker.cursor = value
    picker.month = time.date(value.year(),value.month(),1,0,0,0,0)
    picker.control.dirty = true
    << 0
}
pub fn (picker &mut DatePicker) set_range(minimum time.Time,maximum time.Time) int {
    validate_picker_time(minimum) or >>
    validate_picker_time(maximum) or >>
    lo := picker_day(minimum)
    hi := picker_day(maximum)
    if lo.sec > hi.sec { >> errors.new("widgets: reversed date range") }
    picker.minimum = lo
    picker.maximum = hi
    mut day := picker_day(picker.val)
    if day.sec < lo.sec { day = lo }
    if day.sec > hi.sec { day = hi }
    next := time.date(day.year(),day.month(),day.day(),picker.val.hour(),picker.val.minute(),picker.val.second(),picker.val.nsec)
    << picker.set_value(next) or >>
}
pub fn (picker &mut DatePicker) set_open(open bool) {
    picker.open_state = open && picker.control.is_enabled() && !picker.control.read_only
    picker.cursor = picker.val
    picker.month = time.date(picker.val.year(),picker.val.month(),1,0,0,0,0)
    picker.hot = -1
    picker.armed = -1
    picker.control.dirty = true
}
pub fn (picker &mut DatePicker) set_popup_above(above bool) {
    if picker.above != above { picker.above = above
        picker.armed = -1
        picker.hot = -1
        picker.control.dirty = true }
}
pub fn (picker &mut DatePicker) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := picker.style_or(styles)
    options := styles.text_options(&c)
    height := math.max(32.0 * styles.density,options.size * 1.5 + 10.0 * styles.density)
    mut width := 7.0 * math.max(height,options.size * 2.0) + 16.0 * styles.density
    for i in 0:7 { text := picker.locale.weekday(i) or >>
        cache := mut &picker.labels
        size := cache.measure(80+i,&text,styles,&c) or >>
        width = math.max(width,7.0 * (size.width + 12.0 * styles.density)) }
    title := picker.locale.calendar_title(picker.month) or >>
    cache := mut &picker.labels
    title_size := cache.measure(87,&title,styles,&c) or >>
    width = math.max(width,(title_size.width + 16.0 * styles.density) * 7.0 / 5.0)
    for key in [TEXT_TODAY,TEXT_CLEAR] { text := picker.locale.text(key) or >>
        labels := mut &picker.labels
        size := labels.measure(88+key,&text,styles,&c) or >>
        width = math.max(width,2.0 * (size.width + 20.0 * styles.density)) }
    gap := 4.0 * styles.density
    if height != picker.cell_h || width != picker.popup_w || gap != picker.gap {
        picker.cell_h = height
        picker.popup_w = width
        picker.gap = gap
        picker.hot = -1
        picker.armed = -1
        picker.control.dirty = true
    }
    << 0
}
pub fn (picker &DatePicker) popup_bounds() layout.Rect {
    b := picker.bounds()
    mut height := picker.cell_h * 8.0 + picker.gap * 4.0
    if picker.clearable || picker.has_today { height=height+picker.cell_h }
    mut y := b.y + b.height + picker.gap
    if picker.above { y = b.y - height - picker.gap }
    << layout.Rect{x: b.x,y: y,width: math.max(b.width,picker.popup_w),height: height}
}
// 0..41 follow the configured first weekday; 42/43 are previous/next month.
pub fn (picker &DatePicker) calendar_cell(index int) layout.Rect {
    if index < 0 || index > 45 { >> errors.new("widgets: calendar cell out of range") }
    p := picker.popup_bounds()
    pad := picker.gap * 2.0
    w := (p.width - pad * 2.0) / 7.0
    if index >= 44 {
        width := (p.width-pad*2.0)*0.5
        << layout.Rect{x:p.x+pad+f64(index-44)*width,y:p.y+pad+8.0*picker.cell_h,width:width,height:picker.cell_h}
    }
    if index >= 42 {
        mut x := p.x + pad
        if index == 43 { x = p.x + p.width - pad - w }
        << layout.Rect{x: x,y: p.y + pad,width: w,height: picker.cell_h}
    }
    << layout.Rect{x: p.x + pad + f64(index % 7) * w,y: p.y + pad + (2.0 + f64(index / 7)) * picker.cell_h,width: w,height: picker.cell_h}
}
pub fn (picker &DatePicker) calendar_date(index int) time.Time {
    if index < 0 || index >= 42 { >> errors.new("widgets: calendar date out of range") }
    start := (picker.month.weekday() - picker.locale.first_weekday() + 7) % 7
    << picker.month.add_date(0,0,index - start)
}
fn (picker &DatePicker) allowed(value time.Time) bool {
    << value.sec >= picker.minimum.sec && value.sec <= picker.maximum.sec
}
fn (picker &DatePicker) can_browse_month(delta int) bool {
    month := picker.month.add_date(0,delta,0)
    end := month.add_date(0,1,-1)
    << month.sec <= picker.maximum.sec && end.sec >= picker.minimum.sec
}
fn (picker &DatePicker) hit_calendar(x f64,y f64) int {
    mut count := 44
    if picker.clearable || picker.has_today { count=46 }
    for i in 0:count { cell := picker.calendar_cell(i) or >>
        if cell.contains(x,y) { << i } }
    << -1
}
fn (picker &mut DatePicker) move_cursor(value time.Time) {
    mut next := picker_day(value)
    if next.sec < picker.minimum.sec { next = picker.minimum }
    if next.sec > picker.maximum.sec { next = picker.maximum }
    picker.cursor = next
    picker.month = time.date(next.year(),next.month(),1,0,0,0,0)
    picker.control.dirty = true
}
fn (picker &mut DatePicker) commit_date(value time.Time) bool {
    next := time.date(value.year(),value.month(),value.day(),picker.val.hour(),picker.val.minute(),picker.val.second(),picker.val.nsec)
    changed := !picker.has_value || !next.equal(picker.val)
    picker.has_value=true
    picker.val = next
    picker.open_state = false
    picker.armed = -1
    picker.control.dirty = true
    << changed
}
pub fn (picker &mut DatePicker) input(event &ui.InputEvent) Action {
    if !belongs(&picker.control.identity,event) || !picker.control.is_enabled() { << no_action(picker.id(),false) }
    if event.kind == ui.EV_POINTER_CANCEL { picker.set_focus(false)
        << no_action(picker.id(),true) }
    if picker.control.read_only { control := mut &picker.control
        << control.input(event) }
    mut changed := false
    mut consumed := false
    if picker.open_state {
        hit := picker.hit_calendar(event.x,event.y) or >>
        if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT {
            if hit >= 0 { picker.armed = hit
                consumed = true }
            else if !picker.bounds().contains(event.x,event.y) { picker.set_open(false) }
        } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && picker.armed >= 0 {
            consumed = true
            if hit == picker.armed {
                if hit == 42 { if picker.can_browse_month(-1) { picker.move_cursor(picker.cursor.add_date(0,-1,0)) } }
                else if hit == 43 { if picker.can_browse_month(1) { picker.move_cursor(picker.cursor.add_date(0,1,0)) } }
                else if hit == 44 { if picker.has_today && picker.allowed(picker_day(picker.today)) { changed=picker.commit_date(picker.today) } }
                else if hit == 45 { if picker.clearable { changed=picker.has_value
                    picker.clear() or >> } }
                else { day := picker.calendar_date(hit) or >>
                    if picker.allowed(day) { changed = picker.commit_date(day) } }
            }
            picker.armed = -1
        } else if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_LEAVE {
            mut hot := hit
            if event.kind == ui.EV_POINTER_LEAVE { hot = -1 }
            if hot != picker.hot { picker.hot = hot
                picker.control.dirty = true }
        } else if event.kind == ui.EV_KEY_DOWN && picker.control.focused {
            consumed = true
            key := event.key
            if key == ui.KEY_ESCAPE { picker.set_open(false) }
            else if key == ui.KEY_ENTER || key == 32 { changed = picker.commit_date(picker.cursor) }
            else if key == ui.KEY_LEFT { picker.move_cursor(picker.cursor.add_date(0,0,-1)) }
            else if key == ui.KEY_RIGHT { picker.move_cursor(picker.cursor.add_date(0,0,1)) }
            else if key == ui.KEY_UP { picker.move_cursor(picker.cursor.add_date(0,0,-7)) }
            else if key == ui.KEY_DOWN { picker.move_cursor(picker.cursor.add_date(0,0,7)) }
            else if key == ui.KEY_PAGE_UP { mut delta := -1
                if (event.modifiers & ui.MOD_SHIFT)!=0 { delta = -12 }
                picker.move_cursor(picker.cursor.add_date(0,delta,0)) }
            else if key == ui.KEY_PAGE_DOWN { mut delta := 1
                if (event.modifiers & ui.MOD_SHIFT)!=0 { delta = 12 }
                picker.move_cursor(picker.cursor.add_date(0,delta,0)) }
            else if key == ui.KEY_HOME { picker.move_cursor(picker.cursor.add_date(0,0,-((picker.cursor.weekday() - picker.locale.first_weekday() + 7) % 7))) }
            else if key == ui.KEY_END { picker.move_cursor(picker.cursor.add_date(0,0,6 - ((picker.cursor.weekday() - picker.locale.first_weekday() + 7) % 7))) }
            else { consumed = false }
        }
    }
    if consumed {
        picker.control.dirty = true
        mut kind := ACTION_NONE
        if changed { kind = ACTION_CHANGE }
        << Action{kind: kind,id: picker.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(picker.val.unix())}
    }
    if !picker.open_state && event.kind == ui.EV_KEY_DOWN && picker.control.focused && (event.key == ui.KEY_DOWN || event.key == ui.KEY_ENTER || event.key == 32) {
        picker.set_open(true)
        << Action{kind: ACTION_ACTIVATE,id: picker.id(),needs_paint: true,request_focus: false,consumed: true,value: 0.0}
    }
    control := mut &picker.control
    action := control.input(event)
    if action.kind == ACTION_ACTIVATE { picker.set_open(!picker.open_state) }
    << action
}
pub fn (picker &mut DatePicker) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid date picker route") }
    if kind == ROUTE_FOCUS { picker.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { picker.set_focus(false)
        control := mut &picker.control
        control.cancel() }
    else { << picker.input(event) or >> }
    << no_action(picker.id(),picker.needs_paint())
}
pub fn (picker &mut DatePicker) measure_styled(styles &Styles) layout.Size {
    picker.apply_styles(styles) or >>
    c := picker.style_or(styles)
    mut text := picker.display_text() or >>
    if !picker.has_value { text=picker.locale.text(TEXT_DATE_PLACEHOLDER) or >> }
    labels := mut &picker.labels
    size := labels.measure(0,&text,styles,&c) or >>
    << layout.Size{width: math.max(190.0 * styles.density,size.width + (c.padding.left + c.padding.right + 32.0) * styles.density),height: math.max(c.min_height * styles.density,size.height + (c.padding.top + c.padding.bottom) * styles.density)}
}
pub fn (picker &mut DatePicker) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    picker.apply_styles(styles) or >>
    mut c := picker.style_or(styles)
    b := picker.bounds()
    state := picker.visual_state()
    style_box(frame,&b,&c,styles.density,state) or >>
    c.padding.right = c.padding.right + 24.0
    c.align_x = 0.0
    mut text := picker.display_text() or >>
    if !picker.has_value { text=picker.locale.text(TEXT_DATE_PLACEHOLDER) or >>
        c.palette.foreground=c.palette.muted }
    labels := mut &picker.labels
    labels.paint_text(0,&text,frame,&b,styles,&c,state) or >>
    ink := c.resolve(state).foreground
    x := b.x + b.width - 18.0 * styles.density
    y := b.y + b.height * 0.5
    frame.line(x - 4.0,y - 2.0,x,y + 2.0,ink,1.5) or >>
    frame.line(x,y + 2.0,x + 4.0,y - 2.0,ink,1.5) or >>
    picker.control.dirty = false
    << 0
}
pub fn (picker &mut DatePicker) paint_popup_styled(frame &mut draw.Frame,styles &Styles) int {
    if !picker.open_state { << 0 }
    picker.apply_styles(styles) or >>
    mut c := picker.style_or(styles)
    p := picker.popup_bounds()
    c.padding = layout.insets(0.0) or >>
    c.align_x = 0.5
    c.align_y = 0.5
    style_box(frame,&p,&c,styles.density,0) or >>
    for i in 0:51 {
        mut b := p
        mut text := ""
        mut state := 0
        if i == 0 {
            b.x = p.x + p.width / 7.0
            b.y = p.y + picker.gap * 2.0
            b.width = p.width * 5.0 / 7.0
            b.height = picker.cell_h
            text = picker.locale.calendar_title(picker.month) or >>
        } else if i < 8 {
            cell := picker.calendar_cell(i - 1) or >>
            b = cell
            b.y = cell.y - picker.cell_h
            text = picker.locale.weekday(i - 1) or >>
            state = STATE_DISABLED
        } else if i < 50 {
            index := i - 8
            b = picker.calendar_cell(index) or >>
            date := picker.calendar_date(index) or >>
            text = picker.locale.integer(date.day())
            if date.month() != picker.month.month() || !picker.allowed(date) { state = STATE_DISABLED }
            if picker.has_value && picker_day(picker.val).sec == date.sec { state = state | STATE_SELECTED }
            if picker_day(picker.cursor).sec == date.sec { state = state | STATE_FOCUSED }
            if picker.hot == index && picker.allowed(date) { state = state | STATE_HOVERED }
            if picker.armed == index { state = state | STATE_PRESSED }
        } else { -> }
        b.x = b.x + 2.0 * styles.density
        b.width = math.max(0.0,b.width - 4.0 * styles.density)
        label_index := i + 1
        mut cell_style := c.clone()
        if i >= 8 {
            cell_style.border_width = 0.0
            cell_style.palette.disabled = cell_style.palette.normal
            style_box(frame,&b,&cell_style,styles.density,state) or >>
        }
        labels := mut &picker.labels
        labels.paint_text(label_index,&text,frame,&b,styles,&cell_style,state) or >>
    }
    for i in 42:44 {
        b := picker.calendar_cell(i) or >>
        cx := b.x + b.width * 0.5
        cy := b.y + b.height * 0.5
        mut sign := -1.0
        if i == 43 { sign = 1.0 }
        mut ink := c.palette.foreground
        mut delta := -1
        if i == 43 { delta = 1 }
        if !picker.can_browse_month(delta) { ink = c.palette.muted }
        else if picker.hot == i {
            mut state := STATE_HOVERED
            if picker.armed == i { state = STATE_PRESSED }
            rounded_fill(frame,&b,4.0 * styles.density,c.resolve(state).background) or >>
        }
        frame.line(cx - sign * 2.0,cy - 5.0,cx + sign * 3.0,cy,ink,1.5) or >>
        frame.line(cx + sign * 3.0,cy,cx - sign * 2.0,cy + 5.0,ink,1.5) or >>
    }
    if picker.clearable || picker.has_today {
        for i in 44:46 { b := picker.calendar_cell(i) or >>
            mut text := picker.locale.text(TEXT_TODAY) or >>
            mut enabled := picker.has_today && picker.allowed(picker_day(picker.today))
            if i == 45 { text=picker.locale.text(TEXT_CLEAR) or >>
                enabled=picker.clearable && picker.has_value }
            mut state := 0
            if !enabled { state=STATE_DISABLED }
            else if picker.hot==i { state=STATE_HOVERED }
            labels := mut &picker.labels
            labels.paint_text(i+16,&text,frame,&b,styles,&c,state) or >> }
    }
    << 0
}
pub fn (picker &mut DatePicker) dispose() {
    labels := mut &picker.labels
    labels.dispose()
    picker.control.closed = true
    picker.open_state = false
}

pub fn (picker &DatePicker) has_value() bool { << picker.has_value }
pub fn (picker &mut DatePicker) set_clearable(enabled bool) { picker.clearable=enabled
    picker.control.dirty=true }
pub fn (picker &mut DatePicker) clear() int {
    if picker.control.closed { >> errors.new("widgets: date picker is disposed") }
    picker.has_value=false
    picker.open_state=false
    picker.armed=-1
    picker.control.dirty=true
    << 0
}
// The application supplies today in its intended timezone.
pub fn (picker &mut DatePicker) set_today(today time.Time) int {
    validate_picker_time(today) or >>
    picker.today=today
    picker.has_today=true
    picker.control.dirty=true
    << 0
}
