@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors

fn screen_place_button(item $&Button,bounds &layout.Rect) string {
    item.set_bounds(bounds) or (err) { << err.msg() }
    << ""
}
fn screen_input_button(item $&Button,kind int,event &ui.InputEvent) RefinedResult {
    $result := refined_result()
    result.action = item.route(kind,event) or (err) { << refined_failure(err.msg()) }
    << result
}
fn screen_paint_button(item &Button,motion $&PaintTransition,cache $&TextCache,frame $&draw.Frame,bounds &layout.Rect,
    styles &Styles,base &ControlStyle,text &string,opacity f64,now time.Instant,reduced bool) string {
    state := item.visual_state()
    c := motion.style(base,state,now,reduced) or (err) { << err.msg() }
    faded := c.with_opacity(opacity) or (err) { << err.msg() }
    style_box(frame,bounds,&faded,styles.density,state) or (err) { << err.msg() }
    cache.paint_text(0,text,frame,bounds,styles,&faded,state) or (err) { << err.msg() }
    << ""
}
fn screen_tick_button(item &Button,motion $&PaintTransition,base &ControlStyle,now time.Instant,reduced bool) RefinedResult {
    state := item.visual_state()
    before := motion.progress.value()
    _ := motion.style(base,state,now,reduced) or (err) { << refined_failure(err.msg()) }
    $result := refined_result()
    result.changed = motion.is_animating() || before != motion.progress.value()
    result.deadline = motion.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}
fn (s $&Screen) advance_buttons(now time.Instant) time.Instant {
    $deadline := time.zero_instant()
    bcount := s.composition.button_ids.len
    if bcount == 0 { << deadline }
    root_styles := s.styles.clone()
    reduced := s.reduced
    has_sub := s.composition.subtree_style_count > 0
    for i in 0:bcount {
        bid := s.composition.button_ids[i]
        if bid <= 0 || bid > s.nodes.len { -> }
        n := s.nodes[bid - 1]
        if n.kind != SCREEN_BUTTON || !s.is_visible(bid) { -> }
        item := s.take_button(bid)
        $motion := s.take_button_transition(bid)
        $b_idx := -1
        if has_sub { b_idx = s.style_index_for(bid) }
        $base := s.screen_button_style(bid,&item,&root_styles) or >>
        if b_idx >= 0 {
            sub := s.composition.subtree_style_values[b_idx].clone()
            base = s.screen_button_style(bid,&item,&sub) or >>
        }
        result := screen_tick_button(&item,$&motion,&base,now,reduced)
        s.buttons[bid] = item
        s.button_transitions[bid] = motion
        if result.error.len > 0 { >> errors.new(result.error) }
        if result.changed { s.mark_paint_dirty() }
        deadline = screen_earlier(deadline,result.deadline)
    }
    << deadline
}

fn (s $&Screen) take_button_transition(id int) PaintTransition {
    items := $&s.button_transitions
    << items.take(id)
}
