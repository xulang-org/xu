@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors

fn screen_place_button(item &mut Button,bounds &layout.Rect) string {
    item.set_bounds(bounds) or (err) { << err.msg() }
    << ""
}
fn screen_input_button(item &mut Button,kind int,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    result.action = item.route(kind,event) or (err) { << refined_failure(err.msg()) }
    << result
}
fn screen_paint_button(item &Button,motion &mut PaintTransition,cache &mut TextCache,frame &mut draw.Frame,bounds &layout.Rect,
    styles &Styles,base &ControlStyle,text &string,opacity f64,now time.Instant,reduced bool) string {
    state := item.visual_state()
    c := motion.style(base,state,now,reduced) or (err) { << err.msg() }
    faded := c.with_opacity(opacity) or (err) { << err.msg() }
    style_box(frame,bounds,&faded,styles.density,state) or (err) { << err.msg() }
    cache.paint_text(0,text,frame,bounds,styles,&faded,state) or (err) { << err.msg() }
    << ""
}
fn screen_tick_button(item &Button,motion &mut PaintTransition,base &ControlStyle,now time.Instant,reduced bool) RefinedResult {
    state := item.visual_state()
    before := motion.progress.value()
    _ := motion.style(base,state,now,reduced) or (err) { << refined_failure(err.msg()) }
    mut result := refined_result()
    result.changed = motion.is_animating() || before != motion.progress.value()
    result.deadline = motion.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}
fn (s &mut Screen) advance_buttons(now time.Instant) time.Instant {
    mut deadline := time.zero_instant()
    styles := s.styles.clone()
    reduced := s.reduced
    for n in s.nodes {
        if n.kind != SCREEN_BUTTON || !s.is_visible(n.id) { -> }
        item := s.take_button(n.id)
        mut motion := s.take_button_transition(n.id)
        base := s.screen_button_style(n.id,&item,&styles) or >>
        result := screen_tick_button(&item,mut &motion,&base,now,reduced)
        s.buttons[n.id] = item
        s.button_transitions[n.id] = motion
        if result.error.len > 0 { >> errors.new(result.error) }
        if result.changed { s.dirty = true }
        deadline = screen_earlier(deadline,result.deadline)
    }
    << deadline
}

fn (s &mut Screen) take_button_transition(id int) PaintTransition {
    items := mut &s.button_transitions
    << items.take(id)
}
