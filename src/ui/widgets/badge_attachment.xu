@ui/widgets
#ui/layout
#ui/draw
#math
#errors

pub const BADGE_STATUS = 0
pub const BADGE_COUNT = 1
pub const BADGE_DOT = 2
pub fn (badge &Badge) variant() int { << badge.variant }
pub fn (badge &mut Badge) set_variant(variant int) int {
    if variant < BADGE_STATUS || variant > BADGE_DOT { >> errors.new("widgets: invalid badge variant") }
    if badge.variant != variant { badge.variant = variant
        badge.dirty = true }
    << 0
}
fn (badge &Badge) variant_style(styles &Styles) ControlStyle {
    mut c := styles.badge_variant(badge.tone)
    if badge.custom.active { c = unpack_scalar_style(&badge.custom) }
    if badge.variant == BADGE_STATUS { << c }
    c.indicator_size = 0.0
    c.gap = 0.0
    if !badge.custom.active {
        color := badge_solid_color(styles,badge.tone)
        c.palette.normal = color
        c.palette.hovered = color
        c.palette.pressed = color
        c.palette.foreground = badge_contrast_ink(color)
        c.palette.border = color
        c.border_width = 0.0
        c.radius = 999.0
        c.inherit_font = false
        c.font = copy_font(&styles.font)
        c.font.size = 12.0
        c.font.weight = 600
        c.padding = layout.Insets{left: 6.0,top: 2.0,right: 6.0,bottom: 2.0}
        c.min_width = 20.0
        c.min_height = 20.0
        c.states = []StatePaint{}
    }
    if badge.variant == BADGE_DOT {
        c.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
        c.min_width = 8.0 * math.max(1.0,styles.text_scale * 0.75)
        c.min_height = c.min_width
        c.radius = 999.0
    }
    << c
}
fn badge_solid_color(styles &Styles,tone int) draw.Color {
    p := styles.button.palette
    if p.accent.value() == p.focus.value() && p.border.value() == p.foreground.value() { << p.accent }
    if tone == BADGE_INFO { << draw.rgb(40,111,174) }
    if tone == BADGE_SUCCESS { << draw.rgb(40,133,86) }
    if tone == BADGE_WARNING { << draw.rgb(156,111,25) }
    if tone == BADGE_ERROR { << styles.button.palette.invalid }
    << styles.button.palette.accent
}
fn badge_linear(value int) f64 {
    c := f64(value) / 255.0
    if c <= 0.04045 { << c / 12.92 }
    << math.pow_f64((c + 0.055) / 1.055,2.4)
}
fn badge_contrast_ink(color draw.Color) draw.Color {
    value := color.value()
    luma := badge_linear((value >> 24) & 255) * 0.2126 + badge_linear((value >> 16) & 255) * 0.7152 + badge_linear((value >> 8) & 255) * 0.0722
    if luma > 0.179 { << draw.rgb(0,0,0) }
    << draw.rgb(255,255,255)
}
struct BadgeAttachment { anchor int
    x f64
    y f64 }
struct BadgeSizeResult { size layout.Size
    error string }
// A passive adornment follows its anchor's bounds, scale, visibility and scroll.
pub fn (s &mut Screen) badge_on(anchor int,text string,variant int) int {
    node := s.node(anchor) or >>
    if node.kind >= SCREEN_POPOVER || node.kind == SCREEN_WEBVIEW || variant < BADGE_STATUS || variant > BADGE_DOT { >> errors.new("widgets: badge anchor must be a Canvas control") }
    id := s.badge(text) or >>
    s.set_badge_variant(id,variant) or >>
    s.set_badge_anchor(id,anchor,1.0,0.0) or >>
    << id
}
pub fn (s &mut Screen) set_badge_variant(id int,variant int) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_BADGE || variant < BADGE_STATUS || variant > BADGE_DOT { >> errors.new("widgets: invalid badge variant") }
    mut item := s.take_basic_badges(id)
    item.set_variant(variant) or (err) { s.basics.badges[id] = item.clone()
        >> err }
    s.basics.badges[id] = item
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_badge_anchor(id int,anchor int,x f64,y f64) int {
    node := s.node(id) or >>
    parent := s.node(anchor) or >>
    if node.kind != SCREEN_BADGE || anchor >= id || parent.kind >= SCREEN_POPOVER || parent.kind == SCREEN_WEBVIEW || !finite_metric(x,1.0) || !finite_metric(y,1.0) { >> errors.new("widgets: invalid badge attachment") }
    s.set_parent(id,anchor) or >>
    s.basics.badge_attachments[id] = BadgeAttachment{anchor: anchor,x: x,y: y}
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) badge_size(id int) layout.Size {
    node := s.node(id) or >>
    if node.kind != SCREEN_BADGE { >> errors.new("widgets: expected Badge") }
    styles := s.styles.clone()
    item := s.take_basic_badges(id)
    mut label := s.take_basic_label(id * 1024)
    result := screen_badge_size(&item,mut &label,&styles)
    s.basics.badges[id] = item
    s.basics.labels[id * 1024] = label
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.size
}
fn screen_badge_size(item &Badge,label &mut StyledLabel,styles &Styles) BadgeSizeResult {
    size := item.measure_styled(label,styles) or (err) { << BadgeSizeResult{size: layout.Size{width: 0.0,height: 0.0},error: err.msg()} }
    << BadgeSizeResult{size: size,error: ""}
}
fn (s &mut Screen) layout_badge_attachments() int {
    for node in s.nodes { if node.kind == SCREEN_BADGE && s.basics.badge_attachments.has(node.id) && s.is_visible(node.id) {
        owner := mut &s.basics
        items := mut &owner.badge_attachments
        record := items.take(node.id)
        anchor := record.anchor
        x := record.x
        y := record.y
        items[node.id] = record
        if node.parent != anchor { >> errors.new("widgets: use set_badge_anchor to reparent an attached badge") }
        size := s.badge_size(node.id) or >>
        parent := s.node(anchor) or >>
        s.nodes[node.id - 1].local = layout.Rect{x: parent.local.width * x - size.width * 0.5,
            y: parent.local.height * y - size.height * 0.5,width: size.width,height: size.height}
    } }
    << 0
}
