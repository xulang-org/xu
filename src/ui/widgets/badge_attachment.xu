@ui/widgets
#ui/layout
#ui/draw
#math
#errors

pub const BADGE_STATUS = 0
pub const BADGE_COUNT = 1
pub const BADGE_DOT = 2
pub fn (badge &Badge) variant() int { << badge.variant }
pub fn (badge $&Badge) set_variant(variant int) int {
    if variant < BADGE_STATUS || variant > BADGE_DOT { >> errors.new("widgets: invalid badge variant") }
    if badge.variant != variant { badge.variant = variant
        badge.dirty = true }
    << 0
}
fn (badge &Badge) variant_style(styles &Styles) ControlStyle {
    $c := styles.badge_variant(badge.tone)
    if badge.custom.active { c = unpack_scalar_style(&badge.custom) }
    if badge.variant == BADGE_STATUS { << c }
    c.indicator_size = 0.0
    c.gap = 0.0
    if !badge.custom.active {
        color := badge_solid_color(styles,badge.tone)
        c.palette.normal = color
        c.palette.hovered = color
        c.palette.pressed = color
        c.palette.foreground = badge_contrast_ink(color)
        c.palette.border = color
        c.border_width = 0.0
        c.radius = 999.0
        c.inherit_font = false
        c.font = copy_font(&styles.font)
        c.font.size = 12.0
        c.font.weight = 600
        c.padding = layout.Insets{left: 6.0,top: 2.0,right: 6.0,bottom: 2.0}
        c.min_width = 20.0
        c.min_height = 20.0
        c.states = []StatePaint{}
    }
    if badge.variant == BADGE_DOT {
        c.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
        c.min_width = 8.0 * math.max(1.0,styles.text_scale * 0.75)
        c.min_height = c.min_width
        c.radius = 999.0
    }
    << c
}
fn badge_solid_color(styles &Styles,tone int) draw.Color {
    p := styles.button.palette
    if p.accent.value() == p.focus.value() && p.border.value() == p.foreground.value() { << p.accent }
    dark := ((styles.background.value() >> 24) & 255) < 128
    if tone == BADGE_INFO {
        if dark { << draw.rgb(133,201,244) }
        << draw.rgb(27,100,143)
    }
    if tone == BADGE_SUCCESS {
        if dark { << draw.rgb(111,219,172) }
        << draw.rgb(20,103,71)
    }
    if tone == BADGE_WARNING {
        if dark { << draw.rgb(245,197,109) }
        << draw.rgb(133,80,8)
    }
    if tone == BADGE_ERROR { << styles.button.palette.invalid }
    << styles.button.palette.accent
}
fn badge_linear(value int) f64 {
    c := f64(value) / 255.0
    if c <= 0.04045 { << c / 12.92 }
    << math.pow_f64((c + 0.055) / 1.055,2.4)
}
fn badge_contrast_ink(color draw.Color) draw.Color {
    value := color.value()
    luma := badge_linear((value >> 24) & 255) * 0.2126 + badge_linear((value >> 16) & 255) * 0.7152 + badge_linear((value >> 8) & 255) * 0.0722
    if luma > 0.179 { << draw.rgb(0,0,0) }
    << draw.rgb(255,255,255)
}
struct BadgeAttachment { anchor int
    x f64
    y f64 }
struct BadgeSizeResult { size layout.Size
    error string }
// A passive adornment follows its anchor's bounds, scale, visibility and scroll.
pub fn (s $&Screen) badge_on(anchor int,text string,variant int) int {
    node := s.node(anchor) or >>
    if screen_is_overlay(node.kind) || node.kind == SCREEN_WEBVIEW || variant < BADGE_STATUS || variant > BADGE_DOT { >> errors.new("widgets: badge anchor must be a Canvas control") }
    id := s.badge(text) or >>
    s.set_badge_variant(id,variant) or >>
    s.set_badge_anchor(id,anchor,1.0,0.0) or >>
    << id
}
pub fn (s $&Screen) set_badge_variant(id int,variant int) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_BADGE || variant < BADGE_STATUS || variant > BADGE_DOT { >> errors.new("widgets: invalid badge variant") }
    $item := s.take_basic_badges(id)
    item.set_variant(variant) or (err) { s.basics.badges[id] = item.clone()
        >> err }
    s.basics.badges[id] = item
    s.mark_layout_dirty()
    << 0
}
pub fn (s $&Screen) set_badge_anchor(id int,anchor int,x f64,y f64) int {
    node := s.node(id) or >>
    parent := s.node(anchor) or >>
    if node.kind != SCREEN_BADGE || anchor >= id || screen_is_overlay(parent.kind) || parent.kind == SCREEN_WEBVIEW || !finite_metric(x,1.0) || !finite_metric(y,1.0) { >> errors.new("widgets: invalid badge attachment") }
    s.set_parent(id,anchor) or >>
    basic := $&s.basics
    att := $&basic.badge_attachments
    att[id] = BadgeAttachment{anchor: anchor,x: x,y: y}
    comp := $&s.composition
    vec_add_unique($&comp.attached_badge_ids,id)
    s.mark_layout_dirty()
    << 0
}
pub fn (s $&Screen) badge_size(id int) layout.Size {
    styles := s.styles_for(id)
    << s.badge_size_styled(id,&styles) or >>
}
fn (s $&Screen) badge_size_styled(id int,styles &Styles) layout.Size {
    node := s.node(id) or >>
    if node.kind != SCREEN_BADGE { >> errors.new("widgets: expected Badge") }
    item := s.take_basic_badges(id)
    $label := s.take_basic_label(id * 1024)
    result := screen_badge_size(&item,$&label,styles)
    s.basics.badges[id] = item
    s.basics.labels[id * 1024] = label
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.size
}
fn screen_badge_size(item &Badge,label $&StyledLabel,styles &Styles) BadgeSizeResult {
    size := item.measure_styled(label,styles) or (err) { << BadgeSizeResult{size: layout.Size{width: 0.0,height: 0.0},error: err.msg()} }
    << BadgeSizeResult{size: size,error: ""}
}
fn (s $&Screen) layout_badge_attachments() int {
    styles := s.styles.clone()
    << s.layout_badge_attachments_styled(&styles) or >>
}
fn (s $&Screen) layout_badge_attachments_styled(root_styles &Styles) int {
    count := s.composition.attached_badge_ids.len
    has_sub := s.composition.subtree_style_count > 0
    for i in 0:count {
        bid := s.composition.attached_badge_ids[i]
        if bid <= 0 || bid > s.nodes.len { -> }
        node := s.nodes[bid - 1]
        if node.kind != SCREEN_BADGE || !s.basics.badge_attachments.has(bid) || !s.is_visible(bid) { -> }
        anchor := s.basics.badge_attachments[bid].anchor
        ax := s.basics.badge_attachments[bid].x
        ay := s.basics.badge_attachments[bid].y
        if node.parent != anchor { >> errors.new("widgets: use set_badge_anchor to reparent an attached badge") }
        $size := layout.Size{width: 0.0,height: 0.0}
        if has_sub && s.style_index_for(bid) >= 0 {
            sc := s.styles_for(bid)
            size = s.badge_size_styled(bid,&sc) or >>
        } else {
            size = s.badge_size_styled(bid,root_styles) or >>
        }
        parent := s.node(anchor) or >>
        s.nodes[bid - 1].local = layout.Rect{x: parent.local.width * ax - size.width * 0.5,
            y: parent.local.height * ay - size.height * 0.5,width: size.width,height: size.height}
    }
    << 0
}
