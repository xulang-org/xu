@ui/widgets

#errors

pub const ACTION_REORDER = 26

pub struct ReorderRecord {
    pub container int
    pub item int
    pub from_index int
    pub to_index int
}

struct SortableConfig {
    axis int
    payload_type string
}

fn empty_reorder_record() ReorderRecord {
    << ReorderRecord{container: 0,item: 0,from_index: -1,to_index: -1}
}

fn copy_reorder_record(r &ReorderRecord) ReorderRecord {
    << ReorderRecord{container: r.container,item: r.item,from_index: r.from_index,to_index: r.to_index}
}

pub fn (s $&Screen) sync_sortable_children(container int) int {
    _ := s.node(container) >>>
    if !s.composition.sortables.has(container) { >> errors.new("widgets: container is not sortable") }
    sc_ref := &s.composition.sortables[container]
    ptype := sc_ref.payload_type + ""
    kids := s.children(container) >>>
    for cid in kids {
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && !s.is_floating_node(cid) {
            s.set_draggable(cid,ptype + "",str(cid)) >>>
            s.set_drag_follow(cid,true) >>>
        }
    }
    << 0
}

pub fn (s $&Screen) enable_sortable(container int,axis int,payload_type string) int {
    _ := s.node(container) >>>
    if axis != AXIS_VERTICAL && axis != AXIS_HORIZONTAL {
        >> errors.new("widgets: invalid sortable axis")
    }
    if !valid_token_name(&payload_type) {
        >> errors.new("widgets: invalid sortable payload type")
    }
    s.set_drop_zone(container,payload_type + "") >>>
    lt := layout_transition()
    s.set_children_layout_transition(container,&lt) >>>
    comp := $&s.composition
    st := $&comp.sortables
    had := st.has(container)
    st[container] = SortableConfig{axis: axis,payload_type: payload_type + ""}
    if !had { comp.sortable_count = comp.sortable_count + 1 }
    s.sync_sortable_children(container) >>>
    << 0
}

pub fn (s $&Screen) clear_sortable(container int) int {
    _ := s.node(container) >>>
    comp := $&s.composition
    if comp.sortables.has(container) {
        st := $&comp.sortables
        st.delete(container)
        if comp.sortable_count > 0 { comp.sortable_count = comp.sortable_count - 1 }
        s.clear_drop_zone(container) >>>
    }
    << 0
}

pub fn (s &Screen) is_sortable(container int) bool {
    _ := s.node(container) >>>
    << s.composition.sortable_count > 0 && s.composition.sortables.has(container)
}

pub fn (s &Screen) last_reorder() ReorderRecord {
    << copy_reorder_record(&s.composition.last_reorder_record)
}

pub fn (s &Screen) sortable_drop_index(container int,x f64,y f64) int {
    _ := s.node(container) >>>
    if !s.composition.sortables.has(container) { >> errors.new("widgets: container is not sortable") }
    sc_ref := &s.composition.sortables[container]
    axis := sc_ref.axis
    ordered := s.order_sorted_live_children(container)
    $active_src := 0
    if s.composition.drag_state.active { active_src = s.composition.drag_state.source }
    $coord := y
    if axis == AXIS_HORIZONTAL { coord = x }
    $idx := 0
    for i in 0:ordered.len {
        cid := ordered[i]
        if cid == active_src || !s.is_visible(cid) || s.is_floating_node(cid) { -> }
        b := s.nodes[cid - 1].bounds
        $mid := b.y + b.height * 0.5
        if axis == AXIS_HORIZONTAL { mid = b.x + b.width * 0.5 }
        if coord >= mid { idx += 1 }
    }
    << idx
}

fn (s $&Screen) sortable_handle_drop(dz int,src int,x f64,y f64,actions $&[]Action) {
    if s.composition.sortable_count == 0 || !s.composition.sortables.has(dz) { << }
    if src <= 0 || src > s.nodes.len || s.nodes[src - 1].kind < 0 { << }
    sc_ref := &s.composition.sortables[dz]
    ptype := sc_ref.payload_type + ""
    ordered := s.order_sorted_live_children(dz)
    $from_idx := -1
    for i in 0:ordered.len {
        if ordered[i] == src {
            from_idx = i
            <-
        }
    }
    to_idx := s.sortable_drop_index(dz,x,y) >>> (err) { << }
    if from_idx >= 0 {
        s.move_child(dz,src,to_idx) >>> (err) { << }
    } else {
        s.insert_child(dz,to_idx,src) >>> (err) { << }
        s.set_draggable(src,ptype,str(src)) >>> (err) { << }
        s.set_drag_follow(src,true) >>> (err) { << }
    }
    comp := $&s.composition
    comp.last_reorder_record = ReorderRecord{
        container: dz,
        item: src,
        from_index: from_idx,
        to_index: to_idx
    }
    actions.push(Action{
        kind: ACTION_REORDER,
        id: dz,
        needs_paint: true,
        request_focus: false,
        consumed: true,
        value: f64(to_idx)
    })
}

fn (s $&Screen) cleanup_sortable_for(id int) {
    comp := $&s.composition
    if comp.sortables.has(id) {
        st := $&comp.sortables
        st.delete(id)
        if comp.sortable_count > 0 { comp.sortable_count = comp.sortable_count - 1 }
    }
}
