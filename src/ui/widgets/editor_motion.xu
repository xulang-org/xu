@ui/widgets

#errors
#math
#time

fn (editor &mut Editor) restart_caret() {
    editor.caret_epoch = -1
    editor.caret_alpha = 1.0
    editor.dirty = true
}
pub fn (editor &Editor) caret_opacity() f64 { << editor.caret_alpha }
pub fn (editor &Editor) has_caret_animation() bool {
    << editor.focused && editor.enabled && !editor.closed && !editor.read_only && !editor.composing && editor.anchor == editor.focus
}
pub fn (editor &Editor) next_caret_tick(now time.Instant,reduced_motion bool) time.Instant {
    if reduced_motion || !editor.has_caret_animation() { << time.zero_instant() }
    ns := now.nanoseconds()
    if editor.caret_epoch < 0 || ns < editor.caret_epoch { << now }
    ms := time.millisecond()
    period := 1150 * ms
    if period <= 0 { >> errors.new("widgets: invalid caret period") }
    phase := (ns - editor.caret_epoch) % period
    if phase < 650 * ms { << now.add(time.duration(650 * ms - phase)) or >> }
    if phase < 750 * ms || phase >= 1050 * ms { << now.add(time.milliseconds(16) or >>) or >> }
    << now.add(time.duration(1050 * ms - phase)) or >>
}
// Call from the owning event loop. Only the short fade phases need new frames;
// editing/selection restarts a full visible interval and IME stays steady.
pub fn (editor &mut Editor) tick(now time.Instant,reduced_motion bool) bool {
    ns := now.nanoseconds()
    mut alpha := 0.0
    if editor.focused && editor.enabled && !editor.closed && !editor.read_only {
        if editor.composing || reduced_motion { alpha = 1.0 }
        else if editor.anchor == editor.focus {
            if editor.caret_epoch < 0 || ns < editor.caret_epoch { editor.caret_epoch = ns }
            ms := time.millisecond()
            period := 1150 * ms
            if period <= 0 { >> errors.new("widgets: invalid caret period") }
            phase := (ns - editor.caret_epoch) % period
            if phase < 650 * ms { alpha = 1.0 }
            else if phase < 750 * ms { alpha = 1.0 - f64(phase - 650 * ms) / f64(100 * ms) }
            else if phase >= 1050 * ms { alpha = f64(phase - 1050 * ms) / f64(100 * ms) }
            alpha = alpha * alpha * (3.0 - 2.0 * alpha)
        }
    }
    if math.abs(editor.caret_alpha - alpha) < 0.003 { << false }
    editor.caret_alpha = alpha
    editor.dirty = true
    << true
}
