@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

pub struct Tabs {
    id int
    identity ui.CanvasEvent
    bounds layout.Rect
    count_val int
    selected_val int
    segmented_val bool
    active_idx int
    automatic bool
    item_widths []f64
    layout_density f64
    layout_padding layout.Insets
    layout_gap f64
    hovered_idx int
    armed_idx int
    enabled bool
    focused bool
    hovered bool
    dirty bool
    closed bool
    invalid bool
    read_only bool
    custom ScalarControlStyle
}
pub fn tabs(identity &ui.CanvasEvent,id int,bounds &layout.Rect,count int,selected int) Tabs {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid control identity") }
    validate_bounds(bounds) or >>
    if count <= 0 || count > 64 || selected < 0 || selected >= count {
        >> errors.new("widgets: invalid tabs count or selection")
    }
    << Tabs{id: id,identity: copy_identity(identity),bounds: copy_rect(bounds),count_val: count,selected_val: selected,segmented_val: false,active_idx: selected,automatic: true,item_widths: []f64{},layout_density: 1.0,layout_padding: layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0},layout_gap: 0.0,
        hovered_idx: -1,armed_idx: -1,enabled: true,focused: false,hovered: false,dirty: true,closed: false,
        invalid: false,read_only: false,custom: empty_scalar_style()}
}
pub fn segmented(identity &ui.CanvasEvent,id int,bounds &layout.Rect,count int,selected int) Tabs {
    mut result := tabs(identity,id,bounds,count,selected) or >>
    result.segmented_val = true
    << result
}
pub fn (t &Tabs) id() int { << t.id }
pub fn (t &Tabs) bounds() layout.Rect { << copy_rect(&t.bounds) }
pub fn (t &Tabs) count() int { << t.count_val }
pub fn (t &Tabs) selected() int { << t.selected_val }
pub fn (t &Tabs) hovered_item() int { << t.hovered_idx }
pub fn (t &Tabs) needs_paint() bool { << t.dirty }
pub fn (t &mut Tabs) painted() { t.dirty = false }
pub fn (t &mut Tabs) invalidate() { t.dirty = true }
pub fn (t &mut Tabs) cancel() {
    if t.armed_idx >= 0 || t.hovered_idx >= 0 || t.hovered || t.focused { t.dirty = true }
    t.armed_idx = -1
    t.hovered_idx = -1
    t.hovered = false
    t.focused = false
}
pub fn (t &Tabs) is_enabled() bool { << t.enabled && !t.closed && t.bounds.width > 0.0 && t.bounds.height > 0.0 }
pub fn (t &mut Tabs) set_enabled(enabled bool) {
    if t.enabled != enabled { t.dirty = true }
    t.enabled = enabled
    if !enabled { t.cancel() }
}
pub fn (t &Tabs) is_focused() bool { << t.focused }
pub fn (t &mut Tabs) set_focus(focused bool) {
    next := focused && t.is_enabled()
    if t.focused != next { t.dirty = true }
    t.focused = next
    if !next && t.armed_idx >= 0 {
        t.armed_idx = -1
        t.dirty = true
    }
}
pub fn (t &Tabs) is_hovered() bool { << t.hovered }
pub fn (t &Tabs) is_invalid() bool { << t.invalid }
pub fn (t &mut Tabs) set_invalid(invalid bool) {
    if t.invalid != invalid {
        t.invalid = invalid
        t.dirty = true
    }
}
pub fn (t &Tabs) is_read_only() bool { << t.read_only }
pub fn (t &mut Tabs) set_read_only(read_only bool) {
    if t.read_only != read_only {
        t.read_only = read_only
        t.armed_idx = -1
        t.dirty = true
    }
}
pub fn (t &mut Tabs) set_count(count int) int {
    if count <= 0 || count > 64 { >> errors.new("widgets: invalid tabs count") }
    if t.count_val != count {
        t.count_val = count
        if t.selected_val >= count { t.selected_val = count - 1 }
        t.hovered_idx = -1
        t.armed_idx = -1
        t.dirty = true
    }
    << 0
}
pub fn (t &mut Tabs) set_selected(index int) int {
    if index < 0 || index >= t.count_val { >> errors.new("widgets: tab index out of range") }
    if t.selected_val != index {
        t.selected_val = index
        t.dirty = true
    }
    t.active_idx=index
    << 0
}
pub fn (t &mut Tabs) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if t.bounds.x != bounds.x || t.bounds.y != bounds.y || t.bounds.width != bounds.width || t.bounds.height != bounds.height {
        t.bounds = copy_rect(bounds)
        if bounds.width == 0.0 || bounds.height == 0.0 { t.cancel() }
        t.armed_idx = -1
        t.hovered_idx = -1
        t.hovered = false
        t.dirty = true
    }
    << 0
}
pub fn (t &Tabs) visual_state() int {
    mut state := 0
    if t.invalid { state = state | STATE_INVALID }
    if t.read_only { state = state | STATE_READ_ONLY }
    if !t.is_enabled() { state = state | STATE_DISABLED }
    if t.hovered { state = state | STATE_HOVERED }
    if t.focused { state = state | STATE_FOCUSED }
    << state
}
pub fn (t &Tabs) item_visual_state(index int) int {
    mut state := 0
    if t.invalid { state = state | STATE_INVALID }
    if t.read_only { state = state | STATE_READ_ONLY }
    if !t.is_enabled() { state = state | STATE_DISABLED }
    if index == t.selected_val { state = state | STATE_SELECTED }
    if t.focused && index==t.active_idx { state=state|STATE_FOCUSED }
    if index == t.hovered_idx { state = state | STATE_HOVERED }
    if !t.read_only && index == t.armed_idx && index == t.hovered_idx { state = state | STATE_PRESSED }
    << state
}
pub fn (t &Tabs) has_style() bool { << t.custom.active }
pub fn (t &Tabs) style_or(styles &Styles) ControlStyle {
    if t.custom.active { << unpack_scalar_style(&t.custom) }
    << styles.tabs_style()
}
pub fn (t &mut Tabs) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !t.custom.active || !control_equal(&unpack_scalar_style(&t.custom),&next) { t.dirty = true }
    t.custom = pack_scalar_style(style)
    << 0
}
pub fn (t &mut Tabs) clear_style() {
    if t.custom.active {
        t.custom.active = false
        t.dirty = true
    }
}
fn max_int(a int,b int) int {
    if a > b { << a }
    << b
}
fn min_int(a int,b int) int {
    if a < b { << a }
    << b
}

pub fn (t &Tabs) item_bounds(index int,styles &Styles) layout.Rect {
    c := t.style_or(styles)
    d := styles.density
    padding := layout.Insets{left: c.padding.left*d,top: c.padding.top*d,right: c.padding.right*d,bottom: c.padding.bottom*d}
    << t.item_rect(index,d,&padding,c.gap*d)
}
fn (t &Tabs) item_rect(index int,density f64,padding &layout.Insets,gap f64) layout.Rect {
    if index < 0 || index >= t.count_val { << screen_empty() }
    available := math.max(0.0,t.bounds.width - padding.left - padding.right - f64(t.count_val-1)*gap)
    mut fixed := 0.0
    mut automatic := t.count_val
    if t.item_widths.len == t.count_val { for width in t.item_widths { if width > 0.0 { fixed = fixed + width*density
        automatic -= 1 } } }
    automatic_width := math.max(0.0,(available-fixed)/f64(max_int(1,automatic)))
    mut x := t.bounds.x+padding.left
    mut width := automatic_width
    for i in 0:index+1 {
        width = automatic_width
        if t.item_widths.len == t.count_val && t.item_widths[i] > 0.0 { width = t.item_widths[i]*density }
        if i < index { x = x + width + gap }
    }
    << layout.Rect{x:x,y:t.bounds.y+padding.top,width:width,height:math.max(0.0,t.bounds.height-padding.top-padding.bottom)}
}
fn (t &Tabs) hit_item(x f64,y f64) int {
    if !t.bounds.contains(x,y) { << -1 }
    for i in 0:t.count_val { b := t.item_rect(i,t.layout_density,&t.layout_padding,t.layout_gap)
        if b.contains(x,y) { << i } }
    << -1
}
pub fn (t &mut Tabs) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := t.style_or(styles)
    d := styles.density
    t.layout_density=d
    t.layout_padding=layout.Insets{left:c.padding.left*d,top:c.padding.top*d,right:c.padding.right*d,bottom:c.padding.bottom*d}
    t.layout_gap=c.gap*d
    << 0
}
pub fn (t &mut Tabs) set_item_widths(widths &[]f64) int {
    if widths.len != 0 && widths.len != t.count_val { >> errors.new("widgets: expected one width per tab") }
    mut values := []f64{}
    for width in widths { if !finite_metric(width,4096.0) || (width > 0.0 && width < 24.0) { >> errors.new("widgets: invalid tab width") }
        values.push(width) }
    t.item_widths=values
    t.armed_idx=-1
    t.dirty=true
    << 0
}
pub fn (t &mut Tabs) set_automatic_activation(automatic bool) { t.automatic=automatic
    t.active_idx=t.selected_val
    t.dirty=true }
pub fn (t &mut Tabs) input(input &ui.InputEvent) Action {
    if !belongs(&t.identity,input) || t.closed { << no_action(t.id,t.dirty) }
    if input.kind == ui.EV_POINTER_CANCEL {
        t.cancel()
        << no_action(t.id,t.dirty)
    }
    if !t.is_enabled() { << no_action(t.id,t.dirty) }
    inside := t.bounds.contains(input.x,input.y)
    hit := t.hit_item(input.x,input.y)
    mut changed := false
    mut focus := false
    mut consumed := false
    if input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_LEAVE {
        hot := inside && input.kind != ui.EV_POINTER_LEAVE
        mut next_idx := -1
        if hot { next_idx = hit }
        if hot != t.hovered || next_idx != t.hovered_idx {
            t.hovered = hot
            t.hovered_idx = next_idx
            t.dirty = true
        }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && inside {
        t.hovered = true
        t.hovered_idx = hit
        t.dirty = true
        focus = true
        consumed = true
        if !t.read_only && hit >= 0 { t.armed_idx = hit }
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if t.armed_idx >= 0 {
            consumed = true
            if !t.read_only && inside && hit == t.armed_idx && hit != t.selected_val {
                t.selected_val = hit
                t.active_idx = hit
                changed = true
            }
            t.armed_idx = -1
            t.dirty = true
        }
        mut next_idx := -1
        if inside { next_idx = hit }
        if t.hovered != inside || t.hovered_idx != next_idx { t.dirty = true }
        t.hovered = inside
        t.hovered_idx = next_idx
    } else if input.kind == ui.EV_KEY_DOWN && t.focused && !t.read_only {
        mut candidate := t.active_idx
        mut handled := false
        if input.key == ui.KEY_LEFT || input.key == ui.KEY_UP {
            candidate = max_int(0,t.active_idx - 1)
            handled = true
        } else if input.key == ui.KEY_RIGHT || input.key == ui.KEY_DOWN {
            candidate = min_int(t.count_val - 1,t.active_idx + 1)
            handled = true
        } else if input.key == ui.KEY_HOME {
            candidate = 0
            handled = true
        } else if input.key == ui.KEY_END {
            candidate = t.count_val - 1
            handled = true
        }
        activate := t.automatic || input.key == ui.KEY_ENTER || input.key == 32
        if input.key == ui.KEY_ENTER || input.key == 32 { handled = true }
        if handled {
            consumed = true
            t.active_idx=candidate
            t.dirty=true
            if activate && candidate != t.selected_val {
                t.selected_val = candidate
                t.dirty = true
                changed = true
            }
        }
    }
    mut kind := ACTION_NONE
    if changed { kind = ACTION_CHANGE }
    << Action{kind: kind,id: t.id,needs_paint: t.dirty,request_focus: focus,consumed: consumed,value: f64(t.selected_val)}
}
pub fn (t &mut Tabs) event(event &ui.Event) Action {
    if event.window_id != t.identity.window_id { << no_action(t.id,t.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED {
        t.cancel()
        if event.kind == ui.EV_CLOSED { t.closed = true }
        << no_action(t.id,t.dirty)
    }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == t.identity.canvas_id && identity.generation == t.identity.generation {
            t.cancel()
            t.closed = true
        }
        << no_action(t.id,t.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(t.id,t.dirty) }
    input := ui.input_of(event) or >>
    << t.input(&input)
}
pub fn (t &Tabs) paint(frame &mut draw.Frame,labels &[]draw.TextLayout,theme &Theme) int {
    b := t.bounds
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    frame.fill_rect(b.x,b.y,b.width,b.height,theme.normal) or >>
    seg_w := b.width / f64(max_int(1,t.count_val))
    for i in 0:t.count_val {
        sx := b.x + f64(i) * seg_w
        if i == t.selected_val {
            frame.fill_rect(sx + 2.0,b.y + 2.0,math.max(0.0,seg_w - 4.0),math.max(0.0,b.height - 4.0),theme.accent) or >>
        } else if i == t.hovered_idx {
            frame.fill_rect(sx + 2.0,b.y + 2.0,math.max(0.0,seg_w - 4.0),math.max(0.0,b.height - 4.0),theme.hovered) or >>
        }
        if i < labels.len {
            lbl := labels[i]
            tx := sx + (seg_w - lbl.metrics.width) * 0.5
            ty := b.y + (b.height - lbl.metrics.height) * 0.5
            frame.text_layout(&lbl,tx,ty,theme.foreground) or >>
        }
    }
    if t.focused { focus_ring(frame,&b,theme.focus) or >> }
    frame.pop() or >>
    << 0
}
pub fn (t &Tabs) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := t.style_or(styles)
    d := styles.density
    sz := label.measure_styled(styles,&c) or >>
    item_w := math.max(36.0 * d,sz.width + 16.0 * d)
    item_h := math.max(18.0 * d,sz.height + 8.0 * d)
    gap := c.gap * d
    total_w := f64(t.count_val) * item_w + f64(max_int(0,t.count_val - 1)) * gap + (c.padding.left + c.padding.right) * d
    total_h := item_h + (c.padding.top + c.padding.bottom) * d
    << layout.Size{width: math.max(c.min_width * d,total_w),height: math.max(c.min_height * d,total_h)}
}
pub fn (t &Tabs) paint_box_styled(frame &mut draw.Frame,styles &Styles) int {
    c := t.style_or(styles)
    b := t.bounds
    d := styles.density
    mut box_state := t.visual_state()
    box_state = box_state & (0 - 1 - STATE_HOVERED)
    if t.segmented_val { << style_box(frame,&b,&c,d,box_state) or >> }
    frame.line(b.x,b.y + b.height - d,b.x + b.width,b.y + b.height - d,c.palette.border,d) or >>
    << 0
}
pub fn (t &Tabs) paint_tab_styled(frame &mut draw.Frame,index int,label &mut StyledLabel,styles &Styles) int {
    if index < 0 || index >= t.count_val { << 0 }
    c := t.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    d := styles.density
    seg := t.item_bounds(index,styles)
    seg_state := t.item_visual_state(index)
    resolved := c.resolve(seg_state)
    seg_radius := math.max(2.0,(c.radius - 2.0) * d)
    if t.segmented_val {
        if index == t.selected_val || index == t.hovered_idx || index == t.armed_idx { rounded_fill(frame,&seg,seg_radius,resolved.background) or >> }
        if t.focused && index==t.active_idx { rounded_stroke(frame,&seg,seg_radius,c.palette.focus,c.focus_width*d) or >> }
    } else {
        if index == t.hovered_idx || index == t.armed_idx { rounded_fill(frame,&seg,4.0 * d,c.palette.hovered) or >> }
        if index == t.selected_val {
            line := layout.Rect{x: seg.x + 8.0 * d,y: t.bounds.y + t.bounds.height - 3.0 * d,
                width: math.max(0.0,seg.width - 16.0 * d),height: 2.0 * d}
            rounded_fill(frame,&line,d,c.palette.accent) or >>
        }
        if t.focused && index == t.active_idx { rounded_stroke(frame,&seg,4.0 * d,c.palette.focus,c.focus_width * d) or >> }
    }
    shaped := label.layouts[0]
    tx := seg.x + (seg.width - shaped.metrics.width) * c.align_x
    ty := seg.y + (seg.height - shaped.metrics.height) * c.align_y
    mut ink := resolved.foreground
    if !t.segmented_val { ink = c.palette.foreground
        if index == t.selected_val { ink = c.palette.accent }
        if !t.enabled { ink = c.palette.muted } }
    frame.text_layout(&shaped,tx,ty,ink) or >>
    << 0
}
pub fn (t &Tabs) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    b := t.bounds
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    t.paint_box_styled(frame,styles) or >>
    for i in 0:t.count_val {
        t.paint_tab_styled(frame,i,label,styles) or >>
    }
    frame.pop() or >>
    << 0
}

pub struct Select {
    id int
    identity ui.CanvasEvent
    bounds layout.Rect
    count_val int
    selected_val int
    group_options int
    disabled_options int
    first_option int
    visible_options int
    open_state bool
    hovered_opt int
    armed_opt int
    popup_density f64
    popup_padding f64
    popup_above bool
    enabled bool
    focused bool
    hovered bool
    pointer_armed bool
    dirty bool
    closed bool
    invalid bool
    read_only bool
    custom ScalarControlStyle
}
pub fn select_box(identity &ui.CanvasEvent,id int,bounds &layout.Rect,count int,selected int) Select {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid control identity") }
    validate_bounds(bounds) or >>
    if count < 0 || count > 64 || (count==0 && selected!=-1) || (count>0 && (selected<0 || selected>=count)) {
        >> errors.new("widgets: invalid select count or selection")
    }
    << Select{id: id,identity: copy_identity(identity),bounds: copy_rect(bounds),count_val: count,selected_val: selected,group_options: 0,disabled_options: 0,first_option: 0,visible_options: 8,
        open_state: false,hovered_opt: -1,armed_opt: -1,popup_density: 1.0,popup_padding: 8.0,popup_above: false,
        enabled: true,focused: false,hovered: false,pointer_armed: false,
        dirty: true,closed: false,invalid: false,read_only: false,custom: empty_scalar_style()}
}
pub fn (sel &Select) id() int { << sel.id }
pub fn (sel &Select) bounds() layout.Rect { << copy_rect(&sel.bounds) }
pub fn (sel &Select) count() int { << sel.count_val }
pub fn (sel &Select) selected() int { << sel.selected_val }
pub fn (sel &Select) is_open() bool { << sel.open_state }
pub fn (sel &Select) hovered_option() int { << sel.hovered_opt }
pub fn (sel &Select) needs_paint() bool { << sel.dirty }
pub fn (sel &mut Select) painted() { sel.dirty = false }
pub fn (sel &mut Select) invalidate() { sel.dirty = true }
pub fn (sel &mut Select) cancel() {
    if sel.open_state || sel.pointer_armed || sel.hovered || sel.focused || sel.hovered_opt >= 0 || sel.armed_opt >= 0 { sel.dirty = true }
    sel.open_state = false
    sel.pointer_armed = false
    sel.hovered = false
    sel.focused = false
    sel.hovered_opt = -1
    sel.armed_opt = -1
}
pub fn (sel &Select) is_enabled() bool { << sel.enabled && !sel.closed && sel.count_val>0 && sel.bounds.width > 0.0 && sel.bounds.height > 0.0 }
pub fn (sel &mut Select) set_enabled(enabled bool) {
    if sel.enabled != enabled { sel.dirty = true }
    sel.enabled = enabled
    if !enabled { sel.cancel() }
}
pub fn (sel &Select) is_focused() bool { << sel.focused }
pub fn (sel &mut Select) set_focus(focused bool) {
    next := focused && sel.is_enabled()
    if sel.focused != next { sel.dirty = true }
    sel.focused = next
    if !next {
        if sel.open_state || sel.pointer_armed || sel.armed_opt >= 0 { sel.dirty = true }
        sel.open_state = false
        sel.pointer_armed = false
        sel.armed_opt = -1
        sel.hovered_opt = -1
    }
}
pub fn (sel &Select) is_hovered() bool { << sel.hovered }
pub fn (sel &Select) is_invalid() bool { << sel.invalid }
pub fn (sel &mut Select) set_invalid(invalid bool) {
    if sel.invalid != invalid {
        sel.invalid = invalid
        sel.dirty = true
    }
}
pub fn (sel &Select) is_read_only() bool { << sel.read_only }
pub fn (sel &mut Select) set_read_only(read_only bool) {
    if sel.read_only != read_only {
        sel.read_only = read_only
        sel.open_state = false
        sel.pointer_armed = false
        sel.armed_opt = -1
        sel.dirty = true
    }
}
pub fn (sel &mut Select) set_open(open bool) {
    next := open && sel.is_enabled() && !sel.read_only
    if sel.open_state != next {
        sel.open_state = next
        sel.hovered_opt = -1
        sel.armed_opt = -1
        sel.dirty = true
    }
}
pub fn (sel &mut Select) set_count(count int) int {
    if count < 0 || count > 64 { >> errors.new("widgets: invalid select count") }
    if sel.count_val != count {
        sel.count_val = count
        if count==0 { sel.selected_val=-1 }
        else if sel.selected_val<0 || sel.selected_val>=count { sel.selected_val=count-1 }
        sel.first_option=0
        sel.disabled_options=0
        sel.group_options=0
        sel.hovered_opt = -1
        sel.armed_opt = -1
        sel.dirty = true
    }
    << 0
}
pub fn (sel &mut Select) set_selected(index int) int {
    if (sel.count_val==0 && index!=-1) || (sel.count_val>0 && (index<0 || index>=sel.count_val)) { >> errors.new("widgets: select index out of range") }
    if sel.selected_val != index {
        sel.selected_val = index
        sel.dirty = true
    }
    sel.reveal_option()
    << 0
}
pub fn (sel &mut Select) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if sel.bounds.x != bounds.x || sel.bounds.y != bounds.y || sel.bounds.width != bounds.width || sel.bounds.height != bounds.height {
        sel.bounds = copy_rect(bounds)
        if bounds.width == 0.0 || bounds.height == 0.0 { sel.cancel() }
        sel.pointer_armed = false
        sel.hovered = false
        sel.dirty = true
    }
    << 0
}
pub fn (sel &Select) visual_state() int {
    mut state := 0
    if sel.invalid { state = state | STATE_INVALID }
    if sel.read_only { state = state | STATE_READ_ONLY }
    if !sel.is_enabled() { state = state | STATE_DISABLED }
    if sel.hovered || sel.open_state { state = state | STATE_HOVERED }
    if !sel.read_only && sel.pointer_armed && sel.hovered { state = state | STATE_PRESSED }
    if sel.focused { state = state | STATE_FOCUSED }
    << state
}
pub fn (sel &Select) has_style() bool { << sel.custom.active }
pub fn (sel &Select) style_or(styles &Styles) ControlStyle {
    if sel.custom.active { << unpack_scalar_style(&sel.custom) }
    << styles.select_style()
}
pub fn (sel &mut Select) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !sel.custom.active || !control_equal(&unpack_scalar_style(&sel.custom),&next) { sel.dirty = true }
    sel.custom = pack_scalar_style(style)
    << 0
}
pub fn (sel &mut Select) clear_style() {
    if sel.custom.active {
        sel.custom.active = false
        sel.dirty = true
    }
}
pub fn (sel &Select) popup_bounds(styles &Styles) layout.Rect {
    c := sel.style_or(styles)
    d := styles.density
    row_h := math.max(24.0 * d,sel.bounds.height)
    pad_y := (c.padding.top + c.padding.bottom) * 0.5 * d
    height := f64(min_int(sel.visible_options,sel.count_val)) * row_h + pad_y * 2.0
    mut y := sel.bounds.y + sel.bounds.height + 2.0 * d
    if sel.popup_above { y = sel.bounds.y - 2.0 * d - height }
    << layout.Rect{x: sel.bounds.x,y: y,width: sel.bounds.width,height: height}
}
pub fn (sel &mut Select) set_popup_above(above bool) {
    if sel.popup_above != above {
        sel.popup_above = above
        sel.hovered_opt = -1
        sel.armed_opt = -1
        sel.dirty = true
    }
}
// Keep the input geometry synchronized with popup_bounds/option_bounds.
pub fn (sel &mut Select) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := sel.style_or(styles)
    pad := (c.padding.top + c.padding.bottom) * 0.5 * styles.density
    if sel.popup_density != styles.density || sel.popup_padding != pad {
        sel.popup_density = styles.density
        sel.popup_padding = pad
        sel.hovered_opt = -1
        sel.armed_opt = -1
        sel.dirty = true
    }
    << 0
}
pub fn (sel &Select) option_bounds(index int,styles &Styles) layout.Rect {
    if index < 0 || index >= sel.count_val { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
    c := sel.style_or(styles)
    d := styles.density
    row_h := math.max(24.0 * d,sel.bounds.height)
    pad_y := (c.padding.top + c.padding.bottom) * 0.5 * d
    pop := sel.popup_bounds(styles)
    << layout.Rect{x: pop.x + 2.0 * d,y: pop.y + pad_y + f64(index - sel.first_option) * row_h,width: math.max(0.0,pop.width - 4.0 * d),height: row_h}
}
fn (sel &Select) popup_hit_bounds() layout.Rect {
    d := sel.popup_density
    row_h := math.max(24.0*d,sel.bounds.height)
    height := f64(min_int(sel.count_val,sel.visible_options))*row_h+sel.popup_padding*2.0
    mut y := sel.bounds.y+sel.bounds.height+2.0*d
    if sel.popup_above { y=sel.bounds.y-2.0*d-height }
    << layout.Rect{x:sel.bounds.x,y:y,width:sel.bounds.width,height:height}
}
fn (sel &Select) hit_popup_option(x f64,y f64) int {
    if !sel.open_state || sel.count_val<=0 { << -1 }
    popup := sel.popup_hit_bounds()
    rows_y := popup.y+sel.popup_padding
    row_h := math.max(24.0*sel.popup_density,sel.bounds.height)
    rows := layout.Rect{x:popup.x+2.0*sel.popup_density,y:rows_y,width:math.max(0.0,popup.width-4.0*sel.popup_density),height:f64(min_int(sel.count_val,sel.visible_options))*row_h}
    if !rows.contains(x,y) { << -1 }
    index := sel.first_option+int((y-rows_y)/row_h)
    if index<0 || index>=sel.count_val { << -1 }
    << index
}
pub fn (sel &mut Select) input(input &ui.InputEvent) Action {
    if !belongs(&sel.identity,input) || sel.closed { << no_action(sel.id,sel.dirty) }
    if input.kind == ui.EV_POINTER_CANCEL {
        sel.cancel()
        << no_action(sel.id,sel.dirty)
    }
    if !sel.is_enabled() { << no_action(sel.id,sel.dirty) }
    if input.kind==ui.EV_POINTER_SCROLL && sel.open_state && sel.popup_hit_bounds().contains(input.x,input.y) {
        mut step := 1
        if input.dy<0.0 { step=-1 }
        sel.first_option=max_int(0,min_int(max_int(0,sel.count_val-sel.visible_options),sel.first_option+step))
        sel.armed_opt=-1
        sel.dirty=true
        << Action{kind:ACTION_SCROLL,id:sel.id,needs_paint:true,request_focus:false,consumed:true,value:f64(sel.first_option)}
    }
    inside := sel.bounds.contains(input.x,input.y)
    opt_hit := sel.hit_popup_option(input.x,input.y)
    mut kind := ACTION_NONE
    mut focus := false
    mut consumed := false
    if input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_LEAVE {
        hot := inside && input.kind != ui.EV_POINTER_LEAVE
        mut next_opt := -1
        if input.kind != ui.EV_POINTER_LEAVE { next_opt = opt_hit }
        if hot != sel.hovered || next_opt != sel.hovered_opt {
            sel.hovered = hot
            sel.hovered_opt = next_opt
            sel.dirty = true
        }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if inside {
            sel.hovered = true
            sel.dirty = true
            focus = true
            consumed = true
            if !sel.read_only { sel.pointer_armed = true }
        } else if sel.open_state && opt_hit >= 0 {
            sel.hovered_opt = opt_hit
            sel.armed_opt = opt_hit
            sel.dirty = true
            focus = true
            consumed = true
        } else if sel.open_state {
            sel.open_state = false
            sel.hovered_opt = -1
            sel.armed_opt = -1
            sel.dirty = true
        }
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if sel.pointer_armed {
            consumed = true
            sel.pointer_armed = false
            sel.dirty = true
            if !sel.read_only && inside {
                sel.open_state = !sel.open_state
                if sel.open_state { sel.reveal_option() }
                kind = ACTION_ACTIVATE
            }
        } else if sel.armed_opt >= 0 {
            consumed = true
            if !sel.read_only && opt_hit == sel.armed_opt && sel.option_available(opt_hit) {
                if sel.selected_val != opt_hit {
                    sel.selected_val = opt_hit
                }
                kind = ACTION_CHANGE
                sel.open_state = false
            }
            sel.armed_opt = -1
            sel.hovered_opt = -1
            sel.dirty = true
        }
        if sel.hovered != inside { sel.dirty = true }
        sel.hovered = inside
    } else if input.kind == ui.EV_KEY_DOWN && sel.focused && !sel.read_only {
        if input.key == ui.KEY_ESCAPE && sel.open_state {
            sel.open_state = false
            sel.hovered_opt = -1
            sel.dirty = true
            consumed = true
        } else if input.key == ui.KEY_ENTER || input.key == 32 {
            sel.open_state = !sel.open_state
            if sel.open_state { sel.reveal_option() }
            sel.dirty = true
            consumed = true
            kind = ACTION_ACTIVATE
        } else if input.key == ui.KEY_DOWN || input.key == ui.KEY_RIGHT {
            next := sel.next_available(sel.selected_val + 1,1)
            consumed = true
            if next != sel.selected_val {
                sel.selected_val = next
                sel.dirty = true
                kind = ACTION_CHANGE
            }
        } else if input.key == ui.KEY_UP || input.key == ui.KEY_LEFT {
            next := sel.next_available(sel.selected_val - 1,-1)
            consumed = true
            if next != sel.selected_val {
                sel.selected_val = next
                sel.dirty = true
                kind = ACTION_CHANGE
            }
        } else if input.key == ui.KEY_HOME {
            consumed = true
            first := sel.next_available(0,1)
            if sel.selected_val != first {
                sel.selected_val = first
                sel.dirty = true
                kind = ACTION_CHANGE
            }
        } else if input.key == ui.KEY_END {
            last := sel.next_available(sel.count_val - 1,-1)
            consumed = true
            if sel.selected_val != last {
                sel.selected_val = last
                sel.dirty = true
                kind = ACTION_CHANGE
            }
        }
    }
    if input.kind==ui.EV_KEY_DOWN { sel.reveal_option() }
    << Action{kind: kind,id: sel.id,needs_paint: sel.dirty,request_focus: focus,consumed: consumed,value: f64(sel.selected_val)}
}
pub fn (sel &mut Select) event(event &ui.Event) Action {
    if event.window_id != sel.identity.window_id { << no_action(sel.id,sel.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED {
        sel.cancel()
        if event.kind == ui.EV_CLOSED { sel.closed = true }
        << no_action(sel.id,sel.dirty)
    }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == sel.identity.canvas_id && identity.generation == sel.identity.generation {
            sel.cancel()
            sel.closed = true
        }
        << no_action(sel.id,sel.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(sel.id,sel.dirty) }
    input := ui.input_of(event) or >>
    << sel.input(&input)
}
pub fn (sel &Select) paint(frame &mut draw.Frame,labels &[]draw.TextLayout,theme &Theme) int {
    b := sel.bounds
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    mut fill := theme.normal
    if !sel.is_enabled() { fill = theme.disabled }
    else if sel.hovered || sel.open_state { fill = theme.hovered }
    frame.fill_rect(b.x,b.y,b.width,b.height,fill) or >>
    if sel.selected_val >= 0 && sel.selected_val < labels.len {
        lbl := labels[sel.selected_val]
        frame.text_layout(&lbl,b.x + 10.0,b.y + (b.height - lbl.metrics.height) * 0.5,theme.foreground) or >>
    }
    cx := b.x + b.width - 16.0
    cy := b.y + b.height * 0.5
    frame.line(cx - 4.0,cy - 2.0,cx,cy + 2.0,theme.foreground,2.0) or >>
    frame.line(cx,cy + 2.0,cx + 4.0,cy - 2.0,theme.foreground,2.0) or >>
    if sel.focused { focus_ring(frame,&b,theme.focus) or >> }
    frame.pop() or >>
    << 0
}
pub fn (sel &Select) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := sel.style_or(styles)
    d := styles.density
    sz := label.measure_styled(styles,&c) or >>
    max_w := math.max(48.0 * d,sz.width)
    max_h := math.max(18.0 * d,sz.height)
    arrow := c.indicator_size * d
    gap := c.gap * d
    w := max_w + gap + arrow + (c.padding.left + c.padding.right) * d
    h := math.max(max_h,arrow) + (c.padding.top + c.padding.bottom) * d
    << layout.Size{width: math.max(c.min_width * d,w),height: math.max(c.min_height * d,h)}
}
pub fn (sel &Select) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    c := sel.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    b := sel.bounds
    d := styles.density
    state := sel.visual_state()
    resolved := c.resolve(state)
    style_box(frame,&b,&c,d,state) or >>
    left := c.padding.left * d
    top := c.padding.top * d
    right := c.padding.right * d
    arrow := math.max(6.0,c.indicator_size * d)
    avail_w := math.max(0.0,b.width - left - right - arrow - c.gap * d)
    avail_h := math.max(0.0,b.height - top - c.padding.bottom * d)
    if label.value.len > 0 {
        shaped := label.layouts[0]
        frame.push() or >>
        frame.clip_rect(b.x + left,b.y + top,avail_w,avail_h) or >>
        tx := b.x + left + (avail_w - shaped.metrics.width) * c.align_x
        ty := b.y + top + (avail_h - shaped.metrics.height) * c.align_y
        frame.text_layout(&shaped,tx,ty,resolved.foreground) or >>
        frame.pop() or >>
    }
    cx := b.x + b.width - right - arrow * 0.5
    cy := b.y + b.height * 0.5
    half := arrow * 0.35
    stroke_w := math.max(1.5,c.mark_width * d)
    if sel.open_state {
        frame.line(cx - half,cy + half * 0.5,cx,cy - half * 0.5,resolved.foreground,stroke_w) or >>
        frame.line(cx,cy - half * 0.5,cx + half,cy + half * 0.5,resolved.foreground,stroke_w) or >>
    } else {
        frame.line(cx - half,cy - half * 0.5,cx,cy + half * 0.5,resolved.foreground,stroke_w) or >>
        frame.line(cx,cy + half * 0.5,cx + half,cy - half * 0.5,resolved.foreground,stroke_w) or >>
    }
    << 0
}
pub fn (sel &Select) paint_popup_box_styled(frame &mut draw.Frame,styles &Styles) int {
    if !sel.open_state { << 0 }
    c := sel.style_or(styles)
    d := styles.density
    pop := sel.popup_bounds(styles)
    mut pop_style := c.clone()
    pop_style.focus_width = 0.0
    style_box(frame,&pop,&pop_style,d,0) or >>
    << 0
}
pub fn (sel &Select) paint_option_styled(frame &mut draw.Frame,index int,label &mut StyledLabel,styles &Styles) int {
    if !sel.open_state || index<sel.first_option || index>=min_int(sel.count_val,sel.first_option+sel.visible_options) { << 0 }
    mut c := sel.style_or(styles)
    if sel.is_group(index) { c.inherit_font = false
        c.font = copy_font(&styles.font)
        c.font.weight = 600 }
    _ := label.measure_styled(styles,&c) or >>
    d := styles.density
    left := c.padding.left * d
    shaped := label.layouts[0]
    row := sel.option_bounds(index,styles)
    mut row_state := 0
    if !sel.option_available(index) { row_state=row_state|STATE_DISABLED }
    if index == sel.selected_val { row_state = row_state | STATE_SELECTED }
    if index == sel.hovered_opt { row_state = row_state | STATE_HOVERED }
    resolved := c.resolve(row_state)
    if row_state != 0 {
        rounded_fill(frame,&row,math.max(2.0,(c.radius - 2.0) * d),resolved.background) or >>
    }
    frame.push() or >>
    frame.clip_rect(row.x,row.y,math.max(0.0,row.width-24.0*d),row.height) or >>
    if label.value.len > 0 {
        ty := row.y + (row.height - shaped.metrics.height) * 0.5
        frame.text_layout(&shaped,row.x + left,ty,resolved.foreground) or >>
    }
    frame.pop() or >>
    if index==sel.selected_val { x := row.x+row.width-14.0*d
        y := row.y+row.height*0.5
        frame.line(x-4.0*d,y,x-1.0*d,y+3.0*d,resolved.foreground,1.5*d) or >>
        frame.line(x-1.0*d,y+3.0*d,x+5.0*d,y-4.0*d,resolved.foreground,1.5*d) or >> }
    << 0
}
pub fn (sel &Select) paint_popup_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    sel.paint_popup_box_styled(frame,styles) or >>
    for i in 0:sel.count_val { sel.paint_option_styled(frame,i,label,styles) or >> }
    << 0
}

fn (sel &Select) option_available(index int) bool { << index>=0 && index<sel.count_val && ((sel.disabled_options|sel.group_options)&(1<<index))==0 }
fn (sel &Select) next_available(start int,delta int) int {
    mut index := start
    while index>=0 && index<sel.count_val { if sel.option_available(index) { << index }
        index+=delta }
    << sel.selected_val
}
fn (sel &mut Select) reveal_option() {
    if sel.selected_val<sel.first_option { sel.first_option=sel.selected_val }
    if sel.selected_val>=sel.first_option+sel.visible_options { sel.first_option=sel.selected_val-sel.visible_options+1 }
    sel.first_option=max_int(0,min_int(max_int(0,sel.count_val-sel.visible_options),sel.first_option))
}
pub fn (sel &mut Select) set_option_enabled(index int,enabled bool) int {
    if index<0 || index>=sel.count_val { >> errors.new("widgets: select option out of range") }
    bit := 1<<index
    if enabled { sel.disabled_options=sel.disabled_options&(0-1-bit) }
    else { sel.disabled_options=sel.disabled_options|bit }
    sel.armed_opt=-1
    sel.dirty=true
    << 0
}
pub fn (sel &mut Select) set_popup_rows(rows int) int {
    if rows<1 || rows>16 { >> errors.new("widgets: select popup rows must be 1..16") }
    sel.visible_options=rows
    sel.reveal_option()
    sel.dirty=true
    << 0
}

pub fn (t &Tabs) is_automatic() bool { << t.automatic }
