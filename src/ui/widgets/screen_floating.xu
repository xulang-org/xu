@ui/widgets

#ui/draw
#ui/layout
#errors
#math

pub const ACTION_FLOATING_DISMISS = 15

pub const ANCHOR_TOP = 0
pub const ANCHOR_BOTTOM = 1
pub const ANCHOR_LEFT = 2
pub const ANCHOR_RIGHT = 3

pub const ANCHOR_START = 0
pub const ANCHOR_CENTER = 1
pub const ANCHOR_END = 2

pub struct FloatingSpec {
    pub anchor int
    pub placement int
    pub align int
    pub offset f64
    pub margin f64
    pub auto_flip bool
    pub auto_shift bool
    pub match_anchor_width bool
    pub dismiss_on_outside bool
}

pub fn floating_spec(anchor int,placement int) FloatingSpec {
    << FloatingSpec{
        anchor: anchor,
        placement: placement,
        align: ANCHOR_START,
        offset: 6.0,
        margin: 8.0,
        auto_flip: true,
        auto_shift: true,
        match_anchor_width: false,
        dismiss_on_outside: true
    }
}

pub fn (f &FloatingSpec) validate() int {
    if f.anchor < 0 { >>> errors.new("widgets: invalid floating anchor") }
    if f.placement < ANCHOR_TOP || f.placement > ANCHOR_RIGHT { >>> errors.new("widgets: invalid floating placement") }
    if f.align < ANCHOR_START || f.align > ANCHOR_END { >>> errors.new("widgets: invalid floating alignment") }
    if math.is_nan(f.offset) || math.is_inf(f.offset) || math.abs(f.offset) > 4096.0 {
        >>> errors.new("widgets: invalid floating offset")
    }
    if math.is_nan(f.margin) || math.is_inf(f.margin) || f.margin < 0.0 || f.margin > 1024.0 {
        >>> errors.new("widgets: invalid floating margin")
    }
    << 0
}

fn copy_floating_spec(f &FloatingSpec) FloatingSpec {
    << FloatingSpec{
        anchor: f.anchor,
        placement: f.placement,
        align: f.align,
        offset: f.offset,
        margin: f.margin,
        auto_flip: f.auto_flip,
        auto_shift: f.auto_shift,
        match_anchor_width: f.match_anchor_width,
        dismiss_on_outside: f.dismiss_on_outside
    }
}

pub fn (s $&Screen) anchor_floating(id int,spec &FloatingSpec) int {
    _ := s.node(id) >>>
    spec.validate() >>>
    if spec.anchor > 0 {
        _ := s.node(spec.anchor) >>>
        if spec.anchor == id || s.is_descendant(spec.anchor,id) {
            >>> errors.new("widgets: floating anchor cycle")
        }
    }
    comp := $&s.composition
    fl := $&comp.floatings
    had := fl.has(id)
    fl[id] = copy_floating_spec(spec)
    if !had {
        fids := $&comp.floating_ids
        fids.push(id)
        comp.floating_count = comp.floating_count + 1
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_floating(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.floatings.has(id) {
        fl := $&comp.floatings
        fl.delete(id)
        next := vec_without(&comp.floating_ids,id)
        comp.floating_ids = next
        if comp.floating_count > 0 { comp.floating_count = comp.floating_count - 1 }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s &Screen) is_floating(id int) bool {
    _ := s.node(id) >>>
    << s.is_floating_node(id)
}

fn (s &Screen) is_floating_node(id int) bool {
    << s.composition.floating_count > 0 && s.composition.floatings.has(id)
}

fn (s &Screen) ordered_floating_ids() []int {
    $ids := []int{}
    fcount := s.composition.floating_ids.len
    $has_z := false
    for i in 0:fcount {
        fid := s.composition.floating_ids[i]
        if fid > 0 && fid <= s.nodes.len && s.nodes[fid - 1].kind >= 0 && s.composition.floatings.has(fid) {
            ids.push(fid)
            if s.composition.z_index_count > 0 && s.effective_z_index(fid) != 0 { has_z = true }
        }
    }
    if has_z && ids.len > 1 {
        for i in 1:ids.len {
            key := ids[i]
            key_z := s.effective_z_index(key)
            $j := i - 1
            while j >= 0 {
                prev := ids[j]
                prev_z := s.effective_z_index(prev)
                if prev_z <= key_z { <- }
                ids[j + 1] = prev
                j = j - 1
            }
            ids[j + 1] = key
        }
    }
    << ids
}

fn (s $&Screen) layout_floating_nodes(root_styles &Styles) int {
    if s.composition.floating_count == 0 { << 0 }
    fids := s.ordered_floating_ids()
    sa := s.composition.safe_area
    for i in 0:fids.len {
        fid := fids[i]
        if fid <= 0 || fid > s.nodes.len { -> }
        n := s.nodes[fid - 1]
        if n.kind < 0 || !s.is_visible(fid) || s.is_layout_hidden(fid) { -> }
        spec := copy_floating_spec(&s.composition.floatings[fid])
        $st := root_styles.clone()
        if s.has_any_style_overrides() { st = s.styles_for(fid) }
        min_x := sa.left + spec.margin
        max_x := math.max(min_x,s.width - sa.right - spec.margin)
        min_y := sa.top + spec.margin
        max_y := math.max(min_y,s.height - sa.bottom - spec.margin)
        avail_w := math.max(0.0,max_x - min_x)
        avail_h := math.max(0.0,max_y - min_y)

        $ab := layout.Rect{x: min_x + avail_w * 0.5,y: min_y + avail_h * 0.5,width: 0.0,height: 0.0}
        if spec.anchor > 0 && spec.anchor <= s.nodes.len && s.nodes[spec.anchor - 1].kind >= 0 {
            anc := s.nodes[spec.anchor - 1]
            ab = layout.Rect{x: anc.bounds.x,y: anc.bounds.y,width: anc.bounds.width,height: anc.bounds.height}
        }

        has_it := s.composition.items.has(fid)
        $it := layout_item()
        if has_it { it = copy_layout_item(&s.composition.items[fid]) }
        $w := 0.0
        $h := 0.0
        $fixed_w := false
        $fixed_h := false
        if spec.match_anchor_width && spec.anchor > 0 {
            w = math.max(0.0,ab.width)
            fixed_w = true
        } else if has_it && it.width >= 0.0 {
            w = it.width
            fixed_w = true
        } else if has_it && it.width_pct >= 0.0 {
            w = math.max(0.0,avail_w * it.width_pct)
            fixed_w = true
        }
        if has_it && it.height >= 0.0 {
            h = it.height
            fixed_h = true
        } else if has_it && it.height_pct >= 0.0 {
            h = math.max(0.0,avail_h * it.height_pct)
            fixed_h = true
        }
        if !fixed_w || !fixed_h {
            $lim_w := avail_w
            if fixed_w { lim_w = w }
            else if has_it && it.max_width >= 0.0 { lim_w = math.min(lim_w,it.max_width) }
            $lim_h := avail_h
            if fixed_h { lim_h = h }
            else if has_it && it.max_height >= 0.0 { lim_h = math.min(lim_h,it.max_height) }
            msz := s.measure_constrained_styled(fid,lim_w,lim_h,&st) >>>
            if !fixed_w {
                w = msz.width
                if w <= 0.0 && n.local.width > 0.0 { w = n.local.width }
            }
            if !fixed_h {
                h = msz.height
                if h <= 0.0 && n.local.height > 0.0 { h = n.local.height }
            }
        }
        if has_it {
            sz := apply_item_aspect_and_clamp(w,h,it.min_width,it.max_width,it.min_height,it.max_height,it.aspect_ratio,fixed_w,fixed_h)
            w = sz.width
            h = sz.height
        }
        w = math.max(0.0,w)
        h = math.max(0.0,h)

        $x := ab.x
        $y := ab.y
        if spec.placement == ANCHOR_TOP || spec.placement == ANCHOR_BOTTOM {
            if spec.align == ANCHOR_CENTER { x = ab.x + (ab.width - w) * 0.5 }
            else if spec.align == ANCHOR_END { x = ab.x + ab.width - w }
            else { x = ab.x }
            if spec.placement == ANCHOR_TOP { y = ab.y - spec.offset - h }
            else { y = ab.y + ab.height + spec.offset }
            if spec.auto_flip {
                top_y := ab.y - spec.offset - h
                bot_y := ab.y + ab.height + spec.offset
                if spec.placement == ANCHOR_BOTTOM && y + h > max_y {
                    if top_y >= min_y || (ab.y - min_y) > (max_y - (ab.y + ab.height)) { y = top_y }
                } else if spec.placement == ANCHOR_TOP && y < min_y {
                    if bot_y + h <= max_y || (max_y - (ab.y + ab.height)) > (ab.y - min_y) { y = bot_y }
                }
            }
        } else {
            if spec.align == ANCHOR_CENTER { y = ab.y + (ab.height - h) * 0.5 }
            else if spec.align == ANCHOR_END { y = ab.y + ab.height - h }
            else { y = ab.y }
            if spec.placement == ANCHOR_LEFT { x = ab.x - spec.offset - w }
            else { x = ab.x + ab.width + spec.offset }
            if spec.auto_flip {
                left_x := ab.x - spec.offset - w
                right_x := ab.x + ab.width + spec.offset
                if spec.placement == ANCHOR_RIGHT && x + w > max_x {
                    if left_x >= min_x || (ab.x - min_x) > (max_x - (ab.x + ab.width)) { x = left_x }
                } else if spec.placement == ANCHOR_LEFT && x < min_x {
                    if right_x + w <= max_x || (max_x - (ab.x + ab.width)) > (ab.x - min_x) { x = right_x }
                }
            }
        }
        if spec.auto_shift {
            x = math.max(min_x,math.min(x,math.max(min_x,max_x - w)))
            y = math.max(min_y,math.min(y,math.max(min_y,max_y - h)))
        }
        s.nodes[fid - 1].local = layout.Rect{x: x,y: y,width: w,height: h}
        s.layout_subtree(fid,&st) >>>
    }
    << 0
}

fn (s $&Screen) paint_floating_nodes(frame $&draw.Frame,root_styles &Styles) int {
    if s.composition.floating_count == 0 { << 0 }
    fids := s.ordered_floating_ids()
    for i in 0:fids.len {
        fid := fids[i]
        if fid <= 0 || fid > s.nodes.len { -> }
        if !s.is_visible(fid) { -> }
        $st := root_styles.clone()
        if s.has_any_style_overrides() { st = s.styles_for(fid) }
        comp := $&s.composition
        comp.painting_floating_root = fid
        err_msg := try_paint_floating_node(s,fid,frame,&st)
        comp2 := $&s.composition
        comp2.painting_floating_root = 0
        if err_msg.len > 0 { >>> errors.new(err_msg) }
    }
    << 0
}

fn try_paint_floating_node(s $&Screen,fid int,frame $&draw.Frame,st &Styles) string {
    s.paint_subtree(fid,frame,1.0,0,st) >>> (err) { << err.msg() }
    s.paint_subtree_popups(fid,frame,st,0) >>> (err) { << err.msg() }
    << ""
}

fn (s $&Screen) hit_floating_nodes(x f64,y f64) int {
    if s.composition.floating_count == 0 { << 0 }
    fids := s.ordered_floating_ids()
    $i := fids.len - 1
    while i >= 0 {
        fid := fids[i]
        if fid > 0 && fid <= s.nodes.len && s.is_visible(fid) {
            comp := $&s.composition
            comp.hitting_floating_root = fid
            found := s.hit_subtree(fid,x,y,0,0) >>> (err) {
                comp_e := $&s.composition
                comp_e.hitting_floating_root = 0
                >>> err
            }
            comp2 := $&s.composition
            comp2.hitting_floating_root = 0
            if found > 0 { << found }
        }
        i -= 1
    }
    << 0
}

fn (s $&Screen) dismiss_outside_floatings(target int,x f64,y f64,actions $&[]Action) int {
    if s.composition.floating_count == 0 { << 0 }
    fids := s.ordered_floating_ids()
    for i in 0:fids.len {
        fid := fids[i]
        if fid <= 0 || fid > s.nodes.len || !s.is_visible(fid) || !s.composition.floatings.has(fid) { -> }
        spec := copy_floating_spec(&s.composition.floatings[fid])
        if !spec.dismiss_on_outside { -> }
        fb := s.nodes[fid - 1].bounds
        if fb.contains(x,y) || target == fid || (target > 0 && s.is_descendant(target,fid)) { -> }
        if spec.anchor > 0 && spec.anchor <= s.nodes.len && s.nodes[spec.anchor - 1].kind >= 0 {
            ab := s.nodes[spec.anchor - 1].bounds
            if ab.contains(x,y) || target == spec.anchor || (target > 0 && s.is_descendant(target,spec.anchor)) { -> }
        }
        s.set_visible(fid,false) >>>
        actions.push(Action{kind: ACTION_FLOATING_DISMISS,id: fid,needs_paint: true,request_focus: false,consumed: false,value: 0.0})
    }
    << 0
}

fn (s $&Screen) cleanup_floating_for(id int) {
    comp := $&s.composition
    if comp.floatings.has(id) {
        fl := $&comp.floatings
        fl.delete(id)
        next := vec_without(&comp.floating_ids,id)
        comp.floating_ids = next
        if comp.floating_count > 0 { comp.floating_count = comp.floating_count - 1 }
    }
}
