@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

fn screen_is_overlay(kind int) bool { << kind >= SCREEN_POPOVER && kind <= SCREEN_MODAL }
fn screen_is_text_kind(kind int) bool { << kind == SCREEN_LABEL || kind == SCREEN_SELECTABLE_TEXT }
fn screen_is_control(kind int) bool { << (kind >= SCREEN_CHECKBOX && kind < SCREEN_POPOVER) || kind == SCREEN_SELECTABLE_TEXT || kind == SCREEN_CUSTOM }

fn sel_text_configure(item $&SelectableText,text &string,wrapped bool,ellipsis bool,muted bool) string {
    item.set_text(text) >>> (err) { << err.msg() }
    item.set_wrapped(wrapped)
    item.set_ellipsis(ellipsis)
    item.set_muted(muted)
    << ""
}
fn sel_text_set_bounds(item $&SelectableText,bounds &layout.Rect) string {
    item.set_bounds(bounds) >>> (err) { << err.msg() }
    << ""
}
fn sel_text_set_viewport(item $&SelectableText,viewport &layout.Rect) { item.set_viewport(viewport) }
fn sel_text_set_locale(item $&SelectableText,locale &Locale) string {
    item.set_locale(locale) >>> (err) { << err.msg() }
    << ""
}
fn sel_text_set_enabled(item $&SelectableText,enabled bool) { item.set_enabled(enabled) }
fn sel_text_set_selectable(item $&SelectableText,selectable bool) { item.set_selectable(selectable) }
fn sel_text_is_selectable(item &SelectableText) bool { << item.is_selectable() }
fn sel_text_is_focused(item &SelectableText) bool { << item.is_focused() }
fn sel_text_is_selecting(item &SelectableText) bool { << item.is_selecting() }
fn sel_text_has_popup(item &SelectableText) bool { << item.has_popup_open() }
fn sel_text_popup_bounds(item &SelectableText) layout.Rect { << item.popup_bounds() }
fn sel_text_cursor(item &SelectableText) int { << item.cursor() }
fn sel_text_cursor_at(item &SelectableText,x f64,y f64) int { << item.cursor_at(x,y) }
fn sel_text_painted(item $&SelectableText) { item.painted() }
fn sel_text_dispose(item $&SelectableText) { item.dispose() }
fn sel_text_clear_selection(item $&SelectableText) bool { << item.clear_selection() }
fn sel_text_input(item $&SelectableText,route int,event &ui.InputEvent) Action {
    if route == ROUTE_INPUT { << item.input(event) }
    << item.route(route,event)
}
fn sel_text_paint(item $&SelectableText,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,style &ControlStyle,popup bool) string {
    if popup {
        item.paint_popup_styled(frame,styles) >>> (err) { << err.msg() }
        << ""
    }
    item.set_bounds(bounds) >>> (err) { << err.msg() }
    item.set_style(style) >>> (err) { << err.msg() }
    frame.push() >>> (err) { << err.msg() }
    frame.translate(bounds.x,bounds.y) >>> (err) {
        frame.pop() >>> (e2) { << e2.msg() }
        << err.msg()
    }
    item.paint_styled(frame,styles) >>> (err) {
        frame.pop() >>> (e2) { << e2.msg() }
        << err.msg()
    }
    frame.pop() >>> (err) { << err.msg() }
    << ""
}

fn (s &Screen) label_control_style(id int,styles &Styles,opacity f64) ControlStyle {
    $style := styles.input.clone()
    style.padding = layout.insets(0.0) >>>
    style.align_x = 0.0
    style.align_y = 0.0
    style.inherit_font = false
    style.font = copy_font(&styles.font)
    style.font.size = s.text_sizes[id - 1]
    if s.muted[id - 1] || !s.effective_enabled(id) { style.palette.foreground = style.palette.muted }
    if s.basics.label_styles.has(id) {
        encoded := s.basics.label_styles[id] + ""
        style = decode_control_style(&encoded,&style)
    }
    style = s.style_or_patched(id,&style)
    << style.with_opacity(opacity) >>>
}

fn (s $&Screen) create_selectable_slot(slot int,owner_id int,text &string,wrapped bool,ellipsis bool,muted bool,bounds &layout.Rect,selectable bool) int {
    item := selectable_text(&s.context,&s.identity,owner_id,bounds,text) >>>
    $next := item
    sel_text_set_selectable($&next,selectable)
    cfg_err := sel_text_configure($&next,text,wrapped,ellipsis,muted)
    if cfg_err.len > 0 {
        sel_text_dispose($&next)
        >>> errors.new(cfg_err)
    }
    vp := s.viewport()
    sel_text_set_viewport($&next,&vp)
    loc_err := sel_text_set_locale($&next,&s.locale)
    if loc_err.len > 0 {
        sel_text_dispose($&next)
        >>> errors.new(loc_err)
    }
    basic := $&s.basics
    store := $&basic.selectable_texts
    if store.has(slot) {
        $old := store.take(slot)
        sel_text_dispose($&old)
    }
    store[slot] = next
    << 0
}

fn (s $&Screen) dispose_selectable_slot(slot int) {
    basic := $&s.basics
    store := $&basic.selectable_texts
    if store.has(slot) {
        $item := store.take(slot)
        sel_text_dispose($&item)
    }
}

pub fn (s $&Screen) selectable_text(text string,size f64,muted bool) int {
    if !finite_metric(size,256.0) || size <= 0.0 { >>> errors.new("widgets: invalid label size") }
    id := s.add_node(SCREEN_SELECTABLE_TEXT,true,ui.CURSOR_TEXT) >>>
    val := text + ""
    s.texts[id - 1] = val + ""
    s.text_sizes[id - 1] = size
    s.muted[id - 1] = muted
    empty := screen_empty()
    s.create_selectable_slot(id,id,&val,false,false,muted,&empty,true) >>> (err) {
        s.abandon_node(id)
        >>> err
    }
    << id
}

pub fn (s $&Screen) selectable_label(text string,size f64,muted bool) int {
    if !finite_metric(size,256.0) || size <= 0.0 { >>> errors.new("widgets: invalid label size") }
    id := s.add_node(SCREEN_LABEL,true,ui.CURSOR_TEXT) >>>
    val := text + ""
    s.texts[id - 1] = val + ""
    s.text_sizes[id - 1] = size
    s.muted[id - 1] = muted
    empty := screen_empty()
    s.create_selectable_slot(id,id,&val,false,false,muted,&empty,true) >>> (err) {
        s.abandon_node(id)
        >>> err
    }
    << id
}

pub fn (s &Screen) is_selectable_label(id int) bool {
    n := s.node(id) >>> (err) { << false }
    << screen_is_text_kind(n.kind) && s.basics.selectable_texts.has(id)
}

fn (s $&Screen) selectable_text_sync_node(id int) int {
    if !s.basics.selectable_texts.has(id) { << 0 }
    val := s.texts[id - 1] + ""
    wrapped := s.basics.wrapped_labels.has(id)
    ellipsis := s.basics.ellipsis_labels.has(id)
    muted := s.muted[id - 1]
    vp := s.viewport()
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(id)
    err_msg := sel_text_configure($&item,&val,wrapped,ellipsis,muted)
    sel_text_set_viewport($&item,&vp)
    store[id] = item
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}

fn (s $&Screen) selectable_text_place(id int,bounds &layout.Rect) int {
    if !s.basics.selectable_texts.has(id) { << 0 }
    vp := s.viewport()
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(id)
    err_msg := sel_text_set_bounds($&item,bounds)
    sel_text_set_viewport($&item,&vp)
    store[id] = item
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}

fn (s $&Screen) selectable_text_enable(id int,enabled bool) int {
    if !s.basics.selectable_texts.has(id) { << 0 }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(id)
    sel_text_set_enabled($&item,enabled)
    store[id] = item
    << 0
}

fn (s $&Screen) selectable_text_locale(slot int,locale &Locale) int {
    if !s.basics.selectable_texts.has(slot) { << 0 }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(slot)
    err_msg := sel_text_set_locale($&item,locale)
    store[slot] = item
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}

fn (s $&Screen) selectable_text_input(id int,route int,event &ui.InputEvent) Action {
    if !s.basics.selectable_texts.has(id) { << no_action(id,false) }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(id)
    act := sel_text_input($&item,route,event)
    store[id] = item
    << act
}

fn (s $&Screen) selectable_text_paint(id int,frame $&draw.Frame,styles &Styles,opacity f64,popup bool) int {
    if !s.basics.selectable_texts.has(id) { << 0 }
    bounds := s.bounds(id) >>>
    $style := styles.input.clone()
    if !popup { style = s.label_control_style(id,styles,opacity) >>> }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(id)
    err_msg := sel_text_paint($&item,frame,&bounds,styles,&style,popup)
    store[id] = item
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}

fn (s $&Screen) selectable_text_painted(slot int) {
    if !s.basics.selectable_texts.has(slot) { << }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(slot)
    sel_text_painted($&item)
    store[slot] = item
}

fn (s &Screen) selectable_text_popup(slot int) layout.Rect {
    if !s.basics.selectable_texts.has(slot) { << screen_empty() }
    item := &s.basics.selectable_texts[slot]
    if sel_text_has_popup(item) { << sel_text_popup_bounds(item) }
    << screen_empty()
}

fn (s $&Screen) selectable_text_cursor(slot int) int {
    if !s.basics.selectable_texts.has(slot) { << ui.CURSOR_DEFAULT }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(slot)
    c := sel_text_cursor(&item)
    store[slot] = item
    << c
}

fn (s $&Screen) selectable_text_cursor_at(slot int,x f64,y f64) int {
    if !s.basics.selectable_texts.has(slot) { << ui.CURSOR_DEFAULT }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(slot)
    c := sel_text_cursor_at(&item,x,y)
    store[slot] = item
    << c
}

fn (s &Screen) modal_title_bounds(id int,styles &Styles) layout.Rect {
    bounds := s.bounds(id) >>>
    factor := math.max(1.0,math.max(styles.density,styles.text_scale))
    << layout.Rect{x: bounds.x + 24.0 * factor,y: bounds.y + 30.0 * factor,width: math.max(0.0,bounds.width - 48.0 * factor),height: 50.0 * factor}
}

fn (s &Screen) modal_message_bounds(id int,styles &Styles) layout.Rect {
    bounds := s.bounds(id) >>>
    factor := math.max(1.0,math.max(styles.density,styles.text_scale))
    << layout.Rect{x: bounds.x + 24.0 * factor,y: bounds.y + 92.0 * factor,width: math.max(0.0,bounds.width - 48.0 * factor),height: 72.0 * factor}
}

fn (s &Screen) modal_title_style(styles &Styles,opacity f64) ControlStyle {
    $style := styles.input.clone()
    style.inherit_font = false
    style.font = copy_font(&styles.font)
    style.font.size = 21.0
    style.align_x = 0.0
    style.align_y = 0.0
    style.padding = layout.insets(0.0) >>>
    << style.with_opacity(opacity) >>>
}

fn (s &Screen) modal_message_style(styles &Styles,opacity f64) ControlStyle {
    $style := styles.input.clone()
    style.inherit_font = false
    style.font = copy_font(&styles.font)
    style.font.size = 14.0
    style.palette.foreground = style.palette.muted
    style.align_x = 0.0
    style.align_y = 0.0
    style.padding = layout.insets(0.0) >>>
    << style.with_opacity(opacity) >>>
}

fn (s $&Screen) modal_ensure_texts(id int) int {
    styles := s.styles_for(id)
    title_rect := s.modal_title_bounds(id,&styles) >>>
    msg_rect := s.modal_message_bounds(id,&styles) >>>
    title := s.texts[id - 1] + ""
    msg := s.descriptions[id - 1] + ""
    if !s.basics.selectable_texts.has(id) {
        s.create_selectable_slot(id,id,&title,true,false,false,&title_rect,true) >>>
    }
    if !s.basics.selectable_texts.has(-id) {
        s.create_selectable_slot(-id,id,&msg,true,false,true,&msg_rect,true) >>>
    }
    << s.modal_sync_texts(id) >>>
}

fn (s $&Screen) modal_sync_texts(id int) int {
    if !s.basics.selectable_texts.has(id) && !s.basics.selectable_texts.has(-id) { << 0 }
    styles := s.styles_for(id)
    vp := s.viewport()
    if s.basics.selectable_texts.has(id) {
        title := s.texts[id - 1] + ""
        title_rect := s.modal_title_bounds(id,&styles) >>>
        basic := $&s.basics
        store := $&basic.selectable_texts
        $item := store.take(id)
        e1 := sel_text_configure($&item,&title,true,false,false)
        e2 := sel_text_set_bounds($&item,&title_rect)
        sel_text_set_viewport($&item,&vp)
        sel_text_set_enabled($&item,true)
        store[id] = item
        if e1.len > 0 { >>> errors.new(e1) }
        if e2.len > 0 { >>> errors.new(e2) }
    }
    if s.basics.selectable_texts.has(-id) {
        msg := s.descriptions[id - 1] + ""
        msg_rect := s.modal_message_bounds(id,&styles) >>>
        basic := $&s.basics
        store := $&basic.selectable_texts
        $item := store.take(-id)
        e1 := sel_text_configure($&item,&msg,true,false,true)
        e2 := sel_text_set_bounds($&item,&msg_rect)
        sel_text_set_viewport($&item,&vp)
        sel_text_set_enabled($&item,true)
        store[-id] = item
        if e1.len > 0 { >>> errors.new(e1) }
        if e2.len > 0 { >>> errors.new(e2) }
    }
    << 0
}

fn (s $&Screen) modal_dispose_texts(id int) {
    s.dispose_selectable_slot(id)
    s.dispose_selectable_slot(-id)
}

fn (s $&Screen) modal_painted_texts(id int) {
    s.selectable_text_painted(id)
    s.selectable_text_painted(-id)
}

fn (s $&Screen) modal_paint_slot(slot int,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,style &ControlStyle) int {
    if !s.basics.selectable_texts.has(slot) { << 0 }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(slot)
    err_msg := sel_text_paint($&item,frame,bounds,styles,style,false)
    store[slot] = item
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}

fn (s $&Screen) modal_paint_text(id int,frame $&draw.Frame,styles &Styles,opacity f64) int {
    if s.has_slot(id,SLOT_HEADER) || (s.has_slot(id,SLOT_BODY) && s.texts[id - 1].len == 0 && s.descriptions[id - 1].len == 0) {
        << 0
    }
    title_bounds := s.modal_title_bounds(id,styles) >>>
    message_bounds := s.modal_message_bounds(id,styles) >>>
    if !s.is_selectable(id) {
        $title := styles.input.clone()
        title.inherit_font = false
        title.font = copy_font(&styles.font)
        title.font.size = 21.0
        title.align_x = 0.0
        title.align_y = 0.0
        title.padding = layout.insets(0.0) >>>
        s.paint_text(id,frame,&title_bounds,&title,opacity) >>>
        title.font.size = 14.0
        title.palette.foreground = title.palette.muted
        s.paint_caption(id,true,frame,&message_bounds,&title,opacity) >>>
        << 0
    }
    s.modal_ensure_texts(id) >>>
    t_style := s.modal_title_style(styles,opacity) >>>
    m_style := s.modal_message_style(styles,opacity) >>>
    s.modal_paint_slot(id,frame,&title_bounds,styles,&t_style) >>>
    s.modal_paint_slot(-id,frame,&message_bounds,styles,&m_style) >>>
    << 0
}

fn (s $&Screen) modal_has_text_popup(id int) bool {
    << s.selectable_text_popup(id).height > 0.0 || s.selectable_text_popup(-id).height > 0.0
}

fn (s $&Screen) modal_paint_text_popup(id int,frame $&draw.Frame,styles &Styles) int {
    if s.basics.selectable_texts.has(id) {
        $empty := styles.input.clone()
        basic := $&s.basics
        store := $&basic.selectable_texts
        $item := store.take(id)
        e := sel_text_paint($&item,frame,&screen_empty(),styles,&empty,true)
        store[id] = item
        if e.len > 0 { >>> errors.new(e) }
    }
    if s.basics.selectable_texts.has(-id) {
        $empty := styles.input.clone()
        basic := $&s.basics
        store := $&basic.selectable_texts
        $item := store.take(-id)
        e := sel_text_paint($&item,frame,&screen_empty(),styles,&empty,true)
        store[-id] = item
        if e.len > 0 { >>> errors.new(e) }
    }
    << 0
}

struct ModalSlotState {
    has_popup bool
    selecting bool
    focused bool
}

fn (s $&Screen) modal_slot_state(slot int) ModalSlotState {
    if !s.basics.selectable_texts.has(slot) { << ModalSlotState{has_popup: false,selecting: false,focused: false} }
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(slot)
    pop := sel_text_has_popup(&item)
    sel := sel_text_is_selecting(&item)
    foc := sel_text_is_focused(&item)
    store[slot] = item
    << ModalSlotState{has_popup: pop,selecting: sel,focused: foc}
}

fn (s $&Screen) modal_clear_slot(slot int) bool {
    if !s.basics.selectable_texts.has(slot) { << false }
    ev := s.cancellation()
    basic := $&s.basics
    store := $&basic.selectable_texts
    $item := store.take(slot)
    _ := sel_text_input($&item,ROUTE_BLUR,&ev)
    changed := sel_text_clear_selection($&item)
    store[slot] = item
    << changed
}

fn (s $&Screen) modal_blur_texts(id int) {
    if s.modal_clear_slot(id) { s.dirty = true }
    if s.modal_clear_slot(-id) { s.dirty = true }
}

fn (s $&Screen) modal_handle_popup_input(id int,event &ui.InputEvent) Action {
    st_t := s.modal_slot_state(id)
    if st_t.has_popup {
        a := s.selectable_text_input(id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        << a
    }
    st_m := s.modal_slot_state(-id)
    if st_m.has_popup {
        a := s.selectable_text_input(-id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        << a
    }
    << no_action(id,false)
}

fn (s $&Screen) modal_handle_pointer(id int,event &ui.InputEvent) Action {
    if !s.is_selectable(id) { << no_action(id,false) }
    s.modal_ensure_texts(id) >>>
    styles := s.styles.clone()
    t_bounds := s.modal_title_bounds(id,&styles) >>>
    m_bounds := s.modal_message_bounds(id,&styles) >>>
    st_t := s.modal_slot_state(id)
    st_m := s.modal_slot_state(-id)
    if st_t.selecting {
        a := s.selectable_text_input(id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        << a
    }
    if st_m.selecting {
        a := s.selectable_text_input(-id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        << a
    }
    if t_bounds.contains(event.x,event.y) {
        if event.kind == ui.EV_POINTER_DOWN { _ := s.modal_clear_slot(-id) }
        a := s.selectable_text_input(id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        << a
    }
    if m_bounds.contains(event.x,event.y) {
        if event.kind == ui.EV_POINTER_DOWN { _ := s.modal_clear_slot(id) }
        a := s.selectable_text_input(-id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        << a
    }
    if event.kind == ui.EV_POINTER_DOWN { s.modal_blur_texts(id) }
    << no_action(id,false)
}

fn (s $&Screen) modal_handle_key(id int,event &ui.InputEvent) Action {
    if !s.is_selectable(id) { << no_action(id,false) }
    st_t := s.modal_slot_state(id)
    if st_t.focused {
        a := s.selectable_text_input(id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        if a.consumed { << a }
    }
    st_m := s.modal_slot_state(-id)
    if st_m.focused {
        a := s.selectable_text_input(-id,ROUTE_INPUT,event)
        if a.needs_paint { s.dirty = true }
        if a.consumed { << a }
    }
    << no_action(id,false)
}

fn (s $&Screen) modal_text_cursor(id int,x f64,y f64) int {
    if !s.is_selectable(id) { << ui.CURSOR_DEFAULT }
    pop_t := s.selectable_text_popup(id)
    if pop_t.width > 0.0 && pop_t.contains(x,y) { << s.selectable_text_cursor_at(id,x,y) }
    pop_m := s.selectable_text_popup(-id)
    if pop_m.width > 0.0 && pop_m.contains(x,y) { << s.selectable_text_cursor_at(-id,x,y) }
    styles := s.styles.clone()
    t_bounds := s.modal_title_bounds(id,&styles) >>>
    if t_bounds.contains(x,y) { << s.selectable_text_cursor_at(id,x,y) }
    m_bounds := s.modal_message_bounds(id,&styles) >>>
    if m_bounds.contains(x,y) { << s.selectable_text_cursor_at(-id,x,y) }
    << ui.CURSOR_DEFAULT
}

fn (s $&Screen) overlay_cursor(id int,x f64,y f64) int {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) {
        $c := s.screen_take_popover(id) >>>
        $cur := ui.CURSOR_DEFAULT
        if c.has_popup_open() { cur = c.cursor_at(x,y) }
        else if !s.popover_has_content(id) { cur = c.cursor_at(x,y) }
        s.screen_put_popover(id,c)
        << cur
    }
    if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) {
        $c := s.screen_take_tooltip(id) >>>
        cur := c.cursor_at(x,y)
        s.screen_put_tooltip(id,c)
        << cur
    }
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) {
        $c := s.screen_take_toast(id) >>>
        $cur := ui.CURSOR_DEFAULT
        if c.close_bounds().contains(x,y) || s.notice_action_bounds(id).contains(x,y) { cur = ui.CURSOR_HAND }
        else { cur = c.cursor_at(x,y) }
        s.screen_put_toast(id,c)
        << cur
    }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) {
        $c := s.screen_take_modal(id) >>>
        $cur := ui.CURSOR_DEFAULT
        if c.close_bounds().contains(x,y) { cur = ui.CURSOR_HAND }
        s.screen_put_modal(id,c)
        if cur != ui.CURSOR_DEFAULT { << cur }
        << s.modal_text_cursor(id,x,y)
    }
    << ui.CURSOR_DEFAULT
}

fn (s $&Screen) overlay_sync_text(id int) int {
    kind := s.screen_overlay_kind(id)
    if !s.is_selectable(id) { << 0 }
    val := s.texts[id - 1] + ""
    vp := s.viewport()
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) {
        $c := s.screen_take_popover(id) >>>
        c.set_viewport(&vp)
        c.set_text(&s.context,&val) >>> (err) {
            s.screen_put_popover(id,c.clone_panel())
            >>> err
        }
        s.screen_put_popover(id,c)
        << 0
    }
    if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) {
        $c := s.screen_take_tooltip(id) >>>
        c.set_viewport(&vp)
        c.set_text(&s.context,&val) >>> (err) {
            s.screen_put_tooltip(id,c.clone_tooltip())
            >>> err
        }
        s.screen_put_tooltip(id,c)
        << 0
    }
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) {
        ab := s.notice_action_bounds(id)
        $c := s.screen_take_toast(id) >>>
        c.set_action_width(ab.width)
        c.set_viewport(&vp)
        c.set_text(&s.context,&val) >>> (err) {
            s.screen_put_toast(id,c.clone_toast())
            >>> err
        }
        s.screen_put_toast(id,c)
        << 0
    }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) {
        << s.modal_sync_texts(id) >>>
    }
    << 0
}

fn (s $&Screen) overlay_paint_popup(id int,frame $&draw.Frame,styles &Styles) int {
    if !s.overlay_visible(id) { << 0 }
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) {
        $c := s.screen_take_popover(id) >>>
        c.paint_popup_styled(frame,styles) >>> (err) {
            s.screen_put_popover(id,c.clone_panel())
            >>> err
        }
        s.screen_put_popover(id,c)
        << 0
    }
    if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) {
        $c := s.screen_take_tooltip(id) >>>
        c.paint_popup_styled(frame,styles) >>> (err) {
            s.screen_put_tooltip(id,c.clone_tooltip())
            >>> err
        }
        s.screen_put_tooltip(id,c)
        << 0
    }
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) {
        $c := s.screen_take_toast(id) >>>
        c.paint_popup_styled(frame,styles) >>> (err) {
            s.screen_put_toast(id,c.clone_toast())
            >>> err
        }
        s.screen_put_toast(id,c)
        << 0
    }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) {
        << s.modal_paint_text_popup(id,frame,styles) >>>
    }
    << 0
}

fn (s &Screen) basic_is_selectable(id int,kind int) bool {
    if kind == SCREEN_CHECKBOX && s.basics.checks.has(id) { << s.basics.checks[id].is_selectable() }
    if kind == SCREEN_SWITCH && s.basics.switches.has(id) { << s.basics.switches[id].is_selectable() }
    if kind == SCREEN_RADIO && s.basics.radios.has(id) { << s.basics.radios[id].is_selectable() }
    if kind == SCREEN_SLIDER && s.basics.sliders.has(id) { << s.basics.sliders[id].is_selectable() }
    if kind == SCREEN_STEPPER && s.basics.steppers.has(id) { << s.basics.steppers[id].is_selectable() }
    if kind == SCREEN_TABS && s.basics.tabs.has(id) { << s.basics.tabs[id].is_selectable() }
    if kind == SCREEN_SELECT && s.basics.selects.has(id) { << s.basics.selects[id].is_selectable() }
    if kind == SCREEN_LIST && s.basics.lists.has(id) { << s.basics.lists[id].is_selectable() }
    if kind == SCREEN_PROGRESS && s.basics.progresses.has(id) { << s.basics.progresses[id].is_selectable() }
    if kind == SCREEN_DIVIDER && s.basics.dividers.has(id) { << s.basics.dividers[id].is_selectable() }
    if kind == SCREEN_BADGE && s.basics.badges.has(id) { << s.basics.badges[id].is_selectable() }
    if kind == SCREEN_CARD && s.basics.cards.has(id) { << s.basics.cards[id].is_selectable() }
    if kind == SCREEN_RADIO_GROUP && s.basics.groups.has(id) { << s.basics.groups[id].is_selectable() }
    << false
}

