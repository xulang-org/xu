@ui/widgets

#ui
#ui/draw
#ui/layout
#errors

// Opt-in selectable display text for Screen. Existing Screen.label stays
// non-interactive; apps that need copy use selectable_label instead.

fn choice_local_input(event &ui.InputEvent,bounds &layout.Rect) ui.InputEvent {
    $local := choice_copy_input(event)
    local.x = event.x - bounds.x
    local.y = event.y - bounds.y
    << local
}

pub fn (s $&Screen) selectable_label(text string,size f64,muted bool) int {
    if !finite_metric(size,256.0) || size <= 0.0 { >> errors.new("widgets: invalid label size") }
    id := s.add_node(SCREEN_LABEL,true,ui.CURSOR_TEXT) or >>
    empty := screen_empty()
    $item := selectable_text(&s.context,&s.identity,id,&empty,&text) or (err) { s.abandon_node(id)
        >> err }
    $weight := 400
    if muted { weight = 500 }
    item.set_font(size,weight,false) or (err) { item.dispose()
        s.abandon_node(id)
        >> err }
    s.texts[id - 1] = text + ""
    s.text_sizes[id - 1] = size
    s.muted[id - 1] = muted
    basic := $&s.basics
    store := $&basic.selectables
    store[id] = item
    << id
}

pub fn (s &Screen) is_selectable_label(id int) bool {
    << s.basics.selectables.has(id)
}

fn screen_input_selectable(item $&SelectableText,route int,event &ui.InputEvent) Action {
    << item.route(route,event) or (err) { << no_action(item.id(),false) }
}

fn (s $&Screen) selectable_route(id int,route int,event &ui.InputEvent) Action {
    index := id - 1
    bounds := copy_rect(&s.nodes[index].bounds)
    basic := $&s.basics
    store := $&basic.selectables
    if !store.has(id) { << no_action(id,false) }
    $item := store.take(id)
    $action := no_action(id,false)
    if route == ROUTE_FOCUS || route == ROUTE_BLUR || route == ROUTE_CANCEL {
        action = screen_input_selectable($&item,route,event)
    } else {
        local := choice_local_input(event,&bounds)
        action = screen_input_selectable($&item,route,&local)
    }
    store[id] = item
    << action
}

fn (s $&Screen) selectable_event(id int,event &ui.Event) Action {
    basic := $&s.basics
    store := $&basic.selectables
    if !store.has(id) { << no_action(id,false) }
    $item := store.take(id)
    action := item.event(event) or (err) { << no_action(id,false) }
    store[id] = item
    << action
}

fn selectable_paint_item(item $&SelectableText,frame $&draw.Frame,bounds &layout.Rect,theme &Theme,color draw.Color,text &string,size f64,weight int,wrapped bool) string {
    item.set_bounds(bounds) or (err) { << err.msg() }
    item.set_text(text) or (err) { << err.msg() }
    item.set_font(size,weight,wrapped) or (err) { << err.msg() }
    item.paint_colored(frame,theme,color,theme.accent) or (err) { << err.msg() }
    item.painted()
    << ""
}

fn (s $&Screen) selectable_paint(id int,frame $&draw.Frame,bounds &layout.Rect,theme &Theme,color draw.Color) int {
    if !s.basics.selectables.has(id) { >> errors.new("widgets: selectable label missing") }
    text_index := id - 1
    text := s.texts[text_index] + ""
    size := s.text_sizes[text_index]
    $weight := 400
    if s.muted[text_index] { weight = 500 }
    wrapped := s.basics.wrapped_labels.has(id)
    basic := $&s.basics
    store := $&basic.selectables
    $item := store.take(id)
    err := selectable_paint_item($&item,frame,bounds,theme,color,&text,size,weight,wrapped)
    store[id] = item
    if err.len > 0 { >> errors.new(err) }
    << 0
}
