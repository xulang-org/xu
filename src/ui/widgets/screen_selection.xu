    item.set_selectable(v) >>> (err) { << err.msg() }
    << ""
}
fn ctrl_set_field_sel(item $&Field,v bool) string {
    item.set_selectable(v) >>> (err) { << err.msg() }
    << ""
}
fn ctrl_set_task_sel(item $&TaskButton,v bool) { item.set_selectable(v) }
fn ctrl_set_menu_sel(item $&Menu,v bool) { item.set_selectable(v) }
fn ctrl_set_bgroup_sel(item $&ButtonGroup,v bool) { item.set_selectable(v) }

fn (s $&Screen) control_set_selectable(id int,kind int,selectable bool) int {
    controls := $&s.controls
    if kind == SCREEN_TABLE && controls.tables.has(id) {
        items := $&controls.tables
        $item := items.take(id)
        ctrl_set_table_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_TREE && controls.trees.has(id) {
        items := $&controls.trees
        $item := items.take(id)
        ctrl_set_tree_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_PAGINATION && controls.pages.has(id) {
        items := $&controls.pages
        $item := items.take(id)
        ctrl_set_page_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_BREADCRUMBS && controls.crumbs.has(id) {
        items := $&controls.crumbs
        $item := items.take(id)
        ctrl_set_crumb_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_COMBO && controls.combos.has(id) {
        items := $&controls.combos
        $item := items.take(id)
        err_msg := ctrl_set_combo_sel($&item,selectable)
        items[id] = item
        if err_msg.len > 0 { >>> errors.new(err_msg) }
    } else if kind == SCREEN_MULTI && controls.multis.has(id) {
        items := $&controls.multis
        $item := items.take(id)
        ctrl_set_multi_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_COLOR && controls.colors.has(id) {
        items := $&controls.colors
        $item := items.take(id)
        ctrl_set_color_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_DATE && controls.dates.has(id) {
        items := $&controls.dates
        $item := items.take(id)
        ctrl_set_date_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_CLOCK && controls.clocks.has(id) {
        items := $&controls.clocks
        $item := items.take(id)
        ctrl_set_clock_sel($&item,selectable)
        items[id] = item
    } else if (kind == SCREEN_EDITOR || kind == SCREEN_SECRET_INPUT) && controls.editors.has(id) {
        items := $&controls.editors
        $item := items.take(id)
        err_msg := ctrl_set_editor_sel($&item,selectable)
        items[id] = item
        if err_msg.len > 0 { >>> errors.new(err_msg) }
    } else if kind == SCREEN_FIELD && controls.fields.has(id) {
        items := $&controls.fields
        $item := items.take(id)
        err_msg := ctrl_set_field_sel($&item,selectable)
        items[id] = item
        if err_msg.len > 0 { >>> errors.new(err_msg) }
    } else if kind == SCREEN_TASK && controls.tasks.has(id) {
        items := $&controls.tasks
        $item := items.take(id)
        ctrl_set_task_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_MENU && controls.menus.has(id) {
        items := $&controls.menus
        $item := items.take(id)
        ctrl_set_menu_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_BUTTON_GROUP && controls.button_groups.has(id) {
        items := $&controls.button_groups
        $item := items.take(id)
        ctrl_set_bgroup_sel($&item,selectable)
        items[id] = item
    }
    << 0
}

pub fn (s &Screen) is_selectable(id int) bool {
    n := s.node(id) >>> (err) { << false }
    if n.kind == SCREEN_LABEL {
        if !s.basics.selectable_texts.has(id) { << false }
        << sel_text_is_selectable(&s.basics.selectable_texts[id])
    }
    if n.kind == SCREEN_SELECTABLE_TEXT {
        if !s.basics.selectable_texts.has(id) { << false }
        << sel_text_is_selectable(&s.basics.selectable_texts[id])
    }
    if n.kind == SCREEN_BUTTON && s.buttons.has(id) { << s.buttons[id].is_selectable() }
    if screen_basic_kind(n.kind) { << s.basic_is_selectable(id,n.kind) }
    if n.kind == SCREEN_POPOVER && s.overlays.popovers.has(id) { << s.overlays.popovers[id].is_selectable() }
    if n.kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) { << s.overlays.tooltips[id].is_selectable() }
    if n.kind == SCREEN_TOAST && s.overlays.toasts.has(id) { << s.overlays.toasts[id].is_selectable() }
    if n.kind == SCREEN_MODAL && s.overlays.modals.has(id) { << s.overlays.modals[id].is_selectable() }
    << s.control_is_selectable(id,n.kind)
}

pub fn (s $&Screen) set_label_selectable(id int,selectable bool) int {
    n := s.node(id) >>>
    if !screen_is_text_kind(n.kind) { >>> errors.new("widgets: expected Label or SelectableText") }
    << s.set_selectable(id,selectable) >>>
}

pub fn (s $&Screen) set_selectable(id int,selectable bool) int {
    n := s.node(id) >>>
    if n.kind == SCREEN_LABEL {
        if selectable {
            bounds := s.bounds(id) >>>
            val := s.texts[id - 1] + ""
            wrapped := s.basics.wrapped_labels.has(id)
            ellipsis := s.basics.ellipsis_labels.has(id)
            muted := s.muted[id - 1]
            if !s.basics.selectable_texts.has(id) {
                s.create_selectable_slot(id,id,&val,wrapped,ellipsis,muted,&bounds,true) >>>
            } else {
                basic := $&s.basics
                store := $&basic.selectable_texts
                $item := store.take(id)
                sel_text_set_selectable($&item,true)
                store[id] = item
                s.selectable_text_sync_node(id) >>>
            }
            s.nodes[id - 1].focusable = true
            s.nodes[id - 1].cursor = ui.CURSOR_TEXT
            comp := $&s.composition
            vec_add_unique($&comp.popup_capable_ids,id)
        } else {
            if s.focused == id { s.focus_input(0) >>> }
            if s.captured == id { s.captured = 0 }
            s.dispose_selectable_slot(id)
            s.nodes[id - 1].focusable = false
            s.nodes[id - 1].cursor = ui.CURSOR_DEFAULT
            comp := $&s.composition
            if vec_has(&comp.popup_capable_ids,id) {
                next := vec_without(&comp.popup_capable_ids,id)
                comp.popup_capable_ids = next
            }
        }
        s.mark_layout_dirty()
        << 0
    }
    if n.kind == SCREEN_SELECTABLE_TEXT {
        if !selectable {
            if s.focused == id { s.focus_input(0) >>> }
            if s.captured == id { s.captured = 0 }
        }
        if s.basics.selectable_texts.has(id) {
            basic := $&s.basics
            store := $&basic.selectable_texts
            $item := store.take(id)
            sel_text_set_selectable($&item,selectable)
            store[id] = item
        }
        s.nodes[id - 1].focusable = selectable
        if selectable { s.nodes[id - 1].cursor = ui.CURSOR_TEXT }
        else { s.nodes[id - 1].cursor = ui.CURSOR_DEFAULT }
        s.dirty = true
        << 0
    }
    if n.kind == SCREEN_BUTTON {
        $b := s.take_button(id)
        b.set_selectable(selectable)
        s.buttons[id] = b
        s.dirty = true
        << 0
    }
    if screen_basic_kind(n.kind) {
        s.basic_set_selectable(id,n.kind,selectable)
        s.dirty = true
        << 0
    }
    if n.kind == SCREEN_POPOVER {
        $c := s.screen_take_popover(id) >>>
        c.set_selectable(selectable)
        vp := s.viewport()
        c.set_viewport(&vp)
        c.set_locale(&s.locale) >>> (err) {
            s.screen_put_popover(id,c.clone_panel())
            >>> err
        }
        if selectable {
            val := s.texts[id - 1] + ""
            c.set_text(&s.context,&val) >>> (err) {
                s.screen_put_popover(id,c.clone_panel())
                >>> err
            }
        }
        s.screen_put_popover(id,c)
        s.dirty = true
        << 0
    }
    if n.kind == SCREEN_TOOLTIP {
        $c := s.screen_take_tooltip(id) >>>
        c.set_selectable(selectable)
        vp := s.viewport()
        c.set_viewport(&vp)
        c.set_locale(&s.locale) >>> (err) {
            s.screen_put_tooltip(id,c.clone_tooltip())
            >>> err
        }
        if selectable {
            val := s.texts[id - 1] + ""
            c.set_text(&s.context,&val) >>> (err) {
                s.screen_put_tooltip(id,c.clone_tooltip())
                >>> err
            }
        }
        s.screen_put_tooltip(id,c)
        s.dirty = true
        << 0
    }
    if n.kind == SCREEN_TOAST {
        $c := s.screen_take_toast(id) >>>
        c.set_selectable(selectable)
        vp := s.viewport()
        c.set_viewport(&vp)
        c.set_locale(&s.locale) >>> (err) {
            s.screen_put_toast(id,c.clone_toast())
            >>> err
        }
        if selectable {
            val := s.texts[id - 1] + ""
            c.set_text(&s.context,&val) >>> (err) {
                s.screen_put_toast(id,c.clone_toast())
                >>> err
            }
        }
        s.screen_put_toast(id,c)
        s.dirty = true
        << 0
    }
    if n.kind == SCREEN_MODAL {
        $c := s.screen_take_modal(id) >>>
        c.set_selectable(selectable)
        c.set_locale(&s.locale) >>> (err) {
            s.screen_put_modal(id,screen_modal_rollback(&c))
            >>> err
        }
        s.screen_put_modal(id,c)
        if selectable { s.modal_ensure_texts(id) >>> }
        else { s.modal_dispose_texts(id) }
        s.dirty = true
        << 0
    }
    s.control_set_selectable(id,n.kind,selectable) >>>
    s.dirty = true
    << 0
}
