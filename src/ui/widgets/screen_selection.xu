fn (s $&Screen) basic_set_selectable(id int,kind int,selectable bool) {
    owner := $&s.basics
    if kind == SCREEN_CHECKBOX && owner.checks.has(id) {
        items := $&owner.checks
        $item := items.take(id)
        basic_set_checkbox_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_SWITCH && owner.switches.has(id) {
        items := $&owner.switches
        $item := items.take(id)
        basic_set_switch_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_RADIO && owner.radios.has(id) {
        items := $&owner.radios
        $item := items.take(id)
        basic_set_radio_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_SLIDER && owner.sliders.has(id) {
        items := $&owner.sliders
        $item := items.take(id)
        basic_set_slider_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_STEPPER && owner.steppers.has(id) {
        items := $&owner.steppers
        $item := items.take(id)
        basic_set_stepper_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_TABS && owner.tabs.has(id) {
        items := $&owner.tabs
        $item := items.take(id)
        basic_set_tabs_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_SELECT && owner.selects.has(id) {
        items := $&owner.selects
        $item := items.take(id)
        basic_set_select_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_LIST && owner.lists.has(id) {
        items := $&owner.lists
        $item := items.take(id)
        basic_set_list_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_PROGRESS && owner.progresses.has(id) {
        items := $&owner.progresses
        $item := items.take(id)
        basic_set_progress_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_DIVIDER && owner.dividers.has(id) {
        items := $&owner.dividers
        $item := items.take(id)
        basic_set_divider_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_BADGE && owner.badges.has(id) {
        items := $&owner.badges
        $item := items.take(id)
        basic_set_badge_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_CARD && owner.cards.has(id) {
        items := $&owner.cards
        $item := items.take(id)
        basic_set_card_sel($&item,selectable)
        items[id] = item
    } else if kind == SCREEN_RADIO_GROUP && owner.groups.has(id) {
        items := $&owner.groups
        $item := items.take(id)
        basic_set_group_sel($&item,selectable)
        items[id] = item
    }
}

fn (s &Screen) control_is_selectable(id int,kind int) bool {
    if kind == SCREEN_TABLE && s.controls.tables.has(id) { << s.controls.tables[id].is_selectable() }
    if kind == SCREEN_TREE && s.controls.trees.has(id) { << s.controls.trees[id].is_selectable() }
    if kind == SCREEN_PAGINATION && s.controls.pages.has(id) { << s.controls.pages[id].is_selectable() }
    if kind == SCREEN_BREADCRUMBS && s.controls.crumbs.has(id) { << s.controls.crumbs[id].is_selectable() }
    if kind == SCREEN_COMBO && s.controls.combos.has(id) { << s.controls.combos[id].is_selectable() }
    if kind == SCREEN_MULTI && s.controls.multis.has(id) { << s.controls.multis[id].is_selectable() }
    if kind == SCREEN_COLOR && s.controls.colors.has(id) { << s.controls.colors[id].is_selectable() }
    if kind == SCREEN_DATE && s.controls.dates.has(id) { << s.controls.dates[id].is_selectable() }
    if kind == SCREEN_CLOCK && s.controls.clocks.has(id) { << s.controls.clocks[id].is_selectable() }
    if (kind == SCREEN_EDITOR || kind == SCREEN_SECRET_INPUT) && s.controls.editors.has(id) { << s.controls.editors[id].is_selectable() }
    if kind == SCREEN_FIELD && s.controls.fields.has(id) { << s.controls.fields[id].is_selectable() }
    if kind == SCREEN_TASK && s.controls.tasks.has(id) { << s.controls.tasks[id].is_selectable() }
    if kind == SCREEN_MENU && s.controls.menus.has(id) { << s.controls.menus[id].is_selectable() }
    if kind == SCREEN_BUTTON_GROUP && s.controls.button_groups.has(id) { << s.controls.button_groups[id].is_selectable() }
    << false
}

fn ctrl_set_table_sel(item $&Table,v bool) { item.set_selectable(v) }
fn ctrl_set_tree_sel(item $&TreeView,v bool) { item.set_selectable(v) }
fn ctrl_set_page_sel(item $&Pagination,v bool) { item.set_selectable(v) }
fn ctrl_set_crumb_sel(item $&Breadcrumbs,v bool) { item.set_selectable(v) }
fn ctrl_set_combo_sel(item $&ComboBox,v bool) string {
    item.set_selectable(v) >>> (err) { << err.msg() }
    << ""
}
fn ctrl_set_multi_sel(item $&MultiSelect,v bool) { item.set_selectable(v) }
fn ctrl_set_color_sel(item $&ColorPicker,v bool) { item.set_selectable(v) }
fn ctrl_set_date_sel(item $&DatePicker,v bool) { item.set_selectable(v) }
fn ctrl_set_clock_sel(item $&TimePicker,v bool) { item.set_selectable(v) }
