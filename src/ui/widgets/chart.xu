@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

pub struct Chart {
    control Button
    series []ChartSeries
    disabled_series int
    data []ChartDatum
    bar_steps []f64
    appearance ChartAppearance
    locale Locale
    labels TextCache
    animation AnimationController
    motion MotionSpec
    emphasis Tween
    domain ChartDomain
    from_domain ChartDomain
    target_domain ChartDomain
    fixed_domain bool
    viewport ChartDomain
    plot layout.Rect
    legend_boxes []layout.Rect
    hot int
    selected int
    armed int
    dragging bool
    moved bool
    drag_x f64
    drag_y f64
    drag_view ChartDomain
    now time.Instant
    reduced bool
}
pub fn chart(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect) Chart {
    control := button(identity,id,bounds) or >>
    domain := chart_domain(0.0,1.0,0.0,1.0) or >>
    options := animation_options()
    << Chart{control: control,series: []ChartSeries{},disabled_series: 0,data: []ChartDatum{},bar_steps: []f64{},appearance: chart_appearance(),locale: locale_default(),
        labels: text_cache(context),animation: animation_controller(&options) or >>,motion: motion_spec(),emphasis: tween(0.0) or >>,
        domain: domain,from_domain: domain,target_domain: domain,fixed_domain: false,viewport: domain,plot: copy_rect(bounds),
        legend_boxes: []layout.Rect{},hot: -1,selected: -1,armed: -1,dragging: false,moved: false,drag_x: 0.0,drag_y: 0.0,
        drag_view: domain,now: time.zero_instant(),reduced: false}
}
pub fn (c &Chart) id() int { << c.control.id }
pub fn (c &Chart) bounds() layout.Rect { << c.control.bounds() }
pub fn (c &Chart) plot_bounds() layout.Rect { << copy_rect(&c.plot) }
pub fn (c &Chart) needs_paint() bool { << c.control.dirty }
pub fn (c $&Chart) painted() { c.control.dirty = false }
pub fn (c &Chart) is_enabled() bool { << c.control.is_enabled() }
pub fn (c &Chart) is_focused() bool { << c.control.focused }
pub fn (c &Chart) style_or(styles &Styles) ControlStyle {
    if c.control.has_style() { << c.control.style_or(styles) }
    << styles.card_style()
}
pub fn (c $&Chart) set_style(style &ControlStyle) int { item := $&c.control
    << item.set_style(style) or >> }
pub fn (c $&Chart) clear_style() { item := $&c.control
    item.clear_style() }
pub fn (c $&Chart) set_locale(locale &Locale) int { locale.validate() or >>
    c.locale = locale.clone()
    c.control.dirty = true
    << 0 }
pub fn (c $&Chart) set_appearance(appearance &ChartAppearance) int { appearance.validate() or >>
    c.appearance = appearance.clone()
    c.control.dirty = true
    c.cancel_drag()
    << 0 }
pub fn (c $&Chart) set_bounds(bounds &layout.Rect) int {
    old := c.bounds()
    item := $&c.control
    item.set_bounds(bounds) or >>
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height { c.cancel_drag() }
    << 0
}
pub fn (c $&Chart) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    c.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    options := AnimationOptions{duration: time.duration(max_int(1,spec.change.nanoseconds())),delay: c.animation.options.delay,
        iterations: 1,alternate: false,curve: spec.curve,rate: c.animation.options.rate}
    c.set_animation(&options) or >>
    emphasis := $&c.emphasis
    emphasis.set_curve(spec.curve) or >>
    << 0
}
pub fn (c $&Chart) set_animation(options &AnimationOptions) int {
    options.validate() or >>
    if options.iterations != 1 || options.alternate { >> errors.new("widgets: chart data transitions must have one forward iteration") }
    // Rebase from displayed values without waking an already settled chart.
    previous := c.animation.state()
    animation := animation_controller(options) or >>
    c.animation = animation
    c.rebase()
    now := c.now
    reduced := c.reduced || c.motion.change.is_zero()
    timeline := $&c.animation
    if previous == ANIMATION_RUNNING || previous == ANIMATION_PAUSED {
        timeline.play(now,reduced) or >>
        if previous == ANIMATION_PAUSED && !reduced { timeline.pause(now) or >> }
    } else { timeline.finish() }
    c.control.dirty = true
    << 0
}
fn (c $&Chart) rebase() {
    for i in 0:c.data.len { $p := c.data[i]
        p.from_x = p.x
        p.from_y = p.y
        p.from_low = p.low
        p.from_high = p.high
        p.from_close = p.close
        p.from_size = p.size
        p.from_opacity = p.opacity
        c.data[i] = p }
    c.from_domain = chart_copy_domain(&c.domain)
}
fn (c &Chart) auto_domain() ChartDomain {
    $d := ChartDomain{x_min: 1000000000000.0,x_max: 0.0 - 1000000000000.0,y_min: 1000000000000.0,y_max: 0.0 - 1000000000000.0}
    $count := 0
    for si in 0:c.series.len { s := &c.series[si]
        if c.series_is_visible(si) {
            $running := 0.0
            for pi in 0:s.points.len { p := &s.points[pi]
                d.x_min = math.min(d.x_min,p.x)
                d.x_max = math.max(d.x_max,p.x)
                if s.kind == CHART_HEATMAP {
                    $row := f64(si + 1)
                    if p.size != 0.0 { row = p.y }
                    d.y_min = math.min(d.y_min,row)
                    d.y_max = math.max(d.y_max,row)
                } else if s.kind == CHART_BOXPLOT || s.kind == CHART_CANDLESTICK {
                    $low := p.y - datum_range_span(p.y)
                    $high := p.y + datum_range_span(p.y)
                    if point_has_range(p) { low = p.low
                        high = p.high }
                    d.y_min = math.min(d.y_min,low)
                    d.y_max = math.max(d.y_max,high)
                } else if s.kind == CHART_WATERFALL {
                    if p.size > 0.0 {
                        if p.y != 0.0 { running = p.y }
                        d.y_min = math.min(d.y_min,math.min(0.0,running))
                        d.y_max = math.max(d.y_max,math.max(0.0,running))
                    } else {
                        next_run := running + p.y
                        d.y_min = math.min(d.y_min,math.min(running,next_run))
                        d.y_max = math.max(d.y_max,math.max(running,next_run))
                        running = next_run
                    }
                } else if s.kind == CHART_STACKED_AREA || s.kind == CHART_STACKED_BAR {
                    $pos_sum := 0.0
                    $neg_sum := 0.0
                    for sj in 0:si + 1 {
                        if c.series_is_visible(sj) && c.series[sj].kind == s.kind {
                            for qi in 0:c.series[sj].points.len {
                                q := &c.series[sj].points[qi]
                                if math.abs(q.x - p.x) < 0.0001 {
                                    if q.y >= 0.0 { pos_sum = pos_sum + q.y }
                                    else { neg_sum = neg_sum + q.y }
                                }
                            }
                        }
                    }
                    d.y_min = math.min(d.y_min,math.min(0.0,neg_sum))
                    d.y_max = math.max(d.y_max,pos_sum)
                } else {
                    d.y_min = math.min(d.y_min,p.y)
                    d.y_max = math.max(d.y_max,p.y)
                }
                count = count + 1
            }
        }
    }
    if count == 0 { << ChartDomain{x_min: 0.0,x_max: 1.0,y_min: 0.0,y_max: 1.0} }
    if c.heatmap() {
        $step := 1.0
        if c.bar_steps.len > 0 { step = c.bar_steps[0] }
        << ChartDomain{x_min: d.x_min - step * 0.55,x_max: d.x_max + step * 0.55,y_min: d.y_min - 0.55,y_max: d.y_max + 0.55}
    }
    if c.appearance.zero_baseline && !c.range_chart() {
        d.y_min = math.min(0.0,d.y_min)
        d.y_max = math.max(0.0,d.y_max)
    }
    if c.gauge() {
        d.y_min = 0.0
        d.y_max = math.max(100.0,d.y_max * 1.08)
    }
    if d.x_max - d.x_min < 0.000000001 { d.x_min = d.x_min - 0.5
        d.x_max = d.x_max + 0.5 }
    if d.y_max - d.y_min < 0.000000001 { d.y_min = d.y_min - 0.5
        d.y_max = d.y_max + 0.5 }
    $x_pad := (d.x_max - d.x_min) * 0.04
    for i in 0:c.series.len {
        if c.series_uses_bar_step(i) && c.series_is_visible(i) { x_pad = math.max(x_pad,c.bar_steps[i] * 0.55) }
    }
    y_pad := (d.y_max - d.y_min) * 0.08
    d.x_min = math.max(0.0 - 1000000000000.0,d.x_min - x_pad)
    d.x_max = math.min(1000000000000.0,d.x_max + x_pad)
    if !c.gauge() {
        if d.y_min != 0.0 { d.y_min = math.max(0.0 - 1000000000000.0,d.y_min - y_pad) }
        if d.y_max != 0.0 { d.y_max = math.min(1000000000000.0,d.y_max + y_pad) }
    }
    << d
}
pub fn (c $&Chart) set_series(series &[]ChartSeries) int {
    if c.control.closed { >> errors.new("widgets: chart is disposed") }
    chart_validate_series(series) or >>
    selection := c.selection()
    $old := map[string]int{}
    for i in 0:c.data.len { p := &c.data[i]
        if p.target_opacity > 0.0 { old[str(p.series) + ":" + str(p.id)] = i } }
    $next := []ChartDatum{}
    $used := map[string]bool{}
    $compatible := map[int]bool{}
    for s in series {
        previous := c.series_index(s.id)
        compatible[s.id] = previous >= 0 && chart_kinds_compatible(c.series[previous].kind,s.kind)
        for p in s.points {
        key := str(s.id) + ":" + str(p.id)
        $start_x := p.x
        $start_y := 0.0
        $start_low := p.low
        $start_high := p.low
        $start_close := p.low
        $start_size := 0.0
        $opacity := 0.0
        if compatible[s.id] && old.has(key) { before := c.data[old[key]]
            start_x = before.x
            start_y = before.y
            start_low = before.low
            start_high = before.high
            start_close = before.close
            start_size = before.size
            opacity = before.opacity }
        next.push(ChartDatum{series: s.id,id: p.id,x: start_x,y: start_y,low: start_low,high: start_high,close: start_close,size: start_size,
            opacity: opacity,from_x: start_x,from_y: start_y,from_low: start_low,from_high: start_high,from_close: start_close,from_size: start_size,
            from_opacity: opacity,target_x: p.x,target_y: p.y,target_low: p.low,target_high: p.high,target_close: p.close,target_size: p.size,
            target_opacity: 1.0,label: p.label + ""})
        used[key] = true
    } }
    // Keep exiting data for one transition, bounded by twice the public point limit.
    for p in c.data { key := str(p.series) + ":" + str(p.id)
        if compatible.get_or(p.series,false) && !used.has(key) && p.opacity > 0.001 {
            next.push(ChartDatum{series: p.series,id: p.id,x: p.x,y: p.y,low: p.low,high: p.high,close: p.close,size: p.size,opacity: p.opacity,
                from_x: p.x,from_y: p.y,from_low: p.low,from_high: p.high,from_close: p.close,from_size: p.size,from_opacity: p.opacity,
                target_x: p.x,target_y: p.y,target_low: p.low,target_high: p.high,target_close: p.close,target_size: p.size,target_opacity: 0.0,label: p.label + ""})
        }
        if next.len >= CHART_MAX_POINTS * 2 { <- }
    }
    $copies := []ChartSeries{}
    for s in series { copies.push(s.clone()) }
    c.bar_steps = []f64{}
    for s in series { $step := 1.0
        if s.points.len > 1 { step = 1000000000000.0
            for i in 1:s.points.len { distance := math.abs(s.points[i].x - s.points[i - 1].x)
                if distance > 0.000000001 { step = math.min(step,distance) } }
            if step == 1000000000000.0 { step = 1.0 } }
        c.bar_steps.push(step) }
    c.series = copies
    c.disabled_series = 0
    for i in 0:series.len { if !series[i].visible { c.disabled_series = c.disabled_series | (1 << i) } }
    c.data = next
    c.hot = -1
    c.selected = -1
    if selection.valid { for i in 0:c.data.len { p := &c.data[i]
        if p.series == selection.series_id && p.id == selection.point_id && p.target_opacity > 0.0 { c.selected = i } } }
    c.cancel_drag()
    if !c.fixed_domain { c.target_domain = c.auto_domain() }
    c.from_domain = chart_copy_domain(&c.domain)
    now := c.now
    reduced := c.reduced || c.motion.change.is_zero()
    timeline := $&c.animation
    timeline.play(now,reduced) or >>
    _ := c.apply_animation() or >>
    c.control.dirty = true
    << 0
}
pub fn (c $&Chart) set_domain(domain &ChartDomain) int {
    domain.validate() or >>
    c.fixed_domain = true
    c.domain = chart_copy_domain(domain)
    c.from_domain = chart_copy_domain(domain)
    c.target_domain = chart_copy_domain(domain)
    c.control.dirty = true
    << 0
}
pub fn (c $&Chart) use_auto_domain() { c.fixed_domain = false
    c.target_domain = c.auto_domain()
    c.domain = chart_copy_domain(&c.target_domain)
    c.from_domain = chart_copy_domain(&c.target_domain)
    c.control.dirty = true }
pub fn (c &Chart) viewport() ChartDomain { << chart_copy_domain(&c.viewport) }
pub fn (c $&Chart) set_viewport(view &ChartDomain) int {
    view.validate() or >>
    if view.x_min < 0.0 || view.x_max > 1.0 || view.y_min < 0.0 || view.y_max > 1.0 || view.x_max - view.x_min < 0.02 || view.y_max - view.y_min < 0.02 {
        >> errors.new("widgets: chart viewport must be a normalized range of at least two percent") }
    c.viewport = chart_copy_domain(view)
    c.hot = -1
    c.control.dirty = true
    << 0
}
pub fn (c $&Chart) reset_viewport() { c.viewport = ChartDomain{x_min: 0.0,x_max: 1.0,y_min: 0.0,y_max: 1.0}
    c.hot = -1
    c.control.dirty = true }
pub fn (c &Chart) visible_domain() ChartDomain {
    << ChartDomain{x_min: motion_lerp(c.domain.x_min,c.domain.x_max,c.viewport.x_min),x_max: motion_lerp(c.domain.x_min,c.domain.x_max,c.viewport.x_max),
        y_min: motion_lerp(c.domain.y_min,c.domain.y_max,c.viewport.y_min),y_max: motion_lerp(c.domain.y_min,c.domain.y_max,c.viewport.y_max)}
}
pub fn (c &Chart) data_position(x f64,y f64) ChartCoordinate {
    d := c.visible_domain()
    if c.horizontal() {
        << ChartCoordinate{x: c.plot.x + (y - d.y_min) / (d.y_max - d.y_min) * c.plot.width,
            y: c.plot.y + (x - d.x_min) / (d.x_max - d.x_min) * c.plot.height}
    }
    << ChartCoordinate{x: c.plot.x + (x - d.x_min) / (d.x_max - d.x_min) * c.plot.width,
        y: c.plot.y + (d.y_max - y) / (d.y_max - d.y_min) * c.plot.height}
}
pub fn (c &Chart) data_at(x f64,y f64) ChartCoordinate {
    d := c.visible_domain()
    if c.horizontal() {
        << ChartCoordinate{x: d.x_min + (y - c.plot.y) / math.max(1.0,c.plot.height) * (d.x_max - d.x_min),
            y: d.y_min + (x - c.plot.x) / math.max(1.0,c.plot.width) * (d.y_max - d.y_min)}
    }
    << ChartCoordinate{x: d.x_min + (x - c.plot.x) / math.max(1.0,c.plot.width) * (d.x_max - d.x_min),
        y: d.y_max - (y - c.plot.y) / math.max(1.0,c.plot.height) * (d.y_max - d.y_min)}
}
fn (c $&Chart) apply_animation() bool {
    t := c.animation.value()
    $changed := false
    for i in 0:c.data.len { $p := c.data[i]
        x := motion_lerp(p.from_x,p.target_x,t)
        y := motion_lerp(p.from_y,p.target_y,t)
        low := motion_lerp(p.from_low,p.target_low,t)
        high := motion_lerp(p.from_high,p.target_high,t)
        close := motion_lerp(p.from_close,p.target_close,t)
        size := motion_lerp(p.from_size,p.target_size,t)
        opacity := motion_lerp(p.from_opacity,p.target_opacity,t)
        if x != p.x || y != p.y || low != p.low || high != p.high || close != p.close || size != p.size || opacity != p.opacity { changed = true }
        p.x = x
        p.y = y
        p.low = low
        p.high = high
        p.close = close
        p.size = size
        p.opacity = opacity
        c.data[i] = p }
    d := ChartDomain{x_min: motion_lerp(c.from_domain.x_min,c.target_domain.x_min,t),x_max: motion_lerp(c.from_domain.x_max,c.target_domain.x_max,t),
        y_min: motion_lerp(c.from_domain.y_min,c.target_domain.y_min,t),y_max: motion_lerp(c.from_domain.y_max,c.target_domain.y_max,t)}
    if d.x_min != c.domain.x_min || d.x_max != c.domain.x_max || d.y_min != c.domain.y_min || d.y_max != c.domain.y_max { changed = true }
    c.domain = d
    << changed
}
pub fn (c $&Chart) tick(styles &Styles,now time.Instant,reduced bool) bool {
    c.now = now
    c.reduced = reduced
    c.apply_styles(styles) or >>
    disabled := !c.control.enabled
    timeline := $&c.animation
    if timeline.stamp.is_zero() && timeline.is_running() { timeline.stamp = now }
    _ := timeline.advance(now,reduced || disabled) or >>
    $changed := c.apply_animation() or >>
    duration := c.motion.hover
    emphasis := $&c.emphasis
    before := emphasis.value()
    emphasis.retarget(1.0,now,duration,reduced) or >>
    _ := emphasis.advance(now) or >>
    if before != emphasis.value() { changed = true }
    if changed { c.control.dirty = true }
    << changed
}
pub fn (c &Chart) next_tick(now time.Instant) time.Instant {
    if c.control.closed || !c.control.is_enabled() { << time.zero_instant() }
    if c.emphasis.is_animating() { << overlay_next_tick(true,now) or >> }
    << c.animation.next_tick(now) or >>
}
pub fn (c $&Chart) pause_animation() int { now := c.now
    timeline := $&c.animation
    timeline.pause(now) or >>
    _ := c.apply_animation() or >>
    c.control.dirty = true
    << 0 }
pub fn (c $&Chart) resume_animation() { now := c.now
    timeline := $&c.animation
    timeline.resume(now) }
pub fn (c $&Chart) seek_animation(progress f64) int { now := c.now
    timeline := $&c.animation
    timeline.seek(progress,now) or >>
    _ := c.apply_animation() or >>
    c.control.dirty = true
    << 0 }
pub fn (c &Chart) animation_progress() f64 { << c.animation.progress() }
fn (c $&Chart) cancel_drag() { c.dragging = false
    c.armed = -1
    c.moved = false }
pub fn (c $&Chart) cancel() { c.cancel_drag()
    c.hot = -1
    item := $&c.control
    item.cancel() }
pub fn (c $&Chart) set_focus(value bool) { item := $&c.control
    item.set_focus(value)
    if !value { c.cancel_drag()
        c.hot = -1 } }
pub fn (c $&Chart) set_enabled(value bool) { item := $&c.control
    item.set_enabled(value)
    if !value { c.cancel() } }
pub fn (c $&Chart) set_read_only(value bool) { item := $&c.control
    item.set_read_only(value)
    c.cancel_drag() }
pub fn (c $&Chart) dispose() {
    if c.control.closed { << }
    cache := $&c.labels
    cache.dispose()
    c.cancel()
    c.control.closed = true
}
