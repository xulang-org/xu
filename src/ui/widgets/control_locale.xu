@ui/widgets
#strconv
#errors
#ui/layout
#time

pub fn (picker $&DatePicker) set_locale(locale &Locale) int {
    locale.validate() or >>
    picker.locale = locale.clone()
    picker.control.dirty = true
    << 0
}
pub fn (picker $&TimePicker) set_locale(locale &Locale) int {
    locale.validate() or >>
    picker.locale = locale.clone()
    if !picker.custom_clock { picker.twelve_hour = locale.twelve_hour() }
    picker.digits = 0
    picker.armed = 0
    picker.control.dirty = true
    << 0
}
pub fn (table $&Table) set_locale(locale &Locale) int {
    locale.validate() or >>
    table.locale = locale.clone()
    table.rows.dirty = true
    << 0
}
pub fn (page $&Pagination) set_locale(locale &Locale) int {
    locale.validate() or >>
    page.locale = locale.clone()
    page.control.dirty = true
    << 0
}
pub fn (picker $&ColorPicker) set_locale(locale &Locale) int {
    locale.validate() or >>
    picker.locale = locale.clone()
    picker.control.dirty = true
    << 0
}
pub fn (slider $&Slider) set_locale(locale &Locale) int {
    locale.validate() or >>
    slider.locale = locale.pack_numbers()
    slider.dirty = true
    << 0
}
pub fn (stepper $&Stepper) set_locale(locale &Locale) int {
    locale.validate() or >>
    stepper.locale = locale.clone()
    stepper.dirty = true
    << 0
}
pub fn (field $&Field) set_locale(locale &Locale) int {
    locale.validate() or >>
    field.locale = locale.clone()
    field.mark_dirty(true)
    << 0
}
pub fn (task $&TaskButton) set_locale(locale &Locale) int {
    locale.validate() or >>
    task.locale = locale.clone()
    if !task.custom_labels { task.apply_locale_labels() or >> }
    task.control.dirty = true
    << 0
}
fn (task $&TaskButton) apply_locale_labels() int {
    if task.control.closed { >> errors.new("widgets: task is disposed") }
    locale := task.locale.clone()
    task.running_label = locale.text(TEXT_TASK_WORKING) or >>
    task.success_label = locale.text(TEXT_TASK_DONE) or >>
    task.error_label = locale.text(TEXT_TASK_RETRY) or >>
    task.cancelled_label = locale.text(TEXT_TASK_RETRY) or >>
    << 0
}
pub fn (task $&TaskButton) use_locale_labels() int { task.custom_labels = false
    task.apply_locale_labels() or >>
    task.control.dirty = true
    << 0 }
pub fn (task &TaskButton) label_text() string { << task.display_text() or >> }
pub fn (multi $&MultiSelect) set_locale(locale &Locale) int {
    locale.validate() or >>
    multi.choices.locale = locale.clone()
    multi.control.dirty = true
    multi.choices.dirty = true
    << 0
}
pub fn (combo $&ComboBox) set_locale(locale &Locale) int {
    locale.validate() or >>
    combo.choices.locale = locale.clone()
    combo.editor.dirty = true
    combo.choices.dirty = true
    << 0
}
pub fn (multi &MultiSelect) selection_text() string {
    count := multi.values().len
    if count == 0 { << multi.choices.locale.text(TEXT_CHOOSE_OPTIONS) or >> }
    $key := TEXT_SELECTED_COUNT
    if count == 1 { key = TEXT_SELECTED_ONE }
    << multi.choices.locale.count_text(key,count) or >>
}
pub fn (stepper &Stepper) value_text() string {
    value := strconv.format_float(stepper.value(),103,-1) or >>
    << stepper.locale.number(value,false)
}
pub fn (picker $&TimePicker) use_locale_clock() { picker.custom_clock = false
    picker.twelve_hour = picker.locale.twelve_hour()
    picker.digits = 0
    picker.armed = 0
    picker.control.dirty = true }
pub fn (picker &DatePicker) display_text() string {
    if !picker.has_value { << picker.locale.text(TEXT_DATE_PLACEHOLDER) or >> }
    << picker.locale.date_text(picker.val) or >>
}
