@ui/widgets
#errors

pub fn (s $&Screen) set_candidate_open(id int,open bool) int {
    n := s.node(id) or >>
    if n.kind == SCREEN_SELECT { $item := s.take_basic_selects(id)
        item.set_open(open)
        s.basics.selects[id] = item }
    else if n.kind == SCREEN_COMBO { owner := $&s.controls
        items := $&owner.combos
        $item := items.take(id)
        item.set_open(open)
        items[id] = item }
    else if n.kind == SCREEN_MULTI { owner := $&s.controls
        items := $&owner.multis
        $item := items.take(id)
        item.set_open(open)
        items[id] = item }
    else if n.kind == SCREEN_DATE { owner := $&s.controls
        items := $&owner.dates
        $item := items.take(id)
        item.set_open(open)
        items[id] = item }
    else { >> errors.new("widgets: control has no candidate popup") }
    s.dirty = true
    << 0
}
