@ui/widgets
#errors

pub fn (s &mut Screen) set_candidate_open(id int,open bool) int {
    n := s.node(id) or >>
    if n.kind == SCREEN_SELECT { mut item := s.take_basic_selects(id)
        item.set_open(open)
        s.basics.selects[id] = item }
    else if n.kind == SCREEN_COMBO { owner := mut &s.controls
        items := mut &owner.combos
        mut item := items.take(id)
        item.set_open(open)
        items[id] = item }
    else if n.kind == SCREEN_MULTI { owner := mut &s.controls
        items := mut &owner.multis
        mut item := items.take(id)
        item.set_open(open)
        items[id] = item }
    else if n.kind == SCREEN_DATE { owner := mut &s.controls
        items := mut &owner.dates
        mut item := items.take(id)
        item.set_open(open)
        items[id] = item }
    else { >> errors.new("widgets: control has no candidate popup") }
    s.dirty = true
    << 0
}
