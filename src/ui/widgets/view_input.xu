    if kind < route_input || kind > route_cancel { >> errors.new("widgets: invalid route kind") }
    if kind == route_focus { lb.set_focus(true) }
    else if kind == route_blur || kind == route_cancel { lb.cancel() }
    else { << lb.input(input) }
    << no_action(lb.id,lb.dirty)
