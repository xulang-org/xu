fn (view $&View) retire_input(id int) {
    if id <= 0 { << }
    if view.focused != id && view.hovered != id && view.captured != id { << }
    $found := false
    for pending in view.pending_cancel { if pending == id { found = true } }
    if !found { view.pending_cancel.push(id) }
    if view.focused == id { view.focused = 0 }
    if view.hovered == id { view.hovered = 0 }
    if view.captured == id { view.captured = 0 }
}
// Keep this registration in sync with the model's enabled state. Focus order is
// tree order, and excludes hidden, fully clipped, zero-sized and disabled nodes.
pub fn (view $&View) set_input(id int,enabled bool,focusable bool) int {
    view.check() or >>
    index := view.node_index(id) or >>
    view.nodes[index].interactive = enabled
    view.nodes[index].focusable = enabled && focusable
    if !enabled || (!focusable && view.focused == id) { view.retire_input(id) }
    << 0
}
// Editors retain real drag coordinates outside their bounds. Buttons keep the
// clipped-hit policy so release through an occluder cannot activate them.
pub fn (view $&View) set_capture_outside(id int,enabled bool) int {
    view.check() or >>
    index := view.node_index(id) or >>
    view.nodes[index].capture_outside = enabled
    << 0
}
pub fn (view &View) focused() int { << view.focused }
pub fn (view &View) captured() int { << view.captured }
pub fn (view &View) pointer_cursor() int { << view.pointer_cursor }
pub fn (view $&View) set_cursor(id int,cursor int) int {
    view.check() or >>
    if cursor < ui.CURSOR_DEFAULT || cursor > ui.CURSOR_RESIZE_VERTICAL { >> errors.new("widgets: invalid pointer cursor") }
    index := view.node_index(id) or >>
    view.nodes[index].cursor = cursor
    << 0
}
// Cursor commands are scoped to this canvas generation and deduplicated.
pub fn (view $&View) set_pointer_cursor(cursor int) int {
    view.check() or >>
    if cursor < ui.CURSOR_DEFAULT || cursor > ui.CURSOR_RESIZE_VERTICAL { >> errors.new("widgets: invalid pointer cursor") }
    if view.pointer_cursor == cursor { << 0 }
    window := ui.Window{id: view.identity.window_id,generation: view.identity.generation,title: "",width: 0,height: 0,
        content_kind: ui.CONTENT_DRAW,content_backend_id: view.identity.canvas_id,closed: 0}
    if cursor == ui.CURSOR_DEFAULT && !window.is_open() { view.pointer_cursor = cursor
        << 0 }
    window.content_command("cursor\t" + str(cursor)) or >>
    view.pointer_cursor = cursor
    << 0
}
fn (view &View) input_ready(id int) bool {
    index := view.node_index(id) or (err) { << false }
    if !view.nodes[index].interactive { << false }
    visible := view.tree.visible(id) or (err) { << false }
    if !visible { << false }
    $bounds := view.tree.global_bounds(id) or (err) { << false }
    $parent := view.tree.parent(id) or (err) { << false }
    while parent > 0 {
        style := view.tree.style(parent) or (err) { << false }
        if style.clip {
            clip := view.tree.global_bounds(parent) or (err) { << false }
            bounds = layout.intersect(&bounds,&clip) or (err) { << false }
        }
        parent = view.tree.parent(parent) or (err) { << false }
    }
    << bounds.width > 0.0 && bounds.height > 0.0
}
fn (view &View) input_target(x f64,y f64) int {
    $id := view.tree.hit_test(x,y) or >>
    while id > 0 {
        if view.input_ready(id) { << id }
        id = view.tree.parent(id) or >>
    }
    << 0
}
fn cancel_event(identity &ui.CanvasEvent) ui.InputEvent {
    << ui.InputEvent{kind: ui.EV_POINTER_CANCEL,window_id: identity.window_id,canvas_id: identity.canvas_id,generation: identity.generation,
                    x: 0.0,y: 0.0,dx: 0.0,dy: 0.0,button: 0,buttons: 0,modifiers: 0,key: 0,scan: 0,repeat: 0,click_count: 0,time_ns: 0}
}
fn deliver#H:InputHandler(view $&View,id int,kind int,input &ui.InputEvent,handler $&H) Action {
    action := handler.input(id,kind,input) or >>
    if action.id != id { >> errors.new("widgets: handler returned an action for another node") }
    if action.needs_paint && view.tree.contains(id) { view.mark_paint(id) or >> }
    << action
}
// Flush removed/disabled targets using their old, never-reused IDs. The model
// handler may still clear retired control state; it must ignore unknown IDs.
pub fn flush_input#H:InputHandler(view $&View,handler $&H) int {
    input := cancel_event(&view.identity)
    for id in view.pending_cancel { _ := deliver(view,id,ROUTE_CANCEL,&input,handler) or >> }
    view.pending_cancel = []int{}
    << 0
}
pub fn cancel_input#H:InputHandler(view $&View,handler $&H) int {
    view.retire_input(view.focused)
    view.retire_input(view.hovered)
    view.retire_input(view.captured)
    view.set_pointer_cursor(ui.CURSOR_DEFAULT) or >>
    << flush_input(view,handler) or >>
}
fn focus_target#H:InputHandler(view $&View,id int,input &ui.InputEvent,handler $&H) int {
    if view.focused == id { << 0 }
    previous := view.focused
    view.focused = id
    if previous > 0 { _ := deliver(view,previous,ROUTE_BLUR,input,handler) or >> }
    if id > 0 { _ := deliver(view,id,ROUTE_FOCUS,input,handler) or >> }
    << 0
}
fn (view &View) focus_order(id int,result $&[]int) int {
    index := view.node_index(id) or >>
    if view.nodes[index].focusable && view.input_ready(id) {
        if result.len >= 512 { >> errors.new("widgets: focus target capacity exceeded") }
        result.push(id)
    }
    children := view.tree.children(id) or >>
    for child in children { view.focus_order(child,result) or >> }
    << 0
}
// Returns semantic/consumed actions. Paint invalidation, hover, focus and primary
// pointer capture are maintained here; callbacks cannot mutate the View while
// it is borrowed. Apply effects on other model nodes after dispatch returns.
pub fn dispatch#H:InputHandler(view $&View,input &ui.InputEvent,handler $&H) []Action {
    $actions := []Action{}
    if !belongs(&view.identity,input) { << actions }
    flush_input(view,handler) or >>
    if view.closed { << actions }
    if input.kind == ui.EV_POINTER_CANCEL { cancel_input(view,handler) or >>
        << actions }
    if view.tree.needs_layout() { >> errors.new("widgets: dispatch requires current layout") }
    if view.focused > 0 && !view.input_ready(view.focused) { view.retire_input(view.focused) }
    if view.captured > 0 && !view.input_ready(view.captured) { view.retire_input(view.captured) }
    if view.hovered > 0 && !view.input_ready(view.hovered) { view.retire_input(view.hovered) }
    flush_input(view,handler) or >>
    if input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_TAB {
        $order := []int{}
        view.focus_order(view.root,$&order) or >>
        if order.len == 0 { << actions }
        $index := -1
        for i in 0:order.len { if order[i] == view.focused { index = i } }
        if (input.modifiers & ui.MOD_SHIFT) != 0 {
            if index <= 0 { index = order.len - 1 }
            else { index = index - 1 }
        } else { index = index + 1
            if index >= order.len { index = 0 } }
        target := order[index]
        if view.captured > 0 { view.retire_input(view.captured)
            flush_input(view,handler) or >> }
        focus_target(view,target,input,handler) or >>
        actions.push(Action{kind: ACTION_NONE,id: target,needs_paint: true,request_focus: true,consumed: true,value: 0.0})
        << actions
    }
    if input.kind == ui.EV_KEY_DOWN || input.kind == ui.EV_KEY_UP {
        if view.focused > 0 { action := deliver(view,view.focused,ROUTE_INPUT,input,handler) or >>
            actions.push(action) }
        << actions
    }
    $target := view.input_target(input.x,input.y) or >>
    if input.kind == ui.EV_POINTER_LEAVE { target = 0 }
    $cursor_owner := target
    if view.captured > 0 && input.kind != ui.EV_POINTER_LEAVE { cursor_owner = view.captured }
    $cursor := ui.CURSOR_DEFAULT
    if cursor_owner > 0 { index := view.node_index(cursor_owner) or >>
        cursor = view.nodes[index].cursor }
    view.set_pointer_cursor(cursor) or >>
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if view.captured > 0 { view.retire_input(view.captured)
            flush_input(view,handler) or >> }
        $focus := 0
        if target > 0 { index := view.node_index(target) or >>
            if view.nodes[index].focusable { focus = target } }
        focus_target(view,focus,input,handler) or >>
        view.captured = target
    }
    $hot := target
    if view.captured > 0 && hot != view.captured { hot = 0 }
    if view.hovered != hot {
        if view.hovered > 0 {
            $leave := view.local_input(view.hovered,input) or >>
            leave.kind = ui.EV_POINTER_LEAVE
            _ := deliver(view,view.hovered,ROUTE_INPUT,&leave,handler) or >>
        }
        view.hovered = hot
    }
    $owner := target
    if view.captured > 0 && input.kind != ui.EV_POINTER_SCROLL { owner = view.captured }
    while owner > 0 {
        $local := view.local_input(owner,input) or >>
        index := view.node_index(owner) or >>
        if owner == view.captured && target != owner && !view.nodes[index].capture_outside {
            // A captured button must not activate through an ancestor clip or
            // an overlapping target merely because its own rectangle contains.
            local.x = -1000000000.0
            local.y = -1000000000.0
        }
        action := deliver(view,owner,ROUTE_INPUT,&local,handler) or >>
        actions.push(action)
        if input.kind != ui.EV_POINTER_SCROLL || action.consumed { <- }
        owner = view.tree.parent(owner) or >>
        while owner > 0 && !view.input_ready(owner) { owner = view.tree.parent(owner) or >> }
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        view.captured = 0
        $released_cursor := ui.CURSOR_DEFAULT
        if target > 0 { index := view.node_index(target) or >>
            released_cursor = view.nodes[index].cursor }
        view.set_pointer_cursor(released_cursor) or >>
    }
    << actions
}
pub fn dispatch_event#H:InputHandler(view $&View,event &ui.Event,handler $&H) []Action {
    if event.window_id != view.identity.window_id { << []Action{} }
    $close := event.kind == ui.EV_CLOSED
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        close = identity.canvas_id == view.identity.canvas_id && identity.generation == view.identity.generation
    }
    if close || event.kind == ui.EV_BLURRED {
        cancel_input(view,handler) or >>
        if close { view.dispose() }
        << []Action{}
    }
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << dispatch(view,&input,handler) or >> }
    << []Action{}
}
