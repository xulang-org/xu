@ui/widgets

#ui
#ui/layout
#errors

pub const ROUTE_INPUT = 0
pub const ROUTE_FOCUS = 1
pub const ROUTE_BLUR = 2
pub const ROUTE_CANCEL = 3
pub struct@ InputHandler {
    fn input(int,int,&ui.InputEvent) Action
}
pub fn (button $&Button) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if kind == ROUTE_FOCUS { button.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { button.cancel() }
    else { << button.input(input) }
    << no_action(button.id,button.dirty)
}
pub fn (checkbox $&Checkbox) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if kind == ROUTE_FOCUS { checkbox.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { control := $&checkbox.control
        control.cancel() }
    else { << checkbox.input(input) }
    << no_action(checkbox.control.id,checkbox.needs_paint())
}
pub fn (scroll $&Scroll) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if kind == ROUTE_FOCUS { scroll.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { scroll.set_focus(false) }
    else { << scroll.input(input) }
    << no_action(scroll.id,scroll.dirty)
}
