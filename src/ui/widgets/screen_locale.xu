@ui/widgets
#errors

// No process-global language: each Screen and explicit control override own a copy.
pub fn (s &Screen) locale() Locale { << s.locale.clone() }
pub fn (s &mut Screen) control_locale(id int) Locale {
    _ := s.node(id) or >>
    if !s.locale_overrides.has(id) { << s.locale.clone() }
    items := mut &s.locale_overrides
    item := items.take(id)
    result := item.clone()
    items[id] = item
    << result
}
pub fn (s &mut Screen) set_locale(locale &Locale) int {
    s.check_screen() or >>
    locale.validate() or >>
    s.locale = locale.clone()
    for node in s.nodes { if node.kind >= 0 && !s.locale_overrides.has(node.id) { s.apply_control_locale(node.id,locale) or >> } }
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_control_locale(id int,locale &Locale) int {
    s.check_screen() or >>
    _ := s.node(id) or >>
    locale.validate() or >>
    s.apply_control_locale(id,locale) or >>
    s.locale_overrides[id] = locale.clone()
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) clear_control_locale(id int) int {
    _ := s.node(id) or >>
    if s.locale_overrides.has(id) { items := mut &s.locale_overrides
        _ := items.take(id) }
    locale := s.locale.clone()
    s.apply_control_locale(id,&locale) or >>
    s.dirty = true
    << 0
}
fn (s &mut Screen) apply_current_locale(id int) int {
    locale := s.control_locale(id) or >>
    << s.apply_control_locale(id,&locale) or >>
}
fn (s &mut Screen) apply_control_locale(id int,locale &Locale) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_RANGE_SLIDER { << s.range_locale(id,locale) or >> }
    if node.kind == SCREEN_CHART { << s.chart_locale(id,locale) or >> }
    if node.kind == SCREEN_DATE {
        owner := mut &s.controls
        items := mut &owner.dates
        mut item := items.take(id)
        message := locale_apply_dates(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        owner := mut &s.controls
        items := mut &owner.clocks
        mut item := items.take(id)
        message := locale_apply_clocks(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_TASK {
        owner := mut &s.controls
        items := mut &owner.tasks
        mut item := items.take(id)
        message := locale_apply_tasks(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_COMBO {
        owner := mut &s.controls
        items := mut &owner.combos
        mut item := items.take(id)
        message := locale_apply_combos(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        owner := mut &s.controls
        items := mut &owner.multis
        mut item := items.take(id)
        message := locale_apply_multis(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_TABLE {
        owner := mut &s.controls
        items := mut &owner.tables
        mut item := items.take(id)
        message := locale_apply_tables(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        owner := mut &s.controls
        items := mut &owner.pages
        mut item := items.take(id)
        message := locale_apply_pages(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_COLOR {
        owner := mut &s.controls
        items := mut &owner.colors
        mut item := items.take(id)
        message := locale_apply_colors(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_FIELD {
        owner := mut &s.controls
        items := mut &owner.fields
        mut item := items.take(id)
        message := locale_apply_fields(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_SLIDER {
        owner := mut &s.basics
        items := mut &owner.sliders
        mut item := items.take(id)
        message := locale_apply_sliders(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_STEPPER {
        owner := mut &s.basics
        items := mut &owner.steppers
        mut item := items.take(id)
        message := locale_apply_steppers(mut &item,locale)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_SELECT {
        item := s.take_basic_selects(id)
        empty := item.count() == 0
        s.basics.selects[id] = item
        if empty { text := locale.text(TEXT_NO_OPTIONS) or >>
            s.set_option_text(id,0,text) or >> }
    }
    if node.kind == SCREEN_BADGE && s.basics.badge_counts.has(id) {
        owner := mut &s.basics
        items := mut &owner.badge_counts
        record := items.take(id)
        count := record.count
        maximum := record.maximum
        items[id] = record
        text := locale.badge_count(count,maximum) or >>
        s.set_option_text(id,0,text) or >>
    }
    s.dirty = true
    << 0
}
fn locale_apply_dates(item &mut DatePicker,locale &Locale) string {
    item.set_locale(locale) or (err) { << err.msg() }
    << ""
}
fn locale_apply_clocks(item &mut TimePicker,locale &Locale) string {
    item.set_locale(locale) or (err) { << err.msg() }
    << ""
}
