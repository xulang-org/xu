@ui/widgets
#errors

// No process-global language: each Screen, subtree, and explicit control override own a copy.
pub fn (s &Screen) locale() Locale { << s.locale.clone() }
pub fn (s $&Screen) control_locale(id int) Locale {
    _ := s.node(id) >>>
    if s.locale_overrides.has(id) {
        item := &s.locale_overrides[id]
        << item.clone()
    }
    if s.composition.subtree_locale_count > 0 {
        $cur := id
        $budget := s.nodes.len + 1
        while cur > 0 && cur <= s.nodes.len && budget > 0 {
            if s.composition.subtree_locales.has(cur) {
                loc := &s.composition.subtree_locales[cur]
                << loc.clone()
            }
            n := s.nodes[cur - 1]
            if n.kind < 0 { <- }
            if n.parent > 0 { cur = n.parent }
            else if screen_is_overlay(n.kind) {
                anc := s.overlays.anchors.get_or(cur,0)
                if anc == cur { cur = 0 } else { cur = anc }
            } else { cur = 0 }
            budget -= 1
        }
    }
    << s.locale.clone()
}
fn (s $&Screen) refresh_subtree_locale(id int) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    n := s.nodes[id - 1]
    if n.kind < 0 { << 0 }
    if !s.locale_overrides.has(id) {
        s.apply_current_locale(id) >>>
    }
    child_count := s.child_count_of(id)
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id {
            s.refresh_subtree_locale(cid) >>>
        }
    }
    << 0
}
pub fn (s $&Screen) set_subtree_locale(id int,locale &Locale) int {
    s.check_screen() >>>
    _ := s.node(id) >>>
    locale.validate() >>>
    had := s.composition.subtree_locales.has(id)
    comp := $&s.composition
    locs := $&comp.subtree_locales
    locs[id] = locale.clone()
    if !had { comp.subtree_locale_count = comp.subtree_locale_count + 1 }
    s.refresh_subtree_locale(id) >>>
    s.mark_layout_dirty()
    << 0
}
pub fn (s $&Screen) clear_subtree_locale(id int) int {
    _ := s.node(id) >>>
    if s.composition.subtree_locales.has(id) {
        comp := $&s.composition
        locs := $&comp.subtree_locales
        locs.delete(id)
        if comp.subtree_locale_count > 0 { comp.subtree_locale_count = comp.subtree_locale_count - 1 }
        s.refresh_subtree_locale(id) >>>
        s.mark_layout_dirty()
    }
    << 0
}
pub fn (s $&Screen) set_locale(locale &Locale) int {
    s.check_screen() >>>
    locale.validate() >>>
    s.locale = locale.clone()
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid > 0 && nid <= s.nodes.len && s.nodes[nid - 1].kind >= 0 && !s.locale_overrides.has(nid) {
            s.apply_current_locale(nid) >>>
        }
    }
    s.mark_layout_dirty()
    << 0
}
pub fn (s $&Screen) set_control_locale(id int,locale &Locale) int {
    s.check_screen() >>>
    _ := s.node(id) >>>
    locale.validate() >>>
    s.apply_control_locale(id,locale) >>>
    s.locale_overrides[id] = locale.clone()
    s.dirty = true
    << 0
}
pub fn (s $&Screen) clear_control_locale(id int) int {
    _ := s.node(id) >>>
    if s.locale_overrides.has(id) { items := $&s.locale_overrides
        _ := items.take(id) }
    locale := s.locale.clone()
    s.apply_control_locale(id,&locale) >>>
    s.dirty = true
    << 0
}
fn (s $&Screen) apply_current_locale(id int) int {
    locale := s.control_locale(id) >>>
    << s.apply_control_locale(id,&locale) >>>
}
fn (s $&Screen) apply_control_locale(id int,locale &Locale) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_RANGE_SLIDER { << s.range_locale(id,locale) >>> }
    if node.kind == SCREEN_CHART { << s.chart_locale(id,locale) >>> }
    if node.kind == SCREEN_DATE {
        owner := $&s.controls
        items := $&owner.dates
        $item := items.take(id)
        message := locale_apply_dates($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        owner := $&s.controls
        items := $&owner.clocks
        $item := items.take(id)
        message := locale_apply_clocks($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_TASK {
        owner := $&s.controls
        items := $&owner.tasks
        $item := items.take(id)
        message := locale_apply_tasks($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_COMBO {
        owner := $&s.controls
        items := $&owner.combos
        $item := items.take(id)
        message := locale_apply_combos($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        owner := $&s.controls
        items := $&owner.multis
        $item := items.take(id)
        message := locale_apply_multis($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_TABLE {
        owner := $&s.controls
        items := $&owner.tables
        $item := items.take(id)
        message := locale_apply_tables($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        owner := $&s.controls
        items := $&owner.pages
        $item := items.take(id)
        message := locale_apply_pages($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_COLOR {
        owner := $&s.controls
        items := $&owner.colors
        $item := items.take(id)
        message := locale_apply_colors($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_FIELD {
        owner := $&s.controls
        items := $&owner.fields
        $item := items.take(id)
        message := locale_apply_fields($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_SLIDER {
        owner := $&s.basics
        items := $&owner.sliders
        $item := items.take(id)
        message := locale_apply_sliders($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_STEPPER {
        owner := $&s.basics
        items := $&owner.steppers
        $item := items.take(id)
        message := locale_apply_steppers($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        << 0
    }
    if node.kind == SCREEN_SELECT {
        item := s.take_basic_selects(id)
        empty := item.count() == 0
        s.basics.selects[id] = item
        if empty { text := locale.text(TEXT_NO_OPTIONS) >>>
            s.set_option_text(id,0,text) >>> }
    }
    if node.kind == SCREEN_BADGE && s.basics.badge_counts.has(id) {
        owner := $&s.basics
        items := $&owner.badge_counts
        record := items.take(id)
        count := record.count
        maximum := record.maximum
        items[id] = record
        text := locale.badge_count(count,maximum) >>>
        s.set_option_text(id,0,text) >>>
    }
    if node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >>> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        message := locale_apply_editors($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
    }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >>> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        message := locale_apply_trees($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
    }
    if node.kind == SCREEN_LIST {
        owner := $&s.basics
        items := $&owner.lists
        if !items.has(id) { >>> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        message := locale_apply_lists($&item,locale)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
    }
    if screen_is_text_kind(node.kind) { s.selectable_text_locale(id,locale) >>> }
    if node.kind == SCREEN_POPOVER {
        $item := s.screen_take_popover(id) >>>
        message := locale_apply_popover($&item,locale)
        s.screen_put_popover(id,item)
        if message.len > 0 { >>> errors.new(message) }
    }
    if node.kind == SCREEN_TOOLTIP {
        $item := s.screen_take_tooltip(id) >>>
        message := locale_apply_tooltip($&item,locale)
        s.screen_put_tooltip(id,item)
        if message.len > 0 { >>> errors.new(message) }
    }
    if node.kind == SCREEN_TOAST {
        $item := s.screen_take_toast(id) >>>
        message := locale_apply_toast($&item,locale)
        s.screen_put_toast(id,item)
        if message.len > 0 { >>> errors.new(message) }
    }
    if node.kind == SCREEN_MODAL {
        $item := s.screen_take_modal(id) >>>
        message := locale_apply_modal($&item,locale)
        s.screen_put_modal(id,item)
        if message.len > 0 { >>> errors.new(message) }
        s.selectable_text_locale(id,locale) >>>
        s.selectable_text_locale(-id,locale) >>>
    }
    s.dirty = true
    << 0
}
fn locale_apply_dates(item $&DatePicker,locale &Locale) string {
    item.set_locale(locale) >>> (err) { << err.msg() }
    << ""
}
fn locale_apply_clocks(item $&TimePicker,locale &Locale) string {
    item.set_locale(locale) >>> (err) { << err.msg() }
    << ""
}
