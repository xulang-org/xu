    << ""
}
fn locale_apply_sliders(item $&Slider,locale &Locale) string {
    item.set_locale(locale) or (err) { << err.msg() }
    << ""
}
fn locale_apply_steppers(item $&Stepper,locale &Locale) string {
    item.set_locale(locale) or (err) { << err.msg() }
    << ""
}
