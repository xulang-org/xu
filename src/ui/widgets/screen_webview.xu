@ui/widgets

#ui
#ui/draw
#ui/layout
#math
#errors

pub const ACTION_WEB_LOADING = 30
pub const ACTION_WEB_LOADED = 31
pub const ACTION_WEB_FAILED = 32
pub const ACTION_WEB_PROGRESS = 33

struct ScreenWebView {
    native ui.NativeView
    radius f64
    loaded bool
    loading bool
    failed bool
    progress f64
    focused bool
    suspended bool
    closed bool
}
fn copy_web_state(item &ScreenWebView) ScreenWebView {
    << ScreenWebView{native: item.native,radius: item.radius,loaded: item.loaded,loading: item.loading,failed: item.failed,
        progress: item.progress,focused: item.focused,suspended: item.suspended,closed: item.closed}
}
fn (s $&Screen) web_state(id int) ScreenWebView {
    if !s.webviews.has(id) { >> errors.new("widgets: WebView state is unavailable") }
    items := $&s.webviews
    item := items.take(id)
    result := copy_web_state(&item)
    items[id] = item
    << result
}
// Native WebView occupies a real child surface inside this draw window.
// Its page owns DOM input; Ctrl+Tab returns to Screen's focus traversal.
pub fn (s $&Screen) webview() int {
    id := s.add_node(SCREEN_WEBVIEW,true,ui.CURSOR_DEFAULT) or >>
    view := ui.native_view(&s.identity,ui.CONTENT_WEBVIEW) or (err) { s.abandon_node(id)
        >> err }
    s.webviews[id] = ScreenWebView{native: view,radius: 8.0,loaded: false,loading: false,failed: false,progress: 0.0,focused: false,suspended: false,closed: false}
    s.texts[id - 1] = "Web content"
    s.labels[id * 2] = text_cache(&s.context)
    s.apply_current_locale(id) or >>
    << id
}
fn (s $&Screen) check_webview(id int) int {
    n := s.node(id) or >>
    item := s.web_state(id) or >>
    if n.kind != SCREEN_WEBVIEW || item.closed { >> errors.new("widgets: expected a live WebView component") }
    << 0
}
// Bind this handle with webview.bind_native() for the full WebView API.
pub fn (s $&Screen) webview_native(id int) ui.NativeView {
    s.check_webview(id) or >>
    item := s.web_state(id) or >>
    << item.native
}
pub fn (s $&Screen) load_web_html(id int,html string) int {
    s.check_webview(id) or >>
    item := s.web_state(id) or >>
    native := item.native
    $body := html + ""
    if body.len == 0 { body = "<!doctype html><html></html>" }
    native.write_slot("xu_ui_page.html",body) or >>
    native.write_slot("xu_ui_page.url","") or >>
    s.web_loading(id) or >>
    << 0
}
pub fn (s $&Screen) load_web_url(id int,url string) int {
    s.check_webview(id) or >>
    item := s.web_state(id) or >>
    native := item.native
    native.write_slot("xu_ui_page.html","") or >>
    native.write_slot("xu_ui_page.url",url) or >>
    s.web_loading(id) or >>
    << 0
}
fn (s $&Screen) web_loading(id int) int {
    $item := s.web_state(id) or >>
    item.loading = true
    item.failed = false
    item.progress = 0.0
    s.webviews[id] = item
    s.texts[id - 1] = "Loading web content…"
    s.dirty = true
    << 0
}
pub fn (s $&Screen) webview_command(id int,command string) int {
    native := s.webview_native(id) or >>
    << native.command(command) or >>
}
pub fn (s $&Screen) set_webview_radius(id int,radius f64) int {
    s.check_webview(id) or >>
    if !finite_metric(radius,256.0) { >> errors.new("widgets: invalid WebView radius") }
    $item := s.web_state(id) or >>
    item.radius = radius
    s.webviews[id] = item
    s.dirty = true
    << 0
}
// Explicit removal revokes copied native/WebView/request handles immediately.
pub fn (s $&Screen) close_webview(id int) int {
    s.check_webview(id) or >>
    s.web_dispose(id) or >>
    s.nodes[id - 1].visible = false
    s.nodes[id - 1].focusable = false
    if s.focused == id { s.focused = 0 }
    s.dirty = true
    << 0
}
fn (s $&Screen) web_dispose(id int) int {
    if !s.webviews.has(id) { << 0 }
    $item := s.web_state(id) or >>
    $native := item.native
    native.dispose() or (err) { s.webviews[id] = item
        >> err }
    item.native = native
    item.closed = true
    s.webviews[id] = item
    << 0
}
fn (s &Screen) web_occluded(id int,bounds &layout.Rect) bool {
    modal := s.modal_blocks()
    if modal > 0 && !s.is_descendant(id,modal) { << true }
    for node in s.nodes {
        if node.kind >= SCREEN_POPOVER && s.is_visible(node.id) && s.overlay_is_visible(node.id) && !s.is_descendant(id,node.id) {
            overlap := layout.intersect(bounds,&node.bounds) or >>
            if overlap.width > 0.0 && overlap.height > 0.0 { << true }
        }
    }
    << false
}
fn (s $&Screen) sync_webviews() int {
    for node in s.nodes { if node.kind == SCREEN_WEBVIEW && s.webviews.has(node.id) {
        $item := s.web_state(node.id) or >>
        if item.closed { -> }
        checked_native := item.native
        if !checked_native.is_open() { item.closed = true
            item.loading = false
            item.failed = true
            s.webviews[node.id] = item
            s.texts[node.id - 1] = "WebView unavailable"
            s.nodes[node.id - 1].focusable = false
            -> }
        b := node.bounds
        inner := layout.Rect{x: b.x + 1.0,y: b.y + 1.0,width: math.max(0.0,b.width - 2.0),height: math.max(0.0,b.height - 4.0)}
        clip := s.child_clip(node.id) or >>
        item.suspended = s.web_occluded(node.id,&b) or >>
        // Canvas popup surfaces must remain above the native child plane.
        for other in s.nodes { if other.kind >= SCREEN_CHECKBOX && other.kind < SCREEN_POPOVER && other.kind != SCREEN_WEBVIEW && s.is_visible(other.id) {
            popup := s.control_popup(other.id) or >>
            overlap := layout.intersect(&popup,&inner) or >>
            if overlap.width > 0.0 && overlap.height > 0.0 { item.suspended = true }
        } }
        visible := s.is_visible(node.id) && !item.suspended && item.loaded && !item.failed
        $native := item.native
        native.update(&inner,&clip,math.max(0.0,item.radius - 1.0),visible,s.effective_enabled(node.id),item.focused) or (err) { s.webviews[node.id] = item
            >> err }
        item.native = native
        s.webviews[node.id] = item
    } }
    << 0
}
fn (s $&Screen) web_input(id int,route int,event &ui.InputEvent) Action {
    $item := s.web_state(id) or >>
    if route == ROUTE_FOCUS { item.focused = true }
    if route == ROUTE_BLUR || route == ROUTE_CANCEL { item.focused = false }
    s.webviews[id] = item
    $result := no_action(id,true)
    if route == ROUTE_INPUT && event.kind == ui.EV_POINTER_DOWN {
        result.request_focus = true
        result.consumed = true
    }
    << result
}
fn (s $&Screen) web_paint(id int,frame $&draw.Frame,styles &Styles) int {
    item := s.web_state(id) or >>
    b := s.nodes[id - 1].bounds
    $control := styles.input.clone()
    control.radius = item.radius
    $state := 0
    if item.focused { state = state | STATE_FOCUSED }
    if !s.nodes[id - 1].enabled { state = state | STATE_DISABLED }
    if item.failed { state = state | STATE_INVALID }
    paint_box_styled(frame,&b,styles,&control,state) or >>
    if !item.loaded || item.failed {
        $key := TEXT_WEB_CONTENT
        if item.loading { key = TEXT_WEB_LOADING }
        if item.failed { key = TEXT_WEB_FAILED }
        if item.closed { key = TEXT_WEB_UNAVAILABLE }
        locale := s.control_locale(id) or >>
        caption := locale.text(key) or >>
        caches := $&s.labels
        $labels := caches.take(id * 2)
        message := web_caption($&labels,&caption,frame,&b,styles,&control,state)
        s.labels[id * 2] = labels
        if message.len > 0 { >> errors.new(message) }
    }
    if item.loading {
        bar := layout.Rect{x: b.x + 1.0,y: b.y + b.height - 3.0,width: math.max(0.0,b.width - 2.0) * item.progress,height: 2.0}
        rounded_fill(frame,&bar,1.0,control.palette.accent) or >>
    }
    << 0
}
fn (s $&Screen) web_event(event &ui.Event) []Action {
    native := ui.native_view_event_of(event) or >>
    $actions := []Action{}
    for node in s.nodes { if node.kind == SCREEN_WEBVIEW && s.webviews.has(node.id) {
        $item := s.web_state(node.id) or >>
        if item.closed || item.native.id != native.identity.canvas_id || item.native.generation != native.identity.generation { -> }
        payload := native.payload + ""
        if payload == "focus_next" || payload == "focus_previous" {
            s.focused = node.id
            $input := s.cancellation()
            input.kind = ui.EV_KEY_DOWN
            input.key = ui.KEY_TAB
            if payload == "focus_previous" { input.modifiers = ui.MOD_SHIFT }
            << s.dispatch_input(&input) or >>
        }
        content := native.content_event()
        $kind := ACTION_NONE
        if content.kind == ui.EV_LOADING { item.loading = true
            item.failed = false
            item.progress = 0.0
            kind = ACTION_WEB_LOADING
            s.texts[node.id - 1] = "Loading web content…" }
        if content.kind == ui.EV_LOADED { item.loaded = true
            item.loading = false
            item.failed = false
            item.progress = 1.0
            kind = ACTION_WEB_LOADED }
        if content.kind == ui.EV_LOAD_FAILED { item.loading = false
            item.failed = true
            kind = ACTION_WEB_FAILED
            $message := content.menu_id + ""
            if message.len == 0 { message = "Unable to load web content" }
            s.texts[node.id - 1] = message }
        if content.kind == ui.EV_PROGRESS { item.progress = math.max(0.0,math.min(1.0,f64(content.width) / 100.0))
            kind = ACTION_WEB_PROGRESS }
        s.webviews[node.id] = item
        if content.kind == ui.EV_FOCUSED { s.focus_input(node.id) or >> }
        if content.kind == ui.EV_BLURRED && s.focused == node.id { s.focus_input(0) or >> }
        if kind != ACTION_NONE { actions.push(Action{kind: kind,id: node.id,needs_paint: true,request_focus: false,consumed: false,value: item.progress}) }
        s.dirty = true
        << actions
    } }
    << actions
}

fn web_caption(labels $&TextCache,caption &string,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,control &ControlStyle,state int) string {
    labels.paint_text(0,caption,frame,bounds,styles,control,state) or (err) { << err.msg() }
    << ""
}
