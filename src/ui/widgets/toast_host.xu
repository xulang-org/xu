@ui/widgets

#time
#errors
#ui
#ui/draw
#ui/layout
#math

pub const NOTICE_NORMAL = 0
pub const NOTICE_IMPORTANT = 1
pub const ACTION_NOTICE_ACTION = 9
pub struct Notice {
    pub key string
    pub text string
    pub action string
    pub lifetime time.Duration
    pub priority int
}
pub fn notice(text &string) Notice {
    << Notice{key: "",text: text + "",action: "",lifetime: time.duration(3 * time.second()),priority: NOTICE_NORMAL}
}
fn clone_notice(value &Notice) Notice {
    << Notice{key: value.key + "",text: value.text + "",action: value.action + "",lifetime: value.lifetime,priority: value.priority}
}
pub struct NoticeRecord {
    pub token int
    pub key string
    pub text string
    pub action string
    pub lifetime time.Duration
    pub priority int
}
fn notice_record(token int,value &Notice) NoticeRecord {
    << NoticeRecord{token: token,key: value.key + "",text: value.text + "",action: value.action + "",lifetime: value.lifetime,priority: value.priority}
}
// Bounded, stable-priority queue. Expiry starts when a renderer displays a
// record, never while it is waiting. Keys replace pending copies in place.
pub struct ToastHost {
    pending []NoticeRecord
    serial int
    capacity int
}
pub fn toast_host() ToastHost { << ToastHost{pending: []NoticeRecord{},serial: 0,capacity: 32} }
fn (host &ToastHost) record_at(index int) NoticeRecord {
    token := host.pending[index].token
    key := host.pending[index].key + ""
    text := host.pending[index].text + ""
    action := host.pending[index].action + ""
    lifetime := host.pending[index].lifetime
    priority := host.pending[index].priority
    << NoticeRecord{token: token,key: key,text: text,action: action,lifetime: lifetime,priority: priority}
}
pub fn (host &ToastHost) pending_count() int { << host.pending.len }
pub fn (host $&ToastHost) set_capacity(capacity int) int {
    if capacity < 1 || capacity > 64 || capacity < host.pending.len { >> errors.new("widgets: invalid notification capacity") }
    host.capacity = capacity
    << 0
}
pub fn (host $&ToastHost) enqueue(value &Notice) int {
    validate_table_text(&value.text) or >>
    validate_table_text(&value.action) or >>
    validate_table_text(&value.key) or >>
    if value.lifetime.is_negative() || value.priority < NOTICE_NORMAL || value.priority > NOTICE_IMPORTANT { >> errors.new("widgets: invalid notification") }
    if value.key.len > 0 { for i in 0:host.pending.len { if host.pending[i].key == value.key {
        token := host.pending[i].token
        content := clone_notice(value)
        host.pending[i] = notice_record(token,&content)
        << token } } }
    if host.pending.len >= host.capacity || host.serial == 2147483647 { >> errors.new("widgets: notification queue is full") }
    host.serial += 1
    token := host.serial
    content := clone_notice(value)
    record := notice_record(token,&content)
    host.pending.push(record)
    << token
}
pub fn (host $&ToastHost) next_notice() NoticeRecord {
    if host.pending.len == 0 { >> errors.new("widgets: notification queue is empty") }
    $best := 0
    for i in 1:host.pending.len { if host.pending[i].priority > host.pending[best].priority { best = i } }
    value := host.record_at(best)
    $remaining := []NoticeRecord{}
    for i in 0:host.pending.len { if i != best { record := host.record_at(i)
        remaining.push(record) } }
    host.pending = remaining
    << value
}

struct ScreenNotices {
    host ToastHost
    handles []int
    active []NoticeRecord
    armed int
    custom string
    motion MotionSpec
}
fn new_screen_notices() ScreenNotices { << ScreenNotices{host: toast_host(),handles: []int{},active: []NoticeRecord{},armed: 0,custom: "",motion: motion_spec()} }
fn (s &Screen) active_notice(index int) NoticeRecord {
    token := s.notices.active[index].token
    key := s.notices.active[index].key + ""
    text := s.notices.active[index].text + ""
    action := s.notices.active[index].action + ""
    lifetime := s.notices.active[index].lifetime
    priority := s.notices.active[index].priority
    << NoticeRecord{token: token,key: key,text: text,action: action,lifetime: lifetime,priority: priority}
}
// Returns a notice token; ACTION_NOTICE_ACTION carries this token in value.
// At most three toast controls are allocated for the lifetime of a Screen.
pub fn (s $&Screen) enqueue_notice(value &Notice) int {
    if s.notices.handles.len == 0 {
        for i in 0:3 { id := s.toast("") or >>
            spec := s.notices.motion
            s.set_motion(id,&spec) or >>
            encoded := s.notices.custom + ""
            if encoded.len > 0 { style := decode_control_style(&encoded,&s.styles.input)
                s.set_control_style(id,&style) or >> }
            s.notices.handles.push(id)
            s.notices.active.push(notice_record(0,&notice(&""))) }
    }
    if value.key.len > 0 { for i in 0:s.notices.active.len { record := s.active_notice(i)
        if record.token > 0 && record.key == value.key {
            // Use queue validation without mutating the live record on errors.
            $validation := toast_host()
            _ := validation.enqueue(value) or >>
            id := s.notices.handles[i]
            s.show_toast(id,value.text + "",value.lifetime) or >>
            s.descriptions[id - 1] = value.action + ""
            s.notices.active[i] = notice_record(record.token,value)
            << record.token
        } } }
    notices := $&s.notices
    host := $&notices.host
    token := host.enqueue(value) or >>
    s.pump_notices() or >>
    << token
}
fn (s $&Screen) pump_notices() int {
    for i in 0:s.notices.handles.len {
        id := s.notices.handles[i]
        if s.overlay_is_visible(id) { -> }
        s.notices.active[i].token = 0
        if s.notices.host.pending_count() == 0 { -> }
        notices := $&s.notices
        host := $&notices.host
        record := host.next_notice() or >>
        s.show_toast(id,record.text + "",record.lifetime) or >>
        s.descriptions[id - 1] = record.action + ""
        s.notices.active[i] = record
    }
    << 0
}
fn (s &Screen) notice_slot(id int) int {
    for i in 0:s.notices.handles.len { if s.notices.handles[i] == id { << i } }
    << -1
}
fn (s &Screen) notice_action_bounds(id int) layout.Rect {
    b := s.overlay_popup(id)
    if s.notice_slot(id) < 0 || s.descriptions[id - 1].len == 0 { << screen_empty() }
    width := math.min(96.0 * math.max(s.styles.density,s.styles.text_scale),math.max(0.0,b.width - 64.0))
    << layout.Rect{x: b.x + b.width - 32.0 - width,y: b.y,width: width,height: b.height}
}
fn (s $&Screen) notice_input(id int,event &ui.InputEvent) Action {
    slot := s.notice_slot(id)
    if slot < 0 || !s.overlay_is_open(id) { << no_action(id,false) }
    b := s.notice_action_bounds(id)
    $activate := false
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && b.contains(event.x,event.y) {
        s.notices.armed = id
        << Action{kind: ACTION_NONE,id: id,needs_paint: true,request_focus: true,consumed: true,value: 0.0}
    }
    if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && s.notices.armed == id {
        activate = b.contains(event.x,event.y)
        s.notices.armed = 0
    }
    if event.kind == ui.EV_POINTER_CANCEL { s.notices.armed = 0 }
    if event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_ENTER && event.repeat == 0 && s.focused == id && b.width > 0.0 { activate = true }
    if activate { token := s.notices.active[slot].token
        s.close_overlay(id) or >>
        << Action{kind: ACTION_NOTICE_ACTION,id: id,needs_paint: true,request_focus: false,consumed: true,value: f64(token)} }
    << no_action(id,false)
}

// Stable control IDs allocated lazily by enqueue_notice. The caller owns the
// returned snapshot and can register notice actions without borrowing Screen.
pub fn (s &Screen) notice_ids() []int {
    $ids := []int{}
    for id in s.notices.handles { ids.push(id) }
    << ids
}
