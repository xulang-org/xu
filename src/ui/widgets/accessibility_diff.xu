@ui/widgets

#errors

// Accessibility change tracking — platform providers compare two successive
// tree snapshots to determine which nodes were added, removed, or changed.
// The provider fires the corresponding platform notification for each change.

pub const CHANGE_ADDED = 1
pub const CHANGE_REMOVED = 2
pub const CHANGE_NAME = 4
pub const CHANGE_VALUE = 8
pub const CHANGE_STATES = 16
pub const CHANGE_BOUNDS = 32
pub const CHANGE_FOCUS = 64
pub const CHANGE_CHILDREN = 128
pub const CHANGE_ROLE = 256
pub const CHANGE_LIVE_REGION = 512

pub struct AccessibilityChange {
    pub id int
    pub kind int
    pub role int
    pub name string
}

// diff_accessibility_trees compares two snapshots and returns a list of
// changes.  Platform providers use this to fire targeted notifications.
//
// This is deliberately conservative: it compares all fields a screen
// reader uses.  If a change is detected that does not map to a platform
// notification, it is still included so adapters can choose to rebuild.
pub fn diff_accessibility_trees(old &[]AccessibilityNode, new &[]AccessibilityNode) []AccessibilityChange {
    $changes := []AccessibilityChange{}

    // Index old nodes by id for O(N) lookup.
    $old_ids := map[int]int{}
    for i in 0:old.len { old_ids[old[i].id] = i }

    $new_ids := map[int]int{}
    for i in 0:new.len { new_ids[new[i].id] = i }

    // Detect added and changed nodes.
    for i in 0:new.len {
        node := &new[i]
        if !old_ids.has(node.id) {
            changes.push(AccessibilityChange{id: node.id, kind: CHANGE_ADDED, role: node.role, name: node.name + ""})
            ->
        }
        old_idx := old_ids[node.id]
        prev := &old[old_idx]
        $kind := 0
        if prev.name != node.name { kind = kind | CHANGE_NAME }
        if prev.value != node.value || prev.selected_text != node.selected_text || prev.copy_enabled != node.copy_enabled {
            kind = kind | CHANGE_VALUE
        }
        if prev.states != node.states { kind = kind | CHANGE_STATES }
        if prev.role != node.role { kind = kind | CHANGE_ROLE }
        if prev.x != node.x || prev.y != node.y || prev.width != node.width || prev.height != node.height {
            kind = kind | CHANGE_BOUNDS
        }
        // Focus change.
        old_focused := (prev.states & ACC_STATE_FOCUSED) != 0
        new_focused := (node.states & ACC_STATE_FOCUSED) != 0
        if old_focused != new_focused { kind = kind | CHANGE_FOCUS }
        // Children change.
        if prev.children.len != node.children.len { kind = kind | CHANGE_CHILDREN }
        else {
            for j in 0:prev.children.len {
                if prev.children[j] != node.children[j] { kind = kind | CHANGE_CHILDREN
                    ->
                }
            }
        }
        // Live region content change.
        if node.live != LIVE_OFF && prev.name != node.name { kind = kind | CHANGE_LIVE_REGION }
        if kind != 0 {
            changes.push(AccessibilityChange{id: node.id, kind: kind, role: node.role, name: node.name + ""})
        }
    }

    // Detect removed nodes.
    for i in 0:old.len {
        if !new_ids.has(old[i].id) {
            changes.push(AccessibilityChange{id: old[i].id, kind: CHANGE_REMOVED, role: old[i].role, name: old[i].name + ""})
        }
    }
    << changes
}

// focused_node returns the id of the currently focused accessibility node,
// or 0 if no node is focused.
pub fn focused_node(tree &[]AccessibilityNode) int {
    for node in tree {
        if (node.states & ACC_STATE_FOCUSED) != 0 { << node.id }
    }
    << 0
}

// has_change checks whether a specific change type is included.
pub fn (change &AccessibilityChange) has_change(flag int) bool {
    << (change.kind & flag) != 0
}
