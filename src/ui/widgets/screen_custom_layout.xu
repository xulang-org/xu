@ui/widgets

#ui/layout
#errors
#math

pub struct CustomLayoutContext {
    pub id int
    pub width f64
    pub height f64
    pub viewport_width f64
    pub viewport_height f64
}

fn default_custom_layout_measure(ctx &CustomLayoutContext,children &[]LayoutChild,styles &Styles) layout.Size {
    _ := ctx
    _ := children
    _ := styles
    << layout.Size{width: 0.0,height: 0.0}
}

fn default_custom_layout_fn(ctx &CustomLayoutContext,children &[]LayoutChild,styles &Styles) []layout.Rect {
    _ := ctx
    _ := styles
    $rects := []layout.Rect{}
    for i in 0:children.len {
        ch := &children[i]
        rects.push(layout.Rect{x: 0.0,y: 0.0,width: ch.natural.width,height: ch.natural.height})
    }
    << rects
}

pub struct LayoutChild {
    pub id int
    pub natural layout.Size
    pub item LayoutItem
}

pub struct CustomLayoutSpec {
    pub measure_fn fn (&CustomLayoutContext,&[]LayoutChild,&Styles) layout.Size
    pub layout_fn fn (&CustomLayoutContext,&[]LayoutChild,&Styles) []layout.Rect
    pub has_measure bool
    pub has_layout bool
    pub clip bool
}

pub fn custom_layout() CustomLayoutSpec {
    << CustomLayoutSpec{
        measure_fn: default_custom_layout_measure,
        layout_fn: default_custom_layout_fn,
        has_measure: false,
        has_layout: false,
        clip: false
    }
}

pub fn (c $&CustomLayoutSpec) with_measure(f fn (&CustomLayoutContext,&[]LayoutChild,&Styles) layout.Size) {
    c.measure_fn = f
    c.has_measure = true
}

pub fn (c $&CustomLayoutSpec) with_layout(f fn (&CustomLayoutContext,&[]LayoutChild,&Styles) []layout.Rect) {
    c.layout_fn = f
    c.has_layout = true
}

fn copy_custom_layout_spec(c &CustomLayoutSpec) CustomLayoutSpec {
    << CustomLayoutSpec{
        measure_fn: c.measure_fn,
        layout_fn: c.layout_fn,
        has_measure: c.has_measure,
        has_layout: c.has_layout,
        clip: c.clip
    }
}

pub fn (s $&Screen) set_custom_layout(id int,spec &CustomLayoutSpec) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    cls := $&comp.custom_layouts
    had := cls.has(id)
    cls[id] = copy_custom_layout_spec(spec)
    if !had { comp.custom_layout_count = comp.custom_layout_count + 1 }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_custom_layout(id int) int {
    _ := s.node(id) >>>
    if s.composition.custom_layouts.has(id) {
        comp := $&s.composition
        cls := $&comp.custom_layouts
        cls.delete(id)
        if comp.custom_layout_count > 0 { comp.custom_layout_count = comp.custom_layout_count - 1 }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s &Screen) has_custom_layout(id int) bool {
    _ := s.node(id) >>>
    << s.composition.custom_layouts.has(id)
}

fn (s $&Screen) build_custom_layout_children(id int,avail_w f64,avail_h f64,styles &Styles) []LayoutChild {
    ordered := s.sorted_visible_container_children(id)
    $children := []LayoutChild{}
    for i in 0:ordered.len {
        cid := ordered[i]
        $it := layout_item()
        if s.composition.items.has(cid) {
            it = copy_layout_item(&s.composition.items[cid])
        }
        $lim_w := avail_w
        $lim_h := avail_h
        if it.width >= 0.0 { lim_w = it.width }
        else if it.width_pct >= 0.0 && avail_w < 100000.0 { lim_w = avail_w * it.width_pct }
        else if it.max_width >= 0.0 && it.max_width < lim_w { lim_w = it.max_width }
        if it.height >= 0.0 { lim_h = it.height }
        else if it.height_pct >= 0.0 && avail_h < 100000.0 { lim_h = avail_h * it.height_pct }
        else if it.max_height >= 0.0 && it.max_height < lim_h { lim_h = it.max_height }
        sz := s.measure_constrained_styled(cid,lim_w,lim_h,styles) >>>
        children.push(LayoutChild{id: cid,natural: sz,item: it})
    }
    << children
}

fn (s $&Screen) measure_custom_layout_styled(id int,max_w f64,max_h f64,styles &Styles) layout.Size {
    children := s.build_custom_layout_children(id,max_w,max_h,styles) >>>
    spec := copy_custom_layout_spec(&s.composition.custom_layouts[id])
    ctx := CustomLayoutContext{
        id: id,
        width: max_w,
        height: max_h,
        viewport_width: s.width,
        viewport_height: s.height
    }
    if spec.has_measure {
        f := spec.measure_fn
        raw := f(&ctx,&children,styles)
        << layout.Size{width: math.max(0.0,raw.width),height: math.max(0.0,raw.height)}
    }
    if spec.has_layout {
        f := spec.layout_fn
        rects := f(&ctx,&children,styles)
        $mw := 0.0
        $mh := 0.0
        for i in 0:min_int(children.len,rects.len) {
            r := &rects[i]
            mw = math.max(mw,r.x + math.max(0.0,r.width))
            mh = math.max(mh,r.y + math.max(0.0,r.height))
        }
        if max_w < 100000.0 { mw = math.min(mw,max_w) }
        if max_h < 100000.0 { mh = math.min(mh,max_h) }
        << layout.Size{width: math.max(0.0,mw),height: math.max(0.0,mh)}
    }
    $bw := 0.0
    $bh := 0.0
    for i in 0:children.len {
        bw = math.max(bw,children[i].natural.width)
        bh = math.max(bh,children[i].natural.height)
    }
    << layout.Size{width: bw,height: bh}
}

fn (s $&Screen) layout_custom_children_styled(id int,avail_w f64,avail_h f64,styles &Styles) int {
    children := s.build_custom_layout_children(id,avail_w,avail_h,styles) >>>
    spec := copy_custom_layout_spec(&s.composition.custom_layouts[id])
    ctx := CustomLayoutContext{
        id: id,
        width: avail_w,
        height: avail_h,
        viewport_width: s.width,
        viewport_height: s.height
    }
    if spec.has_layout {
        f := spec.layout_fn
        rects := f(&ctx,&children,styles)
        cnt := min_int(children.len,rects.len)
        for i in 0:cnt {
            cid := children[i].id
            r := &rects[i]
            s.nodes[cid - 1].local = layout.Rect{
                x: r.x,
                y: r.y,
                width: math.max(0.0,r.width),
                height: math.max(0.0,r.height)
            }
        }
    } else {
        for i in 0:children.len {
            cid := children[i].id
            nsz := &children[i].natural
            s.nodes[cid - 1].local = layout.Rect{x: 0.0,y: 0.0,width: nsz.width,height: nsz.height}
        }
    }
    if s.composition.absolute_item_count > 0 {
        s.layout_absolute_children_styled(id,avail_w,avail_h,styles) >>>
    }
    << 0
}

fn (s $&Screen) cleanup_custom_layout_for(id int) {
    if s.composition.custom_layouts.has(id) {
        comp := $&s.composition
        cls := $&comp.custom_layouts
        cls.delete(id)
        if comp.custom_layout_count > 0 { comp.custom_layout_count = comp.custom_layout_count - 1 }
    }
}
