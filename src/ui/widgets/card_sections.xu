@ui/widgets
#ui/layout
#math
#errors

pub struct CardRegions {
    pub header layout.Rect
    pub body layout.Rect
    pub footer layout.Rect
}
pub fn (card &Card) regions(styles &Styles,header_height f64,footer_height f64) CardRegions {
    if !finite_metric(header_height,4096.0) || !finite_metric(footer_height,4096.0) { >> errors.new("widgets: invalid card section heights") }
    area := card.content_bounds(styles)
    scale := styles.density * math.max(1.0,styles.text_scale)
    header := math.min(area.height,header_height * scale)
    footer := math.min(math.max(0.0,area.height - header),footer_height * scale)
    gap := 8.0 * styles.density
    $top := area.y
    $bottom := area.y + area.height
    if header > 0.0 { top += header + gap }
    if footer > 0.0 { bottom -= footer + gap }
    << CardRegions{header: layout.Rect{x: area.x,y: area.y,width: area.width,height: header},
        body: layout.Rect{x: area.x,y: math.min(top,area.y + area.height),width: area.width,height: math.max(0.0,bottom - top)},
        footer: layout.Rect{x: area.x,y: area.y + area.height - footer,width: area.width,height: footer}}
}
pub struct CardSections { pub header int
    pub body int
    pub footer int }
struct CardSectionState { header int
    body int
    footer int
    header_height f64
    footer_height f64 }
pub fn (s $&Screen) card_sections(id int,header_height f64,footer_height f64) CardSections {
    node := s.node(id) or >>
    if node.kind != SCREEN_CARD || s.basics.scrolls.has(id) || s.basics.card_sections.has(id) { >> errors.new("widgets: card sections require an unconfigured card") }
    if !finite_metric(header_height,4096.0) || !finite_metric(footer_height,4096.0) { >> errors.new("widgets: invalid card section heights") }
    header := s.group() or >>
    body := s.group() or >>
    footer := s.group() or >>
    for child in [header,body,footer] { s.set_parent(child,id) or >> }
    s.basics.card_sections[id] = CardSectionState{header: header,body: body,footer: footer,header_height: header_height,footer_height: footer_height}
    << CardSections{header: header,body: body,footer: footer}
}
fn (s $&Screen) layout_card_sections() int {
    styles := s.styles.clone()
    for node in s.nodes { if node.kind == SCREEN_CARD && s.basics.card_sections.has(node.id) {
        basic := $&s.basics
        states := $&basic.card_sections
        state := states.take(node.id)
        hs := state.header
        bs := state.body
        fs := state.footer
        hh := state.header_height
        fh := state.footer_height
        states[node.id] = state
        bounds := s.global_bounds(node.id) or >>
        $item := s.take_basic_cards(node.id)
        item.set_bounds(&bounds) or (err) { s.basics.cards[node.id] = item.clone()
            >> err }
        regions := item.regions(&styles,hh,fh) or (err) { s.basics.cards[node.id] = item.clone()
            >> err }
        s.basics.cards[node.id] = item
        rects := [regions.header,regions.body,regions.footer]
        ids := [hs,bs,fs]
        for index in 0:3 { child := ids[index]
            if s.nodes[child - 1].parent != node.id { >> errors.new("widgets: card section was reparented") }
            r := rects[index]
            s.nodes[child - 1].local = layout.Rect{x: r.x - bounds.x,y: r.y - bounds.y,width: r.width,height: r.height}
        }
    } }
    << 0
}
// Counts remain separate from tone; zero can hide an optional numeric badge.
pub fn badge_count_text(count int,maximum int) string {
    if count < 0 || maximum < 1 { >> errors.new("widgets: invalid badge count") }
    if count > maximum { << str(maximum) + "+" }
    << str(count)
}
pub fn (s $&Screen) set_badge_count(id int,count int,maximum int,show_zero bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_BADGE { >> errors.new("widgets: expected Badge") }
    locale := s.control_locale(id) or >>
    value := locale.badge_count(count,maximum) or >>
    s.basics.badge_counts[id] = BadgeCounter{count: count,maximum: maximum}
    s.set_option_text(id,0,value) or >>
    << s.set_visible(id,show_zero || count > 0) or >>
}

struct BadgeCounter { count int
    maximum int }
pub fn (locale &Locale) badge_count(count int,maximum int) string {
    _ := badge_count_text(count,maximum) or >>
    if count > maximum { << locale.count_text(TEXT_OVERFLOW_PATTERN,maximum) or >> }
    << locale.integer(count)
}
