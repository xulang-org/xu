@ui/widgets

#errors
#ui

// The table owns functions only. Context and target are borrowed for one call;
// register named functions rather than closures retaining a target borrow.
// A callback returns "" on success or an error message. Catch throwing calls
// inside the callback: Xu function values do not carry an inferred throw ABI.
// C/S/A keep the function table fully typed; the factory infers them. Its ctx
// and target arguments select types only and are never retained. Screen and
// retained View loops use the same table; raw controls can supply local state.
pub struct ActionDispatcher#C, S, A{
    handlers map[string]fn ($&C, $&S, &A) string
    key_of fn (&A, bool) string
    fallbacks []fn ($&C, $&S, &A) string
}
pub fn action_dispatcher#C, S(ctx &C, target &S) ActionDispatcher#C, S, Action{
    << ActionDispatcher#C, S, Action{handlers: map[string]fn ($&C, $&S, &Action) string {},
        key_of: screen_action_key, fallbacks:[]fn ($&C, $&S, &Action) string {}}
}
fn dispatch_kind_valid(kind int) bool {
    <<(kind >= ACTION_ACTIVATE && kind <= ACTION_NOTICE_ACTION) ||
    (kind >= ACTION_WEB_LOADING && kind <= ACTION_WEB_PROGRESS) ||
    (kind >= ACTION_CHART_HOVER && kind <= ACTION_CHART_LEGEND)
}
fn dispatch_key(id int, kind int) string {
    if id <= 0 || id > 2147483647 { >> errors.new("widgets: invalid action id")}
    if kind != ACTION_NONE && !dispatch_kind_valid(kind) { >> errors.new("widgets: invalid action kind")}
    << str(id) + ":" + str(kind)
}
// Re-registering a key replaces its handler. Exact kind wins over on_any.
pub fn (d $&ActionDispatcher#C, S, A) on(id int, kind int, handler fn ($&C, $&S, &A) string) int {
    if kind == ACTION_NONE{ >> errors.new("widgets: ACTION_NONE cannot be registered")}
    key := dispatch_key(id, kind) or >>
    d.handlers[key] = handler
    << 0
}
// on_any receives semantic actions only, never ACTION_NONE repaint signals.
pub fn (d $&ActionDispatcher#C, S, A) on_any(id int, handler fn ($&C, $&S, &A) string) int {
    key := dispatch_key(id, ACTION_NONE) or >>
    d.handlers[key] = handler
    << 0
}
// Optional compatibility callback; replacement follows the same rule as on.
pub fn (d $&ActionDispatcher#C, S, A) set_fallback(handler fn ($&C, $&S, &A) string) {
    d.fallbacks =[handler]
}
pub fn (d $&ActionDispatcher#C, S, A) clear_fallback() {
    d.fallbacks =[]fn ($&C, $&S, &A) string {}
}
// A miss/invalid action is false. Handler errors propagate and never fall back.
// Neither Screen nor context is stored in the table.
pub fn (d &ActionDispatcher#C, S, A) dispatch(action &A, ctx $&C, s $&S) bool {
    key_of := d.key_of
    key := key_of(action, true)
    if key.len == 0 { << false}
    if d.handlers.has(key) {handler := d.handlers[key]
        message := handler(ctx, s, action)
        if message.len > 0 { >> errors.new(message)}
        << true}
    any_key := key_of(action, false)
    if d.handlers.has(any_key) {handler := d.handlers[any_key]
        message := handler(ctx, s, action)
        if message.len > 0 { >> errors.new(message)}
        << true}
    << false
}
fn screen_action_key(action &Action, exact bool) string {
    if action.id <= 0 || action.id > 2147483647 || !dispatch_kind_valid(action.kind) { << ""}
    $kind := ACTION_NONE
    if exact{kind = action.kind}
    << str(action.id) + ":" + str(kind)
}
// Shared by standard and custom loops: dispatch, then the optional fallback.
pub fn (d &ActionDispatcher#C, S, A) dispatch_or_fallback(action &A, ctx $&C, s $&S) bool {
    if d.dispatch(action, ctx, s) or >> { << true}
    if d.fallbacks.len > 0 {handler := d.fallbacks[0]
        message := handler(ctx, s, action)
        if message.len > 0 { >> errors.new(message)}
        << true}
    << false
}

// Function-only entry point: context owns business state, layout is explicit,
// and a fallback is optional. Both paths dispose Screen on close or failure.
pub fn run_screen_actions#C(s $&Screen, events chan ui.Event, ctx $&C,
layout_fn fn ($&C, $&Screen) string, dispatcher &ActionDispatcher#C, Screen, Action) int {
    screen_actions_loop(s, events, ctx, layout_fn, dispatcher) or(err) {s.dispose()
        >> err}
    s.dispose()
    << 0
}
fn screen_actions_loop#C(s $&Screen, events chan ui.Event, ctx $&C,
layout_fn fn ($&C, $&Screen) string, dispatcher &ActionDispatcher#C, Screen, Action) int {
    message := layout_fn(ctx, s)
    if message.len > 0 { >> errors.new(message)}
    _ := s.render() or >>
    while s.is_open() {
        actions := s.next(events) or >>
        if !s.is_open() { <- }
        for action in actions{_ := dispatcher.dispatch_or_fallback(&action, ctx, s) or >> }
        if !s.is_open() { <- }
        message := layout_fn(ctx, s)
        if message.len > 0 { >> errors.new(message)}
        _ := s.render() or >>
    }
    << 0
}
