@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

pub const BUTTON_GROUP_ACTIONS = 0
pub const BUTTON_GROUP_SINGLE = 1
pub const BUTTON_GROUP_MULTIPLE = 2
pub struct ButtonGroupItem {
    pub key int
    pub label string
    pub enabled bool
    pub selected bool
    pub variant int
}
pub fn button_group_item(key int,label string) ButtonGroupItem {
    << ButtonGroupItem{key: key,label: label,enabled: true,selected: false,variant: BUTTON_SECONDARY}
}
pub struct ButtonGroupAppearance {
    pub vertical bool
    pub joined bool
    pub equal_width bool
    pub allow_empty bool
    pub gap f64
    pub min_item_width f64
}
pub fn button_group_appearance() ButtonGroupAppearance {
    << ButtonGroupAppearance{vertical: false,joined: true,equal_width: false,allow_empty: false,gap: 6.0,min_item_width: 40.0}
}
pub fn (a &ButtonGroupAppearance) validate() int {
    if !finite_metric(a.gap,64.0) || !finite_metric(a.min_item_width,512.0) || a.min_item_width < 24.0 {
        >> errors.new("widgets: invalid button group appearance") }
    << 0
}
pub struct ButtonGroup {
    control Button
    items []ButtonGroupItem
    boxes []layout.Rect
    transitions []PaintTransition
    labels TextCache
    appearance ButtonGroupAppearance
    motion MotionSpec
    mode int
    checked_items int
    disabled_items int
    active int
    hot int
    armed int
    key_armed int
    now time.Instant
    reduced bool
}
pub fn button_group(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,items &[]ButtonGroupItem,mode int) ButtonGroup {
    control := button(identity,id,bounds) or >>
    $group := ButtonGroup{control: control,items: []ButtonGroupItem{},boxes: []layout.Rect{},transitions: []PaintTransition{},
        labels: text_cache(context),appearance: button_group_appearance(),motion: motion_spec(),mode: mode,checked_items: 0,disabled_items: 0,active: -1,hot: -1,
        armed: -1,key_armed: 0,now: time.zero_instant(),reduced: false}
    group.set_items(items) or >>
    << group
}
pub fn (g &ButtonGroup) id() int { << g.control.id }
pub fn (g &ButtonGroup) bounds() layout.Rect { << g.control.bounds() }
pub fn (g &ButtonGroup) needs_paint() bool { << g.control.dirty }
pub fn (g $&ButtonGroup) painted() { g.control.dirty = false }
pub fn (g &ButtonGroup) is_enabled() bool { << g.control.is_enabled() }
pub fn (g &ButtonGroup) is_focused() bool { << g.control.focused }
pub fn (g &ButtonGroup) active_key() int { if g.active < 0 { << 0 }
    << g.items[g.active].key }
pub fn (g &ButtonGroup) values() []int { $keys := []int{}
    for i in 0:g.items.len { if (g.checked_items & (1 << i)) != 0 { keys.push(g.items[i].key) } }
    << keys }
fn (g &ButtonGroup) item_enabled(index int) bool { << index >= 0 && index < g.items.len && (g.disabled_items & (1 << index)) == 0 }
pub fn (g $&ButtonGroup) set_items(items &[]ButtonGroupItem) int {
    if g.control.closed || items.len < 1 || items.len > 32 || g.mode < BUTTON_GROUP_ACTIONS || g.mode > BUTTON_GROUP_MULTIPLE {
        >> errors.new("widgets: invalid button group") }
    $keys := map[int]bool{}
    $selected := 0
    $copies := []ButtonGroupItem{}
    $active := -1
    $checked_items := 0
    $disabled_items := 0
    // Copy indexed fields before helper calls; no element borrow survives an allocation.
    for i in 0:items.len {
        key := items[i].key
        label := items[i].label + ""
        enabled := items[i].enabled
        checked := items[i].selected
        variant := items[i].variant
        if key <= 0 || key > 2147483647 || keys.has(key) || label.len > 1024 || variant < BUTTON_PRIMARY || variant > BUTTON_SUBTLE {
            >> errors.new("widgets: invalid button group item") }
        keys[key] = true
        if checked { selected = selected + 1
            checked_items = checked_items | (1 << i) }
        if !enabled { disabled_items = disabled_items | (1 << i) }
        if enabled && active < 0 { active = i }
        copies.push(ButtonGroupItem{key: key,label: label,enabled: enabled,selected: checked,variant: variant})
    }
    if (g.mode == BUTTON_GROUP_SINGLE && selected > 1) || (g.mode == BUTTON_GROUP_ACTIONS && selected > 0) {
        >> errors.new("widgets: invalid button group selection") }
    if g.mode == BUTTON_GROUP_SINGLE && selected == 0 && !g.appearance.allow_empty && active >= 0 {
        checked_items = checked_items | (1 << active) }
    g.items = copies
    g.checked_items = checked_items
    g.disabled_items = disabled_items
    g.active = active
    g.hot = -1
    g.armed = -1
    g.key_armed = 0
    g.transitions = []PaintTransition{}
    for i in 0:items.len { $transition := paint_transition()
        transition.set_spec(&g.motion) or >>
        g.transitions.push(transition) }
    g.control.dirty = true
    << 0
}
pub fn (g $&ButtonGroup) set_appearance(a &ButtonGroupAppearance) int {
    a.validate() or >>
    old := g.appearance
    if old.vertical == a.vertical && old.joined == a.joined && old.equal_width == a.equal_width &&
        old.allow_empty == a.allow_empty && old.gap == a.gap && old.min_item_width == a.min_item_width { << 0 }
    g.appearance = ButtonGroupAppearance{vertical: a.vertical,joined: a.joined,equal_width: a.equal_width,
        allow_empty: a.allow_empty,gap: a.gap,min_item_width: a.min_item_width}
    g.armed = -1
    g.key_armed = 0
    g.control.dirty = true
    << 0
}
pub fn (g $&ButtonGroup) set_item_enabled(key int,enabled bool) int {
    index := g.index_of(key) or >>
    bit := 1 << index
    if enabled { g.disabled_items = g.disabled_items & (0 - 1 - bit) }
    else { g.disabled_items = g.disabled_items | bit }
    if !enabled && g.active == index { g.active = g.next_enabled(index,1) }
    g.armed = -1
    g.key_armed = 0
    g.control.dirty = true
    << 0
}
pub fn (g $&ButtonGroup) set_item_label(key int,label string) int {
    index := g.index_of(key) or >>
    if label.len > 1024 { >> errors.new("widgets: button group label is too long") }
    active := g.active
    $items := []ButtonGroupItem{}
    for i in 0:g.items.len {
        $text := g.items[i].label + ""
        if i == index { text = label + "" }
        items.push(ButtonGroupItem{key: g.items[i].key,label: text,enabled: g.item_enabled(i),
            selected: (g.checked_items & (1 << i)) != 0,variant: g.items[i].variant})
    }
    g.set_items(&items) or >>
    g.active = active
    << 0
}
pub fn (g $&ButtonGroup) set_checked(key int,selected bool) int {
    index := g.index_of(key) or >>
    if g.mode == BUTTON_GROUP_ACTIONS { >> errors.new("widgets: action buttons have no checked state") }
    if g.mode == BUTTON_GROUP_SINGLE && !selected && !g.appearance.allow_empty && ((g.checked_items & (1 << index)) != 0) {
        >> errors.new("widgets: button group requires a selection") }
    bit := 1 << index
    if selected { if g.mode == BUTTON_GROUP_SINGLE { g.checked_items = bit }
        else { g.checked_items = g.checked_items | bit } }
    else { g.checked_items = g.checked_items & (0 - 1 - bit) }
    g.control.dirty = true
    << 0
}
fn (g &ButtonGroup) index_of(key int) int { for i in 0:g.items.len { if g.items[i].key == key { << i } }
    >> errors.new("widgets: button group key is unavailable") }
fn (g &ButtonGroup) next_enabled(start int,direction int) int {
    for n in 1:g.items.len + 1 { i := (start + direction * n + g.items.len * 2) % max_int(1,g.items.len)
        if g.item_enabled(i) { << i } }
    << -1
}
pub fn (g $&ButtonGroup) set_focus(value bool) { item := $&g.control
    item.set_focus(value)
    if !value { g.armed = -1
        g.key_armed = 0 } }
pub fn (g $&ButtonGroup) cancel() { item := $&g.control
    item.cancel()
    g.hot = -1
    g.armed = -1
    g.key_armed = 0 }
pub fn (g $&ButtonGroup) set_enabled(value bool) { item := $&g.control
    item.set_enabled(value)
    if !value { g.cancel() } }
pub fn (g $&ButtonGroup) set_read_only(value bool) { item := $&g.control
    item.set_read_only(value)
    g.armed = -1
    g.key_armed = 0 }
pub fn (g $&ButtonGroup) set_bounds(bounds &layout.Rect) int {
    old := g.bounds()
    item := $&g.control
    item.set_bounds(bounds) or >>
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height { g.armed = -1
        g.key_armed = 0 }
    << 0
}
pub fn (g $&ButtonGroup) set_style(style &ControlStyle) int { item := $&g.control
    << item.set_style(style) or >> }
pub fn (g $&ButtonGroup) clear_style() { item := $&g.control
    item.clear_style() }
pub fn (g $&ButtonGroup) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    g.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    for i in 0:g.transitions.len { $transition := g.transitions[i]
        transition.set_spec(spec) or >>
        g.transitions[i] = transition }
    << 0
}
fn (g &ButtonGroup) item_style(index int,styles &Styles) ControlStyle {
    if g.control.has_style() { << g.control.style_or(styles) }
    << styles.button_variant(g.items[index].variant) or >>
}
fn (g &ButtonGroup) item_state(index int) int {
    $state := g.control.visual_state() & (STATE_DISABLED | STATE_READ_ONLY)
    if !g.item_enabled(index) { state = state | STATE_DISABLED }
    if ((g.checked_items & (1 << index)) != 0) { state = state | STATE_SELECTED }
    if index == g.hot && g.item_enabled(index) { state = state | STATE_HOVERED }
    if index == g.active && g.control.focused { state = state | STATE_FOCUSED }
    if !g.control.read_only && g.item_enabled(index) && ((index == g.armed && index == g.hot) || (index == g.active && g.key_armed != 0)) { state = state | STATE_PRESSED }
    << state
}
pub fn (g $&ButtonGroup) apply_styles(styles &Styles) int {
    b := g.bounds()
    count := g.items.len
    $widths := []f64{}
    $total := 0.0
    for i in 0:count { style := g.item_style(i,styles) or >>
        label := g.items[i].label + ""
        cache := $&g.labels
        size := cache.measure(i,&label,styles,&style) or >>
        width := math.max(g.appearance.min_item_width * styles.density,size.width + (style.padding.left + style.padding.right) * styles.density)
        widths.push(width)
        total = total + width }
    $gap := g.appearance.gap * styles.density
    if g.appearance.joined { gap = 0.0 }
    available := math.max(0.0,b.width - gap * f64(count - 1))
    g.boxes = []layout.Rect{}
    $x := b.x
    for i in 0:count {
        $width := widths[i]
        if total > available { width = available * widths[i] / math.max(1.0,total) }
        if g.appearance.equal_width { width = available / f64(max_int(1,count)) }
        $box := layout.Rect{x: x,y: b.y,width: width,height: b.height}
        if g.appearance.vertical { height := math.max(0.0,b.height - gap * f64(count - 1)) / f64(max_int(1,count))
            box = layout.Rect{x: b.x,y: b.y + f64(i) * (height + gap),width: b.width,height: height} }
        g.boxes.push(box)
        x = x + width + gap }
    << 0
}
pub fn (g &ButtonGroup) item_bounds(key int) layout.Rect {
    i := g.index_of(key) or >>
    if i >= g.boxes.len { << copy_rect(&g.control.bounds) }
    << copy_rect(&g.boxes[i])
}
fn (g &ButtonGroup) hit(x f64,y f64) int { for i in 0:g.boxes.len { if g.boxes[i].contains(x,y) { << i } }
    << -1 }
fn (g $&ButtonGroup) activate(index int) Action {
    if index < 0 || !g.item_enabled(index) || g.control.read_only { << no_action(g.id(),g.needs_paint()) }
    key := g.items[index].key
    $kind := ACTION_ACTIVATE
    if g.mode != BUTTON_GROUP_ACTIONS { $selected := !((g.checked_items & (1 << index)) != 0)
        if g.mode == BUTTON_GROUP_SINGLE && !g.appearance.allow_empty { selected = true }
        g.set_checked(key,selected) or >>
        kind = ACTION_CHANGE }
    g.control.dirty = true
    << Action{kind: kind,id: g.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(key)}
}
pub fn (g $&ButtonGroup) input(event &ui.InputEvent) Action {
    if g.mode < BUTTON_GROUP_ACTIONS || g.mode > BUTTON_GROUP_MULTIPLE { >> errors.new("widgets: invalid button group mode") }
    if g.control.closed || !belongs(&g.control.identity,event) { << no_action(g.id(),g.needs_paint()) }
    if event.kind == ui.EV_POINTER_CANCEL { g.cancel()
        << no_action(g.id(),g.needs_paint()) }
    if !g.is_enabled() { << no_action(g.id(),g.needs_paint()) }
    index := g.hit(event.x,event.y)
    $action := no_action(g.id(),g.needs_paint())
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER { if g.hot != index { g.hot = index
        g.control.dirty = true } }
    else if event.kind == ui.EV_POINTER_LEAVE { g.hot = -1
        g.control.dirty = true }
    else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && index >= 0 {
        action.consumed = true
        if g.item_enabled(index) { g.active = index
            g.hot = index
            action.request_focus = true
            if !g.control.read_only { g.armed = index } }
        g.control.dirty = true }
    else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && g.armed >= 0 {
        if index == g.armed { action = g.activate(index) or >> }
        g.armed = -1
        action.consumed = true
        g.control.dirty = true }
    else if event.kind == ui.EV_KEY_DOWN && g.control.focused {
        $direction := 0
        if (!g.appearance.vertical && event.key == ui.KEY_RIGHT) || (g.appearance.vertical && event.key == ui.KEY_DOWN) { direction = 1 }
        if (!g.appearance.vertical && event.key == ui.KEY_LEFT) || (g.appearance.vertical && event.key == ui.KEY_UP) { direction = -1 }
        if direction != 0 { g.active = g.next_enabled(g.active,direction)
            g.key_armed = 0
            g.armed = -1
            action.consumed = true
            g.control.dirty = true }
        else if event.key == ui.KEY_HOME || event.key == ui.KEY_END {
            g.active = g.next_enabled(-1,1)
            if event.key == ui.KEY_END { g.active = g.next_enabled(g.items.len,-1) }
            g.key_armed = 0
            action.consumed = true
            g.control.dirty = true }
        else if event.key == ui.KEY_ESCAPE { g.armed = -1
            g.key_armed = 0
            action.consumed = true
            g.control.dirty = true }
        else if !g.control.read_only && g.active >= 0 && (event.key == ui.KEY_ENTER || event.key == 32) && event.repeat == 0 { g.key_armed = event.key
            action.consumed = true
            g.control.dirty = true }
    } else if event.kind == ui.EV_KEY_UP && g.control.focused && g.key_armed != 0 && event.key == g.key_armed {
        action = g.activate(g.active) or >>
        g.key_armed = 0 }
    action.needs_paint = g.needs_paint()
    << action
}
pub fn (g $&ButtonGroup) route(kind int,event &ui.InputEvent) Action {
    if kind == ROUTE_FOCUS { g.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { g.cancel() }
    else if kind == ROUTE_INPUT { << g.input(event) or >> }
    else { >> errors.new("widgets: invalid button group route") }
    << no_action(g.id(),g.needs_paint())
}
pub fn (g $&ButtonGroup) tick(styles &Styles,now time.Instant,reduced bool) bool {
    g.now = now
    g.reduced = reduced
    g.apply_styles(styles) or >>
    $changed := false
    for i in 0:g.items.len { style := g.item_style(i,styles) or >>
        state := g.item_state(i)
        $transition := g.transitions[i]
        before := transition.progress.value()
        _ := transition.style(&style,state,now,reduced) or >>
        if before != transition.progress.value() || transition.is_animating() { changed = true }
        g.transitions[i] = transition }
    if changed { g.control.dirty = true }
    << changed
}
pub fn (g &ButtonGroup) next_tick(now time.Instant) time.Instant {
    for t in g.transitions { if t.is_animating() { << overlay_next_tick(true,now) or >> } }
    << time.zero_instant()
}
pub fn (g $&ButtonGroup) paint_styled(frame $&draw.Frame,styles &Styles) int {
    g.apply_styles(styles) or >>
    for i in 0:g.items.len {
        b := g.boxes[i]
        base := g.item_style(i,styles) or >>
        state := g.item_state(i)
        $transition := g.transitions[i]
        $style := transition.style(&base,state,g.now,g.reduced) or >>
        g.transitions[i] = transition
        if g.appearance.joined { g.paint_joined(frame,i,&b,&style,styles.density,state) or >> }
        else { style_box(frame,&b,&style,styles.density,state) or >> }
        text := g.items[i].label + ""
        labels := $&g.labels
        labels.paint_text(i,&text,frame,&b,styles,&style,state) or >>
    }
    << 0
}
pub fn (g $&ButtonGroup) dispose() { if g.control.closed { << }
    labels := $&g.labels
    labels.dispose()
    g.cancel()
    g.control.closed = true }
