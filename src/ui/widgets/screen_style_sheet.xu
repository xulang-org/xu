@ui/widgets

// Appearance contains no event callbacks or business context. Applying it only
// updates style/motion state and invalidation; it does not dispatch actions.
pub struct Appearance{
    pub styles Styles
    pub reduced_motion bool
}
pub fn screen_appearance(styles &Styles, reduced_motion bool) Appearance{
    styles.validate() or >>
    << Appearance{styles: styles.clone(), reduced_motion: reduced_motion}
}
pub fn (s $&Screen) apply_appearance(appearance &Appearance) int {
    s.set_styles(&appearance.styles) or >>
    s.set_reduced_motion(appearance.reduced_motion)
    << 0
}
