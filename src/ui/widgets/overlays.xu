@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

// Placement is in logical canvas pixels. Dimensions are clipped to the
// viewport; the caller clips child content to bounds() when painting it.
pub fn anchored_overlay_bounds(anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) layout.Rect {
    validate_bounds(anchor) or >>
    validate_bounds(viewport) or >>
    desired := layout.Rect{x: 0.0,y: 0.0,width: size.width,height: size.height}
    validate_bounds(&desired) or >>
    gap := 6.0
    width := math.min(size.width,viewport.width)
    height := math.min(size.height,viewport.height)
    mut x := anchor.x
    mut y := anchor.y + anchor.height + gap
    below := viewport.y + viewport.height - y
    above := anchor.y - gap - viewport.y
    if height > below && above > below { y = anchor.y - gap - height }
    x = math.max(viewport.x,math.min(x,viewport.x + viewport.width - width))
    y = math.max(viewport.y,math.min(y,viewport.y + viewport.height - height))
    << layout.Rect{x: x,y: y,width: width,height: height}
}
fn overlay_same_rect(a &layout.Rect,b &layout.Rect) bool {
    << a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}
fn overlay_next_tick(animated bool,now time.Instant) time.Instant {
    if !animated { << time.zero_instant() }
    << now.add(time.milliseconds(16) or >>) or >>
}
fn overlay_action(id int,changed bool,dirty bool,consumed bool) Action {
    mut kind := action_none
    if changed { kind = action_change }
    << Action{kind: kind,id: id,needs_paint: dirty,request_focus: false,consumed: consumed,value: 0.0}
}

// Apply opacity after resolving a label override. Reusing paint_text_styled
// would reapply the un-faded override and make locally styled text flash.
fn paint_overlay_label(frame &mut draw.Frame,label &mut StyledLabel,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,opacity f64,box bool) int {
    base := label.style_or(fallback)
    _ := label.measure_styled(styles,&base) or >>
    shaped := label.layouts[0]
    c := base.with_opacity(opacity) or >>
    if box { paint_box_styled(frame,bounds,styles,&c,0) or >> }
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    width := math.max(0.0,bounds.width - left - c.padding.right * d)
    height := math.max(0.0,bounds.height - top - c.padding.bottom * d)
    frame.push() or >>
    frame.clip_rect(bounds.x + left,bounds.y + top,width,height) or >>
    frame.text_layout(&shaped,bounds.x + left + (width - shaped.metrics.width) * c.align_x,
        bounds.y + top + (height - shaped.metrics.height) * c.align_y,c.resolve(0).foreground) or >>
    frame.pop() or >>
    << 0
}

pub struct Popover {
    identity ui.CanvasEvent
    id_val int
    anchor layout.Rect
    extent layout.Size
    viewport layout.Rect
    panel layout.Rect
    opened bool
    enabled bool
    dirty bool
    reduced bool
    fade Tween
}
pub fn popover(identity &ui.CanvasEvent,id int,anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) Popover {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid popover identity") }
    panel := anchored_overlay_bounds(anchor,size,viewport) or >>
    fade := tween(0.0) or >>
    << Popover{identity: copy_identity(identity),id_val: id,anchor: copy_rect(anchor),extent: layout.Size{width: size.width,height: size.height},
        viewport: copy_rect(viewport),panel: panel,opened: false,enabled: true,dirty: true,reduced: false,fade: fade}
}
pub fn (p &Popover) id() int { << p.id_val }
pub fn (p &Popover) bounds() layout.Rect { << copy_rect(&p.panel) }
pub fn (p &Popover) is_enabled() bool { << p.enabled }
pub fn (p &Popover) is_open() bool { << p.opened && p.enabled }
pub fn (p &Popover) is_visible() bool { << p.enabled && (p.opened || p.fade.value() > 0.0) }
pub fn (p &Popover) opacity() f64 { << p.fade.value() }
pub fn (p &Popover) needs_paint() bool { << p.dirty }
pub fn (p &mut Popover) painted() { p.dirty = false }
pub fn (p &mut Popover) set_geometry(anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) int {
    next := anchored_overlay_bounds(anchor,size,viewport) or >>
    if next.x != p.panel.x || next.y != p.panel.y || next.width != p.panel.width || next.height != p.panel.height { p.dirty = true }
    p.anchor = copy_rect(anchor)
    p.extent = layout.Size{width: size.width,height: size.height}
    p.viewport = copy_rect(viewport)
    p.panel = next
    << 0
}
pub fn (p &mut Popover) open(now time.Instant,reduced_motion bool) int {
    if !p.enabled { << 0 }
    if !p.opened { p.dirty = true }
    p.opened = true
    p.reduced = reduced_motion
    fade := mut &p.fade
    fade.retarget(1.0,now,time.milliseconds(130) or >>,reduced_motion) or >>
    << 0
}
pub fn (p &mut Popover) close(now time.Instant,reduced_motion bool) int {
    if p.opened || p.fade.is_animating() { p.dirty = true }
    p.opened = false
    p.reduced = reduced_motion
    fade := mut &p.fade
    fade.retarget(0.0,now,time.milliseconds(95) or >>,reduced_motion) or >>
    << 0
}
pub fn (p &mut Popover) set_enabled(enabled bool) int {
    if p.enabled != enabled { p.dirty = true }
    p.enabled = enabled
    if !enabled { p.close(time.zero_instant(),true) or >> }
    << 0
}
pub fn (p &mut Popover) tick(now time.Instant,reduced_motion bool) bool {
    target := 0.0
    mut next := target
    if p.opened && p.enabled { next = 1.0 }
    before := p.fade.value()
    p.reduced = reduced_motion
    fade := mut &p.fade
    if reduced_motion { fade.retarget(next,now,time.duration(0),true) or >> }
    else { _ := fade.advance(now) or >> }
    changed := before != p.fade.value()
    if changed { p.dirty = true }
    << changed
}
pub fn (p &Popover) next_tick(now time.Instant) time.Instant { << overlay_next_tick(p.fade.is_animating(),now) or >> }
// Call before ordinary View dispatch. Outside presses and Escape are consumed;
// events inside the surface are forwarded to its own content by the host.
pub fn (p &mut Popover) input(event &ui.InputEvent) Action {
    if !belongs(&p.identity,event) || !p.is_open() { << no_action(p.id_val,p.dirty) }
    if event.kind == ui.ev_pointer_cancel { p.close(time.instant_from_ns(event.time_ns) or >>,true) or >>
        << overlay_action(p.id_val,true,p.dirty,false) }
    escape := event.kind == ui.ev_key_down && event.key == ui.key_escape
    outside := event.kind == ui.ev_pointer_down && !p.panel.contains(event.x,event.y) && !p.anchor.contains(event.x,event.y)
    if escape || outside {
        reduced := p.reduced
        p.close(time.instant_from_ns(event.time_ns) or >>,reduced) or >>
        << overlay_action(p.id_val,true,p.dirty,true)
    }
    << no_action(p.id_val,p.dirty)
}
pub fn (p &mut Popover) route(kind int,event &ui.InputEvent) Action {
    if kind < route_input || kind > route_cancel { >> errors.new("widgets: invalid route kind") }
    if !belongs(&p.identity,event) { << no_action(p.id_val,p.dirty) }
    if kind == route_blur || kind == route_cancel { p.close(time.instant_from_ns(event.time_ns) or >>,true) or >>
        << no_action(p.id_val,p.dirty) }
    if kind == route_focus { << no_action(p.id_val,p.dirty) }
    << p.input(event) or >>
}
pub fn (p &Popover) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    if !p.is_visible() { << 0 }
    c := styles.card_style().with_opacity(p.opacity()) or >>
    << paint_box_styled(frame,&p.panel,styles,&c,0) or >>
}

// Modal owns the keyboard focus order, while the host owns the actual child
// controls. Use blocks_input() as the dispatch gate, including the closing fade.
// Cancel background View input before open (cancel_input) to release
// capture and native editor focus. Apply focused_id() after open/input, and restore
// take_restore_focus() after tick reports the closing fade finished. Never
// dispatch to background while blocks_input():
// first call input(), honor consumed even when that input closes the modal,
// then dispatch only to modal children if allows_content().
pub struct Modal {
    identity ui.CanvasEvent
    id_val int
    panel Popover
    viewport layout.Rect
    order []int
    focus_index int
    restore_id int
    restore_pending bool
    outside_close bool
    close_armed bool
    dirty bool
}
pub fn modal(identity &ui.CanvasEvent,id int,bounds &layout.Rect,viewport &layout.Rect) Modal {
    validate_bounds(bounds) or >>
    size := layout.Size{width: bounds.width,height: bounds.height}
    anchor := layout.Rect{x: bounds.x,y: bounds.y - 6.0,width: 0.0,height: 0.0}
    panel := popover(identity,id,&anchor,&size,viewport) or >>
    << Modal{identity: copy_identity(identity),id_val: id,panel: panel,viewport: copy_rect(viewport),order: []int{},focus_index: -1,
        restore_id: 0,restore_pending: false,outside_close: false,close_armed: false,dirty: true}
}
pub fn (m &Modal) id() int { << m.id_val }
pub fn (m &Modal) bounds() layout.Rect { << m.panel.bounds() }
pub fn (m &Modal) is_enabled() bool { << m.panel.is_enabled() }
pub fn (m &Modal) is_open() bool { << m.panel.is_open() }
pub fn (m &Modal) is_visible() bool { << m.panel.is_visible() }
// Keep background input blocked throughout the closing fade.
pub fn (m &Modal) blocks_input() bool { << m.is_visible() }
pub fn (m &Modal) opacity() f64 { << m.panel.opacity() }
pub fn (m &Modal) needs_paint() bool { << m.dirty || m.panel.needs_paint() }
pub fn (m &mut Modal) painted() { m.dirty = false
    panel := mut &m.panel
    panel.painted() }
pub fn (m &mut Modal) set_dismiss_on_outside(enabled bool) { m.outside_close = enabled }
pub fn (m &Modal) focused_id() int {
    if !m.is_open() || m.focus_index < 0 || m.focus_index >= m.order.len { << 0 }
    << m.order[m.focus_index]
}
pub fn (m &Modal) focus_restore_id() int { << m.restore_id }
// Restore native/editor focus only after the overlay has disappeared.
pub fn (m &mut Modal) take_restore_focus() int {
    if !m.restore_pending || m.is_visible() { << 0 }
    m.restore_pending = false
    << m.restore_id
}
pub fn (m &Modal) contains_focus(id int) bool {
    for child in m.order { if child == id { << true } }
    << false
}
pub fn (m &mut Modal) set_focus_order(ids &[]int) int {
    if ids.len > 256 { >> errors.new("widgets: too many modal focus targets") }
    mut order := []int{}
    for id in ids {
        if id <= 0 || id == m.id_val { >> errors.new("widgets: invalid modal focus target") }
        for previous in order { if previous == id { >> errors.new("widgets: duplicate modal focus target") } }
        order.push(id)
    }
    current := m.focused_id()
    m.order = order
    m.focus_index = -1
    if m.order.len > 0 { m.focus_index = 0 }
    for i in 0:m.order.len { if m.order[i] == current { m.focus_index = i } }
    m.dirty = true
    << 0
}
pub fn (m &mut Modal) set_content_focus(id int) int {
    for i in 0:m.order.len { if m.order[i] == id { m.focus_index = i
        m.dirty = true
        << 0 } }
    >> errors.new("widgets: focus target is outside modal")
}
pub fn (m &mut Modal) open(now time.Instant,reduced_motion bool,restore_focus int) int {
    if restore_focus < 0 { >> errors.new("widgets: invalid restore focus") }
    if !m.is_visible() {
        m.restore_id = restore_focus
        m.focus_index = -1
        if m.order.len > 0 { m.focus_index = 0 }
    }
    m.restore_pending = false
    m.close_armed = false
    m.dirty = true
    panel := mut &m.panel
    << panel.open(now,reduced_motion) or >>
}
pub fn (m &mut Modal) close(now time.Instant,reduced_motion bool) int {
    if m.is_visible() { m.restore_pending = true }
    m.close_armed = false
    m.dirty = true
    panel := mut &m.panel
    << panel.close(now,reduced_motion) or >>
}
pub fn (m &mut Modal) set_enabled(enabled bool) int {
    if !enabled && m.is_visible() { m.restore_pending = true }
    m.close_armed = false
    m.dirty = true
    panel := mut &m.panel
    << panel.set_enabled(enabled) or >>
}
pub fn (m &mut Modal) set_geometry(bounds &layout.Rect,viewport &layout.Rect) int {
    validate_bounds(bounds) or >>
    validate_bounds(viewport) or >>
    size := layout.Size{width: bounds.width,height: bounds.height}
    anchor := layout.Rect{x: bounds.x,y: bounds.y - 6.0,width: 0.0,height: 0.0}
    next := anchored_overlay_bounds(&anchor,&size,viewport) or >>
    previous := m.bounds()
    if !overlay_same_rect(&next,&previous) || !overlay_same_rect(viewport,&m.viewport) {
        m.viewport = copy_rect(viewport)
        m.close_armed = false
        m.dirty = true
    }
    panel := mut &m.panel
    << panel.set_geometry(&anchor,&size,viewport) or >>
}
pub fn (m &Modal) close_bounds() layout.Rect {
    b := m.bounds()
    size := math.min(28.0,math.min(b.width,b.height))
    << layout.Rect{x: b.x + b.width - size,y: b.y,width: size,height: size}
}
pub fn (m &Modal) allows_content(event &ui.InputEvent) bool {
    if !m.is_open() || !belongs(&m.identity,event) { << false }
    if event.kind == ui.ev_key_down || event.kind == ui.ev_key_up { << m.focused_id() > 0 && event.key != ui.key_tab && event.key != ui.key_escape }
    if event.kind == ui.ev_pointer_cancel { << true }
    << m.bounds().contains(event.x,event.y) && !m.close_bounds().contains(event.x,event.y)
}
pub fn (m &mut Modal) input(event &ui.InputEvent) Action {
    if !belongs(&m.identity,event) || !m.blocks_input() { << no_action(m.id_val,m.needs_paint()) }
    if !m.is_open() { << overlay_action(m.id_val,false,m.needs_paint(),true) }
    now := time.instant_from_ns(event.time_ns) or >>
    reduced := m.panel.reduced
    escape := event.kind == ui.ev_key_down && event.key == ui.key_escape
    inside := m.bounds().contains(event.x,event.y)
    close_hit := m.close_bounds().contains(event.x,event.y)
    outside := event.kind == ui.ev_pointer_down && !inside && m.outside_close
    if escape || outside { m.close(now,reduced) or >>
        << overlay_action(m.id_val,true,m.needs_paint(),true) }
    if event.kind == ui.ev_key_down && event.key == ui.key_tab {
        if m.order.len > 0 {
            mut delta := 1
            if (event.modifiers & ui.mod_shift) != 0 { delta = -1 }
            m.focus_index = m.focus_index + delta
            if m.focus_index < 0 { m.focus_index = m.order.len - 1 }
            else if m.focus_index >= m.order.len { m.focus_index = 0 }
            m.dirty = true
        }
        << Action{kind: action_none,id: m.id_val,needs_paint: m.needs_paint(),request_focus: true,consumed: true,value: f64(m.focused_id())}
    }
    if event.kind == ui.ev_pointer_cancel { m.close_armed = false }
    if event.kind == ui.ev_pointer_down && event.button == ui.button_left && close_hit { m.close_armed = true
        m.dirty = true
        << overlay_action(m.id_val,false,true,true) }
    if event.kind == ui.ev_pointer_up && event.button == ui.button_left && m.close_armed {
        m.close_armed = false
        m.dirty = true
        if close_hit { m.close(now,reduced) or >> }
        << overlay_action(m.id_val,close_hit,true,true)
    }
    << overlay_action(m.id_val,false,m.needs_paint(),!m.allows_content(event))
}
pub fn (m &mut Modal) route(kind int,event &ui.InputEvent) Action {
    if kind < route_input || kind > route_cancel { >> errors.new("widgets: invalid route kind") }
    if !belongs(&m.identity,event) { << no_action(m.id_val,m.needs_paint()) }
    if kind == route_blur || kind == route_cancel { m.close_armed = false
        m.dirty = true
        << no_action(m.id_val,true) }
    if kind == route_focus { << no_action(m.id_val,m.needs_paint()) }
    << m.input(event) or >>
}
pub fn (m &mut Modal) tick(now time.Instant,reduced_motion bool) bool { panel := mut &m.panel
    << panel.tick(now,reduced_motion) or >> }
pub fn (m &Modal) next_tick(now time.Instant) time.Instant { << m.panel.next_tick(now) or >> }
pub fn (m &Modal) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    if !m.is_visible() { << 0 }
    v := m.viewport
    frame.fill_rect(v.x,v.y,v.width,v.height,draw.rgba(0,0,0,int(105.0 * m.opacity()))) or >>
    m.panel.paint_styled(frame,styles) or >>
    b := m.close_bounds()
    c := styles.card_style().with_opacity(m.opacity()) or >>
    ink := c.resolve(0).foreground
    mid_x := b.x + b.width * 0.5
    mid_y := b.y + b.height * 0.5
    half := math.min(4.0,b.width * 0.2)
    frame.line(mid_x - half,mid_y - half,mid_x + half,mid_y + half,ink,1.5) or >>
    frame.line(mid_x + half,mid_y - half,mid_x - half,mid_y + half,ink,1.5) or >>
    << 0
}
