@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

// Placement is in logical canvas pixels. Dimensions are clipped to the
// viewport; the caller clips child content to bounds() when painting it.
pub fn anchored_overlay_bounds(anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) layout.Rect {
    validate_bounds(anchor) >>>
    validate_bounds(viewport) >>>
    desired := layout.Rect{x: 0.0,y: 0.0,width: size.width,height: size.height}
    validate_bounds(&desired) >>>
    gap := 6.0
    width := math.min(size.width,viewport.width)
    height := math.min(size.height,viewport.height)
    $x := anchor.x
    $y := anchor.y + anchor.height + gap
    below := viewport.y + viewport.height - y
    above := anchor.y - gap - viewport.y
    if height > below && above > below { y = anchor.y - gap - height }
    x = math.max(viewport.x,math.min(x,viewport.x + viewport.width - width))
    y = math.max(viewport.y,math.min(y,viewport.y + viewport.height - height))
    << layout.Rect{x: x,y: y,width: width,height: height}
}
fn overlay_same_rect(a &layout.Rect,b &layout.Rect) bool {
    << a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height
}
pub fn overlay_next_tick(animated bool,now time.Instant) time.Instant {
    if !animated { << time.zero_instant() }
    << now.add(time.milliseconds(16) >>>) >>>
}
fn overlay_action(id int,changed bool,dirty bool,consumed bool) Action {
    $kind := ACTION_NONE
    if changed { kind = ACTION_CHANGE }
    << Action{kind: kind,id: id,needs_paint: dirty,request_focus: false,consumed: consumed,value: 0.0}
}

// Apply opacity after resolving a label override. Reusing paint_text_styled
// would reapply the un-faded override and make locally styled text flash.
fn paint_overlay_label(frame $&draw.Frame,label $&StyledLabel,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,opacity f64,box bool) int {
    << paint_overlay_label_selected(frame,label,bounds,styles,fallback,opacity,box,0,0) >>>
}
fn paint_overlay_label_selected(frame $&draw.Frame,label $&StyledLabel,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,opacity f64,box bool,sel_anchor int,sel_focus int) int {
    base := label.style_or(fallback)
    width_limit := math.max(1.0,bounds.width-(base.padding.left+base.padding.right)*styles.density)
    _ := label.measure_wrapped(styles,&base,width_limit) >>>
    shaped := label.layouts[0]
    c := base.with_opacity(opacity) >>>
    if box { paint_box_styled(frame,bounds,styles,&c,0) >>> }
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    width := math.max(0.0,bounds.width - left - c.padding.right * d)
    height := math.max(0.0,bounds.height - top - c.padding.bottom * d)
    resolved := c.resolve(0)
    frame.push() >>>
    frame.clip_rect(bounds.x + left,bounds.y + top,width,height) >>>
    paint_styled_label_at_origin(label,frame,bounds.x + left + (width - shaped.metrics.width) * c.align_x,
        bounds.y + top + (height - shaped.metrics.height) * c.align_y,&resolved,sel_anchor,sel_focus) >>>
    frame.pop() >>>
    << 0
}
fn overlay_empty_style(c &ControlStyle) ControlStyle {
    $res := c.clone()
    res.border_width = 0.0
    res.shadow = draw.rgba(0,0,0,0)
    res.shadow_blur = 0.0
    res.shadow_spread = 0.0
    res.shadow_x = 0.0
    res.shadow_y = 0.0
    res.states = []StatePaint{}
    << res
}
fn overlay_set_aux_text(aux $&map[int]SelectableText,context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,viewport &layout.Rect,selectable bool,text &string) int {
    if !aux.has(0) {
        $item := selectable_text(context,identity,id,bounds,text) >>>
        item.set_wrapped(true)
        item.set_selectable(selectable)
        item.set_viewport(viewport)
        aux[0] = item
        << 0
    }
    $item := aux.take(0) >>> (err) { >>> err }
    rc := overlay_update_aux($&item,bounds,viewport,selectable,text)
    aux[0] = item
    if rc < 0 { >>> errors.new("widgets: invalid overlay text") }
    << 0
}
fn overlay_update_aux(item $&SelectableText,bounds &layout.Rect,viewport &layout.Rect,selectable bool,text &string) int {
    item.set_bounds(bounds) >>> (err) { << -1 }
    item.set_text(text) >>> (err) { << -1 }
    item.set_wrapped(true)
    item.set_selectable(selectable)
    item.set_viewport(viewport)
    << 0
}
fn overlay_sync_item(item $&SelectableText,bounds &layout.Rect,viewport &layout.Rect) {
    _ := item.set_bounds(bounds) >>> (err) { << }
    item.set_viewport(viewport)
}
fn overlay_sync_aux(aux $&map[int]SelectableText,bounds &layout.Rect,viewport &layout.Rect) {
    if !aux.has(0) { << }
    $item := aux.take(0) >>> (err) { << }
    overlay_sync_item($&item,bounds,viewport)
    aux[0] = item
}
fn overlay_item_set_selectable(item $&SelectableText,selectable bool) {
    item.set_selectable(selectable)
}
fn overlay_set_aux_selectable(aux $&map[int]SelectableText,selectable bool) bool {
    if !aux.has(0) { << false }
    $item := aux.take(0) >>> (err) { << false }
    overlay_item_set_selectable($&item,selectable)
    aux[0] = item
    << true
}
fn overlay_item_set_locale(item $&SelectableText,locale &Locale) bool {
    _ := item.set_locale(locale) >>> (err) { << false }
    << true
}
fn overlay_set_aux_locale(aux $&map[int]SelectableText,locale &Locale) int {
    locale.validate() >>>
    if !aux.has(0) { << 0 }
    $item := aux.take(0) >>> (err) { >>> err }
    ok := overlay_item_set_locale($&item,locale)
    aux[0] = item
    if !ok { >>> errors.new("widgets: invalid overlay locale") }
    << 0
}
fn overlay_aux_has_popup(aux &map[int]SelectableText) bool { << aux.has(0) && aux[0].has_popup_open() }
fn overlay_aux_popup_bounds(aux &map[int]SelectableText) layout.Rect {
    if !aux.has(0) { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
    << aux[0].popup_bounds()
}
fn overlay_aux_sel_range(aux &map[int]SelectableText) ui.TextRange {
    if !aux.has(0) { << ui.TextRange{start: 0,end: 0} }
    << aux[0].selection_range()
}
fn overlay_aux_selected_text(aux &map[int]SelectableText) string {
    if !aux.has(0) { << "" }
    << aux[0].selected_text()
}
fn overlay_aux_copy(aux &map[int]SelectableText) int {
    if !aux.has(0) { << 0 }
    << aux[0].copy_selection()
}
fn overlay_aux_needs_paint(aux &map[int]SelectableText) bool { << aux.has(0) && aux[0].needs_paint() }
fn overlay_item_painted(item $&SelectableText) {
    item.painted()
}
fn overlay_aux_painted(aux $&map[int]SelectableText) {
    if !aux.has(0) { << }
    $item := aux.take(0) >>> (err) { << }
    overlay_item_painted($&item)
    aux[0] = item
}
fn overlay_item_clear(item $&SelectableText) {
    _ := item.clear_selection()
    if item.has_popup_open() {
        ev := ui.InputEvent{kind: ui.EV_KEY_DOWN,window_id: item.identity.window_id,canvas_id: item.identity.canvas_id,generation: item.identity.generation,
            x: 0.0,y: 0.0,dx: 0.0,dy: 0.0,button: 0,buttons: 0,modifiers: 0,key: ui.KEY_ESCAPE,scan: 0,repeat: 0,click_count: 0,time_ns: 0}
        _ := item.input(&ev)
    }
}
fn overlay_aux_clear(aux $&map[int]SelectableText) {
    if !aux.has(0) { << }
    $item := aux.take(0) >>> (err) { << }
    overlay_item_clear($&item)
    aux[0] = item
}
fn overlay_item_dispose(item $&SelectableText) {
    item.dispose()
}
fn overlay_aux_dispose(aux $&map[int]SelectableText) {
    if !aux.has(0) { << }
    $item := aux.take(0) >>> (err) { << }
    overlay_item_dispose($&item)
    aux[0] = item
}
fn overlay_item_set_bounds(item $&SelectableText,bounds &layout.Rect) {
    _ := item.set_bounds(bounds) >>> (err) { << }
}
fn overlay_aux_set_bounds(aux $&map[int]SelectableText,bounds &layout.Rect) {
    if !aux.has(0) { << }
    $item := aux.take(0) >>> (err) { << }
    overlay_item_set_bounds($&item,bounds)
    aux[0] = item
}
fn overlay_item_route_input(item $&SelectableText,bounds &layout.Rect,event &ui.InputEvent) Action {
    _ := item.set_bounds(bounds) >>> (err) { << no_action(item.id(),false) }
    if item.has_popup_open() || bounds.contains(event.x,event.y) || item.is_selecting() || (event.kind == ui.EV_KEY_DOWN && item.is_focused()) {
        << item.input(event)
    }
    << no_action(item.id(),false)
}
fn overlay_route_aux_input(aux $&map[int]SelectableText,bounds &layout.Rect,event &ui.InputEvent) Action {
    if !aux.has(0) { << no_action(0,false) }
    $item := aux.take(0) >>> (err) { << no_action(0,false) }
    act := overlay_item_route_input($&item,bounds,event)
    aux[0] = item
    << act
}
fn overlay_paint_aux_text(aux $&map[int]SelectableText,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,base &ControlStyle,opacity f64) int {
    if !aux.has(0) { << 0 }
    op_base := base.with_opacity(opacity) >>>
    faded := overlay_empty_style(&op_base)
    $item := aux.take(0) >>> (err) { >>> err }
    err_msg := overlay_paint_aux_item($&item,frame,bounds,styles,&faded)
    aux[0] = item
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}
fn overlay_paint_aux_item(item $&SelectableText,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,style &ControlStyle) string {
    item.set_style(style) >>> (err) { << err.msg() }
    frame.push() >>> (err) { << err.msg() }
    frame.translate(bounds.x,bounds.y) >>> (err) { frame.pop() >>> (e2) { << e2.msg() }
        << err.msg() }
    item.paint_styled(frame,styles) >>> (err) { frame.pop() >>> (e2) { << e2.msg() }
        << err.msg() }
    frame.pop() >>> (err) { << err.msg() }
    << ""
}
fn overlay_paint_aux_popup(aux $&map[int]SelectableText,frame $&draw.Frame,styles &Styles) int {
    if !aux.has(0) { << 0 }
    $item := aux.take(0) >>> (err) { >>> err }
    err_msg := overlay_paint_aux_popup_item($&item,frame,styles)
    aux[0] = item
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}
fn overlay_paint_aux_popup_item(item $&SelectableText,frame $&draw.Frame,styles &Styles) string {
    item.paint_popup_styled(frame,styles) >>> (err) { << err.msg() }
    << ""
}

pub struct Popover {
    placement OverlayPlacement
    close_outside bool
    close_escape bool
    identity ui.CanvasEvent
    id_val int
    anchor layout.Rect
    extent layout.Size
    viewport layout.Rect
    panel layout.Rect
    opened bool
    enabled bool
    dirty bool
    reduced bool
    selectable bool
    fade Tween
    custom ScalarControlStyle
    motion MotionSpec
    aux map[int]SelectableText
}
pub fn popover(identity &ui.CanvasEvent,id int,anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) Popover {
    if !valid_identity(identity) || id <= 0 { >>> errors.new("widgets: invalid popover identity") }
    panel := anchored_overlay_bounds(anchor,size,viewport) >>>
    fade := tween(0.0) >>>
    << Popover{placement: overlay_placement(),close_outside: true,close_escape: true,identity: copy_identity(identity),id_val: id,anchor: copy_rect(anchor),extent: layout.Size{width: size.width,height: size.height},
        viewport: copy_rect(viewport),panel: panel,opened: false,enabled: true,dirty: true,reduced: false,selectable: false,fade: fade,custom: empty_scalar_style(),motion: motion_spec(),aux: map[int]SelectableText{}}
}
pub fn (p &Popover) id() int { << p.id_val }
pub fn (p &Popover) bounds() layout.Rect { << copy_rect(&p.panel) }
pub fn (p &Popover) is_enabled() bool { << p.enabled }
pub fn (p &Popover) is_selectable() bool { << p.selectable }
pub fn (p $&Popover) set_selectable(selectable bool) {
    if p.selectable != selectable { p.dirty = true }
    p.selectable = selectable
    aux := $&p.aux
    _ := overlay_set_aux_selectable(aux,selectable)
}
pub fn (p $&Popover) set_text(context &draw.Context,text &string) int {
    id := p.id_val
    bounds := copy_rect(&p.panel)
    viewport := copy_rect(&p.viewport)
    sel := p.selectable
    idn := copy_identity(&p.identity)
    aux := $&p.aux
    overlay_set_aux_text(aux,context,&idn,id,&bounds,&viewport,sel,text) >>>
    p.dirty = true
    << 0
}
pub fn (p &Popover) has_popup_open() bool { << overlay_aux_has_popup(&p.aux) }
pub fn (p &Popover) popup_bounds() layout.Rect { << overlay_aux_popup_bounds(&p.aux) }
pub fn (p &Popover) selected_text() string { << overlay_aux_selected_text(&p.aux) }
pub fn (p &Popover) copy_selection() int { << overlay_aux_copy(&p.aux) }
pub fn (p &Popover) selection_range() ui.TextRange { << overlay_aux_sel_range(&p.aux) }
pub fn (p &Popover) cursor() int {
    if p.is_open() && p.selectable && p.aux.has(0) && !p.has_popup_open() { << ui.CURSOR_TEXT }
    << ui.CURSOR_DEFAULT
}
pub fn (p $&Popover) set_viewport(viewport &layout.Rect) {
    p.viewport = copy_rect(viewport)
    bounds := copy_rect(&p.panel)
    aux := $&p.aux
    overlay_sync_aux(aux,&bounds,viewport)
}
pub fn (p $&Popover) set_locale(locale &Locale) int {
    aux := $&p.aux
    << overlay_set_aux_locale(aux,locale) >>>
}
pub fn (p &Popover) is_open() bool { << p.opened && p.enabled }
pub fn (p &Popover) is_visible() bool { << p.enabled && (p.opened || p.fade.value() > 0.0) }
pub fn (p &Popover) opacity() f64 { << p.fade.value() }
pub fn (p &Popover) needs_paint() bool { << p.dirty || overlay_aux_needs_paint(&p.aux) }
pub fn (p $&Popover) painted() {
    p.dirty = false
    aux := $&p.aux
    overlay_aux_painted(aux)
}
pub fn (p $&Popover) set_geometry(anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) int {
    next := placed_overlay_bounds(anchor,size,viewport,&p.placement) >>>
    if next.x != p.panel.x || next.y != p.panel.y || next.width != p.panel.width || next.height != p.panel.height { p.dirty = true }
    p.anchor = copy_rect(anchor)
    p.extent = layout.Size{width: size.width,height: size.height}
    p.viewport = copy_rect(viewport)
    p.panel = next
    panel_rect := copy_rect(&p.panel)
    vp_rect := copy_rect(&p.viewport)
    aux := $&p.aux
    overlay_sync_aux(aux,&panel_rect,&vp_rect)
    << 0
}
pub fn (p $&Popover) open(now time.Instant,reduced_motion bool) int {
    if !p.enabled { << 0 }
    if !p.opened { p.dirty = true }
    p.opened = true
    p.reduced = reduced_motion
    duration := p.motion.enter
    curve := p.motion.curve
    fade := $&p.fade
    fade.retarget_unit(1.0,now,duration,reduced_motion) >>>
    fade.set_curve(curve) >>>
    << 0
}
pub fn (p $&Popover) close(now time.Instant,reduced_motion bool) int {
    if p.opened || p.fade.is_animating() { p.dirty = true }
    p.opened = false
    p.reduced = reduced_motion
    duration := p.motion.exit
    curve := p.motion.exit_easing()
    fade := $&p.fade
    fade.retarget_unit(0.0,now,duration,reduced_motion) >>>
    fade.set_curve(curve) >>>
    if true {
        aux := $&p.aux
        overlay_aux_clear(aux)
    }
    << 0
}
pub fn (p $&Popover) set_enabled(enabled bool) int {
    if p.enabled != enabled { p.dirty = true }
    p.enabled = enabled
    if !enabled {
        p.close(time.zero_instant(),true) >>>
        aux := $&p.aux
        overlay_aux_dispose(aux)
    }
    << 0
}
pub fn (p $&Popover) tick(now time.Instant,reduced_motion bool) bool {
    target := 0.0
    $next := target
    if p.opened && p.enabled { next = 1.0 }
    before := p.fade.value()
    p.reduced = reduced_motion
    fade := $&p.fade
    if reduced_motion { fade.retarget(next,now,time.duration(0),true) >>> }
    else { _ := fade.advance(now) >>> }
    changed := before != p.fade.value()
    if changed { p.dirty = true }
    << changed
}
pub fn (p &Popover) next_tick(now time.Instant) time.Instant { << overlay_next_tick(p.fade.is_animating(),now) >>> }
// Call before ordinary View dispatch. Outside presses and Escape are consumed;
// events inside the surface are forwarded to its own content by the host.
pub fn (p $&Popover) input(event &ui.InputEvent) Action {
    if !belongs(&p.identity,event) || !p.is_open() { << no_action(p.id_val,p.dirty) }
    if event.kind == ui.EV_POINTER_CANCEL { p.close(time.instant_from_ns(event.time_ns) >>>,true) >>>
        << overlay_action(p.id_val,true,p.dirty,false) }
    panel_rect := copy_rect(&p.panel)
    if p.has_popup_open() {
        $act := no_action(p.id_val,false)
        if true {
            aux := $&p.aux
            act = overlay_route_aux_input(aux,&panel_rect,event)
        }
        if act.needs_paint { p.dirty = true }
        << Action{kind: ACTION_NONE,id: p.id_val,needs_paint: p.needs_paint(),request_focus: act.request_focus,consumed: true,value: 0.0}
    }
    escape := event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_ESCAPE
    outside := event.kind == ui.EV_POINTER_DOWN && !p.panel.contains(event.x,event.y) && !p.anchor.contains(event.x,event.y)
    if (escape && p.close_escape) || (outside && p.close_outside) {
        reduced := p.reduced
        p.close(time.instant_from_ns(event.time_ns) >>>,reduced) >>>
        << overlay_action(p.id_val,true,p.dirty,true)
    }
    if p.selectable && p.aux.has(0) {
        $act := no_action(p.id_val,false)
        if true {
            aux := $&p.aux
            act = overlay_route_aux_input(aux,&panel_rect,event)
        }
        if act.needs_paint { p.dirty = true }
        if act.consumed {
            << Action{kind: ACTION_NONE,id: p.id_val,needs_paint: p.needs_paint(),request_focus: act.request_focus,consumed: true,value: 0.0}
        }
    }
    << no_action(p.id_val,p.dirty)
}
pub fn (p $&Popover) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >>> errors.new("widgets: invalid route kind") }
    if !belongs(&p.identity,event) { << no_action(p.id_val,p.dirty) }
    if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { p.close(time.instant_from_ns(event.time_ns) >>>,true) >>>
        << no_action(p.id_val,p.dirty) }
    if kind == ROUTE_FOCUS { << no_action(p.id_val,p.dirty) }
    << p.input(event) >>>
}
pub fn (p &Popover) paint_styled(frame $&draw.Frame,styles &Styles) int {
    if !p.is_visible() { << 0 }
    c := p.style_or(styles).with_opacity(p.opacity()) >>>
    << paint_box_styled(frame,&p.panel,styles,&c,0) >>>
}
pub fn (p $&Popover) paint_content_styled(frame $&draw.Frame,styles &Styles) int {
    if !p.is_visible() { << 0 }
    p.paint_styled(frame,styles) >>>
    if !p.aux.has(0) { << 0 }
    panel_rect := copy_rect(&p.panel)
    c := p.style_or(styles)
    op := p.opacity()
    aux := $&p.aux
    << overlay_paint_aux_text(aux,frame,&panel_rect,styles,&c,op) >>>
}
pub fn (p $&Popover) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    if !p.is_visible() || !p.aux.has(0) { << 0 }
    aux := $&p.aux
    << overlay_paint_aux_popup(aux,frame,styles) >>>
}

// Modal owns the keyboard focus order, while the host owns the actual child
// controls. Use blocks_input() as the dispatch gate, including the closing fade.
// Cancel background View input before open (cancel_input) to release
// capture and native editor focus. Apply focused_id() after open/input, and restore
// take_restore_focus() after tick reports the closing fade finished. Never
// dispatch to background while blocks_input():
// first call input(), honor consumed even when that input closes the modal,
// then dispatch only to modal children if allows_content().
pub struct Modal {
    identity ui.CanvasEvent
    id_val int
    panel Popover
    viewport layout.Rect
    order []int
    focus_index int
    restore_id int
    restore_pending bool
    outside_close bool
    close_armed bool
    dirty bool
}
pub fn modal(identity &ui.CanvasEvent,id int,bounds &layout.Rect,viewport &layout.Rect) Modal {
    validate_bounds(bounds) >>>
    size := layout.Size{width: bounds.width,height: bounds.height}
    anchor := layout.Rect{x: bounds.x,y: bounds.y - 6.0,width: 0.0,height: 0.0}
    panel := popover(identity,id,&anchor,&size,viewport) >>>
    << Modal{identity: copy_identity(identity),id_val: id,panel: panel,viewport: copy_rect(viewport),order: []int{},focus_index: -1,
        restore_id: 0,restore_pending: false,outside_close: false,close_armed: false,dirty: true}
}
pub fn (m &Modal) id() int { << m.id_val }
pub fn (m &Modal) bounds() layout.Rect { << m.panel.bounds() }
pub fn (m &Modal) is_enabled() bool { << m.panel.is_enabled() }
pub fn (m &Modal) is_selectable() bool { << m.panel.is_selectable() }
pub fn (m $&Modal) set_selectable(selectable bool) { panel := $&m.panel
    panel.set_selectable(selectable) }
pub fn (m $&Modal) set_text(context &draw.Context,text &string) int { panel := $&m.panel
    << panel.set_text(context,text) >>> }
pub fn (m &Modal) has_popup_open() bool { << m.panel.has_popup_open() }
pub fn (m &Modal) popup_bounds() layout.Rect { << m.panel.popup_bounds() }
pub fn (m &Modal) selected_text() string { << m.panel.selected_text() }
pub fn (m &Modal) copy_selection() int { << m.panel.copy_selection() }
pub fn (m &Modal) cursor() int { << m.panel.cursor() }
pub fn (m $&Modal) set_locale(locale &Locale) int { panel := $&m.panel
    << panel.set_locale(locale) >>> }
pub fn (m &Modal) is_open() bool { << m.panel.is_open() }
pub fn (m &Modal) is_visible() bool { << m.panel.is_visible() }
// Keep background input blocked throughout the closing fade.
pub fn (m &Modal) blocks_input() bool { << m.is_visible() }
pub fn (m &Modal) opacity() f64 { << m.panel.opacity() }
pub fn (m &Modal) needs_paint() bool { << m.dirty || m.panel.needs_paint() }
pub fn (m $&Modal) painted() { m.dirty = false
    panel := $&m.panel
    panel.painted() }
pub fn (m $&Modal) set_dismiss_on_outside(enabled bool) { m.outside_close = enabled }
pub fn (m &Modal) focused_id() int {
    if !m.is_open() || m.focus_index < 0 || m.focus_index >= m.order.len { << 0 }
    << m.order[m.focus_index]
}
pub fn (m &Modal) focus_restore_id() int { << m.restore_id }
// Restore native/editor focus only after the overlay has disappeared.
pub fn (m $&Modal) take_restore_focus() int {
    if !m.restore_pending || m.is_visible() { << 0 }
    m.restore_pending = false
    << m.restore_id
}
pub fn (m &Modal) contains_focus(id int) bool {
    for child in m.order { if child == id { << true } }
    << false
}
pub fn (m $&Modal) set_focus_order(ids &[]int) int {
    if ids.len > 256 { >>> errors.new("widgets: too many modal focus targets") }
    $order := []int{}
    for id in ids {
        if id <= 0 || id == m.id_val { >>> errors.new("widgets: invalid modal focus target") }
        for previous in order { if previous == id { >>> errors.new("widgets: duplicate modal focus target") } }
        order.push(id)
    }
    current := m.focused_id()
    m.order = order
    m.focus_index = -1
    if m.order.len > 0 { m.focus_index = 0 }
    for i in 0:m.order.len { if m.order[i] == current { m.focus_index = i } }
    m.dirty = true
    << 0
}
pub fn (m $&Modal) set_content_focus(id int) int {
    for i in 0:m.order.len { if m.order[i] == id { m.focus_index = i
        m.dirty = true
        << 0 } }
    >>> errors.new("widgets: focus target is outside modal")
}
pub fn (m $&Modal) open(now time.Instant,reduced_motion bool,restore_focus int) int {
    if restore_focus < 0 { >>> errors.new("widgets: invalid restore focus") }
    if !m.is_visible() {
        m.restore_id = restore_focus
        m.focus_index = -1
        if m.order.len > 0 { m.focus_index = 0 }
    }
    m.restore_pending = false
    m.close_armed = false
    m.dirty = true
    panel := $&m.panel
    << panel.open(now,reduced_motion) >>>
}
pub fn (m $&Modal) close(now time.Instant,reduced_motion bool) int {
    if m.is_visible() { m.restore_pending = true }
    m.close_armed = false
    m.dirty = true
    panel := $&m.panel
    << panel.close(now,reduced_motion) >>>
}
pub fn (m $&Modal) set_enabled(enabled bool) int {
    // Layout reapplies the enabled state between pointer down and up.
    if m.is_enabled() == enabled { << 0 }
    if !enabled && m.is_visible() { m.restore_pending = true }
    m.close_armed = false
    m.dirty = true
    panel := $&m.panel
    << panel.set_enabled(enabled) >>>
}
pub fn (m $&Modal) set_geometry(bounds &layout.Rect,viewport &layout.Rect) int {
    validate_bounds(bounds) >>>
    validate_bounds(viewport) >>>
    size := layout.Size{width: bounds.width,height: bounds.height}
    anchor := layout.Rect{x: bounds.x,y: bounds.y - 6.0,width: 0.0,height: 0.0}
    previous := m.bounds()
    panel := $&m.panel
    panel.set_geometry(&anchor,&size,viewport) >>>
    next := panel.bounds()
    if !overlay_same_rect(&next,&previous) || !overlay_same_rect(viewport,&m.viewport) {
        m.viewport = copy_rect(viewport)
        m.close_armed = false
        m.dirty = true
    }
    << 0
}
pub fn (m &Modal) close_bounds() layout.Rect {
    b := m.bounds()
    size := math.min(28.0,math.min(b.width,b.height))
    << layout.Rect{x: b.x + b.width - size,y: b.y,width: size,height: size}
}
pub fn (m &Modal) allows_content(event &ui.InputEvent) bool {
    if !m.is_open() || !belongs(&m.identity,event) { << false }
    if event.kind == ui.EV_KEY_DOWN || event.kind == ui.EV_KEY_UP { << m.focused_id() > 0 && event.key != ui.KEY_TAB && event.key != ui.KEY_ESCAPE }
    if event.kind == ui.EV_POINTER_CANCEL { << true }
    << m.bounds().contains(event.x,event.y) && !m.close_bounds().contains(event.x,event.y)
}
pub fn (m $&Modal) input(event &ui.InputEvent) Action {
    if !belongs(&m.identity,event) || !m.blocks_input() { << no_action(m.id_val,m.needs_paint()) }
    if !m.is_open() { << overlay_action(m.id_val,false,m.needs_paint(),true) }
    panel_rect := m.bounds()
    if m.has_popup_open() {
        $act := no_action(m.id_val,false)
        if true {
            panel := $&m.panel
            aux := $&panel.aux
            act = overlay_route_aux_input(aux,&panel_rect,event)
        }
        if act.needs_paint { m.dirty = true }
        << Action{kind: ACTION_NONE,id: m.id_val,needs_paint: m.needs_paint(),request_focus: act.request_focus,consumed: true,value: 0.0}
    }
    now := time.instant_from_ns(event.time_ns) >>>
    reduced := m.panel.reduced
    escape := event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_ESCAPE
    inside := m.bounds().contains(event.x,event.y)
    close_hit := m.close_bounds().contains(event.x,event.y)
    outside := event.kind == ui.EV_POINTER_DOWN && !inside && m.outside_close
    if escape || outside { m.close(now,reduced) >>>
        << overlay_action(m.id_val,true,m.needs_paint(),true) }
    if event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_TAB {
        if m.order.len > 0 {
            $delta := 1
            if (event.modifiers & ui.MOD_SHIFT) != 0 { delta = -1 }
            m.focus_index = m.focus_index + delta
            if m.focus_index < 0 { m.focus_index = m.order.len - 1 }
            else if m.focus_index >= m.order.len { m.focus_index = 0 }
            m.dirty = true
        }
        << Action{kind: ACTION_NONE,id: m.id_val,needs_paint: m.needs_paint(),request_focus: true,consumed: true,value: f64(m.focused_id())}
    }
    if event.kind == ui.EV_POINTER_CANCEL { m.close_armed = false }
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && close_hit { m.close_armed = true
        m.dirty = true
        << overlay_action(m.id_val,false,true,true) }
    if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && m.close_armed {
        m.close_armed = false
        m.dirty = true
        if close_hit { m.close(now,reduced) >>> }
        << overlay_action(m.id_val,close_hit,true,true)
    }
    if m.is_selectable() && m.panel.aux.has(0) && !close_hit {
        if event.kind != ui.EV_KEY_DOWN || m.panel.aux[0].is_focused() {
            $act := no_action(m.id_val,false)
            if true {
                panel := $&m.panel
                aux := $&panel.aux
                act = overlay_route_aux_input(aux,&panel_rect,event)
            }
            if act.needs_paint { m.dirty = true }
            if act.consumed {
                << Action{kind: ACTION_NONE,id: m.id_val,needs_paint: m.needs_paint(),request_focus: act.request_focus,consumed: true,value: 0.0}
            }
        }
    }
    << overlay_action(m.id_val,false,m.needs_paint(),!m.allows_content(event))
}
pub fn (m $&Modal) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >>> errors.new("widgets: invalid route kind") }
    if !belongs(&m.identity,event) { << no_action(m.id_val,m.needs_paint()) }
    if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { m.close_armed = false
        m.dirty = true
        << no_action(m.id_val,true) }
    if kind == ROUTE_FOCUS { << no_action(m.id_val,m.needs_paint()) }
    << m.input(event) >>>
}
pub fn (m $&Modal) tick(now time.Instant,reduced_motion bool) bool { panel := $&m.panel
    << panel.tick(now,reduced_motion) >>> }
pub fn (m &Modal) next_tick(now time.Instant) time.Instant { << m.panel.next_tick(now) >>> }
pub fn (m &Modal) paint_styled(frame $&draw.Frame,styles &Styles) int {
    if !m.is_visible() { << 0 }
    v := m.viewport
    scrim := styles.overlay_scrim()
    frame.fill_rect(v.x,v.y,v.width,v.height,scrim.with_alpha(int(f64(scrim.value() & 255) * m.opacity()))) >>>
    m.panel.paint_styled(frame,styles) >>>
    b := m.close_bounds()
    c := m.panel.style_or(styles).with_opacity(m.opacity()) >>>
    ink := c.resolve(0).foreground
    mid_x := b.x + b.width * 0.5
    mid_y := b.y + b.height * 0.5
    half := math.min(4.0,b.width * 0.2)
    frame.line(mid_x - half,mid_y - half,mid_x + half,mid_y + half,ink,1.5) >>>
    frame.line(mid_x + half,mid_y - half,mid_x - half,mid_y + half,ink,1.5) >>>
    << 0
}
pub fn (m $&Modal) paint_content_styled(frame $&draw.Frame,styles &Styles) int {
    if !m.is_visible() { << 0 }
    v := m.viewport
    scrim := styles.overlay_scrim()
    frame.fill_rect(v.x,v.y,v.width,v.height,scrim.with_alpha(int(f64(scrim.value() & 255) * m.opacity()))) >>>
    if true {
        panel := $&m.panel
        panel.paint_content_styled(frame,styles) >>>
    }
    b := m.close_bounds()
    c := m.panel.style_or(styles).with_opacity(m.opacity()) >>>
    ink := c.resolve(0).foreground
    mid_x := b.x + b.width * 0.5
    mid_y := b.y + b.height * 0.5
    half := math.min(4.0,b.width * 0.2)
    frame.line(mid_x - half,mid_y - half,mid_x + half,mid_y + half,ink,1.5) >>>
    frame.line(mid_x + half,mid_y - half,mid_x - half,mid_y + half,ink,1.5) >>>
    << 0
}
pub fn (m $&Modal) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    panel := $&m.panel
    << panel.paint_popup_styled(frame,styles) >>>
}

pub fn (p &Popover) style_or(styles &Styles) ControlStyle {
    if p.custom.active { << unpack_scalar_style(&p.custom) }
    << styles.overlay_style()
}
pub fn (p $&Popover) set_style(style &ControlStyle) int {
    style.validate() >>>
    p.custom = pack_scalar_style(style)
    p.dirty = true
    << 0
}
pub fn (p $&Popover) set_motion(spec &MotionSpec) int {
    spec.validate() >>>
    p.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    fade := $&p.fade
    fade.set_curve(spec.curve) >>>
    << 0
}
fn (p &Popover) clone_panel() Popover {
    custom := copy_scalar_style(&p.custom)
    << Popover{placement: p.placement,close_outside: p.close_outside,close_escape: p.close_escape,identity: copy_identity(&p.identity),id_val: p.id_val,anchor: copy_rect(&p.anchor),
        extent: layout.Size{width: p.extent.width,height: p.extent.height},viewport: copy_rect(&p.viewport),panel: copy_rect(&p.panel),
        opened: p.opened,enabled: p.enabled,dirty: p.dirty,reduced: p.reduced,selectable: p.selectable,fade: p.fade,custom: custom,motion: p.motion,aux: map[int]SelectableText{}}
}
pub fn (m $&Modal) set_style(style &ControlStyle) int { panel := $&m.panel
    << panel.set_style(style) >>> }
pub fn (m $&Modal) set_motion(spec &MotionSpec) int { panel := $&m.panel
    << panel.set_motion(spec) >>> }
