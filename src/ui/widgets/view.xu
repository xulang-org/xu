@ui/widgets

#ui
#ui/draw
#ui/layout
#errors

struct ViewNode {
    id int
    boundary bool
    interactive bool
    focusable bool
    capture_outside bool
    cursor int
    scope bool
    measure_style bool
    measure_dirty bool
}
pub struct@ Painter {
    fn paint(int,&layout.Rect,&mut draw.Frame) bool
}
pub struct ViewStats {
    pub measured int
    pub reused_layouts int
    pub painted_nodes int
    pub recorded_boundaries int
    pub reused_boundaries int
    pub frame_commands int
}
// One retained scene per canvas. The application keeps its control/model state;
// this owner keeps stable topology, measured geometry and vector paint caches.
// Paint callbacks receive node-local bounds, in the same logical coordinate
// system returned by local_input(). They must not mutate the View or topology.
pub struct View {
    identity ui.CanvasEvent
    context draw.Context
    tree layout.Tree
    nodes []ViewNode
    lookup map[int]int
    records draw.DisplayListPool
    root int
    presented_revision int
    styles Styles
    scopes []StyleScope
    background draw.Color
    background_dirty bool
    painted_nodes int
    recorded_boundaries int
    reused_boundaries int
    frame_commands int
    paint_mode int
    focused int
    hovered int
    captured int
    pointer_cursor int
    pending_cancel []int
    closed bool
}
pub fn (host &Host) view(root_style &layout.BoxStyle,background draw.Color) View {
    if !valid_identity(&host.identity) { >> errors.new("widgets: view requires a native canvas identity") }
    mut tree := layout.tree()
    mut style := layout.box_style(root_style.kind)
    // Tree copies configuration; do not borrow a caller's mutable style.
    zero := layout.Size{width: 0.0,height: 0.0}
    root := tree.add(0,root_style,&zero) or >>
    style = tree.style(root) or >>
    style.clip = true
    tree.set_style(root,&style) or >>
    mut lookup := map[int]int{}
    lookup[root] = 1
    << View{identity: copy_identity(&host.identity),context: host.context,tree: tree,nodes: [ViewNode{id: root,boundary: true,interactive: false,focusable: false,capture_outside: false,cursor: ui.cursor_default,scope: false,measure_style: false,measure_dirty: false}],lookup: lookup,
            records: host.context.display_list_pool(),root: root,presented_revision: 0,styles: dark_styles(),scopes: []StyleScope{},background: background,background_dirty: true,
            painted_nodes: 0,recorded_boundaries: 0,reused_boundaries: 0,frame_commands: 0,paint_mode: 0,
            focused: 0,hovered: 0,captured: 0,pointer_cursor: ui.cursor_default,pending_cancel: []int{},closed: false}
}
pub fn (view &View) root() int { << view.root }
fn (view &View) check() int {
    if view.closed { >> errors.new("widgets: view is disposed") }
    << 0
}
fn (view &View) node_index(id int) int {
    found := view.lookup.get_or(id,0)
    if id > 0 && found > 0 { << found - 1 }
    >> errors.new("widgets: stale or unknown view node")
}
pub fn (view &mut View) add(parent int,style &layout.BoxStyle,intrinsic &layout.Size) int {
    view.check() or >>
    tree := mut &view.tree
    id := tree.add(parent,style,intrinsic) or >>
    mut slot := -1
    for i in 0:view.nodes.len { if view.nodes[i].id == 0 { slot = i
        <- } }
    if slot < 0 { slot = view.nodes.len
        view.nodes.push(ViewNode{id: id,boundary: false,interactive: false,focusable: false,capture_outside: false,cursor: ui.cursor_default,scope: false,measure_style: false,measure_dirty: false}) }
    else { view.nodes[slot] = ViewNode{id: id,boundary: false,interactive: false,focusable: false,capture_outside: false,cursor: ui.cursor_default,scope: false,measure_style: false,measure_dirty: false} }
    view.lookup[id] = slot + 1
    << id
}
pub fn (view &View) contains(id int) bool { << !view.closed && view.tree.contains(id) }
pub fn (view &View) style(id int) layout.BoxStyle { view.check() or >>
    << view.tree.style(id) or >> }
pub fn (view &mut View) set_style(id int,style &layout.BoxStyle) int { view.check() or >>
    if id == view.root && !style.clip { >> errors.new("widgets: root must clip its window bounds") }
    tree := mut &view.tree
    << tree.set_style(id,style) or >> }
pub fn (view &mut View) set_intrinsic(id int,size &layout.Size) int { view.check() or >>
    tree := mut &view.tree
    << tree.set_intrinsic(id,size) or >> }
pub fn (view &mut View) mark_paint(id int) int { view.check() or >>
    tree := mut &view.tree
    << tree.invalidate_paint(id) or >> }
pub fn (view &mut View) set_offset(id int,x f64,y f64) int { view.check() or >>
    tree := mut &view.tree
    << tree.set_offset(id,x,y) or >> }
// Scroll clamps its model offset to the content/viewport extent. Apply that
// value here after dispatch; the same translation drives paint and hit testing.
pub fn (view &mut View) set_scroll(id int,x f64,y f64) int {
    view.check() or >>
    style := view.tree.style(id) or >>
    if !style.clip { >> errors.new("widgets: a scroll viewport must clip its children") }
    tree := mut &view.tree
    << tree.set_scroll(id,x,y) or >>
}
// Bound native retained-list nesting independently of the layout depth limit.
// Reserving four levels leaves room for user-created nested paint fragments.
fn (view &View) boundary_depth(id int) int {
    mut count := 0
    mut current := id
    while current > 0 {
        index := view.node_index(current) or >>
        if view.nodes[index].boundary { count = count + 1 }
        current = view.tree.parent(current) or >>
    }
    << count
}
pub fn (view &mut View) set_boundary(id int,enabled bool) int {
    view.check() or >>
    index := view.node_index(id) or >>
    if id == view.root && !enabled { >> errors.new("widgets: root is always a repaint boundary") }
    if view.nodes[index].boundary == enabled { << 0 }
    view.nodes[index].boundary = enabled
    if enabled {
        for node in view.nodes {
            if node.id > 0 {
                depth := view.boundary_depth(node.id) or >>
                if depth > 12 { view.nodes[index].boundary = false
                    >> errors.new("widgets: repaint boundary nesting exceeded") }
            }
        }
    } else { records := mut &view.records
        records.remove(id) }
    // A boundary's own record excludes its offset; its parent's record captures
    // placement. Moving a clean subtree therefore preserves its vector content.
    view.mark_paint(id) or >>
    << 0
}
fn (view &mut View) retire_records(id int) int {
    children := view.tree.children(id) or >>
    for child in children { view.retire_records(child) or >> }
    index := view.node_index(id) or >>
    records := mut &view.records
    records.remove(id)
    view.retire_input(id)
    for i in 0:view.scopes.len { if view.scopes[i].id == id { view.scopes[i].id = 0 } }
    view.nodes[index].id = 0
    lookup := mut &view.lookup
    lookup.delete(id)
    << 0
}
pub fn (view &mut View) remove(id int) int {
    view.check() or >>
    if id == view.root { >> errors.new("widgets: dispose the view to remove its root") }
    view.retire_records(id) or >>
    tree := mut &view.tree
    << tree.remove(id) or >>
}
pub fn (view &mut View) dispose() {
    if view.closed { << }
    view.retire_input(view.focused)
    view.retire_input(view.hovered)
    view.retire_input(view.captured)
    records := mut &view.records
    records.dispose()
    root := view.root
    tree := mut &view.tree
    tree.remove(root) or (err) { view.closed = true
        << }
    view.closed = true
    view.presented_revision = 0
}
// Call from the owning window's event loop. Closing another window or a stale
// generation does not revoke this scene. Focus/editor cancellation is handled
// by the application's control state before/alongside this lifecycle hook.
pub fn (view &mut View) event(event &ui.Event) bool {
    if view.closed || event.window_id != view.identity.window_id { << false }
    mut close := event.kind == ui.ev_closed
    if event.kind == ui.ev_canvas_closed {
        identity := ui.canvas_of(event) or >>
        close = identity.canvas_id == view.identity.canvas_id && identity.generation == view.identity.generation
    }
    if close { view.dispose() }
    << close
}
pub fn (view &mut View) set_background(color draw.Color) { view.background = color
    view.background_dirty = true }
pub fn (view &View) needs_frame() bool {
    if view.closed { << false }
    if view.tree.needs_layout() || view.background_dirty { << true }
    revision := view.tree.paint_revision(view.root) or (err) { << true }
    << revision != view.presented_revision
}
pub fn (view &mut View) layout(constraints &layout.Constraints) layout.Size {
    view.check() or >>
    tree := mut &view.tree
    << tree.layout(constraints) or >>
}
pub fn (view &View) node_bounds(id int) layout.Rect { view.check() or >>
    << view.tree.global_bounds(id) or >> }
pub fn (view &View) hit_test(x f64,y f64) int { view.check() or >>
    << view.tree.hit_test(x,y) or >> }
// Pointer capture/focus policy belongs to the controls. Route captured releases
// through this same transform even when hit_test() returns a different node.
pub fn (view &View) local_input(id int,input &ui.InputEvent) ui.InputEvent {
    view.check() or >>
    if !belongs(&view.identity,input) { >> errors.new("widgets: input belongs to another canvas generation") }
    if view.tree.needs_layout() { >> errors.new("widgets: input requires current layout") }
    bounds := view.tree.global_bounds(id) or >>
    << ui.InputEvent{kind: input.kind,window_id: input.window_id,canvas_id: input.canvas_id,generation: input.generation,
                    x: input.x - bounds.x,y: input.y - bounds.y,dx: input.dx,dy: input.dy,button: input.button,buttons: input.buttons,
                    modifiers: input.modifiers,key: input.key,scan: input.scan,repeat: input.repeat,click_count: input.click_count,time_ns: input.time_ns}
}
pub fn (view &View) stats() ViewStats {
    stats := view.tree.layout_stats()
    << ViewStats{measured: stats.measured,reused_layouts: stats.reused,painted_nodes: view.painted_nodes,
                 recorded_boundaries: view.recorded_boundaries,reused_boundaries: view.reused_boundaries,frame_commands: view.frame_commands}
}
// The painter explicitly reports paint success. A failed paint/capture
// leaves the previously presented scene alive and the View dirty for retry.
fn paint_contents#P:Painter(view &mut View,id int,frame &mut draw.Frame,painter &mut P) int {
    style := view.tree.style(id) or >>
    if style.hidden { << 0 }
    bounds := view.tree.bounds(id) or >>
    local := layout.Rect{x: 0.0,y: 0.0,width: bounds.width,height: bounds.height}
    frame.push() or >>
    if style.clip { frame.clip_rect(0.0,0.0,bounds.width,bounds.height) or >> }
    if !painter.paint(id,&local,frame) { >> errors.new("widgets: node paint failed") }
    view.painted_nodes = view.painted_nodes + 1
    children := view.tree.children(id) or >>
    offset := view.tree.scroll_offset(id) or >>
    if children.len > 0 && (offset.x != 0.0 || offset.y != 0.0) { frame.translate(0.0 - offset.x,0.0 - offset.y) or >> }
    for child in children {
        visible := view.tree.visible(child) or >>
        if visible {
            position := view.tree.bounds(child) or >>
            frame.push() or >>
            frame.translate(position.x,position.y) or >>
            index := view.node_index(child) or >>
            if view.nodes[index].boundary {
                prepare_boundary(view,child,painter) or >>
                frame.pooled_display_list(&view.records,child) or >>
            } else { paint_contents(view,child,frame,painter) or >> }
            frame.pop() or >>
        }
    }
    frame.pop() or >>
    << 0
}
fn prepare_boundary#P:Painter(view &mut View,id int,painter &mut P) int {
    revision := view.tree.paint_revision(id) or >>
    if view.records.is_current(id,revision) { view.reused_boundaries = view.reused_boundaries + 1
        << 0 }
    mut frame := view.context.new_frame(1024)
    frame.begin() or >>
    paint_contents(view,id,mut &frame,painter) or (err) { frame.dispose()
        >> err }
    records := mut &view.records
    records.capture(id,revision,mut &frame) or (err) { frame.dispose()
        >> err }
    frame.dispose()
    view.recorded_boundaries = view.recorded_boundaries + 1
    << 0
}
// Returns false without recording/submitting when layout and scene are current.
// A successful return acknowledges only the View. Control owners call painted()
// after true; failed submissions keep the newly prepared records for cheap retry.
pub fn present#P:Painter(view &mut View,constraints &layout.Constraints,painter &mut P) bool {
    view.check() or >>
    _ := view.layout(constraints) or >>
    view.use_painter(1) or >>
    view.painted_nodes = 0
    view.recorded_boundaries = 0
    view.reused_boundaries = 0
    view.frame_commands = 0
    if !view.needs_frame() { << false }
    prepare_boundary(view,view.root,painter) or >>
    mut frame := view.context.new_frame(256)
    frame.begin() or >>
    frame.set_bg(view.background) or (err) { frame.dispose()
        >> err }
    frame.pooled_display_list(&view.records,view.root) or (err) { frame.dispose()
        >> err }
    view.frame_commands = frame.command_count()
    frame.present() or (err) { frame.dispose()
        >> err }
    view.presented_revision = view.tree.paint_revision(view.root) or >>
    view.background_dirty = false
    << true
}

// Export the same measured/recorded scene through the native Surface backend.
// Snapshotting does not acknowledge presentation to the window. A later present
// can reuse these records without invoking the painter again.
pub fn snapshot#P:Painter(view &mut View,constraints &layout.Constraints,scale f64,painter &mut P) draw.Surface {
    view.check() or >>
    size := view.layout(constraints) or >>
    view.use_painter(1) or >>
    view.painted_nodes = 0
    view.recorded_boundaries = 0
    view.reused_boundaries = 0
    view.frame_commands = 0
    prepare_boundary(view,view.root,painter) or >>
    mut frame := view.context.new_frame(256)
    frame.begin() or >>
    frame.set_bg(view.background) or (err) { frame.dispose()
        >> err }
    frame.pooled_display_list(&view.records,view.root) or (err) { frame.dispose()
        >> err }
    surface := frame.snapshot(size.width,size.height,scale) or (err) { frame.dispose()
        >> err }
    frame.dispose()
    << surface
}
