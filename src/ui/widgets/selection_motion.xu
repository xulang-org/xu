@ui/widgets
#time

struct SelectionMotion { progress Tween
    spec MotionSpec
    ready bool }
fn selection_motion(selected bool) SelectionMotion {
    mut value := 0.0
    if selected { value = 1.0 }
    progress := tween(value) or >>
    << SelectionMotion{progress: progress,spec: motion_spec(),ready: false}
}
fn (motion &mut SelectionMotion) advance(selected bool,now time.Instant,reduced bool) bool {
    mut target := 0.0
    if selected { target = 1.0 }
    before := motion.progress.value()
    snap := reduced || !motion.ready
    curve := motion.spec.curve
    duration := motion.spec.change
    progress := mut &motion.progress
    progress.set_curve(curve) or >>
    progress.retarget_unit(target,now,duration,snap) or >>
    _ := progress.advance(now) or >>
    motion.ready = true
    << before != motion.progress.value()
}
fn (motion &SelectionMotion) value(selected bool) f64 {
    if !motion.ready { if selected { << 1.0 }
        << 0.0 }
    << motion.progress.value()
}
pub fn (control &mut Checkbox) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    control.mark.spec = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    << 0
}
pub fn (control &mut Radio) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    control.mark.spec = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    << 0
}
pub fn (control &mut Checkbox) tick(now time.Instant,reduced bool) bool {
    selected := control.checked || control.indeterminate
    instant := reduced || !control.is_enabled()
    mark := mut &control.mark
    changed := mark.advance(selected,now,instant) or >>
    if changed { button := mut &control.control
        button.invalidate() }
    << changed
}
pub fn (control &Checkbox) next_tick(now time.Instant) time.Instant {
    << overlay_next_tick(control.mark.progress.is_animating(),now) or >>
}
pub fn (control &mut Radio) tick(now time.Instant,reduced bool) bool {
    selected := control.checked
    instant := reduced || !control.is_enabled()
    mark := mut &control.mark
    changed := mark.advance(selected,now,instant) or >>
    if changed { button := mut &control.control
        button.invalidate() }
    << changed
}
pub fn (control &Radio) next_tick(now time.Instant) time.Instant {
    << overlay_next_tick(control.mark.progress.is_animating(),now) or >>
}
fn screen_tick_check(item &mut Checkbox,now time.Instant,reduced bool) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}
fn screen_tick_radio(item &mut Radio,now time.Instant,reduced bool) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}
