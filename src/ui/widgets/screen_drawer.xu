@ui/widgets

#ui/draw
#ui/layout
#errors
#math

pub const ACTION_DRAWER_STATE = 28

pub const DRAWER_LEFT = 0
pub const DRAWER_RIGHT = 1
pub const DRAWER_TOP = 2
pub const DRAWER_BOTTOM = 3

pub struct DrawerSpec {
    pub edge int
    pub extent f64
    pub dismiss_on_backdrop bool
    pub backdrop_opacity f64
    pub focus_trap bool
}

struct DrawerEntry {
    spec DrawerSpec
    open bool
}

pub fn drawer_spec(edge int,extent f64) DrawerSpec {
    << DrawerSpec{
        edge: edge,
        extent: extent,
        dismiss_on_backdrop: true,
        backdrop_opacity: 0.35,
        focus_trap: true
    }
}

pub fn (d &DrawerSpec) validate() int {
    if d.edge < DRAWER_LEFT || d.edge > DRAWER_BOTTOM {
        >>> errors.new("widgets: invalid drawer edge")
    }
    if math.is_nan(d.extent) || math.is_inf(d.extent) || d.extent <= 0.0 || d.extent > 4096.0 {
        >>> errors.new("widgets: invalid drawer extent")
    }
    if math.is_nan(d.backdrop_opacity) || math.is_inf(d.backdrop_opacity) || d.backdrop_opacity < 0.0 || d.backdrop_opacity > 1.0 {
        >>> errors.new("widgets: invalid drawer backdrop opacity")
    }
    << 0
}

fn copy_drawer_spec(d &DrawerSpec) DrawerSpec {
    << DrawerSpec{
        edge: d.edge,
        extent: d.extent,
        dismiss_on_backdrop: d.dismiss_on_backdrop,
        backdrop_opacity: d.backdrop_opacity,
        focus_trap: d.focus_trap
    }
}

pub fn (s $&Screen) set_drawer(id int,spec &DrawerSpec) int {
    _ := s.node(id) >>>
    spec.validate() >>>
    comp := $&s.composition
    ds := $&comp.drawers
    had := ds.has(id)
    ds[id] = DrawerEntry{spec: copy_drawer_spec(spec),open: false}
    if !had {
        dids := $&comp.drawer_ids
        dids.push(id)
        comp.drawer_count = comp.drawer_count + 1
    }
    s.set_visible(id,false) >>>
    << 0
}

pub fn (s $&Screen) clear_drawer(id int) int {
    _ := s.node(id) >>>
    if s.composition.drawers.has(id) && s.composition.drawers[id].spec.focus_trap {
        _ := s.set_focus_trap(id,false) >>> (err) { << 0 }
    }
    comp := $&s.composition
    if comp.drawers.has(id) {
        ds := $&comp.drawers
        ds.delete(id)
        next := vec_without(&comp.drawer_ids,id)
        comp.drawer_ids = next
        if comp.drawer_count > 0 { comp.drawer_count = comp.drawer_count - 1 }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s $&Screen) open_drawer(id int) int {
    _ := s.node(id) >>>
    if !s.composition.drawers.has(id) { >>> errors.new("widgets: node is not a drawer") }
    comp := $&s.composition
    ds := $&comp.drawers
    prev := ds.take(id)
    spec := copy_drawer_spec(&prev.spec)
    ds[id] = DrawerEntry{spec: spec,open: true}
    s.set_visible(id,true) >>>
    if spec.focus_trap {
        _ := s.set_focus_trap(id,true) >>> (err) { << 0 }
    }
    s.mark_layout_dirty()
    s.layout_controls() >>>
    if spec.focus_trap {
        _ := s.focus_first_in(id) >>> (err) { << 0 }
    }
    qa := $&s.queued_actions
    qa.push(Action{kind: ACTION_DRAWER_STATE,id: id,needs_paint: true,request_focus: false,consumed: true,value: 1.0})
    << 0
}

fn (s $&Screen) close_drawer_internal(id int) int {
    if !s.composition.drawers.has(id) { << 0 }
    comp := $&s.composition
    ds := $&comp.drawers
    prev := ds.take(id)
    spec := copy_drawer_spec(&prev.spec)
    ds[id] = DrawerEntry{spec: spec,open: false}
    if spec.focus_trap {
        _ := s.set_focus_trap(id,false) >>> (err) { << 0 }
    }
    s.set_visible(id,false) >>>
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) close_drawer(id int) int {
    _ := s.node(id) >>>
    if !s.composition.drawers.has(id) { >>> errors.new("widgets: node is not a drawer") }
    was_open := s.composition.drawers[id].open
    s.close_drawer_internal(id) >>>
    if was_open {
        qa := $&s.queued_actions
        qa.push(Action{kind: ACTION_DRAWER_STATE,id: id,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
    }
    << 0
}

pub fn (s &Screen) is_drawer_open(id int) bool {
    _ := s.node(id) >>>
    if !s.composition.drawers.has(id) { << false }
    << s.composition.drawers[id].open && s.is_visible(id)
}

fn (s &Screen) is_drawer_node(id int) bool {
    << s.composition.drawer_count > 0 && s.composition.drawers.has(id)
}

fn (s &Screen) top_open_drawer() int {
    if s.composition.drawer_count == 0 { << 0 }
    dids := &s.composition.drawer_ids
    $i := dids.len - 1
    while i >= 0 {
        did := dids[i]
        if did > 0 && did <= s.nodes.len && s.nodes[did - 1].kind >= 0 &&
           s.composition.drawers.has(did) && s.composition.drawers[did].open && s.is_visible(did) {
            << did
        }
        i -= 1
    }
    << 0
}

fn (s $&Screen) layout_drawer_nodes(root_styles &Styles) int {
    if s.composition.drawer_count == 0 { << 0 }
    dcount := s.composition.drawer_ids.len
    sa := s.composition.safe_area
    min_x := sa.left
    min_y := sa.top
    vp_w := math.max(0.0,s.width - sa.left - sa.right)
    vp_h := math.max(0.0,s.height - sa.top - sa.bottom)
    for i in 0:dcount {
        did := s.composition.drawer_ids[i]
        if did <= 0 || did > s.nodes.len || s.nodes[did - 1].kind < 0 || !s.composition.drawers.has(did) { -> }
        entry := s.composition.drawers[did]
        if !entry.open || !s.is_visible(did) { -> }
        $st := root_styles.clone()
        if s.has_any_style_overrides() { st = s.styles_for(did) }
        $x := min_x
        $y := min_y
        $w := vp_w
        $h := vp_h
        if entry.spec.edge == DRAWER_LEFT {
            w = math.min(vp_w,entry.spec.extent)
        } else if entry.spec.edge == DRAWER_RIGHT {
            w = math.min(vp_w,entry.spec.extent)
            x = min_x + vp_w - w
        } else if entry.spec.edge == DRAWER_TOP {
            h = math.min(vp_h,entry.spec.extent)
        } else {
            h = math.min(vp_h,entry.spec.extent)
            y = min_y + vp_h - h
        }
        s.nodes[did - 1].local = layout.Rect{x: x,y: y,width: w,height: h}
        s.layout_subtree(did,&st) >>>
    }
    << 0
}

fn try_paint_drawer_node(s $&Screen,did int,frame $&draw.Frame,st &Styles) string {
    s.paint_subtree(did,frame,1.0,0,st) >>> (err) { << err.msg() }
    s.paint_subtree_popups(did,frame,st,0) >>> (err) { << err.msg() }
    << ""
}

fn (s $&Screen) paint_drawer_nodes(frame $&draw.Frame,root_styles &Styles) int {
    if s.composition.drawer_count == 0 { << 0 }
    dcount := s.composition.drawer_ids.len
    for i in 0:dcount {
        did := s.composition.drawer_ids[i]
        if did <= 0 || did > s.nodes.len || s.nodes[did - 1].kind < 0 || !s.composition.drawers.has(did) { -> }
        entry := s.composition.drawers[did]
        if !entry.open || !s.is_visible(did) { -> }
        if entry.spec.backdrop_opacity > 0.0 {
            alpha := int(math.max(0.0,math.min(255.0,entry.spec.backdrop_opacity * 255.0)))
            frame.fill_rect(0.0,0.0,s.width,s.height,draw.rgba(15,23,42,alpha)) >>>
        }
        $st := root_styles.clone()
        if s.has_any_style_overrides() { st = s.styles_for(did) }
        comp := $&s.composition
        comp.painting_floating_root = did
        err_msg := try_paint_drawer_node(s,did,frame,&st)
        comp2 := $&s.composition
        comp2.painting_floating_root = 0
        if err_msg.len > 0 { >>> errors.new(err_msg) }
    }
    << 0
}

fn (s $&Screen) hit_drawer_nodes(x f64,y f64) int {
    did := s.top_open_drawer()
    if did <= 0 { << 0 }
    comp := $&s.composition
    comp.hitting_floating_root = did
    found := s.hit_subtree(did,x,y,0,0) >>> (err) {
        comp_e := $&s.composition
        comp_e.hitting_floating_root = 0
        >>> err
    }
    comp2 := $&s.composition
    comp2.hitting_floating_root = 0
    << found
}

fn (s $&Screen) drawer_handle_escape(actions $&[]Action) bool {
    did := s.top_open_drawer()
    if did <= 0 { << false }
    s.close_drawer_internal(did) >>> (err) { << true }
    actions.push(Action{kind: ACTION_DRAWER_STATE,id: did,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
    << true
}

fn (s $&Screen) drawer_handle_backdrop_click(x f64,y f64,actions $&[]Action) bool {
    did := s.top_open_drawer()
    if did <= 0 { << false }
    if s.nodes[did - 1].bounds.contains(x,y) { << false }
    dismiss := s.composition.drawers[did].spec.dismiss_on_backdrop
    if dismiss {
        s.close_drawer_internal(did) >>> (err) { << true }
        actions.push(Action{kind: ACTION_DRAWER_STATE,id: did,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
    }
    << true
}

fn (s $&Screen) cleanup_drawer_for(id int) {
    comp := $&s.composition
    if comp.drawers.has(id) {
        ds := $&comp.drawers
        ds.delete(id)
        next := vec_without(&comp.drawer_ids,id)
        comp.drawer_ids = next
        if comp.drawer_count > 0 { comp.drawer_count = comp.drawer_count - 1 }
    }
}
