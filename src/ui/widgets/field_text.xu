@ui/widgets
#errors
#strings
#unicode/utf8

pub struct FieldTextOptions {
    pub min_rows int
    pub max_rows int
    pub counter bool
    pub character_limit int
}
pub fn field_text_options() FieldTextOptions {
    << FieldTextOptions{min_rows: 0,max_rows: 0,counter: false,character_limit: 0}
}
pub fn (options &FieldTextOptions) validate() int {
    if options.min_rows < 0 || options.min_rows > 256 || options.max_rows < options.min_rows || options.max_rows > 256 ||
        (options.min_rows == 0 && options.max_rows != 0) || options.character_limit < 0 || options.character_limit > 1048576 {
        >> errors.new("widgets: invalid field text options")
    }
    << 0
}
pub fn (f &mut Field) set_text_options(options &FieldTextOptions) int {
    options.validate() or >>
    if !f.editor.is_multiline() && options.min_rows > 1 { >> errors.new("widgets: multiple rows require a text field area") }
    mut flags := (f.text_flags & (7 << 42)) | options.min_rows | (options.max_rows << 10) | (options.character_limit << 20)
    if options.counter { flags = flags | (1 << 41) }
    if f.text_flags != flags { f.text_flags = flags
        f.mark_dirty(true) }
    << 0
}
pub fn (f &Field) text_options() FieldTextOptions {
    << FieldTextOptions{min_rows: f.text_flags & 1023,max_rows: (f.text_flags >> 10) & 1023,
        counter: f.has_counter(),character_limit: (f.text_flags >> 20) & 2097151}
}
fn (f &Field) has_counter() bool { << (f.text_flags & (1 << 41)) != 0 }
// Counts Unicode scalars without truncating text or touching IME composition.
// This is a soft counter; application validation decides when to reject input.
pub fn (f &Field) character_count() int {
    value := f.editor.value()
    << utf8.rune_count(&value) or (err) { << 0 }
}
pub fn (f &Field) is_over_limit() bool {
    options := f.text_options()
    << options.character_limit > 0 && f.character_count() > options.character_limit
}
pub fn (f &Field) preferred_rows() int {
    options := f.text_options()
    if !f.editor.is_multiline() { << 1 }
    mut rows := 1
    value := f.editor.value()
    for i in 0:value.len { if (value[i] & 255) == 10 { rows += 1 } }
    if options.min_rows > 0 && rows < options.min_rows { rows = options.min_rows }
    if options.max_rows > 0 && rows > options.max_rows { rows = options.max_rows }
    << rows
}
fn (f &Field) counter_text() string {
    options := f.text_options()
    count := f.locale.integer(f.character_count())
    if options.character_limit > 0 { text := f.locale.count_text(TEXT_COUNTER_PATTERN,f.character_count()) or >>
        << strings.replace_all(&text,"{limit}",f.locale.integer(options.character_limit)) }
    << count
}

fn (f &Field) local_dirty() bool { << (f.text_flags & (1 << 42)) != 0 }
fn (f &mut Field) mark_dirty(value bool) { if value { f.text_flags = f.text_flags | (1 << 42) } else { f.text_flags = f.text_flags & (0 - 1 - (1 << 42)) } }
fn (f &Field) layout_ready() bool { << (f.text_flags & (1 << 43)) != 0 }
fn (f &mut Field) mark_ready() { f.text_flags = f.text_flags | (1 << 43) }
fn (f &Field) motion_reduced() bool { << (f.text_flags & (1 << 44)) != 0 }
fn (f &mut Field) set_motion_reduced(value bool) { if value { f.text_flags = f.text_flags | (1 << 44) } else { f.text_flags = f.text_flags & (0 - 1 - (1 << 44)) } }
