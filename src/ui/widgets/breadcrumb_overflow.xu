@ui/widgets

#ui
#ui/draw
#ui/layout
#math

fn (crumbs $&Breadcrumbs) update_overflow(styles &Styles,c &ControlStyle) int {
    b := crumbs.bounds()
    crumbs.collapsed=crumbs.extent>b.width && crumbs.items.len>2
    crumbs.first_visible=0
    if crumbs.collapsed {
        root_width := math.min(crumbs.widths[0],b.width*0.25)
        available := math.max(0.0,b.width-root_width-crumbs.gap*2.0-28.0)
        first := crumbs.items.len-1
        $used := crumbs.widths[first]
        $start := first
        while start>1 && used+crumbs.gap+crumbs.widths[start-1]<=available {
            used=used+crumbs.gap+crumbs.widths[start-1]
            start-=1
        }
        crumbs.first_visible=start
    }
    $shown := []int{}
    for i in 0:crumbs.items.len-1 { shown.push(i) }
    crumbs.history.shown=shown
    crumbs.history.anchor=copy_rect(&b)
    history := $&crumbs.history
    history.metrics(styles,c) or >>
    << 0
}
pub fn (crumbs &Breadcrumbs) overflow_bounds() layout.Rect {
    if !crumbs.collapsed { << screen_empty() }
    b := crumbs.bounds()
    root_width := math.min(crumbs.widths[0],b.width*0.25)
    << layout.Rect{x:b.x+root_width+crumbs.gap,y:b.y,width:28.0,height:b.height}
}
pub fn (crumbs &Breadcrumbs) popup_bounds() layout.Rect {
    if !crumbs.history.open { << screen_empty() }
    << crumbs.history.popup()
}
pub fn (crumbs $&Breadcrumbs) set_popup_above(above bool) { crumbs.history.above=above }
fn (crumbs $&Breadcrumbs) paint_overflow(frame $&draw.Frame,styles &Styles,c &ControlStyle) int {
    if !crumbs.collapsed { << 0 }
    b := crumbs.overflow_bounds()
    if crumbs.hot == -2 { rounded_fill(frame,&b,4.0*styles.density,c.palette.hovered) or >> }
    labels := $&crumbs.labels
    labels.paint_text(512,&"…",frame,&b,styles,c,0) or >>
    x := b.x+b.width+crumbs.gap*0.5
    y := b.y+b.height*0.5
    frame.line(x-2.0,y-4.0,x+2.0,y,c.palette.muted,1.5) or >>
    frame.line(x+2.0,y,x-2.0,y+4.0,c.palette.muted,1.5) or >>
    << 0
}
pub fn (crumbs $&Breadcrumbs) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    c := crumbs.style_or(styles)
    history := $&crumbs.history
    << history.paint(frame,styles,&c,false) or >>
}
