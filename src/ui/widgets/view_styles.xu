@ui/widgets

#ui/draw
#ui/layout
#errors
#unicode/utf8

pub const THEME_DARK = 0
pub const THEME_LIGHT = 1
pub const THEME_CONTRAST = 2

pub fn preset_styles(preset int) Styles {
    if preset == THEME_DARK { << dark_styles() }
    if preset == THEME_LIGHT { << light_styles() }
    if preset == THEME_CONTRAST { << contrast_styles() }
    >> errors.new("widgets: unknown style preset")
}
pub fn preset_name(preset int) string {
    if preset == THEME_DARK { << "dark" }
    if preset == THEME_LIGHT { << "light" }
    if preset == THEME_CONTRAST { << "contrast" }
    >> errors.new("widgets: unknown style preset")
}
pub fn next_preset(preset int) int {
    if preset < THEME_DARK || preset > THEME_CONTRAST { >> errors.new("widgets: unknown style preset") }
    << (preset + 1) % 3
}

pub struct StyleSwitcher {
    presets []Styles
    names []string
    current_index int
    scale f64
    density_factor f64
}
pub fn style_switcher() StyleSwitcher {
    << StyleSwitcher{presets: [dark_styles(),light_styles(),contrast_styles()],
        names: ["dark","light","contrast"],current_index: 0,scale: 1.0,density_factor: 1.0}
}
pub fn (switcher &StyleSwitcher) current() int { << switcher.current_index }
pub fn (switcher &StyleSwitcher) name() string { << switcher.names[switcher.current_index] + "" }
pub fn (switcher &StyleSwitcher) count() int { << switcher.presets.len }
pub fn (switcher &StyleSwitcher) text_scale() f64 { << switcher.scale }
pub fn (switcher &StyleSwitcher) density() f64 { << switcher.density_factor }
pub fn (switcher &StyleSwitcher) styles() Styles {
    mut result := switcher.presets[switcher.current_index].clone()
    result.text_scale = switcher.scale
    result.density = switcher.density_factor
    << result
}
pub fn (switcher &mut StyleSwitcher) use_preset(index int) int {
    if index < 0 || index >= switcher.presets.len { >> errors.new("widgets: style preset index out of range") }
    switcher.current_index = index
    << 0
}
pub fn (switcher &mut StyleSwitcher) use_name(name &string) int {
    for i in 0:switcher.names.len {
        if switcher.names[i] == name + "" {
            switcher.current_index = i
            << i
        }
    }
    >> errors.new("widgets: unknown style preset name")
}
pub fn (switcher &mut StyleSwitcher) next() int {
    switcher.current_index = switcher.current_index + 1
    if switcher.current_index >= switcher.presets.len { switcher.current_index = 0 }
    << switcher.current_index
}
pub fn (switcher &mut StyleSwitcher) set_text_scale(scale f64) int {
    if !finite_metric(scale,4.0) || scale < 0.5 { >> errors.new("widgets: invalid text scale") }
    for preset in switcher.presets {
        mut check := preset.clone()
        check.text_scale = scale
        check.density = switcher.density_factor
        check.validate() or >>
    }
    switcher.scale = scale
    << 0
}
pub fn (switcher &mut StyleSwitcher) set_density(density f64) int {
    if !finite_metric(density,4.0) || density < 0.5 { >> errors.new("widgets: invalid density") }
    switcher.density_factor = density
    << 0
}
pub fn (switcher &mut StyleSwitcher) set_preset(index int,styles &Styles) int {
    if index < 0 || index >= switcher.presets.len { >> errors.new("widgets: style preset index out of range") }
    mut check := styles.clone()
    check.text_scale = switcher.scale
    check.density = switcher.density_factor
    check.validate() or >>
    switcher.presets[index] = styles.clone()
    << 0
}
pub fn (switcher &mut StyleSwitcher) add_preset(name &string,styles &Styles) int {
    if name.len == 0 || name.len > 64 || !utf8.valid(name) { >> errors.new("widgets: invalid style preset name") }
    for i in 0:name.len { if (name[i] & 255) == 0 { >> errors.new("widgets: style preset name contains NUL") } }
    for existing in switcher.names { if existing == name + "" { >> errors.new("widgets: duplicate style preset name") } }
    if switcher.presets.len >= 16 { >> errors.new("widgets: too many style presets") }
    mut check := styles.clone()
    check.text_scale = switcher.scale
    check.density = switcher.density_factor
    check.validate() or >>
    index := switcher.presets.len
    switcher.presets.push(styles.clone())
    switcher.names.push(name + "")
    << index
}
pub fn (switcher &StyleSwitcher) apply(view &mut View) int {
    current := switcher.styles()
    << view.set_styles(&current) or >>
}
pub fn (switcher &mut StyleSwitcher) cycle(view &mut View) int {
    index := switcher.next()
    switcher.apply(view) or >>
    << index
}

// Styled callbacks receive the effective theme for this node. Measurement is
// opt-in; overlay is painted after children (for scrollbars and decorations).
struct StyleScope { id int
    styles Styles }
pub struct@ StyledPainter {
    fn measure_styled(int,&Styles) layout.Size
    fn paint_styled(int,&layout.Rect,&Styles,&mut draw.Frame) bool
    fn overlay_styled(int,&layout.Rect,&Styles,&mut draw.Frame) bool
}
pub fn (view &View) styles() Styles {
    view.check() or >>
    << view.styles.clone()
}
pub fn (view &View) has_style_scope(id int) bool {
    view.check() or >>
    index := view.node_index(id) or >>
    << view.nodes[index].scope
}
pub fn (view &mut View) invalidate_control(id int) int {
    << view.mark_measure(id) or >>
}
pub fn (view &View) styles_for(id int) Styles {
    owner := view.style_owner(id) or >>
    if owner > 0 { << view.copy_scope(owner) or >> }
    << view.styles.clone()
}
fn (view &View) copy_scope(owner int) Styles {
    for entry in view.scopes { if entry.id == owner { << entry.styles.clone() } }
    >> errors.new("widgets: missing style scope")
}
// Borrow themes for callbacks. Returning a complete Styles value at every
// tree level multiplies large aggregate copies on the bounded Xu task stack.
fn (view &View) style_owner(id int) int {
    view.check() or >>
    mut current := id
    while current > 0 {
        index := view.node_index(current) or >>
        if view.nodes[index].scope { << current }
        current = view.tree.parent(current) or >>
    }
    << 0
}
fn measure_scoped_style#P:StyledPainter(view &mut View,owner int,id int,painter &mut P) layout.Size {
    for entry in view.scopes { if entry.id == owner { << painter.measure_styled(id,&entry.styles) } }
    >> errors.new("widgets: missing style scope")
}
fn measure_node_style#P:StyledPainter(view &mut View,id int,painter &mut P) layout.Size {
    owner := view.style_owner(id) or >>
    if owner == 0 { << painter.measure_styled(id,&view.styles) }
    << measure_scoped_style(view,owner,id,painter) or >>
}
fn paint_scoped_style#P:StyledPainter(view &mut View,owner int,id int,bounds &layout.Rect,frame &mut draw.Frame,overlay bool,painter &mut P) bool {
    for entry in view.scopes { if entry.id == owner {
        if overlay { << painter.overlay_styled(id,bounds,&entry.styles,frame) }
        << painter.paint_styled(id,bounds,&entry.styles,frame)
    } }
    >> errors.new("widgets: missing style scope")
}
fn paint_node_style#P:StyledPainter(view &mut View,id int,bounds &layout.Rect,frame &mut draw.Frame,overlay bool,painter &mut P) bool {
    owner := view.style_owner(id) or >>
    if owner == 0 {
        if overlay { << painter.overlay_styled(id,bounds,&view.styles,frame) }
        << painter.paint_styled(id,bounds,&view.styles,frame)
    }
    << paint_scoped_style(view,owner,id,bounds,frame,overlay,painter) or >>
}
fn (view &mut View) invalidate_styles(id int,metrics bool) int {
    index := view.node_index(id) or >>
    if metrics && view.nodes[index].measure_style { view.nodes[index].measure_dirty = true }
    view.mark_paint(id) or >>
    children := view.tree.children(id) or >>
    for child in children {
        slot := view.node_index(child) or >>
        if !view.nodes[slot].scope { view.invalidate_styles(child,metrics) or >> }
    }
    << 0
}
pub fn (view &mut View) set_styles(styles &Styles) int {
    view.check() or >>
    styles.validate() or >>
    if view.styles.same_as(styles) { << 0 }
    metrics := !view.styles.same_metrics(styles)
    view.styles = styles.clone()
    view.set_background(styles.background)
    << view.invalidate_styles(view.root,metrics) or >>
}
// A scope is a complete snapshot. Descendants inherit it until another scope;
// later global changes preserve these explicit local overrides.
pub fn (view &mut View) set_style_scope(id int,styles &Styles) int {
    view.check() or >>
    if id == view.root { >> errors.new("widgets: use set_styles for the root theme") }
    styles.validate() or >>
    previous := view.styles_for(id) or >>
    index := view.node_index(id) or >>
    mut slot := -1
    for i in 0:view.scopes.len { if view.scopes[i].id == id { slot = i
        <- } }
    if slot < 0 { for i in 0:view.scopes.len { if view.scopes[i].id == 0 { slot = i
        <- } } }
    if slot < 0 { view.scopes.push(StyleScope{id: id,styles: styles.clone()}) }
    else { view.scopes[slot] = StyleScope{id: id,styles: styles.clone()} }
    view.nodes[index].scope = true
    if previous.same_as(styles) { << 0 }
    << view.invalidate_styles(id,!previous.same_metrics(styles)) or >>
}
pub fn (view &mut View) clear_style_scope(id int) int {
    view.check() or >>
    previous := view.styles_for(id) or >>
    index := view.node_index(id) or >>
    if !view.nodes[index].scope { << 0 }
    view.nodes[index].scope = false
    for i in 0:view.scopes.len { if view.scopes[i].id == id { view.scopes[i].id = 0 } }
    current := view.styles_for(id) or >>
    if previous.same_as(&current) { << 0 }
    << view.invalidate_styles(id,!previous.same_metrics(&current)) or >>
}
pub fn (view &mut View) set_style_measure(id int,on bool) int {
    view.check() or >>
    index := view.node_index(id) or >>
    if on && !view.nodes[index].measure_style { view.nodes[index].measure_dirty = true
        view.mark_paint(id) or >> }
    view.nodes[index].measure_style = on
    << 0
}
pub fn (view &mut View) mark_measure(id int) int {
    view.check() or >>
    index := view.node_index(id) or >>
    if view.nodes[index].measure_style { view.nodes[index].measure_dirty = true }
    << view.mark_paint(id) or >>
}
pub fn layout_styled#P:StyledPainter(view &mut View,constraints &layout.Constraints,painter &mut P) layout.Size {
    view.check() or >>
    for i in 0:view.nodes.len {
        id := view.nodes[i].id
        if id > 0 && view.nodes[i].measure_style && view.nodes[i].measure_dirty {
            size := measure_node_style(view,id,painter) or >>
            view.set_intrinsic(id,&size) or >>
            view.nodes[i].measure_dirty = false
        }
    }
    << view.layout(constraints) or >>
}
fn paint_styled_contents#P:StyledPainter(view &mut View,id int,frame &mut draw.Frame,painter &mut P) int {
    box := view.tree.style(id) or >>
    if box.hidden { << 0 }
    bounds := view.tree.bounds(id) or >>
    local := layout.Rect{x: 0.0,y: 0.0,width: bounds.width,height: bounds.height}
    frame.push() or >>
    if box.clip { frame.clip_rect(0.0,0.0,bounds.width,bounds.height) or >> }
    if !paint_node_style(view,id,&local,frame,false,painter) or >> { >> errors.new("widgets: styled node paint failed") }
    view.painted_nodes = view.painted_nodes + 1
    children := view.tree.children(id) or >>
    offset := view.tree.scroll_offset(id) or >>
    frame.push() or >>
    if children.len > 0 && (offset.x != 0.0 || offset.y != 0.0) { frame.translate(0.0 - offset.x,0.0 - offset.y) or >> }
    for child in children {
        if view.tree.visible(child) or >> {
            position := view.tree.bounds(child) or >>
            frame.push() or >>
            frame.translate(position.x,position.y) or >>
            index := view.node_index(child) or >>
            if view.nodes[index].boundary { prepare_styled_boundary(view,child,painter) or >>
                frame.pooled_display_list(&view.records,child) or >> }
            else { paint_styled_contents(view,child,frame,painter) or >> }
            frame.pop() or >>
        }
    }
    frame.pop() or >>
    if !paint_node_style(view,id,&local,frame,true,painter) or >> { >> errors.new("widgets: styled overlay paint failed") }
    frame.pop() or >>
    << 0
}
fn prepare_styled_boundary#P:StyledPainter(view &mut View,id int,painter &mut P) int {
    revision := view.tree.paint_revision(id) or >>
    if view.records.is_current(id,revision) { view.reused_boundaries = view.reused_boundaries + 1
        << 0 }
    mut frame := view.context.new_frame(1024)
    frame.begin() or >>
    paint_styled_contents(view,id,mut &frame,painter) or (err) { frame.dispose()
        >> err }
    records := mut &view.records
    records.capture(id,revision,mut &frame) or (err) { frame.dispose()
        >> err }
    frame.dispose()
    view.recorded_boundaries = view.recorded_boundaries + 1
    << 0
}
pub fn present_styled#P:StyledPainter(view &mut View,constraints &layout.Constraints,painter &mut P) bool {
    _ := layout_styled(view,constraints,painter) or >>
    view.use_painter(2) or >>
    view.painted_nodes = 0
    view.recorded_boundaries = 0
    view.reused_boundaries = 0
    view.frame_commands = 0
    if !view.needs_frame() { << false }
    prepare_styled_boundary(view,view.root,painter) or >>
    mut frame := view.context.new_frame(256)
    frame.begin() or >>
    frame.set_bg(view.background) or (err) { frame.dispose()
        >> err }
    frame.pooled_display_list(&view.records,view.root) or (err) { frame.dispose()
        >> err }
    view.frame_commands = frame.command_count()
    frame.present() or (err) { frame.dispose()
        >> err }
    view.presented_revision = view.tree.paint_revision(view.root) or >>
    view.background_dirty = false
    << true
}

pub fn snapshot_styled#P:StyledPainter(view &mut View,constraints &layout.Constraints,scale f64,painter &mut P) draw.Surface {
    view.check() or >>
    size := layout_styled(view,constraints,painter) or >>
    view.use_painter(2) or >>
    view.painted_nodes = 0
    view.recorded_boundaries = 0
    view.reused_boundaries = 0
    view.frame_commands = 0
    prepare_styled_boundary(view,view.root,painter) or >>
    mut frame := view.context.new_frame(256)
    frame.begin() or >>
    frame.set_bg(view.background) or (err) { frame.dispose()
        >> err }
    frame.pooled_display_list(&view.records,view.root) or (err) { frame.dispose()
        >> err }
    surface := frame.snapshot(size.width,size.height,scale) or (err) { frame.dispose()
        >> err }
    frame.dispose()
    << surface
}

fn (view &mut View) use_painter(mode int) int {
    if view.paint_mode == mode { << 0 }
    if view.paint_mode != 0 {
        for node in view.nodes { if node.id > 0 { view.mark_paint(node.id) or >> } }
    }
    view.paint_mode = mode
    << 0
}
