@ui/widgets

#ui
#errors

pub const ACTION_SHORTCUT = 10

pub struct ShortcutBinding {
    pub id int
    pub key int
    pub modifiers int
    pub scope int
    pub allow_in_text_input bool
    pub repeat bool
}

fn normalize_shortcut_key(key int) int {
    if key >= 97 && key <= 122 { << key - 32 }
    << key
}

pub fn shortcut_binding(id int,key int,modifiers int) ShortcutBinding {
    nk := normalize_shortcut_key(key)
    allow_text := (modifiers & (ui.MOD_CONTROL | ui.MOD_ALT | ui.MOD_META)) != 0 || nk == ui.KEY_ESCAPE
    << ShortcutBinding{
        id: id,
        key: nk,
        modifiers: modifiers,
        scope: 0,
        allow_in_text_input: allow_text,
        repeat: false
    }
}

pub fn (b &ShortcutBinding) validate() int {
    if b.id <= 0 || b.key < 1 || b.key > 1114111 || b.modifiers < 0 || b.modifiers > 15 || b.scope < 0 {
        >>> errors.new("widgets: invalid shortcut binding")
    }
    << 0
}

fn copy_shortcut_binding(b &ShortcutBinding) ShortcutBinding {
    << ShortcutBinding{
        id: b.id,
        key: normalize_shortcut_key(b.key),
        modifiers: b.modifiers,
        scope: b.scope,
        allow_in_text_input: b.allow_in_text_input,
        repeat: b.repeat
    }
}

pub fn (s $&Screen) bind_shortcut(binding &ShortcutBinding) int {
    s.check_screen() >>>
    binding.validate() >>>
    if binding.scope > 0 { _ := s.node(binding.scope) >>> }
    item := copy_shortcut_binding(binding)
    comp := $&s.composition
    list := $&comp.shortcuts
    for i in 0:list.len {
        if list[i].id == item.id {
            list[i] = item
            << 0
        }
    }
    if list.len >= 256 { >>> errors.new("widgets: shortcut binding capacity exceeded") }
    list.push(item)
    << 0
}

pub fn (s $&Screen) unbind_shortcut(command_id int) int {
    s.check_screen() >>>
    comp := $&s.composition
    $next := []ShortcutBinding{}
    for i in 0:comp.shortcuts.len {
        b := &comp.shortcuts[i]
        if b.id != command_id { next.push(copy_shortcut_binding(b)) }
    }
    comp.shortcuts = next
    << 0
}

pub fn (s $&Screen) clear_shortcuts() int {
    s.check_screen() >>>
    comp := $&s.composition
    comp.shortcuts = []ShortcutBinding{}
    << 0
}

pub fn (s &Screen) shortcut_count() int {
    << s.composition.shortcuts.len
}

fn (s &Screen) focused_is_text_input() bool {
    if s.focused <= 0 || s.focused > s.nodes.len { << false }
    k := s.nodes[s.focused - 1].kind
    << k == SCREEN_EDITOR || k == SCREEN_SECRET_INPUT || k == SCREEN_FIELD || k == SCREEN_COMBO
}

fn (s &Screen) match_shortcut(input &ui.InputEvent,modal int) Action {
    if input.kind != ui.EV_KEY_DOWN || s.composition.shortcuts.len == 0 {
        << no_action(0,false)
    }
    ev_key := normalize_shortcut_key(input.key)
    ev_mods := input.modifiers & 15
    eff_scope := s.effective_focus_scope(modal)
    in_text := s.focused_is_text_input()
    list := &s.composition.shortcuts
    for pass in 0:2 {
        want_scoped := pass == 0
        for i in 0:list.len {
            b := &list[i]
            is_scoped := b.scope > 0
            if is_scoped != want_scoped { -> }
            if b.key != ev_key || b.modifiers != ev_mods { -> }
            if !b.repeat && input.repeat != 0 { -> }
            if !b.allow_in_text_input && in_text { -> }
            if is_scoped {
                sc := b.scope
                if sc > s.nodes.len || s.nodes[sc - 1].kind < 0 ||
                   !s.is_visible(sc) || s.is_layout_hidden(sc) || !s.effective_enabled(sc) {
                    ->
                }
                inside_focus := s.focused > 0 && s.is_descendant(s.focused,sc)
                if !inside_focus && sc != eff_scope { -> }
                if eff_scope > 0 && sc != eff_scope && !s.is_descendant(sc,eff_scope) { -> }
            } else if modal > 0 {
                ->
            }
            << Action{kind: ACTION_SHORTCUT,id: b.id,needs_paint: false,request_focus: false,consumed: true,value: f64(ev_key)}
        }
    }
    << no_action(0,false)
}

fn (s $&Screen) cleanup_shortcuts_for(scope_id int) {
    if scope_id <= 0 || s.composition.shortcuts.len == 0 { << }
    $has_match := false
    for i in 0:s.composition.shortcuts.len {
        if s.composition.shortcuts[i].scope == scope_id {
            has_match = true
            <-
        }
    }
    if !has_match { << }
    comp := $&s.composition
    $next := []ShortcutBinding{}
    for i in 0:comp.shortcuts.len {
        b := &comp.shortcuts[i]
        if b.scope != scope_id { next.push(copy_shortcut_binding(b)) }
    }
    comp.shortcuts = next
}
