@ui/widgets
#ui/draw
#ui/layout
#time
#math

fn (m &Menu) popup_style(styles &Styles) ControlStyle {
    $c := styles.input.clone()
    if m.control.has_style() { c = m.control.style_or(styles) }
    c.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    c.align_x = 0.0
    c.align_y = 0.5
    if c.inherit_font { c.font = copy_font(&styles.font) }
    c.inherit_font = false
    << c
}
fn (m &Menu) item_height(index int) f64 {
    if m.items[index].kind == MENU_SEPARATOR { << 12.0 * m.density }
    << m.row_height
}
fn (m &Menu) row_bounds(index int,depth int) layout.Rect {
    if depth < 0 || depth >= m.panels.len || depth >= m.path.len { << screen_empty() }
    panel := m.panels[depth]
    $y := panel.y + 6.0 * m.density - m.offsets[depth]
    for i in 0:m.items.len { if m.items[i].parent == m.path[depth] {
        h := m.item_height(i)
        if i == index { << layout.Rect{x: panel.x + 6.0 * m.density,y: y,width: math.max(0.0,panel.width - 12.0 * m.density),height: h} }
        y = y + h } }
    << screen_empty()
}
fn (m &Menu) hit(x f64,y f64) int {
    $depth := m.panels.len - 1
    while depth >= 0 {
        if m.panels[depth].contains(x,y) {
            for i in 0:m.items.len { if m.items[i].parent == m.path[depth] && m.row_bounds(i,depth).contains(x,y) { << i } }
            << -1 }
        depth -= 1 }
    << -1
}
fn (m &Menu) item_depth(index int) int {
    if index < 0 || index >= m.items.len { << -1 }
    for depth in 0:m.path.len { if m.items[index].parent == m.path[depth] { << depth } }
    << -1
}
pub fn (m &Menu) popup_bounds() layout.Rect {
    if (!m.opened && m.fade.value() <= 0.0) || m.panels.len == 0 { << screen_empty() }
    $b := m.panels[0]
    for p in m.panels { right := math.max(b.x + b.width,p.x + p.width)
        bottom := math.max(b.y + b.height,p.y + p.height)
        b.x = math.min(b.x,p.x)
        b.y = math.min(b.y,p.y)
        b.width = right - b.x
        b.height = bottom - b.y }
    << b
}
fn (m &Menu) panel_content_height(parent int) f64 {
    $height := 12.0 * m.density
    for i in 0:m.items.len { if m.items[i].parent == parent { height = height + m.item_height(i) } }
    << height
}
pub fn (m $&Menu) set_viewport(viewport &layout.Rect) int {
    validate_bounds(viewport) or >>
    if !overlay_same_rect(&m.viewport,viewport) { m.viewport = copy_rect(viewport)
        m.control.dirty = true }
    << 0
}
pub fn (m $&Menu) apply_styles(styles &Styles) int {
    m.density = styles.density
    c := m.popup_style(styles)
    m.row_height = math.max(m.appearance.row_height * styles.density,styles.text_options(&c).size * 1.25 + 12.0 * styles.density)
    if !m.opened && m.fade.value() <= 0.0 { << 0 }
    options := styles.text_options(&c)
    if !m.metrics_ready || !options_equal(&m.metrics_options,&options) {
        $widths := []f64{}
        scratch := m.items.len*2+1
        for i in 0:m.items.len {
            label := m.items[i].label + ""
            shortcut := m.items[i].shortcut_label + ""
            cache := $&m.labels
            a := cache.measure(scratch,&label,styles,&c) or >>
            b := cache.measure(scratch+1,&shortcut,styles,&c) or >>
            widths.push(a.width+b.width)
        }
        m.item_widths = widths
        m.metrics_options = copy_text_options(&options)
        m.metrics_ready = true
    }
    $panels := []layout.Rect{}
    margin := 8.0 * styles.density
    viewport := layout.Rect{x: m.viewport.x + margin,y: m.viewport.y + margin,width: math.max(0.0,m.viewport.width - margin * 2.0),height: math.max(0.0,m.viewport.height - margin * 2.0)}
    for depth in 0:m.path.len {
        $width := m.appearance.min_width * styles.density
        for i in 0:m.items.len { if m.items[i].parent == m.path[depth] {
            width = math.max(width,m.item_widths[i]+76.0*styles.density) } }
        width = math.min(viewport.width,math.min(width,m.appearance.max_width * styles.density))
        height := math.min(viewport.height,m.panel_content_height(m.path[depth]))
        $panel := anchored_overlay_bounds(&m.anchor,&layout.Size{width: width,height: height},&viewport) or >>
        if depth > 0 {
            parent := panels[depth - 1]
            $y := parent.y
            parent_index := m.index(m.path[depth])
            // Row bounds use the established parent panels, never stale sizes.
            $row_y := parent.y + 6.0 * m.density - m.offsets[depth - 1]
            for i in 0:m.items.len { if m.items[i].parent == m.path[depth - 1] {
                if i == parent_index { y = row_y - 6.0 * m.density }
                row_y = row_y + m.item_height(i) } }
            $x := parent.x + parent.width - 2.0 * m.density
            if x + width > viewport.x + viewport.width { x = parent.x - width + 2.0 * m.density }
            panel = layout.Rect{x: math.max(viewport.x,math.min(viewport.x + viewport.width - width,x)),y: math.max(viewport.y,math.min(viewport.y + viewport.height - height,y)),width: width,height: height} }
        panels.push(panel)
        m.offsets[depth] = math.max(0.0,math.min(m.offsets[depth],m.panel_content_height(m.path[depth]) - panel.height))
    }
    $changed := panels.len != m.panels.len
    if !changed { for i in 0:panels.len { if !overlay_same_rect(&panels[i],&m.panels[i]) { changed = true } } }
    m.panels = panels
    if changed { m.control.dirty = true }
    << 0
}
fn (m $&Menu) reveal_active() {
    depth := m.item_depth(m.active)
    if depth < 0 || depth >= m.panels.len { << }
    row := m.row_bounds(m.active,depth)
    panel := m.panels[depth]
    pad := 6.0 * m.density
    if row.y < panel.y + pad { m.offsets[depth] = math.max(0.0,m.offsets[depth] + row.y - panel.y - pad) }
    else if row.y + row.height > panel.y + panel.height - pad { m.offsets[depth] = m.offsets[depth] + row.y + row.height - panel.y - panel.height + pad }
}
fn (m &Menu) item_state(index int) int {
    $state := 0
    if !m.item_enabled(index) || m.control.read_only { state = state | STATE_DISABLED }
    if m.opened {
        if index == m.hot || index == m.active { state = state | STATE_HOVERED }
        for key in m.path { if key > 0 && m.items[index].key == key { state = state | STATE_HOVERED } }
    }
    if index == m.armed || (m.key_armed > 0 && m.active == index) { state = state | STATE_PRESSED }
    << state
}
pub fn (m $&Menu) tick(styles &Styles,now time.Instant,reduced bool) bool {
    m.now = now
    m.reduced = reduced
    if m.opened && !m.hover_due.is_zero() && !now.before(m.hover_due) {
        index := m.hover_item
        m.hover_due = time.zero_instant()
        m.hover_item = -1
        if index >= 0 && m.item_enabled(index) {
            if m.items[index].kind == MENU_SUBMENU { m.open_child(index) or >> }
            else { depth := m.item_depth(index)
                if depth >= 0 { m.truncate(depth + 1) } } }
    }
    m.apply_styles(styles) or >>
    $target := 0.0
    if m.opened && m.is_enabled() { target = 1.0 }
    spec := m.motion
    $duration := spec.exit
    $curve := spec.exit_easing()
    if m.opened { duration = spec.enter
        curve = spec.curve }
    $changed := range_tween_step($&m.fade,target,now,duration,curve,reduced) or >>
    if !m.opened && m.fade.value() <= 0.0 {
        trigger_key := m.items.len*2
        cache := $&m.labels
        cache.retain_keys(&[trigger_key])
        m.panels = []layout.Rect{}
        m.path = []int{}
        m.offsets = []f64{}
    }
    next := range_tween_step($&m.submenu_fade,1.0,now,spec.enter,spec.curve,reduced) or >>
    changed = changed || next
    base := m.control.style_or(styles)
    $state := m.control.visual_state()
    if !m.opened && m.key_armed > 0 { state = state | STATE_PRESSED }
    transition := $&m.transition
    before := transition.progress.value()
    _ := transition.style(&base,state,now,reduced) or >>
    changed = changed || before != transition.progress.value() || transition.is_animating()
    popup := m.popup_style(styles)
    if m.opened || m.fade.value() > 0.0 { for i in 0:m.rows.len { state := m.item_state(i)
        $row := m.rows[i]
        old := row.progress.value()
        _ := row.style(&popup,state,now,reduced) or >>
        changed = changed || old != row.progress.value() || row.is_animating()
        m.rows[i] = row } }
    if changed { m.control.dirty = true }
    << changed
}
pub fn (m &Menu) next_tick(now time.Instant) time.Instant {
    $animated := m.fade.is_animating() || m.transition.is_animating()
    if m.opened || m.fade.value() > 0.0 { animated = animated || m.submenu_fade.is_animating()
        for row in m.rows { if row.is_animating() { animated = true } } }
    next := overlay_next_tick(animated,now) or >>
    << screen_earlier(next,m.hover_due)
}
