@ui/widgets
#ui/draw
#ui/layout
#time
#math
#strconv

pub fn (r &mut RangeSlider) apply_styles(styles &Styles) int {
    c := r.style_or(styles)
    b := r.bounds()
    d := styles.density
    mut label_height := 0.0
    if r.appearance.show_value { label_height = math.min(b.height * 0.4,styles.text_options(&c).size * 1.5 + 4.0 * d) }
    width := math.max(0.0,b.width - (c.padding.left + c.padding.right) * d)
    height := math.max(0.0,b.height - (c.padding.top + c.padding.bottom) * d - label_height)
    thumb := math.max(0.0,math.min(c.indicator_size * d,math.min(width,height)))
    inset := thumb * 0.5 + 6.0 * d
    mut track := layout.Rect{x: b.x + c.padding.left * d + inset,y: b.y + c.padding.top * d + height * 0.5,
        width: math.max(0.0,width - inset * 2.0),height: 0.0}
    if r.options.vertical { track = layout.Rect{x: b.x + c.padding.left * d + width * 0.5,y: b.y + c.padding.top * d + inset,
        width: 0.0,height: math.max(0.0,height - inset * 2.0)} }
    old := r.track
    if old.x != track.x || old.y != track.y || old.width != track.width || old.height != track.height || r.thumb != thumb { r.control.dirty = true }
    r.track = track
    r.thumb = thumb
    << 0
}
fn range_tween_step(t &mut Tween,value f64,now time.Instant,duration time.Duration,curve int,snap bool) bool {
    before := t.value()
    t.set_curve(curve) or >>
    t.retarget(value,now,duration,snap) or >>
    _ := t.advance(now) or >>
    << before != t.value()
}
pub fn (r &mut RangeSlider) tick(styles &Styles,now time.Instant,reduced bool) bool {
    r.now = now
    r.reduced = reduced
    r.apply_styles(styles) or >>
    low := r.ratio(r.lower)
    high := r.ratio(r.upper)
    snap := reduced || !r.ready || r.dragging >= 0 || !r.is_enabled()
    spec := r.motion
    mut changed := range_tween_step(mut &r.lower_motion,low,now,spec.change,spec.curve,snap) or >>
    next := range_tween_step(mut &r.upper_motion,high,now,spec.change,spec.curve,snap) or >>
    changed = changed || next
    mut lo_halo := 0.0
    mut hi_halo := 0.0
    if r.is_enabled() {
        if r.hot == 0 || (r.active == 0 && r.control.focused) || r.dragging == 2 { lo_halo = 1.0 }
        if r.hot == 1 || (r.active == 1 && r.control.focused) || r.dragging == 2 { hi_halo = 1.0 } }
    halo_snap := reduced || !r.is_enabled()
    a := range_tween_step(mut &r.lower_halo,lo_halo,now,spec.hover,spec.curve,halo_snap) or >>
    b := range_tween_step(mut &r.upper_halo,hi_halo,now,spec.hover,spec.curve,halo_snap) or >>
    changed = changed || a || b
    r.ready = true
    if changed { r.control.dirty = true }
    << changed
}
pub fn (r &RangeSlider) next_tick(now time.Instant) time.Instant {
    << overlay_next_tick(r.lower_motion.is_animating() || r.upper_motion.is_animating() || r.lower_halo.is_animating() || r.upper_halo.is_animating(),now) or >>
}
fn (r &RangeSlider) point(fraction f64) layout.Rect {
    mut t := fraction
    if r.options.reversed { t = 1.0 - t }
    mut x := r.track.x + r.track.width * t
    mut y := r.track.y
    if r.options.vertical { x = r.track.x
        y = r.track.y + r.track.height * (1.0 - t) }
    << layout.Rect{x: x - r.thumb * 0.5,y: y - r.thumb * 0.5,width: r.thumb,height: r.thumb}
}
fn (r &RangeSlider) paint_thumb(frame &mut draw.Frame,styles &Styles,c &ControlStyle,index int,box &layout.Rect,halo f64) int {
    mut state := r.control.visual_state() & (STATE_DISABLED | STATE_READ_ONLY | STATE_INVALID)
    if r.hot == index { state = state | STATE_HOVERED }
    if r.dragging == index || r.dragging == 2 { state = state | STATE_PRESSED }
    if r.control.focused && r.active == index { state = state | STATE_FOCUSED }
    paint := c.resolve(state)
    color := c.palette.accent
    mut ink := color
    if r.control.invalid { ink = c.palette.invalid }
    if !r.is_enabled() { ink = c.palette.muted }
    radius := box.width * 0.5
    cx := box.x + radius
    cy := box.y + radius
    if halo > 0.0 { frame.set_fill(fade_color(ink,0.12 * halo)) or >>
        frame.circle(cx,cy,radius + 6.0 * styles.density * halo) or >> }
    rounded_fill(frame,box,radius,c.palette.on_accent) or >>
    rounded_stroke(frame,box,radius,ink,math.max(1.0,c.border_width) * styles.density) or >>
    if r.dragging == index || r.dragging == 2 { frame.set_fill(ink) or >>
        frame.circle(cx,cy,radius * 0.32) or >> }
    if (state & STATE_FOCUSED) != 0 && r.is_enabled() {
        gap := 3.0 * styles.density
        ring := layout.Rect{x: box.x - gap,y: box.y - gap,width: box.width + gap * 2.0,height: box.height + gap * 2.0}
        rounded_stroke(frame,&ring,radius + gap,paint.focus,c.focus_width * styles.density) or >> }
    << 0
}
pub fn (r &mut RangeSlider) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    c := r.style_or(styles)
    bounds := r.bounds()
    d := styles.density
    thickness := math.max(2.0,c.mark_width * d)
    mut lo := r.ratio(r.lower)
    mut hi := r.ratio(r.upper)
    if r.ready { lo = r.lower_motion.value()
        hi = r.upper_motion.value() }
    a := r.point(lo)
    b := r.point(hi)
    mut track := layout.Rect{x: r.track.x,y: r.track.y - thickness * 0.5,width: r.track.width,height: thickness}
    mut fill := layout.Rect{x: math.min(a.x,b.x) + r.thumb * 0.5,y: track.y,width: math.abs(b.x - a.x),height: thickness}
    if r.options.vertical { track = layout.Rect{x: r.track.x - thickness * 0.5,y: r.track.y,width: thickness,height: r.track.height}
        fill = layout.Rect{x: track.x,y: math.min(a.y,b.y) + r.thumb * 0.5,width: thickness,height: math.abs(b.y - a.y)} }
    state := r.control.visual_state()
    paint := c.resolve(state)
    mut accent := c.palette.accent
    if r.control.invalid { accent = c.palette.invalid }
    if !r.is_enabled() { accent = c.palette.muted }
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    rounded_fill(frame,&track,thickness * 0.5,paint.background) or >>
    rounded_stroke(frame,&track,thickness * 0.5,paint.border,c.border_width * d) or >>
    rounded_fill(frame,&fill,thickness * 0.5,accent) or >>
    if r.appearance.ticks > 1 { count := r.appearance.ticks
        mut length := r.track.width
        if r.options.vertical { length = r.track.height }
        if length / f64(count - 1) >= 6.0 * d { for i in 0:count { p := r.point(f64(i) / f64(count - 1))
            x := p.x + r.thumb * 0.5
            y := p.y + r.thumb * 0.5
            if r.options.vertical { frame.line(x - thickness,y,x + thickness,y,paint.border,d) or >> }
            else { frame.line(x,y - thickness,x,y + thickness,paint.border,d) or >> }
        } } }
    // The focused thumb paints last when both values coincide.
    if r.active == 0 { r.paint_thumb(frame,styles,&c,1,&b,r.upper_halo.value()) or >>
        r.paint_thumb(frame,styles,&c,0,&a,r.lower_halo.value()) or >> }
    else { r.paint_thumb(frame,styles,&c,0,&a,r.lower_halo.value()) or >>
        r.paint_thumb(frame,styles,&c,1,&b,r.upper_halo.value()) or >> }
    if r.appearance.show_value {
        lower := localized_number(strconv.format_float(r.lower,102,r.appearance.decimals) or >>,&r.locale)
        upper := localized_number(strconv.format_float(r.upper,102,r.appearance.decimals) or >>,&r.locale)
        text := lower + " – " + upper
        mut font := c.clone()
        font.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
        font.align_x = 0.5
        font.align_y = 1.0
        if font.inherit_font { font.font = copy_font(&styles.font) }
        font.font.size = font.font.size * 0.85
        font.inherit_font = false
        label := layout.Rect{x: bounds.x,y: bounds.y + bounds.height * 0.6,width: bounds.width,height: bounds.height * 0.4}
        cache := mut &r.labels
        cache.paint_text(0,&text,frame,&label,styles,&font,state) or >> }
    frame.pop() or >>
    << 0
}
