@ui/widgets

#ui/draw
#ui/layout
#math
#time

fn token_color_luma(c draw.Color) f64 {
    v := c.value()
    r := f64((v >> 24) & 255)
    g := f64((v >> 16) & 255)
    b := f64((v >> 8) & 255)
    << r * 0.2126 + g * 0.7152 + b * 0.0722
}

fn token_mix_rgb(a draw.Color,b draw.Color,t f64) draw.Color {
    u := math.max(0.0,math.min(1.0,t))
    ax := a.value()
    bx := b.value()
    ar := f64((ax >> 24) & 255)
    ag := f64((ax >> 16) & 255)
    ab := f64((ax >> 8) & 255)
    br := f64((bx >> 24) & 255)
    bg := f64((bx >> 16) & 255)
    bb := f64((bx >> 8) & 255)
    rr := int(math.round(math.max(0.0,math.min(255.0,ar + (br - ar) * u))))
    rg := int(math.round(math.max(0.0,math.min(255.0,ag + (bg - ag) * u))))
    rb := int(math.round(math.max(0.0,math.min(255.0,ab + (bb - ab) * u))))
    aa := ax & 255
    ba := bx & 255
    ra := int(math.round(math.max(0.0,math.min(255.0,f64(aa) + f64(ba - aa) * u))))
    << draw.rgba(rr,rg,rb,ra)
}

pub fn patch_primary(styles &Styles) ControlStylePatch {
    p := styles.button.palette
    light_mode := token_color_luma(styles.background) > 128.0
    $hov := token_mix_rgb(p.accent,draw.rgb(255,255,255),0.14)
    $prs := token_mix_rgb(p.accent,draw.rgb(0,0,0),0.18)
    if light_mode {
        hov = token_mix_rgb(p.accent,draw.rgb(0,0,0),0.10)
        prs = token_mix_rgb(p.accent,draw.rgb(0,0,0),0.24)
    }
    $out := control_style_patch()
    out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED |
        STYLE_PATCH_FOREGROUND | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH
    out.normal = p.accent
    out.hovered = hov
    out.pressed = prs
    out.foreground = p.on_accent
    out.border = p.accent
    out.border_width = 1.0
    << out
}

pub fn patch_secondary(styles &Styles) ControlStylePatch {
    p := styles.button.palette
    $out := control_style_patch()
    out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED |
        STYLE_PATCH_FOREGROUND | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH
    out.normal = p.normal
    out.hovered = p.hovered
    out.pressed = p.pressed
    out.foreground = p.foreground
    out.border = p.border
    out.border_width = 1.0
    << out
}

pub fn patch_ghost(styles &Styles) ControlStylePatch {
    p := styles.button.palette
    $out := control_style_patch()
    out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED |
        STYLE_PATCH_FOREGROUND | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH
    out.normal = draw.rgba(0,0,0,0)
    out.hovered = p.hovered.with_alpha(180)
    out.pressed = p.pressed.with_alpha(220)
    out.foreground = p.foreground
    out.border = draw.rgba(0,0,0,0)
    out.border_width = 0.0
    << out
}

pub fn patch_outline(styles &Styles) ControlStylePatch {
    p := styles.button.palette
    $out := control_style_patch()
    out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED |
        STYLE_PATCH_FOREGROUND | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH
    out.normal = draw.rgba(0,0,0,0)
    out.hovered = p.hovered.with_alpha(150)
    out.pressed = p.pressed.with_alpha(210)
    out.foreground = p.foreground
    out.border = p.border
    out.border_width = 1.0
    << out
}

pub fn patch_semantic_tone(styles &Styles,tone draw.Color,on_tone draw.Color,solid bool) ControlStylePatch {
    light_mode := token_color_luma(styles.background) > 128.0
    $out := control_style_patch()
    if solid {
        $hov := token_mix_rgb(tone,draw.rgb(255,255,255),0.14)
        $prs := token_mix_rgb(tone,draw.rgb(0,0,0),0.18)
        if light_mode {
            hov = token_mix_rgb(tone,draw.rgb(0,0,0),0.10)
            prs = token_mix_rgb(tone,draw.rgb(0,0,0),0.22)
        }
        out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED |
            STYLE_PATCH_FOREGROUND | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH
        out.normal = tone
        out.hovered = hov
        out.pressed = prs
        out.foreground = on_tone
        out.border = tone
        out.border_width = 1.0
        << out
    }
    base_bg := styles.button.palette.normal
    $norm := token_mix_rgb(base_bg,tone,0.14)
    $hov := token_mix_rgb(base_bg,tone,0.22)
    $prs := token_mix_rgb(base_bg,tone,0.30)
    out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED |
        STYLE_PATCH_FOREGROUND | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH
    out.normal = norm
    out.hovered = hov
    out.pressed = prs
    out.foreground = tone
    out.border = tone.with_alpha(170)
    out.border_width = 1.0
    << out
}

pub fn patch_danger(styles &Styles) ControlStylePatch {
    p := styles.button.palette
    light_mode := token_color_luma(styles.background) > 128.0
    $on_danger := draw.rgb(255,248,250)
    if !light_mode { on_danger = draw.rgb(25,12,18) }
    << patch_semantic_tone(styles,p.invalid,on_danger,true)
}

pub fn patch_subtle_danger(styles &Styles) ControlStylePatch {
    p := styles.button.palette
    $out := control_style_patch()
    out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED |
        STYLE_PATCH_FOREGROUND | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH
    out.normal = p.invalid_fill
    out.hovered = token_mix_rgb(p.invalid_fill,p.invalid,0.16)
    out.pressed = token_mix_rgb(p.invalid_fill,p.invalid,0.28)
    out.foreground = p.invalid
    out.border = p.invalid.with_alpha(180)
    out.border_width = 1.0
    << out
}

pub fn patch_pill() ControlStylePatch {
    $out := control_style_patch()
    out.fields = STYLE_PATCH_RADIUS
    out.radius = 999.0
    << out
}

pub fn patch_elevation(level int) ControlStylePatch {
    $lv := level
    if lv < 0 { lv = 0 }
    if lv > 3 { lv = 3 }
    $out := control_style_patch()
    out.fields = STYLE_PATCH_SHADOW
    if lv == 0 {
        out.shadow = draw.rgba(0,0,0,0)
        << out
    }
    if lv == 1 {
        out.shadow = draw.rgba(0,0,0,40)
        out.shadow_y = 2.0
        out.shadow_blur = 6.0
        << out
    }
    if lv == 2 {
        out.shadow = draw.rgba(0,0,0,64)
        out.shadow_y = 6.0
        out.shadow_blur = 14.0
        out.shadow_spread = 1.0
        << out
    }
    out.shadow = draw.rgba(0,0,0,92)
    out.shadow_y = 12.0
    out.shadow_blur = 24.0
    out.shadow_spread = 2.0
    << out
}

pub fn patch_surface(styles &Styles,elevation int) ControlStylePatch {
    $lv := elevation
    if lv < 0 { lv = 0 }
    if lv > 3 { lv = 3 }
    light_mode := token_color_luma(styles.background) > 128.0
    $surf := styles.button.palette.normal
    if lv > 0 {
        step := f64(lv) * 0.06
        if light_mode {
            surf = token_mix_rgb(surf,draw.rgb(255,255,255),step * 1.4)
        } else {
            surf = token_mix_rgb(surf,draw.rgb(255,255,255),step)
        }
    }
    $out := control_style_patch()
    out.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH |
        STYLE_PATCH_RADIUS | STYLE_PATCH_PADDING
    out.normal = surf
    out.border = styles.button.palette.border.with_alpha(90 + lv * 25)
    out.border_width = 1.0
    out.radius = 10.0 + f64(lv) * 2.0
    pad := 12.0 + f64(lv) * 2.0
    out.padding = layout.Insets{left: pad,top: pad,right: pad,bottom: pad}
    if lv > 0 {
        elev := patch_elevation(lv)
        << out.merge(&elev)
    }
    << out
}

pub fn scope_compact() StyleDelta {
    $sc := style_delta()
    sc.fields = SCOPE_DENSITY_SCALE | SCOPE_TEXT_SCALE_MULT | SCOPE_RADIUS_SCALE | SCOPE_PADDING_SCALE
    sc.density_scale = 0.85
    sc.text_scale_mult = 0.94
    sc.radius_scale = 0.85
    sc.padding_scale = 0.85
    << sc
}

pub fn scope_comfortable() StyleDelta {
    $sc := style_delta()
    sc.fields = SCOPE_DENSITY_SCALE | SCOPE_TEXT_SCALE_MULT | SCOPE_RADIUS_SCALE | SCOPE_PADDING_SCALE
    sc.density_scale = 1.0
    sc.text_scale_mult = 1.0
    sc.radius_scale = 1.0
    sc.padding_scale = 1.0
    << sc
}

pub fn scope_spacious() StyleDelta {
    $sc := style_delta()
    sc.fields = SCOPE_DENSITY_SCALE | SCOPE_TEXT_SCALE_MULT | SCOPE_RADIUS_SCALE | SCOPE_PADDING_SCALE
    sc.density_scale = 1.15
    sc.text_scale_mult = 1.06
    sc.radius_scale = 1.15
    sc.padding_scale = 1.2
    << sc
}

pub fn scope_accent(accent draw.Color,on_accent draw.Color) StyleDelta {
    $sc := style_delta()
    sc.fields = SCOPE_PALETTE
    sc.palette.fields = STYLE_PATCH_ACCENT | STYLE_PATCH_ON_ACCENT | STYLE_PATCH_SELECTION
    sc.palette.accent = accent
    sc.palette.on_accent = on_accent
    sc.palette.selection = accent
    sc.palette.selection_text = on_accent
    << sc
}

pub fn scope_muted_panel(styles &Styles) StyleDelta {
    p := styles.button.palette
    light_mode := token_color_luma(styles.background) > 128.0
    $bg := token_mix_rgb(styles.background,draw.rgb(255,255,255),0.04)
    if light_mode { bg = token_mix_rgb(styles.background,draw.rgb(0,0,0),0.04) }
    $sc := style_delta()
    sc.fields = SCOPE_BACKGROUND | SCOPE_PALETTE
    sc.background = bg
    sc.palette.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_BORDER | STYLE_PATCH_FOREGROUND
    sc.palette.normal = p.normal
    sc.palette.border = p.border.with_alpha(120)
    sc.palette.foreground = p.muted
    << sc
}

pub fn scope_typography(size_delta f64,weight int,italic bool,line_height f64) StyleDelta {
    $sc := style_delta()
    $f := 0
    if size_delta != 0.0 {
        f = f | SCOPE_FONT_SIZE_DELTA
        sc.font_size_delta = size_delta
    }
    if weight >= 100 && weight <= 900 {
        f = f | SCOPE_FONT_WEIGHT
        sc.font_weight = weight
    }
    if italic {
        f = f | SCOPE_FONT_ITALIC
        sc.font_italic = true
    }
    if line_height > 0.0 {
        f = f | SCOPE_LINE_HEIGHT
        sc.line_height = line_height
    }
    sc.fields = f
    << sc
}

pub fn motion_snappy() MotionSpec {
    << MotionSpec{
        hover: time.duration(90 * time.millisecond()),
        press: time.duration(50 * time.millisecond()),
        change: time.duration(140 * time.millisecond()),
        enter: time.duration(140 * time.millisecond()),
        exit: time.duration(90 * time.millisecond()),
        curve: EASE_OUT_CUBIC
    }
}

pub fn motion_gentle() MotionSpec {
    << MotionSpec{
        hover: time.duration(180 * time.millisecond()),
        press: time.duration(100 * time.millisecond()),
        change: time.duration(260 * time.millisecond()),
        enter: time.duration(260 * time.millisecond()),
        exit: time.duration(180 * time.millisecond()),
        curve: EASE_OUT_QUINT
    }
}

pub fn motion_expressive() MotionSpec {
    << MotionSpec{
        hover: time.duration(140 * time.millisecond()),
        press: time.duration(75 * time.millisecond()),
        change: time.duration(280 * time.millisecond()),
        enter: time.duration(300 * time.millisecond()),
        exit: time.duration(160 * time.millisecond()),
        curve: EASE_OUT_BACK
    }
}

pub fn motion_instant() MotionSpec {
    z := time.duration(0)
    << MotionSpec{hover: z,press: z,change: z,enter: z,exit: z,curve: EASE_LINEAR}
}

pub fn spring_snappy() SpringSpec {
    << SpringSpec{stiffness: 420.0,damping: 32.0,mass: 1.0,precision: 0.001}
}

pub fn spring_gentle() SpringSpec {
    << SpringSpec{stiffness: 180.0,damping: 22.0,mass: 1.0,precision: 0.001}
}

pub fn spring_bouncy() SpringSpec {
    << SpringSpec{stiffness: 300.0,damping: 16.0,mass: 1.0,precision: 0.001}
}

pub fn spring_stiff() SpringSpec {
    << SpringSpec{stiffness: 620.0,damping: 42.0,mass: 1.0,precision: 0.001}
}
