@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

pub struct Switch {
    control Button
    checked bool
    custom ScalarControlStyle
}
pub fn switch_control(identity &ui.CanvasEvent,id int,bounds &layout.Rect,checked bool) Switch {
    control := button(identity,id,bounds) or >>
    << Switch{control: control,checked: checked,custom: empty_scalar_style()}
}
pub fn (sw &Switch) id() int { << sw.control.id }
pub fn (sw &Switch) bounds() layout.Rect { << sw.control.bounds() }
pub fn (sw &Switch) needs_paint() bool { << sw.control.needs_paint() }
pub fn (sw &mut Switch) painted() {
    control := mut &sw.control
    control.painted()
}
pub fn (sw &mut Switch) invalidate() {
    control := mut &sw.control
    control.invalidate()
}
pub fn (sw &mut Switch) cancel() {
    control := mut &sw.control
    control.cancel()
}
pub fn (sw &Switch) is_enabled() bool { << sw.control.is_enabled() }
pub fn (sw &mut Switch) set_enabled(enabled bool) {
    control := mut &sw.control
    control.set_enabled(enabled)
}
pub fn (sw &Switch) is_focused() bool { << sw.control.is_focused() }
pub fn (sw &mut Switch) set_focus(focused bool) {
    control := mut &sw.control
    control.set_focus(focused)
}
pub fn (sw &Switch) is_hovered() bool { << sw.control.is_hovered() }
pub fn (sw &Switch) is_pressed() bool { << sw.control.is_pressed() }
pub fn (sw &Switch) is_invalid() bool { << sw.control.is_invalid() }
pub fn (sw &mut Switch) set_invalid(invalid bool) {
    control := mut &sw.control
    control.set_invalid(invalid)
}
pub fn (sw &Switch) is_read_only() bool { << sw.control.is_read_only() }
pub fn (sw &mut Switch) set_read_only(read_only bool) {
    control := mut &sw.control
    control.set_read_only(read_only)
}
pub fn (sw &mut Switch) set_bounds(bounds &layout.Rect) int {
    control := mut &sw.control
    << control.set_bounds(bounds) or >>
}
pub fn (sw &Switch) value() bool { << sw.checked }
pub fn (sw &mut Switch) set_value(checked bool) {
    if sw.checked != checked {
        sw.checked = checked
        control := mut &sw.control
        control.invalidate()
    }
}
pub fn (sw &Switch) visual_state() int {
    mut state := sw.control.visual_state()
    if sw.checked { state = state | state_selected }
    << state
}
pub fn (sw &Switch) has_style() bool { << sw.custom.active }
pub fn (sw &Switch) style_or(styles &Styles) ControlStyle {
    if sw.custom.active { << unpack_scalar_style(&sw.custom) }
    << styles.switch_style()
}
pub fn (sw &mut Switch) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !sw.custom.active || !control_equal(&unpack_scalar_style(&sw.custom),&next) {
        control := mut &sw.control
        control.invalidate()
    }
    sw.custom = pack_scalar_style(style)
    << 0
}
pub fn (sw &mut Switch) clear_style() {
    if sw.custom.active {
        sw.custom.active = false
        control := mut &sw.control
        control.invalidate()
    }
}
pub fn (sw &mut Switch) input(input &ui.InputEvent) Action {
    control := mut &sw.control
    mut action := control.input(input)
    if action.kind == action_activate {
        sw.checked = !sw.checked
        control := mut &sw.control
        control.invalidate()
        action.kind = action_change
        action.value = 0.0
        if sw.checked { action.value = 1.0 }
    }
    << action
}
pub fn (sw &mut Switch) event(event &ui.Event) Action {
    control := mut &sw.control
    mut action := control.event(event) or >>
    if action.kind == action_activate {
        sw.checked = !sw.checked
        control := mut &sw.control
        control.invalidate()
        action.kind = action_change
        action.value = 0.0
        if sw.checked { action.value = 1.0 }
    }
    << action
}
pub fn (sw &Switch) paint(frame &mut draw.Frame,label &draw.TextLayout,theme &Theme) int {
    bounds := copy_rect(&sw.control.bounds)
    track_h := math.min(20.0,bounds.height)
    track_w := math.min(36.0,bounds.width)
    x := bounds.x
    y := bounds.y + (bounds.height - track_h) * 0.5
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    mut fill := sw.control.fill(theme)
    if sw.checked && sw.control.is_enabled() { fill = theme.accent }
    track := layout.Rect{x: x,y: y,width: track_w,height: track_h}
    rounded_fill(frame,&track,track_h * 0.5,fill) or >>
    mut foreground := theme.foreground
    if !sw.control.is_enabled() { foreground = theme.muted }
    inset := 3.0
    thumb_d := math.max(4.0,track_h - inset * 2.0)
    mut thumb_x := x + inset
    if sw.checked { thumb_x = x + track_w - inset - thumb_d }
    thumb := layout.Rect{x: thumb_x,y: y + (track_h - thumb_d) * 0.5,width: thumb_d,height: thumb_d}
    rounded_fill(frame,&thumb,thumb_d * 0.5,foreground) or >>
    frame.text_layout(label,x + track_w + 8.0,bounds.y + (bounds.height - label.metrics.height) * 0.5,foreground) or >>
    if sw.control.focused { focus_ring(frame,&bounds,theme.focus) or >> }
    frame.pop() or >>
    << 0
}
pub fn (sw &Switch) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := sw.style_or(styles)
    size := label.measure_styled(styles,&c) or >>
    d := styles.density
    track_h := c.indicator_size * d
    track_w := track_h * 1.8
    mut text_w := size.width
    mut text_h := size.height
    mut gap := c.gap * d
    if track_h <= 0.0 { gap = 0.0 }
    if label.value.len == 0 {
        text_w = 0.0
        text_h = 0.0
        gap = 0.0
    }
    mut width := track_w + gap + text_w
    mut height := math.max(track_h,text_h)
    if c.icon_placement == icon_above || c.icon_placement == icon_below {
        width = math.max(track_w,text_w)
        height = track_h + gap + text_h
    }
    << layout.Size{width: math.max(c.min_width * d,width + (c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,height + (c.padding.top + c.padding.bottom) * d)}
}
pub fn (sw &Switch) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    c := sw.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    bounds := sw.control.bounds
    state := sw.visual_state()
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    avail_w := math.max(0.0,bounds.width - left - c.padding.right * d)
    avail_h := math.max(0.0,bounds.height - top - c.padding.bottom * d)
    track_h := math.max(0.0,math.min(c.indicator_size * d,avail_h))
    track_w := math.max(track_h,math.min(track_h * 1.8,avail_w))
    shaped := label.layouts[0]
    mut text_w := shaped.metrics.width
    mut text_h := shaped.metrics.height
    mut gap := c.gap * d
    if track_h <= 0.0 { gap = 0.0 }
    if label.value.len == 0 {
        text_w = 0.0
        text_h = 0.0
        gap = 0.0
    }
    mut content_w := track_w + gap + text_w
    mut content_h := math.max(track_h,text_h)
    if c.icon_placement == icon_above || c.icon_placement == icon_below {
        content_w = math.max(track_w,text_w)
        content_h = track_h + gap + text_h
    }
    x := bounds.x + left + (avail_w - content_w) * c.align_x
    y := bounds.y + top + (avail_h - content_h) * c.align_y
    mut bx := x
    mut by := y + (content_h - track_h) * 0.5
    mut tx := x + track_w + gap
    mut ty := y + (content_h - text_h) * 0.5
    if c.icon_placement == icon_trailing {
        tx = x
        bx = x + text_w + gap
    }
    if c.icon_placement == icon_above {
        bx = x + (content_w - track_w) * c.align_x
        by = y
        tx = x + (content_w - text_w) * c.align_x
        ty = y + track_h + gap
    }
    if c.icon_placement == icon_below {
        tx = x + (content_w - text_w) * c.align_x
        ty = y
        bx = x + (content_w - track_w) * c.align_x
        by = y + text_h + gap
    }
    track := layout.Rect{x: bx,y: by,width: track_w,height: track_h}
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    style_box(frame,&track,&c,d,state) or >>
    inset := math.max(2.0,c.mark_width * d)
    thumb_d := math.max(2.0,track_h - inset * 2.0)
    mut thumb_x := track.x + inset
    if sw.checked { thumb_x = math.max(track.x + inset,track.x + track.width - inset - thumb_d) }
    thumb := layout.Rect{x: thumb_x,y: track.y + (track.height - thumb_d) * 0.5,width: thumb_d,height: thumb_d}
    rounded_fill(frame,&thumb,thumb_d * 0.5,c.resolve(state).foreground) or >>
    if label.value.len > 0 {
        mut text_style := c.clone()
        text_style.palette.on_accent = c.palette.foreground
        frame.text_layout(&shaped,tx,ty,text_style.resolve(state).foreground) or >>
    }
    frame.pop() or >>
    << 0
}

pub struct Radio {
    control Button
    option_val int
    checked bool
    custom ScalarControlStyle
}
pub fn radio(identity &ui.CanvasEvent,id int,bounds &layout.Rect,option_value int,selected bool) Radio {
    control := button(identity,id,bounds) or >>
    << Radio{control: control,option_val: option_value,checked: selected,custom: empty_scalar_style()}
}
pub fn (r &Radio) id() int { << r.control.id }
pub fn (r &Radio) bounds() layout.Rect { << r.control.bounds() }
pub fn (r &Radio) option() int { << r.option_val }
pub fn (r &Radio) value() bool { << r.checked }
pub fn (r &mut Radio) set_value(selected bool) {
    if r.checked != selected {
        r.checked = selected
        control := mut &r.control
        control.invalidate()
    }
}
pub fn (r &Radio) needs_paint() bool { << r.control.needs_paint() }
pub fn (r &mut Radio) painted() {
    control := mut &r.control
    control.painted()
}
pub fn (r &mut Radio) invalidate() {
    control := mut &r.control
    control.invalidate()
}
pub fn (r &mut Radio) cancel() {
    control := mut &r.control
    control.cancel()
}
pub fn (r &Radio) is_enabled() bool { << r.control.is_enabled() }
pub fn (r &mut Radio) set_enabled(enabled bool) {
    control := mut &r.control
    control.set_enabled(enabled)
}
pub fn (r &Radio) is_focused() bool { << r.control.is_focused() }
pub fn (r &mut Radio) set_focus(focused bool) {
    control := mut &r.control
    control.set_focus(focused)
}
pub fn (r &Radio) is_hovered() bool { << r.control.is_hovered() }
pub fn (r &Radio) is_pressed() bool { << r.control.is_pressed() }
pub fn (r &Radio) is_invalid() bool { << r.control.is_invalid() }
pub fn (r &mut Radio) set_invalid(invalid bool) {
    control := mut &r.control
    control.set_invalid(invalid)
}
pub fn (r &Radio) is_read_only() bool { << r.control.is_read_only() }
pub fn (r &mut Radio) set_read_only(read_only bool) {
    control := mut &r.control
    control.set_read_only(read_only)
}
pub fn (r &mut Radio) set_bounds(bounds &layout.Rect) int {
    control := mut &r.control
    << control.set_bounds(bounds) or >>
}
pub fn (r &Radio) visual_state() int {
    mut state := r.control.visual_state()
    if r.checked { state = state | state_selected }
    << state
}
pub fn (r &Radio) has_style() bool { << r.custom.active }
pub fn (r &Radio) style_or(styles &Styles) ControlStyle {
    if r.custom.active { << unpack_scalar_style(&r.custom) }
    << styles.radio_style()
}
pub fn (r &mut Radio) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !r.custom.active || !control_equal(&unpack_scalar_style(&r.custom),&next) {
        control := mut &r.control
        control.invalidate()
    }
    r.custom = pack_scalar_style(style)
    << 0
}
pub fn (r &mut Radio) clear_style() {
    if r.custom.active {
        r.custom.active = false
        control := mut &r.control
        control.invalidate()
    }
}
pub fn (r &mut Radio) input(input &ui.InputEvent) Action {
    control := mut &r.control
    mut action := control.input(input)
    if action.kind == action_activate {
        if !r.checked {
            r.checked = true
            control := mut &r.control
            control.invalidate()
            action.kind = action_change
            action.value = f64(r.option_val)
        } else {
            action.kind = action_none
        }
    }
    << action
}
pub fn (r &mut Radio) event(event &ui.Event) Action {
    control := mut &r.control
    mut action := control.event(event) or >>
    if action.kind == action_activate {
        if !r.checked {
            r.checked = true
            control := mut &r.control
            control.invalidate()
            action.kind = action_change
            action.value = f64(r.option_val)
        } else {
            action.kind = action_none
        }
    }
    << action
}
pub fn (r &Radio) paint(frame &mut draw.Frame,label &draw.TextLayout,theme &Theme) int {
    bounds := copy_rect(&r.control.bounds)
    side := math.min(20.0,math.min(bounds.width,bounds.height))
    x := bounds.x
    y := bounds.y + (bounds.height - side) * 0.5
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    mut fill := r.control.fill(theme)
    if r.checked && r.control.is_enabled() { fill = theme.accent }
    box := layout.Rect{x: x,y: y,width: side,height: side}
    rounded_fill(frame,&box,side * 0.5,fill) or >>
    mut foreground := theme.foreground
    if !r.control.is_enabled() { foreground = theme.muted }
    if r.checked && side >= 6.0 {
        dot := side * 0.45
        inner := layout.Rect{x: x + (side - dot) * 0.5,y: y + (side - dot) * 0.5,width: dot,height: dot}
        rounded_fill(frame,&inner,dot * 0.5,foreground) or >>
    }
    frame.text_layout(label,x + side + 8.0,bounds.y + (bounds.height - label.metrics.height) * 0.5,foreground) or >>
    if r.control.focused { focus_ring(frame,&bounds,theme.focus) or >> }
    frame.pop() or >>
    << 0
}
pub fn (r &Radio) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := r.style_or(styles)
    size := label.measure_styled(styles,&c) or >>
    d := styles.density
    indicator := c.indicator_size * d
    mut text_w := size.width
    mut text_h := size.height
    mut gap := c.gap * d
    if indicator <= 0.0 { gap = 0.0 }
    if label.value.len == 0 {
        text_w = 0.0
        text_h = 0.0
        gap = 0.0
    }
    mut width := indicator + gap + text_w
    mut height := math.max(indicator,text_h)
    if c.icon_placement == icon_above || c.icon_placement == icon_below {
        width = math.max(indicator,text_w)
        height = indicator + gap + text_h
    }
    << layout.Size{width: math.max(c.min_width * d,width + (c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,height + (c.padding.top + c.padding.bottom) * d)}
}
pub fn (r &Radio) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    mut c := r.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    bounds := r.control.bounds
    state := r.visual_state()
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    avail_w := math.max(0.0,bounds.width - left - c.padding.right * d)
    avail_h := math.max(0.0,bounds.height - top - c.padding.bottom * d)
    side := math.max(0.0,math.min(c.indicator_size * d,math.min(avail_w,avail_h)))
    shaped := label.layouts[0]
    mut text_w := shaped.metrics.width
    mut text_h := shaped.metrics.height
    mut gap := c.gap * d
    if side <= 0.0 { gap = 0.0 }
    if label.value.len == 0 {
        text_w = 0.0
        text_h = 0.0
        gap = 0.0
    }
    mut content_w := side + gap + text_w
    mut content_h := math.max(side,text_h)
    if c.icon_placement == icon_above || c.icon_placement == icon_below {
        content_w = math.max(side,text_w)
        content_h = side + gap + text_h
    }
    x := bounds.x + left + (avail_w - content_w) * c.align_x
    y := bounds.y + top + (avail_h - content_h) * c.align_y
    mut bx := x
    mut by := y + (content_h - side) * 0.5
    mut tx := x + side + gap
    mut ty := y + (content_h - text_h) * 0.5
    if c.icon_placement == icon_trailing {
        tx = x
        bx = x + text_w + gap
    }
    if c.icon_placement == icon_above {
        bx = x + (content_w - side) * c.align_x
        by = y
        tx = x + (content_w - text_w) * c.align_x
        ty = y + side + gap
    }
    if c.icon_placement == icon_below {
        tx = x + (content_w - text_w) * c.align_x
        ty = y
        bx = x + (content_w - side) * c.align_x
        by = y + text_h + gap
    }
    box := layout.Rect{x: bx,y: by,width: side,height: side}
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    style_box(frame,&box,&c,d,state) or >>
    if r.checked && side >= 4.0 {
        dot := math.max(2.0,side * 0.45)
        inner := layout.Rect{x: box.x + (side - dot) * 0.5,y: box.y + (side - dot) * 0.5,width: dot,height: dot}
        rounded_fill(frame,&inner,dot * 0.5,c.resolve(state).foreground) or >>
    }
    if label.value.len > 0 {
        mut text_style := c.clone()
        text_style.palette.on_accent = c.palette.foreground
        frame.text_layout(&shaped,tx,ty,text_style.resolve(state).foreground) or >>
    }
    frame.pop() or >>
    << 0
}

pub struct Slider {
    id int
    identity ui.CanvasEvent
    bounds layout.Rect
    min_val f64
    max_val f64
    step_val f64
    val f64
    enabled bool
    focused bool
    hovered bool
    dragging bool
    dirty bool
    closed bool
    invalid bool
    read_only bool
    custom ScalarControlStyle
}
fn clamp_slider_value(min_val f64,max_val f64,step_val f64,raw f64) f64 {
    mut v := math.max(min_val,math.min(max_val,raw))
    if step_val > 0.0 && max_val > min_val {
        steps := math.round((v - min_val) / step_val)
        v = math.max(min_val,math.min(max_val,min_val + steps * step_val))
    }
    << v
}
pub fn slider(identity &ui.CanvasEvent,id int,bounds &layout.Rect,min f64,max f64,value f64) Slider {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid control identity") }
    validate_bounds(bounds) or >>
    if math.is_nan(min) || math.is_inf(min) || math.is_nan(max) || math.is_inf(max) || max <= min || math.is_nan(value) || math.is_inf(value) {
        >> errors.new("widgets: invalid slider range")
    }
    << Slider{id: id,identity: copy_identity(identity),bounds: copy_rect(bounds),min_val: min,max_val: max,step_val: 0.0,
        val: clamp_slider_value(min,max,0.0,value),enabled: true,focused: false,hovered: false,dragging: false,
        dirty: true,closed: false,invalid: false,read_only: false,custom: empty_scalar_style()}
}
pub fn (s &Slider) id() int { << s.id }
pub fn (s &Slider) bounds() layout.Rect { << copy_rect(&s.bounds) }
pub fn (s &Slider) value() f64 { << s.val }
pub fn (s &Slider) min() f64 { << s.min_val }
pub fn (s &Slider) max() f64 { << s.max_val }
pub fn (s &Slider) step() f64 { << s.step_val }
pub fn (s &Slider) ratio() f64 {
    if s.max_val <= s.min_val { << 0.0 }
    << math.max(0.0,math.min(1.0,(s.val - s.min_val) / (s.max_val - s.min_val)))
}
pub fn (s &Slider) needs_paint() bool { << s.dirty }
pub fn (s &mut Slider) painted() { s.dirty = false }
pub fn (s &mut Slider) invalidate() { s.dirty = true }
pub fn (s &mut Slider) cancel() {
    if s.dragging || s.hovered || s.focused { s.dirty = true }
    s.dragging = false
    s.hovered = false
    s.focused = false
}
pub fn (s &Slider) is_enabled() bool { << s.enabled && !s.closed && s.bounds.width > 0.0 && s.bounds.height > 0.0 }
pub fn (s &mut Slider) set_enabled(enabled bool) {
    if s.enabled != enabled { s.dirty = true }
    s.enabled = enabled
    if !enabled { s.cancel() }
}
pub fn (s &Slider) is_focused() bool { << s.focused }
pub fn (s &mut Slider) set_focus(focused bool) {
    next := focused && s.is_enabled()
    if s.focused != next { s.dirty = true }
    s.focused = next
    if !next && s.dragging {
        s.dragging = false
        s.dirty = true
    }
}
pub fn (s &Slider) is_hovered() bool { << s.hovered }
pub fn (s &Slider) is_dragging() bool { << s.dragging }
pub fn (s &Slider) is_invalid() bool { << s.invalid }
pub fn (s &mut Slider) set_invalid(invalid bool) {
    if s.invalid != invalid {
        s.invalid = invalid
        s.dirty = true
    }
}
pub fn (s &Slider) is_read_only() bool { << s.read_only }
pub fn (s &mut Slider) set_read_only(read_only bool) {
    if s.read_only != read_only {
        s.read_only = read_only
        s.dragging = false
        s.dirty = true
    }
}
pub fn (s &mut Slider) set_value(value f64) int {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid slider value") }
    next := clamp_slider_value(s.min_val,s.max_val,s.step_val,value)
    if next != s.val {
        s.val = next
        s.dirty = true
    }
    << 0
}
pub fn (s &mut Slider) set_range(min f64,max f64) int {
    if math.is_nan(min) || math.is_inf(min) || math.is_nan(max) || math.is_inf(max) || max <= min {
        >> errors.new("widgets: invalid slider range")
    }
    s.min_val = min
    s.max_val = max
    next := clamp_slider_value(s.min_val,s.max_val,s.step_val,s.val)
    if next != s.val { s.val = next }
    s.dirty = true
    << 0
}
pub fn (s &mut Slider) set_step(step f64) int {
    if math.is_nan(step) || math.is_inf(step) || step < 0.0 || step > (s.max_val - s.min_val) {
        >> errors.new("widgets: invalid slider step")
    }
    s.step_val = step
    next := clamp_slider_value(s.min_val,s.max_val,s.step_val,s.val)
    if next != s.val { s.val = next }
    s.dirty = true
    << 0
}
pub fn (s &mut Slider) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if s.bounds.x != bounds.x || s.bounds.y != bounds.y || s.bounds.width != bounds.width || s.bounds.height != bounds.height {
        s.bounds = copy_rect(bounds)
        if bounds.width == 0.0 || bounds.height == 0.0 { s.cancel() }
        s.dragging = false
        s.hovered = false
        s.dirty = true
    }
    << 0
}
pub fn (s &Slider) visual_state() int {
    mut state := 0
    if s.invalid { state = state | state_invalid }
    if s.read_only { state = state | state_read_only }
    if !s.is_enabled() { state = state | state_disabled }
    if s.hovered || s.dragging { state = state | state_hovered }
    if !s.read_only && s.dragging { state = state | state_pressed }
    if s.focused { state = state | state_focused }
    << state
}
pub fn (s &Slider) has_style() bool { << s.custom.active }
pub fn (s &Slider) style_or(styles &Styles) ControlStyle {
    if s.custom.active { << unpack_scalar_style(&s.custom) }
    << styles.slider_style()
}
pub fn (s &mut Slider) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !s.custom.active || !control_equal(&unpack_scalar_style(&s.custom),&next) { s.dirty = true }
    s.custom = pack_scalar_style(style)
    << 0
}
pub fn (s &mut Slider) clear_style() {
    if s.custom.active {
        s.custom.active = false
        s.dirty = true
    }
}
fn (s &Slider) value_at_x(x f64) f64 {
    thumb := math.min(18.0,math.min(s.bounds.width,s.bounds.height))
    usable := math.max(1.0,s.bounds.width - thumb)
    ratio := math.max(0.0,math.min(1.0,(x - (s.bounds.x + thumb * 0.5)) / usable))
    raw := s.min_val + ratio * (s.max_val - s.min_val)
    << clamp_slider_value(s.min_val,s.max_val,s.step_val,raw)
}
pub fn (s &mut Slider) input(input &ui.InputEvent) Action {
    if !belongs(&s.identity,input) || s.closed { << no_action(s.id,s.dirty) }
    if input.kind == ui.ev_pointer_cancel {
        s.cancel()
        << no_action(s.id,s.dirty)
    }
    if !s.is_enabled() { << no_action(s.id,s.dirty) }
    inside := s.bounds.contains(input.x,input.y)
    mut changed := false
    mut focus := false
    mut consumed := false
    if input.kind == ui.ev_pointer_move || input.kind == ui.ev_pointer_enter || input.kind == ui.ev_pointer_leave {
        hot := inside && input.kind != ui.ev_pointer_leave
        if hot != s.hovered {
            s.hovered = hot
            s.dirty = true
        }
        if s.dragging && !s.read_only {
            next := s.value_at_x(input.x)
            if next != s.val {
                s.val = next
                s.dirty = true
                changed = true
            }
            consumed = true
        }
    } else if input.kind == ui.ev_pointer_down && input.button == ui.button_left && inside {
        s.hovered = true
        s.dirty = true
        focus = true
        consumed = true
        if !s.read_only {
            s.dragging = true
            next := s.value_at_x(input.x)
            if next != s.val {
                s.val = next
                changed = true
            }
        }
    } else if input.kind == ui.ev_pointer_up && input.button == ui.button_left {
        if s.dragging {
            consumed = true
            s.dragging = false
            s.dirty = true
        }
        if s.hovered != inside { s.dirty = true }
        s.hovered = inside
    } else if input.kind == ui.ev_key_down && s.focused && !s.read_only {
        mut delta := s.step_val
        if delta <= 0.0 { delta = (s.max_val - s.min_val) * 0.05 }
        mut candidate := s.val
        mut handled := false
        if input.key == ui.key_left || input.key == ui.key_down {
            candidate = s.val - delta
            handled = true
        } else if input.key == ui.key_right || input.key == ui.key_up {
            candidate = s.val + delta
            handled = true
        } else if input.key == ui.key_page_down {
            candidate = s.val - delta * 5.0
            handled = true
        } else if input.key == ui.key_page_up {
            candidate = s.val + delta * 5.0
            handled = true
        } else if input.key == ui.key_home {
            candidate = s.min_val
            handled = true
        } else if input.key == ui.key_end {
            candidate = s.max_val
            handled = true
        }
        if handled {
            consumed = true
            next := clamp_slider_value(s.min_val,s.max_val,s.step_val,candidate)
            if next != s.val {
                s.val = next
                s.dirty = true
                changed = true
            }
        }
    }
    mut kind := action_none
    if changed { kind = action_change }
    << Action{kind: kind,id: s.id,needs_paint: s.dirty,request_focus: focus,consumed: consumed,value: s.val}
}
pub fn (s &mut Slider) event(event &ui.Event) Action {
    if event.window_id != s.identity.window_id { << no_action(s.id,s.dirty) }
    if event.kind == ui.ev_closed || event.kind == ui.ev_blurred {
        s.cancel()
        if event.kind == ui.ev_closed { s.closed = true }
        << no_action(s.id,s.dirty)
    }
    if event.kind == ui.ev_canvas_closed {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == s.identity.canvas_id && identity.generation == s.identity.generation {
            s.cancel()
            s.closed = true
        }
        << no_action(s.id,s.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(s.id,s.dirty) }
    input := ui.input_of(event) or >>
    << s.input(&input)
}
pub fn (s &Slider) paint(frame &mut draw.Frame,theme &Theme) int {
    b := s.bounds
    thumb := math.min(16.0,math.min(b.width,b.height))
    track_h := math.min(6.0,b.height)
    track_y := b.y + (b.height - track_h) * 0.5
    track := layout.Rect{x: b.x,y: track_y,width: b.width,height: track_h}
    rounded_fill(frame,&track,track_h * 0.5,theme.normal) or >>
    usable := math.max(0.0,b.width - thumb)
    cx := b.x + thumb * 0.5 + usable * s.ratio()
    active := layout.Rect{x: b.x,y: track_y,width: math.max(0.0,cx - b.x),height: track_h}
    rounded_fill(frame,&active,track_h * 0.5,theme.accent) or >>
    knob := layout.Rect{x: cx - thumb * 0.5,y: b.y + (b.height - thumb) * 0.5,width: thumb,height: thumb}
    rounded_fill(frame,&knob,thumb * 0.5,theme.foreground) or >>
    if s.focused { focus_ring(frame,&b,theme.focus) or >> }
    << 0
}
pub fn (s &Slider) measure_styled(styles &Styles) layout.Size {
    c := s.style_or(styles)
    d := styles.density
    thumb := c.indicator_size * d
    track_h := c.mark_width * d
    h := math.max(thumb,track_h) + (c.padding.top + c.padding.bottom) * d
    w := thumb * 3.0 + (c.padding.left + c.padding.right) * d
    << layout.Size{width: math.max(c.min_width * d,w),height: math.max(c.min_height * d,h)}
}
pub fn (s &Slider) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    c := s.style_or(styles)
    b := s.bounds
    d := styles.density
    state := s.visual_state()
    resolved := c.resolve(state)
    left := c.padding.left * d
    top := c.padding.top * d
    inner_w := math.max(0.0,b.width - left - c.padding.right * d)
    inner_h := math.max(0.0,b.height - top - c.padding.bottom * d)
    thumb := math.max(4.0,math.min(c.indicator_size * d,math.min(inner_w,inner_h)))
    track_h := math.max(2.0,math.min(c.mark_width * d,inner_h))
    track_y := b.y + top + (inner_h - track_h) * 0.5
    track := layout.Rect{x: b.x + left,y: track_y,width: inner_w,height: track_h}
    track_r := math.min(c.radius * d,track_h * 0.5)
    rounded_fill(frame,&track,track_r,resolved.background) or >>
    rounded_stroke(frame,&track,track_r,resolved.border,c.border_width * d) or >>
    usable := math.max(0.0,inner_w - thumb)
    cx := track.x + thumb * 0.5 + usable * s.ratio()
    mut fill_color := c.palette.accent
    if s.invalid { fill_color = c.palette.invalid }
    if !s.is_enabled() { fill_color = c.palette.muted }
    active := layout.Rect{x: track.x,y: track_y,width: math.max(0.0,cx - track.x),height: track_h}
    rounded_fill(frame,&active,track_r,fill_color) or >>
    knob := layout.Rect{x: cx - thumb * 0.5,y: b.y + top + (inner_h - thumb) * 0.5,width: thumb,height: thumb}
    mut knob_style := c.clone()
    knob_style.palette.normal = c.palette.foreground
    knob_style.palette.hovered = c.palette.accent
    knob_style.palette.pressed = c.palette.accent
    knob_style.focus_width = 0.0
    style_box(frame,&knob,&knob_style,d,state) or >>
    if (state & state_focused) != 0 && (state & state_disabled) == 0 {
        inset := c.focus_inset * d
        focus := layout.Rect{x: b.x + inset,y: b.y + inset,width: math.max(0.0,b.width - 2.0 * inset),height: math.max(0.0,b.height - 2.0 * inset)}
        rounded_stroke(frame,&focus,math.max(0.0,c.radius * d - inset),resolved.focus,c.focus_width * d) or >>
    }
    << 0
}
