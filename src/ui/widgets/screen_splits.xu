@ui/widgets
#ui/layout
#errors

pub fn (s &mut Screen) split_pane(id int,pane int) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_SPLIT_VIEW || pane < 0 || pane > 1 { >> errors.new("widgets: expected split pane 0 or 1") }
    mut existing := 0
    owner := mut &s.controls
    entries := mut &owner.splits
    item := entries.take(id)
    if pane == 0 { existing = item.first_id } else { existing = item.second_id }
    entries[id] = item
    if existing > 0 { << existing }
    group := s.group() or >>
    s.set_parent(group,id) or >>
    next_owner := mut &s.controls
    next_entries := mut &next_owner.splits
    mut next_item := next_entries.take(id)
    if pane == 0 { next_item.first_id = group } else { next_item.second_id = group }
    next_entries[id] = next_item
    panes := mut &next_owner.split_panes
    panes[group] = id
    << group
}
fn (s &mut Screen) layout_split_panes(id int) int {
    owner := mut &s.controls
    entries := mut &owner.splits
    item := entries.take(id)
    boxes := item.layout()
    bounds := item.bounds()
    first := item.first_id
    second := item.second_id
    entries[id] = item
    if first > 0 { a := boxes.first
        s.nodes[first - 1].local = layout.Rect{x: a.x - bounds.x,y: a.y - bounds.y,width: a.width,height: a.height} }
    if second > 0 { b := boxes.second
        s.nodes[second - 1].local = layout.Rect{x: b.x - bounds.x,y: b.y - bounds.y,width: b.width,height: b.height} }
    << 0
}
fn (s &mut Screen) split_handle(id int) layout.Rect {
    owner := mut &s.controls
    entries := mut &owner.splits
    item := entries.take(id)
    result := item.layout().handle
    entries[id] = item
    << result
}
// Returns current local pane geometry from the placed size, before painting.
// Parent business content under split_pane() and size it using this query.
pub fn (s &mut Screen) split_layout(id int) SplitLayout {
    node := s.node(id) or >>
    if node.kind != SCREEN_SPLIT_VIEW { >> errors.new("widgets: expected SplitView") }
    bounds := layout.Rect{x: 0.0,y: 0.0,width: node.local.width,height: node.local.height}
    density := s.styles.density
    owner := mut &s.controls
    entries := mut &owner.splits
    item := entries.take(id)
    result := item.geometry(&bounds,density)
    entries[id] = item
    << result
}
pub fn (s &mut Screen) set_split_ratio(id int,ratio f64) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_SPLIT_VIEW { >> errors.new("widgets: expected SplitView") }
    owner := mut &s.controls
    entries := mut &owner.splits
    mut item := entries.take(id)
    message := screen_set_split_ratio(mut &item,ratio)
    entries[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_set_split_ratio(item &mut SplitView,ratio f64) string {
    item.set_ratio(ratio) or (err) { << err.msg() }
    << ""
}
pub fn (s &mut Screen) set_split_options(id int,options &SplitViewOptions) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_SPLIT_VIEW { >> errors.new("widgets: expected SplitView") }
    owner := mut &s.controls
    entries := mut &owner.splits
    mut item := entries.take(id)
    message := screen_set_split_options(mut &item,options)
    entries[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_set_split_options(item &mut SplitView,options &SplitViewOptions) string {
    item.set_options(options) or (err) { << err.msg() }
    << ""
}
pub fn (s &mut Screen) set_split_collapsed(id int,pane int,collapsed bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_SPLIT_VIEW { >> errors.new("widgets: expected SplitView") }
    owner := mut &s.controls
    entries := mut &owner.splits
    mut item := entries.take(id)
    message := screen_set_split_collapsed(mut &item,pane,collapsed)
    entries[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    s.layout_controls() or >>
    if s.focused > 0 && !s.is_visible(s.focused) { s.focus(id) or >> }
    if s.captured > 0 && !s.is_visible(s.captured) { event := s.cancellation()
        _ := s.route_node(s.captured,ROUTE_CANCEL,&event) or >>
        s.captured = 0 }
    << 0
}
fn screen_set_split_collapsed(item &mut SplitView,pane int,collapsed bool) string {
    item.set_collapsed(pane,collapsed) or (err) { << err.msg() }
    << ""
}
fn (s &mut Screen) interaction_invalid(id int,invalid bool) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_RANGE_SLIDER { owner := mut &s.controls
        entries := mut &owner.ranges
        mut item := entries.take(id)
        control := mut &item.control
        control.set_invalid(invalid)
        entries[id] = item }
    if node.kind == SCREEN_SPLIT_VIEW { owner := mut &s.controls
        entries := mut &owner.splits
        mut item := entries.take(id)
        control := mut &item.control
        control.set_invalid(invalid)
        entries[id] = item }
    if node.kind == SCREEN_MENU { owner := mut &s.controls
        entries := mut &owner.menus
        mut item := entries.take(id)
        control := mut &item.control
        control.set_invalid(invalid)
        entries[id] = item }
    s.dirty = true
    << 0
}
