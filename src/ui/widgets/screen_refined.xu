@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#time

struct RefinedResult {
    error string
    action Action
    text string
    flag bool
    changed bool
    deadline time.Instant
}
fn refined_result() RefinedResult {
    << RefinedResult{error: "",action: no_action(0,false),text: "",flag: false,changed: false,deadline: time.zero_instant()}
}
fn refined_failure(message string) RefinedResult {
    mut result := refined_result()
    result.error = message
    << result
}

pub fn (s &mut Screen) field(value string,decoration &FieldDecoration) int {
    id := s.add_node(SCREEN_FIELD,true,ui.CURSOR_TEXT) or >>
    empty := screen_empty()
    item := field(&s.context,&s.identity,id,&empty,&value,decoration) or (err) { s.abandon_node(id)
        >> err }
    controls := mut &s.controls
    items := mut &controls.fields
    items[id] = item
    s.apply_current_locale(id) or >>
    << id
}
pub fn (s &mut Screen) task_button(label string) int {
    id := s.add_node(SCREEN_TASK,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    item := task_button(&s.context,&s.identity,id,&empty,&label) or (err) { s.abandon_node(id)
        >> err }
    controls := mut &s.controls
    items := mut &controls.tasks
    items[id] = item
    s.apply_current_locale(id) or >>
    << id
}
fn screen_paint_field(item &mut Field,frame &mut draw.Frame,styles &Styles) string {
    b := item.bounds()
    frame.push() or (err) { << err.msg() }
    frame.translate(b.x,b.y) or (err) { screen_controls_pop(frame)
        << err.msg() }
    item.paint_styled(frame,styles) or (err) { screen_controls_pop(frame)
        << err.msg() }
    frame.pop() or (err) { << err.msg() }
    << ""
}

fn refined_field_place(item &mut Field,bounds &layout.Rect,styles &Styles) RefinedResult {
    mut result := refined_result()
    item.place(bounds) or (err) { << refined_failure(err.msg()) }
    item.apply_styles(styles) or (err) { << refined_failure(err.msg()) }
    << result
}

fn refined_task_place(item &mut TaskButton,bounds &layout.Rect,styles &Styles) RefinedResult {
    mut result := refined_result()
    item.set_bounds(bounds) or (err) { << refined_failure(err.msg()) }
    << result
}

fn (s &mut Screen) refined_place(id int,bounds &layout.Rect) int {
    node := s.node(id) or >>
    styles := s.styles.clone()
    if node.kind == SCREEN_FIELD {
        controls := mut &s.controls
        items := mut &controls.fields
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := refined_field_place(mut &item,bounds,&styles)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << 0
    }
    if node.kind == SCREEN_TASK {
        controls := mut &s.controls
        items := mut &controls.tasks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := refined_task_place(mut &item,bounds,&styles)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << 0
    }
    >> errors.new("widgets: unexpected refined control")
}

fn refined_field_input(item &mut Field,route int,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    mut action := no_action(item.id(),false)
    if route == ROUTE_INPUT { action = item.input(event) or (err) { << refined_failure(err.msg()) } }
    else { action = item.route(route,event) or (err) { << refined_failure(err.msg()) } }
    result.action = action
    << result
}

fn refined_task_input(item &mut TaskButton,route int,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    mut action := no_action(item.id(),false)
    if route == ROUTE_INPUT { action = item.input(event) or (err) { << refined_failure(err.msg()) } }
    else { action = item.route(route,event) or (err) { << refined_failure(err.msg()) } }
    result.action = action
    << result
}

