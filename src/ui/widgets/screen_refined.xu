    node := s.node(id) or >>
    if node.kind == SCREEN_FIELD {
        controls := mut &s.controls
        items := mut &controls.fields
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := refined_field_input(mut &item,route,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if node.kind == SCREEN_TASK {
        controls := mut &s.controls
        items := mut &controls.tasks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := refined_task_input(mut &item,route,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    >> errors.new("widgets: unexpected refined control")
}

fn refined_field_paint(item &mut Field,frame &mut draw.Frame,styles &Styles,popup bool) RefinedResult {
    mut result := refined_result()
    if !popup { result.error = screen_paint_field(item,frame,styles) }
    << result
}

fn refined_task_paint(item &mut TaskButton,frame &mut draw.Frame,styles &Styles,popup bool) RefinedResult {
    mut result := refined_result()
    if !popup { item.paint_styled(frame,styles) or (err) { << refined_failure(err.msg()) } }
    << result
}

fn (s &mut Screen) refined_paint(id int,frame &mut draw.Frame,styles &Styles,popup bool) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_FIELD {
        controls := mut &s.controls
        items := mut &controls.fields
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := refined_field_paint(mut &item,frame,styles,popup)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << 0
