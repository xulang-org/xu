fn refined_field_tick(item &mut Field,now time.Instant,reduced bool) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_caret_tick(now,reduced) or (err) { << refined_failure(err.msg()) }
    << result
}

fn refined_task_tick(item &mut TaskButton,now time.Instant,reduced bool,styles &Styles) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(now,reduced) or (err) { << refined_failure(err.msg()) }
    _ := item.prepare_transition(styles) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}

fn (s &mut Screen) refined_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    node := s.node(id) or >>
    if node.kind == SCREEN_FIELD {
        controls := mut &s.controls
        items := mut &controls.fields
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := refined_field_tick(mut &item,now,reduced)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << ScreenAnimation{changed: result.changed,deadline: result.deadline}
    }
    if node.kind == SCREEN_TASK {
        styles := s.styles.clone()
        controls := mut &s.controls
        items := mut &controls.tasks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := refined_task_tick(mut &item,now,reduced,&styles)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << ScreenAnimation{changed: result.changed,deadline: result.deadline}
    }
    >> errors.new("widgets: unexpected refined control")
}

