pub fn (s &mut Screen) begin_task(id int,task_id int) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_TASK { >> errors.new("widgets: wrong screen control type") }
    now := time.instant()
    controls := mut &s.controls
    items := mut &controls.tasks
    if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
    mut item := items.take(id)
    result := refined_begin_task(mut &item,task_id,now)
    items[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    s.invalidate()
    << 0
}

