fn (s &mut Screen) refined_dispose(id int) int {
    node := s.node(id) or >>
    controls := mut &s.controls
    if node.kind == SCREEN_FIELD {
        items := mut &controls.fields
        if items.has(id) { mut item := items.take(id)
            field := mut &item
            field.dispose() }
    } else {
        items := mut &controls.tasks
        if items.has(id) { mut item := items.take(id)
            item.dispose() }
    }
    << 0
}

fn refined_field_value(item &mut Field) RefinedResult {
    mut result := refined_result()
    result.text = item.value()
    << result
}

fn (s &mut Screen) field_value(id int) string {
    node := s.node(id) or >>
    if node.kind != SCREEN_FIELD { >> errors.new("widgets: wrong screen control type") }
    controls := mut &s.controls
    items := mut &controls.fields
    if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
    mut item := items.take(id)
    result := refined_field_value(mut &item)
    items[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.text
}

fn refined_set_field_value(item &mut Field,value &string) RefinedResult {
    mut result := refined_result()
    item.set_value(value) or (err) { << refined_failure(err.msg()) }
    << result
}

fn (s &mut Screen) set_field_value(id int,value &string) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_FIELD { >> errors.new("widgets: wrong screen control type") }
    controls := mut &s.controls
    items := mut &controls.fields
    if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
    mut item := items.take(id)
    result := refined_set_field_value(mut &item,value)
    items[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    s.invalidate()
    << 0
}

