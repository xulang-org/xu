@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

fn choice_copy_input(event &ui.InputEvent) ui.InputEvent {
    << ui.InputEvent{kind: event.kind,window_id: event.window_id,canvas_id: event.canvas_id,generation: event.generation,
        x: event.x,y: event.y,dx: event.dx,dy: event.dy,button: event.button,buttons: event.buttons,modifiers: event.modifiers,
        key: event.key,scan: event.scan,repeat: event.repeat,click_count: event.click_count,time_ns: event.time_ns}
}

// Editable choice field. Text is owned by Editor and travels through the native
// TextInput revision/IME protocol, including composition, clipboard and Unicode.
// Call event() for native events and place_combo_box() after each View layout.
// route() receives node-local input; input() receives canvas coordinates, which
// lets the scene intercept an open popup before dispatching an outside press.
// paint_styled() paints locally like Editor; paint_popup_styled() is canvas-space.
pub struct ComboBox {
    editor Editor
    choices ChoiceList
    selected_val int
    allow_custom bool
    choice_invalid bool
    query string
    toggle_armed bool
    custom_style string
}
pub fn combo_box(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,options &[]string,value &string) ComboBox {
    mut choices := choice_list(context,identity,bounds,options) or >>
    editor := input(context,identity,id,bounds,value) or >>
    mut selected := -1
    for i in 0:options.len { if options[i] == value + "" { selected = i } }
    if selected>=0 { choices.marked[selected]=true }
    << ComboBox{editor: editor,choices: choices,selected_val: selected,allow_custom: true,choice_invalid: false,query: value + "",toggle_armed: false,custom_style: ""}
}
pub fn (combo &ComboBox) id() int { << combo.editor.id }
pub fn (combo &ComboBox) bounds() layout.Rect { << combo.editor.bounds() }
pub fn (combo &ComboBox) value() string { << combo.editor.value() }
pub fn (combo &ComboBox) selected() int { << combo.selected_val }
pub fn (combo &ComboBox) count() int { << combo.choices.options.len }
pub fn (combo &ComboBox) filtered_count() int { << combo.choices.shown.len }
pub fn (combo &ComboBox) is_open() bool { << combo.choices.open }
pub fn (combo &ComboBox) is_focused() bool { << combo.editor.is_focused() }
pub fn (combo &ComboBox) is_enabled() bool { << combo.editor.is_enabled() }
pub fn (combo &ComboBox) needs_paint() bool { << combo.editor.needs_paint() || combo.choices.dirty }
pub fn (combo &mut ComboBox) set_placeholder(value &string) int { editor := mut &combo.editor
    << editor.set_placeholder(value) or >> }
pub fn (combo &ComboBox) style_or(styles &Styles) ControlStyle {
    if combo.custom_style.len > 0 { << decode_control_style(&combo.custom_style,&styles.input) }
    << styles.input.clone()
}
pub fn (combo &mut ComboBox) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    encoded := encode_control_style(style)
    if combo.custom_style != encoded {
        combo.custom_style = encoded
        combo.editor.dirty = true
    }
    << 0
}
pub fn (combo &mut ComboBox) set_enabled(enabled bool) int {
    editor := mut &combo.editor
    editor.enable(enabled) or >>
    if !enabled { combo.set_open(false) }
    << 0
}
pub fn (combo &mut ComboBox) set_read_only(read_only bool) int {
    editor := mut &combo.editor
    editor.set_read_only(read_only) or >>
    if read_only { combo.set_open(false) }
    << 0
}
pub fn (combo &mut ComboBox) set_invalid(invalid bool) { editor := mut &combo.editor
    editor.set_invalid(invalid) }
pub fn (combo &mut ComboBox) focus_session(focused bool) int {
    editor := mut &combo.editor
    editor.focus_session(focused) or >>
    if !focused { combo.set_open(false) }
    if !focused { combo.refresh_query(false)
        combo.choice_invalid=!combo.is_valid_choice() }
    << 0
}
pub fn (combo &mut ComboBox) set_bounds(bounds &layout.Rect) int {
    old := combo.bounds()
    editor := mut &combo.editor
    editor.place(bounds) or >>
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height {
        combo.choices.anchor = copy_rect(bounds)
        combo.choices.armed = -1
        combo.choices.dirty = true
        combo.toggle_armed = false
    }
    << 0
}
pub fn place_combo_box(view &mut View,combo &mut ComboBox) int {
    id := combo.id()
    bounds := view.node_bounds(id) or >>
    combo.set_bounds(&bounds) or >>
    view.set_capture_outside(id,true) or >>
    if combo.needs_paint() { view.mark_paint(id) or >> }
    << 0
}
fn (combo &mut ComboBox) refresh_query(open bool) {
    value := combo.editor.value()
    if value != combo.query {
        combo.query = value + ""
        combo.selected_val = -1
        for i in 0:combo.choices.options.len { if combo.choices.options[i] == value { combo.selected_val = i } }
        for i in 0:combo.choices.marked.len { combo.choices.marked[i]=i==combo.selected_val }
        combo.choice_invalid=false
        choices := mut &combo.choices
        choices.filter(&value)
        if open { choices.set_open(true) }
    }
}
pub fn (combo &mut ComboBox) set_value(value &string) int {
    editor := mut &combo.editor
    editor.set_value(value) or >>
    combo.refresh_query(false)
    if !combo.editor.focused { combo.choice_invalid=!combo.is_valid_choice() }
    << 0
}
pub fn (combo &mut ComboBox) set_selected(index int) int {
    if index < 0 || index >= combo.count() { >> errors.new("widgets: combo choice out of range") }
    value := combo.choices.options[index]
    editor := mut &combo.editor
    // set_value rejects replacement during native IME composition rather than
    // silently losing preedit text. Scenes should keep delivering native edits.
    editor.set_value(&value) or >>
    combo.query = value + ""
    combo.selected_val = index
    combo.choice_invalid=false
    for i in 0:combo.choices.marked.len { combo.choices.marked[i]=i==index }
    combo.set_open(false)
    << 0
}
pub fn (combo &mut ComboBox) set_open(open bool) {
    allowed := open && combo.editor.is_enabled() && !combo.editor.read_only
    if allowed && !combo.choices.open {
        selected := combo.selected_val
        choices := mut &combo.choices
        // Explicit opening shows all choices. Editing subsequently filters.
        choices.filter(&"")
        for i in 0:choices.shown.len { if choices.shown[i] == selected { choices.cursor = i } }
        choices.reveal()
    }
    choices := mut &combo.choices
    choices.set_open(allowed)
    if !allowed { combo.toggle_armed = false }
}
pub fn (combo &mut ComboBox) set_popup_above(above bool) {
    if combo.choices.above != above {
        combo.choices.above = above
        combo.choices.armed = -1
        combo.choices.dirty = true
    } }
pub fn (combo &mut ComboBox) apply_styles(styles &Styles) int {
    styles.validate() or >>
    mut field := combo.style_or(styles)
    field.padding.right = field.padding.right + math.min(combo.bounds().height,combo.bounds().width) / styles.density
    editor := mut &combo.editor
    editor.set_style(&field) or >>
    editor.apply_styles(styles) or >>
    c := combo.style_or(styles)
    choices := mut &combo.choices
    << choices.metrics(styles,&c) or >>
}
pub fn (combo &ComboBox) popup_bounds() layout.Rect { << combo.choices.popup() }
pub fn (combo &ComboBox) option_bounds(index int) layout.Rect { << combo.choices.row(index) or >> }
pub fn (combo &ComboBox) toggle_bounds() layout.Rect {
    b := combo.bounds()
    width := math.min(b.width,b.height)
    << layout.Rect{x: b.x + b.width - width,y: b.y,width: width,height: b.height}
}
pub fn (combo &mut ComboBox) input(event &ui.InputEvent) Action {
    id := combo.id()
    if !belongs(&combo.editor.identity,event) || !combo.is_enabled() { << no_action(id,combo.needs_paint()) }
    if event.kind == ui.EV_POINTER_CANCEL { combo.focus_session(false) or >>
        << no_action(id,true) }
    focused := combo.editor.is_focused()
    if !combo.editor.read_only {
        // An active preedit owns Enter/arrows. Its native commit arrives in
        // event(); filtering is based on committed text only.
        composing := combo.editor.composing
        if !composing {
            choices := mut &combo.choices
            result := choices.input(id,event,focused,false) or >>
            if result.kind == ACTION_CHANGE { combo.set_selected(int(result.value)) or >>
                << Action{kind: ACTION_CHANGE,id: id,needs_paint: true,request_focus: true,consumed: true,value: f64(combo.selected_val)} }
            if result.consumed { << result }
        }
        toggle := combo.toggle_bounds()
        if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && toggle.contains(event.x,event.y) {
            combo.focus_session(true) or >>
            combo.toggle_armed = true
            << Action{kind: ACTION_NONE,id: id,needs_paint: true,request_focus: true,consumed: true,value: 0.0}
        }
        if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && combo.toggle_armed {
            combo.toggle_armed = false
            if toggle.contains(event.x,event.y) { combo.set_open(!combo.is_open()) }
            << Action{kind: ACTION_ACTIVATE,id: id,needs_paint: true,request_focus: true,consumed: true,value: 0.0}
        }
        if event.kind == ui.EV_KEY_DOWN && focused && !composing && (event.key == ui.KEY_DOWN || event.key == ui.KEY_UP) {
            combo.set_open(true)
            << Action{kind: ACTION_ACTIVATE,id: id,needs_paint: true,request_focus: false,consumed: true,value: 0.0}
        }
    }
    b := combo.bounds()
    if event.kind == ui.EV_POINTER_DOWN && !b.contains(event.x,event.y) { combo.focus_session(false) or >>
        << no_action(id,true) }
    outside := !b.contains(event.x,event.y)
    dragging := combo.editor.dragging
    // input() sees the whole canvas. An unrelated release belongs to the
    // control that owns its press; only an existing editor drag may finish
    // outside the field. Hover still reaches Editor to clear its appearance.
    if event.kind == ui.EV_POINTER_UP && outside && !dragging { << no_action(id,combo.needs_paint()) }
    mut local := choice_copy_input(event)
    local.x = event.x - b.x
    local.y = event.y - b.y
    editor := mut &combo.editor
    mut result := editor.route(ROUTE_INPUT,&local) or >>
    if outside && !dragging && (event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE) {
        result.consumed = false
        result.request_focus = false
    }
    combo.refresh_query(true)
    << result
}
pub fn (combo &mut ComboBox) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid combo route") }
    if !belongs(&combo.editor.identity,event) { << no_action(combo.id(),false) }
    if kind == ROUTE_FOCUS { combo.focus_session(true) or >> }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { combo.focus_session(false) or >> }
    else {
        b := combo.bounds()
        mut canvas := choice_copy_input(event)
        canvas.x = event.x + b.x
        canvas.y = event.y + b.y
        << combo.input(&canvas) or >>
    }
    << no_action(combo.id(),combo.needs_paint())
}
pub fn (combo &mut ComboBox) event(event &ui.Event) Action {
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << combo.input(&input) or >> }
    editor := mut &combo.editor
    result := editor.event(event) or >>
    combo.refresh_query(result.kind == ACTION_CHANGE && combo.editor.is_focused())
    if !combo.editor.is_focused() { combo.set_open(false)
        combo.choice_invalid=!combo.is_valid_choice() }
    << result
}
pub fn (combo &mut ComboBox) tick(now time.Instant,reduced_motion bool) bool { editor := mut &combo.editor
    << editor.tick(now,reduced_motion) or >> }
pub fn (combo &ComboBox) next_caret_tick(now time.Instant,reduced_motion bool) time.Instant { << combo.editor.next_caret_tick(now,reduced_motion) or >> }
pub fn (combo &mut ComboBox) measure_styled(styles &Styles) layout.Size {
    combo.apply_styles(styles) or >>
    editor := mut &combo.editor
    size := editor.measure_styled(styles) or >>
    << layout.Size{width: math.max(180.0 * styles.density,size.width + 32.0 * styles.density),height: size.height}
}
pub fn (combo &mut ComboBox) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    combo.apply_styles(styles) or >>
    b := combo.bounds()
    c := combo.style_or(styles)
    mut state := combo.editor.visual_state()
    if combo.choice_invalid { state=state|STATE_INVALID }
    editor := mut &combo.editor
    editor.paint_styled(frame,styles) or >>
    width := math.min(b.width,b.height)
    x := b.width - width * 0.5
    y := b.height * 0.5
    // An opaque chevron well prevents long input text from obscuring the affordance.
    paint := c.resolve(state)
    frame.fill_rect(b.width - width + 2.0,2.0,math.max(0.0,width - 4.0),math.max(0.0,b.height - 4.0),paint.background) or >>
    frame.line(x - 4.0,y - 2.0,x,y + 2.0,paint.foreground,1.5) or >>
    frame.line(x,y + 2.0,x + 4.0,y - 2.0,paint.foreground,1.5) or >>
    combo.choices.dirty = false
    << 0
}
pub fn (combo &mut ComboBox) paint_popup_styled(frame &mut draw.Frame,styles &Styles) int {
    c := combo.style_or(styles)
    choices := mut &combo.choices
    << choices.paint(frame,styles,&c,false) or >>
}
pub fn (combo &mut ComboBox) dispose() {
    editor := mut &combo.editor
    editor.dispose()
    choices := mut &combo.choices
    labels := mut &choices.labels
    labels.dispose()
    combo.choices.open = false
}

pub fn (combo &mut ComboBox) set_allow_custom(allowed bool) {
    combo.allow_custom=allowed
    combo.choice_invalid=!combo.editor.focused && !combo.is_valid_choice()
    combo.editor.dirty=true
}
pub fn (combo &ComboBox) is_valid_choice() bool { << combo.allow_custom || combo.selected_val>=0 || combo.editor.value.len==0 }
