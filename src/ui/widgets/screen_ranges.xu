@ui/widgets
#errors

fn (s &mut Screen) range_tab(id int,backward bool,entering bool) bool {
    owner := mut &s.controls
    entries := mut &owner.ranges
    mut item := entries.take(id)
    result := item.tab(backward,entering)
    entries[id] = item
    << result
}
pub fn (s &mut Screen) set_range_values(id int,lower f64,upper f64) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_RANGE_SLIDER { >> errors.new("widgets: expected RangeSlider") }
    owner := mut &s.controls
    entries := mut &owner.ranges
    mut item := entries.take(id)
    message := screen_set_range_values(mut &item,lower,upper)
    entries[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_set_range_values(item &mut RangeSlider,lower f64,upper f64) string {
    item.set_values(lower,upper) or (err) { << err.msg() }
    << ""
}
