pub fn (s $&Screen) set_item_sticky(id int,sticky bool,offset f64) int {
    _ := s.node(id) or >>
    if !valid_signed_coord(offset) { >> errors.new("widgets: invalid sticky offset") }
    $it := s.copy_or_default_layout_item(id)
    it.sticky = sticky
    it.sticky_offset = offset
    << s.set_layout_item(id,&it) or >>
}

