fn screen_measure_range(item $&RangeSlider,styles &Styles,d f64) layout.Size {
    c := item.style_or(styles)
    << layout.Size{width: math.max(200.0 * d,c.min_width * d),height: math.max(36.0 * d,c.min_height * d)}
}
fn screen_measure_bgroup(item $&ButtonGroup,styles &Styles,d f64) layout.Size {
    $total_w := 0.0
    $max_h := 34.0 * d
    count := item.items.len
    $gap := item.appearance.gap * d
    if item.appearance.joined { gap = 0.0 }
    for i in 0:count {
        st := item.item_style(i,styles) or (err) { << layout.Size{width: 160.0 * d,height: 34.0 * d} }
        lbl := item.items[i].label + ""
        cache := $&item.labels
        sz := cache.measure(i,&lbl,styles,&st) or (err) { << layout.Size{width: 160.0 * d,height: 34.0 * d} }
        w := math.max(item.appearance.min_item_width * d,sz.width + (st.padding.left + st.padding.right) * d)
        h := math.max(st.min_height * d,sz.height + (st.padding.top + st.padding.bottom) * d)
        if item.appearance.vertical {
            total_w = math.max(total_w,w)
            max_h = math.max(max_h,h)
        } else {
            total_w += w
            max_h = math.max(max_h,h)
        }
    }
    if item.appearance.vertical && count > 0 {
        << layout.Size{width: math.max(48.0 * d,total_w),height: f64(count) * max_h + f64(max_int(0,count - 1)) * gap}
    }
    if count > 1 && !item.appearance.vertical { total_w += gap * f64(count - 1) }
    << layout.Size{width: math.max(80.0 * d,total_w),height: max_h}
}
fn screen_measure_menu(item $&Menu,styles &Styles,d f64) layout.Size {
    if item.mode == MENU_CONTEXT { << layout.Size{width: 0.0,height: 0.0} }
    c := item.control.style_or(styles)
    lbl := item.label + ""
    cache := $&item.labels
    $sz := layout.Size{width: 60.0 * d,height: 20.0 * d}
    $w := 60.0 * d
    $h := math.max(c.min_height * d,34.0 * d)
    if lbl.len > 0 {
        lsz := cache.measure(0,&lbl,styles,&c) or (err) { << layout.Size{width: math.max(c.min_width * d,100.0 * d),height: h} }
        w = lsz.width + (c.padding.left + c.padding.right) * d + 20.0 * d
        h = math.max(h,lsz.height + (c.padding.top + c.padding.bottom) * d)
    }
    if item.mode == MENU_SPLIT { w += 36.0 * d }
    << layout.Size{width: math.max(c.min_width * d,w),height: h}
}
fn screen_measure_card(item &Card,styles &Styles) layout.Size {
    << item.measure_styled(styles) or (err) { << layout.Size{width: 120.0,height: 80.0} }
}
fn screen_measure_scroll(item $&Scroll,styles &Styles) layout.Size {
    << item.measure_styled(styles) or (err) { << layout.Size{width: 160.0,height: 120.0} }
}

fn (s $&Screen) measure_leaf_widget(id int,max_w f64,max_h f64,in_styles &Styles) layout.Size {
    patched := s.resolve_styles_with_patch(id,in_styles)
    styles := &patched
    n := s.nodes[id - 1]
    kind := n.kind
    d := styles.density
    if kind == SCREEN_LABEL {
        if s.basics.selectable_texts.has(id) {
            basic := $&s.basics
            store := $&basic.selectable_texts
            $item := store.take(id)
            sz := screen_measure_sel_text($&item,styles)
            store[id] = item
            << sz
        }
        << s.measure_label_size(id,styles,max_w)
    }
    if kind == SCREEN_SELECTABLE_TEXT {
        basic := $&s.basics
        store := $&basic.selectable_texts
        $item := store.take(id)
        sz := screen_measure_sel_text($&item,styles)
        store[id] = item
        << sz
    }
    if kind == SCREEN_BUTTON {
        if s.basics.button_icons.has(id) && s.basics.button_icon_labels.has(id) {
            item := s.take_button(id)
            slot := id * 2
            if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
            txt := s.texts[id - 1] + ""
            $lbl := styled_label(&s.context,&txt)
            sz := screen_measure_btn_icon(&item,$&lbl,styles)
            lbl.dispose()
            s.buttons[id] = item
            << sz
        }
        << s.measure_button_styled(id,styles) or (err) { << layout.Size{width: 80.0 * d,height: 36.0 * d} }
    }
    if kind == SCREEN_CHECKBOX {
        item := s.take_basic_checks(id)
        $lbl := s.take_basic_label(id * 1024)
        sz := screen_measure_check(&item,$&lbl,styles,d)
        s.basics.labels[id * 1024] = lbl
        s.basics.checks[id] = item
        << sz
    }
    if kind == SCREEN_SWITCH {
        item := s.take_basic_switches(id)
        $lbl := s.take_basic_label(id * 1024)
        sz := screen_measure_switch(&item,$&lbl,styles,d)
        s.basics.labels[id * 1024] = lbl
        s.basics.switches[id] = item
        << sz
    }
    if kind == SCREEN_RADIO {
        item := s.take_basic_radios(id)
        $lbl := s.take_basic_label(id * 1024)
        sz := screen_measure_radio(&item,$&lbl,styles,d)
        s.basics.labels[id * 1024] = lbl
        s.basics.radios[id] = item
        << sz
    }
    if kind == SCREEN_SLIDER {
        $item := s.take_basic_sliders(id)
        sz := screen_measure_slider($&item,styles,d)
        s.basics.sliders[id] = item
        << sz
    }
    if kind == SCREEN_STEPPER {
        item := s.take_basic_steppers(id)
        $lbl := s.take_basic_label(id * 1024)
        sz := screen_measure_stepper(&item,$&lbl,styles,d)
        s.basics.labels[id * 1024] = lbl
        s.basics.steppers[id] = item
        << sz
    }
    if kind == SCREEN_TABS {
        item := s.take_basic_tabs(id)
        $lbl := s.take_basic_label(id * 1024)
        sz := screen_measure_tabs(&item,$&lbl,styles,d)
        s.basics.labels[id * 1024] = lbl
        s.basics.tabs[id] = item
        << sz
    }
    if kind == SCREEN_SELECT {
        item := s.take_basic_selects(id)
        $lbl := s.take_basic_label(id * 1024)
        sz := screen_measure_select(&item,$&lbl,styles,d)
        s.basics.labels[id * 1024] = lbl
        s.basics.selects[id] = item
        << sz
    }
    if kind == SCREEN_LIST {
        item := s.take_basic_lists(id)
        $lbl := s.take_basic_label(id * 1024)
        sz := screen_measure_list(&item,$&lbl,styles,d)
        s.basics.labels[id * 1024] = lbl
        s.basics.lists[id] = item
        << sz
    }
    if kind == SCREEN_PROGRESS {
        item := &s.basics.progresses[id]
        << screen_measure_progress(item,styles,d)
    }
    if kind == SCREEN_DIVIDER {
        item := &s.basics.dividers[id]
        << screen_measure_divider(item,styles,d)
    }
    if kind == SCREEN_BADGE {
        << s.badge_size(id) or (err) { << layout.Size{width: 28.0 * d,height: 20.0 * d} }
    }
    if kind == SCREEN_RADIO_GROUP {
        $item := s.take_basic_group(id)
        sz := screen_measure_rgroup($&item,styles,d)
        s.basics.groups[id] = item
        << sz
    }
    if kind == SCREEN_TABLE {
        ctrls := $&s.controls
        tables := $&ctrls.tables
        $item := tables.take(id)
        sz := screen_measure_table($&item,styles,d)
        tables[id] = item
        << sz
    }
    if kind == SCREEN_TREE {
        ctrls := $&s.controls
        trees := $&ctrls.trees
        $item := trees.take(id)
        sz := screen_measure_tree($&item,styles,d)
        trees[id] = item
        << sz
    }
    if kind == SCREEN_PAGINATION {
        ctrls := $&s.controls
        pages := $&ctrls.pages
        $item := pages.take(id)
        sz := screen_measure_page($&item,styles,d)
        pages[id] = item
        << sz
    }
    if kind == SCREEN_BREADCRUMBS {
        ctrls := $&s.controls
        crumbs := $&ctrls.crumbs
        $item := crumbs.take(id)
        sz := screen_measure_crumbs($&item,styles,d)
        crumbs[id] = item
        << sz
    }
    if kind == SCREEN_COMBO || kind == SCREEN_EDITOR || kind == SCREEN_SECRET_INPUT || kind == SCREEN_FIELD {
        if ui.host_tmp() == ":xu:" {
            if kind == SCREEN_COMBO {
                ctrls := $&s.controls
                combos := $&ctrls.combos
                $item := combos.take(id)
                sz := screen_measure_combo($&item,styles,d)
                combos[id] = item
                << sz
            }
            if kind == SCREEN_FIELD {
                ctrls := $&s.controls
                fields := $&ctrls.fields
                $item := fields.take(id)
                sz := screen_measure_field($&item,styles,d)
                fields[id] = item
                << sz
            }
            ctrls := $&s.controls
            editors := $&ctrls.editors
            $item := editors.take(id)
            sz := screen_measure_editor($&item,styles,d)
            editors[id] = item
            << sz
        }
        lh := s.fallback_line_height(styles,&styles.input)
        if kind == SCREEN_FIELD { << layout.Size{width: math.max(180.0 * d,styles.input.min_width * d),height: math.max(54.0 * d,lh + 28.0 * d)} }
        << layout.Size{width: math.max(180.0 * d,styles.input.min_width * d),height: math.max(styles.input.min_height * d,lh + 14.0 * d)}
    }
    if kind == SCREEN_MULTI {
        ctrls := $&s.controls
        multis := $&ctrls.multis
        $item := multis.take(id)
        sz := screen_measure_multi($&item,styles,d)
        multis[id] = item
        << sz
    }
    if kind == SCREEN_COLOR {
        ctrls := $&s.controls
        colors := $&ctrls.colors
        $item := colors.take(id)
        sz := screen_measure_color($&item,styles,d)
        colors[id] = item
        << sz
    }
    if kind == SCREEN_DATE {
        ctrls := $&s.controls
        dates := $&ctrls.dates
        $item := dates.take(id)
        sz := screen_measure_date($&item,styles,d)
        dates[id] = item
        << sz
    }
    if kind == SCREEN_CLOCK {
        ctrls := $&s.controls
        clocks := $&ctrls.clocks
        $item := clocks.take(id)
        sz := screen_measure_clock($&item,styles,d)
        clocks[id] = item
        << sz
    }
    if kind == SCREEN_SPINNER {
        item := &s.controls.spinners[id]
        << screen_measure_spinner(item,styles,d)
    }
    if kind == SCREEN_TASK {
        ctrls := $&s.controls
        tasks := $&ctrls.tasks
        $item := tasks.take(id)
        sz := screen_measure_task($&item,styles,d)
        tasks[id] = item
        << sz
    }
    if kind == SCREEN_RANGE_SLIDER {
        ctrls := $&s.controls
        ranges := $&ctrls.ranges
        $item := ranges.take(id)
        sz := screen_measure_range($&item,styles,d)
        ranges[id] = item
        << sz
    }
    if kind == SCREEN_BUTTON_GROUP {
        ctrls := $&s.controls
        bgs := $&ctrls.button_groups
        $item := bgs.take(id)
        sz := screen_measure_bgroup($&item,styles,d)
        bgs[id] = item
        << sz
    }
    if kind == SCREEN_MENU {
        ctrls := $&s.controls
        menus := $&ctrls.menus
        $item := menus.take(id)
        sz := screen_measure_menu($&item,styles,d)
        menus[id] = item
        << sz
    }
    if kind == SCREEN_CUSTOM {
        c := layout.loose(max_w,max_h) or >>
        << s.custom_measure(id,&c,styles)
    }
    if kind == SCREEN_SPLIT_VIEW {
        << layout.Size{width: math.max(160.0 * d,n.local.width),height: math.max(120.0 * d,n.local.height)}
    }
    << layout.Size{width: math.max(0.0,n.local.width),height: math.max(0.0,n.local.height)}
}

fn apply_item_aspect_and_clamp(w_in f64,h_in f64,min_w f64,max_w f64,min_h f64,max_h f64,aspect_ratio f64,fixed_w bool,fixed_h bool) layout.Size {
    $w := w_in
    $h := h_in
    if aspect_ratio > 0.0 {
        if fixed_w && !fixed_h { h = w / aspect_ratio }
        else if fixed_h && !fixed_w { w = h * aspect_ratio }
        else if !fixed_w && !fixed_h {
            if w > 0.0 { h = w / aspect_ratio }
            else if h > 0.0 { w = h * aspect_ratio }
        }
    }
    w = math.max(min_w,w)
    h = math.max(min_h,h)
    if max_w >= 0.0 { w = math.min(max_w,w) }
    if max_h >= 0.0 { h = math.min(max_h,h) }
    << layout.Size{width: math.max(0.0,w),height: math.max(0.0,h)}
}

fn (s &Screen) apply_layout_item_clamp(id int,natural &layout.Size) layout.Size {
    $w := natural.width
    $h := natural.height
    if s.composition.items.has(id) {
        it := &s.composition.items[id]
        has_w := it.width >= 0.0
        has_h := it.height >= 0.0
        if has_w { w = it.width }
        if has_h { h = it.height }
        << apply_item_aspect_and_clamp(w,h,it.min_width,it.max_width,it.min_height,it.max_height,it.aspect_ratio,has_w,has_h)
    } else if s.nodes[id - 1].kind == SCREEN_GROUP || s.nodes[id - 1].kind == SCREEN_SPLIT_VIEW || s.nodes[id - 1].kind == SCREEN_WEBVIEW {
        if w <= 0.0 && s.nodes[id - 1].local.width > 0.0 { w = s.nodes[id - 1].local.width }
        if h <= 0.0 && s.nodes[id - 1].local.height > 0.0 { h = s.nodes[id - 1].local.height }
    }
    << layout.Size{width: math.max(0.0,w),height: math.max(0.0,h)}
}

fn (s &Screen) resolve_container_layout_for(id int,avail_outer_w f64,styles &Styles) ContainerLayout {
    $cfg := copy_container_layout(&s.composition.containers[id])
    if cfg.scale_with_density && styles.density != 1.0 {
        d := styles.density
        cfg.padding = layout.Insets{
            left: cfg.padding.left * d,
            top: cfg.padding.top * d,
            right: cfg.padding.right * d,
            bottom: cfg.padding.bottom * d
        }
        cfg.gap = cfg.gap * d
        cfg.run_gap = cfg.run_gap * d
        if cfg.min_col_width > 0.0 { cfg.min_col_width = cfg.min_col_width * d }
    }
    if cfg.kind == LAYOUT_GRID && cfg.min_col_width > 0.0 && avail_outer_w < 100000.0 {
        inner_w := math.max(0.0,avail_outer_w - cfg.padding.left - cfg.padding.right)
        eff_cols := layout.effective_grid_columns(inner_w,cfg.columns,cfg.gap,cfg.min_col_width)
        if cfg.columns != eff_cols {
            cfg.columns = eff_cols
            if cfg.col_weights.len != eff_cols { cfg.col_weights = []f64{} }
        }
    }
    << cfg
}

fn (s &Screen) order_sorted_live_children(id int) []int {
    child_count := s.child_count_of(id)
    $ids := []int{}
    $has_order := false
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid <= 0 || cid > s.nodes.len || s.nodes[cid - 1].kind < 0 || s.nodes[cid - 1].parent != id { -> }
        ids.push(cid)
        if s.composition.items.has(cid) && s.composition.items[cid].order != 0 { has_order = true }
    }
    if has_order && ids.len > 1 {
        for i in 1:ids.len {
            key := ids[i]
            $key_ord := 0
            if s.composition.items.has(key) { key_ord = s.composition.items[key].order }
            $j := i - 1
            while j >= 0 {
                prev := ids[j]
                $prev_ord := 0
                if s.composition.items.has(prev) { prev_ord = s.composition.items[prev].order }
                if prev_ord <= key_ord { <- }
                ids[j + 1] = prev
                j = j - 1
            }
            ids[j + 1] = key
        }
    }
    << ids
}

fn (s &Screen) has_custom_stacking() bool {
    << s.composition.z_index_count > 0 || s.composition.sticky_item_count > 0
}

fn (s &Screen) effective_z_index(id int) int {
    if s.composition.z_indices.has(id) { << s.composition.z_indices[id] }
    if s.composition.sticky_item_count > 0 && s.composition.items.has(id) && s.composition.items[id].sticky { << 1 }
    << 0
}

fn (s &Screen) sticky_scroll_shift(node_id int) layout.Offset {
    if s.composition.sticky_item_count == 0 || node_id <= 0 || node_id > s.nodes.len {
        << layout.Offset{x: 0.0,y: 0.0}
    }
    if !s.composition.items.has(node_id) || !s.composition.items[node_id].sticky {
        << layout.Offset{x: 0.0,y: 0.0}
    }
    nl := s.nodes[node_id - 1].local
    direct_parent := s.nodes[node_id - 1].parent
    stick_off := s.composition.items[node_id].sticky_offset
    $acc_x := nl.x
    $acc_y := nl.y
    $cur := direct_parent
    $scroll_id := 0
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        pn := s.nodes[cur - 1]
        if pn.kind < 0 { <- }
        if s.basics.scrolls.has(cur) {
            scroll_id = cur
            <-
        }
        if screen_is_overlay(pn.kind) { <- }
        acc_x += pn.local.x
        acc_y += pn.local.y
        cur = pn.parent
        budget -= 1
    }
    if scroll_id <= 0 { << layout.Offset{x: 0.0,y: 0.0} }
    sc_off := s.basics.scrolls[scroll_id].offset()
    axis := s.basics.scrolls[scroll_id].axis()
    if axis == AXIS_VERTICAL {
        min_pos := sc_off + stick_off
        if acc_y >= min_pos { << layout.Offset{x: 0.0,y: 0.0} }
        $dy := min_pos - acc_y
        if direct_parent > 0 && direct_parent != scroll_id {
            p_h := s.nodes[direct_parent - 1].local.height
            max_dy := math.max(0.0,p_h - (nl.y + nl.height))
            dy = math.min(dy,max_dy)
        }
        << layout.Offset{x: 0.0,y: dy}
    }
    min_pos := sc_off + stick_off
    if acc_x >= min_pos { << layout.Offset{x: 0.0,y: 0.0} }
    $dx := min_pos - acc_x
    if direct_parent > 0 && direct_parent != scroll_id {
        p_w := s.nodes[direct_parent - 1].local.width
        max_dx := math.max(0.0,p_w - (nl.x + nl.width))
        dx = math.min(dx,max_dx)
    }
    << layout.Offset{x: dx,y: 0.0}
}

fn (s &Screen) z_ordered_children(parent int) []int {
    child_count := s.child_count_of(parent)
    $ids := []int{}
    $has_z := false
    for i in 0:child_count {
        cid := s.child_at_of(parent,i)
        if cid <= 0 || cid > s.nodes.len || s.nodes[cid - 1].kind < 0 || s.nodes[cid - 1].parent != parent { -> }
        ids.push(cid)
        if s.effective_z_index(cid) != 0 { has_z = true }
    }
    if has_z && ids.len > 1 {
        for i in 1:ids.len {
            key := ids[i]
            key_z := s.effective_z_index(key)
            $j := i - 1
            while j >= 0 {
                prev := ids[j]
                prev_z := s.effective_z_index(prev)
                if prev_z <= key_z { <- }
                ids[j + 1] = prev
                j = j - 1
            }
            ids[j + 1] = key
        }
    }
    << ids
}

fn (s &Screen) sorted_visible_container_children(id int) []int {
    live := s.order_sorted_live_children(id)
    $ids := []int{}
    for i in 0:live.len {
        cid := live[i]
        if s.is_visible(cid) && !(s.composition.absolute_item_count > 0 && s.composition.items.has(cid) && s.composition.items[cid].absolute) {
            ids.push(cid)
        }
    }
    << ids
}

struct ContainerChildBox {
    cs layout.BoxStyle
    csz layout.Size
    margin layout.Insets
}

fn container_to_tree_root_style(cfg &ContainerLayout) layout.BoxStyle {
    box_kind := layout_container_kind_to_box(cfg.kind)
    $rs := layout.box_style(box_kind)
    rs.padding = layout.Insets{left: cfg.padding.left,top: cfg.padding.top,right: cfg.padding.right,bottom: cfg.padding.bottom}
    rs.gap = cfg.gap
    rs.run_gap = cfg.run_gap
    rs.main_alignment = cfg.main_alignment
    rs.cross_alignment = cfg.cross_alignment
    rs.align_x = cfg.align_x
    rs.align_y = cfg.align_y
    rs.columns = cfg.columns
    rs.min_col_width = cfg.min_col_width
    rs.col_weights = clone_layout_weights(&cfg.col_weights)
    rs.clip = cfg.clip
    << rs
}

fn (s &Screen) container_grid_cell_limit(cid int,cfg &ContainerLayout,track_ws &[]f64,cur_col int,base_max_w f64,base_max_h f64) layout.Size {
    $cw := base_max_w
    $ch := base_max_h
    if cfg.kind == LAYOUT_GRID && base_max_w < 100000.0 && track_ws.len == cfg.columns {
        $sp := 1
        if s.composition.items.has(cid) {
            sp = s.composition.items[cid].col_span
            if sp < 1 { sp = 1 }
            if sp > cfg.columns { sp = cfg.columns }
        }
        $start := cur_col
        if start > 0 && start + sp > cfg.columns { start = 0 }
        $sum_w := cfg.gap * f64(sp - 1)
        for k in start:(start + sp) { sum_w = sum_w + track_ws[k] }
        cw = math.max(0.0,sum_w)
    }
    << layout.Size{width: cw,height: ch}
}

fn (s $&Screen) measure_container_child_box(cid int,lim_w f64,lim_h f64,pct_ref_w f64,pct_ref_h f64,styles &Styles) ContainerChildBox {
    $mw_in := lim_w
    $mh_in := lim_h
    $m := layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    $cs := layout.box_style(layout.BOX_LEAF)
    $has_item := s.composition.items.has(cid)
    if has_item {
        cit := &s.composition.items[cid]
        m = layout.Insets{left: cit.margin.left,top: cit.margin.top,right: cit.margin.right,bottom: cit.margin.bottom}
        if mw_in < 100000.0 { mw_in = math.max(0.0,mw_in - m.left - m.right) }
        if mh_in < 100000.0 { mh_in = math.max(0.0,mh_in - m.top - m.bottom) }
        if cit.width < 0.0 && cit.width_pct >= 0.0 && pct_ref_w < 100000.0 {
            $pw := math.max(0.0,pct_ref_w * cit.width_pct - (m.left + m.right))
            pw = math.max(cit.min_width,pw)
            if cit.max_width >= 0.0 { pw = math.min(cit.max_width,pw) }
            mw_in = pw
        } else if cit.width >= 0.0 {
            mw_in = math.max(cit.min_width,cit.width)
            if cit.max_width >= 0.0 { mw_in = math.min(cit.max_width,mw_in) }
        }
        if cit.height < 0.0 && cit.height_pct >= 0.0 && pct_ref_h < 100000.0 {
            $ph := math.max(0.0,pct_ref_h * cit.height_pct - (m.top + m.bottom))
            ph = math.max(cit.min_height,ph)
            if cit.max_height >= 0.0 { ph = math.min(cit.max_height,ph) }
            mh_in = ph
        } else if cit.height >= 0.0 {
            mh_in = math.max(cit.min_height,cit.height)
            if cit.max_height >= 0.0 { mh_in = math.min(cit.max_height,mh_in) }
        }
    }
    $csz := s.measure_constrained_styled(cid,mw_in,mh_in,styles) or >>
    if has_item {
        cit := &s.composition.items[cid]
        $has_w := cit.width >= 0.0
        $has_h := cit.height >= 0.0
        if !has_w && cit.width_pct >= 0.0 && pct_ref_w < 100000.0 {
            $pw := math.max(0.0,pct_ref_w * cit.width_pct - (m.left + m.right))
            pw = math.max(cit.min_width,pw)
            if cit.max_width >= 0.0 { pw = math.min(cit.max_width,pw) }
            cs.width = pw
            csz.width = pw
            has_w = true
        } else if has_w {
            cs.width = cit.width
        }
        if !has_h && cit.height_pct >= 0.0 && pct_ref_h < 100000.0 {
            $ph := math.max(0.0,pct_ref_h * cit.height_pct - (m.top + m.bottom))
            ph = math.max(cit.min_height,ph)
            if cit.max_height >= 0.0 { ph = math.min(cit.max_height,ph) }
            cs.height = ph
            csz.height = ph
            has_h = true
        } else if has_h {
            cs.height = cit.height
        }
        if cit.aspect_ratio > 0.0 {
            ar_sz := apply_item_aspect_and_clamp(csz.width,csz.height,cit.min_width,cit.max_width,cit.min_height,cit.max_height,cit.aspect_ratio,has_w,has_h)
            csz = ar_sz
            if !has_w && has_h && cs.width < 0.0 { cs.width = ar_sz.width }
            if !has_h && has_w && cs.height < 0.0 { cs.height = ar_sz.height }
            if m.left + m.right + m.top + m.bottom == 0.0 { cs.aspect_ratio = cit.aspect_ratio }
        }
        cs.min_width = cit.min_width
        cs.max_width = cit.max_width
        cs.min_height = cit.min_height
        cs.max_height = cit.max_height
        cs.flex_grow = cit.flex_grow
        cs.flex_shrink = cit.flex_shrink
        cs.col_span = cit.col_span
        cs.align_self = cit.align_self
        cs.justify_self = cit.justify_self
        cs.order = cit.order
        cs.stack_align_x = cit.stack_align_x
        cs.stack_align_y = cit.stack_align_y
        mw := m.left + m.right
        mh := m.top + m.bottom
        if mw + mh > 0.0 {
            csz = layout.Size{width: csz.width + mw,height: csz.height + mh}
            if cs.width >= 0.0 { cs.width += mw }
            if cs.height >= 0.0 { cs.height += mh }
            cs.min_width += mw
            cs.min_height += mh
            if cs.max_width >= 0.0 { cs.max_width += mw }
            if cs.max_height >= 0.0 { cs.max_height += mh }
        }
    }
    << ContainerChildBox{cs: cs,csz: csz,margin: m}
}

fn (s &Screen) child_count_of(id int) int {
    if !s.composition.children_order.has(id) { << 0 }
    list := &s.composition.children_order[id]
    << list.len
}

fn (s &Screen) child_at_of(id int,index int) int {
    list := &s.composition.children_order[id]
    << list[index]
}

fn (s $&Screen) measure_container_natural(id int,max_w f64,max_h f64) layout.Size {
    styles := s.styles_for(id)
    << s.measure_container_natural_styled(id,max_w,max_h,&styles) or >>
}

fn (s &Screen) container_is_clipped(id int) bool {
    if !s.composition.containers.has(id) { << false }
    cfg := &s.composition.containers[id]
    << cfg.clip
}

fn (s $&Screen) measure_container_natural_styled(id int,max_w f64,max_h f64,styles &Styles) layout.Size {
    $bound_w := max_w
    if s.composition.items.has(id) {
        it := &s.composition.items[id]
        if it.width >= 0.0 { bound_w = it.width }
        else if it.width_pct >= 0.0 && max_w < 100000.0 { bound_w = max_w * it.width_pct }
        else if it.max_width >= 0.0 && max_w >= 100000.0 { bound_w = it.max_width }
    }
    cfg := s.resolve_container_layout_for(id,bound_w,styles)
    ordered := s.sorted_visible_container_children(id)
    if ordered.len == 0 {
        $pw := cfg.padding.left + cfg.padding.right
        $ph := cfg.padding.top + cfg.padding.bottom
        if s.composition.items.has(id) {
            it := &s.composition.items[id]
            has_w := it.width >= 0.0 || (it.width_pct >= 0.0 && max_w < 100000.0)
            has_h := it.height >= 0.0 || (it.height_pct >= 0.0 && max_h < 100000.0)
            if it.width >= 0.0 { pw = it.width }
            else if it.width_pct >= 0.0 && max_w < 100000.0 { pw = max_w * it.width_pct }
            if it.height >= 0.0 { ph = it.height }
            else if it.height_pct >= 0.0 && max_h < 100000.0 { ph = max_h * it.height_pct }
            csz := apply_item_aspect_and_clamp(pw,ph,it.min_width,it.max_width,it.min_height,it.max_height,it.aspect_ratio,has_w,has_h)
            pw = csz.width
            ph = csz.height
        }
        if max_w < 100000.0 { pw = math.min(pw,max_w) }
        if max_h < 100000.0 { ph = math.min(ph,max_h) }
        << layout.Size{width: math.max(0.0,pw),height: math.max(0.0,ph)}
    }
    $tree := layout.tree()
    $rs := container_to_tree_root_style(&cfg)
    if s.composition.items.has(id) {
        it := &s.composition.items[id]
        if it.width >= 0.0 { rs.width = it.width }
        if it.height >= 0.0 { rs.height = it.height }
        rs.width_pct = it.width_pct
        rs.height_pct = it.height_pct
        rs.aspect_ratio = it.aspect_ratio
        rs.min_width = it.min_width
        rs.max_width = it.max_width
        rs.min_height = it.min_height
        rs.max_height = it.max_height
    }
    zero := layout.Size{width: 0.0,height: 0.0}
    root := tree.add(0,&rs,&zero) or >>
    $avail_w := bound_w
    if bound_w < 100000.0 { avail_w = math.max(0.0,bound_w - cfg.padding.left - cfg.padding.right) }
    $avail_h := max_h
    if s.composition.items.has(id) {
        it := &s.composition.items[id]
        if it.height >= 0.0 { avail_h = it.height }
        else if it.height_pct >= 0.0 && max_h < 100000.0 { avail_h = max_h * it.height_pct }
    }
    if avail_h < 100000.0 { avail_h = math.max(0.0,avail_h - cfg.padding.top - cfg.padding.bottom) }
    $track_ws := []f64{}
    if cfg.kind == LAYOUT_GRID && avail_w < 100000.0 {
        track_ws = layout.grid_track_widths(avail_w,cfg.columns,&cfg.col_weights,cfg.gap)
    }
    $base_cw := avail_w
    if cfg.kind == LAYOUT_ROW { base_cw = 100000.0 }
    $cur_col := 0
    for oi in 0:ordered.len {
        cid := ordered[oi]
        lim := s.container_grid_cell_limit(cid,&cfg,&track_ws,cur_col,base_cw,avail_h)
        $pct_w := avail_w
        if cfg.kind == LAYOUT_GRID { pct_w = lim.width }
        pack := s.measure_container_child_box(cid,lim.width,lim.height,pct_w,avail_h,styles) or >>
        _ := tree.add(root,&pack.cs,&pack.csz) or >>
        if cfg.kind == LAYOUT_GRID {
            $sp := 1
            if s.composition.items.has(cid) {
                sp = s.composition.items[cid].col_span
                if sp < 1 { sp = 1 }
                if sp > cfg.columns { sp = cfg.columns }
            }
            if cur_col > 0 && cur_col + sp > cfg.columns { cur_col = 0 }
            cur_col = cur_col + sp
        }
    }
    c_loose := layout.loose(max_w,max_h) or >>
    << tree.layout(&c_loose) or >>
}

fn (s $&Screen) measure_constrained(id int,max_w f64,max_h f64) layout.Size {
    if s.has_any_style_overrides() {
        scoped := s.styles_for(id)
        << s.measure_constrained_styled(id,max_w,max_h,&scoped) or >>
    }
    root := s.styles.clone()
    << s.measure_constrained_styled(id,max_w,max_h,&root) or >>
}

fn (s $&Screen) measure_constrained_styled(id int,max_w f64,max_h f64,inherited &Styles) layout.Size {
    n := s.node(id) or >>
    if !n.visible { << layout.Size{width: 0.0,height: 0.0} }
    if s.composition.measure_active && s.composition.measure_cache.has(id) {
        c := &s.composition.measure_cache[id]
        if c.gen == s.composition.measure_gen && c.max_w == max_w && c.max_h == max_h {
            << layout.Size{width: c.width,height: c.height}
        }
    }
    $out := layout.Size{width: 0.0,height: 0.0}
    if s.has_any_style_overrides() && (s.composition.subtree_styles.has(id) || s.composition.style_scopes.has(id)) {
        scoped := s.resolve_node_styles(id,inherited)
        out = s.measure_constrained_body(id,max_w,max_h,&scoped) or >>
    } else {
        out = s.measure_constrained_body(id,max_w,max_h,inherited) or >>
    }
    if s.composition.measure_active {
        comp := $&s.composition
        mc := $&comp.measure_cache
        mc[id] = CachedMeasure{gen: comp.measure_gen,max_w: max_w,max_h: max_h,width: out.width,height: out.height}
    }
    << out
}

fn (s $&Screen) measure_constrained_body(id int,max_w f64,max_h f64,styles &Styles) layout.Size {
    n := s.nodes[id - 1]
    if s.composition.containers.has(id) {
        raw := s.measure_container_natural_styled(id,max_w,max_h,styles) or >>
        << s.apply_layout_item_clamp(id,&raw)
    }
    if s.is_slot_host(id) {
        mounted := s.composition.slots.mounted.get_or(id,0)
        if mounted > 0 && mounted <= s.nodes.len && s.nodes[mounted - 1].kind >= 0 && s.nodes[mounted - 1].parent == id {
            raw := s.measure_constrained_styled(mounted,max_w,max_h,styles) or >>
            << s.apply_layout_item_clamp(id,&raw)
        }
        child_count := s.child_count_of(id)
        if child_count > 0 {
            $mw := 0.0
            $mh := 0.0
            for i in 0:child_count {
                cid := s.child_at_of(id,i)
                if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == id && s.is_visible(cid) {
                    csz := s.measure_constrained_styled(cid,max_w,max_h,styles) or >>
                    mw = math.max(mw,csz.width)
                    mh = math.max(mh,csz.height)
                }
            }
            raw := layout.Size{width: mw,height: mh}
            << s.apply_layout_item_clamp(id,&raw)
        }
    }
    if n.kind == SCREEN_CARD {
        if s.basics.scrolls.has(id) {
            $item := s.take_basic_sliders_or_scroll_measure(id,styles)
            << s.apply_layout_item_clamp(id,&item)
        }
        card_ref := &s.basics.cards[id]
        base := screen_measure_card(card_ref,styles)
        cstyle := card_ref.style_or(styles)
        pad_w := (cstyle.padding.left + cstyle.padding.right) * styles.density
        pad_h := (cstyle.padding.top + cstyle.padding.bottom) * styles.density
        inner_w := math.max(1.0,max_w - pad_w)
        $total_h := 0.0
        $max_cw := 0.0
        gap := 8.0 * styles.density
        $sections := 0
        if s.has_slot(id,SLOT_HEADER) || s.has_slot(id,SLOT_ACTIONS) {
            $hh := 0.0
            $hw := 0.0
            if s.has_slot(id,SLOT_HEADER) {
                sz := s.measure_constrained_styled(s.slot_of(id,SLOT_HEADER),inner_w,max_h,styles) or >>
                hh = math.max(hh,sz.height)
                hw += sz.width
            }
            if s.has_slot(id,SLOT_ACTIONS) {
                sz := s.measure_constrained_styled(s.slot_of(id,SLOT_ACTIONS),inner_w,max_h,styles) or >>
                hh = math.max(hh,sz.height)
                if hw > 0.0 { hw += gap }
                hw += sz.width
            }
            total_h += hh
            max_cw = math.max(max_cw,hw)
            sections += 1
        }
        for sk in [SLOT_MEDIA,SLOT_BODY,SLOT_FOOTER] {
            if s.has_slot(id,sk) {
                sz := s.measure_constrained_styled(s.slot_of(id,sk),inner_w,max_h,styles) or >>
                if sections > 0 { total_h += gap }
                total_h += sz.height
                max_cw = math.max(max_cw,sz.width)
                sections += 1
            }
        }
        if sections > 0 {
            raw := layout.Size{width: math.max(base.width,max_cw + pad_w),height: math.max(base.height,total_h + pad_h)}
            << s.apply_layout_item_clamp(id,&raw)
        }
        << s.apply_layout_item_clamp(id,&base)
    }
    leaf := s.measure_leaf_widget(id,max_w,max_h,styles) or >>
    << s.apply_layout_item_clamp(id,&leaf)
}

fn (s $&Screen) take_basic_sliders_or_scroll_measure(id int,styles &Styles) layout.Size {
    owner := $&s.basics
    scrolls := $&owner.scrolls
    $sc := scrolls.take(id)
    sz := screen_measure_scroll($&sc,styles)
    scrolls[id] = sc
    << sz
}

pub fn (s $&Screen) measure(id int) layout.Size {
    _ := s.node(id) or >>
    << s.measure_constrained(id,100000.0,100000.0) or >>
}

pub fn (s $&Screen) measure_in(id int,max_w f64,max_h f64) layout.Size {
    _ := s.node(id) or >>
    if !finite_metric(max_w,100000.0) || !finite_metric(max_h,100000.0) {
        >> errors.new("widgets: invalid measure bounds")
    }
    << s.measure_constrained(id,max_w,max_h) or >>
}

pub fn (s $&Screen) set_hit_test_enabled(id int,enabled bool) int {
    _ := s.node(id) or >>
    $val := -1
    if enabled { val = 1 }
    comp := $&s.composition
    hto := $&comp.hit_test_overrides
    had := hto.has(id)
    hto[id] = val
    if !had { comp.hit_test_override_count = comp.hit_test_override_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_hit_test_enabled(id int) int {
    _ := s.node(id) or >>
    if s.composition.hit_test_overrides.has(id) {
        comp := $&s.composition
        hto := $&comp.hit_test_overrides
        hto.delete(id)
        if comp.hit_test_override_count > 0 { comp.hit_test_override_count = comp.hit_test_override_count - 1 }
    }
    << 0
}

pub fn (s &Screen) is_hit_test_enabled(id int) bool {
    _ := s.node(id) or >>
    if s.composition.hit_test_override_count == 0 { << true }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.hit_test_overrides.has(cur) {
            << s.composition.hit_test_overrides[cur] > 0
        }
        n := s.nodes[cur - 1]
        if n.kind < 0 || n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << true
}

fn (s $&Screen) layout_container_children(id int) int {
    styles := s.styles_for(id)
    << s.layout_container_children_styled(id,&styles) or >>
}

fn (s $&Screen) layout_absolute_children_styled(parent int,avail_w f64,avail_h f64,styles &Styles) int {
    if s.composition.absolute_item_count == 0 { << 0 }
    child_count := s.child_count_of(parent)
    for i in 0:child_count {
        cid := s.child_at_of(parent,i)
        if cid <= 0 || cid > s.nodes.len { -> }
        cn := s.nodes[cid - 1]
        if cn.kind < 0 || cn.parent != parent || screen_is_overlay(cn.kind) || !s.is_visible(cid) { -> }
        if !s.composition.items.has(cid) || !s.composition.items[cid].absolute { -> }
        it := copy_layout_item(&s.composition.items[cid])
        has_l := (it.inset_mask & INSET_LEFT) != 0
        has_r := (it.inset_mask & INSET_RIGHT) != 0
        has_t := (it.inset_mask & INSET_TOP) != 0
        has_b := (it.inset_mask & INSET_BOTTOM) != 0
        $w := 0.0
        $fixed_w := false
        if it.width >= 0.0 {
            w = it.width
            fixed_w = true
        } else if it.width_pct >= 0.0 {
            w = math.max(0.0,avail_w * it.width_pct)
            fixed_w = true
        } else if has_l && has_r {
            w = math.max(0.0,avail_w - it.inset_left - it.inset_right)
            fixed_w = true
        }
        $h := 0.0
        $fixed_h := false
        if it.height >= 0.0 {
            h = it.height
            fixed_h = true
        } else if it.height_pct >= 0.0 {
            h = math.max(0.0,avail_h * it.height_pct)
            fixed_h = true
        } else if has_t && has_b {
            h = math.max(0.0,avail_h - it.inset_top - it.inset_bottom)
            fixed_h = true
        }
        if !fixed_w || !fixed_h {
            $mw_lim := math.max(0.0,avail_w)
            if fixed_w { mw_lim = w }
            else if it.max_width >= 0.0 { mw_lim = math.min(mw_lim,it.max_width) }
            $mh_lim := math.max(0.0,avail_h)
            if fixed_h { mh_lim = h }
            else if it.max_height >= 0.0 { mh_lim = math.min(mh_lim,it.max_height) }
            msz := s.measure_constrained_styled(cid,mw_lim,mh_lim,styles) or >>
            if !fixed_w { w = msz.width }
            if !fixed_h { h = msz.height }
        }
        sz := apply_item_aspect_and_clamp(w,h,it.min_width,it.max_width,it.min_height,it.max_height,it.aspect_ratio,fixed_w,fixed_h)
        w = sz.width
        h = sz.height
        $x := 0.0
        if has_l { x = it.inset_left }
        else if has_r { x = avail_w - it.inset_right - w }
        else if it.stack_align_x != -2.0 { x = (avail_w - w) * ((it.stack_align_x + 1.0) * 0.5) }
        $y := 0.0
        if has_t { y = it.inset_top }
        else if has_b { y = avail_h - it.inset_bottom - h }
        else if it.stack_align_y != -2.0 { y = (avail_h - h) * ((it.stack_align_y + 1.0) * 0.5) }
        s.nodes[cid - 1].local = layout.Rect{x: x,y: y,width: math.max(0.0,w),height: math.max(0.0,h)}
    }
    << 0
}

fn (s $&Screen) layout_container_children_styled(id int,styles &Styles) int {
    pb := s.nodes[id - 1].bounds
    $layout_w := pb.width
    $layout_h := pb.height
    if s.basics.scrolls.has(id) {
        sc_clip := s.scroll_content_clip(id)
        layout_w = sc_clip.width
        layout_h = sc_clip.height
    }
    ordered := s.sorted_visible_container_children(id)
    if ordered.len > 0 {
        cfg := s.resolve_container_layout_for(id,layout_w,styles)
        $tree := layout.tree()
        rs := container_to_tree_root_style(&cfg)
        zero := layout.Size{width: 0.0,height: 0.0}
        root := tree.add(0,&rs,&zero) or >>
        $vis_ids := []int{}
        $box_ids := []int{}
        $margins := []layout.Insets{}
        avail_w := math.max(0.0,layout_w - cfg.padding.left - cfg.padding.right)
        avail_h := math.max(0.0,layout_h - cfg.padding.top - cfg.padding.bottom)
        $track_ws := []f64{}
        if cfg.kind == LAYOUT_GRID {
            track_ws = layout.grid_track_widths(avail_w,cfg.columns,&cfg.col_weights,cfg.gap)
        }
        $base_cw := avail_w
        if cfg.kind == LAYOUT_ROW { base_cw = 100000.0 }
        $cur_col := 0
        for oi in 0:ordered.len {
            cid := ordered[oi]
            lim := s.container_grid_cell_limit(cid,&cfg,&track_ws,cur_col,base_cw,avail_h)
            $pct_w := avail_w
            if cfg.kind == LAYOUT_GRID { pct_w = lim.width }
            pack := s.measure_container_child_box(cid,lim.width,lim.height,pct_w,avail_h,styles) or >>
            bid := tree.add(root,&pack.cs,&pack.csz) or >>
            vis_ids.push(cid)
            box_ids.push(bid)
            margins.push(pack.margin)
            if cfg.kind == LAYOUT_GRID {
                $sp := 1
                if s.composition.items.has(cid) {
                    sp = s.composition.items[cid].col_span
                    if sp < 1 { sp = 1 }
                    if sp > cfg.columns { sp = cfg.columns }
                }
                if cur_col > 0 && cur_col + sp > cfg.columns { cur_col = 0 }
                cur_col = cur_col + sp
            }
        }
        if vis_ids.len > 0 {
            c_tight := layout.tight(layout_w,layout_h) or >>
            _ := tree.layout(&c_tight) or >>
            for i in 0:vis_ids.len {
                cid := vis_ids[i]
                bid := box_ids[i]
                m := margins[i]
                rect := tree.bounds(bid) or >>
                s.nodes[cid - 1].local = layout.Rect{
                    x: rect.x + m.left,
                    y: rect.y + m.top,
                    width: math.max(0.0,rect.width - m.left - m.right),
                    height: math.max(0.0,rect.height - m.top - m.bottom)
                }
            }
        }
    }
    if s.composition.absolute_item_count > 0 {
        s.layout_absolute_children_styled(id,layout_w,layout_h,styles) or >>
    }
    << 0
}

fn (s $&Screen) place_single_node(id int) int {
    styles := s.styles_for(id)
    << s.place_single_node_styled(id,&styles) or >>
}

fn (s $&Screen) place_single_node_styled(id int,styles &Styles) int {
    index := id - 1
    n := s.nodes[index]
    b := s.global_bounds(id) or >>
    s.nodes[index].bounds = b
    if n.kind == SCREEN_BUTTON {
        $control := s.take_button(id)
        control.set_enabled(s.effective_enabled(id))
        message := screen_place_button($&control,&b)
        s.buttons[id] = control
        if message.len > 0 { >> errors.new(message) }
    } else if n.kind == SCREEN_SELECTABLE_TEXT {
        enabled := s.effective_enabled(id)
        if enabled != n.inherited_enabled { s.nodes[index].inherited_enabled = enabled }
        s.selectable_text_enable(id,enabled) or >>
        s.selectable_text_place(id,&b) or >>
    } else if screen_is_control(n.kind) {
        inherited := s.effective_enabled(id)
        if inherited != n.inherited_enabled {
            s.control_enable(id,inherited) or >>
            s.nodes[index].inherited_enabled = inherited
        }
        eff := s.resolve_styles_with_patch(id,styles)
        s.control_place_styled(id,&b,&eff) or >>
        if screen_is_popup_capable_kind(n.kind) {
            popup := s.control_popup(id) or >>
            if popup.height > 0.0 {
                above := b.y + b.height + popup.height > s.height && b.y >= popup.height
                s.control_popup_above(id,above) or >>
            }
        }
    } else if n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id) {
        s.selectable_text_enable(id,s.effective_enabled(id)) or >>
        s.selectable_text_place(id,&b) or >>
    }
    << 0
}

fn (s $&Screen) layout_subtree(id int,inherited &Styles) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    n := s.nodes[id - 1]
    if n.kind < 0 { << 0 }
    if n.kind == SCREEN_BADGE && s.basics.badge_attachments.has(id) {
        // Attached badges are laid out in Pass 3 after anchor global bounds settle.
        << 0
    }
    if s.has_any_style_overrides() && (s.composition.subtree_styles.has(id) || s.composition.style_scopes.has(id)) {
        scoped := s.resolve_node_styles(id,inherited)
        << s.layout_subtree_with_styles(id,&scoped) or >>
    }
    << s.layout_subtree_with_styles(id,inherited) or >>
}

fn (s $&Screen) layout_subtree_with_styles(id int,styles &Styles) int {
    n := s.nodes[id - 1]
    s.place_single_node_styled(id,styles) or >>
    if n.kind == SCREEN_SPLIT_VIEW { s.layout_split_panes(id) or >> }
    if n.kind == SCREEN_TABS { s.layout_tabs_slots_styled(id,styles) or >> }
    if n.kind == SCREEN_CARD {
        if s.basics.card_sections.has(id) { s.layout_card_sections_for_styled(id,styles) or >> }
        if s.basics.scrolls.has(id) { s.layout_scroll_slot_styled(id,styles) or >> }
        else { s.layout_card_slots_styled(id,styles) or >> }
    }
    if n.kind == SCREEN_CUSTOM { s.layout_custom_slot_rects_styled(id,styles) or >> }
    if s.composition.containers.has(id) { s.layout_container_children_styled(id,styles) or >> }
    else if s.is_slot_host(id) {
        s.fit_mounted_child(id)
        if s.composition.absolute_item_count > 0 {
            pb := s.nodes[id - 1].bounds
            s.layout_absolute_children_styled(id,pb.width,pb.height,styles) or >>
        }
    } else if s.composition.absolute_item_count > 0 {
        pb := s.nodes[id - 1].bounds
        $aw := pb.width
        $ah := pb.height
        if s.basics.scrolls.has(id) {
            sc_clip := s.scroll_content_clip(id)
            aw = sc_clip.width
            ah = sc_clip.height
        }
        s.layout_absolute_children_styled(id,aw,ah,styles) or >>
    }
    child_count := s.child_count_of(id)
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id && !screen_is_overlay(s.nodes[cid - 1].kind) {
            s.layout_subtree(cid,styles) or >>
        }
    }
    // Re-sync scroll auto_extent after children have settled their final local bounds.
    if n.kind == SCREEN_CARD && s.basics.scrolls.has(id) && s.composition.auto_scrolls.get_or(id,false) {
        before_clip := s.scroll_content_clip(id)
        s.layout_scroll_slot_styled(id,styles) or >>
        after_clip := s.scroll_content_clip(id)
        if s.composition.containers.has(id) && (after_clip.width != before_clip.width || after_clip.height != before_clip.height) {
            s.layout_container_children_styled(id,styles) or >>
            for i in 0:child_count {
                cid := s.child_at_of(id,i)
                if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id && !screen_is_overlay(s.nodes[cid - 1].kind) {
                    s.layout_subtree(cid,styles) or >>
                }
            }
            s.layout_scroll_slot_styled(id,styles) or >>
        }
    }
    << 0
}

fn (s $&Screen) layout_overlay_slots_and_children(id int,inherited &Styles) int {
    if !s.composition.children_order.has(id) && !s.has_slot(id,SLOT_HEADER) && !s.has_slot(id,SLOT_BODY) && !s.has_slot(id,SLOT_CONTENT) && !s.has_slot(id,SLOT_FOOTER) && !s.has_slot(id,SLOT_ACTIONS) {
        << 0
    }
    if s.has_any_style_overrides() {
        scoped := s.styles_for(id)
        << s.layout_overlay_slots_with_styles(id,&scoped) or >>
    }
    << s.layout_overlay_slots_with_styles(id,inherited) or >>
}

fn (s $&Screen) layout_overlay_slots_with_styles(id int,styles &Styles) int {
    n := s.nodes[id - 1]
    if n.kind == SCREEN_MODAL { s.layout_modal_slots_styled(id,styles) or >> }
    else if n.kind == SCREEN_POPOVER { s.layout_popover_slots_styled(id,styles) or >> }
    child_count := s.child_count_of(id)
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id && !screen_is_overlay(s.nodes[cid - 1].kind) {
            s.layout_subtree(cid,styles) or >>
        }
    }
    << 0
}

fn try_layout_controls_tree_body(s $&Screen) string {
    s.layout_controls_tree_body() or (err) { << err.msg() }
    << ""
}

fn (s $&Screen) apply_root_viewport_bounds(rid int) {
    $rw := s.width
    $rh := s.height
    $lx := 0.0
    $ly := 0.0
    if s.composition.items.has(rid) {
        it := &s.composition.items[rid]
        lx = it.margin.left
        ly = it.margin.top
        avail_w := math.max(0.0,s.width - it.margin.left - it.margin.right)
        avail_h := math.max(0.0,s.height - it.margin.top - it.margin.bottom)
        rw = avail_w
        rh = avail_h
        if it.width >= 0.0 { rw = it.width }
        else if it.width_pct >= 0.0 { rw = avail_w * it.width_pct }
        if it.height >= 0.0 { rh = it.height }
        else if it.height_pct >= 0.0 { rh = avail_h * it.height_pct }
        fixed_w := it.width >= 0.0 || it.width_pct >= 0.0
        fixed_h := it.height >= 0.0 || it.height_pct >= 0.0
        sz := apply_item_aspect_and_clamp(rw,rh,it.min_width,it.max_width,it.min_height,it.max_height,it.aspect_ratio,fixed_w,fixed_h)
        rw = sz.width
        rh = sz.height
        if it.stack_align_x != -2.0 {
            lx = it.margin.left + math.max(0.0,avail_w - rw) * ((it.stack_align_x + 1.0) * 0.5)
        }
        if it.stack_align_y != -2.0 {
            ly = it.margin.top + math.max(0.0,avail_h - rh) * ((it.stack_align_y + 1.0) * 0.5)
        }
    }
    s.nodes[rid - 1].local = layout.Rect{x: lx,y: ly,width: math.max(0.0,rw),height: math.max(0.0,rh)}
}

fn (s $&Screen) layout_controls_tree_body() int {
    root_styles := s.styles.clone()
    if s.composition.root_id > 0 && s.composition.root_id <= s.nodes.len {
        rn := s.nodes[s.composition.root_id - 1]
        if rn.kind >= 0 && rn.parent == 0 && !screen_is_overlay(rn.kind) {
            s.apply_root_viewport_bounds(s.composition.root_id)
        }
    }
    // Pass 1: all non-overlay root subtrees top-down.
    root_count := s.child_count_of(0)
    for i in 0:root_count {
        rid := s.child_at_of(0,i)
        if rid > 0 && rid <= s.nodes.len && s.nodes[rid - 1].kind >= 0 && s.nodes[rid - 1].parent == 0 && !screen_is_overlay(s.nodes[rid - 1].kind) {
            s.layout_subtree(rid,&root_styles) or >>
        }
    }
    // Pass 2: overlays (excluding Tooltip which clamps against scrolled anchor clips last) + overlay content subtrees.
    ocount := s.composition.overlay_ids.len
    for i in 0:ocount {
        oid := s.composition.overlay_ids[i]
        if oid <= 0 || oid > s.nodes.len { -> }
        n := s.nodes[oid - 1]
        if n.kind >= 0 && screen_is_overlay(n.kind) && n.kind != SCREEN_TOOLTIP {
            s.overlay_place(oid) or >>
            s.layout_overlay_slots_and_children(oid,&root_styles) or >>
        }
    }
    // Pass 3: attached badges & tooltips using final anchor bounds + clips.
    if s.composition.attached_badge_ids.len > 0 {
        s.layout_badge_attachments_styled(&root_styles) or >>
        has_sub := s.has_any_style_overrides()
        for i in 0:s.composition.attached_badge_ids.len {
            bid := s.composition.attached_badge_ids[i]
            if bid <= 0 || bid > s.nodes.len { -> }
            n := s.nodes[bid - 1]
            if n.kind == SCREEN_BADGE && s.basics.badge_attachments.has(bid) {
                if has_sub {
                    st := s.styles_for(bid)
                    s.place_single_node_styled(bid,&st) or >>
                } else {
                    s.place_single_node_styled(bid,&root_styles) or >>
                }
            }
        }
    }
    if ocount > 0 {
        for i in 0:ocount {
            oid := s.composition.overlay_ids[i]
            if oid > 0 && oid <= s.nodes.len && s.nodes[oid - 1].kind == SCREEN_TOOLTIP {
                s.overlay_place(oid) or >>
            }
        }
        s.sync_tooltip_layers() or >>
    }
    << 0
}

fn (s $&Screen) begin_measure_pass() {
    comp := $&s.composition
    comp.measure_gen = comp.measure_gen + 1
    comp.measure_active = true
}

fn (s $&Screen) end_measure_pass() {
    comp := $&s.composition
    comp.measure_active = false
}

fn (s $&Screen) layout_controls_tree() int {
    s.begin_measure_pass()
    err_msg := try_layout_controls_tree_body(s)
    s.end_measure_pass()
    if err_msg.len > 0 { >> errors.new(err_msg) }
    << 0
}

fn (s $&Screen) paint_subtree(id int,frame $&draw.Frame,opacity f64,modal_id int,inherited &Styles) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    n := s.nodes[id - 1]
    if n.kind < 0 || screen_is_overlay(n.kind) || !s.is_visible(id) { << 0 }
    if s.composition.hidden_node_count > 0 && s.composition.hidden_nodes.has(id) { << 0 }
    if modal_id > 0 && id != modal_id && !s.is_descendant(id,modal_id) { << 0 }
    $eff_op := opacity
    if s.composition.opacities.has(id) {
        eff_op = math.max(0.0,math.min(1.0,opacity * s.composition.opacities[id]))
    }
    if eff_op <= 0.0 { << 0 }
    if s.has_any_style_overrides() && (s.composition.subtree_styles.has(id) || s.composition.style_scopes.has(id)) {
        scoped := s.resolve_node_styles(id,inherited)
        << s.paint_subtree_with_styles(id,frame,eff_op,modal_id,&scoped) or >>
    }
    << s.paint_subtree_with_styles(id,frame,eff_op,modal_id,inherited) or >>
}

fn (s &Screen) push_visual_transform(id int,frame $&draw.Frame) bool {
    if s.composition.visual_transform_count == 0 || !s.composition.visual_transforms.has(id) { << false }
    vt := &s.composition.visual_transforms[id]
    if vt.is_identity() { << false }
    b := s.nodes[id - 1].bounds
    frame.push() or >>
    if vt.offset_x != 0.0 || vt.offset_y != 0.0 { frame.translate(vt.offset_x,vt.offset_y) or >> }
    if vt.rotation != 0.0 || vt.scale_x != 1.0 || vt.scale_y != 1.0 {
        cx := b.x + b.width * vt.origin_x
        cy := b.y + b.height * vt.origin_y
        frame.translate(cx,cy) or >>
        if vt.rotation != 0.0 { frame.rotate(vt.rotation) or >> }
        if vt.scale_x != 1.0 || vt.scale_y != 1.0 { frame.scale(vt.scale_x,vt.scale_y) or >> }
        frame.translate(0.0 - cx,0.0 - cy) or >>
    }
    << true
}

fn (s &Screen) inverse_visual_point(id int,x f64,y f64) layout.Offset {
    if s.composition.visual_transform_count == 0 || !s.composition.visual_transforms.has(id) {
        << layout.Offset{x: x,y: y}
    }
    vt := &s.composition.visual_transforms[id]
    if vt.is_identity() { << layout.Offset{x: x,y: y} }
    $lx := x - vt.offset_x
    $ly := y - vt.offset_y
    if vt.rotation != 0.0 || vt.scale_x != 1.0 || vt.scale_y != 1.0 {
        b := s.nodes[id - 1].bounds
        cx := b.x + b.width * vt.origin_x
        cy := b.y + b.height * vt.origin_y
        $rx := lx - cx
        $ry := ly - cy
        if vt.rotation != 0.0 {
            rad := vt.rotation * 0.017453292519943295
            cs := math.cos(rad)
            sn := math.sin(rad)
            ux := rx * cs + ry * sn
            uy := (0.0 - rx) * sn + ry * cs
            rx = ux
            ry = uy
        }
        if vt.scale_x != 1.0 || vt.scale_y != 1.0 {
            rx = rx / vt.scale_x
            ry = ry / vt.scale_y
        }
        lx = cx + rx
        ly = cy + ry
    }
    << layout.Offset{x: lx,y: ly}
}

fn (s &Screen) node_chain_has_visual_transform(id int) bool {
    if s.composition.visual_transform_count == 0 || id <= 0 || id > s.nodes.len { << false }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.visual_transforms.has(cur) { << true }
        n := s.nodes[cur - 1]
        if n.kind < 0 || n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << false
}

fn (s &Screen) screen_to_node_point(id int,x f64,y f64) layout.Offset {
    if s.composition.visual_transform_count == 0 || id <= 0 || id > s.nodes.len {
        << layout.Offset{x: x,y: y}
    }
    $chain := []int{}
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        chain.push(cur)
        n := s.nodes[cur - 1]
        if n.kind < 0 || n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    $pt := layout.Offset{x: x,y: y}
    $i := chain.len - 1
    while i >= 0 {
        pt = s.inverse_visual_point(chain[i],pt.x,pt.y)
        i -= 1
    }
    << pt
}

fn screen_is_pointer_coord_event(kind int) bool {
    << kind == ui.EV_POINTER_DOWN || kind == ui.EV_POINTER_UP || kind == ui.EV_POINTER_MOVE || kind == ui.EV_POINTER_ENTER || kind == ui.EV_POINTER_LEAVE || kind == ui.EV_POINTER_SCROLL
}

fn (s &Screen) event_in_node_space(id int,event &ui.InputEvent) ui.InputEvent {
    if s.composition.visual_transform_count == 0 || !screen_is_pointer_coord_event(event.kind) {
        << ui.InputEvent{
            kind: event.kind,window_id: event.window_id,canvas_id: event.canvas_id,generation: event.generation,
            x: event.x,y: event.y,dx: event.dx,dy: event.dy,button: event.button,buttons: event.buttons,
            modifiers: event.modifiers,key: event.key,scan: event.scan,repeat: event.repeat,click_count: event.click_count,time_ns: event.time_ns
        }
    }
    pt := s.screen_to_node_point(id,event.x,event.y)
    << ui.InputEvent{
        kind: event.kind,window_id: event.window_id,canvas_id: event.canvas_id,generation: event.generation,
        x: pt.x,y: pt.y,dx: event.dx,dy: event.dy,button: event.button,buttons: event.buttons,
        modifiers: event.modifiers,key: event.key,scan: event.scan,repeat: event.repeat,click_count: event.click_count,time_ns: event.time_ns
    }
}

fn (s $&Screen) paint_node_transformed_clipped(id int,frame $&draw.Frame,opacity f64,styles &Styles) int {
    s.paint_node_content_styled(id,frame,opacity,styles) or (err) { >> errors.new("widgets: paint node " + str(id) + ": " + err.msg()) }
    << 0
}

fn (s &Screen) local_container_clip_rect(id int) layout.Rect {
    if s.basics.scrolls.has(id) { << s.scroll_content_clip(id) }
    b := s.nodes[id - 1].bounds
    << layout.Rect{x: b.x,y: b.y,width: b.width,height: b.height}
}

fn (s $&Screen) paint_subtree_with_styles(id int,frame $&draw.Frame,opacity f64,modal_id int,styles &Styles) int {
    n := s.nodes[id - 1]
    has_own_vt := s.composition.visual_transform_count > 0 && s.composition.visual_transforms.has(id)
    parent_in_vt := n.parent > 0 && s.node_chain_has_visual_transform(n.parent)
    in_vt := has_own_vt || parent_in_vt
    if !in_vt && (s.basics.scrolls.has(id) || s.controls.split_panes.has(id) || s.container_is_clipped(id)) {
        clip := s.child_clip(id) or >>
        vis := screen_clip_intersection(&n.bounds,&clip)
        if vis.width <= 0.0 || vis.height <= 0.0 { << 0 }
    }
    $outer_clip_pushed := false
    if has_own_vt && !parent_in_vt {
        clip := s.child_clip(id) or >>
        if clip.width <= 0.0 || clip.height <= 0.0 { << 0 }
        frame.push() or >>
        frame.clip_rect(clip.x,clip.y,clip.width,clip.height) or >>
        outer_clip_pushed = true
    }
    vt_pushed := s.push_visual_transform(id,frame) or >>
    paint_self := n.kind >= SCREEN_LABEL || (n.kind == SCREEN_GROUP && s.composition.control_patches.has(id))
    if paint_self {
        if in_vt {
            s.paint_node_transformed_clipped(id,frame,opacity,styles) or >>
        } else {
            s.paint_node_styled(id,frame,opacity,styles) or (err) { >> errors.new("widgets: paint node " + str(id) + ": " + err.msg()) }
        }
    }
    $inner_clip_pushed := false
    if in_vt && (s.basics.scrolls.has(id) || s.controls.split_panes.has(id) || s.container_is_clipped(id)) {
        ic := s.local_container_clip_rect(id)
        if ic.width <= 0.0 || ic.height <= 0.0 {
            if vt_pushed { frame.pop() or >> }
            if outer_clip_pushed { frame.pop() or >> }
            << 0
        }
        frame.push() or >>
        frame.clip_rect(ic.x,ic.y,ic.width,ic.height) or >>
        inner_clip_pushed = true
    }
    if s.has_custom_stacking() {
        kids := s.z_ordered_children(id)
        for i in 0:kids.len {
            cid := kids[i]
            s.paint_subtree(cid,frame,opacity,modal_id,styles) or >>
        }
    } else {
        child_count := s.child_count_of(id)
        for i in 0:child_count {
            cid := s.child_at_of(id,i)
            if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id {
                s.paint_subtree(cid,frame,opacity,modal_id,styles) or >>
            }
        }
    }
    if inner_clip_pushed { frame.pop() or >> }
    if vt_pushed { frame.pop() or >> }
    if outer_clip_pushed { frame.pop() or >> }
    << 0
}

fn (s $&Screen) paint_overlay_children(parent int,frame $&draw.Frame,styles &Styles,opacity f64) int {
    parent_in_vt := s.node_chain_has_visual_transform(parent)
    $kids := []int{}
    if s.has_custom_stacking() {
        kids = s.z_ordered_children(parent)
    } else {
        child_count := s.child_count_of(parent)
        for i in 0:child_count {
            cid := s.child_at_of(parent,i)
            if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == parent {
                kids.push(cid)
            }
        }
    }
    for i in 0:kids.len {
        cid := kids[i]
        n := s.nodes[cid - 1]
        if screen_is_overlay(n.kind) || !s.is_visible(cid) { -> }
        if s.composition.hidden_node_count > 0 && s.composition.hidden_nodes.has(cid) { -> }
        $eff_op := opacity
        if s.composition.opacities.has(cid) {
            eff_op = math.max(0.0,math.min(1.0,opacity * s.composition.opacities[cid]))
        }
        if eff_op <= 0.0 { -> }
        has_own_vt := s.composition.visual_transform_count > 0 && s.composition.visual_transforms.has(cid)
        in_vt := has_own_vt || parent_in_vt
        $outer_clip_pushed := false
        if has_own_vt && !parent_in_vt {
            clip := s.child_clip(cid) or >>
            if clip.width <= 0.0 || clip.height <= 0.0 { -> }
            frame.push() or >>
            frame.clip_rect(clip.x,clip.y,clip.width,clip.height) or >>
            outer_clip_pushed = true
        }
        vt_pushed := s.push_visual_transform(cid,frame) or >>
        paint_self := n.kind >= SCREEN_LABEL || (n.kind == SCREEN_GROUP && s.composition.control_patches.has(cid))
        $inner_clip_pushed := false
        $skip_kids := false
        if in_vt && (s.basics.scrolls.has(cid) || s.controls.split_panes.has(cid) || s.container_is_clipped(cid)) {
            ic := s.local_container_clip_rect(cid)
            if ic.width <= 0.0 || ic.height <= 0.0 {
                skip_kids = true
            } else {
                frame.push() or >>
                frame.clip_rect(ic.x,ic.y,ic.width,ic.height) or >>
                inner_clip_pushed = true
            }
        }
        if s.has_any_style_overrides() && (s.composition.subtree_styles.has(cid) || s.composition.style_scopes.has(cid)) {
            scoped := s.resolve_node_styles(cid,styles)
            if paint_self {
                if in_vt { s.paint_node_transformed_clipped(cid,frame,eff_op,&scoped) or >> }
                else { s.paint_node_styled(cid,frame,eff_op,&scoped) or (err) { >> errors.new("widgets: paint node " + str(cid) + ": " + err.msg()) } }
            }
            if !skip_kids { s.paint_overlay_children(cid,frame,&scoped,eff_op) or >> }
        } else {
            if paint_self {
                if in_vt { s.paint_node_transformed_clipped(cid,frame,eff_op,styles) or >> }
                else { s.paint_node_styled(cid,frame,eff_op,styles) or (err) { >> errors.new("widgets: paint node " + str(cid) + ": " + err.msg()) } }
            }
            if !skip_kids { s.paint_overlay_children(cid,frame,styles,eff_op) or >> }
        }
        if inner_clip_pushed { frame.pop() or >> }
        if vt_pushed { frame.pop() or >> }
        if outer_clip_pushed { frame.pop() or >> }
    }
    << 0
}

fn (s $&Screen) paint_overlay_child_popups(parent int,frame $&draw.Frame,styles &Styles) int {
    child_count := s.child_count_of(parent)
    for i in 0:child_count {
        cid := s.child_at_of(parent,i)
        if cid <= 0 || cid > s.nodes.len { -> }
        n := s.nodes[cid - 1]
        if n.kind < 0 || n.parent != parent || screen_is_overlay(n.kind) || !s.is_visible(cid) { -> }
        if s.has_any_style_overrides() && (s.composition.subtree_styles.has(cid) || s.composition.style_scopes.has(cid)) {
            scoped := s.resolve_node_styles(cid,styles)
            if screen_is_popup_capable_kind(n.kind) || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(cid)) {
                eff := s.resolve_styles_with_patch(cid,&scoped)
                s.control_paint(cid,frame,&eff,true) or >>
            }
            s.paint_overlay_child_popups(cid,frame,&scoped) or >>
        } else {
            if screen_is_popup_capable_kind(n.kind) || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(cid)) {
                eff := s.resolve_styles_with_patch(cid,styles)
                s.control_paint(cid,frame,&eff,true) or >>
            }
            s.paint_overlay_child_popups(cid,frame,styles) or >>
        }
    }
    << 0
}

fn (s $&Screen) paint_subtree_popups(id int,frame $&draw.Frame,styles &Styles,modal_id int) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    n := s.nodes[id - 1]
    if n.kind < 0 || screen_is_overlay(n.kind) || !s.is_visible(id) { << 0 }
    if s.composition.hidden_node_count > 0 && s.composition.hidden_nodes.has(id) { << 0 }
    if modal_id > 0 && id != modal_id && !s.is_descendant(id,modal_id) { << 0 }
    if s.composition.opacity_count > 0 && (s.effective_opacity(id) or >>) <= 0.0 { << 0 }
    if s.has_any_style_overrides() && (s.composition.subtree_styles.has(id) || s.composition.style_scopes.has(id)) {
        scoped := s.resolve_node_styles(id,styles)
        << s.paint_subtree_popups_with_styles(id,frame,&scoped,modal_id) or >>
    }
    << s.paint_subtree_popups_with_styles(id,frame,styles,modal_id) or >>
}

fn (s $&Screen) paint_subtree_popups_with_styles(id int,frame $&draw.Frame,styles &Styles,modal_id int) int {
    n := s.nodes[id - 1]
    if screen_is_popup_capable_kind(n.kind) || n.kind == SCREEN_CUSTOM || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id)) {
        eff := s.resolve_styles_with_patch(id,styles)
        s.control_paint(id,frame,&eff,true) or >>
    }
    child_count := s.child_count_of(id)
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id {
            s.paint_subtree_popups(cid,frame,styles,modal_id) or >>
        }
    }
    << 0
}

fn (s $&Screen) hit_subtree(id int,in_x f64,in_y f64,modal int,surface int) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    n := s.nodes[id - 1]
    if n.kind < 0 || !n.visible { << 0 }
    if s.composition.hidden_node_count > 0 && s.composition.hidden_nodes.has(id) { << 0 }
    if (s.composition.opacity_transition_ids.len > 0 || s.composition.transform_transition_ids.len > 0) && s.is_node_exiting(id) { << 0 }
    if (n.kind == SCREEN_POPOVER || n.kind == SCREEN_MODAL) && !s.overlay_is_visible(id) { << 0 }
    if s.controls.split_panes.has(id) && (n.bounds.width <= 0.0 || n.bounds.height <= 0.0) { << 0 }
    pt := s.inverse_visual_point(id,in_x,in_y)
    x := pt.x
    y := pt.y
    is_scroll := s.basics.scrolls.has(id)
    is_clipped_box := s.controls.split_panes.has(id) || s.container_is_clipped(id) || screen_is_overlay(n.kind)
    if (is_scroll || is_clipped_box) && !n.bounds.contains(x,y) { << 0 }
    $descend := true
    if is_scroll && !s.scroll_content_clip(id).contains(x,y) { descend = false }
    // Reverse paint order: check descendants first so children always take hits over parents.
    if descend {
        if s.has_custom_stacking() {
            z_kids := s.z_ordered_children(id)
            $k := z_kids.len - 1
            while k >= 0 {
                cid := z_kids[k]
                if !screen_is_overlay(s.nodes[cid - 1].kind) {
                    found := s.hit_subtree(cid,x,y,modal,surface) or >>
                    if found > 0 { << found }
                }
                k -= 1
            }
        } else {
            child_count := s.child_count_of(id)
            $k := child_count - 1
            while k >= 0 {
                cid := s.child_at_of(id,k)
                if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id && !screen_is_overlay(s.nodes[cid - 1].kind) {
                    found := s.hit_subtree(cid,x,y,modal,surface) or >>
                    if found > 0 { << found }
                }
                k -= 1
            }
        }
    }
    if screen_is_overlay(n.kind) { << 0 }
    is_hit_kind := (n.kind >= SCREEN_BUTTON && n.kind < SCREEN_POPOVER) || n.kind == SCREEN_SELECTABLE_TEXT || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id)) || n.kind == SCREEN_CUSTOM
    if !is_hit_kind { << 0 }
    wants_hit := n.focusable || (n.kind == SCREEN_CUSTOM && s.custom_wants_input(id))
    if !wants_hit || !s.effective_enabled(id) || !(s.is_hit_test_enabled(id) or >>) || !s.is_visible(id) || !s.in_modal(id,modal) { << 0 }
    if surface != 0 && !s.is_descendant(id,surface) { << 0 }
    if !n.bounds.contains(x,y) { << 0 }
    if !s.node_chain_has_visual_transform(id) {
        clip := s.child_clip(id) or >>
        if !clip.contains(x,y) { << 0 }
    }
    if n.kind == SCREEN_SPLIT_VIEW && !s.split_handle(id).contains(x,y) { << 0 }
    if n.kind == SCREEN_TABS && s.has_indexed_slots(id) && !s.tabs_bar_bounds(id).contains(x,y) { << 0 }
    << id
}

fn (s $&Screen) dispose_composition() {
    comp := $&s.composition
    comp.customs = map[int]ScreenCustomEntry{}
    comp.slots = new_screen_slots()
    comp.containers = map[int]ContainerLayout{}
    comp.items = map[int]LayoutItem{}
    comp.children_order = map[int][]int{}
    comp.subtree_styles = map[int]int{}
    comp.subtree_style_values = []Styles{}
    comp.subtree_style_free = []int{}
    comp.subtree_style_count = 0
    comp.style_scopes = map[int]int{}
    comp.style_scope_values = []StyleDelta{}
    comp.style_scope_free = []int{}
    comp.style_scope_count = 0
    comp.control_patches = map[int]int{}
    comp.control_patch_values = []ControlStylePatch{}
    comp.control_patch_free = []int{}
    comp.opacities = map[int]f64{}
    comp.opacity_count = 0
    comp.subtree_locales = map[int]Locale{}
    comp.subtree_locale_count = 0
    comp.visual_transforms = map[int]VisualTransform{}
    comp.visual_transform_count = 0
    comp.default_motion = motion_spec()
    comp.has_default_motion = false
    comp.subtree_motions = map[int]MotionSpec{}
    comp.subtree_motion_count = 0
    comp.explicit_motions = map[int]bool{}
    comp.animations = map[int]AnimationController{}
    comp.animation_ids = []int{}
    comp.next_anim_id = 0
    comp.springs = map[int]Spring{}
    comp.spring_ids = []int{}
    comp.next_spring_id = 0
    comp.hit_test_overrides = map[int]int{}
    comp.hit_test_override_count = 0
    comp.z_indices = map[int]int{}
    comp.z_index_count = 0
    comp.absolute_item_count = 0
    comp.sticky_item_count = 0
    comp.opacity_transitions = map[int]NodeOpacityTransition{}
    comp.opacity_transition_ids = []int{}
    comp.transform_transitions = map[int]NodeTransformTransition{}
    comp.transform_transition_ids = []int{}
    comp.hidden_nodes = map[int]bool{}
    comp.hidden_node_count = 0
    comp.auto_scrolls = map[int]bool{}
    comp.measure_cache = map[int]CachedMeasure{}
    comp.live_ids = []int{}
    comp.button_ids = []int{}
    comp.menu_ids = []int{}
    comp.text_input_ids = []int{}
    comp.overlay_ids = []int{}
    comp.attached_badge_ids = []int{}
    comp.popup_capable_ids = []int{}
    comp.webview_ids = []int{}
    comp.node_keys = map[string]int{}
    comp.key_by_node = map[int]string{}
    comp.measure_gen = 0
    comp.measure_active = false
    comp.layout_dirty = true
    comp.known_dirty = true
    comp.layout_pass_count = 0
    comp.root_id = 0
    comp.live_nodes = 0
}
