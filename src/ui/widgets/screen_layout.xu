    _ := s.node(id) or >>
    $it := s.copy_or_default_layout_item(id)
    it.order = order
    << s.set_layout_item(id,&it) or >>
}

pub fn (s $&Screen) set_stack_align(id int,align_x f64,align_y f64) int {
    _ := s.node(id) or >>
    $it := s.copy_or_default_layout_item(id)
    it.stack_align_x = align_x
    it.stack_align_y = align_y
    << s.set_layout_item(id,&it) or >>
}

pub fn (s &Screen) container_layout(id int) ContainerLayout {
    _ := s.node(id) or >>
    if !s.composition.containers.has(id) { << container_layout(LAYOUT_NONE) }
    << copy_container_layout(&s.composition.containers[id])
}

pub fn (s $&Screen) clear_container_layout(id int) int {
    _ := s.node(id) or >>
    if s.composition.containers.has(id) {
        comp := $&s.composition
        cs := $&comp.containers
        cs.delete(id)
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s $&Screen) clear_layout_item(id int) int {
    _ := s.node(id) or >>
    if s.composition.items.has(id) {
        s.sync_item_absolute(id,false)
        s.sync_item_sticky(id,false)
        comp := $&s.composition
        its := $&comp.items
        its.delete(id)
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s $&Screen) set_item_absolute(id int,absolute bool) int {
    _ := s.node(id) or >>
    $it := s.copy_or_default_layout_item(id)
    it.absolute = absolute
    << s.set_layout_item(id,&it) or >>
}

pub fn (s $&Screen) set_item_insets(id int,mask int,left f64,top f64,right f64,bottom f64) int {
    _ := s.node(id) or >>
    $it := s.copy_or_default_layout_item(id)
    it.inset_mask = mask
    it.inset_left = left
    it.inset_top = top
    it.inset_right = right
    it.inset_bottom = bottom
    << s.set_layout_item(id,&it) or >>
}

pub fn (s $&Screen) pin_item(id int,mask int,left f64,top f64,right f64,bottom f64) int {
    _ := s.node(id) or >>
    $it := s.copy_or_default_layout_item(id)
    it.absolute = true
    it.inset_mask = mask
    it.inset_left = left
    it.inset_top = top
    it.inset_right = right
    it.inset_bottom = bottom
    << s.set_layout_item(id,&it) or >>
}

pub fn (s $&Screen) set_z_index(id int,z int) int {
    _ := s.node(id) or >>
    if z < -1000000 || z > 1000000 { >> errors.new("widgets: invalid z-index") }
    had := s.composition.z_indices.has(id)
    prev := s.composition.z_indices.get_or(id,0)
    if z == 0 {
        if had {
            comp := $&s.composition
            zs := $&comp.z_indices
            zs.delete(id)
            if comp.z_index_count > 0 { comp.z_index_count = comp.z_index_count - 1 }
            s.mark_paint_dirty()
        }
        << 0
    }
    comp := $&s.composition
    zs := $&comp.z_indices
    zs[id] = z
    if !had { comp.z_index_count = comp.z_index_count + 1 }
    if prev != z { s.mark_paint_dirty() }
    << 0
}

pub fn (s &Screen) z_index(id int) int {
    _ := s.node(id) or >>
    << s.composition.z_indices.get_or(id,0)
}

pub fn (s $&Screen) set_visibility(id int,mode int) int {
    _ := s.node(id) or >>
    if mode < VISIBILITY_VISIBLE || mode > VISIBILITY_COLLAPSED {
        >> errors.new("widgets: invalid visibility mode")
    }
    if mode == VISIBILITY_COLLAPSED {
        if s.composition.hidden_nodes.has(id) {
            comp := $&s.composition
            hn := $&comp.hidden_nodes
            hn.delete(id)
            if comp.hidden_node_count > 0 { comp.hidden_node_count = comp.hidden_node_count - 1 }
        }
        << s.set_visible(id,false) or >>
    }
    if mode == VISIBILITY_VISIBLE {
        << s.set_visible(id,true) or >>
    }
    s.set_visible(id,true) or >>
    if !s.composition.hidden_nodes.has(id) {
        event := s.cancellation()
        s.cancel_subtree_input(id,&event) or >>
        if s.is_descendant(s.focused,id) { s.focused = 0 }
        if s.is_descendant(s.captured,id) { s.captured = 0 }
        if s.is_descendant(s.hovered,id) {
            s.hovered = 0
            s.pointer_cursor(ui.CURSOR_DEFAULT) or >>
        }
        comp := $&s.composition
        hn := $&comp.hidden_nodes
        hn[id] = true
        comp.hidden_node_count = comp.hidden_node_count + 1
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) visibility(id int) int {
    n := s.node(id) or >>
    if !n.visible { << VISIBILITY_COLLAPSED }
    if s.composition.hidden_node_count > 0 && s.composition.hidden_nodes.has(id) { << VISIBILITY_HIDDEN }
    << VISIBILITY_VISIBLE
}

fn (s &Screen) is_layout_hidden(id int) bool {
    if s.composition.hidden_node_count == 0 { << false }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.hidden_nodes.has(cur) { << true }
        n := s.nodes[cur - 1]
        if n.kind < 0 || n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << false
}

pub fn (s $&Screen) set_scroll_auto_extent(id int,enabled bool) int {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    comp := $&s.composition
    auto_map := $&comp.auto_scrolls
    if enabled { auto_map[id] = true }
    else if auto_map.has(id) { auto_map.delete(id) }
    s.mark_layout_dirty()
    << 0
}

pub fn (s &Screen) parent(id int) int {
    node := s.node(id) or >>
    << node.parent
}

pub fn (s &Screen) children(id int) []int {
    if id != 0 { _ := s.node(id) or >> }
    $out := []int{}
    if !s.composition.children_order.has(id) { << out }
    list := &s.composition.children_order[id]
    for i in 0:list.len {
        cid := list[i]
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == id {
            out.push(cid)
        }
    }
    << out
}

pub fn (s $&Screen) set_subtree_styles(id int,styles &Styles) int {
    _ := s.node(id) or >>
    styles.validate() or >>
    if s.composition.subtree_styles.has(id) {
        idx := s.composition.subtree_styles[id] - 1
        comp := $&s.composition
        comp.subtree_style_values[idx] = styles.clone()
    } else if s.composition.subtree_style_free.len > 0 {
        comp := $&s.composition
        flen := comp.subtree_style_free.len
        idx := comp.subtree_style_free[flen - 1]
        if flen <= 1 { comp.subtree_style_free = []int{} }
        else { comp.subtree_style_free = comp.subtree_style_free[0:flen - 1] }
        comp.subtree_style_values[idx] = styles.clone()
        scopes := $&comp.subtree_styles
        scopes[id] = idx + 1
        comp.subtree_style_count = comp.subtree_style_count + 1
    } else {
        comp := $&s.composition
        idx := comp.subtree_style_values.len
        vals := $&comp.subtree_style_values
        vals.push(styles.clone())
        scopes := $&comp.subtree_styles
        scopes[id] = idx + 1
        comp.subtree_style_count = comp.subtree_style_count + 1
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_subtree_styles(id int) int {
    _ := s.node(id) or >>
    if s.composition.subtree_styles.has(id) {
        comp := $&s.composition
        scopes := $&comp.subtree_styles
        old_slot := scopes.take(id)
        if old_slot > 0 {
            free := $&comp.subtree_style_free
            free.push(old_slot - 1)
        }
        if comp.subtree_style_count > 0 { comp.subtree_style_count = comp.subtree_style_count - 1 }
        s.mark_layout_dirty()
    }
    << 0
}

fn (s &Screen) style_index_for(id int) int {
    if s.composition.subtree_style_count == 0 || id <= 0 || id > s.nodes.len {
        << -1
    }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.subtree_styles.has(cur) {
            << s.composition.subtree_styles[cur] - 1
        }
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        if n.parent > 0 { cur = n.parent }
        else if screen_is_overlay(n.kind) {
            anc := s.overlays.anchors.get_or(cur,0)
            if anc == cur { cur = 0 } else { cur = anc }
        } else { cur = 0 }
        budget -= 1
    }
    << -1
}

pub fn (s &Screen) styles_for(id int) Styles {
    if !s.has_any_style_overrides() || id <= 0 || id > s.nodes.len {
        << s.styles.clone()
    }
    $chain := []int{}
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        chain.push(cur)
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        if n.parent > 0 {
            cur = n.parent
        } else if screen_is_overlay(n.kind) {
            anc := s.overlays.anchors.get_or(cur,0)
            if anc == cur { cur = 0 } else { cur = anc }
        } else {
            cur = 0
        }
        budget -= 1
    }
    $res := s.styles.clone()
    $k := chain.len - 1
    while k >= 0 {
        res = s.resolve_node_styles(chain[k],&res)
        k -= 1
    }
    << res
}

fn (s &Screen) collect_subtree_postorder(id int,out $&[]int) {
    kids := s.children(id) or (err) { << }
    for c in kids { s.collect_subtree_postorder(c,out) }
    out.push(id)
}

fn try_dispose_overlay(s $&Screen,id int) { s.overlay_dispose(id) or (err) { << } }
fn try_dispose_control(s $&Screen,id int) { s.control_dispose(id) or (err) { << } }
fn try_dispose_image(img $&draw.Image) { img.dispose() or (err) { << } }
fn try_cancel_route(s $&Screen,id int,ev &ui.InputEvent) { _ := s.route_node(id,ROUTE_CANCEL,ev) or (err) { << } }

fn try_close_overlay_quiet(s $&Screen,id int) { _ := s.close_overlay(id) or (err) { << } }

fn (s $&Screen) remove_node_resources(id int) int {
    n := s.nodes[id - 1]
    kind := n.kind
    parent := n.parent
    if kind < 0 { << 0 }
    if s.composition.overlay_ids.len > 0 {
        ocount := s.composition.overlay_ids.len
        for oi in 0:ocount {
            oid := s.composition.overlay_ids[oi]
            if oid > 0 && oid != id && oid <= s.nodes.len && s.nodes[oid - 1].kind >= 0 && s.overlays.anchors.get_or(oid,0) == id {
                ov := $&s.overlays
                anch := $&ov.anchors
                anch[oid] = 0
                try_close_overlay_quiet(s,oid)
            }
        }
    }
    if kind == SCREEN_BUTTON {
        if s.buttons.has(id) { _ := s.take_button(id) }
        if s.button_variants.has(id) { bvs := $&s.button_variants
            bvs.delete(id) }
        if s.button_transitions.has(id) { bts := $&s.button_transitions
            bts.delete(id) }
    } else if kind == SCREEN_CUSTOM {
        s.custom_dispose(id)
    } else if kind == SCREEN_SELECTABLE_TEXT {
        s.dispose_selectable_slot(id)
    } else if screen_is_overlay(kind) {
        try_dispose_overlay(s,id)
    } else if screen_is_control(kind) {
        try_dispose_control(s,id)
    }
    s.dispose_selectable_slot(id)
    s.dispose_selectable_slot(-id)
    for sec in 0:2 {
        lkey := id * 2 + sec
        if s.labels.has(lkey) { $c := s.take_label_cache(lkey)
            c.dispose() }
    }
    basic := $&s.basics
    icons := $&basic.button_icons
    if icons.has(id) { $img := icons.take(id)
        try_dispose_image($&img) }
    if basic.button_icon_labels.has(id) { bil := $&basic.button_icon_labels
        bil.delete(id) }
    if basic.ellipsis_labels.has(id) { el := $&basic.ellipsis_labels
        $lbl := el.take(id)
        lbl.dispose() }
    if basic.wrapped_labels.has(id) { wl := $&basic.wrapped_labels
        wl.delete(id) }
    if basic.label_styles.has(id) { ls := $&basic.label_styles
        ls.delete(id) }
    if basic.badge_attachments.has(id) { ba := $&basic.badge_attachments
        ba.delete(id) }
    if basic.badge_counts.has(id) { bc := $&basic.badge_counts
        bc.delete(id) }
    if basic.card_sections.has(id) { cs := $&basic.card_sections
        cs.delete(id) }
    // Clean up split_panes back-link on both pane node and owning SplitView.
    if s.controls.split_panes.has(id) {
        ctrls := $&s.controls
        panes := $&ctrls.split_panes
        split_id := panes.take(id)
        splits := $&ctrls.splits
        if splits.has(split_id) {
            $sp := splits.take(split_id)
            if sp.first_id == id { sp.first_id = 0 }
            if sp.second_id == id { sp.second_id = 0 }
            splits[split_id] = sp
        }
    }
    if basic.counts.len >= id && basic.counts[id - 1] > 0 {
        cnt := basic.counts[id - 1]
        for idx in 0:cnt {
            bkey := id * 1024 + idx
            if basic.labels.has(bkey) { bls := $&basic.labels
                $lbl := bls.take(bkey)
                lbl.dispose() }
            if basic.secondary.has(bkey) { bsec := $&basic.secondary
                $lbl := bsec.take(bkey)
                lbl.dispose() }
            if basic.details.has(bkey) { bdet := $&basic.details
                $lbl := bdet.take(bkey)
                lbl.dispose() }
            if basic.list_icons.has(bkey) { bli := $&basic.list_icons
                bli.delete(bkey) }
        }
        basic.counts[id - 1] = 0
    }
    s.unregister_node_categories(id,kind)
    s.clear_node_key_internal(id)
    s.cleanup_slot_bindings_for(id)
    comp := $&s.composition
    if comp.containers.has(id) { cs := $&comp.containers
        cs.delete(id) }
    if comp.items.has(id) {
        if comp.items[id].absolute && comp.absolute_item_count > 0 {
            comp.absolute_item_count = comp.absolute_item_count - 1
        }
        if comp.items[id].sticky && comp.sticky_item_count > 0 {
            comp.sticky_item_count = comp.sticky_item_count - 1
        }
        its := $&comp.items
        its.delete(id)
    }
    if comp.subtree_styles.has(id) {
        ss := $&comp.subtree_styles
        old_slot := ss.take(id)
        if old_slot > 0 {
            free := $&comp.subtree_style_free
            free.push(old_slot - 1)
        }
        if comp.subtree_style_count > 0 { comp.subtree_style_count = comp.subtree_style_count - 1 }
    }
    if comp.style_scopes.has(id) {
        scp := $&comp.style_scopes
        old_slot := scp.take(id)
        if old_slot > 0 {
            free := $&comp.style_scope_free
            free.push(old_slot - 1)
        }
        if comp.style_scope_count > 0 { comp.style_scope_count = comp.style_scope_count - 1 }
    }
    if comp.control_patches.has(id) {
        cp := $&comp.control_patches
        old_slot := cp.take(id)
        if old_slot > 0 {
            free := $&comp.control_patch_free
            free.push(old_slot - 1)
        }
    }
    if comp.opacities.has(id) { ops := $&comp.opacities
        ops.delete(id)
        if comp.opacity_count > 0 { comp.opacity_count = comp.opacity_count - 1 } }
    if comp.subtree_locales.has(id) { sls := $&comp.subtree_locales
        sls.delete(id)
        if comp.subtree_locale_count > 0 { comp.subtree_locale_count = comp.subtree_locale_count - 1 } }
    if comp.visual_transforms.has(id) { vts := $&comp.visual_transforms
        vts.delete(id)
        if comp.visual_transform_count > 0 { comp.visual_transform_count = comp.visual_transform_count - 1 } }
    if comp.subtree_motions.has(id) { sms := $&comp.subtree_motions
        sms.delete(id)
        if comp.subtree_motion_count > 0 { comp.subtree_motion_count = comp.subtree_motion_count - 1 } }
    if comp.explicit_motions.has(id) { ems := $&comp.explicit_motions
        ems.delete(id) }
    if comp.hit_test_overrides.has(id) {
        hto := $&comp.hit_test_overrides
        hto.delete(id)
        if comp.hit_test_override_count > 0 { comp.hit_test_override_count = comp.hit_test_override_count - 1 }
    }
    if comp.z_indices.has(id) {
        zs := $&comp.z_indices
        zs.delete(id)
        if comp.z_index_count > 0 { comp.z_index_count = comp.z_index_count - 1 }
    }
    if comp.opacity_transitions.has(id) {
        ots := $&comp.opacity_transitions
        ots.delete(id)
        next_ot := vec_without(&comp.opacity_transition_ids,id)
        comp.opacity_transition_ids = next_ot
    }
    if comp.transform_transitions.has(id) {
        tts := $&comp.transform_transitions
        tts.delete(id)
        next_tt := vec_without(&comp.transform_transition_ids,id)
        comp.transform_transition_ids = next_tt
    }
    if comp.hidden_nodes.has(id) {
        hn := $&comp.hidden_nodes
        hn.delete(id)
        if comp.hidden_node_count > 0 { comp.hidden_node_count = comp.hidden_node_count - 1 }
    }
    if comp.auto_scrolls.has(id) { ascr := $&comp.auto_scrolls
        ascr.delete(id) }
    if comp.measure_cache.has(id) { mc := $&comp.measure_cache
        mc.delete(id) }
    if comp.children_order.has(id) { co := $&comp.children_order
        co.delete(id) }
    s.children_order_remove(parent,id)
    s.nodes[id - 1].kind = -1
    s.nodes[id - 1].visible = false
    s.nodes[id - 1].enabled = false
    s.nodes[id - 1].parent = 0
    s.texts[id - 1] = ""
    s.descriptions[id - 1] = ""
    if comp.live_nodes > 0 { comp.live_nodes = comp.live_nodes - 1 }
    if comp.root_id == id { comp.root_id = 0 }
    << 0
}

pub fn (s $&Screen) remove(id int) int {
    _ := s.node(id) or >>
    $order := []int{}
    s.collect_subtree_postorder(id,$&order)
    ev := s.cancellation()
    for nid in order {
        if s.focused == nid {
            try_cancel_route(s,nid,&ev)
            s.focused = 0
        }
        if s.captured == nid {
            try_cancel_route(s,nid,&ev)
            s.captured = 0
        }
        if s.hovered == nid {
            try_cancel_route(s,nid,&ev)
            s.hovered = 0
            s.pointer_cursor(ui.CURSOR_DEFAULT) or >>
        }
    }
    for nid in order {
        s.remove_node_resources(nid) or >>
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_children(parent int) int {
    if parent != 0 { _ := s.node(parent) or >> }
    kids := s.children(parent) or >>
    for cid in kids { s.remove(cid) or >> }
    << 0
}

fn layout_container_kind_to_box(kind int) int {
    if kind == LAYOUT_ROW { << layout.BOX_ROW }
    if kind == LAYOUT_COLUMN { << layout.BOX_COLUMN }
    if kind == LAYOUT_STACK { << layout.BOX_STACK }
    if kind == LAYOUT_WRAP { << layout.BOX_WRAP }
    if kind == LAYOUT_GRID { << layout.BOX_GRID }
    << layout.BOX_PADDING
}

fn (s $&Screen) measure_label_size(id int,styles &Styles,max_w f64) layout.Size {
    style := s.label_control_style(id,styles,1.0) or (err) { << layout.Size{width: 0.0,height: 0.0} }
    value := s.texts[id - 1] + ""
    wrap := s.basics.wrapped_labels.has(id)
    slot := id * 2
    if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
    $cache := s.take_label_cache(slot)
    $opts := styles.text_options(&style)
    if wrap && max_w > 0.0 && max_w < 100000.0 { opts.width = max_w }
    sz := cache.measure_options(0,&value,&opts) or (err) { s.labels[slot] = cache
        << layout.Size{width: 0.0,height: 0.0} }
    s.labels[slot] = cache
    << sz
}

fn (s &Screen) fallback_line_height(styles &Styles,c &ControlStyle) f64 {
    $opts := styles.text_options(c)
    opts.width = 0.0
    stack := draw.default_font_stack() or (err) { << math.max(16.0,c.font.size * styles.text_scale * 1.35) }
    ly := draw.layout_font_text(&stack,&"Mg",&opts,false) or (err) { << math.max(16.0,c.font.size * styles.text_scale * 1.35) }
    << math.max(14.0,ly.metrics.height)
}

