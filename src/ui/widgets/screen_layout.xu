@ui/widgets

#ui
#ui/draw
#ui/layout
#math
#errors
#time

pub const LAYOUT_NONE = 0
pub const LAYOUT_ROW = 1
pub const LAYOUT_COLUMN = 2
pub const LAYOUT_STACK = 3
pub const LAYOUT_WRAP = 4
pub const LAYOUT_GRID = 5
pub const LAYOUT_PADDING = 6
pub const INSET_LEFT = 1
pub const INSET_TOP = 2
pub const INSET_RIGHT = 4
pub const INSET_BOTTOM = 8
pub const VISIBILITY_VISIBLE = 0
pub const VISIBILITY_HIDDEN = 1
pub const VISIBILITY_COLLAPSED = 2

pub struct ContainerLayout {
    pub kind int
    pub padding layout.Insets
    pub gap f64
    pub run_gap f64
    pub main_alignment int
    pub cross_alignment int
    pub align_x f64
    pub align_y f64
    pub columns int
    pub min_col_width f64
    pub col_weights []f64
    pub scale_with_density bool
    pub clip bool
}

pub fn container_layout(kind int) ContainerLayout {
    << ContainerLayout{
        kind: kind,
        padding: layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0},
        gap: 0.0,
        run_gap: 0.0,
        main_alignment: layout.MAIN_START,
        cross_alignment: layout.CROSS_START,
        align_x: -1.0,
        align_y: -1.0,
        columns: 1,
        min_col_width: 0.0,
        col_weights: []f64{},
        scale_with_density: false,
        clip: false
    }
}

fn clone_layout_weights(src &[]f64) []f64 {
    $out := []f64{}
    for w in src { out.push(w) }
    << out
}

fn copy_container_layout(c &ContainerLayout) ContainerLayout {
    << ContainerLayout{
        kind: c.kind,
        padding: layout.Insets{left: c.padding.left,top: c.padding.top,right: c.padding.right,bottom: c.padding.bottom},
        gap: c.gap,
        run_gap: c.run_gap,
        main_alignment: c.main_alignment,
        cross_alignment: c.cross_alignment,
        align_x: c.align_x,
        align_y: c.align_y,
        columns: c.columns,
        min_col_width: c.min_col_width,
        col_weights: clone_layout_weights(&c.col_weights),
        scale_with_density: c.scale_with_density,
        clip: c.clip
    }
}

fn (c &ContainerLayout) validate() int {
    c.padding.validate() or >>
    if c.kind < LAYOUT_NONE || c.kind > LAYOUT_PADDING ||
       math.is_nan(c.gap) || math.is_inf(c.gap) || c.gap < 0.0 || c.gap > 4096.0 ||
       math.is_nan(c.run_gap) || math.is_inf(c.run_gap) || c.run_gap < 0.0 || c.run_gap > 4096.0 ||
       c.main_alignment < layout.MAIN_START || c.main_alignment > layout.MAIN_SPACE_EVENLY ||
       c.cross_alignment < layout.CROSS_START || c.cross_alignment > layout.CROSS_STRETCH ||
       math.is_nan(c.align_x) || math.is_inf(c.align_x) || math.abs(c.align_x) > 1.0 ||
       math.is_nan(c.align_y) || math.is_inf(c.align_y) || math.abs(c.align_y) > 1.0 ||
       c.columns < 1 || c.columns > 256 ||
       !finite_metric(c.min_col_width,100000.0) ||
       (c.col_weights.len != 0 && c.min_col_width <= 0.0 && c.col_weights.len != c.columns) {
        >> errors.new("widgets: invalid container layout")
    }
    for w in c.col_weights {
        if math.is_nan(w) || math.is_inf(w) || w <= 0.0 || w > 10000.0 {
            >> errors.new("widgets: invalid container column weight")
        }
    }
    << 0
}

pub struct LayoutItem {
    pub width f64
    pub height f64
    pub min_width f64
    pub max_width f64
    pub min_height f64
    pub max_height f64
    pub width_pct f64
    pub height_pct f64
    pub aspect_ratio f64
    pub flex_grow f64
    pub flex_shrink f64
    pub col_span int
    pub align_self int
    pub justify_self int
    pub order int
    pub stack_align_x f64
    pub stack_align_y f64
    pub absolute bool
    pub sticky bool
    pub sticky_offset f64
    pub inset_mask int
    pub inset_left f64
    pub inset_top f64
    pub inset_right f64
    pub inset_bottom f64
    pub margin layout.Insets
}

pub fn layout_item() LayoutItem {
    << LayoutItem{
        width: -1.0,
        height: -1.0,
        min_width: 0.0,
        max_width: -1.0,
        min_height: 0.0,
        max_height: -1.0,
        width_pct: -1.0,
        height_pct: -1.0,
        aspect_ratio: 0.0,
        flex_grow: 0.0,
        flex_shrink: 0.0,
        col_span: 1,
        align_self: -1,
        justify_self: -1,
        order: 0,
        stack_align_x: -2.0,
        stack_align_y: -2.0,
        absolute: false,
        sticky: false,
        sticky_offset: 0.0,
        inset_mask: 0,
        inset_left: 0.0,
        inset_top: 0.0,
        inset_right: 0.0,
        inset_bottom: 0.0,
        margin: layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    }
}

fn copy_layout_item(it &LayoutItem) LayoutItem {
    << LayoutItem{
        width: it.width,
        height: it.height,
        min_width: it.min_width,
        max_width: it.max_width,
        min_height: it.min_height,
        max_height: it.max_height,
        width_pct: it.width_pct,
        height_pct: it.height_pct,
        aspect_ratio: it.aspect_ratio,
        flex_grow: it.flex_grow,
        flex_shrink: it.flex_shrink,
        col_span: it.col_span,
        align_self: it.align_self,
        justify_self: it.justify_self,
        order: it.order,
        stack_align_x: it.stack_align_x,
        stack_align_y: it.stack_align_y,
        absolute: it.absolute,
        sticky: it.sticky,
        sticky_offset: it.sticky_offset,
        inset_mask: it.inset_mask,
        inset_left: it.inset_left,
        inset_top: it.inset_top,
        inset_right: it.inset_right,
        inset_bottom: it.inset_bottom,
        margin: layout.Insets{left: it.margin.left,top: it.margin.top,right: it.margin.right,bottom: it.margin.bottom}
    }
}

fn valid_item_pct(v f64) bool {
    << v == -1.0 || (!math.is_nan(v) && !math.is_inf(v) && v >= 0.0 && v <= 1.0)
}

fn valid_signed_coord(v f64) bool {
    << !math.is_nan(v) && !math.is_inf(v) && math.abs(v) <= 100000.0
}

fn (it &LayoutItem) validate() int {
    it.margin.validate() or >>
    if (it.width != -1.0 && !finite_metric(it.width,100000.0)) ||
       (it.height != -1.0 && !finite_metric(it.height,100000.0)) ||
       !finite_metric(it.min_width,100000.0) || !finite_metric(it.min_height,100000.0) ||
       (it.max_width != -1.0 && (!finite_metric(it.max_width,100000.0) || it.max_width < it.min_width)) ||
       (it.max_height != -1.0 && (!finite_metric(it.max_height,100000.0) || it.max_height < it.min_height)) ||
       !valid_item_pct(it.width_pct) || !valid_item_pct(it.height_pct) ||
       math.is_nan(it.aspect_ratio) || math.is_inf(it.aspect_ratio) || it.aspect_ratio < 0.0 || it.aspect_ratio > 1000.0 ||
       math.is_nan(it.flex_grow) || math.is_inf(it.flex_grow) || it.flex_grow < 0.0 || it.flex_grow > 1000.0 ||
       math.is_nan(it.flex_shrink) || math.is_inf(it.flex_shrink) || it.flex_shrink < 0.0 || it.flex_shrink > 1000.0 ||
       it.col_span < 1 || it.col_span > 256 ||
       it.align_self < -1 || it.align_self > layout.CROSS_STRETCH ||
       it.justify_self < -1 || it.justify_self > layout.MAIN_SPACE_EVENLY ||
       it.order < -1000000 || it.order > 1000000 ||
       !valid_signed_coord(it.sticky_offset) ||
       it.inset_mask < 0 || it.inset_mask > 15 ||
       !valid_signed_coord(it.inset_left) || !valid_signed_coord(it.inset_top) ||
       !valid_signed_coord(it.inset_right) || !valid_signed_coord(it.inset_bottom) ||
       (it.stack_align_x != -2.0 && (math.is_nan(it.stack_align_x) || math.is_inf(it.stack_align_x) || math.abs(it.stack_align_x) > 1.0)) ||
       (it.stack_align_y != -2.0 && (math.is_nan(it.stack_align_y) || math.is_inf(it.stack_align_y) || math.abs(it.stack_align_y) > 1.0)) {
        >> errors.new("widgets: invalid layout item")
    }
    << 0
}

struct CachedMeasure {
    gen int
    max_w f64
    max_h f64
    width f64
    height f64
}

struct ScreenComposition {
    slots ScreenSlots
    customs map[int]ScreenCustomEntry
    containers map[int]ContainerLayout
    items map[int]LayoutItem
    children_order map[int][]int
    subtree_styles map[int]int
    subtree_style_values []Styles
    subtree_style_free []int
    subtree_style_count int
    style_scopes map[int]int
    style_scope_values []StyleDelta
    style_scope_free []int
    style_scope_count int
    control_patches map[int]int
    control_patch_values []ControlStylePatch
    control_patch_free []int
    opacities map[int]f64
    opacity_count int
    subtree_locales map[int]Locale
    subtree_locale_count int
    visual_transforms map[int]VisualTransform
    visual_transform_count int
    default_motion MotionSpec
    has_default_motion bool
    subtree_motions map[int]MotionSpec
    subtree_motion_count int
    explicit_motions map[int]bool
    animations map[int]AnimationController
    animation_ids []int
    next_anim_id int
    springs map[int]Spring
    spring_ids []int
    next_spring_id int
    hit_test_overrides map[int]int
    hit_test_override_count int
    z_indices map[int]int
    z_index_count int
    absolute_item_count int
    sticky_item_count int
    opacity_transitions map[int]NodeOpacityTransition
    opacity_transition_ids []int
    transform_transitions map[int]NodeTransformTransition
    transform_transition_ids []int
    hidden_nodes map[int]bool
    hidden_node_count int
    auto_scrolls map[int]bool
    measure_cache map[int]CachedMeasure
    live_ids []int
    button_ids []int
    menu_ids []int
    text_input_ids []int
    overlay_ids []int
    attached_badge_ids []int
    popup_capable_ids []int
    webview_ids []int
    node_keys map[string]int
    key_by_node map[int]string
    measure_gen int
    measure_active bool
    layout_dirty bool
    known_dirty bool
    layout_pass_count int
    live_nodes int
    root_id int
}

fn new_screen_composition() ScreenComposition {
    $children := map[int][]int{}
    children[0] = []int{}
    << ScreenComposition{
        slots: new_screen_slots(),
        customs: map[int]ScreenCustomEntry{},
        containers: map[int]ContainerLayout{},
        items: map[int]LayoutItem{},
        children_order: children,
        subtree_styles: map[int]int{},
        subtree_style_values: []Styles{},
        subtree_style_free: []int{},
        subtree_style_count: 0,
        style_scopes: map[int]int{},
        style_scope_values: []StyleDelta{},
        style_scope_free: []int{},
        style_scope_count: 0,
        control_patches: map[int]int{},
        control_patch_values: []ControlStylePatch{},
        control_patch_free: []int{},
        opacities: map[int]f64{},
        opacity_count: 0,
        subtree_locales: map[int]Locale{},
        subtree_locale_count: 0,
        visual_transforms: map[int]VisualTransform{},
        visual_transform_count: 0,
        default_motion: motion_spec(),
        has_default_motion: false,
        subtree_motions: map[int]MotionSpec{},
        subtree_motion_count: 0,
        explicit_motions: map[int]bool{},
        animations: map[int]AnimationController{},
        animation_ids: []int{},
        next_anim_id: 0,
        springs: map[int]Spring{},
        spring_ids: []int{},
        next_spring_id: 0,
        hit_test_overrides: map[int]int{},
        hit_test_override_count: 0,
        z_indices: map[int]int{},
        z_index_count: 0,
        absolute_item_count: 0,
        sticky_item_count: 0,
        opacity_transitions: map[int]NodeOpacityTransition{},
        opacity_transition_ids: []int{},
        transform_transitions: map[int]NodeTransformTransition{},
        transform_transition_ids: []int{},
        hidden_nodes: map[int]bool{},
        hidden_node_count: 0,
        auto_scrolls: map[int]bool{},
        measure_cache: map[int]CachedMeasure{},
        live_ids: []int{},
        button_ids: []int{},
        menu_ids: []int{},
        text_input_ids: []int{},
        overlay_ids: []int{},
        attached_badge_ids: []int{},
        popup_capable_ids: []int{},
        webview_ids: []int{},
        node_keys: map[string]int{},
        key_by_node: map[int]string{},
        measure_gen: 0,
        measure_active: false,
        layout_dirty: true,
        known_dirty: true,
        layout_pass_count: 0,
        live_nodes: 0,
        root_id: 0
    }
}

pub fn (s &Screen) layout_revision() int {
    << s.composition.layout_pass_count
}

fn (s $&Screen) mark_paint_dirty() {
    s.dirty = true
    s.xacp_revision = s.xacp_revision + 1
    comp := $&s.composition
    comp.known_dirty = true
}

fn (s $&Screen) mark_layout_dirty() {
    s.dirty = true
    s.xacp_revision = s.xacp_revision + 1
    comp := $&s.composition
    comp.known_dirty = true
    comp.layout_dirty = true
}

fn screen_is_popup_capable_kind(kind int) bool {
    << kind == SCREEN_SELECT || kind == SCREEN_LIST || kind == SCREEN_COMBO ||
       kind == SCREEN_MULTI || kind == SCREEN_DATE || kind == SCREEN_MENU ||
       kind == SCREEN_BREADCRUMBS || kind == SCREEN_TABLE || kind == SCREEN_TREE ||
       kind == SCREEN_EDITOR || kind == SCREEN_SECRET_INPUT || kind == SCREEN_FIELD ||
       kind == SCREEN_SELECTABLE_TEXT
}

fn vec_add_unique(list $&[]int,id int) {
    for i in 0:list.len {
        if list[i] == id { << }
    }
    list.push(id)
}

fn vec_without(list &[]int,id int) []int {
    $found := false
    for i in 0:list.len {
        if list[i] == id { found = true
            <- }
    }
    $next := []int{}
    for i in 0:list.len {
        if list[i] != id { next.push(list[i]) }
    }
    << next
}

fn vec_has(list &[]int,id int) bool {
    for i in 0:list.len {
        if list[i] == id { << true }
    }
    << false
}

fn (s $&Screen) register_node_categories(id int,kind int) {
    comp := $&s.composition
    vec_add_unique($&comp.live_ids,id)
    if screen_is_overlay(kind) {
        vec_add_unique($&comp.overlay_ids,id)
    } else if kind == SCREEN_BUTTON {
        vec_add_unique($&comp.button_ids,id)
    } else if kind == SCREEN_MENU {
        vec_add_unique($&comp.menu_ids,id)
        vec_add_unique($&comp.popup_capable_ids,id)
    } else if kind == SCREEN_EDITOR || kind == SCREEN_SECRET_INPUT || kind == SCREEN_COMBO || kind == SCREEN_FIELD {
        vec_add_unique($&comp.text_input_ids,id)
        vec_add_unique($&comp.popup_capable_ids,id)
    } else if kind == SCREEN_WEBVIEW {
        vec_add_unique($&comp.webview_ids,id)
    } else if screen_is_popup_capable_kind(kind) {
        vec_add_unique($&comp.popup_capable_ids,id)
    }
}

fn (s $&Screen) unregister_node_categories(id int,kind int) {
    comp := $&s.composition
    if vec_has(&comp.live_ids,id) {
        next_live := vec_without(&comp.live_ids,id)
        comp.live_ids = next_live
    }
    if screen_is_overlay(kind) {
        if vec_has(&comp.overlay_ids,id) {
            next := vec_without(&comp.overlay_ids,id)
            comp.overlay_ids = next
        }
    } else if kind == SCREEN_BUTTON {
        if vec_has(&comp.button_ids,id) {
            next := vec_without(&comp.button_ids,id)
            comp.button_ids = next
        }
    } else if kind == SCREEN_MENU {
        if vec_has(&comp.menu_ids,id) {
            next_m := vec_without(&comp.menu_ids,id)
            comp.menu_ids = next_m
        }
        if vec_has(&comp.popup_capable_ids,id) {
            next_p := vec_without(&comp.popup_capable_ids,id)
            comp.popup_capable_ids = next_p
        }
    } else if kind == SCREEN_EDITOR || kind == SCREEN_SECRET_INPUT || kind == SCREEN_COMBO || kind == SCREEN_FIELD {
        if vec_has(&comp.text_input_ids,id) {
            next_t := vec_without(&comp.text_input_ids,id)
            comp.text_input_ids = next_t
        }
        if vec_has(&comp.popup_capable_ids,id) {
            next_p := vec_without(&comp.popup_capable_ids,id)
            comp.popup_capable_ids = next_p
        }
    } else if kind == SCREEN_WEBVIEW {
        if vec_has(&comp.webview_ids,id) {
            next := vec_without(&comp.webview_ids,id)
            comp.webview_ids = next
        }
    } else if kind == SCREEN_BADGE {
        if vec_has(&comp.attached_badge_ids,id) {
            next := vec_without(&comp.attached_badge_ids,id)
            comp.attached_badge_ids = next
        }
    } else if kind == SCREEN_LABEL || screen_is_popup_capable_kind(kind) {
        if vec_has(&comp.popup_capable_ids,id) {
            next := vec_without(&comp.popup_capable_ids,id)
            comp.popup_capable_ids = next
        }
    }
}

fn (s $&Screen) clear_node_key_internal(id int) {
    if !s.composition.key_by_node.has(id) { << }
    comp := $&s.composition
    kbn := $&comp.key_by_node
    old_key := kbn.take(id)
    if old_key.len > 0 && comp.node_keys.has(old_key) && comp.node_keys[old_key] == id {
        nks := $&comp.node_keys
        nks.delete(old_key)
    }
}

fn (s $&Screen) cancel_subtree_input(id int,event &ui.InputEvent) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    if s.nodes[id - 1].kind >= 0 {
        _ := s.route_node(id,ROUTE_CANCEL,event) or >>
    }
    child_count := s.child_count_of(id)
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == id {
            s.cancel_subtree_input(cid,event) or >>
        }
    }
    << 0
}

fn (s $&Screen) collect_focusable_subtree(id int,modal int,out $&[]int) int {
    if id > 0 {
        if id > s.nodes.len || s.nodes[id - 1].kind < 0 { << 0 }
        if s.focus_ready(id,modal) or >> { out.push(id) }
    }
    ordered := s.order_sorted_live_children(id)
    for i in 0:ordered.len {
        cid := ordered[i]
        if !screen_is_overlay(s.nodes[cid - 1].kind) {
            s.collect_focusable_subtree(cid,modal,out) or >>
        }
    }
    << 0
}

fn (s $&Screen) collect_focusable_order(modal int) []int {
    $order := []int{}
    if modal > 0 {
        s.collect_focusable_subtree(modal,modal,$&order) or >>
        << order
    }
    s.collect_focusable_subtree(0,0,$&order) or >>
    ocount := s.composition.overlay_ids.len
    for i in 0:ocount {
        oid := s.composition.overlay_ids[i]
        if oid > 0 && oid <= s.nodes.len {
            okind := s.nodes[oid - 1].kind
            if (okind == SCREEN_TOAST || okind == SCREEN_POPOVER) && s.overlay_is_visible(oid) {
                s.collect_focusable_subtree(oid,0,$&order) or >>
            }
        }
    }
    << order
}

fn (s &Screen) collect_modal_focus_order(id int,modal_id int,out $&[]int) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    if id != modal_id {
        n := s.nodes[id - 1]
        if n.kind < 0 || !n.visible { << 0 }
        if n.focusable && n.enabled && s.is_visible(id) {
            if out.len >= 256 { >> errors.new("widgets: too many screen modal focus targets") }
            out.push(id)
        }
    }
    child_count := s.child_count_of(id)
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid > 0 && cid <= s.nodes.len {
            cn := s.nodes[cid - 1]
            if cn.kind >= 0 && cn.parent == id && !screen_is_overlay(cn.kind) {
                s.collect_modal_focus_order(cid,modal_id,out) or >>
            }
        }
    }
    << 0
}

fn (s $&Screen) children_order_append(parent int,child int) {
    comp := $&s.composition
    co := $&comp.children_order
    if !co.has(parent) { co[parent] = []int{} }
    $list := co.take(parent)
    $found := false
    for id in list { if id == child { found = true } }
    if !found { list.push(child) }
    co[parent] = list
}

fn (s $&Screen) children_order_remove(parent int,child int) {
    comp := $&s.composition
    co := $&comp.children_order
    if !co.has(parent) { << }
    old := co.take(parent)
    $next := []int{}
    for id in old { if id != child { next.push(id) } }
    if next.len == 0 && parent != 0 { << }
    co[parent] = next
}

pub fn (s $&Screen) row(gap f64) int {
    id := s.group() or >>
    $cfg := container_layout(LAYOUT_ROW)
    cfg.gap = gap
    s.set_container_layout(id,&cfg) or (err) { s.abandon_node(id)
        >> err }
    << id
}

pub fn (s $&Screen) column(gap f64) int {
    id := s.group() or >>
    $cfg := container_layout(LAYOUT_COLUMN)
    cfg.gap = gap
    s.set_container_layout(id,&cfg) or (err) { s.abandon_node(id)
        >> err }
    << id
}

pub fn (s $&Screen) stack() int {
    id := s.group() or >>
    cfg := container_layout(LAYOUT_STACK)
    s.set_container_layout(id,&cfg) or (err) { s.abandon_node(id)
        >> err }
    << id
}

pub fn (s $&Screen) wrap(gap f64,run_gap f64) int {
    id := s.group() or >>
    $cfg := container_layout(LAYOUT_WRAP)
    cfg.gap = gap
    cfg.run_gap = run_gap
    s.set_container_layout(id,&cfg) or (err) { s.abandon_node(id)
        >> err }
    << id
}

pub fn (s $&Screen) grid(columns int,col_gap f64,row_gap f64) int {
    id := s.group() or >>
    $cfg := container_layout(LAYOUT_GRID)
    cfg.columns = columns
    cfg.gap = col_gap
    cfg.run_gap = row_gap
    s.set_container_layout(id,&cfg) or (err) { s.abandon_node(id)
        >> err }
    << id
}

pub fn (s $&Screen) padding_box(padding &layout.Insets) int {
    padding.validate() or >>
    id := s.group() or >>
    $cfg := container_layout(LAYOUT_PADDING)
    cfg.padding = layout.Insets{left: padding.left,top: padding.top,right: padding.right,bottom: padding.bottom}
    s.set_container_layout(id,&cfg) or (err) { s.abandon_node(id)
        >> err }
    << id
}

pub fn (s $&Screen) spacer() int {
    id := s.group() or >>
    $it := layout_item()
    it.flex_grow = 1.0
    s.set_layout_item(id,&it) or (err) { s.abandon_node(id)
        >> err }
    << id
}

fn (s $&Screen) children_order_insert_at(parent int,index int,child int) {
    comp := $&s.composition
    co := $&comp.children_order
    if !co.has(parent) { co[parent] = []int{} }
    old := co.take(parent)
    $pos := index
    if pos < 0 { pos = 0 }
    $next := []int{}
    $inserted := false
    for id in old {
        if id == child { -> }
        if !inserted && next.len == pos {
            next.push(child)
            inserted = true
        }
        next.push(id)
    }
    if !inserted { next.push(child) }
    co[parent] = next
}

pub fn (s $&Screen) insert_child(parent int,index int,child int) int {
    _ := s.node(child) or >>
    old_parent := s.nodes[child - 1].parent
    if parent != 0 { _ := s.node(parent) or >> }
    if parent == child || s.is_descendant(parent,child) { >> errors.new("widgets: screen parent cycle") }
    if old_parent == parent {
        << s.move_child(parent,child,index) or >>
    }
    s.detach_child_from_slot_if_reparented(child,parent)
    s.children_order_remove(old_parent,child)
    s.nodes[child - 1].parent = parent
    if child == s.composition.root_id && parent != 0 {
        comp := $&s.composition
        comp.root_id = 0
    }
    s.children_order_insert_at(parent,index,child)
    if s.composition.subtree_locale_count > 0 { s.refresh_subtree_locale(child) or >> }
    if s.composition.subtree_motion_count > 0 || s.composition.has_default_motion { s.propagate_subtree_motion(child) or >> }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) move_child(parent int,child int,index int) int {
    cn := s.node(child) or >>
    if parent != 0 { _ := s.node(parent) or >> }
    if cn.parent != parent { >> errors.new("widgets: child is not under parent") }
    s.children_order_remove(parent,child)
    s.children_order_insert_at(parent,index,child)
    s.mark_layout_dirty()
    << 0
}

pub fn (s &Screen) child_index(parent int,child int) int {
    cn := s.node(child) or >>
    if parent != 0 { _ := s.node(parent) or >> }
    if cn.parent != parent || !s.composition.children_order.has(parent) { << -1 }
    list := &s.composition.children_order[parent]
    $live_idx := 0
    for i in 0:list.len {
        cid := list[i]
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == parent {
            if cid == child { << live_idx }
            live_idx += 1
        }
    }
    << -1
}

pub fn (s $&Screen) set_node_key(id int,key string) int {
    _ := s.node(id) or >>
    if key == "" {
        s.clear_node_key_internal(id)
        << 0
    }
    if s.composition.node_keys.has(key) {
        existing := s.composition.node_keys[key]
        if existing != id && existing > 0 && existing <= s.nodes.len && s.nodes[existing - 1].kind >= 0 {
            >> errors.new("widgets: duplicate node key")
        }
    }
    s.clear_node_key_internal(id)
    comp := $&s.composition
    nks := $&comp.node_keys
    nks[key + ""] = id
    kbn := $&comp.key_by_node
    kbn[id] = key + ""
    << 0
}

pub fn (s &Screen) node_key(id int) string {
    _ := s.node(id) or >>
    << s.composition.key_by_node.get_or(id,"") + ""
}

pub fn (s &Screen) find_node(key string) int {
    if key == "" || !s.composition.node_keys.has(key) { << 0 }
    id := s.composition.node_keys[key]
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 { << 0 }
    << id
}

fn (s &Screen) copy_or_default_layout_item(id int) LayoutItem {
    if s.composition.items.has(id) { << copy_layout_item(&s.composition.items[id]) }
    << layout_item()
}

pub fn (s $&Screen) add_child(parent int,child int) int {
    << s.set_parent(child,parent) or >>
}

fn (s &Screen) can_have_container_layout(id int) bool {
    node := s.node(id) or (err) { << false }
    << node.kind == SCREEN_GROUP || node.kind == SCREEN_CARD || node.kind == SCREEN_CUSTOM
}

fn (s $&Screen) ensure_container_layout(id int,default_kind int) ContainerLayout {
    if s.composition.containers.has(id) {
        comp := $&s.composition
        containers := $&comp.containers
        << containers.take(id)
    }
    << container_layout(default_kind)
}

pub fn (s $&Screen) set_container_layout(id int,cfg &ContainerLayout) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    cfg.validate() or >>
    comp := $&s.composition
    containers := $&comp.containers
    containers[id] = copy_container_layout(cfg)
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) set_container_padding(id int,padding &layout.Insets) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    padding.validate() or >>
    $cfg := s.ensure_container_layout(id,LAYOUT_PADDING)
    cfg.padding = layout.Insets{left: padding.left,top: padding.top,right: padding.right,bottom: padding.bottom}
    comp := $&s.composition
    containers := $&comp.containers
    containers[id] = cfg
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) set_container_gap(id int,gap f64) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    if math.is_nan(gap) || math.is_inf(gap) || gap < 0.0 || gap > 4096.0 {
        >> errors.new("widgets: invalid container gap")
    }
    $cfg := s.ensure_container_layout(id,LAYOUT_COLUMN)
    cfg.gap = gap
    comp := $&s.composition
    containers := $&comp.containers
    containers[id] = cfg
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) set_container_alignment(id int,main_alignment int,cross_alignment int) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    if main_alignment < layout.MAIN_START || main_alignment > layout.MAIN_SPACE_EVENLY ||
       cross_alignment < layout.CROSS_START || cross_alignment > layout.CROSS_STRETCH {
        >> errors.new("widgets: invalid container alignment")
    }
    $cfg := s.ensure_container_layout(id,LAYOUT_COLUMN)
    cfg.main_alignment = main_alignment
    cfg.cross_alignment = cross_alignment
    comp := $&s.composition
    containers := $&comp.containers
    containers[id] = cfg
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) set_container_clip(id int,clip bool) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    $cfg := s.ensure_container_layout(id,LAYOUT_STACK)
    cfg.clip = clip
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_container_run_gap(id int,run_gap f64) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    $cfg := s.ensure_container_layout(id,LAYOUT_WRAP)
    cfg.run_gap = run_gap
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_container_columns(id int,columns int) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    $cfg := s.ensure_container_layout(id,LAYOUT_GRID)
    cfg.columns = columns
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_container_stack_align(id int,align_x f64,align_y f64) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    $cfg := s.ensure_container_layout(id,LAYOUT_STACK)
    cfg.align_x = align_x
    cfg.align_y = align_y
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_container_scale_with_density(id int,enabled bool) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    $cfg := s.ensure_container_layout(id,LAYOUT_COLUMN)
    cfg.scale_with_density = enabled
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_container_min_col_width(id int,min_col_width f64) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    $cfg := s.ensure_container_layout(id,LAYOUT_GRID)
    cfg.min_col_width = min_col_width
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_container_col_weights(id int,weights &[]f64) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    $cfg := s.ensure_container_layout(id,LAYOUT_GRID)
    cfg.col_weights = clone_layout_weights(weights)
    if weights.len > 0 && cfg.min_col_width <= 0.0 { cfg.columns = weights.len }
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_grid_responsive(id int,min_col_width f64,gap f64,run_gap f64) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    if min_col_width <= 0.0 { >> errors.new("widgets: invalid responsive min_col_width") }
    $cfg := s.ensure_container_layout(id,LAYOUT_GRID)
    cfg.kind = LAYOUT_GRID
    cfg.min_col_width = min_col_width
    cfg.gap = gap
    cfg.run_gap = run_gap
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_grid_weighted(id int,weights &[]f64,gap f64,run_gap f64) int {
    _ := s.node(id) or >>
    if !s.can_have_container_layout(id) { >> errors.new("widgets: node does not support container layout") }
    if weights.len < 1 || weights.len > 256 { >> errors.new("widgets: invalid grid weights count") }
    $cfg := s.ensure_container_layout(id,LAYOUT_GRID)
    cfg.kind = LAYOUT_GRID
    cfg.columns = weights.len
    cfg.min_col_width = 0.0
    cfg.col_weights = clone_layout_weights(weights)
    cfg.gap = gap
    cfg.run_gap = run_gap
    << s.set_container_layout(id,&cfg) or >>
}

pub fn (s $&Screen) set_root(id int) int {
    if id == 0 {
        if s.composition.root_id != 0 {
            comp := $&s.composition
            comp.root_id = 0
            s.mark_layout_dirty()
        }
        << 0
    }
    n := s.node(id) or >>
    if n.parent != 0 || screen_is_overlay(n.kind) {
        >> errors.new("widgets: root node must be a top-level non-overlay node")
    }
    if s.composition.root_id != id {
        comp := $&s.composition
        comp.root_id = id
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s &Screen) root() int {
    rid := s.composition.root_id
    if rid <= 0 || rid > s.nodes.len || s.nodes[rid - 1].kind < 0 || s.nodes[rid - 1].parent != 0 { << 0 }
    << rid
}

fn (s $&Screen) sync_item_absolute(id int,next_abs bool) {
    prev_abs := s.composition.items.has(id) && s.composition.items[id].absolute
    comp := $&s.composition
    if !prev_abs && next_abs {
        comp.absolute_item_count = comp.absolute_item_count + 1
    } else if prev_abs && !next_abs && comp.absolute_item_count > 0 {
        comp.absolute_item_count = comp.absolute_item_count - 1
    }
}

fn (s $&Screen) sync_item_sticky(id int,next_sticky bool) {
    prev_sticky := s.composition.items.has(id) && s.composition.items[id].sticky
    comp := $&s.composition
    if !prev_sticky && next_sticky {
        comp.sticky_item_count = comp.sticky_item_count + 1
    } else if prev_sticky && !next_sticky && comp.sticky_item_count > 0 {
        comp.sticky_item_count = comp.sticky_item_count - 1
    }
}

pub fn (s $&Screen) set_layout_item(id int,item &LayoutItem) int {
    _ := s.node(id) or >>
    item.validate() or >>
    s.sync_item_absolute(id,item.absolute)
    s.sync_item_sticky(id,item.sticky)
    comp := $&s.composition
    items := $&comp.items
    items[id] = copy_layout_item(item)
    s.mark_layout_dirty()
    << 0
}

pub fn (s &Screen) layout_item(id int) LayoutItem {
    _ := s.node(id) or >>
    << s.copy_or_default_layout_item(id)
}

