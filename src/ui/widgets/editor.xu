@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#unicode/utf8

pub const action_submit = 4

// Input and TextArea share one persistent editor. Native TextInput owns edits
// while focused; this model owns the committed value between focus lifetimes.
pub struct Editor {
    id int
    identity ui.CanvasEvent
    context draw.Context
    bounds layout.Rect
    multiline bool
    enabled bool
    focused bool
    closed bool
    dirty bool
    reveal_caret bool
    clipboard ui.Request
    clipboard_operation int
    clipboard_revision int
    dragging bool
    value string
    anchor int
    focus int
    revision int
    session ui.TextInput
    layouts []draw.TextLayout
    shaped_value string
    shaped_width f64
    placeholder string
    font_size f64
    appearance ControlStyle
    typography draw.TextOptions
    global_font FontStyle
    text_scale f64
    density f64
    hovered bool
    invalid bool
    read_only bool
    placeholder_layouts []draw.TextLayout
    offset_x f64
    offset_y f64
    custom_style string
}
fn new_editor(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string,multiline bool) Editor {
    if !valid_identity(identity) || !context.matches_canvas(identity) || id <= 0 || value.len > 16384 || !utf8.valid(value) { >> errors.new("widgets: invalid editor identity or UTF-8 value") }
    validate_bounds(bounds) or >>
    for i in 0:value.len { if (value[i] & 255) == 0 || (!multiline && ((value[i] & 255) == 10 || (value[i] & 255) == 13)) { >> errors.new("widgets: invalid editor text") } }
    styles := dark_styles()
    mut appearance := styles.input.clone()
    if multiline { appearance = styles.text_area.clone() }
    << Editor{id: id,identity: copy_identity(identity),context: context.clone(),bounds: copy_rect(bounds),multiline: multiline,
        reveal_caret: true,clipboard: ui.Request{id: 0,window_id: 0,canvas_id: 0,generation: 0,kind: 0},clipboard_operation: 0,clipboard_revision: 0,enabled: true,focused: false,closed: false,dirty: true,dragging: false,value: value + "",anchor: value.len,focus: value.len,revision: 0,
        session: ui.TextInput{id: 0,window_id: 0,canvas_id: 0,generation: 0},layouts: []draw.TextLayout{},shaped_value: "",shaped_width: -1.0,placeholder: "",font_size: 15.0,appearance: appearance,typography: draw.text_options(15.0),global_font: copy_font(&styles.font),text_scale: 1.0,density: 1.0,hovered: false,invalid: false,read_only: false,placeholder_layouts: []draw.TextLayout{},offset_x: 0.0,offset_y: 0.0,custom_style: ""}
}
pub fn input(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string) Editor {
    << new_editor(context,identity,id,bounds,value,false) or >>
}
pub fn text_area(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string) Editor {
    << new_editor(context,identity,id,bounds,value,true) or >>
}
pub fn (editor &Editor) id() int { << editor.id }
pub fn (editor &Editor) value() string { << editor.value + "" }
pub fn (editor &Editor) is_focused() bool { << editor.focused }
pub fn (editor &Editor) is_enabled() bool { << editor.enabled && !editor.closed }
pub fn (editor &Editor) needs_paint() bool { << editor.dirty }
pub fn (editor &mut Editor) painted() { editor.dirty = false }
pub fn (editor &mut Editor) set_placeholder(value &string) int {
    if value.len > 16384 || !utf8.valid(value) { >> errors.new("widgets: invalid placeholder") }
    for i in 0:value.len { if (value[i] & 255) == 0 { >> errors.new("widgets: placeholder contains NUL") } }
    editor.drop_placeholder()
    editor.placeholder = value + ""
    editor.dirty = true
    << 0
}
fn (editor &Editor) caret_rect() ui.TextInputRect {
    << ui.TextInputRect{x: editor.bounds.x + editor.left(),y: editor.bounds.y + editor.top(),width: editor.appearance.caret_width * editor.density,height: editor.font_size * 1.3}
}
fn (editor &mut Editor) read_state() ui.TextInputState {
    if editor.session.id == 0 {
        << ui.TextInputState{input: editor.session,revision: editor.revision,ready: editor.focused,multiline: editor.multiline,
            value: editor.value + "",anchor: editor.anchor,focus: editor.focus,composing: false,preedit: "",replacement_start: 0,replacement_end: 0,preedit_anchor: 0,preedit_focus: 0,caret: editor.caret_rect()}
    }
    state := editor.session.snapshot() or >>
    editor.value = state.value + ""
    editor.anchor = state.anchor
    editor.focus = state.focus
    editor.revision = state.revision
    << state
}
fn (editor &mut Editor) drop_layout() {
    for item in editor.layouts { mut owned := item
        owned.dispose() or (err) { -> } }
    editor.layouts = []draw.TextLayout{}
}
fn (editor &mut Editor) stash() {
    state := editor.session.snapshot() or (err) { << }
    editor.value = state.value + ""
    editor.anchor = state.anchor
    editor.focus = state.focus
    editor.revision = state.revision
}
fn (editor &mut Editor) stop_session() bool {
    session := mut &editor.session
    session.stop() or (err) { session.id = 0
        << false }
    << true
}
pub fn (editor &mut Editor) focus_session(on bool) int {
    if on && (!editor.enabled || editor.closed || editor.bounds.width <= 16.0 || editor.bounds.height <= 16.0) { << 0 }
    if editor.focused == on { << 0 }
    if on && !editor.read_only {
        mut options := ui.text_input_options(&editor.value,editor.caret_rect())
        options.anchor = editor.anchor
        options.focus = editor.focus
        options.multiline = editor.multiline
        editor.session = editor.context.start_text_input(&options) or >>
        editor.reveal_caret = true
        editor.focused = true
        _ := editor.read_state() or >>
    } else if on { editor.focused = true
        editor.reveal_caret = true
    } else {
        if editor.session.id > 0 {
            editor.stash()
            _ := editor.stop_session()
        }
        editor.cancel_clipboard()
        editor.focused = false
        editor.dragging = false
    }
    editor.dirty = true
    << 0
}
pub fn (editor &mut Editor) enable(on bool) int {
    if editor.closed { << 0 }
    if !on { editor.focus_session(false) or >> }
    if editor.enabled != on { editor.enabled = on
        editor.dirty = true }
    << 0
}
// Bounds are in canvas logical coordinates. Painting and routed pointer input
// use node-local coordinates. Re-place after layout/ancestor scrolling so the
// native IME candidate rectangle uses the same translation as the View.
pub fn (editor &mut Editor) place(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if bounds.x != editor.bounds.x || bounds.y != editor.bounds.y || bounds.width != editor.bounds.width || bounds.height != editor.bounds.height {
        editor.bounds = copy_rect(bounds)
        editor.dirty = true
        editor.drop_layout()
        editor.drop_placeholder()
        if bounds.width <= 16.0 || bounds.height <= 16.0 { editor.focus_session(false) or >> }
    }
    << 0
}
pub fn place_editor(view &mut View,editor &mut Editor) int {
    bounds := view.node_bounds(editor.id) or >>
    editor.place(&bounds) or >>
    view.set_capture_outside(editor.id,true) or >>
    if editor.dirty { view.mark_paint(editor.id) or >> }
    << 0
}
pub fn (editor &mut Editor) set_value(value &string) int {
    if value.len > 16384 || !utf8.valid(value) { >> errors.new("widgets: invalid editor value") }
    for i in 0:value.len { if (value[i] & 255) == 0 || (!editor.multiline && ((value[i] & 255) == 10 || (value[i] & 255) == 13)) { >> errors.new("widgets: invalid editor text") } }
    if editor.closed { >> errors.new("widgets: editor is closed") }
    if editor.session.id > 0 {
        state := editor.read_state() or >>
        if state.composing { >> errors.new("widgets: cannot replace an active IME composition") }
        caret := editor.caret_rect()
        _ := editor.session.update(state.revision,value,value.len,value.len,&caret) or >>
        _ := editor.read_state() or >>
    } else { editor.value = value + ""
        editor.anchor = value.len
        editor.focus = value.len }
    editor.reveal_caret = true
    editor.offset_x = 0.0
    editor.offset_y = 0.0
    editor.dirty = true
    << 0
}
fn (editor &mut Editor) select_at(x f64,y f64,extend bool) int {
    if !editor.focused { << 0 }
    state := editor.read_state() or >>
    if state.composing { << 0 }
    mut origin_x := editor.left()
    mut origin_y := editor.top()
    if editor.layouts.len > 0 {
        shaped := editor.layouts[0]
        origin_x = editor.text_origin_x(shaped.metrics.width)
        origin_y = editor.text_origin_y(shaped.metrics.height)
    }
    hit := editor.hit_current(&state,math.max(-1048576.0,math.min(1048576.0,x - origin_x + editor.offset_x)),math.max(-1048576.0,math.min(1048576.0,y - origin_y + editor.offset_y))) or >>
    index := hit.byte_index()
    mut anchor := index
    if extend { anchor = state.anchor }
    editor.select_state(&state,anchor,index) or >>
    editor.reveal_caret = true
    editor.dirty = true
    << 0
}
pub fn (editor &mut Editor) route(kind int,event &ui.InputEvent) Action {
    if kind < route_input || kind > route_cancel { >> errors.new("widgets: invalid editor route") }
    if !belongs(&editor.identity,event) || editor.closed { << no_action(editor.id,editor.dirty) }
    if kind == route_blur || kind == route_cancel || event.kind == ui.ev_pointer_cancel {
        editor.focus_session(false) or >>
        << no_action(editor.id,editor.dirty)
    }
    if kind == route_focus { editor.focus_session(true) or >>
        << no_action(editor.id,editor.dirty) }
    if !editor.enabled { << no_action(editor.id,editor.dirty) }
    if event.kind == ui.ev_pointer_move || event.kind == ui.ev_pointer_enter || event.kind == ui.ev_pointer_leave {
        hot := event.kind != ui.ev_pointer_leave && event.x >= 0.0 && event.y >= 0.0 && event.x < editor.bounds.width && event.y < editor.bounds.height
        if hot != editor.hovered { editor.hovered = hot
            editor.dirty = true }
    }
    mut consumed := false
    mut submit := false
    if event.kind == ui.ev_pointer_down && event.button == ui.button_left {
        editor.focus_session(true) or >>
        editor.dragging = true
        editor.select_at(event.x,event.y,(event.modifiers & ui.mod_shift) != 0) or >>
        consumed = true
    }
    if event.kind == ui.ev_pointer_move && editor.dragging {
        editor.select_at(event.x,event.y,true) or >>
        consumed = true
    }
    if event.kind == ui.ev_pointer_up && event.button == ui.button_left { editor.dragging = false
        consumed = true }
    if editor.focused && (event.kind == ui.ev_key_down || event.kind == ui.ev_key_up) {
        consumed = true
        if event.kind == ui.ev_key_down {
            editor.navigate(event) or >>
            editor.clipboard_key(event) or >>
        }
        submit = !editor.read_only && !editor.multiline && event.kind == ui.ev_key_down && event.key == ui.key_enter && event.repeat == 0
    }
    if event.kind == ui.ev_pointer_scroll && editor.multiline && editor.layouts.len > 0 {
        shaped := editor.layouts[0]
        before := editor.offset_y
        editor.offset_y = math.max(0.0,math.min(math.max(0.0,shaped.metrics.height - editor.bounds.height + editor.top() + editor.bottom()),before + event.dy))
        consumed = editor.offset_y != before
        if consumed { editor.reveal_caret = false
            editor.dirty = true }
    }
    mut action := action_none
    if submit { action = action_submit }
    << Action{kind: action,id: editor.id,needs_paint: editor.dirty,request_focus: editor.focused,consumed: consumed,value: 0.0}
}
pub fn (editor &mut Editor) event(event &ui.Event) Action {
    if event.window_id != editor.identity.window_id { << no_action(editor.id,editor.dirty) }
    if event.kind == ui.ev_closed || event.kind == ui.ev_blurred || event.kind == ui.ev_canvas_closed {
        if event.kind == ui.ev_canvas_closed { identity := ui.canvas_of(event) or >>
            if identity.canvas_id != editor.identity.canvas_id || identity.generation != editor.identity.generation { << no_action(editor.id,editor.dirty) } }
        editor.focus_session(false) or >>
        if event.kind != ui.ev_blurred { editor.closed = true
            editor.enabled = false
            editor.drop_layout() }
        << no_action(editor.id,editor.dirty)
    }
    if event.kind == ui.ev_request { << editor.clipboard_result(event) or >> }
    if event.kind < ui.ev_text_commit || event.kind > ui.ev_text_surrounding_delete || editor.session.id == 0 { << no_action(editor.id,editor.dirty) }
    edit := ui.text_edit_of(event) or >>
    if edit.input.id != editor.session.id || edit.input.generation != editor.identity.generation { << no_action(editor.id,editor.dirty) }
    if event.kind == ui.ev_text_input_ended || event.kind == ui.ev_text_input_failed {
        editor.session.id = 0
        editor.cancel_clipboard()
        editor.focused = false
        editor.dragging = false
        editor.dirty = true
        << no_action(editor.id,true)
    }
    previous := editor.value + ""
    _ := editor.read_state() or >>
    editor.reveal_caret = true
    editor.dirty = true
    mut action := action_none
    if previous != editor.value { action = action_change }
    << Action{kind: action,id: editor.id,needs_paint: true,request_focus: false,consumed: true,value: 0.0}
}
// Retain the layout until the containing frame has been accepted. painted()
// acknowledges dirtiness, not native resource ownership.
pub fn (editor &mut Editor) paint(frame &mut draw.Frame,theme &Theme) int {
    mut c := editor.appearance.clone()
    c.radius = 0.0
    c.border_width = 0.0
    c.palette.normal = theme.normal
    c.palette.hovered = theme.normal
    c.palette.foreground = theme.foreground
    c.palette.disabled = theme.disabled
    c.palette.muted = theme.muted
    c.palette.selection = theme.accent
    c.palette.selection_text = theme.foreground
    c.palette.focus = theme.focus
    c.palette.placeholder = theme.muted
    << editor.paint_editor(frame,&c) or >>
}
fn (editor &mut Editor) paint_editor(frame &mut draw.Frame,c &ControlStyle) int {
    if editor.closed { << 0 }
    mut value := editor.value + ""
    mut anchor := editor.anchor
    mut focus := editor.focus
    mut composition_start := -1
    mut composition_end := -1
    if editor.session.id > 0 { state := editor.read_state() or >>
        value = state.display_value()
        anchor = state.display_anchor()
        focus = state.display_focus()
        if state.composing { composition_start = state.replacement_start
            composition_end = state.replacement_start + state.preedit.len } }
    options := editor.editor_options()
    mut reused := editor.layouts.len > 0 && editor.shaped_value == value && editor.shaped_width == options.width
    mut layouts := []draw.TextLayout{}
    if reused { layouts.push(editor.layouts[0]) }
    else { layouts.push(editor.context.layout_text(&value,&options) or >>) }
    shaped := layouts[0]
    caret := shaped.caret(focus,false) or >>
    width := math.max(1.0,editor.bounds.width - editor.left() - editor.right())
    height := math.max(1.0,editor.bounds.height - editor.top() - editor.bottom())
    origin_x := editor.text_origin_x(shaped.metrics.width)
    origin_y := editor.text_origin_y(shaped.metrics.height)
    editor.offset_x = math.max(0.0,math.min(editor.offset_x,math.max(0.0,shaped.metrics.width - width)))
    editor.offset_y = math.max(0.0,math.min(editor.offset_y,math.max(0.0,shaped.metrics.height - height)))
    if editor.focused {
        if editor.reveal_caret {
        if caret.x < editor.offset_x { editor.offset_x = caret.x }
        if caret.x > editor.offset_x + width - 2.0 { editor.offset_x = caret.x - width + 2.0 }
        if caret.y < editor.offset_y { editor.offset_y = caret.y }
        if caret.y + caret.height > editor.offset_y + height { editor.offset_y = caret.y + caret.height - height }
        editor.reveal_caret = false
        }
        transform := ui.text_input_translation(editor.bounds.x + origin_x - editor.offset_x,editor.bounds.y + origin_y - editor.offset_y)
        // A native edit can advance the revision while shaping. Its queued
        // event will repaint; retain the explicit candidate fallback meanwhile.
        if editor.session.id > 0 { editor.bind_geometry(&shaped,&transform) }
    }
    state := editor.visual_state()
    bounds := layout.Rect{x: 0.0,y: 0.0,width: editor.bounds.width,height: editor.bounds.height}
    style_box(frame,&bounds,c,editor.density,state) or >>
    resolved := c.resolve(state)
    foreground := resolved.foreground
    frame.push() or >>
    frame.clip_rect(editor.left(),editor.top(),width,height) or >>
    if anchor != focus {
        rects := shaped.selection_rects(int(math.min(f64(anchor),f64(focus))),int(math.max(f64(anchor),f64(focus)))) or >>
        for rect in rects {
            x := origin_x - editor.offset_x + rect.x
            y := origin_y - editor.offset_y + rect.y
            if x + rect.width >= editor.left() && x <= editor.bounds.width - editor.right() && y + rect.height >= editor.top() && y <= editor.bounds.height - editor.bottom() {
                frame.fill_rect(x,y,rect.width,rect.height,resolved.selection) or >>
            }
        }
    }
    if value.len == 0 && !editor.focused {
        if editor.placeholder_layouts.len == 0 { editor.placeholder_layouts.push(editor.context.layout_text(&editor.placeholder,&options) or >>) }
        placeholder := editor.placeholder_layouts[0]
        px := editor.text_origin_x(placeholder.metrics.width)
        py := editor.text_origin_y(placeholder.metrics.height)
        frame.text_layout(&placeholder,px,py,resolved.placeholder) or >>
    }
    else { frame.text_layout(&shaped,origin_x - editor.offset_x,origin_y - editor.offset_y,foreground) or >> }
    if anchor != focus {
        selected := shaped.selection_rects(int(math.min(f64(anchor),f64(focus))),int(math.max(f64(anchor),f64(focus)))) or >>
        for rect in selected {
            x := origin_x - editor.offset_x + rect.x
            y := origin_y - editor.offset_y + rect.y
            if x + rect.width >= editor.left() && x <= editor.bounds.width - editor.right() && y + rect.height >= editor.top() && y <= editor.bounds.height - editor.bottom() {
                frame.push() or >>
                frame.clip_rect(x,y,rect.width,rect.height) or >>
                frame.text_layout(&shaped,origin_x - editor.offset_x,origin_y - editor.offset_y,resolved.selection_text) or >>
                frame.pop() or >>
            }
        }
    }
    if composition_end > composition_start {
        marked := shaped.selection_rects(composition_start,composition_end) or >>
        for rect in marked {
            x := origin_x - editor.offset_x + rect.x
            y := origin_y - editor.offset_y + rect.y + rect.height - c.preedit_width * editor.density
            if x + rect.width >= editor.left() && x <= editor.bounds.width - editor.right() && y >= editor.top() && y <= editor.bounds.height - editor.bottom() {
                frame.fill_rect(x,y,rect.width,c.preedit_width * editor.density,resolved.focus) or >>
            }
        }
    }
    if editor.focused && !editor.read_only && c.caret_width > 0.0 { frame.fill_rect(origin_x + caret.x - editor.offset_x,origin_y + caret.y - editor.offset_y,c.caret_width * editor.density,caret.height,resolved.focus) or >> }
    frame.pop() or >>
    if !reused {
        editor.drop_layout()
        editor.layouts.push(shaped)
        editor.shaped_value = value + ""
        editor.shaped_width = options.width
    }
    << 0
}
pub fn (editor &mut Editor) dispose() {
    editor.cancel_clipboard()
    editor.stash()
    _ := editor.stop_session()
    editor.focused = false
    editor.drop_layout()
    editor.drop_placeholder()
    editor.closed = true
    editor.enabled = false
}

fn (editor &mut Editor) bind_geometry(shaped &draw.TextLayout,transform &ui.TextInputTransform) {
    shaped.bind_input_transform(&editor.session,editor.revision,transform,false) or (err) { editor.dirty = true
        << }
}
