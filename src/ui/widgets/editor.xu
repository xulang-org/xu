@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#unicode/utf8

pub const ACTION_SUBMIT = 4
const EDITOR_MULTILINE = 1
const EDITOR_PASSWORD = 2
const EDITOR_PASSWORD_VISIBLE = 4
const EDITOR_NO_SELECT = 8
const EDITOR_MENU_ZH = 16
const EDITOR_COPY_DISABLED = 32

struct EditorAux {
    drag_mode int
    drag_start int
    drag_end int
    clicks ui.ClickTracker
    menus map[int]TextContextMenu
    clipboard ui.Request
    clipboard_operation int
    clipboard_revision int
    placeholder_layouts []draw.TextLayout
}

// Input and TextArea share one persistent editor. Native TextInput owns edits
// while focused; this model owns the committed value between focus lifetimes.
pub struct Editor {
    id int
    identity ui.CanvasEvent
    context draw.Context
    bounds layout.Rect
    input_flags int
    enabled bool
    focused bool
    closed bool
    dirty bool
    reveal_caret bool
    dragging bool
    value string
    anchor int
    focus int
    revision int
    session ui.TextInput
    layouts []draw.TextLayout
    shaped_value string
    shaped_width f64
    placeholder string
    font_size f64
    appearance ControlStyle
    typography draw.TextOptions
    global_font FontStyle
    text_scale f64
    density f64
    hovered bool
    invalid bool
    read_only bool
    offset_x f64
    offset_y f64
    custom_style string
    caret_epoch int
    caret_alpha f64
    composing bool
    aux map[int]EditorAux
}
fn new_editor(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string,multiline bool) Editor {
    if !valid_identity(identity) || !context.matches_canvas(identity) || id <= 0 || value.len > 16384 || !utf8.valid(value) { >>> errors.new("widgets: invalid editor identity or UTF-8 value") }
    validate_bounds(bounds) >>>
    for i in 0:value.len { if (value[i] & 255) == 0 || (!multiline && ((value[i] & 255) == 10 || (value[i] & 255) == 13)) { >>> errors.new("widgets: invalid editor text") } }
    styles := dark_styles()
    $appearance := styles.input.clone()
    if multiline { appearance = styles.text_area.clone() }
    $input_flags := 0
    if multiline { input_flags = EDITOR_MULTILINE }
    << Editor{id: id,identity: copy_identity(identity),context: context.clone(),bounds: copy_rect(bounds),input_flags: input_flags,
        reveal_caret: true,enabled: true,focused: false,closed: false,dirty: true,dragging: false,value: value + "",anchor: value.len,focus: value.len,revision: 0,
        session: ui.TextInput{id: 0,window_id: 0,canvas_id: 0,generation: 0},layouts: []draw.TextLayout{},shaped_value: "",shaped_width: -1.0,placeholder: "",font_size: 15.0,appearance: appearance,typography: draw.text_options(15.0),global_font: copy_font(&styles.font),text_scale: 1.0,density: 1.0,hovered: false,invalid: false,read_only: false,offset_x: 0.0,offset_y: 0.0,custom_style: "",caret_epoch: -1,caret_alpha: 1.0,composing: false,
        aux: map[int]EditorAux{}}
}
pub fn input(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string) Editor {
    << new_editor(context,identity,id,bounds,value,false) >>>
}
pub fn text_area(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string) Editor {
    << new_editor(context,identity,id,bounds,value,true) >>>
}
pub fn (editor &Editor) id() int { << editor.id }
pub fn (editor &Editor) value() string { << editor.value + "" }
pub fn (editor &Editor) has_selection() bool { << editor.anchor != editor.focus }
pub fn (editor &Editor) selection_range() TextRange { << text_range(editor.anchor,editor.focus) }
pub fn (editor &Editor) selected_text() string {
    if !editor.is_selectable() || !editor.is_copy_enabled() { << "" }
    a := ui.utf8_clamp_boundary(&editor.value,editor.anchor)
    f := ui.utf8_clamp_boundary(&editor.value,editor.focus)
    lo := min_int(a,f)
    hi := max_int(a,f)
    if lo >= hi || hi > editor.value.len { << "" }
    << editor.value[lo:hi]
}
fn (editor &Editor) is_multiline() bool { << (editor.input_flags & EDITOR_MULTILINE) != 0 }
pub fn (editor &Editor) is_password() bool { << (editor.input_flags & EDITOR_PASSWORD) != 0 }
pub fn (editor &Editor) is_password_visible() bool { << (editor.input_flags & EDITOR_PASSWORD_VISIBLE) != 0 }
pub fn (editor $&Editor) set_password(on bool) int {
    if on && editor.is_multiline() { >>> errors.new("widgets: password input must be single-line") }
    if editor.is_password() == on { << 0 }
    focused := editor.focused
    editor.focus_session(false) >>>
    editor.input_flags = editor.input_flags & (EDITOR_MULTILINE | EDITOR_NO_SELECT | EDITOR_MENU_ZH | EDITOR_COPY_DISABLED)
    if on { editor.input_flags = editor.input_flags | EDITOR_PASSWORD }
    editor.drop_layout()
    editor.focus_session(focused) >>>
    editor.dirty = true
    << 0
}
pub fn (editor $&Editor) set_password_visible(visible bool) int {
    if !editor.is_password() { >>> errors.new("widgets: expected password input") }
    if editor.is_password_visible() != visible {
        editor.input_flags = editor.input_flags & (EDITOR_MULTILINE | EDITOR_PASSWORD | EDITOR_NO_SELECT | EDITOR_MENU_ZH | EDITOR_COPY_DISABLED)
        if visible { editor.input_flags = editor.input_flags | EDITOR_PASSWORD_VISIBLE }
        editor.drop_layout()
        editor.reveal_caret = true
        editor.dirty = true
    }
    << 0
}
fn (editor &Editor) layout_value(value &string,options &draw.TextOptions) draw.TextLayout {
    if editor.is_password() && !editor.is_password_visible() { << editor.context.layout_masked_text(value,options) >>> }
    << editor.context.layout_text(value,options) >>>
}
pub fn (editor &Editor) is_focused() bool { << editor.focused }
pub fn (editor &Editor) is_enabled() bool { << editor.enabled && !editor.closed }
fn (aux &EditorAux) get_drag_mode() int { << aux.drag_mode }
fn (aux &EditorAux) get_drag_start() int { << aux.drag_start }
fn (aux &EditorAux) get_drag_end() int { << aux.drag_end }
fn (aux &EditorAux) has_menu() bool { << aux.menus.has(0) }
fn (aux &EditorAux) is_menu_open() bool { << aux.menus.has(0) && aux.menus[0].is_open() }
fn (aux &EditorAux) menu_bounds() layout.Rect {
    if !aux.menus.has(0) { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
    << aux.menus[0].popup_bounds()
}
fn (aux &EditorAux) menu_cursor_at(x f64,y f64,density f64) int {
    if !aux.menus.has(0) { << ui.CURSOR_DEFAULT }
    << text_menu_cursor_at(&aux.menus[0],x,y,density)
}
fn (aux &EditorAux) menu_needs_paint() bool { << aux.menus.has(0) && aux.menus[0].needs_paint() }
fn (aux &EditorAux) has_placeholder() bool { << aux.placeholder_layouts.len > 0 }
fn (aux &EditorAux) placeholder_size() draw.TextMetrics { << aux.placeholder_layouts[0].metrics }
fn (aux &EditorAux) paint_placeholder(frame $&draw.Frame,x f64,y f64,color draw.Color) int {
    << frame.text_layout(&aux.placeholder_layouts[0],x,y,color) >>>
}
fn (aux &EditorAux) matches_clipboard(result &ui.RequestResult) bool {
    << aux.clipboard.id > 0 && result.matches(&aux.clipboard)
}

fn (aux $&EditorAux) take_menu() TextContextMenu {
    ms := $&aux.menus
    << ms.take(0)
}

fn (aux $&EditorAux) put_menu(m TextContextMenu) {
    aux.menus[0] = m
}

fn (editor $&Editor) ensure_menu() {
    zh := editor.is_menu_zh()
    $aux := editor.take_aux()
    if !aux.menus.has(0) {
        $fresh := text_context_menu(&editor.context,&editor.identity,editor.id)
        fresh_ref := $&fresh
        fresh_ref.set_zh(zh)
        aux.menus[0] = fresh
    }
    editor.put_aux(aux)
}

fn (editor $&Editor) ensure_aux() {
    if !editor.aux.has(0) {
        editor.aux[0] = EditorAux{
            drag_mode: 0,drag_start: 0,drag_end: 0,
            clicks: ui.click_tracker(),menus: map[int]TextContextMenu{},
            clipboard: ui.Request{id: 0,window_id: 0,canvas_id: 0,generation: 0,kind: 0},
            clipboard_operation: 0,clipboard_revision: 0,
            placeholder_layouts: []draw.TextLayout{}
        }
    }
}

fn (editor $&Editor) take_aux() EditorAux {
    editor.ensure_aux()
    auxs := $&editor.aux
    << auxs.take(0)
}

fn (editor $&Editor) put_aux(aux EditorAux) {
    editor.aux[0] = aux
}

fn (editor $&Editor) clear_drag() {
    if editor.aux.has(0) {
        $aux := editor.take_aux()
        aux.drag_mode = 0
        editor.put_aux(aux)
    }
}
fn (editor &Editor) has_menu() bool { << editor.aux.has(0) && editor.aux[0].has_menu() }
fn (editor &Editor) is_menu_zh() bool { << (editor.input_flags & EDITOR_MENU_ZH) != 0 }
pub fn (editor &Editor) is_selectable() bool { << (editor.input_flags & EDITOR_NO_SELECT) == 0 }
pub fn (editor &Editor) has_popup_open() bool {
    << editor.aux.has(0) && editor.aux[0].is_menu_open()
}
pub fn (editor &Editor) popup_bounds() layout.Rect {
    if !editor.aux.has(0) { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
    << editor.aux[0].menu_bounds()
}
fn (editor &Editor) popup_cursor_at(x f64,y f64) int {
    if !editor.has_popup_open() { << ui.CURSOR_DEFAULT }
    d := math.max(0.5,editor.density)
    aux := &editor.aux[0]
    << aux.menu_cursor_at(x,y,d)
}
pub fn (editor &Editor) cursor() int {
    if editor.is_selectable() && editor.is_enabled() { << ui.CURSOR_TEXT }
    << ui.CURSOR_DEFAULT
}
pub fn (editor &Editor) cursor_at(x f64,y f64) int {
    if !editor.is_enabled() { << ui.CURSOR_DEFAULT }
    if editor.has_popup_open() { << editor.popup_cursor_at(x,y) }
    if !editor.dragging && !editor.bounds.contains(x,y) { << ui.CURSOR_DEFAULT }
    << editor.cursor()
}
pub fn (editor &Editor) needs_paint() bool {
    << editor.dirty || (editor.aux.has(0) && editor.aux[0].menu_needs_paint())
}
pub fn (editor $&Editor) painted() {
    editor.dirty = false
    if editor.has_menu() {
        $aux := editor.take_aux()
        $m := aux.take_menu()
        m_ref := $&m
        m_ref.painted()
        aux.put_menu(m)
        editor.put_aux(aux)
    }
}
pub fn (editor $&Editor) set_locale(locale &Locale) int {
    locale.validate() >>>
    if locale_is_zh(locale) { editor.input_flags = editor.input_flags | EDITOR_MENU_ZH }
    else if (editor.input_flags & EDITOR_MENU_ZH) != 0 { editor.input_flags = editor.input_flags - EDITOR_MENU_ZH }
    if editor.has_menu() {
        $aux := editor.take_aux()
        $m := aux.take_menu()
        m_ref := $&m
        m_ref.set_zh(editor.is_menu_zh())
        aux.put_menu(m)
        editor.put_aux(aux)
    }
    << 0
}
pub fn (editor $&Editor) set_viewport(viewport &layout.Rect) {
    editor.ensure_menu()
    $aux := editor.take_aux()
    $m := aux.take_menu()
    m_ref := $&m
    m_ref.set_viewport(viewport)
    aux.put_menu(m)
    editor.put_aux(aux)
}
fn (editor $&Editor) close_menu() {
    if editor.has_menu() {
        $aux := editor.take_aux()
        $m := aux.take_menu()
        m_ref := $&m
        _ := m_ref.close()
        aux.put_menu(m)
        editor.put_aux(aux)
    }
}
pub fn (editor $&Editor) set_selectable(selectable bool) int {
    if editor.is_selectable() == selectable { << 0 }
    if selectable {
        if (editor.input_flags & EDITOR_NO_SELECT) != 0 { editor.input_flags = editor.input_flags - EDITOR_NO_SELECT }
    } else {
        editor.input_flags = editor.input_flags | EDITOR_NO_SELECT
    }
    if !selectable {
        editor.dragging = false
        editor.clear_drag()
        editor.close_menu()
        state := editor.read_state() >>>
        if state.anchor != state.focus { editor.select_state(&state,state.focus,state.focus) >>> }
    }
    editor.dirty = true
    << 0
}
pub fn (editor $&Editor) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    if !editor.has_menu() { << 0 }
    $aux := editor.take_aux()
    $m := aux.take_menu()
    m_ref := $&m
    err := paint_text_context_menu_err(m_ref,frame,styles)
    aux.put_menu(m)
    editor.put_aux(aux)
    if err.len > 0 { >>> errors.new(err) }
    << 0
}
pub fn (editor $&Editor) set_placeholder(value &string) int {
    if value.len > 16384 || !utf8.valid(value) { >>> errors.new("widgets: invalid placeholder") }
    for i in 0:value.len { if (value[i] & 255) == 0 { >>> errors.new("widgets: placeholder contains NUL") } }
    editor.drop_placeholder()
    editor.placeholder = value + ""
    editor.dirty = true
    << 0
}
fn (editor &Editor) caret_rect() ui.TextInputRect {
    << ui.TextInputRect{x: editor.bounds.x + editor.left(),y: editor.bounds.y + editor.top(),width: editor.appearance.caret_width * editor.density,height: editor.font_size * 1.3}
}
fn (editor $&Editor) read_state() ui.TextInputState {
    if editor.session.id == 0 {
        << ui.TextInputState{input: editor.session,revision: editor.revision,ready: editor.focused,multiline: editor.is_multiline(),
            value: editor.value + "",anchor: editor.anchor,focus: editor.focus,composing: false,preedit: "",replacement_start: 0,replacement_end: 0,preedit_anchor: 0,preedit_focus: 0,caret: editor.caret_rect()}
    }
    state := editor.session.snapshot() >>>
    editor.value = state.value + ""
    editor.anchor = state.anchor
    editor.focus = state.focus
    editor.revision = state.revision
    editor.composing = state.composing
    << state
}
fn (editor $&Editor) drop_layout() {
    for item in editor.layouts { $owned := item
        owned.dispose() >>> (err) { -> } }
    editor.layouts = []draw.TextLayout{}
}
fn (editor $&Editor) stash() {
    state := editor.session.snapshot() >>> (err) { << }
    editor.value = state.value + ""
    editor.anchor = state.anchor
    editor.focus = state.focus
    editor.revision = state.revision
}
fn (editor $&Editor) stop_session() bool {
    session := $&editor.session
    session.stop() >>> (err) { session.id = 0
        << false }
    << true
}
pub fn (editor $&Editor) focus_session(on bool) int {
    if on && (!editor.enabled || editor.closed || editor.bounds.width <= 8.0 || editor.bounds.height <= 8.0) { << 0 }
    if editor.focused == on { << 0 }
    if on && !editor.read_only {
        $options := ui.text_input_options(&editor.value,editor.caret_rect())
        options.anchor = editor.anchor
        options.focus = editor.focus
        options.multiline = editor.is_multiline()
        options.password = editor.is_password()
        editor.session = editor.context.start_text_input(&options) >>>
        editor.reveal_caret = true
        editor.focused = true
        _ := editor.read_state() >>>
    } else if on { editor.focused = true
        editor.reveal_caret = true
    } else {
        if editor.session.id > 0 {
            editor.stash()
            _ := editor.stop_session()
        }
        editor.cancel_clipboard()
        editor.focused = false
        editor.dragging = false
        editor.clear_drag()
        editor.close_menu()
    }
    editor.dirty = true
    editor.restart_caret()
    << 0
}
pub fn (editor $&Editor) enable(on bool) int {
    if editor.closed { << 0 }
    if !on { editor.focus_session(false) >>> }
    if editor.enabled != on { editor.enabled = on
        editor.dirty = true }
    << 0
}
// Bounds are in canvas logical coordinates. Painting and routed pointer input
// use node-local coordinates. Re-place after layout/ancestor scrolling so the
// native IME candidate rectangle uses the same translation as the View.
pub fn (editor $&Editor) place(bounds &layout.Rect) int {
    validate_bounds(bounds) >>>
    if bounds.x != editor.bounds.x || bounds.y != editor.bounds.y || bounds.width != editor.bounds.width || bounds.height != editor.bounds.height {
        editor.bounds = copy_rect(bounds)
        editor.dirty = true
        editor.drop_layout()
        editor.drop_placeholder()
        if bounds.width <= 8.0 || bounds.height <= 8.0 { editor.focus_session(false) >>> }
    }
    << 0
}
pub fn place_editor(view $&View,editor $&Editor) int {
    bounds := view.node_bounds(editor.id) >>>
    editor.place(&bounds) >>>
    view.set_capture_outside(editor.id,true) >>>
    if editor.dirty { view.mark_paint(editor.id) >>> }
    << 0
}
pub fn (editor $&Editor) set_value(value &string) int {
    if value.len > 16384 || !utf8.valid(value) { >>> errors.new("widgets: invalid editor value") }
    for i in 0:value.len { if (value[i] & 255) == 0 || (!editor.is_multiline() && ((value[i] & 255) == 10 || (value[i] & 255) == 13)) { >>> errors.new("widgets: invalid editor text") } }
    if editor.closed { >>> errors.new("widgets: editor is closed") }
    if editor.session.id > 0 {
        state := editor.read_state() >>>
        if state.composing { >>> errors.new("widgets: cannot replace an active IME composition") }
        caret := editor.caret_rect()
        _ := editor.session.update(state.revision,value,value.len,value.len,&caret) >>>
        _ := editor.read_state() >>>
    } else { editor.value = value + ""
        editor.anchor = value.len
        editor.focus = value.len }
    editor.drop_layout()
    editor.reveal_caret = true
    editor.offset_x = 0.0
    editor.offset_y = 0.0
    editor.dirty = true
    << 0
}
fn (editor $&Editor) select_at(x f64,y f64,extend bool,click_streak int) int {
    if !editor.focused { << 0 }
    state := editor.read_state() >>>
    if state.composing { << 0 }
    options := editor.editor_options()
    $reused := editor.layouts.len > 0 && editor.shaped_value == state.value && editor.shaped_width == options.width
    $layouts := []draw.TextLayout{}
    if reused { layouts.push(editor.layouts[0]) }
    else { layouts.push(editor.layout_value(&state.value,&options) >>>) }
    shaped := layouts[0]
    origin_x := editor.text_origin_x(shaped.metrics.width)
    origin_y := editor.text_origin_y(shaped.metrics.height)
    hit := shaped.hit_test(math.max(-1048576.0,math.min(1048576.0,x - origin_x + editor.offset_x)),math.max(-1048576.0,math.min(1048576.0,y - origin_y + editor.offset_y))) >>> (err) {
        if !reused { $owned := shaped
            _ := owned.dispose() }
        >>> err
    }
    if !reused { $owned := shaped
        owned.dispose() >>> }
    index := ui.utf8_clamp_boundary(&state.value,hit.byte_index())
    $anchor := index
    $focus := index
    $drag_mode := 0
    $drag_start := 0
    $drag_end := 0
    if editor.aux.has(0) {
        drag_mode = editor.aux[0].get_drag_mode()
        drag_start = editor.aux[0].get_drag_start()
        drag_end = editor.aux[0].get_drag_end()
    }
    if !editor.is_selectable() {
        drag_mode = 0
    } else if click_streak >= 2 {
        if editor.is_password() {
            drag_mode = 1
            drag_start = 0
            drag_end = state.value.len
            anchor = 0
            focus = state.value.len
        } else if click_streak >= 3 {
            lr := ui.text_line_range(&state.value,index)
            drag_mode = 2
            drag_start = lr.start
            drag_end = lr.end
            anchor = lr.start
            focus = lr.end
        } else {
            wr := ui.text_word_range(&state.value,index)
            drag_mode = 1
            drag_start = wr.start
            drag_end = wr.end
            anchor = wr.start
            focus = wr.end
        }
    } else if extend {
        if editor.is_password() && drag_mode > 0 {
            anchor = 0
            focus = state.value.len
        } else if drag_mode == 2 {
            lr := ui.text_line_range(&state.value,index)
            if lr.start < drag_start {
                anchor = drag_end
                focus = lr.start
            } else if lr.end > drag_end {
                anchor = drag_start
                focus = lr.end
            } else {
                anchor = drag_start
                focus = drag_end
            }
        } else if drag_mode == 1 {
            wr := ui.text_word_range(&state.value,index)
            if wr.start < drag_start {
                anchor = drag_end
                focus = wr.start
            } else if wr.end > drag_end {
                anchor = drag_start
                focus = wr.end
            } else {
                anchor = drag_start
                focus = drag_end
            }
        } else {
            anchor = state.anchor
            focus = index
        }
    } else {
        drag_mode = 0
    }
    if drag_mode != 0 || editor.aux.has(0) {
        $aux := editor.take_aux()
        aux.drag_mode = drag_mode
        aux.drag_start = drag_start
        aux.drag_end = drag_end
        editor.put_aux(aux)
    }
    editor.select_state(&state,anchor,focus) >>>
    editor.reveal_caret = true
    editor.dirty = true
    << 0
}
fn (editor $&Editor) open_context_menu(canvas_x f64,canvas_y f64) bool {
    state := editor.read_state() >>> (err) { << false }
    if state.composing { << false }
    is_pw := editor.is_password()
    sel_ok := editor.is_selectable()
    copy_ok := editor.is_copy_enabled()
    has_sel := sel_ok && !is_pw && state.anchor != state.focus
    can_export := has_sel && copy_ok
    has_text := sel_ok && state.value.len > 0
    $spec := TextMenuSpec{
        show_cut: false,cut_enabled: false,
        show_copy: true,copy_enabled: can_export,
        show_paste: false,paste_enabled: false,
        show_select_all: true,select_all_enabled: has_text,
        show_copy_row: false,copy_row_enabled: false
    }
    if !editor.read_only {
        spec = TextMenuSpec{
            show_cut: true,cut_enabled: can_export,
            show_copy: true,copy_enabled: can_export,
            show_paste: true,paste_enabled: true,
            show_select_all: sel_ok,select_all_enabled: has_text,
            show_copy_row: false,copy_row_enabled: false
        }
    }
    editor.ensure_menu()
    density := editor.density
    $aux := editor.take_aux()
    $m := aux.take_menu()
    m_ref := $&m
    opened := m_ref.open(canvas_x,canvas_y,&spec,density)
    aux.put_menu(m)
    editor.put_aux(aux)
    if opened { editor.dirty = true }
    << opened
}
pub fn (editor $&Editor) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >>> errors.new("widgets: invalid editor route") }
    if !belongs(&editor.identity,event) || editor.closed { << no_action(editor.id,editor.dirty) }
    if kind == ROUTE_FOCUS { editor.focus_session(true) >>>
        << no_action(editor.id,editor.needs_paint()) }
    if kind == ROUTE_BLUR || kind == ROUTE_CANCEL || event.kind == ui.EV_POINTER_CANCEL {
        editor.focus_session(false) >>>
        << no_action(editor.id,editor.needs_paint())
    }
    if !editor.enabled { << no_action(editor.id,editor.needs_paint()) }
    if editor.has_popup_open() {
        canvas_ev := make_local_input(event,editor.bounds.x,editor.bounds.y)
        density := editor.density
        $aux := editor.take_aux()
        $m := aux.take_menu()
        m_ref := $&m
        res := m_ref.input(&canvas_ev,density)
        aux.put_menu(m)
        editor.put_aux(aux)
        if res.dirty { editor.dirty = true }
        if res.cmd == TEXT_MENU_COPY {
            if editor.is_selectable() && !editor.is_password() { editor.run_clipboard_op(2) >>> }
            << Action{kind: ACTION_NONE,id: editor.id,needs_paint: editor.needs_paint(),request_focus: editor.focused,consumed: true,value: 0.0}
        }
        if res.cmd == TEXT_MENU_CUT {
            if editor.is_selectable() && !editor.is_password() && !editor.read_only { editor.run_clipboard_op(3) >>> }
            << Action{kind: ACTION_NONE,id: editor.id,needs_paint: editor.needs_paint(),request_focus: editor.focused,consumed: true,value: 0.0}
        }
        if res.cmd == TEXT_MENU_PASTE {
            if !editor.read_only { editor.run_clipboard_op(1) >>> }
            << Action{kind: ACTION_NONE,id: editor.id,needs_paint: editor.needs_paint(),request_focus: editor.focused,consumed: true,value: 0.0}
        }
        if res.cmd == TEXT_MENU_SELECT_ALL {
            if editor.is_selectable() { editor.select_all_text() >>> }
            << Action{kind: ACTION_NONE,id: editor.id,needs_paint: editor.needs_paint(),request_focus: editor.focused,consumed: true,value: 0.0}
        }
        if res.consumed {
            << Action{kind: ACTION_NONE,id: editor.id,needs_paint: editor.needs_paint(),request_focus: editor.focused,consumed: true,value: 0.0}
        }
    }
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        hot := event.kind != ui.EV_POINTER_LEAVE && event.x >= 0.0 && event.y >= 0.0 && event.x < editor.bounds.width && event.y < editor.bounds.height
        if hot != editor.hovered { editor.hovered = hot
            editor.dirty = true }
    }
    $consumed := false
    $submit := false
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_RIGHT {
        editor.focus_session(true) >>>
        if editor.open_context_menu(editor.bounds.x + event.x,editor.bounds.y + event.y) { consumed = true }
    }
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT {
        editor.focus_session(true) >>>
        $aux := editor.take_aux()
        clicks := $&aux.clicks
        streak := clicks.record(event)
        editor.put_aux(aux)
        editor.dragging = editor.is_selectable()
        editor.select_at(event.x,event.y,(event.modifiers & ui.MOD_SHIFT) != 0,streak) >>>
        consumed = true
    }
    if event.kind == ui.EV_POINTER_MOVE && editor.dragging {
        if editor.is_selectable() { editor.select_at(event.x,event.y,true,0) >>> }
        consumed = true
    }
    if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT {
        was_dragging := editor.dragging
        editor.dragging = false
        editor.clear_drag()
        if was_dragging { consumed = true }
    }
    if editor.focused && (event.kind == ui.EV_KEY_DOWN || event.kind == ui.EV_KEY_UP) {
        consumed = true
        if event.kind == ui.EV_KEY_DOWN {
            if is_context_trigger(event) {
                d := editor.density
                ox := editor.bounds.x + math.min(24.0 * d,editor.bounds.width * 0.5)
                oy := editor.bounds.y + math.min(24.0 * d,editor.bounds.height * 0.5)
                _ := editor.open_context_menu(ox,oy)
            } else {
                editor.restart_caret()
                editor.navigate(event) >>>
                editor.clipboard_key(event) >>>
            }
        }
        submit = !editor.read_only && !editor.is_multiline() && event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_ENTER && event.repeat == 0
    }
    if event.kind == ui.EV_POINTER_SCROLL && editor.is_multiline() && editor.layouts.len > 0 {
        shaped := editor.layouts[0]
        before := editor.offset_y
        editor.offset_y = math.max(0.0,math.min(math.max(0.0,shaped.metrics.height - editor.bounds.height + editor.top() + editor.bottom()),before + event.dy))
        consumed = editor.offset_y != before
        if consumed { editor.reveal_caret = false
            editor.dirty = true }
    }
    $action := ACTION_NONE
    if submit { action = ACTION_SUBMIT }
    << Action{kind: action,id: editor.id,needs_paint: editor.needs_paint(),request_focus: editor.focused,consumed: consumed,value: 0.0}
}
pub fn (editor $&Editor) event(event &ui.Event) Action {
    if event.window_id != editor.identity.window_id { << no_action(editor.id,editor.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED || event.kind == ui.EV_CANVAS_CLOSED {
        if event.kind == ui.EV_CANVAS_CLOSED { identity := ui.canvas_of(event) >>>
            if identity.canvas_id != editor.identity.canvas_id || identity.generation != editor.identity.generation { << no_action(editor.id,editor.dirty) } }
        editor.focus_session(false) >>>
        if event.kind != ui.EV_BLURRED { editor.closed = true
            editor.enabled = false
            editor.drop_layout() }
        << no_action(editor.id,editor.dirty)
    }
    if event.kind == ui.EV_REQUEST { << editor.clipboard_result(event) >>> }
    if event.kind < ui.EV_TEXT_COMMIT || event.kind > ui.EV_TEXT_SURROUNDING_DELETE || editor.session.id == 0 { << no_action(editor.id,editor.dirty) }
    edit := ui.text_edit_of(event) >>>
    if edit.input.id != editor.session.id || edit.input.generation != editor.identity.generation { << no_action(editor.id,editor.dirty) }
    if event.kind == ui.EV_TEXT_INPUT_ENDED || event.kind == ui.EV_TEXT_INPUT_FAILED {
        editor.session.id = 0
        editor.cancel_clipboard()
        editor.focused = false
        editor.dragging = false
        editor.dirty = true
        << no_action(editor.id,true)
    }
    previous := editor.value + ""
    _ := editor.read_state() >>>
    editor.restart_caret()
    editor.reveal_caret = true
    editor.dirty = true
    $action := ACTION_NONE
    if previous != editor.value { action = ACTION_CHANGE }
    << Action{kind: action,id: editor.id,needs_paint: true,request_focus: false,consumed: true,value: 0.0}
}
// Retain the layout until the containing frame has been accepted. painted()
// acknowledges dirtiness, not native resource ownership.
pub fn (editor $&Editor) paint(frame $&draw.Frame,theme &Theme) int {
    $c := editor.appearance.clone()
    c.radius = 0.0
    c.border_width = 0.0
    c.palette.normal = theme.normal
    c.palette.hovered = theme.normal
    c.palette.foreground = theme.foreground
    c.palette.disabled = theme.disabled
    c.palette.muted = theme.muted
    c.palette.selection = theme.accent
    c.palette.selection_text = theme.foreground
    c.palette.focus = theme.focus
    c.palette.placeholder = theme.muted
    << editor.paint_editor(frame,&c) >>>
}
fn (editor $&Editor) paint_editor(frame $&draw.Frame,c &ControlStyle) int {
    if editor.closed { << 0 }
    $value := editor.value + ""
    $anchor := editor.anchor
    $focus := editor.focus
    $composition_start := -1
    $composition_end := -1
    if editor.session.id > 0 { state := editor.read_state() >>>
        value = state.display_value()
        anchor = state.display_anchor()
        focus = state.display_focus()
        if state.composing { composition_start = state.replacement_start
            composition_end = state.replacement_start + state.preedit.len } }
    if !editor.is_selectable() { anchor = focus }
    options := editor.editor_options()
    $reused := editor.layouts.len > 0 && editor.shaped_value == value && editor.shaped_width == options.width
    $layouts := []draw.TextLayout{}
    if reused { layouts.push(editor.layouts[0]) }
    else { layouts.push(editor.layout_value(&value,&options) >>>) }
    shaped := layouts[0]
    caret := shaped.caret(focus,false) >>>
    width := math.max(1.0,editor.bounds.width - editor.left() - editor.right())
    height := math.max(1.0,editor.bounds.height - editor.top() - editor.bottom())
    origin_x := editor.text_origin_x(shaped.metrics.width)
    origin_y := editor.text_origin_y(shaped.metrics.height)
    caret_w := c.caret_width * editor.density
    max_scroll_x := math.max(0.0,math.max(shaped.metrics.width,caret.x + caret_w) - width)
    max_scroll_y := math.max(0.0,shaped.metrics.height - height)
    editor.offset_x = math.max(0.0,math.min(editor.offset_x,max_scroll_x))
    editor.offset_y = math.max(0.0,math.min(editor.offset_y,max_scroll_y))
    if editor.focused {
        if editor.reveal_caret {
        if caret.x < editor.offset_x { editor.offset_x = caret.x }
        if caret.x + caret_w > editor.offset_x + width { editor.offset_x = caret.x + caret_w - width }
        if caret.y < editor.offset_y { editor.offset_y = caret.y }
        if caret.y + caret.height > editor.offset_y + height { editor.offset_y = caret.y + caret.height - height }
        editor.reveal_caret = false
        }
        editor.offset_x = math.max(0.0,math.min(editor.offset_x,max_scroll_x))
        editor.offset_y = math.max(0.0,math.min(editor.offset_y,max_scroll_y))
        transform := ui.text_input_translation(editor.bounds.x + origin_x - editor.offset_x,editor.bounds.y + origin_y - editor.offset_y)
        // A native edit can advance the revision while shaping. Its queued
        // event will repaint; retain the explicit candidate fallback meanwhile.
        if editor.session.id > 0 { editor.bind_geometry(&shaped,&transform) }
    }
    state := editor.visual_state()
    bounds := layout.Rect{x: 0.0,y: 0.0,width: editor.bounds.width,height: editor.bounds.height}
    style_box(frame,&bounds,c,editor.density,state) >>>
    resolved := c.resolve(state)
    foreground := resolved.foreground
    frame.push() >>>
    frame.clip_rect(editor.left(),editor.top(),width,height) >>>
    $sel_rects := []draw.TextSelectionRect{}
    if anchor != focus {
        sel_rects = shaped.selection_rects(int(math.min(f64(anchor),f64(focus))),int(math.max(f64(anchor),f64(focus)))) >>>
        for rect in sel_rects {
            x := origin_x - editor.offset_x + rect.x
            y := origin_y - editor.offset_y + rect.y
            if x + rect.width >= editor.left() && x <= editor.bounds.width - editor.right() && y + rect.height >= editor.top() && y <= editor.bounds.height - editor.bottom() {
                frame.fill_rect(x,y,rect.width,rect.height,resolved.selection) >>>
            }
        }
    }
    if value.len == 0 && !editor.focused {
        if !editor.aux.has(0) || !editor.aux[0].has_placeholder() {
            ph := editor.context.layout_text(&editor.placeholder,&options) >>>
            $aux := editor.take_aux()
            aux.placeholder_layouts.push(ph)
            editor.put_aux(aux)
        }
        pm := editor.aux[0].placeholder_size()
        px := editor.text_origin_x(pm.width)
        py := editor.text_origin_y(pm.height)
        editor.aux[0].paint_placeholder(frame,px,py,resolved.placeholder) >>>
    }
    else { frame.text_layout(&shaped,origin_x - editor.offset_x,origin_y - editor.offset_y,foreground) >>> }
    if anchor != focus {
        for rect in sel_rects {
            x := origin_x - editor.offset_x + rect.x
            y := origin_y - editor.offset_y + rect.y
            if x + rect.width >= editor.left() && x <= editor.bounds.width - editor.right() && y + rect.height >= editor.top() && y <= editor.bounds.height - editor.bottom() {
                frame.push() >>>
                frame.clip_rect(x,y,rect.width,rect.height) >>>
                frame.text_layout(&shaped,origin_x - editor.offset_x,origin_y - editor.offset_y,resolved.selection_text) >>>
                frame.pop() >>>
            }
        }
    }
    if composition_end > composition_start {
        marked := shaped.selection_rects(composition_start,composition_end) >>>
        for rect in marked {
            x := origin_x - editor.offset_x + rect.x
            y := origin_y - editor.offset_y + rect.y + rect.height - c.preedit_width * editor.density
            if x + rect.width >= editor.left() && x <= editor.bounds.width - editor.right() && y >= editor.top() && y <= editor.bounds.height - editor.bottom() {
                frame.fill_rect(x,y,rect.width,c.preedit_width * editor.density,resolved.focus) >>>
            }
        }
    }
    if editor.focused && !editor.read_only && (anchor == focus || composition_start >= 0) && c.caret_width > 0.0 && editor.caret_alpha > 0.0 {
        alpha := int(math.round(f64(resolved.focus.value() & 255) * editor.caret_alpha))
        cw := c.caret_width * editor.density
        cx := math.max(editor.left(),math.min(editor.bounds.width - editor.right() - cw,origin_x + caret.x - editor.offset_x))
        frame.fill_rect(cx,origin_y + caret.y - editor.offset_y,cw,caret.height,resolved.focus.with_alpha(alpha)) >>> }
    frame.pop() >>>
    if !reused {
        editor.drop_layout()
        editor.layouts.push(shaped)
        editor.shaped_value = value + ""
        editor.shaped_width = options.width
    }
    << 0
}
pub fn (editor $&Editor) dispose() {
    editor.cancel_clipboard()
    editor.stash()
    _ := editor.stop_session()
    editor.focused = false
    editor.drop_layout()
    editor.drop_placeholder()
    if editor.aux.has(0) {
        auxs := $&editor.aux
        $aux := auxs.take(0)
        if aux.menus.has(0) {
            $m := aux.take_menu()
            m_ref := $&m
            m_ref.dispose()
        }
    }
    editor.closed = true
    editor.enabled = false
}

fn (editor $&Editor) bind_geometry(shaped &draw.TextLayout,transform &ui.TextInputTransform) {
    shaped.bind_input_transform(&editor.session,editor.revision,transform,false) >>> (err) { editor.dirty = true
        << }
}
