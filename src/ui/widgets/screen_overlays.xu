@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors
#math

// Concrete owning maps retain native control state. A take/put transaction
// keeps mutation local, without dynamic interface boxes or captured borrows.
struct ScreenOverlays {
    popovers map[int]Popover
    tooltips map[int]Tooltip
    toasts map[int]Toast
    modals map[int]Modal
    anchors map[int]int
    notification int
}
// Modal owns only its integer focus order; the remaining fields are scalar
// state. Error rollback duplicates that order, preserving the original error
// without moving a live owner from a conditional catch scope.
fn screen_modal_rollback(control &Modal) Modal {
    mut order := []int{}
    for id in control.order { order.push(id) }
    << Modal{identity: copy_identity(&control.identity),id_val: control.id_val,panel: control.panel.clone_panel(),
        viewport: copy_rect(&control.viewport),order: order,focus_index: control.focus_index,restore_id: control.restore_id,
        restore_pending: control.restore_pending,outside_close: control.outside_close,close_armed: control.close_armed,dirty: control.dirty}
}
fn new_screen_overlays() ScreenOverlays {
    << ScreenOverlays{popovers: map[int]Popover{},tooltips: map[int]Tooltip{},toasts: map[int]Toast{},
        modals: map[int]Modal{},anchors: map[int]int{},notification: 0}
}
fn (s &mut Screen) screen_take_popover(id int) Popover {
    store := mut &s.overlays
    if !store.popovers.has(id) { >> errors.new("widgets: unknown screen popover") }
    values := mut &store.popovers
    << values.take(id)
}
fn (s &mut Screen) screen_put_popover(id int,value Popover) {
    store := mut &s.overlays
    values := mut &store.popovers
    values[id] = value
}
fn (s &mut Screen) screen_take_tooltip(id int) Tooltip {
    store := mut &s.overlays
    if !store.tooltips.has(id) { >> errors.new("widgets: unknown screen tooltip") }
    values := mut &store.tooltips
    << values.take(id)
}
fn (s &mut Screen) screen_put_tooltip(id int,value Tooltip) {
    store := mut &s.overlays
    values := mut &store.tooltips
    values[id] = value
}
fn (s &mut Screen) screen_take_toast(id int) Toast {
    store := mut &s.overlays
    if !store.toasts.has(id) { >> errors.new("widgets: unknown screen toast") }
    values := mut &store.toasts
    << values.take(id)
}
fn (s &mut Screen) screen_put_toast(id int,value Toast) {
    store := mut &s.overlays
    values := mut &store.toasts
    values[id] = value
}
fn (s &mut Screen) screen_take_modal(id int) Modal {
    store := mut &s.overlays
    if !store.modals.has(id) { >> errors.new("widgets: unknown screen modal") }
    values := mut &store.modals
    << values.take(id)
}
fn (s &mut Screen) screen_put_modal(id int,value Modal) {
    store := mut &s.overlays
    values := mut &store.modals
    values[id] = value
}
fn (s &mut Screen) screen_set_anchor(id int,anchor int) {
    store := mut &s.overlays
    anchors := mut &store.anchors
    anchors[id] = anchor
}
fn (s &Screen) screen_overlay_kind(id int) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    << s.nodes[id - 1].kind
}
fn (s &Screen) overlay_anchor(id int) int { << s.overlays.anchors.get_or(id,0) }
fn (s &Screen) overlay_is_visible(id int) bool { << s.overlay_visible(id) }
fn (s &Screen) overlay_is_open(id int) bool {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) { << s.overlays.popovers[id].is_open() }
    if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) { << s.overlays.tooltips[id].is_open() }
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) { << s.overlays.toasts[id].is_open() }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) { << s.overlays.modals[id].is_open() }
    << false
}
fn (s &Screen) overlay_visible(id int) bool {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) { << s.overlays.popovers[id].is_visible() }
    if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) { << s.overlays.tooltips[id].is_visible() }
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) { << s.overlays.toasts[id].is_visible() }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) { << s.overlays.modals[id].is_visible() }
    << false
}
fn (s &Screen) overlay_opacity(id int) f64 {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) { << s.overlays.popovers[id].opacity() }
    if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) { << s.overlays.tooltips[id].opacity() }
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) { << s.overlays.toasts[id].opacity() }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) { << s.overlays.modals[id].opacity() }
    << 0.0
}
fn (s &Screen) overlay_popup(id int) layout.Rect {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) { << s.overlays.popovers[id].bounds() }
    if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) { << s.overlays.tooltips[id].bounds() }
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) { << s.overlays.toasts[id].bounds() }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) { << s.overlays.modals[id].bounds() }
    << screen_empty()
}
fn (s &Screen) overlay_close_bounds(id int) layout.Rect {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_TOAST && s.overlays.toasts.has(id) { << s.overlays.toasts[id].close_bounds() }
    if kind == SCREEN_MODAL && s.overlays.modals.has(id) { << s.overlays.modals[id].close_bounds() }
    << screen_empty()
}

pub fn (s &mut Screen) popover(anchor int,text string) int {
    anchor_bounds := s.bounds(anchor) or >>
    id := s.add_node(SCREEN_POPOVER,false,ui.CURSOR_DEFAULT) or >>
    identity := s.identity
    viewport := s.viewport()
    value := popover(&identity,id,&anchor_bounds,&layout.Size{width: 310.0,height: 146.0},&viewport) or >>
    s.texts[id - 1] = text + ""
    s.screen_put_popover(id,value)
    s.screen_set_anchor(id,anchor)
    s.overlay_place(id) or >>
    s.invalidate()
    << id
}
pub fn (s &mut Screen) tooltip(anchor int,text string) int {
    anchor_bounds := s.bounds(anchor) or >>
    id := s.add_node(SCREEN_TOOLTIP,false,ui.CURSOR_DEFAULT) or >>
    identity := s.identity
    viewport := s.viewport()
    value := tooltip(&identity,id,&anchor_bounds,&layout.Size{width: 280.0,height: 64.0},&viewport) or >>
    s.texts[id - 1] = text + ""
    s.screen_put_tooltip(id,value)
    s.screen_set_anchor(id,anchor)
    s.overlay_place(id) or >>
    s.invalidate()
    << id
}
pub fn (s &mut Screen) toast(text string) int {
    id := s.add_node(SCREEN_TOAST,true,ui.CURSOR_DEFAULT) or >>
    identity := s.identity
    value := toast(&identity,id,&screen_empty()) or >>
    s.texts[id - 1] = text + ""
    s.screen_put_toast(id,value)
    s.overlay_place(id) or >>
    << id
}
pub fn (s &mut Screen) notify(text string) int {
    mut id := s.overlays.notification
    if id <= 0 || !s.overlays.toasts.has(id) {
        id = s.toast(text + "") or >>
        s.overlays.notification = id
    }
    s.show_toast(id,text,time.seconds(3) or >>) or >>
    << id
}
pub fn (s &mut Screen) modal(title string,message string) int {
    id := s.add_node(SCREEN_MODAL,false,ui.CURSOR_DEFAULT) or >>
    identity := s.identity
    viewport := s.viewport()
    panel := layout.Rect{x: (s.width - 460.0) * 0.5,y: (s.height - 280.0) * 0.5,width: 460.0,height: 280.0}
    value := modal(&identity,id,&panel,&viewport) or >>
    s.texts[id - 1] = title + ""
    s.descriptions[id - 1] = message + ""
    s.screen_put_modal(id,value)
    s.overlay_place(id) or >>
    << id
}

fn (s &mut Screen) overlay_place(id int) int {
    node := s.node(id) or >>
    viewport := s.viewport()
    kind := node.kind
    factor := math.max(1.0,math.max(s.styles.density,s.styles.text_scale))
    mut enabled := s.effective_enabled(id) && s.is_visible(id)
    mut bounds := screen_empty()
    if kind == SCREEN_POPOVER || kind == SCREEN_TOOLTIP {
        anchor_id := s.overlays.anchors.get_or(id,0)
        anchor := s.global_bounds(anchor_id) or >>
        enabled = enabled && s.effective_enabled(anchor_id) && s.is_visible(anchor_id)
        mut width := 310.0 * factor
        mut height := 146.0 * factor
        if kind == SCREEN_TOOLTIP { width = 280.0 * factor
            height = 64.0 * factor }
        if node.local.width > 0.0 { width = node.local.width }
        if node.local.height > 0.0 { height = node.local.height }
        width = math.min(width,viewport.width)
        if node.local.height <= 0.0 && s.overlay_is_visible(id) {
            styles := s.styles.clone()
            style := s.overlay_style(id,&styles) or >>
            height = math.max(height,s.caption_height(id,width,&style) or >>)
        }
        size := layout.Size{width: width,height: height}
        if kind == SCREEN_POPOVER {
            mut control := s.screen_take_popover(id) or >>
            control.set_geometry(&anchor,&size,&viewport) or (err) { s.screen_put_popover(id,control.clone_panel())
                >> err }
            control.set_enabled(enabled) or (err) { s.screen_put_popover(id,control.clone_panel())
                >> err }
            bounds = control.bounds()
            s.screen_put_popover(id,control)
        } else {
            mut control := s.screen_take_tooltip(id) or >>
            control.set_geometry(&anchor,&size,&viewport) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
                >> err }
            control.set_enabled(enabled) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
                >> err }
            bounds = control.bounds()
            s.screen_put_tooltip(id,control)
        }
    } else if kind == SCREEN_TOAST {
        mut width := 380.0 * factor
        mut height := 58.0 * factor
        if node.local.width > 0.0 { width = node.local.width }
        if node.local.height > 0.0 { height = node.local.height }
        width = math.min(width,math.max(0.0,viewport.width - 24.0))
        if node.local.height <= 0.0 && s.overlay_is_visible(id) {
            styles := s.styles.clone()
            style := s.overlay_style(id,&styles) or >>
            mut reserved := 32.0
            if s.notice_slot(id) >= 0 && s.descriptions[id - 1].len > 0 { reserved += math.min(96.0 * math.max(styles.density,styles.text_scale),math.max(0.0,width - 64.0)) }
            height = math.max(height,s.caption_height(id,math.max(1.0,width - reserved),&style) or >>)
        }
        height = math.min(height,math.max(0.0,viewport.height - 24.0))
        bounds = layout.Rect{x: math.max(viewport.x,viewport.x + viewport.width - width - 16.0),
            y: math.max(viewport.y,viewport.y + viewport.height - height - 16.0),width: width,height: height}
        slot := s.notice_slot(id)
        if slot >= 0 { mut offset := 0.0
            for index in 0:slot { previous := s.notices.handles[index]
                offset += s.nodes[previous - 1].bounds.height + 10.0 }
            bounds.y = math.max(viewport.y + 12.0,bounds.y - offset) }
        mut control := s.screen_take_toast(id) or >>
        control.set_bounds(&bounds) or (err) { s.screen_put_toast(id,control.clone_toast())
            >> err }
        control.set_enabled(enabled) or (err) { s.screen_put_toast(id,control.clone_toast())
            >> err }
        s.screen_put_toast(id,control)
    } else if kind == SCREEN_MODAL {
        mut width := 460.0 * factor
        mut height := 280.0 * factor
        if node.local.width > 0.0 { width = node.local.width }
        if node.local.height > 0.0 { height = node.local.height }
        width = math.min(width,viewport.width)
        height = math.min(height,viewport.height)
        panel := layout.Rect{x: viewport.x + (viewport.width - width) * 0.5,y: viewport.y + (viewport.height - height) * 0.5,width: width,height: height}
        mut control := s.screen_take_modal(id) or >>
        control.set_geometry(&panel,&viewport) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
        control.set_enabled(enabled) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
        bounds = control.bounds()
        s.screen_put_modal(id,control)
    } else { >> errors.new("widgets: expected screen overlay") }
    mut next := node
    next.bounds = bounds
    s.nodes[id - 1] = next
    << 0
}
pub fn (s &mut Screen) open(id int) int {
    s.overlay_place(id) or >>
    kind := s.screen_overlay_kind(id)
    now := s.now
    reduced := s.reduced
    if kind == SCREEN_POPOVER {
        mut control := s.screen_take_popover(id) or >>
        control.open(now,reduced) or (err) { s.screen_put_popover(id,control.clone_panel())
            >> err }
        s.screen_put_popover(id,control)
        s.popover_enter(id) or >>
    } else if kind == SCREEN_TOOLTIP {
        mut control := s.screen_take_tooltip(id) or >>
        control.set_focus(true,now) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
            >> err }
        _ := control.tick(now,reduced) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
            >> err }
        s.screen_put_tooltip(id,control)
    } else if kind == SCREEN_TOAST {
        text := s.texts[id - 1] + ""
        s.show_toast(id,text,time.seconds(3) or >>) or >>
    } else if kind == SCREEN_MODAL {
        restore := s.focused
        s.cancel_all() or >>
        mut control := s.screen_take_modal(id) or >>
        control.open(now,reduced,restore) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
        s.screen_put_modal(id,control)
        mut order := []int{}
        for child in s.nodes {
            if child.id > 0 && child.id != id && child.focusable && child.enabled && s.is_visible(child.id) && s.is_descendant(child.id,id) {
                if order.len >= 256 { s.close_overlay(id) or >>
                    >> errors.new("widgets: too many screen modal focus targets") }
                order.push(child.id)
            }
        }
        mut panel := s.screen_take_modal(id) or >>
        panel.set_focus_order(&order) or (err) { s.screen_put_modal(id,screen_modal_rollback(&panel))
            >> err }
        first := panel.focused_id()
        s.screen_put_modal(id,panel)
        s.focus(first) or >>
    } else { >> errors.new("widgets: expected screen overlay") }
    s.invalidate()
    << 0
}
pub fn (s &mut Screen) close_overlay(id int) int {
    kind := s.screen_overlay_kind(id)
    now := s.now
    reduced := s.reduced
    if kind == SCREEN_POPOVER {
        mut control := s.screen_take_popover(id) or >>
        control.close(now,reduced) or (err) { s.screen_put_popover(id,control.clone_panel())
            >> err }
        s.screen_put_popover(id,control)
        s.popover_restore(id) or >>
    } else if kind == SCREEN_TOOLTIP {
        mut control := s.screen_take_tooltip(id) or >>
        control.dismiss(now,reduced) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
            >> err }
        s.screen_put_tooltip(id,control)
    } else if kind == SCREEN_TOAST {
        mut control := s.screen_take_toast(id) or >>
        control.dismiss(now,reduced) or (err) { s.screen_put_toast(id,control.clone_toast())
            >> err }
        s.screen_put_toast(id,control)
    } else if kind == SCREEN_MODAL {
        mut control := s.screen_take_modal(id) or >>
        control.close(now,reduced) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
        s.screen_put_modal(id,control)
        s.focus(0) or >>
    } else { >> errors.new("widgets: expected screen overlay") }
    s.invalidate()
    << 0
}
pub fn (s &mut Screen) show_toast(id int,text string,duration time.Duration) int {
    if duration.is_negative() { >> errors.new("widgets: negative screen toast duration") }
    if s.screen_overlay_kind(id) != SCREEN_TOAST { >> errors.new("widgets: expected screen toast") }
    s.overlay_place(id) or >>
    now := s.now
    reduced := s.reduced
    mut control := s.screen_take_toast(id) or >>
    control.show(now,duration,reduced) or (err) { s.screen_put_toast(id,control.clone_toast())
        >> err }
    s.screen_put_toast(id,control)
    s.texts[id - 1] = text + ""
    s.invalidate()
    << 0
}

fn (s &mut Screen) overlay_input(id int,event &ui.InputEvent) Action {
    notice_action := s.notice_input(id,event) or >>
    if notice_action.consumed { << notice_action }
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER {
        if event.kind == ui.EV_POINTER_DOWN && (s.popover_candidate_hit(id,event.x,event.y) or >>) { << no_action(id,false) }
        mut control := s.screen_take_popover(id) or >>
        visible := control.is_visible()
        was_open := control.is_open()
        bounds := control.bounds()
        mut result := control.input(event) or (err) { s.screen_put_popover(id,control.clone_panel())
            >> err }
        now_open := control.is_open()
        s.screen_put_popover(id,control)
        if was_open && !now_open { s.popover_restore(id) or >> }
        pointer := (event.kind >= ui.EV_POINTER_DOWN && event.kind <= ui.EV_POINTER_CANCEL) || event.kind == ui.EV_POINTER_SCROLL
        if visible && pointer && bounds.contains(event.x,event.y) && (!now_open || !s.popover_has_content(id)) { result.consumed = true }
        << result
    }
    if kind == SCREEN_TOOLTIP {
        mut control := s.screen_take_tooltip(id) or >>
        result := control.input(event) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
            >> err }
        s.screen_put_tooltip(id,control)
        << result
    }
    if kind == SCREEN_TOAST {
        mut control := s.screen_take_toast(id) or >>
        result := control.input(event) or (err) { s.screen_put_toast(id,control.clone_toast())
            >> err }
        s.screen_put_toast(id,control)
        << result
    }
    if kind == SCREEN_MODAL { << s.overlay_modal_input(id,event) or >> }
    << no_action(id,false)
}
fn (s &mut Screen) overlay_modal_input(id int,event &ui.InputEvent) Action {
    mut control := s.screen_take_modal(id) or >>
    result := control.input(event) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
        >> err }
    s.screen_put_modal(id,control)
    << result
}
fn (s &mut Screen) overlay_focus(id int,focused bool,now time.Instant) int {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_TOOLTIP {
        mut control := s.screen_take_tooltip(id) or >>
        control.set_focus(focused,now) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
            >> err }
        s.screen_put_tooltip(id,control)
    } else if kind == SCREEN_TOAST {
        mut control := s.screen_take_toast(id) or >>
        control.set_focus(focused,now) or (err) { s.screen_put_toast(id,control.clone_toast())
            >> err }
        s.screen_put_toast(id,control)
    }
    << 0
}
fn (s &mut Screen) overlay_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    kind := s.screen_overlay_kind(id)
    mut changed := false
    mut deadline := time.zero_instant()
    if kind == SCREEN_POPOVER {
        mut control := s.screen_take_popover(id) or >>
        changed = control.tick(now,reduced) or (err) { s.screen_put_popover(id,control.clone_panel())
            >> err }
        deadline = control.next_tick(now) or (err) { s.screen_put_popover(id,control.clone_panel())
            >> err }
        s.screen_put_popover(id,control)
    } else if kind == SCREEN_TOOLTIP {
        mut control := s.screen_take_tooltip(id) or >>
        changed = control.tick(now,reduced) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
            >> err }
        deadline = control.next_tick(now) or (err) { s.screen_put_tooltip(id,control.clone_tooltip())
            >> err }
        s.screen_put_tooltip(id,control)
    } else if kind == SCREEN_TOAST {
        mut control := s.screen_take_toast(id) or >>
        changed = control.tick(now,reduced) or (err) { s.screen_put_toast(id,control.clone_toast())
            >> err }
        deadline = control.next_tick(now) or (err) { s.screen_put_toast(id,control.clone_toast())
            >> err }
        s.screen_put_toast(id,control)
    } else if kind == SCREEN_MODAL {
        mut control := s.screen_take_modal(id) or >>
        changed = control.tick(now,reduced) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
        deadline = control.next_tick(now) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
        s.screen_put_modal(id,control)
    }
    << ScreenAnimation{changed: changed,deadline: deadline}
}
fn (s &mut Screen) overlay_paint(id int,frame &mut draw.Frame,styles &Styles) int {
    kind := s.screen_overlay_kind(id)
    if !s.overlay_visible(id) { << 0 }
    bounds := s.overlay_popup(id)
    opacity := s.overlay_opacity(id)
    if kind == SCREEN_POPOVER {
        mut control := s.screen_take_popover(id) or >>
        control.paint_styled(frame,styles) or (err) { s.screen_put_popover(id,control.clone_panel())
            >> err }
        s.screen_put_popover(id,control)
        c := s.overlay_style(id,styles) or >>
        s.paint_text(id,frame,&bounds,&c,opacity) or >>
    } else if kind == SCREEN_TOOLTIP {
        c := s.overlay_style(id,styles) or >>
        faded := c.with_opacity(opacity) or >>
        paint_box_styled(frame,&bounds,styles,&faded,0) or >>
        s.paint_text(id,frame,&bounds,&c,opacity) or >>
    } else if kind == SCREEN_TOAST {
        c := s.overlay_style(id,styles) or >>
        faded := c.with_opacity(opacity) or >>
        paint_box_styled(frame,&bounds,styles,&faded,0) or >>
        close := s.overlay_close_bounds(id)
        text := layout.Rect{x: bounds.x,y: bounds.y,width: math.max(0.0,bounds.width - close.width - s.notice_action_bounds(id).width),height: bounds.height}
        s.paint_text(id,frame,&text,&c,opacity) or >>
        action_bounds := s.notice_action_bounds(id)
        if action_bounds.width > 0.0 { mut action_style := c.clone()
            action_style.palette.foreground = c.palette.accent
            action_style.align_x = 0.5
            s.paint_caption(id,true,frame,&action_bounds,&action_style,opacity) or >> }
        ink := faded.resolve(0).foreground
        x := close.x + close.width * 0.5
        y := close.y + close.height * 0.5
        half := math.min(4.0,close.width * 0.2)
        frame.line(x - half,y - half,x + half,y + half,ink,1.5) or >>
        frame.line(x + half,y - half,x - half,y + half,ink,1.5) or >>
        if s.focused == id { frame.stroke_rect(close.x + 3.0,close.y + 3.0,math.max(0.0,close.width - 6.0),math.max(0.0,close.height - 6.0),faded.resolve(0).focus,1.0) or >> }
    } else if kind == SCREEN_MODAL {
        mut control := s.screen_take_modal(id) or >>
        control.paint_styled(frame,styles) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
        s.screen_put_modal(id,control)
    }
    << 0
}
fn (s &mut Screen) overlay_painted(id int) int {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER { mut control := s.screen_take_popover(id) or >>
        control.painted()
        s.screen_put_popover(id,control) }
    else if kind == SCREEN_TOOLTIP { mut control := s.screen_take_tooltip(id) or >>
        control.painted()
        s.screen_put_tooltip(id,control) }
    else if kind == SCREEN_TOAST { mut control := s.screen_take_toast(id) or >>
        control.painted()
        s.screen_put_toast(id,control) }
    else if kind == SCREEN_MODAL { mut control := s.screen_take_modal(id) or >>
        control.painted()
        s.screen_put_modal(id,control) }
    << 0
}
fn (s &Screen) modal_blocks() int {
    mut index := s.nodes.len
    while index > 0 {
        index = index - 1
        node := s.nodes[index]
        if node.kind == SCREEN_MODAL && node.visible && s.overlays.modals.has(node.id) && s.overlays.modals[node.id].blocks_input() { << node.id }
    }
    << 0
}
fn (s &Screen) modal_focused(id int) int {
    if !s.overlays.modals.has(id) { << 0 }
    << s.overlays.modals[id].focused_id()
}
fn (s &mut Screen) modal_restore(id int) int {
    if !s.overlays.modals.has(id) { << 0 }
    mut control := s.screen_take_modal(id) or >>
    restore := control.take_restore_focus()
    s.screen_put_modal(id,control)
    << restore
}
fn (s &mut Screen) modal_sync_focus(id int,child int) int {
    if child <= 0 || !s.overlays.modals.has(id) { << 0 }
    mut control := s.screen_take_modal(id) or >>
    if control.is_open() && control.contains_focus(child) {
        control.set_content_focus(child) or (err) { s.screen_put_modal(id,screen_modal_rollback(&control))
            >> err }
    }
    s.screen_put_modal(id,control)
    << 0
}
fn (s &mut Screen) overlay_dispose(id int) int {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER && s.overlays.popovers.has(id) {
        mut control := s.screen_take_popover(id) or >>
        control.set_enabled(false) or >>
    } else if kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) {
        mut control := s.screen_take_tooltip(id) or >>
        control.set_enabled(false) or >>
    } else if kind == SCREEN_TOAST && s.overlays.toasts.has(id) {
        mut control := s.screen_take_toast(id) or >>
        control.set_enabled(false) or >>
        if s.overlays.notification == id { s.overlays.notification = 0 }
    } else if kind == SCREEN_MODAL && s.overlays.modals.has(id) {
        mut control := s.screen_take_modal(id) or >>
        control.set_enabled(false) or >>
    }
    store := mut &s.overlays
    anchors := mut &store.anchors
    anchors.delete(id)
    << 0
}

fn (s &mut Screen) overlay_style(id int,styles &Styles) ControlStyle {
    kind := s.screen_overlay_kind(id)
    if kind == SCREEN_POPOVER { item := s.screen_take_popover(id) or >>
        result := item.style_or(styles)
        s.screen_put_popover(id,item)
        << result }
    if kind == SCREEN_TOOLTIP { item := s.screen_take_tooltip(id) or >>
        result := item.panel.style_or(styles)
        s.screen_put_tooltip(id,item)
        << result }
    if kind == SCREEN_TOAST { item := s.screen_take_toast(id) or >>
        result := item.style_or(styles)
        s.screen_put_toast(id,item)
        << result }
    if kind == SCREEN_MODAL { item := s.screen_take_modal(id) or >>
        result := item.panel.style_or(styles)
        s.screen_put_modal(id,item)
        << result }
    << styles.overlay_style()
}
