@ui/widgets

#ui
#ui/layout
#time
#math
#errors

fn (c &Chart) series_index(id int) int {
    for i in 0:c.series.len { if c.series[i].id == id { << i } }
    << -1
}
fn (c &Chart) datum_visible(index int) bool {
    if index < 0 || index >= c.data.len { << false }
    p := &c.data[index]
    i := c.series_index(p.series)
    << i >= 0 && c.series_is_visible(i) && p.opacity > 0.001
}
fn (c &Chart) datum_hit(index int) ChartHit {
    if index < 0 || index >= c.data.len || !c.datum_visible(index) { << chart_no_hit() }
    p := &c.data[index]
    << ChartHit{valid: true,series_id: p.series,point_id: p.id,x: p.x,y: p.y,
        low: p.low,high: p.high,close: p.close,size: p.size,label: p.label + ""}
}
pub fn (c &Chart) hovered() ChartHit { << c.datum_hit(c.hot) }
pub fn (c &Chart) selection() ChartHit { << c.datum_hit(c.selected) }
pub fn (c $&Chart) select_point(series_id int,point_id int) int {
    if series_id == 0 && point_id == 0 { c.selected = -1
        c.control.dirty = true
        << 0 }
    for i in 0:c.data.len {
        matches := c.data[i].series == series_id && c.data[i].id == point_id && c.data[i].target_opacity > 0.0
        if matches && c.datum_visible(i) { c.selected = i
            c.control.dirty = true
            << 0 } }
    >> errors.new("widgets: chart point is unavailable")
}
fn (c &Chart) series_is_visible(index int) bool { << index >= 0 && index < c.series.len && (c.disabled_series & (1 << index)) == 0 }
pub fn (c $&Chart) set_series_visible(series_id int,visible bool) int {
    index := c.series_index(series_id)
    if index < 0 { >> errors.new("widgets: chart series is unavailable") }
    bit := 1 << index
    if visible { c.disabled_series = c.disabled_series & (0 - 1 - bit) }
    else { c.disabled_series = c.disabled_series | bit }
    c.hot = -1
    c.selected = -1
    if !c.fixed_domain { c.use_auto_domain() }
    c.control.dirty = true
    << 0
}
pub fn (c &Chart) series_visible(series_id int) bool {
    index := c.series_index(series_id)
    if index < 0 { >> errors.new("widgets: chart series is unavailable") }
    << c.series_is_visible(index)
}
fn (c &Chart) donut_total() f64 {
    $total := 0.0
    for i in 0:c.data.len { if c.datum_visible(i) { total = total + c.donut_value(i) } }
    << total
}
fn (c &Chart) donut_value(index int) f64 { << math.max(0.0,c.data[index].y) * c.data[index].opacity }
fn (c &Chart) hit_donut(x f64,y f64) int {
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.5
    radius := math.min(c.plot.width,c.plot.height) * 0.44
    dx := x - cx
    dy := y - cy
    distance := math.sqrt(dx * dx + dy * dy)
    $inner := radius * c.appearance.inner_radius
    if c.pie() { inner = 0.0 }
    else if c.rose() { inner = radius * 0.16 }
    if distance > radius + 8.0 || distance < inner { << -1 }
    $angle := math.atan2(dy,dx) + math.pi() * 0.5
    if angle < 0.0 { angle = angle + math.pi() * 2.0 }
    if c.rose() {
        count := c.funnel_visible_count()
        max_v := c.funnel_max()
        if count <= 0 || max_v <= 0.0 { << -1 }
        sweep := math.pi() * 2.0 / f64(count)
        $end := 0.0
        for i in 0:c.data.len {
            if c.datum_visible(i) && c.data[i].y > 0.0 {
                end = end + sweep
                if angle < end {
                    outer := inner + (radius - inner) * (c.donut_value(i) / max_v)
                    if distance <= outer + 8.0 && c.data[i].target_opacity > 0.0 { << i }
                    << -1
                }
            }
        }
        << -1
    }
    total := c.donut_total()
    if total <= 0.0 { << -1 }
    $end := 0.0
    for i in 0:c.data.len { if c.datum_visible(i) { end = end + c.donut_value(i) / total * math.pi() * 2.0
        if angle < end { if c.data[i].target_opacity > 0.0 { << i }
            << -1 } } }
    << -1
}
fn (c &Chart) hit_gauge(x f64,y f64) int {
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.54
    dx := x - cx
    dy := y - cy
    distance := math.sqrt(dx * dx + dy * dy)
    count := c.gauge_visible_count()
    $rank := 0
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 {
            radii := c.gauge_ring_radii(rank,count)
            if distance >= radii.x - 6.0 && distance <= radii.y + 6.0 { << i }
            rank = rank + 1
        }
    }
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 && distance <= math.min(c.plot.width,c.plot.height) * 0.46 { << i }
    }
    << -1
}
fn (c &Chart) hit_funnel(x f64,y f64) int {
    cx := c.plot.x + c.plot.width * 0.5
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 && c.data[i].y > 0.0 {
            stage := c.funnel_stage(i,0.0)
            if y >= stage.y_min && y <= stage.y_max {
                t := (y - stage.y_min) / math.max(1.0,stage.y_max - stage.y_min)
                half_w := motion_lerp(stage.x_min,stage.x_max,t) * 0.5 + 8.0
                if math.abs(x - cx) <= half_w { << i }
            }
        }
    }
    << -1
}
pub fn (c &Chart) hit_test(x f64,y f64) ChartHit { << c.datum_hit(c.hit_index(x,y)) }
fn (c &Chart) hit_index(x f64,y f64) int {
    if !c.plot.contains(x,y) { << -1 }
    if c.slice_chart() { << c.hit_donut(x,y) }
    if c.gauge() { << c.hit_gauge(x,y) }
    if c.funnel() { << c.hit_funnel(x,y) }
    $nearest := -1
    $distance := c.appearance.hit_radius * c.appearance.hit_radius
    for i in 0:c.data.len {
        if c.datum_visible(i) && c.data[i].target_opacity > 0.0 {
            p := &c.data[i]
            si := c.series_index(p.series)
            kind := c.series[si].kind
            if kind == CHART_HEATMAP && c.heatmap_cell_bounds(i).contains(x,y) { << i }
            if datum_uses_bar_bounds(kind) && c.bar_bounds(i).contains(x,y) { << i }
            position := c.datum_position(i)
            if c.plot.contains(position.x,position.y) {
                dx := position.x - x
                dy := position.y - y
                squared := dx * dx + dy * dy
                $limit := distance
                if kind == CHART_BUBBLE {
                    r := c.bubble_radius(i,1.0) + 4.0
                    limit = math.max(limit,r * r)
                }
                if squared < limit { distance = math.min(distance,squared)
                    nearest = i }
            }
        }
    }
    << nearest
}
fn (c &Chart) legend_hit(x f64,y f64) int {
    for i in 0:c.legend_boxes.len { if c.legend_boxes[i].contains(x,y) { << i } }
    << -1
}
fn (c $&Chart) set_hot(index int) int {
    if c.hot == index { << 0 }
    c.hot = index
    c.control.dirty = true
    now := c.now
    duration := c.motion.hover
    reduced := c.reduced
    emphasis := $&c.emphasis
    emphasis.snap(0.0) or >>
    emphasis.retarget(1.0,now,duration,reduced) or >>
    << 0
}
fn chart_clamp_axis(start f64,span f64) f64 { << math.max(0.0,math.min(1.0 - span,start)) }
fn (c $&Chart) zoom_at(x f64,y f64,factor f64) {
    old := c.viewport()
    fx := math.max(0.0,math.min(1.0,(x - c.plot.x) / math.max(1.0,c.plot.width)))
    fy := math.max(0.0,math.min(1.0,1.0 - (y - c.plot.y) / math.max(1.0,c.plot.height)))
    width := math.max(0.02,math.min(1.0,(old.x_max - old.x_min) * factor))
    height := math.max(0.02,math.min(1.0,(old.y_max - old.y_min) * factor))
    left := chart_clamp_axis(old.x_min + (old.x_max - old.x_min - width) * fx,width)
    bottom := chart_clamp_axis(old.y_min + (old.y_max - old.y_min - height) * fy,height)
    c.viewport = ChartDomain{x_min: left,x_max: left + width,y_min: bottom,y_max: bottom + height}
    c.hot = -1
    c.control.dirty = true
}
pub fn (c $&Chart) input(event &ui.InputEvent) Action {
    if c.control.closed || !belongs(&c.control.identity,event) { << no_action(c.id(),c.needs_paint()) }
    if event.kind == ui.EV_POINTER_CANCEL { c.cancel()
        << no_action(c.id(),c.needs_paint()) }
    if !c.is_enabled() { << no_action(c.id(),c.needs_paint()) }
    if event.time_ns > 0 { c.now = time.instant_from_ns(event.time_ns) or >> }
    $action := no_action(c.id(),c.needs_paint())
    writable := !c.control.read_only
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER {
        if c.dragging && writable {
            dx := event.x - c.drag_x
            dy := event.y - c.drag_y
            if math.abs(dx) + math.abs(dy) > 4.0 { c.moved = true }
            if c.moved && c.appearance.pan && !c.polar_or_radial() {
                width := c.drag_view.x_max - c.drag_view.x_min
                height := c.drag_view.y_max - c.drag_view.y_min
                left := chart_clamp_axis(c.drag_view.x_min - dx / math.max(1.0,c.plot.width) * width,width)
                bottom := chart_clamp_axis(c.drag_view.y_min + dy / math.max(1.0,c.plot.height) * height,height)
                c.viewport = ChartDomain{x_min: left,x_max: left + width,y_min: bottom,y_max: bottom + height}
                c.control.dirty = true
                action.kind = ACTION_CHART_VIEWPORT
                action.consumed = true
            }
        } else {
            next := c.hit_index(event.x,event.y)
            if next != c.hot { c.set_hot(next) or >>
                action.kind = ACTION_CHART_HOVER }
        }
    } else if event.kind == ui.EV_POINTER_LEAVE && !c.dragging { if c.hot >= 0 { c.set_hot(-1) or >>
        action.kind = ACTION_CHART_HOVER } }
    else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && c.bounds().contains(event.x,event.y) {
        action.request_focus = true
        action.consumed = true
        legend := c.legend_hit(event.x,event.y)
        if writable && legend >= 0 { c.armed = 0 - 100 - legend }
        else if writable && c.plot.contains(event.x,event.y) {
            if event.click_count >= 2 && !c.polar_or_radial() { c.reset_viewport()
                action.kind = ACTION_CHART_VIEWPORT }
            else { c.armed = c.hit_index(event.x,event.y)
                c.dragging = true
                c.moved = false
                c.drag_x = event.x
                c.drag_y = event.y
                c.drag_view = c.viewport() }
        }
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && writable {
        if c.armed <= -100 { legend := 0 - 100 - c.armed
            if legend == c.legend_hit(event.x,event.y) && legend < c.series.len { id := c.series[legend].id
                c.set_series_visible(id,!c.series_is_visible(legend)) or >>
                action.kind = ACTION_CHART_LEGEND
                action.value = f64(id) }
            action.consumed = true }
        else if c.dragging { action.consumed = true
            if !c.moved && c.armed >= 0 && c.armed == c.hit_index(event.x,event.y) { c.selected = c.armed
                c.control.dirty = true
                action.kind = ACTION_CHART_SELECT
                action.value = f64(c.data[c.selected].id) }
        }
        c.cancel_drag()
    } else if event.kind == ui.EV_POINTER_SCROLL && writable && c.appearance.zoom && !c.polar_or_radial() && c.plot.contains(event.x,event.y) &&
        (event.modifiers & (ui.MOD_CONTROL | ui.MOD_META)) != 0 && event.dy != 0.0 {
        factor := math.exp(math.max(0.0 - 1.0,math.min(1.0,event.dy * 0.004)))
        c.zoom_at(event.x,event.y,factor)
        action.kind = ACTION_CHART_VIEWPORT
        action.consumed = true
    } else if event.kind == ui.EV_KEY_DOWN && c.control.focused {
        if event.key == ui.KEY_ESCAPE { if writable { c.selected = -1 }
            c.set_hot(-1) or >>
            action.kind = ACTION_CHART_SELECT
            action.consumed = true }
        else if writable && (event.key == ui.KEY_HOME || event.key == 48) { c.reset_viewport()
            action.kind = ACTION_CHART_VIEWPORT
            action.consumed = true }
        else if writable && (event.key == 43 || event.key == 61 || event.key == 45) && c.appearance.zoom && !c.polar_or_radial() {
            $factor := 0.8
            if event.key == 45 { factor = 1.25 }
            c.zoom_at(c.plot.x + c.plot.width * 0.5,c.plot.y + c.plot.height * 0.5,factor)
            action.kind = ACTION_CHART_VIEWPORT
            action.consumed = true }
        else if event.key == ui.KEY_LEFT || event.key == ui.KEY_RIGHT || event.key == ui.KEY_UP || event.key == ui.KEY_DOWN {
            $index := c.hot
            $direction := 1
            if event.key == ui.KEY_LEFT || event.key == ui.KEY_UP { direction = -1 }
            if index < 0 && direction < 0 { index = c.data.len }
            for attempt in 0:c.data.len { index = (index + direction + c.data.len) % max_int(1,c.data.len)
                if c.datum_visible(index) && c.data[index].target_opacity > 0.0 { c.set_hot(index) or >>
                    <- } }
            action.kind = ACTION_CHART_HOVER
            action.consumed = true }
        else if writable && event.key == ui.KEY_ENTER && event.repeat == 0 && c.hot >= 0 { c.selected = c.hot
            c.control.dirty = true
            action.kind = ACTION_CHART_SELECT
            action.value = f64(c.data[c.selected].id)
            action.consumed = true }
    }
    action.needs_paint = c.needs_paint()
    << action
}
pub fn (c $&Chart) route(kind int,event &ui.InputEvent) Action {
    if kind == ROUTE_FOCUS { c.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { c.cancel() }
    else if kind == ROUTE_INPUT { << c.input(event) or >> }
    else { >> errors.new("widgets: invalid chart route") }
    << no_action(c.id(),c.needs_paint())
}
