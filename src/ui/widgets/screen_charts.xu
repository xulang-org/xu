@ui/widgets
#errors
#ui/layout
pub fn (s $&Screen) set_chart_series(id int,series &[]ChartSeries) int {
    node := s.node(id) or >>
    stamp := s.now
    reduced := s.reduced
    if node.kind != SCREEN_CHART { >> errors.new("widgets: wrong visual control type") }
    owner := $&s.controls
    entries := $&owner.charts
    $item := entries.take(id)
    item.now = stamp
    item.reduced = reduced
    result := screen_set_chart_series($&item,series)
    entries[id] = item
    if result.len > 0 { >> errors.new(result) }
    s.dirty = true
    << 0
}
fn screen_set_chart_series(item $&Chart,series &[]ChartSeries) string {
    item.set_series(series) or (err) { << err.msg() }
    << ""
}
