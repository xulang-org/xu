@ui/widgets

#ui/draw
#ui/layout
#strings
#unicode/utf8
#math

fn (list &mut ChoiceList) paint_match(index int,text &string,frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,c &ControlStyle) int {
    if list.query.len==0 { << 0 }
    needle := strings.to_lower(&list.query)
    folded := strings.to_lower(text)
    start := strings.index_of(&folded,needle+"")
    if start<0 || start+needle.len>text.len { << 0 }
    prefix := text[0:start]
    matched_text := text[start:start+needle.len]
    if !utf8.valid(&prefix) || !utf8.valid(&matched_text) { << 0 }
    // Lowercasing can change UTF-8 byte lengths. Only highlight an exact
    // boundary match; filtering still works when the mapping differs.
    before := strings.to_lower(&prefix)
    matched := strings.to_lower(&matched_text)
    if before.len!=start || matched!=needle { << 0 }
    labels := mut &list.labels
    left := labels.measure(512+index*2,&prefix,styles,c) or >>
    width := labels.measure(513+index*2,&matched_text,styles,c) or >>
    d := styles.density
    x := bounds.x+c.padding.left*d+left.width
    highlight := layout.Rect{x:x,y:bounds.y+(bounds.height-width.height)*0.5,width:width.width,height:math.min(bounds.height,width.height)}
    rounded_fill(frame,&highlight,2.0*d,fade_color(c.palette.accent,0.16)) or >>
    << 0
}
