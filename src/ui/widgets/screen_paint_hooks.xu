@ui/widgets

#ui/draw
#ui/layout
#time
#errors

fn default_paint_hook(ctx &PaintHookContext,styles &Styles,frame $&draw.Frame) string {
    _ := ctx
    _ := styles
    _ := frame
    << ""
}

pub struct PaintHookContext {
    pub id int
    pub bounds layout.Rect
    pub enabled bool
    pub focused bool
    pub focused_within bool
    pub hovered bool
    pub hovered_within bool
    pub pressed bool
    pub opacity f64
    pub surface_state int
    pub now time.Instant
    pub reduced_motion bool
}

struct NodePaintHook {
    before_fn fn (&PaintHookContext,&Styles,$&draw.Frame) string
    after_fn fn (&PaintHookContext,&Styles,$&draw.Frame) string
    has_before bool
    has_after bool
}

fn empty_node_paint_hook() NodePaintHook {
    << NodePaintHook{
        before_fn: default_paint_hook,
        after_fn: default_paint_hook,
        has_before: false,
        has_after: false
    }
}

pub fn (s $&Screen) set_before_paint(id int,f fn (&PaintHookContext,&Styles,$&draw.Frame) string) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    phs := $&comp.paint_hooks
    $hook := empty_node_paint_hook()
    had := phs.has(id)
    if had { hook = phs.take(id) }
    else { comp.paint_hook_count = comp.paint_hook_count + 1 }
    hook.before_fn = f
    hook.has_before = true
    phs[id] = hook
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) set_after_paint(id int,f fn (&PaintHookContext,&Styles,$&draw.Frame) string) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    phs := $&comp.paint_hooks
    $hook := empty_node_paint_hook()
    had := phs.has(id)
    if had { hook = phs.take(id) }
    else { comp.paint_hook_count = comp.paint_hook_count + 1 }
    hook.after_fn = f
    hook.has_after = true
    phs[id] = hook
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) clear_paint_hooks(id int) int {
    _ := s.node(id) >>>
    if s.composition.paint_hooks.has(id) {
        comp := $&s.composition
        phs := $&comp.paint_hooks
        phs.delete(id)
        if comp.paint_hook_count > 0 { comp.paint_hook_count = comp.paint_hook_count - 1 }
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) has_paint_hooks(id int) bool {
    _ := s.node(id) >>>
    << s.composition.paint_hooks.has(id)
}

fn (s &Screen) make_paint_hook_context(id int,opacity f64) PaintHookContext {
    n := s.nodes[id - 1]
    hw := s.hovered > 0 && s.is_descendant(s.hovered,id)
    fw := s.focused > 0 && s.is_descendant(s.focused,id)
    << PaintHookContext{
        id: id,
        bounds: layout.Rect{x: n.bounds.x,y: n.bounds.y,width: n.bounds.width,height: n.bounds.height},
        enabled: s.effective_enabled(id),
        focused: s.focused == id,
        focused_within: fw,
        hovered: s.hovered == id,
        hovered_within: hw,
        pressed: s.captured == id || (s.captured > 0 && s.is_descendant(s.captured,id)),
        opacity: opacity,
        surface_state: s.composition.surface_states.get_or(id,0),
        now: s.now,
        reduced_motion: s.reduced
    }
}

fn (s $&Screen) run_before_paint_hook(id int,frame $&draw.Frame,opacity f64,styles &Styles) int {
    if s.composition.paint_hook_count == 0 || !s.composition.paint_hooks.has(id) { << 0 }
    if !s.composition.paint_hooks[id].has_before { << 0 }
    ctx := s.make_paint_hook_context(id,opacity)
    f := s.composition.paint_hooks[id].before_fn
    eff := s.resolve_styles_with_patch(id,styles)
    msg := f(&ctx,&eff,frame)
    if msg.len > 0 { >> errors.new(msg) }
    << 0
}

fn (s $&Screen) run_after_paint_hook(id int,frame $&draw.Frame,opacity f64,styles &Styles) int {
    if s.composition.paint_hook_count == 0 || !s.composition.paint_hooks.has(id) { << 0 }
    if !s.composition.paint_hooks[id].has_after { << 0 }
    ctx := s.make_paint_hook_context(id,opacity)
    f := s.composition.paint_hooks[id].after_fn
    eff := s.resolve_styles_with_patch(id,styles)
    msg := f(&ctx,&eff,frame)
    if msg.len > 0 { >> errors.new(msg) }
    << 0
}

fn (s $&Screen) run_paint_hook_stage(id int,before bool,in_vt bool,frame $&draw.Frame,opacity f64,styles &Styles) int {
    if s.composition.paint_hook_count == 0 || !s.composition.paint_hooks.has(id) { << 0 }
    hook := &s.composition.paint_hooks[id]
    if before && !hook.has_before { << 0 }
    if !before && !hook.has_after { << 0 }
    if in_vt {
        if before { << s.run_before_paint_hook(id,frame,opacity,styles) >>> }
        << s.run_after_paint_hook(id,frame,opacity,styles) >>>
    }
    clip := s.child_clip(id) >>>
    if clip.width <= 0.0 || clip.height <= 0.0 { << 0 }
    frame.push() >>>
    frame.clip_rect(clip.x,clip.y,clip.width,clip.height) >>>
    if before {
        rc := s.run_before_paint_hook(id,frame,opacity,styles) >>> (err) {
            frame.pop() >>>
            >> err
        }
        _ := rc
    } else {
        rc := s.run_after_paint_hook(id,frame,opacity,styles) >>> (err) {
            frame.pop() >>>
            >> err
        }
        _ := rc
    }
    frame.pop() >>>
    << 0
}

fn (s $&Screen) cleanup_paint_hooks_for(id int) {
    if s.composition.paint_hooks.has(id) {
        comp := $&s.composition
        phs := $&comp.paint_hooks
        phs.delete(id)
        if comp.paint_hook_count > 0 { comp.paint_hook_count = comp.paint_hook_count - 1 }
    }
}
