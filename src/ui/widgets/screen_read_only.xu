@ui/widgets

#errors

pub fn (s &mut Screen) set_read_only(id int,value bool) int {
    n := s.node(id) or >>
    if screen_visual_kind(n.kind) { << s.visual_read_only(id,value) or >> }
    if n.kind == SCREEN_BUTTON { mut item := s.take_button(id)
        item.set_read_only(value)
        s.buttons[id] = item
        s.dirty = true
        << 0 }
    if n.kind==SCREEN_CHECKBOX { owner := mut &s.basics
        items := mut &owner.checks
        mut item := items.take(id)
        message := screen_read_only_checks(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_SWITCH { owner := mut &s.basics
        items := mut &owner.switches
        mut item := items.take(id)
        message := screen_read_only_switches(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_RADIO { owner := mut &s.basics
        items := mut &owner.radios
        mut item := items.take(id)
        message := screen_read_only_radios(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_SLIDER { owner := mut &s.basics
        items := mut &owner.sliders
        mut item := items.take(id)
        message := screen_read_only_sliders(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_STEPPER { owner := mut &s.basics
        items := mut &owner.steppers
        mut item := items.take(id)
        message := screen_read_only_steppers(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_TABS { owner := mut &s.basics
        items := mut &owner.tabs
        mut item := items.take(id)
        message := screen_read_only_tabs(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_SELECT { owner := mut &s.basics
        items := mut &owner.selects
        mut item := items.take(id)
        message := screen_read_only_selects(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_LIST { owner := mut &s.basics
        items := mut &owner.lists
        mut item := items.take(id)
        message := screen_read_only_lists(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_RADIO_GROUP { owner := mut &s.basics
        items := mut &owner.groups
        mut item := items.take(id)
        message := screen_read_only_groups(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_TABLE { owner := mut &s.controls
        items := mut &owner.tables
        mut item := items.take(id)
        message := screen_read_only_tables(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_TREE { owner := mut &s.controls
        items := mut &owner.trees
        mut item := items.take(id)
        message := screen_read_only_trees(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_COMBO { owner := mut &s.controls
        items := mut &owner.combos
        mut item := items.take(id)
        message := screen_read_only_combos(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_MULTI { owner := mut &s.controls
        items := mut &owner.multis
        mut item := items.take(id)
        message := screen_read_only_multis(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_DATE { owner := mut &s.controls
        items := mut &owner.dates
        mut item := items.take(id)
        message := screen_read_only_dates(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_CLOCK { owner := mut &s.controls
        items := mut &owner.clocks
        mut item := items.take(id)
        message := screen_read_only_clocks(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_COLOR { owner := mut &s.controls
        items := mut &owner.colors
        mut item := items.take(id)
        message := screen_read_only_colors(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_FIELD { owner := mut &s.controls
        items := mut &owner.fields
        mut item := items.take(id)
        message := screen_read_only_fields(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_EDITOR { owner := mut &s.controls
        items := mut &owner.editors
        mut item := items.take(id)
        message := screen_read_only_editors(mut &item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    >> errors.new("widgets: control does not support read-only state")
}
fn screen_read_only_checks(item &mut Checkbox,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_switches(item &mut Switch,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_radios(item &mut Radio,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_sliders(item &mut Slider,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_steppers(item &mut Stepper,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_tabs(item &mut Tabs,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_selects(item &mut Select,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_lists(item &mut ListBox,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_groups(item &mut RadioGroup,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_tables(item &mut Table,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_trees(item &mut TreeView,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
