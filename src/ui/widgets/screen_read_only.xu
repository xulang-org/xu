    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_multis(item &mut MultiSelect,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_dates(item &mut DatePicker,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_clocks(item &mut TimePicker,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_colors(item &mut ColorPicker,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_fields(item &mut Field,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_editors(item &mut Editor,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
