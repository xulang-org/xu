@ui/widgets

#errors

pub fn (s $&Screen) set_read_only(id int,value bool) int {
    n := s.node(id) or >>
    if screen_visual_kind(n.kind) { << s.visual_read_only(id,value) or >> }
    if n.kind == SCREEN_BUTTON { $item := s.take_button(id)
        item.set_read_only(value)
        s.buttons[id] = item
        s.dirty = true
        << 0 }
    if n.kind==SCREEN_CHECKBOX { owner := $&s.basics
        items := $&owner.checks
        $item := items.take(id)
        message := screen_read_only_checks($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_SWITCH { owner := $&s.basics
        items := $&owner.switches
        $item := items.take(id)
        message := screen_read_only_switches($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_RADIO { owner := $&s.basics
        items := $&owner.radios
        $item := items.take(id)
        message := screen_read_only_radios($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_SLIDER { owner := $&s.basics
        items := $&owner.sliders
        $item := items.take(id)
        message := screen_read_only_sliders($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_STEPPER { owner := $&s.basics
        items := $&owner.steppers
        $item := items.take(id)
        message := screen_read_only_steppers($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_TABS { owner := $&s.basics
        items := $&owner.tabs
        $item := items.take(id)
        message := screen_read_only_tabs($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_SELECT { owner := $&s.basics
        items := $&owner.selects
        $item := items.take(id)
        message := screen_read_only_selects($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_LIST { owner := $&s.basics
        items := $&owner.lists
        $item := items.take(id)
        message := screen_read_only_lists($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_RADIO_GROUP { owner := $&s.basics
        items := $&owner.groups
        $item := items.take(id)
        message := screen_read_only_groups($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_TABLE { owner := $&s.controls
        items := $&owner.tables
        $item := items.take(id)
        message := screen_read_only_tables($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_TREE { owner := $&s.controls
        items := $&owner.trees
        $item := items.take(id)
        message := screen_read_only_trees($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_COMBO { owner := $&s.controls
        items := $&owner.combos
        $item := items.take(id)
        message := screen_read_only_combos($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_MULTI { owner := $&s.controls
        items := $&owner.multis
        $item := items.take(id)
        message := screen_read_only_multis($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_DATE { owner := $&s.controls
        items := $&owner.dates
        $item := items.take(id)
        message := screen_read_only_dates($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_CLOCK { owner := $&s.controls
        items := $&owner.clocks
        $item := items.take(id)
        message := screen_read_only_clocks($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_COLOR { owner := $&s.controls
        items := $&owner.colors
        $item := items.take(id)
        message := screen_read_only_colors($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_FIELD { owner := $&s.controls
        items := $&owner.fields
        $item := items.take(id)
        message := screen_read_only_fields($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    if n.kind==SCREEN_EDITOR { owner := $&s.controls
        items := $&owner.editors
        $item := items.take(id)
        message := screen_read_only_editors($&item,value)
        items[id]=item
        if message.len>0 { >> errors.new(message) }
        s.dirty=true
        << 0 }
    >> errors.new("widgets: control does not support read-only state")
}
fn screen_read_only_checks(item $&Checkbox,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_switches(item $&Switch,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_radios(item $&Radio,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_sliders(item $&Slider,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_steppers(item $&Stepper,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_tabs(item $&Tabs,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_selects(item $&Select,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_lists(item $&ListBox,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_groups(item $&RadioGroup,value bool) string {
    item.set_read_only(value)
    << ""
}
fn screen_read_only_tables(item $&Table,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_trees(item $&TreeView,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_combos(item $&ComboBox,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_multis(item $&MultiSelect,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_dates(item $&DatePicker,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_clocks(item $&TimePicker,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_colors(item $&ColorPicker,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_fields(item $&Field,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
fn screen_read_only_editors(item $&Editor,value bool) string {
    item.set_read_only(value) or (err) { << err.msg() }
    << ""
}
