@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

pub const RANGE_CLAMP = 0
pub const RANGE_PUSH = 1
pub struct RangeValues {
    pub lower f64
    pub upper f64
    pub active int
}
pub struct RangeSliderOptions {
    pub step f64
    pub min_distance f64
    pub collision int
    pub vertical bool
    pub reversed bool
    pub drag_range bool
    pub commit_only bool
}
pub fn range_slider_options() RangeSliderOptions {
    << RangeSliderOptions{step: 0.0,min_distance: 0.0,collision: RANGE_CLAMP,vertical: false,reversed: false,drag_range: true,commit_only: false}
}
fn range_number(value f64) bool { << !math.is_nan(value) && !math.is_inf(value) && math.abs(value) <= 1000000000000.0 }
pub struct RangeSlider {
    control Button
    minimum f64
    maximum f64
    lower f64
    upper f64
    active int
    hot int
    dragging int
    pending bool
    key_pending int
    saved_lower f64
    saved_upper f64
    drag_origin f64
    options RangeSliderOptions
    appearance SliderAppearance
    locale string
    labels TextCache
    track layout.Rect
    thumb f64
    lower_motion Tween
    upper_motion Tween
    lower_halo Tween
    upper_halo Tween
    motion MotionSpec
    ready bool
    now time.Instant
    reduced bool
}
// Values are bounded numeric data. Invalid configuration is rejected atomically.
pub fn range_slider(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,minimum f64,maximum f64,lower f64,upper f64) RangeSlider {
    if !range_number(minimum) || !range_number(maximum) || maximum <= minimum || !range_number(lower) || !range_number(upper) || lower > upper {
        >> errors.new("widgets: invalid range slider values") }
    $item := RangeSlider{control: button(identity,id,bounds) or >>,minimum: minimum,maximum: maximum,lower: minimum,upper: maximum,
        active: 0,hot: -1,dragging: -1,pending: false,key_pending: 0,saved_lower: minimum,saved_upper: maximum,drag_origin: 0.0,
        options: range_slider_options(),appearance: slider_appearance(),locale: "",labels: text_cache(context),track: copy_rect(bounds),thumb: 18.0,
        lower_motion: tween(0.0) or >>,upper_motion: tween(1.0) or >>,lower_halo: tween(0.0) or >>,upper_halo: tween(0.0) or >>,
        motion: motion_spec(),ready: false,now: time.zero_instant(),reduced: false}
    item.set_values(lower,upper) or >>
    << item
}
pub fn (r &RangeSlider) id() int { << r.control.id }
pub fn (r &RangeSlider) bounds() layout.Rect { << r.control.bounds() }
pub fn (r &RangeSlider) values() RangeValues { << RangeValues{lower: r.lower,upper: r.upper,active: r.active} }
pub fn (r &RangeSlider) needs_paint() bool { << r.control.dirty }
pub fn (r $&RangeSlider) painted() { r.control.dirty = false }
pub fn (r &RangeSlider) is_enabled() bool { << r.control.is_enabled() }
pub fn (r &RangeSlider) style_or(styles &Styles) ControlStyle {
    if r.control.has_style() { << r.control.style_or(styles) }
    << styles.slider_style()
}
fn (r &RangeSlider) snap(value f64,direction int) f64 {
    if value <= r.minimum { << r.minimum }
    if value >= r.maximum { << r.maximum }
    if r.options.step <= 0.0 { << value }
    units := (value - r.minimum) / r.options.step
    $n := math.round(units)
    if direction < 0 { n = math.floor(units + 0.000000001) }
    if direction > 0 { n = math.ceil(units - 0.000000001) }
    << math.max(r.minimum,math.min(r.maximum,r.minimum + n * r.options.step))
}
pub fn (r $&RangeSlider) set_values(lower f64,upper f64) int {
    if !range_number(lower) || !range_number(upper) || lower > upper { >> errors.new("widgets: invalid range slider values") }
    $lo := r.snap(lower,0)
    $hi := r.snap(upper,0)
    if hi - lo < r.options.min_distance {
        hi = r.snap(lo + r.options.min_distance,1)
        if hi - lo < r.options.min_distance { lo = r.snap(hi - r.options.min_distance,-1) }
    }
    if r.lower != lo || r.upper != hi { r.lower = lo
        r.upper = hi
        r.control.dirty = true }
    r.pending = false
    r.dragging = -1
    r.key_pending = 0
    << 0
}
pub fn (r $&RangeSlider) set_options(o &RangeSliderOptions) int {
    span := r.maximum - r.minimum
    if !range_number(o.step) || o.step < 0.0 || o.step > span || !range_number(o.min_distance) || o.min_distance < 0.0 || o.min_distance > span || o.collision < RANGE_CLAMP || o.collision > RANGE_PUSH {
        >> errors.new("widgets: invalid range slider options") }
    old := r.options
    if old.step == o.step && old.min_distance == o.min_distance && old.collision == o.collision && old.vertical == o.vertical && old.reversed == o.reversed && old.drag_range == o.drag_range && old.commit_only == o.commit_only { << 0 }
    r.cancel()
    r.options = RangeSliderOptions{step: o.step,min_distance: o.min_distance,collision: o.collision,vertical: o.vertical,reversed: o.reversed,drag_range: o.drag_range,commit_only: o.commit_only}
    r.set_values(r.lower,r.upper) or >>
    r.control.dirty = true
    << 0
}
pub fn (r $&RangeSlider) set_appearance(a &SliderAppearance) int {
    a.validate() or >>
    r.appearance = SliderAppearance{ticks: a.ticks,show_value: a.show_value,decimals: a.decimals}
    r.control.dirty = true
    << 0
}
pub fn (r $&RangeSlider) set_locale(locale &Locale) int {
    locale.validate() or >>
    r.locale = locale.pack_numbers()
    r.control.dirty = true
    << 0
}
pub fn (r $&RangeSlider) set_style(style &ControlStyle) int { item := $&r.control
    << item.set_style(style) or >> }
pub fn (r $&RangeSlider) clear_style() { item := $&r.control
    item.clear_style() }
pub fn (r $&RangeSlider) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    r.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    << 0
}
pub fn (r $&RangeSlider) cancel() {
    if r.pending || r.dragging >= 0 || r.hot >= 0 { r.control.dirty = true }
    if r.pending && r.options.commit_only { r.lower = r.saved_lower
        r.upper = r.saved_upper }
    r.pending = false
    r.key_pending = 0
    r.dragging = -1
    r.hot = -1
    item := $&r.control
    item.cancel()
}
pub fn (r $&RangeSlider) set_focus(value bool) { if !value { r.cancel() }
    item := $&r.control
    item.set_focus(value) }
pub fn (r $&RangeSlider) set_enabled(value bool) { if !value { r.cancel() }
    item := $&r.control
    item.set_enabled(value) }
pub fn (r $&RangeSlider) set_read_only(value bool) { if value && !r.control.read_only { r.cancel() }
    item := $&r.control
    item.set_read_only(value) }
pub fn (r $&RangeSlider) set_bounds(b &layout.Rect) int {
    validate_bounds(b) or >>
    old := r.bounds()
    if old.x != b.x || old.y != b.y || old.width != b.width || old.height != b.height { r.cancel() }
    item := $&r.control
    << item.set_bounds(b) or >>
}
pub fn (r $&RangeSlider) dispose() { r.cancel()
    labels := $&r.labels
    labels.dispose()
    r.control.closed = true }
