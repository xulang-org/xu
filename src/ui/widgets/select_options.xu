@ui/widgets
#errors

pub struct SelectOption { pub label string
    pub enabled bool
    pub group bool }
pub fn select_option(label string) SelectOption { << SelectOption{label: label,enabled: true,group: false} }
pub fn select_group(label string) SelectOption { << SelectOption{label: label,enabled: false,group: true} }
pub fn (sel $&Select) set_option_group(index int,group bool) int {
    if index < 0 || index >= sel.count_val { >> errors.new("widgets: select option out of range") }
    bit := 1 << index
    if group { sel.group_options = sel.group_options | bit }
    else { sel.group_options = sel.group_options & (0 - 1 - bit) }
    sel.armed_opt = -1
    sel.dirty = true
    << 0
}
pub fn (sel &Select) is_group(index int) bool { << index >= 0 && index < sel.count_val && (sel.group_options & (1 << index)) != 0 }
pub fn (s $&Screen) select_options(options &[]SelectOption,selected int) int {
    $labels := []string{}
    for option in options { validate_table_text(&option.label) or >>
        labels.push(option.label + "") }
    if options.len > 0 && (selected < 0 || selected >= options.len || !options[selected].enabled || options[selected].group) { >> errors.new("widgets: selected option must be enabled and not a group heading") }
    id := s.select_box(&labels,selected) or >>
    $item := s.take_basic_selects(id)
    message := configure_select_options($&item,options)
    s.basics.selects[id] = item
    if message.len > 0 { >> errors.new(message) }
    << id
}
fn configure_select_options(item $&Select,options &[]SelectOption) string {
    for index in 0:options.len { item.set_option_enabled(index,options[index].enabled) or (err) { << err.msg() }
        item.set_option_group(index,options[index].group) or (err) { << err.msg() } }
    << ""
}
