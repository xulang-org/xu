@ui/widgets
#errors

pub fn (s &mut Screen) remember_color(id int) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_COLOR { >> errors.new("widgets: expected ColorPicker") }
    owner := mut &s.controls
    items := mut &owner.colors
    mut item := items.take(id)
    item.remember()
    items[id] = item
    s.dirty = true
    << 0
}
