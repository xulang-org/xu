@ui/widgets

#ui/layout
#errors
#math

pub fn (s $&Screen) set_hit_slop(id int,insets &layout.Insets) int {
    _ := s.node(id) >>>
    insets.validate() >>>
    if math.is_nan(insets.left) || math.is_inf(insets.left) || insets.left < 0.0 || insets.left > 128.0 ||
       math.is_nan(insets.top) || math.is_inf(insets.top) || insets.top < 0.0 || insets.top > 128.0 ||
       math.is_nan(insets.right) || math.is_inf(insets.right) || insets.right < 0.0 || insets.right > 128.0 ||
       math.is_nan(insets.bottom) || math.is_inf(insets.bottom) || insets.bottom < 0.0 || insets.bottom > 128.0 {
        >> errors.new("widgets: hit slop insets must be in [0, 128]")
    }
    if insets.left == 0.0 && insets.top == 0.0 && insets.right == 0.0 && insets.bottom == 0.0 {
        << s.clear_hit_slop(id) >>>
    }
    comp := $&s.composition
    hsl := $&comp.hit_slops
    had := hsl.has(id)
    hsl[id] = layout.Insets{left: insets.left,top: insets.top,right: insets.right,bottom: insets.bottom}
    if !had { comp.hit_slop_count = comp.hit_slop_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_hit_slop(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.hit_slops.has(id) {
        hsl := $&comp.hit_slops
        hsl.delete(id)
        if comp.hit_slop_count > 0 { comp.hit_slop_count = comp.hit_slop_count - 1 }
    }
    << 0
}

pub fn (s &Screen) hit_slop(id int) layout.Insets {
    _ := s.node(id) >>>
    if s.composition.hit_slop_count > 0 && s.composition.hit_slops.has(id) {
        sl := s.composition.hit_slops[id]
        << layout.Insets{left: sl.left,top: sl.top,right: sl.right,bottom: sl.bottom}
    }
    << layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
}

fn (s &Screen) node_hit_bounds(id int) layout.Rect {
    b := s.nodes[id - 1].bounds
    if s.composition.hit_slop_count == 0 || !s.composition.hit_slops.has(id) {
        << layout.Rect{x: b.x,y: b.y,width: b.width,height: b.height}
    }
    sl := s.composition.hit_slops[id]
    << layout.Rect{
        x: b.x - sl.left,
        y: b.y - sl.top,
        width: b.width + sl.left + sl.right,
        height: b.height + sl.top + sl.bottom
    }
}

fn (s $&Screen) cleanup_hit_slop_for(id int) {
    comp := $&s.composition
    if comp.hit_slops.has(id) {
        hsl := $&comp.hit_slops
        hsl.delete(id)
        if comp.hit_slop_count > 0 { comp.hit_slop_count = comp.hit_slop_count - 1 }
    }
}
