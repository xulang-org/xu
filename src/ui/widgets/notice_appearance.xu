@ui/widgets
#errors

pub fn (s &mut Screen) set_notice_style(style &ControlStyle) int {
    style.validate() or >>
    s.notices.custom = encode_control_style(style)
    for id in s.notices.handles { s.set_control_style(id,style) or >> }
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) clear_notice_style() int {
    s.notices.custom = ""
    for id in s.notices.handles { mut item := s.screen_take_toast(id) or >>
        item.custom.active = false
        item.dirty = true
        s.screen_put_toast(id,item) }
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_notice_motion(spec &MotionSpec) int {
    spec.validate() or >>
    s.notices.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    for id in s.notices.handles { s.set_motion(id,spec) or >> }
    s.dirty = true
    << 0
}
