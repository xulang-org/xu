@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors
#math

// One toast, with host-owned text and stacking. Lifetime zero is persistent.
// Hover/focus pauses expiry. tick/next_tick are explicit; idle toasts do no work.
pub struct Toast {
    identity ui.CanvasEvent
    id_val int
    bounds_val layout.Rect
    opened bool
    enabled bool
    hovered bool
    focused bool
    paused bool
    armed bool
    close_hovered bool
    timeout_active bool
    remaining time.Duration
    expires time.Instant
    clock time.Instant
    custom ScalarControlStyle
    motion MotionSpec
    fade Tween
    reduced bool
    dirty bool
    selectable bool
    action_width f64
    aux map[int]SelectableText
}
pub fn toast(identity &ui.CanvasEvent,id int,bounds &layout.Rect) Toast {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid toast identity") }
    validate_bounds(bounds) >>>
    fade := tween(0.0) >>>
    << Toast{identity: copy_identity(identity),id_val: id,bounds_val: copy_rect(bounds),opened: false,enabled: true,
        hovered: false,focused: false,paused: false,armed: false,close_hovered: false,timeout_active: false,remaining: time.duration(0),
        expires: time.zero_instant(),clock: time.zero_instant(),custom: empty_scalar_style(),motion: motion_spec(),fade: fade,reduced: false,dirty: true,selectable: false,action_width: 0.0,aux: map[int]SelectableText{}}
}

// View cancellation records use timestamp zero. Keep the last observed typed
// clock so releasing hover/focus never resumes a timeout in the distant past.
fn (t $&Toast) observe(now time.Instant) time.Instant {
    if now.after(t.clock) { t.clock = now }
    << t.clock
}
pub fn (t &Toast) id() int { << t.id_val }
pub fn (t &Toast) bounds() layout.Rect { << copy_rect(&t.bounds_val) }
pub fn (t &Toast) is_enabled() bool { << t.enabled }
pub fn (t &Toast) is_selectable() bool { << t.selectable }
pub fn (t $&Toast) set_selectable(selectable bool) {
    if t.selectable != selectable { t.dirty = true }
    t.selectable = selectable
    aux := $&t.aux
    _ := overlay_set_aux_selectable(aux,selectable)
}
pub fn (t $&Toast) set_action_width(width f64) {
    next := math.max(0.0,width)
    if t.action_width != next { t.dirty = true }
    t.action_width = next
}
pub fn (t &Toast) text_bounds() layout.Rect {
    close := t.close_bounds()
    << layout.Rect{x: t.bounds_val.x,y: t.bounds_val.y,width: math.max(0.0,t.bounds_val.width - close.width - t.action_width),height: t.bounds_val.height}
}
pub fn (t $&Toast) set_text(context &draw.Context,text &string) int {
    id := t.id_val
    tbox := t.text_bounds()
    vp := layout.Rect{x: 0.0,y: 0.0,width: 1280.0,height: 800.0}
    sel := t.selectable
    idn := copy_identity(&t.identity)
    aux := $&t.aux
    overlay_set_aux_text(aux,context,&idn,id,&tbox,&vp,sel,text) >>>
    t.dirty = true
    << 0
}
pub fn (t $&Toast) set_viewport(viewport &layout.Rect) {
    tbox := t.text_bounds()
    aux := $&t.aux
    overlay_sync_aux(aux,&tbox,viewport)
}
pub fn (t $&Toast) set_locale(locale &Locale) int {
    aux := $&t.aux
    << overlay_set_aux_locale(aux,locale) >>>
}
pub fn (t &Toast) has_popup_open() bool { << overlay_aux_has_popup(&t.aux) }
pub fn (t &Toast) popup_bounds() layout.Rect { << overlay_aux_popup_bounds(&t.aux) }
pub fn (t &Toast) selected_text() string { << overlay_aux_selected_text(&t.aux) }
pub fn (t &Toast) copy_selection() int { << overlay_aux_copy(&t.aux) }
pub fn (t &Toast) cursor() int {
    if t.is_open() && t.selectable && t.aux.has(0) && !t.has_popup_open() { << ui.CURSOR_TEXT }
    << ui.CURSOR_DEFAULT
}
pub fn (t &Toast) cursor_at(x f64,y f64) int {
    if !t.is_open() { << ui.CURSOR_DEFAULT }
    if t.has_popup_open() && t.aux.has(0) { << t.aux[0].cursor_at(x,y) }
    if t.close_bounds().contains(x,y) { << ui.CURSOR_HAND }
    if t.selectable && t.aux.has(0) && t.text_bounds().contains(x,y) { << ui.CURSOR_TEXT }
    << ui.CURSOR_DEFAULT
}
pub fn (t &Toast) is_open() bool { << t.opened && t.enabled }
pub fn (t &Toast) is_visible() bool { << t.enabled && (t.opened || t.fade.value() > 0.0) }
pub fn (t &Toast) opacity() f64 { << t.fade.value() }
pub fn (t &Toast) needs_paint() bool { << t.dirty || overlay_aux_needs_paint(&t.aux) }
pub fn (t $&Toast) painted() {
    t.dirty = false
    aux := $&t.aux
    overlay_aux_painted(aux)
}
pub fn (t &Toast) close_bounds() layout.Rect {
    b := t.bounds_val
    size := math.min(32.0,math.min(b.width,b.height))
    << layout.Rect{x: b.x + b.width - size,y: b.y + (b.height - size) * 0.5,width: size,height: size}
}
pub fn (t $&Toast) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) >>>
    if overlay_same_rect(bounds,&t.bounds_val) { << 0 }
    t.bounds_val = copy_rect(bounds)
    t.armed = false
    t.close_hovered = false
    t.hovered = false
    tbox := t.text_bounds()
    if t.aux.has(0) {
        vp := copy_rect(&t.bounds_val)
        aux := $&t.aux
        overlay_sync_aux(aux,&tbox,&vp)
    }
    current := t.clock
    t.update_pause(current) >>>
    t.dirty = true
    << 0
}
pub fn (t $&Toast) show(now time.Instant,lifetime time.Duration,reduced_motion bool) int {
    if lifetime.is_negative() { >> errors.new("widgets: negative toast lifetime") }
    if !t.enabled { << 0 }
    current := t.observe(now)
    expires := current.add(lifetime) >>>
    t.expires = expires
    t.remaining = lifetime
    t.timeout_active = !lifetime.is_zero()
    t.paused = t.hovered || t.focused
    t.opened = true
    t.armed = false
    t.close_hovered = false
    t.dirty = true
    t.reduced = reduced_motion
    duration := t.motion.enter
    curve := t.motion.curve
    fade := $&t.fade
    fade.retarget_unit(1.0,current,duration,reduced_motion) >>>
    fade.set_curve(curve) >>>
    << 0
}
pub fn (t $&Toast) dismiss(now time.Instant,reduced_motion bool) int {
    current := t.observe(now)
    if t.opened || t.fade.is_animating() { t.dirty = true }
    t.opened = false
    t.armed = false
    t.close_hovered = false
    t.timeout_active = false
    t.focused = false
    t.hovered = false
    t.paused = false
    t.reduced = reduced_motion
    duration := t.motion.exit
    curve := t.motion.exit_easing()
    if true {
        fade := $&t.fade
        fade.retarget_unit(0.0,current,duration,reduced_motion) >>>
        fade.set_curve(curve) >>>
    }
    if true {
        aux := $&t.aux
        overlay_aux_clear(aux)
    }
    << 0
}
pub fn (t $&Toast) set_enabled(enabled bool) int {
    if t.enabled != enabled { t.dirty = true }
    t.enabled = enabled
    if !enabled {
        t.dismiss(time.zero_instant(),true) >>>
        aux := $&t.aux
        overlay_aux_dispose(aux)
    }
    << 0
}
fn (t $&Toast) update_pause(now time.Instant) int {
    paused := t.hovered || t.focused
    if paused == t.paused || !t.opened { << 0 }
    if t.timeout_active {
        if paused {
            t.remaining = t.expires.since(now)
            if t.remaining.is_negative() { t.remaining = time.duration(0) }
        } else { expires := now.add(t.remaining) >>>
            t.expires = expires }
    }
    t.paused = paused
    << 0
}
pub fn (t $&Toast) set_focus(focused bool,now time.Instant) int {
    current := t.observe(now)
    next := focused && t.is_open()
    if t.focused != next { t.dirty = true }
    t.focused = next
    << t.update_pause(current) >>>
}
pub fn (t $&Toast) input(event &ui.InputEvent) Action {
    if !belongs(&t.identity,event) || !t.is_visible() { << no_action(t.id_val,t.dirty) }
    pointer := (event.kind >= ui.EV_POINTER_DOWN && event.kind <= ui.EV_POINTER_CANCEL) || event.kind == ui.EV_POINTER_SCROLL
    inside := t.bounds_val.contains(event.x,event.y)
    if !t.is_open() { << overlay_action(t.id_val,false,t.dirty,pointer && inside) }
    observed := time.instant_from_ns(event.time_ns) >>>
    now := t.observe(observed)
    if t.timeout_active && !t.paused && !now.before(t.expires) {
        reduced := t.reduced
        t.dismiss(now,reduced) >>>
        << overlay_action(t.id_val,true,t.dirty,pointer && inside)
    }
    hit := t.close_bounds().contains(event.x,event.y)
    if t.has_popup_open() {
        tbox := t.text_bounds()
        $act := no_action(t.id_val,false)
        if true {
            aux := $&t.aux
            act = overlay_route_aux_input(aux,&tbox,event)
        }
        if act.needs_paint { t.dirty = true }
        << overlay_action(t.id_val,false,t.needs_paint(),true)
    }
    $consumed := pointer && inside
    $changed := false
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        t.hovered = event.kind != ui.EV_POINTER_LEAVE && t.bounds_val.contains(event.x,event.y)
        hot_close := event.kind != ui.EV_POINTER_LEAVE && hit
        if t.close_hovered != hot_close {
            t.close_hovered = hot_close
            t.dirty = true
        }
        t.update_pause(now) >>>
    }
    tbox := t.text_bounds()
    action_hit := t.action_width > 0.0 && pointer && event.x >= tbox.x + tbox.width && !hit
    if t.selectable && t.aux.has(0) && !hit && !action_hit {
        handle_key := event.kind == ui.EV_KEY_DOWN && t.aux[0].is_focused() && (event.key != ui.KEY_ESCAPE && event.key != ui.KEY_ENTER && event.key != 32)
        if event.kind != ui.EV_KEY_DOWN || handle_key {
            $act := no_action(t.id_val,false)
            if true {
                aux := $&t.aux
                act = overlay_route_aux_input(aux,&tbox,event)
            }
            if act.needs_paint { t.dirty = true }
            if act.consumed { << overlay_action(t.id_val,false,t.needs_paint(),true) }
        }
    }
    if event.kind == ui.EV_POINTER_CANCEL {
        if t.close_hovered || t.armed { t.dirty = true }
        t.hovered = false
        t.focused = false
        t.armed = false
        t.close_hovered = false
        t.update_pause(now) >>>
    } else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && hit {
        t.armed = true
        t.dirty = true
        consumed = true
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && t.armed {
        t.armed = false
        t.dirty = true
        consumed = true
        changed = hit
    } else if event.kind == ui.EV_KEY_DOWN && t.focused && (event.key == ui.KEY_ESCAPE || event.key == ui.KEY_ENTER || event.key == 32) && event.repeat == 0 {
        consumed = true
        changed = true
    }
    if changed { reduced := t.reduced
        t.dismiss(now,reduced) >>> }
    << overlay_action(t.id_val,changed,t.dirty,consumed)
}
pub fn (t $&Toast) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if !belongs(&t.identity,event) { << no_action(t.id_val,t.dirty) }
    observed := time.instant_from_ns(event.time_ns) >>>
    now := t.observe(observed)
    if kind == ROUTE_FOCUS { t.set_focus(true,now) >>> }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL {
        t.focused = false
        t.hovered = false
        t.armed = false
        t.close_hovered = false
        t.update_pause(now) >>>
        t.dirty = true
    } else { << t.input(event) >>> }
    << no_action(t.id_val,t.dirty)
}
pub fn (t $&Toast) tick(now time.Instant,reduced_motion bool) bool {
    current := t.observe(now)
    $changed := false
    if t.is_open() && t.timeout_active && !t.paused && !current.before(t.expires) {
        t.dismiss(current,reduced_motion) >>>
        changed = true
    }
    before := t.fade.value()
    $target := 0.0
    if t.is_open() { target = 1.0 }
    t.reduced = reduced_motion
    fade := $&t.fade
    if reduced_motion { fade.retarget(target,current,time.duration(0),true) >>> }
    else { _ := fade.advance(current) >>> }
    if before != t.fade.value() { changed = true }
    if changed { t.dirty = true }
    << changed
}
pub fn (t &Toast) next_tick(now time.Instant) time.Instant {
    next := overlay_next_tick(t.fade.is_animating(),now) >>>
    if t.is_open() && t.timeout_active && !t.paused && (next.is_zero() || t.expires.before(next)) { << t.expires }
    << next
}
fn (t &Toast) paint_close_button(frame $&draw.Frame,close &layout.Rect,c &ControlStyle,d f64) int {
    $btn_state := 0
    if t.close_hovered { btn_state = btn_state | STATE_HOVERED }
    if t.armed && t.close_hovered { btn_state = btn_state | STATE_PRESSED }
    if btn_state != 0 {
        pill := layout.Rect{x: close.x + 2.0 * d,y: close.y + 2.0 * d,
            width: math.max(0.0,close.width - 4.0 * d),height: math.max(0.0,close.height - 4.0 * d)}
        rounded_fill(frame,&pill,4.0 * d,c.resolve(btn_state).background) >>>
    }
    ink := c.resolve(btn_state).foreground
    mid_x := close.x + close.width * 0.5
    mid_y := close.y + close.height * 0.5
    half := math.min(4.0,close.width * 0.2)
    frame.line(mid_x - half,mid_y - half,mid_x + half,mid_y + half,ink,1.5) >>>
    frame.line(mid_x + half,mid_y - half,mid_x - half,mid_y + half,ink,1.5) >>>
    if t.focused { frame.stroke_rect(close.x + 3.0,close.y + 3.0,math.max(0.0,close.width - 6.0),math.max(0.0,close.height - 6.0),c.resolve(0).focus,1.0) >>> }
    << 0
}
pub fn (t &Toast) paint_styled(frame $&draw.Frame,label $&StyledLabel,styles &Styles) int {
    if !t.is_visible() { << 0 }
    c := t.style_or(styles).with_opacity(t.opacity()) >>>
    paint_box_styled(frame,&t.bounds_val,styles,&c,0) >>>
    close := t.close_bounds()
    text := t.text_bounds()
    base := t.style_or(styles)
    $sel_a := 0
    $sel_f := 0
    if t.selectable && t.aux.has(0) {
        r := overlay_aux_sel_range(&t.aux)
        sel_a = r.start
        sel_f = r.end
    }
    paint_overlay_label_selected(frame,label,&text,styles,&base,t.opacity(),false,sel_a,sel_f) >>>
    << t.paint_close_button(frame,&close,&c,styles.density) >>>
}
pub fn (t $&Toast) paint_content_styled(frame $&draw.Frame,styles &Styles) int {
    if !t.is_visible() { << 0 }
    c := t.style_or(styles).with_opacity(t.opacity()) >>>
    paint_box_styled(frame,&t.bounds_val,styles,&c,0) >>>
    close := t.close_bounds()
    text_rect := t.text_bounds()
    if t.aux.has(0) {
        base := t.style_or(styles)
        op := t.opacity()
        aux := $&t.aux
        overlay_paint_aux_text(aux,frame,&text_rect,styles,&base,op) >>>
    }
    << t.paint_close_button(frame,&close,&c,styles.density) >>>
}
pub fn (t $&Toast) paint_aux_text(frame $&draw.Frame,bounds &layout.Rect,styles &Styles) int {
    if !t.is_visible() || !t.aux.has(0) { << 0 }
    base := t.style_or(styles)
    op := t.opacity()
    aux := $&t.aux
    overlay_aux_set_bounds(aux,bounds)
    << overlay_paint_aux_text(aux,frame,bounds,styles,&base,op) >>>
}
pub fn (t $&Toast) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    if !t.is_visible() || !t.aux.has(0) { << 0 }
    aux := $&t.aux
    << overlay_paint_aux_popup(aux,frame,styles) >>>
}

pub fn (t &Toast) style_or(styles &Styles) ControlStyle {
    if t.custom.active { << unpack_scalar_style(&t.custom) }
    << styles.overlay_style()
}
pub fn (t $&Toast) set_style(style &ControlStyle) int { style.validate() >>>
    t.custom = pack_scalar_style(style)
    t.dirty = true
    << 0 }
pub fn (t $&Toast) clear_style() {
    if t.custom.active {
        t.custom.active = false
        t.dirty = true
    }
}
pub fn (t $&Toast) set_motion(spec &MotionSpec) int { spec.validate() >>>
    t.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    fade := $&t.fade
    fade.set_curve(spec.curve) >>>
    << 0 }

fn (t &Toast) clone_toast() Toast {
    custom := copy_scalar_style(&t.custom)
    << Toast{identity: copy_identity(&t.identity),id_val: t.id_val,bounds_val: copy_rect(&t.bounds_val),opened: t.opened,
        enabled: t.enabled,hovered: t.hovered,focused: t.focused,paused: t.paused,armed: t.armed,timeout_active: t.timeout_active,
        remaining: t.remaining,expires: t.expires,clock: t.clock,fade: t.fade,reduced: t.reduced,dirty: t.dirty,selectable: t.selectable,action_width: t.action_width,close_hovered: t.close_hovered,custom: custom,motion: t.motion,aux: map[int]SelectableText{}}
}
