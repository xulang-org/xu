@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors
#math

// One toast, with host-owned text and stacking. Lifetime zero is persistent.
// Hover/focus pauses expiry. tick/next_tick are explicit; idle toasts do no work.
pub struct Toast {
    identity ui.CanvasEvent
    id_val int
    bounds_val layout.Rect
    opened bool
    enabled bool
    hovered bool
    focused bool
    paused bool
    armed bool
    timeout_active bool
    remaining time.Duration
    expires time.Instant
    clock time.Instant
    custom ScalarControlStyle
    motion MotionSpec
    fade Tween
    reduced bool
    dirty bool
}
pub fn toast(identity &ui.CanvasEvent,id int,bounds &layout.Rect) Toast {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid toast identity") }
    validate_bounds(bounds) or >>
    fade := tween(0.0) or >>
    << Toast{identity: copy_identity(identity),id_val: id,bounds_val: copy_rect(bounds),opened: false,enabled: true,
        hovered: false,focused: false,paused: false,armed: false,timeout_active: false,remaining: time.duration(0),
        expires: time.zero_instant(),clock: time.zero_instant(),custom: empty_scalar_style(),motion: motion_spec(),fade: fade,reduced: false,dirty: true}
}

// View cancellation records use timestamp zero. Keep the last observed typed
// clock so releasing hover/focus never resumes a timeout in the distant past.
fn (t &mut Toast) observe(now time.Instant) time.Instant {
    if now.after(t.clock) { t.clock = now }
    << t.clock
}
pub fn (t &Toast) id() int { << t.id_val }
pub fn (t &Toast) bounds() layout.Rect { << copy_rect(&t.bounds_val) }
pub fn (t &Toast) is_enabled() bool { << t.enabled }
pub fn (t &Toast) is_open() bool { << t.opened && t.enabled }
pub fn (t &Toast) is_visible() bool { << t.enabled && (t.opened || t.fade.value() > 0.0) }
pub fn (t &Toast) opacity() f64 { << t.fade.value() }
pub fn (t &Toast) needs_paint() bool { << t.dirty }
pub fn (t &mut Toast) painted() { t.dirty = false }
pub fn (t &Toast) close_bounds() layout.Rect {
    b := t.bounds_val
    size := math.min(32.0,math.min(b.width,b.height))
    << layout.Rect{x: b.x + b.width - size,y: b.y + (b.height - size) * 0.5,width: size,height: size}
}
pub fn (t &mut Toast) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if overlay_same_rect(bounds,&t.bounds_val) { << 0 }
    t.bounds_val = copy_rect(bounds)
    t.armed = false
    t.hovered = false
    current := t.clock
    t.update_pause(current) or >>
    t.dirty = true
    << 0
}
pub fn (t &mut Toast) show(now time.Instant,lifetime time.Duration,reduced_motion bool) int {
    if lifetime.is_negative() { >> errors.new("widgets: negative toast lifetime") }
    if !t.enabled { << 0 }
    current := t.observe(now)
    expires := current.add(lifetime) or >>
    t.expires = expires
    t.remaining = lifetime
    t.timeout_active = !lifetime.is_zero()
    t.paused = t.hovered || t.focused
    t.opened = true
    t.armed = false
    t.dirty = true
    t.reduced = reduced_motion
    duration := t.motion.enter
    curve := t.motion.curve
    fade := mut &t.fade
    fade.retarget_unit(1.0,current,duration,reduced_motion) or >>
    fade.set_curve(curve) or >>
    << 0
}
pub fn (t &mut Toast) dismiss(now time.Instant,reduced_motion bool) int {
    current := t.observe(now)
    if t.opened || t.fade.is_animating() { t.dirty = true }
    t.opened = false
    t.armed = false
    t.timeout_active = false
    t.focused = false
    t.hovered = false
    t.paused = false
    t.reduced = reduced_motion
    duration := t.motion.exit
    curve := t.motion.exit_easing()
    fade := mut &t.fade
    fade.retarget_unit(0.0,current,duration,reduced_motion) or >>
    << fade.set_curve(curve) or >>
}
pub fn (t &mut Toast) set_enabled(enabled bool) int {
    if t.enabled != enabled { t.dirty = true }
    t.enabled = enabled
    if !enabled { t.dismiss(time.zero_instant(),true) or >> }
    << 0
}
fn (t &mut Toast) update_pause(now time.Instant) int {
    paused := t.hovered || t.focused
    if paused == t.paused || !t.opened { << 0 }
    if t.timeout_active {
        if paused {
            t.remaining = t.expires.since(now)
            if t.remaining.is_negative() { t.remaining = time.duration(0) }
        } else { expires := now.add(t.remaining) or >>
            t.expires = expires }
    }
    t.paused = paused
    << 0
}
pub fn (t &mut Toast) set_focus(focused bool,now time.Instant) int {
    current := t.observe(now)
    next := focused && t.is_open()
    if t.focused != next { t.dirty = true }
    t.focused = next
    << t.update_pause(current) or >>
}
pub fn (t &mut Toast) input(event &ui.InputEvent) Action {
    if !belongs(&t.identity,event) || !t.is_visible() { << no_action(t.id_val,t.dirty) }
    pointer := (event.kind >= ui.EV_POINTER_DOWN && event.kind <= ui.EV_POINTER_CANCEL) || event.kind == ui.EV_POINTER_SCROLL
    inside := t.bounds_val.contains(event.x,event.y)
    if !t.is_open() { << overlay_action(t.id_val,false,t.dirty,pointer && inside) }
    observed := time.instant_from_ns(event.time_ns) or >>
    now := t.observe(observed)
    if t.timeout_active && !t.paused && !now.before(t.expires) {
        reduced := t.reduced
        t.dismiss(now,reduced) or >>
        << overlay_action(t.id_val,true,t.dirty,pointer && inside)
    }
    hit := t.close_bounds().contains(event.x,event.y)
    mut consumed := pointer && inside
    mut changed := false
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        t.hovered = event.kind != ui.EV_POINTER_LEAVE && t.bounds_val.contains(event.x,event.y)
        t.update_pause(now) or >>
    } else if event.kind == ui.EV_POINTER_CANCEL {
        t.hovered = false
        t.focused = false
        t.armed = false
        t.update_pause(now) or >>
    } else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && hit {
        t.armed = true
        t.dirty = true
        consumed = true
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && t.armed {
        t.armed = false
        t.dirty = true
        consumed = true
        changed = hit
    } else if event.kind == ui.EV_KEY_DOWN && t.focused && (event.key == ui.KEY_ESCAPE || event.key == ui.KEY_ENTER || event.key == 32) && event.repeat == 0 {
        consumed = true
        changed = true
    }
    if changed { reduced := t.reduced
        t.dismiss(now,reduced) or >> }
    << overlay_action(t.id_val,changed,t.dirty,consumed)
}
pub fn (t &mut Toast) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if !belongs(&t.identity,event) { << no_action(t.id_val,t.dirty) }
    observed := time.instant_from_ns(event.time_ns) or >>
    now := t.observe(observed)
    if kind == ROUTE_FOCUS { t.set_focus(true,now) or >> }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL {
        t.focused = false
        t.hovered = false
        t.armed = false
        t.update_pause(now) or >>
        t.dirty = true
    } else { << t.input(event) or >> }
    << no_action(t.id_val,t.dirty)
}
pub fn (t &mut Toast) tick(now time.Instant,reduced_motion bool) bool {
    current := t.observe(now)
    mut changed := false
    if t.is_open() && t.timeout_active && !t.paused && !current.before(t.expires) {
        t.dismiss(current,reduced_motion) or >>
        changed = true
    }
    before := t.fade.value()
    mut target := 0.0
    if t.is_open() { target = 1.0 }
    t.reduced = reduced_motion
    fade := mut &t.fade
    if reduced_motion { fade.retarget(target,current,time.duration(0),true) or >> }
    else { _ := fade.advance(current) or >> }
    if before != t.fade.value() { changed = true }
    if changed { t.dirty = true }
    << changed
}
pub fn (t &Toast) next_tick(now time.Instant) time.Instant {
    next := overlay_next_tick(t.fade.is_animating(),now) or >>
    if t.is_open() && t.timeout_active && !t.paused && (next.is_zero() || t.expires.before(next)) { << t.expires }
    << next
}
pub fn (t &Toast) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    if !t.is_visible() { << 0 }
    c := t.style_or(styles).with_opacity(t.opacity()) or >>
    paint_box_styled(frame,&t.bounds_val,styles,&c,0) or >>
    close := t.close_bounds()
    text := layout.Rect{x: t.bounds_val.x,y: t.bounds_val.y,width: math.max(0.0,t.bounds_val.width - close.width),height: t.bounds_val.height}
    base := t.style_or(styles)
    paint_overlay_label(frame,label,&text,styles,&base,t.opacity(),false) or >>
    ink := c.resolve(0).foreground
    mid_x := close.x + close.width * 0.5
    mid_y := close.y + close.height * 0.5
    half := math.min(4.0,close.width * 0.2)
    frame.line(mid_x - half,mid_y - half,mid_x + half,mid_y + half,ink,1.5) or >>
    frame.line(mid_x + half,mid_y - half,mid_x - half,mid_y + half,ink,1.5) or >>
    if t.focused { frame.stroke_rect(close.x + 3.0,close.y + 3.0,math.max(0.0,close.width - 6.0),math.max(0.0,close.height - 6.0),c.resolve(0).focus,1.0) or >> }
    << 0
}

pub fn (t &Toast) style_or(styles &Styles) ControlStyle {
    if t.custom.active { << unpack_scalar_style(&t.custom) }
    << styles.overlay_style()
}
pub fn (t &mut Toast) set_style(style &ControlStyle) int { style.validate() or >>
    t.custom = pack_scalar_style(style)
    t.dirty = true
    << 0 }
pub fn (t &mut Toast) set_motion(spec &MotionSpec) int { spec.validate() or >>
    t.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    fade := mut &t.fade
    fade.set_curve(spec.curve) or >>
    << 0 }

fn (t &Toast) clone_toast() Toast {
    custom := copy_scalar_style(&t.custom)
    << Toast{identity: copy_identity(&t.identity),id_val: t.id_val,bounds_val: copy_rect(&t.bounds_val),opened: t.opened,
        enabled: t.enabled,hovered: t.hovered,focused: t.focused,paused: t.paused,armed: t.armed,timeout_active: t.timeout_active,
        remaining: t.remaining,expires: t.expires,clock: t.clock,fade: t.fade,reduced: t.reduced,dirty: t.dirty,custom: custom,motion: t.motion}
}
