@ui/widgets

#ui
#ui/draw
#ui/layout
#math
#time
#errors

// Default no-op handlers ensure CustomControl never holds an uninitialized fn value.
fn default_custom_measure(id int,tag int,constraints &layout.Constraints,styles &Styles) layout.Size {
    _ := id
    _ := tag
    _ := styles
    << constraints.constrain(&layout.Size{width: 0.0,height: 0.0}) >>>
}
fn default_custom_paint(ctx &CustomContext,styles &Styles,frame $&draw.Frame) string {
    _ := ctx
    _ := styles
    _ := frame
    << ""
}
fn default_custom_input(ctx &CustomContext,route int,event &ui.InputEvent) Action {
    _ := route
    _ := event
    << no_action(ctx.id,false)
}
fn default_custom_cursor(ctx &CustomContext,x f64,y f64) int {
    _ := ctx
    _ := x
    _ := y
    << ui.CURSOR_DEFAULT
}
fn default_custom_layout_slots(id int,tag int,bounds &layout.Rect,styles &Styles) []SlotRect {
    _ := id
    _ := tag
    _ := bounds
    _ := styles
    << []SlotRect{}
}
fn default_custom_tick(ctx &CustomContext) bool {
    _ := ctx
    << false
}

pub struct SlotRect {
    pub is_indexed bool
    pub key int
    pub rect layout.Rect
}

pub struct CustomContext {
    pub id int
    pub tag int
    pub bounds layout.Rect
    pub enabled bool
    pub focused bool
    pub focused_within bool
    pub hovered bool
    pub hovered_within bool
    pub pressed bool
    pub opacity f64
    pub surface_state int
    pub now time.Instant
    pub reduced_motion bool
    pub motion MotionSpec
}

pub struct CustomControl {
    pub tag int
    pub focusable bool
    pub cursor int
    pub role int
    pub measure_fn fn (int,int,&layout.Constraints,&Styles) layout.Size
    pub paint_fn fn (&CustomContext,&Styles,$&draw.Frame) string
    pub overlay_fn fn (&CustomContext,&Styles,$&draw.Frame) string
    pub input_fn fn (&CustomContext,int,&ui.InputEvent) Action
    pub cursor_fn fn (&CustomContext,f64,f64) int
    pub layout_slots_fn fn (int,int,&layout.Rect,&Styles) []SlotRect
    pub tick_fn fn (&CustomContext) bool
    pub has_measure bool
    pub has_paint bool
    pub has_overlay bool
    pub has_input bool
    pub has_cursor bool
    pub has_layout_slots bool
    pub has_tick bool
}

pub fn custom_control(tag int) CustomControl {
    << CustomControl{
        tag: tag,
        focusable: false,
        cursor: ui.CURSOR_DEFAULT,
        role: ROLE_GROUP,
        measure_fn: default_custom_measure,
        paint_fn: default_custom_paint,
        overlay_fn: default_custom_paint,
        input_fn: default_custom_input,
        cursor_fn: default_custom_cursor,
        layout_slots_fn: default_custom_layout_slots,
        tick_fn: default_custom_tick,
        has_measure: false,
        has_paint: false,
        has_overlay: false,
        has_input: false,
        has_cursor: false,
        has_layout_slots: false,
        has_tick: false
    }
}

pub fn (c $&CustomControl) with_measure(f fn (int,int,&layout.Constraints,&Styles) layout.Size) {
    c.measure_fn = f
    c.has_measure = true
}
pub fn (c $&CustomControl) with_paint(f fn (&CustomContext,&Styles,$&draw.Frame) string) {
    c.paint_fn = f
    c.has_paint = true
}
pub fn (c $&CustomControl) with_overlay(f fn (&CustomContext,&Styles,$&draw.Frame) string) {
    c.overlay_fn = f
    c.has_overlay = true
}
pub fn (c $&CustomControl) with_input(f fn (&CustomContext,int,&ui.InputEvent) Action) {
    c.input_fn = f
    c.has_input = true
}
pub fn (c $&CustomControl) with_cursor(f fn (&CustomContext,f64,f64) int) {
    c.cursor_fn = f
    c.has_cursor = true
}
pub fn (c $&CustomControl) with_layout_slots(f fn (int,int,&layout.Rect,&Styles) []SlotRect) {
    c.layout_slots_fn = f
    c.has_layout_slots = true
}
pub fn (c $&CustomControl) with_tick(f fn (&CustomContext) bool) {
    c.tick_fn = f
    c.has_tick = true
}

fn copy_custom_control(c &CustomControl) CustomControl {
    << CustomControl{
        tag: c.tag,
        focusable: c.focusable,
        cursor: c.cursor,
        role: c.role,
        measure_fn: c.measure_fn,
        paint_fn: c.paint_fn,
        overlay_fn: c.overlay_fn,
        input_fn: c.input_fn,
        cursor_fn: c.cursor_fn,
        layout_slots_fn: c.layout_slots_fn,
        tick_fn: c.tick_fn,
        has_measure: c.has_measure,
        has_paint: c.has_paint,
        has_overlay: c.has_overlay,
        has_input: c.has_input,
        has_cursor: c.has_cursor,
        has_layout_slots: c.has_layout_slots,
        has_tick: c.has_tick
    }
}

struct ScreenCustomEntry {
    spec CustomControl
    bounds layout.Rect
    enabled bool
    focused bool
    hovered bool
    pressed bool
    dirty bool
    custom_style ScalarControlStyle
}

fn copy_custom_entry(e &ScreenCustomEntry) ScreenCustomEntry {
    << ScreenCustomEntry{
        spec: copy_custom_control(&e.spec),
        bounds: copy_rect(&e.bounds),
        enabled: e.enabled,
        focused: e.focused,
        hovered: e.hovered,
        pressed: e.pressed,
        dirty: e.dirty,
        custom_style: copy_scalar_style(&e.custom_style)
    }
}

pub fn (s $&Screen) custom(spec &CustomControl) int {
    if spec.cursor < ui.CURSOR_DEFAULT || spec.cursor > ui.CURSOR_RESIZE_VERTICAL {
        >> errors.new("widgets: invalid custom control cursor")
    }
    id := s.add_node(SCREEN_CUSTOM,spec.focusable,spec.cursor) >>>
    comp := $&s.composition
    entries := $&comp.customs
    entries[id] = ScreenCustomEntry{
        spec: copy_custom_control(spec),
        bounds: screen_empty(),
        enabled: true,
        focused: false,
        hovered: false,
        pressed: false,
        dirty: true,
        custom_style: empty_scalar_style()
    }
    << id
}

fn (s $&Screen) custom_set_style(id int,style &ControlStyle) int {
    validate_control(style) >>>
    if !s.composition.customs.has(id) { >> errors.new("widgets: expected Custom control") }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    entry.custom_style = pack_scalar_style(style)
    entry.dirty = true
    entries[id] = entry
    s.mark_layout_dirty()
    << 0
}

fn (s $&Screen) custom_clear_style(id int) int {
    if !s.composition.customs.has(id) { >> errors.new("widgets: expected Custom control") }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    if entry.custom_style.active {
        entry.custom_style.active = false
        entry.dirty = true
    }
    entries[id] = entry
    s.mark_layout_dirty()
    << 0
}

pub fn (s &Screen) custom_control_style(id int,styles &Styles) ControlStyle {
    $base := styles.button.clone()
    if s.composition.customs.has(id) {
        entry := &s.composition.customs[id]
        if entry.custom_style.active { base = unpack_scalar_style(&entry.custom_style) }
    }
    << s.style_or_patched(id,&base)
}

pub fn (s &Screen) custom_tag(id int) int {
    node := s.node(id) >>>
    if node.kind != SCREEN_CUSTOM || !s.composition.customs.has(id) {
        >> errors.new("widgets: expected Custom control")
    }
    entry := &s.composition.customs[id]
    << entry.spec.tag
}

pub fn (s $&Screen) set_custom_tag(id int,tag int) int {
    node := s.node(id) >>>
    if node.kind != SCREEN_CUSTOM || !s.composition.customs.has(id) {
        >> errors.new("widgets: expected Custom control")
    }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    entry.spec.tag = tag
    entry.dirty = true
    entries[id] = entry
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) set_custom_spec(id int,spec &CustomControl) int {
    node := s.node(id) >>>
    if node.kind != SCREEN_CUSTOM || !s.composition.customs.has(id) {
        >> errors.new("widgets: expected Custom control")
    }
    if spec.cursor < ui.CURSOR_DEFAULT || spec.cursor > ui.CURSOR_RESIZE_VERTICAL {
        >> errors.new("widgets: invalid custom control cursor")
    }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    entry.spec = copy_custom_control(spec)
    entry.dirty = true
    entries[id] = entry
    s.nodes[id - 1].focusable = spec.focusable
    s.nodes[id - 1].cursor = spec.cursor
    s.mark_layout_dirty()
    << 0
}

fn (s &Screen) custom_wants_input(id int) bool {
    if !s.composition.customs.has(id) { << false }
    entry := &s.composition.customs[id]
    << entry.spec.focusable || entry.spec.has_input || entry.spec.has_cursor
}

fn (s &Screen) custom_role(id int) int {
    if !s.composition.customs.has(id) { << ROLE_GROUP }
    entry := &s.composition.customs[id]
    role := entry.spec.role
    if role <= ROLE_NONE { << ROLE_GROUP }
    << role
}

fn (s $&Screen) custom_place(id int,bounds &layout.Rect) int {
    if !s.composition.customs.has(id) { >> errors.new("widgets: custom control state is unavailable") }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    old := entry.bounds
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height {
        entry.bounds = copy_rect(bounds)
        entry.dirty = true
    }
    entries[id] = entry
    << 0
}

fn (s &Screen) custom_measure(id int,constraints &layout.Constraints,styles &Styles) layout.Size {
    if !s.composition.customs.has(id) { << constraints.constrain(&layout.Size{width: 0.0,height: 0.0}) >>> }
    eff := s.resolve_styles_with_patch(id,styles)
    entry := &s.composition.customs[id]
    if entry.spec.has_measure {
        f := entry.spec.measure_fn
        << f(id,entry.spec.tag,constraints,&eff)
    }
    << constraints.constrain(&layout.Size{width: math.max(0.0,s.nodes[id - 1].local.width),height: math.max(0.0,s.nodes[id - 1].local.height)}) >>>
}

fn (s &Screen) motion_for_or_default(id int) MotionSpec {
    << s.motion_for(id) >>> (err) { << copy_motion_spec(&s.composition.default_motion) }
}

fn custom_make_context(id int,entry &ScreenCustomEntry,opacity f64,now time.Instant,reduced bool,motion &MotionSpec,hovered_within bool,focused_within bool,surface_state int) CustomContext {
    << CustomContext{
        id: id,
        tag: entry.spec.tag,
        bounds: copy_rect(&entry.bounds),
        enabled: entry.enabled,
        focused: entry.focused,
        focused_within: focused_within,
        hovered: entry.hovered,
        hovered_within: hovered_within,
        pressed: entry.pressed,
        opacity: opacity,
        surface_state: surface_state,
        now: now,
        reduced_motion: reduced,
        motion: copy_motion_spec(motion)
    }
}

fn (s $&Screen) custom_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    if !s.composition.customs.has(id) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    $active := false
    if true {
        motion := s.motion_for_or_default(id)
        hw := s.hovered > 0 && s.is_descendant(s.hovered,id)
        fw := s.focused > 0 && s.is_descendant(s.focused,id)
        sst := s.composition.surface_states.get_or(id,0)
        entry := &s.composition.customs[id]
        if entry.spec.has_tick {
            ctx := custom_make_context(id,entry,1.0,now,reduced,&motion,hw,fw,sst)
            f := entry.spec.tick_fn
            active = f(&ctx)
        }
    }
    if active {
        comp := $&s.composition
        entries := $&comp.customs
        $entry := entries.take(id)
        entry.dirty = true
        entries[id] = entry
        next_dl := overlay_next_tick(true,now) >>>
        << ScreenAnimation{changed: true,deadline: next_dl}
    }
    << ScreenAnimation{changed: false,deadline: time.zero_instant()}
}

fn (s $&Screen) custom_input(id int,route int,event &ui.InputEvent) Action {
    if !s.composition.customs.has(id) { << no_action(id,false) }
    motion := s.motion_for_or_default(id)
    hw := s.hovered > 0 && s.is_descendant(s.hovered,id)
    fw := s.focused > 0 && s.is_descendant(s.focused,id)
    sst := s.composition.surface_states.get_or(id,0)
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    if !entry.enabled && route == ROUTE_INPUT {
        entries[id] = entry
        << no_action(id,false)
    }
    $state_changed := false
    if route == ROUTE_FOCUS {
        if !entry.focused { entry.focused = true
            entry.dirty = true
            state_changed = true }
    } else if route == ROUTE_BLUR || route == ROUTE_CANCEL {
        if entry.focused || entry.hovered || entry.pressed { entry.dirty = true
            state_changed = true }
        entry.focused = false
        entry.hovered = false
        entry.pressed = false
    } else if route == ROUTE_INPUT {
        if event.kind == ui.EV_POINTER_LEAVE {
            if entry.hovered { entry.hovered = false
                entry.dirty = true
                state_changed = true }
        } else if event.kind == ui.EV_POINTER_MOVE {
            inside := entry.bounds.contains(event.x,event.y)
            if entry.hovered != inside { entry.hovered = inside
                entry.dirty = true
                state_changed = true }
        } else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT {
            if entry.bounds.contains(event.x,event.y) {
                entry.pressed = true
                entry.hovered = true
                entry.dirty = true
                state_changed = true
            }
        } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT {
            if entry.pressed { entry.pressed = false
                entry.dirty = true
                state_changed = true }
        }
    }
    $action := no_action(id,entry.dirty)
    if entry.spec.has_input {
        ctx := custom_make_context(id,&entry,1.0,s.now,s.reduced,&motion,hw,fw,sst)
        f := entry.spec.input_fn
        action = f(&ctx,route,event)
        if action.id <= 0 { action.id = id }
        if state_changed { action.needs_paint = true }
        if action.needs_paint { entry.dirty = true }
    }
    entries[id] = entry
    << action
}

pub fn (s $&Screen) invalidate_custom(id int,relayout bool) int {
    node := s.node(id) >>>
    if node.kind != SCREEN_CUSTOM || !s.composition.customs.has(id) {
        >> errors.new("widgets: expected Custom control")
    }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    entry.dirty = true
    entries[id] = entry
    if relayout { s.mark_layout_dirty() }
    else { s.mark_paint_dirty() }
    << 0
}

pub fn (s &Screen) custom_state(id int) CustomContext {
    node := s.node(id) >>>
    if node.kind != SCREEN_CUSTOM || !s.composition.customs.has(id) {
        >> errors.new("widgets: expected Custom control")
    }
    op := s.effective_opacity(id) >>>
    motion := s.motion_for_or_default(id)
    hw := s.hovered > 0 && s.is_descendant(s.hovered,id)
    fw := s.focused > 0 && s.is_descendant(s.focused,id)
    sst := s.composition.surface_states.get_or(id,0)
    << custom_make_context(id,&s.composition.customs[id],op,s.now,s.reduced,&motion,hw,fw,sst)
}

fn (s &Screen) custom_paint(id int,frame $&draw.Frame,styles &Styles,opacity f64,popup bool) int {
    if !s.composition.customs.has(id) { << 0 }
    $eff := s.resolve_styles_with_patch(id,styles)
    if opacity < 1.0 { eff = eff.with_opacity(opacity) >>> }
    motion := s.motion_for_or_default(id)
    hw := s.hovered > 0 && s.is_descendant(s.hovered,id)
    fw := s.focused > 0 && s.is_descendant(s.focused,id)
    sst := s.composition.surface_states.get_or(id,0)
    entry := &s.composition.customs[id]
    ctx := custom_make_context(id,entry,opacity,s.now,s.reduced,&motion,hw,fw,sst)
    if !popup && entry.spec.has_paint {
        f := entry.spec.paint_fn
        err_msg := f(&ctx,&eff,frame)
        if err_msg.len > 0 { >> errors.new(err_msg) }
    } else if popup && entry.spec.has_overlay {
        f := entry.spec.overlay_fn
        err_msg := f(&ctx,&eff,frame)
        if err_msg.len > 0 { >> errors.new(err_msg) }
    }
    << 0
}

fn (s &Screen) custom_cursor(id int,x f64,y f64) int {
    if !s.composition.customs.has(id) { << ui.CURSOR_DEFAULT }
    hw := s.hovered > 0 && s.is_descendant(s.hovered,id)
    fw := s.focused > 0 && s.is_descendant(s.focused,id)
    sst := s.composition.surface_states.get_or(id,0)
    entry := &s.composition.customs[id]
    if !entry.enabled { << ui.CURSOR_DEFAULT }
    if entry.spec.has_cursor {
        motion := s.motion_for_or_default(id)
        ctx := custom_make_context(id,entry,1.0,s.now,s.reduced,&motion,hw,fw,sst)
        f := entry.spec.cursor_fn
        << f(&ctx,x,y)
    }
    << entry.spec.cursor
}

fn (s &Screen) custom_layout_slots(id int,bounds &layout.Rect,styles &Styles) []SlotRect {
    if !s.composition.customs.has(id) { << []SlotRect{} }
    entry := &s.composition.customs[id]
    if entry.spec.has_layout_slots {
        f := entry.spec.layout_slots_fn
        << f(id,entry.spec.tag,bounds,styles)
    }
    << []SlotRect{}
}

fn (s $&Screen) custom_enable(id int,enabled bool) int {
    if !s.composition.customs.has(id) { << 0 }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    if entry.enabled != enabled {
        entry.enabled = enabled
        if !enabled {
            entry.focused = false
            entry.hovered = false
            entry.pressed = false
        }
        entry.dirty = true
    }
    entries[id] = entry
    << 0
}

fn (s $&Screen) custom_painted(id int) {
    if !s.composition.customs.has(id) { << }
    comp := $&s.composition
    entries := $&comp.customs
    $entry := entries.take(id)
    entry.dirty = false
    entries[id] = entry
}

fn (s $&Screen) custom_dispose(id int) {
    if !s.composition.customs.has(id) { << }
    comp := $&s.composition
    entries := $&comp.customs
    _ := entries.take(id)
}
