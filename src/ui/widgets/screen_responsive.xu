@ui/widgets

#ui
#ui/layout
#errors
#math

pub const RULE_LAYOUT_KIND = 1
pub const RULE_PADDING = 2
pub const RULE_GAP = 4
pub const RULE_RUN_GAP = 8
pub const RULE_MAIN_ALIGNMENT = 16
pub const RULE_CROSS_ALIGNMENT = 32
pub const RULE_COLUMNS = 64
pub const RULE_MIN_COL_WIDTH = 128
pub const RULE_STYLE_SCOPE = 256
pub const RULE_ALIGN = 512
pub const RULE_VISIBILITY = 1024

pub struct ContainerRule {
    pub min_width f64
    pub max_width f64
    pub min_height f64
    pub max_height f64
    pub fields int
    pub kind int
    pub padding layout.Insets
    pub gap f64
    pub run_gap f64
    pub main_alignment int
    pub cross_alignment int
    pub align_x f64
    pub align_y f64
    pub columns int
    pub min_col_width f64
    pub scope StyleDelta
    pub visibility int
    pub match_viewport bool
}

pub fn container_rule() ContainerRule {
    << ContainerRule{
        min_width: 0.0,
        max_width: -1.0,
        min_height: 0.0,
        max_height: -1.0,
        fields: 0,
        kind: LAYOUT_COLUMN,
        padding: layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0},
        gap: 0.0,
        run_gap: 0.0,
        main_alignment: layout.MAIN_START,
        cross_alignment: layout.CROSS_START,
        align_x: -1.0,
        align_y: -1.0,
        columns: 1,
        min_col_width: 0.0,
        scope: style_delta(),
        visibility: VISIBILITY_VISIBLE,
        match_viewport: false
    }
}

pub fn container_rule_below(max_width f64) ContainerRule {
    $r := container_rule()
    r.max_width = max_width
    << r
}

pub fn container_rule_above(min_width f64) ContainerRule {
    $r := container_rule()
    r.min_width = min_width
    << r
}

pub fn container_rule_between(min_width f64,max_width f64) ContainerRule {
    $r := container_rule()
    r.min_width = min_width
    r.max_width = max_width
    << r
}

pub fn viewport_rule_below(max_width f64) ContainerRule {
    $r := container_rule_below(max_width)
    r.match_viewport = true
    << r
}

pub fn viewport_rule_above(min_width f64) ContainerRule {
    $r := container_rule_above(min_width)
    r.match_viewport = true
    << r
}

pub fn (r &ContainerRule) clone() ContainerRule {
    << ContainerRule{
        min_width: r.min_width,
        max_width: r.max_width,
        min_height: r.min_height,
        max_height: r.max_height,
        fields: r.fields,
        kind: r.kind,
        padding: layout.Insets{left: r.padding.left,top: r.padding.top,right: r.padding.right,bottom: r.padding.bottom},
        gap: r.gap,
        run_gap: r.run_gap,
        main_alignment: r.main_alignment,
        cross_alignment: r.cross_alignment,
        align_x: r.align_x,
        align_y: r.align_y,
        columns: r.columns,
        min_col_width: r.min_col_width,
        scope: r.scope.clone(),
        visibility: r.visibility,
        match_viewport: r.match_viewport
    }
}

pub fn (r &ContainerRule) validate() int {
    if !finite_metric(r.min_width,100000.0) ||
       (r.max_width != -1.0 && (!finite_metric(r.max_width,100000.0) || r.max_width < r.min_width)) ||
       !finite_metric(r.min_height,100000.0) ||
       (r.max_height != -1.0 && (!finite_metric(r.max_height,100000.0) || r.max_height < r.min_height)) {
        >> errors.new("widgets: invalid container rule bounds")
    }
    if r.fields < 0 || r.fields >= (RULE_VISIBILITY * 2) {
        >> errors.new("widgets: invalid container rule fields")
    }
    f := r.fields
    if (f & RULE_LAYOUT_KIND) != 0 && (r.kind < LAYOUT_NONE || r.kind > LAYOUT_PADDING) {
        >> errors.new("widgets: invalid container rule layout kind")
    }
    if (f & RULE_PADDING) != 0 { r.padding.validate() >>> }
    if (f & RULE_GAP) != 0 && !finite_metric(r.gap,4096.0) {
        >> errors.new("widgets: invalid container rule gap")
    }
    if (f & RULE_RUN_GAP) != 0 && !finite_metric(r.run_gap,4096.0) {
        >> errors.new("widgets: invalid container rule run gap")
    }
    if (f & RULE_MAIN_ALIGNMENT) != 0 && (r.main_alignment < layout.MAIN_START || r.main_alignment > layout.MAIN_SPACE_EVENLY) {
        >> errors.new("widgets: invalid container rule main alignment")
    }
    if (f & RULE_CROSS_ALIGNMENT) != 0 && (r.cross_alignment < layout.CROSS_START || r.cross_alignment > layout.CROSS_STRETCH) {
        >> errors.new("widgets: invalid container rule cross alignment")
    }
    if (f & RULE_ALIGN) != 0 && (math.is_nan(r.align_x) || math.is_inf(r.align_x) || math.abs(r.align_x) > 1.0 ||
        math.is_nan(r.align_y) || math.is_inf(r.align_y) || math.abs(r.align_y) > 1.0) {
        >> errors.new("widgets: invalid container rule alignment")
    }
    if (f & RULE_COLUMNS) != 0 && (r.columns < 1 || r.columns > 256) {
        >> errors.new("widgets: invalid container rule columns")
    }
    if (f & RULE_MIN_COL_WIDTH) != 0 && !finite_metric(r.min_col_width,100000.0) {
        >> errors.new("widgets: invalid container rule min column width")
    }
    if (f & RULE_STYLE_SCOPE) != 0 {
        r.scope.validate() >>>
    }
    if (f & RULE_VISIBILITY) != 0 && (r.visibility < VISIBILITY_VISIBLE || r.visibility > VISIBILITY_COLLAPSED) {
        >> errors.new("widgets: invalid container rule visibility")
    }
    << 0
}

pub fn (r &ContainerRule) matches(width f64,height f64) bool {
    if r.min_width > 0.0 && (width >= 100000.0 || width < r.min_width) { << false }
    if r.max_width >= 0.0 && (width >= 100000.0 || width > r.max_width) { << false }
    if r.min_height > 0.0 && (height >= 100000.0 || height < r.min_height) { << false }
    if r.max_height >= 0.0 && (height >= 100000.0 || height > r.max_height) { << false }
    << true
}

fn apply_container_rule_to_layout(cfg $&ContainerLayout,r &ContainerRule) {
    f := r.fields
    if f == 0 { << }
    if (f & RULE_LAYOUT_KIND) != 0 { cfg.kind = r.kind }
    if (f & RULE_PADDING) != 0 {
        cfg.padding = layout.Insets{left: r.padding.left,top: r.padding.top,right: r.padding.right,bottom: r.padding.bottom}
    }
    if (f & RULE_GAP) != 0 { cfg.gap = r.gap }
    if (f & RULE_RUN_GAP) != 0 { cfg.run_gap = r.run_gap }
    if (f & RULE_MAIN_ALIGNMENT) != 0 { cfg.main_alignment = r.main_alignment }
    if (f & RULE_CROSS_ALIGNMENT) != 0 { cfg.cross_alignment = r.cross_alignment }
    if (f & RULE_ALIGN) != 0 {
        cfg.align_x = r.align_x
        cfg.align_y = r.align_y
    }
    if (f & RULE_COLUMNS) != 0 {
        cfg.columns = r.columns
        if cfg.col_weights.len != r.columns { cfg.col_weights = []f64{} }
    }
    if (f & RULE_MIN_COL_WIDTH) != 0 { cfg.min_col_width = r.min_col_width }
}

fn (s &Screen) apply_container_rules_to_layout(id int,cfg $&ContainerLayout,width f64,height f64) {
    if s.composition.container_rule_count == 0 || !s.composition.container_rules.has(id) { << }
    idxs := &s.composition.container_rules[id]
    for i in 0:idxs.len {
        idx := idxs[i]
        r := &s.composition.container_rule_values[idx]
        $qw := width
        $qh := height
        if r.match_viewport {
            qw = s.width
            qh = s.height
        }
        if r.matches(qw,qh) {
            apply_container_rule_to_layout(cfg,r)
        }
    }
}

fn (s &Screen) merged_rule_scope_for(id int,width f64,height f64) StyleDelta {
    $acc := style_delta()
    if s.composition.container_rule_count == 0 || !s.composition.container_rules.has(id) { << acc }
    idxs := &s.composition.container_rules[id]
    for i in 0:idxs.len {
        idx := idxs[i]
        r := &s.composition.container_rule_values[idx]
        $qw := width
        $qh := height
        if r.match_viewport {
            qw = s.width
            qh = s.height
        }
        if (r.fields & RULE_STYLE_SCOPE) != 0 && r.matches(qw,qh) {
            acc = acc.merge(&r.scope)
        }
    }
    << acc
}

fn (s $&Screen) apply_responsive_visibility_quiet(id int,mode int) int {
    n := s.nodes[id - 1]
    if mode == VISIBILITY_COLLAPSED {
        if s.composition.hidden_nodes.has(id) {
            comp := $&s.composition
            hn := $&comp.hidden_nodes
            hn.delete(id)
            if comp.hidden_node_count > 0 { comp.hidden_node_count = comp.hidden_node_count - 1 }
        }
        if n.visible {
            prev_focused := s.focused
            event := s.cancellation()
            s.cancel_subtree_input(id,&event) >>>
            if s.is_descendant(s.focused,id) { s.focused = 0 }
            if s.is_descendant(s.captured,id) { s.captured = 0 }
            if s.is_descendant(s.hovered,id) {
                s.hovered = 0
                s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
            }
            s.nodes[id - 1].visible = false
            if s.composition.focus_trap_stack.len > 0 {
                s.restore_hidden_focus_trap(id,prev_focused) >>>
            }
        }
        << 0
    }
    if mode == VISIBILITY_VISIBLE {
        s.nodes[id - 1].visible = true
        if s.composition.hidden_nodes.has(id) {
            comp := $&s.composition
            hn := $&comp.hidden_nodes
            hn.delete(id)
            if comp.hidden_node_count > 0 { comp.hidden_node_count = comp.hidden_node_count - 1 }
        }
        << 0
    }
    s.nodes[id - 1].visible = true
    if !s.composition.hidden_nodes.has(id) {
        prev_focused := s.focused
        event := s.cancellation()
        s.cancel_subtree_input(id,&event) >>>
        if s.is_descendant(s.focused,id) { s.focused = 0 }
        if s.is_descendant(s.captured,id) { s.captured = 0 }
        if s.is_descendant(s.hovered,id) {
            s.hovered = 0
            s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
        }
        comp := $&s.composition
        hn := $&comp.hidden_nodes
        hn[id] = true
        comp.hidden_node_count = comp.hidden_node_count + 1
        if comp.focus_trap_stack.len > 0 {
            s.restore_hidden_focus_trap(id,prev_focused) >>>
        }
    }
    << 0
}

fn (s $&Screen) apply_responsive_visibility_for_children(parent int,parent_w f64,parent_h f64) int {
    if s.composition.responsive_visibility_count == 0 { << 0 }
    child_count := s.child_count_of(parent)
    for ci in 0:child_count {
        cid := s.child_at_of(parent,ci)
        if cid <= 0 || cid > s.nodes.len { -> }
        cn := s.nodes[cid - 1]
        if cn.kind < 0 || cn.parent != parent || screen_is_overlay(cn.kind) { -> }
        if !s.composition.container_rules.has(cid) { -> }
        $has_vis_rule := false
        $target := VISIBILITY_VISIBLE
        if true {
            idxs := &s.composition.container_rules[cid]
            for i in 0:idxs.len {
                idx := idxs[i]
                r := &s.composition.container_rule_values[idx]
                if (r.fields & RULE_VISIBILITY) != 0 {
                    has_vis_rule = true
                    $qw := parent_w
                    $qh := parent_h
                    if r.match_viewport {
                        qw = s.width
                        qh = s.height
                    }
                    if r.matches(qw,qh) { target = r.visibility }
                }
            }
        }
        if has_vis_rule {
            s.apply_responsive_visibility_quiet(cid,target) >>>
        }
    }
    << 0
}

fn (s $&Screen) clear_active_rule_scope_internal(id int) {
    if !s.composition.active_rule_scopes.has(id) { << }
    comp := $&s.composition
    ars := $&comp.active_rule_scopes
    old_slot := ars.take(id)
    if old_slot > 0 {
        free := $&comp.active_rule_scope_free
        free.push(old_slot - 1)
    }
    if comp.active_rule_scope_count > 0 { comp.active_rule_scope_count = comp.active_rule_scope_count - 1 }
}

fn (s $&Screen) update_active_container_rule_scope(id int,width f64,height f64) {
    delta := s.merged_rule_scope_for(id,width,height)
    if delta.fields == 0 {
        s.clear_active_rule_scope_internal(id)
        <<
    }
    comp := $&s.composition
    ars := $&comp.active_rule_scopes
    if ars.has(id) {
        idx := ars[id] - 1
        comp.active_rule_scope_values[idx] = delta.clone()
    } else if comp.active_rule_scope_free.len > 0 {
        flen := comp.active_rule_scope_free.len
        idx := comp.active_rule_scope_free[flen - 1]
        if flen <= 1 { comp.active_rule_scope_free = []int{} }
        else { comp.active_rule_scope_free = comp.active_rule_scope_free[0:flen - 1] }
        comp.active_rule_scope_values[idx] = delta.clone()
        ars[id] = idx + 1
        comp.active_rule_scope_count = comp.active_rule_scope_count + 1
    } else {
        idx := comp.active_rule_scope_values.len
        vals := $&comp.active_rule_scope_values
        vals.push(delta.clone())
        ars[id] = idx + 1
        comp.active_rule_scope_count = comp.active_rule_scope_count + 1
    }
}

fn (s $&Screen) cleanup_container_rules_for(id int) {
    if s.composition.container_rules.has(id) {
        comp := $&s.composition
        cr := $&comp.container_rules
        old := cr.take(id)
        free := $&comp.container_rule_free
        for idx in old {
            if (comp.container_rule_values[idx].fields & RULE_VISIBILITY) != 0 && comp.responsive_visibility_count > 0 {
                comp.responsive_visibility_count = comp.responsive_visibility_count - 1
            }
            free.push(idx)
            if comp.container_rule_count > 0 { comp.container_rule_count = comp.container_rule_count - 1 }
        }
    }
    s.clear_active_rule_scope_internal(id)
}

pub fn (s $&Screen) add_container_rule(id int,rule &ContainerRule) int {
    _ := s.node(id) >>>
    rule.validate() >>>
    if s.composition.container_rules.has(id) {
        existing := &s.composition.container_rules[id]
        if existing.len >= 16 { >> errors.new("widgets: too many container rules") }
    }
    comp := $&s.composition
    $slot_idx := 0
    if comp.container_rule_free.len > 0 {
        flen := comp.container_rule_free.len
        slot_idx = comp.container_rule_free[flen - 1]
        if flen <= 1 { comp.container_rule_free = []int{} }
        else { comp.container_rule_free = comp.container_rule_free[0:flen - 1] }
        comp.container_rule_values[slot_idx] = rule.clone()
    } else {
        slot_idx = comp.container_rule_values.len
        vals := $&comp.container_rule_values
        vals.push(rule.clone())
    }
    cr := $&comp.container_rules
    if !cr.has(id) { cr[id] = []int{} }
    $idxs := cr.take(id)
    idxs.push(slot_idx)
    cr[id] = idxs
    comp.container_rule_count = comp.container_rule_count + 1
    if (rule.fields & RULE_VISIBILITY) != 0 {
        comp.responsive_visibility_count = comp.responsive_visibility_count + 1
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) set_container_rules(id int,rules &[]ContainerRule) int {
    _ := s.node(id) >>>
    if rules.len > 16 { >> errors.new("widgets: too many container rules") }
    for rule in rules {
        rule.validate() >>>
    }
    s.cleanup_container_rules_for(id)
    for rule in rules {
        s.add_container_rule(id,&rule) >>>
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_container_rules(id int) int {
    _ := s.node(id) >>>
    if s.composition.container_rules.has(id) || s.composition.active_rule_scopes.has(id) {
        s.cleanup_container_rules_for(id)
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s &Screen) container_rule_count(id int) int {
    _ := s.node(id) >>>
    if !s.composition.container_rules.has(id) { << 0 }
    idxs := &s.composition.container_rules[id]
    << idxs.len
}

pub fn (s &Screen) active_container_layout(id int) ContainerLayout {
    n := s.node(id) >>>
    if !s.composition.containers.has(id) { << container_layout(LAYOUT_NONE) }
    $w := n.bounds.width
    $h := n.bounds.height
    if s.basics.scrolls.has(id) {
        sc_clip := s.scroll_content_clip(id)
        w = sc_clip.width
        h = sc_clip.height
    }
    st := s.styles_for(id)
    << s.resolve_container_layout_for(id,w,h,&st)
}
