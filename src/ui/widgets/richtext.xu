@ui/widgets

#ui/draw
#errors
#strings

// Inline text styling flags for RichText spans.
pub const SPAN_NORMAL = 0
pub const SPAN_BOLD = 1
pub const SPAN_ITALIC = 2
pub const SPAN_CODE = 4
pub const SPAN_UNDERLINE = 8
pub const SPAN_STRIKETHROUGH = 16
pub const SPAN_LINK = 32

pub struct TextSpan {
    pub text string
    pub flags int
    pub link_url string
    pub color draw.Color
}

pub fn text_span(text string, flags int) TextSpan {
    << TextSpan{text: text, flags: flags, link_url: "", color: draw.rgb(0, 0, 0)}
}

pub fn (span &TextSpan) has_flag(flag int) bool {
    << (span.flags & flag) != 0
}

pub fn (span $&TextSpan) toggle_flag(flag int) {
    span.flags = span.flags ^ flag
}

pub fn (span &TextSpan) clone() TextSpan {
    << TextSpan{text: span.text + "", flags: span.flags, link_url: span.link_url + "", color: span.color}
}

pub struct RichParagraph {
    pub spans []TextSpan
    pub heading_level int
}

pub fn rich_paragraph(heading int) RichParagraph {
    << RichParagraph{spans: []TextSpan{}, heading_level: heading}
}

pub fn (p &RichParagraph) text() string {
    $out := ""
    for span in p.spans {
        out = out + span.text
    }
    << out
}

pub fn (p $&RichParagraph) append_span(span TextSpan) {
    p.spans.push(span)
}

pub struct RichDocument {
    pub paragraphs []RichParagraph
    pub anchor int
    pub focus int
    // When false, selected_text() returns empty so clipboard export is blocked.
    copy_enabled bool
}

pub fn rich_document() RichDocument {
    << RichDocument{paragraphs: []RichParagraph{}, anchor: 0, focus: 0, copy_enabled: true}
}

pub fn (doc &RichDocument) is_empty() bool {
    if doc.paragraphs.len == 0 { << true }
    for p in doc.paragraphs {
        if p.spans.len > 0 { << false }
    }
    << true
}

pub fn (doc $&RichDocument) append_paragraph(heading int) int {
    doc.paragraphs.push(rich_paragraph(heading))
    << doc.paragraphs.len - 1
}

pub fn (doc $&RichDocument) append_span(para_idx int, span TextSpan) int {
    if para_idx < 0 || para_idx >= doc.paragraphs.len {
        >> errors.new("widgets: paragraph index out of range")
    }
    p := $&doc.paragraphs[para_idx]
    p.append_span(span)
    << 0
}

pub fn (doc &RichDocument) to_plain_text() string {
    $out := ""
    for i in 0:doc.paragraphs.len {
        p := &doc.paragraphs[i]
        out = out + p.text()
        if i + 1 < doc.paragraphs.len {
            out = out + "\n"
        }
    }
    << out
}

pub fn (doc &RichDocument) char_count() int {
    $count := 0
    for p in doc.paragraphs {
        for span in p.spans {
            count = count + span.text.len
        }
    }
    << count
}

pub fn (doc $&RichDocument) set_selection(anchor int, focus int) {
    n := doc.to_plain_text().len
    $a := anchor
    $b := focus
    if a < 0 { a = 0 }
    if b < 0 { b = 0 }
    if a > n { a = n }
    if b > n { b = n }
    doc.anchor = a
    doc.focus = b
}

pub fn (doc &RichDocument) has_selection() bool {
    << doc.anchor != doc.focus
}

pub fn (doc &RichDocument) is_copy_enabled() bool {
    << doc.copy_enabled
}

pub fn (doc $&RichDocument) set_copy_enabled(on bool) {
    doc.copy_enabled = on
}

pub fn (doc &RichDocument) selection_range() TextRange {
    << text_range(doc.anchor, doc.focus)
}

// Plain-text slice of the current selection, suitable for clipboard copy.
// Indexes are UTF-8 byte offsets into to_plain_text(). Empty when copy is disabled.
pub fn (doc &RichDocument) selected_text() string {
    if !doc.copy_enabled { << "" }
    plain := doc.to_plain_text()
    range := doc.selection_range()
    $start := range.start
    $end := range.end
    if start < 0 { start = 0 }
    if end < 0 { end = 0 }
    if start > plain.len { start = plain.len }
    if end > plain.len { end = plain.len }
    if start >= end { << "" }
    << plain[start:end]
}
