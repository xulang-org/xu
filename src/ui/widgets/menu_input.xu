@ui/widgets
#ui
#ui/layout
#time
#math

fn (m &Menu) item_enabled(index int) bool {
    if index < 0 || index >= m.items.len || !m.is_enabled() || !m.items[index].enabled || m.items[index].kind == MENU_SEPARATOR || m.items[index].kind == MENU_HEADING { << false }
    $parent := m.items[index].parent
    $budget := m.items.len
    while parent > 0 && budget > 0 {
        ancestor := m.index(parent)
        if ancestor < 0 || !m.items[ancestor].enabled { << false }
        parent = m.items[ancestor].parent
        budget -= 1 }
    << parent == 0
}
fn (m &Menu) next(parent int,start int,direction int) int {
    if m.items.len == 0 { << -1 }
    for offset in 1:m.items.len + 1 {
        index := (start + direction * offset + m.items.len * 2) % m.items.len
        if m.items[index].parent == parent && m.item_enabled(index) { << index } }
    << -1
}
fn (m $&Menu) truncate(count int) {
    if count >= m.path.len { << }
    $path := []int{}
    $offsets := []f64{}
    for i in 0:count { path.push(m.path[i])
        offsets.push(m.offsets[i]) }
    m.path = path
    m.offsets = offsets
    m.control.dirty = true
}
pub fn (m $&Menu) open_at(x f64,y f64,context bool) int {
    if !m.is_enabled() { << 0 }
    m.anchor = m.bounds()
    if context { m.anchor = layout.Rect{x: x,y: y,width: 0.0,height: 0.0} }
    m.path = [0]
    m.offsets = [0.0]
    m.opened = true
    m.active = m.next(0,-1,1)
    m.hot = -1
    m.hover_item = -1
    m.hover_due = time.zero_instant()
    now := m.now
    spec := m.motion
    reduced := m.reduced
    fade := $&m.fade
    fade.retarget_unit(1.0,now,spec.enter,reduced) or >>
    m.control.dirty = true
    << 0
}
fn (m $&Menu) open_child(index int) int {
    if !m.item_enabled(index) || m.items[index].kind != MENU_SUBMENU { << 0 }
    depth := m.item_depth(index)
    if depth < 0 { << 0 }
    key := m.items[index].key
    if depth + 1 < m.path.len && m.path[depth + 1] == key { m.active = m.next(key,-1,1)
        << 0 }
    m.truncate(depth + 1)
    m.path.push(key)
    m.offsets.push(0.0)
    m.active = m.next(key,-1,1)
    m.hover_due = time.zero_instant()
    motion := $&m.submenu_fade
    motion.snap(0.0) or >>
    m.control.dirty = true
    << 0
}
fn (m $&Menu) activate(index int) Action {
    $action := no_action(m.id(),m.needs_paint())
    action.consumed = true
    if !m.item_enabled(index) || m.control.read_only { << action }
    if m.items[index].kind == MENU_SUBMENU { m.open_child(index) or >>
        action.needs_paint = true
        << action }
    key := m.items[index].key
    kind := m.items[index].kind
    action.kind = ACTION_ACTIVATE
    action.value = f64(key)
    if kind == MENU_CHECK || kind == MENU_RADIO {
        $next := true
        if kind == MENU_CHECK { next = !m.items[index].checked }
        m.set_checked(key,next) or >>
        action.kind = ACTION_CHANGE }
    if m.appearance.close_on_select { m.close() or >> }
    m.control.dirty = true
    action.needs_paint = true
    << action
}
fn menu_key(key int) int { if key >= 65 && key <= 90 { << key + 32 }
    << key }
pub fn (m $&Menu) shortcut(event &ui.InputEvent) Action {
    if !belongs(&m.control.identity,event) || event.kind != ui.EV_KEY_DOWN || event.repeat != 0 || !m.is_enabled() || m.control.read_only { << no_action(m.id(),false) }
    if !m.opened && !m.control.focused && (event.modifiers & (ui.MOD_CONTROL | ui.MOD_META | ui.MOD_ALT)) == 0 { << no_action(m.id(),false) }
    for i in 0:m.items.len { if m.items[i].shortcut_key > 0 && menu_key(m.items[i].shortcut_key) == menu_key(event.key) && m.items[i].shortcut_modifiers == event.modifiers && m.items[i].kind <= MENU_RADIO && m.item_enabled(i) {
        << m.activate(i) or >> } }
    << no_action(m.id(),false)
}
fn (m &Menu) in_panels(x f64,y f64) bool {
    for panel in m.panels { if panel.contains(x,y) { << true } }
    << false
}
pub fn (m $&Menu) input(event &ui.InputEvent) Action {
    if !belongs(&m.control.identity,event) || m.control.closed { << no_action(m.id(),false) }
    if event.kind == ui.EV_POINTER_CANCEL { m.cancel()
        << no_action(m.id(),true) }
    if !m.is_enabled() { << no_action(m.id(),m.needs_paint()) }
    if event.kind == ui.EV_KEY_DOWN { m.hot = -1
        m.hover_due = time.zero_instant()
        m.hover_item = -1 }
    $action := no_action(m.id(),m.needs_paint())
    bounds := m.bounds()
    inside := bounds.contains(event.x,event.y)
    index := m.hit(event.x,event.y)
    panel_hit := m.opened && m.in_panels(event.x,event.y)
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER {
        hot := inside || panel_hit
        if m.control.hovered != hot || m.hot != index { m.control.hovered = hot
            m.hot = index
            m.control.dirty = true
            m.hover_due = time.zero_instant()
            m.hover_item = -1
            if m.opened && m.item_enabled(index) {
                m.active = index
                m.hot_depth = m.item_depth(index)
                m.hover_item = index
                m.hover_due = m.now.add(m.appearance.hover_delay) or >> } }
        action.consumed = panel_hit
    } else if event.kind == ui.EV_POINTER_LEAVE {
        m.control.hovered = false
        m.hot = -1
        m.hover_due = time.zero_instant()
        m.control.dirty = true
    } else if event.kind == ui.EV_POINTER_SCROLL && panel_hit {
        $depth := m.panels.len - 1
        while depth >= 0 { if m.panels[depth].contains(event.x,event.y) {
            limit := math.max(0.0,m.panel_content_height(m.path[depth]) - m.panels[depth].height)
            m.offsets[depth] = math.max(0.0,math.min(limit,m.offsets[depth] + event.dy))
            m.hover_due = time.zero_instant()
            m.hover_item = -1
            m.hot = -1
            m.control.dirty = true
            <- }
            depth -= 1 }
        action.consumed = true
    } else if event.kind == ui.EV_POINTER_DOWN {
        if event.button == ui.BUTTON_RIGHT && inside && m.mode == MENU_CONTEXT {
            m.open_at(event.x,event.y,true) or >>
            m.armed = -3
            action.request_focus = true
            action.consumed = true
        } else if event.button == ui.BUTTON_LEFT && panel_hit {
            m.armed = -1
            if m.item_enabled(index) { m.armed = index
                m.active = index }
            action.consumed = true
            m.control.dirty = true
        } else if event.button == ui.BUTTON_LEFT && inside {
            action.request_focus = true
            action.consumed = true
            m.control.pointer_armed = !m.control.read_only
            if m.mode == MENU_SPLIT && event.x < bounds.x + bounds.width - 36.0 * m.density {
                if !m.control.read_only { m.armed = -2 } }
            else if m.mode != MENU_CONTEXT {
                if m.opened { m.close() or >> }
                else { m.open_at(bounds.x,bounds.y,false) or >> }
                m.armed = -3 }
            m.control.dirty = true
        } else if m.opened { m.close() or >> }
    } else if event.kind == ui.EV_POINTER_UP {
        armed := m.armed
        m.armed = -1
        m.control.pointer_armed = false
        if armed == -2 {
            if inside && event.x < bounds.x + bounds.width - 36.0 * m.density && !m.control.read_only {
                action.kind = ACTION_ACTIVATE
                action.value = f64(m.primary_key)
                m.close() or >> }
            action.consumed = true
        } else if armed >= 0 {
            if panel_hit && index == armed { action = m.activate(index) or >> }
            action.consumed = true
        } else if armed == -3 || panel_hit { action.consumed = true }
        m.control.dirty = true
    } else if event.kind == ui.EV_KEY_DOWN && m.control.focused {
        if !m.opened {
            context := event.key == ui.KEY_F1 + 9 && (event.modifiers & ui.MOD_SHIFT) != 0
            if context || event.key == ui.KEY_DOWN || event.key == ui.KEY_UP || event.key == ui.KEY_ENTER || event.key == 32 {
                if m.mode == MENU_SPLIT && !context && (event.key == ui.KEY_ENTER || event.key == 32) {
                    if !m.control.read_only && event.repeat == 0 { m.key_armed = event.key } }
                else { m.open_at(bounds.x,bounds.y,false) or >>
                    if event.key == ui.KEY_UP { m.active = m.next(0,m.items.len,-1) }
                    m.key_armed = 0 - event.key }
                action.consumed = true }
        } else if event.key == ui.KEY_ESCAPE {
            if m.path.len > 1 { parent := m.index(m.path[m.path.len - 1])
                m.truncate(m.path.len - 1)
                m.active = parent }
            else { m.close() or >> }
            action.consumed = true
        } else if event.key == ui.KEY_LEFT && m.path.len > 1 {
            parent := m.index(m.path[m.path.len - 1])
            m.truncate(m.path.len - 1)
            m.active = parent
            action.consumed = true
        } else if event.key == ui.KEY_RIGHT && m.active >= 0 {
            m.open_child(m.active) or >>
            action.consumed = true
        } else if event.key == ui.KEY_DOWN || event.key == ui.KEY_UP || event.key == ui.KEY_HOME || event.key == ui.KEY_END {
            parent := m.path[m.path.len - 1]
            $direction := 1
            $start := m.active
            if event.key == ui.KEY_UP { direction = -1 }
            if event.key == ui.KEY_HOME { start = -1 }
            if event.key == ui.KEY_END { start = m.items.len
                direction = -1 }
            m.active = m.next(parent,start,direction)
            m.key_armed = 0
            m.reveal_active()
            action.consumed = true
        } else if (event.key == ui.KEY_ENTER || event.key == 32) && event.repeat == 0 {
            m.key_armed = event.key
            action.consumed = true }
        m.control.dirty = true
    } else if event.kind == ui.EV_KEY_UP && m.control.focused && m.key_armed != 0 {
        armed := m.key_armed
        m.key_armed = 0
        if event.key == armed {
            if m.opened { action = m.activate(m.active) or >> }
            else if m.mode == MENU_SPLIT && !m.control.read_only { action.kind = ACTION_ACTIVATE
                action.value = f64(m.primary_key) }
            action.consumed = true
        } else if event.key == 0 - armed { action.consumed = true }
    }
    action.needs_paint = m.needs_paint()
    << action
}
pub fn (m $&Menu) route(kind int,event &ui.InputEvent) Action {
    if kind == ROUTE_FOCUS { m.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { m.cancel() }
    else if kind == ROUTE_INPUT { << m.input(event) or >> }
    << no_action(m.id(),m.needs_paint())
}
