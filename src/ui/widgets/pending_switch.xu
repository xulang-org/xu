@ui/widgets
#ui/draw
#ui/layout
#math
#errors

pub fn (sw &Switch) is_pending() bool { << sw.pending }
// Business code completes or rolls back the value and then clears pending.
// The switch keeps keyboard focus while suppressing repeated submissions.
pub fn (sw $&Switch) set_pending(pending bool) {
    if sw.pending != pending { sw.pending = pending
        sw.control.pointer_armed = false
        sw.control.keyboard_armed = 0
        sw.control.dirty = true }
}
fn (sw &Switch) paint_pending(frame $&draw.Frame,bounds &layout.Rect,color draw.Color) int {
    radius := bounds.width * 0.28
    dot := math.max(1.5,bounds.width * 0.12)
    for index in 0:3 { angle := sw.activity * 6.283185307179586 + f64(index) * 2.094395102393195
        b := layout.Rect{x: bounds.x + bounds.width * 0.5 + math.cos(angle) * radius - dot * 0.5,
            y: bounds.y + bounds.height * 0.5 + math.sin(angle) * radius - dot * 0.5,width: dot,height: dot}
        rounded_fill(frame,&b,dot * 0.5,color) or >> }
    << 0
}
pub fn (s $&Screen) set_switch_pending(id int,pending bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_SWITCH { >> errors.new("widgets: expected Switch") }
    $item := s.take_basic_switches(id)
    item.set_pending(pending)
    s.basics.switches[id] = item
    s.dirty = true
    << 0
}
