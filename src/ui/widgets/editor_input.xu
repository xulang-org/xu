@ui/widgets

#ui
#ui/draw
#math
#strings

fn (editor &mut Editor) cancel_clipboard() {
    if editor.clipboard.id > 0 && editor.clipboard_operation == 1 { editor.clipboard.cancel() }
    editor.clipboard.id = 0
    editor.clipboard_operation = 0
}
// Clipboard providers can be slow. Keep one operation, and apply mutations only
// to the exact focused session revision that requested them.
fn (editor &mut Editor) clipboard_key(event &ui.InputEvent) int {
    mut primary := ui.MOD_CONTROL
    if ui.target_os() == ui.OS_MACOS { primary = ui.MOD_META }
    if (event.modifiers & primary) == 0 || (event.modifiers & ui.MOD_ALT) != 0 || event.repeat != 0 { << 0 }
    if editor.read_only && event.key == 65 {
        state := editor.read_state() or >>
        editor.select_state(&state,0,state.value.len) or >>
        << 0
    }
    if event.key != 67 && event.key != 86 && event.key != 88 { << 0 }
    // Password data may be pasted, but copy and cut never export its value,
    // including while the user has explicitly revealed the field.
    if editor.is_password() && event.key != 86 { << 0 }
    if editor.read_only && event.key != 67 { << 0 }
    state := editor.read_state() or >>
    if state.composing { << 0 }
    editor.cancel_clipboard()
    options := ui.RequestOptions{timeout_ms: 5000}
    if event.key == 86 {
        editor.clipboard = ui.clipboard_read_async(&editor.identity,&options) or >>
        editor.clipboard_operation = 1
    } else {
        start := int(math.min(f64(state.anchor),f64(state.focus)))
        end := int(math.max(f64(state.anchor),f64(state.focus)))
        if start == end { << 0 }
        selected := state.value[start:end]
        editor.clipboard = ui.clipboard_write_async(&editor.identity,&selected,&options) or >>
        editor.clipboard_operation = 2
        if event.key == 88 { editor.clipboard_operation = 3 }
    }
    editor.clipboard_revision = state.revision
    << 0
}
fn (editor &mut Editor) clipboard_result(event &ui.Event) Action {
    result := ui.request_of(event) or >>
    if editor.clipboard.id == 0 || !result.matches(&editor.clipboard) { << no_action(editor.id,editor.dirty) }
    operation := editor.clipboard_operation
    revision := editor.clipboard_revision
    editor.clipboard.id = 0
    editor.clipboard_operation = 0
    if result.status != ui.REQUEST_COMPLETED || operation == 2 || editor.read_only || !editor.focused || editor.session.id == 0 || !editor.enabled { << no_action(editor.id,editor.dirty) }
    state := editor.read_state() or >>
    if state.composing || state.revision != revision { << no_action(editor.id,editor.dirty) }
    start := int(math.min(f64(state.anchor),f64(state.focus)))
    end := int(math.max(f64(state.anchor),f64(state.focus)))
    mut inserted := ""
    if operation == 1 {
        inserted = strings.replace_all(&result.value,"\r\n","\n")
        inserted = strings.replace_all(&inserted,"\r","\n")
        if !editor.is_multiline() { inserted = strings.replace_all(&inserted,"\n"," ") }
    }
    value := state.value[0:start] + inserted + state.value[end:state.value.len]
    if value.len > 16384 { << no_action(editor.id,editor.dirty) }
    caret := editor.caret_rect()
    // A native edit may win the compare-and-swap while a clipboard completion is
    // delivered; discard that stale result without disrupting subsequent input.
    _ := editor.session.update(revision,&value,start + inserted.len,start + inserted.len,&caret) or (err) { << no_action(editor.id,editor.dirty) }
    _ := editor.read_state() or >>
    editor.reveal_caret = true
    editor.dirty = true
    << Action{kind: ACTION_CHANGE,id: editor.id,needs_paint: true,request_focus: false,consumed: true,value: 0.0}
}
fn (editor &mut Editor) navigate(event &ui.InputEvent) int {
    if editor.layouts.len == 0 || (event.key != ui.KEY_UP && event.key != ui.KEY_DOWN && event.key != ui.KEY_HOME && event.key != ui.KEY_END && !(editor.read_only && (event.key == ui.KEY_LEFT || event.key == ui.KEY_RIGHT))) { << 0 }
    state := editor.read_state() or >>
    if state.composing { << 0 }
    // Re-shape the current snapshot: native edits can arrive ahead of paint.
    options := editor.editor_options()
    mut shaped := editor.layout_value(&state.value,&options) or >>
    caret := shaped.caret(state.focus,false) or >>
    mut x := caret.x
    mut y := caret.y + caret.height * 0.5
    if event.key == ui.KEY_UP { y = caret.y - caret.height * 0.5 }
    if event.key == ui.KEY_DOWN { y = caret.y + caret.height * 1.5 }
    if event.key == ui.KEY_HOME { x = -1048576.0 }
    if event.key == ui.KEY_END { x = 1048576.0 }
    hit := shaped.hit_test(x,y) or >>
    mut index := hit.byte_index()
    if (event.modifiers & (ui.MOD_CONTROL | ui.MOD_META)) != 0 {
        if event.key == ui.KEY_HOME { index = 0 }
        if event.key == ui.KEY_END { index = state.value.len }
    }
    if editor.read_only && (event.key == ui.KEY_LEFT || event.key == ui.KEY_RIGHT) {
        index = state.focus
        if event.key == ui.KEY_LEFT && index > 0 {
            index = index - 1
            while index > 0 && ((state.value[index] & 192) == 128) { index = index - 1 }
            edge := shaped.caret(index,false) or >>
            index = edge.index
        } else if event.key == ui.KEY_RIGHT && index < state.value.len {
            edge := shaped.caret(index,true) or >>
            index = edge.byte_index()
        }
        if state.anchor != state.focus && (event.modifiers & ui.MOD_SHIFT) == 0 {
            if event.key == ui.KEY_LEFT { index = int(math.min(f64(state.anchor),f64(state.focus))) }
            else { index = int(math.max(f64(state.anchor),f64(state.focus))) }
        }
    }
    shaped.dispose() or >>
    mut anchor := index
    if (event.modifiers & ui.MOD_SHIFT) != 0 { anchor = state.anchor }
    editor.select_state(&state,anchor,index) or >>
    editor.reveal_caret = true
    editor.dirty = true
    << 0
}

fn (editor &Editor) hit_current(state &ui.TextInputState,x f64,y f64) draw.TextHit {
    options := editor.editor_options()
    if editor.layouts.len > 0 && editor.shaped_value == state.value && editor.shaped_width == options.width {
        shaped := editor.layouts[0]
        << shaped.hit_test(x,y) or >>
    }
    mut shaped := editor.layout_value(&state.value,&options) or >>
    hit := shaped.hit_test(x,y) or >>
    shaped.dispose() or >>
    << hit
}
