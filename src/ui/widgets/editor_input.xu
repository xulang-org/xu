@ui/widgets

#ui
#ui/draw
#math
#strings

fn (editor $&Editor) cancel_clipboard() {
    if !editor.aux.has(0) { << }
    $aux := editor.take_aux()
    if aux.clipboard.id > 0 && aux.clipboard_operation == 1 { aux.clipboard.cancel() }
    aux.clipboard.id = 0
    aux.clipboard_operation = 0
    editor.put_aux(aux)
}
fn editor_upper_key(key int) int {
    if key >= 97 && key <= 122 { << key - 32 }
    << key
}
fn (editor $&Editor) select_all_text() int {
    if !editor.is_selectable() { << 0 }
    state := editor.read_state() >>>
    if state.composing { << 0 }
    editor.select_state(&state,0,state.value.len) >>>
    << 0
}
fn (editor $&Editor) run_clipboard_op(op int) int {
    if op < 1 || op > 3 { << 0 }
    if op != 1 && (!editor.is_selectable() || !editor.is_copy_enabled()) { << 0 }
    if (op == 1 || op == 3) && editor.read_only { << 0 }
    state := editor.read_state() >>>
    if state.composing { << 0 }
    editor.cancel_clipboard()
    options := ui.RequestOptions{timeout_ms: 5000}
    editor.ensure_aux()
    if op == 1 {
        req := ui.clipboard_read_async(&editor.identity,&options) >>> (err) { << 0 }
    $aux := editor.take_aux()
    aux.clipboard = req
    aux.clipboard_operation = 1
    aux.clipboard_revision = state.revision
    editor.put_aux(aux)
    } else {
        start := int(math.min(f64(state.anchor),f64(state.focus)))
        end := int(math.max(f64(state.anchor),f64(state.focus)))
        if start == end { << 0 }
        selected := state.value[start:end]
        req := ui.clipboard_write_async(&editor.identity,&selected,&options) >>> (err) { << 0 }
    $aux := editor.take_aux()
    aux.clipboard = req
    aux.clipboard_operation = op
    aux.clipboard_revision = state.revision
    editor.put_aux(aux)
    }
    << 0
}
// Clipboard providers can be slow. Keep one operation, and apply mutations only
// to the exact focused session revision that requested them.
fn (editor $&Editor) clipboard_key(event &ui.InputEvent) int {
    $primary := ui.MOD_CONTROL
    if ui.target_os() == ui.OS_MACOS { primary = ui.MOD_META }
    if (event.modifiers & primary) == 0 || (event.modifiers & ui.MOD_ALT) != 0 || event.repeat != 0 { << 0 }
    key := editor_upper_key(event.key)
    if key == 65 {
        editor.select_all_text() >>>
        << 0
    }
    if key == 67 {
        editor.run_clipboard_op(2) >>>
        << 0
    }
    if key == 88 {
        editor.run_clipboard_op(3) >>>
        << 0
    }
    if key == 86 {
        editor.run_clipboard_op(1) >>>
        << 0
    }
    << 0
}
fn (editor $&Editor) clipboard_result(event &ui.Event) Action {
    result := ui.request_of(event) >>>
    if !editor.aux.has(0) || !editor.aux[0].matches_clipboard(&result) { << no_action(editor.id,editor.dirty) }
    $aux := editor.take_aux()
    operation := aux.clipboard_operation
    revision := aux.clipboard_revision
    aux.clipboard.id = 0
    aux.clipboard_operation = 0
    editor.put_aux(aux)
    if result.status != ui.REQUEST_COMPLETED || operation == 2 || editor.read_only || !editor.focused || editor.session.id == 0 || !editor.enabled { << no_action(editor.id,editor.dirty) }
    state := editor.read_state() >>>
    if state.composing || state.revision != revision { << no_action(editor.id,editor.dirty) }
    start := int(math.min(f64(state.anchor),f64(state.focus)))
    end := int(math.max(f64(state.anchor),f64(state.focus)))
    $inserted := ""
    if operation == 1 {
        inserted = strings.replace_all(&result.value,"\r\n","\n")
        inserted = strings.replace_all(&inserted,"\r","\n")
        if !editor.is_multiline() { inserted = strings.replace_all(&inserted,"\n"," ") }
    }
    value := state.value[0:start] + inserted + state.value[end:state.value.len]
    if value.len > 16384 { << no_action(editor.id,editor.dirty) }
    caret := editor.caret_rect()
    // A native edit may win the compare-and-swap while a clipboard completion is
    // delivered; discard that stale result without disrupting subsequent input.
    _ := editor.session.update(revision,&value,start + inserted.len,start + inserted.len,&caret) >>> (err) { << no_action(editor.id,editor.dirty) }
    _ := editor.read_state() >>>
    editor.reveal_caret = true
    editor.dirty = true
    << Action{kind: ACTION_CHANGE,id: editor.id,needs_paint: true,request_focus: false,consumed: true,value: 0.0}
}
fn (editor $&Editor) navigate(event &ui.InputEvent) int {
    if editor.layouts.len == 0 || (event.key != ui.KEY_UP && event.key != ui.KEY_DOWN && event.key != ui.KEY_HOME && event.key != ui.KEY_END && !(editor.read_only && (event.key == ui.KEY_LEFT || event.key == ui.KEY_RIGHT))) { << 0 }
    state := editor.read_state() >>>
    if state.composing { << 0 }
    // Re-shape the current snapshot: native edits can arrive ahead of paint.
    options := editor.editor_options()
    $shaped := editor.layout_value(&state.value,&options) >>>
    caret := shaped.caret(state.focus,false) >>> (err) {
        shaped.dispose() >>> (ignored) { >> err }
        >> err
    }
    $x := caret.x
    $y := caret.y + caret.height * 0.5
    if !editor.is_multiline() {
        if event.key == ui.KEY_UP { x = -1048576.0 }
        if event.key == ui.KEY_DOWN { x = 1048576.0 }
    } else {
        if event.key == ui.KEY_UP { y = caret.y - caret.height * 0.5 }
        if event.key == ui.KEY_DOWN { y = caret.y + caret.height * 1.5 }
    }
    if event.key == ui.KEY_HOME { x = -1048576.0 }
    if event.key == ui.KEY_END { x = 1048576.0 }
    hit := shaped.hit_test(x,y) >>> (err) {
        shaped.dispose() >>> (ignored) { >> err }
        >> err
    }
    $index := hit.byte_index()
    if (event.modifiers & (ui.MOD_CONTROL | ui.MOD_META)) != 0 {
        if event.key == ui.KEY_HOME || (!editor.is_multiline() && event.key == ui.KEY_UP) { index = 0 }
        if event.key == ui.KEY_END || (!editor.is_multiline() && event.key == ui.KEY_DOWN) { index = state.value.len }
    }
    if editor.read_only && (event.key == ui.KEY_LEFT || event.key == ui.KEY_RIGHT) {
        if (event.modifiers & ui.MOD_META) != 0 {
            lr := ui.text_line_range(&state.value,state.focus)
            if event.key == ui.KEY_LEFT { index = lr.start }
            else {
                index = lr.end
                if index > lr.start && (state.value[index - 1] & 255) == 10 { index = index - 1 }
            }
        } else if (event.modifiers & ui.MOD_ALT) != 0 || (ui.target_os() != ui.OS_MACOS && (event.modifiers & ui.MOD_CONTROL) != 0) {
            index = state.focus
            if state.anchor != state.focus && (event.modifiers & ui.MOD_SHIFT) == 0 {
                if event.key == ui.KEY_LEFT { index = int(math.min(f64(state.anchor),f64(state.focus))) }
                else { index = int(math.max(f64(state.anchor),f64(state.focus))) }
            }
            if event.key == ui.KEY_LEFT && index > 0 {
                $pos := index - 1
                while pos > 0 {
                    c := state.value[pos] & 255
                    if c != 32 && c != 9 && c != 10 && c != 13 { <- }
                    pos = pos - 1
                }
                wr := ui.text_word_range(&state.value,pos)
                index = wr.start
            } else if event.key == ui.KEY_RIGHT && index < state.value.len {
                $pos := index
                while pos < state.value.len {
                    c := state.value[pos] & 255
                    if c != 32 && c != 9 && c != 10 && c != 13 { <- }
                    pos = pos + 1
                }
                if pos < state.value.len {
                    wr := ui.text_word_range(&state.value,pos)
                    index = wr.end
                } else { index = state.value.len }
            }
        } else {
            index = state.focus
            if event.key == ui.KEY_LEFT && index > 0 {
                index = index - 1
                while index > 0 && ((state.value[index] & 192) == 128) { index = index - 1 }
                edge := shaped.caret(index,false) >>> (err) {
                    shaped.dispose() >>> (ignored) { >> err }
                    >> err
                }
                index = edge.index
            } else if event.key == ui.KEY_RIGHT && index < state.value.len {
                edge := shaped.caret(index,true) >>> (err) {
                    shaped.dispose() >>> (ignored) { >> err }
                    >> err
                }
                index = edge.byte_index()
            }
            if state.anchor != state.focus && (event.modifiers & ui.MOD_SHIFT) == 0 {
                if event.key == ui.KEY_LEFT { index = int(math.min(f64(state.anchor),f64(state.focus))) }
                else { index = int(math.max(f64(state.anchor),f64(state.focus))) }
            }
        }
    }
    shaped.dispose() >>>
    $anchor := index
    if (event.modifiers & ui.MOD_SHIFT) != 0 && editor.is_selectable() { anchor = state.anchor }
    editor.select_state(&state,anchor,index) >>>
    editor.reveal_caret = true
    editor.dirty = true
    << 0
}

fn (editor &Editor) hit_current(state &ui.TextInputState,x f64,y f64) draw.TextHit {
    options := editor.editor_options()
    if editor.layouts.len > 0 && editor.shaped_value == state.value && editor.shaped_width == options.width {
        shaped := editor.layouts[0]
        << shaped.hit_test(x,y) >>>
    }
    $shaped := editor.layout_value(&state.value,&options) >>>
    hit := shaped.hit_test(x,y) >>> (err) {
        shaped.dispose() >>> (ignored) { >> err }
        >> err
    }
    shaped.dispose() >>>
    << hit
}
