@ui/widgets

#ui/draw
#ui/layout
#math

pub fn (button &Button) measure_icon_styled(label $&StyledLabel,styles &Styles) layout.Size {
    c := button.style_or(styles)
    size := label.measure_styled(styles,&c) or >>
    content := icon_label_size(&size,&c,styles.density,label.value.len > 0)
    << padded_button_size(&content,&c,styles.density)
}
fn padded_button_size(content &layout.Size,c &ControlStyle,density f64) layout.Size {
    << layout.Size{width: math.max(c.min_width * density,content.width + (c.padding.left + c.padding.right) * density),
        height: math.max(c.min_height * density,content.height + (c.padding.top + c.padding.bottom) * density)}
}
fn icon_label_size(size &layout.Size,c &ControlStyle,density f64,has_text bool) layout.Size {
    $width := size.width
    $height := size.height
    icon := c.icon_size * density
    $gap := c.gap * density
    if icon <= 0.0 { gap = 0.0 }
    if !has_text { gap = 0.0
        width = 0.0
        height = 0.0 }
    if c.icon_placement == ICON_LEADING || c.icon_placement == ICON_TRAILING { width = width + icon + gap
        height = math.max(height,icon) }
    else { width = math.max(width,icon)
        height = height + icon + gap }
    << layout.Size{width: width,height: height}
}
// Image ownership stays with the caller. Accepted frames retain its immutable
// native version, following the same resource contract as Frame.image_region.
pub fn (button &Button) paint_icon_styled(frame $&draw.Frame,label $&StyledLabel,image &draw.Image,styles &Styles) int {
    c := button.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    shaped := label.layouts[0]
    << paint_icon_label(frame,&button.bounds,&c,styles,&shaped,label.value.len > 0,image,button.visual_state()) or >>
}

// Share icon/text placement between immediate controls and retained Screen.
fn paint_icon_label(frame $&draw.Frame,bounds &layout.Rect,c &ControlStyle,styles &Styles,shaped &draw.TextLayout,has_text bool,image &draw.Image,state int) int {
    b := bounds
    d := styles.density
    style_box(frame,b,c,d,state) or >>
    $text_width := shaped.metrics.width
    $text_height := shaped.metrics.height
    $gap := c.gap * d
    if !has_text { text_width = 0.0
        text_height = 0.0
        gap = 0.0 }
    side := c.icon_size * d
    if side <= 0.0 { gap = 0.0 }
    text_size := layout.Size{width: text_width,height: text_height}
    content := icon_label_size(&text_size,c,d,has_text)
    width := content.width
    height := content.height
    left := c.padding.left * d
    top := c.padding.top * d
    available_width := math.max(0.0,b.width - left - c.padding.right * d)
    available_height := math.max(0.0,b.height - top - c.padding.bottom * d)
    x := b.x + left + (available_width - width) * c.align_x
    y := b.y + top + (available_height - height) * c.align_y
    $ix := x
    $iy := y + (height - side) * 0.5
    $tx := x + side + gap
    $ty := y + (height - text_height) * 0.5
    if c.icon_placement == ICON_TRAILING { tx = x
        ix = x + text_width + gap }
    if c.icon_placement == ICON_ABOVE { ix = x + (width - side) * 0.5
        iy = y
        tx = x + (width - text_width) * 0.5
        ty = y + side + gap }
    if c.icon_placement == ICON_BELOW { ix = x + (width - side) * 0.5
        iy = y + text_height + gap
        tx = x + (width - text_width) * 0.5
        ty = y }
    frame.push() or >>
    frame.clip_rect(b.x + left,b.y + top,available_width,available_height) or >>
    if side > 0.0 {
        source := draw.ImageRect{x: 0.0,y: 0.0,width: f64(image.width),height: f64(image.height)}
        $iw := side
        $ih := side
        if image.width > image.height { ih = side * f64(image.height) / f64(image.width) }
        else if image.height > image.width { iw = side * f64(image.width) / f64(image.height) }
        destination := draw.ImageRect{x: ix + (side - iw) * 0.5,y: iy + (side - ih) * 0.5,width: iw,height: ih}
        opacity := c.resolve(state).icon_opacity
        frame.image_region(image,&source,&destination,opacity,draw.SAMPLER_LINEAR) or >>
    }
    if has_text { frame.text_layout(shaped,tx,ty,c.resolve(state).foreground) or >> }
    frame.pop() or >>
    << 0
}
