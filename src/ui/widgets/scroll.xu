@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

pub const AXIS_VERTICAL = 0
pub const AXIS_HORIZONTAL = 1
pub struct Scroll {
    id int
    identity ui.CanvasEvent
    bounds layout.Rect
    axis int
    content f64
    offset f64
    enabled bool
    focused bool
    dirty bool
    closed bool
    appearance ControlStyle
    density f64
    styled bool
    bar_hovered bool
    dragging_bar bool
    drag_position f64
    drag_offset f64
    invalid bool
    custom_style string
}
pub fn scroll(identity &ui.CanvasEvent,id int,bounds &layout.Rect,axis int,content_extent f64) Scroll {
    if !valid_identity(identity) || id <= 0 || axis < AXIS_VERTICAL || axis > AXIS_HORIZONTAL ||
       math.is_nan(content_extent) || math.is_inf(content_extent) || content_extent < 0.0 || content_extent > f64(layout.MAX_EXTENT) {
        >> errors.new("widgets: invalid scroll options")
    }
    validate_bounds(bounds) or >>
    styles := dark_styles()
    << Scroll{id: id,identity: copy_identity(identity),bounds: copy_rect(bounds),axis: axis,content: content_extent,offset: 0.0,enabled: true,focused: false,dirty: true,closed: false,appearance: styles.scroll.clone(),density: 1.0,styled: false,bar_hovered: false,dragging_bar: false,drag_position: 0.0,drag_offset: 0.0,invalid: false,custom_style: ""}
}
fn (scroll &Scroll) viewport() f64 {
    if scroll.axis == AXIS_HORIZONTAL { << scroll.bounds.width }
    << scroll.bounds.height
}
pub fn (scroll &Scroll) offset() f64 { << scroll.offset }
pub fn (scroll &Scroll) needs_paint() bool { << scroll.dirty }
pub fn (scroll &mut Scroll) painted() { scroll.dirty = false }
pub fn (scroll &mut Scroll) set_focus(focused bool) {
    next := focused && scroll.enabled && !scroll.closed
    if scroll.focused != next { scroll.dirty = true }
    scroll.focused = next
    if !scroll.focused && (scroll.bar_hovered || scroll.dragging_bar) { scroll.bar_hovered = false
        scroll.dragging_bar = false
        scroll.dirty = true }
}
pub fn (scroll &mut Scroll) set_offset(offset f64) int {
    if math.is_nan(offset) || math.is_inf(offset) || math.abs(offset) > f64(layout.MAX_EXTENT) { >> errors.new("widgets: invalid scroll offset") }
    next := math.max(0.0,math.min(offset,math.max(0.0,scroll.content - scroll.viewport())))
    if next != scroll.offset { scroll.offset = next
        scroll.dirty = true }
    << 0
}
pub fn (scroll &mut Scroll) set_content_extent(extent f64) int {
    if math.is_nan(extent) || math.is_inf(extent) || extent < 0.0 || extent > f64(layout.MAX_EXTENT) { >> errors.new("widgets: invalid content extent") }
    if scroll.content != extent { scroll.content = extent
        scroll.dirty = true }
    scroll.set_offset(scroll.offset) or >>
    << 0
}
pub fn (scroll &mut Scroll) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if scroll.bounds.x != bounds.x || scroll.bounds.y != bounds.y || scroll.bounds.width != bounds.width || scroll.bounds.height != bounds.height {
        scroll.bounds = copy_rect(bounds)
        scroll.dirty = true
        scroll.set_offset(scroll.offset) or >>
    }
    << 0
}
pub fn (scroll &mut Scroll) input(input &ui.InputEvent) Action {
    if scroll.closed || !scroll.enabled || !belongs(&scroll.identity,input) { << no_action(scroll.id,scroll.dirty) }
    if input.kind == ui.EV_POINTER_CANCEL { scroll.set_focus(false)
        << no_action(scroll.id,scroll.dirty) }
    if scroll.styled && input.kind != ui.EV_POINTER_SCROLL {
        action := scroll.bar_input(input) or >>
        if action.consumed { << action }
    }
    mut next := scroll.offset
    mut candidate := false
    if input.kind == ui.EV_POINTER_SCROLL && scroll.bounds.contains(input.x,input.y) {
        mut delta := input.dy
        if scroll.axis == AXIS_HORIZONTAL { delta = input.dx }
        if math.is_nan(delta) || math.is_inf(delta) || math.abs(delta) > f64(layout.MAX_EXTENT) { << no_action(scroll.id,scroll.dirty) }
        next = math.max(0.0,math.min(scroll.offset + delta,math.max(0.0,scroll.content - scroll.viewport())))
        candidate = true
    } else if input.kind == ui.EV_KEY_DOWN && scroll.focused {
        if input.key == ui.KEY_HOME { next = 0.0
            candidate = true }
        else if input.key == ui.KEY_END { next = scroll.content
            candidate = true }
        else if input.key == ui.KEY_PAGE_DOWN { next = math.min(scroll.content,scroll.offset + scroll.viewport())
            candidate = true }
        else if input.key == ui.KEY_PAGE_UP { next = math.max(0.0,scroll.offset - scroll.viewport())
            candidate = true }
        else if (scroll.axis == AXIS_VERTICAL && input.key == ui.KEY_DOWN) || (scroll.axis == AXIS_HORIZONTAL && input.key == ui.KEY_RIGHT) { next = math.min(scroll.content,scroll.offset + 40.0)
            candidate = true }
        else if (scroll.axis == AXIS_VERTICAL && input.key == ui.KEY_UP) || (scroll.axis == AXIS_HORIZONTAL && input.key == ui.KEY_LEFT) { next = math.max(0.0,scroll.offset - 40.0)
            candidate = true }
    }
    if !candidate { << no_action(scroll.id,scroll.dirty) }
    old := scroll.offset
    scroll.set_offset(next) or (err) { << no_action(scroll.id,scroll.dirty) }
    if scroll.offset == old { << no_action(scroll.id,scroll.dirty) }
    << Action{kind: ACTION_SCROLL,id: scroll.id,needs_paint: true,request_focus: false,consumed: true,value: scroll.offset}
}
pub fn (scroll &mut Scroll) event(event &ui.Event) Action {
    if event.window_id != scroll.identity.window_id { << no_action(scroll.id,scroll.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED {
        scroll.set_focus(false)
        if event.kind == ui.EV_CLOSED { scroll.closed = true }
        << no_action(scroll.id,scroll.dirty)
    }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == scroll.identity.canvas_id && identity.generation == scroll.identity.generation { scroll.set_focus(false)
            scroll.closed = true }
        << no_action(scroll.id,scroll.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(scroll.id,scroll.dirty) }
    input := ui.input_of(event) or >>
    << scroll.input(&input)
}
pub fn (scroll &Scroll) visible_items(count int,item_extent f64,gap f64,overscan int) layout.VisibleRange {
    << layout.visible_range(count,item_extent,gap,scroll.viewport(),scroll.offset,overscan) or >>
}
pub fn (scroll &mut Scroll) layout_items(count int,item_extent f64,gap f64,overscan int) layout.VisibleRange {
    range := layout.visible_range(count,item_extent,gap,scroll.viewport(),scroll.offset,overscan) or >>
    scroll.set_content_extent(range.content_extent) or >>
    scroll.set_offset(range.offset) or >>
    << range
}
pub fn (scroll &Scroll) begin(frame &mut draw.Frame) int {
    if scroll.closed { >> errors.new("widgets: scroll owner is closed") }
    frame.push() or >>
    frame.clip_rect(scroll.bounds.x,scroll.bounds.y,scroll.bounds.width,scroll.bounds.height) or >>
    mut x := scroll.bounds.x
    mut y := scroll.bounds.y
    if scroll.axis == AXIS_VERTICAL { y = y - scroll.offset }
    else { x = x - scroll.offset }
    frame.translate(x,y) or >>
    << 0
}
pub fn (scroll &Scroll) end(frame &mut draw.Frame) int { << frame.pop() or >> }

pub struct FocusGroup {
    identity ui.CanvasEvent
    ids []int
    current int
    closed bool
}
pub fn focus_group(identity &ui.CanvasEvent,ids []int) FocusGroup {
    if !valid_identity(identity) || ids.len > 512 { >> errors.new("widgets: invalid focus group") }
    for i in 0:ids.len {
        if ids[i] <= 0 { >> errors.new("widgets: invalid focus id") }
        for j in 0:i { if ids[i] == ids[j] { >> errors.new("widgets: duplicate focus id") } }
    }
    << FocusGroup{identity: copy_identity(identity),ids: ids,current: 0,closed: false}
}
pub fn (focus &FocusGroup) current() int { << focus.current }
pub fn (focus &mut FocusGroup) clear() { focus.current = 0 }
pub fn (focus &mut FocusGroup) focus(id int) int {
    if focus.closed { >> errors.new("widgets: focus owner is closed") }
    if id == 0 { focus.current = 0
        << 0 }
    for candidate in focus.ids { if candidate == id { focus.current = id
        << 0 } }
    >> errors.new("widgets: focus id is not registered")
}
// The owner registers only enabled, visible controls and applies the resulting
// identity to their set_focus methods. This preserves state across repaint/layout.
pub fn (focus &mut FocusGroup) input(input &ui.InputEvent) Action {
    if focus.closed || !belongs(&focus.identity,input) { << no_action(focus.current,false) }
    if input.kind == ui.EV_POINTER_CANCEL {
        changed := focus.current != 0
        focus.current = 0
        << Action{kind: ACTION_NONE,id: 0,needs_paint: changed,request_focus: changed,consumed: false,value: 0.0}
    }
    if input.kind != ui.EV_KEY_DOWN || input.key != ui.KEY_TAB || focus.ids.len == 0 { << no_action(focus.current,false) }
    mut index := 0 - 1
    for i in 0:focus.ids.len { if focus.ids[i] == focus.current { index = i } }
    if (input.modifiers & ui.MOD_SHIFT) != 0 {
        if index <= 0 { index = focus.ids.len - 1 }
        else { index = index - 1 }
    } else {
        index = index + 1
        if index >= focus.ids.len { index = 0 }
    }
    focus.current = focus.ids[index]
    << Action{kind: ACTION_NONE,id: focus.current,needs_paint: true,request_focus: true,consumed: true,value: 0.0}
}

pub fn (focus &mut FocusGroup) set_items(ids []int) int {
    if focus.closed || ids.len > 512 { >> errors.new("widgets: invalid focus update") }
    mut found := false
    for i in 0:ids.len {
        if ids[i] <= 0 { >> errors.new("widgets: invalid focus id") }
        for j in 0:i { if ids[i] == ids[j] { >> errors.new("widgets: duplicate focus id") } }
        if ids[i] == focus.current { found = true }
    }
    focus.ids = ids
    if !found { focus.current = 0 }
    << 0
}
pub fn (focus &mut FocusGroup) event(event &ui.Event) Action {
    if focus.closed || event.window_id != focus.identity.window_id { << no_action(focus.current,false) }
    mut clear := event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == focus.identity.canvas_id && identity.generation == focus.identity.generation { clear = true
            focus.closed = true }
    }
    if event.kind == ui.EV_CLOSED { focus.closed = true }
    if clear {
        changed := focus.current != 0
        focus.current = 0
        << Action{kind: ACTION_NONE,id: 0,needs_paint: changed,request_focus: changed,consumed: false,value: 0.0}
    }
    if !ui.is_input_event(event.kind) { << no_action(focus.current,false) }
    input := ui.input_of(event) or >>
    << focus.input(&input)
}

pub fn (scroll &Scroll) is_enabled() bool { << scroll.enabled && !scroll.closed }
pub fn (scroll &mut Scroll) set_enabled(enabled bool) {
    if scroll.enabled != enabled { scroll.enabled = enabled
        scroll.dirty = true }
    if !enabled { scroll.set_focus(false) }
}
