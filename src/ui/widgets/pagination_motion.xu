@ui/widgets
#ui/draw
#errors
#time

fn (p &Pagination) slot_state(i int) int {
    page := p.slot_page(i)
    $state := p.control.visual_state() & (0 - 1 - STATE_HOVERED - STATE_PRESSED - STATE_FOCUSED)
    if page < 0 || page >= p.pages { << state | STATE_DISABLED }
    if i == p.hot { state = state | STATE_HOVERED }
    if i == p.armed && i == p.hot && !p.control.read_only { state = state | STATE_PRESSED }
    if i > 0 && i < p.slot_count() - 1 && page == p.current {
        state = state | STATE_SELECTED
        if p.control.focused { state = state | STATE_FOCUSED }
    }
    << state
}
fn (p $&Pagination) ensure_hover_motions() int {
    count := p.slot_count()
    if p.hover_motions.len >= count { << 0 }
    for i in p.hover_motions.len:count {
        $motion := paint_transition()
        motion.set_spec(&p.motion) or >>
        p.hover_motions.push(motion) }
    << 0
}
pub fn (p $&Pagination) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    p.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    for i in 0:p.hover_motions.len { $motion := p.hover_motions[i]
        motion.set_spec(spec) or >>
        p.hover_motions[i] = motion }
    emphasis := $&p.emphasis
    emphasis.set_curve(spec.curve) or >>
    << 0
}
pub fn (p $&Pagination) tick(styles &Styles,now time.Instant,reduced bool) bool {
    p.now = now
    p.reduced = reduced
    p.apply_styles(styles) or >>
    p.ensure_hover_motions() or >>
    if p.observed_page != p.current {
        p.observed_page = p.current
        duration := p.motion.change
        emphasis := $&p.emphasis
        emphasis.snap(0.0) or >>
        emphasis.retarget(1.0,now,duration,reduced) or >> }
    c := p.style_or(styles)
    $changed := false
    for i in 0:p.slot_count() { state := p.slot_state(i)
        $motion := p.hover_motions[i]
        before := motion.progress.value()
        _ := motion.style(&c,state,now,reduced) or >>
        if before != motion.progress.value() || motion.is_animating() { changed = true }
        p.hover_motions[i] = motion }
    emphasis := $&p.emphasis
    if reduced { emphasis.snap(1.0) or >> }
    if emphasis.advance(now) or >> { changed = true }
    if changed { p.control.dirty = true }
    << changed
}
pub fn (p &Pagination) next_tick(now time.Instant) time.Instant {
    if p.control.closed { << time.zero_instant() }
    $active := p.emphasis.is_animating()
    for i in 0:p.slot_count() { if i < p.hover_motions.len && p.hover_motions[i].is_animating() { active = true } }
    << overlay_next_tick(active,now) or >>
}
fn (s $&Screen) tick_pagination(id int,now time.Instant,reduced bool) ScreenAnimation {
    styles := s.styles.clone()
    $item := s.take_pagination(id) or >>
    result := pagination_tick_result($&item,&styles,now,reduced)
    s.controls.pages[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    << ScreenAnimation{changed: result.changed,deadline: result.deadline}
}
fn pagination_tick_result(item $&Pagination,styles &Styles,now time.Instant,reduced bool) RefinedResult {
    $result := refined_result()
    result.changed = item.tick(styles,now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}
fn screen_set_motion_pages(item $&Pagination,spec &MotionSpec) string { item.set_motion(spec) or (err) { << err.msg() }
    << "" }
