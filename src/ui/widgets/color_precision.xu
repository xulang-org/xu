@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

fn hex_digit(value int) int {
    if value>=48 && value<=57 { << value-48 }
    if value>=65 && value<=70 { << value-55 }
    if value>=97 && value<=102 { << value-87 }
    >> errors.new("widgets: invalid HEX color")
}
pub fn (picker &ColorPicker) hex() string {
    digits := "0123456789ABCDEF"
    $bytes := [35]
    for i in 0:4 { value := color_channel(picker.value(),i)
        bytes.push(digits[value/16]&255)
        bytes.push(digits[value%16]&255) }
    << string_from_bytes(bytes)
}
pub fn (picker $&ColorPicker) set_hex(text &string) int {
    if text.len<1 || text[0]!=35 { >> errors.new("widgets: HEX color must begin with #") }
    count := text.len-1
    if count!=3 && count!=4 && count!=6 && count!=8 { >> errors.new("widgets: expected #RGB, #RGBA, #RRGGBB or #RRGGBBAA") }
    $channels := [0,0,0,255]
    $stride := 1
    if count>=6 { stride=2 }
    for i in 0:count/stride {
        high := hex_digit(text[1+i*stride]&255) or >>
        $low := high
        if stride==2 { low=hex_digit(text[2+i*stride]&255) or >> }
        channels[i]=high*16+low
    }
    value := draw.rgba(channels[0],channels[1],channels[2],channels[3])
    << picker.set_value(value) or >>
}
pub fn (picker $&ColorPicker) set_swatches(colors &[]draw.Color) int {
    if colors.len>8 { >> errors.new("widgets: at most eight palette colors") }
    $values := []draw.Color{}
    for color in colors { values.push(color) }
    picker.palette=values
    picker.show_swatches=true
    picker.swatch_armed=-1
    picker.control.dirty=true
    << 0
}
pub fn (picker $&ColorPicker) remember() {
    value := picker.value()
    $colors := []draw.Color{}
    colors.push(value)
    for color in picker.recent { if color.value()!=value.value() && colors.len<8 { colors.push(color) } }
    picker.recent=colors
    picker.control.dirty=true
}
pub fn (picker &ColorPicker) recent_colors() []draw.Color {
    $colors := []draw.Color{}
    for color in picker.recent { colors.push(color) }
    << colors
}
fn (picker &ColorPicker) swatch_colors() []draw.Color {
    if !picker.show_swatches { << []draw.Color{} }
    $colors := []draw.Color{}
    for color in picker.palette { colors.push(color) }
    for color in picker.recent {
        $duplicate := false
        for existing in colors { if existing.value()==color.value() { duplicate=true } }
        if !duplicate { colors.push(color) }
    }
    << colors
}
fn (picker &ColorPicker) swatch_height() f64 {
    if !picker.show_swatches || (picker.palette.len==0 && picker.recent.len==0) { << 0.0 }
    << picker.row_h+picker.pad
}
pub fn (picker &ColorPicker) swatch_bounds(index int) layout.Rect {
    colors := picker.swatch_colors()
    if index<0 || index>=colors.len { >> errors.new("widgets: invalid color swatch") }
    b := picker.bounds()
    available := math.max(0.0,b.width-picker.pad*2.0)
    width := math.min(32.0,available/f64(max_int(1,colors.len)))
    y := b.y+picker.pad*2.0+picker.preview_h+picker.row_h*4.0
    << layout.Rect{x:b.x+picker.pad+f64(index)*width,y:y,width:width,height:math.min(picker.row_h,math.max(0.0,b.y+b.height-y-picker.pad))}
}
fn (picker $&ColorPicker) swatch_input(event &ui.InputEvent) Action {
    if picker.control.read_only { << no_action(picker.id(),false) }
    colors := picker.swatch_colors()
    $hit := -1
    for i in 0:colors.len { b := picker.swatch_bounds(i) or >>
        if b.contains(event.x,event.y) { hit=i } }
    $choose := -1
    if event.kind==ui.EV_POINTER_DOWN && event.button==ui.BUTTON_LEFT && hit>=0 { picker.swatch_armed=hit
        << Action{kind:ACTION_NONE,id:picker.id(),needs_paint:true,request_focus:true,consumed:true,value:0.0} }
    if event.kind==ui.EV_POINTER_UP && event.button==ui.BUTTON_LEFT && picker.swatch_armed>=0 {
        if hit==picker.swatch_armed { choose=hit }
        picker.swatch_armed=-1
    }
    if event.kind==ui.EV_KEY_DOWN && picker.control.focused && (event.modifiers&ui.MOD_ALT)!=0 && event.key>=49 && event.key<=56 { choose=event.key-49 }
    if choose>=0 && choose<colors.len { picker.set_value(colors[choose]) or >>
        << Action{kind:ACTION_CHANGE,id:picker.id(),needs_paint:true,request_focus:true,consumed:true,value:f64(picker.value().value())} }
    << no_action(picker.id(),false)
}
fn (picker &ColorPicker) paint_swatches(frame $&draw.Frame,styles &Styles,c &ControlStyle) int {
    colors := picker.swatch_colors()
    for i in 0:colors.len { b := picker.swatch_bounds(i) or >>
        inset := 3.0*styles.density
        square := layout.Rect{x:b.x+inset,y:b.y+inset,width:math.max(0.0,b.width-inset*2.0),height:math.max(0.0,b.height-inset*2.0)}
        rounded_fill(frame,&square,3.0*styles.density,colors[i]) or >>
        if colors[i].value()==picker.value().value() { rounded_stroke(frame,&square,3.0*styles.density,c.palette.foreground,2.0) or >> }
    }
    << 0
}

pub fn (picker $&ColorPicker) set_show_swatches(visible bool) { picker.show_swatches=visible
    picker.control.dirty=true }
