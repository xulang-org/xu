@ui/widgets
#errors

pub fn (s $&Screen) set_invalid(id int,invalid bool) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_RANGE_SLIDER || node.kind == SCREEN_SPLIT_VIEW || node.kind == SCREEN_MENU { << s.interaction_invalid(id,invalid) or >> }
    if s.basics.scrolls.has(id) { $value := 0.0
        if invalid { value = 1.0 }
        s.scroll_update(id,6,&screen_empty(),value) or >>
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BUTTON { items := $&s.buttons
        $item := items.take(id)
        screen_invalid_buttons($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CHECKBOX { owner := $&s.basics
        items := $&owner.checks
        $item := items.take(id)
        screen_invalid_checks($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SWITCH { owner := $&s.basics
        items := $&owner.switches
        $item := items.take(id)
        screen_invalid_switches($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_RADIO { owner := $&s.basics
        items := $&owner.radios
        $item := items.take(id)
        screen_invalid_radios($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SLIDER { owner := $&s.basics
        items := $&owner.sliders
        $item := items.take(id)
        screen_invalid_sliders($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_STEPPER { owner := $&s.basics
        items := $&owner.steppers
        $item := items.take(id)
        screen_invalid_steppers($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TABS { owner := $&s.basics
        items := $&owner.tabs
        $item := items.take(id)
        screen_invalid_tabs($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SELECT { owner := $&s.basics
        items := $&owner.selects
        $item := items.take(id)
        screen_invalid_selects($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_LIST { owner := $&s.basics
        items := $&owner.lists
        $item := items.take(id)
        screen_invalid_lists($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_PROGRESS { owner := $&s.basics
        items := $&owner.progresses
        $item := items.take(id)
        screen_invalid_progresses($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DIVIDER { owner := $&s.basics
        items := $&owner.dividers
        $item := items.take(id)
        screen_invalid_dividers($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BADGE { owner := $&s.basics
        items := $&owner.badges
        $item := items.take(id)
        screen_invalid_badges($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CARD { owner := $&s.basics
        items := $&owner.cards
        $item := items.take(id)
        screen_invalid_cards($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COMBO { owner := $&s.controls
        items := $&owner.combos
        $item := items.take(id)
        screen_invalid_combos($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_MULTI { owner := $&s.controls
        items := $&owner.multis
        $item := items.take(id)
        screen_invalid_multis($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COLOR { owner := $&s.controls
        items := $&owner.colors
        $item := items.take(id)
        screen_invalid_colors($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DATE { owner := $&s.controls
        items := $&owner.dates
        $item := items.take(id)
        screen_invalid_dates($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CLOCK { owner := $&s.controls
        items := $&owner.clocks
        $item := items.take(id)
        screen_invalid_clocks($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_EDITOR { owner := $&s.controls
        items := $&owner.editors
        $item := items.take(id)
        screen_invalid_editors($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_FIELD { owner := $&s.controls
        items := $&owner.fields
        $item := items.take(id)
        screen_invalid_fields($&item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    >> errors.new("widgets: invalid state is not applicable to this control")
}
fn screen_invalid_buttons(item $&Button,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_checks(item $&Checkbox,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_switches(item $&Switch,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_radios(item $&Radio,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_sliders(item $&Slider,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_steppers(item $&Stepper,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_tabs(item $&Tabs,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_selects(item $&Select,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_lists(item $&ListBox,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_progresses(item $&Progress,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_dividers(item $&Divider,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_badges(item $&Badge,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_cards(item $&Card,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_combos(item $&ComboBox,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_multis(item $&MultiSelect,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_colors(item $&ColorPicker,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_dates(item $&DatePicker,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_clocks(item $&TimePicker,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_editors(item $&Editor,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_fields(item $&Field,invalid bool) { item.set_invalid(invalid) }
