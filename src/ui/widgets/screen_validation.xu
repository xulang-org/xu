@ui/widgets
#errors

pub fn (s &mut Screen) set_invalid(id int,invalid bool) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_RANGE_SLIDER || node.kind == SCREEN_SPLIT_VIEW || node.kind == SCREEN_MENU { << s.interaction_invalid(id,invalid) or >> }
    if s.basics.scrolls.has(id) { mut value := 0.0
        if invalid { value = 1.0 }
        s.scroll_update(id,6,&screen_empty(),value) or >>
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BUTTON { items := mut &s.buttons
        mut item := items.take(id)
        screen_invalid_buttons(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CHECKBOX { owner := mut &s.basics
        items := mut &owner.checks
        mut item := items.take(id)
        screen_invalid_checks(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SWITCH { owner := mut &s.basics
        items := mut &owner.switches
        mut item := items.take(id)
        screen_invalid_switches(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_RADIO { owner := mut &s.basics
        items := mut &owner.radios
        mut item := items.take(id)
        screen_invalid_radios(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SLIDER { owner := mut &s.basics
        items := mut &owner.sliders
        mut item := items.take(id)
        screen_invalid_sliders(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_STEPPER { owner := mut &s.basics
        items := mut &owner.steppers
        mut item := items.take(id)
        screen_invalid_steppers(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TABS { owner := mut &s.basics
        items := mut &owner.tabs
        mut item := items.take(id)
        screen_invalid_tabs(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SELECT { owner := mut &s.basics
        items := mut &owner.selects
        mut item := items.take(id)
        screen_invalid_selects(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_LIST { owner := mut &s.basics
        items := mut &owner.lists
        mut item := items.take(id)
        screen_invalid_lists(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_PROGRESS { owner := mut &s.basics
        items := mut &owner.progresses
        mut item := items.take(id)
        screen_invalid_progresses(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DIVIDER { owner := mut &s.basics
        items := mut &owner.dividers
        mut item := items.take(id)
        screen_invalid_dividers(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BADGE { owner := mut &s.basics
        items := mut &owner.badges
        mut item := items.take(id)
        screen_invalid_badges(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CARD { owner := mut &s.basics
        items := mut &owner.cards
        mut item := items.take(id)
        screen_invalid_cards(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COMBO { owner := mut &s.controls
        items := mut &owner.combos
        mut item := items.take(id)
        screen_invalid_combos(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_MULTI { owner := mut &s.controls
        items := mut &owner.multis
        mut item := items.take(id)
        screen_invalid_multis(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COLOR { owner := mut &s.controls
        items := mut &owner.colors
        mut item := items.take(id)
        screen_invalid_colors(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DATE { owner := mut &s.controls
        items := mut &owner.dates
        mut item := items.take(id)
        screen_invalid_dates(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CLOCK { owner := mut &s.controls
        items := mut &owner.clocks
        mut item := items.take(id)
        screen_invalid_clocks(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_EDITOR { owner := mut &s.controls
        items := mut &owner.editors
        mut item := items.take(id)
        screen_invalid_editors(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_FIELD { owner := mut &s.controls
        items := mut &owner.fields
        mut item := items.take(id)
        screen_invalid_fields(mut &item,invalid)
        items[id] = item
        s.dirty = true
        << 0 }
    >> errors.new("widgets: invalid state is not applicable to this control")
}
fn screen_invalid_buttons(item &mut Button,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_checks(item &mut Checkbox,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_switches(item &mut Switch,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_radios(item &mut Radio,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_sliders(item &mut Slider,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_steppers(item &mut Stepper,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_tabs(item &mut Tabs,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_selects(item &mut Select,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_lists(item &mut ListBox,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_progresses(item &mut Progress,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_dividers(item &mut Divider,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_badges(item &mut Badge,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_cards(item &mut Card,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_combos(item &mut ComboBox,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_multis(item &mut MultiSelect,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_colors(item &mut ColorPicker,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_dates(item &mut DatePicker,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_clocks(item &mut TimePicker,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_editors(item &mut Editor,invalid bool) { item.set_invalid(invalid) }
fn screen_invalid_fields(item &mut Field,invalid bool) { item.set_invalid(invalid) }
