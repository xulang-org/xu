@ui/widgets

#errors

pub const ARIA_FIELD_ROLE = 1
pub const ARIA_FIELD_LABEL = 2
pub const ARIA_FIELD_DESCRIPTION = 4
pub const ARIA_FIELD_LIVE = 8
pub const ARIA_FIELD_EXPANDED = 16
pub const ARIA_FIELD_SELECTED = 32
pub const ARIA_FIELD_CHECKED = 64
pub const ARIA_FIELD_BUSY = 128

pub struct AriaOverride {
    pub fields int
    pub role int
    pub label string
    pub description string
    pub live int
    pub expanded bool
    pub selected bool
    pub checked bool
    pub busy bool
}

pub struct AriaAnnouncement {
    pub message string
    pub live int
}

pub fn aria_override() AriaOverride {
    << AriaOverride{
        fields: 0,
        role: ROLE_NONE,
        label: "",
        description: "",
        live: LIVE_OFF,
        expanded: false,
        selected: false,
        checked: false,
        busy: false
    }
}

pub fn (o &AriaOverride) validate() int {
    if o.fields < 0 || o.fields > 255 { >> errors.new("widgets: invalid aria override field mask") }
    if (o.fields & ARIA_FIELD_ROLE) != 0 && (o.role < ROLE_NONE || o.role > ROLE_TOAST) {
        >> errors.new("widgets: invalid aria role override")
    }
    if (o.fields & ARIA_FIELD_LIVE) != 0 && (o.live < LIVE_OFF || o.live > LIVE_ASSERTIVE) {
        >> errors.new("widgets: invalid aria live region mode")
    }
    << 0
}

fn copy_aria_override(o &AriaOverride) AriaOverride {
    << AriaOverride{
        fields: o.fields,
        role: o.role,
        label: o.label + "",
        description: o.description + "",
        live: o.live,
        expanded: o.expanded,
        selected: o.selected,
        checked: o.checked,
        busy: o.busy
    }
}

fn copy_aria_announcement(a &AriaAnnouncement) AriaAnnouncement {
    << AriaAnnouncement{message: a.message + "",live: a.live}
}

pub fn (s $&Screen) set_aria_override(id int,ov &AriaOverride) int {
    _ := s.node(id) >>>
    ov.validate() >>>
    if ov.fields == 0 { << s.clear_aria_override(id) >>> }
    comp := $&s.composition
    ao := $&comp.aria_overrides
    had := ao.has(id)
    ao[id] = copy_aria_override(ov)
    if !had { comp.aria_override_count = comp.aria_override_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_aria_override(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.aria_overrides.has(id) {
        ao := $&comp.aria_overrides
        ao.delete(id)
        if comp.aria_override_count > 0 { comp.aria_override_count = comp.aria_override_count - 1 }
    }
    << 0
}

pub fn (s &Screen) aria_override_of(id int) AriaOverride {
    _ := s.node(id) >>>
    if s.composition.aria_override_count > 0 && s.composition.aria_overrides.has(id) {
        << copy_aria_override(&s.composition.aria_overrides[id])
    }
    << aria_override()
}

fn (s $&Screen) ensure_aria_override_copy(id int) AriaOverride {
    if s.composition.aria_overrides.has(id) {
        << copy_aria_override(&s.composition.aria_overrides[id])
    }
    << aria_override()
}

pub fn (s $&Screen) set_aria_role(id int,role int) int {
    _ := s.node(id) >>>
    $ov := s.ensure_aria_override_copy(id)
    ov.fields = ov.fields | ARIA_FIELD_ROLE
    ov.role = role
    << s.set_aria_override(id,&ov) >>>
}

pub fn (s $&Screen) set_aria_label(id int,label string) int {
    _ := s.node(id) >>>
    $ov := s.ensure_aria_override_copy(id)
    ov.fields = ov.fields | ARIA_FIELD_LABEL
    ov.label = label + ""
    << s.set_aria_override(id,&ov) >>>
}

pub fn (s $&Screen) set_aria_expanded(id int,expanded bool) int {
    _ := s.node(id) >>>
    $ov := s.ensure_aria_override_copy(id)
    ov.fields = ov.fields | ARIA_FIELD_EXPANDED
    ov.expanded = expanded
    << s.set_aria_override(id,&ov) >>>
}

pub fn (s $&Screen) set_aria_selected(id int,selected bool) int {
    _ := s.node(id) >>>
    $ov := s.ensure_aria_override_copy(id)
    ov.fields = ov.fields | ARIA_FIELD_SELECTED
    ov.selected = selected
    << s.set_aria_override(id,&ov) >>>
}

pub fn (s $&Screen) set_aria_live(id int,live int) int {
    _ := s.node(id) >>>
    $ov := s.ensure_aria_override_copy(id)
    ov.fields = ov.fields | ARIA_FIELD_LIVE
    ov.live = live
    << s.set_aria_override(id,&ov) >>>
}

pub fn (s $&Screen) announce(message string,live int) int {
    s.check_screen() >>>
    if live < LIVE_OFF || live > LIVE_ASSERTIVE { >> errors.new("widgets: invalid live region mode") }
    if message.len == 0 { << 0 }
    comp := $&s.composition
    list := $&comp.aria_announcements
    if list.len >= 64 {
        $trimmed := []AriaAnnouncement{}
        for i in 1:list.len { trimmed.push(copy_aria_announcement(&list[i])) }
        comp.aria_announcements = trimmed
        list2 := $&comp.aria_announcements
        list2.push(AriaAnnouncement{message: message + "",live: live})
    } else {
        list.push(AriaAnnouncement{message: message + "",live: live})
    }
    << 0
}

pub fn (s $&Screen) take_announcements() []AriaAnnouncement {
    $out := []AriaAnnouncement{}
    for i in 0:s.composition.aria_announcements.len {
        out.push(copy_aria_announcement(&s.composition.aria_announcements[i]))
    }
    comp := $&s.composition
    comp.aria_announcements = []AriaAnnouncement{}
    << out
}

pub fn (s &Screen) pending_announcement_count() int {
    << s.composition.aria_announcements.len
}

fn (s $&Screen) cleanup_aria_for(id int) {
    comp := $&s.composition
    if comp.aria_overrides.has(id) {
        ao := $&comp.aria_overrides
        ao.delete(id)
        if comp.aria_override_count > 0 { comp.aria_override_count = comp.aria_override_count - 1 }
    }
}
