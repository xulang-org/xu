@ui/widgets
#errors

pub fn (s &mut Screen) set_field_text_options(id int,options &FieldTextOptions) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_FIELD { >> errors.new("widgets: expected Field") }
    controls := mut &s.controls
    items := mut &controls.fields
    mut item := items.take(id)
    message := screen_field_text_options(mut &item,options)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_field_text_options(item &mut Field,options &FieldTextOptions) string {
    item.set_text_options(options) or (err) { << err.msg() }
    << ""
}
pub fn (s &mut Screen) set_slider_appearance(id int,appearance &SliderAppearance,step f64) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_SLIDER { >> errors.new("widgets: expected Slider") }
    mut item := s.take_basic_sliders(id)
    message := screen_slider_appearance(mut &item,appearance,step)
    s.basics.sliders[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_slider_appearance(item &mut Slider,appearance &SliderAppearance,step f64) string {
    appearance.validate() or (err) { << err.msg() }
    item.set_step(step) or (err) { << err.msg() }
    item.set_appearance(appearance) or (err) { << err.msg() }
    << ""
}
pub fn (s &mut Screen) set_list_appearance(id int,appearance &ListAppearance) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_LIST { >> errors.new("widgets: expected ListBox") }
    mut item := s.take_basic_lists(id)
    message := screen_list_appearance(mut &item,appearance)
    s.basics.lists[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_list_appearance(item &mut ListBox,appearance &ListAppearance) string {
    item.set_appearance(appearance) or (err) { << err.msg() }
    << ""
}
