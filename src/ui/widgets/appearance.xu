@ui/widgets

#ui/draw
#ui/layout
#errors

pub const BUTTON_PRIMARY = 0
pub const BUTTON_SECONDARY = 1
pub const BUTTON_OUTLINE = 2
pub const BUTTON_GHOST = 3
pub const BUTTON_DANGER = 4
pub const BUTTON_SUBTLE = 5

// Appearance helpers return independent values. They preserve the existing
// Styles/ControlStyle wire format and all three levels of theme inheritance.
pub fn (styles &Styles) button_variant(variant int) ControlStyle {
    if variant < BUTTON_PRIMARY || variant > BUTTON_SUBTLE { >> errors.new("widgets: invalid button variant") }
    $c := styles.button.clone()
    if variant == BUTTON_PRIMARY || variant == BUTTON_DANGER {
        $ink := c.palette.accent
        if variant == BUTTON_DANGER { ink = c.palette.invalid }
        c.palette.normal = ink
        c.palette.hovered = mix_color(ink,c.palette.foreground,0.12)
        c.palette.pressed = mix_color(ink,styles.background,0.18)
        c.palette.foreground = c.palette.on_accent
        c.palette.border = ink
        $read_only := state_paint(STATE_READ_ONLY)
        read_only.unless = STATE_DISABLED | STATE_INVALID
        read_only.fields = PAINT_FOREGROUND
        read_only.foreground = styles.button.palette.foreground
        c.states = [read_only]
    } else if variant == BUTTON_OUTLINE || variant == BUTTON_GHOST {
        c.palette.normal = draw.rgba(0,0,0,0)
        if variant == BUTTON_GHOST { c.border_width = 0.0 }
    } else if variant == BUTTON_SUBTLE {
        c.border_width = 0.0
        c.palette.normal = mix_color(styles.background,c.palette.accent,0.08)
        c.palette.hovered = mix_color(styles.background,c.palette.accent,0.14)
    }
    << c
}
pub fn (styles &Styles) tree_style() ControlStyle {
    $c := styles.list_box_style()
    c.border_width = 0.0
    c.palette.normal = styles.background
    c.padding = layout.Insets{left: 4.0,top: 4.0,right: 4.0,bottom: 4.0}
    c.indicator_size = 32.0
    c.align_x = 0.0
    c.align_y = 0.5
    c.radius = 6.0
    c.states = []StatePaint{}
    $selected := state_paint(STATE_SELECTED)
    selected.unless = STATE_DISABLED
    selected.fields = PAINT_BACKGROUND | PAINT_FOREGROUND
    selected.background = mix_color(styles.background,c.palette.accent,0.14)
    selected.foreground = c.palette.foreground
    // A high-contrast palette already supplies a contrasting selection pair.
    if c.palette.accent.value() == c.palette.focus.value() && c.palette.border.value() == c.palette.foreground.value() {
        selected.background = c.palette.accent
        selected.foreground = c.palette.on_accent
    }
    c.states = [selected]
    << c
}
pub fn (styles &Styles) table_style() ControlStyle {
    $c := styles.tree_style()
    c.border_width = styles.input.border_width
    c.padding = layout.Insets{left: 8.0,top: 6.0,right: 8.0,bottom: 6.0}
    c.indicator_size = 36.0
    << c
}
pub fn (styles &Styles) overlay_style() ControlStyle {
    $c := styles.input.clone()
    c.padding = layout.Insets{left: 12.0,top: 10.0,right: 12.0,bottom: 10.0}
    c.palette.normal = styles.input.palette.normal
    c.radius = 8.0
    c.shadow = draw.rgba(0,0,0,40)
    c.shadow_y = 4.0
    c.shadow_blur = 12.0
    c.align_x = 0.0
    << c
}

pub const TREE_ICON_NONE = 0
pub const TREE_ICON_AUTO = 1
pub const TREE_ICON_FOLDER = 2
pub const TREE_ICON_FILE = 3

pub struct TreeAppearance {
    pub indent f64
    pub row_height f64
    pub guides bool
    pub icons bool
    pub selection_mark bool
    pub guide_opacity f64
    pub action_width f64
}
pub fn tree_appearance() TreeAppearance {
    << TreeAppearance{indent: 20.0,row_height: 32.0,guides: false,icons: true,
        selection_mark: true,guide_opacity: 0.4,action_width: 28.0}
}
pub fn (a &TreeAppearance) validate() int {
    if !finite_metric(a.indent,128.0) || a.indent < 16.0 || !finite_metric(a.row_height,256.0) || a.row_height < 24.0 ||
        !finite_metric(a.guide_opacity,1.0) || !finite_metric(a.action_width,128.0) || a.action_width < 24.0 {
        >> errors.new("widgets: invalid tree appearance")
    }
    << 0
}

pub const BADGE_NEUTRAL = 0
pub const BADGE_INFO = 1
pub const BADGE_SUCCESS = 2
pub const BADGE_WARNING = 3
pub const BADGE_ERROR = 4
pub fn (styles &Styles) badge_variant(tone int) ControlStyle {
    $c := styles.badge_style()
    $color := c.palette.muted
    if tone==BADGE_INFO { color=draw.rgb(40,111,174) }
    else if tone==BADGE_SUCCESS { color=draw.rgb(40,133,86) }
    else if tone==BADGE_WARNING { color=draw.rgb(156,111,25) }
    else if tone==BADGE_ERROR { color=c.palette.invalid }
    // Keep the explicit high-contrast pair rather than introducing tonal fills.
    if c.palette.accent.value()==c.palette.focus.value() && c.palette.border.value()==c.palette.foreground.value() { << c }
    c.palette.accent=color
    c.palette.normal=mix_color(styles.background,color,0.12)
    c.palette.foreground=mix_color(c.palette.foreground,color,0.45)
    c.palette.border=fade_color(color,0.20)
    c.states=[]StatePaint{}
    << c
}
