@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors

pub const MENU_DROPDOWN = 0
pub const MENU_CONTEXT = 1
pub const MENU_SPLIT = 2
pub const MENU_ACTION = 0
pub const MENU_CHECK = 1
pub const MENU_RADIO = 2
pub const MENU_SEPARATOR = 3
pub const MENU_HEADING = 4
pub const MENU_SUBMENU = 5
pub struct MenuItem {
    pub key int
    pub parent int
    pub label string
    pub shortcut_label string
    pub shortcut_key int
    pub shortcut_modifiers int
    pub kind int
    pub enabled bool
    pub checked bool
    pub radio_group int
}
pub fn menu_item(key int,label string) MenuItem {
    << MenuItem{key: key,parent: 0,label: label,shortcut_label: "",shortcut_key: 0,shortcut_modifiers: 0,kind: MENU_ACTION,enabled: true,checked: false,radio_group: 0}
}
pub struct MenuAppearance {
    pub row_height f64
    pub min_width f64
    pub max_width f64
    pub close_on_select bool
    pub hover_delay time.Duration
}
pub fn menu_appearance() MenuAppearance {
    << MenuAppearance{row_height: 36.0,min_width: 180.0,max_width: 360.0,close_on_select: true,hover_delay: time.duration(180 * time.millisecond())}
}
pub struct Menu {
    control Button
    label string
    items []MenuItem
    mode int
    primary_key int
    appearance MenuAppearance
    labels TextCache
    item_widths []f64
    metrics_ready bool
    metrics_options draw.TextOptions
    viewport layout.Rect
    anchor layout.Rect
    opened bool
    path []int
    panels []layout.Rect
    offsets []f64
    hot int
    hot_depth int
    active int
    armed int
    key_armed int
    hover_item int
    hover_due time.Instant
    row_height f64
    density f64
    fade Tween
    submenu_fade Tween
    rows []PaintTransition
    transition PaintTransition
    motion MotionSpec
    now time.Instant
    reduced bool
}
pub fn menu(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,label string,items &[]MenuItem,mode int,primary_key int) Menu {
    if mode < MENU_DROPDOWN || mode > MENU_SPLIT || primary_key < 0 || primary_key > 2147483647 || (mode == MENU_SPLIT && primary_key == 0) { >> errors.new("widgets: invalid menu mode or primary key") }
    mut value := Menu{control: button(identity,id,bounds) or >>,label: label + "",items: []MenuItem{},mode: mode,primary_key: primary_key,
        appearance: menu_appearance(),labels: text_cache(context),item_widths: []f64{},metrics_ready: false,metrics_options: draw.text_options(0.0),viewport: layout.Rect{x: 0.0,y: 0.0,width: 1280.0,height: 800.0},anchor: copy_rect(bounds),
        opened: false,path: []int{},panels: []layout.Rect{},offsets: []f64{},hot: -1,hot_depth: 0,active: -1,armed: -1,key_armed: 0,
        hover_item: -1,hover_due: time.zero_instant(),row_height: 36.0,density: 1.0,fade: tween(0.0) or >>,submenu_fade: tween(1.0) or >>,
        rows: []PaintTransition{},transition: paint_transition(),motion: motion_spec(),now: time.zero_instant(),reduced: false}
    value.set_items(items) or >>
    << value
}
pub fn (m &Menu) id() int { << m.control.id }
pub fn (m &Menu) bounds() layout.Rect { << m.control.bounds() }
pub fn (m &Menu) is_enabled() bool { << m.control.is_enabled() }
pub fn (m &Menu) is_open() bool { << m.opened && m.is_enabled() }
pub fn (m &Menu) opacity() f64 { << m.fade.value() }
pub fn (m &Menu) needs_paint() bool { << m.control.dirty }
pub fn (m &mut Menu) painted() { m.control.dirty = false }
fn (m &Menu) index(key int) int { for i in 0:m.items.len { if m.items[i].key == key { << i } }
    << -1 }
fn menu_validate_items(items &[]MenuItem) int {
    for i in 0:items.len {
        if items[i].key <= 0 || items[i].key > 2147483647 || items[i].parent < 0 || items[i].label.len > 4096 || items[i].shortcut_label.len > 256 || items[i].kind < MENU_ACTION || items[i].kind > MENU_SUBMENU || items[i].radio_group < 0 || items[i].shortcut_key < 0 || items[i].shortcut_key > 512 || items[i].shortcut_modifiers < 0 || items[i].shortcut_modifiers > 15 {
            >> errors.new("widgets: invalid menu item") }
        for j in 0:i { if items[j].key == items[i].key { >> errors.new("widgets: duplicate menu key") } }
        if items[i].kind == MENU_RADIO && items[i].checked {
            for j in 0:i { if items[j].kind == MENU_RADIO && items[j].checked && items[j].parent == items[i].parent && items[j].radio_group == items[i].radio_group { >> errors.new("widgets: multiple checked items in menu radio group") } }
        }
        mut parent := items[i].parent
        mut depth := 0
        while parent > 0 {
            mut index := -1
            for j in 0:items.len { if items[j].key == parent { index = j } }
            if index < 0 || items[index].kind != MENU_SUBMENU || depth >= items.len || parent == items[i].key { >> errors.new("widgets: invalid menu parent or depth") }
            parent = items[index].parent
            depth += 1 }
    }
    << 0
}
pub fn (m &mut Menu) set_items(items &[]MenuItem) int {
    menu_validate_items(items) or >>
    mut next := []MenuItem{}
    for i in 0:items.len {
        key := items[i].key
        parent := items[i].parent
        label := items[i].label + ""
        shortcut := items[i].shortcut_label + ""
        shortcut_key := items[i].shortcut_key
        modifiers := items[i].shortcut_modifiers
        kind := items[i].kind
        enabled := items[i].enabled
        checked := items[i].checked
        group := items[i].radio_group
        next.push(MenuItem{key: key,parent: parent,label: label,shortcut_label: shortcut,shortcut_key: shortcut_key,shortcut_modifiers: modifiers,kind: kind,enabled: enabled,checked: checked,radio_group: group}) }
    m.cancel()
    m.items = next
    m.item_widths = []f64{}
    m.metrics_ready = false
    m.rows = []PaintTransition{}
    for i in 0:items.len { mut row := paint_transition()
        row.set_spec(&m.motion) or >>
        m.rows.push(row) }
    m.control.dirty = true
    << 0
}
pub fn (m &mut Menu) set_item_label(key int,label string) int {
    index := m.index(key)
    if index < 0 || label.len > 4096 { >> errors.new("widgets: invalid menu label") }
    m.items[index].label = label + ""
    m.metrics_ready = false
    m.control.dirty = true
    << 0
}
pub fn (m &mut Menu) set_label(label string) { m.label = label + ""
    m.control.dirty = true }
pub fn (m &Menu) checked(key int) bool {
    index := m.index(key)
    if index < 0 { >> errors.new("widgets: unknown menu key") }
    << m.items[index].checked
}
pub fn (m &mut Menu) set_checked(key int,value bool) int {
    index := m.index(key)
    if index < 0 || (m.items[index].kind != MENU_CHECK && m.items[index].kind != MENU_RADIO) { >> errors.new("widgets: expected checkable menu item") }
    if value && m.items[index].kind == MENU_RADIO {
        parent := m.items[index].parent
        group := m.items[index].radio_group
        for i in 0:m.items.len { if m.items[i].kind == MENU_RADIO && m.items[i].parent == parent && m.items[i].radio_group == group { m.items[i].checked = false } }
    }
    m.items[index].checked = value
    m.control.dirty = true
    << 0
}
pub fn (m &mut Menu) set_item_enabled(key int,value bool) int {
    index := m.index(key)
    if index < 0 { >> errors.new("widgets: unknown menu key") }
    m.items[index].enabled = value
    if !value { m.close() or >> }
    m.control.dirty = true
    << 0
}
pub fn (m &mut Menu) set_appearance(a &MenuAppearance) int {
    if !finite_metric(a.row_height,128.0) || a.row_height < 28.0 || !finite_metric(a.min_width,1024.0) || a.min_width < 80.0 || !finite_metric(a.max_width,1024.0) || a.max_width < a.min_width || a.hover_delay.is_negative() || a.hover_delay.nanoseconds() > time.second() {
        >> errors.new("widgets: invalid menu appearance") }
    m.appearance = MenuAppearance{row_height: a.row_height,min_width: a.min_width,max_width: a.max_width,close_on_select: a.close_on_select,hover_delay: a.hover_delay}
    m.control.dirty = true
    << 0
}
pub fn (m &mut Menu) close() int {
    m.opened = false
    m.hover_item = -1
    m.hover_due = time.zero_instant()
    m.armed = -1
    m.key_armed = 0
    now := m.now
    spec := m.motion
    reduced := m.reduced || !m.is_enabled()
    fade := mut &m.fade
    fade.retarget_unit(0.0,now,spec.exit,reduced) or >>
    m.control.dirty = true
    << 0
}
pub fn (m &mut Menu) cancel() {
    labels := mut &m.labels
    labels.dispose()
    m.panels = []layout.Rect{}
    m.path = []int{}
    m.offsets = []f64{}
    m.opened = false
    m.hover_item = -1
    m.hover_due = time.zero_instant()
    m.armed = -1
    m.key_armed = 0
    item := mut &m.control
    item.cancel()
    m.control.dirty = true
}
pub fn (m &mut Menu) set_focus(value bool) { if !value { m.cancel() }
    item := mut &m.control
    item.set_focus(value) }
pub fn (m &mut Menu) set_enabled(value bool) { if !value { m.cancel() }
    item := mut &m.control
    item.set_enabled(value) }
pub fn (m &mut Menu) set_read_only(value bool) { if value && !m.control.read_only { m.cancel() }
    item := mut &m.control
    item.set_read_only(value) }
pub fn (m &mut Menu) set_bounds(b &layout.Rect) int {
    old := m.bounds()
    if !overlay_same_rect(&old,b) && m.opened { m.cancel() }
    item := mut &m.control
    << item.set_bounds(b) or >>
}
pub fn (m &mut Menu) set_style(style &ControlStyle) int { item := mut &m.control
    << item.set_style(style) or >> }
pub fn (m &mut Menu) clear_style() { item := mut &m.control
    item.clear_style() }
pub fn (m &mut Menu) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    m.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    transition := mut &m.transition
    transition.set_spec(spec) or >>
    for i in 0:m.rows.len { mut row := m.rows[i]
        row.set_spec(spec) or >>
        m.rows[i] = row }
    << 0
}
pub fn (m &mut Menu) dispose() { m.cancel()
    labels := mut &m.labels
    labels.dispose()
    m.control.closed = true }
