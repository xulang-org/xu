@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

pub const ACTION_MARQUEE_CHANGE = 22
pub const ACTION_VIEWPORT_CHANGE = 23

pub struct ViewportTransform {
    pub pan_x f64
    pub pan_y f64
    pub zoom f64
    pub min_zoom f64
    pub max_zoom f64
}

fn copy_viewport_transform(v &ViewportTransform) ViewportTransform {
    << ViewportTransform{
        pan_x: v.pan_x,
        pan_y: v.pan_y,
        zoom: v.zoom,
        min_zoom: v.min_zoom,
        max_zoom: v.max_zoom
    }
}

fn canvas_rects_intersect(a &layout.Rect,b &layout.Rect) bool {
    << a.x < b.x + b.width && a.x + a.width > b.x && a.y < b.y + b.height && a.y + a.height > b.y
}

fn normalized_rect(x0 f64,y0 f64,x1 f64,y1 f64) layout.Rect {
    rx := math.min(x0,x1)
    ry := math.min(y0,y1)
    rw := math.abs(x1 - x0)
    rh := math.abs(y1 - y0)
    << layout.Rect{x: rx,y: ry,width: rw,height: rh}
}

pub fn (s $&Screen) enable_marquee_select(container int,item_class string) int {
    _ := s.node(container) >>>
    if item_class.len > 0 && !valid_token_name(&item_class) {
        >>> errors.new("widgets: invalid marquee item class")
    }
    comp := $&s.composition
    mc := $&comp.marquee_configs
    had := mc.has(container)
    mc[container] = item_class + ""
    if !had { comp.marquee_count = comp.marquee_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_marquee_select(container int) int {
    _ := s.node(container) >>>
    comp := $&s.composition
    if comp.marquee_configs.has(container) {
        mc := $&comp.marquee_configs
        mc.delete(container)
        if comp.marquee_count > 0 { comp.marquee_count = comp.marquee_count - 1 }
    }
    if comp.marquee_selections.has(container) {
        ms := $&comp.marquee_selections
        ms.delete(container)
    }
    if comp.marquee_active_container == container {
        comp.marquee_active_container = 0
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) is_marquee_active(container int) bool {
    << s.composition.marquee_active_container > 0 && s.composition.marquee_active_container == container
}

pub fn (s &Screen) marquee_rect(container int) layout.Rect {
    if !s.is_marquee_active(container) {
        << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}
    }
    << normalized_rect(s.composition.marquee_start_x,s.composition.marquee_start_y,s.composition.marquee_cur_x,s.composition.marquee_cur_y)
}

pub fn (s &Screen) marquee_selection(container int) []int {
    _ := s.node(container) >>>
    $out := []int{}
    if !s.composition.marquee_selections.has(container) { << out }
    list := &s.composition.marquee_selections[container]
    for i in 0:list.len { out.push(list[i]) }
    << out
}

pub fn (s $&Screen) clear_marquee_selection(container int) int {
    _ := s.node(container) >>>
    comp := $&s.composition
    if comp.marquee_selections.has(container) {
        ms := $&comp.marquee_selections
        ms.delete(container)
        s.mark_paint_dirty()
    }
    << 0
}

fn (s &Screen) node_has_marquee(id int) bool {
    << s.composition.marquee_count > 0 && s.composition.marquee_configs.has(id)
}

fn (s &Screen) collect_marquee_candidates(container int,rect &layout.Rect,cls &string,out $&[]int) {
    cstr := cls + ""
    if cstr.len > 0 {
        lcount := s.composition.live_ids.len
        for i in 0:lcount {
            nid := s.composition.live_ids[i]
            if nid > 0 && nid <= s.nodes.len && nid != container && s.nodes[nid - 1].kind >= 0 &&
               s.is_visible(nid) && s.is_descendant(nid,container) && s.composition.node_classes.has(nid) {
                list := &s.composition.node_classes[nid]
                if string_vec_has(list,cls) {
                    nb := s.nodes[nid - 1].bounds
                    if canvas_rects_intersect(rect,&nb) { out.push(nid) }
                }
            }
        }
        <<
    }
    ccount := s.child_count_of(container)
    for i in 0:ccount {
        cid := s.child_at_of(container,i)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == container && s.is_visible(cid) {
            nb := s.nodes[cid - 1].bounds
            if canvas_rects_intersect(rect,&nb) { out.push(cid) }
        }
    }
}

fn (s $&Screen) recompute_marquee_selection(container int) {
    rect := s.marquee_rect(container)
    cls := s.composition.marquee_configs.get_or(container,"") + ""
    $next := []int{}
    if s.composition.marquee_additive {
        for i in 0:s.composition.marquee_base_selection.len {
            vec_add_unique($&next,s.composition.marquee_base_selection[i])
        }
    }
    $hits := []int{}
    s.collect_marquee_candidates(container,&rect,&cls,$&hits)
    for i in 0:hits.len {
        vec_add_unique($&next,hits[i])
    }
    comp := $&s.composition
    ms := $&comp.marquee_selections
    ms[container] = next
}

fn (s &Screen) find_marquee_container_at(x f64,y f64,target int,modal int) int {
    if s.composition.marquee_count == 0 { << 0 }
    if target > 0 {
        if s.composition.marquee_configs.has(target) { << target }
        << 0
    }
    lcount := s.composition.live_ids.len
    $i := lcount - 1
    while i >= 0 {
        nid := s.composition.live_ids[i]
        if nid > 0 && nid <= s.nodes.len && s.nodes[nid - 1].kind >= 0 &&
           s.composition.marquee_configs.has(nid) && s.is_visible(nid) && s.effective_enabled(nid) && s.in_modal(nid,modal) {
            if s.nodes[nid - 1].bounds.contains(x,y) { << nid }
        }
        i -= 1
    }
    << 0
}

fn (s $&Screen) marquee_handle_pointer(input &ui.InputEvent,target int,modal int,actions $&[]Action) bool {
    if s.composition.marquee_count == 0 && s.composition.marquee_active_container == 0 { << false }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && (input.modifiers & ui.MOD_ALT) == 0 {
        mc := s.find_marquee_container_at(input.x,input.y,target,modal)
        if mc <= 0 { << false }
        additive := (input.modifiers & ui.MOD_SHIFT) != 0
        $base := []int{}
        if additive && s.composition.marquee_selections.has(mc) {
            cur := &s.composition.marquee_selections[mc]
            for i in 0:cur.len { base.push(cur[i]) }
        }
        comp := $&s.composition
        comp.marquee_active_container = mc
        comp.marquee_start_x = input.x
        comp.marquee_start_y = input.y
        comp.marquee_cur_x = input.x
        comp.marquee_cur_y = input.y
        comp.marquee_additive = additive
        comp.marquee_base_selection = base
        if !additive {
            ms := $&comp.marquee_selections
            ms[mc] = []int{}
        }
        s.mark_paint_dirty()
        << true
    }
    if input.kind == ui.EV_POINTER_MOVE && s.composition.marquee_active_container > 0 {
        mc := s.composition.marquee_active_container
        comp := $&s.composition
        comp.marquee_cur_x = input.x
        comp.marquee_cur_y = input.y
        s.recompute_marquee_selection(mc)
        ms_ref := &s.composition.marquee_selections[mc]
        cnt := ms_ref.len
        actions.push(Action{kind: ACTION_MARQUEE_CHANGE,id: mc,needs_paint: true,request_focus: false,consumed: true,value: f64(cnt)})
        s.mark_paint_dirty()
        << true
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && s.composition.marquee_active_container > 0 {
        mc := s.composition.marquee_active_container
        comp := $&s.composition
        comp.marquee_cur_x = input.x
        comp.marquee_cur_y = input.y
        s.recompute_marquee_selection(mc)
        ms_ref := &s.composition.marquee_selections[mc]
        cnt := ms_ref.len
        comp2 := $&s.composition
        comp2.marquee_active_container = 0
        comp2.marquee_base_selection = []int{}
        actions.push(Action{kind: ACTION_MARQUEE_CHANGE,id: mc,needs_paint: true,request_focus: false,consumed: true,value: f64(cnt)})
        s.mark_paint_dirty()
        << true
    }
    << false
}

fn (s $&Screen) paint_marquee_overlay(frame $&draw.Frame,styles &Styles) int {
    mc := s.composition.marquee_active_container
    if mc <= 0 || mc > s.nodes.len || s.nodes[mc - 1].kind < 0 { << 0 }
    rect := s.marquee_rect(mc)
    if rect.width <= 0.5 && rect.height <= 0.5 { << 0 }
    accent := styles.button.palette.focus
    fill_col := accent.opacity(0.16)
    stroke_col := accent.opacity(0.85)
    frame.fill_rect(rect.x,rect.y,rect.width,rect.height,fill_col) >>>
    frame.stroke_rect(rect.x,rect.y,rect.width,rect.height,stroke_col,1.0) >>>
    << 0
}

pub fn (s $&Screen) enable_pan_zoom(content_node int,min_zoom f64,max_zoom f64) int {
    _ := s.node(content_node) >>>
    if math.is_nan(min_zoom) || math.is_inf(min_zoom) || math.is_nan(max_zoom) || math.is_inf(max_zoom) ||
       min_zoom <= 0.05 || max_zoom > 16.0 || min_zoom > max_zoom {
        >>> errors.new("widgets: invalid pan-zoom range")
    }
    vt_init := ViewportTransform{
        pan_x: 0.0,
        pan_y: 0.0,
        zoom: math.max(min_zoom,math.min(1.0,max_zoom)),
        min_zoom: min_zoom,
        max_zoom: max_zoom
    }
    comp := $&s.composition
    pzs := $&comp.pan_zooms
    had := pzs.has(content_node)
    pzs[content_node] = vt_init
    if !had { comp.pan_zoom_count = comp.pan_zoom_count + 1 }
    s.sync_pan_zoom_visual_transform(content_node)
    << 0
}

pub fn (s $&Screen) clear_pan_zoom(content_node int) int {
    _ := s.node(content_node) >>>
    comp := $&s.composition
    if comp.pan_zooms.has(content_node) {
        pzs := $&comp.pan_zooms
        pzs.delete(content_node)
        if comp.pan_zoom_count > 0 { comp.pan_zoom_count = comp.pan_zoom_count - 1 }
        s.clear_visual_transform(content_node) >>>
    }
    if comp.pan_active_node == content_node { comp.pan_active_node = 0 }
    << 0
}

pub fn (s &Screen) viewport_transform(content_node int) ViewportTransform {
    _ := s.node(content_node) >>>
    if s.composition.pan_zooms.has(content_node) {
        << copy_viewport_transform(&s.composition.pan_zooms[content_node])
    }
    << ViewportTransform{pan_x: 0.0,pan_y: 0.0,zoom: 1.0,min_zoom: 1.0,max_zoom: 1.0}
}

fn (s $&Screen) sync_pan_zoom_visual_transform(content_node int) {
    if !s.composition.pan_zooms.has(content_node) { << }
    v := copy_viewport_transform(&s.composition.pan_zooms[content_node])
    vt := VisualTransform{
        offset_x: v.pan_x,
        offset_y: v.pan_y,
        scale_x: v.zoom,
        scale_y: v.zoom,
        rotation: 0.0,
        origin_x: 0.0,
        origin_y: 0.0
    }
    s.apply_visual_transform_internal(content_node,&vt)
}

pub fn (s $&Screen) set_viewport_transform(content_node int,pan_x f64,pan_y f64,zoom f64) int {
    _ := s.node(content_node) >>>
    if !s.composition.pan_zooms.has(content_node) { >>> errors.new("widgets: node does not have pan-zoom enabled") }
    if math.is_nan(pan_x) || math.is_inf(pan_x) || math.abs(pan_x) > 4096.0 ||
       math.is_nan(pan_y) || math.is_inf(pan_y) || math.abs(pan_y) > 4096.0 ||
       math.is_nan(zoom) || math.is_inf(zoom) {
        >>> errors.new("widgets: invalid viewport transform")
    }
    cur := copy_viewport_transform(&s.composition.pan_zooms[content_node])
    clamped_z := math.max(cur.min_zoom,math.min(cur.max_zoom,zoom))
    comp := $&s.composition
    pzs := $&comp.pan_zooms
    pzs[content_node] = ViewportTransform{
        pan_x: pan_x,
        pan_y: pan_y,
        zoom: clamped_z,
        min_zoom: cur.min_zoom,
        max_zoom: cur.max_zoom
    }
    s.sync_pan_zoom_visual_transform(content_node)
    << 0
}

pub fn (s $&Screen) zoom_at(content_node int,focal_x f64,focal_y f64,factor f64) int {
    _ := s.node(content_node) >>>
    if !s.composition.pan_zooms.has(content_node) { >>> errors.new("widgets: node does not have pan-zoom enabled") }
    if math.is_nan(focal_x) || math.is_inf(focal_x) || math.is_nan(focal_y) || math.is_inf(focal_y) ||
       math.is_nan(factor) || math.is_inf(factor) || factor <= 0.0 {
        >>> errors.new("widgets: invalid zoom parameters")
    }
    cur := copy_viewport_transform(&s.composition.pan_zooms[content_node])
    new_z := math.max(cur.min_zoom,math.min(cur.max_zoom,cur.zoom * factor))
    ratio := new_z / cur.zoom
    b := s.nodes[content_node - 1].bounds
    new_px := (focal_x - b.x) - ((focal_x - b.x - cur.pan_x) * ratio)
    new_py := (focal_y - b.y) - ((focal_y - b.y - cur.pan_y) * ratio)
    << s.set_viewport_transform(content_node,new_px,new_py,new_z) >>>
}

pub fn (s $&Screen) fit_viewport_content(content_node int,padding f64) int {
    _ := s.node(content_node) >>>
    if !s.composition.pan_zooms.has(content_node) { >>> errors.new("widgets: node does not have pan-zoom enabled") }
    if math.is_nan(padding) || math.is_inf(padding) || padding < 0.0 || padding > 512.0 {
        >>> errors.new("widgets: invalid fit padding")
    }
    s.layout_controls() >>>
    kids := s.children(content_node) >>>
    $has_box := false
    $min_x := 0.0
    $min_y := 0.0
    $max_x := 0.0
    $max_y := 0.0
    for cid in kids {
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.is_visible(cid) {
            cb := s.nodes[cid - 1].bounds
            if !has_box {
                min_x = cb.x
                min_y = cb.y
                max_x = cb.x + cb.width
                max_y = cb.y + cb.height
                has_box = true
            } else {
                min_x = math.min(min_x,cb.x)
                min_y = math.min(min_y,cb.y)
                max_x = math.max(max_x,cb.x + cb.width)
                max_y = math.max(max_y,cb.y + cb.height)
            }
        }
    }
    if !has_box { << s.set_viewport_transform(content_node,0.0,0.0,1.0) >>> }
    cw := math.max(1.0,max_x - min_x)
    ch := math.max(1.0,max_y - min_y)
    cb_node := s.nodes[content_node - 1].bounds
    parent := s.nodes[content_node - 1].parent
    $vp := layout.Rect{x: cb_node.x,y: cb_node.y,width: cb_node.width,height: cb_node.height}
    if parent > 0 && parent <= s.nodes.len && s.nodes[parent - 1].kind >= 0 {
        pb := s.nodes[parent - 1].bounds
        vp = layout.Rect{x: pb.x,y: pb.y,width: pb.width,height: pb.height}
    }
    avail_w := math.max(1.0,vp.width - padding * 2.0)
    avail_h := math.max(1.0,vp.height - padding * 2.0)
    cur := copy_viewport_transform(&s.composition.pan_zooms[content_node])
    z := math.max(cur.min_zoom,math.min(cur.max_zoom,math.min(avail_w / cw,avail_h / ch)))
    content_cx := (min_x + max_x) * 0.5 - cb_node.x
    content_cy := (min_y + max_y) * 0.5 - cb_node.y
    vp_cx := vp.x + vp.width * 0.5
    vp_cy := vp.y + vp.height * 0.5
    pan_x := vp_cx - cb_node.x - content_cx * z
    pan_y := vp_cy - cb_node.y - content_cy * z
    << s.set_viewport_transform(content_node,pan_x,pan_y,z) >>>
}

fn (s &Screen) find_pan_zoom_at(x f64,y f64,target int,modal int) int {
    if s.composition.pan_zoom_count == 0 { << 0 }
    if target > 0 {
        $cur := target
        $budget := s.nodes.len + 1
        while cur > 0 && cur <= s.nodes.len && budget > 0 {
            if s.composition.pan_zooms.has(cur) && s.effective_enabled(cur) && s.is_visible(cur) { << cur }
            n := s.nodes[cur - 1]
            if n.kind < 0 || n.parent <= 0 { <- }
            cur = n.parent
            budget -= 1
        }
    }
    lcount := s.composition.live_ids.len
    $i := lcount - 1
    while i >= 0 {
        nid := s.composition.live_ids[i]
        if nid > 0 && nid <= s.nodes.len && s.nodes[nid - 1].kind >= 0 &&
           s.composition.pan_zooms.has(nid) && s.is_visible(nid) && s.effective_enabled(nid) && s.in_modal(nid,modal) {
            parent := s.nodes[nid - 1].parent
            if parent > 0 && parent <= s.nodes.len && s.nodes[parent - 1].kind >= 0 {
                if s.nodes[parent - 1].bounds.contains(x,y) { << nid }
            } else if s.nodes[nid - 1].bounds.contains(x,y) {
                << nid
            }
        }
        i -= 1
    }
    << 0
}

fn (s &Screen) node_is_canvas_interactive(id int) bool {
    << s.node_has_marquee(id) || (s.composition.pan_zoom_count > 0 && s.composition.pan_zooms.has(id))
}

fn (s $&Screen) pan_zoom_handle_input(input &ui.InputEvent,target int,modal int,actions $&[]Action) bool {
    if s.composition.pan_zoom_count == 0 && s.composition.pan_active_node == 0 { << false }
    if input.kind == ui.EV_POINTER_SCROLL && (input.modifiers & (ui.MOD_META | ui.MOD_CONTROL)) != 0 {
        pz := s.find_pan_zoom_at(input.x,input.y,target,modal)
        if pz <= 0 { << false }
        $factor := 1.0
        if input.dy < 0.0 { factor = 1.1 }
        else if input.dy > 0.0 { factor = 1.0 / 1.1 }
        if factor != 1.0 {
            s.zoom_at(pz,input.x,input.y,factor) >>> (err) { << false }
            vt := s.viewport_transform(pz)
            actions.push(Action{kind: ACTION_VIEWPORT_CHANGE,id: pz,needs_paint: true,request_focus: false,consumed: true,value: vt.zoom})
            s.mark_paint_dirty()
            << true
        }
        << false
    }
    is_pan_btn := input.button == ui.BUTTON_MIDDLE || (input.button == ui.BUTTON_LEFT && (input.modifiers & ui.MOD_ALT) != 0)
    if input.kind == ui.EV_POINTER_DOWN && is_pan_btn {
        pz := s.find_pan_zoom_at(input.x,input.y,target,modal)
        if pz <= 0 { << false }
        vt := s.viewport_transform(pz)
        comp := $&s.composition
        comp.pan_active_node = pz
        comp.pan_start_x = input.x
        comp.pan_start_y = input.y
        comp.pan_orig_x = vt.pan_x
        comp.pan_orig_y = vt.pan_y
        s.pointer_cursor(ui.CURSOR_HAND) >>>
        << true
    }
    if input.kind == ui.EV_POINTER_MOVE && s.composition.pan_active_node > 0 {
        pz := s.composition.pan_active_node
        if pz <= 0 || pz > s.nodes.len || s.nodes[pz - 1].kind < 0 || !s.composition.pan_zooms.has(pz) {
            comp := $&s.composition
            comp.pan_active_node = 0
            << false
        }
        nx := s.composition.pan_orig_x + (input.x - s.composition.pan_start_x)
        ny := s.composition.pan_orig_y + (input.y - s.composition.pan_start_y)
        vt := s.viewport_transform(pz)
        s.set_viewport_transform(pz,nx,ny,vt.zoom) >>> (err) { << false }
        actions.push(Action{kind: ACTION_VIEWPORT_CHANGE,id: pz,needs_paint: true,request_focus: false,consumed: true,value: vt.zoom})
        s.mark_paint_dirty()
        << true
    }
    if input.kind == ui.EV_POINTER_UP && s.composition.pan_active_node > 0 {
        comp := $&s.composition
        comp.pan_active_node = 0
        s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
        << true
    }
    << false
}

fn (s $&Screen) reset_canvas_tools_silently() {
    comp := $&s.composition
    comp.marquee_active_container = 0
    comp.marquee_base_selection = []int{}
    comp.pan_active_node = 0
}

fn (s $&Screen) cleanup_canvas_tools_for(id int) {
    comp := $&s.composition
    if comp.marquee_configs.has(id) {
        mc := $&comp.marquee_configs
        mc.delete(id)
        if comp.marquee_count > 0 { comp.marquee_count = comp.marquee_count - 1 }
    }
    if comp.marquee_selections.has(id) {
        ms := $&comp.marquee_selections
        ms.delete(id)
    }
    if comp.marquee_active_container == id {
        comp.marquee_active_container = 0
        comp.marquee_base_selection = []int{}
    }
    if comp.pan_zooms.has(id) {
        pzs := $&comp.pan_zooms
        pzs.delete(id)
        if comp.pan_zoom_count > 0 { comp.pan_zoom_count = comp.pan_zoom_count - 1 }
    }
    if comp.pan_active_node == id { comp.pan_active_node = 0 }
}
