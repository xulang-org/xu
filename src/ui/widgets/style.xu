@ui/widgets

#ui/draw
#ui/layout
#errors
#math
#unicode/utf8

pub const STATE_DISABLED = 1
pub const STATE_HOVERED = 2
pub const STATE_PRESSED = 4
pub const STATE_FOCUSED = 8
pub const STATE_SELECTED = 16
pub const STATE_INVALID = 32
pub const STATE_READ_ONLY = 64
pub const ICON_LEADING = 0
pub const ICON_TRAILING = 1
pub const ICON_ABOVE = 2
pub const ICON_BELOW = 3

pub struct FontStyle {
    pub family string
    pub size f64
    pub weight int
    pub italic bool
    pub line_height f64
}
pub fn font_style(size f64) FontStyle {
    << FontStyle{family: "",size: size,weight: 400,italic: false,line_height: 0.0}
}
pub struct Palette {
    pub normal draw.Color
    pub hovered draw.Color
    pub pressed draw.Color
    pub disabled draw.Color
    pub foreground draw.Color
    pub muted draw.Color
    pub accent draw.Color
    pub on_accent draw.Color
    pub focus draw.Color
    pub border draw.Color
    pub invalid draw.Color
    pub invalid_fill draw.Color
    pub read_only draw.Color
    pub selection draw.Color
    pub selection_text draw.Color
    pub placeholder draw.Color
}
// Each control can inherit the global font or use its own. Dimensions use
// logical pixels; density affects geometry and text_scale affects typography.
pub struct ControlStyle {
    pub palette Palette
    pub font FontStyle
    pub inherit_font bool
    pub padding layout.Insets
    pub radius f64
    pub border_width f64
    pub focus_width f64
    pub focus_inset f64
    pub min_width f64
    pub min_height f64
    pub gap f64
    pub indicator_size f64
    pub mark_width f64
    pub caret_width f64
    pub preedit_width f64
    pub shadow_x f64
    pub shadow_y f64
    pub shadow_spread f64
    pub shadow_blur f64
    pub align_x f64
    pub align_y f64
    pub icon_size f64
    pub icon_placement int
    pub icon_opacity f64
    pub disabled_icon_opacity f64
    pub shadow draw.Color
    pub states []StatePaint
}
pub struct Styles {
    pub font FontStyle
    pub text_scale f64
    pub density f64
    pub background draw.Color
    pub button ControlStyle
    pub checkbox ControlStyle
    pub input ControlStyle
    pub text_area ControlStyle
    pub progress ControlStyle
    pub scroll ControlStyle
}
pub fn dark_styles() Styles {
    p := Palette{normal: draw.rgb(36,39,44),hovered: draw.rgb(46,50,56),pressed: draw.rgb(29,32,37),
        disabled: draw.rgb(34,37,42),foreground: draw.rgb(235,237,239),muted: draw.rgb(166,173,182),
        accent: draw.rgb(232,132,113),on_accent: draw.rgb(24,26,29),focus: draw.rgb(242,200,190),
        border: draw.rgb(74,80,88),invalid: draw.rgb(251,113,133),invalid_fill: draw.rgb(65,34,44),
        read_only: draw.rgb(29,32,36),selection: draw.rgb(180,57,45),selection_text: draw.rgb(255,255,255),placeholder: draw.rgb(158,167,178)}
    $c := ControlStyle{palette: p,font: font_style(15.0),inherit_font: true,padding: layout.Insets{left: 8.0,top: 8.0,right: 8.0,bottom: 8.0},
        radius: 6.0,border_width: 1.0,focus_width: 1.5,focus_inset: 3.0,min_width: 64.0,min_height: 36.0,
        gap: 8.0,indicator_size: 20.0,mark_width: 2.0,caret_width: 1.5,preedit_width: 1.0,
        shadow_x: 0.0,shadow_y: 0.0,shadow_spread: 0.0,shadow_blur: 0.0,align_x: 0.5,align_y: 0.5,shadow: draw.rgba(0,0,0,0),icon_size: 18.0,icon_placement: ICON_LEADING,icon_opacity: 1.0,disabled_icon_opacity: 0.4,states: []StatePaint{}}
    $result := Styles{font: font_style(15.0),text_scale: 1.0,density: 1.0,background: draw.rgb(24,26,29),
        button: c.clone(),checkbox: c.clone(),input: c.clone(),text_area: c.clone(),progress: c.clone(),scroll: c.clone()}
    result.button.padding.left = 14.0
    result.button.padding.right = 14.0
    result.checkbox.border_width = 1.0
    result.checkbox.radius = 4.0
    result.checkbox.align_x = 0.0
    result.input.align_x = 0.0
    result.input.focus_inset = 0.0
    result.input.focus_width = 1.5
    result.text_area.align_x = 0.0
    result.text_area.align_y = 0.0
    result.text_area.focus_inset = 0.0
    result.text_area.focus_width = 1.5
    result.progress.min_width = 120.0
    result.progress.min_height = 12.0
    result.progress.radius = 6.0
    result.progress.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    result.scroll.indicator_size = 10.0
    result.scroll.min_height = 24.0
    result.scroll.padding = layout.Insets{left: 3.0,top: 3.0,right: 3.0,bottom: 3.0}
    $hover := state_paint(STATE_HOVERED)
    hover.unless = STATE_DISABLED | STATE_INVALID | STATE_READ_ONLY
    hover.fields = PAINT_BORDER
    hover.border = draw.rgb(108,116,126)
    $focus := state_paint(STATE_FOCUSED)
    focus.unless = STATE_DISABLED | STATE_INVALID
    focus.fields = PAINT_BORDER
    focus.border = p.focus
    result.button.states = [hover,focus]
    result.input.states = [hover,focus]
    result.text_area.states = [hover,focus]
    result.input.palette.normal = draw.rgb(30,33,38)
    result.input.palette.hovered = draw.rgb(35,39,45)
    result.text_area.palette.normal = result.input.palette.normal
    result.text_area.palette.hovered = result.input.palette.hovered
    << result
}
pub fn light_styles() Styles {
    $result := dark_styles()
    $p := result.button.palette
    p.normal = draw.rgb(243,242,238)
    p.hovered = draw.rgb(234,233,229)
    p.pressed = draw.rgb(222,221,216)
    p.disabled = draw.rgb(239,239,236)
    p.foreground = draw.rgb(41,44,48)
    p.muted = draw.rgb(104,111,119)
    p.accent = draw.rgb(180,57,45)
    p.on_accent = draw.rgb(255,255,255)
    p.selection_text = draw.rgb(255,255,255)
    p.focus = draw.rgb(215,143,130)
    p.border = draw.rgb(205,208,211)
    p.invalid = draw.rgb(190,18,60)
    p.invalid_fill = draw.rgb(255,241,242)
    p.read_only = draw.rgb(246,245,241)
    p.placeholder = draw.rgb(107,114,123)
    result.background = draw.rgb(250,249,246)
    result.button.palette = p
    result.checkbox.palette = p
    result.input.palette = p
    result.text_area.palette = p
    result.progress.palette = p
    result.scroll.palette = p
    $hover := state_paint(STATE_HOVERED)
    hover.unless = STATE_DISABLED | STATE_INVALID | STATE_READ_ONLY
    hover.fields = PAINT_BORDER
    hover.border = draw.rgb(143,150,159)
    $focus := state_paint(STATE_FOCUSED)
    focus.unless = STATE_DISABLED | STATE_INVALID
    focus.fields = PAINT_BORDER
    focus.border = p.focus
    result.button.states = [hover,focus]
    result.input.states = [hover,focus]
    result.text_area.states = [hover,focus]
    result.input.palette.normal = draw.rgb(253,252,249)
    result.input.palette.hovered = draw.rgb(249,248,244)
    result.text_area.palette.normal = result.input.palette.normal
    result.text_area.palette.hovered = result.input.palette.hovered
    << result
}
pub fn contrast_styles() Styles {
    $result := dark_styles()
    $p := result.button.palette
    p.normal = draw.rgb(0,0,0)
    p.hovered = draw.rgb(32,32,32)
    p.pressed = draw.rgb(64,64,64)
    p.foreground = draw.rgb(255,255,255)
    p.border = draw.rgb(255,255,255)
    p.focus = draw.rgb(255,230,0)
    p.accent = draw.rgb(255,230,0)
    p.on_accent = draw.rgb(0,0,0)
    p.selection = draw.rgb(255,230,0)
    p.selection_text = draw.rgb(0,0,0)
    result.background = draw.rgb(0,0,0)
    result.button.palette = p
    result.checkbox.palette = p
    result.input.palette = p
    result.text_area.palette = p
    result.progress.palette = p
    result.scroll.palette = p
    result.button.focus_width = 2.0
    result.checkbox.focus_width = 2.0
    result.progress.focus_width = 2.0
    result.scroll.focus_width = 2.0
    result.button.states = []StatePaint{}
    result.input.states = []StatePaint{}
    result.text_area.states = []StatePaint{}
    << result
}
fn font_equal(a &FontStyle,b &FontStyle) bool {
    << a.family == b.family && a.size == b.size && a.weight == b.weight && a.italic == b.italic && a.line_height == b.line_height
}
fn palette_equal(a &Palette,b &Palette) bool {
    << a.normal.value() == b.normal.value() &&
       a.hovered.value() == b.hovered.value() &&
       a.pressed.value() == b.pressed.value() &&
       a.disabled.value() == b.disabled.value() &&
       a.foreground.value() == b.foreground.value() &&
       a.muted.value() == b.muted.value() &&
       a.accent.value() == b.accent.value() &&
       a.on_accent.value() == b.on_accent.value() &&
       a.focus.value() == b.focus.value() &&
       a.border.value() == b.border.value() &&
       a.invalid.value() == b.invalid.value() &&
       a.invalid_fill.value() == b.invalid_fill.value() &&
       a.read_only.value() == b.read_only.value() &&
       a.selection.value() == b.selection.value() &&
       a.selection_text.value() == b.selection_text.value() &&
       a.placeholder.value() == b.placeholder.value()
}
fn geometry_equal(a &ControlStyle,b &ControlStyle) bool {
    << font_equal(&a.font,&b.font) && a.inherit_font == b.inherit_font &&
       a.padding.left == b.padding.left && a.padding.right == b.padding.right && a.padding.top == b.padding.top && a.padding.bottom == b.padding.bottom &&
       a.radius == b.radius &&
       a.border_width == b.border_width &&
       a.focus_width == b.focus_width &&
       a.focus_inset == b.focus_inset &&
       a.min_width == b.min_width &&
       a.min_height == b.min_height &&
       a.gap == b.gap &&
       a.indicator_size == b.indicator_size &&
       a.mark_width == b.mark_width &&
       a.caret_width == b.caret_width &&
       a.preedit_width == b.preedit_width &&
       a.shadow_x == b.shadow_x &&
       a.shadow_y == b.shadow_y &&
       a.shadow_spread == b.shadow_spread &&
       a.shadow_blur == b.shadow_blur &&
       a.align_x == b.align_x &&
       a.align_y == b.align_y
}
fn control_equal(a &ControlStyle,b &ControlStyle) bool {
    << geometry_equal(a,b) && palette_equal(&a.palette,&b.palette) && a.shadow.value() == b.shadow.value() && a.icon_size == b.icon_size && a.icon_placement == b.icon_placement && a.icon_opacity == b.icon_opacity && a.disabled_icon_opacity == b.disabled_icon_opacity && states_equal(a,b)
}
pub fn (styles &Styles) same_as(other &Styles) bool {
    << styles.same_metrics(other) && styles.background.value() == other.background.value() &&
       control_equal(&styles.button,&other.button) &&
       control_equal(&styles.checkbox,&other.checkbox) &&
       control_equal(&styles.input,&other.input) &&
       control_equal(&styles.text_area,&other.text_area) &&
       control_equal(&styles.progress,&other.progress) &&
       control_equal(&styles.scroll,&other.scroll)
}
pub fn (styles &Styles) same_metrics(other &Styles) bool {
    << font_equal(&styles.font,&other.font) && styles.text_scale == other.text_scale && styles.density == other.density &&
       measure_equal(&styles.button,&other.button) &&
       measure_equal(&styles.checkbox,&other.checkbox) &&
       measure_equal(&styles.input,&other.input) &&
       measure_equal(&styles.text_area,&other.text_area) &&
       measure_equal(&styles.progress,&other.progress) &&
       measure_equal(&styles.scroll,&other.scroll)
}
fn finite_metric(value f64,limit f64) bool { << !math.is_nan(value) && !math.is_inf(value) && value >= 0.0 && value <= limit }
fn validate_font(font &FontStyle) int {
    if font.family.len > 256 || !utf8.valid(&font.family) || !finite_metric(font.size,512.0) || font.size < 1.0 ||
       font.weight < 100 || font.weight > 900 || !finite_metric(font.line_height,1024.0) || (font.line_height > 0.0 && font.line_height < font.size) { >> errors.new("widgets: invalid font style") }
    for i in 0:font.family.len { if (font.family[i] & 255) == 0 { >> errors.new("widgets: font family contains NUL") } }
    << 0
}
fn validate_control(c &ControlStyle) int {
    validate_font(&c.font) or >>
    validate_states(c) or >>
    if !finite_metric(c.icon_size,4096.0) || c.icon_placement < ICON_LEADING || c.icon_placement > ICON_BELOW || !finite_metric(c.icon_opacity,1.0) || !finite_metric(c.disabled_icon_opacity,1.0) { >> errors.new("widgets: invalid icon style") }
    if !finite_metric(c.padding.left,4096.0) || !finite_metric(c.padding.top,4096.0) || !finite_metric(c.padding.right,4096.0) || !finite_metric(c.padding.bottom,4096.0) ||
       !finite_metric(c.radius,4096.0) ||
       !finite_metric(c.border_width,4096.0) ||
       !finite_metric(c.focus_width,4096.0) ||
       !finite_metric(c.focus_inset,4096.0) ||
       !finite_metric(c.min_width,4096.0) ||
       !finite_metric(c.min_height,4096.0) ||
       !finite_metric(c.gap,4096.0) ||
       !finite_metric(c.indicator_size,4096.0) ||
       !finite_metric(c.mark_width,4096.0) ||
       !finite_metric(c.caret_width,4096.0) ||
       !finite_metric(c.preedit_width,4096.0) ||
       !finite_metric(c.shadow_spread,4096.0) ||
       !finite_metric(c.shadow_blur,4096.0) ||
       !finite_metric(c.align_x,1.0) ||
       !finite_metric(c.align_y,1.0) ||
       !finite_metric(math.abs(c.shadow_x),4096.0) || !finite_metric(math.abs(c.shadow_y),4096.0) { >> errors.new("widgets: invalid control style") }
    << 0
}
pub fn (styles &Styles) validate() int {
    validate_font(&styles.font) or >>
    if !finite_metric(styles.text_scale,4.0) || styles.text_scale < 0.5 || !finite_metric(styles.density,4.0) || styles.density < 0.5 { >> errors.new("widgets: invalid text scale or density") }
    validate_control(&styles.button) or >>
    validate_control(&styles.checkbox) or >>
    validate_control(&styles.input) or >>
    validate_control(&styles.text_area) or >>
    validate_control(&styles.progress) or >>
    validate_control(&styles.scroll) or >>
    controls := [styles.button.clone(),styles.checkbox.clone(),styles.input.clone(),styles.text_area.clone(),styles.progress.clone(),styles.scroll.clone()]
    for c in controls {
        options := styles.text_options(&c)
        if options.size < 1.0 || options.size > 512.0 || options.line_height > 1024.0 { >> errors.new("widgets: scaled font exceeds drawing limits") }
    }
    << 0
}
pub fn (styles &Styles) text_options(control &ControlStyle) draw.TextOptions {
    $font := copy_font(&control.font)
    if control.inherit_font { font = copy_font(&styles.font) }
    $options := draw.text_options(font.size * styles.text_scale)
    options.family = font.family
    options.weight = font.weight
    options.italic = font.italic
    options.line_height = font.line_height * styles.text_scale
    << options
}
fn state_fill(p &Palette,state int) draw.Color {
    if (state & STATE_DISABLED) != 0 { << p.disabled }
    if (state & STATE_INVALID) != 0 { << p.invalid_fill }
    if (state & STATE_READ_ONLY) != 0 { << p.read_only }
    if (state & STATE_SELECTED) != 0 { << p.accent }
    if (state & STATE_PRESSED) != 0 { << p.pressed }
    if (state & STATE_HOVERED) != 0 { << p.hovered }
    << p.normal
}
fn state_ink(p &Palette,state int) draw.Color {
    if (state & STATE_DISABLED) != 0 { << p.muted }
    if (state & STATE_INVALID) != 0 { << p.invalid }
    if (state & STATE_READ_ONLY) != 0 { << p.foreground }
    if (state & STATE_SELECTED) != 0 { << p.on_accent }
    << p.foreground
}
// Rounded paths are shared by every native backend and retained frame format.
fn rounded_path(bounds &layout.Rect,radius f64) draw.Path {
    $p := draw.new_path(400)
    p.round_rect(bounds.x,bounds.y,bounds.width,bounds.height,radius) or >>
    << p
}
pub fn rounded_fill(frame $&draw.Frame,bounds &layout.Rect,radius f64,color draw.Color) int {
    if bounds.width <= 0.0 || bounds.height <= 0.0 || (color.value() & 255) == 0 { << 0 }
    if radius <= 0.0 { << frame.fill_rect(bounds.x,bounds.y,bounds.width,bounds.height,color) or >> }
    path := rounded_path(bounds,radius) or >>
    << frame.fill_path(&path,color,draw.FILL_NONZERO) or >>
}
fn rounded_stroke(frame $&draw.Frame,bounds &layout.Rect,radius f64,color draw.Color,width f64) int {
    if width < 0.000001 || bounds.width <= width || bounds.height <= width || (color.value() & 255) == 0 { << 0 }
    inset := width * 0.5
    inner := layout.Rect{x: bounds.x + inset,y: bounds.y + inset,width: bounds.width - width,height: bounds.height - width}
    path := rounded_path(&inner,math.max(0.0,radius - inset)) or >>
    options := draw.stroke_options(width)
    << frame.stroke_path(&path,color,&options) or >>
}
pub fn style_box(frame $&draw.Frame,bounds &layout.Rect,style &ControlStyle,density f64,state int) int {
    radius := style.radius * density
    if (style.shadow.value() & 255) > 0 {
        // Bounded layered penumbra; no offscreen surface or backend blur needed.
        $steps := 1
        if style.shadow_blur > 0.0 { steps = 8 }
        for i in 0:steps {
            spread := (style.shadow_spread + style.shadow_blur * f64(steps - i) / f64(steps)) * density
            box := layout.Rect{x: bounds.x + style.shadow_x * density - spread,y: bounds.y + style.shadow_y * density - spread,
                width: bounds.width + spread * 2.0,height: bounds.height + spread * 2.0}
            alpha := int(f64(style.shadow.value() & 255) / f64(steps))
            rounded_fill(frame,&box,radius + spread,style.shadow.with_alpha(alpha)) or >>
        }
    }
    rounded_fill(frame,bounds,radius,style.resolve(state).background) or >>
    resolved := style.resolve(state)
    border := resolved.border
    rounded_stroke(frame,bounds,radius,border,style.border_width * density) or >>
    if (state & STATE_FOCUSED) != 0 && (state & STATE_DISABLED) == 0 {
        inset := style.focus_inset * density
        focus := layout.Rect{x: bounds.x + inset,y: bounds.y + inset,width: math.max(0.0,bounds.width - 2.0 * inset),height: math.max(0.0,bounds.height - 2.0 * inset)}
        rounded_stroke(frame,&focus,math.max(0.0,radius - inset),resolved.focus,style.focus_width * density) or >>
    }
    << 0
}

pub fn (font &FontStyle) validate() int { << validate_font(font) or >> }
pub fn (c &ControlStyle) validate() int { << validate_control(c) or >> }
pub fn (c &ControlStyle) same_as(other &ControlStyle) bool { << control_equal(c,other) }
pub fn (c &ControlStyle) same_metrics(other &ControlStyle) bool { << measure_equal(c,other) }
pub fn paint_box_styled(frame $&draw.Frame,bounds &layout.Rect,styles &Styles,control &ControlStyle,state int) int {
    << style_box(frame,bounds,control,styles.density,state) or >>
}

// Own one native layout per label. Palette changes reuse shaping; font changes
// create a new layout before retiring the previous one. dispose after the View.
pub struct StyledLabel {
    ellipsis_width f64
    context draw.Context
    value string
    options draw.TextOptions
    layouts []draw.TextLayout
    dirty bool
    custom_style string
}
pub fn styled_label(context &draw.Context,value &string) StyledLabel {
    << StyledLabel{ellipsis_width: -1.0,context: context.clone(),value: value + "",options: draw.text_options(0.0),layouts: []draw.TextLayout{},dirty: true,custom_style: ""}
}
pub fn (label &StyledLabel) text() string { << label.value + "" }
pub fn (label &StyledLabel) has_style() bool { << label.custom_style.len > 0 }
pub fn (label &StyledLabel) style_or(fallback &ControlStyle) ControlStyle {
    if label.custom_style.len > 0 { << decode_control_style(&label.custom_style,fallback) }
    << fallback.clone()
}
pub fn (label $&StyledLabel) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    encoded := encode_control_style(style)
    if label.custom_style != encoded { label.dirty = true }
    label.custom_style = encoded
    << 0
}
pub fn (label $&StyledLabel) clear_style() {
    if label.custom_style.len > 0 {
        label.custom_style = ""
        label.dirty = true
    }
}
pub fn (label $&StyledLabel) set_text(value &string) { if label.value != value + "" { label.value = value + ""
    label.dirty = true } }
fn options_equal(a &draw.TextOptions,b &draw.TextOptions) bool {
    << a.family == b.family && a.size == b.size && a.weight == b.weight && a.italic == b.italic && a.line_height == b.line_height && a.width == b.width && a.align == b.align
}
pub fn (label $&StyledLabel) measure_styled(styles &Styles,control &ControlStyle) layout.Size {
    effective := label.style_or(control)
    options := styles.text_options(&effective)
    if label.dirty || label.ellipsis_width >= 0.0 || label.layouts.len == 0 || !options_equal(&label.options,&options) {
        shaped := label.context.layout_text(&label.value,&options) or >>
        label.dispose()
        label.layouts.push(shaped)
        label.options = copy_text_options(&options)
        label.dirty = false
    }
    shaped := label.layouts[0]
    << layout.Size{width: shaped.metrics.width,height: shaped.metrics.height}
}
pub fn (label $&StyledLabel) measure_wrapped(styles &Styles,control &ControlStyle,width f64) layout.Size {
    effective := label.style_or(control)
    $options := styles.text_options(&effective)
    if !finite_metric(width,100000.0) || width<=0.0 { >> errors.new("widgets: invalid wrapped text width") }
    options.width=width
    if label.dirty || label.ellipsis_width >= 0.0 || label.layouts.len==0 || !options_equal(&label.options,&options) {
        shaped := label.context.layout_text(&label.value,&options) or >>
        label.dispose()
        label.layouts.push(shaped)
        label.options=copy_text_options(&options)
        label.dirty=false
    }
    shaped := label.layouts[0]
    << layout.Size{width:shaped.metrics.width,height:shaped.metrics.height}
}
pub fn (label $&StyledLabel) measure_box_styled(styles &Styles,fallback &ControlStyle) layout.Size {
    c := label.style_or(fallback)
    size := label.measure_styled(styles,&c) or >>
    << layout.Size{width: math.max(c.min_width * styles.density,size.width + (c.padding.left + c.padding.right) * styles.density),
        height: math.max(c.min_height * styles.density,size.height + (c.padding.top + c.padding.bottom) * styles.density)}
}
pub fn (label $&StyledLabel) paint_text_styled(frame $&draw.Frame,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,state int) int {
    c := label.style_or(fallback)
    _ := label.measure_styled(styles,&c) or >>
    shaped := label.layouts[0]
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    width := math.max(0.0,bounds.width - left - c.padding.right * d)
    height := math.max(0.0,bounds.height - top - c.padding.bottom * d)
    frame.push() or >>
    frame.clip_rect(bounds.x + left,bounds.y + top,width,height) or >>
    frame.text_layout(&shaped,bounds.x + left + (width - shaped.metrics.width) * c.align_x,bounds.y + top + (height - shaped.metrics.height) * c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}
pub fn (label $&StyledLabel) paint_styled(frame $&draw.Frame,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,state int) int {
    c := label.style_or(fallback)
    style_box(frame,bounds,&c,styles.density,state) or >>
    << label.paint_text_styled(frame,bounds,styles,&c,state) or >>
}
pub fn (label $&StyledLabel) dispose() {
    for item in label.layouts { $owned := item
        owned.dispose() or (err) { -> } }
    label.ellipsis_width = -1.0
    label.layouts = []draw.TextLayout{}
    label.dirty = true
}

pub fn copy_font(font &FontStyle) FontStyle { << FontStyle{family: font.family + "",size: font.size,weight: font.weight,italic: font.italic,line_height: font.line_height} }
fn copy_text_options(o &draw.TextOptions) draw.TextOptions { << draw.TextOptions{family: o.family + "",size: o.size,width: o.width,weight: o.weight,italic: o.italic,align: o.align,line_height: o.line_height} }

pub fn (c &ControlStyle) clone() ControlStyle {
    << ControlStyle{palette: c.palette,
        font: copy_font(&c.font),inherit_font: c.inherit_font,padding: c.padding,
        radius: c.radius,border_width: c.border_width,focus_width: c.focus_width,focus_inset: c.focus_inset,min_width: c.min_width,min_height: c.min_height,
        gap: c.gap,indicator_size: c.indicator_size,mark_width: c.mark_width,caret_width: c.caret_width,preedit_width: c.preedit_width,
        shadow_x: c.shadow_x,shadow_y: c.shadow_y,shadow_spread: c.shadow_spread,shadow_blur: c.shadow_blur,
        align_x: c.align_x,align_y: c.align_y,shadow: c.shadow,
        icon_size: c.icon_size,icon_placement: c.icon_placement,icon_opacity: c.icon_opacity,
        disabled_icon_opacity: c.disabled_icon_opacity,states: copy_states(c)}
}

pub fn (s &Styles) clone() Styles { << Styles{font: copy_font(&s.font),text_scale: s.text_scale,density: s.density,background: s.background,button: s.button.clone(),checkbox: s.checkbox.clone(),input: s.input.clone(),text_area: s.text_area.clone(),progress: s.progress.clone(),scroll: s.scroll.clone()} }

pub fn (styles &Styles) switch_style() ControlStyle {
    $c := styles.checkbox.clone()
    c.indicator_size = math.max(20.0,c.indicator_size)
    c.radius = 999.0
    c.mark_width = 3.0
    << c
}
pub fn (styles &Styles) radio_style() ControlStyle {
    $c := styles.checkbox.clone()
    c.radius = 999.0
    << c
}
pub fn (styles &Styles) slider_style() ControlStyle {
    $c := styles.progress.clone()
    c.min_width = math.max(120.0,c.min_width)
    c.min_height = styles.button.min_height
    c.indicator_size = 18.0
    c.mark_width = 6.0
    c.radius = 999.0
    c.focus_width = styles.button.focus_width
    c.focus_inset = styles.button.focus_inset
    << c
}
pub fn (styles &Styles) tabs_style() ControlStyle {
    $c := styles.button.clone()
    c.padding = layout.Insets{left: 4.0,top: 4.0,right: 4.0,bottom: 4.0}
    c.gap = 4.0
    c.min_width = 160.0
    c.min_height = 36.0
    c.radius = 8.0
    << c
}
pub fn (styles &Styles) select_style() ControlStyle {
    $c := styles.button.clone()
    c.align_x = 0.0
    c.padding = layout.Insets{left: 12.0,top: 8.0,right: 12.0,bottom: 8.0}
    c.indicator_size = 12.0
    c.min_width = 120.0
    c.min_height = 36.0
    << c
}
pub fn (styles &Styles) divider_style() ControlStyle {
    $c := styles.button.clone()
    c.min_width = 60.0
    c.min_height = 16.0
    c.border_width = math.max(1.0,styles.button.border_width)
    c.padding = layout.Insets{left: 0.0,top: 4.0,right: 0.0,bottom: 4.0}
    c.gap = 8.0
    << c
}
pub fn (styles &Styles) badge_style() ControlStyle {
    $c := styles.button.clone()
    c.radius = 999.0
    c.min_width = 24.0
    c.min_height = 22.0
    c.padding = layout.Insets{left: 10.0,top: 3.0,right: 10.0,bottom: 3.0}
    c.indicator_size = 6.0
    c.gap = 6.0
    << c
}
pub fn (styles &Styles) card_style() ControlStyle {
    $c := styles.button.clone()
    c.radius = 10.0
    c.padding = layout.Insets{left: 14.0,top: 14.0,right: 14.0,bottom: 14.0}
    c.min_width = 148.0
    c.min_height = 68.0
    c.align_x = 0.0
    c.align_y = 0.0
    << c
}
pub fn (styles &Styles) stepper_style() ControlStyle {
    $c := styles.button.clone()
    c.min_width = 112.0
    c.min_height = 36.0
    c.indicator_size = 32.0
    c.padding = layout.Insets{left: 6.0,top: 6.0,right: 6.0,bottom: 6.0}
    c.mark_width = 2.0
    << c
}
pub fn (styles &Styles) list_box_style() ControlStyle {
    $c := styles.input.clone()
    c.min_width = 140.0
    c.min_height = 96.0
    c.indicator_size = 28.0
    c.mark_width = 6.0
    c.padding = layout.Insets{left: 6.0,top: 6.0,right: 6.0,bottom: 6.0}
    c.gap = 2.0
    << c
}
pub fn (styles &Styles) menu_style() ControlStyle {
    $c := styles.button.clone()
    c.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    c.align_x = 0.0
    c.align_y = 0.5
    c.radius = 5.0
    c.border_width = 0.0
    c.palette.normal = draw.rgba(0,0,0,0)
    c.palette.hovered = c.palette.accent
    c.palette.pressed = mix_color(c.palette.accent,styles.background,0.18)
    $hover := state_paint(STATE_HOVERED)
    hover.unless = STATE_DISABLED | STATE_READ_ONLY
    hover.fields = PAINT_BACKGROUND | PAINT_FOREGROUND
    hover.background = c.palette.accent
    hover.foreground = c.palette.on_accent
    $press := state_paint(STATE_PRESSED)
    press.unless = STATE_DISABLED | STATE_READ_ONLY
    press.fields = PAINT_BACKGROUND | PAINT_FOREGROUND
    press.background = c.palette.pressed
    press.foreground = c.palette.on_accent
    c.states = [hover,press]
    << c
}

fn measure_equal(a &ControlStyle,b &ControlStyle) bool {
    << font_equal(&a.font,&b.font) && a.inherit_font == b.inherit_font &&
       a.padding.left == b.padding.left && a.padding.top == b.padding.top && a.padding.right == b.padding.right && a.padding.bottom == b.padding.bottom &&
       a.min_width == b.min_width && a.min_height == b.min_height && a.gap == b.gap && a.indicator_size == b.indicator_size && a.icon_size == b.icon_size && a.icon_placement == b.icon_placement
}
