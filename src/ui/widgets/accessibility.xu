@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

// Accessibility node roles — a semantic abstraction of control type for
// platform providers (UIA, NSAccessibility, AT-SPI2).  Each role maps
// directly to a platform control type or pattern.
pub const ROLE_NONE = 0
pub const ROLE_WINDOW = 1
pub const ROLE_GROUP = 2
pub const ROLE_BUTTON = 3
pub const ROLE_CHECKBOX = 4
pub const ROLE_SWITCH = 5
pub const ROLE_RADIO_BUTTON = 6
pub const ROLE_TEXT_FIELD = 7
pub const ROLE_TEXT_AREA = 8
pub const ROLE_LABEL = 9
pub const ROLE_SLIDER = 10
pub const ROLE_STEPPER = 11
pub const ROLE_TAB_LIST = 12
pub const ROLE_TAB = 13
pub const ROLE_TAB_PANEL = 14
pub const ROLE_SELECT = 15
pub const ROLE_LIST = 16
pub const ROLE_LIST_ITEM = 17
pub const ROLE_TABLE = 18
pub const ROLE_TABLE_ROW = 19
pub const ROLE_TABLE_CELL = 20
pub const ROLE_TABLE_HEADER = 21
pub const ROLE_TREE = 22
pub const ROLE_TREE_ITEM = 23
pub const ROLE_PROGRESS_BAR = 24
pub const ROLE_SEPARATOR = 25
pub const ROLE_MENU = 26
pub const ROLE_MENU_ITEM = 27
pub const ROLE_DIALOG = 28
pub const ROLE_TOOLTIP = 29
pub const ROLE_TOOLBAR = 30
pub const ROLE_SCROLL_BAR = 31
pub const ROLE_BREADCRUMB = 32
pub const ROLE_LINK = 33
pub const ROLE_BADGE = 34
pub const ROLE_CARD = 35
pub const ROLE_CHART = 36
pub const ROLE_COLOR_PICKER = 37
pub const ROLE_DATE_PICKER = 38
pub const ROLE_TIME_PICKER = 39
pub const ROLE_SPINNER = 40
pub const ROLE_COMBOBOX = 41
pub const ROLE_SPLIT_VIEW = 42
pub const ROLE_WEBVIEW = 43
pub const ROLE_PASSWORD_FIELD = 44
pub const ROLE_POPOVER = 45
pub const ROLE_TOAST = 46

// Accessibility node states — a bitmask of boolean properties.
// States are orthogonal and not role-dependent at the node model layer.
pub const ACC_STATE_DISABLED = 1
pub const ACC_STATE_FOCUSED = 2
pub const ACC_STATE_SELECTED = 4
pub const ACC_STATE_CHECKED = 8
pub const ACC_STATE_EXPANDED = 16
pub const ACC_STATE_COLLAPSED = 32
pub const ACC_STATE_READ_ONLY = 64
pub const ACC_STATE_REQUIRED = 128
pub const ACC_STATE_INVALID = 256
pub const ACC_STATE_BUSY = 512
pub const ACC_STATE_PRESSED = 1024
pub const ACC_STATE_MODAL = 2048
pub const ACC_STATE_HIDDEN = 4096
pub const ACC_STATE_INDETERMINATE = 8192
pub const ACC_STATE_PASSWORD = 16384
pub const ACC_STATE_MULTILINE = 32768

// Live region semantics for status announcements.
pub const LIVE_OFF = 0
pub const LIVE_POLITE = 1
pub const LIVE_ASSERTIVE = 2

pub const MAX_ACCESSIBILITY_NODES = 512
pub const MAX_ACCESSIBILITY_TEXT = 65536

// An AccessibilityNode captures the semantic information a platform
// accessibility provider (UIA, NSAccessibility, AT-SPI2) needs to describe
// a single element to assistive technology.  It is a value type — providers
// receive a snapshot, not a mutable reference.
pub struct AccessibilityNode {
    pub id int
    pub role int
    pub parent int
    pub name string
    pub description string
    pub value string
    // Selected substring available for copy / TextPattern GetSelection.
    // Empty when the node has no selection, copy is disabled, or must not export text (password).
    pub selected_text string
    // Whether clipboard copy is allowed for this node. False for passwords and when the app disabled copy.
    pub copy_enabled bool
    pub states int
    pub live int
    pub x f64
    pub y f64
    pub width f64
    pub height f64
    // Range value properties (for SLIDER, STEPPER, PROGRESS_BAR, SCROLL_BAR).
    pub value_min f64
    pub value_max f64
    pub value_now f64
    // Table/tree position metadata.
    pub row_index int
    pub row_count int
    pub column_index int
    pub column_count int
    pub level int
    // Child ordering hint — sequential child ids for tree traversal.
    pub children []int
}

// Map a Screen control kind to a semantic accessibility role.
fn role_for_kind(kind int, secure bool, multiline bool) int {
    if kind == SCREEN_GROUP { << ROLE_GROUP }
    if kind == SCREEN_LABEL { << ROLE_LABEL }
    if kind == SCREEN_BUTTON { << ROLE_BUTTON }
    if kind == SCREEN_CHECKBOX { << ROLE_CHECKBOX }
    if kind == SCREEN_SWITCH { << ROLE_SWITCH }
    if kind == SCREEN_RADIO { << ROLE_RADIO_BUTTON }
    if kind == SCREEN_SLIDER { << ROLE_SLIDER }
    if kind == SCREEN_STEPPER { << ROLE_STEPPER }
    if kind == SCREEN_TABS { << ROLE_TAB_LIST }
    if kind == SCREEN_SELECT { << ROLE_SELECT }
    if kind == SCREEN_LIST { << ROLE_LIST }
    if kind == SCREEN_PROGRESS { << ROLE_PROGRESS_BAR }
    if kind == SCREEN_DIVIDER { << ROLE_SEPARATOR }
    if kind == SCREEN_BADGE { << ROLE_BADGE }
    if kind == SCREEN_CARD { << ROLE_CARD }
    if kind == SCREEN_RADIO_GROUP { << ROLE_GROUP }
    if kind == SCREEN_TABLE { << ROLE_TABLE }
    if kind == SCREEN_TREE { << ROLE_TREE }
    if kind == SCREEN_PAGINATION { << ROLE_TOOLBAR }
    if kind == SCREEN_BREADCRUMBS { << ROLE_BREADCRUMB }
    if kind == SCREEN_COMBO { << ROLE_COMBOBOX }
    if kind == SCREEN_MULTI { << ROLE_LIST }
    if kind == SCREEN_COLOR { << ROLE_COLOR_PICKER }
    if kind == SCREEN_DATE { << ROLE_DATE_PICKER }
    if kind == SCREEN_CLOCK { << ROLE_TIME_PICKER }
    if kind == SCREEN_SPINNER { << ROLE_SPINNER }
    if kind == SCREEN_EDITOR {
        if secure { << ROLE_PASSWORD_FIELD }
        if multiline { << ROLE_TEXT_AREA }
        << ROLE_TEXT_FIELD
    }
    if kind == SCREEN_FIELD { << ROLE_TEXT_FIELD }
    if kind == SCREEN_TASK { << ROLE_BUTTON }
    if kind == SCREEN_WEBVIEW { << ROLE_WEBVIEW }
    if kind == SCREEN_CHART { << ROLE_CHART }
    if kind == SCREEN_BUTTON_GROUP { << ROLE_TOOLBAR }
    if kind == SCREEN_RANGE_SLIDER { << ROLE_SLIDER }
    if kind == SCREEN_SPLIT_VIEW { << ROLE_SPLIT_VIEW }
    if kind == SCREEN_MENU { << ROLE_MENU }
    if kind == SCREEN_SECRET_INPUT { << ROLE_PASSWORD_FIELD }
    if kind == SCREEN_POPOVER { << ROLE_POPOVER }
    if kind == SCREEN_TOOLTIP { << ROLE_TOOLTIP }
    if kind == SCREEN_TOAST { << ROLE_TOAST }
    if kind == SCREEN_MODAL { << ROLE_DIALOG }
    << ROLE_NONE
}

// Compute accessibility state bitmask from ScreenNodeInfo properties.
fn states_of(info &ScreenNodeInfo, selected bool, checked bool, indeterminate bool, expanded int, read_only bool) int {
    $s := 0
    if !info.enabled { s = s | ACC_STATE_DISABLED }
    if info.focused { s = s | ACC_STATE_FOCUSED }
    if selected { s = s | ACC_STATE_SELECTED }
    if checked { s = s | ACC_STATE_CHECKED }
    if indeterminate { s = s | ACC_STATE_INDETERMINATE }
    if !info.visible { s = s | ACC_STATE_HIDDEN }
    if read_only { s = s | ACC_STATE_READ_ONLY }
    if info.secure { s = s | ACC_STATE_PASSWORD }
    if expanded == 1 { s = s | ACC_STATE_EXPANDED }
    if expanded == -1 { s = s | ACC_STATE_COLLAPSED }
    << s
}

// Build an accessibility name from the node's text and description.
// Screen readers use the name as the primary spoken label.
fn accessibility_name(text &string, description &string) string {
    if description.len > 0 { << *description + "" }
    << *text + ""
}

struct ParentChildRelation {
    parent int
    child int
}

// accessibility_tree builds a snapshot of semantic accessibility nodes
// from the Screen's current xacp_tree.  This is the bridge between
// the widget tree (XACP) and platform-specific accessibility providers.
//
// The caller passes the result to a platform adapter (UIA provider,
// NSAccessibility, AT-SPI2) which holds a reference until the next update.
// The tree is rebuilt on each layout pass; providers compare against
// the previous snapshot to fire change notifications.
pub fn (s $&Screen) accessibility_tree() []AccessibilityNode {
    s.check_screen() or >>
    nodes := s.xacp_tree(false, MAX_ACCESSIBILITY_NODES) or >>
    $result := []AccessibilityNode{}
    // First pass: build nodes with role, states, name, bounds.
    for info in nodes {
        role := role_for_kind(info.kind, info.secure, false)
        $selected := false
        $selected_text := ""
        $copy_enabled := false
        if s.is_selectable_label(info.id) {
            basic := $&s.basics
            store := $&basic.selectables
            if store.has(info.id) {
                $item := store.take(info.id)
                copy_enabled = item.is_copy_enabled()
                if item.has_selection() {
                    selected = true
                    if copy_enabled { selected_text = item.selected_text() }
                }
                store[info.id] = item
            }
        } else if info.kind == SCREEN_EDITOR || info.kind == SCREEN_FIELD || info.kind == SCREEN_SECRET_INPUT {
            controls := $&s.controls
            if info.kind == SCREEN_FIELD {
                fields := $&controls.fields
                if fields.has(info.id) {
                    $item := fields.take(info.id)
                    copy_enabled = item.is_copy_enabled()
                    if item.has_selection() {
                        selected = true
                        if copy_enabled { selected_text = item.selected_text() }
                    }
                    fields[info.id] = item
                }
            } else {
                editors := $&controls.editors
                if editors.has(info.id) {
                    $item := editors.take(info.id)
                    copy_enabled = item.is_copy_enabled()
                    if item.has_selection() {
                        selected = true
                        if copy_enabled { selected_text = item.selected_text() }
                    }
                    editors[info.id] = item
                }
            }
        }
        states := states_of(&info, selected, false, false, 0, false)
        name := accessibility_name(&info.text, &"")
        $value := ""
        if role == ROLE_TEXT_FIELD || role == ROLE_TEXT_AREA {
            value = info.text + ""
        }
        if info.secure || role == ROLE_PASSWORD_FIELD {
            value = ""
            selected_text = ""
            copy_enabled = false
        }
        $children := []int{}
        result.push(AccessibilityNode{
            id: info.id, role: role, parent: info.parent,
            name: name, description: "", value: value,
            selected_text: selected_text,
            copy_enabled: copy_enabled,
            states: states, live: LIVE_OFF,
            x: info.x, y: info.y, width: info.width, height: info.height,
            value_min: 0.0, value_max: 0.0, value_now: 0.0,
            row_index: 0, row_count: 0, column_index: 0, column_count: 0,
            level: 0, children: children})
    }
    // Second pass: populate children arrays from parent references.
    $relations := []ParentChildRelation{}
    for i in 0:result.len {
        if result[i].parent > 0 {
            relations.push(ParentChildRelation{parent: result[i].parent, child: result[i].id})
        }
    }
    for rel in relations {
        for j in 0:result.len {
            if result[j].id == rel.parent {
                result[j].children.push(rel.child)
                ->
            }
        }
    }
    << result
}

pub fn (node &AccessibilityNode) clone() AccessibilityNode {
    $children := []int{}
    for c in node.children { children.push(c) }
    << AccessibilityNode{
        id: node.id,
        role: node.role,
        parent: node.parent,
        name: node.name + "",
        description: node.description + "",
        value: node.value + "",
        selected_text: node.selected_text + "",
        copy_enabled: node.copy_enabled,
        states: node.states,
        live: node.live,
        x: node.x,
        y: node.y,
        width: node.width,
        height: node.height,
        value_min: node.value_min,
        value_max: node.value_max,
        value_now: node.value_now,
        row_index: node.row_index,
        row_count: node.row_count,
        column_index: node.column_index,
        column_count: node.column_count,
        level: node.level,
        children: children
    }
}

// accessibility_node_by_id returns the node with the given id, or throws.
pub fn accessibility_node_by_id(tree &[]AccessibilityNode, id int) AccessibilityNode {
    for node in tree {
        if node.id == id { << node.clone() }
    }
    >> errors.new("widgets: accessibility node not found")
}

// has_state checks whether a specific state bit is set on a node.
pub fn (node &AccessibilityNode) has_state(state int) bool {
    << (node.states & state) != 0
}

// role_name returns a human-readable string for a role constant.
// Platform providers use this for debugging; screen readers use
// their own localized role names.
pub fn role_name(role int) string {
    if role == ROLE_WINDOW { << "window" }
    if role == ROLE_GROUP { << "group" }
    if role == ROLE_BUTTON { << "button" }
    if role == ROLE_CHECKBOX { << "checkbox" }
    if role == ROLE_SWITCH { << "switch" }
    if role == ROLE_RADIO_BUTTON { << "radio button" }
    if role == ROLE_TEXT_FIELD { << "text field" }
    if role == ROLE_TEXT_AREA { << "text area" }
    if role == ROLE_LABEL { << "label" }
    if role == ROLE_SLIDER { << "slider" }
    if role == ROLE_STEPPER { << "stepper" }
    if role == ROLE_TAB_LIST { << "tab list" }
    if role == ROLE_TAB { << "tab" }
    if role == ROLE_TAB_PANEL { << "tab panel" }
    if role == ROLE_SELECT { << "select" }
    if role == ROLE_LIST { << "list" }
    if role == ROLE_LIST_ITEM { << "list item" }
    if role == ROLE_TABLE { << "table" }
    if role == ROLE_TABLE_ROW { << "table row" }
    if role == ROLE_TABLE_CELL { << "table cell" }
    if role == ROLE_TABLE_HEADER { << "table header" }
    if role == ROLE_TREE { << "tree" }
    if role == ROLE_TREE_ITEM { << "tree item" }
    if role == ROLE_PROGRESS_BAR { << "progress bar" }
    if role == ROLE_SEPARATOR { << "separator" }
    if role == ROLE_MENU { << "menu" }
    if role == ROLE_MENU_ITEM { << "menu item" }
    if role == ROLE_DIALOG { << "dialog" }
    if role == ROLE_TOOLTIP { << "tooltip" }
    if role == ROLE_TOOLBAR { << "toolbar" }
    if role == ROLE_SCROLL_BAR { << "scroll bar" }
    if role == ROLE_BREADCRUMB { << "breadcrumb" }
    if role == ROLE_LINK { << "link" }
    if role == ROLE_BADGE { << "badge" }
    if role == ROLE_CARD { << "card" }
    if role == ROLE_CHART { << "chart" }
    if role == ROLE_COLOR_PICKER { << "color picker" }
    if role == ROLE_DATE_PICKER { << "date picker" }
    if role == ROLE_TIME_PICKER { << "time picker" }
    if role == ROLE_SPINNER { << "spinner" }
    if role == ROLE_COMBOBOX { << "combobox" }
    if role == ROLE_SPLIT_VIEW { << "split view" }
    if role == ROLE_WEBVIEW { << "web view" }
    if role == ROLE_PASSWORD_FIELD { << "password field" }
    if role == ROLE_POPOVER { << "popover" }
    if role == ROLE_TOAST { << "notification" }
    << "unknown"
}
