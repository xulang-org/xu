@ui/widgets
#ui
#ui/draw
#ui/layout
#time
#errors

fn screen_visual_kind(kind int) bool { << kind == SCREEN_CHART || kind == SCREEN_BUTTON_GROUP || kind == SCREEN_RANGE_SLIDER || kind == SCREEN_SPLIT_VIEW || kind == SCREEN_MENU }
pub fn (s $&Screen) chart() int {
    id := s.add_node(SCREEN_CHART,true,ui.CURSOR_HAND) or >>
    item := chart(&s.context,&s.identity,id,&screen_empty()) or (err) { s.abandon_node(id)
        >> err }
    owner := $&s.controls
    entries := $&owner.charts
    entries[id] = item
    s.apply_current_locale(id) or >>
    << id
}
pub fn (s $&Screen) button_group(items &[]ButtonGroupItem,mode int) int {
    id := s.add_node(SCREEN_BUTTON_GROUP,true,ui.CURSOR_HAND) or >>
    item := button_group(&s.context,&s.identity,id,&screen_empty(),items,mode) or (err) { s.abandon_node(id)
        >> err }
    owner := $&s.controls
    entries := $&owner.button_groups
    entries[id] = item
    << id
}
pub fn (s $&Screen) range_slider(minimum f64,maximum f64,lower f64,upper f64) int {
    id := s.add_node(SCREEN_RANGE_SLIDER,true,ui.CURSOR_RESIZE_HORIZONTAL) or >>
    item := range_slider(&s.context,&s.identity,id,&screen_empty(),minimum,maximum,lower,upper) or (err) { s.abandon_node(id)
        >> err }
    owner := $&s.controls
    entries := $&owner.ranges
    entries[id] = item
    s.apply_current_locale(id) or >>
    << id
}
pub fn (s $&Screen) split_view(ratio f64) int {
    id := s.add_node(SCREEN_SPLIT_VIEW,true,ui.CURSOR_RESIZE_HORIZONTAL) or >>
    item := split_view(&s.identity,id,&screen_empty(),ratio) or (err) { s.abandon_node(id)
        >> err }
    owner := $&s.controls
    entries := $&owner.splits
    entries[id] = item
    << id
}
fn (s $&Screen) visual_place(id int,bounds &layout.Rect) int {
    node := s.node(id) or >>
    styles := s.styles.clone()
    viewport := s.viewport()
    if node.kind == SCREEN_CHART { owner := $&s.controls
        entries := $&owner.charts
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_charts_place($&item,bounds,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << 0 }
    if node.kind == SCREEN_BUTTON_GROUP { owner := $&s.controls
        entries := $&owner.button_groups
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_button_groups_place($&item,bounds,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << 0 }
    if node.kind == SCREEN_RANGE_SLIDER { owner := $&s.controls
        entries := $&owner.ranges
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_ranges_place($&item,bounds,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << 0 }
    if node.kind == SCREEN_SPLIT_VIEW { owner := $&s.controls
        entries := $&owner.splits
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_splits_place($&item,bounds,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << 0 }
    if node.kind == SCREEN_MENU { owner := $&s.controls
        entries := $&owner.menus
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_menus_place($&item,bounds,&styles,&viewport)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << 0 }
    >> errors.new("widgets: unsupported visual control")
}
fn visual_charts_place(item $&Chart,bounds &layout.Rect,styles &Styles) RefinedResult {
    $result := refined_result()
    item.set_bounds(bounds) or (err) { << refined_failure(err.msg()) }
    item.apply_styles(styles) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn visual_button_groups_place(item $&ButtonGroup,bounds &layout.Rect,styles &Styles) RefinedResult {
    $result := refined_result()
    item.set_bounds(bounds) or (err) { << refined_failure(err.msg()) }
    item.apply_styles(styles) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn (s $&Screen) visual_input(id int,route int,event &ui.InputEvent) Action {
    node := s.node(id) or >>
    stamp := s.now
    reduced := s.reduced
    if node.kind == SCREEN_CHART { owner := $&s.controls
        entries := $&owner.charts
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        item.now = stamp
        item.reduced = reduced
        result := visual_charts_input($&item,route,event)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << result.action }
    if node.kind == SCREEN_BUTTON_GROUP { owner := $&s.controls
        entries := $&owner.button_groups
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        item.now = stamp
        item.reduced = reduced
        result := visual_button_groups_input($&item,route,event)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << result.action }
    if node.kind == SCREEN_RANGE_SLIDER { owner := $&s.controls
        entries := $&owner.ranges
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        item.now = stamp
        item.reduced = reduced
        result := visual_ranges_input($&item,route,event)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << result.action }
    if node.kind == SCREEN_SPLIT_VIEW { owner := $&s.controls
        entries := $&owner.splits
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        item.now = stamp
        item.reduced = reduced
        result := visual_splits_input($&item,route,event)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << result.action }
    if node.kind == SCREEN_MENU { owner := $&s.controls
        entries := $&owner.menus
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        item.now = stamp
        item.reduced = reduced
        result := visual_menus_input($&item,route,event)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << result.action }
    >> errors.new("widgets: unsupported visual control")
}
fn visual_charts_input(item $&Chart,route int,event &ui.InputEvent) RefinedResult {
    $result := refined_result()
    result.action = item.route(route,event) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn visual_button_groups_input(item $&ButtonGroup,route int,event &ui.InputEvent) RefinedResult {
    $result := refined_result()
    result.action = item.route(route,event) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
