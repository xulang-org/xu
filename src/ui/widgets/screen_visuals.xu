        mut item := entries.take(id)
        result := visual_menus_paint(mut &item,frame,styles,popup)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << 0 }
    >> errors.new("widgets: unsupported visual control")
}
fn visual_charts_paint(item &mut Chart,frame &mut draw.Frame,styles &Styles,popup bool) RefinedResult {
    mut result := refined_result()
    if !popup { item.paint_styled(frame,styles) or (err) { << refined_failure(err.msg()) } }
    result.changed = item.needs_paint()
    << result
}
fn visual_button_groups_paint(item &mut ButtonGroup,frame &mut draw.Frame,styles &Styles,popup bool) RefinedResult {
