    if node.kind == SCREEN_SPLIT_VIEW { owner := mut &s.controls
        entries := mut &owner.splits
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        mut item := entries.take(id)
        result := visual_splits_paint(mut &item,frame,styles,popup)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
