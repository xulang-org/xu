        entries := $&owner.charts
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_charts_enable($&item,enabled)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << 0 }
    if node.kind == SCREEN_BUTTON_GROUP { owner := $&s.controls
        entries := $&owner.button_groups
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
