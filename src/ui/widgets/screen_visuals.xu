fn (s &mut Screen) visual_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    node := s.node(id) or >>
    styles := s.styles.clone()
    if node.kind == SCREEN_CHART { owner := mut &s.controls
        entries := mut &owner.charts
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        mut item := entries.take(id)
        result := visual_charts_tick(mut &item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_BUTTON_GROUP { owner := mut &s.controls
        entries := mut &owner.button_groups
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        mut item := entries.take(id)
        result := visual_button_groups_tick(mut &item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_RANGE_SLIDER { owner := mut &s.controls
        entries := mut &owner.ranges
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        mut item := entries.take(id)
        result := visual_ranges_tick(mut &item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_SPLIT_VIEW { owner := mut &s.controls
        entries := mut &owner.splits
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        mut item := entries.take(id)
        result := visual_splits_tick(mut &item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_MENU { owner := mut &s.controls
        entries := mut &owner.menus
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        mut item := entries.take(id)
        result := visual_menus_tick(mut &item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    >> errors.new("widgets: unsupported visual control")
}
fn visual_charts_tick(item &mut Chart,now time.Instant,reduced bool,styles &Styles) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(styles,now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn visual_button_groups_tick(item &mut ButtonGroup,now time.Instant,reduced bool,styles &Styles) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(styles,now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn (s &mut Screen) visual_enable(id int,enabled bool) int {
