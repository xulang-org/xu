fn (s $&Screen) visual_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    node := s.node(id) or >>
    styles := s.styles.clone()
    if node.kind == SCREEN_CHART { owner := $&s.controls
        entries := $&owner.charts
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_charts_tick($&item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_BUTTON_GROUP { owner := $&s.controls
        entries := $&owner.button_groups
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_button_groups_tick($&item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_RANGE_SLIDER { owner := $&s.controls
        entries := $&owner.ranges
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_ranges_tick($&item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_SPLIT_VIEW { owner := $&s.controls
        entries := $&owner.splits
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_splits_tick($&item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if node.kind == SCREEN_MENU { owner := $&s.controls
        entries := $&owner.menus
        if !entries.has(id) { >> errors.new("widgets: visual control is unavailable") }
        $item := entries.take(id)
        result := visual_menus_tick($&item,now,reduced,&styles)
        entries[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    >> errors.new("widgets: unsupported visual control")
}
fn visual_charts_tick(item $&Chart,now time.Instant,reduced bool,styles &Styles) RefinedResult {
    $result := refined_result()
    result.changed = item.tick(styles,now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn visual_button_groups_tick(item $&ButtonGroup,now time.Instant,reduced bool,styles &Styles) RefinedResult {
    $result := refined_result()
    result.changed = item.tick(styles,now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn (s $&Screen) visual_enable(id int,enabled bool) int {
    node := s.node(id) or >>
