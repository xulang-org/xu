        << 0 }
    >> errors.new("widgets: unsupported visual control")
}
fn visual_charts_paint(item $&Chart,frame $&draw.Frame,styles &Styles,popup bool) RefinedResult {
    $result := refined_result()
    if !popup { item.paint_styled(frame,styles) or (err) { << refined_failure(err.msg()) } }
    result.changed = item.needs_paint()
    << result
}
fn visual_button_groups_paint(item $&ButtonGroup,frame $&draw.Frame,styles &Styles,popup bool) RefinedResult {
