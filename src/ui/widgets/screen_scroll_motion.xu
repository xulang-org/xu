@ui/widgets

#ui/layout
#errors
#math
#time

struct ScrollTransition {
    from_offset f64
    cur_offset f64
    to_offset f64
    duration_ns int
    elapsed_ns int
    curve int
    stamp time.Instant
    active bool
}

fn (s $&Screen) cancel_scroll_transition(id int) {
    if !s.composition.scroll_transitions.has(id) { << }
    comp := $&s.composition
    sts := $&comp.scroll_transitions
    sts.delete(id)
    comp.scroll_transition_ids = vec_without(&comp.scroll_transition_ids,id)
}

fn (s $&Screen) cleanup_scroll_transition_for(id int) {
    s.cancel_scroll_transition(id)
}

pub fn (s $&Screen) animate_scroll_to(id int,target f64,duration time.Duration,curve int) int {
    if !s.basics.scrolls.has(id) { >>> errors.new("widgets: expected Scroll") }
    if math.is_nan(target) || math.is_inf(target) { >>> errors.new("widgets: invalid scroll target") }
    if duration.is_negative() || duration.nanoseconds() > 10 * time.second() ||
       curve < EASE_LINEAR || curve > EASE_OUT_BACK {
        >>> errors.new("widgets: invalid scroll animation options")
    }
    max_off := s.basics.scrolls[id].max_offset()
    clamped := math.max(0.0,math.min(max_off,target))
    cur := s.basics.scrolls[id].offset()
    if s.reduced || duration.nanoseconds() <= 0 || math.abs(clamped - cur) <= 0.1 {
        s.cancel_scroll_transition(id)
        s.set_scroll_offset_internal(id,clamped) >>>
        << 0
    }
    $next_stamp := time.zero_instant()
    if s.composition.scroll_transitions.has(id) && s.composition.scroll_transitions[id].active {
        next_stamp = s.composition.scroll_transitions[id].stamp
    }
    comp := $&s.composition
    sts := $&comp.scroll_transitions
    sts[id] = ScrollTransition{
        from_offset: cur,
        cur_offset: cur,
        to_offset: clamped,
        duration_ns: duration.nanoseconds(),
        elapsed_ns: 0,
        curve: curve,
        stamp: next_stamp,
        active: true
    }
    vec_add_unique($&comp.scroll_transition_ids,id)
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) smooth_scroll_to(id int,target f64) int {
    _ := s.node(id) >>>
    spec := s.motion_for(id) >>>
    dur := spec.duration_for(MOTION_ROLE_CHANGE) >>>
    curve := spec.curve_for(MOTION_ROLE_CHANGE) >>>
    << s.animate_scroll_to(id,target,dur,curve) >>>
}

pub fn (s $&Screen) smooth_scroll_by(id int,delta f64) int {
    if !s.basics.scrolls.has(id) { >>> errors.new("widgets: expected Scroll") }
    if math.is_nan(delta) || math.is_inf(delta) { >>> errors.new("widgets: invalid scroll delta") }
    $base := s.basics.scrolls[id].offset()
    if s.composition.scroll_transitions.has(id) && s.composition.scroll_transitions[id].active {
        base = s.composition.scroll_transitions[id].to_offset
    }
    << s.smooth_scroll_to(id,base + delta) >>>
}

pub fn (s $&Screen) smooth_ensure_visible(id int,margin f64) int {
    _ := s.node(id) >>>
    if !finite_metric(margin,4096.0) { >>> errors.new("widgets: invalid scroll reveal margin") }
    s.layout_controls() >>>
    $n := s.node(id) >>>
    while n.parent > 0 {
        parent := n.parent
        if screen_is_overlay((s.node(parent) >>>).kind) { <- }
        if s.basics.scrolls.has(parent) {
            b := s.bounds(id) >>>
            clip := s.scroll_content_clip(parent)
            axis := s.basics.scrolls[parent].axis()
            $delta := 0.0
            if axis == AXIS_VERTICAL {
                if b.y - margin < clip.y { delta = (b.y - margin) - clip.y }
                else if b.y + b.height + margin > clip.y + clip.height {
                    delta = math.min((b.y - margin) - clip.y,(b.y + b.height + margin) - (clip.y + clip.height))
                }
            } else {
                if b.x - margin < clip.x { delta = (b.x - margin) - clip.x }
                else if b.x + b.width + margin > clip.x + clip.width {
                    delta = math.min((b.x - margin) - clip.x,(b.x + b.width + margin) - (clip.x + clip.width))
                }
            }
            if delta != 0.0 {
                $base := s.basics.scrolls[parent].offset()
                if s.composition.scroll_transitions.has(parent) && s.composition.scroll_transitions[parent].active {
                    base = s.composition.scroll_transitions[parent].to_offset
                }
                s.smooth_scroll_to(parent,base + delta) >>>
            }
        }
        n = s.node(parent) >>>
    }
    << 0
}

pub fn (s $&Screen) stop_scroll_animation(id int) int {
    if !s.basics.scrolls.has(id) { >>> errors.new("widgets: expected Scroll") }
    s.cancel_scroll_transition(id)
    << 0
}

pub fn (s &Screen) is_scroll_animating(id int) bool {
    _ := s.node(id) >>>
    << s.composition.scroll_transitions.has(id) && s.composition.scroll_transitions[id].active
}

pub fn (s &Screen) scroll_progress(id int) f64 {
    if !s.basics.scrolls.has(id) { >>> errors.new("widgets: expected Scroll") }
    max_off := s.basics.scrolls[id].max_offset()
    if max_off <= 0.0 { << 0.0 }
    off := s.basics.scrolls[id].offset()
    << math.max(0.0,math.min(1.0,off / max_off))
}

pub fn (s $&Screen) is_visible_in_viewport(id int) bool {
    _ := s.node(id) >>>
    if !s.is_visible(id) || s.is_layout_hidden(id) { << false }
    s.layout_controls() >>>
    n := s.nodes[id - 1]
    if n.bounds.width <= 0.0 || n.bounds.height <= 0.0 { << false }
    clip := s.child_clip(id) >>>
    vis := screen_clip_intersection(&n.bounds,&clip)
    << vis.width > 0.0 && vis.height > 0.0
}

fn (s $&Screen) advance_scroll_animations(now time.Instant) time.Instant {
    $deadline := time.zero_instant()
    scount := s.composition.scroll_transition_ids.len
    if scount == 0 { << deadline }
    reduced := s.reduced
    $finished := []int{}
    for i in 0:scount {
        sid := s.composition.scroll_transition_ids[i]
        if sid <= 0 || sid > s.nodes.len || s.nodes[sid - 1].kind < 0 ||
           !s.basics.scrolls.has(sid) || !s.composition.scroll_transitions.has(sid) {
            finished.push(sid)
            ->
        }
        $still_active := false
        $next_off := 0.0
        $apply_off := false
        max_off := s.basics.scrolls[sid].max_offset()
        if true {
            comp := $&s.composition
            sts := $&comp.scroll_transitions
            tr := $&sts[sid]
            if tr.active {
                target := math.max(0.0,math.min(max_off,tr.to_offset))
                if reduced || tr.duration_ns <= 0 {
                    tr.cur_offset = target
                    tr.active = false
                    next_off = target
                    apply_off = true
                    finished.push(sid)
                } else if tr.stamp.is_zero() {
                    tr.stamp = now
                    still_active = true
                } else {
                    elapsed := now.since(tr.stamp).nanoseconds()
                    if elapsed > 0 {
                        tr.stamp = now
                        tr.elapsed_ns = tr.elapsed_ns + elapsed
                        if tr.elapsed_ns >= tr.duration_ns {
                            tr.cur_offset = target
                            tr.active = false
                            next_off = target
                            apply_off = true
                            finished.push(sid)
                        } else {
                            frac := math.min(1.0,f64(tr.elapsed_ns) / f64(tr.duration_ns))
                            eased := motion_ease(tr.curve,frac)
                            next_off = math.max(0.0,math.min(max_off,tr.from_offset + (target - tr.from_offset) * eased))
                            apply_off = math.abs(next_off - tr.cur_offset) > 0.01
                            tr.cur_offset = next_off
                            still_active = true
                        }
                    } else {
                        still_active = true
                    }
                }
            } else {
                finished.push(sid)
            }
        }
        if apply_off {
            s.set_scroll_offset_internal(sid,next_off) >>>
        }
        step_next := overlay_next_tick(still_active,now) >>>
        deadline = screen_earlier(deadline,step_next)
    }
    for i in 0:finished.len {
        s.cancel_scroll_transition(finished[i])
    }
    << deadline
}
