@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

pub struct VisualTransform {
    pub offset_x f64
    pub offset_y f64
    pub scale_x f64
    pub scale_y f64
    pub rotation f64
    pub origin_x f64
    pub origin_y f64
}

pub fn visual_transform() VisualTransform {
    << VisualTransform{offset_x: 0.0,offset_y: 0.0,scale_x: 1.0,scale_y: 1.0,rotation: 0.0,origin_x: 0.5,origin_y: 0.5}
}

pub fn (vt &VisualTransform) validate() int {
    if math.is_nan(vt.offset_x) || math.is_inf(vt.offset_x) || math.abs(vt.offset_x) > 4096.0 ||
       math.is_nan(vt.offset_y) || math.is_inf(vt.offset_y) || math.abs(vt.offset_y) > 4096.0 ||
       math.is_nan(vt.scale_x) || math.is_inf(vt.scale_x) || vt.scale_x <= 0.0 || vt.scale_x > 16.0 ||
       math.is_nan(vt.scale_y) || math.is_inf(vt.scale_y) || vt.scale_y <= 0.0 || vt.scale_y > 16.0 ||
       math.is_nan(vt.rotation) || math.is_inf(vt.rotation) || math.abs(vt.rotation) > 36000.0 ||
       !finite_metric(vt.origin_x,1.0) || !finite_metric(vt.origin_y,1.0) {
        >> errors.new("widgets: invalid visual transform")
    }
    << 0
}

pub fn (vt &VisualTransform) is_identity() bool {
    << vt.offset_x == 0.0 && vt.offset_y == 0.0 && vt.scale_x == 1.0 && vt.scale_y == 1.0 && vt.rotation == 0.0
}

fn copy_visual_transform(vt &VisualTransform) VisualTransform {
    << VisualTransform{offset_x: vt.offset_x,offset_y: vt.offset_y,scale_x: vt.scale_x,scale_y: vt.scale_y,rotation: vt.rotation,origin_x: vt.origin_x,origin_y: vt.origin_y}
}

fn copy_motion_spec(spec &MotionSpec) MotionSpec {
    << MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
}

struct NodeOpacityTransition {
    from_val f64
    cur_val f64
    to_val f64
    delay_ns int
    duration_ns int
    elapsed_ns int
    curve int
    end_visibility int
    exiting bool
    stamp time.Instant
    active bool
}

struct NodeTransformTransition {
    mode int
    from_ox f64
    from_oy f64
    from_sx f64
    from_sy f64
    from_rot f64
    cur_ox f64
    cur_oy f64
    cur_sx f64
    cur_sy f64
    cur_rot f64
    to_ox f64
    to_oy f64
    to_sx f64
    to_sy f64
    to_rot f64
    vel_ox f64
    vel_oy f64
    vel_sx f64
    vel_sy f64
    vel_rot f64
    origin_x f64
    origin_y f64
    stiffness f64
    damping f64
    mass f64
    precision f64
    delay_ns int
    duration_ns int
    elapsed_ns int
    curve int
    end_visibility int
    exiting bool
    stamp time.Instant
    active bool
}

fn (s $&Screen) apply_visual_transform_internal(id int,vt &VisualTransform) {
    comp := $&s.composition
    vts := $&comp.visual_transforms
    if vt.is_identity() {
        if vts.has(id) {
            vts.delete(id)
            if comp.visual_transform_count > 0 { comp.visual_transform_count = comp.visual_transform_count - 1 }
            s.mark_paint_dirty()
        }
        <<
    }
    had := vts.has(id)
    vts[id] = copy_visual_transform(vt)
    if !had { comp.visual_transform_count = comp.visual_transform_count + 1 }
    s.mark_paint_dirty()
}

fn (s $&Screen) cancel_opacity_transition(id int) {
    if !s.composition.opacity_transitions.has(id) { << }
    comp := $&s.composition
    ots := $&comp.opacity_transitions
    ots.delete(id)
    next := vec_without(&comp.opacity_transition_ids,id)
    comp.opacity_transition_ids = next
}

fn (s $&Screen) cancel_transform_transition(id int) {
    if !s.composition.transform_transitions.has(id) { << }
    comp := $&s.composition
    tts := $&comp.transform_transitions
    tts.delete(id)
    next := vec_without(&comp.transform_transition_ids,id)
    comp.transform_transition_ids = next
}

pub fn (s $&Screen) set_visual_transform(id int,vt &VisualTransform) int {
    _ := s.node(id) or >>
    vt.validate() or >>
    s.cancel_transform_transition(id)
    s.apply_visual_transform_internal(id,vt)
    << 0
}

pub fn (s &Screen) visual_transform(id int) VisualTransform {
    _ := s.node(id) or >>
    if s.composition.visual_transforms.has(id) {
        << copy_visual_transform(&s.composition.visual_transforms[id])
    }
    << visual_transform()
}

pub fn (s $&Screen) clear_visual_transform(id int) int {
    _ := s.node(id) or >>
    s.cancel_transform_transition(id)
    if s.composition.visual_transforms.has(id) {
        comp := $&s.composition
        vts := $&comp.visual_transforms
        vts.delete(id)
        if comp.visual_transform_count > 0 { comp.visual_transform_count = comp.visual_transform_count - 1 }
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) default_motion() MotionSpec {
    << copy_motion_spec(&s.composition.default_motion)
}

pub fn (s &Screen) motion_for(id int) MotionSpec {
    _ := s.node(id) or >>
    if s.composition.subtree_motion_count == 0 {
        << copy_motion_spec(&s.composition.default_motion)
    }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.subtree_motions.has(cur) {
            << copy_motion_spec(&s.composition.subtree_motions[cur])
        }
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        if n.parent > 0 { cur = n.parent }
        else if screen_is_overlay(n.kind) {
            anc := s.overlays.anchors.get_or(cur,0)
            if anc == cur { cur = 0 } else { cur = anc }
        } else { cur = 0 }
        budget -= 1
    }
    << copy_motion_spec(&s.composition.default_motion)
}

fn try_apply_node_motion(s $&Screen,id int,spec &MotionSpec) {
    s.apply_node_motion_internal(id,spec) or (err) { << }
}

fn (s $&Screen) apply_default_motion_to(id int) {
    if !s.composition.has_default_motion && s.composition.subtree_motion_count == 0 { << }
    eff := s.motion_for(id) or (err) { << }
    try_apply_node_motion(s,id,&eff)
}

fn (s $&Screen) propagate_subtree_motion(id int) int {
    if id <= 0 || id > s.nodes.len { << 0 }
    n := s.nodes[id - 1]
    if n.kind < 0 { << 0 }
    if !s.composition.explicit_motions.has(id) {
        eff := s.motion_for(id) or >>
        try_apply_node_motion(s,id,&eff)
    }
    child_count := s.child_count_of(id)
    for i in 0:child_count {
        cid := s.child_at_of(id,i)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].parent == id {
            s.propagate_subtree_motion(cid) or >>
        }
    }
    << 0
}

pub fn (s $&Screen) set_default_motion(spec &MotionSpec) int {
    spec.validate() or >>
    comp := $&s.composition
    comp.default_motion = copy_motion_spec(spec)
    comp.has_default_motion = true
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid > 0 && nid <= s.nodes.len && s.nodes[nid - 1].kind >= 0 && !s.composition.explicit_motions.has(nid) {
            eff := s.motion_for(nid) or >>
            try_apply_node_motion(s,nid,&eff)
        }
    }
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) set_subtree_motion(id int,spec &MotionSpec) int {
    _ := s.node(id) or >>
    spec.validate() or >>
    had := s.composition.subtree_motions.has(id)
    comp := $&s.composition
    sms := $&comp.subtree_motions
    sms[id] = copy_motion_spec(spec)
    if !had { comp.subtree_motion_count = comp.subtree_motion_count + 1 }
    s.propagate_subtree_motion(id) or >>
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) clear_subtree_motion(id int) int {
    _ := s.node(id) or >>
    if s.composition.subtree_motions.has(id) {
        comp := $&s.composition
        sms := $&comp.subtree_motions
        sms.delete(id)
        if comp.subtree_motion_count > 0 { comp.subtree_motion_count = comp.subtree_motion_count - 1 }
        s.propagate_subtree_motion(id) or >>
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s $&Screen) clear_motion(id int) int {
    _ := s.node(id) or >>
    if s.composition.explicit_motions.has(id) {
        comp := $&s.composition
        ems := $&comp.explicit_motions
        ems.delete(id)
    }
    eff := s.motion_for(id) or >>
    try_apply_node_motion(s,id,&eff)
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) create_animation(options &AnimationOptions) int {
    s.check_screen() or >>
    ctrl := animation_controller(options) or >>
    comp := $&s.composition
    comp.next_anim_id = comp.next_anim_id + 1
    aid := comp.next_anim_id
    anims := $&comp.animations
    anims[aid] = ctrl
    ids := $&comp.animation_ids
    ids.push(aid)
    << aid
}

pub fn (s $&Screen) play_animation(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    reduced := s.reduced
    comp := $&s.composition
    anims := $&comp.animations
    a := $&anims[aid]
    a.play(time.zero_instant(),reduced) or >>
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) pause_animation(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    now := s.now
    comp := $&s.composition
    anims := $&comp.animations
    a := $&anims[aid]
    a.pause(now) or >>
    << 0
}

pub fn (s $&Screen) resume_animation(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    comp := $&s.composition
    anims := $&comp.animations
    a := $&anims[aid]
    a.resume(time.zero_instant())
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) reverse_animation(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    now := s.now
    comp := $&s.composition
    anims := $&comp.animations
    a := $&anims[aid]
    $stamp := now
    if a.stamp.is_zero() { stamp = time.zero_instant() }
    a.reverse(stamp) or >>
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) seek_animation(aid int,progress f64) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    now := s.now
    comp := $&s.composition
    anims := $&comp.animations
    a := $&anims[aid]
    a.seek(progress,now) or >>
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) cancel_animation(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    comp := $&s.composition
    anims := $&comp.animations
    a := $&anims[aid]
    a.cancel()
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) finish_animation(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    comp := $&s.composition
    anims := $&comp.animations
    a := $&anims[aid]
    a.finish()
    s.mark_paint_dirty()
    << 0
}

pub fn (s &Screen) animation_value(aid int) f64 {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    a := &s.composition.animations[aid]
    << a.value()
}

pub fn (s &Screen) animation_progress(aid int) f64 {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    a := &s.composition.animations[aid]
    << a.progress()
}

pub fn (s &Screen) animation_state(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    a := &s.composition.animations[aid]
    << a.state()
}

pub fn (s &Screen) animation_range_value(aid int,from f64,to f64) f64 {
    val := s.animation_value(aid) or >>
    << motion_lerp(from,to,val)
}

pub fn (s &Screen) is_animation_running(aid int) bool {
    st := s.animation_state(aid) or >>
    << st == ANIMATION_RUNNING
}

pub fn (s &Screen) is_animation_finished(aid int) bool {
    st := s.animation_state(aid) or >>
    << st == ANIMATION_FINISHED
}

pub fn (s $&Screen) remove_animation(aid int) int {
    if !s.composition.animations.has(aid) { >> errors.new("widgets: unknown animation id") }
    comp := $&s.composition
    anims := $&comp.animations
    anims.delete(aid)
    next := vec_without(&comp.animation_ids,aid)
    comp.animation_ids = next
    << 0
}

fn (s $&Screen) advance_animations(now time.Instant) time.Instant {
    $deadline := time.zero_instant()
    acount := s.composition.animation_ids.len
    if acount == 0 { << deadline }
    reduced := s.reduced
    for i in 0:acount {
        aid := s.composition.animation_ids[i]
        if !s.composition.animations.has(aid) { -> }
        $changed := false
        $next := time.zero_instant()
        if true {
            comp := $&s.composition
            anims := $&comp.animations
            a := $&anims[aid]
            changed = a.advance(now,reduced)
            step_next := a.next_tick(now) or >>
            next = step_next
        }
        if changed { s.mark_paint_dirty() }
        deadline = screen_earlier(deadline,next)
    }
    << deadline
}

pub fn (s $&Screen) create_spring(initial f64) int {
    s.check_screen() or >>
    sp := spring(initial) or >>
    comp := $&s.composition
    comp.next_spring_id = comp.next_spring_id + 1
    sid := comp.next_spring_id
    sps := $&comp.springs
    sps[sid] = sp
    ids := $&comp.spring_ids
    ids.push(sid)
    << sid
}

pub fn (s $&Screen) set_spring_spec(sid int,spec &SpringSpec) int {
    if !s.composition.springs.has(sid) { >> errors.new("widgets: unknown spring id") }
    comp := $&s.composition
    sps := $&comp.springs
    sp := $&sps[sid]
    sp.set_spec(spec) or >>
    << 0
}

pub fn (s $&Screen) retarget_spring(sid int,target f64) int {
    if !s.composition.springs.has(sid) { >> errors.new("widgets: unknown spring id") }
    reduced := s.reduced
    now := s.now
    if true {
        comp := $&s.composition
        sps := $&comp.springs
        sp := $&sps[sid]
        $stamp := time.zero_instant()
        if sp.is_animating() && !sp.stamp.is_zero() { stamp = now }
        sp.retarget(target,stamp,reduced) or >>
    }
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) snap_spring(sid int,value f64) int {
    if !s.composition.springs.has(sid) { >> errors.new("widgets: unknown spring id") }
    if true {
        comp := $&s.composition
        sps := $&comp.springs
        sp := $&sps[sid]
        sp.snap(value) or >>
    }
    s.mark_paint_dirty()
    << 0
}

