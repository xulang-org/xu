    if !s.composition.springs.has(sid) { >> errors.new("widgets: unknown spring id") }
    sp := &s.composition.springs[sid]
    << sp.velocity()
}

pub fn (s &Screen) is_spring_animating(sid int) bool {
    if !s.composition.springs.has(sid) { >> errors.new("widgets: unknown spring id") }
    sp := &s.composition.springs[sid]
    << sp.is_animating()
}

pub fn (s $&Screen) remove_spring(sid int) int {
    if !s.composition.springs.has(sid) { >> errors.new("widgets: unknown spring id") }
    comp := $&s.composition
    sps := $&comp.springs
    sps.delete(sid)
    next := vec_without(&comp.spring_ids,sid)
    comp.spring_ids = next
    << 0
}

fn (s $&Screen) advance_springs(now time.Instant) time.Instant {
    $deadline := time.zero_instant()
    scount := s.composition.spring_ids.len
    if scount == 0 { << deadline }
    reduced := s.reduced
    for i in 0:scount {
        sid := s.composition.spring_ids[i]
        if !s.composition.springs.has(sid) { -> }
        $changed := false
        $next := time.zero_instant()
        if true {
            comp := $&s.composition
            sps := $&comp.springs
            sp := $&sps[sid]
            changed = sp.advance(now,reduced)
            step_next := sp.next_tick(now) or >>
            next = step_next
        }
        if changed { s.mark_paint_dirty() }
        deadline = screen_earlier(deadline,next)
    }
    << deadline
}

pub fn (s $&Screen) animate_opacity(id int,target f64,duration time.Duration,curve int) int {
    << s.animate_opacity_delayed(id,target,duration,time.duration(0),curve) or >>
}

pub fn (s $&Screen) animate_opacity_delayed(id int,target f64,duration time.Duration,delay time.Duration,curve int) int {
    _ := s.node(id) or >>
    if math.is_nan(target) || math.is_inf(target) || target < 0.0 || target > 1.0 {
        >> errors.new("widgets: invalid target opacity")
    }
    if duration.is_negative() || duration.nanoseconds() > 10 * time.second() ||
       delay.is_negative() || delay.nanoseconds() > 10 * time.second() ||
       curve < EASE_LINEAR || curve > EASE_OUT_BACK {
        >> errors.new("widgets: invalid opacity transition options")
    }
    cur := s.opacity(id) or >>
    if s.reduced || duration.nanoseconds() <= 0 || math.abs(target - cur) <= 0.0001 {
        s.cancel_opacity_transition(id)
        s.apply_opacity_internal(id,target)
        << 0
    }
    comp := $&s.composition
    ots := $&comp.opacity_transitions
    ots[id] = NodeOpacityTransition{
        from_val: cur,cur_val: cur,to_val: target,
        delay_ns: delay.nanoseconds(),duration_ns: duration.nanoseconds(),elapsed_ns: 0,curve: curve,
        end_visibility: -1,exiting: false,
        stamp: time.zero_instant(),active: true
    }
    vec_add_unique($&comp.opacity_transition_ids,id)
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) transition_opacity(id int,target f64,role int) int {
    spec := s.motion_for(id) or >>
    dur := spec.duration_for(role) or >>
    curve := spec.curve_for(role) or >>
    << s.animate_opacity(id,target,dur,curve) or >>
}

pub fn (s $&Screen) animate_transform(id int,target &VisualTransform,duration time.Duration,curve int) int {
    << s.animate_transform_delayed(id,target,duration,time.duration(0),curve) or >>
}

pub fn (s $&Screen) animate_transform_delayed(id int,target &VisualTransform,duration time.Duration,delay time.Duration,curve int) int {
    _ := s.node(id) or >>
    target.validate() or >>
    if duration.is_negative() || duration.nanoseconds() > 10 * time.second() ||
       delay.is_negative() || delay.nanoseconds() > 10 * time.second() ||
       curve < EASE_LINEAR || curve > EASE_OUT_BACK {
        >> errors.new("widgets: invalid transform transition options")
    }
    cur := s.visual_transform(id) or >>
    same := cur.offset_x == target.offset_x && cur.offset_y == target.offset_y &&
        cur.scale_x == target.scale_x && cur.scale_y == target.scale_y &&
        cur.rotation == target.rotation && cur.origin_x == target.origin_x && cur.origin_y == target.origin_y
    if s.reduced || duration.nanoseconds() <= 0 || same {
        s.cancel_transform_transition(id)
        s.apply_visual_transform_internal(id,target)
        << 0
    }
    comp := $&s.composition
    tts := $&comp.transform_transitions
    tts[id] = NodeTransformTransition{
        mode: 0,
        from_ox: cur.offset_x,from_oy: cur.offset_y,from_sx: cur.scale_x,from_sy: cur.scale_y,from_rot: cur.rotation,
        cur_ox: cur.offset_x,cur_oy: cur.offset_y,cur_sx: cur.scale_x,cur_sy: cur.scale_y,cur_rot: cur.rotation,
        to_ox: target.offset_x,to_oy: target.offset_y,to_sx: target.scale_x,to_sy: target.scale_y,to_rot: target.rotation,
        vel_ox: 0.0,vel_oy: 0.0,vel_sx: 0.0,vel_sy: 0.0,vel_rot: 0.0,
        origin_x: target.origin_x,origin_y: target.origin_y,
        stiffness: 260.0,damping: 24.0,mass: 1.0,precision: 0.001,
        delay_ns: delay.nanoseconds(),duration_ns: duration.nanoseconds(),elapsed_ns: 0,curve: curve,
        end_visibility: -1,exiting: false,
        stamp: time.zero_instant(),active: true
    }
    vec_add_unique($&comp.transform_transition_ids,id)
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) transition_transform(id int,target &VisualTransform,role int) int {
    spec := s.motion_for(id) or >>
    dur := spec.duration_for(role) or >>
    curve := spec.curve_for(role) or >>
    << s.animate_transform(id,target,dur,curve) or >>
}

pub fn (s $&Screen) spring_transform(id int,target &VisualTransform,spec &SpringSpec) int {
    _ := s.node(id) or >>
    target.validate() or >>
    spec.validate() or >>
    if s.reduced {
        s.cancel_transform_transition(id)
        s.apply_visual_transform_internal(id,target)
        << 0
    }
    if s.composition.transform_transitions.has(id) && s.composition.transform_transitions[id].mode == 1 && s.composition.transform_transitions[id].active {
        comp := $&s.composition
        tts := $&comp.transform_transitions
        tr := $&tts[id]
        tr.to_ox = target.offset_x
        tr.to_oy = target.offset_y
        tr.to_sx = target.scale_x
        tr.to_sy = target.scale_y
        tr.to_rot = target.rotation
        tr.origin_x = target.origin_x
        tr.origin_y = target.origin_y
        tr.stiffness = spec.stiffness
        tr.damping = spec.damping
        tr.mass = spec.mass
        tr.precision = spec.precision
        s.mark_paint_dirty()
        << 0
    }
    cur := s.visual_transform(id) or >>
    if cur.offset_x == target.offset_x && cur.offset_y == target.offset_y &&
       cur.scale_x == target.scale_x && cur.scale_y == target.scale_y &&
       cur.rotation == target.rotation {
        s.cancel_transform_transition(id)
        s.apply_visual_transform_internal(id,target)
        << 0
    }
    comp := $&s.composition
    tts := $&comp.transform_transitions
    tts[id] = NodeTransformTransition{
        mode: 1,
        from_ox: cur.offset_x,from_oy: cur.offset_y,from_sx: cur.scale_x,from_sy: cur.scale_y,from_rot: cur.rotation,
        cur_ox: cur.offset_x,cur_oy: cur.offset_y,cur_sx: cur.scale_x,cur_sy: cur.scale_y,cur_rot: cur.rotation,
        to_ox: target.offset_x,to_oy: target.offset_y,to_sx: target.scale_x,to_sy: target.scale_y,to_rot: target.rotation,
        vel_ox: 0.0,vel_oy: 0.0,vel_sx: 0.0,vel_sy: 0.0,vel_rot: 0.0,
        origin_x: target.origin_x,origin_y: target.origin_y,
        stiffness: spec.stiffness,damping: spec.damping,mass: spec.mass,precision: spec.precision,
        delay_ns: 0,duration_ns: 0,elapsed_ns: 0,curve: EASE_OUT_QUART,
        end_visibility: -1,exiting: false,
        stamp: time.zero_instant(),active: true
    }
    vec_add_unique($&comp.transform_transition_ids,id)
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) enter_node(id int,from_opacity f64,from_vt &VisualTransform,delay time.Duration) int {
    _ := s.node(id) or >>
    if math.is_nan(from_opacity) || math.is_inf(from_opacity) || from_opacity < 0.0 || from_opacity > 1.0 {
        >> errors.new("widgets: invalid enter opacity")
    }
    from_vt.validate() or >>
    if delay.is_negative() || delay.nanoseconds() > 10 * time.second() {
        >> errors.new("widgets: invalid enter delay")
    }
    s.set_visibility(id,VISIBILITY_VISIBLE) or >>
    s.stop_node_animations(id) or >>
    spec := s.motion_for(id) or >>
    dur := spec.duration_for(MOTION_ROLE_ENTER) or >>
    curve := spec.curve_for(MOTION_ROLE_ENTER) or >>
    id_vt := visual_transform()
    if s.reduced || dur.nanoseconds() <= 0 {
        s.apply_opacity_internal(id,1.0)
        s.apply_visual_transform_internal(id,&id_vt)
        << 0
    }
    s.apply_opacity_internal(id,from_opacity)
    s.apply_visual_transform_internal(id,from_vt)
    s.animate_opacity_delayed(id,1.0,dur,delay,curve) or >>
    s.animate_transform_delayed(id,&id_vt,dur,delay,curve) or >>
    << 0
}

pub fn (s $&Screen) exit_node(id int,to_opacity f64,to_vt &VisualTransform,end_visibility int) int {
    _ := s.node(id) or >>
    if math.is_nan(to_opacity) || math.is_inf(to_opacity) || to_opacity < 0.0 || to_opacity > 1.0 {
        >> errors.new("widgets: invalid exit opacity")
    }
    to_vt.validate() or >>
    if end_visibility != VISIBILITY_HIDDEN && end_visibility != VISIBILITY_COLLAPSED {
        >> errors.new("widgets: invalid exit end visibility")
    }
    event := s.cancellation()
    s.cancel_subtree_input(id,&event) or >>
    if s.is_descendant(s.focused,id) { s.focused = 0 }
    if s.is_descendant(s.captured,id) { s.captured = 0 }
    if s.is_descendant(s.hovered,id) {
        s.hovered = 0
        s.pointer_cursor(ui.CURSOR_DEFAULT) or >>
    }
    s.stop_node_animations(id) or >>
    spec := s.motion_for(id) or >>
    dur := spec.duration_for(MOTION_ROLE_EXIT) or >>
    curve := spec.curve_for(MOTION_ROLE_EXIT) or >>
    if s.reduced || dur.nanoseconds() <= 0 {
        s.apply_opacity_internal(id,to_opacity)
        s.apply_visual_transform_internal(id,to_vt)
        s.set_visibility(id,end_visibility) or >>
        << 0
    }
    cur_op := s.opacity(id) or >>
    if true {
        comp := $&s.composition
        ots := $&comp.opacity_transitions
        ots[id] = NodeOpacityTransition{
            from_val: cur_op,cur_val: cur_op,to_val: to_opacity,
            delay_ns: 0,duration_ns: dur.nanoseconds(),elapsed_ns: 0,curve: curve,
            end_visibility: end_visibility,exiting: true,
            stamp: time.zero_instant(),active: true
        }
        vec_add_unique($&comp.opacity_transition_ids,id)
    }
    cur_vt := s.visual_transform(id) or >>
    same_vt := cur_vt.offset_x == to_vt.offset_x && cur_vt.offset_y == to_vt.offset_y &&
        cur_vt.scale_x == to_vt.scale_x && cur_vt.scale_y == to_vt.scale_y &&
        cur_vt.rotation == to_vt.rotation && cur_vt.origin_x == to_vt.origin_x && cur_vt.origin_y == to_vt.origin_y
    if !same_vt {
        comp := $&s.composition
        tts := $&comp.transform_transitions
        tts[id] = NodeTransformTransition{
            mode: 0,
            from_ox: cur_vt.offset_x,from_oy: cur_vt.offset_y,from_sx: cur_vt.scale_x,from_sy: cur_vt.scale_y,from_rot: cur_vt.rotation,
            cur_ox: cur_vt.offset_x,cur_oy: cur_vt.offset_y,cur_sx: cur_vt.scale_x,cur_sy: cur_vt.scale_y,cur_rot: cur_vt.rotation,
            to_ox: to_vt.offset_x,to_oy: to_vt.offset_y,to_sx: to_vt.scale_x,to_sy: to_vt.scale_y,to_rot: to_vt.rotation,
            vel_ox: 0.0,vel_oy: 0.0,vel_sx: 0.0,vel_sy: 0.0,vel_rot: 0.0,
            origin_x: to_vt.origin_x,origin_y: to_vt.origin_y,
            stiffness: 260.0,damping: 24.0,mass: 1.0,precision: 0.001,
            delay_ns: 0,duration_ns: dur.nanoseconds(),elapsed_ns: 0,curve: curve,
            end_visibility: end_visibility,exiting: true,
            stamp: time.zero_instant(),active: true
        }
        vec_add_unique($&comp.transform_transition_ids,id)
    }
    s.mark_paint_dirty()
    << 0
}

fn (s &Screen) is_node_exiting(id int) bool {
    has_op := s.composition.opacity_transitions.has(id) && s.composition.opacity_transitions[id].active && s.composition.opacity_transitions[id].exiting
    has_tr := s.composition.transform_transitions.has(id) && s.composition.transform_transitions[id].active && s.composition.transform_transitions[id].exiting
    << has_op || has_tr
}

fn (s $&Screen) cancel_exiting_transitions(id int) {
    if s.composition.opacity_transitions.has(id) && s.composition.opacity_transitions[id].exiting {
        s.cancel_opacity_transition(id)
    }
    if s.composition.transform_transitions.has(id) && s.composition.transform_transitions[id].exiting {
        s.cancel_transform_transition(id)
    }
}

pub fn (s $&Screen) stop_node_animations(id int) int {
    _ := s.node(id) or >>
    s.cancel_opacity_transition(id)
    s.cancel_transform_transition(id)
    << 0
}

pub fn (s &Screen) is_node_animating(id int) bool {
    _ := s.node(id) or >>
    has_op := s.composition.opacity_transitions.has(id) && s.composition.opacity_transitions[id].active
    has_tr := s.composition.transform_transitions.has(id) && s.composition.transform_transitions[id].active
    << has_op || has_tr
}

fn (s $&Screen) advance_node_transitions(now time.Instant) time.Instant {
    $deadline := time.zero_instant()
    reduced := s.reduced
    $exit_ids := []int{}
    $exit_vis := []int{}

    ocount := s.composition.opacity_transition_ids.len
    if ocount > 0 {
        $finished_op := []int{}
        for i in 0:ocount {
            nid := s.composition.opacity_transition_ids[i]
            if nid <= 0 || nid > s.nodes.len || s.nodes[nid - 1].kind < 0 || !s.composition.opacity_transitions.has(nid) {
                finished_op.push(nid)
                ->
            }
            $still_active := false
            $next_val := 1.0
            $apply_val := false
            $end_vis := -1
            if true {
                comp := $&s.composition
                ots := $&comp.opacity_transitions
                tr := $&ots[nid]
                if tr.active {
                    if reduced || tr.duration_ns <= 0 {
                        tr.cur_val = tr.to_val
                        tr.active = false
                        next_val = tr.to_val
                        apply_val = true
                        end_vis = tr.end_visibility
                        finished_op.push(nid)
                    } else if tr.stamp.is_zero() {
                        tr.stamp = now
                        still_active = true
                    } else {
                        $elapsed := now.since(tr.stamp).nanoseconds()
                        if elapsed > 0 {
                            tr.stamp = now
                            if tr.delay_ns > 0 {
                                used := min_int(tr.delay_ns,elapsed)
                                tr.delay_ns = tr.delay_ns - used
                                elapsed = elapsed - used
                            }
                            if elapsed > 0 {
                                tr.elapsed_ns = tr.elapsed_ns + elapsed
                                if tr.elapsed_ns >= tr.duration_ns {
                                    tr.cur_val = tr.to_val
                                    tr.active = false
                                    next_val = tr.to_val
                                    apply_val = true
                                    end_vis = tr.end_visibility
                                    finished_op.push(nid)
                                } else {
                                    frac := math.min(1.0,f64(tr.elapsed_ns) / f64(tr.duration_ns))
                                    eased := motion_ease(tr.curve,frac)
                                    next_val = math.max(0.0,math.min(1.0,tr.from_val + (tr.to_val - tr.from_val) * eased))
                                    apply_val = next_val != tr.cur_val
                                    tr.cur_val = next_val
                                    still_active = true
                                }
                            } else {
                                still_active = true
                            }
                        } else {
                            still_active = true
                        }
                    }
                } else {
                    finished_op.push(nid)
                }
            }
            if apply_val { s.apply_opacity_internal(nid,next_val) }
            if end_vis >= 0 {
                exit_ids.push(nid)
                exit_vis.push(end_vis)
            }
            step_next := overlay_next_tick(still_active,now) or >>
            deadline = screen_earlier(deadline,step_next)
        }
        for i in 0:finished_op.len {
            s.cancel_opacity_transition(finished_op[i])
        }
    }

    tcount := s.composition.transform_transition_ids.len
    if tcount > 0 {
        $finished_vt := []int{}
        for i in 0:tcount {
            nid := s.composition.transform_transition_ids[i]
            if nid <= 0 || nid > s.nodes.len || s.nodes[nid - 1].kind < 0 || !s.composition.transform_transitions.has(nid) {
                finished_vt.push(nid)
                ->
            }
            $still_active := false
            $apply_vt := false
            $next_vt := visual_transform()
            $end_vis := -1
            if true {
                comp := $&s.composition
                tts := $&comp.transform_transitions
                tr := $&tts[nid]
                if tr.active {
                    if reduced || (tr.mode == 0 && tr.duration_ns <= 0) {
                        tr.cur_ox = tr.to_ox
                        tr.cur_oy = tr.to_oy
                        tr.cur_sx = tr.to_sx
                        tr.cur_sy = tr.to_sy
                        tr.cur_rot = tr.to_rot
                        tr.active = false
                        next_vt = VisualTransform{offset_x: tr.to_ox,offset_y: tr.to_oy,scale_x: tr.to_sx,scale_y: tr.to_sy,rotation: tr.to_rot,origin_x: tr.origin_x,origin_y: tr.origin_y}
                        apply_vt = true
                        end_vis = tr.end_visibility
                        finished_vt.push(nid)
                    } else if tr.stamp.is_zero() {
                        tr.stamp = now
                        still_active = true
                    } else if tr.mode == 0 {
                        $elapsed := now.since(tr.stamp).nanoseconds()
                        if elapsed > 0 {
                            tr.stamp = now
                            if tr.delay_ns > 0 {
                                used := min_int(tr.delay_ns,elapsed)
                                tr.delay_ns = tr.delay_ns - used
                                elapsed = elapsed - used
                            }
                            if elapsed > 0 {
                                tr.elapsed_ns = tr.elapsed_ns + elapsed
                                if tr.elapsed_ns >= tr.duration_ns {
                                    tr.cur_ox = tr.to_ox
                                    tr.cur_oy = tr.to_oy
                                    tr.cur_sx = tr.to_sx
                                    tr.cur_sy = tr.to_sy
                                    tr.cur_rot = tr.to_rot
                                    tr.active = false
                                    next_vt = VisualTransform{offset_x: tr.to_ox,offset_y: tr.to_oy,scale_x: tr.to_sx,scale_y: tr.to_sy,rotation: tr.to_rot,origin_x: tr.origin_x,origin_y: tr.origin_y}
                                    apply_vt = true
                                    end_vis = tr.end_visibility
                                    finished_vt.push(nid)
                                } else {
                                    frac := math.min(1.0,f64(tr.elapsed_ns) / f64(tr.duration_ns))
                                    e := motion_ease(tr.curve,frac)
                                    nox := tr.from_ox + (tr.to_ox - tr.from_ox) * e
                                    noy := tr.from_oy + (tr.to_oy - tr.from_oy) * e
                                    nsx := math.max(0.01,math.min(16.0,tr.from_sx + (tr.to_sx - tr.from_sx) * e))
                                    nsy := math.max(0.01,math.min(16.0,tr.from_sy + (tr.to_sy - tr.from_sy) * e))
                                    nrot := tr.from_rot + (tr.to_rot - tr.from_rot) * e
                                    tr.cur_ox = nox
                                    tr.cur_oy = noy
                                    tr.cur_sx = nsx
                                    tr.cur_sy = nsy
                                    tr.cur_rot = nrot
                                    next_vt = VisualTransform{offset_x: nox,offset_y: noy,scale_x: nsx,scale_y: nsy,rotation: nrot,origin_x: tr.origin_x,origin_y: tr.origin_y}
                                    apply_vt = true
                                    still_active = true
                                }
                            } else {
                                still_active = true
                            }
                        } else {
                            still_active = true
                        }
                    } else {
                        elapsed := now.since(tr.stamp).nanoseconds()
                        if elapsed > 0 {
                            tr.stamp = now
                            dt := math.min(0.25,f64(elapsed) / f64(time.second()))
                            steps := int(math.max(1.0,math.ceil(dt / 0.004)))
                            h := dt / f64(steps)
                            k := tr.stiffness
                            c := tr.damping
                            m := tr.mass
                            for _s in 0:steps {
                                a_ox := (k * (tr.to_ox - tr.cur_ox) - c * tr.vel_ox) / m
                                tr.vel_ox = tr.vel_ox + a_ox * h
                                tr.cur_ox = tr.cur_ox + tr.vel_ox * h
                                a_oy := (k * (tr.to_oy - tr.cur_oy) - c * tr.vel_oy) / m
                                tr.vel_oy = tr.vel_oy + a_oy * h
                                tr.cur_oy = tr.cur_oy + tr.vel_oy * h
                                a_sx := (k * (tr.to_sx - tr.cur_sx) - c * tr.vel_sx) / m
                                tr.vel_sx = tr.vel_sx + a_sx * h
                                tr.cur_sx = tr.cur_sx + tr.vel_sx * h
                                a_sy := (k * (tr.to_sy - tr.cur_sy) - c * tr.vel_sy) / m
                                tr.vel_sy = tr.vel_sy + a_sy * h
                                tr.cur_sy = tr.cur_sy + tr.vel_sy * h
                                a_rot := (k * (tr.to_rot - tr.cur_rot) - c * tr.vel_rot) / m
                                tr.vel_rot = tr.vel_rot + a_rot * h
                                tr.cur_rot = tr.cur_rot + tr.vel_rot * h
                            }
                            p := tr.precision
                            done_ox := math.abs(tr.to_ox - tr.cur_ox) <= p && math.abs(tr.vel_ox) <= p
                            done_oy := math.abs(tr.to_oy - tr.cur_oy) <= p && math.abs(tr.vel_oy) <= p
                            done_sx := math.abs(tr.to_sx - tr.cur_sx) <= p && math.abs(tr.vel_sx) <= p
                            done_sy := math.abs(tr.to_sy - tr.cur_sy) <= p && math.abs(tr.vel_sy) <= p
                            done_rot := math.abs(tr.to_rot - tr.cur_rot) <= p && math.abs(tr.vel_rot) <= p
                            if done_ox && done_oy && done_sx && done_sy && done_rot {
                                tr.cur_ox = tr.to_ox
                                tr.cur_oy = tr.to_oy
                                tr.cur_sx = tr.to_sx
                                tr.cur_sy = tr.to_sy
                                tr.cur_rot = tr.to_rot
                                tr.vel_ox = 0.0
                                tr.vel_oy = 0.0
                                tr.vel_sx = 0.0
                                tr.vel_sy = 0.0
                                tr.vel_rot = 0.0
                                tr.active = false
                                next_vt = VisualTransform{offset_x: tr.to_ox,offset_y: tr.to_oy,scale_x: tr.to_sx,scale_y: tr.to_sy,rotation: tr.to_rot,origin_x: tr.origin_x,origin_y: tr.origin_y}
                                apply_vt = true
                                end_vis = tr.end_visibility
                                finished_vt.push(nid)
                            } else {
                                next_vt = VisualTransform{
                                    offset_x: math.max(-4096.0,math.min(4096.0,tr.cur_ox)),
                                    offset_y: math.max(-4096.0,math.min(4096.0,tr.cur_oy)),
                                    scale_x: math.max(0.01,math.min(16.0,tr.cur_sx)),
                                    scale_y: math.max(0.01,math.min(16.0,tr.cur_sy)),
                                    rotation: math.max(-36000.0,math.min(36000.0,tr.cur_rot)),
                                    origin_x: tr.origin_x,origin_y: tr.origin_y
                                }
                                apply_vt = true
                                still_active = true
                            }
                        } else {
                            still_active = true
                        }
                    }
                } else {
                    finished_vt.push(nid)
                }
            }
            if apply_vt { s.apply_visual_transform_internal(nid,&next_vt) }
            if end_vis >= 0 {
                exit_ids.push(nid)
                exit_vis.push(end_vis)
            }
            step_next := overlay_next_tick(still_active,now) or >>
            deadline = screen_earlier(deadline,step_next)
        }
        for i in 0:finished_vt.len {
            s.cancel_transform_transition(finished_vt[i])
        }
    }

    for i in 0:exit_ids.len {
        eid := exit_ids[i]
        evis := exit_vis[i]
        if eid > 0 && eid <= s.nodes.len && s.nodes[eid - 1].kind >= 0 && !s.is_node_exiting(eid) {
            cur_vis := s.visibility(eid) or >>
            if cur_vis != evis {
                _ := s.set_visibility(eid,evis) or >>
            }
        }
    }
    << deadline
}
