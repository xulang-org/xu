@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

pub struct SplitViewOptions {
    pub vertical bool
    pub minimum_first f64
    pub minimum_second f64
    pub handle_size f64
    pub keyboard_step f64
}
pub fn split_view_options() SplitViewOptions {
    << SplitViewOptions{vertical: false,minimum_first: 80.0,minimum_second: 80.0,handle_size: 12.0,keyboard_step: 0.01}
}
pub struct SplitLayout {
    pub first layout.Rect
    pub second layout.Rect
    pub handle layout.Rect
    pub ratio f64
    pub collapsed int
}
pub struct SplitView {
    control Button
    options SplitViewOptions
    ratio f64
    collapsed int
    first_id int
    second_id int
    density f64
    dragging bool
    pending bool
    key_pending int
    saved_ratio f64
    saved_collapsed int
    hover Tween
    motion MotionSpec
    now time.Instant
    reduced bool
}
pub fn split_view(identity &ui.CanvasEvent,id int,bounds &layout.Rect,ratio f64) SplitView {
    if !range_number(ratio) || ratio < 0.0 || ratio > 1.0 { >> errors.new("widgets: invalid split ratio") }
    << SplitView{control: button(identity,id,bounds) or >>,options: split_view_options(),ratio: ratio,collapsed: 0,first_id: 0,second_id: 0,density: 1.0,
        dragging: false,pending: false,key_pending: 0,saved_ratio: ratio,saved_collapsed: 0,hover: tween(0.0) or >>,motion: motion_spec(),now: time.zero_instant(),reduced: false}
}
pub fn (v &SplitView) id() int { << v.control.id }
pub fn (v &SplitView) bounds() layout.Rect { << v.control.bounds() }
pub fn (v &SplitView) value() f64 { << v.ratio }
pub fn (v &SplitView) needs_paint() bool { << v.control.dirty }
pub fn (v &mut SplitView) painted() { v.control.dirty = false }
pub fn (v &SplitView) is_enabled() bool { << v.control.is_enabled() }
pub fn (v &SplitView) geometry(bounds &layout.Rect,density f64) SplitLayout {
    mut length := bounds.width
    if v.options.vertical { length = bounds.height }
    handle := math.min(length,v.options.handle_size * density)
    available := math.max(0.0,length - handle)
    mut minimum := math.min(available,v.options.minimum_first * density)
    mut maximum := math.max(0.0,available - v.options.minimum_second * density)
    if minimum > maximum {
        sum := math.max(1.0,v.options.minimum_first + v.options.minimum_second)
        minimum = available * v.options.minimum_first / sum
        maximum = minimum }
    mut first := math.max(minimum,math.min(maximum,available * v.ratio))
    if v.collapsed == 1 { first = 0.0 }
    if v.collapsed == 2 { first = available }
    mut a := layout.Rect{x: bounds.x,y: bounds.y,width: first,height: bounds.height}
    mut h := layout.Rect{x: bounds.x + first,y: bounds.y,width: handle,height: bounds.height}
    mut b := layout.Rect{x: bounds.x + first + handle,y: bounds.y,width: available - first,height: bounds.height}
    if v.options.vertical {
        a = layout.Rect{x: bounds.x,y: bounds.y,width: bounds.width,height: first}
        h = layout.Rect{x: bounds.x,y: bounds.y + first,width: bounds.width,height: handle}
        b = layout.Rect{x: bounds.x,y: bounds.y + first + handle,width: bounds.width,height: available - first} }
    mut ratio := 0.0
    if available > 0.0 { ratio = first / available }
    << SplitLayout{first: a,second: b,handle: h,ratio: ratio,collapsed: v.collapsed}
}
pub fn (v &SplitView) layout() SplitLayout { << v.geometry(&v.bounds(),v.density) }
pub fn (v &mut SplitView) set_ratio(value f64) int {
    if !range_number(value) || value < 0.0 || value > 1.0 { >> errors.new("widgets: invalid split ratio") }
    if v.ratio != value || v.collapsed != 0 { v.control.dirty = true }
    v.ratio = value
    v.collapsed = 0
    v.pending = false
    v.key_pending = 0
    v.dragging = false
    << 0
}
// Collapse retains the requested ratio; expanding restores it under current minima.
pub fn (v &mut SplitView) set_collapsed(pane int,collapsed bool) int {
    if pane < 0 || pane > 1 { >> errors.new("widgets: invalid split pane") }
    v.cancel()
    if collapsed { v.collapsed = pane + 1 }
    else if v.collapsed == pane + 1 { v.collapsed = 0 }
    v.control.dirty = true
    << 0
}
pub fn (v &mut SplitView) set_options(o &SplitViewOptions) int {
    if !finite_metric(o.minimum_first,100000.0) || !finite_metric(o.minimum_second,100000.0) || !finite_metric(o.handle_size,64.0) || o.handle_size < 8.0 || !range_number(o.keyboard_step) || o.keyboard_step <= 0.0 || o.keyboard_step > 0.5 {
        >> errors.new("widgets: invalid split options") }
    old := v.options
    if old.vertical == o.vertical && old.minimum_first == o.minimum_first && old.minimum_second == o.minimum_second && old.handle_size == o.handle_size && old.keyboard_step == o.keyboard_step { << 0 }
    v.cancel()
    v.options = SplitViewOptions{vertical: o.vertical,minimum_first: o.minimum_first,minimum_second: o.minimum_second,handle_size: o.handle_size,keyboard_step: o.keyboard_step}
    v.control.dirty = true
    << 0
}
pub fn (v &mut SplitView) cancel() {
    if v.pending { v.ratio = v.saved_ratio
        v.collapsed = v.saved_collapsed
        v.control.dirty = true }
    v.pending = false
    v.key_pending = 0
    v.dragging = false
    item := mut &v.control
    item.cancel()
}
pub fn (v &mut SplitView) set_focus(value bool) { if !value { v.cancel() }
    item := mut &v.control
    item.set_focus(value) }
pub fn (v &mut SplitView) set_enabled(value bool) { if !value { v.cancel() }
    item := mut &v.control
    item.set_enabled(value) }
pub fn (v &mut SplitView) set_read_only(value bool) { if value && !v.control.read_only { v.cancel() }
    item := mut &v.control
    item.set_read_only(value) }
pub fn (v &mut SplitView) set_bounds(b &layout.Rect) int {
    validate_bounds(b) or >>
    old := v.bounds()
    if !overlay_same_rect(&old,b) { v.cancel() }
    item := mut &v.control
    << item.set_bounds(b) or >>
}
pub fn (v &mut SplitView) set_style(style &ControlStyle) int { item := mut &v.control
    << item.set_style(style) or >> }
pub fn (v &mut SplitView) clear_style() { item := mut &v.control
    item.clear_style() }
pub fn (v &mut SplitView) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    v.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    << 0
}
pub fn (v &mut SplitView) apply_styles(styles &Styles) int {
    if v.density != styles.density { v.density = styles.density
        v.control.dirty = true }
    << 0
}
pub fn (v &mut SplitView) tick(styles &Styles,now time.Instant,reduced bool) bool {
    v.now = now
    v.reduced = reduced
    v.apply_styles(styles) or >>
    mut target := 0.0
    if v.is_enabled() && (v.control.hovered || v.control.focused || v.dragging) { target = 1.0 }
    spec := v.motion
    changed := range_tween_step(mut &v.hover,target,now,spec.hover,spec.curve,reduced) or >>
    if changed { v.control.dirty = true }
    << changed
}
pub fn (v &SplitView) next_tick(now time.Instant) time.Instant { << overlay_next_tick(v.hover.is_animating(),now) or >> }
pub fn (v &mut SplitView) dispose() { v.cancel()
    v.control.closed = true }
