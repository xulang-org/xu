@ui/widgets
#ui/draw
#ui/layout
#unicode/utf8
#math
#errors

// End ellipsis uses shaped cluster boundaries. The label retains its full text;
// callers can associate a Tooltip or render the full wrapped text on demand.
pub fn (label &mut StyledLabel) paint_ellipsized_styled(frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,state int) int {
    c := label.style_or(fallback)
    d := styles.density
    x := bounds.x + c.padding.left * d
    y := bounds.y + c.padding.top * d
    width := math.max(0.0,bounds.width - (c.padding.left + c.padding.right) * d)
    height := math.max(0.0,bounds.height - (c.padding.top + c.padding.bottom) * d)
    options := styles.text_options(&c)
    if label.dirty || label.layouts.len == 0 || label.ellipsis_width != width || !options_equal(&label.options,&options) {
        shaped := ellipsized_layout(&label.context,&label.value,&options,width) or >>
        label.dispose()
        label.layouts.push(shaped)
        label.options = copy_text_options(&options)
        label.ellipsis_width = width
        label.dirty = false
    }
    shaped := label.layouts[0]
    frame.push() or >>
    frame.clip_rect(x,y,width,height) or >>
    frame.text_layout(&shaped,x + math.max(0.0,width - shaped.metrics.width) * c.align_x,y + math.max(0.0,height - shaped.metrics.height) * c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}
fn ellipsized_layout(context &draw.Context,value &string,options &draw.TextOptions,width f64) draw.TextLayout {
    mut full := context.layout_text(value,options) or >>
    if full.metrics.width <= width { << full }
    result := fit_ellipsis(context,&full,value,options,width) or (err) { full.dispose() or (ignored) { >> err }
        >> err }
    full.dispose() or >>
    << result
}
fn fit_ellipsis(context &draw.Context,full &draw.TextLayout,value &string,options &draw.TextOptions,width f64) draw.TextLayout {
    mut low := 0
    mut high := value.len - 1
    mut best := 0
    while low <= high {
        middle := low + (high - low) / 2
        mut boundary := middle
        while boundary > 0 && !utf8.rune_start(value[boundary] & 255) { boundary -= 1 }
        edge := full.caret(boundary,false) or >>
        end := math.max(0.0,math.min(f64(value.len),f64(edge.index)))
        candidate := value[0:int(end)] + "…"
        mut measured := context.layout_text(&candidate,options) or >>
        fits := measured.metrics.width <= width
        measured.dispose() or >>
        if fits { best = int(math.max(f64(best),end))
            low = middle + 1 }
        else { high = middle - 1 }
    }
    display := value[0:best] + "…"
    << context.layout_text(&display,options) or >>
}
pub fn (s &mut Screen) set_label_ellipsis(id int,enabled bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_LABEL { >> errors.new("widgets: expected Label") }
    if enabled && s.basics.ellipsis_labels.has(id) { << 0 }
    if enabled { text := s.texts[id - 1] + ""
        s.basics.ellipsis_labels[id] = styled_label(&s.context,&text) }
    else { owner := mut &s.basics
        items := mut &owner.ellipsis_labels
        if items.has(id) { mut item := items.take(id)
            item.dispose() } }
    s.dirty = true
    << 0
}
fn (s &mut Screen) paint_label_ellipsis(id int,frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,style &ControlStyle) int {
    text := s.texts[id - 1] + ""
    owner := mut &s.basics
    items := mut &owner.ellipsis_labels
    mut label := items.take(id)
    label.set_text(&text)
    message := screen_paint_label_ellipsis(mut &label,frame,bounds,styles,style)
    items[id] = label
    if message.len > 0 { >> errors.new(message) }
    << 0
}
fn screen_paint_label_ellipsis(label &mut StyledLabel,frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,style &ControlStyle) string {
    label.paint_ellipsized_styled(frame,bounds,styles,style,0) or (err) { << err.msg() }
    << ""
}
