@ui/widgets

#ui/draw
#errors
#math
#time

pub struct ElevationStyle {
    pub level int
    pub offset_x f64
    pub offset_y f64
    pub spread f64
    pub radius f64
    pub color draw.Color
}

pub fn elevation(level int) ElevationStyle {
    $lv := level
    if lv < 0 { lv = 0 }
    if lv > 5 { lv = 5 }
    if lv == 0 {
        << ElevationStyle{level: 0,offset_x: 0.0,offset_y: 0.0,spread: 0.0,radius: 0.0,color: draw.rgba(15,23,42,0)}
    }
    << ElevationStyle{
        level: lv,
        offset_x: 0.0,
        offset_y: f64(lv) * 2.0,
        spread: f64(lv) * 2.0,
        radius: 8.0 + f64(lv),
        color: draw.rgba(15,23,42,18 + lv * 8)
    }
}

pub fn (e &ElevationStyle) validate() int {
    if e.level < 0 || e.level > 10 ||
       math.is_nan(e.offset_x) || math.is_inf(e.offset_x) || math.abs(e.offset_x) > 128.0 ||
       math.is_nan(e.offset_y) || math.is_inf(e.offset_y) || math.abs(e.offset_y) > 128.0 ||
       math.is_nan(e.spread) || math.is_inf(e.spread) || e.spread < 0.0 || e.spread > 128.0 ||
       math.is_nan(e.radius) || math.is_inf(e.radius) || e.radius < 0.0 || e.radius > 128.0 {
        >> errors.new("widgets: invalid elevation style")
    }
    << 0
}

fn copy_elevation_style(e &ElevationStyle) ElevationStyle {
    << ElevationStyle{
        level: e.level,
        offset_x: e.offset_x,
        offset_y: e.offset_y,
        spread: e.spread,
        radius: e.radius,
        color: e.color
    }
}

pub fn (s $&Screen) set_elevation(id int,level int) int {
    _ := s.node(id) >>>
    if level < 0 || level > 5 { >> errors.new("widgets: elevation level must be in 0..5") }
    if level == 0 { << s.clear_elevation(id) >>> }
    st := elevation(level)
    << s.set_elevation_style(id,&st) >>>
}

pub fn (s $&Screen) set_elevation_style(id int,style &ElevationStyle) int {
    _ := s.node(id) >>>
    style.validate() >>>
    if style.level == 0 && style.spread == 0.0 && style.offset_x == 0.0 && style.offset_y == 0.0 {
        << s.clear_elevation(id) >>>
    }
    comp := $&s.composition
    el := $&comp.elevations
    had := el.has(id)
    el[id] = copy_elevation_style(style)
    if !had { comp.elevation_count = comp.elevation_count + 1 }
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) clear_elevation(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.elevations.has(id) {
        el := $&comp.elevations
        el.delete(id)
        if comp.elevation_count > 0 { comp.elevation_count = comp.elevation_count - 1 }
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) node_elevation(id int) ElevationStyle {
    _ := s.node(id) >>>
    if s.composition.elevation_count > 0 && s.composition.elevations.has(id) {
        << copy_elevation_style(&s.composition.elevations[id])
    }
    << elevation(0)
}

fn (s &Screen) paint_node_elevation(id int,frame $&draw.Frame,opacity f64) int {
    if s.composition.elevation_count == 0 || !s.composition.elevations.has(id) { << 0 }
    st := s.composition.elevations[id]
    b := s.nodes[id - 1].bounds
    if b.width <= 0.0 || b.height <= 0.0 { << 0 }
    outer_col := st.color.with_opacity(opacity * 0.55)
    inner_col := st.color.with_opacity(opacity * 0.85)
    frame.fill_round_rect(
        b.x + st.offset_x - st.spread,
        b.y + st.offset_y - st.spread * 0.5,
        b.width + st.spread * 2.0,
        b.height + st.spread * 1.5,
        st.radius + st.spread * 0.5,
        outer_col
    ) >>>
    frame.fill_round_rect(
        b.x + st.offset_x * 0.5 - st.spread * 0.4,
        b.y + st.offset_y * 0.5 - st.spread * 0.2,
        b.width + st.spread * 0.8,
        b.height + st.spread * 0.6,
        st.radius,
        inner_col
    ) >>>
    << 0
}

pub struct SkeletonConfig {
    pub radius f64
    pub base_color draw.Color
    pub highlight_color draw.Color
    pub period_ms int
}

pub fn skeleton_config() SkeletonConfig {
    << SkeletonConfig{
        radius: 6.0,
        base_color: draw.rgb(226,232,240),
        highlight_color: draw.rgb(241,245,249),
        period_ms: 1200
    }
}

pub fn (c &SkeletonConfig) validate() int {
    if math.is_nan(c.radius) || math.is_inf(c.radius) || c.radius < 0.0 || c.radius > 256.0 ||
       c.period_ms < 200 || c.period_ms > 10000 {
        >> errors.new("widgets: invalid skeleton config")
    }
    << 0
}

fn copy_skeleton_config(c &SkeletonConfig) SkeletonConfig {
    << SkeletonConfig{
        radius: c.radius,
        base_color: c.base_color,
        highlight_color: c.highlight_color,
        period_ms: c.period_ms
    }
}

pub fn (s $&Screen) set_skeleton(id int,enabled bool) int {
    _ := s.node(id) >>>
    if !enabled {
        comp := $&s.composition
        if comp.skeletons.has(id) {
            sk := $&comp.skeletons
            sk.delete(id)
            if comp.skeleton_count > 0 { comp.skeleton_count = comp.skeleton_count - 1 }
            s.mark_paint_dirty()
        }
        << 0
    }
    cfg := skeleton_config()
    << s.set_skeleton_config(id,&cfg) >>>
}

pub fn (s $&Screen) set_skeleton_config(id int,cfg &SkeletonConfig) int {
    _ := s.node(id) >>>
    cfg.validate() >>>
    comp := $&s.composition
    sk := $&comp.skeletons
    had := sk.has(id)
    sk[id] = copy_skeleton_config(cfg)
    if !had { comp.skeleton_count = comp.skeleton_count + 1 }
    s.mark_paint_dirty()
    << 0
}

pub fn (s &Screen) is_skeleton(id int) bool {
    _ := s.node(id) >>>
    << s.is_skeleton_node(id)
}

fn (s &Screen) is_skeleton_node(id int) bool {
    << s.composition.skeleton_count > 0 && s.composition.skeletons.has(id)
}

fn (s &Screen) paint_node_skeleton(id int,frame $&draw.Frame,opacity f64) int {
    if !s.is_skeleton_node(id) { << 0 }
    cfg := s.composition.skeletons[id]
    b := s.nodes[id - 1].bounds
    if b.width <= 0.0 || b.height <= 0.0 { << 0 }
    col := draw.lerp_color(cfg.base_color,cfg.highlight_color,s.composition.skeleton_phase).with_opacity(opacity)
    frame.fill_round_rect(b.x,b.y,b.width,b.height,cfg.radius,col) >>>
    << 0
}

fn (s $&Screen) advance_skeletons(now time.Instant) time.Instant {
    if s.composition.skeleton_count == 0 || s.reduced { << time.zero_instant() }
    ns := now.nanoseconds()
    if ns <= 0 { << time.zero_instant() }
    period_ns := 1200000000
    phase_u := f64(ns % period_ns) / f64(period_ns)
    pulse := 0.5 - 0.5 * math.cos(phase_u * 6.283185307179586)
    comp := $&s.composition
    comp.skeleton_phase = pulse
    s.mark_paint_dirty()
    next_step := now.add(time.milliseconds(33) >>>) >>>
    << next_step
}

fn (s $&Screen) cleanup_effects_for(id int) {
    comp := $&s.composition
    if comp.elevations.has(id) {
        el := $&comp.elevations
        el.delete(id)
        if comp.elevation_count > 0 { comp.elevation_count = comp.elevation_count - 1 }
    }
    if comp.skeletons.has(id) {
        sk := $&comp.skeletons
        sk.delete(id)
        if comp.skeleton_count > 0 { comp.skeleton_count = comp.skeleton_count - 1 }
    }
}
