@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#unicode/utf8

// The last item is the current location; earlier items activate navigation.
// Long paths are clipped consistently with hit testing, not silently wrapped.
pub struct Breadcrumbs {
    control Button
    items []string
    widths []f64
    labels TextCache
    active int
    hot int
    armed int
    gap f64
    height f64
    extent f64
    collapsed bool
    first_visible int
    overflow_armed bool
    history ChoiceList
}
pub fn breadcrumbs(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,items &[]string) Breadcrumbs {
    if !context.matches_canvas(identity) { >> errors.new("widgets: breadcrumb context mismatch") }
    if items.len < 1 || items.len > 32 { >> errors.new("widgets: breadcrumb path must contain 1..32 items") }
    mut values := []string{}
    for item in items {
        if item.len > 4096 || !utf8.valid(&item) { >> errors.new("widgets: invalid breadcrumb text") }
        values.push(item + "")
    }
    control := button(identity,id,bounds) or >>
    labels := text_cache(context)
    history := choice_list(context,identity,bounds,items) or >>
    << Breadcrumbs{control: control,items: values,widths: []f64{},labels: labels,active: 0,hot: -1,armed: -1,gap: 18.0,height: 32.0,extent: 0.0,collapsed: false,first_visible: 0,overflow_armed: false,history: history}
}
pub fn (crumbs &Breadcrumbs) id() int { << crumbs.control.id }
pub fn (crumbs &Breadcrumbs) bounds() layout.Rect { << crumbs.control.bounds() }
pub fn (crumbs &Breadcrumbs) count() int { << crumbs.items.len }
pub fn (crumbs &Breadcrumbs) needs_paint() bool { << crumbs.control.dirty }
pub fn (crumbs &Breadcrumbs) visual_state() int { << crumbs.control.visual_state() }
pub fn (crumbs &Breadcrumbs) style_or(styles &Styles) ControlStyle {
    if crumbs.control.has_style() { << crumbs.control.style_or(styles) }
    << styles.button.clone()
}
pub fn (crumbs &mut Breadcrumbs) set_style(style &ControlStyle) int {
    control := mut &crumbs.control
    << control.set_style(style) or >>
}
pub fn (crumbs &mut Breadcrumbs) set_enabled(enabled bool) {
    control := mut &crumbs.control
    control.set_enabled(enabled)
    if !enabled { crumbs.armed = -1
        crumbs.hot = -1 }
}
pub fn (crumbs &mut Breadcrumbs) set_read_only(read_only bool) int {
    if crumbs.control.closed { >> errors.new("widgets: breadcrumbs disposed") }
    control := mut &crumbs.control
    control.set_read_only(read_only)
    crumbs.armed = -1
    << 0
}
pub fn (crumbs &mut Breadcrumbs) set_bounds(bounds &layout.Rect) int {
    old := crumbs.bounds()
    control := mut &crumbs.control
    control.set_bounds(bounds) or >>
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height { crumbs.armed = -1 }
    << 0
}
pub fn (crumbs &mut Breadcrumbs) set_focus(focused bool) {
    control := mut &crumbs.control
    control.set_focus(focused)
    if !focused { crumbs.armed = -1
        crumbs.history.open=false
        crumbs.overflow_armed=false }
}
pub fn (crumbs &mut Breadcrumbs) set_text(index int,text &string) int {
    if index < 0 || index >= crumbs.items.len || text.len > 4096 || !utf8.valid(text) { >> errors.new("widgets: invalid breadcrumb text/index") }
    crumbs.items[index] = text + ""
    crumbs.widths = []f64{}
    crumbs.armed = -1
    crumbs.control.dirty = true
    << 0
}
pub fn (crumbs &mut Breadcrumbs) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := crumbs.style_or(styles)
    mut widths := []f64{}
    mut extent := 0.0
    mut height := c.min_height * styles.density
    for i in 0:crumbs.items.len {
        value := crumbs.items[i] + ""
        labels := mut &crumbs.labels
        size := labels.measure(i,&value,styles,&c) or >>
        width := size.width + 12.0 * styles.density
        widths.push(width)
        extent = extent + width
        height = math.max(height,size.height + 8.0 * styles.density)
    }
    gap := 18.0 * styles.density
    extent = extent + f64(crumbs.items.len - 1) * gap
    if extent != crumbs.extent || height != crumbs.height || gap != crumbs.gap { crumbs.control.dirty = true
        crumbs.armed = -1 }
    crumbs.widths = widths
    crumbs.extent = extent
    crumbs.height = height
    crumbs.gap = gap
    crumbs.update_overflow(styles,&c) or >>
    << 0
}
pub fn (crumbs &mut Breadcrumbs) measure_styled(styles &Styles) layout.Size {
    crumbs.apply_styles(styles) or >>
    << layout.Size{width: crumbs.extent,height: crumbs.height}
}
pub fn (crumbs &Breadcrumbs) item_bounds(index int) layout.Rect {
    if index < 0 || index >= crumbs.items.len || crumbs.widths.len != crumbs.items.len { >> errors.new("widgets: breadcrumb styles not applied or index out of range") }
    b := crumbs.bounds()
    mut x := b.x
    mut width := crumbs.widths[index]
    if crumbs.collapsed {
        root_width := math.min(crumbs.widths[0],b.width*0.25)
        if index == 0 { width=root_width }
        else if index < crumbs.first_visible { << layout.Rect{x:b.x,y:b.y,width:0.0,height:b.height} }
        else { x = x+root_width+crumbs.gap*2.0+28.0
            for i in crumbs.first_visible:index { x=x+crumbs.widths[i]+crumbs.gap }
            width=math.min(width,math.max(0.0,b.x+b.width-x)) }
    } else { for i in 0:index { x=x+crumbs.widths[i]+crumbs.gap } }
    << layout.Rect{x:x,y:b.y,width:width,height:b.height}
}
fn (crumbs &Breadcrumbs) hit(x f64,y f64) int {
    if !crumbs.bounds().contains(x,y) || crumbs.widths.len != crumbs.items.len { << -1 }
    if crumbs.collapsed && crumbs.overflow_bounds().contains(x,y) { << -2 }
    for i in 0:crumbs.items.len - 1 { rect := crumbs.item_bounds(i) or >>
        if rect.contains(x,y) { << i } }
    << -1
}
pub fn (crumbs &Breadcrumbs) cursor_at(x f64,y f64) int {
    hit := crumbs.hit(x,y) or >>
    if crumbs.control.is_enabled() && !crumbs.control.read_only && hit != -1 { << ui.CURSOR_HAND }
    << ui.CURSOR_DEFAULT
}
pub fn (crumbs &mut Breadcrumbs) input(event &ui.InputEvent) Action {
    if !belongs(&crumbs.control.identity,event) || !crumbs.control.is_enabled() { << no_action(crumbs.id(),false) }
    if crumbs.history.open {
        focused := crumbs.control.focused
        id := crumbs.id()
        history := mut &crumbs.history
        mut action := history.input(id,event,focused,false) or >>
        if action.kind == ACTION_CHANGE { action.kind=ACTION_ACTIVATE
            crumbs.active=int(action.value)
            crumbs.history.open=false
            << action }
        if action.consumed { << action }
    }
    overflow_hit := crumbs.collapsed && crumbs.overflow_bounds().contains(event.x,event.y)
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && overflow_hit { crumbs.overflow_armed=true
        << Action{kind:ACTION_NONE,id:crumbs.id(),needs_paint:true,request_focus:true,consumed:true,value:0.0} }
    if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && crumbs.overflow_armed {
        crumbs.overflow_armed=false
        if overflow_hit { history := mut &crumbs.history
            history.set_open(true) }
        << Action{kind:ACTION_NONE,id:crumbs.id(),needs_paint:true,request_focus:false,consumed:true,value:0.0} }
    if event.kind == ui.EV_POINTER_CANCEL { crumbs.overflow_armed=false
        crumbs.history.open=false
        crumbs.set_focus(false)
        crumbs.hot = -1
        << no_action(crumbs.id(),true) }
    hit := crumbs.hit(event.x,event.y) or >>
    mut activate := -1
    mut consumed := false
    mut focus := false
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_LEAVE {
        mut hot := hit
        if event.kind == ui.EV_POINTER_LEAVE { hot = -1 }
        if hot != crumbs.hot { crumbs.hot = hot
            crumbs.control.dirty = true }
    } else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && hit >= 0 {
        if !crumbs.control.read_only { crumbs.armed = hit }
        crumbs.active = hit
        crumbs.control.dirty = true
        focus = true
        consumed = true
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && crumbs.armed >= 0 {
        if hit == crumbs.armed && !crumbs.control.read_only { activate = hit }
        crumbs.armed = -1
        crumbs.control.dirty = true
        consumed = true
    } else if event.kind == ui.EV_KEY_DOWN && crumbs.control.focused && crumbs.items.len > 1 {
        consumed = true
        if event.key == ui.KEY_LEFT || event.key == ui.KEY_UP { if crumbs.active > 0 { crumbs.active = crumbs.active - 1 } }
        else if event.key == ui.KEY_RIGHT || event.key == ui.KEY_DOWN { if crumbs.active < crumbs.items.len - 2 { crumbs.active = crumbs.active + 1 } }
        else if event.key == ui.KEY_HOME { crumbs.active = 0 }
        else if event.key == ui.KEY_END { crumbs.active = crumbs.items.len - 2 }
        else if (event.key == ui.KEY_ENTER || event.key == 32) && !crumbs.control.read_only { activate = crumbs.active }
        else { consumed = false }
        if consumed { crumbs.control.dirty = true
            if crumbs.collapsed && crumbs.active > 0 && crumbs.active < crumbs.first_visible {
                crumbs.history.cursor=crumbs.active
                history := mut &crumbs.history
                history.set_open(true)
                history.reveal() } }
    }
    mut kind := ACTION_NONE
    if activate >= 0 { kind = ACTION_ACTIVATE }
    << Action{kind: kind,id: crumbs.id(),needs_paint: crumbs.needs_paint(),request_focus: focus,consumed: consumed,value: f64(activate)}
}
pub fn (crumbs &mut Breadcrumbs) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid breadcrumb route") }
    if kind == ROUTE_FOCUS { crumbs.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { crumbs.set_focus(false)
        crumbs.hot = -1 }
    else { << crumbs.input(event) or >> }
    << no_action(crumbs.id(),crumbs.needs_paint())
}
pub fn (crumbs &mut Breadcrumbs) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    if crumbs.control.closed { >> errors.new("widgets: breadcrumbs disposed") }
    crumbs.apply_styles(styles) or >>
    mut c := crumbs.style_or(styles)
    c.padding = layout.insets(0.0) or >>
    c.align_x = 0.5
    c.align_y = 0.5
    c.shadow = c.shadow.with_alpha(0)
    b := crumbs.bounds()
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    for i in 0:crumbs.items.len {
        rect := crumbs.item_bounds(i) or >>
        if rect.width <= 0.0 { -> }
        mut state := 0
        if !crumbs.control.is_enabled() { state = STATE_DISABLED }
        else if crumbs.control.read_only { state = STATE_READ_ONLY }
        else if i < crumbs.items.len - 1 {
            if crumbs.hot == i { state = state | STATE_HOVERED
                rounded_fill(frame,&rect,c.radius * styles.density,c.resolve(state).background) or >> }
            if crumbs.control.focused && crumbs.active == i { state = state | STATE_FOCUSED
                frame.stroke_rect(rect.x + 1.0,rect.y + 1.0,math.max(0.0,rect.width - 2.0),math.max(0.0,rect.height - 2.0),c.palette.focus,1.5) or >> }
        }
        mut ink := c.clone()
        ink.states = []StatePaint{}
        if i < crumbs.items.len - 1 { ink.palette.foreground = c.palette.accent }
        value := crumbs.items[i] + ""
        labels := mut &crumbs.labels
        labels.paint_text(i,&value,frame,&rect,styles,&ink,state) or >>
        if i < crumbs.items.len - 1 {
            x := rect.x + rect.width + crumbs.gap * 0.5
            y := rect.y + rect.height * 0.5
            frame.line(x - 2.0,y - 4.0,x + 2.0,y,c.palette.muted,1.5) or >>
            frame.line(x + 2.0,y,x - 2.0,y + 4.0,c.palette.muted,1.5) or >>
        }
    }
    crumbs.paint_overflow(frame,styles,&c) or >>
    frame.pop() or >>
    crumbs.control.dirty = false
    << 0
}
pub fn (crumbs &mut Breadcrumbs) dispose() {
    labels := mut &crumbs.labels
    labels.dispose()
    history := mut &crumbs.history
    cache := mut &history.labels
    cache.dispose()
    crumbs.control.closed = true
}
