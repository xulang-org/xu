@ui/widgets

#ui/draw
#ui/layout
#math
#errors

// Paint in local coordinates, matching Editor and View. The Editor still
// retains its canvas-global bounds for the native text session.
pub fn (f &mut Field) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    f.apply_styles(styles) or (err) { >> errors.new("widgets: field layout: " + err.msg()) }
    base := f.style_or(styles)
    state := f.editor.visual_state()
    now := f.now
    reduced := f.motion_reduced()
    mut motion := f.paint_motion
    mut c := motion.style(&base,state,now,reduced) or >>
    f.paint_motion = motion
    d := styles.density
    mut box := copy_rect(&f.box)
    box.x = box.x - f.outer.x
    box.y = box.y - f.outer.y
    mut label_progress := f.label_motion.value()
    if !f.layout_ready() && (f.editor.focused || f.editor.value.len > 0 || f.decoration.floating == LABEL_ALWAYS || f.decoration.floating == LABEL_STATIC) { label_progress = 1.0 }
    paint := c.resolve(state)
    if f.decoration.variant == FIELD_OUTLINED {
        c.palette.normal = styles.background
        c.palette.hovered = styles.background
        c.palette.read_only = styles.background
        c.focus_width = 0.0
        style_box(frame,&box,&c,d,state) or >>
        if (state & STATE_FOCUSED) != 0 && (state & STATE_DISABLED) == 0 {
            mut color := paint.focus
            if (state & STATE_INVALID) != 0 { color = c.palette.invalid }
            rounded_stroke(frame,&box,c.radius * d,color,math.max(c.border_width,c.focus_width + 1.5) * d) or >>
        }
    } else {
        if f.decoration.variant == FIELD_FILLED { rounded_fill(frame,&box,c.radius * d,paint.background) or >> }
        mut color := paint.border
        mut width := c.border_width * d
        if (state & STATE_FOCUSED) != 0 { color = paint.focus
            width = math.max(width,2.0 * d) }
        if (state & STATE_INVALID) != 0 { color = c.palette.invalid }
        frame.line(box.x,box.y + box.height - width * 0.5,box.x + box.width,box.y + box.height - width * 0.5,color,width) or >>
    }
    frame.push() or >>
    frame.translate(f.editor.bounds.x - f.outer.x,f.editor.bounds.y - f.outer.y) or >>
    editor := mut &f.editor
    editor.paint_styled(frame,styles) or (err) { >> errors.new("widgets: field text paint: " + err.msg()) }
    frame.pop() or >>
    mut label_style := c.clone()
    label_style.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    label_style.align_x = 0.0
    label_style.states = []StatePaint{}
    label_style.palette.foreground = c.palette.muted
    if (state & STATE_FOCUSED) != 0 { label_style.palette.foreground = c.palette.foreground }
    if (state & STATE_INVALID) != 0 { label_style.palette.foreground = c.palette.invalid }
    if (state & STATE_DISABLED) != 0 { label_style.palette.foreground = c.palette.muted }
    show_label := f.decoration.label.len > 0 && !(f.decoration.floating == LABEL_NEVER && f.editor.value.len > 0)
    if show_label {
        label := f.decoration.label + ""
        floating := f.decoration.floating
        prefix_width := f.prefix_width
        variant := f.decoration.variant
        cache := mut &f.labels
        size := cache.measure(0,&label,styles,&label_style) or >>
        scale := 1.0 - 0.15 * label_progress
        mut x := box.x + 12.0 * d
        mut y := box.y + (box.height - size.height) * 0.5
        if floating == LABEL_STATIC { y = box.y - size.height - 6.0 * d }
        else { y = y + (box.y - size.height * 0.425 - y) * label_progress }
        if floating == LABEL_NEVER { label_progress = 0.0 }
        x = x + prefix_width * (1.0 - label_progress)
        if variant == FIELD_OUTLINED && label_progress > 0.0 && floating != LABEL_STATIC {
            notch := layout.Rect{x: x - 3.0 * d,y: box.y - size.height * 0.5,
                width: math.min(math.max(0.0,box.width - 18.0 * d),size.width * scale + 6.0 * d),height: size.height}
            frame.fill_rect(notch.x,notch.y,notch.width,notch.height,styles.background) or >>
        }
        frame.push() or >>
        frame.clip_rect(box.x,math.max(0.0,y),box.width,math.max(size.height,box.height)) or >>
        frame.translate(x,y) or >>
        frame.scale(scale,scale) or >>
        shaped := cache.layout_at(0) or >>
        frame.text_layout(&shaped,0.0,0.0,label_style.palette.foreground) or >>
        frame.pop() or >>
    }
    mut affix := c.clone()
    affix.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    affix.align_x = 0.0
    affix.palette.foreground = c.palette.muted
    affix.states = []StatePaint{}
    if f.decoration.prefix.len > 0 && (label_progress > 0.5 || !show_label) {
        rect := layout.Rect{x: box.x + 12.0 * d,y: box.y,width: f.prefix_width,height: box.height}
        prefix := f.decoration.prefix + ""
        cache := mut &f.labels
        cache.paint_text(1,&prefix,frame,&rect,styles,&affix,0) or >>
    }
    if f.decoration.suffix.len > 0 {
        rect := layout.Rect{x: f.editor.bounds.x - f.outer.x + f.editor.bounds.width + 8.0 * d,y: box.y,width: f.suffix_width,height: box.height}
        suffix := f.decoration.suffix + ""
        cache := mut &f.labels
        cache.paint_text(2,&suffix,frame,&rect,styles,&affix,0) or >>
    }
    if f.can_clear() {
        r := f.clear.bounds()
        x := r.x - f.outer.x + r.width * 0.5
        y := r.y - f.outer.y + r.height * 0.5
        frame.line(x - 3.0 * d,y - 3.0 * d,x + 3.0 * d,y + 3.0 * d,c.palette.muted,1.5 * d) or >>
        frame.line(x + 3.0 * d,y - 3.0 * d,x - 3.0 * d,y + 3.0 * d,c.palette.muted,1.5 * d) or >>
    }
    mut helper := f.decoration.helper + ""
    mut support := f.supporting_style(styles,&c)
    if f.editor.invalid && f.decoration.error.len > 0 { helper = f.decoration.error + ""
        support.palette.foreground = c.palette.invalid }
    mut counter_width := 0.0
    if f.has_counter() {
        value := f.counter_text()
        cache := mut &f.labels
        measured := cache.measure(5,&value,styles,&support) or >>
        counter_width = measured.width * 0.85 + 12.0 * d
        mut counter_style := support.clone()
        counter_style.align_x = 1.0
        if f.is_over_limit() { counter_style.palette.foreground = c.palette.invalid }
        area := layout.Rect{x: box.x + math.max(12.0 * d,box.width - counter_width - 12.0 * d),y: box.y + box.height + 4.0 * d,
            width: math.max(0.0,math.min(counter_width,box.width - 24.0 * d)),height: math.max(0.0,f.helper_height - 4.0 * d)}
        frame.push() or >>
        frame.translate(area.x,area.y) or >>
        frame.scale(0.85,0.85) or >>
        scaled := layout.Rect{x: 0.0,y: 0.0,width: area.width / 0.85,height: area.height / 0.85}
        labels := mut &f.labels
        labels.paint_text(5,&value,frame,&scaled,styles,&counter_style,0) or >>
        frame.pop() or >>
    }
    if helper.len > 0 {
        rect := layout.Rect{x: box.x + 12.0 * d,y: box.y + box.height + 4.0 * d,
            width: math.max(0.0,box.width - 24.0 * d - counter_width),height: math.max(0.0,f.helper_height - 4.0 * d)}
        frame.push() or >>
        frame.translate(rect.x,rect.y) or >>
        frame.scale(0.85,0.85) or >>
        scaled := layout.Rect{x: 0.0,y: 0.0,width: rect.width / 0.85,height: rect.height / 0.85}
        cache := mut &f.labels
        cache.paint_text(4,&helper,frame,&scaled,styles,&support,0) or >>
        frame.pop() or >>
    }
    << 0
}
