@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

pub const FIELD_OUTLINED = 0
pub const FIELD_FILLED = 1
pub const FIELD_UNDERLINED = 2
pub const LABEL_AUTO = 0
pub const LABEL_ALWAYS = 1
pub const LABEL_NEVER = 2
pub const LABEL_STATIC = 3

pub struct FieldDecoration {
    pub label string
    pub helper string
    pub error string
    pub prefix string
    pub suffix string
    pub variant int
    pub floating int
    pub clearable bool
    pub reserve_helper bool
}
pub fn field_decoration(label &string) FieldDecoration {
    << FieldDecoration{label: label + "",helper: "",error: "",prefix: "",suffix: "",variant: FIELD_OUTLINED,
        floating: LABEL_AUTO,clearable: false,reserve_helper: true}
}
pub fn (d &FieldDecoration) validate() int {
    validate_table_text(&d.label) or >>
    validate_table_text(&d.helper) or >>
    validate_table_text(&d.error) or >>
    validate_table_text(&d.prefix) or >>
    validate_table_text(&d.suffix) or >>
    if d.variant < FIELD_OUTLINED || d.variant > FIELD_UNDERLINED || d.floating < LABEL_AUTO || d.floating > LABEL_STATIC {
        >> errors.new("widgets: invalid field decoration")
    }
    << 0
}
fn copy_decoration(d &FieldDecoration) FieldDecoration {
    << FieldDecoration{label: d.label + "",helper: d.helper + "",error: d.error + "",prefix: d.prefix + "",suffix: d.suffix + "",
        variant: d.variant,floating: d.floating,clearable: d.clearable,reserve_helper: d.reserve_helper}
}

// The decorator owns an ordinary Editor. Its content geometry is independent
// of label animation, preserving selection, native IME and candidate placement.
pub struct Field {
    locale Locale
    editor Editor
    outer layout.Rect
    box layout.Rect
    clear Button
    decoration FieldDecoration
    labels TextCache
    custom string
    last_style string
    label_motion Tween
    paint_motion PaintTransition
    motion MotionSpec
    now time.Instant
    text_flags int
    helper_height f64
    prefix_width f64
    suffix_width f64
}
fn new_field(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string,decoration &FieldDecoration,multiline bool) Field {
    decoration.validate() or >>
    editor := new_editor(context,identity,id,bounds,value,multiline) or >>
    clear := button(identity,id,bounds) or >>
    outer := copy_rect(bounds)
    box := copy_rect(bounds)
    decoration_copy := copy_decoration(decoration)
    labels := text_cache(context)
    label_motion := tween(0.0) or >>
    paint_motion := paint_transition()
    motion := motion_spec()
    now := time.zero_instant()
    << Field{locale: locale_default(),editor: editor,outer: outer,box: box,clear: clear,decoration: decoration_copy,
        labels: labels,custom: "",last_style: "",
        label_motion: label_motion,paint_motion: paint_motion,motion: motion,now: now,
        text_flags: 1 << 42,helper_height: 0.0,prefix_width: 0.0,suffix_width: 0.0}
}
pub fn field(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string,decoration &FieldDecoration) Field {
    << new_field(context,identity,id,bounds,value,decoration,false) or >>
}
pub fn text_field_area(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string,decoration &FieldDecoration) Field {
    << new_field(context,identity,id,bounds,value,decoration,true) or >>
}
pub fn (f &Field) id() int { << f.editor.id }
pub fn (f &Field) bounds() layout.Rect { << copy_rect(&f.outer) }
pub fn (f &Field) value() string { << f.editor.value() }
pub fn (f &Field) is_enabled() bool { << f.editor.is_enabled() }
pub fn (f &Field) is_focused() bool { << f.editor.focused }
pub fn (f &Field) is_read_only() bool { << f.editor.read_only }
pub fn (f &Field) is_invalid() bool { << f.editor.invalid }
pub fn (f &Field) needs_paint() bool { << f.local_dirty() || f.editor.dirty || f.clear.dirty }
pub fn (f $&Field) painted() { f.mark_dirty(false)
    f.editor.dirty = false
    f.clear.dirty = false }
pub fn (f &Field) style_or(styles &Styles) ControlStyle {
    if f.custom.len > 0 { << decode_control_style(&f.custom,&styles.input) }
    if f.editor.is_multiline() { << styles.text_area.clone() }
    << styles.input.clone()
}
pub fn (f $&Field) set_style(style &ControlStyle) int {
    style.validate() or >>
    f.custom = encode_control_style(style)
    f.mark_dirty(true)
    << 0
}
pub fn (f $&Field) set_decoration(decoration &FieldDecoration) int {
    decoration.validate() or >>
    f.decoration = copy_decoration(decoration)
    f.clear.pointer_armed = false
    f.mark_dirty(true)
    << 0
}
pub fn (f $&Field) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    f.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    $paint := f.paint_motion
    paint.set_spec(spec) or >>
    f.paint_motion = paint
    << 0
}
pub fn (f $&Field) set_invalid(invalid bool) { editor := $&f.editor
    editor.set_invalid(invalid) }
pub fn (f $&Field) set_value(value &string) int { editor := $&f.editor
    << editor.set_value(value) or >> }
pub fn (f $&Field) set_read_only(read_only bool) int { editor := $&f.editor
    << editor.set_read_only(read_only) or >> }
pub fn (f $&Field) focus_session(focused bool) int { editor := $&f.editor
    << editor.focus_session(focused) or >> }
pub fn (f $&Field) enable(enabled bool) int { f.clear.enabled = enabled
    editor := $&f.editor
    << editor.enable(enabled) or >> }
pub fn (f $&Field) place(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if !overlay_same_rect(&f.outer,bounds) { f.outer = copy_rect(bounds)
        f.clear.pointer_armed = false
        f.mark_dirty(true) }
    << 0
}
fn (f &Field) supporting_style(styles &Styles,c &ControlStyle) ControlStyle {
    $text := c.clone()
    text.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    text.align_x = 0.0
    text.align_y = 0.5
    text.palette.foreground = c.palette.muted
    text.states = []StatePaint{}
    << text
}
pub fn (f $&Field) apply_styles(styles &Styles) int {
    styles.validate() or >>
    if f.editor.closed { >> errors.new("widgets: field is disposed") }
    c := f.style_or(styles)
    d := styles.density
    support := f.supporting_style(styles,&c)
    cache := $&f.labels
    sample := cache.measure(3,&"Ag国",styles,&support) or (err) { >> errors.new("widgets: field supporting text: " + err.msg()) }
    $helper_height := 0.0
    if f.decoration.reserve_helper || f.decoration.helper.len > 0 || f.decoration.error.len > 0 || f.has_counter() { helper_height = sample.height * 0.85 + 6.0 * d }
    $static_height := 0.0
    if f.decoration.label.len > 0 { static_height = 8.0 * d }
    if f.decoration.floating == LABEL_STATIC && f.decoration.label.len > 0 { static_height = sample.height + 6.0 * d }
    f.helper_height = helper_height
    f.box = layout.Rect{x: f.outer.x,y: f.outer.y + static_height,width: f.outer.width,
        height: math.max(0.0,f.outer.height - static_height - helper_height)}
    $prefix_width := 0.0
    $suffix_width := 0.0
    if f.decoration.prefix.len > 0 { prefix := f.decoration.prefix + ""
        labels := $&f.labels
        size := labels.measure(1,&prefix,styles,&c) or >>
        prefix_width = size.width + 8.0 * d }
    if f.decoration.suffix.len > 0 { suffix := f.decoration.suffix + ""
        labels := $&f.labels
        size := labels.measure(2,&suffix,styles,&c) or >>
        suffix_width = size.width + 8.0 * d }
    f.prefix_width = prefix_width
    f.suffix_width = suffix_width
    clear_width := 0.0 + 32.0 * d
    clear_bounds := layout.Rect{x: f.box.x + math.max(0.0,f.box.width - clear_width - 4.0 * d),y: f.box.y,
        width: math.min(clear_width,f.box.width),height: f.box.height}
    clear := $&f.clear
    clear.set_bounds(&clear_bounds) or >>
    $trailing := 0.0
    if f.decoration.clearable { trailing = clear_width }
    $inner := c.clone()
    inner.border_width = 0.0
    inner.focus_width = 0.0
    inner.shadow = draw.rgba(0,0,0,0)
    inner.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    inner.palette.normal = draw.rgba(0,0,0,0)
    inner.palette.hovered = draw.rgba(0,0,0,0)
    inner.palette.read_only = draw.rgba(0,0,0,0)
    inner.palette.invalid_fill = draw.rgba(0,0,0,0)
    inner.palette.disabled = draw.rgba(0,0,0,0)
    inner.states = []StatePaint{}
    content := layout.Rect{x: f.box.x + 12.0 * d + prefix_width,y: f.box.y + 8.0 * d,
        width: math.max(0.0,f.box.width - 24.0 * d - prefix_width - suffix_width - trailing),height: math.max(0.0,f.box.height - 16.0 * d)}
    editor := $&f.editor
    editor.apply_styles(styles) or >>
    next_editor := $&f.editor
    next_editor.set_style(&inner) or >>
    placed_editor := $&f.editor
    placed_editor.place(&content) or >>
    encoded := encode_control_style(&c)
    if f.last_style != encoded { f.mark_dirty(true) }
    f.last_style = encoded
    << 0
}
fn (f &Field) can_clear() bool {
    << f.decoration.clearable && f.editor.value.len > 0 && f.editor.enabled && !f.editor.closed && !f.editor.read_only && !f.editor.composing
}
// Like Editor.route, pointer coordinates are local to bounds(); input() offers
// the canvas-coordinate entry point used by Screen and immediate applications.
pub fn (f $&Field) input(input &ui.InputEvent) Action {
    $local := choice_copy_input(input)
    local.x = local.x - f.outer.x
    local.y = local.y - f.outer.y
    << f.route(ROUTE_INPUT,&local) or >>
}
pub fn (f $&Field) route(kind int,event &ui.InputEvent) Action {
    if !belongs(&f.editor.identity,event) || f.editor.closed { << no_action(f.id(),f.needs_paint()) }
    if kind != ROUTE_INPUT {
        if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { clear := $&f.clear
            clear.cancel() }
        editor := $&f.editor
        << editor.route(kind,event) or >>
    }
    if f.can_clear() {
        $global := choice_copy_input(event)
        global.x = event.x + f.outer.x
        global.y = event.y + f.outer.y
        clear := $&f.clear
        action := clear.input(&global) or >>
        if action.kind == ACTION_ACTIVATE {
            editor := $&f.editor
            editor.set_value(&"") or >>
            editor.focus_session(true) or >>
            f.mark_dirty(true)
            << Action{kind: ACTION_CHANGE,id: f.id(),needs_paint: true,request_focus: true,consumed: true,value: 0.0}
        }
        if action.consumed { << action }
    }
    $local := choice_copy_input(event)
    local.x = event.x + f.outer.x - f.editor.bounds.x
    local.y = event.y + f.outer.y - f.editor.bounds.y
    if event.kind == ui.EV_POINTER_DOWN {
        x := event.x + f.outer.x
        y := event.y + f.outer.y
        if !f.box.contains(x,y) { << no_action(f.id(),f.needs_paint()) }
    }
    editor := $&f.editor
    << editor.route(kind,&local) or >>
}
pub fn (f $&Field) event(event &ui.Event) Action {
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << f.input(&input) or >> }
    editor := $&f.editor
    action := editor.event(event) or >>
    if f.editor.closed { f.dispose() }
    << action
}
pub fn (f $&Field) tick(now time.Instant,reduced bool) bool {
    f.now = now
    f.set_motion_reduced(reduced)
    if f.last_style.len == 0 { << false }
    $target := 0.0
    if f.editor.focused || f.editor.value.len > 0 || f.decoration.floating == LABEL_ALWAYS || f.decoration.floating == LABEL_STATIC { target = 1.0 }
    if f.decoration.floating == LABEL_NEVER { target = 0.0 }
    duration := f.motion.change
    curve := f.motion.curve
    snap := reduced || !f.layout_ready() || f.decoration.floating == LABEL_STATIC
    label := $&f.label_motion
    before := label.value()
    label.set_curve(curve) or (err) { >> errors.new("widgets: field label: " + err.msg()) }
    label.retarget(target,now,duration,snap) or >>
    _ := label.advance(now) or >>
    $changed := before != label.value()
    f.mark_ready()
    fallback := dark_styles()
    c := decode_control_style(&f.last_style,&fallback.input)
    state := f.editor.visual_state()
    $paint := f.paint_motion
    _ := paint.style(&c,state,now,reduced) or >>
    if paint.is_animating() { changed = true }
    f.paint_motion = paint
    editor := $&f.editor
    if editor.tick(now,reduced) or >> { changed = true }
    if changed { f.mark_dirty(true) }
    << changed
}
pub fn (f &Field) next_caret_tick(now time.Instant,reduced bool) time.Instant {
    if f.editor.closed { << time.zero_instant() }
    $deadline := f.editor.next_caret_tick(now,reduced) or >>
    if f.label_motion.is_animating() || f.paint_motion.is_animating() { deadline = screen_earlier(deadline,overlay_next_tick(true,now) or >>) }
    << deadline
}
pub fn (f $&Field) measure_styled(styles &Styles) layout.Size {
    f.apply_styles(styles) or >>
    c := f.style_or(styles)
    editor := $&f.editor
    size := editor.measure_styled(styles) or >>
    options := f.text_options()
    $body_height := size.height
    if f.editor.is_multiline() && options.min_rows > 0 { body_height = f64(f.preferred_rows()) * styles.text_options(&c).size * 1.4 }
    $static_height := 0.0
    if f.decoration.floating == LABEL_STATIC { static_height = f.helper_height }
    << layout.Size{width: math.max(c.min_width * styles.density,size.width + f.prefix_width + f.suffix_width + 24.0 * styles.density),
        height: math.max(48.0 * styles.density,body_height + 16.0 * styles.density) + f.helper_height + static_height}
}
pub fn (f $&Field) dispose() {
    editor := $&f.editor
    editor.dispose()
    labels := $&f.labels
    labels.dispose()
    f.clear.closed = true
}
