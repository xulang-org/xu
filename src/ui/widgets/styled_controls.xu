@ui/widgets

#ui/draw
#ui/layout
#errors
#math

pub fn (button &Button) visual_state() int {
    mut state := 0
    if button.invalid { state = state | state_invalid }
    if button.selected { state = state | state_selected }
    if !button.is_enabled() { state = state | state_disabled }
    if button.hovered { state = state | state_hovered }
    if (button.pointer_armed && button.hovered) || button.keyboard_armed != 0 { state = state | state_pressed }
    if button.focused { state = state | state_focused }
    << state
}
pub fn (button &Button) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := styles.button.clone()
    size := label.measure_styled(styles,&c) or >>
    << layout.Size{width: math.max(c.min_width * styles.density,size.width + (c.padding.left + c.padding.right) * styles.density),
        height: math.max(c.min_height * styles.density,size.height + (c.padding.top + c.padding.bottom) * styles.density)}
}
pub fn (button &Button) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    c := styles.button.clone()
    _ := label.measure_styled(styles,&c) or >>
    state := button.visual_state()
    style_box(frame,&button.bounds,&c,styles.density,state) or >>
    shaped := label.layouts[0]
    b := button.bounds
    left := c.padding.left * styles.density
    top := c.padding.top * styles.density
    width := math.max(0.0,b.width - left - c.padding.right * styles.density)
    height := math.max(0.0,b.height - top - c.padding.bottom * styles.density)
    frame.push() or >>
    frame.clip_rect(b.x + left,b.y + top,width,height) or >>
    frame.text_layout(&shaped,b.x + left + (width - shaped.metrics.width) * c.align_x,b.y + top + (height - shaped.metrics.height) * c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}
pub fn (checkbox &Checkbox) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := styles.checkbox.clone()
    size := label.measure_styled(styles,&c) or >>
    << layout.Size{width: math.max(c.min_width * styles.density,size.width + (c.indicator_size + c.gap + c.padding.left + c.padding.right) * styles.density),
        height: math.max(c.min_height * styles.density,math.max(size.height,c.indicator_size * styles.density) + (c.padding.top + c.padding.bottom) * styles.density)}
}
pub fn (checkbox &Checkbox) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    c := styles.checkbox.clone()
    _ := label.measure_styled(styles,&c) or >>
    bounds := checkbox.control.bounds
    mut state := checkbox.control.visual_state()
    if checkbox.checked { state = state | state_selected }
    d := styles.density
    side := math.max(0.0,math.min(c.indicator_size * d,math.min(bounds.width - (c.padding.left + c.padding.right) * d,bounds.height - (c.padding.top + c.padding.bottom) * d)))
    box := layout.Rect{x: bounds.x + c.padding.left * d,y: bounds.y + (bounds.height - side) * 0.5,width: side,height: side}
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    style_box(frame,&box,&c,d,state) or >>
    ink := c.resolve(state).foreground
    if checkbox.checked && side >= 4.0 && c.mark_width > 0.0 {
        frame.line(box.x + side * 0.2,box.y + side * 0.5,box.x + side * 0.45,box.y + side * 0.75,ink,c.mark_width * d) or >>
        frame.line(box.x + side * 0.45,box.y + side * 0.75,box.x + side * 0.8,box.y + side * 0.25,ink,c.mark_width * d) or >>
    }
    shaped := label.layouts[0]
    mut text_style := c.clone()
    text_style.palette.on_accent = c.palette.foreground
    frame.text_layout(&shaped,box.x + side + c.gap * d,bounds.y + (bounds.height - shaped.metrics.height) * 0.5,text_style.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}
pub fn (progress &Progress) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    mut c := styles.progress.clone()
    b := progress.bounds
    mut state := 0
    if !progress.enabled { state = state | state_disabled }
    if progress.invalid { state = state | state_invalid }
    c.palette.foreground = c.palette.accent
    if progress.invalid { c.palette.foreground = c.palette.invalid }
    style_box(frame,&b,&c,styles.density,state) or >>
    ink := c.resolve(state).foreground
    // Reveal the fully rounded indicator by clipping its fractional extent.
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width * progress.value,b.height) or >>
    rounded_fill(frame,&b,c.radius * styles.density,ink) or >>
    frame.pop() or >>
    << 0
}

pub fn (button &mut Button) set_invalid(invalid bool) { if button.invalid != invalid { button.invalid = invalid
    button.dirty = true } }
pub fn (button &mut Button) set_selected(selected bool) { if button.selected != selected { button.selected = selected
    button.dirty = true } }
pub fn (checkbox &mut Checkbox) set_invalid(invalid bool) { control := mut &checkbox.control
    control.set_invalid(invalid) }

pub fn (progress &mut Progress) set_enabled(enabled bool) { if progress.enabled != enabled { progress.enabled = enabled
    progress.dirty = true } }
pub fn (progress &mut Progress) set_invalid(invalid bool) { if progress.invalid != invalid { progress.invalid = invalid
    progress.dirty = true } }
