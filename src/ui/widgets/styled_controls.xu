@ui/widgets

#ui/draw
#ui/layout
#errors
#math

pub fn (button &Button) visual_state() int {
    mut state := 0
    if button.invalid { state = state | STATE_INVALID }
    if button.selected { state = state | STATE_SELECTED }
    if button.read_only { state = state | STATE_READ_ONLY }
    if !button.is_enabled() { state = state | STATE_DISABLED }
    if button.hovered { state = state | STATE_HOVERED }
    if !button.read_only && ((button.pointer_armed && button.hovered) || button.keyboard_armed != 0) { state = state | STATE_PRESSED }
    if button.focused { state = state | STATE_FOCUSED }
    << state
}
pub fn (button &Button) has_style() bool { << button.custom.active }
pub fn (button &Button) style_or(styles &Styles) ControlStyle {
    if button.custom.active { << unpack_scalar_style(&button.custom) }
    << styles.button.clone()
}
pub fn (button &mut Button) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !button.custom.active || !control_equal(&unpack_scalar_style(&button.custom),&next) { button.dirty = true }
    button.custom = pack_scalar_style(style)
    << 0
}
pub fn (button &mut Button) clear_style() {
    if button.custom.active {
        button.custom.active = false
        button.dirty = true
    }
}
pub fn (button &Button) is_invalid() bool { << button.invalid }
pub fn (button &Button) is_selected() bool { << button.selected }
pub fn (button &Button) is_read_only() bool { << button.read_only }
pub fn (button &Button) is_hovered() bool { << button.hovered }
pub fn (button &Button) is_pressed() bool { << !button.read_only && ((button.pointer_armed && button.hovered) || button.keyboard_armed != 0) }
pub fn (button &mut Button) set_read_only(read_only bool) {
    if button.read_only != read_only {
        button.read_only = read_only
        button.pointer_armed = false
        button.keyboard_armed = 0
        button.dirty = true
    }
}
pub fn (button &Button) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := button.style_or(styles)
    size := label.measure_styled(styles,&c) or >>
    << layout.Size{width: math.max(c.min_width * styles.density,size.width + (c.padding.left + c.padding.right) * styles.density),
        height: math.max(c.min_height * styles.density,size.height + (c.padding.top + c.padding.bottom) * styles.density)}
}
pub fn (button &Button) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    c := button.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    state := button.visual_state()
    style_box(frame,&button.bounds,&c,styles.density,state) or >>
    shaped := label.layouts[0]
    b := button.bounds
    left := c.padding.left * styles.density
    top := c.padding.top * styles.density
    width := math.max(0.0,b.width - left - c.padding.right * styles.density)
    height := math.max(0.0,b.height - top - c.padding.bottom * styles.density)
    frame.push() or >>
    frame.clip_rect(b.x + left,b.y + top,width,height) or >>
    frame.text_layout(&shaped,b.x + left + (width - shaped.metrics.width) * c.align_x,b.y + top + (height - shaped.metrics.height) * c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}
pub fn (checkbox &Checkbox) id() int { << checkbox.control.id }
pub fn (checkbox &Checkbox) bounds() layout.Rect { << checkbox.control.bounds() }
pub fn (checkbox &Checkbox) is_focused() bool { << checkbox.control.is_focused() }
pub fn (checkbox &Checkbox) is_enabled() bool { << checkbox.control.is_enabled() }
pub fn (checkbox &Checkbox) is_invalid() bool { << checkbox.control.is_invalid() }
pub fn (checkbox &Checkbox) is_read_only() bool { << checkbox.control.is_read_only() }
pub fn (checkbox &mut Checkbox) set_read_only(read_only bool) {
    control := mut &checkbox.control
    control.set_read_only(read_only)
}
pub fn (checkbox &Checkbox) visual_state() int {
    mut state := checkbox.control.visual_state()
    if checkbox.checked { state = state | STATE_SELECTED }
    << state
}
pub fn (checkbox &Checkbox) has_style() bool { << checkbox.custom.active }
pub fn (checkbox &Checkbox) style_or(styles &Styles) ControlStyle {
    if checkbox.custom.active { << unpack_scalar_style(&checkbox.custom) }
    << styles.checkbox.clone()
}
pub fn (checkbox &mut Checkbox) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !checkbox.custom.active || !control_equal(&unpack_scalar_style(&checkbox.custom),&next) {
        control := mut &checkbox.control
        control.invalidate()
    }
    checkbox.custom = pack_scalar_style(style)
    << 0
}
pub fn (checkbox &mut Checkbox) clear_style() {
    if checkbox.custom.active {
        checkbox.custom.active = false
        control := mut &checkbox.control
        control.invalidate()
    }
}
pub fn (checkbox &Checkbox) measure_styled(label &mut StyledLabel,styles &Styles) layout.Size {
    c := checkbox.style_or(styles)
    size := label.measure_styled(styles,&c) or >>
    d := styles.density
    indicator := c.indicator_size * d
    mut text_width := size.width
    mut text_height := size.height
    mut gap := c.gap * d
    if indicator <= 0.0 { gap = 0.0 }
    if label.value.len == 0 {
        text_width = 0.0
        text_height = 0.0
        gap = 0.0
    }
    mut width := text_width + gap + indicator
    mut height := math.max(text_height,indicator)
    if c.icon_placement == ICON_ABOVE || c.icon_placement == ICON_BELOW {
        width = math.max(text_width,indicator)
        height = text_height + gap + indicator
    }
    << layout.Size{width: math.max(c.min_width * d,width + (c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,height + (c.padding.top + c.padding.bottom) * d)}
}
pub fn (checkbox &Checkbox) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    c := checkbox.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    bounds := checkbox.control.bounds
    state := checkbox.visual_state()
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    avail_w := math.max(0.0,bounds.width - left - c.padding.right * d)
    avail_h := math.max(0.0,bounds.height - top - c.padding.bottom * d)
    side := math.max(0.0,math.min(c.indicator_size * d,math.min(avail_w,avail_h)))
    shaped := label.layouts[0]
    mut text_w := shaped.metrics.width
    mut text_h := shaped.metrics.height
    mut gap := c.gap * d
    if side <= 0.0 { gap = 0.0 }
    if label.value.len == 0 {
        text_w = 0.0
        text_h = 0.0
        gap = 0.0
    }
    mut content_w := side + gap + text_w
    mut content_h := math.max(side,text_h)
    if c.icon_placement == ICON_ABOVE || c.icon_placement == ICON_BELOW {
        content_w = math.max(side,text_w)
        content_h = side + gap + text_h
    }
    x := bounds.x + left + (avail_w - content_w) * c.align_x
    y := bounds.y + top + (avail_h - content_h) * c.align_y
    mut bx := x
    mut by := y + (content_h - side) * 0.5
    mut tx := x + side + gap
    mut ty := y + (content_h - text_h) * 0.5
    if c.icon_placement == ICON_TRAILING {
        tx = x
        bx = x + text_w + gap
    }
    if c.icon_placement == ICON_ABOVE {
        bx = x + (content_w - side) * c.align_x
        by = y
        tx = x + (content_w - text_w) * c.align_x
        ty = y + side + gap
    }
    if c.icon_placement == ICON_BELOW {
        tx = x + (content_w - text_w) * c.align_x
        ty = y
        bx = x + (content_w - side) * c.align_x
        by = y + text_h + gap
    }
    box := layout.Rect{x: bx,y: by,width: side,height: side}
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    style_box(frame,&box,&c,d,state) or >>
    ink := c.resolve(state).foreground
    if checkbox.checked && side >= 4.0 && c.mark_width > 0.0 {
        frame.line(box.x + side * 0.2,box.y + side * 0.5,box.x + side * 0.45,box.y + side * 0.75,ink,c.mark_width * d) or >>
        frame.line(box.x + side * 0.45,box.y + side * 0.75,box.x + side * 0.8,box.y + side * 0.25,ink,c.mark_width * d) or >>
    }
    if label.value.len > 0 {
        mut text_style := c.clone()
        text_style.palette.on_accent = c.palette.foreground
        frame.text_layout(&shaped,tx,ty,text_style.resolve(state).foreground) or >>
    }
    frame.pop() or >>
    << 0
}
pub fn (progress &Progress) bounds() layout.Rect { << copy_rect(&progress.bounds) }
pub fn (progress &Progress) is_enabled() bool { << progress.enabled }
pub fn (progress &Progress) is_invalid() bool { << progress.invalid }
pub fn (progress &Progress) is_focused() bool { << progress.focused && progress.enabled }
pub fn (progress &Progress) is_selected() bool { << progress.selected }
pub fn (progress &mut Progress) set_focus(focused bool) {
    value := focused && progress.enabled
    if progress.focused != value {
        progress.focused = value
        progress.dirty = true
    }
}
pub fn (progress &mut Progress) set_selected(selected bool) {
    if progress.selected != selected {
        progress.selected = selected
        progress.dirty = true
    }
}
pub fn (progress &Progress) visual_state() int {
    mut state := 0
    if !progress.enabled { state = state | STATE_DISABLED }
    if progress.invalid { state = state | STATE_INVALID }
    if progress.selected { state = state | STATE_SELECTED }
    if progress.focused && progress.enabled { state = state | STATE_FOCUSED }
    << state
}
pub fn (progress &Progress) has_style() bool { << progress.custom.active }
pub fn (progress &Progress) style_or(styles &Styles) ControlStyle {
    if progress.custom.active { << unpack_scalar_style(&progress.custom) }
    << styles.progress.clone()
}
pub fn (progress &mut Progress) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !progress.custom.active || !control_equal(&unpack_scalar_style(&progress.custom),&next) { progress.dirty = true }
    progress.custom = pack_scalar_style(style)
    << 0
}
pub fn (progress &mut Progress) clear_style() {
    if progress.custom.active {
        progress.custom.active = false
        progress.dirty = true
    }
}
pub fn (progress &Progress) measure_styled(styles &Styles) layout.Size {
    c := progress.style_or(styles)
    d := styles.density
    << layout.Size{width: math.max(c.min_width * d,(c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,(c.padding.top + c.padding.bottom) * d)}
}
pub fn (progress &Progress) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    mut c := progress.style_or(styles)
    b := progress.bounds
    d := styles.density
    state := progress.visual_state()
    c.palette.foreground = c.palette.accent
    if progress.invalid { c.palette.foreground = c.palette.invalid }
    radius := c.radius * d
    if (c.shadow.value() & 255) > 0 {
        mut steps := 1
        if c.shadow_blur > 0.0 { steps = 8 }
        for i in 0:steps {
            spread := (c.shadow_spread + c.shadow_blur * f64(steps - i) / f64(steps)) * d
            box := layout.Rect{x: b.x + c.shadow_x * d - spread,y: b.y + c.shadow_y * d - spread,
                width: b.width + spread * 2.0,height: b.height + spread * 2.0}
            alpha := int(f64(c.shadow.value() & 255) / f64(steps))
            rounded_fill(frame,&box,radius + spread,c.shadow.with_alpha(alpha)) or >>
        }
    }
    resolved := c.resolve(state)
    rounded_fill(frame,&b,radius,resolved.background) or >>
    left := c.padding.left * d
    top := c.padding.top * d
    inner := layout.Rect{x: b.x + left,y: b.y + top,
        width: math.max(0.0,b.width - left - c.padding.right * d),
        height: math.max(0.0,b.height - top - c.padding.bottom * d)}
    inner_radius := math.max(0.0,radius - math.max(left,top))
    // Reveal the fully rounded indicator by clipping its fractional extent.
    frame.push() or >>
    frame.clip_rect(inner.x,inner.y,inner.width * progress.value,inner.height) or >>
    rounded_fill(frame,&inner,inner_radius,resolved.foreground) or >>
    frame.pop() or >>
    rounded_stroke(frame,&b,radius,resolved.border,c.border_width * d) or >>
    if (state & STATE_FOCUSED) != 0 && (state & STATE_DISABLED) == 0 {
        inset := c.focus_inset * d
        focus := layout.Rect{x: b.x + inset,y: b.y + inset,width: math.max(0.0,b.width - 2.0 * inset),height: math.max(0.0,b.height - 2.0 * inset)}
        rounded_stroke(frame,&focus,math.max(0.0,radius - inset),resolved.focus,c.focus_width * d) or >>
    }
    << 0
}

pub fn (button &mut Button) set_invalid(invalid bool) { if button.invalid != invalid { button.invalid = invalid
    button.dirty = true } }
pub fn (button &mut Button) set_selected(selected bool) { if button.selected != selected { button.selected = selected
    button.dirty = true } }
pub fn (checkbox &mut Checkbox) set_invalid(invalid bool) { control := mut &checkbox.control
    control.set_invalid(invalid) }

pub fn (progress &mut Progress) set_enabled(enabled bool) {
    if progress.enabled != enabled {
        progress.enabled = enabled
        if !enabled { progress.focused = false }
        progress.dirty = true
    }
}
pub fn (progress &mut Progress) set_invalid(invalid bool) { if progress.invalid != invalid { progress.invalid = invalid
    progress.dirty = true } }
