@ui/widgets

#ui/layout
#math

pub const ACTION_RESIZE = 16

pub struct ResizeRecord {
    pub id int
    pub old_bounds layout.Rect
    pub new_bounds layout.Rect
}

fn copy_resize_record(r &ResizeRecord) ResizeRecord {
    << ResizeRecord{
        id: r.id,
        old_bounds: layout.Rect{x: r.old_bounds.x,y: r.old_bounds.y,width: r.old_bounds.width,height: r.old_bounds.height},
        new_bounds: layout.Rect{x: r.new_bounds.x,y: r.new_bounds.y,width: r.new_bounds.width,height: r.new_bounds.height}
    }
}

pub fn (s $&Screen) observe_resize(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    obs := $&comp.resize_observers
    if !obs.has(id) {
        b := s.nodes[id - 1].bounds
        if b.width > 0.0 || b.height > 0.0 {
            obs[id] = layout.Rect{x: b.x,y: b.y,width: b.width,height: b.height}
        } else {
            obs[id] = layout.Rect{x: 0.0,y: 0.0,width: -1.0,height: -1.0}
        }
        oids := $&comp.resize_observer_ids
        oids.push(id)
    }
    << 0
}

pub fn (s $&Screen) unobserve_resize(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.resize_observers.has(id) {
        obs := $&comp.resize_observers
        obs.delete(id)
        next := vec_without(&comp.resize_observer_ids,id)
        comp.resize_observer_ids = next
    }
    << 0
}

pub fn (s &Screen) is_observing_resize(id int) bool {
    _ := s.node(id) >>>
    << s.composition.resize_observers.has(id)
}

pub fn (s $&Screen) take_resized_nodes() []ResizeRecord {
    $out := []ResizeRecord{}
    for i in 0:s.composition.pending_resizes.len {
        out.push(copy_resize_record(&s.composition.pending_resizes[i]))
    }
    comp := $&s.composition
    comp.pending_resizes = []ResizeRecord{}
    << out
}

fn (s $&Screen) check_resize_observers() {
    ocount := s.composition.resize_observer_ids.len
    if ocount == 0 { << }
    for i in 0:ocount {
        oid := s.composition.resize_observer_ids[i]
        if oid <= 0 || oid > s.nodes.len || s.nodes[oid - 1].kind < 0 || !s.composition.resize_observers.has(oid) { -> }
        prev := s.composition.resize_observers[oid]
        cb := s.nodes[oid - 1].bounds
        cur := layout.Rect{x: cb.x,y: cb.y,width: cb.width,height: cb.height}
        if prev.width < 0.0 {
            comp := $&s.composition
            obs := $&comp.resize_observers
            obs[oid] = cur
            ->
        }
        if math.abs(cur.width - prev.width) > 0.01 || math.abs(cur.height - prev.height) > 0.01 {
            comp := $&s.composition
            obs := $&comp.resize_observers
            obs[oid] = layout.Rect{x: cur.x,y: cur.y,width: cur.width,height: cur.height}
            prs := $&comp.pending_resizes
            prs.push(ResizeRecord{
                id: oid,
                old_bounds: layout.Rect{x: prev.x,y: prev.y,width: prev.width,height: prev.height},
                new_bounds: cur
            })
            qa := $&s.queued_actions
            qa.push(Action{kind: ACTION_RESIZE,id: oid,needs_paint: false,request_focus: false,consumed: false,value: cur.width})
        }
    }
}

fn (s $&Screen) cleanup_resize_observer_for(id int) {
    comp := $&s.composition
    if comp.resize_observers.has(id) {
        obs := $&comp.resize_observers
        obs.delete(id)
        next := vec_without(&comp.resize_observer_ids,id)
        comp.resize_observer_ids = next
    }
}
