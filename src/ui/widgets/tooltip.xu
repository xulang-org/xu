@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors

// The host forwards anchor pointer/focus events and calls tick at next_tick().
// No polling task is started. Geometry is in full canvas coordinates.
pub struct Tooltip {
    panel Popover
    hovered bool
    focused bool
    suppressed bool
    pending bool
    entered time.Instant
    show_at time.Instant
    delay time.Duration
}
pub fn tooltip(identity &ui.CanvasEvent,id int,anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) Tooltip {
    panel := popover(identity,id,anchor,size,viewport) or >>
    << Tooltip{panel: panel,hovered: false,focused: false,suppressed: false,pending: false,entered: time.zero_instant(),
        show_at: time.zero_instant(),delay: time.milliseconds(500) or >>}
}
pub fn (t &Tooltip) id() int { << t.panel.id() }
pub fn (t &Tooltip) bounds() layout.Rect { << t.panel.bounds() }
pub fn (t &Tooltip) is_enabled() bool { << t.panel.is_enabled() }
pub fn (t &Tooltip) is_open() bool { << t.panel.is_open() }
pub fn (t &Tooltip) is_visible() bool { << t.panel.is_visible() }
pub fn (t &Tooltip) opacity() f64 { << t.panel.opacity() }
pub fn (t &Tooltip) needs_paint() bool { << t.panel.needs_paint() }
pub fn (t &mut Tooltip) painted() { panel := mut &t.panel
    panel.painted() }
pub fn (t &mut Tooltip) set_delay(delay time.Duration) int {
    if delay.is_negative() || delay.nanoseconds() > time.minute() { >> errors.new("widgets: invalid tooltip delay") }
    t.delay = delay
    if t.pending { t.show_at = t.entered.add(delay) or >> }
    << 0
}
pub fn (t &mut Tooltip) set_geometry(anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) int {
    _ := anchored_overlay_bounds(anchor,size,viewport) or >>
    anchor_changed := !overlay_same_rect(anchor,&t.panel.anchor)
    if anchor_changed {
        t.hovered = false
        t.pending = false
        t.suppressed = false
        if !t.focused { panel := mut &t.panel
            panel.close(time.zero_instant(),true) or >> }
    }
    panel := mut &t.panel
    << panel.set_geometry(anchor,size,viewport) or >>
}
pub fn (t &mut Tooltip) set_enabled(enabled bool) int {
    if !enabled { t.hovered = false
        t.focused = false
        t.pending = false
        t.suppressed = false }
    panel := mut &t.panel
    << panel.set_enabled(enabled) or >>
}
fn (t &mut Tooltip) update_trigger(now time.Instant) int {
    if !t.panel.enabled { << 0 }
    if !t.hovered && !t.focused {
        t.pending = false
        t.suppressed = false
        reduced := t.panel.reduced
        panel := mut &t.panel
        << panel.close(now,reduced) or >>
    }
    if t.suppressed { << 0 }
    if t.focused {
        t.pending = false
        reduced := t.panel.reduced
        panel := mut &t.panel
        << panel.open(now,reduced) or >>
    }
    if t.delay.is_zero() {
        reduced := t.panel.reduced
        panel := mut &t.panel
        << panel.open(now,reduced) or >>
    }
    if !t.panel.is_open() && !t.pending {
        t.entered = now
        t.show_at = now.add(t.delay) or >>
        t.pending = true
    }
    << 0
}
pub fn (t &mut Tooltip) set_focus(focused bool,now time.Instant) int {
    if t.focused == focused { << 0 }
    t.focused = focused && t.panel.enabled
    << t.update_trigger(now) or >>
}
pub fn (t &mut Tooltip) dismiss(now time.Instant,reduced_motion bool) int {
    t.pending = false
    t.suppressed = true
    panel := mut &t.panel
    << panel.close(now,reduced_motion) or >>
}
pub fn (t &mut Tooltip) input(event &ui.InputEvent) Action {
    if !belongs(&t.panel.identity,event) || !t.panel.enabled { << no_action(t.id(),t.needs_paint()) }
    now := time.instant_from_ns(event.time_ns) or >>
    if event.kind == ui.ev_pointer_cancel {
        t.hovered = false
        t.focused = false
        t.pending = false
        t.suppressed = false
        panel := mut &t.panel
        panel.close(now,true) or >>
    } else if event.kind == ui.ev_pointer_move || event.kind == ui.ev_pointer_enter || event.kind == ui.ev_pointer_leave {
        hot := event.kind != ui.ev_pointer_leave && t.panel.anchor.contains(event.x,event.y)
        if t.hovered != hot { t.hovered = hot
            t.update_trigger(now) or >> }
    } else if event.kind == ui.ev_key_down && event.key == ui.key_escape && (t.is_open() || t.pending) {
        reduced := t.panel.reduced
        t.dismiss(now,reduced) or >>
        << overlay_action(t.id(),true,t.needs_paint(),true)
    }
    << no_action(t.id(),t.needs_paint())
}
pub fn (t &mut Tooltip) route(kind int,event &ui.InputEvent) Action {
    if kind < route_input || kind > route_cancel { >> errors.new("widgets: invalid route kind") }
    if !belongs(&t.panel.identity,event) { << no_action(t.id(),t.needs_paint()) }
    now := time.instant_from_ns(event.time_ns) or >>
    if kind == route_focus { t.set_focus(true,now) or >> }
    else if kind == route_blur { t.set_focus(false,now) or >> }
    else if kind == route_cancel {
        t.focused = false
        t.hovered = false
        t.pending = false
        t.suppressed = false
        panel := mut &t.panel
        panel.close(now,true) or >>
    } else { << t.input(event) or >> }
    << no_action(t.id(),t.needs_paint())
}
pub fn (t &mut Tooltip) tick(now time.Instant,reduced_motion bool) bool {
    t.panel.reduced = reduced_motion
    mut opened := false
    if t.pending && !now.before(t.show_at) {
        t.pending = false
        if (t.hovered || t.focused) && !t.suppressed && t.panel.enabled {
            opened = true
            panel := mut &t.panel
            panel.open(now,reduced_motion) or >>
        }
    }
    panel := mut &t.panel
    changed := panel.tick(now,reduced_motion) or >>
    << opened || changed
}
pub fn (t &Tooltip) next_tick(now time.Instant) time.Instant {
    next := t.panel.next_tick(now) or >>
    if t.pending {
        mut deadline := t.show_at
        if deadline.is_zero() { deadline = now.add(time.duration(1)) or >> }
        if next.is_zero() || deadline.before(next) { << deadline }
    }
    << next
}
pub fn (t &Tooltip) paint_styled(frame &mut draw.Frame,label &mut StyledLabel,styles &Styles) int {
    if !t.is_visible() { << 0 }
    bounds := t.bounds()
    c := styles.card_style()
    << paint_overlay_label(frame,label,&bounds,styles,&c,t.opacity(),true) or >>
}
