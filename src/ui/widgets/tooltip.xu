@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors

// The host forwards anchor pointer/focus events and calls tick at next_tick().
// No polling task is started. Geometry is in full canvas coordinates.
pub struct Tooltip {
    panel Popover
    hovered bool
    focused bool
    suppressed bool
    blocked bool
    pending bool
    entered time.Instant
    show_at time.Instant
    delay time.Duration
}
pub fn tooltip(identity &ui.CanvasEvent,id int,anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) Tooltip {
    $panel := popover(identity,id,anchor,size,viewport) >>>
    $placement := overlay_placement()
    placement.side = OVERLAY_TOP
    placement.align = OVERLAY_CENTER
    panel.set_placement(&placement) >>>
    << Tooltip{panel: panel,hovered: false,focused: false,suppressed: false,blocked: false,pending: false,entered: time.zero_instant(),
        show_at: time.zero_instant(),delay: time.milliseconds(500) >>>}
}
pub fn (t &Tooltip) id() int { << t.panel.id() }
pub fn (t &Tooltip) bounds() layout.Rect { << t.panel.bounds() }
pub fn (t &Tooltip) is_enabled() bool { << t.panel.is_enabled() }
pub fn (t &Tooltip) is_selectable() bool { << t.panel.is_selectable() }
pub fn (t $&Tooltip) set_selectable(selectable bool) { panel := $&t.panel
    panel.set_selectable(selectable) }
pub fn (t $&Tooltip) set_text(context &draw.Context,text &string) int { panel := $&t.panel
    << panel.set_text(context,text) >>> }
pub fn (t &Tooltip) has_popup_open() bool { << t.panel.has_popup_open() }
pub fn (t &Tooltip) popup_bounds() layout.Rect { << t.panel.popup_bounds() }
pub fn (t &Tooltip) selected_text() string { << t.panel.selected_text() }
pub fn (t &Tooltip) copy_selection() int { << t.panel.copy_selection() }
pub fn (t &Tooltip) cursor() int { << t.panel.cursor() }
pub fn (t &Tooltip) cursor_at(x f64,y f64) int { << t.panel.cursor_at(x,y) }
pub fn (t $&Tooltip) set_viewport(viewport &layout.Rect) { panel := $&t.panel
    panel.set_viewport(viewport) }
pub fn (t $&Tooltip) set_locale(locale &Locale) int { panel := $&t.panel
    << panel.set_locale(locale) >>> }
pub fn (t &Tooltip) is_open() bool { << t.panel.is_open() }
pub fn (t &Tooltip) is_visible() bool { << t.panel.is_visible() }
pub fn (t &Tooltip) opacity() f64 { << t.panel.opacity() }
pub fn (t &Tooltip) needs_paint() bool { << t.panel.needs_paint() }
pub fn (t $&Tooltip) painted() { panel := $&t.panel
    panel.painted() }
pub fn (t $&Tooltip) set_delay(delay time.Duration) int {
    if delay.is_negative() || delay.nanoseconds() > time.minute() { >> errors.new("widgets: invalid tooltip delay") }
    t.delay = delay
    if t.pending { t.show_at = t.entered.add(delay) >>> }
    << 0
}
pub fn (t $&Tooltip) set_geometry(anchor &layout.Rect,size &layout.Size,viewport &layout.Rect) int {
    _ := anchored_overlay_bounds(anchor,size,viewport) >>>
    anchor_changed := !overlay_same_rect(anchor,&t.panel.anchor)
    if anchor_changed {
        t.hovered = false
        t.pending = false
        t.suppressed = false
        if !t.focused { panel := $&t.panel
            panel.close(time.zero_instant(),true) >>> }
    }
    panel := $&t.panel
    << panel.set_geometry(anchor,size,viewport) >>>
}
pub fn (t $&Tooltip) set_placement(placement &OverlayPlacement) int {
    panel := $&t.panel
    << panel.set_placement(placement) >>>
}
pub fn (t $&Tooltip) set_enabled(enabled bool) int {
    if !enabled { t.hovered = false
        t.focused = false
        t.pending = false
        t.suppressed = false }
    panel := $&t.panel
    << panel.set_enabled(enabled) >>>
}
fn (t $&Tooltip) update_trigger(now time.Instant) int {
    if !t.panel.enabled { << 0 }
    if !t.hovered && !t.focused {
        t.pending = false
        t.suppressed = false
        reduced := t.panel.reduced
        panel := $&t.panel
        << panel.close(now,reduced) >>>
    }
    if t.blocked {
        t.pending = false
        panel := $&t.panel
        << panel.close(now,true) >>>
    }
    if t.suppressed { << 0 }
    if t.focused {
        t.pending = false
        reduced := t.panel.reduced
        panel := $&t.panel
        << panel.open(now,reduced) >>>
    }
    if t.delay.is_zero() {
        reduced := t.panel.reduced
        panel := $&t.panel
        << panel.open(now,reduced) >>>
    }
    if !t.panel.is_open() && !t.pending {
        t.entered = now
        t.show_at = now.add(t.delay) >>>
        t.pending = true
    }
    << 0
}
// Interactive surfaces take priority over passive help. Suspend immediately,
// retain the logical trigger, and require a fresh delay when the surface exits.
pub fn (t $&Tooltip) set_blocked(blocked bool,now time.Instant) int {
    if t.blocked == blocked { << 0 }
    $current := now
    if true {
        panel := $&t.panel
        current = panel.observe(now)
    }
    t.blocked = blocked
    t.pending = false
    if blocked { panel := $&t.panel
        << panel.close(current,true) >>> }
    if t.panel.enabled && !t.suppressed && (t.hovered || t.focused) {
        t.entered = current
        t.show_at = current.add(t.delay) >>>
        t.pending = true }
    << 0
}
pub fn (t $&Tooltip) set_focus(focused bool,now time.Instant) int {
    $current := now
    if true {
        panel := $&t.panel
        current = panel.observe(now)
    }
    if t.focused == focused { << 0 }
    t.focused = focused && t.panel.enabled
    << t.update_trigger(current) >>>
}
pub fn (t $&Tooltip) dismiss(now time.Instant,reduced_motion bool) int {
    $current := now
    if true {
        panel := $&t.panel
        current = panel.observe(now)
    }
    t.pending = false
    t.suppressed = true
    panel := $&t.panel
    << panel.close(current,reduced_motion) >>>
}
pub fn (t $&Tooltip) input(event &ui.InputEvent) Action {
    if !belongs(&t.panel.identity,event) || !t.panel.enabled { << no_action(t.id(),t.needs_paint()) }
    observed := time.instant_from_ns(event.time_ns) >>>
    $now := observed
    if true {
        panel := $&t.panel
        now = panel.observe(observed)
    }
    bounds := t.bounds()
    if t.has_popup_open() {
        $act := no_action(t.id(),false)
        if true {
            panel := $&t.panel
            aux := $&panel.aux
            act = overlay_route_aux_input(aux,&bounds,event)
        }
        << Action{kind: ACTION_NONE,id: t.id(),needs_paint: t.needs_paint() || act.needs_paint,request_focus: act.request_focus,consumed: true,value: 0.0}
    }
    in_panel := t.is_open() && t.is_selectable() && t.panel.aux.has(0) &&
        (bounds.contains(event.x,event.y) || t.panel.aux[0].is_selecting() || (event.kind == ui.EV_KEY_DOWN && event.key != ui.KEY_ESCAPE && t.panel.aux[0].is_focused()))
    if in_panel {
        $act := no_action(t.id(),false)
        if true {
            panel := $&t.panel
            aux := $&panel.aux
            act = overlay_route_aux_input(aux,&bounds,event)
        }
        if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER { t.hovered = true }
        if act.consumed || act.needs_paint {
            << Action{kind: ACTION_NONE,id: t.id(),needs_paint: t.needs_paint() || act.needs_paint,request_focus: act.request_focus,consumed: act.consumed,value: 0.0}
        }
    }
    if event.kind == ui.EV_POINTER_CANCEL {
        t.hovered = false
        t.focused = false
        t.pending = false
        t.suppressed = false
        panel := $&t.panel
        panel.close(now,true) >>>
    } else if event.kind == ui.EV_POINTER_DOWN || event.kind == ui.EV_POINTER_SCROLL {
        if t.hovered || t.focused || t.pending || t.is_open() { t.dismiss(now,t.panel.reduced) >>> }
    } else if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        in_selectable := t.is_open() && t.is_selectable() && t.panel.aux.has(0) && bounds.contains(event.x,event.y)
        hot := event.kind != ui.EV_POINTER_LEAVE && (t.panel.anchor.contains(event.x,event.y) || in_selectable)
        if t.hovered != hot { t.hovered = hot
            t.update_trigger(now) >>> }
    } else if event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_ESCAPE && (t.is_open() || t.pending) {
        reduced := t.panel.reduced
        t.dismiss(now,reduced) >>>
        << overlay_action(t.id(),true,t.needs_paint(),true)
    }
    << no_action(t.id(),t.needs_paint())
}
pub fn (t $&Tooltip) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if !belongs(&t.panel.identity,event) { << no_action(t.id(),t.needs_paint()) }
    observed := time.instant_from_ns(event.time_ns) >>>
    $now := observed
    if true {
        panel := $&t.panel
        now = panel.observe(observed)
    }
    if kind == ROUTE_FOCUS { t.set_focus(true,now) >>> }
    else if kind == ROUTE_BLUR { t.set_focus(false,now) >>> }
    else if kind == ROUTE_CANCEL {
        t.focused = false
        t.hovered = false
        t.pending = false
        t.suppressed = false
        panel := $&t.panel
        panel.close(now,true) >>>
    } else { << t.input(event) >>> }
    << no_action(t.id(),t.needs_paint())
}
pub fn (t $&Tooltip) tick(now time.Instant,reduced_motion bool) bool {
    t.panel.reduced = reduced_motion
    $current := now
    if true {
        panel := $&t.panel
        current = panel.observe(now)
    }
    $opened := false
    if t.pending && !current.before(t.show_at) {
        t.pending = false
        if (t.hovered || t.focused) && !t.suppressed && !t.blocked && t.panel.enabled {
            opened = true
            panel := $&t.panel
            panel.open(current,reduced_motion) >>>
        }
    }
    panel := $&t.panel
    changed := panel.tick(current,reduced_motion) >>>
    << opened || changed
}
pub fn (t &Tooltip) next_tick(now time.Instant) time.Instant {
    next := t.panel.next_tick(now) >>>
    if t.pending {
        $deadline := t.show_at
        if deadline.is_zero() { deadline = now.add(time.duration(1)) >>> }
        if next.is_zero() || deadline.before(next) { << deadline }
    }
    << next
}
pub fn (t &Tooltip) paint_styled(frame $&draw.Frame,label $&StyledLabel,styles &Styles) int {
    if !t.is_visible() { << 0 }
    bounds := t.bounds()
    c := t.panel.style_or(styles)
    $sel_a := 0
    $sel_f := 0
    if t.is_selectable() && t.panel.aux.has(0) {
        r := t.panel.selection_range()
        sel_a = r.start
        sel_f = r.end
    }
    << paint_overlay_label_selected(frame,label,&bounds,styles,&c,t.opacity(),true,sel_a,sel_f) >>>
}
pub fn (t $&Tooltip) paint_content_styled(frame $&draw.Frame,styles &Styles) int {
    panel := $&t.panel
    << panel.paint_content_styled(frame,styles) >>>
}
pub fn (t $&Tooltip) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    panel := $&t.panel
    << panel.paint_popup_styled(frame,styles) >>>
}

pub fn (t $&Tooltip) set_style(style &ControlStyle) int { panel := $&t.panel
    << panel.set_style(style) >>> }
pub fn (t $&Tooltip) clear_style() { panel := $&t.panel
    panel.clear_style() }
pub fn (t $&Tooltip) set_motion(spec &MotionSpec) int { panel := $&t.panel
    << panel.set_motion(spec) >>> }

fn (t &Tooltip) clone_tooltip() Tooltip {
    panel := t.panel.clone_panel()
    << Tooltip{panel: panel,hovered: t.hovered,focused: t.focused,suppressed: t.suppressed,blocked: t.blocked,pending: t.pending,
        entered: t.entered,show_at: t.show_at,delay: t.delay}
}
