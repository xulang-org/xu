@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

fn (editor &Editor) left() f64 { << editor.appearance.padding.left * editor.density }
fn (editor &Editor) right() f64 { << editor.appearance.padding.right * editor.density }
fn (editor &Editor) top() f64 { << editor.appearance.padding.top * editor.density }
fn (editor &Editor) bottom() f64 { << editor.appearance.padding.bottom * editor.density }
fn (editor &Editor) text_origin_x(shaped_width f64) f64 {
    width := math.max(1.0,editor.bounds.width - editor.left() - editor.right())
    if !editor.multiline && shaped_width < width && editor.appearance.align_x > 0.0 {
        << editor.left() + (width - shaped_width) * editor.appearance.align_x
    }
    << editor.left()
}
fn (editor &Editor) text_origin_y(shaped_height f64) f64 {
    height := math.max(1.0,editor.bounds.height - editor.top() - editor.bottom())
    if shaped_height < height && editor.appearance.align_y > 0.0 {
        << editor.top() + (height - shaped_height) * editor.appearance.align_y
    }
    << editor.top()
}
fn (editor &Editor) editor_options() draw.TextOptions {
    mut options := copy_text_options(&editor.typography)
    if editor.multiline {
        options.width = math.max(1.0,editor.bounds.width - editor.left() - editor.right())
        if editor.appearance.align_x > 0.66 { options.align = draw.TEXT_RIGHT }
        else if editor.appearance.align_x >= 0.34 { options.align = draw.TEXT_CENTER }
        else { options.align = draw.TEXT_LEFT }
    }
    << options
}
fn (editor &mut Editor) drop_placeholder() {
    for item in editor.placeholder_layouts { mut owned := item
        owned.dispose() or (err) { -> } }
    editor.placeholder_layouts = []draw.TextLayout{}
}
pub fn (editor &Editor) bounds() layout.Rect { << copy_rect(&editor.bounds) }
pub fn (editor &Editor) is_invalid() bool { << editor.invalid }
pub fn (editor &Editor) is_hovered() bool { << editor.hovered }
pub fn (editor &Editor) visual_state() int {
    mut state := 0
    if !editor.enabled { state = state | STATE_DISABLED }
    if editor.focused { state = state | STATE_FOCUSED }
    if editor.hovered { state = state | STATE_HOVERED }
    if editor.invalid { state = state | STATE_INVALID }
    if editor.read_only { state = state | STATE_READ_ONLY }
    << state
}
pub fn (editor &Editor) has_style() bool { << editor.custom_style.len > 0 }
pub fn (editor &Editor) style_or(styles &Styles) ControlStyle {
    if editor.custom_style.len > 0 {
        if editor.multiline { << decode_control_style(&editor.custom_style,&styles.text_area) }
        << decode_control_style(&editor.custom_style,&styles.input)
    }
    if editor.multiline { << styles.text_area.clone() }
    << styles.input.clone()
}
pub fn (editor &mut Editor) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    mut font := copy_font(&style.font)
    if style.inherit_font { font = copy_font(&editor.global_font) }
    mut options := draw.text_options(font.size * editor.text_scale)
    options.family = font.family
    options.weight = font.weight
    options.italic = font.italic
    options.line_height = font.line_height * editor.text_scale
    if options.size < 1.0 || options.size > 512.0 || options.line_height > 1024.0 { >> errors.new("widgets: scaled font exceeds drawing limits") }
    font_changed := !options_equal(&editor.typography,&options) || editor.appearance.align_x != style.align_x
    metrics := !measure_equal(&editor.appearance,style) || editor.appearance.align_x != style.align_x || editor.appearance.align_y != style.align_y
    if font_changed || metrics {
        editor.drop_layout()
        editor.drop_placeholder()
        editor.reveal_caret = true
    }
    encoded := encode_control_style(style)
    if font_changed || metrics || editor.custom_style != encoded { editor.dirty = true }
    editor.custom_style = encoded
    editor.appearance = style.clone()
    editor.typography = copy_text_options(&options)
    editor.font_size = options.size
    << 0
}
pub fn (editor &mut Editor) clear_style() {
    if editor.custom_style.len > 0 {
        editor.custom_style = ""
        editor.drop_layout()
        editor.drop_placeholder()
        editor.reveal_caret = true
        editor.dirty = true
    }
}
pub fn (editor &mut Editor) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := editor.style_or(styles)
    options := styles.text_options(&c)
    if options.size < 1.0 || options.size > 512.0 || options.line_height > 1024.0 { >> errors.new("widgets: scaled font exceeds drawing limits") }
    font_changed := !options_equal(&editor.typography,&options) || editor.appearance.align_x != c.align_x
    metrics := !measure_equal(&editor.appearance,&c) || editor.density != styles.density || editor.appearance.align_x != c.align_x || editor.appearance.align_y != c.align_y
    if font_changed || metrics { editor.drop_layout()
        editor.drop_placeholder()
        editor.reveal_caret = true }
    if font_changed || metrics || !control_equal(&editor.appearance,&c) { editor.dirty = true }
    editor.appearance = c.clone()
    editor.typography = copy_text_options(&options)
    editor.global_font = copy_font(&styles.font)
    editor.text_scale = styles.text_scale
    editor.font_size = options.size
    editor.density = styles.density
    << 0
}
pub fn (editor &mut Editor) paint_motion_styled(frame &mut draw.Frame,styles &Styles,motion &mut PaintTransition,now time.Instant,reduced_motion bool) int {
    editor.apply_styles(styles) or >>
    appearance := motion.style(&editor.appearance,editor.visual_state(),now,reduced_motion) or >>
    << editor.paint_editor(frame,&appearance) or >>
}
pub fn (editor &mut Editor) set_invalid(invalid bool) {
    if editor.invalid != invalid { editor.invalid = invalid
        editor.dirty = true }
}
pub fn (editor &Editor) is_read_only() bool { << editor.read_only }
// Read-only editors keep local selection and clipboard copy, but own no native
// text session. Late IME commits cannot mutate the document after this switch.
pub fn (editor &mut Editor) set_read_only(on bool) int {
    if editor.read_only == on { << 0 }
    focused := editor.focused
    editor.focus_session(false) or >>
    editor.read_only = on
    editor.focus_session(focused) or >>
    editor.dirty = true
    << 0
}
fn (editor &mut Editor) select_state(state &ui.TextInputState,anchor int,focus int) int {
    editor.restart_caret()
    if editor.session.id > 0 {
        caret := editor.caret_rect()
        _ := editor.session.update(state.revision,&state.value,anchor,focus,&caret) or (err) { editor.dirty = true
            << 0 }
        _ := editor.read_state() or >>
    } else { editor.anchor = anchor
        editor.focus = focus
        editor.revision = editor.revision + 1 }
    editor.dirty = true
    editor.reveal_caret = true
    << 0
}
pub fn (editor &mut Editor) measure_styled(styles &Styles) layout.Size {
    editor.apply_styles(styles) or >>
    c := editor.appearance.clone()
    mut height := c.min_height * styles.density
    mut options := editor.editor_options()
    options.width = 0.0
    mut sample := editor.context.layout_text(&"Mg",&options) or >>
    mut lines := 1.0
    if editor.multiline { lines = 4.0 }
    height = math.max(height,sample.metrics.height * lines + editor.top() + editor.bottom())
    sample.dispose() or >>
    << layout.Size{width: math.max(c.min_width * styles.density,editor.left() + editor.right()),height: height}
}
pub fn (editor &mut Editor) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    editor.apply_styles(styles) or >>
    c := editor.appearance.clone()
    << editor.paint_editor(frame,&c) or >>
}
