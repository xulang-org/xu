@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors
#strconv

// High-level adapters retain the same controls used by View and immediate mode.
struct ScreenBasics {
    checks map[int]Checkbox
    switches map[int]Switch
    radios map[int]Radio
    sliders map[int]Slider
    steppers map[int]Stepper
    tabs map[int]Tabs
    selects map[int]Select
    lists map[int]ListBox
    progresses map[int]Progress
    dividers map[int]Divider
    badge_counts map[int]BadgeCounter
    badge_attachments map[int]BadgeAttachment
    badges map[int]Badge
    card_sections map[int]CardSectionState
    scrolls map[int]Scroll
    cards map[int]Card
    groups map[int]RadioGroup
    secondary map[int]StyledLabel
    details map[int]StyledLabel
    list_icons map[int]int
    ellipsis_labels map[int]StyledLabel
    label_styles map[int]string
    wrapped_labels map[int]bool
    button_icons map[int]draw.Image
    labels map[int]StyledLabel
    counts []int
}
fn screen_basic_kind(kind int) bool { << (kind >= SCREEN_CHECKBOX && kind <= SCREEN_SELECT) || (kind >= SCREEN_LIST && kind <= SCREEN_RADIO_GROUP) }
fn new_screen_basics() ScreenBasics {
    << ScreenBasics{checks: map[int]Checkbox{},switches: map[int]Switch{},radios: map[int]Radio{},sliders: map[int]Slider{},steppers: map[int]Stepper{},tabs: map[int]Tabs{},selects: map[int]Select{},lists: map[int]ListBox{},progresses: map[int]Progress{},dividers: map[int]Divider{},badge_counts: map[int]BadgeCounter{},badge_attachments: map[int]BadgeAttachment{},badges: map[int]Badge{},card_sections: map[int]CardSectionState{},scrolls: map[int]Scroll{},cards: map[int]Card{},groups: map[int]RadioGroup{},secondary: map[int]StyledLabel{},details: map[int]StyledLabel{},list_icons: map[int]int{},ellipsis_labels: map[int]StyledLabel{},label_styles: map[int]string{},wrapped_labels: map[int]bool{},button_icons: map[int]draw.Image{},labels: map[int]StyledLabel{},counts: []int{}}
}
fn (s &mut Screen) basic_labels(id int,values &[]string) int {
    if values.len > 512 { >> errors.new("widgets: too many control labels") }
    for value in values { validate_table_text(&value) or >> }
    context := s.context.clone()
    basic := mut &s.basics
    while basic.counts.len < id { basic.counts.push(0) }
    basic.counts[id - 1] = values.len
    for i in 0:values.len { basic.labels[id * 1024 + i] = styled_label(&context,&values[i]) }
    << 0
}
pub fn (s &mut Screen) checkbox(text string,checked bool) int {
    id := s.add_node(SCREEN_CHECKBOX,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    item := checkbox(&s.identity,id,&empty,checked) or (err) { s.abandon_node(id)
        >> err }
    s.basic_labels(id,&[text]) or (err) { s.abandon_node(id)
        >> err }
    basic := mut &s.basics
    basic.checks[id] = item
    << id
}
pub fn (s &mut Screen) switch_control(text string,checked bool) int {
    id := s.add_node(SCREEN_SWITCH,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    item := switch_control(&s.identity,id,&empty,checked) or (err) { s.abandon_node(id)
        >> err }
    s.basic_labels(id,&[text]) or (err) { s.abandon_node(id)
        >> err }
    basic := mut &s.basics
    basic.switches[id] = item
    << id
}
pub fn (s &mut Screen) radio(text string,option int,checked bool) int {
    id := s.add_node(SCREEN_RADIO,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    item := radio(&s.identity,id,&empty,option,checked) or (err) { s.abandon_node(id)
        >> err }
