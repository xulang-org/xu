fn (s &mut Screen) basic_place(id int,bounds &layout.Rect) int {
    if s.basics.scrolls.has(id) { << s.scroll_update(id,0,bounds,0.0) or >> }
    n := s.node(id) or >>
    if n.kind == SCREEN_RADIO_GROUP { mut item := s.take_basic_group(id)
        result := basic_group_place(mut &item,bounds)
        s.basics.groups[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0 }
    styles := s.styles.clone()
    if n.kind == SCREEN_CHECKBOX {
        basic := mut &s.basics
        items := mut &basic.checks
        mut item := items.take(id)
        result := basic_place_checks(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_SWITCH {
        basic := mut &s.basics
        items := mut &basic.switches
        mut item := items.take(id)
        result := basic_place_switches(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_RADIO {
        basic := mut &s.basics
        items := mut &basic.radios
        mut item := items.take(id)
        result := basic_place_radios(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_SLIDER {
        basic := mut &s.basics
        items := mut &basic.sliders
        mut item := items.take(id)
        result := basic_place_sliders(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_STEPPER {
        basic := mut &s.basics
        items := mut &basic.steppers
        mut item := items.take(id)
        result := basic_place_steppers(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_TABS {
        basic := mut &s.basics
        items := mut &basic.tabs
        mut item := items.take(id)
        result := basic_place_tabs(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_SELECT {
        basic := mut &s.basics
        items := mut &basic.selects
        mut item := items.take(id)
        result := basic_place_selects(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_LIST {
        basic := mut &s.basics
        items := mut &basic.lists
        mut item := items.take(id)
        result := basic_place_lists(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_PROGRESS {
        basic := mut &s.basics
        items := mut &basic.progresses
        mut item := items.take(id)
        result := basic_place_progresses(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_DIVIDER {
        basic := mut &s.basics
        items := mut &basic.dividers
        mut item := items.take(id)
        result := basic_place_dividers(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_BADGE {
        basic := mut &s.basics
        items := mut &basic.badges
        mut item := items.take(id)
        result := basic_place_badges(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    if n.kind == SCREEN_CARD {
        basic := mut &s.basics
        items := mut &basic.cards
        mut item := items.take(id)
        result := basic_place_cards(mut &item,bounds,&styles)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0
    }
    << 0
}
fn (s &mut Screen) basic_input(id int,kind int,event &ui.InputEvent) Action {
    if s.basics.scrolls.has(id) { << s.scroll_input(id,kind,event) or >> }
    n := s.node(id) or >>
    if n.kind == SCREEN_RADIO_GROUP { mut item := s.take_basic_group(id)
        result := basic_group_input(mut &item,kind,event)
        s.basics.groups[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action }
    if n.kind == SCREEN_CHECKBOX {
        basic := mut &s.basics
        items := mut &basic.checks
        mut item := items.take(id)
        result := basic_input_checks(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_SWITCH {
        basic := mut &s.basics
        items := mut &basic.switches
        mut item := items.take(id)
        result := basic_input_switches(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_RADIO {
        basic := mut &s.basics
        items := mut &basic.radios
        mut item := items.take(id)
        result := basic_input_radios(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_SLIDER {
        basic := mut &s.basics
        items := mut &basic.sliders
        mut item := items.take(id)
        result := basic_input_sliders(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_STEPPER {
        basic := mut &s.basics
        items := mut &basic.steppers
        mut item := items.take(id)
        result := basic_input_steppers(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_TABS {
        basic := mut &s.basics
        items := mut &basic.tabs
        mut item := items.take(id)
        result := basic_input_tabs(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_SELECT {
        basic := mut &s.basics
        items := mut &basic.selects
        mut item := items.take(id)
        result := basic_input_selects(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_LIST {
        basic := mut &s.basics
        items := mut &basic.lists
        mut item := items.take(id)
        result := basic_input_lists(mut &item,kind,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    << no_action(id,false)
}
fn (s &mut Screen) basic_enable(id int,enabled bool) int {
