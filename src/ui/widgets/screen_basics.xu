fn (s &mut Screen) basic_paint(id int,frame &mut draw.Frame,styles &Styles,popup bool) int {
    if s.basics.scrolls.has(id) { if !popup { s.scroll_paint(id,frame,styles) or >> }
        << 0 }
    n := s.node(id) or >>
    if n.kind == SCREEN_RADIO_GROUP { mut item := s.take_basic_group(id)
        mut result := ""
        if !popup { result = basic_group_paint(mut &item,frame,styles) }
        s.basics.groups[id] = item
        if result.len > 0 { >> errors.new(result) }
        << 0 }
    if n.kind == SCREEN_CHECKBOX {
        item := s.take_basic_checks(id)
        mut message := ""
        if !popup {
            mut label := s.take_basic_label(id * 1024)
            message = basic_paint_checks(&item,mut &label,frame,styles)
            s.basics.labels[id * 1024] = label
        }
        s.basics.checks[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_SWITCH {
        item := s.take_basic_switches(id)
        mut message := ""
        if !popup {
            mut label := s.take_basic_label(id * 1024)
            message = basic_paint_switches(&item,mut &label,frame,styles)
            s.basics.labels[id * 1024] = label
        }
        s.basics.switches[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_RADIO {
        item := s.take_basic_radios(id)
        mut message := ""
        if !popup {
            mut label := s.take_basic_label(id * 1024)
            message = basic_paint_radios(&item,mut &label,frame,styles)
            s.basics.labels[id * 1024] = label
        }
        s.basics.radios[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_SLIDER {
        item := s.take_basic_sliders(id)
        mut message := ""
        if !popup {
            message = basic_paint_sliders(&item,frame,styles)
            if message.len == 0 && item.shows_value() {
                mut label := s.take_basic_label(id * 1024)
                message = basic_slider_value(&item,mut &label,frame,styles)
                s.basics.labels[id * 1024] = label
            }
        }
        s.basics.sliders[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_STEPPER {
        item := s.take_basic_steppers(id)
        mut message := ""
        if !popup {
            mut label := s.take_basic_label(id * 1024)
            message = basic_paint_steppers(&item,mut &label,frame,styles)
            s.basics.labels[id * 1024] = label
        }
        s.basics.steppers[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_TABS {
        item := s.take_basic_tabs(id)
        mut message := ""
        if !popup { message = basic_box_tabs(&item,frame,styles)
            if message.len == 0 { for i in 0:item.count() {
                mut label := s.take_basic_label(id * 1024 + i)
                message = basic_paint_tabs(&item,mut &label,frame,styles,i,false)
                s.basics.labels[id * 1024 + i] = label
                if message.len > 0 { <- } } }
        }
        s.basics.tabs[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_SELECT {
        item := s.take_basic_selects(id)
        mut message := ""
        if popup { message = basic_box_selects(&item,frame,styles)
            if message.len == 0 { for i in 0:item.count() {
                mut label := s.take_basic_label(id * 1024 + i)
                message = basic_paint_selects(&item,mut &label,frame,styles,i,true)
                s.basics.labels[id * 1024 + i] = label
                if message.len > 0 { <- } } }
        } else {
            key := id * 1024 + max_int(0,item.selected())
            mut label := s.take_basic_label(key)
            message = basic_paint_selects(&item,mut &label,frame,styles,0,false)
            s.basics.labels[key] = label
        }
        s.basics.selects[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_LIST {
        item := s.take_basic_lists(id)
        mut message := ""
        if !popup { message = basic_box_lists(&item,frame,styles)
            if message.len == 0 { for i in 0:item.count() {
                mut label := s.take_basic_label(id * 1024 + i)
                key := id * 1024 + i
                if s.basics.secondary.has(key) || s.basics.details.has(key) || s.basics.list_icons.has(key) {
                    mut secondary := s.take_list_label(key,false)
                    mut detail := s.take_list_label(key,true)
                    icon := s.basics.list_icons.get_or(key,TREE_ICON_NONE)
                    message = screen_paint_list_row(&item,mut &label,mut &secondary,mut &detail,icon,frame,styles,i)
                    s.basics.secondary[key] = secondary
                    s.basics.details[key] = detail
                } else { message = basic_paint_lists(&item,mut &label,frame,styles,i,false) }
                s.basics.labels[id * 1024 + i] = label
                if message.len > 0 { <- } } }
        }
        s.basics.lists[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_PROGRESS {
        item := s.take_basic_progresses(id)
        mut message := ""
        if !popup { message = basic_paint_progresses(&item,frame,styles) }
        s.basics.progresses[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_DIVIDER {
        item := s.take_basic_dividers(id)
        mut message := ""
        if !popup { message = basic_paint_dividers(&item,frame,styles) }
        s.basics.dividers[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_BADGE {
        item := s.take_basic_badges(id)
        mut message := ""
        if !popup {
            mut label := s.take_basic_label(id * 1024)
            message = basic_paint_badges(&item,mut &label,frame,styles)
            s.basics.labels[id * 1024] = label
        }
        s.basics.badges[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    if n.kind == SCREEN_CARD {
        item := s.take_basic_cards(id)
        mut message := ""
        if !popup { message = basic_paint_cards(&item,frame,styles) }
        s.basics.cards[id] = item
        if message.len > 0 { >> errors.new(message) }
        << 0
    }
    << 0
}
fn (s &mut Screen) basic_dispose(id int) int {
    if s.basics.scrolls.has(id) { << 0 }
    n := s.node(id) or >>
    if n.kind == SCREEN_RADIO_GROUP { mut item := s.take_basic_group(id)
        item.dispose()
        s.basics.groups[id] = item
        << 0 }
    basic := mut &s.basics
    mut count := 0
    if id <= basic.counts.len { count = basic.counts[id - 1] }
    labels := mut &basic.labels
    for i in 0:count { key := id * 1024 + i
        if labels.has(key) { mut label := labels.take(key)
            label.dispose() } }
    secondary := mut &basic.secondary
    for i in 0:count { key := id * 1024 + i
        if secondary.has(key) { mut label := secondary.take(key)
            label.dispose() } }
    details := mut &basic.details
    for i in 0:count { key := id * 1024 + i
        if details.has(key) { mut label := details.take(key)
            label.dispose() } }
    << 0
}
fn (s &mut Screen) basic_popup(id int) layout.Rect {
    n := s.node(id) or >>
    if n.kind == SCREEN_SELECT { styles := s.styles.clone()
        basic := mut &s.basics
        items := mut &basic.selects
        item := items.take(id)
        mut result := screen_empty()
        if item.is_open() { result=item.popup_bounds(&styles) }
        items[id] = item
        << result }
    << screen_empty()
}
fn (s &mut Screen) basic_popup_above(id int,above bool) int {
    n := s.node(id) or >>
    if n.kind == SCREEN_SELECT { basic := mut &s.basics
        items := mut &basic.selects
        mut item := items.take(id)
        item.set_popup_above(above)
        items[id] = item }
    << 0
}
pub fn (s &mut Screen) toggle_value(id int) bool {
    n := s.node(id) or >>
    if n.kind == SCREEN_CHECKBOX { basic := mut &s.basics
        items := mut &basic.checks
        item := items.take(id)
        result := item.value()
        items[id] = item
        << result }
    if n.kind == SCREEN_SWITCH { basic := mut &s.basics
        items := mut &basic.switches
        item := items.take(id)
        result := item.value()
        items[id] = item
        << result }
    if n.kind == SCREEN_RADIO { basic := mut &s.basics
        items := mut &basic.radios
        item := items.take(id)
        result := item.value()
        items[id] = item
        << result }
    >> errors.new("widgets: control has no matching value")
}
