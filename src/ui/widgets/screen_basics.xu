pub fn (s &mut Screen) set_toggle_value(id int,checked bool) int {
    n := s.node(id) or >>
    if n.kind == SCREEN_CHECKBOX { basic := mut &s.basics
        items := mut &basic.checks
        mut item := items.take(id)
        result := set_toggle_value_checks(mut &item,checked)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_SWITCH { basic := mut &s.basics
        items := mut &basic.switches
        mut item := items.take(id)
        result := set_toggle_value_switches(mut &item,checked)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_RADIO { basic := mut &s.basics
        items := mut &basic.radios
        mut item := items.take(id)
        result := set_toggle_value_radios(mut &item,checked)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    >> errors.new("widgets: control has no matching value")
}
fn set_toggle_value_checks(item &mut Checkbox,checked bool) string {
    item.set_value(checked)
    << ""
}
fn set_toggle_value_switches(item &mut Switch,checked bool) string {
    item.set_value(checked)
    << ""
}
fn set_toggle_value_radios(item &mut Radio,checked bool) string {
    item.set_value(checked)
    << ""
}
pub fn (s &mut Screen) set_number_value(id int,value f64) int {
    n := s.node(id) or >>
    if n.kind == SCREEN_SLIDER { basic := mut &s.basics
        items := mut &basic.sliders
        mut item := items.take(id)
        result := set_number_value_sliders(mut &item,value)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_STEPPER { basic := mut &s.basics
        items := mut &basic.steppers
        mut item := items.take(id)
        result := set_number_value_steppers(mut &item,value)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_PROGRESS { basic := mut &s.basics
        items := mut &basic.progresses
        mut item := items.take(id)
        result := set_number_value_progresses(mut &item,value)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    >> errors.new("widgets: control has no matching value")
}
fn set_number_value_sliders(item &mut Slider,value f64) string {
    item.set_value(value) or (err) { << err.msg() }
    << ""
}
fn set_number_value_steppers(item &mut Stepper,value f64) string {
    item.set_value(value) or (err) { << err.msg() }
    << ""
}
fn set_number_value_progresses(item &mut Progress,value f64) string {
    item.set_value(value) or (err) { << err.msg() }
    << ""
}
fn (s &mut Screen) basic_set_selected(id int,index int) int {
    n := s.node(id) or >>
    if n.kind == SCREEN_RADIO_GROUP { mut item := s.take_basic_group(id)
        result := basic_group_selected(mut &item,index)
        s.basics.groups[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TABS { basic := mut &s.basics
        items := mut &basic.tabs
        mut item := items.take(id)
        result := basic_set_selected_tabs(mut &item,index)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_SELECT { basic := mut &s.basics
        items := mut &basic.selects
        mut item := items.take(id)
        result := basic_set_selected_selects(mut &item,index)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_LIST { basic := mut &s.basics
        items := mut &basic.lists
        mut item := items.take(id)
        result := basic_set_selected_lists(mut &item,index)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    >> errors.new("widgets: control has no matching value")
}
fn basic_set_selected_tabs(item &mut Tabs,index int) string {
    item.set_selected(index) or (err) { << err.msg() }
    << ""
}
fn basic_set_selected_selects(item &mut Select,index int) string {
    item.set_selected(index) or (err) { << err.msg() }
    << ""
}
fn basic_set_selected_lists(item &mut ListBox,index int) string {
