pub fn (s &mut Screen) segmented(options &[]string,selected int) int {
    id := s.tabs(options,selected) or >>
    basic := mut &s.basics
    items := mut &basic.tabs
    mut item := items.take(id)
    item.segmented_val = true
    items[id] = item
    << id
}
fn basic_place_checks(item &mut Checkbox,bounds &layout.Rect,styles &Styles) string {
    item.set_bounds(bounds) or (err) { << err.msg() }
    << ""
}
fn basic_input_checks(item &mut Checkbox,kind int,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    result.action = item.route(kind,event) or (err) { << refined_failure(err.msg()) }
    << result
}
fn basic_style_checks(item &mut Checkbox,style &ControlStyle) string {
