pub fn (s &mut Screen) slider(minimum f64,maximum f64,value f64) int {
    id := s.add_node(SCREEN_SLIDER,true,ui.CURSOR_RESIZE_HORIZONTAL) or >>
    empty := screen_empty()
    item := slider(&s.identity,id,&empty,minimum,maximum,value) or (err) { s.abandon_node(id)
        >> err }
    s.basic_labels(id,&[""]) or (err) { s.abandon_node(id)
        >> err }
    basic := mut &s.basics
    basic.sliders[id] = item
    s.apply_current_locale(id) or >>
    << id
}
pub fn (s &mut Screen) stepper(minimum f64,maximum f64,step f64,value f64) int {
    id := s.add_node(SCREEN_STEPPER,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    item := stepper(&s.identity,id,&empty,minimum,maximum,step,value) or (err) { s.abandon_node(id)
        >> err }
    s.basic_labels(id,&["0"]) or (err) { s.abandon_node(id)
        >> err }
    basic := mut &s.basics
    basic.steppers[id] = item
    s.apply_current_locale(id) or >>
    << id
}
pub fn (s &mut Screen) tabs(options &[]string,selected int) int {
    id := s.add_node(SCREEN_TABS,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    item := tabs(&s.identity,id,&empty,options.len,selected) or (err) { s.abandon_node(id)
        >> err }
    s.basic_labels(id,options) or (err) { s.abandon_node(id)
        >> err }
    basic := mut &s.basics
    basic.tabs[id] = item
    << id
}
pub fn (s &mut Screen) select_box(options &[]string,selected int) int {
    id := s.add_node(SCREEN_SELECT,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    mut initial := selected
    if options.len==0 { initial=-1 }
    item := select_box(&s.identity,id,&empty,options.len,initial) or (err) { s.abandon_node(id)
        >> err }
    if options.len==0 { s.basic_labels(id,&[s.locale.text(TEXT_NO_OPTIONS) or >>]) or (err) { s.abandon_node(id)
        >> err } }
    else { s.basic_labels(id,options) or (err) { s.abandon_node(id)
        >> err } }
    basic := mut &s.basics
    basic.selects[id] = item
    s.apply_current_locale(id) or >>
    << id
}
