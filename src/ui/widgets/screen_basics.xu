pub fn (s &mut Screen) radio_group(options &[]string,selected int) int {
    id := s.add_node(SCREEN_RADIO_GROUP,true,ui.CURSOR_HAND) or >>
    empty := screen_empty()
    item := radio_group(&s.context,&s.identity,id,&empty,options,selected) or (err) { s.abandon_node(id)
        >> err }
    basic := mut &s.basics
    basic.groups[id] = item
    << id
}
fn (s &mut Screen) take_basic_group(id int) RadioGroup { basic := mut &s.basics
    items := mut &basic.groups
    << items.take(id) }
fn basic_group_place(item &mut RadioGroup,bounds &layout.Rect) string { item.set_bounds(bounds) or (err) { << err.msg() }
    << "" }
fn basic_group_input(item &mut RadioGroup,kind int,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    result.action = item.route(kind,event) or (err) { << refined_failure(err.msg()) }
    << result }
fn basic_group_paint(item &mut RadioGroup,frame &mut draw.Frame,styles &Styles) string { item.paint_styled(frame,styles) or (err) { << err.msg() }
    << "" }
fn basic_group_style(item &mut RadioGroup,style &ControlStyle) string { item.set_style(style) or (err) { << err.msg() }
    << "" }
fn basic_group_selected(item &mut RadioGroup,index int) string { item.set_selected(index) or (err) { << err.msg() }
    << "" }

fn screen_switch_tick(item &mut Switch,now time.Instant,reduced bool) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}
fn (s &mut Screen) basic_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    n := s.node(id) or >>
    if n.kind == SCREEN_CHECKBOX { mut item := s.take_basic_checks(id)
        result := screen_tick_check(mut &item,now,reduced)
        s.basics.checks[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if n.kind == SCREEN_RADIO { mut item := s.take_basic_radios(id)
        result := screen_tick_radio(mut &item,now,reduced)
        s.basics.radios[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    if n.kind == SCREEN_STEPPER { mut item := s.take_basic_steppers(id)
        result := screen_stepper_tick(mut &item,now)
        s.basics.steppers[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        if result.action.kind != ACTION_NONE { s.queued_actions.push(result.action) }
        << ScreenAnimation{changed: result.action.needs_paint,deadline: result.deadline} }
    if n.kind == SCREEN_SWITCH { mut item := s.take_basic_switches(id)
        result := screen_switch_tick(mut &item,now,reduced)
        s.basics.switches[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        << ScreenAnimation{changed: result.changed,deadline: result.deadline} }
    << ScreenAnimation{changed: false,deadline: time.zero_instant()}
}

fn screen_stepper_tick(item &mut Stepper,now time.Instant) RefinedResult {
    mut result := refined_result()
    result.action = item.tick(now) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    << result
}
