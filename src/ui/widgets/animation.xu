@ui/widgets

#errors
#math
#time

pub const ANIMATION_IDLE = 0
pub const ANIMATION_RUNNING = 1
pub const ANIMATION_PAUSED = 2
pub const ANIMATION_FINISHED = 3

// A clock-driven, reusable timeline. Zero iterations means repeat indefinitely.
// The owner schedules next_tick() and applies value() to its own visual state.
pub struct AnimationOptions {
    pub duration time.Duration
    pub delay time.Duration
    pub iterations int
    pub alternate bool
    pub curve int
    pub rate f64
}
pub fn animation_options() AnimationOptions {
    << AnimationOptions{duration: time.duration(240 * time.millisecond()),delay: time.duration(0),iterations: 1,
        alternate: false,curve: EASE_OUT_QUART,rate: 1.0}
}
pub fn (options &AnimationOptions) validate() int {
    if options.duration.nanoseconds() <= 0 || options.duration.nanoseconds() > 3600 * time.second() ||
       options.delay.is_negative() || options.delay.nanoseconds() > 3600 * time.second() ||
       options.iterations < 0 || options.iterations > 10000 || (math.is_nan(options.rate) || math.is_inf(options.rate)) || options.rate <= 0.0 || options.rate > 16.0 ||
       options.curve < EASE_LINEAR || options.curve > EASE_IN_QUINT { >> errors.new("widgets: invalid animation options") }
    << 0
}
pub struct AnimationController {
    pub options AnimationOptions
    state int
    phase f64
    delay_left f64
    direction f64
    pub stamp time.Instant
}
pub fn animation_controller(options &AnimationOptions) AnimationController {
    options.validate() or >>
    << AnimationController{options: AnimationOptions{duration: options.duration,delay: options.delay,
        iterations: options.iterations,alternate: options.alternate,curve: options.curve,rate: options.rate},
        state: ANIMATION_IDLE,phase: 0.0,delay_left: 0.0,direction: 1.0,stamp: time.zero_instant()}
}
pub fn (a &AnimationController) state() int { << a.state }
pub fn (a &AnimationController) is_running() bool { << a.state == ANIMATION_RUNNING }
pub fn (a &AnimationController) progress() f64 {
    $cycle := int(math.floor(a.phase))
    $fraction := a.phase - f64(cycle)
    if a.options.iterations == 0 && a.state == ANIMATION_FINISHED && a.phase >= 1.0 { cycle = 0
        fraction = 1.0 }
    if a.options.iterations > 0 && a.phase >= f64(a.options.iterations) { cycle = a.options.iterations - 1
        fraction = 1.0 }
    if a.options.alternate && cycle % 2 == 1 { fraction = 1.0 - fraction }
    << fraction
}
pub fn (a &AnimationController) value() f64 { << motion_ease(a.options.curve,a.progress()) }
pub fn (a $&AnimationController) play(now time.Instant,reduced_motion bool) int {
    a.phase = 0.0
    a.direction = 1.0
    a.delay_left = f64(a.options.delay.nanoseconds())
    a.stamp = now
    a.state = ANIMATION_RUNNING
    if reduced_motion { a.finish() }
    << 0
}
pub fn (a $&AnimationController) finish() {
    a.phase = f64(max_int(1,a.options.iterations))
    a.delay_left = 0.0
    a.state = ANIMATION_FINISHED
}
pub fn (a $&AnimationController) cancel() { a.phase = 0.0
    a.delay_left = 0.0
    a.direction = 1.0
    a.state = ANIMATION_IDLE }
pub fn (a $&AnimationController) advance(now time.Instant,reduced_motion bool) bool {
    before := a.value()
    if !a.is_running() { << false }
    if reduced_motion { a.finish()
        << before != a.value() }
    elapsed := now.since(a.stamp).nanoseconds()
    if elapsed <= 0 { << false }
    a.stamp = now
    $travel := f64(elapsed) * a.options.rate
    if a.delay_left > 0.0 { used := math.min(a.delay_left,travel)
        a.delay_left = a.delay_left - used
        travel = travel - used }
    a.phase = a.phase + travel / f64(a.options.duration.nanoseconds()) * a.direction
    if a.phase <= 0.0 && a.direction < 0.0 { a.phase = 0.0
        a.state = ANIMATION_FINISHED }
    if a.options.iterations > 0 && a.phase >= f64(a.options.iterations) { a.finish() }
    // Infinite loops keep a bounded phase without iterating once per cycle.
    if a.options.iterations == 0 && a.phase > 10000.0 { a.phase = a.phase - math.floor(a.phase / 2.0) * 2.0 }
    << before != a.value()
}
pub fn (a $&AnimationController) pause(now time.Instant) int {
    _ := a.advance(now,false) or >>
    if a.is_running() { a.state = ANIMATION_PAUSED }
    << 0
}
pub fn (a $&AnimationController) resume(now time.Instant) {
    if a.state == ANIMATION_PAUSED { a.stamp = now
        a.state = ANIMATION_RUNNING }
}
pub fn (a $&AnimationController) reverse(now time.Instant) int {
    _ := a.advance(now,false) or >>
    a.direction = 0.0 - a.direction
    a.delay_left = 0.0
    a.stamp = now
    if a.phase <= 0.0 && a.direction < 0.0 { a.phase = f64(max_int(1,a.options.iterations)) }
    a.state = ANIMATION_RUNNING
    << 0
}
pub fn (a $&AnimationController) seek(progress f64,now time.Instant) int {
    if (math.is_nan(progress) || math.is_inf(progress)) || progress < 0.0 || progress > 1.0 { >> errors.new("widgets: animation progress must be between zero and one") }
    a.phase = progress
    a.delay_left = 0.0
    a.stamp = now
    if a.state == ANIMATION_IDLE || a.state == ANIMATION_FINISHED { a.state = ANIMATION_PAUSED }
    << 0
}
pub fn (a &AnimationController) next_tick(now time.Instant) time.Instant {
    if !a.is_running() { << time.zero_instant() }
    if a.delay_left > 0.0 { << now.add(time.duration(max_int(1,int(a.delay_left / a.options.rate)))) or >> }
    << overlay_next_tick(true,now) or >>
}

// Shared by widget tweens, data transitions and application-owned timelines.
pub fn motion_ease(curve int,fraction f64) f64 {
    t := math.max(0.0,math.min(1.0,fraction))
    r := 1.0 - t
    if curve == EASE_LINEAR { << t }
    if curve == EASE_OUT_QUINT { << 1.0 - r * r * r * r * r }
    if curve == EASE_IN_QUART { << t * t * t * t }
    if curve == EASE_IN_QUINT { << t * t * t * t * t }
    if curve == EASE_IN_OUT_CUBIC { if t < 0.5 { << 4.0 * t * t * t }
        << 1.0 - 4.0 * r * r * r }
    << 1.0 - r * r * r * r
}
pub fn motion_lerp(from f64,to f64,progress f64) f64 { << from + (to - from) * math.max(0.0,math.min(1.0,progress)) }
