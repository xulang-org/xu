@ui/widgets
#ui/draw
#ui/layout
#math

// Only the outer corners round off. Interior seams remain square and flush.
fn group_corner_path(b &layout.Rect,radius f64,first bool,last bool,vertical bool) draw.Path {
    r := math.min(radius,math.min(b.width,b.height) * 0.5)
    $tl := 0.0
    $tr := 0.0
    $bl := 0.0
    $br := 0.0
    if first { tl = r
        if vertical { tr = r } else { bl = r } }
    if last { br = r
        if vertical { bl = r } else { tr = r } }
    x := b.x
    y := b.y
    right := x + b.width
    bottom := y + b.height
    k := 0.5522847498307936
    $p := draw.new_path(400)
    p.move_to(x + tl,y) or >>
    p.line_to(right - tr,y) or >>
    p.cubic_to(right - tr + tr * k,y,right,y + tr - tr * k,right,y + tr) or >>
    p.line_to(right,bottom - br) or >>
    p.cubic_to(right,bottom - br + br * k,right - br + br * k,bottom,right - br,bottom) or >>
    p.line_to(x + bl,bottom) or >>
    p.cubic_to(x + bl - bl * k,bottom,x,bottom - bl + bl * k,x,bottom - bl) or >>
    p.line_to(x,y + tl) or >>
    p.cubic_to(x,y + tl - tl * k,x + tl - tl * k,y,x + tl,y) or >>
    p.close() or >>
    << p
}
fn (g &ButtonGroup) paint_joined(frame $&draw.Frame,index int,b &layout.Rect,style &ControlStyle,density f64,state int) int {
    paint := style.resolve(state)
    path := group_corner_path(b,style.radius * density,index == 0,index == g.items.len - 1,g.appearance.vertical) or >>
    frame.fill_path(&path,paint.background,draw.FILL_NONZERO) or >>
    stroke := draw.stroke_options(style.border_width * density)
    if style.border_width > 0.0 { frame.stroke_path(&path,paint.border,&stroke) or >> }
    if (state & STATE_FOCUSED) != 0 && (state & STATE_DISABLED) == 0 {
        inset := style.focus_inset * density
        bounds := layout.Rect{x: b.x + inset,y: b.y + inset,width: math.max(0.0,b.width - inset * 2.0),height: math.max(0.0,b.height - inset * 2.0)}
        rounded_stroke(frame,&bounds,math.max(2.0,style.radius * density - inset),paint.focus,style.focus_width * density) or >> }
    << 0
}
