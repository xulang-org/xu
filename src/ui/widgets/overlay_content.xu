@ui/widgets
#ui/layout
#math
#errors

struct CaptionHeight { height f64
    error string }
fn (s $&Screen) caption_height(id int,width f64,style &ControlStyle) f64 {
    key := id * 2
    if !s.labels.has(key) { s.labels[key] = text_cache(&s.context) }
    value := s.texts[id - 1] + ""
    styles := s.styles.clone()
    $cache := s.take_label_cache(key)
    result := measure_caption_height($&cache,&value,width,&styles,style)
    s.labels[key] = cache
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.height
}
fn measure_caption_height(cache $&TextCache,value &string,width f64,styles &Styles,style &ControlStyle) CaptionHeight {
    $options := styles.text_options(style)
    options.width = math.max(1.0,width - (style.padding.left + style.padding.right) * styles.density)
    size := cache.measure_options(0,value,&options) or (err) { << CaptionHeight{height: 0.0,error: err.msg()} }
    << CaptionHeight{height: size.height + (style.padding.top + style.padding.bottom) * styles.density,error: ""}
}
