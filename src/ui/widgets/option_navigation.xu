@ui/widgets

#ui
#strings

fn (s $&Screen) basic_typeahead(id int,event &ui.InputEvent) Action {
    if event.kind!=ui.EV_KEY_DOWN || s.focused!=id || event.key<32 || event.key>126 || (event.modifiers&(ui.MOD_CONTROL|ui.MOD_META|ui.MOD_ALT))!=0 { << no_action(id,false) }
    kind := s.nodes[id-1].kind
    if kind!=SCREEN_SELECT && kind!=SCREEN_LIST && kind!=SCREEN_TABS { << no_action(id,false) }
    $read_only := false
    if kind==SCREEN_SELECT { read_only=s.basics.selects[id].is_read_only() }
    if kind==SCREEN_LIST { read_only=s.basics.lists[id].is_read_only() }
    if kind==SCREEN_TABS { read_only=s.basics.tabs[id].is_read_only()
        if !s.basics.tabs[id].is_automatic() { << no_action(id,false) } }
    if read_only || event.key==32 { << no_action(id,false) }
    query := string_from_bytes([event.key])
    selected := s.find_next_option(id,&query) or >>
    if selected<0 { << no_action(id,false) }
    << Action{kind:ACTION_CHANGE,id:id,needs_paint:true,request_focus:false,consumed:true,value:f64(selected)}
}
// Unicode callers can provide a complete prefix from an editor or command.
pub fn (s $&Screen) find_next_option(id int,prefix &string) int {
    n := s.node(id) or >>
    if n.kind!=SCREEN_SELECT && n.kind!=SCREEN_LIST && n.kind!=SCREEN_TABS { << -1 }
    if prefix.len==0 { << -1 }
    current := s.basic_selected(id) or >>
    count := s.basics.counts[id-1]
    if n.kind==SCREEN_SELECT && s.basics.selects[id].count()==0 { << -1 }
    if count<=0 { << -1 }
    folded := strings.to_lower(prefix)
    for step in 1:count+1 {
        candidate := (current+step+count)%count
        if n.kind==SCREEN_SELECT && !s.basics.selects[id].option_available(candidate) { -> }
        text := s.basics.labels[id*1024+candidate].text()
        label := strings.to_lower(&text)
        if strings.has_prefix(&label,folded+"") {
            s.basic_set_selected(id,candidate) or >>
            << candidate
        }
    }
    << -1
}
