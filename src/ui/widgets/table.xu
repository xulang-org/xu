@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

// A bounded single-line, equal-width column table: 1..16 columns and at most
// 768 cells (512 rows). Sorting emits action_activate; the caller owns order.
// Only visible rows are shaped, and their cache slots are reused on scroll.
pub struct Table {
    rows ListBox
    outer layout.Rect
    headers []string
    cells []string
    labels TextCache
    header_h f64
    sort_col int
    header_cursor int
    descending bool
    hot_header int
    armed_header int
}
fn validate_table_text(value &string) int {
    if value.len > 4096 { >> errors.new("widgets: table text exceeds 4096 bytes") }
    for i in 0:value.len { if value[i] == 10 || value[i] == 13 { >> errors.new("widgets: data labels must be single line") } }
    << 0
}
pub fn table(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,headers &[]string,rows int,selected int) Table {
    if headers.len < 1 || headers.len > 16 || rows < 0 || rows > 512 || rows * headers.len > 768 || (rows == 0 && selected != -1) {
        >> errors.new("widgets: table exceeds 16 columns, 512 rows or 768 cells")
    }
    if !context.matches_canvas(identity) { >> errors.new("widgets: table context mismatch") }
    mut titles := []string{}
    for title in headers { validate_table_text(&title) or >>
        titles.push(title + "") }
    mut cells := []string{}
    for i in 0:rows * headers.len { cells.push("") }
    control := list_box(identity,id,bounds,rows,selected) or >>
    mut result := Table{rows: control,outer: copy_rect(bounds),headers: titles,cells: cells,labels: text_cache(context),
        header_h: 32.0,sort_col: -1,header_cursor: 0,descending: false,hot_header: -1,armed_header: -1}
    result.set_bounds(bounds) or >>
    << result
}
pub fn (t &Table) id() int { << t.rows.id }
pub fn (t &Table) bounds() layout.Rect { << copy_rect(&t.outer) }
pub fn (t &Table) count() int { << t.rows.count_val }
pub fn (t &Table) column_count() int { << t.headers.len }
pub fn (t &Table) selected() int { << t.rows.selected_val }
pub fn (t &Table) sort_column() int { << t.sort_col }
pub fn (t &Table) sort_descending() bool { << t.descending }
pub fn (t &Table) scroll_offset() f64 { << t.rows.scroll_y }
pub fn (t &Table) needs_paint() bool { << t.rows.dirty }
pub fn (t &mut Table) painted() { t.rows.dirty = false }
pub fn (t &Table) is_enabled() bool { << t.rows.enabled && !t.rows.closed && t.outer.width > 0.0 && t.outer.height > 0.0 }
pub fn (t &Table) is_focused() bool { << t.rows.focused }
pub fn (t &Table) is_read_only() bool { << t.rows.read_only }
pub fn (t &mut Table) cancel() { t.hot_header = -1
    t.armed_header = -1
    rows := mut &t.rows
    rows.cancel() }
pub fn (t &mut Table) set_focus(focused bool) { rows := mut &t.rows
    rows.set_focus(focused) }
pub fn (t &mut Table) set_enabled(enabled bool) { rows := mut &t.rows
    rows.set_enabled(enabled)
    if !enabled { t.hot_header = -1
        t.armed_header = -1 } }
pub fn (t &mut Table) set_read_only(value bool) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := mut &t.rows
    rows.set_read_only(value)
    t.armed_header = -1
    << 0
}
pub fn (t &mut Table) set_cell(row int,column int,text &string) int {
    if t.rows.closed || row < 0 || row >= t.count() || column < 0 || column >= t.column_count() { >> errors.new("widgets: invalid table cell") }
    validate_table_text(text) or >>
    index := row * t.column_count() + column
    if t.cells[index] != text + "" { t.cells[index] = text + ""
        t.rows.dirty = true }
    << 0
}
pub fn (t &Table) cell(row int,column int) string {
    if row < 0 || row >= t.count() || column < 0 || column >= t.column_count() { >> errors.new("widgets: invalid table cell") }
    index := row * t.column_count() + column
    << t.cells[index] + ""
}
pub fn (t &mut Table) set_rows(count int) int {
    if t.rows.closed || count < 0 || count > 512 || count * t.column_count() > 768 { >> errors.new("widgets: invalid table row count") }
    mut cells := []string{}
    size := count * t.column_count()
    for i in 0:size { if i < t.cells.len { cells.push(t.cells[i] + "") }
        else { cells.push("") } }
    t.cells = cells
    rows := mut &t.rows
    rows.armed_idx = -1
    << rows.set_count(count) or >>
}
pub fn (t &mut Table) set_selected(index int) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := mut &t.rows
    << rows.set_selected(index) or >> }
pub fn (t &mut Table) set_scroll_offset(offset f64) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := mut &t.rows
    << rows.set_scroll_offset(offset) or >> }
pub fn (t &mut Table) set_bounds(bounds &layout.Rect) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    validate_bounds(bounds) or >>
    if t.outer.x != bounds.x || t.outer.y != bounds.y || t.outer.width != bounds.width || t.outer.height != bounds.height {
        t.hot_header = -1
        t.armed_header = -1
    }
    t.outer = copy_rect(bounds)
    header := math.min(t.header_h,bounds.height)
    body := layout.Rect{x: bounds.x,y: bounds.y + header,width: bounds.width,height: math.max(0.0,bounds.height - header)}
    rows := mut &t.rows
    << rows.set_bounds(&body) or >>
}
pub fn (t &Table) style_or(styles &Styles) ControlStyle { << t.rows.style_or(styles) }
pub fn (t &mut Table) set_style(style &ControlStyle) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := mut &t.rows
    << rows.set_style(style) or >> }
pub fn (t &mut Table) clear_style() { rows := mut &t.rows
    rows.clear_style() }
pub fn (t &mut Table) apply_styles(styles &Styles) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    styles.validate() or >>
    c := t.style_or(styles)
    cache := mut &t.labels
    sample := cache.measure(1023,&"Ag国",styles,&c) or >>
    d := styles.density
    height := math.max(c.indicator_size * d,sample.height + (c.padding.top + c.padding.bottom) * d)
    padding := layout.Insets{left: c.padding.left * d,top: c.padding.top * d,right: c.padding.right * d,bottom: c.padding.bottom * d}
    changed := t.rows.row_h != height || t.header_h != height || t.rows.padding.left != padding.left || t.rows.padding.top != padding.top ||
        t.rows.padding.right != padding.right || t.rows.padding.bottom != padding.bottom
    rows := mut &t.rows
    rows.padding = padding
    rows.row_h = height
    rows.scroll_y = math.max(0.0,math.min(rows.max_scroll(),rows.scroll_y))
    t.header_h = height
    if changed { b := t.bounds()
        t.hot_header = -1
        t.armed_header = -1
        t.set_bounds(&b) or >>
        t.rows.dirty = true }
    << 0
}
pub fn (t &Table) row_bounds(row int) layout.Rect {
    b := t.rows.bounds()
    if row < 0 || row >= t.count() { << layout.Rect{x: b.x,y: b.y,width: 0.0,height: 0.0} }
    << layout.Rect{x: b.x + t.rows.padding.left,y: b.y + t.rows.padding.top + f64(row) * t.rows.row_h - t.rows.scroll_y,
        width: math.max(0.0,b.width - t.rows.padding.left - t.rows.padding.right),height: t.rows.row_h}
}
pub fn (t &Table) header_bounds(column int) layout.Rect {
    b := t.bounds()
    if column < 0 || column >= t.column_count() { << layout.Rect{x: b.x,y: b.y,width: 0.0,height: 0.0} }
    w := b.width / f64(t.column_count())
    << layout.Rect{x: b.x + f64(column) * w,y: b.y,width: w,height: math.min(t.header_h,b.height)}
}
fn (t &Table) hit_header(x f64,y f64) int {
    if t.outer.width <= 0.0 { << -1 }
    for i in 0:t.column_count() { if t.header_bounds(i).contains(x,y) { << i } }
    << -1
}
pub fn (t &mut Table) input(input &ui.InputEvent) Action {
    if t.rows.closed || !belongs(&t.rows.identity,input) { << no_action(t.id(),t.needs_paint()) }
    if input.kind == ui.EV_POINTER_CANCEL { t.cancel()
        << no_action(t.id(),t.needs_paint()) }
    if !t.is_enabled() { << no_action(t.id(),t.needs_paint()) }
    header := t.hit_header(input.x,input.y)
    if input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_LEAVE {
        mut hot := header
        if input.kind == ui.EV_POINTER_LEAVE { hot = -1 }
        if hot != t.hot_header { t.hot_header = hot
            t.rows.dirty = true }
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && header >= 0 {
        t.header_cursor = header
        t.rows.armed_idx = -1
        if !t.rows.read_only { t.armed_header = header }
        t.rows.dirty = true
        << Action{kind: ACTION_NONE,id: t.id(),needs_paint: true,request_focus: true,consumed: true,value: f64(header)}
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT { t.armed_header = -1 }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && t.armed_header >= 0 {
        mut kind := ACTION_NONE
        if !t.rows.read_only && header == t.armed_header {
            if t.sort_col == header { t.descending = !t.descending }
            else { t.sort_col = header
                t.descending = false }
            kind = ACTION_ACTIVATE
        }
        t.armed_header = -1
        t.rows.dirty = true
        << Action{kind: kind,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(header)}
    }
    // Left/right choose a header; Enter/Space request sorting. Up/down, Home,
    // End and Page Up/Down continue to navigate the data rows.
    if input.kind == ui.EV_KEY_DOWN && t.rows.focused && !t.rows.read_only {
        if input.key == ui.KEY_LEFT || input.key == ui.KEY_RIGHT {
            if input.key == ui.KEY_LEFT { t.header_cursor = max_int(0,t.header_cursor - 1) }
            else { t.header_cursor = min_int(t.column_count() - 1,t.header_cursor + 1) }
            t.rows.dirty = true
            << Action{kind: ACTION_NONE,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(t.header_cursor)}
        }
        if input.key == ui.KEY_ENTER || input.key == 32 {
            if t.sort_col == t.header_cursor { t.descending = !t.descending }
            else { t.sort_col = t.header_cursor
                t.descending = false }
            t.rows.dirty = true
            << Action{kind: ACTION_ACTIVATE,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(t.sort_col)}
        }
    }
    rows := mut &t.rows
    << rows.input(input) or >>
}
pub fn (t &mut Table) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if kind == ROUTE_FOCUS { t.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { t.cancel() }
    else { << t.input(input) or >> }
    << no_action(t.id(),t.needs_paint())
}
pub fn (t &mut Table) event(event &ui.Event) Action {
    if event.window_id != t.rows.identity.window_id { << no_action(t.id(),t.needs_paint()) }
    if event.kind == ui.EV_CLOSED { t.dispose()
        << no_action(t.id(),false) }
    if event.kind == ui.EV_BLURRED { t.cancel()
        << no_action(t.id(),t.needs_paint()) }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == t.rows.identity.canvas_id && identity.generation == t.rows.identity.generation { t.dispose() }
        << no_action(t.id(),t.needs_paint())
    }
    if !ui.is_input_event(event.kind) { << no_action(t.id(),t.needs_paint()) }
    input := ui.input_of(event) or >>
    << t.input(&input) or >>
}
pub fn (t &mut Table) measure_styled(styles &Styles) layout.Size {
    t.apply_styles(styles) or >>
    c := t.style_or(styles)
    mut width := 0.0
    count := t.column_count()
    for i in 0:count { text := t.headers[i] + "  ↕"
        cache := mut &t.labels
        sz := cache.measure(i,&text,styles,&c) or >>
        width = width + math.max(80.0 * styles.density,sz.width + 24.0 * styles.density) }
    << layout.Size{width: width,height: t.header_h + t.rows.row_h * f64(min_int(5,max_int(1,t.count()))) + (c.padding.top + c.padding.bottom) * styles.density}
}
pub fn (t &mut Table) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    t.apply_styles(styles) or >>
    c := t.style_or(styles)
    d := styles.density
    cols := t.column_count()
    t.rows.paint_box_styled(frame,styles) or >>
    for i in 0:cols {
        b := t.header_bounds(i)
        mut state := t.rows.visual_state() & (0 - 1 - STATE_HOVERED - STATE_PRESSED - STATE_FOCUSED)
        if t.rows.focused && i == t.header_cursor { state = state | STATE_FOCUSED }
        if i == t.hot_header { state = state | STATE_HOVERED }
        if i == t.armed_header && i == t.hot_header { state = state | STATE_PRESSED }
        style_box(frame,&b,&c,d,state) or >>
        mut text := t.headers[i] + ""
        if i == t.sort_col { if t.descending { text = text + "  ↓" }
            else { text = text + "  ↑" } }
        cache := mut &t.labels
        cache.paint_text(i,&text,frame,&b,styles,&c,state) or >>
    }
    body := t.rows.bounds()
    viewport := layout.Rect{x: body.x + t.rows.padding.left,y: body.y + t.rows.padding.top,
        width: math.max(0.0,body.width - t.rows.padding.left - t.rows.padding.right),height: math.max(0.0,body.height - t.rows.padding.top - t.rows.padding.bottom)}
    mut row_width := viewport.width
    if f64(t.count()) * t.rows.row_h > viewport.height { row_width = math.max(0.0,row_width - 10.0 * d) }
    first := max_int(0,int(t.rows.scroll_y / t.rows.row_h))
    last := min_int(t.count(),first + int(viewport.height / t.rows.row_h) + 2)
    frame.push() or >>
    frame.clip_rect(viewport.x,viewport.y,row_width,viewport.height) or >>
    for row in first:last {
        r := layout.Rect{x: viewport.x,y: viewport.y + f64(row) * t.rows.row_h - t.rows.scroll_y,width: row_width,height: t.rows.row_h}
        state := t.rows.item_visual_state(row)
        if row == t.rows.selected_val || row == t.rows.hovered_idx { rounded_fill(frame,&r,math.max(0.0,c.radius - 2.0) * d,c.resolve(state).background) or >> }
        for column in 0:cols {
            index := row * cols + column
            text := t.cells[index] + ""
            // Share header grid lines. Viewport padding and the scrollbar
            // clip the outer cells without shifting their text alignment.
            grid := t.header_bounds(column)
            cell := layout.Rect{x: grid.x,y: r.y,width: grid.width,height: r.height}
            slot := 16 + (row - first) * cols + column
            cache := mut &t.labels
            cache.paint_text(slot,&text,frame,&cell,styles,&c,state) or >>
        }
    }
    frame.pop() or >>
    << 0
}
pub fn (t &mut Table) dispose() {
    cache := mut &t.labels
    cache.dispose()
    t.cancel()
    t.rows.closed = true
}
