@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

// A bounded single-line, equal-width column table: 1..16 columns and at most
// 768 cells (512 rows). Header activation sorts locally unless manual mode is set.
// Only visible rows are shaped, and their cache slots are reused on scroll.
pub struct Table {
    locale Locale
    rows ListBox
    outer layout.Rect
    headers []string
    cells []string
    order []int
    sort_kinds []int
    local_sort bool
    sort_key_armed int
    labels TextCache
    header_h f64
    sort_col int
    header_cursor int
    descending bool
    hot_header int
    armed_header int
    minima []f64
    widths []f64
    alignments []f64
    density f64
    scroll_x f64
    resize_column int
    resize_x f64
    resize_width f64
    horizontal_drag bool
    horizontal_grab f64
    status_text string

}
fn validate_table_text(value &string) int {
    if value.len > 4096 { >> errors.new("widgets: table text exceeds 4096 bytes") }
    for i in 0:value.len { if value[i] == 10 || value[i] == 13 { >> errors.new("widgets: data labels must be single line") } }
    << 0
}
pub fn table(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,headers &[]string,rows int,selected int) Table {
    if headers.len < 1 || headers.len > 16 || rows < 0 || rows > 512 || rows * headers.len > 768 || (rows == 0 && selected != -1) {
        >> errors.new("widgets: table exceeds 16 columns, 512 rows or 768 cells")
    }
    if !context.matches_canvas(identity) { >> errors.new("widgets: table context mismatch") }
    $titles := []string{}
    for title in headers { validate_table_text(&title) or >>
        titles.push(title + "") }
    $cells := []string{}
    for i in 0:rows * headers.len { cells.push("") }
    control := list_box(identity,id,bounds,rows,selected) or >>
    $result := Table{locale: locale_default(),rows: control,outer: copy_rect(bounds),headers: titles,cells: cells,order: []int{},sort_kinds: []int{},local_sort: true,sort_key_armed: 0,labels: text_cache(context),
        header_h: 32.0,sort_col: -1,header_cursor: 0,descending: false,hot_header: -1,armed_header: -1,minima: []f64{},widths: []f64{},alignments: []f64{},density: 1.0,scroll_x: 0.0,
        resize_column: -1,resize_x: 0.0,resize_width: 0.0,horizontal_drag: false,horizontal_grab: 0.0,status_text: ""}
    for i in 0:rows { result.order.push(i) }
    for i in 0:headers.len { result.sort_kinds.push(TABLE_SORT_TEXT)
        result.minima.push(48.0)
        result.widths.push(0.0)
        result.alignments.push(0.0) }
    result.set_bounds(bounds) or >>
    << result
}
pub fn (t &Table) id() int { << t.rows.id }
pub fn (t &Table) bounds() layout.Rect { << copy_rect(&t.outer) }
pub fn (t &Table) count() int { << t.rows.count_val }
pub fn (t &Table) column_count() int { << t.headers.len }
pub fn (t &Table) selected() int { << t.rows.selected_val }
pub fn (t &Table) sort_column() int { << t.sort_col }
pub fn (t &Table) sort_descending() bool { << t.descending }
pub fn (t &Table) scroll_offset() f64 { << t.rows.scroll_y }
pub fn (t &Table) needs_paint() bool { << t.rows.needs_paint() }
pub fn (t $&Table) painted() { rows := $&t.rows
    rows.painted() }
pub fn (t &Table) is_selectable() bool { << t.rows.is_selectable() }
pub fn (t $&Table) set_selectable(selectable bool) { rows := $&t.rows
    rows.set_selectable(selectable) }
pub fn (t &Table) has_popup_open() bool { << t.rows.has_popup_open() }
pub fn (t &Table) popup_bounds() layout.Rect { << t.rows.popup_bounds() }
pub fn (t $&Table) set_viewport(viewport &layout.Rect) {
    ctx := t.labels.context.clone()
    rows := $&t.rows
    rows.set_viewport(viewport,&ctx)
}
pub fn (t $&Table) paint_popup_styled(frame $&draw.Frame,styles &Styles) int { rows := $&t.rows
    << rows.paint_popup_styled(frame,styles) or >> }
pub fn (t &Table) cursor() int {
    if t.has_popup_open() || !t.is_enabled() { << ui.CURSOR_DEFAULT }
    if t.resize_column >= 0 { << ui.CURSOR_RESIZE_HORIZONTAL }
    if t.horizontal_drag || t.rows.scroll_dragging || t.rows.scroll_hovered { << ui.CURSOR_HAND }
    if t.hot_header >= 0 {
        if !t.rows.read_only { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    if t.is_selectable() && t.rows.is_text_dragging() { << ui.CURSOR_TEXT }
    if t.rows.hovered_idx >= 0 {
        if !t.rows.read_only { << ui.CURSOR_HAND }
        if t.is_selectable() { << ui.CURSOR_TEXT }
    }
    << ui.CURSOR_DEFAULT
}
pub fn (t &Table) cursor_at(x f64,y f64) int {
    if !t.is_enabled() { << ui.CURSOR_DEFAULT }
    if t.has_popup_open() { << t.rows.popup_cursor_at(x,y) }
    if t.resize_column >= 0 { << ui.CURSOR_RESIZE_HORIZONTAL }
    if t.horizontal_drag || t.rows.scroll_dragging { << ui.CURSOR_HAND }
    if t.hit_column_resize(x,y) >= 0 { << ui.CURSOR_RESIZE_HORIZONTAL }
    if t.hit_header(x,y) >= 0 {
        if !t.rows.read_only { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    if t.content_width() > t.outer.width && t.horizontal_track().contains(x,y) {
        hthumb := t.horizontal_thumb() or (err) { << ui.CURSOR_DEFAULT }
        if x >= hthumb.x && x < hthumb.x + hthumb.width { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    if t.rows.scrollbar_contains(x,y) {
        if t.rows.scrollbar_thumb_contains(x,y) { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    if t.is_selectable() && t.rows.is_text_dragging() { << ui.CURSOR_TEXT }
    if t.rows.hit_row(x,y) >= 0 {
        if !t.rows.read_only { << ui.CURSOR_HAND }
        if t.is_selectable() { << ui.CURSOR_TEXT }
    }
    << ui.CURSOR_DEFAULT
}
pub fn (t &Table) is_enabled() bool { << t.rows.enabled && !t.rows.closed && t.outer.width > 0.0 && t.outer.height > 0.0 }
pub fn (t &Table) is_focused() bool { << t.rows.focused }
pub fn (t &Table) is_read_only() bool { << t.rows.read_only }
pub fn (t $&Table) cancel() {
    t.sort_key_armed = 0
    t.resize_column = -1
    t.horizontal_drag = false
    t.hot_header = -1
    t.armed_header = -1
    rows := $&t.rows
    rows.cancel() }
pub fn (t $&Table) set_focus(focused bool) { if !focused { t.sort_key_armed = 0
        t.resize_column = -1
        t.horizontal_drag = false
        t.armed_header = -1 }
    rows := $&t.rows
    rows.set_focus(focused) }
pub fn (t $&Table) set_enabled(enabled bool) { rows := $&t.rows
    rows.set_enabled(enabled)
    if !enabled { t.sort_key_armed = 0
        t.hot_header = -1
        t.armed_header = -1 } }
pub fn (t $&Table) set_read_only(value bool) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := $&t.rows
    rows.set_read_only(value)
    t.armed_header = -1
    t.sort_key_armed = 0
    << 0
}
pub fn (t $&Table) set_cell(row int,column int,text &string) int {
    if t.rows.closed || row < 0 || row >= t.count() || column < 0 || column >= t.column_count() { >> errors.new("widgets: invalid table cell") }
    validate_table_text(text) or >>
    index := row * t.column_count() + column
    if t.cells[index] != text + "" { t.cells[index] = text + ""
        t.rows.dirty = true
        if column == t.sort_col { t.refresh_sort() or >> } }
    << 0
}
pub fn (t &Table) cell(row int,column int) string {
    if row < 0 || row >= t.count() || column < 0 || column >= t.column_count() { >> errors.new("widgets: invalid table cell") }
    index := row * t.column_count() + column
    << t.cells[index] + ""
}
pub fn (t $&Table) set_rows(count int) int {
    if t.rows.closed || count < 0 || count > 512 || count * t.column_count() > 768 { >> errors.new("widgets: invalid table row count") }
    selected := t.selected_row() or >>
    $cells := []string{}
    size := count * t.column_count()
    for i in 0:size { if i < t.cells.len { cells.push(t.cells[i] + "") }
        else { cells.push("") } }
    t.cells = cells
    t.order = []int{}
    for row in 0:count { t.order.push(row) }
    rows := $&t.rows
    rows.armed_idx = -1
    rows.set_count(count) or >>
    if selected < count { rows.selected_val = selected } else { rows.selected_val = -1 }
    t.refresh_sort() or >>
    << 0
}
pub fn (t $&Table) set_selected(index int) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := $&t.rows
    << rows.set_selected(index) or >> }
pub fn (t $&Table) set_scroll_offset(offset f64) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := $&t.rows
    << rows.set_scroll_offset(offset) or >> }
pub fn (t $&Table) set_bounds(bounds &layout.Rect) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    validate_bounds(bounds) or >>
    if t.outer.x != bounds.x || t.outer.y != bounds.y || t.outer.width != bounds.width || t.outer.height != bounds.height {
        t.hot_header = -1
        t.armed_header = -1
    }
    t.outer = copy_rect(bounds)
    header := math.min(t.header_h,bounds.height)
    $bottom := 0.0
    if t.content_width() > bounds.width { bottom = 16.0 * t.density }
    body := layout.Rect{x: bounds.x,y: bounds.y + header,width: bounds.width,height: math.max(0.0,bounds.height - header - bottom)}
    rows := $&t.rows
    << rows.set_bounds(&body) or >>
}
pub fn (t &Table) style_or(styles &Styles) ControlStyle {
    if t.rows.has_style() { << t.rows.style_or(styles) }
    << styles.table_style()
}
pub fn (t $&Table) set_style(style &ControlStyle) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    rows := $&t.rows
    << rows.set_style(style) or >> }
pub fn (t $&Table) clear_style() { rows := $&t.rows
    rows.clear_style() }
pub fn (t $&Table) apply_styles(styles &Styles) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    styles.validate() or >>
    c := t.style_or(styles)
    cache := $&t.labels
    sample := cache.measure(1023,&"Ag国",styles,&c) or >>
    d := styles.density
    t.density = d
    height := math.max(c.indicator_size * d,sample.height + (c.padding.top + c.padding.bottom) * d)
    padding := layout.Insets{left: c.padding.left * d,top: c.padding.top * d,right: c.padding.right * d,bottom: c.padding.bottom * d}
    changed := t.rows.row_h != height || t.header_h != height || t.rows.padding.left != padding.left || t.rows.padding.top != padding.top ||
        t.rows.padding.right != padding.right || t.rows.padding.bottom != padding.bottom
    if true {
        rows := $&t.rows
        rows.padding = padding
        rows.row_h = height
        rows.scroll_y = math.max(0.0,math.min(rows.max_scroll(),rows.scroll_y))
        rows.set_styles_cache(styles)
    }
    t.header_h = height
    if changed { b := t.bounds()
        t.hot_header = -1
        t.armed_header = -1
        t.set_bounds(&b) or >>
        t.rows.dirty = true }
    << 0
}
pub fn (t &Table) row_bounds(row int) layout.Rect {
    b := t.rows.bounds()
    if row < 0 || row >= t.count() { << layout.Rect{x: b.x,y: b.y,width: 0.0,height: 0.0} }
    << layout.Rect{x: b.x + t.rows.padding.left,y: b.y + t.rows.padding.top + f64(row) * t.rows.row_h - t.rows.scroll_y,
        width: math.max(0.0,b.width - t.rows.padding.left - t.rows.padding.right),height: t.rows.row_h}
}
pub fn (t &Table) header_bounds(column int) layout.Rect {
    b := t.bounds()
    if column < 0 || column >= t.column_count() { << layout.Rect{x: b.x,y: b.y,width: 0.0,height: 0.0} }
    $x := b.x - t.scroll_x
    for i in 0:column { x = x + t.column_extent(i) }
    << layout.Rect{x: x,y: b.y,width: t.column_extent(column),height: math.min(t.header_h,b.height)}
}
fn (t &Table) hit_header(x f64,y f64) int {
    if t.outer.width <= 0.0 || !t.outer.contains(x,y) { << -1 }
    for i in 0:t.column_count() { if t.header_bounds(i).contains(x,y) { << i } }
    << -1
}
pub fn (t &Table) row_text(source_row int) string {
    if source_row < 0 || source_row >= t.count() { << "" }
    cols := t.column_count()
    $out := ""
    for c in 0:cols {
        if c > 0 { out = out + "\t" }
        out = out + t.cells[source_row * cols + c]
    }
    << out
}
fn (t &Table) hit_body_cell(x f64,y f64) ui.TextRange {
    body := t.rows.bounds()
    if !body.contains(x,y) || t.rows.scrollbar_contains(x,y) { << ui.TextRange{start: -1,end: -1} }
    vrow := t.rows.hit_row(x,y)
    if vrow < 0 || vrow >= t.order.len { << ui.TextRange{start: -1,end: -1} }
    for col in 0:t.column_count() {
        hb := t.header_bounds(col)
        if x >= hb.x && x < hb.x + hb.width { << ui.TextRange{start: vrow,end: col} }
    }
    << ui.TextRange{start: -1,end: -1}
}
fn (t $&Table) hit_cell_byte(view_row int,source_row int,col int,x f64,y f64,styles &Styles) int {
    if view_row < 0 || source_row < 0 || col < 0 || col >= t.column_count() { << 0 }
    r := t.row_bounds(view_row)
    hb := t.header_bounds(col)
    cell := layout.Rect{x: hb.x,y: r.y,width: hb.width,height: r.height}
    c := t.style_or(styles)
    $text_style := c.clone()
    text_style.align_x = t.alignments[col]
    text := t.cells[source_row * t.column_count() + col] + ""
    cache := $&t.labels
    << cache.hit_test_at(1021,&text,&cell,styles,&text_style,false,x,y) or (err) { << 0 }
}
fn (t $&Table) sync_active_row() {
    vrow := t.rows.selected_val
    if vrow < 0 || vrow >= t.order.len { << }
    source := t.order[vrow]
    if t.rows.aux.has(0) && t.rows.aux[0].get_sel_row() == source { << }
    cols := t.column_count()
    $cell0 := ""
    if cols > 0 { cell0 = t.cells[source * cols] + "" }
    rtxt := t.row_text(source)
    rows := $&t.rows
    rows.ensure_row_text(source,0,&cell0,&rtxt)
}
fn (t &Table) safe_view_row(source_row int) int {
    << t.view_row(source_row) or (err) { << -1 }
}
pub fn (t $&Table) input(input &ui.InputEvent) Action {
    if t.rows.closed || !belongs(&t.rows.identity,input) { << no_action(t.id(),t.needs_paint()) }
    if input.kind == ui.EV_POINTER_CANCEL { t.cancel()
        << no_action(t.id(),t.needs_paint()) }
    if !t.is_enabled() { << no_action(t.id(),t.needs_paint()) }
    if t.has_popup_open() {
        rows := $&t.rows
        << rows.route_popup(input)
    }
    styles := t.rows.style_snapshot()
    if input.kind == ui.EV_KEY_DOWN && t.rows.focused && t.is_selectable() {
        t.sync_active_row()
        if (input.modifiers & ui.MOD_SHIFT) != 0 || ui.is_clipboard_modifier(input.modifiers) {
            rows := $&t.rows
            text_act := rows.handle_text_key(input)
            if text_act.consumed { << text_act }
        }
        if is_context_trigger(input) && t.rows.selected_val >= 0 && t.rows.selected_val < t.order.len {
            vrow := t.rows.selected_val
            source := t.order[vrow]
            r := t.row_bounds(vrow)
            ctx := t.labels.context.clone()
            $cell0 := ""
            if t.column_count() > 0 { cell0 = t.cells[source * t.column_count()] + "" }
            rtxt := t.row_text(source)
            mx := t.outer.x + 12.0 * t.density
            my := r.y + r.height * 0.5
            $opened := false
            if true {
                rows := $&t.rows
                opened = rows.open_row_menu(&ctx,mx,my,&cell0,&rtxt,source,0,true)
            }
            if opened {
                << Action{kind: ACTION_NONE,id: t.id(),needs_paint: t.needs_paint(),request_focus: true,consumed: true,value: f64(t.rows.selected_val)}
            }
        }
    }
    resized := t.column_input(input) or >>
    if resized.consumed { << resized }
    hit := t.hit_body_cell(input.x,input.y)
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_RIGHT && hit.start >= 0 {
        vrow := hit.start
        col := hit.end
        source := t.order[vrow]
        sel_ok := t.is_selectable()
        ctx := t.labels.context.clone()
        ctxt := t.cells[source * t.column_count() + col] + ""
        rtxt := t.row_text(source)
        if true {
            rows := $&t.rows
            rows.focused = true
            _ := rows.set_selected(vrow)
            if sel_ok {
                _ := rows.open_row_menu(&ctx,input.x,input.y,&ctxt,&rtxt,source,col,true)
            }
        }
        << Action{kind: ACTION_NONE,id: t.id(),needs_paint: true,request_focus: true,consumed: true,value: f64(t.rows.selected_val)}
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && hit.start >= 0 && t.is_selectable() {
        vrow := hit.start
        col := hit.end
        source := t.order[vrow]
        idx := t.hit_cell_byte(vrow,source,col,input.x,input.y,&styles)
        ctxt := t.cells[source * t.column_count() + col] + ""
        rtxt := t.row_text(source)
        if true {
            rows := $&t.rows
            _ := rows.begin_row_pointer(&ctxt,&rtxt,idx,source,col,input)
        }
    }
    if input.kind == ui.EV_POINTER_MOVE && t.is_selectable() && t.rows.aux.has(0) {
        srow := t.rows.aux[0].get_sel_row()
        scol := t.rows.aux[0].get_sel_col()
        td := t.density
        $should := false
        if true {
            rows := $&t.rows
            should = rows.should_begin_row_drag(input.x,input.y,td)
        }
        if should && srow >= 0 && scol >= 0 {
            vrow := t.safe_view_row(srow)
            if vrow >= 0 {
                idx := t.hit_cell_byte(vrow,srow,scol,input.x,input.y,&styles)
                if true {
                    rows2 := $&t.rows
                    _ := rows2.drag_row_pointer(idx)
                }
            }
            if true {
                rows3 := $&t.rows
                rows3.armed_idx = -1
            }
            << Action{kind: ACTION_NONE,id: t.id(),needs_paint: t.needs_paint(),request_focus: false,consumed: true,value: f64(t.rows.selected_val)}
        }
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if true {
            rows := $&t.rows
            rows.end_row_pointer()
        }
    }
    header := t.hit_header(input.x,input.y)
    if input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_LEAVE {
        $hot := header
        if input.kind == ui.EV_POINTER_LEAVE { hot = -1 }
        if hot != t.hot_header { t.hot_header = hot
            t.rows.dirty = true }
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && header >= 0 {
        t.header_cursor = header
        t.rows.armed_idx = -1
        if !t.rows.read_only { t.armed_header = header }
        t.rows.dirty = true
        << Action{kind: ACTION_NONE,id: t.id(),needs_paint: true,request_focus: true,consumed: true,value: f64(header)}
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT { t.armed_header = -1 }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && t.armed_header >= 0 {
        $kind := ACTION_NONE
        if !t.rows.read_only && header == t.armed_header {
            t.toggle_sort(header) or >>
            kind = ACTION_ACTIVATE
        }
        t.armed_header = -1
        t.rows.dirty = true
        << Action{kind: kind,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(header)}
    }
    // Left/right choose a header; Enter/Space request sorting. Up/down, Home,
    // End and Page Up/Down continue to navigate the data rows.
    if input.kind == ui.EV_KEY_DOWN && t.rows.focused && !t.rows.read_only {
        if input.key == ui.KEY_LEFT || input.key == ui.KEY_RIGHT {
            t.sort_key_armed = 0
            if input.key == ui.KEY_LEFT { t.header_cursor = max_int(0,t.header_cursor - 1) }
            else { t.header_cursor = min_int(t.column_count() - 1,t.header_cursor + 1) }
            t.rows.dirty = true
            << Action{kind: ACTION_NONE,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(t.header_cursor)}
        }
        if input.key == ui.KEY_ENTER || input.key == 32 {
            if input.repeat == 0 { t.sort_key_armed = input.key }
            t.rows.dirty = true
            << Action{kind: ACTION_NONE,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(t.header_cursor)}
        }
    }
    if input.kind == ui.EV_KEY_UP && input.key == t.sort_key_armed && t.sort_key_armed != 0 {
        t.sort_key_armed = 0
        if t.rows.focused && !t.rows.read_only { column := t.header_cursor
            t.toggle_sort(column) or >>
            << Action{kind: ACTION_ACTIVATE,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(column)} }
    }
    if input.kind == ui.EV_POINTER_SCROLL && t.outer.contains(input.x,input.y) {
        $h_changed := false
        if !math.is_nan(input.dx) && !math.is_inf(input.dx) && input.dx != 0.0 {
            prev_x := t.scroll_x
            t.set_horizontal_offset(t.scroll_x + input.dx) or >>
            h_changed = (t.scroll_x != prev_x)
        }
        $v_act := no_action(t.id(),t.needs_paint())
        if true {
            rows := $&t.rows
            v_act = rows.input(input) or >>
        }
        if v_act.consumed { << v_act }
        if h_changed { << Action{kind: ACTION_SCROLL,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: t.scroll_x} }
        << v_act
    }
    rows := $&t.rows
    << rows.input(input) or >>
}
pub fn (t $&Table) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if kind == ROUTE_FOCUS { t.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { t.cancel() }
    else { << t.input(input) or >> }
    << no_action(t.id(),t.needs_paint())
}
pub fn (t $&Table) event(event &ui.Event) Action {
    if event.window_id != t.rows.identity.window_id { << no_action(t.id(),t.needs_paint()) }
    if event.kind == ui.EV_CLOSED { t.dispose()
        << no_action(t.id(),false) }
    if event.kind == ui.EV_BLURRED { t.cancel()
        << no_action(t.id(),t.needs_paint()) }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == t.rows.identity.canvas_id && identity.generation == t.rows.identity.generation { t.dispose() }
        << no_action(t.id(),t.needs_paint())
    }
    if !ui.is_input_event(event.kind) { << no_action(t.id(),t.needs_paint()) }
    input := ui.input_of(event) or >>
    << t.input(&input) or >>
}
pub fn (t $&Table) measure_styled(styles &Styles) layout.Size {
    t.apply_styles(styles) or >>
    c := t.style_or(styles)
    $width := 0.0
    count := t.column_count()
    for i in 0:count { text := t.headers[i] + "  ↕"
        cache := $&t.labels
        sz := cache.measure(i,&text,styles,&c) or >>
        width = width + math.max(80.0 * styles.density,sz.width + 24.0 * styles.density) }
    << layout.Size{width: width,height: t.header_h + t.rows.row_h * f64(min_int(5,max_int(1,t.count()))) + (c.padding.top + c.padding.bottom) * styles.density}
}
pub fn (t $&Table) dispose() {
    cache := $&t.labels
    cache.dispose()
    t.cancel()
    rows := $&t.rows
    rows.dispose_aux()
    t.rows.closed = true
}
pub fn (t &Table) selected_text() string { << t.rows.selected_text() }
