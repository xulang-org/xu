@ui/widgets
#ui/draw
#ui/layout
#math

fn menu_chevron(frame $&draw.Frame,x f64,y f64,size f64,right bool,color draw.Color,width f64) int {
    if right { frame.line(x-size*0.4,y-size*0.5,x+size*0.1,y,color,width) or >>
        frame.line(x+size*0.1,y,x-size*0.4,y+size*0.5,color,width) or >> }
    else { frame.line(x-size*0.5,y-size*0.2,x,y+size*0.3,color,width) or >>
        frame.line(x,y+size*0.3,x+size*0.5,y-size*0.2,color,width) or >> }
    << 0
}
pub fn (m $&Menu) paint_styled(frame $&draw.Frame,styles &Styles) int {
    base := m.control.style_or(styles)
    $state := m.control.visual_state()
    if !m.opened && m.key_armed > 0 { state = state | STATE_PRESSED }
    stamp := m.now
    reduced := m.reduced
    transition := $&m.transition
    c := transition.style(&base,state,stamp,reduced) or >>
    b := m.bounds()
    paint_box_styled(frame,&b,styles,&c,state) or >>
    d := styles.density
    $label := layout.Rect{x: b.x,y: b.y,width: math.max(0.0,b.width-32.0*d),height: b.height}
    if m.mode == MENU_CONTEXT { label.width = b.width }
    text := m.label + ""
    trigger_key := m.items.len*2
    cache := $&m.labels
    cache.paint_text(trigger_key,&text,frame,&label,styles,&c,state) or >>
    if m.mode != MENU_CONTEXT {
        x := b.x+b.width-18.0*d
        y := b.y+b.height*0.5
        menu_chevron(frame,x,y,8.0*d,false,c.resolve(state).foreground,1.5*d) or >>
        if m.mode == MENU_SPLIT { frame.line(b.x+b.width-36.0*d,b.y+8.0*d,b.x+b.width-36.0*d,b.y+b.height-8.0*d,c.resolve(state).border,d) or >> }
    }
    << 0
}
fn (m $&Menu) paint_row(frame $&draw.Frame,styles &Styles,index int,depth int,opacity f64) int {
    row := m.row_bounds(index,depth)
    kind := m.items[index].kind
    d := styles.density
    base := m.popup_style(styles)
    if kind == MENU_SEPARATOR { frame.line(row.x+8.0*d,row.y+row.height*0.5,row.x+row.width-8.0*d,row.y+row.height*0.5,fade_color(base.palette.border,opacity),d) or >>
        << 0 }
    state := m.item_state(index)
    $transition := m.rows[index]
    c := transition.style(&base,state,m.now,m.reduced) or >>
    m.rows[index] = transition
    $faded := c.with_opacity(opacity) or >>
    faded.radius = math.min(5.0,base.radius)
    if (state & STATE_HOVERED) != 0 || (state & STATE_PRESSED) != 0 { rounded_fill(frame,&row,faded.radius*d,faded.resolve(state).background) or >> }
    ink := faded.resolve(state).foreground
    mark_x := row.x+13.0*d
    cy := row.y+row.height*0.5
    if m.items[index].checked {
        if kind == MENU_RADIO { frame.set_fill(ink) or >>
            frame.circle(mark_x,cy,3.0*d) or >> }
        else if kind == MENU_CHECK { frame.line(mark_x-4.0*d,cy,mark_x-1.0*d,cy+3.0*d,ink,1.7*d) or >>
            frame.line(mark_x-1.0*d,cy+3.0*d,mark_x+5.0*d,cy-4.0*d,ink,1.7*d) or >> }
    }
    text := m.items[index].label + ""
    shortcut := m.items[index].shortcut_label + ""
    $reserved := 18.0*d
    if kind == MENU_SUBMENU { reserved = 26.0*d
        menu_chevron(frame,row.x+row.width-12.0*d,cy,7.0*d,true,ink,1.5*d) or >> }
    if shortcut.len > 0 { cache := $&m.labels
        measured := cache.measure(index*2+1,&shortcut,styles,&faded) or >>
        shortcut_width := math.min(row.width*0.45,measured.width+8.0*d)
        box := layout.Rect{x: row.x+row.width-shortcut_width-reserved,y: row.y,width: shortcut_width,height: row.height}
        $small := faded.clone()
        small.align_x = 1.0
        small.palette.foreground = small.palette.muted
        cache.paint_text(index*2+1,&shortcut,frame,&box,styles,&small,state) or >>
        reserved = reserved+shortcut_width+8.0*d }
    label := layout.Rect{x: row.x+28.0*d,y: row.y,width: math.max(0.0,row.width-28.0*d-reserved),height: row.height}
    if kind == MENU_HEADING { faded.palette.foreground = faded.palette.muted }
    cache := $&m.labels
    cache.paint_text(index*2,&text,frame,&label,styles,&faded,state) or >>
    << 0
}
pub fn (m $&Menu) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    if m.panels.len == 0 || m.fade.value() <= 0.0 { << 0 }
    $keys := [m.items.len*2,m.items.len*2+1,m.items.len*2+2]
    for depth in 0:m.panels.len { b := m.panels[depth]
        for i in 0:m.items.len { if m.items[i].parent == m.path[depth] { row := m.row_bounds(i,depth)
            if row.y+row.height > b.y && row.y < b.y+b.height { keys.push(i*2)
                keys.push(i*2+1) } } }
    }
    cache := $&m.labels
    cache.retain_keys(&keys)
    for depth in 0:m.panels.len {
        $opacity := m.fade.value()
        if depth > 0 && depth == m.panels.len-1 { opacity = opacity*m.submenu_fade.value() }
        if opacity <= 0.0 { -> }
        b := m.panels[depth]
        $base := styles.card_style()
        if m.control.has_style() { base = m.control.style_or(styles) }
        base.radius = math.max(base.radius,7.0)
        c := base.with_opacity(opacity) or >>
        paint_box_styled(frame,&b,styles,&c,0) or >>
        frame.push() or >>
        frame.clip_rect(b.x+4.0*m.density,b.y+4.0*m.density,math.max(0.0,b.width-8.0*m.density),math.max(0.0,b.height-8.0*m.density)) or >>
        for i in 0:m.items.len { if m.items[i].parent == m.path[depth] { row := m.row_bounds(i,depth)
            if row.y+row.height > b.y && row.y < b.y+b.height { m.paint_row(frame,styles,i,depth,opacity) or >> } } }
        frame.pop() or >>
        total := m.panel_content_height(m.path[depth])
        if total > b.height {
            track := math.max(0.0,b.height-12.0*m.density)
            thumb := math.min(track,math.max(18.0*m.density,track*b.height/total))
            y := b.y+6.0*m.density+(track-thumb)*m.offsets[depth]/(total-b.height)
            bar := layout.Rect{x: b.x+b.width-5.0*m.density,y: y,width: 2.0*m.density,height: thumb}
            rounded_fill(frame,&bar,m.density,fade_color(c.palette.muted,opacity*0.6)) or >>
        }
    }
    << 0
}
