@ui/widgets

#ui
#errors

pub const FOCUS_NAV_NONE = 0
pub const FOCUS_NAV_HORIZONTAL = 1
pub const FOCUS_NAV_VERTICAL = 2
pub const FOCUS_NAV_BOTH = 3

pub struct FocusZone {
    pub nav int
    pub wrap bool
    pub roving bool
}

pub fn focus_zone(nav int) FocusZone {
    << FocusZone{nav: nav,wrap: true,roving: false}
}

pub fn roving_focus_zone(nav int) FocusZone {
    << FocusZone{nav: nav,wrap: true,roving: true}
}

pub fn (fg &FocusZone) validate() int {
    if fg.nav < FOCUS_NAV_NONE || fg.nav > FOCUS_NAV_BOTH {
        >> errors.new("widgets: invalid focus zone navigation mode")
    }
    << 0
}

pub fn (s &Screen) active_focus_trap() int {
    stack := &s.composition.focus_trap_stack
    $i := stack.len - 1
    while i >= 0 {
        tid := stack[i]
        if tid > 0 && tid <= s.nodes.len && s.nodes[tid - 1].kind >= 0 &&
           s.is_visible(tid) && !s.is_layout_hidden(tid) {
            << tid
        }
        i -= 1
    }
    << 0
}

fn (s &Screen) effective_focus_scope(modal int) int {
    if modal > 0 { << modal }
    << s.active_focus_trap()
}

pub fn (s &Screen) is_focus_trap(id int) bool {
    _ := s.node(id) or >>
    << vec_has(&s.composition.focus_trap_stack,id)
}

pub fn (s $&Screen) set_focus_trap(id int,enabled bool) int {
    _ := s.node(id) or >>
    if enabled {
        already := vec_has(&s.composition.focus_trap_stack,id)
        if !already && s.focused > 0 && !s.is_descendant(s.focused,id) {
            comp := $&s.composition
            ftr := $&comp.focus_trap_restore
            ftr[id] = s.focused
        }
        comp := $&s.composition
        next := vec_without(&comp.focus_trap_stack,id)
        comp.focus_trap_stack = next
        stk := $&comp.focus_trap_stack
        stk.push(id)
        << 0
    }
    comp := $&s.composition
    next := vec_without(&comp.focus_trap_stack,id)
    comp.focus_trap_stack = next
    $restore_id := 0
    if comp.focus_trap_restore.has(id) {
        ftr := $&comp.focus_trap_restore
        restore_id = ftr.take(id)
    }
    if restore_id > 0 && (s.focused == 0 || s.is_descendant(s.focused,id)) {
        next_scope := s.effective_focus_scope(s.modal_blocks())
        if s.focus_ready(restore_id,next_scope) or (err) { << 0 } {
            s.focus_input(restore_id) or >>
        }
    }
    << 0
}

fn (s $&Screen) restore_hidden_focus_trap(hidden_id int,prev_focused int) int {
    if s.composition.focus_trap_stack.len == 0 { << 0 }
    $restore_id := 0
    $i := s.composition.focus_trap_stack.len - 1
    while i >= 0 {
        tid := s.composition.focus_trap_stack[i]
        if (tid == hidden_id || s.is_descendant(tid,hidden_id)) && s.composition.focus_trap_restore.has(tid) {
            if prev_focused == 0 || s.is_descendant(prev_focused,tid) {
                restore_id = s.composition.focus_trap_restore[tid]
                <-
            }
        }
        i -= 1
    }
    if restore_id > 0 {
        next_scope := s.effective_focus_scope(s.modal_blocks())
        if s.focus_ready(restore_id,next_scope) or (err) { << 0 } {
            s.focus_input(restore_id) or >>
        }
    }
    << 0
}

fn (s $&Screen) collect_focus_zone_subtree(id int,root int,modal int,out $&[]int) int {
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 { << 0 }
    if id != root && s.focus_ready(id,modal) or >> {
        out.push(id)
    }
    ordered := s.order_sorted_live_children(id)
    for i in 0:ordered.len {
        cid := ordered[i]
        if !screen_is_overlay(s.nodes[cid - 1].kind) {
            s.collect_focus_zone_subtree(cid,root,modal,out) or >>
        }
    }
    << 0
}

fn (s $&Screen) collect_focus_zone_items(root int,modal int,out $&[]int) int {
    << s.collect_focus_zone_subtree(root,root,modal,out) or >>
}

fn (s &Screen) sort_focus_order_by_tab_index(order $&[]int) {
    if s.composition.tab_index_count == 0 || order.len <= 1 { << }
    ti := &s.composition.tab_indices
    for i in 1:order.len {
        key := order[i]
        key_raw := ti.get_or(key,0)
        $key_rank := 1000000000
        if key_raw > 0 { key_rank = key_raw }
        $j := i - 1
        while j >= 0 {
            prev := order[j]
            prev_raw := ti.get_or(prev,0)
            $prev_rank := 1000000000
            if prev_raw > 0 { prev_rank = prev_raw }
            if prev_rank <= key_rank { <- }
            order[j + 1] = prev
            j -= 1
        }
        order[j + 1] = key
    }
}

pub fn (s $&Screen) focus_first_in(container int) int {
    _ := s.node(container) or >>
    s.set_focus_mode(true) or >>
    s.layout_controls() or >>
    scope := s.effective_focus_scope(s.modal_blocks())
    $items := []int{}
    s.collect_focus_zone_items(container,scope,$&items) or >>
    if items.len == 0 { << 0 }
    s.sort_focus_order_by_tab_index($&items)
    $target := items[0]
    if s.composition.tab_index_count > 0 {
        for i in 0:items.len {
            if s.composition.tab_indices.get_or(items[i],0) >= 0 {
                target = items[i]
                <-
            }
        }
    }
    s.focus_input(target) or >>
    << s.focused
}

pub fn (s $&Screen) focus_last_in(container int) int {
    _ := s.node(container) or >>
    s.set_focus_mode(true) or >>
    s.layout_controls() or >>
    scope := s.effective_focus_scope(s.modal_blocks())
    $items := []int{}
    s.collect_focus_zone_items(container,scope,$&items) or >>
    if items.len == 0 { << 0 }
    s.sort_focus_order_by_tab_index($&items)
    $target := items[items.len - 1]
    if s.composition.tab_index_count > 0 {
        $i := items.len - 1
        while i >= 0 {
            if s.composition.tab_indices.get_or(items[i],0) >= 0 {
                target = items[i]
                <-
            }
            i -= 1
        }
    }
    s.focus_input(target) or >>
    << s.focused
}

pub fn (s $&Screen) set_focus_zone(id int,cfg &FocusZone) int {
    _ := s.node(id) or >>
    cfg.validate() or >>
    comp := $&s.composition
    fzs := $&comp.focus_zones
    had := fzs.has(id)
    fzs[id] = FocusZone{nav: cfg.nav,wrap: cfg.wrap,roving: cfg.roving}
    if !had { comp.focus_zone_count = comp.focus_zone_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_focus_zone(id int) int {
    _ := s.node(id) or >>
    comp := $&s.composition
    if comp.focus_zones.has(id) {
        fzs := $&comp.focus_zones
        fzs.delete(id)
        if comp.focus_zone_count > 0 { comp.focus_zone_count = comp.focus_zone_count - 1 }
    }
    if comp.focus_zone_active_ids.has(id) {
        act := $&comp.focus_zone_active_ids
        act.delete(id)
    }
    << 0
}

pub fn (s &Screen) focus_zone_active(id int) int {
    _ := s.node(id) or >>
    << s.composition.focus_zone_active_ids.get_or(id,0)
}

fn (s $&Screen) record_focus_zone_active(id int) {
    if s.composition.focus_zone_count == 0 || id <= 0 || id > s.nodes.len { << }
    $cur := s.nodes[id - 1].parent
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.focus_zones.has(cur) {
            comp := $&s.composition
            act := $&comp.focus_zone_active_ids
            act[cur] = id
        }
        pn := s.nodes[cur - 1]
        if pn.kind < 0 || pn.parent <= 0 { <- }
        cur = pn.parent
        budget -= 1
    }
}

fn (s &Screen) roving_zone_pick(gid int,items &[]int) int {
    if items.len == 0 { << 0 }
    if s.focused > 0 && vec_has(items,s.focused) { << s.focused }
    rem := s.composition.focus_zone_active_ids.get_or(gid,0)
    if rem > 0 && vec_has(items,rem) { << rem }
    if s.composition.tab_index_count > 0 {
        for i in 0:items.len {
            if s.composition.tab_indices.get_or(items[i],0) >= 0 { << items[i] }
        }
    }
    << items[0]
}

fn (s $&Screen) handle_focus_zone_key(key int,modal int) bool {
    if s.composition.focus_zone_count == 0 || s.focused <= 0 || s.focused > s.nodes.len { << false }
    is_h := key == ui.KEY_LEFT || key == ui.KEY_RIGHT
    is_v := key == ui.KEY_UP || key == ui.KEY_DOWN
    is_edge := key == ui.KEY_HOME || key == ui.KEY_END
    if !is_h && !is_v && !is_edge { << false }
    $gid := 0
    $fg := focus_zone(FOCUS_NAV_NONE)
    $cur := s.nodes[s.focused - 1].parent
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.focus_zones.has(cur) {
            cand := s.composition.focus_zones[cur]
            match_h := is_h && (cand.nav == FOCUS_NAV_HORIZONTAL || cand.nav == FOCUS_NAV_BOTH)
            match_v := is_v && (cand.nav == FOCUS_NAV_VERTICAL || cand.nav == FOCUS_NAV_BOTH)
            match_e := is_edge && cand.nav != FOCUS_NAV_NONE
            if match_h || match_v || match_e {
                gid = cur
                fg = cand
                <-
            }
        }
        pn := s.nodes[cur - 1]
        if pn.kind < 0 || pn.parent <= 0 { <- }
        cur = pn.parent
        budget -= 1
    }
    if gid == 0 { << false }
    scope := s.effective_focus_scope(modal)
    $items := []int{}
    s.collect_focus_zone_items(gid,scope,$&items) or >>
    if items.len == 0 { << false }
    $pos := -1
    for i in 0:items.len {
        if items[i] == s.focused {
            pos = i
            <-
        }
    }
    if pos < 0 { << false }
    $next_pos := pos
    if key == ui.KEY_HOME {
        next_pos = 0
    } else if key == ui.KEY_END {
        next_pos = items.len - 1
    } else if key == ui.KEY_LEFT || key == ui.KEY_UP {
        next_pos = pos - 1
        if next_pos < 0 {
            if fg.wrap { next_pos = items.len - 1 }
            else { next_pos = 0 }
        }
    } else {
        next_pos = pos + 1
        if next_pos >= items.len {
            if fg.wrap { next_pos = 0 }
            else { next_pos = items.len - 1 }
        }
    }
    if items[next_pos] == s.focused { << false }
    s.set_focus_mode(true) or >>
    s.focus_input(items[next_pos]) or >>
    << true
}

pub fn (s $&Screen) set_tab_index(id int,tab_index int) int {
    _ := s.node(id) or >>
    if tab_index < -1 || tab_index > 1000000 {
        >> errors.new("widgets: invalid tab index")
    }
    comp := $&s.composition
    ti := $&comp.tab_indices
    if tab_index == 0 {
        if ti.has(id) {
            ti.delete(id)
            if comp.tab_index_count > 0 { comp.tab_index_count = comp.tab_index_count - 1 }
        }
        << 0
    }
    had := ti.has(id)
    ti[id] = tab_index
    if !had { comp.tab_index_count = comp.tab_index_count + 1 }
    << 0
}

pub fn (s &Screen) tab_index(id int) int {
    _ := s.node(id) or >>
    << s.composition.tab_indices.get_or(id,0)
}

fn (s $&Screen) cleanup_focus_meta_for(id int) {
    comp := $&s.composition
    if vec_has(&comp.focus_trap_stack,id) {
        comp.focus_trap_stack = vec_without(&comp.focus_trap_stack,id)
    }
    if comp.focus_trap_restore.has(id) {
        ftr := $&comp.focus_trap_restore
        ftr.delete(id)
    }
    if comp.focus_zones.has(id) {
        fzs := $&comp.focus_zones
        fzs.delete(id)
        if comp.focus_zone_count > 0 { comp.focus_zone_count = comp.focus_zone_count - 1 }
    }
    if comp.focus_zone_active_ids.has(id) {
        act := $&comp.focus_zone_active_ids
        act.delete(id)
    }
    if comp.tab_indices.has(id) {
        ti := $&comp.tab_indices
        ti.delete(id)
        if comp.tab_index_count > 0 { comp.tab_index_count = comp.tab_index_count - 1 }
    }
}
