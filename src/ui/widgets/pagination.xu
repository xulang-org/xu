@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

// Zero based page state. Endpoints and a bounded page window are materialized; callers
// retain ownership of the actual paged data. Zero pages has current == -1.
pub struct Pagination {
    locale Locale
    control Button
    hover_motions []PaintTransition
    emphasis Tween
    motion MotionSpec
    observed_page int
    now time.Instant
    reduced bool
    total_items int
    page_size int
    item_width f64
    item_height f64
    item_gap f64
    appearance PaginationAppearance
    pages int
    current int
    hot int
    armed int
    labels TextCache
}
pub fn pagination(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,pages int,current int) Pagination {
    if pages < 0 || pages > 1000000000 || current < -1 || current >= pages || (pages == 0 && current != -1) || (pages > 0 && current < 0) {
        >> errors.new("widgets: invalid pagination range")
    }
    if !context.matches_canvas(identity) { >> errors.new("widgets: pagination context mismatch") }
    control := button(identity,id,bounds) or >>
    << Pagination{hover_motions: []PaintTransition{},emphasis: tween(1.0) or >>,motion: motion_spec(),observed_page: current,now: time.zero_instant(),reduced: true,total_items: -1,page_size: 0,item_width: 36.0,item_height: 36.0,item_gap: 6.0,appearance: pagination_appearance(),locale: locale_default(),control: control,pages: pages,current: current,hot: -1,armed: -1,labels: text_cache(context)}
}
pub fn (p &Pagination) id() int { << p.control.id }
pub fn (p &Pagination) bounds() layout.Rect { << p.control.bounds() }
pub fn (p &Pagination) page_count() int { << p.pages }
pub fn (p &Pagination) selected() int { << p.current }
pub fn (p &Pagination) needs_paint() bool { << p.control.dirty }
pub fn (p &mut Pagination) painted() { p.control.dirty = false }
pub fn (p &Pagination) is_enabled() bool { << p.control.is_enabled() }
pub fn (p &Pagination) is_focused() bool { << p.control.focused }
pub fn (p &Pagination) is_read_only() bool { << p.control.read_only }
pub fn (p &mut Pagination) cancel() {
    p.hot = -1
    p.armed = -1
    c := mut &p.control
    c.cancel()
}
pub fn (p &mut Pagination) set_focus(focused bool) { c := mut &p.control
    c.set_focus(focused) }
pub fn (p &mut Pagination) set_enabled(enabled bool) { c := mut &p.control
    c.set_enabled(enabled)
    if !enabled { p.hot = -1
        p.armed = -1 } }
pub fn (p &mut Pagination) set_read_only(value bool) int {
    if p.control.closed { >> errors.new("widgets: pagination is disposed") }
    c := mut &p.control
    c.set_read_only(value)
    p.armed = -1
    << 0
}
pub fn (p &mut Pagination) set_page_count(pages int) int {
    if p.control.closed || pages < 0 || pages > 1000000000 { >> errors.new("widgets: invalid pagination range") }
    p.total_items = -1
    p.page_size = 0
    p.pages = pages
    if pages == 0 { p.current = -1 }
    else { p.current = max_int(0,min_int(p.current,pages - 1)) }
    p.hot = -1
    p.armed = -1
    p.control.dirty = true
    << 0
}
pub fn (p &mut Pagination) set_selected(index int) int {
    if p.control.closed || index < -1 || index >= p.pages || (p.pages > 0 && index < 0) { >> errors.new("widgets: invalid page index") }
    if p.current != index { p.current = index
        p.control.dirty = true }
    p.armed = -1
    << 0
}
pub fn (p &mut Pagination) set_bounds(bounds &layout.Rect) int {
    old := p.bounds()
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height {
        p.hot = -1
        p.armed = -1
    }
    c := mut &p.control
    << c.set_bounds(bounds) or >>
}
pub fn (p &Pagination) style_or(styles &Styles) ControlStyle {
    if p.control.has_style() { << p.control.style_or(styles) }
    mut c := styles.button.clone()
    c.border_width = 0.0
    c.radius = 6.0
    c.min_width = 36.0
    c.min_height = 36.0
    c.padding = layout.Insets{left: 8.0,top: 6.0,right: 8.0,bottom: 6.0}
    c.palette.normal = styles.background
    c.palette.disabled = styles.background
    << c
}
pub fn (p &mut Pagination) set_style(style &ControlStyle) int { c := mut &p.control
    << c.set_style(style) or >> }
pub fn (p &mut Pagination) clear_style() { c := mut &p.control
    c.clear_style() }
pub fn (p &mut Pagination) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := p.style_or(styles)
    text := p.locale.integer(max_int(1,p.pages))
    cache := mut &p.labels
    size := cache.measure(100,&text,styles,&c) or >>
    d := styles.density
    width := math.max(p.appearance.min_item_width * d,size.width + (c.padding.left + c.padding.right) * d)
    height := math.max(c.min_height * d,size.height + (c.padding.top + c.padding.bottom) * d)
    gap := p.appearance.gap * d
    if width != p.item_width || height != p.item_height || gap != p.item_gap {
        p.item_width = width
        p.item_height = height
        p.item_gap = gap
        p.armed = -1
        p.hot = -1
        p.control.dirty = true }
    << 0
}
fn (p &Pagination) page_slots() []int {
    mut slots := [p.current - 1]
    if p.pages > 7 && p.bounds().width > 0.0 && p.bounds().width < 7.0 * p.item_width + 6.0 * p.item_gap {
        slots.push(p.current)
        slots.push(p.current + 1)
        << slots
    }
    if p.pages <= 7 { for i in 0:p.pages { slots.push(i) } }
    else {
        slots.push(0)
        start := max_int(1,min_int(p.current - 1,p.pages - 4))
        end := min_int(p.pages - 1,start + 3)
        if start > 1 { if start == 2 { slots.push(1) }
            else { slots.push(-2) } }
        for i in start:end { slots.push(i) }
        if end < p.pages - 1 { if end == p.pages - 2 { slots.push(end) }
            else { slots.push(-2) } }
        slots.push(p.pages - 1)
    }
    slots.push(p.current + 1)
    << slots
}
fn (p &Pagination) slot_count() int { << p.page_slots().len }
pub fn (p &Pagination) item_bounds(slot int) layout.Rect {
    b := p.bounds()
    if slot < 0 || slot >= p.slot_count() { << layout.Rect{x: b.x,y: b.y,width: 0.0,height: 0.0} }
    count := f64(p.slot_count())
    gap := math.min(p.item_gap,b.width / math.max(1.0,count * 2.0))
    available := math.max(0.0,b.width - gap * (count - 1.0))
    mut w := math.min(p.item_width,available / count)
    if p.appearance.stretch { w = available / count }
    h := math.min(b.height,p.item_height)
    << layout.Rect{x: b.x + f64(slot) * (w + gap),y: b.y + (b.height - h) * 0.5,width: w,height: h}
}
fn (p &Pagination) slot_page(slot int) int {
    slots := p.page_slots()
    if slot < 0 || slot >= slots.len { << -1 }
    << slots[slot]
}
fn (p &Pagination) hit_slot(x f64,y f64) int {
    for slot in 0:p.slot_count() { if p.item_bounds(slot).contains(x,y) { << slot } }
    << -1
}
pub fn (p &mut Pagination) input(input &ui.InputEvent) Action {
    if p.control.closed || !belongs(&p.control.identity,input) { << no_action(p.id(),p.needs_paint()) }
    if input.kind == ui.EV_POINTER_CANCEL { p.cancel()
        << no_action(p.id(),p.needs_paint()) }
    if !p.is_enabled() { << no_action(p.id(),p.needs_paint()) }
    mut slot := p.hit_slot(input.x,input.y)
    mut candidate := p.current
    mut consumed := false
    mut focus := false
    if input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_LEAVE {
        if input.kind == ui.EV_POINTER_LEAVE { slot = -1 }
        if p.hot != slot { p.hot = slot
            p.control.dirty = true }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && slot >= 0 {
        p.hot = slot
        focus = true
        consumed = true
        if !p.control.read_only { p.armed = slot }
        p.control.dirty = true
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && p.armed >= 0 {
        consumed = true
        p.hot = slot
        if p.armed == slot && !p.control.read_only { candidate = p.slot_page(slot) }
        p.armed = -1
        p.control.dirty = true
    } else if input.kind == ui.EV_KEY_DOWN && p.control.focused && !p.control.read_only && p.pages > 0 {
        if input.key == ui.KEY_LEFT || input.key == ui.KEY_PAGE_UP { candidate = p.current - 1
            consumed = true }
        else if input.key == ui.KEY_RIGHT || input.key == ui.KEY_PAGE_DOWN { candidate = p.current + 1
            consumed = true }
        else if input.key == ui.KEY_HOME { candidate = 0
            consumed = true }
        else if input.key == ui.KEY_END { candidate = p.pages - 1
            consumed = true }
    }
    mut kind := ACTION_NONE
    if candidate >= 0 && candidate < p.pages && candidate != p.current {
        p.current = candidate
        p.control.dirty = true
        kind = ACTION_CHANGE
    }
    << Action{kind: kind,id: p.id(),needs_paint: p.needs_paint(),request_focus: focus,consumed: consumed,value: f64(p.current)}
}
pub fn (p &mut Pagination) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if kind == ROUTE_FOCUS { p.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { p.cancel() }
    else { << p.input(input) or >> }
    << no_action(p.id(),p.needs_paint())
}
pub fn (p &mut Pagination) event(event &ui.Event) Action {
    if event.window_id != p.control.identity.window_id { << no_action(p.id(),p.needs_paint()) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED {
        p.cancel()
        if event.kind == ui.EV_CLOSED { p.dispose() }
        << no_action(p.id(),p.needs_paint())
    }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == p.control.identity.canvas_id && identity.generation == p.control.identity.generation { p.dispose() }
        << no_action(p.id(),p.needs_paint())
    }
    if !ui.is_input_event(event.kind) { << no_action(p.id(),p.needs_paint()) }
    input := ui.input_of(event) or >>
    << p.input(&input) or >>
}
pub fn (p &mut Pagination) measure_styled(styles &Styles) layout.Size {
    p.apply_styles(styles) or >>
    count := f64(p.slot_count())
    << layout.Size{width: count * p.item_width + math.max(0.0,count - 1.0) * p.item_gap,height: p.item_height}
}
pub fn (p &mut Pagination) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    if p.control.closed { >> errors.new("widgets: pagination is disposed") }
    p.apply_styles(styles) or >>
    c := p.style_or(styles)
    p.ensure_hover_motions() or >>
    count := p.slot_count()
    for i in 0:count {
        b := p.item_bounds(i)
        page := p.slot_page(i)
        state := p.slot_state(i)
        mut transition := p.hover_motions[i]
        animated := transition.style(&c,state,p.now,p.reduced) or >>
        p.hover_motions[i] = transition
        selected := i > 0 && i < count - 1 && page == p.current
        if selected {
            scale := 0.98 + 0.02 * p.emphasis.value()
            cx := b.x + b.width * 0.5
            cy := b.y + b.height * 0.5
            frame.push() or >>
            frame.translate(cx,cy) or >>
            frame.scale(scale,scale) or >>
            frame.translate(0.0-cx,0.0-cy) or >> }
        style_box(frame,&b,&animated,styles.density,state) or >>
        mut text := p.locale.integer(page + 1)
        if i == 0 { text = "‹" }
        else if i == count - 1 { text = "›" }
        else if page == -2 { text = "…" }
        cache := mut &p.labels
        cache.paint_text(i,&text,frame,&b,styles,&animated,state) or >>
        if selected { frame.pop() or >> }
    }
    << 0
}
pub fn (p &mut Pagination) dispose() {
    if p.control.closed { << }
    cache := mut &p.labels
    cache.dispose()
    p.cancel()
    p.control.closed = true
}
