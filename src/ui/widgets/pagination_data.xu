@ui/widgets
#errors
#ui/layout
#strings

pub struct PaginationAppearance { pub gap f64
    pub min_item_width f64
    pub stretch bool }
pub fn pagination_appearance() PaginationAppearance { << PaginationAppearance{gap: 6.0,min_item_width: 36.0,stretch: false} }
pub fn (page &mut Pagination) set_appearance(appearance &PaginationAppearance) int {
    if !finite_metric(appearance.gap,64.0) || !finite_metric(appearance.min_item_width,512.0) || appearance.min_item_width < 20.0 { >> errors.new("widgets: invalid pagination appearance") }
    page.appearance = PaginationAppearance{gap: appearance.gap,min_item_width: appearance.min_item_width,stretch: appearance.stretch}
    page.control.dirty = true
    << 0
}
pub struct PaginationData { pub total int
    pub page_size int
    pub pages int
    pub current int }
pub fn (page &Pagination) data() PaginationData { << PaginationData{total: page.total_items,page_size: page.page_size,pages: page.pages,current: page.current} }
// Keep the first item being viewed visible when page size changes.
pub fn (page &mut Pagination) set_data(total int,page_size int) int {
    if page.control.closed || total < 0 || total > 1000000000000 || page_size < 1 || page_size > 1000000 { >> errors.new("widgets: invalid pagination data") }
    pages := (total + page_size - 1) / page_size
    if pages > 1000000000 { >> errors.new("widgets: pagination exceeds one billion pages") }
    mut first := max_int(0,page.current) * page_size
    if page.page_size > 0 { first = max_int(0,page.current) * page.page_size }
    page.total_items = total
    page.page_size = page_size
    page.pages = pages
    page.current = -1
    if pages > 0 { page.current = min_int(pages - 1,first / page_size) }
    page.armed = -1
    page.hot = -1
    page.control.dirty = true
    << 0
}
pub fn (page &mut Pagination) jump(one_based int) int {
    if one_based < 1 || one_based > page.pages { >> errors.new("widgets: page number outside range") }
    << page.set_selected(one_based - 1) or >>
}
pub fn (page &Pagination) summary_text() string {
    if page.total_items < 0 { << page.locale.integer(max_int(0,page.current + 1)) + " / " + page.locale.integer(page.pages) }
    mut first := 0
    mut last := 0
    if page.current >= 0 { first = page.current * page.page_size + 1
        last = min_int(page.total_items,(page.current + 1) * page.page_size) }
    mut text := page.locale.text(TEXT_PAGE_SUMMARY) or >>
    text = strings.replace_all(&text,"{start}",page.locale.number(str(first),true))
    text = strings.replace_all(&text,"{end}",page.locale.number(str(last),true))
    << strings.replace_all(&text,"{total}",page.locale.number(str(page.total_items),true))
}
pub fn (s &mut Screen) set_pagination_data(id int,total int,page_size int) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_PAGINATION { >> errors.new("widgets: expected Pagination") }
    mut item := s.take_pagination(id)
    message := pagination_data_update(mut &item,total,page_size)
    s.controls.pages[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn pagination_data_update(item &mut Pagination,total int,page_size int) string { item.set_data(total,page_size) or (err) { << err.msg() }
    << "" }
pub fn (s &mut Screen) pagination_data(id int) PaginationData {
    node := s.node(id) or >>
    if node.kind != SCREEN_PAGINATION { >> errors.new("widgets: expected Pagination") }
    item := s.take_pagination(id)
    result := item.data()
    s.controls.pages[id] = item
    << result
}
pub fn (s &mut Screen) pagination_summary(id int) string {
    node := s.node(id) or >>
    if node.kind != SCREEN_PAGINATION { >> errors.new("widgets: expected Pagination") }
    item := s.take_pagination(id)
    result := pagination_summary_result(&item)
    s.controls.pages[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.text
}
struct PaginationText { text string
    error string }
fn pagination_summary_result(item &Pagination) PaginationText { text := item.summary_text() or (err) { << PaginationText{text: "",error: err.msg()} }
    << PaginationText{text: text,error: ""} }

fn (s &mut Screen) take_pagination(id int) Pagination {
    owner := mut &s.controls
    items := mut &owner.pages
    if !items.has(id) { >> errors.new("widgets: missing Pagination") }
    << items.take(id)
}
