@ui/widgets

#errors

pub const ACTION_FORM_SUBMIT = 27

pub struct FormFieldStatus {
    pub id int
    pub dirty bool
    pub touched bool
    pub invalid bool
    pub error_msg string
}

pub struct FormSummary {
    pub total int
    pub dirty_count int
    pub touched_count int
    pub invalid_count int
    pub valid bool
}

fn copy_form_field_status(st &FormFieldStatus) FormFieldStatus {
    << FormFieldStatus{
        id: st.id,
        dirty: st.dirty,
        touched: st.touched,
        invalid: st.invalid,
        error_msg: st.error_msg + ""
    }
}

pub fn (s $&Screen) register_form_field(form_id int,field_id int) int {
    _ := s.node(form_id) >>>
    _ := s.node(field_id) >>>
    comp := $&s.composition
    fmaps := $&comp.form_field_ids
    if !fmaps.has(form_id) { fmaps[form_id] = []int{} }
    $list := fmaps.take(form_id)
    vec_add_unique($&list,field_id)
    fmaps[form_id] = list
    fst := $&comp.form_fields
    if !fst.has(field_id) {
        fst[field_id] = FormFieldStatus{id: field_id,dirty: false,touched: false,invalid: false,error_msg: ""}
    }
    << 0
}

pub fn (s $&Screen) unregister_form_field(form_id int,field_id int) int {
    _ := s.node(form_id) >>>
    comp := $&s.composition
    if comp.form_field_ids.has(form_id) {
        fmaps := $&comp.form_field_ids
        old := fmaps.take(form_id)
        next := vec_without(&old,field_id)
        if next.len == 0 { << 0 }
        fmaps[form_id] = next
    }
    << 0
}

pub fn (s $&Screen) set_field_dirty(field_id int,dirty bool) int {
    _ := s.node(field_id) >>>
    comp := $&s.composition
    fst := $&comp.form_fields
    $st := FormFieldStatus{id: field_id,dirty: dirty,touched: false,invalid: false,error_msg: ""}
    if fst.has(field_id) {
        prev := fst.take(field_id)
        st = FormFieldStatus{id: field_id,dirty: dirty,touched: prev.touched,invalid: prev.invalid,error_msg: prev.error_msg + ""}
    }
    fst[field_id] = st
    << 0
}

pub fn (s $&Screen) set_field_touched(field_id int,touched bool) int {
    _ := s.node(field_id) >>>
    comp := $&s.composition
    fst := $&comp.form_fields
    $st := FormFieldStatus{id: field_id,dirty: false,touched: touched,invalid: false,error_msg: ""}
    if fst.has(field_id) {
        prev := fst.take(field_id)
        st = FormFieldStatus{id: field_id,dirty: prev.dirty,touched: touched,invalid: prev.invalid,error_msg: prev.error_msg + ""}
    }
    fst[field_id] = st
    << 0
}

pub fn (s $&Screen) set_field_error(field_id int,error_msg string) int {
    _ := s.node(field_id) >>>
    is_inv := error_msg.len > 0
    comp := $&s.composition
    fst := $&comp.form_fields
    $st := FormFieldStatus{id: field_id,dirty: false,touched: false,invalid: is_inv,error_msg: error_msg + ""}
    if fst.has(field_id) {
        prev := fst.take(field_id)
        st = FormFieldStatus{id: field_id,dirty: prev.dirty,touched: prev.touched,invalid: is_inv,error_msg: error_msg + ""}
    }
    fst[field_id] = st
    _ := s.set_invalid(field_id,is_inv) >>> (err) { << 0 }
    << 0
}

pub fn (s $&Screen) clear_field_error(field_id int) int {
    << s.set_field_error(field_id,"") >>>
}

pub fn (s &Screen) field_status(field_id int) FormFieldStatus {
    _ := s.node(field_id) >>>
    if s.composition.form_fields.has(field_id) {
        << copy_form_field_status(&s.composition.form_fields[field_id])
    }
    << FormFieldStatus{id: field_id,dirty: false,touched: false,invalid: false,error_msg: ""}
}

pub fn (s &Screen) form_summary(form_id int) FormSummary {
    _ := s.node(form_id) >>>
    if !s.composition.form_field_ids.has(form_id) {
        << FormSummary{total: 0,dirty_count: 0,touched_count: 0,invalid_count: 0,valid: true}
    }
    ids := &s.composition.form_field_ids[form_id]
    $tot := 0
    $dc := 0
    $tc := 0
    $ic := 0
    for i in 0:ids.len {
        fid := ids[i]
        if fid <= 0 || fid > s.nodes.len || s.nodes[fid - 1].kind < 0 { -> }
        tot += 1
        if s.composition.form_fields.has(fid) {
            st := &s.composition.form_fields[fid]
            if st.dirty { dc += 1 }
            if st.touched { tc += 1 }
            if st.invalid { ic += 1 }
        }
    }
    << FormSummary{total: tot,dirty_count: dc,touched_count: tc,invalid_count: ic,valid: ic == 0}
}

pub fn (s $&Screen) reset_form(form_id int) int {
    _ := s.node(form_id) >>>
    if !s.composition.form_field_ids.has(form_id) { << 0 }
    $copy_ids := []int{}
    ids_ref := &s.composition.form_field_ids[form_id]
    for i in 0:ids_ref.len { copy_ids.push(ids_ref[i]) }
    for fid in copy_ids {
        if fid > 0 && fid <= s.nodes.len && s.nodes[fid - 1].kind >= 0 {
            comp := $&s.composition
            fst := $&comp.form_fields
            fst[fid] = FormFieldStatus{id: fid,dirty: false,touched: false,invalid: false,error_msg: ""}
            _ := s.set_invalid(fid,false) >>> (err) { << 0 }
        }
    }
    << 0
}

pub fn (s $&Screen) focus_first_invalid(form_id int) int {
    _ := s.node(form_id) >>>
    if !s.composition.form_field_ids.has(form_id) { << 0 }
    $copy_ids := []int{}
    ids_ref := &s.composition.form_field_ids[form_id]
    for i in 0:ids_ref.len { copy_ids.push(ids_ref[i]) }
    for fid in copy_ids {
        if fid > 0 && fid <= s.nodes.len && s.nodes[fid - 1].kind >= 0 && s.composition.form_fields.has(fid) {
            st := &s.composition.form_fields[fid]
            if st.invalid {
                _ := s.ensure_visible(fid) >>> (err) { << fid }
                _ := s.focus(fid) >>> (err) { << fid }
                << fid
            }
        }
    }
    << 0
}

pub fn (s $&Screen) submit_form(form_id int) bool {
    _ := s.node(form_id) >>>
    if s.composition.form_field_ids.has(form_id) {
        $copy_ids := []int{}
        ids_ref := &s.composition.form_field_ids[form_id]
        for i in 0:ids_ref.len { copy_ids.push(ids_ref[i]) }
        for fid in copy_ids {
            if fid > 0 && fid <= s.nodes.len && s.nodes[fid - 1].kind >= 0 {
                s.set_field_touched(fid,true) >>>
            }
        }
    }
    summary := s.form_summary(form_id) >>>
    if !summary.valid {
        _ := s.focus_first_invalid(form_id) >>> (err) { << false }
        << false
    }
    qa := $&s.queued_actions
    qa.push(Action{kind: ACTION_FORM_SUBMIT,id: form_id,needs_paint: false,request_focus: false,consumed: true,value: 0.0})
    << true
}

fn (s $&Screen) cleanup_form_for(id int) {
    comp := $&s.composition
    if comp.form_field_ids.has(id) {
        fmaps := $&comp.form_field_ids
        fmaps.delete(id)
    }
    if comp.form_fields.has(id) {
        fst := $&comp.form_fields
        fst.delete(id)
    }
}

pub struct HistoryEntry {
    pub kind int
    pub target int
    pub label string
    pub before_data string
    pub after_data string
}

pub fn history_entry(kind int,target int,label string,before_data string,after_data string) HistoryEntry {
    << HistoryEntry{
        kind: kind,
        target: target,
        label: label + "",
        before_data: before_data + "",
        after_data: after_data + ""
    }
}

fn copy_history_entry(e &HistoryEntry) HistoryEntry {
    << HistoryEntry{
        kind: e.kind,
        target: e.target,
        label: e.label + "",
        before_data: e.before_data + "",
        after_data: e.after_data + ""
    }
}

pub struct HistoryStack {
    entries []HistoryEntry
    cursor int
    max_entries int
}

pub fn history_stack(max_entries int) HistoryStack {
    $cap := max_entries
    if cap < 1 { cap = 1 }
    if cap > 4096 { cap = 4096 }
    << HistoryStack{
        entries: []HistoryEntry{},
        cursor: 0,
        max_entries: cap
    }
}

pub fn (h &HistoryStack) can_undo() bool { << h.cursor > 0 }
pub fn (h &HistoryStack) can_redo() bool { << h.cursor < h.entries.len }
pub fn (h &HistoryStack) undo_count() int { << h.cursor }
pub fn (h &HistoryStack) redo_count() int { << h.entries.len - h.cursor }

pub fn (h $&HistoryStack) push(entry &HistoryEntry) {
    $trimmed := []HistoryEntry{}
    $start := 0
    if h.cursor >= h.max_entries {
        start = h.cursor - h.max_entries + 1
    }
    for i in start:h.cursor {
        trimmed.push(copy_history_entry(&h.entries[i]))
    }
    trimmed.push(copy_history_entry(entry))
    h.entries = trimmed
    h.cursor = h.entries.len
}

pub fn (h $&HistoryStack) undo() HistoryEntry {
    if h.cursor <= 0 { >>> errors.new("widgets: nothing to undo") }
    h.cursor = h.cursor - 1
    idx := h.cursor
    << copy_history_entry(&h.entries[idx])
}

pub fn (h $&HistoryStack) redo() HistoryEntry {
    if h.cursor >= h.entries.len { >>> errors.new("widgets: nothing to redo") }
    idx := h.cursor
    e := copy_history_entry(&h.entries[idx])
    h.cursor = idx + 1
    << e
}

pub fn (h $&HistoryStack) clear() {
    h.entries = []HistoryEntry{}
    h.cursor = 0
}
