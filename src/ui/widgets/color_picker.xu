@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

// Inline RGBA picker: four quantized 0..255 channels and a checkerboard alpha
// preview. Up/Down selects a channel; Left/Right, Home/End and Page keys adjust
// it. Each channel is also a draggable Slider. This is deliberately a small
// RGB editor rather than an HSV spectrum, OS eyedropper or color-profile tool.
pub struct ColorPicker {
    locale Locale
    control Button
    channels []Slider
    labels TextCache
    active int
    palette []draw.Color
    recent []draw.Color
    swatch_armed int
    show_swatches bool
    row_h f64
    pad f64
    preview_h f64
    label_w f64
    value_w f64
}
fn color_channel(value draw.Color,index int) int {
    shift := (3 - index) * 8
    << (value.value() >> shift) & 255
}
pub fn color_picker(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value draw.Color) ColorPicker {
    if !context.matches_canvas(identity) { >> errors.new("widgets: color picker context mismatch") }
    control := button(identity,id,bounds) or >>
    $channels := []Slider{}
    for i in 0:4 {
        $channel := slider(identity,id,bounds,0.0,255.0,f64(color_channel(value,i))) or >>
        channel.set_step(1.0) or >>
        channels.push(channel)
    }
    $picker := ColorPicker{locale: locale_default(),control: control,channels: channels,labels: text_cache(context),active: 0,palette: []draw.Color{},recent: []draw.Color{},swatch_armed: -1,show_swatches: false,row_h: 36.0,pad: 10.0,preview_h: 40.0,label_w: 24.0,value_w: 36.0}
    picker.set_bounds(bounds) or >>
    << picker
}
pub fn (picker &ColorPicker) id() int { << picker.control.id }
pub fn (picker &ColorPicker) bounds() layout.Rect { << picker.control.bounds() }
pub fn (picker &ColorPicker) is_enabled() bool { << picker.control.is_enabled() }
pub fn (picker &ColorPicker) is_focused() bool { << picker.control.is_focused() }
pub fn (picker &ColorPicker) active_channel() int { << picker.active }
pub fn (picker &ColorPicker) needs_paint() bool {
    if picker.control.dirty { << true }
    for channel in picker.channels { if channel.needs_paint() { << true } }
    << false
}
pub fn (picker &ColorPicker) channel(index int) int {
    if index < 0 || index > 3 { >> errors.new("widgets: RGBA channel index out of range") }
    << int(picker.channels[index].value())
}
pub fn (picker &ColorPicker) value() draw.Color {
    << draw.rgba(int(picker.channels[0].value()),int(picker.channels[1].value()),int(picker.channels[2].value()),int(picker.channels[3].value()))
}
pub fn (picker $&ColorPicker) set_channel(index int,value int) int {
    if picker.control.closed { >> errors.new("widgets: color picker is disposed") }
    if index < 0 || index > 3 || value < 0 || value > 255 { >> errors.new("widgets: RGBA channel must be 0..255") }
    $channel := picker.channels[index]
    channel.set_value(f64(value)) or >>
    picker.channels[index] = channel
    picker.control.dirty = true
    << 0
}
pub fn (picker $&ColorPicker) set_value(value draw.Color) int {
    for i in 0:4 { picker.set_channel(i,color_channel(value,i)) or >> }
    << 0
}
pub fn (picker &ColorPicker) style_or(styles &Styles) ControlStyle {
    if picker.control.has_style() { << picker.control.style_or(styles) }
    << styles.card_style()
}
pub fn (picker $&ColorPicker) set_style(style &ControlStyle) int { control := $&picker.control
    << control.set_style(style) or >> }
pub fn (picker $&ColorPicker) set_enabled(enabled bool) {
    control := $&picker.control
    control.set_enabled(enabled)
    for i in 0:4 { $channel := picker.channels[i]
        channel.set_enabled(enabled)
        picker.channels[i] = channel }
}
pub fn (picker $&ColorPicker) set_read_only(read_only bool) int {
    if picker.control.closed { >> errors.new("widgets: color picker is disposed") }
    control := $&picker.control
    control.set_read_only(read_only)
    for i in 0:4 { $channel := picker.channels[i]
        channel.set_read_only(read_only)
        picker.channels[i] = channel }
    << 0
}
pub fn (picker $&ColorPicker) set_invalid(invalid bool) {
    control := $&picker.control
    control.set_invalid(invalid)
    for i in 0:4 { $channel := picker.channels[i]
        channel.set_invalid(invalid)
        picker.channels[i] = channel }
}
pub fn (picker $&ColorPicker) set_focus(focused bool) {
    control := $&picker.control
    control.set_focus(focused)
    active := picker.active
    for i in 0:4 { $channel := picker.channels[i]
        channel.set_focus(focused && i == active)
        picker.channels[i] = channel }
}
pub fn (picker &ColorPicker) preview_bounds() layout.Rect {
    b := picker.bounds()
    << layout.Rect{x: b.x + picker.pad,y: b.y + picker.pad,width: math.max(0.0,b.width - picker.pad * 2.0),height: math.min(picker.preview_h,math.max(0.0,b.height - picker.pad * 2.0))}
}
pub fn (picker &ColorPicker) channel_bounds(index int) layout.Rect {
    if index < 0 || index > 3 { >> errors.new("widgets: RGBA channel index out of range") }
    b := picker.bounds()
    y := b.y + picker.pad * 2.0 + picker.preview_h + f64(index) * picker.row_h
    height := math.min(picker.row_h,math.max(0.0,b.y + b.height - picker.pad - y))
    << layout.Rect{x: b.x + picker.pad + picker.label_w,y: y,width: math.max(0.0,b.width - picker.pad * 2.0 - picker.label_w - picker.value_w),height: height}
}
fn (picker $&ColorPicker) place_channels() int {
    for i in 0:4 { b := picker.channel_bounds(i) or >>
        $channel := picker.channels[i]
        channel.set_bounds(&b) or >>
        picker.channels[i] = channel }
    << 0
}
pub fn (picker $&ColorPicker) set_bounds(bounds &layout.Rect) int {
    control := $&picker.control
    control.set_bounds(bounds) or >>
    << picker.place_channels() or >>
}
pub fn (picker $&ColorPicker) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := picker.style_or(styles)
    options := styles.text_options(&c)
    height := math.max(32.0 * styles.density,options.size * 1.5 + 8.0 * styles.density)
    pad := 10.0 * styles.density
    $label_w := math.max(22.0 * styles.density,options.size * 1.5)
    for i in 0:4 { text := picker.locale.text(TEXT_RED+i) or >>
        cache := $&picker.labels
        size := cache.measure(100+i,&text,styles,&c) or >>
        label_w = math.max(label_w,size.width + 8.0 * styles.density) }
    value := picker.locale.integer(255)
    cache := $&picker.labels
    value_size := cache.measure(104,&value,styles,&c) or >>
    value_w := math.max(36.0 * styles.density,value_size.width + 8.0 * styles.density)
    preview_h := math.max(36.0 * styles.density,options.size * 2.0)
    if height != picker.row_h || pad != picker.pad || label_w != picker.label_w || value_w != picker.value_w || preview_h != picker.preview_h {
        picker.row_h = height
        picker.pad = pad
        picker.label_w = label_w
        picker.value_w = value_w
        picker.preview_h = preview_h
        picker.control.dirty = true
        picker.place_channels() or >>
    }
    << 0
}
pub fn (picker $&ColorPicker) input(event &ui.InputEvent) Action {
    id := picker.id()
    if !belongs(&picker.control.identity,event) || !picker.is_enabled() { << no_action(id,picker.needs_paint()) }
    if event.kind == ui.EV_POINTER_CANCEL { picker.set_focus(false)
        << no_action(id,true) }
    swatch_action := picker.swatch_input(event) or >>
    if swatch_action.consumed { << swatch_action }
    $request_focus := false
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT {
        for i in 0:4 { b := picker.channel_bounds(i) or >>
            if b.contains(event.x,event.y) { picker.active = i
                picker.set_focus(true)
                request_focus = true } }
    }
    if event.kind == ui.EV_KEY_DOWN && picker.control.focused && (event.key == ui.KEY_UP || event.key == ui.KEY_DOWN) {
        $delta := 1
        if event.key == ui.KEY_UP { delta = -1 }
        picker.active = (picker.active + delta + 4) % 4
        picker.set_focus(true)
        << Action{kind: ACTION_NONE,id: id,needs_paint: true,request_focus: false,consumed: true,value: f64(picker.value().value())}
    }
    active := picker.active
    focused := picker.control.focused
    $channel := picker.channels[active]
    channel.set_focus(focused)
    $result := channel.input(event)
    picker.channels[active] = channel
    if result.kind == ACTION_COMMIT { picker.remember() }
    result.id = id
    result.request_focus = result.request_focus || request_focus
    if result.kind == ACTION_CHANGE { picker.control.dirty = true }
    result.needs_paint = picker.needs_paint()
    result.value = f64(picker.value().value())
    << result
}
pub fn (picker $&ColorPicker) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid color picker route") }
    if !belongs(&picker.control.identity,event) { << no_action(picker.id(),false) }
    if kind == ROUTE_FOCUS { picker.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { picker.set_focus(false) }
    else { << picker.input(event) or >> }
    << no_action(picker.id(),picker.needs_paint())
}
pub fn (picker $&ColorPicker) event(event &ui.Event) Action {
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << picker.input(&input) or >> }
    control := $&picker.control
    result := control.event(event) or >>
    if !picker.control.focused { picker.set_focus(false) }
    for i in 0:4 { $channel := picker.channels[i]
        _ := channel.event(event) or >>
        picker.channels[i] = channel }
    << result
}
pub fn (picker $&ColorPicker) measure_styled(styles &Styles) layout.Size {
    picker.apply_styles(styles) or >>
    << layout.Size{width: math.max(240.0 * styles.density,picker.label_w + picker.value_w + picker.pad * 2.0 + 100.0 * styles.density),height: picker.pad * 3.0 + picker.preview_h + picker.row_h * 4.0 + picker.swatch_height()}
}
pub fn (picker $&ColorPicker) paint_styled(frame $&draw.Frame,styles &Styles) int {
    picker.apply_styles(styles) or >>
    $c := picker.style_or(styles)
    b := picker.bounds()
    state := picker.control.visual_state()
    style_box(frame,&b,&c,styles.density,state) or >>
    p := picker.preview_bounds()
    for row in 0:4 { for col in 0:16 {
        $ink := draw.rgb(232,235,240)
        if (row + col) % 2 == 1 { ink = draw.rgb(179,187,199) }
        frame.fill_rect(p.x + f64(col) * p.width / 16.0,p.y + f64(row) * p.height / 4.0,p.width / 16.0,p.height / 4.0,ink) or >>
    } }
    frame.fill_rect(p.x,p.y,p.width,p.height,picker.value()) or >>
    frame.stroke_rect(p.x,p.y,p.width,p.height,c.resolve(state).border,1.0) or >>
    c.padding = layout.insets(0.0) or >>
    c.align_x = 0.0
    names := [picker.locale.text(TEXT_RED) or >>,picker.locale.text(TEXT_GREEN) or >>,picker.locale.text(TEXT_BLUE) or >>,picker.locale.text(TEXT_ALPHA) or >>]
    for i in 0:4 {
        $slider_style := styles.slider_style()
        if i == 0 { slider_style.palette.accent = draw.rgb(224,73,86) }
        else if i == 1 { slider_style.palette.accent = draw.rgb(42,151,93) }
        else if i == 2 { slider_style.palette.accent = draw.rgb(60,117,224) }
        slider_style.palette.invalid = c.palette.invalid
        value := picker.locale.integer(picker.channel(i) or >>)
        channel_b := picker.channel_bounds(i) or >>
        $channel := picker.channels[i]
        channel.set_style(&slider_style) or >>
        channel.apply_styles(styles) or >>
        channel.paint_styled(frame,styles) or >>
        channel.painted()
        picker.channels[i] = channel
        label_b := layout.Rect{x: b.x + picker.pad,y: channel_b.y,width: picker.label_w,height: channel_b.height}
        value_b := layout.Rect{x: channel_b.x + channel_b.width,y: channel_b.y,width: picker.value_w,height: channel_b.height}
        text := names[i]
        index := i * 2
        labels := $&picker.labels
        labels.paint_text(index,&text,frame,&label_b,styles,&c,state) or >>
        c.align_x = 1.0
        labels.paint_text(index + 1,&value,frame,&value_b,styles,&c,state) or >>
        c.align_x = 0.0
    }
    picker.paint_swatches(frame,styles,&c) or >>
    picker.control.dirty = false
    << 0
}
pub fn (picker $&ColorPicker) dispose() {
    labels := $&picker.labels
    labels.dispose()
    for i in 0:4 { $channel := picker.channels[i]
        channel.cancel()
        channel.closed = true
        channel.enabled = false
        picker.channels[i] = channel }
    picker.control.closed = true
    picker.control.enabled = false
}
