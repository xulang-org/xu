@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

pub const TASK_IDLE = 0
pub const TASK_RUNNING = 1
pub const TASK_SUCCESS = 2
pub const TASK_ERROR = 3
pub const TASK_CANCELLED = 4
pub const TASK_PROGRESS_LINE = 0
pub const TASK_PROGRESS_FILL = 1
pub const TASK_PROGRESS_ICON = 2
pub const ACTION_CANCEL_TASK = 7

pub struct TaskButton {
    locale Locale
    control Button
    labels TextCache
    activity Spinner
    transition PaintTransition
    amount Tween
    motion MotionSpec
    feedback TaskFeedback
    started time.Instant
    completed_at time.Instant
    state_val int
    task_id int
    actual f64
    determinate bool
    cancellable bool
    cancelling bool
    mode int
    custom_labels bool
    label string
    running_label string
    success_label string
    error_label string
    cancelled_label string
    now time.Instant
    reduced bool
}
pub fn task_button(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,label &string) TaskButton {
    if !context.matches_canvas(identity) { >> errors.new("widgets: task context mismatch") }
    validate_table_text(label) or >>
    control := button(identity,id,bounds) or >>
    activity := spinner(bounds) or >>
    labels := text_cache(context)
    transition := paint_transition()
    amount := tween(0.0) or >>
    motion := motion_spec()
    feedback := task_feedback()
    started := time.zero_instant()
    completed_at := time.zero_instant()
    locale := locale_default()
    running := locale.text(TEXT_TASK_WORKING) or >>
    done := locale.text(TEXT_TASK_DONE) or >>
    retry := locale.text(TEXT_TASK_RETRY) or >>
    << TaskButton{locale: locale,control: control,labels: labels,activity: activity,transition: transition,
        amount: amount,motion: motion,feedback: feedback,started: started,completed_at: completed_at,state_val: TASK_IDLE,task_id: 0,actual: 0.0,determinate: false,
        cancellable: false,cancelling: false,mode: TASK_PROGRESS_LINE,custom_labels: false,label: label + "",running_label: running,
        success_label: done,error_label: retry + "",cancelled_label: retry,now: time.zero_instant(),reduced: false}
}
pub fn (task &TaskButton) id() int { << task.control.id }
pub fn (task &TaskButton) bounds() layout.Rect { << task.control.bounds() }
pub fn (task &TaskButton) state() int { << task.state_val }
pub fn (task &TaskButton) task_id() int { << task.task_id }
pub fn (task &TaskButton) is_running() bool { << task.state_val == TASK_RUNNING }
pub fn (task &TaskButton) is_determinate() bool { << task.determinate }
pub fn (task &TaskButton) progress() f64 { << task.actual }
pub fn (task &TaskButton) is_enabled() bool { << task.control.is_enabled() }
pub fn (task &TaskButton) is_focused() bool { << task.control.focused }
pub fn (task &TaskButton) needs_paint() bool { << task.control.dirty }
pub fn (task $&TaskButton) painted() { task.control.dirty = false
    task.activity.dirty = false }
pub fn (task $&TaskButton) cancel() { control := $&task.control
    control.cancel() }
pub fn (task $&TaskButton) set_focus(focused bool) { control := $&task.control
    control.set_focus(focused) }
pub fn (task $&TaskButton) set_enabled(enabled bool) { control := $&task.control
    control.set_enabled(enabled)
    activity := $&task.activity
    activity.set_enabled(enabled) }
pub fn (task $&TaskButton) set_bounds(bounds &layout.Rect) int { control := $&task.control
    << control.set_bounds(bounds) or >> }
pub fn (task $&TaskButton) set_style(style &ControlStyle) int { control := $&task.control
    << control.set_style(style) or >> }
pub fn (task $&TaskButton) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    task.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    transition := $&task.transition
    transition.set_spec(spec) or >>
    << 0
}
pub fn (task $&TaskButton) set_progress_mode(mode int) int {
    if mode < TASK_PROGRESS_LINE || mode > TASK_PROGRESS_ICON { >> errors.new("widgets: invalid task progress mode") }
    task.mode = mode
    task.control.dirty = true
    << 0
}
pub fn (task $&TaskButton) set_labels(running &string,success &string,error &string,cancelled &string) int {
    validate_table_text(running) or >>
    validate_table_text(success) or >>
    validate_table_text(error) or >>
    validate_table_text(cancelled) or >>
    task.custom_labels = true
    task.running_label = running + ""
    task.success_label = success + ""
    task.error_label = error + ""
    task.cancelled_label = cancelled + ""
    task.control.dirty = true
    << 0
}
pub fn (task $&TaskButton) set_cancellable(enabled bool) {
    task.cancellable = enabled
    task.control.dirty = true
}
// Strictly increasing task IDs prevent a late completion from replacing a
// retry. The caller owns execution, cancellation and all progress reporting.
pub fn (task $&TaskButton) begin(id int,now time.Instant) int {
    if task.control.closed || task.is_running() || id <= task.task_id || id <= 0 { >> errors.new("widgets: invalid task start or stale task id") }
    task.task_id = id
    task.state_val = TASK_RUNNING
    task.actual = 0.0
    task.determinate = false
    task.cancelling = false
    task.now = now
    task.started=now
    task.completed_at=time.zero_instant()
    amount := $&task.amount
    amount.snap(0.0) or >>
    task.control.pointer_armed = false
    task.control.keyboard_armed = 0
    task.control.dirty = true
    activity := $&task.activity
    activity.set_running(true)
    << 0
}
pub fn (task $&TaskButton) set_progress(id int,value f64) bool {
    if task.control.closed || !task.is_running() || id != task.task_id { << false }
    if math.is_nan(value) || math.is_inf(value) || value < 0.0 || value > 1.0 || (task.determinate && value < task.actual) {
        >> errors.new("widgets: task progress must be finite, monotonic and within 0..1")
    }
    if task.determinate && task.actual==value { << true }
    task.actual = value
    task.determinate = true
    task.control.dirty = true
    << true
}
pub fn (task $&TaskButton) complete(id int,state int) bool {
    if task.control.closed || !task.is_running() || id != task.task_id { << false }
    if state < TASK_SUCCESS || state > TASK_CANCELLED { >> errors.new("widgets: invalid terminal task state") }
    task.state_val = state
    task.completed_at=task.now
    task.cancelling = false
    if state == TASK_SUCCESS { task.actual = 1.0 }
    task.control.dirty = true
    activity := $&task.activity
    activity.set_running(false)
    << true
}
pub fn (task $&TaskButton) reset() int {
    if task.is_running() || task.control.closed { >> errors.new("widgets: cannot reset an active or disposed task") }
    task.state_val = TASK_IDLE
    task.control.dirty = true
    << 0
}
pub fn (task $&TaskButton) input(input &ui.InputEvent) Action {
    if task.control.closed || !belongs(&task.control.identity,input) { << no_action(task.id(),task.needs_paint()) }
    if task.is_running() && task.control.is_enabled() {
        if input.kind == ui.EV_POINTER_CANCEL { task.cancel()
            << no_action(task.id(),true) }
        if input.kind == ui.EV_KEY_DOWN && task.control.focused && input.key == ui.KEY_ESCAPE && task.cancellable && !task.cancelling {
            task.cancelling = true
            task.control.dirty = true
            << Action{kind: ACTION_CANCEL_TASK,id: task.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(task.task_id)}
        }
        inside := task.control.bounds.contains(input.x,input.y)
        if input.kind == ui.EV_POINTER_DOWN && inside {
            << Action{kind: ACTION_NONE,id: task.id(),needs_paint: false,request_focus: true,consumed: true,value: 0.0}
        }
        if (input.kind == ui.EV_KEY_DOWN || input.kind == ui.EV_KEY_UP) && task.control.focused &&
            (input.key == ui.KEY_ENTER || input.key == 32 || input.key == ui.KEY_ESCAPE) {
            << Action{kind: ACTION_NONE,id: task.id(),needs_paint: false,request_focus: false,consumed: true,value: 0.0}
        }
        if input.kind == ui.EV_POINTER_UP && inside { << Action{kind: ACTION_NONE,id: task.id(),needs_paint: false,request_focus: false,consumed: true,value: 0.0} }
        << no_action(task.id(),task.needs_paint())
    }
    control := $&task.control
    << control.input(input) or >>
}
pub fn (task $&TaskButton) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid task route") }
    if kind == ROUTE_FOCUS { task.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { task.cancel() }
    else { << task.input(input) or >> }
    << no_action(task.id(),task.needs_paint())
}
pub fn (task $&TaskButton) event(event &ui.Event) Action {
    if event.window_id != task.control.identity.window_id { << no_action(task.id(),task.needs_paint()) }
    if event.kind == ui.EV_BLURRED { task.cancel() }
    if event.kind == ui.EV_CLOSED { task.dispose() }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == task.control.identity.canvas_id && identity.generation == task.control.identity.generation { task.dispose() }
    }
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << task.input(&input) or >> }
    << no_action(task.id(),task.needs_paint())
}
pub fn (task $&TaskButton) tick(now time.Instant,reduced bool) bool {
    task.now = now
    task.reduced = reduced
    if task.state_val==TASK_SUCCESS && !task.feedback.success_hold.is_zero() && now.since(task.completed_at).nanoseconds()>=task.feedback.success_hold.nanoseconds() { task.reset() or >> }
    $changed := false
    target := task.actual
    duration := task.motion.change
    curve := task.motion.curve
    amount := $&task.amount
    before := amount.value()
    amount.set_curve(curve) or (err) { >> errors.new("widgets: task progress: " + err.msg()) }
    amount.retarget(target,now,duration,reduced) or >>
    _ := amount.advance(now) or >>
    if amount.value() != before { changed = true }
    transition := $&task.transition
    if transition.advance(now) or >> { changed = true }
    if task.is_running() && task.feedback_visible() && !task.determinate {
        activity := $&task.activity
        if activity.tick(now,reduced) or >> { changed = true }
    }
    if changed { task.control.dirty = true }
    << changed
}
pub fn (task &TaskButton) next_tick(now time.Instant) time.Instant {
    if task.control.closed { << time.zero_instant() }
    if task.state_val==TASK_SUCCESS && !task.feedback.success_hold.is_zero() { << task.completed_at.add(task.feedback.success_hold) or >> }
    if task.is_running() && !task.feedback_visible() { << task.started.add(task.feedback.delay) or >> }
    if task.amount.is_animating() || task.transition.is_animating() { << overlay_next_tick(true,now) or >> }
    if task.is_running() && !task.determinate { << task.activity.next_tick(now,task.reduced) or >> }
    << time.zero_instant()
}
fn (task &TaskButton) display_text() string {
    if task.state_val == TASK_RUNNING {
        if task.cancelling { << task.locale.text(TEXT_TASK_CANCELLING) or >> }
        if task.determinate && task.feedback.percentage { << task.running_label + " " + (task.locale.count_text(TEXT_PERCENT_PATTERN,int(task.actual * 100.0)) or >>) }
        << task.running_label + ""
    }
    if task.state_val == TASK_SUCCESS { << task.success_label + "" }
    if task.state_val == TASK_ERROR { << task.error_label + "" }
    if task.state_val == TASK_CANCELLED { << task.cancelled_label + "" }
    << task.label + ""
}
pub fn (task $&TaskButton) measure_styled(styles &Styles) layout.Size {
    c := task.control.style_or(styles)
    candidates := [task.label + "",task.running_label + " " + (task.locale.count_text(TEXT_PERCENT_PATTERN,100) or >>),task.success_label + "",task.error_label + "",task.cancelled_label + "",task.locale.text(TEXT_TASK_CANCELLING) or >>]
    $width := c.min_width * styles.density
    $height := c.min_height * styles.density
    for i in 0:candidates.len {
        cache := $&task.labels
        size := cache.measure(i,&candidates[i],styles,&c) or >>
        width = math.max(width,size.width + (c.padding.left + c.padding.right + 24.0) * styles.density)
        height = math.max(height,size.height + (c.padding.top + c.padding.bottom) * styles.density)
    }
    << layout.Size{width: width,height: height}
}
fn (task $&TaskButton) prepare_transition(styles &Styles) ControlStyle {
    base := task.control.style_or(styles)
    $state := task.control.visual_state()
    if task.state_val==TASK_ERROR { state=state|STATE_INVALID }
    now := task.now
    reduced := task.reduced
    transition := $&task.transition
    << transition.style(&base,state,now,reduced) or >>
}
pub fn (task $&TaskButton) paint_styled(frame $&draw.Frame,styles &Styles) int {
    c := task.prepare_transition(styles) or >>
    $state := task.control.visual_state()
    if task.state_val == TASK_ERROR { state = state | STATE_INVALID }
    b := task.bounds()
    d := styles.density
    paint := c.resolve(state)
    $progress_ink := c.palette.accent
    background := paint.background.value()
    accent := c.palette.accent.value()
    distance := math.abs(f64(((background>>24)&255)-((accent>>24)&255)))+math.abs(f64(((background>>16)&255)-((accent>>16)&255)))+math.abs(f64(((background>>8)&255)-((accent>>8)&255)))
    if distance<64.0 { progress_ink=paint.foreground }
    style_box(frame,&b,&c,d,state) or >>
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    if task.is_running() && task.feedback_visible() && task.determinate && task.mode != TASK_PROGRESS_ICON {
        $r := layout.Rect{x: b.x,y: b.y + b.height - task.feedback.thickness*d,width: b.width,height: task.feedback.thickness*d}
        $color := progress_ink
        if task.mode == TASK_PROGRESS_FILL { r.y = b.y
            r.height = b.height
            color = mix_color(paint.background,progress_ink,0.16)
            if distance<64.0 { $target := draw.rgb(0,0,0)
                ink := paint.foreground.value()
                if ((ink>>24)&255)+((ink>>16)&255)+((ink>>8)&255)<384 { target=draw.rgb(255,255,255) }
                color=mix_color(paint.background,target,0.12) } }
        frame.push() or >>
        frame.clip_rect(r.x,r.y,r.width,r.height) or >>
        if task.mode == TASK_PROGRESS_LINE { rounded_fill(frame,&b,c.radius * d,fade_color(progress_ink,0.16)) or >> }
        frame.clip_rect(r.x,r.y,r.width * task.amount.value(),r.height) or >>
        rounded_fill(frame,&b,c.radius * d,color) or >>
        frame.pop() or >>
    }
    $text_rect := copy_rect(&b)
    if task.is_running() && task.feedback_visible() && (!task.determinate || task.mode == TASK_PROGRESS_ICON) {
        icon := layout.Rect{x: b.x + 10.0 * d,y: b.y + (b.height - 18.0 * d) * 0.5,width: 18.0 * d,height: 18.0 * d}
        if !task.determinate { activity := $&task.activity
            activity.set_bounds(&icon) or >>
            $activity_style := styles.progress.clone()
            activity_style.palette.accent=progress_ink
            activity.set_style(&activity_style) or >>
            activity.paint_styled(frame,styles) or >> }
        else {
            steps := 24
            for i in 0:steps {
                angle := f64(i) * 6.283185307179586 / f64(steps)
                $color := fade_color(progress_ink,0.2)
                if f64(i) / f64(steps) < task.amount.value() { color = progress_ink }
                frame.set_fill(color) or >>
                frame.circle(icon.x + icon.width * 0.5 + math.sin(angle) * 7.0 * d,icon.y + icon.height * 0.5 - math.cos(angle) * 7.0 * d,d) or >>
            }
        }
    }
    text := task.display_text()
    labels := $&task.labels
    labels.paint_text(100,&text,frame,&text_rect,styles,&c,state) or >>
    frame.pop() or >>
    << 0
}
pub fn (task $&TaskButton) dispose() {
    cache := $&task.labels
    cache.dispose()
    task.cancel()
    task.control.closed = true
    task.activity.running = false
}
