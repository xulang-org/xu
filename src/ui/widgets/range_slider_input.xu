@ui/widgets
#ui
#math

fn (r &RangeSlider) ratio(value f64) f64 { << (value - r.minimum) / (r.maximum - r.minimum) }
fn (r &RangeSlider) value_at(x f64,y f64) f64 {
    $fraction := (x - r.track.x) / math.max(1.0,r.track.width)
    if r.options.vertical { fraction = 1.0 - (y - r.track.y) / math.max(1.0,r.track.height) }
    if r.options.reversed { fraction = 1.0 - fraction }
    << r.snap(r.minimum + math.max(0.0,math.min(1.0,fraction)) * (r.maximum - r.minimum),0)
}
fn (r &RangeSlider) nearest(value f64) int {
    low := math.abs(value - r.lower)
    high := math.abs(value - r.upper)
    if low == high { << r.active }
    if low < high { << 0 }
    << 1
}
fn (r $&RangeSlider) move_thumb(value f64) {
    gap := r.options.min_distance
    next := r.snap(value,0)
    if r.active == 0 {
        if r.options.collision == RANGE_PUSH && next > r.upper - gap {
            r.upper = r.snap(math.min(r.maximum,next + gap),1) }
        r.lower = math.min(next,r.snap(r.upper - gap,-1))
    } else {
        if r.options.collision == RANGE_PUSH && next < r.lower + gap {
            r.lower = r.snap(math.max(r.minimum,next - gap),-1) }
        r.upper = math.max(next,r.snap(r.lower + gap,1))
    }
    r.control.dirty = true
}
fn (r $&RangeSlider) begin_edit() { if !r.pending { r.saved_lower = r.lower
    r.saved_upper = r.upper
    r.pending = true } }
// A RangeSlider has two Tab stops. Screen calls this before moving to another node.
pub fn (r $&RangeSlider) tab(backward bool,entering bool) bool {
    if entering { if backward { r.active = 1 } else { r.active = 0 }
        r.control.dirty = true
        << false }
    if (!backward && r.active == 0) || (backward && r.active == 1) {
        if r.pending { r.cancel()
            r.control.focused = true }
        r.active = 1 - r.active
        r.control.dirty = true
        << true }
    << false
}
pub fn (r $&RangeSlider) input(event &ui.InputEvent) Action {
    if !belongs(&r.control.identity,event) || r.control.closed { << no_action(r.id(),false) }
    if event.kind == ui.EV_POINTER_CANCEL { r.cancel()
        << no_action(r.id(),true) }
    if !r.is_enabled() { << no_action(r.id(),r.needs_paint()) }
    old_lower := r.lower
    old_upper := r.upper
    $action := no_action(r.id(),r.needs_paint())
    inside := r.bounds().contains(event.x,event.y)
    value := r.value_at(event.x,event.y)
    $commit := false
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER {
        r.hot = -1
        if inside { r.hot = r.nearest(value) }
        if r.dragging >= 0 && !r.control.read_only {
            if r.dragging == 2 {
                span := r.saved_upper - r.saved_lower
                delta := value - r.drag_origin
                lo := r.snap(math.max(r.minimum,math.min(r.maximum - span,r.saved_lower + delta)),0)
                r.lower = math.min(lo,r.maximum - span)
                r.upper = r.lower + span
            } else { r.move_thumb(value) }
            action.consumed = true }
        r.control.dirty = true
    } else if event.kind == ui.EV_POINTER_LEAVE { r.hot = -1
        r.control.dirty = true }
    else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && inside {
        action.request_focus = true
        action.consumed = true
        r.active = r.nearest(value)
        if !r.control.read_only {
            r.begin_edit()
            r.dragging = r.active
            distance := math.min(math.abs(value - r.lower),math.abs(value - r.upper))
            $length := r.track.width
            if r.options.vertical { length = r.track.height }
            if r.options.drag_range && value > r.lower && value < r.upper && distance / (r.maximum - r.minimum) * length > math.max(12.0,r.thumb) {
                r.dragging = 2
                r.drag_origin = value
            } else { r.move_thumb(value) }
        }
        r.control.dirty = true
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && r.dragging >= 0 {
        commit = r.pending && (r.lower != r.saved_lower || r.upper != r.saved_upper)
        r.pending = false
        r.dragging = -1
        action.consumed = true
        r.control.dirty = true
    } else if event.kind == ui.EV_KEY_DOWN && r.control.focused {
        if event.key == ui.KEY_ESCAPE { r.cancel()
            r.control.focused = true
            action.consumed = true }
        else if event.key == 32 && event.repeat == 0 { _ := r.tab(r.active == 1,false)
            action.consumed = true }
        else if !r.control.read_only {
            $delta := r.options.step
            if delta == 0.0 { delta = (r.maximum - r.minimum) * 0.01 }
            $direction := 0.0
            if event.key == ui.KEY_LEFT || event.key == ui.KEY_DOWN || event.key == ui.KEY_PAGE_DOWN { direction = -1.0 }
            if event.key == ui.KEY_RIGHT || event.key == ui.KEY_UP || event.key == ui.KEY_PAGE_UP { direction = 1.0 }
            if event.key == ui.KEY_PAGE_DOWN || event.key == ui.KEY_PAGE_UP { delta = delta * 10.0 }
            if r.options.reversed { direction = 0.0 - direction }
            if direction != 0.0 || event.key == ui.KEY_HOME || event.key == ui.KEY_END {
                r.begin_edit()
                r.key_pending = event.key
                $next := r.lower
                if r.active == 1 { next = r.upper }
                next = next + direction * delta
                if event.key == ui.KEY_HOME { next = r.minimum }
                if event.key == ui.KEY_END { next = r.maximum }
                r.move_thumb(next)
                action.consumed = true }
        }
    } else if event.kind == ui.EV_KEY_UP && r.key_pending != 0 && event.key == r.key_pending {
        commit = r.pending && (r.lower != r.saved_lower || r.upper != r.saved_upper)
        r.pending = false
        r.key_pending = 0
        action.consumed = true }
    if (r.lower != old_lower || r.upper != old_upper) && !r.options.commit_only { action.kind = ACTION_CHANGE }
    if commit { action.kind = ACTION_COMMIT }
    action.value = r.lower
    if r.active == 1 { action.value = r.upper }
    action.needs_paint = r.needs_paint()
    << action
}
pub fn (r $&RangeSlider) route(kind int,event &ui.InputEvent) Action {
    if kind == ROUTE_FOCUS { r.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { r.cancel() }
    else if kind == ROUTE_INPUT { << r.input(event) or >> }
    << no_action(r.id(),r.needs_paint())
}
