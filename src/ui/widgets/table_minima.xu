@ui/widgets
#errors

pub fn (t &mut Table) set_column_min_width(column int,width f64) int {
    if column < 0 || column >= t.column_count() || !finite_metric(width,4096.0) || width < 24.0 { >> errors.new("widgets: invalid table column minimum") }
    t.minima[column] = width
    if t.widths[column] > 0.0 && t.widths[column] < width { t.widths[column] = width }
    bounds := t.bounds()
    t.set_bounds(&bounds) or >>
    t.set_horizontal_offset(t.scroll_x) or >>
    t.rows.dirty = true
    << 0
}
pub fn (s &mut Screen) set_table_column_min_width(id int,column int,width f64) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_TABLE { >> errors.new("widgets: expected Table") }
    owner := mut &s.controls
    items := mut &owner.tables
    mut item := items.take(id)
    message := screen_table_minimum(mut &item,column,width)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_table_minimum(item &mut Table,column int,width f64) string {
    item.set_column_min_width(column,width) or (err) { << err.msg() }
    << ""
}
