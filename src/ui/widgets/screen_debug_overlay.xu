@ui/widgets

#ui/draw
#errors

pub const DEBUG_BOUNDS = 1
pub const DEBUG_PADDING = 2
pub const DEBUG_CLIPS = 4
pub const DEBUG_HOVER = 8
pub const DEBUG_ALL = 15

pub fn (s $&Screen) set_debug_overlay(flags int) int {
    s.check_screen() >>>
    if flags < 0 || flags > DEBUG_ALL { >>> errors.new("widgets: invalid debug overlay flags") }
    comp := $&s.composition
    if comp.debug_overlay_flags != flags {
        comp.debug_overlay_flags = flags
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) debug_overlay_flags() int {
    << s.composition.debug_overlay_flags
}

pub fn (s &Screen) is_debug_overlay_enabled() bool {
    << s.composition.debug_overlay_flags != 0
}

pub fn (s $&Screen) set_debug_highlight_node(id int) int {
    s.check_screen() >>>
    if id > 0 { _ := s.node(id) >>> }
    comp := $&s.composition
    if comp.debug_highlight_node != id {
        comp.debug_highlight_node = id
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) debug_highlight_node() int {
    << s.composition.debug_highlight_node
}

fn (s $&Screen) paint_debug_overlay(frame $&draw.Frame) int {
    flags := s.composition.debug_overlay_flags
    if flags == 0 { << 0 }
    lcount := s.composition.live_ids.len
    bounds_col := draw.rgba(14,165,233,140)
    pad_col := draw.rgba(34,197,94,48)
    clip_col := draw.rgba(245,158,11,180)
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len { -> }
        n := s.nodes[nid - 1]
        if n.kind < 0 || !s.is_visible(nid) || s.is_layout_hidden(nid) { -> }
        b := n.bounds
        if b.width <= 0.0 || b.height <= 0.0 { -> }
        if (flags & DEBUG_BOUNDS) != 0 {
            frame.stroke_rect(b.x,b.y,b.width,b.height,bounds_col,1.0) >>>
        }
        if (flags & DEBUG_PADDING) != 0 && s.composition.containers.has(nid) {
            cfg := &s.composition.containers[nid]
            pad := cfg.padding
            if pad.top > 0.0 { frame.fill_rect(b.x,b.y,b.width,pad.top,pad_col) >>> }
            if pad.bottom > 0.0 { frame.fill_rect(b.x,b.y + b.height - pad.bottom,b.width,pad.bottom,pad_col) >>> }
            if pad.left > 0.0 { frame.fill_rect(b.x,b.y,pad.left,b.height,pad_col) >>> }
            if pad.right > 0.0 { frame.fill_rect(b.x + b.width - pad.right,b.y,pad.right,b.height,pad_col) >>> }
        }
        if (flags & DEBUG_CLIPS) != 0 && (s.basics.scrolls.has(nid) || s.container_is_clipped(nid)) {
            clip := s.local_container_clip_rect(nid)
            if clip.width > 0.0 && clip.height > 0.0 {
                frame.stroke_rect(clip.x,clip.y,clip.width,clip.height,clip_col,1.0) >>>
            }
        }
    }
    if (flags & DEBUG_HOVER) != 0 {
        $hl := s.composition.debug_highlight_node
        if hl <= 0 { hl = s.hovered }
        if hl > 0 && hl <= s.nodes.len && s.nodes[hl - 1].kind >= 0 && s.is_visible(hl) {
            hb := s.nodes[hl - 1].bounds
            if hb.width > 0.0 && hb.height > 0.0 {
                frame.fill_rect(hb.x,hb.y,hb.width,hb.height,draw.rgba(244,63,94,48)) >>>
                frame.stroke_rect(hb.x,hb.y,hb.width,hb.height,draw.rgba(244,63,94,220),2.0) >>>
            }
        }
    }
    << 0
}
