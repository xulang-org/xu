@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors
#math

// A 24-hour segmented field. Editing changes the selected clock component,
// wraps within that component, and preserves the date and subsecond value.
pub struct TimePicker {
    locale Locale
    control Button
    val time.Time
    part int
    show_seconds bool
    twelve_hour bool
    custom_clock bool
    period_extent f64
    digits int
    typed int
    armed int
    hot int
    labels TextCache
}
pub fn time_picker(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value time.Time) TimePicker {
    validate_picker_time(value) or >>
    if !context.matches_canvas(identity) { >> errors.new("widgets: time picker context mismatch") }
    control := button(identity,id,bounds) or >>
    labels := text_cache(context)
    << TimePicker{locale: locale_default(),control: control,val: value,part: 0,show_seconds: true,twelve_hour: false,custom_clock: false,period_extent: 42.0,digits: 0,typed: 0,armed: 0,hot: -1,labels: labels}
}
pub fn (picker &TimePicker) id() int { << picker.control.id }
pub fn (picker &TimePicker) bounds() layout.Rect { << picker.control.bounds() }
pub fn (picker &TimePicker) value() time.Time { << picker.val }
pub fn (picker &TimePicker) selected_part() int { << picker.part }
pub fn (picker &TimePicker) needs_paint() bool { << picker.control.dirty }
pub fn (picker &TimePicker) visual_state() int { << picker.control.visual_state() }
pub fn (picker &TimePicker) style_or(styles &Styles) ControlStyle {
    if picker.control.has_style() { << picker.control.style_or(styles) }
    << styles.input.clone()
}
pub fn (picker $&TimePicker) set_style(style &ControlStyle) int {
    control := $&picker.control
    << control.set_style(style) or >>
}
pub fn (picker $&TimePicker) set_value(value time.Time) int {
    validate_picker_time(value) or >>
    picker.val = value
    picker.armed = 0
    picker.digits = 0
    picker.control.dirty = true
    << 0
}
pub fn (picker $&TimePicker) set_show_seconds(show bool) {
    picker.show_seconds = show
    if !show && picker.part == 2 { picker.part = 1 }
    picker.digits = 0
    picker.armed = 0
    picker.control.dirty = true
}
pub fn (picker $&TimePicker) set_enabled(enabled bool) {
    control := $&picker.control
    control.set_enabled(enabled)
    picker.armed = 0
}
pub fn (picker $&TimePicker) set_read_only(read_only bool) int {
    if picker.control.closed { >> errors.new("widgets: time picker is disposed") }
    control := $&picker.control
    control.set_read_only(read_only)
    picker.armed = 0
    << 0
}
pub fn (picker $&TimePicker) set_invalid(invalid bool) {
    control := $&picker.control
    control.set_invalid(invalid)
}
pub fn (picker $&TimePicker) set_focus(focused bool) {
    control := $&picker.control
    control.set_focus(focused)
    picker.digits = 0
    if !focused { picker.armed = 0 }
}
pub fn (picker $&TimePicker) set_bounds(bounds &layout.Rect) int {
    old := picker.bounds()
    control := $&picker.control
    control.set_bounds(bounds) or >>
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height { picker.armed = 0 }
    << 0
}
pub fn (picker &TimePicker) part_bounds(part int) layout.Rect {
    $count := 2
    if picker.show_seconds { count = 3 }
    if part < 0 || part >= count { >> errors.new("widgets: time segment out of range") }
    b := picker.bounds()
    w := math.max(0.0,b.width - math.min(32.0,b.width * 0.18) - picker.period_width()) / f64(count)
    $offset := 0.0
    if picker.twelve_hour && picker.locale.period_before() { offset = picker.period_width() }
    << layout.Rect{x: b.x + offset + f64(part) * w,y: b.y,width: w,height: b.height}
}
fn (picker &TimePicker) hit_part(x f64,y f64) int {
    if !picker.bounds().contains(x,y) { << -1 }
    $count := 2
    if picker.show_seconds { count = 3 }
    if picker.twelve_hour && picker.period_bounds().contains(x,y) { << 5 }
    for i in 0:count { part := picker.part_bounds(i) or >>
        if part.contains(x,y) { << i } }
    b := picker.bounds()
    if y < b.y + b.height * 0.5 { << 3 }
    << 4
}
fn (picker &TimePicker) component() int {
    if picker.part == 0 {
        if picker.twelve_hour { hour := picker.val.hour()%12
            if hour == 0 { << 12 }
            << hour }
        << picker.val.hour() }
    if picker.part == 1 { << picker.val.minute() }
    << picker.val.second()
}
fn (picker $&TimePicker) set_component(value int) bool {
    $h := picker.val.hour()
    $m := picker.val.minute()
    $s := picker.val.second()
    if picker.part == 0 {
        if picker.twelve_hour { h = ((value%12)+12)%12
            if picker.val.hour()>=12 { h=h+12 } }
        else { h = ((value % 24) + 24) % 24 } }
    else if picker.part == 1 { m = ((value % 60) + 60) % 60 }
    else { s = ((value % 60) + 60) % 60 }
    next := time.date(picker.val.year(),picker.val.month(),picker.val.day(),h,m,s,picker.val.nsec)
    changed := !next.equal(picker.val)
    picker.val = next
    picker.control.dirty = true
    << changed
}
pub fn (picker $&TimePicker) input(event &ui.InputEvent) Action {
    if !belongs(&picker.control.identity,event) || !picker.control.is_enabled() { << no_action(picker.id(),false) }
    if event.kind == ui.EV_POINTER_CANCEL { picker.set_focus(false)
        << no_action(picker.id(),true) }
    if picker.control.read_only { control := $&picker.control
        << control.input(event) }
    hit := picker.hit_part(event.x,event.y) or >>
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_LEAVE {
        $hot := hit
        if event.kind == ui.EV_POINTER_LEAVE { hot = -1 }
        if hot != picker.hot { picker.hot = hot
            picker.control.dirty = true }
    }
    $changed := false
    $consumed := false
    $focus := false
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && hit >= 0 {
        if hit < 3 { picker.part = hit }
        else { picker.armed = hit }
        picker.digits = 0
        picker.control.dirty = true
        focus = true
        consumed = true
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && picker.armed != 0 {
        if picker.armed == hit && hit == 5 { changed=picker.toggle_period() }
        else if picker.armed == hit {
            $step := -1
            if hit == 3 { step = 1 }
            changed = picker.set_component(picker.component() + step)
        }
        picker.armed = 0
        consumed = true
    } else if event.kind == ui.EV_KEY_DOWN && picker.control.focused {
        key := event.key
        $count := 2
        if picker.show_seconds { count = 3 }
        if count <= 0 { >> errors.new("widgets: invalid time segment count") }
        consumed = true
        if picker.twelve_hour && (key==65 || key==80 || key==97 || key==112) {
            want_pm := key==80 || key==112
            if (picker.val.hour()>=12)!=want_pm { changed=picker.toggle_period() }
        } else if key == ui.KEY_LEFT { picker.part = (picker.part + count - 1) % count
            picker.digits = 0 }
        else if key == ui.KEY_RIGHT || key == 58 { picker.part = (picker.part + 1) % count
            picker.digits = 0 }
        else if key == ui.KEY_UP { changed = picker.set_component(picker.component() + 1)
            picker.digits = 0 }
        else if key == ui.KEY_DOWN { changed = picker.set_component(picker.component() - 1)
            picker.digits = 0 }
        else if key == ui.KEY_HOME { $first := 0
            if picker.twelve_hour && picker.part==0 { first=1 }
            changed = picker.set_component(first)
            picker.digits = 0 }
        else if key == ui.KEY_END {
            $last := 59
            if picker.part == 0 { last = 23
                if picker.twelve_hour { last=12 } }
            changed = picker.set_component(last)
            picker.digits = 0
        } else if key >= 48 && key <= 57 {
            digit := key - 48
            $candidate := digit
            if picker.digits == 1 { candidate = picker.typed * 10 + digit }
            $limit := 59
            if picker.part == 0 { limit = 23
                if picker.twelve_hour { limit=12 } }
            if candidate > limit { candidate = digit
                picker.digits = 0 }
            changed = picker.set_component(candidate)
            picker.typed = candidate
            picker.digits = picker.digits + 1
            if picker.digits >= 2 { picker.part = (picker.part + 1) % count
                picker.digits = 0 }
        } else { consumed = false }
        if consumed { picker.control.dirty = true }
    }
    if !consumed { control := $&picker.control
        << control.input(event) }
    $kind := ACTION_NONE
    if changed { kind = ACTION_CHANGE }
    << Action{kind: kind,id: picker.id(),needs_paint: picker.needs_paint(),request_focus: focus,consumed: consumed,
        value: f64(picker.val.hour() * 3600 + picker.val.minute() * 60 + picker.val.second())}
}
pub fn (picker $&TimePicker) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid time picker route") }
    if kind == ROUTE_FOCUS { picker.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { picker.set_focus(false)
        control := $&picker.control
        control.cancel() }
    else { << picker.input(event) or >> }
    << no_action(picker.id(),picker.needs_paint())
}
pub fn (picker $&TimePicker) measure_styled(styles &Styles) layout.Size {
    picker.apply_styles(styles) or >>
    c := picker.style_or(styles)
    digits := picker.locale.number("00",false)
    labels := $&picker.labels
    size := labels.measure(0,&digits,styles,&c) or >>
    $count := 2.0
    if picker.show_seconds { count = 3.0 }
    << layout.Size{width: math.max(180.0 * styles.density,count * (size.width + 16.0 * styles.density) + 32.0 * styles.density + picker.period_extent),height: math.max(c.min_height * styles.density,size.height + (c.padding.top + c.padding.bottom) * styles.density)}
}
pub fn (picker $&TimePicker) paint_styled(frame $&draw.Frame,styles &Styles) int {
    picker.apply_styles(styles) or >>
    $c := picker.style_or(styles)
    b := picker.bounds()
    state := picker.visual_state()
    style_box(frame,&b,&c,styles.density,state) or >>
    c.padding = layout.insets(2.0) or >>
    c.align_x = 0.5
    c.align_y = 0.5
    $count := 2
    if picker.show_seconds { count = 3 }
    values := [picker.val.hour(),picker.val.minute(),picker.val.second()]
    for i in 0:count {
        $rect := picker.part_bounds(i) or >>
        rect.x = rect.x + 3.0 * styles.density
        rect.y = rect.y + 3.0 * styles.density
        rect.width = math.max(0.0,rect.width - 6.0 * styles.density)
        rect.height = math.max(0.0,rect.height - 6.0 * styles.density)
        if i == picker.part && picker.control.focused && !picker.control.read_only {
            rounded_fill(frame,&rect,math.min(4.0,rect.height * 0.25),c.palette.selection) or >>
        }
        $component := values[i]
        if i==0 && picker.twelve_hour { component=component%12
            if component==0 { component=12 } }
        text := picker.locale.number(picker_pad(component),false)
        $ink_style := c.clone()
        if i == picker.part && picker.control.focused && !picker.control.read_only {
            ink_style.palette.foreground = c.resolve(state).selection_text
            ink_style.states = []StatePaint{}
        }
        labels := $&picker.labels
        labels.paint_text(i,&text,frame,&rect,styles,&ink_style,state) or >>
    }
    for i in 1:count {
        rect := picker.part_bounds(i) or >>
        colon := layout.Rect{x: rect.x - 5.0,y: b.y,width: 10.0,height: b.height}
        separator := picker.locale.text(TEXT_TIME_SEPARATOR) or >>
        labels := $&picker.labels
        labels.paint_text(3,&separator,frame,&colon,styles,&c,state) or >>
    }
    last := picker.part_bounds(count - 1) or >>
    $x := last.x + last.width
    if picker.twelve_hour {
        period := picker.period_bounds()
        $text := picker.locale.text(TEXT_AM) or >>
        if picker.val.hour()>=12 { text=picker.locale.text(TEXT_PM) or >> }
        labels := $&picker.labels
        labels.paint_text(5,&text,frame,&period,styles,&c,state) or >>
        if !picker.locale.period_before() { x=x+period.width }
    }
    cy := b.y + b.height * 0.5
    cx := x + (b.x + b.width - x) * 0.5
    ink := c.resolve(state).foreground
    frame.line(x,b.y + 4.0,x,b.y + b.height - 4.0,c.palette.border,1.0) or >>
    for i in 0:2 {
        $y := cy - b.height * 0.22
        $sign := -1.0
        if i == 1 { y = cy + b.height * 0.22
            sign = 1.0 }
        if picker.hot == i + 3 && picker.control.is_enabled() && !picker.control.read_only {
            arrow := layout.Rect{x: x + 2.0,y: b.y + f64(i) * b.height * 0.5 + 2.0,width: math.max(0.0,b.x + b.width - x - 4.0),height: math.max(0.0,b.height * 0.5 - 4.0)}
            $state := STATE_HOVERED
            if picker.armed == i + 3 { state = STATE_PRESSED }
            rounded_fill(frame,&arrow,2.0,c.resolve(state).background) or >>
        }
        frame.line(cx - 3.0,y - sign * 1.5,cx,y + sign * 1.5,ink,1.5) or >>
        frame.line(cx,y + sign * 1.5,cx + 3.0,y - sign * 1.5,ink,1.5) or >>
    }
    picker.control.dirty = false
    << 0
}
pub fn (picker $&TimePicker) dispose() {
    labels := $&picker.labels
    labels.dispose()
    picker.control.closed = true
}

pub fn (picker $&TimePicker) set_12_hour(enabled bool) { picker.custom_clock=true
    picker.twelve_hour=enabled
    picker.digits=0
    picker.armed=0
    picker.control.dirty=true }
fn (picker &TimePicker) period_width() f64 {
    if !picker.twelve_hour { << 0.0 }
    << math.min(picker.period_extent,picker.bounds().width*0.4)
}
pub fn (picker &TimePicker) period_bounds() layout.Rect {
    if !picker.twelve_hour { << screen_empty() }
    b := picker.bounds()
    width := picker.period_width()
    $x := b.x+b.width-math.min(32.0,b.width*0.18)-width
    if picker.locale.period_before() { x = b.x }
    << layout.Rect{x:x,y:b.y,width:width,height:b.height}
}
fn (picker $&TimePicker) toggle_period() bool {
    hour := (picker.val.hour()+12)%24
    picker.val=time.date(picker.val.year(),picker.val.month(),picker.val.day(),hour,picker.val.minute(),picker.val.second(),picker.val.nsec)
    picker.control.dirty=true
    << true
}

pub fn (picker $&TimePicker) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := picker.style_or(styles)
    $extent := 0.0
    if picker.twelve_hour { for key in [TEXT_AM,TEXT_PM] {
        text := picker.locale.text(key) or >>
        cache := $&picker.labels
        size := cache.measure(6+key-TEXT_AM,&text,styles,&c) or >>
        extent = math.max(extent,size.width + 16.0 * styles.density)
    } }
    if extent != picker.period_extent { picker.period_extent = extent
        picker.armed = 0
        picker.control.dirty = true }
    << 0
}
