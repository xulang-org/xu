@ui/widgets

#errors

// Copy-enable switches and selected-text export for Screen text surfaces.
// Mirrors set_read_only routing for selectable labels, editors, and fields.

fn screen_set_selectable_copy_enabled(item $&SelectableText,on bool) string {
    item.set_copy_enabled(on)
    << ""
}

fn screen_set_editor_copy_enabled(item $&Editor,on bool) string {
    item.set_copy_enabled(on)
    << ""
}

fn screen_set_field_copy_enabled(item $&Field,on bool) string {
    item.set_copy_enabled(on)
    << ""
}

pub fn (s $&Screen) set_copy_enabled(id int,on bool) int {
    screen_node := s.node(id) >>>
    if s.is_selectable_label(id) {
        basic := $&s.basics
        store := $&basic.selectable_texts
        if !store.has(id) { >>> errors.new("widgets: selectable label missing") }
        $item := store.take(id)
        message := screen_set_selectable_copy_enabled($&item,on)
        store[id] = item
        if message.len > 0 { >>> errors.new(message) }
        s.invalidate()
        << 0
    }
    if screen_node.kind == SCREEN_EDITOR || screen_node.kind == SCREEN_SECRET_INPUT {
        owner := $&s.controls
        items := $&owner.editors
        if !items.has(id) { >>> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        message := screen_set_editor_copy_enabled($&item,on)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        s.invalidate()
        << 0
    }
    if screen_node.kind == SCREEN_FIELD {
        owner := $&s.controls
        items := $&owner.fields
        if !items.has(id) { >>> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        message := screen_set_field_copy_enabled($&item,on)
        items[id] = item
        if message.len > 0 { >>> errors.new(message) }
        s.invalidate()
        << 0
    }
    >>> errors.new("widgets: control does not support copy-enabled state")
}

pub fn (s &Screen) is_copy_enabled(id int) bool {
    if s.is_selectable_label(id) {
        << s.basics.selectable_texts[id].is_copy_enabled()
    }
    screen_node := s.node(id) >>> (err) { << false }
    if screen_node.kind == SCREEN_EDITOR || screen_node.kind == SCREEN_SECRET_INPUT {
        if !s.controls.editors.has(id) { << false }
        << s.controls.editors[id].is_copy_enabled()
    }
    if screen_node.kind == SCREEN_FIELD {
        if !s.controls.fields.has(id) { << false }
        << s.controls.fields[id].is_copy_enabled()
    }
    << false
}

pub fn (s &Screen) selected_text(id int) string {
    n := s.node(id) >>> (err) { << "" }
    if screen_is_text_kind(n.kind) {
        if s.basics.selectable_texts.has(id) {
            item := &s.basics.selectable_texts[id]
            << item.selected_text()
        }
        << ""
    }
    if n.kind == SCREEN_LIST && s.basics.lists.has(id) {
        item := &s.basics.lists[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_TABLE && s.controls.tables.has(id) {
        item := &s.controls.tables[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_TREE && s.controls.trees.has(id) {
        item := &s.controls.trees[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_COMBO && s.controls.combos.has(id) {
        item := &s.controls.combos[id]
        << item.selected_text()
    }
    if (n.kind == SCREEN_EDITOR || n.kind == SCREEN_SECRET_INPUT) && s.controls.editors.has(id) {
        item := &s.controls.editors[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_FIELD && s.controls.fields.has(id) {
        item := &s.controls.fields[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_POPOVER && s.overlays.popovers.has(id) {
        item := &s.overlays.popovers[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_TOOLTIP && s.overlays.tooltips.has(id) {
        item := &s.overlays.tooltips[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_TOAST && s.overlays.toasts.has(id) {
        item := &s.overlays.toasts[id]
        << item.selected_text()
    }
    if n.kind == SCREEN_MODAL {
        msg_slot := 0 - id
        if s.basics.selectable_texts.has(msg_slot) {
            msg_ref := &s.basics.selectable_texts[msg_slot]
            msg_sel := msg_ref.selected_text()
            if msg_sel.len > 0 { << msg_sel }
        }
        if s.basics.selectable_texts.has(id) {
            title_ref := &s.basics.selectable_texts[id]
            title_sel := title_ref.selected_text()
            if title_sel.len > 0 { << title_sel }
        }
        if s.overlays.modals.has(id) {
            item := &s.overlays.modals[id]
            << item.selected_text()
        }
    }
    << ""
}
