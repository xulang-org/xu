@ui/widgets

#ui/draw
#errors
#math
#time

// Timestamps use time.instant(); durations use time.milliseconds().
// Passing the clock explicitly keeps interrupted transitions deterministic.
pub struct Tween {
    current f64
    origin f64
    target f64
    started time.Instant
    duration time.Duration
}
pub fn tween(value f64) Tween {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid tween value") }
    << Tween{current: value,origin: value,target: value,started: time.zero_instant(),duration: time.duration(0)}
}
pub fn (t &Tween) value() f64 { << t.current }
pub fn (t &Tween) is_animating() bool { << t.current != t.target }
pub fn (t &mut Tween) advance(now time.Instant) bool {
    before := t.current
    elapsed := now.since(t.started).nanoseconds()
    if t.duration.is_zero() || elapsed >= t.duration.nanoseconds() { t.current = t.target }
    else if elapsed >= 0 {
        remaining := 1.0 - f64(elapsed) / f64(t.duration.nanoseconds())
        eased := 1.0 - remaining * remaining * remaining * remaining
        t.current = t.origin + (t.target - t.origin) * eased
    }
    << before != t.current
}
pub fn (t &mut Tween) retarget(value f64,now time.Instant,duration time.Duration,reduced_motion bool) int {
    if duration.is_negative() || duration.nanoseconds() > 10 * time.second() || math.is_nan(value) || math.is_inf(value) {
        >> errors.new("widgets: invalid motion target")
    }
    _ := t.advance(now) or >>
    if t.target != value {
        t.origin = t.current
        t.target = value
        t.started = now
        t.duration = duration
    }
    if reduced_motion || duration.is_zero() { t.current = value
        t.duration = time.duration(0) }
    << 0
}
fn mix_color(a draw.Color,b draw.Color,t f64) draw.Color {
    x := a.value()
    y := b.value()
    << draw.rgba(int(math.round(f64((x >> 24) & 255) + f64(((y >> 24) & 255) - ((x >> 24) & 255)) * t)),
        int(math.round(f64((x >> 16) & 255) + f64(((y >> 16) & 255) - ((x >> 16) & 255)) * t)),
        int(math.round(f64((x >> 8) & 255) + f64(((y >> 8) & 255) - ((x >> 8) & 255)) * t)),
        int(math.round(f64(x & 255) + f64((y & 255) - (x & 255)) * t)))
}
fn fade_color(color draw.Color,opacity f64) draw.Color {
    << color.with_alpha(int(math.round(f64(color.value() & 255) * opacity)))
}
pub fn (base &ControlStyle) with_opacity(opacity f64) ControlStyle {
    if math.is_nan(opacity) || math.is_inf(opacity) || opacity < 0.0 || opacity > 1.0 {
        >> errors.new("widgets: invalid control opacity")
    }
    mut result := base.clone()
    p := base.palette
    result.palette = Palette{normal: fade_color(p.normal,opacity),hovered: fade_color(p.hovered,opacity),
        pressed: fade_color(p.pressed,opacity),disabled: fade_color(p.disabled,opacity),foreground: fade_color(p.foreground,opacity),
        muted: fade_color(p.muted,opacity),accent: fade_color(p.accent,opacity),on_accent: fade_color(p.on_accent,opacity),
        focus: fade_color(p.focus,opacity),border: fade_color(p.border,opacity),invalid: fade_color(p.invalid,opacity),
        invalid_fill: fade_color(p.invalid_fill,opacity),read_only: fade_color(p.read_only,opacity),
        selection: fade_color(p.selection,opacity),selection_text: fade_color(p.selection_text,opacity),placeholder: fade_color(p.placeholder,opacity)}
    result.shadow = fade_color(base.shadow,opacity)
    result.icon_opacity = base.icon_opacity * opacity
    for i in 0:result.states.len {
        result.states[i].background = fade_color(result.states[i].background,opacity)
        result.states[i].foreground = fade_color(result.states[i].foreground,opacity)
        result.states[i].border = fade_color(result.states[i].border,opacity)
        result.states[i].focus = fade_color(result.states[i].focus,opacity)
        result.states[i].selection = fade_color(result.states[i].selection,opacity)
        result.states[i].selection_text = fade_color(result.states[i].selection_text,opacity)
        result.states[i].placeholder = fade_color(result.states[i].placeholder,opacity)
        result.states[i].icon_opacity = result.states[i].icon_opacity * opacity
    }
    << result
}
fn same_paint(a &ResolvedStyle,b &ResolvedStyle) bool {
    << a.background.value() == b.background.value() && a.foreground.value() == b.foreground.value() &&
        a.border.value() == b.border.value() && a.focus.value() == b.focus.value() &&
        a.selection.value() == b.selection.value() && a.selection_text.value() == b.selection_text.value() &&
        a.placeholder.value() == b.placeholder.value() && a.icon_opacity == b.icon_opacity
}
fn mix_paint(a &ResolvedStyle,b &ResolvedStyle,t f64) ResolvedStyle {
    << ResolvedStyle{background: mix_color(a.background,b.background,t),foreground: mix_color(a.foreground,b.foreground,t),
        border: mix_color(a.border,b.border,t),focus: mix_color(a.focus,b.focus,t),selection: mix_color(a.selection,b.selection,t),
        selection_text: mix_color(a.selection_text,b.selection_text,t),placeholder: mix_color(a.placeholder,b.placeholder,t),
        icon_opacity: a.icon_opacity + (b.icon_opacity - a.icon_opacity) * t}
}
pub struct PaintTransition {
    ready bool
    origin ResolvedStyle
    target ResolvedStyle
    progress Tween
}
pub fn paint_transition() PaintTransition {
    styles := dark_styles()
    c := styles.button.clone()
    paint := c.resolve(0)
    progress := tween(1.0) or >>
    << PaintTransition{ready: false,origin: paint,target: paint,progress: progress}
}
pub fn (motion &PaintTransition) is_animating() bool { << motion.progress.is_animating() }
pub fn (motion &mut PaintTransition) finish() {
    motion.progress.current = motion.progress.target
    motion.progress.duration = time.duration(0)
}
pub fn (motion &mut PaintTransition) advance(now time.Instant) bool {
    progress := mut &motion.progress
    << progress.advance(now) or >>
}
pub fn (motion &mut PaintTransition) style(base &ControlStyle,state int,now time.Instant,reduced_motion bool) ControlStyle {
    _ := motion.advance(now) or >>
    target := base.resolve(state)
    if !motion.ready || reduced_motion || (state & STATE_DISABLED) != 0 {
        motion.origin = target
        motion.target = target
        motion.progress = tween(1.0) or >>
        motion.ready = true
    } else if !same_paint(&target,&motion.target) {
        motion.origin = mix_paint(&motion.origin,&motion.target,motion.progress.value())
        motion.target = target
        motion.progress = tween(0.0) or >>
        mut duration := time.milliseconds(150) or >>
        if (state & STATE_PRESSED) != 0 { duration = time.milliseconds(75) or >> }
        progress := mut &motion.progress
        progress.retarget(1.0,now,duration,false) or >>
    }
    paint := mix_paint(&motion.origin,&motion.target,motion.progress.value())
    mut rule := state_paint(state)
    rule.unless = 127 - state
    // Composite controls derive label ink separately from their selected mark.
    // Preserve that palette behavior unless a matching rule explicitly owns it.
    rule.fields = PAINT_BACKGROUND | PAINT_BORDER | PAINT_FOCUS | PAINT_ICON_OPACITY
    for original in base.states {
        if (state & original.when) == original.when && (state & original.unless) == 0 {
            rule.fields = rule.fields | original.fields
        }
    }
    rule.background = paint.background
    rule.foreground = paint.foreground
    rule.border = paint.border
    rule.focus = paint.focus
    rule.selection = paint.selection
    rule.selection_text = paint.selection_text
    rule.placeholder = paint.placeholder
    rule.icon_opacity = paint.icon_opacity
    mut result := base.clone()
    result.states = [rule]
    << result
}
