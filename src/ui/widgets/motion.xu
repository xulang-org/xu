@ui/widgets

#ui/draw
#errors
#math
#time

pub const EASE_LINEAR = 0
pub const EASE_OUT_QUART = 1
pub const EASE_OUT_QUINT = 2
pub const EASE_IN_QUART = 3
pub const EASE_IN_OUT_CUBIC = 4
pub const EASE_IN_QUINT = 5

pub struct MotionSpec {
    pub hover time.Duration
    pub press time.Duration
    pub change time.Duration
    pub enter time.Duration
    pub exit time.Duration
    pub curve int
}
pub fn motion_spec() MotionSpec {
    << MotionSpec{hover: time.duration(130 * time.millisecond()),press: time.duration(75 * time.millisecond()),
        change: time.duration(160 * time.millisecond()),enter: time.duration(160 * time.millisecond()),
        exit: time.duration(110 * time.millisecond()),curve: EASE_OUT_QUART}
}
pub fn (spec &MotionSpec) validate() int {
    durations := [spec.hover,spec.press,spec.change,spec.enter,spec.exit]
    for duration in durations {
        if duration.is_negative() || duration.nanoseconds() > 10 * time.second() { >> errors.new("widgets: invalid motion duration") }
    }
    if spec.curve < EASE_LINEAR || spec.curve > EASE_IN_QUINT { >> errors.new("widgets: invalid easing curve") }
    << 0
}

// Timestamps use time.instant(); durations use time.milliseconds().
// Passing the clock explicitly keeps interrupted transitions deterministic.
pub struct Tween {
    current f64
    origin f64
    target f64
    started time.Instant
    duration time.Duration
    curve int
}
pub fn tween(value f64) Tween {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid tween value") }
    << Tween{current: value,origin: value,target: value,started: time.zero_instant(),duration: time.duration(0),curve: EASE_OUT_QUART}
}
pub fn (t $&Tween) set_curve(curve int) int {
    if curve < EASE_LINEAR || curve > EASE_IN_QUINT { >> errors.new("widgets: invalid easing curve " + str(curve)) }
    t.curve = curve
    << 0
}
pub fn (t &Tween) value() f64 { << t.current }
pub fn (t &Tween) is_animating() bool { << t.current != t.target }
pub fn (t $&Tween) snap(value f64) int {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid tween value") }
    t.current = value
    t.origin = value
    t.target = value
    t.started = time.zero_instant()
    t.duration = time.duration(0)
    << 0
}
pub fn (t $&Tween) advance(now time.Instant) bool {
    before := t.current
    elapsed := now.since(t.started).nanoseconds()
    if t.duration.is_zero() || elapsed >= t.duration.nanoseconds() { t.current = t.target }
    else if elapsed >= 0 {
        eased := motion_ease(t.curve,f64(elapsed) / f64(t.duration.nanoseconds()))
        t.current = t.origin + (t.target - t.origin) * eased
    }
    << before != t.current
}
pub fn (t $&Tween) retarget(value f64,now time.Instant,duration time.Duration,reduced_motion bool) int {
    if duration.is_negative() || duration.nanoseconds() > 10 * time.second() || math.is_nan(value) || math.is_inf(value) {
        >> errors.new("widgets: invalid motion target")
    }
    _ := t.advance(now) or >>
    if t.target != value {
        t.origin = t.current
        t.target = value
        t.started = now
        t.duration = duration
    }
    if reduced_motion || duration.is_zero() { t.current = value
        t.duration = time.duration(0) }
    << 0
}
pub fn mix_color(a draw.Color,b draw.Color,t f64) draw.Color {
    u := math.max(0.0,math.min(1.0,t))
    x := a.value()
    y := b.value()
    aa := f64(x & 255) / 255.0
    ba := f64(y & 255) / 255.0
    oa := aa + (ba - aa) * u
    if oa <= 0.0001 { << draw.rgba(0,0,0,0) }
    ar := f64((x >> 24) & 255) * aa
    ag := f64((x >> 16) & 255) * aa
    ab := f64((x >> 8) & 255) * aa
    br := f64((y >> 24) & 255) * ba
    bg := f64((y >> 16) & 255) * ba
    bb := f64((y >> 8) & 255) * ba
    rr := math.max(0.0,math.min(255.0,(ar + (br - ar) * u) / oa))
    rg := math.max(0.0,math.min(255.0,(ag + (bg - ag) * u) / oa))
    rb := math.max(0.0,math.min(255.0,(ab + (bb - ab) * u) / oa))
    << draw.rgba(int(math.round(rr)),int(math.round(rg)),int(math.round(rb)),int(math.round(math.max(0.0,math.min(255.0,oa * 255.0)))))
}
pub fn fade_color(color draw.Color,opacity f64) draw.Color {
    << color.with_alpha(int(math.round(f64(color.value() & 255) * opacity)))
}
pub fn (base &ControlStyle) with_opacity(opacity f64) ControlStyle {
    if math.is_nan(opacity) || math.is_inf(opacity) || opacity < 0.0 || opacity > 1.0 {
        >> errors.new("widgets: invalid control opacity")
    }
    $result := base.clone()
    p := base.palette
    result.palette = Palette{normal: fade_color(p.normal,opacity),hovered: fade_color(p.hovered,opacity),
        pressed: fade_color(p.pressed,opacity),disabled: fade_color(p.disabled,opacity),foreground: fade_color(p.foreground,opacity),
        muted: fade_color(p.muted,opacity),accent: fade_color(p.accent,opacity),on_accent: fade_color(p.on_accent,opacity),
        focus: fade_color(p.focus,opacity),border: fade_color(p.border,opacity),invalid: fade_color(p.invalid,opacity),
        invalid_fill: fade_color(p.invalid_fill,opacity),read_only: fade_color(p.read_only,opacity),
        selection: fade_color(p.selection,opacity),selection_text: fade_color(p.selection_text,opacity),placeholder: fade_color(p.placeholder,opacity)}
    result.shadow = fade_color(base.shadow,opacity)
    result.icon_opacity = base.icon_opacity * opacity
    for i in 0:result.states.len {
        result.states[i].background = fade_color(result.states[i].background,opacity)
        result.states[i].foreground = fade_color(result.states[i].foreground,opacity)
        result.states[i].border = fade_color(result.states[i].border,opacity)
        result.states[i].focus = fade_color(result.states[i].focus,opacity)
        result.states[i].selection = fade_color(result.states[i].selection,opacity)
        result.states[i].selection_text = fade_color(result.states[i].selection_text,opacity)
        result.states[i].placeholder = fade_color(result.states[i].placeholder,opacity)
        result.states[i].icon_opacity = result.states[i].icon_opacity * opacity
        result.states[i].shadow = fade_color(result.states[i].shadow,opacity)
    }
    << result
}
fn same_paint(a &ResolvedStyle,b &ResolvedStyle) bool {
    << a.background.value() == b.background.value() && a.foreground.value() == b.foreground.value() &&
        a.border.value() == b.border.value() && a.focus.value() == b.focus.value() &&
        a.selection.value() == b.selection.value() && a.selection_text.value() == b.selection_text.value() &&
        a.placeholder.value() == b.placeholder.value() && a.icon_opacity == b.icon_opacity &&
        a.border_width == b.border_width && a.shadow.value() == b.shadow.value() && a.shadow_blur == b.shadow_blur
}
fn mix_paint(a &ResolvedStyle,b &ResolvedStyle,t f64) ResolvedStyle {
    << ResolvedStyle{background: mix_color(a.background,b.background,t),foreground: mix_color(a.foreground,b.foreground,t),
        border: mix_color(a.border,b.border,t),focus: mix_color(a.focus,b.focus,t),selection: mix_color(a.selection,b.selection,t),
        selection_text: mix_color(a.selection_text,b.selection_text,t),placeholder: mix_color(a.placeholder,b.placeholder,t),
        icon_opacity: a.icon_opacity + (b.icon_opacity - a.icon_opacity) * t,
        border_width: a.border_width + (b.border_width - a.border_width) * t,
        shadow: mix_color(a.shadow,b.shadow,t),
        shadow_blur: a.shadow_blur + (b.shadow_blur - a.shadow_blur) * t}
}
pub struct PaintTransition {
    ready int
    endpoints []ResolvedStyle
    progress Tween
    spec MotionSpec
}
pub fn paint_transition() PaintTransition {
    progress := tween(1.0) or >>
    << PaintTransition{ready: 0,endpoints: []ResolvedStyle{},progress: progress,spec: motion_spec()}
}
pub fn (motion $&PaintTransition) set_spec(spec &MotionSpec) int {
    spec.validate() or >>
    motion.spec = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    progress := $&motion.progress
    progress.set_curve(spec.curve) or >>
    << 0
}
pub fn (motion &PaintTransition) next_tick(now time.Instant) time.Instant {
    << overlay_next_tick(motion.is_animating(),now) or >>
}
pub fn (motion &PaintTransition) is_animating() bool { << motion.progress.is_animating() }
pub fn (motion $&PaintTransition) finish() {
    motion.progress.current = motion.progress.target
    motion.progress.duration = time.duration(0)
}
pub fn (motion $&PaintTransition) advance(now time.Instant) bool {
    progress := $&motion.progress
    << progress.advance(now) or >>
}
// Crossing from light ink/dark surface to dark ink/light surface would make
// text unreadable mid-transition. Snap that polarity change; retain motion for
// same-polarity hover, focus and pressed feedback.
fn paint_polarity(paint &ResolvedStyle) f64 {
    bg := paint.background.value()
    fg := paint.foreground.value()
    if (bg & 255) != 255 || (fg & 255) != 255 { << 0.0 }
    b := f64((bg >> 24) & 255) * 0.2126 + f64((bg >> 16) & 255) * 0.7152 + f64((bg >> 8) & 255) * 0.0722
    f := f64((fg >> 24) & 255) * 0.2126 + f64((fg >> 16) & 255) * 0.7152 + f64((fg >> 8) & 255) * 0.0722
    << f - b
}
pub fn (motion $&PaintTransition) style(base &ControlStyle,state int,now time.Instant,reduced_motion bool) ControlStyle {
    _ := motion.advance(now) or >>
    target := base.resolve(state)
    if motion.endpoints.len < 2 {
        motion.endpoints = [target,target]
        motion.ready = 0
    }
    if motion.ready == 0 || reduced_motion || (state & STATE_DISABLED) != 0 || paint_polarity(&target) * paint_polarity(&motion.endpoints[1]) < 0.0 {
        motion.endpoints[0] = target
        motion.endpoints[1] = target
        progress := $&motion.progress
        progress.snap(1.0) or >>
        motion.ready = 1 | (state << 1)
    } else if !same_paint(&target,&motion.endpoints[1]) {
        motion.endpoints[0] = mix_paint(&motion.endpoints[0],&motion.endpoints[1],motion.progress.value())
        motion.endpoints[1] = target
        $duration := motion.spec.hover
        if (state & STATE_PRESSED) != 0 { duration = motion.spec.press }
        else if (motion.ready & (STATE_PRESSED << 1)) != 0 { duration = motion.spec.change }
        curve := motion.spec.curve
        progress := $&motion.progress
        progress.snap(0.0) or >>
        progress.set_curve(curve) or (err) { >> errors.new("widgets: paint transition: " + err.msg()) }
        progress.retarget(1.0,now,duration,false) or >>
    }
    motion.ready = 1 | (state << 1)
    paint := mix_paint(&motion.endpoints[0],&motion.endpoints[1],motion.progress.value())
    $rule := state_paint(state)
    rule.unless = 127 - state
    // Composite controls derive label ink separately from their selected mark.
    // Preserve that palette behavior unless a matching rule explicitly owns it.
    rule.fields = PAINT_BACKGROUND | PAINT_BORDER | PAINT_FOCUS | PAINT_ICON_OPACITY | PAINT_BORDER_WIDTH | PAINT_SHADOW
    for original in base.states {
        if (state & original.when) == original.when && (state & original.unless) == 0 {
            rule.fields = rule.fields | original.fields
        }
    }
    rule.background = paint.background
    rule.foreground = paint.foreground
    rule.border = paint.border
    rule.focus = paint.focus
    rule.selection = paint.selection
    rule.selection_text = paint.selection_text
    rule.placeholder = paint.placeholder
    rule.icon_opacity = paint.icon_opacity
    rule.border_width = paint.border_width
    rule.shadow = paint.shadow
    rule.shadow_blur = paint.shadow_blur
    $result := base.clone()
    result.states = [rule]
    << result
}

// Short reversals travel a shorter distance; keep their duration proportional.
// Advance with the old curve before replacing it to keep the handoff continuous.
pub fn (t $&Tween) retarget_unit(value f64,now time.Instant,duration time.Duration,reduced bool) int {
    if math.is_nan(value) || math.is_inf(value) || value < 0.0 || value > 1.0 || duration.is_negative() || duration.nanoseconds() > 10 * time.second() { >> errors.new("widgets: invalid unit motion target or duration") }
    _ := t.advance(now) or >>
    distance := math.min(1.0,math.abs(value - t.current))
    scaled := time.duration(int(f64(duration.nanoseconds()) * distance))
    << t.retarget(value,now,scaled,reduced) or >>
}
fn (spec &MotionSpec) exit_easing() int {
    if spec.curve == EASE_OUT_QUART { << EASE_IN_QUART }
    if spec.curve == EASE_OUT_QUINT { << EASE_IN_QUINT }
    << spec.curve
}

pub struct SpringSpec {
    pub stiffness f64
    pub damping f64
    pub mass f64
    pub precision f64
}
pub fn spring_spec() SpringSpec {
    << SpringSpec{stiffness: 260.0,damping: 24.0,mass: 1.0,precision: 0.001}
}
pub fn (spec &SpringSpec) validate() int {
    if math.is_nan(spec.stiffness) || math.is_inf(spec.stiffness) || spec.stiffness <= 0.0 || spec.stiffness > 50000.0 ||
       math.is_nan(spec.damping) || math.is_inf(spec.damping) || spec.damping < 0.0 || spec.damping > 5000.0 ||
       math.is_nan(spec.mass) || math.is_inf(spec.mass) || spec.mass <= 0.0 || spec.mass > 100.0 ||
       math.is_nan(spec.precision) || math.is_inf(spec.precision) || spec.precision <= 0.0 || spec.precision > 1.0 {
        >> errors.new("widgets: invalid spring spec")
    }
    << 0
}
pub struct Spring {
    current f64
    target f64
    velocity f64
    spec SpringSpec
    stamp time.Instant
    active bool
}
pub fn spring(value f64) Spring {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid spring value") }
    << Spring{current: value,target: value,velocity: 0.0,spec: spring_spec(),stamp: time.zero_instant(),active: false}
}
pub fn (s &Spring) value() f64 { << s.current }
pub fn (s &Spring) velocity() f64 { << s.velocity }
pub fn (s &Spring) is_animating() bool { << s.active }
pub fn (s $&Spring) set_spec(spec &SpringSpec) int {
    spec.validate() or >>
    s.spec = SpringSpec{stiffness: spec.stiffness,damping: spec.damping,mass: spec.mass,precision: spec.precision}
    << 0
}
pub fn (s $&Spring) set_velocity(v f64) int {
    if math.is_nan(v) || math.is_inf(v) { >> errors.new("widgets: invalid spring velocity") }
    s.velocity = v
    if math.abs(v) > s.spec.precision { s.active = true }
    << 0
}
pub fn (s $&Spring) snap(value f64) int {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid spring value") }
    s.current = value
    s.target = value
    s.velocity = 0.0
    s.stamp = time.zero_instant()
    s.active = false
    << 0
}
pub fn (s $&Spring) retarget(target f64,now time.Instant,reduced_motion bool) int {
    if math.is_nan(target) || math.is_inf(target) { >> errors.new("widgets: invalid spring target") }
    _ := s.advance(now,reduced_motion) or >>
    if reduced_motion {
        s.current = target
        s.target = target
        s.velocity = 0.0
        s.stamp = now
        s.active = false
        << 0
    }
    s.target = target
    s.stamp = now
    s.active = math.abs(s.target - s.current) > s.spec.precision || math.abs(s.velocity) > s.spec.precision
    if !s.active {
        s.current = s.target
        s.velocity = 0.0
    }
    << 0
}
pub fn (s $&Spring) advance(now time.Instant,reduced_motion bool) bool {
    if !s.active { << false }
    before := s.current
    if reduced_motion {
        s.current = s.target
        s.velocity = 0.0
        s.stamp = now
        s.active = false
        << before != s.current
    }
    if s.stamp.is_zero() {
        s.stamp = now
        << false
    }
    elapsed_ns := now.since(s.stamp).nanoseconds()
    if elapsed_ns <= 0 { << false }
    s.stamp = now
    $dt := math.min(0.25,f64(elapsed_ns) / f64(time.second()))
    max_step := 0.004
    steps := int(math.max(1.0,math.ceil(dt / max_step)))
    h := dt / f64(steps)
    for _i in 0:steps {
        accel := (s.spec.stiffness * (s.target - s.current) - s.spec.damping * s.velocity) / s.spec.mass
        s.velocity = s.velocity + accel * h
        s.current = s.current + s.velocity * h
    }
    if math.abs(s.target - s.current) <= s.spec.precision && math.abs(s.velocity) <= s.spec.precision {
        s.current = s.target
        s.velocity = 0.0
        s.active = false
    }
    << before != s.current
}
pub fn (s &Spring) next_tick(now time.Instant) time.Instant {
    << overlay_next_tick(s.active,now) or >>
}
fn motion_spring_spec(change time.Duration) SpringSpec {
    ns := change.nanoseconds()
    if ns <= 0 { << spring_spec() }
    dur_ms := f64(ns) / 1000000.0
    ratio := math.max(0.25,math.min(4.0,200.0 / dur_ms))
    << SpringSpec{stiffness: 260.0 * ratio * ratio,damping: 24.0 * ratio,mass: 1.0,precision: 0.001}
}
