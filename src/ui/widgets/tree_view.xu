@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

// Up to 512 nodes, depth <= 32. add(-1, label) appends a root; other parents
// must be an earlier node index. Indices stay stable until clear(). Children
// are shown in insertion order, even when they are appended after siblings.
pub struct TreeView {
    rows ListBox
    parents []int
    depths []int
    expanded []bool
    values []string
    visible []int
    labels TextCache
    indent f64
    armed_node int
}
pub fn tree_view(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect) TreeView {
    if !context.matches_canvas(identity) { >> errors.new("widgets: tree context mismatch") }
    rows := list_box(identity,id,bounds,0,-1) or >>
    << TreeView{rows: rows,parents: []int{},depths: []int{},expanded: []bool{},values: []string{},visible: []int{},
        labels: text_cache(context),indent: 20.0,armed_node: -1}
}
pub fn (t &TreeView) id() int { << t.rows.id }
pub fn (t &TreeView) bounds() layout.Rect { << t.rows.bounds() }
pub fn (t &TreeView) count() int { << t.values.len }
pub fn (t &TreeView) visible_count() int { << t.visible.len }
pub fn (t &TreeView) selected() int {
    index := t.rows.selected_val
    if index < 0 || index >= t.visible.len { << -1 }
    << t.visible[index]
}
pub fn (t &TreeView) is_expanded(node int) bool {
    if node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    << t.expanded[node]
}
pub fn (t &TreeView) parent(node int) int {
    if node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    << t.parents[node]
}
pub fn (t &TreeView) text(node int) string {
    if node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    << t.values[node] + ""
}
pub fn (t &TreeView) visible_node(index int) int {
    if index < 0 || index >= t.visible.len { >> errors.new("widgets: invalid visible tree row") }
    << t.visible[index]
}
pub fn (t &TreeView) needs_paint() bool { << t.rows.dirty }
pub fn (t &mut TreeView) painted() { t.rows.dirty = false }
pub fn (t &TreeView) is_enabled() bool { << t.rows.is_enabled() }
pub fn (t &TreeView) is_focused() bool { << t.rows.focused }
pub fn (t &TreeView) is_read_only() bool { << t.rows.read_only }
pub fn (t &TreeView) scroll_offset() f64 { << t.rows.scroll_y }
pub fn (t &mut TreeView) cancel() { t.armed_node = -1
    rows := mut &t.rows
    rows.cancel() }
pub fn (t &mut TreeView) set_focus(focused bool) { rows := mut &t.rows
    rows.set_focus(focused) }
pub fn (t &mut TreeView) set_enabled(enabled bool) { rows := mut &t.rows
    rows.set_enabled(enabled)
    if !enabled { t.armed_node = -1 } }
pub fn (t &mut TreeView) set_read_only(value bool) int {
    if t.rows.closed { >> errors.new("widgets: tree is disposed") }
    rows := mut &t.rows
    rows.set_read_only(value)
    t.armed_node = -1
    << 0
}
fn (t &TreeView) has_children(node int) bool {
    for parent in t.parents { if parent == node { << true } }
    << false
}
// Iterative pre-order traversal avoids recursive stack use. The bounded scan
// intentionally favors predictable ownership over pretending to be virtual.
fn (t &mut TreeView) rebuild(selected int) int {
    mut visible := []int{}
    mut stack := []int{}
    for i in 0:t.count() { index := t.count() - 1 - i
        if t.parents[index] == -1 { stack.push(index) } }
    while stack.len > 0 {
        node := stack[stack.len - 1]
        stack = stack[0:stack.len - 1]
        visible.push(node)
        if t.expanded[node] {
            for i in 0:t.count() { index := t.count() - 1 - i
                if t.parents[index] == node { stack.push(index) } }
        }
    }
    t.visible = visible
    mut selected_node := selected
    mut row := -1
    while selected_node >= 0 && row < 0 {
        for i in 0:t.visible.len { if t.visible[i] == selected_node { row = i } }
        if row < 0 { selected_node = t.parents[selected_node] }
    }
    count := t.visible.len
    rows := mut &t.rows
    rows.set_count(count) or >>
    rows.set_selected(row) or >>
    rows.armed_idx = -1
    rows.hovered_idx = -1
    rows.dirty = true
    t.armed_node = -1
    << 0
}
pub fn (t &mut TreeView) add(parent int,text &string) int {
    if t.rows.closed || parent < -1 || parent >= t.count() || t.count() >= 512 { >> errors.new("widgets: invalid tree parent or 512 node limit") }
    validate_table_text(text) or >>
    mut depth := 0
    if parent >= 0 { depth = t.depths[parent] + 1 }
    if depth > 32 { >> errors.new("widgets: tree depth exceeds 32") }
    selected := t.selected()
    index := t.count()
    t.parents.push(parent)
    t.depths.push(depth)
    t.expanded.push(false)
    t.values.push(text + "")
    t.rebuild(selected) or >>
    << index
}
pub fn (t &mut TreeView) set_text(node int,text &string) int {
    if t.rows.closed || node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    validate_table_text(text) or >>
    if t.values[node] != text + "" { t.values[node] = text + ""
        t.rows.dirty = true }
    << 0
}
pub fn (t &mut TreeView) set_expanded(node int,expanded bool) int {
    if t.rows.closed || node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    selected := t.selected()
    if t.expanded[node] != expanded {
        t.expanded[node] = expanded
        t.rebuild(selected) or >>
    }
    << 0
}
pub fn (t &mut TreeView) set_selected(node int) int {
    if t.rows.closed || node < -1 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    if node >= 0 {
        mut ancestor := t.parents[node]
        while ancestor >= 0 { t.expanded[ancestor] = true
            ancestor = t.parents[ancestor] }
    }
    << t.rebuild(node) or >>
}
pub fn (t &mut TreeView) clear() int {
    if t.rows.closed { >> errors.new("widgets: tree is disposed") }
    t.parents = []int{}
    t.depths = []int{}
    t.expanded = []bool{}
    t.values = []string{}
    << t.rebuild(-1) or >>
}
pub fn (t &mut TreeView) set_bounds(bounds &layout.Rect) int {
    if t.rows.closed { >> errors.new("widgets: tree is disposed") }
    old := t.bounds()
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height { t.armed_node = -1 }
    rows := mut &t.rows
    << rows.set_bounds(bounds) or >> }
pub fn (t &mut TreeView) set_scroll_offset(offset f64) int {
    if t.rows.closed { >> errors.new("widgets: tree is disposed") }
    rows := mut &t.rows
    << rows.set_scroll_offset(offset) or >> }
pub fn (t &TreeView) style_or(styles &Styles) ControlStyle { << t.rows.style_or(styles) }
pub fn (t &mut TreeView) set_style(style &ControlStyle) int {
    if t.rows.closed { >> errors.new("widgets: tree is disposed") }
    rows := mut &t.rows
    << rows.set_style(style) or >> }
pub fn (t &mut TreeView) clear_style() { rows := mut &t.rows
    rows.clear_style() }
pub fn (t &mut TreeView) apply_styles(styles &Styles) int {
    if t.rows.closed { >> errors.new("widgets: tree is disposed") }
    styles.validate() or >>
    c := t.style_or(styles)
    cache := mut &t.labels
    sample := cache.measure(1023,&"Ag国",styles,&c) or >>
    height := math.max(c.indicator_size * styles.density,sample.height + (c.padding.top + c.padding.bottom) * styles.density)
    d := styles.density
    padding := layout.Insets{left: c.padding.left * d,top: c.padding.top * d,right: c.padding.right * d,bottom: c.padding.bottom * d}
    changed := t.rows.row_h != height || t.rows.padding.left != padding.left || t.rows.padding.top != padding.top ||
        t.rows.padding.right != padding.right || t.rows.padding.bottom != padding.bottom
    rows := mut &t.rows
    rows.padding = padding
    if changed { rows.row_h = height
        rows.armed_idx = -1
        rows.hovered_idx = -1
        rows.dirty = true }
    rows.scroll_y = math.max(0.0,math.min(rows.max_scroll(),rows.scroll_y))
    t.indent = math.max(16.0 * styles.density,sample.height)
    << 0
}
pub fn (t &TreeView) row_bounds(index int) layout.Rect {
    b := t.bounds()
    if index < 0 || index >= t.visible.len { << layout.Rect{x: b.x,y: b.y,width: 0.0,height: 0.0} }
    << layout.Rect{x: b.x + t.rows.padding.left,y: b.y + t.rows.padding.top + f64(index) * t.rows.row_h - t.rows.scroll_y,
        width: math.max(0.0,b.width - t.rows.padding.left - t.rows.padding.right),height: t.rows.row_h}
}
fn (t &TreeView) hit_expander(input &ui.InputEvent) int {
    row := t.rows.hit_row(input.x,input.y)
    if row < 0 { << -1 }
    node := t.visible[row]
    if !t.has_children(node) { << -1 }
    r := t.row_bounds(row)
    x := r.x + f64(t.depths[node]) * t.indent
    if input.x >= x && input.x < x + t.indent { << node }
    << -1
}
pub fn (t &mut TreeView) input(input &ui.InputEvent) Action {
    if t.rows.closed || !belongs(&t.rows.identity,input) { << no_action(t.id(),t.needs_paint()) }
    if input.kind == ui.EV_POINTER_CANCEL { t.cancel()
        << no_action(t.id(),t.needs_paint()) }
    if !t.is_enabled() { << no_action(t.id(),t.needs_paint()) }
    if !t.rows.read_only {
        expander := t.hit_expander(input)
        if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && expander >= 0 {
            t.armed_node = expander
            t.rows.armed_idx = -1
            t.rows.dirty = true
            << Action{kind: ACTION_NONE,id: t.id(),needs_paint: true,request_focus: true,consumed: true,value: f64(expander)}
        }
        if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT { t.armed_node = -1 }
        if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && t.armed_node >= 0 {
            armed := t.armed_node
            t.armed_node = -1
            mut kind := ACTION_NONE
            if expander == armed { expanded := t.expanded[armed]
                t.set_expanded(armed,!expanded) or >>
                kind = ACTION_ACTIVATE }
            << Action{kind: kind,id: t.id(),needs_paint: true,request_focus: false,consumed: true,value: f64(armed)}
        }
        if input.kind == ui.EV_KEY_DOWN && t.rows.focused {
            selected := t.selected()
            if selected >= 0 {
                mut handled := false
                mut kind := ACTION_NONE
                if input.key == ui.KEY_LEFT {
                    handled = true
                    if t.expanded[selected] && t.has_children(selected) { t.set_expanded(selected,false) or >>
                        kind = ACTION_ACTIVATE }
                    else if t.parents[selected] >= 0 { parent := t.parents[selected]
                        t.set_selected(parent) or >>
                        kind = ACTION_CHANGE }
                } else if input.key == ui.KEY_RIGHT {
                    handled = true
                    if t.has_children(selected) {
                        if !t.expanded[selected] { t.set_expanded(selected,true) or >>
                            kind = ACTION_ACTIVATE }
                        else { for i in 0:t.count() { if t.parents[i] == selected { t.set_selected(i) or >>
                            kind = ACTION_CHANGE
                            <- } } }
                    }
                } else if input.key == 32 || input.key == ui.KEY_ENTER {
                    handled = true
                    if t.has_children(selected) { expanded := t.expanded[selected]
                        t.set_expanded(selected,!expanded) or >>
                        kind = ACTION_ACTIVATE }
                }
                if handled { mut value := t.selected()
                    if kind == ACTION_ACTIVATE { value = selected }
                    << Action{kind: kind,id: t.id(),needs_paint: t.needs_paint(),request_focus: false,consumed: true,value: f64(value)} }
            }
        }
    }
    rows := mut &t.rows
    mut action := rows.input(input) or >>
    if action.kind == ACTION_CHANGE { action.value = f64(t.selected()) }
    << action
}
pub fn (t &mut TreeView) route(kind int,input &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid route kind") }
    if kind == ROUTE_FOCUS { t.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { t.cancel() }
    else { << t.input(input) or >> }
    << no_action(t.id(),t.needs_paint())
}
pub fn (t &mut TreeView) event(event &ui.Event) Action {
    if event.window_id != t.rows.identity.window_id { << no_action(t.id(),t.needs_paint()) }
    if event.kind == ui.EV_CLOSED { t.dispose()
        << no_action(t.id(),false) }
    if event.kind == ui.EV_BLURRED { t.cancel()
        << no_action(t.id(),t.needs_paint()) }
    if event.kind == ui.EV_CANVAS_CLOSED { identity := ui.canvas_of(event) or >>
        if identity.canvas_id == t.rows.identity.canvas_id && identity.generation == t.rows.identity.generation { t.dispose() }
        << no_action(t.id(),t.needs_paint()) }
    if !ui.is_input_event(event.kind) { << no_action(t.id(),t.needs_paint()) }
    input := ui.input_of(event) or >>
    << t.input(&input) or >>
}
pub fn (t &mut TreeView) measure_styled(styles &Styles) layout.Size {
    t.apply_styles(styles) or >>
    c := t.style_or(styles)
    mut width := 120.0 * styles.density
    for i in 0:t.visible.len { node := t.visible[i]
        text := t.values[node] + ""
        cache := mut &t.labels
        size := cache.measure(1022,&text,styles,&c) or >>
        width = math.max(width,size.width + (f64(t.depths[node]) + 1.0) * t.indent + (c.padding.left + c.padding.right) * styles.density) }
    << layout.Size{width: width,height: t.rows.row_h * f64(min_int(5,max_int(1,t.visible.len))) + (c.padding.top + c.padding.bottom) * styles.density}
}
pub fn (t &mut TreeView) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    t.apply_styles(styles) or >>
    c := t.style_or(styles)
    d := styles.density
    mut marker_style := c.clone()
    marker_style.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    marker_style.align_x = 0.5
    marker_style.align_y = 0.5
    t.rows.paint_box_styled(frame,styles) or >>
    b := t.bounds()
    viewport := layout.Rect{x: b.x + t.rows.padding.left,y: b.y + t.rows.padding.top,
        width: math.max(0.0,b.width - t.rows.padding.left - t.rows.padding.right),height: math.max(0.0,b.height - t.rows.padding.top - t.rows.padding.bottom)}
    first := max_int(0,int(t.rows.scroll_y / t.rows.row_h))
    last := min_int(t.visible.len,first + int(viewport.height / t.rows.row_h) + 2)
    frame.push() or >>
    frame.clip_rect(viewport.x,viewport.y,viewport.width,viewport.height) or >>
    for row in first:last {
        node := t.visible[row]
        mut r := t.row_bounds(row)
        if f64(t.visible.len) * t.rows.row_h > viewport.height { r.width = math.max(0.0,r.width - 10.0 * d) }
        state := t.rows.item_visual_state(row)
        if row == t.rows.selected_val || row == t.rows.hovered_idx { rounded_fill(frame,&r,math.max(0.0,c.radius - 2.0) * d,c.resolve(state).background) or >> }
        indent := f64(t.depths[node]) * t.indent
        marker := layout.Rect{x: r.x + indent,y: r.y,width: t.indent,height: r.height}
        if t.has_children(node) {
            mut symbol := "›"
            if t.expanded[node] { symbol = "⌄" }
            cache := mut &t.labels
            cache.paint_text(512 + row - first,&symbol,frame,&marker,styles,&marker_style,state) or >>
        }
        text := t.values[node] + ""
        text_rect := layout.Rect{x: r.x + indent + t.indent,y: r.y,width: math.max(0.0,r.width - indent - t.indent),height: r.height}
        cache := mut &t.labels
        cache.paint_text(row - first,&text,frame,&text_rect,styles,&c,state) or >>
    }
    frame.pop() or >>
    << 0
}
pub fn (t &mut TreeView) dispose() {
    cache := mut &t.labels
    cache.dispose()
    t.cancel()
    t.rows.closed = true
}
