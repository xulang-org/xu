@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

pub const ACTION_CONTEXT_MENU = 17

pub fn (s $&Screen) open_context_menu(x f64,y f64,items &[]MenuItem) int {
    s.check_screen() >>>
    if items.len == 0 { >> errors.new("widgets: context menu requires at least one item") }
    if math.is_nan(x) || math.is_inf(x) || math.is_nan(y) || math.is_inf(y) {
        >> errors.new("widgets: invalid context menu coordinates")
    }
    s.close_context_menu() >>>

    anchor := s.group() >>>
    s.place(anchor,x,y,0.0,0.0) >>> (err) {
        _ := s.remove(anchor) >>> (e2) { << 0 }
        >> err
    }
    s.set_hit_test_enabled(anchor,false) >>>

    root := s.column(2.0) >>> (err) {
        _ := s.remove(anchor) >>> (e2) { << 0 }
        >> err
    }
    pad := layout.Insets{left: 4.0,top: 4.0,right: 4.0,bottom: 4.0}
    s.set_container_padding(root,&pad) >>>
    $sp := control_style_patch()
    sp.fields = STYLE_PATCH_NORMAL | STYLE_PATCH_BORDER | STYLE_PATCH_BORDER_WIDTH | STYLE_PATCH_RADIUS
    sp.normal = draw.rgb(252,253,255)
    sp.border = draw.rgb(203,213,225)
    sp.border_width = 1.0
    sp.radius = 8.0
    s.set_control_style_patch(root,&sp) >>>
    s.set_z_index(root,10000) >>>
    fz := roving_focus_zone(FOCUS_NAV_VERTICAL)
    s.set_focus_zone(root,&fz) >>>

    $item_ids := []int{}
    $item_keys := map[int]int{}
    $first_focus_id := 0
    for i in 0:items.len {
        it := &items[i]
        if it.kind == MENU_SEPARATOR {
            dv := s.divider(AXIS_HORIZONTAL) >>>
            s.set_item_size(dv,180.0,1.0) >>>
            s.add_child(root,dv) >>>
            item_ids.push(dv)
            ->
        }
        $lbl := it.label + ""
        if it.checked { lbl = "* " + lbl }
        if it.shortcut_label.len > 0 { lbl = lbl + "  " + it.shortcut_label }
        btn := s.button(lbl) >>>
        s.set_item_size(btn,180.0,30.0) >>>
        if !it.enabled { s.set_enabled(btn,false) >>> }
        else if first_focus_id == 0 { first_focus_id = btn }
        s.add_child(root,btn) >>>
        item_ids.push(btn)
        item_keys[btn] = it.key
    }

    $fspec := floating_spec(anchor,ANCHOR_BOTTOM)
    fspec.align = ANCHOR_START
    fspec.offset = 2.0
    fspec.margin = 8.0
    fspec.auto_flip = true
    fspec.auto_shift = true
    fspec.dismiss_on_outside = true
    s.anchor_floating(root,&fspec) >>>

    comp := $&s.composition
    comp.context_menu_root = root
    comp.context_menu_anchor = anchor
    comp.context_menu_item_keys = item_keys
    comp.context_menu_item_ids = item_ids

    s.mark_layout_dirty()
    if first_focus_id > 0 {
        s.layout_controls() >>>
        _ := s.focus(first_focus_id) >>> (err) { << 0 }
    }
    << root
}

pub fn (s $&Screen) close_context_menu() int {
    s.check_screen() >>>
    root := s.composition.context_menu_root
    anchor := s.composition.context_menu_anchor
    comp := $&s.composition
    comp.context_menu_root = 0
    comp.context_menu_anchor = 0
    comp.context_menu_item_keys = map[int]int{}
    comp.context_menu_item_ids = []int{}
    if root > 0 && root <= s.nodes.len && s.nodes[root - 1].kind >= 0 {
        s.remove(root) >>>
    }
    if anchor > 0 && anchor <= s.nodes.len && s.nodes[anchor - 1].kind >= 0 {
        s.remove(anchor) >>>
    }
    << 0
}

pub fn (s &Screen) is_context_menu_open() bool {
    root := s.composition.context_menu_root
    if root <= 0 || root > s.nodes.len || s.nodes[root - 1].kind < 0 { << false }
    << s.is_visible(root)
}

pub fn (s &Screen) context_menu_id() int {
    << s.composition.context_menu_root
}

fn (s $&Screen) context_menu_handle_escape(actions $&[]Action) bool {
    if !s.is_context_menu_open() { << false }
    old_root := s.composition.context_menu_root
    s.close_context_menu() >>> (err) { << true }
    actions.push(Action{kind: ACTION_FLOATING_DISMISS,id: old_root,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
    << true
}

fn (s $&Screen) translate_context_menu_actions(actions $&[]Action) {
    root := s.composition.context_menu_root
    if root <= 0 { << }
    $selected_key := 0
    $selected := false
    $dismissed := false
    for i in 0:actions.len {
        a := actions[i]
        if a.kind == ACTION_ACTIVATE && s.composition.context_menu_item_keys.has(a.id) {
            selected_key = s.composition.context_menu_item_keys[a.id]
            selected = true
            actions[i] = Action{
                kind: ACTION_CONTEXT_MENU,
                id: root,
                needs_paint: true,
                request_focus: false,
                consumed: true,
                value: f64(selected_key)
            }
        } else if a.kind == ACTION_FLOATING_DISMISS && a.id == root {
            dismissed = true
        }
    }
    if selected || dismissed {
        _ := s.close_context_menu() >>> (err) { << }
    }
}
