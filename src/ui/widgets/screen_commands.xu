@ui/widgets

#ui
#errors

pub const ACTION_COMMAND = 18

pub struct CommandEntry {
    pub id int
    pub title string
    pub category string
    pub description string
    pub shortcut_key int
    pub shortcut_mods int
    pub enabled bool
    pub scope int
}

pub fn command_entry(id int,title string) CommandEntry {
    << CommandEntry{
        id: id,
        title: title + "",
        category: "",
        description: "",
        shortcut_key: 0,
        shortcut_mods: 0,
        enabled: true,
        scope: 0
    }
}

fn copy_command_entry(c &CommandEntry) CommandEntry {
    << CommandEntry{
        id: c.id,
        title: c.title + "",
        category: c.category + "",
        description: c.description + "",
        shortcut_key: c.shortcut_key,
        shortcut_mods: c.shortcut_mods,
        enabled: c.enabled,
        scope: c.scope
    }
}

fn cmd_ascii_lower_byte(b int) int {
    if b >= 65 && b <= 90 { << b + 32 }
    << b
}

fn cmd_find_ci(haystack &string,needle &string) int {
    if needle.len == 0 { << 0 }
    if haystack.len < needle.len { << -1 }
    limit := haystack.len - needle.len + 1
    for i in 0:limit {
        $ok := true
        for j in 0:needle.len {
            hb := cmd_ascii_lower_byte(haystack[i + j] & 255)
            nb := cmd_ascii_lower_byte(needle[j] & 255)
            if hb != nb {
                ok = false
                <-
            }
        }
        if ok { << i }
    }
    << -1
}

fn cmd_key_name(key int) string {
    nk := normalize_shortcut_key(key)
    if nk == ui.KEY_ESCAPE { << "Esc" }
    if nk == ui.KEY_ENTER { << "Enter" }
    if nk == ui.KEY_TAB { << "Tab" }
    if nk == ui.KEY_BACKSPACE { << "Backspace" }
    if nk == ui.KEY_DELETE { << "Delete" }
    if nk == ui.KEY_LEFT { << "Left" }
    if nk == ui.KEY_RIGHT { << "Right" }
    if nk == ui.KEY_UP { << "Up" }
    if nk == ui.KEY_DOWN { << "Down" }
    if nk == 32 { << "Space" }
    if nk >= 65 && nk <= 90 {
        alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
        idx := nk - 65
        << alpha[idx:idx + 1] + ""
    }
    if nk >= 48 && nk <= 57 {
        digits := "0123456789"
        idx := nk - 48
        << digits[idx:idx + 1] + ""
    }
    if nk >= ui.KEY_F1 && nk < ui.KEY_F1 + 12 {
        << "F" + str(nk - ui.KEY_F1 + 1)
    }
    << "Key" + str(nk)
}

pub fn format_command_shortcut_hint(key int,mods int) string {
    if key <= 0 { << "" }
    $out := ""
    if (mods & ui.MOD_CONTROL) != 0 { out = out + "Ctrl+" }
    if (mods & ui.MOD_ALT) != 0 { out = out + "Alt+" }
    if (mods & ui.MOD_SHIFT) != 0 { out = out + "Shift+" }
    if (mods & ui.MOD_META) != 0 { out = out + "Cmd+" }
    << out + cmd_key_name(key)
}

fn (s $&Screen) sync_command_shortcut(entry &CommandEntry) int {
    if entry.shortcut_key > 0 && entry.enabled {
        $sb := shortcut_binding(entry.id,entry.shortcut_key,entry.shortcut_mods)
        sb.scope = entry.scope
        s.bind_shortcut(&sb) >>>
    } else {
        s.unbind_shortcut(entry.id) >>>
    }
    << 0
}

pub fn (s $&Screen) register_command(entry &CommandEntry) int {
    s.check_screen() >>>
    if entry.id <= 0 || entry.title.len == 0 || entry.scope < 0 {
        >> errors.new("widgets: invalid command entry")
    }
    if entry.scope > 0 { _ := s.node(entry.scope) >>> }
    if entry.shortcut_key > 0 {
        sb := shortcut_binding(entry.id,entry.shortcut_key,entry.shortcut_mods)
        sb.validate() >>>
    }
    item := copy_command_entry(entry)
    comp := $&s.composition
    list := $&comp.commands
    $replaced := false
    for i in 0:list.len {
        if list[i].id == item.id {
            list[i] = item
            replaced = true
            <-
        }
    }
    if !replaced {
        if list.len >= 512 { >> errors.new("widgets: command registry capacity exceeded") }
        list.push(copy_command_entry(entry))
    }
    s.sync_command_shortcut(entry) >>>
    << 0
}

pub fn (s $&Screen) unregister_command(id int) int {
    s.check_screen() >>>
    comp := $&s.composition
    $next := []CommandEntry{}
    $removed := false
    for i in 0:comp.commands.len {
        if comp.commands[i].id == id {
            removed = true
        } else {
            next.push(copy_command_entry(&comp.commands[i]))
        }
    }
    if !removed { << 0 }
    comp.commands = next
    s.unbind_shortcut(id) >>>
    << 0
}

pub fn (s $&Screen) set_command_enabled(id int,enabled bool) int {
    s.check_screen() >>>
    comp := $&s.composition
    list := $&comp.commands
    $idx := -1
    for i in 0:list.len {
        if list[i].id == id {
            list[i].enabled = enabled
            idx = i
            <-
        }
    }
    if idx < 0 { >> errors.new("widgets: unknown command id") }
    snapshot := copy_command_entry(&s.composition.commands[idx])
    s.sync_command_shortcut(&snapshot) >>>
    << 0
}

pub fn (s &Screen) command_count() int {
    << s.composition.commands.len
}

pub fn (s &Screen) command_shortcut_hint(id int) string {
    for i in 0:s.composition.commands.len {
        c := &s.composition.commands[i]
        if c.id == id {
            << format_command_shortcut_hint(c.shortcut_key,c.shortcut_mods)
        }
    }
    << ""
}

fn (s &Screen) is_command_disabled(id int) bool {
    for i in 0:s.composition.commands.len {
        c := &s.composition.commands[i]
        if c.id == id { << !c.enabled }
    }
    << false
}

pub fn (s &Screen) search_commands(query string) []CommandEntry {
    $hits := []CommandEntry{}
    $scores := []int{}
    q := trim_dnd_token(query + "")
    for i in 0:s.composition.commands.len {
        c := &s.composition.commands[i]
        if !c.enabled { -> }
        $sc := 0
        if q.len == 0 {
            sc = 1000 - i
        } else {
            tpos := cmd_find_ci(&c.title,&q)
            if tpos == 0 { sc = 300 }
            else if tpos > 0 { sc = 200 - tpos }
            else if cmd_find_ci(&c.category,&q) >= 0 { sc = 100 }
            else if cmd_find_ci(&c.description,&q) >= 0 { sc = 50 }
        }
        if sc > 0 {
            hits.push(copy_command_entry(c))
            scores.push(sc)
        }
    }
    if q.len > 0 && hits.len > 1 {
        for i in 1:hits.len {
            key_c := copy_command_entry(&hits[i])
            key_s := scores[i]
            $j := i - 1
            while j >= 0 && scores[j] < key_s {
                hits[j + 1] = copy_command_entry(&hits[j])
                scores[j + 1] = scores[j]
                j -= 1
            }
            hits[j + 1] = key_c
            scores[j + 1] = key_s
        }
    }
    << hits
}

pub fn (s $&Screen) execute_command(id int) int {
    s.check_screen() >>>
    $found := false
    $enabled := false
    for i in 0:s.composition.commands.len {
        c := &s.composition.commands[i]
        if c.id == id {
            found = true
            enabled = c.enabled
            <-
        }
    }
    if !found { >> errors.new("widgets: unknown command id") }
    if !enabled { >> errors.new("widgets: command is disabled") }
    qa := $&s.queued_actions
    qa.push(Action{kind: ACTION_COMMAND,id: id,needs_paint: false,request_focus: false,consumed: true,value: 0.0})
    << 0
}

fn (s $&Screen) cleanup_commands_for(scope_id int) {
    if scope_id <= 0 || s.composition.commands.len == 0 { << }
    comp := $&s.composition
    $next := []CommandEntry{}
    for i in 0:comp.commands.len {
        if comp.commands[i].scope != scope_id {
            next.push(copy_command_entry(&comp.commands[i]))
        }
    }
    comp.commands = next
}
