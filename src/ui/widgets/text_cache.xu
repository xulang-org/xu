@ui/widgets

#ui/draw
#ui/layout
#math
#errors

// Composite controls share typography while retaining separate native layouts.
// Cache keys are sparse identities; visible-cell slots can be reused by callers.
// Native handles are plain values with explicit disposal, like Editor.
struct TextCache {
    context draw.Context
    keys []int
    values []string
    layouts []draw.TextLayout
    options draw.TextOptions
    ready bool
}
fn text_cache(context &draw.Context) TextCache {
    << TextCache{context: context.clone(),keys: []int{},values: []string{},layouts: []draw.TextLayout{},options: draw.text_options(0.0),ready: false}
}
fn (cache &mut TextCache) dispose() {
    for item in cache.layouts { mut owned := item
        owned.dispose() or (err) { -> } }
    cache.layouts = []draw.TextLayout{}
    cache.keys = []int{}
    cache.values = []string{}
    cache.ready = false
}
fn (cache &TextCache) layout_at(index int) draw.TextLayout {
    for i in 0:cache.keys.len { if cache.keys[i] == index { << cache.layouts[i] } }
    >> errors.new("widgets: missing text cache layout")
}
fn (cache &mut TextCache) measure(index int,value &string,styles &Styles,c &ControlStyle) layout.Size {
    if index < 0 { >> errors.new("widgets: text cache key out of range") }
    options := styles.text_options(c)
    << cache.measure_options(index,value,&options) or >>
}
fn (cache &mut TextCache) measure_options(index int,value &string,options &draw.TextOptions) layout.Size {
    if !cache.ready || !options_equal(&cache.options,options) {
        cache.dispose()
        cache.options = copy_text_options(options)
        cache.ready = true
    }
    mut slot := -1
    for i in 0:cache.keys.len { if cache.keys[i] == index { slot = i } }
    if slot < 0 {
        shaped := cache.context.layout_text(value,options) or >>
        slot = cache.layouts.len
        layouts := mut &cache.layouts
        layouts.push(shaped)
        values := mut &cache.values
        values.push(value + "")
        keys := mut &cache.keys
        keys.push(index)
    }
    if cache.values[slot] != value + "" {
        shaped := cache.context.layout_text(value,options) or >>
        mut old := cache.layouts[slot]
        old.dispose() or >>
        cache.layouts[slot] = shaped
        cache.values[slot] = value + ""
    }
    shaped := cache.layouts[slot]
    << layout.Size{width: shaped.metrics.width,height: shaped.metrics.height}
}
fn (cache &mut TextCache) paint_text(index int,value &string,frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,c &ControlStyle,state int) int {
    _ := cache.measure(index,value,styles,c) or >>
    mut slot := -1
    for i in 0:cache.keys.len { if cache.keys[i] == index { slot = i } }
    if slot < 0 { >> errors.new("widgets: missing text cache entry") }
    shaped := cache.layouts[slot]
    d := styles.density
    x := bounds.x + c.padding.left * d
    y := bounds.y + c.padding.top * d
    width := math.max(0.0,bounds.width - (c.padding.left + c.padding.right) * d)
    height := math.max(0.0,bounds.height - (c.padding.top + c.padding.bottom) * d)
    frame.push() or >>
    frame.clip_rect(x,y,width,height) or >>
    frame.text_layout(&shaped,x + (width - shaped.metrics.width) * c.align_x,y + (height - shaped.metrics.height) * c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}

fn (cache &mut TextCache) paint_wrapped(index int,value &string,frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,c &ControlStyle,state int) int {
    d := styles.density
    x := bounds.x+c.padding.left*d
    y := bounds.y+c.padding.top*d
    width := math.max(1.0,bounds.width-(c.padding.left+c.padding.right)*d)
    height := math.max(0.0,bounds.height-(c.padding.top+c.padding.bottom)*d)
    mut options := styles.text_options(c)
    options.width=width
    size := cache.measure_options(index,value,&options) or >>
    shaped := cache.layout_at(index) or >>
    frame.push() or >>
    frame.clip_rect(x,y,width,height) or >>
    frame.text_layout(&shaped,x,y+math.max(0.0,height-size.height)*c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}

// Frames retain their layouts independently, so scrolling can release cached
// layouts outside the visible window without invalidating a recorded frame.
fn (cache &mut TextCache) retain_keys(wanted &[]int) {
    mut keys := []int{}
    mut values := []string{}
    mut layouts := []draw.TextLayout{}
    for i in 0:cache.keys.len {
        mut keep := false
        for key in wanted { if cache.keys[i] == key { keep = true
            <- } }
        if keep { keys.push(cache.keys[i])
            values.push(cache.values[i]+"")
            layouts.push(cache.layouts[i]) }
        else { mut layout := cache.layouts[i]
            layout.dispose() or (err) { -> } }
    }
    cache.keys = keys
    cache.values = values
    cache.layouts = layouts
}
