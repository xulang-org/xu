@ui/widgets

#ui
#ui/draw
#ui/layout
#math
#errors

// Composite controls share typography while retaining separate native layouts.
// Cache keys are sparse identities; visible-cell slots can be reused by callers.
// Native handles are plain values with explicit disposal, like Editor.
pub struct TextCache {
    context draw.Context
    keys []int
    values []string
    layouts []draw.TextLayout
    font_widths []f64
    options draw.TextOptions
    ready bool
}
pub fn text_cache(context &draw.Context) TextCache {
    << TextCache{context: context.clone(),keys: []int{},values: []string{},layouts: []draw.TextLayout{},font_widths: []f64{},options: draw.text_options(0.0),ready: false}
}
pub fn (cache $&TextCache) dispose() {
    for item in cache.layouts { $owned := item
        owned.dispose() or (err) { -> } }
    cache.layouts = []draw.TextLayout{}
    cache.font_widths = []f64{}
    cache.keys = []int{}
    cache.values = []string{}
    cache.ready = false
}
fn (cache &TextCache) layout_at(index int) draw.TextLayout {
    for i in 0:cache.keys.len { if cache.keys[i] == index { << cache.layouts[i] } }
    >> errors.new("widgets: missing text cache layout")
}
fn (cache &TextCache) slot_of(index int) int {
    for i in 0:cache.keys.len { if cache.keys[i] == index { << i } }
    << -1
}
fn (cache &TextCache) hostless_options(slot int) draw.TextOptions {
    $opts := copy_text_options(&cache.options)
    if slot >= 0 && slot < cache.font_widths.len {
        opts.width = cache.font_widths[slot]
    }
    << opts
}
fn (cache &TextCache) paint_slot_at(slot int,frame $&draw.Frame,x f64,y f64,color draw.Color) int {
    if slot < 0 || slot >= cache.layouts.len { >> errors.new("widgets: missing text cache entry") }
    shaped := &cache.layouts[slot]
    if shaped.is_host_shaped() { << frame.text_layout(shaped,x,y,color) or >> }
    stack := draw.default_font_stack() or >>
    opts := cache.hostless_options(slot)
    text := &cache.values[slot]
    ly := draw.layout_font_text(&stack,text,&opts,false) or >>
    << frame.text_font_layout(&ly,text,x,y,color) or >>
}
pub fn (cache $&TextCache) measure(index int,value &string,styles &Styles,c &ControlStyle) layout.Size {
    if index < 0 { >> errors.new("widgets: text cache key out of range") }
    options := styles.text_options(c)
    << cache.measure_options(index,value,&options) or >>
}
fn (cache $&TextCache) ensure_slot(index int,value &string,options &draw.TextOptions) int {
    if !cache.ready || !options_equal(&cache.options,options) {
        cache.dispose()
        cache.options = copy_text_options(options)
        cache.ready = true
    }
    $slot := cache.slot_of(index)
    if ui.host_tmp() != ":xu:" {
        if slot >= 0 && slot < cache.font_widths.len && cache.font_widths[slot] == options.width && cache.values[slot] == *value {
            << slot
        }
        stack := draw.default_font_stack() or >>
        ly := draw.layout_font_text(&stack,value,options,false) or >>
        metrics := draw.font_metrics_to_draw(&ly.metrics)
        empty_ly := cache.context.empty_text_layout(metrics)
        if slot < 0 {
            slot = cache.layouts.len
            layouts := $&cache.layouts
            layouts.push(empty_ly)
            fws := $&cache.font_widths
            fws.push(options.width)
            values := $&cache.values
            values.push(value + "")
            keys := $&cache.keys
            keys.push(index)
        } else {
            cache.layouts[slot] = empty_ly
            if slot < cache.font_widths.len { cache.font_widths[slot] = options.width }
            cache.values[slot] = value + ""
        }
        << slot
    }
    if slot >= 0 && cache.values[slot] == *value { << slot }
    shaped := cache.context.layout_text(value,options) or >>
    if slot < 0 {
        slot = cache.layouts.len
        layouts := $&cache.layouts
        layouts.push(shaped)
        values := $&cache.values
        values.push(value + "")
        keys := $&cache.keys
        keys.push(index)
    } else {
        $old := cache.layouts[slot]
        old.dispose() or >>
        cache.layouts[slot] = shaped
        cache.values[slot] = value + ""
    }
    << slot
}
fn (cache $&TextCache) measure_options(index int,value &string,options &draw.TextOptions) layout.Size {
    slot := cache.ensure_slot(index,value,options) or >>
    shaped := &cache.layouts[slot]
    << layout.Size{width: shaped.metrics.width,height: shaped.metrics.height}
}
pub fn (cache $&TextCache) paint_text(index int,value &string,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,c &ControlStyle,state int) int {
    options := styles.text_options(c)
    slot := cache.ensure_slot(index,value,&options) or >>
    shaped := &cache.layouts[slot]
    d := styles.density
    x := bounds.x + c.padding.left * d
    y := bounds.y + c.padding.top * d
    width := math.max(0.0,bounds.width - (c.padding.left + c.padding.right) * d)
    height := math.max(0.0,bounds.height - (c.padding.top + c.padding.bottom) * d)
    frame.push() or >>
    frame.clip_rect(x,y,width,height) or >>
    cache.paint_slot_at(slot,frame,x + math.max(0.0,width - shaped.metrics.width) * c.align_x,y + math.max(0.0,height - shaped.metrics.height) * c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}

fn (cache $&TextCache) paint_wrapped(index int,value &string,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,c &ControlStyle,state int) int {
    d := styles.density
    x := bounds.x+c.padding.left*d
    y := bounds.y+c.padding.top*d
    width := math.max(1.0,bounds.width-(c.padding.left+c.padding.right)*d)
    height := math.max(0.0,bounds.height-(c.padding.top+c.padding.bottom)*d)
    $options := styles.text_options(c)
    options.width=width
    slot := cache.ensure_slot(index,value,&options) or >>
    shaped := &cache.layouts[slot]
    frame.push() or >>
    frame.clip_rect(x,y,width,height) or >>
    cache.paint_slot_at(slot,frame,x,y+math.max(0.0,height-shaped.metrics.height)*c.align_y,c.resolve(state).foreground) or >>
    frame.pop() or >>
    << 0
}

// Frames retain their layouts independently, so scrolling can release cached
// layouts outside the visible window without invalidating a recorded frame.
fn (cache $&TextCache) retain_keys(wanted &[]int) {
    $keys := []int{}
    $values := []string{}
    $layouts := []draw.TextLayout{}
    $font_widths := []f64{}
    for i in 0:cache.keys.len {
        $keep := false
        for key in wanted { if cache.keys[i] == key { keep = true
            <- } }
        if keep { keys.push(cache.keys[i])
            values.push(cache.values[i]+"")
            layouts.push(cache.layouts[i])
            if i < cache.font_widths.len { font_widths.push(cache.font_widths[i]) } }
        else { $layout := cache.layouts[i]
            layout.dispose() or (err) { -> } }
    }
    cache.keys = keys
    cache.values = values
    cache.layouts = layouts
    cache.font_widths = font_widths
}
