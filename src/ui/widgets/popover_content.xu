@ui/widgets
#ui
#ui/draw
#ui/layout
#errors
#math

pub const OVERLAY_BOTTOM = 0
pub const OVERLAY_TOP = 1
pub const OVERLAY_LEFT = 2
pub const OVERLAY_RIGHT = 3
pub const OVERLAY_START = 0
pub const OVERLAY_CENTER = 1
pub const OVERLAY_END = 2
pub struct OverlayPlacement {
    pub side int
    pub align int
    pub gap f64
    pub offset f64
    pub flip bool
}
pub fn overlay_placement() OverlayPlacement { << OverlayPlacement{side: OVERLAY_BOTTOM,align: OVERLAY_START,gap: 8.0,offset: 0.0,flip: true} }
fn (placement &OverlayPlacement) validate() int {
    if placement.side < 0 || placement.side > 3 || placement.align < 0 || placement.align > 2 || !finite_metric(placement.gap,128.0) || math.is_nan(placement.offset) || math.is_inf(placement.offset) || math.abs(placement.offset) > 4096.0 { >> errors.new("widgets: invalid overlay placement") }
    << 0
}
pub fn placed_overlay_bounds(anchor &layout.Rect,size &layout.Size,viewport &layout.Rect,placement &OverlayPlacement) layout.Rect {
    placement.validate() or >>
    validate_bounds(anchor) or >>
    validate_bounds(viewport) or >>
    validate_bounds(&layout.Rect{x: 0.0,y: 0.0,width: size.width,height: size.height}) or >>
    width := math.min(size.width,viewport.width)
    height := math.min(size.height,viewport.height)
    $side := placement.side
    gap := placement.gap
    below := viewport.y + viewport.height - anchor.y - anchor.height - gap
    above := anchor.y - gap - viewport.y
    left := anchor.x - gap - viewport.x
    right := viewport.x + viewport.width - anchor.x - anchor.width - gap
    if placement.flip {
        if side == OVERLAY_BOTTOM && height > below && above > below { side = OVERLAY_TOP }
        else if side == OVERLAY_TOP && height > above && below > above { side = OVERLAY_BOTTOM }
        else if side == OVERLAY_LEFT && width > left && right > left { side = OVERLAY_RIGHT }
        else if side == OVERLAY_RIGHT && width > right && left > right { side = OVERLAY_LEFT }
    }
    $align := 0.0
    if placement.align == OVERLAY_CENTER { align = 0.5 }
    if placement.align == OVERLAY_END { align = 1.0 }
    $x := anchor.x + (anchor.width - width) * align + placement.offset
    $y := anchor.y + anchor.height + gap
    if side == OVERLAY_TOP { y = anchor.y - height - gap }
    if side == OVERLAY_LEFT || side == OVERLAY_RIGHT {
        y = anchor.y + (anchor.height - height) * align + placement.offset
        x = anchor.x - width - gap
        if side == OVERLAY_RIGHT { x = anchor.x + anchor.width + gap }
    }
    << layout.Rect{x: math.max(viewport.x,math.min(x,viewport.x + viewport.width - width)),
        y: math.max(viewport.y,math.min(y,viewport.y + viewport.height - height)),width: width,height: height}
}
pub fn (panel $&Popover) set_placement(placement &OverlayPlacement) int {
    placement.validate() or >>
    panel.placement = OverlayPlacement{side: placement.side,align: placement.align,gap: placement.gap,offset: placement.offset,flip: placement.flip}
    anchor := panel.anchor
    size := panel.extent
    viewport := panel.viewport
    << panel.set_geometry(&anchor,&size,&viewport) or >>
}
pub fn (panel $&Popover) set_dismissal(outside bool,escape bool) { panel.close_outside = outside
    panel.close_escape = escape }
pub fn (s $&Screen) set_popover_placement(id int,placement &OverlayPlacement) int {
    placement.validate() or >>
    $panel := s.screen_take_popover(id) or >>
    message := popover_placement_update($&panel,placement)
    s.screen_put_popover(id,panel)
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn popover_placement_update(panel $&Popover,placement &OverlayPlacement) string { panel.set_placement(placement) or (err) { << err.msg() }
    << "" }
pub fn (s $&Screen) set_tooltip_placement(id int,placement &OverlayPlacement) int {
    placement.validate() or >>
    $item := s.screen_take_tooltip(id) or >>
    item.set_placement(placement) or (err) { s.screen_put_tooltip(id,item.clone_tooltip())
        >> err }
    s.screen_put_tooltip(id,item)
    s.dirty = true
    << 0
}
pub fn (s $&Screen) set_popover_dismissal(id int,outside bool,escape bool) int {
    $panel := s.screen_take_popover(id) or >>
    panel.set_dismissal(outside,escape)
    s.screen_put_popover(id,panel)
    << 0
}
// Any ordinary Screen control can be parented to the floating surface.
fn (s &Screen) in_popover_content(id int) bool {
    for node in s.nodes { if node.kind == SCREEN_POPOVER && node.id != id && s.is_descendant(id,node.id) { << true } }
    << false
}
fn (s &Screen) popover_has_content(id int) bool {
    for node in s.nodes { if node.id != id && node.kind < SCREEN_POPOVER && s.is_descendant(node.id,id) { << true } }
    << false
}
fn (s &Screen) popover_at(x f64,y f64) int {
    $i := s.nodes.len - 1
    while i >= 0 { node := s.nodes[i]
        if node.kind == SCREEN_POPOVER && s.is_visible(node.id) && s.overlay_is_visible(node.id) && node.bounds.contains(x,y) { << node.id }
        i -= 1 }
    << 0
}
fn (s $&Screen) popover_candidate_hit(id int,x f64,y f64) bool {
    for child in s.nodes { if child.kind >= SCREEN_CHECKBOX && child.kind < SCREEN_POPOVER && s.is_descendant(child.id,id) && s.is_visible(child.id) {
        b := s.control_popup(child.id) or >>
        if b.width > 0.0 && b.contains(x,y) { << true }
    } }
    << false
}
fn (s $&Screen) paint_popover_content(id int,frame $&draw.Frame,styles &Styles,opacity f64) int {
    if !s.overlay_is_visible(id) { << 0 }
    bounds := s.overlay_popup(id)
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    for child in s.nodes { if child.kind >= SCREEN_LABEL && child.kind < SCREEN_POPOVER && s.is_visible(child.id) && s.is_descendant(child.id,id) { s.paint_node(child.id,frame,opacity) or >> } }
    frame.pop() or >>
    for child in s.nodes { if child.kind >= SCREEN_CHECKBOX && child.kind < SCREEN_POPOVER && s.is_visible(child.id) && s.is_descendant(child.id,id) { s.control_paint(child.id,frame,styles,true) or >> } }
    << 0
}
fn (s $&Screen) popover_enter(id int) int {
    for child in s.nodes { if child.kind < SCREEN_POPOVER && child.id != id && s.is_descendant(child.id,id) && s.focus_ready(child.id,s.modal_blocks()) or >> {
        s.focus_input(child.id) or >>
        <- } }
    << 0
}
fn (s $&Screen) popover_restore(id int) int {
    if s.is_descendant(s.captured,id) { event := s.cancellation()
        _ := s.route_node(s.captured,ROUTE_CANCEL,&event) or >>
        s.captured = 0 }
    if s.focused == 0 || s.is_descendant(s.focused,id) { s.focus_input(s.overlay_anchor(id)) or >> }
    s.dirty = true
    << 0
}

fn (s $&Screen) record_popover(id int,frame $&draw.Frame,styles &Styles) int {
    if !s.overlay_is_visible(id) { << 0 }
    opacity := s.overlay_opacity(id)
    if opacity <= 0.0 { << 0 }
    b := s.overlay_popup(id)
    c := s.overlay_style(id,styles) or >>
    $isolated := opacity < 1.0
    for child in s.nodes { if child.kind == SCREEN_WEBVIEW && s.is_descendant(child.id,id) { isolated = false } }
    if isolated {
        pad := 24.0 * math.max(1.0,styles.density)
        frame.begin_layer(&draw.ImageRect{x: b.x-pad,y: b.y-pad,width: b.width+pad*2.0,height: b.height+pad*2.0},2.0,opacity) or >>
        frame.translate(pad-b.x,pad-b.y) or >>
    }
    paint_box_styled(frame,&b,styles,&c,0) or >>
    if s.texts[id-1].len > 0 { s.paint_text(id,frame,&b,&c,1.0) or >> }
    s.paint_popover_content(id,frame,styles,1.0) or >>
    if isolated { frame.end_layer() or >> }
    << 0
}
