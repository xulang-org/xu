@ui/widgets

#errors

// Password values remain application data. Rendering masks graphemes; copying,
// cutting and native surrounding-text requests never export the value.
pub fn (s &mut Screen) password_input(value string) int {
    id := s.input(value) or >>
    s.set_password(id,true) or >>
    << id
}
pub fn (s &mut Screen) set_password(id int,password bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_EDITOR { >> errors.new("widgets: expected Input") }
    owner := mut &s.controls
    items := mut &owner.editors
    mut item := items.take(id)
    message := screen_password_update(mut &item,password,false)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_password_visible(id int,visible bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_EDITOR { >> errors.new("widgets: expected password Input") }
    owner := mut &s.controls
    items := mut &owner.editors
    mut item := items.take(id)
    message := screen_password_update(mut &item,visible,true)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_password_update(item &mut Editor,value bool,visibility bool) string {
    if visibility { item.set_password_visible(value) or (err) { << err.msg() } }
    else { item.set_password(value) or (err) { << err.msg() } }
    << ""
}
pub fn (s &Screen) is_password(id int) bool {
    node := s.node(id) or >>
    if node.kind != SCREEN_EDITOR { >> errors.new("widgets: expected Input") }
    << s.controls.editors[id].is_password()
}
pub fn (s &Screen) is_password_visible(id int) bool {
    node := s.node(id) or >>
    if node.kind != SCREEN_EDITOR { >> errors.new("widgets: expected Input") }
    << s.controls.editors[id].is_password_visible()
}
