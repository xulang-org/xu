@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#errors

pub fn (s &mut Screen) set_tab_behavior(id int,widths &[]f64,automatic bool) int {
    n := s.node(id) or >>
    if n.kind != SCREEN_TABS { >> errors.new("widgets: expected Tabs") }
    owner := mut &s.basics
    items := mut &owner.tabs
    mut item := items.take(id)
    message := screen_config_set_tab_behavior(mut &item,widths,automatic)
    items[id] = item
    if message.len>0 { >> errors.new(message) }
    s.dirty=true
    << 0
}
fn screen_config_set_tab_behavior(item &mut Tabs,widths &[]f64,automatic bool) string {
    item.set_item_widths(widths) or (err) { << err.msg() }
    item.set_automatic_activation(automatic)
    << ""
}
