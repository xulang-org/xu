pub fn (s $&Screen) color_hex(id int) string {
    n := s.node(id) or >>
    if n.kind!=SCREEN_COLOR { >> errors.new("widgets: expected ColorPicker") }
    controls := $&s.controls
    items := $&controls.colors
    item := items.take(id)
    value := item.hex()
    items[id]=item
    << value
}
pub fn (s $&Screen) calendar_has_value(id int) bool {
    n := s.node(id) or >>
    if n.kind!=SCREEN_DATE { >> errors.new("widgets: expected DatePicker") }
    controls := $&s.controls
    items := $&controls.dates
    item := items.take(id)
    value := item.has_value()
    items[id]=item
    << value
}
pub fn (s $&Screen) text_field_area(value string,decoration &FieldDecoration) int {
    id := s.add_node(SCREEN_FIELD,true,ui.CURSOR_TEXT) or >>
    empty := screen_empty()
    item := text_field_area(&s.context,&s.identity,id,&empty,&value,decoration) or (err) { s.abandon_node(id)
        >> err }
    controls := $&s.controls
    controls.fields[id]=item
    s.apply_current_locale(id) or >>
    << id
}

