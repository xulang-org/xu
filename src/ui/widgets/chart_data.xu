@ui/widgets

#ui/draw
#ui/layout
#math
#errors

pub const CHART_LINE = 0
pub const CHART_AREA = 1
pub const CHART_BAR = 2
pub const CHART_SCATTER = 3
pub const CHART_DONUT = 4
pub const CHART_STEP_LINE = 5
pub const CHART_STACKED_AREA = 6
pub const CHART_STACKED_BAR = 7
pub const CHART_HORIZONTAL_BAR = 8
pub const CHART_PIE = 9
pub const CHART_ROSE = 10
pub const CHART_RADAR = 11
pub const CHART_GAUGE = 12
pub const CHART_BUBBLE = 13
pub const CHART_HISTOGRAM = 14
pub const CHART_BOXPLOT = 15
pub const CHART_HEATMAP = 16
pub const CHART_CANDLESTICK = 17
pub const CHART_WATERFALL = 18
pub const CHART_FUNNEL = 19
pub const ACTION_CHART_HOVER = 40
pub const ACTION_CHART_SELECT = 41
pub const ACTION_CHART_VIEWPORT = 42
pub const ACTION_CHART_LEGEND = 43
pub const CHART_MAX_POINTS = 4096
pub const CHART_MAX_SERIES = 8

fn chart_line_family(kind int) bool {
    << kind == CHART_LINE || kind == CHART_AREA || kind == CHART_STEP_LINE || kind == CHART_STACKED_AREA
}
fn chart_bar_family(kind int) bool {
    << kind == CHART_BAR || kind == CHART_STACKED_BAR || kind == CHART_HISTOGRAM || kind == CHART_WATERFALL
}
fn chart_slice_family(kind int) bool {
    << kind == CHART_DONUT || kind == CHART_PIE || kind == CHART_ROSE
}
fn chart_range_family(kind int) bool {
    << kind == CHART_BOXPLOT || kind == CHART_CANDLESTICK
}
fn chart_polar_kind(kind int) bool {
    << (kind >= CHART_DONUT && kind <= CHART_GAUGE && (kind == CHART_DONUT || kind >= CHART_PIE)) || kind == CHART_FUNNEL
}
fn chart_single_series_kind(kind int) bool {
    << kind == CHART_DONUT || kind == CHART_PIE || kind == CHART_ROSE || kind == CHART_GAUGE || kind == CHART_WATERFALL || kind == CHART_FUNNEL
}
fn chart_ordered_x_kind(kind int) bool {
    << kind <= CHART_BAR || (kind >= CHART_STEP_LINE && kind <= CHART_HORIZONTAL_BAR) ||
       kind == CHART_HISTOGRAM || kind == CHART_BOXPLOT || kind == CHART_CANDLESTICK || kind == CHART_WATERFALL
}
fn chart_nonnegative_y_kind(kind int) bool {
    << kind == CHART_DONUT || kind == CHART_PIE || kind == CHART_ROSE || kind == CHART_RADAR ||
       kind == CHART_GAUGE || kind == CHART_HISTOGRAM || kind == CHART_FUNNEL
}
fn chart_kinds_compatible(a int,b int) bool {
    << a == b || (chart_line_family(a) && chart_line_family(b)) ||
       (chart_bar_family(a) && chart_bar_family(b)) ||
       ((a == CHART_SCATTER || a == CHART_BUBBLE) && (b == CHART_SCATTER || b == CHART_BUBBLE)) ||
       (chart_slice_family(a) && chart_slice_family(b)) ||
       (chart_range_family(a) && chart_range_family(b))
}

pub struct ChartPoint {
    pub id int
    pub x f64
    pub y f64
    pub low f64
    pub high f64
    pub close f64
    pub size f64
    pub label string
}
pub fn chart_point(id int,x f64,y f64) ChartPoint {
    << ChartPoint{id: id,x: x,y: y,low: 0.0,high: 0.0,close: 0.0,size: 0.0,label: ""}
}
pub fn chart_bubble_point(id int,x f64,y f64,size f64) ChartPoint {
    << ChartPoint{id: id,x: x,y: y,low: 0.0,high: 0.0,close: 0.0,size: size,label: ""}
}
pub fn chart_range_point(id int,x f64,open f64,low f64,high f64,close f64) ChartPoint {
    << ChartPoint{id: id,x: x,y: open,low: low,high: high,close: close,size: (open + close) * 0.5,label: ""}
}
pub struct ChartSeries {
    pub id int
    pub name string
    pub kind int
    pub points []ChartPoint
    pub color draw.Color
    pub custom_color bool
    pub visible bool
    pub line_width f64
    pub symbol_size f64
    pub smooth bool
}
pub fn chart_series(id int,name string,kind int) ChartSeries {
    << ChartSeries{id: id,name: name,kind: kind,points: []ChartPoint{},color: draw.rgb(0,0,0),
        custom_color: false,visible: true,line_width: 2.0,symbol_size: 4.0,smooth: false}
}
pub fn (s &ChartSeries) clone() ChartSeries {
    $points := []ChartPoint{}
    for p in s.points {
        points.push(ChartPoint{id: p.id,x: p.x,y: p.y,low: p.low,high: p.high,close: p.close,size: p.size,label: p.label + ""})
    }
    << ChartSeries{id: s.id,name: s.name + "",kind: s.kind,points: points,color: s.color,custom_color: s.custom_color,
        visible: s.visible,line_width: s.line_width,symbol_size: s.symbol_size,smooth: s.smooth}
}
pub struct ChartDomain {
    pub x_min f64
    pub x_max f64
    pub y_min f64
    pub y_max f64
}
pub fn chart_domain(x_min f64,x_max f64,y_min f64,y_max f64) ChartDomain {
    d := ChartDomain{x_min: x_min,x_max: x_max,y_min: y_min,y_max: y_max}
    d.validate() or >>
    << d
}
pub fn (d &ChartDomain) validate() int {
    if !chart_number(d.x_min) || !chart_number(d.x_max) || !chart_number(d.y_min) || !chart_number(d.y_max) ||
       d.x_max - d.x_min < 0.000000001 || d.y_max - d.y_min < 0.000000001 { >> errors.new("widgets: invalid chart domain") }
    << 0
}
fn chart_finite(n f64) bool { << !math.is_nan(n) && !math.is_inf(n) }
fn chart_number(n f64) bool { << chart_finite(n) && math.abs(n) <= 1000000000000.0 }
fn chart_copy_domain(d &ChartDomain) ChartDomain {
    << ChartDomain{x_min: d.x_min,x_max: d.x_max,y_min: d.y_min,y_max: d.y_max}
}
pub struct ChartAppearance {
    pub grid bool
    pub legend bool
    pub tooltip bool
    pub crosshair bool
    pub zoom bool
    pub pan bool
    pub zero_baseline bool
    pub ticks int
    pub precision int
    pub inner_radius f64
    pub area_opacity f64
    pub bar_ratio f64
    pub hit_radius f64
    pub x_unit string
    pub y_unit string
    pub empty_text string
    pub palette []draw.Color
}
pub fn chart_appearance() ChartAppearance {
    << ChartAppearance{grid: true,legend: true,tooltip: true,crosshair: true,zoom: true,pan: true,zero_baseline: true,
        ticks: 4,precision: 0,inner_radius: 0.64,area_opacity: 0.14,bar_ratio: 0.7,hit_radius: 18.0,
        x_unit: "",y_unit: "",empty_text: "",palette: []draw.Color{}}
}
pub fn (a &ChartAppearance) validate() int {
    if a.ticks < 2 || a.ticks > 8 || a.precision < 0 || a.precision > 6 || !chart_finite(a.inner_radius) || a.inner_radius < 0.1 || a.inner_radius > 0.9 ||
       !chart_finite(a.area_opacity) || a.area_opacity < 0.0 || a.area_opacity > 1.0 || !chart_finite(a.bar_ratio) || a.bar_ratio < 0.1 || a.bar_ratio > 0.95 ||
       !chart_finite(a.hit_radius) || a.hit_radius < 4.0 || a.hit_radius > 64.0 || a.palette.len > 16 || a.x_unit.len > 64 || a.y_unit.len > 64 || a.empty_text.len > 1024 {
        >> errors.new("widgets: invalid chart appearance") }
    << 0
}
pub fn (a &ChartAppearance) clone() ChartAppearance {
    $palette := []draw.Color{}
    for color in a.palette { palette.push(color) }
    << ChartAppearance{grid: a.grid,legend: a.legend,tooltip: a.tooltip,crosshair: a.crosshair,zoom: a.zoom,pan: a.pan,
        zero_baseline: a.zero_baseline,ticks: a.ticks,precision: a.precision,inner_radius: a.inner_radius,area_opacity: a.area_opacity,
        bar_ratio: a.bar_ratio,hit_radius: a.hit_radius,x_unit: a.x_unit + "",y_unit: a.y_unit + "",empty_text: a.empty_text + "",palette: palette}
}
pub struct ChartHit {
    pub valid bool
    pub series_id int
    pub point_id int
    pub x f64
    pub y f64
    pub low f64
    pub high f64
    pub close f64
    pub size f64
    pub label string
}
pub struct ChartCoordinate { pub x f64
    pub y f64 }
fn chart_no_hit() ChartHit {
    << ChartHit{valid: false,series_id: 0,point_id: 0,x: 0.0,y: 0.0,low: 0.0,high: 0.0,close: 0.0,size: 0.0,label: ""}
}

// Each animated datum has a stable identity independent of its array position.
struct ChartDatum {
    series int
    id int
    x f64
    y f64
    low f64
    high f64
    close f64
    size f64
    opacity f64
    from_x f64
    from_y f64
    from_low f64
    from_high f64
    from_close f64
    from_size f64
    from_opacity f64
    target_x f64
    target_y f64
    target_low f64
    target_high f64
    target_close f64
    target_size f64
    target_opacity f64
    label string
}

fn point_has_range(p &ChartPoint) bool {
    << p.low != 0.0 || p.high != 0.0 || p.close != 0.0
}
fn datum_has_range(p &ChartDatum) bool {
    << p.low != 0.0 || p.high != 0.0 || p.close != 0.0 || p.target_low != 0.0 || p.target_high != 0.0 || p.target_close != 0.0
}
fn datum_range_span(y f64) f64 { << math.max(2.0,math.abs(y) * 0.16) }
fn datum_box_low(p &ChartDatum) f64 {
    if datum_has_range(p) { << math.min(p.low,math.min(p.y,p.close)) }
    << p.y - datum_range_span(p.y)
}
fn datum_box_q1(p &ChartDatum) f64 {
    if datum_has_range(p) { << math.min(p.y,p.close) }
    << p.y - datum_range_span(p.y) * 0.45
}
fn datum_box_q3(p &ChartDatum) f64 {
    if datum_has_range(p) { << math.max(p.y,p.close) }
    << p.y + datum_range_span(p.y) * 0.45
}
fn datum_box_high(p &ChartDatum) f64 {
    if datum_has_range(p) { << math.max(p.high,math.max(p.y,p.close)) }
    << p.y + datum_range_span(p.y)
}
fn datum_box_median(p &ChartDatum) f64 {
    q1 := datum_box_q1(p)
    q3 := datum_box_q3(p)
    if datum_has_range(p) && p.size >= q1 && p.size <= q3 { << p.size }
    << (q1 + q3) * 0.5
}
fn datum_candle_open(p &ChartDatum) f64 { << p.y }
fn datum_candle_close(p &ChartDatum) f64 {
    if datum_has_range(p) { << p.close }
    $delta := datum_range_span(p.y) * 0.45
    if (p.id % 2) == 0 { delta = 0.0 - delta }
    << p.y + delta
}
fn datum_candle_low(p &ChartDatum) f64 {
    open := datum_candle_open(p)
    close := datum_candle_close(p)
    if datum_has_range(p) { << math.min(p.low,math.min(open,close)) }
    << math.min(open,close) - datum_range_span(p.y) * 0.55
}
fn datum_candle_high(p &ChartDatum) f64 {
    open := datum_candle_open(p)
    close := datum_candle_close(p)
    if datum_has_range(p) { << math.max(p.high,math.max(open,close)) }
    << math.max(open,close) + datum_range_span(p.y) * 0.55
}

fn chart_validate_series(series &[]ChartSeries) int {
    if series.len > CHART_MAX_SERIES { >> errors.new("widgets: too many chart series") }
    $count := 0
    for i in 0:series.len { s := &series[i]
        if s.id <= 0 || s.id > 2147483647 || s.kind < CHART_LINE || s.kind > CHART_FUNNEL || s.name.len > 256 ||
           !chart_finite(s.line_width) || s.line_width < 0.5 || s.line_width > 12.0 || !chart_finite(s.symbol_size) || s.symbol_size < 0.0 || s.symbol_size > 24.0 {
            >> errors.new("widgets: invalid chart series") }
        if s.kind == CHART_DONUT && series.len != 1 { >> errors.new("widgets: a donut chart requires one series") }
        if chart_single_series_kind(s.kind) && series.len != 1 { >> errors.new("widgets: this chart kind requires one series") }
        if s.kind == CHART_RADAR && s.points.len > 0 && s.points.len < 3 { >> errors.new("widgets: radar chart requires at least three points") }
        if i > 0 {
            first_kind := series[0].kind
            if (first_kind == CHART_RADAR) != (s.kind == CHART_RADAR) ||
               (first_kind == CHART_HORIZONTAL_BAR) != (s.kind == CHART_HORIZONTAL_BAR) ||
               (first_kind == CHART_HEATMAP) != (s.kind == CHART_HEATMAP) {
                >> errors.new("widgets: incompatible chart series coordinate systems")
            }
        }
        for j in 0:i { if series[j].id == s.id { >> errors.new("widgets: duplicate chart series id") } }
        $ids := map[int]bool{}
        $previous_x := 0.0 - 1000000000001.0
        for p in s.points {
            if p.id <= 0 || p.id > 2147483647 || ids.has(p.id) || !chart_number(p.x) || !chart_number(p.y) ||
               !chart_number(p.low) || !chart_number(p.high) || !chart_number(p.close) || !chart_number(p.size) ||
               p.label.len > 256 || (chart_nonnegative_y_kind(s.kind) && p.y < 0.0) || (s.kind == CHART_BUBBLE && p.size < 0.0) {
                >> errors.new("widgets: invalid or duplicate chart point") }
            if chart_range_family(s.kind) && point_has_range(&p) {
                low := math.min(p.y,p.close)
                high := math.max(p.y,p.close)
                if p.low > low || p.high < high { >> errors.new("widgets: invalid chart point range") }
            }
            if chart_ordered_x_kind(s.kind) && p.x <= previous_x { >> errors.new("widgets: line, area and bar points require increasing x coordinates") }
            previous_x = p.x
            ids[p.id] = true
            count = count + 1
            if count > CHART_MAX_POINTS { >> errors.new("widgets: chart point limit exceeded") }
        }
    }
    << 0
}
