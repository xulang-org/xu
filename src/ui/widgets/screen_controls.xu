@ui/widgets

#ui
#ui/draw
#ui/layout
#ui/chart
#time
#errors

// Concrete owning maps retain control state. Maps compute their layout
// recursively and support struct values directly.

// Screen owns native resources and control state. An owning map entry is moved
// to a local value for each operation and restored on every error path.
struct ScreenControls {
    menus map[int]Menu
    splits map[int]SplitView
    split_panes map[int]int
    ranges map[int]RangeSlider
    charts map[int]chart.Chart
    button_groups map[int]ButtonGroup
    tables map[int]Table
    trees map[int]TreeView
    pages map[int]Pagination
    crumbs map[int]Breadcrumbs
    combos map[int]ComboBox
    multis map[int]MultiSelect
    colors map[int]ColorPicker
    dates map[int]DatePicker
    clocks map[int]TimePicker
    spinners map[int]Spinner
    editors map[int]Editor
    fields map[int]Field
    tasks map[int]TaskButton
}
fn new_screen_controls() ScreenControls {
    << ScreenControls{menus: map[int]Menu{},splits: map[int]SplitView{},split_panes: map[int]int{},ranges: map[int]RangeSlider{},charts: map[int]chart.Chart{},button_groups: map[int]ButtonGroup{},tables: map[int]Table{},trees: map[int]TreeView{},pages: map[int]Pagination{},crumbs: map[int]Breadcrumbs{},combos: map[int]ComboBox{},multis: map[int]MultiSelect{},colors: map[int]ColorPicker{},dates: map[int]DatePicker{},clocks: map[int]TimePicker{},spinners: map[int]Spinner{},editors: map[int]Editor{},fields: map[int]Field{},tasks: map[int]TaskButton{}}
}

pub fn (s $&Screen) table(headers &[]string,rows int,selected int) int {
    id := s.add_node(SCREEN_TABLE,true,ui.CURSOR_HAND) >>>
    empty := screen_empty()
    item := table(&s.context,&s.identity,id,&empty,headers,rows,selected) >>> (err) { s.abandon_node(id)
        >> err }
    controls := $&s.controls
    store := $&controls.tables
    store[id] = item
    s.apply_current_locale(id) >>>
    << id
}

pub fn (s $&Screen) tree() int {
    id := s.add_node(SCREEN_TREE,true,ui.CURSOR_HAND) >>>
    empty := screen_empty()
    item := tree_view(&s.context,&s.identity,id,&empty) >>> (err) { s.abandon_node(id)
        >> err }
    controls := $&s.controls
    store := $&controls.trees
    store[id] = item
    s.apply_current_locale(id) >>>
    s.apply_default_motion_to(id)
    << id
}

