fn screen_paint_date(item &mut DatePicker,frame &mut draw.Frame,styles &Styles,popup bool) string {
    if popup { item.paint_popup_styled(frame,styles) or (err) { << err.msg() } }
    else { item.paint_styled(frame,styles) or (err) { << err.msg() } }
    << ""
}
fn screen_paint_clock(item &mut TimePicker,frame &mut draw.Frame,styles &Styles,popup bool) string {
    if !popup { item.paint_styled(frame,styles) or (err) { << err.msg() } }
    << ""
}
fn screen_paint_spinner(item &mut Spinner,frame &mut draw.Frame,styles &Styles,popup bool) string {
    if !popup { item.paint_styled(frame,styles) or (err) { << err.msg() } }
    << ""
}
fn screen_paint_editor(item &mut Editor,frame &mut draw.Frame,styles &Styles,popup bool) string {
    if !popup { screen_controls_editor_paint(item,frame,styles) or (err) { << err.msg() } }
    << ""
}

fn (s &mut Screen) control_paint(id int,frame &mut draw.Frame,styles &Styles,popup bool) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_WEBVIEW { if !popup { s.web_paint(id,frame,styles) or >> }
        << 0 }
    if screen_basic_kind(node.kind) { << s.basic_paint(id,frame,styles,popup) or >> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_paint(id,frame,styles,popup) or >> }
    if screen_visual_kind(node.kind) { << s.visual_paint(id,frame,styles,popup) or >> }
    if node.kind == SCREEN_TABLE {
        controls := mut &s.controls
        items := mut &controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_table(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := mut &s.controls
        items := mut &controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_tree(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := mut &s.controls
        items := mut &controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_pagination(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := mut &s.controls
        items := mut &controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_crumbs(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_combo(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_multi(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := mut &s.controls
        items := mut &controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_color(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_date(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := mut &s.controls
        items := mut &controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_clock(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := mut &s.controls
        items := mut &controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_spinner(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_paint_editor(mut &item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    << 0
}

fn (s &mut Screen) control_painted(id int) int {
    node := s.node(id) or >>
    if screen_basic_kind(node.kind) { << s.basic_painted(id) or >> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_painted(id) or >> }
    if screen_visual_kind(node.kind) { << s.visual_painted(id) or >> }
    if node.kind == SCREEN_TABLE {
        controls := mut &s.controls
        items := mut &controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := mut &s.controls
        items := mut &controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := mut &s.controls
        items := mut &controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := mut &s.controls
        items := mut &controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.control.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        editor := mut &item.editor
        editor.painted()
        item.choices.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.control.dirty = false
        item.choices.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := mut &s.controls
        items := mut &controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.control.dirty = false
        for i in 0:4 { mut channel := item.channels[i]
            channel.painted()
            item.channels[i] = channel }
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.control.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := mut &s.controls
        items := mut &controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.control.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := mut &s.controls
        items := mut &controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    << 0
}

fn screen_tick_combo(item &mut ComboBox,now time.Instant,reduced bool) ScreenAnimation {
    changed := item.tick(now,reduced) or (err) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    deadline := item.next_caret_tick(now,reduced) or (err) { << ScreenAnimation{changed: changed,deadline: time.zero_instant()} }
    << ScreenAnimation{changed: changed,deadline: deadline}
}

fn screen_tick_spinner(item &mut Spinner,now time.Instant,reduced bool) ScreenAnimation {
    changed := item.tick(now,reduced) or (err) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    deadline := item.next_tick(now,reduced) or (err) { << ScreenAnimation{changed: changed,deadline: time.zero_instant()} }
    << ScreenAnimation{changed: changed,deadline: deadline}
}

fn screen_tick_editor(item &mut Editor,now time.Instant,reduced bool) ScreenAnimation {
    changed := item.tick(now,reduced) or (err) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    deadline := item.next_caret_tick(now,reduced) or (err) { << ScreenAnimation{changed: changed,deadline: time.zero_instant()} }
    << ScreenAnimation{changed: changed,deadline: deadline}
}

fn (s &mut Screen) control_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    node := s.node(id) or >>
    if screen_basic_kind(node.kind) { << s.basic_tick(id,now,reduced) or >> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_tick(id,now,reduced) or >> }
    if screen_visual_kind(node.kind) { << s.visual_tick(id,now,reduced) or >> }
    if node.kind == SCREEN_PAGINATION { << s.tick_pagination(id,now,reduced) or >> }
    if node.kind == SCREEN_TREE {
        controls := mut &s.controls
        items := mut &controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        anim := screen_tick_tree(mut &item,now,reduced)
        items[id] = item
        << anim
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        anim := screen_tick_combo(mut &item,now,reduced)
        items[id] = item
        << anim
    }
    if node.kind == SCREEN_SPINNER {
        controls := mut &s.controls
        items := mut &controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        anim := screen_tick_spinner(mut &item,now,reduced)
        items[id] = item
        << anim
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        anim := screen_tick_editor(mut &item,now,reduced)
        items[id] = item
        << anim
    }
    << ScreenAnimation{changed: false,deadline: time.zero_instant()}
}

fn (s &mut Screen) control_popup(id int) layout.Rect {
    node := s.node(id) or >>
    if node.kind == SCREEN_MENU { owner := mut &s.controls
        entries := mut &owner.menus
        item := entries.take(id)
        result := item.popup_bounds()
        entries[id] = item
        << result }
    if node.kind == SCREEN_BREADCRUMBS { controls := mut &s.controls
        items := mut &controls.crumbs
        mut item := items.take(id)
        result := item.popup_bounds()
        items[id] = item
        << result }
    if screen_basic_kind(node.kind) { << s.basic_popup(id) or >> }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        mut result := screen_empty()
        if item.is_open() { result = item.popup_bounds() }
        items[id] = item
        << result
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        mut result := screen_empty()
        if item.is_open() { result = item.popup_bounds() }
        items[id] = item
        << result
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        mut result := screen_empty()
        if item.is_open() { result = item.popup_bounds() }
        items[id] = item
        << result
    }
    << screen_empty()
}

fn (s &mut Screen) control_popup_above(id int,above bool) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_BREADCRUMBS { controls := mut &s.controls
        items := mut &controls.crumbs
        mut item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0 }
    if screen_basic_kind(node.kind) { << s.basic_popup_above(id,above) or >> }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0
    }
    << 0
}

fn screen_crumbs_cursor(item &Breadcrumbs,x f64,y f64) int {
    << item.cursor_at(x,y) or (err) { << ui.CURSOR_DEFAULT }
}

fn (s &mut Screen) control_cursor(id int,x f64,y f64) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_RANGE_SLIDER { owner := mut &s.controls
        entries := mut &owner.ranges
        mut item := entries.take(id)
        mut cursor := ui.CURSOR_RESIZE_HORIZONTAL
        if item.options.vertical { cursor = ui.CURSOR_RESIZE_VERTICAL }
        entries[id] = item
        << cursor }
    if node.kind == SCREEN_SPLIT_VIEW { owner := mut &s.controls
        entries := mut &owner.splits
        mut item := entries.take(id)
        mut cursor := ui.CURSOR_RESIZE_HORIZONTAL
        if item.options.vertical { cursor = ui.CURSOR_RESIZE_VERTICAL }
        entries[id] = item
        << cursor }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := mut &s.controls
        items := mut &controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_crumbs_cursor(&item,x,y)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        mut result := ui.CURSOR_TEXT
        if item.toggle_bounds().contains(x,y) || (item.is_open() && item.popup_bounds().contains(x,y)) { result = ui.CURSOR_HAND }
        items[id] = item
        << result
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := ui.CURSOR_HAND
        items[id] = item
        << result
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := ui.CURSOR_HAND
        items[id] = item
        << result
    }
    << node.cursor
}

fn screen_combo_event(item &mut ComboBox,event &ui.Event) Action {
    << item.event(event) or (err) { << no_action(item.id(),false) }
}

fn (s &mut Screen) control_event(id int,event &ui.Event) Action {
    node := s.node(id) or >>
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_event(id,event) or >> }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_combo_event(mut &item,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := item.event(event) or (err) { << no_action(item.id,false) }
        items[id] = item
        << result
    }
    << no_action(id,false)
}

fn (s &mut Screen) control_enable(id int,enabled bool) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_WEBVIEW { << 0 }
    if screen_basic_kind(node.kind) { << s.basic_enable(id,enabled) or >> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_enable(id,enabled) or >> }
    if screen_visual_kind(node.kind) { << s.visual_enable(id,enabled) or >> }
    if node.kind == SCREEN_TABLE {
        controls := mut &s.controls
        items := mut &controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := mut &s.controls
        items := mut &controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := mut &s.controls
        items := mut &controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := mut &s.controls
        items := mut &controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        res := screen_combo_enable(mut &item,enabled)
        items[id] = item
        if res < 0 { >> errors.new("widgets: enable failed") }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := mut &s.controls
        items := mut &controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := mut &s.controls
        items := mut &controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := mut &s.controls
        items := mut &controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        res := screen_editor_enable(mut &item,enabled)
        items[id] = item
        if res < 0 { >> errors.new("widgets: enable failed") }
        << 0
    }
    << 0
}

fn screen_combo_enable(item &mut ComboBox,enabled bool) int {
    item.set_enabled(enabled) or (err) { << -1 }
    << 0
}

fn screen_editor_enable(item &mut Editor,enabled bool) int {
    item.enable(enabled) or (err) { << -1 }
    << 0
}

fn (s &mut Screen) control_dispose(id int) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_WEBVIEW { << s.web_dispose(id) or >> }
    if screen_basic_kind(node.kind) { << s.basic_dispose(id) or >> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_dispose(id) or >> }
    if screen_visual_kind(node.kind) { << s.visual_dispose(id) or >> }
    if node.kind == SCREEN_TABLE {
        controls := mut &s.controls
        items := mut &controls.tables
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := mut &s.controls
        items := mut &controls.trees
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := mut &s.controls
        items := mut &controls.pages
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := mut &s.controls
        items := mut &controls.crumbs
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := mut &s.controls
        items := mut &controls.colors
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := mut &s.controls
        items := mut &controls.clocks
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := mut &s.controls
        items := mut &controls.spinners
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        << 0
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { << 0 }
        mut item := items.take(id)
        item.dispose()
        << 0
    }
    << 0
}

