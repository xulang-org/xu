fn (s $&Screen) control_place(id int,bounds &layout.Rect) int {
    styles := s.styles_for(id)
    << s.control_place_styled(id,bounds,&styles) >>>
}

fn (s $&Screen) control_place_styled(id int,bounds &layout.Rect,styles &Styles) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { << s.custom_place(id,bounds) >>> }
    if node.kind == SCREEN_WEBVIEW { << 0 }
    if screen_basic_kind(node.kind) { << s.basic_place_styled(id,bounds,styles) >>> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_place_styled(id,bounds,styles) >>> }
    if screen_visual_kind(node.kind) { << s.visual_place_styled(id,bounds,styles) >>> }
    viewport := s.viewport()
    if node.kind == SCREEN_TABLE {
        controls := $&s.controls
        items := $&controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_table($&item,bounds,&viewport,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_tree($&item,bounds,&viewport,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := $&s.controls
        items := $&controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_pagination($&item,bounds,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := $&s.controls
        items := $&controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_crumbs($&item,bounds,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_combo($&item,bounds,&viewport,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := $&s.controls
        items := $&controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_multi($&item,bounds,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := $&s.controls
        items := $&controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_color($&item,bounds,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := $&s.controls
        items := $&controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_date($&item,bounds,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := $&s.controls
        items := $&controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_clock($&item,bounds,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := $&s.controls
        items := $&controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_spinner($&item,bounds,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if (node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT) {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_place_editor($&item,bounds,&viewport,styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    << 0
}

fn screen_input_table(item $&Table,route int,event &ui.InputEvent) RefinedResult {
    $result := refined_result()
    if route == ROUTE_INPUT { result.action = item.input(event) >>> (err) { << refined_failure(err.msg()) } }
    else { result.action = item.route(route,event) >>> (err) { << refined_failure(err.msg()) } }
    result.changed = item.needs_paint()
    << result
}

fn screen_input_tree(item $&TreeView,route int,event &ui.InputEvent) Action {
    if route == ROUTE_INPUT { << item.input(event) >>> (err) { << no_action(item.id(),false) } }
    << item.route(route,event) >>> (err) { << no_action(item.id(),false) }
}
fn screen_input_pagination(item $&Pagination,route int,event &ui.InputEvent) Action {
