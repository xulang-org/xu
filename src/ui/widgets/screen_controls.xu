        $item := items.take(id)
        result := screen_combo_event($&item,event)
        items[id] = item
        << result
    }
    if (node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT) {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := item.event(event) >>> (err) { << no_action(item.id,false) }
        items[id] = item
        << result
    }
    << no_action(id,false)
}

fn (s $&Screen) control_enable(id int,enabled bool) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { << s.custom_enable(id,enabled) >>> }
    if node.kind == SCREEN_WEBVIEW { << 0 }
    if screen_basic_kind(node.kind) { << s.basic_enable(id,enabled) >>> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_enable(id,enabled) >>> }
    if screen_visual_kind(node.kind) { << s.visual_enable(id,enabled) >>> }
    if node.kind == SCREEN_TABLE {
        controls := $&s.controls
        items := $&controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
