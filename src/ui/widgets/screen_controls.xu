pub fn (s &mut Screen) tree_add(id int,parent int,value string) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_TREE { >> errors.new("widgets: expected a screen tree") }
    controls := mut &s.controls
    items := mut &controls.trees
    if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
    mut item := items.take(id)
    result := screen_tree_add(mut &item,parent,&value)
    items[id] = item
    if result < 0 { >> errors.new("widgets: tree add failed") }
    s.invalidate()
    << result
}

