    if screen_visual_kind(node.kind) { << s.visual_dispose(id) >>> }
    if node.kind == SCREEN_TABLE {
        controls := $&s.controls
        items := $&controls.tables
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
