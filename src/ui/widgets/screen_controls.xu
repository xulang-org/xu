    << item.route(route,event) >>> (err) { << no_action(item.id(),false) }
}
fn screen_input_editor(item $&Editor,route int,event &ui.InputEvent) Action {
    $local := choice_copy_input(event)
    if route == ROUTE_INPUT {
        bounds := item.bounds()
        local.x = event.x - bounds.x
        local.y = event.y - bounds.y
    }
    << item.route(route,&local) >>> (err) { << no_action(item.id,false) }
}

fn (s $&Screen) control_input(id int,route int,event &ui.InputEvent) Action {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { << s.custom_input(id,route,event) }
    if node.kind == SCREEN_WEBVIEW { << s.web_input(id,route,event) >>> }
    if screen_basic_kind(node.kind) {
        if route==ROUTE_INPUT { quick := s.basic_typeahead(id,event) >>>
            if quick.consumed { << quick } }
        << s.basic_input(id,route,event) >>> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_input(id,route,event) >>> }
    if screen_visual_kind(node.kind) { << s.visual_input(id,route,event) >>> }
    if node.kind == SCREEN_TABLE {
        controls := $&s.controls
        items := $&controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_table($&item,route,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << result.action
    }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_tree($&item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_PAGINATION {
        controls := $&s.controls
        items := $&controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_pagination($&item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := $&s.controls
        items := $&controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_crumbs($&item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_combo($&item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_MULTI {
        controls := $&s.controls
        items := $&controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_multi($&item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_COLOR {
        controls := $&s.controls
        items := $&controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_color($&item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_DATE {
        controls := $&s.controls
        items := $&controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_date($&item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_CLOCK {
        controls := $&s.controls
        items := $&controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_clock($&item,route,event)
        items[id] = item
        << result
    }
    if (node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT) {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := screen_input_editor($&item,route,event)
        items[id] = item
        << result
    }
    << no_action(id,false)
}

fn screen_controls_pop(frame $&draw.Frame) {
    frame.pop() >>> (err) { << }
}
fn screen_controls_editor_paint(item $&Editor,frame $&draw.Frame,styles &Styles) int {
    bounds := item.bounds()
    frame.push() >>>
    frame.translate(bounds.x,bounds.y) >>> (err) { screen_controls_pop(frame)
        >> err }
    item.paint_styled(frame,styles) >>> (err) { screen_controls_pop(frame)
        >> err }
    << frame.pop() >>>
}
fn screen_controls_combo_paint(item $&ComboBox,frame $&draw.Frame,styles &Styles,popup bool) int {
    if popup { << item.paint_popup_styled(frame,styles) >>> }
    bounds := item.bounds()
    frame.push() >>>
    frame.translate(bounds.x,bounds.y) >>> (err) { screen_controls_pop(frame)
        >> err }
    item.paint_styled(frame,styles) >>> (err) { screen_controls_pop(frame)
        >> err }
    << frame.pop() >>>
}

fn screen_paint_table(item $&Table,frame $&draw.Frame,styles &Styles,popup bool) string {
    if popup { item.paint_popup_styled(frame,styles) >>> (err) { << err.msg() } }
    else { item.paint_styled(frame,styles) >>> (err) { << err.msg() } }
    << ""
}
fn screen_paint_tree(item $&TreeView,frame $&draw.Frame,styles &Styles,popup bool) string {
    if popup { item.paint_popup_styled(frame,styles) >>> (err) { << err.msg() } }
    else { item.paint_styled(frame,styles) >>> (err) { << err.msg() } }
    << ""
}
fn screen_paint_pagination(item $&Pagination,frame $&draw.Frame,styles &Styles,popup bool) string {
    if !popup { item.paint_styled(frame,styles) >>> (err) { << err.msg() } }
    << ""
}
