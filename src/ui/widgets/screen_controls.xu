    if node.kind == SCREEN_BREADCRUMBS {
        controls := $&s.controls
        items := $&controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.set_enabled(enabled)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        res := screen_combo_enable($&item,enabled)
        items[id] = item
        if res < 0 { >> errors.new("widgets: enable failed") }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := $&s.controls
        items := $&controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
