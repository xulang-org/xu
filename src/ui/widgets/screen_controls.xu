        $item := items.take(id)
        result := item.value()
        items[id] = item
        << result
    }
    if node.kind == SCREEN_CLOCK {
        controls := $&s.controls
        items := $&controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := item.value()
        items[id] = item
        << result
    }
    >> errors.new("widgets: value is not supported by this screen control")
}

fn screen_date_set_value(item $&DatePicker,value time.Time) int {
    item.set_value(value) >>> (err) { << -1 }
    << 0
}
fn screen_clock_set_value(item $&TimePicker,value time.Time) int {
    item.set_value(value) >>> (err) { << -1 }
    << 0
}

pub fn (s $&Screen) set_calendar_value(id int,value time.Time) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_DATE {
        controls := $&s.controls
        items := $&controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        res := screen_date_set_value($&item,value)
        items[id] = item
        if res < 0 { >> errors.new("widgets: set date failed") }
        s.invalidate()
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := $&s.controls
        items := $&controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        res := screen_clock_set_value($&item,value)
        items[id] = item
        if res < 0 { >> errors.new("widgets: set time failed") }
        s.invalidate()
        << 0
    }
    >> errors.new("widgets: operation is not supported by this screen control")
}

pub fn (s $&Screen) set_running(id int,running bool) int {
    node := s.node(id) >>>
    if node.kind != SCREEN_SPINNER { >> errors.new("widgets: expected a screen spinner") }
    controls := $&s.controls
    items := $&controls.spinners
    if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
    $item := items.take(id)
    item.set_running(running)
    items[id] = item
    s.invalidate()
    << 0
}

fn screen_page_set_count(item $&Pagination,pages int) int {
    item.set_page_count(pages) >>> (err) { << -1 }
    << 0
}

pub fn (s $&Screen) set_page_count(id int,pages int) int {
