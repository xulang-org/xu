fn (s $&Screen) control_dispose(id int) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { s.custom_dispose(id)
        << 0 }
    if node.kind == SCREEN_WEBVIEW { << s.web_dispose(id) >>> }
    if screen_basic_kind(node.kind) { << s.basic_dispose(id) >>> }
