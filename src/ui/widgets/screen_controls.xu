fn (s $&Screen) control_paint(id int,frame $&draw.Frame,styles &Styles,popup bool) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { << s.custom_paint(id,frame,styles,1.0,popup) >>> }
    if node.kind == SCREEN_SELECTABLE_TEXT || (node.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id)) {
        if popup { s.selectable_text_paint(id,frame,styles,1.0,true) >>> }
        << 0
    }
    if node.kind == SCREEN_WEBVIEW { if !popup { s.web_paint(id,frame,styles) >>> }
        << 0 }
    if screen_basic_kind(node.kind) { << s.basic_paint(id,frame,styles,popup) >>> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_paint(id,frame,styles,popup) >>> }
    if screen_visual_kind(node.kind) { << s.visual_paint(id,frame,styles,popup) >>> }
    if node.kind == SCREEN_TABLE {
        controls := $&s.controls
        items := $&controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_table($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_tree($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := $&s.controls
        items := $&controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_pagination($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := $&s.controls
        items := $&controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_crumbs($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_combo($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := $&s.controls
        items := $&controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_multi($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := $&s.controls
        items := $&controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_color($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := $&s.controls
        items := $&controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_date($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := $&s.controls
        items := $&controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_clock($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := $&s.controls
        items := $&controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_spinner($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if (node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT) {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        err_msg := screen_paint_editor($&item,frame,styles,popup)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    << 0
}

fn (s $&Screen) control_painted(id int) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { s.custom_painted(id)
        << 0 }
    if screen_basic_kind(node.kind) { << s.basic_painted(id) >>> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_painted(id) >>> }
    if screen_visual_kind(node.kind) { << s.visual_painted(id) >>> }
    if node.kind == SCREEN_TABLE {
        controls := $&s.controls
        items := $&controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := $&s.controls
        items := $&controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := $&s.controls
        items := $&controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.control.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        editor := $&item.editor
        editor.painted()
        item.choices.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := $&s.controls
        items := $&controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.control.dirty = false
        item.choices.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := $&s.controls
        items := $&controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.control.dirty = false
        for i in 0:4 { $channel := item.channels[i]
            channel.painted()
            item.channels[i] = channel }
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := $&s.controls
        items := $&controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.control.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := $&s.controls
        items := $&controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.control.dirty = false
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := $&s.controls
        items := $&controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.dirty = false
        items[id] = item
        << 0
    }
    if (node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT) {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.painted()
        items[id] = item
        << 0
    }
    << 0
}

fn screen_tick_combo(item $&ComboBox,now time.Instant,reduced bool) ScreenAnimation {
    changed := item.tick(now,reduced) >>> (err) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    deadline := item.next_caret_tick(now,reduced) >>> (err) { << ScreenAnimation{changed: changed,deadline: time.zero_instant()} }
    << ScreenAnimation{changed: changed,deadline: deadline}
}

fn screen_tick_spinner(item $&Spinner,now time.Instant,reduced bool) ScreenAnimation {
    changed := item.tick(now,reduced) >>> (err) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    deadline := item.next_tick(now,reduced) >>> (err) { << ScreenAnimation{changed: changed,deadline: time.zero_instant()} }
    << ScreenAnimation{changed: changed,deadline: deadline}
}

fn screen_tick_editor(item $&Editor,now time.Instant,reduced bool) ScreenAnimation {
    changed := item.tick(now,reduced) >>> (err) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    deadline := item.next_caret_tick(now,reduced) >>> (err) { << ScreenAnimation{changed: changed,deadline: time.zero_instant()} }
    << ScreenAnimation{changed: changed,deadline: deadline}
}

fn (s $&Screen) control_tick(id int,now time.Instant,reduced bool) ScreenAnimation {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { << s.custom_tick(id,now,reduced) >>> }
    if screen_basic_kind(node.kind) { << s.basic_tick(id,now,reduced) >>> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_tick(id,now,reduced) >>> }
    if screen_visual_kind(node.kind) { << s.visual_tick(id,now,reduced) >>> }
    if node.kind == SCREEN_PAGINATION { << s.tick_pagination(id,now,reduced) >>> }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        anim := screen_tick_tree($&item,now,reduced)
        items[id] = item
        << anim
    }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        anim := screen_tick_combo($&item,now,reduced)
        items[id] = item
        << anim
    }
    if node.kind == SCREEN_SPINNER {
        controls := $&s.controls
        items := $&controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        anim := screen_tick_spinner($&item,now,reduced)
        items[id] = item
        << anim
    }
    if (node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT) {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        anim := screen_tick_editor($&item,now,reduced)
        items[id] = item
        << anim
    }
    << ScreenAnimation{changed: false,deadline: time.zero_instant()}
}

fn (s &Screen) control_popup(id int) layout.Rect {
    node := s.node(id) >>>
    if node.kind == SCREEN_SELECTABLE_TEXT || (node.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id)) {
        << s.selectable_text_popup(id)
    }
    if node.kind == SCREEN_FIELD { << s.refined_popup(id) >>> }
    if node.kind == SCREEN_MENU && s.controls.menus.has(id) { << s.controls.menus[id].popup_bounds() }
    if node.kind == SCREEN_BREADCRUMBS && s.controls.crumbs.has(id) { << s.controls.crumbs[id].popup_bounds() }
    if screen_basic_kind(node.kind) { << s.basic_popup(id) >>> }
    if node.kind == SCREEN_TABLE {
        if !s.controls.tables.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        item := &s.controls.tables[id]
        if item.has_popup_open() { << item.popup_bounds() }
        << screen_empty()
    }
    if node.kind == SCREEN_TREE {
        if !s.controls.trees.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        item := &s.controls.trees[id]
        if item.has_popup_open() { << item.popup_bounds() }
        << screen_empty()
    }
    if node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT {
        if !s.controls.editors.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        item := &s.controls.editors[id]
        if item.has_popup_open() { << item.popup_bounds() }
        << screen_empty()
    }
    if node.kind == SCREEN_COMBO {
        if !s.controls.combos.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        item := &s.controls.combos[id]
        if item.has_popup_open() { << item.popup_bounds() }
        << screen_empty()
    }
    if node.kind == SCREEN_MULTI {
        if !s.controls.multis.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        item := &s.controls.multis[id]
        if item.is_open() { << item.popup_bounds() }
        << screen_empty()
    }
    if node.kind == SCREEN_DATE {
        if !s.controls.dates.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        item := &s.controls.dates[id]
        if item.is_open() { << item.popup_bounds() }
        << screen_empty()
    }
    << screen_empty()
}

fn (s $&Screen) control_popup_above(id int,above bool) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_BREADCRUMBS { controls := $&s.controls
        items := $&controls.crumbs
        $item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0 }
    if screen_basic_kind(node.kind) { << s.basic_popup_above(id,above) >>> }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := $&s.controls
        items := $&controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := $&s.controls
        items := $&controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        item.set_popup_above(above)
        items[id] = item
        << 0
    }
    << 0
}

fn screen_crumbs_cursor(item &Breadcrumbs,x f64,y f64) int {
    << item.cursor_at(x,y) >>> (err) { << ui.CURSOR_DEFAULT }
}

fn (s $&Screen) control_cursor(id int,x f64,y f64) int {
    node := s.node(id) >>>
    if node.kind == SCREEN_CUSTOM { << s.custom_cursor(id,x,y) }
    if node.kind == SCREEN_BUTTON {
        $item := s.take_button(id)
        cur := item.cursor_at(x,y)
        s.buttons[id] = item
        << cur
    }
    if node.kind == SCREEN_SELECTABLE_TEXT || (node.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id)) {
        << s.selectable_text_cursor_at(id,x,y)
    }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_cursor(id,x,y) >>> }
    if node.kind == SCREEN_CHECKBOX {
        owner := $&s.basics
        items := $&owner.checks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_SWITCH {
        owner := $&s.basics
        items := $&owner.switches
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_RADIO {
        owner := $&s.basics
        items := $&owner.radios
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_SLIDER {
        owner := $&s.basics
        items := $&owner.sliders
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_STEPPER {
        owner := $&s.basics
        items := $&owner.steppers
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_TABS {
        owner := $&s.basics
        items := $&owner.tabs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_SELECT {
        owner := $&s.basics
        items := $&owner.selects
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_LIST {
        owner := $&s.basics
        items := $&owner.lists
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := item.cursor_at(x,y)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_RADIO_GROUP {
        owner := $&s.basics
        items := $&owner.groups
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_CARD && s.basics.scrolls.has(id) {
        owner := $&s.basics
        items := $&owner.scrolls
        $item := items.take(id)
        cur := item.cursor_at(x,y)
        items[id] = item
        << cur
    }
    if node.kind == SCREEN_TABLE {
        controls := $&s.controls
        items := $&controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := item.cursor_at(x,y)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_TREE {
        controls := $&s.controls
        items := $&controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := item.cursor_at(x,y)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := items.take(id)
        result := item.cursor_at(x,y)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_RANGE_SLIDER {
        owner := $&s.controls
        entries := $&owner.ranges
        if !entries.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        $item := entries.take(id)
