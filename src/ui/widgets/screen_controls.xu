// A secret input has the same editing behavior as input; tooling must redact
// its value and bounds. This flag follows the node for its entire lifetime.
pub fn (s $&Screen) secret_input(value string) int {
    id := s.input(value) >>>
    s.nodes[id - 1].kind = SCREEN_SECRET_INPUT
    s.set_secure(id,true) >>>
    << id
}

// Mark password/secure controls (including application-defined controls) for
// screenshot and accessibility export redaction.
pub fn (s $&Screen) set_secure(id int,secure bool) int {
    _ := s.node(id) >>>
    s.nodes[id - 1].secure = secure
    << 0
}

