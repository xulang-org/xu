    << item.route(route,event) or (err) { << no_action(item.id(),false) }
}
fn screen_input_editor(item &mut Editor,route int,event &ui.InputEvent) Action {
    mut local := choice_copy_input(event)
    if route == ROUTE_INPUT {
        bounds := item.bounds()
        local.x = event.x - bounds.x
        local.y = event.y - bounds.y
    }
    << item.route(route,&local) or (err) { << no_action(item.id,false) }
}

fn (s &mut Screen) control_input(id int,route int,event &ui.InputEvent) Action {
    node := s.node(id) or >>
    if node.kind == SCREEN_WEBVIEW { << s.web_input(id,route,event) or >> }
    if screen_basic_kind(node.kind) {
        if route==ROUTE_INPUT { quick := s.basic_typeahead(id,event) or >>
            if quick.consumed { << quick } }
        << s.basic_input(id,route,event) or >> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_input(id,route,event) or >> }
    if screen_visual_kind(node.kind) { << s.visual_input(id,route,event) or >> }
    if node.kind == SCREEN_TABLE {
        controls := mut &s.controls
        items := mut &controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_table(mut &item,route,event)
        items[id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        << result.action
    }
    if node.kind == SCREEN_TREE {
        controls := mut &s.controls
        items := mut &controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_tree(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_PAGINATION {
        controls := mut &s.controls
        items := mut &controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_pagination(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := mut &s.controls
        items := mut &controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_crumbs(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_combo(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_multi(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_COLOR {
        controls := mut &s.controls
        items := mut &controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_color(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_date(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_CLOCK {
        controls := mut &s.controls
        items := mut &controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_clock(mut &item,route,event)
        items[id] = item
        << result
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        result := screen_input_editor(mut &item,route,event)
        items[id] = item
        << result
    }
    << no_action(id,false)
}

fn screen_controls_pop(frame &mut draw.Frame) {
    frame.pop() or (err) { << }
}
fn screen_controls_editor_paint(item &mut Editor,frame &mut draw.Frame,styles &Styles) int {
    bounds := item.bounds()
    frame.push() or >>
    frame.translate(bounds.x,bounds.y) or (err) { screen_controls_pop(frame)
        >> err }
    item.paint_styled(frame,styles) or (err) { screen_controls_pop(frame)
        >> err }
    << frame.pop() or >>
}
fn screen_controls_combo_paint(item &mut ComboBox,frame &mut draw.Frame,styles &Styles,popup bool) int {
    if popup { << item.paint_popup_styled(frame,styles) or >> }
    bounds := item.bounds()
    frame.push() or >>
    frame.translate(bounds.x,bounds.y) or (err) { screen_controls_pop(frame)
        >> err }
    item.paint_styled(frame,styles) or (err) { screen_controls_pop(frame)
        >> err }
    << frame.pop() or >>
}

fn screen_paint_table(item &mut Table,frame &mut draw.Frame,styles &Styles,popup bool) string {
    if !popup { item.paint_styled(frame,styles) or (err) { << err.msg() } }
    << ""
}
