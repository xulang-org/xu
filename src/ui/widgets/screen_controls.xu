        $item := items.take(id)
        res := screen_page_set_count($&item,pages)
        items[id] = item
        if res < 0 { >> errors.new("widgets: set page count failed") }
        s.invalidate()
        << 0
    }
    >> errors.new("widgets: operation is not supported by this screen control")
}

fn screen_date_set_range(item $&DatePicker,minimum time.Time,maximum time.Time) int {
    item.set_range(minimum,maximum) >>> (err) { << -1 }
    << 0
