    else { item.paint_styled(frame,styles) or (err) { << err.msg() } }
    << ""
}
fn screen_paint_combo(item &mut ComboBox,frame &mut draw.Frame,styles &Styles,popup bool) string {
    screen_controls_combo_paint(item,frame,styles,popup) or (err) { << err.msg() }
    << ""
}
