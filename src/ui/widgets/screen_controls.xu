fn screen_place_table(item $&Table,bounds &layout.Rect,viewport &layout.Rect,styles &Styles) string {
    item.set_viewport(viewport)
    item.set_bounds(bounds) >>> (err) { << err.msg() }
    item.apply_styles(styles) >>> (err) { << err.msg() }
    << ""
}
