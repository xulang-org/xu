        items := $&controls.crumbs
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := $&s.controls
        items := $&controls.multis
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := $&s.controls
        items := $&controls.colors
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := $&s.controls
        items := $&controls.dates
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := $&s.controls
        items := $&controls.clocks
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := $&s.controls
        items := $&controls.spinners
        if !items.has(id) { << 0 }
        $item := items.take(id)
        << 0
    }
    if (node.kind == SCREEN_EDITOR || node.kind == SCREEN_SECRET_INPUT) {
        controls := $&s.controls
        items := $&controls.editors
        if !items.has(id) { << 0 }
        $item := items.take(id)
        item.dispose()
        << 0
    }
    << 0
}

