fn (s &mut Screen) control_place(id int,bounds &layout.Rect) int {
    node := s.node(id) or >>
    if node.kind == SCREEN_WEBVIEW { << 0 }
    if screen_basic_kind(node.kind) { << s.basic_place(id,bounds) or >> }
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_place(id,bounds) or >> }
    if screen_visual_kind(node.kind) { << s.visual_place(id,bounds) or >> }
    styles := s.styles.clone()
    if node.kind == SCREEN_TABLE {
        controls := mut &s.controls
        items := mut &controls.tables
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_table(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_TREE {
        controls := mut &s.controls
        items := mut &controls.trees
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_tree(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_PAGINATION {
        controls := mut &s.controls
        items := mut &controls.pages
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_pagination(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_BREADCRUMBS {
        controls := mut &s.controls
        items := mut &controls.crumbs
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_crumbs(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COMBO {
        controls := mut &s.controls
        items := mut &controls.combos
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_combo(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_MULTI {
        controls := mut &s.controls
        items := mut &controls.multis
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_multi(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_COLOR {
        controls := mut &s.controls
        items := mut &controls.colors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_color(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_DATE {
        controls := mut &s.controls
        items := mut &controls.dates
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_date(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_CLOCK {
        controls := mut &s.controls
        items := mut &controls.clocks
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_clock(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_SPINNER {
        controls := mut &s.controls
        items := mut &controls.spinners
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_spinner(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    if node.kind == SCREEN_EDITOR {
        controls := mut &s.controls
        items := mut &controls.editors
        if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
        mut item := items.take(id)
        err_msg := screen_place_editor(mut &item,bounds,&styles)
        items[id] = item
        if err_msg != "" { >> errors.new(err_msg) }
        << 0
    }
    << 0
}

fn screen_input_table(item &mut Table,route int,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    if route == ROUTE_INPUT { result.action = item.input(event) or (err) { << refined_failure(err.msg()) } }
    else { result.action = item.route(route,event) or (err) { << refined_failure(err.msg()) } }
    result.changed = item.needs_paint()
    << result
}

fn screen_input_tree(item &mut TreeView,route int,event &ui.InputEvent) Action {
    if route == ROUTE_INPUT { << item.input(event) or (err) { << no_action(item.id(),false) } }
    << item.route(route,event) or (err) { << no_action(item.id(),false) }
}
