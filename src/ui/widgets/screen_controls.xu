}

fn (s $&Screen) control_event(id int,event &ui.Event) Action {
    node := s.node(id) >>>
    if node.kind == SCREEN_FIELD || node.kind == SCREEN_TASK { << s.refined_event(id,event) >>> }
    if node.kind == SCREEN_COMBO {
        controls := $&s.controls
        items := $&controls.combos
