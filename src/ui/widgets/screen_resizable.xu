@ui/widgets

#ui
#ui/layout
#errors
#math

pub const ACTION_RESIZE_HANDLE = 29

pub const RESIZE_EDGE_LEFT = 1
pub const RESIZE_EDGE_RIGHT = 2
pub const RESIZE_EDGE_TOP = 4
pub const RESIZE_EDGE_BOTTOM = 8
pub const RESIZE_EDGE_ALL = 15

pub struct ResizableConfig {
    pub edges int
    pub handle_thickness f64
    pub min_width f64
    pub max_width f64
    pub min_height f64
    pub max_height f64
}

pub fn resizable_config(edges int) ResizableConfig {
    << ResizableConfig{
        edges: edges,
        handle_thickness: 6.0,
        min_width: 60.0,
        max_width: 4096.0,
        min_height: 40.0,
        max_height: 4096.0
    }
}

pub fn (c &ResizableConfig) validate() int {
    if c.edges < 0 || c.edges > RESIZE_EDGE_ALL {
        >>> errors.new("widgets: invalid resizable edge bitmask")
    }
    if math.is_nan(c.handle_thickness) || math.is_inf(c.handle_thickness) || c.handle_thickness < 2.0 || c.handle_thickness > 32.0 ||
       math.is_nan(c.min_width) || math.is_inf(c.min_width) || c.min_width < 0.0 ||
       math.is_nan(c.max_width) || math.is_inf(c.max_width) || c.max_width < c.min_width ||
       math.is_nan(c.min_height) || math.is_inf(c.min_height) || c.min_height < 0.0 ||
       math.is_nan(c.max_height) || math.is_inf(c.max_height) || c.max_height < c.min_height {
        >>> errors.new("widgets: invalid resizable bounds config")
    }
    << 0
}

fn copy_resizable_config(c &ResizableConfig) ResizableConfig {
    << ResizableConfig{
        edges: c.edges,
        handle_thickness: c.handle_thickness,
        min_width: c.min_width,
        max_width: c.max_width,
        min_height: c.min_height,
        max_height: c.max_height
    }
}

pub fn (s $&Screen) set_resizable(id int,cfg &ResizableConfig) int {
    _ := s.node(id) >>>
    cfg.validate() >>>
    if cfg.edges == 0 { << s.clear_resizable(id) >>> }
    comp := $&s.composition
    rz := $&comp.resizables
    had := rz.has(id)
    rz[id] = copy_resizable_config(cfg)
    if !had {
        rids := $&comp.resizable_ids
        rids.push(id)
        comp.resizable_count = comp.resizable_count + 1
    }
    << 0
}

pub fn (s $&Screen) clear_resizable(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.resizables.has(id) {
        rz := $&comp.resizables
        rz.delete(id)
        next := vec_without(&comp.resizable_ids,id)
        comp.resizable_ids = next
        if comp.resizable_count > 0 { comp.resizable_count = comp.resizable_count - 1 }
    }
    if comp.resize_active_node == id { comp.resize_active_node = 0 }
    << 0
}

pub fn (s &Screen) is_resizable(id int) bool {
    _ := s.node(id) >>>
    << s.composition.resizable_count > 0 && s.composition.resizables.has(id)
}

pub fn (s &Screen) is_resizing_panel() bool {
    << s.composition.resize_active_node > 0
}

struct ResizeEdgeHit {
    node int
    edges int
}

fn (s &Screen) hit_resize_edge_at(x f64,y f64,modal int) ResizeEdgeHit {
    if s.composition.resizable_count == 0 { << ResizeEdgeHit{node: 0,edges: 0} }
    rids := &s.composition.resizable_ids
    $i := rids.len - 1
    while i >= 0 {
        nid := rids[i]
        if nid > 0 && nid <= s.nodes.len && s.nodes[nid - 1].kind >= 0 &&
           s.composition.resizables.has(nid) && s.is_visible(nid) && s.effective_enabled(nid) && s.in_modal(nid,modal) {
            cfg := &s.composition.resizables[nid]
            b := s.nodes[nid - 1].bounds
            t := cfg.handle_thickness
            if x >= b.x - t && x <= b.x + b.width + t && y >= b.y - t && y <= b.y + b.height + t {
                $edge_hit := 0
                if (cfg.edges & RESIZE_EDGE_LEFT) != 0 && math.abs(x - b.x) <= t { edge_hit = edge_hit | RESIZE_EDGE_LEFT }
                if (cfg.edges & RESIZE_EDGE_RIGHT) != 0 && math.abs(x - (b.x + b.width)) <= t { edge_hit = edge_hit | RESIZE_EDGE_RIGHT }
                if (cfg.edges & RESIZE_EDGE_TOP) != 0 && math.abs(y - b.y) <= t { edge_hit = edge_hit | RESIZE_EDGE_TOP }
                if (cfg.edges & RESIZE_EDGE_BOTTOM) != 0 && math.abs(y - (b.y + b.height)) <= t { edge_hit = edge_hit | RESIZE_EDGE_BOTTOM }
                if edge_hit != 0 {
                    << ResizeEdgeHit{node: nid,edges: edge_hit}
                }
            }
        }
        i -= 1
    }
    << ResizeEdgeHit{node: 0,edges: 0}
}

fn resize_cursor_for_edges(edges int) int {
    if (edges & (RESIZE_EDGE_LEFT | RESIZE_EDGE_RIGHT)) != 0 {
        << ui.CURSOR_RESIZE_HORIZONTAL
    }
    if (edges & (RESIZE_EDGE_TOP | RESIZE_EDGE_BOTTOM)) != 0 {
        << ui.CURSOR_RESIZE_VERTICAL
    }
    << ui.CURSOR_DEFAULT
}

fn (s $&Screen) reset_resizable_silently() {
    comp := $&s.composition
    comp.resize_active_node = 0
    comp.resize_active_edges = 0
}

fn (s $&Screen) resizable_handle_pointer(input &ui.InputEvent,modal int,actions $&[]Action) bool {
    if s.composition.resizable_count == 0 && s.composition.resize_active_node == 0 { << false }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        hit := s.hit_resize_edge_at(input.x,input.y,modal)
        if hit.node <= 0 { << false }
        nl := s.nodes[hit.node - 1].local
        comp := $&s.composition
        comp.resize_active_node = hit.node
        comp.resize_active_edges = hit.edges
        comp.resize_start_x = input.x
        comp.resize_start_y = input.y
        comp.resize_orig_rect = layout.Rect{x: nl.x,y: nl.y,width: nl.width,height: nl.height}
        s.pointer_cursor(resize_cursor_for_edges(hit.edges)) >>>
        << true
    }
    if input.kind == ui.EV_POINTER_MOVE {
        if s.composition.resize_active_node > 0 {
            nid := s.composition.resize_active_node
            if nid > s.nodes.len || s.nodes[nid - 1].kind < 0 || !s.composition.resizables.has(nid) {
                s.reset_resizable_silently()
                << false
            }
            cfg := copy_resizable_config(&s.composition.resizables[nid])
            edges := s.composition.resize_active_edges
            orig := s.composition.resize_orig_rect
            dx := input.x - s.composition.resize_start_x
            dy := input.y - s.composition.resize_start_y
            $nx := orig.x
            $ny := orig.y
            $nw := orig.width
            $nh := orig.height
            if (edges & RESIZE_EDGE_RIGHT) != 0 {
                nw = math.max(cfg.min_width,math.min(cfg.max_width,orig.width + dx))
            }
            if (edges & RESIZE_EDGE_LEFT) != 0 {
                cw := math.max(cfg.min_width,math.min(cfg.max_width,orig.width - dx))
                nx = orig.x + (orig.width - cw)
                nw = cw
            }
            if (edges & RESIZE_EDGE_BOTTOM) != 0 {
                nh = math.max(cfg.min_height,math.min(cfg.max_height,orig.height + dy))
            }
            if (edges & RESIZE_EDGE_TOP) != 0 {
                ch := math.max(cfg.min_height,math.min(cfg.max_height,orig.height - dy))
                ny = orig.y + (orig.height - ch)
                nh = ch
            }
            s.nodes[nid - 1].local = layout.Rect{x: nx,y: ny,width: nw,height: nh}
            s.nodes[nid - 1].bounds = layout.Rect{x: nx,y: ny,width: nw,height: nh}
            if s.composition.items.has(nid) {
                _ := s.set_item_size(nid,nw,nh) >>> (err) { << false }
            } else {
                parent := s.nodes[nid - 1].parent
                if parent > 0 && s.composition.containers.has(parent) {
                    _ := s.set_item_size(nid,nw,nh) >>> (err) { << false }
                }
            }
            s.mark_layout_dirty()
            s.layout_controls() >>>
            actions.push(Action{kind: ACTION_RESIZE_HANDLE,id: nid,needs_paint: true,request_focus: false,consumed: true,value: nw})
            << true
        }
        hit := s.hit_resize_edge_at(input.x,input.y,modal)
        if hit.node > 0 {
            s.pointer_cursor(resize_cursor_for_edges(hit.edges)) >>>
            << true
        }
        << false
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && s.composition.resize_active_node > 0 {
        s.reset_resizable_silently()
        s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
        << true
    }
    << false
}

fn (s $&Screen) cleanup_resizable_for(id int) {
    comp := $&s.composition
    if comp.resizables.has(id) {
        rz := $&comp.resizables
        rz.delete(id)
        next := vec_without(&comp.resizable_ids,id)
        comp.resizable_ids = next
        if comp.resizable_count > 0 { comp.resizable_count = comp.resizable_count - 1 }
    }
    if comp.resize_active_node == id {
        comp.resize_active_node = 0
        comp.resize_active_edges = 0
    }
}
