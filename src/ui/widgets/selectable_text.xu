@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#unicode/utf8

pub struct SelectableText {
    id_val int
    identity ui.CanvasEvent
    context draw.Context
    bounds_val layout.Rect
    label StyledLabel
    selection TextSelectionEngine
    menus map[int]TextContextMenu
    cached_locale []Locale
    cached_viewport []layout.Rect
    custom ScalarControlStyle
    wrapped bool
    ellipsis bool
    muted bool
    enabled bool
    copy_enabled bool
    focused bool
    hovered bool
    dirty bool
    closed bool
    cached_styles []Styles
}

pub fn selectable_text(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,text &string) SelectableText {
    if !valid_identity(identity) || !context.matches_canvas(identity) || id <= 0 || !utf8.valid(text) {
        >>> errors.new("widgets: invalid SelectableText identity or text")
    }
    validate_bounds(bounds) >>>
    << SelectableText{
        id_val: id,
        identity: copy_identity(identity),
        context: context.clone(),
        bounds_val: copy_rect(bounds),
        label: styled_label(context,text),
        selection: text_selection_engine(true),
        menus: map[int]TextContextMenu{},
        cached_locale: []Locale{},
        cached_viewport: []layout.Rect{},
        custom: empty_scalar_style(),
        wrapped: false,
        ellipsis: false,
        muted: false,
        enabled: true,
        copy_enabled: true,
        focused: false,
        hovered: false,
        dirty: true,
        closed: false,
        cached_styles: []Styles{}
    }
}

fn (s &SelectableText) style_snapshot() Styles {
    if s.cached_styles.len > 0 { << s.cached_styles[0].clone() }
    << dark_styles()
}
fn (s $&SelectableText) set_styles_cache(styles &Styles) {
    if s.cached_styles.len == 0 { s.cached_styles.push(styles.clone()) }
    else { s.cached_styles[0] = styles.clone() }
}
fn (s $&SelectableText) take_menu() TextContextMenu {
    s.ensure_menu()
    if true {
        menus := $&s.menus
        << menus.take(0) >>> (err) {
            ctx := s.context.clone()
            idn := copy_identity(&s.identity)
            << text_context_menu(&ctx,&idn,s.id_val)
        }
    }
    ctx := s.context.clone()
    idn := copy_identity(&s.identity)
    << text_context_menu(&ctx,&idn,s.id_val)
}
fn (s $&SelectableText) put_menu(m TextContextMenu) {
    menus := $&s.menus
    menus[0] = m
}
fn st_menu_set_locale(m $&TextContextMenu,locale &Locale) bool {
    _ := m.set_locale(locale) >>> (err) { << false }
    << true
}
fn (s $&SelectableText) ensure_menu() {
    if s.menus.has(0) { << }
    ctx := s.context.clone()
    idn := copy_identity(&s.identity)
    $m := text_context_menu(&ctx,&idn,s.id_val)
    if s.cached_locale.len > 0 {
        loc := s.cached_locale[0].clone()
        _ := st_menu_set_locale($&m,&loc)
    }
    if s.cached_viewport.len > 0 {
        vp := copy_rect(&s.cached_viewport[0])
        m.set_viewport(&vp)
    }
    s.menus[0] = m
}
fn (s $&SelectableText) close_menu() {
    if !s.menus.has(0) { << }
    $m := s.take_menu()
    m_ref := $&m
    _ := m_ref.close()
    s.put_menu(m)
}

pub fn (s &SelectableText) id() int { << s.id_val }
pub fn (s &SelectableText) identity() ui.CanvasEvent { << copy_identity(&s.identity) }
pub fn (s &SelectableText) bounds() layout.Rect { << copy_rect(&s.bounds_val) }
pub fn (s &SelectableText) text() string { << s.label.text() }
pub fn (s &SelectableText) is_closed() bool { << s.closed }
pub fn (s &SelectableText) is_focused() bool { << s.focused }
pub fn (s &SelectableText) is_selecting() bool { << s.selection.selecting }
pub fn (s &SelectableText) is_hovered() bool { << s.hovered }
pub fn (s &SelectableText) is_enabled() bool { << s.enabled && !s.closed && s.bounds_val.width > 0.0 && s.bounds_val.height > 0.0 }
pub fn (s &SelectableText) is_selectable() bool { << s.selection.selectable }
pub fn (s &SelectableText) needs_paint() bool { << s.dirty || (s.menus.has(0) && s.menus[0].needs_paint()) }
pub fn (s &SelectableText) has_popup_open() bool { << s.menus.has(0) && s.menus[0].is_open() }
pub fn (s &SelectableText) popup_bounds() layout.Rect {
    if !s.menus.has(0) { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
    << s.menus[0].popup_bounds()
}
pub fn (s &SelectableText) cursor() int {
    if s.selection.selectable && s.enabled && !s.closed { << ui.CURSOR_TEXT }
    << ui.CURSOR_DEFAULT
}
pub fn (s &SelectableText) has_selection() bool { << s.selection.has_selection() }
pub fn (s &SelectableText) selection_range() ui.TextRange { << s.selection.range(s.label.value.len) }
pub fn (s &SelectableText) selected_text() string {
    if !s.copy_enabled { << "" }
    << s.selection.selected_text(&s.label.value)
}

pub fn (s $&SelectableText) painted() {
    s.dirty = false
    if s.menus.has(0) {
        $m := s.take_menu()
        m_ref := $&m
        m_ref.painted()
        s.put_menu(m)
    }
}

pub fn (s $&SelectableText) close() {
    s.closed = true
    s.focused = false
    s.hovered = false
    if true {
        sel := $&s.selection
        _ := sel.clear()
    }
    s.close_menu()
}

pub fn (s $&SelectableText) dispose() {
    s.close()
    if true {
        label := $&s.label
        label.dispose()
    }
    if s.menus.has(0) {
        $m := s.take_menu()
        m_ref := $&m
        m_ref.dispose()
        s.put_menu(m)
    }
}

pub fn (s &SelectableText) clone_widget() SelectableText {
    ctx := s.context.clone()
    text := s.label.text()
    $next := styled_label(&ctx,&text)
    styles := s.style_snapshot()
    if s.label.has_style() {
        fallback := styles.button.clone()
        st := s.label.style_or(&fallback)
        next.set_style(&st) >>>
    }
    $cloned_menus := map[int]TextContextMenu{}
    if s.menus.has(0) { cloned_menus[0] = s.menus[0].clone_menu() }
    $cloned_loc := []Locale{}
    if s.cached_locale.len > 0 { cloned_loc.push(s.cached_locale[0].clone()) }
    $cloned_vp := []layout.Rect{}
    if s.cached_viewport.len > 0 { cloned_vp.push(copy_rect(&s.cached_viewport[0])) }
    $cloned_styles := []Styles{}
    if s.cached_styles.len > 0 { cloned_styles.push(s.cached_styles[0].clone()) }
    << SelectableText{
        id_val: s.id_val,
        identity: copy_identity(&s.identity),
        context: ctx,
        bounds_val: copy_rect(&s.bounds_val),
        label: next,
        selection: s.selection,
        menus: cloned_menus,
        cached_locale: cloned_loc,
        cached_viewport: cloned_vp,
        custom: copy_scalar_style(&s.custom),
        wrapped: s.wrapped,
        ellipsis: s.ellipsis,
        muted: s.muted,
        enabled: s.enabled,
        copy_enabled: s.copy_enabled,
        focused: s.focused,
        hovered: s.hovered,
        dirty: s.dirty,
        closed: s.closed,
        cached_styles: cloned_styles
    }
}

pub fn (s $&SelectableText) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) >>>
    if s.bounds_val.x != bounds.x || s.bounds_val.y != bounds.y || s.bounds_val.width != bounds.width || s.bounds_val.height != bounds.height {
        s.bounds_val = copy_rect(bounds)
        s.dirty = true
    }
    << 0
}

pub fn (s $&SelectableText) set_text(text &string) int {
    if !utf8.valid(text) { >>> errors.new("widgets: invalid UTF-8 SelectableText value") }
    if s.label.value != text + "" {
        if true {
            label := $&s.label
            label.set_text(text)
        }
        if true {
            sel := $&s.selection
            _ := sel.clear()
        }
        s.close_menu()
        s.dirty = true
    }
    << 0
}

pub fn (s $&SelectableText) set_wrapped(wrapped bool) {
    if s.wrapped != wrapped {
        s.wrapped = wrapped
        s.dirty = true
    }
}

pub fn (s $&SelectableText) set_ellipsis(ellipsis bool) {
    if s.ellipsis != ellipsis {
        s.ellipsis = ellipsis
        s.dirty = true
    }
}

pub fn (s $&SelectableText) set_muted(muted bool) {
    if s.muted != muted {
        s.muted = muted
        s.dirty = true
    }
}

pub fn (s $&SelectableText) set_enabled(enabled bool) {
    if s.enabled != enabled {
        s.enabled = enabled
        if !enabled {
            s.focused = false
            s.hovered = false
            if true {
                sel := $&s.selection
                _ := sel.clear()
            }
            s.close_menu()
        }
        s.dirty = true
    }
}

pub fn (s $&SelectableText) set_selectable(selectable bool) {
    $changed := false
    if true {
        sel := $&s.selection
        changed = sel.set_selectable(selectable)
    }
    if changed {
        if !selectable {
            s.focused = false
            s.close_menu()
        }
        s.dirty = true
    }
}

pub fn (s &SelectableText) is_copy_enabled() bool { << s.copy_enabled }

pub fn (s $&SelectableText) set_copy_enabled(on bool) {
    if s.copy_enabled == on { << }
    s.copy_enabled = on
    if !on { s.close_menu() }
    s.dirty = true
}

pub fn (s $&SelectableText) set_locale(locale &Locale) int {
    locale.validate() >>>
    if s.cached_locale.len == 0 { s.cached_locale.push(locale.clone()) }
    else { s.cached_locale[0] = locale.clone() }
    if s.menus.has(0) {
        $m := s.take_menu()
        ok := st_menu_set_locale($&m,locale)
        s.put_menu(m)
        if !ok { >>> errors.new("widgets: invalid locale") }
    }
    << 0
}

pub fn (s $&SelectableText) set_viewport(viewport &layout.Rect) {
    if s.cached_viewport.len == 0 { s.cached_viewport.push(copy_rect(viewport)) }
    else { s.cached_viewport[0] = copy_rect(viewport) }
    if s.menus.has(0) {
        $m := s.take_menu()
        m_ref := $&m
        m_ref.set_viewport(viewport)
        s.put_menu(m)
    }
}

pub fn (s $&SelectableText) select_all() bool {
    text := s.label.value + ""
    sel := $&s.selection
    changed := sel.select_all(&text)
    if changed { s.dirty = true }
    << changed
}

pub fn (s $&SelectableText) clear_selection() bool {
    sel := $&s.selection
    changed := sel.clear()
    if changed { s.dirty = true }
    << changed
}

pub fn (s $&SelectableText) set_selection(start int,end int) bool {
    text := s.label.value + ""
    sel := $&s.selection
    changed := sel.set_range(&text,start,end)
    if changed { s.dirty = true }
    << changed
}

pub fn (s &SelectableText) copy_selection() int {
    selected := s.selected_text()
    if selected.len == 0 { << 0 }
    << try_copy_clipboard(&s.identity,&selected)
}

pub fn (s &SelectableText) has_style() bool { << s.custom.active }

pub fn (s &SelectableText) style_or(styles &Styles) ControlStyle {
    if s.custom.active { << unpack_scalar_style(&s.custom) }
    $base := styles.button.clone()
    base.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    base.border_width = 0.0
    base.min_width = 0.0
    base.min_height = 0.0
    base.align_x = 0.0
    base.align_y = 0.5
    base.states = []StatePaint{}
    if s.muted { base.palette.foreground = base.palette.muted }
    << base
}

pub fn (s $&SelectableText) set_style(style &ControlStyle) int {
    validate_control(style) >>>
    s.custom = pack_scalar_style(style)
    s.dirty = true
    << 0
}

pub fn (s $&SelectableText) clear_style() {
    if s.custom.active {
        s.custom.active = false
        s.dirty = true
    }
}

pub fn (s $&SelectableText) measure_styled(styles &Styles) layout.Size {
    styles.validate() >>>
    s.set_styles_cache(styles)
    c := s.style_or(styles)
    local := layout.Rect{x: 0.0,y: 0.0,width: s.bounds_val.width,height: s.bounds_val.height}
    wrapped := s.wrapped
    label := $&s.label
    size := styled_label_ensure(label,&local,styles,&c,wrapped) >>>
    << layout.Size{
        width: math.max(c.min_width * styles.density,size.width + (c.padding.left + c.padding.right) * styles.density),
        height: math.max(c.min_height * styles.density,size.height + (c.padding.top + c.padding.bottom) * styles.density)
    }
}

fn (s $&SelectableText) hit_test_local(x f64,y f64) int {
    styles := s.style_snapshot()
    c := s.style_or(&styles)
    local := layout.Rect{x: 0.0,y: 0.0,width: s.bounds_val.width,height: s.bounds_val.height}
    wrapped := s.wrapped
    label := $&s.label
    << styled_label_hit_test(label,&local,&styles,&c,wrapped,x,y) >>> (err) { << 0 }
}

fn (s $&SelectableText) open_context_menu(canvas_x f64,canvas_y f64) bool {
    if !s.selection.selectable { << false }
    spec := text_menu_spec_readonly(s.copy_enabled && s.selection.has_selection(),s.label.value.len > 0)
    d := s.style_snapshot().density
    s.ensure_menu()
    $m := s.take_menu()
    m_ref := $&m
    opened := m_ref.open(canvas_x,canvas_y,&spec,d)
    s.put_menu(m)
    if opened { s.dirty = true }
    << opened
}

fn make_local_input(event &ui.InputEvent,dx f64,dy f64) ui.InputEvent {
    << ui.InputEvent{
        kind: event.kind,
        window_id: event.window_id,
        canvas_id: event.canvas_id,
        generation: event.generation,
        x: event.x + dx,
        y: event.y + dy,
        dx: event.dx,
        dy: event.dy,
        button: event.button,
        buttons: event.buttons,
        modifiers: event.modifiers,
        key: event.key,
        scan: event.scan,
        repeat: event.repeat,
        click_count: event.click_count,
        time_ns: event.time_ns
    }
}

pub fn (s $&SelectableText) route(kind int,event &ui.InputEvent) Action {
    if !belongs(&s.identity,event) || s.closed { << no_action(s.id_val,s.dirty) }
    if kind == ROUTE_FOCUS {
        next := s.is_enabled() && s.selection.selectable
        if s.focused != next { s.dirty = true }
        s.focused = next
        << no_action(s.id_val,s.dirty)
    }
    if kind == ROUTE_BLUR || kind == ROUTE_CANCEL {
        if s.focused || s.hovered || s.selection.selecting || s.has_popup_open() { s.dirty = true }
        s.focused = false
        s.hovered = false
        if true {
            sel := $&s.selection
            _ := sel.end_pointer()
        }
        s.close_menu()
        << no_action(s.id_val,s.dirty)
    }
    if !s.is_enabled() { << no_action(s.id_val,s.dirty) }
    $consumed := false
    $focus := false
    if s.has_popup_open() {
        canvas_ev := make_local_input(event,s.bounds_val.x,s.bounds_val.y)
        d := s.style_snapshot().density
        $m := s.take_menu()
        m_ref := $&m
        res := m_ref.input(&canvas_ev,d)
        s.put_menu(m)
        if res.dirty { s.dirty = true }
        if res.cmd == TEXT_MENU_COPY {
            _ := s.copy_selection()
            s.dirty = true
            << Action{kind: ACTION_NONE,id: s.id_val,needs_paint: true,request_focus: true,consumed: true,value: 0.0}
        }
        if res.cmd == TEXT_MENU_SELECT_ALL {
            _ := s.select_all()
            s.dirty = true
            << Action{kind: ACTION_NONE,id: s.id_val,needs_paint: true,request_focus: true,consumed: true,value: 0.0}
        }
        if res.consumed {
            << Action{kind: ACTION_NONE,id: s.id_val,needs_paint: s.dirty,request_focus: false,consumed: true,value: 0.0}
        }
    }
    if event.kind == ui.EV_POINTER_CANCEL {
        s.hovered = false
        sel := $&s.selection
        _ := sel.end_pointer()
        << no_action(s.id_val,s.dirty)
    }
    inside := event.x >= 0.0 && event.y >= 0.0 && event.x <= s.bounds_val.width && event.y <= s.bounds_val.height
    if !s.selection.selectable { << no_action(s.id_val,s.dirty) }
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        hot := inside && event.kind != ui.EV_POINTER_LEAVE
        if hot != s.hovered {
            s.hovered = hot
            s.dirty = true
        }
        if s.selection.selecting {
            idx := s.hit_test_local(event.x,event.y)
            text := s.label.value + ""
            sel := $&s.selection
            if sel.drag_pointer(&text,idx) { s.dirty = true }
            consumed = true
        }
    } else if event.kind == ui.EV_POINTER_DOWN && inside {
        if event.button == ui.BUTTON_RIGHT {
            if !s.selection.has_selection() {
                idx := s.hit_test_local(event.x,event.y)
                text := s.label.value + ""
                sel := $&s.selection
                _ := sel.set_range(&text,idx,idx)
            }
            if s.open_context_menu(s.bounds_val.x + event.x,s.bounds_val.y + event.y) {
                s.focused = true
                focus = true
                consumed = true
            }
        } else if event.button == ui.BUTTON_LEFT {
            idx := s.hit_test_local(event.x,event.y)
            text := s.label.value + ""
            sel := $&s.selection
            if sel.begin_pointer_down(&text,idx,event) { s.dirty = true }
            s.focused = true
            focus = true
            consumed = true
        }
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT {
        if s.selection.selecting {
            sel := $&s.selection
            _ := sel.end_pointer()
            s.dirty = true
            consumed = true
        }
    } else if event.kind == ui.EV_KEY_DOWN && s.focused {
        if is_context_trigger(event) {
            d := s.style_snapshot().density
            ox := s.bounds_val.x + math.min(24.0 * d,s.bounds_val.width * 0.5)
            oy := s.bounds_val.y + math.min(24.0 * d,s.bounds_val.height * 0.5)
            if s.open_context_menu(ox,oy) { consumed = true }
        } else {
            _ := s.measure_styled(&s.style_snapshot()) >>> (err) { << no_action(s.id_val,s.dirty) }
            text := s.label.value + ""
            $cmd := TEXT_KEY_NONE
            if s.label.layouts.len > 0 && s.label.layouts[0].is_host_shaped() {
                shaped := s.label.layouts[0]
                sel := $&s.selection
                cmd = sel.key_navigation_layout(&text,&shaped,event)
            } else {
                $sel_ok := false
                $cur_focus := 0
                if true {
                    sel := $&s.selection
                    cmd = sel.key_navigation(&text,event)
                    sel_ok = sel.selectable
                    cur_focus = sel.focus
                }
                if cmd == TEXT_KEY_NONE && sel_ok && (event.modifiers & ui.MOD_SHIFT) != 0 && s.label.font_layouts.len > 0 {
                    next := font_vertical_step_focus(&s.label.font_layouts[0],&text,cur_focus,event.key)
                    if next >= 0 {
                        sel := $&s.selection
                        sel.focus = next
                        cmd = TEXT_KEY_CHANGED
                    }
                }
            }
            if cmd == TEXT_KEY_COPY {
                _ := s.copy_selection()
                consumed = true
            } else if cmd == TEXT_KEY_CHANGED {
                s.dirty = true
                consumed = true
            }
        }
    }
    << Action{kind: ACTION_NONE,id: s.id_val,needs_paint: s.dirty,request_focus: focus,consumed: consumed,value: 0.0}
}

pub fn (s $&SelectableText) input(event &ui.InputEvent) Action {
    local := make_local_input(event,-s.bounds_val.x,-s.bounds_val.y)
    << s.route(ROUTE_INPUT,&local)
}

pub fn (s $&SelectableText) event(event &ui.Event) Action {
    if event.window_id != s.identity.window_id { << no_action(s.id_val,s.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED {
        s.close_menu()
        if true {
            sel := $&s.selection
            _ := sel.end_pointer()
        }
        s.focused = false
        s.hovered = false
        if event.kind == ui.EV_CLOSED { s.closed = true }
        s.dirty = true
        << no_action(s.id_val,s.dirty)
    }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) >>>
        if identity.canvas_id == s.identity.canvas_id && identity.generation == s.identity.generation { s.close() }
        << no_action(s.id_val,s.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(s.id_val,s.dirty) }
    input := ui.input_of(event) >>>
    << s.input(&input)
}

pub fn (s $&SelectableText) paint_styled(frame $&draw.Frame,styles &Styles) int {
    styles.validate() >>>
    s.set_styles_cache(styles)
    c := s.style_or(styles)
    local := layout.Rect{x: 0.0,y: 0.0,width: s.bounds_val.width,height: s.bounds_val.height}
    $state := 0
    if !s.is_enabled() { state = state | STATE_DISABLED }
    else {
        if s.hovered { state = state | STATE_HOVERED }
        if s.focused { state = state | STATE_FOCUSED }
    }
    $anchor := 0
    $focus := 0
    if s.selection.selectable {
        anchor = s.selection.anchor
        focus = s.selection.focus
    }
    wrapped := s.wrapped
    ellipsis := s.ellipsis
    label := $&s.label
    << paint_styled_label_selected(label,frame,&local,styles,&c,state,anchor,focus,wrapped,ellipsis) >>>
}

pub fn (s $&SelectableText) paint_popup_styled(frame $&draw.Frame,styles &Styles) int {
    if !s.menus.has(0) { << 0 }
    $m := s.take_menu()
    err_msg := paint_text_context_menu_err($&m,frame,styles)
    s.put_menu(m)
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}
