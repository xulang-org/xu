@ui/widgets

#ui
#ui/draw
#ui/layout
#math
#unicode/utf8
#errors
#strings

// Display text with drag selection, keyboard copy/select-all, and a lightweight
// context menu. Unlike Editor it never owns a native TextInput session.

pub struct SelectableText {
    id int
    identity ui.CanvasEvent
    context draw.Context
    bounds layout.Rect
    value string
    options draw.TextOptions
    layouts []draw.TextLayout
    dirty bool
    enabled bool
    focused bool
    closed bool
    hovered bool
    dragging bool
    anchor int
    focus int
    clipboard ui.Request
    clipboard_operation int
    menu TextContextMenu
    align_x f64
    align_y f64
    wrapped bool
    copy_enabled bool
}

pub fn selectable_text(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,value &string) SelectableText {
    if !valid_identity(identity) || !context.matches_canvas(identity) || id <= 0 || value.len > 16384 || !utf8.valid(value) {
        >> errors.new("widgets: invalid selectable text")
    }
    validate_bounds(bounds) or >>
    << SelectableText{id: id,identity: copy_identity(identity),context: context.clone(),bounds: copy_rect(bounds),value: value + "",
        options: draw.text_options(15.0),layouts: []draw.TextLayout{},dirty: true,enabled: true,focused: false,closed: false,hovered: false,dragging: false,
        anchor: 0,focus: 0,clipboard: ui.Request{id: 0,window_id: 0,canvas_id: 0,generation: 0,kind: 0},clipboard_operation: 0,
        menu: text_context_menu(),align_x: 0.0,align_y: 0.5,wrapped: false,copy_enabled: true}
}

pub fn (t &SelectableText) id() int { << t.id }
pub fn (t &SelectableText) text() string { << t.value + "" }
pub fn (t &SelectableText) bounds() layout.Rect { << copy_rect(&t.bounds) }
pub fn (t &SelectableText) needs_paint() bool { << t.dirty }
pub fn (t $&SelectableText) painted() { t.dirty = false }
pub fn (t &SelectableText) has_selection() bool { << t.anchor != t.focus }
pub fn (t &SelectableText) selection_range() TextRange { << text_range(t.anchor,t.focus) }
pub fn (t &SelectableText) is_copy_enabled() bool { << t.copy_enabled }
pub fn (t $&SelectableText) set_copy_enabled(on bool) {
    if t.copy_enabled != on {
        t.copy_enabled = on
        t.dirty = true
    }
}

pub fn (t $&SelectableText) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if bounds.x != t.bounds.x || bounds.y != t.bounds.y || bounds.width != t.bounds.width || bounds.height != t.bounds.height {
        t.bounds = copy_rect(bounds)
        if t.wrapped { t.drop_layout() }
        t.dirty = true
    }
    << 0
}

pub fn (t $&SelectableText) set_text(value &string) int {
    if value.len > 16384 || !utf8.valid(value) { >> errors.new("widgets: invalid selectable text") }
    if t.value != value + "" {
        t.cancel_clipboard()
        t.value = value + ""
        t.anchor = 0
        t.focus = 0
        menu := $&t.menu
        menu.close()
        t.drop_layout()
        t.dirty = true
    }
    << 0
}

pub fn (t $&SelectableText) set_font(size f64,weight int,wrapped bool) int {
    if !finite_metric(size,512.0) || size < 1.0 || weight < 100 || weight > 900 { >> errors.new("widgets: invalid selectable font") }
    $options := draw.text_options(size)
    options.weight = weight
    options.line_height = size * 1.35
    if wrapped { options.width = math.max(1.0,t.bounds.width) }
    if !options_equal(&t.options,&options) || t.wrapped != wrapped {
        t.options = copy_text_options(&options)
        t.wrapped = wrapped
        t.drop_layout()
        t.dirty = true
    }
    << 0
}

fn (t $&SelectableText) drop_layout() {
    for item in t.layouts { $owned := item
        owned.dispose() or (err) { -> } }
    t.layouts = []draw.TextLayout{}
}

fn (t $&SelectableText) cancel_clipboard() {
    if t.clipboard.id > 0 && t.clipboard_operation == 1 { t.clipboard.cancel() }
    t.clipboard.id = 0
    t.clipboard_operation = 0
}

fn (t $&SelectableText) ensure_layout() draw.TextLayout {
    $options := copy_text_options(&t.options)
    if t.wrapped { options.width = math.max(1.0,t.bounds.width) }
    if t.layouts.len > 0 && options_equal(&t.options,&options) { << t.layouts[0] }
    t.drop_layout()
    shaped := t.context.layout_text(&t.value,&options) or >>
    t.layouts.push(shaped)
    t.options = copy_text_options(&options)
    << t.layouts[0]
}

fn (t &SelectableText) origin_x(shaped &draw.TextLayout) f64 {
    << math.max(0.0,t.bounds.width - shaped.metrics.width) * t.align_x
}
fn (t &SelectableText) origin_y(shaped &draw.TextLayout) f64 {
    << math.max(0.0,t.bounds.height - shaped.metrics.height) * t.align_y
}

fn (t $&SelectableText) select_at(x f64,y f64,extend bool) int {
    shaped := t.ensure_layout() or >>
    ox := t.origin_x(&shaped)
    oy := t.origin_y(&shaped)
    hit := shaped.hit_test(math.max(-1048576.0,math.min(1048576.0,x - ox)),math.max(-1048576.0,math.min(1048576.0,y - oy))) or >>
    index := hit.byte_index()
    $anchor := index
    if extend { anchor = t.anchor }
    t.anchor = clamp_index(anchor,t.value.len)
    t.focus = clamp_index(index,t.value.len)
    t.dirty = true
    << 0
}

fn (t $&SelectableText) select_click(x f64,y f64,count int,extend bool) int {
    if extend { << t.select_at(x,y,true) or >> }
    shaped := t.ensure_layout() or >>
    ox := t.origin_x(&shaped)
    oy := t.origin_y(&shaped)
    hit := shaped.hit_test(math.max(-1048576.0,math.min(1048576.0,x - ox)),math.max(-1048576.0,math.min(1048576.0,y - oy))) or >>
    index := hit.byte_index()
    if count >= 3 {
        range := line_range_at(&t.value,index)
        t.anchor = range.start
        t.focus = range.end
    } else if count >= 2 {
        range := word_range_at(&t.value,index)
        t.anchor = range.start
        t.focus = range.end
    } else {
        t.anchor = index
        t.focus = index
    }
    t.dirty = true
    << 0
}

pub fn (t $&SelectableText) select_all() {
    t.anchor = 0
    t.focus = t.value.len
    t.dirty = true
}

pub fn (t &SelectableText) selected_text() string {
    if !t.copy_enabled { << "" }
    range := t.selection_range()
    if range.empty() { << "" }
    << t.value[range.start:range.end]
}

fn (t $&SelectableText) copy_selection() int {
    if !t.copy_enabled { << 0 }
    selected := t.selected_text()
    if selected.len == 0 { << 0 }
    t.cancel_clipboard()
    options := ui.RequestOptions{timeout_ms: 5000}
    req := ui.clipboard_write_async(&t.identity,&selected,&options) or (err) { << 0 }
    t.clipboard = req
    t.clipboard_operation = 2
    << 0
}

fn (t $&SelectableText) handle_shortcut(event &ui.InputEvent) int {
    if is_primary_shortcut(event,65) {
        t.select_all()
        << 0
    }
    if is_primary_shortcut(event,67) {
        t.copy_selection() or (err) { << 0 }
        << 0
    }
    << 0
}

fn (t $&SelectableText) open_menu(x f64,y f64) {
    $can_copy := t.copy_enabled && t.has_selection()
    if t.copy_enabled && !can_copy {
        _ := t.select_click(x,y,2,false) or (err) { << }
        can_copy = t.has_selection()
    }
    menu := $&t.menu
    menu.open_at(x,y,false,can_copy,false)
    t.dirty = true
}

fn (t $&SelectableText) activate_menu(item int) int {
    menu := $&t.menu
    menu.close()
    if item == TEXT_MENU_COPY { << t.copy_selection() }
    if item == TEXT_MENU_SELECT_ALL { t.select_all() }
    t.dirty = true
    << 0
}

pub fn (t $&SelectableText) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid selectable route") }
    if !belongs(&t.identity,event) || t.closed { << no_action(t.id,t.dirty) }
    if kind == ROUTE_FOCUS { t.focused = true
        t.dirty = true
        << no_action(t.id,t.dirty) }
    if kind == ROUTE_BLUR || kind == ROUTE_CANCEL || event.kind == ui.EV_POINTER_CANCEL {
        t.focused = false
        t.dragging = false
        menu := $&t.menu
        menu.close()
        t.dirty = true
        << no_action(t.id,t.dirty)
    }
    if !t.enabled { << no_action(t.id,t.dirty) }
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        hot := event.kind != ui.EV_POINTER_LEAVE && event.x >= 0.0 && event.y >= 0.0 && event.x < t.bounds.width && event.y < t.bounds.height
        if hot != t.hovered { t.hovered = hot
            t.dirty = true }
        menu := $&t.menu
        if menu.open {
            menu.hot = menu.hit_item(event.x,event.y)
            t.dirty = true
        }
    }
    $consumed := false
    menu := $&t.menu
    if menu.open {
        if event.kind == ui.EV_POINTER_DOWN {
            item := menu.hit_item(event.x,event.y)
            if item != TEXT_MENU_NONE {
                t.activate_menu(item) or >>
                consumed = true
            } else {
                menu.close()
                t.dirty = true
                consumed = true
            }
        } else if event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_ESCAPE {
            menu.close()
            t.dirty = true
            consumed = true
        }
        << Action{kind: ACTION_NONE,id: t.id,needs_paint: t.dirty,request_focus: t.focused,consumed: consumed,value: 0.0}
    }
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_RIGHT {
        t.focused = true
        t.open_menu(event.x,event.y)
        consumed = true
    }
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT {
        t.focused = true
        t.dragging = true
        t.select_click(event.x,event.y,event.click_count,(event.modifiers & ui.MOD_SHIFT) != 0) or >>
        consumed = true
    }
    if event.kind == ui.EV_POINTER_MOVE && t.dragging {
        t.select_at(event.x,event.y,true) or >>
        consumed = true
    }
    if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT {
        t.dragging = false
        consumed = true
    }
    if t.focused && event.kind == ui.EV_KEY_DOWN {
        t.handle_shortcut(event) or >>
        if event.key == ui.KEY_LEFT || event.key == ui.KEY_RIGHT || event.key == ui.KEY_HOME || event.key == ui.KEY_END {
            $index := t.focus
            if event.key == ui.KEY_LEFT { index = prev_boundary(&t.value,t.focus) }
            if event.key == ui.KEY_RIGHT { index = next_boundary(&t.value,t.focus) }
            if event.key == ui.KEY_HOME { index = 0 }
            if event.key == ui.KEY_END { index = t.value.len }
            $anchor := index
            if (event.modifiers & ui.MOD_SHIFT) != 0 { anchor = t.anchor }
            else if t.anchor != t.focus && (event.key == ui.KEY_LEFT || event.key == ui.KEY_RIGHT) {
                range := t.selection_range()
                if event.key == ui.KEY_LEFT { index = range.start
                    anchor = range.start }
                else { index = range.end
                    anchor = range.end }
            }
            t.anchor = anchor
            t.focus = index
            t.dirty = true
        }
        consumed = true
    }
    << Action{kind: ACTION_NONE,id: t.id,needs_paint: t.dirty,request_focus: t.focused,consumed: consumed,value: 0.0}
}

pub fn (t $&SelectableText) event(event &ui.Event) Action {
    if event.window_id != t.identity.window_id { << no_action(t.id,t.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED || event.kind == ui.EV_CANVAS_CLOSED {
        if event.kind == ui.EV_CANVAS_CLOSED {
            identity := ui.canvas_of(event) or >>
            if identity.canvas_id != t.identity.canvas_id || identity.generation != t.identity.generation { << no_action(t.id,t.dirty) }
        }
        t.focused = false
        t.dragging = false
        menu := $&t.menu
        menu.close()
        if event.kind != ui.EV_BLURRED {
            t.closed = true
            t.enabled = false
            t.drop_layout()
        }
        t.dirty = true
        << no_action(t.id,t.dirty)
    }
    if event.kind == ui.EV_REQUEST {
        result := ui.request_of(event) or >>
        if t.clipboard.id == 0 || !result.matches(&t.clipboard) { << no_action(t.id,t.dirty) }
        t.clipboard.id = 0
        t.clipboard_operation = 0
        << no_action(t.id,t.dirty)
    }
    << no_action(t.id,t.dirty)
}

fn (t $&SelectableText) paint_body(frame $&draw.Frame,color draw.Color,selection draw.Color) int {
    shaped := t.ensure_layout() or >>
    ox := t.origin_x(&shaped)
    oy := t.origin_y(&shaped)
    if t.anchor != t.focus {
        paint_selection_rects(frame,&shaped,ox,oy,0.0,0.0,t.anchor,t.focus,selection) or >>
    }
    frame.text_layout(&shaped,ox,oy,color) or >>
    << 0
}

pub fn (t $&SelectableText) paint(frame $&draw.Frame,theme &Theme) int {
    if t.closed { << 0 }
    show_menu := t.menu.open
    t.paint_body(frame,theme.foreground,theme.accent) or >>
    if show_menu {
        ctx := t.context.clone()
        menu := $&t.menu
        menu.paint(frame,&ctx,theme) or >>
    }
    << 0
}

pub fn (t $&SelectableText) paint_colored(frame $&draw.Frame,theme &Theme,color draw.Color,selection draw.Color) int {
    if t.closed { << 0 }
    show_menu := t.menu.open
    t.paint_body(frame,color,selection) or >>
    if show_menu {
        ctx := t.context.clone()
        menu := $&t.menu
        menu.paint(frame,&ctx,theme) or >>
    }
    << 0
}

pub fn (t $&SelectableText) dispose() {
    t.cancel_clipboard()
    menu := $&t.menu
    menu.close()
    t.drop_layout()
    t.closed = true
    t.enabled = false
    t.focused = false
}
