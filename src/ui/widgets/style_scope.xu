@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

pub const STYLE_PATCH_NORMAL = 1
pub const STYLE_PATCH_HOVERED = 2
pub const STYLE_PATCH_PRESSED = 4
pub const STYLE_PATCH_DISABLED = 8
pub const STYLE_PATCH_FOREGROUND = 16
pub const STYLE_PATCH_MUTED = 32
pub const STYLE_PATCH_ACCENT = 64
pub const STYLE_PATCH_ON_ACCENT = 128
pub const STYLE_PATCH_FOCUS = 256
pub const STYLE_PATCH_BORDER = 512
pub const STYLE_PATCH_PADDING = 1024
pub const STYLE_PATCH_RADIUS = 2048
pub const STYLE_PATCH_BORDER_WIDTH = 4096
pub const STYLE_PATCH_FOCUS_WIDTH = 8192
pub const STYLE_PATCH_MIN_SIZE = 16384
pub const STYLE_PATCH_GAP = 32768
pub const STYLE_PATCH_SHADOW = 65536
pub const STYLE_PATCH_FONT_SIZE = 131072
pub const STYLE_PATCH_FONT_WEIGHT = 262144
pub const STYLE_PATCH_FONT_FAMILY = 524288
pub const STYLE_PATCH_ALIGN = 1048576
pub const STYLE_PATCH_INVALID = 2097152
pub const STYLE_PATCH_SELECTION = 4194304
pub const STYLE_PATCH_PLACEHOLDER = 8388608
pub const STYLE_PATCH_FONT_ITALIC = 16777216
pub const STYLE_PATCH_LINE_HEIGHT = 33554432
pub const STYLE_PATCH_ICON = 67108864
pub const STYLE_PATCH_STATES = 134217728

pub struct ControlStylePatch {
    pub fields int
    pub normal draw.Color
    pub hovered draw.Color
    pub pressed draw.Color
    pub disabled draw.Color
    pub foreground draw.Color
    pub muted draw.Color
    pub accent draw.Color
    pub on_accent draw.Color
    pub focus draw.Color
    pub border draw.Color
    pub shadow draw.Color
    pub invalid draw.Color
    pub invalid_fill draw.Color
    pub selection draw.Color
    pub selection_text draw.Color
    pub placeholder draw.Color
    pub padding layout.Insets
    pub radius f64
    pub border_width f64
    pub focus_width f64
    pub min_width f64
    pub min_height f64
    pub gap f64
    pub shadow_x f64
    pub shadow_y f64
    pub shadow_spread f64
    pub shadow_blur f64
    pub font_size f64
    pub font_weight int
    pub font_family string
    pub font_italic bool
    pub line_height f64
    pub align_x f64
    pub align_y f64
    pub icon_size f64
    pub icon_placement int
    pub states []StatePaint
}

fn clone_patch_states(src &[]StatePaint) []StatePaint {
    $out := []StatePaint{}
    for rule in src {
        out.push(StatePaint{
            when: rule.when,unless: rule.unless,fields: rule.fields,
            background: rule.background,foreground: rule.foreground,border: rule.border,
            focus: rule.focus,selection: rule.selection,selection_text: rule.selection_text,
            placeholder: rule.placeholder,icon_opacity: rule.icon_opacity,
            border_width: rule.border_width,shadow: rule.shadow,shadow_blur: rule.shadow_blur
        })
    }
    << out
}

fn validate_patch_state_rule(rule &StatePaint) int {
    if rule.when < 0 || rule.when > 127 || rule.unless < 0 || rule.unless > 127 || (rule.when & rule.unless) != 0 ||
       rule.fields < 0 || rule.fields > 1023 || !finite_metric(rule.icon_opacity,1.0) ||
       !finite_metric(rule.border_width,4096.0) || !finite_metric(rule.shadow_blur,4096.0) {
        >> errors.new("widgets: invalid state paint rule")
    }
    << 0
}

pub fn control_style_patch() ControlStylePatch {
    zero := draw.rgba(0,0,0,0)
    << ControlStylePatch{
        fields: 0,
        normal: zero,hovered: zero,pressed: zero,disabled: zero,foreground: zero,muted: zero,
        accent: zero,on_accent: zero,focus: zero,border: zero,shadow: zero,
        invalid: zero,invalid_fill: zero,selection: zero,selection_text: zero,placeholder: zero,
        padding: layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0},
        radius: 0.0,border_width: 0.0,focus_width: 0.0,min_width: 0.0,min_height: 0.0,gap: 0.0,
        shadow_x: 0.0,shadow_y: 0.0,shadow_spread: 0.0,shadow_blur: 0.0,
        font_size: 15.0,font_weight: 400,font_family: "",font_italic: false,line_height: 0.0,
        align_x: 0.5,align_y: 0.5,icon_size: 18.0,icon_placement: ICON_LEADING,
        states: []StatePaint{}
    }
}

pub fn (p &ControlStylePatch) clone() ControlStylePatch {
    << ControlStylePatch{
        fields: p.fields,
        normal: p.normal,hovered: p.hovered,pressed: p.pressed,disabled: p.disabled,
        foreground: p.foreground,muted: p.muted,accent: p.accent,on_accent: p.on_accent,
        focus: p.focus,border: p.border,shadow: p.shadow,
        invalid: p.invalid,invalid_fill: p.invalid_fill,selection: p.selection,
        selection_text: p.selection_text,placeholder: p.placeholder,
        padding: layout.Insets{left: p.padding.left,top: p.padding.top,right: p.padding.right,bottom: p.padding.bottom},
        radius: p.radius,border_width: p.border_width,focus_width: p.focus_width,
        min_width: p.min_width,min_height: p.min_height,gap: p.gap,
        shadow_x: p.shadow_x,shadow_y: p.shadow_y,shadow_spread: p.shadow_spread,shadow_blur: p.shadow_blur,
        font_size: p.font_size,font_weight: p.font_weight,font_family: p.font_family + "",
        font_italic: p.font_italic,line_height: p.line_height,
        align_x: p.align_x,align_y: p.align_y,icon_size: p.icon_size,icon_placement: p.icon_placement,
        states: clone_patch_states(&p.states)
    }
}

pub fn (p $&ControlStylePatch) add_state(rule &StatePaint) int {
    validate_patch_state_rule(rule) or >>
    if p.states.len >= 32 { >> errors.new("widgets: too many state paint rules") }
    p.states.push(StatePaint{
        when: rule.when,unless: rule.unless,fields: rule.fields,
        background: rule.background,foreground: rule.foreground,border: rule.border,
        focus: rule.focus,selection: rule.selection,selection_text: rule.selection_text,
        placeholder: rule.placeholder,icon_opacity: rule.icon_opacity,
        border_width: rule.border_width,shadow: rule.shadow,shadow_blur: rule.shadow_blur
    })
    p.fields = p.fields | STYLE_PATCH_STATES
    << 0
}

pub fn (p &ControlStylePatch) validate() int {
    if p.fields < 0 || p.fields >= (STYLE_PATCH_STATES * 2) {
        >> errors.new("widgets: invalid control style patch fields")
    }
    if (p.fields & STYLE_PATCH_PADDING) != 0 { p.padding.validate() or >> }
    if (p.fields & STYLE_PATCH_RADIUS) != 0 && !finite_metric(p.radius,4096.0) { >> errors.new("widgets: invalid patch radius") }
    if (p.fields & STYLE_PATCH_BORDER_WIDTH) != 0 && !finite_metric(p.border_width,4096.0) { >> errors.new("widgets: invalid patch border width") }
    if (p.fields & STYLE_PATCH_FOCUS_WIDTH) != 0 && !finite_metric(p.focus_width,4096.0) { >> errors.new("widgets: invalid patch focus width") }
    if (p.fields & STYLE_PATCH_MIN_SIZE) != 0 && (!finite_metric(p.min_width,4096.0) || !finite_metric(p.min_height,4096.0)) { >> errors.new("widgets: invalid patch min size") }
    if (p.fields & STYLE_PATCH_GAP) != 0 && !finite_metric(p.gap,4096.0) { >> errors.new("widgets: invalid patch gap") }
    if (p.fields & STYLE_PATCH_SHADOW) != 0 && (!finite_metric(math.abs(p.shadow_x),4096.0) || !finite_metric(math.abs(p.shadow_y),4096.0) || !finite_metric(p.shadow_spread,4096.0) || !finite_metric(p.shadow_blur,4096.0)) {
        >> errors.new("widgets: invalid patch shadow")
    }
    if (p.fields & STYLE_PATCH_FONT_SIZE) != 0 && (!finite_metric(p.font_size,512.0) || p.font_size < 1.0) { >> errors.new("widgets: invalid patch font size") }
    if (p.fields & STYLE_PATCH_FONT_WEIGHT) != 0 && (p.font_weight < 100 || p.font_weight > 900) { >> errors.new("widgets: invalid patch font weight") }
    if (p.fields & STYLE_PATCH_FONT_FAMILY) != 0 {
        tf := FontStyle{family: p.font_family + "",size: 15.0,weight: 400,italic: false,line_height: 0.0}
        validate_font(&tf) or >>
    }
    if (p.fields & STYLE_PATCH_ALIGN) != 0 && (!finite_metric(p.align_x,1.0) || !finite_metric(p.align_y,1.0)) {
        >> errors.new("widgets: invalid patch alignment")
    }
    if (p.fields & STYLE_PATCH_LINE_HEIGHT) != 0 && !finite_metric(p.line_height,512.0) {
        >> errors.new("widgets: invalid patch line height")
    }
    if (p.fields & STYLE_PATCH_ICON) != 0 && (!finite_metric(p.icon_size,512.0) || p.icon_size <= 0.0 || p.icon_placement < ICON_LEADING || p.icon_placement > ICON_BELOW) {
        >> errors.new("widgets: invalid patch icon")
    }
    if (p.fields & STYLE_PATCH_STATES) != 0 {
        if p.states.len > 32 { >> errors.new("widgets: too many state paint rules") }
        for rule in p.states {
            validate_patch_state_rule(&rule) or >>
        }
    }
    << 0
}

pub fn (base &ControlStylePatch) merge(over &ControlStylePatch) ControlStylePatch {
    $res := base.clone()
    f := over.fields
    if f == 0 { << res }
    if (f & STYLE_PATCH_NORMAL) != 0 { res.normal = over.normal }
    if (f & STYLE_PATCH_HOVERED) != 0 { res.hovered = over.hovered }
    if (f & STYLE_PATCH_PRESSED) != 0 { res.pressed = over.pressed }
    if (f & STYLE_PATCH_DISABLED) != 0 { res.disabled = over.disabled }
    if (f & STYLE_PATCH_FOREGROUND) != 0 { res.foreground = over.foreground }
    if (f & STYLE_PATCH_MUTED) != 0 { res.muted = over.muted }
    if (f & STYLE_PATCH_ACCENT) != 0 { res.accent = over.accent }
    if (f & STYLE_PATCH_ON_ACCENT) != 0 { res.on_accent = over.on_accent }
    if (f & STYLE_PATCH_FOCUS) != 0 { res.focus = over.focus }
    if (f & STYLE_PATCH_BORDER) != 0 { res.border = over.border }
    if (f & STYLE_PATCH_PADDING) != 0 { res.padding = layout.Insets{left: over.padding.left,top: over.padding.top,right: over.padding.right,bottom: over.padding.bottom} }
    if (f & STYLE_PATCH_RADIUS) != 0 { res.radius = over.radius }
    if (f & STYLE_PATCH_BORDER_WIDTH) != 0 { res.border_width = over.border_width }
    if (f & STYLE_PATCH_FOCUS_WIDTH) != 0 { res.focus_width = over.focus_width }
    if (f & STYLE_PATCH_MIN_SIZE) != 0 { res.min_width = over.min_width
        res.min_height = over.min_height }
    if (f & STYLE_PATCH_GAP) != 0 { res.gap = over.gap }
    if (f & STYLE_PATCH_SHADOW) != 0 {
        res.shadow = over.shadow
        res.shadow_x = over.shadow_x
        res.shadow_y = over.shadow_y
        res.shadow_spread = over.shadow_spread
        res.shadow_blur = over.shadow_blur
    }
    if (f & STYLE_PATCH_FONT_SIZE) != 0 { res.font_size = over.font_size }
    if (f & STYLE_PATCH_FONT_WEIGHT) != 0 { res.font_weight = over.font_weight }
    if (f & STYLE_PATCH_FONT_FAMILY) != 0 { res.font_family = over.font_family + "" }
    if (f & STYLE_PATCH_ALIGN) != 0 { res.align_x = over.align_x
        res.align_y = over.align_y }
    if (f & STYLE_PATCH_INVALID) != 0 { res.invalid = over.invalid
        res.invalid_fill = over.invalid_fill }
    if (f & STYLE_PATCH_SELECTION) != 0 { res.selection = over.selection
        res.selection_text = over.selection_text }
    if (f & STYLE_PATCH_PLACEHOLDER) != 0 { res.placeholder = over.placeholder }
    if (f & STYLE_PATCH_FONT_ITALIC) != 0 { res.font_italic = over.font_italic }
    if (f & STYLE_PATCH_LINE_HEIGHT) != 0 { res.line_height = over.line_height }
    if (f & STYLE_PATCH_ICON) != 0 { res.icon_size = over.icon_size
        res.icon_placement = over.icon_placement }
    if (f & STYLE_PATCH_STATES) != 0 {
        if (base.fields & STYLE_PATCH_STATES) == 0 {
            res.states = clone_patch_states(&over.states)
        } else {
            for rule in over.states {
                if res.states.len >= 32 { <- }
                res.states.push(rule)
            }
        }
    }
    res.fields = base.fields | f
    << res
}

pub fn (c &ControlStyle) apply_patch(p &ControlStylePatch) ControlStyle {
    $res := c.clone()
    if p.fields == 0 { << res }
    f := p.fields
    if (f & STYLE_PATCH_NORMAL) != 0 { res.palette.normal = p.normal }
    if (f & STYLE_PATCH_HOVERED) != 0 { res.palette.hovered = p.hovered }
    if (f & STYLE_PATCH_PRESSED) != 0 { res.palette.pressed = p.pressed }
    if (f & STYLE_PATCH_DISABLED) != 0 { res.palette.disabled = p.disabled }
    if (f & STYLE_PATCH_FOREGROUND) != 0 { res.palette.foreground = p.foreground }
    if (f & STYLE_PATCH_MUTED) != 0 { res.palette.muted = p.muted }
    if (f & STYLE_PATCH_ACCENT) != 0 {
        old_accent := res.palette.accent
        res.palette.accent = p.accent
        for i in 0:res.states.len {
            if (res.states[i].fields & PAINT_BORDER) != 0 && res.states[i].border.value() == old_accent.value() {
                res.states[i].border = p.accent
            }
        }
    }
    if (f & STYLE_PATCH_ON_ACCENT) != 0 { res.palette.on_accent = p.on_accent }
    if (f & STYLE_PATCH_FOCUS) != 0 {
        old_focus := res.palette.focus
        res.palette.focus = p.focus
        for i in 0:res.states.len {
            if (res.states[i].fields & PAINT_BORDER) != 0 && res.states[i].border.value() == old_focus.value() {
                res.states[i].border = p.focus
            }
            if (res.states[i].fields & PAINT_FOCUS) != 0 && res.states[i].focus.value() == old_focus.value() {
                res.states[i].focus = p.focus
            }
        }
    }
    if (f & STYLE_PATCH_BORDER) != 0 { res.palette.border = p.border }
    if (f & STYLE_PATCH_PADDING) != 0 { res.padding = layout.Insets{left: p.padding.left,top: p.padding.top,right: p.padding.right,bottom: p.padding.bottom} }
    if (f & STYLE_PATCH_RADIUS) != 0 { res.radius = p.radius }
    if (f & STYLE_PATCH_BORDER_WIDTH) != 0 { res.border_width = p.border_width }
    if (f & STYLE_PATCH_FOCUS_WIDTH) != 0 { res.focus_width = p.focus_width }
    if (f & STYLE_PATCH_MIN_SIZE) != 0 { res.min_width = p.min_width
        res.min_height = p.min_height }
    if (f & STYLE_PATCH_GAP) != 0 { res.gap = p.gap }
    if (f & STYLE_PATCH_SHADOW) != 0 {
        res.shadow = p.shadow
        res.shadow_x = p.shadow_x
        res.shadow_y = p.shadow_y
        res.shadow_spread = p.shadow_spread
        res.shadow_blur = p.shadow_blur
    }
    if (f & STYLE_PATCH_FONT_SIZE) != 0 { res.font.size = p.font_size
        res.inherit_font = false }
    if (f & STYLE_PATCH_FONT_WEIGHT) != 0 { res.font.weight = p.font_weight
        res.inherit_font = false }
    if (f & STYLE_PATCH_FONT_FAMILY) != 0 { res.font.family = p.font_family + ""
        res.inherit_font = false }
    if (f & STYLE_PATCH_ALIGN) != 0 { res.align_x = p.align_x
        res.align_y = p.align_y }
    if (f & STYLE_PATCH_INVALID) != 0 { res.palette.invalid = p.invalid
        res.palette.invalid_fill = p.invalid_fill }
    if (f & STYLE_PATCH_SELECTION) != 0 { res.palette.selection = p.selection
        res.palette.selection_text = p.selection_text }
    if (f & STYLE_PATCH_PLACEHOLDER) != 0 { res.palette.placeholder = p.placeholder }
    if (f & STYLE_PATCH_FONT_ITALIC) != 0 { res.font.italic = p.font_italic
        res.inherit_font = false }
    if (f & STYLE_PATCH_LINE_HEIGHT) != 0 { res.font.line_height = p.line_height
        res.inherit_font = false }
    if res.font.line_height > 0.0 && res.font.line_height < res.font.size {
        res.font.line_height = res.font.size
    }
    if (f & STYLE_PATCH_ICON) != 0 { res.icon_size = p.icon_size
        res.icon_placement = p.icon_placement }
    if (f & STYLE_PATCH_STATES) != 0 {
        for rule in p.states {
            if res.states.len >= 32 { <- }
            res.states.push(rule)
        }
    }
    << res
}

pub const SCOPE_DENSITY_SCALE = 1
pub const SCOPE_TEXT_SCALE_MULT = 2
pub const SCOPE_BACKGROUND = 4
pub const SCOPE_FONT_FAMILY = 8
pub const SCOPE_FONT_SIZE_DELTA = 16
pub const SCOPE_FONT_WEIGHT = 32
pub const SCOPE_PALETTE = 64
pub const SCOPE_BUTTON = 128
pub const SCOPE_INPUT = 256
pub const SCOPE_CHECKBOX = 512
pub const SCOPE_PROGRESS = 1024
pub const SCOPE_SCROLL = 2048
pub const SCOPE_RADIUS_SCALE = 4096
pub const SCOPE_PADDING_SCALE = 8192
pub const SCOPE_FONT_ITALIC = 16384
pub const SCOPE_LINE_HEIGHT = 32768

pub struct StyleDelta {
    pub fields int
    pub density_scale f64
    pub text_scale_mult f64
    pub radius_scale f64
    pub padding_scale f64
    pub background draw.Color
    pub font_family string
    pub font_size_delta f64
    pub font_weight int
    pub font_italic bool
    pub line_height f64
    pub palette ControlStylePatch
    pub button ControlStylePatch
    pub input ControlStylePatch
    pub checkbox ControlStylePatch
    pub progress ControlStylePatch
    pub scroll ControlStylePatch
}

pub fn style_delta() StyleDelta {
    empty := control_style_patch()
    << StyleDelta{
        fields: 0,
        density_scale: 1.0,
        text_scale_mult: 1.0,
        radius_scale: 1.0,
        padding_scale: 1.0,
        background: draw.rgba(0,0,0,0),
        font_family: "",
        font_size_delta: 0.0,
        font_weight: 400,
        font_italic: false,
        line_height: 0.0,
        palette: empty.clone(),
        button: empty.clone(),
        input: empty.clone(),
        checkbox: empty.clone(),
        progress: empty.clone(),
        scroll: empty
    }
}

pub fn (sc &StyleDelta) clone() StyleDelta {
    << StyleDelta{
        fields: sc.fields,
        density_scale: sc.density_scale,
        text_scale_mult: sc.text_scale_mult,
        radius_scale: sc.radius_scale,
        padding_scale: sc.padding_scale,
        background: sc.background,
        font_family: sc.font_family + "",
        font_size_delta: sc.font_size_delta,
        font_weight: sc.font_weight,
        font_italic: sc.font_italic,
        line_height: sc.line_height,
        palette: sc.palette.clone(),
        button: sc.button.clone(),
        input: sc.input.clone(),
        checkbox: sc.checkbox.clone(),
        progress: sc.progress.clone(),
        scroll: sc.scroll.clone()
    }
}

pub fn (sc &StyleDelta) validate() int {
    if sc.fields < 0 || sc.fields >= (SCOPE_LINE_HEIGHT * 2) {
        >> errors.new("widgets: invalid style scope fields")
    }
    if (sc.fields & SCOPE_DENSITY_SCALE) != 0 && (math.is_nan(sc.density_scale) || math.is_inf(sc.density_scale) || sc.density_scale < 0.25 || sc.density_scale > 4.0) {
        >> errors.new("widgets: invalid scope density scale")
    }
    if (sc.fields & SCOPE_TEXT_SCALE_MULT) != 0 && (math.is_nan(sc.text_scale_mult) || math.is_inf(sc.text_scale_mult) || sc.text_scale_mult < 0.25 || sc.text_scale_mult > 4.0) {
        >> errors.new("widgets: invalid scope text scale multiplier")
    }
    if (sc.fields & SCOPE_RADIUS_SCALE) != 0 && (math.is_nan(sc.radius_scale) || math.is_inf(sc.radius_scale) || sc.radius_scale < 0.0 || sc.radius_scale > 4.0) {
        >> errors.new("widgets: invalid scope radius scale")
    }
    if (sc.fields & SCOPE_PADDING_SCALE) != 0 && (math.is_nan(sc.padding_scale) || math.is_inf(sc.padding_scale) || sc.padding_scale < 0.25 || sc.padding_scale > 4.0) {
        >> errors.new("widgets: invalid scope padding scale")
    }
    if (sc.fields & SCOPE_FONT_FAMILY) != 0 {
        tf := FontStyle{family: sc.font_family + "",size: 15.0,weight: 400,italic: false,line_height: 0.0}
        validate_font(&tf) or >>
    }
    if (sc.fields & SCOPE_FONT_SIZE_DELTA) != 0 && (math.is_nan(sc.font_size_delta) || math.is_inf(sc.font_size_delta) || math.abs(sc.font_size_delta) > 256.0) {
        >> errors.new("widgets: invalid scope font size delta")
    }
    if (sc.fields & SCOPE_FONT_WEIGHT) != 0 && (sc.font_weight < 100 || sc.font_weight > 900) {
        >> errors.new("widgets: invalid scope font weight")
    }
    if (sc.fields & SCOPE_LINE_HEIGHT) != 0 && !finite_metric(sc.line_height,512.0) {
        >> errors.new("widgets: invalid scope line height")
    }
    if (sc.fields & SCOPE_PALETTE) != 0 { sc.palette.validate() or >> }
    if (sc.fields & SCOPE_BUTTON) != 0 { sc.button.validate() or >> }
    if (sc.fields & SCOPE_INPUT) != 0 { sc.input.validate() or >> }
    if (sc.fields & SCOPE_CHECKBOX) != 0 { sc.checkbox.validate() or >> }
    if (sc.fields & SCOPE_PROGRESS) != 0 { sc.progress.validate() or >> }
    if (sc.fields & SCOPE_SCROLL) != 0 { sc.scroll.validate() or >> }
    << 0
}

pub fn (base &StyleDelta) merge(over &StyleDelta) StyleDelta {
    $res := base.clone()
    f := over.fields
    if f == 0 { << res }
    if (f & SCOPE_DENSITY_SCALE) != 0 { res.density_scale = over.density_scale }
    if (f & SCOPE_TEXT_SCALE_MULT) != 0 { res.text_scale_mult = over.text_scale_mult }
    if (f & SCOPE_RADIUS_SCALE) != 0 { res.radius_scale = over.radius_scale }
    if (f & SCOPE_PADDING_SCALE) != 0 { res.padding_scale = over.padding_scale }
    if (f & SCOPE_BACKGROUND) != 0 { res.background = over.background }
    if (f & SCOPE_FONT_FAMILY) != 0 { res.font_family = over.font_family + "" }
    if (f & SCOPE_FONT_SIZE_DELTA) != 0 { res.font_size_delta = over.font_size_delta }
    if (f & SCOPE_FONT_WEIGHT) != 0 { res.font_weight = over.font_weight }
    if (f & SCOPE_FONT_ITALIC) != 0 { res.font_italic = over.font_italic }
    if (f & SCOPE_LINE_HEIGHT) != 0 { res.line_height = over.line_height }
    if (f & SCOPE_PALETTE) != 0 {
        if (base.fields & SCOPE_PALETTE) != 0 { res.palette = base.palette.merge(&over.palette) }
        else { res.palette = over.palette.clone() }
    }
    if (f & SCOPE_BUTTON) != 0 {
        if (base.fields & SCOPE_BUTTON) != 0 { res.button = base.button.merge(&over.button) }
        else { res.button = over.button.clone() }
    }
    if (f & SCOPE_INPUT) != 0 {
        if (base.fields & SCOPE_INPUT) != 0 { res.input = base.input.merge(&over.input) }
        else { res.input = over.input.clone() }
    }
    if (f & SCOPE_CHECKBOX) != 0 {
        if (base.fields & SCOPE_CHECKBOX) != 0 { res.checkbox = base.checkbox.merge(&over.checkbox) }
        else { res.checkbox = over.checkbox.clone() }
    }
    if (f & SCOPE_PROGRESS) != 0 {
        if (base.fields & SCOPE_PROGRESS) != 0 { res.progress = base.progress.merge(&over.progress) }
        else { res.progress = over.progress.clone() }
    }
    if (f & SCOPE_SCROLL) != 0 {
        if (base.fields & SCOPE_SCROLL) != 0 { res.scroll = base.scroll.merge(&over.scroll) }
        else { res.scroll = over.scroll.clone() }
    }
    res.fields = base.fields | f
    << res
}

fn scale_control_geometry(c $&ControlStyle,scale_r bool,r_scale f64,scale_p bool,p_scale f64) {
    if scale_r {
        c.radius = math.max(0.0,math.min(4096.0,c.radius * r_scale))
    }
    if scale_p {
        c.padding = layout.Insets{
            left: math.max(0.0,math.min(4096.0,c.padding.left * p_scale)),
            top: math.max(0.0,math.min(4096.0,c.padding.top * p_scale)),
            right: math.max(0.0,math.min(4096.0,c.padding.right * p_scale)),
            bottom: math.max(0.0,math.min(4096.0,c.padding.bottom * p_scale))
        }
    }
}

pub fn (base &Styles) apply_scope(sc &StyleDelta) Styles {
    $res := base.clone()
    if sc.fields == 0 { << res }
    f := sc.fields
    if (f & SCOPE_DENSITY_SCALE) != 0 {
        res.density = math.max(0.5,math.min(4.0,res.density * sc.density_scale))
    }
    if (f & SCOPE_TEXT_SCALE_MULT) != 0 {
        res.text_scale = math.max(0.5,math.min(4.0,res.text_scale * sc.text_scale_mult))
    }
    if (f & SCOPE_BACKGROUND) != 0 { res.background = sc.background }
    if (f & SCOPE_FONT_FAMILY) != 0 { res.font.family = sc.font_family + "" }
    if (f & SCOPE_FONT_SIZE_DELTA) != 0 {
        res.font.size = math.max(6.0,math.min(256.0,res.font.size + sc.font_size_delta))
        if res.font.line_height > 0.0 && res.font.line_height < res.font.size { res.font.line_height = res.font.size }
    }
    if (f & SCOPE_FONT_WEIGHT) != 0 { res.font.weight = sc.font_weight }
    if (f & SCOPE_FONT_ITALIC) != 0 { res.font.italic = sc.font_italic }
    if (f & SCOPE_LINE_HEIGHT) != 0 {
        res.font.line_height = sc.line_height
        if res.font.line_height > 0.0 && res.font.line_height < res.font.size {
            res.font.line_height = res.font.size
        }
    }
    if (f & (SCOPE_RADIUS_SCALE | SCOPE_PADDING_SCALE)) != 0 {
        scale_r := (f & SCOPE_RADIUS_SCALE) != 0
        scale_p := (f & SCOPE_PADDING_SCALE) != 0
        scale_control_geometry($&res.button,scale_r,sc.radius_scale,scale_p,sc.padding_scale)
        scale_control_geometry($&res.checkbox,scale_r,sc.radius_scale,scale_p,sc.padding_scale)
        scale_control_geometry($&res.input,scale_r,sc.radius_scale,scale_p,sc.padding_scale)
        scale_control_geometry($&res.text_area,scale_r,sc.radius_scale,scale_p,sc.padding_scale)
        scale_control_geometry($&res.progress,scale_r,sc.radius_scale,scale_p,sc.padding_scale)
        scale_control_geometry($&res.scroll,scale_r,sc.radius_scale,scale_p,sc.padding_scale)
    }
    if (f & SCOPE_PALETTE) != 0 {
        res.button = res.button.apply_patch(&sc.palette)
        res.checkbox = res.checkbox.apply_patch(&sc.palette)
        res.input = res.input.apply_patch(&sc.palette)
        res.text_area = res.text_area.apply_patch(&sc.palette)
        res.progress = res.progress.apply_patch(&sc.palette)
        res.scroll = res.scroll.apply_patch(&sc.palette)
    }
    if (f & SCOPE_BUTTON) != 0 { res.button = res.button.apply_patch(&sc.button) }
    if (f & SCOPE_INPUT) != 0 {
        res.input = res.input.apply_patch(&sc.input)
        res.text_area = res.text_area.apply_patch(&sc.input)
    }
    if (f & SCOPE_CHECKBOX) != 0 { res.checkbox = res.checkbox.apply_patch(&sc.checkbox) }
    if (f & SCOPE_PROGRESS) != 0 { res.progress = res.progress.apply_patch(&sc.progress) }
    if (f & SCOPE_SCROLL) != 0 { res.scroll = res.scroll.apply_patch(&sc.scroll) }
    << res
}

pub fn (styles &Styles) with_opacity(opacity f64) Styles {
    if math.is_nan(opacity) || math.is_inf(opacity) || opacity < 0.0 || opacity > 1.0 {
        >> errors.new("widgets: invalid styles opacity")
    }
    if opacity == 1.0 { << styles.clone() }
    << Styles{
        font: copy_font(&styles.font),
        text_scale: styles.text_scale,
        density: styles.density,
        background: fade_color(styles.background,opacity),
        button: styles.button.with_opacity(opacity) or >>,
        checkbox: styles.checkbox.with_opacity(opacity) or >>,
        input: styles.input.with_opacity(opacity) or >>,
        text_area: styles.text_area.with_opacity(opacity) or >>,
        progress: styles.progress.with_opacity(opacity) or >>,
        scroll: styles.scroll.with_opacity(opacity) or >>
    }
}

fn (s &Styles) apply_patch_all(p &ControlStylePatch) Styles {
    << Styles{
        font: copy_font(&s.font),
        text_scale: s.text_scale,
        density: s.density,
        background: s.background,
        button: s.button.apply_patch(p),
        checkbox: s.checkbox.apply_patch(p),
        input: s.input.apply_patch(p),
        text_area: s.text_area.apply_patch(p),
        progress: s.progress.apply_patch(p),
        scroll: s.scroll.apply_patch(p)
    }
}

pub fn (s $&Screen) set_style_scope(id int,scope &StyleDelta) int {
    _ := s.node(id) or >>
    scope.validate() or >>
    comp := $&s.composition
    scopes := $&comp.style_scopes
    if scopes.has(id) {
        idx := scopes[id] - 1
        comp.style_scope_values[idx] = scope.clone()
    } else if comp.style_scope_free.len > 0 {
        flen := comp.style_scope_free.len
        idx := comp.style_scope_free[flen - 1]
        if flen <= 1 { comp.style_scope_free = []int{} }
        else { comp.style_scope_free = comp.style_scope_free[0:flen - 1] }
        comp.style_scope_values[idx] = scope.clone()
        scopes[id] = idx + 1
        comp.style_scope_count = comp.style_scope_count + 1
    } else {
        idx := comp.style_scope_values.len
        vals := $&comp.style_scope_values
        vals.push(scope.clone())
        scopes[id] = idx + 1
        comp.style_scope_count = comp.style_scope_count + 1
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_style_scope(id int) int {
    _ := s.node(id) or >>
    if s.composition.style_scopes.has(id) {
        comp := $&s.composition
        scopes := $&comp.style_scopes
        old_slot := scopes.take(id)
        if old_slot > 0 {
            free := $&comp.style_scope_free
            free.push(old_slot - 1)
        }
        if comp.style_scope_count > 0 { comp.style_scope_count = comp.style_scope_count - 1 }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s &Screen) has_style_scope(id int) bool {
    _ := s.node(id) or >>
    << s.composition.style_scopes.has(id)
}

pub fn (s &Screen) style_scope(id int) StyleDelta {
    _ := s.node(id) or >>
    if !s.composition.style_scopes.has(id) { << style_delta() }
    idx := s.composition.style_scopes[id] - 1
    << s.composition.style_scope_values[idx].clone()
}

pub fn (s $&Screen) set_slot_style_scope(container int,kind int,scope &StyleDelta) int {
    scope.validate() or >>
    host := s.slot(container,kind) or >>
    << s.set_style_scope(host,scope) or >>
}

pub fn (s $&Screen) clear_slot_style_scope(container int,kind int) int {
    _ := s.node(container) or >>
    host := s.slot_of(container,kind)
    if host <= 0 { << 0 }
    << s.clear_style_scope(host) or >>
}

pub fn (s $&Screen) set_slot_at_style_scope(container int,index int,scope &StyleDelta) int {
    scope.validate() or >>
    host := s.slot_at(container,index) or >>
    << s.set_style_scope(host,scope) or >>
}

pub fn (s $&Screen) clear_slot_at_style_scope(container int,index int) int {
    _ := s.node(container) or >>
    host := s.slot_at_of(container,index)
    if host <= 0 { << 0 }
    << s.clear_style_scope(host) or >>
}

pub fn (s $&Screen) set_control_style_patch(id int,patch &ControlStylePatch) int {
    _ := s.node(id) or >>
    patch.validate() or >>
    comp := $&s.composition
    patches := $&comp.control_patches
    if patches.has(id) {
        idx := patches[id] - 1
        comp.control_patch_values[idx] = patch.clone()
    } else if comp.control_patch_free.len > 0 {
        flen := comp.control_patch_free.len
        idx := comp.control_patch_free[flen - 1]
        if flen <= 1 { comp.control_patch_free = []int{} }
        else { comp.control_patch_free = comp.control_patch_free[0:flen - 1] }
        comp.control_patch_values[idx] = patch.clone()
        patches[id] = idx + 1
    } else {
        idx := comp.control_patch_values.len
        vals := $&comp.control_patch_values
        vals.push(patch.clone())
        patches[id] = idx + 1
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_control_style_patch(id int) int {
    _ := s.node(id) or >>
    if s.composition.control_patches.has(id) {
        comp := $&s.composition
        patches := $&comp.control_patches
        old_slot := patches.take(id)
        if old_slot > 0 {
            free := $&comp.control_patch_free
            free.push(old_slot - 1)
        }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s &Screen) has_control_style_patch(id int) bool {
    _ := s.node(id) or >>
    << s.composition.control_patches.has(id)
}

pub fn (s &Screen) control_style_patch(id int) ControlStylePatch {
    _ := s.node(id) or >>
    if !s.composition.control_patches.has(id) { << control_style_patch() }
    idx := s.composition.control_patches[id] - 1
    << s.composition.control_patch_values[idx].clone()
}

pub fn (s $&Screen) merge_control_style_patch(id int,patch &ControlStylePatch) int {
    _ := s.node(id) or >>
    patch.validate() or >>
    if !s.has_control_style_patch(id) or >> {
        << s.set_control_style_patch(id,patch) or >>
    }
    cur := s.control_style_patch(id) or >>
    merged := cur.merge(patch)
    << s.set_control_style_patch(id,&merged) or >>
}

pub fn (s $&Screen) merge_style_scope(id int,scope &StyleDelta) int {
    _ := s.node(id) or >>
    scope.validate() or >>
    if !s.has_style_scope(id) or >> {
        << s.set_style_scope(id,scope) or >>
    }
    cur := s.style_scope(id) or >>
    merged := cur.merge(scope)
    << s.set_style_scope(id,&merged) or >>
}

fn (s $&Screen) apply_opacity_internal(id int,opacity f64) {
    comp := $&s.composition
    ops := $&comp.opacities
    if opacity == 1.0 {
        if ops.has(id) {
            ops.delete(id)
            if comp.opacity_count > 0 { comp.opacity_count = comp.opacity_count - 1 }
            s.mark_paint_dirty()
        }
        <<
    }
    had := ops.has(id)
    prev := ops.get_or(id,1.0)
    ops[id] = opacity
    if !had { comp.opacity_count = comp.opacity_count + 1 }
    if prev != opacity { s.mark_paint_dirty() }
}

pub fn (s $&Screen) set_opacity(id int,opacity f64) int {
    _ := s.node(id) or >>
    if math.is_nan(opacity) || math.is_inf(opacity) || opacity < 0.0 || opacity > 1.0 {
        >> errors.new("widgets: invalid node opacity")
    }
    s.cancel_opacity_transition(id)
    s.apply_opacity_internal(id,opacity)
    << 0
}

pub fn (s &Screen) opacity(id int) f64 {
    _ := s.node(id) or >>
    << s.composition.opacities.get_or(id,1.0)
}

pub fn (s &Screen) effective_opacity(id int) f64 {
    _ := s.node(id) or >>
    if s.composition.opacity_count == 0 { << 1.0 }
    $op := 1.0
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        if s.composition.opacities.has(cur) {
            op = op * s.composition.opacities[cur]
        }
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << math.max(0.0,math.min(1.0,op))
}

fn (s &Screen) has_any_style_overrides() bool {
    << s.composition.subtree_style_count > 0 || s.composition.style_scope_count > 0
}

fn (s &Screen) resolve_node_styles(id int,inherited &Styles) Styles {
    if !s.has_any_style_overrides() || id <= 0 || id > s.nodes.len { << inherited.clone() }
    has_sub := s.composition.subtree_styles.has(id)
    has_scope := s.composition.style_scopes.has(id)
    if !has_sub && !has_scope { << inherited.clone() }
    $res := inherited.clone()
    if has_sub {
        idx := s.composition.subtree_styles[id] - 1
        res = s.composition.subtree_style_values[idx].clone()
    }
    if has_scope {
        sidx := s.composition.style_scopes[id] - 1
        res = res.apply_scope(&s.composition.style_scope_values[sidx])
    }
    << res
}

fn (s &Screen) resolve_styles_with_patch(id int,styles &Styles) Styles {
    if !s.composition.control_patches.has(id) { << styles.clone() }
    idx := s.composition.control_patches[id] - 1
    << styles.apply_patch_all(&s.composition.control_patch_values[idx])
}

fn (s &Screen) style_or_patched(id int,base &ControlStyle) ControlStyle {
    if !s.composition.control_patches.has(id) { << base.clone() }
    idx := s.composition.control_patches[id] - 1
    << base.apply_patch(&s.composition.control_patch_values[idx])
}
