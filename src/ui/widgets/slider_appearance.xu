@ui/widgets
#ui/draw
#ui/layout
#math
#errors
#strconv

pub struct SliderAppearance {
    pub ticks int
    pub show_value bool
    pub decimals int
}
pub fn slider_appearance() SliderAppearance { << SliderAppearance{ticks: 0,show_value: false,decimals: 0} }
pub fn (appearance &SliderAppearance) validate() int {
    if appearance.ticks < 0 || appearance.ticks == 1 || appearance.ticks > 128 || appearance.decimals < 0 || appearance.decimals > 6 {
        >> errors.new("widgets: invalid slider appearance")
    }
    << 0
}
pub fn (s $&Slider) set_appearance(appearance &SliderAppearance) int {
    appearance.validate() or >>
    s.appearance = SliderAppearance{ticks: appearance.ticks,show_value: appearance.show_value,decimals: appearance.decimals}
    s.dirty = true
    << 0
}
pub fn (s &Slider) shows_value() bool { << s.appearance.show_value }
fn (s &Slider) value_height(styles &Styles) f64 {
    if !s.appearance.show_value { << 0.0 }
    c := s.style_or(styles)
    << styles.text_options(&c).size * 1.4 + 4.0 * styles.density
}
pub fn (s &Slider) value_text() string {
    value := strconv.format_float(s.val,102,s.appearance.decimals) or >>
    << localized_number(value,&s.locale)
}
pub fn (s &Slider) paint_value_styled(frame $&draw.Frame,label $&StyledLabel,styles &Styles) int {
    if !s.appearance.show_value { << 0 }
    text := s.value_text() or >>
    label.set_text(&text)
    $c := s.style_or(styles)
    c.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    c.align_x = 0.5
    height := s.value_height(styles)
    size := label.measure_styled(styles,&c) or >>
    width := math.min(s.bounds.width,size.width + 16.0 * styles.density)
    center := s.bounds.x + s.inset_left + s.thumb_extent * 0.5 + math.max(0.0,s.bounds.width - s.inset_left - s.inset_right - s.thumb_extent) * s.ratio()
    x := math.max(s.bounds.x,math.min(s.bounds.x + s.bounds.width - width,center - width * 0.5))
    rect := layout.Rect{x: x,y: s.bounds.y + s.bounds.height - height,width: width,height: height}
    << label.paint_text_styled(frame,&rect,styles,&c,s.visual_state()) or >>
}
fn basic_slider_value(item &Slider,label $&StyledLabel,frame $&draw.Frame,styles &Styles) string {
    item.paint_value_styled(frame,label,styles) or (err) { << err.msg() }
    << ""
}
