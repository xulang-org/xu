@ui/widgets
#errors

struct TableRowQuery { value int
    text string
    error string }

pub fn (s $&Screen) sort_table(id int,column int,descending bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_TABLE { >> errors.new("widgets: expected Table") }
    owner := $&s.controls
    entries := $&owner.tables
    $item := entries.take(id)
    message := screen_sort_table($&item,column,descending)
    entries[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_sort_table(item $&Table,column int,descending bool) string {
    item.sort_by(column,descending) or (err) { << err.msg() }
    << ""
}

