pub fn (s $&Screen) table_row_at(id int,row int) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_TABLE { >> errors.new("widgets: expected Table") }
    owner := $&s.controls
    entries := $&owner.tables
    item := entries.take(id)
    result := screen_table_row_at(&item,row)
    entries[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.value
}
fn screen_table_row_at(item &Table,row int) TableRowQuery {
    value := item.row_at(row) or (err) { << TableRowQuery{value: 0,text: "",error: err.msg()} }
    << TableRowQuery{value: value,text: "",error: ""}
}

