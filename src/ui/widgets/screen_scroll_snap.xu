@ui/widgets

#ui/layout
#errors
#math

pub const SNAP_START = 0
pub const SNAP_CENTER = 1
pub const SNAP_END = 2

pub struct ScrollSnapConfig {
    pub step f64
    pub align int
    pub mandatory bool
    pub duration_ms int
}

pub fn scroll_snap_config(step f64,align int) ScrollSnapConfig {
    << ScrollSnapConfig{
        step: step,
        align: align,
        mandatory: true,
        duration_ms: 220
    }
}

pub fn (c &ScrollSnapConfig) validate() int {
    if math.is_nan(c.step) || math.is_inf(c.step) || c.step < 0.0 || c.step > 100000.0 {
        >>> errors.new("widgets: invalid scroll snap step")
    }
    if c.align < SNAP_START || c.align > SNAP_END {
        >>> errors.new("widgets: invalid scroll snap align")
    }
    if c.duration_ms < 0 || c.duration_ms > 5000 {
        >>> errors.new("widgets: invalid scroll snap duration")
    }
    << 0
}

fn copy_scroll_snap_config(c &ScrollSnapConfig) ScrollSnapConfig {
    << ScrollSnapConfig{
        step: c.step,
        align: c.align,
        mandatory: c.mandatory,
        duration_ms: c.duration_ms
    }
}

pub fn (s $&Screen) set_scroll_snap(scroll_id int,cfg &ScrollSnapConfig) int {
    _ := s.node(scroll_id) >>>
    if !s.basics.scrolls.has(scroll_id) { >>> errors.new("widgets: expected Scroll") }
    cfg.validate() >>>
    comp := $&s.composition
    snaps := $&comp.scroll_snaps
    snaps[scroll_id] = copy_scroll_snap_config(cfg)
    << 0
}

pub fn (s $&Screen) clear_scroll_snap(scroll_id int) int {
    _ := s.node(scroll_id) >>>
    comp := $&s.composition
    if comp.scroll_snaps.has(scroll_id) {
        snaps := $&comp.scroll_snaps
        snaps.delete(scroll_id)
    }
    << 0
}

fn (s &Screen) snap_candidate_container(scroll_id int) int {
    mounted := s.mounted_in(scroll_id,SLOT_CONTENT)
    if mounted > 0 && mounted <= s.nodes.len && s.nodes[mounted - 1].kind >= 0 {
        if s.child_count_of(mounted) > 0 { << mounted }
    }
    << scroll_id
}

fn (s &Screen) snap_axis_extent(r &layout.Rect,axis int) f64 {
    if axis == AXIS_HORIZONTAL { << r.width }
    << r.height
}

fn (s &Screen) snap_axis_pos(r &layout.Rect,axis int) f64 {
    if axis == AXIS_HORIZONTAL { << r.x }
    << r.y
}

fn snap_candidate_offset(c_start f64,c_ext f64,vp_ext f64,align int) f64 {
    if align == SNAP_CENTER { << c_start + c_ext * 0.5 - vp_ext * 0.5 }
    if align == SNAP_END { << c_start + c_ext - vp_ext }
    << c_start
}

pub fn (s &Screen) scroll_snap_target(scroll_id int) f64 {
    _ := s.node(scroll_id) >>>
    if !s.basics.scrolls.has(scroll_id) { >>> errors.new("widgets: expected Scroll") }
    if !s.composition.scroll_snaps.has(scroll_id) {
        << s.basics.scrolls[scroll_id].offset()
    }
    cfg := s.composition.scroll_snaps[scroll_id]
    off := s.basics.scrolls[scroll_id].offset()
    max_off := s.basics.scrolls[scroll_id].max_offset()
    if cfg.step > 0.0 {
        snapped := math.floor(off / cfg.step + 0.5) * cfg.step
        << math.max(0.0,math.min(max_off,snapped))
    }
    axis := s.basics.scrolls[scroll_id].axis()
    clip := s.scroll_content_clip(scroll_id)
    vp_ext := s.snap_axis_extent(&clip,axis)
    container := s.snap_candidate_container(scroll_id)
    $base_pos := 0.0
    if container != scroll_id {
        cb := s.nodes[container - 1].local
        base_pos = s.snap_axis_pos(&cb,axis)
    }
    ordered := s.order_sorted_live_children(container)
    $best_off := off
    $best_dist := 1000000000.0
    $found := false
    for i in 0:ordered.len {
        cid := ordered[i]
        if !s.is_visible(cid) { -> }
        nl := s.nodes[cid - 1].local
        c_start := base_pos + s.snap_axis_pos(&nl,axis)
        c_ext := s.snap_axis_extent(&nl,axis)
        $cand := snap_candidate_offset(c_start,c_ext,vp_ext,cfg.align)
        cand = math.max(0.0,math.min(max_off,cand))
        dist := math.abs(cand - off)
        if !found || dist < best_dist {
            best_dist = dist
            best_off = cand
            found = true
        }
    }
    << best_off
}

pub fn (s &Screen) scroll_snap_index(scroll_id int) int {
    _ := s.node(scroll_id) >>>
    if !s.basics.scrolls.has(scroll_id) { >>> errors.new("widgets: expected Scroll") }
    if !s.composition.scroll_snaps.has(scroll_id) { << 0 }
    cfg := s.composition.scroll_snaps[scroll_id]
    off := s.basics.scrolls[scroll_id].offset()
    if cfg.step > 0.0 {
        idx := int(math.floor(off / cfg.step + 0.5))
        if idx < 0 { << 0 }
        << idx
    }
    axis := s.basics.scrolls[scroll_id].axis()
    clip := s.scroll_content_clip(scroll_id)
    vp_ext := s.snap_axis_extent(&clip,axis)
    container := s.snap_candidate_container(scroll_id)
    $base_pos := 0.0
    if container != scroll_id {
        cb := s.nodes[container - 1].local
        base_pos = s.snap_axis_pos(&cb,axis)
    }
    ordered := s.order_sorted_live_children(container)
    $best_idx := 0
    $best_dist := 1000000000.0
    $vis_i := 0
    for i in 0:ordered.len {
        cid := ordered[i]
        if !s.is_visible(cid) { -> }
        nl := s.nodes[cid - 1].local
        c_start := base_pos + s.snap_axis_pos(&nl,axis)
        c_ext := s.snap_axis_extent(&nl,axis)
        cand := snap_candidate_offset(c_start,c_ext,vp_ext,cfg.align)
        dist := math.abs(cand - off)
        if vis_i == 0 || dist < best_dist {
            best_dist = dist
            best_idx = vis_i
        }
        vis_i += 1
    }
    << best_idx
}

pub fn (s $&Screen) snap_scroll(scroll_id int,smooth bool) int {
    target := s.scroll_snap_target(scroll_id) >>>
    $dur := 220
    if s.composition.scroll_snaps.has(scroll_id) {
        dur = s.composition.scroll_snaps[scroll_id].duration_ms
    }
    if smooth && dur > 0 {
        << s.smooth_scroll_to(scroll_id,target) >>>
    }
    << s.set_scroll_offset(scroll_id,target) >>>
}

pub fn (s $&Screen) snap_scroll_to_index(scroll_id int,index int,smooth bool) int {
    _ := s.node(scroll_id) >>>
    if !s.basics.scrolls.has(scroll_id) { >>> errors.new("widgets: expected Scroll") }
    if index < 0 { >>> errors.new("widgets: invalid scroll snap index") }
    $dur := 220
    $target := 0.0
    if s.composition.scroll_snaps.has(scroll_id) {
        cfg := s.composition.scroll_snaps[scroll_id]
        dur = cfg.duration_ms
        if cfg.step > 0.0 {
            target = f64(index) * cfg.step
        } else {
            axis := s.basics.scrolls[scroll_id].axis()
            clip := s.scroll_content_clip(scroll_id)
            vp_ext := s.snap_axis_extent(&clip,axis)
            container := s.snap_candidate_container(scroll_id)
            $base_pos := 0.0
            if container != scroll_id {
                cb := s.nodes[container - 1].local
                base_pos = s.snap_axis_pos(&cb,axis)
            }
            ordered := s.order_sorted_live_children(container)
            $vis_i := 0
            $found := false
            for i in 0:ordered.len {
                cid := ordered[i]
                if !s.is_visible(cid) { -> }
                if vis_i == index {
                    nl := s.nodes[cid - 1].local
                    c_start := base_pos + s.snap_axis_pos(&nl,axis)
                    c_ext := s.snap_axis_extent(&nl,axis)
                    target = snap_candidate_offset(c_start,c_ext,vp_ext,cfg.align)
                    found = true
                    <-
                }
                vis_i += 1
            }
            if !found { >>> errors.new("widgets: scroll snap index out of range") }
        }
    } else {
        target = s.scroll_snap_target(scroll_id) >>>
    }
    max_off := s.basics.scrolls[scroll_id].max_offset()
    target = math.max(0.0,math.min(max_off,target))
    if smooth && dur > 0 {
        << s.smooth_scroll_to(scroll_id,target) >>>
    }
    << s.set_scroll_offset(scroll_id,target) >>>
}

fn (s $&Screen) cleanup_scroll_snap_for(id int) {
    comp := $&s.composition
    if comp.scroll_snaps.has(id) {
        snaps := $&comp.scroll_snaps
        snaps.delete(id)
    }
}
