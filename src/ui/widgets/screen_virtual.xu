@ui/widgets

#ui/layout
#errors
#math

pub const ACTION_VIRTUAL_RANGE = 24

pub struct VirtualConfig {
    pub total_count int
    pub item_extent f64
    pub columns int
    pub gap f64
    pub overscan int
}

pub struct VirtualRange {
    pub start_index int
    pub end_index int
    pub total_extent f64
    pub scroll_offset f64
    pub viewport_extent f64
}

struct VirtualEntry {
    cfg VirtualConfig
    item_extents map[int]f64
    item_extent_count int
    last_start int
    last_end int
    has_last bool
}

pub fn virtual_config(total_count int,item_extent f64) VirtualConfig {
    << VirtualConfig{
        total_count: total_count,
        item_extent: item_extent,
        columns: 1,
        gap: 0.0,
        overscan: 2
    }
}

pub fn virtual_grid_config(total_count int,item_extent f64,columns int,gap f64) VirtualConfig {
    << VirtualConfig{
        total_count: total_count,
        item_extent: item_extent,
        columns: columns,
        gap: gap,
        overscan: 2
    }
}

pub fn (c &VirtualConfig) validate() int {
    if c.total_count < 0 || c.columns < 1 || c.columns > 64 || c.overscan < 0 || c.overscan > 32 ||
       math.is_nan(c.item_extent) || math.is_inf(c.item_extent) || c.item_extent <= 0.0 || c.item_extent > 100000.0 ||
       math.is_nan(c.gap) || math.is_inf(c.gap) || c.gap < 0.0 || c.gap > 1024.0 {
        >> errors.new("widgets: invalid virtual config")
    }
    << 0
}

fn copy_virtual_config(c &VirtualConfig) VirtualConfig {
    << VirtualConfig{
        total_count: c.total_count,
        item_extent: c.item_extent,
        columns: c.columns,
        gap: c.gap,
        overscan: c.overscan
    }
}

fn virtual_row_extent(ve &VirtualEntry,row int) f64 {
    if ve.item_extent_count == 0 { << ve.cfg.item_extent }
    cols := ve.cfg.columns
    if cols <= 1 {
        if ve.item_extents.has(row) { << ve.item_extents[row] }
        << ve.cfg.item_extent
    }
    $max_ext := ve.cfg.item_extent
    $has_override := false
    base := row * cols
    for c in 0:cols {
        idx := base + c
        if idx >= ve.cfg.total_count { <- }
        if ve.item_extents.has(idx) {
            ext := ve.item_extents[idx]
            if !has_override {
                max_ext = ext
                has_override = true
            } else if ext > max_ext {
                max_ext = ext
            }
        }
    }
    << max_ext
}

fn virtual_total_extent(ve &VirtualEntry) f64 {
    total := ve.cfg.total_count
    if total <= 0 { << 0.0 }
    $cols := ve.cfg.columns
    if cols < 1 { cols = 1 }
    rows := (total + cols - 1) / cols
    if ve.item_extent_count == 0 {
        << f64(rows) * ve.cfg.item_extent + f64(rows - 1) * ve.cfg.gap
    }
    $acc := 0.0
    for r in 0:rows {
        if r > 0 { acc = acc + ve.cfg.gap }
        acc = acc + virtual_row_extent(ve,r)
    }
    << acc
}

fn virtual_row_start_offset(ve &VirtualEntry,target_row int) f64 {
    if target_row <= 0 { << 0.0 }
    if ve.item_extent_count == 0 {
        << f64(target_row) * (ve.cfg.item_extent + ve.cfg.gap)
    }
    $acc := 0.0
    for r in 0:target_row {
        acc = acc + virtual_row_extent(ve,r) + ve.cfg.gap
    }
    << acc
}

fn compute_virtual_range(ve &VirtualEntry,offset f64,vp_ext f64) VirtualRange {
    total := ve.cfg.total_count
    $cols := ve.cfg.columns
    if cols < 1 { cols = 1 }
    tot_ext := virtual_total_extent(ve)
    if total <= 0 {
        << VirtualRange{start_index: 0,end_index: 0,total_extent: 0.0,scroll_offset: offset,viewport_extent: vp_ext}
    }
    rows := (total + cols - 1) / cols
    $first_row := 0
    $last_row := rows
    if ve.item_extent_count == 0 {
        stride := ve.cfg.item_extent + ve.cfg.gap
        $vr_start := int(math.floor(offset / stride))
        if vr_start < 0 { vr_start = 0 }
        $vr_end := int(math.ceil((offset + math.max(0.0,vp_ext)) / stride))
        if vr_end < vr_start + 1 && vp_ext > 0.0 { vr_end = vr_start + 1 }
        first_row = vr_start - ve.cfg.overscan
        if first_row < 0 { first_row = 0 }
        last_row = vr_end + ve.cfg.overscan
        if last_row > rows { last_row = rows }
    } else {
        $y := 0.0
        $found_first := false
        $vr_start := 0
        $vr_end := 0
        view_end := offset + math.max(0.0,vp_ext)
        for r in 0:rows {
            re := virtual_row_extent(ve,r)
            if y + re > offset && !found_first {
                vr_start = r
                found_first = true
            }
            if y < view_end {
                vr_end = r + 1
            } else if found_first {
                <-
            }
            y = y + re + ve.cfg.gap
        }
        if !found_first {
            vr_start = rows - 1
            vr_end = rows
        }
        first_row = vr_start - ve.cfg.overscan
        if first_row < 0 { first_row = 0 }
        last_row = vr_end + ve.cfg.overscan
        if last_row > rows { last_row = rows }
    }
    $s_idx := first_row * cols
    if s_idx > total { s_idx = total }
    $e_idx := last_row * cols
    if e_idx > total { e_idx = total }
    << VirtualRange{
        start_index: s_idx,
        end_index: e_idx,
        total_extent: tot_ext,
        scroll_offset: offset,
        viewport_extent: vp_ext
    }
}

pub fn (s $&Screen) set_virtual_viewport(scroll_id int,cfg &VirtualConfig) int {
    _ := s.node(scroll_id) >>>
    if !s.basics.scrolls.has(scroll_id) { >> errors.new("widgets: virtual viewport requires a scroll_area") }
    cfg.validate() >>>
    $entry := VirtualEntry{
        cfg: copy_virtual_config(cfg),
        item_extents: map[int]f64{},
        item_extent_count: 0,
        last_start: 0,
        last_end: 0,
        has_last: false
    }
    tot := virtual_total_extent(&entry)
    comp := $&s.composition
    vps := $&comp.virtual_viewports
    had := vps.has(scroll_id)
    vps[scroll_id] = entry
    if !had {
        vpids := $&comp.virtual_viewport_ids
        vpids.push(scroll_id)
    }
    s.set_scroll_extent(scroll_id,tot) >>>
    if s.nodes[scroll_id - 1].bounds.width > 0.0 || s.nodes[scroll_id - 1].bounds.height > 0.0 {
        r := s.virtual_range(scroll_id) >>>
        comp2 := $&s.composition
        vps2 := $&comp2.virtual_viewports
        $e2 := vps2.take(scroll_id)
        e2.last_start = r.start_index
        e2.last_end = r.end_index
        e2.has_last = true
        vps2[scroll_id] = e2
    }
    << 0
}

pub fn (s $&Screen) clear_virtual_viewport(scroll_id int) int {
    _ := s.node(scroll_id) >>>
    comp := $&s.composition
    if comp.virtual_viewports.has(scroll_id) {
        vps := $&comp.virtual_viewports
        vps.delete(scroll_id)
        next := vec_without(&comp.virtual_viewport_ids,scroll_id)
        comp.virtual_viewport_ids = next
    }
    << 0
}

pub fn (s $&Screen) set_virtual_count(scroll_id int,total_count int) int {
    _ := s.node(scroll_id) >>>
    if !s.composition.virtual_viewports.has(scroll_id) { >> errors.new("widgets: virtual viewport not configured") }
    if total_count < 0 { >> errors.new("widgets: invalid virtual total_count") }
    comp := $&s.composition
    vps := $&comp.virtual_viewports
    $entry := vps.take(scroll_id)
    entry.cfg.total_count = total_count
    tot := virtual_total_extent(&entry)
    vps[scroll_id] = entry
    s.set_scroll_extent(scroll_id,tot) >>>
    << 0
}

pub fn (s $&Screen) set_virtual_item_extent(scroll_id int,index int,extent f64) int {
    _ := s.node(scroll_id) >>>
    if !s.composition.virtual_viewports.has(scroll_id) { >> errors.new("widgets: virtual viewport not configured") }
    if index < 0 || math.is_nan(extent) || math.is_inf(extent) || extent <= 0.0 || extent > 100000.0 {
        >> errors.new("widgets: invalid virtual item extent")
    }
    comp := $&s.composition
    vps := $&comp.virtual_viewports
    $entry := vps.take(scroll_id)
    had := entry.item_extents.has(index)
    exts := $&entry.item_extents
    exts[index] = extent
    if !had { entry.item_extent_count = entry.item_extent_count + 1 }
    tot := virtual_total_extent(&entry)
    vps[scroll_id] = entry
    s.set_scroll_extent(scroll_id,tot) >>>
    << 0
}

pub fn (s &Screen) virtual_range(scroll_id int) VirtualRange {
    _ := s.node(scroll_id) >>>
    if !s.basics.scrolls.has(scroll_id) || !s.composition.virtual_viewports.has(scroll_id) {
        >> errors.new("widgets: expected virtual scroll_area")
    }
    off := s.basics.scrolls[scroll_id].offset()
    clip := s.scroll_content_clip(scroll_id)
    axis := s.basics.scrolls[scroll_id].axis()
    $vp_ext := clip.height
    if axis == AXIS_HORIZONTAL { vp_ext = clip.width }
    ve := &s.composition.virtual_viewports[scroll_id]
    << compute_virtual_range(ve,off,vp_ext)
}

pub fn (s &Screen) virtual_item_offset(scroll_id int,index int) f64 {
    _ := s.node(scroll_id) >>>
    if !s.composition.virtual_viewports.has(scroll_id) { >> errors.new("widgets: virtual viewport not configured") }
    if index < 0 { >> errors.new("widgets: invalid virtual item index") }
    ve := &s.composition.virtual_viewports[scroll_id]
    $cols := ve.cfg.columns
    if cols < 1 { cols = 1 }
    row := index / cols
    << virtual_row_start_offset(ve,row)
}

pub fn (s &Screen) virtual_item_rect(scroll_id int,index int) layout.Rect {
    _ := s.node(scroll_id) >>>
    if !s.basics.scrolls.has(scroll_id) || !s.composition.virtual_viewports.has(scroll_id) {
        >> errors.new("widgets: expected virtual scroll_area")
    }
    if index < 0 { >> errors.new("widgets: invalid virtual item index") }
    clip := s.scroll_content_clip(scroll_id)
    axis := s.basics.scrolls[scroll_id].axis()
    ve := &s.composition.virtual_viewports[scroll_id]
    $cols := ve.cfg.columns
    if cols < 1 { cols = 1 }
    row := index / cols
    col := index % cols
    main_pos := virtual_row_start_offset(ve,row)
    $main_ext := ve.cfg.item_extent
    if ve.item_extent_count > 0 && ve.item_extents.has(index) {
        main_ext = ve.item_extents[index]
    } else if ve.item_extent_count > 0 && cols > 1 {
        main_ext = virtual_row_extent(ve,row)
    }
    if axis == AXIS_HORIZONTAL {
        cross_total := math.max(0.0,clip.height - f64(cols - 1) * ve.cfg.gap)
        cw := cross_total / f64(cols)
        cy := f64(col) * (cw + ve.cfg.gap)
        << layout.Rect{x: main_pos,y: cy,width: main_ext,height: cw}
    }
    cross_total := math.max(0.0,clip.width - f64(cols - 1) * ve.cfg.gap)
    cw := cross_total / f64(cols)
    cx := f64(col) * (cw + ve.cfg.gap)
    << layout.Rect{x: cx,y: main_pos,width: cw,height: main_ext}
}

pub fn (s $&Screen) scroll_to_virtual_index(scroll_id int,index int,smooth bool) int {
    pos := s.virtual_item_offset(scroll_id,index) >>>
    if smooth {
        << s.smooth_scroll_to(scroll_id,pos) >>>
    }
    << s.set_scroll_offset(scroll_id,pos) >>>
}

fn (s $&Screen) check_virtual_viewports() {
    vcount := s.composition.virtual_viewport_ids.len
    if vcount == 0 { << }
    for i in 0:vcount {
        sid := s.composition.virtual_viewport_ids[i]
        if sid <= 0 || sid > s.nodes.len || s.nodes[sid - 1].kind < 0 || !s.composition.virtual_viewports.has(sid) { -> }
        r := s.virtual_range(sid) >>> (err) { -> }
        comp := $&s.composition
        vps := $&comp.virtual_viewports
        $entry := vps.take(sid)
        $changed := false
        if !entry.has_last {
            entry.has_last = true
            entry.last_start = r.start_index
            entry.last_end = r.end_index
        } else if entry.last_start != r.start_index || entry.last_end != r.end_index {
            entry.last_start = r.start_index
            entry.last_end = r.end_index
            changed = true
        }
        vps[sid] = entry
        if changed {
            qa := $&s.queued_actions
            qa.push(Action{kind: ACTION_VIRTUAL_RANGE,id: sid,needs_paint: true,request_focus: false,consumed: false,value: f64(r.start_index)})
        }
    }
}

fn (s $&Screen) cleanup_virtual_viewport_for(id int) {
    comp := $&s.composition
    if comp.virtual_viewports.has(id) {
        vps := $&comp.virtual_viewports
        vps.delete(id)
        next := vec_without(&comp.virtual_viewport_ids,id)
        comp.virtual_viewport_ids = next
    }
}
