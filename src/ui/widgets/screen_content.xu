@ui/widgets
#ui/draw
#ui/layout
#time
#math
#errors

// Screen owns the loaded image until disposal. text retains the action's name;
// pair the handle with tooltip() to expose that name to pointer/keyboard users.
pub fn (s $&Screen) icon_button(asset string,text string) int {
    if text.len == 0 { >> errors.new("widgets: an icon button needs an action name") }
    icon := s.context.load_embedded_image(&asset) or >>
    id := s.button(text) or (err) { $owned := icon
        owned.dispose() or (ignored) { >> err }
        >> err }
    s.basics.button_icons[id] = icon
    << id
}
// A visible image plus label, with normal Button focus, variants and actions.
// ControlStyle.icon_placement selects leading/trailing/above/below placement.
pub fn (s $&Screen) button_with_icon(asset string,text string) int {
    id := s.icon_button(asset,text) or >>
    s.basics.button_icon_labels[id] = true
    << id
}
// Intrinsic size in Screen coordinates, including the current style, density,
// text scale and icon placement. Call again after changing any of those inputs.
pub fn (s $&Screen) measure_button(id int) layout.Size {
    n := s.node(id) or >>
    if n.kind != SCREEN_BUTTON { >> errors.new("widgets: expected Button") }
    styles := s.styles.clone()
    item := s.take_button(id)
    base := s.screen_button_style(id,&item,&styles) or (err) { s.buttons[id] = item.clone()
        >> err }
    s.buttons[id] = item
    slot := id * 2
    if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
    $cache := s.take_label_cache(slot)
    value := s.texts[id - 1] + ""
    icon := s.basics.button_icons.has(id)
    labeled := s.basics.button_icon_labels.has(id)
    result := screen_measure_button($&cache,&value,&styles,&base,icon,labeled)
    s.labels[slot] = cache
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.size
}
struct ButtonSizeResult { size layout.Size
    error string }
fn screen_measure_button(cache $&TextCache,text &string,styles &Styles,c &ControlStyle,icon bool,labeled bool) ButtonSizeResult {
    $content := layout.Size{width: 0.0,height: 0.0}
    if !icon || labeled {
        content = cache.measure(0,text,styles,c) or (err) { << ButtonSizeResult{size: content,error: err.msg()} }
    }
    if icon {
        if labeled { content = icon_label_size(&content,c,styles.density,text.len > 0) }
        else { side := math.max(16.0,c.indicator_size) * styles.density * styles.text_scale
            content = layout.Size{width: side,height: side} }
    }
    << ButtonSizeResult{size: padded_button_size(&content,c,styles.density),error: ""}
}
fn screen_paint_labeled_icon_button(item &Button,motion $&PaintTransition,cache $&TextCache,image &draw.Image,frame $&draw.Frame,bounds &layout.Rect,
    styles &Styles,base &ControlStyle,text &string,opacity f64,now time.Instant,reduced bool) string {
    state := item.visual_state()
    c := motion.style(base,state,now,reduced) or (err) { << err.msg() }
    faded := c.with_opacity(opacity) or (err) { << err.msg() }
    _ := cache.measure(0,text,styles,&faded) or (err) { << err.msg() }
    shaped := cache.layout_at(0) or (err) { << err.msg() }
    paint_icon_label(frame,bounds,&faded,styles,&shaped,true,image,state) or (err) { << err.msg() }
    << ""
}
pub fn (s $&Screen) set_label_wrapped(id int,wrapped bool) int {
    n := s.node(id) or >>
    if n.kind != SCREEN_LABEL { >> errors.new("widgets: expected Label") }
    if wrapped { s.basics.wrapped_labels[id] = true }
    else { owner := $&s.basics
        labels := $&owner.wrapped_labels
        if labels.has(id) { _ := labels.take(id) } }
    s.dirty = true
    << 0
}
fn screen_paint_icon_button(item &Button,motion $&PaintTransition,image &draw.Image,frame $&draw.Frame,bounds &layout.Rect,
    styles &Styles,base &ControlStyle,opacity f64,now time.Instant,reduced bool) string {
    state := item.visual_state()
    c := motion.style(base,state,now,reduced) or (err) { << err.msg() }
    faded := c.with_opacity(opacity) or (err) { << err.msg() }
    style_box(frame,bounds,&faded,styles.density,state) or (err) { << err.msg() }
    side := math.min(math.min(bounds.width,bounds.height),math.max(16.0,c.indicator_size) * styles.density * styles.text_scale)
    target := draw.ImageRect{x: bounds.x + (bounds.width - side) * 0.5,y: bounds.y + (bounds.height - side) * 0.5,width: side,height: side}
    source := draw.ImageRect{x: 0.0,y: 0.0,width: f64(image.width),height: f64(image.height)}
    $alpha := opacity
    if !item.is_enabled() { alpha *= 0.45 }
    frame.image_region(image,&source,&target,alpha,draw.SAMPLER_LINEAR) or (err) { << err.msg() }
    << ""
}
