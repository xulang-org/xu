@ui/widgets
#ui/draw
#ui/layout
#time
#math
#errors

// Screen owns the loaded image until disposal. text retains the action's name;
// pair the handle with tooltip() to expose that name to pointer/keyboard users.
pub fn (s &mut Screen) icon_button(asset string,text string) int {
    if text.len == 0 { >> errors.new("widgets: an icon button needs an action name") }
    icon := s.context.load_embedded_image(&asset) or >>
    id := s.button(text) or (err) { mut owned := icon
        owned.dispose() or (ignored) { >> err }
        >> err }
    s.basics.button_icons[id] = icon
    << id
}
// A visible image plus label, with normal Button focus, variants and actions.
// ControlStyle.icon_placement selects leading/trailing/above/below placement.
pub fn (s &mut Screen) button_with_icon(asset string,text string) int {
    id := s.icon_button(asset,text) or >>
    s.basics.button_icon_labels[id] = true
    << id
}
fn screen_paint_labeled_icon_button(item &Button,motion &mut PaintTransition,cache &mut TextCache,image &draw.Image,frame &mut draw.Frame,bounds &layout.Rect,
    styles &Styles,base &ControlStyle,text &string,opacity f64,now time.Instant,reduced bool) string {
    state := item.visual_state()
    c := motion.style(base,state,now,reduced) or (err) { << err.msg() }
    faded := c.with_opacity(opacity) or (err) { << err.msg() }
    _ := cache.measure(0,text,styles,&faded) or (err) { << err.msg() }
    shaped := cache.layout_at(0) or (err) { << err.msg() }
    paint_icon_label(frame,bounds,&faded,styles,&shaped,true,image,state) or (err) { << err.msg() }
    << ""
}
pub fn (s &mut Screen) set_label_wrapped(id int,wrapped bool) int {
    n := s.node(id) or >>
    if n.kind != SCREEN_LABEL { >> errors.new("widgets: expected Label") }
    if wrapped { s.basics.wrapped_labels[id] = true }
    else { owner := mut &s.basics
        labels := mut &owner.wrapped_labels
        if labels.has(id) { _ := labels.take(id) } }
    s.dirty = true
    << 0
}
fn screen_paint_icon_button(item &Button,motion &mut PaintTransition,image &draw.Image,frame &mut draw.Frame,bounds &layout.Rect,
    styles &Styles,base &ControlStyle,opacity f64,now time.Instant,reduced bool) string {
    state := item.visual_state()
    c := motion.style(base,state,now,reduced) or (err) { << err.msg() }
    faded := c.with_opacity(opacity) or (err) { << err.msg() }
    style_box(frame,bounds,&faded,styles.density,state) or (err) { << err.msg() }
    side := math.min(math.min(bounds.width,bounds.height),math.max(16.0,c.indicator_size) * styles.density * styles.text_scale)
    target := draw.ImageRect{x: bounds.x + (bounds.width - side) * 0.5,y: bounds.y + (bounds.height - side) * 0.5,width: side,height: side}
    source := draw.ImageRect{x: 0.0,y: 0.0,width: f64(image.width),height: f64(image.height)}
    mut alpha := opacity
    if !item.is_enabled() { alpha *= 0.45 }
    frame.image_region(image,&source,&target,alpha,draw.SAMPLER_LINEAR) or (err) { << err.msg() }
    << ""
}
