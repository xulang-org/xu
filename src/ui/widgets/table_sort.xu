@ui/widgets
#strings
#strconv
#math
#errors

pub const TABLE_SORT_TEXT = 0
pub const TABLE_SORT_NUMBER = 1
struct TableSortNumber { value f64
    valid bool }
struct TableSortKeys { numbers []f64
    valid []bool }
fn table_sort_number(value &string) TableSortNumber {
    text := strings.trim_space(value)
    number := strconv.parse_float(&text) or (err) { << TableSortNumber{value: 0.0,valid: false} }
    << TableSortNumber{value: number,valid: !math.is_nan(number) && !math.is_inf(number)}
}
// Source row indices remain stable while the view is sorted. cell()/set_cell()
// address source rows; view_cell() and row_at() address displayed rows.
pub fn (t &Table) row_at(view_row int) int {
    if view_row == -1 { << -1 }
    if view_row < 0 || view_row >= t.order.len { >> errors.new("widgets: invalid table view row") }
    << t.order[view_row]
}
pub fn (t &Table) view_row(source_row int) int {
    if source_row == -1 { << -1 }
    if source_row < 0 || source_row >= t.count() { >> errors.new("widgets: invalid table source row") }
    for i in 0:t.order.len { if t.order[i] == source_row { << i } }
    << -1
}
pub fn (t &Table) selected_row() int { << t.row_at(t.selected()) or >> }
pub fn (t &Table) view_cell(row int,column int) string {
    source := t.row_at(row) or >>
    << t.cell(source,column) or >>
}
pub fn (t $&Table) set_selected_row(source_row int) int {
    index := t.view_row(source_row) or >>
    << t.set_selected(index) or >>
}
fn (t &Table) sort_keys(column int) TableSortKeys {
    $numbers := []f64{}
    $valid := []bool{}
    cells := &t.cells
    for row in 0:t.count() {
        index := row*t.column_count()+column
        text := &cells[index]
        $number := TableSortNumber{value: 0.0,valid: text.len > 0}
        if t.sort_kinds[column] == TABLE_SORT_NUMBER { number = table_sort_number(text) }
        numbers.push(number.value)
        valid.push(number.valid)
    }
    << TableSortKeys{numbers: numbers,valid: valid}
}
fn (t &Table) compare_rows(keys &TableSortKeys,left int,right int,column int,descending bool) int {
    // Missing/invalid numeric data sorts last in either direction.
    if keys.valid[left] != keys.valid[right] { if keys.valid[left] { << -1 }
        << 1 }
    if !keys.valid[left] { << 0 }
    $result := 0
    if t.sort_kinds[column] == TABLE_SORT_NUMBER {
        if keys.numbers[left] < keys.numbers[right] { result = -1 }
        if keys.numbers[left] > keys.numbers[right] { result = 1 }
    } else {
        cells := &t.cells
        a_index := left*t.column_count()+column
        b_index := right*t.column_count()+column
        a := &cells[a_index]
        b := &cells[b_index]
        result = strings.compare(a,b)
    }
    if descending { result = 0-result }
    << result
}
fn (t $&Table) apply_sort(column int,descending bool,reset_scroll bool) int {
    if t.rows.closed || column < -1 || column >= t.column_count() { >> errors.new("widgets: invalid table sort column") }
    selected := t.selected_row() or >>
    $order := []int{}
    if column < 0 || !t.local_sort { for row in 0:t.count() { order.push(row) } }
    else {
        for row in t.order { order.push(row) }
        keys := t.sort_keys(column)
        $scratch := []int{}
        for row in 0:t.count() { scratch.push(0) }
        $width := 1
        while width < order.len {
            $start := 0
            while start < order.len {
                middle := min_int(order.len,start+width)
                end := min_int(order.len,middle+width)
                $left := start
                $right := middle
                $out := start
                while left < middle || right < end {
                    $take_left := right >= end
                    if left < middle && right < end { take_left = t.compare_rows(&keys,order[left],order[right],column,descending) <= 0 }
                    if take_left { scratch[out] = order[left]
                        left += 1 }
                    else { scratch[out] = order[right]
                        right += 1 }
                    out += 1
                }
                start = end
            }
            for i in 0:order.len { order[i] = scratch[i] }
            width = width*2
        }
    }
    t.order = order
    t.sort_col = column
    t.descending = column >= 0 && descending
    t.rows.selected_val = t.view_row(selected) or >>
    t.rows.hovered_idx = -1
    t.rows.armed_idx = -1
    if reset_scroll { t.rows.scroll_y = 0.0 }
    t.rows.dirty = true
    << 0
}
pub fn (t $&Table) sort_by(column int,descending bool) int { << t.apply_sort(column,descending,true) or >> }
pub fn (t $&Table) refresh_sort() int {
    if t.local_sort && t.sort_col >= 0 { column := t.sort_col
        descending := t.descending
        t.apply_sort(column,descending,false) or >> }
    << 0
}
pub fn (t $&Table) set_sort_kind(column int,kind int) int {
    if t.rows.closed || column < 0 || column >= t.column_count() || kind < TABLE_SORT_TEXT || kind > TABLE_SORT_NUMBER { >> errors.new("widgets: invalid table sort kind") }
    if t.sort_kinds[column] != kind { t.sort_kinds[column] = kind
        if column == t.sort_col { t.refresh_sort() or >> } }
    << 0
}
// Manual mode keeps header state/events and lets a remote data source own order.
pub fn (t $&Table) set_local_sort(enabled bool) int {
    if t.rows.closed { >> errors.new("widgets: table is disposed") }
    if t.local_sort == enabled { << 0 }
    t.local_sort = enabled
    column := t.sort_col
    descending := t.descending
    << t.apply_sort(column,descending,false) or >>
}
fn (t $&Table) toggle_sort(column int) int {
    descending := column == t.sort_col && !t.descending
    << t.sort_by(column,descending) or >>
}
