@ui/widgets

#ui
#ui/draw
#ui/layout
#math
#unicode/utf8
#errors

// Shared text selection helpers for Editor, SelectableText, and phone inputs.
// Ranges are UTF-8 byte offsets into the same string TextLayout shaped.

pub const TEXT_MENU_NONE = 0
pub const TEXT_MENU_CUT = 1
pub const TEXT_MENU_COPY = 2
pub const TEXT_MENU_PASTE = 3
pub const TEXT_MENU_SELECT_ALL = 4

pub struct TextRange {
    pub start int
    pub end int
}

pub fn text_range(a int,b int) TextRange {
    if a <= b { << TextRange{start: a,end: b} }
    << TextRange{start: b,end: a}
}

pub fn (range &TextRange) empty() bool { << range.start >= range.end }
pub fn (range &TextRange) length() int { << range.end - range.start }

fn clamp_index(index int,len int) int {
    if index < 0 { << 0 }
    if index > len { << len }
    << index
}

fn is_word_byte(b int) bool {
    v := b & 255
    if v >= 48 && v <= 57 { << true }
    if v >= 65 && v <= 90 { << true }
    if v >= 97 && v <= 122 { << true }
    if v == 95 { << true }
    // Treat non-ASCII UTF-8 lead/continuation as word content so CJK clusters
    // expand to the nearest shaped caret edges via TextLayout.caret.
    << v >= 128
}

fn is_space_byte(b int) bool {
    v := b & 255
    << v == 32 || v == 9 || v == 10 || v == 13
}

fn floor_boundary(value &string,index int) int {
    $i := clamp_index(index,value.len)
    while i > 0 && !utf8.rune_start(value[i] & 255) { i -= 1 }
    << i
}

fn prev_boundary(value &string,index int) int {
    $i := floor_boundary(value,index)
    if i <= 0 { << 0 }
    << floor_boundary(value,i - 1)
}

fn next_boundary(value &string,index int) int {
    $i := floor_boundary(value,index)
    if i >= value.len { << value.len }
    r := utf8.decode(value,i) or (err) { << value.len }
    n := utf8.rune_len(r) or (err) { << value.len }
    << clamp_index(i + n,value.len)
}

pub fn selection_prev_boundary(value &string,index int) int { << prev_boundary(value,index) }
pub fn selection_next_boundary(value &string,index int) int { << next_boundary(value,index) }

pub fn word_range_at(value &string,index int) TextRange {
    if value.len == 0 { << TextRange{start: 0,end: 0} }
    $i := floor_boundary(value,clamp_index(index,value.len))
    if i >= value.len { i = prev_boundary(value,value.len) }
    if i < value.len && is_space_byte(value[i]) {
        $left := i
        while left > 0 {
            prev := prev_boundary(value,left)
            if !is_space_byte(value[prev]) { <- }
            left = prev
        }
        $right := next_boundary(value,i)
        while right < value.len && is_space_byte(value[right]) { right = next_boundary(value,right) }
        << TextRange{start: left,end: right}
    }
    if i < value.len && is_word_byte(value[i]) {
        $left := i
        while left > 0 {
            prev := prev_boundary(value,left)
            if !is_word_byte(value[prev]) { <- }
            left = prev
        }
        $right := next_boundary(value,i)
        while right < value.len && is_word_byte(value[right]) { right = next_boundary(value,right) }
        << TextRange{start: left,end: right}
    }
    // Punctuation / other: select the single grapheme under the caret.
    << TextRange{start: i,end: next_boundary(value,i)}
}

pub fn line_range_at(value &string,index int) TextRange {
    if value.len == 0 { << TextRange{start: 0,end: 0} }
    $i := clamp_index(index,value.len)
    $start := i
    while start > 0 && (value[start - 1] & 255) != 10 { start -= 1 }
    $end := i
    while end < value.len && (value[end] & 255) != 10 { end += 1 }
    if end < value.len { end += 1 }
    << TextRange{start: start,end: end}
}

pub fn paint_selection_rects(frame $&draw.Frame,shaped &draw.TextLayout,origin_x f64,origin_y f64,offset_x f64,offset_y f64,start int,end int,fill draw.Color) int {
    range := text_range(start,end)
    if range.empty() { << 0 }
    rects := shaped.selection_rects(range.start,range.end) or >>
    for rect in rects {
        frame.fill_rect(origin_x - offset_x + rect.x,origin_y - offset_y + rect.y,rect.width,rect.height,fill) or >>
    }
    << 0
}

pub struct TextContextMenu {
    pub open bool
    pub x f64
    pub y f64
    pub hot int
    pub can_cut bool
    pub can_copy bool
    pub can_paste bool
    pub width f64
    pub row_height f64
}

pub fn text_context_menu() TextContextMenu {
    << TextContextMenu{open: false,x: 0.0,y: 0.0,hot: TEXT_MENU_NONE,can_cut: false,can_copy: false,can_paste: false,width: 148.0,row_height: 32.0}
}

fn (menu &TextContextMenu) row_count() int {
    $n := 1
    if menu.can_cut { n += 1 }
    if menu.can_copy { n += 1 }
    if menu.can_paste { n += 1 }
    << n
}

fn (menu &TextContextMenu) item_at(row int) int {
    $i := 0
    if menu.can_cut {
        if i == row { << TEXT_MENU_CUT }
        i += 1
    }
    if menu.can_copy {
        if i == row { << TEXT_MENU_COPY }
        i += 1
    }
    if menu.can_paste {
        if i == row { << TEXT_MENU_PASTE }
        i += 1
    }
    if i == row { << TEXT_MENU_SELECT_ALL }
    << TEXT_MENU_NONE
}

fn (menu &TextContextMenu) label_for(item int) string {
    if item == TEXT_MENU_CUT { << "Cut" }
    if item == TEXT_MENU_COPY { << "Copy" }
    if item == TEXT_MENU_PASTE { << "Paste" }
    if item == TEXT_MENU_SELECT_ALL { << "Select All" }
    << ""
}

pub fn (menu &TextContextMenu) bounds() layout.Rect {
    h := f64(menu.row_count()) * menu.row_height + 8.0
    << layout.Rect{x: menu.x,y: menu.y,width: menu.width,height: h}
}

pub fn (menu $&TextContextMenu) close() {
    menu.open = false
    menu.hot = TEXT_MENU_NONE
}

pub fn (menu $&TextContextMenu) open_at(x f64,y f64,can_cut bool,can_copy bool,can_paste bool) {
    menu.open = true
    menu.x = x
    menu.y = y
    menu.hot = TEXT_MENU_NONE
    menu.can_cut = can_cut
    menu.can_copy = can_copy
    menu.can_paste = can_paste
}

pub fn (menu $&TextContextMenu) hit_item(x f64,y f64) int {
    if !menu.open { << TEXT_MENU_NONE }
    b := menu.bounds()
    if !b.contains(x,y) { << TEXT_MENU_NONE }
    row := int((y - b.y - 4.0) / menu.row_height)
    if row < 0 || row >= menu.row_count() { << TEXT_MENU_NONE }
    << menu.item_at(row)
}

pub fn (menu $&TextContextMenu) paint(frame $&draw.Frame,context &draw.Context,theme &Theme) int {
    if !menu.open { << 0 }
    b := menu.bounds()
    frame.fill_round_rect(b.x,b.y,b.width,b.height,8.0,theme.normal) or >>
    frame.stroke_round_rect(b.x,b.y,b.width,b.height,8.0,theme.muted,1.0) or >>
    $options := draw.text_options(13.0)
    options.weight = 500
    options.line_height = 18.0
    for row in 0:menu.row_count() {
        item := menu.item_at(row)
        label := menu.label_for(item)
        y := b.y + 4.0 + f64(row) * menu.row_height
        if item == menu.hot {
            frame.fill_round_rect(b.x + 4.0,y,b.width - 8.0,menu.row_height,6.0,theme.hovered) or >>
        }
        $shaped := context.layout_text(&label,&options) or >>
        ty := y + math.max(0.0,(menu.row_height - shaped.metrics.height) * 0.5)
        frame.text_layout(&shaped,b.x + 12.0,ty,theme.foreground) or >>
        shaped.dispose() or >>
    }
    << 0
}

pub fn primary_modifier() int {
    if ui.target_os() == ui.OS_MACOS { << ui.MOD_META }
    << ui.MOD_CONTROL
}

pub fn is_primary_shortcut(event &ui.InputEvent,key int) bool {
    primary := primary_modifier()
    << event.kind == ui.EV_KEY_DOWN && event.repeat == 0 && event.key == key && (event.modifiers & primary) != 0 && (event.modifiers & ui.MOD_ALT) == 0
}
