@ui/widgets

#ui
#ui/draw
#ui/font
#ui/layout
#errors
#math

pub const TEXT_MENU_NONE = 0
pub const TEXT_MENU_COPY = 1
pub const TEXT_MENU_CUT = 2
pub const TEXT_MENU_PASTE = 3
pub const TEXT_MENU_SELECT_ALL = 4
pub const TEXT_MENU_COPY_ROW = 5

pub const TEXT_KEY_NONE = 0
pub const TEXT_KEY_CHANGED = 1
pub const TEXT_KEY_COPY = 2

pub struct TextRange {
    pub start int
    pub end int
}

pub fn text_range(a int,b int) TextRange {
    if a <= b { << TextRange{start: a,end: b} }
    << TextRange{start: b,end: a}
}

pub fn (range &TextRange) empty() bool { << range.start >= range.end }
pub fn (range &TextRange) length() int { << range.end - range.start }

pub fn selection_prev_boundary(value &string,index int) int { << ui.utf8_prev_char(value,index) }
pub fn selection_next_boundary(value &string,index int) int { << ui.utf8_next_char(value,index) }

pub fn word_range_at(value &string,index int) TextRange {
    r := ui.text_word_range(value,index)
    << TextRange{start: r.start,end: r.end}
}

pub fn line_range_at(value &string,index int) TextRange {
    r := ui.text_line_range(value,index)
    $end := r.end
    if end < value.len && (value[end] & 255) == 13 { end += 1 }
    if end < value.len && (value[end] & 255) == 10 { end += 1 }
    << TextRange{start: r.start,end: end}
}

const SEL_DRAG_CHAR = 0
const SEL_DRAG_WORD = 1
const SEL_DRAG_LINE = 2

const CONTEXT_MENU_PAD = 6
const CONTEXT_MENU_ROW_H = 30
const CONTEXT_MENU_MIN_W = 168

pub struct TextMenuSpec {
    pub show_cut bool
    pub cut_enabled bool
    pub show_copy bool
    pub copy_enabled bool
    pub show_paste bool
    pub paste_enabled bool
    pub show_select_all bool
    pub select_all_enabled bool
    pub show_copy_row bool
    pub copy_row_enabled bool
}

pub fn text_menu_spec_readonly(has_selection bool,has_text bool) TextMenuSpec {
    << TextMenuSpec{
        show_cut: false,cut_enabled: false,
        show_copy: true,copy_enabled: has_selection,
        show_paste: false,paste_enabled: false,
        show_select_all: true,select_all_enabled: has_text,
        show_copy_row: false,copy_row_enabled: false
    }
}

pub fn text_menu_spec_editable(has_selection bool,has_text bool,can_paste bool) TextMenuSpec {
    << TextMenuSpec{
        show_cut: true,cut_enabled: has_selection,
        show_copy: true,copy_enabled: has_selection,
        show_paste: true,paste_enabled: can_paste,
        show_select_all: true,select_all_enabled: has_text,
        show_copy_row: false,copy_row_enabled: false
    }
}

pub struct TextContextMenuItem {
    pub cmd int
    pub enabled bool
}

pub struct TextMenuResult {
    pub consumed bool
    pub closed bool
    pub cmd int
    pub dirty bool
}

fn text_menu_no_result() TextMenuResult {
    << TextMenuResult{consumed: false,closed: false,cmd: TEXT_MENU_NONE,dirty: false}
}

pub fn try_copy_clipboard(identity &ui.CanvasEvent,text &string) int {
    if !valid_identity(identity) || text.len == 0 { << 0 }
    options := ui.RequestOptions{timeout_ms: 5000}
    req := ui.clipboard_write_async(identity,text,&options) >>> (err) { << 0 }
    << req.id
}

fn text_origin_in_box(bounds &layout.Rect,styles &Styles,c &ControlStyle,metrics &draw.TextMetrics) layout.Rect {
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    width := math.max(0.0,bounds.width - left - c.padding.right * d)
    height := math.max(0.0,bounds.height - top - c.padding.bottom * d)
    ox := bounds.x + left + (width - metrics.width) * c.align_x
    oy := bounds.y + top + (height - metrics.height) * c.align_y
    << layout.Rect{x: ox,y: oy,width: width,height: height}
}

pub fn paint_text_selection(frame $&draw.Frame,shaped &draw.TextLayout,origin_x f64,origin_y f64,anchor int,focus int,bg draw.Color,fg draw.Color,text_len int) int {
    if text_len <= 0 || bg.a() == 0 { << 0 }
    a := max_int(0,min_int(text_len,anchor))
    b := max_int(0,min_int(text_len,focus))
    lo := min_int(a,b)
    hi := max_int(a,b)
    if lo >= hi { << 0 }
    rects := shaped.selection_rects(lo,hi) >>> (err) { << 0 }
    for r in rects {
        if r.width <= 0.0 || r.height <= 0.0 { -> }
        rx := origin_x + r.x
        ry := origin_y + r.y
        frame.fill_rect(rx,ry,r.width,r.height,bg) >>>
        frame.push() >>>
        frame.clip_rect(rx,ry,r.width,r.height) >>>
        frame.text_layout(shaped,origin_x,origin_y,fg) >>>
        frame.pop() >>>
    }
    << 0
}

pub fn (cache $&TextCache) ensure_layout_for(index int,value &string,bounds &layout.Rect,styles &Styles,c &ControlStyle,wrapped bool) draw.TextLayout {
    if wrapped {
        $options := styles.text_options(c)
        options.width = math.max(1.0,bounds.width - (c.padding.left + c.padding.right) * styles.density)
        _ := cache.measure_options(index,value,&options) >>>
    } else {
        _ := cache.measure(index,value,styles,c) >>>
    }
    << cache.layout_at(index) >>>
}

pub fn (cache $&TextCache) hit_test_at(index int,value &string,bounds &layout.Rect,styles &Styles,c &ControlStyle,wrapped bool,x f64,y f64) int {
    shaped := cache.ensure_layout_for(index,value,bounds,styles,c,wrapped) >>>
    box := text_origin_in_box(bounds,styles,c,&shaped.metrics)
    if shaped.is_host_shaped() {
        hit := shaped.hit_test(x - box.x,y - box.y) >>> (err) { << ui.utf8_clamp_boundary(value,0) }
        << ui.utf8_clamp_boundary(value,hit.byte_index())
    }
    slot := cache.slot_of(index)
    if slot >= 0 {
        stack := draw.default_font_stack() >>>
        opts := cache.hostless_options(slot)
        ly := draw.layout_font_text(&stack,value,&opts,false) >>>
        hit := ly.hit_test(x - box.x,y - box.y) >>> (err) { << ui.utf8_clamp_boundary(value,0) }
        << ui.utf8_clamp_boundary(value,hit.byte_index())
    }
    << ui.utf8_clamp_boundary(value,0)
}

pub fn (cache $&TextCache) paint_text_selected(index int,value &string,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,c &ControlStyle,state int,sel_anchor int,sel_focus int,wrapped bool) int {
    shaped := cache.ensure_layout_for(index,value,bounds,styles,c,wrapped) >>>
    box := text_origin_in_box(bounds,styles,c,&shaped.metrics)
    d := styles.density
    clip_x := bounds.x + c.padding.left * d
    clip_y := bounds.y + c.padding.top * d
    resolved := c.resolve(state)
    slot := cache.slot_of(index)
    if slot < 0 { >>> errors.new("widgets: missing text cache entry") }
    frame.push() >>>
    frame.clip_rect(clip_x,clip_y,box.width,box.height) >>>
    cache.paint_slot_at(slot,frame,box.x,box.y,resolved.foreground) >>>
    if sel_anchor != sel_focus && value.len > 0 {
        if shaped.is_host_shaped() {
            paint_text_selection(frame,&shaped,box.x,box.y,sel_anchor,sel_focus,resolved.selection,resolved.selection_text,value.len) >>>
        } else {
            stack := draw.default_font_stack() >>>
            opts := cache.hostless_options(slot)
            ly := draw.layout_font_text(&stack,&cache.values[slot],&opts,false) >>>
            paint_font_text_selection(frame,&ly,&cache.values[slot],box.x,box.y,sel_anchor,sel_focus,resolved.selection,resolved.selection_text,value.len) >>>
        }
    }
    frame.pop() >>>
    << 0
}

pub fn styled_label_ensure(label $&StyledLabel,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,wrapped bool) layout.Size {
    effective := label.style_or(fallback)
    if wrapped {
        inner_w := math.max(1.0,bounds.width - (effective.padding.left + effective.padding.right) * styles.density)
        << label.measure_wrapped(styles,fallback,inner_w) >>>
    }
    << label.measure_styled(styles,fallback) >>>
}

pub fn styled_label_hit_test(label $&StyledLabel,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,wrapped bool,x f64,y f64) int {
    _ := styled_label_ensure(label,bounds,styles,fallback,wrapped) >>>
    if label.layouts.len == 0 { << ui.utf8_clamp_boundary(&label.value,0) }
    effective := label.style_or(fallback)
    shaped := label.layouts[0]
    box := text_origin_in_box(bounds,styles,&effective,&shaped.metrics)
    if shaped.is_host_shaped() {
        hit := shaped.hit_test(x - box.x,y - box.y) >>> (err) { << ui.utf8_clamp_boundary(&label.value,0) }
        << ui.utf8_clamp_boundary(&label.value,hit.byte_index())
    }
    if label.font_layouts.len > 0 {
        ly := &label.font_layouts[0]
        hit := ly.hit_test(x - box.x,y - box.y) >>> (err) { << ui.utf8_clamp_boundary(&label.value,0) }
        << ui.utf8_clamp_boundary(&label.value,hit.byte_index())
    }
    << ui.utf8_clamp_boundary(&label.value,0)
}

pub fn paint_styled_label_selected(label $&StyledLabel,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,fallback &ControlStyle,state int,sel_anchor int,sel_focus int,wrapped bool,ellipsis bool) int {
    if ellipsis && !wrapped && sel_anchor == sel_focus {
        << label.paint_ellipsized_styled(frame,bounds,styles,fallback,state) >>>
    }
    _ := styled_label_ensure(label,bounds,styles,fallback,wrapped) >>>
    if label.layouts.len == 0 { << 0 }
    effective := label.style_or(fallback)
    shaped := label.layouts[0]
    box := text_origin_in_box(bounds,styles,&effective,&shaped.metrics)
    d := styles.density
    clip_x := bounds.x + effective.padding.left * d
    clip_y := bounds.y + effective.padding.top * d
    resolved := effective.resolve(state)
    frame.push() >>>
    frame.clip_rect(clip_x,clip_y,box.width,box.height) >>>
    label.paint_layout_at(frame,&shaped,box.x,box.y,resolved.foreground) >>>
    if sel_anchor != sel_focus && label.value.len > 0 {
        if shaped.is_host_shaped() {
            paint_text_selection(frame,&shaped,box.x,box.y,sel_anchor,sel_focus,resolved.selection,resolved.selection_text,label.value.len) >>>
        } else if label.font_layouts.len > 0 {
            ly := &label.font_layouts[0]
            paint_font_text_selection(frame,ly,&label.font_text,box.x,box.y,sel_anchor,sel_focus,resolved.selection,resolved.selection_text,label.value.len) >>>
        }
    }
    frame.pop() >>>
    << 0
}

fn paint_font_text_selection(frame $&draw.Frame,ly &font.TextLayout,value &string,origin_x f64,origin_y f64,anchor int,focus int,bg draw.Color,fg draw.Color,text_len int) int {
    if text_len <= 0 || bg.a() == 0 { << 0 }
    a := max_int(0,min_int(text_len,anchor))
    b := max_int(0,min_int(text_len,focus))
    lo := min_int(a,b)
    hi := max_int(a,b)
    if lo >= hi { << 0 }
    rects := ly.selection_rects(lo,hi) >>> (err) { << 0 }
    for r in rects {
        if r.width <= 0.0 || r.height <= 0.0 { -> }
        rx := origin_x + r.x
        ry := origin_y + r.y
        frame.fill_rect(rx,ry,r.width,r.height,bg) >>>
        frame.push() >>>
        frame.clip_rect(rx,ry,r.width,r.height) >>>
        frame.text_font_layout(ly,value,origin_x,origin_y,fg) >>>
        frame.pop() >>>
    }
    << 0
}

pub fn paint_styled_label_at_origin(label &StyledLabel,frame $&draw.Frame,tx f64,ty f64,resolved &ResolvedStyle,sel_anchor int,sel_focus int) int {
    if label.layouts.len == 0 || label.value.len == 0 { << 0 }
    shaped := label.layouts[0]
    label.paint_layout_at(frame,&shaped,tx,ty,resolved.foreground) >>>
    if sel_anchor != sel_focus {
        if shaped.is_host_shaped() {
            paint_text_selection(frame,&shaped,tx,ty,sel_anchor,sel_focus,resolved.selection,resolved.selection_text,label.value.len) >>>
        } else if label.font_layouts.len > 0 {
            ly := &label.font_layouts[0]
            paint_font_text_selection(frame,ly,&label.value,tx,ty,sel_anchor,sel_focus,resolved.selection,resolved.selection_text,label.value.len) >>>
        }
    }
    << 0
}

pub fn hit_test_styled_label_at_origin(label &StyledLabel,tx f64,ty f64,x f64,y f64) int {
    if label.layouts.len == 0 || label.value.len == 0 { << 0 }
    shaped := label.layouts[0]
    if shaped.is_host_shaped() {
        hit := shaped.hit_test(x - tx,y - ty) >>> (err) { << ui.utf8_clamp_boundary(&label.value,0) }
        << ui.utf8_clamp_boundary(&label.value,hit.byte_index())
    }
    if label.font_layouts.len > 0 {
        ly := &label.font_layouts[0]
        hit := ly.hit_test(x - tx,y - ty) >>> (err) { << ui.utf8_clamp_boundary(&label.value,0) }
        << ui.utf8_clamp_boundary(&label.value,hit.byte_index())
    }
    << ui.utf8_clamp_boundary(&label.value,0)
}

pub struct TextSelectionEngine {
    pub selectable bool
    pub anchor int
    pub focus int
    drag_mode int
    word_start int
    word_end int
    pub selecting bool
    clicks ui.ClickTracker
}

pub fn text_selection_engine(selectable bool) TextSelectionEngine {
    << TextSelectionEngine{
        selectable: selectable,anchor: 0,focus: 0,drag_mode: SEL_DRAG_CHAR,
        word_start: 0,word_end: 0,selecting: false,clicks: ui.click_tracker()
    }
}

pub fn (e &TextSelectionEngine) has_selection() bool {
    << e.selectable && e.anchor != e.focus
}

pub fn (e &TextSelectionEngine) is_drag_char() bool {
    << e.drag_mode == SEL_DRAG_CHAR
}

pub fn (e $&TextSelectionEngine) reset_clicks() {
    e.clicks = ui.click_tracker()
}

pub fn (e &TextSelectionEngine) range(text_len int) ui.TextRange {
    if !e.selectable || text_len <= 0 { << ui.TextRange{start: 0,end: 0} }
    a := max_int(0,min_int(text_len,e.anchor))
    b := max_int(0,min_int(text_len,e.focus))
    << ui.TextRange{start: min_int(a,b),end: max_int(a,b)}
}

pub fn (e &TextSelectionEngine) selected_text(text &string) string {
    if !e.selectable || text.len == 0 { << "" }
    r := e.range(text.len)
    if r.start >= r.end { << "" }
    << text[r.start:r.end]
}

pub fn (e $&TextSelectionEngine) clear() bool {
    changed := e.anchor != e.focus
    e.anchor = 0
    e.focus = 0
    e.drag_mode = SEL_DRAG_CHAR
    e.word_start = 0
    e.word_end = 0
    e.selecting = false
    << changed
}

pub fn (e $&TextSelectionEngine) set_selectable(selectable bool) bool {
    if e.selectable == selectable { << false }
    e.selectable = selectable
    if !selectable {
        _ := e.clear()
        e.clicks = ui.click_tracker()
    }
    << true
}

pub fn (e $&TextSelectionEngine) select_all(text &string) bool {
    if !e.selectable || text.len == 0 { << false }
    changed := e.anchor != 0 || e.focus != text.len
    e.anchor = 0
    e.focus = text.len
    e.selecting = false
    e.drag_mode = SEL_DRAG_CHAR
    << changed
}

pub fn (e $&TextSelectionEngine) set_range(text &string,start int,end int) bool {
    if !e.selectable { << false }
    a := ui.utf8_clamp_boundary(text,start)
    b := ui.utf8_clamp_boundary(text,end)
    changed := e.anchor != a || e.focus != b
    e.anchor = a
    e.focus = b
    e.selecting = false
    << changed
}

pub fn (e $&TextSelectionEngine) begin_pointer_down(text &string,idx int,event &ui.InputEvent) bool {
    if !e.selectable { << false }
    pos := ui.utf8_clamp_boundary(text,idx)
    clicks := $&e.clicks
    streak := clicks.record(event)
    prev_a := e.anchor
    prev_f := e.focus
    if streak >= 3 {
        lr := ui.text_line_range(text,pos)
        e.drag_mode = SEL_DRAG_LINE
        e.word_start = lr.start
        e.word_end = lr.end
        e.anchor = lr.start
        e.focus = lr.end
        e.selecting = true
    } else if streak == 2 {
        wr := ui.text_word_range(text,pos)
        e.drag_mode = SEL_DRAG_WORD
        e.word_start = wr.start
        e.word_end = wr.end
        e.anchor = wr.start
        e.focus = wr.end
        e.selecting = true
    } else if (event.modifiers & ui.MOD_SHIFT) != 0 {
        e.drag_mode = SEL_DRAG_CHAR
        e.focus = pos
        e.selecting = true
    } else {
        e.drag_mode = SEL_DRAG_CHAR
        e.anchor = pos
        e.focus = pos
        e.selecting = true
    }
    << e.anchor != prev_a || e.focus != prev_f
}

pub fn (e $&TextSelectionEngine) drag_pointer(text &string,idx int) bool {
    if !e.selectable || !e.selecting { << false }
    pos := ui.utf8_clamp_boundary(text,idx)
    prev_a := e.anchor
    prev_f := e.focus
    if e.drag_mode == SEL_DRAG_LINE {
        lr := ui.text_line_range(text,pos)
        if lr.start < e.word_start {
            e.anchor = e.word_end
            e.focus = lr.start
        } else if lr.end > e.word_end {
            e.anchor = e.word_start
            e.focus = lr.end
        } else {
            e.anchor = e.word_start
            e.focus = e.word_end
        }
    } else if e.drag_mode == SEL_DRAG_WORD {
        wr := ui.text_word_range(text,pos)
        if wr.start < e.word_start {
            e.anchor = e.word_end
            e.focus = wr.start
        } else if wr.end > e.word_end {
            e.anchor = e.word_start
            e.focus = wr.end
        } else {
            e.anchor = e.word_start
            e.focus = e.word_end
        }
    } else {
        e.focus = pos
    }
    << e.anchor != prev_a || e.focus != prev_f
}

pub fn (e $&TextSelectionEngine) end_pointer() bool {
    was := e.selecting
    e.selecting = false
    << was
}

pub fn (e $&TextSelectionEngine) key_navigation(text &string,event &ui.InputEvent) int {
    if !e.selectable { << TEXT_KEY_NONE }
    if ui.is_clipboard_modifier(event.modifiers) {
        if event.key == 65 || event.key == 97 {
            _ := e.select_all(text)
            << TEXT_KEY_CHANGED
        }
        if event.key == 67 || event.key == 99 {
            if e.has_selection() { << TEXT_KEY_COPY }
            << TEXT_KEY_NONE
        }
    }
    if (event.modifiers & ui.MOD_SHIFT) != 0 {
        focus := ui.utf8_clamp_boundary(text,e.focus)
        if event.key == ui.KEY_LEFT {
            e.focus = ui.utf8_prev_char(text,focus)
            << TEXT_KEY_CHANGED
        }
        if event.key == ui.KEY_RIGHT {
            e.focus = ui.utf8_next_char(text,focus)
            << TEXT_KEY_CHANGED
        }
        if event.key == ui.KEY_HOME {
            lr := ui.text_line_range(text,focus)
            e.focus = lr.start
            << TEXT_KEY_CHANGED
        }
        if event.key == ui.KEY_END {
            lr := ui.text_line_range(text,focus)
            e.focus = lr.end
            << TEXT_KEY_CHANGED
        }
    }
    << TEXT_KEY_NONE
}

fn vertical_step_target_y(caret_y f64,caret_height f64,key int) f64 {
    step := math.max(8.0,caret_height)
    if key == ui.KEY_DOWN { << caret_y + caret_height + step * 0.5 }
    << caret_y - step * 0.5
}

pub fn (e $&TextSelectionEngine) key_navigation_layout(text &string,shaped &draw.TextLayout,event &ui.InputEvent) int {
    basic := e.key_navigation(text,event)
    if basic != TEXT_KEY_NONE { << basic }
    if !e.selectable || !shaped.is_host_shaped() || (event.modifiers & ui.MOD_SHIFT) == 0 { << TEXT_KEY_NONE }
    if event.key == ui.KEY_UP || event.key == ui.KEY_DOWN {
        focus := ui.utf8_clamp_boundary(text,e.focus)
        caret := shaped.caret(focus,false) >>> (err) { << TEXT_KEY_NONE }
        target_y := vertical_step_target_y(caret.y,caret.height,event.key)
        hit := shaped.hit_test(caret.x,target_y) >>> (err) { << TEXT_KEY_NONE }
        e.focus = ui.utf8_clamp_boundary(text,hit.byte_index())
        << TEXT_KEY_CHANGED
    }
    << TEXT_KEY_NONE
}

pub fn font_vertical_step_focus(shaped &font.TextLayout,text &string,cur_focus int,key int) int {
    if key != ui.KEY_UP && key != ui.KEY_DOWN { << -1 }
    focus := ui.utf8_clamp_boundary(text,cur_focus)
    caret := shaped.caret(focus,false) >>> (err) { << -1 }
    target_y := vertical_step_target_y(caret.y,caret.height,key)
    hit := shaped.hit_test(caret.x,target_y) >>> (err) { << -1 }
    << ui.utf8_clamp_boundary(text,hit.byte_index())
}

pub fn (e $&TextSelectionEngine) key_navigation_font_layout(text &string,shaped &font.TextLayout,event &ui.InputEvent) int {
    basic := e.key_navigation(text,event)
    if basic != TEXT_KEY_NONE { << basic }
    if !e.selectable || (event.modifiers & ui.MOD_SHIFT) == 0 { << TEXT_KEY_NONE }
    next := font_vertical_step_focus(shaped,text,e.focus,event.key)
    if next >= 0 {
        e.focus = next
        << TEXT_KEY_CHANGED
    }
    << TEXT_KEY_NONE
}

fn locale_is_zh(locale &Locale) bool {
    sample := locale.text(TEXT_CLEAR) >>> (err) { << false }
    << sample == "清空"
}

pub fn text_menu_item_label(locale &Locale,cmd int) string {
    zh := locale_is_zh(locale)
    if cmd == TEXT_MENU_COPY {
        if zh { << "复制" }
        << "Copy"
    }
    if cmd == TEXT_MENU_CUT {
        if zh { << "剪切" }
        << "Cut"
    }
    if cmd == TEXT_MENU_PASTE {
        if zh { << "粘贴" }
        << "Paste"
    }
    if cmd == TEXT_MENU_SELECT_ALL {
        if zh { << "全选" }
        << "Select All"
    }
    if cmd == TEXT_MENU_COPY_ROW {
        if zh { << "复制整行" }
        << "Copy Row"
    }
    << ""
}

pub fn text_menu_shortcut_label(cmd int) string {
    $prefix := "Ctrl+"
    if ui.target_os() == ui.OS_MACOS { prefix = "Cmd+" }
    if cmd == TEXT_MENU_COPY { << prefix + "C" }
    if cmd == TEXT_MENU_CUT { << prefix + "X" }
    if cmd == TEXT_MENU_PASTE { << prefix + "V" }
    if cmd == TEXT_MENU_SELECT_ALL { << prefix + "A" }
    << ""
}

pub fn is_context_trigger(event &ui.InputEvent) bool {
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_RIGHT { << true }
    if event.kind == ui.EV_KEY_DOWN && event.key == ui.KEY_F1 + 9 && (event.modifiers & ui.MOD_SHIFT) != 0 && event.repeat == 0 { << true }
    << false
}

pub struct TextContextMenu {
    identity ui.CanvasEvent
    id_val int
    opened bool
    bounds_val layout.Rect
    anchor_x f64
    anchor_y f64
    viewport layout.Rect
    has_viewport bool
    items []TextContextMenuItem
    hovered int
    armed int
    focused_index int
    labels TextCache
    locale Locale
    dirty bool
}

pub fn text_context_menu(context &draw.Context,identity &ui.CanvasEvent,id int) TextContextMenu {
    << TextContextMenu{
        identity: copy_identity(identity),
        id_val: id,
        opened: false,
        bounds_val: layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0},
        anchor_x: 0.0,
        anchor_y: 0.0,
        viewport: layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0},
        has_viewport: false,
        items: []TextContextMenuItem{},
        hovered: -1,
        armed: -1,
        focused_index: -1,
        labels: text_cache(context),
        locale: locale_default(),
        dirty: false
    }
}

pub fn (m &TextContextMenu) is_open() bool { << m.opened }
pub fn (m &TextContextMenu) needs_paint() bool { << m.dirty }
pub fn (m $&TextContextMenu) painted() { m.dirty = false }
pub fn (m &TextContextMenu) popup_bounds() layout.Rect { << copy_rect(&m.bounds_val) }

pub fn (m $&TextContextMenu) dispose() {
    labels := $&m.labels
    labels.dispose()
}

pub fn (m &TextContextMenu) clone_menu() TextContextMenu {
    $cloned := []TextContextMenuItem{}
    for it in m.items { cloned.push(TextContextMenuItem{cmd: it.cmd,enabled: it.enabled}) }
    ctx := m.labels.context.clone()
    << TextContextMenu{
        identity: copy_identity(&m.identity),
        id_val: m.id_val,
        opened: m.opened,
        bounds_val: copy_rect(&m.bounds_val),
        anchor_x: m.anchor_x,
        anchor_y: m.anchor_y,
        viewport: copy_rect(&m.viewport),
        has_viewport: m.has_viewport,
        items: cloned,
        hovered: m.hovered,
        armed: m.armed,
        focused_index: m.focused_index,
        labels: text_cache(&ctx),
        locale: m.locale.clone(),
        dirty: m.dirty
    }
}

pub fn (m $&TextContextMenu) set_locale(locale &Locale) int {
    locale.validate() >>>
    m.locale = locale.clone()
    if m.opened { m.dirty = true }
    << 0
}

pub fn (m $&TextContextMenu) set_zh(zh bool) {
    $target := locale_default()
    if zh { target = locale_zh_cn() }
    m.locale = target
    if m.opened { m.dirty = true }
}

pub fn (m $&TextContextMenu) set_viewport(viewport &layout.Rect) {
    m.viewport = copy_rect(viewport)
    m.has_viewport = viewport.width > 0.0 && viewport.height > 0.0
    m.update_bounds(1.0)
}

fn (m $&TextContextMenu) update_bounds(density f64) {
    d := math.max(0.5,density)
    pad := f64(CONTEXT_MENU_PAD) * d
    row_h := f64(CONTEXT_MENU_ROW_H) * d
    w := f64(CONTEXT_MENU_MIN_W) * d
    h := pad * 2.0 + f64(m.items.len) * row_h
    $x := m.anchor_x
    $y := m.anchor_y
    if m.has_viewport {
        margin := 4.0 * d
        if x + w > m.viewport.x + m.viewport.width - margin {
            x = math.max(m.viewport.x + margin,m.viewport.x + m.viewport.width - margin - w)
        }
        if x < m.viewport.x + margin { x = m.viewport.x + margin }
        if y + h > m.viewport.y + m.viewport.height - margin {
            flipped := m.anchor_y - h
            if flipped >= m.viewport.y + margin { y = flipped }
            else { y = math.max(m.viewport.y + margin,m.viewport.y + m.viewport.height - margin - h) }
        }
        if y < m.viewport.y + margin { y = m.viewport.y + margin }
    }
    m.bounds_val = layout.Rect{x: x,y: y,width: w,height: h}
}

pub fn (m $&TextContextMenu) open(x f64,y f64,spec &TextMenuSpec,density f64) bool {
    $next := []TextContextMenuItem{}
    if spec.show_cut { next.push(TextContextMenuItem{cmd: TEXT_MENU_CUT,enabled: spec.cut_enabled}) }
    if spec.show_copy { next.push(TextContextMenuItem{cmd: TEXT_MENU_COPY,enabled: spec.copy_enabled}) }
    if spec.show_paste { next.push(TextContextMenuItem{cmd: TEXT_MENU_PASTE,enabled: spec.paste_enabled}) }
    if spec.show_select_all { next.push(TextContextMenuItem{cmd: TEXT_MENU_SELECT_ALL,enabled: spec.select_all_enabled}) }
    if spec.show_copy_row { next.push(TextContextMenuItem{cmd: TEXT_MENU_COPY_ROW,enabled: spec.copy_row_enabled}) }
    if next.len == 0 { << false }
    m.items = next
    m.anchor_x = x
    m.anchor_y = y
    m.opened = true
    m.hovered = -1
    m.armed = -1
    m.focused_index = -1
    for i in 0:m.items.len {
        if m.items[i].enabled && m.focused_index < 0 { m.focused_index = i }
    }
    m.update_bounds(density)
    m.dirty = true
    << true
}

pub fn (m $&TextContextMenu) close() bool {
    if !m.opened { << false }
    m.opened = false
    m.hovered = -1
    m.armed = -1
    m.focused_index = -1
    m.dirty = true
    << true
}

fn (m &TextContextMenu) row_bounds(index int,density f64) layout.Rect {
    d := math.max(0.5,density)
    pad := f64(CONTEXT_MENU_PAD) * d
    row_h := f64(CONTEXT_MENU_ROW_H) * d
    << layout.Rect{
        x: m.bounds_val.x + pad,
        y: m.bounds_val.y + pad + f64(index) * row_h,
        width: math.max(0.0,m.bounds_val.width - pad * 2.0),
        height: row_h
    }
}

fn (m &TextContextMenu) item_at(x f64,y f64,density f64) int {
    if !m.opened || !m.bounds_val.contains(x,y) { << -1 }
    for i in 0:m.items.len {
        row := m.row_bounds(i,density)
        if row.contains(x,y) { << i }
    }
    << -1
}

pub fn (m &TextContextMenu) cursor_at(x f64,y f64,density f64) int {
    if !m.opened || !m.bounds_val.contains(x,y) { << ui.CURSOR_DEFAULT }
    idx := m.item_at(x,y,density)
    if idx >= 0 && idx < m.items.len && !m.items[idx].enabled { << ui.CURSOR_DEFAULT }
    << ui.CURSOR_HAND
}

fn text_menu_cursor_at(m &TextContextMenu,x f64,y f64,density f64) int {
    << m.cursor_at(x,y,density)
}

fn (m $&TextContextMenu) move_focus(step int) bool {
    n := m.items.len
    if n <= 0 { << false }
    $cur := m.focused_index
    if cur < 0 {
        if step > 0 { cur = -1 } else { cur = n }
    }
    for attempt in 0:n {
        cur = (cur + step + n) % n
        if m.items[cur].enabled {
            m.focused_index = cur
            m.hovered = cur
            m.dirty = true
            << true
        }
    }
    << false
}

pub fn (m $&TextContextMenu) input(event &ui.InputEvent,density f64) TextMenuResult {
    if !m.opened { << text_menu_no_result() }
    if event.kind == ui.EV_POINTER_CANCEL {
        _ := m.close()
        << TextMenuResult{consumed: false,closed: true,cmd: TEXT_MENU_NONE,dirty: true}
    }
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        $next_hover := -1
        if event.kind != ui.EV_POINTER_LEAVE { next_hover = m.item_at(event.x,event.y,density) }
        if next_hover != m.hovered {
            m.hovered = next_hover
            m.dirty = true
        }
        inside := event.kind != ui.EV_POINTER_LEAVE && m.bounds_val.contains(event.x,event.y)
        << TextMenuResult{consumed: inside,closed: false,cmd: TEXT_MENU_NONE,dirty: m.dirty}
    }
    if event.kind == ui.EV_POINTER_DOWN {
        inside := m.bounds_val.contains(event.x,event.y)
        if !inside {
            _ := m.close()
            << TextMenuResult{consumed: event.button != ui.BUTTON_RIGHT,closed: true,cmd: TEXT_MENU_NONE,dirty: true}
        }
        if event.button == ui.BUTTON_LEFT {
            idx := m.item_at(event.x,event.y,density)
            if idx >= 0 && m.items[idx].enabled {
                m.armed = idx
                m.focused_index = idx
                m.hovered = idx
                m.dirty = true
            }
        }
        << TextMenuResult{consumed: true,closed: false,cmd: TEXT_MENU_NONE,dirty: m.dirty}
    }
    if event.kind == ui.EV_POINTER_UP {
        if event.button == ui.BUTTON_LEFT && m.armed >= 0 {
            idx := m.item_at(event.x,event.y,density)
            armed := m.armed
            m.armed = -1
            if idx == armed && idx >= 0 && m.items[idx].enabled {
                cmd := m.items[idx].cmd
                _ := m.close()
                << TextMenuResult{consumed: true,closed: true,cmd: cmd,dirty: true}
            }
            m.dirty = true
            << TextMenuResult{consumed: true,closed: false,cmd: TEXT_MENU_NONE,dirty: true}
        }
        inside := m.bounds_val.contains(event.x,event.y)
        << TextMenuResult{consumed: inside,closed: false,cmd: TEXT_MENU_NONE,dirty: m.dirty}
    }
    if event.kind == ui.EV_KEY_DOWN {
        if event.key == ui.KEY_ESCAPE {
            _ := m.close()
            << TextMenuResult{consumed: true,closed: true,cmd: TEXT_MENU_NONE,dirty: true}
        }
        if event.key == ui.KEY_DOWN {
            _ := m.move_focus(1)
            << TextMenuResult{consumed: true,closed: false,cmd: TEXT_MENU_NONE,dirty: m.dirty}
        }
        if event.key == ui.KEY_UP {
            _ := m.move_focus(-1)
            << TextMenuResult{consumed: true,closed: false,cmd: TEXT_MENU_NONE,dirty: m.dirty}
        }
        if (event.key == ui.KEY_ENTER || event.key == 32) && m.focused_index >= 0 && m.focused_index < m.items.len {
            it := m.items[m.focused_index]
            if it.enabled {
                _ := m.close()
                << TextMenuResult{consumed: true,closed: true,cmd: it.cmd,dirty: true}
            }
        }
        << TextMenuResult{consumed: true,closed: false,cmd: TEXT_MENU_NONE,dirty: m.dirty}
    }
    << text_menu_no_result()
}

fn paint_text_menu_row(cache $&TextCache,frame $&draw.Frame,styles &Styles,locale &Locale,row &layout.Rect,radius f64,d f64,menu_c &ControlStyle,index int,it &TextContextMenuItem,state int) int {
    if it.enabled && ((state & STATE_HOVERED) != 0 || (state & STATE_PRESSED) != 0) {
        rounded_fill(frame,row,math.min(5.0,radius) * d,menu_c.resolve(state).background) >>>
    }
    label := text_menu_item_label(locale,it.cmd)
    shortcut := text_menu_shortcut_label(it.cmd)
    $item_style := menu_c.clone()
    item_style.padding = layout.Insets{left: 10.0,top: 0.0,right: 10.0,bottom: 0.0}
    item_style.align_x = 0.0
    $shortcut_w := 0.0
    if shortcut.len > 0 {
        measured := cache.measure(index * 2 + 1,&shortcut,styles,&item_style) >>>
        shortcut_w = math.min(row.width * 0.45,measured.width + 12.0 * d)
        s_box := layout.Rect{x: row.x + row.width - shortcut_w - 6.0 * d,y: row.y,width: shortcut_w,height: row.height}
        $s_style := item_style.clone()
        s_style.align_x = 1.0
        if it.enabled && (state & (STATE_HOVERED | STATE_PRESSED)) == 0 {
            s_style.palette.foreground = s_style.palette.muted
        }
        cache.paint_text(index * 2 + 1,&shortcut,frame,&s_box,styles,&s_style,state) >>>
    }
    l_box := layout.Rect{x: row.x,y: row.y,width: math.max(0.0,row.width - shortcut_w - 4.0 * d),height: row.height}
    cache.paint_text(index * 2,&label,frame,&l_box,styles,&item_style,state) >>>
    << 0
}

pub fn (m $&TextContextMenu) paint_styled(frame $&draw.Frame,styles &Styles) int {
    if !m.opened || m.items.len == 0 { << 0 }
    m.update_bounds(styles.density)
    d := styles.density
    $base := styles.card_style()
    base.radius = math.max(base.radius,7.0)
    bounds := copy_rect(&m.bounds_val)
    paint_box_styled(frame,&bounds,styles,&base,0) >>>
    menu_c := styles.menu_style()
    count := m.items.len
    $keys := []int{}
    $rows := []layout.Rect{}
    $states := []int{}
    $snapshot := []TextContextMenuItem{}
    for i in 0:count {
        keys.push(i * 2)
        keys.push(i * 2 + 1)
        it := m.items[i]
        snapshot.push(it)
        rows.push(m.row_bounds(i,d))
        $state := 0
        if !it.enabled { state = state | STATE_DISABLED }
        else if m.armed == i { state = state | STATE_PRESSED }
        else if m.hovered == i || m.focused_index == i { state = state | STATE_HOVERED }
        states.push(state)
    }
    locale := m.locale.clone()
    cache := $&m.labels
    cache.retain_keys(&keys)
    for i in 0:count {
        it := snapshot[i]
        row := rows[i]
        paint_text_menu_row(cache,frame,styles,&locale,&row,base.radius,d,&menu_c,i,&it,states[i]) >>>
    }
    << 0
}

pub fn paint_text_context_menu_err(m $&TextContextMenu,frame $&draw.Frame,styles &Styles) string {
    _ := m.paint_styled(frame,styles) >>> (err) { << err.msg() }
    << ""
}

pub struct ListTextAux {
    pub drag_start_x f64
    pub drag_start_y f64
    pub drag_moved bool
    pub sel_row int
    pub sel_col int
    pub active_text string
    pub row_text string
    pub viewport layout.Rect
    pub zh bool
    pub selection TextSelectionEngine
    pub menus map[int]TextContextMenu
    pub cached_styles []Styles
}

pub fn list_text_aux_new(selectable bool) ListTextAux {
    << ListTextAux{
        drag_start_x: 0.0,
        drag_start_y: 0.0,
        drag_moved: false,
        sel_row: -1,
        sel_col: -1,
        active_text: "",
        row_text: "",
        viewport: layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0},
        zh: false,
        selection: text_selection_engine(selectable),
        menus: map[int]TextContextMenu{},
        cached_styles: []Styles{}
    }
}

pub fn (aux &ListTextAux) has_menu() bool { << aux.menus.has(0) }
pub fn (aux &ListTextAux) is_menu_open() bool { << aux.menus.has(0) && aux.menus[0].is_open() }
pub fn (aux &ListTextAux) menu_bounds() layout.Rect {
    if !aux.menus.has(0) { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
    << aux.menus[0].popup_bounds()
}
pub fn (aux &ListTextAux) is_dragging() bool { << aux.selection.selecting && aux.drag_moved }
pub fn (aux &ListTextAux) menu_cursor_at(x f64,y f64) int {
    if !aux.is_menu_open() { << ui.CURSOR_DEFAULT }
    d := aux.style_snapshot().density
    << text_menu_cursor_at(&aux.menus[0],x,y,d)
}
pub fn (aux &ListTextAux) menu_needs_paint() bool { << aux.menus.has(0) && aux.menus[0].needs_paint() }
pub fn (aux &ListTextAux) has_selection_for(row int,col int) bool {
    << aux.sel_row == row && aux.sel_col == col && aux.selection.has_selection()
}
pub fn (aux &ListTextAux) sel_anchor() int { << aux.selection.anchor }
pub fn (aux &ListTextAux) sel_focus() int { << aux.selection.focus }
pub fn (aux &ListTextAux) get_sel_row() int { << aux.sel_row }
pub fn (aux &ListTextAux) get_sel_col() int { << aux.sel_col }
pub fn (aux &ListTextAux) has_active_text() bool { << aux.active_text.len > 0 }
pub fn (aux &ListTextAux) get_active_text() string { << aux.active_text + "" }
pub fn (aux &ListTextAux) get_row_text() string { << aux.row_text + "" }
pub fn (aux &ListTextAux) selected_text() string { << aux.selection.selected_text(&aux.active_text) }
pub fn (aux &ListTextAux) style_snapshot() Styles {
    if aux.cached_styles.len > 0 { << aux.cached_styles[0].clone() }
    << dark_styles()
}

pub fn (aux $&ListTextAux) set_styles_cache(styles &Styles) {
    if aux.cached_styles.len == 0 {
        aux.cached_styles.push(styles.clone())
    } else {
        aux.cached_styles[0] = styles.clone()
    }
}

fn (aux $&ListTextAux) take_menu() TextContextMenu {
    ms := $&aux.menus
    << ms.take(0)
}

fn (aux $&ListTextAux) put_menu(m TextContextMenu) {
    aux.menus[0] = m
}

pub fn (aux $&ListTextAux) ensure_menu(context &draw.Context,identity &ui.CanvasEvent,id int) {
    if !aux.menus.has(0) {
        $fresh := text_context_menu(context,identity,id)
        fresh_ref := $&fresh
        fresh_ref.set_zh(aux.zh)
        if aux.viewport.width > 0.0 && aux.viewport.height > 0.0 {
            fresh_ref.set_viewport(&aux.viewport)
        }
        aux.menus[0] = fresh
    }
}

pub fn (aux $&ListTextAux) set_zh(zh bool) {
    aux.zh = zh
    if aux.menus.has(0) {
        $m := aux.take_menu()
        m_ref := $&m
        m_ref.set_zh(zh)
        aux.put_menu(m)
    }
}

pub fn (aux $&ListTextAux) set_viewport(viewport &layout.Rect,context &draw.Context,identity &ui.CanvasEvent,id int) {
    aux.viewport = copy_rect(viewport)
    aux.ensure_menu(context,identity,id)
    $m := aux.take_menu()
    m_ref := $&m
    m_ref.set_viewport(viewport)
    aux.put_menu(m)
}

pub fn (aux $&ListTextAux) painted() {
    if aux.menus.has(0) {
        $m := aux.take_menu()
        m_ref := $&m
        m_ref.painted()
        aux.put_menu(m)
    }
}

pub fn (aux $&ListTextAux) close_menu() bool {
    if !aux.menus.has(0) { << false }
    $m := aux.take_menu()
    m_ref := $&m
    closed := m_ref.close()
    aux.put_menu(m)
    << closed
}

pub fn (aux $&ListTextAux) paint_menu_styled(frame $&draw.Frame,styles &Styles) int {
    if !aux.menus.has(0) { << 0 }
    $m := aux.take_menu()
    m_ref := $&m
    err := paint_text_context_menu_err(m_ref,frame,styles)
    aux.put_menu(m)
    if err.len > 0 { >>> errors.new(err) }
    << 0
}

pub fn (aux $&ListTextAux) route_menu(event &ui.InputEvent,density f64) TextMenuResult {
    if !aux.is_menu_open() { << text_menu_no_result() }
    $m := aux.take_menu()
    m_ref := $&m
    res := m_ref.input(event,density)
    aux.put_menu(m)
    << res
}

pub fn (aux $&ListTextAux) open_menu(context &draw.Context,identity &ui.CanvasEvent,id int,x f64,y f64,show_row bool,density f64) bool {
    aux.ensure_menu(context,identity,id)
    << aux.open_cached_menu(x,y,show_row,density)
}

pub fn (aux $&ListTextAux) open_cached_menu(x f64,y f64,show_row bool,density f64) bool {
    if !aux.menus.has(0) { << false }
    sel_ok := aux.selection.selectable
    has_active := sel_ok && aux.active_text.len > 0
    has_row := sel_ok && (aux.row_text.len > 0 || aux.active_text.len > 0)
    spec := TextMenuSpec{
        show_cut: false,cut_enabled: false,
        show_copy: true,copy_enabled: has_active,
        show_paste: false,paste_enabled: false,
        show_select_all: true,select_all_enabled: has_active,
        show_copy_row: show_row,copy_row_enabled: has_row
    }
    $m := aux.take_menu()
    m_ref := $&m
    opened := m_ref.open(x,y,&spec,density)
    aux.put_menu(m)
    << opened
}

pub fn (aux $&ListTextAux) handle_menu_cmd(cmd int,identity &ui.CanvasEvent) bool {
    if !aux.selection.selectable { << false }
    if cmd == TEXT_MENU_COPY {
        if aux.selection.has_selection() {
            sel := aux.selection.selected_text(&aux.active_text)
            _ := try_copy_clipboard(identity,&sel)
            << false
        }
        if aux.active_text.len > 0 {
            _ := try_copy_clipboard(identity,&aux.active_text)
        }
        << false
    }
    if cmd == TEXT_MENU_COPY_ROW {
        $target := aux.row_text + ""
        if target.len == 0 { target = aux.active_text + "" }
        if target.len > 0 { _ := try_copy_clipboard(identity,&target) }
        << false
    }
    if cmd == TEXT_MENU_SELECT_ALL {
        if aux.active_text.len > 0 {
            txt := aux.active_text + ""
            sel := $&aux.selection
            << sel.select_all(&txt)
        }
    }
    << false
}

pub fn (aux $&ListTextAux) begin_pointer(text &string,row_text &string,idx int,row int,col int,event &ui.InputEvent) bool {
    if aux.sel_row != row || aux.sel_col != col {
        sel := $&aux.selection
        sel.reset_clicks()
        _ := sel.clear()
        aux.sel_row = row
        aux.sel_col = col
    }
    aux.active_text = text + ""
    aux.row_text = row_text + ""
    aux.drag_start_x = event.x
    aux.drag_start_y = event.y
    $changed := false
    $char_drag := false
    if true {
        sel := $&aux.selection
        changed = sel.begin_pointer_down(text,idx,event)
        char_drag = sel.is_drag_char()
    }
    aux.drag_moved = !char_drag
    << changed
}

pub fn (aux $&ListTextAux) should_begin_drag(x f64,y f64,density f64) bool {
    if !aux.selection.selecting { << false }
    if aux.drag_moved { << true }
    d := math.max(0.5,density)
    thresh := 4.0 * d
    if math.abs(x - aux.drag_start_x) > thresh || math.abs(y - aux.drag_start_y) > thresh {
        aux.drag_moved = true
        << true
    }
    << false
}

pub fn (aux $&ListTextAux) drag_to(idx int) bool {
    txt := aux.active_text + ""
    sel := $&aux.selection
    << sel.drag_pointer(&txt,idx)
}

pub fn (aux $&ListTextAux) end_pointer() bool {
    aux.drag_moved = false
    sel := $&aux.selection
    << sel.end_pointer()
}

pub fn (aux $&ListTextAux) clear_selection() bool {
    aux.drag_moved = false
    sel := $&aux.selection
    was := sel.clear()
    _ := sel.end_pointer()
    << was
}

pub fn (aux $&ListTextAux) key_action(event &ui.InputEvent,identity &ui.CanvasEvent) int {
    if !aux.selection.selectable { << TEXT_KEY_NONE }
    if ui.is_clipboard_modifier(event.modifiers) && (event.key == 67 || event.key == 99) {
        if aux.selection.has_selection() {
            sel := aux.selection.selected_text(&aux.active_text)
            _ := try_copy_clipboard(identity,&sel)
            << TEXT_KEY_COPY
        }
        $target := aux.row_text + ""
        if target.len == 0 { target = aux.active_text + "" }
        if target.len > 0 {
            _ := try_copy_clipboard(identity,&target)
            << TEXT_KEY_COPY
        }
        << TEXT_KEY_NONE
    }
    txt := aux.active_text + ""
    sel := $&aux.selection
    << sel.key_navigation(&txt,event)
}

pub fn (aux $&ListTextAux) dispose() {
    if aux.menus.has(0) {
        $m := aux.take_menu()
        m_ref := $&m
        m_ref.dispose()
    }
}
