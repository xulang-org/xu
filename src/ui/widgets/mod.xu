@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

// Persistent control state is separate from text shaping and frame recording.
// The caller owns the TextLayout and acknowledges paint only after present succeeds.
pub const action_none = 0
pub const action_activate = 1
pub const action_change = 2
pub const action_scroll = 3
pub struct Action {
    pub kind int
    pub id int
    pub needs_paint bool
    pub request_focus bool
    pub consumed bool
    pub value f64
}
pub struct Theme {
    pub normal draw.Color
    pub hovered draw.Color
    pub pressed draw.Color
    pub disabled draw.Color
    pub foreground draw.Color
    pub muted draw.Color
    pub accent draw.Color
    pub focus draw.Color
}
pub fn default_theme() Theme {
    << Theme{normal: draw.rgb(55,63,76),hovered: draw.rgb(68,80,96),pressed: draw.rgb(35,45,60),
             disabled: draw.rgb(43,47,55),foreground: draw.rgb(245,247,250),muted: draw.rgb(147,154,165),
             accent: draw.rgb(59,130,246),focus: draw.rgb(147,197,253)}
}
fn valid_identity(identity &ui.CanvasEvent) bool {
    << identity.window_id > 0 && identity.window_id <= 2147483647 && identity.canvas_id > 0 && identity.canvas_id <= 2147483647 &&
       identity.generation > 0 && identity.generation <= 4294967295
}
fn validate_bounds(bounds &layout.Rect) int {
    _ := layout.intersect(bounds,bounds) or >>
    << 0
}
fn belongs(identity &ui.CanvasEvent,input &ui.InputEvent) bool {
    << input.window_id == identity.window_id && input.canvas_id == identity.canvas_id && input.generation == identity.generation
}
fn copy_rect(bounds &layout.Rect) layout.Rect {
    << layout.Rect{x: bounds.x,y: bounds.y,width: bounds.width,height: bounds.height}
}
fn copy_identity(identity &ui.CanvasEvent) ui.CanvasEvent {
    << ui.CanvasEvent{window_id: identity.window_id,canvas_id: identity.canvas_id,generation: identity.generation}
}
fn no_action(id int,dirty bool) Action {
    << Action{kind: action_none,id: id,needs_paint: dirty,request_focus: false,consumed: false,value: 0.0}
}

pub struct Button {
    id int
    identity ui.CanvasEvent
    bounds layout.Rect
    enabled bool
    focused bool
    hovered bool
    pointer_armed bool
    keyboard_armed int
    dirty bool
    closed bool
    invalid bool
    selected bool
    read_only bool
    custom ScalarControlStyle
}
pub fn button(identity &ui.CanvasEvent,id int,bounds &layout.Rect) Button {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid control identity") }
    validate_bounds(bounds) or >>
    << Button{id: id,identity: copy_identity(identity),bounds: copy_rect(bounds),enabled: true,focused: false,hovered: false,
              pointer_armed: false,keyboard_armed: 0,dirty: true,closed: false,invalid: false,selected: false,read_only: false,custom: empty_scalar_style()}
}
pub fn (button &Button) id() int { << button.id }
pub fn (button &Button) needs_paint() bool { << button.dirty }
pub fn (button &Button) is_focused() bool { << button.focused }
pub fn (button &Button) is_enabled() bool { << button.enabled && !button.closed && button.bounds.width > 0.0 && button.bounds.height > 0.0 }
pub fn (button &Button) bounds() layout.Rect { << copy_rect(&button.bounds) }
pub fn (button &mut Button) painted() { button.dirty = false }
pub fn (button &mut Button) invalidate() { button.dirty = true }
pub fn (button &mut Button) cancel() {
    if button.pointer_armed || button.keyboard_armed != 0 || button.hovered || button.focused { button.dirty = true }
    button.pointer_armed = false
    button.keyboard_armed = 0
    button.hovered = false
    button.focused = false
}
pub fn (button &mut Button) set_enabled(enabled bool) {
    if button.enabled != enabled { button.dirty = true }
    button.enabled = enabled
    if !enabled { button.cancel() }
}
pub fn (button &mut Button) set_focus(focused bool) {
    value := focused && button.is_enabled()
    if button.focused != value { button.dirty = true }
    button.focused = value
    if !value { button.keyboard_armed = 0
        if button.pointer_armed { button.pointer_armed = false
            button.dirty = true } }
}
pub fn (button &mut Button) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if button.bounds.x != bounds.x || button.bounds.y != bounds.y || button.bounds.width != bounds.width || button.bounds.height != bounds.height {
        button.bounds = copy_rect(bounds)
        if bounds.width == 0.0 || bounds.height == 0.0 { button.cancel() }
        button.pointer_armed = false
        button.hovered = false
        button.dirty = true
    }
    << 0
}
// Releases activate only a press armed by this control. Foreign/stale window
// events, disabled controls, repeat keys and focus/capture cancellation cannot click.
pub fn (button &mut Button) input(input &ui.InputEvent) Action {
    if !belongs(&button.identity,input) || button.closed { << no_action(button.id,button.dirty) }
    if input.kind == ui.ev_pointer_cancel { button.cancel()
        << no_action(button.id,button.dirty) }
    if !button.is_enabled() { << no_action(button.id,button.dirty) }
    inside := button.bounds.contains(input.x,input.y)
    mut activated := false
    mut focus := false
    mut consumed := false
    if input.kind == ui.ev_pointer_move || input.kind == ui.ev_pointer_enter || input.kind == ui.ev_pointer_leave {
        hot := inside && input.kind != ui.ev_pointer_leave
        if hot != button.hovered { button.hovered = hot
            button.dirty = true }
    } else if input.kind == ui.ev_pointer_down && input.button == ui.button_left && inside {
        button.hovered = true
        button.keyboard_armed = 0
        button.dirty = true
        focus = true
        consumed = true
        if !button.read_only { button.pointer_armed = true }
    } else if input.kind == ui.ev_pointer_up && input.button == ui.button_left {
        consumed = button.pointer_armed
        activated = !button.read_only && button.pointer_armed && inside
        if button.pointer_armed { button.dirty = true }
        button.pointer_armed = false
        if button.hovered != inside { button.dirty = true }
        button.hovered = inside
    } else if input.kind == ui.ev_key_down && button.focused {
        if input.key == ui.key_escape { button.keyboard_armed = 0
            button.pointer_armed = false
            button.dirty = true
            consumed = true }
        else if !button.read_only && (input.key == 32 || input.key == ui.key_enter) && input.repeat == 0 && button.keyboard_armed == 0 {
            button.keyboard_armed = input.key
            button.dirty = true
            consumed = true
        }
    } else if input.kind == ui.ev_key_up && button.focused && button.keyboard_armed != 0 && input.key == button.keyboard_armed {
        button.keyboard_armed = 0
        button.dirty = true
        activated = !button.read_only
        consumed = true
    }
    mut kind := action_none
    if activated { kind = action_activate }
    << Action{kind: kind,id: button.id,needs_paint: button.dirty,request_focus: focus,consumed: consumed,value: 0.0}
}
pub fn (button &mut Button) event(event &ui.Event) Action {
    if event.window_id != button.identity.window_id { << no_action(button.id,button.dirty) }
    if event.kind == ui.ev_closed || event.kind == ui.ev_blurred {
        button.cancel()
        if event.kind == ui.ev_closed { button.closed = true }
        << no_action(button.id,button.dirty)
    }
    if event.kind == ui.ev_canvas_closed {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == button.identity.canvas_id && identity.generation == button.identity.generation { button.cancel()
            button.closed = true }
        << no_action(button.id,button.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(button.id,button.dirty) }
    input := ui.input_of(event) or >>
    << button.input(&input)
}
pub fn button_size(label &draw.TextLayout) layout.Size {
    << layout.Size{width: math.max(64.0,label.metrics.width + 24.0),height: math.max(32.0,label.metrics.height + 12.0)}
}
fn (button &Button) fill(theme &Theme) draw.Color {
    if !button.enabled || button.closed { << theme.disabled }
    if (button.pointer_armed && button.hovered) || button.keyboard_armed != 0 { << theme.pressed }
    if button.hovered { << theme.hovered }
    << theme.normal
}
fn focus_ring(frame &mut draw.Frame,bounds &layout.Rect,color draw.Color) int {
    if bounds.width > 4.0 && bounds.height > 4.0 { frame.stroke_rect(bounds.x + 2.0,bounds.y + 2.0,bounds.width - 4.0,bounds.height - 4.0,color,2.0) or >> }
    << 0
}
pub fn (button &Button) paint(frame &mut draw.Frame,label &draw.TextLayout,theme &Theme) int {
    frame.push() or >>
    frame.clip_rect(button.bounds.x,button.bounds.y,button.bounds.width,button.bounds.height) or >>
    frame.fill_rect(button.bounds.x,button.bounds.y,button.bounds.width,button.bounds.height,button.fill(theme)) or >>
    mut color := theme.foreground
    if !button.is_enabled() { color = theme.muted }
    x := button.bounds.x + (button.bounds.width - label.metrics.width) * 0.5
    y := button.bounds.y + (button.bounds.height - label.metrics.height) * 0.5
    frame.text_layout(label,x,y,color) or >>
    if button.focused { focus_ring(frame,&button.bounds,theme.focus) or >> }
    frame.pop() or >>
    << 0
}

pub struct Checkbox {
    control Button
    checked bool
    custom ScalarControlStyle
}
pub fn checkbox(identity &ui.CanvasEvent,id int,bounds &layout.Rect,checked bool) Checkbox {
    control := button(identity,id,bounds) or >>
    << Checkbox{control: control,checked: checked,custom: empty_scalar_style()}
}
pub fn (checkbox &mut Checkbox) set_focus(focused bool) {
    control := mut &checkbox.control
    control.set_focus(focused)
}
pub fn (checkbox &mut Checkbox) set_enabled(enabled bool) {
    control := mut &checkbox.control
    control.set_enabled(enabled)
}
pub fn (checkbox &mut Checkbox) set_bounds(bounds &layout.Rect) int {
    control := mut &checkbox.control
    << control.set_bounds(bounds) or >>
}
pub fn (checkbox &Checkbox) needs_paint() bool { << checkbox.control.needs_paint() }
pub fn (checkbox &mut Checkbox) painted() { control := mut &checkbox.control
    control.painted() }
pub fn (checkbox &Checkbox) value() bool { << checkbox.checked }
pub fn (checkbox &mut Checkbox) set_value(checked bool) {
    if checked != checkbox.checked { checkbox.checked = checked
        control := mut &checkbox.control
        control.invalidate() }
}
pub fn (checkbox &mut Checkbox) input(input &ui.InputEvent) Action {
    control := mut &checkbox.control
    mut action := control.input(input)
    if action.kind == action_activate { checkbox.checked = !checkbox.checked
        control := mut &checkbox.control
        control.invalidate()
        action.kind = action_change
        action.value = 0.0
        if checkbox.checked { action.value = 1.0 } }
    << action
}
pub fn (checkbox &mut Checkbox) event(event &ui.Event) Action {
    control := mut &checkbox.control
    mut action := control.event(event) or >>
    if action.kind == action_activate { checkbox.checked = !checkbox.checked
        control := mut &checkbox.control
        control.invalidate()
        action.kind = action_change
        action.value = 0.0
        if checkbox.checked { action.value = 1.0 } }
    << action
}
pub fn (checkbox &Checkbox) paint(frame &mut draw.Frame,label &draw.TextLayout,theme &Theme) int {
    bounds := copy_rect(&checkbox.control.bounds)
    side := math.min(20.0,math.min(bounds.width,bounds.height))
    x := bounds.x
    y := bounds.y + (bounds.height - side) * 0.5
    frame.push() or >>
    frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
    mut fill := checkbox.control.fill(theme)
    if checkbox.checked && checkbox.control.is_enabled() { fill = theme.accent }
    frame.fill_rect(x,y,side,side,fill) or >>
    mut foreground := theme.foreground
    if !checkbox.control.is_enabled() { foreground = theme.muted }
    if checkbox.checked && side >= 8.0 {
        frame.line(x + side * 0.2,y + side * 0.5,x + side * 0.45,y + side * 0.75,foreground,2.0) or >>
        frame.line(x + side * 0.45,y + side * 0.75,x + side * 0.8,y + side * 0.25,foreground,2.0) or >>
    }
    frame.text_layout(label,x + side + 8.0,bounds.y + (bounds.height - label.metrics.height) * 0.5,foreground) or >>
    if checkbox.control.focused { focus_ring(frame,&bounds,theme.focus) or >> }
    frame.pop() or >>
    << 0
}

pub struct Progress {
    enabled bool
    invalid bool
    focused bool
    selected bool
    bounds layout.Rect
    value f64
    dirty bool
    custom ScalarControlStyle
}
pub fn progress(bounds &layout.Rect,value f64) Progress {
    validate_bounds(bounds) or >>
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid progress") }
    << Progress{enabled: true,invalid: false,focused: false,selected: false,bounds: copy_rect(bounds),value: math.max(0.0,math.min(1.0,value)),dirty: true,custom: empty_scalar_style()}
}
pub fn (progress &Progress) value() f64 { << progress.value }
pub fn (progress &Progress) needs_paint() bool { << progress.dirty }
pub fn (progress &mut Progress) painted() { progress.dirty = false }
pub fn (progress &mut Progress) set_value(value f64) int {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid progress") }
    clamped := math.max(0.0,math.min(1.0,value))
    if clamped != progress.value { progress.value = clamped
        progress.dirty = true }
    << 0
}
pub fn (progress &mut Progress) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if progress.bounds.x != bounds.x || progress.bounds.y != bounds.y || progress.bounds.width != bounds.width || progress.bounds.height != bounds.height {
        progress.bounds = copy_rect(bounds)
        progress.dirty = true
    }
    << 0
}
pub fn (progress &Progress) paint(frame &mut draw.Frame,theme &Theme) int {
    frame.fill_rect(progress.bounds.x,progress.bounds.y,progress.bounds.width,progress.bounds.height,theme.normal) or >>
    frame.fill_rect(progress.bounds.x,progress.bounds.y,progress.bounds.width * progress.value,progress.bounds.height,theme.accent) or >>
    << 0
}

// A widget surface uses logical coordinates and handles scrolling itself.
pub struct Host {
    pub context draw.Context
    pub identity ui.CanvasEvent
}
pub fn attach(window &ui.Window) Host {
    context := draw.window_context(window) or >>
    window.content_command("input_enabled\t1") or >>
    window.content_command("pan_enabled\t0") or >>
    << Host{context: context,identity: ui.CanvasEvent{window_id: window.id,canvas_id: window.id,generation: window.generation}}
}
