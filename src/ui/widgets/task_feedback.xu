@ui/widgets

#time
#errors

pub struct TaskFeedback {
    pub delay time.Duration
    pub success_hold time.Duration
    pub percentage bool
    pub thickness f64
}
pub fn task_feedback() TaskFeedback {
    << TaskFeedback{delay:time.duration(120*time.millisecond()),success_hold:time.duration(0),percentage:true,thickness:3.0}
}
pub fn (task &mut TaskButton) set_feedback(feedback &TaskFeedback) int {
    if feedback.delay.is_negative() || feedback.delay.nanoseconds()>5*time.second() || feedback.success_hold.is_negative() || feedback.success_hold.nanoseconds()>time.hour() || !finite_metric(feedback.thickness,12.0) || feedback.thickness<=0.0 { >> errors.new("widgets: invalid task feedback") }
    task.feedback=TaskFeedback{delay:feedback.delay,success_hold:feedback.success_hold,percentage:feedback.percentage,thickness:feedback.thickness}
    task.control.dirty=true
    << 0
}
fn (task &TaskButton) feedback_visible() bool {
    << task.feedback.delay.is_zero() || task.now.since(task.started).nanoseconds()>=task.feedback.delay.nanoseconds()
}
