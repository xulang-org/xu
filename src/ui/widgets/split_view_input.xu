@ui/widgets
#ui
#math

fn (v $&SplitView) begin_edit() { if !v.pending { v.saved_ratio = v.ratio
    v.saved_collapsed = v.collapsed
    v.pending = true } }
fn (v $&SplitView) move_ratio(value f64) {
    v.collapsed = 0
    v.ratio = math.max(0.0,math.min(1.0,value))
    actual := v.layout()
    v.ratio = actual.ratio
    v.control.dirty = true
}
pub fn (v $&SplitView) input(event &ui.InputEvent) Action {
    if !belongs(&v.control.identity,event) || v.control.closed { << no_action(v.id(),false) }
    if event.kind == ui.EV_POINTER_CANCEL { v.cancel()
        << no_action(v.id(),true) }
    if !v.is_enabled() { << no_action(v.id(),v.needs_paint()) }
    layout := v.layout()
    inside := layout.handle.contains(event.x,event.y)
    old := v.ratio
    old_collapsed := v.collapsed
    $action := no_action(v.id(),v.needs_paint())
    $commit := false
    if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_ENTER || event.kind == ui.EV_POINTER_LEAVE {
        hot := inside && event.kind != ui.EV_POINTER_LEAVE
        if v.control.hovered != hot { v.control.hovered = hot
            v.control.dirty = true }
        if v.dragging && !v.control.read_only {
            bounds := v.bounds()
            $position := event.x - bounds.x - layout.handle.width * 0.5
            $length := bounds.width - layout.handle.width
            if v.options.vertical { position = event.y - bounds.y - layout.handle.height * 0.5
                length = bounds.height - layout.handle.height }
            v.move_ratio(position / math.max(1.0,length))
            action.consumed = true }
    } else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && inside {
        action.request_focus = true
        action.consumed = true
        if !v.control.read_only {
            if event.click_count >= 2 {
                if v.collapsed != 0 { v.collapsed = 0 } else { v.ratio = 0.5 }
                action.kind = ACTION_COMMIT
            } else { v.begin_edit()
                v.dragging = true }
            v.control.dirty = true }
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && v.dragging {
        commit = v.pending && (v.ratio != v.saved_ratio || v.collapsed != v.saved_collapsed)
        v.pending = false
        v.key_pending = 0
        v.dragging = false
        action.consumed = true
        v.control.dirty = true
    } else if event.kind == ui.EV_KEY_DOWN && v.control.focused {
        if event.key == ui.KEY_ESCAPE { v.cancel()
            v.control.focused = true
            action.consumed = true }
        else if !v.control.read_only {
            $delta := 0.0
            if (!v.options.vertical && event.key == ui.KEY_LEFT) || (v.options.vertical && event.key == ui.KEY_UP) { delta = 0.0 - v.options.keyboard_step }
            if (!v.options.vertical && event.key == ui.KEY_RIGHT) || (v.options.vertical && event.key == ui.KEY_DOWN) { delta = v.options.keyboard_step }
            if (event.modifiers & ui.MOD_SHIFT) != 0 { delta = delta * 10.0 }
            if delta != 0.0 || event.key == ui.KEY_HOME || event.key == ui.KEY_END {
                v.begin_edit()
                v.key_pending = event.key
                $candidate := v.layout().ratio + delta
                if event.key == ui.KEY_HOME { candidate = 0.0 }
                if event.key == ui.KEY_END { candidate = 1.0 }
                v.move_ratio(candidate)
                action.consumed = true }
            else if event.key == ui.KEY_ENTER && event.repeat == 0 {
                if v.collapsed != 0 { v.collapsed = 0 } else { v.ratio = 0.5 }
                v.control.dirty = true
                action.kind = ACTION_COMMIT
                action.consumed = true }
        }
    } else if event.kind == ui.EV_KEY_UP && v.pending && !v.dragging && event.key == v.key_pending {
        commit = v.ratio != v.saved_ratio || v.collapsed != v.saved_collapsed
        v.pending = false
        v.key_pending = 0
        action.consumed = true }
    if action.kind == ACTION_NONE && (v.ratio != old || v.collapsed != old_collapsed) { action.kind = ACTION_CHANGE }
    if commit { action.kind = ACTION_COMMIT }
    action.value = v.ratio
    action.needs_paint = v.needs_paint()
    << action
}
pub fn (v $&SplitView) route(kind int,event &ui.InputEvent) Action {
    if kind == ROUTE_FOCUS { v.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { v.cancel() }
    else if kind == ROUTE_INPUT { << v.input(event) or >> }
    << no_action(v.id(),v.needs_paint())
}
