@ui/widgets

#ui
#errors
#math
#time

pub const ACTION_DOUBLE_CLICK = 19
pub const ACTION_LONG_PRESS = 20
pub const ACTION_SWIPE = 21

pub const GESTURE_DOUBLE_CLICK = 1
pub const GESTURE_LONG_PRESS = 2
pub const GESTURE_SWIPE = 4

pub const SWIPE_LEFT = 1
pub const SWIPE_RIGHT = 2
pub const SWIPE_UP = 3
pub const SWIPE_DOWN = 4

pub fn (s $&Screen) enable_gestures(id int,mask int) int {
    _ := s.node(id) >>>
    if mask < 0 || mask > 7 { >> errors.new("widgets: invalid gesture mask") }
    if mask == 0 { << s.clear_gestures(id) >>> }
    comp := $&s.composition
    gm := $&comp.gesture_masks
    had := gm.has(id)
    gm[id] = mask
    if !had { comp.gesture_count = comp.gesture_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_gestures(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.gesture_masks.has(id) {
        gm := $&comp.gesture_masks
        gm.delete(id)
        if comp.gesture_count > 0 { comp.gesture_count = comp.gesture_count - 1 }
    }
    if comp.gesture_down_node == id { comp.gesture_down_node = 0 }
    if comp.gesture_last_tap_node == id { comp.gesture_last_tap_node = 0 }
    << 0
}

pub fn (s &Screen) gesture_mask(id int) int {
    _ := s.node(id) >>>
    << s.composition.gesture_masks.get_or(id,0)
}

pub fn (s $&Screen) set_gesture_config(double_click_ms int,long_press_ms int,swipe_px f64) int {
    s.check_screen() >>>
    if double_click_ms < 50 || double_click_ms > 2000 ||
       long_press_ms < 100 || long_press_ms > 5000 ||
       math.is_nan(swipe_px) || math.is_inf(swipe_px) || swipe_px < 10.0 || swipe_px > 512.0 {
        >> errors.new("widgets: invalid gesture configuration")
    }
    comp := $&s.composition
    comp.gesture_double_click_ms = double_click_ms
    comp.gesture_long_press_ms = long_press_ms
    comp.gesture_swipe_px = swipe_px
    << 0
}

fn (s &Screen) node_has_gestures(id int) bool {
    << s.composition.gesture_count > 0 && s.composition.gesture_masks.has(id)
}

fn (s &Screen) find_gesture_target(id int,flag int) int {
    if s.composition.gesture_count == 0 || id <= 0 || id > s.nodes.len { << 0 }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        n := s.nodes[cur - 1]
        if n.kind < 0 || !s.is_visible(cur) { <- }
        if (s.composition.gesture_masks.get_or(cur,0) & flag) != 0 && s.effective_enabled(cur) {
            << cur
        }
        if screen_is_overlay(n.kind) { <- }
        cur = n.parent
        budget -= 1
    }
    << 0
}

fn (s $&Screen) reset_gestures_silently() {
    comp := $&s.composition
    comp.gesture_down_node = 0
    comp.gesture_long_fired = false
    comp.gesture_last_tap_node = 0
}

fn (s $&Screen) gesture_handle_pointer(input &ui.InputEvent,target int,actions $&[]Action) bool {
    if s.composition.gesture_count == 0 && s.composition.gesture_down_node == 0 { << false }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        gnode := s.find_gesture_target(target,GESTURE_DOUBLE_CLICK | GESTURE_LONG_PRESS | GESTURE_SWIPE)
        if gnode > 0 {
            comp := $&s.composition
            comp.gesture_down_node = target
            comp.gesture_down_x = input.x
            comp.gesture_down_y = input.y
            comp.gesture_down_ns = s.now.nanoseconds()
            comp.gesture_long_fired = false
            lp := s.find_gesture_target(target,GESTURE_LONG_PRESS)
            if lp > 0 {
                due := time.instant_from_ns(comp.gesture_down_ns + comp.gesture_long_press_ms * 1000000) >>> (err) { << false }
                s.animation_deadline = screen_earlier(s.animation_deadline,due)
            }
        } else {
            comp := $&s.composition
            comp.gesture_down_node = 0
            comp.gesture_long_fired = false
        }
        << false
    }
    if input.kind == ui.EV_POINTER_MOVE {
        if s.composition.gesture_down_node > 0 && !s.composition.gesture_long_fired {
            dx := input.x - s.composition.gesture_down_x
            dy := input.y - s.composition.gesture_down_y
            if dx * dx + dy * dy > 100.0 {
                comp := $&s.composition
                comp.gesture_long_fired = true
            }
        }
        << false
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        down_target := s.composition.gesture_down_node
        if down_target <= 0 { << false }
        sx := s.composition.gesture_down_x
        sy := s.composition.gesture_down_y
        long_fired := s.composition.gesture_long_fired
        comp := $&s.composition
        comp.gesture_down_node = 0
        if long_fired {
            comp.gesture_last_tap_node = 0
            << false
        }
        dx := input.x - sx
        dy := input.y - sy
        adx := math.abs(dx)
        ady := math.abs(dy)
        thresh := s.composition.gesture_swipe_px
        sw_node := s.find_gesture_target(down_target,GESTURE_SWIPE)
        if sw_node > 0 && (adx >= thresh || ady >= thresh) {
            $dir := SWIPE_LEFT
            if adx >= ady {
                if dx > 0.0 { dir = SWIPE_RIGHT } else { dir = SWIPE_LEFT }
            } else {
                if dy > 0.0 { dir = SWIPE_DOWN } else { dir = SWIPE_UP }
            }
            comp.gesture_last_tap_node = 0
            actions.push(Action{kind: ACTION_SWIPE,id: sw_node,needs_paint: false,request_focus: false,consumed: true,value: f64(dir)})
            << true
        }
        dc_node := s.find_gesture_target(target,GESTURE_DOUBLE_CLICK)
        if dc_node > 0 {
            now_ns := s.now.nanoseconds()
            dt_limit := s.composition.gesture_double_click_ms * 1000000
            last_dx := input.x - s.composition.gesture_last_tap_x
            last_dy := input.y - s.composition.gesture_last_tap_y
            if s.composition.gesture_last_tap_node == dc_node &&
               now_ns >= s.composition.gesture_last_tap_ns &&
               (now_ns - s.composition.gesture_last_tap_ns) <= dt_limit &&
               (last_dx * last_dx + last_dy * last_dy) <= 144.0 {
                comp.gesture_last_tap_node = 0
                actions.push(Action{kind: ACTION_DOUBLE_CLICK,id: dc_node,needs_paint: false,request_focus: false,consumed: false,value: 2.0})
            } else {
                comp.gesture_last_tap_node = dc_node
                comp.gesture_last_tap_x = input.x
                comp.gesture_last_tap_y = input.y
                comp.gesture_last_tap_ns = now_ns
            }
        } else {
            comp.gesture_last_tap_node = 0
        }
    }
    << false
}

fn (s $&Screen) advance_gestures(now time.Instant) time.Instant {
    down_target := s.composition.gesture_down_node
    if down_target <= 0 || s.composition.gesture_long_fired { << time.zero_instant() }
    lp_node := s.find_gesture_target(down_target,GESTURE_LONG_PRESS)
    if lp_node <= 0 { << time.zero_instant() }
    fire_ns := s.composition.gesture_down_ns + s.composition.gesture_long_press_ms * 1000000
    if now.nanoseconds() >= fire_ns {
        comp := $&s.composition
        comp.gesture_long_fired = true
        comp.gesture_last_tap_node = 0
        qa := $&s.queued_actions
        qa.push(Action{kind: ACTION_LONG_PRESS,id: lp_node,needs_paint: true,request_focus: false,consumed: true,value: 1.0})
        s.mark_paint_dirty()
        << time.zero_instant()
    }
    << time.instant_from_ns(fire_ns) >>>
}

fn (s $&Screen) cleanup_gestures_for(id int) {
    comp := $&s.composition
    if comp.gesture_masks.has(id) {
        gm := $&comp.gesture_masks
        gm.delete(id)
        if comp.gesture_count > 0 { comp.gesture_count = comp.gesture_count - 1 }
    }
    if comp.gesture_down_node == id { comp.gesture_down_node = 0 }
    if comp.gesture_last_tap_node == id { comp.gesture_last_tap_node = 0 }
}
