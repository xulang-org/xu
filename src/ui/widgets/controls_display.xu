@ui/widgets

#ui/draw
#ui/layout
#errors
#math

pub struct Divider {
    axis_val int
    bounds layout.Rect
    enabled bool
    invalid bool
    selected bool
    dirty bool
    custom ScalarControlStyle
}
pub fn divider(bounds &layout.Rect,axis int) Divider {
    validate_bounds(bounds) or >>
    if axis < AXIS_VERTICAL || axis > AXIS_HORIZONTAL {
        >> errors.new("widgets: invalid divider axis")
    }
    << Divider{axis_val: axis,bounds: copy_rect(bounds),enabled: true,invalid: false,selected: false,dirty: true,custom: empty_scalar_style()}
}
pub fn (div &Divider) axis() int { << div.axis_val }
pub fn (div $&Divider) set_axis(axis int) int {
    if axis < AXIS_VERTICAL || axis > AXIS_HORIZONTAL { >> errors.new("widgets: invalid divider axis") }
    if div.axis_val != axis {
        div.axis_val = axis
        div.dirty = true
    }
    << 0
}
pub fn (div &Divider) bounds() layout.Rect { << copy_rect(&div.bounds) }
pub fn (div $&Divider) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if div.bounds.x != bounds.x || div.bounds.y != bounds.y || div.bounds.width != bounds.width || div.bounds.height != bounds.height {
        div.bounds = copy_rect(bounds)
        div.dirty = true
    }
    << 0
}
pub fn (div &Divider) needs_paint() bool { << div.dirty }
pub fn (div $&Divider) painted() { div.dirty = false }
pub fn (div $&Divider) invalidate() { div.dirty = true }
pub fn (div &Divider) is_enabled() bool { << div.enabled }
pub fn (div $&Divider) set_enabled(enabled bool) {
    if div.enabled != enabled {
        div.enabled = enabled
        div.dirty = true
    }
}
pub fn (div &Divider) is_invalid() bool { << div.invalid }
pub fn (div $&Divider) set_invalid(invalid bool) {
    if div.invalid != invalid {
        div.invalid = invalid
        div.dirty = true
    }
}
pub fn (div &Divider) is_selected() bool { << div.selected }
pub fn (div $&Divider) set_selected(selected bool) {
    if div.selected != selected {
        div.selected = selected
        div.dirty = true
    }
}
pub fn (div &Divider) visual_state() int {
    $state := 0
    if !div.enabled { state = state | STATE_DISABLED }
    if div.invalid { state = state | STATE_INVALID }
    if div.selected { state = state | STATE_SELECTED }
    << state
}
pub fn (div &Divider) has_style() bool { << div.custom.active }
pub fn (div &Divider) style_or(styles &Styles) ControlStyle {
    if div.custom.active { << unpack_scalar_style(&div.custom) }
    << styles.divider_style()
}
pub fn (div $&Divider) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !div.custom.active || !control_equal(&unpack_scalar_style(&div.custom),&next) { div.dirty = true }
    div.custom = pack_scalar_style(style)
    << 0
}
pub fn (div $&Divider) clear_style() {
    if div.custom.active {
        div.custom.active = false
        div.dirty = true
    }
}
pub fn (div &Divider) paint(frame $&draw.Frame,theme &Theme) int {
    b := div.bounds
    $color := theme.muted
    if div.selected { color = theme.accent }
    if div.axis_val == AXIS_HORIZONTAL {
        y := b.y + b.height * 0.5
        frame.line(b.x,y,b.x + b.width,y,color,1.0) or >>
    } else {
        x := b.x + b.width * 0.5
        frame.line(x,b.y,x,b.y + b.height,color,1.0) or >>
    }
    << 0
}
pub fn (div &Divider) measure_styled(styles &Styles) layout.Size {
    c := div.style_or(styles)
    d := styles.density
    thickness := math.max(1.0,c.border_width * d)
    if div.axis_val == AXIS_HORIZONTAL {
        << layout.Size{width: math.max(c.min_width * d,(c.padding.left + c.padding.right) * d),
            height: math.max(c.min_height * d,thickness + (c.padding.top + c.padding.bottom) * d)}
    }
    << layout.Size{width: math.max(c.min_width * d,thickness + (c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,(c.padding.top + c.padding.bottom) * d)}
}
pub fn (div &Divider) measure_labeled_styled(label $&StyledLabel,styles &Styles) layout.Size {
    c := div.style_or(styles)
    d := styles.density
    sz := label.measure_styled(styles,&c) or >>
    gap := c.gap * d
    << layout.Size{width: math.max(c.min_width * d,sz.width + gap * 2.0 + 32.0 * d + (c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,sz.height + (c.padding.top + c.padding.bottom) * d)}
}
pub fn (div &Divider) paint_styled(frame $&draw.Frame,styles &Styles) int {
    c := div.style_or(styles)
    b := div.bounds
    d := styles.density
    state := div.visual_state()
    resolved := c.resolve(state)
    $line_color := resolved.border
    if div.selected { line_color = c.palette.accent }
    if div.invalid { line_color = c.palette.invalid }
    thickness := math.max(1.0,c.border_width * d)
    left := c.padding.left * d
    top := c.padding.top * d
    w := math.max(0.0,b.width - left - c.padding.right * d)
    h := math.max(0.0,b.height - top - c.padding.bottom * d)
    if div.axis_val == AXIS_HORIZONTAL {
        y := b.y + top + h * c.align_y
        frame.line(b.x + left,y,b.x + left + w,y,line_color,thickness) or >>
    } else {
        x := b.x + left + w * c.align_x
        frame.line(x,b.y + top,x,b.y + top + h,line_color,thickness) or >>
    }
    << 0
}
pub fn (div &Divider) paint_labeled_styled(frame $&draw.Frame,label $&StyledLabel,styles &Styles) int {
    if label.value.len == 0 { << div.paint_styled(frame,styles) or >> }
    c := div.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    shaped := label.layouts[0]
    b := div.bounds
    d := styles.density
    state := div.visual_state()
    resolved := c.resolve(state)
    $line_color := resolved.border
    if div.selected { line_color = c.palette.accent }
    if div.invalid { line_color = c.palette.invalid }
    thickness := math.max(1.0,c.border_width * d)
    left := c.padding.left * d
    top := c.padding.top * d
    w := math.max(0.0,b.width - left - c.padding.right * d)
    h := math.max(0.0,b.height - top - c.padding.bottom * d)
    gap := c.gap * d
    text_w := shaped.metrics.width
    text_h := shaped.metrics.height
    tx := b.x + left + math.max(0.0,(w - text_w) * c.align_x)
    ty := b.y + top + (h - text_h) * c.align_y
    line_y := b.y + top + h * c.align_y
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    left_end := math.max(b.x + left,tx - gap)
    if left_end > b.x + left {
        frame.line(b.x + left,line_y,left_end,line_y,line_color,thickness) or >>
    }
    right_start := math.min(b.x + left + w,tx + text_w + gap)
    if b.x + left + w > right_start {
        frame.line(right_start,line_y,b.x + left + w,line_y,line_color,thickness) or >>
    }
    $text_color := c.palette.muted
    if div.selected { text_color = c.palette.accent }
    if div.invalid { text_color = c.palette.invalid }
    frame.text_layout(&shaped,tx,ty,text_color) or >>
    frame.pop() or >>
    << 0
}

pub struct Badge {
    variant int
    tone int
    bounds layout.Rect
    enabled bool
    selected bool
    invalid bool
    focused bool
    hovered bool
    dirty bool
    custom ScalarControlStyle
}
pub fn badge(bounds &layout.Rect) Badge {
    validate_bounds(bounds) or >>
    << Badge{variant: BADGE_STATUS,tone: BADGE_NEUTRAL,bounds: copy_rect(bounds),enabled: true,selected: false,invalid: false,focused: false,hovered: false,dirty: true,custom: empty_scalar_style()}
}
pub fn (bg &Badge) bounds() layout.Rect { << copy_rect(&bg.bounds) }
pub fn (bg $&Badge) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if bg.bounds.x != bounds.x || bg.bounds.y != bounds.y || bg.bounds.width != bounds.width || bg.bounds.height != bounds.height {
        bg.bounds = copy_rect(bounds)
        bg.dirty = true
    }
    << 0
}
pub fn (bg &Badge) needs_paint() bool { << bg.dirty }
pub fn (bg $&Badge) painted() { bg.dirty = false }
pub fn (bg $&Badge) invalidate() { bg.dirty = true }
pub fn (bg &Badge) is_enabled() bool { << bg.enabled }
pub fn (bg $&Badge) set_enabled(enabled bool) {
    if bg.enabled != enabled {
        bg.enabled = enabled
        bg.dirty = true
    }
}
pub fn (bg &Badge) is_selected() bool { << bg.selected }
pub fn (bg $&Badge) set_selected(selected bool) {
    if bg.selected != selected {
        bg.selected = selected
        bg.dirty = true
    }
}
pub fn (bg &Badge) is_invalid() bool { << bg.invalid }
pub fn (bg $&Badge) set_invalid(invalid bool) {
    if bg.invalid != invalid {
        bg.invalid = invalid
        bg.dirty = true
    }
}
pub fn (bg &Badge) is_focused() bool { << bg.focused && bg.enabled }
pub fn (bg $&Badge) set_focus(focused bool) {
    next := focused && bg.enabled
    if bg.focused != next {
        bg.focused = next
        bg.dirty = true
    }
}
pub fn (bg &Badge) is_hovered() bool { << bg.hovered }
pub fn (bg $&Badge) set_hovered(hovered bool) {
    if bg.hovered != hovered {
        bg.hovered = hovered
        bg.dirty = true
    }
}
pub fn (bg &Badge) visual_state() int {
    $state := 0
    if !bg.enabled { state = state | STATE_DISABLED }
    if bg.invalid { state = state | STATE_INVALID }
    if bg.selected { state = state | STATE_SELECTED }
    if bg.hovered { state = state | STATE_HOVERED }
    if bg.focused && bg.enabled { state = state | STATE_FOCUSED }
    << state
}
pub fn (bg &Badge) has_style() bool { << bg.custom.active }
pub fn (bg &Badge) style_or(styles &Styles) ControlStyle {
    << bg.variant_style(styles)
}
pub fn (bg $&Badge) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !bg.custom.active || !control_equal(&unpack_scalar_style(&bg.custom),&next) { bg.dirty = true }
    bg.custom = pack_scalar_style(style)
    << 0
}
pub fn (bg $&Badge) clear_style() {
    if bg.custom.active {
        bg.custom.active = false
        bg.dirty = true
    }
}
pub fn (bg &Badge) paint(frame $&draw.Frame,label &draw.TextLayout,theme &Theme) int {
    b := bg.bounds
    $fill := theme.normal
    if !bg.enabled { fill = theme.disabled }
    else if bg.selected { fill = theme.accent }
    rounded_fill(frame,&b,b.height * 0.5,fill) or >>
    tx := b.x + (b.width - label.metrics.width) * 0.5
    ty := b.y + (b.height - label.metrics.height) * 0.5
    frame.text_layout(label,tx,ty,theme.foreground) or >>
    << 0
}
pub fn (bg &Badge) measure_styled(label $&StyledLabel,styles &Styles) layout.Size {
    c := bg.style_or(styles)
    if bg.variant == BADGE_DOT { << layout.Size{width: c.min_width * styles.density,height: c.min_height * styles.density} }
    d := styles.density
    sz := label.measure_styled(styles,&c) or >>
    dot := c.indicator_size * d
    $gap := c.gap * d
    if dot <= 0.0 || label.value.len == 0 { gap = 0.0 }
    $w := sz.width + dot + gap
    $h := math.max(sz.height,dot)
    if c.icon_placement == ICON_ABOVE || c.icon_placement == ICON_BELOW {
        w = math.max(sz.width,dot)
        h = sz.height + dot + gap
    }
    measured_h := math.max(c.min_height * d,h + (c.padding.top + c.padding.bottom) * d)
    $measured_w := math.max(c.min_width * d,w + (c.padding.left + c.padding.right) * d)
    if bg.variant == BADGE_COUNT { measured_w = math.max(measured_w,measured_h) }
    << layout.Size{width: measured_w,height: measured_h}
}
pub fn (bg &Badge) paint_styled(frame $&draw.Frame,label $&StyledLabel,styles &Styles) int {
    c := bg.style_or(styles)
    if bg.variant == BADGE_DOT { << style_box(frame,&bg.bounds,&c,styles.density,bg.visual_state()) or >> }
    _ := label.measure_styled(styles,&c) or >>
    b := bg.bounds
    d := styles.density
    state := bg.visual_state()
    resolved := c.resolve(state)
    style_box(frame,&b,&c,d,state) or >>
    left := c.padding.left * d
    top := c.padding.top * d
    avail_w := math.max(0.0,b.width - left - c.padding.right * d)
    avail_h := math.max(0.0,b.height - top - c.padding.bottom * d)
    dot := math.max(0.0,math.min(c.indicator_size * d,math.min(avail_w,avail_h)))
    shaped := label.layouts[0]
    $text_w := shaped.metrics.width
    $text_h := shaped.metrics.height
    $gap := c.gap * d
    if dot <= 0.0 || label.value.len == 0 { gap = 0.0 }
    if label.value.len == 0 {
        text_w = 0.0
        text_h = 0.0
    }
    $content_w := dot + gap + text_w
    $content_h := math.max(dot,text_h)
    if c.icon_placement == ICON_ABOVE || c.icon_placement == ICON_BELOW {
        content_w = math.max(dot,text_w)
        content_h = dot + gap + text_h
    }
    x := b.x + left + (avail_w - content_w) * c.align_x
    y := b.y + top + (avail_h - content_h) * c.align_y
    $dx := x
    $dy := y + (content_h - dot) * 0.5
    $tx := x + dot + gap
    $ty := y + (content_h - text_h) * 0.5
    if c.icon_placement == ICON_TRAILING {
        tx = x
        dx = x + text_w + gap
    }
    if c.icon_placement == ICON_ABOVE {
        dx = x + (content_w - dot) * c.align_x
        dy = y
        tx = x + (content_w - text_w) * c.align_x
        ty = y + dot + gap
    }
    if c.icon_placement == ICON_BELOW {
        tx = x + (content_w - text_w) * c.align_x
        ty = y
        dx = x + (content_w - dot) * c.align_x
        dy = y + text_h + gap
    }
    frame.push() or >>
    frame.clip_rect(b.x + left,b.y + top,avail_w,avail_h) or >>
    if dot > 0.0 {
        $dot_color := c.palette.accent
        if bg.invalid { dot_color = c.palette.invalid }
        else if bg.selected { dot_color = resolved.foreground }
        else if !bg.enabled { dot_color = c.palette.muted }
        dot_rect := layout.Rect{x: dx,y: dy,width: dot,height: dot}
        rounded_fill(frame,&dot_rect,dot * 0.5,dot_color) or >>
    }
    if label.value.len > 0 {
        frame.text_layout(&shaped,tx,ty,resolved.foreground) or >>
    }
    frame.pop() or >>
    << 0
}

pub struct Card {
    bounds layout.Rect
    enabled bool
    selected bool
    invalid bool
    focused bool
    hovered bool
    dirty bool
    custom ScalarControlStyle
}
pub fn card(bounds &layout.Rect) Card {
    validate_bounds(bounds) or >>
    << Card{bounds: copy_rect(bounds),enabled: true,selected: false,invalid: false,focused: false,hovered: false,dirty: true,custom: empty_scalar_style()}
}
pub fn (cd &Card) bounds() layout.Rect { << copy_rect(&cd.bounds) }
pub fn (cd $&Card) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if cd.bounds.x != bounds.x || cd.bounds.y != bounds.y || cd.bounds.width != bounds.width || cd.bounds.height != bounds.height {
        cd.bounds = copy_rect(bounds)
        cd.dirty = true
    }
    << 0
}
pub fn (cd &Card) content_bounds(styles &Styles) layout.Rect {
    c := cd.style_or(styles)
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    << layout.Rect{x: cd.bounds.x + left,y: cd.bounds.y + top,
        width: math.max(0.0,cd.bounds.width - left - c.padding.right * d),
        height: math.max(0.0,cd.bounds.height - top - c.padding.bottom * d)}
}
pub fn (cd &Card) needs_paint() bool { << cd.dirty }
pub fn (cd $&Card) painted() { cd.dirty = false }
pub fn (cd $&Card) invalidate() { cd.dirty = true }
pub fn (cd &Card) is_enabled() bool { << cd.enabled }
pub fn (cd $&Card) set_enabled(enabled bool) {
    if cd.enabled != enabled {
        cd.enabled = enabled
        cd.dirty = true
    }
}
pub fn (cd &Card) is_selected() bool { << cd.selected }
pub fn (cd $&Card) set_selected(selected bool) {
    if cd.selected != selected {
        cd.selected = selected
        cd.dirty = true
    }
}
pub fn (cd &Card) is_invalid() bool { << cd.invalid }
pub fn (cd $&Card) set_invalid(invalid bool) {
    if cd.invalid != invalid {
        cd.invalid = invalid
        cd.dirty = true
    }
}
pub fn (cd &Card) is_focused() bool { << cd.focused && cd.enabled }
pub fn (cd $&Card) set_focus(focused bool) {
    next := focused && cd.enabled
    if cd.focused != next {
        cd.focused = next
        cd.dirty = true
    }
}
pub fn (cd &Card) is_hovered() bool { << cd.hovered }
pub fn (cd $&Card) set_hovered(hovered bool) {
    if cd.hovered != hovered {
        cd.hovered = hovered
        cd.dirty = true
    }
}
pub fn (cd &Card) visual_state() int {
    $state := 0
    if !cd.enabled { state = state | STATE_DISABLED }
    if cd.invalid { state = state | STATE_INVALID }
    if cd.selected { state = state | STATE_SELECTED }
    if cd.hovered { state = state | STATE_HOVERED }
    if cd.focused && cd.enabled { state = state | STATE_FOCUSED }
    << state
}
pub fn (cd &Card) has_style() bool { << cd.custom.active }
pub fn (cd &Card) style_or(styles &Styles) ControlStyle {
    if cd.custom.active { << unpack_scalar_style(&cd.custom) }
    << styles.card_style()
}
pub fn (cd $&Card) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !cd.custom.active || !control_equal(&unpack_scalar_style(&cd.custom),&next) { cd.dirty = true }
    cd.custom = pack_scalar_style(style)
    << 0
}
pub fn (cd $&Card) clear_style() {
    if cd.custom.active {
        cd.custom.active = false
        cd.dirty = true
    }
}
pub fn (cd &Card) paint(frame $&draw.Frame,theme &Theme) int {
    b := cd.bounds
    rounded_fill(frame,&b,10.0,theme.normal) or >>
    rounded_stroke(frame,&b,10.0,theme.muted,1.0) or >>
    << 0
}
pub fn (cd &Card) measure_styled(styles &Styles) layout.Size {
    c := cd.style_or(styles)
    d := styles.density
    << layout.Size{width: math.max(c.min_width * d,(c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,(c.padding.top + c.padding.bottom) * d)}
}
pub fn (cd &Card) measure_header_styled(title $&StyledLabel,styles &Styles) layout.Size {
    c := cd.style_or(styles)
    d := styles.density
    sz := title.measure_styled(styles,&c) or >>
    << layout.Size{width: math.max(c.min_width * d,sz.width + (c.padding.left + c.padding.right) * d),
        height: math.max(c.min_height * d,sz.height + c.gap * d + (c.padding.top + c.padding.bottom) * d)}
}
pub fn (cd &Card) paint_styled(frame $&draw.Frame,styles &Styles) int {
    c := cd.style_or(styles)
    << style_box(frame,&cd.bounds,&c,styles.density,cd.visual_state()) or >>
}
pub fn (cd &Card) paint_header_styled(frame $&draw.Frame,title $&StyledLabel,styles &Styles) int {
    c := cd.style_or(styles)
    _ := title.measure_styled(styles,&c) or >>
    b := cd.bounds
    d := styles.density
    state := cd.visual_state()
    resolved := c.resolve(state)
    style_box(frame,&b,&c,d,state) or >>
    inner := cd.content_bounds(styles)
    shaped := title.layouts[0]
    frame.push() or >>
    frame.clip_rect(inner.x,inner.y,inner.width,inner.height) or >>
    tx := inner.x + (inner.width - shaped.metrics.width) * c.align_x
    ty := inner.y
    frame.text_layout(&shaped,tx,ty,resolved.foreground) or >>
    sep_y := inner.y + shaped.metrics.height + c.gap * d * 0.5
    if sep_y < inner.y + inner.height && c.border_width > 0.0 {
        frame.line(inner.x,sep_y,inner.x + inner.width,sep_y,resolved.border,math.max(1.0,c.border_width * d)) or >>
    }
    frame.pop() or >>
    << 0
}

pub fn (bg $&Badge) set_tone(tone int) int {
    if tone<BADGE_NEUTRAL || tone>BADGE_ERROR { >> errors.new("widgets: invalid badge tone") }
    bg.tone=tone
    bg.dirty=true
    << 0
}
