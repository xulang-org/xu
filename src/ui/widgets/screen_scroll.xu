@ui/widgets
#ui
#ui/draw
#ui/layout
#errors
#math

pub fn (scroll &Scroll) axis() int { << scroll.axis }
// Children occupy content coordinates; the rail stays outside their clip.
pub fn (scroll &Scroll) content_bounds() layout.Rect {
    mut b := scroll.bounds()
    rail := scroll.scrollbar_track()
    if rail.width > 0.0 && rail.height > 0.0 {
        if scroll.axis == AXIS_VERTICAL { b.width = math.max(0.0,rail.x - b.x) }
        else { b.height = math.max(0.0,rail.y - b.y) }
    }
    << b
}
// Scroll shares the internal surface node category with Card, but retains its
// own typed state. Child placement, hit testing and native clips use one offset.
pub fn (s &mut Screen) scroll_area(axis int,content_extent f64) int {
    id := s.add_node(SCREEN_CARD,true,ui.CURSOR_DEFAULT) or >>
    item := scroll(&s.identity,id,&screen_empty(),axis,content_extent) or (err) { s.abandon_node(id)
        >> err }
    s.basics.scrolls[id] = item
    << id
}
pub fn (s &mut Screen) set_scroll_offset(id int,offset f64) int {
    s.scroll_update(id,4,&screen_empty(),offset) or >>
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_scroll_extent(id int,extent f64) int {
    s.scroll_update(id,5,&screen_empty(),extent) or >>
    s.dirty = true
    << 0
}
pub fn (s &Screen) scroll_offset(id int) f64 {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    << s.basics.scrolls[id].offset()
}
fn (s &mut Screen) scroll_update(id int,operation int,bounds &layout.Rect,value f64) int {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    styles := s.styles.clone()
    owner := mut &s.basics
    items := mut &owner.scrolls
    mut item := items.take(id)
    message := screen_scroll_update(mut &item,operation,bounds,&styles,value)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    << 0
}
// Only explicit style updates need a style argument. Default updates use the
// existing local Styles snapshot, avoiding &s.styles beside writable s.
fn (s &mut Screen) scroll_set_style(id int,style &ControlStyle) int {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    owner := mut &s.basics
    items := mut &owner.scrolls
    mut item := items.take(id)
    message := screen_scroll_set_style(mut &item,style)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    << 0
}
fn screen_scroll_set_style(item &mut Scroll,style &ControlStyle) string {
    item.set_style(style) or (err) { << err.msg() }
    << ""
}
fn screen_scroll_update(item &mut Scroll,operation int,bounds &layout.Rect,styles &Styles,value f64) string {
    if operation == 0 { item.set_bounds(bounds) or (err) { << err.msg() }
        item.apply_styles(styles) or (err) { << err.msg() } }
    if operation == 1 { item.set_enabled(value > 0.0) }
    if operation == 2 { item.painted() }
    if operation == 4 { item.set_offset(value) or (err) { << err.msg() } }
    if operation == 5 { item.set_content_extent(value) or (err) { << err.msg() } }
    if operation == 6 { item.set_invalid(value > 0.0) }
    << ""
}
fn (s &mut Screen) scroll_input(id int,kind int,event &ui.InputEvent) Action {
    owner := mut &s.basics
    items := mut &owner.scrolls
    mut item := items.take(id)
    result := screen_scroll_input(mut &item,kind,event)
    items[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.action
}
fn screen_scroll_input(item &mut Scroll,kind int,event &ui.InputEvent) RefinedResult {
    action := item.route(kind,event) or (err) { << refined_failure(err.msg()) }
    mut result := refined_result()
    result.action = action
    << result
}
fn (s &mut Screen) scroll_paint(id int,frame &mut draw.Frame,styles &Styles) int {
    owner := mut &s.basics
    items := mut &owner.scrolls
    mut item := items.take(id)
    message := screen_scroll_paint(mut &item,frame,styles)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    << 0
}
fn screen_scroll_paint(item &mut Scroll,frame &mut draw.Frame,styles &Styles) string {
    item.paint_scrollbar(frame,styles) or (err) { << err.msg() }
    << ""
}
fn (s &mut Screen) scroll_content_clip(id int) layout.Rect {
    owner := mut &s.basics
    items := mut &owner.scrolls
    item := items.take(id)
    clip := item.content_bounds()
    items[id] = item
    << clip
}
fn (s &mut Screen) child_clip(id int) layout.Rect {
    mut clip := s.viewport()
    n := s.node(id) or >>
    mut parent := n.parent
    mut budget := s.nodes.len
    while parent > 0 && budget > 0 { p := s.node(parent) or >>
        if s.controls.split_panes.has(parent) { clip = screen_clip_intersection(&clip,&p.bounds) }
        if s.basics.scrolls.has(parent) { b := s.scroll_content_clip(parent)
            clip = screen_clip_intersection(&clip,&b) }
        if p.kind >= SCREEN_POPOVER { clip = screen_clip_intersection(&clip,&p.bounds)
            <- }
        parent = p.parent
        budget -= 1
    }
    << clip
}
fn screen_clip_intersection(a &layout.Rect,b &layout.Rect) layout.Rect {
    x := math.max(a.x,b.x)
    y := math.max(a.y,b.y)
    << layout.Rect{x: x,y: y,width: math.max(0.0,math.min(a.x + a.width,b.x + b.width) - x),height: math.max(0.0,math.min(a.y + a.height,b.y + b.height) - y)}
}
fn (s &mut Screen) bubble_scroll(id int,event &ui.InputEvent,actions &mut []Action) int {
    mut n := s.node(id) or >>
    while n.parent > 0 { n = s.node(n.parent) or >>
        if s.basics.scrolls.has(n.id) && n.enabled { a := s.scroll_input(n.id,ROUTE_INPUT,event) or >>
            s.accept(a,actions) or >>
            if a.consumed { <- } }
    }
    << 0
}
fn (s &mut Screen) reveal_scroll_child(id int) int {
    mut n := s.node(id) or >>
    while n.parent > 0 { parent := n.parent
        if (s.node(parent) or >>).kind >= SCREEN_POPOVER { <- }
        if s.basics.scrolls.has(parent) { b := s.bounds(id) or >>
            clip := s.scroll_content_clip(parent)
            axis := s.basics.scrolls[parent].axis()
            mut delta := 0.0
            if axis == AXIS_VERTICAL { if b.y < clip.y { delta = b.y - clip.y }
                else if b.y + b.height > clip.y + clip.height { delta = math.min(b.y - clip.y,b.y + b.height - clip.y - clip.height) } }
            else { if b.x < clip.x { delta = b.x - clip.x }
                else if b.x + b.width > clip.x + clip.width { delta = math.min(b.x - clip.x,b.x + b.width - clip.x - clip.width) } }
            if delta != 0.0 { offset := s.basics.scrolls[parent].offset()
                s.set_scroll_offset(parent,offset + delta) or >>
                s.layout_controls() or >> }
        }
        n = s.node(parent) or >>
    }
    << 0
}
