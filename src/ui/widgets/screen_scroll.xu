@ui/widgets
#ui
#ui/draw
#ui/layout
#errors
#math

pub fn (scroll &Scroll) axis() int { << scroll.axis }
// Children occupy content coordinates; the rail stays outside their clip.
pub fn (scroll &Scroll) content_bounds() layout.Rect {
    $b := scroll.bounds()
    rail := scroll.scrollbar_track()
    if rail.width > 0.0 && rail.height > 0.0 {
        if scroll.axis == AXIS_VERTICAL { b.width = math.max(0.0,rail.x - b.x) }
        else { b.height = math.max(0.0,rail.y - b.y) }
    }
    << b
}
// Scroll shares the internal surface node category with Card, but retains its
// own typed state. Child placement, hit testing and native clips use one offset.
pub fn (s $&Screen) scroll_area(axis int,content_extent f64) int {
    id := s.add_node(SCREEN_CARD,true,ui.CURSOR_DEFAULT) >>>
    item := scroll(&s.identity,id,&screen_empty(),axis,content_extent) >>> (err) { s.abandon_node(id)
        >> err }
    s.basics.scrolls[id] = item
    << id
}
fn (s $&Screen) set_scroll_offset_internal(id int,offset f64) int {
    s.scroll_update(id,4,&screen_empty(),offset) >>>
    if s.basics.scrolls[id].needs_paint() { s.mark_layout_dirty() }
    if s.composition.virtual_viewport_ids.len > 0 { s.check_virtual_viewports() }
    if s.composition.intersection_observer_ids.len > 0 { s.check_intersection_observers() }
    << 0
}
pub fn (s $&Screen) set_scroll_offset(id int,offset f64) int {
    s.cancel_scroll_transition(id)
    << s.set_scroll_offset_internal(id,offset) >>>
}
pub fn (s $&Screen) set_scroll_extent(id int,extent f64) int {
    s.scroll_update(id,5,&screen_empty(),extent) >>>
    if s.basics.scrolls[id].needs_paint() { s.mark_layout_dirty() }
    << 0
}
pub fn (s &Screen) scroll_offset(id int) f64 {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    << s.basics.scrolls[id].offset()
}
pub fn (s &Screen) scroll_max_offset(id int) f64 {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    << s.basics.scrolls[id].max_offset()
}
pub fn (s $&Screen) scroll_by(id int,delta f64) int {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    if math.is_nan(delta) || math.is_inf(delta) { >> errors.new("widgets: invalid scroll delta") }
    cur := s.basics.scrolls[id].offset()
    << s.set_scroll_offset(id,cur + delta) >>>
}
pub fn (s $&Screen) ensure_visible(id int) int {
    _ := s.node(id) >>>
    s.layout_controls() >>>
    << s.reveal_scroll_child(id) >>>
}
fn (s $&Screen) scroll_update(id int,operation int,bounds &layout.Rect,value f64) int {
    styles := s.styles_for(id)
    << s.scroll_update_styled(id,operation,bounds,&styles,value) >>>
}
fn (s $&Screen) scroll_update_styled(id int,operation int,bounds &layout.Rect,styles &Styles,value f64) int {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    owner := $&s.basics
    items := $&owner.scrolls
    $item := items.take(id)
    message := screen_scroll_update($&item,operation,bounds,styles,value)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    << 0
}
// Only explicit style updates need a style argument. Default updates use the
// existing local Styles snapshot, avoiding &s.styles beside writable s.
fn (s $&Screen) scroll_set_style(id int,style &ControlStyle) int {
    if !s.basics.scrolls.has(id) { >> errors.new("widgets: expected Scroll") }
    owner := $&s.basics
    items := $&owner.scrolls
    $item := items.take(id)
    message := screen_scroll_set_style($&item,style)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    << 0
}
fn screen_scroll_set_style(item $&Scroll,style &ControlStyle) string {
    item.set_style(style) >>> (err) { << err.msg() }
    << ""
}
fn screen_scroll_update(item $&Scroll,operation int,bounds &layout.Rect,styles &Styles,value f64) string {
    if operation == 0 { item.set_bounds(bounds) >>> (err) { << err.msg() }
        item.apply_styles(styles) >>> (err) { << err.msg() } }
    if operation == 1 { item.set_enabled(value > 0.0) }
    if operation == 2 { item.painted() }
    if operation == 4 { item.set_offset(value) >>> (err) { << err.msg() } }
    if operation == 5 { item.set_content_extent(value) >>> (err) { << err.msg() } }
    if operation == 6 { item.set_invalid(value > 0.0) }
    << ""
}
fn (s $&Screen) scroll_input(id int,kind int,event &ui.InputEvent) Action {
    owner := $&s.basics
    items := $&owner.scrolls
    $item := items.take(id)
    result := screen_scroll_input($&item,kind,event)
    items[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    if result.action.kind == ACTION_SCROLL {
        s.cancel_scroll_transition(id)
        if s.composition.virtual_viewport_ids.len > 0 { s.check_virtual_viewports() }
        if s.composition.intersection_observer_ids.len > 0 { s.check_intersection_observers() }
    }
    << result.action
}
fn screen_scroll_input(item $&Scroll,kind int,event &ui.InputEvent) RefinedResult {
    action := item.route(kind,event) >>> (err) { << refined_failure(err.msg()) }
    $result := refined_result()
    result.action = action
    << result
}
fn (s $&Screen) scroll_paint(id int,frame $&draw.Frame,styles &Styles) int {
    owner := $&s.basics
    items := $&owner.scrolls
    $item := items.take(id)
    message := screen_scroll_paint($&item,frame,styles)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    << 0
}
fn screen_scroll_paint(item $&Scroll,frame $&draw.Frame,styles &Styles) string {
    item.paint_scrollbar(frame,styles) >>> (err) { << err.msg() }
    << ""
}
fn (s &Screen) scroll_content_clip(id int) layout.Rect {
    << s.basics.scrolls[id].content_bounds()
}
fn (s $&Screen) child_clip(id int) layout.Rect {
    $clip := s.viewport()
    if s.is_floating_node(id) || s.is_drawer_node(id) { << clip }
    n := s.node(id) >>>
    $parent := n.parent
    $budget := s.nodes.len
    while parent > 0 && budget > 0 { p := s.node(parent) >>>
        if s.controls.split_panes.has(parent) { clip = screen_clip_intersection(&clip,&p.bounds) }
        if s.container_is_clipped(parent) { clip = screen_clip_intersection(&clip,&p.bounds) }
        if s.basics.scrolls.has(parent) { b := s.scroll_content_clip(parent)
            clip = screen_clip_intersection(&clip,&b) }
        if screen_is_overlay(p.kind) || s.is_floating_node(parent) || s.is_drawer_node(parent) { clip = screen_clip_intersection(&clip,&p.bounds)
            <- }
        parent = p.parent
        budget -= 1
    }
    << clip
}
fn screen_clip_intersection(a &layout.Rect,b &layout.Rect) layout.Rect {
    x := math.max(a.x,b.x)
    y := math.max(a.y,b.y)
    << layout.Rect{x: x,y: y,width: math.max(0.0,math.min(a.x + a.width,b.x + b.width) - x),height: math.max(0.0,math.min(a.y + a.height,b.y + b.height) - y)}
}
fn (s $&Screen) bubble_scroll(id int,event &ui.InputEvent,actions $&[]Action) int {
    $n := s.node(id) >>>
    while n.parent > 0 { n = s.node(n.parent) >>>
        if s.basics.scrolls.has(n.id) && s.effective_enabled(n.id) && (s.is_hit_test_enabled(n.id) >>>) {
            local_ev := s.event_in_node_space(n.id,event)
            a := s.scroll_input(n.id,ROUTE_INPUT,&local_ev) >>>
            s.accept(a,actions) >>>
            if a.consumed { <- } }
    }
    << 0
}
fn (s $&Screen) reveal_scroll_child(id int) int {
    $n := s.node(id) >>>
    while n.parent > 0 { parent := n.parent
        if screen_is_overlay((s.node(parent) >>>).kind) { <- }
        if s.basics.scrolls.has(parent) { b := s.bounds(id) >>>
            clip := s.scroll_content_clip(parent)
            axis := s.basics.scrolls[parent].axis()
            $delta := 0.0
            if axis == AXIS_VERTICAL { if b.y < clip.y { delta = b.y - clip.y }
                else if b.y + b.height > clip.y + clip.height { delta = math.min(b.y - clip.y,b.y + b.height - clip.y - clip.height) } }
            else { if b.x < clip.x { delta = b.x - clip.x }
                else if b.x + b.width > clip.x + clip.width { delta = math.min(b.x - clip.x,b.x + b.width - clip.x - clip.width) } }
            if delta != 0.0 { offset := s.basics.scrolls[parent].offset()
                s.set_scroll_offset(parent,offset + delta) >>>
                s.layout_controls() >>> }
        }
        n = s.node(parent) >>>
    }
    << 0
}
