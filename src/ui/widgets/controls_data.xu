@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#time

pub struct Stepper {
    locale Locale
    id int
    identity ui.CanvasEvent
    bounds layout.Rect
    min_val f64
    max_val f64
    step_val f64
    val f64
    hovered_part int
    armed_part int
    repeat_enabled bool
    repeat_delay time.Duration
    repeat_interval time.Duration
    next_repeat time.Instant
    repeated int
    button_extent f64
    enabled bool
    focused bool
    hovered bool
    dirty bool
    closed bool
    invalid bool
    read_only bool
    custom ScalarControlStyle
}
pub fn stepper(identity &ui.CanvasEvent,id int,bounds &layout.Rect,min f64,max f64,step f64,value f64) Stepper {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid control identity") }
    validate_bounds(bounds) or >>
    if math.is_nan(min) || math.is_inf(min) || math.is_nan(max) || math.is_inf(max) || max <= min ||
       math.is_nan(step) || math.is_inf(step) || step <= 0.0 || step > (max - min) || math.is_nan(value) || math.is_inf(value) {
        >> errors.new("widgets: invalid stepper range or step")
    }
    << Stepper{locale: locale_default(),id: id,identity: copy_identity(identity),bounds: copy_rect(bounds),min_val: min,max_val: max,step_val: step,
        val: clamp_slider_value(min,max,step,value),hovered_part: 0,armed_part: 0,repeat_enabled: true,repeat_delay: time.duration(400 * time.millisecond()),repeat_interval: time.duration(70 * time.millisecond()),next_repeat: time.zero_instant(),repeated: 0,button_extent: 36.0,enabled: true,focused: false,
        hovered: false,dirty: true,closed: false,invalid: false,read_only: false,custom: empty_scalar_style()}
}
pub fn (st &Stepper) id() int { << st.id }
pub fn (st &Stepper) bounds() layout.Rect { << copy_rect(&st.bounds) }
pub fn (st &Stepper) value() f64 { << st.val }
pub fn (st &Stepper) min() f64 { << st.min_val }
pub fn (st &Stepper) max() f64 { << st.max_val }
pub fn (st &Stepper) step() f64 { << st.step_val }
pub fn (st &Stepper) can_decrement() bool { << st.is_enabled() && !st.read_only && st.val > st.min_val + 0.000001 }
pub fn (st &Stepper) can_increment() bool { << st.is_enabled() && !st.read_only && st.val < st.max_val - 0.000001 }
pub fn (st &Stepper) needs_paint() bool { << st.dirty }
pub fn (st $&Stepper) painted() { st.dirty = false }
pub fn (st $&Stepper) invalidate() { st.dirty = true }
pub fn (st $&Stepper) cancel() {
    if st.armed_part != 0 || st.hovered_part != 0 || st.hovered || st.focused { st.dirty = true }
    st.armed_part = 0
    st.next_repeat = time.zero_instant()
    st.repeated = 0
    st.hovered_part = 0
    st.hovered = false
    st.focused = false
}
pub fn (st &Stepper) is_enabled() bool { << st.enabled && !st.closed && st.bounds.width > 0.0 && st.bounds.height > 0.0 }
pub fn (st $&Stepper) set_enabled(enabled bool) {
    if st.enabled != enabled { st.dirty = true }
    st.enabled = enabled
    if !enabled { st.cancel() }
}
pub fn (st &Stepper) is_focused() bool { << st.focused }
pub fn (st $&Stepper) set_focus(focused bool) {
    next := focused && st.is_enabled()
    if st.focused != next { st.dirty = true }
    st.focused = next
    if !next && st.armed_part != 0 {
        st.armed_part = 0
        st.dirty = true
    }
}
pub fn (st &Stepper) is_hovered() bool { << st.hovered }
pub fn (st &Stepper) is_invalid() bool { << st.invalid }
pub fn (st $&Stepper) set_invalid(invalid bool) {
    if st.invalid != invalid {
        st.invalid = invalid
        st.dirty = true
    }
}
pub fn (st &Stepper) is_read_only() bool { << st.read_only }
pub fn (st $&Stepper) set_read_only(read_only bool) {
    if st.read_only != read_only {
        st.read_only = read_only
        st.armed_part = 0
        st.dirty = true
    }
}
pub fn (st $&Stepper) set_value(value f64) int {
    if math.is_nan(value) || math.is_inf(value) { >> errors.new("widgets: invalid stepper value") }
    next := clamp_slider_value(st.min_val,st.max_val,st.step_val,value)
    if next != st.val {
        st.val = next
        st.dirty = true
    }
    << 0
}
pub fn (st $&Stepper) set_range(min f64,max f64,step f64) int {
    if math.is_nan(min) || math.is_inf(min) || math.is_nan(max) || math.is_inf(max) || max <= min ||
       math.is_nan(step) || math.is_inf(step) || step <= 0.0 || step > (max - min) {
        >> errors.new("widgets: invalid stepper range or step")
    }
    st.min_val = min
    st.max_val = max
    st.step_val = step
    st.val = clamp_slider_value(min,max,step,st.val)
    st.dirty = true
    << 0
}
pub fn (st $&Stepper) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if st.bounds.x != bounds.x || st.bounds.y != bounds.y || st.bounds.width != bounds.width || st.bounds.height != bounds.height {
        st.bounds = copy_rect(bounds)
        if bounds.width == 0.0 || bounds.height == 0.0 { st.cancel() }
        st.armed_part = 0
        st.hovered_part = 0
        st.hovered = false
        st.dirty = true
    }
    << 0
}
pub fn (st &Stepper) visual_state() int {
    $state := 0
    if st.invalid { state = state | STATE_INVALID }
    if st.read_only { state = state | STATE_READ_ONLY }
    if !st.is_enabled() { state = state | STATE_DISABLED }
    if st.hovered { state = state | STATE_HOVERED }
    if !st.read_only && st.armed_part != 0 && st.armed_part == st.hovered_part { state = state | STATE_PRESSED }
    if st.focused { state = state | STATE_FOCUSED }
    << state
}
pub fn (st &Stepper) has_style() bool { << st.custom.active }
pub fn (st &Stepper) style_or(styles &Styles) ControlStyle {
    if st.custom.active { << unpack_scalar_style(&st.custom) }
    << styles.stepper_style()
}
pub fn (st $&Stepper) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !st.custom.active || !control_equal(&unpack_scalar_style(&st.custom),&next) { st.dirty = true }
    st.custom = pack_scalar_style(style)
    << 0
}
pub fn (st $&Stepper) clear_style() {
    if st.custom.active {
        st.custom.active = false
        st.dirty = true
    }
}
fn (st &Stepper) hit_part(x f64,y f64) int {
    if !st.bounds.contains(x,y) { << 0 }
    btn_w := math.min(st.button_extent,st.bounds.width * 0.32)
    if x < st.bounds.x + btn_w { << 1 }
    if x >= st.bounds.x + st.bounds.width - btn_w { << 2 }
    << 0
}
pub fn (st $&Stepper) input(input &ui.InputEvent) Action {
    if input.time_ns < 0 { >> errors.new("widgets: invalid stepper event timestamp") }
    if !belongs(&st.identity,input) || st.closed { << no_action(st.id,st.dirty) }
    if input.kind == ui.EV_POINTER_CANCEL {
        st.cancel()
        << no_action(st.id,st.dirty)
    }
    if !st.is_enabled() { << no_action(st.id,st.dirty) }
    inside := st.bounds.contains(input.x,input.y)
    part := st.hit_part(input.x,input.y)
    $changed := false
    $focus := false
    $consumed := false
    if input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_LEAVE {
        hot := inside && input.kind != ui.EV_POINTER_LEAVE
        $next_part := 0
        if hot { next_part = part }
        if hot != st.hovered || next_part != st.hovered_part {
            st.hovered = hot
            st.hovered_part = next_part
            st.dirty = true
        }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && inside {
        st.hovered = true
        st.hovered_part = part
        st.dirty = true
        focus = true
        consumed = true
        if !st.read_only && part != 0 { st.armed_part = part
            st.repeated = 0
            $now := time.instant()
            if input.time_ns > 0 { now = time.instant_from_ns(input.time_ns) or >> }
            st.next_repeat = now.add(st.repeat_delay) or >> }
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if st.armed_part != 0 {
            consumed = true
            if !st.read_only && inside && part == st.armed_part && st.repeated == 0 {
                $candidate := st.val
                if part == 1 { candidate = st.val - st.step_val }
                else if part == 2 { candidate = st.val + st.step_val }
                next := clamp_slider_value(st.min_val,st.max_val,st.step_val,candidate)
                if next != st.val {
                    st.val = next
                    changed = true
                }
            }
            st.armed_part = 0
            st.next_repeat = time.zero_instant()
            st.repeated = 0
            st.dirty = true
        }
        $next_part := 0
        if inside { next_part = part }
        if st.hovered != inside || st.hovered_part != next_part { st.dirty = true }
        st.hovered = inside
        st.hovered_part = next_part
    } else if input.kind == ui.EV_KEY_DOWN && st.focused && !st.read_only {
        $candidate := st.val
        $handled := false
        if input.key == ui.KEY_LEFT || input.key == ui.KEY_DOWN {
            candidate = st.val - st.step_val
            handled = true
        } else if input.key == ui.KEY_RIGHT || input.key == ui.KEY_UP {
            candidate = st.val + st.step_val
            handled = true
        } else if input.key == ui.KEY_PAGE_DOWN {
            candidate = st.val - st.step_val * 5.0
            handled = true
        } else if input.key == ui.KEY_PAGE_UP {
            candidate = st.val + st.step_val * 5.0
            handled = true
        } else if input.key == ui.KEY_HOME {
            candidate = st.min_val
            handled = true
        } else if input.key == ui.KEY_END {
            candidate = st.max_val
            handled = true
        }
        if handled {
            consumed = true
            next := clamp_slider_value(st.min_val,st.max_val,st.step_val,candidate)
            if next != st.val {
                st.val = next
                st.dirty = true
                changed = true
            }
        }
    }
    $kind := ACTION_NONE
    if changed { kind = ACTION_CHANGE }
    << Action{kind: kind,id: st.id,needs_paint: st.dirty,request_focus: focus,consumed: consumed,value: st.val}
}
pub fn (st $&Stepper) event(event &ui.Event) Action {
    if event.window_id != st.identity.window_id { << no_action(st.id,st.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED {
        st.cancel()
        if event.kind == ui.EV_CLOSED { st.closed = true }
        << no_action(st.id,st.dirty)
    }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == st.identity.canvas_id && identity.generation == st.identity.generation {
            st.cancel()
            st.closed = true
        }
        << no_action(st.id,st.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(st.id,st.dirty) }
    input := ui.input_of(event) or >>
    << st.input(&input)
}
pub fn (st &Stepper) paint(frame $&draw.Frame,label &draw.TextLayout,theme &Theme) int {
    b := st.bounds
    btn_w := math.min(32.0,b.width * 0.32)
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    frame.fill_rect(b.x,b.y,b.width,b.height,theme.normal) or >>
    cy := b.y + b.height * 0.5
    lcx := b.x + btn_w * 0.5
    rcx := b.x + b.width - btn_w * 0.5
    frame.line(lcx - 5.0,cy,lcx + 5.0,cy,theme.foreground,2.0) or >>
    frame.line(rcx - 5.0,cy,rcx + 5.0,cy,theme.foreground,2.0) or >>
    frame.line(rcx,cy - 5.0,rcx,cy + 5.0,theme.foreground,2.0) or >>
    tx := b.x + (b.width - label.metrics.width) * 0.5
    ty := b.y + (b.height - label.metrics.height) * 0.5
    frame.text_layout(label,tx,ty,theme.foreground) or >>
    if st.focused { focus_ring(frame,&b,theme.focus) or >> }
    frame.pop() or >>
    << 0
}
pub fn (st &Stepper) measure_styled(label $&StyledLabel,styles &Styles) layout.Size {
    c := st.style_or(styles)
    d := styles.density
    sz := label.measure_styled(styles,&c) or >>
    btn_w := c.indicator_size * d
    w := sz.width + btn_w * 2.0 + (c.padding.left + c.padding.right) * d
    h := math.max(sz.height,btn_w * 0.75) + (c.padding.top + c.padding.bottom) * d
    << layout.Size{width: math.max(c.min_width * d,w),height: math.max(c.min_height * d,h)}
}
pub fn (st &Stepper) paint_styled(frame $&draw.Frame,label $&StyledLabel,styles &Styles) int {
    c := st.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    b := st.bounds
    d := styles.density
    $box_state := st.visual_state()
    box_state = box_state & (0 - 1 - STATE_HOVERED - STATE_PRESSED)
    resolved := c.resolve(box_state)
    style_box(frame,&b,&c,d,box_state) or >>
    btn_w := math.min(c.indicator_size * d,b.width * 0.32)
    left_box := layout.Rect{x: b.x + 2.0 * d,y: b.y + 2.0 * d,width: math.max(0.0,btn_w - 2.0 * d),height: math.max(0.0,b.height - 4.0 * d)}
    right_box := layout.Rect{x: b.x + b.width - btn_w,y: b.y + 2.0 * d,width: math.max(0.0,btn_w - 2.0 * d),height: math.max(0.0,b.height - 4.0 * d)}
    btn_r := math.max(2.0,(c.radius - 2.0) * d)
    if st.hovered_part == 1 && st.can_decrement() {
        $lstate := STATE_HOVERED
        if st.armed_part == 1 { lstate = lstate | STATE_PRESSED }
        rounded_fill(frame,&left_box,btn_r,c.resolve(lstate).background) or >>
    }
    if st.hovered_part == 2 && st.can_increment() {
        $rstate := STATE_HOVERED
        if st.armed_part == 2 { rstate = rstate | STATE_PRESSED }
        rounded_fill(frame,&right_box,btn_r,c.resolve(rstate).background) or >>
    }
    if c.border_width > 0.0 {
        bw := math.max(1.0,c.border_width * d)
        frame.line(b.x + btn_w,b.y + 4.0 * d,b.x + btn_w,b.y + b.height - 4.0 * d,resolved.border,bw) or >>
        frame.line(b.x + b.width - btn_w,b.y + 4.0 * d,b.x + b.width - btn_w,b.y + b.height - 4.0 * d,resolved.border,bw) or >>
    }
    cy := b.y + b.height * 0.5
    lcx := b.x + btn_w * 0.5
    rcx := b.x + b.width - btn_w * 0.5
    arm := math.min(5.0 * d,btn_w * 0.22)
    sw := math.max(1.5,c.mark_width * d)
    $l_ink := resolved.foreground
    if !st.can_decrement() { l_ink = c.palette.muted }
    $r_ink := resolved.foreground
    if !st.can_increment() { r_ink = c.palette.muted }
    frame.line(lcx - arm,cy,lcx + arm,cy,l_ink,sw) or >>
    frame.line(rcx - arm,cy,rcx + arm,cy,r_ink,sw) or >>
    frame.line(rcx,cy - arm,rcx,cy + arm,r_ink,sw) or >>
    center_w := math.max(0.0,b.width - btn_w * 2.0)
    shaped := label.layouts[0]
    frame.push() or >>
    frame.clip_rect(b.x + btn_w,b.y,center_w,b.height) or >>
    tx := b.x + btn_w + (center_w - shaped.metrics.width) * c.align_x
    ty := b.y + (b.height - shaped.metrics.height) * c.align_y
    frame.text_layout(&shaped,tx,ty,resolved.foreground) or >>
    frame.pop() or >>
    << 0
}

pub struct ListBox {
    appearance ListAppearance
    id int
    identity ui.CanvasEvent
    bounds layout.Rect
    count_val int
    selected_val int
    hovered_idx int
    armed_idx int
    scroll_y f64
    scroll_dragging bool
    scroll_grab f64
    row_h f64
    padding layout.Insets
    enabled bool
    focused bool
    hovered bool
    dirty bool
    closed bool
    invalid bool
    read_only bool
    custom ScalarControlStyle
}
pub fn list_box(identity &ui.CanvasEvent,id int,bounds &layout.Rect,count int,selected int) ListBox {
    if !valid_identity(identity) || id <= 0 { >> errors.new("widgets: invalid control identity") }
    validate_bounds(bounds) or >>
    if count < 0 || count > 4096 || (count > 0 && (selected < -1 || selected >= count)) {
        >> errors.new("widgets: invalid list_box count or selection")
    }
    << ListBox{appearance: list_appearance(),id: id,identity: copy_identity(identity),bounds: copy_rect(bounds),count_val: count,selected_val: selected,
        hovered_idx: -1,armed_idx: -1,scroll_y: 0.0,scroll_dragging: false,scroll_grab: 0.0,row_h: 28.0,
        padding: layout.Insets{left: 6.0,top: 6.0,right: 6.0,bottom: 6.0},enabled: true,focused: false,hovered: false,
        dirty: true,closed: false,invalid: false,read_only: false,custom: empty_scalar_style()}
}
pub fn (lb &ListBox) id() int { << lb.id }
pub fn (lb &ListBox) bounds() layout.Rect { << copy_rect(&lb.bounds) }
pub fn (lb &ListBox) count() int { << lb.count_val }
pub fn (lb &ListBox) selected() int { << lb.selected_val }
pub fn (lb &ListBox) hovered_item() int { << lb.hovered_idx }
pub fn (lb &ListBox) scroll_offset() f64 { << lb.scroll_y }
pub fn (lb &ListBox) needs_paint() bool { << lb.dirty }
pub fn (lb $&ListBox) painted() { lb.dirty = false }
pub fn (lb $&ListBox) invalidate() { lb.dirty = true }
pub fn (lb $&ListBox) cancel() {
    lb.scroll_dragging = false
    if lb.armed_idx >= 0 || lb.hovered_idx >= 0 || lb.hovered || lb.focused { lb.dirty = true }
    lb.armed_idx = -1
    lb.hovered_idx = -1
    lb.hovered = false
    lb.focused = false
}
pub fn (lb &ListBox) is_enabled() bool { << lb.enabled && !lb.closed && lb.bounds.width > 0.0 && lb.bounds.height > 0.0 }
pub fn (lb $&ListBox) set_enabled(enabled bool) {
    if lb.enabled != enabled { lb.dirty = true }
    lb.enabled = enabled
    if !enabled { lb.cancel() }
}
pub fn (lb &ListBox) is_focused() bool { << lb.focused }
pub fn (lb $&ListBox) set_focus(focused bool) {
    next := focused && lb.is_enabled()
    if lb.focused != next { lb.dirty = true }
    lb.focused = next
    if !next && lb.armed_idx >= 0 {
        lb.armed_idx = -1
        lb.dirty = true
    }
}
pub fn (lb &ListBox) is_hovered() bool { << lb.hovered }
pub fn (lb &ListBox) is_invalid() bool { << lb.invalid }
pub fn (lb $&ListBox) set_invalid(invalid bool) {
    if lb.invalid != invalid {
        lb.invalid = invalid
        lb.dirty = true
    }
}
pub fn (lb &ListBox) is_read_only() bool { << lb.read_only }
pub fn (lb $&ListBox) set_read_only(read_only bool) {
    if lb.read_only != read_only {
        lb.read_only = read_only
        lb.armed_idx = -1
        lb.dirty = true
    }
}
fn (lb &ListBox) max_scroll() f64 {
    viewport_h := math.max(0.0,lb.bounds.height - lb.padding.top - lb.padding.bottom)
    content_h := f64(lb.count_val) * lb.row_h
    << math.max(0.0,content_h - viewport_h)
}
pub fn (lb $&ListBox) set_scroll_offset(offset f64) int {
    if math.is_nan(offset) || math.is_inf(offset) { >> errors.new("widgets: invalid list_box scroll offset") }
    next := math.max(0.0,math.min(lb.max_scroll(),offset))
    if next != lb.scroll_y {
        lb.scroll_y = next
        lb.dirty = true
    }
    << 0
}
pub fn (lb $&ListBox) ensure_visible(index int) {
    if index < 0 || index >= lb.count_val { << }
    rh := lb.row_h
    viewport_h := math.max(0.0,lb.bounds.height - lb.padding.top - lb.padding.bottom)
    top := f64(index) * rh
    bottom := top + rh
    $next := lb.scroll_y
    if top < next { next = top }
    else if bottom > next + viewport_h { next = bottom - viewport_h }
    next = math.max(0.0,math.min(lb.max_scroll(),next))
    if next != lb.scroll_y {
        lb.scroll_y = next
        lb.dirty = true
    }
}
pub fn (lb $&ListBox) set_count(count int) int {
    if count < 0 || count > 4096 { >> errors.new("widgets: invalid list_box count") }
    if lb.count_val != count {
        lb.count_val = count
        if lb.selected_val >= count { lb.selected_val = count - 1 }
        lb.scroll_y = math.max(0.0,math.min(lb.max_scroll(),lb.scroll_y))
        lb.hovered_idx = -1
        lb.armed_idx = -1
        lb.dirty = true
    }
    << 0
}
pub fn (lb $&ListBox) set_selected(index int) int {
    if index < -1 || (lb.count_val > 0 && index >= lb.count_val) || (lb.count_val == 0 && index != -1) {
        >> errors.new("widgets: list_box index out of range")
    }
    if lb.selected_val != index {
        lb.selected_val = index
        if index >= 0 { lb.ensure_visible(index) }
        lb.dirty = true
    }
    << 0
}
pub fn (lb $&ListBox) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if lb.bounds.x != bounds.x || lb.bounds.y != bounds.y || lb.bounds.width != bounds.width || lb.bounds.height != bounds.height {
        lb.bounds = copy_rect(bounds)
        if bounds.width == 0.0 || bounds.height == 0.0 { lb.cancel() }
        lb.scroll_y = math.max(0.0,math.min(lb.max_scroll(),lb.scroll_y))
        lb.armed_idx = -1
        lb.hovered_idx = -1
        lb.hovered = false
        lb.dirty = true
    }
    << 0
}
pub fn (lb &ListBox) visual_state() int {
    $state := 0
    if lb.invalid { state = state | STATE_INVALID }
    if lb.read_only { state = state | STATE_READ_ONLY }
    if !lb.is_enabled() { state = state | STATE_DISABLED }
    if lb.hovered { state = state | STATE_HOVERED }
    if lb.focused { state = state | STATE_FOCUSED }
    << state
}
pub fn (lb &ListBox) item_visual_state(index int) int {
    $state := 0
    if lb.invalid { state = state | STATE_INVALID }
    if lb.read_only { state = state | STATE_READ_ONLY }
    if !lb.is_enabled() { state = state | STATE_DISABLED }
    if index == lb.selected_val { state = state | STATE_SELECTED }
    if index == lb.hovered_idx { state = state | STATE_HOVERED }
    if !lb.read_only && index == lb.armed_idx && index == lb.hovered_idx { state = state | STATE_PRESSED }
    << state
}
pub fn (lb &ListBox) has_style() bool { << lb.custom.active }
pub fn (lb &ListBox) style_or(styles &Styles) ControlStyle {
    if lb.custom.active { << unpack_scalar_style(&lb.custom) }
    << styles.list_box_style()
}
pub fn (lb $&ListBox) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    next := unpack_scalar_style(&pack_scalar_style(style))
    if !lb.custom.active || !control_equal(&unpack_scalar_style(&lb.custom),&next) { lb.dirty = true }
    lb.custom = pack_scalar_style(style)
    if style.indicator_size >= 12.0 { lb.row_h = style.indicator_size }
    << 0
}
pub fn (lb $&ListBox) clear_style() {
    if lb.custom.active {
        lb.custom.active = false
        lb.row_h = 28.0
        lb.padding = layout.Insets{left: 6.0,top: 6.0,right: 6.0,bottom: 6.0}
        lb.dirty = true
    }
}
// Apply resolved metrics before routing input, just as Scroll and Editor do.
// Painting, scrolling and pointer hit testing must share the same row geometry.
pub fn (lb $&ListBox) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := lb.style_or(styles)
    d := styles.density
    text := styles.text_options(&c)
    rh := lb.styled_row_height(styles)
    padding := layout.Insets{left: c.padding.left * d,top: c.padding.top * d,
        right: c.padding.right * d,bottom: c.padding.bottom * d}
    if lb.row_h != rh || lb.padding.left != padding.left || lb.padding.top != padding.top ||
        lb.padding.right != padding.right || lb.padding.bottom != padding.bottom {
        lb.row_h = rh
        lb.padding = padding
        lb.scroll_y = math.max(0.0,math.min(lb.max_scroll(),lb.scroll_y))
        lb.ensure_visible(lb.selected_val)
        lb.armed_idx = -1
        lb.hovered_idx = -1
        lb.dirty = true
    }
    << 0
}
fn (lb &ListBox) hit_row(x f64,y f64) int {
    viewport := layout.Rect{x: lb.bounds.x + lb.padding.left,y: lb.bounds.y + lb.padding.top,
        width: math.max(0.0,lb.bounds.width - lb.padding.left - lb.padding.right),
        height: math.max(0.0,lb.bounds.height - lb.padding.top - lb.padding.bottom)}
    if !viewport.contains(x,y) || lb.count_val <= 0 { << -1 }
    rh := lb.row_h
    rel_y := y - viewport.y + lb.scroll_y
    if rel_y < 0.0 { << -1 }
    idx := int(rel_y / rh)
    if idx < 0 || idx >= lb.count_val { << -1 }
    << idx
}
pub fn (lb $&ListBox) input(input &ui.InputEvent) Action {
    if !belongs(&lb.identity,input) || lb.closed { << no_action(lb.id,lb.dirty) }
    if input.kind == ui.EV_POINTER_CANCEL {
        lb.cancel()
        << no_action(lb.id,lb.dirty)
    }
    if !lb.is_enabled() { << no_action(lb.id,lb.dirty) }
    scroll := lb.scrollbar_input(input) or >>
    if scroll.consumed { << scroll }
    inside := lb.bounds.contains(input.x,input.y)
    row := lb.hit_row(input.x,input.y)
    $kind := ACTION_NONE
    $focus := false
    $consumed := false
    $out_val := f64(lb.selected_val)
    if input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_LEAVE {
        hot := inside && input.kind != ui.EV_POINTER_LEAVE
        $next_row := -1
        if hot { next_row = row }
        if hot != lb.hovered || next_row != lb.hovered_idx {
            lb.hovered = hot
            lb.hovered_idx = next_row
            lb.dirty = true
        }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && inside {
        lb.hovered = true
        lb.hovered_idx = row
        lb.dirty = true
        focus = true
        consumed = true
        if !lb.read_only && row >= 0 { lb.armed_idx = row }
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if lb.armed_idx >= 0 {
            consumed = true
            if !lb.read_only && inside && row == lb.armed_idx && row != lb.selected_val {
                lb.selected_val = row
                lb.ensure_visible(row)
                kind = ACTION_CHANGE
                out_val = f64(lb.selected_val)
            }
            lb.armed_idx = -1
            lb.dirty = true
        }
        $next_row := -1
        if inside { next_row = row }
        if lb.hovered != inside || lb.hovered_idx != next_row { lb.dirty = true }
        lb.hovered = inside
        lb.hovered_idx = next_row
    } else if input.kind == ui.EV_POINTER_SCROLL && inside {
        if !math.is_nan(input.dy) && !math.is_inf(input.dy) {
            next := math.max(0.0,math.min(lb.max_scroll(),lb.scroll_y + input.dy))
            if next != lb.scroll_y {
                lb.scroll_y = next
                lb.dirty = true
                consumed = true
                kind = ACTION_SCROLL
                out_val = lb.scroll_y
            }
        }
    } else if input.kind == ui.EV_KEY_DOWN && lb.focused && !lb.read_only && lb.count_val > 0 {
        $candidate := lb.selected_val
        if candidate < 0 { candidate = 0 }
        $handled := false
        if input.key == ui.KEY_UP {
            candidate = max_int(0,candidate - 1)
            handled = true
        } else if input.key == ui.KEY_DOWN {
            candidate = min_int(lb.count_val - 1,candidate + 1)
            handled = true
        } else if input.key == ui.KEY_PAGE_UP {
            candidate = max_int(0,candidate - 4)
            handled = true
        } else if input.key == ui.KEY_PAGE_DOWN {
            candidate = min_int(lb.count_val - 1,candidate + 4)
            handled = true
        } else if input.key == ui.KEY_HOME {
            candidate = 0
            handled = true
        } else if input.key == ui.KEY_END {
            candidate = lb.count_val - 1
            handled = true
        }
        if handled {
            consumed = true
            if candidate != lb.selected_val {
                lb.selected_val = candidate
                lb.ensure_visible(candidate)
                lb.dirty = true
                kind = ACTION_CHANGE
                out_val = f64(lb.selected_val)
            }
        }
    }
    << Action{kind: kind,id: lb.id,needs_paint: lb.dirty,request_focus: focus,consumed: consumed,value: out_val}
}
pub fn (lb $&ListBox) event(event &ui.Event) Action {
    if event.window_id != lb.identity.window_id { << no_action(lb.id,lb.dirty) }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_BLURRED {
        lb.cancel()
        if event.kind == ui.EV_CLOSED { lb.closed = true }
        << no_action(lb.id,lb.dirty)
    }
    if event.kind == ui.EV_CANVAS_CLOSED {
        identity := ui.canvas_of(event) or >>
        if identity.canvas_id == lb.identity.canvas_id && identity.generation == lb.identity.generation {
            lb.cancel()
            lb.closed = true
        }
        << no_action(lb.id,lb.dirty)
    }
    if !ui.is_input_event(event.kind) { << no_action(lb.id,lb.dirty) }
    input := ui.input_of(event) or >>
    << lb.input(&input)
}
pub fn (lb &ListBox) paint(frame $&draw.Frame,labels &[]draw.TextLayout,theme &Theme) int {
    b := lb.bounds
    rh := math.max(16.0,lb.row_h)
    frame.push() or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    frame.fill_rect(b.x,b.y,b.width,b.height,theme.normal) or >>
    for i in 0:lb.count_val {
        ry := b.y + 6.0 + f64(i) * rh - lb.scroll_y
        if ry + rh >= b.y && ry <= b.y + b.height {
            if i == lb.selected_val {
                frame.fill_rect(b.x + 4.0,ry,math.max(0.0,b.width - 8.0),rh,theme.accent) or >>
            } else if i == lb.hovered_idx {
                frame.fill_rect(b.x + 4.0,ry,math.max(0.0,b.width - 8.0),rh,theme.hovered) or >>
            }
            if i < labels.len {
                lbl := labels[i]
                frame.text_layout(&lbl,b.x + 10.0,ry + (rh - lbl.metrics.height) * 0.5,theme.foreground) or >>
            }
        }
    }
    if lb.focused { focus_ring(frame,&b,theme.focus) or >> }
    frame.pop() or >>
    << 0
}
pub fn (lb &ListBox) measure_styled(label $&StyledLabel,styles &Styles) layout.Size {
    c := lb.style_or(styles)
    d := styles.density
    rh := lb.styled_row_height(styles)
    sz := label.measure_styled(styles,&c) or >>
    max_w := math.max(80.0 * d,sz.width + 24.0 * d)
    vis_rows := min_int(3,max_int(2,lb.count_val))
    h := f64(vis_rows) * rh + (c.padding.top + c.padding.bottom) * d
    w := max_w + (c.padding.left + c.padding.right) * d
    << layout.Size{width: math.max(c.min_width * d,w),height: math.max(c.min_height * d,h)}
}
pub fn (lb &ListBox) paint_box_styled(frame $&draw.Frame,styles &Styles) int {
    c := lb.style_or(styles)
    b := lb.bounds
    d := styles.density
    $box_state := lb.visual_state()
    box_state = box_state & (0 - 1 - STATE_HOVERED)
    style_box(frame,&b,&c,d,box_state) or >>
    lb.paint_data_scrollbar(frame,&c) or >>
    << 0
}
pub fn (lb &ListBox) paint_item_styled(frame $&draw.Frame,index int,label $&StyledLabel,styles &Styles) int {
    if index < 0 || index >= lb.count_val { << 0 }
    c := lb.style_or(styles)
    _ := label.measure_styled(styles,&c) or >>
    b := lb.bounds
    d := styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    right := c.padding.right * d
    bottom := c.padding.bottom * d
    avail_w := math.max(0.0,b.width - left - right)
    avail_h := math.max(0.0,b.height - top - bottom)
    rh := lb.styled_row_height(styles)
    content_h := f64(lb.count_val) * rh
    bar_w := math.max(4.0 * d,c.mark_width * d)
    $row_w := avail_w
    if content_h > avail_h { row_w = math.max(0.0,avail_w - bar_w - 4.0 * d) }
    row_r := math.max(2.0,(c.radius - 2.0) * d)
    ry := b.y + top + f64(index) * rh - lb.scroll_y
    if ry + rh >= b.y + top && ry <= b.y + top + avail_h {
        frame.push() or >>
        frame.clip_rect(b.x + left,b.y + top,avail_w,avail_h) or >>
        row_rect := layout.Rect{x: b.x + left,y: ry,width: row_w,height: rh}
        rstate := lb.item_visual_state(index)
        resolved := c.resolve(rstate)
        if index == lb.selected_val || index == lb.hovered_idx || index == lb.armed_idx {
            rounded_fill(frame,&row_rect,row_r,resolved.background) or >>
        }
        if label.value.len > 0 {
            shaped := label.layouts[0]
            pad_x := 8.0 * d
            tx := row_rect.x + pad_x + math.max(0.0,(row_rect.width - pad_x * 2.0 - shaped.metrics.width) * c.align_x)
            ty := row_rect.y + (row_rect.height - shaped.metrics.height) * c.align_y
            frame.text_layout(&shaped,tx,ty,resolved.foreground) or >>
        }
        frame.pop() or >>
    }
    << 0
}
pub fn (lb &ListBox) paint_styled(frame $&draw.Frame,label $&StyledLabel,styles &Styles) int {
    lb.paint_box_styled(frame,styles) or >>
    for i in 0:lb.count_val {
        lb.paint_item_styled(frame,i,label,styles) or >>
    }
    << 0
}

pub fn (st $&Stepper) set_repeat(enabled bool,delay time.Duration,interval time.Duration) int {
    if delay.nanoseconds() < 100 * time.millisecond() || delay.nanoseconds() > 5 * time.second() || interval.nanoseconds() < 20 * time.millisecond() || interval.nanoseconds() > time.second() { >> errors.new("widgets: invalid repeat timing") }
    st.repeat_enabled = enabled
    st.repeat_delay = delay
    st.repeat_interval = interval
    st.next_repeat = time.zero_instant()
    << 0
}
pub fn (st $&Stepper) apply_styles(styles &Styles) int {
    styles.validate() or >>
    c := st.style_or(styles)
    st.button_extent = c.indicator_size * styles.density
    << 0
}
pub fn (st &Stepper) next_tick(now time.Instant) time.Instant {
    if !st.repeat_enabled || !st.is_enabled() || st.read_only || st.armed_part == 0 || st.armed_part != st.hovered_part { << time.zero_instant() }
    if (st.armed_part == 1 && !st.can_decrement()) || (st.armed_part == 2 && !st.can_increment()) { << time.zero_instant() }
    if st.next_repeat.is_zero() { << now.add(st.repeat_delay) or >> }
    << st.next_repeat
}
pub fn (st $&Stepper) tick(now time.Instant) Action {
    deadline := st.next_tick(now) or >>
    if deadline.is_zero() { << no_action(st.id(),false) }
    if st.next_repeat.is_zero() { st.next_repeat = deadline }
    if now.before(deadline) { << no_action(st.id(),false) }
    $delta := st.step_val
    if st.armed_part == 1 { delta = 0.0 - delta }
    old := st.val
    st.set_value(st.val + delta) or >>
    st.repeated += 1
    $interval := st.repeat_interval
    if st.repeated >= 10 { interval = time.duration(max_int(20 * time.millisecond(),interval.nanoseconds() / 2)) }
    st.next_repeat = now.add(interval) or >>
    $kind := ACTION_NONE
    if st.val != old { kind = ACTION_CHANGE }
    << Action{kind: kind,id: st.id(),needs_paint: st.val != old,request_focus: false,consumed: false,value: st.val}
}
