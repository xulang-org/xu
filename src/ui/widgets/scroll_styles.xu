@ui/widgets

#ui
#ui/draw
#ui/layout
#math

pub fn (scroll &Scroll) id() int { << scroll.id }
pub fn (scroll &Scroll) bounds() layout.Rect { << copy_rect(&scroll.bounds) }
pub fn (scroll &Scroll) is_focused() bool { << scroll.focused }
pub fn (scroll &Scroll) is_hovered() bool { << scroll.bar_hovered }
pub fn (scroll &Scroll) is_dragging() bool { << scroll.dragging_bar }
pub fn (scroll &Scroll) is_invalid() bool { << scroll.invalid }
pub fn (scroll &mut Scroll) set_invalid(invalid bool) {
    if scroll.invalid != invalid {
        scroll.invalid = invalid
        scroll.dirty = true
    }
}
pub fn (scroll &Scroll) visual_state() int {
    mut state := 0
    if !scroll.is_enabled() { state = state | state_disabled }
    if scroll.invalid { state = state | state_invalid }
    if scroll.bar_hovered { state = state | state_hovered }
    if scroll.dragging_bar { state = state | state_pressed }
    if scroll.focused { state = state | state_focused }
    << state
}
pub fn (scroll &Scroll) has_style() bool { << scroll.custom_style.len > 0 }
pub fn (scroll &Scroll) style_or(styles &Styles) ControlStyle {
    if scroll.custom_style.len > 0 { << decode_control_style(&scroll.custom_style,&styles.scroll) }
    << styles.scroll.clone()
}
pub fn (scroll &mut Scroll) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    encoded := encode_control_style(style)
    if !scroll.styled || scroll.custom_style != encoded { scroll.dirty = true }
    scroll.custom_style = encoded
    scroll.appearance = style.clone()
    scroll.styled = true
    << 0
}
pub fn (scroll &mut Scroll) clear_style() {
    if scroll.custom_style.len > 0 {
        scroll.custom_style = ""
        scroll.dirty = true
    }
}
pub fn (scroll &mut Scroll) apply_styles(styles &Styles) int {
    styles.validate() or >>
    next := scroll.style_or(styles)
    if !scroll.styled || scroll.density != styles.density || !control_equal(&scroll.appearance,&next) { scroll.dirty = true }
    scroll.appearance = next
    scroll.density = styles.density
    scroll.styled = true
    << 0
}
pub fn (scroll &mut Scroll) measure_styled(styles &Styles) layout.Size {
    scroll.apply_styles(styles) or >>
    c := scroll.appearance.clone()
    d := styles.density
    << layout.Size{width: math.max(c.min_width * d,(c.padding.left + c.padding.right + c.indicator_size) * d),
        height: math.max(c.min_height * d,(c.padding.top + c.padding.bottom + c.indicator_size) * d)}
}
pub fn (scroll &Scroll) scrollbar_track() layout.Rect {
    b := scroll.bounds
    c := scroll.appearance.clone()
    d := scroll.density
    thickness := c.indicator_size * d
    left := c.padding.left * d
    top := c.padding.top * d
    right := c.padding.right * d
    bottom := c.padding.bottom * d
    if scroll.content <= scroll.viewport() || thickness <= 0.0 { << layout.Rect{x: b.x,y: b.y,width: 0.0,height: 0.0} }
    if scroll.axis == axis_horizontal {
        << layout.Rect{x: b.x + left,y: b.y + b.height - bottom - math.min(thickness,math.max(0.0,b.height - top - bottom)),
            width: math.max(0.0,b.width - left - right),height: math.min(thickness,math.max(0.0,b.height - top - bottom))}
    }
    << layout.Rect{x: b.x + b.width - right - math.min(thickness,math.max(0.0,b.width - left - right)),y: b.y + top,
        width: math.min(thickness,math.max(0.0,b.width - left - right)),height: math.max(0.0,b.height - top - bottom)}
}
pub fn (scroll &Scroll) scrollbar_thumb() layout.Rect {
    mut track := scroll.scrollbar_track()
    if track.width <= 0.0 || track.height <= 0.0 { << track }
    mut length := track.height
    if scroll.axis == axis_horizontal { length = track.width }
    thumb := math.min(length,math.max(scroll.appearance.min_height * scroll.density,length * scroll.viewport() / scroll.content))
    position := (length - thumb) * scroll.offset / math.max(1.0,scroll.content - scroll.viewport())
    if scroll.axis == axis_horizontal { track.x = track.x + position
        track.width = thumb }
    else { track.y = track.y + position
        track.height = thumb }
    << track
}
fn (scroll &mut Scroll) bar_input(input &ui.InputEvent) Action {
    track := scroll.scrollbar_track()
    thumb := scroll.scrollbar_thumb()
    mut position := input.y
    mut start := thumb.y
    mut travel := track.height - thumb.height
    if scroll.axis == axis_horizontal { position = input.x
        start = thumb.x
        travel = track.width - thumb.width }
    hot := input.kind != ui.ev_pointer_leave && thumb.contains(input.x,input.y)
    if input.kind == ui.ev_pointer_move || input.kind == ui.ev_pointer_leave || input.kind == ui.ev_pointer_enter {
        if scroll.bar_hovered != hot { scroll.bar_hovered = hot
            scroll.dirty = true }
    }
    mut consumed := false
    old := scroll.offset
    if input.kind == ui.ev_pointer_down && input.button == ui.button_left && track.contains(input.x,input.y) {
        consumed = true
        if thumb.contains(input.x,input.y) { scroll.dragging_bar = true
            scroll.drag_position = position
            scroll.drag_offset = scroll.offset
            scroll.dirty = true }
        else { mut direction := 1.0
            if position < start { direction = -1.0 }
            scroll.set_offset(scroll.offset + direction * scroll.viewport()) or >> }
    }
    if scroll.dragging_bar && input.kind == ui.ev_pointer_move {
        if travel > 0.0 { scroll.set_offset(scroll.drag_offset + (position - scroll.drag_position) * (scroll.content - scroll.viewport()) / travel) or >> }
        consumed = true
    }
    if scroll.dragging_bar && input.kind == ui.ev_pointer_up && input.button == ui.button_left { scroll.dragging_bar = false
        scroll.dirty = true
        consumed = true }
    mut kind := action_none
    if old != scroll.offset { kind = action_scroll }
    << Action{kind: kind,id: scroll.id,needs_paint: scroll.dirty,request_focus: consumed,consumed: consumed,value: scroll.offset}
}
// Call after content/end(), or from StyledPainter.overlay_styled. The thumb
// shares the exact geometry used for hit testing and captured pointer dragging.
pub fn (scroll &mut Scroll) paint_scrollbar(frame &mut draw.Frame,styles &Styles) int {
    scroll.apply_styles(styles) or >>
    mut c := scroll.appearance.clone()
    track := scroll.scrollbar_track()
    thumb := scroll.scrollbar_thumb()
    mut state := 0
    if !scroll.is_enabled() { state = state | state_disabled }
    if scroll.invalid { state = state | state_invalid }
    rounded_fill(frame,&track,c.radius * styles.density,c.resolve(state).background) or >>
    c.palette.foreground = c.palette.border
    if scroll.invalid { c.palette.foreground = c.palette.invalid }
    if scroll.bar_hovered { state = state | state_hovered
        c.palette.foreground = c.palette.focus }
    if scroll.dragging_bar { state = state | state_pressed
        c.palette.foreground = c.palette.accent }
    if scroll.focused { state = state | state_focused }
    resolved := c.resolve(state)
    rounded_fill(frame,&thumb,c.radius * styles.density,resolved.foreground) or >>
    if scroll.focused { rounded_stroke(frame,&thumb,c.radius * styles.density,resolved.focus,c.focus_width * styles.density) or >> }
    << 0
}
