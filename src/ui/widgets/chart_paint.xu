@ui/widgets

#ui/draw
#ui/layout
#math
#strconv
#errors

fn (c &Chart) number(value f64) string {
    raw := strconv.format_float(value,102,c.appearance.precision) or >>
    << c.locale.number(raw,false)
}
fn (c &Chart) series_color(index int,styles &Styles) draw.Color {
    if index >= 0 && index < c.series.len && c.series[index].custom_color { << c.series[index].color }
    if c.appearance.palette.len > 0 { << c.appearance.palette[max_int(0,index) % c.appearance.palette.len] }
    light := ((styles.background.value() >> 24) & 255) > 150
    if light {
        colors := [draw.rgb(177,54,42),draw.rgb(27,107,170),draw.rgb(29,123,94),draw.rgb(144,100,13),draw.rgb(129,74,152),draw.rgb(27,119,129),draw.rgb(173,75,105),draw.rgb(92,107,128)]
        << colors[max_int(0,index) % colors.len]
    }
    colors := [draw.rgb(239,139,121),draw.rgb(112,184,242),draw.rgb(102,205,162),draw.rgb(236,191,89),draw.rgb(195,150,226),draw.rgb(111,205,212),draw.rgb(239,148,182),draw.rgb(172,187,210)]
    << colors[max_int(0,index) % colors.len]
}
pub fn (c $&Chart) apply_styles(styles &Styles) int {
    styles.validate() or >>
    b := c.bounds()
    d := styles.density
    scale := styles.text_scale
    $text := c.style_or(styles)
    text.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    if text.inherit_font { text.font = copy_font(&styles.font) }
    text.font.size = text.font.size * 0.8
    text.inherit_font = false
    $left := 16.0 * d
    $bottom := 16.0 * d
    if !c.polar_or_radial() {
        domain := c.visible_domain()
        horiz := c.horizontal()
        for i in 0:2 {
            $value := domain.y_min
            if horiz {
                value = domain.x_min
                if i == 1 { value = domain.x_max }
            } else if i == 1 { value = domain.y_max }
            label := c.number(value) or >>
            cache := $&c.labels
            size := cache.measure(i,&label,styles,&text) or >>
            left = math.max(left,size.width + 24.0 * d)
        }
        bottom = (22.0 + 16.0 * scale) * d
    }
    $top := 20.0 * d
    c.legend_boxes = []layout.Rect{}
    if c.appearance.legend && c.series.len > 0 {
        columns := max_int(1,min_int(c.series.len,int(math.max(1.0,(b.width - 32.0 * d) / (136.0 * d * scale)))))
        row_h := (20.0 * scale + 12.0) * d
        cell_w := math.max(1.0,(b.width - 32.0 * d) / f64(columns))
        for i in 0:c.series.len { c.legend_boxes.push(layout.Rect{x: b.x + 16.0 * d + f64(i % columns) * cell_w,
            y: b.y + 12.0 * d + f64(i / columns) * row_h,width: cell_w,height: row_h}) }
        top = top + f64((c.series.len + columns - 1) / columns) * row_h
    }
    right := 24.0 * d
    c.plot = layout.Rect{x: b.x + math.min(left,b.width * 0.4),y: b.y + math.min(top,b.height * 0.55),
        width: math.max(0.0,b.width - math.min(left,b.width * 0.4) - right),height: math.max(0.0,b.height - math.min(top,b.height * 0.55) - bottom)}
    << 0
}
fn (c $&Chart) label(key int,value &string,frame $&draw.Frame,b &layout.Rect,styles &Styles,color draw.Color,align f64) int {
    $text := c.style_or(styles)
    text.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    if text.inherit_font { text.font = copy_font(&styles.font) }
    text.font.size = text.font.size * 0.8
    text.inherit_font = false
    text.align_x = align
    text.align_y = 0.5
    text.palette.foreground = color
    cache := $&c.labels
    << cache.paint_text(key,value,frame,b,styles,&text,0) or >>
}
fn (c $&Chart) paint_axes(frame $&draw.Frame,styles &Styles,style &ControlStyle) int {
    d := c.visible_domain()
    b := c.plot_bounds()
    outer := c.bounds()
    ticks := c.appearance.ticks
    horiz := c.horizontal()
    for i in 0:ticks + 1 {
        fraction := f64(i) / f64(ticks)
        y := b.y + b.height * fraction
        if c.appearance.grid && !horiz { frame.line(b.x,y,b.x + b.width,y,fade_color(style.palette.border,0.55),1.0) or >> }
        $raw := d.y_max - (d.y_max - d.y_min) * fraction
        if horiz { raw = d.x_min + (d.x_max - d.x_min) * fraction }
        value := c.number(raw) or >>
        label_bounds := layout.Rect{x: outer.x + 8.0,y: y - 14.0 * styles.text_scale,width: math.max(0.0,b.x - outer.x - 18.0),height: 28.0 * styles.text_scale}
        c.label(10 + i,&value,frame,&label_bounds,styles,style.palette.muted,1.0) or >>
    }
    count := max_int(2,min_int(ticks,int(b.width / (80.0 * styles.text_scale * styles.density))))
    for i in 0:count + 1 {
        fraction := f64(i) / f64(count)
        x := b.x + b.width * fraction
        if c.appearance.grid && horiz { frame.line(x,b.y,x,b.y + b.height,fade_color(style.palette.border,0.55),1.0) or >> }
        $raw := d.x_min + (d.x_max - d.x_min) * fraction
        if horiz { raw = d.y_min + (d.y_max - d.y_min) * fraction }
        value := c.number(raw) or >>
        width := math.min(160.0 * styles.text_scale,b.width / f64(count))
        $left := x - width * 0.5
        left = math.max(outer.x + 4.0,math.min(outer.x + outer.width - width - 4.0,left))
        label_bounds := layout.Rect{x: left,y: b.y + b.height + 8.0 * styles.density,width: width,height: 24.0 * styles.text_scale * styles.density}
        c.label(24 + i,&value,frame,&label_bounds,styles,style.palette.muted,0.5) or >>
    }
    if horiz { frame.line(b.x,b.y,b.x,b.y + b.height,style.palette.border,1.0) or >> }
    frame.line(b.x,b.y + b.height,b.x + b.width,b.y + b.height,style.palette.border,1.0) or >>
    << 0
}
fn (c $&Chart) paint_legend(frame $&draw.Frame,styles &Styles,style &ControlStyle) int {
    for i in 0:c.legend_boxes.len {
        b := c.legend_boxes[i]
        $opacity := 1.0
        if !c.series_is_visible(i) { opacity = 0.4 }
        color := fade_color(c.series_color(i,styles),opacity)
        frame.set_fill(color) or >>
        frame.circle(b.x + 6.0 * styles.density,b.y + b.height * 0.5,4.0 * styles.density) or >>
        label_bounds := layout.Rect{x: b.x + 18.0 * styles.density,y: b.y,width: math.max(0.0,b.width - 24.0 * styles.density),height: b.height}
        name := c.series[i].name + ""
        c.label(40 + i,&name,frame,&label_bounds,styles,fade_color(style.palette.foreground,opacity),0.0) or >>
    }
    << 0
}
fn (c $&Chart) paint_cartesian(frame $&draw.Frame,styles &Styles,style &ControlStyle) int {
    if c.heatmap() { << c.paint_heatmap(frame,styles,style) or >> }
    if c.series.len == 1 && c.series[0].kind == CHART_WATERFALL { << c.paint_waterfall(frame,styles,style) or >> }
    if c.series.len == 1 && c.series[0].kind == CHART_PARETO { << c.paint_pareto(frame,styles,style) or >> }
    for si in 0:c.series.len {
        if !c.series_is_visible(si) { -> }
        series_id := c.series[si].id
        kind := c.series[si].kind
        use_spline := kind == CHART_SMOOTH_LINE || kind == CHART_SMOOTH_AREA
        smooth := c.series[si].smooth || use_spline
        line_width := c.series[si].line_width
        symbol_size := c.series[si].symbol_size
        points_len := c.series[si].points.len
        color := c.series_color(si,styles)
        $path := draw.new_path(32768) or >>
        $spline_pts := []draw.PathPoint{}
        $base_xs := []f64{}
        $base_ys := []f64{}
        $count := 0
        $previous := ChartCoordinate{x: 0.0,y: 0.0}
        $first := ChartCoordinate{x: 0.0,y: 0.0}
        $exit_previous := ChartCoordinate{x: 0.0,y: 0.0}
        $has_exit_previous := false
        for i in 0:c.data.len {
            if c.data[i].series != series_id || c.data[i].opacity <= 0.001 { -> }
            p_opacity := c.data[i].opacity
            p_target_opacity := c.data[i].target_opacity
            raw := c.datum_position(i)
            position := ChartCoordinate{x: math.max(0.0 - 100000000.0,math.min(100000000.0,raw.x)),y: math.max(0.0 - 100000000.0,math.min(100000000.0,raw.y))}
            if kind == CHART_BAR || kind == CHART_STACKED_BAR || kind == CHART_HORIZONTAL_BAR {
                b := c.bar_bounds(i)
                radius := math.min(3.0,math.min(b.width,b.height) * 0.2)
                rounded_fill(frame,&b,radius,fade_color(color,p_opacity)) or >>
            } else if kind == CHART_HISTOGRAM {
                b := c.bar_bounds(i)
                frame.fill_rect(b.x,b.y,b.width,b.height,fade_color(color,p_opacity * 0.68)) or >>
                frame.stroke_rect(b.x,b.y,b.width,b.height,fade_color(color,p_opacity),math.max(1.0,styles.density)) or >>
            } else if kind == CHART_BOXPLOT {
                c.paint_boxplot_datum(frame,i,color,styles) or >>
            } else if kind == CHART_VIOLIN {
                c.paint_violin_datum(frame,i,color,styles,style) or >>
            } else if kind == CHART_BULLET {
                c.paint_bullet_datum(frame,i,color,styles,style) or >>
            } else if kind == CHART_LOLLIPOP {
                c.paint_lollipop_datum(frame,i,color,styles,style) or >>
            } else if kind == CHART_DUMBBELL {
                c.paint_dumbbell_datum(frame,i,color,styles,style) or >>
            } else if kind == CHART_CANDLESTICK {
                c.paint_candlestick_datum(frame,i,styles) or >>
            } else if kind == CHART_BUBBLE {
                if c.plot.contains(position.x,position.y) {
                    r := c.bubble_radius(i,styles.density)
                    frame.set_fill(fade_color(color,p_opacity * 0.36)) or >>
                    frame.circle(position.x,position.y,r) or >>
                    c.stroke_circle(frame,position.x,position.y,r,fade_color(color,p_opacity * 0.92),1.5 * styles.density) or >>
                }
            } else if kind == CHART_SCATTER || (p_target_opacity == 0.0 && !datum_uses_bar_bounds(kind)) {
                if kind != CHART_SCATTER && count > 0 {
                    $start := previous
                    if has_exit_previous { start = exit_previous }
                    if position.x > start.x {
                        zero := c.data_position(0.0,0.0)
                        baseline := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,zero.y))
                        is_area := kind == CHART_AREA || kind == CHART_SMOOTH_AREA || kind == CHART_STACKED_AREA
                        chart_exit_segment(frame,&start,&position,baseline,smooth,kind == CHART_STEP_LINE,is_area,line_width * styles.density,fade_color(color,p_opacity),fade_color(color,p_opacity * c.appearance.area_opacity)) or >>
                        exit_previous = position
                        has_exit_previous = true
                    }
                }
                if c.plot.contains(position.x,position.y) { frame.set_fill(fade_color(color,p_opacity * 0.8)) or >>
                    frame.circle(position.x,position.y,math.max(1.0,symbol_size) * styles.density) or >> }
            } else {
                if use_spline {
                    if count == 0 { first = position }
                    spline_pts.push(draw.path_point(position.x,position.y))
                } else if count == 0 { path.move_to(position.x,position.y) or >>
                    first = position }
                else if kind == CHART_STEP_LINE {
                    path.line_to(position.x,previous.y) or >>
                    path.line_to(position.x,position.y) or >>
                } else if smooth { mid := (previous.x + position.x) * 0.5
                    path.cubic_to(mid,previous.y,mid,position.y,position.x,position.y) or >> }
                else { path.line_to(position.x,position.y) or >> }
                if kind == CHART_STACKED_AREA {
                    stack := c.stacked_y(i)
                    base_pos := c.data_position(c.data[i].x,stack.x)
                    base_xs.push(position.x)
                    base_ys.push(math.max(c.plot.y,math.min(c.plot.y + c.plot.height,base_pos.y)))
                }
                count = count + 1
                previous = position
                if points_len <= 128 && symbol_size > 0.0 && c.plot.contains(position.x,position.y) { frame.set_fill(fade_color(color,p_opacity)) or >>
                    frame.circle(position.x,position.y,symbol_size * styles.density) or >> }
            }
        }
        if count > 0 {
            if use_spline { path.smooth_spline(&spline_pts,0.5,false) or >> }
            stroke := draw.stroke_options(line_width * styles.density)
            frame.stroke_path(&path,color,&stroke) or >>
            if kind == CHART_AREA || kind == CHART_SMOOTH_AREA {
                zero := c.data_position(0.0,0.0)
                baseline := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,zero.y))
                path.line_to(previous.x,baseline) or >>
                path.line_to(first.x,baseline) or >>
                path.close() or >>
                frame.fill_path(&path,fade_color(color,c.appearance.area_opacity),draw.FILL_NONZERO) or >>
            } else if kind == CHART_STACKED_AREA && base_xs.len > 0 {
                for bi in 0:base_xs.len {
                    rev := base_xs.len - 1 - bi
                    path.line_to(base_xs[rev],base_ys[rev]) or >>
                }
                path.close() or >>
                frame.fill_path(&path,fade_color(color,math.min(0.65,c.appearance.area_opacity * 1.6)),draw.FILL_NONZERO) or >>
            }
        }
    }
    << 0
}
fn chart_exit_segment(frame $&draw.Frame,start &ChartCoordinate,end &ChartCoordinate,baseline f64,
    smooth bool,step bool,area bool,width f64,color draw.Color,fill draw.Color) int {
    $path := draw.new_path(256)
    path.move_to(start.x,start.y) or >>
    if step {
        path.line_to(end.x,start.y) or >>
        path.line_to(end.x,end.y) or >>
    } else if smooth { mid := (start.x + end.x) * 0.5
        path.cubic_to(mid,start.y,mid,end.y,end.x,end.y) or >> }
    else { path.line_to(end.x,end.y) or >> }
    stroke := draw.stroke_options(width)
    frame.stroke_path(&path,color,&stroke) or >>
    if area { path.line_to(end.x,baseline) or >>
        path.line_to(start.x,baseline) or >>
        path.close() or >>
        frame.fill_path(&path,fill,draw.FILL_NONZERO) or >> }
    << 0
}
fn (c &Chart) paint_highlight(frame $&draw.Frame,styles &Styles,style &ControlStyle) int {
    $index := c.hot
    if index < 0 { index = c.selected }
    if index < 0 || !c.datum_visible(index) || c.slice_chart() || c.gauge() || c.funnel() ||
       c.polar_bar() || c.treemap() || c.sankey() { << 0 }
    series_id := c.data[index].series
    position := c.datum_position(index)
    if !c.plot.contains(position.x,position.y) { << 0 }
    si := c.series_index(series_id)
    color := c.series_color(si,styles)
    if c.heatmap() {
        cell := c.heatmap_cell_bounds(index)
        frame.stroke_rect(cell.x,cell.y,cell.width,cell.height,style.palette.foreground,2.0 * styles.density) or >>
        << 0
    }
    if c.appearance.crosshair && !c.radar() {
        frame.line(position.x,c.plot.y,position.x,c.plot.y + c.plot.height,fade_color(style.palette.muted,0.5),1.0) or >>
        frame.line(c.plot.x,position.y,c.plot.x + c.plot.width,position.y,fade_color(style.palette.muted,0.25),1.0) or >>
    }
    frame.set_fill(fade_color(color,0.12 + c.emphasis.value() * 0.08)) or >>
    frame.circle(position.x,position.y,(6.0 + 4.0 * c.emphasis.value()) * styles.density) or >>
    frame.set_fill(style.palette.normal) or >>
    frame.circle(position.x,position.y,5.0 * styles.density) or >>
    frame.set_fill(color) or >>
    frame.circle(position.x,position.y,3.0 * styles.density) or >>
    << 0
}
fn (c $&Chart) paint_tooltip(frame $&draw.Frame,styles &Styles,style &ControlStyle) int {
    $index := c.hot
    if index < 0 { index = c.selected }
    if !c.appearance.tooltip || index < 0 || !c.datum_visible(index) { << 0 }
    series_id := c.data[index].series
    point_label := c.data[index].label + ""
    si := c.series_index(series_id)
    $title := c.series[si].name + ""
    if point_label.len > 0 { title = point_label }
    value := c.tooltip_value(index) or >>
    b := c.bounds()
    position := c.datum_position(index)
    $x := position.x + 14.0
    $y := position.y - 72.0 * styles.text_scale
    $text := style.clone()
    if text.inherit_font { text.font = copy_font(&styles.font) }
    text.font.size = text.font.size * 0.8
    text.inherit_font = false
    donut := c.donut()
    plot := c.plot
    cache := $&c.labels
    title_size := cache.measure(80,&title,styles,&text) or >>
    value_size := cache.measure(81,&value,styles,&text) or >>
    width := math.min(math.max(title_size.width,value_size.width) + 28.0,b.width - 16.0)
    height := title_size.height + value_size.height + 26.0
    if donut {
        x = plot.x + (plot.width - width) * 0.5
        y = plot.y + (plot.height - height) * 0.5
    }
    x = math.max(b.x + 8.0,math.min(b.x + b.width - width - 8.0,x))
    y = math.max(b.y + 8.0,math.min(b.y + b.height - height - 8.0,y))
    panel := layout.Rect{x: x,y: y,width: math.max(0.0,width),height: height}
    $panel_style := style.clone()
    panel_style.radius = 7.0
    panel_style.shadow_blur = 10.0
    style_box(frame,&panel,&panel_style,styles.density,0) or >>
    title_bounds := layout.Rect{x: x + 14.0,y: y + 8.0,width: math.max(0.0,width - 28.0),height: title_size.height}
    value_bounds := layout.Rect{x: x + 14.0,y: y + title_size.height + 14.0,width: math.max(0.0,width - 28.0),height: value_size.height}
    c.label(80,&title,frame,&title_bounds,styles,style.palette.foreground,0.0) or >>
    c.label(81,&value,frame,&value_bounds,styles,style.palette.muted,0.0) or >>
    << 0
}
fn (c $&Chart) paint_content(frame $&draw.Frame,styles &Styles) int {
    c.apply_styles(styles) or >>
    style := c.style_or(styles)
    b := c.bounds()
    style_box(frame,&b,&style,styles.density,c.control.visual_state() & (STATE_FOCUSED | STATE_DISABLED | STATE_READ_ONLY)) or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    c.paint_legend(frame,styles,&style) or >>
    $count := 0
    for i in 0:c.data.len { if c.datum_visible(i) { count = count + 1 } }
    $targets := 0
    positive_only := c.slice_chart() || c.funnel() || c.polar_bar() || c.treemap() || c.sankey()
    for s in c.series { if c.series_visible(s.id) or >> { for p in s.points {
        if !positive_only || p.y > 0.0 { targets = targets + 1 } } } }
    if targets == 0 && (count == 0 || (positive_only && c.donut_total() <= 0.0)) {
        $empty := c.appearance.empty_text + ""
        if empty.len == 0 { empty = c.locale.text(TEXT_NO_RECORDS) or >> }
        plot := c.plot_bounds()
        c.label(90,&empty,frame,&plot,styles,style.palette.muted,0.5) or >>
        << 0
    }
    if !c.polar_or_radial() { c.paint_axes(frame,styles,&style) or >> }
    frame.push() or >>
    frame.clip_rect(c.plot.x,c.plot.y,c.plot.width,c.plot.height) or >>
    if c.slice_chart() { c.paint_donut(frame,styles,&style) or >> }
    else if c.radar() { c.paint_radar(frame,styles,&style) or >>
        c.paint_highlight(frame,styles,&style) or >> }
    else if c.gauge() { c.paint_gauge(frame,styles,&style) or >> }
    else if c.polar_bar() { c.paint_polar_bar(frame,styles,&style) or >> }
    else if c.funnel() { c.paint_funnel(frame,styles,&style) or >> }
    else if c.treemap() { c.paint_treemap(frame,styles,&style) or >> }
    else if c.sankey() { c.paint_sankey(frame,styles,&style) or >> }
    else { c.paint_cartesian(frame,styles,&style) or >>
        c.paint_highlight(frame,styles,&style) or >> }
    frame.pop() or >>
    tooltip := style.with_opacity(c.emphasis.value()) or >>
    c.paint_tooltip(frame,styles,&tooltip) or >>
    << 0
}
pub fn (c $&Chart) paint_styled(frame $&draw.Frame,styles &Styles) int {
    if c.control.closed { >> errors.new("widgets: chart is disposed") }
    frame.push() or >>
    c.paint_content(frame,styles) or (err) { screen_controls_pop(frame)
        >> err }
    frame.pop() or >>
    << 0
}
