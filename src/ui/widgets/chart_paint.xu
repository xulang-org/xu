@ui/widgets

#ui/draw
#ui/layout
#math
#strconv
#errors

fn (c &Chart) number(value f64) string {
    raw := strconv.format_float(value,102,c.appearance.precision) or >>
    << c.locale.number(raw,false)
}
fn (c &Chart) series_color(index int,styles &Styles) draw.Color {
    if index >= 0 && index < c.series.len && c.series[index].custom_color { << c.series[index].color }
    if c.appearance.palette.len > 0 { << c.appearance.palette[max_int(0,index) % c.appearance.palette.len] }
    light := ((styles.background.value() >> 24) & 255) > 150
    if light {
        colors := [draw.rgb(177,54,42),draw.rgb(27,107,170),draw.rgb(29,123,94),draw.rgb(144,100,13),draw.rgb(129,74,152),draw.rgb(27,119,129),draw.rgb(173,75,105),draw.rgb(92,107,128)]
        << colors[max_int(0,index) % colors.len]
    }
    colors := [draw.rgb(239,139,121),draw.rgb(112,184,242),draw.rgb(102,205,162),draw.rgb(236,191,89),draw.rgb(195,150,226),draw.rgb(111,205,212),draw.rgb(239,148,182),draw.rgb(172,187,210)]
    << colors[max_int(0,index) % colors.len]
}
pub fn (c &mut Chart) apply_styles(styles &Styles) int {
    styles.validate() or >>
    b := c.bounds()
    d := styles.density
    scale := styles.text_scale
    mut text := c.style_or(styles)
    text.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    if text.inherit_font { text.font = copy_font(&styles.font) }
    text.font.size = text.font.size * 0.8
    text.inherit_font = false
    mut left := 16.0 * d
    mut bottom := 16.0 * d
    if !c.donut() {
        domain := c.visible_domain()
        for i in 0:2 { mut value := domain.y_min
            if i == 1 { value = domain.y_max }
            label := c.number(value) or >>
            cache := mut &c.labels
            size := cache.measure(i,&label,styles,&text) or >>
            left = math.max(left,size.width + 24.0 * d) }
        bottom = (22.0 + 16.0 * scale) * d
    }
    mut top := 20.0 * d
    c.legend_boxes = []layout.Rect{}
    if c.appearance.legend && c.series.len > 0 {
        columns := max_int(1,min_int(c.series.len,int(math.max(1.0,(b.width - 32.0 * d) / (136.0 * d * scale)))))
        row_h := (20.0 * scale + 12.0) * d
        cell_w := math.max(1.0,(b.width - 32.0 * d) / f64(columns))
        for i in 0:c.series.len { c.legend_boxes.push(layout.Rect{x: b.x + 16.0 * d + f64(i % columns) * cell_w,
            y: b.y + 12.0 * d + f64(i / columns) * row_h,width: cell_w,height: row_h}) }
        top = top + f64((c.series.len + columns - 1) / columns) * row_h
    }
    right := 24.0 * d
    c.plot = layout.Rect{x: b.x + math.min(left,b.width * 0.4),y: b.y + math.min(top,b.height * 0.55),
        width: math.max(0.0,b.width - math.min(left,b.width * 0.4) - right),height: math.max(0.0,b.height - math.min(top,b.height * 0.55) - bottom)}
    << 0
}
fn (c &mut Chart) label(key int,value &string,frame &mut draw.Frame,b &layout.Rect,styles &Styles,color draw.Color,align f64) int {
    mut text := c.style_or(styles)
    text.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    if text.inherit_font { text.font = copy_font(&styles.font) }
    text.font.size = text.font.size * 0.8
    text.inherit_font = false
    text.align_x = align
    text.align_y = 0.5
    text.palette.foreground = color
    cache := mut &c.labels
    << cache.paint_text(key,value,frame,b,styles,&text,0) or >>
}
fn (c &mut Chart) paint_axes(frame &mut draw.Frame,styles &Styles,style &ControlStyle) int {
    d := c.visible_domain()
    b := c.plot_bounds()
    outer := c.bounds()
    ticks := c.appearance.ticks
    for i in 0:ticks + 1 {
        fraction := f64(i) / f64(ticks)
        y := b.y + b.height * fraction
        if c.appearance.grid { frame.line(b.x,y,b.x + b.width,y,fade_color(style.palette.border,0.55),1.0) or >> }
        value := c.number(d.y_max - (d.y_max - d.y_min) * fraction) or >>
        label_bounds := layout.Rect{x: outer.x + 8.0,y: y - 14.0 * styles.text_scale,width: math.max(0.0,b.x - outer.x - 18.0),height: 28.0 * styles.text_scale}
        c.label(10 + i,&value,frame,&label_bounds,styles,style.palette.muted,1.0) or >>
    }
    count := max_int(2,min_int(ticks,int(b.width / (80.0 * styles.text_scale * styles.density))))
    for i in 0:count + 1 {
        fraction := f64(i) / f64(count)
        x := b.x + b.width * fraction
        value := c.number(d.x_min + (d.x_max - d.x_min) * fraction) or >>
        width := math.min(160.0 * styles.text_scale,b.width / f64(count))
        mut left := x - width * 0.5
        left = math.max(outer.x + 4.0,math.min(outer.x + outer.width - width - 4.0,left))
        label_bounds := layout.Rect{x: left,y: b.y + b.height + 8.0 * styles.density,width: width,height: 24.0 * styles.text_scale * styles.density}
        c.label(24 + i,&value,frame,&label_bounds,styles,style.palette.muted,0.5) or >>
    }
    frame.line(b.x,b.y + b.height,b.x + b.width,b.y + b.height,style.palette.border,1.0) or >>
    << 0
}
fn (c &mut Chart) paint_legend(frame &mut draw.Frame,styles &Styles,style &ControlStyle) int {
    for i in 0:c.legend_boxes.len {
        b := c.legend_boxes[i]
        mut opacity := 1.0
        if !c.series_is_visible(i) { opacity = 0.4 }
        color := fade_color(c.series_color(i,styles),opacity)
        frame.set_fill(color) or >>
        frame.circle(b.x + 6.0 * styles.density,b.y + b.height * 0.5,4.0 * styles.density) or >>
        label_bounds := layout.Rect{x: b.x + 18.0 * styles.density,y: b.y,width: math.max(0.0,b.width - 24.0 * styles.density),height: b.height}
        name := c.series[i].name + ""
        c.label(40 + i,&name,frame,&label_bounds,styles,fade_color(style.palette.foreground,opacity),0.0) or >>
    }
    << 0
}
fn (c &Chart) paint_cartesian(frame &mut draw.Frame,styles &Styles) int {
    for si in 0:c.series.len { s := &c.series[si]
        if !c.series_is_visible(si) { -> }
        color := c.series_color(si,styles)
        mut path := draw.new_path(32768) or >>
        mut count := 0
        mut previous := ChartCoordinate{x: 0.0,y: 0.0}
        mut first := ChartCoordinate{x: 0.0,y: 0.0}
        mut exit_previous := ChartCoordinate{x: 0.0,y: 0.0}
        mut has_exit_previous := false
        for i in 0:c.data.len { p := &c.data[i]
            if p.series != s.id || p.opacity <= 0.001 { -> }
            raw := c.data_position(p.x,p.y)
            position := ChartCoordinate{x: math.max(0.0 - 100000000.0,math.min(100000000.0,raw.x)),y: math.max(0.0 - 100000000.0,math.min(100000000.0,raw.y))}
            if s.kind == CHART_BAR {
                b := c.bar_bounds(i)
                rounded_fill(frame,&b,math.min(3.0,b.width * 0.2),fade_color(color,p.opacity)) or >>
            } else if s.kind == CHART_SCATTER || (p.target_opacity == 0.0 && s.kind != CHART_BAR) {
                if s.kind != CHART_SCATTER && count > 0 {
                    mut start := previous
                    if has_exit_previous { start = exit_previous }
                    if position.x > start.x {
                        zero := c.data_position(0.0,0.0)
                        baseline := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,zero.y))
                        chart_exit_segment(frame,&start,&position,baseline,s.smooth,s.kind == CHART_AREA,s.line_width * styles.density,fade_color(color,p.opacity),fade_color(color,p.opacity * c.appearance.area_opacity)) or >>
                        exit_previous = position
                        has_exit_previous = true
                    }
                }
                if c.plot.contains(position.x,position.y) { frame.set_fill(fade_color(color,p.opacity * 0.8)) or >>
                    frame.circle(position.x,position.y,math.max(1.0,s.symbol_size) * styles.density) or >> }
            } else {
                if count == 0 { path.move_to(position.x,position.y) or >>
                    first = position }
                else if s.smooth { mid := (previous.x + position.x) * 0.5
                    path.cubic_to(mid,previous.y,mid,position.y,position.x,position.y) or >> }
                else { path.line_to(position.x,position.y) or >> }
                count = count + 1
                previous = position
                if s.points.len <= 128 && s.symbol_size > 0.0 && c.plot.contains(position.x,position.y) { frame.set_fill(fade_color(color,p.opacity)) or >>
                    frame.circle(position.x,position.y,s.symbol_size * styles.density) or >> }
            }
        }
        if count > 0 {
            stroke := draw.stroke_options(s.line_width * styles.density)
            frame.stroke_path(&path,color,&stroke) or >>
            if s.kind == CHART_AREA {
                zero := c.data_position(0.0,0.0)
                baseline := math.max(c.plot.y,math.min(c.plot.y + c.plot.height,zero.y))
                path.line_to(previous.x,baseline) or >>
                path.line_to(first.x,baseline) or >>
                path.close() or >>
                frame.fill_path(&path,fade_color(color,c.appearance.area_opacity),draw.FILL_NONZERO) or >>
            }
        }
    }
    << 0
}
fn chart_exit_segment(frame &mut draw.Frame,start &ChartCoordinate,end &ChartCoordinate,baseline f64,
    smooth bool,area bool,width f64,color draw.Color,fill draw.Color) int {
    mut path := draw.new_path(256)
    path.move_to(start.x,start.y) or >>
    if smooth { mid := (start.x + end.x) * 0.5
        path.cubic_to(mid,start.y,mid,end.y,end.x,end.y) or >> }
    else { path.line_to(end.x,end.y) or >> }
    stroke := draw.stroke_options(width)
    frame.stroke_path(&path,color,&stroke) or >>
    if area { path.line_to(end.x,baseline) or >>
        path.line_to(start.x,baseline) or >>
        path.close() or >>
        frame.fill_path(&path,fill,draw.FILL_NONZERO) or >> }
    << 0
}
fn (c &Chart) paint_donut(frame &mut draw.Frame,styles &Styles) int {
    total := c.donut_total()
    if total <= 0.0 { << 0 }
    cx := c.plot.x + c.plot.width * 0.5
    cy := c.plot.y + c.plot.height * 0.5
    radius := math.min(c.plot.width,c.plot.height) * 0.44
    inner := radius * c.appearance.inner_radius
    mut angle := 0.0 - math.pi() * 0.5
    for i in 0:c.data.len {
        p := &c.data[i]
        if !c.datum_visible(i) || p.y <= 0.0 { -> }
        sweep := c.donut_value(i) / total * math.pi() * 2.0
        steps := max_int(2,int(math.ceil(sweep * radius / 4.0)))
        mut outer_radius := radius
        if i == c.hot || i == c.selected { outer_radius = radius + 5.0 * c.emphasis.value() }
        mut path := draw.new_path(4096) or >>
        path.move_to(cx + math.cos(angle) * outer_radius,cy + math.sin(angle) * outer_radius) or >>
        for step in 1:steps + 1 { a := angle + sweep * f64(step) / f64(steps)
            path.line_to(cx + math.cos(a) * outer_radius,cy + math.sin(a) * outer_radius) or >> }
        for step in 0:steps + 1 { a := angle + sweep * (1.0 - f64(step) / f64(steps))
            path.line_to(cx + math.cos(a) * inner,cy + math.sin(a) * inner) or >> }
        path.close() or >>
        frame.fill_path(&path,fade_color(c.series_color(i,styles),p.opacity),draw.FILL_NONZERO) or >>
        angle = angle + sweep
    }
    << 0
}
fn (c &Chart) paint_highlight(frame &mut draw.Frame,styles &Styles,style &ControlStyle) int {
    mut index := c.hot
    if index < 0 { index = c.selected }
    if index < 0 || !c.datum_visible(index) || c.donut() { << 0 }
    p := &c.data[index]
    position := c.data_position(p.x,p.y)
    if !c.plot.contains(position.x,position.y) { << 0 }
    color := c.series_color(c.series_index(p.series),styles)
    if c.appearance.crosshair { frame.line(position.x,c.plot.y,position.x,c.plot.y + c.plot.height,fade_color(style.palette.muted,0.5),1.0) or >>
        frame.line(c.plot.x,position.y,c.plot.x + c.plot.width,position.y,fade_color(style.palette.muted,0.25),1.0) or >> }
    frame.set_fill(fade_color(color,0.12 + c.emphasis.value() * 0.08)) or >>
    frame.circle(position.x,position.y,(6.0 + 4.0 * c.emphasis.value()) * styles.density) or >>
    frame.set_fill(style.palette.normal) or >>
    frame.circle(position.x,position.y,5.0 * styles.density) or >>
    frame.set_fill(color) or >>
    frame.circle(position.x,position.y,3.0 * styles.density) or >>
    << 0
}
fn (c &mut Chart) paint_tooltip(frame &mut draw.Frame,styles &Styles,style &ControlStyle) int {
    mut index := c.hot
    if index < 0 { index = c.selected }
    if !c.appearance.tooltip || index < 0 || !c.datum_visible(index) { << 0 }
    series_id := c.data[index].series
    point_x := c.data[index].x
    point_y := c.data[index].y
    point_label := c.data[index].label + ""
    si := c.series_index(series_id)
    mut title := c.series[si].name + ""
    if point_label.len > 0 { title = point_label }
    x_text := c.number(point_x) or >>
    y_text := c.number(point_y) or >>
    mut value := x_text + c.appearance.x_unit + "  ·  " + y_text + c.appearance.y_unit
    if c.donut() { value = y_text + c.appearance.y_unit }
    b := c.bounds()
    position := c.data_position(point_x,point_y)
    mut x := position.x + 14.0
    mut y := position.y - 72.0 * styles.text_scale
    mut text := style.clone()
    if text.inherit_font { text.font = copy_font(&styles.font) }
    text.font.size = text.font.size * 0.8
    text.inherit_font = false
    donut := c.donut()
    plot := c.plot
    cache := mut &c.labels
    title_size := cache.measure(80,&title,styles,&text) or >>
    value_size := cache.measure(81,&value,styles,&text) or >>
    width := math.min(math.max(title_size.width,value_size.width) + 28.0,b.width - 16.0)
    height := title_size.height + value_size.height + 26.0
    if donut {
        x = plot.x + (plot.width - width) * 0.5
        y = plot.y + (plot.height - height) * 0.5
    }
    x = math.max(b.x + 8.0,math.min(b.x + b.width - width - 8.0,x))
    y = math.max(b.y + 8.0,math.min(b.y + b.height - height - 8.0,y))
    panel := layout.Rect{x: x,y: y,width: math.max(0.0,width),height: height}
    mut panel_style := style.clone()
    panel_style.radius = 7.0
    panel_style.shadow_blur = 10.0
    style_box(frame,&panel,&panel_style,styles.density,0) or >>
    title_bounds := layout.Rect{x: x + 14.0,y: y + 8.0,width: math.max(0.0,width - 28.0),height: title_size.height}
    value_bounds := layout.Rect{x: x + 14.0,y: y + title_size.height + 14.0,width: math.max(0.0,width - 28.0),height: value_size.height}
    c.label(80,&title,frame,&title_bounds,styles,style.palette.foreground,0.0) or >>
    c.label(81,&value,frame,&value_bounds,styles,style.palette.muted,0.0) or >>
    << 0
}
fn (c &mut Chart) paint_content(frame &mut draw.Frame,styles &Styles) int {
    c.apply_styles(styles) or >>
    style := c.style_or(styles)
    b := c.bounds()
    style_box(frame,&b,&style,styles.density,c.control.visual_state() & (STATE_FOCUSED | STATE_DISABLED | STATE_READ_ONLY)) or >>
    frame.clip_rect(b.x,b.y,b.width,b.height) or >>
    c.paint_legend(frame,styles,&style) or >>
    mut count := 0
    for i in 0:c.data.len { if c.datum_visible(i) { count = count + 1 } }
    mut targets := 0
    for s in c.series { if c.series_visible(s.id) or >> { for p in s.points {
        if !c.donut() || p.y > 0.0 { targets = targets + 1 } } } }
    if targets == 0 && (count == 0 || (c.donut() && c.donut_total() <= 0.0)) {
        mut empty := c.appearance.empty_text + ""
        if empty.len == 0 { empty = c.locale.text(TEXT_NO_RECORDS) or >> }
        plot := c.plot_bounds()
        c.label(90,&empty,frame,&plot,styles,style.palette.muted,0.5) or >>
        << 0
    }
    if !c.donut() { c.paint_axes(frame,styles,&style) or >> }
    frame.push() or >>
    frame.clip_rect(c.plot.x,c.plot.y,c.plot.width,c.plot.height) or >>
    if c.donut() { c.paint_donut(frame,styles) or >> }
    else { c.paint_cartesian(frame,styles) or >>
        c.paint_highlight(frame,styles,&style) or >> }
    frame.pop() or >>
    tooltip := style.with_opacity(c.emphasis.value()) or >>
    c.paint_tooltip(frame,styles,&tooltip) or >>
    << 0
}
pub fn (c &mut Chart) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    if c.control.closed { >> errors.new("widgets: chart is disposed") }
    frame.push() or >>
    c.paint_content(frame,styles) or (err) { screen_controls_pop(frame)
        >> err }
    frame.pop() or >>
    << 0
}
