@ui/widgets
#ui/draw
#ui/layout
#math

pub fn (v $&SplitView) paint_styled(frame $&draw.Frame,styles &Styles) int {
    $style := styles.card_style()
    if v.control.has_style() { style = v.control.style_or(styles) }
    bounds := v.bounds()
    style_box(frame,&bounds,&style,styles.density,0) or >>
    handle := v.layout().handle
    $opacity := v.hover.value() * 0.14
    if v.dragging { opacity = 0.22 }
    $color := style.palette.border
    if v.control.focused { color = style.palette.focus }
    if !v.is_enabled() { color = style.palette.muted }
    if opacity > 0.0 { rounded_fill(frame,&handle,math.min(handle.width,handle.height) * 0.35,fade_color(color,opacity)) or >> }
    cx := handle.x + handle.width * 0.5
    cy := handle.y + handle.height * 0.5
    d := styles.density
    if v.options.vertical { frame.line(cx - 16.0 * d,cy,cx + 16.0 * d,cy,color,2.0 * d) or >> }
    else { frame.line(cx,cy - 16.0 * d,cx,cy + 16.0 * d,color,2.0 * d) or >> }
    if v.control.focused && v.is_enabled() {
        rounded_stroke(frame,&handle,3.0 * d,style.palette.focus,style.focus_width * d) or >> }
    << 0
}
