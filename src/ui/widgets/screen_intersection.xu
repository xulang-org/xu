@ui/widgets

#ui/layout
#errors
#math

pub const ACTION_INTERSECTION = 25

pub struct IntersectionRecord {
    pub id int
    pub visible bool
    pub ratio f64
    pub visible_rect layout.Rect
}

struct IntersectionEntry {
    threshold f64
    last_visible bool
    last_ratio f64
    initialized bool
}

fn copy_intersection_record(r &IntersectionRecord) IntersectionRecord {
    << IntersectionRecord{
        id: r.id,
        visible: r.visible,
        ratio: r.ratio,
        visible_rect: layout.Rect{x: r.visible_rect.x,y: r.visible_rect.y,width: r.visible_rect.width,height: r.visible_rect.height}
    }
}

fn (s $&Screen) compute_intersection_for(id int,threshold f64) IntersectionRecord {
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 || !s.is_visible(id) || s.is_layout_hidden(id) {
        << IntersectionRecord{id: id,visible: false,ratio: 0.0,visible_rect: layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}}
    }
    gb := s.global_bounds(id) >>> (err) {
        << IntersectionRecord{id: id,visible: false,ratio: 0.0,visible_rect: layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}}
    }
    clip := s.child_clip(id) >>> (err) {
        << IntersectionRecord{id: id,visible: false,ratio: 0.0,visible_rect: layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0}}
    }
    vis := screen_clip_intersection(&gb,&clip)
    area := math.max(0.0,gb.width) * math.max(0.0,gb.height)
    $ratio := 0.0
    if area > 0.0 {
        ratio = math.min(1.0,(vis.width * vis.height) / area)
    }
    is_vis := vis.width > 0.0 && vis.height > 0.0 && ratio >= threshold
    << IntersectionRecord{
        id: id,
        visible: is_vis,
        ratio: ratio,
        visible_rect: vis
    }
}

pub fn (s $&Screen) observe_intersection(id int,threshold f64) int {
    _ := s.node(id) >>>
    if math.is_nan(threshold) || math.is_inf(threshold) || threshold < 0.0 || threshold > 1.0 {
        >>> errors.new("widgets: intersection threshold must be in [0, 1]")
    }
    $entry := IntersectionEntry{
        threshold: threshold,
        last_visible: false,
        last_ratio: 0.0,
        initialized: false
    }
    if s.nodes[id - 1].bounds.width > 0.0 || s.nodes[id - 1].bounds.height > 0.0 {
        rec := s.compute_intersection_for(id,threshold)
        entry.last_visible = rec.visible
        entry.last_ratio = rec.ratio
        entry.initialized = true
    }
    comp := $&s.composition
    obs := $&comp.intersection_observers
    had := obs.has(id)
    obs[id] = entry
    if !had {
        oids := $&comp.intersection_observer_ids
        oids.push(id)
    }
    << 0
}

pub fn (s $&Screen) unobserve_intersection(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.intersection_observers.has(id) {
        obs := $&comp.intersection_observers
        obs.delete(id)
        next := vec_without(&comp.intersection_observer_ids,id)
        comp.intersection_observer_ids = next
    }
    << 0
}

pub fn (s &Screen) is_observing_intersection(id int) bool {
    _ := s.node(id) >>>
    << s.composition.intersection_observers.has(id)
}

pub fn (s $&Screen) intersection_state(id int) IntersectionRecord {
    _ := s.node(id) >>>
    $th := 0.0
    if s.composition.intersection_observers.has(id) {
        th = s.composition.intersection_observers[id].threshold
    }
    << s.compute_intersection_for(id,th)
}

pub fn (s $&Screen) take_intersections() []IntersectionRecord {
    $out := []IntersectionRecord{}
    for i in 0:s.composition.pending_intersections.len {
        out.push(copy_intersection_record(&s.composition.pending_intersections[i]))
    }
    comp := $&s.composition
    comp.pending_intersections = []IntersectionRecord{}
    << out
}

fn (s $&Screen) check_intersection_observers() {
    ocount := s.composition.intersection_observer_ids.len
    if ocount == 0 { << }
    for i in 0:ocount {
        oid := s.composition.intersection_observer_ids[i]
        if oid <= 0 || oid > s.nodes.len || s.nodes[oid - 1].kind < 0 || !s.composition.intersection_observers.has(oid) { -> }
        prev := s.composition.intersection_observers[oid]
        rec := s.compute_intersection_for(oid,prev.threshold)
        $fired := false
        if !prev.initialized {
            comp := $&s.composition
            obs := $&comp.intersection_observers
            obs[oid] = IntersectionEntry{
                threshold: prev.threshold,
                last_visible: rec.visible,
                last_ratio: rec.ratio,
                initialized: true
            }
            if rec.visible { fired = true }
        } else if rec.visible != prev.last_visible || math.abs(rec.ratio - prev.last_ratio) >= 0.25 {
            comp := $&s.composition
            obs := $&comp.intersection_observers
            obs[oid] = IntersectionEntry{
                threshold: prev.threshold,
                last_visible: rec.visible,
                last_ratio: rec.ratio,
                initialized: true
            }
            fired = true
        }
        if fired {
            comp2 := $&s.composition
            pins := $&comp2.pending_intersections
            pins.push(copy_intersection_record(&rec))
            qa := $&s.queued_actions
            qa.push(Action{kind: ACTION_INTERSECTION,id: oid,needs_paint: false,request_focus: false,consumed: false,value: rec.ratio})
        }
    }
}

fn (s $&Screen) cleanup_intersection_observer_for(id int) {
    comp := $&s.composition
    if comp.intersection_observers.has(id) {
        obs := $&comp.intersection_observers
        obs.delete(id)
        next := vec_without(&comp.intersection_observer_ids,id)
        comp.intersection_observer_ids = next
    }
}
