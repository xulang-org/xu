@ui/widgets
#ui
#ui/draw
#ui/layout
#time

fn visual_ranges_place(item $&RangeSlider,bounds &layout.Rect,styles &Styles) RefinedResult {
    $result := refined_result()
    item.set_bounds(bounds) or (err) { << refined_failure(err.msg()) }
    item.apply_styles(styles) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_input(item $&RangeSlider,route int,event &ui.InputEvent) RefinedResult {
    $result := refined_result()
    result.action = item.route(route,event) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_paint(item $&RangeSlider,frame $&draw.Frame,styles &Styles,popup bool) RefinedResult {
    $result := refined_result()
    if !popup { item.paint_styled(frame,styles) or (err) { << refined_failure(err.msg()) } }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_painted(item $&RangeSlider) RefinedResult {
    $result := refined_result()
    item.painted()
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_tick(item $&RangeSlider,now time.Instant,reduced bool,styles &Styles) RefinedResult {
    $result := refined_result()
    result.changed = item.tick(styles,now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_enable(item $&RangeSlider,enabled bool) RefinedResult {
    $result := refined_result()
    item.set_enabled(enabled)
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_dispose(item $&RangeSlider) RefinedResult {
    $result := refined_result()
    item.dispose()
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_style(item $&RangeSlider,style &ControlStyle) RefinedResult {
    $result := refined_result()
    item.set_style(style) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_clear_style(item $&RangeSlider) RefinedResult {
    $result := refined_result()
    item.clear_style()
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_motion(item $&RangeSlider,spec &MotionSpec) RefinedResult {
    $result := refined_result()
    item.set_motion(spec) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_read_only(item $&RangeSlider,value bool) RefinedResult {
    $result := refined_result()
    item.set_read_only(value)
    result.changed = item.needs_paint()
    << result
}

