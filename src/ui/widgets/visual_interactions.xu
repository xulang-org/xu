fn visual_menus_place(item $&Menu,bounds &layout.Rect,styles &Styles,viewport &layout.Rect) RefinedResult {
    $result := refined_result()
    item.set_bounds(bounds) or (err) { << refined_failure(err.msg()) }
    item.set_viewport(viewport) or (err) { << refined_failure(err.msg()) }
    item.apply_styles(styles) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn visual_menus_input(item $&Menu,route int,event &ui.InputEvent) RefinedResult {
    $result := refined_result()
    result.action = item.route(route,event) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
fn visual_menus_paint(item $&Menu,frame $&draw.Frame,styles &Styles,popup bool) RefinedResult {
    $result := refined_result()
    if popup { item.paint_popup_styled(frame,styles) or (err) { << refined_failure(err.msg()) } }
    else { item.paint_styled(frame,styles) or (err) { << refined_failure(err.msg()) } }
    result.changed = item.needs_paint()
    << result
}
fn visual_menus_painted(item $&Menu) RefinedResult {
    $result := refined_result()
    item.painted()
    result.changed = item.needs_paint()
    << result
}
