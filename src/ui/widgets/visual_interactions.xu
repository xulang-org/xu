@ui/widgets
#ui
#ui/draw
#ui/layout
#time

fn visual_ranges_place(item &mut RangeSlider,bounds &layout.Rect,styles &Styles) RefinedResult {
    mut result := refined_result()
    item.set_bounds(bounds) or (err) { << refined_failure(err.msg()) }
    item.apply_styles(styles) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_input(item &mut RangeSlider,route int,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    result.action = item.route(route,event) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_paint(item &mut RangeSlider,frame &mut draw.Frame,styles &Styles,popup bool) RefinedResult {
    mut result := refined_result()
    if !popup { item.paint_styled(frame,styles) or (err) { << refined_failure(err.msg()) } }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_painted(item &mut RangeSlider) RefinedResult {
    mut result := refined_result()
    item.painted()
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_tick(item &mut RangeSlider,now time.Instant,reduced bool,styles &Styles) RefinedResult {
    mut result := refined_result()
    result.changed = item.tick(styles,now,reduced) or (err) { << refined_failure(err.msg()) }
    result.deadline = item.next_tick(now) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_enable(item &mut RangeSlider,enabled bool) RefinedResult {
    mut result := refined_result()
    item.set_enabled(enabled)
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_dispose(item &mut RangeSlider) RefinedResult {
    mut result := refined_result()
    item.dispose()
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_style(item &mut RangeSlider,style &ControlStyle) RefinedResult {
    mut result := refined_result()
    item.set_style(style) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_clear_style(item &mut RangeSlider) RefinedResult {
    mut result := refined_result()
    item.clear_style()
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_motion(item &mut RangeSlider,spec &MotionSpec) RefinedResult {
    mut result := refined_result()
    item.set_motion(spec) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}

fn visual_ranges_read_only(item &mut RangeSlider,value bool) RefinedResult {
    mut result := refined_result()
    item.set_read_only(value)
    result.changed = item.needs_paint()
    << result
}

