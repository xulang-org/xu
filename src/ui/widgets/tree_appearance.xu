@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#strings
#time

pub const ACTION_ITEM_ACTION = 6

pub fn (t $&TreeView) set_appearance(a &TreeAppearance) int {
    a.validate() or >>
    t.appearance = TreeAppearance{indent: a.indent,row_height: a.row_height,guides: a.guides,
        icons: a.icons,selection_mark: a.selection_mark,guide_opacity: a.guide_opacity,action_width: a.action_width}
    t.cancel()
    t.rows.dirty = true
    << 0
}
pub fn (t $&TreeView) set_motion(spec &MotionSpec) int {
    spec.validate() or >>
    t.motion = MotionSpec{hover: spec.hover,press: spec.press,change: spec.change,enter: spec.enter,exit: spec.exit,curve: spec.curve}
    << 0
}
pub fn (t $&TreeView) set_metadata(node int,text &string) int {
    if t.rows.closed || node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    validate_table_text(text) or >>
    t.metadata[node] = text + ""
    t.rows.dirty = true
    << 0
}
pub fn (t $&TreeView) set_icon(node int,icon int) int {
    if t.rows.closed || node < 0 || node >= t.count() || icon < TREE_ICON_NONE || icon > TREE_ICON_FILE { >> errors.new("widgets: invalid tree icon") }
    t.icons[node] = icon
    t.rows.dirty = true
    << 0
}
pub fn (t $&TreeView) set_action(node int,enabled bool) int {
    if t.rows.closed || node < 0 || node >= t.count() { >> errors.new("widgets: invalid tree node") }
    t.actions[node] = enabled
    t.armed_action = -1
    t.rows.dirty = true
    << 0
}
pub fn (t $&TreeView) begin_update() int {
    if t.rows.closed || t.update_depth >= 32 { >> errors.new("widgets: invalid tree update nesting") }
    if t.update_depth == 0 { t.pending_selected = t.selected() }
    t.update_depth = t.update_depth + 1
    << 0
}
pub fn (t $&TreeView) end_update() int {
    if t.rows.closed || t.update_depth <= 0 { >> errors.new("widgets: unmatched tree end_update") }
    t.update_depth = t.update_depth - 1
    if t.update_depth == 0 { selected := t.pending_selected
        t.rebuild(selected) or >> }
    << 0
}
pub fn (t $&TreeView) set_filter(query &string) int {
    validate_table_text(query) or >>
    if t.rows.closed { >> errors.new("widgets: tree is disposed") }
    next := strings.to_lower(query)
    if t.filter_text != next {
        selected := t.selected()
        t.filter_text = next
        t.rebuild(selected) or >>
    }
    << 0
}
pub fn (t $&TreeView) reveal_selected() int {
    rows := $&t.rows
    if rows.selected_val >= 0 { rows.ensure_visible(rows.selected_val) or >> }
    << 0
}
// Unicode committed text can be passed by the application; raw key events are
// used only for ASCII type-ahead, never for IME composition.
pub fn (t $&TreeView) find_next(prefix &string) bool {
    query := strings.to_lower(prefix)
    if query.len == 0 || t.visible.len == 0 { << false }
    start := t.rows.selected_val
    for step in 1:t.visible.len + 1 {
        $row := max_int(-1,start) + step
        if row >= t.visible.len { row = row - t.visible.len }
        node := t.visible[row]
        label := strings.to_lower(&t.values[node])
        if strings.has_prefix(&label,query + "") {
            rows := $&t.rows
            rows.set_selected(row) or >>
            rows.ensure_visible(row) or >>
            << true
        }
    }
    << false
}
pub fn (t $&TreeView) tick(now time.Instant,reduced_motion bool) bool {
    $changed := false
    for i in 0:t.count() {
        $target := 0.0
        if t.expanded[i] || t.filter_text.len > 0 { target = 90.0 }
        $angle := t.rotations[i]
        angle.set_curve(t.motion.curve) or (err) { >> errors.new("widgets: tree arrow: " + err.msg()) }
        before := angle.value()
        angle.retarget(target,now,t.motion.change,reduced_motion || !t.motion_ready) or >>
        _ := angle.advance(now) or >>
        if before != angle.value() { changed = true }
        t.rotations[i] = angle
    }
    t.motion_ready = true
    if changed { t.rows.dirty = true }
    << changed
}
pub fn (t &TreeView) next_tick(now time.Instant) time.Instant {
    for angle in t.rotations { if angle.is_animating() { << overlay_next_tick(true,now) or >> } }
    << time.zero_instant()
}
pub fn (t &TreeView) action_bounds(row int) layout.Rect {
    r := t.row_bounds(row)
    width := math.min(r.width,t.appearance.action_width * t.density)
    $end := r.x + r.width
    if t.rows.max_scroll() > 0.0 { end = end - 24.0 * t.density }
    << layout.Rect{x: end - width,y: r.y,width: width,height: r.height}
}
fn (t &TreeView) hit_action(input &ui.InputEvent) int {
    if t.rows.scrollbar_contains(input.x,input.y) { << -1 }
    row := t.rows.hit_row(input.x,input.y)
    if row < 0 || !t.actions[t.visible[row]] { << -1 }
    r := t.action_bounds(row)
    if r.contains(input.x,input.y) { << t.visible[row] }
    << -1
}
fn tree_chevron(frame $&draw.Frame,x f64,y f64,size f64,angle f64,color draw.Color) int {
    $path := draw.new_path(80)
    path.move_to(0.0 - size * 0.22,0.0 - size * 0.36) or >>
    path.line_to(size * 0.18,0.0) or >>
    path.line_to(0.0 - size * 0.22,size * 0.36) or >>
    $stroke := draw.stroke_options(math.max(1.0,size * 0.13))
    stroke.cap = draw.CAP_ROUND
    stroke.join = draw.JOIN_ROUND
    frame.push() or >>
    frame.translate(x,y) or >>
    frame.rotate(angle) or >>
    frame.stroke_path(&path,color,&stroke) or >>
    frame.pop() or >>
    << 0
}
fn tree_icon(frame $&draw.Frame,r &layout.Rect,folder bool,color draw.Color) int {
    $path := draw.new_path(260)
    x := r.x
    y := r.y
    w := r.width
    h := r.height
    if folder {
        path.move_to(x,y + h * 0.22) or >>
        path.line_to(x + w * 0.38,y + h * 0.22) or >>
        path.line_to(x + w * 0.52,y + h * 0.36) or >>
        path.line_to(x + w,y + h * 0.36) or >>
        path.line_to(x + w,y + h * 0.88) or >>
        path.line_to(x,y + h * 0.88) or >>
    } else {
        path.move_to(x + w * 0.15,y + h * 0.1) or >>
        path.line_to(x + w * 0.62,y + h * 0.1) or >>
        path.line_to(x + w * 0.85,y + h * 0.33) or >>
        path.line_to(x + w * 0.85,y + h * 0.9) or >>
        path.line_to(x + w * 0.15,y + h * 0.9) or >>
    }
    path.close() or >>
    $stroke := draw.stroke_options(math.max(1.0,w * 0.075))
    stroke.join = draw.JOIN_ROUND
    << frame.stroke_path(&path,color,&stroke) or >>
}
pub fn (t $&TreeView) paint_styled(frame $&draw.Frame,styles &Styles) int {
    t.apply_styles(styles) or >>
    c := t.style_or(styles)
    d := styles.density
    b := t.bounds()
    style_box(frame,&b,&c,d,t.rows.visual_state() & (STATE_DISABLED | STATE_INVALID | STATE_READ_ONLY)) or >>
    viewport := layout.Rect{x: b.x + t.rows.padding.left,y: b.y + t.rows.padding.top,
        width: math.max(0.0,b.width - t.rows.padding.left - t.rows.padding.right),
        height: math.max(0.0,b.height - t.rows.padding.top - t.rows.padding.bottom)}
    first := max_int(0,int(t.rows.scroll_y / t.rows.row_h))
    last := min_int(t.visible.len,first + int(viewport.height / t.rows.row_h) + 2)
    $label_style := c.clone()
    label_style.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    label_style.align_x = 0.0
    $meta_style := label_style.clone()
    meta_style.palette.foreground = c.palette.muted
    meta_style.states = []StatePaint{}
    meta_style.align_x = 1.0
    frame.push() or >>
    frame.clip_rect(viewport.x,viewport.y,viewport.width,viewport.height) or >>
    for row in first:last {
        node := t.visible[row]
        $r := t.row_bounds(row)
        if f64(t.visible.len) * t.rows.row_h > viewport.height { r.width = math.max(0.0,r.width - 24.0 * d) }
        state := t.rows.item_visual_state(row)
        paint := c.resolve(state)
        selected := row == t.rows.selected_val
        if selected || row == t.rows.hovered_idx { rounded_fill(frame,&r,c.radius * d,paint.background) or >> }
        if selected && t.appearance.selection_mark {
            mark := layout.Rect{x: r.x,y: r.y + 7.0 * d,width: 2.0 * d,height: math.max(0.0,r.height - 14.0 * d)}
            rounded_fill(frame,&mark,d,c.palette.accent) or >>
        }
        if selected && t.rows.focused { rounded_stroke(frame,&r,c.radius * d,c.palette.focus,c.focus_width * d) or >> }
        if t.appearance.guides {
            for level in 0:t.depths[node] {
                x := r.x + f64(level) * t.indent + 12.0 * d
                frame.line(x,r.y,x,r.y + r.height,fade_color(c.palette.border,t.appearance.guide_opacity),d) or >>
            }
        }
        indent := f64(t.depths[node]) * t.indent
        if t.has_children(node) {
            $angle := 0.0
            if t.motion_ready { angle = t.rotations[node].value() }
            else if t.expanded[node] || t.filter_text.len > 0 { angle = 90.0 }
            tree_chevron(frame,r.x + indent + 12.0 * d,r.y + r.height * 0.5,9.0 * d,angle,c.palette.muted) or >>
        }
        $x := r.x + indent + 26.0 * d
        if t.appearance.icons && t.icons[node] != TREE_ICON_NONE {
            icon := layout.Rect{x: x,y: r.y + (r.height - 16.0 * d) * 0.5,width: 16.0 * d,height: 16.0 * d}
            folder := t.icons[node] == TREE_ICON_FOLDER || (t.icons[node] == TREE_ICON_AUTO && t.has_children(node))
            tree_icon(frame,&icon,folder,c.palette.muted) or >>
            x = x + 23.0 * d
        }
        $right := r.x + r.width - 8.0 * d
        if t.actions[node] {
            action := t.action_bounds(row)
            for dot in 0:3 {
                frame.set_fill(paint.foreground) or >>
                frame.circle(action.x + action.width * 0.5 + f64(dot - 1) * 4.0 * d,r.y + r.height * 0.5,d) or >>
            }
            right = math.min(right,action.x - 4.0 * d)
        }
        if t.metadata[node].len > 0 {
            meta := t.metadata[node] + ""
            cache := $&t.secondary
            size := cache.measure(row - first,&meta,styles,&meta_style) or >>
            width := math.min(size.width,math.max(0.0,(right - x) * 0.35))
            rect := layout.Rect{x: right - width,y: r.y,width: width,height: r.height}
            cache.paint_text(row - first,&meta,frame,&rect,styles,&meta_style,state & STATE_DISABLED) or >>
            right = right - width - 12.0 * d
        }
        rect := layout.Rect{x: x,y: r.y,width: math.max(0.0,right - x),height: r.height}
        text := t.values[node] + ""
        cache := $&t.labels
        cache.paint_text(row - first,&text,frame,&rect,styles,&label_style,state) or >>
    }
    t.rows.paint_data_scrollbar(frame,&c) or >>
    frame.pop() or >>
    << 0
}
