@ui/widgets

#ui
#ui/draw
#ui/layout
#math
#errors

pub const SLOT_CONTENT = 0
pub const SLOT_HEADER = 1
pub const SLOT_BODY = 2
pub const SLOT_FOOTER = 3
pub const SLOT_LEADING = 4
pub const SLOT_TRAILING = 5
pub const SLOT_PREFIX = 6
pub const SLOT_SUFFIX = 7
pub const SLOT_TITLE = 8
pub const SLOT_SUBTITLE = 9
pub const SLOT_ACTIONS = 10
pub const SLOT_SIDEBAR = 11
pub const SLOT_INSPECTOR = 12
pub const SLOT_MEDIA = 13
pub const SLOT_HELPER = 14
pub const SLOT_ERROR = 15
pub const SLOT_EMPTY = 16
pub const SLOT_MAX = 16

struct SlotBinding {
    owner int
    is_indexed bool
    key int
}

struct ScreenSlots {
    named map[int]int
    indexed map[int]int
    mounted map[int]int
    mounted_by_child map[int]int
    owners map[int]SlotBinding
    owned_hosts map[int][]int
    extents map[int]f64
    extent_owners map[int]bool
    indexed_owners map[int]int
}

fn new_screen_slots() ScreenSlots {
    << ScreenSlots{
        named: map[int]int{},
        indexed: map[int]int{},
        mounted: map[int]int{},
        mounted_by_child: map[int]int{},
        owners: map[int]SlotBinding{},
        owned_hosts: map[int][]int{},
        extents: map[int]f64{},
        extent_owners: map[int]bool{},
        indexed_owners: map[int]int{}
    }
}

fn slot_named_key(owner int,kind int) int {
    << owner * 32 + kind
}

fn slot_indexed_key(owner int,index int) int {
    << owner * 512 + index
}

fn (s &Screen) normalize_slot_kind(container int,kind int) int {
    if kind < 0 || kind > SLOT_MAX { >> errors.new("widgets: invalid slot kind") }
    node := s.node(container) or >>
    if node.kind == SCREEN_CARD {
        if s.basics.scrolls.has(container) {
            if kind == SLOT_BODY { << SLOT_CONTENT }
        } else {
            if kind == SLOT_CONTENT { << SLOT_BODY }
        }
    } else if node.kind == SCREEN_MODAL {
        if kind == SLOT_CONTENT { << SLOT_BODY }
    } else if node.kind == SCREEN_POPOVER {
        if kind == SLOT_BODY { << SLOT_CONTENT }
    }
    << kind
}

fn (s &Screen) slot_supports(container int,kind int) bool {
    node := s.node(container) or (err) { << false }
    k := node.kind
    if k == SCREEN_CARD {
        if s.basics.scrolls.has(container) { << kind == SLOT_CONTENT }
        << kind == SLOT_HEADER || kind == SLOT_ACTIONS || kind == SLOT_MEDIA || kind == SLOT_BODY || kind == SLOT_FOOTER
    }
    if k == SCREEN_MODAL {
        << kind == SLOT_HEADER || kind == SLOT_BODY || kind == SLOT_FOOTER || kind == SLOT_ACTIONS
    }
    if k == SCREEN_POPOVER {
        << kind == SLOT_HEADER || kind == SLOT_CONTENT || kind == SLOT_FOOTER
    }
    if k == SCREEN_SPLIT_VIEW {
        << kind == SLOT_LEADING || kind == SLOT_TRAILING
    }
    if k == SCREEN_TABS {
        << kind == SLOT_HEADER
    }
    if k == SCREEN_GROUP || k == SCREEN_CUSTOM {
        << true
    }
    << false
}

fn (s &Screen) indexed_slot_limit(container int) int {
    node := s.node(container) or (err) { << -1 }
    if node.kind == SCREEN_SPLIT_VIEW { << 2 }
    if node.kind == SCREEN_TABS && s.basics.tabs.has(container) { << s.basics.tabs[container].count() }
    if node.kind == SCREEN_GROUP || node.kind == SCREEN_CUSTOM { << 256 }
    << 0
}

fn (s &Screen) has_indexed_slots(container int) bool {
    << s.composition.slots.indexed_owners.get_or(container,0) > 0
}

fn (s &Screen) is_slot_host(id int) bool {
    << s.composition.slots.owners.has(id)
}

fn (s $&Screen) register_slot_host(container int,is_indexed bool,key int,host int) {
    comp := $&s.composition
    slots := $&comp.slots
    if is_indexed {
        idx_map := $&slots.indexed
        idx_map[slot_indexed_key(container,key)] = host
        prev := slots.indexed_owners.get_or(container,0)
        idx_owners := $&slots.indexed_owners
        idx_owners[container] = prev + 1
    } else {
        named := $&slots.named
        named[slot_named_key(container,key)] = host
    }
    owners := $&slots.owners
    owners[host] = SlotBinding{owner: container,is_indexed: is_indexed,key: key}
    oh := $&slots.owned_hosts
    if !oh.has(container) { oh[container] = []int{} }
    $list := oh.take(container)
    list.push(host)
    oh[container] = list
}

pub fn (s &Screen) has_slot(container int,kind int) bool {
    _ := s.node(container) or (err) { << false }
    norm := s.normalize_slot_kind(container,kind) or (err) { << false }
    node := s.node(container) or (err) { << false }
    if node.kind == SCREEN_SPLIT_VIEW {
        if norm == SLOT_LEADING { << s.has_slot_at(container,0) }
        if norm == SLOT_TRAILING { << s.has_slot_at(container,1) }
        << false
    }
    << s.composition.slots.named.has(slot_named_key(container,norm))
}

pub fn (s &Screen) slot_of(container int,kind int) int {
    _ := s.node(container) or (err) { << 0 }
    norm := s.normalize_slot_kind(container,kind) or (err) { << 0 }
    node := s.node(container) or (err) { << 0 }
    if node.kind == SCREEN_SPLIT_VIEW {
        if norm == SLOT_LEADING { << s.slot_at_of(container,0) }
        if norm == SLOT_TRAILING { << s.slot_at_of(container,1) }
        << 0
    }
    << s.composition.slots.named.get_or(slot_named_key(container,norm),0)
}

pub fn (s &Screen) mounted_in(container int,kind int) int {
    host := s.slot_of(container,kind)
    if host <= 0 { << 0 }
    << s.composition.slots.mounted.get_or(host,0)
}

pub fn (s &Screen) has_slot_at(container int,index int) bool {
    _ := s.node(container) or (err) { << false }
    if index < 0 { << false }
    << s.composition.slots.indexed.has(slot_indexed_key(container,index))
}

pub fn (s &Screen) slot_at_of(container int,index int) int {
    _ := s.node(container) or (err) { << 0 }
    if index < 0 { << 0 }
    << s.composition.slots.indexed.get_or(slot_indexed_key(container,index),0)
}

pub fn (s &Screen) mounted_at(container int,index int) int {
    host := s.slot_at_of(container,index)
    if host <= 0 { << 0 }
    << s.composition.slots.mounted.get_or(host,0)
}

pub fn (s $&Screen) slot(container int,kind int) int {
    node := s.node(container) or >>
    norm := s.normalize_slot_kind(container,kind) or >>
    if !s.slot_supports(container,norm) { >> errors.new("widgets: container does not support this slot kind") }
    if node.kind == SCREEN_SPLIT_VIEW {
        if norm == SLOT_LEADING { << s.slot_at(container,0) or >> }
        << s.slot_at(container,1) or >>
    }
    if node.kind == SCREEN_TABS {
        >> errors.new("widgets: Tabs uses indexed slots via slot_at/mount_at")
    }
    existing := s.slot_of(container,norm)
    if existing > 0 { << existing }
    host := s.group() or >>
    s.set_parent(host,container) or (err) { s.abandon_node(host)
        >> err }
    s.register_slot_host(container,false,norm,host)
    s.mark_layout_dirty()
    << host
}

pub fn (s $&Screen) slot_at(container int,index int) int {
    node := s.node(container) or >>
    limit := s.indexed_slot_limit(container)
    if limit <= 0 || index < 0 || index >= limit { >> errors.new("widgets: indexed slot out of range") }
    if node.kind == SCREEN_SPLIT_VIEW {
        << s.split_pane(container,index) or >>
    }
    existing := s.slot_at_of(container,index)
    if existing > 0 { << existing }
    host := s.group() or >>
    s.set_parent(host,container) or (err) { s.abandon_node(host)
        >> err }
    s.register_slot_host(container,true,index,host)
    if node.kind == SCREEN_TABS {
        sel := s.basics.tabs[container].selected()
        s.nodes[host - 1].visible = (index == sel)
    }
    s.mark_layout_dirty()
    << host
}

pub fn (s $&Screen) set_slot_extent(container int,kind int,extent f64) int {
    _ := s.node(container) or >>
    norm := s.normalize_slot_kind(container,kind) or >>
    if !s.slot_supports(container,norm) { >> errors.new("widgets: container does not support this slot kind") }
    if math.is_nan(extent) || math.is_inf(extent) || extent < 0.0 || extent > 4096.0 {
        >> errors.new("widgets: invalid slot extent")
    }
    comp := $&s.composition
    slots := $&comp.slots
    exts := $&slots.extents
    exts[slot_named_key(container,norm)] = extent
    eo := $&slots.extent_owners
    eo[container] = true
    s.mark_layout_dirty()
    << 0
}

fn (s &Screen) slot_extent(container int,kind int) f64 {
    << s.composition.slots.extents.get_or(slot_named_key(container,kind),-1.0)
}

fn (s $&Screen) clear_slot_reverse_mount(host int,child int) {
    if child <= 0 { << }
    comp := $&s.composition
    slots := $&comp.slots
    mbc := $&slots.mounted_by_child
    if mbc.get_or(child,0) == host { mbc.delete(child) }
}

fn (s $&Screen) mount_into_host(container int,host int,child int) int {
    _ := s.node(child) or >>
    if child == container || child == host || s.is_descendant(container,child) || s.is_descendant(host,child) {
        >> errors.new("widgets: slot mount would create a cycle")
    }
    old_host := s.composition.slots.mounted_by_child.get_or(child,0)
    if old_host > 0 && old_host != host {
        comp := $&s.composition
        slots := $&comp.slots
        mounted := $&slots.mounted
        if mounted.get_or(old_host,0) == child { mounted[old_host] = 0 }
    }
    prev := s.composition.slots.mounted.get_or(host,0)
    if prev > 0 && prev != child && prev <= s.nodes.len && s.nodes[prev - 1].kind >= 0 {
        s.set_visible(prev,false) or >>
        if s.nodes[prev - 1].parent == host { s.set_parent(prev,0) or >> }
    }
    s.set_parent(child,host) or >>
    s.set_visible(child,true) or >>
    if prev > 0 && prev != child { s.clear_slot_reverse_mount(host,prev) }
    comp := $&s.composition
    slots := $&comp.slots
    mounted := $&slots.mounted
    mounted[host] = child
    mbc := $&slots.mounted_by_child
    mbc[child] = host
    s.mark_layout_dirty()
    << 0
}

fn (s $&Screen) unmount_from_host(host int) int {
    prev := s.composition.slots.mounted.get_or(host,0)
    s.set_slot_mounted(host,0)
    s.clear_slot_reverse_mount(host,prev)
    if prev > 0 && prev <= s.nodes.len && s.nodes[prev - 1].kind >= 0 {
        s.set_visible(prev,false) or >>
        if s.nodes[prev - 1].parent == host { s.set_parent(prev,0) or >> }
    }
    s.mark_layout_dirty()
    << prev
}

fn (s $&Screen) set_slot_mounted(host int,child int) {
    comp := $&s.composition
    slots := $&comp.slots
    mounted := $&slots.mounted
    mounted[host] = child
}

fn (s $&Screen) take_slot_mounted(host int) int {
    comp := $&s.composition
    slots := $&comp.slots
    mounted := $&slots.mounted
    << mounted.take(host)
}

fn (s $&Screen) take_slot_mounted_by_child(id int) int {
    comp := $&s.composition
    slots := $&comp.slots
    mbc := $&slots.mounted_by_child
    << mbc.take(id)
}

fn (s $&Screen) take_slot_owned_hosts(id int) []int {
    comp := $&s.composition
    slots := $&comp.slots
    oh := $&slots.owned_hosts
    << oh.take(id)
}

pub fn (s $&Screen) mount(container int,kind int,child int) int {
    host := s.slot(container,kind) or >>
    << s.mount_into_host(container,host,child) or >>
}

pub fn (s $&Screen) unmount(container int,kind int) int {
    host := s.slot_of(container,kind)
    if host <= 0 { << 0 }
    << s.unmount_from_host(host) or >>
}

pub fn (s $&Screen) mount_at(container int,index int,child int) int {
    host := s.slot_at(container,index) or >>
    << s.mount_into_host(container,host,child) or >>
}

pub fn (s $&Screen) unmount_at(container int,index int) int {
    host := s.slot_at_of(container,index)
    if host <= 0 { << 0 }
    << s.unmount_from_host(host) or >>
}

fn (s $&Screen) detach_slot_host_from_owner(owner int,host int) {
    comp := $&s.composition
    slots := $&comp.slots
    oh := $&slots.owned_hosts
    if !oh.has(owner) { << }
    old := oh.take(owner)
    $next := []int{}
    for i in 0:old.len {
        if old[i] != host { next.push(old[i]) }
    }
    if next.len == 0 { << }
    oh[owner] = next
}

fn (s $&Screen) cleanup_single_slot_host_entry(host int,detach_owner bool) {
    $has_owner := false
    $binding := SlotBinding{owner: 0,is_indexed: false,key: 0}
    if s.composition.slots.owners.has(host) {
        comp := $&s.composition
        slots := $&comp.slots
        owners := $&slots.owners
        binding = owners.take(host)
        has_owner = true
    }
    if has_owner {
        if binding.is_indexed {
            ikey := slot_indexed_key(binding.owner,binding.key)
            if s.composition.slots.indexed.has(ikey) {
                comp := $&s.composition
                slots := $&comp.slots
                idx_map := $&slots.indexed
                idx_map.delete(ikey)
            }
            cnt := s.composition.slots.indexed_owners.get_or(binding.owner,0)
            if cnt > 1 {
                comp := $&s.composition
                slots := $&comp.slots
                idx_owners := $&slots.indexed_owners
                idx_owners[binding.owner] = cnt - 1
            } else if cnt == 1 {
                comp := $&s.composition
                slots := $&comp.slots
                idx_owners := $&slots.indexed_owners
                idx_owners.delete(binding.owner)
            }
        } else {
            nkey := slot_named_key(binding.owner,binding.key)
            if s.composition.slots.named.has(nkey) {
                comp := $&s.composition
                slots := $&comp.slots
                named := $&slots.named
                named.delete(nkey)
            }
        }
        if detach_owner { s.detach_slot_host_from_owner(binding.owner,host) }
    }
    if s.composition.slots.mounted.has(host) {
        ch := s.take_slot_mounted(host)
        s.clear_slot_reverse_mount(host,ch)
    }
}

fn (s $&Screen) cleanup_slot_bindings_for(id int) {
    s.cleanup_single_slot_host_entry(id,true)
    if s.composition.slots.mounted_by_child.has(id) {
        host := s.take_slot_mounted_by_child(id)
        if host > 0 && s.composition.slots.mounted.get_or(host,0) == id {
            s.set_slot_mounted(host,0)
        }
    }
    if s.composition.slots.owned_hosts.has(id) {
        hosts := s.take_slot_owned_hosts(id)
        for i in 0:hosts.len {
            s.cleanup_single_slot_host_entry(hosts[i],false)
        }
    }
    if s.composition.slots.extent_owners.has(id) {
        comp := $&s.composition
        slots := $&comp.slots
        eo := $&slots.extent_owners
        eo.delete(id)
        exts := $&slots.extents
        for kind in 0:(SLOT_MAX + 1) {
            nkey := slot_named_key(id,kind)
            if exts.has(nkey) { exts.delete(nkey) }
        }
    }
    if s.composition.slots.indexed_owners.has(id) {
        comp := $&s.composition
        slots := $&comp.slots
        idx_owners := $&slots.indexed_owners
        idx_owners.delete(id)
    }
}

fn (s $&Screen) slot_host_natural_height_styled(owner int,host int,kind int,avail_w f64,default_h f64,styles &Styles) f64 {
    explicit := s.slot_extent(owner,kind)
    if explicit > 0.0 { << explicit }
    sz := s.measure_constrained_styled(host,avail_w,4096.0,styles) or (err) { << default_h }
    if sz.height > 0.0 { << sz.height }
    << default_h
}

fn (s $&Screen) slot_host_natural_height(owner int,host int,kind int,avail_w f64,default_h f64) f64 {
    styles := s.styles_for(owner)
    << s.slot_host_natural_height_styled(owner,host,kind,avail_w,default_h,&styles)
}

fn (s $&Screen) slot_host_natural_width_styled(owner int,host int,kind int,avail_h f64,default_w f64,styles &Styles) f64 {
    explicit := s.slot_extent(owner,kind)
    if explicit > 0.0 { << explicit }
    sz := s.measure_constrained_styled(host,4096.0,avail_h,styles) or (err) { << default_w }
    if sz.width > 0.0 { << sz.width }
    << default_w
}

fn (s $&Screen) slot_host_natural_width(owner int,host int,kind int,avail_h f64,default_w f64) f64 {
    styles := s.styles_for(owner)
    << s.slot_host_natural_width_styled(owner,host,kind,avail_h,default_w,&styles)
}

fn (s $&Screen) place_slot_local(host int,rect &layout.Rect) {
    if host <= 0 || host > s.nodes.len { << }
    s.nodes[host - 1].local = copy_rect(rect)
}

fn (s $&Screen) fit_mounted_child(host int) {
    child := s.composition.slots.mounted.get_or(host,0)
    if child <= 0 || child > s.nodes.len || s.nodes[child - 1].kind < 0 { << }
    if s.nodes[child - 1].parent != host { << }
    hl := s.nodes[host - 1].local
    $x := 0.0
    $y := 0.0
    $w := hl.width
    $h := hl.height
    if s.composition.items.has(child) {
        item := &s.composition.items[child]
        $avail_w := math.max(0.0,hl.width - item.margin.left - item.margin.right)
        $avail_h := math.max(0.0,hl.height - item.margin.top - item.margin.bottom)
        if item.width >= 0.0 { w = math.min(avail_w,item.width) } else { w = avail_w }
        if item.height >= 0.0 { h = math.min(avail_h,item.height) } else { h = avail_h }
        if item.max_width >= 0.0 { w = math.min(w,item.max_width) }
        if item.max_height >= 0.0 { h = math.min(h,item.max_height) }
        w = math.max(w,math.min(avail_w,item.min_width))
        h = math.max(h,math.min(avail_h,item.min_height))
        $ax := 0.0
        $ay := 0.0
        if item.align_self == layout.CROSS_CENTER { ax = (avail_w - w) * 0.5
            ay = (avail_h - h) * 0.5 }
        else if item.align_self == layout.CROSS_END { ax = avail_w - w
            ay = avail_h - h }
        x = item.margin.left + ax
        y = item.margin.top + ay
    }
    s.nodes[child - 1].local = layout.Rect{x: x,y: y,width: w,height: h}
}

fn (s $&Screen) layout_card_slots_styled(id int,styles &Styles) int {
    has_h := s.has_slot(id,SLOT_HEADER)
    has_a := s.has_slot(id,SLOT_ACTIONS)
    has_m := s.has_slot(id,SLOT_MEDIA)
    has_b := s.has_slot(id,SLOT_BODY)
    has_f := s.has_slot(id,SLOT_FOOTER)
    if !has_h && !has_a && !has_m && !has_b && !has_f { << 0 }
    if s.basics.card_sections.has(id) && !has_a && !has_m { << 0 }
    bounds := s.nodes[id - 1].bounds
    card_ref := &s.basics.cards[id]
    global_area := card_ref.content_bounds(styles)
    area := layout.Rect{x: global_area.x - bounds.x,y: global_area.y - bounds.y,width: global_area.width,height: global_area.height}
    gap := 8.0 * styles.density
    $top := area.y
    $bottom := area.y + area.height

    if has_h || has_a {
        $act_w := 0.0
        $act_h := 0.0
        if has_a {
            ah := s.slot_of(id,SLOT_ACTIONS)
            act_w = math.min(area.width * 0.5,s.slot_host_natural_width_styled(id,ah,SLOT_ACTIONS,44.0 * styles.density,96.0 * styles.density,styles))
            act_h = s.slot_host_natural_height_styled(id,ah,SLOT_ACTIONS,act_w,32.0 * styles.density,styles)
        }
        $hdr_w := area.width
        if has_a { hdr_w = math.max(0.0,area.width - act_w - gap) }
        $hdr_h := 0.0
        if has_h {
            hh := s.slot_of(id,SLOT_HEADER)
            hdr_h = s.slot_host_natural_height_styled(id,hh,SLOT_HEADER,hdr_w,32.0 * styles.density,styles)
        }
        row_h := math.min(math.max(0.0,bottom - top),math.max(hdr_h,act_h))
        if has_h {
            s.place_slot_local(s.slot_of(id,SLOT_HEADER),&layout.Rect{x: area.x,y: top,width: hdr_w,height: row_h})
        }
        if has_a {
            s.place_slot_local(s.slot_of(id,SLOT_ACTIONS),&layout.Rect{x: area.x + area.width - act_w,y: top,width: act_w,height: row_h})
        }
        top += row_h
        if has_m || has_b || has_f { top += gap }
    }
    if has_m && top < bottom {
        mh := s.slot_of(id,SLOT_MEDIA)
        med_h := math.min(math.max(0.0,bottom - top),s.slot_host_natural_height_styled(id,mh,SLOT_MEDIA,area.width,120.0 * styles.density,styles))
        s.place_slot_local(mh,&layout.Rect{x: area.x,y: top,width: area.width,height: med_h})
        top += med_h
        if has_b || has_f { top += gap }
    }
    if has_f && top < bottom {
        fh := s.slot_of(id,SLOT_FOOTER)
        ftr_h := math.min(math.max(0.0,bottom - top),s.slot_host_natural_height_styled(id,fh,SLOT_FOOTER,area.width,36.0 * styles.density,styles))
        bottom -= ftr_h
        s.place_slot_local(fh,&layout.Rect{x: area.x,y: bottom,width: area.width,height: ftr_h})
        if has_b { bottom -= gap }
    }
    if has_b {
        bh := s.slot_of(id,SLOT_BODY)
        s.place_slot_local(bh,&layout.Rect{x: area.x,y: top,width: area.width,height: math.max(0.0,bottom - top)})
    }
    << 0
}

fn (s $&Screen) layout_card_slots(id int) int {
    styles := s.styles_for(id)
    << s.layout_card_slots_styled(id,&styles) or >>
}

fn (s $&Screen) layout_modal_slots_styled(id int,styles &Styles) int {
    has_h := s.has_slot(id,SLOT_HEADER)
    has_b := s.has_slot(id,SLOT_BODY)
    has_f := s.has_slot(id,SLOT_FOOTER)
    has_a := s.has_slot(id,SLOT_ACTIONS)
    if !has_h && !has_b && !has_f && !has_a { << 0 }
    d := styles.density
    bounds := s.nodes[id - 1].bounds
    pad := 20.0 * d
    gap := 12.0 * d
    inner_w := math.max(0.0,bounds.width - pad * 2.0)
    $top := pad
    $bottom := math.max(pad,bounds.height - pad)
    if has_h {
        hh := s.slot_of(id,SLOT_HEADER)
        hdr_w := math.max(0.0,inner_w - 36.0 * d)
        hdr_h := math.min(math.max(0.0,bottom - top),s.slot_host_natural_height_styled(id,hh,SLOT_HEADER,hdr_w,32.0 * d,styles))
        s.place_slot_local(hh,&layout.Rect{x: pad,y: top,width: hdr_w,height: hdr_h})
        top += hdr_h + gap
    } else if s.texts[id - 1].len > 0 || s.descriptions[id - 1].len > 0 {
        tb := s.modal_title_bounds(id,styles) or >>
        mb := s.modal_message_bounds(id,styles) or >>
        reserved := mb.y + mb.height - bounds.y + gap
        top = math.max(top,reserved)
    }
    if has_f || has_a {
        $act_w := 0.0
        $act_h := 0.0
        if has_a {
            ah := s.slot_of(id,SLOT_ACTIONS)
            act_w = math.min(inner_w,s.slot_host_natural_width_styled(id,ah,SLOT_ACTIONS,44.0 * d,140.0 * d,styles))
            act_h = s.slot_host_natural_height_styled(id,ah,SLOT_ACTIONS,act_w,36.0 * d,styles)
        }
        $ftr_h := 0.0
        if has_f {
            fh := s.slot_of(id,SLOT_FOOTER)
            $ftr_w := inner_w
            if has_a { ftr_w = math.max(0.0,inner_w - act_w - gap) }
            ftr_h = s.slot_host_natural_height_styled(id,fh,SLOT_FOOTER,ftr_w,36.0 * d,styles)
        }
        row_h := math.min(math.max(0.0,bottom - top),math.max(act_h,ftr_h))
        bottom -= row_h
        if has_f {
            $ftr_w := inner_w
            if has_a { ftr_w = math.max(0.0,inner_w - act_w - gap) }
            s.place_slot_local(s.slot_of(id,SLOT_FOOTER),&layout.Rect{x: pad,y: bottom,width: ftr_w,height: row_h})
        }
        if has_a {
            s.place_slot_local(s.slot_of(id,SLOT_ACTIONS),&layout.Rect{x: pad + inner_w - act_w,y: bottom,width: act_w,height: row_h})
        }
        if has_b { bottom -= gap }
    }
    if has_b {
        s.place_slot_local(s.slot_of(id,SLOT_BODY),&layout.Rect{x: pad,y: top,width: inner_w,height: math.max(0.0,bottom - top)})
    }
    << 0
}

fn (s $&Screen) layout_modal_slots(id int) int {
    styles := s.styles_for(id)
    << s.layout_modal_slots_styled(id,&styles) or >>
}

fn (s $&Screen) layout_popover_slots_styled(id int,styles &Styles) int {
    has_h := s.has_slot(id,SLOT_HEADER)
    has_c := s.has_slot(id,SLOT_CONTENT)
    has_f := s.has_slot(id,SLOT_FOOTER)
    if !has_h && !has_c && !has_f { << 0 }
    d := styles.density
    bounds := s.nodes[id - 1].bounds
    pad := 12.0 * d
    gap := 8.0 * d
    inner_w := math.max(0.0,bounds.width - pad * 2.0)
    $top := pad
    $bottom := math.max(pad,bounds.height - pad)
    if has_h {
        hh := s.slot_of(id,SLOT_HEADER)
        hdr_h := math.min(math.max(0.0,bottom - top),s.slot_host_natural_height_styled(id,hh,SLOT_HEADER,inner_w,28.0 * d,styles))
        s.place_slot_local(hh,&layout.Rect{x: pad,y: top,width: inner_w,height: hdr_h})
        top += hdr_h + gap
    }
    if has_f && top < bottom {
        fh := s.slot_of(id,SLOT_FOOTER)
        ftr_h := math.min(math.max(0.0,bottom - top),s.slot_host_natural_height_styled(id,fh,SLOT_FOOTER,inner_w,28.0 * d,styles))
        bottom -= ftr_h
        s.place_slot_local(fh,&layout.Rect{x: pad,y: bottom,width: inner_w,height: ftr_h})
        if has_c { bottom -= gap }
    }
    if has_c {
        s.place_slot_local(s.slot_of(id,SLOT_CONTENT),&layout.Rect{x: pad,y: top,width: inner_w,height: math.max(0.0,bottom - top)})
    }
    << 0
}

fn (s $&Screen) layout_popover_slots(id int) int {
    styles := s.styles_for(id)
    << s.layout_popover_slots_styled(id,&styles) or >>
}

fn (s &Screen) tabs_bar_bounds_styled(id int,styles &Styles) layout.Rect {
    b := s.nodes[id - 1].bounds
    if !s.has_indexed_slots(id) { << copy_rect(&b) }
    d := styles.density
    explicit := s.slot_extent(id,SLOT_HEADER)
    $bar_h := math.max(36.0 * d,29.0 * styles.text_scale)
    if explicit > 0.0 { bar_h = explicit }
    bar_h = math.min(b.height,bar_h)
    << layout.Rect{x: b.x,y: b.y,width: b.width,height: bar_h}
}

fn (s &Screen) tabs_bar_bounds(id int) layout.Rect {
    b := s.nodes[id - 1].bounds
    if !s.has_indexed_slots(id) { << copy_rect(&b) }
    idx := s.style_index_for(id)
    if idx < 0 { << s.tabs_bar_bounds_styled(id,&s.styles) }
    << s.tabs_bar_bounds_styled(id,&s.composition.subtree_style_values[idx])
}

fn (s $&Screen) sync_tab_slots(id int) int {
    if !s.has_indexed_slots(id) || !s.basics.tabs.has(id) { << 0 }
    sel := s.basics.tabs[id].selected()
    count := s.basics.tabs[id].count()
    for i in 0:count {
        host := s.slot_at_of(id,i)
        if host > 0 { s.set_visible(host,i == sel) or >> }
    }
    << 0
}

fn (s $&Screen) layout_tabs_slots_styled(id int,styles &Styles) int {
    if !s.has_indexed_slots(id) || !s.basics.tabs.has(id) { << 0 }
    d := styles.density
    b := s.nodes[id - 1].bounds
    bar := s.tabs_bar_bounds_styled(id,styles)
    gap := 8.0 * d
    py := math.min(b.height,bar.height + gap)
    ph := math.max(0.0,b.height - py)
    panel := layout.Rect{x: 0.0,y: py,width: b.width,height: ph}
    count := s.basics.tabs[id].count()
    sel := s.basics.tabs[id].selected()
    for i in 0:count {
        host := s.slot_at_of(id,i)
        if host > 0 {
            s.place_slot_local(host,&panel)
            s.set_visible(host,i == sel) or >>
        }
    }
    << 0
}

fn (s $&Screen) layout_tabs_slots(id int) int {
    styles := s.styles_for(id)
    << s.layout_tabs_slots_styled(id,&styles) or >>
}

fn (s $&Screen) layout_scroll_slot_styled(id int,styles &Styles) int {
    if !s.basics.scrolls.has(id) { << 0 }
    has_c := s.has_slot(id,SLOT_CONTENT)
    auto_ext := s.composition.auto_scrolls.get_or(id,false)
    if !has_c && !auto_ext { << 0 }
    sc_ref := &s.basics.scrolls[id]
    axis := sc_ref.axis()
    clip := sc_ref.content_bounds()
    $extent := 0.0
    if has_c {
        host := s.slot_of(id,SLOT_CONTENT)
        if axis == AXIS_VERTICAL {
            measured := s.measure_constrained_styled(host,clip.width,4096.0,styles) or >>
            extent = math.max(clip.height,measured.height)
            s.place_slot_local(host,&layout.Rect{x: 0.0,y: 0.0,width: clip.width,height: extent})
        } else {
            measured := s.measure_constrained_styled(host,4096.0,clip.height,styles) or >>
            extent = math.max(clip.width,measured.width)
            s.place_slot_local(host,&layout.Rect{x: 0.0,y: 0.0,width: extent,height: clip.height})
        }
    } else if auto_ext {
        child_count := s.child_count_of(id)
        for i in 0:child_count {
            c := s.child_at_of(id,i)
            if c > 0 && c <= s.nodes.len && s.nodes[c - 1].kind >= 0 && s.nodes[c - 1].parent == id && s.is_visible(c) {
                if axis == AXIS_VERTICAL {
                    extent = math.max(extent,s.nodes[c - 1].local.y + s.nodes[c - 1].local.height)
                } else {
                    extent = math.max(extent,s.nodes[c - 1].local.x + s.nodes[c - 1].local.width)
                }
            }
        }
    }
    if auto_ext {
        s.scroll_update_styled(id,5,&screen_empty(),styles,extent) or >>
    }
    << 0
}

fn (s $&Screen) layout_scroll_slot(id int) int {
    styles := s.styles_for(id)
    << s.layout_scroll_slot_styled(id,&styles) or >>
}

fn (s $&Screen) layout_custom_slot_rects_styled(id int,styles &Styles) int {
    if !s.composition.customs.has(id) { << 0 }
    bounds := s.nodes[id - 1].bounds
    rects := s.custom_layout_slots(id,&bounds,styles)
    for i in 0:rects.len {
        sr := rects[i]
        $host := 0
        if sr.is_indexed { host = s.slot_at_of(id,sr.key) }
        else { host = s.slot_of(id,sr.key) }
        if host > 0 { s.place_slot_local(host,&sr.rect) }
    }
    << 0
}

fn (s $&Screen) layout_custom_slot_rects(id int) int {
    styles := s.styles_for(id)
    << s.layout_custom_slot_rects_styled(id,&styles) or >>
}
