@ui/widgets

#ui
#ui/layout

pub const INPUT_PHASE_CAPTURE = 1
pub const INPUT_PHASE_BUBBLE = 2

pub struct InputHookContext {
    pub id int
    pub bounds layout.Rect
    pub local_x f64
    pub local_y f64
    pub hovered bool
    pub hovered_within bool
    pub focused bool
    pub focused_within bool
    pub phase int
}

fn default_input_hook_fn(ctx &InputHookContext,input &ui.InputEvent) Action {
    _ := ctx
    _ := input
    << Action{kind: ACTION_NONE,id: 0,needs_paint: false,request_focus: false,consumed: false,value: 0.0}
}

struct NodeInputHook {
    capture_fn fn (&InputHookContext,&ui.InputEvent) Action
    bubble_fn fn (&InputHookContext,&ui.InputEvent) Action
    has_capture bool
    has_bubble bool
}

fn default_node_input_hook() NodeInputHook {
    << NodeInputHook{
        capture_fn: default_input_hook_fn,
        bubble_fn: default_input_hook_fn,
        has_capture: false,
        has_bubble: false
    }
}

fn copy_node_input_hook(h &NodeInputHook) NodeInputHook {
    << NodeInputHook{
        capture_fn: h.capture_fn,
        bubble_fn: h.bubble_fn,
        has_capture: h.has_capture,
        has_bubble: h.has_bubble
    }
}

pub fn (s $&Screen) set_input_capture(id int,f fn (&InputHookContext,&ui.InputEvent) Action) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    hooks := $&comp.input_hooks
    had := hooks.has(id)
    $h := default_node_input_hook()
    if had {
        prev := hooks.take(id)
        h = copy_node_input_hook(&prev)
    }
    h.capture_fn = f
    h.has_capture = true
    hooks[id] = h
    if !had { comp.input_hook_count = comp.input_hook_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_input_capture(id int) int {
    _ := s.node(id) >>>
    if !s.composition.input_hooks.has(id) { << 0 }
    comp := $&s.composition
    hooks := $&comp.input_hooks
    $h := hooks.take(id)
    if !h.has_bubble {
        if comp.input_hook_count > 0 { comp.input_hook_count = comp.input_hook_count - 1 }
        << 0
    }
    h.capture_fn = default_input_hook_fn
    h.has_capture = false
    hooks[id] = h
    << 0
}

pub fn (s $&Screen) set_input_bubble(id int,f fn (&InputHookContext,&ui.InputEvent) Action) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    hooks := $&comp.input_hooks
    had := hooks.has(id)
    $h := default_node_input_hook()
    if had {
        prev := hooks.take(id)
        h = copy_node_input_hook(&prev)
    }
    h.bubble_fn = f
    h.has_bubble = true
    hooks[id] = h
    if !had { comp.input_hook_count = comp.input_hook_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_input_bubble(id int) int {
    _ := s.node(id) >>>
    if !s.composition.input_hooks.has(id) { << 0 }
    comp := $&s.composition
    hooks := $&comp.input_hooks
    $h := hooks.take(id)
    if !h.has_capture {
        if comp.input_hook_count > 0 { comp.input_hook_count = comp.input_hook_count - 1 }
        << 0
    }
    h.bubble_fn = default_input_hook_fn
    h.has_bubble = false
    hooks[id] = h
    << 0
}

pub fn (s $&Screen) clear_input_hooks(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.input_hooks.has(id) {
        hooks := $&comp.input_hooks
        hooks.delete(id)
        if comp.input_hook_count > 0 { comp.input_hook_count = comp.input_hook_count - 1 }
    }
    << 0
}

pub fn (s &Screen) has_input_hooks(id int) bool {
    _ := s.node(id) >>>
    << s.composition.input_hook_count > 0 && s.composition.input_hooks.has(id)
}

fn (s &Screen) node_has_input_hook(id int) bool {
    << s.composition.input_hook_count > 0 && s.composition.input_hooks.has(id)
}

fn (s &Screen) ancestor_chain_to_root(target int) []int {
    $chain := []int{}
    if target <= 0 || target > s.nodes.len { << chain }
    $cur := target
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        chain.push(cur)
        if n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << chain
}

fn (s &Screen) make_input_hook_context(id int,local_ev &ui.InputEvent,phase int) InputHookContext {
    n := s.nodes[id - 1]
    b := layout.Rect{x: n.bounds.x,y: n.bounds.y,width: n.bounds.width,height: n.bounds.height}
    << InputHookContext{
        id: id,
        bounds: b,
        local_x: local_ev.x - b.x,
        local_y: local_ev.y - b.y,
        hovered: s.hovered == id,
        hovered_within: s.hovered > 0 && (s.hovered == id || s.is_descendant(s.hovered,id)),
        focused: s.focused == id,
        focused_within: s.focused > 0 && (s.focused == id || s.is_descendant(s.focused,id)),
        phase: phase
    }
}

fn (s $&Screen) run_input_capture_chain(target int,input &ui.InputEvent,actions $&[]Action) bool {
    if s.composition.input_hook_count == 0 || target <= 0 { << false }
    chain := s.ancestor_chain_to_root(target)
    $i := chain.len - 1
    while i >= 0 {
        cid := chain[i]
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.composition.input_hooks.has(cid) {
            hook := copy_node_input_hook(&s.composition.input_hooks[cid])
            if hook.has_capture {
                local_ev := s.event_in_node_space(cid,input)
                ctx := s.make_input_hook_context(cid,&local_ev,INPUT_PHASE_CAPTURE)
                f := hook.capture_fn
                a := f(&ctx,&local_ev)
                s.accept(a,actions) >>> (err) { << true }
                if a.consumed { << true }
            }
        }
        i -= 1
    }
    << false
}

fn (s $&Screen) run_input_bubble_chain(target int,input &ui.InputEvent,actions $&[]Action) bool {
    if s.composition.input_hook_count == 0 || target <= 0 { << false }
    chain := s.ancestor_chain_to_root(target)
    for i in 0:chain.len {
        cid := chain[i]
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.composition.input_hooks.has(cid) {
            hook := copy_node_input_hook(&s.composition.input_hooks[cid])
            if hook.has_bubble {
                local_ev := s.event_in_node_space(cid,input)
                ctx := s.make_input_hook_context(cid,&local_ev,INPUT_PHASE_BUBBLE)
                f := hook.bubble_fn
                a := f(&ctx,&local_ev)
                s.accept(a,actions) >>> (err) { << true }
                if a.consumed { << true }
            }
        }
    }
    << false
}

fn (s $&Screen) cleanup_input_hooks_for(id int) {
    comp := $&s.composition
    if comp.input_hooks.has(id) {
        hooks := $&comp.input_hooks
        hooks.delete(id)
        if comp.input_hook_count > 0 { comp.input_hook_count = comp.input_hook_count - 1 }
    }
}
