@ui/widgets

#ui/draw
#ui/layout
#ui/internal/codec
#errors
#strings

pub const PAINT_BACKGROUND = 1
pub const PAINT_FOREGROUND = 2
pub const PAINT_BORDER = 4
pub const PAINT_FOCUS = 8
pub const PAINT_SELECTION = 16
pub const PAINT_SELECTION_TEXT = 32
pub const PAINT_PLACEHOLDER = 64
pub const PAINT_ICON_OPACITY = 128
// Rules match combined states and apply in declaration order. `unless` excludes
// states such as disabled; only fields named by the bit mask are overridden.
pub struct StatePaint {
    pub when int
    pub unless int
    pub fields int
    pub background draw.Color
    pub foreground draw.Color
    pub border draw.Color
    pub focus draw.Color
    pub selection draw.Color
    pub selection_text draw.Color
    pub placeholder draw.Color
    pub icon_opacity f64
}
pub fn state_paint(when int) StatePaint {
    zero := draw.rgba(0,0,0,0)
    << StatePaint{when: when,unless: 0,fields: 0,background: zero,foreground: zero,border: zero,focus: zero,
        selection: zero,selection_text: zero,placeholder: zero,icon_opacity: 1.0}
}
pub struct ResolvedStyle {
    pub background draw.Color
    pub foreground draw.Color
    pub border draw.Color
    pub focus draw.Color
    pub selection draw.Color
    pub selection_text draw.Color
    pub placeholder draw.Color
    pub icon_opacity f64
}
pub fn (c &ControlStyle) resolve(state int) ResolvedStyle {
    $border := c.palette.border
    if (state & STATE_INVALID) != 0 { border = c.palette.invalid }
    $opacity := c.icon_opacity
    if (state & STATE_DISABLED) != 0 { opacity = opacity * c.disabled_icon_opacity }
    $result := ResolvedStyle{background: state_fill(&c.palette,state),foreground: state_ink(&c.palette,state),border: border,
        focus: c.palette.focus,selection: c.palette.selection,selection_text: c.palette.selection_text,placeholder: c.palette.placeholder,icon_opacity: opacity}
    for rule in c.states {
        if (state & rule.when) == rule.when && (state & rule.unless) == 0 {
            if (rule.fields & PAINT_BACKGROUND) != 0 { result.background = rule.background }
            if (rule.fields & PAINT_FOREGROUND) != 0 { result.foreground = rule.foreground }
            if (rule.fields & PAINT_BORDER) != 0 { result.border = rule.border }
            if (rule.fields & PAINT_FOCUS) != 0 { result.focus = rule.focus }
            if (rule.fields & PAINT_SELECTION) != 0 { result.selection = rule.selection }
            if (rule.fields & PAINT_SELECTION_TEXT) != 0 { result.selection_text = rule.selection_text }
            if (rule.fields & PAINT_PLACEHOLDER) != 0 { result.placeholder = rule.placeholder }
            if (rule.fields & PAINT_ICON_OPACITY) != 0 { result.icon_opacity = rule.icon_opacity }
        }
    }
    << result
}
fn validate_states(c &ControlStyle) int {
    if c.states.len > 32 { >> errors.new("widgets: too many state paint rules") }
    for rule in c.states {
        if rule.when < 0 || rule.when > 127 || rule.unless < 0 || rule.unless > 127 || (rule.when & rule.unless) != 0 ||
           rule.fields < 0 || rule.fields > 255 || !finite_metric(rule.icon_opacity,1.0) { >> errors.new("widgets: invalid state paint rule") }
    }
    << 0
}
fn copy_states(c &ControlStyle) []StatePaint {
    $result := []StatePaint{}
    for rule in c.states { result.push(rule) }
    << result
}
fn states_equal(a &ControlStyle,b &ControlStyle) bool {
    if a.states.len != b.states.len { << false }
    for i in 0:a.states.len {
        x := a.states[i]
        y := b.states[i]
        if x.when != y.when || x.unless != y.unless || x.fields != y.fields || x.icon_opacity != y.icon_opacity ||
           x.background.value() != y.background.value() || x.foreground.value() != y.foreground.value() || x.border.value() != y.border.value() ||
           x.focus.value() != y.focus.value() || x.selection.value() != y.selection.value() || x.selection_text.value() != y.selection_text.value() ||
           x.placeholder.value() != y.placeholder.value() { << false }
    }
    << true
}
fn write_style_color(buf $&strings.ByteBuilder,color draw.Color) {
    codec.word(buf,color.value(),4)
}
fn read_style_color(data &string,offset int) draw.Color {
    v := codec.read_word32(data,offset)
    << draw.rgba((v >> 24) & 255,(v >> 16) & 255,(v >> 8) & 255,v & 255)
}
fn write_style_f64(buf $&strings.ByteBuilder,value f64) {
    codec.word(buf,codec.finite_f64_bits(value),8)
}
fn read_style_f64(data &string,offset int) f64 {
    << codec.read_float64(data,offset) or (err) { << 0.0 }
}
fn encode_control_style(c &ControlStyle) string {
    $buf := strings.new_byte_builder(300 + c.states.len * 48 + c.font.family.len)
    p := c.palette
    for col in [p.normal,p.hovered,p.pressed,p.disabled,p.foreground,p.muted,p.accent,p.on_accent,
                p.focus,p.border,p.invalid,p.invalid_fill,p.read_only,p.selection,p.selection_text,p.placeholder,c.shadow] {
        write_style_color($&buf,col)
    }
    for val in [c.font.size,c.font.line_height,c.padding.left,c.padding.top,c.padding.right,c.padding.bottom,
                c.radius,c.border_width,c.focus_width,c.focus_inset,c.min_width,c.min_height,c.gap,
                c.indicator_size,c.mark_width,c.caret_width,c.preedit_width,c.shadow_x,c.shadow_y,
                c.shadow_spread,c.shadow_blur,c.align_x,c.align_y,c.icon_size,c.icon_opacity,c.disabled_icon_opacity] {
        write_style_f64($&buf,val)
    }
    $italic := 0
    if c.font.italic { italic = 1 }
    $inherit := 0
    if c.inherit_font { inherit = 1 }
    for word in [c.font.weight,italic,inherit,c.icon_placement,c.font.family.len,c.states.len] {
        codec.word($&buf,word,4)
    }
    for rule in c.states {
        codec.word($&buf,rule.when,4)
        codec.word($&buf,rule.unless,4)
        codec.word($&buf,rule.fields,4)
        for col in [rule.background,rule.foreground,rule.border,rule.focus,rule.selection,rule.selection_text,rule.placeholder] {
            write_style_color($&buf,col)
        }
        write_style_f64($&buf,rule.icon_opacity)
    }
    buf.write_str(c.font.family)
    << buf.to_string()
}
fn decode_control_style(data &string,fallback &ControlStyle) ControlStyle {
    if data.len < 300 { << fallback.clone() }
    family_len := codec.read_word32(data,292)
    states_len := codec.read_word32(data,296)
    if family_len < 0 || states_len < 0 || states_len > 32 || data.len != 300 + states_len * 48 + family_len {
        << fallback.clone()
    }
    p := Palette{
        normal: read_style_color(data,0),hovered: read_style_color(data,4),pressed: read_style_color(data,8),
        disabled: read_style_color(data,12),foreground: read_style_color(data,16),muted: read_style_color(data,20),
        accent: read_style_color(data,24),on_accent: read_style_color(data,28),focus: read_style_color(data,32),
        border: read_style_color(data,36),invalid: read_style_color(data,40),invalid_fill: read_style_color(data,44),
        read_only: read_style_color(data,48),selection: read_style_color(data,52),selection_text: read_style_color(data,56),
        placeholder: read_style_color(data,60)}
    shadow := read_style_color(data,64)
    family_start := 300 + states_len * 48
    font := FontStyle{
        family: data[family_start:family_start + family_len],
        size: read_style_f64(data,68),
        weight: codec.read_word32(data,276),
        italic: codec.read_word32(data,280) != 0,
        line_height: read_style_f64(data,76)}
    padding := layout.Insets{
        left: read_style_f64(data,84),top: read_style_f64(data,92),
        right: read_style_f64(data,100),bottom: read_style_f64(data,108)}
    $states := []StatePaint{}
    for i in 0:states_len {
        base := 300 + i * 48
        states.push(StatePaint{
            when: codec.read_word32(data,base),
            unless: codec.read_word32(data,base + 4),
            fields: codec.read_word32(data,base + 8),
            background: read_style_color(data,base + 12),
            foreground: read_style_color(data,base + 16),
            border: read_style_color(data,base + 20),
            focus: read_style_color(data,base + 24),
            selection: read_style_color(data,base + 28),
            selection_text: read_style_color(data,base + 32),
            placeholder: read_style_color(data,base + 36),
            icon_opacity: read_style_f64(data,base + 40)})
    }
    << ControlStyle{
        palette: p,font: font,inherit_font: codec.read_word32(data,284) != 0,padding: padding,
        radius: read_style_f64(data,116),border_width: read_style_f64(data,124),
        focus_width: read_style_f64(data,132),focus_inset: read_style_f64(data,140),
        min_width: read_style_f64(data,148),min_height: read_style_f64(data,156),
        gap: read_style_f64(data,164),indicator_size: read_style_f64(data,172),
        mark_width: read_style_f64(data,180),caret_width: read_style_f64(data,188),
        preedit_width: read_style_f64(data,196),shadow_x: read_style_f64(data,204),
        shadow_y: read_style_f64(data,212),shadow_spread: read_style_f64(data,220),
        shadow_blur: read_style_f64(data,228),align_x: read_style_f64(data,236),
        align_y: read_style_f64(data,244),icon_size: read_style_f64(data,252),
        icon_placement: codec.read_word32(data,288),
        icon_opacity: read_style_f64(data,260),disabled_icon_opacity: read_style_f64(data,268),
        shadow: shadow,states: states}
}
// Own the complete checked style encoding. No state rules or UTF-8 family
// names are silently truncated when an instance overrides its theme.
struct ScalarControlStyle {
    active bool
    encoded string
}
fn empty_scalar_style() ScalarControlStyle {
    << ScalarControlStyle{active: false,encoded: ""}
}
fn pack_scalar_style(c &ControlStyle) ScalarControlStyle {
    << ScalarControlStyle{active: true,encoded: encode_control_style(c)}
}
fn unpack_scalar_style(s &ScalarControlStyle) ControlStyle {
    fallback := dark_styles()
    << decode_control_style(&s.encoded,&fallback.button)
}
