@ui/widgets

// These controls own their complete instance style. Explicit clones are safe
// snapshots for measuring or painting while a containing model is borrowed.
fn copy_scalar_style(style &ScalarControlStyle) ScalarControlStyle {
    << ScalarControlStyle{active: style.active,encoded: style.encoded + ""}
}
pub fn (b &Button) clone() Button {
    custom := copy_scalar_style(&b.custom)
    << Button{id: b.id,identity: copy_identity(&b.identity),bounds: copy_rect(&b.bounds),enabled: b.enabled,
        focused: b.focused,hovered: b.hovered,pointer_armed: b.pointer_armed,keyboard_armed: b.keyboard_armed,
        dirty: b.dirty,closed: b.closed,invalid: b.invalid,selected: b.selected,read_only: b.read_only,custom: custom}
}
pub fn (r &Radio) clone() Radio {
    control := r.control.clone()
    custom := copy_scalar_style(&r.custom)
    << Radio{mark: r.mark,control: control,option_val: r.option_val,checked: r.checked,custom: custom}
}
pub fn (c &Checkbox) clone() Checkbox {
    control := c.control.clone()
    custom := copy_scalar_style(&c.custom)
    << Checkbox{mark: c.mark,control: control,checked: c.checked,indeterminate: c.indeterminate,custom: custom}
}

pub fn (value &Switch) clone() Switch {
    copy_control := value.control.clone()
    copy_custom := copy_scalar_style(&value.custom)
    << Switch{pending: value.pending,activity: value.activity,activity_reduced: value.activity_reduced,position: value.position,
        motion: value.motion,
        motion_ready: value.motion_ready,
        control: copy_control,
        checked: value.checked,
        custom: copy_custom}
}

pub fn (value &Slider) clone() Slider {
    copy_custom := copy_scalar_style(&value.custom)
    << Slider{locale: value.locale + "",appearance: value.appearance,id: value.id,
        identity: value.identity,
        bounds: value.bounds,
        min_val: value.min_val,
        max_val: value.max_val,
        step_val: value.step_val,
        val: value.val,
        enabled: value.enabled,
        focused: value.focused,
        hovered: value.hovered,
        dragging: value.dragging,
        commit_only: value.commit_only,
        pending: value.pending,
        committed: value.committed,
        thumb_extent: value.thumb_extent,
        inset_left: value.inset_left,
        inset_right: value.inset_right,
        dirty: value.dirty,
        closed: value.closed,
        invalid: value.invalid,
        read_only: value.read_only,
        custom: copy_custom}
}

pub fn (value &Stepper) clone() Stepper {
    copy_custom := copy_scalar_style(&value.custom)
    << Stepper{locale: value.locale.clone(),id: value.id,
        identity: value.identity,
        bounds: value.bounds,
        min_val: value.min_val,
        max_val: value.max_val,
        step_val: value.step_val,
        val: value.val,
        hovered_part: value.hovered_part,
        armed_part: value.armed_part,
        repeat_enabled: value.repeat_enabled,
        repeat_delay: value.repeat_delay,
        repeat_interval: value.repeat_interval,
        next_repeat: value.next_repeat,
        repeated: value.repeated,
        button_extent: value.button_extent,
        enabled: value.enabled,
        focused: value.focused,
        hovered: value.hovered,
        dirty: value.dirty,
        closed: value.closed,
        invalid: value.invalid,
        read_only: value.read_only,
        custom: copy_custom}
}

pub fn (value &Tabs) clone() Tabs {
    $widths := []f64{}
    for width in value.item_widths { widths.push(width) }
    copy_custom := copy_scalar_style(&value.custom)
    << Tabs{id: value.id,
        identity: value.identity,
        bounds: value.bounds,
        count_val: value.count_val,
        selected_val: value.selected_val,
        segmented_val: value.segmented_val,
        active_idx: value.active_idx,automatic: value.automatic,item_widths: widths,layout_density: value.layout_density,layout_padding: value.layout_padding,layout_gap: value.layout_gap,
        hovered_idx: value.hovered_idx,
        armed_idx: value.armed_idx,
        enabled: value.enabled,
        focused: value.focused,
        hovered: value.hovered,
        dirty: value.dirty,
        closed: value.closed,
        invalid: value.invalid,
        read_only: value.read_only,
        custom: copy_custom}
}

