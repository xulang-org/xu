pub fn (value &Scroll) clone() Scroll {
    << Scroll{id: value.id,
        identity: value.identity,
        bounds: value.bounds,
        axis: value.axis,
        content: value.content,
        offset: value.offset,
        enabled: value.enabled,
        focused: value.focused,
        dirty: value.dirty,
        closed: value.closed,
        appearance: value.appearance.clone(),
        density: value.density,
        styled: value.styled,
        bar_hovered: value.bar_hovered,
        dragging_bar: value.dragging_bar,
        drag_position: value.drag_position,
        drag_offset: value.drag_offset,
        invalid: value.invalid,
        custom_style: value.custom_style + ""}
}
