@ui/widgets

#ui/layout
#errors
#math
#time

pub const LAYOUT_TRANSITION_NONE = 0
pub const LAYOUT_TRANSITION_TIMED = 1
pub const LAYOUT_TRANSITION_SPRING = 2

pub struct LayoutTransition {
    pub mode int
    pub animate_size bool
    pub threshold f64
    pub spring SpringSpec
}

pub fn layout_transition() LayoutTransition {
    << LayoutTransition{
        mode: LAYOUT_TRANSITION_TIMED,
        animate_size: false,
        threshold: 0.5,
        spring: spring_spec()
    }
}

pub fn layout_transition_spring(spec &SpringSpec) LayoutTransition {
    << LayoutTransition{
        mode: LAYOUT_TRANSITION_SPRING,
        animate_size: false,
        threshold: 0.5,
        spring: SpringSpec{stiffness: spec.stiffness,damping: spec.damping,mass: spec.mass,precision: spec.precision}
    }
}

pub fn (lt &LayoutTransition) validate() int {
    if lt.mode < LAYOUT_TRANSITION_NONE || lt.mode > LAYOUT_TRANSITION_SPRING ||
       !finite_metric(lt.threshold,1000.0) {
        >> errors.new("widgets: invalid layout transition")
    }
    lt.spring.validate() >>>
    << 0
}

fn copy_layout_transition(lt &LayoutTransition) LayoutTransition {
    << LayoutTransition{
        mode: lt.mode,
        animate_size: lt.animate_size,
        threshold: lt.threshold,
        spring: SpringSpec{stiffness: lt.spring.stiffness,damping: lt.spring.damping,mass: lt.spring.mass,precision: lt.spring.precision}
    }
}

fn (s &Screen) visual_global_bounds(id int) layout.Rect {
    b := s.nodes[id - 1].bounds
    if s.composition.visual_transform_count == 0 || !s.composition.visual_transforms.has(id) {
        << layout.Rect{x: b.x,y: b.y,width: b.width,height: b.height}
    }
    vt := &s.composition.visual_transforms[id]
    << layout.Rect{
        x: b.x + vt.offset_x,
        y: b.y + vt.offset_y,
        width: b.width * vt.scale_x,
        height: b.height * vt.scale_y
    }
}

fn (s $&Screen) record_reparent_flip(id int,new_parent int) {
    if s.composition.layout_transition_count == 0 { << }
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 { << }
    tracked := s.composition.layout_transitions.has(id) ||
        (new_parent > 0 && s.composition.children_layout_transitions.has(new_parent))
    if !tracked { << }
    if s.is_visible(id) && !s.is_layout_hidden(id) && s.nodes[id - 1].bounds.width > 0.0 && s.nodes[id - 1].bounds.height > 0.0 {
        vg := s.visual_global_bounds(id)
        comp := $&s.composition
        pgf := $&comp.pending_global_flips
        pgf[id] = vg
    }
}

fn (s $&Screen) start_flip_transform(nid int,prev_rect &layout.Rect,curr_rect &layout.Rect,lt &LayoutTransition) int {
    cur_vt := s.visual_transform(nid) >>>
    inv_ox := math.max(-4096.0,math.min(4096.0,(prev_rect.x + cur_vt.offset_x) - curr_rect.x))
    inv_oy := math.max(-4096.0,math.min(4096.0,(prev_rect.y + cur_vt.offset_y) - curr_rect.y))
    $inv_sx := cur_vt.scale_x
    $inv_sy := cur_vt.scale_y
    if lt.animate_size && prev_rect.width > 0.0 && prev_rect.height > 0.0 {
        inv_sx = math.max(0.05,math.min(16.0,(prev_rect.width * cur_vt.scale_x) / curr_rect.width))
        inv_sy = math.max(0.05,math.min(16.0,(prev_rect.height * cur_vt.scale_y) / curr_rect.height))
    }
    inv_vt := VisualTransform{
        offset_x: inv_ox,offset_y: inv_oy,
        scale_x: inv_sx,scale_y: inv_sy,
        rotation: cur_vt.rotation,origin_x: 0.0,origin_y: 0.0
    }
    id_vt := VisualTransform{
        offset_x: 0.0,offset_y: 0.0,
        scale_x: 1.0,scale_y: 1.0,
        rotation: 0.0,origin_x: 0.0,origin_y: 0.0
    }
    if lt.mode == LAYOUT_TRANSITION_SPRING {
        $vox := 0.0
        $voy := 0.0
        $vsx := 0.0
        $vsy := 0.0
        $vrot := 0.0
        if s.composition.transform_transitions.has(nid) {
            prev_tr := &s.composition.transform_transitions[nid]
            if prev_tr.mode == 1 && prev_tr.active {
                vox = prev_tr.vel_ox
                voy = prev_tr.vel_oy
                vsx = prev_tr.vel_sx
                vsy = prev_tr.vel_sy
                vrot = prev_tr.vel_rot
            }
        }
        s.apply_visual_transform_internal(nid,&inv_vt)
        comp := $&s.composition
        tts := $&comp.transform_transitions
        tts[nid] = NodeTransformTransition{
            mode: 1,
            from_ox: inv_ox,from_oy: inv_oy,from_sx: inv_sx,from_sy: inv_sy,from_rot: cur_vt.rotation,
            cur_ox: inv_ox,cur_oy: inv_oy,cur_sx: inv_sx,cur_sy: inv_sy,cur_rot: cur_vt.rotation,
            to_ox: 0.0,to_oy: 0.0,to_sx: 1.0,to_sy: 1.0,to_rot: 0.0,
            vel_ox: vox,vel_oy: voy,vel_sx: vsx,vel_sy: vsy,vel_rot: vrot,
            origin_x: 0.0,origin_y: 0.0,
            stiffness: lt.spring.stiffness,damping: lt.spring.damping,mass: lt.spring.mass,precision: lt.spring.precision,
            delay_ns: 0,duration_ns: 0,elapsed_ns: 0,curve: EASE_OUT_QUART,
            end_visibility: -1,exiting: false,
            stamp: time.zero_instant(),active: true
        }
        vec_add_unique($&comp.transform_transition_ids,nid)
        s.mark_paint_dirty()
    } else {
        spec := s.motion_for(nid) >>>
        dur := spec.duration_for(MOTION_ROLE_CHANGE) >>>
        curve := spec.curve_for(MOTION_ROLE_CHANGE) >>>
        if dur.nanoseconds() > 0 {
            s.apply_visual_transform_internal(nid,&inv_vt)
            s.animate_transform(nid,&id_vt,dur,curve) >>>
        }
    }
    << 0
}

fn (s $&Screen) seed_flip_prev_bound(id int) {
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 { << }
    if s.is_visible(id) && !s.is_layout_hidden(id) && s.nodes[id - 1].local.width > 0.0 && s.nodes[id - 1].local.height > 0.0 &&
       s.nodes[id - 1].bounds.width > 0.0 && s.nodes[id - 1].bounds.height > 0.0 {
        comp := $&s.composition
        lpb := $&comp.layout_prev_bounds
        loc := s.nodes[id - 1].local
        lpb[id] = layout.Rect{x: loc.x,y: loc.y,width: loc.width,height: loc.height}
    }
}

fn (s &Screen) effective_layout_transition(id int) LayoutTransition {
    if s.composition.layout_transitions.has(id) {
        << copy_layout_transition(&s.composition.layout_transitions[id])
    }
    if id > 0 && id <= s.nodes.len {
        pid := s.nodes[id - 1].parent
        if pid > 0 && s.composition.children_layout_transitions.has(pid) {
            << copy_layout_transition(&s.composition.children_layout_transitions[pid])
        }
    }
    << LayoutTransition{mode: LAYOUT_TRANSITION_NONE,animate_size: false,threshold: 0.5,spring: spring_spec()}
}

fn (s $&Screen) flip_end_pass() int {
    if s.composition.layout_transition_count == 0 { << 0 }
    $targets := []int{}
    for i in 0:s.composition.layout_transition_ids.len {
        vec_add_unique($&targets,s.composition.layout_transition_ids[i])
    }
    for i in 0:s.composition.children_layout_transition_ids.len {
        pid := s.composition.children_layout_transition_ids[i]
        if pid <= 0 || pid > s.nodes.len || s.nodes[pid - 1].kind < 0 { -> }
        ccount := s.child_count_of(pid)
        for ci in 0:ccount {
            cid := s.child_at_of(pid,ci)
            if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == pid && !screen_is_overlay(s.nodes[cid - 1].kind) {
                vec_add_unique($&targets,cid)
            }
        }
    }
    for i in 0:targets.len {
        nid := targets[i]
        if nid <= 0 || nid > s.nodes.len || s.nodes[nid - 1].kind < 0 { -> }
        curr := s.nodes[nid - 1].local
        if !s.is_visible(nid) || s.is_layout_hidden(nid) || curr.width <= 0.0 || curr.height <= 0.0 {
            if s.composition.layout_prev_bounds.has(nid) {
                comp := $&s.composition
                lpb := $&comp.layout_prev_bounds
                lpb.delete(nid)
            }
            if s.composition.pending_global_flips.has(nid) {
                comp := $&s.composition
                pgf := $&comp.pending_global_flips
                pgf.delete(nid)
            }
            ->
        }
        if s.composition.pending_global_flips.has(nid) {
            comp := $&s.composition
            pgf := $&comp.pending_global_flips
            old_g := pgf.take(nid)
            lpb := $&comp.layout_prev_bounds
            lpb[nid] = layout.Rect{x: curr.x,y: curr.y,width: curr.width,height: curr.height}
            lt := s.effective_layout_transition(nid)
            new_g := s.nodes[nid - 1].bounds
            if lt.mode != LAYOUT_TRANSITION_NONE && !s.is_node_exiting(nid) && new_g.width > 0.0 && new_g.height > 0.0 {
                if s.reduced {
                    s.cancel_transform_transition(nid)
                    snap_vt := visual_transform()
                    s.apply_visual_transform_internal(nid,&snap_vt)
                } else {
                    moved := math.abs(old_g.x - new_g.x) >= lt.threshold || math.abs(old_g.y - new_g.y) >= lt.threshold
                    resized := lt.animate_size && old_g.width > 0.0 && old_g.height > 0.0 &&
                        (math.abs(old_g.width - new_g.width) >= lt.threshold || math.abs(old_g.height - new_g.height) >= lt.threshold)
                    if moved || resized {
                        inv_ox := math.max(-4096.0,math.min(4096.0,old_g.x - new_g.x))
                        inv_oy := math.max(-4096.0,math.min(4096.0,old_g.y - new_g.y))
                        $inv_sx := 1.0
                        $inv_sy := 1.0
                        if lt.animate_size && old_g.width > 0.0 && old_g.height > 0.0 {
                            inv_sx = math.max(0.05,math.min(16.0,old_g.width / new_g.width))
                            inv_sy = math.max(0.05,math.min(16.0,old_g.height / new_g.height))
                        }
                        s.start_direct_morph(nid,inv_ox,inv_oy,inv_sx,inv_sy,lt.mode == LAYOUT_TRANSITION_SPRING,&lt.spring) >>>
                    }
                }
            }
            ->
        }
        if !s.composition.layout_prev_bounds.has(nid) {
            comp := $&s.composition
            lpb := $&comp.layout_prev_bounds
            lpb[nid] = layout.Rect{x: curr.x,y: curr.y,width: curr.width,height: curr.height}
            ->
        }
        prev := s.composition.layout_prev_bounds[nid]
        if true {
            comp := $&s.composition
            lpb := $&comp.layout_prev_bounds
            lpb[nid] = layout.Rect{x: curr.x,y: curr.y,width: curr.width,height: curr.height}
        }
        lt := s.effective_layout_transition(nid)
        if lt.mode == LAYOUT_TRANSITION_NONE || s.is_node_exiting(nid) { -> }
        moved := math.abs(prev.x - curr.x) >= lt.threshold || math.abs(prev.y - curr.y) >= lt.threshold
        resized := lt.animate_size && prev.width > 0.0 && prev.height > 0.0 &&
            (math.abs(prev.width - curr.width) >= lt.threshold || math.abs(prev.height - curr.height) >= lt.threshold)
        if !moved && !resized { -> }
        if s.reduced {
            s.cancel_transform_transition(nid)
            snap_vt := visual_transform()
            s.apply_visual_transform_internal(nid,&snap_vt)
            ->
        }
        s.start_flip_transform(nid,&prev,&curr,&lt) >>>
    }
    << 0
}

fn (s $&Screen) start_direct_morph(nid int,inv_ox f64,inv_oy f64,inv_sx f64,inv_sy f64,use_spring bool,spec &SpringSpec) int {
    inv_vt := VisualTransform{
        offset_x: inv_ox,offset_y: inv_oy,
        scale_x: inv_sx,scale_y: inv_sy,
        rotation: 0.0,origin_x: 0.0,origin_y: 0.0
    }
    id_vt := VisualTransform{
        offset_x: 0.0,offset_y: 0.0,
        scale_x: 1.0,scale_y: 1.0,
        rotation: 0.0,origin_x: 0.0,origin_y: 0.0
    }
    if use_spring {
        s.cancel_transform_transition(nid)
        s.apply_visual_transform_internal(nid,&inv_vt)
        comp := $&s.composition
        tts := $&comp.transform_transitions
        tts[nid] = NodeTransformTransition{
            mode: 1,
            from_ox: inv_ox,from_oy: inv_oy,from_sx: inv_sx,from_sy: inv_sy,from_rot: 0.0,
            cur_ox: inv_ox,cur_oy: inv_oy,cur_sx: inv_sx,cur_sy: inv_sy,cur_rot: 0.0,
            to_ox: 0.0,to_oy: 0.0,to_sx: 1.0,to_sy: 1.0,to_rot: 0.0,
            vel_ox: 0.0,vel_oy: 0.0,vel_sx: 0.0,vel_sy: 0.0,vel_rot: 0.0,
            origin_x: 0.0,origin_y: 0.0,
            stiffness: spec.stiffness,damping: spec.damping,mass: spec.mass,precision: spec.precision,
            delay_ns: 0,duration_ns: 0,elapsed_ns: 0,curve: EASE_OUT_QUART,
            end_visibility: -1,exiting: false,
            stamp: time.zero_instant(),active: true
        }
        vec_add_unique($&comp.transform_transition_ids,nid)
        s.mark_paint_dirty()
        << 0
    }
    mspec := s.motion_for(nid) >>>
    dur := mspec.duration_for(MOTION_ROLE_CHANGE) >>>
    curve := mspec.curve_for(MOTION_ROLE_CHANGE) >>>
    if dur.nanoseconds() <= 0 {
        s.cancel_transform_transition(nid)
        s.apply_visual_transform_internal(nid,&id_vt)
        << 0
    }
    s.apply_visual_transform_internal(nid,&inv_vt)
    << s.animate_transform(nid,&id_vt,dur,curve) >>>
}

fn (s $&Screen) apply_morph_from_rect(id int,from_rect &layout.Rect,animate_size bool,use_spring bool,spec &SpringSpec) int {
    _ := s.node(id) >>>
    if !valid_signed_coord(from_rect.x) || !valid_signed_coord(from_rect.y) ||
       !finite_metric(from_rect.width,100000.0) || !finite_metric(from_rect.height,100000.0) {
        >> errors.new("widgets: invalid morph source rect")
    }
    if use_spring { spec.validate() >>> }
    s.layout_controls() >>>
    dst := s.nodes[id - 1].bounds
    if dst.width <= 0.0 || dst.height <= 0.0 { << 0 }
    if s.reduced {
        s.cancel_transform_transition(id)
        snap_vt := visual_transform()
        s.apply_visual_transform_internal(id,&snap_vt)
        << 0
    }
    inv_ox := math.max(-4096.0,math.min(4096.0,from_rect.x - dst.x))
    inv_oy := math.max(-4096.0,math.min(4096.0,from_rect.y - dst.y))
    $inv_sx := 1.0
    $inv_sy := 1.0
    if animate_size && from_rect.width > 0.0 && from_rect.height > 0.0 {
        inv_sx = math.max(0.05,math.min(16.0,from_rect.width / dst.width))
        inv_sy = math.max(0.05,math.min(16.0,from_rect.height / dst.height))
    }
    << s.start_direct_morph(id,inv_ox,inv_oy,inv_sx,inv_sy,use_spring,spec) >>>
}

pub fn (s $&Screen) morph_from_rect(id int,from_rect &layout.Rect,animate_size bool) int {
    sp := spring_spec()
    << s.apply_morph_from_rect(id,from_rect,animate_size,false,&sp) >>>
}

pub fn (s $&Screen) spring_morph_from_rect(id int,from_rect &layout.Rect,animate_size bool,spec &SpringSpec) int {
    << s.apply_morph_from_rect(id,from_rect,animate_size,true,spec) >>>
}

pub fn (s $&Screen) morph_from_node(dst_id int,src_id int,animate_size bool) int {
    _ := s.node(dst_id) >>>
    _ := s.node(src_id) >>>
    s.layout_controls() >>>
    src_rect := s.visual_global_bounds(src_id)
    sp := spring_spec()
    << s.apply_morph_from_rect(dst_id,&src_rect,animate_size,false,&sp) >>>
}

pub fn (s $&Screen) spring_morph_from_node(dst_id int,src_id int,animate_size bool,spec &SpringSpec) int {
    _ := s.node(dst_id) >>>
    _ := s.node(src_id) >>>
    spec.validate() >>>
    s.layout_controls() >>>
    src_rect := s.visual_global_bounds(src_id)
    << s.apply_morph_from_rect(dst_id,&src_rect,animate_size,true,spec) >>>
}

fn (s $&Screen) cleanup_layout_transitions_for(id int) {
    comp := $&s.composition
    if comp.layout_transitions.has(id) {
        lts := $&comp.layout_transitions
        lts.delete(id)
        comp.layout_transition_ids = vec_without(&comp.layout_transition_ids,id)
        if comp.layout_transition_count > 0 { comp.layout_transition_count = comp.layout_transition_count - 1 }
    }
    if comp.children_layout_transitions.has(id) {
        clts := $&comp.children_layout_transitions
        clts.delete(id)
        comp.children_layout_transition_ids = vec_without(&comp.children_layout_transition_ids,id)
        if comp.layout_transition_count > 0 { comp.layout_transition_count = comp.layout_transition_count - 1 }
    }
    if comp.layout_prev_bounds.has(id) {
        lpb := $&comp.layout_prev_bounds
        lpb.delete(id)
    }
    if comp.pending_global_flips.has(id) {
        pgf := $&comp.pending_global_flips
        pgf.delete(id)
    }
}

pub fn (s $&Screen) set_layout_transition(id int,cfg &LayoutTransition) int {
    _ := s.node(id) >>>
    cfg.validate() >>>
    if cfg.mode == LAYOUT_TRANSITION_NONE {
        << s.clear_layout_transition(id) >>>
    }
    comp := $&s.composition
    lts := $&comp.layout_transitions
    had := lts.has(id)
    lts[id] = copy_layout_transition(cfg)
    if !had {
        vec_add_unique($&comp.layout_transition_ids,id)
        comp.layout_transition_count = comp.layout_transition_count + 1
    }
    s.seed_flip_prev_bound(id)
    << 0
}

pub fn (s $&Screen) clear_layout_transition(id int) int {
    _ := s.node(id) >>>
    if s.composition.layout_transitions.has(id) {
        comp := $&s.composition
        lts := $&comp.layout_transitions
        lts.delete(id)
        comp.layout_transition_ids = vec_without(&comp.layout_transition_ids,id)
        if comp.layout_transition_count > 0 { comp.layout_transition_count = comp.layout_transition_count - 1 }
    }
    << 0
}

pub fn (s $&Screen) set_children_layout_transition(container int,cfg &LayoutTransition) int {
    _ := s.node(container) >>>
    cfg.validate() >>>
    if cfg.mode == LAYOUT_TRANSITION_NONE {
        << s.clear_children_layout_transition(container) >>>
    }
    comp := $&s.composition
    clts := $&comp.children_layout_transitions
    had := clts.has(container)
    clts[container] = copy_layout_transition(cfg)
    if !had {
        vec_add_unique($&comp.children_layout_transition_ids,container)
        comp.layout_transition_count = comp.layout_transition_count + 1
    }
    ccount := s.child_count_of(container)
    for ci in 0:ccount {
        cid := s.child_at_of(container,ci)
        if cid > 0 && cid <= s.nodes.len && s.nodes[cid - 1].kind >= 0 && s.nodes[cid - 1].parent == container {
            s.seed_flip_prev_bound(cid)
        }
    }
    << 0
}

pub fn (s $&Screen) clear_children_layout_transition(container int) int {
    _ := s.node(container) >>>
    if s.composition.children_layout_transitions.has(container) {
        comp := $&s.composition
        clts := $&comp.children_layout_transitions
        clts.delete(container)
        comp.children_layout_transition_ids = vec_without(&comp.children_layout_transition_ids,container)
        if comp.layout_transition_count > 0 { comp.layout_transition_count = comp.layout_transition_count - 1 }
    }
    << 0
}

pub fn (s &Screen) has_layout_transition(id int) bool {
    _ := s.node(id) >>>
    if s.composition.layout_transitions.has(id) { << true }
    pid := s.nodes[id - 1].parent
    << pid > 0 && s.composition.children_layout_transitions.has(pid)
}
