@ui/widgets
#errors

// Return an instance to inherited theme styling, including later theme changes.
pub fn (s &mut Screen) clear_control_style(id int) int {
    node := s.node(id) or >>
    if screen_visual_kind(node.kind) { << s.visual_clear_style(id) or >> }
    if node.kind == SCREEN_LABEL { owner := mut &s.basics
        items := mut &owner.label_styles
        if items.has(id) { _ := items.take(id) }
        s.dirty = true
        << 0 }
    if s.basics.scrolls.has(id) { owner := mut &s.basics
        items := mut &owner.scrolls
        mut item := items.take(id)
        item.clear_style()
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BUTTON { items := mut &s.buttons
        mut item := items.take(id)
        clear_button_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CHECKBOX { owner := mut &s.basics
        items := mut &owner.checks
        mut item := items.take(id)
        clear_checkbox_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SWITCH { owner := mut &s.basics
        items := mut &owner.switches
        mut item := items.take(id)
        clear_switch_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_RADIO { owner := mut &s.basics
        items := mut &owner.radios
        mut item := items.take(id)
        clear_radio_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SLIDER { owner := mut &s.basics
        items := mut &owner.sliders
        mut item := items.take(id)
        clear_slider_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_STEPPER { owner := mut &s.basics
        items := mut &owner.steppers
        mut item := items.take(id)
        clear_stepper_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TABS { owner := mut &s.basics
        items := mut &owner.tabs
        mut item := items.take(id)
        clear_tabs_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SELECT { owner := mut &s.basics
        items := mut &owner.selects
        mut item := items.take(id)
        clear_select_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_LIST { owner := mut &s.basics
        items := mut &owner.lists
        mut item := items.take(id)
        clear_list_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_PROGRESS { owner := mut &s.basics
        items := mut &owner.progresses
        mut item := items.take(id)
        clear_progress_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DIVIDER { owner := mut &s.basics
        items := mut &owner.dividers
        mut item := items.take(id)
        clear_divider_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BADGE { owner := mut &s.basics
        items := mut &owner.badges
        mut item := items.take(id)
        clear_badge_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CARD { owner := mut &s.basics
        items := mut &owner.cards
        mut item := items.take(id)
        clear_card_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_RADIO_GROUP { owner := mut &s.basics
        items := mut &owner.groups
        mut item := items.take(id)
        clear_radio_group_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TABLE { owner := mut &s.controls
        items := mut &owner.tables
        mut item := items.take(id)
        clear_table_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TREE { owner := mut &s.controls
        items := mut &owner.trees
        mut item := items.take(id)
        clear_tree_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_PAGINATION { owner := mut &s.controls
        items := mut &owner.pages
        mut item := items.take(id)
        clear_pagination_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BREADCRUMBS { owner := mut &s.controls
        items := mut &owner.crumbs
        mut item := items.take(id)
        clear_breadcrumbs_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COMBO { owner := mut &s.controls
        items := mut &owner.combos
        mut item := items.take(id)
        clear_combo_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_MULTI { owner := mut &s.controls
        items := mut &owner.multis
        mut item := items.take(id)
        clear_multi_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COLOR { owner := mut &s.controls
        items := mut &owner.colors
        mut item := items.take(id)
        clear_color_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DATE { owner := mut &s.controls
        items := mut &owner.dates
        mut item := items.take(id)
        clear_date_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CLOCK { owner := mut &s.controls
        items := mut &owner.clocks
        mut item := items.take(id)
        clear_clock_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SPINNER { owner := mut &s.controls
        items := mut &owner.spinners
        mut item := items.take(id)
        clear_spinner_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_EDITOR { owner := mut &s.controls
        items := mut &owner.editors
        mut item := items.take(id)
        clear_editor_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_FIELD { owner := mut &s.controls
        items := mut &owner.fields
        mut item := items.take(id)
        clear_field_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TASK { owner := mut &s.controls
        items := mut &owner.tasks
        mut item := items.take(id)
        clear_task_style(mut &item)
        items[id] = item
        s.dirty = true
        << 0 }
    >> errors.new("widgets: control does not support clearing a style")
}
fn clear_button_style(item &mut Button) { item.clear_style() }
fn clear_checkbox_style(item &mut Checkbox) { item.clear_style() }
fn clear_switch_style(item &mut Switch) { item.clear_style() }
fn clear_radio_style(item &mut Radio) { item.clear_style() }
fn clear_slider_style(item &mut Slider) { item.clear_style() }
fn clear_stepper_style(item &mut Stepper) { item.clear_style() }
fn clear_tabs_style(item &mut Tabs) { item.clear_style() }
fn clear_select_style(item &mut Select) { item.clear_style() }
fn clear_list_style(item &mut ListBox) { item.clear_style() }
fn clear_progress_style(item &mut Progress) { item.clear_style() }
fn clear_divider_style(item &mut Divider) { item.clear_style() }
fn clear_badge_style(item &mut Badge) { item.clear_style() }
fn clear_card_style(item &mut Card) { item.clear_style() }
fn clear_radio_group_style(item &mut RadioGroup) { control := mut &item.control
    control.clear_style() }
fn clear_table_style(item &mut Table) { item.clear_style() }
fn clear_tree_style(item &mut TreeView) { item.clear_style() }
fn clear_pagination_style(item &mut Pagination) { item.clear_style() }
fn clear_breadcrumbs_style(item &mut Breadcrumbs) { control := mut &item.control
    control.clear_style() }
fn clear_combo_style(item &mut ComboBox) { item.custom_style = ""
    item.editor.dirty = true }
fn clear_multi_style(item &mut MultiSelect) { control := mut &item.control
    control.clear_style() }
fn clear_color_style(item &mut ColorPicker) { control := mut &item.control
    control.clear_style() }
fn clear_date_style(item &mut DatePicker) { control := mut &item.control
    control.clear_style() }
fn clear_clock_style(item &mut TimePicker) { control := mut &item.control
    control.clear_style() }
fn clear_spinner_style(item &mut Spinner) { item.custom.active = false
    item.dirty = true }
fn clear_editor_style(item &mut Editor) { item.clear_style() }
fn clear_field_style(item &mut Field) { item.custom = ""
    item.mark_dirty(true) }
fn clear_task_style(item &mut TaskButton) { control := mut &item.control
    control.clear_style() }
