@ui/widgets
#errors

// Return an instance to inherited theme styling, including later theme changes.
pub fn (s $&Screen) clear_control_style(id int) int {
    node := s.node(id) or >>
    if screen_visual_kind(node.kind) { << s.visual_clear_style(id) or >> }
    if node.kind == SCREEN_LABEL { owner := $&s.basics
        items := $&owner.label_styles
        if items.has(id) { _ := items.take(id) }
        s.dirty = true
        << 0 }
    if s.basics.scrolls.has(id) { owner := $&s.basics
        items := $&owner.scrolls
        $item := items.take(id)
        item.clear_style()
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BUTTON { items := $&s.buttons
        $item := items.take(id)
        clear_button_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CHECKBOX { owner := $&s.basics
        items := $&owner.checks
        $item := items.take(id)
        clear_checkbox_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SWITCH { owner := $&s.basics
        items := $&owner.switches
        $item := items.take(id)
        clear_switch_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_RADIO { owner := $&s.basics
        items := $&owner.radios
        $item := items.take(id)
        clear_radio_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SLIDER { owner := $&s.basics
        items := $&owner.sliders
        $item := items.take(id)
        clear_slider_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_STEPPER { owner := $&s.basics
        items := $&owner.steppers
        $item := items.take(id)
        clear_stepper_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TABS { owner := $&s.basics
        items := $&owner.tabs
        $item := items.take(id)
        clear_tabs_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SELECT { owner := $&s.basics
        items := $&owner.selects
        $item := items.take(id)
        clear_select_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_LIST { owner := $&s.basics
        items := $&owner.lists
        $item := items.take(id)
        clear_list_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_PROGRESS { owner := $&s.basics
        items := $&owner.progresses
        $item := items.take(id)
        clear_progress_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DIVIDER { owner := $&s.basics
        items := $&owner.dividers
        $item := items.take(id)
        clear_divider_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BADGE { owner := $&s.basics
        items := $&owner.badges
        $item := items.take(id)
        clear_badge_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CARD { owner := $&s.basics
        items := $&owner.cards
        $item := items.take(id)
        clear_card_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_RADIO_GROUP { owner := $&s.basics
        items := $&owner.groups
        $item := items.take(id)
        clear_radio_group_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TABLE { owner := $&s.controls
        items := $&owner.tables
        $item := items.take(id)
        clear_table_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TREE { owner := $&s.controls
        items := $&owner.trees
        $item := items.take(id)
        clear_tree_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_PAGINATION { owner := $&s.controls
        items := $&owner.pages
        $item := items.take(id)
        clear_pagination_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_BREADCRUMBS { owner := $&s.controls
        items := $&owner.crumbs
        $item := items.take(id)
        clear_breadcrumbs_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COMBO { owner := $&s.controls
        items := $&owner.combos
        $item := items.take(id)
        clear_combo_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_MULTI { owner := $&s.controls
        items := $&owner.multis
        $item := items.take(id)
        clear_multi_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_COLOR { owner := $&s.controls
        items := $&owner.colors
        $item := items.take(id)
        clear_color_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_DATE { owner := $&s.controls
        items := $&owner.dates
        $item := items.take(id)
        clear_date_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_CLOCK { owner := $&s.controls
        items := $&owner.clocks
        $item := items.take(id)
        clear_clock_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_SPINNER { owner := $&s.controls
        items := $&owner.spinners
        $item := items.take(id)
        clear_spinner_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_EDITOR { owner := $&s.controls
        items := $&owner.editors
        $item := items.take(id)
        clear_editor_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_FIELD { owner := $&s.controls
        items := $&owner.fields
        $item := items.take(id)
        clear_field_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    if node.kind == SCREEN_TASK { owner := $&s.controls
        items := $&owner.tasks
        $item := items.take(id)
        clear_task_style($&item)
        items[id] = item
        s.dirty = true
        << 0 }
    >> errors.new("widgets: control does not support clearing a style")
}
fn clear_button_style(item $&Button) { item.clear_style() }
fn clear_checkbox_style(item $&Checkbox) { item.clear_style() }
fn clear_switch_style(item $&Switch) { item.clear_style() }
fn clear_radio_style(item $&Radio) { item.clear_style() }
fn clear_slider_style(item $&Slider) { item.clear_style() }
fn clear_stepper_style(item $&Stepper) { item.clear_style() }
fn clear_tabs_style(item $&Tabs) { item.clear_style() }
fn clear_select_style(item $&Select) { item.clear_style() }
fn clear_list_style(item $&ListBox) { item.clear_style() }
fn clear_progress_style(item $&Progress) { item.clear_style() }
fn clear_divider_style(item $&Divider) { item.clear_style() }
fn clear_badge_style(item $&Badge) { item.clear_style() }
fn clear_card_style(item $&Card) { item.clear_style() }
fn clear_radio_group_style(item $&RadioGroup) { control := $&item.control
    control.clear_style() }
fn clear_table_style(item $&Table) { item.clear_style() }
fn clear_tree_style(item $&TreeView) { item.clear_style() }
fn clear_pagination_style(item $&Pagination) { item.clear_style() }
fn clear_breadcrumbs_style(item $&Breadcrumbs) { control := $&item.control
    control.clear_style() }
fn clear_combo_style(item $&ComboBox) { item.custom_style = ""
    item.editor.dirty = true }
fn clear_multi_style(item $&MultiSelect) { control := $&item.control
    control.clear_style() }
fn clear_color_style(item $&ColorPicker) { control := $&item.control
    control.clear_style() }
fn clear_date_style(item $&DatePicker) { control := $&item.control
    control.clear_style() }
fn clear_clock_style(item $&TimePicker) { control := $&item.control
    control.clear_style() }
fn clear_spinner_style(item $&Spinner) { item.custom.active = false
    item.dirty = true }
fn clear_editor_style(item $&Editor) { item.clear_style() }
fn clear_field_style(item $&Field) { item.custom = ""
    item.mark_dirty(true) }
fn clear_task_style(item $&TaskButton) { control := $&item.control
    control.clear_style() }
