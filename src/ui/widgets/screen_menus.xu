@ui/widgets
#ui
#errors

// Labels, shortcut descriptions and action keys belong to the application.
// Context mode uses its placed bounds as the right-click target surface.
pub fn (s &mut Screen) menu(label string,items &[]MenuItem,mode int,primary_key int) int {
    id := s.add_node(SCREEN_MENU,true,ui.CURSOR_HAND) or >>
    item := menu(&s.context,&s.identity,id,&screen_empty(),label,items,mode,primary_key) or (err) { s.abandon_node(id)
        >> err }
    owner := mut &s.controls
    entries := mut &owner.menus
    entries[id] = item
    << id
}
pub fn (s &mut Screen) menu_checked(id int,key int) bool {
    node := s.node(id) or >>
    if node.kind != SCREEN_MENU { >> errors.new("widgets: expected Menu") }
    owner := mut &s.controls
    entries := mut &owner.menus
    item := entries.take(id)
    result := menu_checked_value(&item,key)
    entries[id] = item
    if result.error.len > 0 { >> errors.new(result.error) }
    << result.flag
}
fn menu_checked_value(item &Menu,key int) RefinedResult {
    mut result := refined_result()
    checked := item.checked(key) or (err) { << refined_failure(err.msg()) }
    result.flag = checked
    << result
}

pub fn (s &mut Screen) set_menu_items(id int,items &[]MenuItem) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_MENU { >> errors.new("widgets: expected Menu") }
    owner := mut &s.controls
    entries := mut &owner.menus
    mut item := entries.take(id)
    message := screen_set_menu_items(mut &item,items)
    entries[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_set_menu_items(item &mut Menu,items &[]MenuItem) string {
    item.set_items(items) or (err) { << err.msg() }
    << ""
}

