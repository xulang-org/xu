pub fn (s &mut Screen) set_menu_open(id int,open bool) int {
    node := s.node(id) or >>
    if node.kind != SCREEN_MENU { >> errors.new("widgets: expected Menu") }
    owner := mut &s.controls
    entries := mut &owner.menus
    mut item := entries.take(id)
    message := screen_set_menu_open(mut &item,open)
    entries[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.dirty = true
    << 0
}
fn screen_set_menu_open(item &mut Menu,open bool) string {
    if open { b := item.bounds()
        item.open_at(b.x,b.y,false) or (err) { << err.msg() } }
    else { item.close() or (err) { << err.msg() } }
    << ""
}

fn (s &mut Screen) menu_shortcut(event &ui.InputEvent,modal int) Action {
    for node in s.nodes { if node.kind == SCREEN_MENU && s.is_visible(node.id) && s.effective_enabled(node.id) && s.in_modal(node.id,modal) {
        owner := mut &s.controls
        entries := mut &owner.menus
        mut item := entries.take(node.id)
        result := screen_menu_shortcut(mut &item,event)
        entries[node.id] = item
        if result.error.len > 0 { >> errors.new(result.error) }
        s.dirty = s.dirty || result.changed
        if result.action.consumed { << result.action }
    } }
    << no_action(0,false)
}
fn screen_menu_shortcut(item &mut Menu,event &ui.InputEvent) RefinedResult {
    mut result := refined_result()
    result.action = item.shortcut(event) or (err) { << refined_failure(err.msg()) }
    result.changed = item.needs_paint()
    << result
}
