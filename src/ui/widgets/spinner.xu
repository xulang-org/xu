@ui/widgets

#ui/draw
#ui/layout
#time
#math
#errors

pub struct Spinner {
    bounds layout.Rect
    running bool
    enabled bool
    dirty bool
    phase f64
    period time.Duration
    diameter f64
    thickness f64
    last time.Instant
    reduced bool
    custom ScalarControlStyle
}
pub fn spinner(bounds &layout.Rect) Spinner {
    validate_bounds(bounds) or >>
    << Spinner{bounds: copy_rect(bounds),running: true,enabled: true,dirty: true,phase: 0.0,period: time.duration(time.second()),diameter: 24.0,thickness: 3.6,last: time.zero_instant(),reduced: false,custom: empty_scalar_style()}
}
pub fn (spinner &Spinner) is_running() bool { << spinner.running && spinner.enabled }
pub fn (spinner &Spinner) needs_paint() bool { << spinner.dirty }
pub fn (spinner &Spinner) bounds() layout.Rect { << copy_rect(&spinner.bounds) }
pub fn (spinner &mut Spinner) set_bounds(bounds &layout.Rect) int {
    validate_bounds(bounds) or >>
    if spinner.bounds.x != bounds.x || spinner.bounds.y != bounds.y || spinner.bounds.width != bounds.width || spinner.bounds.height != bounds.height { spinner.dirty = true
        spinner.bounds = copy_rect(bounds) }
    << 0
}
pub fn (spinner &mut Spinner) set_running(running bool) {
    if spinner.running != running { spinner.running = running
        spinner.dirty = true
        spinner.last = time.zero_instant() }
}
pub fn (spinner &mut Spinner) set_enabled(enabled bool) {
    if spinner.enabled != enabled { spinner.enabled = enabled
        spinner.dirty = true
        spinner.last = time.zero_instant() }
}
pub fn (spinner &mut Spinner) set_style(style &ControlStyle) int {
    validate_control(style) or >>
    spinner.custom = pack_scalar_style(style)
    spinner.dirty = true
    << 0
}
pub fn (spinner &Spinner) style_or(styles &Styles) ControlStyle {
    if spinner.custom.active { << unpack_scalar_style(&spinner.custom) }
    << styles.progress.clone()
}
pub fn (spinner &mut Spinner) tick(now time.Instant,reduced_motion bool) bool {
    if spinner.reduced != reduced_motion { spinner.reduced = reduced_motion
        spinner.dirty = true }
    if !spinner.is_running() || reduced_motion { << spinner.dirty }
    elapsed := now.since(spinner.last).nanoseconds()
    if !spinner.last.is_zero() && elapsed >= 0 && elapsed < 16 * time.millisecond() { << spinner.dirty }
    period := spinner.period.nanoseconds()
    if period <= 0 { >> errors.new("widgets: invalid spinner period") }
    spinner.phase = f64(now.nanoseconds() % period) / f64(period)
    spinner.last = now
    spinner.dirty = true
    << true
}
pub fn (spinner &Spinner) next_tick(now time.Instant,reduced_motion bool) time.Instant {
    if !spinner.is_running() || reduced_motion { << time.zero_instant() }
    << now.add(time.milliseconds(16) or >>) or >>
}
pub fn (spinner &Spinner) measure_styled(styles &Styles) layout.Size {
    styles.validate() or >>
    << layout.Size{width: spinner.diameter * styles.density,height: spinner.diameter * styles.density}
}
pub fn (spinner &mut Spinner) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    styles.validate() or >>
    c := spinner.style_or(styles)
    b := spinner.bounds
    size := math.min(b.width,b.height)
    radius := size * 0.34
    dot := math.min(size * 0.15,spinner.thickness * styles.density * 0.5)
    if size > 0.0 && spinner.running {
        for i in 0:8 {
            mut step := f64(i) / 8.0
            if !spinner.reduced && spinner.is_running() { step = step + spinner.phase }
            angle := step * 6.283185307179586
            mut color := c.palette.accent
            if !spinner.enabled { color = c.palette.muted }
            mut alpha := 64 + i * 24
            if spinner.reduced || !spinner.running { alpha = 160 }
            alpha = alpha * (color.value() & 255) / 255
            frame.set_fill(color.with_alpha(alpha)) or >>
            frame.circle(b.x + b.width * 0.5 + math.cos(angle) * radius,b.y + b.height * 0.5 + math.sin(angle) * radius,dot) or >>
        }
    }
    spinner.dirty = false
    << 0
}

pub fn (spinner &mut Spinner) set_appearance(diameter f64,thickness f64,period time.Duration) int {
    if !finite_metric(diameter,256.0) || diameter <= 0.0 || !finite_metric(thickness,64.0) || thickness <= 0.0 || thickness > diameter * 0.3 || period.nanoseconds() < 100 * time.millisecond() || period.nanoseconds() > 10 * time.second() { >> errors.new("widgets: invalid spinner appearance") }
    spinner.diameter = diameter
    spinner.thickness = thickness
    spinner.period = period
    spinner.dirty = true
    << 0
}
