@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math
#strings
#unicode/utf8

// Choice controls intentionally support small, bounded menus (1..64 options).
// They scroll eight visible rows; they do not claim to virtualize large data.
fn validate_choices(options &[]string) int {
    if options.len < 1 || options.len > 64 { >> errors.new("widgets: expected 1..64 choices") }
    for text in options {
        if text.len > 4096 || !utf8.valid(&text) { >> errors.new("widgets: invalid choice text") }
        for i in 0:text.len { if (text[i] & 255) == 0 || (text[i] & 255) == 10 || (text[i] & 255) == 13 { >> errors.new("widgets: choice must be a single line") } }
    }
    << 0
}
struct ChoiceList {
    locale Locale
    identity ui.CanvasEvent
    anchor layout.Rect
    query string
    options []string
    shown []int
    marked []bool
    cursor int
    first int
    hot int
    armed int
    open bool
    above bool
    row_h f64
    pad f64
    dirty bool
    labels TextCache
}
fn choice_list(context &draw.Context,identity &ui.CanvasEvent,bounds &layout.Rect,options &[]string) ChoiceList {
    validate_choices(options) or >>
    if !valid_identity(identity) || !context.matches_canvas(identity) { >> errors.new("widgets: choice context mismatch") }
    validate_bounds(bounds) or >>
    mut values := []string{}
    mut shown := []int{}
    mut marked := []bool{}
    for i in 0:options.len { text := options[i]
        values.push(text + "")
        shown.push(i)
        marked.push(false) }
    << ChoiceList{locale: locale_default(),identity: copy_identity(identity),anchor: copy_rect(bounds),query: "",options: values,shown: shown,marked: marked,
        cursor: 0,first: 0,hot: -1,armed: -1,open: false,above: false,row_h: 32.0,pad: 4.0,dirty: true,labels: text_cache(context)}
}
fn (list &mut ChoiceList) metrics(styles &Styles,c &ControlStyle) int {
    styles.validate() or >>
    text := styles.text_options(c)
    height := math.max(28.0 * styles.density,text.size * 1.5 + 8.0 * styles.density)
    pad := 4.0 * styles.density
    if height != list.row_h || pad != list.pad { list.row_h = height
        list.pad = pad
        list.armed = -1
        list.hot = -1
        list.dirty = true }
    << 0
}
fn (list &ChoiceList) popup() layout.Rect {
    rows := math.max(1.0,math.min(8.0,f64(list.shown.len)))
    height := rows * list.row_h + list.pad * 2.0
    mut y := list.anchor.y + list.anchor.height + list.pad
    if list.above { y = list.anchor.y - height - list.pad }
    << layout.Rect{x: list.anchor.x,y: y,width: list.anchor.width,height: height}
}
fn (list &ChoiceList) row(index int) layout.Rect {
    if index < 0 || index >= list.shown.len { >> errors.new("widgets: visible choice index out of range") }
    p := list.popup()
    << layout.Rect{x: p.x + list.pad,y: p.y + list.pad + f64(index - list.first) * list.row_h,width: math.max(0.0,p.width - list.pad * 2.0),height: list.row_h}
}
fn (list &mut ChoiceList) reveal() {
    if list.cursor < list.first { list.first = list.cursor }
    if list.cursor >= list.first + 8 { list.first = list.cursor - 7 }
    maximum := max_int(0,list.shown.len - 8)
    list.first = max_int(0,min_int(maximum,list.first))
}
fn (list &mut ChoiceList) filter(query &string) {
    needle := strings.to_lower(query)
    list.query=query+""
    mut shown := []int{}
    for i in 0:list.options.len { text := list.options[i]
        folded := strings.to_lower(&text)
        if strings.contains(&folded,needle) { shown.push(i) } }
    list.shown = shown
    list.cursor = 0
    list.first = 0
    list.armed = -1
    list.hot = -1
    list.dirty = true
}
fn (list &mut ChoiceList) set_open(open bool) {
    if list.open != open { list.open = open
        list.armed = -1
        list.hot = -1
        list.dirty = true }
}
fn (list &ChoiceList) hit(x f64,y f64) int {
    p := list.popup()
    if !p.contains(x,y) || x < p.x + list.pad || x >= p.x + p.width - list.pad || y < p.y + list.pad || y >= p.y + p.height - list.pad { << -1 }
    index := list.first + int((y - p.y - list.pad) / list.row_h)
    if index < 0 || index >= list.shown.len { << -1 }
    << index
}
// A chosen value is the original option index; navigation never changes values.
fn (list &mut ChoiceList) input(id int,event &ui.InputEvent,focused bool,multiple bool) Action {
    if !belongs(&list.identity,event) || !list.open { << no_action(id,list.dirty) }
    mut consumed := false
    mut chosen := -1
    hit := list.hit(event.x,event.y)
    if event.kind == ui.EV_POINTER_CANCEL { list.set_open(false) }
    else if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT {
        list.armed = hit
        consumed = hit >= 0
        if hit < 0 && !list.anchor.contains(event.x,event.y) { list.set_open(false) }
        if hit >= 0 { list.cursor = hit
            list.dirty = true }
    } else if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT {
        if list.armed >= 0 { consumed = true
            if hit == list.armed { chosen = list.shown[hit] } }
        list.armed = -1
    } else if event.kind == ui.EV_POINTER_MOVE || event.kind == ui.EV_POINTER_LEAVE {
        mut hot := hit
        if event.kind == ui.EV_POINTER_LEAVE { hot = -1 }
        if hot != list.hot { list.hot = hot
            list.dirty = true }
        consumed = hit >= 0
    } else if event.kind == ui.EV_POINTER_SCROLL && list.popup().contains(event.x,event.y) {
        mut delta := 0
        if event.dy > 0.0 { delta = max_int(1,int(event.dy / list.row_h)) }
        if event.dy < 0.0 { delta = min_int(-1,int(event.dy / list.row_h)) }
        list.first = max_int(0,min_int(max_int(0,list.shown.len - 8),list.first + delta))
        list.armed = -1
        list.dirty = true
        consumed = true
    } else if event.kind == ui.EV_KEY_DOWN && focused {
        mut cursor := list.cursor
        if event.key == ui.KEY_ESCAPE { list.set_open(false)
            consumed = true }
        else if event.key == ui.KEY_UP { cursor = cursor - 1
            consumed = true }
        else if event.key == ui.KEY_DOWN { cursor = cursor + 1
            consumed = true }
        else if event.key == ui.KEY_PAGE_UP { cursor = cursor - 8
            consumed = true }
        else if event.key == ui.KEY_PAGE_DOWN { cursor = cursor + 8
            consumed = true }
        else if event.key == ui.KEY_HOME { cursor = 0
            consumed = true }
        else if event.key == ui.KEY_END { cursor = list.shown.len - 1
            consumed = true }
        else if event.key == ui.KEY_ENTER || (multiple && event.key == 32) {
            consumed = true
            if event.repeat == 0 && list.shown.len > 0 { chosen = list.shown[list.cursor] }
        }
        if list.shown.len > 0 { cursor = max_int(0,min_int(list.shown.len - 1,cursor)) }
        else { cursor = 0 }
        if list.cursor != cursor { list.cursor = cursor
            list.armed = -1
            list.reveal()
            list.dirty = true }
    }
    mut kind := ACTION_NONE
    if chosen >= 0 { kind = ACTION_CHANGE }
    << Action{kind: kind,id: id,needs_paint: list.dirty,request_focus: false,consumed: consumed,value: f64(chosen)}
}
fn (list &mut ChoiceList) paint(frame &mut draw.Frame,styles &Styles,control &ControlStyle,multiple bool) int {
    if !list.open { << 0 }
    list.metrics(styles,control) or >>
    mut c := control.clone()
    p := list.popup()
    style_box(frame,&p,&c,styles.density,0) or >>
    c.border_width = 0.0
    c.focus_width = 1.0
    c.align_x = 0.0
    c.padding = layout.insets(6.0) or >>
    frame.push() or >>
    frame.clip_rect(p.x + list.pad,p.y + list.pad,math.max(0.0,p.width - 2.0 * list.pad),math.max(0.0,p.height - 2.0 * list.pad)) or >>
    if list.shown.len == 0 { text := list.locale.text(TEXT_NO_MATCHES) or >>
        labels := mut &list.labels
        labels.paint_text(65,&text,frame,&p,styles,&c,STATE_DISABLED) or >> }
    for offset in 0:8 {
        index := list.first + offset
        if index >= list.shown.len { <- }
        original := list.shown[index]
        mut b := list.row(index) or >>
        text := list.options[original]
        mut state := 0
        if list.marked[original] { state = state | STATE_SELECTED }
        if list.hot == index { state = state | STATE_HOVERED }
        if list.cursor == index { state = state | STATE_FOCUSED }
        if list.armed == index { state = state | STATE_PRESSED }
        style_box(frame,&b,&c,styles.density,state) or >>
        if !multiple && list.marked[original] {
            x := b.x+b.width-12.0*styles.density
            y := b.y+b.height*0.5
            ink := c.resolve(state).foreground
            frame.line(x-4.0,y,x-1.0,y+3.0,ink,1.5) or >>
            frame.line(x-1.0,y+3.0,x+5.0,y-4.0,ink,1.5) or >>
            b.width=math.max(0.0,b.width-24.0*styles.density)
        }
        if multiple {
            size := math.min(16.0 * styles.density,b.height * 0.55)
            box := layout.Rect{x: b.x + 6.0 * styles.density,y: b.y + (b.height - size) * 0.5,width: size,height: size}
            frame.stroke_rect(box.x,box.y,box.width,box.height,c.resolve(state).foreground,1.0) or >>
            if list.marked[original] { ink := c.resolve(state).foreground
                frame.line(box.x + size * 0.2,box.y + size * 0.5,box.x + size * 0.43,box.y + size * 0.73,ink,1.5) or >>
                frame.line(box.x + size * 0.43,box.y + size * 0.73,box.x + size * 0.82,box.y + size * 0.25,ink,1.5) or >> }
            b.x = b.x + size + 8.0 * styles.density
            b.width = math.max(0.0,b.width - size - 8.0 * styles.density)
        }
        label_index := original + 1
        list.paint_match(original,&text,frame,&b,styles,&c) or >>
        labels := mut &list.labels
        labels.paint_text(label_index,&text,frame,&b,styles,&c,state) or >>
    }
    frame.pop() or >>
    << 0
}

// MultiSelect keeps its menu open while toggling choices. Enter/Space toggle the
// keyboard cursor; Escape, blur and an outside press close without clearing it.
pub struct MultiSelect { control Button
    choices ChoiceList
    chips []layout.Rect
    chip_items []int
    chip_armed int }
pub fn multi_select(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,options &[]string) MultiSelect {
    control := button(identity,id,bounds) or >>
    choices := choice_list(context,identity,bounds,options) or >>
    << MultiSelect{control: control,choices: choices,chips: []layout.Rect{},chip_items: []int{},chip_armed: -1}
}
pub fn (multi &MultiSelect) id() int { << multi.control.id }
pub fn (multi &MultiSelect) bounds() layout.Rect { << multi.control.bounds() }
pub fn (multi &MultiSelect) is_open() bool { << multi.choices.open }
pub fn (multi &MultiSelect) is_enabled() bool { << multi.control.is_enabled() }
pub fn (multi &MultiSelect) needs_paint() bool { << multi.control.dirty || multi.choices.dirty }
pub fn (multi &MultiSelect) count() int { << multi.choices.options.len }
pub fn (multi &MultiSelect) selected(index int) bool {
    if index < 0 || index >= multi.count() { >> errors.new("widgets: choice index out of range") }
    << multi.choices.marked[index]
}
pub fn (multi &MultiSelect) values() []int {
    mut values := []int{}
    for i in 0:multi.choices.marked.len { if multi.choices.marked[i] { values.push(i) } }
    << values
}
pub fn (multi &mut MultiSelect) set_selected(index int,selected bool) int {
    if multi.control.closed { >> errors.new("widgets: multi-select is disposed") }
    if index < 0 || index >= multi.count() { >> errors.new("widgets: choice index out of range") }
    multi.choices.marked[index] = selected
    multi.control.dirty = true
    multi.choices.dirty = true
    << 0
}
pub fn (multi &MultiSelect) style_or(styles &Styles) ControlStyle {
    if multi.control.has_style() { << multi.control.style_or(styles) }
    << styles.select_style()
}
pub fn (multi &mut MultiSelect) set_style(style &ControlStyle) int { control := mut &multi.control
    << control.set_style(style) or >> }
pub fn (multi &mut MultiSelect) set_enabled(enabled bool) { control := mut &multi.control
    control.set_enabled(enabled)
    if !enabled { choices := mut &multi.choices
        choices.set_open(false) } }
pub fn (multi &mut MultiSelect) set_read_only(read_only bool) int {
    if multi.control.closed { >> errors.new("widgets: multi-select is disposed") }
    control := mut &multi.control
    control.set_read_only(read_only)
    if read_only { choices := mut &multi.choices
        choices.set_open(false) }
    << 0
}
pub fn (multi &mut MultiSelect) set_invalid(invalid bool) { control := mut &multi.control
    control.set_invalid(invalid) }
pub fn (multi &mut MultiSelect) set_focus(focused bool) { control := mut &multi.control
    control.set_focus(focused)
    if !focused { choices := mut &multi.choices
        choices.set_open(false) } }
pub fn (multi &mut MultiSelect) set_open(open bool) {
    allowed := open && multi.control.is_enabled() && !multi.control.read_only
    choices := mut &multi.choices
    choices.set_open(allowed)
}
pub fn (multi &mut MultiSelect) set_popup_above(above bool) {
    if multi.choices.above != above {
        multi.choices.above = above
        multi.choices.armed = -1
        multi.choices.dirty = true
    } }
pub fn (multi &mut MultiSelect) set_bounds(bounds &layout.Rect) int {
    old := multi.bounds()
    control := mut &multi.control
    control.set_bounds(bounds) or >>
    if old.x != bounds.x || old.y != bounds.y || old.width != bounds.width || old.height != bounds.height {
        multi.choices.anchor = copy_rect(bounds)
        multi.choices.armed = -1
        multi.choices.dirty = true
    }
    << 0
}
pub fn (multi &mut MultiSelect) apply_styles(styles &Styles) int {
    c := multi.style_or(styles)
    choices := mut &multi.choices
    choices.metrics(styles,&c) or >>
    << multi.prepare_chips(styles,&c) or >>
}
pub fn (multi &MultiSelect) popup_bounds() layout.Rect { << multi.choices.popup() }
pub fn (multi &MultiSelect) option_bounds(index int) layout.Rect { << multi.choices.row(index) or >> }
pub fn (multi &mut MultiSelect) input(event &ui.InputEvent) Action {
    id := multi.id()
    if !belongs(&multi.control.identity,event) || !multi.is_enabled() { << no_action(id,multi.needs_paint()) }
    if event.kind == ui.EV_POINTER_CANCEL { multi.chip_armed = -1
        multi.set_focus(false)
        << no_action(id,true) }
    chip_action := multi.chip_input(event) or >>
    if chip_action.consumed { << chip_action }
    mut result := no_action(id,multi.needs_paint())
    if !multi.control.read_only {
        focused := multi.control.focused
        choices := mut &multi.choices
        result = choices.input(id,event,focused,true) or >>
        if result.kind == ACTION_CHANGE { index := int(result.value)
            next := !multi.choices.marked[index]
            multi.set_selected(index,next) or >>
            result.needs_paint = true
            << result }
        if result.consumed { << result }
    }
    control := mut &multi.control
    result = control.input(event)
    if result.kind == ACTION_ACTIVATE { multi.set_open(!multi.is_open()) }
    result.needs_paint = multi.needs_paint()
    << result
}
pub fn (multi &mut MultiSelect) route(kind int,event &ui.InputEvent) Action {
    if kind < ROUTE_INPUT || kind > ROUTE_CANCEL { >> errors.new("widgets: invalid multi-select route") }
    if !belongs(&multi.control.identity,event) { << no_action(multi.id(),false) }
    if kind == ROUTE_FOCUS { multi.set_focus(true) }
    else if kind == ROUTE_BLUR || kind == ROUTE_CANCEL { multi.set_focus(false) }
    else { << multi.input(event) or >> }
    << no_action(multi.id(),multi.needs_paint())
}
pub fn (multi &mut MultiSelect) event(event &ui.Event) Action {
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << multi.input(&input) or >> }
    control := mut &multi.control
    result := control.event(event) or >>
    if !multi.control.focused { choices := mut &multi.choices
        choices.set_open(false) }
    << result
}
pub fn (multi &mut MultiSelect) measure_styled(styles &Styles) layout.Size {
    multi.apply_styles(styles) or >>
    c := multi.style_or(styles)
    text := multi.selection_text() or >>
    choices := mut &multi.choices
    labels := mut &choices.labels
    size := labels.measure(0,&text,styles,&c) or >>
    << layout.Size{width: math.max(180.0 * styles.density,size.width + (c.padding.left + c.padding.right + 24.0) * styles.density),height: math.max(c.min_height * styles.density,size.height + (c.padding.top + c.padding.bottom) * styles.density)}
}
pub fn (multi &mut MultiSelect) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    multi.apply_styles(styles) or >>
    mut c := multi.style_or(styles)
    b := multi.bounds()
    state := multi.control.visual_state()
    style_box(frame,&b,&c,styles.density,state) or >>
    c.align_x = 0.0
    c.padding.right = c.padding.right + 24.0
    multi.paint_chips(frame,styles,&c,state) or >>
    ink := c.resolve(state).foreground
    x := b.x + b.width - 16.0 * styles.density
    y := b.y + b.height * 0.5
    frame.line(x - 4.0,y - 2.0,x,y + 2.0,ink,1.5) or >>
    frame.line(x,y + 2.0,x + 4.0,y - 2.0,ink,1.5) or >>
    multi.control.dirty = false
    multi.choices.dirty = false
    << 0
}
pub fn (multi &mut MultiSelect) paint_popup_styled(frame &mut draw.Frame,styles &Styles) int {
    c := multi.style_or(styles)
    choices := mut &multi.choices
    << choices.paint(frame,styles,&c,true) or >>
}
pub fn (multi &mut MultiSelect) dispose() {
    choices := mut &multi.choices
    labels := mut &choices.labels
    labels.dispose()
    multi.control.closed = true
    multi.control.enabled = false
    multi.choices.open = false
}

pub fn (multi &mut MultiSelect) set_filter(query &string) int {
    validate_table_text(query) or >>
    choices := mut &multi.choices
    choices.filter(query)
    << 0
}
pub fn (multi &mut MultiSelect) select_all(selected bool) int {
    if multi.control.closed { >> errors.new("widgets: multi-select is disposed") }
    for i in 0:multi.count() { multi.choices.marked[i] = selected }
    multi.choices.dirty = true
    multi.control.dirty = true
    << 0
}
fn (multi &mut MultiSelect) prepare_chips(styles &Styles,c &ControlStyle) int {
    mut chips := []layout.Rect{}
    mut indices := []int{}
    b := multi.bounds()
    d := styles.density
    mut x := b.x + 6.0 * d
    limit := b.x + b.width - 58.0 * d
    selected := multi.values()
    for index in selected {
        if chips.len >= 2 { <- }
        text := multi.choices.options[index] + ""
        choices := mut &multi.choices
        labels := mut &choices.labels
        size := labels.measure(256 + index,&text,styles,c) or >>
        width := size.width + 36.0 * d
        if x + width > limit { <- }
        height := math.min(b.height - 8.0 * d,math.max(24.0 * d,size.height + 4.0 * d))
        chips.push(layout.Rect{x: x,y: b.y + (b.height - height) * 0.5,width: width,height: math.max(0.0,height)})
        indices.push(index)
        x = x + width + 4.0 * d
    }
    multi.chips = chips
    multi.chip_items = indices
    << 0
}
fn (multi &mut MultiSelect) chip_input(event &ui.InputEvent) Action {
    if multi.control.read_only { << no_action(multi.id(),false) }
    mut hit := -1
    for i in 0:multi.chips.len { b := multi.chips[i]
        if event.x >= b.x + b.width - 24.0 && b.contains(event.x,event.y) { hit = multi.chip_items[i] } }
    mut remove := -1
    if event.kind == ui.EV_POINTER_DOWN && event.button == ui.BUTTON_LEFT && hit >= 0 { multi.chip_armed = hit
        << Action{kind: ACTION_NONE,id: multi.id(),needs_paint: true,request_focus: true,consumed: true,value: 0.0} }
    if event.kind == ui.EV_POINTER_UP && event.button == ui.BUTTON_LEFT && multi.chip_armed >= 0 {
        if hit == multi.chip_armed { remove = hit }
        multi.chip_armed = -1
        if remove < 0 { << Action{kind: ACTION_NONE,id: multi.id(),needs_paint: true,request_focus: false,consumed: true,value: 0.0} }
    }
    if event.kind == ui.EV_KEY_DOWN && multi.control.focused && event.repeat == 0 {
        values := multi.values()
        if event.key == ui.KEY_BACKSPACE && values.len > 0 { remove = values[values.len - 1] }
        if event.key == 65 && (event.modifiers & (ui.MOD_CONTROL | ui.MOD_META)) != 0 && multi.is_open() {
            multi.select_all(true) or >>
            << Action{kind: ACTION_CHANGE,id: multi.id(),needs_paint: true,request_focus: false,consumed: true,value: -1.0} }
    }
    if remove >= 0 { multi.set_selected(remove,false) or >>
        << Action{kind: ACTION_CHANGE,id: multi.id(),needs_paint: true,request_focus: true,consumed: true,value: f64(remove)} }
    << no_action(multi.id(),false)
}
fn (multi &mut MultiSelect) paint_chips(frame &mut draw.Frame,styles &Styles,c &ControlStyle,state int) int {
    d := styles.density
    mut text_style := c.clone()
    text_style.padding = layout.Insets{left: 8.0,top: 0.0,right: 0.0,bottom: 0.0}
    text_style.align_y = 0.5
    text_style.states = []StatePaint{}
    text_style.palette.foreground = c.palette.foreground
    if !multi.is_enabled() { text_style.palette.foreground = c.palette.muted }
    selected_count := multi.values().len
    mut summary := multi.selection_text() or >>
    for i in 0:multi.chips.len {
        b := multi.chips[i]
        index := multi.chip_items[i]
        rounded_fill(frame,&b,4.0 * d,mix_color(styles.background,c.palette.accent,0.10)) or >>
        text_bounds := layout.Rect{x: b.x,y: b.y,width: math.max(0.0,b.width - 24.0 * d),height: b.height}
        text := multi.choices.options[index] + ""
        choices := mut &multi.choices
        labels := mut &choices.labels
        labels.paint_text(256 + index,&text,frame,&text_bounds,styles,&text_style,0) or >>
        if !multi.control.read_only && multi.is_enabled() {
            x := b.x + b.width - 12.0 * d
            y := b.y + b.height * 0.5
            frame.line(x - 3.0 * d,y - 3.0 * d,x + 3.0 * d,y + 3.0 * d,c.palette.muted,1.2 * d) or >>
            frame.line(x + 3.0 * d,y - 3.0 * d,x - 3.0 * d,y + 3.0 * d,c.palette.muted,1.2 * d) or >> }
    }
    mut remaining := copy_rect(&multi.control.bounds)
    if multi.chips.len > 0 { last := multi.chips[multi.chips.len - 1]
        remaining.x = last.x + last.width + 4.0 * d
        remaining.width = math.max(0.0,multi.control.bounds.x + multi.control.bounds.width - remaining.x - 28.0 * d)
        summary = ""
        if selected_count > multi.chips.len { summary = "+" + multi.choices.locale.integer(selected_count - multi.chips.len) } }
    choices := mut &multi.choices
    labels := mut &choices.labels
    labels.paint_text(0,&summary,frame,&remaining,styles,&text_style,0) or >>
    << 0
}
