@ui/widgets

#ui
#ui/layout
#errors
#math

pub const ACTION_DRAG_START = 11
pub const ACTION_DRAG_MOVE = 12
pub const ACTION_DROP = 13
pub const ACTION_DRAG_CANCEL = 14

pub struct DragSourceConfig {
    pub payload_type string
    pub payload string
    pub follow bool
}

pub struct DropZoneConfig {
    pub accept_types string
}

pub struct DragState {
    pub active bool
    pub source int
    pub over_target int
    pub payload_type string
    pub payload string
    pub start_x f64
    pub start_y f64
    pub x f64
    pub y f64
    pub delta_x f64
    pub delta_y f64
    pub accepted bool
}

fn empty_drag_state() DragState {
    << DragState{
        active: false,
        source: 0,
        over_target: 0,
        payload_type: "",
        payload: "",
        start_x: 0.0,
        start_y: 0.0,
        x: 0.0,
        y: 0.0,
        delta_x: 0.0,
        delta_y: 0.0,
        accepted: false
    }
}

fn copy_drag_state(d &DragState) DragState {
    << DragState{
        active: d.active,
        source: d.source,
        over_target: d.over_target,
        payload_type: d.payload_type + "",
        payload: d.payload + "",
        start_x: d.start_x,
        start_y: d.start_y,
        x: d.x,
        y: d.y,
        delta_x: d.delta_x,
        delta_y: d.delta_y,
        accepted: d.accepted
    }
}

fn trim_dnd_token(s string) string {
    $start := 0
    $end := s.len
    while start < end {
        b := s[start] & 255
        if b != 32 && b != 9 { <- }
        start += 1
    }
    while end > start {
        b := s[end - 1] & 255
        if b != 32 && b != 9 { <- }
        end -= 1
    }
    if start == 0 && end == s.len { << s + "" }
    << s[start:end] + ""
}

fn accept_types_match(accept_types &string,payload_type &string) bool {
    if payload_type.len == 0 { << false }
    pattern := trim_dnd_token(accept_types + "")
    if pattern.len == 0 { << false }
    if pattern == "*" { << true }
    want := payload_type + ""
    $pos := 0
    for i in 0:pattern.len {
        if (pattern[i] & 255) == 44 {
            tok := trim_dnd_token(pattern[pos:i])
            if tok == "*" || tok == want { << true }
            pos = i + 1
        }
    }
    last_tok := trim_dnd_token(pattern[pos:pattern.len])
    << last_tok == "*" || last_tok == want
}

pub fn (s $&Screen) set_draggable(id int,payload_type string,payload string) int {
    _ := s.node(id) >>>
    if !valid_token_name(&payload_type) { >> errors.new("widgets: invalid drag payload type") }
    comp := $&s.composition
    sources := $&comp.drag_sources
    had := sources.has(id)
    $keep_follow := false
    if had {
        prev := sources.take(id)
        keep_follow = prev.follow
    }
    sources[id] = DragSourceConfig{
        payload_type: payload_type + "",
        payload: payload + "",
        follow: keep_follow
    }
    if !had { comp.drag_source_count = comp.drag_source_count + 1 }
    << 0
}

pub fn (s $&Screen) set_drag_follow(id int,follow bool) int {
    _ := s.node(id) >>>
    if !s.composition.drag_sources.has(id) { >> errors.new("widgets: node is not draggable") }
    comp := $&s.composition
    sources := $&comp.drag_sources
    cur := sources.take(id)
    sources[id] = DragSourceConfig{
        payload_type: cur.payload_type + "",
        payload: cur.payload + "",
        follow: follow
    }
    << 0
}

pub fn (s $&Screen) clear_draggable(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.drag_sources.has(id) {
        sources := $&comp.drag_sources
        sources.delete(id)
        if comp.drag_source_count > 0 { comp.drag_source_count = comp.drag_source_count - 1 }
    }
    if comp.drag_pending_source == id { comp.drag_pending_source = 0 }
    if comp.drag_state.active && comp.drag_state.source == id {
        s.cancel_drag() >>>
    }
    << 0
}

pub fn (s &Screen) is_draggable(id int) bool {
    _ := s.node(id) >>>
    << s.composition.drag_source_count > 0 && s.composition.drag_sources.has(id)
}

pub fn (s $&Screen) set_drop_zone(id int,accept_types string) int {
    _ := s.node(id) >>>
    trimmed := trim_dnd_token(accept_types + "")
    if trimmed.len == 0 || trimmed.len > 256 { >> errors.new("widgets: invalid drop zone accept types") }
    comp := $&s.composition
    zones := $&comp.drop_zones
    had := zones.has(id)
    zones[id] = DropZoneConfig{accept_types: trimmed}
    if !had { comp.drop_zone_count = comp.drop_zone_count + 1 }
    << 0
}

pub fn (s $&Screen) clear_drop_zone(id int) int {
    _ := s.node(id) >>>
    comp := $&s.composition
    if comp.drop_zones.has(id) {
        zones := $&comp.drop_zones
        zones.delete(id)
        if comp.drop_zone_count > 0 { comp.drop_zone_count = comp.drop_zone_count - 1 }
    }
    if comp.drag_state.active && comp.drag_state.over_target == id {
        comp.drag_state.over_target = 0
        comp.drag_state.accepted = false
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) is_drop_zone(id int) bool {
    _ := s.node(id) >>>
    << s.composition.drop_zone_count > 0 && s.composition.drop_zones.has(id)
}

pub fn (s $&Screen) set_drag_threshold(px f64) int {
    s.check_screen() >>>
    if math.is_nan(px) || math.is_inf(px) || px < 0.0 || px > 128.0 {
        >> errors.new("widgets: invalid drag threshold")
    }
    comp := $&s.composition
    comp.drag_threshold = px
    << 0
}

pub fn (s &Screen) is_dragging() bool {
    << s.composition.drag_state.active
}

pub fn (s &Screen) drag_state() DragState {
    << copy_drag_state(&s.composition.drag_state)
}

pub fn (s &Screen) last_drop() DragState {
    << copy_drag_state(&s.composition.last_drop_state)
}

pub fn (s &Screen) is_drop_hover(id int) bool {
    << s.composition.drag_state.active && s.composition.drag_state.accepted && s.composition.drag_state.over_target == id
}

fn (s &Screen) drag_source_follows(id int) bool {
    if !s.composition.drag_sources.has(id) { << false }
    cfg := &s.composition.drag_sources[id]
    << cfg.follow
}

fn (s $&Screen) restore_drag_follow_transform(src int) {
    if src <= 0 || src > s.nodes.len || s.nodes[src - 1].kind < 0 {
        comp := $&s.composition
        comp.drag_had_saved_vt = false
        <<
    }
    if s.drag_source_follows(src) {
        if s.composition.drag_had_saved_vt {
            vt := copy_visual_transform(&s.composition.drag_saved_vt)
            s.apply_visual_transform_internal(src,&vt)
        } else {
            s.clear_visual_transform(src) >>> (err) { << }
        }
    }
    comp := $&s.composition
    comp.drag_had_saved_vt = false
}

fn (s $&Screen) reset_drag_silently() {
    if s.composition.drag_state.active {
        s.restore_drag_follow_transform(s.composition.drag_state.source)
    }
    comp := $&s.composition
    comp.drag_pending_source = 0
    comp.drag_state = empty_drag_state()
    comp.drag_had_saved_vt = false
}

pub fn (s $&Screen) cancel_drag() int {
    s.check_screen() >>>
    was_active := s.composition.drag_state.active
    src := s.composition.drag_state.source
    s.reset_drag_silently()
    if was_active {
        s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
        s.mark_paint_dirty()
        qa := $&s.queued_actions
        qa.push(Action{kind: ACTION_DRAG_CANCEL,id: src,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
    }
    << 0
}

fn (s &Screen) find_draggable_ancestor(id int) int {
    if s.composition.drag_source_count == 0 || id <= 0 || id > s.nodes.len { << 0 }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        n := s.nodes[cur - 1]
        if n.kind < 0 || !s.is_visible(cur) { <- }
        ht := s.is_hit_test_enabled(cur) >>> (err) { << 0 }
        if s.composition.drag_sources.has(cur) && s.effective_enabled(cur) && ht {
            << cur
        }
        if screen_is_overlay(n.kind) { <- }
        cur = n.parent
        budget -= 1
    }
    << 0
}

fn (s $&Screen) dnd_hit_subtree(id int,in_x f64,in_y f64,modal int,skip_subtree int,want_drop bool) int {
    if id <= 0 || id > s.nodes.len || id == skip_subtree { << 0 }
    n := s.nodes[id - 1]
    if n.kind < 0 || !n.visible { << 0 }
    if s.composition.hidden_node_count > 0 && s.composition.hidden_nodes.has(id) { << 0 }
    if (s.composition.opacity_transition_ids.len > 0 || s.composition.transform_transition_ids.len > 0) && s.is_node_exiting(id) { << 0 }
    if s.is_floating_node(id) && s.composition.hitting_floating_root != id { << 0 }
    if (n.kind == SCREEN_POPOVER || n.kind == SCREEN_MODAL) && !s.overlay_is_visible(id) { << 0 }
    if s.controls.split_panes.has(id) && (n.bounds.width <= 0.0 || n.bounds.height <= 0.0) { << 0 }
    pt := s.inverse_visual_point(id,in_x,in_y)
    x := pt.x
    y := pt.y
    is_scroll := s.basics.scrolls.has(id)
    is_clipped_box := s.controls.split_panes.has(id) || s.container_is_clipped(id) || screen_is_overlay(n.kind)
    if (is_scroll || is_clipped_box) && !n.bounds.contains(x,y) { << 0 }
    $descend := true
    if is_scroll && !s.scroll_content_clip(id).contains(x,y) { descend = false }
    if descend {
        if s.has_custom_stacking() {
            z_kids := s.z_ordered_children(id)
            $k := z_kids.len - 1
            while k >= 0 {
                cid := z_kids[k]
                if cid != skip_subtree && !screen_is_overlay(s.nodes[cid - 1].kind) {
                    found := s.dnd_hit_subtree(cid,x,y,modal,skip_subtree,want_drop) >>>
                    if found > 0 { << found }
                }
                k -= 1
            }
        } else {
            child_count := s.child_count_of(id)
            $k := child_count - 1
            while k >= 0 {
                cid := s.child_at_of(id,k)
                if cid > 0 && cid <= s.nodes.len && cid != skip_subtree && s.nodes[cid - 1].parent == id && !screen_is_overlay(s.nodes[cid - 1].kind) {
                    found := s.dnd_hit_subtree(cid,x,y,modal,skip_subtree,want_drop) >>>
                    if found > 0 { << found }
                }
                k -= 1
            }
        }
    }
    if screen_is_overlay(n.kind) { << 0 }
    $matches_role := false
    if want_drop { matches_role = s.composition.drop_zones.has(id) }
    else { matches_role = s.composition.drag_sources.has(id) }
    if !matches_role { << 0 }
    if !s.effective_enabled(id) || !(s.is_hit_test_enabled(id) >>>) || !s.is_visible(id) || !s.in_modal(id,modal) { << 0 }
    if !n.bounds.contains(x,y) { << 0 }
    if !s.node_chain_has_visual_transform(id) {
        clip := s.child_clip(id) >>>
        if !clip.contains(x,y) { << 0 }
    }
    << id
}

fn (s $&Screen) hit_dnd_target(x f64,y f64,modal int,skip_subtree int,want_drop bool) int {
    if want_drop && s.composition.drop_zone_count == 0 { << 0 }
    if !want_drop && s.composition.drag_source_count == 0 { << 0 }
    if modal > 0 {
        << s.dnd_hit_subtree(modal,x,y,modal,skip_subtree,want_drop) >>>
    }
    if s.composition.floating_count > 0 {
        fids := s.ordered_floating_ids()
        $fi := fids.len - 1
        while fi >= 0 {
            fid := fids[fi]
            if fid != skip_subtree {
                comp := $&s.composition
                comp.hitting_floating_root = fid
                found := s.dnd_hit_subtree(fid,x,y,0,skip_subtree,want_drop) >>>
                comp2 := $&s.composition
                comp2.hitting_floating_root = 0
                if found > 0 { << found }
            }
            fi -= 1
        }
    }
    if s.has_custom_stacking() {
        roots := s.z_ordered_children(0)
        $i := roots.len - 1
        while i >= 0 {
            rid := roots[i]
            if rid > 0 && rid <= s.nodes.len && rid != skip_subtree && s.nodes[rid - 1].kind >= 0 && s.nodes[rid - 1].parent == 0 && !screen_is_overlay(s.nodes[rid - 1].kind) {
                found := s.dnd_hit_subtree(rid,x,y,0,skip_subtree,want_drop) >>>
                if found > 0 { << found }
            }
            i -= 1
        }
        << 0
    }
    root_count := s.child_count_of(0)
    $i := root_count - 1
    while i >= 0 {
        rid := s.child_at_of(0,i)
        if rid > 0 && rid <= s.nodes.len && rid != skip_subtree && s.nodes[rid - 1].kind >= 0 && s.nodes[rid - 1].parent == 0 && !screen_is_overlay(s.nodes[rid - 1].kind) {
            found := s.dnd_hit_subtree(rid,x,y,0,skip_subtree,want_drop) >>>
            if found > 0 { << found }
        }
        i -= 1
    }
    << 0
}

fn (s &Screen) drop_zone_accepts(dz int,ptype &string) bool {
    if dz <= 0 || !s.composition.drop_zones.has(dz) { << false }
    dz_cfg := &s.composition.drop_zones[dz]
    << accept_types_match(&dz_cfg.accept_types,ptype)
}

fn (s $&Screen) dnd_handle_escape(actions $&[]Action) bool {
    if !s.composition.drag_state.active { << false }
    src := s.composition.drag_state.source
    s.reset_drag_silently()
    s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
    s.mark_paint_dirty()
    actions.push(Action{kind: ACTION_DRAG_CANCEL,id: src,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
    << true
}

fn (s $&Screen) dnd_handle_pointer(input &ui.InputEvent,target int,modal int,actions $&[]Action) bool {
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        $src := s.find_draggable_ancestor(target)
        if src == 0 {
            src = s.hit_dnd_target(input.x,input.y,modal,0,false) >>>
        }
        comp := $&s.composition
        comp.drag_pending_source = src
        comp.drag_pending_x = input.x
        comp.drag_pending_y = input.y
        << false
    }
    if input.kind == ui.EV_POINTER_MOVE {
        if !s.composition.drag_state.active {
            src := s.composition.drag_pending_source
            if src <= 0 { << false }
            dx := input.x - s.composition.drag_pending_x
            dy := input.y - s.composition.drag_pending_y
            th := s.composition.drag_threshold
            if dx * dx + dy * dy < th * th { << false }
            if src > s.nodes.len || s.nodes[src - 1].kind < 0 || !s.composition.drag_sources.has(src) {
                comp := $&s.composition
                comp.drag_pending_source = 0
                << false
            }
            if s.captured > 0 {
                cancel_ev := s.cancellation()
                _ := s.route_node(s.captured,ROUTE_CANCEL,&cancel_ev) >>>
                s.captured = 0
            }
            src_cfg := &s.composition.drag_sources[src]
            ptype := src_cfg.payload_type + ""
            pdata := src_cfg.payload + ""
            sx := s.composition.drag_pending_x
            sy := s.composition.drag_pending_y
            follow := src_cfg.follow
            if follow {
                comp_vt := $&s.composition
                if comp_vt.visual_transforms.has(src) {
                    comp_vt.drag_saved_vt = copy_visual_transform(&comp_vt.visual_transforms[src])
                    comp_vt.drag_had_saved_vt = true
                } else {
                    comp_vt.drag_saved_vt = visual_transform()
                    comp_vt.drag_had_saved_vt = false
                }
                $vt := copy_visual_transform(&comp_vt.drag_saved_vt)
                vt.offset_x = vt.offset_x + dx
                vt.offset_y = vt.offset_y + dy
                s.apply_visual_transform_internal(src,&vt)
            }
            dz := s.hit_dnd_target(input.x,input.y,modal,src,true) >>>
            accepted := s.drop_zone_accepts(dz,&ptype)
            comp := $&s.composition
            comp.drag_pending_source = 0
            comp.drag_state = DragState{
                active: true,
                source: src,
                over_target: dz,
                payload_type: ptype,
                payload: pdata,
                start_x: sx,
                start_y: sy,
                x: input.x,
                y: input.y,
                delta_x: dx,
                delta_y: dy,
                accepted: accepted
            }
            actions.push(Action{kind: ACTION_DRAG_START,id: src,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
            if accepted { s.pointer_cursor(ui.CURSOR_HAND) >>> }
            else { s.pointer_cursor(ui.CURSOR_DEFAULT) >>> }
            s.mark_paint_dirty()
            << true
        }
        src := s.composition.drag_state.source
        dx := input.x - s.composition.drag_state.start_x
        dy := input.y - s.composition.drag_state.start_y
        if src > 0 && src <= s.nodes.len && s.nodes[src - 1].kind >= 0 && s.drag_source_follows(src) {
            $vt := copy_visual_transform(&s.composition.drag_saved_vt)
            vt.offset_x = vt.offset_x + dx
            vt.offset_y = vt.offset_y + dy
            s.apply_visual_transform_internal(src,&vt)
        }
        dz := s.hit_dnd_target(input.x,input.y,modal,src,true) >>>
        ptype := s.composition.drag_state.payload_type + ""
        accepted := s.drop_zone_accepts(dz,&ptype)
        comp := $&s.composition
        comp.drag_state.x = input.x
        comp.drag_state.y = input.y
        comp.drag_state.delta_x = dx
        comp.drag_state.delta_y = dy
        comp.drag_state.over_target = dz
        comp.drag_state.accepted = accepted
        $act_id := src
        $act_val := 0.0
        if accepted {
            act_id = dz
            act_val = 1.0
        }
        actions.push(Action{kind: ACTION_DRAG_MOVE,id: act_id,needs_paint: true,request_focus: false,consumed: true,value: act_val})
        if accepted { s.pointer_cursor(ui.CURSOR_HAND) >>> }
        else { s.pointer_cursor(ui.CURSOR_DEFAULT) >>> }
        s.mark_paint_dirty()
        << true
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        comp_clr := $&s.composition
        comp_clr.drag_pending_source = 0
        if !comp_clr.drag_state.active { << false }
        src := s.composition.drag_state.source
        sx := s.composition.drag_state.start_x
        sy := s.composition.drag_state.start_y
        dx := input.x - sx
        dy := input.y - sy
        ptype := s.composition.drag_state.payload_type + ""
        pdata := s.composition.drag_state.payload + ""
        dz := s.hit_dnd_target(input.x,input.y,modal,src,true) >>>
        accepted := s.drop_zone_accepts(dz,&ptype)
        s.restore_drag_follow_transform(src)
        comp := $&s.composition
        if accepted {
            comp.last_drop_state = DragState{
                active: false,
                source: src,
                over_target: dz,
                payload_type: ptype,
                payload: pdata,
                start_x: sx,
                start_y: sy,
                x: input.x,
                y: input.y,
                delta_x: dx,
                delta_y: dy,
                accepted: true
            }
            actions.push(Action{kind: ACTION_DROP,id: dz,needs_paint: true,request_focus: false,consumed: true,value: f64(src)})
            if s.composition.sortable_count > 0 {
                s.sortable_handle_drop(dz,src,input.x,input.y,actions)
            }
        } else {
            actions.push(Action{kind: ACTION_DRAG_CANCEL,id: src,needs_paint: true,request_focus: false,consumed: true,value: 0.0})
        }
        comp.drag_state = empty_drag_state()
        s.captured = 0
        s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
        s.mark_paint_dirty()
        << true
    }
    << false
}

fn (s $&Screen) cleanup_dnd_for(id int) {
    comp := $&s.composition
    if comp.drag_sources.has(id) {
        sources := $&comp.drag_sources
        sources.delete(id)
        if comp.drag_source_count > 0 { comp.drag_source_count = comp.drag_source_count - 1 }
    }
    if comp.drop_zones.has(id) {
        zones := $&comp.drop_zones
        zones.delete(id)
        if comp.drop_zone_count > 0 { comp.drop_zone_count = comp.drop_zone_count - 1 }
    }
    if comp.drag_pending_source == id { comp.drag_pending_source = 0 }
    if comp.drag_state.active && (comp.drag_state.source == id || comp.drag_state.over_target == id) {
        if comp.drag_state.source == id {
            comp.drag_state = empty_drag_state()
            comp.drag_had_saved_vt = false
        } else {
            comp.drag_state.over_target = 0
            comp.drag_state.accepted = false
        }
    }
}
