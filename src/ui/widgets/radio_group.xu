@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

// One focus stop owns the selection and arrow-key navigation for the group.
pub struct RadioGroup {
    control Tabs
    values []string
    labels TextCache
    horizontal bool
}
pub fn radio_group(context &draw.Context,identity &ui.CanvasEvent,id int,bounds &layout.Rect,options &[]string,selected int) RadioGroup {
    validate_choices(options) or >>
    if !context.matches_canvas(identity) { >> errors.new("widgets: radio group context mismatch") }
    control := tabs(identity,id,bounds,options.len,selected) or >>
    mut values := []string{}
    for value in options { values.push(value + "") }
    labels := text_cache(context)
    << RadioGroup{control: control,values: values,labels: labels,horizontal: false}
}
pub fn (g &RadioGroup) id() int { << g.control.id() }
pub fn (g &RadioGroup) bounds() layout.Rect { << g.control.bounds() }
pub fn (g &RadioGroup) count() int { << g.values.len }
pub fn (g &RadioGroup) selected() int { << g.control.selected() }
pub fn (g &RadioGroup) needs_paint() bool { << g.control.needs_paint() }
pub fn (g &RadioGroup) is_enabled() bool { << g.control.is_enabled() }
pub fn (g &RadioGroup) is_focused() bool { << g.control.is_focused() }
pub fn (g &mut RadioGroup) set_horizontal(horizontal bool) { if horizontal != g.horizontal { g.horizontal = horizontal
    g.control.dirty = true
    g.control.armed_idx = -1 } }
pub fn (g &mut RadioGroup) set_focus(focused bool) { control := mut &g.control
    control.set_focus(focused) }
pub fn (g &mut RadioGroup) set_enabled(enabled bool) { control := mut &g.control
    control.set_enabled(enabled) }
pub fn (g &mut RadioGroup) set_read_only(value bool) { control := mut &g.control
    control.set_read_only(value) }
pub fn (g &mut RadioGroup) set_selected(index int) int { control := mut &g.control
    << control.set_selected(index) or >> }
pub fn (g &mut RadioGroup) set_bounds(bounds &layout.Rect) int { control := mut &g.control
    << control.set_bounds(bounds) or >> }
pub fn (g &RadioGroup) style_or(styles &Styles) ControlStyle {
    if g.control.has_style() { << g.control.style_or(styles) }
    << styles.radio_style()
}
pub fn (g &mut RadioGroup) set_style(style &ControlStyle) int { control := mut &g.control
    << control.set_style(style) or >> }
pub fn (g &mut RadioGroup) painted() { control := mut &g.control
    control.painted() }
pub fn (g &mut RadioGroup) cancel() { control := mut &g.control
    control.cancel() }
pub fn (g &RadioGroup) item_bounds(index int) layout.Rect {
    if index < 0 || index >= g.count() { >> errors.new("widgets: invalid radio index") }
    b := g.bounds()
    if g.horizontal { width := b.width / f64(g.count())
        << layout.Rect{x: b.x + f64(index) * width,y: b.y,width: width,height: b.height} }
    height := b.height / f64(g.count())
    << layout.Rect{x: b.x,y: b.y + f64(index) * height,width: b.width,height: height}
}
pub fn (g &mut RadioGroup) input(event &ui.InputEvent) Action {
    mut translated := choice_copy_input(event)
    if !g.horizontal && event.kind != ui.EV_KEY_DOWN && event.kind != ui.EV_KEY_UP {
        b := g.bounds()
        if b.height > 0.0 && b.contains(event.x,event.y) {
            translated.x = b.x + (event.y - b.y) / b.height * b.width
            translated.y = b.y + b.height * 0.5
        } else { translated.x = b.x - 1.0
            translated.y = b.y - 1.0 }
    }
    control := mut &g.control
    << control.input(&translated) or >>
}
pub fn (g &mut RadioGroup) route(kind int,event &ui.InputEvent) Action {
    if kind == ROUTE_INPUT { << g.input(event) or >> }
    control := mut &g.control
    << control.route(kind,event) or >>
}
pub fn (g &mut RadioGroup) measure_styled(styles &Styles) layout.Size {
    c := g.style_or(styles)
    mut width := 0.0
    mut height := 0.0
    for i in 0:g.count() { value := g.values[i] + ""
        labels := mut &g.labels
        size := labels.measure(i,&value,styles,&c) or >>
        width = math.max(width,size.width + 48.0 * styles.density)
        height = math.max(height,math.max(32.0 * styles.density,size.height + 12.0 * styles.density)) }
    if g.horizontal { width = width * f64(g.count()) }
    else { height = height * f64(g.count()) }
    << layout.Size{width: width,height: height}
}
pub fn (g &mut RadioGroup) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    mut c := g.style_or(styles)
    c.padding = layout.Insets{left: 36.0,top: 4.0,right: 8.0,bottom: 4.0}
    c.align_x = 0.0
    c.align_y = 0.5
    d := styles.density
    for i in 0:g.count() {
        b := g.item_bounds(i) or >>
        state := g.control.item_visual_state(i)
        paint := c.resolve(state)
        if i == g.control.hovered_idx { rounded_fill(frame,&b,4.0 * d,fade_color(c.palette.accent,0.06)) or >> }
        cx := b.x + 16.0 * d
        cy := b.y + b.height * 0.5
        side := math.min(16.0 * d,b.height - 4.0 * d)
        if side > 0.0 {
            ring := layout.Rect{x: cx - side * 0.5,y: cy - side * 0.5,width: side,height: side}
            rounded_stroke(frame,&ring,side * 0.5,paint.border,math.max(1.0,c.border_width * d)) or >>
            if i == g.selected() { frame.set_fill(c.palette.accent) or >>
                frame.circle(cx,cy,side * 0.26) or >> }
        }
        if g.is_focused() && i == g.selected() { rounded_stroke(frame,&b,4.0 * d,c.palette.focus,c.focus_width * d) or >> }
        mut text := c.clone()
        text.states = []StatePaint{}
        text.palette.foreground = c.palette.foreground
        if !g.is_enabled() { text.palette.foreground = c.palette.muted }
        value := g.values[i] + ""
        labels := mut &g.labels
        labels.paint_text(i,&value,frame,&b,styles,&text,0) or >>
    }
    << 0
}
pub fn (g &mut RadioGroup) dispose() { labels := mut &g.labels
    labels.dispose()
    g.control.closed = true }
