@ui/widgets
#errors

// Candidate lists and menus own their interaction plane. Tooltips inside an
// active modal/popover may still explain its controls, while background help
// is suspended. This policy is shared by dispatch, render and snapshot layout.
fn (s $&Screen) sync_tooltip_layers() int {
    if s.composition.overlay_ids.len == 0 { << 0 }
    $has_tooltip := false
    for i in 0:s.composition.overlay_ids.len {
        oid := s.composition.overlay_ids[i]
        if oid > 0 && oid <= s.nodes.len && s.nodes[oid - 1].kind == SCREEN_TOOLTIP && s.is_visible(oid) {
            has_tooltip = true
            <-
        }
    }
    if !has_tooltip { << 0 }
    $candidates := false
    pcount := s.composition.popup_capable_ids.len
    for i in 0:pcount {
        pid := s.composition.popup_capable_ids[i]
        if pid > 0 && pid <= s.nodes.len && s.nodes[pid - 1].kind >= 0 && s.is_visible(pid) {
            popup := s.control_popup(pid) or >>
            if popup.width > 0.0 && popup.height > 0.0 {
                candidates = true
                <-
            }
        }
    }
    stamp := s.now
    ocount := s.composition.overlay_ids.len
    for i in 0:ocount {
        tid := s.composition.overlay_ids[i]
        if tid <= 0 || tid > s.nodes.len { -> }
        if s.nodes[tid - 1].kind != SCREEN_TOOLTIP || !s.is_visible(tid) { -> }
        anchor := s.overlays.anchors.get_or(tid,0)
        $blocked := candidates
        for j in 0:ocount {
            sid := s.composition.overlay_ids[j]
            if sid <= 0 || sid > s.nodes.len { -> }
            skind := s.nodes[sid - 1].kind
            if (skind == SCREEN_POPOVER || skind == SCREEN_MODAL) && s.is_visible(sid) && s.overlay_is_visible(sid) && !s.is_descendant(anchor,sid) { blocked = true }
        }
        $control := s.screen_take_tooltip(tid) or >>
        control.set_blocked(blocked,stamp) or (err) { s.screen_put_tooltip(tid,control.clone_tooltip())
            >> err }
        changed := control.needs_paint()
        s.screen_put_tooltip(tid,control)
        if changed { s.mark_paint_dirty() }
    }
    << 0
}
