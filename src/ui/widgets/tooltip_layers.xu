@ui/widgets
#errors

// Candidate lists and menus own their interaction plane. Tooltips inside an
// active modal/popover may still explain its controls, while background help
// is suspended. This policy is shared by dispatch, render and snapshot layout.
fn (s $&Screen) sync_tooltip_layers() int {
    $candidates := false
    for node in s.nodes {
        if node.kind >= SCREEN_CHECKBOX && node.kind < SCREEN_POPOVER && s.is_visible(node.id) {
            popup := s.control_popup(node.id) or >>
            if popup.width > 0.0 && popup.height > 0.0 { candidates = true
                <- }
        }
    }
    stamp := s.now
    for node in s.nodes {
        if node.kind != SCREEN_TOOLTIP || !s.is_visible(node.id) { -> }
        anchor := s.overlays.anchors.get_or(node.id,0)
        $blocked := candidates
        for surface in s.nodes {
            if (surface.kind == SCREEN_POPOVER || surface.kind == SCREEN_MODAL) && s.is_visible(surface.id) && s.overlay_is_visible(surface.id) && !s.is_descendant(anchor,surface.id) { blocked = true }
        }
        $control := s.screen_take_tooltip(node.id) or >>
        control.set_blocked(blocked,stamp) or (err) { s.screen_put_tooltip(node.id,control.clone_tooltip())
            >> err }
        changed := control.needs_paint()
        s.screen_put_tooltip(node.id,control)
        s.dirty = s.dirty || changed
    }
    << 0
}
