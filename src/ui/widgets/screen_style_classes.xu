@ui/widgets

#ui/draw
#errors
#math

fn valid_token_name(name &string) bool {
    if name.len <= 0 || name.len > 128 { << false }
    for i in 0:name.len {
        b := name[i] & 255
        if b == 9 || b == 0 { << false }
    }
    << true
}

fn scoped_token_key(id int,name &string) string {
    << str(id) + "\t" + name
}

fn string_vec_has(list &[]string,val &string) bool {
    target := val + ""
    for i in 0:list.len {
        if list[i] == target { << true }
    }
    << false
}

fn string_vec_add_unique(list $&[]string,val &string) bool {
    if string_vec_has(list,val) { << false }
    list.push(val + "")
    << true
}

fn string_vec_without(list &[]string,val &string) []string {
    target := val + ""
    $out := []string{}
    for i in 0:list.len {
        if list[i] != target { out.push(list[i] + "") }
    }
    << out
}

pub fn (s $&Screen) register_style_class(name string,patch &ControlStylePatch) int {
    s.check_screen() >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid style class name") }
    patch.validate() >>>
    comp := $&s.composition
    slots := $&comp.style_class_slots
    if slots.has(name) {
        idx := slots[name] - 1
        comp.style_class_values[idx] = patch.clone()
    } else if comp.style_class_free.len > 0 {
        flen := comp.style_class_free.len
        idx := comp.style_class_free[flen - 1]
        if flen <= 1 { comp.style_class_free = []int{} }
        else { comp.style_class_free = comp.style_class_free[0:flen - 1] }
        comp.style_class_values[idx] = patch.clone()
        slots[name + ""] = idx + 1
        comp.style_class_count = comp.style_class_count + 1
    } else {
        idx := comp.style_class_values.len
        vals := $&comp.style_class_values
        vals.push(patch.clone())
        slots[name + ""] = idx + 1
        comp.style_class_count = comp.style_class_count + 1
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) unregister_style_class(name string) int {
    s.check_screen() >>>
    if s.composition.style_class_slots.has(name) {
        comp := $&s.composition
        slots := $&comp.style_class_slots
        old := slots.take(name)
        if old > 0 {
            free := $&comp.style_class_free
            free.push(old - 1)
        }
        if comp.style_class_count > 0 { comp.style_class_count = comp.style_class_count - 1 }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s $&Screen) register_scope_class(name string,scope &StyleDelta) int {
    s.check_screen() >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid scope class name") }
    scope.validate() >>>
    comp := $&s.composition
    slots := $&comp.scope_class_slots
    if slots.has(name) {
        idx := slots[name] - 1
        comp.scope_class_values[idx] = scope.clone()
    } else if comp.scope_class_free.len > 0 {
        flen := comp.scope_class_free.len
        idx := comp.scope_class_free[flen - 1]
        if flen <= 1 { comp.scope_class_free = []int{} }
        else { comp.scope_class_free = comp.scope_class_free[0:flen - 1] }
        comp.scope_class_values[idx] = scope.clone()
        slots[name + ""] = idx + 1
        comp.scope_class_count = comp.scope_class_count + 1
    } else {
        idx := comp.scope_class_values.len
        vals := $&comp.scope_class_values
        vals.push(scope.clone())
        slots[name + ""] = idx + 1
        comp.scope_class_count = comp.scope_class_count + 1
    }
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) unregister_scope_class(name string) int {
    s.check_screen() >>>
    if s.composition.scope_class_slots.has(name) {
        comp := $&s.composition
        slots := $&comp.scope_class_slots
        old := slots.take(name)
        if old > 0 {
            free := $&comp.scope_class_free
            free.push(old - 1)
        }
        if comp.scope_class_count > 0 { comp.scope_class_count = comp.scope_class_count - 1 }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s $&Screen) add_class(id int,name string) int {
    _ := s.node(id) >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid class name") }
    if s.composition.node_classes.has(id) {
        existing := &s.composition.node_classes[id]
        if string_vec_has(existing,&name) { << 0 }
        if existing.len >= 32 { >>> errors.new("widgets: too many classes on node") }
    }
    comp := $&s.composition
    nc := $&comp.node_classes
    if !nc.has(id) {
        nc[id] = []string{}
        comp.node_class_count = comp.node_class_count + 1
    }
    $list := nc.take(id)
    _ := string_vec_add_unique($&list,&name)
    nc[id] = list
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) remove_class(id int,name string) int {
    _ := s.node(id) >>>
    if !s.composition.node_classes.has(id) { << 0 }
    if true {
        existing := &s.composition.node_classes[id]
        if !string_vec_has(existing,&name) { << 0 }
    }
    comp := $&s.composition
    nc := $&comp.node_classes
    old := nc.take(id)
    next := string_vec_without(&old,&name)
    if next.len == 0 {
        if comp.node_class_count > 0 { comp.node_class_count = comp.node_class_count - 1 }
        s.mark_layout_dirty()
        << 0
    }
    nc[id] = next
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) toggle_class(id int,name string) bool {
    has := s.has_class(id,name + "") >>>
    if has {
        s.remove_class(id,name + "") >>>
        << false
    }
    s.add_class(id,name) >>>
    << true
}

pub fn (s &Screen) has_class(id int,name string) bool {
    _ := s.node(id) >>>
    if s.composition.node_class_count == 0 || !s.composition.node_classes.has(id) { << false }
    list := &s.composition.node_classes[id]
    << string_vec_has(list,&name)
}

pub fn (s &Screen) node_classes(id int) []string {
    _ := s.node(id) >>>
    $out := []string{}
    if s.composition.node_class_count == 0 || !s.composition.node_classes.has(id) { << out }
    list := &s.composition.node_classes[id]
    for i in 0:list.len { out.push(list[i] + "") }
    << out
}

pub fn (s &Screen) nodes_with_class(name string) []int {
    $out := []int{}
    if s.composition.node_class_count == 0 || !valid_token_name(&name) { << out }
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid > 0 && nid <= s.nodes.len && s.nodes[nid - 1].kind >= 0 && s.composition.node_classes.has(nid) {
            list := &s.composition.node_classes[nid]
            if string_vec_has(list,&name) { out.push(nid) }
        }
    }
    << out
}

fn (s &Screen) node_has_active_scope_class(id int) bool {
    if s.composition.scope_class_count == 0 || s.composition.node_class_count == 0 || !s.composition.node_classes.has(id) {
        << false
    }
    list := &s.composition.node_classes[id]
    for i in 0:list.len {
        if s.composition.scope_class_slots.has(list[i]) { << true }
    }
    << false
}

fn (s &Screen) node_has_active_style_class(id int) bool {
    if s.composition.style_class_count == 0 || s.composition.node_class_count == 0 || !s.composition.node_classes.has(id) {
        << false
    }
    list := &s.composition.node_classes[id]
    for i in 0:list.len {
        if s.composition.style_class_slots.has(list[i]) { << true }
    }
    << false
}

fn (s &Screen) merged_scope_classes_for(id int) StyleDelta {
    $acc := style_delta()
    if s.composition.scope_class_count == 0 || s.composition.node_class_count == 0 || !s.composition.node_classes.has(id) {
        << acc
    }
    list := &s.composition.node_classes[id]
    for i in 0:list.len {
        cname := list[i]
        if s.composition.scope_class_slots.has(cname) {
            idx := s.composition.scope_class_slots[cname] - 1
            acc = acc.merge(&s.composition.scope_class_values[idx])
        }
    }
    << acc
}

fn (s &Screen) merged_style_classes_for(id int) ControlStylePatch {
    $acc := control_style_patch()
    if s.composition.style_class_count == 0 || s.composition.node_class_count == 0 || !s.composition.node_classes.has(id) {
        << acc
    }
    list := &s.composition.node_classes[id]
    for i in 0:list.len {
        cname := list[i]
        if s.composition.style_class_slots.has(cname) {
            idx := s.composition.style_class_slots[cname] - 1
            acc = acc.merge(&s.composition.style_class_values[idx])
        }
    }
    << acc
}

pub fn (s $&Screen) set_color_token(name string,color draw.Color) int {
    s.check_screen() >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid color token name") }
    comp := $&s.composition
    gct := $&comp.global_color_tokens
    gct[name + ""] = color
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) clear_color_token(name string) int {
    s.check_screen() >>>
    if s.composition.global_color_tokens.has(name) {
        comp := $&s.composition
        gct := $&comp.global_color_tokens
        gct.delete(name)
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s $&Screen) set_subtree_color_token(id int,name string,color draw.Color) int {
    _ := s.node(id) >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid color token name") }
    k := scoped_token_key(id,&name)
    comp := $&s.composition
    nct := $&comp.node_color_tokens
    nct[k] = color
    nctk := $&comp.node_color_token_keys
    if !nctk.has(id) { nctk[id] = []string{} }
    $klist := nctk.take(id)
    _ := string_vec_add_unique($&klist,&name)
    nctk[id] = klist
    s.mark_paint_dirty()
    << 0
}

pub fn (s $&Screen) clear_subtree_color_token(id int,name string) int {
    _ := s.node(id) >>>
    k := scoped_token_key(id,&name)
    if s.composition.node_color_tokens.has(k) {
        comp := $&s.composition
        nct := $&comp.node_color_tokens
        nct.delete(k)
        if comp.node_color_token_keys.has(id) {
            nctk := $&comp.node_color_token_keys
            old := nctk.take(id)
            next := string_vec_without(&old,&name)
            if next.len == 0 {
                s.mark_paint_dirty()
                << 0
            }
            nctk[id] = next
        }
        s.mark_paint_dirty()
    }
    << 0
}

pub fn (s &Screen) color_token(id int,name string,fallback draw.Color) draw.Color {
    if !valid_token_name(&name) { << fallback }
    if id > 0 && id <= s.nodes.len && s.nodes[id - 1].kind >= 0 {
        $cur := id
        $budget := s.nodes.len + 1
        while cur > 0 && cur <= s.nodes.len && budget > 0 {
            if s.composition.node_color_token_keys.has(cur) {
                k := scoped_token_key(cur,&name)
                if s.composition.node_color_tokens.has(k) {
                    << s.composition.node_color_tokens[k]
                }
            }
            n := s.nodes[cur - 1]
            if n.kind < 0 || n.parent <= 0 { <- }
            cur = n.parent
            budget -= 1
        }
    }
    if s.composition.global_color_tokens.has(name) {
        << s.composition.global_color_tokens[name]
    }
    << fallback
}

pub fn (s $&Screen) set_metric_token(name string,value f64) int {
    s.check_screen() >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid metric token name") }
    if math.is_nan(value) || math.is_inf(value) { >>> errors.new("widgets: invalid metric token value") }
    comp := $&s.composition
    gmt := $&comp.global_metric_tokens
    gmt[name + ""] = value
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_metric_token(name string) int {
    s.check_screen() >>>
    if s.composition.global_metric_tokens.has(name) {
        comp := $&s.composition
        gmt := $&comp.global_metric_tokens
        gmt.delete(name)
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s $&Screen) set_subtree_metric_token(id int,name string,value f64) int {
    _ := s.node(id) >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid metric token name") }
    if math.is_nan(value) || math.is_inf(value) { >>> errors.new("widgets: invalid metric token value") }
    k := scoped_token_key(id,&name)
    comp := $&s.composition
    nmt := $&comp.node_metric_tokens
    nmt[k] = value
    nmtk := $&comp.node_metric_token_keys
    if !nmtk.has(id) { nmtk[id] = []string{} }
    $klist := nmtk.take(id)
    _ := string_vec_add_unique($&klist,&name)
    nmtk[id] = klist
    s.mark_layout_dirty()
    << 0
}

pub fn (s $&Screen) clear_subtree_metric_token(id int,name string) int {
    _ := s.node(id) >>>
    k := scoped_token_key(id,&name)
    if s.composition.node_metric_tokens.has(k) {
        comp := $&s.composition
        nmt := $&comp.node_metric_tokens
        nmt.delete(k)
        if comp.node_metric_token_keys.has(id) {
            nmtk := $&comp.node_metric_token_keys
            old := nmtk.take(id)
            next := string_vec_without(&old,&name)
            if next.len == 0 {
                s.mark_layout_dirty()
                << 0
            }
            nmtk[id] = next
        }
        s.mark_layout_dirty()
    }
    << 0
}

pub fn (s &Screen) metric_token(id int,name string,fallback f64) f64 {
    if !valid_token_name(&name) { << fallback }
    if id > 0 && id <= s.nodes.len && s.nodes[id - 1].kind >= 0 {
        $cur := id
        $budget := s.nodes.len + 1
        while cur > 0 && cur <= s.nodes.len && budget > 0 {
            if s.composition.node_metric_token_keys.has(cur) {
                k := scoped_token_key(cur,&name)
                if s.composition.node_metric_tokens.has(k) {
                    << s.composition.node_metric_tokens[k]
                }
            }
            n := s.nodes[cur - 1]
            if n.kind < 0 || n.parent <= 0 { <- }
            cur = n.parent
            budget -= 1
        }
    }
    if s.composition.global_metric_tokens.has(name) {
        << s.composition.global_metric_tokens[name]
    }
    << fallback
}

pub fn (s $&Screen) set_attr(id int,key string,value string) int {
    _ := s.node(id) >>>
    if !valid_token_name(&key) { >>> errors.new("widgets: invalid node attribute key") }
    k := scoped_token_key(id,&key)
    if s.composition.node_attr_keys.has(id) && !s.composition.node_attrs.has(k) {
        existing := &s.composition.node_attr_keys[id]
        if existing.len >= 64 { >>> errors.new("widgets: too many attributes on node") }
    }
    comp := $&s.composition
    na := $&comp.node_attrs
    na[k] = value + ""
    nak := $&comp.node_attr_keys
    if !nak.has(id) { nak[id] = []string{} }
    $klist := nak.take(id)
    _ := string_vec_add_unique($&klist,&key)
    nak[id] = klist
    << 0
}

pub fn (s &Screen) attr(id int,key string) string {
    _ := s.node(id) >>>
    if !valid_token_name(&key) { << "" }
    k := scoped_token_key(id,&key)
    << s.composition.node_attrs.get_or(k,"")
}

pub fn (s &Screen) has_attr(id int,key string) bool {
    _ := s.node(id) >>>
    if !valid_token_name(&key) { << false }
    k := scoped_token_key(id,&key)
    << s.composition.node_attrs.has(k)
}

pub fn (s $&Screen) remove_attr(id int,key string) int {
    _ := s.node(id) >>>
    if !valid_token_name(&key) { << 0 }
    k := scoped_token_key(id,&key)
    if s.composition.node_attrs.has(k) {
        comp := $&s.composition
        na := $&comp.node_attrs
        na.delete(k)
        if comp.node_attr_keys.has(id) {
            nak := $&comp.node_attr_keys
            old := nak.take(id)
            next := string_vec_without(&old,&key)
            if next.len == 0 { << 0 }
            nak[id] = next
        }
    }
    << 0
}

pub fn (s &Screen) nodes_with_attr(key string,value string) []int {
    $out := []int{}
    if !valid_token_name(&key) { << out }
    want_val := value + ""
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len || s.nodes[nid - 1].kind < 0 { -> }
        k := scoped_token_key(nid,&key)
        if s.composition.node_attrs.has(k) {
            if want_val.len == 0 || (s.composition.node_attrs.get_or(k,"") + "") == want_val { out.push(nid) }
        }
    }
    << out
}

pub fn (s &Screen) query_in_subtree(root int,class_name string,attr_key string,attr_val string) []int {
    if root != 0 { _ := s.node(root) >>> }
    $out := []int{}
    check_cls := class_name.len > 0
    if check_cls && (s.composition.node_class_count == 0 || !valid_token_name(&class_name)) { << out }
    check_attr := attr_key.len > 0
    if check_attr && !valid_token_name(&attr_key) { << out }
    want_val := attr_val + ""
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len || s.nodes[nid - 1].kind < 0 { -> }
        if root != 0 && nid != root && !s.is_descendant(nid,root) { -> }
        if check_cls {
            if !s.composition.node_classes.has(nid) { -> }
            list := &s.composition.node_classes[nid]
            if !string_vec_has(list,&class_name) { -> }
        }
        if check_attr {
            ak := scoped_token_key(nid,&attr_key)
            if !s.composition.node_attrs.has(ak) { -> }
            if want_val.len > 0 && (s.composition.node_attrs.get_or(ak,"") + "") != want_val { -> }
        }
        out.push(nid)
    }
    << out
}

pub fn (s &Screen) find_ancestor_with_class(id int,class_name string) int {
    _ := s.node(id) >>>
    if s.composition.node_class_count == 0 || !valid_token_name(&class_name) { << 0 }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        if s.composition.node_classes.has(cur) {
            list := &s.composition.node_classes[cur]
            if string_vec_has(list,&class_name) { << cur }
        }
        if n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << 0
}

pub fn (s &Screen) find_ancestor_with_attr(id int,key string) int {
    _ := s.node(id) >>>
    if !valid_token_name(&key) { << 0 }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        ak := scoped_token_key(cur,&key)
        if s.composition.node_attrs.has(ak) { << cur }
        if n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << 0
}

pub fn (s $&Screen) set_class_for_all(ids &[]int,name string,enabled bool) int {
    s.check_screen() >>>
    if !valid_token_name(&name) { >>> errors.new("widgets: invalid class name") }
    for i in 0:ids.len {
        nid := ids[i]
        if enabled { s.add_class(nid,name + "") >>> }
        else { s.remove_class(nid,name + "") >>> }
    }
    << 0
}

fn (s $&Screen) cleanup_classes_tokens_attrs_for(id int) {
    comp := $&s.composition
    if comp.node_classes.has(id) {
        nc := $&comp.node_classes
        nc.delete(id)
        if comp.node_class_count > 0 { comp.node_class_count = comp.node_class_count - 1 }
    }
    if comp.node_color_token_keys.has(id) {
        nctk := $&comp.node_color_token_keys
        keys := nctk.take(id)
        nct := $&comp.node_color_tokens
        for i in 0:keys.len {
            k := scoped_token_key(id,&keys[i])
            if nct.has(k) { nct.delete(k) }
        }
    }
    if comp.node_metric_token_keys.has(id) {
        nmtk := $&comp.node_metric_token_keys
        keys := nmtk.take(id)
        nmt := $&comp.node_metric_tokens
        for i in 0:keys.len {
            k := scoped_token_key(id,&keys[i])
            if nmt.has(k) { nmt.delete(k) }
        }
    }
    if comp.node_attr_keys.has(id) {
        nak := $&comp.node_attr_keys
        keys := nak.take(id)
        na := $&comp.node_attrs
        for i in 0:keys.len {
            k := scoped_token_key(id,&keys[i])
            if na.has(k) { na.delete(k) }
        }
    }
}
