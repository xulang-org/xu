@ui/widgets

#ui
#ui/layout
#time
#errors

// Full ControlStyle overrides remain intact across the Screen adapter.
pub fn (s $&Screen) set_control_style(id int,style &ControlStyle) int {
    validate_control(style) or >>
    n := s.node(id) or >>
    if screen_visual_kind(n.kind) { << s.visual_style(id,style) or >> }
    if n.kind == SCREEN_LABEL { s.basics.label_styles[id] = encode_control_style(style)
        s.dirty = true
        << 0 }
    if screen_basic_kind(n.kind) { s.basic_style(id,style) or >>
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_BUTTON { $item := s.take_button(id)
        result := screen_override_button($&item,style)
        s.buttons[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TABLE { controls := $&s.controls
        items := $&controls.tables
        $item := items.take(id)
        result := screen_override_tables($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TREE { controls := $&s.controls
        items := $&controls.trees
        $item := items.take(id)
        result := screen_override_trees($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_PAGINATION { controls := $&s.controls
        items := $&controls.pages
        $item := items.take(id)
        result := screen_override_pages($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_BREADCRUMBS { controls := $&s.controls
        items := $&controls.crumbs
        $item := items.take(id)
        result := screen_override_crumbs($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_COMBO { controls := $&s.controls
        items := $&controls.combos
        $item := items.take(id)
        result := screen_override_combos($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_MULTI { controls := $&s.controls
        items := $&controls.multis
        $item := items.take(id)
        result := screen_override_multis($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_COLOR { controls := $&s.controls
        items := $&controls.colors
        $item := items.take(id)
        result := screen_override_colors($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_DATE { controls := $&s.controls
        items := $&controls.dates
        $item := items.take(id)
        result := screen_override_dates($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_CLOCK { controls := $&s.controls
        items := $&controls.clocks
        $item := items.take(id)
        result := screen_override_clocks($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_SPINNER { controls := $&s.controls
        items := $&controls.spinners
        $item := items.take(id)
        result := screen_override_spinners($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_EDITOR { controls := $&s.controls
        items := $&controls.editors
        $item := items.take(id)
        result := screen_override_editors($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_FIELD { controls := $&s.controls
        items := $&controls.fields
        $item := items.take(id)
        result := screen_override_fields($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TASK { controls := $&s.controls
        items := $&controls.tasks
        $item := items.take(id)
        result := screen_override_tasks($&item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_POPOVER { $item := s.screen_take_popover(id) or >>
        result := screen_override_popover($&item,style)
        s.screen_put_popover(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOOLTIP { $item := s.screen_take_tooltip(id) or >>
        result := screen_override_tooltip($&item,style)
        s.screen_put_tooltip(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOAST { $item := s.screen_take_toast(id) or >>
        result := screen_override_toast($&item,style)
        s.screen_put_toast(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_MODAL { $item := s.screen_take_modal(id) or >>
        result := screen_override_modal($&item,style)
        s.screen_put_modal(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    >> errors.new("widgets: control does not support this style")
}
fn screen_override_button(item $&Button,style &ControlStyle) string { item.set_style(style) or (err) { << err.msg() }
    << "" }
fn screen_override_tables(item $&Table,style &ControlStyle) string { item.set_style(style) or (err) { << err.msg() }
    << "" }
