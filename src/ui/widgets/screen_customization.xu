    << "" }

pub fn (s $&Screen) set_button_variant(id int,variant int) int {
    n := s.node(id) or >>
    if n.kind != SCREEN_BUTTON { >> errors.new("widgets: expected a button") }
    if variant < BUTTON_PRIMARY || variant > BUTTON_SUBTLE { >> errors.new("widgets: invalid button variant") }
    s.button_variants[id] = variant
    s.dirty = true
    << 0
}
fn (s &Screen) screen_button_style(id int,item &Button,styles &Styles) ControlStyle {
    if item.has_style() { << item.style_or(styles) }
    if s.button_variants.has(id) { << styles.button_variant(s.button_variants[id]) or >> }
    << styles.button.clone()
}
pub fn (s $&Screen) set_option_text(id int,index int,value string) int {
    n := s.node(id) or >>
    validate_table_text(&value) or >>
    if !screen_basic_kind(n.kind) || index < 0 || id > s.basics.counts.len || index >= s.basics.counts[id - 1] { >> errors.new("widgets: invalid option label") }
    key := id * 1024 + index
    $label := s.take_basic_label(key)
    label.set_text(&value)
    s.basics.labels[key] = label
    s.dirty = true
    << 0
}
pub fn (s $&Screen) set_slider_commit_only(id int,enabled bool) int {
    n := s.node(id) or >>
    if n.kind != SCREEN_SLIDER { >> errors.new("widgets: expected slider") }
    $item := s.take_basic_sliders(id)
    item.set_commit_only(enabled)
    s.basics.sliders[id] = item
    << 0
}

