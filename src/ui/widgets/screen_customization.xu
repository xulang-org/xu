pub fn (s $&Screen) set_motion(id int,spec &MotionSpec) int {
    spec.validate() or >>
    n := s.node(id) or >>
    if screen_visual_kind(n.kind) { << s.visual_motion(id,spec) or >> }
    if n.kind == SCREEN_CHECKBOX { $item := s.take_basic_checks(id)
        message := screen_selection_motion_checks($&item,spec)
        s.basics.checks[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_RADIO { $item := s.take_basic_radios(id)
        message := screen_selection_motion_radios($&item,spec)
        s.basics.radios[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_BUTTON { $motion := s.take_button_transition(id)
        message := screen_set_motion_transition($&motion,spec)
        s.button_transitions[id] = motion
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TREE { controls := $&s.controls
        items := $&controls.trees
        $item := items.take(id)
        message := screen_set_motion_trees($&item,spec)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_FIELD { controls := $&s.controls
        items := $&controls.fields
        $item := items.take(id)
        message := screen_set_motion_fields($&item,spec)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TASK { controls := $&s.controls
        items := $&controls.tasks
        $item := items.take(id)
        message := screen_set_motion_tasks($&item,spec)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_PAGINATION { $item := s.take_pagination(id) or >>
        message := screen_set_motion_pages($&item,spec)
        s.controls.pages[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_POPOVER { $item := s.screen_take_popover(id) or >>
        message := screen_set_motion_popover($&item,spec)
        s.screen_put_popover(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOOLTIP { $item := s.screen_take_tooltip(id) or >>
        message := screen_set_motion_tooltip($&item,spec)
        s.screen_put_tooltip(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOAST { $item := s.screen_take_toast(id) or >>
        message := screen_set_motion_toast($&item,spec)
        s.screen_put_toast(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_MODAL { $item := s.screen_take_modal(id) or >>
        message := screen_set_motion_modal($&item,spec)
        s.screen_put_modal(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_SWITCH { $item := s.take_basic_switches(id)
        message := screen_set_motion_switch($&item,spec)
        s.basics.switches[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    >> errors.new("widgets: this control has no scheduled motion")
}
