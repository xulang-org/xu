@ui/widgets

#ui
#ui/layout
#time
#errors

// Full ControlStyle overrides remain intact across the Screen adapter.
pub fn (s &mut Screen) set_control_style(id int,style &ControlStyle) int {
    validate_control(style) or >>
    n := s.node(id) or >>
    if screen_visual_kind(n.kind) { << s.visual_style(id,style) or >> }
    if n.kind == SCREEN_LABEL { s.basics.label_styles[id] = encode_control_style(style)
        s.dirty = true
        << 0 }
    if screen_basic_kind(n.kind) { s.basic_style(id,style) or >>
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_BUTTON { mut item := s.take_button(id)
        result := screen_override_button(mut &item,style)
        s.buttons[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TABLE { controls := mut &s.controls
        items := mut &controls.tables
        mut item := items.take(id)
        result := screen_override_tables(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TREE { controls := mut &s.controls
        items := mut &controls.trees
        mut item := items.take(id)
        result := screen_override_trees(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_PAGINATION { controls := mut &s.controls
        items := mut &controls.pages
        mut item := items.take(id)
        result := screen_override_pages(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_BREADCRUMBS { controls := mut &s.controls
        items := mut &controls.crumbs
        mut item := items.take(id)
        result := screen_override_crumbs(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_COMBO { controls := mut &s.controls
        items := mut &controls.combos
        mut item := items.take(id)
        result := screen_override_combos(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_MULTI { controls := mut &s.controls
        items := mut &controls.multis
        mut item := items.take(id)
        result := screen_override_multis(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_COLOR { controls := mut &s.controls
        items := mut &controls.colors
        mut item := items.take(id)
        result := screen_override_colors(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_DATE { controls := mut &s.controls
        items := mut &controls.dates
        mut item := items.take(id)
        result := screen_override_dates(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_CLOCK { controls := mut &s.controls
        items := mut &controls.clocks
        mut item := items.take(id)
        result := screen_override_clocks(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_SPINNER { controls := mut &s.controls
        items := mut &controls.spinners
        mut item := items.take(id)
        result := screen_override_spinners(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_EDITOR { controls := mut &s.controls
        items := mut &controls.editors
        mut item := items.take(id)
        result := screen_override_editors(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_FIELD { controls := mut &s.controls
        items := mut &controls.fields
        mut item := items.take(id)
        result := screen_override_fields(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TASK { controls := mut &s.controls
        items := mut &controls.tasks
        mut item := items.take(id)
        result := screen_override_tasks(mut &item,style)
        items[id] = item
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_POPOVER { mut item := s.screen_take_popover(id) or >>
        result := screen_override_popover(mut &item,style)
        s.screen_put_popover(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOOLTIP { mut item := s.screen_take_tooltip(id) or >>
        result := screen_override_tooltip(mut &item,style)
        s.screen_put_tooltip(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOAST { mut item := s.screen_take_toast(id) or >>
        result := screen_override_toast(mut &item,style)
        s.screen_put_toast(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_MODAL { mut item := s.screen_take_modal(id) or >>
        result := screen_override_modal(mut &item,style)
        s.screen_put_modal(id,item)
        if result.len > 0 { >> errors.new(result) }
        s.dirty = true
        << 0 }
    >> errors.new("widgets: control does not support this style")
}
fn screen_override_button(item &mut Button,style &ControlStyle) string { item.set_style(style) or (err) { << err.msg() }
    << "" }
fn screen_override_tables(item &mut Table,style &ControlStyle) string { item.set_style(style) or (err) { << err.msg() }
    << "" }
