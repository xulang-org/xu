pub fn (s &mut Screen) set_motion(id int,spec &MotionSpec) int {
    spec.validate() or >>
    n := s.node(id) or >>
    if screen_visual_kind(n.kind) { << s.visual_motion(id,spec) or >> }
    if n.kind == SCREEN_CHECKBOX { mut item := s.take_basic_checks(id)
        message := screen_selection_motion_checks(mut &item,spec)
        s.basics.checks[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_RADIO { mut item := s.take_basic_radios(id)
        message := screen_selection_motion_radios(mut &item,spec)
        s.basics.radios[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_BUTTON { mut motion := s.take_button_transition(id)
        message := screen_set_motion_transition(mut &motion,spec)
        s.button_transitions[id] = motion
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TREE { controls := mut &s.controls
        items := mut &controls.trees
        mut item := items.take(id)
        message := screen_set_motion_trees(mut &item,spec)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_FIELD { controls := mut &s.controls
        items := mut &controls.fields
        mut item := items.take(id)
        message := screen_set_motion_fields(mut &item,spec)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TASK { controls := mut &s.controls
        items := mut &controls.tasks
        mut item := items.take(id)
        message := screen_set_motion_tasks(mut &item,spec)
        items[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_PAGINATION { mut item := s.take_pagination(id) or >>
        message := screen_set_motion_pages(mut &item,spec)
        s.controls.pages[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_POPOVER { mut item := s.screen_take_popover(id) or >>
        message := screen_set_motion_popover(mut &item,spec)
        s.screen_put_popover(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOOLTIP { mut item := s.screen_take_tooltip(id) or >>
        message := screen_set_motion_tooltip(mut &item,spec)
        s.screen_put_tooltip(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_TOAST { mut item := s.screen_take_toast(id) or >>
        message := screen_set_motion_toast(mut &item,spec)
        s.screen_put_toast(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_MODAL { mut item := s.screen_take_modal(id) or >>
        message := screen_set_motion_modal(mut &item,spec)
        s.screen_put_modal(id,item)
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    if n.kind == SCREEN_SWITCH { mut item := s.take_basic_switches(id)
        message := screen_set_motion_switch(mut &item,spec)
        s.basics.switches[id] = item
        if message.len > 0 { >> errors.new(message) }
        s.dirty = true
        << 0 }
    >> errors.new("widgets: this control has no scheduled motion")
}
fn screen_set_motion_transition(item &mut PaintTransition,spec &MotionSpec) string { item.set_spec(spec) or (err) { << err.msg() }
    << "" }
