@ui/widgets

#ui
#ui/draw
#errors
#time

fn screen_set_tree_appearance(item $&TreeView,appearance &TreeAppearance) string {
    item.set_appearance(appearance) or (err) { << err.msg() }
    << ""
}
pub fn (s $&Screen) set_tree_appearance(id int,appearance &TreeAppearance) int {
    screen_node := s.node(id) or >>
    if screen_node.kind != SCREEN_TREE { >> errors.new("widgets: wrong screen control type") }
    controls := $&s.controls
    items := $&controls.trees
    if !items.has(id) { >> errors.new("widgets: screen control state is unavailable") }
    $item := items.take(id)
    message := screen_set_tree_appearance($&item,appearance)
    items[id] = item
    if message.len > 0 { >> errors.new(message) }
    s.invalidate()
    << 0
}

