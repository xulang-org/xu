fn screen_tick_tree(item $&TreeView,now time.Instant,reduced bool) ScreenAnimation {
    changed := item.tick(now,reduced) or (err) { << ScreenAnimation{changed: false,deadline: time.zero_instant()} }
    deadline := item.next_tick(now) or (err) { << ScreenAnimation{changed: changed,deadline: time.zero_instant()} }
    << ScreenAnimation{changed: changed,deadline: deadline}
}
