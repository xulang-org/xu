@ui/widgets
#ui/draw
#ui/layout
#math
#errors

pub struct ListAppearance {
    pub row_height f64
    pub leading_size f64
    pub gap f64
    pub detail_width f64
    pub secondary bool
}
pub fn list_appearance() ListAppearance {
    << ListAppearance{row_height: 0.0,leading_size: 18.0,gap: 10.0,detail_width: 96.0,secondary: false}
}
pub fn (appearance &ListAppearance) validate() int {
    if !finite_metric(appearance.row_height,256.0) || !finite_metric(appearance.leading_size,64.0) ||
        !finite_metric(appearance.gap,64.0) || !finite_metric(appearance.detail_width,512.0) {
        >> errors.new("widgets: invalid list appearance")
    }
    << 0
}
pub fn (lb $&ListBox) set_appearance(appearance &ListAppearance) int {
    appearance.validate() or >>
    lb.appearance = ListAppearance{row_height: appearance.row_height,leading_size: appearance.leading_size,gap: appearance.gap,
        detail_width: appearance.detail_width,secondary: appearance.secondary}
    lb.dirty = true
    << 0
}
fn (lb &ListBox) styled_row_height(styles &Styles) f64 {
    c := lb.style_or(styles)
    size := styles.text_options(&c).size
    $text_height := size * 1.5 + 8.0 * styles.density
    if lb.appearance.secondary { text_height = size * 2.7 + 12.0 * styles.density }
    << math.max(math.max(c.indicator_size,lb.appearance.row_height) * styles.density,text_height)
}
pub fn (lb &ListBox) item_bounds(index int,styles &Styles) layout.Rect {
    if index < 0 || index >= lb.count_val { >> errors.new("widgets: list row out of range") }
    c := lb.style_or(styles)
    d := styles.density
    width := math.max(0.0,lb.bounds.width - (c.padding.left + c.padding.right) * d)
    height := math.max(0.0,lb.bounds.height - (c.padding.top + c.padding.bottom) * d)
    rh := lb.styled_row_height(styles)
    $row_width := width
    if f64(lb.count_val) * rh > height { row_width = math.max(0.0,width - math.max(4.0,c.mark_width) * d - 4.0 * d) }
    << layout.Rect{x: lb.bounds.x + c.padding.left * d,y: lb.bounds.y + c.padding.top * d + f64(index) * rh - lb.scroll_y,width: row_width,height: rh}
}
pub struct ListRow {
    pub title string
    pub description string
    pub detail string
    pub icon int
}
pub fn list_row(title string) ListRow { << ListRow{title: title,description: "",detail: "",icon: TREE_ICON_NONE} }
pub fn (row &ListRow) validate() int {
    validate_table_text(&row.title) or >>
    validate_table_text(&row.description) or >>
    validate_table_text(&row.detail) or >>
    if row.icon < TREE_ICON_NONE || row.icon > TREE_ICON_FILE { >> errors.new("widgets: invalid list icon") }
    << 0
}
pub fn (lb &ListBox) paint_row_styled(frame $&draw.Frame,index int,title $&StyledLabel,description $&StyledLabel,detail $&StyledLabel,icon int,styles &Styles) int {
    row := lb.item_bounds(index,styles) or >>
    c := lb.style_or(styles)
    d := styles.density
    viewport := layout.Rect{x: lb.bounds.x + c.padding.left * d,y: lb.bounds.y + c.padding.top * d,
        width: math.max(0.0,lb.bounds.width - (c.padding.left + c.padding.right) * d),height: math.max(0.0,lb.bounds.height - (c.padding.top + c.padding.bottom) * d)}
    visible := layout.intersect(&row,&viewport) or >>
    if visible.width <= 0.0 || visible.height <= 0.0 { << 0 }
    state := lb.item_visual_state(index)
    resolved := c.resolve(state)
    frame.push() or >>
    frame.clip_rect(visible.x,visible.y,visible.width,visible.height) or >>
    if index == lb.selected_val || index == lb.hovered_idx || index == lb.armed_idx { rounded_fill(frame,&row,math.max(2.0,(c.radius - 2.0) * d),resolved.background) or >> }
    $x := row.x + 8.0 * d
    if icon != TREE_ICON_NONE {
        side := math.min(lb.appearance.leading_size * d,row.height - 8.0 * d)
        box := layout.Rect{x: x,y: row.y + (row.height - side) * 0.5,width: side,height: side}
        tree_icon(frame,&box,icon == TREE_ICON_FOLDER,resolved.foreground) or >>
        x += side + lb.appearance.gap * d
    }
    $text_style := c.clone()
    text_style.palette.foreground = resolved.foreground
    text_style.states = []StatePaint{}
    text_style.align_x = 0.0
    text_style.padding = layout.Insets{left: 0.0,top: 0.0,right: 0.0,bottom: 0.0}
    $tail_width := 0.0
    if detail.value.len > 0 { tail_width = math.min(lb.appearance.detail_width * d,math.max(0.0,row.width * 0.35)) }
    text_width := math.max(0.0,row.x + row.width - x - 8.0 * d - tail_width)
    main_size := title.measure_styled(styles,&text_style) or >>
    $main_y := row.y + (row.height - main_size.height) * 0.5
    if description.value.len > 0 { main_y = row.y + math.max(4.0 * d,(row.height - main_size.height * 1.85) * 0.5) }
    area := layout.Rect{x: x,y: main_y,width: text_width,height: main_size.height}
    title.paint_text_styled(frame,&area,styles,&text_style,0) or >>
    if description.value.len > 0 {
        text_style.palette.foreground = fade_color(resolved.foreground,0.74)
        frame.push() or >>
        frame.translate(x,main_y + main_size.height) or >>
        frame.scale(0.85,0.85) or >>
        second := layout.Rect{x: 0.0,y: 0.0,width: text_width / 0.85,height: main_size.height}
        description.paint_text_styled(frame,&second,styles,&text_style,0) or >>
        frame.pop() or >>
    }
    if tail_width > 0.0 {
        text_style.align_x = 1.0
        text_style.palette.foreground = fade_color(resolved.foreground,0.78)
        tail := layout.Rect{x: row.x + row.width - 8.0 * d - tail_width,y: row.y,width: tail_width,height: row.height}
        detail.paint_text_styled(frame,&tail,styles,&text_style,0) or >>
    }
    frame.pop() or >>
    << 0
}
fn screen_paint_list_row(item &ListBox,title $&StyledLabel,description $&StyledLabel,detail $&StyledLabel,icon int,frame $&draw.Frame,styles &Styles,index int) string {
    item.paint_row_styled(frame,index,title,description,detail,icon,styles) or (err) { << err.msg() }
    << ""
}
fn (s $&Screen) take_list_label(key int,detail bool) StyledLabel {
    context := s.context.clone()
    basic := $&s.basics
    if detail { items := $&basic.details
        if items.has(key) { << items.take(key) } }
    else { items := $&basic.secondary
        if items.has(key) { << items.take(key) } }
    << styled_label(&context,&"")
}
pub fn (s $&Screen) set_list_row(id int,index int,row &ListRow) int {
    n := s.node(id) or >>
    if n.kind != SCREEN_LIST || index < 0 || index >= s.basics.counts[id - 1] { >> errors.new("widgets: invalid list row") }
    row.validate() or >>
    s.set_option_text(id,index,row.title + "") or >>
    key := id * 1024 + index
    $secondary := s.take_list_label(key,false)
    secondary.set_text(&row.description)
    s.basics.secondary[key] = secondary
    $detail := s.take_list_label(key,true)
    detail.set_text(&row.detail)
    s.basics.details[key] = detail
    s.basics.list_icons[key] = row.icon
    if row.description.len > 0 {
        $item := s.take_basic_lists(id)
        item.appearance.secondary = true
        item.invalidate()
        s.basics.lists[id] = item
    }
    s.dirty = true
    << 0
}
