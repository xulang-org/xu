@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

// Screen owns built-in controls and their native resources. Handles are local
// to this screen and never reused; applications keep only business state.
const screen_group = 0
const screen_label = 1
const screen_button = 2
const screen_table = 10
const screen_tree = 11
const screen_pagination = 12
const screen_breadcrumbs = 13
const screen_combo = 20
const screen_multi = 21
const screen_color = 22
const screen_date = 23
const screen_clock = 24
const screen_spinner = 25
const screen_editor = 26
const screen_popover = 30
const screen_tooltip = 31
const screen_toast = 32
const screen_modal = 33
pub const action_key = 5

struct ScreenNode {
    id int
    kind int
    parent int
    bounds layout.Rect
    local layout.Rect
    visible bool
    enabled bool
    focusable bool
    cursor int
}
struct ScreenAnimation { changed bool
    deadline time.Instant }
pub struct Screen {
    identity ui.CanvasEvent
    context draw.Context
    window ui.Window
    frames map[int]draw.Frame
    styles Styles
    nodes []ScreenNode
    buttons map[int]Button
    texts []string
    descriptions []string
    text_sizes []f64
    muted []bool
    labels map[int]TextCache
    controls ScreenControls
    overlays ScreenOverlays
    focused int
    captured int
    hovered int
    pointer int
    now time.Instant
    reduced bool
    width f64
    height f64
    dirty bool
    closed bool
    disposed bool
}
fn screen_empty() layout.Rect { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
fn screen_earlier(a time.Instant,b time.Instant) time.Instant {
    if a.is_zero() || (!b.is_zero() && b.before(a)) { << b }
    << a
}
pub fn screen(ready &ui.Event) Screen {
    identity := ui.canvas_of(ready) or >>
    context := draw.context_of(ready) or >>
    window := ui.Window{id: identity.window_id,generation: identity.generation,title: "",width: 0,height: 0,
        content_kind: ui.content_draw,content_backend_id: identity.canvas_id,closed: 0}
    window.content_command("input_enabled\t1") or >>
    window.content_command("pan_enabled\t0") or >>
    ui.request_canvas_preferences(&identity) or >>
    mut frames := map[int]draw.Frame{}
    frames[1] = context.new_frame(32768)
    << Screen{identity: copy_identity(&identity),context: context.clone(),window: window,frames: frames,
        styles: light_styles(),nodes: []ScreenNode{},buttons: map[int]Button{},texts: []string{},descriptions: []string{},
        text_sizes: []f64{},muted: []bool{},labels: map[int]TextCache{},controls: new_screen_controls(),overlays: new_screen_overlays(),
        focused: 0,captured: 0,hovered: 0,pointer: ui.cursor_default,now: time.instant(),reduced: false,
        width: 800.0,height: 600.0,dirty: true,closed: false,disposed: false}
}
fn (s &Screen) check_screen() int {
    if s.disposed || s.closed { >> errors.new("widgets: screen is closed") }
    << 0
}
fn (s &Screen) node(id int) ScreenNode {
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 { >> errors.new("widgets: invalid screen handle") }
    << s.nodes[id - 1]
}
fn (s &mut Screen) add_node(kind int,focusable bool,cursor int) int {
    s.check_screen() or >>
    if s.nodes.len >= 512 { >> errors.new("widgets: screen control capacity exceeded") }
    id := s.nodes.len + 1
    empty := screen_empty()
    s.nodes.push(ScreenNode{id: id,kind: kind,parent: 0,bounds: empty,local: empty,
        visible: true,enabled: true,focusable: focusable,cursor: cursor})
    s.texts.push("")
    s.descriptions.push("")
    s.text_sizes.push(0.0)
    s.muted.push(false)
    s.dirty = true
    << id
}
fn (s &mut Screen) abandon_node(id int) {
    if id > 0 && id <= s.nodes.len { s.nodes[id - 1].kind = -1
        s.nodes[id - 1].visible = false
        s.nodes[id - 1].enabled = false }
}
pub fn (s &Screen) is_open() bool { << !s.closed && !s.disposed }
pub fn (s &Screen) width() f64 { << s.width }
pub fn (s &Screen) height() f64 { << s.height }
pub fn (s &Screen) focused() int { << s.focused }
pub fn (s &Screen) reduced_motion() bool { << s.reduced }
pub fn (s &Screen) viewport() layout.Rect { << layout.Rect{x: 0.0,y: 0.0,width: s.width,height: s.height} }
pub fn (s &mut Screen) invalidate() { s.dirty = true }
pub fn (s &mut Screen) resize(width f64,height f64) int {
    validate_bounds(&layout.Rect{x: 0.0,y: 0.0,width: width,height: height}) or >>
    if width <= 0.0 || height <= 0.0 { >> errors.new("widgets: screen needs positive dimensions") }
    if width != s.width || height != s.height { s.width = width
        s.height = height
        s.dirty = true }
    << 0
}
pub fn (s &mut Screen) set_min_size(width int,height int) int { << s.window.command("minsize\t" + str(width) + "\t" + str(height)) or >> }
pub fn (s &mut Screen) set_styles(styles &Styles) int {
    styles.validate() or >>
    if !s.styles.same_as(styles) { s.styles = styles.clone()
        s.dirty = true }
    << 0
}
pub fn (s &Screen) styles() Styles { << s.styles.clone() }
pub fn (s &Screen) row_height() f64 { << math.max(36.0 * s.styles.density,29.0 * s.styles.text_scale) }
pub fn (s &mut Screen) set_reduced_motion(reduced bool) { if s.reduced != reduced { s.reduced = reduced
    s.dirty = true } }
pub fn (s &mut Screen) group() int { << s.add_node(screen_group,false,ui.cursor_default) or >> }
pub fn (s &mut Screen) button(text string) int {
    id := s.add_node(screen_button,true,ui.cursor_hand) or >>
    control := button(&s.identity,id,&screen_empty()) or (err) { s.abandon_node(id)
        >> err }
    s.buttons[id] = control
    s.texts[id - 1] = text + ""
    << id
}
pub fn (s &mut Screen) label(text string,size f64,muted bool) int {
    if !finite_metric(size,256.0) || size <= 0.0 { >> errors.new("widgets: invalid label size") }
    id := s.add_node(screen_label,false,ui.cursor_default) or >>
    s.texts[id - 1] = text + ""
    s.text_sizes[id - 1] = size
    s.muted[id - 1] = muted
    << id
}
pub fn (s &mut Screen) set_text(id int,text string) int {
    _ := s.node(id) or >>
    if s.texts[id - 1] != text { s.texts[id - 1] = text + ""
        s.dirty = true }
    << 0
}
pub fn (s &mut Screen) set_selected_button(id int,selected bool) int {
    n := s.node(id) or >>
    if n.kind != screen_button { >> errors.new("widgets: handle is not a button") }
    mut control := s.take_button(id)
    control.set_selected(selected)
    s.buttons[id] = control
    s.dirty = true
    << 0
}
pub fn (s &Screen) is_descendant(id int,parent int) bool {
    mut cursor := id
    mut budget := s.nodes.len + 1
    while cursor > 0 && cursor <= s.nodes.len && budget > 0 {
        if cursor == parent { << true }
        cursor = s.nodes[cursor - 1].parent
        budget -= 1
    }
    << false
}
pub fn (s &Screen) is_visible(id int) bool {
    mut cursor := id
    mut budget := s.nodes.len + 1
    while cursor > 0 && cursor <= s.nodes.len && budget > 0 {
        n := s.nodes[cursor - 1]
        if n.kind < 0 || !n.visible { << false }
        cursor = n.parent
        budget -= 1
    }
    << cursor == 0 && budget > 0
}
pub fn (s &mut Screen) set_parent(id int,parent int) int {
    _ := s.node(id) or >>
    if parent != 0 { _ := s.node(parent) or >> }
    if parent == id || s.is_descendant(parent,id) { >> errors.new("widgets: screen parent cycle") }
    s.nodes[id - 1].parent = parent
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_visible(id int,visible bool) int {
    _ := s.node(id) or >>
    if s.nodes[id - 1].visible == visible { << 0 }
    if !visible {
        event := s.cancellation()
        for index in 0:s.nodes.len { child := index + 1
            if s.nodes[index].kind >= 0 && s.is_descendant(child,id) { _ := s.route_node(child,route_cancel,&event) or >> } }
        if s.is_descendant(s.focused,id) { s.focused = 0 }
        if s.is_descendant(s.captured,id) { s.captured = 0 }
    }
    s.nodes[id - 1].visible = visible
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_enabled(id int,enabled bool) int {
    n := s.node(id) or >>
    s.nodes[id - 1].enabled = enabled
    if n.kind == screen_button { mut control := s.take_button(id)
        control.set_enabled(enabled)
        s.buttons[id] = control }
    else if n.kind >= screen_table && n.kind < screen_popover { s.control_enable(id,enabled) or >> }
    if !enabled && (s.focused == id || s.captured == id) { event := s.cancellation()
        _ := s.route_node(id,route_cancel,&event) or >>
        if s.focused == id { s.focused = 0 }
        if s.captured == id { s.captured = 0 } }
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) place(id int,x f64,y f64,width f64,height f64) int {
    _ := s.node(id) or >>
    bounds := layout.Rect{x: x,y: y,width: width,height: height}
    validate_bounds(&bounds) or >>
    old := s.nodes[id - 1].local
    if old.x != x || old.y != y || old.width != width || old.height != height { s.nodes[id - 1].local = bounds
        s.dirty = true }
    << 0
}
pub fn (s &Screen) bounds(id int) layout.Rect { n := s.node(id) or >>
    << n.bounds }
fn (s &Screen) global_bounds(id int) layout.Rect {
    n := s.node(id) or >>
    mut b := n.local
    mut parent := n.parent
    mut budget := s.nodes.len
    while parent > 0 && budget > 0 {
        p := s.node(parent) or >>
        b.x += p.local.x
        b.y += p.local.y
        if p.kind >= screen_popover { b.x += p.bounds.x - p.local.x
            b.y += p.bounds.y - p.local.y
            <- }
        parent = p.parent
        budget -= 1
    }
    << b
}
fn (s &mut Screen) layout_controls() int {
    // Overlay surfaces establish coordinate origins for their children first.
    for pass in 0:2 {
        for index in 0:s.nodes.len {
            n := s.nodes[index]
            if n.kind < 0 { -> }
            if n.kind >= screen_popover { if pass == 0 { s.overlay_place(n.id) or >> }
                -> }
            if pass == 0 { -> }
            b := s.global_bounds(n.id) or >>
            s.nodes[index].bounds = b
            if n.kind == screen_button { mut control := s.take_button(n.id)
                control.set_bounds(&b) or (err) { s.buttons[n.id] = control
                    >> err }
                s.buttons[n.id] = control }
            else if n.kind >= screen_table { s.control_place(n.id,&b) or >>
                popup := s.control_popup(n.id) or >>
                if popup.height > 0.0 {
                    above := b.y + b.height + popup.height > s.height && b.y >= popup.height
                    s.control_popup_above(n.id,above) or >> } }
        }
    }
    << 0
}
fn (s &Screen) cancellation() ui.InputEvent {
    << ui.InputEvent{kind: ui.ev_pointer_cancel,window_id: s.identity.window_id,canvas_id: s.identity.canvas_id,generation: s.identity.generation,
        x: 0.0,y: 0.0,dx: 0.0,dy: 0.0,button: 0,buttons: 0,modifiers: 0,key: 0,scan: 0,repeat: 0,click_count: 0,time_ns: s.now.nanoseconds()}
}
fn (s &mut Screen) route_node(id int,kind int,event &ui.InputEvent) Action {
    n := s.node(id) or >>
    if n.kind == screen_button {
        mut control := s.take_button(id)
        result := control.route(kind,event) or (err) { s.buttons[id] = control
            >> err }
        s.buttons[id] = control
        << result
    }
    if n.kind >= screen_table && n.kind < screen_popover { << s.control_input(id,kind,event) or >> }
    if n.kind >= screen_popover {
        if kind == route_focus || kind == route_blur { s.overlay_focus(id,kind == route_focus,s.now) or >>
            << no_action(id,true) }
        << s.overlay_input(id,event) or >>
    }
    << no_action(id,false)
}
fn (s &mut Screen) pointer_cursor(cursor int) int {
    if cursor != s.pointer { s.window.content_command("cursor\t" + str(cursor)) or >>
        s.pointer = cursor }
    << 0
}
pub fn (s &mut Screen) cancel_all() int {
    event := s.cancellation()
    for n in s.nodes { if n.kind > screen_label { _ := s.route_node(n.id,route_cancel,&event) or >> } }
    s.focused = 0
    s.captured = 0
    s.hovered = 0
    s.pointer_cursor(ui.cursor_default) or >>
    s.dirty = true
    << 0
}
fn (s &mut Screen) focus_ready(id int,modal int) bool {
    if id <= 0 || id > s.nodes.len { << false }
    n := s.nodes[id - 1]
    if n.kind < 0 || !n.enabled || !n.focusable || !s.is_visible(id) || n.bounds.width <= 0.0 || n.bounds.height <= 0.0 { << false }
    if modal > 0 && (id == modal || !s.is_descendant(id,modal)) { << false }
    if n.kind >= screen_popover { << n.kind == screen_toast && s.overlay_is_open(id) }
    // Children of a hidden modal never take background focus.
    for parent in s.nodes { if parent.kind == screen_modal && s.is_descendant(id,parent.id) {
        if !s.overlay_is_open(parent.id) { << false } } }
    << true
}
pub fn (s &mut Screen) focus(id int) int {
    if id == s.focused { << 0 }
    modal := s.modal_blocks()
    if id != 0 && !s.focus_ready(id,modal) or >> { << 0 }
    event := s.cancellation()
    previous := s.focused
    s.focused = id
    if previous > 0 { _ := s.route_node(previous,route_blur,&event) or >> }
    if id > 0 { _ := s.route_node(id,route_focus,&event) or >> }
    for n in s.nodes { if n.kind == screen_tooltip { s.overlay_focus(n.id,id == s.overlay_anchor(n.id),s.now) or >> } }
    if modal > 0 && id > 0 { s.modal_sync_focus(modal,id) or >> }
    s.dirty = true
    << 0
}
fn (s &mut Screen) accept(action Action,actions &mut []Action) int {
    if action.needs_paint { s.dirty = true }
    if action.request_focus { s.focus(action.id) or >> }
    if action.kind != action_none { actions.push(action) }
    << 0
}
fn (s &Screen) in_modal(id int,modal int) bool {
    if modal > 0 { << id != modal && s.is_descendant(id,modal) }
    for n in s.nodes { if n.kind == screen_modal && s.is_descendant(id,n.id) { << false } }
    << true
}
fn (s &mut Screen) hit(x f64,y f64,modal int) int {
    mut i := s.nodes.len - 1
    while i >= 0 { n := s.nodes[i]
        if n.kind >= screen_button && n.kind < screen_popover && n.enabled && s.is_visible(n.id) && s.in_modal(n.id,modal) && n.bounds.contains(x,y) { << n.id }
        i -= 1 }
    << 0
}
fn (s &mut Screen) dispatch_input(input &ui.InputEvent) []Action {
    mut actions := []Action{}
    if !belongs(&s.identity,input) { << actions }
    s.layout_controls() or >>
    if input.kind == ui.ev_pointer_cancel { s.cancel_all() or >>
        << actions }
    modal := s.modal_blocks()
    if modal > 0 {
        a := s.overlay_modal_input(modal,input) or >>
        if a.needs_paint { s.dirty = true }
        if a.consumed {
            s.focus(s.modal_focused(modal)) or >>
            << actions
        }
    }
    // Hover observers see the move even when a surface above consumes it.
    for n in s.nodes { if n.kind == screen_tooltip && s.is_visible(n.id) {
        a := s.overlay_input(n.id,input) or >>
        s.accept(a,mut &actions) or >>
        if a.consumed { << actions } } }
    if modal == 0 {
        mut i := s.nodes.len - 1
        while i >= 0 { n := s.nodes[i]
            if (n.kind == screen_toast || n.kind == screen_popover) && s.is_visible(n.id) {
                a := s.overlay_input(n.id,input) or >>
                s.accept(a,mut &actions) or >>
                if a.consumed { << actions } }
            i -= 1 }
    }
    // Popup rectangles are tested before ordinary fields, in reverse paint order.
    mut i := s.nodes.len - 1
    while i >= 0 { n := s.nodes[i]
        if n.kind >= screen_table && n.kind < screen_popover && s.is_visible(n.id) && s.in_modal(n.id,modal) {
            popup := s.control_popup(n.id) or >>
            if popup.width > 0.0 && popup.contains(input.x,input.y) && input.kind != ui.ev_key_down && input.kind != ui.ev_key_up {
                a := s.route_node(n.id,route_input,input) or >>
                s.accept(a,mut &actions) or >>
                if a.consumed { s.captured = n.id
                    if input.kind == ui.ev_pointer_up { s.captured = 0 }
                    s.pointer_cursor(ui.cursor_hand) or >>
                    << actions }
            }
        }
        i -= 1
    }
    if input.kind == ui.ev_key_down && input.key == ui.key_tab {
        mut order := []int{}
        for n in s.nodes { if s.focus_ready(n.id,modal) or >> { order.push(n.id) } }
        if order.len > 0 {
            mut position := -1
            for index in 0:order.len { if order[index] == s.focused { position = index } }
            if (input.modifiers & ui.mod_shift) != 0 { position -= 1
                if position < 0 { position = order.len - 1 } }
            else { position += 1
                if position >= order.len { position = 0 } }
            s.focus(order[position]) or >>
        }
        << actions
    }
    if input.kind == ui.ev_key_down || input.kind == ui.ev_key_up {
        if s.focused > 0 && s.focus_ready(s.focused,modal) or >> {
            a := s.route_node(s.focused,route_input,input) or >>
            s.accept(a,mut &actions) or >>
            if a.consumed { << actions }
        }
        if modal == 0 && input.kind == ui.ev_key_down { actions.push(Action{kind: action_key,id: 0,
            needs_paint: false,request_focus: false,consumed: false,value: f64(input.key)}) }
        << actions
    }
    mut target := s.hit(input.x,input.y,modal) or >>
    if input.kind == ui.ev_pointer_leave { target = 0 }
    if s.hovered != target {
        if s.hovered > 0 { mut leave := choice_copy_input(input)
            leave.kind = ui.ev_pointer_leave
            _ := s.route_node(s.hovered,route_input,&leave) or >> }
        s.hovered = target
    }
    if input.kind == ui.ev_pointer_down && input.button == ui.button_left {
        // An outside click closes editors and candidate lists through blur.
        s.focus(target) or >>
        s.captured = target
    }
    mut owner := target
    if s.captured > 0 && input.kind != ui.ev_pointer_scroll { owner = s.captured }
    mut cursor := ui.cursor_default
    if owner > 0 {
        n := s.node(owner) or >>
        cursor = n.cursor
        if n.kind >= screen_table { cursor = s.control_cursor(owner,input.x,input.y) or >> }
        a := s.route_node(owner,route_input,input) or >>
        s.accept(a,mut &actions) or >>
    }
    if input.kind == ui.ev_pointer_leave { cursor = ui.cursor_default }
    s.pointer_cursor(cursor) or >>
    if input.kind == ui.ev_pointer_up && input.button == ui.button_left { s.captured = 0 }
    << actions
}
fn (s &mut Screen) paint_caption(id int,secondary bool,frame &mut draw.Frame,bounds &layout.Rect,style &ControlStyle,opacity f64) int {
    key := id * 2
    mut slot := key
    mut value := s.texts[id - 1] + ""
    if secondary { slot += 1
        value = s.descriptions[id - 1] + "" }
    faded := style.with_opacity(opacity) or >>
    styles := s.styles.clone()
    if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
    mut cache := s.take_label_cache(slot)
    err_msg := screen_paint_caption_text(mut &cache,&value,frame,bounds,&styles,&faded)
    s.labels[slot] = cache
    if err_msg != "" { >> errors.new(err_msg) }
    << 0
}
fn screen_paint_caption_text(cache &mut TextCache,value &string,frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,faded &ControlStyle) string {
    cache.paint_text(0,value,frame,bounds,styles,faded,0) or (err) { << err.msg() }
    << ""
}
fn (s &mut Screen) paint_text(id int,frame &mut draw.Frame,bounds &layout.Rect,style &ControlStyle,opacity f64) int {
    << s.paint_caption(id,false,frame,bounds,style,opacity) or >>
}
fn (s &mut Screen) paint_node(id int,frame &mut draw.Frame,opacity f64) int {
    n := s.node(id) or >>
    styles := s.styles.clone()
    if n.kind == screen_label {
        mut style := styles.input.clone()
        style.padding = layout.insets(0.0) or >>
        style.align_x = 0.0
        style.align_y = 0.0
        style.inherit_font = false
        style.font = copy_font(&styles.font)
        style.font.size = s.text_sizes[id - 1]
        if s.muted[id - 1] { style.palette.foreground = style.palette.muted }
        s.paint_text(id,frame,&n.bounds,&style,opacity) or >>
    } else if n.kind == screen_button {
        control := s.take_button(id)
        c := control.style_or(&styles).with_opacity(opacity) or (err) { s.buttons[id] = control
            >> err }
        state := control.visual_state()
        style_box(frame,&n.bounds,&c,styles.density,state) or (err) { s.buttons[id] = control
            >> err }
        mut label_style := c.clone()
        label_style.palette.foreground = c.resolve(state).foreground
        s.buttons[id] = control
        s.paint_text(id,frame,&n.bounds,&label_style,1.0) or >>
    } else if n.kind >= screen_table && n.kind < screen_popover { s.control_paint(id,frame,&styles,false) or >> }
    << 0
}
fn (s &mut Screen) record(frame &mut draw.Frame) int {
    s.layout_controls() or >>
    styles := s.styles.clone()
    frame.begin() or >>
    frame.set_bg(styles.background) or >>
    for n in s.nodes { if n.kind >= screen_label && n.kind < screen_popover && s.is_visible(n.id) && s.in_modal(n.id,0) {
        s.paint_node(n.id,frame,1.0) or >> } }
    for n in s.nodes { if n.kind >= screen_table && n.kind < screen_popover && s.is_visible(n.id) && s.in_modal(n.id,0) {
        s.control_paint(n.id,frame,&styles,true) or >> } }
    // Layer order is shared with input routing. Modal children draw last.
    for kind in [screen_popover,screen_tooltip,screen_toast,screen_modal] {
        for n in s.nodes { if n.kind == kind && s.is_visible(n.id) {
            s.overlay_paint(n.id,frame,&styles) or >>
            if kind == screen_modal && s.overlay_is_visible(n.id) {
                opacity := s.overlay_opacity(n.id)
                bounds := s.bounds(n.id) or >>
                mut title := styles.input.clone()
                title.inherit_font = false
                title.font = copy_font(&styles.font)
                title.font.size = 21.0
                title.align_x = 0.0
                title.align_y = 0.0
                title.padding = layout.insets(0.0) or >>
                title_bounds := layout.Rect{x: bounds.x + 24.0,y: bounds.y + 30.0,width: math.max(0.0,bounds.width - 48.0),height: 50.0 * styles.text_scale}
                s.paint_text(n.id,frame,&title_bounds,&title,opacity) or >>
                title.font.size = 14.0
                title.palette.foreground = title.palette.muted
                message_bounds := layout.Rect{x: bounds.x + 24.0,y: bounds.y + 92.0,width: math.max(0.0,bounds.width - 48.0),height: 72.0}
                s.paint_caption(n.id,true,frame,&message_bounds,&title,opacity) or >>
                frame.push() or >>
                frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
                for child in s.nodes { if child.id != n.id && child.kind >= screen_label && child.kind < screen_popover && s.is_visible(child.id) && s.is_descendant(child.id,n.id) {
                    s.paint_node(child.id,frame,opacity) or >> } }
                frame.pop() or >>
                for child in s.nodes { if child.kind >= screen_table && child.kind < screen_popover && s.is_visible(child.id) && s.is_descendant(child.id,n.id) {
                    s.control_paint(child.id,frame,&styles,true) or >> } }
            }
        } }
    }
    << 0
}
fn (s &mut Screen) acknowledge() int {
    for n in s.nodes {
        if n.kind == screen_button { mut b := s.take_button(n.id)
            b.painted()
            s.buttons[n.id] = b }
        else if n.kind >= screen_table && n.kind < screen_popover { s.control_painted(n.id) or >> }
        else if n.kind >= screen_popover { s.overlay_painted(n.id) or >> }
    }
    << 0
}
fn (s &mut Screen) draw_and_present(frame &mut draw.Frame) int {
    s.record(frame) or >>
    frame.present() or >>
    << 0
}
pub fn (s &mut Screen) render() bool {
    if !s.is_open() || !s.dirty { << false }
    mut frame := s.take_frame()
    err := s.draw_and_present(mut &frame)
    s.frames[1] = frame
    if err != 0 { << false }
    s.acknowledge() or >>
    s.dirty = false
    << true
}
// Export/preview still uses the same placement and layer ordering as render.
pub fn (s &mut Screen) snapshot(scale f64) draw.Surface {
    mut frame := s.context.new_frame(32768)
    s.record(mut &frame) or (err) { frame.dispose()
        >> err }
    surface := frame.snapshot(s.width,s.height,scale) or (err) { frame.dispose()
        >> err }
    frame.dispose()
    << surface
}
pub fn (s &mut Screen) advance(now time.Instant) time.Instant {
    s.now = now
    mut deadline := time.zero_instant()
    for n in s.nodes {
        if n.kind < screen_table || !s.is_visible(n.id) { -> }
        mut step := ScreenAnimation{changed: false,deadline: time.zero_instant()}
        if n.kind < screen_popover { step = s.control_tick(n.id,now,s.reduced) or >> }
        else { step = s.overlay_tick(n.id,now,s.reduced) or >> }
        if step.changed { s.dirty = true }
        deadline = screen_earlier(deadline,step.deadline)
        if n.kind == screen_modal { restore := s.modal_restore(n.id) or >>
            if restore > 0 { s.focus(restore) or >> } }
        if n.kind == screen_toast && s.focused == n.id && !s.overlay_is_open(n.id) { s.focus(0) or >> }
    }
    << deadline
}
pub fn (s &mut Screen) dispatch(input &ui.InputEvent) []Action {
    if input.time_ns > 0 { s.now = time.instant_from_ns(input.time_ns) or >> }
    << s.dispatch_input(input) or >>
}
pub fn (s &mut Screen) event(event &ui.Event) []Action {
    mut actions := []Action{}
    if !s.is_open() { << actions }
    s.now = time.instant()
    if event.kind == ui.ev_exit { s.closed = true
        << actions }
    if event.window_id != s.identity.window_id { << actions }
    if event.kind == ui.ev_closed { s.closed = true
        << actions }
    if event.kind == ui.ev_canvas_closed { identity := ui.canvas_of(event) or >>
        if identity.canvas_id == s.identity.canvas_id && identity.generation == s.identity.generation { s.closed = true }
        << actions }
    if event.kind == ui.ev_canvas_metrics { metrics := ui.metrics_of(event) or >>
        if metrics.canvas_id == s.identity.canvas_id && metrics.generation == s.identity.generation && metrics.width > 0.0 && metrics.height > 0.0 { s.resize(metrics.width,metrics.height) or >> }
        << actions }
    if event.kind == ui.ev_canvas_preferences { prefs := ui.canvas_preferences_of(event) or >>
        if prefs.identity.canvas_id == s.identity.canvas_id && prefs.identity.generation == s.identity.generation { s.set_reduced_motion(prefs.reduced_motion) }
        << actions }
    if event.kind == ui.ev_blurred { s.cancel_all() or >>
        << actions }
    if event.kind == ui.ev_focused { ui.request_canvas_preferences(&s.identity) or >>
        modal := s.modal_blocks()
        if modal > 0 { s.focus(s.modal_focused(modal)) or >> }
        << actions }
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << s.dispatch_input(&input) or >> }
    for n in s.nodes { if n.kind == screen_editor || n.kind == screen_combo {
        a := s.control_event(n.id,event) or >>
        s.accept(a,mut &actions) or >> } }
    << actions
}
fn screen_wait(events chan ui.Event,deadline time.Instant) ui.Event {
    if deadline.is_zero() { << <-events }
    delay := deadline.since(time.instant())
    if delay.nanoseconds() <= 0 { << ui.Event{kind: ui.ev_none,window_id: 0,menu_id: "",width: 0,height: 0} }
    timer := delay.timer()
    select {
        event := <-events { timer.stop()
            << event }
        _ := <-timer.c { timer.stop()
            << ui.Event{kind: ui.ev_none,window_id: 0,menu_id: "",width: 0,height: 0} }
    }
    << ui.Event{kind: ui.ev_none,window_id: 0,menu_id: "",width: 0,height: 0}
}
// Block when idle; coalesce non-semantic input bursts before one repaint.
pub fn (s &mut Screen) next(events chan ui.Event) []Action {
    if !s.is_open() { << []Action{} }
    deadline := s.advance(time.instant()) or >>
    if s.dirty { << []Action{} }
    event := screen_wait(events,deadline) or >>
    mut actions := s.event(&event) or >>
    _ := s.advance(time.instant()) or >>
    mut count := 0
    while s.is_open() && actions.len == 0 && count < 128 {
        pending := ui.poll_chan(events)
        if pending.kind == ui.ev_none { <- }
        actions = s.event(&pending) or >>
        count += 1
    }
    << actions
}
pub fn (s &mut Screen) close() int {
    if s.is_open() { s.window.command("close") or >>
        s.closed = true }
    << 0
}
fn (s &mut Screen) try_cancel_all() {
    s.cancel_all() or (err) { s.focused = 0
        << }
}
pub fn (s &mut Screen) dispose() {
    if s.disposed { << }
    s.try_cancel_all()
    for n in s.nodes { if n.kind >= screen_table && n.kind < screen_popover { s.control_dispose(n.id) or (err) { -> } }
        else if n.kind >= screen_popover { s.overlay_dispose(n.id) or (err) { -> } }
        for secondary in 0:2 { key := n.id * 2 + secondary
            if s.labels.has(key) { mut cache := s.take_label_cache(key)
                cache.dispose() } }
    }
    s.buttons = map[int]Button{}
    s.labels = map[int]TextCache{}
    mut frame := s.take_frame()
    frame.dispose()
    s.disposed = true
    s.closed = true
}

// The callback owns business state only. Screen owns dispatch, rendering,
// native resources and cleanup, including errors from either callback.
pub struct@ ScreenHandler {
    fn layout(&mut Screen) int
    fn update(&mut Screen,Action) int
}
pub fn run_screen#H:ScreenHandler(s &mut Screen,events chan ui.Event,handler &mut H) int {
    screen_loop(s,events,handler) or (err) { s.dispose()
        >> err }
    s.dispose()
    << 0
}
fn screen_loop#H:ScreenHandler(s &mut Screen,events chan ui.Event,handler &mut H) int {
    handler.layout(s) or >>
    _ := s.render() or >>
    while s.is_open() {
        actions := s.next(events) or >>
        if !s.is_open() { <- }
        for action in actions { handler.update(s,action) or >> }
        if !s.is_open() { <- }
        handler.layout(s) or >>
        _ := s.render() or >>
    }
    << 0
}

fn (s &mut Screen) take_button(id int) Button { items := mut &s.buttons
    << items.take(id) }
fn (s &mut Screen) take_label_cache(id int) TextCache { items := mut &s.labels
    << items.take(id) }
fn (s &mut Screen) take_frame() draw.Frame { items := mut &s.frames
    << items.take(1) }
