@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

// Screen owns built-in controls and their native resources. Handles are local
// to this screen and never reused; applications keep only business state.
const SCREEN_GROUP = 0
const SCREEN_LABEL = 1
const SCREEN_BUTTON = 2
const SCREEN_CHECKBOX = 3
const SCREEN_SWITCH = 4
const SCREEN_RADIO = 5
const SCREEN_SLIDER = 6
const SCREEN_STEPPER = 7
const SCREEN_TABS = 8
const SCREEN_SELECT = 9
const SCREEN_LIST = 14
const SCREEN_PROGRESS = 15
const SCREEN_DIVIDER = 16
const SCREEN_BADGE = 17
const SCREEN_CARD = 18
const SCREEN_RADIO_GROUP = 19
const SCREEN_TABLE = 10
const SCREEN_TREE = 11
const SCREEN_PAGINATION = 12
const SCREEN_BREADCRUMBS = 13
const SCREEN_COMBO = 20
const SCREEN_MULTI = 21
const SCREEN_COLOR = 22
const SCREEN_DATE = 23
const SCREEN_CLOCK = 24
const SCREEN_SPINNER = 25
const SCREEN_EDITOR = 26
const SCREEN_FIELD = 27
const SCREEN_TASK = 28
const SCREEN_WEBVIEW = 29
const SCREEN_CHART = 30
const SCREEN_BUTTON_GROUP = 31
const SCREEN_RANGE_SLIDER = 32
const SCREEN_SPLIT_VIEW = 33
const SCREEN_MENU = 34
const SCREEN_POPOVER = 35
const SCREEN_TOOLTIP = 36
const SCREEN_TOAST = 37
const SCREEN_MODAL = 38
pub const ACTION_KEY = 5

struct ScreenNode {
    id int
    kind int
    parent int
    bounds layout.Rect
    local layout.Rect
    visible bool
    enabled bool
    inherited_enabled bool
    focusable bool
    cursor int
}
// A bounded, immutable view of one retained screen node for tooling adapters.
// The internal node remains private so callers cannot forge handles or mutate
// layout/resource state behind Screen's lifecycle checks.
pub struct ScreenNodeInfo {
    pub id int
    pub kind int
    pub parent int
    pub x f64
    pub y f64
    pub width f64
    pub height f64
    pub visible bool
    pub enabled bool
    pub focusable bool
    pub focused bool
    pub text string
}

pub const XACP_MAX_NODES = 512
pub const XACP_MAX_NODE_TEXT = 65536
struct ScreenAnimation { changed bool
    deadline time.Instant }
pub struct Screen {
    identity ui.CanvasEvent
    context draw.Context
    window ui.Window
    frames map[int]draw.Frame
    styles Styles
    locale Locale
    locale_overrides map[int]Locale
    queued_actions []Action
    nodes []ScreenNode
    buttons map[int]Button
    button_variants map[int]int
    button_transitions map[int]PaintTransition
    texts []string
    descriptions []string
    text_sizes []f64
    muted []bool
    labels map[int]TextCache
    basics ScreenBasics
    webviews map[int]ScreenWebView
    controls ScreenControls
    overlays ScreenOverlays
    notices ScreenNotices
    focused int
    captured int
    hovered int
    pointer int
    now time.Instant
    animation_deadline time.Instant
    reduced bool
    width f64
    height f64
    dirty bool
    closed bool
    disposed bool
}
fn screen_empty() layout.Rect { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
fn screen_earlier(a time.Instant,b time.Instant) time.Instant {
    if a.is_zero() || (!b.is_zero() && b.before(a)) { << b }
    << a
}
pub fn screen(ready &ui.Event) Screen {
    identity := ui.canvas_of(ready) or >>
    context := draw.context_of(ready) or >>
    window := ui.Window{id: identity.window_id,generation: identity.generation,title: "",width: 0,height: 0,
        content_kind: ui.CONTENT_DRAW,content_backend_id: identity.canvas_id,closed: 0}
    window.content_command("input_enabled\t1") or >>
    window.content_command("pan_enabled\t0") or >>
    ui.request_canvas_preferences(&identity) or >>
    mut frames := map[int]draw.Frame{}
    frames[1] = context.new_frame(32768)
    << Screen{identity: copy_identity(&identity),context: context.clone(),window: window,frames: frames,
        styles: light_styles(),locale: locale_default(),locale_overrides: map[int]Locale{},queued_actions: []Action{},nodes: []ScreenNode{},buttons: map[int]Button{},button_variants: map[int]int{},button_transitions: map[int]PaintTransition{},texts: []string{},descriptions: []string{},
        text_sizes: []f64{},muted: []bool{},labels: map[int]TextCache{},basics: new_screen_basics(),webviews: map[int]ScreenWebView{},controls: new_screen_controls(),overlays: new_screen_overlays(),notices: new_screen_notices(),
        focused: 0,captured: 0,hovered: 0,pointer: ui.CURSOR_DEFAULT,now: time.instant(),animation_deadline: time.zero_instant(),reduced: false,
        width: 800.0,height: 600.0,dirty: true,closed: false,disposed: false}
}
fn (s &Screen) check_screen() int {
    if s.disposed || s.closed { >> errors.new("widgets: screen is closed") }
    << 0
}
fn (s &Screen) node(id int) ScreenNode {
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 { >> errors.new("widgets: invalid screen handle") }
    << s.nodes[id - 1]
}
fn (s &mut Screen) add_node(kind int,focusable bool,cursor int) int {
    s.check_screen() or >>
    if s.nodes.len >= 512 { >> errors.new("widgets: screen control capacity exceeded") }
    id := s.nodes.len + 1
    empty := screen_empty()
    s.nodes.push(ScreenNode{id: id,kind: kind,parent: 0,bounds: empty,local: empty,
        visible: true,enabled: true,inherited_enabled: true,focusable: focusable,cursor: cursor})
    s.texts.push("")
    s.descriptions.push("")
    s.text_sizes.push(0.0)
    s.muted.push(false)
    s.dirty = true
    << id
}
fn (s &mut Screen) abandon_node(id int) {
    if id > 0 && id <= s.nodes.len { s.nodes[id - 1].kind = -1
        s.nodes[id - 1].visible = false
        s.nodes[id - 1].enabled = false }
}
pub fn (s &Screen) is_open() bool { << !s.closed && !s.disposed }
pub fn (s &Screen) xacp_window_id() int { << s.identity.window_id }
pub fn (s &Screen) xacp_canvas_id() int { << s.identity.canvas_id }
pub fn (s &Screen) xacp_generation() int { << s.identity.generation }
pub fn (s &Screen) width() f64 { << s.width }
pub fn (s &Screen) height() f64 { << s.height }
pub fn (s &Screen) focused() int { << s.focused }
pub fn (s &Screen) reduced_motion() bool { << s.reduced }
pub fn (s &Screen) viewport() layout.Rect { << layout.Rect{x: 0.0,y: 0.0,width: s.width,height: s.height} }
pub fn (s &mut Screen) invalidate() { s.dirty = true }
pub fn (s &mut Screen) resize(width f64,height f64) int {
    validate_bounds(&layout.Rect{x: 0.0,y: 0.0,width: width,height: height}) or >>
    if width <= 0.0 || height <= 0.0 { >> errors.new("widgets: screen needs positive dimensions") }
    if width != s.width || height != s.height { s.width = width
        s.height = height
        s.dirty = true }
    << 0
}
pub fn (s &mut Screen) set_min_size(width int,height int) int { << s.window.command("minsize\t" + str(width) + "\t" + str(height)) or >> }
pub fn (s &mut Screen) set_styles(styles &Styles) int {
    styles.validate() or >>
    if !s.styles.same_as(styles) { s.styles = styles.clone()
        s.dirty = true }
    << 0
}
pub fn (s &Screen) styles() Styles { << s.styles.clone() }
pub fn (s &Screen) row_height() f64 { << math.max(36.0 * s.styles.density,29.0 * s.styles.text_scale) }
pub fn (s &mut Screen) set_reduced_motion(reduced bool) { if s.reduced != reduced { s.reduced = reduced
    s.dirty = true } }
pub fn (s &mut Screen) group() int { << s.add_node(SCREEN_GROUP,false,ui.CURSOR_DEFAULT) or >> }
pub fn (s &mut Screen) button(text string) int {
    id := s.add_node(SCREEN_BUTTON,true,ui.CURSOR_HAND) or >>
    control := button(&s.identity,id,&screen_empty()) or (err) { s.abandon_node(id)
        >> err }
    s.buttons[id] = control
    s.button_transitions[id] = paint_transition()
    s.texts[id - 1] = text + ""
    << id
}
pub fn (s &mut Screen) label(text string,size f64,muted bool) int {
    if !finite_metric(size,256.0) || size <= 0.0 { >> errors.new("widgets: invalid label size") }
    id := s.add_node(SCREEN_LABEL,false,ui.CURSOR_DEFAULT) or >>
    s.texts[id - 1] = text + ""
    s.text_sizes[id - 1] = size
    s.muted[id - 1] = muted
    << id
}
pub fn (s &mut Screen) set_text(id int,text string) int {
    n := s.node(id) or >>
    if n.kind == SCREEN_CHECKBOX || n.kind == SCREEN_SWITCH || n.kind == SCREEN_RADIO || n.kind == SCREEN_BADGE { << s.set_option_text(id,0,text) or >> }
    if s.texts[id - 1] != text { s.texts[id - 1] = text + ""
        s.dirty = true }
    << 0
}
pub fn (s &mut Screen) set_selected_button(id int,selected bool) int {
    n := s.node(id) or >>
    if n.kind != SCREEN_BUTTON { >> errors.new("widgets: handle is not a button") }
    mut control := s.take_button(id)
    if control.selected == selected { s.buttons[id] = control
        << 0 }
    control.set_selected(selected)
    s.buttons[id] = control
    s.dirty = true
    << 0
}
pub fn (s &Screen) is_descendant(id int,parent int) bool {
    mut cursor := id
    mut budget := s.nodes.len + 1
    while cursor > 0 && cursor <= s.nodes.len && budget > 0 {
        if cursor == parent { << true }
        cursor = s.nodes[cursor - 1].parent
        budget -= 1
    }
    << false
}
pub fn (s &Screen) is_visible(id int) bool {
    mut cursor := id
    mut budget := s.nodes.len + 1
    while cursor > 0 && cursor <= s.nodes.len && budget > 0 {
        n := s.nodes[cursor - 1]
        if n.kind < 0 || !n.visible { << false }
        if s.controls.split_panes.has(n.id) && (n.bounds.width <= 0.0 || n.bounds.height <= 0.0) { << false }
        if cursor != id && (n.kind == SCREEN_POPOVER || n.kind == SCREEN_MODAL) && !s.overlay_is_visible(cursor) { << false }
        cursor = n.parent
        budget -= 1
    }
    << cursor == 0 && budget > 0
}
// Disabled containers gate descendants while preserving each child's own flag.
fn (s &Screen) effective_enabled(id int) bool {
    mut current := id
    mut budget := s.nodes.len + 1
    while current > 0 && current <= s.nodes.len && budget > 0 { node := s.nodes[current - 1]
        if !node.enabled || node.kind < 0 { << false }
        current = node.parent
        budget -= 1 }
    << current == 0 && budget > 0
}
pub fn (s &mut Screen) set_parent(id int,parent int) int {
    _ := s.node(id) or >>
    if s.nodes[id - 1].parent == parent { << 0 }
    if parent != 0 { _ := s.node(parent) or >> }
    if parent == id || s.is_descendant(parent,id) { >> errors.new("widgets: screen parent cycle") }
    s.nodes[id - 1].parent = parent
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_visible(id int,visible bool) int {
    _ := s.node(id) or >>
    if s.nodes[id - 1].visible == visible { << 0 }
    if !visible {
        event := s.cancellation()
        for index in 0:s.nodes.len { child := index + 1
            if s.nodes[index].kind >= 0 && s.is_descendant(child,id) { _ := s.route_node(child,ROUTE_CANCEL,&event) or >> } }
        if s.is_descendant(s.focused,id) { s.focused = 0 }
        if s.is_descendant(s.captured,id) { s.captured = 0 }
    }
    s.nodes[id - 1].visible = visible
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) set_enabled(id int,enabled bool) int {
    n := s.node(id) or >>
    if n.enabled == enabled { << 0 }
    s.nodes[id - 1].enabled = enabled
    if n.kind == SCREEN_BUTTON { mut control := s.take_button(id)
        control.set_enabled(enabled)
        s.buttons[id] = control }
    else if n.kind >= SCREEN_CHECKBOX && n.kind < SCREEN_POPOVER { s.control_enable(id,enabled) or >> }
    if !enabled && (s.is_descendant(s.focused,id) || s.is_descendant(s.captured,id)) { event := s.cancellation()
        _ := s.route_node(id,ROUTE_CANCEL,&event) or >>
        if s.is_descendant(s.focused,id) { if s.focused != id { _ := s.route_node(s.focused,ROUTE_CANCEL,&event) or >> }
            s.focused = 0 }
        if s.is_descendant(s.captured,id) { if s.captured != id { _ := s.route_node(s.captured,ROUTE_CANCEL,&event) or >> }
            s.captured = 0 } }
    s.dirty = true
    << 0
}
pub fn (s &mut Screen) place(id int,x f64,y f64,width f64,height f64) int {
    _ := s.node(id) or >>
    bounds := layout.Rect{x: x,y: y,width: width,height: height}
    validate_bounds(&bounds) or >>
    old := s.nodes[id - 1].local
    if old.x != x || old.y != y || old.width != width || old.height != height { s.nodes[id - 1].local = bounds
        s.dirty = true }
    << 0
}
pub fn (s &Screen) bounds(id int) layout.Rect { n := s.node(id) or >>
    << n.bounds }

// xacp_tree is the only public node enumeration API. It lays out controls
// before copying data, caps the result, and returns no internal handles.
pub fn (s &mut Screen) xacp_tree(include_hidden bool,max_rows int) []ScreenNodeInfo {
    s.check_screen() or >>
    if max_rows <= 0 || max_rows > XACP_MAX_NODES { >> errors.new("widgets: invalid xacp tree limit") }
    s.layout_controls() or >>
    mut out := []ScreenNodeInfo{}
    for n in s.nodes {
        if n.kind < 0 { -> }
        visible := s.is_visible(n.id)
        if !include_hidden && !visible { -> }
        if out.len >= max_rows { >> errors.new("widgets: xacp tree exceeds node limit") }
        text := s.texts[n.id - 1] + ""
        if text.len > XACP_MAX_NODE_TEXT { >> errors.new("widgets: xacp node text exceeds memory limit") }
        out.push(ScreenNodeInfo{id: n.id,kind: n.kind,parent: n.parent,x: n.bounds.x,y: n.bounds.y,
            width: n.bounds.width,height: n.bounds.height,visible: visible,enabled: n.enabled,
            focusable: n.focusable,focused: s.focused == n.id,text: text})
    }
    << out
}

// xacp_input validates canvas identity before dispatching every event. A
// foreign or stale generation is an error rather than a silently ignored UI
// operation, which prevents use-after-close and cross-window event injection.
pub fn (s &mut Screen) xacp_input(events &[]ui.InputEvent,max_events int) []Action {
    s.check_screen() or >>
    if max_events <= 0 || max_events > XACP_MAX_NODES || events.len > max_events {
        >> errors.new("widgets: xacp input exceeds event limit")
    }
    mut out := []Action{}
    for input in events {
        if !belongs(&s.identity,&input) { >> errors.new("widgets: xacp input has stale canvas identity") }
        if !ui.is_input_event(input.kind) { >> errors.new("widgets: xacp input has invalid event kind") }
        if math.is_nan(input.x) || math.is_inf(input.x) || math.abs(input.x) > 1000000000.0 ||
           math.is_nan(input.y) || math.is_inf(input.y) || math.abs(input.y) > 1000000000.0 ||
           math.is_nan(input.dx) || math.is_inf(input.dx) || math.abs(input.dx) > 1000000000.0 ||
           math.is_nan(input.dy) || math.is_inf(input.dy) || math.abs(input.dy) > 1000000000.0 ||
           input.button < 0 || input.button > 3 || input.buttons < 0 || input.buttons > 7 || input.modifiers < 0 || input.modifiers > 15 ||
           input.key < 0 || input.key > 1114111 || input.scan < 0 || input.scan > 65535 || input.repeat < 0 || input.repeat > 1 ||
           input.click_count < 0 || input.time_ns < 0 {
            >> errors.new("widgets: xacp input field out of range")
        }
        actions := s.dispatch(&input) or >>
        for action in actions { out.push(action) }
        if out.len > XACP_MAX_NODES { >> errors.new("widgets: xacp action output exceeds memory limit") }
    }
    << out
}

// xacp_act provides the small, schema-approved action set. Click is routed
// through the normal pointer path, so hit testing, modal rules and focus
// transitions remain identical to native input.
pub fn (s &mut Screen) xacp_act(id int,act string,text string,checked bool) []Action {
    s.check_screen() or >>
    n := s.node(id) or >>
    mut out := []Action{}
    if act == "focus" {
        s.focus(id) or >>
        << out
    }
    if act == "set_text" {
        if text.len > XACP_MAX_NODE_TEXT { >> errors.new("widgets: xacp text exceeds memory limit") }
        s.set_text(id,text) or >>
        << out
    }
    if act == "set_checked" {
        if n.kind != SCREEN_BUTTON { >> errors.new("widgets: xacp checked target is not a button") }
        s.set_selected_button(id,checked) or >>
        << out
    }
    if act == "click" {
        if n.kind != SCREEN_BUTTON { >> errors.new("widgets: xacp click target is not a button") }
        s.layout_controls() or >>
        b := s.bounds(id) or >>
        if b.width <= 0.0 || b.height <= 0.0 { >> errors.new("widgets: xacp click target has empty bounds") }
        base := ui.InputEvent{kind: ui.EV_POINTER_DOWN,window_id: s.identity.window_id,canvas_id: s.identity.canvas_id,generation: s.identity.generation,
            x: b.x + b.width / 2.0,y: b.y + b.height / 2.0,dx: 0.0,dy: 0.0,button: ui.BUTTON_LEFT,buttons: 1,
            modifiers: 0,key: 0,scan: 0,repeat: 0,click_count: 1,time_ns: s.now.nanoseconds()}
        mut down := base
        down.kind = ui.EV_POINTER_DOWN
        mut up := base
        up.kind = ui.EV_POINTER_UP
        first := s.dispatch(&down) or >>
        second := s.dispatch(&up) or >>
        for action in first { out.push(action) }
        for action in second { out.push(action) }
        << out
    }
    >> errors.new("widgets: xacp action is not enabled")
}
fn (s &Screen) global_bounds(id int) layout.Rect {
    n := s.node(id) or >>
    mut b := n.local
    mut parent := n.parent
    mut budget := s.nodes.len
    while parent > 0 && budget > 0 {
        p := s.node(parent) or >>
        b.x += p.local.x
        b.y += p.local.y
        if s.basics.scrolls.has(parent) { offset := s.basics.scrolls[parent].offset()
            if s.basics.scrolls[parent].axis() == AXIS_HORIZONTAL { b.x -= offset }
            else { b.y -= offset } }
        if p.kind >= SCREEN_POPOVER { b.x += p.bounds.x - p.local.x
            b.y += p.bounds.y - p.local.y
            <- }
        parent = p.parent
        budget -= 1
    }
    << b
}
fn (s &mut Screen) layout_controls() int {
    s.layout_badge_attachments() or >>
    // Overlay surfaces establish coordinate origins for their children first.
    for pass in 0:2 {
        if pass == 1 { s.layout_card_sections() or >> }
        for index in 0:s.nodes.len {
            n := s.nodes[index]
            if n.kind < 0 { -> }
            if n.kind >= SCREEN_POPOVER { if pass == 0 { s.overlay_place(n.id) or >> }
                -> }
            if pass == 0 { -> }
            b := s.global_bounds(n.id) or >>
            s.nodes[index].bounds = b
            if n.kind == SCREEN_BUTTON { mut control := s.take_button(n.id)
                control.set_enabled(s.effective_enabled(n.id))
                message := screen_place_button(mut &control,&b)
                s.buttons[n.id] = control
                if message.len > 0 { >> errors.new(message) } }
            else if n.kind >= SCREEN_CHECKBOX { inherited := s.effective_enabled(n.id)
                if inherited != n.inherited_enabled { s.control_enable(n.id,inherited) or >>
                    s.nodes[index].inherited_enabled = inherited }
                s.control_place(n.id,&b) or >>
                if n.kind == SCREEN_SPLIT_VIEW { s.layout_split_panes(n.id) or >> }
                popup := s.control_popup(n.id) or >>
                if popup.height > 0.0 {
                    above := b.y + b.height + popup.height > s.height && b.y >= popup.height
                    s.control_popup_above(n.id,above) or >> } }
        }
    }
    s.sync_tooltip_layers() or >>
    << 0
}
fn (s &Screen) cancellation() ui.InputEvent {
    << ui.InputEvent{kind: ui.EV_POINTER_CANCEL,window_id: s.identity.window_id,canvas_id: s.identity.canvas_id,generation: s.identity.generation,
        x: 0.0,y: 0.0,dx: 0.0,dy: 0.0,button: 0,buttons: 0,modifiers: 0,key: 0,scan: 0,repeat: 0,click_count: 0,time_ns: s.now.nanoseconds()}
}
fn (s &mut Screen) route_node(id int,kind int,event &ui.InputEvent) Action {
    n := s.node(id) or >>
    if n.kind == SCREEN_BUTTON {
        mut control := s.take_button(id)
        result := screen_input_button(mut &control,kind,event)
        s.buttons[id] = control
        if result.error.len > 0 { >> errors.new(result.error) }
        << result.action
    }
    if n.kind >= SCREEN_CHECKBOX && n.kind < SCREEN_POPOVER { << s.control_input(id,kind,event) or >> }
    if n.kind >= SCREEN_POPOVER {
        if kind == ROUTE_FOCUS || kind == ROUTE_BLUR { s.overlay_focus(id,kind == ROUTE_FOCUS,s.now) or >>
            << no_action(id,true) }
        << s.overlay_input(id,event) or >>
    }
    << no_action(id,false)
}
fn (s &mut Screen) pointer_cursor(cursor int) int {
    if cursor != s.pointer { s.window.content_command("cursor\t" + str(cursor)) or >>
        s.pointer = cursor }
    << 0
}
pub fn (s &mut Screen) cancel_all() int {
    event := s.cancellation()
    for n in s.nodes { if n.kind > SCREEN_LABEL { _ := s.route_node(n.id,ROUTE_CANCEL,&event) or >> } }
    s.focused = 0
    s.captured = 0
    s.hovered = 0
    s.pointer_cursor(ui.CURSOR_DEFAULT) or >>
    s.dirty = true
    << 0
}
fn (s &mut Screen) focus_ready(id int,modal int) bool {
    if id <= 0 || id > s.nodes.len { << false }
    n := s.nodes[id - 1]
    if n.kind < 0 || !s.effective_enabled(id) || !n.focusable || !s.is_visible(id) || n.bounds.width <= 0.0 || n.bounds.height <= 0.0 { << false }
    if modal > 0 && (id == modal || !s.is_descendant(id,modal)) { << false }
    if n.kind==SCREEN_SELECT && s.basics.selects[id].count()==0 { << false }
    if n.kind==SCREEN_WEBVIEW { web := s.web_state(id) or >>
        if !web.loaded || web.failed || web.suspended || web.closed { << false } }
    if n.kind >= SCREEN_POPOVER { << n.kind == SCREEN_TOAST && s.overlay_is_open(id) }
    // Children of a hidden modal never take background focus.
    for parent in s.nodes { if (parent.kind == SCREEN_MODAL || parent.kind == SCREEN_POPOVER) && parent.id != id && s.is_descendant(id,parent.id) {
        if !s.overlay_is_open(parent.id) { << false } } }
    << true
}
pub fn (s &mut Screen) focus(id int) int {
    if id == s.focused { << 0 }
    modal := s.modal_blocks()
    if id != 0 && !s.focus_ready(id,modal) or >> { << 0 }
    for panel in s.nodes { if panel.kind == SCREEN_POPOVER && s.overlay_is_open(panel.id) && s.is_descendant(s.focused,panel.id) && !s.is_descendant(id,panel.id) {
        mut control := s.screen_take_popover(panel.id) or >>
        control.close(s.now,s.reduced) or (err) { s.screen_put_popover(panel.id,control.clone_panel())
            >> err }
        s.screen_put_popover(panel.id,control)
    } }
    if id > 0 { s.reveal_scroll_child(id) or >> }
    event := s.cancellation()
    previous := s.focused
    s.focused = id
    if previous > 0 { _ := s.route_node(previous,ROUTE_BLUR,&event) or >> }
    if id > 0 { _ := s.route_node(id,ROUTE_FOCUS,&event) or >> }
    for n in s.nodes { if n.kind == SCREEN_TOOLTIP { s.overlay_focus(n.id,id == s.overlay_anchor(n.id),s.now) or >> } }
    if modal > 0 && id > 0 { s.modal_sync_focus(modal,id) or >> }
    s.dirty = true
    << 0
}
fn (s &mut Screen) accept(action Action,actions &mut []Action) int {
    if action.needs_paint { s.dirty = true }
    if action.request_focus { s.focus(action.id) or >> }
    if action.kind != ACTION_NONE { actions.push(action) }
    << 0
}
fn (s &Screen) in_modal(id int,modal int) bool {
    if modal > 0 { << id != modal && s.is_descendant(id,modal) }
    for n in s.nodes { if n.kind == SCREEN_MODAL && s.is_descendant(id,n.id) { << false }
        if n.kind == SCREEN_POPOVER && s.is_descendant(id,n.id) && !s.overlay_is_open(n.id) { << false } }
    << true
}
fn (s &mut Screen) hit(x f64,y f64,modal int) int {
    surface := s.popover_at(x,y)
    mut i := s.nodes.len - 1
    while i >= 0 { n := s.nodes[i]
        if n.kind >= SCREEN_BUTTON && n.kind < SCREEN_POPOVER && n.focusable && s.effective_enabled(n.id) && s.is_visible(n.id) && s.in_modal(n.id,modal) && (surface == 0 || s.is_descendant(n.id,surface)) && n.bounds.contains(x,y) { clip := s.child_clip(n.id) or >>
            if clip.contains(x,y) {
                if n.kind == SCREEN_SPLIT_VIEW && !s.split_handle(n.id).contains(x,y) { i -= 1
                    -> }
                << n.id } }
        i -= 1 }
    << 0
}
fn (s &mut Screen) dispatch_input(input &ui.InputEvent) []Action {
    mut actions := []Action{}
    if !belongs(&s.identity,input) { << actions }
    s.layout_controls() or >>
    if input.kind == ui.EV_POINTER_CANCEL {
        // The draw surface resigns when a native child receives focus. Its
        // pointer cancellation must not undo that child's focus handoff.
        mut native_focus := 0
        if s.focused > 0 && s.nodes[s.focused - 1].kind == SCREEN_WEBVIEW { native_focus = s.focused }
        s.cancel_all() or >>
        if native_focus > 0 { s.focus(native_focus) or >> }
        << actions }
    modal := s.modal_blocks()
    if modal > 0 {
        a := s.overlay_modal_input(modal,input) or >>
        if a.needs_paint { s.dirty = true }
        if a.consumed {
            s.focus(s.modal_focused(modal)) or >>
            << actions
        }
    }
    // Hover observers see the move even when a surface above consumes it.
    for n in s.nodes { if n.kind == SCREEN_TOOLTIP && s.is_visible(n.id) {
        a := s.overlay_input(n.id,input) or >>
        s.accept(a,mut &actions) or >>
        if a.consumed { << actions } } }
    if modal == 0 {
        mut i := s.nodes.len - 1
        while i >= 0 { n := s.nodes[i]
            if (n.kind == SCREEN_TOAST || n.kind == SCREEN_POPOVER) && s.is_visible(n.id) {
                a := s.overlay_input(n.id,input) or >>
                s.accept(a,mut &actions) or >>
                if a.consumed { << actions } }
            i -= 1 }
    }
    // Popup rectangles are tested before ordinary fields, in reverse paint order.
    mut i := s.nodes.len - 1
    while i >= 0 { n := s.nodes[i]
        if n.kind >= SCREEN_CHECKBOX && n.kind < SCREEN_POPOVER && s.is_visible(n.id) && s.in_modal(n.id,modal) {
            popup := s.control_popup(n.id) or >>
            if popup.width > 0.0 && popup.contains(input.x,input.y) && input.kind != ui.EV_KEY_DOWN && input.kind != ui.EV_KEY_UP {
                a := s.route_node(n.id,ROUTE_INPUT,input) or >>
                s.accept(a,mut &actions) or >>
                if a.consumed { s.captured = n.id
                    if input.kind == ui.EV_POINTER_UP { s.captured = 0 }
                    s.pointer_cursor(ui.CURSOR_HAND) or >>
                    << actions }
            }
        }
        i -= 1
    }
    if input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_TAB {
        backward := (input.modifiers & ui.MOD_SHIFT) != 0
        if s.focused > 0 && s.nodes[s.focused - 1].kind == SCREEN_RANGE_SLIDER {
            if s.range_tab(s.focused,backward,false) or >> { s.dirty = true
                << actions } }
        mut order := []int{}
        for n in s.nodes { if s.focus_ready(n.id,modal) or >> { order.push(n.id) } }
        if order.len > 0 {
            mut position := -1
            for index in 0:order.len { if order[index] == s.focused { position = index } }
            if (input.modifiers & ui.MOD_SHIFT) != 0 { position -= 1
                if position < 0 { position = order.len - 1 } }
            else { position += 1
                if position >= order.len { position = 0 } }
            s.focus(order[position]) or >>
            if s.nodes[order[position] - 1].kind == SCREEN_RANGE_SLIDER { _ := s.range_tab(order[position],backward,true) or >> }
        }
        << actions
    }
    if input.kind == ui.EV_KEY_DOWN || input.kind == ui.EV_KEY_UP {
        if s.focused > 0 && s.focus_ready(s.focused,modal) or >> {
            a := s.route_node(s.focused,ROUTE_INPUT,input) or >>
            s.accept(a,mut &actions) or >>
            if a.consumed { << actions }
        }
        shortcut := s.menu_shortcut(input,modal) or >>
        s.accept(shortcut,mut &actions) or >>
        if shortcut.consumed { << actions }
        if modal == 0 && input.kind == ui.EV_KEY_DOWN { actions.push(Action{kind: ACTION_KEY,id: 0,
            needs_paint: false,request_focus: false,consumed: false,value: f64(input.key)}) }
        << actions
    }
    mut target := s.hit(input.x,input.y,modal) or >>
    if input.kind == ui.EV_POINTER_LEAVE { target = 0 }
    if s.hovered != target {
        if s.hovered > 0 { mut leave := choice_copy_input(input)
            leave.kind = ui.EV_POINTER_LEAVE
            departed := s.route_node(s.hovered,ROUTE_INPUT,&leave) or >>
            s.accept(departed,mut &actions) or >> }
        s.hovered = target
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        // An outside click closes editors and candidate lists through blur.
        if target > 0 || s.popover_at(input.x,input.y) == 0 { s.focus(target) or >> }
        s.captured = target
    }
    mut owner := target
    if s.captured > 0 && input.kind != ui.EV_POINTER_SCROLL { owner = s.captured }
    mut cursor := ui.CURSOR_DEFAULT
    if owner > 0 {
        n := s.node(owner) or >>
        cursor = n.cursor
        if n.kind >= SCREEN_CHECKBOX { cursor = s.control_cursor(owner,input.x,input.y) or >> }
        a := s.route_node(owner,ROUTE_INPUT,input) or >>
        s.accept(a,mut &actions) or >>
        if !a.consumed && input.kind == ui.EV_POINTER_SCROLL { s.bubble_scroll(owner,input,mut &actions) or >> }
    }
    if input.kind == ui.EV_POINTER_LEAVE { cursor = ui.CURSOR_DEFAULT }
    s.pointer_cursor(cursor) or >>
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT { s.captured = 0 }
    << actions
}
fn (s &mut Screen) paint_caption(id int,secondary bool,frame &mut draw.Frame,bounds &layout.Rect,style &ControlStyle,opacity f64) int {
    key := id * 2
    mut slot := key
    mut value := s.texts[id - 1] + ""
    if secondary { slot += 1
        value = s.descriptions[id - 1] + "" }
    faded := style.with_opacity(opacity) or >>
    styles := s.styles.clone()
    if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
    mut cache := s.take_label_cache(slot)
    wrap := s.nodes[id - 1].kind >= SCREEN_POPOVER || s.basics.wrapped_labels.has(id)
    err_msg := screen_paint_caption_text(mut &cache,&value,frame,bounds,&styles,&faded,wrap)
    s.labels[slot] = cache
    if err_msg != "" { >> errors.new(err_msg) }
    << 0
}
fn screen_paint_caption_text(cache &mut TextCache,value &string,frame &mut draw.Frame,bounds &layout.Rect,styles &Styles,faded &ControlStyle,wrap bool) string {
    if wrap { cache.paint_wrapped(0,value,frame,bounds,styles,faded,0) or (err) { << err.msg() }
        << "" }
    cache.paint_text(0,value,frame,bounds,styles,faded,0) or (err) { << err.msg() }
    << ""
}
fn (s &mut Screen) paint_text(id int,frame &mut draw.Frame,bounds &layout.Rect,style &ControlStyle,opacity f64) int {
    << s.paint_caption(id,false,frame,bounds,style,opacity) or >>
}
fn (s &mut Screen) paint_node(id int,frame &mut draw.Frame,opacity f64) int {
    clip := s.child_clip(id) or >>
    if clip.width <= 0.0 || clip.height <= 0.0 { << 0 }
    frame.push() or >>
    frame.clip_rect(clip.x,clip.y,clip.width,clip.height) or >>
    message := screen_paint_clipped(s,id,frame,opacity)
    frame.pop() or >>
    if message.len > 0 { >> errors.new(message) }
    << 0
}
fn screen_paint_clipped(s &mut Screen,id int,frame &mut draw.Frame,opacity f64) string {
    s.paint_node_content(id,frame,opacity) or (err) { << err.msg() }
    << ""
}
fn (s &mut Screen) paint_node_content(id int,frame &mut draw.Frame,opacity f64) int {
    n := s.node(id) or >>
    styles := s.styles.clone()
    if n.kind == SCREEN_LABEL {
        mut style := styles.input.clone()
        style.padding = layout.insets(0.0) or >>
        style.align_x = 0.0
        style.align_y = 0.0
        style.inherit_font = false
        style.font = copy_font(&styles.font)
        style.font.size = s.text_sizes[id - 1]
        if s.muted[id - 1] || !s.effective_enabled(id) { style.palette.foreground = style.palette.muted }
        if s.basics.label_styles.has(id) { encoded := s.basics.label_styles[id] + ""
            style = decode_control_style(&encoded,&style) }
        if s.basics.ellipsis_labels.has(id) { faded := style.with_opacity(opacity) or >>
            s.paint_label_ellipsis(id,frame,&n.bounds,&styles,&faded) or >> }
        else { s.paint_text(id,frame,&n.bounds,&style,opacity) or >> }
    } else if n.kind == SCREEN_BUTTON {
        control := s.take_button(id)
        mut transition := s.take_button_transition(id)
        slot := id * 2
        if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
        mut cache := s.take_label_cache(slot)
        value := s.texts[id - 1] + ""
        base := s.screen_button_style(id,&control,&styles) or >>
        mut message := ""
        now := s.now
        reduced := s.reduced
        labeled_icon := s.basics.button_icon_labels.has(id)
        if s.basics.button_icons.has(id) { owner := mut &s.basics
            icons := mut &owner.button_icons
            image := icons.take(id)
            if labeled_icon { message = screen_paint_labeled_icon_button(&control,mut &transition,mut &cache,&image,frame,&n.bounds,&styles,&base,&value,opacity,now,reduced) }
            else { message = screen_paint_icon_button(&control,mut &transition,&image,frame,&n.bounds,&styles,&base,opacity,now,reduced) }
            icons[id] = image }
        else { message = screen_paint_button(&control,mut &transition,mut &cache,frame,&n.bounds,&styles,&base,&value,opacity,now,reduced) }
        s.buttons[id] = control
        s.button_transitions[id] = transition
        s.labels[slot] = cache
        if message.len > 0 { >> errors.new(message) }
    } else if n.kind >= SCREEN_CHECKBOX && n.kind < SCREEN_POPOVER { s.control_paint(id,frame,&styles,false) or >> }
    << 0
}
fn (s &mut Screen) record(frame &mut draw.Frame) int {
    region := screen_empty()
    << s.record_region(frame,&region,false) or >>
}
fn (s &mut Screen) record_region(frame &mut draw.Frame,region &layout.Rect,cropped bool) int {
    s.layout_controls() or (err) { >> errors.new("widgets: screen layout: " + err.msg()) }
    s.sync_webviews() or >>
    styles := s.styles.clone()
    frame.begin() or >>
    frame.set_bg(styles.background) or >>
    if cropped {
        frame.push() or >>
        frame.clip_rect(0.0,0.0,region.width,region.height) or >>
        frame.translate(0.0 - region.x,0.0 - region.y) or >>
    }
    for n in s.nodes { if n.kind >= SCREEN_LABEL && n.kind < SCREEN_POPOVER && s.is_visible(n.id) && s.in_modal(n.id,0) && !s.in_popover_content(n.id) {
        s.paint_node(n.id,frame,1.0) or (err) { >> errors.new("widgets: paint node " + str(n.id) + ": " + err.msg()) } } }
    for n in s.nodes { if n.kind >= SCREEN_CHECKBOX && n.kind < SCREEN_POPOVER && s.is_visible(n.id) && s.in_modal(n.id,0) && !s.in_popover_content(n.id) {
        s.control_paint(n.id,frame,&styles,true) or >> } }
    // Layer order is shared with input routing. Modal children draw last.
    for kind in [SCREEN_POPOVER,SCREEN_TOOLTIP,SCREEN_TOAST,SCREEN_MODAL] {
        for n in s.nodes { if n.kind == kind && s.is_visible(n.id) {
            if kind == SCREEN_POPOVER && s.popover_has_content(n.id) { s.record_popover(n.id,frame,&styles) or >> }
            else { s.overlay_paint(n.id,frame,&styles) or >> }
            if kind == SCREEN_MODAL && s.overlay_is_visible(n.id) {
                opacity := s.overlay_opacity(n.id)
                bounds := s.bounds(n.id) or >>
                mut title := styles.input.clone()
                title.inherit_font = false
                title.font = copy_font(&styles.font)
                title.font.size = 21.0
                title.align_x = 0.0
                title.align_y = 0.0
                title.padding = layout.insets(0.0) or >>
                factor := math.max(1.0,math.max(styles.density,styles.text_scale))
                title_bounds := layout.Rect{x: bounds.x + 24.0 * factor,y: bounds.y + 30.0 * factor,width: math.max(0.0,bounds.width - 48.0 * factor),height: 50.0 * factor}
                s.paint_text(n.id,frame,&title_bounds,&title,opacity) or >>
                title.font.size = 14.0
                title.palette.foreground = title.palette.muted
                message_bounds := layout.Rect{x: bounds.x + 24.0 * factor,y: bounds.y + 92.0 * factor,width: math.max(0.0,bounds.width - 48.0 * factor),height: 72.0 * factor}
                s.paint_caption(n.id,true,frame,&message_bounds,&title,opacity) or >>
                frame.push() or >>
                frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or >>
                for child in s.nodes { if child.id != n.id && child.kind >= SCREEN_LABEL && child.kind < SCREEN_POPOVER && s.is_visible(child.id) && s.is_descendant(child.id,n.id) {
                    s.paint_node(child.id,frame,opacity) or >> } }
                frame.pop() or >>
                for child in s.nodes { if child.kind >= SCREEN_CHECKBOX && child.kind < SCREEN_POPOVER && s.is_visible(child.id) && s.is_descendant(child.id,n.id) {
                    s.control_paint(child.id,frame,&styles,true) or >> } }
            }
        } }
    }
    if cropped { frame.pop() or >> }
    << 0
}
fn (s &mut Screen) acknowledge() int {
    for n in s.nodes {
        if n.kind == SCREEN_BUTTON { mut b := s.take_button(n.id)
            b.painted()
            s.buttons[n.id] = b }
        else if n.kind >= SCREEN_CHECKBOX && n.kind < SCREEN_POPOVER { s.control_painted(n.id) or >> }
        else if n.kind >= SCREEN_POPOVER { s.overlay_painted(n.id) or >> }
    }
    << 0
}
fn (s &mut Screen) draw_and_present(frame &mut draw.Frame) int {
    s.record(frame) or >>
    frame.present_wait() or (err) { >> errors.new("widgets: frame submit: " + err.msg()) }
    << 0
}
pub fn (s &mut Screen) render() bool {
    if !s.is_open() || !s.dirty { << false }
    mut frame := s.take_frame()
    err := s.draw_and_present(mut &frame)
    s.frames[1] = frame
    if err != 0 { << false }
    s.acknowledge() or >>
    s.dirty = false
    << true
}
// Export/preview still uses the same placement and layer ordering as render.
pub fn (s &mut Screen) snapshot(scale f64) draw.Surface {
    s.check_screen() or >>
    for node in s.nodes { if node.kind == SCREEN_WEBVIEW && s.is_visible(node.id) { >> errors.new("widgets: canvas snapshots cannot include a native WebView surface") } }
    mut frame := s.context.new_frame(32768)
    s.record(mut &frame) or (err) { frame.dispose()
        >> err }
    surface := frame.snapshot(s.width,s.height,scale) or (err) { frame.dispose()
        >> err }
    frame.dispose()
    << surface
}

// snapshot_node uses the same paint order as the full snapshot while clipping
// and translating the requested node rectangle. The returned Surface remains
// an owning native resource and must be disposed by the caller.
pub fn (s &mut Screen) snapshot_node(id int,scale f64) draw.Surface {
    s.check_screen() or >>
    for node in s.nodes { if node.kind == SCREEN_WEBVIEW && s.is_visible(node.id) { >> errors.new("widgets: canvas snapshots cannot include a native WebView surface") } }
    s.layout_controls() or >>
    _ := s.node(id) or >>
    region := s.bounds(id) or >>
    if region.width <= 0.0 || region.height <= 0.0 { >> errors.new("widgets: empty snapshot node bounds") }
    mut frame := s.context.new_frame(32768)
    s.record_region(mut &frame,&region,true) or (err) { frame.dispose()
        >> err }
    surface := frame.snapshot(region.width,region.height,scale) or (err) { frame.dispose()
        >> err }
    frame.dispose()
    << surface
}
pub fn (s &mut Screen) advance(now time.Instant) time.Instant {
    // Retarget immediately after input, otherwise wait for the previously
    // scheduled boundary. Continuous tweens must not turn next() into a spin.
    if !s.dirty && !s.animation_deadline.is_zero() && now.before(s.animation_deadline) { << s.animation_deadline }
    s.now = now
    if s.dirty { s.layout_controls() or >> }
    mut deadline := s.advance_buttons(now) or >>
    for n in s.nodes {
        if n.kind < SCREEN_CHECKBOX || !s.is_visible(n.id) { -> }
        mut step := ScreenAnimation{changed: false,deadline: time.zero_instant()}
        if n.kind < SCREEN_POPOVER { step = s.control_tick(n.id,now,s.reduced) or >> }
        else { step = s.overlay_tick(n.id,now,s.reduced) or >> }
        if step.changed { s.dirty = true }
        deadline = screen_earlier(deadline,step.deadline)
        if n.kind == SCREEN_MODAL { restore := s.modal_restore(n.id) or >>
            if restore > 0 { s.focus(restore) or >> } }
        if n.kind == SCREEN_TOAST && s.focused == n.id && !s.overlay_is_open(n.id) { s.focus(0) or >> }
    }
    s.pump_notices() or >>
    s.animation_deadline = deadline
    << deadline
}
pub fn (s &mut Screen) dispatch(input &ui.InputEvent) []Action {
    if input.time_ns > 0 { s.now = time.instant_from_ns(input.time_ns) or >> }
    << s.dispatch_input(input) or >>
}
pub fn (s &mut Screen) event(event &ui.Event) []Action {
    mut actions := []Action{}
    if !s.is_open() { << actions }
    s.now = time.instant()
    if event.kind == ui.EV_EXIT { s.closed = true
        << actions }
    if event.window_id != s.identity.window_id { << actions }
    if event.kind == ui.EV_NATIVE_VIEW { << s.web_event(event) or >> }
    if event.kind == ui.EV_CLOSED { s.closed = true
        << actions }
    if event.kind == ui.EV_CANVAS_CLOSED { identity := ui.canvas_of(event) or >>
        if identity.canvas_id == s.identity.canvas_id && identity.generation == s.identity.generation { s.closed = true }
        << actions }
    if event.kind == ui.EV_CANVAS_METRICS { metrics := ui.metrics_of(event) or >>
        if metrics.canvas_id == s.identity.canvas_id && metrics.generation == s.identity.generation && metrics.width > 0.0 && metrics.height > 0.0 { s.resize(metrics.width,metrics.height) or >> }
        << actions }
    if event.kind == ui.EV_CANVAS_PREFERENCES { prefs := ui.canvas_preferences_of(event) or >>
        if prefs.identity.canvas_id == s.identity.canvas_id && prefs.identity.generation == s.identity.generation { s.set_reduced_motion(prefs.reduced_motion) }
        << actions }
    if event.kind == ui.EV_BLURRED { s.cancel_all() or >>
        << actions }
    if event.kind == ui.EV_FOCUSED { ui.request_canvas_preferences(&s.identity) or >>
        modal := s.modal_blocks()
        if modal > 0 { s.focus(s.modal_focused(modal)) or >> }
        << actions }
    if ui.is_input_event(event.kind) { input := ui.input_of(event) or >>
        << s.dispatch_input(&input) or >> }
    for n in s.nodes { if n.kind == SCREEN_EDITOR || n.kind == SCREEN_COMBO || n.kind == SCREEN_FIELD {
        a := s.control_event(n.id,event) or >>
        s.accept(a,mut &actions) or >> } }
    << actions
}
fn screen_wait(events chan ui.Event,deadline time.Instant) ui.Event {
    if deadline.is_zero() { << <-events }
    delay := deadline.since(time.instant())
    if delay.nanoseconds() <= 0 { << ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0} }
    timer := delay.timer()
    select {
        event := <-events { timer.stop()
            << event }
        _ := <-timer.c { timer.stop()
            << ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0} }
    }
    << ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0}
}
// Block when idle; coalesce non-semantic input bursts before one repaint.
pub fn (s &mut Screen) next(events chan ui.Event) []Action {
    if !s.is_open() { << []Action{} }
    deadline := s.advance(time.instant()) or >>
    if s.queued_actions.len > 0 { << s.take_actions() }
    if s.dirty { << []Action{} }
    event := screen_wait(events,deadline) or >>
    mut actions := s.event(&event) or >>
    _ := s.advance(time.instant()) or >>
    timed := s.take_actions()
    for action in timed { actions.push(action) }
    mut count := 0
    while s.is_open() && count < 128 {
        pending := ui.poll_chan(events)
        if pending.kind == ui.EV_NONE { <- }
        more := s.event(&pending) or >>
        for action in more { actions.push(action) }
        count += 1
    }
    << actions
}
pub fn (s &mut Screen) close() int {
    if s.is_open() { s.window.command("close") or >>
        s.closed = true }
    << 0
}
fn (s &mut Screen) try_cancel_all() {
    s.cancel_all() or (err) { s.focused = 0
        << }
}
pub fn (s &mut Screen) dispose() {
    if s.disposed { << }
    s.try_cancel_all()
    for n in s.nodes { if n.kind >= SCREEN_CHECKBOX && n.kind < SCREEN_POPOVER { s.control_dispose(n.id) or (err) { -> } }
        else if n.kind >= SCREEN_POPOVER { s.overlay_dispose(n.id) or (err) { -> } }
        for secondary in 0:2 { key := n.id * 2 + secondary
            if s.labels.has(key) { mut cache := s.take_label_cache(key)
                cache.dispose() } }
    }
    node_count := s.nodes.len
    owner := mut &s.basics
    icons := mut &owner.button_icons
    for i in 0:node_count { id := i + 1
        if icons.has(id) { mut icon := icons.take(id)
        icon.dispose() or (err) { -> } } }
    owner.button_icon_labels = map[int]bool{}
    ellipses := mut &owner.ellipsis_labels
    for i in 0:node_count { id := i + 1
        if ellipses.has(id) { mut label := ellipses.take(id)
        label.dispose() } }
    s.buttons = map[int]Button{}
    s.labels = map[int]TextCache{}
    mut frame := s.take_frame()
    frame.dispose()
    s.disposed = true
    s.closed = true
}

// The callback owns business state only. Screen owns dispatch, rendering,
// native resources and cleanup, including errors from either callback.
pub struct@ ScreenHandler {
    fn layout(&mut Screen) int
    fn update(&mut Screen,Action) int
}
pub fn run_screen#H:ScreenHandler(s &mut Screen,events chan ui.Event,handler &mut H) int {
    screen_loop(s,events,handler) or (err) { s.dispose()
        >> err }
    s.dispose()
    << 0
}
fn screen_loop#H:ScreenHandler(s &mut Screen,events chan ui.Event,handler &mut H) int {
    handler.layout(s) or >>
    _ := s.render() or >>
    while s.is_open() {
        actions := s.next(events) or >>
        if !s.is_open() { <- }
        for action in actions { handler.update(s,action) or >> }
        if !s.is_open() { <- }
        handler.layout(s) or >>
        _ := s.render() or >>
    }
    << 0
}

fn (s &mut Screen) take_button(id int) Button { items := mut &s.buttons
    << items.take(id) }
fn (s &mut Screen) take_label_cache(id int) TextCache { items := mut &s.labels
    << items.take(id) }
fn (s &mut Screen) take_frame() draw.Frame { items := mut &s.frames
    << items.take(1) }

// next() drains these automatically. Custom event loops call this after
// advance() to receive timer-driven actions such as Stepper repetition.
pub fn (s &mut Screen) take_actions() []Action {
    mut actions := []Action{}
    for action in s.queued_actions { actions.push(action) }
    s.queued_actions = []Action{}
    << actions
}
