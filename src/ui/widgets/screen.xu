@ui/widgets

#ui
#ui/draw
#ui/layout
#time
#math
#errors

// Screen owns built-in controls and their native resources. Handles are local
// to this screen and never reused; applications keep only business state.
const SCREEN_GROUP = 0
const SCREEN_LABEL = 1
const SCREEN_BUTTON = 2
const SCREEN_CHECKBOX = 3
const SCREEN_SWITCH = 4
const SCREEN_RADIO = 5
const SCREEN_SLIDER = 6
const SCREEN_STEPPER = 7
const SCREEN_TABS = 8
const SCREEN_SELECT = 9
const SCREEN_LIST = 14
const SCREEN_PROGRESS = 15
const SCREEN_DIVIDER = 16
const SCREEN_BADGE = 17
const SCREEN_CARD = 18
const SCREEN_RADIO_GROUP = 19
const SCREEN_TABLE = 10
const SCREEN_TREE = 11
const SCREEN_PAGINATION = 12
const SCREEN_BREADCRUMBS = 13
const SCREEN_COMBO = 20
const SCREEN_MULTI = 21
const SCREEN_COLOR = 22
const SCREEN_DATE = 23
const SCREEN_CLOCK = 24
const SCREEN_SPINNER = 25
const SCREEN_EDITOR = 26
const SCREEN_FIELD = 27
const SCREEN_TASK = 28
const SCREEN_WEBVIEW = 29
const SCREEN_CHART = 30
const SCREEN_BUTTON_GROUP = 31
const SCREEN_RANGE_SLIDER = 32
const SCREEN_SPLIT_VIEW = 33
const SCREEN_MENU = 34
pub const SCREEN_SECRET_INPUT = 35
const SCREEN_POPOVER = 36
const SCREEN_TOOLTIP = 37
const SCREEN_TOAST = 38
const SCREEN_MODAL = 39
pub const SCREEN_SELECTABLE_TEXT = 40
pub const SCREEN_CUSTOM = 41
pub const ACTION_KEY = 5

struct ScreenNode {
    id int
    kind int
    parent int
    bounds layout.Rect
    local layout.Rect
    visible bool
    enabled bool
    inherited_enabled bool
    focusable bool
    cursor int
    secure bool
}
// A bounded, immutable view of one retained screen node for tooling adapters.
// The internal node remains private so callers cannot forge handles or mutate
// layout/resource state behind Screen's lifecycle checks.
pub struct ScreenNodeInfo {
    pub id int
    pub kind int
    pub parent int
    pub x f64
    pub y f64
    pub width f64
    pub height f64
    pub visible bool
    pub enabled bool
    pub focusable bool
    pub focused bool
    pub text string
    pub secure bool
}

pub const XACP_MAX_NODES = 512
pub const XACP_MAX_NODE_TEXT = 65536
struct ScreenAnimation { changed bool
    deadline time.Instant }
pub struct Screen {
    identity ui.CanvasEvent
    context draw.Context
    window ui.Window
    frames map[int]draw.Frame
    styles Styles
    locale Locale
    locale_overrides map[int]Locale
    queued_actions []Action
    nodes []ScreenNode
    buttons map[int]Button
    button_variants map[int]int
    button_transitions map[int]PaintTransition
    texts []string
    descriptions []string
    text_sizes []f64
    muted []bool
    labels map[int]TextCache
    basics ScreenBasics
    webviews map[int]ScreenWebView
    controls ScreenControls
    overlays ScreenOverlays
    notices ScreenNotices
    composition ScreenComposition
    focused int
    keyboard_focus bool
    captured int
    hovered int
    pointer int
    now time.Instant
    animation_deadline time.Instant
    reduced bool
    width f64
    height f64
    dirty bool
    closed bool
    disposed bool
    xacp_closed chan int
    xacp_revision int
    xacp_events []string
}
fn screen_empty() layout.Rect { << layout.Rect{x: 0.0,y: 0.0,width: 0.0,height: 0.0} }
fn screen_earlier(a time.Instant,b time.Instant) time.Instant {
    if a.is_zero() || (!b.is_zero() && b.before(a)) { << b }
    << a
}
pub fn screen(ready &ui.Event) Screen {
    identity := ui.canvas_of(ready) >>>
    context := draw.context_of(ready) >>>
    window := ui.Window{id: identity.window_id,generation: identity.generation,title: "",width: 0,height: 0,
        content_kind: ui.CONTENT_DRAW,content_backend_id: identity.canvas_id,closed: 0}
    window.content_command("input_enabled\t1") >>>
    window.content_command("pan_enabled\t0") >>>
    ui.request_canvas_preferences(&identity) >>>
    $frames := map[int]draw.Frame{}
    frames[1] = context.new_frame(32768)
    << Screen{identity: copy_identity(&identity),context: context.clone(),window: window,frames: frames,
        styles: light_styles(),locale: locale_default(),locale_overrides: map[int]Locale{},queued_actions: []Action{},nodes: []ScreenNode{},buttons: map[int]Button{},button_variants: map[int]int{},button_transitions: map[int]PaintTransition{},texts: []string{},descriptions: []string{},
        text_sizes: []f64{},muted: []bool{},labels: map[int]TextCache{},basics: new_screen_basics(),webviews: map[int]ScreenWebView{},controls: new_screen_controls(),overlays: new_screen_overlays(),notices: new_screen_notices(),
        composition: new_screen_composition(),
        focused: 0,keyboard_focus: true,captured: 0,hovered: 0,pointer: ui.CURSOR_DEFAULT,now: time.instant(),animation_deadline: time.zero_instant(),reduced: false,
        width: 800.0,height: 600.0,dirty: true,closed: false,disposed: false,xacp_closed: chan int{cap: 1},xacp_revision: 1,xacp_events: []string{}}
}

pub fn hostless_screen(width f64,height f64) Screen {
    if !finite_metric(width,100000.0) || !finite_metric(height,100000.0) || width <= 0.0 || height <= 0.0 {
        >>> errors.new("widgets: hostless screen needs positive dimensions")
    }
    identity := ui.CanvasEvent{window_id: 1,canvas_id: 1,generation: 1}
    context := draw.hostless_context(1, 1)
    window := ui.Window{id: 1,generation: 1,title: "",width: int(width),height: int(height),
        content_kind: ui.CONTENT_DRAW,content_backend_id: 1,closed: 0}
    $frames := map[int]draw.Frame{}
    frames[1] = context.new_frame(32768)
    << Screen{identity: copy_identity(&identity),context: context.clone(),window: window,frames: frames,
        styles: light_styles(),locale: locale_default(),locale_overrides: map[int]Locale{},queued_actions: []Action{},nodes: []ScreenNode{},buttons: map[int]Button{},button_variants: map[int]int{},button_transitions: map[int]PaintTransition{},texts: []string{},descriptions: []string{},
        text_sizes: []f64{},muted: []bool{},labels: map[int]TextCache{},basics: new_screen_basics(),webviews: map[int]ScreenWebView{},controls: new_screen_controls(),overlays: new_screen_overlays(),notices: new_screen_notices(),
        composition: new_screen_composition(),
        focused: 0,keyboard_focus: true,captured: 0,hovered: 0,pointer: ui.CURSOR_DEFAULT,now: time.instant(),animation_deadline: time.zero_instant(),reduced: false,
        width: width,height: height,dirty: true,closed: false,disposed: false,xacp_closed: chan int{cap: 1},xacp_revision: 1,xacp_events: []string{}}
}
fn (s &Screen) check_screen() int {
    if s.disposed || s.closed { >>> errors.new("widgets: screen is closed") }
    << 0
}
fn (s &Screen) node(id int) ScreenNode {
    if id <= 0 || id > s.nodes.len || s.nodes[id - 1].kind < 0 { >>> errors.new("widgets: invalid screen handle") }
    << s.nodes[id - 1]
}
fn (s $&Screen) add_node(kind int,focusable bool,cursor int) int {
    s.check_screen() >>>
    if s.composition.live_nodes >= 512 || s.nodes.len >= 65536 { >>> errors.new("widgets: screen control capacity exceeded") }
    id := s.nodes.len + 1
    empty := screen_empty()
    s.nodes.push(ScreenNode{id: id,kind: kind,parent: 0,bounds: empty,local: empty,
        visible: true,enabled: true,inherited_enabled: true,focusable: focusable,cursor: cursor,secure: false})
    s.texts.push("")
    s.descriptions.push("")
    s.text_sizes.push(0.0)
    s.muted.push(false)
    s.register_node_categories(id,kind)
    s.children_order_append(0,id)
    comp := $&s.composition
    comp.live_nodes = comp.live_nodes + 1
    s.mark_layout_dirty()
    << id
}
fn (s $&Screen) abandon_node(id int) {
    if id > 0 && id <= s.nodes.len {
        old_kind := s.nodes[id - 1].kind
        was_live := old_kind >= 0
        parent := s.nodes[id - 1].parent
        s.nodes[id - 1].kind = -1
        s.nodes[id - 1].visible = false
        s.nodes[id - 1].enabled = false
        if was_live {
            s.unregister_node_categories(id,old_kind)
            s.clear_node_key_internal(id)
            s.children_order_remove(parent,id)
            comp := $&s.composition
            if comp.live_nodes > 0 { comp.live_nodes = comp.live_nodes - 1 }
            s.mark_layout_dirty()
        }
    }
}
pub fn (s &Screen) is_open() bool { << !s.closed && !s.disposed }
pub fn (s &Screen) xacp_window_id() int { << s.identity.window_id }
pub fn (s &Screen) xacp_canvas_id() int { << s.identity.canvas_id }
pub fn (s &Screen) xacp_generation() int { << s.identity.generation }
// A single control attachment may observe close/dispose without retaining a
// Screen reference. The Screen owner is the sole sender; notification is bounded.
pub fn (s &Screen) xacp_close_events() chan int { << s.xacp_closed }
fn (s $&Screen) notify_xacp_closed() {
    select {
        s.xacp_closed <- 1 {}
        else {}
    }
}
pub fn (s &Screen) width() f64 { << s.width }
pub fn (s &Screen) height() f64 { << s.height }
pub fn (s &Screen) focused() int { << s.focused }
pub fn (s &Screen) hovered() int { << s.hovered }
pub fn (s $&Screen) hit_test(x f64,y f64) int {
    s.check_screen() >>>
    s.layout_controls() >>>
    << s.hit(x,y,s.modal_blocks()) >>>
}
pub fn (s &Screen) reduced_motion() bool { << s.reduced }
pub fn (s &Screen) viewport() layout.Rect { << layout.Rect{x: 0.0,y: 0.0,width: s.width,height: s.height} }
pub fn (s &Screen) is_dirty() bool { << s.dirty }
pub fn (s $&Screen) invalidate() { s.mark_layout_dirty() }
pub fn (s $&Screen) resize(width f64,height f64) int {
    validate_bounds(&layout.Rect{x: 0.0,y: 0.0,width: width,height: height}) >>>
    if width <= 0.0 || height <= 0.0 { >>> errors.new("widgets: screen needs positive dimensions") }
    if width != s.width || height != s.height { s.width = width
        s.height = height
        s.mark_layout_dirty() }
    << 0
}
pub fn (s $&Screen) set_min_size(width int,height int) int { << s.window.command("minsize\t" + str(width) + "\t" + str(height)) >>> }
pub fn (s $&Screen) set_styles(styles &Styles) int {
    styles.validate() >>>
    if !s.styles.same_as(styles) { s.styles = styles.clone()
        s.mark_layout_dirty() }
    << 0
}
pub fn (s &Screen) styles() Styles { << s.styles.clone() }
pub fn (s &Screen) row_height() f64 { << math.max(36.0 * s.styles.density,29.0 * s.styles.text_scale) }
pub fn (s $&Screen) set_reduced_motion(reduced bool) { if s.reduced != reduced { s.reduced = reduced
    s.mark_paint_dirty() } }
pub fn (s $&Screen) group() int { << s.add_node(SCREEN_GROUP,false,ui.CURSOR_DEFAULT) >>> }
pub fn (s $&Screen) button(text string) int {
    id := s.add_node(SCREEN_BUTTON,true,ui.CURSOR_HAND) >>>
    control := button(&s.identity,id,&screen_empty()) >>> (err) { s.abandon_node(id)
        >>> err }
    s.buttons[id] = control
    s.button_transitions[id] = paint_transition()
    s.texts[id - 1] = text + ""
    s.apply_default_motion_to(id)
    << id
}
pub fn (s $&Screen) label(text string,size f64,muted bool) int {
    if !finite_metric(size,256.0) || size <= 0.0 { >>> errors.new("widgets: invalid label size") }
    id := s.add_node(SCREEN_LABEL,false,ui.CURSOR_DEFAULT) >>>
    s.texts[id - 1] = text + ""
    s.text_sizes[id - 1] = size
    s.muted[id - 1] = muted
    << id
}
pub fn (s $&Screen) set_text(id int,text string) int {
    n := s.node(id) >>>
    if n.kind == SCREEN_EDITOR || n.kind == SCREEN_SECRET_INPUT {
        s.set_value(id,text) >>>
        s.mark_layout_dirty()
        << 0
    }
    if n.kind == SCREEN_CHECKBOX || n.kind == SCREEN_SWITCH || n.kind == SCREEN_RADIO || n.kind == SCREEN_BADGE { << s.set_option_text(id,0,text) >>> }
    if s.texts[id - 1] != text { s.texts[id - 1] = text + ""
        if s.basics.selectable_texts.has(id) { s.selectable_text_sync_node(id) >>> }
        if screen_is_overlay(n.kind) { s.overlay_sync_text(id) >>> }
        s.mark_layout_dirty() }
    << 0
}
pub fn (s $&Screen) set_description(id int,description string) int {
    n := s.node(id) >>>
    if s.descriptions[id - 1] != description {
        s.descriptions[id - 1] = description + ""
        if n.kind == SCREEN_MODAL && s.is_selectable(id) { s.modal_sync_texts(id) >>> }
        if screen_is_overlay(n.kind) { s.mark_layout_dirty() }
        else { s.mark_paint_dirty() }
    }
    << 0
}
pub fn (s &Screen) description(id int) string {
    _ := s.node(id) >>>
    << s.descriptions[id - 1] + ""
}
pub fn (s $&Screen) set_selected_button(id int,selected bool) int {
    n := s.node(id) >>>
    if n.kind != SCREEN_BUTTON { >>> errors.new("widgets: handle is not a button") }
    $control := s.take_button(id)
    if control.selected == selected { s.buttons[id] = control
        << 0 }
    control.set_selected(selected)
    s.buttons[id] = control
    s.mark_paint_dirty()
    << 0
}
pub fn (s &Screen) is_descendant(id int,parent int) bool {
    $cursor := id
    $budget := s.nodes.len + 1
    while cursor > 0 && cursor <= s.nodes.len && budget > 0 {
        if cursor == parent { << true }
        cursor = s.nodes[cursor - 1].parent
        budget -= 1
    }
    << false
}
pub fn (s &Screen) is_visible(id int) bool {
    $cursor := id
    $budget := s.nodes.len + 1
    while cursor > 0 && cursor <= s.nodes.len && budget > 0 {
        n := s.nodes[cursor - 1]
        if n.kind < 0 || !n.visible { << false }
        if s.controls.split_panes.has(n.id) && (n.bounds.width <= 0.0 || n.bounds.height <= 0.0) { << false }
        if cursor != id && (n.kind == SCREEN_POPOVER || n.kind == SCREEN_MODAL) && !s.overlay_is_visible(cursor) { << false }
        cursor = n.parent
        budget -= 1
    }
    << cursor == 0 && budget > 0
}
// Disabled containers gate descendants while preserving each child's own flag.
fn (s &Screen) effective_enabled(id int) bool {
    $current := id
    $budget := s.nodes.len + 1
    while current > 0 && current <= s.nodes.len && budget > 0 { node := s.nodes[current - 1]
        if !node.enabled || node.kind < 0 { << false }
        current = node.parent
        budget -= 1 }
    << current == 0 && budget > 0
}
pub fn (s $&Screen) set_parent(id int,parent int) int {
    _ := s.node(id) >>>
    old_parent := s.nodes[id - 1].parent
    if old_parent == parent { << 0 }
    if parent != 0 { _ := s.node(parent) >>> }
    if parent == id || s.is_descendant(parent,id) { >>> errors.new("widgets: screen parent cycle") }
    s.record_reparent_flip(id,parent)
    s.detach_child_from_slot_if_reparented(id,parent)
    s.children_order_remove(old_parent,id)
    s.nodes[id - 1].parent = parent
    if id == s.composition.root_id && parent != 0 {
        comp := $&s.composition
        comp.root_id = 0
    }
    s.children_order_append(parent,id)
    if s.composition.subtree_locale_count > 0 { s.refresh_subtree_locale(id) >>> }
    if s.composition.subtree_motion_count > 0 || s.composition.has_default_motion { s.propagate_subtree_motion(id) >>> }
    s.mark_layout_dirty()
    << 0
}
pub fn (s &Screen) is_hovered_within(id int) bool {
    _ := s.node(id) >>>
    if s.hovered <= 0 || !s.is_visible(id) || s.is_layout_hidden(id) { << false }
    << s.is_descendant(s.hovered,id)
}
pub fn (s &Screen) is_focused_within(id int) bool {
    _ := s.node(id) >>>
    if s.focused <= 0 || !s.is_visible(id) || s.is_layout_hidden(id) { << false }
    << s.is_descendant(s.focused,id)
}
pub fn (s $&Screen) set_surface_state(id int,state int) int {
    _ := s.node(id) >>>
    if state < 0 || state > 127 { >>> errors.new("widgets: invalid surface state mask") }
    comp := $&s.composition
    ss := $&comp.surface_states
    if state == 0 {
        if ss.has(id) {
            ss.delete(id)
            if comp.surface_state_count > 0 { comp.surface_state_count = comp.surface_state_count - 1 }
            s.mark_paint_dirty()
        }
        << 0
    }
    had := ss.has(id)
    prev := ss.get_or(id,0)
    ss[id] = state
    if !had { comp.surface_state_count = comp.surface_state_count + 1 }
    if prev != state { s.mark_paint_dirty() }
    << 0
}
pub fn (s &Screen) surface_state(id int) int {
    _ := s.node(id) >>>
    << s.composition.surface_states.get_or(id,0)
}
pub fn (s $&Screen) set_focusable(id int,focusable bool) int {
    n := s.node(id) >>>
    if n.focusable != focusable {
        s.nodes[id - 1].focusable = focusable
        if !focusable && s.focused == id { s.focused = 0 }
        s.mark_paint_dirty()
    }
    << 0
}
pub fn (s $&Screen) set_cursor(id int,cursor int) int {
    n := s.node(id) >>>
    if cursor < ui.CURSOR_DEFAULT || cursor > ui.CURSOR_RESIZE_VERTICAL {
        >>> errors.new("widgets: invalid node cursor")
    }
    if n.cursor != cursor {
        s.nodes[id - 1].cursor = cursor
        s.mark_paint_dirty()
    }
    << 0
}
fn (s &Screen) has_styled_group_ancestor(id int) bool {
    if id <= 0 || id > s.nodes.len { << false }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        n := s.nodes[cur - 1]
        if n.kind < 0 { <- }
        if n.kind == SCREEN_GROUP && s.node_has_control_patch(cur) {
            patch := s.effective_control_patch(cur)
            f := patch.fields
            if (f & (STYLE_PATCH_HOVERED | STYLE_PATCH_PRESSED | STYLE_PATCH_DISABLED | STYLE_PATCH_FOCUS | STYLE_PATCH_STATES)) != 0 {
                << true
            }
        }
        if n.parent <= 0 { <- }
        cur = n.parent
        budget -= 1
    }
    << false
}
fn (s &Screen) group_effective_state(id int) int {
    $st := s.composition.surface_states.get_or(id,0)
    if !s.effective_enabled(id) { st = st | STATE_DISABLED }
    else {
        if s.hovered > 0 && s.is_descendant(s.hovered,id) { st = st | STATE_HOVERED }
        if s.captured > 0 && s.is_descendant(s.captured,id) { st = st | STATE_PRESSED }
    }
    if s.focused > 0 && s.is_descendant(s.focused,id) && s.node_has_control_patch(id) {
        patch := s.effective_control_patch(id)
        f := patch.fields
        if (f & (STYLE_PATCH_FOCUS | STYLE_PATCH_FOCUS_WIDTH | STYLE_PATCH_STATES)) != 0 {
            st = st | STATE_FOCUSED
        }
    }
    << st
}
pub fn (s $&Screen) set_visible(id int,visible bool) int {
    _ := s.node(id) >>>
    s.cancel_exiting_transitions(id)
    if visible && s.composition.hidden_node_count > 0 && s.composition.hidden_nodes.has(id) {
        comp := $&s.composition
        hn := $&comp.hidden_nodes
        hn.delete(id)
        if comp.hidden_node_count > 0 { comp.hidden_node_count = comp.hidden_node_count - 1 }
        s.mark_paint_dirty()
    }
    if s.nodes[id - 1].visible == visible { << 0 }
    $prev_focused := 0
    if !visible {
        prev_focused = s.focused
        event := s.cancellation()
        s.cancel_subtree_input(id,&event) >>>
        if s.is_descendant(s.focused,id) { s.focused = 0 }
        if s.is_descendant(s.captured,id) { s.captured = 0 }
        if s.is_descendant(s.hovered,id) {
            s.hovered = 0
            s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
        }
    }
    s.nodes[id - 1].visible = visible
    if !visible && s.composition.focus_trap_stack.len > 0 {
        s.restore_hidden_focus_trap(id,prev_focused) >>>
    }
    s.mark_layout_dirty()
    << 0
}
pub fn (s $&Screen) set_enabled(id int,enabled bool) int {
    n := s.node(id) >>>
    if n.enabled == enabled { << 0 }
    s.nodes[id - 1].enabled = enabled
    if n.kind == SCREEN_BUTTON { $control := s.take_button(id)
        control.set_enabled(enabled)
        s.buttons[id] = control }
    else if n.kind == SCREEN_SELECTABLE_TEXT { s.selectable_text_enable(id,enabled) >>> }
    else if n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id) { s.selectable_text_enable(id,enabled) >>> }
    else if screen_is_control(n.kind) { s.control_enable(id,enabled) >>> }
    if !enabled && (s.is_descendant(s.focused,id) || s.is_descendant(s.captured,id) || s.is_descendant(s.hovered,id)) {
        event := s.cancellation()
        _ := s.route_node(id,ROUTE_CANCEL,&event) >>>
        if s.is_descendant(s.focused,id) { if s.focused != id { _ := s.route_node(s.focused,ROUTE_CANCEL,&event) >>> }
            s.focused = 0 }
        if s.is_descendant(s.captured,id) { if s.captured != id { _ := s.route_node(s.captured,ROUTE_CANCEL,&event) >>> }
            s.captured = 0 }
        if s.is_descendant(s.hovered,id) {
            if s.hovered != id { _ := s.route_node(s.hovered,ROUTE_CANCEL,&event) >>> }
            s.hovered = 0
            s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
        }
    }
    s.mark_layout_dirty()
    << 0
}
pub fn (s $&Screen) place(id int,x f64,y f64,width f64,height f64) int {
    _ := s.node(id) >>>
    bounds := layout.Rect{x: x,y: y,width: width,height: height}
    validate_bounds(&bounds) >>>
    old := s.nodes[id - 1].local
    if old.x != x || old.y != y || old.width != width || old.height != height { s.nodes[id - 1].local = bounds
        s.mark_layout_dirty() }
    << 0
}
pub fn (s &Screen) bounds(id int) layout.Rect { n := s.node(id) >>>
    << n.bounds }

pub fn (s &Screen) xacp_revision() int { << s.xacp_revision }
pub fn (s &Screen) xacp_has_events() bool { << s.xacp_events.len > 0 }

fn (s $&Screen) record_xacp_event(entry string) {
    if s.xacp_events.len >= 128 {
        $trimmed := []string{}
        for i in 1:s.xacp_events.len { trimmed.push(s.xacp_events[i] + "") }
        s.xacp_events = trimmed
    }
    s.xacp_events.push(entry + "")
}

pub fn (s $&Screen) xacp_take_events(max_count int) []string {
    if s.xacp_events.len == 0 { << []string{} }
    $take := s.xacp_events.len
    if max_count > 0 && max_count < take { take = max_count }
    $out := []string{}
    for i in 0:take { out.push(s.xacp_events[i] + "") }
    $rest := []string{}
    for i in take:s.xacp_events.len { rest.push(s.xacp_events[i] + "") }
    s.xacp_events = rest
    << out
}

fn (s &Screen) xacp_focus_is_secure() bool {
    if s.focused <= 0 || s.focused > s.nodes.len { << false }
    n := s.nodes[s.focused - 1]
    if n.kind < 0 { << false }
    if n.secure || n.kind == SCREEN_SECRET_INPUT { << true }
    if n.kind == SCREEN_EDITOR {
        << s.is_password(n.id) >>> (err) { << true }
    }
    << false
}

fn (s $&Screen) record_xacp_input(input &ui.InputEvent,actions &[]Action) {
    $safe_key := input.key
    if s.xacp_focus_is_secure() { safe_key = 0 }
    entry := "kind=" + str(input.kind) + "\twindow=" + str(input.window_id) + "\tcanvas=" + str(input.canvas_id) +
        "\tgeneration=" + str(input.generation) + "\tx=" + str(int(input.x)) + "\ty=" + str(int(input.y)) +
        "\tbutton=" + str(input.button) + "\tkey=" + str(safe_key) + "\tactions=" + str(actions.len) +
        "\tfocused=" + str(s.focused)
    s.record_xacp_event(entry)
}

// xacp_tree is the only public node enumeration API. It lays out controls
// before copying data, caps the result, and returns no internal handles.
pub fn (s $&Screen) xacp_tree(include_hidden bool,max_rows int) []ScreenNodeInfo {
    s.check_screen() >>>
    if max_rows <= 0 || max_rows > XACP_MAX_NODES { >>> errors.new("widgets: invalid xacp tree limit") }
    s.layout_controls() >>>
    $out := []ScreenNodeInfo{}
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len { -> }
        n := s.nodes[nid - 1]
        if n.kind < 0 { -> }
        visible := s.is_visible(n.id) && !s.is_layout_hidden(n.id)
        if !include_hidden && !visible { -> }
        if out.len >= max_rows { >>> errors.new("widgets: xacp tree exceeds node limit") }
        $text := s.texts[n.id - 1] + ""
        if n.kind == SCREEN_EDITOR || n.kind == SCREEN_SECRET_INPUT { text = s.text_value(n.id) >>> }
        password := n.kind == SCREEN_EDITOR && (s.is_password(n.id) >>>)
        if password { text = "" }
        if text.len > XACP_MAX_NODE_TEXT { >>> errors.new("widgets: xacp node text exceeds memory limit") }
        out.push(ScreenNodeInfo{id: n.id,kind: n.kind,parent: n.parent,x: n.bounds.x,y: n.bounds.y,
            width: n.bounds.width,height: n.bounds.height,visible: visible,enabled: n.enabled,
            focusable: n.focusable,focused: s.focused == n.id,text: text,secure: n.secure || n.kind == SCREEN_SECRET_INPUT || password})
    }
    << out
}

// xacp_input validates canvas identity before dispatching every event. A
// foreign or stale generation is an error rather than a silently ignored UI
// operation, which prevents use-after-close and cross-window event injection.
pub fn (s $&Screen) xacp_input(events &[]ui.InputEvent,max_events int) []Action {
    s.check_screen() >>>
    if max_events <= 0 || max_events > XACP_MAX_NODES || events.len > max_events {
        >>> errors.new("widgets: xacp input exceeds event limit")
    }
    $out := []Action{}
    for input in events {
        if !belongs(&s.identity,&input) { >>> errors.new("widgets: xacp input has stale canvas identity") }
        if !ui.is_input_event(input.kind) { >>> errors.new("widgets: xacp input has invalid event kind") }
        if math.is_nan(input.x) || math.is_inf(input.x) || math.abs(input.x) > 1000000000.0 ||
           math.is_nan(input.y) || math.is_inf(input.y) || math.abs(input.y) > 1000000000.0 ||
           math.is_nan(input.dx) || math.is_inf(input.dx) || math.abs(input.dx) > 1000000000.0 ||
           math.is_nan(input.dy) || math.is_inf(input.dy) || math.abs(input.dy) > 1000000000.0 ||
           input.button < 0 || input.button > 3 || input.buttons < 0 || input.buttons > 7 || input.modifiers < 0 || input.modifiers > 15 ||
           input.key < 0 || input.key > 1114111 || input.scan < 0 || input.scan > 65535 || input.repeat < 0 || input.repeat > 1 ||
           input.click_count < 0 || input.time_ns < 0 {
            >>> errors.new("widgets: xacp input field out of range")
        }
        actions := s.dispatch(&input) >>>
        for action in actions { out.push(action) }
        if out.len > XACP_MAX_NODES { >>> errors.new("widgets: xacp action output exceeds memory limit") }
    }
    << out
}

// xacp_act provides the small, schema-approved action set. Click is routed
// through the normal pointer path, so hit testing, modal rules and focus
// transitions remain identical to native input.
pub fn (s $&Screen) xacp_act(id int,act string,text string,checked bool) []Action {
    s.check_screen() >>>
    n := s.node(id) >>>
    $out := []Action{}
    if act == "focus" {
        s.layout_controls() >>>
        s.focus(id) >>>
        s.record_xacp_event("act=focus\tnode=" + str(id) + "\tfocused=" + str(s.focused))
        << out
    }
    if act == "set_text" {
        if text.len > XACP_MAX_NODE_TEXT { >>> errors.new("widgets: xacp text exceeds memory limit") }
        s.set_text(id,text) >>>
        s.record_xacp_event("act=set_text\tnode=" + str(id) + "\tfocused=" + str(s.focused))
        << out
    }
    if act == "set_checked" {
        if n.kind == SCREEN_BUTTON {
            s.set_selected_button(id,checked) >>>
            s.record_xacp_event("act=set_checked\tnode=" + str(id) + "\tchecked=" + str(checked))
            << out
        }
        if n.kind == SCREEN_CHECKBOX || n.kind == SCREEN_SWITCH || n.kind == SCREEN_RADIO {
            s.set_toggle_value(id,checked) >>>
            s.record_xacp_event("act=set_checked\tnode=" + str(id) + "\tchecked=" + str(checked))
            << out
        }
        >>> errors.new("widgets: xacp checked target is not checkable")
    }
    if act == "click" {
        allow := n.kind == SCREEN_BUTTON || n.kind == SCREEN_CHECKBOX || n.kind == SCREEN_SWITCH ||
            n.kind == SCREEN_RADIO || n.kind == SCREEN_TASK || n.kind == SCREEN_CUSTOM ||
            n.kind == SCREEN_TABS || n.kind == SCREEN_SELECT || n.kind == SCREEN_MENU ||
            n.kind == SCREEN_BUTTON_GROUP
        if !allow { >>> errors.new("widgets: xacp click target is not a clickable control") }
        s.layout_controls() >>>
        b := s.bounds(id) >>>
        if b.width <= 0.0 || b.height <= 0.0 { >>> errors.new("widgets: xacp click target has empty bounds") }
        base := ui.InputEvent{kind: ui.EV_POINTER_DOWN,window_id: s.identity.window_id,canvas_id: s.identity.canvas_id,generation: s.identity.generation,
            x: b.x + b.width / 2.0,y: b.y + b.height / 2.0,dx: 0.0,dy: 0.0,button: ui.BUTTON_LEFT,buttons: 1,
            modifiers: 0,key: 0,scan: 0,repeat: 0,click_count: 1,time_ns: s.now.nanoseconds()}
        $down := base
        down.kind = ui.EV_POINTER_DOWN
        $up := base
        up.kind = ui.EV_POINTER_UP
        first := s.dispatch(&down) >>>
        second := s.dispatch(&up) >>>
        for action in first { out.push(action) }
        for action in second { out.push(action) }
        << out
    }
    >>> errors.new("widgets: xacp action is not enabled")
}
fn (s &Screen) global_bounds(id int) layout.Rect {
    n := s.node(id) >>>
    $b := n.local
    if s.composition.sticky_item_count > 0 {
        sh0 := s.sticky_scroll_shift(id)
        b.x += sh0.x
        b.y += sh0.y
    }
    if s.is_floating_node(id) { << b }
    $parent := n.parent
    $budget := s.nodes.len
    while parent > 0 && budget > 0 {
        p := s.node(parent) >>>
        b.x += p.local.x
        b.y += p.local.y
        if s.composition.sticky_item_count > 0 {
            sh := s.sticky_scroll_shift(parent)
            b.x += sh.x
            b.y += sh.y
        }
        if s.basics.scrolls.has(parent) { offset := s.basics.scrolls[parent].offset()
            if s.basics.scrolls[parent].axis() == AXIS_HORIZONTAL { b.x -= offset }
            else { b.y -= offset } }
        if s.is_floating_node(parent) { <- }
        if screen_is_overlay(p.kind) { b.x += p.bounds.x - p.local.x
            b.y += p.bounds.y - p.local.y
            <- }
        parent = p.parent
        budget -= 1
    }
    << b
}
fn (s $&Screen) layout_controls() int {
    if s.dirty && !s.composition.known_dirty {
        comp := $&s.composition
        comp.layout_dirty = true
        comp.known_dirty = true
    }
    if !s.composition.layout_dirty { << 0 }
    s.layout_controls_tree() >>>
    comp := $&s.composition
    comp.layout_dirty = false
    comp.known_dirty = s.dirty
    comp.layout_pass_count = comp.layout_pass_count + 1
    << 0
}
fn (s &Screen) cancellation() ui.InputEvent {
    << ui.InputEvent{kind: ui.EV_POINTER_CANCEL,window_id: s.identity.window_id,canvas_id: s.identity.canvas_id,generation: s.identity.generation,
        x: 0.0,y: 0.0,dx: 0.0,dy: 0.0,button: 0,buttons: 0,modifiers: 0,key: 0,scan: 0,repeat: 0,click_count: 0,time_ns: s.now.nanoseconds()}
}
fn (s $&Screen) route_node(id int,kind int,event &ui.InputEvent) Action {
    if kind == ROUTE_INPUT && s.composition.visual_transform_count > 0 && screen_is_pointer_coord_event(event.kind) {
        local_ev := s.event_in_node_space(id,event)
        << s.route_node_raw(id,kind,&local_ev) >>>
    }
    << s.route_node_raw(id,kind,event) >>>
}
fn (s $&Screen) route_node_raw(id int,kind int,event &ui.InputEvent) Action {
    n := s.node(id) >>>
    if n.kind == SCREEN_BUTTON {
        $control := s.take_button(id)
        result := screen_input_button($&control,kind,event)
        s.buttons[id] = control
        if result.error.len > 0 { >>> errors.new(result.error) }
        << result.action
    }
    if n.kind == SCREEN_SELECTABLE_TEXT || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(id)) {
        << s.selectable_text_input(id,kind,event)
    }
    if screen_is_control(n.kind) { << s.control_input(id,kind,event) >>> }
    if screen_is_overlay(n.kind) {
        if kind == ROUTE_FOCUS || kind == ROUTE_BLUR { s.overlay_focus(id,kind == ROUTE_FOCUS,s.now) >>>
            << no_action(id,true) }
        << s.overlay_input(id,event) >>>
    }
    << no_action(id,false)
}
fn (s $&Screen) pointer_cursor(cursor int) int {
    if cursor != s.pointer {
        if ui.host_tmp() == ":xu:" { s.window.content_command("cursor\t" + str(cursor)) >>> }
        s.pointer = cursor
    }
    << 0
}
pub fn (s &Screen) current_cursor() int { << s.pointer }
pub fn (s $&Screen) cancel_all() int {
    event := s.cancellation()
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len { -> }
        n := s.nodes[nid - 1]
        if n.kind > SCREEN_LABEL || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(n.id)) { _ := s.route_node(n.id,ROUTE_CANCEL,&event) >>> }
        if n.kind == SCREEN_MODAL { s.modal_blur_texts(n.id) }
    }
    s.reset_drag_silently()
    s.focused = 0
    s.captured = 0
    s.hovered = 0
    s.pointer_cursor(ui.CURSOR_DEFAULT) >>>
    s.mark_layout_dirty()
    << 0
}
fn (s $&Screen) focus_ready(id int,modal int) bool {
    if id <= 0 || id > s.nodes.len { << false }
    n := s.nodes[id - 1]
    if n.kind < 0 || !s.effective_enabled(id) || !n.focusable || !s.is_visible(id) || s.is_layout_hidden(id) || n.bounds.width <= 0.0 || n.bounds.height <= 0.0 { << false }
    scope := s.effective_focus_scope(modal)
    if scope > 0 && (id == scope || !s.is_descendant(id,scope)) { << false }
    if n.kind==SCREEN_SELECT && s.basics.selects[id].count()==0 { << false }
    if n.kind==SCREEN_WEBVIEW { web := s.web_state(id) >>>
        if !web.loaded || web.failed || web.suspended || web.closed { << false } }
    if screen_is_overlay(n.kind) { << n.kind == SCREEN_TOAST && s.overlay_is_open(id) }
    // Children of a hidden modal never take background focus.
    if s.composition.overlay_ids.len > 0 {
        $cur := n.parent
        $budget := s.nodes.len + 1
        while cur > 0 && cur <= s.nodes.len && budget > 0 {
            pn := s.nodes[cur - 1]
            if (pn.kind == SCREEN_MODAL || pn.kind == SCREEN_POPOVER) && !s.overlay_is_open(cur) { << false }
            cur = pn.parent
            budget -= 1
        }
    }
    << true
}
pub fn (s $&Screen) focus(id int) int {
    s.set_focus_mode(true) >>>
    << s.focus_input(id) >>>
}
fn (s $&Screen) step_focus(backward bool,modal int) bool {
    if s.focused > 0 && s.nodes[s.focused - 1].kind == SCREEN_RANGE_SLIDER {
        if s.range_tab(s.focused,backward,false) >>> {
            s.mark_paint_dirty()
            << true
        }
    }
    order := s.collect_focusable_order(modal) >>>
    if order.len > 0 {
        $position := -1
        for index in 0:order.len { if order[index] == s.focused { position = index } }
        if backward { position -= 1
            if position < 0 { position = order.len - 1 } }
        else { position += 1
            if position >= order.len { position = 0 } }
        s.focus_input(order[position]) >>>
        if s.nodes[order[position] - 1].kind == SCREEN_RANGE_SLIDER { _ := s.range_tab(order[position],backward,true) >>> }
    }
    << false
}
pub fn (s $&Screen) focus_next() int {
    s.check_screen() >>>
    s.set_focus_mode(true) >>>
    s.layout_controls() >>>
    _ := s.step_focus(false,s.modal_blocks()) >>>
    << s.focused
}
pub fn (s $&Screen) focus_prev() int {
    s.check_screen() >>>
    s.set_focus_mode(true) >>>
    s.layout_controls() >>>
    _ := s.step_focus(true,s.modal_blocks()) >>>
    << s.focused
}
fn (s $&Screen) set_focus_mode(keyboard bool) int {
    if s.keyboard_focus == keyboard { << 0 }
    s.keyboard_focus = keyboard
    << s.sync_tooltip_focus() >>>
}
fn (s $&Screen) sync_tooltip_focus() int {
    ocount := s.composition.overlay_ids.len
    for i in 0:ocount {
        oid := s.composition.overlay_ids[i]
        if oid > 0 && oid <= s.nodes.len && s.nodes[oid - 1].kind == SCREEN_TOOLTIP {
            s.overlay_focus(oid,s.keyboard_focus && s.focused == s.overlay_anchor(oid),s.now) >>>
        }
    }
    << 0
}
fn (s $&Screen) focus_input(id int) int {
    if id == s.focused { << 0 }
    modal := s.modal_blocks()
    if id != 0 && !s.focus_ready(id,modal) >>> { << 0 }
    ocount := s.composition.overlay_ids.len
    for i in 0:ocount {
        pid := s.composition.overlay_ids[i]
        if pid > 0 && pid <= s.nodes.len && s.nodes[pid - 1].kind == SCREEN_POPOVER && s.overlay_is_open(pid) && s.is_descendant(s.focused,pid) && !s.is_descendant(id,pid) {
            $control := s.screen_take_popover(pid) >>>
            control.close(s.now,s.reduced) >>> (err) { s.screen_put_popover(pid,control.clone_panel())
                >>> err }
            s.screen_put_popover(pid,control)
        }
    }
    if id > 0 { s.reveal_scroll_child(id) >>> }
    event := s.cancellation()
    previous := s.focused
    s.focused = id
    if id > 0 && s.composition.focus_zone_count > 0 { s.record_focus_zone_active(id) }
    if previous > 0 { _ := s.route_node(previous,ROUTE_BLUR,&event) >>> }
    if id > 0 { _ := s.route_node(id,ROUTE_FOCUS,&event) >>> }
    s.sync_tooltip_focus() >>>
    if modal > 0 && id > 0 { s.modal_blur_texts(modal)
        s.modal_sync_focus(modal,id) >>> }
    if previous > 0 && previous <= s.nodes.len && s.nodes[previous - 1].kind == SCREEN_SPLIT_VIEW {
        s.mark_layout_dirty()
    } else {
        s.mark_paint_dirty()
    }
    << 0
}
fn (s $&Screen) accept(action Action,actions $&[]Action) int {
    if action.needs_paint {
        if action.id > 0 && action.id <= s.nodes.len {
            ak := s.nodes[action.id - 1].kind
            if ak == SCREEN_SPLIT_VIEW || ak == SCREEN_CARD || ak == SCREEN_TABS || screen_is_overlay(ak) {
                if action.kind != ACTION_NONE { s.mark_layout_dirty() }
                else { s.mark_paint_dirty() }
            } else if ak == SCREEN_CUSTOM || screen_is_popup_capable_kind(ak) || (ak == SCREEN_LABEL && s.basics.selectable_texts.has(action.id)) {
                if action.consumed || action.kind != ACTION_NONE { s.mark_layout_dirty() }
                else { s.mark_paint_dirty() }
            } else {
                s.mark_paint_dirty()
            }
        } else {
            s.mark_paint_dirty()
        }
    }
    if action.request_focus { s.focus_input(action.id) >>> }
    if action.kind != ACTION_NONE { actions.push(action) }
    << 0
}
fn (s &Screen) in_modal(id int,modal int) bool {
    if modal > 0 { << id != modal && s.is_descendant(id,modal) }
    if s.composition.overlay_ids.len == 0 || id <= 0 || id > s.nodes.len { << true }
    $cur := id
    $budget := s.nodes.len + 1
    while cur > 0 && cur <= s.nodes.len && budget > 0 {
        n := s.nodes[cur - 1]
        if n.kind == SCREEN_MODAL { << false }
        if n.kind == SCREEN_POPOVER && !s.overlay_is_open(cur) { << false }
        cur = n.parent
        budget -= 1
    }
    << true
}
fn (s $&Screen) hit(x f64,y f64,modal int) int {
    surface := s.popover_at(x,y)
    if modal > 0 {
        << s.hit_subtree(modal,x,y,modal,surface) >>>
    }
    if surface > 0 {
        << s.hit_subtree(surface,x,y,0,surface) >>>
    }
    if s.composition.floating_count > 0 {
        fhit := s.hit_floating_nodes(x,y) >>>
        if fhit > 0 { << fhit }
    }
    root_count := s.child_count_of(0)
    if s.has_custom_stacking() {
        roots := s.z_ordered_children(0)
        $i := roots.len - 1
        while i >= 0 {
            rid := roots[i]
            if rid > 0 && rid <= s.nodes.len && s.nodes[rid - 1].kind >= 0 && s.nodes[rid - 1].parent == 0 && !screen_is_overlay(s.nodes[rid - 1].kind) {
                found := s.hit_subtree(rid,x,y,0,0) >>>
                if found > 0 { << found }
            }
            i -= 1
        }
        << 0
    }
    $i := root_count - 1
    while i >= 0 {
        rid := s.child_at_of(0,i)
        if rid > 0 && rid <= s.nodes.len && s.nodes[rid - 1].kind >= 0 && s.nodes[rid - 1].parent == 0 && !screen_is_overlay(s.nodes[rid - 1].kind) {
            found := s.hit_subtree(rid,x,y,0,0) >>>
            if found > 0 { << found }
        }
        i -= 1
    }
    << 0
}
fn (s $&Screen) clear_hovered_except(keep int,event &ui.InputEvent,actions $&[]Action) int {
    if s.hovered > 0 && s.hovered != keep {
        prev := s.hovered
        leave := ui.InputEvent{kind: ui.EV_POINTER_LEAVE,window_id: event.window_id,canvas_id: event.canvas_id,generation: event.generation,
            x: event.x,y: event.y,dx: 0.0,dy: 0.0,button: 0,buttons: event.buttons,modifiers: event.modifiers,
            key: 0,scan: 0,repeat: 0,click_count: 0,time_ns: event.time_ns}
        a := s.route_node(prev,ROUTE_INPUT,&leave) >>>
        s.accept(a,actions) >>>
        s.hovered = 0
    }
    << 0
}
fn (s $&Screen) dispatch_input(input &ui.InputEvent) []Action {
    $actions := []Action{}
    trace_pointer := env_get("XU_UI_TRACE_INPUT") == "1" && (input.kind == ui.EV_POINTER_DOWN || input.kind == ui.EV_POINTER_UP || input.kind == ui.EV_POINTER_CANCEL)
    if trace_pointer { eprintln("ui.pointer kind=" + str(input.kind) + " x=" + str(int(input.x)) + " y=" + str(int(input.y)) + " button=" + str(input.button) + " belongs=" + str(belongs(&s.identity,input))) }
    if !belongs(&s.identity,input) { << actions }
    keyboard := input.kind == ui.EV_KEY_DOWN || input.kind == ui.EV_KEY_UP
    s.set_focus_mode(keyboard) >>>
    s.layout_controls() >>>
    if input.kind == ui.EV_POINTER_CANCEL {
        // The draw surface resigns when a native child receives focus. Its
        // pointer cancellation must not undo that child's focus handoff.
        $native_focus := 0
        if s.focused > 0 && s.nodes[s.focused - 1].kind == SCREEN_WEBVIEW { native_focus = s.focused }
        s.cancel_all() >>>
        if native_focus > 0 { s.focus_input(native_focus) >>> }
        << actions }
    modal := s.modal_blocks()
    if modal > 0 {
        if s.modal_has_text_popup(modal) {
            ma := s.modal_handle_popup_input(modal,input)
            if ma.needs_paint { s.mark_paint_dirty() }
            if ma.consumed {
                if !keyboard && input.kind != ui.EV_POINTER_LEAVE { s.pointer_cursor(s.overlay_cursor(modal,input.x,input.y) >>>) >>> }
                << actions
            }
        }
        $modal_text_focused := false
        if s.is_selectable(modal) {
            st_t := s.modal_slot_state(modal)
            st_m := s.modal_slot_state(-modal)
            modal_text_focused = st_t.focused || st_m.focused
            if !keyboard && (input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_UP) && (st_t.selecting || st_m.selecting) {
                ma := s.modal_handle_pointer(modal,input) >>>
                if ma.needs_paint { s.mark_paint_dirty() }
                if input.kind != ui.EV_POINTER_LEAVE { s.pointer_cursor(s.overlay_cursor(modal,input.x,input.y) >>>) >>> }
                if ma.consumed { << actions }
            }
            if keyboard && modal_text_focused && input.key != ui.KEY_ESCAPE && input.key != ui.KEY_TAB {
                ma := s.modal_handle_key(modal,input) >>>
                if ma.needs_paint { s.mark_paint_dirty() }
                if ma.consumed { << actions }
            }
        }
        was_vis := s.overlay_is_visible(modal)
        was_open := s.overlay_is_open(modal)
        a := s.overlay_modal_input(modal,input) >>>
        if was_vis != s.overlay_is_visible(modal) || was_open != s.overlay_is_open(modal) || a.kind != ACTION_NONE {
            s.mark_layout_dirty()
        } else if a.needs_paint {
            s.mark_paint_dirty()
        }
        if a.consumed {
            if !(keyboard && modal_text_focused && input.key != ui.KEY_ESCAPE && input.key != ui.KEY_TAB) {
                s.modal_blur_texts(modal)
            }
            s.focus_input(s.modal_focused(modal)) >>>
            if !keyboard && input.kind != ui.EV_POINTER_LEAVE { s.pointer_cursor(s.overlay_cursor(modal,input.x,input.y) >>>) >>> }
            << actions
        }
    }
    // Hover observers see the move even when a surface above consumes it.
    if s.composition.overlay_ids.len > 0 {
        ocount := s.composition.overlay_ids.len
        for i in 0:ocount {
            oid := s.composition.overlay_ids[i]
            if oid > 0 && oid <= s.nodes.len && s.nodes[oid - 1].kind == SCREEN_TOOLTIP && s.is_visible(oid) {
                was_vis := s.overlay_is_visible(oid)
                was_open := s.overlay_is_open(oid)
                a := s.overlay_input(oid,input) >>>
                if was_vis != s.overlay_is_visible(oid) || was_open != s.overlay_is_open(oid) { s.mark_layout_dirty() }
                s.accept(a,$&actions) >>>
                if a.consumed {
                    if !keyboard && input.kind != ui.EV_POINTER_LEAVE {
                        s.clear_hovered_except(oid,input,$&actions) >>>
                        s.pointer_cursor(s.overlay_cursor(oid,input.x,input.y) >>>) >>>
                    }
                    << actions
                }
            }
        }
        if modal == 0 {
            $oi := s.composition.overlay_ids.len - 1
            while oi >= 0 {
                oid := s.composition.overlay_ids[oi]
                if oid > 0 && oid <= s.nodes.len {
                    okind := s.nodes[oid - 1].kind
                    if (okind == SCREEN_TOAST || okind == SCREEN_POPOVER) && s.is_visible(oid) && s.overlay_is_visible(oid) {
                        was_vis := s.overlay_is_visible(oid)
                        was_open := s.overlay_is_open(oid)
                        a := s.overlay_input(oid,input) >>>
                        if was_vis != s.overlay_is_visible(oid) || was_open != s.overlay_is_open(oid) { s.mark_layout_dirty() }
                        s.accept(a,$&actions) >>>
                        if a.consumed {
                            if !keyboard && input.kind != ui.EV_POINTER_LEAVE {
                                s.clear_hovered_except(oid,input,$&actions) >>>
                                s.pointer_cursor(s.overlay_cursor(oid,input.x,input.y) >>>) >>>
                            }
                            << actions
                        }
                    }
                }
                oi -= 1
            }
        }
    }
    // Popup rectangles are tested before ordinary fields, in reverse paint order.
    if !keyboard && s.composition.popup_capable_ids.len > 0 {
        $pi := s.composition.popup_capable_ids.len - 1
        while pi >= 0 {
            pid := s.composition.popup_capable_ids[pi]
            if pid > 0 && pid <= s.nodes.len {
                n := s.nodes[pid - 1]
                if n.kind >= 0 && (screen_is_popup_capable_kind(n.kind) || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(pid))) && s.is_visible(pid) && s.in_modal(pid,modal) {
                    popup := s.control_popup(pid) >>>
                    pt := s.screen_to_node_point(pid,input.x,input.y)
                    if popup.width > 0.0 && popup.contains(pt.x,pt.y) {
                        a := s.route_node(pid,ROUTE_INPUT,input) >>>
                        s.accept(a,$&actions) >>>
                        if a.consumed {
                            if input.kind != ui.EV_POINTER_LEAVE {
                                s.clear_hovered_except(pid,input,$&actions) >>>
                            }
                            if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT { s.captured = pid }
                            if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT { s.captured = 0 }
                            $cur := ui.CURSOR_DEFAULT
                            if input.kind != ui.EV_POINTER_LEAVE {
                                after_pop := s.control_popup(pid) >>>
                                apt := s.screen_to_node_point(pid,input.x,input.y)
                                if after_pop.width > 0.0 && after_pop.contains(apt.x,apt.y) {
                                    cur = s.control_cursor(pid,apt.x,apt.y) >>>
                                } else {
                                    after_t := s.hit(input.x,input.y,modal) >>>
                                    if after_t > 0 {
                                        tn := s.node(after_t) >>>
                                        cur = tn.cursor
                                        if tn.kind == SCREEN_BUTTON || screen_is_control(tn.kind) || (tn.kind == SCREEN_LABEL && s.basics.selectable_texts.has(after_t)) {
                                            tpt := s.screen_to_node_point(after_t,input.x,input.y)
                                            cur = s.control_cursor(after_t,tpt.x,tpt.y) >>>
                                        }
                                    }
                                }
                            }
                            s.pointer_cursor(cur) >>>
                            << actions
                        }
                    }
                }
            }
            pi -= 1
        }
    }
    if input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_TAB {
        backward := (input.modifiers & ui.MOD_SHIFT) != 0
        _ := s.step_focus(backward,modal) >>>
        << actions
    }
    if input.kind == ui.EV_KEY_DOWN || input.kind == ui.EV_KEY_UP {
        if input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE && s.composition.drag_state.active {
            if s.dnd_handle_escape($&actions) { << actions }
        }
        if s.focused > 0 && s.focus_ready(s.focused,modal) >>> {
            if s.composition.input_hook_count > 0 && s.run_input_capture_chain(s.focused,input,$&actions) { << actions }
            a := s.route_node(s.focused,ROUTE_INPUT,input) >>>
            s.accept(a,$&actions) >>>
            if a.consumed { << actions }
            if s.composition.input_hook_count > 0 && s.run_input_bubble_chain(s.focused,input,$&actions) { << actions }
            if input.kind == ui.EV_KEY_DOWN && s.composition.focus_zone_count > 0 && s.focused > 0 {
                if s.handle_focus_zone_key(input.key,modal) >>> { << actions }
            }
        }
        if modal > 0 && s.is_selectable(modal) {
            ma := s.modal_handle_key(modal,input) >>>
            if ma.consumed { << actions }
        }
        shortcut := s.menu_shortcut(input,modal) >>>
        s.accept(shortcut,$&actions) >>>
        if shortcut.consumed { << actions }
        sc := s.match_shortcut(input,modal)
        if sc.consumed {
            actions.push(sc)
            << actions
        }
        if modal == 0 && input.kind == ui.EV_KEY_DOWN { actions.push(Action{kind: ACTION_KEY,id: 0,
            needs_paint: false,request_focus: false,consumed: false,value: f64(input.key)}) }
        << actions
    }
    $target := s.hit(input.x,input.y,modal) >>>
    if trace_pointer { eprintln("ui.pointer target=" + str(target) + " modal=" + str(modal)) }
    if input.kind == ui.EV_POINTER_LEAVE { target = 0 }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && modal == 0 && s.composition.floating_count > 0 {
        s.dismiss_outside_floatings(target,input.x,input.y,$&actions) >>>
        target = s.hit(input.x,input.y,modal) >>>
    }
    if s.composition.drag_source_count > 0 || s.composition.drag_state.active || s.composition.drag_pending_source > 0 {
        if s.dnd_handle_pointer(input,target,modal,$&actions) { << actions }
    }
    if s.hovered != target {
        old_hov := s.hovered
        if old_hov > 0 { $leave := choice_copy_input(input)
            leave.kind = ui.EV_POINTER_LEAVE
            departed := s.route_node(old_hov,ROUTE_INPUT,&leave) >>>
            s.accept(departed,$&actions) >>> }
        s.hovered = target
        if s.has_styled_group_ancestor(old_hov) || s.has_styled_group_ancestor(target) {
            s.mark_paint_dirty()
        }
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        // An outside click closes editors and candidate lists through blur.
        if target > 0 || s.popover_at(input.x,input.y) == 0 { s.focus_input(target) >>> }
        if target > 0 && modal > 0 { s.modal_blur_texts(modal) }
        old_cap := s.captured
        s.captured = target
        if old_cap != target && (s.has_styled_group_ancestor(old_cap) || s.has_styled_group_ancestor(target)) {
            s.mark_paint_dirty()
        }
    }
    $owner := target
    if s.captured > 0 && input.kind != ui.EV_POINTER_SCROLL { owner = s.captured }
    if owner > 0 {
        $hook_consumed := false
        if s.composition.input_hook_count > 0 {
            hook_consumed = s.run_input_capture_chain(owner,input,$&actions)
        }
        if !hook_consumed {
            a := s.route_node(owner,ROUTE_INPUT,input) >>>
            if trace_pointer { eprintln("ui.pointer action=" + str(a.kind) + " id=" + str(a.id) + " consumed=" + str(a.consumed)) }
            s.accept(a,$&actions) >>>
            if a.consumed { hook_consumed = true }
            if !hook_consumed && s.composition.input_hook_count > 0 {
                hook_consumed = s.run_input_bubble_chain(owner,input,$&actions)
            }
        }
        if !hook_consumed && input.kind == ui.EV_POINTER_SCROLL { s.bubble_scroll(owner,input,$&actions) >>> }
    } else if modal > 0 && s.is_selectable(modal) {
        if input.kind != ui.EV_POINTER_LEAVE {
            _ := s.modal_handle_pointer(modal,input) >>>
        }
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if s.captured > 0 {
            old_cap := s.captured
            s.captured = 0
            if s.has_styled_group_ancestor(old_cap) { s.mark_paint_dirty() }
        }
    }
    $cursor := ui.CURSOR_DEFAULT
    if input.kind != ui.EV_POINTER_LEAVE {
        $cursor_owner := target
        if s.captured > 0 && input.kind != ui.EV_POINTER_SCROLL { cursor_owner = s.captured }
        if cursor_owner > 0 {
            n := s.node(cursor_owner) >>>
            cursor = n.cursor
            if n.kind == SCREEN_BUTTON || screen_is_control(n.kind) || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(cursor_owner)) {
                cpt := s.screen_to_node_point(cursor_owner,input.x,input.y)
                cursor = s.control_cursor(cursor_owner,cpt.x,cpt.y) >>>
            }
        } else if modal > 0 && s.is_selectable(modal) {
            cursor = s.overlay_cursor(modal,input.x,input.y) >>>
        }
    }
    s.pointer_cursor(cursor) >>>
    << actions
}
fn (s $&Screen) paint_caption(id int,secondary bool,frame $&draw.Frame,bounds &layout.Rect,style &ControlStyle,opacity f64) int {
    styles := s.styles_for(id)
    << s.paint_caption_styled(id,secondary,frame,bounds,style,&styles,opacity) >>>
}
fn (s $&Screen) paint_caption_styled(id int,secondary bool,frame $&draw.Frame,bounds &layout.Rect,style &ControlStyle,styles &Styles,opacity f64) int {
    key := id * 2
    $slot := key
    $value := s.texts[id - 1] + ""
    if secondary { slot += 1
        value = s.descriptions[id - 1] + "" }
    faded := style.with_opacity(opacity) >>>
    if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
    $cache := s.take_label_cache(slot)
    wrap := screen_is_overlay(s.nodes[id - 1].kind) || s.basics.wrapped_labels.has(id)
    err_msg := screen_paint_caption_text($&cache,&value,frame,bounds,styles,&faded,wrap)
    s.labels[slot] = cache
    if err_msg != "" { >>> errors.new(err_msg) }
    << 0
}
fn screen_paint_caption_text(cache $&TextCache,value &string,frame $&draw.Frame,bounds &layout.Rect,styles &Styles,faded &ControlStyle,wrap bool) string {
    if wrap { cache.paint_wrapped(0,value,frame,bounds,styles,faded,0) >>> (err) { << err.msg() }
        << "" }
    cache.paint_text(0,value,frame,bounds,styles,faded,0) >>> (err) { << err.msg() }
    << ""
}
fn (s $&Screen) paint_text(id int,frame $&draw.Frame,bounds &layout.Rect,style &ControlStyle,opacity f64) int {
    << s.paint_caption(id,false,frame,bounds,style,opacity) >>>
}
fn (s $&Screen) paint_text_styled(id int,frame $&draw.Frame,bounds &layout.Rect,style &ControlStyle,styles &Styles,opacity f64) int {
    << s.paint_caption_styled(id,false,frame,bounds,style,styles,opacity) >>>
}
fn (s $&Screen) paint_node(id int,frame $&draw.Frame,opacity f64) int {
    styles := s.styles_for(id)
    << s.paint_node_styled(id,frame,opacity,&styles) >>>
}
fn (s $&Screen) paint_node_styled(id int,frame $&draw.Frame,opacity f64,styles &Styles) int {
    clip := s.child_clip(id) >>>
    if clip.width <= 0.0 || clip.height <= 0.0 { << 0 }
    frame.push() >>>
    frame.clip_rect(clip.x,clip.y,clip.width,clip.height) >>>
    message := screen_paint_clipped_styled(s,id,frame,opacity,styles)
    frame.pop() >>>
    if message.len > 0 { >>> errors.new(message) }
    << 0
}
fn screen_paint_clipped_styled(s $&Screen,id int,frame $&draw.Frame,opacity f64,styles &Styles) string {
    s.paint_node_content_styled(id,frame,opacity,styles) >>> (err) { << err.msg() }
    << ""
}
fn (s $&Screen) paint_node_content_styled(id int,frame $&draw.Frame,opacity f64,styles &Styles) int {
    n := s.node(id) >>>
    if n.kind == SCREEN_GROUP {
        if !s.node_has_control_patch(id) { << 0 }
        patch := s.effective_control_patch(id)
        if patch.fields == 0 { << 0 }
        $base := styles.input.clone()
        base.palette.normal = draw.rgba(0,0,0,0)
        base.palette.hovered = draw.rgba(0,0,0,0)
        base.palette.pressed = draw.rgba(0,0,0,0)
        base.palette.disabled = draw.rgba(0,0,0,0)
        base.palette.border = styles.button.palette.border
        base.border_width = 0.0
        base.radius = 0.0
        base.focus_width = 0.0
        base.shadow = draw.rgba(0,0,0,0)
        base.shadow_x = 0.0
        base.shadow_y = 0.0
        base.shadow_spread = 0.0
        base.shadow_blur = 0.0
        base.states = []StatePaint{}
        $styled := base.apply_patch(&patch)
        if (patch.fields & STYLE_PATCH_HOVERED) == 0 { styled.palette.hovered = styled.palette.normal }
        if (patch.fields & STYLE_PATCH_PRESSED) == 0 { styled.palette.pressed = styled.palette.hovered }
        if (patch.fields & STYLE_PATCH_DISABLED) == 0 { styled.palette.disabled = styled.palette.normal }
        if (patch.fields & STYLE_PATCH_BORDER) != 0 && (patch.fields & STYLE_PATCH_BORDER_WIDTH) == 0 {
            styled.border_width = 1.0
        }
        g_state := s.group_effective_state(id)
        if opacity < 1.0 { styled = styled.with_opacity(opacity) >>> }
        << style_box(frame,&n.bounds,&styled,styles.density,g_state) >>>
    }
    if n.kind == SCREEN_CUSTOM {
        << s.custom_paint(id,frame,styles,opacity,false) >>>
    }
    if n.kind == SCREEN_LABEL {
        if s.basics.selectable_texts.has(id) {
            s.selectable_text_sync_node(id) >>>
            s.selectable_text_paint(id,frame,styles,opacity,false) >>>
        } else {
            style := s.label_control_style(id,styles,1.0) >>>
            if s.basics.ellipsis_labels.has(id) { faded := style.with_opacity(opacity) >>>
                s.paint_label_ellipsis(id,frame,&n.bounds,styles,&faded) >>> }
            else { s.paint_text_styled(id,frame,&n.bounds,&style,styles,opacity) >>> }
        }
    } else if n.kind == SCREEN_SELECTABLE_TEXT {
        s.selectable_text_paint(id,frame,styles,opacity,false) >>>
    } else if n.kind == SCREEN_BUTTON {
        control := s.take_button(id)
        $transition := s.take_button_transition(id)
        slot := id * 2
        if !s.labels.has(slot) { s.labels[slot] = text_cache(&s.context) }
        $cache := s.take_label_cache(slot)
        value := s.texts[id - 1] + ""
        base := s.screen_button_style(id,&control,styles) >>>
        $message := ""
        now := s.now
        reduced := s.reduced
        labeled_icon := s.basics.button_icon_labels.has(id)
        if s.basics.button_icons.has(id) { owner := $&s.basics
            icons := $&owner.button_icons
            image := icons.take(id)
            if labeled_icon { message = screen_paint_labeled_icon_button(&control,$&transition,$&cache,&image,frame,&n.bounds,styles,&base,&value,opacity,now,reduced) }
            else { message = screen_paint_icon_button(&control,$&transition,&image,frame,&n.bounds,styles,&base,opacity,now,reduced) }
            icons[id] = image }
        else { message = screen_paint_button(&control,$&transition,$&cache,frame,&n.bounds,styles,&base,&value,opacity,now,reduced) }
        s.buttons[id] = control
        s.button_transitions[id] = transition
        s.labels[slot] = cache
        if message.len > 0 { >>> errors.new(message) }
    } else if screen_is_control(n.kind) {
        $eff_styles := s.resolve_styles_with_patch(id,styles)
        if opacity < 1.0 { eff_styles = eff_styles.with_opacity(opacity) >>> }
        s.control_paint(id,frame,&eff_styles,false) >>>
    }
    << 0
}
fn (s $&Screen) record(frame $&draw.Frame) int {
    region := screen_empty()
    << s.record_region(frame,&region,false) >>>
}
fn (s $&Screen) record_region(frame $&draw.Frame,region &layout.Rect,cropped bool) int {
    s.layout_controls() >>> (err) { >>> errors.new("widgets: screen layout: " + err.msg()) }
    s.sync_webviews() >>>
    styles := s.styles.clone()
    frame.begin() >>>
    frame.set_bg(styles.background) >>>
    if cropped {
        frame.push() >>>
        frame.clip_rect(0.0,0.0,region.width,region.height) >>>
        frame.translate(0.0 - region.x,0.0 - region.y) >>>
    }
    root_count := s.child_count_of(0)
    if s.has_custom_stacking() {
        roots := s.z_ordered_children(0)
        for i in 0:roots.len {
            rid := roots[i]
            if rid > 0 && rid <= s.nodes.len && s.nodes[rid - 1].parent == 0 {
                s.paint_subtree(rid,frame,1.0,0,&styles) >>>
            }
        }
        for i in 0:roots.len {
            rid := roots[i]
            if rid > 0 && rid <= s.nodes.len && s.nodes[rid - 1].parent == 0 {
                s.paint_subtree_popups(rid,frame,&styles,0) >>>
            }
        }
    } else {
        for i in 0:root_count {
            rid := s.child_at_of(0,i)
            if rid > 0 && rid <= s.nodes.len && s.nodes[rid - 1].parent == 0 {
                s.paint_subtree(rid,frame,1.0,0,&styles) >>>
            }
        }
        for i in 0:root_count {
            rid := s.child_at_of(0,i)
            if rid > 0 && rid <= s.nodes.len && s.nodes[rid - 1].parent == 0 {
                s.paint_subtree_popups(rid,frame,&styles,0) >>>
            }
        }
    }
    // Anchored floating portals paint above normal subtrees and below overlays.
    if s.composition.floating_count > 0 {
        s.paint_floating_nodes(frame,&styles) >>>
    }
    // Layer order is shared with input routing. Modal children draw last.
    if s.composition.overlay_ids.len > 0 {
        ocount := s.composition.overlay_ids.len
        for kind in [SCREEN_POPOVER,SCREEN_TOOLTIP,SCREEN_TOAST,SCREEN_MODAL] {
            for i in 0:ocount {
                oid := s.composition.overlay_ids[i]
                if oid > 0 && oid <= s.nodes.len && s.nodes[oid - 1].kind == kind && s.is_visible(oid) {
                    $ov_styles := styles.clone()
                    if s.has_any_style_overrides() { ov_styles = s.styles_for(oid) }
                    if kind == SCREEN_POPOVER && s.popover_has_content(oid) { s.record_popover(oid,frame,&ov_styles) >>> }
                    else { s.overlay_paint(oid,frame,&ov_styles) >>> }
                    if kind == SCREEN_MODAL && s.overlay_is_visible(oid) {
                        opacity := s.overlay_opacity(oid)
                        bounds := s.bounds(oid) >>>
                        scaled := !s.reduced && opacity > 0.0 && opacity < 1.0
                        if scaled {
                            scale := 0.96 + 0.04 * opacity
                            cx := bounds.x + bounds.width * 0.5
                            cy := bounds.y + bounds.height * 0.5
                            frame.push() >>>
                            frame.translate(cx,cy) >>>
                            frame.scale(scale,scale) >>>
                            frame.translate(0.0 - cx,0.0 - cy) >>>
                        }
                        s.modal_paint_text(oid,frame,&ov_styles,opacity) >>>
                        frame.push() >>>
                        frame.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) >>>
                        s.paint_overlay_children(oid,frame,&ov_styles,opacity) >>>
                        frame.pop() >>>
                        s.paint_overlay_child_popups(oid,frame,&ov_styles) >>>
                        if scaled { frame.pop() >>> }
                    }
                }
            }
        }
        for kind in [SCREEN_POPOVER,SCREEN_TOOLTIP,SCREEN_TOAST,SCREEN_MODAL] {
            for i in 0:ocount {
                oid := s.composition.overlay_ids[i]
                if oid > 0 && oid <= s.nodes.len && s.nodes[oid - 1].kind == kind && s.is_visible(oid) {
                    $ov_styles := styles.clone()
                    if s.has_any_style_overrides() { ov_styles = s.styles_for(oid) }
                    s.overlay_paint_popup(oid,frame,&ov_styles) >>>
                }
            }
        }
    }
    if cropped { frame.pop() >>> }
    << 0
}
fn (s $&Screen) acknowledge() int {
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len { -> }
        n := s.nodes[nid - 1]
        if n.kind < 0 { -> }
        if n.kind == SCREEN_BUTTON { $b := s.take_button(n.id)
            b.painted()
            s.buttons[n.id] = b }
        else if n.kind == SCREEN_CUSTOM { s.custom_painted(n.id) }
        else if n.kind == SCREEN_SELECTABLE_TEXT || (n.kind == SCREEN_LABEL && s.basics.selectable_texts.has(n.id)) { s.selectable_text_painted(n.id) }
        else if screen_is_control(n.kind) { s.control_painted(n.id) >>> }
        else if screen_is_overlay(n.kind) { s.overlay_painted(n.id) >>>
            if n.kind == SCREEN_MODAL { s.modal_painted_texts(n.id) } }
    }
    << 0
}
fn (s $&Screen) draw_and_present(frame $&draw.Frame) int {
    s.record(frame) >>>
    frame.present_wait() >>> (err) { >>> errors.new("widgets: frame submit: " + err.msg()) }
    << 0
}
pub fn (s $&Screen) render() bool {
    if !s.is_open() || !s.dirty { << false }
    $frame := s.take_frame()
    err := s.draw_and_present($&frame)
    s.frames[1] = frame
    if err != 0 { << false }
    s.acknowledge() >>>
    s.dirty = false
    comp := $&s.composition
    comp.known_dirty = false
    << true
}
struct ScreenXdfResult {
    payload string
    err_msg string
}

fn (s $&Screen) draw_and_export_xdf(frame $&draw.Frame) ScreenXdfResult {
    s.record(frame) >>> (err) { << ScreenXdfResult{payload: "",err_msg: err.msg()} }
    payload := frame.export_xdf() >>> (err) { << ScreenXdfResult{payload: "",err_msg: "widgets: frame export: " + err.msg()} }
    << ScreenXdfResult{payload: payload,err_msg: ""}
}

pub fn (s $&Screen) export_xdf() string {
    s.check_screen() >>>
    $frame := s.take_frame()
    res := s.draw_and_export_xdf($&frame)
    s.frames[1] = frame
    if res.err_msg.len > 0 { >>> errors.new(res.err_msg) }
    s.acknowledge() >>>
    s.dirty = false
    comp := $&s.composition
    comp.known_dirty = false
    << res.payload
}
// Export/preview still uses the same placement and layer ordering as render.
pub fn (s $&Screen) snapshot(scale f64) draw.Surface {
    s.check_screen() >>>
    for i in 0:s.composition.webview_ids.len {
        wid := s.composition.webview_ids[i]
        if wid > 0 && wid <= s.nodes.len && s.nodes[wid - 1].kind == SCREEN_WEBVIEW && s.is_visible(wid) { >>> errors.new("widgets: canvas snapshots cannot include a native WebView surface") }
    }
    $frame := s.context.new_frame(32768)
    s.record($&frame) >>> (err) { frame.dispose()
        >>> err }
    surface := frame.snapshot(s.width,s.height,scale) >>> (err) { frame.dispose()
        >>> err }
    frame.dispose()
    << surface
}

// snapshot_node uses the same paint order as the full snapshot while clipping
// and translating the requested node rectangle. The returned Surface remains
// an owning native resource and must be disposed by the caller.
pub fn (s $&Screen) snapshot_node(id int,scale f64) draw.Surface {
    s.check_screen() >>>
    for i in 0:s.composition.webview_ids.len {
        wid := s.composition.webview_ids[i]
        if wid > 0 && wid <= s.nodes.len && s.nodes[wid - 1].kind == SCREEN_WEBVIEW && s.is_visible(wid) { >>> errors.new("widgets: canvas snapshots cannot include a native WebView surface") }
    }
    s.layout_controls() >>>
    _ := s.node(id) >>>
    region := s.bounds(id) >>>
    if region.width <= 0.0 || region.height <= 0.0 { >>> errors.new("widgets: empty snapshot node bounds") }
    $frame := s.context.new_frame(32768)
    s.record_region($&frame,&region,true) >>> (err) { frame.dispose()
        >>> err }
    surface := frame.snapshot(region.width,region.height,scale) >>> (err) { frame.dispose()
        >>> err }
    frame.dispose()
    << surface
}
pub fn (s $&Screen) advance(now time.Instant) time.Instant {
    // Retarget immediately after input, otherwise wait for the previously
    // scheduled boundary. Continuous tweens must not turn next() into a spin.
    if !s.dirty && !s.animation_deadline.is_zero() && now.before(s.animation_deadline) { << s.animation_deadline }
    s.now = now
    s.layout_controls() >>>
    $deadline := s.advance_buttons(now) >>>
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len { -> }
        n := s.nodes[nid - 1]
        if n.kind < SCREEN_CHECKBOX || n.kind == SCREEN_SELECTABLE_TEXT || !s.is_visible(n.id) { -> }
        $step := ScreenAnimation{changed: false,deadline: time.zero_instant()}
        if !screen_is_overlay(n.kind) {
            step = s.control_tick(n.id,now,s.reduced) >>>
            if step.changed {
                if screen_is_popup_capable_kind(n.kind) || n.kind == SCREEN_CUSTOM { s.mark_layout_dirty() }
                else { s.mark_paint_dirty() }
            }
        } else {
            was_vis := s.overlay_is_visible(n.id)
            step = s.overlay_tick(n.id,now,s.reduced) >>>
            if step.changed {
                if was_vis != s.overlay_is_visible(n.id) || n.kind == SCREEN_TOOLTIP || n.kind == SCREEN_TOAST { s.mark_layout_dirty() }
                else { s.mark_paint_dirty() }
            }
        }
        deadline = screen_earlier(deadline,step.deadline)
        if n.kind == SCREEN_MODAL { restore := s.modal_restore(n.id) >>>
            if restore > 0 { s.focus_input(restore) >>> } }
        if n.kind == SCREEN_TOAST && s.focused == n.id && !s.overlay_is_open(n.id) { s.focus_input(0) >>> }
    }
    s.pump_notices() >>>
    anim_deadline := s.advance_animations(now) >>>
    deadline = screen_earlier(deadline,anim_deadline)
    spring_deadline := s.advance_springs(now) >>>
    deadline = screen_earlier(deadline,spring_deadline)
    node_tr_deadline := s.advance_node_transitions(now) >>>
    deadline = screen_earlier(deadline,node_tr_deadline)
    scroll_tr_deadline := s.advance_scroll_animations(now) >>>
    deadline = screen_earlier(deadline,scroll_tr_deadline)
    s.animation_deadline = deadline
    << deadline
}
pub fn (s $&Screen) dispatch(input &ui.InputEvent) []Action {
    if input.time_ns > 0 { s.now = time.instant_from_ns(input.time_ns) >>> }
    actions := s.dispatch_input(input) >>>
    s.record_xacp_input(input,&actions)
    << actions
}
pub fn (s $&Screen) handle_input(input &ui.InputEvent) []Action {
    s.check_screen() >>>
    s.now = time.instant()
    actions := s.dispatch_input(input) >>>
    s.record_xacp_input(input,&actions)
    << actions
}
pub fn (s $&Screen) event(event &ui.Event) []Action {
    $actions := []Action{}
    if !s.is_open() { << actions }
    s.now = time.instant()
    if event.kind == ui.EV_EXIT { s.closed = true
        s.notify_xacp_closed()
        << actions }
    if event.window_id != s.identity.window_id { << actions }
    if event.kind == ui.EV_NATIVE_VIEW { << s.web_event(event) >>> }
    if event.kind == ui.EV_CLOSED { s.closed = true
        s.notify_xacp_closed()
        << actions }
    if event.kind == ui.EV_CANVAS_CLOSED { identity := ui.canvas_of(event) >>>
        if identity.canvas_id == s.identity.canvas_id && identity.generation == s.identity.generation { s.closed = true
            s.notify_xacp_closed() }
        << actions }
    if event.kind == ui.EV_CANVAS_METRICS { metrics := ui.metrics_of(event) >>>
        if metrics.canvas_id == s.identity.canvas_id && metrics.generation == s.identity.generation && metrics.width > 0.0 && metrics.height > 0.0 { s.resize(metrics.width,metrics.height) >>> }
        << actions }
    if event.kind == ui.EV_CANVAS_PREFERENCES { prefs := ui.canvas_preferences_of(event) >>>
        if prefs.identity.canvas_id == s.identity.canvas_id && prefs.identity.generation == s.identity.generation { s.set_reduced_motion(prefs.reduced_motion) }
        << actions }
    if event.kind == ui.EV_BLURRED { s.cancel_all() >>>
        << actions }
    if event.kind == ui.EV_FOCUSED { if ui.host_tmp() == ":xu:" { ui.request_canvas_preferences(&s.identity) >>> }
        modal := s.modal_blocks()
        if modal > 0 { s.focus_input(s.modal_focused(modal)) >>> }
        << actions }
    if ui.is_input_event(event.kind) { input := ui.input_of(event) >>>
        actions := s.dispatch_input(&input) >>>
        s.record_xacp_input(&input,&actions)
        << actions }
    tcount := s.composition.text_input_ids.len
    for i in 0:tcount {
        tid := s.composition.text_input_ids[i]
        if tid <= 0 || tid > s.nodes.len { -> }
        nk := s.nodes[tid - 1].kind
        if nk == SCREEN_EDITOR || nk == SCREEN_SECRET_INPUT || nk == SCREEN_COMBO || nk == SCREEN_FIELD {
            a := s.control_event(tid,event) >>>
            s.accept(a,$&actions) >>>
        }
    }
    << actions
}
fn screen_wait(events chan ui.Event,deadline time.Instant) ui.Event {
    if deadline.is_zero() { << <-events }
    delay := deadline.since(time.instant())
    if delay.nanoseconds() <= 0 { << ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0} }
    timer := delay.timer()
    select {
        event := <-events { timer.stop()
            << event }
        _ := <-timer.c { timer.stop()
            << ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0} }
    }
    << ui.Event{kind: ui.EV_NONE,window_id: 0,menu_id: "",width: 0,height: 0}
}
// Block when idle; coalesce non-semantic input bursts before one repaint.
pub fn (s $&Screen) next(events chan ui.Event) []Action {
    if !s.is_open() { << []Action{} }
    deadline := s.advance(time.instant()) >>>
    if s.queued_actions.len > 0 { << s.take_actions() }
    if s.dirty { << []Action{} }
    event := screen_wait(events,deadline) >>>
    $actions := s.event(&event) >>>
    _ := s.advance(time.instant()) >>>
    timed := s.take_actions()
    for action in timed { actions.push(action) }
    $count := 0
    while s.is_open() && count < 128 {
        pending := ui.poll_chan(events)
        if pending.kind == ui.EV_NONE { <- }
        more := s.event(&pending) >>>
        for action in more { actions.push(action) }
        count += 1
    }
    << actions
}
pub fn (s $&Screen) close() int {
    if s.is_open() { s.window.command("close") >>>
        s.closed = true
        s.notify_xacp_closed() }
    << 0
}
fn (s $&Screen) try_cancel_all() {
    s.cancel_all() >>> (err) { s.focused = 0
        << }
}
pub fn (s $&Screen) dispose() {
    if s.disposed { << }
    s.try_cancel_all()
    lcount := s.composition.live_ids.len
    for i in 0:lcount {
        nid := s.composition.live_ids[i]
        if nid <= 0 || nid > s.nodes.len { -> }
        n := s.nodes[nid - 1]
        if n.kind < 0 { -> }
        if screen_is_control(n.kind) && n.kind != SCREEN_SELECTABLE_TEXT { s.control_dispose(n.id) >>> (err) { -> } }
        else if screen_is_overlay(n.kind) { s.overlay_dispose(n.id) >>> (err) { -> } }
        for secondary in 0:2 { key := n.id * 2 + secondary
            if s.labels.has(key) { $cache := s.take_label_cache(key)
                cache.dispose() } }
    }
    node_count := s.nodes.len
    owner := $&s.basics
    icons := $&owner.button_icons
    for i in 0:node_count { id := i + 1
        if icons.has(id) { $icon := icons.take(id)
        icon.dispose() >>> (err) { -> } } }
    owner.button_icon_labels = map[int]bool{}
    ellipses := $&owner.ellipsis_labels
    for i in 0:node_count { id := i + 1
        if ellipses.has(id) { $label := ellipses.take(id)
        label.dispose() } }
    for i in 0:node_count { id := i + 1
        s.dispose_selectable_slot(id)
        s.dispose_selectable_slot(-id) }
    s.buttons = map[int]Button{}
    s.labels = map[int]TextCache{}
    s.dispose_composition()
    $frame := s.take_frame()
    frame.dispose()
    s.disposed = true
    s.closed = true
    s.notify_xacp_closed()
}

// The callback owns business state only. Screen owns dispatch, rendering,
// native resources and cleanup, including errors from either callback.
pub struct@ ScreenHandler {
    fn layout($&Screen) int
    fn update($&Screen,Action) int
}
// Existing three-argument callers use update as the fallback. Supply one table
// to register functions; its fallback (if set) runs before legacy update.
pub fn run_screen#H:ScreenHandler(s $&Screen,events chan ui.Event,handler $&H,tables <-> ActionDispatcher#H,Screen,Action) int {
    if tables.len > 1 { s.dispose()
        >>> errors.new("widgets: expected at most one action table") }
    dispatcher := action_dispatcher(&*handler,&*s)
    if tables.len == 1 {
        screen_loop(s,events,handler,&tables[0]) >>> (err) { s.dispose()
            >>> err }
    } else {
        screen_loop(s,events,handler,&dispatcher) >>> (err) { s.dispose()
            >>> err }
    }
    s.dispose()
    << 0
}
fn screen_loop#H:ScreenHandler(s $&Screen,events chan ui.Event,handler $&H,dispatcher &ActionDispatcher#H,Screen,Action) int {
    handler.layout(s) >>>
    _ := s.render() >>>
    while s.is_open() {
        actions := s.next(events) >>>
        if !s.is_open() { <- }
        for action in actions {
            if !(dispatcher.dispatch_or_fallback(&action,handler,s) >>>) { handler.update(s,action) >>> }
        }
        if !s.is_open() { <- }
        handler.layout(s) >>>
        _ := s.render() >>>
    }
    << 0
}

fn (s $&Screen) take_button(id int) Button { items := $&s.buttons
    << items.take(id) }
fn (s $&Screen) take_label_cache(id int) TextCache { items := $&s.labels
    << items.take(id) }
fn (s $&Screen) take_frame() draw.Frame { items := $&s.frames
    << items.take(1) }

// next() drains these automatically. Custom event loops call this after
// advance() to receive timer-driven actions such as Stepper repetition.
pub fn (s $&Screen) take_actions() []Action {
    $actions := []Action{}
    for action in s.queued_actions { actions.push(action) }
    s.queued_actions = []Action{}
    << actions
}
