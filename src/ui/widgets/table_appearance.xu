@ui/widgets

#ui
#ui/draw
#ui/layout
#errors
#math

pub fn (t &Table) column_width(column int) f64 {
    if column < 0 || column >= t.column_count() { >> errors.new("widgets: invalid table column") }
    << t.column_extent(column)
}
fn (t &Table) column_extent(column int) f64 {
    if t.widths[column] > 0.0 { << t.widths[column] * t.density }
    mut fixed := 0.0
    mut automatic := 0
    for width in t.widths { if width > 0.0 { fixed = fixed + width * t.density }
        else { automatic = automatic + 1 } }
    << math.max(t.minima[column] * t.density,(t.outer.width - fixed) / f64(max_int(1,automatic)))
}
fn (t &Table) content_width() f64 {
    mut width := 0.0
    for i in 0:t.column_count() { width = width + t.column_extent(i) }
    << width
}
pub fn (t &mut Table) set_column_width(column int,width f64) int {
    if t.rows.closed || column < 0 || column >= t.column_count() || !finite_metric(width,4096.0) || (width > 0.0 && width < t.minima[column]) {
        >> errors.new("widgets: invalid table column width")
    }
    t.widths[column] = width
    b := t.bounds()
    t.set_bounds(&b) or >>
    t.set_horizontal_offset(t.scroll_x) or >>
    t.rows.dirty = true
    << 0
}
pub fn (t &mut Table) set_column_alignment(column int,alignment f64) int {
    if column < 0 || column >= t.column_count() || !finite_metric(alignment,1.0) { >> errors.new("widgets: invalid table column alignment") }
    t.alignments[column] = alignment
    t.rows.dirty = true
    << 0
}
pub fn (t &mut Table) set_horizontal_offset(offset f64) int {
    if math.is_nan(offset) || math.is_inf(offset) { >> errors.new("widgets: invalid table scroll offset") }
    next := math.max(0.0,math.min(math.max(0.0,t.content_width() - t.outer.width),offset))
    if t.scroll_x != next { t.scroll_x = next
        t.rows.dirty = true }
    << 0
}
pub fn (t &Table) horizontal_offset() f64 { << t.scroll_x }
pub fn (t &mut Table) set_status(text &string) int {
    validate_table_text(text) or >>
    t.status_text = text + ""
    t.rows.dirty = true
    << 0
}
fn (t &Table) horizontal_track() layout.Rect {
    << layout.Rect{x: t.outer.x,y: t.outer.y + t.outer.height - 16.0 * t.density,width: t.outer.width,height: 16.0 * t.density}
}
fn (t &Table) horizontal_thumb() layout.Rect {
    r := t.horizontal_track()
    content := t.content_width() or >>
    width := math.min(r.width,math.max(24.0 * t.density,r.width * r.width / math.max(1.0,content)))
    x := r.x + (r.width - width) * t.scroll_x / math.max(1.0,content - r.width)
    << layout.Rect{x: x,y: r.y + 5.0 * t.density,width: width,height: 6.0 * t.density}
}
fn (t &mut Table) column_input(input &ui.InputEvent) Action {
    mut consumed := false
    if input.kind == ui.EV_POINTER_SCROLL && t.outer.contains(input.x,input.y) && input.dx != 0.0 {
        t.set_horizontal_offset(t.scroll_x + input.dx) or >>
        consumed = true
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if !t.rows.read_only && input.y >= t.outer.y && input.y < t.outer.y + t.header_h && t.outer.contains(input.x,input.y) {
            for i in 0:t.column_count() {
                r := t.header_bounds(i)
                if math.abs(input.x - r.x - r.width) <= 4.0 * t.density {
                    t.resize_column = i
                    t.resize_x = input.x
                    t.resize_width = r.width / math.max(0.5,t.density)
                    t.armed_header = -1
                    t.rows.armed_idx = -1
                    consumed = true
                    <-
                }
            }
        }
        if t.content_width() > t.outer.width && t.horizontal_track().contains(input.x,input.y) {
            thumb := t.horizontal_thumb() or >>
            if input.x >= thumb.x && input.x < thumb.x + thumb.width { t.horizontal_drag = true
                t.horizontal_grab = input.x - thumb.x }
            else { mut direction := 1.0
                if input.x < thumb.x { direction = -1.0 }
                t.set_horizontal_offset(t.scroll_x + direction * t.outer.width) or >> }
            consumed = true
        }
    }
    if input.kind == ui.EV_POINTER_MOVE && t.resize_column >= 0 {
        width := math.max(t.minima[t.resize_column],math.min(4096.0,t.resize_width + (input.x - t.resize_x) / math.max(0.5,t.density)))
        t.set_column_width(t.resize_column,width) or >>
        consumed = true
    }
    if input.kind == ui.EV_POINTER_MOVE && t.horizontal_drag {
        track := t.horizontal_track()
        thumb := t.horizontal_thumb() or >>
        ratio := (input.x - track.x - t.horizontal_grab) / math.max(1.0,track.width - thumb.width)
        t.set_horizontal_offset(ratio * math.max(0.0,t.content_width() - t.outer.width)) or >>
        consumed = true
    }
    if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && (t.resize_column >= 0 || t.horizontal_drag) {
        t.resize_column = -1
        t.horizontal_drag = false
        consumed = true
    }
    mut action := no_action(t.id(),t.needs_paint())
    if consumed { t.rows.dirty = true
        action.kind = ACTION_SCROLL
        action.needs_paint = true
        action.consumed = true
        action.request_focus = input.kind == ui.EV_POINTER_DOWN }
    << action
}
pub fn (t &mut Table) paint_styled(frame &mut draw.Frame,styles &Styles) int {
    t.apply_styles(styles) or >>
    c := t.style_or(styles)
    d := styles.density
    cols := t.column_count()
    outer := t.bounds()
    style_box(frame,&outer,&c,d,t.rows.visual_state() & (STATE_DISABLED | STATE_INVALID | STATE_READ_ONLY)) or >>
    frame.push() or >>
    frame.clip_rect(outer.x,outer.y,outer.width,outer.height) or >>
    header := layout.Rect{x: outer.x,y: outer.y,width: outer.width,height: math.min(outer.height,t.header_h)}
    rounded_fill(frame,&header,c.radius * d,mix_color(c.palette.normal,c.palette.foreground,0.035)) or >>
    frame.line(header.x,header.y + header.height,header.x + header.width,header.y + header.height,c.palette.border,d) or >>
    for i in 0:cols {
        b := t.header_bounds(i)
        mut text_style := c.clone()
        text_style.align_x = t.alignments[i]
        if i == t.hot_header { rounded_fill(frame,&b,0.0,c.palette.hovered) or >> }
        if t.rows.focused && i == t.header_cursor { rounded_stroke(frame,&b,4.0 * d,c.palette.focus,c.focus_width * d) or >> }
        text := t.headers[i] + ""
        mut rect := copy_rect(&b)
        if i == t.sort_col { rect.width = math.max(0.0,rect.width - 18.0 * d)
            mut angle := -90.0
            if t.descending { angle = 90.0 }
            tree_chevron(frame,b.x + b.width - 12.0 * d,b.y + b.height * 0.5,8.0 * d,angle,c.palette.muted) or >> }
        cache := mut &t.labels
        cache.paint_text(i,&text,frame,&rect,styles,&text_style,0) or >>
    }
    body := t.rows.bounds()
    viewport := layout.Rect{x: body.x + t.rows.padding.left,y: body.y + t.rows.padding.top,
        width: math.max(0.0,body.width - t.rows.padding.left - t.rows.padding.right),height: math.max(0.0,body.height - t.rows.padding.top - t.rows.padding.bottom)}
    mut row_width := viewport.width
    if t.rows.max_scroll() > 0.0 { row_width = math.max(0.0,row_width - 16.0 * d) }
    first := max_int(0,int(t.rows.scroll_y / t.rows.row_h))
    last := min_int(t.count(),first + int(viewport.height / t.rows.row_h) + 2)
    frame.push() or >>
    frame.clip_rect(viewport.x,viewport.y,row_width,viewport.height) or >>
    if t.status_text.len > 0 || t.count() == 0 {
        mut message := t.status_text + ""
        if message.len == 0 { message = t.locale.text(TEXT_NO_RECORDS) or >> }
        mut muted := c.clone()
        muted.palette.foreground = c.palette.muted
        muted.align_x = 0.5
        rect := layout.Rect{x: viewport.x,y: viewport.y,width: row_width,height: math.max(40.0 * d,viewport.height)}
        cache := mut &t.labels
        cache.paint_text(1022,&message,frame,&rect,styles,&muted,0) or >>
    } else {
        for row in first:last {
            r := layout.Rect{x: viewport.x,y: viewport.y + f64(row) * t.rows.row_h - t.rows.scroll_y,width: row_width,height: t.rows.row_h}
            state := t.rows.item_visual_state(row)
            if row == t.rows.selected_val || row == t.rows.hovered_idx { rounded_fill(frame,&r,4.0 * d,c.resolve(state).background) or >> }
            for column in 0:cols {
                source := t.row_at(row) or >>
                text := t.cells[source * cols + column] + ""
                grid := t.header_bounds(column)
                cell := layout.Rect{x: grid.x,y: r.y,width: grid.width,height: r.height}
                mut text_style := c.clone()
                text_style.align_x = t.alignments[column]
                slot := 16 + (row - first) * cols + column
                cache := mut &t.labels
                cache.paint_text(slot,&text,frame,&cell,styles,&text_style,state) or >>
            }
        }
    }
    frame.pop() or >>
    t.rows.paint_data_scrollbar(frame,&c) or >>
    if t.content_width() > outer.width {
        thumb := t.horizontal_thumb() or >>
        rounded_fill(frame,&thumb,3.0 * d,fade_color(c.palette.muted,0.65)) or >>
    }
    frame.pop() or >>
    << 0
}
