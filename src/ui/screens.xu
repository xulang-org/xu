@ui

#errors
#strings
#encoding/hex
#strconv

pub const REQUEST_SCREENS = 7
pub struct ScreenRect { pub x f64
    pub y f64
    pub width f64
    pub height f64 }
pub struct ScreenInfo {
    pub id string
    pub name string
    pub bounds ScreenRect
    pub work_area ScreenRect
    pub scale_x f64
    pub scale_y f64
    pub primary bool
    pub current bool
    pub primary_known bool
    pub work_area_known bool
    // Win32 virtual-desktop rectangles are physical pixels; AppKit/GTK use
    // logical desktop coordinates. Never mix them with canvas-local positions.
    pub physical_coordinates bool
}
pub fn (window &Window) screens_async(options &RequestOptions) Request {
    target := CanvasEvent{window_id: window.id,canvas_id: window.id,generation: window.generation}
    empty := ""
    << submit_request(&target,REQUEST_SCREENS,&empty,&empty,options.timeout_ms,0) or >>
}
pub fn screen_result(result &RequestResult) []ScreenInfo {
    if result.request.kind != REQUEST_SCREENS || result.status != REQUEST_COMPLETED || result.value.len < 5 || result.value[0:5] != "XUS1\n" { >> errors.new("ui: expected a completed screen query") }
    $screens := []ScreenInfo{}
    lines := strings.split(&result.value,"\n")
    for i in 1:lines.len {
        line := lines[i] + ""
        if line.len == 0 { -> }
        fields := strings.split(&line,"\t")
        if fields.len != 13 || screens.len >= 64 { >> errors.new("ui: invalid screen snapshot") }
        id := hex.decode(&fields[0]) or >>
        name := hex.decode(&fields[1]) or >>
        flags := strconv.atoi(&fields[2]) or >>
        $numbers := []f64{}
        for j in 3:13 { numbers.push(input_number(&fields[j]) or >>) }
        if id.len == 0 || id.len > 256 || name.len > 1024 || !request_text_valid(&id) || !request_text_valid(&name) || flags < 0 || flags > 31 ||
           numbers[2] <= 0.0 || numbers[3] <= 0.0 || numbers[6] <= 0.0 || numbers[7] <= 0.0 || numbers[8] <= 0.0 || numbers[9] <= 0.0 || numbers[8] > 1024.0 || numbers[9] > 1024.0 { >> errors.new("ui: invalid screen fields") }
        for screen in screens { if screen.id == id { >> errors.new("ui: duplicate screen identity") } }
        screens.push(ScreenInfo{id: id,name: name,bounds: ScreenRect{x: numbers[0],y: numbers[1],width: numbers[2],height: numbers[3]},
            work_area: ScreenRect{x: numbers[4],y: numbers[5],width: numbers[6],height: numbers[7]},scale_x: numbers[8],scale_y: numbers[9],
            primary: (flags & 1) != 0,current: (flags & 2) != 0,primary_known: (flags & 16) != 0,work_area_known: (flags & 4) != 0,physical_coordinates: (flags & 8) != 0})
    }
    if screens.len == 0 { >> errors.new("ui: screen query returned no displays") }
    << screens
}
