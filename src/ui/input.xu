@ui

#errors
#strings
#strconv
#math

pub const EV_POINTER_DOWN = 72
pub const EV_POINTER_UP = 73
pub const EV_POINTER_MOVE = 74
pub const EV_POINTER_ENTER = 75
pub const EV_POINTER_LEAVE = 76
pub const EV_POINTER_CANCEL = 77
pub const EV_KEY_DOWN = 78
pub const EV_KEY_UP = 79
pub const EV_POINTER_SCROLL = 80
pub const EV_CANVAS_READY = 81
pub const EV_CANVAS_CLOSED = 82

pub struct CanvasEvent {
    pub window_id int
    pub canvas_id int
    pub generation int
}

fn decode_canvas(payload &string) CanvasEvent {
    fields := strings.split(payload, "\t")
    if fields.len != 4 { >> errors.new("ui: invalid canvas lifecycle record") }
    if fields[0] != "canvas_ready" && fields[0] != "canvas_closed" { >> errors.new("ui: invalid canvas tag") }
    window := strconv.atoi(&fields[1]) or >>
    canvas := strconv.atoi(&fields[2]) or >>
    generation := strconv.atoi(&fields[3]) or >>
    if window <= 0 || window > 2147483647 || canvas <= 0 || canvas > 2147483647 ||
       generation <= 0 || generation > 4294967295 { >> errors.new("ui: invalid canvas identity") }
    << CanvasEvent{window_id: window, canvas_id: canvas, generation: generation}
}

pub fn canvas_of(event &Event) CanvasEvent {
    if event.kind != EV_CANVAS_READY && event.kind != EV_CANVAS_CLOSED { >> errors.new("ui: expected a canvas lifecycle event") }
    identity := decode_canvas(&event.menu_id) or >>
    prefix := "canvas_ready\t"
    is_ready := event.menu_id.len >= prefix.len && event.menu_id[0:prefix.len] == prefix
    if identity.window_id != event.window_id || (event.kind == EV_CANVAS_READY) != is_ready {
        >> errors.new("ui: inconsistent canvas event identity")
    }
    << identity
}

pub const MOD_SHIFT = 1
pub const MOD_CONTROL = 2
pub const MOD_ALT = 4
pub const MOD_META = 8
pub const BUTTON_LEFT = 1
pub const BUTTON_RIGHT = 2
pub const BUTTON_MIDDLE = 3
pub const CURSOR_DEFAULT = 0
pub const CURSOR_TEXT = 1
pub const CURSOR_CROSSHAIR = 2
pub const CURSOR_HAND = 3
pub const CURSOR_RESIZE_HORIZONTAL = 4
pub const CURSOR_RESIZE_VERTICAL = 5

// Letters/digits use uppercase ASCII; navigation keys have stable codes.
// scan is the native hardware code and must not be used for text input.
pub const KEY_ESCAPE = 256
pub const KEY_TAB = 257
pub const KEY_ENTER = 258
pub const KEY_BACKSPACE = 259
pub const KEY_DELETE = 260
pub const KEY_LEFT = 261
pub const KEY_RIGHT = 262
pub const KEY_UP = 263
pub const KEY_DOWN = 264
pub const KEY_HOME = 265
pub const KEY_END = 266
pub const KEY_PAGE_UP = 267
pub const KEY_PAGE_DOWN = 268
pub const KEY_INSERT = 269
pub const KEY_F1 = 288
pub const KEY_SHIFT = 304
pub const KEY_CONTROL = 305
pub const KEY_ALT = 306
pub const KEY_META = 307
pub const KEY_CAPS_LOCK = 308

pub struct InputEvent {
    pub kind int
    pub window_id int
    pub canvas_id int
    pub generation int
    pub x f64
    pub y f64
    // Pointer-scroll deltas increase content offsets right/down (logical pixels).
    pub dx f64
    pub dy f64
    pub button int
    pub buttons int
    pub modifiers int
    pub key int
    pub scan int
    pub repeat int
    pub click_count int
    pub time_ns int
}

pub fn is_input_event(kind int) bool {
    << kind >= EV_POINTER_DOWN && kind <= EV_POINTER_SCROLL
}

fn input_number(token &string) f64 {
    value := strconv.parse_float(token) or >>
    if math.is_nan(value) || math.is_inf(value) || math.abs(value) > 1000000000.0 {
        >> errors.new("ui: invalid input coordinate")
    }
    << value
}

fn decode_input(payload &string) InputEvent {
    fields := strings.split(payload, "\t")
    $offset := 0
    $generation := 0
    if fields.len == 17 && fields[0] == "input2" {
        offset = 1
        generation = strconv.atoi(&fields[4]) or >>
        if generation <= 0 || generation > 4294967295 { >> errors.new("ui: invalid input generation") }
    } else if fields.len != 16 || fields[0] != "input" { >> errors.new("ui: invalid input record") }
    kind := strconv.atoi(&fields[1]) or >>
    window_id := strconv.atoi(&fields[2]) or >>
    canvas_id := strconv.atoi(&fields[3]) or >>
    xi := 4 + offset
    yi := 5 + offset
    dxi := 6 + offset
    dyi := 7 + offset
    bi := 8 + offset
    bsi := 9 + offset
    mi := 10 + offset
    ki := 11 + offset
    si := 12 + offset
    ri := 13 + offset
    ci := 14 + offset
    ti := 15 + offset
    x := input_number(&fields[xi]) or >>
    y := input_number(&fields[yi]) or >>
    dx := input_number(&fields[dxi]) or >>
    dy := input_number(&fields[dyi]) or >>
    button := strconv.atoi(&fields[bi]) or >>
    buttons := strconv.atoi(&fields[bsi]) or >>
    modifiers := strconv.atoi(&fields[mi]) or >>
    key := strconv.atoi(&fields[ki]) or >>
    scan := strconv.atoi(&fields[si]) or >>
    repeat := strconv.atoi(&fields[ri]) or >>
    clicks := strconv.atoi(&fields[ci]) or >>
    stamp := strconv.atoi(&fields[ti]) or >>
    if !is_input_event(kind) || window_id <= 0 || canvas_id <= 0 || button < 0 || button > 3 ||
       buttons < 0 || buttons > 7 || modifiers < 0 || modifiers > 15 || key < 0 ||
       key > 1114111 || scan < 0 || scan > 65535 || repeat < 0 || repeat > 1 || clicks < 0 || stamp < 0 {
        >> errors.new("ui: invalid input fields")
    }
    << InputEvent{kind: kind, window_id: window_id, canvas_id: canvas_id, generation: generation,
                  x: x, y: y, dx: dx, dy: dy, button: button, buttons: buttons,
                  modifiers: modifiers, key: key, scan: scan, repeat: repeat,
                  click_count: clicks, time_ns: stamp}
}

// The ui event pump remains the only consumer of host events. Widgets and apps
// decode the event they received instead of competing for the native queue.
pub fn input_of(event &Event) InputEvent {
    if !is_input_event(event.kind) { >> errors.new("ui: expected an input event") }
    input := decode_input(&event.menu_id) or >>
    if input.kind != event.kind || input.window_id != event.window_id {
        >> errors.new("ui: inconsistent input event identity")
    }
    << input
}
