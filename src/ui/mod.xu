}

fn content_plugin_windows_libs_path() string {
    << ui_tmp() + "/xu_ui_plugin_windows_libs.txt"
}

fn trim_nl(s string) string {
    mut out := s + ""
    while out.len > 0 {
        c := out[out.len - 1] & 255
        if c == 10 || c == 13 {
            out = out[0:out.len - 1]
        } else {
            << out
        }
    }
    << out
}

fn write_plugin_field(path string, body string) int {
    write_file(path, body + "\n") or (err) {
        << 0
    }
    << 0
}

// Default webview ContentPlugin (per-OS host sources). Used by #ui/webview.attach.
pub fn content_plugin_webview() ContentPlugin {
    << ContentPlugin{kind: content_webview, bootstrap: "XuWebViewPluginBootstrap", macos_src: "src/ui/host/macos_webview.swift", macos_frameworks: "WebKit", linux_src: "src/ui/host/linux_webview.cc", linux_libs: "$$(pkg-config --cflags --libs webkitgtk-6.0)", windows_src: "src/ui/host/windows_webview.cc", windows_libs: "-loleaut32 -lshlwapi"}
}

// Direct-draw content plugin (no WebKit). Same registration shape as webview.
pub fn content_plugin_draw() ContentPlugin {
    << ContentPlugin{kind: content_draw, bootstrap: "XuDrawPluginBootstrap", macos_src: "src/ui/host/macos_draw.swift", macos_frameworks: "", linux_src: "src/ui/host/linux_draw.cc", linux_libs: "", windows_src: "src/ui/host/windows_draw.cc", windows_libs: ""}
}

// Attach draw backend to a window slot and register the plugin for App.run().
pub fn use_draw_content(w &mut Window) int {
    w.set_content_slot(content_draw, w.id)
    << register_content_plugin(content_plugin_draw())
}

// Draw-plugin cmds (content_draw). Hex like "#3366cc" or "3366cc".
// Canvas API (immediate-mode 2D, Love2D/Raylib-style): `#ui/draw`.
pub fn native_draw_set_bg(hex string) int {
    << append_content_cmd("bgcolor\t" + hex) or >>
}

pub fn native_draw_clear() int {
    << append_content_cmd("draw_clear") or >>
}

pub fn native_draw_set_label(text string) int {
    << append_content_cmd("label\t" + text) or >>
}

// Register a content backend before App.run().
// Spec carries macOS / Linux / Windows sources separately — shell never hardcodes a backend
// or a single-OS path. Future draw / native views use the same shape.
pub fn register_content_plugin(p ContentPlugin) int {
    if !native_enabled() {
        // Still record paths for sim / cross-check; host launch is gated elsewhere.
    }
    wk := write_plugin_field(content_kind_path(), str(p.kind))
    wb := write_plugin_field(content_plugin_bootstrap_path(), p.bootstrap)
    wms := write_plugin_field(content_plugin_macos_src_path(), p.macos_src)
    wmf := write_plugin_field(content_plugin_macos_frameworks_path(), p.macos_frameworks)
    wls := write_plugin_field(content_plugin_linux_src_path(), p.linux_src)
    wll := write_plugin_field(content_plugin_linux_libs_path(), p.linux_libs)
    wws := write_plugin_field(content_plugin_windows_src_path(), p.windows_src)
    wwl := write_plugin_field(content_plugin_windows_libs_path(), p.windows_libs)
    if wk + wb + wms + wmf + wls + wll + wws + wwl < 0 {
        << 0
    }
    << 0
}

fn read_plugin_file(path string) string {
    << trim_nl(read_file(path) or (err) {
        << ""
    })
}

pub fn (a &mut App) run() int {
    mode := require_ui_host() or >>
    if mode == 1 {
        a.sim = 1
        a.push_event(Event{kind: ev_ready, window_id: 0, menu_id: "", width: 0, height: 0})
        if a.quit_flag != 0 {
            a.push_event(Event{kind: ev_exit, window_id: 0, menu_id: "", width: 0, height: 0})
            << 0
        }
        a.push_event(Event{kind: ev_exit, window_id: 0, menu_id: "", width: 0, height: 0})
        << 0
    }
    if a.icon.path.len > 0 {
        ic := write_file(app_icon_path_file(), abs_icon_path(a.icon.path + "")) or (err) {
            << 0
        }
        if ic < 0 {
        }
    }
    // open_native_window comes from host_open_{macos,linux,windows}.xu
    // selected by file-header compile tags ($macos / $linux / $windows).
    open_native_window(a.win_title, a.win_w, a.win_h) or >>
    << 0
}

pub fn load_asset(path string) string {
    << read_file(path) or >>
}
