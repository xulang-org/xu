// PNG alpha mask: opaque pixels visible + hit-test; alpha≈0 click-through.
// macOS AppKit / Linux GTK4 / Windows Win32+GDI+ UpdateLayeredWindow.
pub fn native_set_window_mask(path string) int {
    if path.len == 0 {
        << native_clear_window_mask()
    }
    p := abs_icon_path(path + "")
    write_file(ui_tmp() + "/xu_ui_mask_path.txt", p) or >>
    // Shaped windows imply frameless + transparent at launch.
    write_file(ui_tmp() + "/xu_ui_frameless.txt", "1") or >>
    write_file(ui_tmp() + "/xu_ui_transparent.txt", "1") or >>
    << append_shell_cmd("mask\t" + p) or >>
}

pub fn native_clear_window_mask() int {
    if native_enabled() {
        write_file(ui_tmp() + "/xu_ui_mask_path.txt", "") or (err) {
            << 0
        }
    }
    << append_shell_cmd("mask_clear") or (err) {
        << 0
    }
}

