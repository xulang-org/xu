pub fn (a &mut App) remember_menu(m Menu) {
    mut i := 0
    while i < m.items.len {
        id := m.items[i].id + ""
        a.menu_ids.push(id)
        i = i + 1
    }
}

pub fn (w &mut Window) set_content_slot(kind int, backend_id int) {
    w.content_kind = kind
    w.content_backend_id = backend_id
}

pub fn (w Window) content_slot_kind() int {
    << w.content_kind
}

pub fn (w Window) content_slot_backend_id() int {
    << w.content_backend_id
}

pub fn (w &mut Window) close() {
    w.closed = 1
}

pub fn (a &mut App) quit() {
    a.quit_flag = 1
}

pub fn (a &mut App) push_event(ev Event) {
    a.event_ch <- ev
}

pub fn (a &mut App) poll_event() Event {
    << poll_chan(a.event_ch)
}

pub fn (a &mut App) post(token int) {
    a.post_ch <- token
}

pub fn (a &mut App) try_recv_post() int {
    select {
        t := <-a.post_ch {
            << t
        }
        else {
            << 0
        }
    }
    << 0
}

fn sanitize_title(title string) string {
    mut out := ""
    mut i := 0
    while i < title.len {
        b := title[i] & 255
        if b == 34 || b == 92 || b == 10 || b == 13 {
            out = out + "_"
        } else {
            out = out + title[i:i + 1]
        }
        i = i + 1
    }
    if out.len == 0 {
        << "Xu"
    }
    << out
}

