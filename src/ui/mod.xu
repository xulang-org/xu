pub fn native_set_opacity(percent int) int {
    mut p := percent
    if p < 15 {
        p = 15
    }
    if p > 100 {
        p = 100
    }
    whole := p / 100
    frac := p % 100
    mut s := str(whole) + "."
    if frac < 10 {
        s = s + "0" + str(frac)
    } else {
        s = s + str(frac)
    }
    << append_shell_cmd("opacity\t" + s) or >>
}

