// Frameless shell (no system titlebar/chrome). Prefer with transparent + mask for shaped windows.
pub fn native_set_frameless(on int) int {
    mut flag := "0"
    if on != 0 {
        flag = "1"
    }
    if native_enabled() {
        write_file(ui_tmp() + "/xu_ui_frameless.txt", flag) or (err) {
