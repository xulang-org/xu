@ui

#errors

// Desktop shell: App / Window / Icon / Menu / Tray / events / post queue.
// Owns the UI (shell) runtime event loop and host process.
// Content backends: register_content_plugin(ContentPlugin) with per-OS sources.
// Native open: compile-time `$macos` / `$linux` / `$windows` files
//   (host_open_*.xu) each define open_native_window — App.run() does not branch on OS.
//
// Host modes:
//   default         → OS native host (macOS / Linux / Windows)
//   XU_UI_SIM=1     → in-process sim (fixtures/CI)

pub const content_none = 0
pub const content_webview = 1
pub const content_draw = 2
pub const content_native = 3

// Per-OS content backend registration. Shell picks fields for xu_target_os() only.
// Empty src on an OS ⇒ that backend is unavailable there (shell may still run empty).
pub struct ContentPlugin {
    pub kind int
    pub bootstrap string
    pub macos_src string
    pub macos_frameworks string
    pub linux_src string
    pub linux_libs string
    pub windows_src string
    pub windows_libs string
}

pub const os_macos = 0
pub const os_linux = 1
pub const os_windows = 2
pub const os_none = 3

pub const ev_none = 0
pub const ev_ready = 1
pub const ev_exit = 2
pub const ev_before_exit = 3
pub const ev_close_requested = 10
pub const ev_closed = 11
pub const ev_focused = 12
pub const ev_blurred = 13
pub const ev_resized = 14
pub const ev_moved = 15
pub const ev_menu_clicked = 20
pub const ev_tray_clicked = 30
pub const ev_tray_menu_clicked = 31
pub const ev_loading = 40
pub const ev_loaded = 41
pub const ev_load_failed = 42
pub const ev_progress = 43
pub const ev_file_drop = 50
pub const ev_file_picked = 51
pub const ev_file_saved = 52
pub const ev_external_nav = 53
pub const ev_screenshot = 54
pub const ev_folder_picked = 55
pub const ev_alert = 56
pub const ev_confirm = 57
pub const ev_notify = 58
pub const ev_close_rejected = 59
pub const ev_cache_cleared = 60
pub const ev_download = 61
pub const ev_download_failed = 62
pub const ev_cookies_cleared = 63
pub const ev_cookie_set = 64
pub const ev_clipboard = 65
pub const ev_bounds = 66
pub const ev_state = 67
pub const ev_click = 68
pub const ev_prompt = 69
pub const ev_scroll = 70
pub const ev_drag = 71

pub struct Event {
    pub kind int
    pub window_id int
    pub menu_id string
    pub width int
    pub height int
}

pub struct Icon {
    pub path string
}

pub struct MenuItem {
    pub id string
    pub label string
}

pub struct Menu {
    pub items []MenuItem
}

pub struct WindowOpts {
    pub title string
    pub width int
    pub height int
}

pub struct Window {
    pub id int
    pub title string
    pub width int
    pub height int
    pub content_kind int
    pub content_backend_id int
    pub closed int
}

pub struct TrayOpts {
    pub tip string
    pub icon Icon
    pub menu Menu
}

pub struct Tray {
    pub id int
    pub tip string
}

pub struct App {
    pub next_id int
    pub icon Icon
    pub quit_flag int
    pub sim int
    pub event_ch chan Event
    pub post_ch chan int
    pub menu_ids []string
    pub win_title string
    pub win_w int
    pub win_h int
}

pub fn new_app() App {
    ch := chan int{cap: 64}
    ech := chan Event{cap: 256}
    xu pump_host_events(ech)
    << App{next_id: 1, icon: Icon{path: ""}, quit_flag: 0, sim: 0, event_ch: ech, post_ch: ch, menu_ids: []string{}, win_title: "Xu", win_w: 800, win_h: 600}
}

// new_app_events shares `ech` with IPC / draw workers. Host events are pumped here
// (not in #ui/webview.bind_ipc).
pub fn new_app_events(ech chan Event) App {
    ch := chan int{cap: 64}
    xu pump_host_events(ech)
    << App{next_id: 1, icon: Icon{path: ""}, quit_flag: 0, sim: 0, event_ch: ech, post_ch: ch, menu_ids: []string{}, win_title: "Xu", win_w: 800, win_h: 600}
}

pub fn icon_default() Icon {
    << Icon{path: ""}
}

pub fn icon_from_file(path string) Icon {
    << Icon{path: path}
}

pub fn menu_item(id string, label string) MenuItem {
    << MenuItem{id: id, label: label}
}

pub fn menu(items []MenuItem) Menu {
    << Menu{items: items}
}

pub fn target_os() int {
    << xu_target_os()
}

pub fn platform_supported() bool {
    << xu_target_os() == os_macos
}

fn sim_enabled() bool {
    << env_get("XU_UI_SIM") == "1"
}

fn native_enabled() bool {
    // Native is the default; SIM opts out for fixtures/CI.
    << !sim_enabled()
}

// 1 = sim, 2 = native OS host (macOS / Linux / Windows — each has its own open_*)
fn require_ui_host() int {
    os := xu_target_os()
    if os != os_macos && os != os_linux && os != os_windows {
        >> errors.new("ui: unsupported on this target")
    }
    if sim_enabled() {
        << 1
    }
    if native_enabled() {
        << 2
    }
    >> errors.new("ui: host not available")
    << 0
}

pub fn (a &mut App) alloc_id() int {
    id := a.next_id
    a.next_id = a.next_id + 1
    << id
}

fn app_icon_path_file() string {
    << ui_tmp() + "/xu_ui_app_icon.txt"
}

fn tray_icon_path_file() string {
    << ui_tmp() + "/xu_ui_tray_icon.txt"
}

fn abs_icon_path(path string) string {
    if path.len == 0 {
        << ""
    }
    // Absolute: Unix `/...` or Windows `C:\...` / `C:/...`
    if (path[0] & 255) == 47 {
        << path + ""
    }
    if path.len >= 3 && (path[1] & 255) == 58 {
        << path + ""
    }
    pwd := env_get("PWD")
    if pwd.len > 0 {
        << pwd + "/" + path
    }
    << path + ""
}

pub fn (a &mut App) set_icon(icon Icon) {
    p := abs_icon_path(icon.path + "")
    a.icon = icon
    if native_enabled() {
        write_file(app_icon_path_file(), p) or (err) {
            <<
        }
    }
}

pub fn install_tray_icon(path string) int {
    write_file(tray_icon_path_file(), abs_icon_path(path)) or >>
    << 0
}

pub fn (a &mut App) new_window(opts WindowOpts) Window {
    id := a.alloc_id()
    mut title := opts.title
    if title.len == 0 {
        title = "Xu"
    }
    mut w := opts.width
    mut h := opts.height
    if w <= 0 {
        w = 800
    }
    if h <= 0 {
        h = 600
    }
    a.win_title = title + ""
    a.win_w = w
    a.win_h = h
    << Window{id: id, title: title, width: w, height: h, content_kind: content_none, content_backend_id: 0, closed: 0}
}

fn ui_tmp() string {
    // Prefer a real workdir only when explicitly set (dev / non-pack).
    // Pack/oneexe (Win/mac/Linux) clears XU_UI_TMP and uses in-process ":xu:" mailbox.
    d := env_get("XU_UI_TMP")
    if d.len > 0 && d != ":xu:" && d != ":mem:" {
        << d + ""
    }
    if env_get("XU_UI_PACK") == "1" || env_get("XU_UI_WWW") == ":mem:" {
        << ":xu:"
    }
    << tmp_dir()
}

fn menu_file_path() string {
    << ui_tmp() + "/xu_ui_menu.txt"
}

fn tray_file_path() string {
    << ui_tmp() + "/xu_ui_tray.txt"
}

fn tray_tip_path() string {
    << ui_tmp() + "/xu_ui_tray_tip.txt"
}

fn encode_menu(m Menu) string {
    mut out := ""
    mut i := 0
    while i < m.items.len {
        id := m.items[i].id + ""
        label := m.items[i].label + ""
        out = out + id + "\t" + label + "\n"
        i = i + 1
    }
    << out
}

pub fn install_menu(m Menu) int {
    body := encode_menu(m)
    write_file(menu_file_path(), body) or >>
    << 0
}

pub fn install_tray(tip string, m Menu) int {
    write_file(tray_tip_path(), tip + "") or >>
    body := encode_menu(m)
    write_file(tray_file_path(), body) or >>
    << 0
}

pub fn (w &mut Window) set_menu(m Menu) {
    install_menu(m) or (err) {
        e := err.msg()
        <<
    }
}

pub fn (a &mut App) new_tray(opts TrayOpts) Tray {
    id := a.alloc_id()
    << Tray{id: id, tip: opts.tip + ""}
}

pub fn (w &mut Window) set_title(title string) {
    w.title = title + ""
    if native_enabled() {
        write_file(ui_tmp() + "/xu_ui_title.txt", sanitize_title(title)) or (err) {
            <<
        }
    }
}

// native_set_title updates the live host title file (no Window handle needed).
pub fn native_set_title(title string) int {
    if !native_enabled() {
        << 0
    }
    write_file(ui_tmp() + "/xu_ui_title.txt", sanitize_title(title)) or >>
    << 0
}

// native_set_size updates live window size (host polls xu_ui_size.txt).
pub fn native_set_size(width int, height int) int {
    if !native_enabled() {
        << 0
    }
    if width <= 0 || height <= 0 {
        >> errors.new("ui: native_set_size requires positive size")
    }
    write_file(ui_tmp() + "/xu_ui_size.txt", str(width) + " " + str(height)) or >>
    << 0
}

// Host command bridge. Prefixed so shell vs content stay distinct at the wire.
// Host strips "shell." / "wv." / "content." then dispatches; one process still owns AppKit.
// Results come back host → xu_ui_shell_event.txt → pump_host_events → event_ch.
fn append_host_cmd(kind string, line string) int {
    if !native_enabled() {
        << 0
    }
    cmd_path := ui_tmp() + "/xu_ui_cmd.txt"
    // read_plugin_file trims trailing newlines — restore so lines stay separated.
    mut prev := read_plugin_file(cmd_path + "")
    if prev.len > 0 {
        prev = prev + "\n"
    }
    write_file(cmd_path + "", prev + kind + "." + line + "\n") or >>
    << 0
}

pub fn append_shell_cmd(line string) int {
    << append_host_cmd("shell", line) or >>
}

// Content-backend cmds (#ui/webview / #ui/draw / …). Prefer this for non-shell backends.
pub fn append_content_cmd(line string) int {
    << append_host_cmd("content", line) or >>
}

// Alias: webview historically used the "wv." prefix (still accepted by host).
pub fn append_wv_cmd(line string) int {
    << append_host_cmd("wv", line) or >>
}

pub fn host_enabled() bool {
    << native_enabled()
