@ui

#errors
#strings
#strconv
#math
#encoding/hex
#unicode/utf8
#ui/internal/codec

pub const EV_TEXT_COMMIT = 86
pub const EV_TEXT_PREEDIT = 87
pub const EV_TEXT_CANCEL = 88
pub const EV_TEXT_SELECTION = 89
pub const EV_TEXT_INPUT_READY = 90
pub const EV_TEXT_INPUT_ENDED = 91
pub const EV_TEXT_INPUT_FAILED = 92
pub const EV_TEXT_SURROUNDING_DELETE = 93
pub const ev_text_commit = 86
pub const ev_text_preedit = 87
pub const ev_text_cancel = 88
pub const ev_text_selection = 89
pub const ev_text_input_ready = 90
pub const ev_text_input_ended = 91
pub const ev_text_input_failed = 92
pub const ev_text_surrounding_delete = 93
pub const TEXT_INPUT_STOPPED = 0
pub const TEXT_INPUT_WINDOW_CLOSED = 1
pub const TEXT_INPUT_BACKPRESSURE = 2
pub const TEXT_INPUT_UNAVAILABLE = 3
pub const TEXT_INPUT_ACTIVATION_TIMEOUT = 4

pub struct TextInputRect {
    pub x f64
    pub y f64
    pub width f64
    pub height f64
}
pub struct TextInputOptions {
    pub value string
    pub anchor int
    pub focus int
    pub caret TextInputRect
    pub multiline bool
    // Suppress native surrounding-text disclosure. The widget must also use
    // a masked layout while the value is concealed.
    pub password bool
}
pub struct TextInput {
    pub id int
    pub window_id int
    pub canvas_id int
    pub generation int
}
pub struct TextInputState {
    pub input TextInput
    pub revision int
    pub ready bool
    pub multiline bool
    pub value string
    pub anchor int
    pub focus int
    pub composing bool
    pub preedit string
    pub replacement_start int
    pub replacement_end int
    pub preedit_anchor int
    pub preedit_focus int
    pub caret TextInputRect
}
pub struct TextEditEvent {
    pub input TextInput
    pub kind int
    pub revision int
    pub start int
    pub end int
    pub anchor int
    pub focus int
    pub reason int
    pub value string
}

fn edit_text_valid(value &string) bool {
    if value.len > 16384 || !utf8.valid(value) { << false }
    for i in 0:value.len { if (value[i] & 255) == 0 { << false } }
    << true
}
fn edit_boundary(value &string, offset int) bool {
    if offset < 0 || offset > value.len { << false }
    if offset == value.len { << true }
    << (value[offset] & 192) != 128
}
fn edit_caret_valid(caret &TextInputRect) bool {
    for value in [caret.x, caret.y, caret.width, caret.height] {
        if math.is_nan(value) || math.is_inf(value) || math.abs(value) > 1048576.0 { << false }
    }
    << caret.width >= 0.0 && caret.width <= 16384.0 && caret.height > 0.0 && caret.height <= 16384.0
}
pub fn text_input_options(value &string, caret TextInputRect) TextInputOptions {
    << TextInputOptions{value: value + "", anchor: value.len, focus: value.len, caret: caret, multiline: false,password: false}
}

fn text_input_state(id int) TextInputState {
    data := read_file(":xu:/__text_input_info/" + str(id)) or >>
    if data.len != 32880 || data[0:4] != "XIS1" || (codec.read_word32(&data, 4) & 65535) != 1 ||
       codec.read_word32(&data, 28) != 2 || codec.read_word64(&data, 8) != id {
        >> errors.new("ui: text input session is unavailable or closed")
    }
    flags := (codec.read_word32(&data, 4) >> 16) & 65535
    window := codec.read_word32(&data, 16)
    canvas := codec.read_word32(&data, 20)
    generation := codec.read_word32(&data, 24)
    revision := codec.read_word64(&data, 32)
    length := codec.read_word32(&data, 80)
    marked_length := codec.read_word32(&data, 84)
    if id <= 0 || window <= 0 || window > 2147483647 || canvas <= 0 || canvas > 2147483647 ||
       generation <= 0 || revision <= 0 || flags > 15 || (flags & 9) == 9 || length > 16384 || marked_length > 16384 {
        >> errors.new("ui: invalid text input state")
    }
    value := data[112:112 + length]
    preedit := data[112 + length:112 + length + marked_length]
    anchor := codec.read_word32(&data, 72)
    focus := codec.read_word32(&data, 76)
    start := codec.read_word32(&data, 88)
    end := codec.read_word32(&data, 92)
    preedit_anchor := codec.read_word32(&data, 96)
    preedit_focus := codec.read_word32(&data, 100)
    composing := (flags & 4) != 0
    if !edit_text_valid(&value) || !edit_text_valid(&preedit) || !edit_boundary(&value, anchor) || !edit_boundary(&value, focus) ||
       start > end || !edit_boundary(&value, start) || !edit_boundary(&value, end) ||
       !edit_boundary(&preedit, preedit_anchor) || !edit_boundary(&preedit, preedit_focus) ||
       value.len - (end - start) + preedit.len > 16384 || (!composing && (marked_length != 0 || start != 0 || end != 0)) {
        >> errors.new("ui: invalid text input byte ranges")
    }
    caret := TextInputRect{x: codec.read_float64(&data, 40) or >>, y: codec.read_float64(&data, 48) or >>,
                           width: codec.read_float64(&data, 56) or >>, height: codec.read_float64(&data, 64) or >>}
    if !edit_caret_valid(&caret) { >> errors.new("ui: invalid text input caret") }
    << TextInputState{input: TextInput{id: id, window_id: window, canvas_id: canvas, generation: generation},
        revision: revision, ready: (flags & 2) != 0, multiline: (flags & 1) != 0, value: value, anchor: anchor, focus: focus,
        composing: composing, preedit: preedit, replacement_start: start, replacement_end: end,
        preedit_anchor: preedit_anchor, preedit_focus: preedit_focus, caret: caret}
}
fn input_wire(id int, canvas int, generation int, revision int, mode int, value &string, anchor int, focus int,
              caret &TextInputRect, flags int) int {
    mut header := strings.new_byte_builder(80)
    header.write_str("XTI1")
    codec.word(mut &header, 1, 2)
    codec.word(mut &header, mode, 2)
    codec.word(mut &header, id, 8)
    codec.word(mut &header, canvas, 4)
    codec.word(mut &header, generation, 4)
    codec.word(mut &header, revision, 8)
    for scalar in [caret.x, caret.y, caret.width, caret.height] { codec.word(mut &header, codec.finite_f64_bits(scalar), 8) }
    codec.word(mut &header, anchor, 4)
    codec.word(mut &header, focus, 4)
    codec.word(mut &header, value.len, 4)
    codec.word(mut &header, flags, 4)
    body := header.to_string() + value
    accepted := write_file(":xu:/__text_input_upload", body) or >>
    if accepted != body.len { >> errors.new("ui: text input update rejected (closed, stale revision, composition or resource limit)") }
    << 0
}
fn abandon_text_input(id int, started bool) {
    mut path := ":xu:/__text_input_abandon"
    if started { path = ":xu:/__text_input_abort" }
    write_file(path, str(id)) or (err) { << }
}

// Starts asynchronously on a live canvas. Listen for ready/failed; commits and
// preedit are independent of raw key events. Caret is in canvas logical units.
pub fn start_text_input(canvas int, generation int, options &TextInputOptions) TextInput {
    if host_tmp() != ":xu:" || canvas <= 0 || canvas > 2147483647 || generation < 0 || generation > 4294967295 ||
       (generation == 0 && canvas != 1) || !edit_text_valid(&options.value) ||
       !edit_boundary(&options.value, options.anchor) || !edit_boundary(&options.value, options.focus) || !edit_caret_valid(&options.caret) ||
       (options.password && options.multiline) {
        >> errors.new("ui: invalid text input options or unsupported host")
    }
    token := read_file(":xu:/__text_input_id") or >>
    if token.len != 20 { >> errors.new("ui: text input host is not linked") }
    id := strconv.atoi(&token) or >>
    if id <= 0 { >> errors.new("ui: text input capacity exhausted") }
    mut flags := 0
    if options.multiline { flags = 1 }
    if options.password { flags = flags | 8 }
    input_wire(id, canvas, generation, 0, 0, &options.value, options.anchor, options.focus, &options.caret, flags) or (err) {
        abandon_text_input(id, false)
        >> errors.new("ui: unable to start text input")
    }
    state := text_input_state(id) or (err) {
        abandon_text_input(id, true)
        >> errors.new("ui: text input closed during startup")
    }
    << state.input
}
pub fn (input &TextInput) snapshot() TextInputState {
    if input.id <= 0 { >> errors.new("ui: text input is stopped") }
    state := text_input_state(input.id) or >>
    if state.input.window_id != input.window_id || state.input.canvas_id != input.canvas_id || state.input.generation != input.generation {
        >> errors.new("ui: text input identity mismatch")
    }
    << state
}
// CAS against the latest native revision. The returned authoritative snapshot
// may also include newer native edits. Ignore older/equal revisions when using
// queued events to maintain a mirror; do not apply those edits twice.
pub fn (input &TextInput) update(revision int, value &string, anchor int, focus int, caret &TextInputRect) TextInputState {
    if revision <= 0 || !edit_text_valid(value) || !edit_boundary(value, anchor) || !edit_boundary(value, focus) || !edit_caret_valid(caret) {
        >> errors.new("ui: invalid text input update")
    }
    input_wire(input.id, input.canvas_id, input.generation, revision, 1, value, anchor, focus, caret, 0) or >>
    << input.snapshot() or >>
}
pub fn (input &mut TextInput) stop() int {
    if input.id == 0 { << 0 }
    empty := ""
    zero := TextInputRect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}
    input_wire(input.id, input.canvas_id, input.generation, 0, 2, &empty, 0, 0, &zero, 0) or >>
    input.id = 0
    << 0
}
pub fn (state &TextInputState) display_value() string {
    if !state.composing { << state.value + "" }
    << state.value[0:state.replacement_start] + state.preedit + state.value[state.replacement_end:state.value.len]
}
pub fn (state &TextInputState) display_anchor() int {
    if state.composing { << state.replacement_start + state.preedit_anchor }
    << state.anchor
}
pub fn (state &TextInputState) display_focus() int {
    if state.composing { << state.replacement_start + state.preedit_focus }
    << state.focus
}

fn decode_text_edit(payload &string) TextEditEvent {
    mut line := payload + ""
    if line.len > 0 && (line[line.len - 1] & 255) == 10 { line = line[0:line.len - 1] }
    fields := strings.split(&line, "\t")
    if fields.len != 13 || fields[0] != "text_edit" || fields[12].len > 32768 { >> errors.new("ui: invalid text edit record") }
    kind := strconv.atoi(&fields[1]) or >>
    window := strconv.atoi(&fields[2]) or >>
    canvas := strconv.atoi(&fields[3]) or >>
    generation := strconv.atoi(&fields[4]) or >>
    id := strconv.atoi(&fields[5]) or >>
    revision := strconv.atoi(&fields[6]) or >>
    start := strconv.atoi(&fields[7]) or >>
    end := strconv.atoi(&fields[8]) or >>
    anchor := strconv.atoi(&fields[9]) or >>
    focus := strconv.atoi(&fields[10]) or >>
    reason := strconv.atoi(&fields[11]) or >>
    value := hex.decode(&fields[12]) or >>
    if kind < 1 || kind > 8 || id <= 0 || revision <= 0 || window <= 0 || window > 2147483647 || canvas <= 0 || canvas > 2147483647 ||
       generation <= 0 || generation > 4294967295 || start < 0 || start > end || end > 16384 || anchor < 0 || anchor > 16384 ||
       focus < 0 || focus > 16384 || reason < 0 || reason > 4 || !edit_text_valid(&value) ||
       ((kind < 6 || kind == 8) && reason != 0) || (kind == 6 && reason > 1) || (kind == 7 && reason < 2) || (kind > 2 && value.len != 0) ||
       (kind == 2 && (!edit_boundary(&value, anchor) || !edit_boundary(&value, focus))) {
        >> errors.new("ui: invalid text edit fields")
    }
    << TextEditEvent{input: TextInput{id: id, window_id: window, canvas_id: canvas, generation: generation},
        kind: 85 + kind, revision: revision, start: start, end: end, anchor: anchor, focus: focus, reason: reason, value: value}
}
pub fn text_edit_of(event &Event) TextEditEvent {
    if event.kind < EV_TEXT_COMMIT || event.kind > EV_TEXT_SURROUNDING_DELETE { >> errors.new("ui: expected text edit event") }
    result := decode_text_edit(&event.menu_id) or >>
    if result.kind != event.kind || result.input.window_id != event.window_id || result.reason != event.width {
        >> errors.new("ui: inconsistent text edit event")
    }
    << result
}

fn push_text_edit_event(events chan Event, payload &string) {
    result := decode_text_edit(payload) or (err) { << }
    events <- Event{kind: result.kind, window_id: result.input.window_id, menu_id: payload + "", width: result.reason, height: 0}
}
