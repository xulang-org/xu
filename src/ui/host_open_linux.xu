@ui
$linux

#errors

// Compile-time: only included when target OS is Linux (`$linux`).
// Same-process xu_ui_host_run only (static-linked via pack / libxu_ui_host.a).
// Pack/oneexe uses in-process ":xu:" mailbox — no /tmp/xu_ui_* directory.

fn open_native_window(title string, width int, height int) int {
    pack := env_get("XU_UI_PACK") == "1" || env_get("XU_UI_WWW") == ":mem:"
    if pack {
        write_file(":xu:/xu_ui_title.txt", sanitize_title(title)) or >>
        write_file(":xu:/xu_ui_size.txt", str(width) + " " + str(height)) or >>
        code := ui_host_run("")
        if code == 0 {
            << 0
        }
        if code == 127 {
            >> errors.new("ui: host not linked (pack with scripts/pack_linux_ui_oneexe.py)")
        }
        >> errors.new("ui: linux host exited with error")
    }

    $dir := env_get("XU_UI_TMP")
    if dir.len == 0 {
        dir = tmp_dir()
    }
    write_file(dir + "/xu_ui_title.txt", sanitize_title(title)) or >>
    write_file(dir + "/xu_ui_size.txt", str(width) + " " + str(height)) or >>

    code := ui_host_run(dir)
    if code == 0 {
        << 0
    }
    if code == 127 {
        >> errors.new("ui: host not linked (pack with scripts/pack_linux_ui_oneexe.py)")
    }
    >> errors.new("ui: linux host exited with error")
}
