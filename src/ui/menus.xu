@ui

#errors
#strings
#encoding/hex
#unicode/utf8

pub const MENU_ACTION_KIND = 1
pub const MENU_SUBMENU_KIND = 2
pub const MENU_SEPARATOR_KIND = 3
pub const MENU_CHECK_KIND = 4
// Resolve to Command on macOS and Control elsewhere; combine with mod_shift/alt.
pub const MENU_PRIMARY = 16
pub struct MenuEntry {
    pub id string
    pub label string
    pub parent int
    pub kind int
    pub enabled bool
    pub checked bool
    pub key int
    pub modifiers int
}
pub fn menu_action(id string,label string,parent int) MenuEntry {
    << MenuEntry{id: id,label: label,parent: parent,kind: MENU_ACTION_KIND,enabled: true,checked: false,key: 0,modifiers: 0}
}
pub fn submenu(id string,label string,parent int) MenuEntry {
    << MenuEntry{id: id,label: label,parent: parent,kind: MENU_SUBMENU_KIND,enabled: true,checked: false,key: 0,modifiers: 0}
}
pub fn menu_check(id string,label string,parent int,checked bool) MenuEntry {
    mut entry := menu_action(id,label,parent)
    entry.kind = MENU_CHECK_KIND
    entry.checked = checked
    << entry
}
pub fn menu_separator(parent int) MenuEntry {
    << MenuEntry{id: "",label: "",parent: parent,kind: MENU_SEPARATOR_KIND,enabled: false,checked: false,key: 0,modifiers: 0}
}
// Parents are earlier entry indexes; -1 is the menu bar. This flat ownership
// model permits bounded trees without recursively copying menu structures.
pub fn encode_menu_entries(entries []MenuEntry) string {
    if entries.len > 256 { >> errors.new("ui: menu exceeds 256 entries") }
    mut result := "XUM1\n"
    mut depths := []int{}
    for i in 0:entries.len {
        entry := entries[i]
        if entry.kind < 1 || entry.kind > 4 || entry.parent < -1 || entry.parent >= i || entry.id.len > 64 || entry.label.len > 1024 || !utf8.valid(&entry.label) ||
           entry.modifiers < 0 || entry.modifiers > 31 || (entry.key != 0 && !((entry.key >= 32 && entry.key <= 126) || (entry.key >= KEY_F1 && entry.key < KEY_F1 + 12))) {
            >> errors.new("ui: invalid menu entry")
        }
        if target_os() == OS_WINDOWS && entry.key != 0 && (entry.modifiers & MOD_META) != 0 { >> errors.new("ui: Win32 menu shortcuts do not support the Meta key; use menu_primary") }
        mut depth := 1
        if entry.parent >= 0 {
            if entries[entry.parent].kind != MENU_SUBMENU_KIND { >> errors.new("ui: menu parent is not a submenu") }
            depth = depths[entry.parent] + 1
        } else if entry.kind != MENU_SUBMENU_KIND { >> errors.new("ui: menu-bar entries must be submenus") }
        if depth > 8 { >> errors.new("ui: menu nesting exceeds eight levels") }
        depths.push(depth)
        if entry.kind == MENU_SEPARATOR_KIND {
            if entry.id.len != 0 || entry.label.len != 0 || entry.checked || entry.key != 0 { >> errors.new("ui: invalid separator") }
        } else {
            if entry.id.len == 0 || entry.label.len == 0 { >> errors.new("ui: menu id and label are required") }
            for j in 0:entry.id.len { c := entry.id[j] & 255
                if !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45 || c == 46) { >> errors.new("ui: invalid menu id") } }
            for j in 0:i { if entries[j].id == entry.id { >> errors.new("ui: duplicate menu id") } }
            for j in 0:entry.label.len { if (entry.label[j] & 255) == 0 { >> errors.new("ui: menu label contains NUL") } }
        }
        if entry.checked && entry.kind != MENU_CHECK_KIND { >> errors.new("ui: checked state requires menu_check") }
        if entry.kind != MENU_ACTION_KIND && entry.kind != MENU_CHECK_KIND && (entry.checked || entry.key != 0 || entry.modifiers != 0) { >> errors.new("ui: only actions have shortcuts/check state") }
        mut flags := 0
        if entry.enabled { flags = flags | 1 }
        if entry.checked { flags = flags | 2 }
        result = result + str(entry.parent) + "\t" + str(entry.kind) + "\t" + str(flags) + "\t" + str(entry.key) + "\t" + str(entry.modifiers) + "\t" + hex.encode(&entry.id) + "\t" + hex.encode(&entry.label) + "\n"
        if result.len > 524288 { >> errors.new("ui: menu encoding exceeds limit") }
    }
    << result
}
// Replace the complete tree atomically at the next host turn. Checked items
// report an ordinary ev_menu_clicked; the model owns subsequent check state.
pub fn (window &Window) set_menu_entries(entries []MenuEntry) int {
    body := encode_menu_entries(entries) or >>
    window.write_slot("xu_ui_menu_v2.txt",body) or >>
    << window.command("menu_v2") or >>
}
