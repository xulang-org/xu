@ui

#errors
#strings
#strconv

pub const ev_canvas_preferences = 97
pub struct CanvasPreferences {
    pub identity CanvasEvent
    pub reduced_motion bool
}
pub fn request_canvas_preferences(identity &CanvasEvent) int {
    if identity.window_id <= 0 || identity.canvas_id <= 0 || identity.generation <= 0 {
        >> errors.new("ui: invalid canvas preference identity")
    }
    window := Window{id: identity.window_id,generation: identity.generation,title: "",width: 0,height: 0,
        content_kind: content_draw,content_backend_id: identity.canvas_id,closed: 0}
    << window.content_command("motion_preferences") or >>
}
fn decode_canvas_preferences(payload &string) CanvasPreferences {
    fields := strings.split(payload,"\t")
    if fields.len != 5 || fields[0] != "canvas_preferences" { >> errors.new("ui: invalid canvas preferences") }
    window := strconv.atoi(&fields[1]) or >>
    canvas := strconv.atoi(&fields[2]) or >>
    generation := strconv.atoi(&fields[3]) or >>
    if window <= 0 || window > 2147483647 || canvas <= 0 || canvas > 2147483647 ||
        generation <= 0 || generation > 4294967295 || (fields[4] != "0" && fields[4] != "1") {
        >> errors.new("ui: invalid canvas preference fields")
    }
    << CanvasPreferences{identity: CanvasEvent{window_id: window,canvas_id: canvas,generation: generation},reduced_motion: fields[4] == "1"}
}
pub fn canvas_preferences_of(event &Event) CanvasPreferences {
    if event.kind != ev_canvas_preferences { >> errors.new("ui: expected canvas preferences") }
    preferences := decode_canvas_preferences(&event.menu_id) or >>
    if preferences.identity.window_id != event.window_id { >> errors.new("ui: inconsistent canvas preference identity") }
    << preferences
}
