@ui

#errors
#strings
#strconv
#encoding/hex
#unicode/utf8

pub const EV_REQUEST = 85
pub const REQUEST_PROMPT = 1
pub const REQUEST_CLIPBOARD_READ = 2
pub const REQUEST_CLIPBOARD_WRITE = 3
pub const REQUEST_COMPLETED = 0
pub const REQUEST_CANCELLED = 1
pub const REQUEST_FAILED = 2
pub const REQUEST_UNSUPPORTED = 3
pub const REQUEST_TIMED_OUT = 4

pub struct PromptOptions {
    pub title string
    pub seed string
    pub timeout_ms int
}

// Desktop service timeout: zero selects 5000 ms.
pub struct RequestOptions {
    pub timeout_ms int
}

pub struct Request {
    pub id int
    pub window_id int
    pub canvas_id int
    pub generation int
    pub kind int
}

pub struct RequestResult {
    pub request Request
    pub status int
    pub value string
}

fn request_text_valid(text &string) bool {
    if text.len > 65536 || !utf8.valid(text) { << false }
    for i in 0:text.len { if (text[i] & 255) == 0 { << false } }
    << true
}

fn abandon_request(id int) {
    write_file(":xu:/__request_abandon", str(id)) or (err) { << }
}

// Resolve the current default canvas atomically. Explicit canvas_ready identities
// remain preferable when keeping contexts across window closure/recreation.
pub fn default_canvas() CanvasEvent {
    body := read_file(":xu:/__default_canvas") or >>
    fields := strings.split(&body, "\t")
    if body.len != 32 || fields.len != 3 { >> errors.new("ui: request host is not linked") }
    window := strconv.atoi(&fields[0]) or >>
    canvas := strconv.atoi(&fields[1]) or >>
    generation := strconv.atoi(&fields[2]) or >>
    if window <= 0 || window > 2147483647 || canvas <= 0 || canvas > 2147483647 ||
       generation <= 0 || generation > 4294967295 { >> errors.new("ui: default canvas is not open") }
    << CanvasEvent{window_id: window, canvas_id: canvas, generation: generation}
}

fn submit_request(target &CanvasEvent, kind int, title_text &string, seed_text &string, timeout_ms int, private_result int) Request {
    if target.window_id <= 0 || target.window_id > 2147483647 || target.canvas_id <= 0 ||
       target.canvas_id > 2147483647 || target.generation <= 0 || target.generation > 4294967295 {
        >> errors.new("ui: invalid request target")
    }
    if !request_text_valid(title_text) || !request_text_valid(seed_text) {
        >> errors.new("ui: request requires bounded UTF-8 without NUL")
    }
    mut timeout := timeout_ms
    if timeout == 0 { timeout = 5000 }
    if timeout < 1 || timeout > 3600000 { >> errors.new("ui: request timeout is outside 1...3600000 ms") }
    title := hex.encode(title_text)
    seed := hex.encode(seed_text)
    token := read_file(":xu:/__request_id") or >>
    if token.len != 20 { >> errors.new("ui: request host is not linked") }
    id := strconv.atoi(&token) or >>
    if id <= 0 { >> errors.new("ui: native request capacity is exhausted") }
    wire := str(id) + "\t" + str(target.window_id) + "\t" + str(target.canvas_id) + "\t" +
            str(target.generation) + "\t" + str(kind) + "\t" + str(timeout) + "\t" + str(private_result) + "\t" + title + "\t" + seed
    accepted := write_file(":xu:/__request_submit", wire) or (err) {
        abandon_request(id)
        >> errors.new("ui: request rejected (closed target, active prompt, or capacity limit)")
    }
    if accepted != wire.len {
        abandon_request(id)
        >> errors.new("ui: native request was not accepted")
    }
    << Request{id: id, window_id: target.window_id, canvas_id: target.canvas_id, generation: target.generation, kind: kind}
}

fn submit_prompt(target &CanvasEvent, options &PromptOptions, private_result int) Request {
    mut timeout := options.timeout_ms
    if timeout == 0 { timeout = 300000 }
    << submit_request(target, REQUEST_PROMPT, &options.title, &options.seed, timeout, private_result) or >>
}

// Clipboard text is UTF-8, at most 65536 bytes without NUL. Both operations
// finish through ev_request; an empty clipboard is a completed empty string.
// Cancellation reports a terminal result; it cannot undo a write already performed.
pub fn clipboard_read_async(target &CanvasEvent, options &RequestOptions) Request {
    empty := ""
    << submit_request(target, REQUEST_CLIPBOARD_READ, &empty, &empty, options.timeout_ms, 0) or >>
}

pub fn clipboard_write_async(target &CanvasEvent, text &string, options &RequestOptions) Request {
    empty := ""
    << submit_request(target, REQUEST_CLIPBOARD_WRITE, &empty, text, options.timeout_ms, 0) or >>
}

// Returns after admission. Completion arrives on the existing App event channel;
// empty confirmed text, cancellation, timeout, failure and unsupported are distinct.
pub fn prompt_async(target &CanvasEvent, options &PromptOptions) Request {
    << submit_prompt(target, options, 0) or >>
}

pub fn (request &Request) cancel() bool {
    if request.id <= 0 { << false }
    body := str(request.id)
    accepted := write_file(":xu:/__request_cancel", body) or (err) { << false }
    << accepted == body.len
}

fn decode_request(payload &string) RequestResult {
    mut line := payload + ""
    if line.len > 0 && (line[line.len - 1] & 255) == 10 { line = line[0:line.len - 1] }
    fields := strings.split(&line, "\t")
    if fields.len != 8 || fields[0] != "request" { >> errors.new("ui: invalid request result") }
    id := strconv.atoi(&fields[1]) or >>
    window := strconv.atoi(&fields[2]) or >>
    canvas := strconv.atoi(&fields[3]) or >>
    generation := strconv.atoi(&fields[4]) or >>
    kind := strconv.atoi(&fields[5]) or >>
    status := strconv.atoi(&fields[6]) or >>
    if id <= 0 || window <= 0 || window > 2147483647 || canvas <= 0 || canvas > 2147483647 ||
       generation <= 0 || generation > 4294967295 || (kind < REQUEST_PROMPT || kind > REQUEST_WEBVIEW_COOKIES_CLEAR) || status < 0 || status > REQUEST_TIMED_OUT ||
       fields[7].len > 131072 { >> errors.new("ui: invalid request result fields") }
    value := hex.decode(&fields[7]) or >>
    if !request_text_valid(&value) { >> errors.new("ui: invalid request result text") }
    << RequestResult{request: Request{id: id, window_id: window, canvas_id: canvas, generation: generation, kind: kind},
                     status: status, value: value}
}

pub fn request_of(event &Event) RequestResult {
    if event.kind != EV_REQUEST { >> errors.new("ui: expected request completion") }
    result := decode_request(&event.menu_id) or >>
    if result.request.window_id != event.window_id || result.status != event.width || result.request.kind != event.height {
        >> errors.new("ui: inconsistent request event")
    }
    << result
}

pub fn (result &RequestResult) matches(request &Request) bool {
    << result.request.id == request.id && result.request.window_id == request.window_id &&
       result.request.canvas_id == request.canvas_id && result.request.generation == request.generation && result.request.kind == request.kind
}

// Blocking compatibility wrapper. Its private result never drains App.event_ch,
// so menu, input and other windows' completion events remain available to the app.
pub fn prompt_wait(target &CanvasEvent, options &PromptOptions) RequestResult {
    request := submit_prompt(target, options, 1) or >>
    << wait_request(&request) or >>
}
fn wait_request(request &Request) RequestResult {
    path := ":xu:/__request_result/" + str(request.id)
    while true {
        body := read_file(path) or (err) {
            request.cancel()
            >> errors.new("ui: failed to read native request result")
        }
        if body.len > 0 {
            result := decode_request(&body) or >>
            if !result.matches(request) { >> errors.new("ui: request result identity mismatch") }
            << result
        }
        write_file(":xu:/__request_wait", str(request.id)) or (err) {
            request.cancel()
            >> errors.new("ui: native request ended without a result")
        }
    }
    >> errors.new("ui: native request did not complete")
}
