@ui

// Host → Xu shell events. The OS host appends lines to xu_ui_shell_event.txt;
// this package is the only drain. Apps read App.event_ch / poll_event().
// #ui/webview must not start a second drain (would steal events).

fn host_event_path() string {
    if ui_tmp() == ":xu:" {
        << ":xu:/__take_shell_event"
    }
    << ui_tmp() + "/xu_ui_shell_event.txt"
}

fn parse_int_token(s string) int {
    $n := 0
    $i := 0
    $neg := 0
    if s.len > 0 {
        if (s[0] & 255) == 45 {
            neg = 1
            i = 1
        }
    }
    while i < s.len {
        b := s[i] & 255
        if b < 48 || b > 57 {
            <-
        }
        n = n * 10 + (b - 48)
        i = i + 1
    }
    if neg == 1 {
        << 0 - n
    }
    << n
}

fn trim_shell_cr(s string) string {
    $out := s + ""
    while out.len > 0 {
        c := out[out.len - 1] & 255
        if c == 13 {
            out = out[0:out.len - 1]
        } else {
            <-
        }
    }
    << out
}

fn tab_rest(pl string, n int) string {
    if pl.len > n && (pl[n] & 255) == 9 {
        << pl[(n + 1):pl.len]
    }
    << pl + ""
}

fn window_event_number(token string,maximum int) int {
    if token.len == 0 || token.len > 10 { << 0 }
    $value := 0
    for i in 0:token.len {
        digit := (token[i] & 255) - 48
        if digit < 0 || digit > 9 || value > (maximum - digit) / 10 { << 0 }
        value = value * 10 + digit
    }
    << value
}

pub fn push_host_event(ech chan Event, pl0 string) {
    $pl := trim_shell_cr(pl0 + "")
    if pl.len >= 5 && pl[0:5] == "view\t" {
        native := decode_native_view_event(&pl) or (err) { << }
        ech <- Event{kind: EV_NATIVE_VIEW,window_id: native.identity.window_id,menu_id: pl,width: 0,height: 0}
        <<
    }
    $window_id := 0
    if pl.len > 7 && pl[0:7] == "window\t" {
        $first := 7
        while first < pl.len && (pl[first] & 255) != 9 { first = first + 1 }
        $second := first + 1
        while second < pl.len && (pl[second] & 255) != 9 { second = second + 1 }
        if first == 7 || second >= pl.len { << }
        window_id = window_event_number(pl[7:first],2147483647)
        if window_id <= 0 || window_event_number(pl[(first + 1):second],4294967295) <= 0 { << }
        pl = pl[(second + 1):pl.len]
    }
    if pl.len >= 10 && pl[0:10] == "text_edit\t" {
        push_text_edit_event(ech, &pl)
        <<
    }
    if pl.len >= 8 && pl[0:8] == "request\t" {
        result := decode_request(&pl) or (err) { << }
        ech <- Event{kind: EV_REQUEST, window_id: result.request.window_id, menu_id: pl, width: result.status, height: result.request.kind}
        <<
    }
    if pl.len >= 19 && pl[0:19] == "canvas_preferences\t" {
        preferences := decode_canvas_preferences(&pl) or (err) { << }
        ech <- Event{kind: EV_CANVAS_PREFERENCES,window_id: preferences.identity.window_id,menu_id: pl,width: 0,height: 0}
        <<
    }
    if pl.len >= 15 && pl[0:15] == "canvas_metrics\t" {
        metrics := decode_metrics(&pl) or (err) { << }
        ech <- Event{kind: EV_CANVAS_METRICS, window_id: metrics.window_id, menu_id: pl,
                     width: int(metrics.width), height: int(metrics.height)}
        <<
    }
    if (pl.len >= 6 && pl[0:6] == "input\t") || (pl.len >= 7 && pl[0:7] == "input2\t") {
        input := decode_input(&pl) or (err) { << }
        ech <- Event{kind: input.kind, window_id: input.window_id, menu_id: pl,
                     width: int(input.x), height: int(input.y)}
        <<
    }
    if (pl.len >= 13 && pl[0:13] == "canvas_ready\t") ||
       (pl.len >= 14 && pl[0:14] == "canvas_closed\t") {
        identity := decode_canvas(&pl) or (err) { << }
        $lifecycle := EV_CANVAS_CLOSED
        if pl[0:13] == "canvas_ready\t" { lifecycle = EV_CANVAS_READY }
        ech <- Event{kind: lifecycle, window_id: identity.window_id, menu_id: pl, width: 0, height: 0}
        <<
    }
    $kind := EV_NONE
    $mid := pl + ""
    $width := 0
    $height := 0
    if pl == "window_ready" {
        kind = EV_WINDOW_READY
        mid = pl0 + ""
    } else if pl == "window_failed" {
        kind = EV_WINDOW_FAILED
        mid = pl0 + ""
    } else if pl == "command_unsupported" {
        kind = EV_COMMAND_UNSUPPORTED
        mid = pl0 + ""
    } else if pl == "closed" {
        kind = EV_CLOSED
    } else if pl == "exit" {
        kind = EV_EXIT
    } else if pl == "close_requested" {
        kind = EV_CLOSE_REQUESTED
    } else if pl == "focused" {
        kind = EV_FOCUSED
    } else if pl == "blurred" {
        kind = EV_BLURRED
    } else if pl == "ready" {
        kind = EV_READY
    } else if pl == "loading" {
        kind = EV_LOADING
    } else if pl == "loaded" {
        kind = EV_LOADED
    } else if pl == "load_failed" {
        kind = EV_LOAD_FAILED
    } else if pl == "close_rejected" {
        kind = EV_CLOSE_REJECTED
    } else if pl == "cache_cleared" {
        kind = EV_CACHE_CLEARED
    } else if pl == "cookies_cleared" {
        kind = EV_COOKIES_CLEARED
    } else if pl.len >= 10 && pl[0:10] == "cookie_set" {
        kind = EV_COOKIE_SET
        mid = tab_rest(pl, 10)
    } else if pl.len >= 15 && pl[0:15] == "download_failed" {
        kind = EV_DOWNLOAD_FAILED
        mid = tab_rest(pl, 15)
    } else if pl.len >= 8 && pl[0:8] == "download" {
        kind = EV_DOWNLOAD
        mid = tab_rest(pl, 8)
    } else if pl.len >= 8 && pl[0:8] == "progress" && pl.len > 9 && (pl[8] & 255) == 9 {
        kind = EV_PROGRESS
        width = parse_int_token(pl[9:pl.len])
        mid = str(width)
    } else if pl.len >= 9 && pl[0:9] == "file_drop" {
        kind = EV_FILE_DROP
        mid = tab_rest(pl, 9)
    } else if pl.len >= 11 && pl[0:11] == "file_picked" {
        kind = EV_FILE_PICKED
        mid = tab_rest(pl, 11)
    } else if pl.len >= 10 && pl[0:10] == "file_saved" {
        kind = EV_FILE_SAVED
        mid = tab_rest(pl, 10)
    } else if pl.len >= 12 && pl[0:12] == "external_nav" {
        kind = EV_EXTERNAL_NAV
        mid = tab_rest(pl, 12)
    } else if pl.len >= 10 && pl[0:10] == "screenshot" {
        kind = EV_SCREENSHOT
        mid = tab_rest(pl, 10)
    } else if pl.len >= 13 && pl[0:13] == "folder_picked" {
        kind = EV_FOLDER_PICKED
        mid = tab_rest(pl, 13)
    } else if pl.len >= 5 && pl[0:5] == "alert" {
        kind = EV_ALERT
        mid = tab_rest(pl, 5)
    } else if pl.len >= 7 && pl[0:7] == "confirm" {
        kind = EV_CONFIRM
        mid = tab_rest(pl, 7)
    } else if pl.len >= 6 && pl[0:6] == "notify" {
        kind = EV_NOTIFY
        mid = tab_rest(pl, 6)
    } else if pl.len >= 9 && pl[0:9] == "clipboard" {
        kind = EV_CLIPBOARD
        mid = tab_rest(pl, 9)
    } else if pl.len >= 6 && pl[0:6] == "bounds" {
        kind = EV_BOUNDS
        mid = tab_rest(pl, 6)
    } else if pl.len >= 5 && pl[0:5] == "state" {
        kind = EV_STATE
        mid = tab_rest(pl, 5)
    } else if pl.len >= 17 && pl[0:17] == "tray_menu_clicked" {
        kind = EV_TRAY_MENU_CLICKED
        mid = tab_rest(pl, 17)
    } else if pl.len >= 12 && pl[0:12] == "menu_clicked" {
        kind = EV_MENU_CLICKED
        mid = tab_rest(pl, 12)
    } else if pl.len >= 6 && pl[0:5] == "click" && (pl[5] & 255) == 9 {
        kind = EV_CLICK
        $t1 := 6
        while t1 < pl.len {
            if (pl[t1] & 255) == 9 {
                <-
            }
            t1 = t1 + 1
        }
        if t1 < pl.len {
            width = parse_int_token(pl[6:t1])
            height = parse_int_token(pl[(t1 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 11 && pl[0:10] == "draw_click" && (pl[10] & 255) == 9 {
        kind = EV_CLICK
        $t2 := 11
        while t2 < pl.len {
            if (pl[t2] & 255) == 9 {
                <-
            }
            t2 = t2 + 1
        }
        if t2 < pl.len {
            width = parse_int_token(pl[11:t2])
            height = parse_int_token(pl[(t2 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 12 && pl[0:11] == "draw_scroll" && (pl[11] & 255) == 9 {
        kind = EV_SCROLL
        $ts := 12
        while ts < pl.len {
            if (pl[ts] & 255) == 9 {
                <-
            }
            ts = ts + 1
        }
        if ts < pl.len {
            width = parse_int_token(pl[12:ts])
            height = parse_int_token(pl[(ts + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 7 && pl[0:6] == "scroll" && (pl[6] & 255) == 9 {
        kind = EV_SCROLL
        $t3 := 7
        while t3 < pl.len {
            if (pl[t3] & 255) == 9 {
                <-
            }
            t3 = t3 + 1
        }
        if t3 < pl.len {
            width = parse_int_token(pl[7:t3])
            height = parse_int_token(pl[(t3 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 10 && pl[0:9] == "draw_drag" && (pl[9] & 255) == 9 {
        kind = EV_DRAG
        $td := 10
        while td < pl.len {
            if (pl[td] & 255) == 9 {
                <-
            }
            td = td + 1
        }
        if td < pl.len {
            width = parse_int_token(pl[10:td])
            height = parse_int_token(pl[(td + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 5 && pl[0:4] == "drag" && (pl[4] & 255) == 9 {
        kind = EV_DRAG
        $t4 := 5
        while t4 < pl.len {
            if (pl[t4] & 255) == 9 {
                <-
            }
            t4 = t4 + 1
        }
        if t4 < pl.len {
            width = parse_int_token(pl[5:t4])
            height = parse_int_token(pl[(t4 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len == 6 && pl[0:6] == "prompt" {
        kind = EV_PROMPT
        mid = ""
    } else if pl.len >= 7 && pl[0:6] == "prompt" && (pl[6] & 255) == 9 {
        kind = EV_PROMPT
        mid = pl[7:pl.len]
    } else if pl.len >= 12 && pl[0:11] == "draw_prompt" && (pl[11] & 255) == 9 {
        kind = EV_PROMPT
        mid = pl[12:pl.len]
    } else if pl.len > 8 {
        $tag := ""
        $sep := 0
        if pl[0:7] == "resized" && (pl[7] & 255) == 9 {
            kind = EV_RESIZED
            tag = "resized"
            sep = 7
        } else if pl.len > 6 && pl[0:5] == "moved" && (pl[5] & 255) == 9 {
            kind = EV_MOVED
            tag = "moved"
            sep = 5
        }
        if tag.len > 0 {
            $t1 := sep + 1
            while t1 < pl.len {
                if (pl[t1] & 255) == 9 {
                    <-
                }
                t1 = t1 + 1
            }
            if t1 < pl.len {
                width = parse_int_token(pl[(sep + 1):t1])
                height = parse_int_token(pl[(t1 + 1):pl.len])
                mid = str(width) + "x" + str(height)
            }
        }
    }
    if kind != EV_NONE {
        ech <- Event{kind: kind, window_id: window_id, menu_id: mid, width: width, height: height}
    }
}

fn drain_host_events_running(ech chan Event) bool {
    path := host_event_path()
    body := read_file(path) or (err) {
        << true
    }
    if body.len == 0 {
        << true
    }
    if ui_tmp() != ":xu:" {
        write_file(path, "") or (err) {
            << true
        }
    }
    $running := true
    $i := 0
    $start := 0
    while i < body.len {
        if (body[i] & 255) == 10 {
            if i > start {
                line := trim_shell_cr(body[start:i])
                if line == "exit" { running = false }
                push_host_event(ech,line)
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < body.len {
        line := trim_shell_cr(body[start:body.len])
        if line == "exit" { running = false }
        push_host_event(ech,line)
    }
    << running
}

pub fn drain_host_events(ech chan Event) {
    _ := drain_host_events_running(ech)
}

fn pump_host_events(ech chan Event) {
    while true {
        if !drain_host_events_running(ech) { << }
        if ui_tmp() == ":xu:" {
            // The native predicate checks again under its wake epoch, so an
            // event arriving after drain cannot be missed before parking.
            write_file(":xu:/__wait_nonempty", "xu_ui_shell_event.txt\t250") or (err) { sleep_ns(10000000)
                -> }
        } else { sleep_ns(10000000) }
    }
}

pub fn poll_chan(ech chan Event) Event {
    select {
        ev := <-ech {
            << ev
        }
        else {
            << Event{kind: EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}
        }
    }
    << Event{kind: EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}
}
