@ui

// Host → Xu shell events. The OS host appends lines to xu_ui_shell_event.txt;
// this package is the only drain. Apps read App.event_ch / poll_event().
// #ui/webview must not start a second drain (would steal events).

fn host_event_path() string {
    << ui_tmp() + "/xu_ui_shell_event.txt"
}

fn parse_int_token(s string) int {
    mut n := 0
    mut i := 0
    mut neg := 0
    if s.len > 0 {
        if (s[0] & 255) == 45 {
            neg = 1
            i = 1
        }
    }
    while i < s.len {
        b := s[i] & 255
        if b < 48 || b > 57 {
            <-
        }
        n = n * 10 + (b - 48)
        i = i + 1
    }
    if neg == 1 {
        << 0 - n
    }
    << n
}

fn trim_shell_cr(s string) string {
    mut out := s + ""
    while out.len > 0 {
        c := out[out.len - 1] & 255
        if c == 13 {
            out = out[0:out.len - 1]
        } else {
            <-
        }
    }
    << out
}

fn tab_rest(pl string, n int) string {
    if pl.len > n && (pl[n] & 255) == 9 {
        << pl[(n + 1):pl.len]
    }
    << pl + ""
}

pub fn push_host_event(ech chan Event, pl0 string) {
    pl := trim_shell_cr(pl0 + "")
    mut kind := ev_none
    mut mid := pl + ""
    mut width := 0
    mut height := 0
    if pl == "closed" {
        kind = ev_closed
    } else if pl == "exit" {
        kind = ev_exit
    } else if pl == "close_requested" {
        kind = ev_close_requested
    } else if pl == "focused" {
        kind = ev_focused
    } else if pl == "blurred" {
        kind = ev_blurred
    } else if pl == "ready" {
        kind = ev_ready
    } else if pl == "loading" {
        kind = ev_loading
    } else if pl == "loaded" {
        kind = ev_loaded
    } else if pl == "load_failed" {
        kind = ev_load_failed
    } else if pl == "close_rejected" {
        kind = ev_close_rejected
    } else if pl == "cache_cleared" {
        kind = ev_cache_cleared
    } else if pl == "cookies_cleared" {
        kind = ev_cookies_cleared
    } else if pl.len >= 10 && pl[0:10] == "cookie_set" {
        kind = ev_cookie_set
        mid = tab_rest(pl, 10)
    } else if pl.len >= 15 && pl[0:15] == "download_failed" {
        kind = ev_download_failed
        mid = tab_rest(pl, 15)
    } else if pl.len >= 8 && pl[0:8] == "download" {
        kind = ev_download
        mid = tab_rest(pl, 8)
    } else if pl.len >= 8 && pl[0:8] == "progress" && pl.len > 9 && (pl[8] & 255) == 9 {
        kind = ev_progress
        width = parse_int_token(pl[9:pl.len])
        mid = str(width)
    } else if pl.len >= 9 && pl[0:9] == "file_drop" {
        kind = ev_file_drop
        mid = tab_rest(pl, 9)
    } else if pl.len >= 11 && pl[0:11] == "file_picked" {
        kind = ev_file_picked
        mid = tab_rest(pl, 11)
    } else if pl.len >= 10 && pl[0:10] == "file_saved" {
        kind = ev_file_saved
        mid = tab_rest(pl, 10)
    } else if pl.len >= 12 && pl[0:12] == "external_nav" {
        kind = ev_external_nav
        mid = tab_rest(pl, 12)
    } else if pl.len >= 10 && pl[0:10] == "screenshot" {
        kind = ev_screenshot
        mid = tab_rest(pl, 10)
    } else if pl.len >= 13 && pl[0:13] == "folder_picked" {
        kind = ev_folder_picked
        mid = tab_rest(pl, 13)
    } else if pl.len >= 5 && pl[0:5] == "alert" {
        kind = ev_alert
        mid = tab_rest(pl, 5)
    } else if pl.len >= 7 && pl[0:7] == "confirm" {
        kind = ev_confirm
        mid = tab_rest(pl, 7)
    } else if pl.len >= 6 && pl[0:6] == "notify" {
        kind = ev_notify
        mid = tab_rest(pl, 6)
    } else if pl.len >= 9 && pl[0:9] == "clipboard" {
        kind = ev_clipboard
        mid = tab_rest(pl, 9)
    } else if pl.len >= 6 && pl[0:6] == "bounds" {
        kind = ev_bounds
        mid = tab_rest(pl, 6)
    } else if pl.len >= 5 && pl[0:5] == "state" {
        kind = ev_state
        mid = tab_rest(pl, 5)
    } else if pl.len >= 17 && pl[0:17] == "tray_menu_clicked" {
        kind = ev_tray_menu_clicked
        mid = tab_rest(pl, 17)
    } else if pl.len >= 12 && pl[0:12] == "menu_clicked" {
        kind = ev_menu_clicked
        mid = tab_rest(pl, 12)
    } else if pl.len >= 6 && pl[0:5] == "click" && (pl[5] & 255) == 9 {
        kind = ev_click
        mut t1 := 6
        while t1 < pl.len {
            if (pl[t1] & 255) == 9 {
                <-
            }
            t1 = t1 + 1
        }
        if t1 < pl.len {
            width = parse_int_token(pl[6:t1])
            height = parse_int_token(pl[(t1 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 11 && pl[0:10] == "draw_click" && (pl[10] & 255) == 9 {
        kind = ev_click
        mut t2 := 11
        while t2 < pl.len {
            if (pl[t2] & 255) == 9 {
                <-
            }
            t2 = t2 + 1
        }
        if t2 < pl.len {
            width = parse_int_token(pl[11:t2])
            height = parse_int_token(pl[(t2 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 12 && pl[0:11] == "draw_scroll" && (pl[11] & 255) == 9 {
        kind = ev_scroll
        mut ts := 12
        while ts < pl.len {
            if (pl[ts] & 255) == 9 {
                <-
            }
            ts = ts + 1
        }
        if ts < pl.len {
            width = parse_int_token(pl[12:ts])
            height = parse_int_token(pl[(ts + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 7 && pl[0:6] == "scroll" && (pl[6] & 255) == 9 {
        kind = ev_scroll
        mut t3 := 7
        while t3 < pl.len {
            if (pl[t3] & 255) == 9 {
                <-
            }
            t3 = t3 + 1
        }
        if t3 < pl.len {
            width = parse_int_token(pl[7:t3])
            height = parse_int_token(pl[(t3 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 10 && pl[0:9] == "draw_drag" && (pl[9] & 255) == 9 {
        kind = ev_drag
        mut td := 10
        while td < pl.len {
            if (pl[td] & 255) == 9 {
                <-
            }
            td = td + 1
        }
        if td < pl.len {
            width = parse_int_token(pl[10:td])
            height = parse_int_token(pl[(td + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len >= 5 && pl[0:4] == "drag" && (pl[4] & 255) == 9 {
        kind = ev_drag
        mut t4 := 5
        while t4 < pl.len {
            if (pl[t4] & 255) == 9 {
                <-
            }
            t4 = t4 + 1
        }
        if t4 < pl.len {
            width = parse_int_token(pl[5:t4])
            height = parse_int_token(pl[(t4 + 1):pl.len])
            mid = str(width) + "," + str(height)
        }
    } else if pl.len == 6 && pl[0:6] == "prompt" {
        kind = ev_prompt
        mid = ""
    } else if pl.len >= 7 && pl[0:6] == "prompt" && (pl[6] & 255) == 9 {
        kind = ev_prompt
        mid = pl[7:pl.len]
    } else if pl.len >= 12 && pl[0:11] == "draw_prompt" && (pl[11] & 255) == 9 {
        kind = ev_prompt
        mid = pl[12:pl.len]
    } else if pl.len > 8 {
        mut tag := ""
        mut sep := 0
        if pl[0:7] == "resized" && (pl[7] & 255) == 9 {
            kind = ev_resized
            tag = "resized"
            sep = 7
        } else if pl.len > 6 && pl[0:5] == "moved" && (pl[5] & 255) == 9 {
            kind = ev_moved
            tag = "moved"
            sep = 5
        }
        if tag.len > 0 {
            mut t1 := sep + 1
            while t1 < pl.len {
                if (pl[t1] & 255) == 9 {
                    <-
                }
                t1 = t1 + 1
            }
            if t1 < pl.len {
                width = parse_int_token(pl[(sep + 1):t1])
                height = parse_int_token(pl[(t1 + 1):pl.len])
                mid = str(width) + "x" + str(height)
            }
        }
    }
    if kind != ev_none {
        ech <- Event{kind: kind, window_id: 0, menu_id: mid, width: width, height: height}
    }
}

pub fn drain_host_events(ech chan Event) {
    path := host_event_path()
    body := read_file(path) or (err) {
        <<
    }
    if body.len == 0 {
        <<
    }
    write_file(path, "") or (err) {
        <<
    }
    mut i := 0
    mut start := 0
    while i < body.len {
        if (body[i] & 255) == 10 {
            if i > start {
                push_host_event(ech, body[start:i])
            }
            start = i + 1
        }
        i = i + 1
    }
    if start < body.len {
        push_host_event(ech, body[start:body.len])
    }
}

fn pump_host_events(ech chan Event) {
    while true {
        drain_host_events(ech)
        sleep_ns(10000000)
    }
}

pub fn poll_chan(ech chan Event) Event {
    select {
        ev := <-ech {
            << ev
        }
        else {
            << Event{kind: ev_none, window_id: 0, menu_id: "", width: 0, height: 0}
        }
    }
    << Event{kind: ev_none, window_id: 0, menu_id: "", width: 0, height: 0}
}
