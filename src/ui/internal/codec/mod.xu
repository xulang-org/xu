@ui/internal/codec

#math
#errors
#strings

// Internal UI wire scalars. Callers validate finite values and |v|<=1e9 before
// encoding; the frame hot path avoids doing the same checks twice.
pub fn finite_f64_bits(v f64) int {
    if v == 0.0 { << 0 }
    $mag := math.abs(v)
    $exp := 0
    // Coordinates are bounded to 1e9. Five exact power-of-two steps replace
    // up to 29 iterations on the usual positive exponent path.
    if mag >= 65536.0 { mag = mag / 65536.0
        exp = exp + 16 }
    if mag >= 256.0 { mag = mag / 256.0
        exp = exp + 8 }
    if mag >= 16.0 { mag = mag / 16.0
        exp = exp + 4 }
    if mag >= 4.0 { mag = mag / 4.0
        exp = exp + 2 }
    if mag >= 2.0 { mag = mag / 2.0
        exp = exp + 1 }
    while mag < 1.0 { mag = mag * 2.0
        exp = exp - 1 }
    $bits := 0
    if exp >= 0 - 1022 {
        bits = ((exp + 1023) << 52) | (int(mag * 4503599627370496.0) - 4503599627370496)
    } else {
        $shift := exp + 1074
        while shift > 0 { mag = mag * 2.0
            shift = shift - 1 }
        bits = int(mag)
    }
    if v < 0.0 { bits = bits | (1 << 63) }
    << bits
}

pub fn word(buffer $&strings.ByteBuilder, value int, size int) {
    for i in 0:size { buffer.write_byte((value >> (i * 8)) & 255) }
}

pub fn read_word32(data &string, offset int) int {
    $value := 0
    for i in 0:4 { value = value | ((data[offset + i] & 255) << (i * 8)) }
    << value
}

pub fn read_word64(data &string, offset int) int {
    << read_word32(data, offset) | (read_word32(data, offset + 4) << 32)
}

pub fn read_float64(data &string, offset int) f64 {
    lo := read_word32(data, offset)
    hi := read_word32(data, offset + 4)
    exponent := (hi >> 20) & 2047
    if exponent == 2047 { >> errors.new("ui: invalid native floating-point scalar") }
    fraction := ((hi & 1048575) << 32) | lo
    $value := 0.0
    if exponent == 0 { value = math.ldexp(f64(fraction), 0 - 1074) }
    else { value = math.ldexp(1.0 + f64(fraction) / 4503599627370496.0, exponent - 1023) }
    if (hi & 2147483648) != 0 { value = 0.0 - value }
    << value
}
