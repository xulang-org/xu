@ui/phone

#math
#ui/draw
#ui/layout

fn badge_bg(theme &Theme,tone int) draw.Color {
    if tone == BADGE_INFO { << theme.info_soft }
    if tone == BADGE_POSITIVE { << theme.positive_soft }
    if tone == BADGE_WARNING { << theme.warning_soft }
    if tone == BADGE_DANGER { << theme.danger_soft }
    << theme.elevated
}

fn badge_fg(theme &Theme,tone int) draw.Color {
    if tone == BADGE_INFO { << theme.info }
    if tone == BADGE_POSITIVE { << theme.positive }
    if tone == BADGE_WARNING { << theme.warning }
    if tone == BADGE_DANGER { << theme.danger }
    << theme.ink
}

fn enabled_color(color draw.Color,enabled bool) draw.Color {
    if enabled { << color }
    << color.with_alpha(120)
}

fn row_background(c $&Canvas,bounds layout.Rect,theme &Theme,pressed bool,enabled bool) int {
    if pressed && enabled {
        c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,14.0,theme.subtle_pressed) >>>
    }
    << 0
}

fn row_labels(c $&Canvas,bounds layout.Rect,theme &Theme,text_x f64,right_pad f64,title string,detail string,enabled bool) int {
    text_w := math.max(32.0,bounds.x + bounds.width - right_pad - text_x)
    title_color := enabled_color(theme.ink,enabled)
    detail_color := enabled_color(theme.muted,enabled)
    title_sz := scaled_font(15.0)
    detail_sz := scaled_font(13.0)
    title_h := math.max(22.0,math.ceil(title_sz * 1.4))
    detail_h := math.max(18.0,math.ceil(detail_sz * 1.35))
    if detail.len > 0 {
        c.label(rect(text_x,bounds.y + 11.0,text_w,title_h),title,title_sz,600,title_color,draw.TEXT_LEFT) >>>
        c.label(rect(text_x,bounds.y + 13.0 + title_h,text_w,detail_h),detail,detail_sz,400,detail_color,draw.TEXT_LEFT) >>>
        << 0
    }
    c.label(rect(text_x,bounds.y + (bounds.height - title_h) * 0.5,text_w,title_h),title,title_sz,600,title_color,draw.TEXT_LEFT) >>>
    << 0
}

pub fn (c $&Canvas) scrim(width f64,height f64,theme &Theme) int {
    << c.fill_rect(0.0,0.0,width,height,theme.scrim)
}

pub fn (c $&Canvas) divider(bounds layout.Rect,theme &Theme) int {
    y := bounds.y + bounds.height * 0.5
    << c.line(bounds.x,y,bounds.x + bounds.width,y,theme.border,1.0)
}

pub fn (c $&Canvas) toggle_switch(bounds layout.Rect,theme &Theme,checked bool,pressed bool,enabled bool) int {
    tw := switch_width()
    th := switch_height()
    tx := bounds.x + (bounds.width - tw) * 0.5
    ty := bounds.y + (bounds.height - th) * 0.5
    r := th * 0.5
    $track := theme.subtle
    if checked {
        track = theme.accent
        if pressed && enabled { track = theme.accent_pressed }
    } else if pressed && enabled {
        track = theme.subtle_pressed
    }
    c.fill_round_rect(tx,ty,tw,th,r,enabled_color(track,enabled)) >>>
    if !checked {
        c.stroke_round_rect(tx,ty,tw,th,r,enabled_color(theme.control_border,enabled),1.5) >>>
    }
    knob_r := r - 3.0
    $kx := tx + r
    if checked { kx = tx + tw - r }
    $knob := theme.muted
    if checked { knob = theme.on_accent } else if pressed && enabled { knob = theme.ink }
    c.fill_circle(kx,ty + r,knob_r,enabled_color(knob,enabled)) >>>
    << 0
}

pub fn (c $&Canvas) switch_row(bounds layout.Rect,theme &Theme,title string,detail string,checked bool,pressed bool,enabled bool) int {
    row_background(c,bounds,theme,pressed,enabled) >>>
    sw := switch_width()
    row_labels(c,bounds,theme,bounds.x + 16.0,16.0 + sw + 12.0,title,detail,enabled) >>>
    c.toggle_switch(rect(bounds.x + bounds.width - 16.0 - sw,bounds.y,sw,bounds.height),theme,checked,pressed,enabled) >>>
    << 0
}

pub fn (c $&Canvas) check_row(bounds layout.Rect,theme &Theme,title string,detail string,checked bool,pressed bool,enabled bool) int {
    row_background(c,bounds,theme,pressed,enabled) >>>
    box_size := 22.0
    bx := bounds.x + 16.0
    by := bounds.y + (bounds.height - box_size) * 0.5
    if checked {
        $fill := theme.accent
        if pressed && enabled { fill = theme.accent_pressed }
        c.fill_round_rect(bx,by,box_size,box_size,6.0,enabled_color(fill,enabled)) >>>
        c.icon(rect(bx + 3.0,by + 3.0,box_size - 6.0,box_size - 6.0),ICON_CHECK,enabled_color(theme.on_accent,enabled)) >>>
    } else {
        $fill := theme.surface
        if pressed && enabled { fill = theme.subtle_pressed }
        c.fill_round_rect(bx,by,box_size,box_size,6.0,enabled_color(fill,enabled)) >>>
        c.stroke_round_rect(bx,by,box_size,box_size,6.0,enabled_color(theme.control_border,enabled),2.0) >>>
    }
    row_labels(c,bounds,theme,bx + box_size + 12.0,16.0,title,detail,enabled) >>>
    << 0
}

pub fn (c $&Canvas) radio_row(bounds layout.Rect,theme &Theme,title string,detail string,selected bool,pressed bool,enabled bool) int {
    row_background(c,bounds,theme,pressed,enabled) >>>
    cx := bounds.x + 27.0
    cy := bounds.y + bounds.height * 0.5
    $bg := theme.surface
    if pressed && enabled { bg = theme.subtle_pressed }
    c.fill_circle(cx,cy,11.0,enabled_color(bg,enabled)) >>>
    if selected {
        $tone := theme.accent
        if pressed && enabled { tone = theme.accent_pressed }
        c.stroke_circle(cx,cy,11.0,enabled_color(tone,enabled),2.0) >>>
        c.fill_circle(cx,cy,6.0,enabled_color(tone,enabled)) >>>
    } else {
        c.stroke_circle(cx,cy,11.0,enabled_color(theme.control_border,enabled),2.0) >>>
    }
    row_labels(c,bounds,theme,cx + 23.0,16.0,title,detail,enabled) >>>
    << 0
}

pub fn (c $&Canvas) progress_bar(bounds layout.Rect,theme &Theme,value f64,tone int) int {
    th := math.max(4.0,math.min(bounds.height,progress_height()))
    ty := bounds.y + (bounds.height - th) * 0.5
    r := th * 0.5
    c.fill_round_rect(bounds.x,ty,bounds.width,th,r,theme.subtle) >>>
    pct := math.max(0.0,math.min(1.0,value))
    if pct > 0.0 && bounds.width > 0.0 {
        fill_w := math.min(bounds.width,math.max(th,bounds.width * pct))
        $fill := theme.accent
        if tone == BADGE_INFO { fill = theme.info } else if tone == BADGE_POSITIVE { fill = theme.positive } else if tone == BADGE_WARNING { fill = theme.warning } else if tone == BADGE_DANGER { fill = theme.danger }
        c.fill_round_rect(bounds.x,ty,fill_w,th,r,fill) >>>
    }
    << 0
}

pub fn (c $&Canvas) badge(bounds layout.Rect,theme &Theme,text string,tone int) int {
    r := bounds.height * 0.5
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,badge_bg(theme,tone)) >>>
    if tone == BADGE_NEUTRAL {
        c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,theme.border,1.0) >>>
    }
    c.label(bounds,text,scaled_font(12.0),600,badge_fg(theme,tone),draw.TEXT_CENTER) >>>
    << 0
}

pub fn (c $&Canvas) badge_count(bounds layout.Rect,theme &Theme,count int) int {
    if count <= 0 { << 0 }
    $label := str(count)
    if count > 99 { label = "99+" }
    r := bounds.height * 0.5
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,theme.accent) >>>
    c.label(bounds,label,scaled_font(11.0),700,theme.on_accent,draw.TEXT_CENTER) >>>
    << 0
}

pub fn (c $&Canvas) empty_state(bounds layout.Rect,theme &Theme,icon_kind int,title string,body string) int {
    c.card(bounds,theme) >>>
    title_sz := scaled_font(16.0)
    if bounds.height < 136.0 {
        body_sz := scaled_font(13.0)
        title_h := math.max(24.0,math.ceil(title_sz * 1.45))
        body_h := math.max(20.0,math.ceil(body_sz * 1.45))
        cy := bounds.y + bounds.height * 0.5
        c.fill_circle(bounds.x + 36.0,cy,18.0,theme.elevated) >>>
        c.icon(rect(bounds.x + 26.0,cy - 10.0,20.0,20.0),icon_kind,theme.muted) >>>
        text_w := math.max(40.0,bounds.width - 88.0)
        $title_y := bounds.y + (bounds.height - title_h) * 0.5
        if body.len > 0 { title_y = math.max(bounds.y + 12.0,cy - title_h) }
        c.label(rect(bounds.x + 72.0,title_y,text_w,title_h),title,title_sz,500,theme.ink,draw.TEXT_LEFT) >>>
        if body.len > 0 {
            c.label(rect(bounds.x + 72.0,title_y + title_h + 2.0,text_w,body_h),body,body_sz,400,theme.muted,draw.TEXT_LEFT) >>>
        }
        << 0
    }
    cx := bounds.x + bounds.width * 0.5
    c.fill_circle(cx,bounds.y + 38.0,20.0,theme.elevated) >>>
    c.icon(rect(cx - 10.0,bounds.y + 28.0,20.0,20.0),icon_kind,theme.muted) >>>
    c.label(rect(bounds.x + 20.0,bounds.y + 68.0,math.max(40.0,bounds.width - 40.0),24.0),title,title_sz,600,theme.ink,draw.TEXT_CENTER) >>>
    if body.len > 0 {
        body_sz := scaled_font(14.0)
        body_lh := math.max(20.0,math.ceil(body_sz * 1.4))
        c.paragraph(rect(bounds.x + 24.0,bounds.y + 96.0,math.max(40.0,bounds.width - 48.0),math.max(20.0,bounds.height - 108.0)),body,body_sz,400,body_lh,theme.muted,draw.TEXT_CENTER) >>>
    }
    << 0
}

pub fn (c $&Canvas) segmented(bounds layout.Rect,theme &Theme,labels &[]string,selected int,pressed_index int) int {
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,14.0,theme.elevated) >>>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,14.0,theme.border,1.0) >>>
    for i in 0:labels.len {
        seg := segmented_item_bounds(&bounds,labels.len,i)
        $fg := theme.ink
        $weight := 500
        if i == selected {
            c.fill_round_rect(seg.x,seg.y,seg.width,seg.height,10.0,theme.surface) >>>
            c.stroke_round_rect(seg.x,seg.y,seg.width,seg.height,10.0,theme.control_border,1.0) >>>
            fg = theme.accent
            weight = 700
        } else if i == pressed_index {
            c.fill_round_rect(seg.x,seg.y,seg.width,seg.height,10.0,theme.subtle_pressed) >>>
        }
        c.label(seg,labels[i],scaled_font(14.0),weight,fg,draw.TEXT_CENTER) >>>
    }
    << 0
}

pub fn (c $&Canvas) slider(bounds layout.Rect,theme &Theme,value f64,min_val f64,max_val f64,pressed bool,enabled bool) int {
    pad := slider_thumb() * 0.5
    tx := bounds.x + pad
    tw := math.max(1.0,bounds.width - 2.0 * pad)
    cy := bounds.y + bounds.height * 0.5
    $ratio := 0.0
    if max_val > min_val { ratio = math.max(0.0,math.min(1.0,(value - min_val) / (max_val - min_val))) }
    c.fill_round_rect(tx,cy - 3.0,tw,6.0,3.0,enabled_color(theme.subtle,enabled)) >>>
    if ratio > 0.0 {
        c.fill_round_rect(tx,cy - 3.0,math.max(6.0,tw * ratio),6.0,3.0,enabled_color(theme.accent,enabled)) >>>
    }
    kx := tx + tw * ratio
    if pressed && enabled {
        c.fill_circle(kx,cy,pad + 5.0,theme.accent_tint) >>>
    }
    $fill := theme.accent
    if pressed && enabled { fill = theme.accent_pressed }
    c.fill_circle(kx,cy,pad,enabled_color(fill,enabled)) >>>
    c.stroke_circle(kx,cy,pad,enabled_color(theme.surface,enabled),2.0) >>>
    << 0
}

pub fn (c $&Canvas) confirm_dialog(bounds layout.Rect,theme &Theme,title string,body string,cancel_label string,confirm_label string,danger bool,cancel_pressed bool,confirm_pressed bool) int {
    r := dialog_radius()
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,theme.surface) >>>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,theme.border,1.0) >>>
    c.label(rect(bounds.x + 20.0,bounds.y + 20.0,math.max(40.0,bounds.width - 40.0),26.0),title,scaled_font(18.0),700,theme.ink,draw.TEXT_LEFT) >>>
    body_sz := scaled_font(15.0)
    c.paragraph(rect(bounds.x + 20.0,bounds.y + 54.0,math.max(40.0,bounds.width - 40.0),math.max(24.0,bounds.height - 134.0)),body,body_sz,400,scaled_line(15.0),theme.muted,draw.TEXT_LEFT) >>>
    cancel_bounds := dialog_button_bounds(&bounds,0)
    confirm_bounds := dialog_button_bounds(&bounds,1)
    c.button_tone(cancel_bounds,theme,cancel_label,TONE_SECONDARY,cancel_pressed) >>>
    $tone := TONE_PRIMARY
    if danger { tone = TONE_DANGER }
    c.button_tone(confirm_bounds,theme,confirm_label,tone,confirm_pressed) >>>
    << 0
}

pub fn (c $&Canvas) app_bar(bounds layout.Rect,theme &Theme,title string,subtitle string,can_back bool,back_pressed bool,right_icon int,right_pressed bool) int {
    has_right := right_icon > 0
    if can_back {
        bb := app_bar_back_bounds(&bounds)
        $bfill := theme.surface
        if back_pressed { bfill = theme.subtle_pressed }
        c.fill_round_rect(bb.x,bb.y,bb.width,bb.height,16.0,bfill) >>>
        c.stroke_round_rect(bb.x,bb.y,bb.width,bb.height,16.0,theme.border,1.0) >>>
        c.icon(bb,ICON_BACK,theme.ink) >>>
    }
    if has_right {
        rb := app_bar_action_bounds(&bounds)
        $rfill := theme.surface
        if right_pressed { rfill = theme.subtle_pressed }
        c.fill_round_rect(rb.x,rb.y,rb.width,rb.height,16.0,rfill) >>>
        c.stroke_round_rect(rb.x,rb.y,rb.width,rb.height,16.0,theme.border,1.0) >>>
        c.icon(rb,right_icon,theme.ink) >>>
    }
    $left_pad := 0.0
    $right_pad := 0.0
    if can_back { left_pad = 60.0 }
    if has_right { right_pad = 60.0 }
    $align := draw.TEXT_LEFT
    if can_back && platform() == IOS {
        align = draw.TEXT_CENTER
        if right_pad < 60.0 { right_pad = 60.0 }
    }
    text_x := bounds.x + left_pad
    text_w := math.max(64.0,bounds.width - left_pad - right_pad)
    title_sz := scaled_font(22.0)
    sub_sz := scaled_font(12.0)
    if subtitle.len > 0 {
        c.label(rect(text_x,bounds.y + 4.0,text_w,30.0),title,title_sz,700,theme.ink,align) >>>
        c.label(rect(text_x,bounds.y + 34.0,text_w,20.0),subtitle,sub_sz,400,theme.muted,align) >>>
    } else {
        c.label(rect(text_x,bounds.y + math.max(0.0,(bounds.height - 32.0) * 0.5),text_w,32.0),title,title_sz,700,theme.ink,align) >>>
    }
    << 0
}

pub fn (c $&Canvas) fab(bounds layout.Rect,theme &Theme,icon_kind int,label string,pressed bool) int {
    $fill := theme.accent
    if pressed { fill = theme.accent_pressed }
    r := math.min(18.0,math.min(bounds.width,bounds.height) * 0.5)
    if label.len == 0 {
        circle_r := math.min(bounds.width,bounds.height) * 0.5
        c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,circle_r,fill) >>>
        c.icon(bounds,icon_kind,theme.on_accent) >>>
        << 0
    }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,fill) >>>
    c.icon(rect(bounds.x + 12.0,bounds.y + (bounds.height - 24.0) * 0.5,24.0,24.0),icon_kind,theme.on_accent) >>>
    c.label(rect(bounds.x + 44.0,bounds.y,math.max(24.0,bounds.width - 58.0),bounds.height),label,scaled_font(15.0),600,theme.on_accent,draw.TEXT_LEFT) >>>
    << 0
}

pub fn (c $&Canvas) section_header(bounds layout.Rect,theme &Theme,title string,action_label string) int {
    $action_w := 0.0
    hdr_sz := scaled_font(13.0)
    if action_label.len > 0 {
        action_w = math.min(96.0,bounds.width * 0.35)
        c.label(rect(bounds.x + bounds.width - action_w,bounds.y,action_w,bounds.height),action_label,hdr_sz,600,theme.accent,draw.TEXT_RIGHT) >>>
    }
    c.label(rect(bounds.x,bounds.y,math.max(40.0,bounds.width - action_w - 8.0),bounds.height),title,hdr_sz,600,theme.muted,draw.TEXT_LEFT) >>>
    << 0
}

pub fn (c $&Canvas) list_tile(bounds layout.Rect,theme &Theme,title string,detail string,trailing string,icon_kind int,chevron bool,pressed bool) int {
    row_background(c,bounds,theme,pressed,true) >>>
    $left_x := bounds.x + 16.0
    if icon_kind > 0 {
        c.fill_round_rect(bounds.x + 12.0,bounds.y + (bounds.height - 40.0) * 0.5,40.0,40.0,13.0,theme.accent_tint) >>>
        c.icon(rect(bounds.x + 12.0,bounds.y + (bounds.height - 40.0) * 0.5,40.0,40.0),icon_kind,theme.accent) >>>
        left_x = bounds.x + 64.0
    }
    $right_pad := 16.0
    if chevron {
        c.icon(rect(bounds.x + bounds.width - 36.0,bounds.y + (bounds.height - 24.0) * 0.5,24.0,24.0),ICON_CHEVRON,theme.muted) >>>
        right_pad += 28.0
    }
    if trailing.len > 0 {
        tw := math.min(96.0,math.max(40.0,bounds.width * 0.28))
        c.label(rect(bounds.x + bounds.width - right_pad - tw,bounds.y,tw,bounds.height),trailing,scaled_font(13.0),500,theme.muted,draw.TEXT_RIGHT) >>>
        right_pad += tw + 8.0
    }
    row_labels(c,bounds,theme,left_x,right_pad,title,detail,true) >>>
    << 0
}

pub fn (c $&Canvas) search_bar(bounds layout.Rect,theme &Theme,query string,placeholder string,focused bool,pressed bool,clear_pressed bool) int {
    r := math.min(18.0,bounds.height * 0.5)
    $fill := theme.elevated
    if pressed { fill = theme.subtle_pressed }
    $stroke := theme.border
    $stroke_w := 1.0
    if focused {
        stroke = theme.focus
        stroke_w = 2.0
    }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,fill) >>>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,stroke,stroke_w) >>>
    c.icon(rect(bounds.x + 8.0,bounds.y,36.0,bounds.height),ICON_SEARCH,theme.muted) >>>
    clear_box := search_bar_clear_bounds(&bounds)
    $right_pad := 16.0
    if query.len > 0 && clear_box.width > 0.0 {
        right_pad = clear_box.width + 4.0
    }
    text_x := bounds.x + 44.0
    text_w := math.max(24.0,bounds.x + bounds.width - right_pad - text_x)
    $shown := placeholder
    $fg := theme.muted
    if query.len > 0 {
        shown = query
        fg = theme.ink
    }
    c.label(rect(text_x,bounds.y,text_w,bounds.height),shown,scaled_font(15.0),400,fg,draw.TEXT_LEFT) >>>
    if query.len > 0 && clear_box.width > 0.0 {
        if clear_pressed {
            c.fill_round_rect(clear_box.x + 4.0,clear_box.y + 4.0,clear_box.width - 8.0,clear_box.height - 8.0,12.0,theme.subtle_pressed) >>>
        }
        c.icon(clear_box,ICON_CLOSE,theme.muted) >>>
    }
    << 0
}

pub fn (c $&Canvas) action_sheet(shell &Scaffold,theme &Theme,bounds layout.Rect,title string,items &[]ActionSheetItem,cancel_label string,pressed_id int,cancel_id int) int {
    c.fill_rect(0.0,0.0,shell.width,shell.height,theme.scrim) >>>
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,28.0,theme.surface) >>>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,28.0,theme.border,1.0) >>>
    if bounds.height >= 28.0 {
        c.fill_rect(bounds.x,bounds.y + bounds.height - 28.0,bounds.width,28.0,theme.surface) >>>
    }
    c.fill_round_rect(bounds.x + (bounds.width - 36.0) * 0.5,bounds.y + 10.0,36.0,4.0,2.0,theme.border) >>>
    has_title := title.len > 0
    if has_title {
        c.label(rect(bounds.x + 20.0,bounds.y + 20.0,math.max(40.0,bounds.width - 40.0),36.0),title,scaled_font(13.0),600,theme.muted,draw.TEXT_CENTER) >>>
        c.divider(rect(bounds.x + 16.0,bounds.y + 60.0,math.max(0.0,bounds.width - 32.0),1.0),theme) >>>
    }
    for i in 0:items.len {
        item := &items[i]
        row := action_sheet_item_bounds(&bounds,has_title,i)
        if item.id == pressed_id && pressed_id > 0 {
            c.fill_round_rect(row.x,row.y + 2.0,row.width,row.height - 4.0,14.0,theme.subtle_pressed) >>>
        }
        $fg := theme.ink
        if item.destructive { fg = theme.danger }
        $lx := row.x + 12.0
        if item.icon > 0 {
            c.icon(rect(row.x + 8.0,row.y,32.0,row.height),item.icon,fg) >>>
            lx = row.x + 44.0
        }
        c.label(rect(lx,row.y,math.max(24.0,row.x + row.width - lx - 12.0),row.height),item.label + "",scaled_font(16.0),600,fg,draw.TEXT_LEFT) >>>
        if i + 1 < items.len {
            c.divider(rect(row.x + 8.0,row.y + row.height,math.max(0.0,row.width - 16.0),1.0),theme) >>>
        }
    }
    if cancel_label.len > 0 {
        cb := action_sheet_cancel_bounds(&bounds,items.len,has_title)
        cancel_pressed := cancel_id > 0 && pressed_id == cancel_id
        c.button_tone(cb,theme,cancel_label,TONE_SECONDARY,cancel_pressed) >>>
    }
    << 0
}

pub fn (c $&Canvas) spinner(bounds layout.Rect,theme &Theme,phase f64,reduced bool) int {
    size := math.min(bounds.width,bounds.height)
    if size <= 4.0 { << 0 }
    cx := bounds.x + bounds.width * 0.5
    cy := bounds.y + bounds.height * 0.5
    ring_r := size * 0.34
    base_dot := math.max(1.5,size * 0.09)
    $head := 0.0
    if !reduced && finite(phase) {
        head = (phase - math.floor(phase)) * 8.0
    }
    for i in 0:8 {
        ang := f64(i) * 0.78539816339
        dx := cx + math.cos(ang) * ring_r
        dy := cy + math.sin(ang) * ring_r
        $alpha := 160
        $dot_r := base_dot
        if !reduced {
            $dist := head - f64(i)
            while dist < 0.0 { dist += 8.0 }
            while dist >= 8.0 { dist -= 8.0 }
            factor := math.max(0.0,1.0 - dist / 6.5)
            alpha = 55 + int(200.0 * factor)
            dot_r = base_dot * (0.75 + 0.45 * factor)
        }
        c.fill_circle(dx,dy,dot_r,theme.accent.with_alpha(alpha)) >>>
    }
    << 0
}

pub fn (c $&Canvas) skeleton_block(bounds layout.Rect,theme &Theme,radius f64,phase f64,reduced bool) int {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { << 0 }
    r := math.min(math.max(0.0,radius),math.min(bounds.width,bounds.height) * 0.5)
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,theme.elevated) >>>
    if !reduced && finite(phase) {
        pulse := 0.5 + 0.5 * math.sin(phase * 6.28318530718)
        alpha := 35 + int(90.0 * pulse)
        c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,r,theme.surface.with_alpha(alpha)) >>>
    }
    << 0
}

pub fn (c $&Canvas) edge_back_indicator(shell &Scaffold,theme &Theme,progress f64,reduced bool) int {
    if !finite(progress) || progress <= 0.01 { << 0 }
    p := math.max(0.0,math.min(1.0,progress))
    $w := 36.0 + p * 16.0
    if reduced { w = 44.0 }
    h := 52.0
    y := shell.body.y + math.max(0.0,(shell.body.height - h) * 0.5)
    x := shell.safe.left
    ready := p >= 0.45
    $bg := theme.surface
    $fg := theme.ink
    if ready {
        bg = theme.accent
        fg = theme.on_accent
    }
    c.fill_round_rect(x,y,w,h,20.0,bg) >>>
    if !ready {
        c.stroke_round_rect(x,y,w,h,20.0,theme.border,1.0) >>>
    }
    c.fill_rect(x,y,10.0,h,bg) >>>
    c.icon(rect(x + 6.0,y,w - 8.0,h),ICON_BACK,fg) >>>
    << 0
}
