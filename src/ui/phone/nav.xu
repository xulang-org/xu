@ui/phone

#math
#time

pub const MAX_ROUTE_DEPTH = 16

pub struct Route {
    pub id int
    pub arg int
    pub title string
}

// Single-source navigation stack aligned with Flutter's Navigator / PopScope.
pub struct RouteStack {
    routes []Route
    pub drag_progress f64
    pub edge_swiping bool
}

pub fn route_stack(root_id int,root_title string) RouteStack {
    << RouteStack{
        routes: [Route{id: root_id,arg: 0,title: root_title}],
        drag_progress: 0.0,
        edge_swiping: false
    }
}

pub fn (s &RouteStack) depth() int {
    << s.routes.len
}

pub fn (s &RouteStack) can_pop() bool {
    << s.routes.len > 1
}

pub fn (s &RouteStack) top() Route {
    if s.routes.len == 0 { << Route{id: 0,arg: 0,title: ""} }
    idx := s.routes.len - 1
    << Route{id: s.routes[idx].id,arg: s.routes[idx].arg,title: ~s.routes[idx].title}
}

pub fn (s &RouteStack) previous() Route {
    if s.routes.len < 2 { << s.top() }
    idx := s.routes.len - 2
    << Route{id: s.routes[idx].id,arg: s.routes[idx].arg,title: ~s.routes[idx].title}
}

pub fn (s $&RouteStack) reset(root_id int,root_title string) {
    s.routes = [Route{id: root_id,arg: 0,title: root_title}]
    s.drag_progress = 0.0
    s.edge_swiping = false
}

pub fn (s $&RouteStack) push(id int,arg int,title string) bool {
    if s.routes.len >= MAX_ROUTE_DEPTH { << false }
    s.routes.push(Route{id: id,arg: arg,title: title})
    s.drag_progress = 0.0
    s.edge_swiping = false
    << true
}

fn (s $&RouteStack) trim_to(new_len int) {
    $next := []Route{}
    for i in 0:new_len {
        next.push(Route{id: s.routes[i].id,arg: s.routes[i].arg,title: ~s.routes[i].title})
    }
    s.routes = next
    s.drag_progress = 0.0
    s.edge_swiping = false
}

pub fn (s $&RouteStack) pop() bool {
    s.drag_progress = 0.0
    s.edge_swiping = false
    if s.routes.len <= 1 { << false }
    s.trim_to(s.routes.len - 1)
    << true
}

pub fn (s $&RouteStack) pop_to_root() int {
    $removed := 0
    if s.routes.len > 1 {
        removed = s.routes.len - 1
        s.trim_to(1)
    }
    s.drag_progress = 0.0
    s.edge_swiping = false
    << removed
}

pub fn (s $&RouteStack) set_drag(progress f64,active bool) {
    clamped := math.max(0.0,math.min(1.0,progress))
    s.drag_progress = clamped
    s.edge_swiping = active
}

// Timed transient feedback strip positioned above bottom navigation / IME.
pub struct Snackbar {
    pub active bool
    pub message string
    pub action_label string
    pub action_id int
    pub deadline_ns int
}

pub fn snackbar_empty() Snackbar {
    << Snackbar{active: false,message: "",action_label: "",action_id: 0,deadline_ns: 0}
}

pub fn (b $&Snackbar) show_at(message string,action_id int,action_label string,duration_ms int,now_ns int) {
    $ms := duration_ms
    if ms <= 0 { ms = 3200 }
    if ms < 1000 { ms = 1000 }
    b.active = true
    b.message = message
    b.action_id = action_id
    b.action_label = action_label
    b.deadline_ns = now_ns + ms * 1000000
}

pub fn (b $&Snackbar) show(message string,action_id int,action_label string,duration_ms int) {
    b.show_at(message,action_id,action_label,duration_ms,time.now())
}

pub fn (b $&Snackbar) dismiss() {
    b.active = false
    b.message = ""
    b.action_label = ""
    b.action_id = 0
    b.deadline_ns = 0
}

pub fn (b &Snackbar) remaining_ms(now_ns int) int {
    if !b.active { << 0 }
    diff := b.deadline_ns - now_ns
    if diff <= 0 { << 0 }
    << (diff + 999999) / 1000000
}

pub fn (b $&Snackbar) tick(now_ns int) bool {
    if !b.active { << false }
    if now_ns < b.deadline_ns { << false }
    b.dismiss()
    << true
}
