@ui/phone

#os

pub const NONE = 0
pub const IOS = 1
pub const ANDROID = 2

// Phone applications retain the Darwin/Linux runtime ABI. Query the application
// platform here rather than inferring it from xu_target_os().
pub fn platform() int {
    value := os.getenv("XU_PHONE_OS")
    if value == "ios" { << IOS }
    if value == "android" { << ANDROID }
    << NONE
}

pub fn available() bool {
    << platform() != NONE
}

// Capture Android Back only while a sheet/detail route can handle it. At the
// root, the native Activity sends the task to the background as usual.
pub fn set_back_enabled(enabled bool) int {
    $value := "0"
    if enabled { value = "1" }
    os.write(":xu:/phone_back_enabled",value) or >>
    << 0
}

// Match system status/navigation bars and safe-area backgrounds to the theme.
pub fn set_dark_appearance(dark bool) int {
    $value := "0"
    if dark { value = "1" }
    os.write(":xu:/phone_dark",value) or >>
    << 0
}

// Extend a bottom sheet's scrim and surface through the native safe areas.
pub fn set_overlay(visible bool) int {
    $value := "0"
    if visible { value = "1" }
    os.write(":xu:/phone_overlay",value) or >>
    << 0
}
