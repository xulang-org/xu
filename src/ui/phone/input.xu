@ui/phone

#ui
#ui/layout
#math
#errors
#time

pub const DRAG_NONE = 0
pub const DRAG_VERTICAL = 1
pub const DRAG_HORIZONTAL = 2
const TOUCH_SLOP = 8
const EDGE_BACK_ZONE = 28
const MAX_OVERSCROLL = 88

struct TouchTarget { id int
    bounds layout.Rect }

// Targets are registered in paint order. Later targets win, so a modal can
// block its entire surface with id=0 and register only its own actions above it.
pub struct Touch {
    targets []TouchTarget
    window int
    canvas int
    generation int
    down bool
    armed int
    active int
    start_x f64
    start_y f64
    cur_x f64
    cur_y f64
    last_x f64
    last_y f64
    last_time_ns int
    velocity_x f64
    velocity_y f64
    start_scroll f64
    dragged bool
    drag_axis int
    swallowed_tap bool
    scrollable bool
    bouncing bool
    flinging bool
    anim_ns int
    edge_back_enabled bool
    edge_left f64
    scroll_bounds layout.Rect
    scroll f64
    overscroll f64
    maximum f64
}

pub fn touch(identity &ui.CanvasEvent) Touch {
    << Touch{targets: []TouchTarget{},window: identity.window_id,canvas: identity.canvas_id,
        generation: identity.generation,down: false,armed: 0,active: 0,start_x: 0.0,start_y: 0.0,
        cur_x: 0.0,cur_y: 0.0,last_x: 0.0,last_y: 0.0,last_time_ns: 0,velocity_x: 0.0,velocity_y: 0.0,
        start_scroll: 0.0,dragged: false,drag_axis: DRAG_NONE,swallowed_tap: false,scrollable: false,
        bouncing: platform() == IOS,flinging: false,anim_ns: 0,edge_back_enabled: false,edge_left: 0.0,
        scroll_bounds: rect(0.0,0.0,0.0,0.0),scroll: 0.0,overscroll: 0.0,maximum: 0.0}
}

pub fn (t $&Touch) set_bouncing(enabled bool) { t.bouncing = enabled }
pub fn (t $&Touch) set_edge_back(enabled bool,safe_left f64) {
    t.edge_back_enabled = enabled
    t.edge_left = math.max(0.0,safe_left)
}
pub fn (t $&Touch) begin() { t.targets = []TouchTarget{} }
pub fn (t $&Touch) target(id int,bounds layout.Rect) int {
    if id < 0 || t.targets.len >= 128 || !finite(bounds.x) || !finite(bounds.y) ||
       !finite(bounds.width) || !finite(bounds.height) || bounds.width < 0.0 || bounds.height < 0.0 {
        >> errors.new("phone: invalid or excessive touch targets") }
    if bounds.width > 0.0 && bounds.height > 0.0 { t.targets.push(TouchTarget{id: id,bounds: bounds}) }
    << 0
}
pub fn (t &Touch) pressed(id int) bool { << t.down && !t.dragged && !t.swallowed_tap && t.active == id && id > 0 }
pub fn (t &Touch) offset() f64 { << t.scroll + t.overscroll }
pub fn (t &Touch) scroll_offset() f64 { << t.scroll }
pub fn (t &Touch) scroll_maximum() f64 { << t.maximum }
pub fn (t &Touch) animating() bool { << t.flinging || math.abs(t.overscroll) > 0.25 }
pub fn (t &Touch) edge_swipe_progress(width f64) f64 {
    if !t.down || !t.edge_back_enabled || t.drag_axis != DRAG_HORIZONTAL || t.start_x > t.edge_left + f64(EDGE_BACK_ZONE) { << 0.0 }
    span := math.max(120.0,width * 0.6)
    << math.max(0.0,math.min(1.0,(t.cur_x - t.start_x) / span))
}
// A modal blocks the scroll gesture without discarding the underlying offset.
pub fn (t $&Touch) block_scroll() { t.scrollable = false
    t.flinging = false
    t.velocity_y = 0.0
    t.overscroll = 0.0
    t.scroll_bounds = rect(0.0,0.0,0.0,0.0) }
pub fn (t $&Touch) cancel() { t.down = false
    t.active = 0
    t.armed = 0
    t.dragged = false
    t.drag_axis = DRAG_NONE
    t.swallowed_tap = false
    t.velocity_x = 0.0
    t.velocity_y = 0.0 }
pub fn (t $&Touch) reset_scroll() { t.cancel()
    t.flinging = false
    t.overscroll = 0.0
    t.scroll = 0.0 }
pub fn (t $&Touch) scroll_region(bounds layout.Rect,content_height f64) int {
    if !finite(content_height) || content_height < 0.0 { >> errors.new("phone: invalid scroll extent") }
    t.scroll_bounds = bounds
    t.maximum = math.max(0.0,content_height - bounds.height)
    t.scroll = math.max(0.0,math.min(t.scroll,t.maximum))
    if t.maximum <= 0.0 && !t.down {
        t.overscroll = 0.0
        t.flinging = false
        t.velocity_y = 0.0
    }
    << 0
}
fn (t &Touch) hit(x f64,y f64) int {
    $i := t.targets.len
    while i > 0 { i -= 1
        if t.targets[i].bounds.contains(x,y) { << t.targets[i].id } }
    << 0
}

fn (t $&Touch) apply_vertical_scroll(raw f64) {
    if !t.bouncing {
        t.scroll = math.max(0.0,math.min(t.maximum,raw))
        t.overscroll = 0.0
        <<
    }
    if raw < 0.0 {
        t.scroll = 0.0
        t.overscroll = 0.0 - f64(MAX_OVERSCROLL) * (1.0 - math.exp(raw / 220.0))
    } else if raw > t.maximum {
        t.scroll = t.maximum
        t.overscroll = f64(MAX_OVERSCROLL) * (1.0 - math.exp((t.maximum - raw) / 220.0))
    } else {
        t.scroll = raw
        t.overscroll = 0.0
    }
}

fn (t $&Touch) motion(x f64,y f64,now_ns int) {
    if now_ns > t.last_time_ns && t.last_time_ns > 0 {
        dt_ns := now_ns - t.last_time_ns
        if dt_ns > 0 && dt_ns <= 200000000 {
            dt := f64(dt_ns) / 1000000000.0
            inst_vx := (x - t.last_x) / dt
            inst_vy := (t.last_y - y) / dt
            if math.abs(t.velocity_x) < 1.0 && math.abs(t.velocity_y) < 1.0 {
                t.velocity_x = inst_vx
                t.velocity_y = inst_vy
            } else {
                t.velocity_x = t.velocity_x * 0.35 + inst_vx * 0.65
                t.velocity_y = t.velocity_y * 0.35 + inst_vy * 0.65
            }
        }
    }
    t.last_x = x
    t.last_y = y
    t.cur_x = x
    t.cur_y = y
    if now_ns > 0 { t.last_time_ns = now_ns }
    dx := math.abs(x - t.start_x)
    dy := math.abs(y - t.start_y)
    if !t.dragged && (dx > f64(TOUCH_SLOP) || dy > f64(TOUCH_SLOP)) {
        t.dragged = true
        if t.edge_back_enabled && t.start_x <= t.edge_left + f64(EDGE_BACK_ZONE) && dx > dy * 1.15 && x > t.start_x {
            t.drag_axis = DRAG_HORIZONTAL
        } else if t.scrollable && dy >= dx {
            t.drag_axis = DRAG_VERTICAL
        }
    }
    if t.drag_axis == DRAG_VERTICAL && t.scrollable {
        t.apply_vertical_scroll(t.start_scroll + t.start_y - y)
    }
    if t.dragged || t.swallowed_tap { t.active = 0 }
    else { t.active = t.hit(x,y) }
}

pub fn (t $&Touch) step_at(now_ns int) bool {
    if t.down { << false }
    if !t.flinging && math.abs(t.overscroll) < 0.25 {
        t.overscroll = 0.0
        << false
    }
    if !t.scrollable && math.abs(t.overscroll) < 0.25 {
        t.flinging = false
        t.velocity_y = 0.0
        t.overscroll = 0.0
        << false
    }
    $dt := 0.016
    if t.anim_ns > 0 && now_ns > t.anim_ns {
        dt = math.min(0.05,math.max(0.001,f64(now_ns - t.anim_ns) / 1000000000.0))
    }
    t.anim_ns = now_ns
    if t.overscroll != 0.0 {
        if (t.overscroll < 0.0 && t.velocity_y < -40.0) || (t.overscroll > 0.0 && t.velocity_y > 40.0) {
            t.overscroll = math.max(0.0 - f64(MAX_OVERSCROLL),math.min(f64(MAX_OVERSCROLL),t.overscroll + t.velocity_y * dt * 0.28))
            t.velocity_y *= math.exp(-15.0 * dt)
        } else {
            t.overscroll *= math.exp(-11.0 * dt)
            t.velocity_y *= math.exp(-12.0 * dt)
        }
        if math.abs(t.overscroll) < 0.35 && math.abs(t.velocity_y) < 18.0 {
            t.overscroll = 0.0
            t.velocity_y = 0.0
            t.flinging = false
            << true
        }
        << true
    }
    next_scroll := t.scroll + t.velocity_y * dt
    t.velocity_y *= math.exp(-3.4 * dt)
    if next_scroll < 0.0 {
        t.scroll = 0.0
        if t.bouncing {
            t.overscroll = math.max(0.0 - f64(MAX_OVERSCROLL),next_scroll * 0.35)
            t.velocity_y *= 0.25
        } else {
            t.velocity_y = 0.0
            t.flinging = false
        }
        << true
    }
    if next_scroll > t.maximum {
        t.scroll = t.maximum
        if t.bouncing {
            t.overscroll = math.min(f64(MAX_OVERSCROLL),(next_scroll - t.maximum) * 0.35)
            t.velocity_y *= 0.25
        } else {
            t.velocity_y = 0.0
            t.flinging = false
        }
        << true
    }
    t.scroll = next_scroll
    if math.abs(t.velocity_y) < 14.0 {
        t.velocity_y = 0.0
        t.flinging = false
    }
    << true
}

pub fn (t $&Touch) step() bool {
    << t.step_at(time.now())
}

// An activation requires a matching down/up, the same target, and movement
// below the drag threshold. A vertical drag scrolls without activating a row;
// tapping a spinning list halts inertia without triggering the underlying item.
pub fn (t $&Touch) event(event &ui.Event) int {
    if event.kind == ui.EV_BLURRED || event.kind == ui.EV_CANVAS_METRICS {
        t.cancel()
        t.flinging = false
        t.overscroll = 0.0
        << 0
    }
    if !ui.is_input_event(event.kind) { << 0 }
    input := ui.input_of(event) or >>
    if input.window_id != t.window || input.canvas_id != t.canvas || input.generation != t.generation { << 0 }
    if input.kind == ui.EV_POINTER_CANCEL {
        t.cancel()
        if t.bouncing && t.overscroll != 0.0 {
            t.flinging = true
            t.anim_ns = input.time_ns
        }
        << 0
    }
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        // If already rebounding in overscroll, let start_scroll include current visual pull.
        was_animating := t.flinging && math.abs(t.velocity_y) > 40.0
        t.flinging = false
        t.velocity_x = 0.0
        t.velocity_y = 0.0
        t.down = true
        t.swallowed_tap = was_animating
        if was_animating { t.armed = 0 }
        else { t.armed = t.hit(input.x,input.y) }
        t.active = t.armed
        t.start_x = input.x
        t.start_y = input.y
        t.cur_x = input.x
        t.cur_y = input.y
        t.last_x = input.x
        t.last_y = input.y
        t.last_time_ns = input.time_ns
        t.start_scroll = t.scroll + t.overscroll
        t.dragged = false
        t.drag_axis = DRAG_NONE
        t.scrollable = t.maximum > 0.0 && t.scroll_bounds.width > 0.0 && t.scroll_bounds.height > 0.0 && t.scroll_bounds.contains(input.x,input.y)
    }
    if input.kind == ui.EV_POINTER_MOVE && t.down { t.motion(input.x,input.y,input.time_ns) }
    if input.kind == ui.EV_POINTER_UP && t.down {
        // A host can coalesce all intermediate moves. Apply the final pointer
        // position before deciding between scrolling and activation.
        t.motion(input.x,input.y,input.time_ns)
        $action := 0
        if !t.dragged && !t.swallowed_tap && t.armed > 0 && t.hit(input.x,input.y) == t.armed { action = t.armed }
        launch_fling := !reduced_motion() && t.drag_axis == DRAG_VERTICAL && t.scrollable &&
            (math.abs(t.velocity_y) >= 90.0 || (t.bouncing && t.overscroll != 0.0))
        vy := t.velocity_y
        rebound := t.bouncing && t.overscroll != 0.0
        t.cancel()
        if launch_fling || (reduced_motion() && rebound) {
            if reduced_motion() {
                t.overscroll = 0.0
                t.flinging = false
            } else {
                t.flinging = true
                t.velocity_y = vy
                t.anim_ns = input.time_ns
            }
        } else if rebound {
            t.flinging = true
            t.anim_ns = input.time_ns
        }
        << action
    }
    << 0
}

// Left-edge horizontal swipe-back gesture. Read before event() consumes pointer-up.
pub fn (t &Touch) swipe_back(event &ui.Event,width f64) bool {
    if !t.edge_back_enabled || event.kind != ui.EV_POINTER_UP || !t.down || t.start_x > t.edge_left + f64(EDGE_BACK_ZONE) { << false }
    input := ui.input_of(event) or (err) { << false }
    if input.window_id != t.window || input.canvas_id != t.canvas || input.generation != t.generation { << false }
    dx := input.x - t.start_x
    dy := math.abs(input.y - t.start_y)
    if dx <= 0.0 || dx <= dy * 1.2 { << false }
    threshold := math.max(88.0,width * 0.34)
    << dx >= threshold || (dx >= 40.0 && t.velocity_x >= 320.0)
}

// Bottom-sheet grabber/header gesture. Read before event() consumes pointer-up.
pub fn (t &Touch) swipe_down(event &ui.Event,area layout.Rect) bool {
    if event.kind != ui.EV_POINTER_UP || !t.down || !area.contains(t.start_x,t.start_y) { << false }
    input := ui.input_of(event) or (err) { << false }
    if input.window_id != t.window || input.canvas_id != t.canvas || input.generation != t.generation { << false }
    dy := input.y - t.start_y
    if dy <= 0.0 || math.abs(input.x - t.start_x) >= dy * 0.5 { << false }
    << dy >= 64.0 || (dy >= 36.0 && t.velocity_y <= -360.0)
}
