@ui/phone

#ui/draw
#ui/layout
#math

// Reuses the Draw frame/resource protocol. Temporary layouts remain alive
// until present accepts the complete frame, then the frame lease retains them.
pub struct Canvas {
    pub frame draw.Frame
    context draw.Context
    texts []draw.TextLayout
}
pub fn canvas(context &draw.Context) Canvas {
    << Canvas{frame: context.new_frame(16384),context: context.clone(),texts: []draw.TextLayout{}}
}
fn (c $&Canvas) release_texts() {
    for i in 0:c.texts.len { $text := c.texts[i]
        text.dispose() or (err) { -> } }
    c.texts = []draw.TextLayout{}
}
fn (c $&Canvas) cancel_frame() {
    frame := $&c.frame
    frame.cancel()
}
pub fn (c $&Canvas) begin(theme &Theme) int {
    set_dark_appearance(theme.dark) or >>
    c.cancel_frame()
    c.release_texts()
    frame := $&c.frame
    frame.begin() or >>
    frame.set_bg(theme.background) or >>
    << 0
}
pub fn (c $&Canvas) present() int {
    frame := $&c.frame
    frame.present_wait() or >>
    c.release_texts()
    << 0
}
pub fn (c $&Canvas) dispose() {
    frame := $&c.frame
    frame.dispose()
    c.release_texts()
}

// Single-line text fits its assigned width, with Canvas-side grapheme-safe
// ellipsis. Geometry stays independent of the host's estimated text metrics.
pub fn (c $&Canvas) label(bounds layout.Rect,value string,size f64,weight int,color draw.Color,align int) int {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { << 0 }
    $options := draw.text_options(size)
    options.width = bounds.width
    options.weight = weight
    options.align = align
    $text := c.context.layout_text(&value,&options) or >>
    y := bounds.y + math.max(0.0,(bounds.height - size * 1.2) * 0.5)
    frame := $&c.frame
    frame.text_layout(&text,bounds.x,y,color) or (err) {
        text.dispose() or (cleanup) { >> cleanup }
        >> err
    }
    c.texts.push(text)
    << 0
}

pub fn (c $&Canvas) card(bounds layout.Rect,theme &Theme) int {
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,24.0,theme.surface) or >>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,24.0,theme.border,1.0) or >>
    << 0
}

pub const ICON_HOME = 1
pub const ICON_HISTORY = 2
pub const ICON_SETTINGS = 3
pub const ICON_PLUS = 4
pub const ICON_CHEVRON = 5
pub const ICON_CLOSE = 6
pub const ICON_CHECK = 7
pub const ICON_FOCUS = 8
pub const ICON_BOOK = 9
pub const ICON_ACTIVITY = 10
pub const ICON_BACK = 11

pub const TONE_SECONDARY = 0
pub const TONE_PRIMARY = 1
pub const TONE_DANGER = 2

pub fn (c $&Canvas) icon(bounds layout.Rect,kind int,color draw.Color) int {
    x := bounds.x + (bounds.width - 24.0) * 0.5
    y := bounds.y + (bounds.height - 24.0) * 0.5
    line := 1.8
    if kind == ICON_PLUS || kind == ICON_CLOSE {
        if kind == ICON_PLUS {
            c.line(x + 5.0,y + 12.0,x + 19.0,y + 12.0,color,line) or >>
            c.line(x + 12.0,y + 5.0,x + 12.0,y + 19.0,color,line) or >>
        } else {
            c.line(x + 6.0,y + 6.0,x + 18.0,y + 18.0,color,line) or >>
            c.line(x + 18.0,y + 6.0,x + 6.0,y + 18.0,color,line) or >>
        }
    } else if kind == ICON_CHEVRON {
        c.line(x + 9.0,y + 7.0,x + 14.0,y + 12.0,color,line) or >>
        c.line(x + 14.0,y + 12.0,x + 9.0,y + 17.0,color,line) or >>
    } else if kind == ICON_BACK {
        c.line(x + 15.0,y + 6.0,x + 8.0,y + 12.0,color,2.0) or >>
        c.line(x + 8.0,y + 12.0,x + 15.0,y + 18.0,color,2.0) or >>
    } else if kind == ICON_CHECK {
        c.line(x + 5.0,y + 12.0,x + 10.0,y + 17.0,color,2.0) or >>
        c.line(x + 10.0,y + 17.0,x + 20.0,y + 7.0,color,2.0) or >>
    } else if kind == ICON_HOME {
        c.line(x + 3.0,y + 10.0,x + 12.0,y + 3.0,color,line) or >>
        c.line(x + 12.0,y + 3.0,x + 21.0,y + 10.0,color,line) or >>
        c.stroke_round_rect(x + 5.0,y + 9.0,14.0,12.0,2.0,color,line) or >>
        c.line(x + 10.0,y + 21.0,x + 10.0,y + 15.0,color,line) or >>
        c.line(x + 14.0,y + 21.0,x + 14.0,y + 15.0,color,line) or >>
    } else if kind == ICON_BOOK {
        c.stroke_round_rect(x + 4.0,y + 4.0,16.0,17.0,2.0,color,line) or >>
        c.line(x + 8.0,y + 4.0,x + 8.0,y + 21.0,color,line) or >>
        c.line(x + 11.0,y + 9.0,x + 17.0,y + 9.0,color,line) or >>
    } else if kind == ICON_SETTINGS {
        for i in 0:3 {
            yy := y + 6.0 + f64(i) * 6.0
            c.line(x + 3.0,yy,x + 21.0,yy,color,line) or >>
            $xx := x + 8.0
            if i == 1 { xx = x + 16.0 }
            c.fill_circle(xx,yy,2.8,color) or >>
        }
    } else if kind == ICON_ACTIVITY {
        c.line(x + 2.0,y + 13.0,x + 7.0,y + 13.0,color,line) or >>
        c.line(x + 7.0,y + 13.0,x + 10.0,y + 5.0,color,line) or >>
        c.line(x + 10.0,y + 5.0,x + 15.0,y + 20.0,color,line) or >>
        c.line(x + 15.0,y + 20.0,x + 18.0,y + 11.0,color,line) or >>
        c.line(x + 18.0,y + 11.0,x + 22.0,y + 11.0,color,line) or >>
    } else {
        c.stroke_circle(x + 12.0,y + 12.0,9.0,color,line) or >>
        c.line(x + 12.0,y + 6.0,x + 12.0,y + 12.0,color,line) or >>
        c.line(x + 12.0,y + 12.0,x + 16.0,y + 14.0,color,line) or >>
        if kind == ICON_FOCUS { c.fill_circle(x + 12.0,y + 12.0,2.0,color) or >> }
    }
    << 0
}

pub fn (c $&Canvas) button_tone(bounds layout.Rect,theme &Theme,label string,tone int,pressed bool) int {
    $fill := theme.surface
    $ink := theme.ink
    if tone == TONE_PRIMARY {
        fill = theme.accent
        ink = theme.on_accent
        if pressed { fill = theme.accent_pressed }
    } else if tone == TONE_DANGER {
        fill = theme.danger
        ink = theme.on_accent
        if pressed { fill = theme.accent_pressed }
    } else if pressed {
        fill = theme.subtle_pressed
    }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,18.0,fill) or >>
    if tone == TONE_SECONDARY {
        c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,18.0,theme.border,1.0) or >>
    }
    c.label(rect(bounds.x + 16.0,bounds.y,bounds.width - 32.0,bounds.height),label,17.0,600,ink,draw.TEXT_CENTER) or >>
    << 0
}

pub fn (c $&Canvas) button(bounds layout.Rect,theme &Theme,label string,primary bool,pressed bool) int {
    $tone := TONE_SECONDARY
    if primary { tone = TONE_PRIMARY }
    << c.button_tone(bounds,theme,label,tone,pressed)
}

pub fn (c $&Canvas) chip(bounds layout.Rect,theme &Theme,label string,selected bool,pressed bool) int {
    $fill := theme.surface
    $ink := theme.muted
    if selected { fill = theme.accent_tint
        ink = theme.accent }
    if pressed { fill = theme.subtle_pressed }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,16.0,fill) or >>
    if !selected { c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,16.0,theme.border,1.0) or >> }
    c.label(bounds,label,15.0,600,ink,draw.TEXT_CENTER) or >>
    << 0
}

pub fn (c $&Canvas) navigation(shell &Scaffold,theme &Theme,selected int,touches &Touch) int {
    nav := shell.navigation
    c.fill_rect(nav.x,nav.y,nav.width,nav.height,theme.surface) or >>
    if shell.wide { c.line(nav.width,0.0,nav.width,shell.height,theme.border,1.0) or >> }
    else { c.line(0.0,nav.y,shell.width,nav.y,theme.border,1.0) or >> }
    labels := ["今日","记录","设置"]
    for i in 0:3 {
        bounds := tab_bounds(shell,i)
        $ink := theme.muted
        if selected == i + 1 { ink = theme.accent
            c.fill_round_rect(bounds.x + (bounds.width - 56.0) * 0.5,bounds.y + 2.0,56.0,32.0,16.0,theme.accent_tint) or >> }
        if touches.pressed(i + 1) { c.fill_round_rect(bounds.x + 4.0,bounds.y,bounds.width - 8.0,bounds.height,16.0,theme.subtle_pressed) or >> }
        c.icon(rect(bounds.x,bounds.y + 4.0,bounds.width,24.0),i + 1,ink) or >>
        c.label(rect(bounds.x,bounds.y + 34.0,bounds.width,24.0),labels[i] + "",12.0,600,ink,draw.TEXT_CENTER) or >>
    }
    << 0
}

pub fn (c $&Canvas) scrollbar(bounds &layout.Rect,theme &Theme,scroll f64,maximum f64,content_height f64) int {
    if maximum <= 2.0 || bounds.height < 64.0 || content_height <= bounds.height { << 0 }
    track_h := bounds.height - 16.0
    thumb_h := math.max(28.0,math.min(track_h,track_h * (bounds.height / content_height)))
    ratio := math.max(0.0,math.min(1.0,scroll / maximum))
    thumb_y := bounds.y + 8.0 + (track_h - thumb_h) * ratio
    c.fill_round_rect(bounds.x + bounds.width - 5.0,thumb_y,3.0,thumb_h,1.5,theme.border) or >>
    << 0
}

pub fn snackbar_action_bounds(bounds &layout.Rect,has_action bool) layout.Rect {
    if !has_action || bounds.width < 120.0 { << rect(0.0,0.0,0.0,0.0) }
    w := math.min(84.0,bounds.width * 0.34)
    << rect(bounds.x + bounds.width - w - 8.0,bounds.y,w,bounds.height)
}

pub fn (c $&Canvas) snackbar(bounds &layout.Rect,theme &Theme,message string,action_label string,action_pressed bool) int {
    $fill := theme.ink
    $ink := theme.surface
    $action_color := draw.rgb(255,142,157)
    if theme.dark {
        fill = theme.elevated
        ink = theme.ink
        action_color = theme.accent
    }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,14.0,fill) or >>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,14.0,theme.border,1.0) or >>
    has_action := action_label.len > 0
    action_rect := snackbar_action_bounds(bounds,has_action)
    $text_w := bounds.width - 32.0
    if has_action { text_w = math.max(40.0,action_rect.x - bounds.x - 16.0) }
    c.label(rect(bounds.x + 16.0,bounds.y,text_w,bounds.height),message,14.0,500,ink,draw.TEXT_LEFT) or >>
    if has_action {
        if action_pressed {
            c.fill_round_rect(action_rect.x + 4.0,action_rect.y + 6.0,action_rect.width - 8.0,action_rect.height - 12.0,10.0,theme.accent_tint) or >>
        }
        c.label(action_rect,action_label,14.0,600,action_color,draw.TEXT_CENTER) or >>
    }
    << 0
}

pub fn (c $&Canvas) row(bounds layout.Rect,theme &Theme,title string,detail string,kind int,pressed bool) int {
    if pressed { c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,16.0,theme.subtle_pressed) or >> }
    c.fill_round_rect(bounds.x + 12.0,bounds.y + 16.0,40.0,40.0,13.0,theme.accent_tint) or >>
    c.icon(rect(bounds.x + 12.0,bounds.y + 16.0,40.0,40.0),kind,theme.accent) or >>
    c.label(rect(bounds.x + 64.0,bounds.y + 12.0,bounds.width - 136.0,26.0),title,16.0,500,theme.ink,draw.TEXT_LEFT) or >>
    c.label(rect(bounds.x + 64.0,bounds.y + 38.0,bounds.width - 136.0,22.0),detail,12.0,400,theme.muted,draw.TEXT_LEFT) or >>
    << 0
}

pub fn (c $&Canvas) sheet(shell &Scaffold,theme &Theme,bounds layout.Rect,title string) int {
    c.fill_rect(0.0,0.0,shell.width,shell.height,theme.scrim) or >>
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,28.0,theme.surface) or >>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,28.0,theme.border,1.0) or >>
    // Square the lower corners against the viewport edge.
    c.fill_rect(bounds.x,bounds.y + bounds.height - 28.0,bounds.width,28.0,theme.surface) or >>
    c.fill_round_rect(bounds.x + (bounds.width - 36.0) * 0.5,bounds.y + 10.0,36.0,4.0,2.0,theme.border) or >>
    c.label(rect(bounds.x + 24.0,bounds.y + 26.0,bounds.width - 96.0,40.0),title,21.0,600,theme.ink,draw.TEXT_LEFT) or >>
    c.icon(rect(bounds.x + bounds.width - 64.0,bounds.y + 22.0,48.0,48.0),ICON_CLOSE,theme.muted) or >>
    << 0
}

pub fn (c $&Canvas) fill_round_rect(x f64,y f64,width f64,height f64,radius f64,color draw.Color) int {
    frame := $&c.frame
    frame.fill_round_rect(x,y,width,height,radius,color) or >>
    << 0
}

pub fn (c $&Canvas) fill_rect(x f64,y f64,width f64,height f64,color draw.Color) int {
    frame := $&c.frame
    frame.fill_rect(x,y,width,height,color) or >>
    << 0
}

pub fn (c $&Canvas) line(x1 f64,y1 f64,x2 f64,y2 f64,color draw.Color,width f64) int {
    frame := $&c.frame
    frame.line(x1,y1,x2,y2,color,width) or >>
    << 0
}

pub fn (c $&Canvas) fill_circle(x f64,y f64,radius f64,color draw.Color) int {
    frame := $&c.frame
    frame.fill_circle(x,y,radius,color) or >>
    << 0
}

pub fn (c $&Canvas) stroke_circle(x f64,y f64,radius f64,color draw.Color,width f64) int {
    frame := $&c.frame
    frame.stroke_circle(x,y,radius,color,width) or >>
    << 0
}

pub fn (c $&Canvas) stroke_round_rect(x f64,y f64,width f64,height f64,radius f64,color draw.Color,line_width f64) int {
    frame := $&c.frame
    frame.stroke_round_rect(x,y,width,height,radius,color,line_width) or >>
    << 0
}

pub fn (c $&Canvas) clip_rect(x f64,y f64,width f64,height f64) int {
    frame := $&c.frame
    frame.clip_rect(x,y,width,height) or >>
    << 0
}

pub fn (c $&Canvas) push() int {
    frame := $&c.frame
    frame.push() or >>
    << 0
}

pub fn (c $&Canvas) pop() int {
    frame := $&c.frame
    frame.pop() or >>
    << 0
}
