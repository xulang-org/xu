@ui/phone

#errors
#ui
#ui/draw
#ui/font
#ui/layout
#math

// Reuses the Draw frame/resource protocol. Temporary layouts remain alive
// until present accepts the complete frame, then the frame lease retains them.
pub struct Canvas {
    pub frame draw.Frame
    context draw.Context
    texts []draw.TextLayout
    font_stack font.FontStack
    identity ui.CanvasEvent
    has_identity bool
    sel_texts map[int]SelectableText
    sel_order []int
    sel_active map[int]bool
    sel_overrides map[int]bool
    sel_locale int
}
pub fn canvas(context &draw.Context) Canvas {
    << Canvas{frame: context.new_frame(16384),context: context.clone(),texts: []draw.TextLayout{},font_stack: font.new_font_stack(),
        identity: ui.CanvasEvent{window_id: 0,canvas_id: 0,generation: 0},has_identity: false,
        sel_texts: map[int]SelectableText{},sel_order: []int{},sel_active: map[int]bool{},sel_overrides: map[int]bool{},sel_locale: LOCALE_EN}
}
pub fn canvas_with_identity(context &draw.Context,identity &ui.CanvasEvent) Canvas {
    << Canvas{frame: context.new_frame(16384),context: context.clone(),texts: []draw.TextLayout{},font_stack: font.new_font_stack(),
        identity: ui.CanvasEvent{window_id: identity.window_id,canvas_id: identity.canvas_id,generation: identity.generation},
        has_identity: identity.canvas_id > 0,
        sel_texts: map[int]SelectableText{},sel_order: []int{},sel_active: map[int]bool{},sel_overrides: map[int]bool{},sel_locale: LOCALE_EN}
}
pub fn (c $&Canvas) set_identity(identity &ui.CanvasEvent) {
    c.identity = ui.CanvasEvent{window_id: identity.window_id,canvas_id: identity.canvas_id,generation: identity.generation}
    c.has_identity = identity.canvas_id > 0
}
fn canvas_take_sel(m $&map[int]SelectableText,id int) SelectableText {
    << m.take(id)
}
pub fn (c $&Canvas) set_locale(locale int) {
    if locale == LOCALE_ZH_CN { c.sel_locale = LOCALE_ZH_CN } else { c.sel_locale = LOCALE_EN }
    for id in c.sel_order {
        if c.sel_texts.has(id) {
            $st := canvas_take_sel($&c.sel_texts,id)
            st.set_locale(c.sel_locale)
            c.sel_texts[id] = st
        }
    }
}
pub fn (c $&Canvas) set_text_selectable(id int,selectable bool) {
    ov := $&c.sel_overrides
    ov[id] = selectable
    if c.sel_texts.has(id) {
        $st := canvas_take_sel($&c.sel_texts,id)
        st.set_selectable(selectable)
        c.sel_texts[id] = st
    }
}
pub fn (c &Canvas) is_text_selectable(id int) bool {
    if c.sel_overrides.has(id) { << c.sel_overrides[id] }
    if c.sel_texts.has(id) {
        st := &c.sel_texts[id]
        << st.selectable
    }
    << false
}
pub fn (c &Canvas) selected_text(id int) string {
    if !c.sel_texts.has(id) { << "" }
    st := &c.sel_texts[id]
    << st.selected_text()
}
fn (c $&Canvas) sync_selectable_font_stack() {
    if c.font_stack.face_count() == 0 { << }
    for id in c.sel_order {
        if c.sel_texts.has(id) {
            $st := canvas_take_sel($&c.sel_texts,id)
            st.set_font_stack(c.font_stack.clone())
            c.sel_texts[id] = st
        }
    }
}
fn (c $&Canvas) prune_inactive_selectables() {
    if c.sel_order.len == 0 { << }
    $next_order := []int{}
    for id in c.sel_order {
        if c.sel_active.has(id) {
            if c.sel_texts.has(id) { next_order.push(id) }
        } else if c.sel_texts.has(id) {
            _ := canvas_take_sel($&c.sel_texts,id)
        }
    }
    c.sel_order = next_order
}
pub fn (c $&Canvas) set_font_stack(stack font.FontStack) {
    c.font_stack = stack
    c.sync_selectable_font_stack()
}
pub fn (c $&Canvas) add_ttf_bytes(ttf_bytes &[]u8,font_index int,face_id int) int {
    r := draw.add_ttf_face($&c.font_stack,ttf_bytes,font_index,face_id) >>>
    c.sync_selectable_font_stack()
    << r
}
fn (c $&Canvas) ensure_font_stack() int {
    if c.font_stack.face_count() == 0 {
        stack := $&c.font_stack
        stack.ensure_builtin_fallback(1) >>>
    }
    << 0
}
fn (c $&Canvas) release_texts() {
    for i in 0:c.texts.len { $text := c.texts[i]
        text.dispose() >>> (err) { -> } }
    c.texts = []draw.TextLayout{}
}
fn (c $&Canvas) cancel_frame() {
    frame := $&c.frame
    frame.cancel()
}
pub fn (c $&Canvas) begin(theme &Theme) int {
    set_dark_appearance(theme.dark) >>>
    c.cancel_frame()
    c.release_texts()
    c.sel_active = map[int]bool{}
    frame := $&c.frame
    frame.begin() >>>
    frame.set_bg(theme.background) >>>
    << 0
}
pub fn (c $&Canvas) present() int {
    frame := $&c.frame
    frame.present_wait() >>>
    c.release_texts()
    c.prune_inactive_selectables()
    << 0
}
pub fn (c $&Canvas) export_xdf() string {
    frame := $&c.frame
    payload := frame.export_xdf() >>>
    c.release_texts()
    c.prune_inactive_selectables()
    << payload
}
pub fn (c $&Canvas) dispose() {
    frame := $&c.frame
    frame.dispose()
    c.release_texts()
}

pub fn (c $&Canvas) shape_text(value &string,size f64,weight int,line_height f64,width f64,align int) draw.TextLayout {
    $options := draw.text_options(size)
    options.width = width
    options.weight = weight
    options.align = align
    options.line_height = line_height
    << c.context.layout_text(value,&options) >>>
}

pub fn (c $&Canvas) put_text(text draw.TextLayout,x f64,y f64,color draw.Color) int {
    frame := $&c.frame
    frame.text_layout(&text,x,y,color) >>> (err) {
        $owned := text
        owned.dispose() >>> (cleanup) { >>> cleanup }
        >>> err
    }
    c.texts.push(text)
    << 0
}

// Single-line text fits its assigned width, with Canvas-side grapheme-safe
// ellipsis. Geometry stays independent of the host's estimated text metrics.
pub fn (c $&Canvas) label(bounds layout.Rect,value string,size f64,weight int,color draw.Color,align int) int {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { << 0 }
    $options := draw.text_options(size)
    options.width = bounds.width
    options.weight = weight
    options.align = align
    if ui.host_tmp() != ":xu:" {
        c.ensure_font_stack() >>>
        ly := draw.layout_font_text(&c.font_stack,&value,&options,false) >>>
        y := bounds.y + math.max(0.0,(bounds.height - size * 1.2) * 0.5)
        c.push() >>>
        c.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) >>> (err) {
            safe_pop(c)
            >>> err
        }
        frame := $&c.frame
        frame.text_font_layout(&ly,&value,bounds.x,y,color) >>> (err) {
            safe_pop(c)
            >>> err
        }
        c.pop() >>>
        << 0
    }
    $text := c.context.layout_text(&value,&options) >>>
    y := bounds.y + math.max(0.0,(bounds.height - size * 1.2) * 0.5)
    frame := $&c.frame
    frame.text_layout(&text,bounds.x,y,color) >>> (err) {
        text.dispose() >>> (cleanup) { >>> cleanup }
        >>> err
    }
    c.texts.push(text)
    << 0
}

fn safe_pop(c $&Canvas) {
    c.pop() >>> (ignored) { << }
}

fn safe_dispose_text(text draw.TextLayout) {
    $owned := text
    owned.dispose() >>> (ignored) { << }
}

// Measure wrapped multi-line height at width without retaining a layout handle.
pub fn (c $&Canvas) measure_paragraph(value &string,size f64,weight int,line_height f64,width f64) f64 {
    if width <= 0.0 || value.len == 0 { << 0.0 }
    $lh := line_height
    if lh <= 0.0 { lh = math.ceil(size * 1.45) }
    if ui.host_tmp() != ":xu:" {
        c.ensure_font_stack() >>>
        $options := draw.text_options(size)
        options.width = width
        options.weight = weight
        options.align = draw.TEXT_LEFT
        options.line_height = lh
        ly := draw.layout_font_text(&c.font_stack,value,&options,false) >>>
        << ly.metrics.height
    }
    $text := c.shape_text(value,size,weight,lh,width,draw.TEXT_LEFT) >>>
    measured := text.metrics.height
    text.dispose() >>>
    << measured
}

// Draw wrapped multi-line text inside bounds.width and return measured height.
pub fn (c $&Canvas) paragraph(bounds layout.Rect,value string,size f64,weight int,line_height f64,color draw.Color,align int) f64 {
    if bounds.width <= 0.0 { << 0.0 }
    $lh := line_height
    if lh <= 0.0 { lh = math.ceil(size * 1.45) }
    if ui.host_tmp() != ":xu:" {
        c.ensure_font_stack() >>>
        $options := draw.text_options(size)
        options.width = bounds.width
        options.weight = weight
        options.align = align
        options.line_height = lh
        ly := draw.layout_font_text(&c.font_stack,&value,&options,false) >>>
        measured := ly.metrics.height
        if bounds.height <= 0.0 || measured <= bounds.height + 0.5 {
            frame := $&c.frame
            frame.text_font_layout(&ly,&value,bounds.x,bounds.y,color) >>>
            << measured
        }
        c.push() >>>
        c.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) >>> (err) {
            safe_pop(c)
            >>> err
        }
        frame := $&c.frame
        frame.text_font_layout(&ly,&value,bounds.x,bounds.y,color) >>> (err) {
            safe_pop(c)
            >>> err
        }
        c.pop() >>>
        << math.min(bounds.height,measured)
    }
    $text := c.shape_text(&value,size,weight,lh,bounds.width,align) >>>
    measured := text.metrics.height
    if bounds.height <= 0.0 || measured <= bounds.height + 0.5 {
        c.put_text(text,bounds.x,bounds.y,color) >>>
        << measured
    }
    c.push() >>> (err) {
        safe_dispose_text(text)
        >>> err
    }
    c.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) >>> (err) {
        safe_pop(c)
        safe_dispose_text(text)
        >>> err
    }
    c.put_text(text,bounds.x,bounds.y,color) >>> (err) {
        safe_pop(c)
        >>> err
    }
    c.pop() >>>
    << math.min(bounds.height,measured)
}

fn (c $&Canvas) acquire_selectable(id int,value string,size f64,weight int,line_height f64,align int,multiline bool) SelectableText {
    if c.sel_texts.has(id) {
        $st := canvas_take_sel($&c.sel_texts,id)
        if c.has_identity && st.identity.canvas_id <= 0 {
            st.identity = copy_canvas_identity(&c.identity)
        }
        if !st.has_font_stack && c.font_stack.face_count() > 0 {
            st.set_font_stack(c.font_stack.clone())
        }
        st.size = size
        st.multiline = multiline
        st.set_style(weight,line_height,align)
        st.set_locale(c.sel_locale)
        _ := st.set_value(value)
        if c.sel_overrides.has(id) {
            enabled := c.sel_overrides[id]
            if st.selectable != enabled { st.set_selectable(enabled) }
        }
        << st
    }
    $st := selectable_text(&c.context,&c.identity,id,value,size,multiline)
    if c.font_stack.face_count() > 0 { st.set_font_stack(c.font_stack.clone()) }
    st.set_style(weight,line_height,align)
    st.set_locale(c.sel_locale)
    if c.sel_overrides.has(id) { st.set_selectable(c.sel_overrides[id]) }
    order := $&c.sel_order
    order.push(id)
    << st
}

struct CanvasSelDrawResult {
    measured f64
    err_msg string
}

fn paint_sel_no_throw(c $&Canvas,t $&Touch,st $&SelectableText,bounds layout.Rect,clip &layout.Rect,theme &Theme,color draw.Color) CanvasSelDrawResult {
    m := st.draw(c,t,bounds,clip,theme,color) >>> (err) {
        << CanvasSelDrawResult{measured: 0.0,err_msg: err.msg()}
    }
    << CanvasSelDrawResult{measured: m,err_msg: ""}
}

fn (c $&Canvas) paint_selectable_entry(t $&Touch,id int,bounds layout.Rect,value string,size f64,weight int,line_height f64,color draw.Color,align int,multiline bool,clip &layout.Rect,theme &Theme) f64 {
    act := $&c.sel_active
    act[id] = true
    $st := c.acquire_selectable(id,value,size,weight,line_height,align,multiline)
    res := paint_sel_no_throw(c,t,$&st,bounds,clip,theme,color)
    sel_map := $&c.sel_texts
    sel_map[id] = st
    if res.err_msg.len > 0 { >>> errors.new(res.err_msg) }
    << res.measured
}

pub fn (c $&Canvas) selectable_label(t $&Touch,id int,bounds layout.Rect,value string,size f64,weight int,color draw.Color,align int,clip &layout.Rect,theme &Theme) int {
    _ := c.paint_selectable_entry(t,id,bounds,value,size,weight,0.0,color,align,false,clip,theme) >>>
    << 0
}

pub fn (c $&Canvas) selectable_paragraph(t $&Touch,id int,bounds layout.Rect,value string,size f64,weight int,line_height f64,color draw.Color,align int,clip &layout.Rect,theme &Theme) f64 {
    << c.paint_selectable_entry(t,id,bounds,value,size,weight,line_height,color,align,true,clip,theme) >>>
}

pub fn (c $&Canvas) draw_selectable(state $&SelectableText,t $&Touch,bounds layout.Rect,clip &layout.Rect,theme &Theme,color draw.Color) f64 {
    << state.draw(c,t,bounds,clip,theme,color) >>>
}

fn merge_sel_result(agg $&SelectableTextResult,sub &SelectableTextResult) {
    if sub.changed { agg.changed = true }
    if sub.copied { agg.copied = true }
    if sub.focused { agg.focused = true }
    if sub.blurred { agg.blurred = true }
    if sub.needs_paint { agg.needs_paint = true }
    if sub.consumed { agg.consumed = true }
}

fn (c $&Canvas) route_selectable_entry(id int,event &ui.Event,touches &Touch,action int) SelectableTextResult {
    $st := canvas_take_sel($&c.sel_texts,id)
    if c.has_identity && st.identity.canvas_id <= 0 {
        st.identity = copy_canvas_identity(&c.identity)
    }
    sub := st.handle_event(event,touches,action)
    c.sel_texts[id] = st
    << sub
}

pub fn (c $&Canvas) handle_text_selection(event &ui.Event,touches &Touch,action int) SelectableTextResult {
    if !c.has_identity && ui.is_input_event(event.kind) {
        inp := ui.input_of(event) >>> (err) { << empty_sel_result() }
        if inp.canvas_id > 0 {
            c.identity = ui.CanvasEvent{window_id: inp.window_id,canvas_id: inp.canvas_id,generation: inp.generation}
            c.has_identity = true
        }
    }
    $agg := empty_sel_result()
    if ui.is_input_event(event.kind) {
        inp := ui.input_of(event) >>> (err) { << empty_sel_result() }
        if inp.kind == ui.EV_POINTER_DOWN || inp.kind == ui.EV_POINTER_MOVE || inp.kind == ui.EV_POINTER_UP {
            for id in c.sel_order {
                if c.sel_texts.has(id) {
                    $hit_bar := false
                    if true {
                        st_ref := &c.sel_texts[id]
                        hit_bar = st_ref.action_bar_open && st_ref.action_bar.bounds.contains(inp.x,inp.y)
                    }
                    if hit_bar {
                        sub := c.route_selectable_entry(id,event,touches,action)
                        merge_sel_result($&agg,&sub)
                        if sub.consumed { << agg }
                    }
                }
            }
            if inp.kind == ui.EV_POINTER_MOVE || inp.kind == ui.EV_POINTER_UP {
                for id in c.sel_order {
                    if c.sel_texts.has(id) {
                        $dragging := false
                        if true {
                            st_ref := &c.sel_texts[id]
                            dragging = st_ref.drag_selecting
                        }
                        if dragging {
                            sub := c.route_selectable_entry(id,event,touches,action)
                            merge_sel_result($&agg,&sub)
                            if sub.consumed { << agg }
                        }
                    }
                }
            }
        }
    }
    for id in c.sel_order {
        if c.sel_texts.has(id) {
            sub := c.route_selectable_entry(id,event,touches,action)
            merge_sel_result($&agg,&sub)
        }
    }
    << agg
}

pub fn (c $&Canvas) card(bounds layout.Rect,theme &Theme) int {
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,24.0,theme.surface) >>>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,24.0,theme.border,1.0) >>>
    << 0
}

pub const ICON_HOME = 1
pub const ICON_HISTORY = 2
pub const ICON_SETTINGS = 3
pub const ICON_PLUS = 4
pub const ICON_CHEVRON = 5
pub const ICON_CLOSE = 6
pub const ICON_CHECK = 7
pub const ICON_FOCUS = 8
pub const ICON_BOOK = 9
pub const ICON_ACTIVITY = 10
pub const ICON_BACK = 11
pub const ICON_REFRESH = 12
pub const ICON_COPY = 13
pub const ICON_SEARCH = 14

pub const TONE_SECONDARY = 0
pub const TONE_PRIMARY = 1
pub const TONE_DANGER = 2

pub fn (c $&Canvas) icon(bounds layout.Rect,kind int,color draw.Color) int {
    x := bounds.x + (bounds.width - 24.0) * 0.5
    y := bounds.y + (bounds.height - 24.0) * 0.5
    line := 1.8
    if kind == ICON_PLUS || kind == ICON_CLOSE {
        if kind == ICON_PLUS {
            c.line(x + 5.0,y + 12.0,x + 19.0,y + 12.0,color,line) >>>
            c.line(x + 12.0,y + 5.0,x + 12.0,y + 19.0,color,line) >>>
        } else {
            c.line(x + 6.0,y + 6.0,x + 18.0,y + 18.0,color,line) >>>
            c.line(x + 18.0,y + 6.0,x + 6.0,y + 18.0,color,line) >>>
        }
    } else if kind == ICON_CHEVRON {
        c.line(x + 9.0,y + 7.0,x + 14.0,y + 12.0,color,line) >>>
        c.line(x + 14.0,y + 12.0,x + 9.0,y + 17.0,color,line) >>>
    } else if kind == ICON_BACK {
        c.line(x + 15.0,y + 6.0,x + 8.0,y + 12.0,color,2.0) >>>
        c.line(x + 8.0,y + 12.0,x + 15.0,y + 18.0,color,2.0) >>>
    } else if kind == ICON_CHECK {
        c.line(x + 5.0,y + 12.0,x + 10.0,y + 17.0,color,2.0) >>>
        c.line(x + 10.0,y + 17.0,x + 20.0,y + 7.0,color,2.0) >>>
    } else if kind == ICON_HOME {
        c.line(x + 3.0,y + 10.0,x + 12.0,y + 3.0,color,line) >>>
        c.line(x + 12.0,y + 3.0,x + 21.0,y + 10.0,color,line) >>>
        c.stroke_round_rect(x + 5.0,y + 9.0,14.0,12.0,2.0,color,line) >>>
        c.line(x + 10.0,y + 21.0,x + 10.0,y + 15.0,color,line) >>>
        c.line(x + 14.0,y + 21.0,x + 14.0,y + 15.0,color,line) >>>
    } else if kind == ICON_BOOK {
        c.stroke_round_rect(x + 4.0,y + 4.0,16.0,17.0,2.0,color,line) >>>
        c.line(x + 8.0,y + 4.0,x + 8.0,y + 21.0,color,line) >>>
        c.line(x + 11.0,y + 9.0,x + 17.0,y + 9.0,color,line) >>>
    } else if kind == ICON_SETTINGS {
        for i in 0:3 {
            yy := y + 6.0 + f64(i) * 6.0
            c.line(x + 3.0,yy,x + 21.0,yy,color,line) >>>
            $xx := x + 8.0
            if i == 1 { xx = x + 16.0 }
            c.fill_circle(xx,yy,2.8,color) >>>
        }
    } else if kind == ICON_REFRESH {
        c.stroke_circle(x + 12.0,y + 12.0,7.0,color,line) >>>
        c.line(x + 16.0,y + 5.0,x + 19.0,y + 8.0,color,line) >>>
        c.line(x + 19.0,y + 8.0,x + 15.0,y + 10.0,color,line) >>>
    } else if kind == ICON_COPY {
        c.stroke_round_rect(x + 9.0,y + 8.0,10.0,12.0,2.0,color,line) >>>
        c.line(x + 5.0,y + 15.0,x + 5.0,y + 4.0,color,line) >>>
        c.line(x + 5.0,y + 4.0,x + 15.0,y + 4.0,color,line) >>>
    } else if kind == ICON_SEARCH {
        c.stroke_circle(x + 10.5,y + 10.5,5.5,color,line) >>>
        c.line(x + 14.5,y + 14.5,x + 20.0,y + 20.0,color,line) >>>
    } else if kind == ICON_ACTIVITY {
        c.line(x + 2.0,y + 13.0,x + 7.0,y + 13.0,color,line) >>>
        c.line(x + 7.0,y + 13.0,x + 10.0,y + 5.0,color,line) >>>
        c.line(x + 10.0,y + 5.0,x + 15.0,y + 20.0,color,line) >>>
        c.line(x + 15.0,y + 20.0,x + 18.0,y + 11.0,color,line) >>>
        c.line(x + 18.0,y + 11.0,x + 22.0,y + 11.0,color,line) >>>
    } else {
        c.stroke_circle(x + 12.0,y + 12.0,9.0,color,line) >>>
        c.line(x + 12.0,y + 6.0,x + 12.0,y + 12.0,color,line) >>>
        c.line(x + 12.0,y + 12.0,x + 16.0,y + 14.0,color,line) >>>
        if kind == ICON_FOCUS { c.fill_circle(x + 12.0,y + 12.0,2.0,color) >>> }
    }
    << 0
}

pub struct NavItem {
    pub id int
    pub label string
    pub icon int
    pub badge_count int
}

pub fn (c $&Canvas) button_tone(bounds layout.Rect,theme &Theme,label string,tone int,pressed bool) int {
    $fill := theme.surface
    $ink := theme.ink
    if tone == TONE_PRIMARY {
        fill = theme.accent
        ink = theme.on_accent
        if pressed { fill = theme.accent_pressed }
    } else if tone == TONE_DANGER {
        fill = theme.danger
        ink = theme.on_accent
        if pressed {
            if theme.dark { fill = draw.rgb(225,112,128) }
            else { fill = draw.rgb(152,24,44) }
        }
    } else if pressed {
        fill = theme.subtle_pressed
    }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,18.0,fill) >>>
    if tone == TONE_SECONDARY {
        c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,18.0,theme.border,1.0) >>>
    }
    c.label(rect(bounds.x + 16.0,bounds.y,bounds.width - 32.0,bounds.height),label,scaled_font(17.0),600,ink,draw.TEXT_CENTER) >>>
    << 0
}

pub fn (c $&Canvas) button(bounds layout.Rect,theme &Theme,label string,primary bool,pressed bool) int {
    $tone := TONE_SECONDARY
    if primary { tone = TONE_PRIMARY }
    << c.button_tone(bounds,theme,label,tone,pressed)
}

pub fn (c $&Canvas) chip(bounds layout.Rect,theme &Theme,label string,selected bool,pressed bool) int {
    $fill := theme.surface
    $ink := theme.muted
    if selected { fill = theme.accent_tint
        ink = theme.accent }
    if pressed { fill = theme.subtle_pressed }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,16.0,fill) >>>
    if !selected { c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,16.0,theme.border,1.0) >>> }
    c.label(bounds,label,scaled_font(15.0),600,ink,draw.TEXT_CENTER) >>>
    << 0
}

pub fn (c $&Canvas) navigation_items(shell &Scaffold,theme &Theme,items &[]NavItem,selected_id int,touches &Touch) int {
    nav := shell.navigation
    c.fill_rect(nav.x,nav.y,nav.width,nav.height,theme.surface) >>>
    if shell.wide { c.line(nav.width,0.0,nav.width,shell.height,theme.border,1.0) >>> }
    else { c.line(0.0,nav.y,shell.width,nav.y,theme.border,1.0) >>> }
    $count := items.len
    if count > 5 { count = 5 }
    if count <= 0 { << 0 }
    for i in 0:count {
        item := &items[i]
        bounds := tab_bounds_n(shell,count,i)
        $ink := theme.muted
        if selected_id == item.id {
            ink = theme.accent
            c.fill_round_rect(bounds.x + (bounds.width - 56.0) * 0.5,bounds.y + 2.0,56.0,32.0,16.0,theme.accent_tint) >>>
        }
        if touches.pressed(item.id) {
            c.fill_round_rect(bounds.x + 4.0,bounds.y,bounds.width - 8.0,bounds.height,16.0,theme.subtle_pressed) >>>
        }
        c.icon(rect(bounds.x,bounds.y + 4.0,bounds.width,24.0),item.icon,ink) >>>
        if item.badge_count > 0 {
            bx := bounds.x + bounds.width * 0.5 + 8.0
            c.badge_count(rect(bx,bounds.y + 2.0,26.0,18.0),theme,item.badge_count) >>>
        }
        c.label(rect(bounds.x,bounds.y + 34.0,bounds.width,24.0),item.label + "",scaled_font(12.0),600,ink,draw.TEXT_CENTER) >>>
    }
    << 0
}

pub fn (c $&Canvas) navigation(shell &Scaffold,theme &Theme,selected int,touches &Touch) int {
    items := [
        NavItem{id: 1,label: "今日",icon: ICON_HOME,badge_count: 0},
        NavItem{id: 2,label: "记录",icon: ICON_HISTORY,badge_count: 0},
        NavItem{id: 3,label: "设置",icon: ICON_SETTINGS,badge_count: 0}
    ]
    << c.navigation_items(shell,theme,&items,selected,touches)
}

pub fn (c $&Canvas) scrollbar(bounds &layout.Rect,theme &Theme,scroll f64,maximum f64,content_height f64) int {
    if maximum <= 2.0 || bounds.height < 64.0 || content_height <= bounds.height { << 0 }
    track_h := bounds.height - 16.0
    thumb_h := math.max(28.0,math.min(track_h,track_h * (bounds.height / content_height)))
    ratio := math.max(0.0,math.min(1.0,scroll / maximum))
    thumb_y := bounds.y + 8.0 + (track_h - thumb_h) * ratio
    c.fill_round_rect(bounds.x + bounds.width - 5.0,thumb_y,3.0,thumb_h,1.5,theme.border) >>>
    << 0
}

pub fn snackbar_action_bounds(bounds &layout.Rect,has_action bool) layout.Rect {
    if !has_action || bounds.width < 120.0 { << rect(0.0,0.0,0.0,0.0) }
    w := math.min(84.0,bounds.width * 0.34)
    << rect(bounds.x + bounds.width - w - 8.0,bounds.y,w,bounds.height)
}

// Compact pull-to-refresh indicator that drops down inside top pull space and
// avoids continuous spinning motion when reduced_motion is active.
pub fn (c $&Canvas) refresh_indicator_labeled(bounds layout.Rect,theme &Theme,pull f64,ready bool,reduced bool,pull_text string,release_text string) int {
    if pull <= 6.0 || bounds.width < 160.0 { << 0 }
    progress := math.max(0.0,math.min(1.0,pull / f64(REFRESH_THRESHOLD)))
    pill_w := math.min(bounds.width - 16.0,176.0)
    pill_h := 36.0
    pill_x := bounds.x + (bounds.width - pill_w) * 0.5
    pill_y := bounds.y + math.max(4.0,math.min(pull - pill_h - 6.0,bounds.height - pill_h))
    if pill_y + pill_h < bounds.y { << 0 }
    $fill := theme.surface
    $stroke := theme.border
    $ink := theme.muted
    $text := pull_text + ""
    if text.len == 0 {
        if reduced { text = "下拉可同步" } else { text = "继续下拉同步" }
    }
    if ready {
        fill = theme.accent_tint
        stroke = theme.accent
        ink = theme.accent
        text = release_text + ""
        if text.len == 0 { text = "松手立即同步" }
    }
    c.fill_round_rect(pill_x,pill_y,pill_w,pill_h,18.0,fill) >>>
    c.stroke_round_rect(pill_x,pill_y,pill_w,pill_h,18.0,stroke,1.0) >>>
    c.icon(rect(pill_x + 8.0,pill_y + 4.0,28.0,28.0),ICON_REFRESH,ink) >>>
    c.label(rect(pill_x + 40.0,pill_y + 2.0,pill_w - 52.0,pill_h - 4.0),text,scaled_font(12.0),600,ink,draw.TEXT_LEFT) >>>
    bar_w := math.max(0.0,(pill_w - 32.0) * progress)
    if bar_w > 2.0 {
        c.fill_round_rect(pill_x + 16.0,pill_y + pill_h - 4.0,bar_w,2.0,1.0,theme.accent) >>>
    }
    << 0
}

pub fn (c $&Canvas) refresh_indicator(bounds layout.Rect,theme &Theme,pull f64,ready bool,reduced bool) int {
    $idle := "继续下拉同步"
    if reduced { idle = "下拉可同步" }
    << c.refresh_indicator_labeled(bounds,theme,pull,ready,reduced,idle,"松手立即同步")
}

pub fn (c $&Canvas) snackbar(bounds &layout.Rect,theme &Theme,message string,action_label string,action_pressed bool) int {
    $fill := theme.ink
    $ink := theme.surface
    $action_color := draw.rgb(255,142,157)
    $action_tint := draw.rgb(60,29,42)
    if theme.dark {
        fill = theme.elevated
        ink = theme.ink
        action_color = theme.accent
        action_tint = theme.accent_tint
    }
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,14.0,fill) >>>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,14.0,theme.border,1.0) >>>
    has_action := action_label.len > 0
    action_rect := snackbar_action_bounds(bounds,has_action)
    $text_w := bounds.width - 32.0
    if has_action { text_w = math.max(40.0,action_rect.x - bounds.x - 16.0) }
    c.label(rect(bounds.x + 16.0,bounds.y,text_w,bounds.height),message,14.0,500,ink,draw.TEXT_LEFT) >>>
    if has_action {
        if action_pressed {
            c.fill_round_rect(action_rect.x + 4.0,action_rect.y + 6.0,action_rect.width - 8.0,action_rect.height - 12.0,10.0,action_tint) >>>
        }
        c.label(action_rect,action_label,14.0,600,action_color,draw.TEXT_CENTER) >>>
    }
    << 0
}

pub fn (c $&Canvas) row(bounds layout.Rect,theme &Theme,title string,detail string,kind int,pressed bool) int {
    if pressed { c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,16.0,theme.subtle_pressed) >>> }
    c.fill_round_rect(bounds.x + 12.0,bounds.y + 16.0,40.0,40.0,13.0,theme.accent_tint) >>>
    c.icon(rect(bounds.x + 12.0,bounds.y + 16.0,40.0,40.0),kind,theme.accent) >>>
    c.label(rect(bounds.x + 64.0,bounds.y + 12.0,bounds.width - 136.0,26.0),title,16.0,500,theme.ink,draw.TEXT_LEFT) >>>
    c.label(rect(bounds.x + 64.0,bounds.y + 38.0,bounds.width - 136.0,22.0),detail,12.0,400,theme.muted,draw.TEXT_LEFT) >>>
    << 0
}

pub fn (c $&Canvas) sheet(shell &Scaffold,theme &Theme,bounds layout.Rect,title string) int {
    c.fill_rect(0.0,0.0,shell.width,shell.height,theme.scrim) >>>
    c.fill_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,28.0,theme.surface) >>>
    c.stroke_round_rect(bounds.x,bounds.y,bounds.width,bounds.height,28.0,theme.border,1.0) >>>
    // Square the lower corners against the viewport edge.
    c.fill_rect(bounds.x,bounds.y + bounds.height - 28.0,bounds.width,28.0,theme.surface) >>>
    c.fill_round_rect(bounds.x + (bounds.width - 36.0) * 0.5,bounds.y + 10.0,36.0,4.0,2.0,theme.border) >>>
    c.label(rect(bounds.x + 24.0,bounds.y + 26.0,bounds.width - 96.0,40.0),title,21.0,600,theme.ink,draw.TEXT_LEFT) >>>
    c.icon(rect(bounds.x + bounds.width - 64.0,bounds.y + 22.0,48.0,48.0),ICON_CLOSE,theme.muted) >>>
    << 0
}

pub fn (c $&Canvas) fill_round_rect(x f64,y f64,width f64,height f64,radius f64,color draw.Color) int {
    frame := $&c.frame
    frame.fill_round_rect(x,y,width,height,radius,color) >>>
    << 0
}

