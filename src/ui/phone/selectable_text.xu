@ui/phone

#errors
#math
#strings
#ui
#ui/draw
#ui/font
#ui/layout
#unicode/utf8

pub const LOCALE_EN = 0
pub const LOCALE_ZH_CN = 1

pub const ACTION_BAR_NONE = 0
pub const ACTION_BAR_COPY = 1
pub const ACTION_BAR_CUT = 2
pub const ACTION_BAR_PASTE = 3
pub const ACTION_BAR_SELECT_ALL = 4

const SEL_DRAG_CHAR = 0
const SEL_DRAG_WORD = 1
const SEL_DRAG_LINE = 2

pub struct PhoneActionBarItem {
    pub cmd int
    pub rect layout.Rect
    pub label string
    pub enabled bool
}

pub struct PhoneActionBar {
    pub bounds layout.Rect
    pub items []PhoneActionBarItem
}

pub struct SelectableTextResult {
    pub changed bool
    pub copied bool
    pub focused bool
    pub blurred bool
    pub needs_paint bool
    pub consumed bool
}

pub struct SelectableText {
    pub id int
    pub identity ui.CanvasEvent
    context draw.Context
    pub bounds layout.Rect
    pub value string
    pub size f64
    pub weight int
    pub line_height f64
    pub align int
    pub multiline bool
    pub selectable bool
    pub focused bool
    pub anchor int
    pub focus int
    pub locale int
    clip layout.Rect
    has_bounds bool
    has_clip bool
    press_inside bool
    drag_selecting bool
    drag_mode int
    drag_word_start int
    drag_word_end int
    action_bar_open bool
    action_bar PhoneActionBar
    bar_anchor layout.Rect
    font_stack font.FontStack
    has_font_stack bool
}

fn empty_action_bar() PhoneActionBar {
    << PhoneActionBar{bounds: rect(0.0,0.0,0.0,0.0),items: []PhoneActionBarItem{}}
}

fn empty_sel_result() SelectableTextResult {
    << SelectableTextResult{changed: false,copied: false,focused: false,blurred: false,needs_paint: false,consumed: false}
}

fn copy_canvas_identity(id &ui.CanvasEvent) ui.CanvasEvent {
    << ui.CanvasEvent{window_id: id.window_id,canvas_id: id.canvas_id,generation: id.generation}
}

fn phone_clamp_int(v int,lo int,hi int) int {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

fn phone_upper_key(key int) int {
    if key >= 97 && key <= 122 { << key - 32 }
    << key
}

fn phone_copy_clipboard(identity &ui.CanvasEvent,text &string) int {
    if identity.canvas_id <= 0 || text.len == 0 { << 0 }
    options := ui.RequestOptions{timeout_ms: 5000}
    req := ui.clipboard_write_async(identity,text,&options) or (err) { << 0 }
    << req.id
}

fn phone_action_label(locale int,cmd int) string {
    if locale == LOCALE_ZH_CN {
        if cmd == ACTION_BAR_CUT { << "剪切" }
        if cmd == ACTION_BAR_COPY { << "复制" }
        if cmd == ACTION_BAR_PASTE { << "粘贴" }
        if cmd == ACTION_BAR_SELECT_ALL { << "全选" }
        << ""
    }
    if cmd == ACTION_BAR_CUT { << "Cut" }
    if cmd == ACTION_BAR_COPY { << "Copy" }
    if cmd == ACTION_BAR_PASTE { << "Paste" }
    if cmd == ACTION_BAR_SELECT_ALL { << "Select All" }
    << ""
}

fn phone_rune_step(text &string,i int) int {
    b := text[i] & 255
    if b < 128 { << 1 }
    if b < 224 { << 2 }
    if b < 240 { << 3 }
    << 4
}

fn estimate_label_width(label &string) f64 {
    $w := 20.0
    for i in 0:label.len {
        b := label[i] & 255
        if b < 128 { w += 8.0 }
        else if (b & 192) != 128 { w += 14.0 }
    }
    if w < 52.0 { << 52.0 }
    << w
}

fn make_bar_entry(locale int,cmd int,enabled bool) PhoneActionBarItem {
    lbl := phone_action_label(locale,cmd)
    lw := estimate_label_width(&lbl)
    << PhoneActionBarItem{cmd: cmd,rect: rect(0.0,0.0,lw,32.0),label: lbl,enabled: enabled}
}

fn phone_build_action_bar(anchor layout.Rect,clip layout.Rect,locale int,editable bool,has_selection bool,has_text bool,can_paste bool) PhoneActionBar {
    $bar := empty_action_bar()
    if editable {
        bar.items.push(make_bar_entry(locale,ACTION_BAR_CUT,has_selection))
        bar.items.push(make_bar_entry(locale,ACTION_BAR_COPY,has_selection))
        bar.items.push(make_bar_entry(locale,ACTION_BAR_PASTE,can_paste))
        bar.items.push(make_bar_entry(locale,ACTION_BAR_SELECT_ALL,has_text))
    } else {
        bar.items.push(make_bar_entry(locale,ACTION_BAR_COPY,has_selection))
        bar.items.push(make_bar_entry(locale,ACTION_BAR_SELECT_ALL,has_text))
    }
    $total_w := 8.0
    for i in 0:bar.items.len {
        total_w += bar.items[i].rect.width
        if i > 0 { total_w += 1.0 }
    }
    bar_h := 36.0
    $min_x := 4.0
    $min_y := 4.0
    $max_x := math.max(min_x + total_w,anchor.x + anchor.width + 120.0)
    $max_y := math.max(min_y + bar_h,anchor.y + anchor.height + 120.0)
    if clip.width > 0.0 && clip.height > 0.0 {
        min_x = clip.x + 4.0
        min_y = clip.y + 4.0
        max_x = math.max(min_x + total_w,clip.x + clip.width - 4.0)
        max_y = math.max(min_y + bar_h,clip.y + clip.height - 4.0)
    }
    $bx := anchor.x + (anchor.width - total_w) * 0.5
    if bx + total_w > max_x { bx = max_x - total_w }
    if bx < min_x { bx = min_x }
    $by := anchor.y - bar_h - 8.0
    if by < min_y { by = anchor.y + anchor.height + 8.0 }
    if by + bar_h > max_y { by = max_y - bar_h }
    if by < min_y { by = min_y }
    $x := bx + 4.0
    for i in 0:bar.items.len {
        it := bar.items[i]
        iw := it.rect.width
        bar.items[i] = PhoneActionBarItem{
            cmd: it.cmd,
            rect: rect(x,by + 2.0,iw,bar_h - 4.0),
            label: it.label,
            enabled: it.enabled
        }
        x += iw + 1.0
    }
    bar.bounds = rect(bx,by,total_w,bar_h)
    << bar
}

fn phone_action_bar_hit(bar &PhoneActionBar,x f64,y f64) int {
    if bar.bounds.width <= 0.0 || bar.bounds.height <= 0.0 || !bar.bounds.contains(x,y) { << ACTION_BAR_NONE }
    for item in bar.items {
        if item.enabled && item.rect.contains(x,y) { << item.cmd }
    }
    << ACTION_BAR_NONE
}

fn phone_paint_action_bar(c $&Canvas,t $&Touch,bar &PhoneActionBar,theme &Theme) int {
    if bar.bounds.width <= 0.0 || bar.bounds.height <= 0.0 || bar.items.len == 0 { << 0 }
    $bg := theme.surface
    if theme.dark { bg = theme.elevated }
    c.fill_round_rect(bar.bounds.x,bar.bounds.y,bar.bounds.width,bar.bounds.height,10.0,bg) or >>
    c.stroke_round_rect(bar.bounds.x,bar.bounds.y,bar.bounds.width,bar.bounds.height,10.0,theme.border,1.0) or >>
    for i in 0:bar.items.len {
        item := bar.items[i]
        if i > 0 {
            c.line(item.rect.x - 0.5,bar.bounds.y + 6.0,item.rect.x - 0.5,bar.bounds.y + bar.bounds.height - 6.0,theme.border,1.0) or >>
        }
        if t.down && !t.dragged && item.enabled && item.rect.contains(t.cur_x,t.cur_y) {
            c.fill_round_rect(item.rect.x,item.rect.y,item.rect.width,item.rect.height,7.0,theme.subtle_pressed) or >>
        }
        $fg := theme.ink
        if !item.enabled { fg = theme.muted.with_alpha(120) }
        c.label(item.rect,item.label,13.0,600,fg,draw.TEXT_CENTER) or >>
    }
    t.target(0,bar.bounds) or >>
    << 0
}

fn phone_fallback_font_stack() font.FontStack {
    $fallback := font.new_font_stack()
    fallback.ensure_builtin_fallback(1) or (err) { << font.new_font_stack() }
    << fallback
}

fn phone_text_options(size f64,weight int,line_height f64,width f64,align int) draw.TextOptions {
    $opts := draw.text_options(size)
    opts.weight = weight
    opts.align = align
    if line_height > 0.0 { opts.line_height = line_height }
    if width > 0.0 { opts.width = width }
    << opts
}

fn phone_hit_text(context &draw.Context,has_stack bool,stack &font.FontStack,text &string,size f64,weight int,line_height f64,width f64,align int,local_x f64,local_y f64) int {
    if text.len == 0 { << 0 }
    opts := phone_text_options(size,weight,line_height,width,align)
    if ui.host_tmp() != ":xu:" {
        if has_stack && stack.face_count() > 0 {
            ly := draw.layout_font_text(stack,text,&opts,false) or (err) { << text.len }
            hit := ly.hit_test(local_x,local_y) or (err) { << text.len }
            << ui.utf8_clamp_boundary(text,hit.byte_index())
        }
        fs := phone_fallback_font_stack()
        ly := draw.layout_font_text(&fs,text,&opts,false) or (err) { << text.len }
        hit := ly.hit_test(local_x,local_y) or (err) { << text.len }
        << ui.utf8_clamp_boundary(text,hit.byte_index())
    }
    $shaped := context.layout_text(text,&opts) or (err) { << text.len }
    hit := shaped.hit_test(local_x,local_y) or (err) {
        safe_dispose_text(shaped)
        << text.len
    }
    pos := ui.utf8_clamp_boundary(text,hit.byte_index())
    safe_dispose_text(shaped)
    << pos
}

fn phone_caret_rect(context &draw.Context,has_stack bool,stack &font.FontStack,text &string,size f64,weight int,line_height f64,width f64,align int,pos int) layout.Rect {
    $h := line_height
    if h <= 0.0 { h = math.ceil(size * 1.45) }
    if text.len == 0 { << rect(0.0,0.0,2.0,h) }
    opts := phone_text_options(size,weight,line_height,width,align)
    clamped := ui.utf8_clamp_boundary(text,pos)
    if ui.host_tmp() != ":xu:" {
        if has_stack && stack.face_count() > 0 {
            ly := draw.layout_font_text(stack,text,&opts,false) or (err) { << rect(0.0,0.0,2.0,h) }
            c := ly.caret(clamped,false) or (err) { << rect(0.0,0.0,2.0,h) }
            << rect(c.x,c.y,2.0,math.max(1.0,c.height))
        }
        fs := phone_fallback_font_stack()
        ly := draw.layout_font_text(&fs,text,&opts,false) or (err) { << rect(0.0,0.0,2.0,h) }
        c := ly.caret(clamped,false) or (err) { << rect(0.0,0.0,2.0,h) }
        << rect(c.x,c.y,2.0,math.max(1.0,c.height))
    }
    $shaped := context.layout_text(text,&opts) or (err) { << rect(0.0,0.0,2.0,h) }
    c := shaped.caret(clamped,false) or (err) {
        safe_dispose_text(shaped)
        << rect(0.0,0.0,2.0,h)
    }
    res := rect(c.x,c.y,2.0,math.max(1.0,c.height))
    safe_dispose_text(shaped)
    << res
}

fn phone_paint_sel_rects_font(c $&Canvas,ly &font.TextLayout,origin_x f64,origin_y f64,lo int,hi int,fill draw.Color) int {
    rects := ly.selection_rects(lo,hi) or (err) { << 0 }
    for r in rects {
        c.fill_rect(origin_x + r.x,origin_y + r.y,r.width,r.height,fill) or >>
    }
    << 0
}

fn phone_paint_sel_rects_host(c $&Canvas,shaped &draw.TextLayout,origin_x f64,origin_y f64,lo int,hi int,fill draw.Color) int {
    rects := shaped.selection_rects(lo,hi) or (err) { << 0 }
    for r in rects {
        c.fill_rect(origin_x + r.x,origin_y + r.y,r.width,r.height,fill) or >>
    }
    << 0
}

// Create a standalone selectable label or multi-line paragraph for mobile UIs.
// Supports drag selection, double-tap word, triple-tap line, long-press menu,
// and keyboard shortcuts (Cmd/Ctrl+A, Cmd/Ctrl+C, Shift+Arrows).
pub fn selectable_text(context &draw.Context,identity &ui.CanvasEvent,id int,value string,size f64,multiline bool) SelectableText {
    $lh := math.ceil(size * 1.45)
    $w := 400
    if !multiline { lh = 0.0 }
    << SelectableText{
        id: id,
        identity: copy_canvas_identity(identity),
        context: context.clone(),
        bounds: rect(0.0,0.0,0.0,0.0),
        value: value + "",
        size: size,
        weight: w,
        line_height: lh,
        align: draw.TEXT_LEFT,
        multiline: multiline,
        selectable: true,
        focused: false,
        anchor: 0,
        focus: 0,
        locale: LOCALE_EN,
        clip: rect(0.0,0.0,0.0,0.0),
        has_bounds: false,
        has_clip: false,
        press_inside: false,
        drag_selecting: false,
        drag_mode: SEL_DRAG_CHAR,
        drag_word_start: 0,
        drag_word_end: 0,
        action_bar_open: false,
        action_bar: empty_action_bar(),
        bar_anchor: rect(0.0,0.0,0.0,0.0),
        font_stack: font.new_font_stack(),
        has_font_stack: false
    }
}

pub fn (s $&SelectableText) set_value(value string) int {
    if value.len > 65536 || !utf8.valid(&value) { >> errors.new("phone: invalid UTF-8 selectable text") }
    if s.value == value { << 0 }
    s.value = value + ""
    s.anchor = ui.utf8_clamp_boundary(&s.value,phone_clamp_int(s.anchor,0,s.value.len))
    s.focus = ui.utf8_clamp_boundary(&s.value,phone_clamp_int(s.focus,0,s.value.len))
    s.action_bar_open = false
    << 0
}

pub fn (s $&SelectableText) set_style(weight int,line_height f64,align int) {
    s.weight = weight
    if line_height > 0.0 { s.line_height = line_height }
    s.align = align
}

pub fn (s $&SelectableText) set_locale(locale int) {
    if locale == LOCALE_ZH_CN { s.locale = LOCALE_ZH_CN } else { s.locale = LOCALE_EN }
}

pub fn (s $&SelectableText) set_selectable(selectable bool) {
    s.selectable = selectable
    if !selectable {
        s.anchor = s.focus
        s.press_inside = false
        s.drag_selecting = false
        s.action_bar_open = false
        s.focused = false
    }
}

pub fn (s &SelectableText) is_selectable() bool { << s.selectable }

pub fn (s &SelectableText) has_selection() bool {
    << s.selectable && s.anchor != s.focus && s.value.len > 0
}

pub fn (s &SelectableText) selected_text() string {
    if !s.has_selection() { << "" }
    lo := phone_clamp_int(int(math.min(f64(s.anchor),f64(s.focus))),0,s.value.len)
    hi := phone_clamp_int(int(math.max(f64(s.anchor),f64(s.focus))),0,s.value.len)
    << s.value[lo:hi]
}

pub fn (s $&SelectableText) select_all() int {
    if !s.selectable || s.value.len == 0 { << 0 }
    s.focused = true
    s.anchor = 0
    s.focus = s.value.len
    << 0
}

pub fn (s $&SelectableText) clear_selection() {
    s.anchor = s.focus
    s.press_inside = false
    s.drag_selecting = false
    s.action_bar_open = false
}

pub fn (s $&SelectableText) copy_selection() int {
    sel := s.selected_text()
    if sel.len == 0 { << 0 }
    << phone_copy_clipboard(&s.identity,&sel)
}

pub fn (s &SelectableText) cursor_at(x f64,y f64) int {
    if s.action_bar_open && s.action_bar.bounds.contains(x,y) { << ui.CURSOR_HAND }
    if s.selectable && s.has_bounds && s.bounds.contains(x,y) { << ui.CURSOR_TEXT }
    << ui.CURSOR_DEFAULT
}

pub fn (s &SelectableText) measure_height(c $&Canvas,width f64) f64 {
    if !s.multiline {
        << math.ceil(s.size * 1.4)
    }
    $lh := s.line_height
    if lh <= 0.0 { lh = math.ceil(s.size * 1.45) }
    m := c.measure_paragraph(&s.value,s.size,s.weight,lh,width) or (err) { << lh }
    << m
}

fn (s &SelectableText) text_origin_y() f64 {
    if s.multiline { << s.bounds.y }
    << s.bounds.y + math.max(0.0,(s.bounds.height - s.size * 1.2) * 0.5)
}

fn (s &SelectableText) layout_width() f64 {
    if !s.multiline && s.bounds.width <= 0.0 { << 0.0 }
    << math.max(1.0,s.bounds.width)
}

fn (s &SelectableText) hit_pos(x f64,y f64) int {
    if !s.has_bounds || s.value.len == 0 { << 0 }
    lx := x - s.bounds.x
    ly := y - s.text_origin_y()
    $lh := s.line_height
    if !s.multiline { lh = 0.0 }
    << phone_hit_text(&s.context,s.has_font_stack,&s.font_stack,&s.value,s.size,s.weight,lh,s.layout_width(),s.align,lx,ly)
}

fn (s &SelectableText) drag_range(pos int) ui.TextRange {
    if s.drag_mode == SEL_DRAG_WORD { << ui.text_word_range(&s.value,pos) }
    if s.drag_mode == SEL_DRAG_LINE {
        if s.multiline { << ui.text_line_range(&s.value,pos) }
        << ui.TextRange{start: 0,end: s.value.len}
    }
    << ui.TextRange{start: pos,end: pos}
}

fn (s $&SelectableText) apply_drag_pos(pos int) bool {
    prev_a := s.anchor
    prev_f := s.focus
    if s.drag_mode == SEL_DRAG_WORD || s.drag_mode == SEL_DRAG_LINE {
        r := s.drag_range(pos)
        if r.start < s.drag_word_start {
            s.anchor = s.drag_word_end
            s.focus = r.start
        } else if r.end > s.drag_word_end {
            s.anchor = s.drag_word_start
            s.focus = r.end
        } else {
            s.anchor = s.drag_word_start
            s.focus = s.drag_word_end
        }
    } else {
        s.focus = pos
    }
    << s.anchor != prev_a || s.focus != prev_f
}

fn (s $&SelectableText) update_action_bar_layout(anchor layout.Rect) {
    $clip_box := s.bounds
    if s.has_clip && s.clip.width > 0.0 && s.clip.height > 0.0 { clip_box = s.clip }
    s.bar_anchor = anchor
    s.action_bar = phone_build_action_bar(anchor,clip_box,s.locale,false,s.has_selection(),s.value.len > 0,false)
}

pub fn (s $&SelectableText) handle_long_press(touches &Touch) bool {
    if !s.selectable || !s.has_bounds || !touches.is_long_pressed() { << false }
    if !s.bounds.contains(touches.start_x,touches.start_y) { << false }
    if s.action_bar_open && s.drag_selecting { << false }
    s.focused = true
    if !s.has_selection() && s.value.len > 0 {
        pos := s.hit_pos(touches.start_x,touches.start_y)
        wr := ui.text_word_range(&s.value,pos)
        s.anchor = wr.start
        s.focus = wr.end
        s.drag_mode = SEL_DRAG_WORD
        s.drag_word_start = wr.start
        s.drag_word_end = wr.end
    }
    s.drag_selecting = touches.pointer_down()
    s.action_bar_open = true
    s.update_action_bar_layout(rect(touches.start_x - 24.0,touches.start_y - 14.0,48.0,28.0))
    << true
}

fn (s $&SelectableText) handle_key_event(input &ui.InputEvent) SelectableTextResult {
    $res := empty_sel_result()
    if !s.focused || !s.selectable || input.kind != ui.EV_KEY_DOWN { << res }
    if ui.is_clipboard_modifier(input.modifiers) && input.repeat == 0 {
        uk := phone_upper_key(input.key)
        if uk == 65 {
            _ := s.select_all()
            res.changed = true
            res.needs_paint = true
            res.consumed = true
            << res
        }
        if uk == 67 && s.has_selection() {
            _ := s.copy_selection()
            res.copied = true
            res.needs_paint = true
            res.consumed = true
            << res
        }
    }
    if input.key == ui.KEY_ESCAPE && input.repeat == 0 {
        if s.action_bar_open || s.has_selection() {
            s.clear_selection()
            res.changed = true
            res.needs_paint = true
            res.consumed = true
        }
        << res
    }
    if input.key == ui.KEY_F1 + 9 && (input.modifiers & ui.MOD_SHIFT) != 0 && input.repeat == 0 {
        s.action_bar_open = true
        s.update_action_bar_layout(s.bounds)
        res.needs_paint = true
        res.consumed = true
        << res
    }
    if (input.modifiers & ui.MOD_SHIFT) != 0 {
        focus := ui.utf8_clamp_boundary(&s.value,s.focus)
        if input.key == ui.KEY_LEFT {
            s.focus = ui.utf8_prev_char(&s.value,focus)
            res.changed = true
            res.needs_paint = true
            res.consumed = true
            << res
        }
        if input.key == ui.KEY_RIGHT {
            s.focus = ui.utf8_next_char(&s.value,focus)
            res.changed = true
            res.needs_paint = true
            res.consumed = true
            << res
        }
        if input.key == ui.KEY_HOME {
            lr := ui.text_line_range(&s.value,focus)
            s.focus = lr.start
            res.changed = true
            res.needs_paint = true
            res.consumed = true
            << res
        }
        if input.key == ui.KEY_END {
            lr := ui.text_line_range(&s.value,focus)
            s.focus = lr.end
            res.changed = true
            res.needs_paint = true
            res.consumed = true
            << res
        }
        if s.multiline && (input.key == ui.KEY_UP || input.key == ui.KEY_DOWN) {
            caret := phone_caret_rect(&s.context,s.has_font_stack,&s.font_stack,&s.value,s.size,s.weight,s.line_height,s.layout_width(),s.align,focus)
            $ty := caret.y - math.max(12.0,s.line_height) * 0.5
            if input.key == ui.KEY_DOWN { ty = caret.y + caret.height + math.max(12.0,s.line_height) * 0.5 }
            $lh := s.line_height
            if lh <= 0.0 { lh = math.ceil(s.size * 1.45) }
            s.focus = phone_hit_text(&s.context,s.has_font_stack,&s.font_stack,&s.value,s.size,s.weight,lh,s.layout_width(),s.align,caret.x,ty)
            res.changed = true
            res.needs_paint = true
            res.consumed = true
            << res
        }
    }
    << res
}

pub fn (s $&SelectableText) handle_event(event &ui.Event,touches &Touch,action int) SelectableTextResult {
    $res := empty_sel_result()
    if event.kind == ui.EV_EXIT || event.kind == ui.EV_CANVAS_CLOSED || event.kind == ui.EV_BLURRED {
        if s.focused || s.action_bar_open || s.drag_selecting || s.has_selection() {
            s.focused = false
            s.clear_selection()
            res.blurred = true
            res.needs_paint = true
        }
        << res
    }
    if s.handle_long_press(touches) {
        res.focused = true
        res.changed = true
        res.needs_paint = true
        res.consumed = true
    }
    if !ui.is_input_event(event.kind) { << res }
    input := ui.input_of(event) or (err) { << res }
    if input.window_id != s.identity.window_id || input.canvas_id != s.identity.canvas_id || input.generation != s.identity.generation {
        << res
    }
    if input.kind == ui.EV_KEY_DOWN {
        << s.handle_key_event(&input)
    }
    if !s.selectable || !s.has_bounds {
        if s.focused || s.action_bar_open || s.has_selection() {
            s.focused = false
            s.clear_selection()
            res.blurred = true
            res.needs_paint = true
        }
        << res
    }
    if input.kind == ui.EV_POINTER_DOWN {
        if s.action_bar_open && s.action_bar.bounds.contains(input.x,input.y) {
            res.consumed = true
            << res
        }
        if input.button == ui.BUTTON_RIGHT && s.bounds.contains(input.x,input.y) {
            was_focused := s.focused
            s.focused = true
            s.action_bar_open = true
            if !s.has_selection() {
                pos := s.hit_pos(input.x,input.y)
                s.anchor = pos
                s.focus = pos
            }
            s.update_action_bar_layout(rect(input.x - 16.0,input.y - 12.0,32.0,24.0))
            res.focused = !was_focused
            res.needs_paint = true
            res.consumed = true
            << res
        }
        if input.button == ui.BUTTON_LEFT && s.bounds.contains(input.x,input.y) {
            was_focused := s.focused
            s.focused = true
            s.press_inside = true
            s.action_bar_open = false
            pos := s.hit_pos(input.x,input.y)
            clicks := touches.click_count()
            if (input.modifiers & ui.MOD_SHIFT) != 0 {
                s.drag_mode = SEL_DRAG_CHAR
                s.focus = pos
                s.drag_selecting = true
                res.changed = true
            } else if clicks == 2 {
                wr := ui.text_word_range(&s.value,pos)
                s.drag_mode = SEL_DRAG_WORD
                s.drag_word_start = wr.start
                s.drag_word_end = wr.end
                s.anchor = wr.start
                s.focus = wr.end
                s.drag_selecting = true
                res.changed = true
            } else if clicks >= 3 {
                s.drag_mode = SEL_DRAG_LINE
                lr := s.drag_range(pos)
                s.drag_word_start = lr.start
                s.drag_word_end = lr.end
                s.anchor = lr.start
                s.focus = lr.end
                s.drag_selecting = true
                res.changed = true
            } else {
                s.drag_mode = SEL_DRAG_CHAR
                if s.anchor != pos || s.focus != pos {
                    s.anchor = pos
                    s.focus = pos
                    res.changed = true
                }
            }
            res.focused = !was_focused
            res.needs_paint = true
            res.consumed = true
            << res
        }
        if s.focused || s.action_bar_open || s.has_selection() {
            s.focused = false
            s.clear_selection()
            res.blurred = true
            res.needs_paint = true
        }
        << res
    }
    if input.kind == ui.EV_POINTER_MOVE {
        if input.buttons == 0 {
            if s.bounds.contains(input.x,input.y) {
                _ := draw.set_cursor(ui.CURSOR_TEXT)
            } else if s.action_bar_open && s.action_bar.bounds.contains(input.x,input.y) {
                _ := draw.set_cursor(ui.CURSOR_HAND)
            }
        }
        if (s.drag_selecting || (s.press_inside && touches.is_selection_drag())) && touches.drag_axis != DRAG_VERTICAL {
            s.drag_selecting = true
            s.focused = true
            pos := s.hit_pos(input.x,input.y)
            if s.apply_drag_pos(pos) {
                res.changed = true
                res.needs_paint = true
            }
            res.consumed = true
            << res
        }
        << res
    }
    if input.kind == ui.EV_POINTER_UP {
        if s.action_bar_open && input.button == ui.BUTTON_LEFT && !touches.was_dragged() {
            cmd := phone_action_bar_hit(&s.action_bar,input.x,input.y)
            if cmd == ACTION_BAR_COPY {
                _ := s.copy_selection()
                s.action_bar_open = false
                res.copied = true
                res.needs_paint = true
                res.consumed = true
                << res
            }
            if cmd == ACTION_BAR_SELECT_ALL {
                _ := s.select_all()
                s.action_bar_open = true
                s.update_action_bar_layout(s.bounds)
                res.changed = true
                res.needs_paint = true
                res.consumed = true
                << res
            }
        }
        if s.drag_selecting || s.press_inside {
            was_dragging := s.drag_selecting
            s.drag_selecting = false
            s.press_inside = false
            if s.has_selection() && (was_dragging || touches.is_long_pressed() || touches.click_count() >= 2) {
                s.action_bar_open = true
                s.update_action_bar_layout(rect(math.min(touches.start_x,input.x),math.min(touches.start_y,input.y),math.max(24.0,math.abs(input.x - touches.start_x)),math.max(24.0,math.abs(input.y - touches.start_y))))
                res.needs_paint = true
            }
            res.consumed = true
            << res
        }
    }
    << res
}

pub fn (s $&SelectableText) set_font_stack(stack font.FontStack) {
    s.font_stack = stack
    s.has_font_stack = s.font_stack.face_count() > 0
}

pub fn (s $&SelectableText) add_ttf_bytes(ttf_bytes &[]u8,font_index int,face_id int) int {
    r := draw.add_ttf_face($&s.font_stack,ttf_bytes,font_index,face_id) or >>
    s.has_font_stack = s.font_stack.face_count() > 0
    << r
}

fn (s $&SelectableText) ensure_font_stack() {
    if s.font_stack.face_count() == 0 {
        stack := $&s.font_stack
        stack.ensure_builtin_fallback(1) or (err) { << }
    }
    s.has_font_stack = s.font_stack.face_count() > 0
}

pub fn (s $&SelectableText) draw(c $&Canvas,t $&Touch,bounds layout.Rect,clip &layout.Rect,theme &Theme,color draw.Color) f64 {
    if bounds.width <= 0.0 || bounds.height <= 0.0 { << 0.0 }
    c.ensure_font_stack() or >>
    if !s.has_font_stack && c.font_stack.face_count() > 0 {
        s.set_font_stack(c.font_stack.clone())
    } else {
        s.ensure_font_stack()
    }
    s.bounds = bounds
    s.clip = rect(clip.x,clip.y,clip.width,clip.height)
    s.has_bounds = true
    s.has_clip = clip.width > 0.0 && clip.height > 0.0
    if s.selectable {
        t.selection_region(intersection(&bounds,clip),s.focused)
        if s.id > 0 { t.target(s.id,intersection(&bounds,clip)) or >> }
    }

    $lo := 0
    $hi := 0
    has_sel := s.has_selection()
    if has_sel {
        lo = phone_clamp_int(int(math.min(f64(s.anchor),f64(s.focus))),0,s.value.len)
        hi = phone_clamp_int(int(math.max(f64(s.anchor),f64(s.focus))),0,s.value.len)
    }

    $lh := s.line_height
    if !s.multiline { lh = 0.0 }
    else if lh <= 0.0 { lh = math.ceil(s.size * 1.45) }
    $measured := s.bounds.height
    origin_y := s.text_origin_y()
    opts := phone_text_options(s.size,s.weight,lh,s.bounds.width,s.align)

    if ui.host_tmp() != ":xu:" {
        ly := draw.layout_font_text(&c.font_stack,&s.value,&opts,false) or >>
        measured = ly.metrics.height
        c.push() or >>
        c.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or (err) {
            safe_pop(c)
            >> err
        }
        if has_sel {
            phone_paint_sel_rects_font(c,&ly,bounds.x,origin_y,lo,hi,theme.accent_tint) or (err) {
                safe_pop(c)
                >> err
            }
        }
        frame := $&c.frame
        frame.text_font_layout(&ly,&s.value,bounds.x,origin_y,color) or (err) {
            safe_pop(c)
            >> err
        }
        c.pop() or >>
    } else {
        $shaped := c.context.layout_text(&s.value,&opts) or >>
        measured = shaped.metrics.height
        c.push() or (err) {
            safe_dispose_text(shaped)
            >> err
        }
        c.clip_rect(bounds.x,bounds.y,bounds.width,bounds.height) or (err) {
            safe_pop(c)
            safe_dispose_text(shaped)
            >> err
        }
        if has_sel {
            phone_paint_sel_rects_host(c,&shaped,bounds.x,origin_y,lo,hi,theme.accent_tint) or (err) {
                safe_pop(c)
                safe_dispose_text(shaped)
                >> err
            }
        }
        c.put_text(shaped,bounds.x,origin_y,color) or (err) {
            safe_pop(c)
            >> err
        }
        c.pop() or >>
    }

    if s.action_bar_open && s.selectable {
        $anchor := s.bar_anchor
        if anchor.width <= 0.0 || anchor.height <= 0.0 { anchor = bounds }
        s.update_action_bar_layout(anchor)
        phone_paint_action_bar(c,t,&s.action_bar,theme) or >>
    }
    if s.multiline { << math.min(bounds.height,measured) }
    << bounds.height
}
