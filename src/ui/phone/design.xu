@ui/phone

#errors
#math
#ui/draw
#ui/layout

// Logical points/DIP inside the host's safe area. Phone components never add
// another status-bar or home-indicator inset on top of that viewport.
pub const TOUCH_SIZE = 48
pub const PAGE_PADDING = 20
pub const ROW_HEIGHT = 72
pub const REFRESH_THRESHOLD = 64
pub const TAB_HOME = 1
pub const TAB_HISTORY = 2
pub const TAB_SETTINGS = 3
pub const BADGE_NEUTRAL = 0
pub const BADGE_INFO = 1
pub const BADGE_POSITIVE = 2
pub const BADGE_WARNING = 3
pub const BADGE_DANGER = 4
pub const SWITCH_WIDTH = 44
pub const SWITCH_HEIGHT = 24
pub const SLIDER_THUMB = 24
pub const PROGRESS_HEIGHT = 6
pub const DIALOG_RADIUS = 16

pub fn refresh_threshold() f64 { << f64(REFRESH_THRESHOLD) }
pub fn switch_width() f64 { << f64(SWITCH_WIDTH) }
pub fn switch_height() f64 { << f64(SWITCH_HEIGHT) }
pub fn slider_thumb() f64 { << f64(SLIDER_THUMB) }
pub fn progress_height() f64 { << f64(PROGRESS_HEIGHT) }
pub fn dialog_radius() f64 { << f64(DIALOG_RADIUS) }

pub struct Theme {
    pub dark bool
    pub background draw.Color
    pub surface draw.Color
    pub elevated draw.Color
    pub subtle draw.Color
    pub subtle_pressed draw.Color
    pub ink draw.Color
    pub muted draw.Color
    pub border draw.Color
    pub control_border draw.Color
    pub accent draw.Color
    pub accent_hover draw.Color
    pub accent_pressed draw.Color
    pub accent_tint draw.Color
    pub on_accent draw.Color
    pub positive draw.Color
    pub positive_soft draw.Color
    pub warning draw.Color
    pub warning_soft draw.Color
    pub danger draw.Color
    pub danger_soft draw.Color
    pub info draw.Color
    pub info_soft draw.Color
    pub focus draw.Color
    pub scrim draw.Color
}

// Paper / Obsidian / Cinnabar tokens synchronized with xu-ui-design.
pub fn light_theme() Theme {
    << Theme{dark: false,background: draw.rgb(246,243,239),surface: draw.rgb(255,253,251),
        elevated: draw.rgb(238,235,231),subtle: draw.rgb(232,227,223),subtle_pressed: draw.rgb(228,222,217),
        ink: draw.rgb(40,35,41),muted: draw.rgb(109,98,110),border: draw.rgb(217,208,217),
        control_border: draw.rgb(133,121,135),accent: draw.rgb(190,18,60),accent_hover: draw.rgb(159,18,57),
        accent_pressed: draw.rgb(136,19,55),accent_tint: draw.rgb(252,228,235),
        on_accent: draw.rgb(255,248,250),positive: draw.rgb(20,103,71),positive_soft: draw.rgb(225,242,233),
        warning: draw.rgb(133,80,8),warning_soft: draw.rgb(252,240,214),danger: draw.rgb(184,33,56),
        danger_soft: draw.rgb(251,230,233),info: draw.rgb(27,100,143),info_soft: draw.rgb(227,241,250),
        focus: draw.rgb(0,95,158),scrim: draw.rgba(32,21,34,128)}
}

pub fn dark_theme() Theme {
    << Theme{dark: true,background: draw.rgb(16,14,18),surface: draw.rgb(25,22,28),
        elevated: draw.rgb(35,31,39),subtle: draw.rgb(44,39,49),subtle_pressed: draw.rgb(20,17,22),
        ink: draw.rgb(245,240,237),muted: draw.rgb(179,170,182),border: draw.rgb(62,54,69),
        control_border: draw.rgb(138,126,144),accent: draw.rgb(255,82,116),accent_hover: draw.rgb(255,118,144),
        accent_pressed: draw.rgb(237,69,103),accent_tint: draw.rgb(60,29,42),
        on_accent: draw.rgb(25,12,18),positive: draw.rgb(111,219,172),positive_soft: draw.rgb(21,51,40),
        warning: draw.rgb(245,197,109),warning_soft: draw.rgb(60,48,26),danger: draw.rgb(255,142,157),
        danger_soft: draw.rgb(60,32,40),info: draw.rgb(133,201,244),info_soft: draw.rgb(26,45,61),
        focus: draw.rgb(168,217,255),scrim: draw.rgba(8,6,11,201)}
}

pub fn host_theme() Theme {
    if system_dark() { << dark_theme() }
    << light_theme()
}

pub fn scaled_font(base f64) f64 {
    if !finite(base) || base <= 0.0 { << 10.0 }
    << math.max(10.0,base * font_scale())
}

pub fn scaled_line(base f64) f64 {
    << math.ceil(scaled_font(base) * 1.45)
}

pub fn scaled_row_height(base f64) f64 {
    if !finite(base) || base <= 0.0 { << f64(ROW_HEIGHT) }
    s := font_scale()
    if s <= 1.0 { << base }
    << math.ceil(base * s)
}

pub struct VisibleRange {
    pub start int
    pub end int
    pub top_offset f64
    pub total_height f64
}

pub fn visible_range(scroll f64,viewport_height f64,item_height f64,item_gap f64,count int,overscan int) VisibleRange {
    if count <= 0 || !finite(item_height) || item_height <= 0.0 {
        << VisibleRange{start: 0,end: 0,top_offset: 0.0,total_height: 0.0}
    }
    $gap := item_gap
    if !finite(gap) || gap < 0.0 { gap = 0.0 }
    stride := item_height + gap
    total_h := f64(count) * item_height + f64(count - 1) * gap
    $sc := scroll
    if !finite(sc) || sc < 0.0 { sc = 0.0 }
    $vh := viewport_height
    if !finite(vh) || vh < 0.0 { vh = 0.0 }
    $ov := overscan
    if ov < 0 { ov = 0 }
    $start := int(math.floor(sc / stride)) - ov
    if start < 0 { start = 0 }
    if start > count { start = count }
    $end := int(math.ceil((sc + vh) / stride)) + ov
    if end < start { end = start }
    if end > count { end = count }
    << VisibleRange{start: start,end: end,top_offset: f64(start) * stride,total_height: total_h}
}

pub fn rect(x f64,y f64,width f64,height f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: width,height: height}
}

pub struct Scaffold {
    pub width f64
    pub height f64
    pub wide bool
    pub safe Insets
    pub header layout.Rect
    pub body layout.Rect
    pub navigation layout.Rect
    pub action layout.Rect
}

fn finite(value f64) bool { << !math.is_nan(value) && !math.is_inf(value) }

// Edge-to-edge layout inside width/height while placing interactive controls inside safe.
pub fn scaffold_with(width f64,height f64,safe Insets) Scaffold {
    if !finite(width) || !finite(height) || width < 240.0 || height < 240.0 ||
       width > 16384.0 || height > 16384.0 { >>> errors.new("phone: viewport must be finite and at least 240 by 240") }
    wide := width >= 640.0 && width > height
    top_y := safe.top + 8.0
    if wide {
        rail_w := safe.left + 80.0
        x := math.max(safe.left + 100.0,rail_w + f64(PAGE_PADDING))
        body_width := math.max(120.0,width - x - safe.right - f64(PAGE_PADDING))
        left := math.min(320.0,(body_width - 20.0) * 0.48)
        bottom_clear := safe.bottom_clearance()
        action_y := math.max(top_y + 68.0,height - bottom_clear - 72.0)
        body_h := math.max(0.0,height - bottom_clear - (top_y + 68.0) - 16.0)
        << Scaffold{width: width,height: height,wide: true,safe: safe,
            header: rect(x,top_y,body_width,56.0),body: rect(x,top_y + 68.0,body_width,body_h),
            navigation: rect(0.0,0.0,rail_w,height),action: rect(x,action_y,left,56.0)}
    }
    inner_avail := math.max(120.0,width - safe.left - safe.right - f64(PAGE_PADDING) * 2.0)
    body_width := math.min(560.0,inner_avail)
    x := safe.left + math.max(f64(PAGE_PADDING),(width - safe.left - safe.right - body_width) * 0.5)
    nav_h := 76.0 + safe.bottom
    nav_y := height - nav_h
    bottom_dock := math.max(nav_h,safe.ime_bottom)
    action_y := math.max(top_y + 88.0,height - bottom_dock - 72.0)
    body_h := math.max(0.0,action_y - (top_y + 88.0) - 16.0)
    << Scaffold{width: width,height: height,wide: false,safe: safe,
        header: rect(x,top_y,body_width,72.0),body: rect(x,top_y + 88.0,body_width,body_h),
        navigation: rect(0.0,nav_y,width,nav_h),action: rect(x,action_y,body_width,56.0)}
}

// A bottom tab bar and thumb-reachable action in portrait; a navigation rail
// and two-pane body when a short, wide viewport would waste vertical space.
pub fn scaffold(width f64,height f64) Scaffold {
    << scaffold_with(width,height,insets_zero())
}

pub fn tab_bounds_n(shell &Scaffold,count int,index int) layout.Rect {
    $n := count
    if n < 2 { n = 2 }
    if n > 5 { n = 5 }
    $idx := index
    if idx < 0 { idx = 0 }
    if idx >= n { idx = n - 1 }
    if shell.wide {
        $item_h := 64.0
        $gap := 8.0
        if n >= 5 {
            item_h = 56.0
            gap = 4.0
        }
        total_h := f64(n) * item_h + f64(n - 1) * gap
        top := math.max(shell.safe.top + 8.0,math.min(shell.safe.top + 80.0,(shell.height - total_h) * 0.5))
        << rect(shell.safe.left + 8.0,top + f64(idx) * (item_h + gap),64.0,item_h)
    }
    avail := math.max(144.0,shell.width - shell.safe.left - shell.safe.right)
    $max_w := 440.0
    if n > 3 { max_w = 560.0 }
    width := math.min(max_w,avail)
    start := shell.safe.left + (avail - width) * 0.5
    item_w := width / f64(n)
    << rect(start + f64(idx) * item_w,shell.navigation.y + 6.0,item_w,64.0)
}

pub fn tab_bounds(shell &Scaffold,index int) layout.Rect {
    << tab_bounds_n(shell,3,index)
}

pub fn app_bar_back_bounds(bounds &layout.Rect) layout.Rect {
    size := f64(TOUCH_SIZE)
    y := bounds.y + math.max(0.0,(bounds.height - size) * 0.5)
    << rect(bounds.x,y,size,size)
}

pub fn app_bar_action_bounds(bounds &layout.Rect) layout.Rect {
    size := f64(TOUCH_SIZE)
    y := bounds.y + math.max(0.0,(bounds.height - size) * 0.5)
    << rect(bounds.x + bounds.width - size,y,size,size)
}

pub fn sheet_bounds(width f64,height f64,preferred_height f64) layout.Rect {
    sheet_width := math.min(520.0,width)
    sheet_height := math.max(0.0,math.min(preferred_height,height - 12.0))
    << rect((width - sheet_width) * 0.5,height - sheet_height,sheet_width,sheet_height)
}

pub fn sheet_bounds_with(shell &Scaffold,preferred_height f64) layout.Rect {
    sheet_width := math.min(520.0,shell.width)
    x := (shell.width - sheet_width) * 0.5
    if shell.safe.ime_bottom > shell.safe.bottom {
        bottom_edge := math.max(shell.safe.top + 48.0,shell.height - shell.safe.ime_bottom)
        max_h := math.max(0.0,bottom_edge - shell.safe.top - 12.0)
        h := math.max(0.0,math.min(preferred_height,max_h))
        << rect(x,bottom_edge - h,sheet_width,h)
    }
    max_content := math.max(0.0,shell.height - shell.safe.top - shell.safe.bottom - 12.0)
    content_h := math.max(0.0,math.min(preferred_height,max_content))
    y := shell.height - shell.safe.bottom - content_h
    << rect(x,y,sheet_width,content_h + shell.safe.bottom)
}

pub fn snackbar_bounds(shell &Scaffold) layout.Rect {
    if shell.wide {
        right_x := shell.body.x + shell.action.width + 20.0
        right_w := math.max(180.0,shell.body.width - shell.action.width - 20.0)
        y := math.max(shell.safe.top + 12.0,shell.height - shell.safe.bottom_clearance() - 60.0)
        << rect(right_x,y,right_w,48.0)
    }
    w := math.min(480.0,shell.action.width)
    x := shell.action.x + (shell.action.width - w) * 0.5
    y := math.max(shell.safe.top + 12.0,shell.action.y - 60.0)
    << rect(x,y,w,48.0)
}

pub fn intersection(a &layout.Rect,b &layout.Rect) layout.Rect {
    x := math.max(a.x,b.x)
    y := math.max(a.y,b.y)
    << rect(x,y,math.max(0.0,math.min(a.x + a.width,b.x + b.width) - x),
        math.max(0.0,math.min(a.y + a.height,b.y + b.height) - y))
}

pub fn dialog_bounds(width f64,height f64,safe Insets,ime_bottom f64,dialog_height f64) layout.Rect {
    avail_w := math.max(0.0,width - safe.left - safe.right - 2.0 * f64(PAGE_PADDING))
    dw := math.min(360.0,avail_w)
    x := safe.left + (width - safe.left - safe.right - dw) / 2.0
    top_pad := safe.top + 16.0
    bottom_pad := math.max(safe.bottom,ime_bottom) + 16.0
    avail_h := math.max(0.0,height - top_pad - bottom_pad)
    dh := math.min(math.max(160.0,dialog_height),avail_h)
    y := top_pad + (avail_h - dh) / 2.0
    << rect(x,y,dw,dh)
}

pub fn dialog_button_bounds(dialog &layout.Rect,which int) layout.Rect {
    pad := 20.0
    gap := 12.0
    btn_h := f64(TOUCH_SIZE)
    btn_w := math.max(0.0,(dialog.width - 2.0 * pad - gap) / 2.0)
    y := dialog.y + dialog.height - pad - btn_h
    $x := dialog.x + pad
    if which != 0 { x = dialog.x + pad + btn_w + gap }
    << rect(x,y,btn_w,btn_h)
}

pub fn segmented_item_bounds(bounds &layout.Rect,count int,index int) layout.Rect {
    $n := count
    if n < 1 { n = 1 }
    pad := 4.0
    gap := 4.0
    inner_w := math.max(0.0,bounds.width - 2.0 * pad - gap * f64(n - 1))
    item_w := inner_w / f64(n)
    $idx := index
    if idx < 0 { idx = 0 }
    if idx >= n { idx = n - 1 }
    << rect(bounds.x + pad + f64(idx) * (item_w + gap),bounds.y + pad,item_w,math.max(0.0,bounds.height - 2.0 * pad))
}

pub fn slider_value_at(bounds &layout.Rect,x f64,min_val f64,max_val f64,step f64) f64 {
    if max_val <= min_val { << min_val }
    pad := slider_thumb() / 2.0
    track_x := bounds.x + pad
    track_w := math.max(1.0,bounds.width - 2.0 * pad)
    ratio := math.max(0.0,math.min(1.0,(x - track_x) / track_w))
    $value := min_val + ratio * (max_val - min_val)
    if step > 0.0 {
        steps := int((value - min_val) / step + 0.5)
        value = math.max(min_val,math.min(max_val,min_val + f64(steps) * step))
    }
    << value
}

pub struct ActionSheetItem {
    pub id int
    pub label string
    pub icon int
    pub destructive bool
}

pub fn search_bar_clear_bounds(bounds &layout.Rect) layout.Rect {
    if bounds.width < 88.0 || bounds.height <= 0.0 { << rect(0.0,0.0,0.0,0.0) }
    w := math.min(48.0,math.max(44.0,bounds.height))
    << rect(bounds.x + bounds.width - w,bounds.y,w,bounds.height)
}

pub fn action_sheet_bounds(shell &Scaffold,item_count int,has_title bool,has_cancel bool) layout.Rect {
    $count := item_count
    if count < 0 { count = 0 }
    $pref := 20.0 + f64(count) * 52.0
    if has_title { pref += 44.0 }
    if has_cancel { pref += 64.0 } else { pref += 12.0 }
    << sheet_bounds_with(shell,pref)
}

pub fn action_sheet_item_bounds(sheet &layout.Rect,has_title bool,index int) layout.Rect {
    $y := sheet.y + 20.0
    if has_title { y += 44.0 }
    y += f64(index) * 52.0
    << rect(sheet.x + 16.0,y,math.max(0.0,sheet.width - 32.0),52.0)
}

pub fn action_sheet_cancel_bounds(sheet &layout.Rect,item_count int,has_title bool) layout.Rect {
    $count := item_count
    if count < 0 { count = 0 }
    $y := sheet.y + 20.0
    if has_title { y += 44.0 }
    y += f64(count) * 52.0 + 8.0
    << rect(sheet.x + 16.0,y,math.max(0.0,sheet.width - 32.0),f64(TOUCH_SIZE))
}
