@ui/phone

#errors
#math
#ui/draw
#ui/layout

// Logical points/DIP inside the host's safe area. Phone components never add
// another status-bar or home-indicator inset on top of that viewport.
pub const TOUCH_SIZE = 48
pub const PAGE_PADDING = 20
pub const ROW_HEIGHT = 72
pub const TAB_HOME = 1
pub const TAB_HISTORY = 2
pub const TAB_SETTINGS = 3

pub struct Theme {
    pub dark bool
    pub background draw.Color
    pub surface draw.Color
    pub elevated draw.Color
    pub subtle draw.Color
    pub subtle_pressed draw.Color
    pub ink draw.Color
    pub muted draw.Color
    pub border draw.Color
    pub accent draw.Color
    pub accent_pressed draw.Color
    pub accent_tint draw.Color
    pub on_accent draw.Color
    pub positive draw.Color
    pub danger draw.Color
    pub danger_soft draw.Color
    pub focus draw.Color
    pub scrim draw.Color
}

// Paper / Obsidian / Cinnabar tokens synchronized with xu-ui-design.
pub fn light_theme() Theme {
    << Theme{dark: false,background: draw.rgb(246,243,239),surface: draw.rgb(255,253,251),
        elevated: draw.rgb(238,235,231),subtle: draw.rgb(232,227,223),subtle_pressed: draw.rgb(228,222,217),
        ink: draw.rgb(40,35,41),muted: draw.rgb(109,98,110),border: draw.rgb(217,208,217),
        accent: draw.rgb(190,18,60),accent_pressed: draw.rgb(136,19,55),accent_tint: draw.rgb(252,228,235),
        on_accent: draw.rgb(255,248,250),positive: draw.rgb(20,103,71),danger: draw.rgb(184,33,56),
        danger_soft: draw.rgb(251,230,233),focus: draw.rgb(190,18,60),scrim: draw.rgba(32,21,34,128)}
}

pub fn dark_theme() Theme {
    << Theme{dark: true,background: draw.rgb(16,14,18),surface: draw.rgb(25,22,28),
        elevated: draw.rgb(35,31,39),subtle: draw.rgb(44,39,49),subtle_pressed: draw.rgb(20,17,22),
        ink: draw.rgb(245,240,237),muted: draw.rgb(179,170,182),border: draw.rgb(62,54,69),
        accent: draw.rgb(255,82,116),accent_pressed: draw.rgb(237,69,103),accent_tint: draw.rgb(60,29,42),
        on_accent: draw.rgb(25,12,18),positive: draw.rgb(111,219,172),danger: draw.rgb(255,142,157),
        danger_soft: draw.rgb(60,32,40),focus: draw.rgb(255,82,116),scrim: draw.rgba(8,6,11,201)}
}

pub fn rect(x f64,y f64,width f64,height f64) layout.Rect {
    << layout.Rect{x: x,y: y,width: width,height: height}
}

pub struct Scaffold {
    pub width f64
    pub height f64
    pub wide bool
    pub safe Insets
    pub header layout.Rect
    pub body layout.Rect
    pub navigation layout.Rect
    pub action layout.Rect
}

fn finite(value f64) bool { << !math.is_nan(value) && !math.is_inf(value) }

// Edge-to-edge layout inside width/height while placing interactive controls inside safe.
pub fn scaffold_with(width f64,height f64,safe Insets) Scaffold {
    if !finite(width) || !finite(height) || width < 240.0 || height < 240.0 ||
       width > 16384.0 || height > 16384.0 { >> errors.new("phone: viewport must be finite and at least 240 by 240") }
    wide := width >= 640.0 && width > height
    top_y := safe.top + 8.0
    if wide {
        rail_w := safe.left + 80.0
        x := math.max(safe.left + 100.0,rail_w + f64(PAGE_PADDING))
        body_width := math.max(120.0,width - x - safe.right - f64(PAGE_PADDING))
        left := math.min(320.0,(body_width - 20.0) * 0.48)
        bottom_clear := safe.bottom_clearance()
        action_y := math.max(top_y + 68.0,height - bottom_clear - 72.0)
        body_h := math.max(0.0,height - bottom_clear - (top_y + 68.0) - 16.0)
        << Scaffold{width: width,height: height,wide: true,safe: safe,
            header: rect(x,top_y,body_width,56.0),body: rect(x,top_y + 68.0,body_width,body_h),
            navigation: rect(0.0,0.0,rail_w,height),action: rect(x,action_y,left,56.0)}
    }
    inner_avail := math.max(120.0,width - safe.left - safe.right - f64(PAGE_PADDING) * 2.0)
    body_width := math.min(560.0,inner_avail)
    x := safe.left + math.max(f64(PAGE_PADDING),(width - safe.left - safe.right - body_width) * 0.5)
    nav_h := 76.0 + safe.bottom
    nav_y := height - nav_h
    bottom_dock := math.max(nav_h,safe.ime_bottom)
    action_y := math.max(top_y + 88.0,height - bottom_dock - 72.0)
    body_h := math.max(0.0,action_y - (top_y + 88.0) - 16.0)
    << Scaffold{width: width,height: height,wide: false,safe: safe,
        header: rect(x,top_y,body_width,72.0),body: rect(x,top_y + 88.0,body_width,body_h),
        navigation: rect(0.0,nav_y,width,nav_h),action: rect(x,action_y,body_width,56.0)}
}

// A bottom tab bar and thumb-reachable action in portrait; a navigation rail
// and two-pane body when a short, wide viewport would waste vertical space.
pub fn scaffold(width f64,height f64) Scaffold {
    << scaffold_with(width,height,insets_zero())
}

pub fn tab_bounds(shell &Scaffold,index int) layout.Rect {
    if shell.wide {
        top := math.max(shell.safe.top + 8.0,math.min(shell.safe.top + 80.0,(shell.height - 208.0) * 0.5))
        << rect(shell.safe.left + 8.0,top + f64(index) * 72.0,64.0,64.0) }
    avail := math.max(144.0,shell.width - shell.safe.left - shell.safe.right)
    width := math.min(440.0,avail)
    start := shell.safe.left + (avail - width) * 0.5
    << rect(start + f64(index) * width / 3.0,shell.navigation.y + 6.0,width / 3.0,64.0)
}

pub fn sheet_bounds(width f64,height f64,preferred_height f64) layout.Rect {
    sheet_width := math.min(520.0,width)
    sheet_height := math.max(0.0,math.min(preferred_height,height - 12.0))
    << rect((width - sheet_width) * 0.5,height - sheet_height,sheet_width,sheet_height)
}

pub fn sheet_bounds_with(shell &Scaffold,preferred_height f64) layout.Rect {
    sheet_width := math.min(520.0,shell.width)
    x := (shell.width - sheet_width) * 0.5
    if shell.safe.ime_bottom > shell.safe.bottom {
        bottom_edge := math.max(shell.safe.top + 48.0,shell.height - shell.safe.ime_bottom)
        max_h := math.max(0.0,bottom_edge - shell.safe.top - 12.0)
        h := math.max(0.0,math.min(preferred_height,max_h))
        << rect(x,bottom_edge - h,sheet_width,h)
    }
    max_content := math.max(0.0,shell.height - shell.safe.top - shell.safe.bottom - 12.0)
    content_h := math.max(0.0,math.min(preferred_height,max_content))
    y := shell.height - shell.safe.bottom - content_h
    << rect(x,y,sheet_width,content_h + shell.safe.bottom)
}

pub fn snackbar_bounds(shell &Scaffold) layout.Rect {
    if shell.wide {
        right_x := shell.body.x + shell.action.width + 20.0
        right_w := math.max(180.0,shell.body.width - shell.action.width - 20.0)
        y := math.max(shell.safe.top + 12.0,shell.height - shell.safe.bottom_clearance() - 60.0)
        << rect(right_x,y,right_w,48.0)
    }
    w := math.min(480.0,shell.action.width)
    x := shell.action.x + (shell.action.width - w) * 0.5
    y := math.max(shell.safe.top + 12.0,shell.action.y - 60.0)
    << rect(x,y,w,48.0)
}

pub fn intersection(a &layout.Rect,b &layout.Rect) layout.Rect {
    x := math.max(a.x,b.x)
    y := math.max(a.y,b.y)
    << rect(x,y,math.max(0.0,math.min(a.x + a.width,b.x + b.width) - x),
        math.max(0.0,math.min(a.y + a.height,b.y + b.height) - y))
}
