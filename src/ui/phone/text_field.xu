@ui/phone

#errors
#math
#ui
#ui/draw
#ui/layout
#unicode/utf8

pub const FIELD_HEIGHT = 48

pub fn text_field_height() f64 { << f64(FIELD_HEIGHT) }

pub struct TextField {
    pub id int
    pub clear_id int
    pub identity ui.CanvasEvent
    context draw.Context
    pub bounds layout.Rect
    pub focused bool
    pub enabled bool
    pub error string
    pub placeholder string
    pub value string
    pub anchor int
    pub focus int
    pub revision int
    pub composing bool
    pub preedit string
    pub replacement_start int
    pub replacement_end int
    pub preedit_anchor int
    pub preedit_focus int
    pub offset_x f64
    session ui.TextInput
}

pub struct TextFieldResult {
    pub changed bool
    pub submitted bool
    pub blurred bool
    pub cleared bool
    pub needs_paint bool
}

fn copy_identity(id &ui.CanvasEvent) ui.CanvasEvent {
    << ui.CanvasEvent{window_id: id.window_id,canvas_id: id.canvas_id,generation: id.generation}
}

pub fn text_field(context &draw.Context,identity &ui.CanvasEvent,id int,clear_id int,placeholder string) TextField {
    << TextField{
        id: id,
        clear_id: clear_id,
        identity: copy_identity(identity),
        context: context.clone(),
        bounds: rect(0.0,0.0,200.0,f64(FIELD_HEIGHT)),
        focused: false,
        enabled: true,
        error: "",
        placeholder: placeholder + "",
        value: "",
        anchor: 0,
        focus: 0,
        revision: 0,
        composing: false,
        preedit: "",
        replacement_start: 0,
        replacement_end: 0,
        preedit_anchor: 0,
        preedit_focus: 0,
        offset_x: 0.0,
        session: ui.TextInput{id: 0,window_id: 0,canvas_id: 0,generation: 0}
    }
}

pub fn (f &TextField) is_focused() bool { << f.focused }

pub fn (f &TextField) display_value() string {
    if !f.composing { << f.value + "" }
    << f.value[0:f.replacement_start] + f.preedit + f.value[f.replacement_end:f.value.len]
}

pub fn (f &TextField) display_anchor() int {
    if f.composing { << f.replacement_start + f.preedit_anchor }
    << f.anchor
}

pub fn (f &TextField) display_focus() int {
    if f.composing { << f.replacement_start + f.preedit_focus }
    << f.focus
}

pub fn (f $&TextField) set_error(message string) {
    f.error = message + ""
}

fn (f &TextField) caret_rect() ui.TextInputRect {
    << ui.TextInputRect{
        x: f.bounds.x + 14.0,
        y: f.bounds.y + 10.0,
        width: 2.0,
        height: math.max(20.0,f.bounds.height - 20.0)
    }
}

fn (f $&TextField) try_sync_from_session() int {
    if f.session.id <= 0 { << 0 - 1 }
    state := f.session.snapshot() or (err) {
        << 0 - 1
    }
    changed := f.value != state.value || f.preedit != state.preedit || f.composing != state.composing
    f.value = state.value + ""
    f.anchor = state.anchor
    f.focus = state.focus
    f.revision = state.revision
    f.composing = state.composing
    f.preedit = state.preedit + ""
    f.replacement_start = state.replacement_start
    f.replacement_end = state.replacement_end
    f.preedit_anchor = state.preedit_anchor
    f.preedit_focus = state.preedit_focus
    if changed { << 1 }
    << 0
}

fn (f $&TextField) sync_from_session() bool {
    status := f.try_sync_from_session()
    if status < 0 {
        f.session.id = 0
        f.focused = false
        f.composing = false
        f.preedit = ""
        << false
    }
    << status > 0
}

fn (f $&TextField) apply_edit_fallback(edit &ui.TextEditEvent) bool {
    $changed := false
    if edit.kind == ui.EV_TEXT_COMMIT {
        lo := clamp_i(edit.start,0,f.value.len)
        hi := clamp_i(edit.end,lo,f.value.len)
        next := f.value[0:lo] + edit.value + f.value[hi:f.value.len]
        changed = next != f.value || f.composing || f.preedit.len > 0
        f.value = next
        f.composing = false
        f.preedit = ""
        f.replacement_start = 0
        f.replacement_end = 0
        f.preedit_anchor = 0
        f.preedit_focus = 0
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_PREEDIT {
        lo := clamp_i(edit.start,0,f.value.len)
        hi := clamp_i(edit.end,lo,f.value.len)
        changed = !f.composing || f.preedit != edit.value || f.replacement_start != lo || f.replacement_end != hi
        f.composing = true
        f.replacement_start = lo
        f.replacement_end = hi
        f.preedit = edit.value + ""
        f.preedit_anchor = clamp_i(edit.anchor,0,edit.value.len)
        f.preedit_focus = clamp_i(edit.focus,0,edit.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_CANCEL {
        changed = f.composing || f.preedit.len > 0
        f.composing = false
        f.preedit = ""
        f.replacement_start = 0
        f.replacement_end = 0
        f.preedit_anchor = 0
        f.preedit_focus = 0
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_SELECTION {
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_SURROUNDING_DELETE {
        lo := clamp_i(edit.start,0,f.value.len)
        hi := clamp_i(edit.end,lo,f.value.len)
        next := f.value[0:lo] + f.value[hi:f.value.len]
        changed = next != f.value
        f.value = next
        f.composing = false
        f.preedit = ""
        f.replacement_start = 0
        f.replacement_end = 0
        f.preedit_anchor = 0
        f.preedit_focus = 0
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    }
    << changed
}

fn clamp_i(v int,lo int,hi int) int {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

fn try_bind(l &draw.TextLayout,s &ui.TextInput,rev int,tr &ui.TextInputTransform) {
    _ := l.bind_input_transform(s,rev,tr,false) or (err) { << }
}

fn try_dispose(l $&draw.TextLayout) {
    _ := l.dispose() or (err) { << }
}

fn stop_session(s $&ui.TextInput) {
    _ := s.stop() or (err) { s.id = 0
        << }
}

fn safe_sel_rects(l &draw.TextLayout,lo int,hi int) []draw.TextSelectionRect {
    rects := l.selection_rects(lo,hi) or (err) { << []draw.TextSelectionRect{} }
    << rects
}

pub fn (f $&TextField) blur() {
    f.focus_session(false) or (err) {
        f.focused = false
        f.session.id = 0
        f.composing = false
        f.preedit = ""
        <<
    }
}

pub fn (f $&TextField) focus_session(on bool) int {
    if on && (!f.enabled || (f.focused && f.session.id > 0)) { << 0 }
    if on {
        if f.identity.canvas_id <= 0 { >> errors.new("phone: invalid canvas identity") }
        $options := ui.text_input_options(&f.value,f.caret_rect())
        options.anchor = f.anchor
        options.focus = f.focus
        ctx := f.context.clone()
        sess := ctx.start_text_input(&options) or >>
        f.session = sess
        f.focused = true
        _ := f.sync_from_session()
        << 0
    }
    if f.session.id > 0 {
        _ := f.sync_from_session()
        stop_session($&f.session)
    }
    f.session.id = 0
    f.focused = false
    f.composing = false
    f.preedit = ""
    f.replacement_start = 0
    f.replacement_end = 0
    f.preedit_anchor = 0
    f.preedit_focus = 0
    << 0
}

pub fn (f $&TextField) set_value(value string) int {
    if value.len > 16384 || !utf8.valid(&value) { >> errors.new("phone: invalid UTF-8 field text") }
    if f.session.id > 0 {
        if f.composing {
            f.focus_session(false) or >>
            f.value = value + ""
            f.anchor = value.len
            f.focus = value.len
            f.offset_x = 0.0
            f.focus_session(true) or >>
            << 0
        }
        caret := f.caret_rect()
        state := f.session.update(f.revision,&value,value.len,value.len,&caret) or (err) {
            f.focus_session(false) or >>
            f.value = value + ""
            f.anchor = value.len
            f.focus = value.len
            f.offset_x = 0.0
            << 0
        }
        f.value = state.value + ""
        f.anchor = state.anchor
        f.focus = state.focus
        f.revision = state.revision
        f.composing = state.composing
        f.preedit = state.preedit + ""
    } else {
        f.value = value + ""
        f.anchor = value.len
        f.focus = value.len
    }
    f.offset_x = 0.0
    << 0
}

pub fn (f $&TextField) clear() int {
    f.set_error("")
    << f.set_value("") or >>
}

pub fn (f $&TextField) select_all() int {
    if f.value.len == 0 { << 0 }
    if f.session.id > 0 {
        caret := f.caret_rect()
        _ := f.session.update(f.revision,&f.value,0,f.value.len,&caret) or (err) {
            f.anchor = 0
            f.focus = f.value.len
            << 0
        }
        _ := f.sync_from_session()
        << 0
    }
    f.anchor = 0
    f.focus = f.value.len
    << 0
}

fn (f $&TextField) tap_caret(tap_x f64) {
    if !f.focused || f.composing || f.session.id <= 0 || f.value.len == 0 { << }
    $opts := draw.text_options(15.0)
    opts.weight = 400
    opts.line_height = 22.0
    $shaped := f.context.layout_text(&f.value,&opts) or (err) { << }
    local_x := math.max(0.0,tap_x - (f.bounds.x + 14.0) + f.offset_x)
    hit := shaped.hit_test(local_x,11.0) or (err) {
        shaped.dispose() or (cleanup) { << }
        <<
    }
    pos := hit.byte_index()
    shaped.dispose() or (cleanup) { << }
    caret := f.caret_rect()
    _ := f.session.update(f.revision,&f.value,pos,pos,&caret) or (err) { << }
    _ := f.sync_from_session()
}

pub fn (f $&TextField) handle_event(event &ui.Event,touches &Touch,action int) TextFieldResult {
    $res := TextFieldResult{changed: false,submitted: false,blurred: false,cleared: false,needs_paint: false}
    if event.kind == ui.EV_EXIT || event.kind == ui.EV_CANVAS_CLOSED || event.kind == ui.EV_BLURRED {
        if f.focused {
            f.blur()
            res.blurred = true
            res.needs_paint = true
        }
        << res
    }
    if event.kind >= ui.EV_TEXT_COMMIT && event.kind <= ui.EV_TEXT_SURROUNDING_DELETE && f.session.id > 0 {
        edit := ui.text_edit_of(event) or (err) { << res }
        if edit.input.id != f.session.id { << res }
        if event.kind == ui.EV_TEXT_INPUT_ENDED || event.kind == ui.EV_TEXT_INPUT_FAILED {
            f.session.id = 0
            f.focused = false
            f.composing = false
            f.preedit = ""
            res.blurred = true
            res.needs_paint = true
            << res
        }
        status := f.try_sync_from_session()
        if status > 0 { res.changed = true }
        else if status < 0 && f.apply_edit_fallback(&edit) { res.changed = true }
        res.needs_paint = true
        << res
    }
    if f.focused && event.kind == ui.EV_KEY_DOWN {
        inp := ui.input_of(event) or (err) { << res }
        if inp.key == ui.KEY_ENTER && inp.repeat == 0 {
            res.submitted = true
            res.needs_paint = true
            << res
        }
        if inp.key == ui.KEY_ESCAPE && inp.repeat == 0 {
            f.blur()
            res.blurred = true
            res.needs_paint = true
            << res
        }
    }
    if action == f.clear_id && f.clear_id > 0 {
        f.clear() or (err) { << res }
        res.cleared = true
        res.changed = true
        res.needs_paint = true
        << res
    }
    if action == f.id && f.id > 0 {
        if !f.focused {
            f.focus_session(true) or (err) { << res }
        } else {
            f.tap_caret(touches.tap_x())
        }
        res.needs_paint = true
        << res
    }
    if f.focused && ((event.kind == ui.EV_POINTER_UP && !touches.was_dragged() && action != f.id && action != f.clear_id) ||
       (action > 0 && action != f.id && action != f.clear_id)) {
        f.blur()
        res.blurred = true
        res.needs_paint = true
    }
    << res
}

pub fn (f $&TextField) draw(c $&Canvas,t $&Touch,bounds layout.Rect,clip &layout.Rect,theme &Theme) int {
    field_rect := rect(bounds.x,bounds.y,bounds.width,math.max(f64(FIELD_HEIGHT),bounds.height))
    f.bounds = field_rect
    has_error := f.error.len > 0
    $fill := theme.surface
    $stroke := theme.border
    $stroke_w := 1.0
    if has_error {
        fill = theme.danger_soft
        stroke = theme.danger
        stroke_w = 2.0
    } else if f.focused {
        stroke = theme.focus
        stroke_w = 2.0
    }
    c.fill_round_rect(field_rect.x,field_rect.y,field_rect.width,field_rect.height,16.0,fill) or >>
    c.stroke_round_rect(field_rect.x,field_rect.y,field_rect.width,field_rect.height,16.0,stroke,stroke_w) or >>

    text_val := f.display_value()
    has_clear := text_val.len > 0 && f.clear_id > 0
    right_pad := 14.0
    $text_right := field_rect.x + field_rect.width - right_pad
    if has_clear { text_right = field_rect.x + field_rect.width - 48.0 }
    text_x := field_rect.x + 14.0
    text_w := math.max(24.0,text_right - text_x)
    text_y := field_rect.y + math.max(0.0,(field_rect.height - 22.0) * 0.5)

    c.push() or >>
    c.clip_rect(text_x,field_rect.y + 4.0,text_w,field_rect.height - 8.0) or >>
    if text_val.len == 0 {
        f.offset_x = 0.0
        $ph := c.shape_text(&f.placeholder,15.0,400,22.0,0.0,draw.TEXT_LEFT) or >>
        c.put_text(ph,text_x,text_y,theme.muted) or >>
        if f.focused && f.session.id > 0 {
            $empty := ""
            $layout := c.shape_text(&empty,15.0,400,22.0,0.0,draw.TEXT_LEFT) or >>
            tr := ui.text_input_translation(text_x,text_y)
            try_bind(&layout,&f.session,f.revision,&tr)
            try_dispose($&layout)
        }
        if f.focused {
            c.fill_rect(text_x,text_y + 1.0,2.0,20.0,theme.focus) or >>
        }
    } else {
        $shaped := c.shape_text(&text_val,15.0,400,22.0,0.0,draw.TEXT_LEFT) or >>
        focus_pos := clamp_i(f.display_focus(),0,text_val.len)
        anchor_pos := clamp_i(f.display_anchor(),0,text_val.len)
        caret := shaped.caret(focus_pos,false) or >>
        max_scroll := math.max(0.0,shaped.metrics.width - text_w + 4.0)
        f.offset_x = math.max(0.0,math.min(f.offset_x,max_scroll))
        if f.focused {
            if caret.x < f.offset_x { f.offset_x = caret.x }
            if caret.x > f.offset_x + text_w - 4.0 { f.offset_x = caret.x - text_w + 4.0 }
            f.offset_x = math.max(0.0,math.min(f.offset_x,max_scroll))
        }
        draw_x := text_x - f.offset_x
        if anchor_pos != focus_pos {
            lo := int(math.min(f64(anchor_pos),f64(focus_pos)))
            hi := int(math.max(f64(anchor_pos),f64(focus_pos)))
            sel := safe_sel_rects(&shaped,lo,hi)
            for r in sel {
                c.fill_rect(draw_x + r.x,text_y + r.y,r.width,r.height,theme.accent_tint) or >>
            }
        }
        if f.focused && f.session.id > 0 {
            tr := ui.text_input_translation(draw_x,text_y)
            try_bind(&shaped,&f.session,f.revision,&tr)
        }
        c.put_text(shaped,draw_x,text_y,theme.ink) or >>
        if f.composing && f.preedit.len > 0 {
            comp_lo := f.replacement_start
            comp_hi := f.replacement_start + f.preedit.len
            comp_rects := safe_sel_rects(&shaped,comp_lo,comp_hi)
            for r in comp_rects {
                c.fill_rect(draw_x + r.x,text_y + r.y + 19.0,r.width,2.0,theme.focus) or >>
            }
        }
        if f.focused {
            c.fill_rect(draw_x + caret.x,text_y + 1.0,2.0,math.min(field_rect.height - 16.0,caret.height),theme.focus) or >>
        }
    }
    c.pop() or >>

    if f.id > 0 { t.target(f.id,intersection(&field_rect,clip)) or >> }
    if has_clear {
        clear_rect := rect(field_rect.x + field_rect.width - 48.0,field_rect.y,48.0,field_rect.height)
        if t.pressed(f.clear_id) {
            c.fill_round_rect(clear_rect.x + 4.0,clear_rect.y + 4.0,clear_rect.width - 8.0,clear_rect.height - 8.0,12.0,theme.subtle_pressed) or >>
        }
        c.icon(clear_rect,ICON_CLOSE,theme.muted) or >>
        t.target(f.clear_id,intersection(&clear_rect,clip)) or >>
    }
    << 0
}

pub fn (f &TextField) draw_error(c $&Canvas,bounds layout.Rect,theme &Theme) int {
    if f.error.len == 0 { << 0 }
    << c.label(bounds,f.error,12.0,500,theme.danger,draw.TEXT_LEFT)
}
