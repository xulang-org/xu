@ui/phone

#errors
#math
#strings
#ui
#ui/draw
#ui/font
#ui/layout
#unicode/utf8

pub const FIELD_HEIGHT = 48

pub fn text_field_height() f64 { << f64(FIELD_HEIGHT) }

pub struct TextField {
    pub id int
    pub clear_id int
    pub identity ui.CanvasEvent
    context draw.Context
    pub bounds layout.Rect
    pub focused bool
    pub enabled bool
    pub selectable bool
    pub password bool
    pub locale int
    pub error string
    pub placeholder string
    pub value string
    pub anchor int
    pub focus int
    pub revision int
    pub composing bool
    pub preedit string
    pub replacement_start int
    pub replacement_end int
    pub preedit_anchor int
    pub preedit_focus int
    pub offset_x f64
    session ui.TextInput
    clip layout.Rect
    has_clip bool
    press_in_text bool
    drag_selecting bool
    drag_mode int
    drag_word_start int
    drag_word_end int
    action_bar_open bool
    action_bar PhoneActionBar
    bar_anchor layout.Rect
    paste_req ui.Request
    font_stack font.FontStack
    has_font_stack bool
    copy_enabled bool
}

pub struct TextFieldResult {
    pub changed bool
    pub submitted bool
    pub blurred bool
    pub cleared bool
    pub needs_paint bool
}

fn copy_identity(id &ui.CanvasEvent) ui.CanvasEvent {
    << ui.CanvasEvent{window_id: id.window_id,canvas_id: id.canvas_id,generation: id.generation}
}

pub fn text_field(context &draw.Context,identity &ui.CanvasEvent,id int,clear_id int,placeholder string) TextField {
    << TextField{
        id: id,
        clear_id: clear_id,
        identity: copy_identity(identity),
        context: context.clone(),
        bounds: rect(0.0,0.0,200.0,f64(FIELD_HEIGHT)),
        focused: false,
        enabled: true,
        selectable: true,
        password: false,
        locale: LOCALE_EN,
        error: "",
        placeholder: placeholder + "",
        value: "",
        anchor: 0,
        focus: 0,
        revision: 0,
        composing: false,
        preedit: "",
        replacement_start: 0,
        replacement_end: 0,
        preedit_anchor: 0,
        preedit_focus: 0,
        offset_x: 0.0,
        session: ui.TextInput{id: 0,window_id: 0,canvas_id: 0,generation: 0},
        clip: rect(0.0,0.0,0.0,0.0),
        has_clip: false,
        press_in_text: false,
        drag_selecting: false,
        drag_mode: SEL_DRAG_CHAR,
        drag_word_start: 0,
        drag_word_end: 0,
        action_bar_open: false,
        action_bar: empty_action_bar(),
        bar_anchor: rect(0.0,0.0,0.0,0.0),
        paste_req: ui.Request{id: 0,window_id: 0,canvas_id: 0,generation: 0,kind: 0},
        font_stack: font.new_font_stack(),
        has_font_stack: false,
        copy_enabled: true
    }
}

pub fn (f $&TextField) set_font_stack(stack font.FontStack) {
    f.font_stack = stack
    f.has_font_stack = f.font_stack.face_count() > 0
}

pub fn (f $&TextField) add_ttf_bytes(ttf_bytes &[]u8,font_index int,face_id int) int {
    r := draw.add_ttf_face($&f.font_stack,ttf_bytes,font_index,face_id) or >>
    f.has_font_stack = f.font_stack.face_count() > 0
    << r
}

pub fn (f &TextField) is_focused() bool { << f.focused }
pub fn (f &TextField) is_selectable() bool { << f.selectable }
pub fn (f &TextField) is_password() bool { << f.password }
pub fn (f &TextField) is_copy_enabled() bool { << f.copy_enabled && !f.password }

pub fn (f $&TextField) set_copy_enabled(on bool) {
    if f.copy_enabled == on { << }
    f.copy_enabled = on
    if !on { f.action_bar_open = false }
}

pub fn (f $&TextField) set_locale(locale int) {
    if locale == LOCALE_ZH_CN { f.locale = LOCALE_ZH_CN } else { f.locale = LOCALE_EN }
}

pub fn (f $&TextField) set_selectable(selectable bool) {
    f.selectable = selectable
    if !selectable {
        f.press_in_text = false
        f.drag_selecting = false
        f.action_bar_open = false
        if f.anchor != f.focus {
            f.update_selection_range(f.focus,f.focus)
        }
    }
}

pub fn (f $&TextField) set_password(password bool) {
    if f.password == password { << }
    f.password = password
    if f.session.id > 0 {
        f.focus_session(false) or (err) { << }
    }
}

pub fn (f &TextField) display_value() string {
    if !f.composing { << f.value + "" }
    << f.value[0:f.replacement_start] + f.preedit + f.value[f.replacement_end:f.value.len]
}

pub fn (f &TextField) display_anchor() int {
    if f.composing { << f.replacement_start + f.preedit_anchor }
    << f.anchor
}

pub fn (f &TextField) display_focus() int {
    if f.composing { << f.replacement_start + f.preedit_focus }
    << f.focus
}

pub fn (f $&TextField) set_error(message string) {
    f.error = message + ""
}

fn (f &TextField) caret_rect() ui.TextInputRect {
    << ui.TextInputRect{
        x: f.bounds.x + 14.0,
        y: f.bounds.y + 10.0,
        width: 2.0,
        height: math.max(20.0,f.bounds.height - 20.0)
    }
}

fn (f $&TextField) try_sync_from_session() int {
    if f.session.id <= 0 { << 0 - 1 }
    state := f.session.snapshot() or (err) {
        << 0 - 1
    }
    changed := f.value != state.value || f.preedit != state.preedit || f.composing != state.composing
    f.value = state.value + ""
    f.anchor = state.anchor
    f.focus = state.focus
    f.revision = state.revision
    f.composing = state.composing
    f.preedit = state.preedit + ""
    f.replacement_start = state.replacement_start
    f.replacement_end = state.replacement_end
    f.preedit_anchor = state.preedit_anchor
    f.preedit_focus = state.preedit_focus
    if changed { << 1 }
    << 0
}

fn (f $&TextField) sync_from_session() bool {
    status := f.try_sync_from_session()
    if status < 0 {
        f.session.id = 0
        f.focused = false
        f.composing = false
        f.preedit = ""
        << false
    }
    << status > 0
}

fn (f $&TextField) apply_edit_fallback(edit &ui.TextEditEvent) bool {
    $changed := false
    if edit.kind == ui.EV_TEXT_COMMIT {
        lo := clamp_i(edit.start,0,f.value.len)
        hi := clamp_i(edit.end,lo,f.value.len)
        next := f.value[0:lo] + edit.value + f.value[hi:f.value.len]
        changed = next != f.value || f.composing || f.preedit.len > 0
        f.value = next
        f.composing = false
        f.preedit = ""
        f.replacement_start = 0
        f.replacement_end = 0
        f.preedit_anchor = 0
        f.preedit_focus = 0
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_PREEDIT {
        lo := clamp_i(edit.start,0,f.value.len)
        hi := clamp_i(edit.end,lo,f.value.len)
        changed = !f.composing || f.preedit != edit.value || f.replacement_start != lo || f.replacement_end != hi
        f.composing = true
        f.replacement_start = lo
        f.replacement_end = hi
        f.preedit = edit.value + ""
        f.preedit_anchor = clamp_i(edit.anchor,0,edit.value.len)
        f.preedit_focus = clamp_i(edit.focus,0,edit.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_CANCEL {
        changed = f.composing || f.preedit.len > 0
        f.composing = false
        f.preedit = ""
        f.replacement_start = 0
        f.replacement_end = 0
        f.preedit_anchor = 0
        f.preedit_focus = 0
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_SELECTION {
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    } else if edit.kind == ui.EV_TEXT_SURROUNDING_DELETE {
        lo := clamp_i(edit.start,0,f.value.len)
        hi := clamp_i(edit.end,lo,f.value.len)
        next := f.value[0:lo] + f.value[hi:f.value.len]
        changed = next != f.value
        f.value = next
        f.composing = false
        f.preedit = ""
        f.replacement_start = 0
        f.replacement_end = 0
        f.preedit_anchor = 0
        f.preedit_focus = 0
        f.anchor = clamp_i(edit.anchor,0,f.value.len)
        f.focus = clamp_i(edit.focus,0,f.value.len)
        f.revision = edit.revision
    }
    << changed
}

fn clamp_i(v int,lo int,hi int) int {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

fn try_bind(l &draw.TextLayout,s &ui.TextInput,rev int,tr &ui.TextInputTransform) {
    _ := l.bind_input_transform(s,rev,tr,false) or (err) { << }
}

fn try_dispose(l $&draw.TextLayout) {
    _ := l.dispose() or (err) { << }
}

fn stop_session(s $&ui.TextInput) {
    _ := s.stop() or (err) { s.id = 0
        << }
}

fn safe_sel_rects(l &draw.TextLayout,lo int,hi int) []draw.TextSelectionRect {
    rects := l.selection_rects(lo,hi) or (err) { << []draw.TextSelectionRect{} }
    << rects
}

fn safe_font_sel_rects(l &font.TextLayout,lo int,hi int) []font.TextRect {
    rects := l.selection_rects(lo,hi) or (err) { << []font.TextRect{} }
    << rects
}

pub fn (f $&TextField) blur() {
    f.focus_session(false) or (err) {
        f.focused = false
        f.session.id = 0
        f.composing = false
        f.preedit = ""
        <<
    }
}

pub fn (f $&TextField) focus_session(on bool) int {
    if on && (!f.enabled || (f.focused && f.session.id > 0)) { << 0 }
    if on {
        if f.identity.canvas_id <= 0 { >> errors.new("phone: invalid canvas identity") }
        $options := ui.text_input_options(&f.value,f.caret_rect())
        options.anchor = f.anchor
        options.focus = f.focus
        options.password = f.password
        ctx := f.context.clone()
        sess := ctx.start_text_input(&options) or >>
        f.session = sess
        f.focused = true
        _ := f.sync_from_session()
        << 0
    }
    if f.paste_req.id > 0 {
        _ := f.paste_req.cancel()
        f.paste_req.id = 0
    }
    f.press_in_text = false
    f.drag_selecting = false
    f.action_bar_open = false
    if f.session.id > 0 {
        _ := f.sync_from_session()
        stop_session($&f.session)
    }
    f.session.id = 0
    f.focused = false
    f.composing = false
    f.preedit = ""
    f.replacement_start = 0
    f.replacement_end = 0
    f.preedit_anchor = 0
    f.preedit_focus = 0
    << 0
}

pub fn (f $&TextField) set_value(value string) int {
    if value.len > 16384 || !utf8.valid(&value) { >> errors.new("phone: invalid UTF-8 field text") }
    if f.session.id > 0 {
        if f.composing {
            f.focus_session(false) or >>
            f.value = value + ""
            f.anchor = value.len
            f.focus = value.len
            f.offset_x = 0.0
            f.focus_session(true) or >>
            << 0
        }
        caret := f.caret_rect()
        state := f.session.update(f.revision,&value,value.len,value.len,&caret) or (err) {
            f.focus_session(false) or >>
            f.value = value + ""
            f.anchor = value.len
            f.focus = value.len
            f.offset_x = 0.0
            << 0
        }
        f.value = state.value + ""
        f.anchor = state.anchor
        f.focus = state.focus
        f.revision = state.revision
        f.composing = state.composing
        f.preedit = state.preedit + ""
    } else {
        f.value = value + ""
        f.anchor = value.len
        f.focus = value.len
    }
    f.offset_x = 0.0
    << 0
}

pub fn (f $&TextField) clear() int {
    f.set_error("")
    << f.set_value("") or >>
}

pub fn (f $&TextField) select_all() int {
    if !f.selectable || f.value.len == 0 { << 0 }
    f.update_selection_range(0,f.value.len)
    << 0
}

pub fn (f &TextField) has_selection() bool {
    << f.selectable && f.display_anchor() != f.display_focus() && f.value.len > 0 && !f.composing
}

pub fn (f &TextField) selected_text() string {
    if !f.selectable || !f.is_copy_enabled() || f.composing { << "" }
    a := clamp_i(f.anchor,0,f.value.len)
    fc := clamp_i(f.focus,0,f.value.len)
    lo := int(math.min(f64(a),f64(fc)))
    hi := int(math.max(f64(a),f64(fc)))
    if lo == hi { << "" }
    << f.value[lo:hi]
}

pub fn (f $&TextField) copy_selection() int {
    sel := f.selected_text()
    if sel.len == 0 { << 0 }
    << phone_copy_clipboard(&f.identity,&sel)
}

fn (f $&TextField) update_selection_range(anchor int,focus int) {
    $a := ui.utf8_clamp_boundary(&f.value,clamp_i(anchor,0,f.value.len))
    $fc := ui.utf8_clamp_boundary(&f.value,clamp_i(focus,0,f.value.len))
    if !f.selectable { a = fc }
    if f.session.id > 0 {
        caret := f.caret_rect()
        _ := f.session.update(f.revision,&f.value,a,fc,&caret) or (err) {
            f.anchor = a
            f.focus = fc
            <<
        }
        _ := f.sync_from_session()
        <<
    }
    f.anchor = a
    f.focus = fc
}

fn (f $&TextField) replace_range(lo int,hi int,inserted &string) bool {
    if !f.enabled || f.composing { << false }
    start := ui.utf8_clamp_boundary(&f.value,clamp_i(lo,0,f.value.len))
    end := ui.utf8_clamp_boundary(&f.value,clamp_i(hi,start,f.value.len))
    next := f.value[0:start] + *inserted + f.value[end:f.value.len]
    if next.len > 16384 || !utf8.valid(&next) { << false }
    pos := start + inserted.len
    if f.session.id > 0 {
        caret := f.caret_rect()
        state := f.session.update(f.revision,&next,pos,pos,&caret) or (err) { << false }
        f.value = state.value + ""
        f.anchor = state.anchor
        f.focus = state.focus
        f.revision = state.revision
        f.composing = state.composing
        f.preedit = state.preedit + ""
        << true
    }
    f.value = next
    f.anchor = pos
    f.focus = pos
    << true
}

pub fn (f $&TextField) cut_selection() bool {
    if !f.selectable || !f.is_copy_enabled() || f.composing || !f.enabled { << false }
    a := clamp_i(f.anchor,0,f.value.len)
    fc := clamp_i(f.focus,0,f.value.len)
    lo := int(math.min(f64(a),f64(fc)))
    hi := int(math.max(f64(a),f64(fc)))
    if lo == hi { << false }
    sel := f.value[lo:hi]
    _ := phone_copy_clipboard(&f.identity,&sel)
    empty := ""
    ok := f.replace_range(lo,hi,&empty)
    f.action_bar_open = false
    << ok
}

pub fn (f $&TextField) paste_clipboard() int {
    if !f.enabled || f.composing || f.identity.canvas_id <= 0 { << 0 }
    if f.paste_req.id > 0 {
        _ := f.paste_req.cancel()
        f.paste_req.id = 0
    }
    options := ui.RequestOptions{timeout_ms: 5000}
    req := ui.clipboard_read_async(&f.identity,&options) or (err) { << 0 }
    f.paste_req = req
    << req.id
}

fn phone_mask_text(text &string) string {
    if text.len == 0 { << "" }
    $out := ""
    $i := 0
    while i < text.len {
        out = out + "•"
        i += phone_rune_step(text,i)
    }
    << out
}

fn phone_byte_to_rune(text &string,pos int) int {
    limit := ui.utf8_clamp_boundary(text,pos)
    $i := 0
    $r := 0
    while i < limit {
        i += phone_rune_step(text,i)
        r += 1
    }
    << r
}

fn phone_rune_to_byte(text &string,rune_pos int) int {
    if rune_pos <= 0 { << 0 }
    $i := 0
    $r := 0
    while i < text.len && r < rune_pos {
        i += phone_rune_step(text,i)
        r += 1
    }
    << i
}

fn (f &TextField) clear_button_rect() layout.Rect {
    if f.value.len == 0 || f.clear_id <= 0 { << rect(0.0,0.0,0.0,0.0) }
    << rect(f.bounds.x + f.bounds.width - 48.0,f.bounds.y,48.0,f.bounds.height)
}

fn (f &TextField) text_area_rect() layout.Rect {
    $right_pad := 14.0
    if f.value.len > 0 && f.clear_id > 0 { right_pad = 48.0 }
    w := math.max(24.0,f.bounds.width - 14.0 - right_pad)
    << rect(f.bounds.x + 14.0,f.bounds.y,w,f.bounds.height)
}

fn (f &TextField) in_text_hit(x f64,y f64) bool {
    if f.bounds.width <= 0.0 || f.bounds.height <= 0.0 || !f.bounds.contains(x,y) { << false }
    cb := f.clear_button_rect()
    if cb.width > 0.0 && cb.contains(x,y) { << false }
    << true
}

fn (f &TextField) hit_pos(tap_x f64) int {
    if f.value.len == 0 { << 0 }
    $shown := f.value + ""
    if f.password { shown = phone_mask_text(&f.value) }
    local_x := math.max(0.0,tap_x - (f.bounds.x + 14.0) + f.offset_x)
    raw_pos := phone_hit_text(&f.context,f.has_font_stack,&f.font_stack,&shown,15.0,400,22.0,0.0,draw.TEXT_LEFT,local_x,11.0)
    if f.password { << phone_rune_to_byte(&f.value,raw_pos / 3) }
    << ui.utf8_clamp_boundary(&f.value,raw_pos)
}

fn (f $&TextField) ensure_tap_focused() {
    if f.focused { << }
    _ := f.focus_session(true) or (err) {
        f.focused = true
        <<
    }
}

fn (f $&TextField) update_action_bar_layout(anchor layout.Rect) {
    $clip_box := rect(math.min(anchor.x,f.bounds.x),0.0,math.max(360.0,f.bounds.width + 64.0),800.0)
    if f.has_clip && f.clip.width > 0.0 && f.clip.height > 0.0 { clip_box = f.clip }
    f.bar_anchor = anchor
    can_cut_copy := f.selectable && f.is_copy_enabled() && f.has_selection()
    can_all := f.selectable && f.value.len > 0 && !f.composing
    can_paste := f.enabled && !f.composing && f.identity.canvas_id > 0
    $bar := phone_build_action_bar(anchor,clip_box,f.locale,true,can_cut_copy,can_all,can_paste)
    f.action_bar = bar
}

fn (f $&TextField) apply_drag_pos(pos int) {
    if !f.selectable { << }
    if f.drag_mode == SEL_DRAG_WORD {
        wr := ui.text_word_range(&f.value,pos)
        if wr.start < f.drag_word_start {
            f.update_selection_range(f.drag_word_end,wr.start)
        } else if wr.end > f.drag_word_end {
            f.update_selection_range(f.drag_word_start,wr.end)
        } else {
            f.update_selection_range(f.drag_word_start,f.drag_word_end)
        }
    } else if f.drag_mode == SEL_DRAG_LINE {
        f.update_selection_range(0,f.value.len)
    } else {
        f.update_selection_range(f.anchor,pos)
    }
}

fn (f $&TextField) handle_long_press(touches &Touch) bool {
    if !f.enabled || !touches.is_long_pressed() || !f.in_text_hit(touches.start_x,touches.start_y) { << false }
    if f.action_bar_open && f.drag_selecting { << false }
    f.ensure_tap_focused()
    if f.selectable && !f.composing && f.anchor == f.focus && f.value.len > 0 {
        pos := f.hit_pos(touches.start_x)
        if f.password {
            f.update_selection_range(pos,pos)
        } else {
            wr := ui.text_word_range(&f.value,pos)
            f.drag_word_start = wr.start
            f.drag_word_end = wr.end
            f.drag_mode = SEL_DRAG_WORD
            f.update_selection_range(wr.start,wr.end)
        }
    }
    f.drag_selecting = touches.pointer_down() && f.selectable
    f.action_bar_open = true
    f.update_action_bar_layout(rect(touches.start_x - 24.0,f.bounds.y,48.0,f.bounds.height))
    << true
}

pub fn (f &TextField) cursor_at(x f64,y f64) int {
    if f.action_bar_open && f.action_bar.bounds.contains(x,y) { << ui.CURSOR_HAND }
    cb := f.clear_button_rect()
    if cb.width > 0.0 && cb.contains(x,y) { << ui.CURSOR_HAND }
    if f.selectable && f.enabled && f.in_text_hit(x,y) { << ui.CURSOR_TEXT }
    << ui.CURSOR_DEFAULT
}

fn (f $&TextField) tap_caret(tap_x f64) {
    if !f.focused || f.composing || f.value.len == 0 { << }
    pos := f.hit_pos(tap_x)
    f.update_selection_range(pos,pos)
}

fn (f $&TextField) execute_bar_cmd(cmd int,res $&TextFieldResult) bool {
    if cmd == ACTION_BAR_COPY {
        _ := f.copy_selection()
        f.action_bar_open = false
        res.needs_paint = true
        << true
    }
    if cmd == ACTION_BAR_CUT {
        if f.cut_selection() { res.changed = true }
        f.action_bar_open = false
        res.needs_paint = true
        << true
    }
    if cmd == ACTION_BAR_PASTE {
        _ := f.paste_clipboard()
        f.action_bar_open = false
        res.needs_paint = true
        << true
    }
    if cmd == ACTION_BAR_SELECT_ALL {
        _ := f.select_all()
        f.action_bar_open = true
        f.update_action_bar_layout(f.bounds)
        res.needs_paint = true
        << true
    }
    << false
}

pub fn (f $&TextField) handle_event(event &ui.Event,touches &Touch,action int) TextFieldResult {
    $res := TextFieldResult{changed: false,submitted: false,blurred: false,cleared: false,needs_paint: false}
    if event.kind == ui.EV_EXIT || event.kind == ui.EV_CANVAS_CLOSED || event.kind == ui.EV_BLURRED {
        if f.focused || f.action_bar_open || f.drag_selecting {
            f.blur()
            res.blurred = true
            res.needs_paint = true
        }
        << res
    }
    if event.kind == ui.EV_REQUEST {
        req_res := ui.request_of(event) or (err) { << res }
        if f.paste_req.id > 0 && req_res.request.id == f.paste_req.id {
            f.paste_req.id = 0
            if req_res.status == ui.REQUEST_COMPLETED && f.focused && !f.composing {
                $pasted := strings.replace_all(&req_res.value,"\r\n"," ")
                pasted = strings.replace_all(&pasted,"\r"," ")
                pasted = strings.replace_all(&pasted,"\n"," ")
                if pasted.len > 0 || f.anchor != f.focus {
                    a := clamp_i(f.anchor,0,f.value.len)
                    fc := clamp_i(f.focus,0,f.value.len)
                    lo := int(math.min(f64(a),f64(fc)))
                    hi := int(math.max(f64(a),f64(fc)))
                    if f.replace_range(lo,hi,&pasted) {
                        res.changed = true
                        res.needs_paint = true
                    }
                }
            }
        }
        << res
    }
    if event.kind >= ui.EV_TEXT_COMMIT && event.kind <= ui.EV_TEXT_SURROUNDING_DELETE && f.session.id > 0 {
        edit := ui.text_edit_of(event) or (err) { << res }
        if edit.input.id != f.session.id { << res }
        if event.kind == ui.EV_TEXT_INPUT_ENDED || event.kind == ui.EV_TEXT_INPUT_FAILED {
            f.session.id = 0
            f.focused = false
            f.composing = false
            f.preedit = ""
            f.action_bar_open = false
            f.drag_selecting = false
            res.blurred = true
            res.needs_paint = true
            << res
        }
        status := f.try_sync_from_session()
        if !f.selectable && f.anchor != f.focus {
            f.update_selection_range(f.focus,f.focus)
        }
        if status > 0 { res.changed = true }
        else if status < 0 && f.apply_edit_fallback(&edit) { res.changed = true }
        res.needs_paint = true
        << res
    }
    if f.handle_long_press(touches) {
        res.needs_paint = true
    }
    if f.focused && event.kind == ui.EV_KEY_DOWN {
        inp := ui.input_of(event) or (err) { << res }
        if inp.key == ui.KEY_ENTER && inp.repeat == 0 {
            res.submitted = true
            res.needs_paint = true
            << res
        }
        if inp.key == ui.KEY_ESCAPE && inp.repeat == 0 {
            if f.action_bar_open {
                f.action_bar_open = false
                res.needs_paint = true
                << res
            }
            f.blur()
            res.blurred = true
            res.needs_paint = true
            << res
        }
        if ui.is_clipboard_modifier(inp.modifiers) && inp.repeat == 0 {
            uk := phone_upper_key(inp.key)
            if uk == 65 {
                _ := f.select_all()
                res.needs_paint = true
                << res
            }
            if uk == 67 {
                _ := f.copy_selection()
                res.needs_paint = true
                << res
            }
            if uk == 88 {
                if f.cut_selection() { res.changed = true }
                res.needs_paint = true
                << res
            }
            if uk == 86 {
                _ := f.paste_clipboard()
                res.needs_paint = true
                << res
            }
        }
        if inp.key == ui.KEY_F1 + 9 && (inp.modifiers & ui.MOD_SHIFT) != 0 && inp.repeat == 0 && f.selectable {
            f.action_bar_open = true
            f.update_action_bar_layout(f.bounds)
            res.needs_paint = true
            << res
        }
        if f.selectable && !f.composing && (inp.modifiers & ui.MOD_SHIFT) != 0 {
            fc := ui.utf8_clamp_boundary(&f.value,f.focus)
            if inp.key == ui.KEY_LEFT {
                f.update_selection_range(f.anchor,ui.utf8_prev_char(&f.value,fc))
                res.needs_paint = true
                << res
            }
            if inp.key == ui.KEY_RIGHT {
                f.update_selection_range(f.anchor,ui.utf8_next_char(&f.value,fc))
                res.needs_paint = true
                << res
            }
            if inp.key == ui.KEY_HOME {
                f.update_selection_range(f.anchor,0)
                res.needs_paint = true
                << res
            }
            if inp.key == ui.KEY_END {
                f.update_selection_range(f.anchor,f.value.len)
                res.needs_paint = true
                << res
            }
        }
    }
    if ui.is_input_event(event.kind) {
        inp := ui.input_of(event) or (err) { << res }
        if inp.window_id == f.identity.window_id && inp.canvas_id == f.identity.canvas_id && inp.generation == f.identity.generation {
            if inp.kind == ui.EV_POINTER_DOWN {
                if f.action_bar_open && f.action_bar.bounds.contains(inp.x,inp.y) {
                    << res
                }
                if inp.button == ui.BUTTON_RIGHT && f.enabled && f.in_text_hit(inp.x,inp.y) {
                    f.ensure_tap_focused()
                    if f.selectable {
                        f.action_bar_open = true
                        f.update_action_bar_layout(rect(inp.x - 16.0,f.bounds.y,32.0,f.bounds.height))
                        res.needs_paint = true
                    }
                    << res
                }
                if inp.button == ui.BUTTON_LEFT && f.enabled && f.in_text_hit(inp.x,inp.y) {
                    f.press_in_text = true
                    f.action_bar_open = false
                    clicks := touches.click_count()
                    if (inp.modifiers & ui.MOD_SHIFT) != 0 && f.focused && f.selectable && !f.composing {
                        pos := f.hit_pos(inp.x)
                        f.drag_mode = SEL_DRAG_CHAR
                        f.drag_selecting = true
                        f.update_selection_range(f.anchor,pos)
                        res.needs_paint = true
                        << res
                    }
                    if clicks == 2 && f.selectable && !f.composing {
                        f.ensure_tap_focused()
                        pos := f.hit_pos(inp.x)
                        if f.password {
                            f.update_selection_range(0,f.value.len)
                            f.drag_mode = SEL_DRAG_LINE
                            f.drag_word_start = 0
                            f.drag_word_end = f.value.len
                        } else {
                            wr := ui.text_word_range(&f.value,pos)
                            f.drag_mode = SEL_DRAG_WORD
                            f.drag_word_start = wr.start
                            f.drag_word_end = wr.end
                            f.update_selection_range(wr.start,wr.end)
                        }
                        f.drag_selecting = true
                        f.action_bar_open = true
                        f.update_action_bar_layout(rect(inp.x - 24.0,f.bounds.y,48.0,f.bounds.height))
                        res.needs_paint = true
                        << res
                    }
                    if clicks >= 3 && f.selectable && !f.composing {
                        f.ensure_tap_focused()
                        f.drag_mode = SEL_DRAG_LINE
                        f.drag_word_start = 0
                        f.drag_word_end = f.value.len
                        f.drag_selecting = true
                        _ := f.select_all()
                        f.action_bar_open = true
                        f.update_action_bar_layout(f.bounds)
                        res.needs_paint = true
                        << res
                    }
                    if f.focused && f.selectable && !f.composing {
                        pos := f.hit_pos(inp.x)
                        f.drag_mode = SEL_DRAG_CHAR
                        f.update_selection_range(pos,pos)
                        res.needs_paint = true
                    }
                } else {
                    if f.action_bar_open {
                        f.action_bar_open = false
                        res.needs_paint = true
                    }
                    if f.focused && !f.bounds.contains(inp.x,inp.y) {
                        f.blur()
                        res.blurred = true
                        res.needs_paint = true
                    }
                }
            }
            if inp.kind == ui.EV_POINTER_MOVE {
                if inp.buttons == 0 {
                    cur := f.cursor_at(inp.x,inp.y)
                    if cur != ui.CURSOR_DEFAULT { _ := draw.set_cursor(cur) }
                }
                if (f.drag_selecting || (f.press_in_text && f.focused && f.selectable && !f.composing && touches.is_selection_drag())) && touches.drag_axis != DRAG_VERTICAL {
                    f.drag_selecting = true
                    ta := f.text_area_rect()
                    if inp.x < ta.x + 12.0 { f.offset_x = math.max(0.0,f.offset_x - 10.0) }
                    else if inp.x > ta.x + ta.width - 12.0 { f.offset_x += 10.0 }
                    pos := f.hit_pos(inp.x)
                    f.apply_drag_pos(pos)
                    res.needs_paint = true
                    << res
                }
            }
            if inp.kind == ui.EV_POINTER_UP {
                if f.action_bar_open && inp.button == ui.BUTTON_LEFT && !touches.was_dragged() {
                    cmd := phone_action_bar_hit(&f.action_bar,inp.x,inp.y)
                    if f.execute_bar_cmd(cmd,$&res) { << res }
                }
                if f.drag_selecting || f.press_in_text {
                    was_sel_drag := f.drag_selecting
                    f.drag_selecting = false
                    f.press_in_text = false
                    if f.has_selection() && (was_sel_drag || touches.is_long_pressed() || touches.click_count() >= 2) {
                        f.action_bar_open = true
                        f.update_action_bar_layout(rect(math.min(touches.start_x,inp.x),f.bounds.y,math.max(24.0,math.abs(inp.x - touches.start_x)),f.bounds.height))
                        res.needs_paint = true
                    }
                    if action == f.id && !was_sel_drag && !f.focused {
                        f.focus_session(true) or (err) { << res }
                        res.needs_paint = true
                    }
                    << res
                }
            }
        }
    }
    if action == f.clear_id && f.clear_id > 0 {
        f.action_bar_open = false
        f.clear() or (err) { << res }
        res.cleared = true
        res.changed = true
        res.needs_paint = true
        << res
    }
    if action == f.id && f.id > 0 {
        if !f.focused {
            f.focus_session(true) or (err) { << res }
        } else {
            f.tap_caret(touches.tap_x())
        }
        res.needs_paint = true
        << res
    }
    if f.focused && ((event.kind == ui.EV_POINTER_UP && !touches.was_dragged() && action != f.id && action != f.clear_id) ||
       (action > 0 && action != f.id && action != f.clear_id)) {
        f.blur()
        res.blurred = true
        res.needs_paint = true
    }
    << res
}

fn phone_field_scroll_x(offset_x f64,focused bool,caret_x f64,metrics_w f64,text_w f64) f64 {
    max_scroll := math.max(0.0,metrics_w - text_w + 4.0)
    $next := math.max(0.0,math.min(offset_x,max_scroll))
    if focused {
        if caret_x < next { next = caret_x }
        if caret_x > next + text_w - 4.0 { next = caret_x - text_w + 4.0 }
        next = math.max(0.0,math.min(next,max_scroll))
    }
    << next
}

pub fn (f $&TextField) draw(c $&Canvas,t $&Touch,bounds layout.Rect,clip &layout.Rect,theme &Theme) int {
    c.ensure_font_stack() or >>
    if !f.has_font_stack && c.font_stack.face_count() > 0 {
        f.set_font_stack(c.font_stack.clone())
    } else if !f.has_font_stack {
        f.set_font_stack(phone_fallback_font_stack())
    }
    field_rect := rect(bounds.x,bounds.y,bounds.width,math.max(f64(FIELD_HEIGHT),bounds.height))
    f.bounds = field_rect
    f.clip = rect(clip.x,clip.y,clip.width,clip.height)
    f.has_clip = clip.width > 0.0 && clip.height > 0.0
    has_error := f.error.len > 0
    $fill := theme.surface
    $stroke := theme.border
    $stroke_w := 1.0
    if has_error {
        fill = theme.danger_soft
        stroke = theme.danger
        stroke_w = 2.0
    } else if f.focused {
        stroke = theme.focus
        stroke_w = 2.0
    }
    c.fill_round_rect(field_rect.x,field_rect.y,field_rect.width,field_rect.height,16.0,fill) or >>
    c.stroke_round_rect(field_rect.x,field_rect.y,field_rect.width,field_rect.height,16.0,stroke,stroke_w) or >>

    raw_val := f.display_value()
    $shown_val := raw_val + ""
    if f.password && raw_val.len > 0 { shown_val = phone_mask_text(&raw_val) }
    has_clear := raw_val.len > 0 && f.clear_id > 0
    right_pad := 14.0
    $text_right := field_rect.x + field_rect.width - right_pad
    if has_clear { text_right = field_rect.x + field_rect.width - 48.0 }
    text_x := field_rect.x + 14.0
    text_w := math.max(24.0,text_right - text_x)
    text_y := field_rect.y + math.max(0.0,(field_rect.height - 22.0) * 0.5)

    c.push() or >>
    c.clip_rect(text_x,field_rect.y + 4.0,text_w,field_rect.height - 8.0) or >>
    if raw_val.len == 0 {
        f.offset_x = 0.0
        if ui.host_tmp() != ":xu:" {
            if f.placeholder.len > 0 {
                opts := phone_text_options(15.0,400,22.0,0.0,draw.TEXT_LEFT)
                ly := draw.layout_font_text(&f.font_stack,&f.placeholder,&opts,false) or >>
                frame := $&c.frame
                frame.text_font_layout(&ly,&f.placeholder,text_x,text_y,theme.muted) or >>
            }
        } else {
            $ph := c.shape_text(&f.placeholder,15.0,400,22.0,0.0,draw.TEXT_LEFT) or >>
            c.put_text(ph,text_x,text_y,theme.muted) or >>
            if f.focused && f.session.id > 0 {
                $empty := ""
                $layout := c.shape_text(&empty,15.0,400,22.0,0.0,draw.TEXT_LEFT) or >>
                tr := ui.text_input_translation(text_x,text_y)
                try_bind(&layout,&f.session,f.revision,&tr)
                try_dispose($&layout)
            }
        }
        if f.focused {
            c.fill_rect(text_x,text_y + 1.0,2.0,20.0,theme.focus) or >>
        }
    } else {
        $focus_pos := clamp_i(f.display_focus(),0,raw_val.len)
        $anchor_pos := clamp_i(f.display_anchor(),0,raw_val.len)
        if !f.selectable { anchor_pos = focus_pos }
        $draw_focus := focus_pos
        $draw_anchor := anchor_pos
        if f.password {
            draw_focus = phone_byte_to_rune(&raw_val,focus_pos) * 3
            draw_anchor = phone_byte_to_rune(&raw_val,anchor_pos) * 3
        }
        if ui.host_tmp() != ":xu:" {
            opts := phone_text_options(15.0,400,22.0,0.0,draw.TEXT_LEFT)
            ly := draw.layout_font_text(&f.font_stack,&shown_val,&opts,false) or >>
            caret := ly.caret(draw_focus,false) or >>
            f.offset_x = phone_field_scroll_x(f.offset_x,f.focused,caret.x,ly.metrics.width,text_w)
            draw_x := text_x - f.offset_x
            if draw_anchor != draw_focus {
                lo := int(math.min(f64(draw_anchor),f64(draw_focus)))
                hi := int(math.max(f64(draw_anchor),f64(draw_focus)))
                phone_paint_sel_rects_font(c,&ly,draw_x,text_y,lo,hi,theme.accent_tint) or >>
            }
            frame := $&c.frame
            frame.text_font_layout(&ly,&shown_val,draw_x,text_y,theme.ink) or >>
            if f.composing && f.preedit.len > 0 && !f.password {
                comp_lo := f.replacement_start
                comp_hi := f.replacement_start + f.preedit.len
                comp_rects := safe_font_sel_rects(&ly,comp_lo,comp_hi)
                for r in comp_rects {
                    c.fill_rect(draw_x + r.x,text_y + r.y + 19.0,r.width,2.0,theme.focus) or >>
                }
            }
            if f.focused {
                c.fill_rect(draw_x + caret.x,text_y + 1.0,2.0,math.min(field_rect.height - 16.0,caret.height),theme.focus) or >>
            }
        } else {
            $shaped := c.shape_text(&shown_val,15.0,400,22.0,0.0,draw.TEXT_LEFT) or >>
            caret := shaped.caret(draw_focus,false) or >>
            f.offset_x = phone_field_scroll_x(f.offset_x,f.focused,caret.x,shaped.metrics.width,text_w)
            draw_x := text_x - f.offset_x
            if draw_anchor != draw_focus {
                lo := int(math.min(f64(draw_anchor),f64(draw_focus)))
                hi := int(math.max(f64(draw_anchor),f64(draw_focus)))
                sel := safe_sel_rects(&shaped,lo,hi)
                for r in sel {
                    c.fill_rect(draw_x + r.x,text_y + r.y,r.width,r.height,theme.accent_tint) or >>
                }
            }
            if f.focused && f.session.id > 0 {
                tr := ui.text_input_translation(draw_x,text_y)
                try_bind(&shaped,&f.session,f.revision,&tr)
            }
            c.put_text(shaped,draw_x,text_y,theme.ink) or >>
            if f.composing && f.preedit.len > 0 && !f.password {
                comp_lo := f.replacement_start
                comp_hi := f.replacement_start + f.preedit.len
                comp_rects := safe_sel_rects(&shaped,comp_lo,comp_hi)
                for r in comp_rects {
                    c.fill_rect(draw_x + r.x,text_y + r.y + 19.0,r.width,2.0,theme.focus) or >>
                }
            }
            if f.focused {
                c.fill_rect(draw_x + caret.x,text_y + 1.0,2.0,math.min(field_rect.height - 16.0,caret.height),theme.focus) or >>
            }
        }
    }
    c.pop() or >>

    if f.id > 0 {
        $text_touch := rect(field_rect.x,field_rect.y,field_rect.width,field_rect.height)
        if has_clear { text_touch.width = math.max(24.0,field_rect.width - 48.0) }
        t.target(f.id,intersection(&field_rect,clip)) or >>
        if f.selectable { t.selection_region(intersection(&text_touch,clip),f.focused) }
    }
    if has_clear {
        clear_rect := rect(field_rect.x + field_rect.width - 48.0,field_rect.y,48.0,field_rect.height)
        if t.pressed(f.clear_id) {
            c.fill_round_rect(clear_rect.x + 4.0,clear_rect.y + 4.0,clear_rect.width - 8.0,clear_rect.height - 8.0,12.0,theme.subtle_pressed) or >>
        }
        c.icon(clear_rect,ICON_CLOSE,theme.muted) or >>
        t.target(f.clear_id,intersection(&clear_rect,clip)) or >>
    }
    if f.action_bar_open && f.focused && f.enabled {
        $anchor := f.bar_anchor
        if anchor.width <= 0.0 || anchor.height <= 0.0 { anchor = field_rect }
        f.update_action_bar_layout(anchor)
        phone_paint_action_bar(c,t,&f.action_bar,theme) or >>
    }
    << 0
}

pub fn (f &TextField) draw_error(c $&Canvas,bounds layout.Rect,theme &Theme) int {
    if f.error.len == 0 { << 0 }
    << c.label(bounds,f.error,12.0,500,theme.danger,draw.TEXT_LEFT)
}
