@ui/phone

#math
#os
#strconv
#strings

// Safe-area and soft-keyboard (IME) insets in logical points / DIP, aligned
// with Flutter's MediaQuery viewPadding vs viewInsets split.
pub struct Insets {
    pub top f64
    pub bottom f64
    pub left f64
    pub right f64
    pub ime_bottom f64
}

pub fn insets_zero() Insets {
    << Insets{top: 0.0,bottom: 0.0,left: 0.0,right: 0.0,ime_bottom: 0.0}
}

pub fn (i Insets) with_ime(ime f64) Insets {
    $clamped := ime
    if math.is_nan(clamped) || math.is_inf(clamped) || clamped < 0.0 { clamped = 0.0 }
    << Insets{top: i.top,bottom: i.bottom,left: i.left,right: i.right,ime_bottom: clamped}
}

// Persistent bottom inset uncovered by the soft keyboard (Flutter padding.bottom).
pub fn (i Insets) view_padding_bottom() f64 {
    << math.max(0.0,i.bottom - i.ime_bottom)
}

// Bottom clearance above both system gesture bar / home indicator and active IME.
pub fn (i Insets) bottom_clearance() f64 {
    << math.max(i.bottom,i.ime_bottom)
}

fn sanitize_inset(token &string) f64 {
    trimmed := strings.trim_space(token)
    v := strconv.parse_float(&trimmed) or (err) { << 0.0 }
    if math.is_nan(v) || math.is_inf(v) || v <= 0.0 || v > 2048.0 { << 0.0 }
    << v
}

pub fn parse_insets(raw &string) Insets {
    trimmed := strings.trim_space(raw)
    if trimmed.len == 0 { << insets_zero() }
    normalized := strings.replace_all(&trimmed,",","\t")
    fields := strings.split(&normalized,"\t")
    if fields.len != 5 { << insets_zero() }
    << Insets{
        top: sanitize_inset(&fields[0]),
        bottom: sanitize_inset(&fields[1]),
        left: sanitize_inset(&fields[2]),
        right: sanitize_inset(&fields[3]),
        ime_bottom: sanitize_inset(&fields[4])
    }
}

fn read_mem_or_env(mem_path string,env_name string) string {
    raw := os.read(mem_path) or (err) { << os.getenv(~env_name) }
    if raw.len == 0 { << os.getenv(env_name) }
    << raw
}

pub fn host_insets() Insets {
    raw := read_mem_or_env(":xu:/phone_insets","XU_PHONE_INSETS")
    if raw.len == 0 { << insets_zero() }
    << parse_insets(&raw)
}

pub fn reduced_motion() bool {
    val := read_mem_or_env(":xu:/phone_reduced_motion","XU_PHONE_REDUCED_MOTION")
    << strings.trim_space(&val) == "1"
}
