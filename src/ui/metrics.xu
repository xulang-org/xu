@ui

#errors
#strings
#strconv
#math

pub const EV_CANVAS_METRICS = 83

pub struct CanvasMetrics {
    pub window_id int
    pub canvas_id int
    pub generation int
    pub width f64
    pub height f64
    pub buffer_width int
    pub buffer_height int
    pub scale_x f64
    pub scale_y f64
}

fn decode_metrics(payload &string) CanvasMetrics {
    fields := strings.split(payload, "\t")
    if fields.len != 10 || fields[0] != "canvas_metrics" { >> errors.new("ui: invalid canvas metrics record") }
    window := strconv.atoi(&fields[1]) or >>
    canvas := strconv.atoi(&fields[2]) or >>
    generation := strconv.atoi(&fields[3]) or >>
    width := input_number(&fields[4]) or >>
    height := input_number(&fields[5]) or >>
    buffer_width := strconv.atoi(&fields[6]) or >>
    buffer_height := strconv.atoi(&fields[7]) or >>
    scale_x := input_number(&fields[8]) or >>
    scale_y := input_number(&fields[9]) or >>
    if window <= 0 || window > 2147483647 || canvas <= 0 || canvas > 2147483647 ||
       generation <= 0 || generation > 4294967295 || width < 0.0 || height < 0.0 ||
       buffer_width < 0 || buffer_width > 2147483647 || buffer_height < 0 || buffer_height > 2147483647 ||
       scale_x <= 0.0 || scale_x > 1024.0 || scale_y <= 0.0 || scale_y > 1024.0 ||
       math.abs(width * scale_x - f64(buffer_width)) > 1.0 ||
       math.abs(height * scale_y - f64(buffer_height)) > 1.0 {
        >> errors.new("ui: invalid canvas metrics fields")
    }
    << CanvasMetrics{window_id: window, canvas_id: canvas, generation: generation,
                      width: width, height: height, buffer_width: buffer_width,
                      buffer_height: buffer_height, scale_x: scale_x, scale_y: scale_y}
}

// Points/DIP for layout and input; buffer pixels only for raster allocation.
pub fn metrics_of(event &Event) CanvasMetrics {
    if event.kind != EV_CANVAS_METRICS { >> errors.new("ui: expected canvas metrics") }
    metrics := decode_metrics(&event.menu_id) or >>
    if metrics.window_id != event.window_id { >> errors.new("ui: inconsistent canvas metrics identity") }
    << metrics
}
