@database/sql

#errors
#context
#time
#database/sql/driver

// Go `database/sql` user API over `database/sql/driver`.
//
// Open takes a Driver value, not a registry name: Xu has no mutable
// package global (same constraint as slog.SetDefault), so there is no
// `Register`. Go's `OpenDB(Connector)` is `open_db`. DriverContext
// is the same concrete type boxed as Connector (Gen1 cannot put
// OpenConnector on Driver: iface forward-ref). `prepare_context` on
// driver.Conn is Go ConnPrepareContext.
//
// The pool matches Go `sql.DB`: lazy Open/OpenDB, idle list, get/put
// around Query/Exec/Ping. Query puts the conn back after the driver
// returns (v1 Rows is a snapshot; Go holds the conn until Rows.Close
// for streaming cursors). Tx holds a conn until Commit/Rollback.
// DB.Prepare does not pin (Go: release after prepare, re-prepare on
// the borrowed conn). Idle conns live on a channel because
// `[]driver.Conn` cannot move an element by runtime index (M2b).
// Open stores Driver+DSN and calls Driver.open (Go `dsnConnector` is
// inlined: a second Connector impl next to the user's would collide
// on Gen1 itable). OpenDB keeps the Connector on a cap-1 chan.
// sql.Conn is a pool handle (per-op get/put), not a checked-out
// exclusive box: struct@ cannot live in Conn and return to idle
// without a dup that aliases the unique box. Close only marks
// done. `raw` dups a checkout; drop that dup before the next
// pool op.
// SetMaxOpenConns(0)=unlimited; default max idle is 2.
// Lifetime/idle-time expire on get/put (no background cleaner).
// Idle reuse calls is_valid + reset_session (Go Validator /
// SessionResetter). Invalid conns are closed, not returned to
// idle. Idle queue cap is 64.
// DB Ping/Exec/Query retry `driver.ErrBadConn` up to 3 attempts
// (Go `maxBadConnRetries` + alwaysNewConn). Args are snapshotted
// as cloneable wire strings because `temp` cannot be reused.
// Tx/Stmt do not retry (bound to one conn / one prepare).
//
// Exec/Query take `...temp` like Go (int/string/bool/f64/time.Time/[]u8/NamedArg;
// collect_nvs unrolls 1..3, M2b). Scan cannot take pointer dests
// (`temp` 拒借用); `Rows.next` + `take` returns a local `[]temp` of Values.
// Prepare is Go `Conn.Prepare` → `driver.Stmt`. Begin is Go `Conn.Begin`
// → `driver.Tx`. Tx holds a dup handle to the same conn (struct@ is
// move-only; dup shares the driver object). Isolation is the driver's:
// rollback restores the snapshot taken at Begin.
// QueryRow is Go-shaped: it does not throw; `Row.take` surfaces ErrNoRows
// / query errors (Go `QueryRow` + `Scan`). sql.Rows owns a v1 snapshot
// from `driver.RowsResult` (not Go streaming `driver.Rows`); next/take
// walk flat cells. ColumnType* stubs return "" / ok=false at this layer.
// Context methods borrow `&context.Context`, check `context.err`, then
// forward (Go `PingContext` &c).
// BeginTx with non-default isolation/read-only errors like Go when the
// driver has no ConnBeginTx. Driver.dup is Xu-only (struct@ is move-only).
// `Conn` is Go `sql.Conn` (dedicated pooled handle). Field `dc` is the
// driver conn so `conn(ctx)` can match Go `DB.Conn`. Exec/Query args
// become `[]driver.NamedValue` (Go QueryerContext). NamedArg fills
// Name+Value; others are ordinal-only. Stmt.NumInput ≥ 0 must match
// argc (Go). Connector.Connect borrows context. `raw` returns a dup of
// the dedicated driver conn. ColumnType.decimal_size is Go DecimalSize.

pub const LEVEL_DEFAULT = 0
pub const LEVEL_READ_UNCOMMITTED = 1
pub const LEVEL_READ_COMMITTED = 2
pub const LEVEL_WRITE_COMMITTED = 3
pub const LEVEL_REPEATABLE_READ = 4
pub const LEVEL_SNAPSHOT = 5
pub const LEVEL_SERIALIZABLE = 6
pub const LEVEL_LINEARIZABLE = 7

pub struct TxOptions {
    pub isolation int
    pub read_only bool
}

pub struct NamedArg {
    pub name string
    pub value temp
}

// Go `sql.DBStats` (WaitDuration omitted: v1 does not accumulate wait ns).
pub struct DBStats {
    pub max_open_connections int
    pub open_connections int
    pub in_use int
    pub idle int
    pub wait_count int
    pub max_idle_closed int
    pub max_idle_time_closed int
    pub max_lifetime_closed int
}

struct PoolState {
    pub closed int
    pub max_open int
    pub max_idle int
    pub num_open int
    pub num_in_use int
    pub wait_count int
    pub max_idle_closed int
    pub max_idle_time_closed int
    pub max_lifetime_closed int
    pub max_lifetime_ns int
    pub max_idle_time_ns int
}

struct PooledConn {
    pub dc driver.Conn
    pub created_ns int
    pub idle_ns int
}

// Sendable wrapper: bare `chan driver.Connector` is illegal (struct@ is a
// dynamic box). A plain struct field around it is sendable, like PooledConn.
struct ConnSlot {
    pub c driver.Connector
}

pub struct DB {
    pub drv driver.Driver
    pub dsn string
    pub use_connector int
    pub opener chan ConnSlot
    pub idle chan PooledConn
    pub st chan PoolState
}

pub struct Conn {
    pub closed int
    pub created_ns int
    pub idle_ns int
    pub idle chan PooledConn
    pub pst chan PoolState
    pub drv driver.Driver
    pub dsn string
    pub use_connector int
    pub opener chan ConnSlot
}

pub struct Tx {
    pub slot chan PooledConn
    pub dtx driver.Tx
    pub done int
    pub from_pool int
    pub created_ns int
    pub idle_ns int
    pub idle chan PooledConn
    pub pst chan PoolState
    pub drv driver.Driver
    pub dsn string
    pub use_connector int
    pub opener chan ConnSlot
}

pub struct Result {
    pub last_insert_id int
    pub rows_affected int
}

pub struct NullInt64 {
    pub v int
    pub valid bool
}

pub struct NullString {
    pub s string
    pub valid bool
}

pub struct NullBool {
    pub v bool
    pub valid bool
}

pub struct NullFloat64 {
    pub v f64
    pub valid bool
}

pub struct NullInt32 {
    pub v i32
    pub valid bool
}

pub struct NullByte {
    pub v u8
    pub valid bool
}

pub struct NullTime {
    pub t time.Time
    pub valid bool
}

pub struct ColumnType {
    pub col string
    pub db_type string
    pub length int
    pub length_ok bool
    pub nullable bool
    pub nullable_ok bool
    pub precision int
    pub scale int
    pub precision_ok bool
}

pub struct Rows {
    pub cols []string
    pub cells []string
    pub cur []string
    pub ncols int
    pub i int
    pub closed int
    pub err string
    pub has int
    pub pooled int
    pub idle chan PooledConn
    pub pst chan PoolState
}

pub struct Row {
    pub cells []string
    pub err string
}

pub struct Stmt {
    pub ds driver.Stmt
    pub qtext string
    pub closed int
    pub from_db int
    pub created_ns int
    pub idle_ns int
    pub idle chan PooledConn
    pub pst chan PoolState
    pub drv driver.Driver
    pub dsn string
    pub use_connector int
    pub opener chan ConnSlot
}

pub fn named(name string, value temp) NamedArg {
    << NamedArg{name: name + "", value: value}
}

fn default_pool_state() PoolState {
    << PoolState{closed: 0, max_open: 0, max_idle: 2, num_open: 0, num_in_use: 0, wait_count: 0, max_idle_closed: 0, max_idle_time_closed: 0, max_lifetime_closed: 0, max_lifetime_ns: 0, max_idle_time_ns: 0}
}

fn new_db(drv driver.Driver, dsn string, use_connector int, opener chan ConnSlot) DB {
    idle := chan PooledConn{cap: 64}
    st := chan PoolState{cap: 1}
    st <- default_pool_state()
    << DB{drv: drv, dsn: dsn, use_connector: use_connector, opener: opener, idle: idle, st: st}
}

fn pool_open_src(drv driver.Driver, dsn string, use_connector int, opener chan ConnSlot, ctx &context.Context) driver.Conn {
    if use_connector != 0 {
        slot := <-opener
        c := slot.c.connect(ctx)
        opener <- slot
        << c
    }
    d := drv.dup()
    << d.open(dsn + "")
}

fn pool_put(idle chan PooledConn, pst chan PoolState, pc PooledConn) {
    $s := <-pst
    if s.num_in_use > 0 {
        s.num_in_use = s.num_in_use - 1
    }
    if s.closed != 0 {
        if s.num_open > 0 {
            s.num_open = s.num_open - 1
        }
        pst <- s
        _ := pc.dc.close()
        <<
    }
    now := time.now()
    if s.max_lifetime_ns > 0 {
        if now - pc.created_ns >= s.max_lifetime_ns {
            s.max_lifetime_closed = s.max_lifetime_closed + 1
            if s.num_open > 0 {
                s.num_open = s.num_open - 1
            }
            pst <- s
            _ := pc.dc.close()
            <<
        }
    }
    if !pc.dc.is_valid() {
        if s.num_open > 0 {
            s.num_open = s.num_open - 1
        }
        pst <- s
        _ := pc.dc.close()
        <<
    }
    idle_n := s.num_open - s.num_in_use
    if s.max_idle == 0 || idle_n > s.max_idle {
        s.max_idle_closed = s.max_idle_closed + 1
        if s.num_open > 0 {
            s.num_open = s.num_open - 1
        }
        pst <- s
        _ := pc.dc.close()
        <<
    }
    pst <- s
    $x := pc
    x.idle_ns = now
    idle <- x
}

// Go: ErrBadConn conn is closed, not returned to idle.
fn pool_drop(pst chan PoolState, pc PooledConn) {
    $s := <-pst
    if s.num_in_use > 0 {
        s.num_in_use = s.num_in_use - 1
    }
    if s.num_open > 0 {
        s.num_open = s.num_open - 1
    }
    pst <- s
    _ := pc.dc.close()
}

fn pool_expired(s &PoolState, created_ns int, idle_ns int, now int) int {
    if s.max_lifetime_ns > 0 {
        if now - created_ns >= s.max_lifetime_ns {
            << 1
        }
    }
    if s.max_idle_time_ns > 0 {
        if idle_ns > 0 {
            if now - idle_ns >= s.max_idle_time_ns {
                << 2
            }
        }
    }
    << 0
}

fn pool_get_src(drv driver.Driver, dsn string, use_connector int, opener chan ConnSlot, idle chan PooledConn, pst chan PoolState, ctx &context.Context) PooledConn {
    context.err(ctx) or >>
    $spin := 1
    while spin != 0 {
        $s := <-pst
        if s.closed != 0 {
            pst <- s
            >> errors.new("sql: database is closed")
        }
        select {
            got := <-idle {
                now := time.now()
                kind := pool_expired(&s, got.created_ns, got.idle_ns, now)
                if kind != 0 {
                    if kind == 1 {
                        s.max_lifetime_closed = s.max_lifetime_closed + 1
                    } else {
                        s.max_idle_time_closed = s.max_idle_time_closed + 1
                    }
                    if s.num_open > 0 {
                        s.num_open = s.num_open - 1
                    }
                    pst <- s
                    _ := got.dc.close()
                    ->
                }
                if !got.dc.is_valid() {
                    if s.num_open > 0 {
                        s.num_open = s.num_open - 1
                    }
                    pst <- s
                    _ := got.dc.close()
                    ->
                }
                rmsg := got.dc.reset_session(ctx)
                if rmsg.len > 0 {
                    if s.num_open > 0 {
                        s.num_open = s.num_open - 1
                    }
                    pst <- s
                    _ := got.dc.close()
                    ->
                }
                s.num_in_use = s.num_in_use + 1
                pst <- s
                << got
            }
            else {
                if s.max_open > 0 && s.num_open >= s.max_open {
                    s.wait_count = s.wait_count + 1
                    pst <- s
                    select {
                        got := <-idle {
                            $s2 := <-pst
                            if s2.closed != 0 {
                                pst <- s2
                                _ := got.dc.close()
                                >> errors.new("sql: database is closed")
                            }
                            if !got.dc.is_valid() {
                                if s2.num_open > 0 {
                                    s2.num_open = s2.num_open - 1
                                }
                                pst <- s2
                                _ := got.dc.close()
                                ->
                            }
                            rmsg := got.dc.reset_session(ctx)
                            if rmsg.len > 0 {
                                if s2.num_open > 0 {
                                    s2.num_open = s2.num_open - 1
                                }
                                pst <- s2
                                _ := got.dc.close()
                                ->
                            }
                            s2.num_in_use = s2.num_in_use + 1
                            pst <- s2
                            << got
                        }
                        _ := <-ctx.done {
                            >> errors.new("context canceled")
                        }
                    }
                } else {
                    s.num_open = s.num_open + 1
                    s.num_in_use = s.num_in_use + 1
                    pst <- s
                    c := pool_open_src(drv, dsn + "", use_connector, opener, ctx)
                    now := time.now()
                    << PooledConn{dc: c, created_ns: now, idle_ns: 0}
                }
            }
        }
    }
    >> errors.new("sql: database is closed")
}

fn pool_get(db &DB, ctx &context.Context) PooledConn {
    << pool_get_src(db.drv.dup(), db.dsn + "", db.use_connector, db.opener, db.idle, db.st, ctx) or >>
}

fn pool_get_stmt(s &Stmt, ctx &context.Context) PooledConn {
    << pool_get_src(s.drv.dup(), s.dsn + "", s.use_connector, s.opener, s.idle, s.pst, ctx) or >>
}

fn pool_trim_idle(idle chan PooledConn, pst chan PoolState) {
    $spin := 1
    while spin != 0 {
        $s := <-pst
        idle_n := s.num_open - s.num_in_use
        if idle_n <= s.max_idle {
            pst <- s
            spin = 0
            ->
        }
        pst <- s
        select {
            pc := <-idle {
                $s2 := <-pst
                if s2.num_open > 0 {
                    s2.num_open = s2.num_open - 1
                }
                s2.max_idle_closed = s2.max_idle_closed + 1
                pst <- s2
                _ := pc.dc.close()
            }
            else {
                spin = 0
            }
        }
    }
}

fn named_payload(na NamedArg) temp {
    if na.value is int {
        x := na.value as int
        << x
    }
    if na.value is string {
        s := na.value as string
        << s
    }
    if na.value is bool {
        b := na.value as bool
        << b
    }
    if na.value is f64 {
        x := na.value as f64
        << x
    }
    if na.value is time.Time {
        tm := na.value as time.Time
        << tm
    }
    if na.value is []u8 {
        bs := na.value as []u8
        << bs
    }
    << 0
}

struct NvSnap {
    name string
    ordinal int
    wire string
}

fn snap_pos(ord int, v temp) NvSnap {
    << NvSnap{name: "", ordinal: ord, wire: driver.encode_value(v)}
}

fn snap_named(ord int, na NamedArg) NvSnap {
    nm := na.name + ""
    v := named_payload(na)
    << NvSnap{name: nm, ordinal: ord, wire: driver.encode_value(v)}
}

fn nvs_from_snaps(snaps &[]NvSnap) []driver.NamedValue {
    $out := []driver.NamedValue{}
    n := snaps.len
    if n >= 1 {
        nm := snaps[0].name + ""
        ord := snaps[0].ordinal
        w := snaps[0].wire + ""
        out.push(driver.NamedValue{name: nm, ordinal: ord, value: driver.decode_value(w)})
    }
    if n >= 2 {
        nm := snaps[1].name + ""
        ord := snaps[1].ordinal
        w := snaps[1].wire + ""
        out.push(driver.NamedValue{name: nm, ordinal: ord, value: driver.decode_value(w)})
    }
    if n >= 3 {
        nm := snaps[2].name + ""
        ord := snaps[2].ordinal
        w := snaps[2].wire + ""
        out.push(driver.NamedValue{name: nm, ordinal: ord, value: driver.decode_value(w)})
    }
    << out
}

// Const-index `...temp` → cloneable wire snaps (retry needs a second `[]NamedValue`).
fn collect_snaps(args []temp) []NvSnap {
    $out := []NvSnap{}
    n := args.len
    if n == 0 {
        << out
    }
    if n >= 1 {
        if args[0] is NamedArg {
            na := args[0] as NamedArg
            out.push(snap_named(1, na))
        } else {
            if args[0] is int {
                x := args[0] as int
                out.push(snap_pos(1, x))
            } else {
                if args[0] is string {
                    s := args[0] as string
                    out.push(snap_pos(1, s))
                } else {
                    if args[0] is bool {
                        b := args[0] as bool
                        out.push(snap_pos(1, b))
                    } else {
                        if args[0] is f64 {
                            x := args[0] as f64
                            out.push(snap_pos(1, x))
                        } else {
                            if args[0] is time.Time {
                                tm := args[0] as time.Time
                                out.push(snap_pos(1, tm))
                            } else {
                                if args[0] is []u8 {
                                    bs := args[0] as []u8
                                    out.push(snap_pos(1, bs))
                                } else {
                                    out.push(snap_pos(1, 0))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if n >= 2 {
        if args[1] is NamedArg {
            na := args[1] as NamedArg
            out.push(snap_named(2, na))
        } else {
            if args[1] is int {
                x := args[1] as int
                out.push(snap_pos(2, x))
            } else {
                if args[1] is string {
                    s := args[1] as string
                    out.push(snap_pos(2, s))
                } else {
                    if args[1] is bool {
                        b := args[1] as bool
                        out.push(snap_pos(2, b))
                    } else {
                        if args[1] is f64 {
                            x := args[1] as f64
                            out.push(snap_pos(2, x))
                        } else {
                            if args[1] is time.Time {
                                tm := args[1] as time.Time
                                out.push(snap_pos(2, tm))
                            } else {
                                if args[1] is []u8 {
                                    bs := args[1] as []u8
                                    out.push(snap_pos(2, bs))
                                } else {
                                    out.push(snap_pos(2, 0))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if n >= 3 {
        if args[2] is NamedArg {
            na := args[2] as NamedArg
            out.push(snap_named(3, na))
        } else {
            if args[2] is int {
                x := args[2] as int
                out.push(snap_pos(3, x))
            } else {
                if args[2] is string {
                    s := args[2] as string
                    out.push(snap_pos(3, s))
                } else {
                    if args[2] is bool {
                        b := args[2] as bool
                        out.push(snap_pos(3, b))
                    } else {
                        if args[2] is f64 {
                            x := args[2] as f64
                            out.push(snap_pos(3, x))
                        } else {
                            if args[2] is time.Time {
                                tm := args[2] as time.Time
                                out.push(snap_pos(3, tm))
                            } else {
                                if args[2] is []u8 {
                                    bs := args[2] as []u8
                                    out.push(snap_pos(3, bs))
                                } else {
                                    out.push(snap_pos(3, 0))
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    << out
}

fn collect_nvs(args []temp) []driver.NamedValue {
    snaps := collect_snaps(args)
    << nvs_from_snaps(&snaps)
}

fn stmt_arity(s &Stmt, n int) int {
    want := s.ds.num_input()
    if want >= 0 {
        if n != want {
            >> errors.new("sql: expected " + str(want) + " arguments, got " + str(n))
        }
    }
    << 0
}

pub fn open(d driver.Driver, name string) DB {
    held := d.dup()
    opener := chan ConnSlot{cap: 1}
    << new_db(held, name + "", 0, opener)
}

pub fn open_db(c driver.Connector) DB {
    d := c.driver()
    opener := chan ConnSlot{cap: 1}
    opener <- ConnSlot{c: c}
    << new_db(d, "", 1, opener)
}

pub fn open_db_context(ctx &context.Context, c driver.Connector) DB {
    context.err(ctx) or >>
    << open_db(c)
}

fn clone_strs(src &[]string) []string {
    $out := []string{}
    $i := 0
    while i < src.len {
        out.push(src[i] + "")
        i = i + 1
    }
    << out
}

fn wrap_rows(out driver.RowsResult, idle chan PooledConn, pst chan PoolState) Rows {
    cols := clone_strs(&out.columns)
    cells := clone_strs(&out.cells)
    nc := out.ncols
    msg := out.err + ""
    << Rows{cols: cols, cells: cells, cur: []string{}, ncols: nc, i: 0, closed: 0, err: msg, has: 0, pooled: 0, idle: idle, pst: pst}
}

fn drop_rows(r $&Rows) {
    if r.closed == 0 {
        r.closed = 1
    }
}

fn take_query(out driver.RowsResult, idle chan PooledConn, pst chan PoolState) Rows {
    msg := out.err + ""
    $rs := wrap_rows(out, idle, pst)
    if msg.len > 0 {
        drop_rows($&rs)
        >> errors.new(msg)
    }
    << rs
}

fn row_from_ds(out driver.RowsResult, idle chan PooledConn, pst chan PoolState) Row {
    msg := out.err + ""
    $rs := wrap_rows(out, idle, pst)
    if msg.len > 0 {
        drop_rows($&rs)
        << Row{cells: []string{}, err: msg}
    }
    if !rs.next() {
        e := rs.err() + ""
        drop_rows($&rs)
        if e.len > 0 {
            << Row{cells: []string{}, err: e}
        }
        << Row{cells: []string{}, err: "sql: no rows in result set"}
    }
    cells := clone_strs(&rs.cur)
    drop_rows($&rs)
    << Row{cells: cells, err: ""}
}

pub fn is_no_rows(e errors.Error) bool {
    << e.msg() == "sql: no rows in result set"
}

pub fn is_tx_done(e errors.Error) bool {
    << e.msg() == "sql: transaction has already been committed or rolled back"
}

pub fn is_conn_done(e errors.Error) bool {
    << e.msg() == "sql: connection is already closed"
}

pub fn is_bad_conn(e errors.Error) bool {
    << driver.is_bad_conn(e.msg())
}

pub fn isolation_name(level int) string {
    if level == LEVEL_DEFAULT {
        << "Default"
    }
    if level == LEVEL_READ_UNCOMMITTED {
        << "Read Uncommitted"
    }
    if level == LEVEL_READ_COMMITTED {
        << "Read Committed"
    }
    if level == LEVEL_WRITE_COMMITTED {
        << "Write Committed"
    }
    if level == LEVEL_REPEATABLE_READ {
        << "Repeatable Read"
    }
    if level == LEVEL_SNAPSHOT {
        << "Snapshot"
    }
    if level == LEVEL_SERIALIZABLE {
        << "Serializable"
    }
    if level == LEVEL_LINEARIZABLE {
        << "Linearizable"
    }
    << ""
}

fn result_from(out driver.ExecResult) Result {
    if out.err.len > 0 {
        >> errors.new(out.err + "")
    }
    << Result{last_insert_id: out.last_insert_id, rows_affected: out.rows_affected}
}

// One get/put-or-drop. Caller unrolls (pc cannot live in a while, M2b).
// Bad-conn arm must `<<` (not `>>`): a terminating return clears the
// pending move so the fall-through `pool_put` is legal.
fn db_ping_once(db &DB, ctx &context.Context) string {
    pc := pool_get(db, ctx) or >>
    msg := pc.dc.ping()
    if driver.is_bad_conn(msg + "") {
        pool_drop(db.st, pc)
        << msg
    }
    pool_put(db.idle, db.st, pc)
    << msg
}

fn db_exec_once(db &DB, ctx &context.Context, q &string, snaps &[]NvSnap) driver.ExecResult {
    pc := pool_get(db, ctx) or >>
    vs := nvs_from_snaps(snaps)
    out := pc.dc.exec(q + "", vs)
    if driver.is_bad_conn(out.err + "") {
        pool_drop(db.st, pc)
        << out
    }
    pool_put(db.idle, db.st, pc)
    << out
}

fn db_query_once(db &DB, ctx &context.Context, q &string, snaps &[]NvSnap) Rows {
    pc := pool_get(db, ctx) or >>
    vs := nvs_from_snaps(snaps)
    out := pc.dc.query(q + "", vs)
    msg := out.err + ""
    if driver.is_bad_conn(msg + "") {
        $rs := wrap_rows(out, db.idle, db.st)
        drop_rows($&rs)
        pool_drop(db.st, pc)
        rs.err = driver.err_bad_conn()
        << rs
    }
    pool_put(db.idle, db.st, pc)
    << take_query(out, db.idle, db.st) or >>
}

fn db_query_row_once(db &DB, ctx &context.Context, q &string, snaps &[]NvSnap) Row {
    pc := pool_get(db, ctx) or (err) {
        << Row{cells: []string{}, err: err.msg()}
    }
    vs := nvs_from_snaps(snaps)
    out := pc.dc.query(q + "", vs)
    msg := out.err + ""
    if driver.is_bad_conn(msg + "") {
        pool_drop(db.st, pc)
        << Row{cells: []string{}, err: driver.err_bad_conn()}
    }
    pool_put(db.idle, db.st, pc)
    << row_from_ds(out, db.idle, db.st)
}

fn db_exec(db &DB, ctx &context.Context, query string, args []temp) Result {
    snaps := collect_snaps(args)
    q := query + ""
    a := db_exec_once(db, ctx, &q, &snaps) or >>
    if driver.is_bad_conn(a.err + "") {
        b := db_exec_once(db, ctx, &q, &snaps) or >>
        if !driver.is_bad_conn(b.err + "") {
            if b.err.len > 0 {
                >> errors.new(b.err + "")
            }
            << result_from(b)
        }
        c := db_exec_once(db, ctx, &q, &snaps) or >>
        if c.err.len > 0 && !driver.is_bad_conn(c.err + "") {
            >> errors.new(c.err + "")
        }
        << result_from(c)
    }
    if a.err.len > 0 {
        >> errors.new(a.err + "")
    }
    << result_from(a)
}

fn db_query(db &DB, ctx &context.Context, query string, args []temp) Rows {
    snaps := collect_snaps(args)
    q := query + ""
    a := db_query_once(db, ctx, &q, &snaps) or >>
    if !driver.is_bad_conn(a.err + "") {
        << a
    }
    b := db_query_once(db, ctx, &q, &snaps) or >>
    if !driver.is_bad_conn(b.err + "") {
        << b
    }
    c := db_query_once(db, ctx, &q, &snaps) or >>
    if driver.is_bad_conn(c.err + "") {
        >> errors.new(c.err + "")
    }
    << c
}

fn db_query_row(db &DB, ctx &context.Context, query string, args []temp) Row {
    snaps := collect_snaps(args)
    q := query + ""
    a := db_query_row_once(db, ctx, &q, &snaps)
    if !driver.is_bad_conn(a.err + "") {
        << a
    }
    b := db_query_row_once(db, ctx, &q, &snaps)
    if !driver.is_bad_conn(b.err + "") {
        << b
    }
    << db_query_row_once(db, ctx, &q, &snaps)
}

fn db_stmt(db &DB, pc PooledConn, ds driver.Stmt, q string) Stmt {
    created := pc.created_ns
    idle_at := pc.idle_ns
    pool_put(db.idle, db.st, pc)
    << Stmt{ds: ds, qtext: q, closed: 0, from_db: 1, created_ns: created, idle_ns: idle_at, idle: db.idle, pst: db.st, drv: db.drv.dup(), dsn: db.dsn + "", use_connector: db.use_connector, opener: db.opener}
}

fn db_prepare(db &DB, ctx &context.Context, query string) Stmt {
    pc := pool_get(db, ctx) or >>
    q := query + ""
    s := pc.dc.prepare(q + "")
    << db_stmt(db, pc, s, q)
}

fn db_prepare_ctx(db &DB, ctx &context.Context, query string) Stmt {
    pc := pool_get(db, ctx) or >>
    q := query + ""
    s := pc.dc.prepare_context(ctx, q + "")
    << db_stmt(db, pc, s, q)
}

fn tx_park(pc PooledConn) chan PooledConn {
    slot := chan PooledConn{cap: 1}
    slot <- pc
    << slot
}

fn db_begin(db &DB, ctx &context.Context) Tx {
    pc := pool_get(db, ctx) or >>
    t := pc.dc.begin()
    created := pc.created_ns
    idle_at := pc.idle_ns
    slot := tx_park(pc)
    << Tx{slot: slot, dtx: t, done: 0, from_pool: 1, created_ns: created, idle_ns: idle_at, idle: db.idle, pst: db.st, drv: db.drv.dup(), dsn: db.dsn + "", use_connector: db.use_connector, opener: db.opener}
}

fn db_begin_tx(db &DB, ctx &context.Context, opts TxOptions) Tx {
    pc := pool_get(db, ctx) or >>
    t := pc.dc.begin_tx(opts.isolation, opts.read_only)
    created := pc.created_ns
    idle_at := pc.idle_ns
    slot := tx_park(pc)
    << Tx{slot: slot, dtx: t, done: 0, from_pool: 1, created_ns: created, idle_ns: idle_at, idle: db.idle, pst: db.st, drv: db.drv.dup(), dsn: db.dsn + "", use_connector: db.use_connector, opener: db.opener}
}

pub fn (db &DB) driver() driver.Driver {
    << db.drv.dup()
}

pub fn (db &DB) ping() int {
    ctx := context.background()
    << db.ping_context(&ctx) or >>
}

pub fn (db &DB) ping_context(ctx &context.Context) int {
    a := db_ping_once(db, ctx) or >>
    if !driver.is_bad_conn(a + "") {
        if a.len > 0 {
            >> errors.new(a)
        }
        << 0
    }
    b := db_ping_once(db, ctx) or >>
    if !driver.is_bad_conn(b + "") {
        if b.len > 0 {
            >> errors.new(b)
        }
        << 0
    }
    d := db_ping_once(db, ctx) or >>
    if driver.is_bad_conn(d + "") {
        >> errors.new(d)
    }
    if d.len > 0 {
        >> errors.new(d)
    }
    << 0
}

pub fn (db &DB) exec(query string, args <-> temp) Result {
    ctx := context.background()
    << db_exec(db, &ctx, query, args) or >>
}

pub fn (db &DB) exec_context(ctx &context.Context, query string, args <-> temp) Result {
    << db_exec(db, ctx, query, args) or >>
}

// Closed-statement placeholders. Interface fields cannot be int 0.
struct SqlNullStmt {}
fn (s SqlNullStmt) num_input() int { << 0 }
fn (s SqlNullStmt) exec(a []driver.NamedValue) driver.ExecResult {
    << driver.ExecResult{last_insert_id: 0, rows_affected: 0, err: "sql: statement is closed"}
}
fn (s SqlNullStmt) query(a []driver.NamedValue) driver.RowsResult {
    << driver.RowsResult{columns: []string{}, cells: []string{}, ncols: 0, err: "sql: statement is closed"}
}
fn (s SqlNullStmt) close() string { << "" }

struct SqlNullTx {}
fn (t SqlNullTx) commit() string { << "sql: transaction is closed" }
fn (t SqlNullTx) rollback() string { << "sql: transaction is closed" }

struct SqlNullConn {}
fn (c SqlNullConn) ping() string { << "sql: connection is closed" }
fn (c SqlNullConn) exec(q string, a []driver.NamedValue) driver.ExecResult {
    << driver.ExecResult{last_insert_id: 0, rows_affected: 0, err: "sql: connection is closed"}
}
fn (c SqlNullConn) query(q string, a []driver.NamedValue) driver.RowsResult {
    << driver.RowsResult{columns: []string{}, cells: []string{}, ncols: 0, err: "sql: connection is closed"}
}
fn (c SqlNullConn) close() string { << "" }
fn (c SqlNullConn) dup() driver.Conn { << driver.Conn(c) }
fn (c SqlNullConn) prepare(q string) driver.Stmt { << driver.Stmt(SqlNullStmt{}) }
fn (c SqlNullConn) prepare_context(ctx &context.Context, q string) driver.Stmt { << driver.Stmt(SqlNullStmt{}) }
fn (c SqlNullConn) begin() driver.Tx { << driver.Tx(SqlNullTx{}) }
fn (c SqlNullConn) begin_tx(iso int, ro bool) driver.Tx { << driver.Tx(SqlNullTx{}) }
fn (c SqlNullConn) reset_session(ctx &context.Context) string { << "" }
fn (c SqlNullConn) is_valid() bool { << false }

struct SqlNullDriver {}
fn (d SqlNullDriver) open(dsn string) driver.Conn { << driver.Conn(SqlNullConn{}) }
fn (d SqlNullDriver) dup() driver.Driver { << driver.Driver(d) }

struct SqlNullConnector {}
fn (c SqlNullConnector) connect(ctx &context.Context) driver.Conn { << driver.Conn(SqlNullConn{}) }
fn (c SqlNullConnector) driver() driver.Driver { << driver.Driver(SqlNullDriver{}) }

fn sql_empty_rows() Rows {
    << Rows{cols: []string{}, cells: []string{}, cur: []string{}, ncols: 0, i: 0, closed: 1, err: "", has: 0, pooled: 0, idle: chan PooledConn{cap: 1}, pst: chan PoolState{cap: 1}}
}

fn sql_empty_stmt(q string) Stmt {
    << Stmt{ds: driver.Stmt(SqlNullStmt{}), qtext: q + "", closed: 1, from_db: 0, created_ns: 0, idle_ns: 0, idle: chan PooledConn{cap: 1}, pst: chan PoolState{cap: 1}, drv: driver.Driver(SqlNullDriver{}), dsn: "", use_connector: 0, opener: chan ConnSlot{cap: 1}}
}

fn sql_empty_row() Row {
    << Row{cells: []string{}, err: ""}
}

pub fn (db &DB) query(query string, args <-> temp) Rows {
    ctx := context.background()
    << db_query(db, &ctx, query, args) or >>
}

pub fn (db &DB) query_context(ctx &context.Context, query string, args <-> temp) Rows {
    << db_query(db, ctx, query, args) or (err) {
        << sql_empty_rows()
    }
}

pub fn (db &DB) query_row(query string, args <-> temp) Row {
    ctx := context.background()
    << db_query_row(db, &ctx, query, args)
}

pub fn (db &DB) query_row_context(ctx &context.Context, query string, args <-> temp) Row {
    << db_query_row(db, ctx, query, args)
}

pub fn (db &DB) prepare(query string) Stmt {
    ctx := context.background()
    << db_prepare(db, &ctx, query) or (err) {
        << sql_empty_stmt("")
    }
}

pub fn (db &DB) prepare_context(ctx &context.Context, query string) Stmt {
    st := db_prepare_ctx(db, ctx, query) or (err) {
        >> err
    }
    << st
}

pub fn (db &DB) begin() Tx {
    ctx := context.background()
    << db_begin(db, &ctx) or (err) {
        >> err
    }
}

pub fn (db &DB) begin_tx(ctx &context.Context, opts TxOptions) Tx {
    << db_begin_tx(db, ctx, opts) or (err) {
        >> err
    }
}

pub fn (db &DB) set_max_open_conns(n int) {
    $v := n
    if v < 0 {
        v = 0
    }
    $s := <-db.st
    s.max_open = v
    if v > 0 && s.max_idle > v {
        s.max_idle = v
    }
    db.st <- s
    pool_trim_idle(db.idle, db.st)
}

pub fn (db &DB) set_max_idle_conns(n int) {
    $v := n
    if v < 0 {
        v = 0
    }
    if v > 64 {
        v = 64
    }
    $s := <-db.st
    if s.max_open > 0 && v > s.max_open {
        v = s.max_open
    }
    s.max_idle = v
    db.st <- s
    pool_trim_idle(db.idle, db.st)
}

pub fn (db &DB) set_conn_max_lifetime(d int) {
    $v := d
    if v < 0 {
        v = 0
    }
    $s := <-db.st
    s.max_lifetime_ns = v
    db.st <- s
}

pub fn (db &DB) set_conn_max_idle_time(d int) {
    $v := d
    if v < 0 {
        v = 0
    }
    $s := <-db.st
    s.max_idle_time_ns = v
    db.st <- s
}

pub fn (db &DB) stats() DBStats {
    $s := <-db.st
    $idle_n := s.num_open - s.num_in_use
    if idle_n < 0 {
        idle_n = 0
    }
    out := DBStats{max_open_connections: s.max_open, open_connections: s.num_open, in_use: s.num_in_use, idle: idle_n, wait_count: s.wait_count, max_idle_closed: s.max_idle_closed, max_idle_time_closed: s.max_idle_time_closed, max_lifetime_closed: s.max_lifetime_closed}
    db.st <- s
    << out
}

pub fn (db $&DB) close() int {
    $s := <-db.st
    if s.closed != 0 {
        db.st <- s
        << 0
    }
    s.closed = 1
    db.st <- s
    $last := ""
    $spin := 1
    while spin != 0 {
        select {
            pc := <-db.idle {
                $s2 := <-db.st
                if s2.num_open > 0 {
                    s2.num_open = s2.num_open - 1
                }
                db.st <- s2
                msg := pc.dc.close()
                if msg.len > 0 {
                    last = msg + ""
                }
            }
            else {
                spin = 0
            }
        }
    }
    if last.len > 0 {
        >> errors.new(last)
    }
    << 0
}

fn check_sql_conn(c &Conn) int {
    if c.closed != 0 {
        >> errors.new("sql: connection is already closed")
    }
    << 0
}

fn conn_get(c &Conn, ctx &context.Context) PooledConn {
    << pool_get_src(c.drv.dup(), c.dsn + "", c.use_connector, c.opener, c.idle, c.pst, ctx) or >>
}

fn conn_ping_once(c &Conn, ctx &context.Context) string {
    pc := conn_get(c, ctx) or >>
    msg := pc.dc.ping()
    if driver.is_bad_conn(msg + "") {
        pool_drop(c.pst, pc)
        << msg
    }
    pool_put(c.idle, c.pst, pc)
    << msg
}

fn conn_exec_once(c &Conn, ctx &context.Context, q &string, snaps &[]NvSnap) driver.ExecResult {
    pc := conn_get(c, ctx) or >>
    vs := nvs_from_snaps(snaps)
    out := pc.dc.exec(q + "", vs)
    if driver.is_bad_conn(out.err + "") {
        pool_drop(c.pst, pc)
        << out
    }
    pool_put(c.idle, c.pst, pc)
    << out
}

fn conn_query_once(c &Conn, ctx &context.Context, q &string, snaps &[]NvSnap) Rows {
    pc := conn_get(c, ctx) or >>
    vs := nvs_from_snaps(snaps)
    out := pc.dc.query(q + "", vs)
    msg := out.err + ""
    if driver.is_bad_conn(msg + "") {
        $rs := wrap_rows(out, c.idle, c.pst)
        drop_rows($&rs)
        pool_drop(c.pst, pc)
        rs.err = driver.err_bad_conn()
        << rs
    }
    pool_put(c.idle, c.pst, pc)
    << take_query(out, c.idle, c.pst) or >>
}

fn conn_query_row_once(c &Conn, ctx &context.Context, q &string, snaps &[]NvSnap) Row {
    pc := conn_get(c, ctx) or (err) {
        << Row{cells: []string{}, err: err.msg()}
    }
    vs := nvs_from_snaps(snaps)
    out := pc.dc.query(q + "", vs)
    msg := out.err + ""
    if driver.is_bad_conn(msg + "") {
        pool_drop(c.pst, pc)
        << Row{cells: []string{}, err: driver.err_bad_conn()}
    }
    pool_put(c.idle, c.pst, pc)
    << row_from_ds(out, c.idle, c.pst)
}

pub fn (db &DB) conn(ctx &context.Context) Conn {
    context.err(ctx) or >>
    pc := pool_get(db, ctx) or >>
    pool_put(db.idle, db.st, pc)
    << Conn{closed: 0, created_ns: 0, idle_ns: 0, idle: db.idle, pst: db.st, drv: db.drv.dup(), dsn: db.dsn + "", use_connector: db.use_connector, opener: db.opener}
}

pub fn (c &Conn) ping_context(ctx &context.Context) int {
    context.err(ctx) or >>
    check_sql_conn(c) or >>
    a := conn_ping_once(c, ctx) or >>
    if !driver.is_bad_conn(a + "") {
        if a.len > 0 {
            >> errors.new(a)
        }
        << 0
    }
    b := conn_ping_once(c, ctx) or >>
    if !driver.is_bad_conn(b + "") {
        if b.len > 0 {
            >> errors.new(b)
        }
        << 0
    }
    d := conn_ping_once(c, ctx) or >>
    if driver.is_bad_conn(d + "") {
        >> errors.new(d)
    }
    if d.len > 0 {
        >> errors.new(d)
    }
    << 0
}

pub fn (c &Conn) exec_context(ctx &context.Context, query string, args <-> temp) Result {
    context.err(ctx) or >>
    check_sql_conn(c) or >>
    snaps := collect_snaps(args)
    q := query + ""
    a := conn_exec_once(c, ctx, &q, &snaps) or >>
    if !driver.is_bad_conn(a.err + "") {
        << result_from(a) or >>
    }
    b := conn_exec_once(c, ctx, &q, &snaps) or >>
    if !driver.is_bad_conn(b.err + "") {
        << result_from(b) or >>
    }
    d := conn_exec_once(c, ctx, &q, &snaps) or >>
    << result_from(d) or >>
}

pub fn (c &Conn) query_context(ctx &context.Context, query string, args <-> temp) Rows {
    context.err(ctx) or >>
    check_sql_conn(c) or >>
    snaps := collect_snaps(args)
    q := query + ""
    a := conn_query_once(c, ctx, &q, &snaps) or >>
    if !driver.is_bad_conn(a.err + "") {
        << a
    }
    b := conn_query_once(c, ctx, &q, &snaps) or >>
    if !driver.is_bad_conn(b.err + "") {
        << b
    }
    d := conn_query_once(c, ctx, &q, &snaps) or >>
    if driver.is_bad_conn(d.err + "") {
        >> errors.new(d.err + "")
    }
    << d
}

pub fn (c &Conn) query_row_context(ctx &context.Context, query string, args <-> temp) Row {
    context.err(ctx) or (err) {
        << Row{cells: []string{}, err: err.msg()}
    }
    if c.closed != 0 {
        << Row{cells: []string{}, err: "sql: connection is already closed"}
    }
    snaps := collect_snaps(args)
    q := query + ""
    a := conn_query_row_once(c, ctx, &q, &snaps)
    if !driver.is_bad_conn(a.err + "") {
        << a
    }
    b := conn_query_row_once(c, ctx, &q, &snaps)
    if !driver.is_bad_conn(b.err + "") {
        << b
    }
    << conn_query_row_once(c, ctx, &q, &snaps)
}

pub fn (c &Conn) raw() driver.Conn {
    check_sql_conn(c) or >>
    ctx := context.background()
    pc := conn_get(c, &ctx) or >>
    out := pc.dc.dup()
    pool_put(c.idle, c.pst, pc)
    << out
}

pub fn (c &Conn) prepare_context(ctx &context.Context, query string) Stmt {
    context.err(ctx) or >>
    check_sql_conn(c) or >>
    q := query + ""
    pc := conn_get(c, ctx) or >>
    s := pc.dc.prepare_context(ctx, q + "")
    pool_put(c.idle, c.pst, pc)
    << Stmt{ds: s, qtext: q, closed: 0, from_db: 0, created_ns: c.created_ns, idle_ns: c.idle_ns, idle: c.idle, pst: c.pst, drv: c.drv.dup(), dsn: c.dsn + "", use_connector: c.use_connector, opener: c.opener}
}

pub fn (c &Conn) begin_tx(ctx &context.Context, opts TxOptions) Tx {
    context.err(ctx) or >>
    check_sql_conn(c) or >>
    pc := conn_get(c, ctx) or >>
    t := pc.dc.begin_tx(opts.isolation, opts.read_only)
    created := pc.created_ns
    idle_at := pc.idle_ns
    slot := tx_park(pc)
    << Tx{slot: slot, dtx: t, done: 0, from_pool: 1, created_ns: created, idle_ns: idle_at, idle: c.idle, pst: c.pst, drv: c.drv.dup(), dsn: c.dsn + "", use_connector: c.use_connector, opener: c.opener}
}

pub fn (c $&Conn) close() int {
    if c.closed != 0 {
        << 0
    }
    c.closed = 1
    << 0
}

pub fn (r Result) last_insert_id() int {
    << r.last_insert_id
}

pub fn (r Result) rows_affected() int {
    << r.rows_affected
}

pub fn (r $&Rows) next() bool {
    if r.closed != 0 {
        << false
    }
    if r.err.len > 0 {
        << false
    }
    if r.ncols <= 0 {
        r.has = 0
        << false
    }
    n := r.cells.len / r.ncols
    if r.i >= n {
        r.has = 0
        << false
    }
    $row := []string{}
    $j := 0
    while j < r.ncols {
        row.push(r.cells[r.i * r.ncols + j] + "")
        j = j + 1
    }
    r.cur = row
    r.has = 1
    r.i = r.i + 1
    << true
}

pub fn (r $&Rows) take() []temp {
    if r.i <= 0 {
        >> errors.new("sql: Scan called without calling Next")
    }
    if r.has == 0 {
        << []temp{}
    }
    $row := []temp{}
    $j := 0
    while j < r.cur.len {
        cell := r.cur[j] + ""
        row.push(driver.decode_value(cell))
        j = j + 1
    }
    << row
}

pub fn (r &Rows) columns() []string {
    $out := []string{}
    $i := 0
    while i < r.cols.len {
        out.push(r.cols[i] + "")
        i = i + 1
    }
    << out
}

pub fn (r $&Rows) close() {
    drop_rows(r)
}

pub fn (r &Rows) err() string {
    << r.err + ""
}

pub fn (ct ColumnType) name() string {
    << ct.col + ""
}

pub fn (ct ColumnType) database_type_name() string {
    << ct.db_type + ""
}

pub fn (ct ColumnType) length() driver.Number {
    << driver.Number{n: ct.length, ok: ct.length_ok}
}

pub fn (ct ColumnType) nullable() driver.NullInfo {
    << driver.NullInfo{nullable: ct.nullable, ok: ct.nullable_ok}
}

pub fn (ct ColumnType) decimal_size() driver.DecimalSize {
    << driver.DecimalSize{precision: ct.precision, scale: ct.scale, ok: ct.precision_ok}
}

pub fn (r &Rows) column_types() []ColumnType {
    $out := []ColumnType{}
    $i := 0
    while i < r.cols.len {
        out.push(ColumnType{col: r.cols[i] + "", db_type: "", length: 0, length_ok: false, nullable: false, nullable_ok: false, precision: 0, scale: 0, precision_ok: false})
        i = i + 1
    }
    << out
}

pub fn (r $&Rows) next_result_set() bool {
    _ := r
    << false
}

pub fn (r &Row) err() string {
    << r.err + ""
}

pub fn (r &Row) take() []temp {
    if r.err.len > 0 {
        >> errors.new(r.err + "")
    }
    $row := []temp{}
    $i := 0
    while i < r.cells.len {
        cell := r.cells[i] + ""
        row.push(driver.decode_value(cell))
        i = i + 1
    }
    << row
}

fn tx_live(t &Tx) int {
    if t.done != 0 {
        >> errors.new("sql: transaction has already been committed or rolled back")
    }
    << 0
}

fn tx_exec(t &Tx, query string, args []temp) Result {
    tx_live(t) or >>
    q := query + ""
    vs := collect_nvs(args)
    pc := tx_take(t)
    out := pc.dc.exec(q, vs)
    tx_restow(t, pc)
    << result_from(out) or >>
}

fn tx_query(t &Tx, query string, args []temp) Rows {
    tx_live(t) or >>
    q := query + ""
    vs := collect_nvs(args)
    pc := tx_take(t)
    out := pc.dc.query(q, vs)
    tx_restow(t, pc)
    << take_query(out, t.idle, t.pst) or >>
}

fn tx_query_row(t &Tx, query string, args []temp) Row {
    if t.done != 0 {
        << Row{cells: []string{}, err: "sql: transaction has already been committed or rolled back"}
    }
    q := query + ""
    vs := collect_nvs(args)
    pc := tx_take(t)
    out := pc.dc.query(q, vs)
    tx_restow(t, pc)
    << row_from_ds(out, t.idle, t.pst)
}

fn tx_prepare(t &Tx, query string) Stmt {
    tx_live(t) or >>
    q := query + ""
    pc := tx_take(t)
    s := pc.dc.prepare(q + "")
    tx_restow(t, pc)
    << Stmt{ds: s, qtext: q, closed: 0, from_db: 0, created_ns: t.created_ns, idle_ns: t.idle_ns, idle: t.idle, pst: t.pst, drv: t.drv.dup(), dsn: t.dsn + "", use_connector: t.use_connector, opener: t.opener}
}

fn tx_prepare_ctx(t &Tx, ctx &context.Context, query string) Stmt {
    tx_live(t) or >>
    q := query + ""
    pc := tx_take(t)
    s := pc.dc.prepare_context(ctx, q + "")
    tx_restow(t, pc)
    << Stmt{ds: s, qtext: q, closed: 0, from_db: 0, created_ns: t.created_ns, idle_ns: t.idle_ns, idle: t.idle, pst: t.pst, drv: t.drv.dup(), dsn: t.dsn + "", use_connector: t.use_connector, opener: t.opener}
}

pub fn (t &Tx) exec(query string, args <-> temp) Result {
    << tx_exec(t, query, args) or >>
}

pub fn (t &Tx) exec_context(ctx &context.Context, query string, args <-> temp) Result {
    context.err(ctx) or >>
    << tx_exec(t, query, args) or >>
}

pub fn (t &Tx) query(query string, args <-> temp) Rows {
    << tx_query(t, query, args) or >>
}

pub fn (t &Tx) query_context(ctx &context.Context, query string, args <-> temp) Rows {
    context.err(ctx) or >>
    << tx_query(t, query, args) or >>
}

pub fn (t &Tx) query_row(query string, args <-> temp) Row {
    << tx_query_row(t, query, args)
}

pub fn (t &Tx) query_row_context(ctx &context.Context, query string, args <-> temp) Row {
    context.err(ctx) or (err) {
        << Row{cells: []string{}, err: err.msg()}
    }
    << tx_query_row(t, query, args)
}

pub fn (t &Tx) prepare(query string) Stmt {
    << tx_prepare(t, query) or (err) {
        << sql_empty_stmt("")
    }
}

pub fn (t &Tx) prepare_context(ctx &context.Context, query string) Stmt {
    context.err(ctx) or >>
    << tx_prepare_ctx(t, ctx, query) or (err) {
        << sql_empty_stmt("")
    }
}

pub fn (t &Tx) stmt(s &Stmt) Stmt {
    q := s.qtext + ""
    << tx_prepare(t, q) or (err) {
        << sql_empty_stmt("")
    }
}

pub fn (t &Tx) stmt_context(ctx &context.Context, s &Stmt) Stmt {
    context.err(ctx) or >>
    q := s.qtext + ""
    << tx_prepare_ctx(t, ctx, q) or >>
}

fn tx_take(t &Tx) PooledConn {
    << <-t.slot
}

fn tx_restow(t &Tx, pc PooledConn) {
    t.slot <- pc
}

fn tx_release(t $&Tx) {
    if t.from_pool != 0 {
        t.from_pool = 0
        pc := <-t.slot
        pool_put(t.idle, t.pst, pc)
    }
}

pub fn (t $&Tx) commit() int {
    if t.done != 0 {
        >> errors.new("sql: transaction has already been committed or rolled back")
    }
    msg := t.dtx.commit()
    t.done = 1
    tx_release(t)
    if msg.len > 0 {
        >> errors.new(msg)
    }
    << 0
}

pub fn (t $&Tx) rollback() int {
    if t.done != 0 {
        >> errors.new("sql: transaction has already been committed or rolled back")
    }
    msg := t.dtx.rollback()
    t.done = 1
    tx_release(t)
    if msg.len > 0 {
        >> errors.new(msg)
    }
    << 0
}

fn stmt_live(s &Stmt) int {
    if s.closed != 0 {
        >> errors.new("sql: statement is closed")
    }
    << 0
}

fn stmt_exec_db(s &Stmt, vs []driver.NamedValue) Result {
    stmt_arity(s, vs.len) or >>
    ctx := context.background()
    pc := pool_get_stmt(s, &ctx) or >>
    ds := pc.dc.prepare(s.qtext + "")
    out := ds.exec(vs)
    _ := ds.close()
    pool_put(s.idle, s.pst, pc)
    << result_from(out) or >>
}

fn stmt_query_db(s &Stmt, vs []driver.NamedValue) Rows {
    stmt_arity(s, vs.len) or >>
    ctx := context.background()
    pc := pool_get_stmt(s, &ctx) or >>
    ds := pc.dc.prepare(s.qtext + "")
    out := ds.query(vs)
    _ := ds.close()
    pool_put(s.idle, s.pst, pc)
    << take_query(out, s.idle, s.pst) or >>
}

fn stmt_exec(s &Stmt, args []temp) Result {
    stmt_live(s) or >>
    vs := collect_nvs(args)
    if s.from_db != 0 {
        << stmt_exec_db(s, vs) or >>
    }
    stmt_arity(s, vs.len) or >>
    out := s.ds.exec(vs)
    << result_from(out) or >>
}

fn stmt_query(s &Stmt, args []temp) Rows {
    stmt_live(s) or >>
    vs := collect_nvs(args)
    if s.from_db != 0 {
        << stmt_query_db(s, vs) or >>
    }
    stmt_arity(s, vs.len) or >>
    out := s.ds.query(vs)
    << take_query(out, s.idle, s.pst) or >>
}

fn stmt_query_row(s &Stmt, args []temp) Row {
    if s.closed != 0 {
        << Row{cells: []string{}, err: "sql: statement is closed"}
    }
    vs := collect_nvs(args)
    if s.from_db != 0 {
        wantn := s.ds.num_input()
        if wantn >= 0 {
            if vs.len != wantn {
                << Row{cells: []string{}, err: "sql: expected " + str(wantn) + " arguments, got " + str(vs.len)}
            }
        }
        ctx := context.background()
        pc := pool_get_stmt(s, &ctx) or (err) {
            << Row{cells: []string{}, err: err.msg()}
        }
        ds := pc.dc.prepare(s.qtext + "")
        out := ds.query(vs)
        _ := ds.close()
        pool_put(s.idle, s.pst, pc)
        << row_from_ds(out, s.idle, s.pst)
    }
    want := s.ds.num_input()
    if want >= 0 {
        if vs.len != want {
            << Row{cells: []string{}, err: "sql: expected " + str(want) + " arguments, got " + str(vs.len)}
        }
    }
    out := s.ds.query(vs)
    << row_from_ds(out, s.idle, s.pst)
}

pub fn (s &Stmt) exec(args <-> temp) Result {
    << stmt_exec(s, args) or >>
}

pub fn (s &Stmt) exec_context(ctx &context.Context, args <-> temp) Result {
    context.err(ctx) or >>
    << stmt_exec(s, args) or >>
}

pub fn (s &Stmt) query(args <-> temp) Rows {
    << stmt_query(s, args) or >>
}

pub fn (s &Stmt) query_context(ctx &context.Context, args <-> temp) Rows {
    context.err(ctx) or >>
    << stmt_query(s, args) or >>
}

pub fn (s &Stmt) query_row(args <-> temp) Row {
    << stmt_query_row(s, args)
}

pub fn (s &Stmt) query_row_context(ctx &context.Context, args <-> temp) Row {
    context.err(ctx) or (err) {
        << Row{cells: []string{}, err: err.msg()}
    }
    << stmt_query_row(s, args)
}

pub fn (s $&Stmt) close() {
    if s.closed != 0 {
        <<
    }
    s.closed = 1
    _ := s.ds.close()
}
