@database/sql/driver

#strconv
#context
#time

// Go `database/sql/driver`.
//
// Value is Xu `temp` (Go `driver.Value` = empty interface).
// Conn / Driver / Connector / Stmt / Tx are struct@ (Go interfaces).
// Connector.Connect is `connect(&context.Context)` (borrowed Go context).
// reset_session / is_valid are Go SessionResetter / Validator
// (closed-world Conn has no optional interfaces).
// DriverContext.OpenConnector cannot live on Driver: Gen1 type_of
// has no iface defer (Driver would name Connector and vice versa).
// Same concrete type implements Driver and Connector; call open_db.
// Exec/Query take `[]NamedValue` like Go QueryerContext/ExecerContext
// (closed-world struct@ has no optional Queryer).
// Boxed methods cannot `>>` (dynamic dispatch is not may_throw), so
// outcomes carry `err`.
//
// v1 query path is a concrete snapshot `RowsResult` (columns + flat
// cells + ncols + err), not Go streaming `driver.Rows`. sql.Rows
// iterates the snapshot; ColumnType* defaults live in the sql layer.
// (Gen1 InterfaceMethod only matches value receivers; `&`/`&mut` Rows
// itables were the C8 known-fail.)
//
// Declare result structs and Stmt/Tx before Conn/Driver so method
// signatures do not forward-reference (Gen1 type_of has no iface defer).

pub struct NamedValue {
    pub name string
    pub ordinal int
    pub value temp
}

pub struct ExecResult {
    pub last_insert_id int
    pub rows_affected int
    pub err string
}

pub struct RowsResult {
    pub columns []string
    pub cells []string
    pub ncols int
    pub err string
}

pub struct Number {
    pub n int
    pub ok bool
}

pub struct NullInfo {
    pub nullable bool
    pub ok bool
}

pub struct DecimalSize {
    pub precision int
    pub scale int
    pub ok bool
}

struct@ Stmt {
    fn num_input() int
    fn exec([]NamedValue) ExecResult
    fn query([]NamedValue) RowsResult
    fn close() string
}

struct@ Tx {
    fn commit() string
    fn rollback() string
}

struct@ Conn {
    fn ping() string
    fn exec(string, []NamedValue) ExecResult
    fn query(string, []NamedValue) RowsResult
    fn close() string
    fn dup() Conn
    fn prepare(string) Stmt
    fn prepare_context(&context.Context, string) Stmt
    fn begin() Tx
    fn begin_tx(int, bool) Tx
    fn reset_session(&context.Context) string
    fn is_valid() bool
}

struct@ Driver {
    fn open(string) Conn
    fn dup() Driver
}

struct@ Connector {
    fn connect(&context.Context) Conn
    fn driver() Driver
}

fn hex_digit(n int) string {
    d := "0123456789abcdef"
    if n < 0 {
        << "0"
    }
    if n > 15 {
        << "0"
    }
    << d[n:n + 1]
}

fn hex_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

fn encode_u8s(bs []u8) string {
    mut out := "y:"
    mut i := 0
    while i < bs.len {
        n := int(bs[i]) & 255
        hi := n / 16
        lo := n - hi * 16
        out = out + hex_digit(hi) + hex_digit(lo)
        i = i + 1
    }
    << out
}

fn decode_u8s(s string) []u8 {
    mut out := []u8{}
    if s.len % 2 != 0 {
        << out
    }
    mut i := 0
    while i < s.len {
        hi := hex_val(s[i] & 255)
        lo := hex_val(s[i + 1] & 255)
        if hi < 0 {
            << []u8{}
        }
        if lo < 0 {
            << []u8{}
        }
        out.push(u8(hi * 16 + lo))
        i = i + 2
    }
    << out
}

// Go driver.Value: nil, int64, float64, bool, []byte, string, time.Time.
// Wire tags n: i: f: b: y: s: t:.
fn encode_one(v temp) string {
    if v is int {
        x := v as int
        << "i:" + str(x)
    }
    if v is string {
        s := v as string
        << "s:" + s
    }
    if v is bool {
        b := v as bool
        if b {
            << "b:1"
        }
        << "b:0"
    }
    if v is f64 {
        x := v as f64
        fs := strconv.format_float(x, 103, -1) or (err) {
            << "f:0"
        }
        << "f:" + fs
    }
    if v is time.Time {
        tm := v as time.Time
        << "t:" + str(tm.unix_nano())
    }
    if v is []u8 {
        bs := v as []u8
        << encode_u8s(bs)
    }
    << "n:"
}

pub fn encode_value(v temp) string {
    << encode_one(v)
}

pub fn decode_value(s string) temp {
    if s.len < 2 {
        << ""
    }
    if (s[0] & 255) == 105 && (s[1] & 255) == 58 {
        t := s[2:s.len]
        n := strconv.atoi(&t) or (err) {
            << 0
        }
        << n
    }
    if (s[0] & 255) == 115 && (s[1] & 255) == 58 {
        << s[2:s.len]
    }
    if (s[0] & 255) == 98 && (s[1] & 255) == 58 {
        if s.len > 2 && (s[2] & 255) == 49 {
            << true
        }
        << false
    }
    if (s[0] & 255) == 102 && (s[1] & 255) == 58 {
        t := s[2:s.len]
        << strconv.parse_float(&t) or (err) {
            << 0.0
        }
    }
    if (s[0] & 255) == 116 && (s[1] & 255) == 58 {
        rest := s[2:s.len]
        n := strconv.atoi(&rest) or (err) {
            << time.unix(0, 0)
        }
        << time.unix_from_ns(n)
    }
    if (s[0] & 255) == 121 && (s[1] & 255) == 58 {
        rest := s[2:s.len]
        << decode_u8s(rest)
    }
    << ""
}

pub fn exec_ok(id int, n int) ExecResult {
    << ExecResult{last_insert_id: id, rows_affected: n, err: ""}
}

pub fn exec_err(msg string) ExecResult {
    << ExecResult{last_insert_id: 0, rows_affected: 0, err: msg + ""}
}

pub fn rows_err(msg string) RowsResult {
    << RowsResult{columns: []string{}, cells: []string{}, ncols: 0, err: msg + ""}
}

// Go `driver.ErrBadConn`. sql retries with a new connection.
pub fn err_bad_conn() string {
    << "driver: bad connection"
}

pub fn is_bad_conn(msg string) bool {
    << msg == "driver: bad connection"
}
