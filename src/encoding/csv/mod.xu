@encoding/csv


#errors
// CSV reader/writer aligned with Go `encoding/csv` (RFC4180 subset).
// Operates on owning strings (no io.Reader struct@ values). Errors never
// << a partial record. Default comma is ','; comment line support via
// `comment` rune (0 = off). Writes use '\n' (not CRLF).

pub struct Reader {
    pub data string
    pub pos int
    pub comma int
    pub comment int
    pub lazy_quotes bool
    pub sticky string
    pub fields_per_record int
    pub trim_leading_space bool
    pub learned int
}

pub struct Writer {
    pub buf string
    pub comma int
    pub need_nl bool
    pub use_crlf bool
}

pub fn new_reader(data string) Reader {
    << Reader{data: data, pos: 0, comma: 44, comment: 0, lazy_quotes: false, sticky: "", fields_per_record: 0 - 1, trim_leading_space: false, learned: 0}
}

pub fn new_writer() Writer {
    << Writer{buf: "", comma: 44, need_nl: false, use_crlf: false}
}

// host_crlf is true on Windows (xu_target_os==2). Go csv.Writer.UseCRLF
// defaults false on every OS; callers that want native CSV line endings
// can set_use_crlf(csv.host_crlf()).
pub fn host_crlf() bool {
    << xu_target_os() == 2
}

pub fn (r $&Reader) set_comma(c int) {
    r.comma = c
}

pub fn (r $&Reader) set_comment(c int) {
    r.comment = c
}

pub fn (w $&Writer) set_comma(c int) {
    w.comma = c
}

pub fn (w $&Writer) set_use_crlf(on bool) {
    w.use_crlf = on
}

pub fn (r $&Reader) set_lazy_quotes(on bool) {
    r.lazy_quotes = on
}

pub fn (r $&Reader) set_trim_leading_space(on bool) {
    r.trim_leading_space = on
}

pub fn (r $&Reader) set_fields_per_record(n int) {
    r.fields_per_record = n
}

fn (r $&Reader) at_end() bool {
    << r.pos >= r.data.len
}

fn (r $&Reader) peek() int {
    if r.pos >= r.data.len {
        << -1
    }
    << r.data[r.pos]
}

fn (r $&Reader) next() int {
    if r.pos >= r.data.len {
        << -1
    }
    c := r.data[r.pos]
    r.pos = r.pos + 1
    << c
}

// read returns the next record, or Err('eof') when exhausted.
pub fn (r $&Reader) read() []string {
    if r.sticky.len > 0 {
        >> errors.new(r.sticky + "")
    }
    // Skip empty lines and comment lines.
    while true {
        if r.at_end() {
            >> errors.new("EOF")
        }
        if r.pos == 0 && r.data.len >= 3 {
            if r.data[0] == 0xef && r.data[1] == 0xbb && r.data[2] == 0xbf {
                r.pos = 3
            }
        }
        c := r.peek()
        if c == 10 {
            r.next()
            ->
        }
        if c == 13 {
            r.next()
            if r.peek() == 10 {
                r.next()
            }
            ->
        }
        if r.comment != 0 && c == r.comment {
            while true {
                x := r.next()
                if x < 0 || x == 10 {
                    <-
                }
                if x == 13 {
                    if r.peek() == 10 {
                        r.next()
                    }
                    <-
                }
            }
            ->
        }
        <-
    }
    $fields := []string{}
    $field := ""
    $in_q := false
    while true {
        c := r.next()
        if c < 0 {
            if in_q {
                r.sticky = "csv: unterminated quoted field"
                >> errors.new(r.sticky + "")
            }
            fields.push(field + "")
            r.check_count(fields.len) or >>
            << fields
        }
        if in_q {
            if c == 34 {
                n := r.peek()
                if n == 34 {
                    r.next()
                    field = field + "\""
                    ->
                }
                if n < 0 || n == r.comma || n == 10 || n == 13 {
                    in_q = false
                    ->
                }
                if r.lazy_quotes {
                    field = field + "\""
                    ->
                }
                r.sticky = "csv: bare quote in quoted-field"
                >> errors.new(r.sticky + "")
            }
            field = field + string_from_byte(c)
            ->
        }
        if c == 34 {
            if field.len != 0 {
                if r.lazy_quotes {
                    field = field + "\""
                    ->
                }
                r.sticky = "csv: bare quote in non-quoted-field"
                >> errors.new(r.sticky + "")
            }
            in_q = true
            ->
        }
        if c == r.comma {
            fields.push(field + "")
            field = ""
            ->
        }
        if c == 10 {
            fields.push(field + "")
            r.check_count(fields.len) or >>
            << fields
        }
        if c == 13 {
            if r.peek() == 10 {
                r.next()
            }
            fields.push(field + "")
            r.check_count(fields.len) or >>
            << fields
        }
        if r.trim_leading_space {
            if field.len == 0 {
                if c == 32 || c == 9 {
                    ->
                }
            }
        }
        field = field + string_from_byte(c)
    }
    >> errors.new("csv: unreachable")
}

fn (r $&Reader) check_count(n int) int {
    if r.fields_per_record == 0 {
        if r.learned == 0 {
            r.learned = n
        } else if n != r.learned {
            r.sticky = "csv: wrong number of fields"
            >> errors.new(r.sticky + "")
        }
    } else if r.fields_per_record > 0 {
        if n != r.fields_per_record {
            r.sticky = "csv: wrong number of fields"
            >> errors.new(r.sticky + "")
        }
    }
    << 0
}

pub fn (r $&Reader) read_all() [][]string {
    $rows := [][]string{}
    while true {
        if r.sticky.len > 0 {
            >> errors.new(r.sticky + "")
        }
        if r.at_end() {
            << rows
        }
        rec := r.read() or (err) {
            if r.sticky.len > 0 {
                >> errors.new(r.sticky + "")
            }
            << rows
        }
        rows.push(rec)
    }
    << rows
}

fn needs_quote(s &string, comma int) bool {
    for i in 0:s.len {
        c := s[i]
        if c == comma || c == 34 || c == 10 || c == 13 {
            << true
        }
    }
    << false
}

fn quote_field(s &string) string {
    $out := "\""
    for i in 0:s.len {
        c := s[i]
        if c == 34 {
            out.push_str("\"\"")
        } else {
            out.push_str(string_from_byte(c))
        }
    }
    out.push_str("\"")
    << out
}

pub fn (w $&Writer) write(record &[]string) int {
    comma := w.comma
    crlf := w.use_crlf
    r := $&w.buf
    for i in 0:record.len {
        if i > 0 {
            r.push_str(string_from_byte(comma))
        }
        f := record[i] + ""
        if needs_quote(&f, comma) {
            r.push_str(quote_field(&f))
        } else {
            r.push_str(f)
        }
    }
    if crlf {
        r.push_str(string_from_byte(13))
    }
    r.push_str(string_from_byte(10))
    << record.len
}

pub fn (w $&Writer) write_all(records &[][]string) int {
    $n := 0
    for i in 0:records.len {
        $row := []string{}
        for j in 0:records[i].len {
            row.push(records[i][j] + "")
        }
        w.write(&row)
        n = n + 1
    }
    << n
}

pub fn (w &Writer) text() string {
    << w.buf + ""
}

pub fn (w $&Writer) flush() {
}
