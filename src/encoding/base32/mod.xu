@encoding/base32


#errors
// Base32 aligned with Go `encoding/base32`:
//   StdEncoding     A-Z2-7 + '='
//   HexEncoding     0-9A-V + '='  (M120)
//   RawStdEncoding  A-Z2-7 no pad (M121)
//   RawHexEncoding  0-9A-V no pad (M121)
// Decode rejects bad length or non-alphabet with Err — never a partial
// buffer. Encode/decode are single-pass O(n).

const B32_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
const B32_HEX_CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUV"

fn b32_val(c int) int {
    if c >= 65 && c <= 90 {
        << c - 65
    }
    if c >= 50 && c <= 55 {
        << c - 24
    }
    << -1
}

fn b32_hex_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 65 && c <= 86 {
        << c - 55
    }
    << -1
}

fn encode_alphabet(s string, chars &string, pad int) string {
    $b := []int{}
    n := s.len
    $i := 0
    while i < n {
        $c0 := 0
        $c1 := 0
        $c2 := 0
        $c3 := 0
        $c4 := 0
        $remain := n - i
        c0 = s[i] & 255
        if remain > 1 {
            c1 = s[i + 1] & 255
        }
        if remain > 2 {
            c2 = s[i + 2] & 255
        }
        if remain > 3 {
            c3 = s[i + 3] & 255
        }
        if remain > 4 {
            c4 = s[i + 4] & 255
        }
        b.push(chars[(c0 >> 3) & 31])
        b.push(chars[((c0 & 7) << 2) | ((c1 >> 6) & 3)])
        if remain < 2 {
            if pad != 0 {
                b.push(61)
                b.push(61)
                b.push(61)
                b.push(61)
                b.push(61)
                b.push(61)
            }
            i = n
        } else {
            b.push(chars[(c1 >> 1) & 31])
            b.push(chars[((c1 & 1) << 4) | ((c2 >> 4) & 15)])
            if remain < 3 {
                if pad != 0 {
                    b.push(61)
                    b.push(61)
                    b.push(61)
                    b.push(61)
                }
                i = n
            } else {
                b.push(chars[((c2 & 15) << 1) | ((c3 >> 7) & 1)])
                if remain < 4 {
                    if pad != 0 {
                        b.push(61)
                        b.push(61)
                        b.push(61)
                    }
                    i = n
                } else {
                    b.push(chars[(c3 >> 2) & 31])
                    b.push(chars[((c3 & 3) << 3) | ((c4 >> 5) & 7)])
                    if remain < 5 {
                        if pad != 0 {
                            b.push(61)
                        }
                        i = n
                    } else {
                        b.push(chars[c4 & 31])
                        i = i + 5
                    }
                }
            }
        }
    }
    << string_from_bytes(b)
}

fn decode_alphabet(s string, hex int) string {
    if s.len % 8 != 0 {
        >> errors.new("encoding/base32: invalid length")
    }
    $b := []int{}
    $i := 0
    while i < s.len {
        $v := []int{}
        $pad := 0
        $j := 0
        while j < 8 {
            c := s[i + j] & 255
            if c == 61 {
                pad = pad + 1
                v.push(0)
            } else {
                if pad > 0 {
                    >> errors.new("encoding/base32: invalid padding")
                }
                $x := -1
                if hex != 0 {
                    x = b32_hex_val(c)
                } else {
                    x = b32_val(c)
                }
                if x < 0 {
                    >> errors.new("encoding/base32: invalid character")
                }
                v.push(x)
            }
            j = j + 1
        }
        if pad != 0 && pad != 1 && pad != 3 && pad != 4 && pad != 6 {
            >> errors.new("encoding/base32: invalid padding")
        }
        b.push(((v[0] << 3) | (v[1] >> 2)) & 255)
        if pad < 6 {
            b.push(((v[1] << 6) | (v[2] << 1) | (v[3] >> 4)) & 255)
        }
        if pad < 4 {
            b.push(((v[3] << 4) | (v[4] >> 1)) & 255)
        }
        if pad < 3 {
            b.push(((v[4] << 7) | (v[5] << 2) | (v[6] >> 3)) & 255)
        }
        if pad < 1 {
            b.push(((v[6] << 5) | v[7]) & 255)
        }
        i = i + 8
    }
    << string_from_bytes(b)
}

fn pad_raw_input(s string) string {
    $i := 0
    while i < s.len {
        if (s[i] & 255) == 61 {
            >> errors.new("encoding/base32: invalid character")
        }
        i = i + 1
    }
    rem := s.len % 8
    if rem == 0 {
        << s + ""
    }
    if rem == 2 {
        << s + "======"
    }
    if rem == 4 {
        << s + "===="
    }
    if rem == 5 {
        << s + "==="
    }
    if rem == 7 {
        << s + "="
    }
    >> errors.new("encoding/base32: invalid length")
}

pub fn encode_to_string(s string) string {
    chars := B32_CHARS + ""
    << encode_alphabet(s, &chars, 1)
}

pub fn decode_string(s string) string {
    << decode_alphabet(s, 0)
}

pub fn encoded_len(n int) int {
    << ((n + 4) / 5) * 8
}

pub fn decoded_len(n int) int {
    << (n / 8) * 5
}

pub fn hex_encode_to_string(s string) string {
    chars := B32_HEX_CHARS + ""
    << encode_alphabet(s, &chars, 1)
}

pub fn hex_decode_string(s string) string {
    << decode_alphabet(s, 1)
}

pub fn hex_encoded_len(n int) int {
    << encoded_len(n)
}

pub fn hex_decoded_len(n int) int {
    << decoded_len(n)
}

pub fn raw_encode_to_string(s string) string {
    chars := B32_CHARS + ""
    << encode_alphabet(s, &chars, 0)
}

pub fn raw_decode_string(s string) string {
    padded := pad_raw_input(s)
    << decode_alphabet(padded, 0)
}

pub fn raw_hex_encode_to_string(s string) string {
    chars := B32_HEX_CHARS + ""
    << encode_alphabet(s, &chars, 0)
}

pub fn raw_hex_decode_string(s string) string {
    padded := pad_raw_input(s)
    << decode_alphabet(padded, 1)
}

// Go Encoding.EncodedLen with NoPadding.
pub fn raw_encoded_len(n int) int {
    if n <= 0 {
        << 0
    }
    << (n / 5) * 8 + (((n % 5) * 8) + 4) / 5
}

// Go Encoding.DecodedLen with NoPadding.
pub fn raw_decoded_len(n int) int {
    if n <= 0 {
        << 0
    }
    << (n / 8) * 5 + ((n % 8) * 5) / 8
}
