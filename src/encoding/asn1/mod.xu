@encoding/asn1


#errors
// DER subset aligned with Go `encoding/asn1` Marshal/Unmarshal of
// primitive values. No reflect: a Value is one TLV (tag + content);
// SEQUENCE is walked with Decoder.next. INTEGER fits i64.
// as_octet / as_utf8 / as_null / as_bit_string match the marshal_* tags.

pub const CLASS_UNIVERSAL = 0
pub const CLASS_CONTEXT = 2
pub const TAG_BOOLEAN = 1
pub const TAG_INTEGER = 2
pub const TAG_BIT_STRING = 3
pub const TAG_OCTET_STRING = 4
pub const TAG_NULL = 5
pub const TAG_OID = 6
pub const TAG_UTF8_STRING = 12
pub const TAG_SEQUENCE = 16
pub const TAG_SET = 17
pub const TAG_PRINTABLE_STRING = 19
pub const TAG_IA5_STRING = 22
pub const TAG_UTC_TIME = 23
pub const TAG_GENERALIZED_TIME = 24

pub struct Value {
    pub class int
    pub constructed int
    pub tag int
    pub bytes string
    pub rest string
}

pub struct Decoder {
    pub data string
    pub pos int
}

pub fn new_decoder(data &string) Decoder {
    << Decoder{data: data + "", pos: 0}
}

fn tlv(tag int, constructed int, content &string) string {
    mut b := []int{}
    mut t := tag & 31
    if constructed != 0 {
        t = t | 32
    }
    b.push(t)
    n := content.len
    if n < 128 {
        b.push(n)
    } else {
        mut tmp := []int{}
        mut x := n
        while x > 0 {
            tmp.push(x & 255)
            x = x / 256
        }
        b.push(128 + tmp.len)
        mut i := tmp.len
        while i > 0 {
            i = i - 1
            b.push(tmp[i])
        }
    }
    for i in 0:content.len {
        b.push(content[i] & 255)
    }
    << string_from_bytes(b)
}

pub fn marshal_bool(v bool) string {
    mut c := 0
    if v {
        c = 255
    }
    body := string_from_byte(c)
    << tlv(TAG_BOOLEAN, 0, &body)
}

pub fn marshal_null() string {
    empty := ""
    << tlv(TAG_NULL, 0, &empty)
}

pub fn marshal_octet(s &string) string {
    << tlv(TAG_OCTET_STRING, 0, s)
}

pub fn marshal_utf8(s &string) string {
    << tlv(TAG_UTF8_STRING, 0, s)
}

pub fn marshal_bit_string(s &string) string {
    mut b := []int{}
    b.push(0)
    for i in 0:s.len {
        b.push(s[i] & 255)
    }
    body := string_from_bytes(b)
    << tlv(TAG_BIT_STRING, 0, &body)
}

fn reverse_bytes(b &[]int) string {
    mut out := []int{}
    mut i := b.len
    while i > 0 {
        i = i - 1
        out.push(b[i] & 255)
    }
    << string_from_bytes(out)
}

pub fn marshal_int(n int) string {
    mut bytes := []int{}
    if n >= 0 {
        mut x := n
        if x == 0 {
            bytes.push(0)
        }
        while x > 0 {
            bytes.push(x & 255)
            x = x / 256
        }
        if (bytes[bytes.len - 1] & 128) != 0 {
            bytes.push(0)
        }
    } else {
        mut x := n
        for round in 0:16 {
            bytes.push(x & 255)
            x = x >> 8
            if x == 0 - 1 && (bytes[bytes.len - 1] & 128) != 0 {
                <-
            }
        }
    }
    body := reverse_bytes(&bytes)
    << tlv(TAG_INTEGER, 0, &body)
}

fn base128(n int) []int {
    mut digits := []int{}
    mut x := n
    digits.push(x & 127)
    x = x / 128
    while x > 0 {
        digits.push(x & 127)
        x = x / 128
    }
    mut out := []int{}
    mut i := digits.len
    while i > 0 {
        i = i - 1
        mut v := digits[i]
        if i > 0 {
            v = v | 128
        }
        out.push(v)
    }
    << out
}

pub fn marshal_oid(arcs &[]int) string {
    if arcs.len < 2 {
        >> errors.new("asn1: invalid object identifier")
    }
    a0 := arcs[0]
    a1 := arcs[1]
    if a0 > 2 {
        >> errors.new("asn1: invalid object identifier")
    }
    if a0 < 2 {
        if a1 > 39 {
            >> errors.new("asn1: invalid object identifier")
        }
    }
    mut b := []int{}
    first := a0 * 40 + a1
    fb := base128(first)
    for i in 0:fb.len {
        b.push(fb[i])
    }
    mut i := 2
    while i < arcs.len {
        extra := base128(arcs[i])
        for j in 0:extra.len {
            b.push(extra[j])
        }
        i = i + 1
    }
    body := string_from_bytes(b)
    << tlv(TAG_OID, 0, &body)
}

pub fn marshal_seq(elems &[]string) string {
    // Byte-accumulate: `body = body + elem` type-asserted under SM2 sign
    // with binary DER elements.
    mut acc := []int{}
    for i in 0:elems.len {
        e := elems[i] + ""
        mut j := 0
        while j < e.len {
            acc.push(e[j] & 255)
            j = j + 1
        }
    }
    body := string_from_bytes(acc)
    << tlv(TAG_SEQUENCE, 1, &body)
}

fn parse_tlv(src &string, off int) Value {
    data := src + ""
    if off >= data.len {
        >> errors.new("EOF")
    }
    b0 := data[off] & 255
    mut p := off + 1
    class := (b0 >> 6) & 3
    mut constructed := 0
    if (b0 & 32) != 0 {
        constructed = 1
    }
    mut tag := b0 & 31
    if tag == 31 {
        >> errors.new("asn1: high tag not supported")
    }
    if p >= data.len {
        >> errors.new("asn1: truncated tag or length")
    }
    lb := data[p] & 255
    p = p + 1
    mut length := 0
    if (lb & 128) == 0 {
        length = lb
    } else {
        num := lb & 127
        if num == 0 {
            >> errors.new("asn1: indefinite length found (not DER)")
        }
        if p + num > data.len {
            >> errors.new("asn1: truncated tag or length")
        }
        for i in 0:num {
            length = length * 256 + (data[p] & 255)
            p = p + 1
        }
        if length < 128 {
            >> errors.new("asn1: non-minimal length")
        }
    }
    if p + length > data.len {
        >> errors.new("asn1: truncated content")
    }
    mut content := ""
    if length > 0 {
        content = data[p:(p + length)] + ""
    }
    rest := data[(p + length):data.len] + ""
    << Value{class: class, constructed: constructed, tag: tag, bytes: content, rest: rest}
}

pub fn unmarshal(data &string) Value {
    src := data + ""
    << parse_tlv(&src, 0) or >>
}

pub fn parse_at(data &string, off int) Value {
    src := data + ""
    << parse_tlv(&src, off) or >>
}

pub fn (d Decoder) done() bool {
    << d.pos >= d.data.len
}

pub fn (v Value) as_bit_string() string {
    if v.tag != TAG_BIT_STRING || v.bytes.len == 0 {
        >> errors.new("asn1: invalid bit string")
    }
    unused := v.bytes[0] & 255
    if unused > 7 {
        >> errors.new("asn1: invalid bit string")
    }
    if v.bytes.len == 1 {
        << ""
    }
    << v.bytes[1:v.bytes.len]
}

pub fn (d &mut Decoder) next() Value {
    src := d.data + ""
    if d.pos >= src.len {
        >> errors.new("EOF")
    }
    vr := parse_tlv(&src, d.pos)
        v := vr
    used := src.len - v.rest.len
    d.pos = used
    << v
}

pub fn (v Value) as_bool() bool {
    if v.tag != TAG_BOOLEAN || v.bytes.len != 1 {
        >> errors.new("asn1: invalid boolean")
    }
    b := v.bytes[0] & 255
    if b == 0 {
        << false
    }
    if b == 255 {
        << true
    }
    >> errors.new("asn1: invalid boolean")
}

pub fn (v Value) as_int() int {
    if v.tag != TAG_INTEGER || v.bytes.len == 0 || v.bytes.len > 8 {
        >> errors.new("asn1: invalid integer")
    }
    mut x := 0
    if (v.bytes[0] & 128) != 0 {
        x = 0 - 1
    }
    for i in 0:v.bytes.len {
        x = (x * 256) + (v.bytes[i] & 255)
    }
    << x
}

pub fn (v Value) as_octet() string {
    if v.tag != TAG_OCTET_STRING {
        >> errors.new("asn1: invalid octet string")
    }
    << v.bytes + ""
}

pub fn (v Value) as_utf8() string {
    if v.tag != TAG_UTF8_STRING {
        >> errors.new("asn1: invalid utf8 string")
    }
    << v.bytes + ""
}

pub fn (v Value) as_null() bool {
    if v.tag != TAG_NULL || v.bytes.len != 0 {
        >> errors.new("asn1: invalid null")
    }
    << true
}

pub fn (v Value) as_oid() []int {
    if v.tag != TAG_OID || v.bytes.len == 0 {
        >> errors.new("asn1: invalid object identifier")
    }
    src := v.bytes + ""
    mut arcs := []int{}
    mut i := 0
    mut acc := 0
    mut first := 1
    while i < src.len {
        b := src[i] & 255
        acc = acc * 128 + (b & 127)
        if (b & 128) == 0 {
            if first == 1 {
                mut a0 := acc / 40
                mut a1 := acc - a0 * 40
                if a0 > 2 {
                    a1 = acc - 80
                    a0 = 2
                }
                arcs.push(a0)
                arcs.push(a1)
                first = 0
            } else {
                arcs.push(acc)
            }
            acc = 0
        }
        i = i + 1
    }
    << arcs
}
