@encoding/binary

#errors
#math

// Tight byte arrays; existing []int integer interfaces keep their contract.
// Integer reads return the bit pattern in int (u64 may be negative). Writes
// use the low width bits, as the existing Endian integer methods do.
fn (e Endian) get_bytes(data &[]u8, off int, width int) int {
    if !has_room(data.len, off, width) { >> errors.new("encoding/binary: out of bounds") }
    $value := 0
    for i in 0:width {
        $shift := i * 8
        if !e.little { shift = (width - 1 - i) * 8 }
        value = value | (int(data[off + i]) << shift)
    }
    << value
}
fn (e Endian) put_bytes(data $&[]u8, off int, value int, width int) int {
    // Validate the entire region before the first write, including huge offsets.
    if !has_room(data.len, off, width) { >> errors.new("encoding/binary: out of bounds") }
    for i in 0:width {
        $shift := i * 8
        if !e.little { shift = (width - 1 - i) * 8 }
        data[off + i] = u8((value >> shift) & 255)
    }
    << width
}
pub fn (e Endian) get_u16_bytes(data &[]u8, off int) int { << e.get_bytes(data, off, 2) or >> }
pub fn (e Endian) get_u32_bytes(data &[]u8, off int) int { << e.get_bytes(data, off, 4) or >> }
pub fn (e Endian) get_u64_bytes(data &[]u8, off int) int { << e.get_bytes(data, off, 8) or >> }
pub fn (e Endian) put_u16_bytes(data $&[]u8, off int, value int) int { << e.put_bytes(data, off, value, 2) or >> }
pub fn (e Endian) put_u32_bytes(data $&[]u8, off int, value int) int { << e.put_bytes(data, off, value, 4) or >> }
pub fn (e Endian) put_u64_bytes(data $&[]u8, off int, value int) int { << e.put_bytes(data, off, value, 8) or >> }
pub fn (e Endian) get_i16_bytes(data &[]u8, off int) int {
    value := e.get_u16_bytes(data, off) or >>
    << sign_extend(value, 16)
}
pub fn (e Endian) get_i32_bytes(data &[]u8, off int) int {
    value := e.get_u32_bytes(data, off) or >>
    << sign_extend(value, 32)
}
pub fn (e Endian) get_i64_bytes(data &[]u8, off int) int { << e.get_u64_bytes(data, off) or >> }
pub fn (e Endian) put_i16_bytes(data $&[]u8, off int, value int) int { << e.put_u16_bytes(data, off, value) or >> }
pub fn (e Endian) put_i32_bytes(data $&[]u8, off int, value int) int { << e.put_u32_bytes(data, off, value) or >> }
pub fn (e Endian) put_i64_bytes(data $&[]u8, off int, value int) int { << e.put_u64_bytes(data, off, value) or >> }

// Float interfaces operate on tight []u8. Binary32 is rounded from / expanded
// to Xu f64; binary64 preserves every bit, including signed zero and NaNs.
pub fn (e Endian) get_f32(data &[]u8, off int) f64 {
    bits := e.get_u32_bytes(data, off) or >>
    << math.float32_from_bits(bits)
}
pub fn (e Endian) get_f64(data &[]u8, off int) f64 {
    bits := e.get_u64_bytes(data, off) or >>
    << math.float64_from_bits(bits)
}
pub fn (e Endian) put_f32(data $&[]u8, off int, value f64) int {
    << e.put_u32_bytes(data, off, math.float32_bits(value)) or >>
}
pub fn (e Endian) put_f64(data $&[]u8, off int, value f64) int {
    << e.put_u64_bytes(data, off, math.float64_bits(value)) or >>
}
