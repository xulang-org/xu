@encoding/binary


#errors
// Go `encoding/binary` (little_endian / big_endian Endian values with
// get_u16/32/64 and put_u16/32/64). Go models the byte orders as empty
// structs with methods; Xu has no methods on enums — the checker rejects
// any non-struct receiver ("method receiver must be a struct"), so Endian
// is a struct carrying a single `little bool` (behavior-identical, no
// enum is used). get_* assemble from a shared borrow `&[]int` after a
// full bounds check (Err, never a partial read); put_* write through an
// exclusive borrow `$&[]int` and validate the whole range before the
// first store (Err, never a partial write). All byte assembly/disassembly
// goes through masks (`& 0xFF`, `<< 8`, `>> 56`), so u64 bit patterns
// round-trip through i64 with no arithmetic-overflow path (put/get of the
// high bit are bit-exact via `& 0xFF` byte extraction).

pub struct Endian {
    pub little bool
}

pub fn little_endian() Endian {
    << Endian{little: true}
}

pub fn big_endian() Endian {
    << Endian{little: false}
}

fn has_room(n int, off int, need int) bool {
    if off < 0 || need < 0 {
        << false
    }
    if n < need {
        << false
    }
    << off <= n - need
}

pub fn (e Endian) get_u16(data &[]int, off int) int {
    if !has_room(data.len, off, 2) {
        >> errors.new("encoding/binary: out of bounds")
    }
    if e.little {
        << (data[off] & 255) | ((data[off + 1] & 255) << 8)
    }
    << ((data[off] & 255) << 8) | (data[off + 1] & 255)
}

pub fn (e Endian) get_u32(data &[]int, off int) int {
    if !has_room(data.len, off, 4) {
        >> errors.new("encoding/binary: out of bounds")
    }
    if e.little {
        << (data[off] & 255) | ((data[off + 1] & 255) << 8) |
            ((data[off + 2] & 255) << 16) | ((data[off + 3] & 255) << 24)
    }
    << ((data[off] & 255) << 24) | ((data[off + 1] & 255) << 16) |
        ((data[off + 2] & 255) << 8) | (data[off + 3] & 255)
}

pub fn (e Endian) get_u64(data &[]int, off int) int {
    if !has_room(data.len, off, 8) {
        >> errors.new("encoding/binary: out of bounds")
    }
    if e.little {
        << (data[off] & 255) | ((data[off + 1] & 255) << 8) |
            ((data[off + 2] & 255) << 16) | ((data[off + 3] & 255) << 24) |
            ((data[off + 4] & 255) << 32) | ((data[off + 5] & 255) << 40) |
            ((data[off + 6] & 255) << 48) | ((data[off + 7] & 255) << 56)
    }
    << ((data[off] & 255) << 56) | ((data[off + 1] & 255) << 48) |
        ((data[off + 2] & 255) << 40) | ((data[off + 3] & 255) << 32) |
        ((data[off + 4] & 255) << 24) | ((data[off + 5] & 255) << 16) |
        ((data[off + 6] & 255) << 8) | (data[off + 7] & 255)
}

pub fn (e Endian) put_u16(data $&[]int, off int, v int) int {
    if !has_room(data.len, off, 2) {
        >> errors.new("encoding/binary: out of bounds")
    }
    if e.little {
        data[off] = v & 255
        data[off + 1] = (v >> 8) & 255
    } else {
        data[off] = (v >> 8) & 255
        data[off + 1] = v & 255
    }
    << 2
}

pub fn (e Endian) put_u32(data $&[]int, off int, v int) int {
    if !has_room(data.len, off, 4) {
        >> errors.new("encoding/binary: out of bounds")
    }
    if e.little {
        data[off] = v & 255
        data[off + 1] = (v >> 8) & 255
        data[off + 2] = (v >> 16) & 255
        data[off + 3] = (v >> 24) & 255
    } else {
        data[off] = (v >> 24) & 255
        data[off + 1] = (v >> 16) & 255
        data[off + 2] = (v >> 8) & 255
        data[off + 3] = v & 255
    }
    << 4
}

pub fn (e Endian) put_u64(data $&[]int, off int, v int) int {
    if !has_room(data.len, off, 8) {
        >> errors.new("encoding/binary: out of bounds")
    }
    if e.little {
        data[off] = v & 255
        data[off + 1] = (v >> 8) & 255
        data[off + 2] = (v >> 16) & 255
        data[off + 3] = (v >> 24) & 255
        data[off + 4] = (v >> 32) & 255
        data[off + 5] = (v >> 40) & 255
        data[off + 6] = (v >> 48) & 255
        data[off + 7] = (v >> 56) & 255
    } else {
        data[off] = (v >> 56) & 255
        data[off + 1] = (v >> 48) & 255
        data[off + 2] = (v >> 40) & 255
        data[off + 3] = (v >> 32) & 255
        data[off + 4] = (v >> 24) & 255
        data[off + 5] = (v >> 16) & 255
        data[off + 6] = (v >> 8) & 255
        data[off + 7] = v & 255
    }
    << 8
}

pub fn native_endian() Endian {
    << little_endian()
}

fn sign_extend(v int, bits int) int {
    shift := 64 - bits
    << (v << shift) >> shift
}

pub fn (e Endian) get_i16(data &[]int, off int) int {
    u := e.get_u16(data, off)
    << sign_extend(u, 16)
}

pub fn (e Endian) get_i32(data &[]int, off int) int {
    u := e.get_u32(data, off)
    << sign_extend(u, 32)
}

pub fn (e Endian) get_i64(data &[]int, off int) int {
    << e.get_u64(data, off)
}

pub fn (e Endian) put_i16(data $&[]int, off int, v int) int {
    << e.put_u16(data, off, v)
}

pub fn (e Endian) put_i32(data $&[]int, off int, v int) int {
    << e.put_u32(data, off, v)
}

pub fn (e Endian) put_i64(data $&[]int, off int, v int) int {
    << e.put_u64(data, off, v)
}

fn uvarint_shr7(n int) int {
    if n >= 0 {
        << n >> 7
    }
    << (n >> 7) & 144115188075855871
}

pub fn put_uvarint(x int) string {
    $n := x
    $b := []int{}
    $i := 0
    while i < 10 {
        if n >= 0 && n < 128 {
            b.push(n & 127)
            << string_from_bytes(b)
        }
        b.push((n & 127) | 128)
        n = uvarint_shr7(n)
        i = i + 1
    }
    b.push(n & 127)
    << string_from_bytes(b)
}

pub fn size_uvarint(x int) int {
    $n := x
    $i := 1
    while !(n >= 0 && n < 128) {
        n = uvarint_shr7(n)
        i = i + 1
        if i >= 10 {
            << 10
        }
    }
    << i
}

pub fn uvarint(s &string) int {
    $x := 0
    $sft := 0
    for i in 0:s.len {
        b := s[i] & 255
        if b < 128 {
            if sft > 63 {
                >> errors.new("encoding/binary: overflow")
            }
            if sft == 63 && b > 1 {
                >> errors.new("encoding/binary: overflow")
            }
            << x | (b << sft)
        }
        if sft >= 63 {
            >> errors.new("encoding/binary: overflow")
        }
        x = x | ((b & 127) << sft)
        sft = sft + 7
    }
    >> errors.new("encoding/binary: truncated uvarint")
}

fn zigzag(x int) int {
    $ux := x << 1
    if x < 0 {
        ux = ux ^ (0 - 1)
    }
    << ux
}

pub fn put_varint(x int) string {
    << put_uvarint(zigzag(x))
}

pub fn varint(s &string) int {
    ux := uvarint(s) or >>
    $x := (ux >> 1) & 9223372036854775807
    if (ux & 1) != 0 {
        x = x ^ (0 - 1)
    }
    << x
}

pub fn size_varint(x int) int {
    << size_uvarint(zigzag(x))
}

pub fn append_uvarint(dst string, x int) string {
    << dst + put_uvarint(x)
}

pub fn append_varint(dst string, x int) string {
    << dst + put_varint(x)
}
