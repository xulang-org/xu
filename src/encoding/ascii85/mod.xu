@encoding/ascii85


#errors
// Ascii85 (btoa / Adobe) aligned with Go `encoding/ascii85` Encode/Decode.
// encode_to_string / decode_string operate on owning strings. `z` encodes
// four zero bytes. Whitespace in decode is skipped. `<~`/`~>` wrappers
// are not added or required (same as Go Encode/Decode).

const U32_MAX = 4294967295
const BANG = 33

pub fn max_encoded_len(n int) int {
    << ((n + 3) / 4) * 5
}

pub fn encode_to_string(src &string) string {
    s := src + ""
    $out := []int{}
    $i := 0
    while i < s.len {
        $n := s.len - i
        if n > 4 {
            n = 4
        }
        $v := 0
        for j in 0:4 {
            $b := 0
            if j < n {
                b = s[i + j] & 255
            }
            v = (v * 256) + b
        }
        if n == 4 && v == 0 {
            out.push(122)
        } else {
            $d4 := BANG + (v % 85)
            v = v / 85
            $d3 := BANG + (v % 85)
            v = v / 85
            $d2 := BANG + (v % 85)
            v = v / 85
            $d1 := BANG + (v % 85)
            v = v / 85
            $d0 := BANG + (v % 85)
            out.push(d0)
            out.push(d1)
            if n >= 2 {
                out.push(d2)
            }
            if n >= 3 {
                out.push(d3)
            }
            if n >= 4 {
                out.push(d4)
            }
        }
        i = i + n
    }
    << string_from_bytes(out)
}

pub fn decode_string(src &string) string {
    s := src + ""
    $out := []int{}
    $v := 0
    $nb := 0
    for i in 0:s.len {
        b := s[i] & 255
        if b <= 32 {
        } else if b == 122 && nb == 0 {
            out.push(0)
            out.push(0)
            out.push(0)
            out.push(0)
        } else if b >= 33 && b <= 117 {
            v = ((v * 85) + (b - BANG)) & U32_MAX
            nb = nb + 1
            if nb == 5 {
                out.push((v >> 24) & 255)
                out.push((v >> 16) & 255)
                out.push((v >> 8) & 255)
                out.push(v & 255)
                nb = 0
                v = 0
            }
        } else {
            >> errors.new("ascii85: corrupt input")
        }
    }
    if nb == 1 {
        >> errors.new("ascii85: corrupt input")
    }
    if nb > 0 {
        $vv := v
        $k := nb
        while k < 5 {
            vv = ((vv * 85) + 84) & U32_MAX
            k = k + 1
        }
        $t := 0
        while t < nb - 1 {
            out.push((vv >> 24) & 255)
            vv = (vv << 8) & U32_MAX
            t = t + 1
        }
    }
    << string_from_bytes(out)
}
