@encoding/json

#errors

// Re-emit one parsed subtree with the same escaping and number spelling as
// to_json(), so consumers can retain complete nested response values.
pub fn (d Doc) encode(n int) string {
    if d.err.len > 0 || n < 0 || n >= d.kinds.len {
        >> errors.new("json: cannot encode invalid document node")
    }
    << d.emit_node(n)
}
