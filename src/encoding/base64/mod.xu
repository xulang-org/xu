@encoding/base64


#errors
// Base64 (standard alphabet, '=' padding) aligned with Go
// `encoding/base64` (StdEncoding.EncodeToString / DecodeString).
// Decode rejects bad length or non-alphabet bytes with Err — never a
// partial buffer.

const b64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// Read-only byte map: ASCII space is invalid; values 33..96 encode 0..63.
// Static strings avoid a mutable global or a table allocation per decode.
const b64_decode_map = "                                           _   `UVWXYZ[\\]^       !\"#$%&'()*+,-./0123456789:      ;<=>?@ABCDEFGHIJKLMNOPQRST                                                                                                                                     "

// URL decoding retains the accepted standard alphabet aliases.
const b64_url_decode_map = "                                           _ _ `UVWXYZ[\\]^       !\"#$%&'()*+,-./0123456789:    ` ;<=>?@ABCDEFGHIJKLMNOPQRST                                                                                                                                     "

fn base64_hw_supported() int {
    << 0
}

fn base64_hw_encode(src &string, dst &string, is_url int) int {
    << 0
}

pub fn encode_to_string(s string) string {
    << encode_with(&s, false, true)
}

fn strip_b64_ws(s &string) string {
    mut out := ""
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c != 10 && c != 13 {
            out.push_byte(c)
        }
        i += 1
    }
    << out
}

fn b64_has_ws(s &string) bool {
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c == 10 || c == 13 {
            << true
        }
        i += 1
    }
    << false
}

pub fn decode_string(s string) string {
    << decode_with(&s, false) or >>
}

fn decode_with(s &string, is_url bool) string {
    decoded := decode_clean(s, is_url) or (err) {
        // Retry only after an error, preserving CR/LF and error priority.
        if b64_has_ws(s) {
            clean := strip_b64_ws(s)
            << decode_clean(&clean, is_url) or >>
        }
        >> err
    }
    << decoded
}

fn decode_clean(src &string, is_url bool) string {
    mut alphabet := b64_decode_map
    if is_url { alphabet = b64_url_decode_map }
    if src.len % 4 != 0 { >> errors.new("encoding/base64: invalid length") }
    nblocks := src.len / 4
    if nblocks <= 0 { << "" }
    capn := decoded_len(src.len)
    if capn / 3 != nblocks { >> errors.new("encoding/base64: length overflow") }
    mut b := make_string(capn)
    fullblocks := nblocks - 1
    mut i := 0
    mut bad := 0
    // Whole blocks use one bounded byte lookup table and affine input/output
    // indexes. Keep errors out of the valid-input hot loop; the original
    // decoder below preserves the first error and padding priority.
    while i < fullblocks {
        off := i * 4
        w := i * 3
        a := alphabet[src[off] & 255] - 33
        d := alphabet[src[off + 1] & 255] - 33
        e := alphabet[src[off + 2] & 255] - 33
        f := alphabet[src[off + 3] & 255] - 33
        bad = bad | a | d | e | f
        b[w] = (a << 2) | (d >> 4)
        b[w + 1] = ((d & 15) << 4) | (e >> 2)
        b[w + 2] = ((e & 3) << 6) | f
        i += 1
    }
    if bad < 0 { << decode_clean_checked(src, is_url) or >> }
    mut w := i * 3
    off := i * 4
    a := alphabet[src[off] & 255] - 33
    d := alphabet[src[off + 1] & 255] - 33
    if (a | d) < 0 { >> errors.new("encoding/base64: invalid character") }
    b[w] = (a << 2) | (d >> 4)
    w += 1
    c2 := src[off + 2] & 255
    c3 := src[off + 3] & 255
    if c2 == 61 {
        if c3 != 61 { >> errors.new("encoding/base64: invalid padding") }
    } else {
        e := alphabet[c2] - 33
        if e < 0 { >> errors.new("encoding/base64: invalid character") }
        b[w] = ((d & 15) << 4) | (e >> 2)
        w += 1
        if c3 != 61 {
            f := alphabet[c3] - 33
            if f < 0 { >> errors.new("encoding/base64: invalid character") }
            b[w] = ((e & 3) << 6) | f
            w += 1
        }
    }
    if w == b.len { << b }
    << b[0:w]
}

fn decode_clean_checked(src &string, is_url bool) string {
    mut alphabet := b64_decode_map
    if is_url { alphabet = b64_url_decode_map }
    if src.len % 4 != 0 { >> errors.new("encoding/base64: invalid length") }
    nblocks := src.len / 4
    if nblocks <= 0 { << "" }
    capn := decoded_len(src.len)
    if capn / 3 != nblocks { >> errors.new("encoding/base64: length overflow") }
    mut b := make_string(capn)
    mut i := 0
    mut w := 0
    // Padding is only valid in the final block. Preserve its error priority
    // over bad leading characters in every earlier block.
    while i < nblocks - 1 {
        off := i * 4
        c2 := src[off + 2] & 255
        c3 := src[off + 3] & 255
        if c2 == 61 || c3 == 61 { >> errors.new("encoding/base64: invalid padding") }
        a := alphabet[src[off] & 255] - 33
        d := alphabet[src[off + 1] & 255] - 33
        e := alphabet[c2] - 33
        f := alphabet[c3] - 33
        if (a | d | e | f) < 0 { >> errors.new("encoding/base64: invalid character") }
        b[w] = (a << 2) | (d >> 4)
        b[w + 1] = ((d & 15) << 4) | (e >> 2)
        b[w + 2] = ((e & 3) << 6) | f
        w += 3
        i += 1
    }
    off := i * 4
    a := alphabet[src[off] & 255] - 33
    d := alphabet[src[off + 1] & 255] - 33
    if (a | d) < 0 { >> errors.new("encoding/base64: invalid character") }
    b[w] = (a << 2) | (d >> 4)
    w += 1
    c2 := src[off + 2] & 255
    c3 := src[off + 3] & 255
    if c2 == 61 {
        if c3 != 61 { >> errors.new("encoding/base64: invalid padding") }
    } else {
        e := alphabet[c2] - 33
        if e < 0 { >> errors.new("encoding/base64: invalid character") }
        b[w] = ((d & 15) << 4) | (e >> 2)
        w += 1
        if c3 != 61 {
            f := alphabet[c3] - 33
            if f < 0 { >> errors.new("encoding/base64: invalid character") }
            b[w] = ((e & 3) << 6) | f
            w += 1
        }
    }
    if w == b.len { << b }
    << b[0:w]
}

const b64_url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn encode_with(s &string, is_url bool, pad bool) string {
    n := s.len
    if n <= 0 { << "" }
    capn := encoded_len(n, pad)
    if capn <= 0 {
        mut overflow := make_string(-1)
        if overflow.len < 0 { << "" }
        << ""
    }
    mut alphabet := b64_chars
    if is_url { alphabet = b64_url }
    mut b := make_string(capn)
    mut i := 0
    mut w := 0
    if base64_hw_supported() == 1 && n >= 48 {
        mut u := 0
        if is_url { u = 1 }
        processed := base64_hw_encode(s, &b, u)
        i = processed
        w = (processed / 3) * 4
    }
    if n - i >= 3 {
        rem_blocks := (n - i) / 3
        mut k := 0
        while k < rem_blocks {
            off := i + k * 3
            v := ((s[off] & 255) << 16) | ((s[off + 1] & 255) << 8) | (s[off + 2] & 255)
            wo := w + k * 4
            b[wo] = alphabet[(v >> 18) & 63]
            b[wo + 1] = alphabet[(v >> 12) & 63]
            b[wo + 2] = alphabet[(v >> 6) & 63]
            b[wo + 3] = alphabet[v & 63]
            k += 1
        }
        i += rem_blocks * 3
        w += rem_blocks * 4
    }
    if i < n {
        a := s[i] & 255
        b[w] = alphabet[a >> 2]
        if i + 1 < n {
            d := s[i + 1] & 255
            b[w + 1] = alphabet[((a & 3) << 4) | (d >> 4)]
            b[w + 2] = alphabet[(d & 15) << 2]
            if pad { b[w + 3] = 61 }
        } else {
            b[w + 1] = alphabet[(a & 3) << 4]
            if pad {
                b[w + 2] = 61
                b[w + 3] = 61
            }
        }
    }
    << b
}

pub fn encode_url(s string) string {
    << encode_with(&s, true, true)
}

pub fn encode_raw(s string) string {
    << encode_with(&s, false, false)
}

pub fn encode_raw_url(s string) string {
    << encode_with(&s, true, false)
}

pub fn encoded_len(n int, pad bool) int {
    if n <= 0 {
        << 0
    }
    if pad {
        << ((n + 2) / 3) * 4
    }
    << (n * 4 + 2) / 3
}

pub fn decoded_len(n int) int {
    << (n / 4) * 3
}

// Padding is determined before CR/LF stripping, as in the public API's
// original behavior. Whole blocks borrow the input without normalization.
fn decode_padded(s &string, is_url bool) string {
    rem := s.len % 4
    if rem == 1 { >> errors.new("encoding/base64: invalid length") }
    if rem == 2 {
        padded := s + "=="
        << decode_with(&padded, is_url) or >>
    }
    if rem == 3 {
        padded := s + "="
        << decode_with(&padded, is_url) or >>
    }
    << decode_with(s, is_url) or >>
}

pub fn decode_url(s string) string {
    << decode_padded(&s, true) or >>
}

pub fn decode_raw_url(s string) string {
    << decode_padded(&s, true) or >>
}

pub fn decode_raw(s string) string {
    << decode_padded(&s, false) or >>
}
