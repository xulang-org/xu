@encoding/xun

fn (d &mut Doc) validate_tag(no int, tag string, text string) {
    if tag == "s" || tag.len == 0 {
        <<
    }
    if tag == "b" {
        if text == "true" || text == "false" {
            <<
        }
        d.fail(no, "!b allows only true or false")
        <<
    }
    if tag == "i" {
        if !valid_int(&text) {
            d.fail(no, "invalid !i integer")
        }
        <<
    }
    if tag == "n" {
        if looks_float(&text) {
            if !valid_float(&text) {
                d.fail(no, "invalid !n number")
            }
            <<
        }
        if !valid_int(&text) {
            d.fail(no, "invalid !n number")
        }
        <<
    }
    if tag == "f" {
        if !valid_float(&text) {
            d.fail(no, "invalid !f float")
        }
        <<
    }
    if tag == "x" {
        if !valid_hex_int(&text) {
            d.fail(no, "invalid !x hex integer")
        }
        <<
    }
    if tag == "xb" {
        if !valid_hex_bytes(&text) {
            d.fail(no, "invalid !xb hex bytes")
        }
        <<
    }
    if tag == "o" {
        if !valid_octal(&text) {
            d.fail(no, "invalid !o octal")
        }
        <<
    }
    if tag == "d" {
        if !valid_date(&text) {
            d.fail(no, "invalid !d date")
        }
        <<
    }
    if tag == "t" {
        if !valid_time(&text) {
            d.fail(no, "invalid !t time")
        }
        <<
    }
    if tag == "dt" {
        if !valid_datetime(&text) {
            d.fail(no, "invalid !dt datetime")
        }
        <<
    }
    if tag == "tz" {
        if !valid_tz(&text) {
            d.fail(no, "invalid !tz timezone")
        }
        <<
    }
    if tag == "du" {
        if !valid_duration(&text) {
            d.fail(no, "invalid !du duration")
        }
        <<
    }
    if tag == "sz" {
        if !valid_data_size(&text) {
            d.fail(no, "invalid !sz data size")
        }
        <<
    }
    if tag == "unix" {
        if !valid_unix(&text) {
            d.fail(no, "invalid !unix timestamp")
        }
        <<
    }
    if tag == "ver" {
        if !valid_ver(&text) {
            d.fail(no, "invalid !ver")
        }
        <<
    }
    if tag == "uuid" {
        if !valid_uuid(&text) {
            d.fail(no, "invalid !uuid")
        }
        <<
    }
    if tag == "ip" {
        if !valid_ip(&text) {
            d.fail(no, "invalid !ip")
        }
        <<
    }
    if tag == "b64" {
        if !valid_b64(&text) {
            d.fail(no, "invalid !b64 base64")
        }
        <<
    }
    if tag == "c" {
        if !valid_char(&text) {
            d.fail(no, "invalid !c character")
        }
        <<
    }
    // Custom tag: tag name must be a valid identifier
    if !valid_tag_name(&tag) {
        d.fail(no, "invalid type tag '!" + tag + "'")
    }
}

fn valid_tag_name(s &string) bool {
    if s.len == 0 {
        << false
    }
    for i in 0:s.len {
        b := s[i] & 255
        if !is_alphanumeric(b) {
            << false
        }
    }
    << true
}

fn looks_float(s &string) bool {
    for i in 0:s.len {
        b := s[i] & 255
        if b == 46 || b == 101 || b == 69 {
            << true
        }
    }
    << false
}

fn valid_int(s &string) bool {
    mut i := 0
    if s.len == 0 {
        << false
    }
    if (s[0] & 255) == 45 {
        i = 1
        if s.len == 1 {
            << false
        }
    }
    mut digits := ""
    while i < s.len {
        c := s[i] & 255
        if c == 95 {
            // underscore allowed
        } else {
            if !is_digit(c) {
                << false
            }
            digits = digits + s[i:i + 1]
        }
        i += 1
    }
    if digits.len == 0 {
        << false
    }
    if digits.len > 1 && (digits[0] & 255) == 48 {
        << false
    }
    << true
}

fn valid_float(s &string) bool {
    if s.len == 0 {
        << false
    }
    mut i := 0
    if (s[0] & 255) == 45 {
        i = 1
    }
    mut nd := 0
    mut dot := 0
    mut exp := 0
    while i < s.len {
        c := s[i] & 255
        if is_digit(c) {
            nd += 1
            i += 1
        } else {
            if c == 46 { // '.'
                if dot == 1 || exp == 1 {
                    << false
                }
                dot = 1
                i += 1
            } else {
                if (c == 101 || c == 69) && nd > 0 { // 'e' or 'E'
                    if exp == 1 {
                        << false
                    }
                    exp = 1
                    i += 1
                    if i < s.len {
                        c2 := s[i] & 255
                        if c2 == 43 || c2 == 45 {
                            i += 1
                        }
                    }
                } else {
                    << false
                }
            }
        }
    }
    << nd > 0
}

fn valid_hex_int(s &string) bool {
    t := strip_us(s)
    if t.len == 0 {
        << false
    }
    for i in 0:t.len {
        if !is_hex(t[i] & 255) {
            << false
        }
    }
    << true
}

fn valid_hex_bytes(s &string) bool {
    t := strip_us(s)
    if t.len == 0 || t.len % 2 != 0 {
        << false
    }
    for i in 0:t.len {
        if !is_hex(t[i] & 255) {
            << false
        }
    }
    << true
}

fn valid_octal(s &string) bool {
    if s.len == 0 {
        << false
    }
    for i in 0:s.len {
        c := s[i] & 255
        if c < 48 || c > 55 {
            << false
        }
    }
    << true
}

fn valid_ver(s &string) bool {
    if s.len == 0 {
        << false
    }
    mut n := 0
    mut i := 0
    while i < s.len {
        if (s[i] & 255) == 46 {
            if n == 0 {
                << false
            }
            n = 0
            i += 1
        } else {
            if !is_digit(s[i] & 255) {
                << false
            }
            n += 1
            i += 1
        }
    }
    << n > 0
}

fn all_digits(s &string) bool {
    if s.len == 0 {
        << false
    }
    for i in 0:s.len {
        if !is_digit(s[i] & 255) {
            << false
        }
    }
    << true
}

fn split_bytes(s &string, sep int) []string {
    mut out := []string{}
    mut start := 0
    for i in 0:s.len {
        if (s[i] & 255) == sep {
            out.push(s[start:i])
            start = i + 1
        }
    }
    out.push(s[start:s.len])
    << out
}

fn valid_date(s &string) bool {
    parts := split_bytes(s, 45) // '-'
    if parts.len != 3 {
        << false
    }
    if parts[0].len != 4 || !all_digits(&parts[0]) {
        << false
    }
    if parts[1].len != 2 || !all_digits(&parts[1]) {
        << false
    }
    if parts[2].len != 2 || !all_digits(&parts[2]) {
        << false
    }
    << true
}

fn valid_time(s &string) bool {
    parts := split_bytes(s, 58) // ':'
    if parts.len < 2 || parts.len > 3 {
        << false
    }
    if parts[0].len != 2 || !all_digits(&parts[0]) {
        << false
    }
    if parts[1].len != 2 || !all_digits(&parts[1]) {
        << false
    }
    if parts.len == 3 {
        sec := parts[2]
        dot_parts := split_bytes(&sec, 46) // '.'
        if dot_parts.len == 1 {
            if sec.len != 2 || !all_digits(&sec) {
                << false
            }
        } else {
            if dot_parts.len == 2 {
                if dot_parts[0].len != 2 || !all_digits(&dot_parts[0]) || !all_digits(&dot_parts[1]) {
                    << false
                }
            } else {
                << false
            }
        }
    }
    << true
}

fn valid_tz_offset(s &string) bool {
    if s.len != 6 {
        << false
    }
    b0 := s[0] & 255
    if b0 != 43 && b0 != 45 { // '+' or '-'
        << false
    }
    if !is_digit(s[1] & 255) || !is_digit(s[2] & 255) {
        << false
    }
    if (s[3] & 255) != 58 { // ':'
        << false
    }
    if !is_digit(s[4] & 255) || !is_digit(s[5] & 255) {
        << false
    }
    << true
}

fn valid_datetime(s &string) bool {
    parts := split_bytes(s, 84) // 'T'
    if parts.len != 2 {
        << false
    }
    if !valid_date(&parts[0]) {
        << false
    }
    rest := parts[1]
    if rest.len == 0 {
        << false
    }
    if (rest[rest.len - 1] & 255) == 90 { // ends with 'Z'
        t := rest[0:rest.len - 1]
        << valid_time(&t)
    }
    // Check timezone offset '+HH:MM' or '-HH:MM'
    if rest.len >= 6 {
        b := rest[rest.len - 6] & 255
        if b == 43 || b == 45 {
            t := rest[0:rest.len - 6]
            offset := rest[rest.len - 6:rest.len]
            << valid_time(&t) && valid_tz_offset(&offset)
        }
    }
    << false
}

fn valid_tz(s &string) bool {
    if *s == "Z" || *s == "UTC" || valid_tz_offset(s) {
        << true
    }
    parts := split_bytes(s, 47) // '/'
    if parts.len < 2 {
        << false
    }
    for p in parts {
        if p.len == 0 {
            << false
        }
        for i in 0:p.len {
            b := p[i] & 255
            if !is_alphanumeric(b) && b != 45 && b != 43 { // '-', '+'
                << false
            }
        }
    }
    << true
}

fn valid_duration(s &string) bool {
    if s.len == 0 {
        << false
    }
    mut i := 0
    mut matched := 0
    while i < s.len {
        start := i
        mut saw_dot := 0
        while i < s.len {
            b := s[i] & 255
            if is_digit(b) {
                i += 1
            } else {
                if b == 46 && saw_dot == 0 { // '.'
                    saw_dot = 1
                    i += 1
                } else {
                    ->
                }
            }
        }
        if i == start {
            << false
        }
        // Unit: ms, s, m, h, d
        if i + 1 < s.len && (s[i] & 255) == 109 && (s[i + 1] & 255) == 115 { // 'ms'
            i += 2
            matched += 1
        } else {
            if i < s.len {
                u := s[i] & 255
                if u == 115 || u == 109 || u == 104 || u == 100 { // 's', 'm', 'h', 'd'
                    i += 1
                    matched += 1
                } else {
                    << false
                }
            } else {
                << false
            }
        }
    }
    << matched > 0 && i == s.len
}

fn valid_data_size(s &string) bool {
    units := ["PiB", "TiB", "GiB", "MiB", "KiB", "PB", "TB", "GB", "MB", "KB", "B"]
    for u in units {
        if has_suffix(s, &u) {
            num := s[0:s.len - u.len]
            if num.len == 0 {
                << false
            }
            parts := split_bytes(&num, 46) // '.'
            if parts.len > 2 {
                << false
            }
            if !all_digits(&parts[0]) {
                << false
            }
            if parts.len == 2 && !all_digits(&parts[1]) {
                << false
            }
            << true
        }
    }
    << false
}

fn valid_unix(s &string) bool {
    src := strip_us(s)
    if src.len == 0 {
        << false
    }
    mut i := 0
    if (src[0] & 255) == 45 {
        i = 1
        if src.len == 1 {
            << false
        }
    }
    if src.len - i > 1 && (src[i] & 255) == 48 {
        << false
    }
    while i < src.len {
        if !is_digit(src[i] & 255) {
            << false
        }
        i += 1
    }
    << true
}

fn valid_uuid(s &string) bool {
    if s.len != 36 {
        << false
    }
    if (s[8] & 255) != 45 || (s[13] & 255) != 45 || (s[18] & 255) != 45 || (s[23] & 255) != 45 {
        << false
    }
    for i in 0:36 {
        if i != 8 && i != 13 && i != 18 && i != 23 {
            if !is_hex(s[i] & 255) {
                << false
            }
        }
    }
    << true
}

fn valid_ip(s &string) bool {
    // IPv4
    parts := split_bytes(s, 46) // '.'
    if parts.len == 4 {
        for p in parts {
            if p.len == 0 || p.len > 3 || !all_digits(&p) {
                << false
            }
            if p.len > 1 && (p[0] & 255) == 48 {
                << false
            }
            val := parse_int(p) or (err) {
                << false
            }
            if val < 0 || val > 255 {
                << false
            }
        }
        << true
    }
    // IPv6: contains ':'
    colon_parts := split_bytes(s, 58) // ':'
    if colon_parts.len >= 3 && colon_parts.len <= 8 {
        for p in colon_parts {
            if p.len > 4 {
                << false
            }
            for i in 0:p.len {
                if !is_hex(p[i] & 255) {
                    << false
                }
            }
        }
        << true
    }
    << false
}

fn valid_b64(s &string) bool {
    mut clean := ""
    for i in 0:s.len {
        b := s[i] & 255
        if b != 32 && b != 9 && b != 10 && b != 13 {
            clean = clean + s[i:i + 1]
        }
    }
    if clean.len == 0 || clean.len % 4 != 0 {
        << false
    }
    mut pad := 0
    for i in 0:clean.len {
        b := clean[i] & 255
        if b == 61 { // '='
            pad += 1
            if i < clean.len - 2 {
                << false
            }
        } else {
            if pad > 0 {
                << false
            }
            ok := is_alpha(b) || is_digit(b) || b == 43 || b == 47 // '+', '/'
            if !ok {
                << false
            }
        }
    }
    << pad <= 2
}

fn valid_char(s &string) bool {
    if has_prefix(s, "U+") || has_prefix(s, "u+") {
        rest := s[2:s.len]
        if rest.len < 4 || rest.len > 6 {
            << false
        }
        for i in 0:rest.len {
            if !is_hex(rest[i] & 255) {
                << false
            }
        }
        << true
    }
    if s.len == 0 {
        << false
    }
    // Single UTF-8 codepoint
    b0 := s[0] & 255
    mut expect_len := 1
    if (b0 & 128) == 0 {
        expect_len = 1
    } else {
        if (b0 & 224) == 192 {
            expect_len = 2
        } else {
            if (b0 & 240) == 224 {
                expect_len = 3
            } else {
                if (b0 & 248) == 240 {
                    expect_len = 4
                } else {
                    << false
                }
            }
        }
    }
    << s.len == expect_len
}
