@encoding/xun

fn (d $&Doc) validate_tag_span(no int, tlo int, thi int, xlo int, xhi int) {
    tlen := thi - tlo
    if tlen <= 0 {
        <<
    }
    c0 := d.buf[tlo] & 255
    if tlen == 1 {
        if c0 == 115 { // 's'
            <<
        }
        if c0 == 98 { // 'b'
            xlen := xhi - xlo
            if xlen == 4 && (d.buf[xlo] & 255) == 116 && (d.buf[xlo + 1] & 255) == 114 && (d.buf[xlo + 2] & 255) == 117 && (d.buf[xlo + 3] & 255) == 101 {
                <<
            }
            if xlen == 5 && (d.buf[xlo] & 255) == 102 && (d.buf[xlo + 1] & 255) == 97 && (d.buf[xlo + 2] & 255) == 108 && (d.buf[xlo + 3] & 255) == 115 && (d.buf[xlo + 4] & 255) == 101 {
                <<
            }
            d.fail(no, "!b allows only true or false")
            <<
        }
        if c0 == 105 { // 'i'
            if !valid_int_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !i integer")
            }
            <<
        }
        if c0 == 110 { // 'n'
            if looks_float_span(&d.buf, xlo, xhi) {
                if !valid_float_span(&d.buf, xlo, xhi) {
                    d.fail(no, "invalid !n number")
                }
                <<
            }
            if !valid_int_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !n number")
            }
            <<
        }
        if c0 == 102 { // 'f'
            if !valid_float_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !f float")
            }
            <<
        }
        if c0 == 120 { // 'x'
            if !valid_hex_int_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !x hex integer")
            }
            <<
        }
        if c0 == 111 { // 'o'
            if !valid_octal_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !o octal")
            }
            <<
        }
        if c0 == 100 { // 'd'
            if !valid_date_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !d date")
            }
            <<
        }
        if c0 == 116 { // 't'
            if !valid_time_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !t time")
            }
            <<
        }
        if c0 == 99 { // 'c'
            if !valid_char_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !c character")
            }
            <<
        }
    }
    if tlen == 2 {
        c1 := d.buf[tlo + 1] & 255
        if c0 == 120 && c1 == 98 { // "xb"
            if !valid_hex_bytes_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !xb hex bytes")
            }
            <<
        }
        if c0 == 100 && c1 == 116 { // "dt"
            if !valid_datetime_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !dt datetime")
            }
            <<
        }
        if c0 == 116 && c1 == 122 { // "tz"
            if !valid_tz_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !tz timezone")
            }
            <<
        }
        if c0 == 100 && c1 == 117 { // "du"
            if !valid_duration_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !du duration")
            }
            <<
        }
        if c0 == 115 && c1 == 122 { // "sz"
            if !valid_data_size_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !sz data size")
            }
            <<
        }
        if c0 == 105 && c1 == 112 { // "ip"
            if !valid_ip_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !ip")
            }
            <<
        }
    }
    if tlen == 3 {
        c1 := d.buf[tlo + 1] & 255
        c2 := d.buf[tlo + 2] & 255
        if c0 == 118 && c1 == 101 && c2 == 114 { // "ver"
            if !valid_ver_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !ver")
            }
            <<
        }
        if c0 == 98 && c1 == 54 && c2 == 52 { // "b64"
            if !valid_b64_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !b64 base64")
            }
            <<
        }
    }
    if tlen == 4 {
        c1 := d.buf[tlo + 1] & 255
        c2 := d.buf[tlo + 2] & 255
        c3 := d.buf[tlo + 3] & 255
        if c0 == 117 && c1 == 110 && c2 == 105 && c3 == 120 { // "unix"
            if !valid_unix_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !unix timestamp")
            }
            <<
        }
        if c0 == 117 && c1 == 117 && c2 == 105 && c3 == 100 { // "uuid"
            if !valid_uuid_span(&d.buf, xlo, xhi) {
                d.fail(no, "invalid !uuid")
            }
            <<
        }
    }
    // Custom tag: tag name must be a valid identifier
    if !valid_tag_name_span(&d.buf, tlo, thi) {
        d.fail(no, "invalid type tag '!" + d.buf[tlo:thi] + "'")
    }
}

fn valid_tag_name_span(s &string, lo int, hi int) bool {
    if lo >= hi {
        << false
    }
    b0 := s[lo] & 255
    if !is_alpha(b0) && b0 != 95 {
        << false
    }
    for i in lo + 1:hi {
        if !is_alphanumeric(s[i] & 255) {
            << false
        }
    }
    << true
}

fn valid_underscores_span(s &string, lo int, hi int) bool {
    if lo >= hi {
        << false
    }
    if (s[lo] & 255) == 95 || (s[hi - 1] & 255) == 95 {
        << false
    }
    $prev_us := false
    for i in lo:hi {
        if (s[i] & 255) == 95 {
            if prev_us {
                << false
            }
            prev_us = true
        } else {
            prev_us = false
        }
    }
    << true
}

fn looks_float_span(s &string, lo int, hi int) bool {
    for i in lo:hi {
        b := s[i] & 255
        if b == 46 || b == 101 || b == 69 {
            << true
        }
    }
    << false
}

fn valid_int_span(s &string, lo int, hi int) bool {
    if !valid_underscores_span(s, lo, hi) {
        << false
    }
    $i := lo
    if (s[lo] & 255) == 45 {
        i = lo + 1
        if i >= hi {
            << false
        }
    }
    $digit_count := 0
    $first_digit := 0
    while i < hi {
        c := s[i] & 255
        if c == 95 {
            if digit_count == 0 {
                << false
            }
        } else {
            if !is_digit(c) {
                << false
            }
            if digit_count == 0 {
                first_digit = c
            }
            digit_count += 1
        }
        i += 1
    }
    if digit_count == 0 {
        << false
    }
    if digit_count > 1 && first_digit == 48 {
        << false
    }
    << true
}

fn valid_float_span(s &string, lo int, hi int) bool {
    if !valid_underscores_span(s, lo, hi) {
        << false
    }
    $i := lo
    if (s[lo] & 255) == 45 {
        i = lo + 1
        if i >= hi {
            << false
        }
    }
    $int_digits := 0
    while i < hi {
        c := s[i] & 255
        if is_digit(c) {
            int_digits += 1
            i += 1
        } else {
            if c == 95 {
                i += 1
            } else {
                <-
            }
        }
    }
    if int_digits == 0 {
        << false
    }
    $has_dot_or_exp := false
    if i < hi && (s[i] & 255) == 46 { // '.'
        has_dot_or_exp = true
        i += 1
        $frac_digits := 0
        while i < hi {
            c := s[i] & 255
            if is_digit(c) {
                frac_digits += 1
                i += 1
            } else {
                if c == 95 {
                    i += 1
                } else {
                    <-
                }
            }
        }
        if frac_digits == 0 {
            << false
        }
    }
    if i < hi && ((s[i] & 255) == 101 || (s[i] & 255) == 69) {
        has_dot_or_exp = true
        i += 1
        if i < hi && ((s[i] & 255) == 43 || (s[i] & 255) == 45) {
            i += 1
        }
        $exp_digits := 0
        while i < hi {
            c := s[i] & 255
            if is_digit(c) {
                exp_digits += 1
                i += 1
            } else {
                if c == 95 {
                    i += 1
                } else {
                    <-
                }
            }
        }
        if exp_digits == 0 {
            << false
        }
    }
    << has_dot_or_exp && i == hi
}

fn valid_hex_int_span(s &string, lo int, hi int) bool {
    if !valid_underscores_span(s, lo, hi) {
        << false
    }
    $cnt := 0
    for i in lo:hi {
        c := s[i] & 255
        if c != 95 {
            if !is_hex(c) {
                << false
            }
            cnt += 1
        }
    }
    << cnt > 0
}

fn valid_hex_bytes_span(s &string, lo int, hi int) bool {
    if !valid_underscores_span(s, lo, hi) {
        << false
    }
    $cnt := 0
    for i in lo:hi {
        c := s[i] & 255
        if c != 95 {
            if !is_hex(c) {
                << false
            }
            cnt += 1
        }
    }
    << cnt > 0 && cnt % 2 == 0
}

fn valid_octal_span(s &string, lo int, hi int) bool {
    if lo >= hi {
        << false
    }
    for i in lo:hi {
        c := s[i] & 255
        if c < 48 || c > 55 {
            << false
        }
    }
    << true
}

fn valid_ver_span(s &string, lo int, hi int) bool {
    if lo >= hi {
        << false
    }
    $seg_digits := 0
    $i := lo
    while i < hi {
        b := s[i] & 255
        if is_digit(b) {
            seg_digits += 1
            i += 1
        } else {
            if b == 46 { // '.'
                if seg_digits == 0 {
                    << false
                }
                seg_digits = 0
                i += 1
            } else {
                <-
            }
        }
    }
    if seg_digits == 0 {
        << false
    }
    if i == hi {
        << true
    }
    if (s[i] & 255) == 45 { // prerelease suffix '-...'
        i += 1
        if i >= hi {
            << false
        }
        while i < hi {
            b := s[i] & 255
            if !is_alphanumeric(b) && b != 46 && b != 45 {
                << false
            }
            i += 1
        }
        << true
    }
    << false
}

fn digits_range_span(s &string, lo int, hi int) bool {
    if lo >= hi || hi > s.len {
        << false
    }
    for i in lo:hi {
        if !is_digit(s[i] & 255) {
            << false
        }
    }
    << true
}

fn valid_date_span(s &string, lo int, hi int) bool {
    if hi - lo != 10 {
        << false
    }
    if (s[lo + 4] & 255) != 45 || (s[lo + 7] & 255) != 45 {
        << false
    }
    << digits_range_span(s, lo, lo + 4) && digits_range_span(s, lo + 5, lo + 7) && digits_range_span(s, lo + 8, lo + 10)
}

fn valid_time_span(s &string, lo int, hi int) bool {
    n := hi - lo
    if n < 5 {
        << false
    }
    if !digits_range_span(s, lo, lo + 2) || (s[lo + 2] & 255) != 58 || !digits_range_span(s, lo + 3, lo + 5) {
        << false
    }
    if n == 5 {
        << true
    }
    if n < 8 || (s[lo + 5] & 255) != 58 || !digits_range_span(s, lo + 6, lo + 8) {
        << false
    }
    if n == 8 {
        << true
    }
    if (s[lo + 8] & 255) != 46 || n == 9 {
        << false
    }
    << digits_range_span(s, lo + 9, hi)
}

fn valid_tz_offset_span(s &string, lo int, hi int) bool {
    if hi - lo != 6 {
        << false
    }
    b0 := s[lo] & 255
    if b0 != 43 && b0 != 45 {
        << false
    }
    if (s[lo + 3] & 255) != 58 {
        << false
    }
    << digits_range_span(s, lo + 1, lo + 3) && digits_range_span(s, lo + 4, lo + 6)
}

fn valid_datetime_span(s &string, lo int, hi int) bool {
    n := hi - lo
    if n < 20 || (s[lo + 10] & 255) != 84 { // 'T'
        << false
    }
    if !valid_date_span(s, lo, lo + 10) {
        << false
    }
    last := s[hi - 1] & 255
    if last == 90 { // 'Z'
        << valid_time_span(s, lo + 11, hi - 1)
    }
    if n >= 25 {
        off_start := hi - 6
        b := s[off_start] & 255
        if b == 43 || b == 45 {
            << valid_time_span(s, lo + 11, off_start) && valid_tz_offset_span(s, off_start, hi)
        }
    }
    << false
}

fn valid_tz_span(s &string, lo int, hi int) bool {
    n := hi - lo
    if n == 1 && (s[lo] & 255) == 90 { // "Z"
        << true
    }
    if n == 3 && (s[lo] & 255) == 85 && (s[lo + 1] & 255) == 84 && (s[lo + 2] & 255) == 67 { // "UTC"
        << true
    }
    if valid_tz_offset_span(s, lo, hi) {
        << true
    }
    // ^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$
    $i := lo
    while i < hi {
        b := s[i] & 255
        if is_alpha(b) || b == 95 {
            i += 1
        } else {
            <-
        }
    }
    if i == lo || i >= hi || (s[i] & 255) != 47 {
        << false
    }
    while i < hi && (s[i] & 255) == 47 {
        i += 1
        $seg := 0
        while i < hi {
            b := s[i] & 255
            if is_alphanumeric(b) || b == 45 || b == 43 {
                seg += 1
                i += 1
            } else {
                <-
            }
        }
        if seg == 0 {
            << false
        }
    }
    << i == hi
}

fn valid_duration_span(s &string, lo int, hi int) bool {
    if lo >= hi {
        << false
    }
    $i := lo
    $matched := false
    // (\d+d)?
    st_d := i
    while i < hi && is_digit(s[i] & 255) { i += 1 }
    if i > st_d && i < hi && (s[i] & 255) == 100 {
        matched = true
        i += 1
    } else {
        i = st_d
    }
    // (\d+h)?
    st_h := i
    while i < hi && is_digit(s[i] & 255) { i += 1 }
    if i > st_h && i < hi && (s[i] & 255) == 104 {
        matched = true
        i += 1
    } else {
        i = st_h
    }
    // (\d+m)? without stealing 'ms'
    st_m := i
    while i < hi && is_digit(s[i] & 255) { i += 1 }
    if i > st_m && i < hi && (s[i] & 255) == 109 && (i + 1 >= hi || (s[i + 1] & 255) != 115) {
        matched = true
        i += 1
    } else {
        i = st_m
    }
    // (\d+(?:\.\d+)?s)?
    st_s := i
    while i < hi && is_digit(s[i] & 255) { i += 1 }
    if i > st_s && i + 1 < hi && (s[i] & 255) == 46 && is_digit(s[i + 1] & 255) {
        i += 1
        while i < hi && is_digit(s[i] & 255) { i += 1 }
    }
    if i > st_s && i < hi && (s[i] & 255) == 115 {
        matched = true
        i += 1
    } else {
        i = st_s
    }
    // (\d+(?:\.\d+)?ms)?
    st_ms := i
    while i < hi && is_digit(s[i] & 255) { i += 1 }
    if i > st_ms && i + 1 < hi && (s[i] & 255) == 46 && is_digit(s[i + 1] & 255) {
        i += 1
        while i < hi && is_digit(s[i] & 255) { i += 1 }
    }
    if i > st_ms && i + 1 < hi && (s[i] & 255) == 109 && (s[i + 1] & 255) == 115 {
        matched = true
        i += 2
    } else {
        i = st_ms
    }
    << matched && i == hi
}

fn valid_data_size_span(s &string, lo int, hi int) bool {
    $i := lo
    while i < hi && is_digit(s[i] & 255) {
        i += 1
    }
    if i == lo {
        << false
    }
    if i < hi && (s[i] & 255) == 46 {
        i += 1
        $f := 0
        while i < hi && is_digit(s[i] & 255) {
            f += 1
            i += 1
        }
        if f == 0 {
            << false
        }
    }
    ulen := hi - i
    if ulen == 1 {
        << (s[i] & 255) == 66 // 'B'
    }
    if ulen == 2 {
        u0 := s[i] & 255
        u1 := s[i + 1] & 255
        if u1 != 66 { // 'B'
            << false
        }
        << u0 == 75 || u0 == 77 || u0 == 71 || u0 == 84 || u0 == 80 // K, M, G, T, P
    }
    if ulen == 3 {
        u0 := s[i] & 255
        u1 := s[i + 1] & 255
        u2 := s[i + 2] & 255
        if u1 != 105 || u2 != 66 { // "iB"
            << false
        }
        << u0 == 75 || u0 == 77 || u0 == 71 || u0 == 84 || u0 == 80 // K, M, G, T, P
    }
    << false
}

fn valid_unix_span(s &string, lo int, hi int) bool {
    if !valid_underscores_span(s, lo, hi) {
        << false
    }
    $i := lo
    if (s[lo] & 255) == 45 {
        i = lo + 1
        if i >= hi {
            << false
        }
    }
    $digits := 0
    $first_d := 0
    while i < hi {
        c := s[i] & 255
        if is_digit(c) {
            if digits == 0 {
                first_d = c
            }
            digits += 1
            i += 1
        } else {
            if c == 95 {
                if digits == 0 {
                    << false
                }
                i += 1
            } else {
                <-
            }
        }
    }
    if digits == 0 || (digits > 1 && first_d == 48) {
        << false
    }
    if i == hi {
        << true
    }
    if (s[i] & 255) != 46 {
        << false
    }
    i += 1
    $frac := 0
    while i < hi {
        c := s[i] & 255
        if is_digit(c) {
            frac += 1
            i += 1
        } else {
            if c == 95 {
                if frac == 0 {
                    << false
                }
                i += 1
            } else {
                << false
            }
        }
    }
    << frac > 0
}

fn valid_uuid_span(s &string, lo int, hi int) bool {
    if hi - lo != 36 {
        << false
    }
    if (s[lo + 8] & 255) != 45 || (s[lo + 13] & 255) != 45 || (s[lo + 18] & 255) != 45 || (s[lo + 23] & 255) != 45 {
        << false
    }
    for k in 0:36 {
        if k != 8 && k != 13 && k != 18 && k != 23 {
            if !is_hex(s[lo + k] & 255) {
                << false
            }
        }
    }
    << true
}

fn valid_ip_span(s &string, lo int, hi int) bool {
    if lo >= hi {
        << false
    }
    $has_colon := false
    for i in lo:hi {
        if (s[i] & 255) == 58 {
            has_colon = true
            <-
        }
    }
    if !has_colon {
        $i := lo
        for seg in 0:4 {
            $d := 0
            $val := 0
            $first := 0
            while i < hi && is_digit(s[i] & 255) {
                c := s[i] & 255
                if d == 0 {
                    first = c
                }
                val = val * 10 + (c - 48)
                d += 1
                i += 1
                if d > 3 || val > 255 {
                    << false
                }
            }
            if d == 0 || (d > 1 && first == 48) {
                << false
            }
            if seg < 3 {
                if i >= hi || (s[i] & 255) != 46 {
                    << false
                }
                i += 1
            }
        }
        << i == hi
    }
    // IPv6
    $parts := 1
    $empty := 0
    $seg_len := 0
    $col_run := 0
    for i in lo:hi {
        c := s[i] & 255
        if c == 46 {
            << false
        }
        if c == 58 {
            col_run += 1
            if col_run >= 3 {
                << false
            }
            if seg_len == 0 {
                empty += 1
            }
            parts += 1
            seg_len = 0
        } else {
            col_run = 0
            if !is_hex(c) {
                << false
            }
            seg_len += 1
            if seg_len > 4 {
                << false
            }
        }
    }
    if seg_len == 0 {
        empty += 1
    }
    << parts >= 3 && parts <= 8 && empty <= 2
}

fn valid_b64_span(s &string, lo int, hi int) bool {
    $clean_len := 0
    $pad := 0
    $saw_pad := false
    for i in lo:hi {
        b := s[i] & 255
        if b == 32 || b == 9 || b == 10 || b == 13 {
            ->
        }
        if b == 61 { // '='
            saw_pad = true
            pad += 1
        } else {
            if saw_pad {
                << false
            }
            ok := is_alpha(b) || is_digit(b) || b == 43 || b == 47
            if !ok {
                << false
            }
        }
        clean_len += 1
    }
    << clean_len > 0 && clean_len % 4 == 0 && pad <= 2
}

fn valid_char_span(s &string, lo int, hi int) bool {
    n := hi - lo
    if n >= 2 && (s[lo] & 255) == 85 && (s[lo + 1] & 255) == 43 { // "U+"
        rlen := hi - (lo + 2)
        if rlen < 4 || rlen > 6 {
            << false
        }
        $cp := 0
        for i in lo + 2:hi {
            c := s[i] & 255
            if !is_hex(c) {
                << false
            }
            $d := 0
            if c >= 48 && c <= 57 {
                d = c - 48
            } else {
                if c >= 97 && c <= 102 {
                    d = c - 97 + 10
                } else {
                    d = c - 65 + 10
                }
            }
            cp = cp * 16 + d
        }
        << cp <= 1114111
    }
    if n <= 0 {
        << false
    }
    b0 := s[lo] & 255
    $expect_len := 1
    if (b0 & 128) == 0 {
        expect_len = 1
    } else {
        if (b0 & 224) == 192 {
            expect_len = 2
        } else {
            if (b0 & 240) == 224 {
                expect_len = 3
            } else {
                if (b0 & 248) == 240 {
                    expect_len = 4
                } else {
                    << false
                }
            }
        }
    }
    << n == expect_len
}
