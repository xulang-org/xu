@encoding/xun

// encoding.xun — XUN documents, compliant with https://github.com/qorm/xun
// Xu has no pointers-to-heap or enums, so the parse tree is a POOL of flat
// nodes (same idiom as xu.ast): every node is an index into Doc's parallel
// arrays; children are linked through firsts/nexts (-1 = none). Handles are
// plain ints (copyable), the Doc owns all storage.
// Receivers take values or writable $&Doc references (Go-style methods).

#unicode/utf8
#strconv

pub const KIND_DICT = 0
pub const KIND_LIST = 1
pub const KIND_SCALAR = 2
pub const MAX_BYTES = 1048576
pub const MAX_DEPTH = 64

pub struct Doc {
    // Tree storage (parallel arrays; node ids index all of them).
    pub kinds []int
    pub tags []string
    pub texts []string
    pub keys []string
    pub firsts []int
    pub nexts []int
    // Child-link bookkeeping during parsing (last child of each node).
    pub lasts []int
    pub root_idx int
    pub err string
    pub line int
    // Parse state (kept here: arrays cannot move between structs).
    pub lines []string
    pub nos []int
    pub i int
    pub tok_kind int
    pub tok_no int
    pub tok_key string
    pub tok_inline string
}

pub fn new_doc() Doc {
    << Doc{
        kinds: []int{},
        tags: []string{},
        texts: []string{},
        keys: []string{},
        firsts: []int{},
        nexts: []int{},
        lasts: []int{},
        root_idx: -1,
        err: "",
        line: 1,
        lines: []string{},
        nos: []int{},
        i: 0,
        tok_kind: 0,
        tok_no: 1,
        tok_key: "",
        tok_inline: ""
    }
}

// ===== public API =====

pub fn (d Doc) ok() bool {
    << d.err.len == 0
}

pub fn (d Doc) error() string {
    << d.err + ""
}

pub fn (d Doc) error_line() int {
    << d.line
}

pub fn (d Doc) root() int {
    << d.root_idx
}

pub fn (d Doc) kind(n int) int {
    if n < 0 || n >= d.kinds.len {
        << -1
    }
    << d.kinds[n]
}

pub fn (d Doc) is_dict(n int) bool {
    if n < 0 || n >= d.kinds.len {
        << false
    }
    << d.kinds[n] == KIND_DICT
}

pub fn (d Doc) is_list(n int) bool {
    if n < 0 || n >= d.kinds.len {
        << false
    }
    << d.kinds[n] == KIND_LIST
}

pub fn (d Doc) is_scalar(n int) bool {
    if n < 0 || n >= d.kinds.len {
        << false
    }
    << d.kinds[n] == KIND_SCALAR
}

pub fn (d Doc) tag(n int) string {
    if n < 0 || n >= d.tags.len {
        << ""
    }
    << d.tags[n] + ""
}

pub fn (d Doc) text(n int) string {
    if n < 0 || n >= d.texts.len {
        << ""
    }
    << d.texts[n] + ""
}

pub fn (d Doc) key(n int) string {
    if n < 0 || n >= d.keys.len {
        << ""
    }
    << d.keys[n] + ""
}

pub fn (d Doc) count(n int) int {
    if n < 0 || n >= d.firsts.len {
        << 0
    }
    $c := 0
    $cur := d.firsts[n]
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 || cur >= d.nexts.len {
            << c
        }
        c += 1
        cur = d.nexts[cur]
    }
    << c
}

pub fn (d Doc) at(n int, i int) int {
    if n < 0 || n >= d.firsts.len || i < 0 {
        << -1
    }
    $cur := d.firsts[n]
    $k := 0
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 || cur >= d.nexts.len {
            << -1
        }
        if k == i {
            << cur
        }
        k += 1
        cur = d.nexts[cur]
    }
    << -1
}

pub fn (d Doc) get(n int, key string) int {
    if n < 0 || n >= d.firsts.len {
        << -1
    }
    $cur := d.firsts[n]
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 || cur >= d.keys.len {
            << -1
        }
        if d.keys[cur] == key {
            << cur
        }
        if cur >= d.nexts.len {
            << -1
        }
        cur = d.nexts[cur]
    }
    << -1
}

// ===== typed value accessors =====

pub fn (d Doc) as_str(n int) string {
    << d.text(n)
}

pub fn (d Doc) as_int(n int) int {
    t := d.text(n)
    txt := strip_us(&t)
    if txt.len == 0 {
        << 0
    }
    v := parse_int(txt) or (err) {
        << 0
    }
    << v
}

pub fn (d Doc) as_f64(n int) f64 {
    t := d.text(n)
    txt := strip_us(&t)
    if txt.len == 0 {
        << 0.0
    }
    v := strconv.parse_float(&txt) or (err) {
        << 0.0
    }
    << v
}

pub fn (d Doc) as_bool(n int) bool {
    txt := d.text(n)
    << txt == "true"
}

// ===== node construction / tree building API =====

pub fn (d $&Doc) set_root(r int) {
    d.root_idx = r
}

pub fn (d $&Doc) new_node(kind int, tag string, text string, key string) int {
    d.kinds.push(kind)
    d.tags.push(tag)
    d.texts.push(text)
    d.keys.push(key)
    d.firsts.push(-1)
    d.nexts.push(-1)
    d.lasts.push(-1)
    idx := d.kinds.len - 1
    if d.root_idx < 0 {
        d.root_idx = idx
    }
    << idx
}

pub fn (d $&Doc) attach(parent int, child int) {
    if parent < 0 || parent >= d.firsts.len {
        <<
    }
    if child < 0 || child >= d.nexts.len {
        <<
    }
    if d.firsts[parent] == -1 {
        d.firsts[parent] = child
    } else {
        last := d.lasts[parent]
        if last < 0 || last >= d.nexts.len {
            d.firsts[parent] = child
        } else {
            d.nexts[last] = child
        }
    }
    d.lasts[parent] = child
}

pub fn (d $&Doc) add_dict(parent int, key string) int {
    n := d.new_node(KIND_DICT, "", "", key)
    if parent >= 0 {
        d.attach(parent, n)
    }
    << n
}

pub fn (d $&Doc) add_list(parent int, key string) int {
    n := d.new_node(KIND_LIST, "", "", key)
    if parent >= 0 {
        d.attach(parent, n)
    }
    << n
}

pub fn (d $&Doc) add_scalar(parent int, key string, tag string, text string) int {
    n := d.new_node(KIND_SCALAR, tag, text, key)
    if parent >= 0 {
        d.attach(parent, n)
    }
    << n
}

pub fn (d $&Doc) add_str(parent int, key string, val string) int {
    << d.add_scalar(parent, key, "", val)
}

pub fn (d $&Doc) add_int(parent int, key string, val int) int {
    << d.add_scalar(parent, key, "i", str(val))
}

pub fn (d $&Doc) add_f64(parent int, key string, val f64) int {
    k := key + ""
    s := strconv.format_float(val, 102, -1) or (err) {
        << d.add_scalar(parent, k, "f", "0.0")
    }
    $out_s := s + ""
    dot := "."
    e_low := "e"
    e_up := "E"
    if !str_contains(&out_s, &dot) && !str_contains(&out_s, &e_low) && !str_contains(&out_s, &e_up) {
        out_s = out_s + ".0"
    }
    << d.add_scalar(parent, key, "f", out_s)
}

pub fn (d $&Doc) add_bool(parent int, key string, val bool) int {
    $s := "false"
    if val {
        s = "true"
    }
    << d.add_scalar(parent, key, "b", s)
}

pub fn (d $&Doc) push_dict(parent int) int {
    << d.add_dict(parent, "")
}

pub fn (d $&Doc) push_list(parent int) int {
    << d.add_list(parent, "")
}

pub fn (d $&Doc) push_scalar(parent int, tag string, text string) int {
    << d.add_scalar(parent, "", tag, text)
}

pub fn (d $&Doc) push_str(parent int, val string) int {
    << d.add_str(parent, "", val)
}

pub fn (d $&Doc) push_int(parent int, val int) int {
    << d.add_int(parent, "", val)
}

pub fn (d $&Doc) push_f64(parent int, val f64) int {
    << d.add_f64(parent, "", val)
}

pub fn (d $&Doc) push_bool(parent int, val bool) int {
    << d.add_bool(parent, "", val)
}

fn (d $&Doc) fail(no int, msg string) {
    if d.err.len > 0 {
        <<
    }
    d.err = msg
    d.line = no
}

// ===== parse =====

pub fn parse(src &string) Doc {
    $d := new_doc()
    raw := src + ""
    if raw.len > MAX_BYTES {
        d.fail(1, "file larger than 1048576 bytes")
        << d
    }
    if has_nul(&raw) {
        d.fail(1, "NUL byte is not allowed")
        << d
    }
    body := strip_bom(raw)
    if !utf8.valid(&body) {
        d.fail(1, "invalid UTF-8")
        << d
    }
    d.split_lines(body)
    if d.err.len == 0 {
        if d.i < d.lines.len {
            d.root_idx = d.parse_dict(-1, 0, 0, "")
            d.try_consume_end(0, "")
        } else {
            d.root_idx = d.new_node(KIND_DICT, "", "", "")
        }
    } else {
        d.root_idx = d.new_node(KIND_DICT, "", "", "")
    }
    << d
}
