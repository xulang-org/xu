@encoding/xun

// encoding.xun — XUN documents for Xu, compliant with https://github.com/xulang-org/xun
// Xu uses a flat pool of parallel arrays inside Doc backed by a single string arena `buf`
// and integer byte spans [lo, hi) so parsing avoids per-token heap allocations.

#strconv

pub const KIND_DICT = 0
pub const KIND_LIST = 1
pub const KIND_SCALAR = 2
pub const MAX_BYTES = 1048576
pub const MAX_DEPTH = 64

pub struct Span {
    pub lo int
    pub hi int
}

pub struct Doc {
    // Tree storage (parallel arrays; node ids index all of them).
    pub kinds []int
    pub tag_lo []int
    pub tag_hi []int
    pub text_lo []int
    pub text_hi []int
    pub key_lo []int
    pub key_hi []int
    pub key_hashes []int
    pub firsts []int
    pub nexts []int
    // Child-link bookkeeping during parsing (last child of each node).
    pub lasts []int
    // Single arena holding source document bytes plus any unescaped/multiline/interned strings.
    pub buf string
    pub root_idx int
    pub err string
    pub line int
    // Parse state (line index i -> 1-based line number i + 1).
    pub line_starts []int
    pub line_ends []int
    pub i int
    pub tok_kind int
    pub tok_no int
    pub tok_klo int
    pub tok_khi int
    pub tok_khash int
    pub tok_vlo int
    pub tok_vhi int
}

pub fn new_doc() Doc {
    << Doc{
        kinds: []int{},
        tag_lo: []int{},
        tag_hi: []int{},
        text_lo: []int{},
        text_hi: []int{},
        key_lo: []int{},
        key_hi: []int{},
        key_hashes: []int{},
        firsts: []int{},
        nexts: []int{},
        lasts: []int{},
        buf: "",
        root_idx: -1,
        err: "",
        line: 1,
        line_starts: []int{},
        line_ends: []int{},
        i: 0,
        tok_kind: 0,
        tok_no: 1,
        tok_klo: 0,
        tok_khi: 0,
        tok_khash: 0,
        tok_vlo: 0,
        tok_vhi: 0
    }
}

fn append_into_arena(out $&string, s &string) {
    out.push_str(*s)
}

fn (d $&Doc) intern_str(s &string) Span {
    if s.len == 0 {
        << Span{lo: 0, hi: 0}
    }
    lo := d.buf.len
    append_into_arena($&d.buf, s)
    << Span{lo: lo, hi: d.buf.len}
}

// ===== public API =====

pub fn (d Doc) ok() bool {
    << d.err.len == 0
}

pub fn (d Doc) error() string {
    << d.err + ""
}

pub fn (d Doc) error_line() int {
    << d.line
}

pub fn (d Doc) root() int {
    << d.root_idx
}

pub fn (d Doc) kind(n int) int {
    if n < 0 || n >= d.kinds.len {
        << -1
    }
    << d.kinds[n]
}

pub fn (d Doc) is_dict(n int) bool {
    if n < 0 || n >= d.kinds.len {
        << false
    }
    << d.kinds[n] == KIND_DICT
}

pub fn (d Doc) is_list(n int) bool {
    if n < 0 || n >= d.kinds.len {
        << false
    }
    << d.kinds[n] == KIND_LIST
}

pub fn (d Doc) is_scalar(n int) bool {
    if n < 0 || n >= d.kinds.len {
        << false
    }
    << d.kinds[n] == KIND_SCALAR
}

pub fn (d Doc) tag(n int) string {
    if n < 0 || n >= d.tag_lo.len {
        << ""
    }
    lo := d.tag_lo[n]
    hi := d.tag_hi[n]
    if lo >= hi {
        << ""
    }
    << d.buf[lo:hi]
}

pub fn (d Doc) text(n int) string {
    if n < 0 || n >= d.text_lo.len {
        << ""
    }
    lo := d.text_lo[n]
    hi := d.text_hi[n]
    if lo >= hi {
        << ""
    }
    << d.buf[lo:hi]
}

pub fn (d Doc) key(n int) string {
    if n < 0 || n >= d.key_lo.len {
        << ""
    }
    lo := d.key_lo[n]
    hi := d.key_hi[n]
    if lo >= hi {
        << ""
    }
    << d.buf[lo:hi]
}

pub fn (d Doc) count(n int) int {
    if n < 0 || n >= d.firsts.len {
        << 0
    }
    $c := 0
    $cur := d.firsts[n]
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 || cur >= d.nexts.len {
            << c
        }
        c += 1
        cur = d.nexts[cur]
    }
    << c
}

pub fn (d Doc) at(n int, i int) int {
    if n < 0 || n >= d.firsts.len || i < 0 {
        << -1
    }
    $cur := d.firsts[n]
    $k := 0
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 || cur >= d.nexts.len {
            << -1
        }
        if k == i {
            << cur
        }
        k += 1
        cur = d.nexts[cur]
    }
    << -1
}

pub fn (d Doc) get(n int, key string) int {
    if n < 0 || n >= d.firsts.len {
        << -1
    }
    kh := hash_str(&key)
    $cur := d.firsts[n]
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 || cur >= d.key_lo.len {
            << -1
        }
        if d.key_hashes[cur] == kh && span_eq_str(&d.buf, d.key_lo[cur], d.key_hi[cur], &key) {
            << cur
        }
        if cur >= d.nexts.len {
            << -1
        }
        cur = d.nexts[cur]
    }
    << -1
}

// ===== typed value accessors =====

pub fn (d Doc) as_str(n int) string {
    << d.text(n)
}

pub fn (d Doc) as_int(n int) int {
    t := d.text(n)
    txt := strip_us(&t)
    if txt.len == 0 {
        << 0
    }
    v := parse_int(txt) >>> (err) {
        << 0
    }
    << v
}

pub fn (d Doc) as_f64(n int) f64 {
    t := d.text(n)
    txt := strip_us(&t)
    if txt.len == 0 {
        << 0.0
    }
    v := strconv.parse_float(&txt) >>> (err) {
        << 0.0
    }
    << v
}

pub fn (d Doc) as_bool(n int) bool {
    if n < 0 || n >= d.text_lo.len {
        << false
    }
    true_lit := "true"
    << span_eq_str(&d.buf, d.text_lo[n], d.text_hi[n], &true_lit)
}

// ===== node construction / tree building API =====

pub fn (d $&Doc) set_root(r int) {
    d.root_idx = r
}

fn (d $&Doc) new_node_span(kind int, tlo int, thi int, xlo int, xhi int, klo int, khi int, khash int) int {
    d.kinds.push(kind)
    d.tag_lo.push(tlo)
    d.tag_hi.push(thi)
    d.text_lo.push(xlo)
    d.text_hi.push(xhi)
    d.key_lo.push(klo)
    d.key_hi.push(khi)
    d.key_hashes.push(khash)
    d.firsts.push(-1)
    d.nexts.push(-1)
    d.lasts.push(-1)
    idx := d.kinds.len - 1
    if d.root_idx < 0 {
        d.root_idx = idx
    }
    << idx
}

fn (d $&Doc) set_key_span(n int, klo int, khi int, khash int) {
    if n >= 0 && n < d.key_lo.len {
        d.key_lo[n] = klo
        d.key_hi[n] = khi
        d.key_hashes[n] = khash
    }
}

fn (d $&Doc) set_tag_span(n int, tlo int, thi int) {
    if n >= 0 && n < d.tag_lo.len {
        d.tag_lo[n] = tlo
        d.tag_hi[n] = thi
    }
}

pub fn (d $&Doc) new_node(kind int, tag string, text string, key string) int {
    ts := d.intern_str(&tag)
    xs := d.intern_str(&text)
    ks := d.intern_str(&key)
    kh := hash_span(&d.buf, ks.lo, ks.hi)
    << d.new_node_span(kind, ts.lo, ts.hi, xs.lo, xs.hi, ks.lo, ks.hi, kh)
}

pub fn (d $&Doc) attach(parent int, child int) {
    if parent < 0 || parent >= d.firsts.len {
        <<
    }
    if child < 0 || child >= d.nexts.len {
        <<
    }
    if d.firsts[parent] == -1 {
        d.firsts[parent] = child
    } else {
        last := d.lasts[parent]
        if last < 0 || last >= d.nexts.len {
            d.firsts[parent] = child
        } else {
            d.nexts[last] = child
        }
    }
    d.lasts[parent] = child
}

pub fn (d $&Doc) add_dict(parent int, key string) int {
    n := d.new_node(KIND_DICT, "", "", key)
    if parent >= 0 {
        d.attach(parent, n)
    }
    << n
}

pub fn (d $&Doc) add_list(parent int, key string) int {
    n := d.new_node(KIND_LIST, "", "", key)
    if parent >= 0 {
        d.attach(parent, n)
    }
    << n
}

pub fn (d $&Doc) add_scalar(parent int, key string, tag string, text string) int {
    n := d.new_node(KIND_SCALAR, tag, text, key)
    if parent >= 0 {
        d.attach(parent, n)
    }
    << n
}

pub fn (d $&Doc) add_str(parent int, key string, val string) int {
    << d.add_scalar(parent, key, "", val)
}

pub fn (d $&Doc) add_int(parent int, key string, val int) int {
    << d.add_scalar(parent, key, "i", str(val))
}

pub fn (d $&Doc) add_f64(parent int, key string, val f64) int {
    k := key + ""
    s := strconv.format_float(val, 102, -1) >>> (err) {
        << d.add_scalar(parent, k, "f", "0.0")
    }
    $out_s := s + ""
    dot := "."
    e_low := "e"
    e_up := "E"
    if !str_contains(&out_s, &dot) && !str_contains(&out_s, &e_low) && !str_contains(&out_s, &e_up) {
        out_s = out_s + ".0"
    }
    << d.add_scalar(parent, key, "f", out_s)
}

pub fn (d $&Doc) add_bool(parent int, key string, val bool) int {
    $s := "false"
    if val {
        s = "true"
    }
    << d.add_scalar(parent, key, "b", s)
}

pub fn (d $&Doc) push_dict(parent int) int {
    << d.add_dict(parent, "")
}

pub fn (d $&Doc) push_list(parent int) int {
    << d.add_list(parent, "")
}

pub fn (d $&Doc) push_scalar(parent int, tag string, text string) int {
    << d.add_scalar(parent, "", tag, text)
}

pub fn (d $&Doc) push_str(parent int, val string) int {
    << d.add_str(parent, "", val)
}

pub fn (d $&Doc) push_int(parent int, val int) int {
    << d.add_int(parent, "", val)
}

pub fn (d $&Doc) push_f64(parent int, val f64) int {
    << d.add_f64(parent, "", val)
}

pub fn (d $&Doc) push_bool(parent int, val bool) int {
    << d.add_bool(parent, "", val)
}

fn (d $&Doc) fail(no int, msg string) {
    if d.err.len > 0 {
        <<
    }
    d.err = msg
    d.line = no
}

// ===== parse / decode =====

pub fn parse(src &string) Doc {
    $d := new_doc()
    if src.len > MAX_BYTES {
        d.fail(1, "file larger than 1048576 bytes")
        d.root_idx = d.new_node_span(KIND_DICT, 0, 0, 0, 0, 0, 0, 0)
        << d
    }
    d.buf = *src + ""
    d.scan_lines()
    if d.err.len == 0 {
        if d.i < d.line_starts.len {
            d.root_idx = d.parse_dict(-1, 0, 0, 0, 0)
            if d.err.len == 0 {
                d.try_consume_end(0, 0, 0)
            }
        } else {
            d.root_idx = d.new_node_span(KIND_DICT, 0, 0, 0, 0, 0, 0, 0)
        }
    } else {
        d.root_idx = d.new_node_span(KIND_DICT, 0, 0, 0, 0, 0, 0, 0)
    }
    << d
}

pub fn decode(src &string) Doc {
    << parse(src)
}
