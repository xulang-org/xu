@encoding/xun

struct KvSpan {
    klo int
    khi int
    vlo int
    vhi int
}

fn (d $&Doc) split_key_span(lo int, hi int, no int) KvSpan {
    if lo < hi && (d.buf[lo] & 255) == 34 { // quoted key
        qp := d.parse_quoted_prefix_span(no, lo, hi)
        if d.err.len > 0 {
            << KvSpan{klo: 0, khi: 0, vlo: 0, vhi: 0}
        }
        if qp.klo >= qp.khi {
            d.fail(no, "empty key")
            << KvSpan{klo: 0, khi: 0, vlo: 0, vhi: 0}
        }
        after_lo := qp.end
        after_len := hi - after_lo
        if after_len == 1 && (d.buf[after_lo] & 255) == 58 { // ':'
            << KvSpan{klo: qp.klo, khi: qp.khi, vlo: 0, vhi: 0}
        }
        if after_len >= 2 && (d.buf[after_lo] & 255) == 58 && (d.buf[after_lo + 1] & 255) == 32 { // ': '
            << KvSpan{klo: qp.klo, khi: qp.khi, vlo: after_lo + 2, vhi: hi}
        }
        d.fail(no, "expected ': ' or trailing ':' after quoted key")
        << KvSpan{klo: 0, khi: 0, vlo: 0, vhi: 0}
    }
    $cs := -1
    lim := hi - 1
    if lim > lo {
        for i in lo:lim {
            if (d.buf[i] & 255) == 58 && (d.buf[i + 1] & 255) == 32 { // ': '
                cs = i
                <-
            }
        }
    }
    if cs > lo {
        if (d.buf[cs - 1] & 255) == 58 {
            d.fail(no, "key must not end with ':'")
            << KvSpan{klo: 0, khi: 0, vlo: 0, vhi: 0}
        }
        << KvSpan{klo: lo, khi: cs, vlo: cs + 2, vhi: hi}
    }
    if hi - lo > 1 && (d.buf[hi - 1] & 255) == 58 { // trailing ':'
        k_end := hi - 1
        if (d.buf[k_end - 1] & 255) == 58 {
            d.fail(no, "key must not end with ':'")
            << KvSpan{klo: 0, khi: 0, vlo: 0, vhi: 0}
        }
        << KvSpan{klo: lo, khi: k_end, vlo: 0, vhi: 0}
    }
    d.fail(no, "expected ': ' or a trailing ':'")
    << KvSpan{klo: 0, khi: 0, vlo: 0, vhi: 0}
}

fn looks_like_dict_entry_span(s &string, lo int, hi int) bool {
    t := trim_span(s, lo, hi)
    if t.lo >= t.hi {
        << false
    }
    b0 := s[t.lo] & 255
    if b0 == 33 || b0 == 34 || b0 == 124 { // '!', '"', '|'
        << false
    }
    if b0 == 123 { // '{'
        << true
    }
    if span_contains_colon_space(s, t.lo, t.hi) {
        << true
    }
    << t.hi - t.lo > 1 && (s[t.hi - 1] & 255) == 58
}

fn split_top_level_commas_spans(s &string, lo int, hi int, out_lo $&[]int, out_hi $&[]int) {
    $start := lo
    $in_quote := false
    $escape := false
    $depth_brace := 0
    $depth_bracket := 0
    for i in lo:hi {
        b := s[i] & 255
        if escape {
            escape = false
        } else {
            if b == 92 { // '\'
                escape = true
            } else {
                if b == 34 { // '"'
                    in_quote = !in_quote
                } else {
                    if !in_quote {
                        if b == 123 { // '{'
                            depth_brace += 1
                        } else {
                            if b == 125 { // '}'
                                if depth_brace > 0 {
                                    depth_brace -= 1
                                }
                            } else {
                                if b == 91 { // '['
                                    depth_bracket += 1
                                } else {
                                    if b == 93 { // ']'
                                        if depth_bracket > 0 {
                                            depth_bracket -= 1
                                        }
                                    } else {
                                        if b == 44 && depth_brace == 0 && depth_bracket == 0 { // ','
                                            out_lo.push(start)
                                            out_hi.push(i)
                                            start = i + 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if start <= hi {
        out_lo.push(start)
        out_hi.push(hi)
    }
}

fn (d Doc) has_child_key_span(container int, klo int, khi int, khash int) bool {
    $cur := d.firsts[container]
    while cur >= 0 {
        if d.key_hashes[cur] == khash && span_eq(&d.buf, d.key_lo[cur], d.key_hi[cur], klo, khi) {
            << true
        }
        cur = d.nexts[cur]
    }
    << false
}

// Depth counts containers below the root dictionary (depth zero).
fn (d $&Doc) nesting_ok(no int, depth int) bool {
    if depth > MAX_DEPTH {
        d.fail(no, "too much nesting")
        << false
    }
    << true
}

fn (d $&Doc) parse_inline_dict(parent int, no int, depth int, lo int, hi int) int {
    if !d.nesting_ok(no, depth) {
        << -1
    }
    t := trim_span(&d.buf, lo, hi)
    if t.hi - t.lo < 2 || (d.buf[t.lo] & 255) != 123 || (d.buf[t.hi - 1] & 255) != 125 { // '{' and '}'
        d.fail(no, "inline object must be wrapped in '{...}'")
        << -1
    }
    inner := trim_span(&d.buf, t.lo + 1, t.hi - 1)
    me := d.new_node_span(KIND_DICT, 0, 0, 0, 0, 0, 0, 0)
    if parent >= 0 {
        d.attach(parent, me)
    }
    if inner.lo >= inner.hi {
        << me
    }
    $p_lo := []int{}
    $p_hi := []int{}
    split_top_level_commas_spans(&d.buf, inner.lo, inner.hi, $&p_lo, $&p_hi)
    for idx in 0:p_lo.len {
        piece := trim_span(&d.buf, p_lo[idx], p_hi[idx])
        if piece.lo < piece.hi {
            kv := d.split_key_span(piece.lo, piece.hi, no)
            if d.err.len > 0 {
                << -1
            }
            kh := hash_span(&d.buf, kv.klo, kv.khi)
            if d.has_child_key_span(me, kv.klo, kv.khi, kh) {
                d.fail(no, "duplicate key '" + d.buf[kv.klo:kv.khi] + "'")
                << -1
            }
            child := d.parse_inline_value(me, no, depth + 1, kv.vlo, kv.vhi)
            if d.err.len > 0 {
                << -1
            }
            d.set_key_span(child, kv.klo, kv.khi, kh)
        }
    }
    << me
}

fn (d $&Doc) parse_inline_list(parent int, no int, depth int, lo int, hi int) int {
    if !d.nesting_ok(no, depth) {
        << -1
    }
    t := trim_span(&d.buf, lo, hi)
    if t.hi - t.lo < 2 || (d.buf[t.lo] & 255) != 91 || (d.buf[t.hi - 1] & 255) != 93 { // '[' and ']'
        d.fail(no, "inline array must be wrapped in '[...]'")
        << -1
    }
    inner := trim_span(&d.buf, t.lo + 1, t.hi - 1)
    me := d.new_node_span(KIND_LIST, 0, 0, 0, 0, 0, 0, 0)
    if parent >= 0 {
        d.attach(parent, me)
    }
    if inner.lo >= inner.hi {
        << me
    }
    $p_lo := []int{}
    $p_hi := []int{}
    split_top_level_commas_spans(&d.buf, inner.lo, inner.hi, $&p_lo, $&p_hi)
    for idx in 0:p_lo.len {
        piece := trim_span(&d.buf, p_lo[idx], p_hi[idx])
        if piece.lo < piece.hi {
            d.parse_inline_value(me, no, depth + 1, piece.lo, piece.hi)
            if d.err.len > 0 {
                << -1
            }
        }
    }
    << me
}

fn (d $&Doc) parse_inline_value(parent int, no int, depth int, lo int, hi int) int {
    t := trim_span(&d.buf, lo, hi)
    if t.lo >= t.hi {
        n0 := d.new_node_span(KIND_SCALAR, 0, 0, 0, 0, 0, 0, 0)
        d.attach(parent, n0)
        << n0
    }
    b0 := d.buf[t.lo] & 255
    blast := d.buf[t.hi - 1] & 255
    if t.hi - t.lo >= 2 && b0 == 123 && blast == 125 { // '{...}'
        << d.parse_inline_dict(parent, no, depth, t.lo, t.hi)
    }
    if t.hi - t.lo >= 2 && b0 == 91 && blast == 93 { // '[...]'
        << d.parse_inline_list(parent, no, depth, t.lo, t.hi)
    }
    if b0 == 33 && blast == 93 { // '!...[...]'
        ts := split_tag_span(&d.buf, t.lo + 1, t.hi)
        if ts.tag_lo < ts.tag_hi && !ts.has_space && ts.val_hi - ts.val_lo >= 2 && (d.buf[ts.val_lo] & 255) == 91 && (d.buf[ts.val_hi - 1] & 255) == 93 {
            << d.parse_compact_array(parent, no, depth, ts.tag_lo, ts.tag_hi, ts.val_lo + 1, ts.val_hi - 1, true)
        }
    }
    n := d.parse_scalar_span(no, t.lo, t.hi)
    d.attach(parent, n)
    << n
}

fn (d $&Doc) try_consume_end(indent int, exp_klo int, exp_khi int) bool {
    d.skip_blanks()
    if d.err.len > 0 || d.i >= d.line_starts.len {
        << false
    }
    line_lo := d.line_starts[d.i]
    line_hi := d.line_ends[d.i]
    no := d.i + 1
    rt_hi := rtrim_end(&d.buf, line_lo, line_hi)
    sp := d.leading_span(line_lo, rt_hi, no)
    if d.err.len > 0 || sp != indent {
        << false
    }
    after_lo := line_lo + sp
    rest_hi := strip_comment_end(&d.buf, after_lo, rt_hi)
    end_lit := "end"
    if span_eq_str(&d.buf, after_lo, rest_hi, &end_lit) {
        d.i += 1
        << true
    }
    end_pre := "end "
    if span_has_prefix(&d.buf, after_lo, rest_hi, &end_pre) {
        ek := trim_span(&d.buf, after_lo + 4, rest_hi)
        if ek.lo >= ek.hi {
            << false
        }
        if exp_klo < exp_khi && !span_eq(&d.buf, ek.lo, ek.hi, exp_klo, exp_khi) {
            d.fail(no, "end-key mismatch: expected '" + d.buf[exp_klo:exp_khi] + "', got '" + d.buf[ek.lo:ek.hi] + "'")
            << false
        }
        d.i += 1
        << true
    }
    << false
}

fn (d $&Doc) next_struct(indent int, cur_klo int, cur_khi int) int {
    d.skip_blanks()
    if d.err.len > 0 {
        << -1
    }
    if d.i >= d.line_starts.len {
        << 0
    }
    line_lo := d.line_starts[d.i]
    line_hi := d.line_ends[d.i]
    no := d.i + 1
    rt_hi := rtrim_end(&d.buf, line_lo, line_hi)
    sp := d.leading_span(line_lo, rt_hi, no)
    if d.err.len > 0 {
        << -1
    }
    if sp < indent {
        << 0
    }
    if sp > indent {
        d.fail(no, "unexpected indent")
        << -1
    }
    after_lo := line_lo + sp
    rest_hi := strip_comment_end(&d.buf, after_lo, rt_hi)
    rest_len := rest_hi - after_lo

    // RFC-0001: explicit 'end' or 'end <key>' block delimiter
    end_lit := "end"
    if span_eq_str(&d.buf, after_lo, rest_hi, &end_lit) {
        d.i += 1
        << 0
    }
    end_pre := "end "
    if span_has_prefix(&d.buf, after_lo, rest_hi, &end_pre) {
        ek := trim_span(&d.buf, after_lo + 4, rest_hi)
        if ek.lo < ek.hi {
            if cur_klo < cur_khi && !span_eq(&d.buf, ek.lo, ek.hi, cur_klo, cur_khi) {
                d.fail(no, "end-key mismatch: expected '" + d.buf[cur_klo:cur_khi] + "', got '" + d.buf[ek.lo:ek.hi] + "'")
                << -1
            }
            if cur_klo >= cur_khi {
                d.fail(no, "unexpected 'end " + d.buf[ek.lo:ek.hi] + "'")
                << -1
            }
        }
        d.i += 1
        << 0
    }

    if rest_len == 1 && (d.buf[after_lo] & 255) == 45 { // '-'
        d.tok_kind = 2
        d.tok_no = no
        d.tok_klo = 0
        d.tok_khi = 0
        d.tok_khash = 0
        d.tok_vlo = 0
        d.tok_vhi = 0
        << 2
    }
    if rest_len >= 2 && (d.buf[after_lo] & 255) == 45 && (d.buf[after_lo + 1] & 255) == 32 { // '- '
        d.tok_kind = 2
        d.tok_no = no
        d.tok_klo = 0
        d.tok_khi = 0
        d.tok_khash = 0
        d.tok_vlo = after_lo + 2
        d.tok_vhi = rest_hi
        << 2
    }
    kv := d.split_key_span(after_lo, rest_hi, no)
    if d.err.len > 0 {
        << -1
    }
    d.tok_kind = 1
    d.tok_no = no
    d.tok_klo = kv.klo
    d.tok_khi = kv.khi
    d.tok_khash = hash_span(&d.buf, kv.klo, kv.khi)
    d.tok_vlo = kv.vlo
    d.tok_vhi = kv.vhi
    << 1
}

fn (d $&Doc) parse_dict(parent int, indent int, depth int, my_klo int, my_khi int) int {
    $no := 1
    if d.i < d.line_starts.len {
        no = d.i + 1
    }
    if !d.nesting_ok(no, depth) {
        << -1
    }
    me := d.new_node_span(KIND_DICT, 0, 0, 0, 0, 0, 0, 0)
    if parent >= 0 {
        d.attach(parent, me)
    }
    while true {
        k := d.next_struct(indent, my_klo, my_khi)
        if k <= 0 {
            <-
        }
        if k == 2 {
            d.fail(d.tok_no, "cannot mix list items into a dictionary")
            <-
        }
        klo := d.tok_klo
        khi := d.tok_khi
        khash := d.tok_khash
        vlo := d.tok_vlo
        vhi := d.tok_vhi
        line_no := d.tok_no
        if d.has_child_key_span(me, klo, khi, khash) {
            d.fail(line_no, "duplicate key '" + d.buf[klo:khi] + "'")
            <-
        }
        d.i += 1
        child := d.parse_rhs(me, line_no, indent, depth + 1, vlo, vhi, klo, khi)
        if d.err.len > 0 {
            <-
        }
        d.set_key_span(child, klo, khi, khash)
    }
    << me
}

fn (d $&Doc) parse_inline_dict_entry(parent int, first_lo int, first_hi int, key_indent int, first_no int, depth int) int {
    if !d.nesting_ok(first_no, depth) {
        << -1
    }
    me := d.new_node_span(KIND_DICT, 0, 0, 0, 0, 0, 0, 0)
    if parent >= 0 {
        d.attach(parent, me)
    }
    kv0 := d.split_key_span(first_lo, first_hi, first_no)
    if d.err.len > 0 {
        << -1
    }
    c0 := d.parse_rhs(me, first_no, key_indent, depth + 1, kv0.vlo, kv0.vhi, kv0.klo, kv0.khi)
    if d.err.len > 0 {
        << -1
    }
    d.set_key_span(c0, kv0.klo, kv0.khi, hash_span(&d.buf, kv0.klo, kv0.khi))
    while true {
        d.skip_blanks()
        if d.err.len > 0 || d.i >= d.line_starts.len {
            <-
        }
        line_lo := d.line_starts[d.i]
        line_hi := d.line_ends[d.i]
        no := d.i + 1
        rt_hi := rtrim_end(&d.buf, line_lo, line_hi)
        sp := d.leading_span(line_lo, rt_hi, no)
        if d.err.len > 0 || sp < key_indent {
            <-
        }
        if sp > key_indent {
            d.fail(no, "invalid indent jump")
            <-
        }
        after_lo := line_lo + sp
        rest_hi := strip_comment_end(&d.buf, after_lo, rt_hi)
        rest_len := rest_hi - after_lo
        if (rest_len == 1 && (d.buf[after_lo] & 255) == 45) || (rest_len >= 2 && (d.buf[after_lo] & 255) == 45 && (d.buf[after_lo + 1] & 255) == 32) {
            <-
        }
        kv := d.split_key_span(after_lo, rest_hi, no)
        if d.err.len > 0 {
            <-
        }
        kh := hash_span(&d.buf, kv.klo, kv.khi)
        if d.has_child_key_span(me, kv.klo, kv.khi, kh) {
            d.fail(no, "duplicate key '" + d.buf[kv.klo:kv.khi] + "'")
            <-
        }
        d.i += 1
        ch := d.parse_rhs(me, no, key_indent, depth + 1, kv.vlo, kv.vhi, kv.klo, kv.khi)
        if d.err.len > 0 {
            <-
        }
        d.set_key_span(ch, kv.klo, kv.khi, kh)
    }
    << me
}

fn (d $&Doc) parse_list(parent int, indent int, depth int, my_klo int, my_khi int, item_tlo int, item_thi int) int {
    $no := 1
    if d.i < d.line_starts.len {
        no = d.i + 1
    }
    if !d.nesting_ok(no, depth) {
        << -1
    }
    me := d.new_node_span(KIND_LIST, item_tlo, item_thi, 0, 0, 0, 0, 0)
    if parent >= 0 {
        d.attach(parent, me)
    }
    while true {
        k := d.next_struct(indent, my_klo, my_khi)
        if k <= 0 {
            <-
        }
        if k == 1 {
            d.fail(d.tok_no, "cannot mix dictionary keys into a list")
            <-
        }
        vlo := d.tok_vlo
        vhi := d.tok_vhi
        line_no := d.tok_no
        d.i += 1
        trimmed := trim_span(&d.buf, vlo, vhi)
        is_braced := trimmed.hi - trimmed.lo >= 2 && (d.buf[trimmed.lo] & 255) == 123 && (d.buf[trimmed.hi - 1] & 255) == 125
        if !is_braced && looks_like_dict_entry_span(&d.buf, trimmed.lo, trimmed.hi) {
            if item_thi > item_tlo {
                d.fail(line_no, "typed lists allow only scalar elements")
                <-
            }
            d.parse_inline_dict_entry(me, trimmed.lo, trimmed.hi, indent + 2, line_no, depth + 1)
            if d.err.len > 0 {
                <-
            }
            ->
        }
        child := d.parse_rhs(me, line_no, indent, depth + 1, vlo, vhi, 0, 0)
        if d.err.len > 0 {
            <-
        }
        if item_thi > item_tlo {
            if !d.is_scalar(child) {
                d.fail(line_no, "typed lists allow only scalar elements")
                <-
            }
            d.validate_tag_span(line_no, item_tlo, item_thi, d.text_lo[child], d.text_hi[child])
            if d.err.len > 0 {
                <-
            }
            d.set_tag_span(child, item_tlo, item_thi)
        }
    }
    << me
}

fn (d $&Doc) peek_child(child_indent int) int {
    $j := d.i
    while j < d.line_starts.len {
        line_lo := d.line_starts[j]
        line_hi := d.line_ends[j]
        n := j + 1
        rt_hi := rtrim_end(&d.buf, line_lo, line_hi)
        if rt_hi == line_lo || is_comment_span(&d.buf, line_lo, rt_hi) {
            j += 1
        } else {
            sp := d.leading_span(line_lo, rt_hi, n)
            if d.err.len > 0 {
                << -1
            }
            if sp < child_indent {
                << 0
            }
            if sp > child_indent {
                d.fail(n, "skipped indent level")
                << -1
            }
            after_lo := line_lo + sp
            rest_hi := strip_comment_end(&d.buf, after_lo, rt_hi)
            rest_len := rest_hi - after_lo
            if (rest_len == 1 && (d.buf[after_lo] & 255) == 45) || (rest_len >= 2 && (d.buf[after_lo] & 255) == 45 && (d.buf[after_lo + 1] & 255) == 32) {
                << 1
            }
            << 2
        }
    }
    << 0
}

fn (d $&Doc) parse_rhs(parent int, no int, parent_indent int, depth int, vlo int, vhi int, klo int, khi int) int {
    child_indent := parent_indent + 2
    src := trim_span(&d.buf, vlo, vhi)
    if src.lo >= src.hi {
        ch := d.peek_child(child_indent)
        if d.err.len > 0 {
            << -1
        }
        if ch == 0 {
            n0 := d.new_node_span(KIND_SCALAR, 0, 0, 0, 0, 0, 0, 0)
            d.attach(parent, n0)
            << n0
        }
        if ch == 1 {
            res := d.parse_list(parent, child_indent, depth, klo, khi, 0, 0)
            if d.err.len == 0 {
                d.try_consume_end(parent_indent, klo, khi)
            }
            << res
        }
        if ch == 2 {
            res := d.parse_dict(parent, child_indent, depth, klo, khi)
            if d.err.len == 0 {
                d.try_consume_end(parent_indent, klo, khi)
            }
            << res
        }
        n0 := d.new_node_span(KIND_SCALAR, 0, 0, 0, 0, 0, 0, 0)
        d.attach(parent, n0)
        << n0
    }
    slen := src.hi - src.lo
    b0 := d.buf[src.lo] & 255
    blast := d.buf[src.hi - 1] & 255
    // RFC-0002: inline object literal {k: v, ...}
    if slen >= 2 && b0 == 123 && blast == 125 {
        << d.parse_inline_dict(parent, no, depth, src.lo, src.hi)
    }
    // RFC-0002: inline array literal [...]
    if slen >= 2 && b0 == 91 && blast == 93 {
        << d.parse_inline_list(parent, no, depth, src.lo, src.hi)
    }
    // Untyped multiline block | / |- / |+ / |IDENT
    if b0 == 124 {
        op := match_ml_closer_span(&d.buf, src.lo, src.hi)
        if op.chi > op.clo {
            << d.read_multiline_body(parent, no, parent_indent, 0, 0, op.chomp, op.clo, op.chi)
        }
    }
    // Tagged value / tagged multiline / typed block list / compact array
    if b0 == 33 { // '!'
        ts := split_tag_span(&d.buf, src.lo + 1, src.hi)
        if ts.tag_lo >= ts.tag_hi {
            d.fail(no, "invalid type tag")
            << -1
        }
        // Check tagged multiline: !tag |...
        if ts.has_space && ts.val_lo < ts.val_hi && (d.buf[ts.val_lo] & 255) == 124 {
            op2 := match_ml_closer_span(&d.buf, ts.val_lo, ts.val_hi)
            if op2.chi > op2.clo {
                << d.read_multiline_body(parent, no, parent_indent, ts.tag_lo, ts.tag_hi, op2.chomp, op2.clo, op2.chi)
            }
        }
        // Check typed block list or compact array: !tag[...] or !tag []
        if ts.val_hi - ts.val_lo >= 2 && (d.buf[ts.val_lo] & 255) == 91 && (d.buf[ts.val_hi - 1] & 255) == 93 {
            inner := trim_span(&d.buf, ts.val_lo + 1, ts.val_hi - 1)
            if inner.lo >= inner.hi {
                // Typed block list (empty [] or with block children below)
                if !d.nesting_ok(no, depth) {
                    << -1
                }
                ch2 := d.peek_child(child_indent)
                if d.err.len > 0 {
                    << -1
                }
                $lt_lo := ts.tag_lo
                $lt_thi := ts.tag_hi
                if is_tag_s_span(&d.buf, lt_lo, lt_thi) {
                    lt_lo = 0
                    lt_thi = 0
                }
                if ch2 == 0 {
                    // For !s[] empty inline/list, keep empty tag
                    nl := d.new_node_span(KIND_LIST, lt_lo, lt_thi, 0, 0, 0, 0, 0)
                    d.attach(parent, nl)
                    d.try_consume_end(parent_indent, klo, khi)
                    << nl
                }
                if ch2 == 1 {
                    res := d.parse_list(parent, child_indent, depth, klo, khi, ts.tag_lo, ts.tag_hi)
                    if d.err.len == 0 {
                        d.try_consume_end(parent_indent, klo, khi)
                    }
                    << res
                }
                if ch2 == 2 {
                    d.fail(no, "'" + d.buf[src.lo:src.hi] + "' cannot have dictionary children")
                    << -1
                }
                nl := d.new_node_span(KIND_LIST, lt_lo, lt_thi, 0, 0, 0, 0, 0)
                d.attach(parent, nl)
                << nl
            }
            if !ts.has_space {
                << d.parse_compact_array(parent, no, depth, ts.tag_lo, ts.tag_hi, ts.val_lo + 1, ts.val_hi - 1, false)
            }
        }
        // Tagged scalar
        if !ts.has_space {
            if ts.val_lo >= ts.val_hi {
                d.fail(no, "missing value for !" + d.buf[ts.tag_lo:ts.tag_hi])
            } else {
                d.fail(no, "expected space after type tag")
            }
            << -1
        }
        if is_tag_s_span(&d.buf, ts.tag_lo, ts.tag_hi) {
            $xlo := ts.val_lo
            $xhi := ts.val_hi
            if xlo < xhi && (d.buf[xlo] & 255) == 34 {
                sp := d.parse_quoted_value_span(no, xlo, xhi)
                if d.err.len > 0 {
                    << -1
                }
                xlo = sp.lo
                xhi = sp.hi
            }
            sn := d.new_node_span(KIND_SCALAR, 0, 0, xlo, xhi, 0, 0, 0)
            d.attach(parent, sn)
            << sn
        }
        d.validate_tag_span(no, ts.tag_lo, ts.tag_hi, ts.val_lo, ts.val_hi)
        if d.err.len > 0 {
            << -1
        }
        sn := d.new_node_span(KIND_SCALAR, ts.tag_lo, ts.tag_hi, ts.val_lo, ts.val_hi, 0, 0, 0)
        d.attach(parent, sn)
        << sn
    }
    if b0 == 34 { // '"'
        sp2 := d.parse_quoted_value_span(no, src.lo, src.hi)
        if d.err.len > 0 {
            << -1
        }
        n2 := d.new_node_span(KIND_SCALAR, 0, 0, sp2.lo, sp2.hi, 0, 0, 0)
        d.attach(parent, n2)
        << n2
    }
    n := d.new_node_span(KIND_SCALAR, 0, 0, src.lo, src.hi, 0, 0, 0)
    d.attach(parent, n)
    << n
}

struct TagSplitSpan {
    tag_lo    int
    tag_hi    int
    val_lo    int
    val_hi    int
    has_space bool
}

fn split_tag_span(s &string, lo int, hi int) TagSplitSpan {
    $i := lo
    while i < hi {
        c := s[i] & 255
        if is_alphanumeric(c) {
            i += 1
        } else {
            <-
        }
    }
    $vlo := i
    $has_sp := false
    if vlo < hi && (s[vlo] & 255) == 32 {
        vlo += 1
        has_sp = true
    }
    << TagSplitSpan{tag_lo: lo, tag_hi: i, val_lo: vlo, val_hi: hi, has_space: has_sp}
}
