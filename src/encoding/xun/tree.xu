@encoding/xun

struct Kv {
    key string
    val string
}

fn (d $&Doc) split_key(rest string, no int) Kv {
    src := rest + ""
    $cs := -1
    lim := src.len - 1
    if lim >= 1 {
        $in_quote := false
        $escape := false
        for i in 0:lim {
            b := src[i] & 255
            if escape {
                escape = false
            } else {
                if b == 92 { // '\'
                    escape = true
                } else {
                    if b == 34 { // '"'
                        in_quote = !in_quote
                    } else {
                        if !in_quote && cs < 0 && b == 58 && (src[i + 1] & 255) == 32 { // ': '
                            cs = i
                        }
                    }
                }
            }
        }
    }
    if cs >= 0 {
        $key := src[0:cs]
        val := src[cs + 2:src.len]
        if key.len >= 2 && (key[0] & 255) == 34 && (key[key.len - 1] & 255) == 34 {
            key = unquote_str(&key)
        }
        if key.len == 0 {
            d.fail(no, "empty key")
            << Kv{key: "", val: ""}
        }
        << Kv{key: key, val: val}
    }
    if src.len > 0 && (src[src.len - 1] & 255) == 58 { // ends with ':'
        $key2 := src[0:src.len - 1]
        if key2.len >= 2 && (key2[0] & 255) == 34 && (key2[key2.len - 1] & 255) == 34 {
            key2 = unquote_str(&key2)
        }
        if key2.len == 0 {
            d.fail(no, "empty key")
            << Kv{key: "", val: ""}
        }
        << Kv{key: key2, val: ""}
    }
    d.fail(no, "expected ': ' or a trailing ':'")
    << Kv{key: "", val: ""}
}

fn split_top_level_commas(s string) []string {
    $out := []string{}
    $start := 0
    $in_quote := false
    $escape := false
    $depth_brace := 0
    $depth_bracket := 0
    for i in 0:s.len {
        b := s[i] & 255
        if escape {
            escape = false
        } else {
            if b == 92 { // '\'
                escape = true
            } else {
                if b == 34 { // '"'
                    in_quote = !in_quote
                } else {
                    if !in_quote {
                        if b == 123 { // '{'
                            depth_brace += 1
                        } else {
                            if b == 125 { // '}'
                                if depth_brace > 0 {
                                    depth_brace -= 1
                                }
                            } else {
                                if b == 91 { // '['
                                    depth_bracket += 1
                                } else {
                                    if b == 93 { // ']'
                                        if depth_bracket > 0 {
                                            depth_bracket -= 1
                                        }
                                    } else {
                                        if b == 44 && depth_brace == 0 && depth_bracket == 0 { // ','
                                            out.push(s[start:i])
                                            start = i + 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if start <= s.len {
        out.push(s[start:s.len])
    }
    << out
}

fn (d $&Doc) parse_inline_dict(parent int, no int, text string) int {
    t := trim_spaces(text)
    if t.len < 2 || (t[0] & 255) != 123 || (t[t.len - 1] & 255) != 125 { // '{' and '}'
        d.fail(no, "inline object must be wrapped in '{...}'")
        << -1
    }
    inner := trim_spaces(t[1:t.len - 1])
    me := d.new_node(KIND_DICT, "", "", "")
    if parent >= 0 {
        d.attach(parent, me)
    }
    if inner.len == 0 {
        << me
    }
    pieces := split_top_level_commas(inner)
    for p in pieces {
        piece := trim_spaces(p)
        if piece.len > 0 {
            kv := d.split_key(piece, no)
            if d.err.len > 0 {
                << -1
            }
            // Check duplicate key
            for i in 0:d.count(me) {
                child0 := d.at(me, i)
                if child0 >= 0 && d.key(child0) == kv.key {
                    d.fail(no, "duplicate key '" + kv.key + "'")
                    << -1
                }
            }
            child := d.parse_inline_value(me, no, kv.val)
            if d.err.len > 0 {
                << -1
            }
            if child >= 0 && child < d.keys.len {
                d.keys[child] = kv.key + ""
            }
        }
    }
    << me
}

fn (d $&Doc) parse_inline_list(parent int, no int, text string) int {
    t := trim_spaces(text)
    if t.len < 2 || (t[0] & 255) != 91 || (t[t.len - 1] & 255) != 93 { // '[' and ']'
        d.fail(no, "inline array must be wrapped in '[...]'")
        << -1
    }
    inner := trim_spaces(t[1:t.len - 1])
    me := d.new_node(KIND_LIST, "", "", "")
    if parent >= 0 {
        d.attach(parent, me)
    }
    if inner.len == 0 {
        << me
    }
    pieces := split_top_level_commas(inner)
    for p in pieces {
        piece := trim_spaces(p)
        if piece.len > 0 {
            d.parse_inline_value(me, no, piece)
            if d.err.len > 0 {
                << -1
            }
        }
    }
    << me
}

fn (d $&Doc) parse_inline_value(parent int, no int, text string) int {
    t := trim_spaces(text)
    if t.len >= 2 && (t[0] & 255) == 123 && (t[t.len - 1] & 255) == 125 { // '{...}'
        << d.parse_inline_dict(parent, no, t)
    }
    if t.len >= 2 && (t[0] & 255) == 91 && (t[t.len - 1] & 255) == 93 { // '[...]'
        << d.parse_inline_list(parent, no, t)
    }
    ca := d.try_compact(no, t + "")
    if ca.kind >= 0 {
        d.attach(parent, ca.node)
        << ca.node
    }
    n := d.parse_scalar(no, t + "")
    d.attach(parent, n)
    << n
}

fn (d $&Doc) try_consume_end(indent int, expected_key string) bool {
    d.skip_blanks()
    if d.err.len > 0 || d.i >= d.lines.len {
        << false
    }
    line := d.lines[d.i] + ""
    no := d.nos[d.i]
    t := rtrim(&line)
    sp := d.leading(&t, no)
    if d.err.len > 0 || sp != indent {
        << false
    }
    rest := t[sp:t.len]
    if rest == "end" {
        d.i += 1
        << true
    }
    if has_prefix(&rest, "end ") {
        end_key := trim_spaces(rest[4:rest.len])
        if end_key.len == 0 {
            << false
        }
        if expected_key.len > 0 && end_key != expected_key {
            d.fail(no, "end-key mismatch: expected '" + expected_key + "', got '" + end_key + "'")
            << false
        }
        d.i += 1
        << true
    }
    << false
}

fn (d $&Doc) next_struct(indent int, current_key string) int {
    d.skip_blanks()
    if d.err.len > 0 {
        << -1
    }
    if d.i >= d.lines.len {
        << 0
    }
    line := d.lines[d.i] + ""
    no := d.nos[d.i]
    t := rtrim(&line)
    sp := d.leading(&t, no)
    if d.err.len > 0 {
        << -1
    }
    if sp < indent {
        << 0
    }
    if sp > indent {
        d.fail(no, "unexpected indent")
        << -1
    }
    rest := t[sp:t.len]

    // RFC-0001: explicit 'end' or 'end <key>' block delimiter
    if rest == "end" {
        d.i += 1
        << 0
    }
    if has_prefix(&rest, "end ") {
        end_key := trim_spaces(rest[4:rest.len])
        if end_key.len > 0 {
            if current_key.len > 0 && end_key != current_key {
                d.fail(no, "end-key mismatch: expected '" + current_key + "', got '" + end_key + "'")
                << -1
            }
            if current_key.len == 0 {
                d.fail(no, "unexpected 'end " + end_key + "'")
                << -1
            }
        }
        d.i += 1
        << 0
    }

    dash := "- "
    if rest == "-" {
        d.tok_kind = 2
        d.tok_no = no
        d.tok_key = ""
        d.tok_inline = ""
        << 2
    }
    if has_prefix(&rest, dash) {
        d.tok_kind = 2
        d.tok_no = no
        d.tok_key = ""
        d.tok_inline = rest[2:rest.len]
        << 2
    }
    kv := d.split_key(rest, no)
    if d.err.len > 0 {
        << -1
    }
    d.tok_kind = 1
    d.tok_no = no
    d.tok_key = kv.key + ""
    d.tok_inline = kv.val + ""
    << 1
}

fn (d $&Doc) parse_dict(parent int, indent int, depth int, my_key string) int {
    if depth > MAX_DEPTH {
        $no := 1
        if d.i < d.nos.len {
            no = d.nos[d.i]
        }
        d.fail(no, "too much nesting")
        << -1
    }
    me := d.new_node(KIND_DICT, "", "", "")
    if parent >= 0 {
        d.attach(parent, me)
    }
    $done := 0
    while done == 0 {
        k := d.next_struct(indent, my_key)
        if k <= 0 {
            done = 1
        } else {
            if k == 2 {
                d.fail(d.tok_no, "cannot mix list items into a dictionary")
                done = 1
            } else {
                key := d.tok_key + ""
                inline := d.tok_inline + ""
                no := d.tok_no
                $dup := 0
                for i in 0:d.count(me) {
                    child0 := d.at(me, i)
                    if child0 >= 0 && d.key(child0) == key {
                        dup = 1
                    }
                }
                if dup == 1 {
                    d.fail(no, "duplicate key '" + key + "'")
                    done = 1
                } else {
                    d.i += 1
                    child := d.parse_rhs(me, no, indent, inline + "", key)
                    if d.err.len > 0 {
                        done = 1
                    } else {
                        if child >= 0 && child < d.keys.len {
                            d.keys[child] = key + ""
                        }
                    }
                }
            }
        }
    }
    << me
}

fn (d $&Doc) parse_list(parent int, indent int, depth int, my_key string) int {
    if depth > MAX_DEPTH {
        $no := 1
        if d.i < d.nos.len {
            no = d.nos[d.i]
        }
        d.fail(no, "too much nesting")
        << -1
    }
    me := d.new_node(KIND_LIST, "", "", "")
    if parent >= 0 {
        d.attach(parent, me)
    }
    $done := 0
    while done == 0 {
        k := d.next_struct(indent, my_key)
        if k <= 0 {
            done = 1
        } else {
            if k == 1 {
                d.fail(d.tok_no, "cannot mix dictionary keys into a list")
                done = 1
            } else {
                inline := d.tok_inline + ""
                no := d.tok_no
                d.i += 1
                child := d.parse_rhs(me, no, indent, inline + "", "")
                if d.err.len > 0 {
                    done = 1
                }
            }
        }
    }
    << me
}

fn (d $&Doc) peek_child(child_indent int) int {
    $j := d.i
    while j < d.lines.len {
        line := d.lines[j] + ""
        n := d.nos[j]
        t := rtrim(&line)
        if t.len == 0 {
            j += 1
        } else {
            if is_comment(&t) {
                j += 1
            } else {
                sp := d.leading(&t, n)
                if d.err.len > 0 {
                    << -1
                }
                if sp < child_indent {
                    << 0
                }
                if sp > child_indent {
                    d.fail(n, "skipped indent level")
                    << -1
                }
                rest := t[sp:t.len]
                dash := "- "
                if rest == "-" || has_prefix(&rest, dash) {
                    << 1
                }
                << 2
            }
        }
    }
    << 0
}

fn (d $&Doc) parse_rhs(parent int, no int, parent_indent int, inline string, key string) int {
    child := parent_indent + 2
    src := trim_spaces(inline)
    if src.len == 0 {
        ch := d.peek_child(child)
        if ch == 0 {
            n0 := d.new_node(KIND_SCALAR, "", "", "")
            d.attach(parent, n0)
            << n0
        }
        if ch == 1 {
            res := d.parse_list(parent, child, 1, key)
            d.try_consume_end(parent_indent, key)
            << res
        }
        if ch == 2 {
            res := d.parse_dict(parent, child, 1, key)
            d.try_consume_end(parent_indent, key)
            << res
        }
        n0 := d.new_node(KIND_SCALAR, "", "", "")
        d.attach(parent, n0)
        << n0
    }
    if src == "{}" {
        n := d.new_node(KIND_DICT, "", "", "")
        d.attach(parent, n)
        << n
    }
    if src == "[]" {
        n := d.new_node(KIND_LIST, "", "", "")
        d.attach(parent, n)
        << n
    }
    // RFC-0002: inline object literal {k: v, ...}
    if src.len >= 2 && (src[0] & 255) == 123 && (src[src.len - 1] & 255) == 125 {
        << d.parse_inline_dict(parent, no, src)
    }
    // RFC-0002: inline array literal [...]
    if src.len >= 2 && (src[0] & 255) == 91 && (src[src.len - 1] & 255) == 93 {
        << d.parse_inline_list(parent, no, src)
    }
    ml := d.try_multiline(no, parent_indent, src + "")
    if ml.kind >= 0 {
        n := d.new_node(KIND_SCALAR, ml.tag, ml.text, "")
        d.attach(parent, n)
        << n
    }
    ca := d.try_compact(no, src + "")
    if ca.kind >= 0 {
        d.attach(parent, ca.node)
        << ca.node
    }
    if is_typed_list(&src) {
        ch2 := d.peek_child(child)
        if ch2 == 0 {
            n := d.new_node(KIND_LIST, "", "", "")
            d.attach(parent, n)
            << n
        }
        if ch2 == 1 {
            << d.parse_list(parent, child, 1, key)
        }
        if ch2 == 2 {
            d.fail(no, "'" + src + "' cannot have dictionary children")
            << -1
        }
        n := d.new_node(KIND_LIST, "", "", "")
        d.attach(parent, n)
        << n
    }
    n := d.parse_scalar(no, src + "")
    d.attach(parent, n)
    << n
}

fn is_typed_list(inline &string) bool {
    if !has_prefix(inline, "!") {
        << false
    }
    src := inline + ""
    rest := src[1:src.len]
    ts := split_tag(rest)
    if ts.tag.len == 0 {
        << false
    }
    << ts.val == "[]"
}

struct TagSplit {
    tag string
    val string
}

fn split_tag(rest string) TagSplit {
    src := rest + ""
    $i := 0
    $done := 0
    while done == 0 {
        if i >= src.len {
            done = 1
        } else {
            c := src[i] & 255
            if is_alphanumeric(c) {
                i += 1
            } else {
                done = 1
            }
        }
    }
    tag := src[0:i]
    $val := src[i:src.len]
    if val.len > 0 && (val[0] & 255) == 32 {
        val = val[1:val.len]
    }
    << TagSplit{tag: tag, val: val}
}
