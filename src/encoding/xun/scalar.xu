@encoding/xun

fn is_tag_s_span(s &string, lo int, hi int) bool {
    << hi - lo == 1 && (s[lo] & 255) == 115
}

fn (d $&Doc) parse_compact_array(parent int, no int, depth int, tlo int, thi int, inner_lo int, inner_hi int, allow_str_compact bool) int {
    if !d.nesting_ok(no, depth) {
        << -1
    }
    trimmed := trim_span(&d.buf, inner_lo, inner_hi)
    is_s := is_tag_s_span(&d.buf, tlo, thi)
    if trimmed.lo >= trimmed.hi {
        $n_tlo := tlo
        $n_thi := thi
        if is_s {
            n_tlo = 0
            n_thi = 0
        }
        n := d.new_node_span(KIND_LIST, n_tlo, n_thi, 0, 0, 0, 0, 0)
        if parent >= 0 {
            d.attach(parent, n)
        }
        << n
    }
    if is_s && !allow_str_compact {
        d.fail(no, "string arrays cannot use compact form")
        << -1
    }
    $p_lo := []int{}
    $p_hi := []int{}
    split_top_level_commas_spans(&d.buf, inner_lo, inner_hi, $&p_lo, $&p_hi)
    $has_objects := false
    for idx in 0:p_lo.len {
        pt := trim_span(&d.buf, p_lo[idx], p_hi[idx])
        if pt.lo < pt.hi && (d.buf[pt.lo] & 255) == 123 { // '{'
            has_objects = true
            <-
        }
    }
    if has_objects {
        n_obj := d.new_node_span(KIND_LIST, 0, 0, 0, 0, 0, 0, 0)
        if parent >= 0 {
            d.attach(parent, n_obj)
        }
        for idx in 0:p_lo.len {
            pt := trim_span(&d.buf, p_lo[idx], p_hi[idx])
            if pt.lo >= pt.hi {
                d.fail(no, "empty compact-array element")
                << -1
            }
            if (d.buf[pt.lo] & 255) == 123 {
                d.parse_inline_dict(n_obj, no, depth + 1, pt.lo, pt.hi)
                if d.err.len > 0 {
                    << -1
                }
            } else {
                d.validate_tag_span(no, tlo, thi, pt.lo, pt.hi)
                if d.err.len > 0 {
                    << -1
                }
                $et_lo := tlo
                $et_hi := thi
                if is_s {
                    et_lo = 0
                    et_hi = 0
                }
                elem := d.new_node_span(KIND_SCALAR, et_lo, et_hi, pt.lo, pt.hi, 0, 0, 0)
                d.attach(n_obj, elem)
            }
        }
        << n_obj
    }
    for idx in inner_lo:inner_hi {
        if (d.buf[idx] & 255) == 91 {
            d.fail(no, "nested compact arrays are not allowed")
            << -1
        }
    }
    $lt_lo := tlo
    $lt_hi := thi
    if is_s {
        lt_lo = 0
        lt_hi = 0
    }
    n := d.new_node_span(KIND_LIST, lt_lo, lt_hi, 0, 0, 0, 0, 0)
    if parent >= 0 {
        d.attach(parent, n)
    }
    for idx in 0:p_lo.len {
        pt := trim_span(&d.buf, p_lo[idx], p_hi[idx])
        if pt.lo >= pt.hi {
            d.fail(no, "empty compact-array element")
            << -1
        }
        d.validate_tag_span(no, tlo, thi, pt.lo, pt.hi)
        if d.err.len > 0 {
            << -1
        }
        elem := d.new_node_span(KIND_SCALAR, lt_lo, lt_hi, pt.lo, pt.hi, 0, 0, 0)
        d.attach(n, elem)
    }
    << n
}

struct MlOpenSpan {
    chomp int // 0: default (exact), 1: strip (-), 2: clip (+)
    clo   int
    chi   int
}

fn match_ml_closer_span(s &string, lo int, hi int) MlOpenSpan {
    if lo >= hi || (s[lo] & 255) != 124 { // '|'
        << MlOpenSpan{chomp: 0, clo: 0, chi: 0}
    }
    n := hi - lo
    if n == 1 {
        << MlOpenSpan{chomp: 0, clo: lo, chi: lo + 1}
    }
    if n == 2 && (s[lo + 1] & 255) == 45 { // "|-"
        << MlOpenSpan{chomp: 1, clo: lo, chi: lo + 1}
    }
    if n == 2 && (s[lo + 1] & 255) == 43 { // "|+"
        << MlOpenSpan{chomp: 2, clo: lo, chi: lo + 1}
    }
    $chomp := 0
    $end := hi
    last := s[hi - 1] & 255
    if last == 45 { // '-'
        chomp = 1
        end -= 1
    } else {
        if last == 43 { // '+'
            chomp = 2
            end -= 1
        }
    }
    if end > lo + 1 && valid_tag_name_span(s, lo + 1, end) {
        << MlOpenSpan{chomp: chomp, clo: lo + 1, chi: end}
    }
    << MlOpenSpan{chomp: 0, clo: 0, chi: 0}
}

fn (d $&Doc) read_multiline_body(parent int, no int, parent_indent int, tlo int, thi int, chomp int, clo int, chi int) int {
    body_indent := parent_indent + 2
    $ml_lo := []int{}
    $ml_hi := []int{}
    $closed := false
    while d.i < d.line_starts.len {
        raw_lo := d.line_starts[d.i]
        raw_hi := d.line_ends[d.i]
        rt_hi := rtrim_end(&d.buf, raw_lo, raw_hi)
        if rt_hi == raw_lo {
            ml_lo.push(0)
            ml_hi.push(0)
            d.i += 1
            ->
        }
        n := d.i + 1
        $sp := 0
        while raw_lo + sp < rt_hi && (d.buf[raw_lo + sp] & 255) == 32 {
            sp += 1
        }
        if raw_lo + sp < rt_hi && (d.buf[raw_lo + sp] & 255) == 9 {
            d.fail(n, "tab indent is not allowed")
            << -1
        }
        if sp % 2 != 0 && sp < body_indent {
            d.fail(n, "indent must be a multiple of 2 spaces")
            << -1
        }
        after_lo := raw_lo + sp
        closer_hi := strip_comment_end(&d.buf, after_lo, rt_hi)
        if sp == parent_indent && span_eq(&d.buf, after_lo, closer_hi, clo, chi) {
            d.i += 1
            closed = true
            <-
        }
        if sp < body_indent {
            d.fail(n, "multiline body must indent +2, or close at opener indent")
            << -1
        }
        for ci in raw_lo:raw_hi {
            if (d.buf[ci] & 255) == 9 {
                d.fail(n, "tab is not allowed in multiline body")
                << -1
            }
        }
        ml_lo.push(raw_lo + body_indent)
        ml_hi.push(raw_hi)
        d.i += 1
    }
    if !closed {
        d.fail(no, "unclosed multiline block")
        << -1
    }
    $end := ml_lo.len
    if chomp == 1 {
        while end > 0 && ml_lo[end - 1] >= ml_hi[end - 1] {
            end -= 1
        }
    }
    $body := ""
    for i in 0:end {
        if i > 0 {
            body.push_byte(10)
        }
        llo := ml_lo[i]
        lhi := ml_hi[i]
        if lhi > llo {
            write_span($&body, &d.buf, llo, lhi)
        }
    }
    if chomp == 2 && body.len > 0 && (body[body.len - 1] & 255) != 10 {
        body.push_byte(10)
    }
    bs := d.intern_str(&body)
    $out_tlo := tlo
    $out_thi := thi
    if is_tag_s_span(&d.buf, out_tlo, out_thi) {
        out_tlo = 0
        out_thi = 0
    }
    if out_thi > out_tlo {
        d.validate_tag_span(no, out_tlo, out_thi, bs.lo, bs.hi)
        if d.err.len > 0 {
            << -1
        }
    }
    sn := d.new_node_span(KIND_SCALAR, out_tlo, out_thi, bs.lo, bs.hi, 0, 0, 0)
    d.attach(parent, sn)
    << sn
}

fn (d $&Doc) parse_quoted_value_span(no int, lo int, hi int) Span {
    qp := d.parse_quoted_prefix_span(no, lo, hi)
    if d.err.len > 0 {
        << Span{lo: 0, hi: 0}
    }
    if qp.end != hi {
        d.fail(no, "unexpected trailing content after quoted string")
        << Span{lo: 0, hi: 0}
    }
    << Span{lo: qp.klo, hi: qp.khi}
}

fn (d $&Doc) parse_scalar_span(no int, lo int, hi int) int {
    if lo < hi && (d.buf[lo] & 255) == 33 { // '!'
        ts := split_tag_span(&d.buf, lo + 1, hi)
        if ts.tag_lo >= ts.tag_hi {
            d.fail(no, "invalid type tag")
            << -1
        }
        if !ts.has_space {
            if ts.val_lo >= ts.val_hi {
                d.fail(no, "missing value for !" + d.buf[ts.tag_lo:ts.tag_hi])
            } else {
                d.fail(no, "expected space after type tag")
            }
            << -1
        }
        if is_tag_s_span(&d.buf, ts.tag_lo, ts.tag_hi) {
            $xlo := ts.val_lo
            $xhi := ts.val_hi
            if xlo < xhi && (d.buf[xlo] & 255) == 34 {
                sp := d.parse_quoted_value_span(no, xlo, xhi)
                if d.err.len > 0 {
                    << -1
                }
                xlo = sp.lo
                xhi = sp.hi
            }
            << d.new_node_span(KIND_SCALAR, 0, 0, xlo, xhi, 0, 0, 0)
        }
        d.validate_tag_span(no, ts.tag_lo, ts.tag_hi, ts.val_lo, ts.val_hi)
        if d.err.len > 0 {
            << -1
        }
        << d.new_node_span(KIND_SCALAR, ts.tag_lo, ts.tag_hi, ts.val_lo, ts.val_hi, 0, 0, 0)
    }
    if lo < hi && (d.buf[lo] & 255) == 34 {
        sp2 := d.parse_quoted_value_span(no, lo, hi)
        if d.err.len > 0 {
            << -1
        }
        << d.new_node_span(KIND_SCALAR, 0, 0, sp2.lo, sp2.hi, 0, 0, 0)
    }
    << d.new_node_span(KIND_SCALAR, 0, 0, lo, hi, 0, 0, 0)
}
