@encoding/xun

struct ArrNode {
    kind int
    tag  string
    text string
    node int
}

fn (d &mut Doc) try_compact(no int, inline string) ArrNode {
    miss := ArrNode{kind: -1, tag: "", text: "", node: -1}
    src := inline + ""
    if !has_prefix(&src, "!") {
        << miss
    }
    rest := src[1:src.len]
    ts := split_tag(rest)
    if ts.tag.len == 0 {
        << miss
    }
    if ts.tag == "s" {
        << miss
    }
    val := ts.val + ""
    if val.len < 2 || (val[0] & 255) != 91 || (val[val.len - 1] & 255) != 93 { // '[' and ']'
        << miss
    }
    inner := val[1:val.len - 1]
    tag := ts.tag + ""
    if inner.len == 0 {
        n := d.new_node(kind_list, "", "", "")
        << ArrNode{kind: kind_list, tag: "", text: "", node: n}
    }
    for i in 0:inner.len {
        if (inner[i] & 255) == 91 {
            d.fail(no, "nested compact arrays are not allowed")
            << miss
        }
    }
    n := d.new_node(kind_list, "", "", "")
    mut start := 0
    mut k := 0
    mut stopped := 0
    while stopped == 0 {
        if k > inner.len {
            stopped = 1
        } else {
            mut hit := 0
            if k == inner.len {
                hit = 1
            } else {
                if (inner[k] & 255) == 44 { // ','
                    hit = 1
                }
            }
            if hit == 1 {
                part := inner[start:k]
                piece := trim_spaces(part)
                if piece.len == 0 {
                    d.fail(no, "empty compact-array element")
                    << miss
                }
                d.validate_tag(no, tag + "", piece + "")
                if d.err.len > 0 {
                    << miss
                }
                elem := d.new_node(kind_scalar, tag + "", piece, "")
                d.attach(n, elem)
                start = k + 1
            }
            k += 1
        }
    }
    << ArrNode{kind: kind_list, tag: "", text: "", node: n}
}

fn trim_spaces(s string) string {
    src := s + ""
    mut i := 0
    mut j := src.len
    while i < j && (src[i] & 255) == 32 {
        i += 1
    }
    while j > i && (src[j - 1] & 255) == 32 {
        j -= 1
    }
    << src[i:j]
}

struct MlOpen {
    tag    string
    chomp  int // 0: default, 1: strip (-), 2: keep (+)
    closer string
}

fn multiline_opener(inline string) MlOpen {
    src := inline + ""
    none := MlOpen{tag: "", chomp: 0, closer: ""}
    if src == "|" {
        << MlOpen{tag: "", chomp: 0, closer: "|"}
    }
    if src == "|-" {
        << MlOpen{tag: "", chomp: 1, closer: "|"}
    }
    if src == "|+" {
        << MlOpen{tag: "", chomp: 2, closer: "|"}
    }
    if has_prefix(&src, "!") {
        rest := src[1:src.len]
        ts := split_tag(rest)
        if ts.tag.len > 0 {
            v := ts.val + ""
            if v == "|" {
                << MlOpen{tag: ts.tag, chomp: 0, closer: "|"}
            }
            if v == "|-" {
                << MlOpen{tag: ts.tag, chomp: 1, closer: "|"}
            }
            if v == "|+" {
                << MlOpen{tag: ts.tag, chomp: 2, closer: "|"}
            }
        }
    }
    << none
}

fn (d &mut Doc) try_multiline(no int, parent_indent int, inline string) ArrNode {
    miss := ArrNode{kind: -1, tag: "", text: "", node: -1}
    op := multiline_opener(inline)
    if op.closer.len == 0 {
        << miss
    }
    body_indent := parent_indent + 2
    mut lines := []string{}
    mut closed := 0
    while closed == 0 {
        if d.i >= d.lines.len {
            closed = 1
        } else {
            raw := d.lines[d.i] + ""
            n := d.nos[d.i]
            sp := d.leading(&raw, n)
            if d.err.len > 0 {
                << miss
            }
            rt := rtrim(&raw)
            rest := rt[sp:rt.len]
            if sp == parent_indent && rest == "|" {
                d.i += 1
                closed = 1
            } else {
                if rt.len == 0 {
                    lines.push("")
                    d.i += 1
                } else {
                    if sp < body_indent {
                        closed = 1
                    } else {
                        piece := raw[body_indent:raw.len]
                        lines.push(piece)
                        d.i += 1
                    }
                }
            }
        }
    }
    mut end := lines.len
    if op.chomp == 1 {
        while end > 0 && lines[end - 1].len == 0 {
            end -= 1
        }
    }
    mut body := ""
    for i in 0:end {
        if i > 0 {
            body = body + "\n"
        }
        body = body + lines[i]
    }
    if op.chomp == 2 && body.len > 0 {
        body = body + "\n"
    }
    << ArrNode{kind: kind_scalar, tag: op.tag + "", text: body, node: -1}
}

fn (d &mut Doc) parse_quoted_value(no int, s &string) string {
    if s.len < 2 || (s[0] & 255) != 34 || (s[s.len - 1] & 255) != 34 {
        d.fail(no, "unclosed quoted string")
        << ""
    }
    inner := s[1:s.len - 1]
    mut out := ""
    mut i := 0
    while i < inner.len {
        b := inner[i] & 255
        if b == 92 { // '\'
            if i + 1 >= inner.len {
                d.fail(no, "unterminated escape sequence in quoted string")
                << ""
            }
            next := inner[i + 1] & 255
            if next == 34 { // '\"'
                out = out + "\""
                i += 2
            } else {
                if next == 92 { // '\\'
                    out = out + "\\"
                    i += 2
                } else {
                    if next == 110 { // '\n'
                        out = out + "\n"
                        i += 2
                    } else {
                        if next == 116 { // '\t'
                            out = out + "\t"
                            i += 2
                        } else {
                            if next == 114 { // '\r'
                                out = out + "\r"
                                i += 2
                            } else {
                                out = out + inner[i:i + 2]
                                i += 2
                            }
                        }
                    }
                }
            }
        } else {
            out = out + inner[i:i + 1]
            i += 1
        }
    }
    << out
}

fn (d &mut Doc) parse_scalar(no int, inline string) int {
    src := inline + ""
    if has_prefix(&src, "!") {
        rest := src[1:src.len]
        ts := split_tag(rest)
        tag := ts.tag + ""
        val := ts.val + ""
        mut text := val + ""
        if val.len >= 2 && (val[0] & 255) == 34 {
            text = d.parse_quoted_value(no, &val)
            if d.err.len > 0 {
                << -1
            }
        }
        if tag == "s" {
            << d.new_node(kind_scalar, "s", text, "")
        }
        d.validate_tag(no, tag + "", text + "")
        if d.err.len > 0 {
            << -1
        }
        << d.new_node(kind_scalar, tag, text, "")
    }
    if src.len >= 2 && (src[0] & 255) == 34 {
        text2 := d.parse_quoted_value(no, &src)
        if d.err.len > 0 {
            << -1
        }
        << d.new_node(kind_scalar, "", text2, "")
    }
    << d.new_node(kind_scalar, "", src, "")
}
