@encoding/xun

pub fn encode(d &Doc) string {
    << d.to_xun()
}

pub fn (d Doc) to_xun() string {
    if d.root_idx < 0 || d.kinds.len == 0 {
        << ""
    }
    << d.encode_node(d.root_idx, 0)
}

fn (d Doc) encode_node(n int, depth int) string {
    if n < 0 || n >= d.kinds.len {
        << ""
    }
    k := d.kinds[n]
    if k == KIND_DICT {
        << d.encode_dict(n, depth)
    }
    if k == KIND_LIST {
        << d.encode_list(n, depth)
    }
    if k == KIND_SCALAR {
        tag := d.tag(n)
        txt := d.text(n)
        if tag.len > 0 {
            << "!" + tag + " " + txt + "\n"
        }
        << txt + "\n"
    }
    << ""
}

fn (d Doc) encode_scalar_value(tag string, val string) string {
    $prefix := ""
    if tag.len > 0 {
        prefix = "!" + tag + " "
    } else {
        if looks_like_number(&val) || has_prefix(&val, "!") {
            prefix = "!s "
        }
    }
    if needs_quote(&val, true) {
        << prefix + quote_str(&val, true)
    }
    << prefix + val
}

fn split_lines_simple(s string) []string {
    $res := []string{}
    $start := 0
    for i in 0:s.len {
        b := s[i] & 255
        if b == 10 { // '\n'
            $end := i
            if end > start && (s[end - 1] & 255) == 13 { // '\r'
                end -= 1
            }
            res.push(s[start:end])
            start = i + 1
        }
    }
    res.push(s[start:s.len])
    << res
}

fn (d Doc) encode_dict(n int, depth int) string {
    cnt := d.count(n)
    if cnt == 0 && depth > 0 {
        << "{}\n"
    }
    $out := ""
    sp := indent_spaces(depth)
    for i in 0:cnt {
        c := d.at(n, i)
        if c >= 0 {
            raw_key := d.keys[c]
            $key := raw_key + ""
            if needs_quote(&raw_key, false) {
                key = quote_str(&raw_key, false)
            }
            ckind := d.kinds[c]
            if ckind == KIND_DICT {
                sub_cnt := d.count(c)
                if sub_cnt == 0 {
                    out = out + sp + key + ": {}\n"
                } else {
                    out = out + sp + key + ":\n" + d.encode_dict(c, depth + 1)
                }
            } else {
                if ckind == KIND_LIST {
                    out = out + d.encode_list_child(c, depth + 1, sp + key + ":")
                } else {
                    // Scalar
                    tag := d.tag(c)
                    val := d.text(c)
                    nl := "\n"
                    if str_contains(&val, &nl) {
                        if tag.len > 0 {
                            out = out + sp + key + ": !" + tag + " |\n"
                        } else {
                            out = out + sp + key + ": |\n"
                        }
                        sub_lines := split_lines_simple(val)
                        body_sp := indent_spaces(depth + 1)
                        for line in sub_lines {
                            out = out + body_sp + line + "\n"
                        }
                        out = out + sp + "|\n"
                    } else {
                        v := d.encode_scalar_value(tag, val)
                        out = out + sp + key + ": " + v + "\n"
                    }
                }
            }
        }
    }
    << out
}

fn (d Doc) encode_list(n int, depth int) string {
    cnt := d.count(n)
    item_tag := d.tag(n)
    $out := ""
    sp := indent_spaces(depth)
    for i in 0:cnt {
        c := d.at(n, i)
        if c >= 0 {
            ckind := d.kinds[c]
            if ckind == KIND_DICT {
                sub_cnt := d.count(c)
                if sub_cnt == 0 {
                    out = out + sp + "- {}\n"
                } else {
                    out = out + sp + "-\n" + d.encode_dict(c, depth + 1)
                }
            } else {
                if ckind == KIND_LIST {
                    out = out + d.encode_list_child(c, depth + 1, sp + "-")
                } else {
                    // Scalar
                    tag := d.tag(c)
                    val := d.text(c)
                    if item_tag.len > 0 {
                        // Quoted scalar escapes preserve commas, CR/LF and
                        // delimiter-looking strings without multiline ambiguity.
                        out = out + sp + "- " + d.encode_scalar_value(tag, val) + "\n"
                        ->
                    }
                    nl := "\n"
                    if str_contains(&val, &nl) {
                        if tag.len > 0 {
                            out = out + sp + "- !" + tag + " |\n"
                        } else {
                            out = out + sp + "- |\n"
                        }
                        sub_lines := split_lines_simple(val)
                        body_sp := indent_spaces(depth + 1)
                        for line in sub_lines {
                            out = out + body_sp + line + "\n"
                        }
                        out = out + sp + "|\n"
                    } else {
                        v := d.encode_scalar_value(tag, val)
                        out = out + sp + "- " + v + "\n"
                    }
                }
            }
        }
    }
    << out
}

// Return a compact spelling only for homogeneous scalar glyphs that cannot
// be split or reinterpreted. String lists retain the required block form.
fn (d Doc) encode_compact_list(n int) string {
    tag := d.tag(n)
    if tag.len == 0 {
        << ""
    }
    if d.firsts[n] < 0 {
        << "!" + tag + "[]"
    }
    if tag == "s" {
        << ""
    }
    $cur := d.firsts[n]
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 {
            <-
        }
        if cur >= d.kinds.len || d.kinds[cur] != KIND_SCALAR || d.tags[cur] != tag {
            << ""
        }
        text := d.text(cur)
        if text.len == 0 || needs_quote(&text, true) {
            << ""
        }
        for i in 0:text.len {
            b := text[i] & 255
            if b == 44 || b == 91 || b == 93 {
                << ""
            }
        }
        cur = d.nexts[cur]
    }
    if cur >= 0 {
        << ""
    }
    $out := "!" + tag + "["
    $sep := ""
    cur = d.firsts[n]
    for guard in 0:d.nexts.len + 1 {
        if cur < 0 {
            <-
        }
        out = out + sep + d.text(cur)
        sep = ", "
        cur = d.nexts[cur]
    }
    << out + "]"
}

fn (d Doc) encode_list_child(n int, depth int, head string) string {
    tag := d.tag(n)
    if tag.len > 0 {
        compact := d.encode_compact_list(n)
        if compact.len > 0 {
            << head + " " + compact + "\n"
        }
        << head + " !" + tag + "[]\n" + d.encode_list(n, depth)
    }
    if d.count(n) == 0 {
        << head + " []\n"
    }
    << head + "\n" + d.encode_list(n, depth)
}
