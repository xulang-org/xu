@encoding/xun

pub fn encode(d &Doc) string {
    << d.to_xun()
}

pub fn (d Doc) to_xun() string {
    if d.root_idx < 0 || d.kinds.len == 0 {
        << ""
    }
    $out := ""
    d.write_node($&out, d.root_idx, 0)
    << out
}

fn (d Doc) write_node(out $&string, n int, depth int) {
    if n < 0 || n >= d.kinds.len {
        <<
    }
    k := d.kinds[n]
    if k == KIND_DICT {
        d.write_dict(out, n, depth)
        <<
    }
    if k == KIND_LIST {
        d.write_list(out, n, depth)
        <<
    }
    if k == KIND_SCALAR {
        tlo := d.tag_lo[n]
        thi := d.tag_hi[n]
        xlo := d.text_lo[n]
        xhi := d.text_hi[n]
        if thi > tlo {
            out.push_byte(33) // '!'
            write_span(out, &d.buf, tlo, thi)
            out.push_byte(32) // ' '
        }
        write_span(out, &d.buf, xlo, xhi)
        out.push_byte(10)
    }
}

fn write_indent(out $&string, depth int) {
    if depth <= 0 {
        <<
    }
    if depth == 1 {
        out.push_str("  ")
        <<
    }
    if depth == 2 {
        out.push_str("    ")
        <<
    }
    if depth == 3 {
        out.push_str("      ")
        <<
    }
    if depth == 4 {
        out.push_str("        ")
        <<
    }
    if depth == 5 {
        out.push_str("          ")
        <<
    }
    if depth == 6 {
        out.push_str("            ")
        <<
    }
    sp := "                                                                                                                                "
    $need := depth * 2
    while need > 0 {
        $chunk := need
        if chunk > sp.len {
            chunk = sp.len
        }
        out.push_str(sp[0:chunk])
        need -= chunk
    }
}

fn write_scalar_span(out $&string, s &string, tlo int, thi int, xlo int, xhi int) {
    if thi > tlo {
        out.push_byte(33) // '!'
        write_span(out, s, tlo, thi)
        out.push_byte(32)
        write_span(out, s, xlo, xhi)
        <<
    }
    if xhi > xlo {
        b0 := s[xlo] & 255
        if b0 == 33 || b0 == 124 || looks_like_number_span(s, xlo, xhi) || (xhi - xlo == 2 && ((b0 == 91 && (s[xlo + 1] & 255) == 93) || (b0 == 123 && (s[xlo + 1] & 255) == 125))) {
            out.push_str("!s ")
        }
    }
    if needs_quote_span(s, xlo, xhi, true) {
        write_quoted_span(out, s, xlo, xhi)
    } else {
        write_span(out, s, xlo, xhi)
    }
}

fn write_multiline_span(out $&string, s &string, depth int, xlo int, xhi int) {
    $start := xlo
    for i in xlo:xhi {
        if (s[i] & 255) == 10 { // '\n'
            $end := i
            if end > start && (s[end - 1] & 255) == 13 { // '\r'
                end -= 1
            }
            write_indent(out, depth + 1)
            if end > start {
                write_span(out, s, start, end)
            }
            out.push_byte(10)
            start = i + 1
        }
    }
    $tail_end := xhi
    if tail_end > start && (s[tail_end - 1] & 255) == 13 {
        tail_end -= 1
    }
    write_indent(out, depth + 1)
    if tail_end > start {
        write_span(out, s, start, tail_end)
    }
    out.push_byte(10)
    write_indent(out, depth)
    out.push_str("|\n")
}

fn (d Doc) write_dict(out $&string, n int, depth int) {
    $cur := d.firsts[n]
    while cur >= 0 {
        write_indent(out, depth)
        klo := d.key_lo[cur]
        khi := d.key_hi[cur]
        if needs_quote_span(&d.buf, klo, khi, false) {
            write_quoted_span(out, &d.buf, klo, khi)
        } else {
            write_span(out, &d.buf, klo, khi)
        }
        out.push_byte(58) // ':'
        d.write_entry_value(out, cur, depth)
        cur = d.nexts[cur]
    }
}

fn (d Doc) write_entry_value(out $&string, c int, depth int) {
    ckind := d.kinds[c]
    if ckind == KIND_DICT {
        if d.firsts[c] < 0 {
            out.push_str(" {}\n")
        } else {
            out.push_byte(10)
            d.write_dict(out, c, depth + 1)
        }
        <<
    }
    if ckind == KIND_LIST {
        d.write_list_child(out, c, depth + 1)
        <<
    }
    tlo := d.tag_lo[c]
    thi := d.tag_hi[c]
    xlo := d.text_lo[c]
    xhi := d.text_hi[c]
    if has_newline_span(&d.buf, xlo, xhi) {
        if thi > tlo && !is_tag_s_span(&d.buf, tlo, thi) {
            out.push_str(" !")
            write_span(out, &d.buf, tlo, thi)
            out.push_str(" |\n")
        } else {
            out.push_str(" |\n")
        }
        write_multiline_span(out, &d.buf, depth, xlo, xhi)
        <<
    }
    if tlo >= thi && xlo >= xhi {
        out.push_byte(10)
        <<
    }
    out.push_byte(32)
    $eff_tlo := tlo
    $eff_thi := thi
    if is_tag_s_span(&d.buf, eff_tlo, eff_thi) {
        eff_tlo = 0
        eff_thi = 0
    }
    write_scalar_span(out, &d.buf, eff_tlo, eff_thi, xlo, xhi)
    out.push_byte(10)
}

fn (d Doc) write_list(out $&string, n int, depth int) {
    item_tlo := d.tag_lo[n]
    item_thi := d.tag_hi[n]
    $cur := d.firsts[n]
    while cur >= 0 {
        write_indent(out, depth)
        out.push_byte(45) // '-'
        if item_thi > item_tlo && d.kinds[cur] == KIND_SCALAR {
            tlo := d.tag_lo[cur]
            thi := d.tag_hi[cur]
            xlo := d.text_lo[cur]
            xhi := d.text_hi[cur]
            if has_newline_span(&d.buf, xlo, xhi) {
                out.push_str(" !")
                write_span(out, &d.buf, tlo, thi)
                out.push_str(" |\n")
                write_multiline_span(out, &d.buf, depth, xlo, xhi)
            } else {
                out.push_byte(32)
                write_scalar_span(out, &d.buf, tlo, thi, xlo, xhi)
                out.push_byte(10)
            }
        } else {
            d.write_entry_value(out, cur, depth)
        }
        cur = d.nexts[cur]
    }
}

fn (d Doc) can_encode_compact_list(n int, tlo int, thi int) bool {
    if tlo >= thi || is_tag_s_span(&d.buf, tlo, thi) || d.firsts[n] < 0 {
        << false
    }
    $cur := d.firsts[n]
    while cur >= 0 {
        if d.kinds[cur] != KIND_SCALAR || !span_eq(&d.buf, d.tag_lo[cur], d.tag_hi[cur], tlo, thi) {
            << false
        }
        xlo := d.text_lo[cur]
        xhi := d.text_hi[cur]
        if xlo >= xhi || has_newline_span(&d.buf, xlo, xhi) || needs_quote_span(&d.buf, xlo, xhi, true) {
            << false
        }
        for i in xlo:xhi {
            b := d.buf[i] & 255
            if b == 44 || b == 91 || b == 93 {
                << false
            }
        }
        cur = d.nexts[cur]
    }
    << true
}

fn (d Doc) write_list_child(out $&string, n int, depth int) {
    tlo := d.tag_lo[n]
    thi := d.tag_hi[n]
    if thi > tlo && d.firsts[n] < 0 {
        out.push_str(" !")
        write_span(out, &d.buf, tlo, thi)
        out.push_str("[]\n")
        <<
    }
    if thi > tlo && d.can_encode_compact_list(n, tlo, thi) {
        out.push_str(" !")
        write_span(out, &d.buf, tlo, thi)
        out.push_byte(91) // '['
        $cur := d.firsts[n]
        $first := true
        while cur >= 0 {
            if !first {
                out.push_str(", ")
            }
            first = false
            write_span(out, &d.buf, d.text_lo[cur], d.text_hi[cur])
            cur = d.nexts[cur]
        }
        out.push_str("]\n")
        <<
    }
    if thi > tlo {
        out.push_str(" !")
        write_span(out, &d.buf, tlo, thi)
        out.push_str("[]\n")
        d.write_list(out, n, depth)
        <<
    }
    if d.firsts[n] < 0 {
        out.push_str(" []\n")
        <<
    }
    out.push_byte(10)
    d.write_list(out, n, depth)
}
