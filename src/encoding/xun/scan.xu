@encoding/xun

fn has_nul(s &string) bool {
    for i in 0:s.len {
        if (s[i] & 255) == 0 {
            << true
        }
    }
    << false
}

fn strip_bom(s string) string {
    if s.len >= 3 {
        if (s[0] & 255) == 239 && (s[1] & 255) == 187 && (s[2] & 255) == 191 {
            << s[3:s.len]
        }
    }
    << s
}

fn (d $&Doc) split_lines(src string) {
    $start := 0
    $no := 1
    $i := 0
    while i < src.len {
        b := src[i] & 255
        if b == 10 { // LF
            d.lines.push(src[start:i])
            d.nos.push(no)
            no += 1
            i += 1
            start = i
        } else {
            if b == 13 { // CR
                d.lines.push(src[start:i])
                d.nos.push(no)
                no += 1
                i += 1
                if i < src.len && (src[i] & 255) == 10 {
                    i += 1
                }
                start = i
            } else {
                i += 1
            }
        }
    }
    if start < src.len {
        d.lines.push(src[start:src.len])
        d.nos.push(no)
    }
}

fn rtrim(s &string) string {
    src := s + ""
    $e := src.len
    $done := 0
    while done == 0 {
        if e == 0 {
            done = 1
        } else {
            b := src[e - 1] & 255
            if b == 32 || b == 9 {
                e -= 1
            } else {
                done = 1
            }
        }
    }
    << src[0:e]
}

fn has_prefix(s &string, pre string) bool {
    if pre.len > s.len {
        << false
    }
    for i in 0:pre.len {
        if s[i] != pre[i] {
            << false
        }
    }
    << true
}

fn is_comment(t &string) bool {
    $i := 0
    while i < t.len && (t[i] & 255) == 32 {
        i += 1
    }
    if i >= t.len {
        << false
    }
    << (t[i] & 255) == 35 // '#'
}

fn (d $&Doc) leading(t &string, no int) int {
    $n := 0
    $i := 0
    $done := 0
    while done == 0 {
        if i >= t.len {
            done = 1
        } else {
            b := t[i] & 255
            if b == 9 {
                d.fail(no, "tab indent is not allowed")
                << 0
            }
            if b == 32 {
                n += 1
                i += 1
            } else {
                done = 1
            }
        }
    }
    if n % 2 != 0 {
        d.fail(no, "indent must be a multiple of 2 spaces")
        << 0
    }
    << n
}

fn (d $&Doc) skip_blanks() {
    $done := 0
    while done == 0 {
        if d.i >= d.lines.len {
            done = 1
        } else {
            line := d.lines[d.i] + ""
            t := rtrim(&line)
            if t.len == 0 || is_comment(&t) {
                d.i += 1
            } else {
                done = 1
            }
        }
    }
}
