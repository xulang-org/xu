@encoding/xun

// Single-pass BOM skip, NUL check, strict UTF-8 validation (ASCII fast path), and line span index.
fn (d $&Doc) scan_lines() {
    n := d.buf.len
    $i := 0
    if n >= 3 && (d.buf[0] & 255) == 239 && (d.buf[1] & 255) == 187 && (d.buf[2] & 255) == 191 {
        i = 3
    }
    $start := i
    while i < n {
        b := d.buf[i] & 255
        if b < 128 {
            if b == 0 {
                d.fail(1, "NUL byte is not allowed")
                <<
            }
            if b == 10 { // LF
                d.line_starts.push(start)
                d.line_ends.push(i)
                i += 1
                start = i
                ->
            }
            if b == 13 { // CR or CRLF
                d.line_starts.push(start)
                d.line_ends.push(i)
                i += 1
                if i < n && (d.buf[i] & 255) == 10 {
                    i += 1
                }
                start = i
                ->
            }
            i += 1
            ->
        }
        // Strict UTF-8 multi-byte validation
        if b < 194 {
            d.fail(1, "invalid UTF-8")
            <<
        }
        if b < 224 {
            if i + 1 >= n {
                d.fail(1, "invalid UTF-8")
                <<
            }
            b1 := d.buf[i + 1] & 255
            if (b1 & 192) != 128 {
                d.fail(1, "invalid UTF-8")
                <<
            }
            r2 := ((b & 31) << 6) | (b1 & 63)
            if r2 < 128 {
                d.fail(1, "invalid UTF-8")
                <<
            }
            i += 2
            ->
        }
        if b < 240 {
            if i + 2 >= n {
                d.fail(1, "invalid UTF-8")
                <<
            }
            b1 := d.buf[i + 1] & 255
            b2 := d.buf[i + 2] & 255
            if (b1 & 192) != 128 || (b2 & 192) != 128 {
                d.fail(1, "invalid UTF-8")
                <<
            }
            r3 := ((b & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
            if r3 < 2048 || (r3 >= 55296 && r3 <= 57343) {
                d.fail(1, "invalid UTF-8")
                <<
            }
            i += 3
            ->
        }
        if b < 245 {
            if i + 3 >= n {
                d.fail(1, "invalid UTF-8")
                <<
            }
            b1 := d.buf[i + 1] & 255
            b2 := d.buf[i + 2] & 255
            b3 := d.buf[i + 3] & 255
            if (b1 & 192) != 128 || (b2 & 192) != 128 || (b3 & 192) != 128 {
                d.fail(1, "invalid UTF-8")
                <<
            }
            r4 := ((b & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
            if r4 < 65536 || r4 > 1114111 {
                d.fail(1, "invalid UTF-8")
                <<
            }
            i += 4
            ->
        }
        d.fail(1, "invalid UTF-8")
        <<
    }
    if start < n {
        d.line_starts.push(start)
        d.line_ends.push(n)
    }
}

fn rtrim_end(s &string, lo int, hi int) int {
    $e := hi
    while e > lo {
        b := s[e - 1] & 255
        if b == 32 || b == 9 {
            e -= 1
        } else {
            <-
        }
    }
    << e
}

fn trim_span(s &string, lo int, hi int) Span {
    $a := lo
    $b := hi
    while a < b && ((s[a] & 255) == 32 || (s[a] & 255) == 9) {
        a += 1
    }
    while b > a && ((s[b - 1] & 255) == 32 || (s[b - 1] & 255) == 9) {
        b -= 1
    }
    << Span{lo: a, hi: b}
}

fn strip_comment_end(s &string, lo int, hi int) int {
    $in_quote := false
    $i := lo
    while i < hi {
        ch := s[i] & 255
        if in_quote {
            if ch == 92 { // '\'
                i += 2
                ->
            }
            if ch == 34 { // '"'
                in_quote = false
            }
            i += 1
            ->
        }
        if ch == 34 {
            in_quote = true
            i += 1
            ->
        }
        if ch == 35 { // '#'
            if i == lo {
                << lo
            }
            prev := s[i - 1] & 255
            if prev == 32 || prev == 9 {
                << rtrim_end(s, lo, i)
            }
        }
        i += 1
    }
    << hi
}

fn span_eq(s &string, alo int, ahi int, blo int, bhi int) bool {
    len_a := ahi - alo
    if len_a != bhi - blo {
        << false
    }
    for i in 0:len_a {
        if s[alo + i] != s[blo + i] {
            << false
        }
    }
    << true
}

fn span_eq_str(s &string, lo int, hi int, lit &string) bool {
    n := hi - lo
    if n != lit.len {
        << false
    }
    for i in 0:n {
        if s[lo + i] != lit[i] {
            << false
        }
    }
    << true
}

fn span_has_prefix(s &string, lo int, hi int, pre &string) bool {
    if pre.len > hi - lo {
        << false
    }
    for i in 0:pre.len {
        if s[lo + i] != pre[i] {
            << false
        }
    }
    << true
}

fn has_prefix(s &string, pre string) bool {
    if pre.len > s.len {
        << false
    }
    for i in 0:pre.len {
        if s[i] != pre[i] {
            << false
        }
    }
    << true
}

fn is_comment_span(s &string, lo int, hi int) bool {
    $i := lo
    while i < hi && (s[i] & 255) == 32 {
        i += 1
    }
    if i >= hi {
        << false
    }
    << (s[i] & 255) == 35 // '#'
}

fn (d $&Doc) leading_span(lo int, hi int, no int) int {
    $n := 0
    $i := lo
    while i < hi {
        b := d.buf[i] & 255
        if b == 9 {
            d.fail(no, "tab indent is not allowed")
            << 0
        }
        if b == 32 {
            n += 1
            i += 1
        } else {
            <-
        }
    }
    if n % 2 != 0 {
        d.fail(no, "indent must be a multiple of 2 spaces")
        << 0
    }
    << n
}

fn (d $&Doc) skip_blanks() {
    while d.i < d.line_starts.len {
        lo := d.line_starts[d.i]
        hi := rtrim_end(&d.buf, lo, d.line_ends[d.i])
        if hi == lo || is_comment_span(&d.buf, lo, hi) {
            d.i += 1
        } else {
            <-
        }
    }
}
