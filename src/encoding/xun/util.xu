@encoding/xun

struct QuotedSpan {
    klo int
    khi int
    end int
}

fn hash_span(s &string, lo int, hi int) int {
    if hi <= lo {
        << 0
    }
    $h := 2166136261
    for i in lo:hi {
        h = ((h ^ (s[i] & 255)) * 16777619) & 2147483647
    }
    << h
}

fn hash_str(s &string) int {
    << hash_span(s, 0, s.len)
}

fn strip_us(s &string) string {
    $has_us := false
    for i in 0:s.len {
        if (s[i] & 255) == 95 {
            has_us = true
            <-
        }
    }
    if !has_us {
        << *s + ""
    }
    $out := ""
    ro := $&out
    for i in 0:s.len {
        b := s[i] & 255
        if b != 95 { // '_'
            ro.push_byte(b)
        }
    }
    << out
}

fn is_hex(c int) bool {
    if c >= 48 && c <= 57 {
        << true
    }
    if c >= 97 && c <= 102 {
        << true
    }
    if c >= 65 && c <= 70 {
        << true
    }
    << false
}

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn is_alpha(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    << false
}

fn is_alphanumeric(c int) bool {
    << is_alpha(c) || is_digit(c) || c == 95
}

fn has_newline_span(s &string, lo int, hi int) bool {
    for i in lo:hi {
        b := s[i] & 255
        if b == 10 || b == 13 {
            << true
        }
    }
    << false
}

fn str_contains(s &string, sub &string) bool {
    if sub.len == 0 {
        << true
    }
    if s.len < sub.len {
        << false
    }
    lim := s.len - sub.len
    for i in 0:lim + 1 {
        $matched := true
        for j in 0:sub.len {
            if s[i + j] != sub[j] {
                matched = false
                ->
            }
        }
        if matched {
            << true
        }
    }
    << false
}

fn span_contains_colon_space(s &string, lo int, hi int) bool {
    if hi - lo < 2 {
        << false
    }
    for i in lo:hi - 1 {
        if (s[i] & 255) == 58 && (s[i + 1] & 255) == 32 {
            << true
        }
    }
    << false
}

fn write_span(out $&string, s &string, lo int, hi int) {
    if hi <= lo {
        <<
    }
    n := hi - lo
    if n <= 24 {
        for i in lo:hi {
            out.push_byte(s[i] & 255)
        }
        <<
    }
    out.push_str((*s)[lo:hi])
}

fn write_quoted_span(out $&string, s &string, lo int, hi int) {
    out.push_byte(34) // '"'
    $start := lo
    for i in lo:hi {
        b := s[i] & 255
        if b == 92 || b == 34 {
            if i > start {
                write_span(out, s, start, i)
            }
            if b == 92 {
                out.push_str("\\\\")
            } else {
                out.push_str("\\\"")
            }
            start = i + 1
        }
    }
    if start < hi {
        write_span(out, s, start, hi)
    }
    out.push_byte(34)
}

fn (d $&Doc) parse_quoted_prefix_span(no int, lo int, hi int) QuotedSpan {
    if lo >= hi || (d.buf[lo] & 255) != 34 {
        d.fail(no, "quoted string must start with '\"'")
        << QuotedSpan{klo: 0, khi: 0, end: 0}
    }
    $i := lo + 1
    $has_esc := false
    $close_idx := -1
    while i < hi {
        b := d.buf[i] & 255
        if b == 92 { // '\'
            has_esc = true
            if i + 1 >= hi {
                d.fail(no, "unclosed escape in quoted string")
                << QuotedSpan{klo: 0, khi: 0, end: 0}
            }
            nxt := d.buf[i + 1] & 255
            if nxt != 34 && nxt != 92 {
                d.fail(no, "invalid escape in quoted string")
                << QuotedSpan{klo: 0, khi: 0, end: 0}
            }
            i += 2
        } else {
            if b == 34 { // '"'
                close_idx = i
                <-
            }
            i += 1
        }
    }
    if close_idx < 0 {
        d.fail(no, "unclosed quoted string")
        << QuotedSpan{klo: 0, khi: 0, end: 0}
    }
    if !has_esc {
        << QuotedSpan{klo: lo + 1, khi: close_idx, end: close_idx + 1}
    }
    $out := ""
    ro := $&out
    $j := lo + 1
    while j < close_idx {
        b := d.buf[j] & 255
        if b == 92 {
            ro.push_byte(d.buf[j + 1] & 255)
            j += 2
        } else {
            ro.push_byte(b)
            j += 1
        }
    }
    sp := d.intern_str(&out)
    << QuotedSpan{klo: sp.lo, khi: sp.hi, end: close_idx + 1}
}

fn is_ascii_ws(b int) bool {
    << b == 32 || b == 9 || b == 10 || b == 13 || b == 11 || b == 12
}

fn needs_quote_span(s &string, lo int, hi int, controls bool) bool {
    n := hi - lo
    if n <= 0 {
        << false
    }
    b0 := s[lo] & 255
    if controls && b0 == 124 { // '|'
        << true
    }
    if is_ascii_ws(b0) || is_ascii_ws(s[hi - 1] & 255) {
        << true
    }
    if b0 == 35 { // starts with '#'
        << true
    }
    for i in lo:hi {
        b := s[i] & 255
        if b == 34 || b == 92 { // '"' or '\'
            << true
        }
        if b == 58 && i + 1 < hi && (s[i + 1] & 255) == 32 { // ': '
            << true
        }
        if b == 32 && i + 1 < hi && (s[i + 1] & 255) == 35 { // ' #'
            << true
        }
    }
    if (s[hi - 1] & 255) == 58 && n > 1 { // ends with ':'
        << true
    }
    << false
}

fn looks_like_number_span(s &string, sl int, sh int) bool {
    $lo := sl
    $hi := sh
    while lo < hi && is_ascii_ws(s[lo] & 255) { lo += 1 }
    while hi > lo && is_ascii_ws(s[hi - 1] & 255) { hi -= 1 }
    if lo >= hi {
        << false
    }
    if (s[lo] & 255) == 43 || (s[lo] & 255) == 45 {
        lo += 1
        if lo >= hi {
            << false
        }
    }
    n := hi - lo
    inf_lit := "Infinity"
    if span_eq_str(s, lo, hi, &inf_lit) {
        << true
    }
    if n >= 3 && (s[lo] & 255) == 48 {
        p := s[lo + 1] & 255
        if p == 120 || p == 88 { // 0x / 0X
            for k in lo + 2:hi {
                if !is_hex(s[k] & 255) { << false }
            }
            << true
        }
        if p == 98 || p == 66 { // 0b / 0B
            for k in lo + 2:hi {
                b := s[k] & 255
                if b != 48 && b != 49 { << false }
            }
            << true
        }
        if p == 111 || p == 79 { // 0o / 0O
            for k in lo + 2:hi {
                b := s[k] & 255
                if b < 48 || b > 55 { << false }
            }
            << true
        }
    }
    $i := lo
    $saw_digit := false
    if i < hi && (s[i] & 255) == 46 {
        i += 1
        while i < hi && is_digit(s[i] & 255) {
            saw_digit = true
            i += 1
        }
    } else {
        while i < hi && is_digit(s[i] & 255) {
            saw_digit = true
            i += 1
        }
        if i < hi && (s[i] & 255) == 46 {
            i += 1
            while i < hi && is_digit(s[i] & 255) {
                i += 1
            }
        }
    }
    if !saw_digit {
        << false
    }
    if i < hi && ((s[i] & 255) == 101 || (s[i] & 255) == 69) {
        i += 1
        if i < hi && ((s[i] & 255) == 43 || (s[i] & 255) == 45) {
            i += 1
        }
        if i >= hi || !is_digit(s[i] & 255) {
            << false
        }
        while i < hi && is_digit(s[i] & 255) {
            i += 1
        }
    }
    << i == hi
}
