@encoding/xun

fn strip_us(s &string) string {
    mut out := ""
    for i in 0:s.len {
        b := s[i] & 255
        if b != 95 { // '_'
            out = out + s[i:i + 1]
        }
    }
    << out
}

fn is_hex(c int) bool {
    if c >= 48 && c <= 57 {
        << true
    }
    if c >= 97 && c <= 102 {
        << true
    }
    if c >= 65 && c <= 70 {
        << true
    }
    << false
}

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn is_alpha(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    << false
}

fn is_alphanumeric(c int) bool {
    << is_alpha(c) || is_digit(c) || c == 95
}

fn str_contains(s &string, sub &string) bool {
    if sub.len == 0 {
        << true
    }
    if s.len < sub.len {
        << false
    }
    lim := s.len - sub.len
    for i in 0:lim + 1 {
        mut matched := true
        for j in 0:sub.len {
            if s[i + j] != sub[j] {
                matched = false
                ->
            }
        }
        if matched {
            << true
        }
    }
    << false
}

fn has_suffix(s &string, suf &string) bool {
    if suf.len > s.len {
        << false
    }
    offset := s.len - suf.len
    for i in 0:suf.len {
        if s[offset + i] != suf[i] {
            << false
        }
    }
    << true
}

fn indent_spaces(depth int) string {
    mut out := ""
    for i in 0:depth {
        out = out + "  "
    }
    << out
}

fn quote_str(s &string) string {
    mut out := "\""
    for i in 0:s.len {
        b := s[i] & 255
        if b == 92 {
            out = out + "\\\\"
        } else {
            if b == 34 {
                out = out + "\\\""
            } else {
                out = out + s[i:i + 1]
            }
        }
    }
    out = out + "\""
    << out
}

fn unquote_str(s &string) string {
    if s.len < 2 {
        << s + ""
    }
    if (s[0] & 255) != 34 || (s[s.len - 1] & 255) != 34 {
        << s + ""
    }
    inner := s[1:s.len - 1]
    mut out := ""
    mut i := 0
    while i < inner.len {
        b := inner[i] & 255
        if b == 92 && i + 1 < inner.len {
            next := inner[i + 1] & 255
            if next == 34 {
                out = out + "\""
                i += 2
            } else {
                if next == 92 {
                    out = out + "\\"
                    i += 2
                } else {
                    out = out + inner[i:i + 1]
                    i += 1
                }
            }
        } else {
            out = out + inner[i:i + 1]
            i += 1
        }
    }
    << out
}

fn needs_quote(s &string) bool {
    if s.len == 0 {
        << true
    }
    // Leading or trailing space
    if (s[0] & 255) == 32 || (s[s.len - 1] & 255) == 32 {
        << true
    }
    if *s == "|" || *s == "[]" || *s == "{}" {
        << true
    }
    if (s[0] & 255) == 35 { // starts with '#'
        << true
    }
    if (s[0] & 255) == 45 && (s.len == 1 || (s[1] & 255) == 32) { // starts with '-' or '- '
        << true
    }
    for i in 0:s.len {
        b := s[i] & 255
        if b == 34 || b == 92 { // '"' or '\'
            << true
        }
        if b == 58 && i + 1 < s.len && (s[i + 1] & 255) == 32 { // ': '
            << true
        }
        if b == 32 && i + 1 < s.len && (s[i + 1] & 255) == 35 { // ' #'
            << true
        }
    }
    if (s[s.len - 1] & 255) == 58 && s.len > 1 { // ends with ':'
        << true
    }
    << false
}

fn looks_like_number(s &string) bool {
    if s.len == 0 {
        << false
    }
    if *s == "true" || *s == "false" || *s == "null" {
        << true
    }
    mut i := 0
    if (s[0] & 255) == 43 || (s[0] & 255) == 45 { // '+' or '-'
        i = 1
        if i >= s.len {
            << false
        }
    }
    // Check 0x, 0b, 0o
    if i + 2 < s.len && (s[i] & 255) == 48 {
        p := s[i + 1] & 255
        if p == 120 || p == 88 || p == 98 || p == 66 || p == 111 || p == 79 {
            << true
        }
    }
    mut saw_digit := false
    mut saw_dot := false
    while i < s.len {
        b := s[i] & 255
        if is_digit(b) {
            saw_digit = true
            i += 1
        } else {
            if b == 46 { // '.'
                if saw_dot {
                    << false
                }
                saw_dot = true
                i += 1
            } else {
                if (b == 101 || b == 69) && saw_digit { // 'e' or 'E'
                    i += 1
                    if i < s.len && ((s[i] & 255) == 43 || (s[i] & 255) == 45) {
                        i += 1
                    }
                    if i >= s.len || !is_digit(s[i] & 255) {
                        << false
                    }
                    while i < s.len && is_digit(s[i] & 255) {
                        i += 1
                    }
                    << i == s.len
                } else {
                    << false
                }
            }
        }
    }
    << saw_digit
}
