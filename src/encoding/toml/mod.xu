@encoding/toml

#errors
#strconv
#strings

// Go `github.com/pelletier/go-toml`: TOML document parser and query model.
// Parses key-value pairs, tables ([table]), comments (# ...), strings, numbers,
// and booleans into a queryable Doc DOM.

pub const TYPE_NULL = 0
pub const TYPE_BOOL = 1
pub const TYPE_INT = 2
pub const TYPE_STRING = 3
pub const TYPE_TABLE = 4

pub struct Item {
    pub key string
    pub val string
    pub val_type int
    pub table string
}

pub struct Doc {
    pub items []Item
}

fn trim_ws(s &string) string {
    $start := 0
    while start < s.len {
        c := s[start] & 255
        if c != 32 && c != 9 && c != 13 && c != 10 {
            <-
        }
        start = start + 1
    }
    $end := s.len
    while end > start {
        c := s[end - 1] & 255
        if c != 32 && c != 9 && c != 13 && c != 10 {
            <-
        }
        end = end - 1
    }
    << s[start:end] + ""
}

fn unquote(s &string) string {
    if s.len >= 2 {
        first := s[0] & 255
        last := s[s.len - 1] & 255
        if (first == 34 && last == 34) || (first == 39 && last == 39) {
            << s[1:s.len - 1] + ""
        }
    }
    << s + ""
}

pub fn parse(src &string) Doc {
    $items := []Item{}
    $current_table := ""
    $i := 0
    while i < src.len {
        $line_start := i
        while i < src.len && (src[i] & 255) != 10 {
            i = i + 1
        }
        line_raw := src[line_start:i] + ""
        if i < src.len {
            i = i + 1 // skip \n
        }

        trimmed := trim_ws(&line_raw)
        if trimmed.len == 0 || (trimmed[0] & 255) == 35 { // skip empty or comment '#'
            ->
        }

        if (trimmed[0] & 255) == 91 && (trimmed[trimmed.len - 1] & 255) == 93 {
            // [table]
            table_name := trimmed[1:trimmed.len - 1] + ""
            current_table = trim_ws(&table_name)
            ->
        }

        // key = value
        $eq := 0 - 1
        $k := 0
        while k < trimmed.len {
            if (trimmed[k] & 255) == 61 {
                eq = k
                k = trimmed.len
            } else {
                k = k + 1
            }
        }

        if eq > 0 {
            key_part := trimmed[0:eq] + ""
            val_part := trimmed[eq + 1:trimmed.len] + ""
            k_clean := trim_ws(&key_part)
            v_clean := trim_ws(&val_part)

            // strip inline comment if value is not quoted
            $v_final := v_clean + ""
            if v_clean.len > 0 && (v_clean[0] & 255) != 34 && (v_clean[0] & 255) != 39 {
                $hash := 0 - 1
                $m := 0
                while m < v_clean.len {
                    if (v_clean[m] & 255) == 35 {
                        hash = m
                        m = v_clean.len
                    } else {
                        m = m + 1
                    }
                }
                if hash >= 0 {
                    sub := v_clean[0:hash] + ""
                    v_final = trim_ws(&sub)
                }
            }

            $v_type := TYPE_STRING
            if v_final == "true" || v_final == "false" {
                v_type = TYPE_BOOL
            } else if v_final.len > 0 && ((v_final[0] & 255) >= 48 && (v_final[0] & 255) <= 57) {
                v_type = TYPE_INT
            }

            val_unquoted := unquote(&v_final)
            items.push(Item{
                key: k_clean,
                val: val_unquoted,
                val_type: v_type,
                table: current_table + ""
            })
        }
    }
    << Doc{items: items}
}

pub fn (d &Doc) get(key &string) string {
    k := key + ""
    $i := 0
    while i < d.items.len {
        item := d.items[i]
        if item.table.len == 0 && item.key == k {
            << item.val + ""
        }
        i = i + 1
    }
    << ""
}

pub fn (d &Doc) get_in(table &string, key &string) string {
    t := table + ""
    k := key + ""
    $i := 0
    while i < d.items.len {
        item := d.items[i]
        if item.table == t && item.key == k {
            << item.val + ""
        }
        i = i + 1
    }
    << ""
}

pub fn (d &Doc) has(key &string) bool {
    k := key + ""
    $i := 0
    while i < d.items.len {
        item := d.items[i]
        if item.key == k {
            << true
        }
        i = i + 1
    }
    << false
}

pub fn (d &Doc) get_int(key &string) int {
    v := d.get(key)
    if v.len == 0 {
        << 0
    }
    n := strconv.atoi(&v) or (err) { << 0 }
    << n
}

pub fn (d &Doc) get_bool(key &string) bool {
    v := d.get(key)
    << v == "true"
}

pub fn (d &Doc) tables() []string {
    $out := []string{}
    $i := 0
    while i < d.items.len {
        t := d.items[i].table + ""
        if t.len > 0 {
            $exists := false
            $j := 0
            while j < out.len {
                if out[j] == t {
                    exists = true
                    j = out.len
                } else {
                    j = j + 1
                }
            }
            if !exists {
                out.push(t)
            }
        }
        i = i + 1
    }
    << out
}
