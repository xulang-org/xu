@encoding/hex


#errors
// Hex encoding aligned with Go `encoding/hex` (EncodeToString /
// DecodeString). All indexing is bounds-checked; decode rejects odd
// lengths and non-hex bytes with Err — never a partial buffer.

fn hex_ch(i int) int {
    d := i & 15
    // 0..9 → '0'+d; 10..15 → 'a'+(d-10). (d+6)>>4 is 0 then 1.
    << 48 + d + 39 * ((d + 6) >> 4)
}

fn hex_hw_supported() int {
    << 0
}

fn hex_hw_encode(src &string, dst &string) {
}

pub fn encode_to_string(src string) string {
    n := src.len
    if n <= 0 {
        << ""
    }
    // n+n wraps negative at the signed limit; make_string aborts on that
    // length instead of growing a short buffer.
    mut b := make_string(n + n)
    mut i := 0
    if hex_hw_supported() == 1 && n >= 16 {
        hex_hw_encode(&src, &b)
        i = (n / 16) * 16
    }
    while i < n {
        c := src[i] & 255
        mut d := c >> 4
        b[i + i] = 48 + d + 39 * ((d + 6) >> 4)
        d = c & 15
        b[i + i + 1] = 48 + d + 39 * ((d + 6) >> 4)
        i += 1
    }
    << b
}

// Valid bytes hold 48+nibble (0..15), invalid bytes hold 64. OR-ing
// lookup values keeps bit 6 clear exactly when every byte is valid. The
// high output nibble is truncated by the byte store; only the low needs
// an explicit mask. This uses the generic bounded byte-table loop.
const hex_decode_map = "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@0123456789@@@@@@@:;<=>?@@@@@@@@@@@@@@@@@@@@@@@@@@:;<=>?@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"

pub fn decode_string(s string) string {
    if s.len % 2 != 0 {
        >> errors.new("encoding/hex: odd length")
    }
    n := s.len / 2
    if n <= 0 {
        << ""
    }
    mut b := make_string(n)
    mut i := 0
    mut bad := 0
    alphabet := hex_decode_map
    while i < n {
        hi := alphabet[s[i + i] & 255]
        lo := alphabet[s[i + i + 1] & 255]
        bad = bad | hi | lo
        b[i] = (hi << 4) | (lo & 15)
        i += 1
    }
    if bad > 63 {
        >> errors.new("encoding/hex: invalid byte")
    }
    << b
}

pub fn dump(src string) string {
    mut b := []int{}
    mut i := 0
    while i < src.len {
        mut off := i
        mut k := 7
        while k >= 0 {
            d := (off >> (k * 4)) & 15
            b.push(hex_ch(d))
            k = k - 1
        }
        b.push(32)
        b.push(32)
        for j in 0:16 {
            if j == 8 {
                b.push(32)
            }
            if i + j < src.len {
                c := src[i + j] & 255
                b.push(hex_ch(c >> 4))
                b.push(hex_ch(c & 15))
            } else {
                b.push(32)
                b.push(32)
            }
            b.push(32)
        }
        b.push(124)
        for j in 0:16 {
            if i + j < src.len {
                c := src[i + j] & 255
                if c >= 32 && c <= 126 {
                    b.push(c)
                } else {
                    b.push(46)
                }
            }
        }
        b.push(124)
        b.push(10)
        i = i + 16
    }
    << string_from_bytes(b)
}

pub fn encoded_len(n int) int {
    << n * 2
}

pub fn decoded_len(n int) int {
    << n / 2
}

pub fn encode(src &string) string {
    << encode_to_string(src + "")
}

pub fn decode(s &string) string {
    << decode_string(s + "") or >>
}
