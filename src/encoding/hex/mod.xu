@encoding/hex


#errors
// Hex encoding aligned with Go `encoding/hex` (EncodeToString /
// DecodeString). All indexing is bounds-checked; decode rejects odd
// lengths and non-hex bytes with Err — never a partial buffer.

fn hex_ch(i int) int {
    d := i & 15
    // 0..9 → '0'+d; 10..15 → 'a'+(d-10). (d+6)>>4 is 0 then 1.
    << 48 + d + 39 * ((d + 6) >> 4)
}

fn hex_hw_supported() int {
    << 0
}

fn hex_hw_encode(src &string, dst &string) {
}

fn hex_hw_decode(src &string, dst &string) int {
    << 0
}

const hextable = "0123456789abcdef"

pub fn encode_to_string(src string) string {
    n := src.len
    if n <= 0 {
        << ""
    }
    mut b := make_string(n + n)
    mut i := 0
    if hex_hw_supported() == 1 && n >= 16 {
        hex_hw_encode(&src, &b)
        i = (n / 16) * 16
    }
    lut := hextable
    while i + 4 <= n {
        c0 := src[i] & 255
        c1 := src[i + 1] & 255
        c2 := src[i + 2] & 255
        c3 := src[i + 3] & 255
        i2 := i + i
        b[i2] = lut[c0 >> 4]
        b[i2 + 1] = lut[c0 & 15]
        b[i2 + 2] = lut[c1 >> 4]
        b[i2 + 3] = lut[c1 & 15]
        b[i2 + 4] = lut[c2 >> 4]
        b[i2 + 5] = lut[c2 & 15]
        b[i2 + 6] = lut[c3 >> 4]
        b[i2 + 7] = lut[c3 & 15]
        i += 4
    }
    while i < n {
        c := src[i] & 255
        i2 := i + i
        b[i2] = lut[c >> 4]
        b[i2 + 1] = lut[c & 15]
        i += 1
    }
    << b
}

// Valid bytes hold 48+nibble (0..15), invalid bytes hold 64. OR-ing
// lookup values keeps bit 6 clear exactly when every byte is valid. The
// high output nibble is truncated by the byte store; only the low needs
// an explicit mask. This uses the generic bounded byte-table loop.
const hex_decode_map = "@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@0123456789@@@@@@@:;<=>?@@@@@@@@@@@@@@@@@@@@@@@@@@:;<=>?@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@"

pub fn decode_string(s string) string {
    if s.len % 2 != 0 {
        >> errors.new("encoding/hex: odd length")
    }
    n := s.len / 2
    if n <= 0 {
        << ""
    }
    mut b := make_string(n)
    mut i := 0
    if hex_hw_supported() == 1 && s.len >= 32 {
        hw_n := hex_hw_decode(&s, &b)
        if hw_n < 0 {
            >> errors.new("encoding/hex: invalid byte")
        }
        i = hw_n
    }
    mut bad := 0
    alphabet := hex_decode_map
    while i + 4 <= n {
        i2 := i + i
        hi0 := alphabet[s[i2] & 255]
        lo0 := alphabet[s[i2 + 1] & 255]
        hi1 := alphabet[s[i2 + 2] & 255]
        lo1 := alphabet[s[i2 + 3] & 255]
        hi2 := alphabet[s[i2 + 4] & 255]
        lo2 := alphabet[s[i2 + 5] & 255]
        hi3 := alphabet[s[i2 + 6] & 255]
        lo3 := alphabet[s[i2 + 7] & 255]
        bad = bad | hi0 | lo0 | hi1 | lo1 | hi2 | lo2 | hi3 | lo3
        b[i] = (hi0 << 4) | (lo0 & 15)
        b[i + 1] = (hi1 << 4) | (lo1 & 15)
        b[i + 2] = (hi2 << 4) | (lo2 & 15)
        b[i + 3] = (hi3 << 4) | (lo3 & 15)
        i += 4
    }
    while i < n {
        hi := alphabet[s[i + i] & 255]
        lo := alphabet[s[i + i + 1] & 255]
        bad = bad | hi | lo
        b[i] = (hi << 4) | (lo & 15)
        i += 1
    }
    if bad > 63 {
        >> errors.new("encoding/hex: invalid byte")
    }
    << b
}

pub fn dump(src string) string {
    mut b := []int{}
    mut i := 0
    while i < src.len {
        mut off := i
        mut k := 7
        while k >= 0 {
            d := (off >> (k * 4)) & 15
            b.push(hex_ch(d))
            k = k - 1
        }
        b.push(32)
        b.push(32)
        for j in 0:16 {
            if j == 8 {
                b.push(32)
            }
            if i + j < src.len {
                c := src[i + j] & 255
                b.push(hex_ch(c >> 4))
                b.push(hex_ch(c & 15))
            } else {
                b.push(32)
                b.push(32)
            }
            b.push(32)
        }
        b.push(124)
        for j in 0:16 {
            if i + j < src.len {
                c := src[i + j] & 255
                if c >= 32 && c <= 126 {
                    b.push(c)
                } else {
                    b.push(46)
                }
            }
        }
        b.push(124)
        b.push(10)
        i = i + 16
    }
    << string_from_bytes(b)
}

pub fn encoded_len(n int) int {
    << n * 2
}

pub fn decoded_len(n int) int {
    << n / 2
}

pub fn encode(src &string) string {
    << encode_to_string(src + "")
}

pub fn decode(s &string) string {
    << decode_string(s + "") or >>
}
