@encoding/xml


#errors
#io
// XML 1.0 subset aligned with Go `encoding/xml` EscapeText + Decoder.Token.
// No reflect Unmarshal, no namespace URL resolution. Tokens are a tagged
// struct (kind + name/text + parallel attr slices). PI/DOCTYPE skipped.

pub const TOK_START = 1
pub const TOK_END = 2
pub const TOK_CHAR = 3
pub const TOK_COMMENT = 4

pub struct Token {
    pub kind int
    pub name string
    pub text string
    pub keys []string
    pub vals []string
}

pub struct Decoder {
    pub data string
    pub pos int
    pub pending_end string
}

pub fn new_decoder(src &string) Decoder {
    mut s := src + ""
    if s.len >= 3 && (s[0] & 255) == 239 && (s[1] & 255) == 187 && (s[2] & 255) == 191 {
        s = s[3:s.len] + ""
    }
    << Decoder{data: s, pos: 0, pending_end: ""}
}

pub fn (d Decoder) input_offset() int {
    << d.pos
}

fn is_name_start(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    if c == 95 || c == 58 {
        << true
    }
    << false
}

fn is_name_char(c int) bool {
    if is_name_start(c) {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 45 || c == 46 {
        << true
    }
    << false
}

fn is_ws(c int) bool {
    << c == 32 || c == 9 || c == 10 || c == 13
}

fn is_hex(c int) bool {
    if c >= 48 && c <= 57 {
        << true
    }
    if c >= 65 && c <= 70 {
        << true
    }
    if c >= 97 && c <= 102 {
        << true
    }
    << false
}

fn hex_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << c - 87
}

fn named_entity(name string) int {
    if name == "amp" {
        << 38
    }
    if name == "lt" {
        << 60
    }
    if name == "gt" {
        << 62
    }
    if name == "quot" {
        << 34
    }
    if name == "apos" {
        << 39
    }
    if name == "nbsp" {
        << 160
    }
    if name == "copy" {
        << 169
    }
    << -1
}

fn rune_bytes(cp int) string {
    if cp < 0 {
        << string_from_byte(239) + string_from_byte(191) + string_from_byte(189)
    }
    if cp < 128 {
        << string_from_byte(cp)
    }
    if cp < 2048 {
        << string_from_byte(192 | (cp >> 6)) + string_from_byte(128 | (cp & 63))
    }
    if cp < 65536 {
        << string_from_byte(224 | (cp >> 12)) + string_from_byte(128 | ((cp >> 6) & 63)) + string_from_byte(128 | (cp & 63))
    }
    << string_from_byte(240 | (cp >> 18)) + string_from_byte(128 | ((cp >> 12) & 63)) + string_from_byte(128 | ((cp >> 6) & 63)) + string_from_byte(128 | (cp & 63))
}

pub fn escape_text(s &string) string {
    mut out := io.buffer()
    for i in 0:s.len {
        c := s[i] & 255
        if c == 38 {
            out.write_str("&amp;")
        } else if c == 60 {
            out.write_str("&lt;")
        } else if c == 62 {
            out.write_str("&gt;")
        } else if c == 34 {
            out.write_str("&quot;")
        } else if c == 39 {
            out.write_str("&apos;")
        } else if c == 9 {
            out.write_str("&#x9;")
        } else if c == 10 {
            out.write_str("&#xA;")
        } else if c == 13 {
            out.write_str("&#xD;")
        } else if c < 32 {
            out.write_str(string_from_byte(239))
            out.write_str(string_from_byte(191))
            out.write_str(string_from_byte(189))
        } else {
            b := string_from_byte(c)
            out.write(&b)
        }
    }
    << out.bytes()
}

pub fn escape_string(s &string) string {
    << escape_text(s)
}

pub fn unescape_string(s &string) string {
    text := s + ""
    mut out := io.buffer()
    mut i := 0
    while i < text.len {
        c := text[i] & 255
        if c != 38 {
            b := string_from_byte(c)
            out.write(&b)
            i = i + 1
            ->
        }
        if i + 1 >= text.len {
            out.write_str("&")
            i = i + 1
            ->
        }
        if (text[i + 1] & 255) == 35 {
            mut j := i + 2
            if j >= text.len {
                out.write_str("&")
                i = i + 1
                ->
            }
            mut hex := false
            if (text[j] & 255) == 120 || (text[j] & 255) == 88 {
                hex = true
                j = j + 1
            }
            start := j
            if hex {
                while j < text.len && is_hex(text[j] & 255) {
                    j = j + 1
                }
            } else {
                while j < text.len && (text[j] & 255) >= 48 && (text[j] & 255) <= 57 {
                    j = j + 1
                }
            }
            if j == start {
                out.write_str("&")
                i = i + 1
                ->
            }
            mut cp := 0
            if hex {
                for k in start:j {
                    cp = cp * 16 + hex_val(text[k] & 255)
                }
            } else {
                for k in start:j {
                    cp = cp * 10 + ((text[k] & 255) - 48)
                }
            }
            if j < text.len && (text[j] & 255) == 59 {
                j = j + 1
            }
            out.write_str(rune_bytes(cp))
            i = j
            ->
        }
        mut j := i + 1
        while j < text.len {
            ch := text[j] & 255
            if ch == 59 {
                <-
            }
            if !is_name_char(ch) {
                <-
            }
            j = j + 1
        }
        if j < text.len && (text[j] & 255) == 59 {
            nm := text[(i + 1):j] + ""
            ent := named_entity(nm)
            if ent >= 0 {
                out.write_str(rune_bytes(ent))
                i = j + 1
                ->
            }
        }
        out.write_str("&")
        i = i + 1
    }
    << out.bytes()
}

fn index_from(s &string, sub &string, from int) int {
    text := s + ""
    needle := sub + ""
    if needle.len == 0 {
        << from
    }
    mut i := from
    while i + needle.len <= text.len {
        mut ok := 1
        for j in 0:needle.len {
            if (text[i + j] & 255) != (needle[j] & 255) {
                ok = 0
            }
        }
        if ok == 1 {
            << i
        }
        i = i + 1
    }
    << -1
}

fn parse_name(s &string, i int) int {
    if i >= s.len || !is_name_start(s[i] & 255) {
        << i
    }
    mut j := i + 1
    while j < s.len && is_name_char(s[j] & 255) {
        j = j + 1
    }
    << j
}

fn skip_ws(s &string, i int) int {
    mut p := i
    while p < s.len && is_ws(s[p] & 255) {
        p = p + 1
    }
    << p
}

pub fn (d &mut Decoder) token() Token {
    src := d.data + ""
    for round in 0:100000 {
        if d.pending_end.len > 0 {
            n := d.pending_end + ""
            d.pending_end = ""
            << Token{kind: TOK_END, name: n, text: "", keys: []string{}, vals: []string{}}
        }
        if d.pos >= src.len {
            >> errors.new("EOF")
        }
        if (src[d.pos] & 255) != 60 {
            start := d.pos
            mut i := d.pos
            while i < src.len && (src[i] & 255) != 60 {
                i = i + 1
            }
            raw := src[start:i] + ""
            d.pos = i
            text := unescape_string(&raw)
            << Token{kind: TOK_CHAR, name: "", text: text, keys: []string{}, vals: []string{}}
        }
        if d.pos + 1 >= src.len {
            >> errors.new("xml: unexpected EOF")
        }
        n1 := src[d.pos + 1] & 255
        if n1 == 47 {
            mut j := parse_name(&src, d.pos + 2)
            if j == d.pos + 2 {
                >> errors.new("xml: expected name")
            }
            nm := src[(d.pos + 2):j] + ""
            j = skip_ws(&src, j)
            if j >= src.len || (src[j] & 255) != 62 {
                >> errors.new("xml: expected >")
            }
            d.pos = j + 1
            << Token{kind: TOK_END, name: nm, text: "", keys: []string{}, vals: []string{}}
        }
        if n1 == 63 {
            close := "?>"
            p := index_from(&src, &close, d.pos + 2)
            if p < 0 {
                >> errors.new("xml: unterminated PI")
            }
            d.pos = p + 2
            ->
        }
        if n1 == 33 {
            if d.pos + 4 <= src.len && (src[d.pos + 2] & 255) == 45 && (src[d.pos + 3] & 255) == 45 {
                endm := "-->"
                p := index_from(&src, &endm, d.pos + 4)
                if p < 0 {
                    >> errors.new("xml: unterminated comment")
                }
                body := src[(d.pos + 4):p] + ""
                d.pos = p + 3
                << Token{kind: TOK_COMMENT, name: "", text: body, keys: []string{}, vals: []string{}}
            }
            mut cdata_ok := 0
            if d.pos + 9 <= src.len {
                cdata_ok = 1
                want := "[CDATA["
                for j in 0:7 {
                    if (src[d.pos + 2 + j] & 255) != (want[j] & 255) {
                        cdata_ok = 0
                    }
                }
            }
            if cdata_ok == 1 {
                endc := "]]>"
                p := index_from(&src, &endc, d.pos + 9)
                if p < 0 {
                    >> errors.new("xml: unterminated CDATA")
                }
                body := src[(d.pos + 9):p] + ""
                d.pos = p + 3
                << Token{kind: TOK_CHAR, name: "", text: body, keys: []string{}, vals: []string{}}
            }
            mut k := d.pos + 2
            while k < src.len && (src[k] & 255) != 62 {
                k = k + 1
            }
            if k >= src.len {
                >> errors.new("xml: unterminated directive")
            }
            d.pos = k + 1
            ->
        }
        j := parse_name(&src, d.pos + 1)
        if j == d.pos + 1 {
            >> errors.new("xml: expected name")
        }
        nm := src[(d.pos + 1):j] + ""
        mut keys := []string{}
        mut vals := []string{}
        mut p := skip_ws(&src, j)
        mut selfc := 0
        for round2 in 0:256 {
            if p >= src.len {
                >> errors.new("xml: unexpected EOF")
            }
            c := src[p] & 255
            if c == 47 {
                if p + 1 >= src.len || (src[p + 1] & 255) != 62 {
                    >> errors.new("xml: expected />")
                }
                selfc = 1
                p = p + 2
                <-
            }
            if c == 62 {
                p = p + 1
                <-
            }
            nj := parse_name(&src, p)
            if nj == p {
                >> errors.new("xml: expected attribute")
            }
            kn := src[p:nj] + ""
            p = skip_ws(&src, nj)
            if p >= src.len || (src[p] & 255) != 61 {
                >> errors.new("xml: expected =")
            }
            p = skip_ws(&src, p + 1)
            if p >= src.len {
                >> errors.new("xml: expected value")
            }
            q := src[p] & 255
            if q != 34 && q != 39 {
                >> errors.new("xml: expected quote")
            }
            p = p + 1
            v0 := p
            while p < src.len && (src[p] & 255) != q {
                p = p + 1
            }
            if p >= src.len {
                >> errors.new("xml: unterminated attribute")
            }
            rawv := src[v0:p] + ""
            p = p + 1
            keys.push(kn)
            vals.push(unescape_string(&rawv))
            p = skip_ws(&src, p)
        }
        d.pos = p
        if selfc == 1 {
            d.pending_end = nm + ""
        }
        << Token{kind: TOK_START, name: nm, text: "", keys: keys, vals: vals}
    }
    >> errors.new("xml: too many tokens")
}

pub fn (d &mut Decoder) skip() int {
    mut depth := 1
    while depth > 0 {
        t := d.token() or >>
        if t.kind == TOK_START {
            depth = depth + 1
        } else if t.kind == TOK_END {
            depth = depth - 1
        }
    }
    << 0
}
