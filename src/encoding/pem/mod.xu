@encoding/pem

#encoding/base64
#strings
#io

// PEM (RFC 1421) aligned with Go `encoding/pem` Decode / EncodeToMemory.
// No map: optional headers are parallel keys/vals. decode returns a Block
// with empty typ when no PEM is found (Go returns nil, rest=original).
// Subset: first BEGIN at start-of-line through matching END; no nested scan.

pub struct Block {
    pub typ string
    pub keys []string
    pub vals []string
    pub bytes string
    pub rest string
}

fn nl() string {
    << string_from_byte(10)
}

fn empty_block(orig &string) Block {
    << Block{typ: "", keys: []string{}, vals: []string{}, bytes: "", rest: orig + ""}
}

fn line_after(s &string, start int) int {
    $i := start
    while i < s.len {
        if (s[i] & 255) == 10 {
            << i + 1
        }
        i = i + 1
    }
    << s.len
}

fn line_body(s &string, start int, after int) string {
    text := s + ""
    $end := after
    if end > start && (text[end - 1] & 255) == 10 {
        end = end - 1
    }
    if end > start && (text[end - 1] & 255) == 13 {
        end = end - 1
    }
    while end > start {
        c := text[end - 1] & 255
        if c == 32 || c == 9 {
            end = end - 1
        } else {
            <-
        }
    }
    if end > start {
        << text[start:end] + ""
    }
    << ""
}

fn strip_b64(s &string) string {
    $b := []int{}
    for i in 0:s.len {
        c := s[i] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 {
            b.push(c)
        }
    }
    << string_from_bytes(b)
}

fn pad_b64(s &string) string {
    $t := s + ""
    while t.len % 4 != 0 {
        t = t + string_from_byte(61)
    }
    << t
}

pub fn decode(data &string) Block {
    src := data + ""
    needle := "-----BEGIN "
    endmark := "-----END "
    dashes := "-----"
    $p := -1
    $scan := 0
    while scan <= src.len {
        rest := src[scan:src.len]
        q := strings.index_of(&rest, needle + "")
        if q < 0 {
            << empty_block(&src)
        }
        abs := scan + q
        if abs == 0 || (src[abs - 1] & 255) == 10 {
            p = abs
            <-
        }
        scan = abs + 1
    }
    if p < 0 {
        << empty_block(&src)
    }
    after := line_after(&src, p)
    line := line_body(&src, p, after)
    if !strings.has_prefix(&line, needle + "") {
        << empty_block(&src)
    }
    if !strings.has_suffix(&line, dashes + "") {
        << empty_block(&src)
    }
    if line.len < needle.len + dashes.len {
        << empty_block(&src)
    }
    typ := line[needle.len:line.len - dashes.len] + ""
    $i := after
    $keys := []string{}
    $vals := []string{}
    $in_headers := 1
    $body := io.buffer()
    nline := nl()
    while i < src.len {
        nxt := line_after(&src, i)
        ln := line_body(&src, i, nxt)
        if strings.has_prefix(&ln, endmark + "") {
            want := (endmark + "") + (typ + "") + (dashes + "")
            if ln != want {
                << empty_block(&src)
            }
            body_s := body.bytes()
            raw := strip_b64(&body_s)
            $bytes := ""
            if raw.len > 0 {
                padded := pad_b64(&raw)
                bytes = base64.decode_string(padded) or (err) {
                    << empty_block(&src)
                }
            }
            rest := src[nxt:src.len] + ""
            << Block{typ: typ + "", keys: keys, vals: vals, bytes: bytes, rest: rest}
        }
        if in_headers == 1 {
            col := strings.index_of(&ln, ":")
            if col > 0 {
                kpart := ln[0:col] + ""
                vpart := ln[col + 1:ln.len] + ""
                keys.push(strings.trim_space(&kpart))
                vals.push(strings.trim_space(&vpart))
            } else {
                in_headers = 0
                if ln.len > 0 {
                    body.write(&ln)
                    body.write(&nline)
                }
            }
        } else {
            if ln.len > 0 {
                body.write(&ln)
                body.write(&nline)
            }
        }
        i = nxt
    }
    << empty_block(&src)
}

pub fn (b Block) header(key string) string {
    k := key + ""
    $i := 0
    while i < b.keys.len {
        cur := b.keys[i] + ""
        if cur == k {
            if i < b.vals.len {
                << b.vals[i] + ""
            }
            << ""
        }
        i = i + 1
    }
    << ""
}

pub fn encode_to_memory(b &Block) string {
    nline := nl()
    ds := "-----"
    begin_mark := "BEGIN "
    end_mark := "END "
    colon_space := ": "
    t := b.typ + ""
    $out := io.buffer()
    out.write(&ds)
    out.write(&begin_mark)
    out.write(&t)
    out.write(&ds)
    out.write(&nline)
    if b.keys.len > 0 {
        $n := b.keys.len
        if b.vals.len < n {
            n = b.vals.len
        }
        for i in 0:n {
            k := b.keys[i] + ""
            v := b.vals[i] + ""
            out.write(&k)
            out.write(&colon_space)
            out.write(&v)
            out.write(&nline)
        }
        out.write(&nline)
    }
    raw := b.bytes + ""
    b64 := base64.encode_to_string(raw)
    $i := 0
    while i < b64.len {
        $end := i + 64
        if end > b64.len {
            end = b64.len
        }
        chunk := b64[i:end] + ""
        out.write(&chunk)
        out.write(&nline)
        i = end
    }
    out.write(&ds)
    out.write(&end_mark)
    out.write(&t)
    out.write(&ds)
    out.write(&nline)
    << out.bytes()
}
