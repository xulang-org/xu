                    cb.patch_u64_le(sec_bases[si] + dr.off, data_vaddr_base + target_off + dr.addend)
                }
            }
        }
    }
    $ri := 0
    while ri < relocs.len {
        target_off := syms.lookup_offset(relocs[ri].symbol_name)
        if target_off >= 0 {
