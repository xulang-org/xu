                    cb.emit_u8(0)
                }
            }
            sec_base := cb.len()
            sec_bases.push(sec_base)
            for di in 0:edata.syms.len {
                if edata.syms[di].sec_idx == si {
                    syms.define_label(edata.syms[di].name + "", sec_base + edata.syms[di].off)
                }
            }
            if edata.secs[si].is_nobits {
                for zi in 0:edata.secs[si].total_size {
                    cb.emit_u8(0)
                }
            } else {
                cb.emit_bytes(&edata.secs[si].bytes)
                $rem := edata.secs[si].total_size - edata.secs[si].bytes.len
                while rem > 0 {
