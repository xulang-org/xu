pub fn print_debug_help() {
    println("usage: xu debug [options] <input.xu...> [-- program-args...]")
    println("")
    println("Build a DWARF-enabled debug binary and start an interactive source debugger.")
    println("")
    println("Options:")
    println("  -b, --break SPEC     source location file.xu:LINE or function name")
    println("  -e, --eval COMMAND   execute a debugger command before the prompt (repeatable)")
    println("  --run                launch the program after applying debugger commands")
    println("  --batch              run in batch mode without interactive prompt")
    println("  --stop-at-entry      stop at the program entry point")
    println("  --backend PATH       use PATH instead of lldb (gdb is the fallback)")
    println("  --binary PATH        debug an existing executable; skip the build")
    println("  -o, --output PATH    keep the debug executable at PATH")
    println("  --target TARGET      host target to build (macos/linux/windows)")
    println("  -h, --help           show this message")
    println("")
    println("Examples:")
    println("  xu debug -b main.xu:8 main.xu")
    println("  xu debug -b main.xu:8 --run main.xu")
    println("  xu debug --binary ./app -e 'bt' -e 'frame variable'")
}

fn str_eq(a &string, b &string) bool {
    if a.len != b.len {
        << false
    }
    for i in 0:a.len {
        if a[i] != b[i] {
            << false
        }
    }
    << true
}

fn str_starts_with(s &string, prefix string) bool {
    if s.len < prefix.len {
        << false
    }
    for i in 0:prefix.len {
        if s[i] != prefix[i] {
            << false
        }
    }
    << true
}

// Map types and runtime syntax aliases (str, itoa, ...) are implemented in the
// `runtime` package, which programs never import by name.
fn needs_runtime_algo(p &parser.Parser) bool {
    for i in 0:p.nodes.len {
        k := p.nodes[i].kind
        if k == ast.NT_MAP || k == ast.NK_MAP_INIT {
            << true
        }
        if k == ast.NK_CALL || k == ast.NK_METHOD_CALL {
            name := p.nodes[i].sval + ""
            if types.runtime_abi_syntax_id(&name) != 0 {
                << true
            }
        }
    }
    << false
}

// Explicit inputs and import-resolved files must share one spelling so a
// file named on the command line is not parsed again through its package.
fn abs_path(p &string) string {
    << host_slashes(filepath.abs(p))
}

// Windows hosts accept '/' too; one spelling keeps the package and file
// de-duplication (string compares) from loading a file twice.
fn host_slashes(s string) string {
    if xu_target_os() != target.OS_WINDOWS {
        << s
    }
    $out := ""
    for i in 0:s.len {
        if s[i] == 92 {
            out.push_byte(47)
        } else {
            out.push_byte(s[i])
        }
    }
    << out
}

fn str_ends_with(s &string, suffix string) bool {
    if s.len < suffix.len {
        << false
    }
    offset := s.len - suffix.len
    for i in 0:suffix.len {
        if s[offset + i] != suffix[i] {
            << false
        }
    }
    << true
}

fn str_contains(s &string, substr string) bool {
    if substr.len == 0 {
        << true
    }
    if s.len < substr.len {
        << false
    }
    $limit := s.len - substr.len
    for i in 0:limit + 1 {
        $matched := true
        for j in 0:substr.len {
            if s[i + j] != substr[j] {
                matched = false
                <-
            }
        }
        if matched {
            << true
        }
    }
    << false
}

fn debug_find_backend(name string) string {
    res := exec.look_path(name) or (err) {
        << ""
    }
    << res
}

fn debug_remove(path &string) {
    p := ~path
    os.remove(p) or (err) {
        <<
    }
}

fn debug_break_command(spec &string, is_gdb bool) string {
    $split := -1
    for i in 0:spec.len {
        if spec[i] == 58 {
            split = i
        }
    }
    if split > 0 && split + 1 < spec.len {
        file := spec[0:split]
        line := spec[split + 1:spec.len]
        if is_gdb {
            << "break " + file + ":" + line
        }
        << "breakpoint set --file " + file + " --line " + line
    }
    if is_gdb {
        << "break " + spec
    }
    << "breakpoint set --name " + spec
}

pub fn run_debug(args &[]string) int {
    if args.len <= 2 {
        print_debug_help()
        << 0
    }
    $has_help := false
    for hi in 2:args.len {
        if args[hi] == "-h" || args[hi] == "--help" {
            has_help = true
            <-
        }
    }
    if has_help {
        print_debug_help()
        << 0
    }

    $files := []string{}
    $break_specs := []string{}
    $eval_cmds := []string{}
    $program_args := []string{}
    $output := ""
    $output_set := false
    $binary := ""
    $backend := ""
    $target_name := ""
    $target_set := false
    $launch := false
    $batch := false
    $stop_at_entry := false
    $after_sep := false

    $i := 2
    while i < args.len {
        arg := ~args[i]
        if after_sep {
            program_args.push(arg)
            i += 1
        } else if arg == "--" {
            after_sep = true
            i += 1
        } else if arg == "-b" || arg == "--break" {
            if i + 1 < args.len {
                break_specs.push(~args[i + 1])
                i += 2
            } else {
                println("xu debug: --break requires a location")
                << 1
            }
        } else if str_starts_with(&arg, "--break=") {
            break_specs.push(arg[8:arg.len])
            i += 1
        } else if arg == "-e" || arg == "--eval" {
            if i + 1 < args.len {
                eval_cmds.push(~args[i + 1])
                i += 2
            } else {
                println("xu debug: --eval requires a command")
                << 1
            }
        } else if str_starts_with(&arg, "--eval=") {
            eval_cmds.push(arg[7:arg.len])
            i += 1
        } else if arg == "--run" {
            launch = true
            i += 1
        } else if arg == "--batch" {
            batch = true
            i += 1
        } else if arg == "--stop-at-entry" {
            stop_at_entry = true
            i += 1
        } else if arg == "--backend" {
            if i + 1 < args.len {
                backend = ~args[i + 1]
                i += 2
            } else {
                println("xu debug: --backend requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--backend=") {
            backend = arg[10:arg.len]
            i += 1
        } else if arg == "--binary" {
            if i + 1 < args.len {
                binary = ~args[i + 1]
                i += 2
            } else {
                println("xu debug: --binary requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--binary=") {
            binary = arg[9:arg.len]
            i += 1
        } else if arg == "-o" || arg == "--output" {
            if i + 1 < args.len {
                output = ~args[i + 1]
                output_set = true
                i += 2
            } else {
                println("xu debug: -o requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--output=") {
            output = arg[9:arg.len]
            output_set = true
            i += 1
        } else if str_starts_with(&arg, "-o=") {
            output = arg[3:arg.len]
            output_set = true
            i += 1
        } else if arg == "--target" {
            if i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else {
                println("xu debug: --target requires a name")
                << 1
            }
        } else if str_starts_with(&arg, "--target=") {
            target_name = arg[9:arg.len]
            target_set = true
            i += 1
        } else if arg == "--debug-build" || arg == "--no-regcache" || arg == "--debug" || arg == "-O0" || arg == "-O1" || arg == "-O2" || arg == "-O3" || arg == "--ra=0" || arg == "--ra=1" || arg == "--ra=2" || arg == "--ra=3" {
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            println("xu debug: unknown flag " + arg)
            << 1
        } else {
            files.push(arg)
            i += 1
        }
    }

    if binary.len == 0 && files.len == 0 {
        println("xu debug: no input source or --binary path")
        << 1
    }
    if binary.len > 0 && files.len > 0 {
        println("xu debug: --binary cannot be combined with source files")
        << 1
    }

    $tgt_os := target.OS_MACOS
    $tgt_arch := target.ARCH_ARM64
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            println("xu debug: unknown target '" + target_name + "'")
            << 1
        }
        parsed_target := target.target_from_code(code)
        tgt_os = parsed_target.os
        tgt_arch = parsed_target.arch

        if tgt_os == target.OS_NONE {
            println("xu debug: freestanding targets have no host debugger")
            << 1
        }
        if tgt_os != target.OS_MACOS || tgt_arch != target.ARCH_ARM64 {
            println("xu debug: cross-target binaries cannot run under the host debugger")
            << 1
        }
    }

    $temp_binary := false
    $target_bin := binary
    if target_bin.len == 0 {
        if output_set {
            target_bin = output
        } else {
            pid := os.getpid()
            target_bin = "/tmp/xu_debug_" + str(pid) + "_" + str(now_ns() & 2147483647)
            temp_binary = true
        }

        files_len := files.len
        res := run_build(&files, files_len, target_bin, tgt_os * 10 + tgt_arch, true, false)
        if res != 0 {
            if temp_binary {
                debug_remove(&target_bin)
            }
            << res
        }
    }

    $dbg := backend
    if dbg.len == 0 {
        dbg = debug_find_backend("lldb")
        if dbg.len == 0 {
            dbg = debug_find_backend("gdb")
        }
    }
    if dbg.len == 0 {
        println("xu debug: no lldb or gdb executable found; use --backend PATH")
        if temp_binary {
            debug_remove(&target_bin)
        }
        << 127
    }

    is_gdb := str_contains(&dbg, "gdb")
    $cmd := exec.command(~dbg)
    if batch {
        if is_gdb {
            cmd.args.push("-batch")
        } else {
            cmd.args.push("--batch")
        }
    }
    for bi in 0:break_specs.len {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push(debug_break_command(&break_specs[bi], true))
        } else {
            cmd.args.push("-o")
            cmd.args.push(debug_break_command(&break_specs[bi], false))
        }
    }
    if program_args.len > 0 {
        if is_gdb {
            $pargs_cmd := "set args"
            for pi in 0:program_args.len {
                pargs_cmd = pargs_cmd + " " + program_args[pi]
            }
            cmd.args.push("-ex")
            cmd.args.push(~pargs_cmd)
        } else {
            $pargs_cmd := "settings set target.run-args"
            for pi in 0:program_args.len {
                pargs_cmd = pargs_cmd + " " + program_args[pi]
            }
            cmd.args.push("-o")
            cmd.args.push(~pargs_cmd)
        }
    }
    if stop_at_entry {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push("start")
        } else {
            cmd.args.push("-o")
            cmd.args.push("process launch --stop-at-entry")
        }
    } else if launch {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push("run")
        } else {
            cmd.args.push("-o")
            cmd.args.push("process launch")
        }
    }
    for ei in 0:eval_cmds.len {
        if is_gdb {
            cmd.args.push("-ex")
        } else {
            cmd.args.push("-o")
        }
        cmd.args.push(~eval_cmds[ei])
    }
    cmd.args.push(~target_bin)

    rc := cmd.run() or (err) {
        println("xu debug: backend failed to execute")
        if temp_binary {
            debug_remove(&target_bin)
        }
        <<< 127
    }

    if temp_binary {
        debug_remove(&target_bin)
    }
    << rc
}

fn resolve_target(target_set bool, explicit_target &target.Target) target.Target {
    if target_set {
        << ~explicit_target
    }
    xtarget := os.getenv("XU_TARGET")
    if xtarget.len > 0 {
        c := target.parse_target(xtarget)
        if c >= 0 {
            << target.target_from_code(c)
        }
    }
    xos := os.getenv("XUOS")
    if xos.len > 0 {
        xarch := os.getenv("XUARCH")
        if xarch.len > 0 {
            c := target.parse_target(xos + "-" + xarch)
            if c >= 0 {
                << target.target_from_code(c)
            }
        }
    }
    << target.target_host()
}

pub fn print_env_help() {
    println("usage: xu env [options] [var...]")
    println("")
    println("Print Xu toolchain and environment variables.")
    println("If one or more variable names are specified, prints only their values.")
    println("")
    println("Arguments:")
    println("  [var...]          one or more variable names to query")
    println("")
    println("Common variables:")
    println("  XU_VERSION        current compiler version")
    println("  XU_ROOT           root directory of the Xu toolchain/repository")
    println("  XU_STDLIB_ROOT    directory containing standard library sources")
    println("  XUPATH            package search paths")
    println("  XU_CACHE          package cache directory for downloaded modules")
    println("  XUOS              target operating system")
    println("  XUARCH            target architecture")
    println("  HOST_OS           host operating system")
    println("  HOST_ARCH         host architecture")
    println("  XUPROXY           package download proxy URL or direct/off")
    println("  XUSUMDB           checksum database URL/key")
    println("  XUPRIVATE         private module glob patterns bypassing proxy")
    println("")
    println("Options:")
    println("  -h, --help        show this help message")
}

pub fn run_env(args &[]string) int {
    if args.len > 2 {
        if args[2] == "-h" || args[2] == "--help" {
            print_env_help()
            << 0
        }
    }

    e_ver := compiler_version()
    e_root := os.getenv("XU_ROOT")
    e_std := stdlib_root()
    $e_xupath := os.getenv("XUPATH")
    $e_cache := os.getenv("XU_CACHE")
    if e_cache.len == 0 {
        h := os.home_dir()
        if h.len > 0 {
            e_cache = h + "/.xu/pkg"
        }
    }
    $e_proxy := os.getenv("XUPROXY")
    if e_proxy.len == 0 {
        e_proxy = "direct"
    }
    $e_sumdb := os.getenv("XUSUMDB")
    $e_priv := os.getenv("XUPRIVATE")

    host_t := target.target_host()
    host_os_s := target.target_os_name(host_t.os)
    host_arch_s := target.target_arch_name(host_t.arch)

    $xuos_s := os.getenv("XUOS")
    if xuos_s.len == 0 {
        xuos_s = host_os_s
    }
    $xuarch_s := os.getenv("XUARCH")
    if xuarch_s.len == 0 {
        xuarch_s = host_arch_s
    }

    if args.len > 2 {
        for i in 2:args.len {
            req := args[i]
            if req == "XU_VERSION" { println(e_ver) }
            else if req == "XU_ROOT" { println(e_root) }
            else if req == "XU_STDLIB_ROOT" { println(e_std) }
            else if req == "XUPATH" { println(e_xupath) }
            else if req == "XU_CACHE" { println(e_cache) }
            else if req == "XUOS" { println(xuos_s) }
            else if req == "XUARCH" { println(xuarch_s) }
            else if req == "HOST_OS" { println(host_os_s) }
            else if req == "HOST_ARCH" { println(host_arch_s) }
            else if req == "XUPROXY" { println(e_proxy) }
            else if req == "XUSUMDB" { println(e_sumdb) }
            else if req == "XUPRIVATE" { println(e_priv) }
            else { println("") }
        }
        << 0
    }

    println("XU_VERSION=\"" + e_ver + "\"")
    println("XU_ROOT=\"" + e_root + "\"")
    println("XU_STDLIB_ROOT=\"" + e_std + "\"")
    println("XUPATH=\"" + e_xupath + "\"")
    println("XU_CACHE=\"" + e_cache + "\"")
    println("XUOS=\"" + xuos_s + "\"")
    println("XUARCH=\"" + xuarch_s + "\"")
    println("HOST_OS=\"" + host_os_s + "\"")
    println("HOST_ARCH=\"" + host_arch_s + "\"")
    println("XUPROXY=\"" + e_proxy + "\"")
    println("XUSUMDB=\"" + e_sumdb + "\"")
    println("XUPRIVATE=\"" + e_priv + "\"")
    << 0
}

fn compiler_version() string {
    << "0.12.2"
}

pub fn print_version() int {
    tgt := target.target_host()
    println("    __  __  _   _   ")
    println("    \\ \\/ / | | | |   Xu Compiler Toolchain v" + compiler_version())
    println("     \\  /  | | | |   Rock-Solid Ownership - Zero GC - Supersonic AOT")
    println("     /  \\  | |_| |   Docs: https://xulang.org")
    println("    /_/\\_\\  \\___/    Target: " + target.target_os_name(tgt.os) + "-" + target.target_arch_name(tgt.arch) + " - 64-bit Native")
    << 0
}

pub fn run_get(args &[]string) int {
    if args.len <= 2 {
        print_get_help()
        << 0
    }
    for i in 2:args.len {
        if args[i] == "-h" || args[i] == "--help" {
            print_get_help()
            << 0
        }
    }
    eprintln("xu get: dependency installation is unavailable in xu-next")
    << 1
}

pub fn run_install(args &[]string) int {
    for i in 2:args.len {
        if args[i] == "-h" || args[i] == "--help" {
            print_install_help()
            << 0
        }
    }
    eprintln("xu install: dependency installation is unavailable in xu-next")
    << 1
}

fn remove_created_file(path &string) {
    os.remove(~path) or (err) {
        eprintln("xu: " + err.msg())
        <<
    }
}

// The caller owns the path only after exclusive creation succeeds. Never
// unlink a pre-existing file or follow a symlink while opening the path.
fn write_exclusive(path &string, data &string) bool {
    $file := os.create_excl(~path) or (err) {
        if os.is_exist(err.msg()) {
            << false
        }
        >> err
    }
    file.write(~data) or (err) {
        file.close() or (close_err) {
            eprintln("xu: " + close_err.msg())
            remove_created_file(path)
            >> err
        }
        remove_created_file(path)
        >> err
    }
    file.close() or (err) {
        remove_created_file(path)
        >> err
    }
    << true
}

fn run_init(args &[]string) int {
    cwd := os.getwd()
    $name := filepath.base(&cwd)
    if !modulepath.valid_module(&name) {
        name = "app"
    }
    if args.len > 2 {
        name = ~args[2]
        if name == "-h" || name == "--help" {
            println("usage: xu init [module]")
            << 0
        }
    }
    if args.len > 3 || !modulepath.valid_module(&name) {
        eprintln("xu init: expected a single valid module name")
        << 1
    }

    manifest_path := "xu.xun"
    manifest := "module: " + name + "\nversion: !ver 0.1.0\nxu: !ver " + compiler_version() + "\n"
    created := write_exclusive(&manifest_path, &manifest) or (err) {
        eprintln("xu init: " + err.msg())
        << 1
    }
    if !created {
        eprintln("xu init: xu.xun already exists")
        << 1
    }

    main_path := "main.xu"
    starter := "@main\n\nfn main() int {\n    println(\"Hello, Xu!\")\n    << 0\n}\n"
    write_exclusive(&main_path, &starter) or (err) {
        eprintln("xu init: " + err.msg())
        remove_created_file(&manifest_path)
        << 1
    }
    println("Initialized Xu module '" + name + "' in " + cwd)
    << 0
}

fn run_program(bin &string, args &[]string) int {
    $cmd := exec.command(~bin)
    for i in 0:args.len {
        cmd.args.push(~args[i])
    }
    << cmd.run_status() or (err) {
        eprintln("xu: " + err.msg())
        << 127
    }
}

fn is_optimization_level(arg &string) bool {
    << *arg == "-O0" || *arg == "-O1" || *arg == "-O2" || *arg == "-O3"
}

pub fn run_test(args &[]string) int {
    if args.len <= 2 {
        println("error: xu test requires at least one source file")
        << 1
    }
    $files := []string{}
    $target_set := false
    $target_name := ""
    $opt_level_zero := false
    $list_only := false
    $verbose := false

    $i := 2
    while i < args.len {
        arg := ~args[i]
        if (arg == "--target" || arg == "-target") && i + 1 < args.len {
            target_name = ~args[i + 1]
            target_set = true
            i += 2
        } else if str_starts_with(&arg, "--target=") {
            target_name = arg[9:arg.len]
            target_set = true
            i += 1
        } else if str_starts_with(&arg, "-target=") {
            target_name = arg[8:arg.len]
            target_set = true
            i += 1
        } else if is_optimization_level(&arg) {
            opt_level_zero = arg == "-O0"
            i += 1
        } else if arg == "-list" {
            list_only = true
            i += 1
        } else if arg == "-v" {
            verbose = true
            i += 1
        } else if arg == "-short" || arg == "-failfast" {
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            i += 1
        } else {
            files.push(arg)
            i += 1
        }
    }

    if files.len == 0 {
        println("error: xu test requires at least one source file")
        << 1
    }

    if list_only {
        for fi in 0:files.len {
            src := os.read(files[fi]) or (err) {
                println("error: cannot read file: " + files[fi])
                <<< 1
            }
            $toks := []token.Token{}
        lexer.lex(src, $&toks, files[fi])
            $file_ast_toks := []ast.Token{}
            for ti in 0:toks.len {
                file_ast_toks.push(ast.Token{
                    kind: toks[ti].kind,
                    line: toks[ti].line,
                    col: toks[ti].col,
                    ival: toks[ti].ival,
                    sval: ~toks[ti].sval
                })
            }
            $p_sub := parser.new_parser(file_ast_toks)
            p_sub.parse_module()
            for di in 0:p_sub.decls.len {
                d := p_sub.decls[di]
                if p_sub.nodes[d].kind == ast.NK_FN && p_sub.nodes[d].d < 0 {
                    fn_name := p_sub.nodes[d].sval + ""
                    if is_test_fn(&fn_name) {
                        println(fn_name)
                    }
                }
            }
        }
        << 0
    }

    $explicit_t := target.target_host()
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            println("xu test: unknown target '" + target_name + "'")
            << 1
        }
        explicit_t = target.target_from_code(code)
    }
    t := resolve_target(target_set, &explicit_t)

    host := target.target_host()
    if t.os == target.OS_NONE {
        println("xu test: not available on freestanding targets")
        << 1
    }
    if t.os != host.os || t.arch != host.arch {
        println("xu test: cannot run cross-compiled tests (target differs from host); use build")
        << 1
    }

    files_len := files.len
    $test_tmp_bin := "/tmp/xu_test_app"
    if t.os == target.OS_WINDOWS {
        test_tmp_bin = "xu_test_app.exe"
    }
    code := target.target_code(t.os, t.arch)
    res := run_build_with_chip(&files, files_len, test_tmp_bin + "", code, target.CHIP_NATIVE, false, opt_level_zero, false, false)
    if res != 0 {
        << res
    }
    $cmd := exec.command(~test_tmp_bin)
    test_rc := cmd.run() or (err) {
        println("FAIL: test execution failed")
        <<< 1
    }
    for fi in 0:files.len {
        println("PASS: " + files[fi])
    }
    println("ok (all tests passed)")
    << 0
}

fn default_object_output(files &[]string) string {
    for i in 0:files.len {
        if filepath.base(&files[i]) == "main.xu" {
            << "main"
        }
    }
    $name := filepath.base(&files[0])
    if str_ends_with(&name, ".xu") {
        name = name[0:name.len - 3]
    }
    if name.len == 0 || name == "." || name == ".." || name == "/" {
        << "a"
    }
    << name
}

fn convert_desktop_object(args &[]string, os_code int) int {
    if args.len != 4 {
        eprintln("usage: xu " + args[1] + " INPUT.xuobj OUTPUT.o")
        << 1
    }
    data := os.read(~args[2]) or (err) {
        eprintln("xu " + args[1] + ": " + err.msg())
        << 1
    }
    object := obj.convert_app_object(&data, os_code) or (err) {
        eprintln("xu " + args[1] + ": " + err.msg())
        << 1
    }
    os.write(~args[3], object.to_string()) or (err) {
        eprintln("xu " + args[1] + ": " + err.msg())
        << 1
    }
    << 0
}

fn run_desktop_build(src &string, code int, output &string, webview bool, www &string) int {
    tool := "xu-desktop"
    $bin := toolpath.sibling(&tool) or (err) {
        eprintln("xu build: " + err.msg())
        << 127
    }
    if bin.len == 0 {
        bin = ~tool
    }
    $args := ["pack", ~src, "--target", target.target_name(code)]
    if output.len > 0 {
        args.push("-o")
        args.push(~output)
    }
    if www.len > 0 {
        args.push("--www")
        args.push(~www)
    }
    if webview {
        args.push("--webview")
    } else {
        args.push("--no-webview")
    }
    << run_program(&bin, &args)
}

pub fn run_cli(args &[]string) int {
    if args.len <= 1 {
        print_help()
        << 0
    }

    subcmd := args[1]

    if subcmd == "_macho_o" {
        << convert_desktop_object(args, target.OS_MACOS)
    }
    if subcmd == "_coff_o" {
        << convert_desktop_object(args, target.OS_WINDOWS)
    }
    if subcmd == "_elf_o" {
        << convert_desktop_object(args, target.OS_LINUX)
    }

    if subcmd == "version" || subcmd == "-v" || subcmd == "--version" || subcmd == "-version" || subcmd == "--ver" {
        << print_version()
    }

    if subcmd == "help" || subcmd == "-h" || subcmd == "--help" {
        if args.len > 2 {
            sub2 := args[2]
            if sub2 == "get" {
                print_get_help()
                << 0
            }
            if sub2 == "install" {
                print_install_help()
                << 0
            }
            if sub2 == "debug" {
                print_debug_help()
                << 0
            }
            if sub2 == "build" {
                print_help()
                << 0
            }
            if sub2 == "test" {
                print_help()
                << 0
            }
            if sub2 == "env" {
                print_env_help()
                << 0
            }
        }
        print_help()
        << 0
    }

    if subcmd == "env" {
        << run_env(args)
    }

    if subcmd == "init" {
        << run_init(args)
    }

    if subcmd == "get" {
        << run_get(args)
    }

    if subcmd == "install" {
        << run_install(args)
    }

    if subcmd == "check" {
        << run_check_cli(args)
    }

    if subcmd == "run" {
        if args.len <= 2 {
            println("error: xu run requires a source file")
            << 1
        }
        $files := []string{}
        $target_set := false
        $target_name := ""
        $opt_level_zero := false
        $program_args := []string{}
        $xacp_port := -1
        $after_sep := false

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if after_sep {
                program_args.push(arg)
                i += 1
            } else if arg == "--" {
                after_sep = true
                i += 1
            } else if arg == "--xacp" {
                if xacp_port < 0 { xacp_port = 0 }
                i += 1
            } else if arg == "--xacp-port" || str_starts_with(&arg, "--xacp-port=") {
                xacp_port = xacp_option_port(args, i)
                if xacp_port < 0 {
                    eprintln("xu run: --xacp-port requires an integer in 0..65535")
                    << 1
                }
                i += xacp_option_width(&arg)
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else if str_starts_with(&arg, "--target=") {
                target_name = arg[9:arg.len]
                target_set = true
                i += 1
            } else if str_starts_with(&arg, "-target=") {
                target_name = arg[8:arg.len]
                target_set = true
                i += 1
            } else if is_optimization_level(&arg) {
                opt_level_zero = arg == "-O0"
                i += 1
            } else {
                files.push(arg)
                i += 1
            }
        }

        if files.len == 0 {
            println("error: xu run requires a source file")
            << 1
        }

        $explicit_t := target.target_host()
        if target_set {
            code := target.parse_target(target_name)
            if code < 0 {
                println("xu run: unknown target '" + target_name + "'")
                << 1
            }
            explicit_t = target.target_from_code(code)
        }
        t := resolve_target(target_set, &explicit_t)

        host := target.target_host()
        if t.os == target.OS_NONE {
            println("xu run: not available on freestanding targets")
            << 1
        }
        if t.os != host.os || t.arch != host.arch {
            println("xu run: cannot run cross-compiled binary (target differs from host); use build")
            << 1
        }

        temp_dir := os.temp_dir()
        temp_path := abs_path(&temp_dir)
        $run_tmp_bin := temp_path + "/xu-run-" + str(os.getpid()) + "-" + str(now_ns())
        if t.os == target.OS_WINDOWS {
            run_tmp_bin = run_tmp_bin + ".exe"
        }
        files_len := files.len
        code := target.target_code(t.os, t.arch)
        res := build_program(&files, files_len, ~run_tmp_bin, code, target.CHIP_NATIVE, false, opt_level_zero, false, false, true, false, xacp_port)
        if res != 0 {
            << res
        }
        rc := run_program(&run_tmp_bin, &program_args)
        remove_created_file(&run_tmp_bin)
        << rc
    }
    if subcmd == "test" {
        << run_test(args)
    }
    if subcmd == "debug" {
        << run_debug(args)
    }
    if subcmd == "build" {
        if args.len <= 2 {
            println("error: xu build requires at least one source file (args <= 2)")
            << 1
        }
        $files := []string{}
        $out_file := ""
        $out_file_set := false
        $target_set := false
        $target_name := ""
        $chip_set := false
        $chip_name := ""
        // Release (the default) or debug build; --no-opt only disables
        // optimization.
        $is_debug_mode := false
        $no_opt := false
        $opt_level_zero := false
        $emit_dwarf := false
        $emit_object := false
        $desktop := false
        $webview := false
        $no_webview := false
        $www := ""
        $is_verbose := false
        $xacp_port := -1

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if arg == "-h" || arg == "--help" {
                print_help()
                << 0
            } else if (arg == "-o" || arg == "--output") && i + 1 < args.len {
                out_file = ~args[i + 1]
                out_file_set = true
                i += 2
            } else if str_starts_with(&arg, "--output=") {
                out_file = arg[9:arg.len]
                out_file_set = true
                i += 1
            } else if str_starts_with(&arg, "-o=") {
                out_file = arg[3:arg.len]
                out_file_set = true
                i += 1
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else if str_starts_with(&arg, "--target=") {
                target_name = arg[9:arg.len]
                target_set = true
                i += 1
            } else if str_starts_with(&arg, "-target=") {
                target_name = arg[8:arg.len]
                target_set = true
                i += 1
            } else if (arg == "--chip" || arg == "-chip" || arg == "--cpu" || arg == "-cpu" || arg == "-march" || arg == "-mcpu") && i + 1 < args.len {
                chip_name = ~args[i + 1]
                chip_set = true
                i += 2
            } else if str_starts_with(&arg, "--chip=") {
                chip_name = arg[7:arg.len]
                chip_set = true
                i += 1
            } else if str_starts_with(&arg, "--cpu=") {
                chip_name = arg[6:arg.len]
                chip_set = true
                i += 1
            } else if str_starts_with(&arg, "-march=") {
                chip_name = arg[8:arg.len]
                chip_set = true
                i += 1
            } else if str_starts_with(&arg, "-mcpu=") {
                chip_name = arg[7:arg.len]
                chip_set = true
                i += 1
            } else if arg == "--release" {
                is_debug_mode = false
                i += 1
            } else if arg == "--debug-build" {
                is_debug_mode = true
                i += 1
            } else if is_optimization_level(&arg) {
                opt_level_zero = arg == "-O0"
                i += 1
            } else if arg == "--ra=1" {
                // The typed backend has one allocator for optimized builds.
                i += 1
            } else if arg == "--no-opt" {
                no_opt = true
                i += 1
            } else if arg == "-g" || arg == "--debug" {
                emit_dwarf = true
                i += 1
            } else if arg == "--emit-obj" {
                emit_object = true
                i += 1
            } else if arg == "--xacp" {
                if xacp_port < 0 { xacp_port = 0 }
                i += 1
            } else if arg == "--xacp-port" || str_starts_with(&arg, "--xacp-port=") {
                xacp_port = xacp_option_port(args, i)
                if xacp_port < 0 {
                    eprintln("xu build: --xacp-port requires an integer in 0..65535")
                    << 1
                }
                i += xacp_option_width(&arg)
            } else if arg == "--desktop" || arg == "--no-desktop" {
                desktop = arg == "--desktop"
                i += 1
            } else if arg == "--webview" {
                webview = true
                i += 1
            } else if arg == "--no-webview" {
                no_webview = true
                i += 1
            } else if arg == "--www" && i + 1 < args.len {
                www = ~args[i + 1]
                i += 2
            } else if arg == "-v" || arg == "--verbose" {
                is_verbose = true
                i += 1
            } else if arg.len > 0 && arg[0] == 45 {
                eprintln("xu build: unsupported or incomplete option '" + arg + "'")
                << 1
            } else {
                files.push(arg)
                i += 1
            }
        }

        files_count := files.len
        if files_count == 0 {
            println("error: xu build requires at least one source file (files == 0)")
            << 1
        }

        // Resolve --target before environment defaults. With neither set,
        // build for the compiler's own host target.
        $explicit_target := target.target_host()
        if target_set {
            code := target.parse_target(target_name)
            if code < 0 {
                println("xu build: unknown target '" + target_name + "'")
                << 1
            }
            explicit_target = target.target_from_code(code)
        }
        resolved_target := resolve_target(target_set, &explicit_target)
        tgt_os := resolved_target.os
        tgt_arch := resolved_target.arch
        code := target.target_code(tgt_os, tgt_arch)

        disable_optimization := no_opt || opt_level_zero
        dwarf := emit_dwarf || is_debug_mode
        if desktop {
            if xacp_port >= 0 {
                eprintln("xu build: --xacp requires building the app binary directly")
                << 1
            }
            if files_count != 1 {
                eprintln("xu build: --desktop takes exactly one app directory or .xu file")
                << 1
            }
            if emit_object {
                eprintln("xu build: --desktop conflicts with --emit-obj")
                << 1
            }
            if disable_optimization || dwarf || chip_set {
                eprintln("xu build: --desktop does not accept custom optimization, debug, or chip options")
                << 1
            }
            << run_desktop_build(&files[0], code, &out_file, webview && !no_webview, &www)
        }
        if webview || no_webview || www.len > 0 {
            eprintln("xu build: WebView and resource options require --desktop")
            << 1
        }

        $selected_chip := target.CHIP_NATIVE
        if chip_set {
            parsed_chip := target.parse_chip(chip_name)
            if parsed_chip < 0 {
                println("xu build: unknown chip/cpu '" + chip_name + "'")
                << 1
            }
            selected_chip = parsed_chip
        }

        if emit_object {
            if !out_file_set {
                out_file = default_object_output(&files)
            }
        } else if tgt_os == target.OS_WINDOWS {
            if !out_file_set {
                out_file = "a.exe"
            } else {
                if str_ends_with(&out_file, ".xin") {
                    out_file = out_file[0:out_file.len - 4] + ".exe"
                } else if !str_ends_with(&out_file, ".exe") {
                    out_file = out_file + ".exe"
                }
            }
        } else {
            if !out_file_set {
                if tgt_arch == target.ARCH_WASM {
                    out_file = "a.wasm"
                } else {
                    out_file = "a.out"
                }
            }
        }

        << build_program(&files, files_count, out_file, code, selected_chip, is_debug_mode, disable_optimization, dwarf, is_verbose, false, emit_object, xacp_port)
    }

    is_sibling := subcmd == "fmt" || subcmd == "doc" || subcmd == "map" || subcmd == "doctor" || subcmd == "native" || subcmd == "xacp" || subcmd == "lsp" || subcmd == "setup" || subcmd == "up" || subcmd == "update"
    if is_sibling {
        $has_help := false
        for hi in 2:args.len {
            if args[hi] == "-h" || args[hi] == "--help" {
                has_help = true
                <-
            }
        }
        if has_help {
            if subcmd == "up" || subcmd == "update" {
                print_update_help()
                << 0
            }
        }
        $sibling_name := "xu-" + subcmd
        if subcmd == "up" || subcmd == "update" {
            sibling_name = "xu-update"
        }
        $cmd := exec.command(~sibling_name)
        for i in 2:args.len {
            cmd.args.push(~args[i])
        }
        rc := cmd.run() or (err) {
            println("xu: sibling tool '" + sibling_name + "' not found or failed to execute")
            <<< 127
        }
        << rc
    }

    println("unknown command: " + subcmd)
    print_help()
    << 1
}

fn run_check_cli(args &[]string) int {
    $files := []string{}
    $target_name := ""
    $target_set := false
    $lib_mode := 0
    $i := 2
    while i < args.len {
        arg := ~args[i]
        if arg == "-h" || arg == "--help" {
            println("usage: xu check [--lib] [--target TARGET] <input.xu or dir>...")
            << 0
        } else if arg == "--lib" {
            lib_mode = 1
            i += 1
        } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
            target_name = ~args[i + 1]
            target_set = true
            i += 2
        } else if str_starts_with(&arg, "--target=") || str_starts_with(&arg, "-target=") {
            $start := 9
            if arg[1] != 45 {
                start = 8
            }
            target_name = arg[start:arg.len]
            target_set = true
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            eprintln("xu check: unsupported or incomplete option '" + arg + "'")
            << 1
        } else {
            files.push(arg)
            i += 1
        }
    }
    if files.len == 0 {
        eprintln("xu check: expected a source file or module directory")
        << 1
    }
    $explicit := target.target_host()
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            eprintln("xu check: unknown target '" + target_name + "'")
            << 1
        }
        explicit = target.target_from_code(code)
    }
    selected := resolve_target(target_set, &explicit)
    code := target.target_code(selected.os, selected.arch)
    << check_inputs(&files, files.len, code, lib_mode)
}

pub fn run_check(files &[]string, files_count int) int {
    host := target.target_host()
    << check_inputs(files, files_count, target.target_code(host.os, host.arch), 0)
}

fn check_inputs(files &[]string, count int, code int, lib_mode int) int {
    $p := parser.new_parser([]ast.Token{})
    load_unit(files, count, code, false, -1, $&p) or (err) {
        eprintln("xu check: " + err.msg())
        << 1
    }
    $chk := types.Checker{}
    types.check_only(&p, code, lib_mode, $&chk)
    println("Checked " + str(p.file_names.len) + " file(s): " + str(p.decls.len) + " declaration(s) OK")
    << 0
}

fn is_test_fn(name &string) bool {
    if name.len >= 5 {
        if name[0] == 116 && name[1] == 101 && name[2] == 115 && name[3] == 116 && name[4] == 95 {
            << true
        }
    }
    << false
}

fn is_dot_o(s string) bool {
    if s.len >= 2 {
        if s[s.len - 2] == 46 && s[s.len - 1] == 111 {
            << true
        }
    }
    << false
}

fn abs_source_path(path string, cwd string) string {
    if path.len > 0 && path[0] == 47 {
        << path + ""
    }
    if str_starts_with(&path, "./") {
        << cwd + "/" + path[2:path.len]
    }
    << cwd + "/" + path
}

fn int_in(xs &[]int, v int) bool {
    for i in 0:xs.len {
        if xs[i] == v { << true }
    }
    << false
}

fn dwarf_type_code(ty int) int {
    if ty == 2 { << obj.DWARF_TY_BOOL }
    if ty == 4 { << obj.DWARF_TY_F64 }
    if ty == 10 { << obj.DWARF_TY_U8 }
    if ty == 8 { << obj.DWARF_TY_I32 }
    if ty == 9 { << obj.DWARF_TY_U32 }
    if ty == 3 { << obj.DWARF_TY_STR }
    if types.is_ref_type(ty) { << obj.DWARF_TY_PTR }
    << obj.DWARF_TY_INT
}

// Source-level locals only: compiler-made ones are named ".<what>".
fn dwarf_local_shown(f &mir.MFn, i int) bool {
    if i >= f.local_names.len { << false }
    name := f.local_names[i]
    if name.len == 0 || name == "_" {
        << false
    }
    for ci in 0:name.len {
        ch := name[ci]
        if !((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95) {
            << false
        }
    }
    << true
}

fn collect_debug_info(p &parser.Parser, m &mir.Mir, syms &mc.SymbolTable, line_rows &[]int, fn_rows &[]int, code_len int, fp_reg int) obj.DebugInfo {
    cwd := os.getwd()
    $files := []string{}
    for i in 0:p.file_names.len {
        files.push(abs_source_path(p.file_names[i], cwd))
    }
    $rows := []obj.DLineRow{}
    $funcs := []obj.DFuncRow{}
    for fi in 0:m.fns.len {
        if m.fns[fi].src_line <= 0 {
            ->
        }
        start := syms.lookup_offset(m.fns[fi].label)
        $end := code_len
        if fi + 1 < m.fns.len {
            end = syms.lookup_offset(m.fns[fi + 1].label)
        } else {
            stubs := syms.lookup_offset("__xu_start")
            if stubs > start {
                end = stubs
            }
        }
        $ri := fn_rows[fi]
        $rend := line_rows.len
        if fi + 1 < fn_rows.len {
            rend = fn_rows[fi + 1]
        }
        while ri + 1 < rend {
            rows.push(obj.DLineRow{offset: line_rows[ri], file: m.fns[fi].src_file, line: line_rows[ri + 1]})
            ri += 2
        }
        $locals := []obj.DLocalRow{}
        offs := codegen.frame_local_fp_offsets(&m.fns[fi])
        for li in 0:m.fns[fi].locals.len {
            if !dwarf_local_shown(&m.fns[fi], li) || li >= offs.len {
                ->
            }
            locals.push(obj.DLocalRow{name: m.fns[fi].local_names[li] + "", fp_off: offs[li], line: m.fns[fi].src_line, ty: dwarf_type_code(m.fns[fi].locals[li]), is_param: int_in(&m.fns[fi].param_locals, li)})
        }
        funcs.push(obj.DFuncRow{name: m.fns[fi].name + "", file: m.fns[fi].src_file, line: m.fns[fi].src_line, start: start, size: end - start, locals: locals})
    }
    << obj.DebugInfo{files: files, rows: rows, funcs: funcs, fp_reg: fp_reg}
}

pub fn run_build(files &[]string, files_count int, out_file string, target_code int, is_debug bool, is_verbose bool) int {
    << run_build_with_chip(files, files_count, out_file, target_code, target.CHIP_NATIVE, is_debug, is_debug, is_debug, is_verbose)
}

// is_debug: a debug build (unoptimized, runtime memory checks on).
// no_opt: disable optimization only.
// dwarf: emit DWARF line tables, functions and locals (-g).
pub fn run_build_with_chip(files &[]string, files_count int, out_file string, target_code int, chip_id int, is_debug bool, no_opt bool, dwarf bool, is_verbose bool) int {
    << build_program(files, files_count, out_file, target_code, chip_id, is_debug, no_opt, dwarf, is_verbose, false, false, -1)
}

fn object_import(r &mc.Reloc, tgt_os int, arch int, link_ui bool) bool {
    if r.addend != 0 {
        << false
    }
    if arch == target.ARCH_ARM64 && r.kind != mc.RELOC_ARM64_CALL26 {
        << false
    }
    if arch == target.ARCH_X64 && r.kind != mc.RELOC_X64_PC32 {
        << false
    }
    $name := r.symbol_name + ""
    if tgt_os == target.OS_WINDOWS {
        if str_starts_with(&name, "_iat_") ||
            (arch == target.ARCH_ARM64 && codegen.arm64_win_api_import(&name)) { << true }
    } else if tgt_os == target.OS_MACOS {
        if name == "__NSGetEnviron" || name == "_clock_gettime" { << true }
        if name.len == 0 || name[0] != 95 { << false }
        name = name[1:name.len]
    }
    << link_ui && (name == "xu_ui_host_run_cooperative" || name == "xu_ui_mem_try_read_len" ||
        name == "xu_ui_mem_try_read_copy" || name == "xu_ui_mem_try_write")
}

fn build_program(files &[]string, files_count int, out_file string, target_code int, chip_id int, is_debug bool, no_opt bool, dwarf bool, is_verbose bool, temporary bool, emit_object bool, xacp_port int) int {
    tgt_os := target.target_os(target_code)
    tgt_arch := target.target_arch(target_code)
    if xacp_port >= 0 && tgt_os != target.OS_MACOS && tgt_os != target.OS_LINUX && tgt_os != target.OS_WINDOWS {
        eprintln("xu build: --xacp requires a native macOS, Linux, or Windows target")
        << 1
    }
    app_obj := (tgt_os == target.OS_MACOS || tgt_os == target.OS_LINUX || tgt_os == target.OS_WINDOWS) &&
        (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64)
    if emit_object && !app_obj {
        eprintln("xu build: --emit-obj supports arm64 and x64 Linux, macOS, and Windows")
        << 1
    }
    if emit_object && dwarf {
        eprintln("xu build: DWARF is unavailable with --emit-obj")
        << 1
    }
    link_ui := emit_object && os.getenv("XU_UI_PACK") == "1"
    tgt_spec := target.target_new_with_chip(tgt_os, tgt_arch, chip_id)

    $actual_out := out_file
    if !emit_object && tgt_os == target.OS_WINDOWS {
        if str_ends_with(&actual_out, ".xin") {
            actual_out = actual_out[0:actual_out.len - 4] + ".exe"
        } else if !str_ends_with(&actual_out, ".exe") {
            actual_out = actual_out + ".exe"
        }
    }

    tm := mir.TargetModel{
        ptr_size: tgt_spec.pointer_size,
        has_cond_select: tgt_spec.features.has_cond_select,
        has_fast_mul: tgt_spec.features.has_fast_mul,
        has_fused_madd: tgt_spec.features.has_fused_alu,
        unroll_factor: tgt_spec.features.unroll_factor,
        vector_bits: tgt_spec.features.vector_bits,
        has_crypto_aes: tgt_spec.features.has_crypto_aes,
        has_crypto_sha2: tgt_spec.features.has_crypto_sha2,
        has_crc32: tgt_spec.features.has_crc32,
        has_lse: tgt_spec.features.has_lse,
        has_bmi2: tgt_spec.features.has_bmi2,
        has_dsp: tgt_spec.features.has_dsp
    }

    $passes := PassConfig{
        const_fold: true,
        regalloc: true,
        dce: true,
        chip_features: true,
        chip_fusion: true,
        licm: true,
        tile: true,
        inlining: true,
        sroa: true,
        cfg: true,
        cse: true,
        is_debug: false,
        print_passes: false
    }
    if is_debug || no_opt {
        passes.const_fold = false
        passes.licm = false
        passes.tile = false
        passes.inlining = false
        passes.sroa = false
        passes.cfg = false
        passes.cse = false
        passes.chip_fusion = false
        passes.is_debug = is_debug
    }
    if is_verbose {
        passes.print_passes = true
        $feat_desc := ""
        if tgt_spec.features.has_crypto_aes { feat_desc = feat_desc + "+aes" }
        if tgt_spec.features.has_crypto_sha2 { feat_desc = feat_desc + "+sha2" }
        if tgt_spec.features.has_crypto_sm4 { feat_desc = feat_desc + "+sm4" }
        if tgt_spec.features.has_crc32 { feat_desc = feat_desc + "+crc32" }
        if tgt_spec.features.has_lse { feat_desc = feat_desc + "+lse" }
        if tgt_spec.features.has_bmi2 { feat_desc = feat_desc + "+bmi2" }
        if tgt_spec.features.has_dsp { feat_desc = feat_desc + "+dsp" }
        if feat_desc.len > 0 {
            println("info: target=" + target.target_name(target_code) + " chip=" + target.chip_name(tgt_spec.chip) + " features=[" + feat_desc + "]")
        } else {
            println("info: target=" + target.target_name(target_code) + " chip=" + target.chip_name(tgt_spec.chip))
        }
    }

    $cb := mc.code_buffer_new()
    $syms := mc.symbol_table_new()
    $relocs := []mc.Reloc{}

    $p := parser.new_parser([]ast.Token{})
    load_unit(files, files_count, target_code, true, xacp_port, $&p) or (err) {
        eprintln("xu build: " + err.msg())
        << 1
    }

    if p.decls.len == 0 {
        println("error: no declarations parsed")
        << 1
    }

    $tgt_ok := (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64) && (tgt_os == target.OS_MACOS || tgt_os == target.OS_LINUX)
    if tgt_os == target.OS_WINDOWS && (tgt_arch == target.ARCH_X64 || tgt_arch == target.ARCH_ARM64) {
        tgt_ok = true
    }
    if tgt_arch == target.ARCH_WASM && tgt_os == target.OS_WASI {
        tgt_ok = true
    }
    if (tgt_arch == target.ARCH_RISCV64 || tgt_arch == target.ARCH_LOONG64) && tgt_os == target.OS_LINUX {
        tgt_ok = true
    }
    if (tgt_arch == target.ARCH_RISCV32 || tgt_arch == target.ARCH_THUMB || tgt_arch == target.ARCH_XTENSA) && tgt_os == target.OS_NONE {
        tgt_ok = true
    }
    if !tgt_ok {
        eprintln("error: the typed backend currently targets arm64 and x64 macOS/Linux/Windows, riscv64/loong64 Linux, wasm32-wasi and riscv32/thumb/xtensa bare metal only")
        << 1
    }

    $chk := types.Checker{}
    $tp := types.typed_program_new()
    types.check_typed(&p, target_code, 0, $&chk, $&tp)

    $mir_unit := mir.Mir{fns: []mir.MFn{}}
    lower_errors := mir.lower_typed(&p, $&tp, tgt_os, tgt_arch, os.getenv("XU_LOWER_ALL") == "1", is_debug, $&mir_unit)
    if lower_errors > 0 {
        println("error: " + str(lower_errors) + " construct(s) cannot be lowered yet")
        <<< 1
    }

    $has_main := false
    for mi in 0:mir_unit.fns.len {
        if mir_unit.fns[mi].label == "_xu_main" {
            has_main = true
        }
    }
    if !has_main {
        println("error: no main function")
        << 1
    }

    // Optimization passes assume the old untyped value model; the typed
    // pipeline runs without them until they are ported.
    // line_rows: (code offset, line) pairs; fn_rows[i] is where function
    // i's pairs start.
    $line_rows := []int{}
    $fn_rows := []int{}
    // -g describes locals by frame offset, so it keeps them in memory.
    use_ra := !is_debug && !no_opt && !dwarf && os.getenv("XU_NO_RA") != "1"
    if use_ra {
        for fi in 0:mir_unit.fns.len {
            mir.opt_fold($&mir_unit.fns[fi])
            if mir.opt_bce($&mir_unit.fns[fi], tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64) {
                mir.opt_fold($&mir_unit.fns[fi])
            }
        }
    }
    if tgt_arch == target.ARCH_WASM {
        if codegen.emit_wasm_module(&mir_unit, $&cb, "_xu_main") > 0 {
            <<< 1
        }
        os.write(~actual_out, cb.to_string()) or (err) {
            println("error: cannot write module to " + actual_out)
            <<< 1
        }
        println("Build complete: " + actual_out)
        <<< 0
    }
    if tgt_arch == target.ARCH_X64 {
        for opt_i in 0:mir_unit.fns.len {
            fn_rows.push(line_rows.len)
            codegen.isel_fn_x64_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows, use_ra)
        }
        codegen.emit_x64_runtime_stubs($&cb, $&syms, $&relocs, tgt_os, "_xu_main", link_ui, emit_object)
        if emit_object {
            if tgt_os == target.OS_WINDOWS {
                codegen.emit_windows_x64_entry($&cb, $&syms, $&relocs)
            } else if tgt_os == target.OS_MACOS {
                codegen.emit_macos_x64_entry($&cb, $&syms, $&relocs)
            }
        }
        if use_ra {
            codegen.emit_x64_vec_stubs($&cb, $&syms)
        }
    } else if tgt_arch == target.ARCH_RISCV64 {
        for opt_i in 0:mir_unit.fns.len {
            fn_rows.push(line_rows.len)
            codegen.isel_fn_rv64_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows)
        }
        codegen.emit_rv64_runtime_stubs($&cb, $&syms, $&relocs, "_xu_main")
    } else if tgt_arch == target.ARCH_LOONG64 {
        for opt_i in 0:mir_unit.fns.len {
            fn_rows.push(line_rows.len)
            codegen.isel_fn_la64_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows)
        }
        codegen.emit_la64_runtime_stubs($&cb, $&syms, $&relocs, "_xu_main")
    } else if tgt_arch == target.ARCH_RISCV32 {
        codegen.emit_rv32_reset($&cb, $&relocs)
        for opt_i in 0:mir_unit.fns.len {
            fn_rows.push(line_rows.len)
            codegen.isel_fn_rv32_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows)
        }
        codegen.emit_rv32_runtime_stubs($&cb, $&syms, $&relocs, "_xu_main")
    } else if tgt_arch == target.ARCH_THUMB {
        codegen.emit_thumb_vectors($&cb, $&relocs)
        for opt_i in 0:mir_unit.fns.len {
            fn_rows.push(line_rows.len)
            codegen.isel_fn_thumb_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows)
        }
        codegen.emit_thumb_runtime_stubs($&cb, $&syms, $&relocs, "_xu_main")
    } else if tgt_arch == target.ARCH_XTENSA {
        codegen.emit_xtensa_vectors($&cb)
        for opt_i in 0:mir_unit.fns.len {
            fn_rows.push(line_rows.len)
            codegen.isel_fn_xtensa_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows)
        }
        codegen.emit_xtensa_runtime_stubs($&cb, $&syms, $&relocs, "_xu_main")
    } else {
        for opt_i in 0:mir_unit.fns.len {
            fn_rows.push(line_rows.len)
            codegen.isel_fn_arm64_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows, use_ra)
        }
        if tgt_os == target.OS_WINDOWS {
            codegen.emit_arm64_windows_stubs($&cb, $&syms, $&relocs, "_xu_main", link_ui, emit_object)
            if emit_object {
                codegen.emit_windows_arm64_entry($&cb, $&syms, $&relocs)
            }
        } else {
            codegen.emit_arm64_runtime_stubs($&cb, $&syms, $&relocs, tgt_os, "_xu_main", link_ui, emit_object)
            if emit_object && tgt_os == target.OS_MACOS {
                codegen.emit_macos_arm64_entry($&cb, $&syms, $&relocs)
            }
        }
        if use_ra {
            codegen.emit_arm64_vec_stubs($&cb, $&syms)
        }
    }

    $macho_cpu := obj.MACHO_CPU_TYPE_ARM64
    if tgt_arch == target.ARCH_X64 {
        macho_cpu = obj.MACHO_CPU_TYPE_X86_64
    }
    if tgt_os == target.OS_MACOS && !emit_object {
        syms.define_label(codegen.MACOS_CLOCK_SLOT, obj.macho_clock_slot_offset(cb.len(), macho_cpu, dwarf))
    }
    $object_imports := []mc.Reloc{}
    $unresolved_count := 0
    $ri := 0
    while ri < relocs.len {
        target_off := syms.lookup_offset(relocs[ri].symbol_name)
        if target_off >= 0 {
            mc.apply_reloc($&cb, &relocs[ri], target_off)
        } else if emit_object && object_import(&relocs[ri], tgt_os, tgt_arch, link_ui) {
            object_imports.push(~relocs[ri])
        } else {
            println("unresolved symbol: " + relocs[ri].symbol_name)
            unresolved_count += 1
        }
        ri += 1
    }
    if unresolved_count > 0 {
        // An unresolved relocation means the emitted binary calls a symbol that
        // does not exist: it links, then jumps to address zero at run time.
        // Failing the build keeps that class of defect out of released SDKs.
        println("total unresolved symbol relocations: " + str(unresolved_count))
        <<< 1
    }
    // MPS2 AN386 code SRAM is 4 MiB and mirrored above, so a larger image
    // overwrites its own vector table when loaded.
    if tgt_arch == target.ARCH_THUMB && cb.len() > 4 * 1024 * 1024 {
        println("error: thumb image is " + str(cb.len()) + " bytes; the MPS2 AN386 code memory holds 4194304")
        <<< 1
    }
    if tgt_arch == target.ARCH_XTENSA && cb.len() > codegen.XT_CODE_MAX {
        println("error: xtensa image is " + str(cb.len()) + " bytes; the ESP32 IRAM holds " + str(codegen.XT_CODE_MAX))
        <<< 1
    }

    sym_map_path := os.getenv("XU_SYMMAP")
    if sym_map_path.len > 0 {
        $map_text := ""
        // Code-buffer offsets; backtraces print offsets from __xu_start.
        map_text.push_str(str(syms.lookup_offset("__xu_start")) + " __xu_start\n")
        for mfi in 0:mir_unit.fns.len {
            off := syms.lookup_offset(mir_unit.fns[mfi].label)
            map_text.push_str(str(off) + " " + mir_unit.fns[mfi].label + "\n")
        }
        os.write(~sym_map_path, map_text) or (err) {
            println("error: cannot write symbol map " + sym_map_path)
            << 1
        }
    }
    if emit_object {
        $entry_name := "_xu_app_start"
        if tgt_os != target.OS_MACOS {
            entry_name = "xu_app_start"
        }
        entry := syms.lookup_offset(entry_name + "")
        object := obj.write_xuobj(&cb, tgt_os, tgt_arch, entry_name, entry, &object_imports)
        os.write(~actual_out, object.to_string()) or (err) {
            eprintln("xu build: cannot write object to " + actual_out + ": " + err.msg())
            << 1
        }
        println("Build complete: " + actual_out)
        << 0
    }
    $entry_off := syms.lookup_offset("__xu_start")
    if entry_off < 0 {
        entry_off = 0
    }

    $dbg := obj.debug_sections_empty()
    if dwarf && (tgt_os == target.OS_LINUX || tgt_os == target.OS_MACOS) {
        $code_vaddr := obj.elf_code_vaddr()
        if tgt_os == target.OS_MACOS {
            code_vaddr = obj.macho_code_vaddr(true)
        }
        $fp_reg := obj.DWARF_REG_ARM64_FP
        if tgt_arch == target.ARCH_X64 {
            fp_reg = obj.DWARF_REG_X64_RBP
        } else if tgt_arch == target.ARCH_RISCV64 {
            fp_reg = obj.DWARF_REG_RISCV_FP
        } else if tgt_arch == target.ARCH_LOONG64 {
            fp_reg = obj.DWARF_REG_LOONG_FP
        }
        di := collect_debug_info(&p, &mir_unit, &syms, &line_rows, &fn_rows, cb.len(), fp_reg)
        dbg = obj.encode_dwarf(&di, code_vaddr, cb.len())
    }

    $bin_buf := mc.code_buffer_new()
    if tgt_os == target.OS_LINUX {
        $elf_mach := obj.ELF_EM_AARCH64
        if tgt_arch == target.ARCH_X64 {
            elf_mach = obj.ELF_EM_X86_64
        } else if tgt_arch == target.ARCH_RISCV64 || tgt_arch == target.ARCH_RISCV32 {
            elf_mach = obj.ELF_EM_RISCV
        } else if tgt_arch == target.ARCH_LOONG64 {
            elf_mach = obj.ELF_EM_LOONGARCH
        }
        bin_buf = obj.elf_write_executable_debug(&cb.bytes, elf_mach, entry_off, &dbg)
    } else if tgt_os == target.OS_WINDOWS {
        $pe_mach := obj.PE_MACHINE_AMD64
        if tgt_arch == target.ARCH_ARM64 {
            pe_mach = obj.PE_MACHINE_ARM64
        }
        imp_off := syms.lookup_offset("__pe_import_dir")
        iat_off := syms.lookup_offset("__pe_iat")
        imp_size := syms.lookup_offset("__pe_import_dir_end") - imp_off
        iat_size := syms.lookup_offset("__pe_iat_end") - iat_off
        bin_buf = obj.pe_write_executable_sized(&cb.bytes, pe_mach, entry_off, imp_off, imp_size, iat_off, iat_size)
    } else if tgt_os == target.OS_MACOS {
        $msyms := obj.macho_syms_empty()
        for mfi in 0:mir_unit.fns.len {
            off := syms.lookup_offset(mir_unit.fns[mfi].label)
            if off >= 0 {
                msyms.names.push(mir_unit.fns[mfi].label + "")
                msyms.offs.push(off)
            }
        }
        stub_names := ["__xu_start", "__xu_syscall", "__xu_task_switch", "__xu_task_entry", "__xu_syscall_os", "__xu_globals"]
        for sni in 0:stub_names.len {
            off := syms.lookup_offset(stub_names[sni])
            if off >= 0 {
                msyms.names.push(stub_names[sni] + "")
                msyms.offs.push(off)
            }
        }
        bin_buf = obj.macho_write_executable_debug(&cb.bytes, macho_cpu, entry_off, &msyms, &dbg)
    } else {
        // Freestanding / None / WASM / Embedded (ESP32, RISC-V 32, Thumb)
        if tgt_arch == target.ARCH_WASM {
            bin_buf = obj.wasm_write_module(&cb.bytes, entry_off)
        } else if tgt_arch == target.ARCH_XTENSA {
            // ESP32: vectors and code in IRAM from 0x40070000
            bin_buf = obj.elf32_write_executable(&cb.bytes, obj.ELF_MACHINE_XTENSA, entry_off, codegen.XT_CODE_BASE, obj.EF_XTENSA)
        } else if tgt_arch == target.ARCH_RISCV32 {
            bin_buf = obj.elf32_write_riscv32_executable(&cb.bytes, entry_off)
        } else if tgt_arch == target.ARCH_THUMB {
            // MPS2 AN386: the image (vector table first) runs from address 0
            bin_buf = obj.elf32_write_executable(&cb.bytes, obj.ELF_MACHINE_ARM32, entry_off, 0, obj.EF_ARM_EABI_VER5)
        } else {
            $elf_mach := obj.ELF_EM_AARCH64
            if tgt_arch == target.ARCH_X64 {
                elf_mach = obj.ELF_EM_X86_64
            } else if tgt_arch == target.ARCH_RISCV64 {
                elf_mach = obj.ELF_EM_RISCV
            }
            bin_buf = obj.elf_write_executable(&cb.bytes, elf_mach, entry_off)
        }
    }

    raw_str := bin_buf.to_string()

    if temporary {
        created := write_exclusive(&actual_out, &raw_str) or (err) {
            eprintln("xu run: " + err.msg())
            << 1
        }
        if !created {
            eprintln("xu run: temporary output already exists: " + actual_out)
            << 1
        }
    } else {
        os.write(~actual_out, raw_str) or (err) {
            eprintln("xu build: " + err.msg())
            << 1
        }
    }
    os.chmod(~actual_out, 493) or (err) { // 0755 permissions
        if temporary {
            remove_created_file(&actual_out)
        }
        eprintln("xu: " + err.msg())
        << 1
    }
    if !temporary {
        println("Build complete: " + actual_out)
    }
    << 0
}
