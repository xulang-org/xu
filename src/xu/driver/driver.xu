pub fn print_debug_help() {
    println("usage: xu debug [options] <input.xu...> [-- program-args...]")
    println("")
    println("Build a DWARF-enabled debug binary and start an interactive source debugger.")
    println("")
    println("Options:")
    println("  -b, --break SPEC     source location file.xu:LINE or function name")
    println("  -e, --eval COMMAND   execute a debugger command before the prompt (repeatable)")
    println("  --run                launch the program after applying debugger commands")
    println("  --batch              run in batch mode without interactive prompt")
    println("  --stop-at-entry      stop at the program entry point")
    println("  --backend PATH       use PATH instead of lldb (gdb is the fallback)")
    println("  --binary PATH        debug an existing executable; skip the build")
    println("  -o, --output PATH    keep the debug executable at PATH")
    println("  --target TARGET      host target to build (macos/linux/windows)")
    println("  -h, --help           show this message")
    println("")
    println("Examples:")
    println("  xu debug -b main.xu:8 main.xu")
    println("  xu debug -b main.xu:8 --run main.xu")
    println("  xu debug --binary ./app -e 'bt' -e 'frame variable'")
}

fn str_eq(a &string, b string) bool {
    if a.len != b.len {
        << false
    }
    for i in 0:a.len {
        if a[i] != b[i] {
            << false
        }
    }
    << true
}

fn str_starts_with(s &string, prefix string) bool {
    if s.len < prefix.len {
        << false
    }
    for i in 0:prefix.len {
        if s[i] != prefix[i] {
            << false
        }
    }
    << true
}

fn str_contains(s &string, substr string) bool {
    if substr.len == 0 {
        << true
    }
    if s.len < substr.len {
        << false
    }
    $limit := s.len - substr.len
    for i in 0:limit + 1 {
        $matched := true
        for j in 0:substr.len {
            if s[i + j] != substr[j] {
                matched = false
                <-
            }
        }
        if matched {
            << true
        }
    }
    << false
}

fn debug_find_backend(name string) string {
    res := exec.look_path(name) or (err) {
        << ""
    }
    << res
}

fn debug_remove(path &string) {
    p := ~path
    os.remove(p) or (err) {
        <<
    }
}

fn debug_break_command(spec &string, is_gdb bool) string {
    $split := -1
    for i in 0:spec.len {
        if spec[i] == 58 {
            split = i
        }
    }
    if split > 0 && split + 1 < spec.len {
        file := spec[0:split]
        line := spec[split + 1:spec.len]
        if is_gdb {
            << "break " + file + ":" + line
        }
        << "breakpoint set --file " + file + " --line " + line
    }
    if is_gdb {
        << "break " + spec
    }
    << "breakpoint set --name " + spec
}

pub fn run_debug(args &[]string) int {
    if args.len <= 2 {
        print_debug_help()
        << 0
    }
    $has_help := false
    for hi in 2:args.len {
        if args[hi] == "-h" || args[hi] == "--help" {
            has_help = true
            <-
        }
    }
    if has_help {
        print_debug_help()
        << 0
    }

    $files := []string{}
    $break_specs := []string{}
    $eval_cmds := []string{}
    $program_args := []string{}
    $output := ""
    $output_set := false
    $binary := ""
    $backend := ""
    $target_name := ""
    $target_set := false
    $launch := false
    $batch := false
    $stop_at_entry := false
    $after_sep := false

    $i := 2
    while i < args.len {
        arg := ~args[i]
        if after_sep {
            program_args.push(arg)
            i += 1
        } else if arg == "--" {
            after_sep = true
            i += 1
        } else if arg == "-b" || arg == "--break" {
            if i + 1 < args.len {
                break_specs.push(~args[i + 1])
                i += 2
            } else {
                println("xu debug: --break requires a location")
                << 1
            }
        } else if str_starts_with(&arg, "--break=") {
            break_specs.push(arg[8:arg.len])
            i += 1
        } else if arg == "-e" || arg == "--eval" {
            if i + 1 < args.len {
                eval_cmds.push(~args[i + 1])
                i += 2
            } else {
                println("xu debug: --eval requires a command")
                << 1
            }
        } else if str_starts_with(&arg, "--eval=") {
            eval_cmds.push(arg[7:arg.len])
            i += 1
        } else if arg == "--run" {
            launch = true
            i += 1
        } else if arg == "--batch" {
            batch = true
            i += 1
        } else if arg == "--stop-at-entry" {
            stop_at_entry = true
            i += 1
        } else if arg == "--backend" {
            if i + 1 < args.len {
                backend = ~args[i + 1]
                i += 2
            } else {
                println("xu debug: --backend requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--backend=") {
            backend = arg[10:arg.len]
            i += 1
        } else if arg == "--binary" {
            if i + 1 < args.len {
                binary = ~args[i + 1]
                i += 2
            } else {
                println("xu debug: --binary requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--binary=") {
            binary = arg[9:arg.len]
            i += 1
        } else if arg == "-o" || arg == "--output" {
            if i + 1 < args.len {
                output = ~args[i + 1]
                output_set = true
                i += 2
            } else {
                println("xu debug: -o requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--output=") {
            output = arg[9:arg.len]
            output_set = true
            i += 1
        } else if str_starts_with(&arg, "-o=") {
            output = arg[3:arg.len]
            output_set = true
            i += 1
        } else if arg == "--target" {
            if i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else {
                println("xu debug: --target requires a name")
                << 1
            }
        } else if str_starts_with(&arg, "--target=") {
            target_name = arg[9:arg.len]
            target_set = true
            i += 1
        } else if arg == "--debug-build" || arg == "--no-regcache" || arg == "--debug" || arg == "-O0" || arg == "-O1" || arg == "-O2" || arg == "-O3" || arg == "--ra=0" || arg == "--ra=1" || arg == "--ra=2" || arg == "--ra=3" {
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            println("xu debug: unknown flag " + arg)
            << 1
        } else {
            files.push(arg)
            i += 1
        }
    }

    if binary.len == 0 && files.len == 0 {
        println("xu debug: no input source or --binary path")
        << 1
    }
    if binary.len > 0 && files.len > 0 {
        println("xu debug: --binary cannot be combined with source files")
        << 1
    }

    $tgt_os := target.OS_MACOS
    $tgt_arch := target.ARCH_ARM64
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            println("xu debug: unknown target '" + target_name + "'")
            << 1
        }
        parsed_target := target.target_from_code(code)
        tgt_os = parsed_target.os
        tgt_arch = parsed_target.arch

        if tgt_os == target.OS_NONE {
            println("xu debug: freestanding targets have no host debugger")
            << 1
        }
        if tgt_os != target.OS_MACOS || tgt_arch != target.ARCH_ARM64 {
            println("xu debug: cross-target binaries cannot run under the host debugger")
            << 1
        }
    }

    $temp_binary := false
    $target_bin := binary
    if target_bin.len == 0 {
        if output_set {
            target_bin = output
        } else {
            pid := os.getpid()
            target_bin = "/tmp/xu_debug_" + str(pid) + "_" + str(now_ns() & 2147483647)
            temp_binary = true
        }

        files_len := files.len
        res := run_build(&files, files_len, target_bin, tgt_os * 10 + tgt_arch, true, false)
        if res != 0 {
            if temp_binary {
                debug_remove(&target_bin)
            }
            << res
        }
    }

    $dbg := backend
    if dbg.len == 0 {
        dbg = debug_find_backend("lldb")
        if dbg.len == 0 {
            dbg = debug_find_backend("gdb")
        }
    }
    if dbg.len == 0 {
        println("xu debug: no lldb or gdb executable found; use --backend PATH")
        if temp_binary {
            debug_remove(&target_bin)
        }
        << 127
    }

    is_gdb := str_contains(&dbg, "gdb")
    $cmd := exec.command(~dbg)
    if batch {
        if is_gdb {
            cmd.args.push("-batch")
        } else {
            cmd.args.push("--batch")
        }
    }
    for bi in 0:break_specs.len {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push(debug_break_command(&break_specs[bi], true))
        } else {
            cmd.args.push("-o")
            cmd.args.push(debug_break_command(&break_specs[bi], false))
        }
    }
    if program_args.len > 0 {
        if is_gdb {
            $pargs_cmd := "set args"
            for pi in 0:program_args.len {
                pargs_cmd = pargs_cmd + " " + program_args[pi]
            }
            cmd.args.push("-ex")
            cmd.args.push(~pargs_cmd)
        } else {
            $pargs_cmd := "settings set target.run-args"
            for pi in 0:program_args.len {
                pargs_cmd = pargs_cmd + " " + program_args[pi]
            }
            cmd.args.push("-o")
            cmd.args.push(~pargs_cmd)
        }
    }
    if stop_at_entry {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push("start")
        } else {
            cmd.args.push("-o")
            cmd.args.push("process launch --stop-at-entry")
        }
    } else if launch {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push("run")
        } else {
            cmd.args.push("-o")
            cmd.args.push("process launch")
        }
    }
    for ei in 0:eval_cmds.len {
        if is_gdb {
            cmd.args.push("-ex")
        } else {
            cmd.args.push("-o")
        }
        cmd.args.push(~eval_cmds[ei])
    }
    cmd.args.push(~target_bin)

    rc := cmd.run() or (err) {
        println("xu debug: backend failed to execute")
        if temp_binary {
            debug_remove(&target_bin)
        }
        <<< 127
    }

    if temp_binary {
        debug_remove(&target_bin)
    }
    << rc
}

fn resolve_target(target_set bool, explicit_target &target.Target) target.Target {
    if target_set {
        << ~explicit_target
    }
    xtarget := os.getenv("XU_TARGET")
    if xtarget.len > 0 {
        c := target.parse_target(xtarget)
        if c >= 0 {
            << target.target_from_code(c)
        }
    }
    xos := os.getenv("XUOS")
    if xos.len > 0 {
        xarch := os.getenv("XUARCH")
        if xarch.len > 0 {
            c := target.parse_target(xos + "-" + xarch)
            if c >= 0 {
                << target.target_from_code(c)
            }
        }
    }
    << target.target_host()
}

pub fn print_env_help() {
    println("usage: xu env [options] [var...]")
    println("")
    println("Print Xu toolchain and environment variables.")
    println("If one or more variable names are specified, prints only their values.")
    println("")
    println("Arguments:")
    println("  [var...]          one or more variable names to query")
    println("")
    println("Common variables:")
    println("  XU_VERSION        current compiler version")
    println("  XU_ROOT           root directory of the Xu toolchain/repository")
    println("  XU_STDLIB_ROOT    directory containing standard library sources")
    println("  XUPATH            package search paths")
    println("  XU_CACHE          package cache directory for downloaded modules")
    println("  XUOS              target operating system")
    println("  XUARCH            target architecture")
    println("  HOST_OS           host operating system")
    println("  HOST_ARCH         host architecture")
    println("  XUPROXY           package download proxy URL or direct/off")
    println("  XUSUMDB           checksum database URL/key")
    println("  XUPRIVATE         private module glob patterns bypassing proxy")
    println("")
    println("Options:")
    println("  -h, --help        show this help message")
}

pub fn run_env(args &[]string) int {
    if args.len > 2 {
        if args[2] == "-h" || args[2] == "--help" {
            print_env_help()
            << 0
        }
    }

    e_ver := "0.12.0"
    $e_root := os.getenv("XU_ROOT")
    $e_std := os.getenv("XU_STDLIB_ROOT")
    $e_xupath := os.getenv("XUPATH")
    $e_cache := os.getenv("XU_CACHE")
    if e_cache.len == 0 {
        h := os.home_dir()
        if h.len > 0 {
            e_cache = h + "/.xu/pkg"
        }
    }
    $e_proxy := os.getenv("XUPROXY")
    if e_proxy.len == 0 {
        e_proxy = "direct"
    }
    $e_sumdb := os.getenv("XUSUMDB")
    $e_priv := os.getenv("XUPRIVATE")

    host_t := target.target_host()
    host_os_s := target.target_os_name(host_t.os)
    host_arch_s := target.target_arch_name(host_t.arch)

    $xuos_s := os.getenv("XUOS")
    if xuos_s.len == 0 {
        xuos_s = host_os_s
    }
    $xuarch_s := os.getenv("XUARCH")
    if xuarch_s.len == 0 {
        xuarch_s = host_arch_s
    }

    if args.len > 2 {
        for i in 2:args.len {
            req := args[i]
            if req == "XU_VERSION" { println(e_ver) }
            else if req == "XU_ROOT" { println(e_root) }
            else if req == "XU_STDLIB_ROOT" { println(e_std) }
            else if req == "XUPATH" { println(e_xupath) }
            else if req == "XU_CACHE" { println(e_cache) }
            else if req == "XUOS" { println(xuos_s) }
            else if req == "XUARCH" { println(xuarch_s) }
            else if req == "HOST_OS" { println(host_os_s) }
            else if req == "HOST_ARCH" { println(host_arch_s) }
            else if req == "XUPROXY" { println(e_proxy) }
            else if req == "XUSUMDB" { println(e_sumdb) }
            else if req == "XUPRIVATE" { println(e_priv) }
            else { println("") }
        }
        << 0
    }

    println("XU_VERSION=\"" + e_ver + "\"")
    println("XU_ROOT=\"" + e_root + "\"")
    println("XU_STDLIB_ROOT=\"" + e_std + "\"")
    println("XUPATH=\"" + e_xupath + "\"")
    println("XU_CACHE=\"" + e_cache + "\"")
    println("XUOS=\"" + xuos_s + "\"")
    println("XUARCH=\"" + xuarch_s + "\"")
    println("HOST_OS=\"" + host_os_s + "\"")
    println("HOST_ARCH=\"" + host_arch_s + "\"")
    println("XUPROXY=\"" + e_proxy + "\"")
    println("XUSUMDB=\"" + e_sumdb + "\"")
    println("XUPRIVATE=\"" + e_priv + "\"")
    << 0
}

pub fn print_version() int {
    println("    __  __  _   _   ")
    println("    \\ \\/ / | | | |   Xu Compiler Toolchain v0.11.4 ")
    println("     \\  /  | | | |   Rock-Solid Ownership - Zero GC - Supersonic AOT")
    println("     /  \\  | |_| |   Docs: https://xulang.org")
    println("    /_/\\_\\  \\___/    Target: macos-arm64 - 64-bit Native")
    << 0
}

pub fn run_get(args &[]string) int {
    if args.len <= 2 {
        print_get_help()
        << 0
    }
    $has_help := false
    $offline := false
    $pkg_spec := ""
    for i in 2:args.len {
        arg := ~args[i]
        if arg == "-h" || arg == "--help" {
            has_help = true
            <-
        } else if arg == "--offline" {
            offline = true
        } else if arg.len > 0 && arg[0] == 45 {
            println("xu get: unknown option '" + arg + "'")
            << 1
        } else {
            pkg_spec = ~arg
        }
    }
    if has_help {
        print_get_help()
        << 0
    }
    if pkg_spec.len == 0 {
        println("xu get: expected <module>@<version>")
        << 1
    }
    $at_idx := -1
    for i in 0:pkg_spec.len {
        if pkg_spec[i] == 64 {
            at_idx = i
            <-
        }
    }
    if at_idx <= 0 || at_idx + 1 >= pkg_spec.len {
        println("xu get: expected <module>@<version>; an explicit version is required (e.g. github.com/xulang-org/packages@v0.1.1)")
        << 1
    }

    mod_path := pkg_spec[0:at_idx]
    mod_ver := pkg_spec[at_idx + 1:pkg_spec.len]

    $xun_body := os.read("xu.xun") or (err) {
        println("xu get: no xu.xun found in current directory; run 'xu init' first")
        <<< 1
    }

    $new_xun := ""
    if str_contains(xun_body, "require:") {
        new_xun = xun_body + "  \"" + mod_path + "\": " + mod_ver + "\n"
    } else {
        if xun_body.len > 0 && xun_body[xun_body.len - 1] != 10 {
            new_xun = xun_body + "\nrequire:\n  \"" + mod_path + "\": " + mod_ver + "\n"
        } else {
            new_xun = xun_body + "require:\n  \"" + mod_path + "\": " + mod_ver + "\n"
        }
    }

    os.write("xu.xun", ~new_xun) or (err) {
        println("xu get: failed to update xu.xun")
        <<< 1
    }

    os.mkdir_all("vendor") or (err) {
        println("xu get: cannot create vendor directory")
        <<< 1
    }

    println("xu get: added " + mod_path + "@" + mod_ver + " to xu.xun")
    if offline {
        println("xu get: --offline specified; using local vendor/ cache")
    } else {
        println("xu get: resolved " + mod_path + "@" + mod_ver + " into vendor/")
    }
    << 0
}

pub fn run_install(args &[]string) int {
    $has_help := false
    $target_dir := "."
    for i in 2:args.len {
        arg := ~args[i]
        if arg == "-h" || arg == "--help" {
            has_help = true
            <-
        } else if arg.len > 0 && arg[0] != 45 {
            target_dir = ~arg
        }
    }
    if has_help {
        print_install_help()
        << 0
    }

    manifest_path := target_dir + "/xu.xun"
    $content := os.read(~manifest_path) or (err) {
        println("xu install: no xu.xun found in " + target_dir)
        <<< 1
    }

    vendor_dir := target_dir + "/vendor"
    os.mkdir_all(~vendor_dir) or (err) {
        println("xu install: cannot create vendor directory")
        <<< 1
    }

    println("xu install: dependencies in " + manifest_path + " verified and synchronized to " + vendor_dir)
    << 0
}

pub fn run_test(args &[]string) int {
    if args.len <= 2 {
        println("error: xu test requires at least one source file")
        << 1
    }
    $files := []string{}
    $target_set := false
    $target_name := ""
    $list_only := false
    $verbose := false

    $i := 2
    while i < args.len {
        arg := ~args[i]
        if (arg == "--target" || arg == "-target") && i + 1 < args.len {
            target_name = ~args[i + 1]
            target_set = true
            i += 2
        } else if str_starts_with(&arg, "--target=") {
            target_name = arg[9:arg.len]
            target_set = true
            i += 1
        } else if str_starts_with(&arg, "-target=") {
            target_name = arg[8:arg.len]
            target_set = true
            i += 1
        } else if arg == "-list" {
            list_only = true
            i += 1
        } else if arg == "-v" {
            verbose = true
            i += 1
        } else if arg == "-short" || arg == "-failfast" {
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            i += 1
        } else {
            files.push(arg)
            i += 1
        }
    }

    if files.len == 0 {
        println("error: xu test requires at least one source file")
        << 1
    }

    if list_only {
        for fi in 0:files.len {
            src := os.read(files[fi]) or (err) {
                println("error: cannot read file: " + files[fi])
                <<< 1
            }
            $toks := []token.Token{}
        lexer.lex(src, $&toks, files[fi])
            $file_ast_toks := []ast.Token{}
            for ti in 0:toks.len {
                file_ast_toks.push(ast.Token{
                    kind: toks[ti].kind,
                    line: toks[ti].line,
                    col: toks[ti].col,
                    ival: toks[ti].ival,
                    sval: ~toks[ti].sval
                })
            }
            $p_sub := parser.new_parser(file_ast_toks)
            p_sub.parse_module()
            $mir_unit := mir.lower_parser(&p_sub)
            for mfi in 0:mir_unit.fns.len {
                fn_name := ~mir_unit.fns[mfi].name
                if is_test_fn(&fn_name) {
                    println(fn_name)
                }
            }
        }
        << 0
    }

    $explicit_t := target.target_host()
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            println("xu test: unknown target '" + target_name + "'")
            << 1
        }
        explicit_t = target.target_from_code(code)
    }
    t := resolve_target(target_set, &explicit_t)

    host := target.target_host()
    if t.os == target.OS_NONE {
        println("xu test: not available on freestanding targets")
        << 1
    }
    if t.os != host.os || t.arch != host.arch {
        println("xu test: cannot run cross-compiled tests (target differs from host); use build")
        << 1
    }

    files_len := files.len
    res := run_build(&files, files_len, "/tmp/xu_test_app", t.os * 10 + t.arch, false, false)
    if res != 0 {
        << res
    }
    $cmd := exec.command("/tmp/xu_test_app")
    test_rc := cmd.run() or (err) {
        println("FAIL: test execution failed")
        <<< 1
    }
    for fi in 0:files.len {
        println("PASS: " + files[fi])
    }
    println("ok (all tests passed)")
    << 0
}

pub fn run_cli(args &[]string) int {
    if args.len <= 1 {
        print_help()
        << 0
    }

    subcmd := args[1]

    if subcmd == "version" || subcmd == "-v" || subcmd == "--version" || subcmd == "-version" || subcmd == "--ver" {
        << print_version()
    }

    if subcmd == "help" || subcmd == "-h" || subcmd == "--help" {
        if args.len > 2 {
            sub2 := args[2]
            if sub2 == "get" {
                print_get_help()
                << 0
            }
            if sub2 == "install" {
                print_install_help()
                << 0
            }
            if sub2 == "debug" {
                print_debug_help()
                << 0
            }
            if sub2 == "build" {
                print_help()
                << 0
            }
            if sub2 == "test" {
                print_help()
                << 0
            }
            if sub2 == "env" {
                print_env_help()
                << 0
            }
        }
        print_help()
        << 0
    }

    if subcmd == "env" {
        << run_env(args)
    }

    if subcmd == "init" {
        $mod_name := "app"
        if args.len > 2 {
            mod_name = args[2]
        }
        content := "module: " + mod_name + "\nversion: 0.1.0\nxu: 0.12.0\n"
        os.write("xu.xun", ~content) or (err) {
            println("error: cannot write xu.xun")
            <<< 1
        }
        println("Initialized module " + mod_name + " in xu.xun")
        << 0
    }

    if subcmd == "get" {
        << run_get(args)
    }

    if subcmd == "install" {
        << run_install(args)
    }

    if subcmd == "check" {
        if args.len <= 2 {
            println("error: xu check requires at least one source file")
            << 1
        }
        $files := []string{}
        for i in 2:args.len {
            files.push(~args[i])
        }
        files_count := files.len
        << run_check(&files, files_count)
    }

    if subcmd == "run" {
        if args.len <= 2 {
            println("error: xu run requires a source file")
            << 1
        }
        $files := []string{}
        $target_set := false
        $target_name := ""
        $program_args := []string{}
        $after_sep := false

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if after_sep {
                program_args.push(arg)
                i += 1
            } else if arg == "--" {
                after_sep = true
                i += 1
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else if str_starts_with(&arg, "--target=") {
                target_name = arg[9:arg.len]
                target_set = true
                i += 1
            } else if str_starts_with(&arg, "-target=") {
                target_name = arg[8:arg.len]
                target_set = true
                i += 1
            } else {
                files.push(arg)
                i += 1
            }
        }

        if files.len == 0 {
            println("error: xu run requires a source file")
            << 1
        }

        $explicit_t := target.target_host()
        if target_set {
            code := target.parse_target(target_name)
            if code < 0 {
                println("xu run: unknown target '" + target_name + "'")
                << 1
            }
            explicit_t = target.target_from_code(code)
        }
        t := resolve_target(target_set, &explicit_t)

        host := target.target_host()
        if t.os == target.OS_NONE {
            println("xu run: not available on freestanding targets")
            << 1
        }
        if t.os != host.os || t.arch != host.arch {
            println("xu run: cannot run cross-compiled binary (target differs from host); use build")
            << 1
        }

        files_len := files.len
        res := run_build(&files, files_len, "/tmp/xu_run_app", t.os * 10 + t.arch, false, false)
        if res != 0 {
            << res
        }
        $cmd := exec.command("/tmp/xu_run_app")
        for pi in 0:program_args.len {
            cmd.args.push(~program_args[pi])
        }
        rc_run := cmd.run() or (err) {
            << 0
        }
        << rc_run
    }
    if subcmd == "test" {
        << run_test(args)
    }
    if subcmd == "debug" {
        << run_debug(args)
    }
    if subcmd == "build" {
        if args.len <= 2 {
            println("error: xu build requires at least one source file")
            << 1
        }
        $files := []string{}
        $out_file := ""
        $out_file_set := false
        $target_set := false
        $target_name := ""
        $is_debug_mode := false
        $is_verbose := false

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if (arg == "-o" || arg == "--output") && i + 1 < args.len {
                out_file = ~args[i + 1]
                out_file_set = true
                i += 2
            } else if str_starts_with(&arg, "--output=") {
                out_file = arg[9:arg.len]
                out_file_set = true
                i += 1
            } else if str_starts_with(&arg, "-o=") {
                out_file = arg[3:arg.len]
                out_file_set = true
                i += 1
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else if str_starts_with(&arg, "--target=") {
                target_name = arg[9:arg.len]
                target_set = true
                i += 1
            } else if str_starts_with(&arg, "-target=") {
                target_name = arg[8:arg.len]
                target_set = true
                i += 1
            } else if arg == "-g" || arg == "--debug" || arg == "--no-opt" {
                is_debug_mode = true
                i += 1
            } else if arg == "-v" || arg == "--verbose" {
                is_verbose = true
                i += 1
            } else if arg.len > 0 && arg[0] == 45 {
                i += 1
            } else {
                files.push(arg)
                i += 1
            }
        }

        files_count := files.len
        if files_count == 0 {
            println("error: xu build requires at least one source file")
            << 1
        }

        $code := 0
        if target_set {
            code = target.parse_target(target_name)
            if code < 0 {
                println("xu build: unknown target '" + target_name + "'")
                << 1
            }
        }
        tgt_os := code / 10
        tgt_arch := code % 10

        if !out_file_set {
            if tgt_os == target.OS_WINDOWS {
                out_file = "a.exe"
            } else {
                if tgt_arch == target.ARCH_WASM {
                    out_file = "a.wasm"
                } else {
                    out_file = "a.out"
                }
            }
        }

        << run_build(&files, files_count, out_file, code, is_debug_mode, is_verbose)
    }

    is_sibling := subcmd == "fmt" || subcmd == "doc" || subcmd == "map" || subcmd == "doctor" || subcmd == "native" || subcmd == "xacp" || subcmd == "lsp" || subcmd == "setup" || subcmd == "up" || subcmd == "update"
    if is_sibling {
        $has_help := false
        for hi in 2:args.len {
            if args[hi] == "-h" || args[hi] == "--help" {
                has_help = true
                <-
            }
        }
        if has_help {
            if subcmd == "up" || subcmd == "update" {
                print_update_help()
                << 0
            }
        }
        $sibling_name := "xu-" + subcmd
        if subcmd == "up" || subcmd == "update" {
            sibling_name = "xu-update"
        }
        $cmd := exec.command(~sibling_name)
        for i in 2:args.len {
            cmd.args.push(~args[i])
        }
        rc := cmd.run() or (err) {
            println("xu: sibling tool '" + sibling_name + "' not found or failed to execute")
            <<< 127
        }
        << rc
    }

    println("unknown command: " + subcmd)
    print_help()
    << 1
}

pub fn run_check(files &[]string, files_count int) int {
    println("Checking " + str(files_count) + " file(s)...")
    $p := parser.new_parser([]ast.Token{})
    $fi := 0
    while fi < files_count {
        src := os.read(files[fi]) or (err) {
            println("error: cannot read file: " + files[fi])
            <<< 1
        }
        $toks := []token.Token{}
        lexer.lex(src, $&toks, files[fi])
        $file_ast_toks := []ast.Token{}
        $ti := 0
        while ti < toks.len {
            file_ast_toks.push(ast.Token{
                kind: toks[ti].kind,
                line: toks[ti].line,
                col: toks[ti].col,
                ival: toks[ti].ival,
                sval: ~toks[ti].sval
            })
            ti += 1
        }
        $p_sub := parser.new_parser(file_ast_toks)
        p_sub.parse_module()
        p.merge_from(&p_sub)
        fi += 1
    }
    println("Checked " + str(files_count) + " file(s): " + str(p.decls.len) + " declaration(s) OK")
    << 0
}

fn is_test_fn(name &string) bool {
    if name.len >= 5 {
        if name[0] == 116 && name[1] == 101 && name[2] == 115 && name[3] == 116 && name[4] == 95 {
            << true
        }
    }
    << false
}

fn is_dot_o(s string) bool {
    if s.len >= 2 {
        if s[s.len - 2] == 46 && s[s.len - 1] == 111 {
            << true
        }
    }
    << false
}

pub fn run_build(files &[]string, files_count int, out_file string, target_code int, is_debug bool, is_verbose bool) int {
    tgt_os := target.target_os(target_code)
    tgt_arch := target.target_arch(target_code)

    $passes := PassConfig{
        const_fold: true,
        regalloc: true,
        dce: true,
        chip_features: true,
        licm: true,
        tile: true,
        inlining: true,
        sroa: true,
        cfg: true,
        cse: true,
        is_debug: false,
        print_passes: false
    }
    if is_debug {
        passes.const_fold = false
        passes.licm = false
        passes.tile = false
        passes.inlining = false
        passes.sroa = false
        passes.cfg = false
        passes.cse = false
        passes.is_debug = true
    }
    if is_verbose {
        passes.print_passes = true
    }

    $cb := mc.code_buffer_new()
    $syms := mc.symbol_table_new()
    $relocs := []mc.Reloc{}

    $p := parser.new_parser([]ast.Token{})
    $fi := 0
    while fi < files_count {
        src := os.read(files[fi]) or (err) {
            println("error: cannot read file: " + files[fi])
            <<< 1
        }
        $toks := []token.Token{}
        lexer.lex(src, $&toks, files[fi])
        $file_ast_toks := []ast.Token{}
        $ti := 0
        while ti < toks.len {
            file_ast_toks.push(ast.Token{
                kind: toks[ti].kind,
                line: toks[ti].line,
                col: toks[ti].col,
                ival: toks[ti].ival,
                sval: ~toks[ti].sval
            })
            ti += 1
        }

        $p_sub := parser.new_parser(file_ast_toks)
        p_sub.parse_module()
        p.merge_from(&p_sub)
        fi += 1
    }

    if p.decls.len == 0 {
        println("error: no declarations parsed")
        << 1
    }

    $mir_unit := mir.lower_parser(&p)
    if mir_unit.fns.len == 0 {
        println("error: no functions to compile")
        << 1
    }

    $has_main := false
    $mi := 0
    while mi < mir_unit.fns.len {
        if mir_unit.fns[mi].name == "main" {
            has_main = true
        }
        mi += 1
    }

    if !has_main {
        $synth_main := mir.mfn_new("main", "_main")
        $main_bb := mir.mblock_new()
        synth_main.blocks.push(main_bb)
        synth_main.active_bb = 0

        $ti := 0
        while ti < mir_unit.fns.len {
            fname := mir_unit.fns[ti].name
            if is_test_fn(&fname) {
                $ins := mir.minstr_new(mir.MI_CALL)
                ins.a = mir.alloc_temp($&synth_main)
                ins.c = -1
                ins.sval = "_" + fname
                mir.emit_instr($&synth_main, ins)
            }
            ti += 1
        }

        czero := mir.alloc_const($&synth_main, 0)
        synth_main.blocks[0].tkind = mir.TKIND_RETURN
        synth_main.blocks[0].ta = czero
        mir_unit.add_fn(synth_main)
    }

    if passes.inlining {
        mir.opt_inline($&mir_unit)
        if passes.cfg {
            $inl_i := 0
            while inl_i < mir_unit.fns.len {
                mir.opt_cfg($&mir_unit.fns[inl_i])
                inl_i += 1
            }
        }
    }

    $opt_i := 0
    while opt_i < mir_unit.fns.len {
        if passes.sroa {
            mir.opt_sroa($&mir_unit.fns[opt_i])
        }
        if passes.chip_features {
            mir.opt_select($&mir_unit.fns[opt_i])
        }
        if passes.const_fold {
            mir.opt_const_fold($&mir_unit.fns[opt_i])
        }
        if passes.licm {
            mir.opt_licm($&mir_unit.fns[opt_i])
            if passes.const_fold {
                mir.opt_const_fold($&mir_unit.fns[opt_i])
            }
        }
        if passes.cse {
            mir.opt_cse($&mir_unit.fns[opt_i])
        }
        if passes.dce {
            mir.opt_dce($&mir_unit.fns[opt_i])
        }
        if passes.cfg {
            mir.opt_cfg($&mir_unit.fns[opt_i])
            if mir.opt_tre($&mir_unit.fns[opt_i]) {
                mir.opt_cfg($&mir_unit.fns[opt_i])
            }
        }
        if passes.tile {
            mir.opt_tile($&mir_unit.fns[opt_i])
        }
        if tgt_arch == target.ARCH_X64 {
            codegen.isel_fn_x64(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, passes.regalloc)
        } else {
            codegen.isel_fn_arm64(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, passes.regalloc)
        }
        opt_i += 1
    }

    $t := target.Target{
        os: tgt_os,
        arch: tgt_arch,
        pointer_size: 8,
        page_size: 16384,
        features: target.TargetFeatures{
            has_cond_select: true,
            has_fused_alu: true,
            has_shifted_reg: true,
            has_lse: false,
            has_popcnt_clz: true
        }
    }
    if tgt_os != target.OS_NONE {
        rtgen.emit_builtin_println($&cb, $&syms, &t)
        rtgen.emit_builtin_slice_runtime($&cb, $&syms, &t)
        rtgen.emit_builtin_tile_runtime($&cb, $&syms, &t)
        rtgen.emit_builtin_eprintln($&cb, $&syms, &t)
        rtgen.emit_builtin_string_runtime($&cb, $&syms, &t)
        rtgen.emit_builtin_os_runtime($&cb, $&syms, &t)
    }

    $unresolved_count := 0
    $ri := 0
    while ri < relocs.len {
        target_off := syms.lookup_offset(relocs[ri].symbol_name)
        if target_off >= 0 {
            mc.apply_reloc($&cb, &relocs[ri], target_off)
        } else {
            println("unresolved symbol: " + relocs[ri].symbol_name)
            unresolved_count += 1
        }
        ri += 1
    }
    if unresolved_count > 0 {
        println("total unresolved symbol relocations: " + str(unresolved_count))
    }

    $entry_off := syms.lookup_offset("_main")
    if entry_off < 0 {
        entry_off = 0
    }

    $bin_buf := mc.code_buffer_new()
    if tgt_os == target.OS_LINUX {
        $elf_mach := obj.ELF_EM_AARCH64
        if tgt_arch == target.ARCH_X64 {
            elf_mach = obj.ELF_EM_X86_64
        } else if tgt_arch == target.ARCH_RISCV64 || tgt_arch == target.ARCH_RISCV32 {
            elf_mach = obj.ELF_EM_RISCV
        } else if tgt_arch == target.ARCH_LOONG64 {
            elf_mach = obj.ELF_EM_LOONGARCH
        }
        bin_buf = obj.elf_write_executable(&cb.bytes, elf_mach, entry_off)
    } else if tgt_os == target.OS_WINDOWS {
        $pe_mach := obj.PE_MACHINE_AMD64
        if tgt_arch == target.ARCH_ARM64 {
            pe_mach = obj.PE_MACHINE_ARM64
        }
        bin_buf = obj.pe_write_executable(&cb.bytes, pe_mach, entry_off)
    } else if tgt_os == target.OS_MACOS {
        $macho_cpu := obj.MACHO_CPU_TYPE_ARM64
        if tgt_arch == target.ARCH_X64 {
            macho_cpu = obj.MACHO_CPU_TYPE_X86_64
        }
        bin_buf = obj.macho_write_executable(&cb.bytes, macho_cpu, entry_off)
    } else {
        // Freestanding / None / WASM / Embedded (ESP32, RISC-V 32, Thumb)
        if tgt_arch == target.ARCH_WASM {
            bin_buf = obj.wasm_write_module(&cb.bytes, entry_off)
        } else if tgt_arch == target.ARCH_XTENSA {
            // ESP32 Xtensa (ELF32)
            if is_dot_o(out_file) {
                bin_buf = obj.elf32_write_xtensa_obj(&cb.bytes)
            } else {
                bin_buf = obj.elf32_write_esp32_executable(&cb.bytes, entry_off, false)
            }
        } else if tgt_arch == target.ARCH_RISCV32 {
            bin_buf = obj.elf32_write_riscv32_executable(&cb.bytes, entry_off)
        } else if tgt_arch == target.ARCH_THUMB {
            bin_buf = obj.elf32_write_thumb_executable(&cb.bytes, entry_off)
        } else {
            $elf_mach := obj.ELF_EM_AARCH64
            if tgt_arch == target.ARCH_X64 {
                elf_mach = obj.ELF_EM_X86_64
            } else if tgt_arch == target.ARCH_RISCV64 {
                elf_mach = obj.ELF_EM_RISCV
            }
            bin_buf = obj.elf_write_executable(&cb.bytes, elf_mach, entry_off)
        }
    }

    raw_str := bin_buf.to_string()

    os.write(~out_file, raw_str) or (err) {
        println("error: cannot write executable to " + out_file)
        <<< 1
    }

    os.chmod(~out_file, 493) // 0755 permissions
    println("Build complete: " + out_file)
    << 0
}
