                           "__xu_tensor_dot_q4_0_q8_0_fast_f32", "__xu_tensor_gemv4_q4_0_q8_0_f32",
                           "__xu_tensor_gemv4_q4_0_q8_0_fast_f32",
                           "__xu_tensor_quantize_q8_0", "__xu_tensor_quantize_q8_0_fast",
                           "__xu_tensor_gemv4_q8_0_q8_0_f32", "__xu_tensor_gemv4_q8_0_q8_0_fast_f32",
                           "__xu_tensor_gemm4x4_f32", "__xu_tensor_gemm4x4_fast_f32",
