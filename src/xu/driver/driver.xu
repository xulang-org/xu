        } else if baremetal_obj && emit_object && relocs[ri].symbol_name.len > 0 {
            object_imports.push(~relocs[ri])
        } else if link_object && (object_import(&relocs[ri], tgt_os, tgt_arch, link_ui, link_phone) || native_symbol(&native, &relocs[ri].symbol_name, tgt_os)) {
