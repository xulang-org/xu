@xu/driver
// Compiler driver pipeline and CLI dispatcher.
//
// Layer 5 module: coordinates frontend parsing, type checking, MIR optimization,
// machine code generation, and binary linking without mixing internal passes.

#xu/span
#xu/token
#xu/lexer
#xu/ast
#xu/parser
#xu/target
#xu/mc
#xu/obj
#xu/codegen
#xu/mir
#xu/types
#xu/rtgen
#os
#os/exec
#path/filepath
#internal/modulepath
#internal/toolpath

pub struct PassConfig {
    pub const_fold bool
    pub regalloc bool
    pub dce bool
    pub chip_features bool
    pub chip_fusion bool
    pub licm bool
    pub tile bool
    pub inlining bool
    pub sroa bool
    pub cfg bool
    pub cse bool
    pub is_debug bool
    pub print_passes bool
}

