    println("usage: xu get [options] <module>@<version>")
    println("")
    println("Add or update a pinned module dependency in the current directory's xu.xun,")
    println("then install dependencies into vendor/ and update xu.lock.")
    println("")
    println("Arguments:")
    println("  <module>@<version>  module path and version to install (e.g. github.com/xulang-org/packages@v0.1.1)")
    println("")
    println("Options:")
    println("  --offline           resolve dependencies from local cache/vendor; never download")
    println("  -h, --help          show this help message")
}

