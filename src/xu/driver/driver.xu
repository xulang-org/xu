    println("  --xacp            embed XACP startup and discovery")
    println("  --xacp-port PORT  enable XACP TCP on loopback (0 = stdio only)")
    println("  --no-opt         disable optimization")
    println("  --tensor-fusion  enable MIR SIMD tensor loop fusion (same as XU_TENSOR_FUSION=1)")
    println("  --tensor-fast-math enable reassociated fast-math tensor kernels (implies --tensor-fusion)")
    println("  --release        select a release build (default)")
    println("  --pgo FILE        apply .xupgo block or branch-edge counts during layout")
    println("  --ra=1            select the default register allocator")
    println("  --offline         resolve dependencies using local sources, vendor, and cache")
    println("  --frozen          use locked dependencies without writes or downloads")
    println("  -v, --verbose    print the selected target and chip features")
