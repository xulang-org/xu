pub fn print_debug_help() {
    println("usage: xu debug [options] <input.xu...> [-- program-args...]")
    println("")
    println("Build a DWARF-enabled debug binary and start an interactive source debugger.")
    println("")
    println("Options:")
    println("  -b, --break SPEC     source location file.xu:LINE or function name")
    println("  -e, --eval COMMAND   execute a debugger command before the prompt (repeatable)")
    println("  --run                launch the program after applying debugger commands")
    println("  --batch              run in batch mode without interactive prompt")
    println("  --stop-at-entry      stop at the program entry point")
    println("  --backend PATH       use PATH instead of lldb (gdb is the fallback)")
    println("  --binary PATH        debug an existing executable; skip the build")
    println("  -o, --output PATH    keep the debug executable at PATH")
    println("  --target TARGET      host target to build (macos/linux/windows)")
    println("  -h, --help           show this message")
    println("")
    println("Examples:")
    println("  xu debug -b main.xu:8 main.xu")
    println("  xu debug -b main.xu:8 --run main.xu")
    println("  xu debug --binary ./app -e 'bt' -e 'frame variable'")
}

fn str_eq(a &string, b &string) bool {
    if a.len != b.len {
        << false
    }
    for i in 0:a.len {
        if a[i] != b[i] {
            << false
        }
    }
    << true
}

fn str_starts_with(s &string, prefix string) bool {
    if s.len < prefix.len {
        << false
    }
    for i in 0:prefix.len {
        if s[i] != prefix[i] {
            << false
        }
    }
    << true
}

// Map types and runtime syntax aliases (str, itoa, ...) are implemented in the
// `runtime` package, which programs never import by name.
fn needs_runtime_algo(p &parser.Parser) bool {
    for i in 0:p.nodes.len {
        k := p.nodes[i].kind
        if k == ast.NT_MAP || k == ast.NK_MAP_INIT {
            << true
        }
        if k == ast.NK_CALL || k == ast.NK_METHOD_CALL {
            name := p.nodes[i].sval + ""
            if types.runtime_abi_syntax_id(&name) != 0 {
                << true
            }
        }
    }
    << false
}

// Explicit inputs and import-resolved files must share one spelling so a
// file named on the command line is not parsed again through its package.
fn abs_path(p &string) string {
    << host_slashes(filepath.abs(p))
}

// Windows hosts accept '/' too; one spelling keeps the package and file
// de-duplication (string compares) from loading a file twice.
fn host_slashes(s string) string {
    if xu_target_os() != target.OS_WINDOWS {
        << s
    }
    $out := ""
    for i in 0:s.len {
        if s[i] == 92 {
            out.push_byte(47)
        } else {
            out.push_byte(s[i])
        }
    }
    << out
}

fn str_ends_with(s &string, suffix string) bool {
    if s.len < suffix.len {
        << false
    }
    offset := s.len - suffix.len
    for i in 0:suffix.len {
        if s[offset + i] != suffix[i] {
            << false
        }
    }
    << true
}

fn str_contains(s &string, substr string) bool {
    if substr.len == 0 {
        << true
    }
    if s.len < substr.len {
        << false
    }
    $limit := s.len - substr.len
    for i in 0:limit + 1 {
        $matched := true
        for j in 0:substr.len {
            if s[i + j] != substr[j] {
                matched = false
                <-
            }
        }
        if matched {
            << true
        }
    }
    << false
}

fn debug_find_backend(name string) string {
    res := exec.look_path(name) >>> (err) {
        << ""
    }
    << res
}

fn debug_remove(path &string) {
    p := ~path
    os.remove(p) >>> (err) {
        <<
    }
}

fn debug_break_command(spec &string, is_gdb bool) string {
    $split := -1
    for i in 0:spec.len {
        if spec[i] == 58 {
            split = i
        }
    }
    if split > 0 && split + 1 < spec.len {
        file := spec[0:split]
        line := spec[split + 1:spec.len]
        if is_gdb {
            << "break " + file + ":" + line
        }
        << "breakpoint set --file " + file + " --line " + line
    }
    if is_gdb {
        << "break " + spec
    }
    << "breakpoint set --name " + spec
}

pub fn run_debug(args &[]string) int {
    if args.len <= 2 {
        print_debug_help()
        << 0
    }
    $has_help := false
    for hi in 2:args.len {
        if args[hi] == "-h" || args[hi] == "--help" {
            has_help = true
            <-
        }
    }
    if has_help {
        print_debug_help()
        << 0
    }

    $files := []string{}
    $break_specs := []string{}
    $eval_cmds := []string{}
    $program_args := []string{}
    $output := ""
    $output_set := false
    $binary := ""
    $backend := ""
    $target_name := ""
    $target_set := false
    $launch := false
    $batch := false
    $stop_at_entry := false
    $after_sep := false

    $i := 2
    while i < args.len {
        arg := ~args[i]
        if after_sep {
            program_args.push(arg)
            i += 1
        } else if arg == "--" {
            after_sep = true
            i += 1
        } else if arg == "-b" || arg == "--break" {
            if i + 1 < args.len {
                break_specs.push(~args[i + 1])
                i += 2
            } else {
                println("xu debug: --break requires a location")
                << 1
            }
        } else if str_starts_with(&arg, "--break=") {
            break_specs.push(arg[8:arg.len])
            i += 1
        } else if arg == "-e" || arg == "--eval" {
            if i + 1 < args.len {
                eval_cmds.push(~args[i + 1])
                i += 2
            } else {
                println("xu debug: --eval requires a command")
                << 1
            }
        } else if str_starts_with(&arg, "--eval=") {
            eval_cmds.push(arg[7:arg.len])
            i += 1
        } else if arg == "--run" {
            launch = true
            i += 1
        } else if arg == "--batch" {
            batch = true
            i += 1
        } else if arg == "--stop-at-entry" {
            stop_at_entry = true
            i += 1
        } else if arg == "--backend" {
            if i + 1 < args.len {
                backend = ~args[i + 1]
                i += 2
            } else {
                println("xu debug: --backend requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--backend=") {
            backend = arg[10:arg.len]
            i += 1
        } else if arg == "--binary" {
            if i + 1 < args.len {
                binary = ~args[i + 1]
                i += 2
            } else {
                println("xu debug: --binary requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--binary=") {
            binary = arg[9:arg.len]
            i += 1
        } else if arg == "-o" || arg == "--output" {
            if i + 1 < args.len {
                output = ~args[i + 1]
                output_set = true
                i += 2
            } else {
                println("xu debug: -o requires a path")
                << 1
            }
        } else if str_starts_with(&arg, "--output=") {
            output = arg[9:arg.len]
            output_set = true
            i += 1
        } else if str_starts_with(&arg, "-o=") {
            output = arg[3:arg.len]
            output_set = true
            i += 1
        } else if arg == "--target" {
            if i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else {
                println("xu debug: --target requires a name")
                << 1
            }
        } else if str_starts_with(&arg, "--target=") {
            target_name = arg[9:arg.len]
            target_set = true
            i += 1
        } else if arg == "--debug-build" || arg == "--no-opt" || arg == "--no-regcache" || arg == "--debug" || arg == "--ra=0" || arg == "--ra=1" || arg == "--ra=2" || arg == "--ra=3" {
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            println("xu debug: unknown flag " + arg)
            << 1
        } else {
            files.push(arg)
            i += 1
        }
    }

    if binary.len == 0 && files.len == 0 {
        println("xu debug: no input source or --binary path")
        << 1
    }
    if binary.len > 0 && files.len > 0 {
        println("xu debug: --binary cannot be combined with source files")
        << 1
    }

    $tgt_os := target.OS_MACOS
    $tgt_arch := target.ARCH_ARM64
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            println("xu debug: unknown target '" + target_name + "'")
            << 1
        }
        parsed_target := target.target_from_code(code)
        tgt_os = parsed_target.os
        tgt_arch = parsed_target.arch

        if tgt_os == target.OS_NONE || tgt_os == target.OS_UEFI {
            println("xu debug: freestanding targets have no host debugger")
            << 1
        }
        if tgt_os != target.OS_MACOS || tgt_arch != target.ARCH_ARM64 {
            println("xu debug: cross-target binaries cannot run under the host debugger")
            << 1
        }
    }

    $temp_binary := false
    $target_bin := binary
    if target_bin.len == 0 {
        if output_set {
            target_bin = output
        } else {
            pid := os.getpid()
            target_bin = "/tmp/xu_debug_" + str(pid) + "_" + str(now_ns() & 2147483647)
            temp_binary = true
        }

        files_len := files.len
        res := run_build(&files, files_len, target_bin, tgt_os * 10 + tgt_arch, true, false)
        if res != 0 {
            if temp_binary {
                debug_remove(&target_bin)
            }
            << res
        }
    }

    $dbg := backend
    if dbg.len == 0 {
        dbg = debug_find_backend("lldb")
        if dbg.len == 0 {
            dbg = debug_find_backend("gdb")
        }
    }
    if dbg.len == 0 {
        println("xu debug: no lldb or gdb executable found; use --backend PATH")
        if temp_binary {
            debug_remove(&target_bin)
        }
        << 127
    }

    is_gdb := str_contains(&dbg, "gdb")
    $cmd := exec.command(~dbg)
    if batch {
        if is_gdb {
            cmd.args.push("-batch")
        } else {
            cmd.args.push("--batch")
        }
    }
    for bi in 0:break_specs.len {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push(debug_break_command(&break_specs[bi], true))
        } else {
            cmd.args.push("-o")
            cmd.args.push(debug_break_command(&break_specs[bi], false))
        }
    }
    if program_args.len > 0 {
        if is_gdb {
            $pargs_cmd := "set args"
            for pi in 0:program_args.len {
                pargs_cmd = pargs_cmd + " " + program_args[pi]
            }
            cmd.args.push("-ex")
            cmd.args.push(~pargs_cmd)
        } else {
            $pargs_cmd := "settings set target.run-args"
            for pi in 0:program_args.len {
                pargs_cmd = pargs_cmd + " " + program_args[pi]
            }
            cmd.args.push("-o")
            cmd.args.push(~pargs_cmd)
        }
    }
    if stop_at_entry {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push("start")
        } else {
            cmd.args.push("-o")
            cmd.args.push("process launch --stop-at-entry")
        }
    } else if launch {
        if is_gdb {
            cmd.args.push("-ex")
            cmd.args.push("run")
        } else {
            cmd.args.push("-o")
            cmd.args.push("process launch")
        }
    }
    for ei in 0:eval_cmds.len {
        if is_gdb {
            cmd.args.push("-ex")
        } else {
            cmd.args.push("-o")
        }
        cmd.args.push(~eval_cmds[ei])
    }
    cmd.args.push(~target_bin)

    rc := cmd.run() >>> (err) {
        println("xu debug: backend failed to execute")
        if temp_binary {
            debug_remove(&target_bin)
        }
        <<< 127
    }

    if temp_binary {
        debug_remove(&target_bin)
    }
    << rc
}

fn resolve_target(target_set bool, explicit_target &target.Target) target.Target {
    if target_set {
        << ~explicit_target
    }
    xtarget := os.getenv("XU_TARGET")
    if xtarget.len > 0 {
        c := target.parse_target(xtarget)
        if c >= 0 {
            << target.target_from_code(c)
        }
    }
    xos := os.getenv("XUOS")
    if xos.len > 0 {
        xarch := os.getenv("XUARCH")
        if xarch.len > 0 {
            c := target.parse_target(xos + "-" + xarch)
            if c >= 0 {
                << target.target_from_code(c)
            }
        }
    }
    << target.target_host()
}

pub fn print_env_help() {
    println("usage: xu env [options] [var...]")
    println("")
    println("Print Xu toolchain and environment variables.")
    println("If one or more variable names are specified, prints only their values.")
    println("")
    println("Arguments:")
    println("  [var...]          one or more variable names to query")
    println("")
    println("Common variables:")
    println("  XU_VERSION        current compiler version")
    println("  XU_ROOT           root directory of the Xu toolchain/repository")
    println("  XU_STDLIB_ROOT    directory containing standard library sources")
    println("  XUPATH            package search paths")
    println("  XU_CACHE          package cache directory for downloaded modules")
    println("  XUOS              target operating system")
    println("  XUARCH            target architecture")
    println("  HOST_OS           host operating system")
    println("  HOST_ARCH         host architecture")
    println("  XUPROXY           package download proxy URL or direct/off")
    println("  XUSUMDB           checksum database URL/key")
    println("  XUPRIVATE         private module glob patterns bypassing proxy")
    println("")
    println("Options:")
    println("  -h, --help        show this help message")
}

pub fn run_env(args &[]string) int {
    if args.len > 2 {
        if args[2] == "-h" || args[2] == "--help" {
            print_env_help()
            << 0
        }
    }

    e_ver := compiler_version()
    e_root := os.getenv("XU_ROOT")
    e_std := stdlib_root()
    $e_xupath := os.getenv("XUPATH")
    $e_cache := os.getenv("XU_CACHE")
    if e_cache.len == 0 {
        h := os.home_dir()
        if h.len > 0 {
            e_cache = h + "/.xu/pkg"
        }
    }
    $e_proxy := os.getenv("XUPROXY")
    if e_proxy.len == 0 {
        e_proxy = "direct"
    }
    $e_sumdb := os.getenv("XUSUMDB")
    $e_priv := os.getenv("XUPRIVATE")

    host_t := target.target_host()
    host_os_s := target.target_os_name(host_t.os)
    host_arch_s := target.target_arch_name(host_t.arch)

    $xuos_s := os.getenv("XUOS")
    if xuos_s.len == 0 {
        xuos_s = host_os_s
    }
    $xuarch_s := os.getenv("XUARCH")
    if xuarch_s.len == 0 {
        xuarch_s = host_arch_s
    }

    if args.len > 2 {
        for i in 2:args.len {
            req := args[i]
            if req == "XU_VERSION" { println(e_ver) }
            else if req == "XU_ROOT" { println(e_root) }
            else if req == "XU_STDLIB_ROOT" { println(e_std) }
            else if req == "XUPATH" { println(e_xupath) }
            else if req == "XU_CACHE" { println(e_cache) }
            else if req == "XUOS" { println(xuos_s) }
            else if req == "XUARCH" { println(xuarch_s) }
            else if req == "HOST_OS" { println(host_os_s) }
            else if req == "HOST_ARCH" { println(host_arch_s) }
            else if req == "XUPROXY" { println(e_proxy) }
            else if req == "XUSUMDB" { println(e_sumdb) }
            else if req == "XUPRIVATE" { println(e_priv) }
            else { println("") }
        }
        << 0
    }

    println("XU_VERSION=\"" + e_ver + "\"")
    println("XU_ROOT=\"" + e_root + "\"")
    println("XU_STDLIB_ROOT=\"" + e_std + "\"")
    println("XUPATH=\"" + e_xupath + "\"")
    println("XU_CACHE=\"" + e_cache + "\"")
    println("XUOS=\"" + xuos_s + "\"")
    println("XUARCH=\"" + xuarch_s + "\"")
    println("HOST_OS=\"" + host_os_s + "\"")
    println("HOST_ARCH=\"" + host_arch_s + "\"")
    println("XUPROXY=\"" + e_proxy + "\"")
    println("XUSUMDB=\"" + e_sumdb + "\"")
    println("XUPRIVATE=\"" + e_priv + "\"")
    << 0
}

fn compiler_version() string {
    << "0.14.3"
}

pub fn print_version() int {
    tgt := target.target_host()
    println("    __  __  _   _   ")
    println("    \\ \\/ / | | | |   Xu Compiler Toolchain v" + compiler_version())
    println("     \\  /  | | | |   Rock-Solid Ownership - Zero GC - Supersonic AOT")
    println("     /  \\  | |_| |   Docs: https://xulang.org")
    println("    /_/\\_\\  \\___/    Target: " + target.target_os_name(tgt.os) + "-" + target.target_arch_name(tgt.arch) + " - 64-bit Native")
    << 0
}

pub fn run_install(args &[]string) int {
    $dir := ""
    for i in 2:args.len {
        arg := ~args[i]
        if arg == "-h" || arg == "--help" {
            print_install_help()
            << 0
        }
        if require_policy_flag(&arg) { -> }
        if dir.len > 0 || (arg.len > 0 && arg[0] == 45) {
            eprintln("xu install: unexpected argument '" + arg + "'")
            << 1
        }
        dir = arg
    }
    if dir.len == 0 { dir = cwd() }
    << run_install_project(dir, false)
}

fn remove_created_file(path &string) {
    os.remove(~path) >>> (err) {
        eprintln("xu: " + err.msg())
        <<
    }
}

// The caller owns the path only after exclusive creation succeeds. Never
// unlink a pre-existing file or follow a symlink while opening the path.
fn write_exclusive(path &string, data &string) bool {
    $file := os.create_excl(~path) >>> (err) {
        if os.is_exist(err.msg()) {
            << false
        }
        >> err
    }
    file.write(~data) >>> (err) {
        file.close() >>> (close_err) {
            eprintln("xu: " + close_err.msg())
            remove_created_file(path)
            >> err
        }
        remove_created_file(path)
        >> err
    }
    file.close() >>> (err) {
        remove_created_file(path)
        >> err
    }
    << true
}

fn run_init(args &[]string) int {
    cwd := os.getwd()
    $name := filepath.base(&cwd)
    $baremetal := false
    $pos_args := []string{}
    for i in 2:args.len {
        arg := ~args[i]
        if arg == "-h" || arg == "--help" {
            println("usage: xu init [--baremetal] [module]")
            << 0
        } else if arg == "--baremetal" {
            baremetal = true
        } else {
            pos_args.push(arg)
        }
    }
    if pos_args.len > 0 {
        name = ~pos_args[0]
    }
    if !modulepath.valid_module(&name) {
        if pos_args.len == 0 {
            name = "app"
        } else {
            eprintln("xu init: expected a single valid module name")
            << 1
        }
    }
    if pos_args.len > 1 {
        eprintln("xu init: expected a single valid module name")
        << 1
    }

    manifest_path := "xu.xun"
    $manifest := "module: " + name + "\nversion: !ver 0.1.0\nxu: !ver " + compiler_version() + "\n"
    if baremetal {
        manifest = "module: " + name + "\nversion: !ver 0.1.0\nxu: !ver " + compiler_version() + "\nprofile: freestanding\n"
    }
    created := write_exclusive(&manifest_path, &manifest) >>> (err) {
        eprintln("xu init: " + err.msg())
        << 1
    }
    if !created {
        eprintln("xu init: xu.xun already exists")
        << 1
    }

    main_path := "main.xu"
    $starter := "@main\n\nfn main() int {\n    println(\"Hello, Xu!\")\n    << 0\n}\n"
    if baremetal {
        starter = "@main\n$$freestanding\n\n#core/arch\n#core/mem\n#core/sync\n#core/task\n#core/virtio\n\n// Baremetal Kernel Starter Template\n// x86_64: COM1 is port I/O; AArch64 / RISC-V QEMU virt boards use MMIO UARTs.\nconst UART_COM1 = 0x03F8\nconst UART_PL011 = 0x09000000\nconst UART_NS16550 = 0x10000000\n\nfn uart_putc(c int) {\n    arch_id := xu_target_arch()\n    if arch_id == 1 {\n        unsafe { arch.out8(u16(UART_COM1), u8(c)) }\n    } else if arch_id == 0 {\n        volatile_write(UART_PL011 as *raw u8, u8(c))\n    } else {\n        volatile_write(UART_NS16550 as *raw u8, u8(c))\n    }\n}\n\nfn uart_print(msg string) {\n    $$i := 0\n    while i < msg.len {\n        uart_putc(int(msg[i]))\n        i = i + 1\n    }\n}\n\nfn main() int {\n    arch.cli()\n    uart_print(\"\\n====================================================\\n\")\n    uart_print(\"  Welcome to Xu Operating System (Baremetal Kernel) \\n\")\n    uart_print(\"  Zero-GC Deterministic Destruction!                \\n\")\n    uart_print(\"====================================================\\n\")\n    uart_print(\"[KERNEL] Booted successfully in Freestanding Mode.\\n\")\n    while true {\n        arch.halt()\n    }\n    << 0\n}\n"
    }
    write_exclusive(&main_path, &starter) >>> (err) {
        eprintln("xu init: " + err.msg())
        remove_created_file(&manifest_path)
        << 1
    }

    if baremetal {
        linker_path := "linker.ld"
        linker_script := "ENTRY(_start)\n\nSECTIONS {\n    . = 1M;\n    .text.boot : { *(.text.boot) }\n    .text : { *(.text .text.*) }\n    .rodata : { *(.rodata .rodata.*) }\n    .data : { *(.data .data.*) }\n    .bss : {\n        *(.bss .bss.*)\n        . = ALIGN(4096);\n        _stack_bottom = .;\n        . += 64K;\n        _stack_top = .;\n    }\n}\n"
        write_exclusive(&linker_path, &linker_script) >>> (err) {
            eprintln("xu init: " + err.msg())
            remove_created_file(&main_path)
            remove_created_file(&manifest_path)
            << 1
        }

        makefile_path := "Makefile"
        makefile_content := "XU ?= xu\n\nall: kernel_x64.elf kernel_arm64.elf kernel_rv64.elf\n\nkernel_x64.elf: main.xu\n\t$$(XU) build --profile=freestanding --target=x64-none main.xu -o kernel_x64.elf\n\nkernel_arm64.elf: main.xu\n\t$$(XU) build --profile=freestanding --target=arm64-none main.xu -o kernel_arm64.elf\n\nkernel_rv64.elf: main.xu\n\t$$(XU) build --profile=freestanding --target=riscv64-none main.xu -o kernel_rv64.elf\n\nqemu: kernel_x64.elf\n\tqemu-system-x86_64 -m 128M -kernel kernel_x64.elf -serial stdio -display none -no-reboot\n\nqemu-arm64: kernel_arm64.elf\n\tqemu-system-aarch64 -M virt -cpu cortex-a53 -m 128M -kernel kernel_arm64.elf -serial stdio -display none -no-reboot\n\nqemu-rv64: kernel_rv64.elf\n\tqemu-system-riscv64 -M virt -m 128M -bios none -kernel kernel_rv64.elf -serial stdio -display none -no-reboot\n\nclean:\n\trm -f kernel_x64.elf kernel_arm64.elf kernel_rv64.elf\n"
        write_exclusive(&makefile_path, &makefile_content) >>> (err) {
            eprintln("xu init: " + err.msg())
            remove_created_file(&linker_path)
            remove_created_file(&main_path)
            remove_created_file(&manifest_path)
            << 1
        }
        println("Initialized baremetal Xu OS project '" + name + "' in " + cwd)
        << 0
    }

    println("Initialized Xu module '" + name + "' in " + cwd)
    << 0
}

fn run_program(bin &string, args &[]string) int {
    $cmd := exec.command(~bin)
    for i in 0:args.len {
        cmd.args.push(~args[i])
    }
    << cmd.run_status() >>> (err) {
        eprintln("xu: " + err.msg())
        << 127
    }
}

fn run_temporary_program(bin &string, args &[]string) int {
    if xu_target_os() == target.OS_MACOS && xu_target_arch() == target.ARCH_ARM64 {
        sign := exec.command("/usr/bin/codesign", "--force", "--sign", "-", ~bin)
        status := sign.run_status() >>> (err) {
            eprintln("xu: cannot sign temporary macOS executable: " + err.msg())
            << 1
        }
        if status != 0 {
            eprintln("xu: cannot sign temporary macOS executable: " + *bin)
            << status
        }
    }
    << run_program(bin, args)
}

pub fn run_test(args &[]string) int {
    if args.len <= 2 {
        println("error: xu test requires at least one source file")
        << 1
    }
    $files := []string{}
    $target_set := false
    $target_name := ""
    $no_opt := false
    $flag_tensor_fusion := false
    $flag_tensor_fast_math := false
    $list_only := false
    $verbose := false

    $i := 2
    while i < args.len {
        arg := ~args[i]
        if (arg == "--target" || arg == "-target") && i + 1 < args.len {
            target_name = ~args[i + 1]
            target_set = true
            i += 2
        } else if str_starts_with(&arg, "--target=") {
            target_name = arg[9:arg.len]
            target_set = true
            i += 1
        } else if str_starts_with(&arg, "-target=") {
            target_name = arg[8:arg.len]
            target_set = true
            i += 1
        } else if arg == "--no-opt" {
            no_opt = true
            i += 1
        } else if arg == "--tensor-fusion" {
            flag_tensor_fusion = true
            i += 1
        } else if arg == "--tensor-fast-math" {
            flag_tensor_fusion = true
            flag_tensor_fast_math = true
            i += 1
        } else if arg == "-list" {
            list_only = true
            i += 1
        } else if arg == "-v" {
            verbose = true
            i += 1
        } else if arg == "-short" || arg == "-failfast" {
            i += 1
        } else if str_starts_with(&arg, "-O") {
            eprintln("xu test: unsupported option '" + arg + "'. Use --no-opt to disable optimization.")
            << 1
        } else if arg.len > 0 && arg[0] == 45 {
            i += 1
        } else {
            files.push(arg)
            i += 1
        }
    }

    if files.len == 0 {
        println("error: xu test requires at least one source file")
        << 1
    }

    if list_only {
        for fi in 0:files.len {
            src := os.read(files[fi]) >>> (err) {
                println("error: cannot read file: " + files[fi])
                <<< 1
            }
            $toks := []token.Token{}
        lexer.lex(src, $&toks, files[fi])
            $file_ast_toks := []ast.Token{}
            for ti in 0:toks.len {
                file_ast_toks.push(ast.Token{
                    kind: toks[ti].kind,
                    line: toks[ti].line,
                    col: toks[ti].col,
                    ival: toks[ti].ival,
                    sval: ~toks[ti].sval
                })
            }
            $p_sub := parser.new_parser(file_ast_toks)
            p_sub.parse_module()
            for di in 0:p_sub.decls.len {
                d := p_sub.decls[di]
                if p_sub.nodes[d].kind == ast.NK_FN && p_sub.nodes[d].d < 0 {
                    fn_name := p_sub.nodes[d].sval + ""
                    if is_test_fn(&fn_name) {
                        println(fn_name)
                    }
                }
            }
        }
        << 0
    }

    $explicit_t := target.target_host()
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            println("xu test: unknown target '" + target_name + "'")
            << 1
        }
        explicit_t = target.target_from_code(code)
    }
    t := resolve_target(target_set, &explicit_t)

    host := target.target_host()
    if t.os == target.OS_NONE || t.os == target.OS_UEFI {
        println("xu test: not available on freestanding targets")
        << 1
    }
    if t.os != host.os || t.arch != host.arch {
        println("xu test: cannot run cross-compiled tests (target differs from host); use build")
        << 1
    }

    files_len := files.len
    temp_dir := os.temp_dir()
    temp_path := abs_path(&temp_dir)
    $test_tmp_bin := temp_path + "/xu-test-" + str(os.getpid()) + "-" + str(now_ns())
    if t.os == target.OS_WINDOWS {
        test_tmp_bin = test_tmp_bin + ".exe"
    }
    code := target.target_code(t.os, t.arch)
    test_wasm_exports := []string{}
    res := build_program(&files, files_len, test_tmp_bin + "", code, target.CHIP_NATIVE, false, no_opt, false, false, false, false, -1, false, &test_wasm_exports, "", flag_tensor_fusion, flag_tensor_fast_math, 0, false, false, 65536)
    if res != 0 {
        << res
    }
    test_args := []string{}
    test_rc := run_temporary_program(&test_tmp_bin, &test_args)
    remove_created_file(&test_tmp_bin)
    if test_rc != 0 {
        println("FAIL: test execution failed")
        << 1
    }
    for fi in 0:files.len {
        println("PASS: " + files[fi])
    }
    println("ok (all tests passed)")
    << 0
}

fn default_object_output(files &[]string) string {
    for i in 0:files.len {
        if filepath.base(&files[i]) == "main.xu" {
            << "main"
        }
    }
    $name := filepath.base(&files[0])
    if str_ends_with(&name, ".xu") {
        name = name[0:name.len - 3]
    }
    if name.len == 0 || name == "." || name == ".." || name == "/" {
        << "a"
    }
    << name
}

fn convert_desktop_object(args &[]string, os_code int) int {
    if args.len != 4 {
        eprintln("usage: xu " + args[1] + " INPUT.xuobj OUTPUT.o")
        << 1
    }
    data := os.read(~args[2]) >>> (err) {
        eprintln("xu " + args[1] + ": " + err.msg())
        << 1
    }
    object := obj.convert_app_object(&data, os_code) >>> (err) {
        eprintln("xu " + args[1] + ": " + err.msg())
        << 1
    }
    os.write(~args[3], object.to_string()) >>> (err) {
        eprintln("xu " + args[1] + ": " + err.msg())
        << 1
    }
    << 0
}

fn run_desktop_build(src &string, code int, output &string, webview bool, www &string) int {
    tool := "xu-desktop"
    $bin := toolpath.sibling(&tool) >>> (err) {
        eprintln("xu build: " + err.msg())
        << 127
    }
    if bin.len == 0 {
        bin = ~tool
    }
    $args := ["pack", ~src, "--target", target.target_name(code)]
    if output.len > 0 {
        args.push("-o")
        args.push(~output)
    }
    if www.len > 0 {
        args.push("--www")
        args.push(~www)
    }
    if webview {
        args.push("--webview")
    } else {
        args.push("--no-webview")
    }
    << run_program(&bin, &args)
}

pub fn run_cli(args &[]string) int {
    if args.len <= 1 {
        print_help()
        << 0
    }

    subcmd := args[1]

    if subcmd == "_ios_o" || subcmd == "_ios_sim_o" {
        << convert_phone_object(args, subcmd == "_ios_sim_o")
    }
    if subcmd == "_macho_o" {
        << convert_desktop_object(args, target.OS_MACOS)
    }
    if subcmd == "_coff_o" {
        << convert_desktop_object(args, target.OS_WINDOWS)
    }
    if subcmd == "_elf_o" {
        << convert_desktop_object(args, target.OS_LINUX)
    }

    if subcmd == "version" || subcmd == "-v" || subcmd == "--version" || subcmd == "-version" || subcmd == "--ver" {
        << print_version()
    }

    if subcmd == "help" || subcmd == "-h" || subcmd == "--help" {
        if args.len > 2 {
            sub2 := args[2]
            if sub2 == "get" {
                print_get_help()
                << 0
            }
            if sub2 == "install" {
                print_install_help()
                << 0
            }
            if sub2 == "xacp" {
                help_args := ["--help"]
                << run_xacp_tool(&help_args)
            }
            if sub2 == "debug" {
                print_debug_help()
                << 0
            }
            if sub2 == "build" {
                print_help()
                << 0
            }
            if sub2 == "test" {
                print_help()
                << 0
            }
            if sub2 == "env" {
                print_env_help()
                << 0
            }
        }
        print_help()
        << 0
    }

    if subcmd == "env" {
        << run_env(args)
    }

    if subcmd == "init" || subcmd == "new" {
        << run_init(args)
    }

    if subcmd == "get" {
        << run_get(args)
    }
    if subcmd == "_get-install" {
        << run_get_install(args)
    }

    if subcmd == "install" {
        << run_install(args)
    }

    if subcmd == "check" {
        << run_check_cli(args)
    }
    if subcmd == "cbind" {
        << run_cbind_cli(args)
    }

    if subcmd == "run" {
        if args.len <= 2 {
            println("error: xu run requires a source file")
            << 1
        }
        $files := []string{}
        $target_set := false
        $target_name := ""
        $no_opt := false
        $flag_tensor_fusion := false
        $flag_tensor_fast_math := false
        $program_args := []string{}
        $xacp_port := -1
        $after_sep := false

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if after_sep {
                program_args.push(arg)
                i += 1
            } else if arg == "--" {
                after_sep = true
                i += 1
            } else if arg == "--xacp" {
                if xacp_port < 0 { xacp_port = 0 }
                i += 1
            } else if arg == "--xacp-port" || str_starts_with(&arg, "--xacp-port=") {
                xacp_port = xacp_option_port(args, i)
                if xacp_port < 0 {
                    eprintln("xu run: --xacp-port requires an integer in 0..65535")
                    << 1
                }
                i += xacp_option_width(&arg)
            } else if require_policy_flag(&arg) {
                i += 1
            } else if arg == "--profile=freestanding" || arg == "--freestanding" || arg == "--no-std" {
                if !target_set {
                    target_name = "x64-none"
                    target_set = true
                }
                i += 1
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else if str_starts_with(&arg, "--target=") {
                target_name = arg[9:arg.len]
                target_set = true
                i += 1
            } else if str_starts_with(&arg, "-target=") {
                target_name = arg[8:arg.len]
                target_set = true
                i += 1
            } else if arg == "--no-opt" {
                no_opt = true
                i += 1
            } else if arg == "--tensor-fusion" {
                flag_tensor_fusion = true
                i += 1
            } else if arg == "--tensor-fast-math" {
                flag_tensor_fusion = true
                flag_tensor_fast_math = true
                i += 1
            } else if str_starts_with(&arg, "-O") {
                eprintln("xu run: unsupported option '" + arg + "'. Use --no-opt to disable optimization.")
                << 1
            } else {
                files.push(arg)
                i += 1
            }
        }

        if files.len == 0 {
            println("error: xu run requires a source file")
            << 1
        }

        $explicit_t := target.target_host()
        if target_set {
            code := target.parse_target(target_name)
            if code < 0 {
                println("xu run: unknown target '" + target_name + "'")
                << 1
            }
            explicit_t = target.target_from_code(code)
        }
        t := resolve_target(target_set, &explicit_t)

        host := target.target_host()
        if t.os == target.OS_NONE || t.os == target.OS_UEFI {
            println("xu run: not available on freestanding targets")
            << 1
        }
        if t.os != host.os || t.arch != host.arch {
            println("xu run: cannot run cross-compiled binary (target differs from host); use build")
            << 1
        }

        temp_dir := os.temp_dir()
        temp_path := abs_path(&temp_dir)
        $run_tmp_bin := temp_path + "/xu-run-" + str(os.getpid()) + "-" + str(now_ns())
        if t.os == target.OS_WINDOWS {
            run_tmp_bin = run_tmp_bin + ".exe"
        }
        files_len := files.len
        code := target.target_code(t.os, t.arch)
        wasm_exports := []string{}
        res := build_program(&files, files_len, ~run_tmp_bin, code, target.CHIP_NATIVE, false, no_opt, false, false, true, false, xacp_port, false, &wasm_exports, "", flag_tensor_fusion, flag_tensor_fast_math, 0, false, false, 65536)
        if res != 0 {
            << res
        }
        rc := run_temporary_program(&run_tmp_bin, &program_args)
        remove_created_file(&run_tmp_bin)
        << rc
    }
    if subcmd == "test" {
        << run_test(args)
    }
    if subcmd == "debug" {
        << run_debug(args)
    }
    if subcmd == "build" {
        if args.len <= 2 {
            println("error: xu build requires at least one source file (args <= 2)")
            << 1
        }
        $files := []string{}
        $out_file := ""
        $out_file_set := false
        $target_set := false
        $target_name := ""
        $chip_set := false
        $chip_name := ""
        // Release (the default) or debug build; --no-opt only disables
        // optimization.
        $is_debug_mode := false
        $no_opt := false
        $flag_tensor_fusion := false
        $flag_tensor_fast_math := false
        $no_sse := false
        $emit_dwarf := false
        $emit_object := false
        $phone_object := false
        $wasm_exports := []string{}
        $desktop := false
        $phone := false
        $phone_profile := ""
        $bundle_id := ""
        $app_name := ""
        $app_version := ""
        $version_code := ""
        $orientation := ""
        $icon := ""
        $phone_force := false
        $phone_internet := false
        $webview := false
        $no_webview := false
        $www := ""
        $is_verbose := false
        $xacp_port := -1
        $pgo_cli_file := ""
        $base_addr := 0
        $has_base_addr := false
        $boot_stack_bytes := 65536

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if arg == "-h" || arg == "--help" {
                print_help()
                << 0
            } else if (arg == "-o" || arg == "--output") && i + 1 < args.len {
                out_file = ~args[i + 1]
                out_file_set = true
                i += 2
            } else if str_starts_with(&arg, "--output=") {
                out_file = arg[9:arg.len]
                out_file_set = true
                i += 1
            } else if str_starts_with(&arg, "-o=") {
                out_file = arg[3:arg.len]
                out_file_set = true
                i += 1
            } else if (arg == "--pgo" || arg == "--pgo-file") && i + 1 < args.len {
                pgo_cli_file = ~args[i + 1]
                i += 2
            } else if str_starts_with(&arg, "--pgo=") {
                pgo_cli_file = arg[6:arg.len]
                i += 1
            } else if str_starts_with(&arg, "--pgo-file=") {
                pgo_cli_file = arg[11:arg.len]
                i += 1
            } else if arg == "--profile=freestanding" || arg == "--freestanding" || arg == "--no-std" {
                if !target_set {
                    target_name = "x64-none"
                    target_set = true
                }
                i += 1
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                target_name = ~args[i + 1]
                target_set = true
                i += 2
            } else if str_starts_with(&arg, "--target=") {
                target_name = arg[9:arg.len]
                target_set = true
                i += 1
            } else if str_starts_with(&arg, "-target=") {
                target_name = arg[8:arg.len]
                target_set = true
                i += 1
            } else if (arg == "--chip" || arg == "-chip" || arg == "--cpu" || arg == "-cpu" || arg == "-march" || arg == "-mcpu") && i + 1 < args.len {
                chip_name = ~args[i + 1]
                chip_set = true
                i += 2
            } else if str_starts_with(&arg, "--chip=") {
                chip_name = arg[7:arg.len]
                chip_set = true
                i += 1
            } else if str_starts_with(&arg, "--cpu=") {
                chip_name = arg[6:arg.len]
                chip_set = true
                i += 1
            } else if str_starts_with(&arg, "-march=") {
                chip_name = arg[8:arg.len]
                chip_set = true
                i += 1
            } else if str_starts_with(&arg, "-mcpu=") {
                chip_name = arg[7:arg.len]
                chip_set = true
                i += 1
            } else if arg == "--release" {
                is_debug_mode = false
                i += 1
            } else if require_policy_flag(&arg) {
                i += 1
            } else if arg == "--debug-build" {
                is_debug_mode = true
                i += 1
            } else if arg == "--ra=1" {
                // The typed backend has one allocator for optimized builds.
                i += 1
            } else if arg == "--no-opt" {
                no_opt = true
                i += 1
            } else if arg == "--tensor-fusion" {
                flag_tensor_fusion = true
                i += 1
            } else if arg == "--tensor-fast-math" {
                flag_tensor_fusion = true
                flag_tensor_fast_math = true
                i += 1
            } else if arg == "--no-sse" || arg == "--no-fp" || arg == "--no-simd" {
                no_sse = true
                i += 1
            } else if arg == "-g" || arg == "--debug" {
                emit_dwarf = true
                i += 1
            } else if arg == "--_phone-object" {
                phone_object = true
                emit_object = true
                i += 1
            } else if arg == "--emit-obj" {
                emit_object = true
                i += 1
            } else if arg == "--base-addr" && i + 1 < args.len {
                barg := ~args[i + 1]
                parsed_base := parse_base_addr_arg(&barg)
                if !parsed_base.ok {
                    eprintln("xu build: invalid --base-addr '" + barg + "'")
                    << 1
                }
                base_addr = parsed_base.val
                has_base_addr = true
                i += 2
            } else if str_starts_with(&arg, "--base-addr=") {
                bpart := arg[12:arg.len]
                parsed_base := parse_base_addr_arg(&bpart)
                if !parsed_base.ok {
                    eprintln("xu build: invalid --base-addr '" + bpart + "'")
                    << 1
                }
                base_addr = parsed_base.val
                has_base_addr = true
                i += 1
            } else if arg == "--stack-size" && i + 1 < args.len {
                sarg := ~args[i + 1]
                parsed_stk := parse_base_addr_arg(&sarg)
                if !parsed_stk.ok || parsed_stk.val < 4096 || parsed_stk.val > 1048576 {
                    eprintln("xu build: --stack-size requires an integer in 4096..1048576")
                    << 1
                }
                boot_stack_bytes = ((parsed_stk.val + 15) / 16) * 16
                i += 2
            } else if str_starts_with(&arg, "--stack-size=") {
                spart := arg[13:arg.len]
                parsed_stk := parse_base_addr_arg(&spart)
                if !parsed_stk.ok || parsed_stk.val < 4096 || parsed_stk.val > 1048576 {
                    eprintln("xu build: --stack-size requires an integer in 4096..1048576")
                    << 1
                }
                boot_stack_bytes = ((parsed_stk.val + 15) / 16) * 16
                i += 1
            } else if arg == "--wasm-export" && i + 1 < args.len {
                wasm_exports.push(~args[i + 1])
                i += 2
            } else if arg == "--xacp" {
                if xacp_port < 0 { xacp_port = 0 }
                i += 1
            } else if arg == "--xacp-port" || str_starts_with(&arg, "--xacp-port=") {
                xacp_port = xacp_option_port(args, i)
                if xacp_port < 0 {
                    eprintln("xu build: --xacp-port requires an integer in 0..65535")
                    << 1
                }
                i += xacp_option_width(&arg)
            } else if arg == "--phone" {
                phone = true
                i += 1
            } else if arg == "--phone-profile" && i + 1 < args.len {
                phone_profile = ~args[i + 1]
                if phone_profile != "ui" && phone_profile != "game" {
                    eprintln("xu build: Phone profile must be ui or game")
                    << 1
                }
                i += 2
            } else if arg == "--bundle-id" && i + 1 < args.len {
                bundle_id = ~args[i + 1]
                i += 2
            } else if str_starts_with(&arg, "--bundle-id=") {
                bundle_id = arg[12:arg.len]
                i += 1
            } else if arg == "--app-name" && i + 1 < args.len {
                app_name = ~args[i + 1]
                i += 2
            } else if str_starts_with(&arg, "--app-name=") {
                app_name = arg[11:arg.len]
                i += 1
            } else if arg == "--app-version" && i + 1 < args.len {
                app_version = ~args[i + 1]
                i += 2
            } else if str_starts_with(&arg, "--app-version=") {
                app_version = arg[14:arg.len]
                i += 1
            } else if arg == "--version-code" && i + 1 < args.len {
                version_code = ~args[i + 1]
                i += 2
            } else if str_starts_with(&arg, "--version-code=") {
                version_code = arg[15:arg.len]
                i += 1
            } else if arg == "--orientation" && i + 1 < args.len {
                orientation = ~args[i + 1]
                i += 2
            } else if str_starts_with(&arg, "--orientation=") {
                orientation = arg[14:arg.len]
                i += 1
            } else if arg == "--icon" && i + 1 < args.len {
                icon = ~args[i + 1]
                i += 2
            } else if str_starts_with(&arg, "--icon=") {
                icon = arg[7:arg.len]
                i += 1
            } else if arg == "--force" {
                phone_force = true
                i += 1
            } else if arg == "--internet" {
                phone_internet = true
                i += 1
            } else if arg == "--desktop" || arg == "--no-desktop" {
                desktop = arg == "--desktop"
                i += 1
            } else if arg == "--webview" {
                webview = true
                i += 1
            } else if arg == "--no-webview" {
                no_webview = true
                i += 1
            } else if arg == "--www" && i + 1 < args.len {
                www = ~args[i + 1]
                i += 2
            } else if arg == "-v" || arg == "--verbose" {
                is_verbose = true
                i += 1
            } else if arg.len > 0 && arg[0] == 45 {
                eprintln("xu build: unsupported or incomplete option '" + arg + "'")
                << 1
            } else {
                files.push(arg)
                i += 1
            }
        }

        files_count := files.len
        if files_count == 0 {
            println("error: xu build requires at least one source file (files == 0)")
            << 1
        }
        if wasm_exports.len > 0 && (target_name != "wasm32-wasi" || desktop || phone || emit_object || xacp_port >= 0) {
            eprintln("xu build: --wasm-export requires --target wasm32-wasi")
            << 1
        }

        if phone || phone_target(&target_name) {
            if !target_set || !phone_target(&target_name) {
                eprintln("xu build: --phone requires --target ios-arm64, ios-simulator-arm64, or android-arm64")
                << 1
            }
            if files_count != 1 || desktop || emit_object || webview || no_webview || www.len > 0 || no_opt || emit_dwarf || is_debug_mode || chip_set || xacp_port >= 0 {
                eprintln("xu build: Phone generation takes one module and cannot combine desktop, object, WebView, optimization, chip, debug or XACP options")
                << 1
            }
            << run_phone_build(&files[0], &target_name, &out_file, &bundle_id, &phone_profile, &app_name, &app_version, &version_code, &orientation, &icon, phone_force, phone_internet)
        }
        if phone_profile.len > 0 {
            eprintln("xu build: --phone-profile requires --phone")
            << 1
        }
        if bundle_id.len > 0 {
            eprintln("xu build: --bundle-id requires --phone")
            << 1
        }
        if app_name.len > 0 {
            eprintln("xu build: --app-name requires --phone")
            << 1
        }
        if app_version.len > 0 {
            eprintln("xu build: --app-version requires --phone")
            << 1
        }
        if version_code.len > 0 {
            eprintln("xu build: --version-code requires --phone")
            << 1
        }
        if orientation.len > 0 {
            eprintln("xu build: --orientation requires --phone")
            << 1
        }
        if icon.len > 0 {
            eprintln("xu build: --icon requires --phone")
            << 1
        }
        if phone_force {
            eprintln("xu build: --force requires --phone")
            << 1
        }
        if phone_internet {
            eprintln("xu build: --internet requires --phone")
            << 1
        }

        // Resolve --target before environment defaults. With neither set,
        // build for the compiler's own host target.
        $explicit_target := target.target_host()
        if target_set {
            code := target.parse_target(target_name)
            if code < 0 {
                println("xu build: unknown target '" + target_name + "'")
                << 1
            }
            explicit_target = target.target_from_code(code)
        }
        resolved_target := resolve_target(target_set, &explicit_target)
        tgt_os := resolved_target.os
        tgt_arch := resolved_target.arch
        code := target.target_code(tgt_os, tgt_arch)

        dwarf := emit_dwarf || is_debug_mode
        if desktop {
            if xacp_port >= 0 {
                eprintln("xu build: --xacp requires building the app binary directly")
                << 1
            }
            if files_count != 1 {
                eprintln("xu build: --desktop takes exactly one app directory or .xu file")
                << 1
            }
            if emit_object {
                eprintln("xu build: --desktop conflicts with --emit-obj")
                << 1
            }
            if no_opt || dwarf || chip_set || flag_tensor_fusion || flag_tensor_fast_math {
                eprintln("xu build: --desktop does not accept custom optimization, debug, or chip options")
                << 1
            }
            << run_desktop_build(&files[0], code, &out_file, webview && !no_webview, &www)
        }
        if webview || no_webview || www.len > 0 {
            eprintln("xu build: WebView and resource options require --desktop")
            << 1
        }

        $selected_chip := target.CHIP_NATIVE
        if chip_set {
            parsed_chip := target.parse_chip(chip_name)
            if parsed_chip < 0 {
                println("xu build: unknown chip/cpu '" + chip_name + "'")
                << 1
            }
            selected_chip = parsed_chip
        }

        if emit_object {
            if !out_file_set {
                out_file = default_object_output(&files)
            }
        } else if tgt_os == target.OS_WINDOWS {
            if !out_file_set {
                out_file = "a.exe"
            } else {
                if str_ends_with(&out_file, ".xin") {
                    out_file = out_file[0:out_file.len - 4] + ".exe"
                } else if !str_ends_with(&out_file, ".exe") {
                    out_file = out_file + ".exe"
                }
            }
        } else if tgt_os == target.OS_UEFI {
            if !out_file_set {
                if tgt_arch == target.ARCH_ARM64 {
                    out_file = "BOOTAA64.EFI"
                } else {
                    out_file = "BOOTX64.EFI"
                }
            }
        } else {
            if !out_file_set {
                if tgt_arch == target.ARCH_WASM {
                    out_file = "a.wasm"
                } else {
                    out_file = "a.out"
                }
            }
        }

        << build_program(&files, files_count, out_file, code, selected_chip, is_debug_mode, no_opt, dwarf, is_verbose, false, emit_object, xacp_port, phone_object, &wasm_exports, pgo_cli_file, flag_tensor_fusion, flag_tensor_fast_math, base_addr, has_base_addr, no_sse, boot_stack_bytes)
    }

    if subcmd == "xacp" {
        $tool_args := []string{}
        for i in 2:args.len { tool_args.push(~args[i]) }
        << run_xacp_tool(&tool_args)
    }
    is_sibling := subcmd == "fmt" || subcmd == "doc" || subcmd == "map" || subcmd == "doctor" || subcmd == "phone" || subcmd == "native" || subcmd == "lsp" || subcmd == "setup" || subcmd == "up" || subcmd == "update"
    if is_sibling {
        $has_help := false
        for hi in 2:args.len {
            if args[hi] == "-h" || args[hi] == "--help" {
                has_help = true
                <-
            }
        }
        if has_help {
            if subcmd == "up" || subcmd == "update" {
                print_update_help()
                << 0
            }
        }
        $sibling_name := "xu-" + subcmd
        if subcmd == "up" || subcmd == "update" {
            sibling_name = "xu-update"
        }
        $tool := toolpath.sibling(&sibling_name) >>> (err) {
            eprintln("xu: cannot resolve sibling tool: " + err.msg())
            << 127
        }
        if tool.len == 0 { tool = ~sibling_name }
        $cmd := exec.command(tool)
        for i in 2:args.len {
            cmd.args.push(~args[i])
        }
        rc := cmd.run() >>> (err) {
            println("xu: sibling tool '" + sibling_name + "' not found or failed to execute")
            <<< 127
        }
        << rc
    }

    println("unknown command: " + subcmd)
    print_help()
    << 1
}

fn run_check_cli(args &[]string) int {
    $files := []string{}
    $target_name := ""
    $target_set := false
    $lib_mode := 0
    $i := 2
    while i < args.len {
        arg := ~args[i]
        if arg == "-h" || arg == "--help" {
            println("usage: xu check [--lib] [--target TARGET] <input.xu or dir>...")
            << 0
        } else if arg == "--lib" {
            lib_mode = 1
            i += 1
        } else if require_policy_flag(&arg) {
            i += 1
        } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
            target_name = ~args[i + 1]
            target_set = true
            i += 2
        } else if str_starts_with(&arg, "--target=") || str_starts_with(&arg, "-target=") {
            $start := 9
            if arg[1] != 45 {
                start = 8
            }
            target_name = arg[start:arg.len]
            target_set = true
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            eprintln("xu check: unsupported or incomplete option '" + arg + "'")
            << 1
        } else {
            files.push(arg)
            i += 1
        }
    }
    if files.len == 0 {
        eprintln("xu check: expected a source file or module directory")
        << 1
    }
    $explicit := target.target_host()
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            eprintln("xu check: unknown target '" + target_name + "'")
            << 1
        }
        explicit = target.target_from_code(code)
    }
    selected := resolve_target(target_set, &explicit)
    code := target.target_code(selected.os, selected.arch)
    << check_inputs(&files, files.len, code, lib_mode)
}

pub fn run_check(files &[]string, files_count int) int {
    host := target.target_host()
    << check_inputs(files, files_count, target.target_code(host.os, host.arch), 0)
}

fn check_inputs(files &[]string, count int, code int, lib_mode int) int {
    $p := parser.new_parser([]ast.Token{})
    $native := native_unit()
    load_unit(files, count, code, false, -1, $&p, $&native) >>> (err) {
        eprintln("xu check: " + err.msg())
        << 1
    }
    $chk := checker.Checker{}
    checker.check_only_native(&p, code, lib_mode, &native.labels, $&chk)
    println("Checked " + str(p.file_names.len) + " file(s): " + str(p.decls.len) + " declaration(s) OK")
    << 0
}

fn cbind_guard_for_out(out_path &string) string {
    if out_path.len == 0 { << "XU_CBIND_H" }
    $start := 0
    for i in 0:out_path.len {
        if out_path[i] == 47 || out_path[i] == 92 { start = i + 1 }
    }
    $g := "XU_"
    for i in start:out_path.len {
        $ch := out_path[i]
        if ch >= 97 && ch <= 122 { ch -= 32 }
        if (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95 {
            g = g + string_from_byte(ch)
        } else {
            g = g + "_"
        }
    }
    << g
}

fn run_cbind_cli(args &[]string) int {
    $files := []string{}
    $target_name := ""
    $target_set := false
    $out_path := ""
    $guard := ""
    $i := 2
    while i < args.len {
        arg := ~args[i]
        if arg == "-h" || arg == "--help" {
            println("usage: xu cbind [-o|--out FILE.h] [--target TARGET] [--guard MACRO] <input.xu or dir>...")
            << 0
        } else if (arg == "--out" || arg == "-o" || arg == "--output") && i + 1 < args.len {
            out_path = ~args[i + 1]
            i += 2
        } else if str_starts_with(&arg, "--out=") {
            out_path = arg[6:arg.len]
            i += 1
        } else if arg == "--guard" && i + 1 < args.len {
            guard = ~args[i + 1]
            i += 2
        } else if require_policy_flag(&arg) {
            i += 1
        } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
            target_name = ~args[i + 1]
            target_set = true
            i += 2
        } else if str_starts_with(&arg, "--target=") || str_starts_with(&arg, "-target=") {
            $start := 9
            if arg[1] != 45 { start = 8 }
            target_name = arg[start:arg.len]
            target_set = true
            i += 1
        } else if arg.len > 0 && arg[0] == 45 {
            eprintln("xu cbind: unsupported or incomplete option '" + arg + "'")
            << 1
        } else {
            files.push(arg)
            i += 1
        }
    }
    if files.len == 0 {
        eprintln("xu cbind: expected a source file or module directory")
        << 1
    }
    $explicit := target.target_host()
    if target_set {
        code := target.parse_target(target_name)
        if code < 0 {
            eprintln("xu cbind: unknown target '" + target_name + "'")
            << 1
        }
        explicit = target.target_from_code(code)
    }
    selected := resolve_target(target_set, &explicit)
    code := target.target_code(selected.os, selected.arch)
    $p := parser.new_parser([]ast.Token{})
    $native := native_unit()
    load_unit(&files, files.len, code, false, -1, $&p, $&native) >>> (err) {
        eprintln("xu cbind: " + err.msg())
        << 1
    }
    $skip := stdlib_root() + "/"
    first := abs_path(&files[0])
    if str_starts_with(&first, skip + "") || first == stdlib_root() {
        skip = ""
    }
    if guard.len == 0 {
        guard = cbind_guard_for_out(&out_path)
    }
    $chk := checker.Checker{}
    hdr := checker.cbind_header($&chk, &p, code, &native.labels, skip, guard)
    if out_path.len > 0 {
        os.write(out_path, hdr) >>> (err) {
            eprintln("xu cbind: " + err.msg())
            << 1
        }
        << 0
    }
    if hdr.len > 0 && hdr[hdr.len - 1] == 10 {
        println(hdr[0:hdr.len - 1])
    } else {
        println(hdr)
    }
    << 0
}

fn is_test_fn(name &string) bool {
    if name.len >= 5 {
        if name[0] == 116 && name[1] == 101 && name[2] == 115 && name[3] == 116 && name[4] == 95 {
            << true
        }
    }
    << false
}

fn is_dot_o(s string) bool {
    if s.len >= 2 {
        if s[s.len - 2] == 46 && s[s.len - 1] == 111 {
            << true
        }
    }
    << false
}

fn abs_source_path(path string, cwd string) string {
    if path.len > 0 && path[0] == 47 {
        << path + ""
    }
    if str_starts_with(&path, "./") {
        << cwd + "/" + path[2:path.len]
    }
    << cwd + "/" + path
}

fn int_in(xs &[]int, v int) bool {
    for i in 0:xs.len {
        if xs[i] == v { << true }
    }
    << false
}

fn dwarf_type_code(ty int) int {
    if ty == 2 { << obj.DWARF_TY_BOOL }
    if ty == 4 { << obj.DWARF_TY_F64 }
    if ty == 10 { << obj.DWARF_TY_U8 }
    if ty == 8 { << obj.DWARF_TY_I32 }
    if ty == 9 { << obj.DWARF_TY_U32 }
    if ty == 3 { << obj.DWARF_TY_STR }
    if types.is_ref_type(ty) { << obj.DWARF_TY_PTR }
    << obj.DWARF_TY_INT
}

// Source-level locals only: compiler-made ones are named ".<what>".
fn dwarf_local_shown(f &mir.MFn, i int) bool {
    if i >= f.local_names.len { << false }
    name := f.local_names[i]
    if name.len == 0 || name == "_" {
        << false
    }
    for ci in 0:name.len {
        ch := name[ci]
        if !((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) || ch == 95) {
            << false
        }
    }
    << true
}

fn collect_debug_info(p &parser.Parser, m &mir.Mir, syms &mc.SymbolTable, emit_order &[]int, line_rows &[]int, fn_rows &[]int, code_len int, fp_reg int) obj.DebugInfo {
    cwd := os.getwd()
    $files := []string{}
    for i in 0:p.file_names.len {
        files.push(abs_source_path(p.file_names[i], cwd))
    }
    $rows := []obj.DLineRow{}
    $funcs := []obj.DFuncRow{}
    for position in 0:emit_order.len {
        fi := emit_order[position]
        if m.fns[fi].src_line <= 0 {
            ->
        }
        start := syms.lookup_offset(m.fns[fi].label)
        $end := code_len
        if position + 1 < emit_order.len {
            next_fn := emit_order[position + 1]
            end = syms.lookup_offset(m.fns[next_fn].label)
        } else {
            stubs := syms.lookup_offset("__xu_start")
            if stubs > start {
                end = stubs
            }
        }
        $ri := fn_rows[position]
        $rend := line_rows.len
        if position + 1 < fn_rows.len {
            rend = fn_rows[position + 1]
        }
        while ri + 1 < rend {
            rows.push(obj.DLineRow{offset: line_rows[ri], file: m.fns[fi].src_file, line: line_rows[ri + 1]})
            ri += 2
        }
        $locals := []obj.DLocalRow{}
        offs := codegen.frame_local_fp_offsets(&m.fns[fi])
        for li in 0:m.fns[fi].locals.len {
            if !dwarf_local_shown(&m.fns[fi], li) || li >= offs.len {
                ->
            }
            locals.push(obj.DLocalRow{name: m.fns[fi].local_names[li] + "", fp_off: offs[li], line: m.fns[fi].src_line, ty: dwarf_type_code(m.fns[fi].locals[li]), is_param: int_in(&m.fns[fi].param_locals, li)})
        }
        funcs.push(obj.DFuncRow{name: m.fns[fi].name + "", file: m.fns[fi].src_file, line: m.fns[fi].src_line, start: start, size: end - start, locals: locals})
    }
    << obj.DebugInfo{files: files, rows: rows, funcs: funcs, fp_reg: fp_reg}
}

pub fn run_build(files &[]string, files_count int, out_file string, target_code int, is_debug bool, is_verbose bool) int {
    << run_build_with_chip(files, files_count, out_file, target_code, target.CHIP_NATIVE, is_debug, is_debug, is_debug, is_verbose)
}

fn count_call_ind(f &mir.MFn) int {
    $n := 0
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            if f.instrs[ii].kind == mir.MI_CALL_IND {
                n += 1
            }
            ii = f.instrs[ii].next
        }
    }
    << n
}

// Scalar passes over one function, for arm64 / x64 only. Local value
// forwarding only pays off after tail-recursion elimination or
// block-level inlining rewrote the function (locals_too forces it), so
// it does not run otherwise.
fn opt_scalar(f $&mir.MFn, fw $&mir.FoldWork, gw $&mir.GvnWork, do_tail bool, do_locals bool, do_gvn bool, locals_too bool) {
    mir.opt_fold_with(f, fw)
    $again := locals_too
    if do_tail && mir.opt_tail(f) {
        again = true
    }
    if again && do_locals {
        mir.opt_locals(f)
    }
    if do_gvn && mir.opt_gvn_with(f, gw) {
        again = true
    }
    if again {
        mir.opt_fold_with(f, fw)
    }
}

// is_debug: a debug build (unoptimized, runtime memory checks on).
// no_opt: disable optimization only.
// dwarf: emit DWARF line tables, functions and locals (-g).
pub fn run_build_with_chip(files &[]string, files_count int, out_file string, target_code int, chip_id int, is_debug bool, no_opt bool, dwarf bool, is_verbose bool) int {
    wasm_exports := []string{}
    << build_program(files, files_count, out_file, target_code, chip_id, is_debug, no_opt, dwarf, is_verbose, false, false, -1, false, &wasm_exports, "", false, false, 0, false, false, 65536)
}

fn object_import(r &mc.Reloc, tgt_os int, arch int, link_ui bool, link_phone bool) bool {
    if r.addend != 0 {
        << false
    }
    if r.symbol_name == codegen.FFI_STATE_LABEL {
        if arch == target.ARCH_ARM64 && (r.kind == mc.RELOC_ARM64_ADR_PAGE21 || r.kind == mc.RELOC_ARM64_ADD_LO12) { << true }
        if arch == target.ARCH_X64 && r.kind == mc.RELOC_X64_DATA_PC32 { << true }
        << false
    }
    if arch == target.ARCH_ARM64 && r.kind != mc.RELOC_ARM64_CALL26 {
        << false
    }
    if arch == target.ARCH_X64 && r.kind != mc.RELOC_X64_PC32 {
        << false
    }
    $name := r.symbol_name + ""
    if tgt_os == target.OS_WINDOWS {
        if str_starts_with(&name, "_iat_") ||
            (arch == target.ARCH_ARM64 && codegen.arm64_win_api_import(&name)) { << true }
    } else if tgt_os == target.OS_MACOS {
        if name == "__NSGetEnviron" || name == "_clock_gettime" { << true }
        if name.len == 0 || name[0] != 95 { << false }
        name = name[1:name.len]
    }
    if tgt_os != target.OS_WINDOWS && (name == "dlopen" || name == "dlsym" || name == "dlerror") { << true }
    if link_phone && (name == "xu_phone_state" || name == "xu_phone_finish" || name == "xu_phone_syscall") { << true }
    << link_ui && (name == "xu_ui_host_run_cooperative" || name == "xu_ui_mem_try_read_len" ||
        name == "xu_ui_mem_try_read_copy" || name == "xu_ui_mem_try_write")
}

fn resolve_wasm_exports(tp &types.TypedProgram, names &[]string) []int {
    $roots := []int{}
    for name in names {
        if name == "memory" || name == "_start" || name == "main" {
            >> errors.new("reserved wasm export name: " + name)
        }
        $function := -1
        for i in 0:tp.fns.len {
            f := &tp.fns[i]
            if f.mod_id == "main" && f.name == name && f.recv < 0 && !f.is_inst {
                function = i
                <-
            }
        }
        if function < 0 { >> errors.new("wasm export not found in @main: " + name) }
        f := &tp.fns[function]
        if f.is_extern || f.is_template || f.variadic || f.may_throw || f.ret != 1 {
            >> errors.new("wasm export requires a non-throwing int-only function: " + name)
        }
        for ty in f.params {
            if ty != 1 { >> errors.new("wasm export requires int parameters: " + name) }
        }
        for prior in roots {
            if prior == function { >> errors.new("duplicate wasm export: " + name) }
        }
        roots.push(function)
    }
    << roots
}

struct BaseAddrParse {
    ok  bool
    val int
}

fn parse_base_addr_arg(s &string) BaseAddrParse {
    if s.len == 0 { << BaseAddrParse{ok: false, val: 0} }
    $start := 0
    $base := u64(10)
    if s.len > 2 && s[0] == 48 && (s[1] == 120 || s[1] == 88) {
        start = 2
        base = u64(16)
    }
    if start >= s.len { << BaseAddrParse{ok: false, val: 0} }
    $v := u64(0)
    max_u := u64(0) - u64(1)
    for idx in start:s.len {
        ch := s[idx]
        if ch == 95 { -> }
        $d := -1
        if ch >= 48 && ch <= 57 { d = ch - 48 }
        else if base == u64(16) && ch >= 97 && ch <= 102 { d = ch - 87 }
        else if base == u64(16) && ch >= 65 && ch <= 70 { d = ch - 55 }
        else { << BaseAddrParse{ok: false, val: 0} }
        du := u64(d)
        $limit := u64(0)
        if base == u64(16) {
            limit = (max_u - du) / u64(16)
        } else {
            limit = (max_u - du) / u64(10)
        }
        if v > limit { << BaseAddrParse{ok: false, val: 0} }
        v = v * base + du
    }
    << BaseAddrParse{ok: true, val: int(v)}
}

fn elf_syms_push_unique(sy $&obj.ElfSyms, name string, off int, is_weak bool) {
    if off < 0 || name.len == 0 { << }
    for i in 0:sy.names.len {
        if sy.names[i] == name { << }
    }
    sy.names.push(name)
    sy.offs.push(off)
    sy.weak.push(is_weak)
}

fn collect_elf_syms(mir_unit &mir.Mir, syms &mc.SymbolTable) obj.ElfSyms {
    $sy := obj.elf_syms_empty()
    for mfi in 0:mir_unit.fns.len {
        off := syms.lookup_offset(mir_unit.fns[mfi].label)
        elf_syms_push_unique($&sy, mir_unit.fns[mfi].label + "", off, mir_unit.fns[mfi].is_weak)
    }
    stub_names := ["__xu_start", "_start", "__xu_task_switch", "switch_context",
                   "irq_save", "irq_restore", "boot_magic", "boot_info_addr",
                   "in8", "out8", "in16", "out16", "in32", "out32",
                   "load_idt", "load_gdt", "load_tr", "read_cr0", "write_cr0",
                   "read_cr2", "read_cr3", "write_cr3", "read_cr4", "write_cr4",
                   "invlpg", "rdmsr", "wrmsr", "rdtsc", "swapgs",
                   "cpuid", "read_rflags", "syscall4",
                   "set_vbar", "set_trap_vector", "syscall_entry",
                   "atomic_load_u8", "atomic_store_u8", "atomic_xchg_u8", "atomic_cas_u8",
                   "atomic_load_u16", "atomic_store_u16", "atomic_xchg_u16", "atomic_cas_u16",
                   "atomic_load_u32", "atomic_store_u32", "atomic_xchg_u32", "atomic_cas_u32",
                   "atomic_fetch_add_u32", "atomic_fetch_sub_u32", "atomic_fetch_and_u32", "atomic_fetch_or_u32", "atomic_fetch_xor_u32",
                   "atomic_load_u64", "atomic_store_u64", "atomic_xchg_u64", "atomic_cas_u64",
                   "atomic_fetch_add_u64", "atomic_fetch_sub_u64", "atomic_fetch_and_u64", "atomic_fetch_or_u64", "atomic_fetch_xor_u64",
                   "atomic_load_relaxed_u32", "atomic_store_relaxed_u32", "atomic_load_relaxed_u64", "atomic_store_relaxed_u64",
                   "atomic_store_seqcst_u32", "atomic_store_seqcst_u64",
                   "fxsave", "fxrstor", "gs_read_u64", "gs_write_u64", "fs_read_u64", "fs_write_u64",
                   "read_rsp", "read_rbp", "stac", "clac",
                   "arm64_read_sctlr_el1", "arm64_write_sctlr_el1", "arm64_read_ttbr0_el1", "arm64_write_ttbr0_el1",
                   "arm64_read_ttbr1_el1", "arm64_write_ttbr1_el1", "arm64_read_tcr_el1", "arm64_write_tcr_el1",
                   "arm64_read_mair_el1", "arm64_write_mair_el1", "arm64_read_esr_el1", "arm64_read_far_el1",
                   "arm64_read_elr_el1", "arm64_write_elr_el1", "arm64_read_spsr_el1", "arm64_write_spsr_el1",
                   "arm64_read_tpidr_el1", "arm64_write_tpidr_el1", "arm64_read_mpidr_el1",
                   "arm64_tlbi_vmalle1", "arm64_tlbi_vae1", "arm64_isb", "arm64_dsb_sy",
                   "rv64_read_satp", "rv64_write_satp", "rv64_read_sstatus", "rv64_write_sstatus",
                   "rv64_read_sie", "rv64_write_sie", "rv64_read_sip", "rv64_write_sip",
                   "rv64_read_stvec", "rv64_write_stvec", "rv64_read_scause", "rv64_read_stval",
                   "rv64_read_sepc", "rv64_write_sepc", "rv64_read_sscratch", "rv64_write_sscratch",
                   "rv64_read_tp", "rv64_write_tp", "rv64_sfence_vma", "rv64_sfence_vma_addr"]
    for sni in 0:stub_names.len {
        off := syms.lookup_offset(stub_names[sni])
        elf_syms_push_unique($&sy, stub_names[sni] + "", off, false)
    }
    << sy
}

fn bss_align_up(off int, al int) int {
    if al <= 1 { << off }
    rem := off & (al - 1)
    if rem == 0 { << off }
    << off + (al - rem)
}

fn collect_elf_data(tp &types.TypedProgram) obj.ElfDataLayout {
    $ed := obj.elf_data_layout_empty()
    $sec_names := []string{}
    for gi in 0:tp.globals.len {
        if !tp.globals[gi].is_bss { -> }
        $sn := tp.globals[gi].section + ""
        if sn.len == 0 {
            if !tp.globals[gi].has_init { sn = ".bss" }
            else if tp.globals[gi].is_mut { sn = ".data" }
            else { sn = ".rodata" }
        }
        $found := false
        for si in 0:sec_names.len {
            if sec_names[si] == sn {
                found = true
                <-
            }
        }
        if !found { sec_names.push(sn) }
    }
    for si in 0:sec_names.len {
        sn := sec_names[si] + ""
        is_nobits := sn == ".bss" || str_starts_with(&sn, ".bss.")
        $writable := is_nobits
        $cur := 0
        $max_al := 1
        $sbytes := []int{}
        $srelocs := []obj.ElfDataReloc{}
        for gi in 0:tp.globals.len {
            if !tp.globals[gi].is_bss { -> }
            $gsn := tp.globals[gi].section + ""
            if gsn.len == 0 {
                if !tp.globals[gi].has_init { gsn = ".bss" }
                else if tp.globals[gi].is_mut { gsn = ".data" }
                else { gsn = ".rodata" }
            }
            if gsn != sn { -> }
            if tp.globals[gi].is_mut { writable = true }
            $sz := tp.size_of(tp.globals[gi].ty)
            if sz <= 0 { sz = 1 }
            $al := tp.align_of(tp.globals[gi].ty)
            if al < 1 { al = 1 }
            if tp.globals[gi].align > al { al = tp.globals[gi].align }
            off := bss_align_up(cur, al)
            if !is_nobits {
                while sbytes.len < off { sbytes.push(0) }
                if tp.globals[gi].init_bytes.len == sz {
                    for bi in 0:sz { sbytes.push(tp.globals[gi].init_bytes[bi]) }
                } else {
                    for bi in 0:sz { sbytes.push(0) }
                }
                for ri in 0:tp.globals[gi].relocs.len {
                    srelocs.push(obj.ElfDataReloc{
                        off: off + tp.globals[gi].relocs[ri].off,
                        sym: tp.globals[gi].relocs[ri].sym + "",
                        addend: tp.globals[gi].relocs[ri].addend
                    })
                }
            }
            ed.syms.push(obj.ElfDataSym{
                name: tp.globals[gi].sym + "",
                sec_idx: si,
                off: off,
                size: sz,
                is_weak: tp.globals[gi].is_weak
            })
            if al > max_al { max_al = al }
            cur = off + sz
        }
        ed.secs.push(obj.ElfDataSec{
            name: sn,
            is_nobits: is_nobits,
            writable: writable,
            max_align: max_al,
            total_size: cur,
            bytes: sbytes,
            relocs: srelocs
        })
    }
    << ed
}

fn build_program(files &[]string, files_count int, out_file string, target_code int, chip_id int, is_debug bool, no_opt bool, dwarf bool, is_verbose bool, temporary bool, emit_object bool, xacp_port int, phone_object bool, wasm_exports &[]string, pgo_arg string, flag_tensor_fusion bool, flag_tensor_fast_math bool, base_addr int, has_base_addr bool, no_sse bool, boot_stack_bytes int) int {
    tgt_os := target.target_os(target_code)
    tgt_arch := target.target_arch(target_code)
    if xacp_port >= 0 && tgt_os != target.OS_MACOS && tgt_os != target.OS_LINUX && tgt_os != target.OS_WINDOWS {
        eprintln("xu build: --xacp requires a native macOS, Linux, or Windows target")
        << 1
    }
    app_obj := (tgt_os == target.OS_MACOS || tgt_os == target.OS_LINUX || tgt_os == target.OS_WINDOWS) &&
        (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64)
    baremetal_obj := tgt_os == target.OS_NONE &&
        (tgt_arch == target.ARCH_X64 || tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_RISCV64)
    if emit_object && !app_obj && !baremetal_obj {
        eprintln("xu build: --emit-obj supports arm64/x64 desktop targets and x64/arm64/riscv64 freestanding targets")
        << 1
    }
    if emit_object && dwarf && !baremetal_obj {
        eprintln("xu build: DWARF is only available with --emit-obj on freestanding targets")
        << 1
    }
    $link_object := emit_object && app_obj
    link_phone := emit_object && (phone_object || os.getenv("XU_PHONE_PACK") == "1")
    if link_phone && (tgt_arch != target.ARCH_ARM64 || (tgt_os != target.OS_MACOS && tgt_os != target.OS_LINUX) || xacp_port >= 0) { eprintln("Phone objects require an arm64 Darwin/Linux ABI without XACP")
        << 1 }
    link_ui := emit_object && (os.getenv("XU_UI_PACK") == "1" || link_phone)
    tgt_spec := target.target_new_with_chip(tgt_os, tgt_arch, chip_id)

    $actual_out := out_file
    if !emit_object && tgt_os == target.OS_WINDOWS {
        if str_ends_with(&actual_out, ".xin") {
            actual_out = actual_out[0:actual_out.len - 4] + ".exe"
        } else if !str_ends_with(&actual_out, ".exe") {
            actual_out = actual_out + ".exe"
        }
    }

    tm := mir.TargetModel{
        ptr_size: tgt_spec.pointer_size,
        has_cond_select: tgt_spec.features.has_cond_select,
        has_fast_mul: tgt_spec.features.has_fast_mul,
        has_fused_madd: tgt_spec.features.has_fused_alu,
        unroll_factor: tgt_spec.features.unroll_factor,
        vector_bits: tgt_spec.features.vector_bits,
        has_crypto_aes: tgt_spec.features.has_crypto_aes,
        has_crypto_sha2: tgt_spec.features.has_crypto_sha2,
        has_crc32: tgt_spec.features.has_crc32,
        has_lse: tgt_spec.features.has_lse,
        has_bmi2: tgt_spec.features.has_bmi2,
        has_dsp: tgt_spec.features.has_dsp
    }

    $passes := PassConfig{
        const_fold: true,
        regalloc: true,
        dce: true,
        chip_features: true,
        chip_fusion: true,
        licm: true,
        inlining: true,
        sroa: true,
        cfg: true,
        cse: true,
        is_debug: false,
        print_passes: false
    }
    if is_debug || no_opt {
        passes.const_fold = false
        passes.licm = false
        passes.inlining = false
        passes.sroa = false
        passes.cfg = false
        passes.cse = false
        passes.chip_fusion = false
        passes.is_debug = is_debug
    }
    if is_verbose {
        passes.print_passes = true
        $feat_desc := ""
        if tgt_spec.features.has_crypto_aes { feat_desc = feat_desc + "+aes" }
        if tgt_spec.features.has_crypto_sha2 { feat_desc = feat_desc + "+sha2" }
        if tgt_spec.features.has_crypto_sm4 { feat_desc = feat_desc + "+sm4" }
        if tgt_spec.features.has_crc32 { feat_desc = feat_desc + "+crc32" }
        if tgt_spec.features.has_lse { feat_desc = feat_desc + "+lse" }
        if tgt_spec.features.has_bmi2 { feat_desc = feat_desc + "+bmi2" }
        if tgt_spec.features.has_dsp { feat_desc = feat_desc + "+dsp" }
        if feat_desc.len > 0 {
            println("info: target=" + target.target_name(target_code) + " chip=" + target.chip_name(tgt_spec.chip) + " features=[" + feat_desc + "]")
        } else {
            println("info: target=" + target.target_name(target_code) + " chip=" + target.chip_name(tgt_spec.chip))
        }
    }

    $cb := mc.code_buffer_new()
    $syms := mc.symbol_table_new()
    $relocs := []mc.Reloc{}

    $p := parser.new_parser([]ast.Token{})
    $native := native_unit()
    load_unit(files, files_count, target_code, true, xacp_port, $&p, $&native) >>> (err) {
        eprintln("xu build: " + err.msg())
        << 1
    }
    if native.labels.len > 0 {
        if emit_object && !link_phone {
            eprintln("xu build: --emit-obj is unavailable with native imports; build the executable directly")
            << 1
        }
        link_object = true
    }

    if p.decls.len == 0 {
        println("error: no declarations parsed")
        << 1
    }

    $tgt_ok := (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64) && (tgt_os == target.OS_MACOS || tgt_os == target.OS_LINUX)
    if tgt_os == target.OS_WINDOWS && (tgt_arch == target.ARCH_X64 || tgt_arch == target.ARCH_ARM64) {
        tgt_ok = true
    }
    if tgt_arch == target.ARCH_WASM && tgt_os == target.OS_WASI {
        tgt_ok = true
    }
    if (tgt_arch == target.ARCH_RISCV64 || tgt_arch == target.ARCH_LOONG64) && tgt_os == target.OS_LINUX {
        tgt_ok = true
    }
    if tgt_os == target.OS_NONE {
        tgt_ok = true
    }
    if tgt_os == target.OS_UEFI && (tgt_arch == target.ARCH_X64 || tgt_arch == target.ARCH_ARM64) {
        tgt_ok = true
    }
    if !tgt_ok {
        eprintln("error: the typed backend currently targets arm64 and x64 macOS/Linux/Windows, riscv64/loong64 Linux, wasm32-wasi and riscv32/thumb/xtensa bare metal only")
        << 1
    }

    $chk := checker.Checker{}
    $tp := types.typed_program_new()
    checker.check_typed_native(&p, target_code, 0, &native.labels, $&chk, $&tp)
    wasm_roots := resolve_wasm_exports(&tp, wasm_exports) >>> (err) {
        eprintln("xu build: " + err.msg())
        << 1
    }

    // -g describes locals by frame offset, so it keeps them in memory.
    use_ra := !is_debug && !no_opt && !dwarf && os.getenv("XU_NO_RA") != "1"
    task_poll := !link_object && !is_debug && !no_opt && !dwarf &&
                 (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64) &&
                 (tgt_os == target.OS_MACOS || tgt_os == target.OS_LINUX || tgt_os == target.OS_WINDOWS) &&
                 os.getenv("XU_TASK_POLL") == "1"
    $mir_unit := mir.Mir{fns: []mir.MFn{}, ffi_thunks: []string{}, ffi_adapters: []string{}}
    optimize_cpu := use_ra && (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64)
    affine_tile := optimize_cpu && os.getenv("XU_AFFINE_TILE") == "1"
    tensor_fusion := optimize_cpu && (flag_tensor_fusion || flag_tensor_fast_math || os.getenv("XU_TENSOR_FUSION") == "1")
    tensor_fast_math := tensor_fusion && (flag_tensor_fast_math || os.getenv("XU_TENSOR_FAST_MATH") == "1")
    lower_errors := mir.lower_typed(&p, $&tp, tgt_os, tgt_arch, os.getenv("XU_LOWER_ALL") == "1", is_debug, task_poll, affine_tile, tensor_fusion, tensor_fast_math, &wasm_roots, $&mir_unit)
    if lower_errors > 0 {
        println("error: " + str(lower_errors) + " construct(s) cannot be lowered yet")
        <<< 1
    }

    $has_main := false
    for mi in 0:mir_unit.fns.len {
        if mir_unit.fns[mi].label == "_xu_main" {
            has_main = true
        }
    }
    if !has_main {
        println("error: no main function")
        << 1
    }

    // line_rows: (code offset, line) pairs in emission order.
    // fn_rows holds the starting index for each emitted function.
    $line_rows := []int{}
    $fn_rows := []int{}
    $native_entries := []bool{}
    $inl_skip_entries := []bool{}
    for fi in 0:mir_unit.fns.len {
        label := &mir_unit.fns[fi].label
        is_nat := !dwarf && (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64) &&
                  (codegen.aes_hw_entry(label) || codegen.hex_hw_entry(label) ||
                   (tgt_arch == target.ARCH_ARM64 && codegen.sha256_hw_entry(label)))
        native_entries.push(is_nat)
        inl_skip_entries.push(is_nat || (!dwarf && (tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64) &&
                                         codegen.bits_hw_entry(label, tgt_arch == target.ARCH_ARM64)))
    }
    if tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64 {
        mir.lower_target_sqrt($&mir_unit)
    }
    $pgo_file := pgo_arg + ""
    if pgo_file.len == 0 {
        pgo_file = os.getenv("XU_PGO_FILE")
    }
    $pgo_keys := []string{}
    $pgo_counts := [][]int{}
    if pgo_file.len > 0 {
        pgo_counts = load_pgo_counts(pgo_file + "", &mir_unit, $&pgo_keys) >>> (err) {
            eprintln("xu build: PGO profile " + pgo_file + ": " + err.msg())
            << 1
        }
    }
    emit_pgo_map := os.getenv("XU_PGO_MAP") == "1"
    if emit_pgo_map && (!use_ra || link_object || temporary || tgt_os != target.OS_LINUX || tgt_arch != target.ARCH_X64) {
        eprintln("xu build: XU_PGO_MAP requires an optimized linux-x64 executable build")
        << 1
    }
    $map_keys := []string{}
    if use_ra {
        // Every pass added after 0.12.3 runs only for arm64 / x64, the
        // backends it was written and tested for; the other backends see
        // the MIR they always did: leaf inlining, scalar cleanup (with tail
        // recursion elimination), two rounds of typed inlining with cleanup
        // after each, then the loop passes. XU_NO_TAIL=1 / XU_NO_INLINE=1 /
        // XU_NO_LOCALS=1 switch a stage off to locate a miscompile;
        // XU_INLINE_LOOPS=1 also inlines calls inside loops. XU_NO_SROA=1
        // skips scalar replacement of local aggregates, XU_NO_DIVC=1
        // division by constants (BIN_MULH exists only in these backends),
        // XU_NO_IFCONV=1 if-conversion (likewise for MI_SELECT).
        opt64 := tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_X64
        do_tail := opt64 && os.getenv("XU_NO_TAIL") != "1"
        do_inline := opt64 && os.getenv("XU_NO_INLINE") != "1"
        do_locals := os.getenv("XU_NO_LOCALS") != "1"
        do_gvn := opt64 && os.getenv("XU_NO_GVN") != "1"
        do_sroa := opt64 && os.getenv("XU_NO_SROA") != "1"
        do_divc := opt64 && os.getenv("XU_NO_DIVC") != "1"
        do_rotr := opt64 && os.getenv("XU_NO_ROTR") != "1"
        do_licm := opt64 && os.getenv("XU_NO_LICM") != "1"
        do_lut := opt64 && os.getenv("XU_NO_LUT") != "1"
        do_carry := opt64 && os.getenv("XU_NO_CARRY") != "1"
        do_ifconv := opt64 && os.getenv("XU_NO_IFCONV") != "1"
        inline_loops := os.getenv("XU_INLINE_LOOPS") == "1"
        $fold_w := mir.fold_work_new()
        $gvn_w := mir.gvn_work_new()
        $ifc_w := mir.ifc_work_new()
        if do_gvn {
            mir.gvn_summarize_call_effects($&gvn_w, &mir_unit, &inl_skip_entries)
        }
        mir.opt_inline($&mir_unit, &inl_skip_entries)
        for fi in 0:mir_unit.fns.len {
            if opt64 {
                if do_rotr && mir.opt_rotr($&mir_unit.fns[fi]) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
                opt_scalar($&mir_unit.fns[fi], $&fold_w, $&gvn_w, do_tail, do_locals, do_gvn, false)
            } else {
                mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
            }
        }
        if do_lut {
            for fi in 0:mir_unit.fns.len {
                if mir.opt_switch_lut_with($&mir_unit.fns[fi], $&ifc_w) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
            }
        }
        if do_inline {
            $inl_changed := []int{}
            $did_inline := false
            for _ in 0:4 {
                if mir.opt_inline_typed($&mir_unit, &inl_skip_entries, $&inl_changed, inline_loops) == 0 {
                    <-
                }
                did_inline = true
                for fi in 0:mir_unit.fns.len {
                    if inl_changed[fi] == 2 {
                        if do_rotr && mir.opt_rotr($&mir_unit.fns[fi]) {
                            mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        }
                        opt_scalar($&mir_unit.fns[fi], $&fold_w, $&gvn_w, do_tail, do_locals, do_gvn, true)
                    } else if inl_changed[fi] == 1 {
                        if do_rotr { mir.opt_rotr($&mir_unit.fns[fi]) }
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                            mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        }
                    }
                }
            }
            if do_gvn && did_inline {
                mir.gvn_summarize_call_effects($&gvn_w, &mir_unit, &inl_skip_entries)
            }
        }
        $any_devirt := false
        for fi in 0:mir_unit.fns.len {
            if mir.opt_periodic($&mir_unit.fns[fi]) {
                mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
            }
            if mir.opt_bce_with_calls($&mir_unit.fns[fi], opt64, &gvn_w) {
                mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
            }
            if do_sroa {
                ind_before := count_call_ind(&mir_unit.fns[fi])
                $sroa_changed := mir.opt_sroa($&mir_unit.fns[fi])
                if mir.opt_addr($&mir_unit.fns[fi]) || sroa_changed {
                    if do_locals {
                        mir.opt_locals($&mir_unit.fns[fi])
                    }
                    if do_gvn {
                        mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w)
                    }
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                    if do_inline && ind_before > 0 && count_call_ind(&mir_unit.fns[fi]) < ind_before {
                        any_devirt = true
                    }
                }
            }
            if opt64 && mir.opt_chan_elide($&mir_unit.fns[fi]) {
                mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
            }
            // Usually finds nothing after opt_tail; kept for XU_NO_TAIL=1.
            if opt64 && mir.opt_tre($&mir_unit.fns[fi]) {
                mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
            }
            if do_rotr && mir.opt_rotr($&mir_unit.fns[fi]) {
                mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
            }
        }
        if do_sroa {
            drop_changed := mir.opt_fnval_zero_env_drops($&mir_unit)
            for fi in 0:mir_unit.fns.len {
                if drop_changed[fi] {
                    ind_before := count_call_ind(&mir_unit.fns[fi])
                    mir.opt_addr($&mir_unit.fns[fi])
                    if do_locals {
                        mir.opt_locals($&mir_unit.fns[fi])
                    }
                    if do_gvn {
                        mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w)
                    }
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                    if do_inline && ind_before > 0 && count_call_ind(&mir_unit.fns[fi]) < ind_before {
                        any_devirt = true
                    }
                }
            }
        }
        if any_devirt {
            $inl_post := []int{}
            if mir.opt_inline_typed($&mir_unit, &inl_skip_entries, $&inl_post, true) > 0 {
                for fi in 0:mir_unit.fns.len {
                    if inl_post[fi] == 2 {
                        opt_scalar($&mir_unit.fns[fi], $&fold_w, $&gvn_w, do_tail, do_locals, do_gvn, true)
                    } else if inl_post[fi] == 1 {
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                            mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        }
                    }
                }
            }
        }
        divc_changed := mir.opt_divc_unit($&mir_unit, do_divc, tgt_arch == target.ARCH_X64)
        for fi in 0:mir_unit.fns.len {
            if divc_changed[fi] {
                mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
            }
        }
        if opt64 && os.getenv("XU_NO_PUSH_COALESCE") != "1" {
            for fi in 0:mir_unit.fns.len {
                if mir.opt_push_coalesce($&mir_unit.fns[fi]) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
            }
        }
        $licm_w := mir.licm_work_new()
        if do_lut {
            for fi in 0:mir_unit.fns.len {
                if mir.opt_switch_lut_with($&mir_unit.fns[fi], $&ifc_w) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
            }
        }
        if do_licm || do_carry {
            if do_licm {
                for fi in 0:mir_unit.fns.len {
                    if mir.opt_licm_typed_with_calls($&mir_unit.fns[fi], $&licm_w, &gvn_w) {
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                            mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        }
                    }
                }
                for fi in 0:mir_unit.fns.len {
                    if mir.opt_loop_promote_with_arch($&mir_unit.fns[fi], $&licm_w, tgt_arch == target.ARCH_ARM64) {
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                            mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        }
                    }
                }
            }
            if do_carry {
                for fi in 0:mir_unit.fns.len {
                    if mir.opt_loop_carry_with($&mir_unit.fns[fi], $&licm_w) {
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                    }
                }
            }
        }
        if opt64 && os.getenv("XU_NO_JT") != "1" {
            for fi in 0:mir_unit.fns.len {
                if mir.opt_jump_thread($&mir_unit.fns[fi]) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
            }
        }
        // If-conversion last, after opt_bce (which must still see the
        // original loop shapes). Multi-round: block merging after an earlier
        // round exposes the enclosing diamond of a nested if.
        if do_ifconv {
            for fi in 0:mir_unit.fns.len {
                $ifc_changed := false
                for _ in 0:12 {
                    if mir.opt_ifconv_with($&mir_unit.fns[fi], $&ifc_w) == 0 {
                        <-
                    }
                    ifc_changed = true
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
                if ifc_changed {
                    if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                    }
                    if do_licm && mir.opt_licm_typed_with_calls($&mir_unit.fns[fi], $&licm_w, &gvn_w) {
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                            mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                        }
                    }
                }
            }
        }
        dump_cfg := os.getenv("XU_DUMP_PGO_CFG")
        for fi in 0:mir_unit.fns.len {
            if opt64 {
                if os.getenv("XU_NO_PTR_SR") != "1" && mir.opt_ptr_sr($&mir_unit.fns[fi]) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
                if os.getenv("XU_NO_UNROLL") != "1" && mir.opt_unroll($&mir_unit.fns[fi]) {
                    if do_locals {
                        mir.opt_locals($&mir_unit.fns[fi])
                    }
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                    if do_gvn && mir.opt_gvn_with($&mir_unit.fns[fi], $&gvn_w) {
                        mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                    }
                    mir.simplify_cfg($&mir_unit.fns[fi])
                }
                if use_ra && tgt_arch == target.ARCH_ARM64 {
                    mir.opt_fold_ptr_offs($&mir_unit.fns[fi], 32768, true)
                } else if use_ra && tgt_arch == target.ARCH_X64 {
                    mir.opt_fold_ptr_offs($&mir_unit.fns[fi], 2147483647, false)
                }
                if do_carry && mir.opt_loop_carry_with($&mir_unit.fns[fi], $&licm_w) {
                    mir.opt_fold_with($&mir_unit.fns[fi], $&fold_w)
                }
            }
            if do_licm {
                mir.opt_hoist_loop_consts($&mir_unit.fns[fi], tgt_arch == target.ARCH_ARM64)
            }
            mir.simplify_cfg($&mir_unit.fns[fi])
            if use_ra && tgt_arch == target.ARCH_ARM64 {
                mir.opt_sink_mul_add($&mir_unit.fns[fi])
            }
            if use_ra && opt64 && !no_sse && tgt_os != target.OS_NONE && tgt_os != target.OS_UEFI && os.getenv("XU_NO_SLP") != "1" {
                mir.opt_slp($&mir_unit.fns[fi])
            }
            if emit_pgo_map {
                map_keys.push(mir.pgo_cfg_key(&mir_unit.fns[fi]))
                $ordinal := 0
                for bi in 0:mir_unit.fns[fi].blocks.len {
                    if mir_unit.fns[fi].blocks[bi].tkind == mir.TKIND_BRANCH {
                        mir_unit.fns[fi].blocks[bi].pgo_ordinal = ordinal
                        ordinal += 1
                    }
                }
            }
            show_cfg := dump_cfg.len > 0 && (dump_cfg == "*" || dump_cfg == mir_unit.fns[fi].label)
            if show_cfg || (pgo_keys.len > 0 && pgo_keys[fi].len > 0) {
                key := mir.pgo_cfg_key(&mir_unit.fns[fi])
                if show_cfg { println("fn " + mir_unit.fns[fi].label + " " + key) }
                if pgo_keys.len > 0 && pgo_keys[fi].len > 0 {
                    if pgo_keys[fi] == key && mir.layout_edge_profile($&mir_unit.fns[fi], &pgo_counts[fi]) { -> }
                    eprintln("xu build: ignoring mismatched edge profile for " + mir_unit.fns[fi].label)
                    pgo_counts[fi] = []int{}
                }
            }
            if pgo_counts.len > 0 && pgo_counts[fi].len > 0 {
                mir.reorder_blocks_out_of_line($&mir_unit.fns[fi], &pgo_counts[fi])
            } else {
                empty := []int{}
                mir.reorder_blocks_out_of_line($&mir_unit.fns[fi], &empty)
            }
        }
    }
    // XU_DUMP_MIR=<label substring> prints the final MIR of matching functions.
    dump_mir := os.getenv("XU_DUMP_MIR")
    if dump_mir.len > 0 {
        for fi in 0:mir_unit.fns.len {
            if dump_mir == "*" || str_contains(&mir_unit.fns[fi].label, dump_mir) {
                mir.mir_dump(&mir_unit.fns[fi])
            }
        }
    }
    $uses_ffi := mir_unit.ffi_thunks.len > 0
    $uses_tensor_stubs := false
    for mfi in 0:mir_unit.fns.len {
        lbl := &mir_unit.fns[mfi].label
        if *lbl == "_xu_runtime_core_ffi_sym" || *lbl == "_xu_runtime_core_ffi_closure_alloc" { uses_ffi = true }
        mf := &mir_unit.fns[mfi]
        for mii in 0:mf.instrs.len {
            if mf.instrs[mii].kind == mir.MI_CALL && str_starts_with(&mf.instrs[mii].sval, "__xu_tensor_") {
                uses_tensor_stubs = true
            }
        }
    }
    if tgt_arch == target.ARCH_WASM {
        if codegen.emit_wasm_module(&mir_unit, $&cb, "_xu_main", wasm_exports) > 0 {
            <<< 1
        }
        os.write(~actual_out, cb.to_string()) >>> (err) {
            println("error: cannot write module to " + actual_out)
            <<< 1
        }
        println("Build complete: " + actual_out)
        <<< 0
    }
    $emit_order := []int{}
    if pgo_counts.len > 0 {
        $cold_fns := []int{}
        for fi in 0:mir_unit.fns.len {
            if (pgo_keys[fi].len == 0 || use_ra) && pgo_has_samples(&pgo_counts[fi]) {
                emit_order.push(fi)
            } else {
                cold_fns.push(fi)
            }
        }
        for ci in 0:cold_fns.len {
            emit_order.push(cold_fns[ci])
        }
    } else {
        for fi in 0:mir_unit.fns.len {
            emit_order.push(fi)
        }
    }
    $none_base := 0x40080000
    if tgt_arch == target.ARCH_X64 {
        none_base = obj.elf_image_vaddr()
    } else if tgt_arch == target.ARCH_RISCV64 {
        none_base = 0x80000000
    }
    if has_base_addr {
        none_base = base_addr
    }
    stubs_emit_obj := link_object || (baremetal_obj && emit_object)
    collect_win_unwind := tgt_os == target.OS_WINDOWS && !link_object
    $win_unwinds := []codegen.WinUnwindEntry{}

    if no_sse && (tgt_arch == target.ARCH_X64 || tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_RISCV64) {
        for mfi in 0:mir_unit.fns.len {
            mf := &mir_unit.fns[mfi]
            for bi in 0:mf.blocks.len {
                $ii := mf.blocks[bi].head
                while ii >= 0 {
                    ins := &mf.instrs[ii]
                    k := ins.kind
                    $bad := false
                    if k == mir.MI_BIN && ins.b >= mir.BIN_FADD && ins.b <= mir.BIN_FGE {
                        bad = true
                    } else if k == mir.MI_UN && (ins.b == mir.UN_I2F || ins.b == mir.UN_F2I || ins.b == mir.UN_FSQRT || ins.b == mir.UN_F32_LOAD || ins.b == mir.UN_F32_STORE) {
                        bad = true
                    } else if k == mir.MI_VLOAD128 || k == mir.MI_VSTORE128 || k == mir.MI_VBIN128 || k == mir.MI_VPACK128 || k == mir.MI_VEXTRACT {
                        bad = true
                    }
                    if bad {
                        eprintln("xu build: --no-sse/--no-fp forbids floating-point or SIMD operations in '" + mf.name + "'")
                        << 1
                    }
                    ii = ins.next
                }
            }
        }
    }

    if tgt_arch == target.ARCH_X64 || tgt_arch == target.ARCH_ARM64 || tgt_arch == target.ARCH_RISCV64 {
        for mfi in 0:mir_unit.fns.len {
            mf := &mir_unit.fns[mfi]
            for bi in 0:mf.blocks.len {
                $ii := mf.blocks[bi].head
                while ii >= 0 {
                    ins := &mf.instrs[ii]
                    if mf.is_interrupt {
                        k := ins.kind
                        $fp_bad := false
                        if k == mir.MI_BIN && ins.b >= mir.BIN_FADD && ins.b <= mir.BIN_FGE {
                            fp_bad = true
                        } else if k == mir.MI_UN && (ins.b == mir.UN_I2F || ins.b == mir.UN_F2I || ins.b == mir.UN_FSQRT || ins.b == mir.UN_F32_LOAD || ins.b == mir.UN_F32_STORE) {
                            fp_bad = true
                        } else if k == mir.MI_VLOAD128 || k == mir.MI_VSTORE128 || k == mir.MI_VBIN128 || k == mir.MI_VPACK128 || k == mir.MI_VEXTRACT {
                            fp_bad = true
                        }
                        if fp_bad {
                            eprintln("xu build: @interrupt handler '" + mf.name + "' cannot use floating-point or SIMD operations")
                            << 1
                        }
                    }
                    if ins.kind == mir.MI_ASM {
                        $asm_src := ins.sval + ""
                        if asm_src.len >= 5 && asm_src[0] == 64 && asm_src[1] == 111 && asm_src[2] == 112 && asm_src[3] == 115 && asm_src[4] == 58 {
                            $bar := -1
                            for si in 5:asm_src.len {
                                if asm_src[si] == 124 {
                                    bar = si
                                    <-
                                }
                            }
                            if bar >= 0 {
                                asm_src = asm_src[bar + 1:asm_src.len]
                            }
                        }
                        $bad_asm := ""
                        if tgt_arch == target.ARCH_X64 {
                            bad_asm = codegen.x64_validate_asm(asm_src)
                        } else if tgt_arch == target.ARCH_ARM64 {
                            bad_asm = codegen.arm64_validate_asm(asm_src)
                        } else if tgt_arch == target.ARCH_RISCV64 {
                            bad_asm = codegen.rv64_validate_asm(asm_src)
                        }
                        if bad_asm.len > 0 {
                            eprintln("xu build: unsupported inline asm instruction '" + bad_asm + "' in '" + mf.name + "'")
                            << 1
                        }
                    }
                    ii = ins.next
                }
            }
        }
    }

    if tgt_arch == target.ARCH_X64 {
        if tgt_os == target.OS_NONE && !emit_object {
            // Multiboot entry, GDT, boot page tables and boot stack come
            // first so the header lands in the first 8 KiB of the file.
            codegen.emit_x64_none_boot($&cb, $&syms, $&relocs, none_base, none_base + obj.elf_code_offset(), boot_stack_bytes)
        }
        for idx in 0:emit_order.len {
            opt_i := emit_order[idx]
            fn_rows.push(line_rows.len)
            if native_entries[opt_i] && codegen.aes_hw_entry(&mir_unit.fns[opt_i].label) {
                codegen.emit_x64_aes($&cb, $&syms, $&relocs, &mir_unit.fns[opt_i].label)
            } else if native_entries[opt_i] {
                codegen.emit_x64_hex($&cb, $&syms, $&relocs, &mir_unit.fns[opt_i].label)
            } else {
                codegen.isel_fn_x64_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows, use_ra, emit_pgo_map, no_sse, $&win_unwinds, collect_win_unwind)
            }
        }
        codegen.emit_x64_runtime_stubs($&cb, $&syms, $&relocs, tgt_os, "_xu_main", link_ui, stubs_emit_obj, uses_ffi, no_sse, $&win_unwinds, collect_win_unwind)
        if link_object {
            if tgt_os == target.OS_WINDOWS {
                codegen.emit_windows_x64_entry($&cb, $&syms, $&relocs)
            } else if tgt_os == target.OS_MACOS {
                codegen.emit_macos_x64_entry($&cb, $&syms, $&relocs)
            }
        }
        if use_ra && !no_sse {
            codegen.emit_x64_vec_stubs($&cb, $&syms)
        }
        if uses_tensor_stubs {
            codegen.emit_x64_tensor_stubs($&cb, $&syms)
        }
        codegen.emit_x64_atomic_stubs($&cb, $&syms)
        if tgt_os == target.OS_WINDOWS {
            codegen.emit_x64_win_ffi_thunks($&cb, $&syms, $&relocs, &mir_unit.ffi_thunks, &mir_unit.ffi_adapters, link_object, uses_ffi, $&win_unwinds, collect_win_unwind)
        } else {
            codegen.emit_x64_ffi_thunks($&cb, $&syms, $&relocs, &mir_unit.ffi_thunks, &mir_unit.ffi_adapters, link_object, uses_ffi)
        }
        if tgt_os != target.OS_MACOS && tgt_os != target.OS_LINUX && tgt_os != target.OS_WINDOWS && tgt_os != target.OS_UEFI && !link_object {
            codegen.emit_x64_ffi_slots($&cb, $&syms)
        }
    } else if tgt_arch == target.ARCH_RISCV64 {
        if tgt_os == target.OS_NONE && !emit_object {
            codegen.emit_rv64_none_boot($&cb, $&relocs)
        }
        for idx in 0:emit_order.len {
            opt_i := emit_order[idx]
            fn_rows.push(line_rows.len)
            codegen.isel_fn_rv64_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows)
        }
        codegen.emit_rv64_runtime_stubs_os($&cb, $&syms, $&relocs, tgt_os, "_xu_main", stubs_emit_obj, no_sse, boot_stack_bytes, uses_ffi)
        codegen.emit_rv64_ffi_thunks($&cb, $&syms, $&relocs, &mir_unit.ffi_thunks, &mir_unit.ffi_adapters, uses_ffi)
        if tgt_os != target.OS_LINUX && !link_object {
            codegen.emit_rv64_ffi_slots($&cb, $&syms)
        }
    } else if tgt_arch == target.ARCH_LOONG64 {
        for idx in 0:emit_order.len {
            opt_i := emit_order[idx]
            fn_rows.push(line_rows.len)
            codegen.isel_fn_la64_base(&mir_unit.fns[opt_i], $&cb, $&syms, $&relocs, $&line_rows)
