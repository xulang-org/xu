                           "__xu_tensor_rope_f32",
                           "__xu_tensor_gemv4_q4_0_p4_q8_0_f32", "__xu_tensor_gemv4_q4_0_p4_q8_0_fast_f32",
                           "__xu_tensor_gemv4_q8_0_p4_q8_0_f32", "__xu_tensor_gemv4_q8_0_p4_q8_0_fast_f32",
                           "__xu_tensor_gemm4x8_q4_0_p4_q8_0_f32", "__xu_tensor_gemm4x8_q4_0_p4_q8_0_fast_f32",
                           "__xu_tensor_gemv4_q4_0_p4_f16_q8_0_f32", "__xu_tensor_gemv4_q4_0_p4_f16_q8_0_fast_f32",
                           "__xu_tensor_gemv4_q8_0_p4_f16_q8_0_f32", "__xu_tensor_gemv4_q8_0_p4_f16_q8_0_fast_f32",
                           "__xu_tensor_gemm4x8_q4_0_p4_f16_q8_0_f32", "__xu_tensor_gemm4x8_q4_0_p4_f16_q8_0_fast_f32",
                           "__xu_tensor_gemv4_q4_0_p4k4_f16_q8_0_f32", "__xu_tensor_gemv4_q4_0_p4k4_f16_q8_0_fast_f32",
                           "__xu_tensor_gemv4_q4_0_p4k4_signed_f16_q8_0_f32", "__xu_tensor_gemv4_q4_0_p4k4_signed_f16_q8_0_fast_f32",
                           "__xu_tensor_gemv4_q8_0_p4k4_f16_q8_0_f32", "__xu_tensor_gemv4_q8_0_p4k4_f16_q8_0_fast_f32",
                           "__xu_tensor_gemm4x8_q4_0_p4k4_f16_q8_0_f32", "__xu_tensor_gemm4x8_q4_0_p4k4_f16_q8_0_fast_f32",
                           "__xu_tensor_gemm4x8_q4_0_p4k4_signed_f16_q8_0_f32", "__xu_tensor_gemm4x8_q4_0_p4k4_signed_f16_q8_0_fast_f32",
                           "__xu_tensor_gemm4x8_q8_0_p4k4_f16_q8_0_f32", "__xu_tensor_gemm4x8_q8_0_p4k4_f16_q8_0_fast_f32",
                           "__xu_tensor_pack_q4_0_p4k4", "__xu_tensor_pack_q4_0_p4k4_signed", "__xu_tensor_pack_q8_0_p4k4",
                           "__xu_tensor_dot_q4_k_q8_k_f32", "__xu_tensor_dot_q5_k_q8_k_f32", "__xu_tensor_dot_q6_k_q8_k_f32",
                           "__xu_tensor_attn_scores_paged_f32", "__xu_tensor_attn_scores_paged_fast_f32",
                           "__xu_tensor_softmax_scaled_f32", "__xu_tensor_softmax_scaled_fast_f32",
                           "__xu_tensor_attn_vsum_paged_f32", "__xu_tensor_attn_vsum_paged_fast_f32",
                           "__xu_atomic_load_i64", "__xu_atomic_store_i64",
                           "__xu_atomic_add_i64", "__xu_atomic_cas_i64"]
            for sni in 0:stub_names.len {
                off := syms.lookup_offset(stub_names[sni])
                if off >= 0 {
                    msyms.names.push(stub_names[sni] + "")
                    msyms.offs.push(off)
                }
            }
        }
        bin_buf = obj.macho_write_executable_debug(&cb.bytes, macho_cpu, entry_off, &msyms, &dbg)
    } else {
        // Freestanding / None / WASM / Embedded (ESP32, RISC-V 32, Thumb)
        if tgt_arch == target.ARCH_WASM {
            bin_buf = obj.wasm_write_module(&cb.bytes, entry_off)
        } else if tgt_arch == target.ARCH_XTENSA {
            // ESP32: vectors and code in IRAM from 0x40070000
            bin_buf = obj.elf32_write_executable(&cb.bytes, obj.ELF_MACHINE_XTENSA, entry_off, codegen.XT_CODE_BASE, obj.EF_XTENSA)
        } else if tgt_arch == target.ARCH_RISCV32 {
            bin_buf = obj.elf32_write_riscv32_executable(&cb.bytes, entry_off)
        } else if tgt_arch == target.ARCH_THUMB {
            // MPS2 AN386: the image (vector table first) runs from address 0
            bin_buf = obj.elf32_write_executable(&cb.bytes, obj.ELF_MACHINE_ARM32, entry_off, 0, obj.EF_ARM_EABI_VER5)
        } else {
            esyms := collect_elf_syms(&mir_unit, &syms)
            if tgt_arch == target.ARCH_X64 {
                bin_buf = obj.elf_write_executable_full(&cb.bytes, obj.ELF_EM_X86_64, entry_off, none_base, obj.elf_code_offset(), true, &esyms, &dbg)
            } else if tgt_arch == target.ARCH_RISCV64 {
                bin_buf = obj.elf_write_executable_full(&cb.bytes, obj.ELF_EM_RISCV, entry_off, none_base, 4096, false, &esyms, &dbg)
            } else {
                bin_buf = obj.elf_write_executable_full(&cb.bytes, obj.ELF_EM_AARCH64, entry_off, none_base, obj.elf_code_offset(), true, &esyms, &dbg)
            }
        }
    }

    raw_str := bin_buf.to_string()

    if emit_pgo_map {
        write_pgo_map(&actual_out, &raw_str, &mir_unit, &syms, &map_keys, linux_code_vaddr) >>> (err) {
            eprintln("xu build: cannot write PGO map: " + err.msg())
            << 1
        }
    }
    if temporary {
        created := write_exclusive(&actual_out, &raw_str) >>> (err) {
            eprintln("xu run: " + err.msg())
            << 1
        }
        if !created {
            eprintln("xu run: temporary output already exists: " + actual_out)
            << 1
        }
    } else {
        os.write(~actual_out, raw_str) >>> (err) {
            eprintln("xu build: " + err.msg())
            << 1
        }
    }
    os.chmod(~actual_out, 493) >>> (err) { // 0755 permissions
        if temporary {
            remove_created_file(&actual_out)
        }
        eprintln("xu: " + err.msg())
        << 1
    }
    if !temporary {
        println("Build complete: " + actual_out)
    }
    << 0
}
