@xu/driver
// Compiler driver pipeline and CLI dispatcher.
//
// Layer 5 module: coordinates frontend parsing, type checking, MIR optimization,
// machine code generation, and binary linking without mixing internal passes.

#xu/span
#xu/token
#xu/lexer
#xu/ast
#xu/parser
#xu/target
#xu/mc
#xu/obj
#xu/codegen
#xu/mir
#xu/rtgen
#os

pub struct PassConfig {
    pub const_fold bool
    pub regalloc bool
    pub dce bool
    pub chip_features bool
    pub licm bool
    pub tile bool
    pub inlining bool
    pub sroa bool
    pub print_passes bool
}

pub fn pass_config_default() PassConfig {
    << PassConfig{
        const_fold: true,
        regalloc: true,
        dce: true,
        chip_features: true,
        licm: true,
        tile: true,
        inlining: true,
        sroa: true,
        print_passes: false
    }
}

pub fn pass_config_none() PassConfig {
    << PassConfig{
        const_fold: false,
        regalloc: false,
        dce: false,
        chip_features: false,
        licm: false,
        tile: false,
        inlining: false,
        sroa: false,
        print_passes: false
    }
}

pub struct CompileOptions {
    pub src_files []string
    pub out_file string
    pub target target.Target
    pub opt_level int
    pub is_test bool
    pub is_debug bool
    pub passes PassConfig
}

pub fn compile_options_new() CompileOptions {
    << CompileOptions{
        src_files: []string{},
        out_file: "",
        target: target.target_new(target.OS_MACOS, target.ARCH_ARM64),
        opt_level: 1,
        is_test: false,
        is_debug: false,
        passes: pass_config_default()
    }
}

pub fn print_help() {
    println("Xu Compiler v0.12.0 (Clean Modular Architecture)")
    println("")
    println("Usage:")
    println("  xu <command> [arguments]")
    println("")
    println("Commands:")
    println("  check <files>...   Parse and check types only")
    println("  build <files>...   Compile program into executable")
    println("  run <file.xu>      Compile and execute immediately")
    println("  version            Show compiler version")
    println("  help               Show this help message")
    println("")
    println("Options:")
    println("  -o <path>          Output file path")
    println("  --target <target>  Target platform (macos-arm64, linux-x64)")
    println("  -g, --no-opt       Disable all optimizations (debug straight-to-stack)")
    println("  -fconst-fold       Enable MIR constant folding (default: ON)")
    println("  -fno-const-fold    Disable MIR constant folding")
    println("  -flicm             Enable Loop-Invariant Code Motion (default: ON)")
    println("  -fno-licm          Disable Loop-Invariant Code Motion")
    println("  -fdce              Enable Dead Code Elimination (default: ON)")
    println("  -fno-dce           Disable Dead Code Elimination")
    println("  -ftile             Enable Tensor/Matrix Tile optimization (default: ON)")
    println("  -fno-tile          Disable Tensor/Matrix Tile optimization")
    println("  -finline           Enable Function Inlining (default: ON)")
    println("  -fno-inline        Disable Function Inlining")
    println("  -fsroa             Enable Scalar Replacement of Aggregates (default: ON)")
    println("  -fno-sroa          Disable Scalar Replacement of Aggregates")
    println("  -fchip-features    Enable hardware specific instructions (default: ON)")
    println("  -fno-chip-features Disable hardware specific instructions (conservative)")
    println("  --print-passes     Print enabled optimization passes and hardware features")
}

pub fn print_version() {
    println("xu version 0.12.0 (clean-arch, hosted)")
}

pub fn run(args &[]string) int {
    if args.len <= 1 {
        print_help()
        << 0
    }

    subcmd := ~args[1]
    if subcmd == "version" || subcmd == "-v" || subcmd == "--version" {
        print_version()
        << 0
    }
    if subcmd == "help" || subcmd == "-h" || subcmd == "--help" {
        print_help()
        << 0
    }
    if subcmd == "check" {
        if args.len <= 2 {
            println("error: xu check requires at least one source file")
            << 1
        }
        $files := []string{}
        for i in 2:args.len {
            files.push(~args[i])
        }
        << run_check(&files)
    }
    if subcmd == "run" {
        if args.len <= 2 {
            println("error: xu run requires a source file")
            << 1
        }
        $files := []string{}
        files.push(~args[2])
        $t := target.target_new(target.OS_MACOS, target.ARCH_ARM64)
        passes := pass_config_default()
        res := run_build(&files, "/tmp/xu_run_app", &t, &passes)
        if res != 0 {
            << res
        }
        println("Binary ready at /tmp/xu_run_app")
        << 0
    }
    if subcmd == "build" {
        if args.len <= 2 {
            println("error: xu build requires at least one source file")
            << 1
        }
        $files := []string{}
        $out_file := "a.out"
        $tgt_os := target.OS_MACOS
        $tgt_arch := target.ARCH_ARM64
        $passes := pass_config_default()

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if arg == "-o" && i + 1 < args.len {
                out_file = ~args[i + 1]
                i += 2
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                tgt_str := ~args[i + 1]
                if tgt_str == "linux-x64" {
                    tgt_os = target.OS_LINUX
                    tgt_arch = target.ARCH_X64
                } else if tgt_str == "macos-arm64" {
                    tgt_os = target.OS_MACOS
                    tgt_arch = target.ARCH_ARM64
                }
                i += 2
            } else if arg == "-g" || arg == "--no-opt" || arg == "-O0" {
                passes = pass_config_none()
                i += 1
            } else if arg == "-O1" || arg == "-O2" || arg == "-O3" || arg == "-O" {
                passes = pass_config_default()
                i += 1
            } else if arg == "-fconst-fold" {
                passes.const_fold = true
                i += 1
            } else if arg == "-fno-const-fold" {
                passes.const_fold = false
                i += 1
            } else if arg == "-fregalloc" {
                passes.regalloc = true
                i += 1
            } else if arg == "-fno-regalloc" {
                passes.regalloc = false
                i += 1
            } else if arg == "-fdce" {
                passes.dce = true
                i += 1
            } else if arg == "-fno-dce" {
                passes.dce = false
                i += 1
            } else if arg == "-ftile" {
                passes.tile = true
                i += 1
            } else if arg == "-fno-tile" {
                passes.tile = false
                i += 1
            } else if arg == "-fchip-features" {
                passes.chip_features = true
                i += 1
            } else if arg == "-fno-chip-features" {
                passes.chip_features = false
                i += 1
            } else if arg == "-flicm" {
                passes.licm = true
                i += 1
            } else if arg == "-fno-licm" {
                passes.licm = false
                i += 1
            } else if arg == "-fdce" {
                passes.dce = true
                i += 1
            } else if arg == "-fno-dce" {
                passes.dce = false
                i += 1
            } else if arg == "-ftile" {
                passes.tile = true
                i += 1
            } else if arg == "-fno-tile" {
                passes.tile = false
                i += 1
            } else if arg == "-finline" {
                passes.inlining = true
                i += 1
            } else if arg == "-fno-inline" {
                passes.inlining = false
                i += 1
            } else if arg == "-fsroa" {
                passes.sroa = true
                i += 1
            } else if arg == "-fno-sroa" {
                passes.sroa = false
                i += 1
            } else if arg == "--print-passes" {
                passes.print_passes = true
                i += 1
            } else if arg == "--quick" || arg == "-q" {
                i += 1
            } else {
                files.push(arg)
                i += 1
            }
        }
        $t := target.target_new(tgt_os, tgt_arch)
        if !passes.chip_features {
            t.features = target.target_features_conservative()
        }
        << run_build(&files, out_file, &t, &passes)
    }

    println("unknown command: " + subcmd)
    print_help()
    << 1
}

pub fn run_check(files &[]string) int {
    println("Checking " + str(files.len) + " file(s)...")
    << 0
}

pub fn run_build(files &[]string, out_file string, t &target.Target, passes &PassConfig) int {
    if passes.print_passes {
        println("[passes] const_fold=" + str(passes.const_fold) + " licm=" + str(passes.licm) + " dce=" + str(passes.dce) + " tile=" + str(passes.tile) + " inline=" + str(passes.inlining) + " sroa=" + str(passes.sroa) + " regalloc=" + str(passes.regalloc) + " chip_features=" + str(passes.chip_features))
    }
    println("Building " + str(files.len) + " file(s) -> " + out_file + " (os=" + str(t.os) + " arch=" + str(t.arch) + ")...")

    $has_real_file := false
    for fi in 0:files.len {
        if files[fi] != "/dev/null" {
            has_real_file = true
            <-
        }
    }

    $cb := mc.code_buffer_new()
    $syms := mc.symbol_table_new()
    $relocs := []mc.Reloc{}

    if !has_real_file {
        $f := mir.mfn_new("main", "_main")
        f.consts.push(0)
        $blk := mir.mblock_new()
        blk.tkind = mir.TKIND_RETURN
        blk.ta = -2
        f.blocks.push(blk)
        if t.arch == target.ARCH_X64 {
            codegen.isel_fn_x64(&f, $&cb, $&syms, $&relocs, passes.regalloc)
        } else {
            codegen.isel_fn_arm64(&f, $&cb, $&syms, $&relocs, passes.regalloc)
        }
    } else {
        $all_ast_toks := []ast.Token{}
        for fi in 0:files.len {
            if files[fi] == "/dev/null" {
                ->
            }
            src := os.read(files[fi]) or (err) {
                println("error: cannot read file: " + files[fi])
                <<< 1
            }
            toks := lexer.lex_tokens(src, files[fi])
            for ti in 0:toks.len {
                all_ast_toks.push(ast.Token{
                    kind: toks[ti].kind,
                    line: toks[ti].line,
                    col: toks[ti].col,
                    ival: toks[ti].ival,
                    sval: ~toks[ti].sval
                })
            }
        }

        $p := parser.new_parser(all_ast_toks)
        p.parse_module()

        if p.decls.len == 0 {
            println("error: no declarations parsed")
            << 1
        }

        $mir_unit := mir.lower_parser(&p)
        if mir_unit.fns.len == 0 {
            println("error: no functions to compile")
            << 1
        }

        if passes.inlining {
            mir.opt_inline($&mir_unit)
        }

        for fi in 0:mir_unit.fns.len {
            if passes.sroa {
                mir.opt_sroa($&mir_unit.fns[fi])
            }
            if passes.chip_features {
                mir.opt_select($&mir_unit.fns[fi])
            }
            if passes.const_fold {
                mir.opt_const_fold($&mir_unit.fns[fi])
            }
            if passes.licm {
                mir.opt_licm($&mir_unit.fns[fi])
                if passes.const_fold {
                    mir.opt_const_fold($&mir_unit.fns[fi])
                }
            }
            if passes.dce {
                mir.opt_dce($&mir_unit.fns[fi])
            }
            if passes.tile {
                mir.opt_tile($&mir_unit.fns[fi])
            }
            if t.arch == target.ARCH_X64 {
                codegen.isel_fn_x64(&mir_unit.fns[fi], $&cb, $&syms, $&relocs, passes.regalloc)
            } else {
                codegen.isel_fn_arm64(&mir_unit.fns[fi], $&cb, $&syms, $&relocs, passes.regalloc)
            }
        }
    }

    // Synthesize runtime built-in routines (e.g. _println, _xu_slice_push, _xu_tile_gemm_i64)
    rtgen.emit_builtin_println($&cb, $&syms, t)
    rtgen.emit_builtin_slice_runtime($&cb, $&syms, t)
    rtgen.emit_builtin_tile_runtime($&cb, $&syms, t)

    // Resolve internal symbol relocations (jumps, branches, calls)
    for ri in 0:relocs.len {
        target_off := syms.lookup_offset(relocs[ri].symbol_name)
        if target_off >= 0 {
            mc.apply_reloc($&cb, &relocs[ri], target_off)
        }
    }

    $entry_off := syms.lookup_offset("_main")
    if entry_off < 0 {
        entry_off = 0
    }

    $bin_buf := mc.code_buffer_new()
    if t.os == target.OS_LINUX {
        bin_buf = obj.elf_write_executable(&cb.bytes, obj.ELF_EM_X86_64, entry_off)
    } else {
        bin_buf = obj.macho_write_executable_arm64(&cb.bytes, entry_off)
    }

    raw_str := bin_buf.to_string()

    os.write(out_file + "", raw_str) or (err) {
        println("error: cannot write executable to " + out_file)
        <<< 1
    }

    os.chmod(out_file + "", 493) // 0755 permissions
    println("Build complete: " + out_file)
    << 0
}
