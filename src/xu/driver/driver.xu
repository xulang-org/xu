pub fn print_debug_help() {
    println("usage: xu debug [options] <input.xu...> [-- program-args...]")
    println("")
    println("Build a DWARF-enabled debug binary and start an interactive source debugger.")
    println("")
    println("Options:")
    println("  -b, --break SPEC     source location file.xu:LINE or function name")
    println("  -e, --eval COMMAND   execute a debugger command before the prompt (repeatable)")
    println("  --run                launch the program after applying debugger commands")
    println("  --batch              run in batch mode without interactive prompt")
    println("  --stop-at-entry      stop at the program entry point")
    println("  --backend PATH       use PATH instead of lldb (gdb is the fallback)")
    println("  --binary PATH        debug an existing executable; skip the build")
    println("  -o, --output PATH    keep the debug executable at PATH")
    println("  --target TARGET      host target to build (macos/linux/windows)")
    println("  -h, --help           show this message")
    println("")
    println("Examples:")
    println("  xu debug -b main.xu:8 main.xu")
    println("  xu debug -b main.xu:8 --run main.xu")
    println("  xu debug --binary ./app -e 'bt' -e 'frame variable'")
}

fn debug_break_command(spec &string) string {
    $split := -1
    for i in 0:spec.len {
        if spec[i] == 58 {
            split = i
        }
    }
    if split > 0 && split + 1 < spec.len {
        file := spec[0:split]
        line := spec[split + 1:spec.len]
        << "breakpoint set --file " + file + " --line " + line
    }
    << "breakpoint set --name " + spec
}

pub fn run_debug(args &[]string) int {
    if args.len <= 2 {
        print_debug_help()
        << 0
    }
    $has_help := false
    for hi in 2:args.len {
        if args[hi] == "-h" || args[hi] == "--help" {
            has_help = true
            <-
        }
    }
    if has_help {
        print_debug_help()
        << 0
    }

    $files := []string{}
    $break_specs := []string{}
    $eval_cmds := []string{}
    $program_args := []string{}
    $out_bin := "/tmp/xu_debug_app"
    $binary := ""
    $backend := "lldb"
    $launch := false
    $batch := false
    $stop_at_entry := false
    $after_sep := false

    $i := 2
    while i < args.len {
        arg := ~args[i]
        if after_sep {
            program_args.push(arg)
            i += 1
        } else if arg == "--" {
            after_sep = true
            i += 1
        } else if arg == "-b" || arg == "--break" {
            if i + 1 < args.len {
                break_specs.push(~args[i + 1])
                i += 2
            } else {
                println("error: --break requires a spec")
                << 1
            }
        } else if arg == "-e" || arg == "--eval" {
            if i + 1 < args.len {
                eval_cmds.push(~args[i + 1])
                i += 2
            } else {
                println("error: --eval requires a command")
                << 1
            }
        } else if arg == "--run" {
            launch = true
            i += 1
        } else if arg == "--batch" {
            batch = true
            i += 1
        } else if arg == "--stop-at-entry" {
            stop_at_entry = true
            i += 1
        } else if arg == "--binary" {
            if i + 1 < args.len {
                binary = ~args[i + 1]
                i += 2
            } else {
                println("error: --binary requires a path")
                << 1
            }
        } else if arg == "--backend" {
            if i + 1 < args.len {
                backend = ~args[i + 1]
                i += 2
            } else {
                println("error: --backend requires a path")
                << 1
            }
        } else if arg == "-o" || arg == "--output" {
            if i + 1 < args.len {
                out_bin = ~args[i + 1]
                i += 2
            } else {
                println("error: -o requires a path")
                << 1
            }
        } else {
            files.push(arg)
            i += 1
        }
    }

    if binary.len == 0 && files.len == 0 {
        println("error: xu debug requires at least one source file or --binary")
        << 1
    }

    $target_bin := binary
    if target_bin.len == 0 {
        $t := target.target_new(target.OS_MACOS, target.ARCH_ARM64)
        passes := pass_config_debug()
        res := run_build(&files, out_bin, &t, &passes)
        if res != 0 {
            << res
        }
        target_bin = out_bin
    }

    $cmd := exec.command(~backend)
    if batch {
        cmd.args.push("--batch")
    }
    for bi in 0:break_specs.len {
        cmd.args.push("-o")
        cmd.args.push(debug_break_command(&break_specs[bi]))
    }
    if program_args.len > 0 {
        $pargs_cmd := "settings set target.run-args"
        for pi in 0:program_args.len {
            pargs_cmd = pargs_cmd + " " + program_args[pi]
        }
        cmd.args.push("-o")
        cmd.args.push(~pargs_cmd)
    }
    if stop_at_entry {
        cmd.args.push("-o")
        cmd.args.push("process launch --stop-at-entry")
    } else if launch {
        cmd.args.push("-o")
        cmd.args.push("process launch")
    }
    for ei in 0:eval_cmds.len {
        cmd.args.push("-o")
        cmd.args.push(~eval_cmds[ei])
    }
    cmd.args.push(~target_bin)

    rc := cmd.run() or (err) {
        println("xu debug: backend '" + backend + "' not found or failed to execute")
        <<< 127
    }
    << rc
}

pub fn print_version() {
    println("    __  __  _   _  ")
    println("    \\ \\/ / | | | |   Xu Compiler Toolchain v0.12.0")
    println("     \\  /  | | | |   Rock-Solid Ownership - Zero GC - Supersonic AOT")
    println("     /  \\  | |_| |   Docs: https://xulang.org")
    println("    /_/\\_\\  \\___/    Target: macos-arm64 - 64-bit Native")
}

pub fn run(args &[]string) int {
    if args.len <= 1 {
        print_help()
        << 0
    }

    subcmd := ~args[1]
    if subcmd == "version" || subcmd == "-v" || subcmd == "--version" || subcmd == "-version" || subcmd == "--ver" {
        print_version()
        << 0
    }
    if subcmd == "help" || subcmd == "-h" || subcmd == "--help" {
        if args.len > 2 {
            $ht := ~args[2]
            if ht == "get" {
                print_get_help()
                << 0
            }
            if ht == "install" {
                print_install_help()
                << 0
            }
            if ht == "up" || ht == "update" {
                print_update_help()
                << 0
            }
            if ht == "debug" {
                print_debug_help()
                << 0
            }
        }
        print_help()
        << 0
    }
    if subcmd == "env" {
        println("XU_VERSION=\"0.12.0\"")
        println("XU_ARCH=\"arm64\"")
        println("XU_OS=\"macos\"")
        println("XUPATH=\"" + os.getenv("XUPATH") + "\"")
        println("XU_STDLIB_ROOT=\"" + os.getenv("XU_STDLIB_ROOT") + "\"")
        << 0
    }
    if subcmd == "init" {
        $mod_name := "app"
        if args.len > 2 {
            mod_name = ~args[2]
        }
        content := "module: " + mod_name + "\nversion: 0.1.0\nxu: 0.12.0\n"
        os.write("xu.xun", content) or (err) {
            println("error: cannot write xu.xun")
            <<< 1
        }
        println("Initialized module " + mod_name + " in xu.xun")
        << 0
    }
    if subcmd == "check" {
        if args.len <= 2 {
            println("error: xu check requires at least one source file")
            << 1
        }
        $files := []string{}
        for i in 2:args.len {
            files.push(~args[i])
        }
        << run_check(&files)
    }
    if subcmd == "run" {
        if args.len <= 2 {
            println("error: xu run requires a source file")
            << 1
        }
        $files := []string{}
        files.push(~args[2])
        $t := target.target_new(target.OS_MACOS, target.ARCH_ARM64)
        passes := pass_config_default()
        res := run_build(&files, "/tmp/xu_run_app", &t, &passes)
        if res != 0 {
            << res
        }
        $cmd := exec.command("/tmp/xu_run_app")
        for i in 3:args.len {
            cmd.args.push(~args[i])
        }
        rc_run := cmd.run() or (err) {
            << 0
        }
        << rc_run
    }
    if subcmd == "test" {
        if args.len <= 2 {
            println("error: xu test requires at least one source file")
            << 1
        }
        $files := []string{}
        for i in 2:args.len {
            arg := ~args[i]
            if arg != "-v" && arg != "-short" {
                files.push(arg)
            }
        }
        $t := target.target_new(target.OS_MACOS, target.ARCH_ARM64)
        passes := pass_config_default()
        res := run_build(&files, "/tmp/xu_test_app", &t, &passes)
        if res != 0 {
            << res
        }
        $cmd := exec.command("/tmp/xu_test_app")
        test_rc := cmd.run() or (err) {
            println("FAIL: test execution failed")
            <<< 1
        }
        for fi in 0:files.len {
            println("PASS: " + files[fi])
        }
        println("ok (all tests passed)")
        << 0
    }
    if subcmd == "debug" {
        << run_debug(args)
    }
    if subcmd == "build" {
        if args.len <= 2 {
            println("error: xu build requires at least one source file")
            << 1
        }
        $files := []string{}
        $out_file := "a.out"
        $tgt_os := target.OS_MACOS
        $tgt_arch := target.ARCH_ARM64
        $passes := pass_config_default()

        $i := 2
        while i < args.len {
            arg := ~args[i]
            if arg == "-o" && i + 1 < args.len {
                out_file = ~args[i + 1]
                i += 2
            } else if (arg == "--target" || arg == "-target") && i + 1 < args.len {
                tgt_str := ~args[i + 1]
                if tgt_str == "linux-x64" {
                    tgt_os = target.OS_LINUX
                    tgt_arch = target.ARCH_X64
                } else if tgt_str == "macos-arm64" {
                    tgt_os = target.OS_MACOS
                    tgt_arch = target.ARCH_ARM64
                }
                i += 2
            } else if arg == "-g" || arg == "--no-opt" || arg == "-O0" || arg == "--debug-build" {
                passes = pass_config_debug()
                i += 1
            } else if arg == "--debug" {
                passes.is_debug = true
                i += 1
            } else if arg == "-O1" || arg == "-O2" || arg == "-O3" || arg == "-O" {
                passes = pass_config_default()
                i += 1
            } else if arg == "-fconst-fold" {
                passes.const_fold = true
                i += 1
            } else if arg == "-fno-const-fold" {
                passes.const_fold = false
                i += 1
            } else if arg == "-fregalloc" {
                passes.regalloc = true
                i += 1
            } else if arg == "-fno-regalloc" {
                passes.regalloc = false
                i += 1
            } else if arg == "-fdce" {
                passes.dce = true
                i += 1
            } else if arg == "-fno-dce" {
                passes.dce = false
                i += 1
            } else if arg == "-ftile" {
                passes.tile = true
                i += 1
            } else if arg == "-fno-tile" {
                passes.tile = false
                i += 1
            } else if arg == "-fchip-features" {
                passes.chip_features = true
                i += 1
            } else if arg == "-fno-chip-features" {
                passes.chip_features = false
                i += 1
            } else if arg == "-flicm" {
                passes.licm = true
                i += 1
            } else if arg == "-fno-licm" {
                passes.licm = false
                i += 1
            } else if arg == "-fdce" {
                passes.dce = true
                i += 1
            } else if arg == "-fno-dce" {
                passes.dce = false
                i += 1
            } else if arg == "-ftile" {
                passes.tile = true
                i += 1
            } else if arg == "-fno-tile" {
                passes.tile = false
                i += 1
            } else if arg == "-finline" {
                passes.inlining = true
                i += 1
            } else if arg == "-fno-inline" {
                passes.inlining = false
                i += 1
            } else if arg == "-fsroa" {
                passes.sroa = true
                i += 1
            } else if arg == "-fno-sroa" {
                passes.sroa = false
                i += 1
            } else if arg == "-fcfg" {
                passes.cfg = true
                i += 1
            } else if arg == "-fno-cfg" {
                passes.cfg = false
                i += 1
            } else if arg == "-fcse" {
                passes.cse = true
                i += 1
            } else if arg == "-fno-cse" {
                passes.cse = false
                i += 1
            } else if arg == "--print-passes" {
                passes.print_passes = true
                i += 1
            } else if arg == "--quick" || arg == "-q" {
                i += 1
            } else {
                files.push(arg)
                i += 1
            }
        }
        $t := target.target_new(tgt_os, tgt_arch)
        if !passes.chip_features {
            t.features = target.target_features_conservative()
        }
        << run_build(&files, out_file, &t, &passes)
    }

    if subcmd == "get" || subcmd == "install" || subcmd == "fmt" || subcmd == "doc" || subcmd == "map" || subcmd == "doctor" || subcmd == "lsp" || subcmd == "native" || subcmd == "xacp" || subcmd == "setup" || subcmd == "up" || subcmd == "update" {
        $has_help := false
        for hi in 2:args.len {
            if args[hi] == "-h" || args[hi] == "--help" {
                has_help = true
                <-
            }
        }
        if has_help {
            if subcmd == "get" {
                print_get_help()
                << 0
            }
            if subcmd == "install" {
                print_install_help()
                << 0
            }
            if subcmd == "up" || subcmd == "update" {
                print_update_help()
                << 0
            }
        }
        $sibling_name := "xu-" + subcmd
        if subcmd == "up" {
            sibling_name = "xu-update"
        }
        $cmd := exec.command(~sibling_name)
        for i in 2:args.len {
            cmd.args.push(~args[i])
        }
        rc := cmd.run() or (err) {
            println("xu: sibling tool '" + sibling_name + "' not found or failed to execute")
            <<< 127
        }
        << rc
    }

    println("unknown command: " + subcmd)
    print_help()
    << 1
}

pub fn run_check(files &[]string) int {
    println("Checking " + str(files.len) + " file(s)...")
    << 0
}

fn is_test_fn(name &string) bool {
    if name.len > 5 {
        if name[0] == 116 && name[1] == 101 && name[2] == 115 && name[3] == 116 && name[4] == 95 {
            << true
        }
    }
    << false
}

pub fn run_build(files &[]string, out_file string, t &target.Target, passes &PassConfig) int {
    if passes.print_passes {
        println("[passes] const_fold=" + str(passes.const_fold) + " licm=" + str(passes.licm) + " dce=" + str(passes.dce) + " cfg=" + str(passes.cfg) + " cse=" + str(passes.cse) + " tile=" + str(passes.tile) + " inline=" + str(passes.inlining) + " sroa=" + str(passes.sroa) + " regalloc=" + str(passes.regalloc) + " chip_features=" + str(passes.chip_features))
    }
    println("Building " + str(files.len) + " file(s) -> " + out_file + " (os=" + str(t.os) + " arch=" + str(t.arch) + ")...")

    $has_real_file := false
    for fi in 0:files.len {
        if files[fi] != "/dev/null" {
            has_real_file = true
            <-
        }
    }

    $cb := mc.code_buffer_new()
    $syms := mc.symbol_table_new()
    $relocs := []mc.Reloc{}

    if !has_real_file {
        $f := mir.mfn_new("main", "_main")
        f.consts.push(0)
        $blk := mir.mblock_new()
        blk.tkind = mir.TKIND_RETURN
        blk.ta = -2
        f.blocks.push(blk)
        if t.arch == target.ARCH_X64 {
            codegen.isel_fn_x64(&f, $&cb, $&syms, $&relocs, passes.regalloc)
        } else {
            codegen.isel_fn_arm64(&f, $&cb, $&syms, $&relocs, passes.regalloc)
        }
    } else {
        $p := parser.new_parser([]ast.Token{})
        for fi in 0:files.len {
            if files[fi] == "/dev/null" {
                ->
            }
            src := os.read(files[fi]) or (err) {
                println("error: cannot read file: " + files[fi])
                <<< 1
            }
            toks := lexer.lex_tokens(src, files[fi])
            $file_ast_toks := []ast.Token{}
            for ti in 0:toks.len {
                file_ast_toks.push(ast.Token{
                    kind: toks[ti].kind,
                    line: toks[ti].line,
                    col: toks[ti].col,
                    ival: toks[ti].ival,
                    sval: ~toks[ti].sval
                })
            }

            $p_sub := parser.new_parser(file_ast_toks)
            p_sub.parse_module()
            p.merge_from(&p_sub)
        }

        if p.decls.len == 0 {
            println("error: no declarations parsed")
            << 1
        }

        $mir_unit := mir.lower_parser(&p)
        if mir_unit.fns.len == 0 {
            println("error: no functions to compile")
            << 1
        }

        $has_main := false
        for fi in 0:mir_unit.fns.len {
            if mir_unit.fns[fi].name == "main" {
                has_main = true
            }
        }

        if !has_main {
            $synth_main := mir.mfn_new("main", "_main")
            $main_bb := mir.mblock_new()
            synth_main.blocks.push(main_bb)
            synth_main.active_bb = 0

            for fi in 0:mir_unit.fns.len {
                fname := mir_unit.fns[fi].name
                if is_test_fn(&fname) {
                    $ins := mir.minstr_new(mir.MI_CALL)
                    ins.a = mir.alloc_temp($&synth_main)
                    ins.c = -1
                    ins.sval = "_" + fname
                    mir.emit_instr($&synth_main, ins)
                }
            }

            czero := mir.alloc_const($&synth_main, 0)
            synth_main.blocks[0].tkind = mir.TKIND_RETURN
            synth_main.blocks[0].ta = czero
            mir_unit.add_fn(synth_main)
        }

        if passes.inlining {
            mir.opt_inline($&mir_unit)
        }

        for fi in 0:mir_unit.fns.len {
            if passes.sroa {
                mir.opt_sroa($&mir_unit.fns[fi])
            }
            if passes.chip_features {
                mir.opt_select($&mir_unit.fns[fi])
            }
            if passes.const_fold {
                mir.opt_const_fold($&mir_unit.fns[fi])
            }
            if passes.licm {
                mir.opt_licm($&mir_unit.fns[fi])
                if passes.const_fold {
                    mir.opt_const_fold($&mir_unit.fns[fi])
                }
            }
            if passes.cse {
                mir.opt_cse($&mir_unit.fns[fi])
            }
            if passes.dce {
                mir.opt_dce($&mir_unit.fns[fi])
            }
            if passes.cfg {
                mir.opt_cfg($&mir_unit.fns[fi])
            }
            if passes.tile {
                mir.opt_tile($&mir_unit.fns[fi])
            }
            if t.arch == target.ARCH_X64 {
                codegen.isel_fn_x64(&mir_unit.fns[fi], $&cb, $&syms, $&relocs, passes.regalloc)
            } else {
                codegen.isel_fn_arm64(&mir_unit.fns[fi], $&cb, $&syms, $&relocs, passes.regalloc)
            }
        }
    }

    // Synthesize runtime built-in routines (e.g. _println, _xu_slice_push, _xu_tile_gemm_i64)
    rtgen.emit_builtin_println($&cb, $&syms, t)
    rtgen.emit_builtin_slice_runtime($&cb, $&syms, t)
    rtgen.emit_builtin_tile_runtime($&cb, $&syms, t)

    // Resolve internal symbol relocations (jumps, branches, calls)
    for ri in 0:relocs.len {
        target_off := syms.lookup_offset(relocs[ri].symbol_name)
        if target_off >= 0 {
            mc.apply_reloc($&cb, &relocs[ri], target_off)
        }
    }

    $entry_off := syms.lookup_offset("_main")
    if entry_off < 0 {
        entry_off = 0
    }

    $bin_buf := mc.code_buffer_new()
    if t.os == target.OS_LINUX {
        bin_buf = obj.elf_write_executable(&cb.bytes, obj.ELF_EM_X86_64, entry_off)
    } else {
        bin_buf = obj.macho_write_executable_arm64(&cb.bytes, entry_off)
    }

    raw_str := bin_buf.to_string()

    os.write(out_file + "", raw_str) or (err) {
        println("error: cannot write executable to " + out_file)
        <<< 1
    }

    os.chmod(out_file + "", 493) // 0755 permissions
    println("Build complete: " + out_file)
    << 0
}
