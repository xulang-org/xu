@xu/driver
// Compiler driver pipeline and CLI dispatcher.
//
// Layer 5 module: coordinates frontend parsing, type checking, MIR optimization,
// machine code generation, and binary linking without mixing internal passes.

#xu/span
#xu/token
#xu/lexer
#xu/ast
#xu/parser
#xu/target
#xu/mc
#xu/obj
#xu/codegen
#xu/mir
#xu/rtgen
#os
#os/exec

pub struct PassConfig {
    pub const_fold bool
    pub regalloc bool
    pub dce bool
    pub chip_features bool
    pub licm bool
    pub tile bool
    pub inlining bool
    pub sroa bool
    pub cfg bool
    pub cse bool
    pub is_debug bool
    pub print_passes bool
}

pub fn pass_config_default() PassConfig {
    << PassConfig{
        const_fold: true,
        regalloc: true,
        dce: true,
        chip_features: true,
        licm: true,
        tile: true,
        inlining: true,
        sroa: true,
        cfg: true,
        cse: true,
        is_debug: false,
        print_passes: false
    }
}

pub fn pass_config_none() PassConfig {
    << PassConfig{
        const_fold: false,
        regalloc: false,
        dce: false,
        chip_features: false,
        licm: false,
        tile: false,
        inlining: false,
        sroa: false,
        cfg: false,
        cse: false,
        is_debug: false,
        print_passes: false
    }
}

pub fn pass_config_debug() PassConfig {
    << PassConfig{
        const_fold: false,
        regalloc: false,
        dce: false,
        chip_features: true,
        licm: false,
        tile: false,
        inlining: false,
        sroa: false,
        cfg: false,
        cse: false,
        is_debug: true,
        print_passes: false
    }
}

pub struct CompileOptions {
    pub src_files []string
    pub out_file string
    pub target target.Target
    pub opt_level int
    pub is_test bool
    pub is_debug bool
    pub passes PassConfig
}

pub fn compile_options_new() CompileOptions {
    << CompileOptions{
        src_files: []string{},
        out_file: "",
        target: target.target_new(target.OS_MACOS, target.ARCH_ARM64),
        opt_level: 1,
        is_test: false,
        is_debug: false,
        passes: pass_config_default()
    }
}

pub fn print_help() {
    println("usage: xu <command> [arguments]")
    println("")
    println("Build and execution commands:")
    println("  build          compile Xu source files into an executable or library")
    println("  run            compile and immediately execute a Xu program")
    println("  debug          build DWARF and start an interactive source debugger")
    println("  test           build and run test harness binaries (fn test_*)")
    println("  check          parse and type/borrow check without code generation")
    println("")
    println("Package and module commands:")
    println("  init           initialize a new Xu module and create xu.xun manifest")
    println("  get            add or update a pinned module dependency in xu.xun")
    println("  install        download remote require: packages into vendor/")
    println("  env            print Xu toolchain and environment variables")
    println("")
    println("Development and diagnostic tools:")
    println("  fmt            format Xu source files via sibling xu-fmt")
    println("  doc            render declarations as Markdown via sibling xu-doc")
    println("  map            visualize source architecture flowchart via sibling xu-map")
    println("  doctor         check host tools and dependencies via sibling xu-doctor")
    println("  native         compile, archive, pack, and inspect native C modules")
    println("  xacp           inspect, run, and debug XACP-enabled programs")
    println("  lsp            Language Server Protocol daemon via sibling xu-lsp")
    println("  setup          launch native installer via sibling xu-setup")
    println("")
    println("Toolchain management:")
    println("  up, update     download latest release and update toolchain")
    println("  help           show help for xu or a specific subcommand")
    println("  --ver, --version show toolchain version")
    println("")
    println("Common build options:")
    println("  -o, --output OUT  output binary path (default a.out)")
    println("  --target TARGET   target platform (macos-arm64, linux-x64, ...)")
    println("  -g, --no-opt       disable all optimizations (debug straight-to-stack)")
    println("  -O1, -O2, -O3      set optimization level (default: -O1)")
    println("  -fconst-fold       enable MIR constant folding (default: ON)")
    println("  -fno-const-fold    disable MIR constant folding")
    println("  -flicm             enable Loop-Invariant Code Motion (default: ON)")
    println("  -fno-licm          disable Loop-Invariant Code Motion")
    println("  -fdce              enable Dead Code Elimination (default: ON)")
    println("  -fno-dce           disable Dead Code Elimination")
    println("  -ftile             enable Tensor/Matrix Tile optimization (default: ON)")
    println("  -fno-tile          disable Tensor/Matrix Tile optimization")
    println("  -finline           enable Function Inlining (default: ON)")
    println("  -fno-inline        disable Function Inlining")
    println("  -fsroa             enable Scalar Replacement of Aggregates (default: ON)")
    println("  -fno-sroa          disable Scalar Replacement of Aggregates")
    println("  -fcfg              enable Control Flow Graph simplification (default: ON)")
    println("  -fno-cfg           disable Control Flow Graph simplification")
    println("  -fcse              enable Common Subexpression Elimination (default: ON)")
    println("  -fno-cse           disable Common Subexpression Elimination")
    println("  -fchip-features    enable hardware specific instructions (default: ON)")
    println("  -fno-chip-features disable hardware specific instructions (conservative)")
    println("  --print-passes     print enabled optimization passes and hardware features")
    println("")
    println("Use \"xu <command> --help\" or \"xu help <command>\" for more information.")
}

