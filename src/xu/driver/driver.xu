    }
    $unresolved_count := 0
    $uefi_reloc_rvas := []int{}
    if tgt_os == target.OS_UEFI {
        uefi_data_rva := obj.pe_next_section_rva(obj.PE_TEXT_RVA, cb.len())
        uefi_data_text_base := uefi_data_rva - obj.PE_TEXT_RVA
        syms.define_label("__xu_uefi_handles", uefi_data_text_base + pe_data.len())
        for _ in 0:16 { pe_data.emit_u8(0) }
        $uefi_sec_offs := []int{}
        for si in 0:edata.secs.len {
            al := edata.secs[si].max_align
            if al > 1 && (al & (al - 1)) == 0 {
                mask := al - 1
                while (pe_data.len() & mask) != 0 {
                    pe_data.emit_u8(0)
                }
            }
            sec_off := pe_data.len()
            uefi_sec_offs.push(sec_off)
            for di in 0:edata.syms.len {
                if edata.syms[di].sec_idx == si {
                    syms.define_label(edata.syms[di].name + "", uefi_data_text_base + sec_off + edata.syms[di].off)
                }
            }
            if edata.secs[si].is_nobits {
                for _ in 0:edata.secs[si].total_size { pe_data.emit_u8(0) }
            } else {
                pe_data.emit_bytes(&edata.secs[si].bytes)
                $rem := edata.secs[si].total_size - edata.secs[si].bytes.len
                while rem > 0 {
                    pe_data.emit_u8(0)
                    rem -= 1
                }
            }
        }
        for si in 0:edata.secs.len {
            for ri in 0:edata.secs[si].relocs.len {
                dr := &edata.secs[si].relocs[ri]
                target_off := syms.lookup_offset(dr.sym)
                if target_off < 0 {
