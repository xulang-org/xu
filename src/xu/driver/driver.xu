                codegen.emit_arm64_aes($&cb, $&syms, $&relocs, &mir_unit.fns[opt_i].label, tgt_os, link_object)
            } else if native_entries[opt_i] && codegen.sha256_hw_entry(&mir_unit.fns[opt_i].label) {
                codegen.emit_arm64_sha256($&cb, $&syms, $&relocs, &mir_unit.fns[opt_i].label, tgt_os, link_object)
            } else if native_entries[opt_i] {
