@xu/driver

#encoding/xun
#errors
#internal/modulepath
#internal/toolpath
#os
#path/filepath
#xu/pkgmgr
#xu/types

struct LocalRequirement {
    name string
    path string
}

struct LocalDependency {
    name string
    path string
    single_file bool
}

struct ProjectRequirements {
    local []LocalRequirement
    native_imports types.StrMap
}

fn read_local_requirements(doc &xun.Doc, node int, dir &string, manifest &string, deps $&[]LocalRequirement) int {
    if !doc.is_dict(node) {
        >> errors.new(manifest + ": expected a xu.xun 'require' mapping")
    }
    for i in 0:doc.count(node) {
        entry := doc.at(node, i)
        name := doc.key(entry)
        if !modulepath.valid_path(&name) || (modulepath.is_external(&name) && !modulepath.valid_module(&name)) {
            >> errors.new(manifest + ": invalid dependency module '" + name + "'")
        }
        value := doc.as_str(entry)
        if !doc.is_scalar(entry) || !str_starts_with(&value, "file:") {
            >> errors.new(manifest + ": require '" + name + "': only file: locators are supported")
        }
        locator := value[5:value.len]
        if locator.len == 0 {
            >> errors.new(manifest + ": require '" + name + "': missing file: path")
        }
        for j in 0:locator.len {
            if locator[j] == 0 {
                >> errors.new(manifest + ": require '" + name + "': NUL in file: path")
            }
        }
        $path := locator + ""
        if !filepath.is_abs(&locator) {
            path = dir + "/" + locator
        }
        deps.push(LocalRequirement{name: ~name, path: abs_path(&path)})
    }
    << 0
}

// A manifest can provide pure Xu packages alongside native libraries.
// Resolve the pure packages and diagnose native dependencies on import.
fn read_native_imports(doc &xun.Doc, node int, manifest &string, imports $&types.StrMap) int {
    if !doc.is_dict(node) {
        >> errors.new(manifest + ": expected a xu.xun 'native' mapping")
    }
    for i in 0:doc.count(node) {
        entry := doc.at(node, i)
        name := doc.key(entry)
        locator := doc.as_str(entry)
        if !modulepath.valid_path(&name) || !doc.is_scalar(entry) || locator.len == 0 {
            >> errors.new(manifest + ": invalid native dependency '" + name + "'")
        }
        imports.put(name, 1)
    }
    << 0
}

fn local_dependency(req &LocalRequirement) LocalDependency {
    if !os.is_dir(~req.path) {
        >> errors.new("require '" + req.name + "': local dependency not found: " + req.path)
    }
    if !modulepath.is_external(&req.name) {
        child := req.path + "/" + req.name
        if os.is_dir(~child) {
            << LocalDependency{name: ~req.name, path: ~child, single_file: false}
        }
        file := child + ".xu"
        info := os.stat(~file) or (err) {
            << LocalDependency{name: ~req.name, path: ~req.path, single_file: false}
        }
        if !info.is_dir {
            << LocalDependency{name: ~req.name, path: ~file, single_file: true}
        }
    }
    << LocalDependency{name: ~req.name, path: ~req.path, single_file: false}
}

// The growing queue contains declarations relative to their own manifests.
// Record a module before reading its manifest so repeated edges and cycles
// expand only once, while different locations for the same name are errors.
fn resolve_local_dependencies(requirements $&ProjectRequirements) []LocalDependency {
    $deps := []LocalDependency{}
    $indices := types.new_strmap()
    $identities := []string{}
    $i := 0
    while i < requirements.local.len {
        req := &requirements.local[i]
        dep := local_dependency(req) or >>
        same_as_locator := dep.path == req.path
        i += 1
        actual := toolpath.real_path(&dep.path) or >>
        identity := host_slashes(actual)
        idx := indices.lookup(&dep.name)
        if idx >= 0 {
            if identities[idx] != identity {
                >> errors.new("require '" + dep.name + "': conflicting dependency sources: " +
                    deps[idx].path + " and " + dep.path)
            }
            ->
        }
        indices.put(~dep.name, deps.len)
        if !dep.single_file {
            external := modulepath.is_external(&dep.name)
            manifest_name := read_project_module(&dep.path, external, requirements) or >>
            if manifest_name.len > 0 && manifest_name != dep.name {
                >> errors.new(dep.path + "/xu.xun: module '" + manifest_name + "' does not match require '" + dep.name + "'")
            }
            if manifest_name.len == 0 && same_as_locator {
                $sources := []string{}
                if !pkgmgr.collect_sources(&dep.path, $&sources) {
                    >> errors.new("require '" + dep.name + "': no readable .xu sources in " + dep.path)
                }
            }
        }
        identities.push(identity)
        deps.push(dep)
    }
    << deps
}

// Declared module roots are searched by import name, never as ambient roots.
fn find_local_dependency(imp &string, deps &[]LocalDependency, paths $&[]string) bool {
    $declared := false
    for i in 0:deps.len {
        dep := &deps[i]
        before := paths.len
        if str_eq(&dep.name, imp) {
            declared = true
            if dep.single_file {
                paths.push(~dep.path)
            } else {
                pkgmgr.collect_sources(&dep.path, paths)
            }
        } else {
            prefix := dep.name + "/"
            if str_starts_with(imp, prefix + "") {
                declared = true
                if !dep.single_file {
                    rel := imp[prefix.len:imp.len]
                    pkgmgr.resolve_package_files(&rel, &dep.path, paths)
                }
            }
        }
        if before > 0 && paths.len > before {
            >> errors.new("require: ambiguous package '" + imp + "' in declared module roots")
        }
    }
    if declared && paths.len == 0 {
        >> errors.new("require: package '" + imp + "' not found in declared module roots")
    }
    << declared
}
