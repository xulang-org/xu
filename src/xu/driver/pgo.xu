@xu/driver

#internal/dependency
#xu/mc
#xu/obj
#errors
#os
#strconv
#strings
#xu/mir

// Parse once and return counts indexed by the original MIR function order.
// A profile may contain functions that were not selected for this build.
fn load_pgo_counts(path string, unit &mir.Mir, keys $&[]string) [][]int {
    content := os.read(path) or >>
    $indices := map[string]int{}
    $counts := [][]int{}
    $seen := []bool{}
    for fi in 0:unit.fns.len {
        indices[unit.fns[fi].label] = fi
        counts.push([]int{})
        seen.push(false)
        keys.push("")
    }

    $pos := 0
    $line_number := 0
    $expect_counts := false
    $function := -1
    while pos < content.len {
        $end := pos
        while end < content.len && content[end] != 10 && content[end] != 13 {
            end += 1
        }
        line := content[pos:end]
        pos = end
        if pos < content.len && content[pos] == 13 { pos += 1 }
        if pos < content.len && content[pos] == 10 { pos += 1 }
        line_number += 1
        fields := strings.fields(&line)

        if expect_counts {
            values := parse_pgo_counts(&fields) or (err) {
                >> errors.new("line " + str(line_number) + ": " + err.msg())
            }
            // Preserve the first entry when a label occurs more than once.
            if function >= 0 && !seen[function] {
                counts[function] = ~values
                seen[function] = true
            }
            expect_counts = false
        } else if fields.len > 0 {
            if (fields.len != 2 && fields.len != 3) || fields[0] != "fn" {
                >> errors.new("line " + str(line_number) + ": expected 'fn <label>'")
            }
            function = indices.get_or(fields[1], -1)
            if fields.len == 3 && function >= 0 && !seen[function] { keys[function] = ~fields[2] }
            expect_counts = true
        }
    }
    if expect_counts {
        >> errors.new("line " + str(line_number + 1) + ": missing block counts")
    }
    << counts
}

fn parse_pgo_counts(fields &[]string) []int {
    $counts := []int{}
    for i in 0:fields.len {
        token := &fields[i]
        if token[0] == 45 {
            >> errors.new("block counts must be nonnegative")
        }
        count := strconv.atoi(token) or (err) {
            >> errors.new("invalid block count: " + err.msg())
        }
        counts.push(count)
    }
    << counts
}

fn pgo_has_samples(counts &[]int) bool {
    for count in counts {
        if count > 0 { << true }
    }
    << false
}

// Addresses are linked ELF virtual addresses. Only branches actually emitted
// by the MIR selector have a site label (native overrides have none).
fn write_pgo_map(path &string, image &string, unit &mir.Mir, syms &mc.SymbolTable, keys &[]string) int {
    base := obj.elf_code_vaddr()
    $body := "xupgo-map-v1 " + dependency.artifact_sha256(image) + "\n"
    for fi in 0:unit.fns.len {
        f := &unit.fns[fi]
        $started := false
        for bi in 0:f.blocks.len {
            b := &f.blocks[bi]
            if b.tkind != mir.TKIND_BRANCH { -> }
            pc := syms.lookup_offset(f.label + ".pgo" + str(bi))
            if pc < 0 { -> }
            if !started {
                body.push_str("fn " + f.label + " " + keys[fi] + "\n")
                started = true
            }
            yes := syms.lookup_offset(f.label + ".bb" + str(b.tb))
            no := syms.lookup_offset(f.label + ".bb" + str(b.tc))
            if yes < 0 || no < 0 { >> errors.new("missing branch successor") }
            body.push_str(str(b.pgo_ordinal) + " " + str(base + pc) + " " + str(base + yes) + " " + str(base + no) + "\n")
        }
    }
    os.write(*path + ".xumap", body) or >>
    << 0
}
