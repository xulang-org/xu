@xu/driver

#xu/ast
#xu/parser
#internal/toolpath

fn run_xacp_tool(args &[]string) int {
    tool := "xu-xacp"
    $bin := toolpath.sibling(&tool) or (err) {
        eprintln("xu xacp: " + err.msg())
        << 127
    }
    if bin.len == 0 { bin = ~tool }
    << run_program(&bin, args)
}

fn xacp_option_width(arg &string) int {
    if str_eq(arg, &"--xacp-port") { << 2 }
    << 1
}

fn xacp_option_port(args &[]string, i int) int {
    arg := ~args[i]
    $value := ""
    if xacp_option_width(&arg) == 2 {
        if i + 1 >= args.len { << -1 }
        value = ~args[i + 1]
    } else {
        value = arg[12:arg.len]
    }
    if value.len == 0 { << -1 }
    $port := 0
    for j in 0:value.len {
        digit := value[j] - 48
        if digit < 0 || digit > 9 { << -1 }
        port = port * 10 + digit
        if port > 65535 { << -1 }
    }
    << port
}

fn insert_xacp_startup(program $&parser.Parser, port int) {
    for i in 0:program.decls.len {
        decl := program.decls[i]
        if program.nodes[decl].kind != ast.NK_FN || program.nodes[decl].sval != "main" { -> }
        owner := ~program.nodes[decl].sval2
        if owner != "" && owner != "main" { -> }
        main_file := program.decl_file[i]
        name := "<xacp-startup>"
        source := "@main\nxu_generated_xacp_startup #xacp\nfn startup() { xu_generated_xacp_startup.program_preflight(" + str(port) + ") }\n"
        $hook := parse_source_text(source, &name)
        stmt := hook.nodes[hook.decls[0]].c + program.nodes.len
        // The startup call uses the ordinary typed pipeline in main's file scope.
        hook.decls = []int{}
        hook.decl_file = []int{}
        hook.nfn = 0
        program.merge_from(&hook)
        program.file_names.push(~name)
        program.imp_owner.push(owner)
        program.imp_path.push("xacp")
        program.imp_alias.push("xu_generated_xacp_startup")
        program.imp_file.push(main_file)
        program.nodes[stmt].next = program.nodes[decl].c
        program.nodes[decl].c = stmt
        <<
    }
}
