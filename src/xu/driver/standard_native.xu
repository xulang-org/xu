@xu/driver

#encoding/xun
#errors
#internal/modulepath
#internal/toolpath
#os
#os/exec
#path/filepath
#strings
#xu/parser
#xu/target

// Standard-library source backends are built only when imported. Their data
// manifest contains relative input paths, never executable build commands.
fn standard_native_path(dir &string, name &string) string {
    if name.len == 0 || filepath.is_abs(name) { >> errors.new("standard native: expected a relative source path") }
    normalized := filepath.to_slash(name)
    for part in strings.split(&normalized, "/") {
        if part == ".." || part == "." || part.len == 0 { >> errors.new("standard native: invalid source path") }
    }
    for i in 0:name.len { if name[i] == 0 { >> errors.new("standard native: NUL in source path") } }
    << dir + "/" + normalized
}
fn compile_standard_native(dir &string, spec &string, archive &string, stdlib &string, code int) int {
    body := os.read(~spec) or >>
    if body.len > 65536 { >> errors.new("standard native: build description exceeds 64 KiB") }
    doc := xun.parse(&body)
    if !doc.ok() { >> errors.new(spec + ": " + doc.error()) }
    root := doc.root()
    if !doc.is_dict(root) { >> errors.new(spec + ": expected a build description") }
    for i in 0:doc.count(root) {
        key := doc.key(doc.at(root, i))
        if key != "manifest" && key != "sources" { >> errors.new(spec + ": unknown build key '" + key + "'") }
    }
    if doc.count(root) != 2 { >> errors.new(spec + ": expected exactly manifest and sources") }
    manifest_node := doc.get(root, "manifest")
    if !doc.is_scalar(manifest_node) { >> errors.new(spec + ": missing native manifest path") }
    manifest_name := doc.as_str(manifest_node)
    manifest := standard_native_path(dir, &manifest_name) or >>
    sources := doc.get(root, "sources")
    if !doc.is_list(sources) || doc.count(sources) < 1 || doc.count(sources) > 16 {
        >> errors.new(spec + ": expected one to sixteen C sources")
    }
    tool_name := "xu-native"
    tool := toolpath.sibling(&tool_name) or >>
    if tool.len == 0 { >> errors.new("standard native: selected SDK is missing its sibling xu-native tool") }
    $cmd := exec.command(tool, "compile", "--manifest", manifest, "--target", target.target_name(code), "-o", ~archive)
    cc := os.getenv("XU_NATIVE_CC")
    if cc.len > 0 { cmd.args.push("--cc")
        cmd.args.push(cc) }
    cmd.args.push("-std=c11")
    cmd.args.push("-O2")
    cmd.args.push("-Wall")
    cmd.args.push("-Wextra")
    cmd.args.push("-Werror")
    // Keep the source backend and C ABI header in the same selected SDK.
    cmd.args.push("-iquote" + filepath.dir(stdlib) + "/include")
    for i in 0:doc.count(sources) {
        node := doc.at(sources, i)
        if !doc.is_scalar(node) { >> errors.new(spec + ": expected a C source path") }
        source_name := doc.as_str(node)
        path := standard_native_path(dir, &source_name) or >>
        if !str_ends_with(&path, ".c") { >> errors.new(spec + ": native source must end in .c") }
        cmd.args.push(path)
    }
    result := cmd.run() or (err) { >> errors.new(spec + ": native build failed: " + err.msg()) }
    if result != 0 { >> errors.new(spec + ": native source build failed; check the selected C compiler and target SDK") }
    << 0
}
fn load_standard_native(stdlib &string, name &string, code int, conflict bool, program $&parser.Parser, unit $&NativeUnit) bool {
    if !modulepath.valid_path(name) || modulepath.is_external(name) { << false }
    dir := stdlib + "/" + name
    spec := dir + "/native.xun"
    info := os.stat(~spec) or (err) { << false }
    if info.is_dir || info.size > 65536 { >> errors.new(spec + ": invalid native build description") }
    if conflict { >> errors.new("native dependency conflicts with standard package '" + name + "'") }
    os_code := target.target_os(code)
    arch := target.target_arch(code)
    if (os_code != target.OS_MACOS && os_code != target.OS_LINUX && os_code != target.OS_WINDOWS) ||
        (arch != target.ARCH_ARM64 && arch != target.ARCH_X64 &&
         !(os_code == target.OS_LINUX && (arch == target.ARCH_RISCV64 || arch == target.ARCH_LOONG64))) {
        >> errors.new("standard native source requires a supported 64-bit hosted target")
    }
    temporary := os.mkdir_temp("", "xu-standard-native-*") or >>
    load_standard_native_in(&temporary, &dir, &spec, stdlib, name, code, program, unit) or (err) {
        os.remove_all(~temporary) or (cleanup) {}
        >> err
    }
    os.remove_all(~temporary) or >>
    << true
}
fn load_standard_native_in(temporary &string, dir &string, spec &string, stdlib &string, name &string, code int, program $&parser.Parser, unit $&NativeUnit) int {
    archive := temporary + "/native.a"
    compile_standard_native(dir, spec, &archive, stdlib, code) or >>
    load_native(&archive, name, code, program, unit) or >>
    << 0
}
