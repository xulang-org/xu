@xu/driver

// Owned clone of a borrowed string. Sole `+ ""` in path/driver helpers.
fn str_clone(s &string) string {
    << s + ""
}

fn str_eq_lit(a &string, lit string) bool {
    << str_eq(a, &lit)
}

fn path_join(dir &string, rel &string) string {
    if dir.len == 0 {
        << str_clone(rel)
    }
    if str_eq_lit(dir, ".") {
        << str_clone(rel)
    }
    last := dir[dir.len - 1]
    if last == 47 || last == 92 {
        << dir + rel
    }
    << dir + "/" + rel
}

fn hex16(n int) string {
    digits := "0123456789abcdef"
    $x := n
    if x < 0 {
        x = 0 - x
    }
    $out := ""
    for i in 0:16 {
        d := x % 16
        out = string_from_byte(digits[d]) + out
        x = x / 16
    }
    << out
}

fn cli_arg_owned(argv &[]string, i int) string {
    << ~argv[i]
}
