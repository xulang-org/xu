@xu/driver

#strings
#errors
#xu/mc
#xu/target

fn native_exported_label(name &string, unit &NativeUnit) bool {
    if !str_starts_with(name, "_xu_") || strings.contains(name, ".bb") || strings.has_suffix(name, ".ret") { << false }
    for i in 0:unit.labels.len { if unit.labels[i] == name + "" { << false } }
    << true
}

// Keep the fixed-up Xu text in one assembler section. Only external call
// fields become linker relocations; internal relative offsets stay unchanged.
// This lets the system linker place the complete DWARF beside the same text
// object, including Mach-O debug maps consumed by dsymutil.
fn native_assembly(code &mc.CodeBuffer, calls &[]mc.Reloc, syms &mc.SymbolTable,
    unit &NativeUnit, entry_offset int, os int, arch int) string {
    $out := ".text\n.p2align 4\n"
    if arch == target.ARCH_RISCV64 { out.push_str(".option norvc\n.option norelax\n") }
    $entry := "xu_app_start"
    if os == target.OS_MACOS { entry = "_xu_app_start" }
    $heads := []int{}
    for i in 0:code.bytes.len + 1 { heads.push(-1) }
    $next := []int{}
    for i in 0:syms.labels.len {
        l := &syms.labels[i]
        next.push(-1)
        if l.is_defined && l.offset >= 0 && l.offset <= code.bytes.len && native_exported_label(&l.name, unit) && l.name != entry {
            next[i] = heads[l.offset]
            heads[l.offset] = i
        }
    }
    $pos := 0
    $ri := 0
    while pos < code.bytes.len {
        if pos == entry_offset {
            out.push_str(".globl " + entry + "\n" + entry + ":\n")
            if os == target.OS_LINUX { out.push_str(".globl xu_app_start_hosted\nxu_app_start_hosted:\n") }
        }
        $symbol := heads[pos]
        while symbol >= 0 {
            name := native_c_quote(&syms.labels[symbol].name)
            out.push_str(".globl " + name + "\n" + name + ":\n")
            symbol = next[symbol]
        }
        $relocation_here := ri < calls.len && calls[ri].offset == pos
        if arch == target.ARCH_X64 && ri < calls.len {
            // Emit complete instructions so the assembler selects branch or
            // RIP-relative relocations. An undefined-symbol subtraction in
            // a raw .long cannot represent these on Mach-O.
            offset := calls[ri].offset
            if offset == pos + 1 && (code.bytes[pos] == 232 || code.bytes[pos] == 233) {
                relocation_here = true
            } else if offset == pos + 2 && pos + 1 < code.bytes.len && code.bytes[pos] == 255 && code.bytes[pos + 1] == 37 {
                relocation_here = true
            }
        }
        if relocation_here {
            r := &calls[ri]
            $name := ~r.symbol_name
            if os == target.OS_WINDOWS && str_starts_with(&name, "_iat_") {
                name = "__imp_" + name[5:name.len]
            }
            quoted := native_c_quote(&name)
            if arch == target.ARCH_ARM64 {
                $branch := "bl "
                if (code.bytes[pos + 3] & 128) == 0 { branch = "b " }
                out.push_str(branch + quoted + "\n")
                pos += 4
            } else if arch == target.ARCH_X64 {
                if r.kind != mc.RELOC_X64_PC32 || r.addend != 0 {
                    >> errors.new("native link: unsupported x86 relocation kind or addend")
                }
                if r.offset == pos + 1 && code.bytes[pos] == 232 {
                    out.push_str("callq " + quoted + "\n")
                    pos += 5
                } else if r.offset == pos + 1 && code.bytes[pos] == 233 {
                    out.push_str("jmp " + quoted + "\n")
                    pos += 5
                } else if r.offset == pos + 2 && code.bytes[pos] == 255 && code.bytes[pos + 1] == 37 {
                    out.push_str("jmpq *" + quoted + "(%rip)\n")
                    pos += 6
                } else {
                    >> errors.new("native link: unsupported x86 external instruction")
                }
            } else if arch == target.ARCH_RISCV64 {
                out.push_str("call " + quoted + "\n")
                pos += 8
            } else {
                out.push_str("bl " + quoted + "\nnop\n")
                pos += 8
            }
            ri += 1
        } else {
            out.push_str(".byte " + str(code.bytes[pos]) + "\n")
            pos += 1
        }
    }
    if os == target.OS_LINUX { out.push_str(".section .note.GNU-stack,\"\",@progbits\n") }
    << out
}
