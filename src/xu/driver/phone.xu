@xu/driver

#errors
#internal/toolpath
#os
#os/exec
#xu/obj
#xu/target

fn phone_target(name &string) bool {
    value := name + ""
    << value == "ios-arm64" || value == "ios-simulator-arm64" || value == "android-arm64"
}

fn run_phone_build(source &string, target_name &string, output &string, bundle &string, profile &string) int {
    tool := "xu-phone"
    $bin := toolpath.sibling(&tool) or (err) { eprintln(err.msg())
        << 127 }
    if bin.len == 0 { bin = ~tool }
    $args := ["pack", ~source, "--target", ~target_name]
    if profile.len > 0 { args.push("--phone-profile")
        args.push(~profile) }
    if output.len > 0 { args.push("-o")
        args.push(~output) }
    if bundle.len > 0 { args.push("--bundle-id")
        args.push(~bundle) }
    << run_program(&bin, &args)
}

// The packer passes the real platform separately from the Xu instruction ABI.
// Native slices and C toolchains must never fall back to a desktop target.
fn phone_native_target(code int) string {
    name := os.getenv("XU_PHONE_NATIVE_TARGET")
    if name.len == 0 { << target.target_name(code) }
    $expected := target.OS_MACOS
    if name == "android-arm64" { expected = target.OS_LINUX }
    if !phone_target(&name) || target.target_os(code) != expected ||
        target.target_arch(code) != target.ARCH_ARM64 {
        >> errors.new("Phone native target does not match the Xu instruction ABI")
    }
    << name
}

fn phone_native_flags(code int) int {
    name := phone_native_target(code) or >>
    if name == "ios-arm64" { << 1 }
    if name == "ios-simulator-arm64" { << 2 }
    if name == "android-arm64" { << 3 }
    << 0
}

fn write_phone_native(unit &NativeUnit, output &string, code int) int {
    name := phone_native_target(code) or >>
    directory := output + ".native"
    os.mkdir_all(directory + "") or >>
    os.write(directory + "/bridge.c", native_marshaler(unit)) or >>
    os.write(directory + "/target", name + "\n") or >>
    for i in 0:unit.archives.len {
        os.write(directory + "/native-" + str(i) + ".a", ~unit.archives[i]) or >>
    }
    << 0
}

fn convert_phone_object(args &[]string, simulator bool) int {
    if args.len != 4 { eprintln("Phone object conversion requires INPUT.xuobj OUTPUT.o")
        << 1 }
    data := os.read(~args[2]) or (err) { eprintln(err.msg())
        << 1 }
    object := obj.convert_phone_object(&data, simulator) or (err) { eprintln(err.msg())
        << 1 }
    os.write(~args[3], object.to_string()) or (err) { eprintln(err.msg())
        << 1 }
    << 0
}
