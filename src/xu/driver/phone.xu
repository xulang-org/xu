@xu/driver

#internal/toolpath
#os/exec
#os
#xu/obj

fn phone_target(name &string) bool {
    value := name + ""
    << value == "ios-arm64" || value == "ios-simulator-arm64" || value == "android-arm64"
}

fn run_phone_build(source &string, target_name &string, output &string, bundle &string) int {
    tool := "xu-phone"
    $bin := toolpath.sibling(&tool) or (err) { eprintln(err.msg())
        << 127 }
    if bin.len == 0 { bin = ~tool }
    $args := ["pack", ~source, "--target", ~target_name]
    if output.len > 0 { args.push("-o")
        args.push(~output) }
    if bundle.len > 0 { args.push("--bundle-id")
        args.push(~bundle) }
    << run_program(&bin, &args)
}

fn convert_phone_object(args &[]string, simulator bool) int {
    if args.len != 4 { eprintln("Phone object conversion requires INPUT.xuobj OUTPUT.o")
        << 1 }
    data := os.read(~args[2]) or (err) { eprintln(err.msg())
        << 1 }
    object := obj.convert_phone_object(&data, simulator) or (err) { eprintln(err.msg())
        << 1 }
    os.write(~args[3], object.to_string()) or (err) { eprintln(err.msg())
        << 1 }
    << 0
}
