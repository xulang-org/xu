@xu/driver

#xu/obj
#xu/target

fn native_debug_number(bytes &[]int, offset int, size int) int {
    $value := 0
    for i in 0:size { value = value | ((bytes[offset + i] & 255) << (i * 8)) }
    << value
}

fn native_debug_has(offsets &[]int, pos int) bool {
    for i in 0:offsets.len { if offsets[i] == pos { << true } }
    << false
}

fn native_debug_section(name string, os int) string {
    if os == target.OS_MACOS { << ".section __DWARF,__debug_" + name + ",regular,debug\n" }
    if os == target.OS_WINDOWS { << ".section .debug_" + name + ",\"dr\"\n" }
    << ".section .debug_" + name + ",\"\",@progbits\n"
}

// Code addresses need linker relocations. Mach-O keeps DWARF section offsets
// relative to this object for dsymutil; ELF/COFF merge sections in the linker.
fn native_debug_asm(debug &obj.DebugSections, entry_offset int, os int) string {
    $entry := "xu_app_start"
    if os == target.OS_MACOS { entry = "_xu_app_start" }
    $out := ""
    for section in 0:4 {
        $name := "line"
        $bytes := &debug.line
        $addresses := &debug.line_addresses
        if section == 1 { name = "info"
            bytes = &debug.info
            addresses = &debug.info_addresses }
        if section == 2 { name = "abbrev"
            bytes = &debug.abbrev }
        if section == 3 { name = "str"
            bytes = &debug.str }
        out.push_str(native_debug_section(~name, os) + "Lxu_debug_" + name + ":\n")
        $pos := 0
        while pos < bytes.len {
            if section < 2 && native_debug_has(addresses, pos) {
                address := native_debug_number(bytes, pos, 8) - entry_offset
                out.push_str(".quad " + entry + " + (" + str(address) + ")\n")
                pos += 8
            } else if os != target.OS_MACOS && section == 1 && (pos == 6 || pos == 32 || native_debug_has(&debug.info_strings, pos)) {
                $target_section := "str"
                if pos == 6 { target_section = "abbrev" }
                if pos == 32 { target_section = "line" }
                value := native_debug_number(bytes, pos, 4)
                out.push_str(".long Lxu_debug_" + target_section + " + " + str(value) + "\n")
                pos += 4
            } else {
                out.push_str(".byte " + str(bytes[pos]) + "\n")
                pos += 1
            }
        }
    }
    if os == target.OS_LINUX { out.push_str(".section .note.GNU-stack,\"\",@progbits\n") }
    << out
}
