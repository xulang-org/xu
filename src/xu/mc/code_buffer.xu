@xu/mc
// Machine code byte stream buffer.
//
// Layer 4A module: low-level binary code emitting and patching with zero
// dependencies on AST, types, or target-specific instructions.

pub struct CodeBuffer {
    pub bytes []int
}

pub fn code_buffer_new() CodeBuffer {
    << CodeBuffer{ bytes: []int{} }
}

pub fn (b $&CodeBuffer) len() int {
    << b.bytes.len
}

pub fn (b $&CodeBuffer) emit_u8(v int) {
    b.bytes.push(v & 255)
}

pub fn (b $&CodeBuffer) emit_u16_le(v int) {
    b.bytes.push(v & 255)
    b.bytes.push((v >> 8) & 255)
}

pub fn (b $&CodeBuffer) emit_u32_le(v int) {
    b.bytes.push(v & 255)
    b.bytes.push((v >> 8) & 255)
    b.bytes.push((v >> 16) & 255)
    b.bytes.push((v >> 24) & 255)
}

pub fn (b $&CodeBuffer) emit_u64_le(v int) {
    b.bytes.push(v & 255)
    b.bytes.push((v >> 8) & 255)
    b.bytes.push((v >> 16) & 255)
    b.bytes.push((v >> 24) & 255)
    b.bytes.push((v >> 32) & 255)
    b.bytes.push((v >> 40) & 255)
    b.bytes.push((v >> 48) & 255)
    b.bytes.push((v >> 56) & 255)
}

pub fn (b $&CodeBuffer) emit_u32_be(v int) {
    b.bytes.push((v >> 24) & 255)
    b.bytes.push((v >> 16) & 255)
    b.bytes.push((v >> 8) & 255)
    b.bytes.push(v & 255)
}

pub fn (b $&CodeBuffer) emit_bytes(src &[]int) {
    for i in 0:src.len {
        b.bytes.push(src[i] & 255)
    }
}

pub fn (b $&CodeBuffer) align_to(alignment int, pad_byte int) {
    if alignment <= 1 { << }
    rem := b.bytes.len % alignment
    if rem != 0 {
        needed := alignment - rem
        for i in 0:needed {
            b.bytes.push(pad_byte & 255)
        }
    }
}

pub fn (b $&CodeBuffer) patch_u8(offset int, v int) {
    if offset >= 0 && offset < b.bytes.len {
        b.bytes[offset] = v & 255
    }
}

pub fn (b $&CodeBuffer) patch_u32_le(offset int, v int) {
    if offset >= 0 && offset + 4 <= b.bytes.len {
        b.bytes[offset] = v & 255
        b.bytes[offset + 1] = (v >> 8) & 255
        b.bytes[offset + 2] = (v >> 16) & 255
        b.bytes[offset + 3] = (v >> 24) & 255
    }
}

pub fn (b $&CodeBuffer) patch_u64_le(offset int, v int) {
    if offset >= 0 && offset + 8 <= b.bytes.len {
        b.bytes[offset] = v & 255
        b.bytes[offset + 1] = (v >> 8) & 255
        b.bytes[offset + 2] = (v >> 16) & 255
        b.bytes[offset + 3] = (v >> 24) & 255
        b.bytes[offset + 4] = (v >> 32) & 255
        b.bytes[offset + 5] = (v >> 40) & 255
        b.bytes[offset + 6] = (v >> 48) & 255
        b.bytes[offset + 7] = (v >> 56) & 255
    }
}

pub fn (b &CodeBuffer) to_string() string {
    << string_from_bytes(b.bytes)
}
