@xu/mc
// Labels and symbol tables for machine code emission.
//
// Layer 4A module: tracks code/data label offsets and unresolved references.

pub struct Label {
    pub id int
    pub name string
    pub offset int
    pub is_defined bool
}

pub struct SymbolTable {
    pub labels []Label
}

pub fn symbol_table_new() SymbolTable {
    << SymbolTable{ labels: []Label{} }
}

pub fn (s $&SymbolTable) define_label(name string, offset int) int {
    for i in 0:s.labels.len {
        if s.labels[i].name == name {
            s.labels[i].offset = offset
            s.labels[i].is_defined = true
            << i
        }
    }
    id := s.labels.len
    s.labels.push(Label{
        id: id,
        name: ~name,
        offset: offset,
        is_defined: true
    })
    << id
}

pub fn (s $&SymbolTable) get_or_create_label(name string) int {
    for i in 0:s.labels.len {
        if s.labels[i].name == name {
            << i
        }
    }
    id := s.labels.len
    s.labels.push(Label{
        id: id,
        name: ~name,
        offset: -1,
        is_defined: false
    })
    << id
}

pub fn (s &SymbolTable) lookup_offset(name string) int {
    for i in 0:s.labels.len {
        if s.labels[i].name == name {
            if s.labels[i].is_defined {
                << s.labels[i].offset
            }
            << -1
        }
    }
    << -1
}
