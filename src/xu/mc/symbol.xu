@xu/mc
// Labels and symbol tables for machine code emission.
//
// Layer 4A module: tracks code/data label offsets and unresolved references.

pub struct Label {
    pub id int
    pub name string
    pub offset int
    pub is_defined bool
}

// slots is an open-addressing index over labels by name: label id + 1, or
// 0 for an empty slot; its length is a power of two at least twice the
// label count. hashes[id] caches name_hash of label id.
pub struct SymbolTable {
    pub labels []Label
    slots []int
    hashes []int
}

pub fn symbol_table_new() SymbolTable {
    $slots := []int{}
    for i in 0:64 {
        slots.push(0)
    }
    << SymbolTable{ labels: []Label{}, slots: slots, hashes: []int{} }
}

fn name_hash(s &string) int {
    $h := 5381
    for i in 0:s.len {
        h = (h * 33 + s[i]) & 0x3fffffff
    }
    << h
}

// Slot holding name (with hash h), or the empty slot where it would be inserted.
fn (s &SymbolTable) find_slot_h(name &string, h int) int {
    mask := s.slots.len - 1
    $i := h & mask
    while s.slots[i] != 0 {
        id := s.slots[i] - 1
        if s.hashes[id] == h && s.labels[id].name == *name {
            << i
        }
        i = (i + 1) & mask
    }
    << i
}

fn (s &SymbolTable) find_slot(name &string) int {
    << s.find_slot_h(name, name_hash(name))
}

fn (s $&SymbolTable) grow() {
    $n := s.slots.len * 2
    $slots := []int{}
    for i in 0:n {
        slots.push(0)
    }
    mask := n - 1
    for id in 0:s.labels.len {
        $i := s.hashes[id] & mask
        while slots[i] != 0 {
            i = (i + 1) & mask
        }
        slots[i] = id + 1
    }
    s.slots = slots
}

fn (s $&SymbolTable) add_h(name string, h int, offset int, defined bool) int {
    if (s.labels.len + 1) * 2 > s.slots.len {
        s.grow()
    }
    id := s.labels.len
    s.labels.push(Label{
        id: id,
        name: ~name,
        offset: offset,
        is_defined: defined
    })
    s.hashes.push(h)
    s.slots[s.find_slot_h(&name, h)] = id + 1
    << id
}

fn (s $&SymbolTable) add(name string, offset int, defined bool) int {
    h := name_hash(&name)
    << s.add_h(name, h, offset, defined)
}

pub fn (s $&SymbolTable) define_label(name string, offset int) int {
    h := name_hash(&name)
    slot := s.find_slot_h(&name, h)
    if s.slots[slot] != 0 {
        i := s.slots[slot] - 1
        s.labels[i].offset = offset
        s.labels[i].is_defined = true
        << i
    }
    << s.add_h(name, h, offset, true)
}

pub fn (s $&SymbolTable) get_or_create_label(name string) int {
    h := name_hash(&name)
    slot := s.find_slot_h(&name, h)
    if s.slots[slot] != 0 {
        << s.slots[slot] - 1
    }
    << s.add_h(name, h, -1, false)
}
pub fn (s &SymbolTable) lookup_offset(name string) int {
    slot := s.find_slot(&name)
    if s.slots[slot] == 0 {
        << -1
    }
    i := s.slots[slot] - 1
    if s.labels[i].is_defined {
        << s.labels[i].offset
    }
    << -1
}
