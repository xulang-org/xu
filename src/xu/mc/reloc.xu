@xu/mc
// Machine code relocations and fixups.
//
// Layer 4A module: encapsulates relocations applied during emission or linking.

pub const RELOC_NONE = 0
pub const RELOC_ARM64_CALL26 = 1
pub const RELOC_ARM64_COND_BR19 = 2
pub const RELOC_ARM64_ADR_PAGE21 = 3
pub const RELOC_ARM64_ADD_LO12 = 4
pub const RELOC_ARM64_LDR_LO12 = 5
pub const RELOC_X64_PC32 = 6
pub const RELOC_X64_PLT32 = 7
pub const RELOC_ABS64 = 8
pub const RELOC_ABS32 = 9
// RISC-V auipc at offset, then a jalr (CALL) or addi (PCREL) taking the
// low 12 bits: together they reach target + addend from the auipc.
pub const RELOC_RISCV_CALL = 10
pub const RELOC_RISCV_PCREL = 11
// LoongArch pcaddu12i at offset, then a jirl (CALL, offs16 in words) or
// addi.d (PCREL) taking the low 12 bits.
pub const RELOC_LOONG_CALL = 12
pub const RELOC_LOONG_PCREL = 13

pub struct Reloc {
    pub offset int
    pub symbol_name string
    pub kind int
    pub addend int
}

pub fn reloc_new(offset int, symbol_name string, kind int, addend int) Reloc {
    << Reloc{
        offset: offset,
        symbol_name: ~symbol_name,
        kind: kind,
        addend: addend
    }
}

pub fn apply_reloc(buf $&CodeBuffer, r &Reloc, target_offset int) bool {
    pc := r.offset
    if r.kind == RELOC_ARM64_CALL26 {
        disp := (target_offset + r.addend - pc) / 4
        if pc + 4 <= buf.bytes.len {
            op := buf.bytes[pc] | (buf.bytes[pc + 1] << 8) | (buf.bytes[pc + 2] << 16) | (buf.bytes[pc + 3] << 24)
            patched := (op & 0xfc000000) | (disp & 0x03ffffff)
            buf.patch_u32_le(pc, patched)
            << true
        }
    } else if r.kind == RELOC_ARM64_COND_BR19 {
        disp := (target_offset + r.addend - pc) / 4
        if pc + 4 <= buf.bytes.len {
            op := buf.bytes[pc] | (buf.bytes[pc + 1] << 8) | (buf.bytes[pc + 2] << 16) | (buf.bytes[pc + 3] << 24)
            patched := (op & 0xff00001f) | ((disp & 0x0007ffff) << 5)
            buf.patch_u32_le(pc, patched)
            << true
        }
    } else if r.kind == RELOC_X64_PC32 {
        disp := target_offset + r.addend - (pc + 4)
        buf.patch_u32_le(pc, disp)
        << true
    } else if r.kind == RELOC_ABS64 {
        buf.patch_u64_le(pc, target_offset + r.addend)
        << true
    } else if r.kind == RELOC_ABS32 {
        buf.patch_u32_le(pc, target_offset + r.addend)
        << true
    } else if r.kind == RELOC_RISCV_CALL || r.kind == RELOC_RISCV_PCREL {
        if pc + 8 <= buf.bytes.len {
            disp := target_offset + r.addend - pc
            hi := (disp + 0x800) >> 12
            lo := disp - (hi << 12)
            auipc := buf.bytes[pc] | (buf.bytes[pc + 1] << 8) | (buf.bytes[pc + 2] << 16) | (buf.bytes[pc + 3] << 24)
            buf.patch_u32_le(pc, (auipc & 0xfff) | ((hi & 0xfffff) << 12))
            low := buf.bytes[pc + 4] | (buf.bytes[pc + 5] << 8) | (buf.bytes[pc + 6] << 16) | (buf.bytes[pc + 7] << 24)
            buf.patch_u32_le(pc + 4, (low & 0xfffff) | ((lo & 0xfff) << 20))
            << true
        }
    } else if r.kind == RELOC_LOONG_CALL || r.kind == RELOC_LOONG_PCREL {
        if pc + 8 <= buf.bytes.len {
            disp := target_offset + r.addend - pc
            hi := (disp + 0x800) >> 12
            lo := disp - (hi << 12)
            pcadd := buf.bytes[pc] | (buf.bytes[pc + 1] << 8) | (buf.bytes[pc + 2] << 16) | (buf.bytes[pc + 3] << 24)
            buf.patch_u32_le(pc, (pcadd & 0xfe00001f) | ((hi & 0xfffff) << 5))
            low := buf.bytes[pc + 4] | (buf.bytes[pc + 5] << 8) | (buf.bytes[pc + 6] << 16) | (buf.bytes[pc + 7] << 24)
            if r.kind == RELOC_LOONG_CALL {
                buf.patch_u32_le(pc + 4, (low & 0xfc0003ff) | (((lo >> 2) & 0xffff) << 10))
            } else {
                buf.patch_u32_le(pc + 4, (low & 0xffc003ff) | ((lo & 0xfff) << 10))
            }
            << true
        }
    }
    << false
}
