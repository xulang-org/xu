@xu/ds

// Growable string builder for compiler name mangling, map keys, and labels.
// Backed by the runtime push_str path; byte-wise writers stage into `pend`
// and flush on write_str/finish or when the stage fills.
pub struct StrBuf {
    buf string
    pend []int
}

pub fn new_strbuf(cap int) StrBuf {
    << StrBuf{buf: "", pend: []int{}}
}

pub fn (sb $&StrBuf) flush() {
    if sb.pend.len > 0 {
        chunk := string_from_bytes(sb.pend)
        sb.pend = []int{}
        r := $&sb.buf
        r.push_str(chunk)
    }
}

pub fn (sb $&StrBuf) write_byte(c int) {
    sb.pend.push(c & 255)
    if sb.pend.len >= 64 {
        sb.flush()
    }
}

pub fn (sb $&StrBuf) write_str(s string) {
    sb.flush()
    r := $&sb.buf
    r.push_str(s)
}

pub fn (sb $&StrBuf) finish() string {
    sb.flush()
    << ~sb.buf
}
