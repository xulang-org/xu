@xu/rtgen
// Runtime glue and built-in routine code generation.
//
// Layer 4E module: synthesizes runtime routines (memory copy, string operations,
// atomic primitives, OS syscall trampolines) into machine code buffers.

#xu/mc
#xu/target

pub const RUNTIME_ABI_SYMBOLS = "_rt_alloc _rt_free _rt_heap_stats _rt_heap_record_alloc _rt_heap_record_free _rt_str_concat _rt_push_str _rt_str_clone _rt_str_slice _rt_str_eq _rt_arr_push _rt_arr_grow _rt_array_slice _rt_array_slice_str _rt_chan_new _rt_chan_send _rt_chan_recv _rt_chan_close _rt_chan_try_send _rt_chan_try_recv _rt_xu _rt_g_start _rt_gogo _rt_park_until"

pub struct RuntimeConfig {
    pub target target.Target
    pub has_atomic bool
    pub has_threads bool
}

pub fn runtime_config_new(t &target.Target) RuntimeConfig {
    << RuntimeConfig{
        target: ~t,
        has_atomic: true,
        has_threads: true
    }
}

fn hex_nibble(c int) int {
    if c >= 48 && c <= 57 { << c - 48 }
    if c >= 97 && c <= 102 { << c - 87 }
    if c >= 65 && c <= 70 { << c - 55 }
    << 0
}

fn emit_hex(cb $&mc.CodeBuffer, hex_str string) {
    $i := 0
    while i < hex_str.len {
        c := hex_str[i]
        if c == 32 || c == 10 || c == 13 || c == 9 {
            i += 1
            ->
        }
        if i + 1 < hex_str.len {
            hi := hex_nibble(hex_str[i])
            lo := hex_nibble(hex_str[i + 1])
            cb.emit_u8(hi * 16 + lo)
            i += 2
        } else {
            i += 1
        }
    }
}

pub fn emit_arm64_println_str(cb $&mc.CodeBuffer) {
    // macOS ARM64 string println (writes null-terminated string to stdout + newline)
    emit_hex(cb, "fd7bbda9fd030091e10300aa020080d2236862386300003442040091fdffff17200080d2900080d2011000d443018052e3830039200080d2e1830091220080d2900080d2011000d4fd7bc3a8c0035fd6")
}

pub fn emit_arm64_println_int(cb $&mc.CodeBuffer) {
    // macOS ARM64 64-bit signed integer println (itoa to stack + newline to stdout)
    emit_hex(cb, "fd7bbda9fd030091e1bf00914201805222000039290080d2c00000b502068052210400d12200003929050091140000140a0080d21f0000f16a0000542a0080d2e00300cb4b0180d20c08cb9a8d810b9badc10011210400d12d00003929050091e0030caa00ffffb5aa0000b4a2058052210400d12200003929050091200080d2e20309aa900080d2011000d4fd7bc3a8c0035fd6")
}

pub fn emit_arm64_println(cb $&mc.CodeBuffer) {
    // macOS ARM64 smart dual-mode println (handles both pointers >=0x100000000 and integers <0x100000000)
    emit_hex(cb, "")
}

pub fn emit_x64_println(cb $&mc.CodeBuffer) {
    // Linux x86-64 itoa + syscall 1 (sys_write)
    emit_hex(cb, "554889e54883ec30c644242f0a48c7c1010000004885ff7513c644242e3048c7c102000000488d74242eeb444531c04883ff007d0941b80100000048f7df4889f849c7c10a000000488d74242f31d249f7f180c23048ffce881648ffc14885c075eb4585c0740948ffcec6062d48ffc148c7c00100000048c7c7010000004889ca0f05c9c3")
}

pub fn emit_builtin_println(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_println_int") < 0 {
        syms.define_label("_println_int", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_arm64_println_int(cb)
        } else {
            emit_x64_println(cb)
        }
    }
    if syms.lookup_offset("_println_str") < 0 {
        syms.define_label("_println_str", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_arm64_println_str(cb)
        } else {
            emit_x64_println(cb)
        }
    }
    if syms.lookup_offset("_println") < 0 {
        syms.define_label("_println", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_arm64_println(cb)
        } else {
            emit_x64_println(cb)
        }
    }
}

pub fn emit_builtin_slice_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_xu_slice_push") >= 0 {
        <<
    }
    if t.arch == target.ARCH_ARM64 {
        alloc_off := cb.len()
        syms.define_label("_xu_alloc", alloc_off)
        // 52 bytes: _xu_alloc via mmap (aligned to 16KB)
        emit_hex(cb, "e1ff87d20100018b21fc4ed321c472d3000080d2620080d2430082d204008092050080d2b01880d21040a0f2011000d4c0035fd6")

        push_off := cb.len()
        syms.define_label("_xu_slice_push", push_off)
        // 164 bytes: _xu_slice_push with auto-growth and 2x exponential scaling
        emit_hex(cb, "")
    }
}

pub fn emit_builtin_tile_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_xu_tile_gemm_i64") >= 0 {
        <<
    }
    if t.arch == target.ARCH_ARM64 {
        gemm_off := cb.len()
        syms.define_label("_xu_tile_gemm_i64", gemm_off)
        // 808 bytes: 4x2 register-blocked + Kc=64 L1D cache tiled GEMM micro-kernel
        emit_hex(cb, "")
    }
}

pub fn emit_arm64_eprintln(cb $&mc.CodeBuffer) {
    // macOS ARM64 write syscall to stderr (fd 2)
    emit_hex(cb, "fd7bbda9fd030091e1bf00914201805222000039290080d2c00000b502068052210400d12200003929050091140000140a0080d21f0000f16a0000542a0080d2e00300cb4b0180d20c08cb9a8d810b9badc10011210400d12d00003929050091e0030caa20ffffb5aa0000b4a2058052210400d12200003929050091400080d2e20309aa900080d2011000d4fd7bc3a8c0035fd6")
}

pub fn emit_x64_eprintln(cb $&mc.CodeBuffer) {
    // Linux x86-64 syscall 1 (sys_write) to stderr (fd 2)
    emit_hex(cb, "554889e54883ec30c644242f0a48c7c1010000004885ff7513c644242e3048c7c102000000488d74242eeb444531c04883ff007d0941b80100000048f7df4889f849c7c10a000000488d74242f31d249f7f180c23048ffce881648ffc14885c075eb4585c0740948ffcec6062d48ffc148c7c00100000048c7c7020000004889ca0f05c9c3")
}

pub fn emit_builtin_eprintln(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_eprintln") >= 0 {
        <<
    }
    syms.define_label("_eprintln", cb.len())
    if t.arch == target.ARCH_ARM64 {
        emit_arm64_eprintln(cb)
    } else {
        emit_x64_eprintln(cb)
    }
}

pub fn emit_builtin_string_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_string_from_bytes") < 0 {
        syms.define_label("_string_from_bytes", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000040f9c0035fd6")
        } else {
            emit_hex(cb, "488b07c3")
        }
    }

    if syms.lookup_offset("_string_from_byte") < 0 {
        syms.define_label("_string_from_byte", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "ff4300d1e0030039ff070039e0030091ff430091c0035fd6")
        } else {
            emit_hex(cb, "4883ec10883c24c6442401004889e04883c410c3")
        }
    }

    if syms.lookup_offset("_str") < 0 {
        syms.define_label("_str", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "fd7bbda9fd030091e1bf00913f000039c00000b502068052210400d122000039e00301aa120000140a0080d21f0000f16a0000542a0080d2e00300cb4b0180d20c08cb9a8d810b9badc10011210400d12d000039e0030caa20ffffb5aa0000b4a2058052210400d122000039e00301aafd7bc3a8c0035fd6")
        } else {
            emit_hex(cb, "554889e54883ec30c644242f00488d74242f4885ff750ec644242e3048ffcee800000000eb3a4531c04883ff007d0941b80100000048f7df4889f849c7c10a000000488d74242f31d249f7f180c23048ffce88164885c075ef4585c0740648ffcec6062d4889f0c9c3")
        }
    }

    if syms.lookup_offset("_push_str") < 0 {
        syms.define_label("_push_str", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "c0035fd6")
        } else {
            emit_hex(cb, "c3")
        }
    }

    if syms.lookup_offset("_xu_str_eq") < 0 {
        syms.define_label("_xu_str_eq", cb.len())
        if t.arch == target.ARCH_ARM64 {
            // Smart pointer/string/scalar equality: handles scalars, identical pointers, and strcmp
            emit_hex(cb, "1f0001eba00100540200a2d21f0002eb830100543f0002eb43010054e90300aaea0301aa22154038431540385f00036b8100005482ffff35200080d2c0035fd6000080d2c0035fd6")
        } else {
            emit_hex(cb, "4839f7740e4881ff00000010720b4881fe000000107203eb0431c0c3b801000000c3")
        }
    }
}

// Command-line argument parser shared by the `_args` and `_sys_args` entries.
fn emit_args_body(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if t.arch == target.ARCH_ARM64 {
        // Dynamic command-line argument parser:
        // buf[0] = argc
        // buf[i] = argv[i] (raw string pointer)
        // returns buf pointer in X0
        emit_hex(cb, "fd7bbda9f35301a9f55b02a9fd030091f30300aaf40301aa7f0200f16c000054330080d2140080d2002080d2")
        alloc_off := syms.lookup_offset("_xu_alloc")
        if alloc_off >= 0 {
            delta := (alloc_off - cb.len()) / 4
            target.arm64_bl(cb, delta)
        } else {
            target.arm64_bl(cb, 0)
        }
        emit_hex(cb, "f50300aab30200f9360080d2df0213eb0c010054940000b4807a76f8a07a36f802000014bf7a36f8d6060091f8ffffffbf7a36f8e00315aaf55b42a9f35341a9fd7bc3a8c0035fd6")
    } else {
        emit_hex(cb, "4831c0c3")
    }
}

// Emit a compile-time integer constant as a function returning that value.
//
// ARM64: mov x0, #imm16 ; ret
// x64:   mov rax, imm32 (sign extended) ; ret
fn emit_target_constant(cb $&mc.CodeBuffer, value int, t &target.Target) {
    if t.arch == target.ARCH_ARM64 {
        cb.emit_u32_le(0xd2800000 + (value << 5))
        cb.emit_u32_le(0xd65f03c0)
    } else {
        cb.emit_u8(0x48)
        cb.emit_u8(0xc7)
        cb.emit_u8(0xc0)
        cb.emit_u32_le(value)
        cb.emit_u8(0xc3)
    }
}

// xu_target_os() resolves to the operating system this binary was compiled
// for. It is the compile-time half of host detection: the compiler is built
// once per platform, so the constant it embeds is that platform's OS.
pub fn emit_builtin_target_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_xu_target_os") < 0 {
        syms.define_label("_xu_target_os", cb.len())
        emit_target_constant(cb, t.os, t)
    }
}

pub fn emit_builtin_os_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_now_ns") < 0 {
        syms.define_label("_now_ns", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "40e03bd5c0035fd6")
        } else {
            emit_hex(cb, "0f3148c1e2204809d0c3")
        }
    }

    if syms.lookup_offset("_getpid") < 0 {
        syms.define_label("_getpid", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "900280d2011000d4c0035fd6")
        } else {
            emit_hex(cb, "48c7c0270000000f05c3")
        }
    }

    if syms.lookup_offset("_chmod") < 0 {
        syms.define_label("_chmod", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "f00180d2011000d4c0035fd6")
        } else {
            emit_hex(cb, "48c7c05a0000000f05c3")
        }
    }

    if syms.lookup_offset("_getenv") < 0 {
        syms.define_label("_getenv", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_args") < 0 {
        syms.define_label("_args", cb.len())
        emit_args_body(cb, syms, t)
    }

    // The `os` module spells the same builtin `sys_args`; the private spelling
    // is the one the compiler lowers, so it needs its own entry point.
    if syms.lookup_offset("_sys_args") < 0 {
        syms.define_label("_sys_args", cb.len())
        emit_args_body(cb, syms, t)
    }

    if syms.lookup_offset("_command") < 0 {
        syms.define_label("_command", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_home_dir") < 0 {
        syms.define_label("_home_dir", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }
}
