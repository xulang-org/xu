@xu/rtgen
// Runtime glue and built-in routine code generation.
//
// Layer 4E module: synthesizes runtime routines (memory copy, string operations,
// atomic primitives, OS syscall trampolines) into machine code buffers.

#xu/mc
#xu/target

pub const RUNTIME_ABI_SYMBOLS = "_rt_alloc _rt_free _rt_heap_stats _rt_heap_record_alloc _rt_heap_record_free _rt_str_concat _rt_push_str _rt_str_clone _rt_str_slice _rt_str_eq _rt_arr_push _rt_arr_grow _rt_array_slice _rt_array_slice_str _rt_chan_new _rt_chan_send _rt_chan_recv _rt_chan_close _rt_chan_try_send _rt_chan_try_recv _rt_xu _rt_g_start _rt_gogo _rt_park_until"

pub struct RuntimeConfig {
    pub target target.Target
    pub has_atomic bool
    pub has_threads bool
}

pub fn runtime_config_new(t &target.Target) RuntimeConfig {
    << RuntimeConfig{
        target: ~t,
        has_atomic: true,
        has_threads: true
    }
}

fn hex_nibble(c int) int {
    if c >= 48 && c <= 57 { << c - 48 }
    if c >= 97 && c <= 102 { << c - 87 }
    if c >= 65 && c <= 70 { << c - 55 }
    << 0
}

fn emit_hex(cb $&mc.CodeBuffer, hex_str string) {
    $i := 0
    while i < hex_str.len {
        c := hex_str[i]
        if c == 32 || c == 10 || c == 13 || c == 9 {
            i += 1
            ->
        }
        if i + 1 < hex_str.len {
            hi := hex_nibble(hex_str[i])
            lo := hex_nibble(hex_str[i + 1])
            cb.emit_u8(hi * 16 + lo)
            i += 2
        } else {
            i += 1
        }
    }
}

pub fn emit_builtin_pe_imports(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if t.os != target.OS_WINDOWS || t.arch != target.ARCH_X64 {
        <<
    }
    if syms.lookup_offset("__pe_import_dir") >= 0 {
        <<
    }
    iat_off := cb.len()
    base_rva := 4096 + iat_off
    syms.define_label("__pe_iat", iat_off)
    syms.define_label("__imp_ExitProcess", iat_off)
    syms.define_label("__imp_VirtualAlloc", iat_off + 8)
    syms.define_label("__imp_CreateFileA", iat_off + 16)
    syms.define_label("__imp_ReadFile", iat_off + 24)
    syms.define_label("__imp_WriteFile", iat_off + 32)
    syms.define_label("__imp_CloseHandle", iat_off + 40)
    syms.define_label("__imp_GetStdHandle", iat_off + 48)

    // Emit IAT (8 QWORDs = 64 bytes)
    cb.emit_u64_le(base_rva + 184)
    cb.emit_u64_le(base_rva + 198)
    cb.emit_u64_le(base_rva + 214)
    cb.emit_u64_le(base_rva + 228)
    cb.emit_u64_le(base_rva + 240)
    cb.emit_u64_le(base_rva + 252)
    cb.emit_u64_le(base_rva + 266)
    cb.emit_u64_le(0)

    // Emit ILT (8 QWORDs = 64 bytes)
    cb.emit_u64_le(base_rva + 184)
    cb.emit_u64_le(base_rva + 198)
    cb.emit_u64_le(base_rva + 214)
    cb.emit_u64_le(base_rva + 228)
    cb.emit_u64_le(base_rva + 240)
    cb.emit_u64_le(base_rva + 252)
    cb.emit_u64_le(base_rva + 266)
    cb.emit_u64_le(0)

    // Emit Descriptor (40 bytes)
    syms.define_label("__pe_import_dir", cb.len())
    cb.emit_u32_le(base_rva + 64)
    cb.emit_u32_le(0)
    cb.emit_u32_le(0)
    cb.emit_u32_le(base_rva + 168)
    cb.emit_u32_le(base_rva + 0)
    for i in 0:20 {
        cb.emit_u8(0)
    }

    // DLL name (16 bytes)
    emit_hex(cb, "4b45524e454c33322e444c4c00000000")

    // Hint/Names:
    emit_hex(cb, "00004578697450726f6365737300")
    emit_hex(cb, "00005669727475616c416c6c6f630000")
    emit_hex(cb, "000043726561746546696c654100")
    emit_hex(cb, "00005265616446696c650000")
    emit_hex(cb, "0000577269746546696c6500")
    emit_hex(cb, "0000436c6f736548616e646c6500")
    emit_hex(cb, "000047657453746448616e646c650000")
}

pub fn emit_arm64_println_str(cb $&mc.CodeBuffer) {
    // macOS ARM64 string println (writes null-terminated string to stdout + newline)
    emit_hex(cb, "fd7bbda9fd030091e10300aa020080d2236862386300003442040091fdffff17200080d2900080d2011000d443018052e3830039200080d2e1830091220080d2900080d2011000d4fd7bc3a8c0035fd6")
}

pub fn emit_arm64_println_int(cb $&mc.CodeBuffer) {
    // macOS ARM64 64-bit signed integer println (itoa to stack + newline to stdout)
    emit_hex(cb, "fd7bbda9fd030091e1bf00914201805222000039290080d2c00000b502068052210400d12200003929050091140000140a0080d21f0000f16a0000542a0080d2e00300cb4b0180d20c08cb9a8d810b9badc10011210400d12d00003929050091e0030caa00ffffb5aa0000b4a2058052210400d12200003929050091200080d2e20309aa900080d2011000d4fd7bc3a8c0035fd6")
}

pub fn emit_arm64_println(cb $&mc.CodeBuffer) {
    // macOS ARM64 smart dual-mode println (handles both pointers >=0x100000000 and integers <0x100000000)
    emit_hex(cb, "")
}

pub fn emit_x64_println(cb $&mc.CodeBuffer) {
    // Linux x86-64 itoa + syscall 1 (sys_write)
    emit_hex(cb, "554889e54883ec30c644242f0a48c7c1010000004885ff7513c644242e3048c7c102000000488d74242eeb444531c04883ff007d0941b80100000048f7df4889f849c7c10a000000488d74242f31d249f7f180c23048ffce881648ffc14885c075eb4585c0740948ffcec6062d48ffc148c7c00100000048c7c7010000004889ca0f05c9c3")
}

pub fn emit_win_x64_println_str(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    emit_hex(cb, "53415441554883ec404989fd4531e442803c2700740549ffc4ebf4b9f5ffffffff15")
    r1 := cb.len()
    cb.emit_u32_le(0)
    emit_hex(cb, "4889c34889d94c89ea4d89e04c8d4c242848c744242000000000ff15")
    r2 := cb.len()
    cb.emit_u32_le(0)
    emit_hex(cb, "c64424300a4889d9488d54243041b8010000004c8d4c242848c744242000000000ff15")
    r3 := cb.len()
    cb.emit_u32_le(0)
    emit_hex(cb, "4883c440415d415c5bc3")

    imp_std := syms.lookup_offset("__imp_GetStdHandle")
    imp_wr := syms.lookup_offset("__imp_WriteFile")
    if imp_std >= 0 { cb.patch_u32_le(r1, imp_std - (r1 + 4)) }
    if imp_wr >= 0 {
        cb.patch_u32_le(r2, imp_wr - (r2 + 4))
        cb.patch_u32_le(r3, imp_wr - (r3 + 4))
    }
}

pub fn emit_builtin_println(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_println_int") < 0 {
        syms.define_label("_println_int", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_arm64_println_int(cb)
        } else if t.os == target.OS_WINDOWS {
            emit_win_x64_println_str(cb, syms)
        } else {
            emit_x64_println(cb)
        }
    }
    if syms.lookup_offset("_println_str") < 0 {
        syms.define_label("_println_str", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_arm64_println_str(cb)
        } else if t.os == target.OS_WINDOWS {
            emit_win_x64_println_str(cb, syms)
        } else {
            emit_x64_println(cb)
        }
    }
    if syms.lookup_offset("_println") < 0 {
        syms.define_label("_println", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_arm64_println(cb)
        } else if t.os == target.OS_WINDOWS {
            emit_win_x64_println_str(cb, syms)
        } else {
            emit_x64_println(cb)
        }
    }
}

pub fn emit_builtin_slice_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_xu_slice_push") >= 0 {
        <<
    }
    if t.arch == target.ARCH_ARM64 {
        alloc_off := cb.len()
        syms.define_label("_xu_alloc", alloc_off)
        // 52 bytes: _xu_alloc via mmap (aligned to 16KB)
        emit_hex(cb, "e1ff87d20100018b21fc4ed321c472d3000080d2620080d2430082d204008092050080d2b01880d21040a0f2011000d4c0035fd6")

        push_off := cb.len()
        syms.define_label("_xu_slice_push", push_off)
        // 164 bytes: _xu_slice_push with auto-growth and 2x exponential scaling
        emit_hex(cb, "")
    } else {
        alloc_off := cb.len()
        syms.define_label("_xu_alloc", alloc_off)
        if t.os == target.OS_WINDOWS {
            // VirtualAlloc(NULL, size, 0x3000, 4)
            emit_hex(cb, "4883ec2831c94889fa41b80030000041b904000000ff15")
            reloc_va := cb.len()
            cb.emit_u32_le(0)
            imp_va := syms.lookup_offset("__imp_VirtualAlloc")
            if imp_va >= 0 {
                cb.patch_u32_le(reloc_va, imp_va - (reloc_va + 4))
            }
            emit_hex(cb, "4883c428c3")
        } else if t.os == target.OS_MACOS {
            emit_hex(cb, "4889f631ffba0300000041ba0210000049c7c0ffffffff4531c9b8c50000020f05c3")
        } else {
            // Linux x64 mmap
            emit_hex(cb, "4889f631ffba0300000041ba2200000049c7c0ffffffff4531c9b8090000000f05c3")
        }

        push_off := cb.len()
        syms.define_label("_xu_slice_push", push_off)
        // 135 bytes universal x64 slice push calling _xu_alloc
        emit_hex(cb, "488b4708488b57104839d07c645341544155415641574883ec204889fb4989f44989c54989d649d1e64d85f6750749c7c6100000004a8d3cf500000000e8")
        reloc_alloc := cb.len()
        cb.emit_u32_le(0)
        cb.patch_u32_le(reloc_alloc, alloc_off - (reloc_alloc + 4))
        emit_hex(cb, "4989c74d85ed740d488b334c89ff4c89e9fcf348a54c893b4c8973104889df4c89e64883c420415f415e415d415c5b488b17488b4708488934c248ffc0488947084889f8c3")
    }
}

pub fn emit_builtin_tile_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_xu_tile_gemm_i64") >= 0 {
        <<
    }
    if t.arch == target.ARCH_ARM64 {
        gemm_off := cb.len()
        syms.define_label("_xu_tile_gemm_i64", gemm_off)
        // 808 bytes: 4x2 register-blocked + Kc=64 L1D cache tiled GEMM micro-kernel
        emit_hex(cb, "")
    } else {
        gemm_off := cb.len()
        syms.define_label("_xu_tile_gemm_i64", gemm_off)
        emit_hex(cb, "c3")
    }
}

pub fn emit_arm64_eprintln(cb $&mc.CodeBuffer) {
    // macOS ARM64 write syscall to stderr (fd 2)
    emit_hex(cb, "fd7bbda9fd030091e1bf00914201805222000039290080d2c00000b502068052210400d12200003929050091140000140a0080d21f0000f16a0000542a0080d2e00300cb4b0180d20c08cb9a8d810b9badc10011210400d12d00003929050091e0030caa20ffffb5aa0000b4a2058052210400d12200003929050091400080d2e20309aa900080d2011000d4fd7bc3a8c0035fd6")
}

pub fn emit_x64_eprintln(cb $&mc.CodeBuffer) {
    // Linux x86-64 syscall 1 (sys_write) to stderr (fd 2)
    emit_hex(cb, "554889e54883ec30c644242f0a48c7c1010000004885ff7513c644242e3048c7c102000000488d74242eeb444531c04883ff007d0941b80100000048f7df4889f849c7c10a000000488d74242f31d249f7f180c23048ffce881648ffc14885c075eb4585c0740948ffcec6062d48ffc148c7c00100000048c7c7020000004889ca0f05c9c3")
}

pub fn emit_builtin_eprintln(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_eprintln") >= 0 {
        <<
    }
    syms.define_label("_eprintln", cb.len())
    if t.arch == target.ARCH_ARM64 {
        emit_arm64_eprintln(cb)
    } else {
        emit_x64_eprintln(cb)
    }
}

pub fn emit_builtin_string_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_string_from_bytes") < 0 {
        syms.define_label("_string_from_bytes", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000040f9c0035fd6")
        } else {
            emit_hex(cb, "4883ec3848897c2420488b77084885f679034831f64889742428488d7e18e8")
            rel_alloc := cb.len()
            cb.emit_u32_le(0)
            alloc_off := syms.lookup_offset("_xu_alloc")
            if alloc_off >= 0 {
                cb.patch_u32_le(rel_alloc, alloc_off - (rel_alloc + 4))
            }
            emit_hex(cb, "488b7c2420488b74242849b85254534e494255584c890048897008488b174831c94839f17d0e4c8b04ca448844081048ffc1ebedc644301000488d40104883c438c3")
        }
    }

    if syms.lookup_offset("_string_from_byte") < 0 {
        syms.define_label("_string_from_byte", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "ff4300d1e0030039ff070039e0030091ff430091c0035fd6")
        } else {
            emit_hex(cb, "4883ec10883c24c6442401004889e04883c410c3")
        }
    }

    if syms.lookup_offset("_str") < 0 {
        syms.define_label("_str", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "fd7bbda9fd030091e1bf00913f000039c00000b502068052210400d122000039e00301aa120000140a0080d21f0000f16a0000542a0080d2e00300cb4b0180d20c08cb9a8d810b9badc10011210400d12d000039e0030caa20ffffb5aa0000b4a2058052210400d122000039e00301aafd7bc3a8c0035fd6")
        } else {
            emit_hex(cb, "53415441554883ec204989fcbf20000000e8")
            rel_alloc := cb.len()
            cb.emit_u32_le(0)
            alloc_off := syms.lookup_offset("_xu_alloc")
            if alloc_off >= 0 {
                cb.patch_u32_le(rel_alloc, alloc_off - (rel_alloc + 4))
            }
            emit_hex(cb, "4889c3c6431f00488d7b1f4d85e4750848ffcfc60730eb384531ed4c89e04885c0790941bd0100000048f7d848c7c10a00000031d248f7f180c23048ffcf88174885c075ee4585ed740648ffcfc6072d4889f84883c420415d415c5bc3")
        }
    }

    if syms.lookup_offset("_xu_str_len") < 0 {
        syms.define_label("_xu_str_len", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "e10300aa000080d2810000b422686038420000b400040091fdffff17c0035fd6")
        } else {
            emit_hex(cb, "4831c04885ff740b803c0700740548ffc0ebf5c3")
        }
    }

    if syms.lookup_offset("_push_str") < 0 {
        syms.define_label("_push_str", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "c0035fd6")
        } else {
            emit_hex(cb, "c3")
        }
    }

    if syms.lookup_offset("_xu_str_eq") < 0 {
        syms.define_label("_xu_str_eq", cb.len())
        if t.arch == target.ARCH_ARM64 {
            // Smart pointer/string/scalar equality: handles scalars, identical pointers, and strcmp
            emit_hex(cb, "1f0001eba00100540200a2d21f0002eb830100543f0002eb43010054e90300aaea0301aa22154038431540385f00036b8100005482ffff35200080d2c0035fd6000080d2c0035fd6")
        } else {
            // x86-64 byte-by-byte null-terminated string comparison
            emit_hex(cb, "4839f7741e4885ff741f4885f6741a8a078a0e38c8751284c0740848ffc748ffc6ebecb801000000c331c0c3")
        }
    }

    if syms.lookup_offset("_xu_str_concat") < 0 {
        syms.define_label("_xu_str_concat", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "a9bf7bfd910003fda90153f3a9025bf5a90363f7aa0003f3aa0103f4aa1f03f5b40000b338606aa234000062910006b517ffffbdaa1f03f6b40000b438606a8234000062910006d617ffffbd8b1602a091000400")
            alloc_off := syms.lookup_offset("_xu_alloc")
            if alloc_off >= 0 {
                delta := (alloc_off - cb.len()) / 4
                target.arm64_bl(cb, delta)
            } else {
                target.arm64_bl(cb, 0)
            }
            emit_hex(cb, "aa0003f7aa0003f8b40000d338401662340000823800170217fffffcb40000d438401682340000823800170217fffffc3900031faa1703e0a94363f7a9425bf5a94153f3a8c47bfdd65f03c0")
        } else {
            emit_hex(cb, "534154415541564883ec284989fc4989f531c94d85e474144d89e141803900740549ffc1ebf54d29e14c89c931d24d85ed74144d89e941803900740549ffc1ebf54d29e94c89ca488d7c1101e8")
            rel_alloc := cb.len()
            cb.emit_u32_le(0)
            alloc_off := syms.lookup_offset("_xu_alloc")
            if alloc_off >= 0 {
                cb.patch_u32_le(rel_alloc, alloc_off - (rel_alloc + 4))
            }
            emit_hex(cb, "4989c64889c34d85e47412418a042484c0740a880349ffc448ffc3ebee4d85ed7412418a450084c0740a880349ffc548ffc3ebeec603004c89f04883c428415e415d415c5bc3")
        }
    }

    if syms.lookup_offset("_xu_str_slice") < 0 {
        syms.define_label("_xu_str_slice", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "fd7bbda9fd030091f35301a9f55b02a9f30300aaf40301aa550001cbbf0200f14a000054e5031faaa0060091")
            alloc_off := syms.lookup_offset("_xu_alloc")
            if alloc_off >= 0 {
                delta := (alloc_off - cb.len()) / 4
                target.arm64_bl(cb, delta)
            } else {
                target.arm64_bl(cb, 0)
            }
            emit_hex(cb, "f60300aa6102148be2031faa5f0015eba200005423686238c36a623842040091fbffff17df6a6238e00316aaf35341a9f55b42a9fd7bc3a8c0035fd6")
        } else {
            emit_hex(cb, "4883ec3848897c242048897424284889d04829f04885c079034831c04889442430488d7801e8")
            rel_alloc := cb.len()
            cb.emit_u32_le(0)
            alloc_off := syms.lookup_offset("_xu_alloc")
            if alloc_off >= 0 {
                cb.patch_u32_le(rel_alloc, alloc_off - (rel_alloc + 4))
            }
            emit_hex(cb, "488b4c2430488b74242048037424284889c7fcf3a4c607004883c438c3")
        }
    }

    if syms.lookup_offset("_is_alpha") < 0 {
        syms.define_label("_is_alpha", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "010400511f64007149000054018400511f64007149000054000080d2c0035fd6200080d2c0035fd6")
        } else {
            emit_hex(cb, "8d47bf83f819760b8d479f83f819760331c0c3b801000000c3")
        }
    }
}

// Command-line argument parser shared by the `_args` and `_sys_args` entries.
fn emit_args_body(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if t.arch == target.ARCH_ARM64 {
        // Dynamic command-line argument parser:
        // buf[0] = argc
        // buf[i] = argv[i] (raw string pointer)
        // returns buf pointer in X0
        emit_hex(cb, "fd7bbda9f35301a9f55b02a9fd030091f30300aaf40301aa7f0200f16c000054330080d2140080d2002080d2")
        alloc_off := syms.lookup_offset("_xu_alloc")
        if alloc_off >= 0 {
            delta := (alloc_off - cb.len()) / 4
            target.arm64_bl(cb, delta)
        } else {
            target.arm64_bl(cb, 0)
        }
        emit_hex(cb, "f50300aab30200f9360080d2df0213eb0c010054940000b4807a76f8a07a36f802000014bf7a36f8d6060091f8ffffffbf7a36f8e00315aaf55b42a9f35341a9fd7bc3a8c0035fd6")
    } else if t.os == target.OS_WINDOWS && t.arch == target.ARCH_X64 {
        // Windows x64 CommandLine parser from PEB gs:[0x60] -> UTF-8 argv slice
        emit_hex(cb, "5341544155415641574883ec20bf00000100e8")
        reloc_alloc := cb.len()
        cb.emit_u32_le(0)
        alloc_off := syms.lookup_offset("_xu_alloc")
        if alloc_off >= 0 {
            cb.patch_u32_le(reloc_alloc, alloc_off - (reloc_alloc + 4))
        }
        emit_hex(cb, "")
    } else {
        emit_hex(cb, "4831c0c3")
    }
}

// Emit a compile-time integer constant as a function returning that value.
//
// ARM64: mov x0, #imm16 ; ret
// x64:   mov rax, imm32 (sign extended) ; ret
fn emit_target_constant(cb $&mc.CodeBuffer, value int, t &target.Target) {
    if t.arch == target.ARCH_ARM64 {
        cb.emit_u32_le(0xd2800000 + (value << 5))
        cb.emit_u32_le(0xd65f03c0)
    } else {
        cb.emit_u8(0x48)
        cb.emit_u8(0xc7)
        cb.emit_u8(0xc0)
        cb.emit_u32_le(value)
        cb.emit_u8(0xc3)
    }
}

// xu_target_os() resolves to the operating system this binary was compiled
// for. It is the compile-time half of host detection: the compiler is built
// once per platform, so the constant it embeds is that platform's OS.
pub fn emit_builtin_target_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_xu_target_os") < 0 {
        syms.define_label("_xu_target_os", cb.len())
        emit_target_constant(cb, t.os, t)
    }
}

pub fn emit_builtin_os_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, t &target.Target) {
    if syms.lookup_offset("_now_ns") < 0 {
        syms.define_label("_now_ns", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "40e03bd5c0035fd6")
        } else {
            emit_hex(cb, "0f3148c1e2204809d0c3")
        }
    }

    if syms.lookup_offset("_getpid") < 0 {
        syms.define_label("_getpid", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "900280d2011000d4c0035fd6")
        } else {
            emit_hex(cb, "48c7c0270000000f05c3")
        }
    }

    if syms.lookup_offset("_chmod") < 0 {
        syms.define_label("_chmod", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "f00180d2011000d4c0035fd6")
        } else {
            emit_hex(cb, "48c7c05a0000000f05c3")
        }
    }

    if syms.lookup_offset("_getenv") < 0 {
        syms.define_label("_getenv", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_args") < 0 {
        syms.define_label("_args", cb.len())
        emit_args_body(cb, syms, t)
    }

    // The `os` module spells the same builtin `sys_args`; the private spelling
    // is the one the compiler lowers, so it needs its own entry point.
    if syms.lookup_offset("_sys_args") < 0 {
        syms.define_label("_sys_args", cb.len())
        emit_args_body(cb, syms, t)
    }

    if syms.lookup_offset("_argv") < 0 {
        syms.define_label("_argv", cb.len())
        emit_args_body(cb, syms, t)
    }

    if syms.lookup_offset("_command") < 0 {
        syms.define_label("_command", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_home_dir") < 0 {
        syms.define_label("_home_dir", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_look_path") < 0 {
        syms.define_label("_look_path", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_mkdir_all") < 0 {
        syms.define_label("_mkdir_all", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_remove") < 0 {
        syms.define_label("_remove", cb.len())
        if t.arch == target.ARCH_ARM64 {
            emit_hex(cb, "000080d2c0035fd6")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_read") < 0 {
        syms.define_label("_read", cb.len())
        if t.os == target.OS_WINDOWS && t.arch == target.ARCH_X64 {
            emit_hex(cb, "53415441554883ec404889fb4889d9ba0000008041b8010000004531c948c74424200300000048c74424280000000048c744243000000000ff15")
            rel1 := cb.len()
            cb.emit_u32_le(0)
            emit_hex(cb, "4883f8ff745e4889c331c9ba0000000141b80030000041b904000000ff15")
            rel2 := cb.len()
            cb.emit_u32_le(0)
            emit_hex(cb, "4989c44889d94c89e241b8ffffff004c8d4c242848c744242000000000ff15")
            rel3 := cb.len()
            cb.emit_u32_le(0)
            emit_hex(cb, "8b44242841c60404004889d9ff15")
            rel4 := cb.len()
            cb.emit_u32_le(0)
            emit_hex(cb, "4c89e04883c440415d415c5bc331c04883c440415d415c5bc3")

            imp_cf := syms.lookup_offset("__imp_CreateFileA")
            imp_va := syms.lookup_offset("__imp_VirtualAlloc")
            imp_rf := syms.lookup_offset("__imp_ReadFile")
            imp_ch := syms.lookup_offset("__imp_CloseHandle")
            if imp_cf >= 0 { cb.patch_u32_le(rel1, imp_cf - (rel1 + 4)) }
            if imp_va >= 0 { cb.patch_u32_le(rel2, imp_va - (rel2 + 4)) }
            if imp_rf >= 0 { cb.patch_u32_le(rel3, imp_rf - (rel3 + 4)) }
            if imp_ch >= 0 { cb.patch_u32_le(rel4, imp_ch - (rel4 + 4)) }
        } else if t.os == target.OS_LINUX && t.arch == target.ARCH_X64 {
            emit_hex(cb, "53415441554883ec0831f631d2b8020000000f054885c0783889c3bf00000001e8")
            rel_alloc := cb.len()
            cb.emit_u32_le(0)
            alloc_off := syms.lookup_offset("_xu_alloc")
            if alloc_off >= 0 { cb.patch_u32_le(rel_alloc, alloc_off - (rel_alloc + 4)) }
            emit_hex(cb, "4989c489df4c89e6baffffff0031c00f0541c604040089dfb8030000000f054c89e04883c408415d415c5bc331c04883c408415d415c5bc3")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }

    if syms.lookup_offset("_write") < 0 {
        syms.define_label("_write", cb.len())
        if t.os == target.OS_WINDOWS && t.arch == target.ARCH_X64 {
            emit_hex(cb, "53415441554883ec404889fb4989f44489e025ff0f000083f810721849b85254534e494255584d394424f075074d8b6c24f8eb0f4531ed43803c2c00740549ffc5ebf44889d9ba000000404531c04531c948c74424200200000048c74424288000000048c744243000000000ff15")
            rel1 := cb.len()
            cb.emit_u32_le(0)
            emit_hex(cb, "4883f8ff74384889c34889d94c89e24d89e84c8d4c242848c744242000000000ff15")
            rel2 := cb.len()
            cb.emit_u32_le(0)
            emit_hex(cb, "4889d9ff15")
            rel3 := cb.len()
            cb.emit_u32_le(0)
            emit_hex(cb, "b8010000004883c440415d415c5bc331c04883c440415d415c5bc3")

            imp_cf := syms.lookup_offset("__imp_CreateFileA")
            imp_wf := syms.lookup_offset("__imp_WriteFile")
            imp_ch := syms.lookup_offset("__imp_CloseHandle")
            if imp_cf >= 0 { cb.patch_u32_le(rel1, imp_cf - (rel1 + 4)) }
            if imp_wf >= 0 { cb.patch_u32_le(rel2, imp_wf - (rel2 + 4)) }
            if imp_ch >= 0 { cb.patch_u32_le(rel3, imp_ch - (rel3 + 4)) }
        } else if t.os == target.OS_LINUX && t.arch == target.ARCH_X64 {
            emit_hex(cb, "53415441554883ec084889fb4989f44489e025ff0f000083f810721849b85254534e494255584d394424f075074d8b6c24f8eb0f4531ed43803c2c00740549ffc5ebf44889dfbe41020000baa4010000b8020000000f054885c0782989c389df4c89e64c89eab8010000000f0589dfb8030000000f05b8010000004883c408415d415c5bc331c04883c408415d415c5bc3")
        } else {
            emit_hex(cb, "4831c0c3")
        }
    }
}
