@xu/ast
// Front-end syntax tree, Go `go/ast` (pool of flat nodes).
//
// Xu has no enums or boxed references, so the tree is a pool of flat
// nodes (every node is an index; children/siblings are indices, -1 = absent).
// Lists (arguments, fields, statements, ...) are singly-linked through
// `next`. This keeps node-count statistics comparable with `xu --dump-stats`.
//
// Package layout (Go `go/ast` counterparts):
//   ast.xu    Token, Node, File          (ast.go types)
//   kind.xu   Tok*/N*/Op* + names        (go/token + kind tables)
//   make.xu   node constructors          (NewIdent and friends)
//   walk.xu   children / inspect         (walk.go)
//   print.xu  debug dump / stats line    (print.go)
//
// Lexer/parser live in `xu/scanner` and `xu/parser`; `xu/types` consumes
// the pool through `xu.parser.Parser.nodes`. Tags are `pub const` in kind.xu.
// Tok* still live here (Go would split them to `go/token`).


pub struct Token {
    pub kind int
    pub line int
    pub col int
    pub ival int
    pub sval string
}

pub struct Node {
    pub kind int
    pub line int
    pub col int
    pub ival int
    pub sval string
    pub sval2 string
    pub a int
    pub b int
    pub c int
    pub d int
    pub e int
    pub next int
}

// a parsed compilation unit (Go `ast.File`). Owns the node pool and the
// top-level declaration list. Parser keeps an equivalent set of fields
// while parsing; `File` is the stable tree for Walk/Print.
pub struct File {
    pub nodes []Node
    pub decls []int
    pub nfn int
    pub nstruct int
    pub niface int
    pub module_id string
    pub imports []string
    pub imp_owner []string
    pub imp_path []string
    pub mod_ids []string
    pub walk_acc []int
}

// Constructors: preferred for compiler sources (clearer than long paths);
// Gen1 also accepts qualified struct literals (`pkg.Type{…}` / `a.b.Type{…}`).

pub fn token(kind int, line int, col int, ival int, sval string) Token {
    << Token{kind: kind, line: line, col: col, ival: ival, sval: sval}
}

// a zeroed node with all links empty; callers fill fields before pushing.
pub fn mknode(kind int, line int, col int) Node {
    << Node{
        kind: kind,
        line: line,
        col: col,
        ival: 0,
        sval: "",
        sval2: "",
        a: -1,
        b: -1,
        c: -1,
        d: -1,
        e: -1,
        next: -1
    }
}

pub fn new_file() File {
    << File{
        nodes: []Node{},
        decls: []int{},
        nfn: 0,
        nstruct: 0,
        niface: 0,
        module_id: "",
        imports: []string{},
        imp_owner: []string{},
        imp_path: []string{},
        mod_ids: []string{},
        walk_acc: []int{}
    }
}

// Field-by-field copy of a pool element (strings cannot move out of arrays).
pub fn (f File) get(i int) Node {
    mut n := mknode(0, 0, 0)
    n.kind = f.nodes[i].kind
    n.line = f.nodes[i].line
    n.col = f.nodes[i].col
    n.ival = f.nodes[i].ival
    // Copy, do not move, pooled string fields.  This is used across the
    // parser/AST module boundary and must leave the source node valid.
    n.sval = f.nodes[i].sval + ""
    n.sval2 = f.nodes[i].sval2 + ""
    n.a = f.nodes[i].a
    n.b = f.nodes[i].b
    n.c = f.nodes[i].c
    n.d = f.nodes[i].d
    n.e = f.nodes[i].e
    n.next = f.nodes[i].next
    << n
}

// Remap child/sibling indices by `off` (used when merging files).
pub fn shift(n Node, off int) Node {
    mut m := n
    if m.a >= 0 { m.a = m.a + off }
    if m.b >= 0 { m.b = m.b + off }
    if m.c >= 0 { m.c = m.c + off }
    // ArmRange stores integer hi in d (not a child index).
    if m.kind != nk_arm_range {
        if m.d >= 0 { m.d = m.d + off }
        if m.e >= 0 { m.e = m.e + off }
    }
    if m.next >= 0 { m.next = m.next + off }
    << m
}

// `pub` on a declaration node is stored in `ival`.
pub fn (n Node) exported() bool {
    << n.ival == 1
}

// ===== Node-counting rules (must match xu --dump-stats) =====
// One pool node per logical AST entity, exactly:
//   - every expression: 1
//   - every statement: 1; an `if` additionally has 1 Branch node per
//     condition branch and 1 for the trailing else (when present)
//   - every match arm: 1; enum payload bindings are extra Ident nodes
//   - function: 1 + 1 per parameter + 1 for the receiver (when present,
//     plus 1 for the receiver's type node) + 1 per type parameter
//   - struct: 1 + 1 per field + 1 per type parameter
//   - enum: 1 + 1 per variant + 1 per payload type annotation + 1 per type parameter
//   - interface: 1 + 1 per method signature
//   - every type annotation: 1 (named-type arguments and ref/array/Result
//     inners count recursively; a TypeParam constraint is a bare string and
//     does NOT count)
//   - struct-init expression: 1 + 1 per initialized field
//   - module-level const: 1 + 1 for the literal initializer
