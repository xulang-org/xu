@xu/ast
// Tree walk (Go `ast.Walk` / `ast.Inspect`).
//
// Xu cannot pass `&mut []int` through conditionals (M2b), so the preorder
// buffer lives on `File.walk_acc`. `inspect` / `inspect_file` fill that
// field; callers read `f.walk_acc` afterwards.


fn (f $&File) walk_list(head int) {
    $i := head
    for g in 0:f.nodes.len {
        if i >= 0 {
            f.walk_pre(i)
            i = f.nodes[i].next
        }
    }
}

fn (f $&File) walk_pre(i int) {
    if i < 0 {
        <<
    }
    f.walk_acc.push(i)
    k := f.nodes[i].kind
    a := f.nodes[i].a
    b := f.nodes[i].b
    c := f.nodes[i].c
    d := f.nodes[i].d
    e := f.nodes[i].e
    if k == NK_CALL { f.walk_list(a) }
    if k == NK_STRUCT_INIT {
        f.walk_list(a)
        f.walk_list(b)
    }
    if k == NK_FIELD { f.walk_pre(a) }
    if k == NK_METHOD_CALL {
        f.walk_pre(a)
        f.walk_list(b)
    }
    if k == NK_TRY { f.walk_pre(a) }
    if k == NK_UNWRAP { f.walk_pre(a) }
    if k == NK_OR_CATCH {
        f.walk_pre(a)
        f.walk_list(c)
    }
    if k == NK_BORROW { f.walk_pre(a) }
    if k == NK_ARRAY_LIT { f.walk_list(a) }
    if k == NK_EMPTY_ARRAY { f.walk_pre(a) }
    if k == NK_INDEX {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_SLICE {
        f.walk_pre(a)
        f.walk_pre(b)
        f.walk_pre(c)
    }
    if k == NK_BIN_OP {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_UN_OP { f.walk_pre(a) }
    if k == NK_S_FIELD { f.walk_pre(a) }
    if k == NK_CAST { f.walk_pre(a) }
    if k == NK_TYPE_IS {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_TYPE_AS {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_LET { f.walk_pre(a) }
    if k == NK_ASSIGN {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_EXPR_STMT { f.walk_pre(a) }
    if k == NK_RETURN { f.walk_pre(a) }
    if k == NK_THROW { f.walk_pre(a) }
    if k == NK_EXIT { f.walk_pre(a) }
    if k == NK_IF { f.walk_list(a) }
    if k == NK_BRANCH {
        f.walk_pre(a)
        f.walk_list(b)
    }
    if k == NK_FOR {
        f.walk_pre(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == NK_FOR_EACH {
        f.walk_pre(a)
        f.walk_list(c)
    }
    if k == NK_MATCH {
        f.walk_pre(a)
        f.walk_list(b)
    }
    if k == NK_ARM_INT { f.walk_list(c) }
    if k == NK_ARM_RANGE { f.walk_list(c) }
    if k == NK_ARM_ELSE { f.walk_list(c) }
    if k == NK_ARM_STR { f.walk_list(c) }
    if k == NK_WHILE {
        f.walk_pre(a)
        f.walk_list(c)
    }
    if k == NK_ARM_ENUM {
        f.walk_list(a)
        f.walk_list(c)
    }
    if k == NK_CHAN_INIT {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_RECV { f.walk_pre(a) }
    if k == NK_XU { f.walk_pre(a) }
    if k == NK_SEND {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_FN {
        f.walk_list(e)
        f.walk_pre(d)
        f.walk_list(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == NK_PARAM { f.walk_pre(a) }
    if k == NK_RECV_DECL { f.walk_pre(a) }
    if k == NK_STRUCT {
        f.walk_list(e)
        f.walk_list(a)
    }
    if k == NK_FIELD_DECL { f.walk_pre(a) }
    if k == NK_INTERFACE { f.walk_list(a) }
    if k == NK_METHOD_SIG {
        f.walk_list(a)
        f.walk_pre(b)
    }
    if k == NK_CONST { f.walk_pre(a) }
    if k == NK_ENUM {
        f.walk_list(e)
        f.walk_list(a)
    }
    if k == NK_IDENT { f.walk_list(a) }
    if k == NT_NAMED { f.walk_list(a) }
    if k == NT_RESULT {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NT_REF { f.walk_pre(a) }
    if k == NT_ARRAY { f.walk_pre(a) }
    if k == NT_CHAN { f.walk_pre(a) }
    if k == NT_MAP {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == NK_MAP_INIT {
        f.walk_pre(a)
        f.walk_pre(b)
        if c >= 0 { f.walk_pre(c) }
    }
    if k == NT_FN {
        f.walk_list(a)
        f.walk_pre(b)
    }
    if k == NT_FN_LIT {
        f.walk_list(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == NK_VARIANT_DECL { f.walk_list(a) }
    if k == NK_SELECT {
        f.walk_list(a)
        f.walk_list(c)
    }
    if k == NK_SEL_SEND {
        f.walk_pre(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == NK_SEL_RECV {
        f.walk_pre(a)
        f.walk_list(c)
    }
}

// Preorder walk of the subtree rooted at `root` (Go `ast.Inspect`).
// Results are in `f.walk_acc`.
pub fn (f $&File) inspect(root int) {
    f.walk_acc = []int{}
    f.walk_pre(root)
}

// Preorder walk of every top-level declaration. Results in `f.walk_acc`.
pub fn (f $&File) inspect_file() {
    f.walk_acc = []int{}
    for i in 0:f.decls.len {
        f.walk_pre(f.decls[i])
    }
}
