@xu/ast
// Tree walk (Go `ast.Walk` / `ast.Inspect`).
//
// Xu cannot pass `&mut []int` through conditionals (M2b), so the preorder
// buffer lives on `File.walk_acc`. `inspect` / `inspect_file` fill that
// field; callers read `f.walk_acc` afterwards.


fn (f &mut File) walk_list(head int) {
    mut i := head
    for g in 0:f.nodes.len {
        if i >= 0 {
            f.walk_pre(i)
            i = f.nodes[i].next
        }
    }
}

fn (f &mut File) walk_pre(i int) {
    if i < 0 {
        <<
    }
    f.walk_acc.push(i)
    k := f.nodes[i].kind
    a := f.nodes[i].a
    b := f.nodes[i].b
    c := f.nodes[i].c
    d := f.nodes[i].d
    e := f.nodes[i].e
    if k == nk_call { f.walk_list(a) }
    if k == nk_struct_init {
        f.walk_list(a)
        f.walk_list(b)
    }
    if k == nk_field { f.walk_pre(a) }
    if k == nk_method_call {
        f.walk_pre(a)
        f.walk_list(b)
    }
    if k == nk_try { f.walk_pre(a) }
    if k == nk_unwrap { f.walk_pre(a) }
    if k == nk_or_catch {
        f.walk_pre(a)
        f.walk_list(c)
    }
    if k == nk_borrow { f.walk_pre(a) }
    if k == nk_array_lit { f.walk_list(a) }
    if k == nk_empty_array { f.walk_pre(a) }
    if k == nk_index {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_slice {
        f.walk_pre(a)
        f.walk_pre(b)
        f.walk_pre(c)
    }
    if k == nk_bin_op {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_un_op { f.walk_pre(a) }
    if k == nk_s_field { f.walk_pre(a) }
    if k == nk_cast { f.walk_pre(a) }
    if k == nk_type_is {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_type_as {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_let { f.walk_pre(a) }
    if k == nk_assign {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_expr_stmt { f.walk_pre(a) }
    if k == nk_return { f.walk_pre(a) }
    if k == nk_throw { f.walk_pre(a) }
    if k == nk_exit { f.walk_pre(a) }
    if k == nk_if { f.walk_list(a) }
    if k == nk_branch {
        f.walk_pre(a)
        f.walk_list(b)
    }
    if k == nk_for {
        f.walk_pre(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == nk_for_each {
        f.walk_pre(a)
        f.walk_list(c)
    }
    if k == nk_match {
        f.walk_pre(a)
        f.walk_list(b)
    }
    if k == nk_arm_int { f.walk_list(c) }
    if k == nk_arm_range { f.walk_list(c) }
    if k == nk_arm_else { f.walk_list(c) }
    if k == nk_arm_str { f.walk_list(c) }
    if k == nk_while {
        f.walk_pre(a)
        f.walk_list(c)
    }
    if k == nk_arm_enum {
        f.walk_list(a)
        f.walk_list(c)
    }
    if k == nk_chan_init {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_recv { f.walk_pre(a) }
    if k == nk_xu { f.walk_pre(a) }
    if k == nk_send {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_fn {
        f.walk_list(e)
        f.walk_pre(d)
        f.walk_list(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == nk_param { f.walk_pre(a) }
    if k == nk_recv_decl { f.walk_pre(a) }
    if k == nk_struct {
        f.walk_list(e)
        f.walk_list(a)
    }
    if k == nk_field_decl { f.walk_pre(a) }
    if k == nk_interface { f.walk_list(a) }
    if k == nk_method_sig {
        f.walk_list(a)
        f.walk_pre(b)
    }
    if k == nk_const { f.walk_pre(a) }
    if k == nk_enum {
        f.walk_list(e)
        f.walk_list(a)
    }
    if k == nk_ident { f.walk_list(a) }
    if k == nt_named { f.walk_list(a) }
    if k == nt_result {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nt_ref { f.walk_pre(a) }
    if k == nt_array { f.walk_pre(a) }
    if k == nt_chan { f.walk_pre(a) }
    if k == nt_map {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nk_map_init {
        f.walk_pre(a)
        f.walk_pre(b)
    }
    if k == nt_fn {
        f.walk_list(a)
        f.walk_pre(b)
    }
    if k == nt_fn_lit {
        f.walk_list(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == nk_variant_decl { f.walk_list(a) }
    if k == nk_select {
        f.walk_list(a)
        f.walk_list(c)
    }
    if k == nk_sel_send {
        f.walk_pre(a)
        f.walk_pre(b)
        f.walk_list(c)
    }
    if k == nk_sel_recv {
        f.walk_pre(a)
        f.walk_list(c)
    }
}

// Preorder walk of the subtree rooted at `root` (Go `ast.Inspect`).
// Results are in `f.walk_acc`.
pub fn (f &mut File) inspect(root int) {
    f.walk_acc = []int{}
    f.walk_pre(root)
}

// Preorder walk of every top-level declaration. Results in `f.walk_acc`.
pub fn (f &mut File) inspect_file() {
    f.walk_acc = []int{}
    for i in 0:f.decls.len {
        f.walk_pre(f.decls[i])
    }
}
