@xu/ast
// Debug printer (Go `ast.Fprint` / `ast.Print`) and dump-stats line format.


struct DumpBuf {
    text string
}

fn (b &mut DumpBuf) write_list(f &File, head int, indent int) {
    mut i := head
    for g in 0:f.nodes.len {
        if i >= 0 {
            b.write_node(f, i, indent)
            i = f.nodes[i].next
        }
    }
}

fn (b &mut DumpBuf) write_node(f &File, i int, indent int) {
    if i < 0 {
        <<
    }
    n := f.get(i)
    mut pad := ""
    for _ in 0:indent {
        pad = pad + "  "
    }
    mut line := pad + node_name(n.kind)
    if n.sval.len > 0 {
        line = line + " " + n.sval
    }
    if n.kind == nk_bin_op {
        line = line + " " + binop_name(n.ival)
    }
    if n.kind == nk_un_op {
        line = line + " " + unop_name(n.ival)
    }
    if n.kind == nk_int || n.kind == nk_bool {
        line = line + " " + str(n.ival)
    }
    b.text = b.text + line + "\n"
    k := n.kind
    a := n.a
    bb := n.b
    c := n.c
    d := n.d
    e := n.e
    if k == nk_call { b.write_list(f, a, indent + 1) }
    if k == nk_struct_init {
        b.write_list(f, a, indent + 1)
        b.write_list(f, bb, indent + 1)
    }
    if k == nk_field { b.write_node(f, a, indent + 1) }
    if k == nk_method_call {
        b.write_node(f, a, indent + 1)
        b.write_list(f, bb, indent + 1)
    }
    if k == nk_try { b.write_node(f, a, indent + 1) }
    if k == nk_unwrap { b.write_node(f, a, indent + 1) }
    if k == nk_borrow { b.write_node(f, a, indent + 1) }
    if k == nk_array_lit { b.write_list(f, a, indent + 1) }
    if k == nk_empty_array { b.write_node(f, a, indent + 1) }
    if k == nk_index {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_slice {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
        b.write_node(f, c, indent + 1)
    }
    if k == nk_bin_op {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_un_op { b.write_node(f, a, indent + 1) }
    if k == nk_s_field { b.write_node(f, a, indent + 1) }
    if k == nk_cast { b.write_node(f, a, indent + 1) }
    if k == nk_type_is {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_type_as {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_let { b.write_node(f, a, indent + 1) }
    if k == nk_assign {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_expr_stmt { b.write_node(f, a, indent + 1) }
    if k == nk_return { b.write_node(f, a, indent + 1) }
    if k == nk_exit { b.write_node(f, a, indent + 1) }
    if k == nk_if { b.write_list(f, a, indent + 1) }
    if k == nk_branch {
        b.write_node(f, a, indent + 1)
        b.write_list(f, bb, indent + 1)
    }
    if k == nk_for {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_for_each {
        b.write_node(f, a, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_match {
        b.write_node(f, a, indent + 1)
        b.write_list(f, bb, indent + 1)
    }
    if k == nk_arm_int { b.write_list(f, c, indent + 1) }
    if k == nk_arm_range { b.write_list(f, c, indent + 1) }
    if k == nk_arm_else { b.write_list(f, c, indent + 1) }
    if k == nk_arm_str { b.write_list(f, c, indent + 1) }
    if k == nk_while {
        b.write_node(f, a, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_arm_enum {
        b.write_list(f, a, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_chan_init {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_recv { b.write_node(f, a, indent + 1) }
    if k == nk_xu { b.write_node(f, a, indent + 1) }
    if k == nk_send {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_fn {
        b.write_list(f, e, indent + 1)
        b.write_node(f, d, indent + 1)
        b.write_list(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_param { b.write_node(f, a, indent + 1) }
    if k == nk_recv_decl { b.write_node(f, a, indent + 1) }
    if k == nk_struct {
        b.write_list(f, e, indent + 1)
        b.write_list(f, a, indent + 1)
    }
    if k == nk_field_decl { b.write_node(f, a, indent + 1) }
    if k == nk_interface { b.write_list(f, a, indent + 1) }
    if k == nk_method_sig {
        b.write_list(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_const { b.write_node(f, a, indent + 1) }
    if k == nk_enum {
        b.write_list(f, e, indent + 1)
        b.write_list(f, a, indent + 1)
    }
    if k == nk_ident { b.write_list(f, a, indent + 1) }
    if k == nt_named { b.write_list(f, a, indent + 1) }
    if k == nt_result {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nt_ref { b.write_node(f, a, indent + 1) }
    if k == nt_array { b.write_node(f, a, indent + 1) }
    if k == nt_chan { b.write_node(f, a, indent + 1) }
    if k == nt_map {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nk_map_init {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nt_fn {
        b.write_list(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
    }
    if k == nt_fn_lit {
        b.write_list(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_variant_decl { b.write_list(f, a, indent + 1) }
    if k == nk_select {
        b.write_list(f, a, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_sel_send {
        b.write_node(f, a, indent + 1)
        b.write_node(f, bb, indent + 1)
        b.write_list(f, c, indent + 1)
    }
    if k == nk_sel_recv {
        b.write_node(f, a, indent + 1)
        b.write_list(f, c, indent + 1)
    }
}

// Indented dump of the subtree at `root`.
pub fn (f File) fprint(root int) string {
    mut b := DumpBuf{text: ""}
    b.write_node(&f, root, 0)
    << b.text
}

// Indented dump of every top-level declaration.
pub fn (f File) fprint_file() string {
    mut b := DumpBuf{text: ""}
    for i in 0:f.decls.len {
        b.write_node(&f, f.decls[i], 0)
    }
    << b.text
}

// Byte-identical to `gen1 parse` / `xu --dump-stats` one-file lines.
pub fn stats_line(path string, ntok int, nnodes int, nfn int, nstruct int, niface int) string {
    << path + ": tokens=" + str(ntok) + " nodes=" + str(nnodes) + " functions=" + str(nfn) + " structs=" + str(nstruct) + " interfaces=" + str(niface)
}
