@xu/ast
// Typed constructors for pool nodes (Go `ast.NewIdent` and friends).
// Gen1 cannot parse `ast.Node{...}` from other packages; these are the
// public way to build a node with its payload already filled.


pub fn n_int(line int, col int, v int) Node {
    mut n := mknode(NK_INT, line, col)
    n.ival = v
    << n
}

pub fn n_bool(line int, col int, v int) Node {
    mut n := mknode(NK_BOOL, line, col)
    n.ival = v
    << n
}

pub fn n_str(line int, col int, s string) Node {
    mut n := mknode(NK_STR, line, col)
    n.sval = s
    << n
}

pub fn n_ident(line int, col int, name string) Node {
    mut n := mknode(NK_IDENT, line, col)
    n.sval = name
    << n
}

pub fn n_float(line int, col int, bits int) Node {
    mut n := mknode(NK_FLOAT, line, col)
    n.ival = bits
    << n
}

pub fn n_call(line int, col int, name string, args int) Node {
    mut n := mknode(NK_CALL, line, col)
    n.sval = name
    n.a = args
    << n
}

pub fn n_binop(line int, col int, op int, lhs int, rhs int) Node {
    mut n := mknode(NK_BIN_OP, line, col)
    n.ival = op
    n.a = lhs
    n.b = rhs
    << n
}

pub fn n_unop(line int, col int, op int, expr int) Node {
    mut n := mknode(NK_UN_OP, line, col)
    n.ival = op
    n.a = expr
    << n
}

pub fn n_field(line int, col int, obj int, name string) Node {
    mut n := mknode(NK_FIELD, line, col)
    n.a = obj
    n.sval = name
    << n
}

pub fn n_index(line int, col int, obj int, index int) Node {
    mut n := mknode(NK_INDEX, line, col)
    n.a = obj
    n.b = index
    << n
}

pub fn n_cast(line int, col int, to_ty int, expr int) Node {
    mut n := mknode(NK_CAST, line, col)
    n.ival = to_ty
    n.a = expr
    << n
}

pub fn n_borrow(line int, col int, expr int, mutable int) Node {
    mut n := mknode(NK_BORROW, line, col)
    n.a = expr
    n.ival = mutable
    << n
}

pub fn n_let(line int, col int, name string, mutable int, init int) Node {
    mut n := mknode(NK_LET, line, col)
    n.sval = name
    n.ival = mutable
    n.a = init
    << n
}

pub fn n_assign(line int, col int, target int, op int, value int) Node {
    mut n := mknode(NK_ASSIGN, line, col)
    n.a = target
    n.ival = op
    n.b = value
    << n
}

pub fn n_return(line int, col int, value int) Node {
    mut n := mknode(NK_RETURN, line, col)
    n.a = value
    << n
}

pub fn n_exit(line int, col int, code int) Node {
    mut n := mknode(NK_EXIT, line, col)
    n.a = code
    << n
}

pub fn n_expr_stmt(line int, col int, expr int) Node {
    mut n := mknode(NK_EXPR_STMT, line, col)
    n.a = expr
    << n
}

pub fn n_break(line int, col int) Node {
    << mknode(NK_BREAK, line, col)
}

pub fn n_continue(line int, col int) Node {
    << mknode(NK_CONTINUE, line, col)
}

pub fn n_tint(line int, col int) Node { << mknode(NT_INT, line, col) }
pub fn n_tbool(line int, col int) Node { << mknode(NT_BOOL, line, col) }
pub fn n_tstr(line int, col int) Node { << mknode(NT_STR, line, col) }
pub fn n_tf64(line int, col int) Node { << mknode(NT_F64, line, col) }

pub fn n_tnamed(line int, col int, name string, args int) Node {
    mut n := mknode(NT_NAMED, line, col)
    n.sval = name
    n.a = args
    << n
}

pub fn n_tref(line int, col int, mutable int, inner int) Node {
    mut n := mknode(NT_REF, line, col)
    n.ival = mutable
    n.a = inner
    << n
}

pub fn n_tarray(line int, col int, elem int) Node {
    mut n := mknode(NT_ARRAY, line, col)
    n.a = elem
    << n
}

pub fn n_tchan(line int, col int, elem int) Node {
    mut n := mknode(NT_CHAN, line, col)
    n.a = elem
    << n
}

pub fn n_tmap(line int, col int, key int, val int) Node {
    mut n := mknode(NT_MAP, line, col)
    n.a = key
    n.b = val
    << n
}

// M147: `e is Type` — a = expr, b = type node.
pub fn n_type_is(line int, col int, expr int, ty int) Node {
    mut n := mknode(NK_TYPE_IS, line, col)
    n.a = expr
    n.b = ty
    << n
}

// M147: `e as Type` — a = expr, b = type node.
pub fn n_type_as(line int, col int, expr int, ty int) Node {
    mut n := mknode(NK_TYPE_AS, line, col)
    n.a = expr
    n.b = ty
    << n
}
