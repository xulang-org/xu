pub const nt_result = 54
pub const nt_ref = 55
pub const nt_array = 56
pub const nt_f64 = 57
pub const nt_chan = 58
pub const nk_variant_decl = 59
pub const nk_select = 60
pub const nk_sel_send = 61
pub const nk_sel_recv = 62
// Unused (postfix `!` unwrap removed with Result). Slot frozen; parser never emits this kind.
pub const nk_unwrap = 63
// M102: `Self` in struct@ method signatures.
pub const nt_self = 64
// M103: `fn(T, U) R` / `fn()` function type.
pub const nt_fn = 65
// M109: anonymous function literal `fn(params) [Ret] { body }`.
pub const nt_fn_lit = 66
// M147: `e is Type` / `e as Type`.
pub const nk_type_is = 67
pub const nk_type_as = 68
pub const nt_temp = 69
// Dynamic `any` type node (keeps box across `as`; unlike nt_temp).
pub const nt_any = 76
// 69 was briefly NArmResult (`Ok`/`Err` match); unused. Do not reuse.
// §5.7: `>> expr` — a=thrown expression (statement form).
pub const nk_throw = 70
// §5.7: `call or (err) { }` / sugar `call or >>` — a=call, sval=bind, c=body stmt list.
pub const nk_or_catch = 71
// `<<< expr` — process exit (statement form).
pub const nk_exit = 72
// L-C: `map[K]V` type and `map[K]V{}` empty init.
pub const nt_map = 73
pub const nk_map_init = 74
// MS9c: string-literal match arm (`"red" { ... }`).
pub const nk_arm_str = 75

// Keyword tag for `word`, or 0 if it is a plain identifier (go/token.Lookup).
// Abandoned words (`return` / `interface` / `module` / `import` / `break` /
// `continue` / `throw` / `exit`) lex as tok_ident. The Tok* slots below stay
// unused so numbers do not shift.
pub fn lookup_keyword(word string) int {
    if word == "fn" { << tok_fn }
    if word == "mut" { << tok_mut }
    if word == "if" { << tok_if }
    if word == "else" { << tok_else }
    if word == "for" { << tok_for }
    if word == "in" { << tok_in }
    if word == "is" { << tok_is }
    if word == "as" { << tok_as }
    if word == "struct" { << tok_struct }
    if word == "enum" { << tok_enum }
    if word == "match" { << tok_match }
    if word == "true" { << tok_true }
    if word == "false" { << tok_false }
    if word == "int" { << tok_kw_int }
    if word == "bool" { << tok_kw_bool }
    if word == "string" { << tok_kw_string }
    if word == "f64" { << tok_kw_f64 }
    if word == "while" { << tok_while }
    if word == "const" { << tok_const }
    if word == "pub" { << tok_pub }
    if word == "xu" { << tok_xu }
    if word == "chan" { << tok_chan }
    if word == "map" { << tok_map }
    if word == "select" { << tok_select }
    if word == "i32" { << tok_kw_i32 }
    if word == "u32" { << tok_kw_u32 }
    if word == "u8" { << tok_kw_u8 }
    if word == "byte" { << tok_kw_u8 }
    if word == "temp" { << tok_kw_temp }
    if word == "any" { << tok_kw_any }
    if word == "let" { << tok_let }
    if word == "or" { << tok_or }
    << 0
}

// Rust Debug names, lowercased — used in parser errors ("found 'rbrace'").
pub fn tok_name(kind int) string {
    if kind == tok_fn { << "fn" }
    if kind == tok_let { << "let" }
    if kind == tok_throw { << "throw" }
    if kind == tok_or { << "or" }
    if kind == tok_mut { << "mut" }
    if kind == tok_return { << "return" }
    if kind == tok_if { << "if" }
    if kind == tok_else { << "else" }
    if kind == tok_for { << "for" }
    if kind == tok_in { << "in" }
    if kind == tok_is { << "is" }
    if kind == tok_as { << "as" }
    if kind == tok_struct { << "struct" }
    if kind == tok_enum { << "enum" }
    if kind == tok_match { << "match" }
    if kind == tok_interface { << "interface" }
    if kind == tok_true { << "true" }
    if kind == tok_false { << "false" }
    if kind == tok_kw_int { << "kwint" }
    if kind == tok_kw_bool { << "kwbool" }
    if kind == tok_kw_string { << "kwstring" }
    if kind == tok_l_paren { << "lparen" }
    if kind == tok_r_paren { << "rparen" }
    if kind == tok_l_brace { << "lbrace" }
    if kind == tok_r_brace { << "rbrace" }
    if kind == tok_l_bracket { << "lbracket" }
    if kind == tok_r_bracket { << "rbracket" }
    if kind == tok_comma { << "comma" }
    if kind == tok_plus { << "plus" }
    if kind == tok_minus { << "minus" }
    if kind == tok_star { << "star" }
    if kind == tok_slash { << "slash" }
    if kind == tok_percent { << "percent" }
    if kind == tok_eq_eq { << "eqeq" }
    if kind == tok_not_eq { << "noteq" }
    if kind == tok_lt { << "lt" }
    if kind == tok_lt_eq { << "lteq" }
    if kind == tok_gt { << "gt" }
    if kind == tok_gt_eq { << "gteq" }
    if kind == tok_and_and { << "andand" }
    if kind == tok_or_or { << "oror" }
    if kind == tok_amp { << "amp" }
    if kind == tok_pipe { << "pipe" }
    if kind == tok_caret { << "caret" }
    if kind == tok_shl { << "shl" }
    if kind == tok_shr { << "shr" }
    if kind == tok_bang { << "bang" }
    if kind == tok_assign { << "assign" }
    if kind == tok_plus_assign { << "plusassign" }
    if kind == tok_colon_assign { << "colonassign" }
    if kind == tok_colon { << "colon" }
    if kind == tok_dot_dot { << "dotdot" }
    if kind == tok_ellipsis { << "ellipsis" }
    if kind == tok_dot { << "dot" }
    if kind == tok_question { << "question" }
    if kind == tok_while { << "while" }
    if kind == tok_break { << "break" }
    if kind == tok_continue { << "continue" }
    if kind == tok_const { << "const" }
    if kind == tok_minus_assign { << "minusassign" }
    if kind == tok_star_assign { << "starassign" }
    if kind == tok_slash_assign { << "slashassign" }
    if kind == tok_percent_assign { << "percentassign" }
    if kind == tok_module { << "module" }
    if kind == tok_import { << "import" }
    if kind == tok_pub { << "pub" }
    if kind == tok_xu { << "xu" }
    if kind == tok_chan { << "chan" }
    if kind == tok_map { << "map" }
    if kind == tok_left_arrow { << "leftarrow" }
    if kind == tok_right_arrow { << "rightarrow" }
    if kind == tok_left_right_arrow { << "leftrightarrow" }
    if kind == tok_at { << "at" }
    if kind == tok_dollar { << "dollar" }
    if kind == tok_hash { << "hash" }
    if kind == tok_pound { << "#" }
    if kind == tok_triple_lt { << "triplelt" }
    if kind == tok_exit { << "exit" }
