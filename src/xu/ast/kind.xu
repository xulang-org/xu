pub fn unop_name(op int) string {
    if op == UN_NEG { << "-" }
    if op == UN_NOT { << "!" }
    if op == UN_DEREF { << "*" }
    << "?"
}

pub fn binop_name(op int) string {
    if op == OP_ADD { << "+" }
    if op == OP_SUB { << "-" }
    if op == OP_MUL { << "*" }
    if op == OP_DIV { << "/" }
    if op == OP_MOD { << "%" }
    if op == OP_EQ { << "==" }
    if op == OP_NE { << "!=" }
    if op == OP_LT { << "<" }
    if op == OP_LE { << "<=" }
    if op == OP_GT { << ">" }
    if op == OP_GE { << ">=" }
    if op == OP_AND { << "&&" }
    if op == OP_OR { << "||" }
    if op == OP_BIT_AND { << "&" }
    if op == OP_BIT_OR { << "|" }
    if op == OP_BIT_XOR { << "^" }
    if op == OP_SHL { << "<<" }
    if op == OP_SHR { << ">>" }
    << "?"
}

// Token kind → binary-operator tag; 0 if `tok` is not an infix binop.
pub fn binop_of(tok int) int {
    if tok == TOK_PLUS { << OP_ADD }
    if tok == TOK_MINUS { << OP_SUB }
    if tok == TOK_STAR { << OP_MUL }
    if tok == TOK_SLASH { << OP_DIV }
    if tok == TOK_PERCENT { << OP_MOD }
    if tok == TOK_EQ_EQ { << OP_EQ }
    if tok == TOK_NOT_EQ { << OP_NE }
    if tok == TOK_LT { << OP_LT }
    if tok == TOK_LT_EQ { << OP_LE }
    if tok == TOK_GT { << OP_GT }
    if tok == TOK_GT_EQ { << OP_GE }
    if tok == TOK_AND_AND { << OP_AND }
    if tok == TOK_OR_OR { << OP_OR }
    if tok == TOK_AMP { << OP_BIT_AND }
    if tok == TOK_PIPE { << OP_BIT_OR }
    if tok == TOK_CARET { << OP_BIT_XOR }
    if tok == TOK_SHL { << OP_SHL }
    if tok == TOK_SHR { << OP_SHR }
    << 0
}

pub fn is_expr(kind int) bool {
    if kind >= NK_INT && kind <= NK_CAST { << true }
    if kind == NK_CHAN_INIT || kind == NK_RECV { << true }
    if kind == NK_UNWRAP { << true }
    if kind == NK_TYPE_IS || kind == NK_TYPE_AS { << true }
    if kind == NK_OR_CATCH { << true }
    << false
}

pub fn is_stmt(kind int) bool {
    if kind >= NK_LET && kind <= NK_CONTINUE { << true }
    if kind == NK_THROW { << true }
    if kind == NK_EXIT { << true }
    if kind == NK_ARM_ENUM { << true }
    if kind == NK_ARM_STR { << true }
    if kind >= NK_XU && kind <= NK_SEND { << true }
    if kind >= NK_SELECT && kind <= NK_SEL_RECV { << true }
    << false
}

pub fn is_decl(kind int) bool {
    if kind == NK_FN || kind == NK_STRUCT || kind == NK_INTERFACE { << true }
    if kind == NK_CONST || kind == NK_ENUM { << true }
    << false
}

pub fn is_type(kind int) bool {
    if kind >= NT_INT && kind <= NT_FN { << true }
    if kind == NT_MAP { << true }
    << false
}

// Token class used by the source formatter (must match lang/fmt.xu).
pub fn tok_is_word(k int) bool {
    if k == TOK_IDENT { << true }
    if k == TOK_INT { << true }
    if k == TOK_STR { << true }
    if k == TOK_FLOAT { << true }
    if k >= TOK_FN && k <= TOK_KW_STRING { << true }
    if k >= TOK_WHILE && k <= TOK_CONST { << true }
    if k >= TOK_MODULE && k <= TOK_PUB { << true }
    if k >= TOK_KW_F64 && k <= TOK_CHAN { << true }
    if k >= TOK_KW_I32 && k <= TOK_SELECT { << true }
    if k == TOK_AS || k == TOK_IS { << true }
    if k == TOK_LET || k == TOK_SHR || k == TOK_SHL || k == TOK_OR || k == TOK_RIGHT_ARROW { << true }
    if k == TOK_HASH || k == TOK_POUND || k == TOK_TRIPLE_LT || k == TOK_EXIT { << true }
    if k == TOK_MAP { << true }
    << false
}

pub fn tok_is_infix(k int) bool {
    if k >= TOK_PLUS && k <= TOK_OR_OR { << true }
    if k == TOK_PIPE || k == TOK_CARET || k == TOK_SHL || k == TOK_SHR { << true }
    if k == TOK_ASSIGN || k == TOK_PLUS_ASSIGN { << true }
    if k == TOK_COLON_ASSIGN || k == TOK_LEFT_ARROW || k == TOK_RIGHT_ARROW || k == TOK_LEFT_RIGHT_ARROW || k == TOK_TRIPLE_LT || k == TOK_IN { << true }
    if k >= TOK_MINUS_ASSIGN && k <= TOK_PERCENT_ASSIGN { << true }
    << false
}

// Unified range syntax is `:` (half-open `[start, end)`).
pub fn tok_is_range(k int) bool {
    << k == TOK_COLON
}

pub fn tok_range_ival(k int) int {
    << RNG_COLON
}

pub fn range_start_excl(ival int) bool {
    // `:` is always half-open; start is inclusive.
    << false
}

pub fn range_end_excl(ival int) bool {
    // `:` is always half-open; end is exclusive.
    << true
}

pub fn range_op_str(ival int) string {
    << ":"
}

pub fn range_ival_from_str(s string) int {
    if s == ":" { << RNG_COLON }
    << RNG_COLON
}
