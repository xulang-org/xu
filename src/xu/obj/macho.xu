@xu/obj
// Mach-O binary format serializer.
//
// Layer 4D module: serializes ObjectFile into Apple Mach-O 64-bit binary format.
// Completely decoupled from assembler or code generation internals.

#xu/mc

pub const MACHO_MAGIC_64 = 0xfeedfacf
pub const MACHO_CPU_TYPE_ARM64 = 0x0100000c
pub const MACHO_CPU_TYPE_X86_64 = 0x01000007
pub const MACHO_FILETYPE_EXECUTE = 0x2
pub const MACHO_FILETYPE_OBJECT = 0x1

pub const LC_SEGMENT_64 = 0x19
pub const LC_LOAD_DYLINKER = 0x0e
pub const LC_LOAD_DYLIB = 0x0c
pub const LC_MAIN = 0x80000028

pub fn macho_write_header(buf $&mc.CodeBuffer, cpu_type int, file_type int, ncmds int, sizeofcmds int) {
    buf.emit_u32_le(MACHO_MAGIC_64)
    buf.emit_u32_le(cpu_type)
    if cpu_type == MACHO_CPU_TYPE_X86_64 {
        buf.emit_u32_le(3) // CPU_SUBTYPE_X86_64_ALL
    } else {
        buf.emit_u32_le(0) // CPU_SUBTYPE_ARM64_ALL
    }
    buf.emit_u32_le(file_type)
    buf.emit_u32_le(ncmds)
    buf.emit_u32_le(sizeofcmds)
    buf.emit_u32_le(0x00200085) // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    buf.emit_u32_le(0) // reserved
}

fn emit_fixed_string(buf $&mc.CodeBuffer, s string, max_len int) {
    for i in 0:max_len {
        if i < s.len {
            buf.emit_u8(s[i])
        } else {
            buf.emit_u8(0)
        }
    }
}

pub fn macho_write_executable(code_bytes &[]int, cpu_type int, entry_offset int) mc.CodeBuffer {
    $buf := mc.code_buffer_new()

    $page_size := 16384
    if cpu_type == MACHO_CPU_TYPE_X86_64 {
        page_size = 4096
    }
    // Commands: PAGEZERO (72) + TEXT (152) + DYLINKER (32) + MAIN (24) + DYLIB (56) = 336
    cmds_size := 72 + 152 + 32 + 24 + 56
    header_and_cmds_size := 32 + cmds_size + 64 // ≥32 bytes pad for macOS codesign

    $text_file_offset := header_and_cmds_size
    rem := text_file_offset % 16
    if rem != 0 {
        text_file_offset += 16 - rem
    }

    text_vmaddr := 0x100000000 + text_file_offset
    text_vmsize := code_bytes.len
    entry_file_offset := text_file_offset + entry_offset

    $segment_size := text_file_offset + code_bytes.len
    rem_seg := segment_size % page_size
    if rem_seg != 0 {
        segment_size += page_size - rem_seg
    }

    // 1. Mach-O Header (32 bytes)
    macho_write_header($&buf, cpu_type, MACHO_FILETYPE_EXECUTE, 5, cmds_size)

    // 2. LC_SEGMENT_64 (__PAGEZERO, 72 bytes)
    buf.emit_u32_le(LC_SEGMENT_64)
    buf.emit_u32_le(72)
    emit_fixed_string($&buf, "__PAGEZERO", 16)
    buf.emit_u64_le(0) // vmaddr
    buf.emit_u64_le(0x100000000) // vmsize = 4GB
    buf.emit_u64_le(0) // fileoff
    buf.emit_u64_le(0) // filesize
    buf.emit_u32_le(0) // maxprot
    buf.emit_u32_le(0) // initprot
    buf.emit_u32_le(0) // nsects
    buf.emit_u32_le(0) // flags

    // 3. LC_SEGMENT_64 (__TEXT, 72 + 80 = 152 bytes)
    buf.emit_u32_le(LC_SEGMENT_64)
    buf.emit_u32_le(152)
    emit_fixed_string($&buf, "__TEXT", 16)
    buf.emit_u64_le(0x100000000) // vmaddr
    buf.emit_u64_le(segment_size) // vmsize
    buf.emit_u64_le(0) // fileoff
    buf.emit_u64_le(segment_size) // filesize
    buf.emit_u32_le(5) // maxprot = rx
    buf.emit_u32_le(5) // initprot = rx
    buf.emit_u32_le(1) // nsects = 1
    buf.emit_u32_le(0) // flags

    // Section 1 (__text, 80 bytes)
    emit_fixed_string($&buf, "__text", 16)
    emit_fixed_string($&buf, "__TEXT", 16)
    buf.emit_u64_le(text_vmaddr)
    buf.emit_u64_le(text_vmsize)
    buf.emit_u32_le(text_file_offset)
    buf.emit_u32_le(4) // align 2^4 = 16
    buf.emit_u32_le(0) // reloff
    buf.emit_u32_le(0) // nreloc
    buf.emit_u32_le(0x80000400) // S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    buf.emit_u32_le(0) // reserved1
    buf.emit_u32_le(0) // reserved2
    buf.emit_u32_le(0) // reserved3

    // 4. LC_LOAD_DYLINKER (32 bytes)
    buf.emit_u32_le(LC_LOAD_DYLINKER)
    buf.emit_u32_le(32)
    buf.emit_u32_le(12) // offset to name
    emit_fixed_string($&buf, "/usr/lib/dyld", 20)

    // 5. LC_LOAD_DYLIB (/usr/lib/libSystem.B.dylib, 56 bytes)
    buf.emit_u32_le(LC_LOAD_DYLIB)
    buf.emit_u32_le(56)
    buf.emit_u32_le(24) // offset to name
    buf.emit_u32_le(2) // timestamp
    buf.emit_u32_le(65536) // current_version
    buf.emit_u32_le(65536) // compatibility_version
    emit_fixed_string($&buf, "/usr/lib/libSystem.B.dylib", 32)

    // 6. LC_MAIN (24 bytes)
    buf.emit_u32_le(LC_MAIN)
    buf.emit_u32_le(24)
    buf.emit_u64_le(entry_file_offset) // entryoff from __TEXT start
    buf.emit_u64_le(0) // stacksize

    // 7. Pad up to text_file_offset
    while buf.len() < text_file_offset {
        buf.emit_u8(0)
    }

    // 8. Emit machine code bytes
    buf.emit_bytes(code_bytes)

    // Pad file out to page boundary (segment_size)
    while buf.len() < segment_size {
        buf.emit_u8(0)
    }

    << buf
}

pub fn macho_write_executable_arm64(code_bytes &[]int, entry_offset int) mc.CodeBuffer {
    << macho_write_executable(code_bytes, MACHO_CPU_TYPE_ARM64, entry_offset)
}
