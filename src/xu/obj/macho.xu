@xu/obj
// Mach-O binary format serializer.
//
// Layer 4D module: serializes ObjectFile into Apple Mach-O 64-bit binary format.
// Completely decoupled from assembler or code generation internals.

#xu/mc

pub const MACHO_MAGIC_64 = 0xfeedfacf
pub const MACHO_CPU_TYPE_ARM64 = 0x0100000c
pub const MACHO_CPU_TYPE_X86_64 = 0x01000007
pub const MACHO_FILETYPE_EXECUTE = 0x2
pub const MACHO_FILETYPE_OBJECT = 0x1

pub const LC_SEGMENT_64 = 0x19
pub const LC_LOAD_DYLINKER = 0x0e
pub const LC_LOAD_DYLIB = 0x0c
pub const LC_MAIN = 0x80000028
pub const LC_SYMTAB = 0x2
pub const LC_DYSYMTAB = 0xb
const LC_UUID = 0x1b
const LC_CODE_SIGNATURE = 0x1d
const LC_BUILD_VERSION = 0x32
const LC_DYLD_EXPORTS_TRIE = 0x80000033
const LC_DYLD_CHAINED_FIXUPS = 0x80000034
const SG_READ_ONLY = 0x10
const S_ZEROFILL = 1
const MACHO_CLOCK_SYMBOL = "_clock_gettime"

pub fn macho_write_header(buf $&mc.CodeBuffer, cpu_type int, file_type int, ncmds int, sizeofcmds int) {
    buf.emit_u32_le(MACHO_MAGIC_64)
    buf.emit_u32_le(cpu_type)
    if cpu_type == MACHO_CPU_TYPE_X86_64 {
        buf.emit_u32_le(3) // CPU_SUBTYPE_X86_64_ALL
    } else {
        buf.emit_u32_le(0) // CPU_SUBTYPE_ARM64_ALL
    }
    buf.emit_u32_le(file_type)
    buf.emit_u32_le(ncmds)
    buf.emit_u32_le(sizeofcmds)
    if file_type == MACHO_FILETYPE_EXECUTE {
        buf.emit_u32_le(0x01200084) // MH_DYLDLINK | MH_TWOLEVEL | MH_PIE | MH_NO_HEAP_EXECUTION
    } else {
        buf.emit_u32_le(0)
    }
    buf.emit_u32_le(0) // reserved
}

fn emit_fixed_string(buf $&mc.CodeBuffer, s string, max_len int) {
    for i in 0:max_len {
        if i < s.len {
            buf.emit_u8(s[i])
        } else {
            buf.emit_u8(0)
        }
    }
}

// Function symbols for the executable's symbol table: names and offsets
// from the first code byte.
pub struct MachoSyms {
pub:
    names []string
    offs []int
}

pub fn macho_syms_empty() MachoSyms {
    << MachoSyms{names: []string{}, offs: []int{}}
}

// Load commands: PAGEZERO (72), TEXT (152), DATA_CONST (152), DATA (152),
// LINKEDIT (72), SYMTAB (24), DYSYMTAB (80), CHAINED_FIXUPS (16),
// EXPORTS_TRIE (16), DYLINKER (32), DYLIB (56), MAIN (24), UUID (24),
// BUILD_VERSION (24), CODE_SIGNATURE (16), plus __DWARF with four sections
// (72 + 4 * 80) when debug sections exist.
fn macho_cmds_size(debug bool) int {
    $n := 72 + 152 + 152 + 152 + 72 + 24 + 80 + 16 + 16 + 32 + 56 + 24 + 24 + 24 + 16
    if debug {
        n += 72 + 4 * 80
    }
    << n
}

fn macho_text_file_offset(debug bool) int {
    $off := 32 + macho_cmds_size(debug) + 64 // ≥32 bytes pad for macOS codesign
    rem := off % 16
    if rem != 0 {
        off += 16 - rem
    }
    << off
}

// Virtual address of the first code byte.
pub fn macho_code_vaddr(debug bool) int {
    << 0x100000000 + macho_text_file_offset(debug)
}

fn page_up(n int, page int) int {
    if page <= 0 {
        << n
    }
    << (n + page - 1) / page * page
}

fn macho_page_size(cpu_type int) int {
    if cpu_type == MACHO_CPU_TYPE_X86_64 {
        << 4096
    }
    << 16384
}

// Offset from __text start to the first __DATA_CONST pointer (clock_gettime,
// followed by dlopen, dlsym, dlerror). __DATA_CONST is locked read-only by
// dyld right after binding (SG_READ_ONLY).
pub fn macho_clock_slot_offset(code_len int, cpu_type int, debug bool) int {
    text_off := macho_text_file_offset(debug)
    << page_up(text_off + code_len, macho_page_size(cpu_type)) - text_off
}

// Offset from __text start to __DATA (one page after __DATA_CONST), where
// runtime-written __xu_ffi_state lives so __DATA_CONST can stay read-only.
pub fn macho_ffi_state_slot_offset(code_len int, cpu_type int, debug bool) int {
    << macho_clock_slot_offset(code_len, cpu_type, debug) + macho_page_size(cpu_type)
}

// __DATA_CONST pointers bound from libSystem: clock_gettime, then the C FFI
// loader entry points (core ffi.xu reads them through the codegen label).
fn macho_imports() []string {
    << [MACHO_CLOCK_SYMBOL, "_dlopen", "_dlsym", "_dlerror"]
}

// Build Apple dyld_chained_fixups metadata (macOS 12+ standard format)
// binding the 4 libSystem pointers encoded in place at __DATA_CONST+0.
fn macho_chained_fixups(page int, data_const_off int, seg_count int) mc.CodeBuffer {
    imports := macho_imports()
    $syms := mc.code_buffer_new()
    $name_offs := []int{}
    for i in 0:imports.len {
        name_offs.push(syms.len())
        emit_fixed_string($&syms, imports[i], imports[i].len + 1)
    }

    starts_offset := 32
    starts_img_hdr := 4 + seg_count * 4
    seg_starts_size := 24 // 22-byte dyld_chained_starts_in_segment + 1 u16 page_start
    imports_offset := starts_offset + starts_img_hdr + seg_starts_size
    symbols_offset := imports_offset + imports.len * 4

    $out := mc.code_buffer_new()
    // dyld_chained_fixups_header (28 bytes, padded to 32)
    out.emit_u32_le(0)              // fixups_version = 0
    out.emit_u32_le(starts_offset)  // starts_offset
    out.emit_u32_le(imports_offset) // imports_offset
    out.emit_u32_le(symbols_offset) // symbols_offset
    out.emit_u32_le(imports.len)    // imports_count
    out.emit_u32_le(1)              // imports_format = DYLD_CHAINED_IMPORT
    out.emit_u32_le(0)              // symbols_format = 0 (uncompressed)
    out.emit_u32_le(0)              // pad to 32

    // dyld_chained_starts_in_image
    out.emit_u32_le(seg_count)
    for si in 0:seg_count {
        if si == 2 {
            out.emit_u32_le(starts_img_hdr) // __DATA_CONST is segment index 2
        } else {
            out.emit_u32_le(0)
        }
    }

    // dyld_chained_starts_in_segment for __DATA_CONST (pointer_format = 6 = DYLD_CHAINED_PTR_64_OFFSET)
    out.emit_u32_le(seg_starts_size)
    out.emit_u16_le(page)
    out.emit_u16_le(6) // DYLD_CHAINED_PTR_64_OFFSET (4-byte stride)
    out.emit_u64_le(data_const_off)
    out.emit_u32_le(0) // max_valid_pointer
    out.emit_u16_le(1) // page_count = 1
    out.emit_u16_le(0) // page_start[0] = 0

    // dyld_chained_import[4]: lib_ordinal=1 (libSystem), weak_import=0, name_offset
    for i in 0:imports.len {
        out.emit_u32_le(1 | (name_offs[i] << 9))
    }
    out.emit_bytes(&syms.bytes)
    while out.len() % 8 != 0 {
        out.emit_u8(0)
    }
    << out
}

// Minimal LC_DYLD_EXPORTS_TRIE exporting __mh_execute_header at offset 0.
fn macho_exports_trie() mc.CodeBuffer {
    $out := mc.code_buffer_new()
    out.emit_u8(0) // root terminal_size = 0
    out.emit_u8(1) // root child_count = 1
    emit_fixed_string($&out, "__mh_execute_header", 20)
    out.emit_u8(out.len() + 1) // child node offset = 23
    out.emit_u8(2) // child terminal_size = 2 (flags=0, addr=0)
    out.emit_u8(0) // EXPORT_SYMBOL_FLAGS_KIND_REGULAR
    out.emit_u8(0) // address = 0 (__TEXT base)
    out.emit_u8(0) // child_count = 0
    while out.len() % 8 != 0 {
        out.emit_u8(0)
    }
    << out
}

// Deterministic 32-byte digest of a byte slice for LC_UUID and
// ELF .note.gnu.build-id (preserves byte-identical self-host builds).
fn obj_sha256_bytes(bytes &[]int) string {
    $raw := []int{}
    macho_cd_hash_page(bytes, 0, bytes.len, $&raw)
    $out := make_string(32)
    for i in 0:32 {
        out[i] = raw[i] & 255
    }
    << out
}

fn align8(n int) int {
    << (n + 7) / 8 * 8
}

fn align16(n int) int {
    << (n + 15) / 16 * 16
}

fn emit_u64_be(buf $&mc.CodeBuffer, v int) {
    buf.emit_u32_be((v >> 32) & 0xffffffff)
    buf.emit_u32_be(v & 0xffffffff)
}

// Compute the embedded CS_ADHOC SuperBlob byte size for an executable with
// code signature starting at `cs_off`.
fn macho_adhoc_sig_size(cs_off int) int {
    n_slots := (cs_off + 4095) / 4096
    cd_len := 88 + 6 + n_slots * 32
    << 20 + cd_len
}

fn macho_rotr32(x int, n int) int {
    v := x & 0xffffffff
    << ((v >> n) | ((v << (32 - n)) & 0xffffffff)) & 0xffffffff
}

fn macho_cd_k_table() [64]int {
    << [64]int{
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    }
}

fn macho_cd_msg_byte(bytes &[]int, start int, pos int, msg_len int, total_bytes int) int {
    if pos < msg_len {
        << bytes[start + pos] & 255
    }
    if pos == msg_len {
        << 128
    }
    if pos < total_bytes - 8 {
        << 0
    }
    shift := (total_bytes - 1 - pos) * 8
    bit_len := msg_len * 8
    << (bit_len >> shift) & 255
}

// Hash buf.bytes[start:end] with standard FIPS 180-4 SHA-256 directly inside
// @xu/obj so the compiler remains independent of the stdlib cryptography package.
fn macho_cd_hash_page(bytes &[]int, start int, end int, out $&[]int) {
    msg_len := end - start
    total_bytes := ((msg_len + 9 + 63) / 64) * 64
    k := macho_cd_k_table()
    $h0 := 0x6a09e667
    $h1 := 0xbb67ae85
    $h2 := 0x3c6ef372
    $h3 := 0xa54ff53a
    $h4 := 0x510e527f
    $h5 := 0x9b05688c
    $h6 := 0x1f83d9ab
    $h7 := 0x5be0cd19
    $blk := 0
    while blk < total_bytes {
        $w := []int{}
        for i in 0:16 {
            p := blk + i * 4
            b0 := macho_cd_msg_byte(bytes, start, p, msg_len, total_bytes)
            b1 := macho_cd_msg_byte(bytes, start, p + 1, msg_len, total_bytes)
            b2 := macho_cd_msg_byte(bytes, start, p + 2, msg_len, total_bytes)
            b3 := macho_cd_msg_byte(bytes, start, p + 3, msg_len, total_bytes)
            w.push((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
        }
        for i in 16:64 {
            v15 := w[i - 15] & 0xffffffff
            v2 := w[i - 2] & 0xffffffff
            s0 := macho_rotr32(v15, 7) ^ macho_rotr32(v15, 18) ^ (v15 >> 3)
            s1 := macho_rotr32(v2, 17) ^ macho_rotr32(v2, 19) ^ (v2 >> 10)
            w.push((w[i - 16] + s0 + w[i - 7] + s1) & 0xffffffff)
        }
        $a := h0
        $b := h1
        $c := h2
        $d := h3
        $e := h4
        $f := h5
        $g := h6
        $h := h7
        for i in 0:64 {
            s1 := macho_rotr32(e, 6) ^ macho_rotr32(e, 11) ^ macho_rotr32(e, 25)
            ch := (e & f) ^ ((e ^ 0xffffffff) & g)
            temp1 := (h + s1 + ch + k[i] + w[i]) & 0xffffffff
            s0 := macho_rotr32(a, 2) ^ macho_rotr32(a, 13) ^ macho_rotr32(a, 22)
            maj := (a & b) ^ (a & c) ^ (b & c)
            temp2 := (s0 + maj) & 0xffffffff
            h = g
            g = f
            f = e
            e = (d + temp1) & 0xffffffff
            d = c
            c = b
            b = a
            a = (temp1 + temp2) & 0xffffffff
        }
        h0 = (h0 + a) & 0xffffffff
        h1 = (h1 + b) & 0xffffffff
        h2 = (h2 + c) & 0xffffffff
        h3 = (h3 + d) & 0xffffffff
        h4 = (h4 + e) & 0xffffffff
        h5 = (h5 + f) & 0xffffffff
        h6 = (h6 + g) & 0xffffffff
        h7 = (h7 + h) & 0xffffffff
        blk += 64
    }
    words := [8]int{h0, h1, h2, h3, h4, h5, h6, h7}
    for wi in 0:8 {
        v := words[wi]
        out.push((v >> 24) & 255)
        out.push((v >> 16) & 255)
        out.push((v >> 8) & 255)
        out.push(v & 255)
    }
}

// Emit an Apple CS_ADHOC SuperBlob covering buf[0:cs_off] with 4KB SHA-256 pages.
fn macho_emit_adhoc_sig(buf $&mc.CodeBuffer, cs_off int, text_file_size int) {
    n_slots := (cs_off + 4095) / 4096
    cd_len := 88 + 6 + n_slots * 32
    sb_len := 20 + cd_len

    $hashes := []int{}
    for p in 0:n_slots {
        start := p * 4096
        $end := start + 4096
        if end > cs_off {
            end = cs_off
        }
        macho_cd_hash_page(&buf.bytes, start, end, $&hashes)
    }

    // SuperBlob header + 1 CodeDirectory BlobIndex
    buf.emit_u32_be(0xfade0cc0) // CSMAGIC_EMBEDDED_SIGNATURE
    buf.emit_u32_be(sb_len)
    buf.emit_u32_be(1)          // count
    buf.emit_u32_be(0)          // CSSLOT_CODEDIRECTORY
    buf.emit_u32_be(20)         // offset

    // CodeDirectory v0x20400 (CS_SUPPORTSEXECSEG) with adhoc + linker-signed flags
    buf.emit_u32_be(0xfade0c02) // CSMAGIC_CODEDIRECTORY
    buf.emit_u32_be(cd_len)
    buf.emit_u32_be(0x20400)
    buf.emit_u32_be(0x20002)    // CS_ADHOC | CS_LINKER_SIGNED
    buf.emit_u32_be(88 + 6)     // hashOffset
    buf.emit_u32_be(88)         // identOffset
    buf.emit_u32_be(0)          // nSpecialSlots
    buf.emit_u32_be(n_slots)    // nCodeSlots
    buf.emit_u32_be(cs_off)     // codeLimit
    buf.emit_u8(32)             // hashSize (SHA-256)
    buf.emit_u8(2)              // CS_HASHTYPE_SHA256
    buf.emit_u8(0)              // platform
    buf.emit_u8(12)             // pageSize (2^12 = 4096)
    buf.emit_u32_be(0)          // spare2
    buf.emit_u32_be(0)          // scatterOffset
    buf.emit_u32_be(0)          // teamOffset
    buf.emit_u32_be(0)          // spare3
    emit_u64_be(buf, 0)         // codeLimit64
    emit_u64_be(buf, 0)         // execSegBase
    emit_u64_be(buf, text_file_size) // execSegLimit
    emit_u64_be(buf, 1)         // CS_EXECSEG_MAIN_BINARY

    emit_fixed_string(buf, "a.out", 6)
    buf.emit_bytes(&hashes)
}

fn macho_segment_flags(buf $&mc.CodeBuffer, name string, nsects int, vmaddr int, vmsize int, fileoff int, filesize int, prot int, flags int) {
    buf.emit_u32_le(LC_SEGMENT_64)
    buf.emit_u32_le(72 + 80 * nsects)
    emit_fixed_string(buf, name, 16)
    buf.emit_u64_le(vmaddr)
    buf.emit_u64_le(vmsize)
    buf.emit_u64_le(fileoff)
    buf.emit_u64_le(filesize)
    buf.emit_u32_le(prot) // maxprot
    buf.emit_u32_le(prot) // initprot
    buf.emit_u32_le(nsects)
    buf.emit_u32_le(flags)
}

fn macho_segment(buf $&mc.CodeBuffer, name string, nsects int, vmaddr int, vmsize int, fileoff int, filesize int, prot int) {
    macho_segment_flags(buf, name, nsects, vmaddr, vmsize, fileoff, filesize, prot, 0)
}

fn macho_section(buf $&mc.CodeBuffer, sect string, seg string, addr int, size int, off int, align int, flags int) {
    emit_fixed_string(buf, sect, 16)
    emit_fixed_string(buf, seg, 16)
    buf.emit_u64_le(addr)
    buf.emit_u64_le(size)
    buf.emit_u32_le(off)
    buf.emit_u32_le(align)
    buf.emit_u32_le(0) // reloff
    buf.emit_u32_le(0) // nreloc
    buf.emit_u32_le(flags)
    buf.emit_u32_le(0)
    buf.emit_u32_le(0)
    buf.emit_u32_le(0)
}

fn pad_to(buf $&mc.CodeBuffer, n int) {
    while buf.len() < n {
        buf.emit_u8(0)
    }
}

pub fn macho_write_executable(code_bytes &[]int, cpu_type int, entry_offset int) mc.CodeBuffer {
    dbg := debug_sections_empty()
    syms := macho_syms_empty()
    << macho_write_executable_debug(code_bytes, cpu_type, entry_offset, &syms, &dbg)
}

pub fn macho_write_executable_arm64(code_bytes &[]int, entry_offset int) mc.CodeBuffer {
    << macho_write_executable(code_bytes, MACHO_CPU_TYPE_ARM64, entry_offset)
}

// Hardened Mach-O 64-bit executable (macOS 12+ chained fixups format):
//   __PAGEZERO   (---): 4 GiB null guard
//   __TEXT       (R-X): headers + __text
//   __DATA_CONST (RW- -> R-- via SG_READ_ONLY): in-place chained-bind pointers
//                       for _clock_gettime / _dlopen / _dlsym / _dlerror
//   __DATA       (RW-): runtime-writable __xu_ffi_state
//   __DWARF      (---, optional when -g): placed before __LINKEDIT so the
//                       embedded ad-hoc LC_CODE_SIGNATURE always terminates the
//                       file cleanly on Apple Silicon.
//   __LINKEDIT   (R--): chained fixups, exports trie, symtab, strtab, LC_CODE_SIGNATURE
pub fn macho_write_executable_debug(code_bytes &[]int, cpu_type int, entry_offset int, syms &MachoSyms, dbg &DebugSections) mc.CodeBuffer {
    $buf := mc.code_buffer_new()
    debug := dbg.present()

    page := macho_page_size(cpu_type)
    base := 0x100000000
    text_off := macho_text_file_offset(debug)
    text_vmaddr := base + text_off
    data_const_off := text_off + macho_clock_slot_offset(code_bytes.len, cpu_type, debug)
    data_const_vm := base + data_const_off
    data_vm := data_const_vm + page
    $seg_count := 5
    if debug { seg_count = 6 }
    fixups := macho_chained_fixups(page, data_const_off, seg_count)
    exports := macho_exports_trie()
    code_digest := obj_sha256_bytes(code_bytes)

    // Symbol and string tables.
    $strtab := []int{}
    strtab.push(32)
    strtab.push(0)
    $nlist := []int{}
    for i in 0:syms.names.len {
        strx := strtab.len
        strtab.push(95) // '_'
        for j in 0:syms.names[i].len {
            strtab.push(syms.names[i][j])
        }
        strtab.push(0)
        for k in 0:4 { nlist.push((strx >> (8 * k)) & 255) }
        nlist.push(0x0e) // N_SECT, local
        nlist.push(1)    // __text
        nlist.push(0)
        nlist.push(0)
        v := text_vmaddr + syms.offs[i]
        for k in 0:8 { nlist.push((v >> (8 * k)) & 255) }
    }
    imports := macho_imports()
    for ii in 0:imports.len {
        imp_strx := strtab.len
        for i in 0:imports[ii].len { strtab.push(imports[ii][i]) }
        strtab.push(0)
        for k in 0:4 { nlist.push((imp_strx >> (8 * k)) & 255) }
        nlist.push(0x01) // N_UNDF | N_EXT
        nlist.push(0)    // NO_SECT
        nlist.push(0)    // REFERENCE_FLAG_UNDEFINED_NON_LAZY
        nlist.push(1)    // libSystem ordinal in n_desc
        for k in 0:8 { nlist.push(0) }
    }
    while strtab.len % 8 != 0 {
        strtab.push(0)
    }
    nlocals := syms.names.len

    // Layout after __TEXT:
    //   release: __DATA_CONST (1 page with chained-bind slots), __DATA (zero-fill), __LINKEDIT.
    //   debug  : __DATA_CONST (1 page), __DATA (1 page), __DWARF (page-aligned), __LINKEDIT.
    $dw_off := 0
    $dw_vm := data_vm + page
    $line_off := 0
    $info_off := 0
    $abbrev_off := 0
    $dstr_off := 0
    $dw_size := 0
    $dw_seg_size := 0
    $le_off := data_const_off + page
    $le_vm := data_vm + page
    if debug {
        dw_off = data_const_off + 2 * page
        line_off = dw_off
        info_off = align8(line_off + dbg.line.len)
        abbrev_off = align8(info_off + dbg.info.len)
        dstr_off = align8(abbrev_off + dbg.abbrev.len)
        dw_size = dstr_off + dbg.str.len - dw_off
        dw_seg_size = page_up(dw_size, page)
        if dw_seg_size == 0 {
            dw_seg_size = page
        }
        le_off = dw_off + dw_seg_size
        le_vm = dw_vm + dw_seg_size
    }

    exports_off := align8(le_off + fixups.bytes.len)
    sym_off := align8(exports_off + exports.bytes.len)
    str_off := sym_off + nlist.len
    cs_off := align16(str_off + strtab.len)
    cs_size := macho_adhoc_sig_size(cs_off)
    le_size := (cs_off + cs_size) - le_off
    $le_seg_size := page_up(le_size, page)
    if le_seg_size == 0 {
        le_seg_size = page
    }

    $ncmds := 15
    if debug {
        ncmds = 16
    }
    macho_write_header($&buf, cpu_type, MACHO_FILETYPE_EXECUTE, ncmds, macho_cmds_size(debug))

    macho_segment($&buf, "__PAGEZERO", 0, 0, base, 0, 0, 0)
    macho_segment($&buf, "__TEXT", 1, base, data_const_off, 0, data_const_off, 5)
    // S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
    macho_section($&buf, "__text", "__TEXT", text_vmaddr, code_bytes.len, text_off, 4, 0x80000400)
    // __DATA_CONST is file-backed so dyld reads the in-place chained-bind pointers
    // before protecting the segment read-only (SG_READ_ONLY).
    macho_segment_flags($&buf, "__DATA_CONST", 1, data_const_vm, page, data_const_off, page, 3, SG_READ_ONLY)
    macho_section($&buf, "__got", "__DATA_CONST", data_const_vm, 32, data_const_off, 3, 0)
    if debug {
        macho_segment($&buf, "__DATA", 1, data_vm, page, data_const_off + page, page, 3)
        macho_section($&buf, "__data", "__DATA", data_vm, 8, data_const_off + page, 3, 0)
        macho_segment($&buf, "__DWARF", 4, dw_vm, dw_seg_size, dw_off, dw_seg_size, 0)
        macho_section($&buf, "__debug_line", "__DWARF", dw_vm, dbg.line.len, line_off, 0, 0)
        macho_section($&buf, "__debug_info", "__DWARF", dw_vm + (info_off - dw_off), dbg.info.len, info_off, 0, 0)
        macho_section($&buf, "__debug_abbrev", "__DWARF", dw_vm + (abbrev_off - dw_off), dbg.abbrev.len, abbrev_off, 0, 0)
        macho_section($&buf, "__debug_str", "__DWARF", dw_vm + (dstr_off - dw_off), dbg.str.len, dstr_off, 0, 0)
    } else {
        macho_segment($&buf, "__DATA", 1, data_vm, page, data_const_off + page, 0, 3)
        macho_section($&buf, "__bss", "__DATA", data_vm, 8, 0, 3, S_ZEROFILL)
    }
    macho_segment($&buf, "__LINKEDIT", 0, le_vm, le_seg_size, le_off, le_size, 1)

    buf.emit_u32_le(LC_SYMTAB)
    buf.emit_u32_le(24)
    buf.emit_u32_le(sym_off)
    buf.emit_u32_le(nlocals + imports.len)
    buf.emit_u32_le(str_off)
    buf.emit_u32_le(strtab.len)

    buf.emit_u32_le(LC_DYSYMTAB)
    buf.emit_u32_le(80)
    buf.emit_u32_le(0)     // ilocalsym
    buf.emit_u32_le(nlocals) // nlocalsym
    buf.emit_u32_le(nlocals) // iextdefsym
    buf.emit_u32_le(0)       // nextdefsym
    buf.emit_u32_le(nlocals) // iundefsym
    buf.emit_u32_le(imports.len) // nundefsym
    for i in 0:12 {
        buf.emit_u32_le(0)
    }

    buf.emit_u32_le(LC_DYLD_CHAINED_FIXUPS)
    buf.emit_u32_le(16)
    buf.emit_u32_le(le_off)
    buf.emit_u32_le(fixups.bytes.len)

    buf.emit_u32_le(LC_DYLD_EXPORTS_TRIE)
    buf.emit_u32_le(16)
    buf.emit_u32_le(exports_off)
    buf.emit_u32_le(exports.bytes.len)

    buf.emit_u32_le(LC_LOAD_DYLINKER)
    buf.emit_u32_le(32)
    buf.emit_u32_le(12) // offset to name
    emit_fixed_string($&buf, "/usr/lib/dyld", 20)

    buf.emit_u32_le(LC_LOAD_DYLIB)
    buf.emit_u32_le(56)
    buf.emit_u32_le(24) // offset to name
    buf.emit_u32_le(2) // timestamp
    buf.emit_u32_le(65536) // current_version
    buf.emit_u32_le(65536) // compatibility_version
    emit_fixed_string($&buf, "/usr/lib/libSystem.B.dylib", 32)

    buf.emit_u32_le(LC_MAIN)
    buf.emit_u32_le(24)
    buf.emit_u64_le(text_off + entry_offset) // entryoff from __TEXT start
    buf.emit_u64_le(0) // stacksize

    buf.emit_u32_le(LC_UUID)
    buf.emit_u32_le(24)
    for ui in 0:16 {
        $b := code_digest[ui] & 255
        if ui == 6 { b = (b & 0x0f) | 0x50 } // RFC 4122 version 5
        if ui == 8 { b = (b & 0x3f) | 0x80 } // RFC 4122 variant
        buf.emit_u8(b)
    }

    buf.emit_u32_le(LC_BUILD_VERSION)
    buf.emit_u32_le(24)
    buf.emit_u32_le(1)          // PLATFORM_MACOS
    buf.emit_u32_le(0x000c0000) // minos 12.0.0 (chained fixups baseline)
    buf.emit_u32_le(0x000e0000) // sdk 14.0.0
    buf.emit_u32_le(0)          // ntools

    buf.emit_u32_le(LC_CODE_SIGNATURE)
    buf.emit_u32_le(16)
    buf.emit_u32_le(cs_off)
    buf.emit_u32_le(cs_size)

    pad_to($&buf, text_off)
    buf.emit_bytes(code_bytes)
    pad_to($&buf, data_const_off)
    // Encode dyld_chained_ptr_64_bind slots (stride 4 => next=2 for 8-byte slots):
    //   bits[23:0]=ordinal, bits[62:51]=next, bit[63]=1 (bind)
    for i in 0:imports.len {
        buf.emit_u32_le(i)
        if i + 1 < imports.len {
            buf.emit_u32_le(0x80100000) // bind=1, next=2 (8 bytes)
        } else {
            buf.emit_u32_le(0x80000000) // bind=1, next=0 (end of chain)
        }
    }
    if debug {
        pad_to($&buf, line_off)
        buf.emit_bytes(&dbg.line)
        pad_to($&buf, info_off)
        buf.emit_bytes(&dbg.info)
        pad_to($&buf, abbrev_off)
        buf.emit_bytes(&dbg.abbrev)
        pad_to($&buf, dstr_off)
        buf.emit_bytes(&dbg.str)
    }
    pad_to($&buf, le_off)
    buf.emit_bytes(&fixups.bytes)
    pad_to($&buf, exports_off)
    buf.emit_bytes(&exports.bytes)
    pad_to($&buf, sym_off)
    buf.emit_bytes(&nlist)
    buf.emit_bytes(&strtab)
    pad_to($&buf, cs_off)
    macho_emit_adhoc_sig($&buf, cs_off, data_const_off)
    << buf
}
