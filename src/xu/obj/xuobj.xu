@xu/obj

#xu/mc
#xu/target

fn xuobj_string(out $&mc.CodeBuffer, value &string) {
    out.emit_u16_le(value.len)
    for i in 0:value.len {
        out.emit_u8(value[i])
    }
}

fn xuobj_text_label(out $&mc.CodeBuffer, name &string, entry int) {
    out.emit_u8(0) // Text symbol.
    out.emit_u32_le(entry)
    xuobj_string(out, name)
}

// All internal references are already fixed up within one text section.
// External calls use the existing XUOBJ v1 branch records.
pub fn write_xuobj(code &mc.CodeBuffer, os int, arch int, entry_name string, entry int, calls &[]mc.Reloc) mc.CodeBuffer {
    $out := mc.code_buffer_new()
    magic := "XUOBJ"
    for i in 0:magic.len {
        out.emit_u8(magic[i])
    }
    out.emit_u8(1)
    out.emit_u16_le(0)
    out.emit_u8(os + 1)
    out.emit_u8(arch + 1)
    out.emit_u16_le(0)
    module_name := "main"
    xuobj_string($&out, &module_name)
    out.emit_u32_le(0) // No library exports.
    if os == target.OS_LINUX {
        out.emit_u32_le(2)
        xuobj_text_label($&out, &entry_name, entry)
        // The cooperative scheduler uses no C worker factory, so both
        // Linux C entry points share the same prologue.
        hosted_entry := "xu_app_start_hosted"
        xuobj_text_label($&out, &hosted_entry, entry)
    } else {
        out.emit_u32_le(1)
        xuobj_text_label($&out, &entry_name, entry)
    }
    out.emit_u32_le(calls.len)
    for i in 0:calls.len {
        r := &calls[i]
        // FK_BL on arm64, FK_RIP32 for Windows _iat_ loads on x64, else FK_REL32.
        $kind := 0
        if arch == target.ARCH_ARM64 || (r.symbol_name.len >= 5 && r.symbol_name[0:5] == "_iat_") {
            kind = 1
        }
        out.emit_u8(kind)
        out.emit_u8(0)
        out.emit_u32_le(r.offset)
        xuobj_string($&out, &r.symbol_name)
    }
    out.emit_u32_le(code.bytes.len)
    out.emit_bytes(&code.bytes)
    out.emit_u32_le(0) // No separate data section.
    << out
}

pub fn macos_xuobj(code &mc.CodeBuffer, arch int, entry int, calls &[]mc.Reloc) mc.CodeBuffer {
    << write_xuobj(code, target.OS_MACOS, arch, "_xu_app_start", entry, calls)
}
