@xu/obj

#xu/mc

fn coff_app_symbol(out $&mc.CodeBuffer, strings $&mc.CodeBuffer, name &string, section int, value int) {
    if name.len <= 8 {
        emit_fixed_string(out, ~name, 8)
    } else {
        off := app_cstr(strings, name)
        out.emit_u32_le(0)
        out.emit_u32_le(off)
    }
    out.emit_u32_le(value)
    out.emit_u16_le(section)
    out.emit_u16_le(0)
    out.emit_u8(2) // IMAGE_SYM_CLASS_EXTERNAL
    out.emit_u8(0)
}

fn coff_app_object(app &AppObject) mc.CodeBuffer {
    text_off := 64 // 20-byte COFF header, 40-byte section header, alignment.
    reloc_off := align8(text_off + app.text.len)
    sym_off := align8(reloc_off + app.relocs.len * 10)
    $out := mc.code_buffer_new()
    out.emit_u16_le(PE_MACHINE_AMD64)
    out.emit_u16_le(1) // .text
    out.emit_u32_le(0) // timestamp
    out.emit_u32_le(sym_off)
    out.emit_u32_le(app.imports.len + 1)
    out.emit_u16_le(0) // optional header size
    out.emit_u16_le(0)
    emit_fixed_string($&out, ".text", 8)
    out.emit_u32_le(0)
    out.emit_u32_le(0)
    out.emit_u32_le(app.text.len)
    out.emit_u32_le(text_off)
    if app.relocs.len > 0 {
        out.emit_u32_le(reloc_off)
    } else {
        out.emit_u32_le(0)
    }
    out.emit_u32_le(0)
    out.emit_u16_le(app.relocs.len)
    out.emit_u16_le(0)
    out.emit_u32_le(0x60400020) // code, execute/read, align 8

    pad_to($&out, text_off)
    emit_app_text($&out, &app.text)
    pad_to($&out, reloc_off)
    for i in 0:app.relocs.len {
        out.emit_u32_le(app.relocs[i].offset)
        out.emit_u32_le(app.relocs[i].symbol)
        out.emit_u16_le(4) // IMAGE_REL_AMD64_REL32
    }
    pad_to($&out, sym_off)
    $strings := mc.code_buffer_new()
    strings.emit_u32_le(0) // total string table size, including this word
    coff_app_symbol($&out, $&strings, &app.entry, 1, app.entry_offset)
    for i in 0:app.imports.len {
        coff_app_symbol($&out, $&strings, &app.imports[i], 0, 0)
    }
    strings.patch_u32_le(0, strings.len())
    out.emit_bytes(&strings.bytes)
    << out
}
