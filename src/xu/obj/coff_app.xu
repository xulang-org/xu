@xu/obj

#xu/mc
#xu/target

fn coff_app_symbol_full(out $&mc.CodeBuffer, strings $&mc.CodeBuffer, name &string, section int, value int, sym_type int, cls int) {
    if name.len <= 8 {
        emit_fixed_string(out, ~name, 8)
    } else {
        off := app_cstr(strings, name)
        out.emit_u32_le(0)
        out.emit_u32_le(off)
    }
    out.emit_u32_le(value)
    out.emit_u16_le(section)
    out.emit_u16_le(sym_type)
    out.emit_u8(cls)
    out.emit_u8(0)
}

fn coff_app_symbol_class(out $&mc.CodeBuffer, strings $&mc.CodeBuffer, name &string, section int, value int, cls int) {
    coff_app_symbol_full(out, strings, name, section, value, 0, cls)
}

fn coff_app_symbol(out $&mc.CodeBuffer, strings $&mc.CodeBuffer, name &string, section int, value int) {
    coff_app_symbol_full(out, strings, name, section, value, 0, 2) // IMAGE_SYM_CLASS_EXTERNAL
}

fn coff_app_object(app &AppObject) mc.CodeBuffer {
    $nsecs := 1
    $text_off := 64 // 20-byte COFF header, 40-byte section header, 16-byte alignment.
    $nsyms := app.imports.len + 1
    if app.has_ffi_state {
        nsecs = 2
        text_off = 112 // 20-byte COFF header, two 40-byte section headers, 16-byte alignment.
        nsyms = app.imports.len + 2
    }
    reloc_off := align8(text_off + app.text.len)
    sym_off := align8(reloc_off + app.relocs.len * 10)
    $machine := PE_MACHINE_AMD64
    $reloc_type := 4 // IMAGE_REL_AMD64_REL32
    if app.arch == target.ARCH_ARM64 {
        machine = PE_MACHINE_ARM64
        reloc_type = 3 // IMAGE_REL_ARM64_BRANCH26
    }
    $out := mc.code_buffer_new()
    out.emit_u16_le(machine)
    out.emit_u16_le(nsecs)
    out.emit_u32_le(0) // timestamp
    out.emit_u32_le(sym_off)
    out.emit_u32_le(nsyms)
    out.emit_u16_le(0) // optional header size
    out.emit_u16_le(0)
    emit_fixed_string($&out, ".text", 8)
    out.emit_u32_le(0)
    out.emit_u32_le(0)
    out.emit_u32_le(app.text.len)
    out.emit_u32_le(text_off)
    if app.relocs.len > 0 {
        out.emit_u32_le(reloc_off)
    } else {
        out.emit_u32_le(0)
    }
    out.emit_u32_le(0)
    out.emit_u16_le(app.relocs.len)
    out.emit_u16_le(0)
    out.emit_u32_le(0x60500020) // code, execute/read, align 16
    if app.has_ffi_state {
        emit_fixed_string($&out, ".bss", 8)
        out.emit_u32_le(0)
        out.emit_u32_le(0)
        out.emit_u32_le(8)
        out.emit_u32_le(0)
        out.emit_u32_le(0)
        out.emit_u32_le(0)
        out.emit_u16_le(0)
        out.emit_u16_le(0)
        out.emit_u32_le(0xC0400080) // uninitialized data, read/write, align 8
    }

    pad_to($&out, text_off)
    emit_app_text($&out, &app.text)
    pad_to($&out, reloc_off)
    for i in 0:app.relocs.len {
        reloc := &app.relocs[i]
        $sym_idx := reloc.symbol
        if reloc.symbol < 0 {
            sym_idx = 1
        } else if app.has_ffi_state {
            sym_idx = reloc.symbol + 1
        }
        $rtype := reloc_type
        if app.arch == target.ARCH_ARM64 {
            if reloc.kind == 2 { rtype = 4 } // IMAGE_REL_ARM64_PAGEBASE_REL21
            if reloc.kind == 3 { rtype = 6 } // IMAGE_REL_ARM64_PAGEOFFSET_12A
        }
        out.emit_u32_le(reloc.offset)
        out.emit_u32_le(sym_idx)
        out.emit_u16_le(rtype)
    }
    pad_to($&out, sym_off)
    $strings := mc.code_buffer_new()
    strings.emit_u32_le(0) // total string table size, including this word
    coff_app_symbol_full($&out, $&strings, &app.entry, 1, app.entry_offset, 0x20, 2) // IMAGE_SYM_DTYPE_FUNCTION | EXTERNAL
    if app.has_ffi_state {
        state_lbl := "__xu_ffi_state"
        coff_app_symbol_class($&out, $&strings, &state_lbl, 2, 0, 3) // IMAGE_SYM_CLASS_STATIC
    }
    for i in 0:app.imports.len {
        coff_app_symbol($&out, $&strings, &app.imports[i], 0, 0)
    }
    strings.patch_u32_le(0, strings.len())
    out.emit_bytes(&strings.bytes)
    << out
}
