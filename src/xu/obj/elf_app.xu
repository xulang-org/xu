@xu/obj

#xu/mc
#xu/target

fn elf_app_symbol(out $&mc.CodeBuffer, name int, info int, section int, offset int) {
    out.emit_u32_le(name)
    out.emit_u8(info)
    out.emit_u8(0) // st_other
    out.emit_u16_le(section)
    out.emit_u64_le(offset)
    out.emit_u64_le(0) // st_size
}

fn elf_app_object(app &AppObject) mc.CodeBuffer {
    $machine := ELF_EM_X86_64
    $call_reloc := 4 // R_X86_64_PLT32
    $call_addend := -4 // x64 displacement is relative to the next instruction
    if app.arch == target.ARCH_ARM64 {
        machine = ELF_EM_AARCH64
        call_reloc = 283 // R_AARCH64_CALL26
        call_addend = 0
    }

    $out := mc.code_buffer_new()
    elf64_ident($&out)
    out.emit_u16_le(1) // ET_REL
    out.emit_u16_le(machine)
    out.emit_u32_le(1) // EV_CURRENT
    out.emit_u64_le(0) // e_entry
    out.emit_u64_le(0) // e_phoff
    shoff_at := out.len()
    out.emit_u64_le(0) // e_shoff, patched below
    out.emit_u32_le(0) // e_flags
    out.emit_u16_le(64) // e_ehsize
    out.emit_u16_le(0) // e_phentsize
    out.emit_u16_le(0) // e_phnum
    out.emit_u16_le(64) // e_shentsize
    out.emit_u16_le(7) // e_shnum
    out.emit_u16_le(5) // e_shstrndx

    text_off := out.len()
    emit_app_text($&out, &app.text)
    elf_pad8($&out)
    rela_off := out.len()
    for i in 0:app.relocs.len {
        reloc := &app.relocs[i]
        out.emit_u64_le(reloc.offset)
        out.emit_u64_le(((reloc.symbol + 2) << 32) | call_reloc)
        out.emit_u64_le(call_addend)
    }
    rela_size := out.len() - rela_off

    $strtab := mc.code_buffer_new()
    strtab.emit_u8(0)
    sym_off := out.len()
    elf_app_symbol($&out, 0, 0, 0, 0) // STN_UNDEF
    entry := app_cstr($&strtab, &app.entry)
    hosted_name := "xu_app_start_hosted"
    hosted_entry := app_cstr($&strtab, &hosted_name)
    elf_app_symbol($&out, entry, 0x12, 1, app.entry_offset) // STB_GLOBAL | STT_FUNC
    elf_app_symbol($&out, hosted_entry, 0x12, 1, app.hosted_entry_offset)
    for i in 0:app.imports.len {
        name := app_cstr($&strtab, &app.imports[i])
        elf_app_symbol($&out, name, 0x10, 0, 0) // undefined global
    }
    sym_size := out.len() - sym_off
    str_off := out.len()
    out.emit_bytes(&strtab.bytes)
    shstr_off := out.len()
    out.emit_u8(0)
    $names := []int{}
    for name in [".text", ".rela.text", ".symtab", ".strtab", ".shstrtab", ".note.GNU-stack"] {
        names.push(app_cstr($&out, &name) - shstr_off)
    }
    shstr_size := out.len() - shstr_off
    elf_pad8($&out)

    shoff := out.len()
    out.patch_u64_le(shoff_at, shoff)
    elf_shdr($&out, 0, 0, 0, 0, 0, 0, 0)
    elf_shdr($&out, names[0], 1, 6, 0, text_off, app.text.len, 16)
    // .rela.text links to .symtab (3) and applies to .text (1).
    elf_shdr_link($&out, names[1], 4, 0x40, 0, rela_off, rela_size, 3, 1, 8, 24)
    // .symtab links to .strtab (4); symbol 1 is the first global.
    elf_shdr_link($&out, names[2], 2, 0, 0, sym_off, sym_size, 4, 1, 8, 24)
    elf_shdr($&out, names[3], 3, 0, 0, str_off, strtab.len(), 1)
    elf_shdr($&out, names[4], 3, 0, 0, shstr_off, shstr_size, 1)
    elf_shdr($&out, names[5], 1, 0, 0, shoff, 0, 1) // non-executable stack
    << out
}
