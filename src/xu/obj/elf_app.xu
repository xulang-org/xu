@xu/obj

#xu/mc
#xu/target

fn elf_app_symbol_sized(out $&mc.CodeBuffer, name int, info int, section int, offset int, size int) {
    out.emit_u32_le(name)
    out.emit_u8(info)
    out.emit_u8(0) // st_other
    out.emit_u16_le(section)
    out.emit_u64_le(offset)
    out.emit_u64_le(size) // st_size
}

fn elf_app_symbol(out $&mc.CodeBuffer, name int, info int, section int, offset int) {
    elf_app_symbol_sized(out, name, info, section, offset, 0)
}

fn elf_app_object(app &AppObject) mc.CodeBuffer {
    $machine := ELF_EM_X86_64
    $call_reloc := 4 // R_X86_64_PLT32
    $call_addend := -4 // x64 displacement is relative to the next instruction
    if app.arch == target.ARCH_ARM64 {
        machine = ELF_EM_AARCH64
        call_reloc = 283 // R_AARCH64_CALL26
        call_addend = 0
    }

    $shnum := 7
    $shstrndx := 5
    $sym_link := 4
    $sym_info := 1
    $sec_sym := 3
    if app.has_ffi_state {
        shnum = 8
        shstrndx = 6
        sym_link = 5
        sym_info = 2
        sec_sym = 4
    }

    $out := mc.code_buffer_new()
    elf64_ident($&out)
    out.emit_u16_le(1) // ET_REL
    out.emit_u16_le(machine)
    out.emit_u32_le(1) // EV_CURRENT
    out.emit_u64_le(0) // e_entry
    out.emit_u64_le(0) // e_phoff
    shoff_at := out.len()
    out.emit_u64_le(0) // e_shoff, patched below
    out.emit_u32_le(0) // e_flags
    out.emit_u16_le(64) // e_ehsize
    out.emit_u16_le(0) // e_phentsize
    out.emit_u16_le(0) // e_phnum
    out.emit_u16_le(64) // e_shentsize
    out.emit_u16_le(shnum) // e_shnum
    out.emit_u16_le(shstrndx) // e_shstrndx

    text_off := out.len()
    emit_app_text($&out, &app.text)
    elf_pad8($&out)
    rela_off := out.len()
    for i in 0:app.relocs.len {
        reloc := &app.relocs[i]
        $sym_idx := reloc.symbol + 2
        if reloc.symbol < 0 {
            sym_idx = 1
        } else if app.has_ffi_state {
            sym_idx = reloc.symbol + 3
        }
        $rtype := call_reloc
        if reloc.kind == 2 {
            if app.arch == target.ARCH_ARM64 { rtype = 275 } else { rtype = 2 }
        } else if reloc.kind == 3 {
            rtype = 277
        }
        out.emit_u64_le(reloc.offset)
        out.emit_u64_le((sym_idx << 32) | rtype)
        out.emit_u64_le(call_addend)
    }
    rela_size := out.len() - rela_off

    $strtab := mc.code_buffer_new()
    strtab.emit_u8(0)
    sym_off := out.len()
    elf_app_symbol($&out, 0, 0, 0, 0) // STN_UNDEF
    if app.has_ffi_state {
        state_lbl := "__xu_ffi_state"
        state_name := app_cstr($&strtab, &state_lbl)
        elf_app_symbol_sized($&out, state_name, 0x01, 3, 0, 8) // STB_LOCAL | STT_OBJECT in .bss
    }
    entry := app_cstr($&strtab, &app.entry)
    hosted_name := "xu_app_start_hosted"
    hosted_entry := app_cstr($&strtab, &hosted_name)
    elf_app_symbol($&out, entry, 0x12, 1, app.entry_offset) // STB_GLOBAL | STT_FUNC
    elf_app_symbol($&out, hosted_entry, 0x12, 1, app.hosted_entry_offset)
    for i in 0:app.imports.len {
        name := app_cstr($&strtab, &app.imports[i])
        elf_app_symbol($&out, name, 0x10, 0, 0) // undefined global
    }
    sym_size := out.len() - sym_off
    str_off := out.len()
    out.emit_bytes(&strtab.bytes)
    shstr_off := out.len()
    out.emit_u8(0)
    $sec_names := [".text", ".rela.text", ".symtab", ".strtab", ".shstrtab", ".note.GNU-stack"]
    if app.has_ffi_state {
        sec_names = [".text", ".rela.text", ".bss", ".symtab", ".strtab", ".shstrtab", ".note.GNU-stack"]
    }
    $names := []int{}
    for name in sec_names {
        names.push(app_cstr($&out, &name) - shstr_off)
    }
    shstr_size := out.len() - shstr_off
    elf_pad8($&out)

    shoff := out.len()
    out.patch_u64_le(shoff_at, shoff)
    elf_shdr($&out, 0, 0, 0, 0, 0, 0, 0)
    elf_shdr($&out, names[0], 1, 6, 0, text_off, app.text.len, 16)
    // .rela.text links to .symtab and applies to .text (1).
    elf_shdr_link($&out, names[1], 4, 0x40, 0, rela_off, rela_size, sec_sym, 1, 8, 24)
    $ni := 2
    if app.has_ffi_state {
        elf_shdr($&out, names[2], 8, 3, 0, str_off + strtab.len(), 8, 8) // .bss: SHT_NOBITS, SHF_WRITE | SHF_ALLOC
        ni = 3
    }
    // .symtab links to .strtab; sh_info is first global symbol index.
    elf_shdr_link($&out, names[ni], 2, 0, 0, sym_off, sym_size, sym_link, sym_info, 8, 24)
    elf_shdr($&out, names[ni + 1], 3, 0, 0, str_off, strtab.len(), 1)
    elf_shdr($&out, names[ni + 2], 3, 0, 0, shstr_off, shstr_size, 1)
    elf_shdr($&out, names[ni + 3], 1, 0, 0, shoff, 0, 1) // non-executable stack
    << out
}
