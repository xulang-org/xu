@xu/obj
// Dynamically linked ELF executable for programs that use the C FFI.
//
// Same image as elf_write_executable (one RWX PT_LOAD, code at
// ELF_CODE_OFFSET), followed by the program headers and the dynamic
// section the system loader needs: PT_INTERP, DT_NEEDED libc (and libdl
// for glibc before 2.34) and GLOB_DAT relocations that bind the loader
// slots at got_offset in the code to dlopen, dlsym and dlerror. Every
// other C symbol is found at run time through dlsym.

#xu/mc

const PT_DYNAMIC = 2
const PT_INTERP = 3
const PT_PHDR = 6
const PT_GNU_STACK = 0x6474e551

pub fn elf_dyn_interp(machine int) string {
    if machine == ELF_EM_X86_64 { << "/lib64/ld-linux-x86-64.so.2" }
    if machine == ELF_EM_RISCV { << "/lib/ld-linux-riscv64-lp64d.so.1" }
    if machine == ELF_EM_LOONGARCH { << "/lib64/ld-linux-loongarch-lp64d.so.1" }
    << "/lib/ld-linux-aarch64.so.1"
}

fn elf_dyn_glob_dat(machine int) int {
    if machine == ELF_EM_X86_64 { << 6 }
    if machine == ELF_EM_RISCV || machine == ELF_EM_LOONGARCH { << 2 }
    << 1025
}

fn elf_cstr(buf $&mc.CodeBuffer, s &string) {
    for i in 0:s.len { buf.emit_u8(s[i] & 255) }
    buf.emit_u8(0)
}

fn elf_phdr(buf $&mc.CodeBuffer, typ int, flags int, off int, vaddr int, size int, align int) {
    buf.emit_u32_le(typ)
    buf.emit_u32_le(flags)
    buf.emit_u64_le(off)
    buf.emit_u64_le(vaddr)
    buf.emit_u64_le(vaddr)
    buf.emit_u64_le(size)
    buf.emit_u64_le(size)
    buf.emit_u64_le(align)
}

fn elf_dyn(buf $&mc.CodeBuffer, tag int, val int) {
    buf.emit_u64_le(tag)
    buf.emit_u64_le(val)
}

pub fn elf_write_dynamic_executable(code_bytes &[]int, machine int, entry_offset int, got_offset int, interp string) mc.CodeBuffer {
    base := ELF_BASE_VADDR
    code_off := ELF_CODE_OFFSET
    imports := ["dlopen", "dlsym", "dlerror"]
    needed := ["libdl.so.2", "libc.so.6"]
    nph := 5
    // Tail layout, from the end of the code (8-aligned).
    $off := code_off + code_bytes.len
    off = (off + 7) / 8 * 8
    ph_off := off
    off += nph * 56
    interp_off := off
    off += interp.len + 1
    str_off := off
    $strtab := mc.code_buffer_new()
    strtab.emit_u8(0)
    $need_name := []int{}
    for i in 0:needed.len {
        need_name.push(strtab.len())
        elf_cstr($&strtab, &needed[i])
    }
    $sym_name := []int{}
    for i in 0:imports.len {
        sym_name.push(strtab.len())
        elf_cstr($&strtab, &imports[i])
    }
    off += strtab.len()
    off = (off + 7) / 8 * 8
    sym_off := off
    nsym := imports.len + 1
    off += nsym * 24
    hash_off := off
    off += (2 + 1 + nsym) * 4
    off = (off + 7) / 8 * 8
    rela_off := off
    off += imports.len * 24
    dyn_off := off
    ndyn := needed.len + 12
    off += ndyn * 16
    file_size := off

    $buf := mc.code_buffer_new()
    elf64_ident($&buf)
    buf.emit_u16_le(2) // ET_EXEC
    buf.emit_u16_le(machine)
    buf.emit_u32_le(1)
    buf.emit_u64_le(base + code_off + entry_offset)
    buf.emit_u64_le(ph_off)
    buf.emit_u64_le(0)
    $flags := 0
    if machine == ELF_EM_LOONGARCH { flags = 0x43 }
    if machine == ELF_EM_RISCV { flags = 5 } // RVC | double-float ABI
    buf.emit_u32_le(flags)
    buf.emit_u16_le(64)
    buf.emit_u16_le(56)
    buf.emit_u16_le(nph)
    buf.emit_u16_le(64)
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)
    while buf.len() < code_off { buf.emit_u8(0) }
    buf.emit_bytes(code_bytes)
    while buf.len() < ph_off { buf.emit_u8(0) }
    elf_phdr($&buf, PT_PHDR, PF_R, ph_off, base + ph_off, nph * 56, 8)
    elf_phdr($&buf, PT_INTERP, PF_R, interp_off, base + interp_off, interp.len + 1, 1)
    elf_phdr($&buf, PT_LOAD, PF_R | PF_W | PF_X, 0, base, file_size, 4096)
    elf_phdr($&buf, PT_DYNAMIC, PF_R | PF_W, dyn_off, base + dyn_off, ndyn * 16, 8)
    elf_phdr($&buf, PT_GNU_STACK, PF_R | PF_W, 0, 0, 0, 16)
    elf_cstr($&buf, &interp)
    buf.emit_bytes(&strtab.bytes)
    while buf.len() < sym_off { buf.emit_u8(0) }
    for i in 0:24 { buf.emit_u8(0) }
    for i in 0:imports.len {
        buf.emit_u32_le(sym_name[i])
        buf.emit_u8(0x12) // STB_GLOBAL, STT_FUNC
        buf.emit_u8(0)
        buf.emit_u16_le(0)
        buf.emit_u64_le(0)
        buf.emit_u64_le(0)
    }
    // DT_HASH: one bucket chaining every symbol (lookups into this image).
    buf.emit_u32_le(1)
    buf.emit_u32_le(nsym)
    buf.emit_u32_le(nsym - 1)
    buf.emit_u32_le(0)
    for i in 1:nsym { buf.emit_u32_le(i - 1) }
    while buf.len() < rela_off { buf.emit_u8(0) }
    for i in 0:imports.len {
        buf.emit_u64_le(base + code_off + got_offset + i * 8)
        buf.emit_u64_le(((i + 1) << 32) | elf_dyn_glob_dat(machine))
        buf.emit_u64_le(0)
    }
    for i in 0:needed.len { elf_dyn($&buf, 1, need_name[i]) } // DT_NEEDED
    elf_dyn($&buf, 4, base + hash_off) // DT_HASH
    elf_dyn($&buf, 5, base + str_off) // DT_STRTAB
    elf_dyn($&buf, 6, base + sym_off) // DT_SYMTAB
    elf_dyn($&buf, 10, strtab.len()) // DT_STRSZ
    elf_dyn($&buf, 11, 24) // DT_SYMENT
    elf_dyn($&buf, 7, base + rela_off) // DT_RELA
    elf_dyn($&buf, 8, imports.len * 24) // DT_RELASZ
    elf_dyn($&buf, 9, 24) // DT_RELAENT
    elf_dyn($&buf, 30, 8) // DT_FLAGS: DF_BIND_NOW
    elf_dyn($&buf, 0x6ffffffb, 1) // DT_FLAGS_1: DF_1_NOW
    elf_dyn($&buf, 21, 0) // DT_DEBUG
    elf_dyn($&buf, 0, 0)
    << buf
}
