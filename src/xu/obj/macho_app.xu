@xu/obj

#xu/mc
#xu/target

const LC_BUILD_VERSION = 0x32

fn macho_app_symbol(syms $&mc.CodeBuffer, strx int, section int, value int) {
    syms.emit_u32_le(strx)
    if section == 0 {
        syms.emit_u8(0x01) // N_UNDF | N_EXT
    } else {
        syms.emit_u8(0x0f) // N_SECT | N_EXT
    }
    syms.emit_u8(section)
    syms.emit_u16_le(0)
    syms.emit_u64_le(value)
}

fn macho_app_object(app &AppObject) mc.CodeBuffer {
    << macho_app_object_platform(app, 1, 0x000b0000)
}

fn macho_app_object_platform(app &AppObject, platform int, minimum int) mc.CodeBuffer {
    $cpu := MACHO_CPU_TYPE_ARM64
    if app.arch == target.ARCH_X64 {
        cpu = MACHO_CPU_TYPE_X86_64
    }

    $names := mc.code_buffer_new()
    names.emit_u8(0)
    $syms := mc.code_buffer_new()
    entry_name := app_cstr($&names, &app.entry)
    macho_app_symbol($&syms, entry_name, 1, app.entry_offset)
    for i in 0:app.imports.len {
        strx := app_cstr($&names, &app.imports[i])
        macho_app_symbol($&syms, strx, 0, 0)
    }

    cmds := 152 + 24 + 24 + 80 // LC_SEGMENT_64, BUILD_VERSION, SYMTAB, DYSYMTAB
    text_off := align8(32 + cmds)
    reloc_off := align8(text_off + app.text.len)
    sym_off := reloc_off + app.relocs.len * 8
    str_off := sym_off + syms.len()
    $out := mc.code_buffer_new()
    macho_write_header($&out, cpu, MACHO_FILETYPE_OBJECT, 4, cmds)
    macho_segment($&out, "", 1, 0, app.text.len, text_off, app.text.len, 7)
    section_off := out.len()
    macho_section($&out, "__text", "__TEXT", 0, app.text.len, text_off, 3, 0x80000400)
    if app.relocs.len > 0 {
        out.patch_u32_le(section_off + 56, reloc_off) // section_64.reloff
        out.patch_u32_le(section_off + 60, app.relocs.len)
    }
    out.emit_u32_le(LC_BUILD_VERSION)
    out.emit_u32_le(24)
    out.emit_u32_le(platform)
    out.emit_u32_le(minimum)
    out.emit_u32_le(minimum)
    out.emit_u32_le(0)
    out.emit_u32_le(LC_SYMTAB)
    out.emit_u32_le(24)
    out.emit_u32_le(sym_off)
    out.emit_u32_le(app.imports.len + 1)
    out.emit_u32_le(str_off)
    out.emit_u32_le(names.len())
    out.emit_u32_le(LC_DYSYMTAB)
    out.emit_u32_le(80)
    out.emit_u32_le(0) // ilocalsym
    out.emit_u32_le(0) // nlocalsym
    out.emit_u32_le(0) // iextdefsym
    out.emit_u32_le(1) // nextdefsym
    out.emit_u32_le(1) // iundefsym
    out.emit_u32_le(app.imports.len)
    for i in 0:12 { out.emit_u32_le(0) }

    pad_to($&out, text_off)
    emit_app_text($&out, &app.text)
    pad_to($&out, reloc_off)
    // Both arm64 BRANCH26 and x64 BRANCH use relocation type 2.
    // The flags mark a PC-relative, external, four-byte relocation.
    for i in 0:app.relocs.len {
        index := app.relocs.len - 1 - i
        reloc := &app.relocs[index]
        out.emit_u32_le(reloc.offset)
        out.emit_u32_le(0x2d000000 | reloc.symbol)
    }
    out.emit_bytes(&syms.bytes)
    out.emit_bytes(&names.bytes)
    << out
}
