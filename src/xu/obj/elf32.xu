@xu/obj
// ELF 32-bit binary serialization for embedded and bare-metal targets.
//
// Layer 4D module: generates ELF32 ET_EXEC and ET_REL containers for:
// - Xtensa ESP32 (LX6, EM_XTENSA 94, EF_XTENSA 0x300)
// - RISC-V 32 (RV32IMAC, EM_RISCV 243, ESP32-C3 / virt)
// - ARM Cortex-M / Thumb (EM_ARM 40, STM32F4 / MPS2)

#xu/mc

pub const ELF_MACHINE_ARM32 = 40
pub const ELF_MACHINE_XTENSA = 94
pub const ELF_MACHINE_RISCV32 = 243

pub const EF_XTENSA = 768               // 0x300 as emitted by esp32 gcc/clang
pub const EF_ARM_EABI_VER5 = 83886080    // 0x05000000

// Memory base addresses for embedded architectures
pub const ELF32_ESP32_CODE_BASE = 1074593824       // 0x400D0020 (IROM flash execution)
pub const ELF32_ESP32_IRAM_CODE_BASE = 1074266112  // 0x40080000 (IRAM internal fast SRAM)
pub const ELF32_ESP32_DATA_BASE = 1073479680       // 0x3FFC0000 (DRAM)
pub const ELF32_ESP32_STACK_TOP = 1073610752       // 0x3FFE0000

pub const ELF32_RISCV_VIRT_CODE_BASE = 2147483648  // 0x80000000
pub const ELF32_RISCV_VIRT_DATA_BASE = 2164260864  // 0x81000000

pub const ELF32_STM32F4_CODE_BASE = 134217728      // 0x08000000 (Flash)
pub const ELF32_STM32F4_DATA_BASE = 536870912      // 0x20000000 (SRAM)

fn elf32_put_u8(cb $&mc.CodeBuffer, v int) {
    cb.emit_u8(v & 255)
}

fn elf32_put_u16_le(cb $&mc.CodeBuffer, v int) {
    cb.emit_u8(v & 255)
    cb.emit_u8((v / 256) & 255)
}

fn elf32_put_u32_le(cb $&mc.CodeBuffer, v int) {
    cb.emit_u8(v & 255)
    cb.emit_u8((v / 256) & 255)
    cb.emit_u8((v / 65536) & 255)
    cb.emit_u8((v / 16777216) & 255)
}

pub fn elf32_write_executable(text_bytes &[]int, machine int, entry_offset int, code_base int, flags int) mc.CodeBuffer {
    $cb := mc.code_buffer_new()

    // 1. ELF Identification (16 bytes)
    elf32_put_u8($&cb, 127) // 0x7f
    elf32_put_u8($&cb, 69)  // 'E'
    elf32_put_u8($&cb, 76)  // 'L'
    elf32_put_u8($&cb, 70)  // 'F'
    elf32_put_u8($&cb, 1)   // ELFCLASS32 (32-bit)
    elf32_put_u8($&cb, 1)   // ELFDATA2LSB (little endian)
    elf32_put_u8($&cb, 1)   // EV_CURRENT
    elf32_put_u8($&cb, 0)   // ELFOSABI_NONE
    for _ in 0:8 {
        elf32_put_u8($&cb, 0) // ABI version + padding
    }

    // 2. ELF32 File Header (36 bytes remainder -> total 52 bytes)
    elf32_put_u16_le($&cb, 2)            // e_type = ET_EXEC (executable)
    elf32_put_u16_le($&cb, machine)      // e_machine
    elf32_put_u32_le($&cb, 1)            // e_version = EV_CURRENT
    // The segment maps the code (after the headers in the file) at
    // code_base: boards start executing at the load address.
    entry_addr := code_base + entry_offset
    elf32_put_u32_le($&cb, entry_addr)   // e_entry
    elf32_put_u32_le($&cb, 52)           // e_phoff = 52 (immediately follows Elf32_Ehdr)
    elf32_put_u32_le($&cb, 0)            // e_shoff (no section headers for bare executable)
    elf32_put_u32_le($&cb, flags)        // e_flags (e.g. EF_XTENSA / EF_ARM_EABI)
    elf32_put_u16_le($&cb, 52)           // e_ehsize = 52 bytes
    elf32_put_u16_le($&cb, 32)           // e_phentsize = 32 bytes (Elf32_Phdr size)
    elf32_put_u16_le($&cb, 1)            // e_phnum = 1 (single LOAD segment)
    elf32_put_u16_le($&cb, 40)           // e_shentsize = 40 bytes
    elf32_put_u16_le($&cb, 0)            // e_shnum = 0
    elf32_put_u16_le($&cb, 0)            // e_shstrndx = 0

    // 3. Program Header (Elf32_Phdr: 32 bytes)
    file_hdr_len := 52 + 32              // 84 bytes
    rem := file_hdr_len % 16
    $pad := 0
    if rem != 0 {
        pad = 16 - rem
    }
    aligned_code_off := file_hdr_len + pad
    code_size := text_bytes.len

    elf32_put_u32_le($&cb, 1)            // p_type = PT_LOAD
    elf32_put_u32_le($&cb, aligned_code_off) // p_offset
    elf32_put_u32_le($&cb, code_base)    // p_vaddr
    elf32_put_u32_le($&cb, code_base)    // p_paddr
    elf32_put_u32_le($&cb, code_size)    // p_filesz
    elf32_put_u32_le($&cb, code_size)    // p_memsz
    elf32_put_u32_le($&cb, 7)            // p_flags = PF_R | PF_W | PF_X
    elf32_put_u32_le($&cb, 16)           // p_align

    for _ in 0:pad {
        elf32_put_u8($&cb, 0)
    }

    // 4. Payload code bytes
    for i in 0:text_bytes.len {
        elf32_put_u8($&cb, text_bytes[i])
    }

    << cb
}

pub fn elf32_write_esp32_executable(text_bytes &[]int, entry_offset int, is_iram bool) mc.CodeBuffer {
    $code_base := ELF32_ESP32_CODE_BASE
    if is_iram {
        code_base = ELF32_ESP32_IRAM_CODE_BASE
    }
    << elf32_write_executable(text_bytes, ELF_MACHINE_XTENSA, entry_offset, code_base, EF_XTENSA)
}

pub fn elf32_write_riscv32_executable(text_bytes &[]int, entry_offset int) mc.CodeBuffer {
    << elf32_write_executable(text_bytes, ELF_MACHINE_RISCV32, entry_offset, ELF32_RISCV_VIRT_CODE_BASE, 0)
}

pub fn elf32_write_thumb_executable(text_bytes &[]int, entry_offset int) mc.CodeBuffer {
    << elf32_write_executable(text_bytes, ELF_MACHINE_ARM32, entry_offset, ELF32_STM32F4_CODE_BASE, EF_ARM_EABI_VER5)
}

pub fn elf32_write_xtensa_obj(text_bytes &[]int) mc.CodeBuffer {
    // Generates an ELF32 ET_REL object file for Xtensa ESP32 to link via ESP-IDF toolchain
    $cb := mc.code_buffer_new()

    // ELF32 Header
    elf32_put_u8($&cb, 127)
    elf32_put_u8($&cb, 69)
    elf32_put_u8($&cb, 76)
    elf32_put_u8($&cb, 70)
    elf32_put_u8($&cb, 1)   // ELFCLASS32
    elf32_put_u8($&cb, 1)   // ELFDATA2LSB
    elf32_put_u8($&cb, 1)   // EV_CURRENT
    elf32_put_u8($&cb, 0)
    for _ in 0:8 {
        elf32_put_u8($&cb, 0)
    }

    text_size := text_bytes.len
    $shstrtab := []int{}
    shstrtab.push(0)
    name1 := ".text"
    for i in 0:name1.len { shstrtab.push(name1[i]) }
    shstrtab.push(0)
    name2 := ".shstrtab"
    for i in 0:name2.len { shstrtab.push(name2[i]) }
    shstrtab.push(0)
    shstrtab_size := shstrtab.len

    text_off := 52
    shstrtab_off := text_off + text_size
    $shdr_off := shstrtab_off + shstrtab_size
    rem := shdr_off % 4
    if rem != 0 {
        shdr_off += (4 - rem)
    }

    elf32_put_u16_le($&cb, 1)            // e_type = ET_REL (relocatable)
    elf32_put_u16_le($&cb, ELF_MACHINE_XTENSA) // e_machine = 94
    elf32_put_u32_le($&cb, 1)            // e_version
    elf32_put_u32_le($&cb, 0)            // e_entry = 0
    elf32_put_u32_le($&cb, 0)            // e_phoff = 0
    elf32_put_u32_le($&cb, shdr_off)     // e_shoff
    elf32_put_u32_le($&cb, EF_XTENSA)    // e_flags = 0x300
    elf32_put_u16_le($&cb, 52)           // e_ehsize
    elf32_put_u16_le($&cb, 0)            // e_phentsize
    elf32_put_u16_le($&cb, 0)            // e_phnum
    elf32_put_u16_le($&cb, 40)           // e_shentsize = 40
    elf32_put_u16_le($&cb, 3)            // e_shnum = 3 (NULL, .text, .shstrtab)
    elf32_put_u16_le($&cb, 2)            // e_shstrndx = 2

    // Emit .text
    for i in 0:text_bytes.len {
        elf32_put_u8($&cb, text_bytes[i])
    }

    // Emit .shstrtab
    for si in 0:shstrtab.len {
        elf32_put_u8($&cb, shstrtab[si])
    }

    // Align to 4 bytes for Section Headers
    while cb.len() < shdr_off {
        elf32_put_u8($&cb, 0)
    }

    // Section Header 0: NULL
    for _ in 0:10 {
        elf32_put_u32_le($&cb, 0)
    }

    // Section Header 1: .text (name offset 1)
    elf32_put_u32_le($&cb, 1)            // sh_name (".text")
    elf32_put_u32_le($&cb, 1)            // sh_type = SHT_PROGBITS
    elf32_put_u32_le($&cb, 6)            // sh_flags = SHF_ALLOC | SHF_EXECINSTR
    elf32_put_u32_le($&cb, 0)            // sh_addr = 0
    elf32_put_u32_le($&cb, text_off)     // sh_offset
    elf32_put_u32_le($&cb, text_size)    // sh_size
    elf32_put_u32_le($&cb, 0)            // sh_link
    elf32_put_u32_le($&cb, 0)            // sh_info
    elf32_put_u32_le($&cb, 4)            // sh_addralign
    elf32_put_u32_le($&cb, 0)            // sh_entsize

    // Section Header 2: .shstrtab (name offset 7)
    elf32_put_u32_le($&cb, 7)            // sh_name (".shstrtab")
    elf32_put_u32_le($&cb, 3)            // sh_type = SHT_STRTAB
    elf32_put_u32_le($&cb, 0)            // sh_flags
    elf32_put_u32_le($&cb, 0)            // sh_addr
    elf32_put_u32_le($&cb, shstrtab_off) // sh_offset
    elf32_put_u32_le($&cb, shstrtab_size) // sh_size
    elf32_put_u32_le($&cb, 0)            // sh_link
    elf32_put_u32_le($&cb, 0)            // sh_info
    elf32_put_u32_le($&cb, 1)            // sh_addralign
    elf32_put_u32_le($&cb, 0)            // sh_entsize

    << cb
}
