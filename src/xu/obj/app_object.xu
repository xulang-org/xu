@xu/obj

#errors
#xu/mc
#xu/target

struct AppObjectReader {
    data string
    pos int
}

struct AppObjectReloc {
    offset int
    symbol int
}

struct AppObject {
    arch int
    entry string
    entry_offset int
    hosted_entry_offset int
    imports []string
    relocs []AppObjectReloc
    text string
}

fn (r $&AppObjectReader) take(size int) string {
    if size > r.data.len - r.pos {
        >> errors.new("truncated XUOBJ")
    }
    start := r.pos
    r.pos += size
    << r.data[start:r.pos]
}

fn (r $&AppObjectReader) number(size int) int {
    if size > r.data.len - r.pos {
        >> errors.new("truncated XUOBJ")
    }
    $n := 0
    for i in 0:size {
        n = n | ((r.data[r.pos + i] & 255) << (i * 8))
    }
    r.pos += size
    << n
}

fn (r $&AppObjectReader) name() string {
    size := r.number(2) or >>
    << r.take(size) or >>
}

fn app_import_index(imports $&[]string, name &string) int {
    for i in 0:imports.len {
        if imports[i] == name + "" {
            << i + 1
        }
    }
    imports.push(~name)
    << imports.len
}

fn read_app_object(data &string, os int) AppObject {
    $r := AppObjectReader{data: ~data, pos: 0}
    magic := r.take(5) or >>
    version := r.number(1) or >>
    flags := r.number(2) or >>
    if magic != "XUOBJ" || version != 1 || flags != 0 {
        >> errors.new("expected a XUOBJ v1 application object")
    }
    wire_os := r.number(1) or >>
    arch := (r.number(1) or >>) - 1
    reserved := r.number(2) or >>
    if wire_os != os + 1 || reserved != 0 || (arch != target.ARCH_X64 && arch != target.ARCH_ARM64) {
        >> errors.new("unsupported XUOBJ target")
    }
    r.name() or >> // Module name.
    exports := r.number(4) or >>
    labels := r.number(4) or >>
    section := r.number(1) or >>
    entry_offset := r.number(4) or >>
    entry := r.name() or >>
    linux := os == target.OS_LINUX
    $expected_entry := "xu_app_start"
    if os == target.OS_MACOS {
        expected_entry = "_xu_app_start"
    }
    $expected_labels := 1
    if linux { expected_labels = 2 }
    if exports != 0 || labels != expected_labels || section != 0 || entry != expected_entry {
        >> errors.new("invalid XUOBJ application entry")
    }
    $hosted_entry_offset := 0
    if linux {
        hosted_section := r.number(1) or >>
        hosted_entry_offset = r.number(4) or >>
        hosted_entry := r.name() or >>
        if hosted_section != 0 || hosted_entry != "xu_app_start_hosted" {
            >> errors.new("invalid XUOBJ hosted application entry")
        }
    }
    count := r.number(4) or >>
    if count >= 65535 {
        >> errors.new("too many XUOBJ relocations")
    }
    $imports := []string{}
    $relocs := []AppObjectReloc{}
    $last := -4
    for i in 0:count {
        kind := r.number(1) or >>
        flags := r.number(1) or >>
        off := r.number(4) or >>
        $name := r.name() or >>
        if name.len == 0 || flags != 0 || off < last + 4 {
            >> errors.new("invalid XUOBJ relocation")
        }
        for j in 0:name.len {
            if name[j] == 0 {
                >> errors.new("NUL in XUOBJ symbol")
            }
        }
        if arch == target.ARCH_ARM64 {
            if kind != 1 || off % 4 != 0 {
                >> errors.new("unsupported XUOBJ arm64 relocation")
            }
        } else if kind == 1 && os == target.OS_WINDOWS && name.len > 5 && name[0:5] == "_iat_" {
            name = "__imp_" + name[5:name.len]
        } else if kind != 0 {
            >> errors.new("unsupported XUOBJ x64 relocation")
        }
        if name == entry || (linux && name == "xu_app_start_hosted") {
            >> errors.new("XUOBJ application entry cannot be an import")
        }
        relocs.push(AppObjectReloc{offset: off, symbol: app_import_index($&imports, &name)})
        last = off
    }
    size := r.number(4) or >>
    text := r.take(size) or >>
    data_size := r.number(4) or >>
    if data_size != 0 || r.pos != data.len || entry_offset >= size || hosted_entry_offset >= size || last + 4 > size ||
        (arch == target.ARCH_ARM64 && (entry_offset % 4 != 0 || hosted_entry_offset % 4 != 0)) {
        >> errors.new("invalid XUOBJ application sections or offsets")
    }
    << AppObject{arch: arch, entry: entry, entry_offset: entry_offset, hosted_entry_offset: hosted_entry_offset,
        imports: imports, relocs: relocs, text: text}
}

fn app_cstr(out $&mc.CodeBuffer, name &string) int {
    off := out.len()
    for i in 0:name.len {
        out.emit_u8(name[i])
    }
    out.emit_u8(0)
    << off
}

fn emit_app_text(out $&mc.CodeBuffer, text &string) {
    for i in 0:text.len {
        out.emit_u8(text[i])
    }
}

pub fn convert_app_object(data &string, os int) mc.CodeBuffer {
    app := read_app_object(data, os) or >>
    if os == target.OS_MACOS {
        << macho_app_object(&app)
    }
    if os == target.OS_LINUX {
        << elf_app_object(&app)
    }
    << coff_app_object(&app)
}

pub fn convert_phone_object(data &string, simulator bool) mc.CodeBuffer {
    app := read_app_object(data, target.OS_MACOS) or >>
    if app.arch != target.ARCH_ARM64 { >> errors.new("iOS Phone objects require arm64") }
    $platform := 2
    if simulator { platform = 7 }
    << macho_app_object_platform(&app, platform, 0x00100400)
}
