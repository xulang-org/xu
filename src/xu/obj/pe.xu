@xu/obj
// PE/COFF binary format serializer.
//
// Layer 4D module: serializes ObjectFile into Microsoft Windows PE/COFF 64-bit format.

#xu/mc

pub const PE_DOS_MAGIC = 0x5a4d // 'MZ'
pub const PE_SIGNATURE = 0x00004550 // 'PE\0\0'
pub const PE_MACHINE_AMD64 = 0x8664
pub const PE_MACHINE_ARM64 = 0xaa64

pub fn pe_write_dos_stub(buf $&mc.CodeBuffer, pe_offset int) {
    buf.emit_u16_le(PE_DOS_MAGIC)
    for i in 0:58 { buf.emit_u8(0) }
    buf.emit_u32_le(pe_offset) // e_lfanew at 0x3C
}
