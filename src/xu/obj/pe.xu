@xu/obj
// PE/COFF binary format serializer.
//
// Layer 4D module: serializes ObjectFile into Microsoft Windows PE/COFF 64-bit format.

#xu/mc

pub const PE_DOS_MAGIC = 0x5a4d // 'MZ'
pub const PE_SIGNATURE = 0x00004550 // 'PE\0\0'
pub const PE_MACHINE_AMD64 = 0x8664
pub const PE_MACHINE_ARM64 = 0xaa64

pub fn pe_write_dos_stub(buf $&mc.CodeBuffer, pe_offset int) {
    buf.emit_u16_le(PE_DOS_MAGIC)
    for i in 0:58 { buf.emit_u8(0) }
    buf.emit_u32_le(pe_offset) // e_lfanew at 0x3C
}

pub fn pe_write_executable(code_bytes &[]int, machine int, entry_offset int, import_offset int, iat_offset int) mc.CodeBuffer {
    $buf := mc.code_buffer_new()

    // 1. DOS Header (64 bytes)
    buf.emit_u16_le(PE_DOS_MAGIC)
    for i in 0:58 {
        buf.emit_u8(0)
    }
    // e_lfanew at 0x3C: 64 (PE header starts right after DOS header)
    buf.emit_u32_le(64)

    // 2. PE Signature (4 bytes)
    buf.emit_u32_le(PE_SIGNATURE)

    // 3. COFF File Header (20 bytes)
    buf.emit_u16_le(machine) // 0x8664 AMD64 or 0xAA64 ARM64
    buf.emit_u16_le(1)       // NumberOfSections = 1 (.text)
    buf.emit_u32_le(0)       // TimeDateStamp
    buf.emit_u32_le(0)       // PointerToSymbolTable
    buf.emit_u32_le(0)       // NumberOfSymbols
    buf.emit_u16_le(240)     // SizeOfOptionalHeader = 240 (0xF0)
    buf.emit_u16_le(0x0022)  // Characteristics: EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

    // 4. Optional Header PE32+ (240 bytes)
    file_align := 512
    sec_align := 4096
    hdr_size := 512

    $code_raw_size := code_bytes.len
    rem_raw := code_raw_size % file_align
    if rem_raw != 0 {
        code_raw_size += file_align - rem_raw
    }

    $image_size := sec_align + code_bytes.len
    rem_img := image_size % sec_align
    if rem_img != 0 {
        image_size += sec_align - rem_img
    }

    entry_rva := sec_align + entry_offset

    buf.emit_u16_le(0x020b) // PE32+ magic
    buf.emit_u8(14)         // MajorLinkerVersion
    buf.emit_u8(0)          // MinorLinkerVersion
    buf.emit_u32_le(code_raw_size) // SizeOfCode
    buf.emit_u32_le(0)      // SizeOfInitializedData
    buf.emit_u32_le(0)      // SizeOfUninitializedData
    buf.emit_u32_le(entry_rva)     // AddressOfEntryPoint
    buf.emit_u32_le(sec_align)     // BaseOfCode
    buf.emit_u64_le(0x140000000)   // ImageBase
    buf.emit_u32_le(sec_align)     // SectionAlignment
    buf.emit_u32_le(file_align)    // FileAlignment
    buf.emit_u16_le(6)      // MajorOperatingSystemVersion
    buf.emit_u16_le(0)      // MinorOperatingSystemVersion
    buf.emit_u16_le(0)      // MajorImageVersion
    buf.emit_u16_le(0)      // MinorImageVersion
    buf.emit_u16_le(6)      // MajorSubsystemVersion
    buf.emit_u16_le(0)      // MinorSubsystemVersion
    buf.emit_u32_le(0)      // Win32VersionValue
    buf.emit_u32_le(image_size)    // SizeOfImage
    buf.emit_u32_le(hdr_size)      // SizeOfHeaders
    buf.emit_u32_le(0)      // CheckSum
    buf.emit_u16_le(3)      // Subsystem: IMAGE_SUBSYSTEM_WINDOWS_CUI
    buf.emit_u16_le(0x8160) // DllCharacteristics: DYNAMIC_BASE | NX_COMPAT | TERMINAL_SERVER_AWARE | HIGH_ENTROPY_VA
    buf.emit_u64_le(0x1000000) // SizeOfStackReserve: 16MB
    buf.emit_u64_le(0x400000)  // SizeOfStackCommit: 4MB
    buf.emit_u64_le(0x100000)  // SizeOfHeapReserve: 1MB
    buf.emit_u64_le(0x1000)    // SizeOfHeapCommit: 4KB
    buf.emit_u32_le(0)      // LoaderFlags
    buf.emit_u32_le(16)     // NumberOfRvaAndSizes

    // 16 Data Directories (16 * 8 = 128 bytes)
    import_rva := sec_align + import_offset
    iat_rva := sec_align + iat_offset
    for i in 0:16 {
        if i == 1 && import_offset >= 0 {
            buf.emit_u32_le(import_rva)
            buf.emit_u32_le(40)
        } else if i == 12 && iat_offset >= 0 {
            buf.emit_u32_le(iat_rva)
            buf.emit_u32_le(64)
        } else {
            buf.emit_u32_le(0)
            buf.emit_u32_le(0)
        }
    }

    // 5. Section Header for .text (40 bytes)
    buf.emit_u8(46) // '.'
    buf.emit_u8(116) // 't'
    buf.emit_u8(101) // 'e'
    buf.emit_u8(120) // 'x'
    buf.emit_u8(116) // 't'
    buf.emit_u8(0)
    buf.emit_u8(0)
    buf.emit_u8(0)
    buf.emit_u32_le(code_bytes.len) // VirtualSize
    buf.emit_u32_le(sec_align)      // VirtualAddress (0x1000)
    buf.emit_u32_le(code_raw_size)  // SizeOfRawData
    buf.emit_u32_le(hdr_size)       // PointerToRawData (0x200)
    buf.emit_u32_le(0)              // PointerToRelocations
    buf.emit_u32_le(0)              // PointerToLinenumbers
    buf.emit_u16_le(0)              // NumberOfRelocations
    buf.emit_u16_le(0)              // NumberOfLinenumbers
    $sec_chars := 0x60000020
    if import_offset >= 0 {
        sec_chars = 0xe0000020 // CODE | EXECUTE | READ | WRITE
    }
    buf.emit_u32_le(sec_chars)

    // 6. Padding up to SizeOfHeaders (512 bytes)
    while buf.len() < hdr_size {
        buf.emit_u8(0)
    }

    // 7. Emit machine code bytes
    buf.emit_bytes(code_bytes)

    // 8. Pad out to FileAlignment boundary
    total_sz := hdr_size + code_raw_size
    while buf.len() < total_sz {
        buf.emit_u8(0)
    }

    << buf
}
