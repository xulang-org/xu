@xu/obj
// PE/COFF binary format serializer.
//
// Layer 4D module: serializes ObjectFile into Microsoft Windows PE/COFF 64-bit format.

#xu/mc

pub const PE_DOS_MAGIC = 0x5a4d // 'MZ'
pub const PE_SIGNATURE = 0x00004550 // 'PE\0\0'
pub const PE_MACHINE_AMD64 = 0x8664
pub const PE_MACHINE_ARM64 = 0xaa64
pub const PE_TEXT_RVA = 4096
pub const PE_SECTION_ALIGN = 4096
pub const PE_FILE_ALIGN = 512
pub const PE_UEFI_IMAGE_BASE = 0

pub fn pe_align(n int, align int) int {
    if n <= 0 { << 0 }
    if align == PE_FILE_ALIGN {
        rem := n & 511
        if rem == 0 { << n }
        << n + (512 - rem)
    }
    if align == PE_SECTION_ALIGN {
        rem := n & 4095
        if rem == 0 { << n }
        << n + (4096 - rem)
    }
    if align <= 1 { << n }
    if (align & (align - 1)) == 0 {
        rem := n & (align - 1)
        if rem == 0 { << n }
        << n + (align - rem)
    }
    $cur := 0
    while cur < n {
        cur += align
    }
    << cur
}

pub fn pe_next_section_rva(prev_rva int, prev_len int) int {
    if prev_len <= 0 { << prev_rva + PE_SECTION_ALIGN }
    << prev_rva + pe_align(prev_len, PE_SECTION_ALIGN)
}

fn pe_emit_sec_hdr(buf $&mc.CodeBuffer, name string, vsize int, vaddr int, raw_size int, raw_ptr int, chars int) {
    for i in 0:8 {
        if i < name.len {
            buf.emit_u8(name[i])
        } else {
            buf.emit_u8(0)
        }
    }
    buf.emit_u32_le(vsize)
    buf.emit_u32_le(vaddr)
    buf.emit_u32_le(raw_size)
    buf.emit_u32_le(raw_ptr)
    buf.emit_u32_le(0)
    buf.emit_u32_le(0)
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)
    buf.emit_u32_le(chars)
}

pub fn pe_write_dos_stub(buf $&mc.CodeBuffer, pe_offset int) {
    buf.emit_u16_le(PE_DOS_MAGIC)
    for i in 0:58 { buf.emit_u8(0) }
    buf.emit_u32_le(pe_offset) // e_lfanew at 0x3C
}

// Writes a W^X-compliant PE32+ executable with separate .text (RX), .rdata (R),
// optional .data (RW), optional .pdata (R), and a minimal .reloc (R, discardable)
// section so DYNAMIC_BASE | HIGH_ENTROPY_VA ASLR has a valid Base Relocation directory.
pub fn pe_write_executable_wx(code_bytes &[]int, rdata_bytes &[]int, data_bytes &[]int, pdata_bytes &[]int, machine int, entry_offset int, rdata_import_off int, import_size int, rdata_iat_off int, iat_size int) mc.CodeBuffer {
    $buf := mc.code_buffer_new()

    has_rdata := rdata_bytes.len > 0
    has_data := data_bytes.len > 0
    has_pdata := pdata_bytes.len > 0
    $num_secs := 2 // .text + .reloc
    if has_rdata { num_secs += 1 }
    if has_data { num_secs += 1 }
    if has_pdata { num_secs += 1 }

    file_align := PE_FILE_ALIGN
    sec_align := PE_SECTION_ALIGN
    hdr_size := 1024

    text_rva := PE_TEXT_RVA
    text_raw_off := hdr_size
    $text_raw_size := pe_align(code_bytes.len, file_align)
    if text_raw_size == 0 {
        text_raw_size = file_align
    }

    $next_raw_off := text_raw_off + text_raw_size
    $rdata_rva := pe_next_section_rva(text_rva, code_bytes.len)
    $rdata_raw_off := next_raw_off
    $rdata_raw_size := 0
    $last_rva := text_rva
    $last_vsize := code_bytes.len
    if has_rdata {
        rdata_raw_size = pe_align(rdata_bytes.len, file_align)
        next_raw_off += rdata_raw_size
        last_rva = rdata_rva
        last_vsize = rdata_bytes.len
    }

    $data_rva := 0
    $data_raw_off := 0
    $data_raw_size := 0
    if has_data {
        data_rva = pe_next_section_rva(last_rva, last_vsize)
        data_raw_off = next_raw_off
        data_raw_size = pe_align(data_bytes.len, file_align)
        next_raw_off += data_raw_size
        last_rva = data_rva
        last_vsize = data_bytes.len
    }

    $pdata_rva := 0
    $pdata_raw_off := 0
    $pdata_raw_size := 0
    if has_pdata {
        pdata_rva = pe_next_section_rva(last_rva, last_vsize)
        pdata_raw_off = next_raw_off
        pdata_raw_size = pe_align(pdata_bytes.len, file_align)
        next_raw_off += pdata_raw_size
        last_rva = pdata_rva
        last_vsize = pdata_bytes.len
    }

    // Minimal valid base relocation block (12 bytes): 2 IMAGE_REL_BASED_ABSOLUTE
    // (no-op) entries on PE_TEXT_RVA because Xu codegen is fully RIP-relative.
    reloc_vsize := 12
    reloc_rva := pe_next_section_rva(last_rva, last_vsize)
    reloc_raw_off := next_raw_off
    reloc_raw_size := pe_align(reloc_vsize, file_align)
    next_raw_off += reloc_raw_size
    last_rva = reloc_rva
    last_vsize = reloc_vsize

    image_size := pe_next_section_rva(last_rva, last_vsize)
    entry_rva := text_rva + entry_offset

    // 1. DOS Header (64 bytes)
    pe_write_dos_stub($&buf, 64)

    // 2. PE Signature (4 bytes)
    buf.emit_u32_le(PE_SIGNATURE)

    // 3. COFF File Header (20 bytes)
    buf.emit_u16_le(machine)
    buf.emit_u16_le(num_secs)
    buf.emit_u32_le(0)       // TimeDateStamp
    buf.emit_u32_le(0)       // PointerToSymbolTable
    buf.emit_u32_le(0)       // NumberOfSymbols
    buf.emit_u16_le(240)     // SizeOfOptionalHeader
    buf.emit_u16_le(0x0022)  // EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

    // 4. Optional Header PE32+ (240 bytes)
    buf.emit_u16_le(0x020b) // PE32+ magic
    buf.emit_u8(14)         // MajorLinkerVersion
    buf.emit_u8(0)          // MinorLinkerVersion
    buf.emit_u32_le(text_raw_size)
    buf.emit_u32_le(rdata_raw_size + data_raw_size + pdata_raw_size + reloc_raw_size)
    buf.emit_u32_le(0)      // SizeOfUninitializedData
    buf.emit_u32_le(entry_rva)
    buf.emit_u32_le(text_rva)
    buf.emit_u64_le(0x140000000)
    buf.emit_u32_le(sec_align)
    buf.emit_u32_le(file_align)
    buf.emit_u16_le(6)
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)
    buf.emit_u16_le(6)
    buf.emit_u16_le(0)
    buf.emit_u32_le(0)
    buf.emit_u32_le(image_size)
    buf.emit_u32_le(hdr_size)
    buf.emit_u32_le(0)
    buf.emit_u16_le(3)      // IMAGE_SUBSYSTEM_WINDOWS_CUI
    buf.emit_u16_le(0x8160) // DYNAMIC_BASE | NX_COMPAT | TERMINAL_SERVER_AWARE | HIGH_ENTROPY_VA
    buf.emit_u64_le(0x1000000) // SizeOfStackReserve: 16MB
    buf.emit_u64_le(0x400000)  // SizeOfStackCommit: 4MB
    buf.emit_u64_le(0x100000)  // SizeOfHeapReserve: 1MB
    buf.emit_u64_le(0x1000)    // SizeOfHeapCommit: 4KB
    buf.emit_u32_le(0)
    buf.emit_u32_le(16)

    // 16 Data Directories
    for i in 0:16 {
        if i == 1 && has_rdata && rdata_import_off >= 0 {
            buf.emit_u32_le(rdata_rva + rdata_import_off)
            buf.emit_u32_le(import_size)
        } else if i == 3 && has_pdata {
            buf.emit_u32_le(pdata_rva)
            buf.emit_u32_le(pdata_bytes.len)
        } else if i == 5 {
            buf.emit_u32_le(reloc_rva)
            buf.emit_u32_le(reloc_vsize)
        } else if i == 12 && has_rdata && rdata_iat_off >= 0 {
            buf.emit_u32_le(rdata_rva + rdata_iat_off)
            buf.emit_u32_le(iat_size)
        } else {
            buf.emit_u32_le(0)
            buf.emit_u32_le(0)
        }
    }

    // 5. Section Headers (.text, optional .rdata, optional .data, optional .pdata, .reloc)
    pe_emit_sec_hdr($&buf, ".text", code_bytes.len, text_rva, text_raw_size, text_raw_off, 0x60000020)
    if has_rdata {
        pe_emit_sec_hdr($&buf, ".rdata", rdata_bytes.len, rdata_rva, rdata_raw_size, rdata_raw_off, 0x40000040)
    }
    if has_data {
        pe_emit_sec_hdr($&buf, ".data", data_bytes.len, data_rva, data_raw_size, data_raw_off, 0xC0000040)
    }
    if has_pdata {
        pe_emit_sec_hdr($&buf, ".pdata", pdata_bytes.len, pdata_rva, pdata_raw_size, pdata_raw_off, 0x40000040)
    }
    pe_emit_sec_hdr($&buf, ".reloc", reloc_vsize, reloc_rva, reloc_raw_size, reloc_raw_off, 0x42000040)

    // 6. Pad headers to hdr_size bytes
    while buf.len() < hdr_size {
        buf.emit_u8(0)
    }

    // 7. Emit .text bytes
    buf.emit_bytes(code_bytes)
    while buf.len() < text_raw_off + text_raw_size {
        buf.emit_u8(0)
    }

    // 8. Emit .rdata bytes
    if has_rdata {
        buf.emit_bytes(rdata_bytes)
        while buf.len() < rdata_raw_off + rdata_raw_size {
            buf.emit_u8(0)
        }
    }

    // 9. Emit .data bytes
    if has_data {
        buf.emit_bytes(data_bytes)
        while buf.len() < data_raw_off + data_raw_size {
            buf.emit_u8(0)
        }
    }

    // 10. Emit .pdata bytes
    if has_pdata {
        buf.emit_bytes(pdata_bytes)
        while buf.len() < pdata_raw_off + pdata_raw_size {
            buf.emit_u8(0)
        }
    }

    // 11. Emit .reloc block (PageRVA=PE_TEXT_RVA, BlockSize=12, 2x IMAGE_REL_BASED_ABSOLUTE)
    buf.emit_u32_le(PE_TEXT_RVA)
    buf.emit_u32_le(reloc_vsize)
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)
    while buf.len() < reloc_raw_off + reloc_raw_size {
        buf.emit_u8(0)
    }

    << buf
}

pub const PE_SUBSYSTEM_EFI_APP = 10

// Packs sorted 4 KiB page blocks of DIR64 (0xA) base relocations for PE32+/.reloc.
pub fn pe_build_base_relocs(rvas &[]int) mc.CodeBuffer {
    $buf := mc.code_buffer_new()
    if rvas.len == 0 {
        << buf
    }
    $sorted := []int{}
    for i in 0:rvas.len {
        sorted.push(rvas[i])
    }
    for i in 0:sorted.len {
        $j := i + 1
        while j < sorted.len {
            if sorted[j] < sorted[i] {
                tmp := sorted[i]
                sorted[i] = sorted[j]
                sorted[j] = tmp
            }
            j += 1
        }
    }
    $idx := 0
    while idx < sorted.len {
        page := sorted[idx] & 0xFFFFF000
        $end_idx := idx
        while end_idx < sorted.len && (sorted[end_idx] & 0xFFFFF000) == page {
            end_idx += 1
        }
        count := end_idx - idx
        $padded := count
        if (padded % 2) != 0 {
            padded += 1
        }
        blk_size := 8 + padded * 2
        buf.emit_u32_le(page)
        buf.emit_u32_le(blk_size)
        for k in idx:end_idx {
            buf.emit_u16_le(0xA000 | (sorted[k] & 0xFFF))
        }
        if padded > count {
            buf.emit_u16_le(0)
        }
        idx = end_idx
    }
    << buf
}

// Writes a UEFI PE32+ application image (Subsystem=10) with .text (RX),
// optional .data (RW), and optional .reloc (relocatable base relocations).
pub fn pe_write_uefi_app(code_bytes &[]int, data_bytes &[]int, reloc_bytes &[]int, machine int, entry_offset int) mc.CodeBuffer {
    $buf := mc.code_buffer_new()

    has_data := data_bytes.len > 0
    has_reloc := reloc_bytes.len > 0
    $num_secs := 1
    if has_data { num_secs += 1 }
    if has_reloc { num_secs += 1 }

    file_align := PE_FILE_ALIGN
    sec_align := PE_SECTION_ALIGN
    hdr_size := 1024

    text_rva := PE_TEXT_RVA
    text_raw_off := hdr_size
    $text_raw_size := pe_align(code_bytes.len, file_align)
    if text_raw_size == 0 {
        text_raw_size = file_align
    }

    $next_raw_off := text_raw_off + text_raw_size
    $last_rva := text_rva
    $last_vsize := code_bytes.len

    $data_rva := 0
    $data_raw_off := 0
    $data_raw_size := 0
    if has_data {
        data_rva = pe_next_section_rva(last_rva, last_vsize)
        data_raw_off = next_raw_off
        data_raw_size = pe_align(data_bytes.len, file_align)
        next_raw_off += data_raw_size
        last_rva = data_rva
        last_vsize = data_bytes.len
    }

    $reloc_rva := 0
    $reloc_raw_off := 0
    $reloc_raw_size := 0
    if has_reloc {
        reloc_rva = pe_next_section_rva(last_rva, last_vsize)
        reloc_raw_off = next_raw_off
        reloc_raw_size = pe_align(reloc_bytes.len, file_align)
        next_raw_off += reloc_raw_size
        last_rva = reloc_rva
        last_vsize = reloc_bytes.len
    }

    image_size := pe_next_section_rva(last_rva, last_vsize)
    entry_rva := text_rva + entry_offset

    pe_write_dos_stub($&buf, 64)
    buf.emit_u32_le(PE_SIGNATURE)

    // COFF File Header (20 bytes)
    buf.emit_u16_le(machine)
    buf.emit_u16_le(num_secs)
    buf.emit_u32_le(0)
    buf.emit_u32_le(0)
    buf.emit_u32_le(0)
    buf.emit_u16_le(240)
    buf.emit_u16_le(0x0022) // EXECUTABLE_IMAGE | LARGE_ADDRESS_AWARE

    // Optional Header PE32+ (240 bytes)
    buf.emit_u16_le(0x020b)
    buf.emit_u8(14)
    buf.emit_u8(0)
    buf.emit_u32_le(text_raw_size)
    buf.emit_u32_le(data_raw_size + reloc_raw_size)
    buf.emit_u32_le(0)
    buf.emit_u32_le(entry_rva)
    buf.emit_u32_le(text_rva)
    buf.emit_u64_le(PE_UEFI_IMAGE_BASE)
    buf.emit_u32_le(sec_align)
    buf.emit_u32_le(file_align)
    buf.emit_u16_le(6)
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)
    buf.emit_u16_le(6)
    buf.emit_u16_le(0)
    buf.emit_u32_le(0)
    buf.emit_u32_le(image_size)
    buf.emit_u32_le(hdr_size)
    buf.emit_u32_le(0)
    buf.emit_u16_le(PE_SUBSYSTEM_EFI_APP)
    buf.emit_u16_le(0x0140) // DYNAMIC_BASE | NX_COMPAT
    buf.emit_u64_le(0x100000)
    buf.emit_u64_le(0x1000)
    buf.emit_u64_le(0x100000)
    buf.emit_u64_le(0x1000)
    buf.emit_u32_le(0)
    buf.emit_u32_le(16)

    for i in 0:16 {
        if i == 5 && has_reloc {
            buf.emit_u32_le(reloc_rva)
            buf.emit_u32_le(reloc_bytes.len)
        } else {
            buf.emit_u32_le(0)
            buf.emit_u32_le(0)
        }
    }

    pe_emit_sec_hdr($&buf, ".text", code_bytes.len, text_rva, text_raw_size, text_raw_off, 0x60000020)
    if has_data {
        pe_emit_sec_hdr($&buf, ".data", data_bytes.len, data_rva, data_raw_size, data_raw_off, 0xC0000040)
    }
    if has_reloc {
        pe_emit_sec_hdr($&buf, ".reloc", reloc_bytes.len, reloc_rva, reloc_raw_size, reloc_raw_off, 0x42000040)
    }

    while buf.len() < hdr_size {
        buf.emit_u8(0)
    }
    buf.emit_bytes(code_bytes)
    while buf.len() < text_raw_off + text_raw_size {
        buf.emit_u8(0)
    }
    if has_data {
        buf.emit_bytes(data_bytes)
        while buf.len() < data_raw_off + data_raw_size {
            buf.emit_u8(0)
        }
    }
    if has_reloc {
        buf.emit_bytes(reloc_bytes)
        while buf.len() < reloc_raw_off + reloc_raw_size {
            buf.emit_u8(0)
        }
    }
    << buf
}
