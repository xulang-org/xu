@xu/obj
// ELF binary format serializer.
//
// Layer 4D module: serializes ObjectFile into standard ELF-64 binary format.

#xu/mc

pub const ELF_MAGIC_0 = 0x7f
pub const ELF_MAGIC_1 = 0x45 // 'E'
pub const ELF_MAGIC_2 = 0x4c // 'L'
pub const ELF_MAGIC_3 = 0x46 // 'F'

pub const ELF_CLASS_64 = 2
pub const ELF_DATA_2LSB = 1 // Little endian

pub const ELF_EM_X86_64 = 62
pub const ELF_EM_AARCH64 = 183
pub const ELF_EM_RISCV = 243
pub const ELF_EM_LOONGARCH = 258

pub const PT_LOAD = 1
pub const PF_X = 1
pub const PF_W = 2
pub const PF_R = 4

const ELF_BASE_VADDR = 0x400000
// ELF header and one program header (64 + 56), aligned to 16.
const ELF_CODE_OFFSET = 128

// Virtual address of the first code byte.
pub fn elf_code_vaddr() int {
    << ELF_BASE_VADDR + ELF_CODE_OFFSET
}

pub fn elf_write_executable(code_bytes &[]int, machine int, entry_offset int) mc.CodeBuffer {
    dbg := debug_sections_empty()
    << elf_write_executable_debug(code_bytes, machine, entry_offset, &dbg)
}

fn elf_pad8(buf $&mc.CodeBuffer) {
    while buf.len() % 8 != 0 {
        buf.emit_u8(0)
    }
}

fn elf_shdr(buf $&mc.CodeBuffer, name int, typ int, flags int, addr int, off int, size int, align int) {
    buf.emit_u32_le(name)
    buf.emit_u32_le(typ)
    buf.emit_u64_le(flags)
    buf.emit_u64_le(addr)
    buf.emit_u64_le(off)
    buf.emit_u64_le(size)
    buf.emit_u32_le(0)
    buf.emit_u32_le(0)
    buf.emit_u64_le(align)
    buf.emit_u64_le(0)
}

fn elf_section_bytes(buf $&mc.CodeBuffer, offs $&[]int, sizes $&[]int, bytes &[]int) {
    elf_pad8(buf)
    offs.push(buf.len())
    sizes.push(bytes.len)
    buf.emit_bytes(bytes)
}

// With debug sections, they follow the loaded image together with
// .shstrtab and a section header table (.text plus the four .debug_*).
pub fn elf_write_executable_debug(code_bytes &[]int, machine int, entry_offset int, dbg &DebugSections) mc.CodeBuffer {
    $buf := mc.code_buffer_new()

    base_vaddr := ELF_BASE_VADDR
    ehdr_size := 64
    phdr_size := 56
    code_offset := ELF_CODE_OFFSET

    file_size := code_offset + code_bytes.len
    entry_vaddr := base_vaddr + code_offset + entry_offset

    // 1. ELF Header (64 bytes)
    buf.emit_u8(ELF_MAGIC_0)
    buf.emit_u8(ELF_MAGIC_1)
    buf.emit_u8(ELF_MAGIC_2)
    buf.emit_u8(ELF_MAGIC_3)
    buf.emit_u8(ELF_CLASS_64)
    buf.emit_u8(ELF_DATA_2LSB)
    buf.emit_u8(1) // EV_CURRENT
    buf.emit_u8(0) // ELFOSABI_NONE
    for i in 0:8 { buf.emit_u8(0) } // EI_PAD

    buf.emit_u16_le(2) // ET_EXEC
    buf.emit_u16_le(machine)
    buf.emit_u32_le(1) // EV_CURRENT
    buf.emit_u64_le(entry_vaddr) // e_entry
    buf.emit_u64_le(ehdr_size)   // e_phoff (64)
    shoff_at := buf.len()
    buf.emit_u64_le(0)           // e_shoff (patched when debug sections follow)
    // e_flags: LoongArch needs its ABI (LP64D, object ABI v1).
    $flags := 0
    if machine == ELF_EM_LOONGARCH {
        flags = 0x43
    }
    buf.emit_u32_le(flags)
    buf.emit_u16_le(ehdr_size)   // e_ehsize (64)
    buf.emit_u16_le(phdr_size)   // e_phentsize (56)
    buf.emit_u16_le(1)           // e_phnum (1 PT_LOAD segment)
    buf.emit_u16_le(64)          // e_shentsize
    shnum_at := buf.len()
    buf.emit_u16_le(0)           // e_shnum
    buf.emit_u16_le(0)           // e_shstrndx

    // 2. Program Header (56 bytes, PT_LOAD RXW)
    buf.emit_u32_le(PT_LOAD)
    buf.emit_u32_le(PF_R | PF_W | PF_X)
    buf.emit_u64_le(0)           // p_offset (from file start)
    buf.emit_u64_le(base_vaddr)  // p_vaddr
    buf.emit_u64_le(base_vaddr)  // p_paddr
    buf.emit_u64_le(file_size)   // p_filesz
    buf.emit_u64_le(file_size)   // p_memsz
    buf.emit_u64_le(4096)        // p_align

    // 3. Padding up to code_offset
    while buf.len() < code_offset {
        buf.emit_u8(0)
    }

    // 4. Code bytes
    buf.emit_bytes(code_bytes)
    if !dbg.present() {
        << buf
    }

    // 5. Debug sections, .shstrtab and the section header table.
    $offs := []int{}
    $sizes := []int{}
    elf_section_bytes($&buf, $&offs, $&sizes, &dbg.line)
    elf_section_bytes($&buf, $&offs, $&sizes, &dbg.info)
    elf_section_bytes($&buf, $&offs, $&sizes, &dbg.abbrev)
    elf_section_bytes($&buf, $&offs, $&sizes, &dbg.str)
    names := ["", ".text", ".debug_line", ".debug_info", ".debug_abbrev", ".debug_str", ".shstrtab"]
    $name_off := []int{}
    shstr_off := buf.len()
    for i in 0:names.len {
        name_off.push(buf.len() - shstr_off)
        for j in 0:names[i].len {
            buf.emit_u8(names[i][j])
        }
        buf.emit_u8(0)
    }
    shstr_size := buf.len() - shstr_off
    elf_pad8($&buf)
    shoff := buf.len()
    elf_shdr($&buf, 0, 0, 0, 0, 0, 0, 0)
    // SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR
    elf_shdr($&buf, name_off[1], 1, 6, base_vaddr + code_offset, code_offset, code_bytes.len, 16)
    for i in 0:4 {
        elf_shdr($&buf, name_off[2 + i], 1, 0, 0, offs[i], sizes[i], 1)
    }
    // SHT_STRTAB
    elf_shdr($&buf, name_off[6], 3, 0, 0, shstr_off, shstr_size, 1)
    buf.patch_u64_le(shoff_at, shoff)
    buf.patch_u8(shnum_at, 7)
    buf.patch_u8(shnum_at + 2, 6)
    << buf
}
