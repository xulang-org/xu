@xu/obj
// ELF binary format serializer.
//
// Layer 4D module: serializes ObjectFile into standard ELF-64 binary format.

#xu/mc

pub const ELF_MAGIC_0 = 0x7f
pub const ELF_MAGIC_1 = 0x45 // 'E'
pub const ELF_MAGIC_2 = 0x4c // 'L'
pub const ELF_MAGIC_3 = 0x46 // 'F'

pub const ELF_CLASS_64 = 2
pub const ELF_DATA_2LSB = 1 // Little endian

pub const ELF_EM_X86_64 = 62
pub const ELF_EM_AARCH64 = 183
pub const ELF_EM_RISCV = 243
pub const ELF_EM_LOONGARCH = 258

pub const PT_LOAD = 1
pub const PF_X = 1
pub const PF_W = 2
pub const PF_R = 4

const ELF_BASE_VADDR = 0x400000
// ELF header and one program header (64 + 56), aligned to 16.
const ELF_CODE_OFFSET = 128

// Virtual address of the first code byte.
pub fn elf_code_vaddr() int {
    << ELF_BASE_VADDR + ELF_CODE_OFFSET
}

pub fn elf_code_offset() int {
    << ELF_CODE_OFFSET
}

// Virtual address of the first file byte (the single PT_LOAD maps the whole
// file from offset 0).
pub fn elf_image_vaddr() int {
    << ELF_BASE_VADDR
}

pub struct ElfSyms {
    pub names []string
    pub offs []int
    pub weak []bool
}

pub fn elf_syms_empty() ElfSyms {
    << ElfSyms{names: []string{}, offs: []int{}, weak: []bool{}}
}

pub struct ElfBss {
    pub names      []string
    pub offs       []int
    pub sizes      []int
    pub total_size int
    pub max_align  int
}

pub fn elf_bss_empty() ElfBss {
    << ElfBss{names: []string{}, offs: []int{}, sizes: []int{}, total_size: 0, max_align: 1}
}

pub struct ElfDataReloc {
    pub off    int
    pub sym    string
    pub addend int
}

pub struct ElfDataSec {
    pub name       string
    pub is_nobits  bool
    pub writable   bool
    pub max_align  int
    pub total_size int
    pub bytes      []int
    pub relocs     []ElfDataReloc
}

pub struct ElfDataSym {
    pub name    string
    pub sec_idx int
    pub off     int
    pub size    int
    pub is_weak bool
}

pub struct ElfDataLayout {
    pub secs []ElfDataSec
    pub syms []ElfDataSym
}

pub fn elf_data_layout_empty() ElfDataLayout {
    << ElfDataLayout{secs: []ElfDataSec{}, syms: []ElfDataSym{}}
}

pub fn elf_write_executable(code_bytes &[]int, machine int, entry_offset int) mc.CodeBuffer {
    dbg := debug_sections_empty()
    << elf_write_executable_debug(code_bytes, machine, entry_offset, &dbg)
}

fn elf_pad8(buf $&mc.CodeBuffer) {
    while buf.len() % 8 != 0 {
        buf.emit_u8(0)
    }
}

fn elf64_ident(buf $&mc.CodeBuffer) {
    buf.emit_u8(ELF_MAGIC_0)
    buf.emit_u8(ELF_MAGIC_1)
    buf.emit_u8(ELF_MAGIC_2)
    buf.emit_u8(ELF_MAGIC_3)
    buf.emit_u8(ELF_CLASS_64)
    buf.emit_u8(ELF_DATA_2LSB)
    buf.emit_u8(1) // EV_CURRENT
    buf.emit_u8(0) // ELFOSABI_NONE
    for i in 0:8 { buf.emit_u8(0) }
}

fn elf_shdr_link(buf $&mc.CodeBuffer, name int, typ int, flags int, addr int, off int, size int,
    link int, info int, align int, entry_size int) {
    buf.emit_u32_le(name)
    buf.emit_u32_le(typ)
    buf.emit_u64_le(flags)
    buf.emit_u64_le(addr)
    buf.emit_u64_le(off)
    buf.emit_u64_le(size)
    buf.emit_u32_le(link)
    buf.emit_u32_le(info)
    buf.emit_u64_le(align)
    buf.emit_u64_le(entry_size)
}

fn elf_shdr(buf $&mc.CodeBuffer, name int, typ int, flags int, addr int, off int, size int, align int) {
    elf_shdr_link(buf, name, typ, flags, addr, off, size, 0, 0, align, 0)
}

fn elf_section_bytes(buf $&mc.CodeBuffer, offs $&[]int, sizes $&[]int, bytes &[]int) {
    elf_pad8(buf)
    offs.push(buf.len())
    sizes.push(bytes.len)
    buf.emit_bytes(bytes)
}

// Hardened Linux static-PIE executable (no PT_INTERP):
//   PT_LOAD #1 (R)  : ELF header, program headers, .note.gnu.build-id,
//                     read-only .dynamic (DF_1_PIE)
//   PT_LOAD #2 (RX) : .text (machine code only; zero writable segments)
//   PT_NOTE         : deterministic 20-byte GNU Build-ID
//   PT_GNU_RELRO    : covers PT_LOAD #1
//   PT_GNU_STACK    : RW (non-executable stack)
//   Section headers : .note.gnu.build-id, .dynamic, .text, optional .debug_*, .shstrtab
pub fn elf_linux_static_code_vaddr(machine int) int {
    page := elf_page_size(machine)
    note_off := 64 + 7 * 56
    dyn_off := elf_align_up(note_off + ELF_BUILD_ID_SIZE, 8)
    ro_end := dyn_off + 48
    << elf_next_seg_vaddr(ro_end, 4096, page)
}

pub fn elf_write_linux_static_executable(code_bytes &[]int, machine int, entry_offset int, dbg &DebugSections) mc.CodeBuffer {
    page := elf_page_size(machine)
    nph := 7
    ph_off := 64
    ph_size := nph * 56
    note_off := ph_off + ph_size
    note_size := ELF_BUILD_ID_SIZE
    dyn_off := elf_align_up(note_off + note_size, 8)
    dyn_size := 3 * 16
    ro_end := dyn_off + dyn_size
    code_off := 4096
    code_vaddr := elf_next_seg_vaddr(ro_end, code_off, page)

    $buf := mc.code_buffer_new()
    // 1. ELF64 Header (ET_DYN static-PIE, link base 0)
    elf64_ident($&buf)
    buf.emit_u16_le(ET_DYN)
    buf.emit_u16_le(machine)
    buf.emit_u32_le(1)
    buf.emit_u64_le(code_vaddr + entry_offset)
    buf.emit_u64_le(ph_off)
    shoff_at := buf.len()
    buf.emit_u64_le(0)
    buf.emit_u32_le(elf_flags_for_machine(machine))
    buf.emit_u16_le(64)
    buf.emit_u16_le(56)
    buf.emit_u16_le(nph)
    buf.emit_u16_le(64)
    shnum_at := buf.len()
    buf.emit_u16_le(0)
    buf.emit_u16_le(0)

    // 2. Program Headers (strict W^X, zero writable segments, NX stack)
    elf_phdr($&buf, PT_PHDR, PF_R, ph_off, ph_off, ph_size, 8)
    elf_phdr($&buf, PT_LOAD, PF_R, 0, 0, ro_end, page)
    elf_phdr($&buf, PT_LOAD, PF_R | PF_X, code_off, code_vaddr, code_bytes.len, page)
    elf_phdr($&buf, PT_DYNAMIC, PF_R, dyn_off, dyn_off, dyn_size, 8)
    elf_phdr($&buf, PT_NOTE, PF_R, note_off, note_off, note_size, 4)
    elf_phdr_sized($&buf, PT_GNU_RELRO, PF_R, 0, 0, ro_end, page, 1)
    elf_phdr($&buf, PT_GNU_STACK, PF_R | PF_W, 0, 0, 0, 16)

    // 3. PT_LOAD #1 (R): .note.gnu.build-id + minimal .dynamic advertising PIE + BIND_NOW
    elf_pad_to($&buf, note_off)
    elf_emit_build_id($&buf, code_bytes)
    elf_pad_to($&buf, dyn_off)
    elf_dyn($&buf, 30, DF_BIND_NOW)
    elf_dyn($&buf, 0x6ffffffb, DF_1_NOW | DF_1_PIE)
    elf_dyn($&buf, 0, 0)

    // 4. PT_LOAD #2 (RX): .text
    elf_pad_to($&buf, code_off)
    buf.emit_bytes(code_bytes)

    // 5. Optional DWARF sections, .shstrtab, and Section Header Table
    has_dbg := dbg.present()
    $offs := []int{}
    $sizes := []int{}
    if has_dbg {
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.line)
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.info)
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.abbrev)
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.str)
    }

    $sec_names := ["", ".note.gnu.build-id", ".dynamic", ".text"]
    if has_dbg {
        sec_names.push(".debug_line")
        sec_names.push(".debug_info")
        sec_names.push(".debug_abbrev")
        sec_names.push(".debug_str")
    }
    sec_names.push(".shstrtab")

    $name_off := []int{}
    shstr_off := buf.len()
    for i in 0:sec_names.len {
        name_off.push(buf.len() - shstr_off)
        elf_cstr($&buf, &sec_names[i])
    }
    shstr_size := buf.len() - shstr_off
    elf_pad8($&buf)
    shoff := buf.len()

    elf_shdr($&buf, 0, 0, 0, 0, 0, 0, 0) // [0] SHT_NULL
    elf_shdr($&buf, name_off[1], 7, 2, note_off, note_off, note_size, 4) // [1] .note.gnu.build-id
    elf_shdr_link($&buf, name_off[2], 6, 2, dyn_off, dyn_off, dyn_size, 0, 0, 8, 16) // [2] .dynamic
    elf_shdr($&buf, name_off[3], 1, 6, code_vaddr, code_off, code_bytes.len, 16) // [3] .text
    $ni := 4
    if has_dbg {
        for i in 0:4 {
            elf_shdr($&buf, name_off[ni + i], 1, 0, 0, offs[i], sizes[i], 1)
        }
        ni += 4
    }
    elf_shdr($&buf, name_off[ni], 3, 0, 0, shstr_off, shstr_size, 1) // .shstrtab

    buf.patch_u64_le(shoff_at, shoff)
    elf_patch_u16_le($&buf, shnum_at, sec_names.len)
    elf_patch_u16_le($&buf, shnum_at + 2, ni)
    << buf
}

// With debug sections, they follow the loaded image together with
// .shstrtab and a section header table (.text plus the four .debug_*).
pub fn elf_write_executable_debug(code_bytes &[]int, machine int, entry_offset int, dbg &DebugSections) mc.CodeBuffer {
    << elf_write_executable_at(code_bytes, machine, entry_offset, ELF_BASE_VADDR, dbg)
}

pub fn elf_write_executable_at(code_bytes &[]int, machine int, entry_offset int, base_vaddr int, dbg &DebugSections) mc.CodeBuffer {
    sy := elf_syms_empty()
    << elf_write_executable_full(code_bytes, machine, entry_offset, base_vaddr, ELF_CODE_OFFSET, true, &sy, dbg)
}

pub fn elf_write_executable_code(code_bytes &[]int, machine int, entry_offset int, base_vaddr int, dbg &DebugSections) mc.CodeBuffer {
    sy := elf_syms_empty()
    << elf_write_executable_full(code_bytes, machine, entry_offset, base_vaddr, 4096, false, &sy, dbg)
}

pub fn elf_write_executable_full(code_bytes &[]int, machine int, entry_offset int, base_vaddr int, code_offset int, map_from_zero bool, esyms &ElfSyms, dbg &DebugSections) mc.CodeBuffer {
    $buf := mc.code_buffer_new()

    ehdr_size := 64
    phdr_size := 56

    $p_offset := 0
    $p_filesz := code_offset + code_bytes.len
    $code_vaddr := base_vaddr + code_offset
    if !map_from_zero {
        p_offset = code_offset
        p_filesz = code_bytes.len
        code_vaddr = base_vaddr
    }
    entry_vaddr := code_vaddr + entry_offset

    // 1. ELF Header (64 bytes)
    elf64_ident($&buf)

    buf.emit_u16_le(2) // ET_EXEC
    buf.emit_u16_le(machine)
    buf.emit_u32_le(1) // EV_CURRENT
    buf.emit_u64_le(entry_vaddr) // e_entry
    buf.emit_u64_le(ehdr_size)   // e_phoff (64)
    shoff_at := buf.len()
    buf.emit_u64_le(0)           // e_shoff (patched when section headers follow)
    // e_flags: LoongArch needs its ABI (LP64D, object ABI v1).
    $flags := 0
    if machine == ELF_EM_LOONGARCH {
        flags = 0x43
    }
    buf.emit_u32_le(flags)
    buf.emit_u16_le(ehdr_size)   // e_ehsize (64)
    buf.emit_u16_le(phdr_size)   // e_phentsize (56)
    buf.emit_u16_le(1)           // e_phnum (1 PT_LOAD segment)
    buf.emit_u16_le(64)          // e_shentsize
    shnum_at := buf.len()
    buf.emit_u16_le(0)           // e_shnum
    buf.emit_u16_le(0)           // e_shstrndx

    // 2. Program Header (56 bytes, PT_LOAD RXW)
    buf.emit_u32_le(PT_LOAD)
    buf.emit_u32_le(PF_R | PF_W | PF_X)
    buf.emit_u64_le(p_offset)    // p_offset
    buf.emit_u64_le(base_vaddr)  // p_vaddr
    buf.emit_u64_le(base_vaddr)  // p_paddr
    buf.emit_u64_le(p_filesz)    // p_filesz
    buf.emit_u64_le(p_filesz)    // p_memsz
    buf.emit_u64_le(4096)        // p_align

    // 3. Padding up to code_offset
    while buf.len() < code_offset {
        buf.emit_u8(0)
    }

    // 4. Code bytes
    buf.emit_bytes(code_bytes)
    has_dbg := dbg.present()
    has_syms := esyms.names.len > 0
    if !has_dbg && !has_syms {
        << buf
    }

    // 5. Optional debug sections, optional .symtab/.strtab, .shstrtab and section headers.
    $offs := []int{}
    $sizes := []int{}
    if has_dbg {
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.line)
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.info)
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.abbrev)
        elf_section_bytes($&buf, $&offs, $&sizes, &dbg.str)
    }

    $sym_off := 0
    $sym_size := 0
    $strtab := mc.code_buffer_new()
    $strtab_off := 0
    if has_syms {
        elf_pad8($&buf)
        strtab.emit_u8(0)
        sym_off = buf.len()
        // STN_UNDEF
        buf.emit_u32_le(0)
        buf.emit_u8(0)
        buf.emit_u8(0)
        buf.emit_u16_le(0)
        buf.emit_u64_le(0)
        buf.emit_u64_le(0)
        for si in 0:esyms.names.len {
            noff := strtab.len()
            nm := &esyms.names[si]
            for j in 0:nm.len {
                strtab.emit_u8(nm[j])
            }
            strtab.emit_u8(0)
            buf.emit_u32_le(noff)
            buf.emit_u8(0x12) // STB_GLOBAL | STT_FUNC
            buf.emit_u8(0)
            buf.emit_u16_le(1) // .text
            buf.emit_u64_le(code_vaddr + esyms.offs[si])
            buf.emit_u64_le(0)
        }
        sym_size = buf.len() - sym_off
        strtab_off = buf.len()
        buf.emit_bytes(&strtab.bytes)
    }

    $sec_names := ["", ".text"]
    if has_dbg {
        sec_names.push(".debug_line")
        sec_names.push(".debug_info")
        sec_names.push(".debug_abbrev")
        sec_names.push(".debug_str")
    }
    if has_syms {
        sec_names.push(".symtab")
        sec_names.push(".strtab")
    }
    sec_names.push(".shstrtab")

    $name_off := []int{}
    shstr_off := buf.len()
    for i in 0:sec_names.len {
        name_off.push(buf.len() - shstr_off)
        for j in 0:sec_names[i].len {
            buf.emit_u8(sec_names[i][j])
        }
        buf.emit_u8(0)
    }
    shstr_size := buf.len() - shstr_off
    elf_pad8($&buf)
    shoff := buf.len()
    elf_shdr($&buf, 0, 0, 0, 0, 0, 0, 0)
    // SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR
    elf_shdr($&buf, name_off[1], 1, 6, code_vaddr, code_offset, code_bytes.len, 16)
    $ni := 2
    if has_dbg {
        for i in 0:4 {
            elf_shdr($&buf, name_off[ni + i], 1, 0, 0, offs[i], sizes[i], 1)
        }
        ni += 4
    }
    if has_syms {
        // .symtab links to .strtab at section index ni + 1; sh_info=1 (1st global).
        elf_shdr_link($&buf, name_off[ni], 2, 0, 0, sym_off, sym_size, ni + 1, 1, 8, 24)
        elf_shdr($&buf, name_off[ni + 1], 3, 0, 0, strtab_off, strtab.len(), 1)
        ni += 2
    }
    // .shstrtab
    elf_shdr($&buf, name_off[ni], 3, 0, 0, shstr_off, shstr_size, 1)
    shstrndx := ni
    shnum := sec_names.len
    buf.patch_u64_le(shoff_at, shoff)
    buf.patch_u8(shnum_at, shnum)
    buf.patch_u8(shnum_at + 2, shstrndx)
    << buf
}

fn elf_emit_sym(out $&mc.CodeBuffer, name int, info int, section int, offset int, size int) {
    out.emit_u32_le(name)
    out.emit_u8(info)
    out.emit_u8(0)
    out.emit_u16_le(section)
    out.emit_u64_le(offset)
    out.emit_u64_le(size)
}

fn elf_obj_cstr(out $&mc.CodeBuffer, s &string) int {
    off := out.len()
    for i in 0:s.len {
        out.emit_u8(s[i])
    }
    out.emit_u8(0)
    << off
}

// Standard ELF64 ET_REL (.o) object for freestanding/baremetal linking with GNU ld.
pub fn elf_write_relocatable(code_bytes &[]int, machine int, esyms &ElfSyms, ext_relocs &[]mc.Reloc) mc.CodeBuffer {
    empty_data := elf_data_layout_empty()
    << elf_write_relocatable_data(code_bytes, machine, esyms, &empty_data, ext_relocs)
}

pub fn elf_write_relocatable_bss(code_bytes &[]int, machine int, esyms &ElfSyms, ebss &ElfBss, ext_relocs &[]mc.Reloc) mc.CodeBuffer {
    $ed := elf_data_layout_empty()
    if ebss.names.len > 0 || ebss.total_size > 0 {
        ed.secs.push(ElfDataSec{
            name: ".bss",
            is_nobits: true,
            writable: true,
            max_align: ebss.max_align,
            total_size: ebss.total_size,
            bytes: []int{},
            relocs: []ElfDataReloc{}
        })
        for bi in 0:ebss.names.len {
            ed.syms.push(ElfDataSym{
                name: ebss.names[bi] + "",
                sec_idx: 0,
                off: ebss.offs[bi],
                size: ebss.sizes[bi],
                is_weak: false
            })
        }
    }
    << elf_write_relocatable_data(code_bytes, machine, esyms, &ed, ext_relocs)
}

fn elf_resolve_sym_idx(nm &string, esyms &ElfSyms, edata &ElfDataLayout, first_global int, undefs $&[]string) int {
    base_data_idx := first_global + esyms.names.len
    base_undef_idx := base_data_idx + edata.syms.len
    for fi in 0:esyms.names.len {
        if esyms.names[fi] == nm + "" {
            << first_global + fi
        }
    }
    for di in 0:edata.syms.len {
        if edata.syms[di].name == nm + "" {
            << base_data_idx + di
        }
    }
    for ui in 0:undefs.len {
        if undefs[ui] == nm + "" {
            << base_undef_idx + ui
        }
    }
    found := undefs.len
    undefs.push(nm + "")
    << base_undef_idx + found
}

fn elf_read_u32_le(bytes &[]int, off int) int {
    $v := 0
    for i in 0:4 {
        v = v | ((bytes[off + i] & 255) << (i * 8))
    }
    << v
}

fn elf_read_u64_le(bytes &[]int, off int) int {
    $v := 0
    for i in 0:8 {
        v = v | ((bytes[off + i] & 255) << (i * 8))
    }
    << v
}

pub fn elf_write_relocatable_data(code_bytes &[]int, machine int, esyms &ElfSyms, edata &ElfDataLayout, ext_relocs &[]mc.Reloc) mc.CodeBuffer {
    empty_dbg := debug_sections_empty()
    << elf_write_relocatable_data_debug(code_bytes, machine, esyms, edata, ext_relocs, &empty_dbg)
}

pub fn elf_write_relocatable_data_debug(code_bytes &[]int, machine int, esyms &ElfSyms, edata &ElfDataLayout, ext_relocs &[]mc.Reloc, dbg &DebugSections) mc.CodeBuffer {
    n_data := edata.secs.len
    $rela_data_secs := []int{}
    for di in 0:n_data {
        if !edata.secs[di].is_nobits && edata.secs[di].relocs.len > 0 {
            rela_data_secs.push(di)
        }
    }
    n_rela_data := rela_data_secs.len
    has_dbg := dbg.present()
    $n_dbg_secs := 0
    if has_dbg { n_dbg_secs = 6 }

    rela_sec := 2 + n_data
    dbg_base_sec := rela_sec + 1 + n_rela_data
    sym_sec := dbg_base_sec + n_dbg_secs
    str_sec := sym_sec + 1
    shstr_sec := sym_sec + 2
    shnum := sym_sec + 4

    $out := mc.code_buffer_new()
    elf64_ident($&out)
    out.emit_u16_le(1) // ET_REL
    out.emit_u16_le(machine)
    out.emit_u32_le(1) // EV_CURRENT
    out.emit_u64_le(0) // e_entry
    out.emit_u64_le(0) // e_phoff
    shoff_at := out.len()
    out.emit_u64_le(0) // e_shoff
    out.emit_u32_le(0) // e_flags
    out.emit_u16_le(64) // e_ehsize
    out.emit_u16_le(0) // e_phentsize
    out.emit_u16_le(0) // e_phnum
    out.emit_u16_le(64) // e_shentsize
    out.emit_u16_le(shnum) // e_shnum
    out.emit_u16_le(shstr_sec) // e_shstrndx (.shstrtab)

    text_off := out.len()
    out.emit_bytes(code_bytes)
    elf_pad8($&out)

    $data_offs := []int{}
    for di in 0:n_data {
        sec := &edata.secs[di]
        if sec.is_nobits {
            data_offs.push(0)
        } else {
            off := out.len()
            data_offs.push(off)
            out.emit_bytes(&sec.bytes)
            $rem := sec.total_size - sec.bytes.len
            while rem > 0 {
                out.emit_u8(0)
                rem -= 1
            }
            elf_pad8($&out)
        }
    }

    // Emit optional DWARF sections (.debug_line, .debug_info, .debug_abbrev, .debug_str)
    $dbg_line_off := 0
    $dbg_info_off := 0
    $dbg_abbrev_off := 0
    $dbg_str_off := 0
    $dbg_line_addends := []int{}
    $dbg_info_addr_addends := []int{}
    $dbg_info_str_addends := []int{}
    if has_dbg {
        $lbytes := []int{}
        for bi in 0:dbg.line.len { lbytes.push(dbg.line[bi]) }
        for ai in 0:dbg.line_addresses.len {
            p := dbg.line_addresses[ai]
            dbg_line_addends.push(elf_read_u64_le(&lbytes, p))
            for k in 0:8 { lbytes[p + k] = 0 }
        }
        $ibytes := []int{}
        for bi in 0:dbg.info.len { ibytes.push(dbg.info[bi]) }
        if ibytes.len >= 36 {
            for k in 0:4 { ibytes[6 + k] = 0 }
            for k in 0:4 { ibytes[32 + k] = 0 }
        }
        for ai in 0:dbg.info_addresses.len {
            p := dbg.info_addresses[ai]
            dbg_info_addr_addends.push(elf_read_u64_le(&ibytes, p))
            for k in 0:8 { ibytes[p + k] = 0 }
        }
        for si in 0:dbg.info_strings.len {
            p := dbg.info_strings[si]
            dbg_info_str_addends.push(elf_read_u32_le(&ibytes, p))
            for k in 0:4 { ibytes[p + k] = 0 }
        }
        dbg_line_off = out.len()
        out.emit_bytes(&lbytes)
        dbg_info_off = out.len()
        out.emit_bytes(&ibytes)
        dbg_abbrev_off = out.len()
        out.emit_bytes(&dbg.abbrev)
        dbg_str_off = out.len()
        out.emit_bytes(&dbg.str)
        elf_pad8($&out)
    }

    // Count RISC-V PC-relative HI20 entries needing local anchor symbols for LO12_I.
    $local_pcrel_sym := []int{}
    $local_offs := []int{}
    $local_cnt := 0
    for ri in 0:ext_relocs.len {
        if machine == ELF_EM_RISCV && ext_relocs[ri].kind == mc.RELOC_RISCV_PCREL {
            local_cnt += 1
            local_pcrel_sym.push(local_cnt)
            local_offs.push(ext_relocs[ri].offset)
        } else {
            local_pcrel_sym.push(-1)
        }
    }
    $dbg_local_cnt := 0
    $dbg_text_sym := 0
    $dbg_line_sym := 0
    $dbg_abbrev_sym := 0
    $dbg_str_sym := 0
    if has_dbg {
        dbg_local_cnt = 4
        dbg_text_sym = 1 + local_cnt
        dbg_line_sym = dbg_text_sym + 1
        dbg_abbrev_sym = dbg_text_sym + 2
        dbg_str_sym = dbg_text_sym + 3
    }
    first_global := 1 + local_cnt + dbg_local_cnt

    // Resolve relocations for .text and all data sections first to populate SHN_UNDEF.
    $undefs := []string{}
    $reloc_sym := []int{}
    for ri in 0:ext_relocs.len {
        reloc_sym.push(elf_resolve_sym_idx(&ext_relocs[ri].symbol_name, esyms, edata, first_global, $&undefs))
    }
    $data_reloc_syms := [][]int{}
    for ki in 0:n_rela_data {
        di := rela_data_secs[ki]
        $row := []int{}
        for rj in 0:edata.secs[di].relocs.len {
            row.push(elf_resolve_sym_idx(&edata.secs[di].relocs[rj].sym, esyms, edata, first_global, $&undefs))
        }
        data_reloc_syms.push(row)
    }

    rela_off := out.len()
    for di in 0:n_data {
        if edata.secs[di].is_nobits {
            data_offs[di] = rela_off
        }
    }
    for ri in 0:ext_relocs.len {
        r := &ext_relocs[ri]
        if machine == ELF_EM_RISCV && r.kind == mc.RELOC_RISCV_PCREL {
            // 1. R_RISCV_PCREL_HI20 (23) -> target symbol
            out.emit_u64_le(r.offset)
            out.emit_u64_le((reloc_sym[ri] << 32) | 23)
            out.emit_u64_le(r.addend)
            // 2. R_RISCV_PCREL_LO12_I (24) -> local .text symbol at HI20 offset
            out.emit_u64_le(r.offset + 4)
            out.emit_u64_le((local_pcrel_sym[ri] << 32) | 24)
            out.emit_u64_le(0)
        } else {
            $rtype := 4 // R_X86_64_PLT32
            $radd := r.addend
            if machine == ELF_EM_X86_64 {
                if r.kind == mc.RELOC_X64_DATA_PC32 {
                    rtype = 2 // R_X86_64_PC32
                } else {
                    rtype = 4 // R_X86_64_PLT32
                }
                radd = r.addend - 4
            } else if machine == ELF_EM_AARCH64 {
                if r.kind == mc.RELOC_ABS64 {
                    rtype = 260 // R_AARCH64_PREL64
                    radd = r.offset + r.addend
                } else {
                    rtype = 283 // R_AARCH64_CALL26
                }
            } else if machine == ELF_EM_RISCV {
                rtype = 19 // R_RISCV_CALL_PLT
            }
            out.emit_u64_le(r.offset)
            out.emit_u64_le((reloc_sym[ri] << 32) | rtype)
            out.emit_u64_le(radd)
        }
    }
    rela_size := out.len() - rela_off

    $abs64_rtype := 1 // R_X86_64_64
    $abs32_rtype := 10 // R_X86_64_32
    if machine == ELF_EM_AARCH64 {
        abs64_rtype = 257 // R_AARCH64_ABS64
        abs32_rtype = 258 // R_AARCH64_ABS32
    } else if machine == ELF_EM_RISCV {
        abs64_rtype = 2 // R_RISCV_64
        abs32_rtype = 1 // R_RISCV_32
    }

    $data_rela_offs := []int{}
    $data_rela_sizes := []int{}
    for ki in 0:n_rela_data {
        di := rela_data_secs[ki]
        droff := out.len()
        data_rela_offs.push(droff)
        for rj in 0:edata.secs[di].relocs.len {
            dr := &edata.secs[di].relocs[rj]
            out.emit_u64_le(dr.off)
            out.emit_u64_le((data_reloc_syms[ki][rj] << 32) | abs64_rtype)
            out.emit_u64_le(dr.addend)
        }
        data_rela_sizes.push(out.len() - droff)
    }

    $dbg_rela_line_off := 0
    $dbg_rela_line_size := 0
    $dbg_rela_info_off := 0
    $dbg_rela_info_size := 0
    if has_dbg {
        dbg_rela_line_off = out.len()
        for ai in 0:dbg.line_addresses.len {
            out.emit_u64_le(dbg.line_addresses[ai])
            out.emit_u64_le((dbg_text_sym << 32) | abs64_rtype)
            out.emit_u64_le(dbg_line_addends[ai])
        }
        dbg_rela_line_size = out.len() - dbg_rela_line_off

        dbg_rela_info_off = out.len()
        if dbg.info.len >= 36 {
            out.emit_u64_le(6)
            out.emit_u64_le((dbg_abbrev_sym << 32) | abs32_rtype)
            out.emit_u64_le(0)
            out.emit_u64_le(32)
            out.emit_u64_le((dbg_line_sym << 32) | abs32_rtype)
            out.emit_u64_le(0)
        }
        for ai in 0:dbg.info_addresses.len {
            out.emit_u64_le(dbg.info_addresses[ai])
            out.emit_u64_le((dbg_text_sym << 32) | abs64_rtype)
            out.emit_u64_le(dbg_info_addr_addends[ai])
        }
        for si in 0:dbg.info_strings.len {
            out.emit_u64_le(dbg.info_strings[si])
            out.emit_u64_le((dbg_str_sym << 32) | abs32_rtype)
            out.emit_u64_le(dbg_info_str_addends[si])
        }
        dbg_rela_info_size = out.len() - dbg_rela_info_off
    }

    $strtab := mc.code_buffer_new()
    strtab.emit_u8(0)
    sym_off := out.len()
    elf_emit_sym($&out, 0, 0, 0, 0, 0) // STN_UNDEF
    for li in 0:local_offs.len {
        elf_emit_sym($&out, 0, 0, 1, local_offs[li], 0) // STB_LOCAL | STT_NOTYPE in .text
    }
    if has_dbg {
        elf_emit_sym($&out, 0, 0x03, 1, 0, 0)                // STT_SECTION .text
        elf_emit_sym($&out, 0, 0x03, dbg_base_sec, 0, 0)     // STT_SECTION .debug_line
        elf_emit_sym($&out, 0, 0x03, dbg_base_sec + 2, 0, 0) // STT_SECTION .debug_abbrev
        elf_emit_sym($&out, 0, 0x03, dbg_base_sec + 3, 0, 0) // STT_SECTION .debug_str
    }
    for si in 0:esyms.names.len {
        noff := elf_obj_cstr($&strtab, &esyms.names[si])
        $sinfo := 0x12 // STB_GLOBAL | STT_FUNC
        if si < esyms.weak.len && esyms.weak[si] { sinfo = 0x22 } // STB_WEAK | STT_FUNC
        elf_emit_sym($&out, noff, sinfo, 1, esyms.offs[si], 0)
    }
    for di in 0:edata.syms.len {
        ds := &edata.syms[di]
        noff := elf_obj_cstr($&strtab, &ds.name)
        $sinfo := 0x11 // STB_GLOBAL | STT_OBJECT
        if ds.is_weak { sinfo = 0x21 } // STB_WEAK | STT_OBJECT
        elf_emit_sym($&out, noff, sinfo, 2 + ds.sec_idx, ds.off, ds.size)
    }
    for ui in 0:undefs.len {
        noff := elf_obj_cstr($&strtab, &undefs[ui])
        elf_emit_sym($&out, noff, 0x10, 0, 0, 0) // STB_GLOBAL | SHN_UNDEF
    }
    sym_size := out.len() - sym_off
    str_off := out.len()
    out.emit_bytes(&strtab.bytes)

    shstr_off := out.len()
    $sec_names := ["", ".text"]
    for di in 0:n_data {
        sec_names.push(edata.secs[di].name + "")
    }
    sec_names.push(".rela.text")
    for ki in 0:n_rela_data {
        di := rela_data_secs[ki]
        sec_names.push(".rela" + edata.secs[di].name)
    }
    if has_dbg {
        sec_names.push(".debug_line")
        sec_names.push(".debug_info")
        sec_names.push(".debug_abbrev")
        sec_names.push(".debug_str")
        sec_names.push(".rela.debug_line")
        sec_names.push(".rela.debug_info")
    }
    sec_names.push(".symtab")
    sec_names.push(".strtab")
    sec_names.push(".shstrtab")
    sec_names.push(".note.GNU-stack")
    $sec_offs := []int{}
    for sname in sec_names {
        sec_offs.push(elf_obj_cstr($&out, &sname) - shstr_off)
    }
    shstr_size := out.len() - shstr_off
    elf_pad8($&out)

    shoff := out.len()
    out.patch_u64_le(shoff_at, shoff)
    elf_shdr($&out, sec_offs[0], 0, 0, 0, 0, 0, 0)
    elf_shdr($&out, sec_offs[1], 1, 6, 0, text_off, code_bytes.len, 16)
    for di in 0:n_data {
        sec := &edata.secs[di]
        $shtype := 1 // SHT_PROGBITS
        if sec.is_nobits { shtype = 8 } // SHT_NOBITS
        $shflags := 2 // SHF_ALLOC
        if sec.is_nobits || sec.writable { shflags = 3 } // SHF_WRITE | SHF_ALLOC
        $al := sec.max_align
        if al < 1 { al = 1 }
        elf_shdr($&out, sec_offs[2 + di], shtype, shflags, 0, data_offs[di], sec.total_size, al)
    }
    elf_shdr_link($&out, sec_offs[rela_sec], 4, 0x40, 0, rela_off, rela_size, sym_sec, 1, 8, 24)
    for ki in 0:n_rela_data {
        di := rela_data_secs[ki]
        elf_shdr_link($&out, sec_offs[rela_sec + 1 + ki], 4, 0x40, 0, data_rela_offs[ki], data_rela_sizes[ki], sym_sec, 2 + di, 8, 24)
    }
    if has_dbg {
        elf_shdr($&out, sec_offs[dbg_base_sec],     1, 0, 0, dbg_line_off,   dbg.line.len,   1)
        elf_shdr($&out, sec_offs[dbg_base_sec + 1], 1, 0, 0, dbg_info_off,   dbg.info.len,   1)
        elf_shdr($&out, sec_offs[dbg_base_sec + 2], 1, 0, 0, dbg_abbrev_off, dbg.abbrev.len, 1)
        elf_shdr($&out, sec_offs[dbg_base_sec + 3], 1, 0, 0, dbg_str_off,    dbg.str.len,    1)
        elf_shdr_link($&out, sec_offs[dbg_base_sec + 4], 4, 0x40, 0, dbg_rela_line_off, dbg_rela_line_size, sym_sec, dbg_base_sec,     8, 24)
        elf_shdr_link($&out, sec_offs[dbg_base_sec + 5], 4, 0x40, 0, dbg_rela_info_off, dbg_rela_info_size, sym_sec, dbg_base_sec + 1, 8, 24)
    }
    elf_shdr_link($&out, sec_offs[sym_sec], 2, 0, 0, sym_off, sym_size, str_sec, first_global, 8, 24)
    elf_shdr($&out, sec_offs[str_sec], 3, 0, 0, str_off, strtab.len(), 1)
    elf_shdr($&out, sec_offs[shstr_sec], 3, 0, 0, shstr_off, shstr_size, 1)
    elf_shdr($&out, sec_offs[shstr_sec + 1], 1, 0, 0, shoff, 0, 1)
    << out
}
