@xu/obj
// DWARF v4 debug information for the ELF64 and Mach-O executable writers.
//
// Ported from the product compiler (src/cmd/compile/dwarf.xu). Emits the
// four sections a debugger needs for line breakpoints, function names and
// frame-relative locals:
//
//   .debug_line   - line-number program (address -> line)
//   .debug_info   - one compile unit, base types, subprograms and variables
//   .debug_abbrev - the static abbreviation table for those DIE shapes
//   .debug_str    - string pool (CU, function, local and type names)
//
// Offsets in DLineRow and DFuncRow are relative to the start of the code;
// encode_dwarf adds the code's virtual address.

pub struct DLineRow {
pub:
    offset int
    file int
    line int
}

pub struct DLocalRow {
pub:
    name string
    // Byte offset from the frame pointer.
    fp_off int
    line int
    // DWARF_TY_* code.
    ty int
    is_param bool
}

pub struct DFuncRow {
pub:
    name string
    file int
    line int
    start int
    size int
    locals []DLocalRow
}

pub struct DebugInfo {
pub:
    files []string
    rows []DLineRow
    funcs []DFuncRow
    // DWARF number of the frame pointer register (arm64 x29 = 29, x64 rbp = 6).
    fp_reg int
}

pub struct DebugSections {
pub:
    line []int
    info []int
    abbrev []int
    str []int
}

pub const DWARF_TY_INT = 0
pub const DWARF_TY_BOOL = 1
pub const DWARF_TY_F64 = 2
pub const DWARF_TY_U8 = 3
pub const DWARF_TY_I32 = 4
pub const DWARF_TY_U32 = 5
pub const DWARF_TY_PTR = 6
// {ptr, len, cap} descriptor whose ptr points at the bytes.
pub const DWARF_TY_STR = 7

pub const DWARF_REG_ARM64_FP = 29
pub const DWARF_REG_X64_RBP = 6
pub const DWARF_REG_RISCV_FP = 8
pub const DWARF_REG_LOONG_FP = 22

pub fn debug_sections_empty() DebugSections {
    << DebugSections{line: []int{}, info: []int{}, abbrev: []int{}, str: []int{}}
}

pub fn (d &DebugSections) present() bool {
    << d.line.len > 0
}

fn d_w16(buf $&[]int, v int) {
    buf.push(v & 255)
    buf.push((v >> 8) & 255)
}

fn d_w32(buf $&[]int, v int) {
    for i in 0:4 {
        buf.push((v >> (8 * i)) & 255)
    }
}

fn d_w64(buf $&[]int, v int) {
    for i in 0:8 {
        buf.push((v >> (8 * i)) & 255)
    }
}

fn d_uleb(buf $&[]int, value int) {
    $v := value
    for i in 0:10 {
        b := v & 127
        v = v >> 7
        if v == 0 {
            buf.push(b)
            <<
        }
        buf.push(b | 128)
    }
}

fn d_sleb(buf $&[]int, value int) {
    $v := value
    for i in 0:10 {
        b := v & 127
        v = v >> 7
        sign_set := (b & 64) != 0
        if (v == 0 && !sign_set) || (v == -1 && sign_set) {
            buf.push(b)
            <<
        }
        buf.push(b | 128)
    }
}

fn d_cstr(buf $&[]int, s string) {
    for i in 0:s.len {
        buf.push(s[i])
    }
    buf.push(0)
}

fn d_encode_line(di &DebugInfo, files &[]string, code_vaddr int, code_len int) []int {
    $header := []int{}
    header.push(1)   // minimum_instruction_length
    header.push(1)   // maximum_operations_per_instruction
    header.push(1)   // default_is_stmt
    header.push(251) // line_base = -5
    header.push(14)  // line_range
    header.push(13)  // opcode_base
    // standard_opcode_lengths[1..12]
    lens := [0, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0, 1]
    for i in 0:lens.len {
        header.push(lens[i])
    }
    header.push(0) // include_directories: none
    for f in 0:files.len {
        d_cstr($&header, files[f])
        d_uleb($&header, 0) // directory
        d_uleb($&header, 0) // mtime
        d_uleb($&header, 0) // size
    }
    header.push(0)

    $prog := []int{}
    $cur_line := 1
    $cur_file := 1
    for r in 0:di.rows.len {
        // DW_LNE_set_address
        prog.push(0)
        d_uleb($&prog, 9)
        prog.push(2)
        d_w64($&prog, code_vaddr + di.rows[r].offset)
        file := di.rows[r].file + 1
        if file != cur_file {
            prog.push(4) // DW_LNS_set_file
            d_uleb($&prog, file)
            cur_file = file
        }
        delta := di.rows[r].line - cur_line
        if delta != 0 {
            prog.push(3) // DW_LNS_advance_line
            d_sleb($&prog, delta)
            cur_line = di.rows[r].line
        }
        prog.push(1) // DW_LNS_copy
    }
    // The sequence ends at the end of the code.
    prog.push(0)
    d_uleb($&prog, 9)
    prog.push(2)
    d_w64($&prog, code_vaddr + code_len)
    prog.push(0)
    d_uleb($&prog, 1)
    prog.push(1) // DW_LNE_end_sequence

    $out := []int{}
    d_w32($&out, 2 + 4 + header.len + prog.len)
    d_w16($&out, 4)
    d_w32($&out, header.len)
    for i in 0:header.len {
        out.push(header[i])
    }
    for i in 0:prog.len {
        out.push(prog[i])
    }
    << out
}

// String pool offsets: [0] CU name, [1..] function names, then locals in
// order, then the base type names (see encode_dwarf).
fn d_encode_info(di &DebugInfo, code_vaddr int, code_len int, str_offs &[]int, ty_str int) []int {
    $body := []int{}
    d_w16($&body, 4) // version
    d_w32($&body, 0) // debug_abbrev_offset
    body.push(8)     // address_size

    // Compile unit (abbrev 1).
    d_uleb($&body, 1)
    d_w32($&body, str_offs[0])
    d_w64($&body, code_vaddr)
    d_w64($&body, code_vaddr + code_len)
    d_w32($&body, 0) // DW_AT_stmt_list
    d_w16($&body, 2) // DW_LANG_C

    // Base types (abbrev 4) in DWARF_TY_* order, then a pointer to int
    // (abbrev 5). ref4 offsets count from the unit header (4-byte length).
    sizes := [8, 1, 8, 1, 4, 4]
    encs := [5, 2, 4, 8, 5, 7]
    $ty_off := []int{}
    for t in 0:sizes.len {
        ty_off.push(4 + body.len)
        d_uleb($&body, 4)
        d_w32($&body, str_offs[ty_str + t])
        body.push(sizes[t])
        body.push(encs[t])
    }
    ty_off.push(4 + body.len)
    d_uleb($&body, 5)
    d_w32($&body, ty_off[DWARF_TY_INT])
    body.push(8)
    // string: struct { ptr *u8, len int, cap int }
    u8p := 4 + body.len
    d_uleb($&body, 5)
    d_w32($&body, ty_off[DWARF_TY_U8])
    body.push(8)
    ty_off.push(4 + body.len)
    d_uleb($&body, 6)
    d_w32($&body, str_offs[ty_str + 6])
    body.push(24)
    $mty := [u8p, ty_off[DWARF_TY_INT], ty_off[DWARF_TY_INT]]
    for mi in 0:3 {
        d_uleb($&body, 7)
        d_w32($&body, str_offs[ty_str + 7 + mi])
        d_w32($&body, mty[mi])
        body.push(mi * 8)
    }
    body.push(0)

    $local_str := 1 + di.funcs.len
    for i in 0:di.funcs.len {
        d_uleb($&body, 2)
        d_w32($&body, str_offs[1 + i])
        d_w64($&body, code_vaddr + di.funcs[i].start)
        d_w64($&body, code_vaddr + di.funcs[i].start + di.funcs[i].size)
        body.push(di.funcs[i].file + 1)
        d_w32($&body, di.funcs[i].line)
        body.push(1) // DW_AT_external
        // DW_AT_frame_base: DW_OP_breg<fp> 0
        body.push(2)
        body.push(0x70 + di.fp_reg)
        body.push(0)
        for li in 0:di.funcs[i].locals.len {
            if di.funcs[i].locals[li].is_param {
                d_uleb($&body, 8)
            } else {
                d_uleb($&body, 3)
            }
            d_w32($&body, str_offs[local_str])
            local_str += 1
            $ty := di.funcs[i].locals[li].ty
            if ty < 0 || ty >= ty_off.len { ty = DWARF_TY_INT }
            d_w32($&body, ty_off[ty])
            // DW_OP_fbreg <offset>
            $expr := []int{}
            expr.push(0x91)
            d_sleb($&expr, di.funcs[i].locals[li].fp_off)
            d_uleb($&body, expr.len)
            for ei in 0:expr.len {
                body.push(expr[ei])
            }
            d_w32($&body, di.funcs[i].locals[li].line)
        }
        body.push(0) // end of subprogram children
    }
    body.push(0) // end of compile unit children

    $out := []int{}
    d_w32($&out, body.len)
    for i in 0:body.len {
        out.push(body[i])
    }
    << out
}

fn d_abbrev(out $&[]int, code int, tag int, children bool, attrs &[]int) {
    d_uleb(out, code)
    d_uleb(out, tag)
    if children { out.push(1) } else { out.push(0) }
    for i in 0:attrs.len {
        d_uleb(out, attrs[i])
    }
    out.push(0)
    out.push(0)
}

fn d_encode_abbrev() []int {
    $out := []int{}
    // compile_unit: name strp, low_pc addr, high_pc addr, stmt_list
    // sec_offset, language data2
    a1 := [3, 14, 17, 1, 18, 1, 16, 23, 19, 5]
    d_abbrev($&out, 1, 0x11, true, &a1)
    // subprogram: name, low_pc, high_pc, decl_file data1, decl_line data4,
    // external flag, frame_base exprloc
    a2 := [3, 14, 17, 1, 18, 1, 58, 11, 59, 6, 63, 12, 64, 24]
    d_abbrev($&out, 2, 0x2e, true, &a2)
    // variable: name, type ref4, location exprloc, decl_line data4
    a3 := [3, 14, 73, 19, 2, 24, 59, 6]
    d_abbrev($&out, 3, 0x34, false, &a3)
    // base_type: name, byte_size data1, encoding data1
    a4 := [3, 14, 11, 11, 62, 11]
    d_abbrev($&out, 4, 0x24, false, &a4)
    // pointer_type: type ref4, byte_size data1
    a5 := [73, 19, 11, 11]
    d_abbrev($&out, 5, 0x0f, false, &a5)
    // structure_type: name, byte_size data1
    a6 := [3, 14, 11, 11]
    d_abbrev($&out, 6, 0x13, true, &a6)
    // member: name, type ref4, data_member_location data1
    a7 := [3, 14, 73, 19, 56, 11]
    d_abbrev($&out, 7, 0x0d, false, &a7)
    // formal_parameter: as variable
    a8 := [3, 14, 73, 19, 2, 24, 59, 6]
    d_abbrev($&out, 8, 0x05, false, &a8)
    out.push(0)
    << out
}

pub fn encode_dwarf(di &DebugInfo, code_vaddr int, code_len int) DebugSections {
    $files := []string{}
    for i in 0:di.files.len {
        files.push(di.files[i] + "")
    }
    if files.len == 0 {
        files.push("<input>")
    }
    $pool := []int{}
    $offs := []int{}
    offs.push(pool.len)
    d_cstr($&pool, files[0])
    for fi in 0:di.funcs.len {
        offs.push(pool.len)
        d_cstr($&pool, di.funcs[fi].name)
    }
    for fi in 0:di.funcs.len {
        for li in 0:di.funcs[fi].locals.len {
            offs.push(pool.len)
            d_cstr($&pool, di.funcs[fi].locals[li].name)
        }
    }
    ty_str := offs.len
    names := ["int", "bool", "f64", "u8", "i32", "u32", "string", "ptr", "len", "cap"]
    for t in 0:names.len {
        offs.push(pool.len)
        d_cstr($&pool, names[t])
    }
    << DebugSections{
        line: d_encode_line(di, &files, code_vaddr, code_len),
        info: d_encode_info(di, code_vaddr, code_len, &offs, ty_str),
        abbrev: d_encode_abbrev(),
        str: pool
    }
}
