@xu/obj
// Object file and binary container abstractions.
//
// Layer 4D module: format-agnostic container representing sections, symbols,
// and relocations to be serialized into Mach-O, ELF, or PE.

#xu/mc

pub const SECTION_TEXT = 1
pub const SECTION_DATA = 2
pub const SECTION_RODATA = 3
pub const SECTION_BSS = 4

pub struct ObjectSection {
    pub name string
    pub kind int
    pub data []int
    pub alignment int
    pub relocs []mc.Reloc
}

pub fn object_section_new(name string, kind int, alignment int) ObjectSection {
    << ObjectSection{
        name: ~name,
        kind: kind,
        data: []int{},
        alignment: alignment,
        relocs: []mc.Reloc{}
    }
}

pub struct ObjectSymbol {
    pub name string
    pub section_index int
    pub offset int
    pub is_global bool
    pub is_function bool
}

pub fn object_symbol_new(name string, sec_idx int, offset int, is_global bool, is_function bool) ObjectSymbol {
    << ObjectSymbol{
        name: ~name,
        section_index: sec_idx,
        offset: offset,
        is_global: is_global,
        is_function: is_function
    }
}

pub struct ObjectFile {
    pub os int
    pub arch int
    pub sections []ObjectSection
    pub symbols []ObjectSymbol
    pub entry_point string
}

pub fn object_file_new(os int, arch int) ObjectFile {
    << ObjectFile{
        os: os,
        arch: arch,
        sections: []ObjectSection{},
        symbols: []ObjectSymbol{},
        entry_point: ""
    }
}

pub fn (obj $&ObjectFile) add_section(sec &ObjectSection) int {
    idx := obj.sections.len
    $relocs_copy := []mc.Reloc{}
    for i in 0:sec.relocs.len {
        relocs_copy.push(~sec.relocs[i])
    }
    $data_copy := []int{}
    for i in 0:sec.data.len {
        data_copy.push(sec.data[i])
    }
    obj.sections.push(ObjectSection{
        name: ~sec.name,
        kind: sec.kind,
        data: data_copy,
        alignment: sec.alignment,
        relocs: relocs_copy
    })
    << idx
}

pub fn (obj $&ObjectFile) add_symbol(sym &ObjectSymbol) int {
    idx := obj.symbols.len
    obj.symbols.push(~sym)
    << idx
}
