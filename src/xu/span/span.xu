@xu/span
// Source code position, span and structured diagnostics.
//
// Layer 0 module: foundational types with zero compiler-internal dependencies.

pub struct Pos {
    pub line int
    pub col int
    pub offset int
}

pub fn new_pos(line int, col int, offset int) Pos {
    << Pos{
        line: line,
        col: col,
        offset: offset
    }
}

pub struct Span {
    pub start Pos
    pub end Pos
}

pub fn new_span(start Pos, end Pos) Span {
    << Span{
        start: start,
        end: end
    }
}

pub struct SourceFile {
    pub name string
    pub src string
    pub lines []int
}

pub fn new_source_file(name string, src string) SourceFile {
    $lines := []int{}
    lines.push(0)
    for i in 0:src.len {
        if src[i] == 10 { // '\n'
            lines.push(i + 1)
        }
    }
    << SourceFile{
        name: name,
        src: src,
        lines: lines
    }
}

// Convert byte offset into line and column (1-based).
pub fn (f &SourceFile) pos_at(offset int) Pos {
    if f.lines.len == 0 {
        << new_pos(1, 1, offset)
    }
    $low := 0
    $high := f.lines.len - 1
    $line_idx := 0
    while low <= high {
        mid := (low + high) / 2
        if f.lines[mid] <= offset {
            line_idx = mid
            low = mid + 1
        } else {
            high = mid - 1
        }
    }
    line := line_idx + 1
    line_start := f.lines[line_idx]
    col := offset - line_start + 1
    << new_pos(line, col, offset)
}

pub struct Diagnostic {
    pub path string
    pub line int
    pub col int
    pub msg string
    pub is_warning bool
}

pub fn new_error_diag(path string, line int, col int, msg string) Diagnostic {
    << Diagnostic{
        path: path,
        line: line,
        col: col,
        msg: msg,
        is_warning: false
    }
}

pub fn new_warning_diag(path string, line int, col int, msg string) Diagnostic {
    << Diagnostic{
        path: path,
        line: line,
        col: col,
        msg: msg,
        is_warning: true
    }
}

pub fn (d &Diagnostic) format() string {
    $kind := "error"
    if d.is_warning {
        kind = "warning"
    }
    if d.path.len > 0 {
        << d.path + ":" + str(d.line) + ":" + str(d.col) + ": " + kind + ": " + d.msg
    }
    << str(d.line) + ":" + str(d.col) + ": " + kind + ": " + d.msg
}

pub struct DiagnosticSink {
    pub diags []Diagnostic
    pub has_error bool
}

pub fn new_diagnostic_sink() DiagnosticSink {
    << DiagnosticSink{
        diags: []Diagnostic{},
        has_error: false
    }
}

pub fn (s $&DiagnosticSink) emit(diag Diagnostic) {
    if !diag.is_warning {
        s.has_error = true
    }
    s.diags.push(diag)
}

pub fn (s $&DiagnosticSink) emit_error(path string, line int, col int, msg string) {
    s.emit(new_error_diag(path, line, col, msg))
}

pub fn (s $&DiagnosticSink) emit_warning(path string, line int, col int, msg string) {
    s.emit(new_warning_diag(path, line, col, msg))
}
