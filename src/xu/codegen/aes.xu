@xu/codegen

#xu/mc
#xu/target
#xu/target/chips/apple_m1 as arm_crypto

const AES_SUPPORTED = "_xu_crypto_aes_aes_hw_supported"
const AES_ENCRYPT = "_xu_crypto_aes_aes_hw_block_enc"
const AES_DECRYPT = "_xu_crypto_aes_aes_hw_block_dec"
const AES_DRK = "_xu_crypto_aes_aes_hw_drk"

// Code for the private stdlib entry points uses the same descriptor layout
// and word arguments as a typed MIR call. Keep the software bodies on other
// targets, and probe CPU support before constructing a hardware Cipher.
pub fn aes_hw_entry(label &string) bool {
    << *label == AES_SUPPORTED || *label == AES_ENCRYPT ||
       *label == AES_DECRYPT || *label == AES_DRK
}

fn a64_aes_mem(cb $&mc.CodeBuffer, store bool, vec int, base int) {
    $op := 0x3DC00000 // ldr q
    if store { op = 0x3D800000 }
    e32(cb, op | (base << 5) | vec)
}

fn emit_arm64_crypto_probe(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, os int, object bool, bit int) {
    if os == target.OS_MACOS {
        a64_mov_imm(cb, 0, 1)
    } else if os == target.OS_WINDOWS {
        e32(cb, 0xA9BF7BFD) // stp x29, x30, [sp, #-16]!
        a64_mov_imm(cb, 0, WIN_SLOT_BASE + WIN_SLOT_CPU_FEATURE)
        a64_mov_imm(cb, 1, 30) // PF_ARM_V8_CRYPTO_INSTRUCTIONS_AVAILABLE
        a64_branch_reloc(cb, relocs, 0x94000000, "__xu_syscall", mc.RELOC_ARM64_CALL26)
        e32(cb, 0x7100001F) // cmp w0, #0 (Win32 BOOL)
        a64_cset(cb, 0, 1)
        e32(cb, 0xA8C17BFD) // ldp x29, x30, [sp], #16
    } else if os == target.OS_LINUX && !object {
        a64_ldr(cb, 0, R_STATE, A64_HWCAP_OFFSET)
        e32(cb, 0xD3400000 | (bit << 16) | (bit << 10)) // ubfx x0, x0, #bit, #1
    } else {
        a64_mov_imm(cb, 0, 0)
    }
    e32(cb, 0xD65F03C0)
}

pub fn emit_arm64_aes(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, label &string, os int, object bool) {
    syms.define_label(*label, cb.len())
    if *label == AES_SUPPORTED {
        emit_arm64_crypto_probe(cb, relocs, os, object, 3)
        <<
    }
    a64_ldr(cb, 0, 0, 0)
    a64_ldr(cb, 1, 1, 0)
    if *label == AES_DRK {
        // Copy the last key, transform the intermediate keys in reverse
        // order, then copy the first key to the end.
        e32(cb, 0x8B021023) // add x3, x1, x2, lsl #4
        a64_aes_mem(cb, false, 0, 3)
        a64_aes_mem(cb, true, 0, 0)
        a64_add_imm(cb, 0, 0, 16)
        loop := AES_DRK + ".loop"
        syms.define_label(~loop, cb.len())
        e32(cb, 0xD1004063) // sub x3, x3, #16
        a64_aes_mem(cb, false, 0, 3)
        a64_cmp(cb, 3, 1)
        done := AES_DRK + ".done"
        a64_branch_reloc(cb, relocs, 0x54000000, ~done, mc.RELOC_ARM64_COND_BR19)
        arm_crypto.emit_aesimc(cb, 0, 0)
        a64_aes_mem(cb, true, 0, 0)
        a64_add_imm(cb, 0, 0, 16)
        a64_branch_reloc(cb, relocs, 0x14000000, loop, mc.RELOC_ARM64_CALL26)
        syms.define_label(done, cb.len())
        a64_aes_mem(cb, true, 0, 0)
        a64_mov_imm(cb, 0, 1)
    } else {
        a64_ldr(cb, 2, 2, 0)
        a64_aes_mem(cb, false, 0, 1)
        a64_aes_mem(cb, false, 1, 2)
        a64_mov_imm(cb, 4, 1)
        loop := *label + ".loop"
        syms.define_label(~loop, cb.len())
        if *label == AES_ENCRYPT {
            arm_crypto.emit_aese(cb, 0, 1)
            arm_crypto.emit_aesmc(cb, 0, 0)
        } else {
            arm_crypto.emit_aesd(cb, 0, 1)
            arm_crypto.emit_aesimc(cb, 0, 0)
        }
        a64_add_imm(cb, 2, 2, 16)
        a64_aes_mem(cb, false, 1, 2)
        a64_add_imm(cb, 4, 4, 1)
        a64_cmp(cb, 4, 3)
        a64_branch_reloc(cb, relocs, 0x5400000B, loop, mc.RELOC_ARM64_COND_BR19)
        if *label == AES_ENCRYPT {
            arm_crypto.emit_aese(cb, 0, 1)
        } else {
            arm_crypto.emit_aesd(cb, 0, 1)
        }
        a64_add_imm(cb, 2, 2, 16)
        a64_aes_mem(cb, false, 1, 2)
        e32(cb, 0x6E211C00) // eor v0.16b, v0.16b, v1.16b
        a64_aes_mem(cb, true, 0, 0)
    }
    e32(cb, 0xD65F03C0)
}

fn x64_aes_mem(cb $&mc.CodeBuffer, store bool, vec int, base int) {
    xb(cb, 0xF3)
    x64_rex(cb, false, vec, base, false)
    xb(cb, 0x0F)
    if store { xb(cb, 0x7F) } else { xb(cb, 0x6F) }
    x64_modrm_mem(cb, vec, base, 0)
}

fn x64_aes_op(cb $&mc.CodeBuffer, op int, dst int, src int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x38)
    xb(cb, op)
    x64_modrm_rr(cb, dst, src)
}

pub fn emit_x64_aes(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, label &string) {
    syms.define_label(*label, cb.len())
    if *label == AES_SUPPORTED {
        xb(cb, 0x53) // push rbx, preserved by the internal ABI
        x64_mov_imm(cb, X_RAX, 1)
        xb(cb, 0x0F)
        xb(cb, 0xA2) // cpuid
        x64_mov(cb, X_RAX, X_RCX)
        xb(cb, 0x48)
        xb(cb, 0xC1)
        xb(cb, 0xE8)
        xb(cb, 25) // shr rax, 25
        x64_alu_imm(cb, 4, X_RAX, 1)
        xb(cb, 0x5B) // pop rbx
        x64_ret(cb)
        <<
    }
    x64_ldr(cb, X_RDI, X_RDI, 0)
    x64_ldr(cb, X_RSI, X_RSI, 0)
    if *label == AES_DRK {
        x64_mov(cb, X_RAX, X_RDX)
        xb(cb, 0x48)
        xb(cb, 0xC1)
        xb(cb, 0xE0)
        xb(cb, 4) // shl rax, 4
        x64_op_rr(cb, 0x01, X_RSI, X_RAX)
        x64_aes_mem(cb, false, 0, X_RAX)
        x64_aes_mem(cb, true, 0, X_RDI)
        x64_alu_imm(cb, 0, X_RDI, 16)
        loop := AES_DRK + ".loop"
        syms.define_label(~loop, cb.len())
        x64_alu_imm(cb, 5, X_RAX, 16)
        x64_aes_mem(cb, false, 0, X_RAX)
        x64_op_rr(cb, 0x39, X_RSI, X_RAX)
        done := x64_jshort(cb, CC_E)
        x64_aes_op(cb, 0xDB, 0, 0) // aesimc
        x64_aes_mem(cb, true, 0, X_RDI)
        x64_alu_imm(cb, 0, X_RDI, 16)
        x64_jmp(cb, relocs, loop)
        x64_land(cb, done)
        x64_aes_mem(cb, true, 0, X_RDI)
        x64_mov_imm(cb, X_RAX, 1)
    } else {
        x64_ldr(cb, X_RDX, X_RDX, 0)
        x64_aes_mem(cb, false, 0, X_RSI)
        x64_aes_mem(cb, false, 1, X_RDX)
        xb(cb, 0x66)
        xb(cb, 0x0F)
        xb(cb, 0xEF)
        xb(cb, 0xC1) // pxor xmm0, xmm1
        x64_alu_imm(cb, 5, X_RCX, 1)
        loop := *label + ".loop"
        syms.define_label(~loop, cb.len())
        x64_alu_imm(cb, 0, X_RDX, 16)
        x64_aes_mem(cb, false, 1, X_RDX)
        $op := 0xDC
        if *label == AES_DECRYPT { op = 0xDE }
        x64_aes_op(cb, op, 0, 1)
        x64_alu_imm(cb, 5, X_RCX, 1)
        x64_jcc(cb, relocs, CC_NE, loop)
        x64_alu_imm(cb, 0, X_RDX, 16)
        x64_aes_mem(cb, false, 1, X_RDX)
        x64_aes_op(cb, op + 1, 0, 1)
        x64_aes_mem(cb, true, 0, X_RDI)
    }
    x64_ret(cb)
}
