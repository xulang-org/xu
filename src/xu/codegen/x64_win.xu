@xu/codegen
// Windows x64 entry, system-call bridge and import tables.
//
// Windows has no stable system calls, so the runtime calls DLL exports
// through the import address table (IAT). rt_syscall(WIN_SLOT_BASE + s,
// a..f) calls IAT slot s with the Win64 convention (rcx, rdx, r8, r9, then
// the stack above 32 bytes of shadow space) and returns rax unchanged;
// s >= 4096 calls slot s - 4096 with up to 12 arguments read from the word
// array at a. Smaller non-negative numbers are POSIX system calls, which
// fail with -ENOSYS (38). Pseudo-call -6 calls the function pointer a with
// up to 12 arguments from the word array at b (exports resolved at run
// time). The other negative pseudo-calls are the same as on the other
// targets. Win64 callees preserve rbx, rbp, rdi, rsi and r12-r15,
// which covers everything generated code keeps in registers.

#internal/uiabi
#xu/mc

// The code section's RVA in obj/pe.xu (SectionAlignment).
const PE_TEXT_RVA = 4096

const WIN_SLOT_BASE = 65536
const WIN_SLOT_VIRTUAL_ALLOC = 4
const WIN_SLOT_EXIT_PROCESS = 0

pub fn win_import_dlls() []string {
    << ["kernel32.dll"]
}

// Exports per DLL. The runtime (runtime/core host_win.xu) numbers slots by
// position: each DLL's names, then one null slot.
pub fn win_import_names(dll int) []string {
    if dll == 0 {
        << ["ExitProcess", "GetStdHandle", "WriteFile", "ReadFile", "VirtualAlloc", "VirtualFree", "GetLastError", "GetCommandLineA", "GetEnvironmentStringsA", "CreateFileA", "CloseHandle", "SetFilePointerEx", "GetFileAttributesExA", "CreateDirectoryA", "RemoveDirectoryA", "DeleteFileA", "MoveFileExA", "FindFirstFileA", "FindNextFileA", "FindClose", "GetCurrentDirectoryA", "SetCurrentDirectoryA", "QueryPerformanceCounter", "QueryPerformanceFrequency", "GetSystemTimeAsFileTime", "Sleep", "GetCurrentProcessId", "GetComputerNameA", "CreatePipe", "PeekNamedPipe", "GetFileType", "CreateProcessA", "WaitForSingleObject", "GetExitCodeProcess", "TerminateProcess", "SetHandleInformation", "SetFileAttributesA", "CreateSymbolicLinkA", "GetFileSizeEx", "LockFileEx", "LoadLibraryA", "GetProcAddress"]
    }
    << []string{}
}

// xu_app_start(int argc, char **argv) never returns; enters on Win64 C ABI
// with rsp % 16 == 8, matching __xu_start.
pub fn emit_windows_x64_entry(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    syms.define_label("xu_app_start", cb.len())
    x64_jmp(cb, relocs, "__xu_start")
}

fn emit_win_x64_ui_tick(cb $&mc.CodeBuffer) {
    // Win64 caller expects r15, rdi, and rsi preserved; Xu scratch uses rdi/rsi.
    // At entry rsp % 16 == 8; three pushes leave rsp % 16 == 0 before call rdx.
    xb(cb, 0x41)
    xb(cb, 0x57) // push r15
    xb(cb, 0x57) // push rdi
    xb(cb, 0x56) // push rsi
    x64_mov(cb, X_R15, X_RCX)
    x64_call_reg(cb, X_RDX)
    xb(cb, 0x5E) // pop rsi
    xb(cb, 0x5F) // pop rdi
    xb(cb, 0x41)
    xb(cb, 0x5F) // pop r15
    x64_ret(cb)
}

fn win_x64_ui_case(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, nr int, symbol string) {
    x64_cmp_imm8(cb, X_RDI, nr)
    next := x64_jshort(cb, CC_NE)
    xb(cb, 0x55) // push rbp
    x64_mov(cb, X_RBP, X_RSP)
    // and rsp, -16
    xb(cb, 0x48)
    xb(cb, 0x83)
    xb(cb, 0xE4)
    xb(cb, 0xF0)
    x64_add_rsp(cb, -32)
    if nr == uiabi.RUN {
        x64_mov(cb, X_R9, X_RDX)
        x64_mov(cb, X_R8, X_RCX)
        x64_mov(cb, X_RCX, X_RSI)
        x64_lea_label(cb, relocs, X_RDX, "__xu_ui_tick")
    } else {
        x64_mov(cb, X_R9, X_R8)
        x64_mov(cb, X_R8, X_RCX)
        x64_mov(cb, X_RCX, X_RSI)
    }
    x64_call(cb, relocs, symbol)
    xb(cb, 0x48)
    xb(cb, 0x63)
    xb(cb, 0xC0) // movsxd rax, eax (C int result)
    x64_mov(cb, X_RSP, X_RBP)
    xb(cb, 0x5D) // pop rbp
    x64_ret(cb)
    x64_land(cb, next)
}

fn emit_win_x64_ui_dispatch(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc) {
    win_x64_ui_case(cb, relocs, uiabi.RUN, "xu_ui_host_run_cooperative")
    win_x64_ui_case(cb, relocs, uiabi.READ_LEN, "xu_ui_mem_try_read_len")
    win_x64_ui_case(cb, relocs, uiabi.READ_COPY, "xu_ui_mem_try_read_copy")
    win_x64_ui_case(cb, relocs, uiabi.WRITE, "xu_ui_mem_try_write")
}

fn emit_x64_windows_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, main_label string, link_ui bool, emit_object bool) {
    // __xu_start: the loader enters with rsp = 8 mod 16. The state block
    // comes from VirtualAlloc(0, 64K, MEM_COMMIT | MEM_RESERVE,
    // PAGE_READWRITE); argc/argv/envp stay 0 (the runtime builds them).
    syms.define_label("__xu_start", cb.len())
    x64_add_rsp(cb, -8)
    x64_mov_imm(cb, X_RDI, WIN_SLOT_BASE + WIN_SLOT_VIRTUAL_ALLOC)
    x64_mov_imm(cb, X_RSI, 0)
    x64_mov_imm(cb, X_RDX, 65536)
    x64_mov_imm(cb, X_RCX, 0x3000)
    x64_mov_imm(cb, X_R8, 4)
    x64_call(cb, relocs, "__xu_syscall")
    x64_mov(cb, X_R15, X_RAX)
    if link_ui {
        // Tell runtime/core host_ui that the UI host is linked in this object.
        x64_mov_imm(cb, X_RAX, 1)
        x64_str(cb, X_RAX, X_R15, uiabi.STATE_OFFSET)
    }
    x64_call(cb, relocs, main_label)
    x64_mov(cb, X_RSI, X_RAX)
    x64_mov_imm(cb, X_RDI, WIN_SLOT_BASE + WIN_SLOT_EXIT_PROCESS)
    x64_call(cb, relocs, "__xu_syscall")
    x64_ud2(cb)

    if link_ui {
        syms.define_label("__xu_ui_tick", cb.len())
        emit_win_x64_ui_tick(cb)
    }

    syms.define_label("__xu_syscall", cb.len())
    x64_cmp_imm8(cb, X_RDI, -5)
    not5 := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_RCX, X_RDX)
    x64_mov(cb, X_RDI, X_RSI)
    x64_mov_imm(cb, X_RAX, 0)
    // rep stosb
    xb(cb, 0xF3)
    xb(cb, 0xAA)
    x64_ret(cb)
    x64_land(cb, not5)
    x64_cmp_imm8(cb, X_RDI, -4)
    not4 := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_RDI, X_RSI)
    x64_mov(cb, X_RSI, X_RDX)
    // rep movsb
    xb(cb, 0xF3)
    xb(cb, 0xA4)
    x64_ret(cb)
    x64_land(cb, not4)
    x64_cmp_imm8(cb, X_RDI, -2)
    not2 := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_RAX, X_RBP)
    x64_ret(cb)
    x64_land(cb, not2)
    x64_cmp_imm8(cb, X_RDI, -3)
    not3 := x64_jshort(cb, CC_NE)
    x64_lea_label(cb, relocs, X_RAX, "__xu_start")
    x64_ret(cb)
    x64_land(cb, not3)
    x64_cmp_imm8(cb, X_RDI, -1)
    x64_jcc(cb, relocs, CC_E, "__xu_task_switch")
    if link_ui {
        emit_win_x64_ui_dispatch(cb, relocs)
    }
    // push rbp; mov rbp, rsp; and rsp, -16; 32 bytes of shadow space and
    // eight stack arguments.
    xb(cb, 0x55)
    x64_mov(cb, X_RBP, X_RSP)
    xb(cb, 0x48)
    xb(cb, 0x83)
    xb(cb, 0xE4)
    xb(cb, 0xF0)
    x64_add_rsp(cb, -96)
    x64_cmp_imm8(cb, X_RDI, -6)
    not6 := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_R11, X_RSI)
    x64_mov(cb, X_RSI, X_RDX)
    ptr := x64_jshort(cb, -1)
    x64_land(cb, not6)
    x64_mov(cb, X_RAX, X_RDI)
    // cmp rax, WIN_SLOT_BASE
    xb(cb, 0x48)
    xb(cb, 0x3D)
    cb.emit_u32_le(WIN_SLOT_BASE)
    win := x64_jshort(cb, CC_AE)
    x64_mov_imm(cb, X_RAX, -38)
    x64_mov(cb, X_RSP, X_RBP)
    xb(cb, 0x5D)
    x64_ret(cb)
    x64_land(cb, win)
    // rax -= WIN_SLOT_BASE
    xb(cb, 0x48)
    xb(cb, 0x2D)
    cb.emit_u32_le(WIN_SLOT_BASE)
    // cmp rax, 4096
    xb(cb, 0x48)
    xb(cb, 0x3D)
    cb.emit_u32_le(4096)
    direct := x64_jshort(cb, CC_B)
    // rax -= 4096
    xb(cb, 0x48)
    xb(cb, 0x2D)
    cb.emit_u32_le(4096)
    x64_win_iat_entry(cb, relocs, emit_object)
    x64_land(cb, ptr)
    // r11 = callee, rsi = argument words.
    for i in 4:12 {
        x64_ldr(cb, X_RAX, X_RSI, i * 8)
        x64_str(cb, X_RAX, X_RSP, i * 8)
    }
    x64_ldr(cb, X_RCX, X_RSI, 0)
    x64_ldr(cb, X_RDX, X_RSI, 8)
    x64_ldr(cb, X_R8, X_RSI, 16)
    x64_ldr(cb, X_R9, X_RSI, 24)
    x64_win_call_r11(cb)
    x64_land(cb, direct)
    x64_win_iat_entry(cb, relocs, emit_object)
    x64_str(cb, X_R9, X_RSP, 32)
    x64_str(cb, X_R10, X_RSP, 40)
    x64_mov(cb, X_R9, X_R8)
    x64_mov(cb, X_R8, X_RCX)
    x64_mov(cb, X_RCX, X_RSI)
    x64_win_call_r11(cb)
    emit_x64_task_stubs(cb, syms)
    syms.define_label("__xu_globals", cb.len())
    x64_mov(cb, X_RAX, X_R15)
    x64_ret(cb)
    if emit_object {
        emit_win_import_thunks(cb, syms, relocs)
    } else {
        emit_win_imports(cb, syms)
    }
}

// r11 = IAT entry rax (pointer slot in PE mode, jump thunk in COFF object mode).
fn x64_win_iat_entry(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, emit_object bool) {
    x64_lea_label(cb, relocs, X_R11, "__pe_iat")
    xb(cb, 0x4D)
    if emit_object {
        // lea r11, [r11 + rax*8]
        xb(cb, 0x8D)
    } else {
        // mov r11, [r11 + rax*8]
        xb(cb, 0x8B)
    }
    xb(cb, 0x1C)
    xb(cb, 0xC3)
}

// call r11, then leave the bridge frame.
fn x64_win_call_r11(cb $&mc.CodeBuffer) {
    x64_call_reg(cb, X_R11)
    x64_mov(cb, X_RSP, X_RBP)
    // pop rbp
    xb(cb, 0x5D)
    x64_ret(cb)
}

// COFF object imports: 8-byte jump thunks so the C linker resolves __imp_* slots.
fn emit_win_import_thunks(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    while cb.len() % 8 != 0 {
        xb(cb, 0xCC)
    }
    syms.define_label("__pe_iat", cb.len())
    dlls := win_import_dlls()
    for d in 0:dlls.len {
        fns := win_import_names(d)
        for f in 0:fns.len {
            // jmp qword ptr [rip + __imp_<fn>] ; padded to 8 bytes per slot
            xb(cb, 0xFF)
            xb(cb, 0x25)
            x64_rel32(cb, relocs, "_iat_" + fns[f])
            xb(cb, 0xCC)
            xb(cb, 0xCC)
        }
        for i in 0:8 {
            xb(cb, 0xCC)
        }
    }
    syms.define_label("__pe_iat_end", cb.len())
}

// IAT, import lookup table (same contents), import directory, hint/name
// entries and DLL names, in that order. The IAT starts 8-byte aligned and
// the section is writable so the loader can bind it.
fn emit_win_imports(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    while cb.len() % 8 != 0 {
        xb(cb, 0xCC)
    }
    dlls := win_import_dlls()
    $nslots := 0
    for d in 0:dlls.len {
        nslots += win_import_names(d).len + 1
    }
    iat := cb.len()
    ilt := iat + nslots * 8
    dir := ilt + nslots * 8
    names := dir + (dlls.len + 1) * 20
    // Hint/name entry offsets in slot order (0 for null slots), then the
    // DLL name offsets.
    $hint := []int{}
    $pos := names
    for d in 0:dlls.len {
        fns := win_import_names(d)
        for f in 0:fns.len {
            hint.push(pos)
            pos += (2 + fns[f].len + 1 + 1) / 2 * 2
        }
        hint.push(0)
    }
    $dll_name := []int{}
    for d in 0:dlls.len {
        dll_name.push(pos)
        pos += dlls[d].len + 1
    }
    syms.define_label("__pe_iat", iat)
    for pass in 0:2 {
        for s in 0:nslots {
            $v := 0
            if hint[s] != 0 {
                v = PE_TEXT_RVA + hint[s]
            }
            cb.emit_u64_le(v)
        }
        if pass == 0 {
            syms.define_label("__pe_iat_end", cb.len())
        }
    }
    syms.define_label("__pe_import_dir", dir)
    $slot := 0
    for d in 0:dlls.len {
        cb.emit_u32_le(PE_TEXT_RVA + ilt + slot * 8)
        cb.emit_u32_le(0)
        cb.emit_u32_le(0)
        cb.emit_u32_le(PE_TEXT_RVA + dll_name[d])
        cb.emit_u32_le(PE_TEXT_RVA + iat + slot * 8)
        slot += win_import_names(d).len + 1
    }
    for i in 0:20 {
        xb(cb, 0)
    }
    syms.define_label("__pe_import_dir_end", cb.len())
    for d in 0:dlls.len {
        fns := win_import_names(d)
        for f in 0:fns.len {
            cb.emit_u16_le(0)
            for b in 0:fns[f].len {
                xb(cb, fns[f][b])
            }
            xb(cb, 0)
            if cb.len() % 2 != 0 {
                xb(cb, 0)
            }
        }
    }
    for d in 0:dlls.len {
        for b in 0:dlls[d].len {
            xb(cb, dlls[d][b])
        }
        xb(cb, 0)
    }
}
