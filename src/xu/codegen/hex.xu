@xu/codegen

#xu/mc

const HEX_SUPPORTED = "_xu_encoding_hex_hex_hw_supported"
const HEX_ENCODE = "_xu_encoding_hex_hex_hw_encode"
const HEX_DECODE = "_xu_encoding_hex_hex_hw_decode"

pub fn hex_hw_entry(label &string) bool {
    << *label == HEX_SUPPORTED || *label == HEX_ENCODE || *label == HEX_DECODE
}

pub fn emit_arm64_hex(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, label &string) {
    syms.define_label(*label, cb.len())
    if *label == HEX_SUPPORTED {
        a64_mov_imm(cb, 0, 1)
        e32(cb, 0xD65F03C0)
        <<
    }
    a64_ldr(cb, 2, 0, 0)
    a64_ldr(cb, 3, 0, 8)
    a64_ldr(cb, 4, 1, 0)
    lit := cb.len()
    e32(cb, 0) // adr x10, table
    loop := *label + ".loop"
    done := *label + ".done"
    if *label == HEX_ENCODE {
        e32(cb, 0x3DC00141) // ldr q1, [x10]
        e32(cb, 0x4F00E5E2) // movi v2.16b, #15
        syms.define_label(~loop, cb.len())
        e32(cb, 0xF100407F) // cmp x3, #16
        a64_branch_reloc(cb, relocs, 0x5400000B, ~done, mc.RELOC_ARM64_COND_BR19)
        e32(cb, 0x3DC00040) // ldr q0, [x2]
        e32(cb, 0x6F0C0405) // ushr v5.16b, v0.16b, #4
        a64_rrr(cb, 0x4E201C00, 6, 0, 2) // and
        a64_rrr(cb, 0x4E000000, 5, 1, 5) // tbl
        a64_rrr(cb, 0x4E000000, 6, 1, 6)
        a64_rrr(cb, 0x4E003800, 0, 5, 6) // zip1
        a64_rrr(cb, 0x4E007800, 7, 5, 6) // zip2
        e32(cb, 0x3D800080) // str q0, [x4]
        e32(cb, 0x3D800487) // str q7, [x4, #16]
        a64_add_imm(cb, 2, 2, 16)
        a64_add_imm(cb, 4, 4, 32)
        e32(cb, 0xD1004063) // sub x3, x3, #16
        a64_branch_reloc(cb, relocs, 0x14000000, loop, mc.RELOC_ARM64_CALL26)
        syms.define_label(done, cb.len())
        e32(cb, 0xD65F03C0)
        a64_patch_adr(cb, lit, 10)
        cb.emit_u64_le(0x3736353433323130)
        cb.emit_u64_le(0x6665646362613938)
    } else {
        a64_mov(cb, 5, 3)
        e32(cb, 0x3DC00150) // ldr q16, [x10]
        e32(cb, 0x3DC00551) // ldr q17, [x10, #16]
        e32(cb, 0x4F00E5F2) // movi v18.16b, #15
        e32(cb, 0x4F00E433) // movi v19.16b, #1
        syms.define_label(~loop, cb.len())
        e32(cb, 0xF100807F) // cmp x3, #32
        a64_branch_reloc(cb, relocs, 0x5400000B, ~done, mc.RELOC_ARM64_COND_BR19)
        e32(cb, 0x3DC00040) // ldr q0, [x2]
        e32(cb, 0x3DC00441) // ldr q1, [x2, #16]
        a64_rrr(cb, 0x4E001800, 2, 0, 1) // uzp1: high nibbles
        a64_rrr(cb, 0x4E005800, 3, 0, 1) // uzp2: low nibbles
        a64_rrr(cb, 0x6E208400, 4, 2, 19)
        a64_rrr(cb, 0x6E208400, 5, 3, 19)
        e32(cb, 0x6F0C0486) // ushr v6.16b, v4.16b, #4
        e32(cb, 0x6F0C04A7) // ushr v7.16b, v5.16b, #4
        a64_rrr(cb, 0x4E201C00, 6, 6, 18)
        a64_rrr(cb, 0x4E201C00, 7, 7, 18)
        // Validate ASCII with the high-nibble delta table from the old
        // backend. Any invalid byte sets bit 7 in its lane.
        a64_rrr(cb, 0x4E000000, 20, 17, 6)
        a64_rrr(cb, 0x4E208400, 20, 4, 20)
        a64_rrr(cb, 0x4E000000, 21, 17, 7)
        a64_rrr(cb, 0x4E208400, 21, 5, 21)
        a64_rrr(cb, 0x4EA01C00, 20, 20, 21)
        e32(cb, 0x6E30AA95) // umaxv b21, v20.16b
        e32(cb, 0x0E013EA6) // umov w6, v21.b[0]
        e32(cb, 0xD347FCC6) // lsr x6, x6, #7
        invalid := HEX_DECODE + ".invalid"
        a64_branch_reloc(cb, relocs, 0xB5000006, ~invalid, mc.RELOC_ARM64_COND_BR19)
        a64_rrr(cb, 0x4E000000, 6, 16, 6)
        a64_rrr(cb, 0x4E208400, 4, 4, 6)
        a64_rrr(cb, 0x4E000000, 7, 16, 7)
        a64_rrr(cb, 0x4E208400, 5, 5, 7)
        e32(cb, 0x4F0C5484) // shl v4.16b, v4.16b, #4
        a64_rrr(cb, 0x4EA01C00, 4, 4, 5)
        e32(cb, 0x3D800084) // str q4, [x4]
        a64_add_imm(cb, 2, 2, 32)
        a64_add_imm(cb, 4, 4, 16)
        e32(cb, 0xD1008063) // sub x3, x3, #32
        a64_branch_reloc(cb, relocs, 0x14000000, loop, mc.RELOC_ARM64_CALL26)
        syms.define_label(done, cb.len())
        a64_rrr(cb, 0xCB000000, 0, 5, 3)
        e32(cb, 0xD341FC00) // lsr x0, x0, #1
        e32(cb, 0xD65F03C0)
        syms.define_label(invalid, cb.len())
        e32(cb, 0x92800000) // mov x0, #-1
        e32(cb, 0xD65F03C0)
        a64_patch_adr(cb, lit, 10)
        cb.emit_u32_le(3520135168)
        cb.emit_u32_le(11141322)
        cb.emit_u64_le(0)
        cb.emit_u32_le(1204936944)
        cb.emit_u32_le(2149228602)
        cb.emit_u64_le(0)
    }
}

fn x64_hex_packed(cb $&mc.CodeBuffer, opcode int, dst int, src int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, opcode)
    x64_modrm_rr(cb, dst, src)
}

fn x64_hex_splat(cb $&mc.CodeBuffer, r int, v int) {
    x64_mov_imm(cb, X_RAX, v * 0x0101010101010101)
    x64_movq_to_xmm(cb, r, X_RAX)
    x64_hex_packed(cb, 0x6C, r, r) // punpcklqdq
}

fn x64_hex_mem(cb $&mc.CodeBuffer, op int, vec int, base int, off int) {
    xb(cb, 0xF3)
    x64_rex(cb, false, vec, base, false)
    xb(cb, 0x0F)
    xb(cb, op)
    x64_modrm_mem(cb, vec, base, off)
}

pub fn emit_x64_hex(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, label &string) {
    syms.define_label(*label, cb.len())
    if *label == HEX_SUPPORTED {
        x64_mov_imm(cb, X_RAX, 1)
        x64_ret(cb)
        <<
    }
    x64_ldr(cb, X_RDX, X_RDI, 0)
    x64_ldr(cb, X_RCX, X_RDI, 8)
    x64_ldr(cb, X_R8, X_RSI, 0)
    loop := *label + ".loop"
    done := *label + ".done"
    if *label == HEX_ENCODE {
        x64_hex_splat(cb, 5, 15)
        x64_hex_splat(cb, 6, 9)
        x64_hex_splat(cb, 7, 39)
        x64_hex_splat(cb, 4, 48)
        syms.define_label(~loop, cb.len())
        x64_cmp_imm8(cb, X_RCX, 16)
        x64_jcc(cb, relocs, 12, ~done) // jl
        x64_hex_mem(cb, 0x6F, 0, X_RDX, 0)
        x64_hex_packed(cb, 0x28, 1, 0) // movapd
        x64_hex_packed(cb, 0xDB, 1, 5) // pand
        xb(cb, 0x66)
        xb(cb, 0x0F)
        xb(cb, 0x71)
        x64_modrm_rr(cb, 2, 0)
        xb(cb, 4) // psrlw xmm0, 4
        x64_hex_packed(cb, 0xDB, 0, 5)
        for r in 0:2 {
            x64_hex_packed(cb, 0x28, 2, r)
            x64_hex_packed(cb, 0x64, 2, 6) // pcmpgtb
            x64_hex_packed(cb, 0xDB, 2, 7)
            x64_hex_packed(cb, 0xFC, r, 4) // paddb
            x64_hex_packed(cb, 0xFC, r, 2)
        }
        x64_hex_packed(cb, 0x28, 2, 0)
        x64_hex_packed(cb, 0x60, 2, 1) // punpcklbw
        x64_hex_packed(cb, 0x68, 0, 1) // punpckhbw
        x64_hex_mem(cb, 0x7F, 2, X_R8, 0)
        x64_hex_mem(cb, 0x7F, 0, X_R8, 16)
        x64_alu_imm(cb, 0, X_RDX, 16)
        x64_alu_imm(cb, 0, X_R8, 32)
        x64_alu_imm(cb, 5, X_RCX, 16)
        x64_jmp(cb, relocs, loop)
        syms.define_label(done, cb.len())
        x64_ret(cb)
    } else {
        x64_mov(cb, X_R9, X_RCX)
        table := HEX_DECODE + ".table"
        x64_lea_label(cb, relocs, X_R10, ~table)
        syms.define_label(~loop, cb.len())
        x64_cmp_imm8(cb, X_RCX, 8)
        x64_jcc(cb, relocs, 12, ~done)
        x64_mov_imm(cb, X_R11, 0)
        for i in 0:4 {
            x64_hex_nibble(cb, X_RAX, i * 2)
            x64_hex_nibble(cb, X_RSI, i * 2 + 1)
            xb(cb, 0x48)
            xb(cb, 0xC1)
            xb(cb, 0xE0)
            xb(cb, 4) // shl rax, 4
            x64_alu_imm(cb, 4, X_RSI, 15)
            x64_op_rr(cb, 0x09, X_RSI, X_RAX)
            x64_store(cb, 1, X_RAX, X_R8, i)
        }
        x64_cmp_imm8(cb, X_R11, 63)
        invalid := HEX_DECODE + ".invalid"
        x64_jcc(cb, relocs, 15, ~invalid) // jg
        x64_alu_imm(cb, 0, X_RDX, 8)
        x64_alu_imm(cb, 0, X_R8, 4)
        x64_alu_imm(cb, 5, X_RCX, 8)
        x64_jmp(cb, relocs, loop)
        syms.define_label(done, cb.len())
        x64_mov(cb, X_RAX, X_R9)
        x64_op_rr(cb, 0x29, X_RCX, X_RAX)
        xb(cb, 0x48)
        xb(cb, 0xD1)
        xb(cb, 0xE8) // shr rax, 1
        x64_ret(cb)
        syms.define_label(invalid, cb.len())
        x64_mov_imm(cb, X_RAX, -1)
        x64_ret(cb)
        syms.define_label(table, cb.len())
        for i in 0:256 {
            $v := 64
            if i >= 48 && i <= 57 { v = i }
            if i >= 65 && i <= 70 { v = i - 7 }
            if i >= 97 && i <= 102 { v = i - 39 }
            xb(cb, v)
        }
    }
}

fn x64_hex_nibble(cb $&mc.CodeBuffer, r int, off int) {
    x64_load(cb, 1, r, X_RDX, off)
    x64_rex(cb, true, r, X_R10, false)
    xb(cb, 0x0F)
    xb(cb, 0xB6)
    xb(cb, (r << 3) | 4)
    xb(cb, (r << 3) | 2) // movzx r, byte [r10 + r]
    x64_op_rr(cb, 0x09, r, X_R11)
}
