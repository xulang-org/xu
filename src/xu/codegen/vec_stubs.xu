@xu/codegen
// Vector routines called by loops opt_bce recognises (fill, copy, sum),
// in the generated code's calling convention. They only use scratch
// registers. A copy whose destination starts less than 32 bytes after
// its source proceeds element by element, matching the scalar loop.
//   fill64(p, n, v)   fill8(p, n, v)   p[0:n] = v
//   copy64(d, s, n)   copy8(d, s, n)   d[i] = s[i], i ascending
//   sum64(p, n)       returns p[0] + ... + p[n-1]
// Sources: NEON (arm64) and SSE2 (x86-64) assembly, checked against the
// scalar loops for every length and overlap up to 70 elements.

#xu/mc

fn vec_hex(c int) int {
    if c >= 48 && c <= 57 { << c - 48 }
    if c >= 65 && c <= 70 { << c - 55 }
    << c - 87
}

// Emits space-separated hex words (4 bytes, little-endian) or bytes.
fn vec_emit_hex(cb $&mc.CodeBuffer, s string, word bool) {
    $v := 0
    $nd := 0
    for i in 0:s.len + 1 {
        if i == s.len || s[i] == 32 {
            if nd > 0 {
                if word { cb.emit_u32_le(v) } else { cb.emit_u8(v) }
            }
            v = 0
            nd = 0
        } else {
            v = v * 16 + vec_hex(s[i])
            nd += 1
        }
    }
}

pub fn emit_arm64_vec_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    base := cb.len()
    syms.define_label("__xu_vec_fill64", base)
    syms.define_label("__xu_vec_fill8", base + 48)
    syms.define_label("__xu_vec_copy64", base + 96)
    syms.define_label("__xu_vec_copy8", base + 124)
    syms.define_label("__xu_vec_sum64", base + 224)
    vec_emit_hex(cb, "4E080C40 F100103F 5400008B AC810000 D1001021 17FFFFFC F100003F 5400008D", true)
    vec_emit_hex(cb, "F8008402 D1000421 17FFFFFC D65F03C0 4E010C40 F100803F 5400008B AC810000", true)
    vec_emit_hex(cb, "D1008021 17FFFFFC F100003F 5400008D 38001402 D1000421 17FFFFFC D65F03C0", true)
    vec_emit_hex(cb, "D37DF043 CB010004 F100809F 54000142 EB01001F 540002A8 14000007 AA0203E3", true)
    vec_emit_hex(cb, "CB010004 F100809F 54000062 EB01001F 540000E8 F100807F 540000AB ACC10420", true)
    vec_emit_hex(cb, "AC810400 D1008063 17FFFFFB F100007F 540000AD 38401425 38001405 D1000463", true)
    vec_emit_hex(cb, "17FFFFFB D65F03C0 F100207F 54FFFF0B F8408425 F8008405 D1002063 17FFFFFB", true)
    vec_emit_hex(cb, "6F00E400 6F00E401 F100103F 540000CB ACC10C02 4EE28400 4EE38421 D1001021", true)
    vec_emit_hex(cb, "17FFFFFA 4EE18400 5EF1B800 9E660002 F100003F 540000AD F8408403 8B030042", true)
    vec_emit_hex(cb, "D1000421 17FFFFFB AA0203E0 D65F03C0", true)
}

pub fn emit_x64_vec_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    base := cb.len()
    syms.define_label("__xu_vec_fill64", base)
    syms.define_label("__xu_vec_fill8", base + 53)
    syms.define_label("__xu_vec_copy64", base + 122)
    syms.define_label("__xu_vec_copy8", base + 160)
    syms.define_label("__xu_vec_sum64", base + 269)
    vec_emit_hex(cb, "66 48 0F 6E C2 66 0F 6C C0 48 83 FE 04 7C 13 F3 0F 7F 07 F3 0F 7F 47 10", false)
    vec_emit_hex(cb, "48 83 C7 20 48 83 EE 04 EB E7 48 85 F6 7E 0D 48 89 17 48 83 C7 08 48 83", false)
    vec_emit_hex(cb, "EE 01 EB EE C3 0F B6 C2 48 B9 01 01 01 01 01 01 01 01 48 0F AF C1 66 48", false)
    vec_emit_hex(cb, "0F 6E C0 66 0F 6C C0 48 83 FE 20 7C 13 F3 0F 7F 07 F3 0F 7F 47 10 48 83", false)
    vec_emit_hex(cb, "C7 20 48 83 EE 20 EB E7 48 85 F6 7E 0C 88 17 48 83 C7 01 48 83 EE 01 EB", false)
    vec_emit_hex(cb, "EF C3 48 8D 0C D5 00 00 00 00 48 89 F8 48 29 F0 48 83 F8 20 0F 83 14 00", false)
    vec_emit_hex(cb, "00 00 48 39 F7 0F 87 53 00 00 00 E9 14 00 00 00 48 89 D1 48 89 F8 48 29", false)
    vec_emit_hex(cb, "F0 48 83 F8 20 73 05 48 39 F7 77 26 48 83 F9 20 7C 20 F3 0F 6F 06 F3 0F", false)
    vec_emit_hex(cb, "6F 4E 10 F3 0F 7F 07 F3 0F 7F 4F 10 48 83 C6 20 48 83 C7 20 48 83 E9 20", false)
    vec_emit_hex(cb, "EB DA 48 85 C9 7E 13 0F B6 06 88 07 48 83 C6 01 48 83 C7 01 48 83 E9 01", false)
    vec_emit_hex(cb, "EB E8 C3 48 83 F9 08 7C E1 48 8B 06 48 89 07 48 83 C6 08 48 83 C7 08 48", false)
    vec_emit_hex(cb, "83 E9 08 EB E6 66 0F EF C0 66 0F EF C9 48 83 FE 04 7C 1B F3 0F 6F 17 F3", false)
    vec_emit_hex(cb, "0F 6F 5F 10 66 0F D4 C2 66 0F D4 CB 48 83 C7 20 48 83 EE 04 EB DF 66 0F", false)
    vec_emit_hex(cb, "D4 C1 66 0F 70 C8 4E 66 0F D4 C1 66 48 0F 7E C0 48 85 F6 7E 0D 48 03 07", false)
    vec_emit_hex(cb, "48 83 C7 08 48 83 EE 01 EB EE C3", false)
}
