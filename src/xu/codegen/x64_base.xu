@xu/codegen
// Baseline x86-64 instruction selection for typed MIR.
//
// Mirrors arm64_base.xu: every temp has its own frame slot and every local
// its full width; operands are loaded into rax/rcx/rdx and the result is
// stored back. Conventions shared by all generated code (it never calls C):
//   - arguments in rdi, rsi, rdx, rcx, r8, r9, r10, r11, the rest at
//     [rsp + 8*(i-8)] of the caller's outgoing area; scalar result in rax
//   - r15 holds the runtime state block for the whole process
//   - frame: push rbp; rbp = rsp; rsp = rbp - frame; locals and temps at
//     [rsp + out_area + offset]; stack arguments at [rbp + 16 + 8*(i-8)]
// Integer division, float-to-int conversion and float comparisons keep the
// arm64 results (x / 0 == 0, x % 0 == x, saturating conversion, NaN never
// compares except with !=), so programs behave the same on both targets.

#xu/mir
#xu/mc
#internal/uiabi
#xu/target

const X_RAX = 0
const X_RCX = 1
const X_RDX = 2
const X_RBX = 3
const X_RSP = 4
const X_RBP = 5
const X_RSI = 6
const X_RDI = 7
const X_R8 = 8
const X_R9 = 9
const X_R10 = 10
const X_R11 = 11
const X_R12 = 12
const X_R13 = 13
const X_R14 = 14
const X_R15 = 15

fn x64_arg_reg(i int) int {
    if i == 0 { << X_RDI }
    if i == 1 { << X_RSI }
    if i == 2 { << X_RDX }
    if i == 3 { << X_RCX }
    if i == 4 { << X_R8 }
    if i == 5 { << X_R9 }
    if i == 6 { << X_R10 }
    << X_R11
}

// ===== encoders =====

fn xb(cb $&mc.CodeBuffer, v int) {
    cb.emit_u8(v & 0xff)
}

fn x64_rex(cb $&mc.CodeBuffer, w bool, reg int, rm int, force bool) {
    $r := 0x40
    if w { r = r | 8 }
    if reg >= 8 { r = r | 4 }
    if rm >= 8 { r = r | 1 }
    if r != 0x40 || force {
        xb(cb, r)
    }
}

// ModRM (+SIB, displacement) for [base + disp].
fn x64_modrm_mem(cb $&mc.CodeBuffer, reg int, base int, disp int) {
    b := base & 7
    $mod := 2
    if disp >= -128 && disp <= 127 {
        mod = 1
    }
    xb(cb, (mod << 6) | ((reg & 7) << 3) | b)
    if b == 4 {
        xb(cb, 0x24)
    }
    if mod == 1 {
        xb(cb, disp)
    } else {
        cb.emit_u32_le(disp & 0xffffffff)
    }
}

fn x64_modrm_rr(cb $&mc.CodeBuffer, reg int, rm int) {
    xb(cb, 0xC0 | ((reg & 7) << 3) | (rm & 7))
}

// op r/m64, reg64 style instruction with a single opcode byte.
fn x64_op_rr(cb $&mc.CodeBuffer, op int, reg int, rm int) {
    x64_rex(cb, true, reg, rm, false)
    xb(cb, op)
    x64_modrm_rr(cb, reg, rm)
}

fn x64_op_mem(cb $&mc.CodeBuffer, w bool, op int, reg int, base int, disp int) {
    x64_rex(cb, w, reg, base, false)
    xb(cb, op)
    x64_modrm_mem(cb, reg, base, disp)
}

fn x64_mov_imm(cb $&mc.CodeBuffer, rd int, v int) {
    if v == 0 {
        // xor r32, r32
        x64_rex(cb, false, rd, rd, false)
        xb(cb, 0x31)
        x64_modrm_rr(cb, rd, rd)
        <<
    }
    if v >= -2147483648 && v <= 2147483647 {
        x64_rex(cb, true, 0, rd, false)
        xb(cb, 0xC7)
        x64_modrm_rr(cb, 0, rd)
        cb.emit_u32_le(v & 0xffffffff)
        <<
    }
    x64_rex(cb, true, 0, rd, false)
    xb(cb, 0xB8 + (rd & 7))
    cb.emit_u64_le(v)
}

fn x64_mov(cb $&mc.CodeBuffer, rd int, rs int) {
    x64_op_rr(cb, 0x89, rs, rd)
}

fn x64_ldr(cb $&mc.CodeBuffer, rd int, base int, disp int) {
    x64_op_mem(cb, true, 0x8B, rd, base, disp)
}

fn x64_str(cb $&mc.CodeBuffer, rs int, base int, disp int) {
    x64_op_mem(cb, true, 0x89, rs, base, disp)
}

fn x64_lea(cb $&mc.CodeBuffer, rd int, base int, disp int) {
    x64_op_mem(cb, true, 0x8D, rd, base, disp)
}

fn x64_rex_sib(cb $&mc.CodeBuffer, w bool, reg int, idx int, base int, force bool) {
    $r := 0x40
    if w { r = r | 8 }
    if reg >= 8 { r = r | 4 }
    if idx >= 8 { r = r | 2 }
    if base >= 8 { r = r | 1 }
    if r != 0x40 || force {
        xb(cb, r)
    }
}

fn x64_modrm_sib(cb $&mc.CodeBuffer, reg int, base int, idx int, scale_s int, disp int) {
    b := base & 7
    $mod := 0
    if disp == 0 && b != 5 {
        mod = 0
    } else if disp >= -128 && disp <= 127 {
        mod = 1
    } else {
        mod = 2
    }
    xb(cb, (mod << 6) | ((reg & 7) << 3) | 4)
    xb(cb, ((scale_s & 3) << 6) | ((idx & 7) << 3) | b)
    if mod == 1 {
        xb(cb, disp)
    } else if mod == 2 {
        cb.emit_u32_le(disp & 0xffffffff)
    }
}

fn x64_lea_sib(cb $&mc.CodeBuffer, rd int, base int, idx int, scale_s int, disp int) {
    x64_rex_sib(cb, true, rd, idx, base, false)
    xb(cb, 0x8D)
    x64_modrm_sib(cb, rd, base, idx, scale_s, disp)
}

fn x64_load_sib(cb $&mc.CodeBuffer, width int, rd int, base int, idx int, scale_s int, disp int) {
    if width == 1 || width == 2 {
        x64_rex_sib(cb, false, rd, idx, base, false)
        xb(cb, 0x0F)
        if width == 1 { xb(cb, 0xB6) } else { xb(cb, 0xB7) }
        x64_modrm_sib(cb, rd, base, idx, scale_s, disp)
    } else if width == 4 {
        x64_rex_sib(cb, false, rd, idx, base, false)
        xb(cb, 0x8B)
        x64_modrm_sib(cb, rd, base, idx, scale_s, disp)
    } else if width == -4 {
        x64_rex_sib(cb, true, rd, idx, base, false)
        xb(cb, 0x63)
        x64_modrm_sib(cb, rd, base, idx, scale_s, disp)
    } else {
        x64_rex_sib(cb, true, rd, idx, base, false)
        xb(cb, 0x8B)
        x64_modrm_sib(cb, rd, base, idx, scale_s, disp)
    }
}

fn x64_store_sib(cb $&mc.CodeBuffer, width int, rs int, base int, idx int, scale_s int, disp int) {
    if width == 1 {
        x64_rex_sib(cb, false, rs, idx, base, rs >= 4)
        xb(cb, 0x88)
        x64_modrm_sib(cb, rs, base, idx, scale_s, disp)
    } else if width == 2 {
        xb(cb, 0x66)
        x64_rex_sib(cb, false, rs, idx, base, false)
        xb(cb, 0x89)
        x64_modrm_sib(cb, rs, base, idx, scale_s, disp)
    } else if width == 4 || width == -4 {
        x64_rex_sib(cb, false, rs, idx, base, false)
        xb(cb, 0x89)
        x64_modrm_sib(cb, rs, base, idx, scale_s, disp)
    } else {
        x64_rex_sib(cb, true, rs, idx, base, false)
        xb(cb, 0x89)
        x64_modrm_sib(cb, rs, base, idx, scale_s, disp)
    }
}

// Load of width 1, 2, 4 (zero-extended), -4 (sign-extended) or 8 bytes.
fn x64_load(cb $&mc.CodeBuffer, width int, rd int, base int, disp int) {
    if width == 1 || width == 2 {
        x64_rex(cb, true, rd, base, false)
        xb(cb, 0x0F)
        if width == 1 { xb(cb, 0xB6) } else { xb(cb, 0xB7) }
        x64_modrm_mem(cb, rd, base, disp)
    } else if width == 4 {
        x64_op_mem(cb, false, 0x8B, rd, base, disp)
    } else if width == -4 {
        x64_op_mem(cb, true, 0x63, rd, base, disp)
    } else {
        x64_ldr(cb, rd, base, disp)
    }
}

fn x64_store(cb $&mc.CodeBuffer, width int, rs int, base int, disp int) {
    if width == 1 {
        x64_rex(cb, false, rs, base, rs >= 4)
        xb(cb, 0x88)
        x64_modrm_mem(cb, rs, base, disp)
    } else if width == 2 {
        xb(cb, 0x66)
        x64_op_mem(cb, false, 0x89, rs, base, disp)
    } else if width == 4 || width == -4 {
        x64_op_mem(cb, false, 0x89, rs, base, disp)
    } else {
        x64_str(cb, rs, base, disp)
    }
}

// rsp += imm (imm may be negative).
fn x64_add_rsp(cb $&mc.CodeBuffer, imm int) {
    x64_rex(cb, true, 0, X_RSP, false)
    xb(cb, 0x81)
    if imm >= 0 {
        x64_modrm_rr(cb, 0, X_RSP)
        cb.emit_u32_le(imm)
    } else {
        x64_modrm_rr(cb, 5, X_RSP)
        cb.emit_u32_le(0 - imm)
    }
}

// cmp r64, imm8
fn x64_cmp_imm8(cb $&mc.CodeBuffer, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0x83)
    x64_modrm_rr(cb, 7, r)
    xb(cb, imm)
}

fn x64_test(cb $&mc.CodeBuffer, r int) {
    x64_op_rr(cb, 0x85, r, r)
}

fn x64_test_imm32(cb $&mc.CodeBuffer, rx int, imm int, is64 bool) {
    x64_rex(cb, is64, 0, rx, false)
    xb(cb, 0xF7)
    x64_modrm_rr(cb, 0, rx)
    cb.emit_u32_le(imm & 0xffffffff)
}

// Short conditional (or, with cc < 0, unconditional) forward jump; returns
// the position to pass to x64_land.
fn x64_jshort(cb $&mc.CodeBuffer, cc int) int {
    if cc < 0 {
        xb(cb, 0xEB)
    } else {
        xb(cb, 0x70 | cc)
    }
    xb(cb, 0)
    << cb.len()
}

fn x64_land(cb $&mc.CodeBuffer, at int) {
    cb.patch_u8(at - 1, (cb.len() - at) & 0xff)
}

const CC_O = 0
const CC_B = 2
const CC_AE = 3
const CC_E = 4
const CC_NE = 5
const CC_BE = 6
const CC_A = 7
const CC_P = 10
const CC_NP = 11
const CC_L = 12
const CC_GE = 13
const CC_LE = 14
const CC_G = 15

// setcc r8 (rax/rcx only, so no REX is needed).
fn x64_setcc(cb $&mc.CodeBuffer, cc int, r int) {
    xb(cb, 0x0F)
    xb(cb, 0x90 | cc)
    xb(cb, 0xC0 | r)
}

// movzx eax, al
fn x64_zx_al(cb $&mc.CodeBuffer) {
    xb(cb, 0x0F)
    xb(cb, 0xB6)
    xb(cb, 0xC0)
}

fn x64_rel32(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, label string) {
    relocs.push(mc.reloc_new(cb.len(), label + "", mc.RELOC_X64_PC32, 0))
    cb.emit_u32_le(0)
}

fn x64_call(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, label string) {
    xb(cb, 0xE8)
    x64_rel32(cb, relocs, label)
}

fn x64_jmp(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, label string) {
    xb(cb, 0xE9)
    x64_rel32(cb, relocs, label)
}

fn x64_jcc(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, cc int, label string) {
    xb(cb, 0x0F)
    xb(cb, 0x80 | cc)
    x64_rel32(cb, relocs, label)
}

// lea rd, [rip + label]
fn x64_lea_label(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, rd int, label string) {
    x64_rex(cb, true, rd, 0, false)
    xb(cb, 0x8D)
    xb(cb, ((rd & 7) << 3) | 5)
    x64_rel32(cb, relocs, label)
}

// lea rd, [rip + data_label] (emits RELOC_X64_DATA_PC32 -> R_X86_64_PC32 in ET_REL)
fn x64_lea_data_label(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, rd int, label string) {
    x64_rex(cb, true, rd, 0, false)
    xb(cb, 0x8D)
    xb(cb, ((rd & 7) << 3) | 5)
    relocs.push(mc.reloc_new(cb.len(), label + "", mc.RELOC_X64_DATA_PC32, 0))
    cb.emit_u32_le(0)
}

// call / jmp through a register.
fn x64_call_reg(cb $&mc.CodeBuffer, r int) {
    x64_rex(cb, false, 0, r, false)
    xb(cb, 0xFF)
    x64_modrm_rr(cb, 2, r)
}

fn x64_ud2(cb $&mc.CodeBuffer) {
    xb(cb, 0x0F)
    xb(cb, 0x0B)
}

fn x64_ret(cb $&mc.CodeBuffer) {
    xb(cb, 0xC3)
}

// movq xmm, r64 and movq r64, xmm.
fn x64_movq_to_xmm(cb $&mc.CodeBuffer, x int, r int) {
    xb(cb, 0x66)
    x64_rex(cb, true, x, r, false)
    xb(cb, 0x0F)
    xb(cb, 0x6E)
    x64_modrm_rr(cb, x, r)
}

fn x64_movq_from_xmm(cb $&mc.CodeBuffer, r int, x int) {
    xb(cb, 0x66)
    x64_rex(cb, true, x, r, false)
    xb(cb, 0x0F)
    xb(cb, 0x7E)
    x64_modrm_rr(cb, x, r)
}

// ucomisd xa, xb
fn x64_ucomisd(cb $&mc.CodeBuffer, xa int, xb2 int) {
    xb(cb, 0x66)
    x64_rex(cb, false, xa, xb2, false)
    xb(cb, 0x0F)
    xb(cb, 0x2E)
    x64_modrm_rr(cb, xa, xb2)
}

// movapd xd, xs (avoids partial-register dependency on scalar xmm moves)
fn x64_movapd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    x64_rex(cb, false, xd, xs, false)
    xb(cb, 0x0F)
    xb(cb, 0x28)
    x64_modrm_rr(cb, xd, xs)
}

// xorpd xd, xs
fn x64_xorpd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    x64_rex(cb, false, xd, xs, false)
    xb(cb, 0x0F)
    xb(cb, 0x57)
    x64_modrm_rr(cb, xd, xs)
}

// movsd xd, [base + disp] and movsd [base + disp], xs
fn x64_movsd_ld(cb $&mc.CodeBuffer, xd int, base int, disp int) {
    xb(cb, 0xF2)
    x64_rex(cb, false, xd, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x10)
    x64_modrm_mem(cb, xd, base, disp)
}

fn x64_movsd_st(cb $&mc.CodeBuffer, xs int, base int, disp int) {
    xb(cb, 0xF2)
    x64_rex(cb, false, xs, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x11)
    x64_modrm_mem(cb, xs, base, disp)
}

// movsd xd, [base + idx*scale + disp] and movsd [base + idx*scale + disp], xs
fn x64_movsd_ld_sib(cb $&mc.CodeBuffer, xd int, base int, idx int, scale_s int, disp int) {
    xb(cb, 0xF2)
    x64_rex_sib(cb, false, xd, idx, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x10)
    x64_modrm_sib(cb, xd, base, idx, scale_s, disp)
}

fn x64_movsd_st_sib(cb $&mc.CodeBuffer, xs int, base int, idx int, scale_s int, disp int) {
    xb(cb, 0xF2)
    x64_rex_sib(cb, false, xs, idx, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x11)
    x64_modrm_sib(cb, xs, base, idx, scale_s, disp)
}

// addsd/subsd/mulsd/divsd xd, xs
fn x64_sd_rr(cb $&mc.CodeBuffer, opc int, xd int, xs int) {
    xb(cb, 0xF2)
    x64_rex(cb, false, xd, xs, false)
    xb(cb, 0x0F)
    xb(cb, opc)
    x64_modrm_rr(cb, xd, xs)
}

// cvtsi2sd xd, r64
fn x64_cvtsi2sd(cb $&mc.CodeBuffer, xd int, rs int) {
    xb(cb, 0xF2)
    x64_rex(cb, true, xd, rs, false)
    xb(cb, 0x0F)
    xb(cb, 0x2A)
    x64_modrm_rr(cb, xd, rs)
}

// sqrtsd xd, xs
fn x64_sqrtsd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF2)
    x64_rex(cb, false, xd, xs, false)
    xb(cb, 0x0F)
    xb(cb, 0x51)
    x64_modrm_rr(cb, xd, xs)
}

// ===== frame =====

fn x64_frame(f &mir.MFn) A64Frame {
    // Same slot layout as arm64; the frame size keeps rsp 16-byte aligned
    // after push rbp.
    << a64_frame(f)
}

fn x64_frame_ra(f &mir.MFn, ra &RaInfo, opt bool) A64Frame {
    << a64_frame_ra(f, ra, opt)
}

fn x64_operand(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, rd int, v int) {
    if v <= -2 {
        x64_mov_imm(cb, rd, f.consts[0 - v - 2])
        <<
    }
    if v >= 0 && v < fr.temp_off.len {
        r := ra.temp_reg[v]
        if r >= 32 {
            x64_movq_from_xmm(cb, rd, r - 32)
            <<
        }
        if r >= 0 {
            if r != rd {
                x64_mov(cb, rd, r)
            }
            <<
        }
        if fr.temp_off[v] >= 0 {
            x64_ldr(cb, rd, X_RSP, fr.temp_off[v])
        }
        <<
    }
    x64_mov_imm(cb, rd, 0)
}

fn x64_set_temp(cb $&mc.CodeBuffer, fr &A64Frame, ra &RaInfo, t int, rs int) {
    if t >= 0 && t < fr.temp_off.len {
        r := ra.temp_reg[t]
        if r >= 32 {
            x64_movq_to_xmm(cb, r - 32, rs)
            <<
        }
        if r >= 0 {
            if r != rs {
                x64_mov(cb, r, rs)
            }
            <<
        }
        if fr.temp_off[t] >= 0 {
            x64_str(cb, rs, X_RSP, fr.temp_off[t])
        }
    }
}

// General-purpose register holding operand v, or -1 for constants, memory, or XMM.
fn x64_vreg(fr &A64Frame, ra &RaInfo, v int) int {
    if v >= 0 && v < fr.temp_off.len {
        r := ra.temp_reg[v]
        if r >= 0 && r < 32 {
            << r
        }
    }
    << -1
}

// XMM register (0..15) holding operand v, or -1 otherwise.
fn x64_freg(fr &A64Frame, ra &RaInfo, v int) int {
    if v >= 0 && v < fr.temp_off.len {
        r := ra.temp_reg[v]
        if r >= 32 {
            << r - 32
        }
    }
    << -1
}

fn x64_foperand(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, xd int, v int) {
    if v <= -2 {
        c := f.consts[0 - v - 2]
        if c == 0 {
            x64_xorpd(cb, xd, xd)
        } else {
            x64_mov_imm(cb, X_RAX, c)
            x64_movq_to_xmm(cb, xd, X_RAX)
        }
        <<
    }
    if v >= 0 && v < fr.temp_off.len {
        r := ra.temp_reg[v]
        if r >= 32 {
            if r - 32 != xd {
                x64_movapd(cb, xd, r - 32)
            }
            <<
        }
        if r >= 0 {
            x64_movq_to_xmm(cb, xd, r)
            <<
        }
        if fr.temp_off[v] >= 0 {
            x64_movsd_ld(cb, xd, X_RSP, fr.temp_off[v])
        }
        <<
    }
    x64_xorpd(cb, xd, xd)
}

fn x64_fsrc(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, v int, scratch int) int {
    fx := x64_freg(fr, ra, v)
    if fx >= 0 {
        << fx
    }
    x64_foperand(cb, f, fr, ra, scratch, v)
    << scratch
}

fn x64_set_ftemp(cb $&mc.CodeBuffer, fr &A64Frame, ra &RaInfo, t int, xs int) {
    if t >= 0 && t < fr.temp_off.len {
        r := ra.temp_reg[t]
        if r >= 32 {
            if r - 32 != xs {
                x64_movapd(cb, r - 32, xs)
            }
            <<
        }
        if r >= 0 {
            x64_movq_from_xmm(cb, r, xs)
            <<
        }
        if fr.temp_off[t] >= 0 {
            x64_movsd_st(cb, xs, X_RSP, fr.temp_off[t])
        }
    }
}

// xchg a, b
fn x64_xchg(cb $&mc.CodeBuffer, a int, b int) {
    x64_op_rr(cb, 0x87, a, b)
}

// Register-to-register parallel move dst[i] <- src[i]; destinations are
// distinct, cycles are broken with xchg.
fn x64_par_move(cb $&mc.CodeBuffer, dst &[]int, src0 &[]int) {
    $src := []int{}
    $done := []bool{}
    for i in 0:dst.len {
        src.push(src0[i])
        done.push(false)
    }
    $left := dst.len
    while left > 0 {
        $progress := false
        for i in 0:dst.len {
            if done[i] { -> }
            $blocked := false
            for j in 0:dst.len {
                if j != i && !done[j] && src[j] == dst[i] {
                    blocked = true
                }
            }
            if !blocked {
                if src[i] != dst[i] {
                    x64_mov(cb, dst[i], src[i])
                }
                done[i] = true
                left -= 1
                progress = true
            }
        }
        if !progress {
            for i in 0:dst.len {
                if !done[i] {
                    d := dst[i]
                    sr := src[i]
                    x64_xchg(cb, d, sr)
                    done[i] = true
                    left -= 1
                    for j in 0:dst.len {
                        if !done[j] {
                            if src[j] == d { src[j] = sr }
                            else if src[j] == sr { src[j] = d }
                        }
                    }
                    <-
                }
            }
        }
    }
}

// Loads register arguments: values already in registers move in parallel
// first, then constants and memory operands load into their (now free)
// argument registers.
fn x64_load_args(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, vals &[]int) {
    $dst := []int{}
    $src := []int{}
    for i in 0:vals.len {
        r := x64_vreg(fr, ra, vals[i])
        if r >= 0 {
            dst.push(x64_arg_reg(i))
            src.push(r)
        }
    }
    x64_par_move(cb, &dst, &src)
    for i in 0:vals.len {
        if x64_vreg(fr, ra, vals[i]) < 0 {
            x64_operand(cb, f, fr, ra, x64_arg_reg(i), vals[i])
        }
    }
}

fn x64_cc_of(op int) int {
    if op == mir.BIN_NE { << CC_NE }
    if op == mir.BIN_LT { << CC_L }
    if op == mir.BIN_LE { << CC_LE }
    if op == mir.BIN_GT { << CC_G }
    if op == mir.BIN_GE { << CC_GE }
    << CC_E
}

// Constant operand v when it fits a sign-extended imm32, with ok[0] set.
fn x64_imm32(f &mir.MFn, v int, ok $&[]bool) int {
    ok[0] = false
    if v <= -2 {
        c := f.consts[0 - v - 2]
        if c >= -2147483648 && c <= 2147483647 {
            ok[0] = true
            << c
        }
    }
    << 0
}

// op r/m64, imm32 (group 1: digit 0 add, 1 or, 4 and, 5 sub, 6 xor, 7 cmp).
fn x64_alu_imm(cb $&mc.CodeBuffer, digit int, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    if imm >= -128 && imm <= 127 {
        xb(cb, 0x83)
        x64_modrm_rr(cb, digit, r)
        xb(cb, imm)
    } else {
        xb(cb, 0x81)
        x64_modrm_rr(cb, digit, r)
        cb.emit_u32_le(imm & 0xffffffff)
    }
}

// Register holding operand v, loading it into scratch when needed.
fn x64_src(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, v int, scratch int) int {
    r := x64_vreg(fr, ra, v)
    if r >= 0 {
        << r
    }
    x64_operand(cb, f, fr, ra, scratch, v)
    << scratch
}

// cmp c, d with an immediate when d allows it.
fn x64_cmp_vals(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, c int, d int) {
    rn := x64_src(cb, f, fr, ra, c, X_RAX)
    $ok := []bool{}
    ok.push(false)
    imm := x64_imm32(f, d, $&ok)
    if ok[0] {
        x64_alu_imm(cb, 7, rn, imm)
        <<
    }
    rm := x64_src(cb, f, fr, ra, d, X_RCX)
    x64_op_rr(cb, 0x39, rm, rn)
}

// Integer add/sub/and/or/xor/mul/shift computed in the destination's
// register; false when the generic rax/rcx sequence is needed.
fn x64_bin_direct(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, ins &mir.MInstr) bool {
    op := ins.b
    if op == mir.BIN_AND &&
       ((ins.d <= -2 && f.consts[0 - ins.d - 2] == 4294967295) ||
        (ins.c <= -2 && f.consts[0 - ins.c - 2] == 4294967295)) {
        $val := ins.c
        if ins.c <= -2 && f.consts[0 - ins.c - 2] == 4294967295 {
            val = ins.d
        }
        $rd := x64_vreg(fr, ra, ins.a)
        if rd < 0 { rd = X_RAX }
        rs := x64_src(cb, f, fr, ra, val, rd)
        x64_rex(cb, false, rs, rd, false)
        xb(cb, 0x89)
        x64_modrm_rr(cb, rs, rd)
        x64_set_temp(cb, fr, ra, ins.a, rd)
        << true
    }
    $digit := -1
    $opc := 0
    if op == mir.BIN_ADD { digit = 0  opc = 0x01 }
    else if op == mir.BIN_OR { digit = 1  opc = 0x09 }
    else if op == mir.BIN_AND { digit = 4  opc = 0x21 }
    else if op == mir.BIN_SUB { digit = 5  opc = 0x29 }
    else if op == mir.BIN_XOR { digit = 6  opc = 0x31 }
    else if op != mir.BIN_MUL && op != mir.BIN_SHL && op != mir.BIN_SHR && op != mir.BIN_ROTR32 && op != mir.BIN_ROTR64 {
        << false
    }
    $lhs := ins.c
    $rhs := ins.d
    if lhs <= -2 && rhs > -2 &&
       (op == mir.BIN_ADD || op == mir.BIN_OR || op == mir.BIN_AND || op == mir.BIN_XOR || op == mir.BIN_MUL) {
        lhs = ins.d
        rhs = ins.c
    }
    $ok := []bool{}
    ok.push(false)
    imm := x64_imm32(f, rhs, $&ok)
    if op == mir.BIN_MUL && ok[0] && (imm == 3 || imm == 5 || imm == 9) {
        $sc := 1
        if imm == 5 { sc = 2 }
        else if imm == 9 { sc = 3 }
        rs := x64_src(cb, f, fr, ra, lhs, X_RAX)
        $rd := x64_vreg(fr, ra, ins.a)
        if rd < 0 { rd = X_RAX }
        x64_lea_sib(cb, rd, rs, rs, sc, 0)
        x64_set_temp(cb, fr, ra, ins.a, rd)
        << true
    }
    if (op == mir.BIN_ADD || op == mir.BIN_SUB) && ok[0] && (op == mir.BIN_ADD || imm > -2147483648) {
        rs := x64_vreg(fr, ra, lhs)
        rd0 := x64_vreg(fr, ra, ins.a)
        if rs >= 0 && rd0 >= 0 && rd0 != rs {
            $disp := imm
            if op == mir.BIN_SUB { disp = 0 - imm }
            if disp == 0 {
                x64_mov(cb, rd0, rs)
            } else {
                x64_lea(cb, rd0, rs, disp)
            }
            << true
        }
    }
    if (op == mir.BIN_SHL || op == mir.BIN_SHR) && !ok[0] {
        << false
    }
    $rd := x64_vreg(fr, ra, ins.a)
    if rd < 0 || (!ok[0] && x64_vreg(fr, ra, rhs) == rd) {
        rd = X_RAX
    }
    $rm := -1
    if !ok[0] && op != mir.BIN_ROTR32 && op != mir.BIN_ROTR64 {
        rm = x64_src(cb, f, fr, ra, rhs, X_RCX)
    }
    if (op == mir.BIN_ROTR32 || op == mir.BIN_ROTR64) && !ok[0] {
        x64_operand(cb, f, fr, ra, X_RCX, rhs)
    }
    x64_operand(cb, f, fr, ra, rd, lhs)
    if op == mir.BIN_SHL || op == mir.BIN_SHR {
        x64_rex(cb, true, 0, rd, false)
        xb(cb, 0xC1)
        if op == mir.BIN_SHL { x64_modrm_rr(cb, 4, rd) } else { x64_modrm_rr(cb, 7, rd) }
        xb(cb, imm & 63)
    } else if op == mir.BIN_ROTR32 || op == mir.BIN_ROTR64 {
        w64 := op == mir.BIN_ROTR64
        if ok[0] {
            $k := imm & 63
            if !w64 { k = imm & 31 }
            if k == 0 {
                if !w64 {
                    x64_rex(cb, false, rd, rd, false)
                    xb(cb, 0x89)
                    x64_modrm_rr(cb, rd, rd)
                }
            } else {
                x64_rex(cb, w64, 0, rd, false)
                xb(cb, 0xC1)
                x64_modrm_rr(cb, 1, rd)
                xb(cb, k)
            }
        } else {
            x64_rex(cb, w64, 0, rd, false)
            xb(cb, 0xD3)
            x64_modrm_rr(cb, 1, rd)
        }
    } else if op == mir.BIN_MUL {
        if ok[0] {
            // imul rd, rd, imm32
            x64_rex(cb, true, rd, rd, false)
            xb(cb, 0x69)
            x64_modrm_rr(cb, rd, rd)
            cb.emit_u32_le(imm & 0xffffffff)
        } else {
            x64_rex(cb, true, rd, rm, false)
            xb(cb, 0x0F)
            xb(cb, 0xAF)
            x64_modrm_rr(cb, rd, rm)
        }
    } else if ok[0] {
        x64_alu_imm(cb, digit, rd, imm)
    } else {
        x64_op_rr(cb, opc, rm, rd)
    }
    x64_set_temp(cb, fr, ra, ins.a, rd)
    << true
}

fn x64_ra(f &mir.MFn, opt bool) RaInfo {
    if !opt {
        << ra_none(f)
    }
    $callee := []int{}
    callee.push(X_RBX)
    for r in 12:15 {
        callee.push(r)
    }
    $caller := []int{}
    for r in 6:12 {
        caller.push(r)
    }
    // xmm2..xmm5 are caller-saved on both System V and Win64 ABIs
    // (xmm0..xmm1 stay reserved as scratch registers); xmm8..xmm15 are
    // callee-saved (matching Win64 ABI and arm64's d8..d15; saved across
    // System V C FFI/UI calls and __xu_task_switch).
    $fp_callee := []int{}
    for r in 8:16 {
        fp_callee.push(32 + r)
    }
    $fp_caller := []int{}
    for r in 2:6 {
        fp_caller.push(32 + r)
    }
    $arg_regs := []int{}
    for i in 0:8 {
        arg_regs.push(x64_arg_reg(i))
    }
    << ra_alloc_fp_hints(f, &callee, &caller, &fp_callee, &fp_caller, &arg_regs, -1)
}

// Compute f64 binary arithmetic/comparison directly in XMM registers.
fn x64_fbin_direct(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, ins &mir.MInstr) {
    op := ins.b
    if op <= mir.BIN_FDIV {
        $opc := 0x58
        if op == mir.BIN_FSUB { opc = 0x5C }
        else if op == mir.BIN_FMUL { opc = 0x59 }
        else if op == mir.BIN_FDIV { opc = 0x5E }
        $lhs := ins.c
        $rhs := ins.d
        $xd := x64_freg(fr, ra, ins.a)
        if lhs == rhs {
            if xd < 0 { xd = 0 }
            x64_foperand(cb, f, fr, ra, xd, lhs)
            x64_sd_rr(cb, opc, xd, xd)
            x64_set_ftemp(cb, fr, ra, ins.a, xd)
            <<
        }
        if (op == mir.BIN_FADD || op == mir.BIN_FMUL) && xd >= 0 && x64_freg(fr, ra, rhs) == xd {
            lhs = ins.d
            rhs = ins.c
        }
        if xd < 0 || x64_freg(fr, ra, rhs) == xd {
            xd = 0
        }
        xm := x64_fsrc(cb, f, fr, ra, rhs, 1)
        x64_foperand(cb, f, fr, ra, xd, lhs)
        x64_sd_rr(cb, opc, xd, xm)
        x64_set_ftemp(cb, fr, ra, ins.a, xd)
        <<
    }
    xa := x64_fsrc(cb, f, fr, ra, ins.c, 0)
    xb2 := x64_fsrc(cb, f, fr, ra, ins.d, 1)
    if op == mir.BIN_FEQ || op == mir.BIN_FNE {
        x64_ucomisd(cb, xa, xb2)
        if op == mir.BIN_FEQ {
            x64_setcc(cb, CC_E, X_RAX)
            x64_setcc(cb, CC_NP, X_RCX)
            // and al, cl
            xb(cb, 0x20)
            xb(cb, 0xC8)
        } else {
            x64_setcc(cb, CC_NE, X_RAX)
            x64_setcc(cb, CC_P, X_RCX)
            // or al, cl
            xb(cb, 0x08)
            xb(cb, 0xC8)
        }
        x64_zx_al(cb)
        x64_set_temp(cb, fr, ra, ins.a, X_RAX)
        <<
    }
    // Unordered sets CF, so "above" conditions are false for NaN.
    if op == mir.BIN_FLT || op == mir.BIN_FLE {
        x64_ucomisd(cb, xb2, xa)
    } else {
        x64_ucomisd(cb, xa, xb2)
    }
    if op == mir.BIN_FLT || op == mir.BIN_FGT {
        x64_setcc(cb, CC_A, X_RAX)
    } else {
        x64_setcc(cb, CC_AE, X_RAX)
    }
    x64_zx_al(cb)
    x64_set_temp(cb, fr, ra, ins.a, X_RAX)
}

// Direct XMM lowering for i2f / f2i / fsqrt; false falls back to GPR x64_un.
fn x64_un_direct(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, ins &mir.MInstr) bool {
    op := ins.b
    if op == mir.UN_I2F {
        rs := x64_src(cb, f, fr, ra, ins.c, X_RAX)
        $xd := x64_freg(fr, ra, ins.a)
        if xd < 0 { xd = 0 }
        x64_cvtsi2sd(cb, xd, rs)
        x64_set_ftemp(cb, fr, ra, ins.a, xd)
        << true
    }
    if op == mir.UN_FSQRT {
        xs := x64_fsrc(cb, f, fr, ra, ins.c, 0)
        $xd := x64_freg(fr, ra, ins.a)
        if xd < 0 { xd = 0 }
        x64_sqrtsd(cb, xd, xs)
        x64_set_ftemp(cb, fr, ra, ins.a, xd)
        << true
    }
    if op == mir.UN_F2I {
        x64_foperand(cb, f, fr, ra, 0, ins.c)
        // cvttsd2si rax, xmm0
        xb(cb, 0xF2)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        xb(cb, 0x2C)
        xb(cb, 0xC0)
        // Saturate INT_MIN (also NaN / positive overflow) like fcvtzs.
        x64_mov_imm(cb, X_RCX, -9223372036854775807 - 1)
        x64_op_rr(cb, 0x39, X_RCX, X_RAX)
        done1 := x64_jshort(cb, CC_NE)
        x64_ucomisd(cb, 0, 0)
        nan := x64_jshort(cb, CC_P)
        x64_xorpd(cb, 1, 1)
        x64_ucomisd(cb, 0, 1)
        done2 := x64_jshort(cb, CC_BE)
        x64_rex(cb, true, 0, X_RCX, false)
        xb(cb, 0xF7)
        x64_modrm_rr(cb, 2, X_RCX)
        x64_mov(cb, X_RAX, X_RCX)
        done3 := x64_jshort(cb, -1)
        x64_land(cb, nan)
        x64_mov_imm(cb, X_RAX, 0)
        x64_land(cb, done1)
        x64_land(cb, done2)
        x64_land(cb, done3)
        x64_set_temp(cb, fr, ra, ins.a, X_RAX)
        << true
    }
    << false
}

// rax = rax op rcx on f64 bit patterns, through xmm0/xmm1.
fn x64_fbin(cb $&mc.CodeBuffer, op int) {
    x64_movq_to_xmm(cb, 0, X_RAX)
    x64_movq_to_xmm(cb, 1, X_RCX)
    if op <= mir.BIN_FDIV {
        $opc := 0x58
        if op == mir.BIN_FSUB { opc = 0x5C }
        else if op == mir.BIN_FMUL { opc = 0x59 }
        else if op == mir.BIN_FDIV { opc = 0x5E }
        xb(cb, 0xF2)
        xb(cb, 0x0F)
        xb(cb, opc)
        x64_modrm_rr(cb, 0, 1)
        x64_movq_from_xmm(cb, X_RAX, 0)
        <<
    }
    if op == mir.BIN_FEQ || op == mir.BIN_FNE {
        x64_ucomisd(cb, 0, 1)
        if op == mir.BIN_FEQ {
            x64_setcc(cb, CC_E, X_RAX)
            x64_setcc(cb, CC_NP, X_RCX)
            // and al, cl
            xb(cb, 0x20)
            xb(cb, 0xC8)
        } else {
            x64_setcc(cb, CC_NE, X_RAX)
            x64_setcc(cb, CC_P, X_RCX)
            // or al, cl
            xb(cb, 0x08)
            xb(cb, 0xC8)
        }
        x64_zx_al(cb)
        <<
    }
    // Unordered sets CF, so "above" conditions are false for NaN.
    if op == mir.BIN_FLT || op == mir.BIN_FLE {
        x64_ucomisd(cb, 1, 0)
    } else {
        x64_ucomisd(cb, 0, 1)
    }
    if op == mir.BIN_FLT || op == mir.BIN_FGT {
        x64_setcc(cb, CC_A, X_RAX)
    } else {
        x64_setcc(cb, CC_AE, X_RAX)
    }
    x64_zx_al(cb)
}

// rax = conversion of rax.
fn x64_un(cb $&mc.CodeBuffer, op int) {
    if op == mir.UN_I2F {
        // cvtsi2sd xmm0, rax ; movq rax, xmm0
        xb(cb, 0xF2)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        xb(cb, 0x2A)
        xb(cb, 0xC0)
        x64_movq_from_xmm(cb, X_RAX, 0)
    } else if op == mir.UN_F2I {
        x64_movq_to_xmm(cb, 0, X_RAX)
        // cvttsd2si rax, xmm0
        xb(cb, 0xF2)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        xb(cb, 0x2C)
        xb(cb, 0xC0)
        // The "indefinite" result INT_MIN also stands for NaN and positive
        // overflow; saturate like fcvtzs.
        x64_mov_imm(cb, X_RCX, -9223372036854775807 - 1)
        x64_op_rr(cb, 0x39, X_RCX, X_RAX)
        done1 := x64_jshort(cb, CC_NE)
        x64_ucomisd(cb, 0, 0)
        nan := x64_jshort(cb, CC_P)
        // xorpd xmm1, xmm1 ; ucomisd xmm0, xmm1
        xb(cb, 0x66)
        xb(cb, 0x0F)
        xb(cb, 0x57)
        xb(cb, 0xC9)
        x64_ucomisd(cb, 0, 1)
        done2 := x64_jshort(cb, CC_BE)
        // not rcx -> INT_MAX
        x64_rex(cb, true, 0, X_RCX, false)
        xb(cb, 0xF7)
        x64_modrm_rr(cb, 2, X_RCX)
        x64_mov(cb, X_RAX, X_RCX)
        done3 := x64_jshort(cb, -1)
        x64_land(cb, nan)
        x64_mov_imm(cb, X_RAX, 0)
        x64_land(cb, done1)
        x64_land(cb, done2)
        x64_land(cb, done3)
    } else if op == mir.UN_F32_LOAD {
        // movd xmm0, eax ; cvtss2sd xmm0, xmm0 ; movq rax, xmm0
        xb(cb, 0x66)
        xb(cb, 0x0F)
        xb(cb, 0x6E)
        xb(cb, 0xC0)
        xb(cb, 0xF3)
        xb(cb, 0x0F)
        xb(cb, 0x5A)
        xb(cb, 0xC0)
        x64_movq_from_xmm(cb, X_RAX, 0)
    } else if op == mir.UN_F32_STORE {
        // movq xmm0, rax ; cvtsd2ss xmm0, xmm0 ; movd eax, xmm0
        x64_movq_to_xmm(cb, 0, X_RAX)
        xb(cb, 0xF2)
        xb(cb, 0x0F)
        xb(cb, 0x5A)
        xb(cb, 0xC0)
        xb(cb, 0x66)
        xb(cb, 0x0F)
        xb(cb, 0x7E)
        xb(cb, 0xC0)
    } else if op == mir.UN_FSQRT {
        x64_movq_to_xmm(cb, 0, X_RAX)
        // sqrtsd xmm0, xmm0
        xb(cb, 0xF2)
        xb(cb, 0x0F)
        xb(cb, 0x51)
        xb(cb, 0xC0)
        x64_movq_from_xmm(cb, X_RAX, 0)
    } else {
        x64_ud2(cb)
    }
}

// rax = rax / rcx or rax % rcx with arm64 semantics.
fn x64_divmod(cb $&mc.CodeBuffer, is_mod bool) {
    x64_test(cb, X_RCX)
    zero := x64_jshort(cb, CC_E)
    x64_cmp_imm8(cb, X_RCX, -1)
    normal := x64_jshort(cb, CC_NE)
    if is_mod {
        x64_mov_imm(cb, X_RAX, 0)
    } else {
        // neg rax (wraps for INT_MIN like sdiv)
        x64_rex(cb, true, 0, X_RAX, false)
        xb(cb, 0xF7)
        x64_modrm_rr(cb, 3, X_RAX)
    }
    end1 := x64_jshort(cb, -1)
    x64_land(cb, normal)
    // cqo ; idiv rcx
    xb(cb, 0x48)
    xb(cb, 0x99)
    x64_rex(cb, true, 0, X_RCX, false)
    xb(cb, 0xF7)
    x64_modrm_rr(cb, 7, X_RCX)
    if is_mod {
        x64_mov(cb, X_RAX, X_RDX)
    }
    end2 := x64_jshort(cb, -1)
    x64_land(cb, zero)
    if !is_mod {
        x64_mov_imm(cb, X_RAX, 0)
    }
    x64_land(cb, end1)
    x64_land(cb, end2)
}

fn x64_bin(cb $&mc.CodeBuffer, op int) {
    // rax = rax op rcx
    if op >= mir.BIN_FADD && op <= mir.BIN_FGE {
        x64_fbin(cb, op)
        <<
    }
    if op == mir.BIN_ADD { x64_op_rr(cb, 0x01, X_RCX, X_RAX) }
    else if op == mir.BIN_SUB { x64_op_rr(cb, 0x29, X_RCX, X_RAX) }
    else if op == mir.BIN_MUL {
        x64_rex(cb, true, X_RAX, X_RCX, false)
        xb(cb, 0x0F)
        xb(cb, 0xAF)
        x64_modrm_rr(cb, X_RAX, X_RCX)
    }
    else if op == mir.BIN_DIV { x64_divmod(cb, false) }
    else if op == mir.BIN_MOD { x64_divmod(cb, true) }
    else if op == mir.BIN_MULH {
        // imul rcx (rdx:rax = rax * rcx, signed); mov rax, rdx. rdx is
        // scratch here as for idiv.
        x64_rex(cb, true, 0, X_RCX, false)
        xb(cb, 0xF7)
        x64_modrm_rr(cb, 5, X_RCX)
        x64_mov(cb, X_RAX, X_RDX)
    }
    else if op == mir.BIN_MULH_U {
        // mul rcx (rdx:rax = rax * rcx, unsigned); mov rax, rdx.
        x64_rex(cb, true, 0, X_RCX, false)
        xb(cb, 0xF7)
        x64_modrm_rr(cb, 4, X_RCX)
        x64_mov(cb, X_RAX, X_RDX)
    }
    else if op == mir.BIN_AND { x64_op_rr(cb, 0x21, X_RCX, X_RAX) }
    else if op == mir.BIN_OR { x64_op_rr(cb, 0x09, X_RCX, X_RAX) }
    else if op == mir.BIN_XOR { x64_op_rr(cb, 0x31, X_RCX, X_RAX) }
    else if op == mir.BIN_SHL || op == mir.BIN_SHR {
        // shl/sar rax, cl (count mod 64, like lslv/asrv)
        x64_rex(cb, true, 0, X_RAX, false)
        xb(cb, 0xD3)
        if op == mir.BIN_SHL {
            x64_modrm_rr(cb, 4, X_RAX)
        } else {
            x64_modrm_rr(cb, 7, X_RAX)
        }
    }
    else if op == mir.BIN_ROTR32 {
        xb(cb, 0xD3)
        x64_modrm_rr(cb, 1, X_RAX)
    }
    else if op == mir.BIN_ROTR64 {
        x64_rex(cb, true, 0, X_RAX, false)
        xb(cb, 0xD3)
        x64_modrm_rr(cb, 1, X_RAX)
    }
    else {
        x64_op_rr(cb, 0x39, X_RCX, X_RAX)
        $cc := CC_E
        if op == mir.BIN_NE { cc = CC_NE }
        else if op == mir.BIN_LT { cc = CC_L }
        else if op == mir.BIN_LE { cc = CC_LE }
        else if op == mir.BIN_GT { cc = CC_G }
        else if op == mir.BIN_GE { cc = CC_GE }
        x64_setcc(cb, cc, X_RAX)
        x64_zx_al(cb)
    }
}

fn x64_is_callee(r int) bool {
    << r == X_RBX || (r >= 12 && r <= 14)
}

fn x64_prepare_idx(f &mir.MFn, fr &A64Frame, ra &RaInfo, uses &[]int, idx_mode $&[]int, idx_base $&[]int, idx_off $&[]int, idx_shift $&[]int) {
    ni := f.instrs.len
    nt := f.temps.len
    for _ in 0:ni {
        idx_mode.push(0)
        idx_base.push(-1)
        idx_off.push(-1)
        idx_shift.push(0)
    }
    $def_cnt := []int{}
    $def_blk := []int{}
    $def_ii := []int{}
    for _ in 0:nt {
        def_cnt.push(0)
        def_blk.push(-1)
        def_ii.push(-1)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if a64_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                def_cnt[ins.a] = def_cnt[ins.a] + 1
                def_blk[ins.a] = bi
                def_ii[ins.a] = ii
            }
            ii = ins.next
        }
    }
    for bi in 0:f.blocks.len {
        tk := f.blocks[bi].tkind
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && ins.b == mir.BIN_ADD &&
               ins.a >= 0 && ins.a < nt && def_cnt[ins.a] == 1 && def_blk[ins.a] == bi &&
               ins.c >= 0 && ins.d >= 0 {
                ptr_t := ins.a
                if !((tk == mir.TKIND_RETURN || tk == mir.TKIND_BRANCH) && f.blocks[bi].ta == ptr_t) {
                    for side in 0:2 {
                        $base_v := ins.c
                        $off_v := ins.d
                        if side == 1 {
                            base_v = ins.d
                            off_v = ins.c
                        }
                        if base_v == ptr_t || base_v == off_v { -> }
                        $shl_ii := -1
                        $idx_v := off_v
                        $s := 0
                        if off_v < nt && def_cnt[off_v] == 1 && def_blk[off_v] == bi &&
                           off_v < uses.len && uses[off_v] == 1 {
                            sii := def_ii[off_v]
                            sins := &f.instrs[sii]
                            if idx_mode[sii] == 0 && sins.kind == mir.MI_BIN && sins.b == mir.BIN_SHL &&
                               sins.c >= 0 && sins.d <= -2 {
                                sc := f.consts[0 - sins.d - 2]
                                if sc >= 0 && sc <= 3 {
                                    shl_ii = sii
                                    idx_v = sins.c
                                    s = sc
                                }
                            }
                        }
                        if idx_v == ptr_t || idx_v < 0 || idx_v >= nt || base_v >= nt { -> }
                        if x64_vreg(fr, ra, idx_v) == X_RSP { -> }
                        $cand_mems := []int{}
                        $last_use_ii := -1
                        $abort := false
                        $ui := ins.next
                        while ui >= 0 {
                            uins := &f.instrs[ui]
                            uk := uins.kind
                            disp_ok := uins.c >= -2147483648 && uins.c <= 2147483647
                            if uk == mir.MI_LOAD_PTR && uins.b == ptr_t && disp_ok && idx_mode[ui] == 0 {
                                cand_mems.push(ui)
                                last_use_ii = ui
                            } else if uk == mir.MI_STORE_PTR && uins.a == ptr_t && uins.b != ptr_t && disp_ok && idx_mode[ui] == 0 {
                                cand_mems.push(ui)
                                last_use_ii = ui
                            } else if a64_reads_temp(f, uins, ptr_t) {
                                abort = true
                                <-
                            }
                            ui = uins.next
                        }
                        if abort || cand_mems.len == 0 || ptr_t >= uses.len || cand_mems.len != uses[ptr_t] {
                            ->
                        }
                        $safe := false
                        if cand_mems.len == 1 && last_use_ii == ins.next && (shl_ii < 0 || f.instrs[shl_ii].next == ii) {
                            safe = true
                        } else {
                            rb := x64_vreg(fr, ra, base_v)
                            ri := x64_vreg(fr, ra, idx_v)
                            if rb >= 0 && ri >= 0 && ri != X_RSP {
                                safe = true
                                $saw_add := shl_ii < 0
                                $wi := ii
                                if shl_ii >= 0 { wi = shl_ii }
                                wi = f.instrs[wi].next
                                while wi >= 0 && wi != last_use_ii {
                                    if wi == ii {
                                        saw_add = true
                                    } else {
                                        wins := &f.instrs[wi]
                                        if a64_defines(wins.kind) && wins.a >= 0 {
                                            if wins.a == idx_v || (saw_add && wins.a == base_v) {
                                                safe = false
                                                <-
                                            }
                                            rw := x64_vreg(fr, ra, wins.a)
                                            if rw == ri || (saw_add && rw == rb) {
                                                safe = false
                                                <-
                                            }
                                        }
                                        if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len {
                                            lr := ra.local_reg[wins.a]
                                            if lr == ri || (saw_add && lr == rb) {
                                                safe = false
                                                <-
                                            }
                                        }
                                        if wins.kind == mir.MI_CALL_IND || (wins.kind == mir.MI_CALL && !is_noreturn_call(&f.instrs[wi].sval)) {
                                            if !x64_is_callee(ri) || (saw_add && !x64_is_callee(rb)) {
                                                safe = false
                                                <-
                                            }
                                        }
                                    }
                                    wi = f.instrs[wi].next
                                }
                            }
                        }
                        if safe {
                            if shl_ii >= 0 { idx_mode[shl_ii] = 1 }
                            idx_mode[ii] = 1
                            for ci in 0:cand_mems.len {
                                m := cand_mems[ci]
                                idx_mode[m] = 2
                                idx_base[m] = base_v
                                idx_off[m] = idx_v
                                idx_shift[m] = s
                            }
                            <-
                        }
                    }
                }
            }
            ii = ins.next
        }
        ii = f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && ins.b == mir.BIN_SHL &&
               ins.a >= 0 && ins.a < uses.len && uses[ins.a] == 1 && ins.c >= 0 && ins.d <= -2 {
                sc := f.consts[0 - ins.d - 2]
                if sc >= 0 && sc <= 3 && x64_vreg(fr, ra, ins.c) != X_RSP {
                    nx := ins.next
                    if nx >= 0 && idx_mode[nx] == 0 {
                        nins := &f.instrs[nx]
                        if nins.kind == mir.MI_BIN && nins.b == mir.BIN_ADD && nins.a >= 0 {
                            if (nins.c == ins.a && nins.d >= 0 && nins.d != ins.a) ||
                               (nins.d == ins.a && nins.c >= 0 && nins.c != ins.a) {
                                $bv := nins.d
                                if nins.d == ins.a { bv = nins.c }
                                idx_mode[ii] = 1
                                idx_mode[nx] = 3
                                idx_base[nx] = bv
                                idx_off[nx] = ins.c
                                idx_shift[nx] = sc
                            }
                        }
                    }
                }
            } else if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && ins.b == mir.BIN_MUL &&
                      ins.a >= 0 && ins.a < nt && def_cnt[ins.a] == 1 &&
                      ins.a < uses.len && uses[ins.a] == 1 {
                $mv := -1
                $mc := 0
                if ins.c >= 0 && ins.d <= -2 {
                    mv = ins.c
                    mc = f.consts[0 - ins.d - 2]
                } else if ins.d >= 0 && ins.c <= -2 {
                    mv = ins.d
                    mc = f.consts[0 - ins.c - 2]
                }
                if mv >= 0 && (mc == 3 || mc == 5 || mc == 9) && x64_vreg(fr, ra, mv) != X_RSP {
                    $sc := 1
                    if mc == 5 { sc = 2 }
                    else if mc == 9 { sc = 3 }
                    nx := ins.next
                    if nx >= 0 && idx_mode[nx] == 0 {
                        nins := &f.instrs[nx]
                        if nins.kind == mir.MI_BIN && (nins.b == mir.BIN_ADD || nins.b == mir.BIN_SUB) && nins.a >= 0 {
                            $has_d := false
                            $disp := 0
                            if nins.b == mir.BIN_ADD && nins.c == ins.a && nins.d <= -2 {
                                d0 := f.consts[0 - nins.d - 2]
                                if d0 >= -2147483648 && d0 <= 2147483647 {
                                    has_d = true
                                    disp = d0
                                }
                            } else if nins.b == mir.BIN_ADD && nins.d == ins.a && nins.c <= -2 {
                                d0 := f.consts[0 - nins.c - 2]
                                if d0 >= -2147483648 && d0 <= 2147483647 {
                                    has_d = true
                                    disp = d0
                                }
                            } else if nins.b == mir.BIN_SUB && nins.c == ins.a && nins.d <= -2 {
                                d0 := f.consts[0 - nins.d - 2]
                                if d0 > -2147483648 && d0 <= 2147483647 {
                                    has_d = true
                                    disp = 0 - d0
                                }
                            }
                            if has_d {
                                idx_mode[ii] = 1
                                idx_mode[nx] = 4
                                idx_base[nx] = mv
                                idx_off[nx] = disp
                                idx_shift[nx] = sc
                            }
                        }
                    }
                }
            }
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && (ins.b == mir.BIN_EQ || ins.b == mir.BIN_NE) &&
               ins.a >= 0 && ins.a < uses.len && uses[ins.a] == 1 &&
               ((ins.next < 0 && tk == mir.TKIND_BRANCH && f.blocks[bi].ta == ins.a) ||
                (ins.next >= 0 && f.instrs[ins.next].kind == mir.MI_SELECT && f.instrs[ins.next].b == ins.a &&
                 f.instrs[ins.next].c != ins.a && f.instrs[ins.next].d != ins.a)) {
                $and_t := -1
                if ins.c >= 0 && ins.d <= -2 && f.consts[0 - ins.d - 2] == 0 {
                    and_t = ins.c
                } else if ins.d >= 0 && ins.c <= -2 && f.consts[0 - ins.c - 2] == 0 {
                    and_t = ins.d
                }
                if and_t >= 0 && and_t < nt && def_cnt[and_t] == 1 && def_blk[and_t] == bi && uses[and_t] == 1 {
                    aii := def_ii[and_t]
                    ains := &f.instrs[aii]
                    if idx_mode[aii] == 0 && ains.kind == mir.MI_BIN && ains.b == mir.BIN_AND {
                        $and_x := -1
                        $mask_v := 0
                        $has_mask := false
                        if ains.c >= 0 && ains.d <= -2 {
                            and_x = ains.c
                            mask_v = f.consts[0 - ains.d - 2]
                            has_mask = true
                        } else if ains.d >= 0 && ains.c <= -2 {
                            and_x = ains.d
                            mask_v = f.consts[0 - ains.c - 2]
                            has_mask = true
                        }
                        if has_mask && ((mask_v >= 0 && mask_v <= 4294967295) || (mask_v >= -2147483648 && mask_v < 0)) {
                            rx := x64_vreg(fr, ra, and_x)
                            if rx >= 0 {
                                $safe := true
                                $wi := ains.next
                                while wi >= 0 && wi != ii {
                                    wins := &f.instrs[wi]
                                    if wins.kind == mir.MI_CALL_IND || (wins.kind == mir.MI_CALL && !is_noreturn_call(&f.instrs[wi].sval)) {
                                        safe = false
                                        <-
                                    }
                                    $dst_t := -1
                                    if a64_defines(wins.kind) { dst_t = wins.a }
                                    if dst_t >= 0 && x64_vreg(fr, ra, dst_t) == rx {
                                        safe = false
                                        <-
                                    }
                                    if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len && ra.local_reg[wins.a] == rx {
                                        safe = false
                                        <-
                                    }
                                    wi = wins.next
                                }
                                if safe {
                                    idx_mode[aii] = 1
                                    idx_mode[ii] = 5
                                    idx_base[ii] = rx
                                    idx_off[ii] = mask_v
                                    if mask_v < 0 { idx_shift[ii] = 1 } else { idx_shift[ii] = 0 }
                                }
                            }
                        }
                    }
                }
            }
            ii = ins.next
        }
    }
}

// True when integer compare at ii feeds only a nearby MI_SELECT (with only
// non-clobbering MI_NOP / MI_STORE_LOCAL in between) and its operands stay
// directly comparable at the MI_SELECT without needing scratch registers.
fn x64_can_fuse_select(f &mir.MFn, fr &A64Frame, ra &RaInfo, ii int, ins &mir.MInstr) bool {
    rc := x64_vreg(fr, ra, ins.c)
    if rc < 0 { << false }
    $rd := x64_vreg(fr, ra, ins.d)
    if rd < 0 {
        $ok := []bool{}
        ok.push(false)
        _ := x64_imm32(f, ins.d, $&ok)
        if !ok[0] { << false }
    }
    cond_t := ins.a
    $ni := ins.next
    while ni >= 0 {
        nins := &f.instrs[ni]
        nk := nins.kind
        if nk == mir.MI_SELECT {
            << nins.b == cond_t && nins.c != cond_t && nins.d != cond_t
        }
        if nk == mir.MI_NOP {
            ni = nins.next
        } else if nk == mir.MI_STORE_LOCAL && nins.b != cond_t {
            if nins.a >= 0 && nins.a < ra.local_reg.len {
                lr := ra.local_reg[nins.a]
                if lr == rc || (rd >= 0 && lr == rd) {
                    << false
                }
            }
            ni = nins.next
        } else {
            << false
        }
    }
    << false
}

fn x64_fast_cc(op int) int {
    if op == mir.BIN_NE { << CC_NE }
    if op == mir.BIN_LT { << CC_L }
    if op == mir.BIN_LE { << CC_LE }
    if op == mir.BIN_GT { << CC_G }
    if op == mir.BIN_GE { << CC_GE }
    << CC_E
}

fn x64_fast_sc(i int) int {
    if i == 0 { << X_R10 }
    if i == 1 { << X_R11 }
    << X_RAX
}

fn x64_eval_fast_node(cb $&mc.CodeBuffer, nodes &[]FastNode, ni int, sc_idx int) int {
    nd := &nodes[ni]
    if nd.kind == FV_PARAM {
        << x64_arg_reg(nd.val)
    }
    if nd.kind == FV_CONST {
        rd := x64_fast_sc(sc_idx)
        x64_mov_imm(cb, rd, nd.val)
        << rd
    }
    dst := x64_fast_sc(sc_idx)
    lr := x64_eval_fast_node(cb, nodes, nd.lhs, sc_idx)
    if lr != dst {
        x64_mov(cb, dst, lr)
    }
    op := nd.bop
    if nodes[nd.rhs].kind == FV_CONST && op != mir.BIN_MUL {
        cv := nodes[nd.rhs].val
        if cv >= -2147483648 && cv <= 2147483647 {
            $digit := 0
            if op == mir.BIN_OR { digit = 1 }
            else if op == mir.BIN_AND { digit = 4 }
            else if op == mir.BIN_SUB { digit = 5 }
            else if op == mir.BIN_XOR { digit = 6 }
            x64_alu_imm(cb, digit, dst, cv)
            << dst
        }
    }
    rr := x64_eval_fast_node(cb, nodes, nd.rhs, sc_idx + 1)
    if op == mir.BIN_ADD { x64_op_rr(cb, 0x01, rr, dst) }
    else if op == mir.BIN_SUB { x64_op_rr(cb, 0x29, rr, dst) }
    else if op == mir.BIN_AND { x64_op_rr(cb, 0x21, rr, dst) }
    else if op == mir.BIN_OR { x64_op_rr(cb, 0x09, rr, dst) }
    else if op == mir.BIN_XOR { x64_op_rr(cb, 0x31, rr, dst) }
    else if op == mir.BIN_MUL {
        x64_rex(cb, true, dst, rr, false)
        xb(cb, 0x0F)
        xb(cb, 0xAF)
        x64_modrm_rr(cb, dst, rr)
    }
    << dst
}

fn x64_emit_fast_guard(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, nodes &[]FastNode, ex &FastExit, lbl string) {
    cn := ex.cond_node
    nd := &nodes[cn]
    if nd.kind == FV_BIN && fv_is_cmp_op(nd.bop) {
        $op := nd.bop
        if !ex.want_true {
            op = fv_invert_cmp(op)
        }
        lr := x64_eval_fast_node(cb, nodes, nd.lhs, 0)
        $nx := 0
        if lr == X_R10 { nx = 1 }
        if nodes[nd.rhs].kind == FV_CONST {
            cv := nodes[nd.rhs].val
            if cv == 0 && (op == mir.BIN_EQ || op == mir.BIN_NE) {
                x64_test(cb, lr)
                x64_jcc(cb, relocs, x64_fast_cc(op), lbl)
                <<
            }
            if cv >= -2147483648 && cv <= 2147483647 {
                x64_alu_imm(cb, 7, lr, cv)
                x64_jcc(cb, relocs, x64_fast_cc(op), lbl)
                <<
            }
        }
        rr := x64_eval_fast_node(cb, nodes, nd.rhs, nx)
        x64_op_rr(cb, 0x39, rr, lr)
        x64_jcc(cb, relocs, x64_fast_cc(op), lbl)
        <<
    }
    lr := x64_eval_fast_node(cb, nodes, cn, 0)
    x64_test(cb, lr)
    $cc := CC_NE
    if !ex.want_true { cc = CC_E }
    x64_jcc(cb, relocs, cc, lbl)
}

// lines receives (code offset, source line) pairs where the line changes.
// opt keeps values in registers (ra_alloc); otherwise every value lives in
// its frame slot.
pub fn isel_fn_x64_base(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, lines $&[]int, opt bool, pgo_map bool) {
    ra := x64_ra(f, opt)
    $fr := x64_frame_ra(f, &ra, opt)
    leaf_noframe := can_elide_frame(f, &ra, opt)
    $fp_plan := FastPlan{nodes: []FastNode{}, exits: []FastExit{}, slow_blk: -1, init_locals: []int{}, init_vals: []int{}}
    if opt && !leaf_noframe {
        fp_plan = analyze_fast_entry(f, &ra)
    }
    // Saved callee registers sit above the locals and temps.
    save_off := fr.size
    if ra.used_callee.len > 0 {
        fr.size = (fr.size + ra.used_callee.len * 8 + 15) / 16 * 16
    }
    syms.define_label(f.label, cb.len())
    $last_line := f.src_line
    if last_line > 0 {
        lines.push(cb.len())
        lines.push(last_line)
    }
    inline_fast_exit := fp_plan.exits.len > 0 && fp_plan.slow_blk > 0
    if inline_fast_exit {
        prologue_lbl := f.label + ".prologue"
        if fp_plan.exits.len == 1 {
            $inv_ex := FastExit{cond_node: fp_plan.exits[0].cond_node, want_true: !fp_plan.exits[0].want_true, ret_node: fp_plan.exits[0].ret_node}
            x64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &inv_ex, prologue_lbl + "")
            rn := fp_plan.exits[0].ret_node
            if fp_plan.nodes[rn].kind == FV_CONST {
                x64_mov_imm(cb, X_RAX, fp_plan.nodes[rn].val)
            } else {
                rr := x64_eval_fast_node(cb, &fp_plan.nodes, rn, 0)
                if rr != X_RAX {
                    x64_mov(cb, X_RAX, rr)
                }
            }
            x64_ret(cb)
        } else {
            last_ei := fp_plan.exits.len - 1
            for ei in 0:last_ei {
                x64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &fp_plan.exits[ei], f.label + ".fp" + str(ei))
            }
            $inv_last := FastExit{cond_node: fp_plan.exits[last_ei].cond_node, want_true: !fp_plan.exits[last_ei].want_true, ret_node: fp_plan.exits[last_ei].ret_node}
            x64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &inv_last, prologue_lbl + "")
            rn_last := fp_plan.exits[last_ei].ret_node
            if fp_plan.nodes[rn_last].kind == FV_CONST {
                x64_mov_imm(cb, X_RAX, fp_plan.nodes[rn_last].val)
            } else {
                rr := x64_eval_fast_node(cb, &fp_plan.nodes, rn_last, 0)
                if rr != X_RAX {
                    x64_mov(cb, X_RAX, rr)
                }
            }
            x64_ret(cb)
            for ei in 0:last_ei {
                syms.define_label(f.label + ".fp" + str(ei), cb.len())
                rn := fp_plan.exits[ei].ret_node
                if fp_plan.nodes[rn].kind == FV_CONST {
                    x64_mov_imm(cb, X_RAX, fp_plan.nodes[rn].val)
                } else {
                    rr := x64_eval_fast_node(cb, &fp_plan.nodes, rn, 0)
                    if rr != X_RAX {
                        x64_mov(cb, X_RAX, rr)
                    }
                }
                x64_ret(cb)
            }
        }
        syms.define_label(prologue_lbl, cb.len())
    } else {
        for ei in 0:fp_plan.exits.len {
            x64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &fp_plan.exits[ei], f.label + ".fp" + str(ei))
        }
    }
    if !leaf_noframe {
        // push rbp ; mov rbp, rsp
        xb(cb, 0x55)
        x64_mov(cb, X_RBP, X_RSP)
        if fr.size > 0 {
            x64_add_rsp(cb, 0 - fr.size)
        }
        for ci in 0:ra.used_callee.len {
            r := ra.used_callee[ci]
            if r >= 32 {
                x64_movsd_st(cb, r - 32, X_RSP, save_off + ci * 8)
            } else {
                x64_str(cb, r, X_RSP, save_off + ci * 8)
            }
        }
    }
    // Parameters kept in registers may land in another parameter's
    // incoming register: spill first, then move in parallel, then load the
    // stack-passed ones.
    $pdst := []int{}
    $psrc := []int{}
    for i in 0:f.nparams {
        lr := ra.local_reg[i]
        if i < 8 {
            if lr >= 32 {
                x64_movq_to_xmm(cb, lr - 32, x64_arg_reg(i))
            } else if lr >= 0 {
                pdst.push(lr)
                psrc.push(x64_arg_reg(i))
            } else {
                x64_str(cb, x64_arg_reg(i), X_RSP, fr.local_off[i])
            }
        } else if lr < 0 {
            x64_ldr(cb, X_RAX, X_RBP, 16 + (i - 8) * 8)
            x64_str(cb, X_RAX, X_RSP, fr.local_off[i])
        }
    }
    x64_par_move(cb, &pdst, &psrc)
    for i in 8:f.nparams {
        lr := ra.local_reg[i]
        if lr >= 32 {
            x64_movsd_ld(cb, lr - 32, X_RBP, 16 + (i - 8) * 8)
        } else if lr >= 0 {
            x64_ldr(cb, lr, X_RBP, 16 + (i - 8) * 8)
        }
    }
    if fp_plan.slow_blk > 0 {
        for ii in 0:fp_plan.init_locals.len {
            l := fp_plan.init_locals[ii]
            v := fp_plan.init_vals[ii]
            lr := ra.local_reg[l]
            if lr >= 0 && lr < 32 {
                x64_mov_imm(cb, lr, v)
            } else {
                x64_mov_imm(cb, X_RAX, v)
                x64_str(cb, X_RAX, X_RSP, fr.local_off[l])
            }
        }
        if !inline_fast_exit {
            x64_jmp(cb, relocs, f.label + ".bb" + str(fp_plan.slow_blk))
        }
    }
    $strs := []StrFix{}
    $str_aligns := []int{}
    $uses := []int{}
    $idx_mode := []int{}
    $idx_base := []int{}
    $idx_off := []int{}
    $idx_shift := []int{}
    if opt {
        uses = temp_use_counts(f)
        x64_prepare_idx(f, &fr, &ra, &uses, $&idx_mode, $&idx_base, $&idx_off, $&idx_shift)
    }
    nb_fn := f.blocks.len
    $cold := []bool{}
    $is_ret := []bool{}
    $blk_pos := []int{}
    $order := []int{}
    if opt {
        $slow := -1
        if inline_fast_exit {
            slow = fp_plan.slow_blk
            if slow > 0 && slow < f.blocks.len {
                order.push(slow)
            }
        }
        for obi in 0:nb_fn {
            $c := false
            if obi > 0 && obi != slow {
                $cii := f.blocks[obi].head
                while cii >= 0 {
                    cins := &f.instrs[cii]
                    if cins.kind == mir.MI_CALL && is_noreturn_call(&f.instrs[cii].sval) {
                        c = true
                        <-
                    }
                    cii = cins.next
                }
            }
            cold.push(c)
            is_ret.push(obi > 0 && obi != slow && !c && f.blocks[obi].tkind == mir.TKIND_RETURN)
        }
        $cold_list := []int{}
        for obi in 0:nb_fn {
            if obi == slow { -> }
            if !cold[obi] { order.push(obi) }
            else { cold_list.push(obi) }
        }
        for ci in 0:cold_list.len {
            order.push(cold_list[ci])
        }
        for _ in 0:nb_fn { blk_pos.push(-1) }
        for oi2 in 0:order.len {
            blk_pos[order[oi2]] = oi2
        }
    } else {
        for obi in 0:f.blocks.len {
            order.push(obi)
        }
    }
    // Local labels use "." so they cannot collide with any function label.
    epilogue := f.label + ".ret"
    for oi in 0:order.len {
        bi := order[oi]
        $next_bi := -1
        if oi + 1 < order.len { next_bi = order[oi + 1] }
        syms.define_label(f.label + ".bb" + str(bi), cb.len())
        // A compare feeding only this block's branch becomes cmp + jcc;
        // a compare feeding only a nearby MI_SELECT becomes deferred cmp + cmovcc.
        $fused := -1
        $sel_cmp_ii := -1
        bounds := a64_bounds_check(f, bi, &uses, opt)
        $ii := f.blocks[bi].head
        while ii >= 0 {
            if (bounds.len > 0 && (ii == bounds[0] || ii == bounds[1] || ii == bounds[2])) || (opt && idx_mode[ii] == 1) {
                ii = f.instrs[ii].next
                ->
            }
            ins := ~f.instrs[ii]
            k := ins.kind
            if ins.line > 0 && ins.line != last_line {
                last_line = ins.line
                lines.push(cb.len())
                lines.push(last_line)
            }
            if opt && idx_mode[ii] == 3 {
                rb := x64_src(cb, f, &fr, &ra, idx_base[ii], X_RCX)
                ri := x64_src(cb, f, &fr, &ra, idx_off[ii], X_RDX)
                $rd := x64_vreg(&fr, &ra, ins.a)
                if rd < 0 { rd = X_RAX }
                x64_lea_sib(cb, rd, rb, ri, idx_shift[ii], 0)
                x64_set_temp(cb, &fr, &ra, ins.a, rd)
            } else if opt && idx_mode[ii] == 4 {
                rs := x64_src(cb, f, &fr, &ra, idx_base[ii], X_RAX)
                $rd := x64_vreg(&fr, &ra, ins.a)
                if rd < 0 { rd = X_RAX }
                x64_lea_sib(cb, rd, rs, rs, idx_shift[ii], idx_off[ii])
                x64_set_temp(cb, &fr, &ra, ins.a, rd)
            } else if opt && k == mir.MI_BIN && ins.next < 0 && a64_is_icmp(ins.b) && f.blocks[bi].tkind == mir.TKIND_BRANCH && f.blocks[bi].ta == ins.a && ins.a >= 0 && uses[ins.a] == 1 {
                if idx_mode[ii] == 5 {
                    x64_test_imm32(cb, idx_base[ii], idx_off[ii], idx_shift[ii] != 0)
                } else {
                    x64_cmp_vals(cb, f, &fr, &ra, ins.c, ins.d)
                }
                fused = x64_cc_of(ins.b)
            } else if opt && k == mir.MI_BIN && a64_is_icmp(ins.b) && ins.a >= 0 && uses[ins.a] == 1 &&
                      (idx_mode[ii] == 5 || x64_can_fuse_select(f, &fr, &ra, ii, &ins)) {
                sel_cmp_ii = ii
            } else if opt && k == mir.MI_BIN && x64_bin_direct(cb, f, &fr, &ra, &ins) {
            } else if k == mir.MI_NOP {
            } else if k == mir.MI_LOAD_LOCAL {
                lr := ra.local_reg[ins.b]
                if lr >= 32 {
                    x64_set_ftemp(cb, &fr, &ra, ins.a, lr - 32)
                } else if lr >= 0 {
                    x64_set_temp(cb, &fr, &ra, ins.a, lr)
                } else {
                    $w := ins.c
                    if w < 0 { w = 0 }
                    fd := x64_freg(&fr, &ra, ins.a)
                    if fd >= 0 {
                        x64_movsd_ld(cb, fd, X_RSP, fr.local_off[ins.b] + w * 8)
                    } else {
                        x64_ldr(cb, X_RAX, X_RSP, fr.local_off[ins.b] + w * 8)
                        x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
                    }
                }
            } else if k == mir.MI_STORE_LOCAL {
                lr := ra.local_reg[ins.a]
                if lr >= 32 {
                    x64_foperand(cb, f, &fr, &ra, lr - 32, ins.b)
                } else if lr >= 0 {
                    x64_operand(cb, f, &fr, &ra, lr, ins.b)
                } else {
                    $w := ins.c
                    if w < 0 { w = 0 }
                    fs := x64_freg(&fr, &ra, ins.b)
                    if fs >= 0 {
                        x64_movsd_st(cb, fs, X_RSP, fr.local_off[ins.a] + w * 8)
                    } else {
                        x64_operand(cb, f, &fr, &ra, X_RAX, ins.b)
                        x64_str(cb, X_RAX, X_RSP, fr.local_off[ins.a] + w * 8)
                    }
                }
            } else if k == mir.MI_ADDR {
                x64_lea(cb, X_RAX, X_RSP, fr.local_off[ins.b])
                x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
            } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD {
                $w := ins.d
                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                fd := x64_freg(&fr, &ra, ins.a)
                if opt && idx_mode[ii] == 2 {
                    rb := x64_src(cb, f, &fr, &ra, idx_base[ii], X_RCX)
                    ri := x64_src(cb, f, &fr, &ra, idx_off[ii], X_RDX)
                    if w == 8 && fd >= 0 {
                        x64_movsd_ld_sib(cb, fd, rb, ri, idx_shift[ii], ins.c)
                    } else {
                        $rd := x64_vreg(&fr, &ra, ins.a)
                        if rd < 0 { rd = X_RAX }
                        x64_load_sib(cb, w, rd, rb, ri, idx_shift[ii], ins.c)
                        x64_set_temp(cb, &fr, &ra, ins.a, rd)
                    }
                } else if w == 8 && fd >= 0 {
                    rb := x64_src(cb, f, &fr, &ra, ins.b, X_RCX)
                    x64_movsd_ld(cb, fd, rb, ins.c)
                } else {
                    x64_operand(cb, f, &fr, &ra, X_RCX, ins.b)
                    x64_load(cb, w, X_RAX, X_RCX, ins.c)
                    x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
                }
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                $w := ins.d
                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                fs := x64_freg(&fr, &ra, ins.b)
                if opt && idx_mode[ii] == 2 {
                    rb := x64_src(cb, f, &fr, &ra, idx_base[ii], X_RCX)
                    ri := x64_src(cb, f, &fr, &ra, idx_off[ii], X_RDX)
                    if w == 8 && fs >= 0 {
                        x64_movsd_st_sib(cb, fs, rb, ri, idx_shift[ii], ins.c)
                    } else {
                        rs := x64_src(cb, f, &fr, &ra, ins.b, X_RAX)
                        x64_store_sib(cb, w, rs, rb, ri, idx_shift[ii], ins.c)
                    }
                } else if w == 8 && fs >= 0 {
                    rb := x64_src(cb, f, &fr, &ra, ins.a, X_RCX)
                    x64_movsd_st(cb, fs, rb, ins.c)
                } else {
                    x64_operand(cb, f, &fr, &ra, X_RCX, ins.a)
                    x64_operand(cb, f, &fr, &ra, X_RAX, ins.b)
                    x64_store(cb, w, X_RAX, X_RCX, ins.c)
                }
            } else if k == mir.MI_BIN {
                if opt && ins.b >= mir.BIN_FADD && ins.b <= mir.BIN_FGE {
                    x64_fbin_direct(cb, f, &fr, &ra, &ins)
                } else {
                    x64_operand(cb, f, &fr, &ra, X_RAX, ins.c)
                    x64_operand(cb, f, &fr, &ra, X_RCX, ins.d)
                    x64_bin(cb, ins.b)
                    x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
                }
            } else if k == mir.MI_UN {
                if !opt || !x64_un_direct(cb, f, &fr, &ra, &ins) {
                    x64_operand(cb, f, &fr, &ra, X_RAX, ins.c)
                    x64_un(cb, ins.b)
                    x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
                }
            } else if k == mir.MI_SELECT {
                if sel_cmp_ii >= 0 {
                    sci := sel_cmp_ii
                    cins := ~f.instrs[sci]
                    sel_cmp_ii = -1
                    cc := x64_cc_of(cins.b)
                    $rd := x64_vreg(&fr, &ra, ins.a)
                    if rd < 0 || x64_vreg(&fr, &ra, ins.c) == rd ||
                       (opt && idx_mode[sci] == 5 && idx_base[sci] == rd) ||
                       (!(opt && idx_mode[sci] == 5) && (x64_vreg(&fr, &ra, cins.c) == rd || x64_vreg(&fr, &ra, cins.d) == rd)) {
                        rd = X_RAX
                    }
                    // Load operands BEFORE cmp (mov imm 0 uses xor, clobbering flags).
                    x64_operand(cb, f, &fr, &ra, rd, ins.d)
                    rt := x64_src(cb, f, &fr, &ra, ins.c, X_RCX)
                    if opt && idx_mode[sci] == 5 {
                        x64_test_imm32(cb, idx_base[sci], idx_off[sci], idx_shift[sci] != 0)
                    } else {
                        x64_cmp_vals(cb, f, &fr, &ra, cins.c, cins.d)
                    }
                    x64_rex(cb, true, rd, rt, false)
                    xb(cb, 0x0F)
                    xb(cb, 0x40 | cc)
                    x64_modrm_rr(cb, rd, rt)
                    x64_set_temp(cb, &fr, &ra, ins.a, rd)
                } else {
                    // All operands first (mov imm 0 is xor, which clobbers the
                    // flags), then test rdx, rdx; cmovne rax, rcx.
                    x64_operand(cb, f, &fr, &ra, X_RAX, ins.d)
                    x64_operand(cb, f, &fr, &ra, X_RCX, ins.c)
                    x64_operand(cb, f, &fr, &ra, X_RDX, ins.b)
                    x64_test(cb, X_RDX)
                    x64_rex(cb, true, X_RAX, X_RCX, false)
                    xb(cb, 0x0F)
                    xb(cb, 0x40 | CC_NE)
                    x64_modrm_rr(cb, X_RAX, X_RCX)
                    x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
                }
            } else if k == mir.MI_COPY {
                fd := x64_freg(&fr, &ra, ins.a)
                if fd >= 0 {
                    x64_foperand(cb, f, &fr, &ra, fd, ins.b)
                } else {
                    x64_operand(cb, f, &fr, &ra, X_RAX, ins.b)
                    x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
                }
            } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
                $a := ins.c
                $i := 0
                $regs := []int{}
                while a >= 0 {
                    if i < 8 {
                        if opt {
                            regs.push(f.margs[a].v)
                        } else {
                            x64_operand(cb, f, &fr, &ra, x64_arg_reg(i), f.margs[a].v)
                        }
                    } else {
                        x64_operand(cb, f, &fr, &ra, X_RAX, f.margs[a].v)
                        x64_str(cb, X_RAX, X_RSP, (i - 8) * 8)
                    }
                    i += 1
                    a = f.margs[a].next
                }
                if k == mir.MI_CALL_IND && opt {
                    x64_operand(cb, f, &fr, &ra, X_RAX, ins.b)
                }
                if regs.len > 0 {
                    x64_load_args(cb, f, &fr, &ra, &regs)
                }
                if k == mir.MI_CALL_IND {
                    if !opt {
                        x64_operand(cb, f, &fr, &ra, X_RAX, ins.b)
                    }
                    x64_call_reg(cb, X_RAX)
                } else if !opt || !x64_bits_call(cb, &ins.sval) {
                    x64_call(cb, relocs, ins.sval)
                }
                x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
            } else if k == mir.MI_STR_CONST {
                // lea rax, [rip + pool entry]
                xb(cb, 0x48)
                xb(cb, 0x8D)
                xb(cb, 0x05)
                strs.push(StrFix{adr_off: cb.len(), bytes: ins.sval + ""})
                str_aligns.push(ins.d)
                cb.emit_u32_le(0)
                x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
            } else if k == mir.MI_LOAD_FN_ADDR {
                if ins.d == 1 {
                    x64_lea_data_label(cb, relocs, X_RAX, ins.sval)
                } else {
                    x64_lea_label(cb, relocs, X_RAX, ins.sval)
                }
                x64_set_temp(cb, &fr, &ra, ins.a, X_RAX)
            } else if k == mir.MI_ASM {
                s := ins.sval
                if s == "hlt" || s == "wfi" {
                    xb(cb, 0xF4)
                } else if s == "cli" {
                    xb(cb, 0xFA)
                } else if s == "sti" {
                    xb(cb, 0xFB)
                } else if s == "nop" {
                    xb(cb, 0x90)
                } else if s == "pause" || s == "yield" || s == "wfe" {
                    xb(cb, 0xF3)
                    xb(cb, 0x90)
                } else if s == "out dx, al" || s == "out dx,al" {
                    xb(cb, 0xEE)
                } else if s == "in al, dx" || s == "in al,dx" {
                    xb(cb, 0xEC)
                } else if s == "wbinvd" {
                    xb(cb, 0x0F)
                    xb(cb, 0x09)
                } else if s == "dsb sy" || s == "dmb sy" || s == "mfence" || s == "fence" || s == "mb" {
                    xb(cb, 0x0F)
                    xb(cb, 0xAE)
                    xb(cb, 0xF0)
                } else if s == "lfence" || s == "rmb" || s == "dmb ld" {
                    xb(cb, 0x0F)
                    xb(cb, 0xAE)
                    xb(cb, 0xE8)
                } else if s == "sfence" || s == "wmb" || s == "dmb st" {
                    xb(cb, 0x0F)
                    xb(cb, 0xAE)
                    xb(cb, 0xF8)
                } else if s == "cld" {
                    xb(cb, 0xFC)
                } else if s == "iretq" {
                    xb(cb, 0x48)
                    xb(cb, 0xCF)
                } else if s == "swapgs" {
                    xb(cb, 0x0F)
                    xb(cb, 0x01)
                    xb(cb, 0xF8)
                } else {
                    xb(cb, 0x90)
                }
            } else {
                // Unknown kinds are a lowering bug; trap loudly at run time.
                x64_ud2(cb)
            }
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        $invert_br := false
        if blk.tkind == mir.TKIND_BRANCH {
            invert_br = blk.tb == next_bi
            if !invert_br && opt && !pgo_map && blk.tc != next_bi && blk_pos.len == nb_fn {
                tb_back := blk.tb >= 0 && blk.tb < nb_fn && blk_pos[blk.tb] >= 0 && blk_pos[blk.tb] <= oi
                tc_back := blk.tc >= 0 && blk.tc < nb_fn && blk_pos[blk.tc] >= 0 && blk_pos[blk.tc] <= oi
                tb_cold := blk.tb >= 0 && blk.tb < nb_fn && (cold[blk.tb] || is_ret[blk.tb])
                tc_cold := blk.tc >= 0 && blk.tc < nb_fn && (cold[blk.tc] || is_ret[blk.tc])
                if (tc_back && !tb_back) || (tb_cold && !tc_cold && !tb_back) {
                    invert_br = true
                }
            }
        }
        if blk.tkind == mir.TKIND_RETURN {
            x64_operand(cb, f, &fr, &ra, X_RAX, blk.ta)
            if leaf_noframe {
                x64_ret(cb)
            } else {
                x64_jmp(cb, relocs, epilogue)
            }
        } else if blk.tkind == mir.TKIND_JUMP {
            if blk.ta != next_bi {
                x64_jmp(cb, relocs, f.label + ".bb" + str(blk.ta))
            }
        } else if blk.tkind == mir.TKIND_BRANCH && (bounds.len > 0 || fused >= 0) {
            $cc := fused
            if bounds.len > 0 {
                x64_cmp_vals(cb, f, &fr, &ra, bounds[3], bounds[4])
                cc = CC_AE
            }
            if pgo_map { syms.define_label(f.label + ".pgo" + str(bi), cb.len()) }
            if invert_br {
                x64_jcc(cb, relocs, cc ^ 1, f.label + ".bb" + str(blk.tc))
                if blk.tb != next_bi {
                    x64_jmp(cb, relocs, f.label + ".bb" + str(blk.tb))
                }
            } else {
                x64_jcc(cb, relocs, cc, f.label + ".bb" + str(blk.tb))
                if blk.tc != next_bi {
                    x64_jmp(cb, relocs, f.label + ".bb" + str(blk.tc))
                }
            }
        } else if blk.tkind == mir.TKIND_BRANCH {
            $cr := x64_vreg(&fr, &ra, blk.ta)
            if cr < 0 {
                x64_operand(cb, f, &fr, &ra, X_RAX, blk.ta)
                cr = X_RAX
            }
            x64_test(cb, cr)
            if pgo_map { syms.define_label(f.label + ".pgo" + str(bi), cb.len()) }
            if invert_br {
                x64_jcc(cb, relocs, CC_E, f.label + ".bb" + str(blk.tc))
                if blk.tb != next_bi {
                    x64_jmp(cb, relocs, f.label + ".bb" + str(blk.tb))
                }
            } else {
                x64_jcc(cb, relocs, CC_NE, f.label + ".bb" + str(blk.tb))
                if blk.tc != next_bi {
                    x64_jmp(cb, relocs, f.label + ".bb" + str(blk.tc))
                }
            }
        } else {
            // Open block at function end: return 0.
            x64_mov_imm(cb, X_RAX, 0)
            if leaf_noframe {
                x64_ret(cb)
            } else {
                x64_jmp(cb, relocs, epilogue)
            }
        }
    }
    syms.define_label(epilogue, cb.len())
    if !leaf_noframe {
        for ci in 0:ra.used_callee.len {
            r := ra.used_callee[ci]
            if r >= 32 {
                x64_movsd_ld(cb, r - 32, X_RSP, save_off + ci * 8)
            } else {
                x64_ldr(cb, r, X_RSP, save_off + ci * 8)
            }
        }
        // leave ; ret
        xb(cb, 0xC9)
    }
    x64_ret(cb)
    if !inline_fast_exit {
        for ei in 0:fp_plan.exits.len {
            syms.define_label(f.label + ".fp" + str(ei), cb.len())
            rn := fp_plan.exits[ei].ret_node
            if fp_plan.nodes[rn].kind == FV_CONST {
                x64_mov_imm(cb, X_RAX, fp_plan.nodes[rn].val)
            } else {
                rr := x64_eval_fast_node(cb, &fp_plan.nodes, rn, 0)
                if rr != X_RAX {
                    x64_mov(cb, X_RAX, rr)
                }
            }
            x64_ret(cb)
        }
    }
    // String literal pool, patched into the lea instructions above.
    for si in 0:strs.len {
        if si < str_aligns.len && str_aligns[si] == 8 {
            while cb.len() % 8 != 0 {
                cb.emit_u8(0)
            }
        }
        pos := cb.len()
        s := strs[si].bytes
        for bi2 in 0:s.len {
            cb.emit_u8(s[bi2])
        }
        cb.emit_u8(0)
        while cb.len() % 4 != 0 {
            cb.emit_u8(0)
        }
        at := strs[si].adr_off
        cb.patch_u32_le(at, pos - (at + 4))
    }
}

// Generic (arm64) Linux system call number -> x86-64 number; -1 when the
// runtime has no use for it.
fn x64_linux_nr(n int) int {
    if n == 17 { << 79 }
    if n == 19 { << 290 }
    if n == 20 { << 291 }
    if n == 21 { << 233 }
    if n == 22 { << 281 }
    if n == 23 { << 32 }
    if n == 24 { << 292 }
    if n == 25 { << 72 }
    if n == 29 { << 16 }
    if n == 32 { << 73 }
    if n == 33 { << 259 }
    if n == 34 { << 258 }
    if n == 35 { << 263 }
    if n == 36 { << 266 }
