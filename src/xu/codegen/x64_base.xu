const X64_NR_TABLE = 300

// Task context layout (runtime/core chan.xu, named after arm64 registers):
// rbx at 0, r12 at 8, r13 at 16, r14 at 24, r15 at 72, rbp at 80, resume
// address at 88, rsp at 96, xmm8-xmm15 at 104.
fn emit_x64_task_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    syms.define_label("switch_context", cb.len())
    x64_mov(cb, X_RDX, X_RSI)
    x64_mov(cb, X_RSI, X_RDI)
    // __xu_task_switch(from rsi, to rdx): save the callee-saved state into
    // from, resume to.
    syms.define_label("__xu_task_switch", cb.len())
    x64_str(cb, X_RBX, X_RSI, 0)
    x64_str(cb, X_R12, X_RSI, 8)
    x64_str(cb, X_R13, X_RSI, 16)
    x64_str(cb, X_R14, X_RSI, 24)
    x64_str(cb, X_R15, X_RSI, 72)
    x64_str(cb, X_RBP, X_RSI, 80)
    x64_ldr(cb, X_RAX, X_RSP, 0)
    x64_str(cb, X_RAX, X_RSI, 88)
    x64_lea(cb, X_RAX, X_RSP, 8)
    x64_str(cb, X_RAX, X_RSI, 96)
    for i in 0:8 {
        x64_movsd_st(cb, 8 + i, X_RSI, 104 + i * 8)
    }
    x64_ldr(cb, X_RBX, X_RDX, 0)
    x64_ldr(cb, X_R12, X_RDX, 8)
    x64_ldr(cb, X_R13, X_RDX, 16)
    x64_ldr(cb, X_R14, X_RDX, 24)
    x64_ldr(cb, X_R15, X_RDX, 72)
    x64_ldr(cb, X_RBP, X_RDX, 80)
    x64_ldr(cb, X_RSP, X_RDX, 96)
    for i in 0:8 {
        x64_movsd_ld(cb, 8 + i, X_RDX, 104 + i * 8)
    }
    // jmp [rdx + 88]
    xb(cb, 0xFF)
    x64_modrm_mem(cb, 4, X_RDX, 88)

    // Hardware and architecture intrinsics for baremetal kernels
    syms.define_label("in8", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xFA) // mov edx, edi
    xb(cb, 0xEC) // in al, dx
    xb(cb, 0x0F)
    xb(cb, 0xB6)
    xb(cb, 0xC0) // movzx eax, al
    xb(cb, 0xC3) // ret

    syms.define_label("out8", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xFA) // mov edx, edi
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov eax, esi
    xb(cb, 0xEE) // out dx, al
    xb(cb, 0xC3) // ret

    syms.define_label("in16", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xFA) // mov edx, edi
    xb(cb, 0x66)
    xb(cb, 0xED) // in ax, dx
    xb(cb, 0x0F)
    xb(cb, 0xB7)
    xb(cb, 0xC0) // movzx eax, ax
    xb(cb, 0xC3) // ret

    syms.define_label("out16", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xFA) // mov edx, edi
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov eax, esi
    xb(cb, 0x66)
    xb(cb, 0xEF) // out dx, ax
    xb(cb, 0xC3) // ret

    syms.define_label("in32", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xFA) // mov edx, edi
    xb(cb, 0xED) // in eax, dx
    xb(cb, 0xC3) // ret

    syms.define_label("out32", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xFA) // mov edx, edi
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov eax, esi
    xb(cb, 0xEF) // out dx, eax
    xb(cb, 0xC3) // ret

    syms.define_label("load_idt", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x01)
    xb(cb, 0x1F) // lidt [rdi]
    xb(cb, 0xC3) // ret

    syms.define_label("read_cr2", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x20)
    xb(cb, 0xD0) // mov rax, cr2
    xb(cb, 0xC3) // ret

    syms.define_label("read_cr3", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x20)
    xb(cb, 0xD8) // mov rax, cr3
    xb(cb, 0xC3) // ret

    syms.define_label("write_cr3", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x22)
    xb(cb, 0xDF) // mov cr3, rdi
    xb(cb, 0xC3) // ret

    syms.define_label("invlpg", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x01)
    xb(cb, 0x3F) // invlpg [rdi]
    xb(cb, 0xC3) // ret

    syms.define_label("set_vbar", cb.len())
    xb(cb, 0xC3) // ret

    syms.define_label("set_trap_vector", cb.len())
    xb(cb, 0xC3) // ret

    syms.define_label("syscall_entry", cb.len())
    xb(cb, 0x48)
    xb(cb, 0x0F)
    xb(cb, 0x07) // sysretq

    // Hardware atomic primitives (SysV ABI: rdi=ptr, rsi=val/exp/delta, rdx=desired).
    syms.define_label("atomic_load_u32", cb.len())
    xb(cb, 0x8B)
    xb(cb, 0x07) // mov eax, [rdi]
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_store_u32", cb.len())
    xb(cb, 0x89)
    xb(cb, 0x37) // mov [rdi], esi
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_xchg_u32", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov eax, esi
    xb(cb, 0x87)
    xb(cb, 0x07) // xchg [rdi], eax
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_cas_u32", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov eax, esi
    xb(cb, 0xF0)
    xb(cb, 0x0F)
    xb(cb, 0xB1)
    xb(cb, 0x17) // lock cmpxchg [rdi], edx
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_fetch_add_u32", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov eax, esi
    xb(cb, 0xF0)
    xb(cb, 0x0F)
    xb(cb, 0xC1)
    xb(cb, 0x07) // lock xadd [rdi], eax
    xb(cb, 0xC3) // ret

    syms.define_label("atomic_load_u64", cb.len())
    xb(cb, 0x48)
    xb(cb, 0x8B)
    xb(cb, 0x07) // mov rax, [rdi]
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_store_u64", cb.len())
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0x37) // mov [rdi], rsi
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_xchg_u64", cb.len())
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov rax, rsi
    xb(cb, 0x48)
    xb(cb, 0x87)
    xb(cb, 0x07) // xchg [rdi], rax
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_cas_u64", cb.len())
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov rax, rsi
    xb(cb, 0xF0)
    xb(cb, 0x48)
    xb(cb, 0x0F)
    xb(cb, 0xB1)
    xb(cb, 0x17) // lock cmpxchg [rdi], rdx
    xb(cb, 0xC3) // ret
    syms.define_label("atomic_fetch_add_u64", cb.len())
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov rax, rsi
    xb(cb, 0xF0)
    xb(cb, 0x48)
    xb(cb, 0x0F)
    xb(cb, 0xC1)
    xb(cb, 0x07) // lock xadd [rdi], rax
    xb(cb, 0xC3) // ret

    // Extended system register, GDT/TSS, MSR, and RDTSC primitives.
    syms.define_label("read_cr0", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x20)
    xb(cb, 0xC0) // mov rax, cr0
    xb(cb, 0xC3) // ret
    syms.define_label("write_cr0", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x22)
    xb(cb, 0xC7) // mov cr0, rdi
    xb(cb, 0xC3) // ret
    syms.define_label("read_cr4", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x20)
    xb(cb, 0xE0) // mov rax, cr4
    xb(cb, 0xC3) // ret
    syms.define_label("write_cr4", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x22)
    xb(cb, 0xE7) // mov cr4, rdi
    xb(cb, 0xC3) // ret
    syms.define_label("load_gdt", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x01)
    xb(cb, 0x17) // lgdt [rdi]
    xb(cb, 0xC3) // ret
    syms.define_label("load_tr", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x00)
    xb(cb, 0xDF) // ltr di
    xb(cb, 0xC3) // ret
    syms.define_label("rdmsr", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xF9) // mov ecx, edi
    xb(cb, 0x0F)
    xb(cb, 0x32) // rdmsr
    xb(cb, 0x48)
    xb(cb, 0xC1)
    xb(cb, 0xE2)
    xb(cb, 0x20) // shl rdx, 32
    xb(cb, 0x48)
    xb(cb, 0x09)
    xb(cb, 0xD0) // or rax, rdx
    xb(cb, 0xC3) // ret
    syms.define_label("wrmsr", cb.len())
    xb(cb, 0x89)
    xb(cb, 0xF9) // mov ecx, edi
    xb(cb, 0x89)
    xb(cb, 0xF0) // mov eax, esi
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xF2) // mov rdx, rsi
    xb(cb, 0x48)
    xb(cb, 0xC1)
    xb(cb, 0xEA)
    xb(cb, 0x20) // shr rdx, 32
    xb(cb, 0x0F)
    xb(cb, 0x30) // wrmsr
    xb(cb, 0xC3) // ret
    syms.define_label("rdtsc", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x31) // rdtsc
    xb(cb, 0x48)
    xb(cb, 0xC1)
    xb(cb, 0xE2)
    xb(cb, 0x20) // shl rdx, 32
    xb(cb, 0x48)
    xb(cb, 0x09)
    xb(cb, 0xD0) // or rax, rdx
    xb(cb, 0xC3) // ret
    syms.define_label("swapgs", cb.len())
    xb(cb, 0x0F)
    xb(cb, 0x01)
    xb(cb, 0xF8) // swapgs
    xb(cb, 0xC3) // ret
    syms.define_label("cpuid", cb.len())
    xb(cb, 0x53) // push rbx
    xb(cb, 0x49)
    xb(cb, 0x89)
    xb(cb, 0xD0) // mov r8, rdx
    xb(cb, 0x89)
    xb(cb, 0xF8) // mov eax, edi
    xb(cb, 0x89)
    xb(cb, 0xF1) // mov ecx, esi
    xb(cb, 0x0F)
    xb(cb, 0xA2) // cpuid
    xb(cb, 0x41)
    xb(cb, 0x89)
    xb(cb, 0x00) // mov [r8], eax
    xb(cb, 0x41)
    xb(cb, 0x89)
    xb(cb, 0x58)
    xb(cb, 0x04) // mov [r8+4], ebx
    xb(cb, 0x41)
    xb(cb, 0x89)
    xb(cb, 0x48)
    xb(cb, 0x08) // mov [r8+8], ecx
    xb(cb, 0x41)
    xb(cb, 0x89)
    xb(cb, 0x50)
    xb(cb, 0x0C) // mov [r8+12], edx
    xb(cb, 0x5B) // pop rbx
    xb(cb, 0xC3) // ret
    syms.define_label("read_rflags", cb.len())
    xb(cb, 0x9C) // pushfq
    xb(cb, 0x58) // pop rax
    xb(cb, 0xC3) // ret
    syms.define_label("syscall4", cb.len())
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xF8) // mov rax, rdi
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xF7) // mov rdi, rsi
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xD6) // mov rsi, rdx
    xb(cb, 0x48)
    xb(cb, 0x89)
    xb(cb, 0xCA) // mov rdx, rcx
    xb(cb, 0x4D)
    xb(cb, 0x89)
    xb(cb, 0xC2) // mov r10, r8
    xb(cb, 0x0F)
    xb(cb, 0x05) // syscall
    xb(cb, 0xC3) // ret

    // __xu_task_entry: first frame of a task. rbx = task, r12 = function,
    // r13 = 16 argument words, r14 = exit function (never returns).
    syms.define_label("__xu_task_entry", cb.len())
    x64_add_rsp(cb, -64)
    for i in 0:8 {
        x64_ldr(cb, X_RAX, X_R13, 64 + i * 8)
        x64_str(cb, X_RAX, X_RSP, i * 8)
    }
    for i in 0:8 {
        x64_ldr(cb, x64_arg_reg(i), X_R13, i * 8)
    }
    x64_call_reg(cb, X_R12)
    x64_add_rsp(cb, 64)
    x64_mov(cb, X_RDI, X_RBX)
    x64_call_reg(cb, X_R14)
    x64_ud2(cb)

    // The saved r13 is the argument itself. No argument block or stack
    // argument area is needed for a zero- or one-word call.
    syms.define_label("__xu_task_entry_word", cb.len())
    x64_mov(cb, x64_arg_reg(0), X_R13)
    x64_call_reg(cb, X_R12)
    x64_mov(cb, X_RDI, X_RBX)
    x64_call_reg(cb, X_R14)
    x64_ud2(cb)
}

fn x64_syscall_insn(cb $&mc.CodeBuffer) {
    xb(cb, 0x0F)
    xb(cb, 0x05)
}

fn x64_u32(cb $&mc.CodeBuffer, v int) {
    cb.emit_u32_le(v & 0xffffffff)
}

// x64-none boot block, emitted at code offset 0 (virtual address
// `code_vaddr`; the file is mapped from `image_vaddr`). It makes the plain
// ELF bootable by Multiboot loaders, including `qemu-system-x86_64 -kernel`:
//   +0x00 Multiboot header (a.out kludge: load the whole file at image_vaddr)
//   +0x20 GDT: null, 64-bit code (0x08), data (0x10); +0x38 GDTR
//   +0x40 saved Multiboot magic, +0x48 saved Multiboot info pointer
//   +0x50 32-bit entry: identity-map 1 GiB with 2 MiB pages, enable PAE,
//         EFER.LME and paging, far-jump to 64-bit code, then __xu_start
// followed by 4 KiB-aligned PML4/PDPT/PD and a 64 KiB boot stack.
// Loaders that enter the ELF64 e_entry (__xu_start) directly skip all this.
pub fn emit_x64_none_boot(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, image_vaddr int, code_vaddr int) {
    b := code_vaddr
    mb_magic := 0x1BADB002
    mb_flags := 0x00010003
    entry32 := b + 0x50
    // Page tables start at the first 4 KiB boundary after the boot code.
    $pt := b + 0x200
    pt = pt + ((4096 - (pt % 4096)) % 4096)
    pml4 := pt
    pdpt := pt + 0x1000
    pd := pt + 0x2000
    stack_top := pt + 0x13000

    // Multiboot header.
    x64_u32(cb, mb_magic)
    x64_u32(cb, mb_flags)
    x64_u32(cb, 0 - (mb_magic + mb_flags))
    x64_u32(cb, b)              // header_addr
    x64_u32(cb, image_vaddr)    // load_addr
    x64_u32(cb, 0)              // load_end_addr: whole file
    x64_u32(cb, 0)              // bss_end_addr: none
    x64_u32(cb, entry32)        // entry_addr
    // GDT.
    cb.emit_u64_le(0)
    cb.emit_u64_le(0x00AF9A000000FFFF)
    cb.emit_u64_le(0x00AF92000000FFFF)
    // GDTR (limit, base) + padding.
    xb(cb, 23)
    xb(cb, 0)
    x64_u32(cb, b + 0x20)
    xb(cb, 0)
    xb(cb, 0)
    syms.define_label("__xu_boot_magic", cb.len())
    cb.emit_u64_le(0)
    syms.define_label("__xu_boot_info", cb.len())
    cb.emit_u64_le(0)

    // 32-bit protected-mode entry (Multiboot: EAX magic, EBX info).
    syms.define_label("__xu_multiboot_entry", cb.len())
    xb(cb, 0xFA)                                  // cli
    xb(cb, 0xA3)                                  // mov [magic], eax
    x64_u32(cb, b + 0x40)
    xb(cb, 0x89)                                  // mov [info], ebx
    xb(cb, 0x1D)
    x64_u32(cb, b + 0x48)
    xb(cb, 0xFC)                                  // cld
    xb(cb, 0xBF)                                  // mov edi, pml4
    x64_u32(cb, pml4)
    xb(cb, 0x31)                                  // xor eax, eax
    xb(cb, 0xC0)
    xb(cb, 0xB9)                                  // mov ecx, 3072
    x64_u32(cb, 3072)
    xb(cb, 0xF3)                                  // rep stosd
    xb(cb, 0xAB)
    xb(cb, 0xC7)                                  // mov dword [pml4], pdpt|3
    xb(cb, 0x05)
    x64_u32(cb, pml4)
    x64_u32(cb, pdpt | 3)
    xb(cb, 0xC7)                                  // mov dword [pdpt], pd|3
    xb(cb, 0x05)
    x64_u32(cb, pdpt)
    x64_u32(cb, pd | 3)
    xb(cb, 0xBF)                                  // mov edi, pd
    x64_u32(cb, pd)
    xb(cb, 0xB8)                                  // mov eax, 0x83 (P|W|PS)
    x64_u32(cb, 0x83)
    xb(cb, 0xB9)                                  // mov ecx, 512
    x64_u32(cb, 512)
    xb(cb, 0x89)                                  // 1: mov [edi], eax
    xb(cb, 0x07)
    xb(cb, 0x05)                                  // add eax, 2 MiB
    x64_u32(cb, 0x200000)
    xb(cb, 0x83)                                  // add edi, 8
    xb(cb, 0xC7)
    xb(cb, 0x08)
    xb(cb, 0x49)                                  // dec ecx
    xb(cb, 0x75)                                  // jnz 1b
    xb(cb, 0xF3)
    xb(cb, 0xB8)                                  // mov eax, pml4
    x64_u32(cb, pml4)
    xb(cb, 0x0F)                                  // mov cr3, eax
    xb(cb, 0x22)
    xb(cb, 0xD8)
    xb(cb, 0x0F)                                  // mov eax, cr4
    xb(cb, 0x20)
    xb(cb, 0xE0)
    xb(cb, 0x83)                                  // or eax, PAE
    xb(cb, 0xC8)
    xb(cb, 0x20)
    xb(cb, 0x0F)                                  // mov cr4, eax
    xb(cb, 0x22)
    xb(cb, 0xE0)
    xb(cb, 0xB9)                                  // mov ecx, IA32_EFER
    x64_u32(cb, 0xC0000080)
    xb(cb, 0x0F)                                  // rdmsr
    xb(cb, 0x32)
    xb(cb, 0x0D)                                  // or eax, LME
    x64_u32(cb, 0x100)
    xb(cb, 0x0F)                                  // wrmsr
    xb(cb, 0x30)
    xb(cb, 0x0F)                                  // lgdt [gdtr]
    xb(cb, 0x01)
    xb(cb, 0x15)
    x64_u32(cb, b + 0x38)
    xb(cb, 0x0F)                                  // mov eax, cr0
    xb(cb, 0x20)
    xb(cb, 0xC0)
    xb(cb, 0x0D)                                  // or eax, PG|PE
    x64_u32(cb, 0x80000001)
    xb(cb, 0x0F)                                  // mov cr0, eax
    xb(cb, 0x22)
    xb(cb, 0xC0)
    // ljmp 0x08:entry64 (entry64 directly follows this 7-byte instruction)
    xb(cb, 0xEA)
    x64_u32(cb, b + cb.len() + 6)
    xb(cb, 0x08)
    xb(cb, 0x00)
    // 64-bit: load data segments, continue in the common entry.
    xb(cb, 0x66)                                  // mov ax, 0x10
    xb(cb, 0xB8)
    xb(cb, 0x10)
    xb(cb, 0x00)
    xb(cb, 0x8E)                                  // mov ds, ax
    xb(cb, 0xD8)
    xb(cb, 0x8E)                                  // mov es, ax
    xb(cb, 0xC0)
    xb(cb, 0x8E)                                  // mov ss, ax
    xb(cb, 0xD0)
    xb(cb, 0x8E)                                  // mov fs, ax
    xb(cb, 0xE0)
    xb(cb, 0x8E)                                  // mov gs, ax
    xb(cb, 0xE8)
    x64_jmp(cb, relocs, "__xu_start")

    // Page tables and boot stack (zero-filled, part of the loaded image).
    while b + cb.len() < stack_top {
        xb(cb, 0)
    }
    syms.define_label("__xu_boot_stack_top", cb.len())
}

// Process entry, raw system call and runtime-state accessor shared by all
// functions. tgt_os uses target.OS_* codes.
pub fn emit_x64_runtime_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, tgt_os int, main_label string, link_ui bool, emit_object bool, uses_ffi bool) {
    if tgt_os == target.OS_NONE {
        syms.define_label("__xu_start", cb.len())
        if !emit_object {
            syms.define_label("_start", cb.len())
            // Own boot stack (emit_x64_none_boot) and SSE: Xu code and
            // switch_context use xmm registers.
            x64_lea_label(cb, relocs, X_RSP, "__xu_boot_stack_top")
        }
        xb(cb, 0x0F)                   // mov rax, cr0
        xb(cb, 0x20)
        xb(cb, 0xC0)
        xb(cb, 0x48)                   // and rax, ~CR0.EM
        xb(cb, 0x83)
        xb(cb, 0xE0)
        xb(cb, 0xFB)
        xb(cb, 0x48)                   // or rax, CR0.MP
        xb(cb, 0x83)
        xb(cb, 0xC8)
        xb(cb, 0x02)
        xb(cb, 0x0F)                   // mov cr0, rax
        xb(cb, 0x22)
        xb(cb, 0xC0)
        xb(cb, 0x0F)                   // mov rax, cr4
        xb(cb, 0x20)
        xb(cb, 0xE0)
        xb(cb, 0x48)                   // or rax, OSFXSR|OSXMMEXCPT
        xb(cb, 0x0D)
        x64_u32(cb, 0x600)
        xb(cb, 0x0F)                   // mov cr4, rax
        xb(cb, 0x22)
        xb(cb, 0xE0)
        x64_call(cb, relocs, main_label)
        syms.define_label("__xu_halt", cb.len())
        xb(cb, 0xF4) // hlt
        x64_jmp(cb, relocs, "__xu_halt")
        syms.define_label("__xu_globals", cb.len())
        x64_mov_imm(cb, X_RAX, 0)
        x64_ret(cb)
        syms.define_label("__xu_syscall", cb.len())
        x64_mov_imm(cb, X_RAX, -1)
        x64_ret(cb)
        has_panic := syms.lookup_offset("__xu_panic_handler") >= 0
        if has_panic {
            syms.define_label("_runtime_core_missing_index_panic", cb.len())
            x64_mov_imm(cb, X_RDI, 1)
            syms.define_label("_runtime_core_missing_rt_panic", cb.len())
            x64_call(cb, relocs, "__xu_panic_handler")
            xb(cb, 0xF4) // hlt
            x64_jmp(cb, relocs, "__xu_halt")
        } else {
            syms.define_label("_runtime_core_missing_rt_panic", cb.len())
            syms.define_label("_runtime_core_missing_index_panic", cb.len())
            xb(cb, 0xF4) // hlt
            x64_jmp(cb, relocs, "__xu_halt")
        }
        syms.define_label("_runtime_core_missing_str_free", cb.len())
        x64_ret(cb)
        // u64 / and % (the zero divisor is checked before the call).
        syms.define_label("_runtime_core_missing_u64_div", cb.len())
        x64_mov(cb, X_RAX, X_RDI)
        xb(cb, 0x31)                   // xor edx, edx
        xb(cb, 0xD2)
        xb(cb, 0x48)                   // div rsi
        xb(cb, 0xF7)
        xb(cb, 0xF6)
        x64_ret(cb)
        // String ==/!= on {ptr, len, cap} descriptors; needs no allocator.
        syms.define_label("_runtime_core_missing_str_eq", cb.len())
        xb(cb, 0x48)                   // mov rcx, [rdi+8]
        xb(cb, 0x8B)
        xb(cb, 0x4F)
        xb(cb, 0x08)
        xb(cb, 0x48)                   // cmp rcx, [rsi+8]
        xb(cb, 0x3B)
        xb(cb, 0x4E)
        xb(cb, 0x08)
        xb(cb, 0x75)                   // jne .ne
        xb(cb, 0x10)
        xb(cb, 0x48)                   // mov rdi, [rdi]
        xb(cb, 0x8B)
        xb(cb, 0x3F)
        xb(cb, 0x48)                   // mov rsi, [rsi]
        xb(cb, 0x8B)
        xb(cb, 0x36)
        xb(cb, 0xF3)                   // repe cmpsb
        xb(cb, 0xA6)
        xb(cb, 0x75)                   // jne .ne
        xb(cb, 0x06)
        xb(cb, 0xB8)                   // mov eax, 1
        x64_u32(cb, 1)
        x64_ret(cb)
        xb(cb, 0x31)                   // .ne: xor eax, eax
        xb(cb, 0xC0)
        x64_ret(cb)
        // irq_save() -> RFLAGS, interrupts disabled.
        syms.define_label("irq_save", cb.len())
        xb(cb, 0x9C)                   // pushfq
        xb(cb, 0x58)                   // pop rax
        xb(cb, 0xFA)                   // cli
        x64_ret(cb)
        // irq_restore(flags): sti only if IF was set in flags.
        syms.define_label("irq_restore", cb.len())
        xb(cb, 0xF7)                   // test edi, 0x200
        xb(cb, 0xC7)
        x64_u32(cb, 0x200)
        xb(cb, 0x74)                   // jz +1
        xb(cb, 0x01)
        xb(cb, 0xFB)                   // sti
        x64_ret(cb)
        syms.define_label("boot_magic", cb.len())
        if emit_object {
            x64_mov_imm(cb, X_RAX, 0)
        } else {
            xb(cb, 0x48)                   // mov rax, [rip + __xu_boot_magic]
            xb(cb, 0x8B)
            xb(cb, 0x05)
            x64_rel32(cb, relocs, "__xu_boot_magic")
        }
        x64_ret(cb)
        syms.define_label("boot_info_addr", cb.len())
        if emit_object {
            x64_mov_imm(cb, X_RAX, 0)
        } else {
            xb(cb, 0x48)                   // mov rax, [rip + __xu_boot_info]
            xb(cb, 0x8B)
            xb(cb, 0x05)
            x64_rel32(cb, relocs, "__xu_boot_info")
        }
        x64_ret(cb)
        emit_x64_task_stubs(cb, syms)
        <<
    }
    if tgt_os == target.OS_WINDOWS {
        emit_x64_windows_stubs(cb, syms, relocs, main_label, link_ui, emit_object, uses_ffi)
        <<
    }
    linux := tgt_os == target.OS_LINUX
    $mac_nr := 0
    if !linux {
        mac_nr = 0x2000000
    }
    // __xu_start: keep argc/argv/envp, map the state block into r15, run
    // main, exit with its result.
    syms.define_label("__xu_start", cb.len())
    if linux && emit_object {
        syms.define_label("xu_app_start", cb.len())
        xb(cb, 0x89)
        x64_modrm_rr(cb, X_RDI, X_RDI) // mov edi, edi (C int argc)
    }
    if linux && !emit_object {
        x64_ldr(cb, X_RBX, X_RSP, 0)
        x64_lea(cb, X_R12, X_RSP, 8)
        // envp = argv + 8 * (argc + 1)
        xb(cb, 0x4D)
        xb(cb, 0x8D)
        xb(cb, 0x6C)
        xb(cb, 0xDC)
        xb(cb, 0x08)
    } else {
        x64_mov(cb, X_RBX, X_RDI)
        x64_mov(cb, X_R12, X_RSI)
        x64_mov(cb, X_R13, X_RDX)
    }
    x64_mov_imm(cb, X_RDI, 0)
    x64_mov_imm(cb, X_RSI, 65536)
    x64_mov_imm(cb, X_RDX, 3)
    if linux {
        x64_mov_imm(cb, X_R10, 34)
        x64_mov_imm(cb, X_RAX, 9)
    } else {
        x64_mov_imm(cb, X_R10, 4098)
        x64_mov_imm(cb, X_RAX, mac_nr + 197)
    }
    x64_mov_imm(cb, X_R8, -1)
    x64_mov_imm(cb, X_R9, 0)
    x64_syscall_insn(cb)
    x64_mov(cb, X_R15, X_RAX)
    x64_str(cb, X_RBX, X_R15, 0)
    x64_str(cb, X_R12, X_R15, 8)
    x64_str(cb, X_R13, X_R15, 32)
    if link_ui {
        x64_mov_imm(cb, X_RAX, 1)
        x64_str(cb, X_RAX, X_R15, uiabi.STATE_OFFSET)
    }
    // Keep rsp 16-byte aligned at the call into main.
    if !linux || emit_object {
        x64_add_rsp(cb, -8)
    }
    x64_call(cb, relocs, main_label)
    x64_mov(cb, X_RDI, X_RAX)
    if linux {
        x64_mov_imm(cb, X_RAX, 231)
    } else {
        x64_mov_imm(cb, X_RAX, mac_nr + 1)
    }
    x64_syscall_insn(cb)
    x64_ud2(cb)
    // __xu_syscall(nr, a, b, c, d, e, f) -> result or -errno.
    // nr -1 is the runtime's task switch: (from task, to task).
    // nr -2 returns the caller's frame pointer, nr -3 the address of
    // __xu_start (backtraces). nr -4 copies c > 0 bytes from b to a,
    // forward; nr -5 zeroes b > 0 bytes at a.
    if link_ui {
        emit_x64_ui_dispatch(cb, syms, relocs, linux)
    } else {
        syms.define_label("__xu_syscall", cb.len())
    }
    if !linux {
        emit_macos_x64_clock(cb, syms, relocs, emit_object)
    }
    if uses_ffi || !emit_object {
        emit_x64_ffi_calls(cb, syms, relocs, emit_object)
    }
    x64_cmp_imm8(cb, X_RDI, -5)
    not5 := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_RCX, X_RDX)
    x64_mov(cb, X_RDI, X_RSI)
    x64_mov_imm(cb, X_RAX, 0)
    // rep stosb
    xb(cb, 0xF3)
    xb(cb, 0xAA)
    x64_ret(cb)
    x64_land(cb, not5)
    x64_cmp_imm8(cb, X_RDI, -4)
    not4 := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_RDI, X_RSI)
    x64_mov(cb, X_RSI, X_RDX)
    // rep movsb
    xb(cb, 0xF3)
    xb(cb, 0xA4)
    x64_ret(cb)
    x64_land(cb, not4)
    x64_cmp_imm8(cb, X_RDI, -2)
    not2 := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_RAX, X_RBP)
    x64_ret(cb)
    x64_land(cb, not2)
    x64_cmp_imm8(cb, X_RDI, -3)
    not3 := x64_jshort(cb, CC_NE)
    x64_lea_label(cb, relocs, X_RAX, "__xu_start")
    x64_ret(cb)
    x64_land(cb, not3)
    x64_cmp_imm8(cb, X_RDI, -1)
    x64_jcc(cb, relocs, CC_E, "__xu_task_switch")
    x64_mov(cb, X_RAX, X_RDI)
    if linux {
        // rax = table[nr] for 0 <= nr < X64_NR_TABLE, else -1.
        x64_rex(cb, true, 0, X_RAX, false)
        xb(cb, 0x3D)
        cb.emit_u32_le(X64_NR_TABLE)
        unknown := x64_jshort(cb, CC_AE)
        x64_lea_label(cb, relocs, X_R11, "__xu_x64_nr")
        // movsx rax, word [r11 + rax*2]
        xb(cb, 0x49)
        xb(cb, 0x0F)
        xb(cb, 0xBF)
        xb(cb, 0x04)
        xb(cb, 0x43)
        x64_test(cb, X_RAX)
        known := x64_jshort(cb, 9)
        x64_land(cb, unknown)
        // -ENOSYS
        x64_mov_imm(cb, X_RAX, -38)
        x64_ret(cb)
        x64_land(cb, known)
    } else {
        // or rax, 0x2000000
        xb(cb, 0x48)
        xb(cb, 0x0D)
        cb.emit_u32_le(mac_nr)
    }
    x64_mov(cb, X_R11, X_R10)
    x64_mov(cb, X_RDI, X_RSI)
    x64_mov(cb, X_RSI, X_RDX)
    x64_mov(cb, X_RDX, X_RCX)
    x64_mov(cb, X_R10, X_R8)
    x64_mov(cb, X_R8, X_R9)
    x64_mov(cb, X_R9, X_R11)
    x64_syscall_insn(cb)
    if !linux {
        // fork and pipe return a second word in rdx (runtime G_SYS_R1);
        // carry set means rax holds errno.
        x64_str(cb, X_RDX, X_R15, 40)
        ok := x64_jshort(cb, CC_AE)
        x64_rex(cb, true, 0, X_RAX, false)
        xb(cb, 0xF7)
        x64_modrm_rr(cb, 3, X_RAX)
        x64_land(cb, ok)
    }
    x64_ret(cb)
    emit_x64_task_stubs(cb, syms)
    syms.define_label("__xu_globals", cb.len())
    x64_mov(cb, X_RAX, X_R15)
    x64_ret(cb)
    if linux {
        while cb.len() % 2 != 0 {
            xb(cb, 0xCC)
        }
        syms.define_label("__xu_x64_nr", cb.len())
        for n in 0:X64_NR_TABLE {
            cb.emit_u16_le(x64_linux_nr(n) & 0xffff)
        }
    }
    if uses_ffi && emit_object {
        emit_x64_ffi_tramps(cb, syms, relocs, linux)
    }
}

fn x64_lea_ffi_state(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, rd int, emit_object bool) {
    if !emit_object {
        x64_lea_label(cb, relocs, rd, FFI_STATE_LABEL)
        <<
    }
    x64_rex(cb, true, rd, 0, false)
    xb(cb, 0x8D)
    xb(cb, ((rd & 7) << 3) | 5)
    relocs.push(mc.reloc_new(cb.len(), FFI_STATE_LABEL, mc.RELOC_X64_DATA_PC32, 0))
    cb.emit_u32_le(0)
}

fn emit_x64_ffi_tramps(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, linux bool) {
    $pfx := "_"
    if linux { pfx = "" }
    names := ["dlopen", "dlsym", "dlerror"]
    for i in 0:names.len {
        syms.define_label("__xu_ffi_tramp_" + names[i], cb.len())
        x64_jmp(cb, relocs, pfx + names[i])
    }
}

// C FFI pseudo calls, x86-64 System V (layout: runtime/core ffi.xu).
//   -8: call rsi with the call block at rdx: copy the stack words, load
//       rdi..r9, xmm0-xmm7 and al, call, store rax, rdx, xmm0, xmm1 back.
//   -9: address of the loader slots (codegen.FFI_GOT_LABEL).
// r15 (the runtime state) is published for C callbacks first.
fn emit_x64_ffi_calls(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, emit_object bool) {
    x64_cmp_imm8(cb, X_RDI, -8)
    x64_jcc(cb, relocs, CC_NE, "__xu_ffi_not6")
    xb(cb, 0x55) // push rbp
    x64_mov(cb, X_RBP, X_RSP)
    xb(cb, 0x53) // push rbx
    xb(cb, 0x41)
    xb(cb, 0x54) // push r12
    x64_add_rsp(cb, -64)
    for i in 0:8 {
        x64_movsd_st(cb, 8 + i, X_RBP, -80 + i * 8)
    }
    x64_lea_ffi_state(cb, relocs, X_R11, emit_object)
    x64_str(cb, X_R15, X_R11, 0)
    x64_mov(cb, X_RBX, X_RDX)
    x64_mov(cb, X_R12, X_RSI)
    x64_ldr(cb, X_RCX, X_RBX, 128)
    xb(cb, 0x48)
    xb(cb, 0x29)
    xb(cb, 0xCC) // sub rsp, rcx
    x64_ldr(cb, X_RSI, X_RBX, 136)
    x64_mov(cb, X_RDI, X_RSP)
    xb(cb, 0xF3)
    xb(cb, 0xA4) // rep movsb
    for i in 0:8 {
        // movq xmm_i, [rbx + 64 + 8i]
        xb(cb, 0xF3)
        xb(cb, 0x0F)
        xb(cb, 0x7E)
        x64_modrm_mem(cb, i, X_RBX, 64 + i * 8)
    }
    x64_ldr(cb, X_RDI, X_RBX, 0)
    x64_ldr(cb, X_RSI, X_RBX, 8)
    x64_ldr(cb, X_RDX, X_RBX, 16)
    x64_ldr(cb, X_RCX, X_RBX, 24)
    x64_ldr(cb, X_R8, X_RBX, 32)
    x64_ldr(cb, X_R9, X_RBX, 40)
    x64_ldr(cb, X_RAX, X_RBX, 144)
    x64_call_reg(cb, X_R12)
    x64_str(cb, X_RAX, X_RBX, 152)
    x64_str(cb, X_RDX, X_RBX, 160)
    for i in 0:2 {
        // movq [rbx + 168 + 8i], xmm_i
        xb(cb, 0x66)
        xb(cb, 0x0F)
        xb(cb, 0xD6)
        x64_modrm_mem(cb, i, X_RBX, 168 + i * 8)
    }
    for i in 0:8 {
        x64_movsd_ld(cb, 8 + i, X_RBP, -80 + i * 8)
    }
    x64_lea(cb, X_RSP, X_RBP, -16)
    xb(cb, 0x41)
    xb(cb, 0x5C) // pop r12
    xb(cb, 0x5B) // pop rbx
    xb(cb, 0x5D) // pop rbp
    x64_ret(cb)
    syms.define_label("__xu_ffi_not6", cb.len())
    x64_cmp_imm8(cb, X_RDI, -9)
    not7 := x64_jshort(cb, CC_NE)
    x64_lea_ffi_state(cb, relocs, X_R11, emit_object)
    x64_str(cb, X_R15, X_R11, 0)
    if emit_object {
        x64_lea_label(cb, relocs, X_R11, "__xu_ffi_tramp_dlopen")
        x64_str(cb, X_R11, X_R15, FFI_OBJ_GOT_OFFSET)
        x64_lea_label(cb, relocs, X_R11, "__xu_ffi_tramp_dlsym")
        x64_str(cb, X_R11, X_R15, FFI_OBJ_GOT_OFFSET + 8)
        x64_lea_label(cb, relocs, X_R11, "__xu_ffi_tramp_dlerror")
        x64_str(cb, X_R11, X_R15, FFI_OBJ_GOT_OFFSET + 16)
        x64_lea(cb, X_RAX, X_R15, FFI_OBJ_GOT_OFFSET)
    } else {
        x64_lea_label(cb, relocs, X_RAX, FFI_GOT_LABEL)
    }
    x64_ret(cb)
    x64_land(cb, not7)
}

pub fn emit_x64_ffi_slots(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    while cb.len() % 8 != 0 { xb(cb, 0xCC) }
    syms.define_label(FFI_GOT_LABEL, cb.len())
    syms.define_label(FFI_STATE_LABEL, cb.len() + 24)
    for i in 0:4 { cb.emit_u64_le(0) }
}

fn x64_emit_ffi_clos_call(cb $&mc.CodeBuffer) {
    // imulq $24, %r10, %rax
    xb(cb, 0x49)
    xb(cb, 0x6B)
    xb(cb, 0xC2)
    xb(cb, 24)
    x64_lea(cb, X_R11, X_R15, 3072)
    x64_op_rr(cb, 0x01, X_R11, X_RAX)
    x64_lea(cb, X_R11, X_RAX, 8)
    x64_str(cb, X_R11, X_RSP, 200)
    x64_ldr(cb, X_RAX, X_RAX, 0)
    x64_mov(cb, X_RDI, X_RSP)
    x64_call_reg(cb, X_RAX)
}

fn x64_emit_ffi_clos_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    while cb.len() % 16 != 0 { xb(cb, 0xCC) }
    syms.define_label("__xu_ffi_clos_stubs", cb.len())
    for k in 0:64 {
        xb(cb, 0x41)
        xb(cb, 0xBA) // mov r10d, imm32
        cb.emit_u32_le(k)
        x64_jmp(cb, relocs, "__xu_ffi_clos_dispatch")
        for n in 0:5 { xb(cb, 0x90) }
    }
}

fn emit_x64_ffi_thunk_one(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, regs &[]int, label string, adapter string, is_clos bool, emit_object bool) {
    while cb.len() % 16 != 0 { xb(cb, 0xCC) }
    syms.define_label(label + "", cb.len())
    xb(cb, 0x55) // push rbp
    x64_mov(cb, X_RBP, X_RSP)
    xb(cb, 0x53) // push rbx
    xb(cb, 0x41)
    xb(cb, 0x54) // push r12
    xb(cb, 0x41)
    xb(cb, 0x55) // push r13
    xb(cb, 0x41)
    xb(cb, 0x56) // push r14
    xb(cb, 0x41)
    xb(cb, 0x57) // push r15
    x64_add_rsp(cb, -216)
    for i in 0:6 { x64_str(cb, regs[i], X_RSP, i * 8) }
    for i in 0:8 {
        xb(cb, 0x66)
        xb(cb, 0x0F)
        xb(cb, 0xD6)
        x64_modrm_mem(cb, i, X_RSP, 64 + i * 8)
    }
    x64_lea(cb, X_RAX, X_RBP, 16)
    x64_str(cb, X_RAX, X_RSP, 136)
    x64_lea_ffi_state(cb, relocs, X_R15, emit_object)
    x64_ldr(cb, X_R15, X_R15, 0)
    if is_clos {
        x64_emit_ffi_clos_call(cb)
    } else {
        x64_mov(cb, X_RDI, X_RSP)
        x64_call(cb, relocs, adapter + "")
    }
    x64_ldr(cb, X_RAX, X_RSP, 152)
    x64_ldr(cb, X_RDX, X_RSP, 160)
    for i in 0:2 {
        xb(cb, 0xF3)
        xb(cb, 0x0F)
        xb(cb, 0x7E)
        x64_modrm_mem(cb, i, X_RSP, 168 + i * 8)
    }
    x64_lea(cb, X_RSP, X_RBP, -40)
    xb(cb, 0x41)
    xb(cb, 0x5F) // pop r15
    xb(cb, 0x41)
    xb(cb, 0x5E) // pop r14
    xb(cb, 0x41)
    xb(cb, 0x5D) // pop r13
    xb(cb, 0x41)
    xb(cb, 0x5C) // pop r12
    xb(cb, 0x5B) // pop rbx
    xb(cb, 0x5D) // pop rbp
    x64_ret(cb)
}

// C-ABI (System V) entry points for Xu functions passed as C callbacks; see
// emit_arm64_ffi_thunks.
pub fn emit_x64_ffi_thunks(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, thunks &[]string, adapters &[]string, emit_object bool, emit_clos bool) {
    regs := [X_RDI, X_RSI, X_RDX, X_RCX, X_R8, X_R9]
    for t in 0:thunks.len {
        emit_x64_ffi_thunk_one(cb, syms, relocs, &regs, thunks[t] + "", adapters[t] + "", false, emit_object)
    }
    if emit_clos {
        emit_x64_ffi_thunk_one(cb, syms, relocs, &regs, "__xu_ffi_clos_dispatch", "", true, emit_object)
        x64_emit_ffi_clos_stubs(cb, syms, relocs)
    }
}
