@xu/codegen
// Baseline AArch64 instruction selection for typed MIR.
//
// Correctness first: every temp has its own frame slot and every local its
// full width, so no value is ever shared or clobbered. Operands are loaded
// into scratch registers (x9-x12), the result is stored back. Optimizing
// selection can replace this per function once it implements the same
// conventions:
//   - arguments in x0-x7, the rest at [sp + 8*(i-8)] of the caller's
//     outgoing area; scalar result in x0
//   - x28 holds the runtime state block for the whole process
//   - frame: [fp] saved fp/lr, sp = fp - frame; locals and temps at
//     [sp + out_area + offset]

#xu/mir
#xu/mc
#internal/uiabi
#xu/target

const R_FP = 29
const R_LR = 30
const R_SP = 31
const R_IP0 = 16
const R_IP1 = 17
const R_STATE = 28
// Slot 11 in the process-wide layout in runtime/core.
const A64_HWCAP_OFFSET = 88

fn a64_patch_adr(cb $&mc.CodeBuffer, at int, rd int) {
    disp := cb.len() - at
    cb.patch_u32_le(at, 0x10000000 | ((disp & 3) << 29) | ((disp >> 2) << 5) | rd)
}

struct A64Frame {
    out_area int
    size int
    local_off []int
    temp_off []int
}

// ===== encoders =====

fn e32(cb $&mc.CodeBuffer, w int) {
    cb.emit_u32_le(w & 0xffffffff)
}

fn a64_mov_imm(cb $&mc.CodeBuffer, rd int, v int) {
    $nz := 0
    $nn := 0
    for hw in 0:4 {
        chunk := (v >> (16 * hw)) & 0xffff
        if chunk != 0 { nz += 1 }
        if chunk != 0xffff { nn += 1 }
    }
    if nn < nz {
        $first := true
        for hw in 0:4 {
            chunk := (v >> (16 * hw)) & 0xffff
            if chunk != 0xffff {
                inv := chunk ^ 0xffff
                if first {
                    e32(cb, 0x92800000 | (hw << 21) | (inv << 5) | rd)
                    first = false
                } else {
                    e32(cb, 0xF2800000 | (hw << 21) | (chunk << 5) | rd)
                }
            }
        }
        if first {
            e32(cb, 0x92800000 | rd)
        }
        <<
    }
    $first := true
    for hw in 0:4 {
        chunk := (v >> (16 * hw)) & 0xffff
        if chunk != 0 {
            if first {
                e32(cb, 0xD2800000 | (hw << 21) | (chunk << 5) | rd)
                first = false
            } else {
                e32(cb, 0xF2800000 | (hw << 21) | (chunk << 5) | rd)
            }
        }
    }
    if first {
        e32(cb, 0xD2800000 | rd)
    }
}

fn a64_mov(cb $&mc.CodeBuffer, rd int, rm int) {
    e32(cb, 0xAA0003E0 | (rm << 16) | rd)
}

// rd = rn + imm (rn/rd may be sp); imm >= 0.
fn a64_add_imm(cb $&mc.CodeBuffer, rd int, rn int, imm int) {
    if imm < 4096 {
        e32(cb, 0x91000000 | (imm << 10) | (rn << 5) | rd)
        <<
    }
    a64_mov_imm(cb, R_IP0, imm)
    e32(cb, 0x8B206000 | (R_IP0 << 16) | (rn << 5) | rd)
}

fn a64_sub_sp(cb $&mc.CodeBuffer, imm int) {
    if imm < 4096 {
        e32(cb, 0xD1000000 | (imm << 10) | (R_SP << 5) | R_SP)
        <<
    }
    a64_mov_imm(cb, R_IP0, imm)
    e32(cb, 0xCB206000 | (R_IP0 << 16) | (R_SP << 5) | R_SP)
}

// Load/store of width 1, 2, 4 or 8 bytes at [rn + off].
fn a64_mem(cb $&mc.CodeBuffer, store bool, width_code int, rt int, rn int, off int) {
    $width := width_code
    $scaled := off
    $base_imm := 0xF9400000
    $base_reg := 0xF8606800
    if width_code == -4 {
        width = 4
        scaled = off / 4
        base_imm = 0xB9800000
        base_reg = 0xB8A06800
        if store {
            base_imm = 0xB9000000
            base_reg = 0xB8206800
        }
    } else if width == 1 {
        base_imm = 0x39400000
        base_reg = 0x38606800
    } else if width == 2 {
        base_imm = 0x79400000
        base_reg = 0x78606800
        scaled = off / 2
    } else if width == 4 {
        base_imm = 0xB9400000
        base_reg = 0xB8606800
        scaled = off / 4
    } else {
        scaled = off / 8
    }
    if store && width_code != -4 {
        base_imm = base_imm & 0xFFBFFFFF
        base_reg = base_reg & 0xFFBFFFFF
    }
    if off >= 0 && off % width == 0 && scaled < 4096 {
        e32(cb, base_imm | (scaled << 10) | (rn << 5) | rt)
        <<
    }
    a64_mov_imm(cb, R_IP1, off)
    e32(cb, base_reg | (R_IP1 << 16) | (rn << 5) | rt)
}

fn a64_ldr(cb $&mc.CodeBuffer, rt int, rn int, off int) {
    a64_mem(cb, false, 8, rt, rn, off)
}

fn a64_mem_idx(cb $&mc.CodeBuffer, store bool, width_code int, rt int, rn int, rm int, shift_s int) {
    $base_reg := 0xF8606800
    if width_code == -4 {
        if store { base_reg = 0xB8206800 }
        else { base_reg = 0xB8A06800 }
    } else if width_code == 1 {
        base_reg = 0x38606800
        if store { base_reg = base_reg & 0xFFBFFFFF }
    } else if width_code == 2 {
        base_reg = 0x78606800
        if store { base_reg = base_reg & 0xFFBFFFFF }
    } else if width_code == 4 {
        base_reg = 0xB8606800
        if store { base_reg = base_reg & 0xFFBFFFFF }
    } else {
        if store { base_reg = base_reg & 0xFFBFFFFF }
    }
    if shift_s > 0 {
        base_reg = base_reg | 0x1000
    }
    e32(cb, base_reg | (rm << 16) | (rn << 5) | rt)
}

fn a64_str(cb $&mc.CodeBuffer, rt int, rn int, off int) {
    a64_mem(cb, true, 8, rt, rn, off)
}

fn a64_rrr(cb $&mc.CodeBuffer, base int, rd int, rn int, rm int) {
    e32(cb, base | (rm << 16) | (rn << 5) | rd)
}

fn a64_cmp(cb $&mc.CodeBuffer, rn int, rm int) {
    e32(cb, 0xEB00001F | (rm << 16) | (rn << 5))
}

fn a64_cset(cb $&mc.CodeBuffer, rd int, cond int) {
    e32(cb, 0x9A9F07E0 | ((cond ^ 1) << 12) | rd)
}

fn a64_branch_reloc(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, word int, label string, kind int) {
    off := cb.len()
    e32(cb, word)
    relocs.push(mc.reloc_new(off, label + "", kind, 0))
}

// rd = run-time address of label: adr of this point plus a link-time
// displacement literal (ABS64 with addend -here yields label - here).
fn a64_fn_addr(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, rd int, label string) {
    here := cb.len()
    e32(cb, 0x10000000 | rd)
    e32(cb, 0x58000040 | R_IP0)
    e32(cb, 0x14000003)
    relocs.push(mc.reloc_new(cb.len(), label + "", mc.RELOC_ABS64, 0 - here))
    e32(cb, 0)
    e32(cb, 0)
    a64_rrr(cb, 0x8B000000, rd, rd, R_IP0)
}

// ===== frame =====

fn a64_frame(f &mir.MFn) A64Frame {
    << frame_layout(f, 8)
}

fn a64_frame_ra(f &mir.MFn, ra &RaInfo, opt bool) A64Frame {
    << frame_layout_ra(f, 8, ra, opt)
}

fn frame_layout_ra(f &mir.MFn, reg_args int, ra &RaInfo, opt bool) A64Frame {
    $max_args := 0
    for i in 0:f.instrs.len {
        if f.instrs[i].kind == mir.MI_CALL || f.instrs[i].kind == mir.MI_CALL_IND {
            $n := 0
            $a := f.instrs[i].c
            while a >= 0 {
                n += 1
                a = f.margs[a].next
            }
            if n > max_args {
                max_args = n
            }
        }
    }
    $out_area := 0
    if max_args > reg_args {
        out_area = (max_args - reg_args) * 8
    }
    $off := out_area
    $local_used := []bool{}
    for i in 0:f.locals.len {
        local_used.push(!opt || i < f.nparams)
    }
    if opt {
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                if (k == mir.MI_ADDR || k == mir.MI_LOAD_LOCAL) && ins.b >= 0 && ins.b < local_used.len {
                    local_used[ins.b] = true
                } else if k == mir.MI_STORE_LOCAL && ins.a >= 0 && ins.a < local_used.len {
                    local_used[ins.a] = true
                }
                ii = ins.next
            }
        }
    }
    $loffs := []int{}
    for i in 0:f.locals.len {
        $n := 1
        if i < f.locals_nslots.len && f.locals_nslots[i] > 1 {
            n = f.locals_nslots[i]
        }
        if opt && (!local_used[i] || (i < ra.local_reg.len && ra.local_reg[i] >= 0 && n <= 1)) {
            loffs.push(-1)
        } else {
            loffs.push(off)
            off += n * 8
        }
    }
    $uses := []int{}
    if opt {
        uses = temp_use_counts(f)
    }
    $toffs := []int{}
    for i in 0:f.temps.len {
        $in_reg := opt && i < ra.temp_reg.len && ra.temp_reg[i] >= 0
        $is_dead := opt && i < uses.len && uses[i] == 0
        $is_remat := opt && ((i < ra.remat_addr.len && ra.remat_addr[i] >= 0) || (i < ra.remat_const.len && ra.remat_const[i] >= 0))
        if in_reg || is_dead || is_remat {
            toffs.push(-1)
        } else {
            $ns := 1
            if i < f.temps_nslots.len && f.temps_nslots[i] > 1 {
                ns = f.temps_nslots[i]
            }
            if ns > 1 && (off % 16) != 0 {
                off += 8
            }
            toffs.push(off)
            off += ns * 8
        }
    }
    size := (off + 15) / 16 * 16
    << A64Frame{out_area: out_area, size: size, local_off: loffs, temp_off: toffs}
}

// The frame for a backend passing the first reg_args arguments in
// registers and the rest in the caller's outgoing area.
fn frame_layout(f &mir.MFn, reg_args int) A64Frame {
    empty_ra := ra_none(f)
    << frame_layout_ra(f, reg_args, &empty_ra, false)
}

// Frame-pointer-relative offset of each local (both backends share the
// layout: sp = fp - frame size).
pub fn frame_local_fp_offsets(f &mir.MFn) []int {
    fr := a64_frame(f)
    $out := []int{}
    for i in 0:fr.local_off.len {
        out.push(fr.local_off[i] - fr.size)
    }
    << out
}

// Operand (temp or constant) into register rd.
fn a64_operand(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, rd int, v int) {
    if v <= -2 {
        a64_mov_imm(cb, rd, f.consts[0 - v - 2])
        <<
    }
    if v >= 0 && v < fr.temp_off.len {
        if v < ra.remat_addr.len && ra.remat_addr[v] >= 0 {
            a64_add_imm(cb, rd, R_SP, fr.local_off[ra.remat_addr[v]])
            <<
        }
        if v < ra.remat_const.len && ra.remat_const[v] >= 0 {
            a64_mov_imm(cb, rd, f.consts[ra.remat_const[v]])
            <<
        }
        if fr.temp_off[v] >= 0 {
            a64_ldr(cb, rd, R_SP, fr.temp_off[v])
        }
        <<
    }
    a64_mov_imm(cb, rd, 0)
}

fn a64_set_temp(cb $&mc.CodeBuffer, fr &A64Frame, t int, rs int) {
    if t >= 0 && t < fr.temp_off.len {
        if fr.temp_off[t] >= 0 {
            a64_str(cb, rs, R_SP, fr.temp_off[t])
        }
    }
}

fn a64_fmov_dx(cb $&mc.CodeBuffer, fd int, xn int) {
    e32(cb, 0x9E670000 | (xn << 5) | fd)
}

fn a64_fmov_xd(cb $&mc.CodeBuffer, xd int, fx int) {
    e32(cb, 0x9E660000 | (fx << 5) | xd)
}

fn a64_fmov_dd(cb $&mc.CodeBuffer, fd int, fx int) {
    e32(cb, 0x1E604000 | (fx << 5) | fd)
}

fn a64_fmem(cb $&mc.CodeBuffer, store bool, dt int, rn int, off int) {
    if off >= 0 && off % 8 == 0 && off / 8 < 4096 {
        $base_imm := 0xFD400000
        if store { base_imm = 0xFD000000 }
        e32(cb, base_imm | ((off / 8) << 10) | (rn << 5) | dt)
        <<
    }
    a64_mov_imm(cb, R_IP1, off)
    $base_reg := 0xFC606800
    if store { base_reg = 0xFC206800 }
    e32(cb, base_reg | (R_IP1 << 16) | (rn << 5) | dt)
}

fn a64_qmov(cb $&mc.CodeBuffer, vd int, vn int) {
    if vd != vn {
        e32(cb, 0x4EA01C00 | (vn << 16) | (vn << 5) | vd)
    }
}

fn a64_qmem(cb $&mc.CodeBuffer, store bool, vt int, rn int, off int) {
    if off >= 0 && (off & 15) == 0 && (off >> 4) < 4096 {
        $opc := 0x3DC00000
        if store { opc = 0x3D800000 }
        e32(cb, opc | ((off >> 4) << 10) | (rn << 5) | vt)
        <<
    }
    if off >= -256 && off <= 255 {
        $opc := 0x3CC00000
        if store { opc = 0x3C800000 }
        e32(cb, opc | ((off & 511) << 12) | (rn << 5) | vt)
        <<
    }
    a64_mov_imm(cb, R_IP1, off)
    $opc := 0x3CE06800
    if store { opc = 0x3CA06800 }
    e32(cb, opc | (R_IP1 << 16) | (rn << 5) | vt)
}

fn a64_vsrc(cb $&mc.CodeBuffer, fr &A64Frame, ra &RaInfo, v int, v_scratch int) int {
    r := a64_temp_reg(ra, v)
    if r >= 32 {
        << r - 32
    }
    if v >= 0 && v < fr.temp_off.len && fr.temp_off[v] >= 0 {
        a64_qmem(cb, false, v_scratch, R_SP, fr.temp_off[v])
    }
    << v_scratch
}

fn a64_vdst(ra &RaInfo, t int, v_scratch int) int {
    r := a64_temp_reg(ra, t)
    if r >= 32 {
        << r - 32
    }
    << v_scratch
}

fn a64_vput(cb $&mc.CodeBuffer, fr &A64Frame, ra &RaInfo, t int, vs int) {
    r := a64_temp_reg(ra, t)
    if r >= 32 {
        a64_qmov(cb, r - 32, vs)
        <<
    }
    if t >= 0 && t < fr.temp_off.len && fr.temp_off[t] >= 0 {
        a64_qmem(cb, true, vs, R_SP, fr.temp_off[t])
    }
}

fn a64_vbin(cb $&mc.CodeBuffer, op int, vd int, vn int, vm int) {
    $opc := 0x6E201C00 // EOR.16B
    if op == mir.BIN_FADD { opc = 0x4E60D400 }
    else if op == mir.BIN_FSUB { opc = 0x4EE0D400 }
    else if op == mir.BIN_FMUL { opc = 0x6E60DC00 }
    else if op == mir.BIN_FDIV { opc = 0x6E60FC00 }
    else if op == mir.BIN_ADD { opc = 0x4EE08400 }
    else if op == mir.BIN_SUB { opc = 0x6EE08400 }
    else if op == mir.BIN_AND { opc = 0x4E201C00 }
    else if op == mir.BIN_OR { opc = 0x4EA01C00 }
    a64_rrr(cb, opc, vd, vn, vm)
}

// rd = rn op rm on f64 bit patterns, through d0/d1.
fn a64_fbin(cb $&mc.CodeBuffer, op int, rd int, rn int, rm int) {
    e32(cb, 0x9E670000 | (rn << 5) | 0)
    e32(cb, 0x9E670000 | (rm << 5) | 1)
    if op <= mir.BIN_FDIV {
        $base := 0x1E602800
        if op == mir.BIN_FSUB { base = 0x1E603800 }
        else if op == mir.BIN_FMUL { base = 0x1E600800 }
        else if op == mir.BIN_FDIV { base = 0x1E601800 }
        a64_rrr(cb, base, 0, 0, 1)
        e32(cb, 0x9E660000 | (0 << 5) | rd)
        <<
    }
    // fcmp d0, d1; MI/LS keep unordered results false.
    e32(cb, 0x1E602000 | (1 << 16) | (0 << 5))
    $cond := target.ARM64_COND_EQ
    if op == mir.BIN_FNE { cond = target.ARM64_COND_NE }
    else if op == mir.BIN_FLT { cond = target.ARM64_COND_MI }
    else if op == mir.BIN_FLE { cond = target.ARM64_COND_LS }
    else if op == mir.BIN_FGT { cond = target.ARM64_COND_GT }
    else if op == mir.BIN_FGE { cond = target.ARM64_COND_GE }
    a64_cset(cb, rd, cond)
}

// rd = conversion of rn (scvtf / fcvtzs through d0).
fn a64_un(cb $&mc.CodeBuffer, op int, rd int, rn int) {
    if op == mir.UN_I2F {
        e32(cb, 0x9E620000 | (rn << 5) | 0)
        e32(cb, 0x9E660000 | (0 << 5) | rd)
    } else if op == mir.UN_F2I {
        e32(cb, 0x9E670000 | (rn << 5) | 0)
        e32(cb, 0x9E780000 | (0 << 5) | rd)
    } else if op == mir.UN_FSQRT {
        e32(cb, 0x9E670000 | (rn << 5) | 0)
        e32(cb, 0x1E61C000 | (0 << 5) | 0)
        e32(cb, 0x9E660000 | (0 << 5) | rd)
    } else {
        e32(cb, 0xD4200000)
    }
}

// rd = rn op rm (x11 is scratch for MOD; MULH is smulh).
fn a64_bin(cb $&mc.CodeBuffer, op int, rd int, rn int, rm int) {
    if op >= mir.BIN_FADD && op <= mir.BIN_FGE {
        a64_fbin(cb, op, rd, rn, rm)
        <<
    }
    if op == mir.BIN_ADD { a64_rrr(cb, 0x8B000000, rd, rn, rm) }
    else if op == mir.BIN_SUB { a64_rrr(cb, 0xCB000000, rd, rn, rm) }
    else if op == mir.BIN_MUL { a64_rrr(cb, 0x9B007C00, rd, rn, rm) }
    else if op == mir.BIN_DIV { a64_rrr(cb, 0x9AC00C00, rd, rn, rm) }
    else if op == mir.BIN_MOD {
        a64_rrr(cb, 0x9AC00C00, 11, rn, rm)
        // msub rd, x11, rm, rn
        e32(cb, 0x9B008000 | (rm << 16) | (rn << 10) | (11 << 5) | rd)
    }
    else if op == mir.BIN_AND { a64_rrr(cb, 0x8A000000, rd, rn, rm) }
    else if op == mir.BIN_OR { a64_rrr(cb, 0xAA000000, rd, rn, rm) }
    else if op == mir.BIN_XOR { a64_rrr(cb, 0xCA000000, rd, rn, rm) }
    else if op == mir.BIN_SHL { a64_rrr(cb, 0x9AC02000, rd, rn, rm) }
    else if op == mir.BIN_SHR { a64_rrr(cb, 0x9AC02800, rd, rn, rm) }
    else if op == mir.BIN_MULH { a64_rrr(cb, 0x9B407C00, rd, rn, rm) }
    else if op == mir.BIN_MULH_U { a64_rrr(cb, 0x9BC07C00, rd, rn, rm) }
    else if op == mir.BIN_ROTR32 { a64_rrr(cb, 0x1AC02C00, rd, rn, rm) }
    else if op == mir.BIN_ROTR64 { a64_rrr(cb, 0x9AC02C00, rd, rn, rm) }
    else {
        a64_cmp(cb, rn, rm)
        $cond := target.ARM64_COND_EQ
        if op == mir.BIN_NE { cond = target.ARM64_COND_NE }
        else if op == mir.BIN_LT { cond = target.ARM64_COND_LT }
        else if op == mir.BIN_LE { cond = target.ARM64_COND_LE }
        else if op == mir.BIN_GT { cond = target.ARM64_COND_GT }
        else if op == mir.BIN_GE { cond = target.ARM64_COND_GE }
        a64_cset(cb, rd, cond)
    }
}

// ===== allocated values =====

fn a64_temp_reg(ra &RaInfo, v int) int {
    if v >= 0 && v < ra.temp_reg.len {
        << ra.temp_reg[v]
    }
    << -1
}

// The register holding operand v: its own, or scratch loaded with it.
fn a64_src(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, v int, scratch int) int {
    r := a64_temp_reg(ra, v)
    if r >= 0 && r < 32 {
        << r
    }
    if r >= 32 {
        a64_fmov_xd(cb, scratch, r - 32)
        << scratch
    }
    a64_operand(cb, f, fr, ra, scratch, v)
    << scratch
}

fn a64_fp64_imm8(c int) int {
    if (c & 281474976710655) != 0 { << -1 }
    biased := (c >> 52) & 0x7FF
    if biased < 1020 || biased > 1027 { << -1 }
    $sign := 0
    if c < 0 { sign = 128 }
    << sign | ((biased & 7) << 4) | ((c >> 48) & 15)
}

// Operand v into register rd (GPR < 32 or FPR >= 32).
fn a64_load_to(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, rd int, v int) {
    r := a64_temp_reg(ra, v)
    if rd >= 32 {
        fd := rd - 32
        if r >= 32 {
            if r != rd {
                a64_fmov_dd(cb, fd, r - 32)
            }
        } else if r >= 0 {
            a64_fmov_dx(cb, fd, r)
        } else if v <= -2 && f.consts[0 - v - 2] == 0 {
            a64_fmov_dx(cb, fd, 31)
        } else if v >= 0 && v < ra.remat_const.len && ra.remat_const[v] >= 0 {
            c := f.consts[ra.remat_const[v]]
            if c == 0 {
                a64_fmov_dx(cb, fd, 31)
            } else {
                imm8 := a64_fp64_imm8(c)
                if imm8 >= 0 {
                    e32(cb, 0x1E601000 | (imm8 << 13) | fd)
                } else {
                    a64_mov_imm(cb, 9, c)
                    a64_fmov_dx(cb, fd, 9)
                }
            }
        } else if v >= 0 && v < fr.temp_off.len {
            if fr.temp_off[v] >= 0 {
                a64_fmem(cb, false, fd, R_SP, fr.temp_off[v])
            }
        } else if v <= -2 {
            imm8 := a64_fp64_imm8(f.consts[0 - v - 2])
            if imm8 >= 0 {
                e32(cb, 0x1E601000 | (imm8 << 13) | fd)
            } else {
                a64_mov_imm(cb, 9, f.consts[0 - v - 2])
                a64_fmov_dx(cb, fd, 9)
            }
        } else {
            a64_fmov_dx(cb, fd, 31)
        }
        <<
    }
    if r >= 0 && r < 32 {
        if r != rd {
            a64_mov(cb, rd, r)
        }
        <<
    }
    if r >= 32 {
        a64_fmov_xd(cb, rd, r - 32)
        <<
    }
    a64_operand(cb, f, fr, ra, rd, v)
}

// The GPR to compute temp t into.
fn a64_dst(ra &RaInfo, t int, scratch int) int {
    r := a64_temp_reg(ra, t)
    if r >= 0 && r < 32 {
        << r
    }
    << scratch
}

// Temp t now has its value in register rs (GPR < 32 or FPR >= 32).
fn a64_put(cb $&mc.CodeBuffer, fr &A64Frame, ra &RaInfo, t int, rs int) {
    if t < 0 {
        <<
    }
    r := a64_temp_reg(ra, t)
    if r >= 32 {
        fd := r - 32
        if rs >= 32 {
            if r != rs {
                a64_fmov_dd(cb, fd, rs - 32)
            }
        } else {
            a64_fmov_dx(cb, fd, rs)
        }
        <<
    }
    if r >= 0 {
        if rs >= 32 {
            a64_fmov_xd(cb, r, rs - 32)
        } else if r != rs {
            a64_mov(cb, r, rs)
        }
        <<
    }
    if rs >= 32 {
        if t < fr.temp_off.len && fr.temp_off[t] >= 0 {
            a64_fmem(cb, true, rs - 32, R_SP, fr.temp_off[t])
        }
        <<
    }
    a64_set_temp(cb, fr, t, rs)
}

fn a64_fsrc(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, v int, d_scratch int) int {
    r := a64_temp_reg(ra, v)
    if r >= 32 {
        << r - 32
    }
    a64_load_to(cb, f, fr, ra, 32 + d_scratch, v)
    << d_scratch
}

fn a64_fdst(ra &RaInfo, t int, d_scratch int) int {
    r := a64_temp_reg(ra, t)
    if r >= 32 {
        << r - 32
    }
    << d_scratch
}

fn a64_fcond_of(op int) int {
    if op == mir.BIN_FNE { << target.ARM64_COND_NE }
    if op == mir.BIN_FLT { << target.ARM64_COND_MI }
    if op == mir.BIN_FLE { << target.ARM64_COND_LS }
    if op == mir.BIN_FGT { << target.ARM64_COND_GT }
    if op == mir.BIN_FGE { << target.ARM64_COND_GE }
    << target.ARM64_COND_EQ
}

fn a64_is_fcmp(op int) bool {
    << op >= mir.BIN_FEQ && op <= mir.BIN_FGE
}

fn a64_fneg_operand(f &mir.MFn, ra &RaInfo, ins &mir.MInstr) int {
    if ins.b != mir.BIN_XOR {
        << -1
    }
    sb := -9223372036854775807 - 1
    $val := -1
    if ins.d <= -2 && f.consts[0 - ins.d - 2] == sb {
        val = ins.c
    } else if ins.c <= -2 && f.consts[0 - ins.c - 2] == sb {
        val = ins.d
    } else {
        << -1
    }
    if a64_temp_reg(ra, ins.a) >= 32 || a64_temp_reg(ra, val) >= 32 {
        << val
    }
    << -1
}

fn a64_fabs_operand(f &mir.MFn, ra &RaInfo, ins &mir.MInstr) int {
    if ins.b != mir.BIN_AND {
        << -1
    }
    am := 9223372036854775807
    $val := -1
    if ins.d <= -2 && f.consts[0 - ins.d - 2] == am {
        val = ins.c
    } else if ins.c <= -2 && f.consts[0 - ins.c - 2] == am {
        val = ins.d
    } else {
        << -1
    }
    if a64_temp_reg(ra, ins.a) >= 32 || a64_temp_reg(ra, val) >= 32 {
        << val
    }
    << -1
}

fn a64_cond_of(op int) int {
    if op == mir.BIN_NE { << target.ARM64_COND_NE }
    if op == mir.BIN_LT { << target.ARM64_COND_LT }
    if op == mir.BIN_LE { << target.ARM64_COND_LE }
    if op == mir.BIN_GT { << target.ARM64_COND_GT }
    if op == mir.BIN_GE { << target.ARM64_COND_GE }
    << target.ARM64_COND_EQ
}

fn a64_is_icmp(op int) bool {
    << op >= mir.BIN_EQ && op <= mir.BIN_GE
}

fn a64_u64_shr(x int, k int) int {
    if k <= 0 { << x }
    if k >= 64 { << 0 }
    if k == 1 { << (x >> 1) & 9223372036854775807 }
    << (x >> k) & ((1 << (64 - k)) - 1)
}

fn a64_encode_bitmask64(v int) int {
    if v == 0 || v == -1 { << -1 }
    $sz := 64
    $p := v
    hi32 := a64_u64_shr(p, 32)
    lo32 := p & 4294967295
    if hi32 == lo32 {
        sz = 32
        p = lo32
        while sz > 2 {
            half := sz / 2
            mask := (1 << half) - 1
            if (p & mask) == ((p >> half) & mask) {
                sz = half
                p = p & mask
            } else {
                <-
            }
        }
    }
    $immr := 0
    $ones := 0
    if (p & 1) == 0 {
        $tz := 1
        while tz < sz && ((p >> tz) & 1) == 0 {
            tz += 1
        }
        if tz >= sz { << -1 }
        q := a64_u64_shr(p, tz)
        if (q & (q + 1)) != 0 { << -1 }
        while (q >> ones) != 0 { ones += 1 }
        immr = (sz - tz) & (sz - 1)
    } else {
        $emask := -1
        if sz < 64 { emask = (1 << sz) - 1 }
        np := p ^ emask
        if np == 0 { << -1 }
        $tz := 1
        while tz < sz && ((np >> tz) & 1) == 0 {
            tz += 1
        }
        if tz >= sz { << -1 }
        q := a64_u64_shr(np, tz)
        if (q & (q + 1)) != 0 { << -1 }
        $zeros := 0
        while (q >> zeros) != 0 { zeros += 1 }
        ones = sz - zeros
        start1 := (tz + zeros) & (sz - 1)
        immr = (sz - start1) & (sz - 1)
    }
    if ones < 1 || ones >= sz { << -1 }
    $nbit := 0
    $imms := 0
    if sz == 64 {
        nbit = 1
        imms = ones - 1
    } else {
        imms = ((64 - sz * 2) & 63) | (ones - 1)
    }
    << (nbit << 12) | (immr << 6) | imms
}

// Encode non-negative 12-bit immediate (unshifted or lsl #12) into bits [22:10], or -1.
fn a64_imm12_enc(cv int) int {
    if cv >= 0 && cv < 4096 {
        << cv << 10
    }
    if cv > 0 && (cv & 4095) == 0 && (cv >> 12) <= 4095 {
        << (1 << 22) | ((cv >> 12) << 10)
    }
    << -1
}

fn a64_can_cmp_imm(f &mir.MFn, v int) bool {
    if v <= -2 {
        c := f.consts[0 - v - 2]
        if a64_imm12_enc(c) >= 0 { << true }
        if c < 0 && c >= -16773120 && a64_imm12_enc(0 - c) >= 0 { << true }
    }
    << false
}

// cmp c, d using the immediate form when d allows it.
fn a64_cmp_vals(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, c int, d int) {
    rn := a64_src(cb, f, fr, ra, c, 9)
    if d <= -2 {
        cv := f.consts[0 - d - 2]
        enc := a64_imm12_enc(cv)
        if enc >= 0 {
            e32(cb, 0xF100001F | enc | (rn << 5))
            <<
        }
        if cv < 0 && cv >= -16773120 {
            nenc := a64_imm12_enc(0 - cv)
            if nenc >= 0 {
                e32(cb, 0xB100001F | nenc | (rn << 5))
                <<
            }
        }
    }
    rm := a64_src(cb, f, fr, ra, d, 10)
    a64_cmp(cb, rn, rm)
}

fn a64_mul_pow2_plus1(cv int) int {
    if cv <= 2 { << -1 }
    p := cv - 1
    if (p & (p - 1)) != 0 { << -1 }
    $k := 0
    $v := p
    while v > 1 {
        v = v >> 1
        k += 1
    }
    if k >= 1 && k <= 62 { << k }
    << -1
}

fn a64_feeds_select(f &mir.MFn, idx_mode &[]int, ii int, cond_t int, need_uses int) bool {
    if need_uses <= 0 {
        << false
    }
    $matched := 0
    $ni := f.instrs[ii].next
    while ni >= 0 {
        if ni < idx_mode.len && idx_mode[ni] == 1 {
            if f.instrs[ni].a == cond_t { << false }
            ni = f.instrs[ni].next
            ->
        }
        nk := f.instrs[ni].kind
        if nk == mir.MI_SELECT {
            if f.instrs[ni].b != cond_t || f.instrs[ni].c == cond_t || f.instrs[ni].d == cond_t || f.instrs[ni].a == cond_t {
                << false
            }
            matched += 1
            if matched == need_uses {
                << true
            }
            ni = f.instrs[ni].next
            ->
        }
        // Only skip instructions guaranteed not to modify NZCV flags or read/write cond_t.
        if nk == mir.MI_NOP {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_STORE_LOCAL && f.instrs[ni].b != cond_t {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_LOAD_LOCAL && f.instrs[ni].a != cond_t {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_COPY && f.instrs[ni].a != cond_t && f.instrs[ni].b != cond_t {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_BIN &&
                  (f.instrs[ni].b == mir.BIN_ADD || f.instrs[ni].b == mir.BIN_SUB ||
                   f.instrs[ni].b == mir.BIN_MUL || f.instrs[ni].b == mir.BIN_SHL ||
                   f.instrs[ni].b == mir.BIN_SHR || f.instrs[ni].b == mir.BIN_AND ||
                   f.instrs[ni].b == mir.BIN_OR || f.instrs[ni].b == mir.BIN_XOR) &&
                  f.instrs[ni].a != cond_t && f.instrs[ni].c != cond_t && f.instrs[ni].d != cond_t {
            ni = f.instrs[ni].next
        } else {
            << false
        }
    }
    << false
}

fn a64_feeds_branch(f &mir.MFn, idx_mode &[]int, ii int, cond_t int) bool {
    $ni := f.instrs[ii].next
    while ni >= 0 {
        if ni < idx_mode.len && idx_mode[ni] == 4 {
            << false
        }
        if ni < idx_mode.len && idx_mode[ni] == 1 {
            if f.instrs[ni].a == cond_t { << false }
            ni = f.instrs[ni].next
            ->
        }
        nk := f.instrs[ni].kind
        if nk == mir.MI_NOP {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_STORE_LOCAL && f.instrs[ni].b != cond_t {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_LOAD_LOCAL && f.instrs[ni].a != cond_t {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_COPY && f.instrs[ni].a != cond_t && f.instrs[ni].b != cond_t {
            ni = f.instrs[ni].next
        } else if nk == mir.MI_BIN &&
                  (f.instrs[ni].b == mir.BIN_ADD || f.instrs[ni].b == mir.BIN_SUB ||
                   f.instrs[ni].b == mir.BIN_MUL || f.instrs[ni].b == mir.BIN_SHL ||
                   f.instrs[ni].b == mir.BIN_SHR || f.instrs[ni].b == mir.BIN_AND ||
                   f.instrs[ni].b == mir.BIN_OR || f.instrs[ni].b == mir.BIN_XOR) &&
                  f.instrs[ni].a != cond_t && f.instrs[ni].c != cond_t && f.instrs[ni].d != cond_t {
            ni = f.instrs[ni].next
        } else {
            << false
        }
    }
    << true
}

fn a64_can_bin_imm(f &mir.MFn, op int, d int) bool {
    if d > -2 { << false }
    cv := f.consts[0 - d - 2]
    if op == mir.BIN_ADD || op == mir.BIN_SUB {
        << a64_imm12_enc(cv) >= 0 || (cv < 0 && cv >= -16773120 && a64_imm12_enc(0 - cv) >= 0)
    }
    if op == mir.BIN_MUL {
        << a64_mul_pow2_plus1(cv) > 0
    }
    if op == mir.BIN_SHL || op == mir.BIN_SHR || op == mir.BIN_ROTR32 || op == mir.BIN_ROTR64 {
        << true
    }
    if op == mir.BIN_AND && cv == 4294967295 {
        << true
    }
    if op == mir.BIN_XOR && cv == -1 {
        << true
    }
    if op == mir.BIN_AND || op == mir.BIN_OR || op == mir.BIN_XOR {
        << a64_encode_bitmask64(cv) >= 0
    }
    << false
}

// Integer op with a constant right operand as one instruction; false when
// no such form applies.
fn a64_bin_imm(cb $&mc.CodeBuffer, f &mir.MFn, op int, rd int, rn int, d int) bool {
    if d > -2 { << false }
    cv := f.consts[0 - d - 2]
    if op == mir.BIN_ADD {
        enc := a64_imm12_enc(cv)
        if enc >= 0 {
            e32(cb, 0x91000000 | enc | (rn << 5) | rd)
            << true
        }
        if cv < 0 && cv >= -16773120 {
            nenc := a64_imm12_enc(0 - cv)
            if nenc >= 0 {
                e32(cb, 0xD1000000 | nenc | (rn << 5) | rd)
                << true
            }
        }
    }
    if op == mir.BIN_SUB {
        enc := a64_imm12_enc(cv)
        if enc >= 0 {
            e32(cb, 0xD1000000 | enc | (rn << 5) | rd)
            << true
        }
        if cv < 0 && cv >= -16773120 {
            nenc := a64_imm12_enc(0 - cv)
            if nenc >= 0 {
                e32(cb, 0x91000000 | nenc | (rn << 5) | rd)
                << true
            }
        }
    }
    if op == mir.BIN_MUL {
        k := a64_mul_pow2_plus1(cv)
        if k > 0 {
            // add rd, rn, rn, lsl #k
            e32(cb, 0x8B000000 | (rn << 16) | (k << 10) | (rn << 5) | rd)
            << true
        }
    }
    if op == mir.BIN_SHL || op == mir.BIN_SHR {
        sh := cv & 63
        if op == mir.BIN_SHR {
            // asr rd, rn, #sh
            e32(cb, 0x9340FC00 | (sh << 16) | (rn << 5) | rd)
        } else {
            // lsl rd, rn, #sh
            e32(cb, 0xD3400000 | (((64 - sh) & 63) << 16) | ((63 - sh) << 10) | (rn << 5) | rd)
        }
        << true
    }
    if op == mir.BIN_ROTR32 {
        k := cv & 31
        if k == 0 {
            e32(cb, 0x2A0003E0 | (rn << 16) | rd)
        } else {
            e32(cb, 0x13800000 | (rn << 16) | (k << 10) | (rn << 5) | rd)
        }
        << true
    }
    if op == mir.BIN_ROTR64 {
        k := cv & 63
        if k == 0 {
            a64_mov(cb, rd, rn)
        } else {
            e32(cb, 0x93C00000 | (rn << 16) | (k << 10) | (rn << 5) | rd)
        }
        << true
    }
    if op == mir.BIN_AND && cv == 4294967295 {
        e32(cb, 0x2A0003E0 | (rn << 16) | rd)
        << true
    }
    if op == mir.BIN_XOR && cv == -1 {
        e32(cb, 0xAA2003E0 | (rn << 16) | rd)
        << true
    }
    if op == mir.BIN_AND || op == mir.BIN_OR || op == mir.BIN_XOR {
        enc := a64_encode_bitmask64(cv)
        if enc >= 0 {
            $opc := 0x92000000
            if op == mir.BIN_OR { opc = 0xB2000000 }
            else if op == mir.BIN_XOR { opc = 0xD2000000 }
            e32(cb, opc | (enc << 10) | (rn << 5) | rd)
            << true
        }
    }
    << false
}

// Count trailing 1-bits when m == (1 << w) - 1 with 1 <= w <= 62, else 0.
fn a64_mask_ones(m int) int {
    if m <= 0 || (m & (m + 1)) != 0 {
        << 0
    }
    $w := 0
    $v := m
    while v != 0 {
        v = v >> 1
        w += 1
    }
    << w
}

// Two adjacent instructions done as one, the first's result read only by
// the second: 1 for sub-asr63, 2 for integer msub, 3 for fp fmadd,
// 4 for fp fmsub, 5 for integer madd, 6 for 32-bit masked ALU,
// 7 for ubfx, 8 for bic/orn/eon. 0 otherwise.
fn a64_fuse2(f &mir.MFn, ins &mir.MInstr, uses &[]int, idx_mode &[]int) int {
    if ins.kind != mir.MI_BIN || ins.a < 0 || ins.a >= uses.len || uses[ins.a] != 1 || ins.next < 0 {
        << 0
    }
    if ins.next < idx_mode.len && idx_mode[ins.next] != 0 {
        << 0
    }
    nx := ~f.instrs[ins.next]
    if nx.kind != mir.MI_BIN {
        << 0
    }
    if ins.b == mir.BIN_SHR && ins.c >= 0 && ins.d <= -2 && nx.b == mir.BIN_AND && nx.a >= 0 {
        sh := f.consts[0 - ins.d - 2]
        if sh >= 1 && sh <= 63 {
            $mv := 0
            if nx.c == ins.a && nx.d <= -2 {
                mv = nx.d
            } else if nx.d == ins.a && nx.c <= -2 {
                mv = nx.c
            }
            if mv <= -2 {
                w := a64_mask_ones(f.consts[0 - mv - 2])
                if w >= 1 && sh + w <= 64 {
                    << 7
                }
            }
        }
    }
    if ins.b == mir.BIN_XOR && (nx.b == mir.BIN_AND || nx.b == mir.BIN_OR || nx.b == mir.BIN_XOR) && nx.a >= 0 {
        has_not := (ins.c >= 0 && ins.d <= -2 && f.consts[0 - ins.d - 2] == -1) ||
                   (ins.d >= 0 && ins.c <= -2 && f.consts[0 - ins.c - 2] == -1)
        if has_not && ((nx.c == ins.a && nx.d >= 0 && nx.d != ins.a) || (nx.d == ins.a && nx.c >= 0 && nx.c != ins.a)) {
            << 8
        }
    }
    if ins.b == mir.BIN_FMUL {
        if nx.b == mir.BIN_FADD && ((nx.c == ins.a && nx.d != ins.a) || (nx.d == ins.a && nx.c != ins.a)) {
            << 3
        }
        if nx.b == mir.BIN_FSUB && nx.d == ins.a && nx.c != ins.a {
            << 4
        }
        << 0
    }
    if nx.b == mir.BIN_AND && nx.a >= 0 &&
       ((nx.c == ins.a && nx.d <= -2 && f.consts[0 - nx.d - 2] == 4294967295) ||
        (nx.d == ins.a && nx.c <= -2 && f.consts[0 - nx.c - 2] == 4294967295)) {
        if ins.b == mir.BIN_ADD || ins.b == mir.BIN_SUB || ins.b == mir.BIN_MUL ||
           ins.b == mir.BIN_OR || ins.b == mir.BIN_XOR {
            << 6
        }
    }
    if ins.b == mir.BIN_MUL {
        mul_imm := (ins.c > -2 && a64_can_bin_imm(f, mir.BIN_MUL, ins.d)) || (ins.d > -2 && a64_can_bin_imm(f, mir.BIN_MUL, ins.c))
        if nx.b == mir.BIN_SUB && nx.d == ins.a && nx.c != ins.a {
            if !(mul_imm && nx.c <= -2 && f.consts[0 - nx.c - 2] == 0) {
                << 2
            }
        }
        if nx.b == mir.BIN_ADD && ((nx.c == ins.a && nx.d != ins.a) || (nx.d == ins.a && nx.c != ins.a)) {
            $acc_v := nx.c
            if nx.c == ins.a { acc_v = nx.d }
            if !(mul_imm && a64_can_bin_imm(f, mir.BIN_ADD, acc_v)) {
                << 5
            }
        }
        << 0
    }
    if nx.b != mir.BIN_SUB || nx.d != ins.a || nx.c == ins.a {
        << 0
    }
    if ins.b == mir.BIN_SHR && ins.c >= 0 && nx.c == ins.c && ins.d <= -2 && f.consts[0 - ins.d - 2] == 63 {
        << 1
    }
    << 0
}

// For a block ending in t1 = x < 0; t2 = x >= n; t3 = t1 | t2 (tagged
// "bounds"); branch t3, with each temp read once: the three instruction
// ids, x and n. Empty otherwise.
fn a64_bounds_check(f &mir.MFn, bi int, uses &[]int, opt bool) []int {
    $out := []int{}
    blk := ~f.blocks[bi]
    if !opt || blk.tkind != mir.TKIND_BRANCH {
        << out
    }
    $ids := []int{}
    $ii := blk.head
    while ii >= 0 {
        ids.push(ii)
        ii = f.instrs[ii].next
    }
    if ids.len < 3 {
        << out
    }
    i1 := ~f.instrs[ids[ids.len - 3]]
    i2 := ~f.instrs[ids[ids.len - 2]]
    i3 := ~f.instrs[ids[ids.len - 1]]
    if i3.kind != mir.MI_BIN || i3.b != mir.BIN_OR || i3.sval != "bounds" || i3.a != blk.ta {
        << out
    }
    if i1.kind != mir.MI_BIN || i1.b != mir.BIN_LT || i2.kind != mir.MI_BIN || i2.b != mir.BIN_GE {
        << out
    }
    if i3.c != i1.a || i3.d != i2.a || i1.c != i2.c || i1.d > -2 || f.consts[0 - i1.d - 2] != 0 {
        << out
    }
    if i1.a < 0 || i2.a < 0 || i3.a < 0 || uses[i1.a] != 1 || uses[i2.a] != 1 || uses[i3.a] != 1 {
        << out
    }
    out.push(ids[ids.len - 3])
    out.push(ids[ids.len - 2])
    out.push(ids[ids.len - 1])
    out.push(i1.c)
    out.push(i2.d)
    << out
}

struct StrFix {
    adr_off int
    bytes string
}

// lines receives (code offset, source line) pairs where the line changes.
// Registers for allocated values: callee-saved x19-x27 (x28 is the state
// block) and the scratch registers no sequence below uses.
fn a64_ra(f &mir.MFn, opt bool) RaInfo {
    if !opt {
        << ra_none(f)
    }
    $callee := []int{}
    for r in 19:28 {
        callee.push(r)
    }
    $caller := []int{}
    for r in 0:9 {
        caller.push(r)
    }
    for r in 12:16 {
        caller.push(r)
    }
    $fp_callee := []int{}
    for r in 8:16 {
        fp_callee.push(32 + r)
    }
    $fp_caller := []int{}
    for r in 3:8 {
        fp_caller.push(32 + r)
    }
    for r in 16:32 {
        fp_caller.push(32 + r)
    }
    $arg_regs := []int{}
    for r in 0:8 {
        arg_regs.push(r)
    }
    << ra_alloc_fp_hints_ex(f, &callee, &caller, &fp_callee, &fp_caller, &arg_regs, 0, true)
}

fn a64_is_clobber_call(ins &mir.MInstr) bool {
    << ins.kind == mir.MI_CALL_IND || (ins.kind == mir.MI_CALL && !is_noreturn_call(&ins.sval) && !bits_hw_entry(&ins.sval, true))
}

fn a64_copy_params(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo) {
    $nreg := f.nparams
    if nreg > 8 { nreg = 8 }
    $loc := []int{}
    $dst := []int{}
    $done := []bool{}
    for i in 0:nreg {
        lr := ra.local_reg[i]
        loc.push(i)
        dst.push(lr)
        if lr < 0 {
            a64_str(cb, i, R_SP, fr.local_off[i])
            done.push(true)
        } else if lr >= 32 {
            a64_fmov_dx(cb, lr - 32, i)
            done.push(true)
        } else if lr == i {
            done.push(true)
        } else {
            done.push(false)
        }
    }
    for _ in 0:nreg * 2 + 2 {
        $progressed := false
        $first_undone := -1
        for i in 0:nreg {
            if done[i] { -> }
            if first_undone < 0 { first_undone = i }
            $busy := false
            for j in 0:nreg {
                if !done[j] && j != i && loc[j] == dst[i] {
                    busy = true
                    <-
                }
            }
            if !busy {
                a64_mov(cb, dst[i], loc[i])
                done[i] = true
                progressed = true
            }
        }
        if first_undone < 0 { <- }
        if !progressed {
            a64_mov(cb, 9, loc[first_undone])
            loc[first_undone] = 9
        }
    }
    for i in 8:f.nparams {
        lr := ra.local_reg[i]
        off := 16 + (i - 8) * 8
        if lr >= 32 {
            a64_fmem(cb, false, lr - 32, R_FP, off)
        } else if lr >= 0 {
            a64_ldr(cb, lr, R_FP, off)
        } else {
            a64_ldr(cb, 9, R_FP, off)
            a64_str(cb, 9, R_SP, fr.local_off[i])
        }
    }
}

// lines receives (code offset, source line) pairs where the line changes.
// opt keeps values in registers (ra_alloc); otherwise every value lives in
// its frame slot.
fn a64_defines(k int) bool {
    << k == mir.MI_COPY || k == mir.MI_LOAD_LOCAL || k == mir.MI_ADDR || k == mir.MI_LOAD_PTR ||
       k == mir.MI_BIN || k == mir.MI_UN || k == mir.MI_CALL || k == mir.MI_CALL_IND ||
       k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR || k == mir.MI_SELECT ||
       k == mir.MI_VLOAD128 || k == mir.MI_VBIN128 || k == mir.MI_VPACK128 || k == mir.MI_VEXTRACT
}

fn a64_reads_temp(f &mir.MFn, ins &mir.MInstr, t int) bool {
    k := ins.kind
    if k == mir.MI_NOP || k == mir.MI_LOAD_LOCAL || k == mir.MI_ADDR ||
       k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
        << false
    }
    if k == mir.MI_COPY || k == mir.MI_STORE_LOCAL { << ins.b == t }
    if k == mir.MI_LOAD_PTR { << ins.b == t }
    if k == mir.MI_STORE_PTR { << ins.a == t || ins.b == t }
    if k == mir.MI_BIN { << ins.c == t || ins.d == t }
    if k == mir.MI_UN { << ins.c == t }
    if k == mir.MI_SELECT { << ins.b == t || ins.c == t || ins.d == t }
    if k == mir.MI_VLOAD128 { << ins.b == t }
    if k == mir.MI_VSTORE128 { << ins.a == t || ins.b == t }
    if k == mir.MI_VBIN128 { << ins.c == t || ins.d == t }
    if k == mir.MI_VPACK128 { << ins.b == t || (ins.d != 0 && ins.c == t) }
    if k == mir.MI_VEXTRACT { << ins.b == t }
    if k == mir.MI_CALL || k == mir.MI_CALL_IND {
        if k == mir.MI_CALL_IND && ins.b == t { << true }
        $mi := ins.c
        while mi >= 0 {
            if f.margs[mi].v == t { << true }
            mi = f.margs[mi].next
        }
        << false
    }
    << true
}

fn a64_prepare_idx(f &mir.MFn, ra &RaInfo, uses &[]int, idx_mode $&[]int, idx_opc $&[]int, idx_base $&[]int, idx_off $&[]int, idx_shift $&[]int) {
    ni := f.instrs.len
    nt := f.temps.len
    for _ in 0:ni {
        idx_mode.push(0)
        idx_opc.push(0)
        idx_base.push(-1)
        idx_off.push(-1)
        idx_shift.push(0)
    }
    $def_cnt := []int{}
    $def_blk := []int{}
    $def_ii := []int{}
    for _ in 0:nt {
        def_cnt.push(0)
        def_blk.push(-1)
        def_ii.push(-1)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if a64_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                def_cnt[ins.a] = def_cnt[ins.a] + 1
                def_blk[ins.a] = bi
                def_ii[ins.a] = ii
            }
            ii = ins.next
        }
    }
    for bi in 0:f.blocks.len {
        tk := f.blocks[bi].tkind
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && ins.b == mir.BIN_ADD &&
               ins.a >= 0 && ins.a < nt && def_cnt[ins.a] == 1 && def_blk[ins.a] == bi &&
               ins.c >= 0 && ins.d >= 0 {
                ptr_t := ins.a
                if !((tk == mir.TKIND_RETURN || tk == mir.TKIND_BRANCH) && f.blocks[bi].ta == ptr_t) {
                    for side in 0:2 {
                        $base_v := ins.c
                        $off_v := ins.d
                        if side == 1 {
                            base_v = ins.d
                            off_v = ins.c
                        }
                        if base_v == ptr_t || base_v == off_v { -> }
                        $shl_ii := -1
                        $idx_v := off_v
                        $s := 0
                        if off_v < nt && def_cnt[off_v] == 1 && def_blk[off_v] == bi &&
                           off_v < uses.len && uses[off_v] == 1 {
                            sii := def_ii[off_v]
                            sins := &f.instrs[sii]
                            if idx_mode[sii] == 0 && sins.kind == mir.MI_BIN && sins.b == mir.BIN_SHL &&
                               sins.c >= 0 && sins.d <= -2 {
                                sc := f.consts[0 - sins.d - 2]
                                if sc >= 0 && sc <= 3 {
                                    shl_ii = sii
                                    idx_v = sins.c
                                    s = sc
                                }
                            }
                        }
                        if idx_v == ptr_t || idx_v < 0 || idx_v >= nt || base_v >= nt { -> }
                        $cand_mems := []int{}
                        $last_use_ii := -1
                        $abort := false
                        $ui := ins.next
                        while ui >= 0 {
                            uins := &f.instrs[ui]
                            uk := uins.kind
                            if uk == mir.MI_LOAD_PTR && uins.b == ptr_t && uins.c == 0 {
                                $w := uins.d
                                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                                $need_s := 3
                                if w == 4 || w == -4 { need_s = 2 }
                                else if w == 2 { need_s = 1 }
                                else if w == 1 { need_s = 0 }
                                $fp_bad := w != 8 && a64_temp_reg(ra, uins.a) >= 32
                                if (s == 0 || need_s == s) && idx_mode[ui] == 0 && !fp_bad {
                                    cand_mems.push(ui)
                                    last_use_ii = ui
                                } else {
                                    abort = true
                                    <-
                                }
                            } else if uk == mir.MI_STORE_PTR && uins.a == ptr_t && uins.c == 0 && uins.b != ptr_t {
                                $w := uins.d
                                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                                $need_s := 3
                                if w == 4 || w == -4 { need_s = 2 }
                                else if w == 2 { need_s = 1 }
                                else if w == 1 { need_s = 0 }
                                $fp_bad := w != 8 && a64_temp_reg(ra, uins.b) >= 32
                                if (s == 0 || need_s == s) && idx_mode[ui] == 0 && !fp_bad {
                                    cand_mems.push(ui)
                                    last_use_ii = ui
                                } else {
                                    abort = true
                                    <-
                                }
                            } else if a64_reads_temp(f, uins, ptr_t) {
                                abort = true
                                <-
                            }
                            ui = uins.next
                        }
                        if abort || cand_mems.len == 0 || ptr_t >= uses.len || cand_mems.len != uses[ptr_t] {
                            ->
                        }
                        $safe := false
                        if cand_mems.len == 1 && last_use_ii == ins.next && (shl_ii < 0 || f.instrs[shl_ii].next == ii) {
                            safe = true
                        } else {
                            rb := a64_temp_reg(ra, base_v)
                            ri := a64_temp_reg(ra, idx_v)
                            if rb >= 0 && rb < 32 && ri >= 0 && ri < 32 {
                                safe = true
                                $saw_add := shl_ii < 0
                                $wi := ii
                                if shl_ii >= 0 { wi = shl_ii }
                                wi = f.instrs[wi].next
                                while wi >= 0 && wi != last_use_ii {
                                    if wi == ii {
                                        saw_add = true
                                    } else {
                                        wins := &f.instrs[wi]
                                        if a64_defines(wins.kind) && wins.a >= 0 {
                                            if wins.a == idx_v || (saw_add && wins.a == base_v) {
                                                safe = false
                                                <-
                                            }
                                            rw := a64_temp_reg(ra, wins.a)
                                            if rw == ri || (saw_add && rw == rb) {
                                                safe = false
                                                <-
                                            }
                                        }
                                        if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len {
                                            lr := ra.local_reg[wins.a]
                                            if lr == ri || (saw_add && lr == rb) {
                                                safe = false
                                                <-
                                            }
                                        }
                                        if a64_is_clobber_call(&f.instrs[wi]) {
                                            if ri < 19 || (saw_add && rb < 19) {
                                                safe = false
                                                <-
                                            }
                                        }
                                    }
                                    wi = f.instrs[wi].next
                                }
                            }
                        }
                        if safe {
                            if shl_ii >= 0 { idx_mode[shl_ii] = 1 }
                            idx_mode[ii] = 1
                            for ci in 0:cand_mems.len {
                                m := cand_mems[ci]
                                idx_mode[m] = 2
                                idx_base[m] = base_v
                                idx_off[m] = idx_v
                                idx_shift[m] = s
                            }
                            <-
                        }
                    }
                }
            }
            ii = ins.next
        }
        ii = f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN &&
               (ins.b == mir.BIN_SHL || ins.b == mir.BIN_SHR || ins.b == mir.BIN_ROTR64) &&
               ins.a >= 0 && ins.a < uses.len && uses[ins.a] == 1 && ins.c >= 0 && ins.c != ins.a && ins.d <= -2 &&
               !((tk == mir.TKIND_RETURN || tk == mir.TKIND_BRANCH) && f.blocks[bi].ta == ins.a) {
                $first_nx := ins.next
                while first_nx >= 0 && f.instrs[first_nx].kind == mir.MI_NOP {
                    first_nx = f.instrs[first_nx].next
                }
                $nx := -1
                if first_nx >= 0 && a64_reads_temp(f, &f.instrs[first_nx], ins.a) {
                    nx = first_nx
                } else {
                    rx := a64_temp_reg(ra, ins.c)
                    if rx >= 0 && rx < 32 {
                        $wi := ins.next
                        while wi >= 0 {
                            wins := &f.instrs[wi]
                            if a64_reads_temp(f, wins, ins.a) {
                                nx = wi
                                <-
                            }
                            if idx_mode[wi] != 1 {
                                if a64_defines(wins.kind) && wins.a >= 0 {
                                    if wins.a == ins.c || wins.a == ins.a || a64_temp_reg(ra, wins.a) == rx {
                                        <-
                                    }
                                }
                                if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len && ra.local_reg[wins.a] == rx {
                                    <-
                                }
                                if a64_is_clobber_call(wins) && rx < 19 {
                                    <-
                                }
                            }
                            wi = wins.next
                        }
                    }
                }
                if nx >= 0 && idx_mode[nx] == 0 {
                    nins := &f.instrs[nx]
                    if nins.kind == mir.MI_BIN && nins.a >= 0 && nins.sval != "bounds" {
                        $bv := -1
                        $sh_opc := 0
                        if nins.b == mir.BIN_ADD && (ins.b == mir.BIN_SHL || ins.b == mir.BIN_SHR) {
                            if nins.c == ins.a && nins.d >= 0 && nins.d != ins.a {
                                bv = nins.d
                            } else if nins.d == ins.a && nins.c >= 0 && nins.c != ins.a {
                                bv = nins.c
                            }
                            if bv >= 0 {
                                sh_opc = 0x8B000000
                                if ins.b == mir.BIN_SHR { sh_opc = 0x8B800000 }
                            }
                        } else if nins.b == mir.BIN_SUB && (ins.b == mir.BIN_SHL || ins.b == mir.BIN_SHR) &&
                                  nins.d == ins.a && nins.c >= 0 && nins.c != ins.a {
                            bv = nins.c
                            sh_opc = 0xCB000000
                            if ins.b == mir.BIN_SHR { sh_opc = 0xCB800000 }
                        } else if nins.b == mir.BIN_AND || nins.b == mir.BIN_OR || nins.b == mir.BIN_XOR {
                            if nins.c == ins.a && nins.d >= 0 && nins.d != ins.a {
                                bv = nins.d
                            } else if nins.d == ins.a && nins.c >= 0 && nins.c != ins.a {
                                bv = nins.c
                            }
                            if bv >= 0 {
                                $base_op := 0x8A000000
                                if nins.b == mir.BIN_OR { base_op = 0xAA000000 }
                                else if nins.b == mir.BIN_XOR { base_op = 0xCA000000 }
                                $sh_bits := 0
                                if ins.b == mir.BIN_SHR { sh_bits = 0x00800000 }
                                else if ins.b == mir.BIN_ROTR64 { sh_bits = 0x00C00000 }
                                sh_opc = base_op | sh_bits
                            }
                        }
                        if sh_opc != 0 && bv >= 0 {
                            idx_mode[ii] = 1
                            idx_mode[nx] = 3
                            idx_opc[nx] = sh_opc
                            idx_base[nx] = bv
                            idx_off[nx] = ins.c
                            idx_shift[nx] = f.consts[0 - ins.d - 2] & 63
                        }
                    }
                }
            }
            ii = ins.next
        }
        ii = f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && (ins.b == mir.BIN_EQ || ins.b == mir.BIN_NE) &&
               ins.a >= 0 && ins.a < uses.len && uses[ins.a] >= 1 {
                will_fuse := (uses[ins.a] == 1 && tk == mir.TKIND_BRANCH && f.blocks[bi].ta == ins.a && (ins.next < 0 || a64_feeds_branch(f, idx_mode, ii, ins.a))) || a64_feeds_select(f, idx_mode, ii, ins.a, uses[ins.a])
                if will_fuse {
                    $and_t := -1
                    if ins.c >= 0 && ins.d <= -2 && f.consts[0 - ins.d - 2] == 0 {
                        and_t = ins.c
                    } else if ins.d >= 0 && ins.c <= -2 && f.consts[0 - ins.c - 2] == 0 {
                        and_t = ins.d
                    }
                    if and_t >= 0 && and_t < nt && def_cnt[and_t] == 1 && def_blk[and_t] == bi && and_t < uses.len && uses[and_t] == 1 {
                        and_ii := def_ii[and_t]
                        ains := &f.instrs[and_ii]
                        if idx_mode[and_ii] == 0 && ains.kind == mir.MI_BIN && ains.b == mir.BIN_AND {
                            $xv := -1
                            $cv := 0
                            if ains.c >= 0 && ains.d <= -2 {
                                xv = ains.c
                                cv = f.consts[0 - ains.d - 2]
                            } else if ains.d >= 0 && ains.c <= -2 {
                                xv = ains.d
                                cv = f.consts[0 - ains.c - 2]
                            }
                            if xv >= 0 && xv < nt && cv != 0 && cv != -1 {
                                enc := a64_encode_bitmask64(cv)
                                rx := a64_temp_reg(ra, xv)
                                if enc >= 0 && rx >= 0 && rx < 32 {
                                    $safe := true
                                    $wi := f.instrs[and_ii].next
                                    while wi >= 0 && wi != ii {
                                        wins := &f.instrs[wi]
                                        if idx_mode[wi] != 1 && a64_defines(wins.kind) && wins.a >= 0 {
                                            if wins.a == xv || a64_temp_reg(ra, wins.a) == rx {
                                                safe = false
                                                <-
                                            }
                                        }
                                        if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len && ra.local_reg[wins.a] == rx {
                                            safe = false
                                            <-
                                        }
                                        if a64_is_clobber_call(&f.instrs[wi]) {
                                            if rx < 19 {
                                                safe = false
                                                <-
                                            }
                                        }
                                        wi = wins.next
                                    }
                                    if safe {
                                        idx_mode[and_ii] = 1
                                        idx_mode[ii] = 4
                                        idx_base[ii] = rx
                                        idx_shift[ii] = enc
                                    }
                                }
                            }
                        }
                    }
                }
            }
            ii = ins.next
        }
        ii = f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && ins.b == mir.BIN_SHR &&
               ins.a >= 0 && ins.a < uses.len && uses[ins.a] == 1 &&
               ins.c >= 0 && ins.c < nt && def_cnt[ins.c] == 1 &&
               ins.d <= -2 && f.consts[0 - ins.d - 2] == 63 {
                xv := ins.c
                sv := ins.a
                rx := a64_temp_reg(ra, xv)
                $i1 := -1
                $safe01 := true
                $wi := ins.next
                while wi >= 0 {
                    wins := &f.instrs[wi]
                    if idx_mode[wi] == 0 && wins.kind == mir.MI_BIN && wins.b == mir.BIN_AND && wins.a >= 0 &&
                       ((wins.c == sv && wins.d <= -2 && f.consts[0 - wins.d - 2] == 1) ||
                        (wins.d == sv && wins.c <= -2 && f.consts[0 - wins.c - 2] == 1)) {
                        i1 = wi
                        <-
                    }
                    // Adjacent instruction is safe even for spilled temps; otherwise require un-clobbered reg.
                    if rx < 0 || rx >= 32 {
                        safe01 = false
                        <-
                    }
                    if idx_mode[wi] != 1 && a64_defines(wins.kind) && wins.a >= 0 {
                        if wins.a == xv || a64_temp_reg(ra, wins.a) == rx {
                            safe01 = false
                            <-
                        }
                    }
                    if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len && ra.local_reg[wins.a] == rx {
                        safe01 = false
                        <-
                    }
                    if a64_is_clobber_call(&f.instrs[wi]) {
                        if rx < 19 {
                            safe01 = false
                            <-
                        }
                    }
                    if wins.kind == mir.MI_BIN && (wins.c == sv || wins.d == sv) {
                        safe01 = false
                        <-
                    }
                    if wins.kind == mir.MI_COPY && wins.b == sv {
                        safe01 = false
                        <-
                    }
                    if wins.kind == mir.MI_SELECT && (wins.b == sv || wins.c == sv || wins.d == sv) {
                        safe01 = false
                        <-
                    }
                    wi = wins.next
                }
                if i1 >= 0 && safe01 {
                    bv := f.instrs[i1].a
                    $fused_add := false
                    if bv >= 0 && bv < uses.len && uses[bv] == 1 && bv != xv {
                        $w2 := f.instrs[i1].next
                        while w2 >= 0 {
                            w2ins := &f.instrs[w2]
                            if idx_mode[w2] == 0 && w2ins.kind == mir.MI_BIN && w2ins.b == mir.BIN_ADD && w2ins.a >= 0 &&
                               ((w2ins.c == xv && w2ins.d == bv) || (w2ins.d == xv && w2ins.c == bv)) {
                                idx_mode[ii] = 1
                                idx_mode[i1] = 1
                                idx_mode[w2] = 5
                                idx_base[w2] = xv
                                fused_add = true
                                <-
                            }
                            if w2ins.kind == mir.MI_BIN && (w2ins.c == bv || w2ins.d == bv) { <- }
                            if (w2ins.kind == mir.MI_COPY || w2ins.kind == mir.MI_STORE_LOCAL || w2ins.kind == mir.MI_LOAD_PTR || w2ins.kind == mir.MI_CALL_IND) && w2ins.b == bv { <- }
                            if w2ins.kind == mir.MI_STORE_PTR && (w2ins.a == bv || w2ins.b == bv) { <- }
                            if w2ins.kind == mir.MI_UN && w2ins.c == bv { <- }
                            if w2ins.kind == mir.MI_SELECT && (w2ins.b == bv || w2ins.c == bv || w2ins.d == bv) { <- }
                            w2 = w2ins.next
                        }
                    }
                    if !fused_add {
                        idx_mode[ii] = 1
                        idx_mode[i1] = 6
                        idx_base[i1] = xv
                    }
                }
            }
            ii = ins.next
        }
    }
}

fn a64_swap_cmp_op(op int) int {
    if op == mir.BIN_LT { << mir.BIN_GT }
    if op == mir.BIN_LE { << mir.BIN_GE }
    if op == mir.BIN_GT { << mir.BIN_LT }
    if op == mir.BIN_GE { << mir.BIN_LE }
    << op
}

fn a64_is_const_eq(f &mir.MFn, v int, val int) bool {
    << v <= -2 && f.consts[0 - v - 2] == val
}

fn a64_no_reg_clobber(f &mir.MFn, ra &RaInfo, idx_mode &[]int, start_ii int, end_ii int, v int, rx int) bool {
    $wi := start_ii
    while wi >= 0 && wi != end_ii {
        if wi >= idx_mode.len || idx_mode[wi] != 1 {
            wins := &f.instrs[wi]
            if a64_defines(wins.kind) && wins.a >= 0 {
                if wins.a == v || a64_temp_reg(ra, wins.a) == rx {
                    << false
                }
            }
            if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len && ra.local_reg[wins.a] == rx {
                << false
            }
            if a64_is_clobber_call(&f.instrs[wi]) {
                if rx < 19 {
                    << false
                }
            }
        }
        wi = f.instrs[wi].next
    }
    if end_ii >= 0 && wi != end_ii {
        << false
    }
    << true
}

fn a64_is_last_real(f &mir.MFn, idx_mode &[]int, ii int) bool {
    $ni := f.instrs[ii].next
    while ni >= 0 {
        if f.instrs[ni].kind != mir.MI_NOP && !(ni < idx_mode.len && idx_mode[ni] == 1) {
            << false
        }
        ni = f.instrs[ni].next
    }
    << true
}

fn a64_prepare_select(f &mir.MFn, ra &RaInfo, uses &[]int, idx_mode $&[]int, sel_mod_kind $&[]int, sel_mod_side $&[]int, sel_mod_src $&[]int) {
    ni := f.instrs.len
    nt := f.temps.len
    for _ in 0:ni {
        sel_mod_kind.push(0)
        sel_mod_side.push(0)
        sel_mod_src.push(-1)
    }
    $def_cnt := []int{}
    $def_blk := []int{}
    $def_ii := []int{}
    for _ in 0:nt {
        def_cnt.push(0)
        def_blk.push(-1)
        def_ii.push(-1)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if a64_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                def_cnt[ins.a] = def_cnt[ins.a] + 1
                def_blk[ins.a] = bi
                def_ii[ins.a] = ii
            }
            ii = ins.next
        }
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.kind == mir.MI_SELECT && idx_mode[ii] == 0 && a64_temp_reg(ra, ins.a) < 32 {
                for side in 0:2 {
                    $arm_v := ins.c
                    if side == 1 { arm_v = ins.d }
                    if arm_v >= 0 && arm_v < nt && def_cnt[arm_v] == 1 && def_blk[arm_v] == bi &&
                       arm_v < uses.len && uses[arm_v] == 1 && arm_v != ins.b && a64_temp_reg(ra, arm_v) < 32 {
                        p_ii := def_ii[arm_v]
                        pins := &f.instrs[p_ii]
                        if idx_mode[p_ii] == 0 && pins.kind == mir.MI_BIN {
                            $mk := 0
                            $xv := -1
                            if pins.b == mir.BIN_ADD {
                                if pins.c >= 0 && a64_is_const_eq(f, pins.d, 1) {
                                    mk = 1
                                    xv = pins.c
                                } else if pins.d >= 0 && a64_is_const_eq(f, pins.c, 1) {
                                    mk = 1
                                    xv = pins.d
                                }
                            } else if pins.b == mir.BIN_XOR {
                                if pins.c >= 0 && a64_is_const_eq(f, pins.d, -1) {
                                    mk = 2
                                    xv = pins.c
                                } else if pins.d >= 0 && a64_is_const_eq(f, pins.c, -1) {
                                    mk = 2
                                    xv = pins.d
                                }
                            } else if pins.b == mir.BIN_SUB && a64_is_const_eq(f, pins.c, 0) && pins.d >= 0 {
                                mk = 3
                                xv = pins.d
                            }
                            if mk > 0 && xv >= 0 && xv < nt {
                                rx := a64_temp_reg(ra, xv)
                                if rx >= 0 && rx < 32 && a64_no_reg_clobber(f, ra, idx_mode, pins.next, ii, xv, rx) {
                                    idx_mode[p_ii] = 1
                                    sel_mod_kind[ii] = mk
                                    sel_mod_side[ii] = side
                                    sel_mod_src[ii] = xv
                                    <-
                                }
                            }
                        }
                    }
                }
            }
            ii = ins.next
        }
    }
}

fn a64_copy_call_args(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, args &[]int, is_ind bool, fn_v int) {
    for i in 8:args.len {
        v := args[i]
        sr := a64_temp_reg(ra, v)
        if sr >= 32 {
            a64_fmem(cb, true, sr - 32, R_SP, (i - 8) * 8)
        } else {
            rs := a64_src(cb, f, fr, ra, v, 9)
            a64_str(cb, rs, R_SP, (i - 8) * 8)
        }
    }
    if is_ind {
        a64_load_to(cb, f, fr, ra, R_IP0, fn_v)
    }
    $nreg := args.len
    if nreg > 8 { nreg = 8 }
    $loc := []int{}
    $dst := []int{}
    $done := []bool{}
    for i in 0:nreg {
        r := a64_temp_reg(ra, args[i])
        loc.push(r)
        dst.push(i)
        done.push(r < 0 || r >= 32 || r == i)
    }
    for _ in 0:nreg * 2 + 2 {
        $progressed := false
        $first_undone := -1
        for i in 0:nreg {
            if done[i] { -> }
            if first_undone < 0 { first_undone = i }
            $busy := false
            for j in 0:nreg {
                if !done[j] && j != i && loc[j] == dst[i] {
                    busy = true
                    <-
                }
            }
            if !busy {
                a64_mov(cb, dst[i], loc[i])
                done[i] = true
                progressed = true
            }
        }
        if first_undone < 0 { <- }
        if !progressed {
            a64_mov(cb, 9, loc[first_undone])
            loc[first_undone] = 9
        }
    }
    for i in 0:nreg {
        r := a64_temp_reg(ra, args[i])
        if r < 0 || r >= 32 {
            a64_load_to(cb, f, fr, ra, i, args[i])
        }
    }
}

const FV_CONST = 0
const FV_PARAM = 1
const FV_BIN = 2
const FV_OR = 3
const FV_AND = 4

struct FastNode {
    kind int
    val int
    bop int
    lhs int
    rhs int
}

struct FastExit {
    cond_node int
    want_true bool
    ret_node int
}

struct FastPlan {
    nodes []FastNode
    exits []FastExit
    slow_blk int
    init_locals []int
    init_vals []int
}

fn fv_noframe_kind(k int) bool {
    << k == mir.MI_NOP || k == mir.MI_COPY || k == mir.MI_LOAD_LOCAL || k == mir.MI_STORE_LOCAL ||
       k == mir.MI_LOAD_PTR || k == mir.MI_STORE_PTR || k == mir.MI_BIN || k == mir.MI_UN ||
       k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR || k == mir.MI_SELECT ||
       k == mir.MI_MADD || k == mir.MI_MSUB ||
       (k >= mir.MI_VLOAD128 && k <= mir.MI_VEXTRACT)
}

fn can_elide_frame(f &mir.MFn, ra &RaInfo, opt bool) bool {
    << can_elide_frame_ex(f, ra, opt, false)
}

fn can_elide_frame_ex(f &mir.MFn, ra &RaInfo, opt bool, inline_bits bool) bool {
    if f.name == "_start" || f.label == "_start" || (f.name.len >= 6 && f.name[0:6] == "naked_") {
        << true
    }
    if !opt || f.nparams > 8 || ra.used_callee.len > 0 || ra.max_call_saves > 0 {
        << false
    }
    if f.nparams > f.locals_nslots.len || f.nparams > ra.local_reg.len {
        << false
    }
    for i in 0:f.nparams {
        if f.locals_nslots[i] != 1 || ra.local_reg[i] < 0 {
            << false
        }
    }
    nb := f.blocks.len
    if nb == 0 {
        << false
    }
    $reach := []bool{}
    $q := []int{}
    for _ in 0:nb {
        reach.push(false)
    }
    reach[0] = true
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == mir.TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !reach[s] {
                reach[s] = true
                q.push(s)
            }
        } else if tk == mir.TKIND_BRANCH {
            sb := f.blocks[b].tb
            sc := f.blocks[b].tc
            if sb >= 0 && sb < nb && !reach[sb] {
                reach[sb] = true
                q.push(sb)
            }
            if sc >= 0 && sc < nb && !reach[sc] {
                reach[sc] = true
                q.push(sc)
            }
        }
    }
    nt := ra.temp_reg.len
    nl := f.locals_nslots.len
    for bi in 0:nb {
        if !reach[bi] {
            ->
        }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if inline_bits && k == mir.MI_CALL && bits_hw_entry(&f.instrs[ii].sval, true) {
                if ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0 || ra.temp_reg[ins.a] >= 32) {
                    << false
                }
                $ai := ins.c
                while ai >= 0 {
                    av := f.margs[ai].v
                    if av >= 0 && (av >= nt || ra.temp_reg[av] < 0 || ra.temp_reg[av] >= 32) {
                        << false
                    }
                    ai = f.margs[ai].next
                }
                ii = ins.next
                ->
            }
            if !fv_noframe_kind(k) {
                << false
            }
            if k == mir.MI_LOAD_LOCAL || k == mir.MI_STORE_LOCAL {
                $loc := ins.a
                if k == mir.MI_LOAD_LOCAL { loc = ins.b }
                if ins.c != 0 || loc < 0 || loc >= nl || loc >= ra.local_reg.len {
                    << false
                }
                if f.locals_nslots[loc] != 1 || ra.local_reg[loc] < 0 {
                    << false
                }
                if k == mir.MI_STORE_LOCAL && ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0) {
                    << false
                }
                if k == mir.MI_LOAD_LOCAL && ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0) {
                    << false
                }
            } else {
                if a64_defines(k) && ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0) {
                    << false
                }
                if k == mir.MI_COPY || k == mir.MI_LOAD_PTR {
                    if ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0) { << false }
                } else if k == mir.MI_STORE_PTR {
                    if (ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0)) ||
                       (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) {
                        << false
                    }
                } else if k == mir.MI_BIN {
                    if (ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0)) ||
                       (ins.d >= 0 && (ins.d >= nt || ra.temp_reg[ins.d] < 0)) {
                        << false
                    }
                } else if k == mir.MI_UN {
                    if ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0) { << false }
                } else if k == mir.MI_SELECT || k == mir.MI_MADD || k == mir.MI_MSUB {
                    if (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) ||
                       (ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0)) ||
                       (ins.d >= 0 && (ins.d >= nt || ra.temp_reg[ins.d] < 0)) {
                        << false
                    }
                } else if k == mir.MI_VLOAD128 {
                    if (ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0)) ||
                       (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) {
                        << false
                    }
                } else if k == mir.MI_VSTORE128 {
                    if (ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0)) ||
                       (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) {
                        << false
                    }
                } else if k == mir.MI_VBIN128 {
                    if (ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0)) ||
                       (ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0)) ||
                       (ins.d >= 0 && (ins.d >= nt || ra.temp_reg[ins.d] < 0)) {
                        << false
                    }
                } else if k == mir.MI_VPACK128 {
                    if (ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0)) ||
                       (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) ||
                       (ins.d != 0 && ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0)) {
                        << false
                    }
                } else if k == mir.MI_VEXTRACT {
                    if (ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0)) ||
                       (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) {
                        << false
                    }
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if (tk == mir.TKIND_RETURN || tk == mir.TKIND_BRANCH) && f.blocks[bi].ta >= 0 {
            ta := f.blocks[bi].ta
            if ta >= nt || ra.temp_reg[ta] < 0 {
                << false
            }
        }
    }
    << true
}

fn fv_is_arith_op(op int) bool {
    << op == mir.BIN_ADD || op == mir.BIN_SUB || op == mir.BIN_MUL ||
       op == mir.BIN_AND || op == mir.BIN_OR || op == mir.BIN_XOR
}

fn fv_is_cmp_op(op int) bool {
    << op >= mir.BIN_EQ && op <= mir.BIN_GE
}

fn fv_depth(nodes &[]FastNode, ni int) int {
    if ni < 0 || ni >= nodes.len {
        << 99
    }
    nd := &nodes[ni]
    if nd.kind != FV_BIN {
        << 0
    }
    ld := fv_depth(nodes, nd.lhs)
    rd := fv_depth(nodes, nd.rhs)
    if ld > rd {
        << ld + 1
    }
    << rd + 1
}

fn fv_pure_only(nodes &[]FastNode, ni int, allow_cmp_root bool) bool {
    if ni < 0 || ni >= nodes.len {
        << false
    }
    nd := &nodes[ni]
    if nd.kind == FV_CONST || nd.kind == FV_PARAM {
        << true
    }
    if nd.kind != FV_BIN {
        << false
    }
    if fv_is_cmp_op(nd.bop) {
        if !allow_cmp_root {
            << false
        }
        << fv_pure_only(nodes, nd.lhs, false) && fv_pure_only(nodes, nd.rhs, false)
    }
    if !fv_is_arith_op(nd.bop) {
        << false
    }
    << fv_pure_only(nodes, nd.lhs, false) && fv_pure_only(nodes, nd.rhs, false)
}

fn fv_collect_guards(nodes &[]FastNode, cn int, want_true bool, out $&[]int, depth int) bool {
    if depth > 3 || cn < 0 || cn >= nodes.len {
        << false
    }
    nd := &nodes[cn]
    if want_true && (nd.kind == FV_OR || (nd.kind == FV_BIN && nd.bop == mir.BIN_OR)) {
        << fv_collect_guards(nodes, nd.lhs, true, out, depth + 1) &&
           fv_collect_guards(nodes, nd.rhs, true, out, depth + 1)
    }
    if !want_true && nd.kind == FV_AND {
        << fv_collect_guards(nodes, nd.lhs, false, out, depth + 1) &&
           fv_collect_guards(nodes, nd.rhs, false, out, depth + 1)
    }
    if !fv_pure_only(nodes, cn, true) || fv_depth(nodes, cn) > 2 {
        << false
    }
    out.push(cn)
    << true
}

fn fv_eval_op(f &mir.MFn, nodes $&[]FastNode, temp_node &[]int, v int) int {
    if v <= -2 {
        cidx := 0 - v - 2
        if cidx < 0 || cidx >= f.consts.len {
            << -1
        }
        idx := nodes.len
        nodes.push(FastNode{kind: FV_CONST, val: f.consts[cidx], bop: 0, lhs: -1, rhs: -1})
        << idx
    }
    if v >= 0 && v < temp_node.len {
        << temp_node[v]
    }
    << -1
}

fn fv_sim_block(f &mir.MFn, bi int, nodes $&[]FastNode, loc_node $&[]int, temp_node $&[]int, max_ins int) bool {
    $ii := f.blocks[bi].head
    $cnt := 0
    while ii >= 0 {
        ins := &f.instrs[ii]
        k := ins.kind
        if k == mir.MI_NOP {
            ii = ins.next
            ->
        }
        cnt += 1
        if cnt > max_ins {
            << false
        }
        if k == mir.MI_COPY {
            if ins.a < 0 || ins.a >= temp_node.len { << false }
            sn := fv_eval_op(f, nodes, temp_node, ins.b)
            if sn < 0 { << false }
            temp_node[ins.a] = sn
        } else if k == mir.MI_LOAD_LOCAL {
            if ins.c != 0 || ins.a < 0 || ins.a >= temp_node.len || ins.b < 0 || ins.b >= loc_node.len {
                << false
            }
            if loc_node[ins.b] < 0 { << false }
            temp_node[ins.a] = loc_node[ins.b]
        } else if k == mir.MI_STORE_LOCAL {
            if ins.c != 0 || ins.a < 0 || ins.a >= loc_node.len { << false }
            sn := fv_eval_op(f, nodes, temp_node, ins.b)
            if sn < 0 { << false }
            loc_node[ins.a] = sn
        } else if k == mir.MI_BIN {
            if ins.a < 0 || ins.a >= temp_node.len || (!fv_is_arith_op(ins.b) && !fv_is_cmp_op(ins.b)) {
                << false
            }
            ln := fv_eval_op(f, nodes, temp_node, ins.c)
            rn := fv_eval_op(f, nodes, temp_node, ins.d)
            if ln < 0 || rn < 0 { << false }
            if fv_is_arith_op(ins.b) && nodes[ln].kind == FV_CONST && nodes[rn].kind == FV_CONST {
                lv := nodes[ln].val
                rv := nodes[rn].val
                $cv := 0
                if ins.b == mir.BIN_ADD { cv = lv + rv }
                else if ins.b == mir.BIN_SUB { cv = lv - rv }
                else if ins.b == mir.BIN_MUL { cv = lv * rv }
                else if ins.b == mir.BIN_AND { cv = lv & rv }
                else if ins.b == mir.BIN_OR { cv = lv | rv }
                else { cv = lv ^ rv }
                idx := nodes.len
                nodes.push(FastNode{kind: FV_CONST, val: cv, bop: 0, lhs: -1, rhs: -1})
                temp_node[ins.a] = idx
            } else if ins.b == mir.BIN_ADD && nodes[ln].kind == FV_CONST && nodes[ln].val == 0 {
                temp_node[ins.a] = rn
            } else if (ins.b == mir.BIN_ADD || ins.b == mir.BIN_SUB) && nodes[rn].kind == FV_CONST && nodes[rn].val == 0 {
                temp_node[ins.a] = ln
            } else {
                idx := nodes.len
                nodes.push(FastNode{kind: FV_BIN, val: 0, bop: ins.b, lhs: ln, rhs: rn})
                temp_node[ins.a] = idx
            }
        } else if k == mir.MI_SELECT {
            if ins.a < 0 || ins.a >= temp_node.len { << false }
            if ins.b == ins.c {
                ln := fv_eval_op(f, nodes, temp_node, ins.b)
                rn := fv_eval_op(f, nodes, temp_node, ins.d)
                if ln < 0 || rn < 0 { << false }
                idx := nodes.len
                nodes.push(FastNode{kind: FV_OR, val: 0, bop: 0, lhs: ln, rhs: rn})
                temp_node[ins.a] = idx
            } else if ins.b == ins.d {
                ln := fv_eval_op(f, nodes, temp_node, ins.b)
                rn := fv_eval_op(f, nodes, temp_node, ins.c)
                if ln < 0 || rn < 0 { << false }
                idx := nodes.len
                nodes.push(FastNode{kind: FV_AND, val: 0, bop: 0, lhs: ln, rhs: rn})
                temp_node[ins.a] = idx
            } else {
                << false
            }
        } else {
            << false
        }
        ii = ins.next
    }
    << true
}

fn fv_try_pure_ret(f &mir.MFn, start_b int, nodes $&[]FastNode, loc_node &[]int, temp_node &[]int) int {
    $lcpy := []int{}
    $tcpy := []int{}
    for i in 0:loc_node.len { lcpy.push(loc_node[i]) }
    for i in 0:temp_node.len { tcpy.push(temp_node[i]) }
    $b := start_b
    for step in 0:2 {
        if b < 0 || b >= f.blocks.len {
            << -1
        }
        if !fv_sim_block(f, b, nodes, $&lcpy, $&tcpy, 8) {
            << -1
        }
        tk := f.blocks[b].tkind
        if tk == mir.TKIND_RETURN {
            rn := fv_eval_op(f, nodes, &tcpy, f.blocks[b].ta)
            if rn >= 0 && fv_pure_only(nodes, rn, false) && fv_depth(nodes, rn) <= 2 {
                << rn
            }
            << -1
        }
        if tk == mir.TKIND_JUMP && step == 0 && f.blocks[b].ta != b {
            b = f.blocks[b].ta
        } else {
            << -1
        }
    }
    << -1
}

fn fv_skip_read_ok(bi int, t int, def_skip_blk &[]int, skipped &[]bool, skip_idx &[]int, ext_pred_skip &[]bool, temp_node &[]int, nodes &[]FastNode, ra &RaInfo, f &mir.MFn, loc_written &[]bool) bool {
    db := def_skip_blk[t]
    if db < 0 || db == bi {
        << true
    }
    if skipped[bi] {
        if skip_idx[db] < 0 || skip_idx[db] >= skip_idx[bi] {
            << false
        }
        for s in 0:skipped.len {
            if skipped[s] && skip_idx[s] > skip_idx[db] && skip_idx[s] <= skip_idx[bi] && ext_pred_skip[s] {
                << false
            }
        }
        << true
    }
    if t >= temp_node.len || t >= ra.temp_reg.len {
        << false
    }
    tn := temp_node[t]
    if tn < 0 || nodes[tn].kind != FV_PARAM {
        << false
    }
    p := nodes[tn].val
    if p < 0 || p >= f.nparams || p >= ra.local_reg.len {
        << false
    }
    tr := ra.temp_reg[t]
    if tr < 0 || tr >= 32 || tr != ra.local_reg[p] {
        << false
    }
    for l in f.nparams:f.locals.len {
        if loc_written[l] && l < ra.local_reg.len && ra.local_reg[l] == tr {
            << false
        }
    }
    << true
}

fn analyze_fast_entry(f &mir.MFn, ra &RaInfo) FastPlan {
    $plan := FastPlan{nodes: []FastNode{}, exits: []FastExit{}, slow_blk: -1, init_locals: []int{}, init_vals: []int{}}
    if !f.scalar_params || f.nparams <= 0 || f.nparams > 6 || f.blocks.len < 2 {
        << plan
    }
    if f.nparams > f.locals_nslots.len {
        << plan
    }
    $loc_node := []int{}
    for i in 0:f.locals.len {
        if i < f.nparams {
            if f.locals_nslots[i] != 1 {
                << plan
            }
            plan.nodes.push(FastNode{kind: FV_PARAM, val: i, bop: 0, lhs: -1, rhs: -1})
            loc_node.push(i)
        } else {
            loc_node.push(-1)
        }
    }
    $temp_node := []int{}
    for _ in 0:f.temps.len {
        temp_node.push(-1)
    }
    $vis := []bool{}
    $skipped := []bool{}
    $skip_idx := []int{}
    for _ in 0:f.blocks.len {
        vis.push(false)
        skipped.push(false)
        skip_idx.push(-1)
    }
    $skip_cnt := 0
    $cur_b := 0
    for _ in 0:8 {
        if cur_b < 0 || cur_b >= f.blocks.len || vis[cur_b] || plan.exits.len >= 4 {
            <-
        }
        vis[cur_b] = true
        if !fv_sim_block(f, cur_b, $&plan.nodes, $&loc_node, $&temp_node, 16) {
            <-
        }
        tk := f.blocks[cur_b].tkind
        if tk == mir.TKIND_JUMP {
            skipped[cur_b] = true
            skip_idx[cur_b] = skip_cnt
            skip_cnt += 1
            cur_b = f.blocks[cur_b].ta
            ->
        }
        if tk != mir.TKIND_BRANCH {
            <-
        }
        cn := fv_eval_op(f, $&plan.nodes, &temp_node, f.blocks[cur_b].ta)
        if cn < 0 {
            <-
        }
        tb := f.blocks[cur_b].tb
        tc := f.blocks[cur_b].tc
        $rt := -1
        if tb >= 0 && tb < vis.len && !vis[tb] {
            rt = fv_try_pure_ret(f, tb, $&plan.nodes, &loc_node, &temp_node)
        }
        if rt >= 0 {
            $guards := []int{}
            if fv_collect_guards(&plan.nodes, cn, true, $&guards, 0) && plan.exits.len + guards.len <= 4 {
                for gi in 0:guards.len {
                    plan.exits.push(FastExit{cond_node: guards[gi], want_true: true, ret_node: rt})
                }
                skipped[cur_b] = true
                skip_idx[cur_b] = skip_cnt
                skip_cnt += 1
                cur_b = tc
                ->
            }
        }
        $re := -1
        if tc >= 0 && tc < vis.len && !vis[tc] {
            re = fv_try_pure_ret(f, tc, $&plan.nodes, &loc_node, &temp_node)
        }
        if re >= 0 {
            $guards := []int{}
            if fv_collect_guards(&plan.nodes, cn, false, $&guards, 0) && plan.exits.len + guards.len <= 4 {
                for gi in 0:guards.len {
                    plan.exits.push(FastExit{cond_node: guards[gi], want_true: false, ret_node: re})
                }
                skipped[cur_b] = true
                skip_idx[cur_b] = skip_cnt
                skip_cnt += 1
                cur_b = tb
                ->
            }
        }
        <-
    }
    // If all fast-entry guards fell through to cur_b > 0, check whether the
    // slow-path prologue can jump directly to cur_b (skipping redundant entry
    // re-checks) after initializing any constant locals stored in skipped blocks.
    if plan.exits.len > 0 && cur_b > 0 && cur_b < f.blocks.len && !skipped[cur_b] {
        $can_skip := true
        $def_skip_blk := []int{}
        for _ in 0:f.temps.len { def_skip_blk.push(-1) }
        $loc_written := []bool{}
        for _ in 0:f.locals.len { loc_written.push(false) }
        for bi in 0:f.blocks.len {
            if !skipped[bi] { -> }
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if a64_defines(ins.kind) && ins.a >= 0 && ins.a < def_skip_blk.len {
                    if def_skip_blk[ins.a] >= 0 && def_skip_blk[ins.a] != bi {
                        can_skip = false
                    }
                    def_skip_blk[ins.a] = bi
                }
                if ins.kind == mir.MI_STORE_LOCAL {
                    l := ins.a
                    if l < f.nparams || l >= f.locals.len || f.locals[l] != 1 || f.locals_nslots[l] != 1 {
                        can_skip = false
                    } else {
                        loc_written[l] = true
                    }
                }
                ii = ins.next
            }
        }
        if can_skip {
            $reach_slow := []bool{}
            $ext_pred_skip := []bool{}
            for _ in 0:f.blocks.len {
                reach_slow.push(false)
                ext_pred_skip.push(false)
            }
            $rq := []int{}
            reach_slow[cur_b] = true
            rq.push(cur_b)
            $rqi := 0
            while rqi < rq.len {
                u := rq[rqi]
                rqi += 1
                utk := f.blocks[u].tkind
                if utk == mir.TKIND_JUMP {
                    s := f.blocks[u].ta
                    if s >= 0 && s < f.blocks.len {
                        if !skipped[u] && skipped[s] { ext_pred_skip[s] = true }
                        if !reach_slow[s] {
                            reach_slow[s] = true
                            rq.push(s)
                        }
                    }
                } else if utk == mir.TKIND_BRANCH {
                    sb := f.blocks[u].tb
                    if sb >= 0 && sb < f.blocks.len {
                        if !skipped[u] && skipped[sb] { ext_pred_skip[sb] = true }
                        if !reach_slow[sb] {
                            reach_slow[sb] = true
                            rq.push(sb)
                        }
                    }
                    sc := f.blocks[u].tc
                    if sc >= 0 && sc < f.blocks.len {
                        if !skipped[u] && skipped[sc] { ext_pred_skip[sc] = true }
                        if !reach_slow[sc] {
                            reach_slow[sc] = true
                            rq.push(sc)
                        }
                    }
                }
            }
            for bi in 0:f.blocks.len {
                if !reach_slow[bi] { -> }
                $ii := f.blocks[bi].head
                while ii >= 0 {
                    ins := &f.instrs[ii]
                    for t in 0:def_skip_blk.len {
                        if def_skip_blk[t] >= 0 && def_skip_blk[t] != bi && a64_reads_temp(f, ins, t) {
                            if !fv_skip_read_ok(bi, t, &def_skip_blk, &skipped, &skip_idx, &ext_pred_skip, &temp_node, &plan.nodes, ra, f, &loc_written) {
                                can_skip = false
                                <-
                            }
                        }
                    }
                    if !can_skip { <- }
                    ii = ins.next
                }
                if !can_skip { <- }
                tk := f.blocks[bi].tkind
                if (tk == mir.TKIND_BRANCH || tk == mir.TKIND_RETURN) && f.blocks[bi].ta >= 0 &&
                   f.blocks[bi].ta < def_skip_blk.len && def_skip_blk[f.blocks[bi].ta] >= 0 &&
                   def_skip_blk[f.blocks[bi].ta] != bi {
                    if !fv_skip_read_ok(bi, f.blocks[bi].ta, &def_skip_blk, &skipped, &skip_idx, &ext_pred_skip, &temp_node, &plan.nodes, ra, f, &loc_written) {
                        can_skip = false
                        <-
                    }
                }
            }
        }
        if can_skip {
            for l in f.nparams:f.locals.len {
                if loc_written[l] {
                    ln := loc_node[l]
                    if ln < 0 || plan.nodes[ln].kind != FV_CONST {
                        can_skip = false
                        <-
                    }
                    iv := plan.nodes[ln].val
                    plan.init_locals.push(l)
                    plan.init_vals.push(iv)
                }
            }
        }
        if can_skip {
            plan.slow_blk = cur_b
        } else {
            plan.init_locals = []int{}
            plan.init_vals = []int{}
        }
    }
    // If we have two equality base-case exits for param P == 0 -> 0 and param P == 1 -> 1,
    // merge them into a single param P <= 1 -> P exit.
    if plan.exits.len == 2 {
        e0 := &plan.exits[0]
        e1 := &plan.exits[1]
        if e0.want_true && e1.want_true {
            cn0 := e0.cond_node
            cn1 := e1.cond_node
            c0 := &plan.nodes[cn0]
            c1 := &plan.nodes[cn1]
            if c0.kind == FV_BIN && c0.bop == mir.BIN_EQ &&
               c1.kind == FV_BIN && c1.bop == mir.BIN_EQ {
                l0_idx := c0.lhs
                r0_idx := c0.rhs
                l1_idx := c1.lhs
                r1_idx := c1.rhs
                lhs0 := &plan.nodes[l0_idx]
                rhs0 := &plan.nodes[r0_idx]
                lhs1 := &plan.nodes[l1_idx]
                rhs1 := &plan.nodes[r1_idx]
                if lhs0.kind == FV_PARAM && rhs0.kind == FV_CONST && rhs0.val == 0 &&
                   lhs1.kind == FV_PARAM && rhs1.kind == FV_CONST && rhs1.val == 1 &&
                   lhs0.val == lhs1.val {
                    rn0 := e0.ret_node
                    rn1 := e1.ret_node
                    r0 := &plan.nodes[rn0]
                    r1 := &plan.nodes[rn1]
                    r0_is_0 := (r0.kind == FV_CONST && r0.val == 0) || (r0.kind == FV_PARAM && r0.val == lhs0.val)
                    r1_is_1 := (r1.kind == FV_CONST && r1.val == 1) || (r1.kind == FV_PARAM && r1.val == lhs0.val)
                    if r0_is_0 && r1_is_1 {
                        p_node := c0.lhs
                        one_node := c1.rhs
                        le_node := plan.nodes.len
                        plan.nodes.push(FastNode{kind: FV_BIN, val: 0, bop: mir.BIN_LE, lhs: p_node, rhs: one_node})
                        plan.exits = []FastExit{}
                        plan.exits.push(FastExit{cond_node: le_node, want_true: true, ret_node: p_node})
                    }
                }
            }
        }
    }
    << plan
}

fn fv_invert_cmp(op int) int {
    if op == mir.BIN_EQ { << mir.BIN_NE }
    if op == mir.BIN_NE { << mir.BIN_EQ }
    if op == mir.BIN_LT { << mir.BIN_GE }
    if op == mir.BIN_GE { << mir.BIN_LT }
    if op == mir.BIN_LE { << mir.BIN_GT }
    if op == mir.BIN_GT { << mir.BIN_LE }
    << mir.BIN_NE
}

fn a64_fast_sc(i int) int {
    if i == 0 { << 9 }
    if i == 1 { << 10 }
    << 11
}

fn a64_eval_fast_node(cb $&mc.CodeBuffer, nodes &[]FastNode, ni int, sc_idx int) int {
    nd := &nodes[ni]
    if nd.kind == FV_PARAM {
        << nd.val
    }
    if nd.kind == FV_CONST {
        rd := a64_fast_sc(sc_idx)
        a64_mov_imm(cb, rd, nd.val)
        << rd
    }
    lr := a64_eval_fast_node(cb, nodes, nd.lhs, sc_idx)
    rd := a64_fast_sc(sc_idx)
    if (nd.bop == mir.BIN_ADD || nd.bop == mir.BIN_SUB) && nodes[nd.rhs].kind == FV_CONST {
        cv := nodes[nd.rhs].val
        if cv >= 0 && cv <= 4095 {
            if nd.bop == mir.BIN_ADD {
                a64_add_imm(cb, rd, lr, cv)
            } else {
                e32(cb, 0xD1000000 | (cv << 10) | (lr << 5) | rd)
            }
            << rd
        }
    }
    rr := a64_eval_fast_node(cb, nodes, nd.rhs, sc_idx + 1)
    a64_bin(cb, nd.bop, rd, lr, rr)
    << rd
}

fn a64_emit_fast_ret(cb $&mc.CodeBuffer, nodes &[]FastNode, rn int) {
    nd := &nodes[rn]
    if nd.kind == FV_CONST {
        a64_mov_imm(cb, 0, nd.val)
        <<
    }
    if nd.kind == FV_BIN {
        lr := a64_eval_fast_node(cb, nodes, nd.lhs, 0)
        if (nd.bop == mir.BIN_ADD || nd.bop == mir.BIN_SUB) && nodes[nd.rhs].kind == FV_CONST {
            cv := nodes[nd.rhs].val
            if cv >= 0 && cv <= 4095 {
                if nd.bop == mir.BIN_ADD {
                    a64_add_imm(cb, 0, lr, cv)
                } else {
                    e32(cb, 0xD1000000 | (cv << 10) | (lr << 5) | 0)
                }
                <<
            }
        }
        rr := a64_eval_fast_node(cb, nodes, nd.rhs, 1)
        a64_bin(cb, nd.bop, 0, lr, rr)
        <<
    }
    rr := a64_eval_fast_node(cb, nodes, rn, 0)
    if rr != 0 {
        a64_mov(cb, 0, rr)
    }
}

fn a64_emit_fast_guard(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, nodes &[]FastNode, ex &FastExit, lbl string) {
    cn := ex.cond_node
    nd := &nodes[cn]
    if nd.kind == FV_BIN && fv_is_cmp_op(nd.bop) {
        $op := nd.bop
        if !ex.want_true {
            op = fv_invert_cmp(op)
        }
        if (op == mir.BIN_EQ || op == mir.BIN_NE) && nodes[nd.rhs].kind == FV_CONST && nodes[nd.rhs].val == 0 {
            lr := a64_eval_fast_node(cb, nodes, nd.lhs, 0)
            $opc := 0xB4000000
            if op == mir.BIN_NE { opc = 0xB5000000 }
            a64_branch_reloc(cb, relocs, opc | lr, lbl, mc.RELOC_ARM64_COND_BR19)
            <<
        }
        lr := a64_eval_fast_node(cb, nodes, nd.lhs, 0)
        $emitted_cmp := false
        if nodes[nd.rhs].kind == FV_CONST {
            cv := nodes[nd.rhs].val
            enc := a64_imm12_enc(cv)
            if enc >= 0 {
                e32(cb, 0xF100001F | enc | (lr << 5))
                emitted_cmp = true
            } else if cv < 0 && cv >= -16773120 {
                nenc := a64_imm12_enc(0 - cv)
                if nenc >= 0 {
                    e32(cb, 0xB100001F | nenc | (lr << 5))
                    emitted_cmp = true
                }
            }
        }
        if !emitted_cmp {
            rr := a64_eval_fast_node(cb, nodes, nd.rhs, 1)
            a64_cmp(cb, lr, rr)
        }
        a64_branch_reloc(cb, relocs, 0x54000000 | a64_cond_of(op), lbl, mc.RELOC_ARM64_COND_BR19)
        <<
    }
    lr := a64_eval_fast_node(cb, nodes, cn, 0)
    $opc := 0xB5000000
    if !ex.want_true { opc = 0xB4000000 }
    a64_branch_reloc(cb, relocs, opc | lr, lbl, mc.RELOC_ARM64_COND_BR19)
}

fn a64_callee_save_slots(cb $&mc.CodeBuffer, regs &[]int, save_off int, store bool) {
    $pair_op := 0xA9400000 // ldp
    if store { pair_op = 0xA9000000 } // stp
    $i := 0
    while i < regs.len {
        r := regs[i]
        off := save_off + i * 8
        // Register pairs use a signed seven-bit offset scaled by eight.
        // Both registers must already have slots in the allocated frame.
        if r < 32 && off <= 504 && i + 1 < regs.len && regs[i + 1] < 32 {
            a64_pair(cb, pair_op, r, regs[i + 1], R_SP, off)
            i += 2
            ->
        }
        if r >= 32 && off <= 504 && i + 1 < regs.len && regs[i + 1] >= 32 {
            $fpair_op := 0x6D400000 // ldp dt1, dt2, [sp, #off]
            if store { fpair_op = 0x6D000000 } // stp dt1, dt2, [sp, #off]
            a64_pair(cb, fpair_op, r - 32, regs[i + 1] - 32, R_SP, off)
            i += 2
            ->
        }
        if r >= 32 {
            a64_fmem(cb, store, r - 32, R_SP, off)
        } else if store {
            a64_str(cb, r, R_SP, off)
        } else {
            a64_ldr(cb, r, R_SP, off)
        }
        i += 1
    }
}

pub fn isel_fn_arm64_base(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, lines $&[]int, opt bool) {
    ra := a64_ra(f, opt)
    $fr := a64_frame_ra(f, &ra, opt)
    leaf_noframe := can_elide_frame_ex(f, &ra, opt, true)
    $fp_plan := FastPlan{nodes: []FastNode{}, exits: []FastExit{}, slow_blk: -1, init_locals: []int{}, init_vals: []int{}}
    if opt && !leaf_noframe {
        fp_plan = analyze_fast_entry(f, &ra)
    }
    // Saved callee registers sit above the locals and temps; cold-call caller-save area sits above those.
    $save_off := fr.size
    if ra.used_callee.len > 0 {
        fr.size = (fr.size + ra.used_callee.len * 8 + 15) / 16 * 16
    }
    $call_save_off := fr.size
    if ra.max_call_saves > 0 {
        fr.size = (fr.size + ra.max_call_saves * 8 + 15) / 16 * 16
    }
    compact_frame := opt && !leaf_noframe && fr.out_area == 0 && f.nparams <= 8 && fr.size > 0 && fr.size <= 480
    if compact_frame {
        for li in 0:fr.local_off.len {
            if fr.local_off[li] >= 0 { fr.local_off[li] = fr.local_off[li] + 16 }
        }
        for ti in 0:fr.temp_off.len {
            if fr.temp_off[ti] >= 0 { fr.temp_off[ti] = fr.temp_off[ti] + 16 }
        }
        save_off += 16
        call_save_off += 16
        fr.size += 16
    }
    if opt {
        while cb.len() % 16 != 0 {
            e32(cb, 0xD503201F)
        }
    }
    syms.define_label(f.label, cb.len())
    $last_line := f.src_line
    if last_line > 0 {
        lines.push(cb.len())
        lines.push(last_line)
    }
    inline_fast_exit := fp_plan.exits.len > 0 && fp_plan.slow_blk > 0
    if inline_fast_exit {
        prologue_lbl := f.label + ".prologue"
        if fp_plan.exits.len == 1 {
            $inv_ex := FastExit{cond_node: fp_plan.exits[0].cond_node, want_true: !fp_plan.exits[0].want_true, ret_node: fp_plan.exits[0].ret_node}
            a64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &inv_ex, prologue_lbl + "")
            a64_emit_fast_ret(cb, &fp_plan.nodes, fp_plan.exits[0].ret_node)
            e32(cb, 0xD65F03C0)
        } else {
            last_ei := fp_plan.exits.len - 1
            for ei in 0:last_ei {
                a64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &fp_plan.exits[ei], f.label + ".fp" + str(ei))
            }
            $inv_last := FastExit{cond_node: fp_plan.exits[last_ei].cond_node, want_true: !fp_plan.exits[last_ei].want_true, ret_node: fp_plan.exits[last_ei].ret_node}
            a64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &inv_last, prologue_lbl + "")
            a64_emit_fast_ret(cb, &fp_plan.nodes, fp_plan.exits[last_ei].ret_node)
            e32(cb, 0xD65F03C0)
            for ei in 0:last_ei {
                syms.define_label(f.label + ".fp" + str(ei), cb.len())
                a64_emit_fast_ret(cb, &fp_plan.nodes, fp_plan.exits[ei].ret_node)
                e32(cb, 0xD65F03C0)
            }
        }
        syms.define_label(prologue_lbl, cb.len())
    } else {
        for ei in 0:fp_plan.exits.len {
            a64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &fp_plan.exits[ei], f.label + ".fp" + str(ei))
        }
    }
    // Prologue.
    if !leaf_noframe {
        if compact_frame {
            a64_pair(cb, 0xA9800000, 29, 30, R_SP, 0 - fr.size)
            e32(cb, 0x910003FD)
        } else {
            e32(cb, 0xA9BF7BFD)
            e32(cb, 0x910003FD)
            if fr.size > 0 {
                a64_sub_sp(cb, fr.size)
            }
        }
        a64_callee_save_slots(cb, &ra.used_callee, save_off, true)
    }
    a64_copy_params(cb, f, &fr, &ra)
    if fp_plan.slow_blk > 0 {
        for ii in 0:fp_plan.init_locals.len {
            l := fp_plan.init_locals[ii]
            v := fp_plan.init_vals[ii]
            lr := ra.local_reg[l]
            if lr >= 0 && lr < 32 {
                a64_mov_imm(cb, lr, v)
            } else {
                a64_mov_imm(cb, 9, v)
                a64_str(cb, 9, R_SP, fr.local_off[l])
            }
        }
        if !inline_fast_exit {
            a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(fp_plan.slow_blk), mc.RELOC_ARM64_CALL26)
        }
    }
    $strs := []StrFix{}
    $str_aligns := []int{}
    $uses := []int{}
    $idx_mode := []int{}
    $idx_opc := []int{}
    $idx_base := []int{}
    $idx_off := []int{}
    $idx_shift := []int{}
    $sel_mod_kind := []int{}
    $sel_mod_side := []int{}
    $sel_mod_src := []int{}
    if opt {
        uses = temp_use_counts(f)
        a64_prepare_idx(f, &ra, &uses, $&idx_mode, $&idx_opc, $&idx_base, $&idx_off, $&idx_shift)
        a64_prepare_select(f, &ra, &uses, $&idx_mode, $&sel_mod_kind, $&sel_mod_side, $&sel_mod_src)
    }
    $fn_has_addr := false
    if opt {
        for ai in 0:f.instrs.len {
            if f.instrs[ai].kind == mir.MI_ADDR {
                fn_has_addr = true
                <-
            }
        }
    }
    nb_fn := f.blocks.len
    $pred_cnt := []int{}
    $pred_blk := []int{}
    $blk_cmp_kind := []int{}
    $blk_cmp_c := []int{}
    $blk_cmp_d := []int{}
    $blk_cmp_base := []int{}
    $blk_cmp_shift := []int{}
    for _ in 0:nb_fn {
        pred_cnt.push(0)
        pred_blk.push(-1)
        blk_cmp_kind.push(0)
        blk_cmp_c.push(0)
        blk_cmp_d.push(0)
        blk_cmp_base.push(0)
        blk_cmp_shift.push(0)
    }
    if opt {
        for pbi in 0:nb_fn {
            ptk := f.blocks[pbi].tkind
            if ptk == mir.TKIND_JUMP {
                s := f.blocks[pbi].ta
                if s >= 0 && s < nb_fn {
                    pred_cnt[s] = pred_cnt[s] + 1
                    pred_blk[s] = pbi
                }
            } else if ptk == mir.TKIND_BRANCH {
                sb := f.blocks[pbi].tb
                if sb >= 0 && sb < nb_fn {
                    pred_cnt[sb] = pred_cnt[sb] + 1
                    pred_blk[sb] = pbi
                }
                sc := f.blocks[pbi].tc
                if sc >= 0 && sc < nb_fn {
                    pred_cnt[sc] = pred_cnt[sc] + 1
                    pred_blk[sc] = pbi
                }
            }
        }
    }
    $is_loop_hdr := []bool{}
    for _ in 0:nb_fn { is_loop_hdr.push(false) }
    $cold := []bool{}
    $is_ret := []bool{}
    $depth := []int{}
    $blk_pos := []int{}
    $order := []int{}
    if opt {
        depth = mir.block_loop_depth(f)
        $slow := -1
        if inline_fast_exit {
            slow = fp_plan.slow_blk
        }
        $placed := []bool{}
        $hot_pred := []int{}
        $cold_list := []int{}
        $ret_list := []int{}
        for obi in 0:nb_fn {
            $c := false
            if obi > 0 && obi != slow {
                $cii := f.blocks[obi].head
                while cii >= 0 {
                    cins := &f.instrs[cii]
                    if cins.kind == mir.MI_CALL && is_noreturn_call(&f.instrs[cii].sval) {
                        c = true
                        <-
                    }
                    cii = cins.next
                }
            }
            cold.push(c)
            is_ret.push(obi > 0 && obi != slow && !c && f.blocks[obi].tkind == mir.TKIND_RETURN)
            placed.push(false)
            hot_pred.push(0)
        }
        if inline_fast_exit && slow > 0 && slow < nb_fn {
            $reach_s := []bool{}
            for _ in 0:nb_fn { reach_s.push(false) }
            $rq := []int{}
            reach_s[slow] = true
            rq.push(slow)
            $rqi := 0
            while rqi < rq.len {
                u := rq[rqi]
                rqi += 1
                utk := f.blocks[u].tkind
