                    $rd := a64_dst(&ra, ins.a, 9)
                    if ret_direct { rd = 0 }
                    e32(cb, 0x9E780000 | (fx << 5) | rd)
                    if ret_direct { ret_done = true }
                    else { a64_put(cb, &fr, &ra, ins.a, rd) }
                } else if ins.b == mir.UN_FSQRT {
                    fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                    fd := a64_fdst(&ra, ins.a, 0)
                    e32(cb, 0x1E61C000 | (fx << 5) | fd)
                    a64_put(cb, &fr, &ra, ins.a, 32 + fd)
                } else if ins.b == mir.UN_F32_LOAD {
                    // fmov s2, wn ; fcvt d2, s2 ; fmov xd, d2 (v0-v2 are
                    // never allocated)
                    rn := a64_src(cb, f, &fr, &ra, ins.c, 9)
                    e32(cb, 0x1E270000 | (rn << 5) | 2)
                    e32(cb, 0x1E22C000 | (2 << 5) | 2)
                    $rd := a64_dst(&ra, ins.a, 9)
                    if ret_direct { rd = 0 }
                    e32(cb, 0x9E660000 | (2 << 5) | rd)
                    if ret_direct { ret_done = true }
                    else { a64_put(cb, &fr, &ra, ins.a, rd) }
                } else if ins.b == mir.UN_F32_STORE {
                    // fmov d2, xn ; fcvt s2, d2 ; fmov wd, s2
                    rn := a64_src(cb, f, &fr, &ra, ins.c, 9)
                    e32(cb, 0x9E670000 | (rn << 5) | 2)
                    e32(cb, 0x1E624000 | (2 << 5) | 2)
                    $rd := a64_dst(&ra, ins.a, 9)
                    if ret_direct { rd = 0 }
                    e32(cb, 0x1E260000 | (2 << 5) | rd)
                    if ret_direct { ret_done = true }
                    else { a64_put(cb, &fr, &ra, ins.a, rd) }
                } else {
                    e32(cb, 0xD4200000)
                }
            } else if k == mir.MI_SELECT {
                // [cmp xc, #0]; csel xd, xthen, xelse, cond (operand loads
                // between the compare and csel leave the flags alone).
                $cond := -1
                if sel_cond >= 0 && ins.b == sel_cond_t {
                    cond = sel_cond
                    sel_rem -= 1
                    if sel_rem <= 0 {
                        sel_cond = -1
                        sel_cond_t = -1
                    }
                } else {
                    sel_cond = -1
                    sel_cond_t = -1
                    sel_rem = 0
                    rc := a64_src(cb, f, &fr, &ra, ins.b, 9)
                    e32(cb, 0xF100001F | (rc << 5))
                    cond = target.ARM64_COND_NE
                }
                if a64_temp_reg(&ra, ins.a) >= 32 {
                    fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                    fm := a64_fsrc(cb, f, &fr, &ra, ins.d, 1)
                    fd := a64_fdst(&ra, ins.a, 0)
                    e32(cb, 0x1E600C00 | (fm << 16) | (cond << 12) | (fx << 5) | fd)
                    a64_put(cb, &fr, &ra, ins.a, 32 + fd)
                } else {
                    $rd := a64_dst(&ra, ins.a, 9)
                    if ret_direct { rd = 0 }
                    $mk := 0
                    if opt && ii < sel_mod_kind.len { mk = sel_mod_kind[ii] }
                    if mk > 0 {
                        mod_side := sel_mod_side[ii]
                        xv := sel_mod_src[ii]
                        rx := a64_temp_reg(&ra, xv)
                        $other := ins.d
                        if mod_side == 1 { other = ins.c }
                        $rn := 31
                        if !a64_is_const_eq(f, other, 0) {
                            rn = a64_src(cb, f, &fr, &ra, other, 10)
                        }
                        $c_enc := cond
                        if mod_side == 0 { c_enc = cond ^ 1 }
                        $base_sel := 0x9A800400
                        if mk == 2 { base_sel = 0xDA800000 }
                        else if mk == 3 { base_sel = 0xDA800400 }
                        e32(cb, base_sel | (rx << 16) | (c_enc << 12) | (rn << 5) | rd)
                    } else if opt && a64_is_const_eq(f, ins.d, 1) {
                        $rn := 31
                        if !a64_is_const_eq(f, ins.c, 0) {
                            rn = a64_src(cb, f, &fr, &ra, ins.c, 10)
                        }
                        e32(cb, 0x9A800400 | (31 << 16) | (cond << 12) | (rn << 5) | rd)
                    } else if opt && a64_is_const_eq(f, ins.c, 1) {
                        $rn := 31
                        if !a64_is_const_eq(f, ins.d, 0) {
                            rn = a64_src(cb, f, &fr, &ra, ins.d, 11)
                        }
                        e32(cb, 0x9A800400 | (31 << 16) | ((cond ^ 1) << 12) | (rn << 5) | rd)
                    } else if opt && a64_is_const_eq(f, ins.d, -1) {
                        $rn := 31
                        if !a64_is_const_eq(f, ins.c, 0) {
                            rn = a64_src(cb, f, &fr, &ra, ins.c, 10)
                        }
                        e32(cb, 0xDA800000 | (31 << 16) | (cond << 12) | (rn << 5) | rd)
                    } else if opt && a64_is_const_eq(f, ins.c, -1) {
                        $rn := 31
                        if !a64_is_const_eq(f, ins.d, 0) {
                            rn = a64_src(cb, f, &fr, &ra, ins.d, 11)
                        }
                        e32(cb, 0xDA800000 | (31 << 16) | ((cond ^ 1) << 12) | (rn << 5) | rd)
                    } else {
                        $rn := 31
                        if ins.c > -2 || f.consts[0 - ins.c - 2] != 0 {
                            rn = a64_src(cb, f, &fr, &ra, ins.c, 10)
                        }
                        $rm := 31
                        if ins.d > -2 || f.consts[0 - ins.d - 2] != 0 {
                            rm = a64_src(cb, f, &fr, &ra, ins.d, 11)
                        }
                        e32(cb, 0x9A800000 | (rm << 16) | (cond << 12) | (rn << 5) | rd)
                    }
                    if ret_direct { ret_done = true }
                    else { a64_put(cb, &fr, &ra, ins.a, rd) }
                }
            } else if k == mir.MI_VLOAD128 {
                rn := a64_src(cb, f, &fr, &ra, ins.b, 9)
                vd := a64_vdst(&ra, ins.a, 0)
                a64_qmem(cb, false, vd, rn, ins.c)
                a64_vput(cb, &fr, &ra, ins.a, vd)
            } else if k == mir.MI_VSTORE128 {
                rn := a64_src(cb, f, &fr, &ra, ins.a, 9)
                vs := a64_vsrc(cb, &fr, &ra, ins.b, 0)
                a64_qmem(cb, true, vs, rn, ins.c)
            } else if k == mir.MI_VBIN128 {
                vl := a64_vsrc(cb, &fr, &ra, ins.c, 0)
                vr := a64_vsrc(cb, &fr, &ra, ins.d, 1)
                vd := a64_vdst(&ra, ins.a, 2)
                a64_vbin(cb, ins.b, vd, vl, vr)
                a64_vput(cb, &fr, &ra, ins.a, vd)
            } else if k == mir.MI_VPACK128 {
                vd := a64_vdst(&ra, ins.a, 2)
                rb := a64_temp_reg(&ra, ins.b)
                if ins.d == 0 {
                    if rb >= 32 {
                        e32(cb, 0x4E080400 | ((rb - 32) << 5) | vd)
                    } else {
                        xb := a64_src(cb, f, &fr, &ra, ins.b, 9)
                        e32(cb, 0x4E080C00 | (xb << 5) | vd)
                    }
                } else {
                    if rb >= 32 {
                        if vd != rb - 32 {
                            a64_fmov_dd(cb, vd, rb - 32)
                        }
                    } else {
                        xb := a64_src(cb, f, &fr, &ra, ins.b, 9)
                        e32(cb, 0x4E081C00 | (xb << 5) | vd)
                    }
                    rc := a64_temp_reg(&ra, ins.c)
                    if rc >= 32 {
                        e32(cb, 0x6E180400 | ((rc - 32) << 5) | vd)
                    } else {
                        xc := a64_src(cb, f, &fr, &ra, ins.c, 9)
                        e32(cb, 0x4E181C00 | (xc << 5) | vd)
                    }
                }
                a64_vput(cb, &fr, &ra, ins.a, vd)
            } else if k == mir.MI_VEXTRACT {
                vs := a64_vsrc(cb, &fr, &ra, ins.b, 0)
                rd_reg := a64_temp_reg(&ra, ins.a)
                if ins.d == 0 {
                    rd := a64_dst(&ra, ins.a, 9)
                    if ins.c == mir.BIN_ADD {
                        e32(cb, 0x5EF1B800 | (vs << 5) | 1)
                        a64_fmov_xd(cb, rd, 1)
                    } else {
                        a64_fmov_xd(cb, 9, vs)
                        e32(cb, 0x4E183C00 | (vs << 5) | 10)
                        a64_bin(cb, ins.c, rd, 9, 10)
                    }
                    a64_put(cb, &fr, &ra, ins.a, rd)
                } else if rd_reg >= 32 {
                    fd := rd_reg - 32
                    if ins.d == 1 {
                        if fd != vs {
                            a64_fmov_dd(cb, fd, vs)
                        }
                    } else {
                        e32(cb, 0x5E180400 | (vs << 5) | fd)
                    }
                } else {
                    rd := a64_dst(&ra, ins.a, 9)
                    if ins.d == 1 {
                        a64_fmov_xd(cb, rd, vs)
                    } else {
                        e32(cb, 0x4E183C00 | (vs << 5) | rd)
                    }
                    a64_put(cb, &fr, &ra, ins.a, rd)
                }
            } else if k == mir.MI_COPY {
                if !ret_direct && opt && ins.a >= 0 && ins.a < ra.remat_const.len && ra.remat_const[ins.a] >= 0 {
                } else if ret_direct {
                    a64_load_to(cb, f, &fr, &ra, 0, ins.b)
                    ret_done = true
                } else {
                    r := a64_temp_reg(&ra, ins.a)
                    if r >= 0 {
                        a64_load_to(cb, f, &fr, &ra, r, ins.b)
                    } else if a64_temp_reg(&ra, ins.b) >= 32 {
                        if ins.a >= 0 && ins.a < fr.temp_off.len && fr.temp_off[ins.a] >= 0 {
                            a64_fmem(cb, true, a64_temp_reg(&ra, ins.b) - 32, R_SP, fr.temp_off[ins.a])
                        }
                    } else {
                        rs := a64_src(cb, f, &fr, &ra, ins.b, 9)
                        a64_set_temp(cb, &fr, ins.a, rs)
                    }
                }
            } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
                if opt {
                    $args := []int{}
                    $a := ins.c
                    while a >= 0 {
                        args.push(f.margs[a].v)
                        a = f.margs[a].next
                    }
                    $bits_arity := 0
                    if k == mir.MI_CALL {
                        bits_arity = a64_bits_arity(&ins.sval)
                    }
                    if bits_arity > 0 && args.len == bits_arity {
                        if !(ins.a >= 0 && ins.a < uses.len && uses[ins.a] == 0) {
                            rn := a64_src(cb, f, &fr, &ra, args[0], 9)
                            $rm := 0
                            if args.len == 2 {
                                rm = a64_src(cb, f, &fr, &ra, args[1], 10)
                            }
                            $rd := a64_dst(&ra, ins.a, 9)
                            if ret_direct { rd = 0 }
                            a64_bits_call_regs(cb, &ins.sval, rd, rn, rm)
                            if ret_direct { ret_done = true }
                            else { a64_put(cb, &fr, &ra, ins.a, rd) }
                        }
                    } else {
                        can_tail := k == mir.MI_CALL && !fn_has_addr && !is_noreturn_call(&ins.sval) &&
                                    !bits_hw_entry(&ins.sval, true) && args.len <= 8 && f.nparams <= 8 &&
                                    f.name != "_start" && f.label != "_start" && !(f.name.len >= 6 && f.name[0:6] == "naked_") &&
                                    f.blocks[bi].tkind == mir.TKIND_RETURN && ins.a >= 0 && ins.a < uses.len &&
                                    uses[ins.a] == 1 && f.blocks[bi].ta == ins.a && a64_is_last_real(f, &idx_mode, ii)
                        if can_tail {
                            a64_copy_call_args(cb, f, &fr, &ra, &args, false, -1)
                            if !leaf_noframe {
                                a64_callee_save_slots(cb, &ra.used_callee, save_off, false)
                                if compact_frame {
                                    a64_pair(cb, 0xA8C00000, 29, 30, R_SP, fr.size)
                                } else {
                                    if fr.size > 0 {
                                        e32(cb, 0x910003BF)
                                    }
                                    e32(cb, 0xA8C17BFD)
                                }
                            }
                            a64_branch_reloc(cb, relocs, 0x14000000, ins.sval, mc.RELOC_ARM64_CALL26)
                            ret_done = true
                            tail_done = true
                        } else {
                            $cs_regs := []int{}
                            if ii < ra.call_save_len.len && ra.call_save_len[ii] > 0 {
                                cs_off := ra.call_save_off[ii]
                                cs_len := ra.call_save_len[ii]
                                for ci2 in 0:cs_len {
                                    cs_regs.push(ra.call_save_regs[cs_off + ci2])
                                }
                                a64_callee_save_slots(cb, &cs_regs, call_save_off, true)
                            }
                            a64_copy_call_args(cb, f, &fr, &ra, &args, k == mir.MI_CALL_IND, ins.b)
                            if k == mir.MI_CALL_IND {
                                // blr x16
                                e32(cb, 0xD63F0000 | (R_IP0 << 5))
                            } else if !a64_bits_call(cb, &ins.sval) {
                                a64_branch_reloc(cb, relocs, 0x94000000, ins.sval, mc.RELOC_ARM64_CALL26)
                            }
                            if ret_direct {
                                ret_done = true
                            } else if !(ins.a >= 0 && ins.a < uses.len && uses[ins.a] == 0) {
                                a64_put(cb, &fr, &ra, ins.a, 0)
                            }
                            if cs_regs.len > 0 {
                                a64_callee_save_slots(cb, &cs_regs, call_save_off, false)
                            }
                        }
                    }
                } else {
                    $a := ins.c
                    $i := 0
                    while a >= 0 {
                        if i < 8 {
                            a64_load_to(cb, f, &fr, &ra, i, f.margs[a].v)
                        } else {
                            sr := a64_temp_reg(&ra, f.margs[a].v)
                            if sr >= 32 {
                                a64_fmem(cb, true, sr - 32, R_SP, (i - 8) * 8)
                            } else {
                                rs := a64_src(cb, f, &fr, &ra, f.margs[a].v, 9)
                                a64_str(cb, rs, R_SP, (i - 8) * 8)
                            }
                        }
                        i += 1
                        a = f.margs[a].next
                    }
                    if k == mir.MI_CALL_IND {
                        // blr x16
                        a64_load_to(cb, f, &fr, &ra, R_IP0, ins.b)
                        e32(cb, 0xD63F0000 | (R_IP0 << 5))
                    } else {
                        a64_branch_reloc(cb, relocs, 0x94000000, ins.sval, mc.RELOC_ARM64_CALL26)
                    }
                    if ret_direct {
                        ret_done = true
                    } else {
                        a64_put(cb, &fr, &ra, ins.a, 0)
                    }
                }
            } else if k == mir.MI_STR_CONST {
                strs.push(StrFix{adr_off: cb.len(), bytes: ins.sval + ""})
                str_aligns.push(ins.d)
                e32(cb, 0x10000000 | 9)
                a64_put(cb, &fr, &ra, ins.a, 9)
            } else if k == mir.MI_LOAD_FN_ADDR {
                $rd := 9
                if ret_direct { rd = 0 }
                a64_fn_addr(cb, relocs, rd, ins.sval)
                if ret_direct { ret_done = true }
                else { a64_put(cb, &fr, &ra, ins.a, rd) }
            } else if k == mir.MI_ASM {
                s := ins.sval
                if s == "wfi" {
                    e32(cb, 0xD503207F)
                } else if s == "wfe" {
                    e32(cb, 0xD503205F)
                } else if s == "nop" {
                    e32(cb, 0xD503201F)
                } else if s == "pause" || s == "yield" {
                    e32(cb, 0xD503203F)
                } else if s == "cli" {
                    e32(cb, 0xD50342DF) // msr daifset, #2
                } else if s == "sti" {
                    e32(cb, 0xD503425F) // msr daifclr, #2
                } else if s == "isb" {
                    e32(cb, 0xD5033FDF)
                } else if s == "dmb sy" {
                    e32(cb, 0xD5033F5F)
                } else if s == "dsb sy" {
                    e32(cb, 0xD5033F9F)
                } else {
                    e32(cb, 0xD503201F)
                }
            } else {
                // Unknown kinds are a lowering bug; trap loudly at run time.
                e32(cb, 0xD4200000)
            }
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        $invert_br := false
        if blk.tkind == mir.TKIND_BRANCH {
            invert_br = blk.tb == next_bi
            if !invert_br && opt && blk.tc != next_bi && blk_pos.len == nb_fn {
                $cur_d := 0
                if depth.len == nb_fn { cur_d = depth[bi] }
                tb_back := blk.tb >= 0 && blk.tb < nb_fn && blk_pos[blk.tb] >= 0 && blk_pos[blk.tb] <= oi
                tc_back := blk.tc >= 0 && blk.tc < nb_fn && blk_pos[blk.tc] >= 0 && blk_pos[blk.tc] <= oi
                tb_cold := blk.tb >= 0 && blk.tb < nb_fn && (cold[blk.tb] || is_ret[blk.tb] || (depth.len == nb_fn && depth[blk.tb] < cur_d))
                tc_cold := blk.tc >= 0 && blk.tc < nb_fn && (cold[blk.tc] || is_ret[blk.tc] || (depth.len == nb_fn && depth[blk.tc] < cur_d))
                if (tc_back && !tb_back) || (tb_cold && !tc_cold && !tb_back) {
                    invert_br = true
                }
            }
        }
        if blk.tkind == mir.TKIND_RETURN {
            if !tail_done {
                if !ret_done {
                    a64_load_to(cb, f, &fr, &ra, 0, blk.ta)
                }
                if leaf_noframe {
                    e32(cb, 0xD65F03C0)
                } else if oi + 1 < order.len {
                    a64_branch_reloc(cb, relocs, 0x14000000, epilogue, mc.RELOC_ARM64_CALL26)
                }
            }
        } else if blk.tkind == mir.TKIND_JUMP {
            if blk.ta != next_bi {
                a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.ta), mc.RELOC_ARM64_CALL26)
            }
        } else if blk.tkind == mir.TKIND_BRANCH && bounds.len > 0 {
            a64_cmp_vals(cb, f, &fr, &ra, bounds[3], bounds[4])
            // b.hs / b.lo
            if invert_br {
                a64_branch_reloc(cb, relocs, 0x54000003, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_COND_BR19)
                if blk.tb != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_CALL26)
                }
            } else {
                a64_branch_reloc(cb, relocs, 0x54000002, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_COND_BR19)
                if blk.tc != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_CALL26)
                }
            }
        } else if blk.tkind == mir.TKIND_BRANCH && fused_cbz_v >= 0 {
            rc := a64_src(cb, f, &fr, &ra, fused_cbz_v, 9)
            if invert_br {
                $op_cb := 0xB4000000
                if fused_cbz_eq { op_cb = 0xB5000000 }
                a64_branch_reloc(cb, relocs, op_cb | rc, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_COND_BR19)
                if blk.tb != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_CALL26)
                }
            } else {
                $op_cb := 0xB5000000
                if fused_cbz_eq { op_cb = 0xB4000000 }
                a64_branch_reloc(cb, relocs, op_cb | rc, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_COND_BR19)
                if blk.tc != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_CALL26)
                }
            }
        } else if blk.tkind == mir.TKIND_BRANCH && fused >= 0 {
            if last_cmp_kind > 0 {
                blk_cmp_kind[bi] = last_cmp_kind
                blk_cmp_c[bi] = last_cmp_c
                blk_cmp_d[bi] = last_cmp_d
                blk_cmp_base[bi] = last_cmp_base
                blk_cmp_shift[bi] = last_cmp_shift
            }
            if invert_br {
                a64_branch_reloc(cb, relocs, 0x54000000 | (fused ^ 1), f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_COND_BR19)
                if blk.tb != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_CALL26)
                }
            } else {
                a64_branch_reloc(cb, relocs, 0x54000000 | fused, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_COND_BR19)
                if blk.tc != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_CALL26)
                }
            }
        } else if blk.tkind == mir.TKIND_BRANCH {
            rc := a64_src(cb, f, &fr, &ra, blk.ta, 9)
            if invert_br {
                a64_branch_reloc(cb, relocs, 0xB4000000 | rc, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_COND_BR19)
                if blk.tb != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_CALL26)
                }
            } else {
                a64_branch_reloc(cb, relocs, 0xB5000000 | rc, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_COND_BR19)
                if blk.tc != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_CALL26)
                }
            }
        } else {
            // Open block at function end: return 0.
            a64_mov_imm(cb, 0, 0)
            if leaf_noframe {
                e32(cb, 0xD65F03C0)
            } else if oi + 1 < order.len {
                a64_branch_reloc(cb, relocs, 0x14000000, epilogue, mc.RELOC_ARM64_CALL26)
            }
        }
    }
    syms.define_label(epilogue, cb.len())
    if !leaf_noframe {
        a64_callee_save_slots(cb, &ra.used_callee, save_off, false)
        if compact_frame {
            a64_pair(cb, 0xA8C00000, 29, 30, R_SP, fr.size)
        } else {
            if fr.size > 0 {
                e32(cb, 0x910003BF)
            }
            e32(cb, 0xA8C17BFD)
        }
    }
    e32(cb, 0xD65F03C0)
    if !inline_fast_exit {
        for ei in 0:fp_plan.exits.len {
            syms.define_label(f.label + ".fp" + str(ei), cb.len())
            a64_emit_fast_ret(cb, &fp_plan.nodes, fp_plan.exits[ei].ret_node)
            e32(cb, 0xD65F03C0)
        }
    }
    // String literal pool, patched into the ADR instructions above.
    for si in 0:strs.len {
        if si < str_aligns.len && str_aligns[si] == 8 {
            while cb.len() % 8 != 0 {
                cb.emit_u8(0)
            }
        }
        pos := cb.len()
        s := strs[si].bytes
        for bi2 in 0:s.len {
            cb.emit_u8(s[bi2])
        }
        cb.emit_u8(0)
        while cb.len() % 4 != 0 {
            cb.emit_u8(0)
        }
        at := strs[si].adr_off
        disp := pos - at
        word := 0x10000000 | ((disp & 3) << 29) | (((disp >> 2) & 0x7ffff) << 5) | 9
        cb.patch_u32_le(at, word)
    }
}

fn a64_pair(cb $&mc.CodeBuffer, base int, rt int, rt2 int, rn int, off int) {
    e32(cb, base | (((off / 8) & 0x7f) << 15) | (rt2 << 10) | (rn << 5) | rt)
}

// Task context layout (runtime/core chan.xu): x19-x28 at 0, fp/lr at 80,
// sp at 96, d8-d15 at 104.
fn emit_arm64_task_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    // __xu_task_switch(from x0, to x1): save the callee-saved state into
    // from, resume to.
    syms.define_label("switch_context", cb.len())
    syms.define_label("__xu_task_switch", cb.len())
    for i in 0:6 {
        a64_pair(cb, 0xA9000000, 19 + i * 2, 20 + i * 2, 0, i * 16)
    }
    a64_add_imm(cb, 9, R_SP, 0)
    a64_str(cb, 9, 0, 96)
    for i in 0:4 {
        a64_pair(cb, 0x6D000000, 8 + i * 2, 9 + i * 2, 0, 104 + i * 16)
    }
    for i in 0:6 {
        a64_pair(cb, 0xA9400000, 19 + i * 2, 20 + i * 2, 1, i * 16)
    }
    a64_ldr(cb, 9, 1, 96)
    a64_add_imm(cb, R_SP, 9, 0)
    for i in 0:4 {
        a64_pair(cb, 0x6D400000, 8 + i * 2, 9 + i * 2, 1, 104 + i * 16)
    }
    e32(cb, 0xD65F03C0)

    // Hardware and architecture intrinsics for baremetal kernels
    syms.define_label("in8", cb.len())
    syms.define_label("in16", cb.len())
    syms.define_label("in32", cb.len())
    syms.define_label("read_cr2", cb.len())
    syms.define_label("read_cr3", cb.len())
    a64_mov_imm(cb, 0, 0)
    e32(cb, 0xD65F03C0) // ret

    syms.define_label("out8", cb.len())
    syms.define_label("out16", cb.len())
    syms.define_label("out32", cb.len())
    syms.define_label("load_idt", cb.len())
    syms.define_label("write_cr3", cb.len())
    syms.define_label("invlpg", cb.len())
    syms.define_label("set_trap_vector", cb.len())
    e32(cb, 0xD65F03C0) // ret

    syms.define_label("set_vbar", cb.len())
    e32(cb, 0xD518C000) // msr vbar_el1, x0
    e32(cb, 0xD65F03C0) // ret

    syms.define_label("syscall_entry", cb.len())
    e32(cb, 0xD69F03E0) // eret

    // __xu_task_entry: first frame of a task. x19 = task, x20 = function,
    // x21 = 16 argument words, x22 = exit function (never returns).
    syms.define_label("__xu_task_entry", cb.len())
    a64_sub_sp(cb, 64)
    for i in 0:8 {
        a64_ldr(cb, 9, 21, 64 + i * 8)
        a64_str(cb, 9, R_SP, i * 8)
    }
    for i in 0:8 {
        a64_ldr(cb, i, 21, i * 8)
    }
    e32(cb, 0xD63F0000 | (20 << 5))
    a64_add_imm(cb, R_SP, R_SP, 64)
    a64_mov(cb, 0, 19)
    e32(cb, 0xD63F0000 | (22 << 5))
    e32(cb, 0xD4200000)

    // The saved x21 is the argument itself.
    syms.define_label("__xu_task_entry_word", cb.len())
    a64_mov(cb, 0, 21)
    e32(cb, 0xD63F0000 | (20 << 5))
    a64_mov(cb, 0, 19)
    e32(cb, 0xD63F0000 | (22 << 5))
    e32(cb, 0xD4200000)
}

// Process entry, raw system call and runtime-state accessor shared by all
// functions. tgt_os uses target.OS_* codes.
pub fn emit_arm64_runtime_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, tgt_os int, main_label string, link_ui bool, emit_object bool, uses_ffi bool) {
    if tgt_os == target.OS_NONE {
        syms.define_label("__xu_start", cb.len())
        syms.define_label("_start", cb.len())
        a64_branch_reloc(cb, relocs, 0x94000000, main_label, mc.RELOC_ARM64_CALL26)
        syms.define_label("__xu_hang", cb.len())
        e32(cb, 0xD503207F) // wfi
        a64_branch_reloc(cb, relocs, 0x14000000, "__xu_hang", mc.RELOC_ARM64_CALL26)
        syms.define_label("__xu_globals", cb.len())
        a64_mov_imm(cb, 0, 0)
        e32(cb, 0xD65F03C0) // ret
        syms.define_label("__xu_syscall", cb.len())
        a64_mov_imm(cb, 0, -1)
        e32(cb, 0xD65F03C0) // ret
        syms.define_label("_runtime_core_missing_rt_panic", cb.len())
        syms.define_label("_runtime_core_missing_index_panic", cb.len())
        e32(cb, 0xD503207F) // wfi
        a64_branch_reloc(cb, relocs, 0x14000000, "__xu_hang", mc.RELOC_ARM64_CALL26)
        syms.define_label("_runtime_core_missing_str_free", cb.len())
        e32(cb, 0xD65F03C0) // ret
        emit_arm64_task_stubs(cb, syms, relocs)
        <<
    }
    linux := tgt_os == target.OS_LINUX
    // __xu_start: keep argc/argv/envp, map the state block into x28, run
    // main, exit with its result.
    syms.define_label("__xu_start", cb.len())
    if linux && emit_object {
        // Both Linux C entries receive argc, argv and the current envp.
        syms.define_label("xu_app_start", cb.len())
        e32(cb, 0x2A0003E0) // mov w0, w0 (C int argc)
    }
    if linux && !emit_object {
        a64_ldr(cb, 19, R_SP, 0)
        a64_add_imm(cb, 20, R_SP, 8)
        // envp = argv + 8 * (argc + 1)
        e32(cb, 0x8B000000 | (19 << 16) | (3 << 10) | (20 << 5) | 21)
        a64_add_imm(cb, 21, 21, 8)
    } else {
        a64_mov(cb, 19, 0)
        a64_mov(cb, 20, 1)
        a64_mov(cb, 21, 2)
    }
    a64_mov_imm(cb, 0, 0)
    a64_mov_imm(cb, 1, 65536)
    a64_mov_imm(cb, 2, 3)
    a64_mov_imm(cb, 4, -1)
    a64_mov_imm(cb, 5, 0)
    if linux {
        a64_mov_imm(cb, 3, 34)
        a64_mov_imm(cb, 8, 222)
        e32(cb, 0xD4000001)
    } else {
        a64_mov_imm(cb, 3, 4098)
        a64_mov_imm(cb, 16, 197)
        e32(cb, 0xD4001001)
    }
    a64_mov(cb, R_STATE, 0)
    a64_str(cb, 19, R_STATE, 0)
    a64_str(cb, 20, R_STATE, 8)
    a64_str(cb, 21, R_STATE, 32)
    if linux && !emit_object && (syms.lookup_offset(AES_SUPPORTED) >= 0 || syms.lookup_offset(SHA256_SUPPORTED) >= 0) {
        a64_linux_save_hwcap(cb, syms, relocs)
    }
    if link_ui {
        a64_mov_imm(cb, 0, 1)
        a64_str(cb, 0, R_STATE, uiabi.STATE_OFFSET)
    }
    a64_branch_reloc(cb, relocs, 0x94000000, main_label, mc.RELOC_ARM64_CALL26)
    if linux {
        a64_mov_imm(cb, 8, 94)
        e32(cb, 0xD4000001)
    } else {
        a64_mov_imm(cb, 16, 1)
        e32(cb, 0xD4001001)
    }
    // __xu_syscall(nr, a, b, c, d, e, f) -> result or -errno.
    // nr -1 is the runtime's task switch: (from task, to task).
    // nr -2 returns the caller's frame pointer, nr -3 the address of
    // __xu_start (backtraces). nr -4 copies c > 0 bytes from b to a,
    // forward; nr -5 zeroes b > 0 bytes at a.
    if link_ui {
        $prefix := "_"
        if linux { prefix = "" }
        emit_arm64_ui_dispatch(cb, syms, relocs, prefix)
    } else {
        syms.define_label("__xu_syscall", cb.len())
    }
    if !linux {
        emit_macos_arm64_clock(cb, syms, relocs, emit_object)
    }
    emit_arm64_pseudo_calls(cb, syms, relocs, tgt_os, emit_object, uses_ffi)
    if linux {
        a64_mov(cb, 8, 0)
    } else {
        a64_mov(cb, 16, 0)
    }
    for i in 0:6 {
        a64_mov(cb, i, i + 1)
    }
    if linux {
        e32(cb, 0xD4000001)
    } else {
        e32(cb, 0xD4001001)
        // fork and pipe return a second word in x1 (runtime G_SYS_R1).
        a64_str(cb, 1, R_STATE, 40)
        // b.cc +8 ; neg x0, x0  (carry set means x0 holds errno)
        e32(cb, 0x54000043)
        e32(cb, 0xCB0003E0)
    }
    e32(cb, 0xD65F03C0)
    emit_arm64_globals(cb, syms)
    if uses_ffi && emit_object && tgt_os != target.OS_WINDOWS {
        emit_arm64_ffi_tramps(cb, syms, relocs, tgt_os)
    }
}

fn a64_linux_save_hwcap(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    // The initial environment vector ends with NULL, followed by the
    // (type, value) pairs of the auxiliary vector.
    a64_mov(cb, 9, 21)
    syms.define_label("__xu_hwcap_env", cb.len())
    e32(cb, 0xF840852A) // ldr x10, [x9], #8
    a64_branch_reloc(cb, relocs, 0xB500000A, "__xu_hwcap_env", mc.RELOC_ARM64_COND_BR19)
    syms.define_label("__xu_hwcap_aux", cb.len())
    a64_ldr(cb, 10, 9, 0)
    a64_branch_reloc(cb, relocs, 0xB400000A, "__xu_hwcap_done", mc.RELOC_ARM64_COND_BR19)
    e32(cb, 0xF100001F | (16 << 10) | (10 << 5)) // cmp x10, #16 (AT_HWCAP)
    a64_ldr(cb, 11, 9, 8)
    a64_add_imm(cb, 9, 9, 16)
    a64_branch_reloc(cb, relocs, 0x54000001, "__xu_hwcap_aux", mc.RELOC_ARM64_COND_BR19)
    a64_str(cb, 11, R_STATE, A64_HWCAP_OFFSET)
    syms.define_label("__xu_hwcap_done", cb.len())
}

// Dispatch shared pseudo-calls before falling through to the host bridge.
fn emit_arm64_pseudo_calls(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, tgt_os int, emit_object bool, uses_ffi bool) {
    // cmn x0, #5 ; b.ne past the zeroing
    e32(cb, 0xB100141F)
    a64_branch_reloc(cb, relocs, 0x54000001, "__xu_syscall_after_zero", mc.RELOC_ARM64_COND_BR19)
    // cmp x2, #64 ; b.lt zero16
    e32(cb, 0xF101005F)
    a64_branch_reloc(cb, relocs, 0x5400000B, "__xu_syscall_zero16", mc.RELOC_ARM64_COND_BR19)
    e32(cb, 0x6E201C00) // eor v0.16b, v0.16b, v0.16b
    syms.define_label("__xu_syscall_zero64", cb.len())
    e32(cb, 0xAD000020) // stp q0, q0, [x1]
    e32(cb, 0xAD010020) // stp q0, q0, [x1, #32]
    a64_add_imm(cb, 1, 1, 64)
    e32(cb, 0xD1010042) // sub x2, x2, #64
    e32(cb, 0xF101005F) // cmp x2, #64
    a64_branch_reloc(cb, relocs, 0x5400000A, "__xu_syscall_zero64", mc.RELOC_ARM64_COND_BR19)
    syms.define_label("__xu_syscall_zero16", cb.len())
    // subs x2, x2, #16 ; b.lt tail ; stp xzr, xzr, [x1], #16 ; b loop
    e32(cb, 0xF1004042)
    e32(cb, 0x54000000 | (3 << 5) | 11)
    e32(cb, 0xA8817C3F)
    e32(cb, 0x14000000 | (-3 & 0x3FFFFFF))
    // tail: adds x2, x2, #16 ; branchless 8/4/2/1 stores ; ret
    e32(cb, 0xB1004042)
    e32(cb, 0x36180042) // tbz x2, #3, +2
    e32(cb, 0xF800843F) // str xzr, [x1], #8
    e32(cb, 0x36100042) // tbz x2, #2, +2
    e32(cb, 0xB800443F) // str wzr, [x1], #4
    e32(cb, 0x36080042) // tbz x2, #1, +2
    e32(cb, 0x7800243F) // strh wzr, [x1], #2
    e32(cb, 0x36000042) // tbz x2, #0, +2
    e32(cb, 0x3900003F) // strb wzr, [x1]
    e32(cb, 0xD65F03C0)
    syms.define_label("__xu_syscall_after_zero", cb.len())
    // cmn x0, #4 ; b.ne past the copy
    e32(cb, 0xB100101F)
    a64_branch_reloc(cb, relocs, 0x54000001, "__xu_syscall_after_copy", mc.RELOC_ARM64_COND_BR19)
    // Skip 64B NEON when dst == src or 0 < dst - src < 64.
    e32(cb, 0xCB020024) // sub x4, x1, x2
    a64_branch_reloc(cb, relocs, 0xB4000004, "__xu_syscall_copy_done", mc.RELOC_ARM64_COND_BR19)
    e32(cb, 0xF101009F) // cmp x4, #64
    a64_branch_reloc(cb, relocs, 0x54000003, "__xu_syscall_copy16", mc.RELOC_ARM64_COND_BR19)
    // cmp x3, #64 ; b.lt copy16
    e32(cb, 0xF101007F)
    a64_branch_reloc(cb, relocs, 0x5400000B, "__xu_syscall_copy16", mc.RELOC_ARM64_COND_BR19)
    syms.define_label("__xu_syscall_copy64", cb.len())
    e32(cb, 0xAD400440) // ldp q0, q1, [x2]
    e32(cb, 0xAD410C42) // ldp q2, q3, [x2, #32]
    a64_add_imm(cb, 2, 2, 64)
    e32(cb, 0xAD000420) // stp q0, q1, [x1]
    e32(cb, 0xAD010C22) // stp q2, q3, [x1, #32]
    a64_add_imm(cb, 1, 1, 64)
    e32(cb, 0xD1010063) // sub x3, x3, #64
    e32(cb, 0xF101007F) // cmp x3, #64
    a64_branch_reloc(cb, relocs, 0x5400000A, "__xu_syscall_copy64", mc.RELOC_ARM64_COND_BR19)
    syms.define_label("__xu_syscall_copy16", cb.len())
    // subs x3, x3, #16 ; b.lt tail ; ldp x4, x5, [x2], #16 ;
    // stp x4, x5, [x1], #16 ; b loop
    e32(cb, 0xF1004063)
    e32(cb, 0x54000000 | (4 << 5) | 11)
    e32(cb, 0xA8C11444)
    e32(cb, 0xA8811424)
    e32(cb, 0x14000000 | (-4 & 0x3FFFFFF))
    // tail: adds x3, x3, #16 ; branchless 8/4/2/1 copy ; ret
    e32(cb, 0xB1004063)
    e32(cb, 0x36180063) // tbz x3, #3, +3
    e32(cb, 0xF8408444) // ldr x4, [x2], #8
    e32(cb, 0xF8008424) // str x4, [x1], #8
    e32(cb, 0x36100063) // tbz x3, #2, +3
    e32(cb, 0xB8404444) // ldr w4, [x2], #4
    e32(cb, 0xB8004424) // str w4, [x1], #4
    e32(cb, 0x36080063) // tbz x3, #1, +3
    e32(cb, 0x78402444) // ldrh w4, [x2], #2
    e32(cb, 0x78002424) // strh w4, [x1], #2
    e32(cb, 0x36000063) // tbz x3, #0, +3
    e32(cb, 0x39400044) // ldrb w4, [x2]
    e32(cb, 0x39000024) // strb w4, [x1]
    syms.define_label("__xu_syscall_copy_done", cb.len())
    e32(cb, 0xD65F03C0)
    syms.define_label("__xu_syscall_after_copy", cb.len())
    if uses_ffi || !emit_object {
        emit_arm64_ffi_calls(cb, syms, relocs, tgt_os, emit_object)
    }
    // cmn x0, #2 ; b.ne +12 ; mov x0, x29 ; ret
    e32(cb, 0xB100081F)
    e32(cb, 0x54000061)
    a64_mov(cb, 0, R_FP)
    e32(cb, 0xD65F03C0)
    // cmn x0, #3 ; b.ne +12 ; adr x0, __xu_start ; ret
    e32(cb, 0xB1000C1F)
    e32(cb, 0x54000061)
    disp := syms.lookup_offset("__xu_start") - cb.len()
    e32(cb, 0x10000000 | ((disp & 3) << 29) | (((disp >> 2) & 0x7ffff) << 5))
    e32(cb, 0xD65F03C0)
    e32(cb, 0xB100041F)
    a64_branch_reloc(cb, relocs, 0x54000001, "__xu_syscall_os", mc.RELOC_ARM64_COND_BR19)
    a64_mov(cb, 0, 1)
    a64_mov(cb, 1, 2)
    emit_arm64_task_stubs(cb, syms, relocs)
    syms.define_label("__xu_syscall_os", cb.len())
}

fn emit_arm64_globals(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    syms.define_label("__xu_globals", cb.len())
    a64_mov(cb, 0, R_STATE)
    e32(cb, 0xD65F03C0)
}

// C FFI pseudo calls (runtime/core ffi.xu).
//   -8: call x1 with the call block at x2: copy the stack words, load
//       x0-x7, d0-d7 and x8, call, store x0, x1 and d0-d3 back.
//   -9: address of the loader slots (dlopen, dlsym, dlerror), which the
//       dynamic executable writer has the system loader bind.
// The loader slots and the published state word are FFI_GOT_LABEL (4
// words: dlopen, dlsym, dlerror, state). ELF images keep them in the code
// segment, which is writable; the Mach-O writer places them in __DATA and
// the driver defines the label there.
pub const FFI_GOT_LABEL = "__xu_ffi_got"
pub const FFI_STATE_LABEL = "__xu_ffi_state"
const FFI_OBJ_GOT_OFFSET = 2048

fn a64_ffi_state_addr(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, rd int, emit_object bool) {
    if !emit_object {
        a64_fn_addr(cb, relocs, rd, FFI_STATE_LABEL)
        <<
    }
    relocs.push(mc.reloc_new(cb.len(), FFI_STATE_LABEL, mc.RELOC_ARM64_ADR_PAGE21, 0))
    e32(cb, 0x90000000 | rd)
    relocs.push(mc.reloc_new(cb.len(), FFI_STATE_LABEL, mc.RELOC_ARM64_ADD_LO12, 0))
    e32(cb, 0x91000000 | (rd << 5) | rd)
}

fn emit_arm64_ffi_tramps(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, tgt_os int) {
    $pfx := ""
    if tgt_os == target.OS_MACOS { pfx = "_" }
    names := ["dlopen", "dlsym", "dlerror"]
    for i in 0:names.len {
        while cb.len() % 4 != 0 { e32(cb, 0xD503201F) }
        syms.define_label("__xu_ffi_tramp_" + names[i], cb.len())
        e32(cb, 0xA9BF7BFD) // stp x29, x30, [sp, #-16]!
        e32(cb, 0x910003FD) // mov x29, sp
        a64_branch_reloc(cb, relocs, 0x94000000, pfx + names[i], mc.RELOC_ARM64_CALL26)
        e32(cb, 0xA8C17BFD) // ldp x29, x30, [sp], #16
        e32(cb, 0xD65F03C0) // ret
    }
}

fn emit_arm64_ffi_calls(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, tgt_os int, emit_object bool) {
    e32(cb, 0xB100201F) // cmn x0, #8
    skip6 := cb.len()
    e32(cb, 0x54000001) // b.ne (patched)
    e32(cb, 0xA9BE7BFD) // stp x29, x30, [sp, #-32]!
    e32(cb, 0x910003FD) // mov x29, sp
    a64_pair(cb, 0xA9000000, 19, 20, R_SP, 16)
    // Publish the runtime state register for C callbacks: C code between
    // here and a callback may use x28 for its own values.
    a64_ffi_state_addr(cb, relocs, 9, emit_object)
    a64_str(cb, 28, 9, 0)
    a64_mov(cb, 19, 2)
    a64_mov(cb, 20, 1)
    a64_ldr(cb, 9, 19, 128)
    e32(cb, 0xCB2963FF) // sub sp, sp, x9
    a64_ldr(cb, 10, 19, 136)
    e32(cb, 0x910003EB) // mov x11, sp
    e32(cb, 0xB40000A9) // cbz x9, +5
    e32(cb, 0xF840854C) // ldr x12, [x10], #8
    e32(cb, 0xF800856C) // str x12, [x11], #8
    e32(cb, 0xD1002129) // sub x9, x9, #8
    e32(cb, 0x17FFFFFC) // b -4
    for i in 0:4 {
        a64_pair(cb, 0x6D400000, i * 2, i * 2 + 1, 19, 64 + i * 16)
    }
    a64_ldr(cb, 8, 19, 144)
    for i in 0:4 {
        a64_pair(cb, 0xA9400000, i * 2, i * 2 + 1, 19, i * 16)
    }
    e32(cb, 0xD63F0000 | (20 << 5)) // blr x20
    a64_pair(cb, 0xA9000000, 0, 1, 19, 152)
    a64_pair(cb, 0x6D000000, 0, 1, 19, 168)
    a64_pair(cb, 0x6D000000, 2, 3, 19, 184)
    e32(cb, 0x910003BF) // mov sp, x29
    a64_pair(cb, 0xA9400000, 19, 20, R_SP, 16)
    e32(cb, 0xA8C27BFD) // ldp x29, x30, [sp], #32
    e32(cb, 0xD65F03C0)
    cb.patch_u32_le(skip6, 0x54000001 | ((((cb.len() - skip6) / 4) & 0x7FFFF) << 5))
    e32(cb, 0xB100241F) // cmn x0, #9
    skip7 := cb.len()
    e32(cb, 0x54000001)
    a64_ffi_state_addr(cb, relocs, 9, emit_object)
    a64_str(cb, R_STATE, 9, 0)
    if emit_object {
        if tgt_os == target.OS_WINDOWS {
            a64_mov_imm(cb, 0, 0)
        } else {
            a64_fn_addr(cb, relocs, 9, "__xu_ffi_tramp_dlopen")
            a64_str(cb, 9, R_STATE, FFI_OBJ_GOT_OFFSET)
            a64_fn_addr(cb, relocs, 9, "__xu_ffi_tramp_dlsym")
            a64_str(cb, 9, R_STATE, FFI_OBJ_GOT_OFFSET + 8)
            a64_fn_addr(cb, relocs, 9, "__xu_ffi_tramp_dlerror")
            a64_str(cb, 9, R_STATE, FFI_OBJ_GOT_OFFSET + 16)
            a64_add_imm(cb, 0, R_STATE, FFI_OBJ_GOT_OFFSET)
        }
    } else {
        a64_fn_addr(cb, relocs, 0, FFI_GOT_LABEL)
    }
    e32(cb, 0xD65F03C0)
    cb.patch_u32_le(skip7, 0x54000001 | ((((cb.len() - skip7) / 4) & 0x7FFFF) << 5))
}

// ELF: the four loader slots inside the (writable) code segment.
pub fn emit_arm64_ffi_slots(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    while cb.len() % 8 != 0 { e32(cb, 0xD503201F) }
    syms.define_label(FFI_GOT_LABEL, cb.len())
    syms.define_label(FFI_STATE_LABEL, cb.len() + 24)
    for i in 0:8 { e32(cb, 0) }
}

fn emit_arm64_ffi_thunk_one(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, label string, adapter string, is_clos bool, emit_object bool) {
    while cb.len() % 16 != 0 { e32(cb, 0xD503201F) }
    syms.define_label(label + "", cb.len())
    e32(cb, 0xA9800000 | ((-50 & 0x7F) << 15) | (30 << 10) | (31 << 5) | 29) // stp x29, x30, [sp, #-400]!
    e32(cb, 0x910003FD) // mov x29, sp
    for i in 0:5 { a64_pair(cb, 0xA9000000, 19 + i * 2, 20 + i * 2, R_SP, 16 + i * 16) }
    for i in 0:4 { a64_pair(cb, 0x6D000000, 8 + i * 2, 9 + i * 2, R_SP, 96 + i * 16) }
    for i in 0:4 { a64_pair(cb, 0xA9000000, i * 2, i * 2 + 1, R_SP, 160 + i * 16) }
    for i in 0:4 { a64_pair(cb, 0x6D000000, i * 2, i * 2 + 1, R_SP, 224 + i * 16) }
    a64_str(cb, 8, R_SP, 160 + 144) // x8 -> FB_X8
    // Closure stubs pass the slot index in x16, which the state-address
    // sequence below uses as scratch: park it in (already saved) x19.
    if is_clos { e32(cb, 0xAA1003F3) } // mov x19, x16
    // Restore the runtime state register published by the C call.
    a64_ffi_state_addr(cb, relocs, 28, emit_object)
    a64_ldr(cb, 28, 28, 0)
    e32(cb, 0x91000000 | (400 << 10) | (31 << 5) | 9) // add x9, sp, #400
    a64_str(cb, 9, R_SP, 160 + 136)
    if is_clos {
        a64_mov_imm(cb, 9, 24)
        e32(cb, 0x9B097E70) // mul x16, x19, x9
        e32(cb, 0x9130038A) // add x10, x28, #3072
        e32(cb, 0x8B10014A) // add x10, x10, x16
        a64_add_imm(cb, 11, 10, 8)
        a64_str(cb, 11, R_SP, 160 + 200) // blk + FB_CLOSURE
        a64_ldr(cb, 9, 10, 0)
        e32(cb, 0x91000000 | (160 << 10) | (31 << 5) | 0) // add x0, sp, #160
        e32(cb, 0xD63F0120) // blr x9
    } else {
        e32(cb, 0x91000000 | (160 << 10) | (31 << 5) | 0) // add x0, sp, #160
        a64_branch_reloc(cb, relocs, 0x94000000, adapter + "", mc.RELOC_ARM64_CALL26)
    }
    a64_pair(cb, 0xA9400000, 0, 1, R_SP, 160 + 152)
    a64_pair(cb, 0x6D400000, 0, 1, R_SP, 160 + 168)
    a64_pair(cb, 0x6D400000, 2, 3, R_SP, 160 + 184)
    for i in 0:5 { a64_pair(cb, 0xA9400000, 19 + i * 2, 20 + i * 2, R_SP, 16 + i * 16) }
    for i in 0:4 { a64_pair(cb, 0x6D400000, 8 + i * 2, 9 + i * 2, R_SP, 96 + i * 16) }
    e32(cb, 0xA8C00000 | ((50 & 0x7F) << 15) | (30 << 10) | (31 << 5) | 29) // ldp x29, x30, [sp], #400
    e32(cb, 0xD65F03C0)
}

// C-ABI entry points for Xu functions passed as C callbacks: save the C
// callee-saved registers, spill x0-x7 / d0-d7 and the caller's stack
// argument address into a call block on the stack, call the adapter with
// the block, load x0, x1, d0-d3 from it and return (layout: core ffi.xu).
pub fn emit_arm64_ffi_thunks(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, thunks &[]string, adapters &[]string, emit_object bool, emit_clos bool) {
    for t in 0:thunks.len {
        emit_arm64_ffi_thunk_one(cb, syms, relocs, thunks[t] + "", adapters[t] + "", false, emit_object)
    }
    if emit_clos {
        emit_arm64_ffi_thunk_one(cb, syms, relocs, "__xu_ffi_clos_dispatch", "", true, emit_object)
        while cb.len() % 16 != 0 { e32(cb, 0xD503201F) }
        syms.define_label("__xu_ffi_clos_stubs", cb.len())
        for k in 0:64 {
            a64_mov_imm(cb, 16, k)
            a64_branch_reloc(cb, relocs, 0x14000000, "__xu_ffi_clos_dispatch", mc.RELOC_ARM64_CALL26)
            e32(cb, 0xD503201F)
            e32(cb, 0xD503201F)
        }
    }
}

// adr rd, target (both code-buffer offsets; target within 1 MiB).
fn a64_patch_adr_at(cb $&mc.CodeBuffer, at int, rd int, target int) {
    disp := target - at
    cb.patch_u32_le(at, 0x10000000 | ((disp & 3) << 29) | (((disp >> 2) & 0x7FFFF) << 5) | rd)
}
