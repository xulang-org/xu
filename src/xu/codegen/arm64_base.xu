@xu/codegen
// Baseline AArch64 instruction selection for typed MIR.
//
// Correctness first: every temp has its own frame slot and every local its
// full width, so no value is ever shared or clobbered. Operands are loaded
// into scratch registers (x9-x12), the result is stored back. Optimizing
// selection can replace this per function once it implements the same
// conventions:
//   - arguments in x0-x7, the rest at [sp + 8*(i-8)] of the caller's
//     outgoing area; scalar result in x0
//   - x28 holds the runtime state block for the whole process
//   - frame: [fp] saved fp/lr, sp = fp - frame; locals and temps at
//     [sp + out_area + offset]

#xu/mir
#xu/mc
#internal/uiabi
#xu/target

const R_FP = 29
const R_LR = 30
const R_SP = 31
const R_IP0 = 16
const R_IP1 = 17
const R_STATE = 28
// Slot 11 in the process-wide layout in runtime/core.
const A64_HWCAP_OFFSET = 88

fn a64_patch_adr(cb $&mc.CodeBuffer, at int, rd int) {
    disp := cb.len() - at
    cb.patch_u32_le(at, 0x10000000 | ((disp & 3) << 29) | ((disp >> 2) << 5) | rd)
}

struct A64Frame {
    out_area int
    size int
    local_off []int
    temp_off []int
}

// ===== encoders =====

fn e32(cb $&mc.CodeBuffer, w int) {
    cb.emit_u32_le(w & 0xffffffff)
}

fn a64_mov_imm(cb $&mc.CodeBuffer, rd int, v int) {
    e32(cb, 0xD2800000 | ((v & 0xffff) << 5) | rd)
    for hw in 1:4 {
        chunk := (v >> (16 * hw)) & 0xffff
        if chunk != 0 {
            e32(cb, 0xF2800000 | (hw << 21) | (chunk << 5) | rd)
        }
    }
}

fn a64_mov(cb $&mc.CodeBuffer, rd int, rm int) {
    e32(cb, 0xAA0003E0 | (rm << 16) | rd)
}

// rd = rn + imm (rn/rd may be sp); imm >= 0.
fn a64_add_imm(cb $&mc.CodeBuffer, rd int, rn int, imm int) {
    if imm < 4096 {
        e32(cb, 0x91000000 | (imm << 10) | (rn << 5) | rd)
        <<
    }
    a64_mov_imm(cb, R_IP0, imm)
    e32(cb, 0x8B206000 | (R_IP0 << 16) | (rn << 5) | rd)
}

fn a64_sub_sp(cb $&mc.CodeBuffer, imm int) {
    if imm < 4096 {
        e32(cb, 0xD1000000 | (imm << 10) | (R_SP << 5) | R_SP)
        <<
    }
    a64_mov_imm(cb, R_IP0, imm)
    e32(cb, 0xCB206000 | (R_IP0 << 16) | (R_SP << 5) | R_SP)
}

// Load/store of width 1, 2, 4 or 8 bytes at [rn + off].
fn a64_mem(cb $&mc.CodeBuffer, store bool, width_code int, rt int, rn int, off int) {
    $width := width_code
    $scaled := off
    $base_imm := 0xF9400000
    $base_reg := 0xF8606800
    if width_code == -4 {
        width = 4
        scaled = off / 4
        base_imm = 0xB9800000
        base_reg = 0xB8A06800
        if store {
            base_imm = 0xB9000000
            base_reg = 0xB8206800
        }
    } else if width == 1 {
        base_imm = 0x39400000
        base_reg = 0x38606800
    } else if width == 2 {
        base_imm = 0x79400000
        base_reg = 0x78606800
        scaled = off / 2
    } else if width == 4 {
        base_imm = 0xB9400000
        base_reg = 0xB8606800
        scaled = off / 4
    } else {
        scaled = off / 8
    }
    if store && width_code != -4 {
        base_imm = base_imm & 0xFFBFFFFF
        base_reg = base_reg & 0xFFBFFFFF
    }
    if off >= 0 && off % width == 0 && scaled < 4096 {
        e32(cb, base_imm | (scaled << 10) | (rn << 5) | rt)
        <<
    }
    a64_mov_imm(cb, R_IP1, off)
    e32(cb, base_reg | (R_IP1 << 16) | (rn << 5) | rt)
}

fn a64_ldr(cb $&mc.CodeBuffer, rt int, rn int, off int) {
    a64_mem(cb, false, 8, rt, rn, off)
}

fn a64_mem_idx(cb $&mc.CodeBuffer, store bool, width_code int, rt int, rn int, rm int, shift_s int) {
    $base_reg := 0xF8606800
    if width_code == -4 {
        if store { base_reg = 0xB8206800 }
        else { base_reg = 0xB8A06800 }
    } else if width_code == 1 {
        base_reg = 0x38606800
        if store { base_reg = base_reg & 0xFFBFFFFF }
    } else if width_code == 2 {
        base_reg = 0x78606800
        if store { base_reg = base_reg & 0xFFBFFFFF }
    } else if width_code == 4 {
        base_reg = 0xB8606800
        if store { base_reg = base_reg & 0xFFBFFFFF }
    } else {
        if store { base_reg = base_reg & 0xFFBFFFFF }
    }
    if shift_s > 0 {
        base_reg = base_reg | 0x1000
    }
    e32(cb, base_reg | (rm << 16) | (rn << 5) | rt)
}

fn a64_str(cb $&mc.CodeBuffer, rt int, rn int, off int) {
    a64_mem(cb, true, 8, rt, rn, off)
}

fn a64_rrr(cb $&mc.CodeBuffer, base int, rd int, rn int, rm int) {
    e32(cb, base | (rm << 16) | (rn << 5) | rd)
}

fn a64_cmp(cb $&mc.CodeBuffer, rn int, rm int) {
    e32(cb, 0xEB00001F | (rm << 16) | (rn << 5))
}

fn a64_cset(cb $&mc.CodeBuffer, rd int, cond int) {
    e32(cb, 0x9A9F07E0 | ((cond ^ 1) << 12) | rd)
}

fn a64_branch_reloc(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, word int, label string, kind int) {
    off := cb.len()
    e32(cb, word)
    relocs.push(mc.reloc_new(off, label + "", kind, 0))
}

// rd = run-time address of label: adr of this point plus a link-time
// displacement literal (ABS64 with addend -here yields label - here).
fn a64_fn_addr(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, rd int, label string) {
    here := cb.len()
    e32(cb, 0x10000000 | rd)
    e32(cb, 0x58000040 | R_IP0)
    e32(cb, 0x14000003)
    relocs.push(mc.reloc_new(cb.len(), label + "", mc.RELOC_ABS64, 0 - here))
    e32(cb, 0)
    e32(cb, 0)
    a64_rrr(cb, 0x8B000000, rd, rd, R_IP0)
}

// ===== frame =====

fn a64_frame(f &mir.MFn) A64Frame {
    << frame_layout(f, 8)
}

// The frame for a backend passing the first reg_args arguments in
// registers and the rest in the caller's outgoing area.
fn frame_layout(f &mir.MFn, reg_args int) A64Frame {
    $max_args := 0
    for i in 0:f.instrs.len {
        if f.instrs[i].kind == mir.MI_CALL || f.instrs[i].kind == mir.MI_CALL_IND {
            $n := 0
            $a := f.instrs[i].c
            while a >= 0 {
                n += 1
                a = f.margs[a].next
            }
            if n > max_args {
                max_args = n
            }
        }
    }
    $out_area := 0
    if max_args > reg_args {
        out_area = (max_args - reg_args) * 8
    }
    $off := out_area
    $loffs := []int{}
    for i in 0:f.locals.len {
        loffs.push(off)
        $n := 1
        if i < f.locals_nslots.len && f.locals_nslots[i] > 1 {
            n = f.locals_nslots[i]
        }
        off += n * 8
    }
    $toffs := []int{}
    for i in 0:f.temps.len {
        toffs.push(off)
        off += 8
    }
    size := (off + 15) / 16 * 16
    << A64Frame{out_area: out_area, size: size, local_off: loffs, temp_off: toffs}
}

// Frame-pointer-relative offset of each local (both backends share the
// layout: sp = fp - frame size).
pub fn frame_local_fp_offsets(f &mir.MFn) []int {
    fr := a64_frame(f)
    $out := []int{}
    for i in 0:fr.local_off.len {
        out.push(fr.local_off[i] - fr.size)
    }
    << out
}

// Operand (temp or constant) into register rd.
fn a64_operand(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, rd int, v int) {
    if v <= -2 {
        a64_mov_imm(cb, rd, f.consts[0 - v - 2])
        <<
    }
    if v >= 0 && v < fr.temp_off.len {
        a64_ldr(cb, rd, R_SP, fr.temp_off[v])
        <<
    }
    a64_mov_imm(cb, rd, 0)
}

fn a64_set_temp(cb $&mc.CodeBuffer, fr &A64Frame, t int, rs int) {
    if t >= 0 && t < fr.temp_off.len {
        a64_str(cb, rs, R_SP, fr.temp_off[t])
    }
}

fn a64_fmov_dx(cb $&mc.CodeBuffer, fd int, xn int) {
    e32(cb, 0x9E670000 | (xn << 5) | fd)
}

fn a64_fmov_xd(cb $&mc.CodeBuffer, xd int, fx int) {
    e32(cb, 0x9E660000 | (fx << 5) | xd)
}

fn a64_fmov_dd(cb $&mc.CodeBuffer, fd int, fx int) {
    e32(cb, 0x1E604000 | (fx << 5) | fd)
}

fn a64_fmem(cb $&mc.CodeBuffer, store bool, dt int, rn int, off int) {
    if off >= 0 && off % 8 == 0 && off / 8 < 4096 {
        $base_imm := 0xFD400000
        if store { base_imm = 0xFD000000 }
        e32(cb, base_imm | ((off / 8) << 10) | (rn << 5) | dt)
        <<
    }
    a64_mov_imm(cb, R_IP1, off)
    $base_reg := 0xFC606800
    if store { base_reg = 0xFC206800 }
    e32(cb, base_reg | (R_IP1 << 16) | (rn << 5) | dt)
}

// rd = rn op rm on f64 bit patterns, through d0/d1.
fn a64_fbin(cb $&mc.CodeBuffer, op int, rd int, rn int, rm int) {
    e32(cb, 0x9E670000 | (rn << 5) | 0)
    e32(cb, 0x9E670000 | (rm << 5) | 1)
    if op <= mir.BIN_FDIV {
        $base := 0x1E602800
        if op == mir.BIN_FSUB { base = 0x1E603800 }
        else if op == mir.BIN_FMUL { base = 0x1E600800 }
        else if op == mir.BIN_FDIV { base = 0x1E601800 }
        a64_rrr(cb, base, 0, 0, 1)
        e32(cb, 0x9E660000 | (0 << 5) | rd)
        <<
    }
    // fcmp d0, d1; MI/LS keep unordered results false.
    e32(cb, 0x1E602000 | (1 << 16) | (0 << 5))
    $cond := target.ARM64_COND_EQ
    if op == mir.BIN_FNE { cond = target.ARM64_COND_NE }
    else if op == mir.BIN_FLT { cond = target.ARM64_COND_MI }
    else if op == mir.BIN_FLE { cond = target.ARM64_COND_LS }
    else if op == mir.BIN_FGT { cond = target.ARM64_COND_GT }
    else if op == mir.BIN_FGE { cond = target.ARM64_COND_GE }
    a64_cset(cb, rd, cond)
}

// rd = conversion of rn (scvtf / fcvtzs through d0).
fn a64_un(cb $&mc.CodeBuffer, op int, rd int, rn int) {
    if op == mir.UN_I2F {
        e32(cb, 0x9E620000 | (rn << 5) | 0)
        e32(cb, 0x9E660000 | (0 << 5) | rd)
    } else if op == mir.UN_F2I {
        e32(cb, 0x9E670000 | (rn << 5) | 0)
        e32(cb, 0x9E780000 | (0 << 5) | rd)
    } else if op == mir.UN_FSQRT {
        e32(cb, 0x9E670000 | (rn << 5) | 0)
        e32(cb, 0x1E61C000 | (0 << 5) | 0)
        e32(cb, 0x9E660000 | (0 << 5) | rd)
    } else {
        e32(cb, 0xD4200000)
    }
}

// rd = rn op rm (x11 is scratch for MOD; MULH is smulh).
fn a64_bin(cb $&mc.CodeBuffer, op int, rd int, rn int, rm int) {
    if op >= mir.BIN_FADD && op <= mir.BIN_FGE {
        a64_fbin(cb, op, rd, rn, rm)
        <<
    }
    if op == mir.BIN_ADD { a64_rrr(cb, 0x8B000000, rd, rn, rm) }
    else if op == mir.BIN_SUB { a64_rrr(cb, 0xCB000000, rd, rn, rm) }
    else if op == mir.BIN_MUL { a64_rrr(cb, 0x9B007C00, rd, rn, rm) }
    else if op == mir.BIN_DIV { a64_rrr(cb, 0x9AC00C00, rd, rn, rm) }
    else if op == mir.BIN_MOD {
        a64_rrr(cb, 0x9AC00C00, 11, rn, rm)
        // msub rd, x11, rm, rn
        e32(cb, 0x9B008000 | (rm << 16) | (rn << 10) | (11 << 5) | rd)
    }
    else if op == mir.BIN_AND { a64_rrr(cb, 0x8A000000, rd, rn, rm) }
    else if op == mir.BIN_OR { a64_rrr(cb, 0xAA000000, rd, rn, rm) }
    else if op == mir.BIN_XOR { a64_rrr(cb, 0xCA000000, rd, rn, rm) }
    else if op == mir.BIN_SHL { a64_rrr(cb, 0x9AC02000, rd, rn, rm) }
    else if op == mir.BIN_SHR { a64_rrr(cb, 0x9AC02800, rd, rn, rm) }
    else if op == mir.BIN_MULH { a64_rrr(cb, 0x9B407C00, rd, rn, rm) }
    else if op == mir.BIN_ROTR32 { a64_rrr(cb, 0x1AC02C00, rd, rn, rm) }
    else if op == mir.BIN_ROTR64 { a64_rrr(cb, 0x9AC02C00, rd, rn, rm) }
    else {
        a64_cmp(cb, rn, rm)
        $cond := target.ARM64_COND_EQ
        if op == mir.BIN_NE { cond = target.ARM64_COND_NE }
        else if op == mir.BIN_LT { cond = target.ARM64_COND_LT }
        else if op == mir.BIN_LE { cond = target.ARM64_COND_LE }
        else if op == mir.BIN_GT { cond = target.ARM64_COND_GT }
        else if op == mir.BIN_GE { cond = target.ARM64_COND_GE }
        a64_cset(cb, rd, cond)
    }
}

// ===== allocated values =====

fn a64_temp_reg(ra &RaInfo, v int) int {
    if v >= 0 && v < ra.temp_reg.len {
        << ra.temp_reg[v]
    }
    << -1
}

// The register holding operand v: its own, or scratch loaded with it.
fn a64_src(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, v int, scratch int) int {
    r := a64_temp_reg(ra, v)
    if r >= 0 && r < 32 {
        << r
    }
    if r >= 32 {
        a64_fmov_xd(cb, scratch, r - 32)
        << scratch
    }
    a64_operand(cb, f, fr, scratch, v)
    << scratch
}

fn a64_fp64_imm8(c int) int {
    if (c & 281474976710655) != 0 { << -1 }
    biased := (c >> 52) & 0x7FF
    if biased < 1020 || biased > 1027 { << -1 }
    $sign := 0
    if c < 0 { sign = 128 }
    << sign | ((biased & 7) << 4) | ((c >> 48) & 15)
}

// Operand v into register rd (GPR < 32 or FPR >= 32).
fn a64_load_to(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, rd int, v int) {
    r := a64_temp_reg(ra, v)
    if rd >= 32 {
        fd := rd - 32
        if r >= 32 {
            if r != rd {
                a64_fmov_dd(cb, fd, r - 32)
            }
        } else if r >= 0 {
            a64_fmov_dx(cb, fd, r)
        } else if v <= -2 && f.consts[0 - v - 2] == 0 {
            a64_fmov_dx(cb, fd, 31)
        } else if v >= 0 && v < fr.temp_off.len {
            a64_fmem(cb, false, fd, R_SP, fr.temp_off[v])
        } else if v <= -2 {
            imm8 := a64_fp64_imm8(f.consts[0 - v - 2])
            if imm8 >= 0 {
                e32(cb, 0x1E601000 | (imm8 << 13) | fd)
            } else {
                a64_mov_imm(cb, 9, f.consts[0 - v - 2])
                a64_fmov_dx(cb, fd, 9)
            }
        } else {
            a64_fmov_dx(cb, fd, 31)
        }
        <<
    }
    if r >= 0 && r < 32 {
        if r != rd {
            a64_mov(cb, rd, r)
        }
        <<
    }
    if r >= 32 {
        a64_fmov_xd(cb, rd, r - 32)
        <<
    }
    a64_operand(cb, f, fr, rd, v)
}

// The GPR to compute temp t into.
fn a64_dst(ra &RaInfo, t int, scratch int) int {
    r := a64_temp_reg(ra, t)
    if r >= 0 && r < 32 {
        << r
    }
    << scratch
}

// Temp t now has its value in register rs (GPR < 32 or FPR >= 32).
fn a64_put(cb $&mc.CodeBuffer, fr &A64Frame, ra &RaInfo, t int, rs int) {
    if t < 0 {
        <<
    }
    r := a64_temp_reg(ra, t)
    if r >= 32 {
        fd := r - 32
        if rs >= 32 {
            if r != rs {
                a64_fmov_dd(cb, fd, rs - 32)
            }
        } else {
            a64_fmov_dx(cb, fd, rs)
        }
        <<
    }
    if r >= 0 {
        if rs >= 32 {
            a64_fmov_xd(cb, r, rs - 32)
        } else if r != rs {
            a64_mov(cb, r, rs)
        }
        <<
    }
    if rs >= 32 {
        if t < fr.temp_off.len {
            a64_fmem(cb, true, rs - 32, R_SP, fr.temp_off[t])
        }
        <<
    }
    a64_set_temp(cb, fr, t, rs)
}

fn a64_fsrc(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, v int, d_scratch int) int {
    r := a64_temp_reg(ra, v)
    if r >= 32 {
        << r - 32
    }
    a64_load_to(cb, f, fr, ra, 32 + d_scratch, v)
    << d_scratch
}

fn a64_fdst(ra &RaInfo, t int, d_scratch int) int {
    r := a64_temp_reg(ra, t)
    if r >= 32 {
        << r - 32
    }
    << d_scratch
}

fn a64_fcond_of(op int) int {
    if op == mir.BIN_FNE { << target.ARM64_COND_NE }
    if op == mir.BIN_FLT { << target.ARM64_COND_MI }
    if op == mir.BIN_FLE { << target.ARM64_COND_LS }
    if op == mir.BIN_FGT { << target.ARM64_COND_GT }
    if op == mir.BIN_FGE { << target.ARM64_COND_GE }
    << target.ARM64_COND_EQ
}

fn a64_is_fcmp(op int) bool {
    << op >= mir.BIN_FEQ && op <= mir.BIN_FGE
}

fn a64_fneg_operand(f &mir.MFn, ra &RaInfo, ins &mir.MInstr) int {
    if ins.b != mir.BIN_XOR {
        << -1
    }
    sb := -9223372036854775807 - 1
    $val := -1
    if ins.d <= -2 && f.consts[0 - ins.d - 2] == sb {
        val = ins.c
    } else if ins.c <= -2 && f.consts[0 - ins.c - 2] == sb {
        val = ins.d
    } else {
        << -1
    }
    if a64_temp_reg(ra, ins.a) >= 32 || a64_temp_reg(ra, val) >= 32 {
        << val
    }
    << -1
}

fn a64_cond_of(op int) int {
    if op == mir.BIN_NE { << target.ARM64_COND_NE }
    if op == mir.BIN_LT { << target.ARM64_COND_LT }
    if op == mir.BIN_LE { << target.ARM64_COND_LE }
    if op == mir.BIN_GT { << target.ARM64_COND_GT }
    if op == mir.BIN_GE { << target.ARM64_COND_GE }
    << target.ARM64_COND_EQ
}

fn a64_is_icmp(op int) bool {
    << op >= mir.BIN_EQ && op <= mir.BIN_GE
}

fn a64_u64_shr(x int, k int) int {
    if k <= 0 { << x }
    if k >= 64 { << 0 }
    if k == 1 { << (x >> 1) & 9223372036854775807 }
    << (x >> k) & ((1 << (64 - k)) - 1)
}

fn a64_encode_bitmask64(v int) int {
    if v == 0 || v == -1 { << -1 }
    $sz := 64
    $p := v
    hi32 := a64_u64_shr(p, 32)
    lo32 := p & 4294967295
    if hi32 == lo32 {
        sz = 32
        p = lo32
        while sz > 2 {
            half := sz / 2
            mask := (1 << half) - 1
            if (p & mask) == ((p >> half) & mask) {
                sz = half
                p = p & mask
            } else {
                <-
            }
        }
    }
    $immr := 0
    $ones := 0
    if (p & 1) == 0 {
        $tz := 1
        while tz < sz && ((p >> tz) & 1) == 0 {
            tz += 1
        }
        if tz >= sz { << -1 }
        q := a64_u64_shr(p, tz)
        if (q & (q + 1)) != 0 { << -1 }
        while (q >> ones) != 0 { ones += 1 }
        immr = (sz - tz) & (sz - 1)
    } else {
        $emask := -1
        if sz < 64 { emask = (1 << sz) - 1 }
        np := p ^ emask
        if np == 0 { << -1 }
        $tz := 1
        while tz < sz && ((np >> tz) & 1) == 0 {
            tz += 1
        }
        if tz >= sz { << -1 }
        q := a64_u64_shr(np, tz)
        if (q & (q + 1)) != 0 { << -1 }
        $zeros := 0
        while (q >> zeros) != 0 { zeros += 1 }
        ones = sz - zeros
        start1 := (tz + zeros) & (sz - 1)
        immr = (sz - start1) & (sz - 1)
    }
    if ones < 1 || ones >= sz { << -1 }
    $nbit := 0
    $imms := 0
    if sz == 64 {
        nbit = 1
        imms = ones - 1
    } else {
        imms = ((64 - sz * 2) & 63) | (ones - 1)
    }
    << (nbit << 12) | (immr << 6) | imms
}

// Constant operand v as a 12-bit unsigned immediate, or -1.
fn a64_imm12(f &mir.MFn, v int) int {
    if v <= -2 {
        c := f.consts[0 - v - 2]
        if c >= 0 && c < 4096 {
            << c
        }
    }
    << -1
}

fn a64_can_cmp_imm(f &mir.MFn, v int) bool {
    if v <= -2 {
        c := f.consts[0 - v - 2]
        << c >= -4095 && c < 4096
    }
    << false
}

// cmp c, d using the immediate form when d allows it.
fn a64_cmp_vals(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo, c int, d int) {
    rn := a64_src(cb, f, fr, ra, c, 9)
    imm := a64_imm12(f, d)
    if imm >= 0 {
        e32(cb, 0xF100001F | (imm << 10) | (rn << 5))
        <<
    }
    if d <= -2 {
        cv := f.consts[0 - d - 2]
        if cv < 0 && cv >= -4095 {
            e32(cb, 0xB100001F | ((0 - cv) << 10) | (rn << 5))
            <<
        }
    }
    rm := a64_src(cb, f, fr, ra, d, 10)
    a64_cmp(cb, rn, rm)
}

fn a64_can_bin_imm(f &mir.MFn, op int, d int) bool {
    if d > -2 { << false }
    cv := f.consts[0 - d - 2]
    if op == mir.BIN_ADD || op == mir.BIN_SUB {
        << cv >= -4095 && cv < 4096
    }
    if op == mir.BIN_SHL || op == mir.BIN_SHR || op == mir.BIN_ROTR32 || op == mir.BIN_ROTR64 {
        << true
    }
    if op == mir.BIN_AND && cv == 4294967295 {
        << true
    }
    if op == mir.BIN_XOR && cv == -1 {
        << true
    }
    if op == mir.BIN_AND || op == mir.BIN_OR || op == mir.BIN_XOR {
        << a64_encode_bitmask64(cv) >= 0
    }
    << false
}

// Integer op with a constant right operand as one instruction; false when
// no such form applies.
fn a64_bin_imm(cb $&mc.CodeBuffer, f &mir.MFn, op int, rd int, rn int, d int) bool {
    if d > -2 { << false }
    cv := f.consts[0 - d - 2]
    if op == mir.BIN_ADD {
        if cv >= 0 && cv < 4096 {
            e32(cb, 0x91000000 | (cv << 10) | (rn << 5) | rd)
            << true
        }
        if cv < 0 && cv >= -4095 {
            e32(cb, 0xD1000000 | ((0 - cv) << 10) | (rn << 5) | rd)
            << true
        }
    }
    if op == mir.BIN_SUB {
        if cv >= 0 && cv < 4096 {
            e32(cb, 0xD1000000 | (cv << 10) | (rn << 5) | rd)
            << true
        }
        if cv < 0 && cv >= -4095 {
            e32(cb, 0x91000000 | ((0 - cv) << 10) | (rn << 5) | rd)
            << true
        }
    }
    if op == mir.BIN_SHL || op == mir.BIN_SHR {
        sh := cv & 63
        if op == mir.BIN_SHR {
            // asr rd, rn, #sh
            e32(cb, 0x9340FC00 | (sh << 16) | (rn << 5) | rd)
        } else {
            // lsl rd, rn, #sh
            e32(cb, 0xD3400000 | (((64 - sh) & 63) << 16) | ((63 - sh) << 10) | (rn << 5) | rd)
        }
        << true
    }
    if op == mir.BIN_ROTR32 {
        k := cv & 31
        if k == 0 {
            e32(cb, 0x2A0003E0 | (rn << 16) | rd)
        } else {
            e32(cb, 0x13800000 | (rn << 16) | (k << 10) | (rn << 5) | rd)
        }
        << true
    }
    if op == mir.BIN_ROTR64 {
        k := cv & 63
        if k == 0 {
            a64_mov(cb, rd, rn)
        } else {
            e32(cb, 0x93C00000 | (rn << 16) | (k << 10) | (rn << 5) | rd)
        }
        << true
    }
    if op == mir.BIN_AND && cv == 4294967295 {
        e32(cb, 0x2A0003E0 | (rn << 16) | rd)
        << true
    }
    if op == mir.BIN_XOR && cv == -1 {
        e32(cb, 0xAA2003E0 | (rn << 16) | rd)
        << true
    }
    if op == mir.BIN_AND || op == mir.BIN_OR || op == mir.BIN_XOR {
        enc := a64_encode_bitmask64(cv)
        if enc >= 0 {
            $opc := 0x92000000
            if op == mir.BIN_OR { opc = 0xB2000000 }
            else if op == mir.BIN_XOR { opc = 0xD2000000 }
            e32(cb, opc | (enc << 10) | (rn << 5) | rd)
            << true
        }
    }
    << false
}

// Two adjacent instructions done as one, the first's result read only by
// the second: 1 for t = shr h, 63; q = sub h, t (sub q, h, h, asr #63),
// 2 for t = mul a, b; r = sub x, t (msub r, a, b, x). 0 otherwise.
fn a64_fuse2(f &mir.MFn, ins &mir.MInstr, uses &[]int) int {
    if ins.kind != mir.MI_BIN || ins.a < 0 || ins.a >= uses.len || uses[ins.a] != 1 || ins.next < 0 {
        << 0
    }
    nx := ~f.instrs[ins.next]
    if nx.kind != mir.MI_BIN || nx.b != mir.BIN_SUB || nx.d != ins.a || nx.c == ins.a {
        << 0
    }
    if ins.b == mir.BIN_SHR && ins.c >= 0 && nx.c == ins.c && ins.d <= -2 && f.consts[0 - ins.d - 2] == 63 {
        << 1
    }
    if ins.b == mir.BIN_MUL {
        << 2
    }
    << 0
}

// For a block ending in t1 = x < 0; t2 = x >= n; t3 = t1 | t2 (tagged
// "bounds"); branch t3, with each temp read once: the three instruction
// ids, x and n. Empty otherwise.
fn a64_bounds_check(f &mir.MFn, bi int, uses &[]int, opt bool) []int {
    $out := []int{}
    blk := ~f.blocks[bi]
    if !opt || blk.tkind != mir.TKIND_BRANCH {
        << out
    }
    $ids := []int{}
    $ii := blk.head
    while ii >= 0 {
        ids.push(ii)
        ii = f.instrs[ii].next
    }
    if ids.len < 3 {
        << out
    }
    i1 := ~f.instrs[ids[ids.len - 3]]
    i2 := ~f.instrs[ids[ids.len - 2]]
    i3 := ~f.instrs[ids[ids.len - 1]]
    if i3.kind != mir.MI_BIN || i3.b != mir.BIN_OR || i3.sval != "bounds" || i3.a != blk.ta {
        << out
    }
    if i1.kind != mir.MI_BIN || i1.b != mir.BIN_LT || i2.kind != mir.MI_BIN || i2.b != mir.BIN_GE {
        << out
    }
    if i3.c != i1.a || i3.d != i2.a || i1.c != i2.c || i1.d > -2 || f.consts[0 - i1.d - 2] != 0 {
        << out
    }
    if i1.a < 0 || i2.a < 0 || i3.a < 0 || uses[i1.a] != 1 || uses[i2.a] != 1 || uses[i3.a] != 1 {
        << out
    }
    out.push(ids[ids.len - 3])
    out.push(ids[ids.len - 2])
    out.push(ids[ids.len - 1])
    out.push(i1.c)
    out.push(i2.d)
    << out
}

struct StrFix {
    adr_off int
    bytes string
}

// lines receives (code offset, source line) pairs where the line changes.
// Registers for allocated values: callee-saved x19-x27 (x28 is the state
// block) and the scratch registers no sequence below uses.
fn a64_ra(f &mir.MFn, opt bool) RaInfo {
    if !opt {
        << ra_none(f)
    }
    $callee := []int{}
    for r in 19:28 {
        callee.push(r)
    }
    $caller := []int{}
    caller.push(8)
    for r in 12:16 {
        caller.push(r)
    }
    $is_leaf := true
    for ii in 0:f.instrs.len {
        k := f.instrs[ii].kind
        if k == mir.MI_CALL_IND || (k == mir.MI_CALL && !is_noreturn_call(&f.instrs[ii].sval)) {
            is_leaf = false
            <-
        }
    }
    if is_leaf {
        for r in 1:8 {
            caller.push(r)
        }
    }
    $fp_callee := []int{}
    for r in 8:16 {
        fp_callee.push(32 + r)
    }
    $fp_caller := []int{}
    for r in 3:8 {
        fp_caller.push(32 + r)
    }
    for r in 16:32 {
        fp_caller.push(32 + r)
    }
    << ra_alloc_fp(f, &callee, &caller, &fp_callee, &fp_caller)
}

fn a64_copy_params(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, ra &RaInfo) {
    $nreg := f.nparams
    if nreg > 8 { nreg = 8 }
    $loc := []int{}
    $dst := []int{}
    $done := []bool{}
    for i in 0:nreg {
        lr := ra.local_reg[i]
        loc.push(i)
        dst.push(lr)
        if lr < 0 {
            a64_str(cb, i, R_SP, fr.local_off[i])
            done.push(true)
        } else if lr >= 32 {
            a64_fmov_dx(cb, lr - 32, i)
            done.push(true)
        } else if lr == i {
            done.push(true)
        } else {
            done.push(false)
        }
    }
    for _ in 0:nreg * 2 + 2 {
        $progressed := false
        $first_undone := -1
        for i in 0:nreg {
            if done[i] { -> }
            if first_undone < 0 { first_undone = i }
            $busy := false
            for j in 0:nreg {
                if !done[j] && j != i && loc[j] == dst[i] {
                    busy = true
                    <-
                }
            }
            if !busy {
                a64_mov(cb, dst[i], loc[i])
                done[i] = true
                progressed = true
            }
        }
        if first_undone < 0 { <- }
        if !progressed {
            a64_mov(cb, 9, loc[first_undone])
            loc[first_undone] = 9
        }
    }
    for i in 8:f.nparams {
        lr := ra.local_reg[i]
        off := 16 + (i - 8) * 8
        if lr >= 32 {
            a64_fmem(cb, false, lr - 32, R_FP, off)
        } else if lr >= 0 {
            a64_ldr(cb, lr, R_FP, off)
        } else {
            a64_ldr(cb, 9, R_FP, off)
            a64_str(cb, 9, R_SP, fr.local_off[i])
        }
    }
}

// lines receives (code offset, source line) pairs where the line changes.
// opt keeps values in registers (ra_alloc); otherwise every value lives in
// its frame slot.
fn a64_defines(k int) bool {
    << k == mir.MI_COPY || k == mir.MI_LOAD_LOCAL || k == mir.MI_ADDR || k == mir.MI_LOAD_PTR ||
       k == mir.MI_BIN || k == mir.MI_UN || k == mir.MI_CALL || k == mir.MI_CALL_IND ||
       k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR || k == mir.MI_SELECT
}

fn a64_reads_temp(f &mir.MFn, ins &mir.MInstr, t int) bool {
    k := ins.kind
    if k == mir.MI_NOP || k == mir.MI_LOAD_LOCAL || k == mir.MI_ADDR ||
       k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
        << false
    }
    if k == mir.MI_COPY || k == mir.MI_STORE_LOCAL { << ins.b == t }
    if k == mir.MI_LOAD_PTR { << ins.b == t }
    if k == mir.MI_STORE_PTR { << ins.a == t || ins.b == t }
    if k == mir.MI_BIN { << ins.c == t || ins.d == t }
    if k == mir.MI_UN { << ins.c == t }
    if k == mir.MI_SELECT { << ins.b == t || ins.c == t || ins.d == t }
    if k == mir.MI_CALL || k == mir.MI_CALL_IND {
        if k == mir.MI_CALL_IND && ins.b == t { << true }
        $mi := ins.c
        while mi >= 0 {
            if f.margs[mi].v == t { << true }
            mi = f.margs[mi].next
        }
        << false
    }
    << true
}

fn a64_prepare_idx(f &mir.MFn, ra &RaInfo, uses &[]int, idx_mode $&[]int, idx_base $&[]int, idx_off $&[]int, idx_shift $&[]int) {
    ni := f.instrs.len
    nt := f.temps.len
    for _ in 0:ni {
        idx_mode.push(0)
        idx_base.push(-1)
        idx_off.push(-1)
        idx_shift.push(0)
    }
    $def_cnt := []int{}
    $def_blk := []int{}
    $def_ii := []int{}
    for _ in 0:nt {
        def_cnt.push(0)
        def_blk.push(-1)
        def_ii.push(-1)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if a64_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                def_cnt[ins.a] = def_cnt[ins.a] + 1
                def_blk[ins.a] = bi
                def_ii[ins.a] = ii
            }
            ii = ins.next
        }
    }
    for bi in 0:f.blocks.len {
        tk := f.blocks[bi].tkind
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && ins.b == mir.BIN_ADD &&
               ins.a >= 0 && ins.a < nt && def_cnt[ins.a] == 1 && def_blk[ins.a] == bi &&
               ins.c >= 0 && ins.d >= 0 {
                ptr_t := ins.a
                if !((tk == mir.TKIND_RETURN || tk == mir.TKIND_BRANCH) && f.blocks[bi].ta == ptr_t) {
                    for side in 0:2 {
                        $base_v := ins.c
                        $off_v := ins.d
                        if side == 1 {
                            base_v = ins.d
                            off_v = ins.c
                        }
                        if base_v == ptr_t || base_v == off_v { -> }
                        $shl_ii := -1
                        $idx_v := off_v
                        $s := 0
                        if off_v < nt && def_cnt[off_v] == 1 && def_blk[off_v] == bi &&
                           off_v < uses.len && uses[off_v] == 1 {
                            sii := def_ii[off_v]
                            sins := &f.instrs[sii]
                            if idx_mode[sii] == 0 && sins.kind == mir.MI_BIN && sins.b == mir.BIN_SHL &&
                               sins.c >= 0 && sins.d <= -2 {
                                sc := f.consts[0 - sins.d - 2]
                                if sc >= 0 && sc <= 3 {
                                    shl_ii = sii
                                    idx_v = sins.c
                                    s = sc
                                }
                            }
                        }
                        if idx_v == ptr_t || idx_v < 0 || idx_v >= nt || base_v >= nt { -> }
                        $cand_mems := []int{}
                        $last_use_ii := -1
                        $abort := false
                        $ui := ins.next
                        while ui >= 0 {
                            uins := &f.instrs[ui]
                            uk := uins.kind
                            if uk == mir.MI_LOAD_PTR && uins.b == ptr_t && uins.c == 0 {
                                $w := uins.d
                                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                                $need_s := 3
                                if w == 4 || w == -4 { need_s = 2 }
                                else if w == 2 { need_s = 1 }
                                else if w == 1 { need_s = 0 }
                                $fp_bad := w != 8 && a64_temp_reg(ra, uins.a) >= 32
                                if need_s == s && idx_mode[ui] == 0 && !fp_bad {
                                    cand_mems.push(ui)
                                    last_use_ii = ui
                                } else {
                                    abort = true
                                    <-
                                }
                            } else if uk == mir.MI_STORE_PTR && uins.a == ptr_t && uins.c == 0 && uins.b != ptr_t {
                                $w := uins.d
                                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                                $need_s := 3
                                if w == 4 || w == -4 { need_s = 2 }
                                else if w == 2 { need_s = 1 }
                                else if w == 1 { need_s = 0 }
                                $fp_bad := w != 8 && a64_temp_reg(ra, uins.b) >= 32
                                if need_s == s && idx_mode[ui] == 0 && !fp_bad {
                                    cand_mems.push(ui)
                                    last_use_ii = ui
                                } else {
                                    abort = true
                                    <-
                                }
                            } else if a64_reads_temp(f, uins, ptr_t) {
                                abort = true
                                <-
                            }
                            ui = uins.next
                        }
                        if abort || cand_mems.len == 0 || ptr_t >= uses.len || cand_mems.len != uses[ptr_t] {
                            ->
                        }
                        $safe := false
                        if cand_mems.len == 1 && last_use_ii == ins.next && (shl_ii < 0 || f.instrs[shl_ii].next == ii) {
                            safe = true
                        } else {
                            rb := a64_temp_reg(ra, base_v)
                            ri := a64_temp_reg(ra, idx_v)
                            if rb >= 0 && rb < 32 && ri >= 0 && ri < 32 {
                                safe = true
                                $saw_add := shl_ii < 0
                                $wi := ii
                                if shl_ii >= 0 { wi = shl_ii }
                                wi = f.instrs[wi].next
                                while wi >= 0 && wi != last_use_ii {
                                    if wi == ii {
                                        saw_add = true
                                    } else {
                                        wins := &f.instrs[wi]
                                        if a64_defines(wins.kind) && wins.a >= 0 {
                                            if wins.a == idx_v || (saw_add && wins.a == base_v) {
                                                safe = false
                                                <-
                                            }
                                            rw := a64_temp_reg(ra, wins.a)
                                            if rw == ri || (saw_add && rw == rb) {
                                                safe = false
                                                <-
                                            }
                                        }
                                        if wins.kind == mir.MI_STORE_LOCAL && wins.a >= 0 && wins.a < ra.local_reg.len {
                                            lr := ra.local_reg[wins.a]
                                            if lr == ri || (saw_add && lr == rb) {
                                                safe = false
                                                <-
                                            }
                                        }
                                        if wins.kind == mir.MI_CALL_IND || (wins.kind == mir.MI_CALL && !is_noreturn_call(&f.instrs[wi].sval)) {
                                            if ri < 19 || (saw_add && rb < 19) {
                                                safe = false
                                                <-
                                            }
                                        }
                                    }
                                    wi = f.instrs[wi].next
                                }
                            }
                        }
                        if safe {
                            if shl_ii >= 0 { idx_mode[shl_ii] = 1 }
                            idx_mode[ii] = 1
                            for ci in 0:cand_mems.len {
                                m := cand_mems[ci]
                                idx_mode[m] = 2
                                idx_base[m] = base_v
                                idx_off[m] = idx_v
                                idx_shift[m] = s
                            }
                            <-
                        }
                    }
                }
            }
            ii = ins.next
        }
        ii = f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if idx_mode[ii] == 0 && ins.kind == mir.MI_BIN && ins.b == mir.BIN_SHL &&
               ins.a >= 0 && ins.a < uses.len && uses[ins.a] == 1 && ins.c >= 0 && ins.d <= -2 {
                nx := ins.next
                if nx >= 0 && idx_mode[nx] == 0 {
                    nins := &f.instrs[nx]
                    if nins.kind == mir.MI_BIN && nins.b == mir.BIN_ADD && nins.a >= 0 {
                        if (nins.c == ins.a && nins.d >= 0 && nins.d != ins.a) ||
                           (nins.d == ins.a && nins.c >= 0 && nins.c != ins.a) {
                            $bv := nins.d
                            if nins.d == ins.a { bv = nins.c }
                            idx_mode[ii] = 1
                            idx_mode[nx] = 3
                            idx_base[nx] = bv
                            idx_off[nx] = ins.c
                            idx_shift[nx] = f.consts[0 - ins.d - 2] & 63
                        }
                    }
                }
            }
            ii = ins.next
        }
    }
}

const FV_CONST = 0
const FV_PARAM = 1
const FV_BIN = 2

struct FastNode {
    kind int
    val int
    bop int
    lhs int
    rhs int
}

struct FastExit {
    cond_node int
    want_true bool
    ret_node int
}

struct FastPlan {
    nodes []FastNode
    exits []FastExit
}

fn fv_noframe_kind(k int) bool {
    << k == mir.MI_NOP || k == mir.MI_COPY || k == mir.MI_LOAD_LOCAL || k == mir.MI_STORE_LOCAL ||
       k == mir.MI_LOAD_PTR || k == mir.MI_STORE_PTR || k == mir.MI_BIN || k == mir.MI_UN ||
       k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR || k == mir.MI_SELECT ||
       k == mir.MI_MADD || k == mir.MI_MSUB
}

fn can_elide_frame(f &mir.MFn, ra &RaInfo, opt bool) bool {
    if !opt || f.nparams > 8 || ra.used_callee.len > 0 {
        << false
    }
    if f.nparams > f.locals_nslots.len || f.nparams > ra.local_reg.len {
        << false
    }
    for i in 0:f.nparams {
        if f.locals_nslots[i] != 1 || ra.local_reg[i] < 0 {
            << false
        }
    }
    nb := f.blocks.len
    if nb == 0 {
        << false
    }
    $reach := []bool{}
    $q := []int{}
    for _ in 0:nb {
        reach.push(false)
    }
    reach[0] = true
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == mir.TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !reach[s] {
                reach[s] = true
                q.push(s)
            }
        } else if tk == mir.TKIND_BRANCH {
            sb := f.blocks[b].tb
            sc := f.blocks[b].tc
            if sb >= 0 && sb < nb && !reach[sb] {
                reach[sb] = true
                q.push(sb)
            }
            if sc >= 0 && sc < nb && !reach[sc] {
                reach[sc] = true
                q.push(sc)
            }
        }
    }
    nt := ra.temp_reg.len
    nl := f.locals_nslots.len
    for bi in 0:nb {
        if !reach[bi] {
            ->
        }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if !fv_noframe_kind(k) {
                << false
            }
            if k == mir.MI_LOAD_LOCAL || k == mir.MI_STORE_LOCAL {
                $loc := ins.a
                if k == mir.MI_LOAD_LOCAL { loc = ins.b }
                if ins.c != 0 || loc < 0 || loc >= nl || loc >= ra.local_reg.len {
                    << false
                }
                if f.locals_nslots[loc] != 1 || ra.local_reg[loc] < 0 {
                    << false
                }
                if k == mir.MI_STORE_LOCAL && ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0) {
                    << false
                }
                if k == mir.MI_LOAD_LOCAL && ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0) {
                    << false
                }
            } else {
                if a64_defines(k) && ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0) {
                    << false
                }
                if k == mir.MI_COPY || k == mir.MI_LOAD_PTR {
                    if ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0) { << false }
                } else if k == mir.MI_STORE_PTR {
                    if (ins.a >= 0 && (ins.a >= nt || ra.temp_reg[ins.a] < 0)) ||
                       (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) {
                        << false
                    }
                } else if k == mir.MI_BIN {
                    if (ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0)) ||
                       (ins.d >= 0 && (ins.d >= nt || ra.temp_reg[ins.d] < 0)) {
                        << false
                    }
                } else if k == mir.MI_UN {
                    if ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0) { << false }
                } else if k == mir.MI_SELECT || k == mir.MI_MADD || k == mir.MI_MSUB {
                    if (ins.b >= 0 && (ins.b >= nt || ra.temp_reg[ins.b] < 0)) ||
                       (ins.c >= 0 && (ins.c >= nt || ra.temp_reg[ins.c] < 0)) ||
                       (ins.d >= 0 && (ins.d >= nt || ra.temp_reg[ins.d] < 0)) {
                        << false
                    }
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if (tk == mir.TKIND_RETURN || tk == mir.TKIND_BRANCH) && f.blocks[bi].ta >= 0 {
            ta := f.blocks[bi].ta
            if ta >= nt || ra.temp_reg[ta] < 0 {
                << false
            }
        }
    }
    << true
}

fn fv_is_arith_op(op int) bool {
    << op == mir.BIN_ADD || op == mir.BIN_SUB || op == mir.BIN_MUL ||
       op == mir.BIN_AND || op == mir.BIN_OR || op == mir.BIN_XOR
}

fn fv_is_cmp_op(op int) bool {
    << op >= mir.BIN_EQ && op <= mir.BIN_GE
}

fn fv_depth(nodes &[]FastNode, ni int) int {
    if ni < 0 || ni >= nodes.len {
        << 99
    }
    nd := &nodes[ni]
    if nd.kind != FV_BIN {
        << 0
    }
    ld := fv_depth(nodes, nd.lhs)
    rd := fv_depth(nodes, nd.rhs)
    if ld > rd {
        << ld + 1
    }
    << rd + 1
}

fn fv_pure_only(nodes &[]FastNode, ni int, allow_cmp_root bool) bool {
    if ni < 0 || ni >= nodes.len {
        << false
    }
    nd := &nodes[ni]
    if nd.kind != FV_BIN {
        << true
    }
    if fv_is_cmp_op(nd.bop) {
        if !allow_cmp_root {
            << false
        }
        << fv_pure_only(nodes, nd.lhs, false) && fv_pure_only(nodes, nd.rhs, false)
    }
    if !fv_is_arith_op(nd.bop) {
        << false
    }
    << fv_pure_only(nodes, nd.lhs, false) && fv_pure_only(nodes, nd.rhs, false)
}

fn fv_eval_op(f &mir.MFn, nodes $&[]FastNode, temp_node &[]int, v int) int {
    if v <= -2 {
        cidx := 0 - v - 2
        if cidx < 0 || cidx >= f.consts.len {
            << -1
        }
        idx := nodes.len
        nodes.push(FastNode{kind: FV_CONST, val: f.consts[cidx], bop: 0, lhs: -1, rhs: -1})
        << idx
    }
    if v >= 0 && v < temp_node.len {
        << temp_node[v]
    }
    << -1
}

fn fv_sim_block(f &mir.MFn, bi int, nodes $&[]FastNode, loc_node $&[]int, temp_node $&[]int, max_ins int) bool {
    $ii := f.blocks[bi].head
    $cnt := 0
    while ii >= 0 {
        ins := &f.instrs[ii]
        k := ins.kind
        if k == mir.MI_NOP {
            ii = ins.next
            ->
        }
        cnt += 1
        if cnt > max_ins {
            << false
        }
        if k == mir.MI_COPY {
            if ins.a < 0 || ins.a >= temp_node.len { << false }
            sn := fv_eval_op(f, nodes, temp_node, ins.b)
            if sn < 0 { << false }
            temp_node[ins.a] = sn
        } else if k == mir.MI_LOAD_LOCAL {
            if ins.c != 0 || ins.a < 0 || ins.a >= temp_node.len || ins.b < 0 || ins.b >= loc_node.len {
                << false
            }
            if loc_node[ins.b] < 0 { << false }
            temp_node[ins.a] = loc_node[ins.b]
        } else if k == mir.MI_STORE_LOCAL {
            if ins.c != 0 || ins.a < 0 || ins.a >= loc_node.len { << false }
            sn := fv_eval_op(f, nodes, temp_node, ins.b)
            if sn < 0 { << false }
            loc_node[ins.a] = sn
        } else if k == mir.MI_BIN {
            if ins.a < 0 || ins.a >= temp_node.len || (!fv_is_arith_op(ins.b) && !fv_is_cmp_op(ins.b)) {
                << false
            }
            ln := fv_eval_op(f, nodes, temp_node, ins.c)
            rn := fv_eval_op(f, nodes, temp_node, ins.d)
            if ln < 0 || rn < 0 { << false }
            idx := nodes.len
            nodes.push(FastNode{kind: FV_BIN, val: 0, bop: ins.b, lhs: ln, rhs: rn})
            temp_node[ins.a] = idx
        } else {
            << false
        }
        ii = ins.next
    }
    << true
}

fn fv_try_pure_ret(f &mir.MFn, start_b int, nodes $&[]FastNode, loc_node &[]int, temp_node &[]int) int {
    $lcpy := []int{}
    $tcpy := []int{}
    for i in 0:loc_node.len { lcpy.push(loc_node[i]) }
    for i in 0:temp_node.len { tcpy.push(temp_node[i]) }
    $b := start_b
    for step in 0:2 {
        if b < 0 || b >= f.blocks.len {
            << -1
        }
        if !fv_sim_block(f, b, nodes, $&lcpy, $&tcpy, 8) {
            << -1
        }
        tk := f.blocks[b].tkind
        if tk == mir.TKIND_RETURN {
            rn := fv_eval_op(f, nodes, &tcpy, f.blocks[b].ta)
            if rn >= 0 && fv_pure_only(nodes, rn, false) && fv_depth(nodes, rn) <= 2 {
                << rn
            }
            << -1
        }
        if tk == mir.TKIND_JUMP && step == 0 && f.blocks[b].ta != b {
            b = f.blocks[b].ta
        } else {
            << -1
        }
    }
    << -1
}

fn analyze_fast_entry(f &mir.MFn) FastPlan {
    $plan := FastPlan{nodes: []FastNode{}, exits: []FastExit{}}
    if !f.scalar_params || f.nparams <= 0 || f.nparams > 6 || f.blocks.len < 2 {
        << plan
    }
    if f.nparams > f.locals_nslots.len {
        << plan
    }
    $loc_node := []int{}
    for i in 0:f.locals.len {
        if i < f.nparams {
            if f.locals_nslots[i] != 1 {
                << plan
            }
            plan.nodes.push(FastNode{kind: FV_PARAM, val: i, bop: 0, lhs: -1, rhs: -1})
            loc_node.push(i)
        } else {
            loc_node.push(-1)
        }
    }
    $temp_node := []int{}
    for _ in 0:f.temps.len {
        temp_node.push(-1)
    }
    $vis := []bool{}
    for _ in 0:f.blocks.len {
        vis.push(false)
    }
    $cur_b := 0
    for _ in 0:8 {
        if cur_b < 0 || cur_b >= f.blocks.len || vis[cur_b] || plan.exits.len >= 4 {
            <-
        }
        vis[cur_b] = true
        if !fv_sim_block(f, cur_b, $&plan.nodes, $&loc_node, $&temp_node, 16) {
            <-
        }
        tk := f.blocks[cur_b].tkind
        if tk == mir.TKIND_JUMP {
            cur_b = f.blocks[cur_b].ta
            ->
        }
        if tk != mir.TKIND_BRANCH {
            <-
        }
        cn := fv_eval_op(f, $&plan.nodes, &temp_node, f.blocks[cur_b].ta)
        if cn < 0 || !fv_pure_only(&plan.nodes, cn, true) || fv_depth(&plan.nodes, cn) > 2 {
            <-
        }
        tb := f.blocks[cur_b].tb
        tc := f.blocks[cur_b].tc
        $rt := -1
        if tb >= 0 && tb < vis.len && !vis[tb] {
            rt = fv_try_pure_ret(f, tb, $&plan.nodes, &loc_node, &temp_node)
        }
        if rt >= 0 {
            plan.exits.push(FastExit{cond_node: cn, want_true: true, ret_node: rt})
            cur_b = tc
            ->
        }
        $re := -1
        if tc >= 0 && tc < vis.len && !vis[tc] {
            re = fv_try_pure_ret(f, tc, $&plan.nodes, &loc_node, &temp_node)
        }
        if re >= 0 {
            plan.exits.push(FastExit{cond_node: cn, want_true: false, ret_node: re})
            cur_b = tb
            ->
        }
        <-
    }
    << plan
}

fn fv_invert_cmp(op int) int {
    if op == mir.BIN_EQ { << mir.BIN_NE }
    if op == mir.BIN_NE { << mir.BIN_EQ }
    if op == mir.BIN_LT { << mir.BIN_GE }
    if op == mir.BIN_GE { << mir.BIN_LT }
    if op == mir.BIN_LE { << mir.BIN_GT }
    if op == mir.BIN_GT { << mir.BIN_LE }
    << mir.BIN_NE
}

fn a64_fast_sc(i int) int {
    if i == 0 { << 9 }
    if i == 1 { << 10 }
    << 11
}

fn a64_eval_fast_node(cb $&mc.CodeBuffer, nodes &[]FastNode, ni int, sc_idx int) int {
    nd := &nodes[ni]
    if nd.kind == FV_PARAM {
        << nd.val
    }
    if nd.kind == FV_CONST {
        rd := a64_fast_sc(sc_idx)
        a64_mov_imm(cb, rd, nd.val)
        << rd
    }
    lr := a64_eval_fast_node(cb, nodes, nd.lhs, sc_idx)
    rd := a64_fast_sc(sc_idx)
    if (nd.bop == mir.BIN_ADD || nd.bop == mir.BIN_SUB) && nodes[nd.rhs].kind == FV_CONST {
        cv := nodes[nd.rhs].val
        if cv >= 0 && cv <= 4095 {
            if nd.bop == mir.BIN_ADD {
                a64_add_imm(cb, rd, lr, cv)
            } else {
                e32(cb, 0xD1000000 | (cv << 10) | (lr << 5) | rd)
            }
            << rd
        }
    }
    rr := a64_eval_fast_node(cb, nodes, nd.rhs, sc_idx + 1)
    a64_bin(cb, nd.bop, rd, lr, rr)
    << rd
}

fn a64_emit_fast_guard(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, nodes &[]FastNode, ex &FastExit, lbl string) {
    cn := ex.cond_node
    nd := &nodes[cn]
    if nd.kind == FV_BIN && fv_is_cmp_op(nd.bop) {
        $op := nd.bop
        if !ex.want_true {
            op = fv_invert_cmp(op)
        }
        if (op == mir.BIN_EQ || op == mir.BIN_NE) && nodes[nd.rhs].kind == FV_CONST && nodes[nd.rhs].val == 0 {
            lr := a64_eval_fast_node(cb, nodes, nd.lhs, 0)
            $opc := 0xB4000000
            if op == mir.BIN_NE { opc = 0xB5000000 }
            a64_branch_reloc(cb, relocs, opc | lr, lbl, mc.RELOC_ARM64_COND_BR19)
            <<
        }
        lr := a64_eval_fast_node(cb, nodes, nd.lhs, 0)
        if nodes[nd.rhs].kind == FV_CONST && nodes[nd.rhs].val >= 0 && nodes[nd.rhs].val <= 4095 {
            e32(cb, 0xF100001F | (nodes[nd.rhs].val << 10) | (lr << 5))
        } else {
            rr := a64_eval_fast_node(cb, nodes, nd.rhs, 1)
            a64_cmp(cb, lr, rr)
        }
        a64_branch_reloc(cb, relocs, 0x54000000 | a64_cond_of(op), lbl, mc.RELOC_ARM64_COND_BR19)
        <<
    }
    lr := a64_eval_fast_node(cb, nodes, cn, 0)
    $opc := 0xB5000000
    if !ex.want_true { opc = 0xB4000000 }
    a64_branch_reloc(cb, relocs, opc | lr, lbl, mc.RELOC_ARM64_COND_BR19)
}

pub fn isel_fn_arm64_base(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, lines $&[]int, opt bool) {
    $fr := a64_frame(f)
    ra := a64_ra(f, opt)
    leaf_noframe := can_elide_frame(f, &ra, opt)
    $fp_plan := FastPlan{nodes: []FastNode{}, exits: []FastExit{}}
    if opt && !leaf_noframe {
        fp_plan = analyze_fast_entry(f)
    }
    // Saved callee registers sit above the locals and temps.
    save_off := fr.size
    if ra.used_callee.len > 0 {
        fr.size = (fr.size + ra.used_callee.len * 8 + 15) / 16 * 16
    }
    syms.define_label(f.label, cb.len())
    $last_line := f.src_line
    if last_line > 0 {
        lines.push(cb.len())
        lines.push(last_line)
    }
    for ei in 0:fp_plan.exits.len {
        a64_emit_fast_guard(cb, relocs, &fp_plan.nodes, &fp_plan.exits[ei], f.label + ".fp" + str(ei))
    }
    // Prologue.
    if !leaf_noframe {
        e32(cb, 0xA9BF7BFD)
        e32(cb, 0x910003FD)
        if fr.size > 0 {
            a64_sub_sp(cb, fr.size)
        }
        for ci in 0:ra.used_callee.len {
            r := ra.used_callee[ci]
            if r >= 32 {
                a64_fmem(cb, true, r - 32, R_SP, save_off + ci * 8)
            } else {
                a64_str(cb, r, R_SP, save_off + ci * 8)
            }
        }
    }
    a64_copy_params(cb, f, &fr, &ra)
    $strs := []StrFix{}
    $str_aligns := []int{}
    $uses := []int{}
    $idx_mode := []int{}
    $idx_base := []int{}
    $idx_off := []int{}
    $idx_shift := []int{}
    if opt {
        uses = temp_use_counts(f)
        a64_prepare_idx(f, &ra, &uses, $&idx_mode, $&idx_base, $&idx_off, $&idx_shift)
    }
    $order := []int{}
    if opt {
        $cold_list := []int{}
        for obi in 0:f.blocks.len {
            $cold := false
            if obi > 0 {
                $cii := f.blocks[obi].head
                while cii >= 0 {
                    cins := &f.instrs[cii]
                    if cins.kind == mir.MI_CALL && is_noreturn_call(&f.instrs[cii].sval) {
                        cold = true
                        <-
                    }
                    cii = cins.next
                }
            }
            if !cold { order.push(obi) }
            else { cold_list.push(obi) }
        }
        for ci in 0:cold_list.len {
            order.push(cold_list[ci])
        }
    } else {
        for obi in 0:f.blocks.len {
            order.push(obi)
        }
    }
    // Local labels use "." so they cannot collide with any function label.
    epilogue := f.label + ".ret"
    for oi in 0:order.len {
        bi := order[oi]
        $next_bi := -1
        if oi + 1 < order.len { next_bi = order[oi + 1] }
        syms.define_label(f.label + ".bb" + str(bi), cb.len())
        // A compare feeding only this block's branch becomes cmp + b.cond.
        $fused := -1
        // A tagged bounds check (idx < 0 || idx >= len) ending the block
        // becomes one unsigned compare.
        bounds := a64_bounds_check(f, bi, &uses, opt)
        // A compare read only by the MI_SELECT right after it leaves its
        // condition in the flags for csel.
        $sel_cond := -1
        $ii := f.blocks[bi].head
        // An instruction already emitted together with its predecessor.
        $paired := -1
        while ii >= 0 {
            if (bounds.len > 0 && (ii == bounds[0] || ii == bounds[1] || ii == bounds[2])) || ii == paired || (opt && idx_mode[ii] == 1) {
                ii = f.instrs[ii].next
                ->
            }
            ins := ~f.instrs[ii]
            k := ins.kind
            if ins.line > 0 && ins.line != last_line {
                last_line = ins.line
                lines.push(cb.len())
                lines.push(last_line)
            }
            $pk := 0
            if opt {
                pk = a64_fuse2(f, &ins, &uses)
            }
            if pk == 1 {
                nx := ~f.instrs[ins.next]
                rh := a64_src(cb, f, &fr, &ra, ins.c, 9)
                rd := a64_dst(&ra, nx.a, 9)
                // sub rd, rh, rh, asr #63
                e32(cb, 0xCB800000 | (rh << 16) | (63 << 10) | (rh << 5) | rd)
                a64_put(cb, &fr, &ra, nx.a, rd)
                paired = ins.next
            } else if pk == 2 {
                nx := ~f.instrs[ins.next]
                rn := a64_src(cb, f, &fr, &ra, ins.c, 9)
                rm := a64_src(cb, f, &fr, &ra, ins.d, 10)
                rx := a64_src(cb, f, &fr, &ra, nx.c, 11)
                rd := a64_dst(&ra, nx.a, 9)
                // msub rd, rn, rm, rx (rd = rx - rn * rm)
                e32(cb, 0x9B008000 | (rm << 16) | (rx << 10) | (rn << 5) | rd)
                a64_put(cb, &fr, &ra, nx.a, rd)
                paired = ins.next
            } else if opt && k == mir.MI_BIN && ins.next < 0 && a64_is_icmp(ins.b) && f.blocks[bi].tkind == mir.TKIND_BRANCH && f.blocks[bi].ta == ins.a && ins.a >= 0 && uses[ins.a] == 1 {
                a64_cmp_vals(cb, f, &fr, &ra, ins.c, ins.d)
                fused = a64_cond_of(ins.b)
            } else if opt && k == mir.MI_BIN && ins.next < 0 && a64_is_fcmp(ins.b) && f.blocks[bi].tkind == mir.TKIND_BRANCH && f.blocks[bi].ta == ins.a && ins.a >= 0 && uses[ins.a] == 1 {
                fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                fm := a64_fsrc(cb, f, &fr, &ra, ins.d, 1)
                e32(cb, 0x1E602000 | (fm << 16) | (fx << 5))
                fused = a64_fcond_of(ins.b)
            } else if opt && k == mir.MI_BIN && a64_is_icmp(ins.b) && ins.next >= 0 && f.instrs[ins.next].kind == mir.MI_SELECT && f.instrs[ins.next].b == ins.a && ins.a >= 0 && uses[ins.a] == 1 {
                a64_cmp_vals(cb, f, &fr, &ra, ins.c, ins.d)
                sel_cond = a64_cond_of(ins.b)
            } else if opt && k == mir.MI_BIN && a64_is_fcmp(ins.b) && ins.next >= 0 && f.instrs[ins.next].kind == mir.MI_SELECT && f.instrs[ins.next].b == ins.a && ins.a >= 0 && uses[ins.a] == 1 {
                fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                fm := a64_fsrc(cb, f, &fr, &ra, ins.d, 1)
                e32(cb, 0x1E602000 | (fm << 16) | (fx << 5))
                sel_cond = a64_fcond_of(ins.b)
            } else if opt && idx_mode[ii] == 3 {
                rn := a64_src(cb, f, &fr, &ra, idx_base[ii], 9)
                rm := a64_src(cb, f, &fr, &ra, idx_off[ii], 10)
                rd := a64_dst(&ra, ins.a, 9)
                e32(cb, 0x8B000000 | (rm << 16) | (idx_shift[ii] << 10) | (rn << 5) | rd)
                a64_put(cb, &fr, &ra, ins.a, rd)
            } else if opt && k == mir.MI_BIN && a64_is_icmp(ins.b) && a64_can_cmp_imm(f, ins.d) {
                a64_cmp_vals(cb, f, &fr, &ra, ins.c, ins.d)
                rd := a64_dst(&ra, ins.a, 9)
                a64_cset(cb, rd, a64_cond_of(ins.b))
                a64_put(cb, &fr, &ra, ins.a, rd)
            } else if opt && k == mir.MI_BIN && ((ins.c > -2 && ins.d <= -2 && a64_can_bin_imm(f, ins.b, ins.d)) || (ins.d > -2 && ins.c <= -2 && (ins.b == mir.BIN_ADD || ins.b == mir.BIN_AND || ins.b == mir.BIN_OR || ins.b == mir.BIN_XOR) && a64_can_bin_imm(f, ins.b, ins.c))) {
                $lhs := ins.c
                $rhs := ins.d
                if ins.c <= -2 {
                    lhs = ins.d
                    rhs = ins.c
                }
                rn := a64_src(cb, f, &fr, &ra, lhs, 9)
                rd := a64_dst(&ra, ins.a, 9)
                a64_bin_imm(cb, f, ins.b, rd, rn, rhs)
                a64_put(cb, &fr, &ra, ins.a, rd)
            } else if k == mir.MI_NOP {
            } else if k == mir.MI_LOAD_LOCAL {
                lr := ra.local_reg[ins.b]
                if lr >= 0 {
                    a64_put(cb, &fr, &ra, ins.a, lr)
                } else {
                    $w := ins.c
                    if w < 0 { w = 0 }
                    dr := a64_temp_reg(&ra, ins.a)
                    if dr >= 32 {
                        a64_fmem(cb, false, dr - 32, R_SP, fr.local_off[ins.b] + w * 8)
                    } else {
                        rd := a64_dst(&ra, ins.a, 9)
                        a64_ldr(cb, rd, R_SP, fr.local_off[ins.b] + w * 8)
                        a64_put(cb, &fr, &ra, ins.a, rd)
                    }
                }
            } else if k == mir.MI_STORE_LOCAL {
                lr := ra.local_reg[ins.a]
                if lr >= 0 {
                    a64_load_to(cb, f, &fr, &ra, lr, ins.b)
                } else {
                    $w := ins.c
                    if w < 0 { w = 0 }
                    sr := a64_temp_reg(&ra, ins.b)
                    if sr >= 32 {
                        a64_fmem(cb, true, sr - 32, R_SP, fr.local_off[ins.a] + w * 8)
                    } else {
                        rs := a64_src(cb, f, &fr, &ra, ins.b, 9)
                        a64_str(cb, rs, R_SP, fr.local_off[ins.a] + w * 8)
                    }
                }
            } else if k == mir.MI_ADDR {
                rd := a64_dst(&ra, ins.a, 9)
                a64_add_imm(cb, rd, R_SP, fr.local_off[ins.b])
                a64_put(cb, &fr, &ra, ins.a, rd)
            } else if k == mir.MI_LOAD_PTR {
                $w := ins.d
                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                dr := a64_temp_reg(&ra, ins.a)
                if opt && idx_mode[ii] == 2 {
                    rb := a64_src(cb, f, &fr, &ra, idx_base[ii], 10)
                    rm := a64_src(cb, f, &fr, &ra, idx_off[ii], 11)
                    if w == 8 && dr >= 32 {
                        fd := dr - 32
                        e32(cb, 0xFC607800 | (rm << 16) | (rb << 5) | fd)
                    } else {
                        rd := a64_dst(&ra, ins.a, 9)
                        a64_mem_idx(cb, false, w, rd, rb, rm, idx_shift[ii])
                        a64_put(cb, &fr, &ra, ins.a, rd)
                    }
                } else {
                    rb := a64_src(cb, f, &fr, &ra, ins.b, 10)
                    if w == 8 && dr >= 32 {
                        a64_fmem(cb, false, dr - 32, rb, ins.c)
                    } else {
                        rd := a64_dst(&ra, ins.a, 9)
                        a64_mem(cb, false, w, rd, rb, ins.c)
                        a64_put(cb, &fr, &ra, ins.a, rd)
                    }
                }
            } else if k == mir.MI_STORE_PTR {
                $w := ins.d
                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                sr := a64_temp_reg(&ra, ins.b)
                if opt && idx_mode[ii] == 2 {
                    rb := a64_src(cb, f, &fr, &ra, idx_base[ii], 10)
                    rm := a64_src(cb, f, &fr, &ra, idx_off[ii], 11)
                    if w == 8 && sr >= 32 {
                        fd := sr - 32
                        e32(cb, 0xFC207800 | (rm << 16) | (rb << 5) | fd)
                    } else {
                        $rs := 31
                        if !opt || ins.b > -2 || f.consts[0 - ins.b - 2] != 0 {
                            rs = a64_src(cb, f, &fr, &ra, ins.b, 9)
                        }
                        a64_mem_idx(cb, true, w, rs, rb, rm, idx_shift[ii])
                    }
                } else {
                    rb := a64_src(cb, f, &fr, &ra, ins.a, 10)
                    if w == 8 && sr >= 32 {
                        a64_fmem(cb, true, sr - 32, rb, ins.c)
                    } else {
                        $rs := 31
                        if !opt || ins.b > -2 || f.consts[0 - ins.b - 2] != 0 {
                            rs = a64_src(cb, f, &fr, &ra, ins.b, 9)
                        }
                        a64_mem(cb, true, w, rs, rb, ins.c)
                    }
                }
            } else if k == mir.MI_BIN {
                if ins.b >= mir.BIN_FADD && ins.b <= mir.BIN_FGE {
                    fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                    fm := a64_fsrc(cb, f, &fr, &ra, ins.d, 1)
                    if ins.b <= mir.BIN_FDIV {
                        fd := a64_fdst(&ra, ins.a, 0)
                        $base := 0x1E602800
                        if ins.b == mir.BIN_FSUB { base = 0x1E603800 }
                        else if ins.b == mir.BIN_FMUL { base = 0x1E600800 }
                        else if ins.b == mir.BIN_FDIV { base = 0x1E601800 }
                        a64_rrr(cb, base, fd, fx, fm)
                        a64_put(cb, &fr, &ra, ins.a, 32 + fd)
                    } else {
                        e32(cb, 0x1E602000 | (fm << 16) | (fx << 5))
                        rd := a64_dst(&ra, ins.a, 9)
                        a64_cset(cb, rd, a64_fcond_of(ins.b))
                        a64_put(cb, &fr, &ra, ins.a, rd)
                    }
                } else {
                    $fneg_v := -1
                    if opt {
                        fneg_v = a64_fneg_operand(f, &ra, &ins)
                    }
                    if fneg_v >= 0 {
                        fx := a64_fsrc(cb, f, &fr, &ra, fneg_v, 0)
                        fd := a64_fdst(&ra, ins.a, 0)
                        e32(cb, 0x1E614000 | (fx << 5) | fd)
                        a64_put(cb, &fr, &ra, ins.a, 32 + fd)
                    } else {
                        rn := a64_src(cb, f, &fr, &ra, ins.c, 9)
                        rm := a64_src(cb, f, &fr, &ra, ins.d, 10)
                        rd := a64_dst(&ra, ins.a, 9)
                        a64_bin(cb, ins.b, rd, rn, rm)
                        a64_put(cb, &fr, &ra, ins.a, rd)
                    }
                }
            } else if k == mir.MI_UN {
                if ins.b == mir.UN_I2F {
                    rn := a64_src(cb, f, &fr, &ra, ins.c, 9)
                    fd := a64_fdst(&ra, ins.a, 0)
                    e32(cb, 0x9E620000 | (rn << 5) | fd)
                    a64_put(cb, &fr, &ra, ins.a, 32 + fd)
                } else if ins.b == mir.UN_F2I {
                    fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                    rd := a64_dst(&ra, ins.a, 9)
                    e32(cb, 0x9E780000 | (fx << 5) | rd)
                    a64_put(cb, &fr, &ra, ins.a, rd)
                } else if ins.b == mir.UN_FSQRT {
                    fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                    fd := a64_fdst(&ra, ins.a, 0)
                    e32(cb, 0x1E61C000 | (fx << 5) | fd)
                    a64_put(cb, &fr, &ra, ins.a, 32 + fd)
                } else if ins.b == mir.UN_F32_LOAD {
                    // fmov s2, wn ; fcvt d2, s2 ; fmov xd, d2 (v0-v2 are
                    // never allocated)
                    rn := a64_src(cb, f, &fr, &ra, ins.c, 9)
                    e32(cb, 0x1E270000 | (rn << 5) | 2)
                    e32(cb, 0x1E22C000 | (2 << 5) | 2)
                    rd := a64_dst(&ra, ins.a, 9)
                    e32(cb, 0x9E660000 | (2 << 5) | rd)
                    a64_put(cb, &fr, &ra, ins.a, rd)
                } else if ins.b == mir.UN_F32_STORE {
                    // fmov d2, xn ; fcvt s2, d2 ; fmov wd, s2
                    rn := a64_src(cb, f, &fr, &ra, ins.c, 9)
                    e32(cb, 0x9E670000 | (rn << 5) | 2)
                    e32(cb, 0x1E624000 | (2 << 5) | 2)
                    rd := a64_dst(&ra, ins.a, 9)
                    e32(cb, 0x1E260000 | (2 << 5) | rd)
                    a64_put(cb, &fr, &ra, ins.a, rd)
                } else {
                    e32(cb, 0xD4200000)
                }
            } else if k == mir.MI_SELECT {
                // [cmp xc, #0]; csel xd, xthen, xelse, cond (operand loads
                // between the compare and csel leave the flags alone).
                $cond := sel_cond
                sel_cond = -1
                if cond < 0 {
                    rc := a64_src(cb, f, &fr, &ra, ins.b, 9)
                    e32(cb, 0xF100001F | (rc << 5))
                    cond = target.ARM64_COND_NE
                }
                if a64_temp_reg(&ra, ins.a) >= 32 {
                    fx := a64_fsrc(cb, f, &fr, &ra, ins.c, 0)
                    fm := a64_fsrc(cb, f, &fr, &ra, ins.d, 1)
                    fd := a64_fdst(&ra, ins.a, 0)
                    e32(cb, 0x1E600C00 | (fm << 16) | (cond << 12) | (fx << 5) | fd)
                    a64_put(cb, &fr, &ra, ins.a, 32 + fd)
                } else {
                    $rn := 31
                    if ins.c > -2 || f.consts[0 - ins.c - 2] != 0 {
                        rn = a64_src(cb, f, &fr, &ra, ins.c, 10)
                    }
                    $rm := 31
                    if ins.d > -2 || f.consts[0 - ins.d - 2] != 0 {
                        rm = a64_src(cb, f, &fr, &ra, ins.d, 11)
                    }
                    rd := a64_dst(&ra, ins.a, 9)
                    e32(cb, 0x9A800000 | (rm << 16) | (cond << 12) | (rn << 5) | rd)
                    a64_put(cb, &fr, &ra, ins.a, rd)
                }
            } else if k == mir.MI_COPY {
                r := a64_temp_reg(&ra, ins.a)
                if r >= 0 {
                    a64_load_to(cb, f, &fr, &ra, r, ins.b)
                } else if a64_temp_reg(&ra, ins.b) >= 32 {
                    if ins.a >= 0 && ins.a < fr.temp_off.len {
                        a64_fmem(cb, true, a64_temp_reg(&ra, ins.b) - 32, R_SP, fr.temp_off[ins.a])
                    }
                } else {
                    rs := a64_src(cb, f, &fr, &ra, ins.b, 9)
                    a64_set_temp(cb, &fr, ins.a, rs)
                }
            } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
                $a := ins.c
                $i := 0
                while a >= 0 {
                    if i < 8 {
                        a64_load_to(cb, f, &fr, &ra, i, f.margs[a].v)
                    } else {
                        sr := a64_temp_reg(&ra, f.margs[a].v)
                        if sr >= 32 {
                            a64_fmem(cb, true, sr - 32, R_SP, (i - 8) * 8)
                        } else {
                            rs := a64_src(cb, f, &fr, &ra, f.margs[a].v, 9)
                            a64_str(cb, rs, R_SP, (i - 8) * 8)
                        }
                    }
                    i += 1
                    a = f.margs[a].next
                }
                if k == mir.MI_CALL_IND {
                    // blr x16
                    a64_load_to(cb, f, &fr, &ra, R_IP0, ins.b)
                    e32(cb, 0xD63F0000 | (R_IP0 << 5))
                } else if !opt || !a64_bits_call(cb, &ins.sval) {
                    a64_branch_reloc(cb, relocs, 0x94000000, ins.sval, mc.RELOC_ARM64_CALL26)
                }
                a64_put(cb, &fr, &ra, ins.a, 0)
            } else if k == mir.MI_STR_CONST {
                strs.push(StrFix{adr_off: cb.len(), bytes: ins.sval + ""})
                str_aligns.push(ins.d)
                e32(cb, 0x10000000 | 9)
                a64_put(cb, &fr, &ra, ins.a, 9)
            } else if k == mir.MI_LOAD_FN_ADDR {
                a64_fn_addr(cb, relocs, 9, ins.sval)
                a64_put(cb, &fr, &ra, ins.a, 9)
            } else {
                // Unknown kinds are a lowering bug; trap loudly at run time.
                e32(cb, 0xD4200000)
            }
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        if blk.tkind == mir.TKIND_RETURN {
            a64_load_to(cb, f, &fr, &ra, 0, blk.ta)
            if leaf_noframe {
                e32(cb, 0xD65F03C0)
            } else {
                a64_branch_reloc(cb, relocs, 0x14000000, epilogue, mc.RELOC_ARM64_CALL26)
            }
        } else if blk.tkind == mir.TKIND_JUMP {
            if blk.ta != next_bi {
                a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.ta), mc.RELOC_ARM64_CALL26)
            }
        } else if blk.tkind == mir.TKIND_BRANCH && bounds.len > 0 {
            a64_cmp_vals(cb, f, &fr, &ra, bounds[3], bounds[4])
            // b.hs / b.lo
            if blk.tb == next_bi {
                a64_branch_reloc(cb, relocs, 0x54000003, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_COND_BR19)
            } else {
                a64_branch_reloc(cb, relocs, 0x54000002, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_COND_BR19)
                if blk.tc != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_CALL26)
                }
            }
        } else if blk.tkind == mir.TKIND_BRANCH && fused >= 0 {
            if blk.tb == next_bi {
                a64_branch_reloc(cb, relocs, 0x54000000 | (fused ^ 1), f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_COND_BR19)
            } else {
                a64_branch_reloc(cb, relocs, 0x54000000 | fused, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_COND_BR19)
                if blk.tc != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_CALL26)
                }
            }
        } else if blk.tkind == mir.TKIND_BRANCH {
            rc := a64_src(cb, f, &fr, &ra, blk.ta, 9)
            if blk.tb == next_bi {
                a64_branch_reloc(cb, relocs, 0xB4000000 | rc, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_COND_BR19)
            } else {
                a64_branch_reloc(cb, relocs, 0xB5000000 | rc, f.label + ".bb" + str(blk.tb), mc.RELOC_ARM64_COND_BR19)
                if blk.tc != next_bi {
                    a64_branch_reloc(cb, relocs, 0x14000000, f.label + ".bb" + str(blk.tc), mc.RELOC_ARM64_CALL26)
                }
            }
        } else {
            // Open block at function end: return 0.
            a64_mov_imm(cb, 0, 0)
            if leaf_noframe {
                e32(cb, 0xD65F03C0)
            } else {
                a64_branch_reloc(cb, relocs, 0x14000000, epilogue, mc.RELOC_ARM64_CALL26)
            }
        }
    }
    syms.define_label(epilogue, cb.len())
    if !leaf_noframe {
        for ci in 0:ra.used_callee.len {
            r := ra.used_callee[ci]
            if r >= 32 {
                a64_fmem(cb, false, r - 32, R_SP, save_off + ci * 8)
            } else {
                a64_ldr(cb, r, R_SP, save_off + ci * 8)
            }
        }
        e32(cb, 0x910003BF)
        e32(cb, 0xA8C17BFD)
    }
    e32(cb, 0xD65F03C0)
    for ei in 0:fp_plan.exits.len {
        syms.define_label(f.label + ".fp" + str(ei), cb.len())
        rn := fp_plan.exits[ei].ret_node
        if fp_plan.nodes[rn].kind == FV_CONST {
            a64_mov_imm(cb, 0, fp_plan.nodes[rn].val)
        } else {
            rr := a64_eval_fast_node(cb, &fp_plan.nodes, rn, 0)
            if rr != 0 {
                a64_mov(cb, 0, rr)
            }
        }
        e32(cb, 0xD65F03C0)
    }
    // String literal pool, patched into the ADR instructions above.
    for si in 0:strs.len {
        if si < str_aligns.len && str_aligns[si] == 8 {
            while cb.len() % 8 != 0 {
                cb.emit_u8(0)
            }
        }
        pos := cb.len()
        s := strs[si].bytes
        for bi2 in 0:s.len {
            cb.emit_u8(s[bi2])
        }
        cb.emit_u8(0)
        while cb.len() % 4 != 0 {
            cb.emit_u8(0)
        }
        at := strs[si].adr_off
        disp := pos - at
        word := 0x10000000 | ((disp & 3) << 29) | (((disp >> 2) & 0x7ffff) << 5) | 9
        cb.patch_u32_le(at, word)
    }
}

fn a64_pair(cb $&mc.CodeBuffer, base int, rt int, rt2 int, rn int, off int) {
    e32(cb, base | (((off / 8) & 0x7f) << 15) | (rt2 << 10) | (rn << 5) | rt)
}

// Task context layout (runtime/core chan.xu): x19-x28 at 0, fp/lr at 80,
// sp at 96, d8-d15 at 104.
fn emit_arm64_task_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    // __xu_task_switch(from x0, to x1): save the callee-saved state into
    // from, resume to.
    syms.define_label("__xu_task_switch", cb.len())
    for i in 0:6 {
        a64_pair(cb, 0xA9000000, 19 + i * 2, 20 + i * 2, 0, i * 16)
    }
    a64_add_imm(cb, 9, R_SP, 0)
    a64_str(cb, 9, 0, 96)
    for i in 0:4 {
        a64_pair(cb, 0x6D000000, 8 + i * 2, 9 + i * 2, 0, 104 + i * 16)
    }
    for i in 0:6 {
        a64_pair(cb, 0xA9400000, 19 + i * 2, 20 + i * 2, 1, i * 16)
    }
    a64_ldr(cb, 9, 1, 96)
    a64_add_imm(cb, R_SP, 9, 0)
    for i in 0:4 {
        a64_pair(cb, 0x6D400000, 8 + i * 2, 9 + i * 2, 1, 104 + i * 16)
    }
    e32(cb, 0xD65F03C0)
    // __xu_task_entry: first frame of a task. x19 = task, x20 = function,
    // x21 = 16 argument words, x22 = exit function (never returns).
    syms.define_label("__xu_task_entry", cb.len())
    a64_sub_sp(cb, 64)
    for i in 0:8 {
        a64_ldr(cb, 9, 21, 64 + i * 8)
        a64_str(cb, 9, R_SP, i * 8)
    }
    for i in 0:8 {
        a64_ldr(cb, i, 21, i * 8)
    }
    e32(cb, 0xD63F0000 | (20 << 5))
    a64_add_imm(cb, R_SP, R_SP, 64)
    a64_mov(cb, 0, 19)
    e32(cb, 0xD63F0000 | (22 << 5))
    e32(cb, 0xD4200000)
}

// Process entry, raw system call and runtime-state accessor shared by all
// functions. tgt_os uses target.OS_* codes.
pub fn emit_arm64_runtime_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, tgt_os int, main_label string, link_ui bool, emit_object bool) {
    linux := tgt_os == target.OS_LINUX
    // __xu_start: keep argc/argv/envp, map the state block into x28, run
    // main, exit with its result.
    syms.define_label("__xu_start", cb.len())
    if linux && emit_object {
        // Both Linux C entries receive argc, argv and the current envp.
        syms.define_label("xu_app_start", cb.len())
        e32(cb, 0x2A0003E0) // mov w0, w0 (C int argc)
    }
    if linux && !emit_object {
        a64_ldr(cb, 19, R_SP, 0)
        a64_add_imm(cb, 20, R_SP, 8)
        // envp = argv + 8 * (argc + 1)
        e32(cb, 0x8B000000 | (19 << 16) | (3 << 10) | (20 << 5) | 21)
        a64_add_imm(cb, 21, 21, 8)
    } else {
        a64_mov(cb, 19, 0)
        a64_mov(cb, 20, 1)
        a64_mov(cb, 21, 2)
    }
    a64_mov_imm(cb, 0, 0)
    a64_mov_imm(cb, 1, 65536)
    a64_mov_imm(cb, 2, 3)
    a64_mov_imm(cb, 4, -1)
    a64_mov_imm(cb, 5, 0)
    if linux {
        a64_mov_imm(cb, 3, 34)
        a64_mov_imm(cb, 8, 222)
        e32(cb, 0xD4000001)
    } else {
        a64_mov_imm(cb, 3, 4098)
        a64_mov_imm(cb, 16, 197)
        e32(cb, 0xD4001001)
    }
    a64_mov(cb, R_STATE, 0)
    a64_str(cb, 19, R_STATE, 0)
    a64_str(cb, 20, R_STATE, 8)
    a64_str(cb, 21, R_STATE, 32)
    if linux && !emit_object && (syms.lookup_offset(AES_SUPPORTED) >= 0 || syms.lookup_offset(SHA256_SUPPORTED) >= 0) {
        a64_linux_save_hwcap(cb, syms, relocs)
    }
    if link_ui {
        a64_mov_imm(cb, 0, 1)
        a64_str(cb, 0, R_STATE, uiabi.STATE_OFFSET)
    }
    a64_branch_reloc(cb, relocs, 0x94000000, main_label, mc.RELOC_ARM64_CALL26)
    if linux {
        a64_mov_imm(cb, 8, 94)
        e32(cb, 0xD4000001)
    } else {
        a64_mov_imm(cb, 16, 1)
        e32(cb, 0xD4001001)
    }
    // __xu_syscall(nr, a, b, c, d, e, f) -> result or -errno.
    // nr -1 is the runtime's task switch: (from task, to task).
    // nr -2 returns the caller's frame pointer, nr -3 the address of
    // __xu_start (backtraces). nr -4 copies c > 0 bytes from b to a,
    // forward, 16 at a time; nr -5 zeroes b > 0 bytes at a.
    if link_ui {
        $prefix := "_"
        if linux { prefix = "" }
        emit_arm64_ui_dispatch(cb, syms, relocs, prefix)
    } else {
        syms.define_label("__xu_syscall", cb.len())
    }
    if !linux {
        emit_macos_arm64_clock(cb, syms, relocs, emit_object)
    }
    emit_arm64_pseudo_calls(cb, syms, relocs)
    if linux {
        a64_mov(cb, 8, 0)
    } else {
        a64_mov(cb, 16, 0)
    }
    for i in 0:6 {
        a64_mov(cb, i, i + 1)
    }
    if linux {
        e32(cb, 0xD4000001)
    } else {
        e32(cb, 0xD4001001)
        // fork and pipe return a second word in x1 (runtime G_SYS_R1).
        a64_str(cb, 1, R_STATE, 40)
        // b.cc +8 ; neg x0, x0  (carry set means x0 holds errno)
        e32(cb, 0x54000043)
        e32(cb, 0xCB0003E0)
    }
    e32(cb, 0xD65F03C0)
    emit_arm64_globals(cb, syms)
}

fn a64_linux_save_hwcap(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    // The initial environment vector ends with NULL, followed by the
    // (type, value) pairs of the auxiliary vector.
    a64_mov(cb, 9, 21)
    syms.define_label("__xu_hwcap_env", cb.len())
    e32(cb, 0xF840852A) // ldr x10, [x9], #8
    a64_branch_reloc(cb, relocs, 0xB500000A, "__xu_hwcap_env", mc.RELOC_ARM64_COND_BR19)
    syms.define_label("__xu_hwcap_aux", cb.len())
    a64_ldr(cb, 10, 9, 0)
    a64_branch_reloc(cb, relocs, 0xB400000A, "__xu_hwcap_done", mc.RELOC_ARM64_COND_BR19)
    e32(cb, 0xF100001F | (16 << 10) | (10 << 5)) // cmp x10, #16 (AT_HWCAP)
    a64_ldr(cb, 11, 9, 8)
    a64_add_imm(cb, 9, 9, 16)
    a64_branch_reloc(cb, relocs, 0x54000001, "__xu_hwcap_aux", mc.RELOC_ARM64_COND_BR19)
    a64_str(cb, 11, R_STATE, A64_HWCAP_OFFSET)
    syms.define_label("__xu_hwcap_done", cb.len())
}

// Dispatch shared pseudo-calls before falling through to the host bridge.
fn emit_arm64_pseudo_calls(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    emit_arm64_ffi_calls(cb, syms, relocs)
    // cmn x0, #5 ; b.ne past the zeroing
    e32(cb, 0xB100141F)
    e32(cb, 0x54000000 | (11 << 5) | 1)
    // subs x2, x2, #16 ; b.lt tail ; stp xzr, xzr, [x1], #16 ; b loop
    e32(cb, 0xF1004042)
    e32(cb, 0x54000000 | (3 << 5) | 11)
    e32(cb, 0xA8817C3F)
    e32(cb, 0x14000000 | (-3 & 0x3FFFFFF))
    // tail: adds x2, x2, #16 ; cbz x2, done ; strb wzr, [x1], #1 ;
    // subs x2, x2, #1 ; b.ne byte ; done: ret
    e32(cb, 0xB1004042)
    e32(cb, 0xB4000000 | (4 << 5) | 2)
    e32(cb, 0x3800143F)
    e32(cb, 0xF1000442)
    e32(cb, 0x54000000 | ((-2 & 0x7FFFF) << 5) | 1)
    e32(cb, 0xD65F03C0)
    // cmn x0, #4 ; b.ne past the copy
    e32(cb, 0xB100101F)
    e32(cb, 0x54000000 | (13 << 5) | 1)
    // subs x3, x3, #16 ; b.lt tail ; ldp x4, x5, [x2], #16 ;
    // stp x4, x5, [x1], #16 ; b loop
    e32(cb, 0xF1004063)
    e32(cb, 0x54000000 | (4 << 5) | 11)
    e32(cb, 0xA8C11444)
    e32(cb, 0xA8811424)
    e32(cb, 0x14000000 | (-4 & 0x3FFFFFF))
    // tail: adds x3, x3, #16 ; cbz x3, done ; ldrb w4, [x2], #1 ;
    // strb w4, [x1], #1 ; subs x3, x3, #1 ; b.ne byte ; done: ret
    e32(cb, 0xB1004063)
    e32(cb, 0xB4000000 | (5 << 5) | 3)
    e32(cb, 0x38401444)
    e32(cb, 0x38001424)
    e32(cb, 0xF1000463)
    e32(cb, 0x54000000 | ((-3 & 0x7FFFF) << 5) | 1)
    e32(cb, 0xD65F03C0)
    // cmn x0, #2 ; b.ne +12 ; mov x0, x29 ; ret
    e32(cb, 0xB100081F)
    e32(cb, 0x54000061)
    a64_mov(cb, 0, R_FP)
    e32(cb, 0xD65F03C0)
    // cmn x0, #3 ; b.ne +12 ; adr x0, __xu_start ; ret
    e32(cb, 0xB1000C1F)
    e32(cb, 0x54000061)
    disp := syms.lookup_offset("__xu_start") - cb.len()
    e32(cb, 0x10000000 | ((disp & 3) << 29) | (((disp >> 2) & 0x7ffff) << 5))
    e32(cb, 0xD65F03C0)
    e32(cb, 0xB100041F)
    a64_branch_reloc(cb, relocs, 0x54000001, "__xu_syscall_os", mc.RELOC_ARM64_COND_BR19)
    a64_mov(cb, 0, 1)
    a64_mov(cb, 1, 2)
    emit_arm64_task_stubs(cb, syms, relocs)
    syms.define_label("__xu_syscall_os", cb.len())
}

fn emit_arm64_globals(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    syms.define_label("__xu_globals", cb.len())
    a64_mov(cb, 0, R_STATE)
    e32(cb, 0xD65F03C0)
}

// C FFI pseudo calls (runtime/core ffi.xu).
//   -8: call x1 with the call block at x2: copy the stack words, load
//       x0-x7, d0-d7 and x8, call, store x0, x1 and d0-d3 back.
//   -9: address of the loader slots (dlopen, dlsym, dlerror), which the
//       dynamic executable writer has the system loader bind.
// The loader slots and the published state word are FFI_GOT_LABEL (4
// words: dlopen, dlsym, dlerror, state). ELF images keep them in the code
// segment, which is writable; the Mach-O writer places them in __DATA and
// the driver defines the label there.
pub const FFI_GOT_LABEL = "__xu_ffi_got"
pub const FFI_STATE_LABEL = "__xu_ffi_state"

fn emit_arm64_ffi_calls(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    e32(cb, 0xB100201F) // cmn x0, #8
    skip6 := cb.len()
    e32(cb, 0x54000001) // b.ne (patched)
    e32(cb, 0xA9BE7BFD) // stp x29, x30, [sp, #-32]!
    e32(cb, 0x910003FD) // mov x29, sp
    a64_pair(cb, 0xA9000000, 19, 20, R_SP, 16)
    // Publish the runtime state register for C callbacks: C code between
    // here and a callback may use x28 for its own values.
    a64_fn_addr(cb, relocs, 9, FFI_STATE_LABEL)
    a64_str(cb, 28, 9, 0)
    a64_mov(cb, 19, 2)
    a64_mov(cb, 20, 1)
    a64_ldr(cb, 9, 19, 128)
    e32(cb, 0xCB2963FF) // sub sp, sp, x9
    a64_ldr(cb, 10, 19, 136)
    e32(cb, 0x910003EB) // mov x11, sp
    e32(cb, 0xB40000A9) // cbz x9, +5
    e32(cb, 0xF840854C) // ldr x12, [x10], #8
    e32(cb, 0xF800856C) // str x12, [x11], #8
    e32(cb, 0xD1002129) // sub x9, x9, #8
    e32(cb, 0x17FFFFFC) // b -4
    for i in 0:4 {
        a64_pair(cb, 0x6D400000, i * 2, i * 2 + 1, 19, 64 + i * 16)
    }
    a64_ldr(cb, 8, 19, 144)
    for i in 0:4 {
        a64_pair(cb, 0xA9400000, i * 2, i * 2 + 1, 19, i * 16)
    }
    e32(cb, 0xD63F0000 | (20 << 5)) // blr x20
    a64_pair(cb, 0xA9000000, 0, 1, 19, 152)
    a64_pair(cb, 0x6D000000, 0, 1, 19, 168)
    a64_pair(cb, 0x6D000000, 2, 3, 19, 184)
    e32(cb, 0x910003BF) // mov sp, x29
    a64_pair(cb, 0xA9400000, 19, 20, R_SP, 16)
    e32(cb, 0xA8C27BFD) // ldp x29, x30, [sp], #32
    e32(cb, 0xD65F03C0)
    cb.patch_u32_le(skip6, 0x54000001 | ((((cb.len() - skip6) / 4) & 0x7FFFF) << 5))
    e32(cb, 0xB100241F) // cmn x0, #9
    skip7 := cb.len()
    e32(cb, 0x54000001)
    a64_fn_addr(cb, relocs, 0, FFI_GOT_LABEL)
    e32(cb, 0xD65F03C0)
    cb.patch_u32_le(skip7, 0x54000001 | ((((cb.len() - skip7) / 4) & 0x7FFFF) << 5))
}

// ELF: the four loader slots inside the (writable) code segment.
pub fn emit_arm64_ffi_slots(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    while cb.len() % 8 != 0 { e32(cb, 0xD503201F) }
    syms.define_label(FFI_GOT_LABEL, cb.len())
    syms.define_label(FFI_STATE_LABEL, cb.len() + 24)
    for i in 0:8 { e32(cb, 0) }
}

// C-ABI entry points for Xu functions passed as C callbacks: save the C
// callee-saved registers, spill x0-x7 / d0-d7 and the caller's stack
// argument address into a call block on the stack, call the adapter with
// the block, load x0, x1, d0-d3 from it and return (layout: core ffi.xu).
pub fn emit_arm64_ffi_thunks(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, thunks &[]string, adapters &[]string) {
    for t in 0:thunks.len {
        while cb.len() % 16 != 0 { e32(cb, 0xD503201F) }
        syms.define_label(thunks[t] + "", cb.len())
        e32(cb, 0xA9800000 | ((-50 & 0x7F) << 15) | (30 << 10) | (31 << 5) | 29) // stp x29, x30, [sp, #-400]!
        e32(cb, 0x910003FD) // mov x29, sp
        for i in 0:5 { a64_pair(cb, 0xA9000000, 19 + i * 2, 20 + i * 2, R_SP, 16 + i * 16) }
        for i in 0:4 { a64_pair(cb, 0x6D000000, 8 + i * 2, 9 + i * 2, R_SP, 96 + i * 16) }
        for i in 0:4 { a64_pair(cb, 0xA9000000, i * 2, i * 2 + 1, R_SP, 160 + i * 16) }
        for i in 0:4 { a64_pair(cb, 0x6D000000, i * 2, i * 2 + 1, R_SP, 224 + i * 16) }
        // Restore the runtime state register published by the C call.
        a64_fn_addr(cb, relocs, 28, FFI_STATE_LABEL)
        a64_ldr(cb, 28, 28, 0)
        e32(cb, 0x91000000 | (400 << 10) | (31 << 5) | 9) // add x9, sp, #400
        a64_str(cb, 9, R_SP, 160 + 136)
        e32(cb, 0x91000000 | (160 << 10) | (31 << 5) | 0) // add x0, sp, #160
        a64_branch_reloc(cb, relocs, 0x94000000, adapters[t] + "", mc.RELOC_ARM64_CALL26)
        a64_pair(cb, 0xA9400000, 0, 1, R_SP, 160 + 152)
        a64_pair(cb, 0x6D400000, 0, 1, R_SP, 160 + 168)
        a64_pair(cb, 0x6D400000, 2, 3, R_SP, 160 + 184)
        for i in 0:5 { a64_pair(cb, 0xA9400000, 19 + i * 2, 20 + i * 2, R_SP, 16 + i * 16) }
        for i in 0:4 { a64_pair(cb, 0x6D400000, 8 + i * 2, 9 + i * 2, R_SP, 96 + i * 16) }
        e32(cb, 0xA8C00000 | ((50 & 0x7F) << 15) | (30 << 10) | (31 << 5) | 29) // ldp x29, x30, [sp], #400
        e32(cb, 0xD65F03C0)
    }
}

// adr rd, target (both code-buffer offsets; target within 1 MiB).
fn a64_patch_adr_at(cb $&mc.CodeBuffer, at int, rd int, target int) {
    disp := target - at
    cb.patch_u32_le(at, 0x10000000 | ((disp & 3) << 29) | (((disp >> 2) & 0x7FFFF) << 5) | rd)
}
