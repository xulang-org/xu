@xu/codegen
// Instruction selection and lowering from MIR to machine code.
//
// Layer 4C module: lowers architecture-independent MIR functions into
// target-specific machine instructions using Target encoders and CodeBuffer.

#xu/mir
#xu/target
#xu/mc

pub fn isel_fn_arm64(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    t := target.target_new(target.OS_MACOS, target.ARCH_ARM64)
    $fr := frame_new(&t)

    // 1. Allocate stack slots for locals and temps
    $local_offsets := []int{}
    for i in 0:f.locals.len {
        s := fr.alloc_local(8)
        local_offsets.push(fr.local_slots[s].offset)
    }

    $temp_offsets := []int{}
    for i in 0:f.temps.len {
        s := fr.alloc_local(8)
        temp_offsets.push(fr.local_slots[s].offset)
    }

    fr.finalize_layout()
    stack_size := fr.total_stack_size

    // 2. Define function entry label
    syms.define_label(f.label, cb.len())

    // 3. Emit function prologue
    // stp fp, lr, [sp, -16]!
    target.arm64_stp_pre(cb, target.REG_ARM64_FP, target.REG_ARM64_LR, target.REG_ARM64_SP, -16)
    // mov fp, sp
    target.arm64_mov_reg(cb, target.REG_ARM64_FP, target.REG_ARM64_SP)
    // sub sp, sp, #stack_size (if stack_size > 0)
    if stack_size > 0 {
        target.arm64_sub_imm(cb, target.REG_ARM64_SP, target.REG_ARM64_SP, stack_size)
    }

    // Store incoming parameter registers X0..X(nparams-1) to local stack slots
    for pi in 0:f.nparams {
        if pi < 8 && pi < local_offsets.len {
            loc_off := local_offsets[pi]
            target.arm64_str_imm(cb, pi, target.REG_ARM64_SP, loc_off)
        }
    }

    // 4. Emit blocks
    for bi in 0:f.blocks.len {
        blk_label := f.label + "_bb" + str(bi)
        syms.define_label(blk_label, cb.len())

        blk := ~f.blocks[bi]

        // Emit instructions in block
        $curr_ii := blk.head
        while curr_ii >= 0 && curr_ii < f.instrs.len {
            ins := ~f.instrs[curr_ii]

            if ins.kind == mir.MI_STORE_LOCAL {
                // a = local slot, b = src value
                if ins.b <= -2 {
                    cidx := 0 - ins.b - 2
                    $val := 0
                    if cidx >= 0 && cidx < f.consts.len {
                        val = f.consts[cidx]
                    }
                    target.arm64_mov_imm64(cb, target.REG_ARM64_X0, val)
                } else if ins.b >= 0 && ins.b < temp_offsets.len {
                    slot_off := temp_offsets[ins.b]
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }

                if ins.a >= 0 && ins.a < local_offsets.len {
                    loc_off := local_offsets[ins.a]
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, loc_off)
                }
            } else if ins.kind == mir.MI_LOAD_LOCAL {
                // a = dest temp, b = local slot
                if ins.b >= 0 && ins.b < local_offsets.len {
                    loc_off := local_offsets[ins.b]
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, loc_off)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_COPY {
                // Load src into X0
                if ins.b <= -2 {
                    const_idx := 0 - ins.b - 2
                    $val := 0
                    if const_idx >= 0 && const_idx < f.consts.len {
                        val = f.consts[const_idx]
                    }
                    target.arm64_mov_imm64(cb, target.REG_ARM64_X0, val)
                } else if ins.b >= 0 && ins.b < temp_offsets.len {
                    slot_off := temp_offsets[ins.b]
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_BIN {
                // a = b op c
                // Load LHS into X0
                if ins.c <= -2 {
                    cidx := 0 - ins.c - 2
                    target.arm64_mov_imm64(cb, target.REG_ARM64_X0, f.consts[cidx])
                } else if ins.c >= 0 && ins.c < temp_offsets.len {
                    slot_off := temp_offsets[ins.c]
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }

                // Load RHS into X1
                if ins.d <= -2 {
                    cidx := 0 - ins.d - 2
                    target.arm64_mov_imm64(cb, target.REG_ARM64_X1, f.consts[cidx])
                } else if ins.d >= 0 && ins.d < temp_offsets.len {
                    slot_off := temp_offsets[ins.d]
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X1, target.REG_ARM64_SP, slot_off)
                }

                // Opcode: 1=Add, 2=Sub, 3=Mul, 4=Div, 5=Eq, 6=Ne, 7=Lt, 8=Le, 9=Gt, 10=Ge, 11=And, 12=Or
                if ins.b == mir.BIN_ADD {
                    target.arm64_add_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == mir.BIN_SUB {
                    target.arm64_sub_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == mir.BIN_MUL {
                    target.arm64_mul(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == mir.BIN_DIV {
                    target.arm64_sdiv(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == mir.BIN_EQ {
                    target.arm64_cmp_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X1)
                    target.arm64_cset(cb, target.REG_ARM64_X0, target.ARM64_COND_EQ)
                } else if ins.b == mir.BIN_NE {
                    target.arm64_cmp_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X1)
                    target.arm64_cset(cb, target.REG_ARM64_X0, target.ARM64_COND_NE)
                } else if ins.b == mir.BIN_LT {
                    target.arm64_cmp_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X1)
                    target.arm64_cset(cb, target.REG_ARM64_X0, target.ARM64_COND_LT)
                } else if ins.b == mir.BIN_LE {
                    target.arm64_cmp_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X1)
                    target.arm64_cset(cb, target.REG_ARM64_X0, target.ARM64_COND_LE)
                } else if ins.b == mir.BIN_GT {
                    target.arm64_cmp_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X1)
                    target.arm64_cset(cb, target.REG_ARM64_X0, target.ARM64_COND_GT)
                } else if ins.b == mir.BIN_GE {
                    target.arm64_cmp_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X1)
                    target.arm64_cset(cb, target.REG_ARM64_X0, target.ARM64_COND_GE)
                } else if ins.b == mir.BIN_AND {
                    target.arm64_and_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == mir.BIN_OR {
                    target.arm64_orr_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                }

                // Store X0 to dest temp
                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_CALL {
                // Pass arguments in X0..X7
                $arg_idx := ins.c
                $reg_idx := 0
                while arg_idx >= 0 && arg_idx < f.margs.len && reg_idx < 8 {
                    av := f.margs[arg_idx].v
                    target_reg := reg_idx
                    if av <= -2 {
                        cidx := 0 - av - 2
                        target.arm64_mov_imm64(cb, target_reg, f.consts[cidx])
                    } else if av >= 0 && av < temp_offsets.len {
                        slot_off := temp_offsets[av]
                        target.arm64_ldr_imm(cb, target_reg, target.REG_ARM64_SP, slot_off)
                    }
                    arg_idx = f.margs[arg_idx].next
                    reg_idx += 1
                }

                reloc_off := cb.len()
                target.arm64_bl(cb, 0)
                relocs.push(mc.reloc_new(reloc_off, ins.sval, mc.RELOC_ARM64_CALL26, 0))

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            }

            if curr_ii == blk.tail {
                <-
            }
            curr_ii = ins.next
        }

        // 5. Emit block terminator
        if blk.tkind == mir.TKIND_RETURN {
            // Load return value into X0
            if blk.ta <= -2 {
                cidx := 0 - blk.ta - 2
                target.arm64_mov_imm64(cb, target.REG_ARM64_X0, f.consts[cidx])
            } else if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta]
                target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
            }

            // Function Epilogue
            if stack_size > 0 {
                target.arm64_add_imm(cb, target.REG_ARM64_SP, target.REG_ARM64_SP, stack_size)
            }
            target.arm64_ldp_post(cb, target.REG_ARM64_FP, target.REG_ARM64_LR, target.REG_ARM64_SP, 16)
            if f.name == "main" {
                // Exit process with X0
                target.arm64_mov_imm64(cb, target.REG_ARM64_X16, 0x2000001)
                target.arm64_svc(cb, 0x80)
            } else {
                target.arm64_ret(cb)
            }
        } else if blk.tkind == mir.TKIND_JUMP {
            target_lbl := f.label + "_bb" + str(blk.ta)
            reloc_off := cb.len()
            target.arm64_b(cb, 0)
            relocs.push(mc.reloc_new(reloc_off, target_lbl, mc.RELOC_ARM64_CALL26, 0))
        } else if blk.tkind == mir.TKIND_BRANCH {
            if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta]
                target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                target.arm64_cmp_imm(cb, target.REG_ARM64_X0, 0)
            }
            then_lbl := f.label + "_bb" + str(blk.tb)
            reloc_then := cb.len()
            target.arm64_b_cond(cb, target.ARM64_COND_NE, 0)
            relocs.push(mc.reloc_new(reloc_then, then_lbl, mc.RELOC_ARM64_COND_BR19, 0))

            else_lbl := f.label + "_bb" + str(blk.tc)
            reloc_else := cb.len()
            target.arm64_b(cb, 0)
            relocs.push(mc.reloc_new(reloc_else, else_lbl, mc.RELOC_ARM64_CALL26, 0))
        }
    }
}

pub fn isel_fn_x64(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    t := target.target_new(target.OS_LINUX, target.ARCH_X64)
    $fr := frame_new(&t)

    $local_offsets := []int{}
    for i in 0:f.locals.len {
        s := fr.alloc_local(8)
        local_offsets.push(fr.local_slots[s].offset)
    }

    $temp_offsets := []int{}
    for i in 0:f.temps.len {
        s := fr.alloc_local(8)
        temp_offsets.push(fr.local_slots[s].offset)
    }

    fr.finalize_layout()
    stack_size := fr.total_stack_size

    syms.define_label(f.label, cb.len())

    // Prologue: push rbp; mov rbp, rsp; sub rsp, stack_size
    target.x64_push(cb, target.REG_X64_RBP)
    target.x64_mov_reg(cb, target.REG_X64_RBP, target.REG_X64_RSP)
    if stack_size > 0 {
        target.x64_sub_imm32(cb, target.REG_X64_RSP, stack_size)
    }

    // Parameters in RDI, RSI, RDX, RCX, R8, R9
    $arg_regs := []int{}
    arg_regs.push(target.REG_X64_RDI)
    arg_regs.push(target.REG_X64_RSI)
    arg_regs.push(target.REG_X64_RDX)
    arg_regs.push(target.REG_X64_RCX)
    arg_regs.push(target.REG_X64_R8)
    arg_regs.push(target.REG_X64_R9)
    for pi in 0:f.nparams {
        if pi < arg_regs.len && pi < local_offsets.len {
            loc_off := local_offsets[pi]
            target.x64_str_rsp(cb, arg_regs[pi], loc_off)
        }
    }

    for bi in 0:f.blocks.len {
        blk_label := f.label + "_bb" + str(bi)
        syms.define_label(blk_label, cb.len())

        blk := ~f.blocks[bi]

        $curr_ii := blk.head
        while curr_ii >= 0 && curr_ii < f.instrs.len {
            ins := ~f.instrs[curr_ii]

            if ins.kind == mir.MI_STORE_LOCAL {
                if ins.b <= -2 {
                    cidx := 0 - ins.b - 2
                    $val := 0
                    if cidx >= 0 && cidx < f.consts.len {
                        val = f.consts[cidx]
                    }
                    target.x64_mov_imm64(cb, target.REG_X64_RAX, val)
                } else if ins.b >= 0 && ins.b < temp_offsets.len {
                    slot_off := temp_offsets[ins.b]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                }

                if ins.a >= 0 && ins.a < local_offsets.len {
                    loc_off := local_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, loc_off)
                }
            } else if ins.kind == mir.MI_LOAD_LOCAL {
                if ins.b >= 0 && ins.b < local_offsets.len {
                    loc_off := local_offsets[ins.b]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, loc_off)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            } else if ins.kind == mir.MI_COPY {
                if ins.b <= -2 {
                    const_idx := 0 - ins.b - 2
                    $val := 0
                    if const_idx >= 0 && const_idx < f.consts.len {
                        val = f.consts[const_idx]
                    }
                    target.x64_mov_imm64(cb, target.REG_X64_RAX, val)
                } else if ins.b >= 0 && ins.b < temp_offsets.len {
                    slot_off := temp_offsets[ins.b]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            } else if ins.kind == mir.MI_BIN {
                // LHS into RAX
                if ins.c <= -2 {
                    cidx := 0 - ins.c - 2
                    target.x64_mov_imm64(cb, target.REG_X64_RAX, f.consts[cidx])
                } else if ins.c >= 0 && ins.c < temp_offsets.len {
                    slot_off := temp_offsets[ins.c]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                }

                // RHS into RCX
                if ins.d <= -2 {
                    cidx := 0 - ins.d - 2
                    target.x64_mov_imm64(cb, target.REG_X64_RCX, f.consts[cidx])
                } else if ins.d >= 0 && ins.d < temp_offsets.len {
                    slot_off := temp_offsets[ins.d]
                    target.x64_ldr_rsp(cb, target.REG_X64_RCX, slot_off)
                }

                if ins.b == mir.BIN_ADD {
                    target.x64_add_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                } else if ins.b == mir.BIN_SUB {
                    target.x64_sub_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                } else if ins.b == mir.BIN_MUL {
                    target.x64_imul_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                } else if ins.b == mir.BIN_EQ {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_E)
                } else if ins.b == mir.BIN_NE {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_NE)
                } else if ins.b == mir.BIN_LT {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_L)
                } else if ins.b == mir.BIN_LE {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_LE)
                } else if ins.b == mir.BIN_GT {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_G)
                } else if ins.b == mir.BIN_GE {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_GE)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            } else if ins.kind == mir.MI_CALL {
                $arg_idx := ins.c
                $reg_idx := 0
                while arg_idx >= 0 && arg_idx < f.margs.len && reg_idx < arg_regs.len {
                    av := f.margs[arg_idx].v
                    target_reg := arg_regs[reg_idx]
                    if av <= -2 {
                        cidx := 0 - av - 2
                        target.x64_mov_imm64(cb, target_reg, f.consts[cidx])
                    } else if av >= 0 && av < temp_offsets.len {
                        slot_off := temp_offsets[av]
                        target.x64_ldr_rsp(cb, target_reg, slot_off)
                    }
                    arg_idx = f.margs[arg_idx].next
                    reg_idx += 1
                }

                reloc_off := cb.len() + 1
                target.x64_call(cb, 0)
                relocs.push(mc.reloc_new(reloc_off, ins.sval, mc.RELOC_X64_PC32, 0))

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            }

            if curr_ii == blk.tail {
                <-
            }
            curr_ii = ins.next
        }

        if blk.tkind == mir.TKIND_RETURN {
            if blk.ta <= -2 {
                cidx := 0 - blk.ta - 2
                target.x64_mov_imm64(cb, target.REG_X64_RAX, f.consts[cidx])
            } else if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta]
                target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
            }

            if stack_size > 0 {
                target.x64_add_imm32(cb, target.REG_X64_RSP, stack_size)
            }
            target.x64_pop(cb, target.REG_X64_RBP)

            if f.name == "main" {
                // Linux exit(RAX): mov rdi, rax; mov rax, 60; syscall
                target.x64_mov_reg(cb, target.REG_X64_RDI, target.REG_X64_RAX)
                target.x64_mov_imm64(cb, target.REG_X64_RAX, 60)
                target.x64_syscall(cb)
            } else {
                target.x64_ret(cb)
            }
        } else if blk.tkind == mir.TKIND_JUMP {
            target_lbl := f.label + "_bb" + str(blk.ta)
            reloc_off := cb.len() + 1
            target.x64_jmp(cb, 0)
            relocs.push(mc.reloc_new(reloc_off, target_lbl, mc.RELOC_X64_PC32, 0))
        } else if blk.tkind == mir.TKIND_BRANCH {
            if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta]
                target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                target.x64_cmp_imm32(cb, target.REG_X64_RAX, 0)
            }
            then_lbl := f.label + "_bb" + str(blk.tb)
            reloc_then := cb.len() + 2
            target.x64_jcc(cb, target.X64_COND_NE, 0)
            relocs.push(mc.reloc_new(reloc_then, then_lbl, mc.RELOC_X64_PC32, 0))

            else_lbl := f.label + "_bb" + str(blk.tc)
            reloc_else := cb.len() + 1
            target.x64_jmp(cb, 0)
            relocs.push(mc.reloc_new(reloc_else, else_lbl, mc.RELOC_X64_PC32, 0))
        }
    }
}
