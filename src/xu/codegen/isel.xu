                    } else if ins.c < temp_offsets.len {
                        slot_off := temp_offsets[ins.c]
                        target.arm64_ldr_imm(cb, r_then, target.REG_ARM64_SP, slot_off)
                    }
                }

                $r_else := target.REG_ARM64_X17
                if ins.d <= -2 {
                    cidx := 0 - ins.d - 2
                    target.arm64_mov_imm64(cb, r_else, f.consts[cidx])
                } else if ins.d >= 0 {
                    if enable_temp_opt && ins.d < temp_reg.len && temp_reg[ins.d] >= 0 {
                        r_else = temp_reg[ins.d]
                    } else if ins.d < temp_offsets.len {
                        slot_off := temp_offsets[ins.d]
                        target.arm64_ldr_imm(cb, r_else, target.REG_ARM64_SP, slot_off)
                    }
                }

                $sel_cond := target.ARM64_COND_NE
                if last_cmp_dest == ins.b && last_cmp_cond >= 0 {
                    sel_cond = last_cmp_cond
                } else {
                    $r_cond := target.REG_ARM64_X10
                    if ins.b >= 0 {
                        if enable_temp_opt && ins.b < temp_reg.len && temp_reg[ins.b] >= 0 {
                            r_cond = temp_reg[ins.b]
                        } else if ins.b < temp_offsets.len {
                            slot_off := temp_offsets[ins.b]
                            target.arm64_ldr_imm(cb, r_cond, target.REG_ARM64_SP, slot_off)
                        }
                    }
                    target.arm64_cmp_imm(cb, r_cond, 0)
                    sel_cond = target.ARM64_COND_NE
                }

                $r_dest := target.REG_ARM64_X0
                if enable_temp_opt {
                    pool_idx := scratch_idx % 7
                    scratch_idx += 1
                    old_owner := scratch_owner[pool_idx]
                    if old_owner >= 0 && old_owner < temp_reg.len {
                        if old_owner < temp_offsets.len {
                            slot_off_ev := temp_offsets[old_owner]
                            target.arm64_str_imm(cb, scratch_pool[pool_idx], target.REG_ARM64_SP, slot_off_ev)
                        }
                        temp_reg[old_owner] = -1
                    }
                    r_dest = scratch_pool[pool_idx]
                    if ins.a >= 0 && ins.a < temp_reg.len {
                        scratch_owner[pool_idx] = ins.a
                        temp_reg[ins.a] = r_dest
                    }
                }

                target.arm64_csel(cb, r_dest, r_then, r_else, sel_cond)

                $need_spill := true
                if enable_temp_opt && ins.a >= 0 && ins.a < is_cross_bb.len && !is_cross_bb[ins.a] && ins.a < temp_reg.len && temp_reg[ins.a] >= 0 {
                    need_spill = false
                }
                if need_spill && ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, r_dest, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_ADDR {
                // a = addr(b_local_slot)
                loc_slot := ins.b
                if loc_slot >= 0 && loc_slot < local_offsets.len {
                    loc_off := local_offsets[loc_slot]
                    $r_dest := target.REG_ARM64_X0
                    if enable_temp_opt {
                        pool_idx := scratch_idx % 7
                        scratch_idx += 1
                        old_owner := scratch_owner[pool_idx]
                        if old_owner >= 0 && old_owner < temp_reg.len {
                            temp_reg[old_owner] = -1
                        }
                        r_dest = scratch_pool[pool_idx]
                        if ins.a >= 0 && ins.a < temp_reg.len {
                            scratch_owner[pool_idx] = ins.a
                            temp_reg[ins.a] = r_dest
                        }
                    }
                    target.arm64_add_imm(cb, r_dest, target.REG_ARM64_SP, loc_off)
                    if ins.a >= 0 && ins.a < temp_offsets.len {
                        slot_off := temp_offsets[ins.a]
                        target.arm64_str_imm(cb, r_dest, target.REG_ARM64_SP, slot_off)
                    }
                }
            } else if ins.kind == mir.MI_LOAD_INDEX {
                // a = load_index(b_base, c_idx)
                $r_base := target.REG_ARM64_X1
                if ins.b >= 0 {
                    if ins.b < temp_reg.len && temp_reg[ins.b] >= 0 {
                        r_base = temp_reg[ins.b]
                    } else if ins.b < temp_local_src.len && temp_local_src[ins.b] >= 0 && local_regs[temp_local_src[ins.b]] >= 0 {
                        r_base = local_regs[temp_local_src[ins.b]]
                    } else if ins.b < temp_offsets.len {
                        slot_off := temp_offsets[ins.b]
                        target.arm64_ldr_imm(cb, r_base, target.REG_ARM64_SP, slot_off)
                    }
                }
                $r_idx := target.REG_ARM64_X2
                if ins.c <= -2 {
                    cidx := 0 - ins.c - 2
                    target.arm64_mov_imm64(cb, r_idx, f.consts[cidx])
                } else if ins.c >= 0 {
                    if ins.c < temp_reg.len && temp_reg[ins.c] >= 0 {
                        r_idx = temp_reg[ins.c]
                    } else if ins.c < temp_local_src.len && temp_local_src[ins.c] >= 0 && local_regs[temp_local_src[ins.c]] >= 0 {
                        r_idx = local_regs[temp_local_src[ins.c]]
                    } else if ins.c < temp_offsets.len {
                        slot_off := temp_offsets[ins.c]
                        target.arm64_ldr_imm(cb, r_idx, target.REG_ARM64_SP, slot_off)
                    }
                }
                $r_dest := target.REG_ARM64_X0
                if enable_temp_opt {
                    pool_idx := scratch_idx % 7
                    scratch_idx += 1
                    old_owner := scratch_owner[pool_idx]
                    if old_owner >= 0 && old_owner < temp_reg.len {
                        if old_owner < temp_offsets.len {
                            slot_off_ev := temp_offsets[old_owner]
                            target.arm64_str_imm(cb, scratch_pool[pool_idx], target.REG_ARM64_SP, slot_off_ev)
                        }
                        temp_reg[old_owner] = -1
                    }
                    r_dest = scratch_pool[pool_idx]
                    if ins.a >= 0 && ins.a < temp_reg.len {
                        scratch_owner[pool_idx] = ins.a
                        temp_reg[ins.a] = r_dest
                    }
                }
                target.arm64_ldr_reg_lsl3(cb, r_dest, r_base, r_idx)
                $need_spill := true
                if enable_temp_opt && ins.a >= 0 && ins.a < is_cross_bb.len && !is_cross_bb[ins.a] && ins.a < temp_reg.len && temp_reg[ins.a] >= 0 {
                    need_spill = false
                }
                if need_spill && ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, r_dest, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_STORE_INDEX {
                // store_index(a_base, b_idx, c_val)
                $r_base := target.REG_ARM64_X1
                if ins.a >= 0 {
                    if ins.a < temp_reg.len && temp_reg[ins.a] >= 0 {
                        r_base = temp_reg[ins.a]
                    } else if ins.a < temp_local_src.len && temp_local_src[ins.a] >= 0 && local_regs[temp_local_src[ins.a]] >= 0 {
                        r_base = local_regs[temp_local_src[ins.a]]
                    } else if ins.a < temp_offsets.len {
                        slot_off := temp_offsets[ins.a]
                        target.arm64_ldr_imm(cb, r_base, target.REG_ARM64_SP, slot_off)
                    }
                }
                $r_idx := target.REG_ARM64_X2
                if ins.b <= -2 {
                    cidx := 0 - ins.b - 2
                    target.arm64_mov_imm64(cb, r_idx, f.consts[cidx])
                } else if ins.b >= 0 {
                    if ins.b < temp_reg.len && temp_reg[ins.b] >= 0 {
                        r_idx = temp_reg[ins.b]
                    } else if ins.b < temp_local_src.len && temp_local_src[ins.b] >= 0 && local_regs[temp_local_src[ins.b]] >= 0 {
                        r_idx = local_regs[temp_local_src[ins.b]]
                    } else if ins.b < temp_offsets.len {
                        slot_off := temp_offsets[ins.b]
                        target.arm64_ldr_imm(cb, r_idx, target.REG_ARM64_SP, slot_off)
                    }
                }
                $r_val := target.REG_ARM64_X0
                if ins.c <= -2 {
                    cidx := 0 - ins.c - 2
                    target.arm64_mov_imm64(cb, r_val, f.consts[cidx])
                } else if ins.c >= 0 {
                    if ins.c < temp_reg.len && temp_reg[ins.c] >= 0 {
                        r_val = temp_reg[ins.c]
                    } else if ins.c < temp_local_src.len && temp_local_src[ins.c] >= 0 && local_regs[temp_local_src[ins.c]] >= 0 {
                        r_val = local_regs[temp_local_src[ins.c]]
                    } else if ins.c < temp_offsets.len {
                        slot_off := temp_offsets[ins.c]
                        target.arm64_ldr_imm(cb, r_val, target.REG_ARM64_SP, slot_off)
                    }
                }
                target.arm64_str_reg_lsl3(cb, r_val, r_base, r_idx)
            } else if ins.kind == mir.MI_CALL {
                // Pass arguments in X0..X7
                $arg_idx := ins.c
                $reg_idx := 0
                while arg_idx >= 0 && arg_idx < f.margs.len && reg_idx < 8 {
                    av := f.margs[arg_idx].v
                    target_reg := reg_idx
                    if av <= -2 {
                        cidx := 0 - av - 2
                        target.arm64_mov_imm64(cb, target_reg, f.consts[cidx])
                    } else if av >= 0 {
                        if av < temp_callee_reg.len && temp_callee_reg[av] >= 0 {
                            src_r := temp_callee_reg[av]
                            if src_r != target_reg {
                                target.arm64_mov_reg(cb, target_reg, src_r)
                            }
                        } else if av < temp_reg.len && temp_reg[av] >= 0 {
                            src_r := temp_reg[av]
                            if src_r != target_reg {
                                target.arm64_mov_reg(cb, target_reg, src_r)
                            }
                        } else if av < temp_local_src.len && temp_local_src[av] >= 0 && local_regs[temp_local_src[av]] >= 0 {
                            src_r := local_regs[temp_local_src[av]]
                            if src_r != target_reg {
                                target.arm64_mov_reg(cb, target_reg, src_r)
                            }
                        } else if av < temp_offsets.len && temp_offsets[av] >= 0 {
                            slot_off := temp_offsets[av]
                            target.arm64_ldr_imm(cb, target_reg, target.REG_ARM64_SP, slot_off)
                        }
                    }
                    arg_idx = f.margs[arg_idx].next
                    reg_idx += 1
                }

                reloc_off := cb.len()
                target.arm64_bl(cb, 0)
                relocs.push(mc.reloc_new(reloc_off, ins.sval, mc.RELOC_ARM64_CALL26, 0))

                if enable_temp_opt {
                    for si in 0:scratch_pool.len {
                        old_ow := scratch_owner[si]
                        if old_ow >= 0 && old_ow < temp_reg.len {
                            temp_reg[old_ow] = -1
                        }
                        scratch_owner[si] = -1
                    }
                    scratch_idx = 0
                }

                $need_spill_call := true
                if ins.a >= 0 && ins.a < temp_callee_reg.len && temp_callee_reg[ins.a] >= 0 {
                    r_dest := temp_callee_reg[ins.a]
                    target.arm64_mov_reg(cb, r_dest, target.REG_ARM64_X0)
                    need_spill_call = false
                } else if enable_temp_opt && ins.a >= 0 && ins.a < is_cross_bb.len && !is_cross_bb[ins.a] {
                    pool_idx := scratch_idx % 7
                    scratch_idx += 1
                    r_dest := scratch_pool[pool_idx]
                    target.arm64_mov_reg(cb, r_dest, target.REG_ARM64_X0)
                    if ins.a < temp_reg.len {
                        scratch_owner[pool_idx] = ins.a
                        temp_reg[ins.a] = r_dest
                    }
                    need_spill_call = false
                }

                if need_spill_call && ins.a >= 0 && ins.a < temp_offsets.len && temp_offsets[ins.a] >= 0 {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_STR_CONST {
                s := ~ins.sval
                slen := s.len
                raw_bytes := slen + 1
                rem := raw_bytes % 4
                $pad := 0
                if rem != 0 {
                    pad = 4 - rem
                }
                total_data_bytes := raw_bytes + pad
                branch_words := (total_data_bytes / 4) + 1
                branch_ins := 0x14000000 | (branch_words & 0x03ffffff)
                cb.emit_u32_le(branch_ins)

                for si in 0:slen {
                    cb.emit_u8(s[si])
                }
                cb.emit_u8(0)
                for _ in 0:pad {
                    cb.emit_u8(0)
                }

                offset := 0 - total_data_bytes
                imm21 := offset & 0x1fffff
                immlo := imm21 & 3
                immhi := (imm21 / 4) & 0x7ffff
                adr_opcode := (immlo * 0x20000000) | (immhi * 32) | 0x10000000
                cb.emit_u32_le(adr_opcode)

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            }

            if curr_ii == blk.tail {
                <-
            }
            curr_ii = ins.next
        }

        if fused_mul_valid {
            target.arm64_mul(cb, fused_mul_reg, fused_mul_rn, fused_mul_rm)
            if fused_mul_dest >= 0 && fused_mul_dest < temp_offsets.len {
                if !enable_temp_opt || (fused_mul_dest < is_cross_bb.len && is_cross_bb[fused_mul_dest]) {
                    slot_off := temp_offsets[fused_mul_dest]
                    target.arm64_str_imm(cb, fused_mul_reg, target.REG_ARM64_SP, slot_off)
                }
            }
            fused_mul_valid = false
        }

        // 5. Emit block terminator
        if blk.tkind == mir.TKIND_RETURN {
            // Load return value into X0
            if blk.ta <= -2 {
                cidx := 0 - blk.ta - 2
                target.arm64_mov_imm64(cb, target.REG_ARM64_X0, f.consts[cidx])
            } else if blk.ta >= 0 {
                if blk.ta < temp_callee_reg.len && temp_callee_reg[blk.ta] >= 0 {
                    src_r := temp_callee_reg[blk.ta]
                    if src_r != target.REG_ARM64_X0 {
                        target.arm64_mov_reg(cb, target.REG_ARM64_X0, src_r)
                    }
                } else if blk.ta < temp_reg.len && temp_reg[blk.ta] >= 0 {
                    src_r := temp_reg[blk.ta]
                    if src_r != target.REG_ARM64_X0 {
                        target.arm64_mov_reg(cb, target.REG_ARM64_X0, src_r)
                    }
                } else if blk.ta < temp_local_src.len && temp_local_src[blk.ta] >= 0 && local_regs[temp_local_src[blk.ta]] >= 0 {
                    src_r := local_regs[temp_local_src[blk.ta]]
                    if src_r != target.REG_ARM64_X0 {
                        target.arm64_mov_reg(cb, target.REG_ARM64_X0, src_r)
                    }
                } else if blk.ta < temp_offsets.len && temp_offsets[blk.ta] >= 0 {
                    slot_off := temp_offsets[blk.ta]
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            }

            // Function Epilogue
            if num_saved_pairs >= 4 {
                target.arm64_ldp_offset(cb, target.REG_ARM64_X25, target.REG_ARM64_X26, target.REG_ARM64_SP, 64)
            }
            if num_saved_pairs >= 3 {
                target.arm64_ldp_offset(cb, target.REG_ARM64_X23, target.REG_ARM64_X24, target.REG_ARM64_SP, 48)
            }
            if num_saved_pairs >= 2 {
                target.arm64_ldp_offset(cb, target.REG_ARM64_X21, target.REG_ARM64_X22, target.REG_ARM64_SP, 32)
            }
            if num_saved_pairs >= 1 {
                target.arm64_ldp_offset(cb, target.REG_ARM64_X19, target.REG_ARM64_X20, target.REG_ARM64_SP, 16)
            }

            if total_frame_size <= 504 {
                target.arm64_ldp_post(cb, target.REG_ARM64_FP, target.REG_ARM64_LR, target.REG_ARM64_SP, total_frame_size)
            } else {
                target.arm64_ldp_offset(cb, target.REG_ARM64_FP, target.REG_ARM64_LR, target.REG_ARM64_SP, 0)
                target.arm64_add_imm(cb, target.REG_ARM64_SP, target.REG_ARM64_SP, total_frame_size)
            }
            if f.name == "main" {
                // Exit process with X0
                target.arm64_mov_imm64(cb, target.REG_ARM64_X16, 0x2000001)
                target.arm64_svc(cb, 0x80)
            } else {
                target.arm64_ret(cb)
            }
        } else if blk.tkind == mir.TKIND_JUMP {
            if blk.ta != bi + 1 {
                target_lbl := f.label + "_bb" + str(blk.ta)
                reloc_off := cb.len()
                target.arm64_b(cb, 0)
                relocs.push(mc.reloc_new(reloc_off, target_lbl, mc.RELOC_ARM64_CALL26, 0))
            }
        } else if blk.tkind == mir.TKIND_BRANCH {
            $branch_cond := target.ARM64_COND_NE
            if last_cmp_dest == blk.ta && last_cmp_cond >= 0 {
                branch_cond = last_cmp_cond
            } else {
                $cond_reg := target.REG_ARM64_X0
                if blk.ta >= 0 {
                    if blk.ta < temp_callee_reg.len && temp_callee_reg[blk.ta] >= 0 {
                        cond_reg = temp_callee_reg[blk.ta]
                    } else if blk.ta < temp_reg.len && temp_reg[blk.ta] >= 0 {
                        cond_reg = temp_reg[blk.ta]
                    } else if blk.ta < temp_local_src.len && temp_local_src[blk.ta] >= 0 && local_regs[temp_local_src[blk.ta]] >= 0 {
                        cond_reg = local_regs[temp_local_src[blk.ta]]
                    } else if blk.ta < temp_offsets.len && temp_offsets[blk.ta] >= 0 {
                        slot_off := temp_offsets[blk.ta]
                        target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                    }
                    target.arm64_cmp_imm(cb, cond_reg, 0)
                }
            }
            if blk.tb == bi + 1 {
                inv_cond := branch_cond ^ 1
                else_lbl := f.label + "_bb" + str(blk.tc)
                reloc_else := cb.len()
                target.arm64_b_cond(cb, inv_cond, 0)
                relocs.push(mc.reloc_new(reloc_else, else_lbl, mc.RELOC_ARM64_COND_BR19, 0))
            } else if blk.tc == bi + 1 {
                then_lbl := f.label + "_bb" + str(blk.tb)
                reloc_then := cb.len()
                target.arm64_b_cond(cb, branch_cond, 0)
                relocs.push(mc.reloc_new(reloc_then, then_lbl, mc.RELOC_ARM64_COND_BR19, 0))
            } else {
                then_lbl := f.label + "_bb" + str(blk.tb)
                reloc_then := cb.len()
                target.arm64_b_cond(cb, branch_cond, 0)
                relocs.push(mc.reloc_new(reloc_then, then_lbl, mc.RELOC_ARM64_COND_BR19, 0))

                else_lbl := f.label + "_bb" + str(blk.tc)
                reloc_else := cb.len()
                target.arm64_b(cb, 0)
                relocs.push(mc.reloc_new(reloc_else, else_lbl, mc.RELOC_ARM64_CALL26, 0))
            }
        }
    }
}

pub fn isel_fn_x64(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, enable_regalloc bool) {
    t := target.target_new(target.OS_LINUX, target.ARCH_X64)
    $fr := frame_new(&t)

    $local_offsets := []int{}
    for i in 0:f.locals.len {
        s := fr.alloc_local(8)
        local_offsets.push(fr.local_slots[s].offset)
    }

    $temp_offsets := []int{}
    for i in 0:f.temps.len {
        s := fr.alloc_local(8)
        temp_offsets.push(fr.local_slots[s].offset)
    }

    fr.finalize_layout()
    stack_size := fr.total_stack_size
    is_cross_bb := analyze_cross_bb_temps(f)

    syms.define_label(f.label, cb.len())

    // Prologue: push rbp; mov rbp, rsp; sub rsp, stack_size
    target.x64_push(cb, target.REG_X64_RBP)
    target.x64_mov_reg(cb, target.REG_X64_RBP, target.REG_X64_RSP)
    if stack_size > 0 {
        target.x64_sub_imm32(cb, target.REG_X64_RSP, stack_size)
    }

    // Parameters in RDI, RSI, RDX, RCX, R8, R9
    $arg_regs := []int{}
    arg_regs.push(target.REG_X64_RDI)
    arg_regs.push(target.REG_X64_RSI)
    arg_regs.push(target.REG_X64_RDX)
    arg_regs.push(target.REG_X64_RCX)
    arg_regs.push(target.REG_X64_R8)
    arg_regs.push(target.REG_X64_R9)
    for pi in 0:f.nparams {
        if pi < arg_regs.len && pi < local_offsets.len {
            loc_off := local_offsets[pi]
            target.x64_str_rsp(cb, arg_regs[pi], loc_off)
        }
    }

    for bi in 0:f.blocks.len {
        blk_label := f.label + "_bb" + str(bi)
        syms.define_label(blk_label, cb.len())

        blk := ~f.blocks[bi]

        $curr_ii := blk.head
        while curr_ii >= 0 && curr_ii < f.instrs.len {
            ins := ~f.instrs[curr_ii]

            if ins.kind == mir.MI_STORE_LOCAL {
                if ins.b <= -2 {
                    cidx := 0 - ins.b - 2
                    $val := 0
                    if cidx >= 0 && cidx < f.consts.len {
                        val = f.consts[cidx]
                    }
                    target.x64_mov_imm64(cb, target.REG_X64_RAX, val)
                } else if ins.b >= 0 && ins.b < temp_offsets.len {
                    slot_off := temp_offsets[ins.b]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                }

                if ins.a >= 0 && ins.a < local_offsets.len {
                    loc_off := local_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, loc_off)
                }
            } else if ins.kind == mir.MI_LOAD_LOCAL {
                if ins.b >= 0 && ins.b < local_offsets.len {
                    loc_off := local_offsets[ins.b]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, loc_off)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            } else if ins.kind == mir.MI_COPY {
                if ins.b <= -2 {
                    const_idx := 0 - ins.b - 2
                    $val := 0
                    if const_idx >= 0 && const_idx < f.consts.len {
                        val = f.consts[const_idx]
                    }
                    target.x64_mov_imm64(cb, target.REG_X64_RAX, val)
                } else if ins.b >= 0 && ins.b < temp_offsets.len {
                    slot_off := temp_offsets[ins.b]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            } else if ins.kind == mir.MI_BIN {
                // LHS into RAX
                if ins.c <= -2 {
                    cidx := 0 - ins.c - 2
                    target.x64_mov_imm64(cb, target.REG_X64_RAX, f.consts[cidx])
                } else if ins.c >= 0 && ins.c < temp_offsets.len {
                    slot_off := temp_offsets[ins.c]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                }

                // RHS into RCX
                if ins.d <= -2 {
                    cidx := 0 - ins.d - 2
                    target.x64_mov_imm64(cb, target.REG_X64_RCX, f.consts[cidx])
                } else if ins.d >= 0 && ins.d < temp_offsets.len {
                    slot_off := temp_offsets[ins.d]
                    target.x64_ldr_rsp(cb, target.REG_X64_RCX, slot_off)
                }

                if ins.b == mir.BIN_ADD {
                    target.x64_add_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                } else if ins.b == mir.BIN_SUB {
                    target.x64_sub_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                } else if ins.b == mir.BIN_MUL {
                    target.x64_imul_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                } else if ins.b == mir.BIN_EQ || ins.b == mir.BIN_STR_EQ {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_E)
                } else if ins.b == mir.BIN_NE || ins.b == mir.BIN_STR_NE {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_NE)
                } else if ins.b == mir.BIN_LT {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_L)
                } else if ins.b == mir.BIN_LE {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_LE)
                } else if ins.b == mir.BIN_GT {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_G)
                } else if ins.b == mir.BIN_GE {
                    target.x64_cmp_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                    target.x64_setcc(cb, target.REG_X64_RAX, target.X64_COND_GE)
                }

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            } else if ins.kind == mir.MI_SELECT {
                // RAX = else_val
                if ins.d <= -2 {
                    cidx := 0 - ins.d - 2
                    target.x64_mov_imm64(cb, target.REG_X64_RAX, f.consts[cidx])
                } else if ins.d >= 0 && ins.d < temp_offsets.len {
                    slot_off := temp_offsets[ins.d]
                    target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                }
                // RCX = then_val
                if ins.c <= -2 {
                    cidx := 0 - ins.c - 2
                    target.x64_mov_imm64(cb, target.REG_X64_RCX, f.consts[cidx])
                } else if ins.c >= 0 && ins.c < temp_offsets.len {
                    slot_off := temp_offsets[ins.c]
                    target.x64_ldr_rsp(cb, target.REG_X64_RCX, slot_off)
                }
                // Check cond temp ins.b
                if ins.b >= 0 && ins.b < temp_offsets.len {
                    slot_off := temp_offsets[ins.b]
                    target.x64_ldr_rsp(cb, target.REG_X64_RDX, slot_off)
                    target.x64_cmp_imm32(cb, target.REG_X64_RDX, 0)
                }
                // jz skip (2 bytes short jump: 0x74 0x03), mov rax, rcx (0x48 0x89 0xc8: 3 bytes)
                cb.emit_u8(0x74)
                cb.emit_u8(0x03)
                target.x64_mov_reg(cb, target.REG_X64_RAX, target.REG_X64_RCX)
                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            } else if ins.kind == mir.MI_CALL {
                $arg_idx := ins.c
                $reg_idx := 0
                while arg_idx >= 0 && arg_idx < f.margs.len && reg_idx < arg_regs.len {
                    av := f.margs[arg_idx].v
                    target_reg := arg_regs[reg_idx]
                    if av <= -2 {
                        cidx := 0 - av - 2
                        target.x64_mov_imm64(cb, target_reg, f.consts[cidx])
                    } else if av >= 0 && av < temp_offsets.len {
                        slot_off := temp_offsets[av]
                        target.x64_ldr_rsp(cb, target_reg, slot_off)
                    }
                    arg_idx = f.margs[arg_idx].next
                    reg_idx += 1
                }

                reloc_off := cb.len() + 1
                target.x64_call(cb, 0)
                relocs.push(mc.reloc_new(reloc_off, ins.sval, mc.RELOC_X64_PC32, 0))

                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a]
                    target.x64_str_rsp(cb, target.REG_X64_RAX, slot_off)
                }
            }

            if curr_ii == blk.tail {
                <-
            }
            curr_ii = ins.next
        }

        if blk.tkind == mir.TKIND_RETURN {
            if blk.ta <= -2 {
                cidx := 0 - blk.ta - 2
                target.x64_mov_imm64(cb, target.REG_X64_RAX, f.consts[cidx])
            } else if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta]
                target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
            }

            if stack_size > 0 {
                target.x64_add_imm32(cb, target.REG_X64_RSP, stack_size)
            }
            target.x64_pop(cb, target.REG_X64_RBP)

            if f.name == "main" {
                // Linux exit(RAX): mov rdi, rax; mov rax, 60; syscall
                target.x64_mov_reg(cb, target.REG_X64_RDI, target.REG_X64_RAX)
                target.x64_mov_imm64(cb, target.REG_X64_RAX, 60)
                target.x64_syscall(cb)
            } else {
                target.x64_ret(cb)
            }
        } else if blk.tkind == mir.TKIND_JUMP {
            target_lbl := f.label + "_bb" + str(blk.ta)
            reloc_off := cb.len() + 1
            target.x64_jmp(cb, 0)
            relocs.push(mc.reloc_new(reloc_off, target_lbl, mc.RELOC_X64_PC32, 0))
        } else if blk.tkind == mir.TKIND_BRANCH {
            if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta]
                target.x64_ldr_rsp(cb, target.REG_X64_RAX, slot_off)
                target.x64_cmp_imm32(cb, target.REG_X64_RAX, 0)
            }
            then_lbl := f.label + "_bb" + str(blk.tb)
            reloc_then := cb.len() + 2
            target.x64_jcc(cb, target.X64_COND_NE, 0)
            relocs.push(mc.reloc_new(reloc_then, then_lbl, mc.RELOC_X64_PC32, 0))

            else_lbl := f.label + "_bb" + str(blk.tc)
            reloc_else := cb.len() + 1
            target.x64_jmp(cb, 0)
            relocs.push(mc.reloc_new(reloc_else, else_lbl, mc.RELOC_X64_PC32, 0))
        }
    }
}
