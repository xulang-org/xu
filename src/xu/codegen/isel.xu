@xu/codegen
// Instruction selection and lowering from MIR to machine code.
//
// Layer 4C module: lowers architecture-independent MIR functions into
// target-specific machine instructions using Target encoders and CodeBuffer.

#xu/mir
#xu/target
#xu/mc

pub fn isel_fn_arm64(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    t := target.target_new(target.OS_MACOS, target.ARCH_ARM64)
    $fr := frame_new(&t)

    // 1. Allocate stack slots for locals and temps
    $local_offsets := []int{}
    for i in 0:f.locals.len {
        s := fr.alloc_local(8)
        local_offsets.push(fr.local_slots[s].offset)
    }

    $temp_offsets := []int{}
    for i in 0:f.temps.len {
        s := fr.alloc_local(8)
        temp_offsets.push(fr.local_slots[s].offset)
    }

    fr.finalize_layout()
    stack_size := fr.total_stack_size

    // 2. Define function entry label
    syms.define_label(f.label, cb.len())

    // 3. Emit function prologue
    // stp fp, lr, [sp, -16]!
    target.arm64_stp_pre(cb, target.REG_ARM64_FP, target.REG_ARM64_LR, target.REG_ARM64_SP, -16)
    // mov fp, sp
    target.arm64_mov_reg(cb, target.REG_ARM64_FP, target.REG_ARM64_SP)
    // sub sp, sp, #stack_size (if stack_size > 0)
    if stack_size > 0 {
        target.arm64_sub_imm(cb, target.REG_ARM64_SP, target.REG_ARM64_SP, stack_size)
    }

    // 4. Emit blocks
    for bi in 0:f.blocks.len {
        blk_label := f.label + "_bb" + str(bi)
        syms.define_label(blk_label, cb.len())

        blk := ~f.blocks[bi]

        // Emit instructions in block
        $curr_ii := blk.head
        while curr_ii >= 0 && curr_ii < f.instrs.len {
            ins := ~f.instrs[curr_ii]

            if ins.kind == mir.MI_COPY {
                // Load src into X0
                if ins.b <= -2 {
                    // Constant value
                    const_idx := 0 - ins.b - 2
                    $val := 0
                    if const_idx >= 0 && const_idx < f.consts.len {
                        val = f.consts[const_idx]
                    }
                    target.arm64_mov_imm64(cb, target.REG_ARM64_X0, val)
                } else if ins.b >= 0 && ins.b < temp_offsets.len {
                    // Temp variable from stack
                    slot_off := temp_offsets[ins.b] + 16
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
                // Store X0 to dest temp
                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a] + 16
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_BIN {
                // a = b op c
                // Load LHS into X0
                if ins.c <= -2 {
                    cidx := 0 - ins.c - 2
                    target.arm64_mov_imm64(cb, target.REG_ARM64_X0, f.consts[cidx])
                } else if ins.c >= 0 && ins.c < temp_offsets.len {
                    slot_off := temp_offsets[ins.c] + 16
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }

                // Load RHS into X1
                if ins.d <= -2 {
                    cidx := 0 - ins.d - 2
                    target.arm64_mov_imm64(cb, target.REG_ARM64_X1, f.consts[cidx])
                } else if ins.d >= 0 && ins.d < temp_offsets.len {
                    slot_off := temp_offsets[ins.d] + 16
                    target.arm64_ldr_imm(cb, target.REG_ARM64_X1, target.REG_ARM64_SP, slot_off)
                }

                // Opcode: 1=Add, 2=Sub, 3=Mul, 4=Div
                if ins.b == 1 {
                    target.arm64_add_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == 2 {
                    target.arm64_sub_reg(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == 3 {
                    target.arm64_mul(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                } else if ins.b == 4 {
                    target.arm64_sdiv(cb, target.REG_ARM64_X0, target.REG_ARM64_X0, target.REG_ARM64_X1)
                }

                // Store X0 to dest temp
                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a] + 16
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            } else if ins.kind == mir.MI_CALL {
                // Record relocation for callee symbol
                reloc_off := cb.len()
                target.arm64_bl(cb, 0)
                relocs.push(mc.reloc_new(reloc_off, ins.sval, mc.RELOC_ARM64_CALL26, 0))

                // Store return value from X0 into dest temp
                if ins.a >= 0 && ins.a < temp_offsets.len {
                    slot_off := temp_offsets[ins.a] + 16
                    target.arm64_str_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                }
            }

            if curr_ii == blk.tail {
                <-
            }
            curr_ii = ins.next
        }

        // 5. Emit block terminator
        if blk.tkind == mir.TKIND_RETURN {
            // Load return value into X0
            if blk.ta <= -2 {
                cidx := 0 - blk.ta - 2
                target.arm64_mov_imm64(cb, target.REG_ARM64_X0, f.consts[cidx])
            } else if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta] + 16
                target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
            }

            // Function Epilogue
            if stack_size > 0 {
                target.arm64_add_imm(cb, target.REG_ARM64_SP, target.REG_ARM64_SP, stack_size)
            }
            target.arm64_ldp_post(cb, target.REG_ARM64_FP, target.REG_ARM64_LR, target.REG_ARM64_SP, 16)
            target.arm64_ret(cb)
        } else if blk.tkind == mir.TKIND_JUMP {
            target_lbl := f.label + "_bb" + str(blk.ta)
            reloc_off := cb.len()
            target.arm64_b(cb, 0)
            relocs.push(mc.reloc_new(reloc_off, target_lbl, mc.RELOC_ARM64_CALL26, 0))
        } else if blk.tkind == mir.TKIND_BRANCH {
            // Compare condition temp with 0
            if blk.ta >= 0 && blk.ta < temp_offsets.len {
                slot_off := temp_offsets[blk.ta] + 16
                target.arm64_ldr_imm(cb, target.REG_ARM64_X0, target.REG_ARM64_SP, slot_off)
                target.arm64_cmp_imm(cb, target.REG_ARM64_X0, 0)
            }
            // Branch to then block if NE
            then_lbl := f.label + "_bb" + str(blk.tb)
            reloc_then := cb.len()
            target.arm64_b_cond(cb, target.ARM64_COND_NE, 0)
            relocs.push(mc.reloc_new(reloc_then, then_lbl, mc.RELOC_ARM64_COND_BR19, 0))

            // Fallthrough jump to else block
            else_lbl := f.label + "_bb" + str(blk.tc)
            reloc_else := cb.len()
            target.arm64_b(cb, 0)
            relocs.push(mc.reloc_new(reloc_else, else_lbl, mc.RELOC_ARM64_CALL26, 0))
        }
    }
}
