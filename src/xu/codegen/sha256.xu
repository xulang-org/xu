@xu/codegen

#xu/mc
#xu/target/chips/apple_m1 as arm_crypto

const SHA256_SUPPORTED = "_xu_crypto_sha256_sha256_hw_supported"
const SHA256_COMPRESS = "_xu_crypto_sha256_sha256_hw_compress_block"

pub fn sha256_hw_entry(label &string) bool {
    << *label == SHA256_SUPPORTED || *label == SHA256_COMPRESS
}

pub fn emit_arm64_sha256(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, label &string, os int, object bool) {
    syms.define_label(*label, cb.len())
    if *label == SHA256_SUPPORTED {
        emit_arm64_crypto_probe(cb, relocs, os, object, 6)
        <<
    }

    // x0 points to eight int64 state words. x1 is the input descriptor
    // and x2 the byte offset. SHA2 instructions operate on 32-bit lanes.
    a64_ldr(cb, 4, 1, 0)
    a64_rrr(cb, 0x8B000000, 4, 4, 2)
    for i in 0:8 {
        a64_ldr(cb, 6, 0, i * 8)
        e32(cb, 0x4E041C00 | ((i & 3) << 19) | (6 << 5) | (i >> 2)) // ins vD.s[lane], w6
    }
    a64_rrr(cb, 0x4EA01C00, 16, 0, 0) // save ABCD
    a64_rrr(cb, 0x4EA01C00, 17, 1, 1) // save EFGH
    for i in 0:4 {
        v := 2 + i
        e32(cb, 0x3DC00000 | (i << 10) | (4 << 5) | v) // ldr qV, [x4, #16*i]
        e32(cb, 0x6E200800 | (v << 5) | v) // rev32 vV.16b, vV.16b
    }
    lit := cb.len()
    e32(cb, 0) // adr x5, round constants
    for i in 0:16 {
        v := 2 + (i & 3)
        e32(cb, 0x3DC00000 | (i << 10) | (5 << 5) | 6)
        a64_rrr(cb, 0x4EA08400, 6, v, 6) // add v6.4s, vV.4s, v6.4s
        a64_rrr(cb, 0x4EA01C00, 7, 0, 0)
        arm_crypto.emit_sha256h(cb, 0, 1, 6)
        arm_crypto.emit_sha256h2(cb, 1, 7, 6)
        if i < 12 {
            e32(cb, 0x5E282800 | ((2 + ((i + 1) & 3)) << 5) | v) // sha256su0
            a64_rrr(cb, 0x5E006000, v, 2 + ((i + 2) & 3), 2 + ((i + 3) & 3)) // sha256su1
        }
    }
    a64_rrr(cb, 0x4EA08400, 0, 0, 16)
    a64_rrr(cb, 0x4EA08400, 1, 1, 17)
    for i in 0:8 {
        e32(cb, 0x0E043C00 | ((i & 3) << 19) | ((i >> 2) << 5) | 6) // umov w6, vN.s[lane]
        a64_str(cb, 6, 0, i * 8)
    }
    e32(cb, 0xD65F03C0)
    a64_patch_adr(cb, lit, 5)
    words := [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
              0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
              0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
              0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
              0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
              0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
              0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
              0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]
    for i in 0:words.len { cb.emit_u32_le(words[i]) }
}
