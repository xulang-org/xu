@xu/codegen

#internal/uiabi
#xu/mc

// xu_app_start(int argc, char **argv) never returns. Fetch the current
// environment after the C host has configured it, then enter the Xu runtime.
pub fn emit_macos_arm64_entry(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    syms.define_label("_xu_app_start", cb.len())
    a64_sub_sp(cb, 16)
    a64_str(cb, 0, R_SP, 0)
    a64_str(cb, 1, R_SP, 8)
    a64_branch_reloc(cb, relocs, 0x94000000, "__NSGetEnviron", mc.RELOC_ARM64_CALL26)
    a64_ldr(cb, 2, 0, 0)
    a64_ldr(cb, 0, R_SP, 0)
    a64_ldr(cb, 1, R_SP, 8)
    a64_add_imm(cb, R_SP, R_SP, 16)
    e32(cb, 0x2A0003E0) // mov w0, w0 (C int argc)
    a64_branch_reloc(cb, relocs, 0x14000000, "__xu_start", mc.RELOC_ARM64_CALL26)
}

pub fn emit_macos_x64_entry(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    syms.define_label("_xu_app_start", cb.len())
    x64_add_rsp(cb, -24)
    x64_str(cb, X_RDI, X_RSP, 0)
    x64_str(cb, X_RSI, X_RSP, 8)
    x64_call(cb, relocs, "__NSGetEnviron")
    x64_ldr(cb, X_RDX, X_RAX, 0)
    x64_load(cb, 4, X_RDI, X_RSP, 0)
    x64_ldr(cb, X_RSI, X_RSP, 8)
    x64_add_rsp(cb, 24)
    x64_jmp(cb, relocs, "__xu_start")
}

// Swift's run loop calls the trampoline on the thread that entered AppKit.
// Save its callee-saved register, install the Xu state, and yield once.
fn emit_arm64_ui_tick(cb $&mc.CodeBuffer) {
    a64_sub_sp(cb, 16)
    a64_str(cb, R_STATE, R_SP, 0)
    a64_str(cb, 30, R_SP, 8)
    a64_mov(cb, R_STATE, 0)
    e32(cb, 0xD63F0020) // blr x1
    a64_ldr(cb, R_STATE, R_SP, 0)
    a64_ldr(cb, 30, R_SP, 8)
    a64_add_imm(cb, R_SP, R_SP, 16)
    e32(cb, 0xD65F03C0)
}

fn emit_x64_ui_tick(cb $&mc.CodeBuffer) {
    xb(cb, 0x41)
    xb(cb, 0x57) // push r15
    x64_mov(cb, X_R15, X_RDI)
    x64_call_reg(cb, X_RSI)
    xb(cb, 0x41)
    xb(cb, 0x5F) // pop r15
    x64_ret(cb)
}

fn arm64_ui_case(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc,
    nr int, symbol string, tick int) {
    next := "__xu_ui_after_" + str(0 - nr)
    e32(cb, 0xB100001F | ((0 - nr) << 10)) // cmn x0, #-nr
    a64_branch_reloc(cb, relocs, 0x54000001, next + "", mc.RELOC_ARM64_COND_BR19)
    for i in 0:4 {
        a64_mov(cb, i, i + 1)
    }
    if nr == uiabi.RUN {
        a64_mov(cb, 3, 1)
        delta := tick - cb.len()
        e32(cb, 0x10000001 | ((delta & 3) << 29) | (((delta >> 2) & 0x7ffff) << 5))
    }
    a64_sub_sp(cb, 16)
    a64_str(cb, 30, R_SP, 8)
    a64_branch_reloc(cb, relocs, 0x94000000, symbol, mc.RELOC_ARM64_CALL26)
    a64_ldr(cb, 30, R_SP, 8)
    a64_add_imm(cb, R_SP, R_SP, 16)
    e32(cb, 0x93407C00) // sxtw x0, w0 (C int result)
    e32(cb, 0xD65F03C0)
    syms.define_label(next, cb.len())
}

fn x64_ui_case(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, nr int, symbol string) {
    x64_cmp_imm8(cb, X_RDI, nr)
    next := x64_jshort(cb, CC_NE)
    x64_mov(cb, X_RDI, X_RSI)
    x64_mov(cb, X_RSI, X_RDX)
    x64_mov(cb, X_RDX, X_RCX)
    x64_mov(cb, X_RCX, X_R8)
    if nr == uiabi.RUN {
        x64_mov(cb, X_RCX, X_RSI)
        x64_lea_label(cb, relocs, X_RSI, "__xu_ui_tick")
    }
    x64_add_rsp(cb, -8)
    x64_call(cb, relocs, symbol)
    x64_add_rsp(cb, 8)
    xb(cb, 0x48)
    xb(cb, 0x63)
    xb(cb, 0xC0) // movsxd rax, eax (C int result)
    x64_ret(cb)
    x64_land(cb, next)
}

fn emit_arm64_ui_dispatch(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    tick := cb.len()
    emit_arm64_ui_tick(cb)
    syms.define_label("__xu_syscall", cb.len())
    arm64_ui_case(cb, syms, relocs, uiabi.RUN, "_xu_ui_host_run_cooperative", tick)
    arm64_ui_case(cb, syms, relocs, uiabi.READ_LEN, "_xu_ui_mem_try_read_len", tick)
    arm64_ui_case(cb, syms, relocs, uiabi.READ_COPY, "_xu_ui_mem_try_read_copy", tick)
    arm64_ui_case(cb, syms, relocs, uiabi.WRITE, "_xu_ui_mem_try_write", tick)
}

fn emit_x64_ui_dispatch(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    syms.define_label("__xu_ui_tick", cb.len())
    emit_x64_ui_tick(cb)
    syms.define_label("__xu_syscall", cb.len())
    x64_ui_case(cb, relocs, uiabi.RUN, "_xu_ui_host_run_cooperative")
    x64_ui_case(cb, relocs, uiabi.READ_LEN, "_xu_ui_mem_try_read_len")
    x64_ui_case(cb, relocs, uiabi.READ_COPY, "_xu_ui_mem_try_read_copy")
    x64_ui_case(cb, relocs, uiabi.WRITE, "_xu_ui_mem_try_write")
}
