@xu/codegen

#internal/uiabi
#xu/mc
#xu/target

// Mobile hosts own process lifetime and the UI thread. Enter Xu on a worker,
// use libc for OS services, and terminate that worker when main returns.
pub fn emit_phone_arm64_runtime(cb $&mc.CodeBuffer, syms $&mc.SymbolTable,
    relocs $&[]mc.Reloc, os int) {
    $prefix := ""
    if os == target.OS_MACOS { prefix = "_" }
    syms.define_label(prefix + "xu_app_start", cb.len())
    syms.define_label("__xu_start", cb.len())
    a64_mov(cb, 19, 0)
    a64_mov(cb, 20, 1)
    a64_mov(cb, 21, 2)
    a64_branch_reloc(cb, relocs, 0x94000000, prefix + "xu_phone_state", mc.RELOC_ARM64_CALL26)
    a64_mov(cb, R_STATE, 0)
    a64_str(cb, 19, R_STATE, 0)
    a64_str(cb, 20, R_STATE, 8)
    a64_str(cb, 21, R_STATE, 32)
    a64_mov_imm(cb, 0, 1)
    a64_str(cb, 0, R_STATE, uiabi.STATE_OFFSET)
    a64_branch_reloc(cb, relocs, 0x94000000, "_xu_main", mc.RELOC_ARM64_CALL26)
    a64_branch_reloc(cb, relocs, 0x14000000, prefix + "xu_phone_finish", mc.RELOC_ARM64_CALL26)

    emit_arm64_ui_dispatch(cb, syms, relocs, ~prefix)
    emit_arm64_pseudo_calls(cb, syms, relocs)
    // The C ABI accepts the same seven integer arguments as __xu_syscall.
    // A tail call preserves the caller's LR and the Xu state in callee-saved x28.
    a64_branch_reloc(cb, relocs, 0x14000000, prefix + "xu_phone_syscall", mc.RELOC_ARM64_CALL26)
    emit_arm64_globals(cb, syms)
}
