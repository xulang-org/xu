@xu/codegen

#xu/mc
#internal/uiabi

pub fn emit_windows_arm64_entry(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    syms.define_label("xu_app_start", cb.len())
    a64_branch_reloc(cb, relocs, 0x14000000, "__xu_start", mc.RELOC_ARM64_CALL26)
}

pub fn arm64_win_api_import(name &string) bool {
    names := win_import_names(0)
    for i in 0:names.len {
        if names[i] == name + "" {
            << true
        }
    }
    << false
}

// Windows ARM64 uses the same integer argument registers as Xu on AArch64.
// Reserve x18 for the OS and forward the runtime's Windows slots to the IAT.
pub fn emit_arm64_windows_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, main_label string, link_ui bool, emit_object bool) {
    syms.define_label("__xu_start", cb.len())
    a64_mov_imm(cb, 0, WIN_SLOT_BASE + WIN_SLOT_VIRTUAL_ALLOC)
    a64_mov(cb, 1, 31)
    a64_mov_imm(cb, 2, 65536)
    a64_mov_imm(cb, 3, 0x3000) // MEM_COMMIT | MEM_RESERVE
    a64_mov_imm(cb, 4, 4) // PAGE_READWRITE
    a64_branch_reloc(cb, relocs, 0x94000000, "__xu_syscall", mc.RELOC_ARM64_CALL26)
    // The runtime reads argc, argv and the environment from kernel32.
    a64_mov(cb, R_STATE, 0)
    if !emit_object {
        a64_mov(cb, R_FP, 31)
    }
    if link_ui {
        a64_mov_imm(cb, 0, 1)
        a64_str(cb, 0, R_STATE, uiabi.STATE_OFFSET)
    }
    a64_branch_reloc(cb, relocs, 0x94000000, main_label, mc.RELOC_ARM64_CALL26)
    a64_mov(cb, 1, 0)
    a64_mov_imm(cb, 0, WIN_SLOT_BASE + WIN_SLOT_EXIT_PROCESS)
    a64_branch_reloc(cb, relocs, 0x94000000, "__xu_syscall", mc.RELOC_ARM64_CALL26)
    e32(cb, 0xD4200000) // brk if ExitProcess unexpectedly returns

    if link_ui {
        emit_arm64_ui_dispatch(cb, syms, relocs, "")
    } else {
        syms.define_label("__xu_syscall", cb.len())
    }
    emit_arm64_pseudo_calls(cb, syms, relocs)
    emit_arm64_win_calls(cb, syms, relocs, emit_object)
    emit_arm64_globals(cb, syms)
    if emit_object {
        emit_arm64_win_import_thunks(cb, syms, relocs)
    } else {
        emit_win_imports(cb, syms)
        // The last DLL name is variable length. Align the instructions that
        // follow the import data (for example the vector loop stubs).
        while cb.len() % 4 != 0 {
            cb.emit_u8(0)
        }
    }
}

fn emit_arm64_win_calls(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, emit_object bool) {
    // -6 takes an arbitrary resolved export in x1 and argument words in x2.
    e32(cb, 0xB100181F) // cmn x0, #6
    a64_branch_reloc(cb, relocs, 0x54000000, "__xu_win_pointer", mc.RELOC_ARM64_COND_BR19)
    a64_mov_imm(cb, 9, WIN_SLOT_BASE)
    a64_rrr(cb, 0xCB000000, 10, 0, 9)
    a64_cmp(cb, 0, 9)
    a64_branch_reloc(cb, relocs, 0x5400000B, "__xu_win_enosys", mc.RELOC_ARM64_COND_BR19)
    a64_mov_imm(cb, 9, 4096)
    a64_cmp(cb, 10, 9)
    a64_branch_reloc(cb, relocs, 0x54000002, "__xu_win_vector", mc.RELOC_ARM64_COND_BR19)

    // Direct calls have six arguments in x1..x6. Tail-call the API so its
    // return reaches the original caller with the stack unchanged.
    a64_win_load_slot(cb, relocs, emit_object)
    for i in 0:6 {
        a64_mov(cb, i, i + 1)
    }
    e32(cb, 0xD61F0200) // br x16

    syms.define_label("__xu_win_vector", cb.len())
    a64_rrr(cb, 0xCB000000, 10, 10, 9)
    a64_win_load_slot(cb, relocs, emit_object)
    a64_mov(cb, 11, 1)
    a64_branch_reloc(cb, relocs, 0x14000000, "__xu_win_call_words", mc.RELOC_ARM64_CALL26)
    syms.define_label("__xu_win_pointer", cb.len())
    a64_mov(cb, R_IP0, 1)
    a64_mov(cb, 11, 2)
    syms.define_label("__xu_win_call_words", cb.len())
    // Twelve integer arguments: x0..x7 and four stack words. Preserve
    // fp/lr above the outgoing arguments and keep sp 16-byte aligned.
    a64_sub_sp(cb, 48)
    a64_pair(cb, 0xA9000000, R_FP, R_LR, R_SP, 32)
    a64_add_imm(cb, R_FP, R_SP, 32)
    for i in 8:12 {
        a64_ldr(cb, 9, 11, i * 8)
        a64_str(cb, 9, R_SP, (i - 8) * 8)
    }
    for i in 0:8 {
        a64_ldr(cb, i, 11, i * 8)
    }
    e32(cb, 0xD63F0200) // blr x16
    a64_pair(cb, 0xA9400000, R_FP, R_LR, R_SP, 32)
    a64_add_imm(cb, R_SP, R_SP, 48)
    e32(cb, 0xD65F03C0)

    syms.define_label("__xu_win_enosys", cb.len())
    a64_mov_imm(cb, 0, -38)
    e32(cb, 0xD65F03C0)
}

// x10 is the slot number. x16 receives the DLL address or a COFF branch thunk.
fn a64_win_load_slot(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, emit_object bool) {
    a64_mov_imm(cb, 12, win_import_names(0).len)
    a64_cmp(cb, 10, 12)
    a64_branch_reloc(cb, relocs, 0x54000002, "__xu_win_enosys", mc.RELOC_ARM64_COND_BR19)
    a64_fn_addr(cb, relocs, 12, "__pe_iat")
    e32(cb, 0x8B0A0D8C) // add x12, x12, x10, lsl #3
    if emit_object {
        a64_mov(cb, R_IP0, 12)
    } else {
        a64_ldr(cb, R_IP0, 12, 0)
    }
}

// The COFF linker resolves the plain API names through the kernel32 import
// library. Each internal slot stays eight bytes wide, just like the PE IAT.
fn emit_arm64_win_import_thunks(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    syms.define_label("__pe_iat", cb.len())
    names := win_import_names(0)
    for i in 0:names.len {
        a64_branch_reloc(cb, relocs, 0x14000000, names[i] + "", mc.RELOC_ARM64_CALL26)
        e32(cb, 0xD503201F) // nop
    }
}
