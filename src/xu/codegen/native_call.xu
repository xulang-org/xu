@xu/codegen

#xu/mc
#xu/target

// Xu passes scalar bits and descriptor addresses as integer words. A native
// adapter saves those words before calling the C marshaler with one pointer;
// Clang then applies the target C ABI, including floating and stack arguments.
pub fn emit_native_adapter(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc,
    label string, bridge string, params int, arch int, os int) {
    syms.define_label(label, cb.len())
    frame := (params * 8 + 15) / 16 * 16
    if arch == target.ARCH_ARM64 {
        e32(cb, 0xA9BF7BFD)
        e32(cb, 0x910003FD)
        if frame > 0 { a64_sub_sp(cb, frame) }
        for i in 0:params {
            if i < 8 { a64_str(cb, i, R_SP, i * 8) }
            else {
                a64_ldr(cb, 9, R_FP, 16 + (i - 8) * 8)
                a64_str(cb, 9, R_SP, i * 8)
            }
        }
        a64_add_imm(cb, 0, R_SP, 0)
        a64_branch_reloc(cb, relocs, 0x94000000, bridge, mc.RELOC_ARM64_CALL26)
        if frame > 0 { a64_add_imm(cb, R_SP, R_SP, frame) }
        e32(cb, 0xA8C17BFD)
        e32(cb, 0xD65F03C0)
    } else if arch == target.ARCH_X64 {
        $shadow := 0
        if os == target.OS_WINDOWS { shadow = 32 }
        size := frame + shadow
        xb(cb, 0x55)
        x64_mov(cb, X_RBP, X_RSP)
        if size > 0 { x64_add_rsp(cb, 0 - size) }
        for i in 0:params {
            if i < 8 { x64_str(cb, x64_arg_reg(i), X_RSP, shadow + i * 8) }
            else {
                x64_ldr(cb, X_RAX, X_RBP, 16 + (i - 8) * 8)
                x64_str(cb, X_RAX, X_RSP, shadow + i * 8)
            }
        }
        $arg0 := X_RDI
        if os == target.OS_WINDOWS { arg0 = X_RCX }
        x64_lea(cb, arg0, X_RSP, shadow)
        x64_call(cb, relocs, bridge)
        x64_mov(cb, X_RSP, X_RBP)
        xb(cb, 0x5D)
        x64_ret(cb)
    } else if arch == target.ARCH_RISCV64 {
        rv_addi(cb, RV_SP, RV_SP, -16)
        rv_sd(cb, RV_S0, RV_SP, 0)
        rv_sd(cb, RV_RA, RV_SP, 8)
        rv_mv(cb, RV_S0, RV_SP)
        rv_li(cb, RV_T4, frame)
        rv_r(cb, 0x20, RV_T4, RV_SP, 0, RV_SP, 0x33)
        for i in 0:params {
            if i < 8 { rv_sd(cb, RV_A0 + i, RV_SP, i * 8) }
            else {
                rv_ld(cb, RV_T0, RV_S0, 16 + (i - 8) * 8)
                rv_sd(cb, RV_T0, RV_SP, i * 8)
            }
        }
        rv_mv(cb, RV_A0, RV_SP)
        rv_call(cb, relocs, bridge)
        rv_mv(cb, RV_SP, RV_S0)
        rv_ld(cb, RV_S0, RV_SP, 0)
        rv_ld(cb, RV_RA, RV_SP, 8)
        rv_addi(cb, RV_SP, RV_SP, 16)
        rv_ret(cb)
    } else {
        la_addi(cb, LA_SP, LA_SP, -16)
        la_st(cb, LA_FP, LA_SP, 0)
        la_st(cb, LA_RA, LA_SP, 8)
        la_mv(cb, LA_FP, LA_SP)
        la_add_imm(cb, LA_SP, LA_SP, 0 - frame)
        for i in 0:params {
            if i < 8 { la_st(cb, LA_A0 + i, LA_SP, i * 8) }
            else {
                la_ld(cb, LA_T0, LA_FP, 16 + (i - 8) * 8)
                la_st(cb, LA_T0, LA_SP, i * 8)
            }
        }
        la_mv(cb, LA_A0, LA_SP)
        la_call(cb, relocs, bridge)
        la_mv(cb, LA_SP, LA_FP)
        la_ld(cb, LA_FP, LA_SP, 0)
        la_ld(cb, LA_RA, LA_SP, 8)
        la_addi(cb, LA_SP, LA_SP, 16)
        la_ret(cb)
    }
}
