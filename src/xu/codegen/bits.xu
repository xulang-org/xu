@xu/codegen

#xu/mc

fn trailing_zeros_entry(label &string) bool {
    << *label == "_xu_math_bits_trailing_zeros" || *label == "_xu_runtime_core_intrin_trailing_zeros"
}

// Calls intercepted directly by the arm64/x64 lowering must not be inlined
// back into their software fallbacks.
pub fn bits_hw_entry(label &string, is_arm64 bool) bool {
    if *label == "_xu_math_bits_reverse_bytes" ||
       *label == "_xu_math_bits_reverse" ||
       *label == "_xu_math_bits_ones_count" ||
       *label == "_xu_math_bits_rotate_left" ||
       *label == "_xu_math_bits_rotate_right" ||
       *label == "_xu_math_bits_len" ||
       *label == "_xu_math_bits_leading_zeros" ||
       trailing_zeros_entry(label) {
        << true
    }
    << false
}

fn a64_bits_arity(label &string) int {
    if *label == "_xu_math_bits_rotate_left" || *label == "_xu_math_bits_rotate_right" {
        << 2
    }
    if bits_hw_entry(label, true) {
        << 1
    }
    << 0
}

// Inline baseline ARM64 bit-op lowering on arbitrary allocated registers.
// Does not modify NZCV flags or touch registers other than rd (and x10 for rotate_left).
fn a64_bits_call_regs(cb $&mc.CodeBuffer, label &string, rd int, rn int, rm int) bool {
    if *label == "_xu_math_bits_leading_zeros" {
        e32(cb, 0xDAC01000 | (rn << 5) | rd) // clz rd, rn
    } else if *label == "_xu_math_bits_len" {
        e32(cb, 0xDAC01000 | (rn << 5) | rd) // clz rd, rn
        e32(cb, 0xCB0003E0 | (rd << 16) | rd) // neg rd, rd
        e32(cb, 0x91010000 | (rd << 5) | rd) // add rd, rd, #64
    } else if trailing_zeros_entry(label) {
        e32(cb, 0xDAC00000 | (rn << 5) | rd) // rbit rd, rn
        e32(cb, 0xDAC01000 | (rd << 5) | rd) // clz rd, rd
    } else if *label == "_xu_math_bits_reverse" {
        e32(cb, 0xDAC00000 | (rn << 5) | rd) // rbit rd, rn
    } else if *label == "_xu_math_bits_reverse_bytes" {
        e32(cb, 0xDAC00C00 | (rn << 5) | rd) // rev rd, rn
    } else if *label == "_xu_math_bits_ones_count" {
        e32(cb, 0x9E670000 | (rn << 5) | 0) // fmov d0, rn (v0 is reserved scratch)
        e32(cb, 0x0E205800) // cnt v0.8b, v0.8b
        e32(cb, 0x0E31B800) // addv b0, v0.8b
        e32(cb, 0x0E013C00 | rd) // umov wd, v0.b[0]
    } else if *label == "_xu_math_bits_rotate_right" {
        e32(cb, 0x9AC02C00 | (rm << 16) | (rn << 5) | rd) // rorv rd, rn, rm
    } else if *label == "_xu_math_bits_rotate_left" {
        e32(cb, 0xCB0003E0 | (rm << 16) | 10) // neg x10, rm
        e32(cb, 0x9AC02C00 | (10 << 16) | (rn << 5) | rd) // rorv rd, rn, x10
    } else {
        << false
    }
    << true
}

// Calls use the internal scalar ABI. Optional x86 instructions stay in
// feature-gated runtime routines; these substitutions only use baseline ISA.
fn a64_bits_call(cb $&mc.CodeBuffer, label &string) bool {
    if *label == "_xu_math_bits_leading_zeros" {
        e32(cb, 0xDAC01000) // clz x0, x0
    } else if *label == "_xu_math_bits_len" {
        e32(cb, 0xDAC01000) // clz x0, x0
        e32(cb, 0xCB0003E0) // neg x0, x0
        e32(cb, 0x91010000) // add x0, x0, 64
    } else if trailing_zeros_entry(label) {
        e32(cb, 0xDAC00000) // rbit x0, x0
        e32(cb, 0xDAC01000)
    } else if *label == "_xu_math_bits_reverse" {
        e32(cb, 0xDAC00000)
    } else if *label == "_xu_math_bits_reverse_bytes" {
        e32(cb, 0xDAC00C00) // rev x0, x0
    } else if *label == "_xu_math_bits_ones_count" {
        e32(cb, 0x9E670000) // fmov d0, x0
        e32(cb, 0x0E205800) // cnt v0.8b, v0.8b
        e32(cb, 0x0E31B800) // addv b0, v0.8b
        e32(cb, 0x0E013C00) // umov w0, v0.b[0]
    } else if *label == "_xu_math_bits_rotate_left" || *label == "_xu_math_bits_rotate_right" {
        if *label == "_xu_math_bits_rotate_left" {
            e32(cb, 0xCB0103E1) // neg x1, x1
        }
        e32(cb, 0x9AC12C00) // rorv x0, x0, x1
    } else {
        << false
    }
    << true
}

const SWAR_M2 = 0x0f0f0f0f0f0f0f0f
const SWAR_M1 = 0x3333333333333333
const SWAR_M0 = 0x5555555555555555

fn x64_swar_stage(cb $&mc.CodeBuffer, mask_reg int, shift int) {
    x64_mov(cb, X_RCX, X_RAX)
    x64_rex(cb, true, 0, X_RAX, false)
    xb(cb, 0xC1)
    x64_modrm_rr(cb, 5, X_RAX) // shr rax, shift
    xb(cb, shift)
    x64_op_rr(cb, 0x21, mask_reg, X_RAX) // and rax, mask_reg
    x64_op_rr(cb, 0x21, mask_reg, X_RCX) // and rcx, mask_reg
    x64_rex(cb, true, 0, X_RCX, false)
    xb(cb, 0xC1)
    x64_modrm_rr(cb, 4, X_RCX) // shl rcx, shift
    xb(cb, shift)
    x64_op_rr(cb, 0x09, X_RCX, X_RAX) // or rax, rcx
}

fn x64_bits_call(cb $&mc.CodeBuffer, label &string) bool {
    if *label == "_xu_math_bits_reverse_bytes" {
        x64_mov(cb, X_RAX, X_RDI)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        xb(cb, 0xC8) // bswap rax
    } else if *label == "_xu_math_bits_reverse" {
        x64_mov(cb, X_RAX, X_RDI)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        xb(cb, 0xC8) // bswap rax
        x64_mov_imm(cb, X_RDX, SWAR_M2)
        x64_swar_stage(cb, X_RDX, 4)
        x64_mov_imm(cb, X_RDX, SWAR_M1)
        x64_swar_stage(cb, X_RDX, 2)
        x64_mov_imm(cb, X_RDX, SWAR_M0)
        x64_swar_stage(cb, X_RDX, 1)
    } else if *label == "_xu_math_bits_ones_count" {
        xb(cb, 0xF3)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        xb(cb, 0xB8)
        xb(cb, 0xC7) // popcnt rax, rdi
    } else if *label == "_xu_math_bits_rotate_left" || *label == "_xu_math_bits_rotate_right" {
        x64_mov(cb, X_RAX, X_RDI)
        x64_mov(cb, X_RCX, X_RSI)
        xb(cb, 0x48)
        xb(cb, 0xD3)
        $op := 0
        if *label == "_xu_math_bits_rotate_right" { op = 1 }
        x64_modrm_rr(cb, op, X_RAX)
    } else if *label == "_xu_math_bits_len" || *label == "_xu_math_bits_leading_zeros" ||
              trailing_zeros_entry(label) {
        x64_test(cb, X_RDI)
        zero := x64_jshort(cb, CC_E)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        if trailing_zeros_entry(label) {
            xb(cb, 0xBC) // bsf rax, rdi
        } else {
            xb(cb, 0xBD) // bsr rax, rdi
        }
        x64_modrm_rr(cb, X_RAX, X_RDI)
        if *label == "_xu_math_bits_len" {
            x64_alu_imm(cb, 0, X_RAX, 1)
        } else if *label == "_xu_math_bits_leading_zeros" {
            x64_alu_imm(cb, 6, X_RAX, 63)
        }
        done := x64_jshort(cb, -1)
        x64_land(cb, zero)
        $value := 64
        if *label == "_xu_math_bits_len" { value = 0 }
        x64_mov_imm(cb, X_RAX, value)
        x64_land(cb, done)
    } else {
        << false
    }
    << true
}
