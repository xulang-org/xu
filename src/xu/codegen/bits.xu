@xu/codegen

#xu/mc

// Calls use the internal scalar ABI. Optional x86 instructions stay in
// feature-gated runtime routines; these substitutions only use baseline ISA.
fn a64_bits_call(cb $&mc.CodeBuffer, label &string) bool {
    if *label == "_xu_math_bits_leading_zeros" {
        e32(cb, 0xDAC01000) // clz x0, x0
    } else if *label == "_xu_math_bits_len" {
        e32(cb, 0xDAC01000)
        a64_mov_imm(cb, 9, 64)
        a64_rrr(cb, 0xCB000000, 0, 9, 0)
    } else if *label == "_xu_math_bits_trailing_zeros" {
        e32(cb, 0xDAC00000) // rbit x0, x0
        e32(cb, 0xDAC01000)
    } else if *label == "_xu_math_bits_reverse" {
        e32(cb, 0xDAC00000)
    } else if *label == "_xu_math_bits_reverse_bytes" {
        e32(cb, 0xDAC00C00) // rev x0, x0
    } else if *label == "_xu_math_bits_ones_count" {
        e32(cb, 0x9E670000) // fmov d0, x0
        e32(cb, 0x0E205800) // cnt v0.8b, v0.8b
        e32(cb, 0x0E31B800) // addv b0, v0.8b
        e32(cb, 0x0E013C00) // umov w0, v0.b[0]
    } else if *label == "_xu_math_bits_rotate_left" || *label == "_xu_math_bits_rotate_right" {
        if *label == "_xu_math_bits_rotate_left" {
            e32(cb, 0xCB0103E1) // neg x1, x1
        }
        e32(cb, 0x9AC12C00) // rorv x0, x0, x1
    } else {
        << false
    }
    << true
}

fn x64_bits_call(cb $&mc.CodeBuffer, label &string) bool {
    if *label == "_xu_math_bits_reverse_bytes" {
        x64_mov(cb, X_RAX, X_RDI)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        xb(cb, 0xC8) // bswap rax
    } else if *label == "_xu_math_bits_rotate_left" || *label == "_xu_math_bits_rotate_right" {
        x64_mov(cb, X_RAX, X_RDI)
        x64_mov(cb, X_RCX, X_RSI)
        xb(cb, 0x48)
        xb(cb, 0xD3)
        $op := 0
        if *label == "_xu_math_bits_rotate_right" { op = 1 }
        x64_modrm_rr(cb, op, X_RAX)
    } else if *label == "_xu_math_bits_len" || *label == "_xu_math_bits_leading_zeros" ||
              *label == "_xu_math_bits_trailing_zeros" {
        x64_test(cb, X_RDI)
        zero := x64_jshort(cb, CC_E)
        xb(cb, 0x48)
        xb(cb, 0x0F)
        if *label == "_xu_math_bits_trailing_zeros" {
            xb(cb, 0xBC) // bsf rax, rdi
        } else {
            xb(cb, 0xBD) // bsr rax, rdi
        }
        x64_modrm_rr(cb, X_RAX, X_RDI)
        if *label == "_xu_math_bits_len" {
            x64_alu_imm(cb, 0, X_RAX, 1)
        } else if *label == "_xu_math_bits_leading_zeros" {
            x64_alu_imm(cb, 6, X_RAX, 63)
        }
        done := x64_jshort(cb, -1)
        x64_land(cb, zero)
        $value := 64
        if *label == "_xu_math_bits_len" { value = 0 }
        x64_mov_imm(cb, X_RAX, value)
        x64_land(cb, done)
    } else {
        << false
    }
    << true
}
