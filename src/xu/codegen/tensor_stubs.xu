    xb(cb, 0x0F)
    xb(cb, 0x58)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_subps(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x0F)
    xb(cb, 0x5C)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_mulps(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x0F)
    xb(cb, 0x59)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_orps(cb $&mc.CodeBuffer, xd int, xs int) {
