fn ts_x64_sub_imm(cb $&mc.CodeBuffer, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0x83)
    x64_modrm_rr(cb, 5, r)
    xb(cb, imm)
}

fn ts_x64_jcc_fwd(cb $&mc.CodeBuffer, cc int) int {
    xb(cb, 0x0F)
    xb(cb, 0x80 | cc)
    cb.emit_u32_le(0)
    << cb.len()
}

fn ts_x64_patch_rel32(cb $&mc.CodeBuffer, at int) {
    cb.patch_u32_le(at - 4, (cb.len() - at) & 0xffffffff)
}

fn ts_x64_jmp_back(cb $&mc.CodeBuffer, target int) {
    xb(cb, 0xE9)
    cb.emit_u32_le((target - (cb.len() + 4)) & 0xffffffff)
}

fn ts_x64_movups_ld(cb $&mc.CodeBuffer, xd int, base int, disp int) {
    x64_rex(cb, false, xd, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x10)
    x64_modrm_mem(cb, xd, base, disp)
}

fn ts_x64_movups_st(cb $&mc.CodeBuffer, xs int, base int, disp int) {
    x64_rex(cb, false, xs, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x11)
    x64_modrm_mem(cb, xs, base, disp)
}

fn ts_x64_movss_ld(cb $&mc.CodeBuffer, xd int, base int, disp int) {
    xb(cb, 0xF3)
    x64_rex(cb, false, xd, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x10)
    x64_modrm_mem(cb, xd, base, disp)
}

fn ts_x64_movss_st(cb $&mc.CodeBuffer, xs int, base int, disp int) {
    xb(cb, 0xF3)
    x64_rex(cb, false, xs, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x11)
    x64_modrm_mem(cb, xs, base, disp)
}

fn ts_x64_movaps(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x0F)
    xb(cb, 0x28)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_xorps(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x0F)
    xb(cb, 0x57)
    x64_modrm_rr(cb, xd, xs)
}

