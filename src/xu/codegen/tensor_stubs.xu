    x64_rex(cb, true, rs, rd, false)
    xb(cb, 0x09)
    x64_modrm_rr(cb, rs, rd)
}

fn ts_x64_and_imm8(cb $&mc.CodeBuffer, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0x83)
    x64_modrm_rr(cb, 4, r)
    xb(cb, imm)
}

fn ts_x64_mulss(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF3)
    xb(cb, 0x0F)
    xb(cb, 0x59)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_shufps(cb $&mc.CodeBuffer, xd int, xs int, imm int) {
    xb(cb, 0x0F)
    xb(cb, 0xC6)
    x64_modrm_rr(cb, xd, xs)
    xb(cb, imm)
}

fn ts_x64_movd_to_xmm(cb $&mc.CodeBuffer, xd int, rs int) {
    xb(cb, 0x66)
    x64_rex(cb, false, xd, rs, false)
    xb(cb, 0x0F)
    xb(cb, 0x6E)
    x64_modrm_rr(cb, xd, rs)
}

fn ts_x64_movd_from_xmm(cb $&mc.CodeBuffer, rd int, xs int) {
    xb(cb, 0x66)
    x64_rex(cb, false, xs, rd, false)
    xb(cb, 0x0F)
    xb(cb, 0x7E)
    x64_modrm_rr(cb, xs, rd)
}

fn ts_x64_serial_sum_xmm0(cb $&mc.CodeBuffer, acc int) {
    ts_x64_addss(cb, acc, 0)
    for _ in 0:3 {
        ts_x64_shufps(cb, 0, 0, 0x39)
        ts_x64_addss(cb, acc, 0)
    }
}

fn ts_x64_hsum_xmm(cb $&mc.CodeBuffer, v int) {
    ts_x64_movaps(cb, 0, v)
    ts_x64_shufps(cb, 0, 0, 0x4E)
    ts_x64_addps(cb, v, 0)
    ts_x64_movaps(cb, 0, v)
    ts_x64_shufps(cb, 0, 0, 0x01)
    ts_x64_addss(cb, v, 0)
}

fn ts_x64_emit_mul_add(cb $&mc.CodeBuffer) {
    // (out=rdi, x=rsi, scale=rdx, bias=rcx, n=r8)
    x64_test(cb, X_R8)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)

    loop4 := cb.len()
    x64_cmp_imm8(cb, X_R8, 4)
    to_tail := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RSI, 0)
    ts_x64_movups_ld(cb, 1, X_RDX, 0)
    ts_x64_movups_ld(cb, 2, X_RCX, 0)
    ts_x64_mulps(cb, 0, 1)
    ts_x64_addps(cb, 0, 2)
    ts_x64_movups_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_add_imm(cb, X_RDX, 16)
    ts_x64_add_imm(cb, X_RCX, 16)
    ts_x64_sub_imm(cb, X_R8, 4)
    ts_x64_jmp_back(cb, loop4)

    ts_x64_patch_rel32(cb, to_tail)
    tail := cb.len()
    x64_test(cb, X_R8)
    done_tail := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RSI, 0)
    ts_x64_movss_ld(cb, 1, X_RDX, 0)
    ts_x64_movss_ld(cb, 2, X_RCX, 0)
    ts_x64_mulss(cb, 0, 1)
    ts_x64_addss(cb, 0, 2)
    ts_x64_movss_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_add_imm(cb, X_RCX, 4)
    ts_x64_sub_imm(cb, X_R8, 1)
    ts_x64_jmp_back(cb, tail)

    ts_x64_patch_rel32(cb, done_early)
    ts_x64_patch_rel32(cb, done_tail)
    x64_ret(cb)
}

fn ts_x64_emit_add_sqsum_arm(cb $&mc.CodeBuffer, write_dst bool, fast bool) {
    // dst=rdi, x=rsi, skip=rdx, n=rcx, acc in xmm4 (strict) or xmm5+xmm4 (fast)
    if fast {
        ts_x64_xorps(cb, 4, 4)
    }
    loop4 := cb.len()
    x64_cmp_imm8(cb, X_RCX, 4)
    to_tail := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RSI, 0)
    ts_x64_movups_ld(cb, 1, X_RDX, 0)
    ts_x64_addps(cb, 0, 1)
    if write_dst {
        ts_x64_movups_st(cb, 0, X_RDI, 0)
        ts_x64_add_imm(cb, X_RDI, 16)
    }
    ts_x64_mulps(cb, 0, 0)
    if fast {
        ts_x64_addps(cb, 4, 0)
    } else {
        ts_x64_serial_sum_xmm0(cb, 4)
    }
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_add_imm(cb, X_RDX, 16)
    ts_x64_sub_imm(cb, X_RCX, 4)
    ts_x64_jmp_back(cb, loop4)

    ts_x64_patch_rel32(cb, to_tail)
    if fast {
        ts_x64_hsum_xmm(cb, 4)
        ts_x64_addss(cb, 5, 4)
    }
    tail := cb.len()
    x64_test(cb, X_RCX)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RSI, 0)
    ts_x64_movss_ld(cb, 1, X_RDX, 0)
    ts_x64_addss(cb, 0, 1)
    if write_dst {
        ts_x64_movss_st(cb, 0, X_RDI, 0)
        ts_x64_add_imm(cb, X_RDI, 4)
    }
    ts_x64_mulss(cb, 0, 0)
    if fast {
        ts_x64_addss(cb, 5, 0)
    } else {
        ts_x64_addss(cb, 4, 0)
    }
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_sub_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, tail)

    ts_x64_patch_rel32(cb, done)
    if fast {
        ts_x64_movd_from_xmm(cb, X_RAX, 5)
    } else {
        ts_x64_movd_from_xmm(cb, X_RAX, 4)
    }
    x64_ret(cb)
}

fn ts_x64_emit_add_sqsum(cb $&mc.CodeBuffer, fast bool) {
    // (dst=rdi, x=rsi, skip=rdx, n=rcx, acc_bits=r8) -> rax
    x64_test(cb, X_RCX)
    positive := ts_x64_jcc_fwd(cb, CC_G)
    x64_mov(cb, X_RAX, X_R8)
    x64_ret(cb)

    ts_x64_patch_rel32(cb, positive)
    if fast {
        ts_x64_movd_to_xmm(cb, 5, X_R8)
    } else {
        ts_x64_movd_to_xmm(cb, 4, X_R8)
    }
    x64_test(cb, X_RDI)
    no_dst := ts_x64_jcc_fwd(cb, CC_E)
    ts_x64_emit_add_sqsum_arm(cb, true, fast)
    ts_x64_patch_rel32(cb, no_dst)
    ts_x64_emit_add_sqsum_arm(cb, false, fast)
}

fn ts_x64_emit_norm_arm(cb $&mc.CodeBuffer, weighted bool) {
    // dst=rdi, src=rsi, weight=rdx, xmm3=broadcast(scale), n=r8
    loop4 := cb.len()
    x64_cmp_imm8(cb, X_R8, 4)
    to_tail := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RSI, 0)
    ts_x64_mulps(cb, 0, 3)
    if weighted {
        ts_x64_movups_ld(cb, 1, X_RDX, 0)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_add_imm(cb, X_RDX, 16)
    }
    ts_x64_movups_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_sub_imm(cb, X_R8, 4)
    ts_x64_jmp_back(cb, loop4)

    ts_x64_patch_rel32(cb, to_tail)
    tail := cb.len()
    x64_test(cb, X_R8)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RSI, 0)
    ts_x64_mulss(cb, 0, 3)
    if weighted {
        ts_x64_movss_ld(cb, 1, X_RDX, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_add_imm(cb, X_RDX, 4)
    }
    ts_x64_movss_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_sub_imm(cb, X_R8, 1)
    ts_x64_jmp_back(cb, tail)

    ts_x64_patch_rel32(cb, done)
    x64_ret(cb)
}

fn ts_x64_emit_norm(cb $&mc.CodeBuffer) {
    // (dst=rdi, src=rsi, weight=rdx, scale_bits=rcx, n=r8)
    x64_test(cb, X_R8)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movd_to_xmm(cb, 3, X_RCX)
    ts_x64_shufps(cb, 3, 3, 0x00)
    x64_test(cb, X_RDX)
    weighted := ts_x64_jcc_fwd(cb, CC_NE)
    ts_x64_emit_norm_arm(cb, false)
    ts_x64_patch_rel32(cb, weighted)
    ts_x64_emit_norm_arm(cb, true)
    ts_x64_patch_rel32(cb, done_early)
    x64_ret(cb)
}

fn ts_x64_emit_dot(cb $&mc.CodeBuffer, fast bool) {
    // (a=rdi, b=rsi, n=rdx, acc_bits=rcx) -> rax
    x64_test(cb, X_RDX)
    positive := ts_x64_jcc_fwd(cb, CC_G)
    x64_mov(cb, X_RAX, X_RCX)
    x64_ret(cb)

    ts_x64_patch_rel32(cb, positive)
    if !fast {
        ts_x64_movd_to_xmm(cb, 4, X_RCX)
        loop4 := cb.len()
        x64_cmp_imm8(cb, X_RDX, 4)
        to_tail := ts_x64_jcc_fwd(cb, CC_L)
        ts_x64_movups_ld(cb, 0, X_RDI, 0)
        ts_x64_movups_ld(cb, 1, X_RSI, 0)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_serial_sum_xmm0(cb, 4)
        ts_x64_add_imm(cb, X_RDI, 16)
        ts_x64_add_imm(cb, X_RSI, 16)
        ts_x64_sub_imm(cb, X_RDX, 4)
        ts_x64_jmp_back(cb, loop4)

        ts_x64_patch_rel32(cb, to_tail)
        tail := cb.len()
        x64_test(cb, X_RDX)
        done := ts_x64_jcc_fwd(cb, CC_LE)
        ts_x64_movss_ld(cb, 0, X_RDI, 0)
        ts_x64_movss_ld(cb, 1, X_RSI, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_addss(cb, 4, 0)
        ts_x64_add_imm(cb, X_RDI, 4)
        ts_x64_add_imm(cb, X_RSI, 4)
        ts_x64_sub_imm(cb, X_RDX, 1)
        ts_x64_jmp_back(cb, tail)

        ts_x64_patch_rel32(cb, done)
        ts_x64_movd_from_xmm(cb, X_RAX, 4)
        x64_ret(cb)
        <<
    }

    // Fast 8-wide SSE using only caller-saved xmm0..xmm5.
    ts_x64_movd_to_xmm(cb, 5, X_RCX)
    ts_x64_xorps(cb, 3, 3)
    ts_x64_xorps(cb, 4, 4)

    loop8 := cb.len()
    x64_cmp_imm8(cb, X_RDX, 8)
    to_loop4 := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RDI, 0)
    ts_x64_movups_ld(cb, 1, X_RSI, 0)
    ts_x64_mulps(cb, 0, 1)
    ts_x64_addps(cb, 3, 0)
    ts_x64_movups_ld(cb, 0, X_RDI, 16)
    ts_x64_movups_ld(cb, 1, X_RSI, 16)
    ts_x64_mulps(cb, 0, 1)
    ts_x64_addps(cb, 4, 0)
    ts_x64_add_imm(cb, X_RDI, 32)
    ts_x64_add_imm(cb, X_RSI, 32)
    ts_x64_sub_imm(cb, X_RDX, 8)
    ts_x64_jmp_back(cb, loop8)

    ts_x64_patch_rel32(cb, to_loop4)
    loop4 := cb.len()
    x64_cmp_imm8(cb, X_RDX, 4)
    fold := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RDI, 0)
    ts_x64_movups_ld(cb, 1, X_RSI, 0)
    ts_x64_mulps(cb, 0, 1)
    ts_x64_addps(cb, 3, 0)
    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_sub_imm(cb, X_RDX, 4)
    ts_x64_jmp_back(cb, loop4)

    ts_x64_patch_rel32(cb, fold)
    ts_x64_addps(cb, 3, 4)
    ts_x64_hsum_xmm(cb, 3)
    ts_x64_addss(cb, 5, 3)

    tail := cb.len()
    x64_test(cb, X_RDX)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RDI, 0)
    ts_x64_movss_ld(cb, 1, X_RSI, 0)
    ts_x64_mulss(cb, 0, 1)
    ts_x64_addss(cb, 5, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_sub_imm(cb, X_RDX, 1)
    ts_x64_jmp_back(cb, tail)

    ts_x64_patch_rel32(cb, done)
    ts_x64_movd_from_xmm(cb, X_RAX, 5)
    x64_ret(cb)
}

fn ts_x64_emit_axpy(cb $&mc.CodeBuffer) {
    // (dst=rdi, src=rsi, scale_bits=rdx, n=rcx)
    x64_test(cb, X_RCX)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movd_to_xmm(cb, 2, X_RDX)
    ts_x64_shufps(cb, 2, 2, 0x00)

    loop4 := cb.len()
    x64_cmp_imm8(cb, X_RCX, 4)
    to_tail := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RDI, 0)
    ts_x64_movups_ld(cb, 1, X_RSI, 0)
    ts_x64_mulps(cb, 1, 2)
    ts_x64_addps(cb, 0, 1)
    ts_x64_movups_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_sub_imm(cb, X_RCX, 4)
    ts_x64_jmp_back(cb, loop4)

    ts_x64_patch_rel32(cb, to_tail)
    tail := cb.len()
    x64_test(cb, X_RCX)
    done_tail := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RDI, 0)
    ts_x64_movss_ld(cb, 1, X_RSI, 0)
    ts_x64_mulss(cb, 1, 2)
    ts_x64_addss(cb, 0, 1)
    ts_x64_movss_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_sub_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, tail)

    ts_x64_patch_rel32(cb, done_early)
    ts_x64_patch_rel32(cb, done_tail)
    x64_ret(cb)
}

fn ts_x64_emit_vadd_inplace(cb $&mc.CodeBuffer) {
    // (dst=rdi, src=rsi, n=rdx)
    x64_test(cb, X_RDX)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)

    loop4 := cb.len()
    x64_cmp_imm8(cb, X_RDX, 4)
    to_tail := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RDI, 0)
    ts_x64_movups_ld(cb, 1, X_RSI, 0)
    ts_x64_addps(cb, 0, 1)
    ts_x64_movups_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_sub_imm(cb, X_RDX, 4)
    ts_x64_jmp_back(cb, loop4)

    ts_x64_patch_rel32(cb, to_tail)
    tail := cb.len()
    x64_test(cb, X_RDX)
    done_tail := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RDI, 0)
    ts_x64_movss_ld(cb, 1, X_RSI, 0)
    ts_x64_addss(cb, 0, 1)
    ts_x64_movss_st(cb, 0, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_sub_imm(cb, X_RDX, 1)
    ts_x64_jmp_back(cb, tail)

    ts_x64_patch_rel32(cb, done_early)
    ts_x64_patch_rel32(cb, done_tail)
    x64_ret(cb)
}

fn ts_x64_emit_dot_q4_0(cb $&mc.CodeBuffer, fast bool) {
    // (qs=rdi, scales=rsi, x=rdx, n_blocks=rcx, acc_bits=r8) -> rax
    x64_test(cb, X_RCX)
    positive := ts_x64_jcc_fwd(cb, CC_G)
    x64_mov(cb, X_RAX, X_R8)
    x64_ret(cb)

    ts_x64_patch_rel32(cb, positive)
    ts_x64_movd_to_xmm(cb, 5, X_R8)
    ts_x64_pcmpeqd(cb, 3, 3)
    ts_x64_psrld_imm(cb, 3, 31)
    ts_x64_pslld_imm(cb, 3, 3)

    loop_blk := cb.len()
    x64_test(cb, X_RCX)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_xorps(cb, 4, 4)

    for q in 0:4 {
        q_disp := q * 4
        x_lo := q * 16
        x_hi := 64 + q * 16
        ts_x64_movd_ld(cb, 0, X_RDI, q_disp)
        ts_x64_punpcklbw(cb, 0, 0)
        ts_x64_punpcklwd(cb, 0, 0)
        ts_x64_movaps(cb, 1, 0)

        ts_x64_pslld_imm(cb, 0, 28)
        ts_x64_psrld_imm(cb, 0, 28)
        ts_x64_psubd(cb, 0, 3)
        ts_x64_cvtdq2ps(cb, 0, 0)
        ts_x64_movups_ld(cb, 2, X_RDX, x_lo)
        ts_x64_mulps(cb, 0, 2)

        ts_x64_pslld_imm(cb, 1, 24)
        ts_x64_psrld_imm(cb, 1, 28)
        ts_x64_psubd(cb, 1, 3)
        ts_x64_cvtdq2ps(cb, 1, 1)
        ts_x64_movups_ld(cb, 2, X_RDX, x_hi)
        ts_x64_mulps(cb, 1, 2)

        ts_x64_addps(cb, 0, 1)
        if fast {
            ts_x64_addps(cb, 4, 0)
        } else {
            ts_x64_serial_sum_xmm0(cb, 4)
        }
    }

    if fast {
        ts_x64_hsum_xmm(cb, 4)
    }
    ts_x64_movss_ld(cb, 0, X_RSI, 0)
    ts_x64_mulss(cb, 4, 0)
    ts_x64_addss(cb, 5, 4)

    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_add_imm32(cb, X_RDX, 128)
    ts_x64_sub_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, loop_blk)

    ts_x64_patch_rel32(cb, done)
    ts_x64_movd_from_xmm(cb, X_RAX, 5)
    x64_ret(cb)
}

fn ts_x64_emit_gemv4_f32(cb $&mc.CodeBuffer, fast bool) {
    // (out=rdi, w=rsi, x=rdx, rows=rcx, cols=r8)
    x64_test(cb, X_RCX)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    x64_mov(cb, X_R9, X_RDX)

    row_loop := cb.len()
    x64_test(cb, X_RCX)
    done_rows := ts_x64_jcc_fwd(cb, CC_LE)
    x64_mov(cb, X_RDX, X_R9)
    x64_mov(cb, X_R10, X_R8)
    ts_x64_xorps(cb, 5, 5)

    if !fast {
        loop4 := cb.len()
        x64_cmp_imm8(cb, X_R10, 4)
        to_tail := ts_x64_jcc_fwd(cb, CC_L)
        ts_x64_movups_ld(cb, 0, X_RSI, 0)
        ts_x64_movups_ld(cb, 1, X_RDX, 0)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_serial_sum_xmm0(cb, 5)
        ts_x64_add_imm(cb, X_RSI, 16)
        ts_x64_add_imm(cb, X_RDX, 16)
        ts_x64_sub_imm(cb, X_R10, 4)
        ts_x64_jmp_back(cb, loop4)

        ts_x64_patch_rel32(cb, to_tail)
        tail := cb.len()
        x64_test(cb, X_R10)
        to_st := ts_x64_jcc_fwd(cb, CC_LE)
        ts_x64_movss_ld(cb, 0, X_RSI, 0)
        ts_x64_movss_ld(cb, 1, X_RDX, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_addss(cb, 5, 0)
        ts_x64_add_imm(cb, X_RSI, 4)
        ts_x64_add_imm(cb, X_RDX, 4)
        ts_x64_sub_imm(cb, X_R10, 1)
        ts_x64_jmp_back(cb, tail)
        ts_x64_patch_rel32(cb, to_st)
    } else {
        ts_x64_xorps(cb, 3, 3)
        ts_x64_xorps(cb, 4, 4)
        loop8 := cb.len()
        x64_cmp_imm8(cb, X_R10, 8)
        to_l4 := ts_x64_jcc_fwd(cb, CC_L)
        ts_x64_movups_ld(cb, 0, X_RSI, 0)
        ts_x64_movups_ld(cb, 1, X_RDX, 0)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_addps(cb, 3, 0)
        ts_x64_movups_ld(cb, 0, X_RSI, 16)
        ts_x64_movups_ld(cb, 1, X_RDX, 16)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_addps(cb, 4, 0)
        ts_x64_add_imm(cb, X_RSI, 32)
        ts_x64_add_imm(cb, X_RDX, 32)
        ts_x64_sub_imm(cb, X_R10, 8)
        ts_x64_jmp_back(cb, loop8)

        ts_x64_patch_rel32(cb, to_l4)
        loop4 := cb.len()
        x64_cmp_imm8(cb, X_R10, 4)
        fold := ts_x64_jcc_fwd(cb, CC_L)
        ts_x64_movups_ld(cb, 0, X_RSI, 0)
        ts_x64_movups_ld(cb, 1, X_RDX, 0)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_addps(cb, 3, 0)
        ts_x64_add_imm(cb, X_RSI, 16)
        ts_x64_add_imm(cb, X_RDX, 16)
        ts_x64_sub_imm(cb, X_R10, 4)
        ts_x64_jmp_back(cb, loop4)

        ts_x64_patch_rel32(cb, fold)
        ts_x64_addps(cb, 3, 4)
        ts_x64_hsum_xmm(cb, 3)
        ts_x64_addss(cb, 5, 3)

        tail := cb.len()
        x64_test(cb, X_R10)
        to_st := ts_x64_jcc_fwd(cb, CC_LE)
        ts_x64_movss_ld(cb, 0, X_RSI, 0)
        ts_x64_movss_ld(cb, 1, X_RDX, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_addss(cb, 5, 0)
        ts_x64_add_imm(cb, X_RSI, 4)
        ts_x64_add_imm(cb, X_RDX, 4)
        ts_x64_sub_imm(cb, X_R10, 1)
        ts_x64_jmp_back(cb, tail)
        ts_x64_patch_rel32(cb, to_st)
    }

    ts_x64_movss_st(cb, 5, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_sub_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, row_loop)

    ts_x64_patch_rel32(cb, done)
    ts_x64_patch_rel32(cb, done_rows)
    x64_ret(cb)
}

// Compute 32-weight Q4_0 x Q8_0 integer block sum into xmm4 as f32.
// Preserves xmm3 ([8]*8 i16) and xmm5 (running f32 acc).
fn ts_x64_q4_q8_block(cb $&mc.CodeBuffer, q_base int, xq_base int) {
    ts_x64_xorps(cb, 4, 4)
    for half in 0:2 {
        q_disp := half * 8
        x_lo := half * 8
        x_hi := 16 + half * 8
        ts_x64_movq_ld(cb, 0, q_base, q_disp)
        ts_x64_punpcklbw(cb, 0, 0)
        ts_x64_movaps(cb, 1, 0)

        ts_x64_psllw_imm(cb, 0, 12)
        ts_x64_psrlw_imm(cb, 0, 12)
        ts_x64_psubw(cb, 0, 3)
        ts_x64_movq_ld(cb, 2, xq_base, x_lo)
        ts_x64_punpcklbw(cb, 2, 2)
        ts_x64_psraw_imm(cb, 2, 8)
        ts_x64_pmaddwd(cb, 0, 2)
        ts_x64_paddd(cb, 4, 0)

        ts_x64_psllw_imm(cb, 1, 8)
        ts_x64_psrlw_imm(cb, 1, 12)
        ts_x64_psubw(cb, 1, 3)
        ts_x64_movq_ld(cb, 2, xq_base, x_hi)
        ts_x64_punpcklbw(cb, 2, 2)
        ts_x64_psraw_imm(cb, 2, 8)
        ts_x64_pmaddwd(cb, 1, 2)
        ts_x64_paddd(cb, 4, 1)
    }
    ts_x64_pshufd(cb, 0, 4, 0x4E)
    ts_x64_paddd(cb, 4, 0)
    ts_x64_pshufd(cb, 0, 4, 0x01)
    ts_x64_paddd(cb, 4, 0)
    ts_x64_cvtdq2ps(cb, 4, 4)
}

fn ts_x64_emit_dot_q4_0_q8_0(cb $&mc.CodeBuffer) {
    // (qs=rdi, ws=rsi, xq=rdx, xs=rcx, n_blocks=r8, acc_bits=r9) -> rax
    x64_test(cb, X_R8)
    positive := ts_x64_jcc_fwd(cb, CC_G)
    x64_mov(cb, X_RAX, X_R9)
    x64_ret(cb)

    ts_x64_patch_rel32(cb, positive)
    ts_x64_movd_to_xmm(cb, 5, X_R9)
    ts_x64_pcmpeqd(cb, 3, 3)
    ts_x64_psrlw_imm(cb, 3, 15)
    ts_x64_psllw_imm(cb, 3, 3)

    loop_blk := cb.len()
    x64_test(cb, X_R8)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_q4_q8_block(cb, X_RDI, X_RDX)
    ts_x64_movss_ld(cb, 0, X_RSI, 0)
    ts_x64_movss_ld(cb, 1, X_RCX, 0)
    ts_x64_mulss(cb, 0, 1)
    ts_x64_mulss(cb, 4, 0)
    ts_x64_addss(cb, 5, 4)
    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_add_imm(cb, X_RDX, 32)
    ts_x64_add_imm(cb, X_RCX, 4)
    ts_x64_sub_imm(cb, X_R8, 1)
    ts_x64_jmp_back(cb, loop_blk)

    ts_x64_patch_rel32(cb, done)
    ts_x64_movd_from_xmm(cb, X_RAX, 5)
    x64_ret(cb)
}

fn ts_x64_emit_gemv4_q4_0_q8_0(cb $&mc.CodeBuffer) {
    // (out=rdi, qs=rsi, ws=rdx, xq=rcx, xs=r8, packed_dims=(rows<<32)|n_blocks in r9)
    ts_x64_mov32_rr(cb, X_R10, X_R9)
    ts_x64_shr_imm(cb, X_R9, 32)
    x64_test(cb, X_R9)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_pcmpeqd(cb, 3, 3)
    ts_x64_psrlw_imm(cb, 3, 15)
    ts_x64_psllw_imm(cb, 3, 3)

    row_loop := cb.len()
    x64_test(cb, X_R9)
    done_rows := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_xorps(cb, 5, 5)
    x64_mov(cb, X_RAX, X_R10)

    blk_loop := cb.len()
    x64_test(cb, X_RAX)
    blk_done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_q4_q8_block(cb, X_RSI, X_RCX)
    ts_x64_movss_ld(cb, 0, X_RDX, 0)
    ts_x64_movss_ld(cb, 1, X_R8, 0)
    ts_x64_mulss(cb, 0, 1)
    ts_x64_mulss(cb, 4, 0)
    ts_x64_addss(cb, 5, 4)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_add_imm(cb, X_RCX, 32)
    ts_x64_add_imm(cb, X_R8, 4)
    ts_x64_sub_imm(cb, X_RAX, 1)
    ts_x64_jmp_back(cb, blk_loop)

    ts_x64_patch_rel32(cb, blk_done)
    ts_x64_movss_st(cb, 5, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    x64_mov(cb, X_R11, X_R10)
    ts_x64_shl_imm(cb, X_R11, 5)
    ts_x64_sub_rr(cb, X_RCX, X_R11)
    x64_mov(cb, X_R11, X_R10)
    ts_x64_shl_imm(cb, X_R11, 2)
    ts_x64_sub_rr(cb, X_R8, X_R11)
    ts_x64_sub_imm(cb, X_R9, 1)
    ts_x64_jmp_back(cb, row_loop)

    ts_x64_patch_rel32(cb, done_early)
    ts_x64_patch_rel32(cb, done_rows)
    x64_ret(cb)
}

fn ts_x64_jmp_fwd(cb $&mc.CodeBuffer) int {
    xb(cb, 0xE9)
    cb.emit_u32_le(0)
    << cb.len()
}

fn ts_x64_movdqu_ld(cb $&mc.CodeBuffer, xd int, base int, disp int) {
    xb(cb, 0xF3)
    x64_rex(cb, false, xd, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x6F)
    x64_modrm_mem(cb, xd, base, disp)
}

fn ts_x64_punpckhbw(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x68)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_andps_mem(cb $&mc.CodeBuffer, xd int, base int, disp int) {
    x64_rex(cb, false, xd, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x54)
    x64_modrm_mem(cb, xd, base, disp)
}

fn ts_x64_maxps(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x0F)
    xb(cb, 0x5F)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_cvtss2sd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF3)
    xb(cb, 0x0F)
    xb(cb, 0x5A)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_cvtsd2ss(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF2)
    xb(cb, 0x0F)
    xb(cb, 0x5A)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_mulsd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF2)
    xb(cb, 0x0F)
    xb(cb, 0x59)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_divsd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF2)
    xb(cb, 0x0F)
    xb(cb, 0x5E)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_addsd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF2)
    xb(cb, 0x0F)
    xb(cb, 0x58)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_subsd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF2)
    xb(cb, 0x0F)
    xb(cb, 0x5C)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_ucomisd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x2E)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_xorpd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x57)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_cvttsd2si(cb $&mc.CodeBuffer, rd int, xs int) {
    xb(cb, 0xF2)
    x64_rex(cb, false, rd, xs, false)
    xb(cb, 0x0F)
    xb(cb, 0x2C)
    x64_modrm_rr(cb, rd, xs)
}

fn ts_x64_movq_to_xmm(cb $&mc.CodeBuffer, xd int, rs int) {
    xb(cb, 0x66)
    x64_rex(cb, true, xd, rs, false)
    xb(cb, 0x0F)
    xb(cb, 0x6E)
    x64_modrm_rr(cb, xd, rs)
}

fn ts_x64_movb_al_st(cb $&mc.CodeBuffer, base int, disp int) {
    if base >= 8 { x64_rex(cb, false, 0, base, false) }
    xb(cb, 0x88)
    x64_modrm_mem(cb, 0, base, disp)
}

fn ts_x64_add_rr(cb $&mc.CodeBuffer, rd int, rs int) {
    x64_op_rr(cb, 0x01, rs, rd)
}

fn ts_x64_and_rr(cb $&mc.CodeBuffer, rd int, rs int) {
    x64_op_rr(cb, 0x21, rs, rd)
}

fn ts_x64_neg(cb $&mc.CodeBuffer, r int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0xF7)
    x64_modrm_rr(cb, 3, r)
}

fn ts_x64_emit_quantize_q8_0(cb $&mc.CodeBuffer) {
    // (x=rdi, xq=rsi, xs=rdx, nb=rcx)
    x64_test(cb, X_RCX)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)

    ts_x64_sub_imm(cb, X_RSP, 64)
    x64_mov_imm(cb, X_RAX, 0x7fffffff7fffffff)
    x64_str(cb, X_RAX, X_RSP, 32)
    x64_str(cb, X_RAX, X_RSP, 40)
    x64_mov_imm(cb, X_RAX, 0x405fc00000000000) // 127.0
    x64_str(cb, X_RAX, X_RSP, 48)
    x64_mov_imm(cb, X_RAX, 0x3fe0000000000000) // 0.5
    x64_str(cb, X_RAX, X_RSP, 56)

    blk_loop := cb.len()
    x64_test(cb, X_RCX)
    done := ts_x64_jcc_fwd(cb, CC_LE)

    ts_x64_xorps(cb, 0, 0)
    for k in 0:8 {
        ts_x64_movups_ld(cb, 1, X_RDI, k * 16)
        ts_x64_andps_mem(cb, 1, X_RSP, 32)
        ts_x64_maxps(cb, 0, 1)
    }
    ts_x64_movaps(cb, 1, 0)
    ts_x64_shufps(cb, 1, 1, 0x4E)
    ts_x64_maxps(cb, 0, 1)
    ts_x64_movaps(cb, 1, 0)
    ts_x64_shufps(cb, 1, 1, 0x01)
    ts_x64_maxps(cb, 0, 1)

    ts_x64_cvtss2sd(cb, 0, 0)
    x64_ldr(cb, X_RAX, X_RSP, 48)
    ts_x64_movq_to_xmm(cb, 1, X_RAX)
    ts_x64_divsd(cb, 0, 1)
    ts_x64_cvtsd2ss(cb, 0, 0)
    ts_x64_movss_st(cb, 0, X_RDX, 0)
    ts_x64_cvtss2sd(cb, 0, 0)

    ts_x64_xorpd(cb, 3, 3)
    ts_x64_ucomisd(cb, 0, 3)
    is_zero := ts_x64_jcc_fwd(cb, CC_E)
    x64_mov_imm(cb, X_RAX, 0x3ff0000000000000) // 1.0
    ts_x64_movq_to_xmm(cb, 2, X_RAX)
    ts_x64_divsd(cb, 2, 0)
    have_inv := ts_x64_jmp_fwd(cb)
    ts_x64_patch_rel32(cb, is_zero)
    ts_x64_xorpd(cb, 2, 2)
    ts_x64_patch_rel32(cb, have_inv)

    x64_ldr(cb, X_RAX, X_RSP, 56)
    ts_x64_movq_to_xmm(cb, 4, X_RAX) // 0.5
    ts_x64_xorpd(cb, 3, 3)            // 0.0

    x64_mov_imm(cb, X_R8, 32)
    elem_loop := cb.len()
    x64_test(cb, X_R8)
    elem_done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RDI, 0)
    ts_x64_cvtss2sd(cb, 0, 0)
    ts_x64_mulsd(cb, 0, 2)
    ts_x64_ucomisd(cb, 0, 3)
    is_neg := ts_x64_jcc_fwd(cb, CC_B)
    ts_x64_addsd(cb, 0, 4)
    ts_x64_cvttsd2si(cb, X_RAX, 0)
    got_q := ts_x64_jmp_fwd(cb)
    ts_x64_patch_rel32(cb, is_neg)
    ts_x64_movaps(cb, 1, 4)
    ts_x64_subsd(cb, 1, 0)
    ts_x64_cvttsd2si(cb, X_RAX, 1)
    ts_x64_neg(cb, X_RAX)
    ts_x64_patch_rel32(cb, got_q)
    x64_cmp_imm8(cb, X_RAX, 127)
    ok_hi := ts_x64_jcc_fwd(cb, CC_LE)
    x64_mov_imm(cb, X_RAX, 127)
    ts_x64_patch_rel32(cb, ok_hi)
    x64_cmp_imm8(cb, X_RAX, -127)
    ok_lo := ts_x64_jcc_fwd(cb, CC_GE)
    x64_mov_imm(cb, X_RAX, -127)
    ts_x64_patch_rel32(cb, ok_lo)
    ts_x64_movb_al_st(cb, X_RSI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 1)
    ts_x64_sub_imm(cb, X_R8, 1)
    ts_x64_jmp_back(cb, elem_loop)

    ts_x64_patch_rel32(cb, elem_done)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_sub_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, blk_loop)

    ts_x64_patch_rel32(cb, done)
    ts_x64_add_imm(cb, X_RSP, 64)
    ts_x64_patch_rel32(cb, done_early)
    x64_ret(cb)
}

fn ts_x64_q8_q8_block(cb $&mc.CodeBuffer, w_base int, xq_base int) {
    ts_x64_xorps(cb, 4, 4)
    for half in 0:2 {
        disp := half * 16
        ts_x64_movdqu_ld(cb, 0, w_base, disp)
        ts_x64_movdqu_ld(cb, 1, xq_base, disp)
        ts_x64_movaps(cb, 2, 0)
        ts_x64_movaps(cb, 3, 1)
        ts_x64_punpcklbw(cb, 0, 0)
        ts_x64_psraw_imm(cb, 0, 8)
        ts_x64_punpcklbw(cb, 1, 1)
        ts_x64_psraw_imm(cb, 1, 8)
        ts_x64_pmaddwd(cb, 0, 1)
        ts_x64_paddd(cb, 4, 0)

        ts_x64_punpckhbw(cb, 2, 2)
        ts_x64_psraw_imm(cb, 2, 8)
        ts_x64_punpckhbw(cb, 3, 3)
        ts_x64_psraw_imm(cb, 3, 8)
        ts_x64_pmaddwd(cb, 2, 3)
        ts_x64_paddd(cb, 4, 2)
    }
    ts_x64_pshufd(cb, 0, 4, 0x4E)
    ts_x64_paddd(cb, 4, 0)
    ts_x64_pshufd(cb, 0, 4, 0x01)
    ts_x64_paddd(cb, 4, 0)
    ts_x64_cvtdq2ps(cb, 4, 4)
}

fn ts_x64_emit_gemv4_q8_0_q8_0(cb $&mc.CodeBuffer) {
    // (out=rdi, w_qs=rsi, w_scales=rdx, xq=rcx, xs=r8, packed=(rows<<32)|nb in r9)
    ts_x64_mov32_rr(cb, X_R10, X_R9)
    ts_x64_shr_imm(cb, X_R9, 32)
    x64_test(cb, X_R9)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)

    row_loop := cb.len()
    x64_test(cb, X_R9)
    done_rows := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_xorps(cb, 5, 5)
    x64_mov(cb, X_RAX, X_R10)

    blk_loop := cb.len()
    x64_test(cb, X_RAX)
    blk_done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_q8_q8_block(cb, X_RSI, X_RCX)
    ts_x64_movss_ld(cb, 0, X_RDX, 0)
    ts_x64_movss_ld(cb, 1, X_R8, 0)
    ts_x64_mulss(cb, 0, 1)
    ts_x64_mulss(cb, 4, 0)
    ts_x64_addss(cb, 5, 4)
    ts_x64_add_imm(cb, X_RSI, 32)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_add_imm(cb, X_RCX, 32)
    ts_x64_add_imm(cb, X_R8, 4)
    ts_x64_sub_imm(cb, X_RAX, 1)
    ts_x64_jmp_back(cb, blk_loop)

    ts_x64_patch_rel32(cb, blk_done)
    ts_x64_movss_st(cb, 5, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    x64_mov(cb, X_R11, X_R10)
    ts_x64_shl_imm(cb, X_R11, 5)
    ts_x64_sub_rr(cb, X_RCX, X_R11)
    x64_mov(cb, X_R11, X_R10)
    ts_x64_shl_imm(cb, X_R11, 2)
    ts_x64_sub_rr(cb, X_R8, X_R11)
    ts_x64_sub_imm(cb, X_R9, 1)
    ts_x64_jmp_back(cb, row_loop)

    ts_x64_patch_rel32(cb, done_early)
    ts_x64_patch_rel32(cb, done_rows)
    x64_ret(cb)
}

fn ts_x64_emit_gemm4x4_f32(cb $&mc.CodeBuffer, fast bool) {
    // (out=rdi, w=rsi, x=rdx, M=rcx, N=r8, K=r9)
    x64_test(cb, X_RCX)
    early_m := ts_x64_jcc_fwd(cb, CC_LE)
    x64_test(cb, X_R8)
    early_n := ts_x64_jcc_fwd(cb, CC_LE)

    ts_x64_sub_imm(cb, X_RSP, 64)
    x64_str(cb, X_RSI, X_RSP, 0)  // w_base
    x64_str(cb, X_RDX, X_RSP, 8)  // x_cur
    x64_str(cb, X_RDI, X_RSP, 16) // out_cur
    x64_str(cb, X_RCX, X_RSP, 24) // M_rem
    x64_str(cb, X_R8, X_RSP, 32)  // N
    x64_str(cb, X_R9, X_RSP, 40)  // K

    m_loop := cb.len()
    x64_ldr(cb, X_RAX, X_RSP, 24)
    x64_test(cb, X_RAX)
    done_all := ts_x64_jcc_fwd(cb, CC_LE)

    x64_ldr(cb, X_RDI, X_RSP, 16)
    x64_ldr(cb, X_RSI, X_RSP, 0)
    x64_ldr(cb, X_RCX, X_RSP, 32) // r_rem = N

    row_loop := cb.len()
    x64_test(cb, X_RCX)
    rows_done := ts_x64_jcc_fwd(cb, CC_LE)
    x64_ldr(cb, X_RDX, X_RSP, 8)  // x_cur
    x64_ldr(cb, X_R10, X_RSP, 40) // k_rem = K
    ts_x64_xorps(cb, 5, 5)

    if !fast {
        loop4 := cb.len()
        x64_cmp_imm8(cb, X_R10, 4)
        to_tail := ts_x64_jcc_fwd(cb, CC_L)
        ts_x64_movups_ld(cb, 0, X_RSI, 0)
        ts_x64_movups_ld(cb, 1, X_RDX, 0)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_serial_sum_xmm0(cb, 5)
        ts_x64_add_imm(cb, X_RSI, 16)
        ts_x64_add_imm(cb, X_RDX, 16)
        ts_x64_sub_imm(cb, X_R10, 4)
        ts_x64_jmp_back(cb, loop4)

        ts_x64_patch_rel32(cb, to_tail)
        tail := cb.len()
        x64_test(cb, X_R10)
        to_st := ts_x64_jcc_fwd(cb, CC_LE)
        ts_x64_movss_ld(cb, 0, X_RSI, 0)
        ts_x64_movss_ld(cb, 1, X_RDX, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_addss(cb, 5, 0)
        ts_x64_add_imm(cb, X_RSI, 4)
        ts_x64_add_imm(cb, X_RDX, 4)
        ts_x64_sub_imm(cb, X_R10, 1)
        ts_x64_jmp_back(cb, tail)
        ts_x64_patch_rel32(cb, to_st)
    } else {
        ts_x64_xorps(cb, 3, 3)
        loop4 := cb.len()
        x64_cmp_imm8(cb, X_R10, 4)
        fold := ts_x64_jcc_fwd(cb, CC_L)
        ts_x64_movups_ld(cb, 0, X_RSI, 0)
        ts_x64_movups_ld(cb, 1, X_RDX, 0)
        ts_x64_mulps(cb, 0, 1)
        ts_x64_addps(cb, 3, 0)
        ts_x64_add_imm(cb, X_RSI, 16)
        ts_x64_add_imm(cb, X_RDX, 16)
        ts_x64_sub_imm(cb, X_R10, 4)
        ts_x64_jmp_back(cb, loop4)

        ts_x64_patch_rel32(cb, fold)
        ts_x64_hsum_xmm(cb, 3)
        ts_x64_addss(cb, 5, 3)

        tail := cb.len()
        x64_test(cb, X_R10)
        to_st := ts_x64_jcc_fwd(cb, CC_LE)
        ts_x64_movss_ld(cb, 0, X_RSI, 0)
        ts_x64_movss_ld(cb, 1, X_RDX, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_addss(cb, 5, 0)
        ts_x64_add_imm(cb, X_RSI, 4)
        ts_x64_add_imm(cb, X_RDX, 4)
        ts_x64_sub_imm(cb, X_R10, 1)
        ts_x64_jmp_back(cb, tail)
        ts_x64_patch_rel32(cb, to_st)
    }

    ts_x64_movss_st(cb, 5, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_sub_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, row_loop)

    ts_x64_patch_rel32(cb, rows_done)
    x64_ldr(cb, X_RAX, X_RSP, 40)
    ts_x64_shl_imm(cb, X_RAX, 2)
    x64_ldr(cb, X_RDX, X_RSP, 8)
    ts_x64_add_rr(cb, X_RDX, X_RAX)
    x64_str(cb, X_RDX, X_RSP, 8)

    x64_ldr(cb, X_RAX, X_RSP, 32)
    ts_x64_shl_imm(cb, X_RAX, 2)
    x64_ldr(cb, X_RDI, X_RSP, 16)
    ts_x64_add_rr(cb, X_RDI, X_RAX)
    x64_str(cb, X_RDI, X_RSP, 16)

    x64_ldr(cb, X_RAX, X_RSP, 24)
    ts_x64_sub_imm(cb, X_RAX, 1)
    x64_str(cb, X_RAX, X_RSP, 24)
    ts_x64_jmp_back(cb, m_loop)

    ts_x64_patch_rel32(cb, done_all)
    ts_x64_add_imm(cb, X_RSP, 64)
    ts_x64_patch_rel32(cb, early_m)
    ts_x64_patch_rel32(cb, early_n)
    x64_ret(cb)
}

fn ts_x64_emit_gemm4x4_q4_0_q8_0(cb $&mc.CodeBuffer) {
    // (out=rdi, qs=rsi, ws=rdx, xq=rcx, xs=r8, packed=(M<<42)|(N<<21)|nb in r9)
    x64_mov_imm(cb, X_R11, 0x1fffff)
    x64_mov(cb, X_R10, X_R9)
    ts_x64_and_rr(cb, X_R10, X_R11) // nb
    ts_x64_shr_imm(cb, X_R9, 21)
    x64_mov(cb, X_RAX, X_R9)
    ts_x64_and_rr(cb, X_RAX, X_R11) // N
    ts_x64_shr_imm(cb, X_R9, 21)
    ts_x64_and_rr(cb, X_R9, X_R11)  // M

    x64_test(cb, X_R9)
    early_m := ts_x64_jcc_fwd(cb, CC_LE)
    x64_test(cb, X_RAX)
    early_n := ts_x64_jcc_fwd(cb, CC_LE)

    ts_x64_sub_imm(cb, X_RSP, 64)
    x64_str(cb, X_RSI, X_RSP, 0)  // qs_base
    x64_str(cb, X_RDX, X_RSP, 8)  // ws_base
    x64_str(cb, X_RCX, X_RSP, 16) // xq_cur
    x64_str(cb, X_R8, X_RSP, 24)  // xs_cur
    x64_str(cb, X_RDI, X_RSP, 32) // out_cur
    x64_str(cb, X_R9, X_RSP, 40)  // M_rem
    x64_str(cb, X_RAX, X_RSP, 48) // N
    x64_str(cb, X_R10, X_RSP, 56) // nb

    ts_x64_pcmpeqd(cb, 3, 3)
    ts_x64_psrlw_imm(cb, 3, 15)
    ts_x64_psllw_imm(cb, 3, 3)

    m_loop := cb.len()
    x64_ldr(cb, X_RAX, X_RSP, 40)
    x64_test(cb, X_RAX)
    done_all := ts_x64_jcc_fwd(cb, CC_LE)

    x64_ldr(cb, X_RDI, X_RSP, 32)
    x64_ldr(cb, X_RSI, X_RSP, 0)
    x64_ldr(cb, X_RDX, X_RSP, 8)
    x64_ldr(cb, X_R9, X_RSP, 48) // r_rem = N

    row_loop := cb.len()
    x64_test(cb, X_R9)
    rows_done := ts_x64_jcc_fwd(cb, CC_LE)
    x64_ldr(cb, X_RCX, X_RSP, 16) // xq_cur
    x64_ldr(cb, X_R8, X_RSP, 24)  // xs_cur
    x64_ldr(cb, X_RAX, X_RSP, 56) // b_rem = nb
    ts_x64_xorps(cb, 5, 5)

    blk_loop := cb.len()
    x64_test(cb, X_RAX)
    blk_done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_q4_q8_block(cb, X_RSI, X_RCX)
    ts_x64_movss_ld(cb, 0, X_RDX, 0)
    ts_x64_movss_ld(cb, 1, X_R8, 0)
    ts_x64_mulss(cb, 0, 1)
    ts_x64_mulss(cb, 4, 0)
    ts_x64_addss(cb, 5, 4)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_add_imm(cb, X_RCX, 32)
    ts_x64_add_imm(cb, X_R8, 4)
    ts_x64_sub_imm(cb, X_RAX, 1)
    ts_x64_jmp_back(cb, blk_loop)

    ts_x64_patch_rel32(cb, blk_done)
    ts_x64_movss_st(cb, 5, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_sub_imm(cb, X_R9, 1)
    ts_x64_jmp_back(cb, row_loop)

    ts_x64_patch_rel32(cb, rows_done)
    x64_ldr(cb, X_RAX, X_RSP, 56) // nb
    x64_mov(cb, X_R11, X_RAX)
    ts_x64_shl_imm(cb, X_R11, 5)
    x64_ldr(cb, X_RCX, X_RSP, 16)
    ts_x64_add_rr(cb, X_RCX, X_R11)
    x64_str(cb, X_RCX, X_RSP, 16)

    ts_x64_shl_imm(cb, X_RAX, 2)
    x64_ldr(cb, X_R8, X_RSP, 24)
    ts_x64_add_rr(cb, X_R8, X_RAX)
    x64_str(cb, X_R8, X_RSP, 24)

    x64_ldr(cb, X_RAX, X_RSP, 48) // N
    ts_x64_shl_imm(cb, X_RAX, 2)
    x64_ldr(cb, X_RDI, X_RSP, 32)
    ts_x64_add_rr(cb, X_RDI, X_RAX)
    x64_str(cb, X_RDI, X_RSP, 32)

    x64_ldr(cb, X_RAX, X_RSP, 40)
    ts_x64_sub_imm(cb, X_RAX, 1)
    x64_str(cb, X_RAX, X_RSP, 40)
    ts_x64_jmp_back(cb, m_loop)

    ts_x64_patch_rel32(cb, done_all)
    ts_x64_add_imm(cb, X_RSP, 64)
    ts_x64_patch_rel32(cb, early_m)
    ts_x64_patch_rel32(cb, early_n)
    x64_ret(cb)
}

fn ts_x64_cvtsi2sd(cb $&mc.CodeBuffer, xd int, rs int) {
    xb(cb, 0xF2)
    x64_rex(cb, true, xd, rs, false)
    xb(cb, 0x0F)
    xb(cb, 0x2A)
    x64_modrm_rr(cb, xd, rs)
}

fn ts_x64_ucomiss(cb $&mc.CodeBuffer, xd int, xs int) {
    if xd >= 8 || xs >= 8 { x64_rex(cb, false, xd, xs, false) }
    xb(cb, 0x0F)
    xb(cb, 0x2E)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_load_f64(cb $&mc.CodeBuffer, xd int, s3 int, s2 int, s1 int, s0 int) {
    hi := ((s3 & 0xffff) << 48) | ((s2 & 0xffff) << 32) | ((s1 & 0xffff) << 16) | (s0 & 0xffff)
    x64_mov_imm(cb, X_RAX, hi)
    ts_x64_movq_to_xmm(cb, xd, X_RAX)
}

fn ts_x64_emit_swiglu(cb $&mc.CodeBuffer) {
    // (dst=rdi, gate=rsi, up=rdx, n=rcx)
    x64_test(cb, X_RCX)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_sub_imm(cb, X_RSP, 112)
    ts_x64_load_f64(cb, 0, 0x3FF7, 0x1547, 0x652B, 0x82FE) // [0] invln2
    x64_str(cb, X_RAX, X_RSP, 0)
    ts_x64_load_f64(cb, 0, 0x3FE6, 0x2E42, 0xFEFA, 0x39EF) // [8] ln2_hi
    x64_str(cb, X_RAX, X_RSP, 8)
    ts_x64_load_f64(cb, 0, 0x3C7A, 0xBC9E, 0x3B39, 0x803F) // [16] ln2_lo
    x64_str(cb, X_RAX, X_RSP, 16)
    ts_x64_load_f64(cb, 0, 0x3FF0, 0x0000, 0x0000, 0x0000) // [24] 1.0
    x64_str(cb, X_RAX, X_RSP, 24)
    ts_x64_load_f64(cb, 0, 0x3FE0, 0x0000, 0x0000, 0x0000) // [32] 0.5
    x64_str(cb, X_RAX, X_RSP, 32)
    ts_x64_load_f64(cb, 0, 0x3FC5, 0x5555, 0x5555, 0x5555) // [40] 1/6
    x64_str(cb, X_RAX, X_RSP, 40)
    ts_x64_load_f64(cb, 0, 0x3FA5, 0x5555, 0x5555, 0x5555) // [48] 1/24
    x64_str(cb, X_RAX, X_RSP, 48)
    ts_x64_load_f64(cb, 0, 0x3F81, 0x1111, 0x1111, 0x1111) // [56] 1/120
    x64_str(cb, X_RAX, X_RSP, 56)
    ts_x64_load_f64(cb, 0, 0x3F56, 0xC16C, 0x16C1, 0x6C17) // [64] 1/720
    x64_str(cb, X_RAX, X_RSP, 64)
    ts_x64_load_f64(cb, 0, 0x3F2A, 0x01A0, 0x1A01, 0xA01A) // [72] 1/5040
    x64_str(cb, X_RAX, X_RSP, 72)
    ts_x64_load_f64(cb, 0, 0x3EFA, 0x01A0, 0x1A01, 0xA01A) // [80] 1/40320
    x64_str(cb, X_RAX, X_RSP, 80)
    ts_x64_load_f64(cb, 0, 0x4086, 0x2000, 0x0000, 0x0000) // [88] 708.0
    x64_str(cb, X_RAX, X_RSP, 88)
    ts_x64_load_f64(cb, 0, 0xC086, 0x2000, 0x0000, 0x0000) // [96] -708.0
    x64_str(cb, X_RAX, X_RSP, 96)

    loop_i := cb.len()
    x64_test(cb, X_RCX)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 5, X_RSI, 0)
    ts_x64_cvtss2sd(cb, 5, 5) // xmm5 = g_d
    ts_x64_xorpd(cb, 0, 0)
    ts_x64_subsd(cb, 0, 5)    // xmm0 = y = -g_d

    x64_ldr(cb, X_RAX, X_RSP, 88)
    ts_x64_movq_to_xmm(cb, 1, X_RAX)
    ts_x64_ucomisd(cb, 0, 1)
    le_hi := ts_x64_jcc_fwd(cb, CC_BE)
    ts_x64_movaps(cb, 0, 1)
    ts_x64_patch_rel32(cb, le_hi)
    x64_ldr(cb, X_RAX, X_RSP, 96)
    ts_x64_movq_to_xmm(cb, 1, X_RAX)
    ts_x64_ucomisd(cb, 1, 0)
    ge_lo := ts_x64_jcc_fwd(cb, CC_BE)
    ts_x64_movaps(cb, 0, 1)
    ts_x64_patch_rel32(cb, ge_lo)

    x64_ldr(cb, X_RAX, X_RSP, 0)
    ts_x64_movq_to_xmm(cb, 1, X_RAX)
    ts_x64_mulsd(cb, 1, 0)    // y * invln2
    ts_x64_xorpd(cb, 2, 2)
    x64_ldr(cb, X_RAX, X_RSP, 32) // 0.5
    ts_x64_movq_to_xmm(cb, 3, X_RAX)
    ts_x64_ucomisd(cb, 1, 2)
    is_neg := ts_x64_jcc_fwd(cb, CC_B)
    ts_x64_addsd(cb, 1, 3)
    ts_x64_cvttsd2si(cb, X_RAX, 1)
    got_n := ts_x64_jmp_fwd(cb)
    ts_x64_patch_rel32(cb, is_neg)
    ts_x64_subsd(cb, 1, 3)
    ts_x64_cvttsd2si(cb, X_RAX, 1)
    ts_x64_patch_rel32(cb, got_n)

    ts_x64_cvtsi2sd(cb, 2, X_RAX) // nf
    x64_mov(cb, X_R8, X_RAX)      // save n
    x64_ldr(cb, X_RAX, X_RSP, 8)
    ts_x64_movq_to_xmm(cb, 3, X_RAX)
    ts_x64_mulsd(cb, 3, 2)
    ts_x64_subsd(cb, 0, 3)
    x64_ldr(cb, X_RAX, X_RSP, 16)
    ts_x64_movq_to_xmm(cb, 3, X_RAX)
    ts_x64_mulsd(cb, 3, 2)
    ts_x64_subsd(cb, 0, 3)        // xmm0 = r

    x64_ldr(cb, X_RAX, X_RSP, 80) // 1/8!
    ts_x64_movq_to_xmm(cb, 1, X_RAX)
    for off in [72, 64, 56, 48, 40, 32, 24, 24] {
        ts_x64_mulsd(cb, 1, 0)
        x64_ldr(cb, X_RAX, X_RSP, off)
        ts_x64_movq_to_xmm(cb, 2, X_RAX)
        ts_x64_addsd(cb, 1, 2)
    }
    ts_x64_add_imm32(cb, X_R8, 1023)
    ts_x64_shl_imm(cb, X_R8, 52)
    ts_x64_movq_to_xmm(cb, 2, X_R8)
    ts_x64_mulsd(cb, 1, 2)        // exp(-g)
    x64_ldr(cb, X_RAX, X_RSP, 24)
    ts_x64_movq_to_xmm(cb, 2, X_RAX)
    ts_x64_addsd(cb, 1, 2)        // 1 + exp(-g)
    ts_x64_divsd(cb, 5, 1)        // g / (1 + exp(-g))
    ts_x64_cvtsd2ss(cb, 5, 5)
    ts_x64_movss_ld(cb, 0, X_RDX, 0)
    ts_x64_mulss(cb, 5, 0)
    ts_x64_movss_st(cb, 5, X_RDI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_sub_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, loop_i)

    ts_x64_patch_rel32(cb, done)
    ts_x64_add_imm(cb, X_RSP, 112)
    ts_x64_patch_rel32(cb, done_early)
    x64_ret(cb)
}

fn ts_x64_cmp_rr(cb $&mc.CodeBuffer, rd int, rs int) {
    x64_op_rr(cb, 0x39, rs, rd)
}

fn ts_x64_emit_argmax_f32(cb $&mc.CodeBuffer) {
    // (x=rdi, n=rsi) -> best_idx in rax
    x64_mov_imm(cb, X_RAX, 0)
    x64_cmp_imm8(cb, X_RSI, 1)
    done_small := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 1, X_RDI, 0) // best_v = x[0]
    x64_mov_imm(cb, X_RCX, 1)

    loop_i := cb.len()
    ts_x64_cmp_rr(cb, X_RCX, X_RSI)
    done := ts_x64_jcc_fwd(cb, CC_GE)
    ts_x64_movss_ld(cb, 0, X_RDI, 4)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_ucomiss(cb, 0, 1)
    skip := ts_x64_jcc_fwd(cb, CC_BE)
    ts_x64_movaps(cb, 1, 0)
    x64_mov(cb, X_RAX, X_RCX)
    ts_x64_patch_rel32(cb, skip)
    ts_x64_add_imm(cb, X_RCX, 1)
    ts_x64_jmp_back(cb, loop_i)

    ts_x64_patch_rel32(cb, done)
    ts_x64_patch_rel32(cb, done_small)
    x64_ret(cb)
}

fn ts_x64_emit_rope_f32(cb $&mc.CodeBuffer) {
    // (v0=rdi, v1=rsi, cos=rdx, sin=rcx, half=r8)
    x64_test(cb, X_R8)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)

    loop4 := cb.len()
    x64_cmp_imm8(cb, X_R8, 4)
    to_tail := ts_x64_jcc_fwd(cb, CC_L)
    ts_x64_movups_ld(cb, 0, X_RDI, 0)
    ts_x64_movups_ld(cb, 1, X_RSI, 0)
    ts_x64_movups_ld(cb, 2, X_RDX, 0)
    ts_x64_movups_ld(cb, 3, X_RCX, 0)
    ts_x64_movaps(cb, 4, 0)
    ts_x64_mulps(cb, 4, 2)
    ts_x64_movaps(cb, 5, 1)
    ts_x64_mulps(cb, 5, 3)
    ts_x64_subps(cb, 4, 5)
    ts_x64_mulps(cb, 0, 3)
    ts_x64_mulps(cb, 1, 2)
    ts_x64_addps(cb, 0, 1)
    ts_x64_movups_st(cb, 4, X_RDI, 0)
    ts_x64_movups_st(cb, 0, X_RSI, 0)
    ts_x64_add_imm(cb, X_RDI, 16)
    ts_x64_add_imm(cb, X_RSI, 16)
    ts_x64_add_imm(cb, X_RDX, 16)
    ts_x64_add_imm(cb, X_RCX, 16)
    ts_x64_sub_imm(cb, X_R8, 4)
    ts_x64_jmp_back(cb, loop4)

    ts_x64_patch_rel32(cb, to_tail)
    tail := cb.len()
    x64_test(cb, X_R8)
    done := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_movss_ld(cb, 0, X_RDI, 0)
    ts_x64_movss_ld(cb, 1, X_RSI, 0)
    ts_x64_movss_ld(cb, 2, X_RDX, 0)
    ts_x64_movss_ld(cb, 3, X_RCX, 0)
    ts_x64_movaps(cb, 4, 0)
    ts_x64_mulss(cb, 4, 2)
    ts_x64_movaps(cb, 5, 1)
    ts_x64_mulss(cb, 5, 3)
    ts_x64_subss(cb, 4, 5)
    ts_x64_mulss(cb, 0, 3)
    ts_x64_mulss(cb, 1, 2)
    ts_x64_addss(cb, 0, 1)
    ts_x64_movss_st(cb, 4, X_RDI, 0)
    ts_x64_movss_st(cb, 0, X_RSI, 0)
    ts_x64_add_imm(cb, X_RDI, 4)
    ts_x64_add_imm(cb, X_RSI, 4)
    ts_x64_add_imm(cb, X_RDX, 4)
    ts_x64_add_imm(cb, X_RCX, 4)
    ts_x64_sub_imm(cb, X_R8, 1)
    ts_x64_jmp_back(cb, tail)

    ts_x64_patch_rel32(cb, done)
    ts_x64_patch_rel32(cb, done_early)
    x64_ret(cb)
}

fn ts_x64_load_f16_to_xmm0(cb $&mc.CodeBuffer, base_reg int, off_rax int, off_rcx int) {
    // Loads u16 IEEE-754 half from [base_reg] and converts to f32 in xmm0.
    // Preserves RAX, RCX via [rsp+off_rax], [rsp+off_rcx]; clobbers R10, xmm0, xmm1.
    x64_str(cb, X_RAX, X_RSP, off_rax)
    x64_str(cb, X_RCX, X_RSP, off_rcx)
    x64_load(cb, 2, X_RAX, base_reg, 0)
    x64_mov(cb, X_R10, X_RAX)
    ts_x64_shr_imm(cb, X_R10, 15)
    ts_x64_shl_imm(cb, X_R10, 31)
    x64_mov(cb, X_RCX, X_RAX)
    ts_x64_shr_imm(cb, X_RCX, 10)
    ts_x64_and_imm8(cb, X_RCX, 31)
    ts_x64_shl_imm(cb, X_RAX, 54)
    ts_x64_shr_imm(cb, X_RAX, 54)
    x64_test(cb, X_RCX)
    is_exp_zero := ts_x64_jcc_fwd(cb, CC_E)
    x64_cmp_imm8(cb, X_RCX, 31)
    is_inf_nan := ts_x64_jcc_fwd(cb, CC_E)
    ts_x64_add_imm(cb, X_RCX, 112)
    ts_x64_shl_imm(cb, X_RCX, 23)
    ts_x64_shl_imm(cb, X_RAX, 13)
    ts_x64_or_rr(cb, X_RAX, X_RCX)
    ts_x64_or_rr(cb, X_RAX, X_R10)
    ts_x64_movd_to_xmm(cb, 0, X_RAX)
    done_norm := ts_x64_jmp_fwd(cb)

    ts_x64_patch_rel32(cb, is_exp_zero)
    ts_x64_movd_to_xmm(cb, 0, X_RAX)
    ts_x64_cvtdq2ps(cb, 0, 0)
    x64_mov_imm(cb, X_RAX, 0x33800000)
    ts_x64_movd_to_xmm(cb, 1, X_RAX)
    ts_x64_mulss(cb, 0, 1)
    ts_x64_movd_to_xmm(cb, 1, X_R10)
    ts_x64_orps(cb, 0, 1)
    done_zero := ts_x64_jmp_fwd(cb)

    ts_x64_patch_rel32(cb, is_inf_nan)
    ts_x64_shl_imm(cb, X_RAX, 13)
    ts_x64_or_rr(cb, X_RAX, X_R10)
    x64_mov_imm(cb, X_R10, 0x7F800000)
    ts_x64_or_rr(cb, X_RAX, X_R10)
    ts_x64_movd_to_xmm(cb, 0, X_RAX)

    ts_x64_patch_rel32(cb, done_norm)
    ts_x64_patch_rel32(cb, done_zero)
    x64_ldr(cb, X_RAX, X_RSP, off_rax)
    x64_ldr(cb, X_RCX, X_RSP, off_rcx)
}

fn ts_x64_emit_gemv4_p4_q8_0(cb $&mc.CodeBuffer, is_q8 bool, f16_scale bool) {
    // (out=rdi, qs_p=rsi, ws_p=rdx, xq=rcx, xs=r8, packed=(rg_cnt<<32)|nb in r9)
    ts_x64_mov32_rr(cb, X_R10, X_R9) // nb
    ts_x64_shr_imm(cb, X_R9, 32)     // rg_cnt
    x64_test(cb, X_R9)
    done_early := ts_x64_jcc_fwd(cb, CC_LE)
    ts_x64_sub_imm(cb, X_RSP, 48)
    x64_str(cb, X_RCX, X_RSP, 0)     // xq
    x64_str(cb, X_R8, X_RSP, 8)      // xs
    x64_str(cb, X_R9, X_RSP, 16)     // rg_rem
    x64_str(cb, X_R10, X_RSP, 24)    // nb
    if !is_q8 {
        ts_x64_pcmpeqd(cb, 3, 3)
        ts_x64_psrlw_imm(cb, 3, 15)
        ts_x64_psllw_imm(cb, 3, 3)
    }
    $w_stride := 16
    if is_q8 { w_stride = 32 }
    $ws_elem := 4
    $ws_blk := 16
    $ws_sh := 4
    if f16_scale {
        ws_elem = 2
        ws_blk = 8
        ws_sh = 3
    }

    rg_loop := cb.len()
    x64_ldr(cb, X_RAX, X_RSP, 16)
    x64_test(cb, X_RAX)
    done_rg := ts_x64_jcc_fwd(cb, CC_LE)
    for r4 in 0:4 {
        x64_mov(cb, X_R11, X_RSI)
        if r4 > 0 { ts_x64_add_imm(cb, X_R11, r4 * w_stride) }
        x64_mov(cb, X_R9, X_RDX)
        if r4 > 0 { ts_x64_add_imm(cb, X_R9, r4 * ws_elem) }
        x64_ldr(cb, X_RCX, X_RSP, 0)
        x64_ldr(cb, X_R8, X_RSP, 8)
        x64_ldr(cb, X_RAX, X_RSP, 24)
        ts_x64_xorps(cb, 5, 5)
        blk := cb.len()
        x64_test(cb, X_RAX)
        blk_done := ts_x64_jcc_fwd(cb, CC_LE)
        if is_q8 { ts_x64_q8_q8_block(cb, X_R11, X_RCX) }
        else { ts_x64_q4_q8_block(cb, X_R11, X_RCX) }
        if f16_scale {
            ts_x64_load_f16_to_xmm0(cb, X_R9, 32, 40)
        } else {
            ts_x64_movss_ld(cb, 0, X_R9, 0)
        }
        ts_x64_movss_ld(cb, 1, X_R8, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_mulss(cb, 4, 0)
        ts_x64_addss(cb, 5, 4)
        if is_q8 {
            ts_x64_add_imm32(cb, X_R11, 128)
        } else {
            ts_x64_add_imm(cb, X_R11, 64)
        }
        ts_x64_add_imm(cb, X_R9, ws_blk)
        ts_x64_add_imm(cb, X_RCX, 32)
        ts_x64_add_imm(cb, X_R8, 4)
        ts_x64_sub_imm(cb, X_RAX, 1)
        ts_x64_jmp_back(cb, blk)
        ts_x64_patch_rel32(cb, blk_done)
        ts_x64_movss_st(cb, 5, X_RDI, 0)
        ts_x64_add_imm(cb, X_RDI, 4)
    }
    x64_ldr(cb, X_RAX, X_RSP, 24)
    $sh := 6
    if is_q8 { sh = 7 }
    x64_mov(cb, X_R11, X_RAX)
    ts_x64_shl_imm(cb, X_R11, sh)
    ts_x64_add_rr(cb, X_RSI, X_R11)
    ts_x64_shl_imm(cb, X_RAX, ws_sh)
    ts_x64_add_rr(cb, X_RDX, X_RAX)
    x64_ldr(cb, X_RAX, X_RSP, 16)
    ts_x64_sub_imm(cb, X_RAX, 1)
    x64_str(cb, X_RAX, X_RSP, 16)
    ts_x64_jmp_back(cb, rg_loop)

    ts_x64_patch_rel32(cb, done_rg)
    ts_x64_add_imm(cb, X_RSP, 48)
    ts_x64_patch_rel32(cb, done_early)
    x64_ret(cb)
}

fn ts_x64_emit_gemm4x8_q4_0_p4_q8_0(cb $&mc.CodeBuffer, f16_scale bool) {
    // (out=rdi, qs_p=rsi, ws_p=rdx, xq=rcx, xs=r8, packed=(M<<42)|(rg_cnt<<21)|nb in r9)
    x64_mov_imm(cb, X_R11, 0x1fffff)
    x64_mov(cb, X_R10, X_R9)
    ts_x64_and_rr(cb, X_R10, X_R11) // nb
    ts_x64_shr_imm(cb, X_R9, 21)
    x64_mov(cb, X_RAX, X_R9)
    ts_x64_and_rr(cb, X_RAX, X_R11) // rg_cnt
    ts_x64_shr_imm(cb, X_R9, 21)
    ts_x64_and_rr(cb, X_R9, X_R11)  // M
    x64_test(cb, X_R9)
    early_m := ts_x64_jcc_fwd(cb, CC_LE)
    x64_test(cb, X_RAX)
    early_rg := ts_x64_jcc_fwd(cb, CC_LE)

    ts_x64_sub_imm(cb, X_RSP, 96)
    x64_str(cb, X_RSI, X_RSP, 0)   // qs_base
    x64_str(cb, X_RDX, X_RSP, 8)   // ws_base
    x64_str(cb, X_RCX, X_RSP, 16)  // xq_m
    x64_str(cb, X_R8, X_RSP, 24)   // xs_m
    x64_str(cb, X_RDI, X_RSP, 32)  // out_m
    x64_str(cb, X_R9, X_RSP, 40)   // M_rem
    x64_str(cb, X_RAX, X_RSP, 48)  // rg_cnt
    x64_str(cb, X_R10, X_RSP, 56)  // nb
    ts_x64_pcmpeqd(cb, 3, 3)
    ts_x64_psrlw_imm(cb, 3, 15)
    ts_x64_psllw_imm(cb, 3, 3)
    $ws_elem := 4
    $ws_blk := 16
    $ws_sh := 4
    if f16_scale {
        ws_elem = 2
        ws_blk = 8
        ws_sh = 3
    }

    m_loop := cb.len()
    x64_ldr(cb, X_RAX, X_RSP, 40)
    x64_test(cb, X_RAX)
    done_all := ts_x64_jcc_fwd(cb, CC_LE)
    x64_ldr(cb, X_RDI, X_RSP, 32)
    x64_ldr(cb, X_RSI, X_RSP, 0)
    x64_ldr(cb, X_RDX, X_RSP, 8)
    x64_ldr(cb, X_RAX, X_RSP, 48)
    x64_str(cb, X_RAX, X_RSP, 64)  // rg_rem

    rg_loop := cb.len()
    x64_ldr(cb, X_RAX, X_RSP, 64)
    x64_test(cb, X_RAX)
    rg_done := ts_x64_jcc_fwd(cb, CC_LE)
    for r4 in 0:4 {
        x64_mov(cb, X_R11, X_RSI)
        if r4 > 0 { ts_x64_add_imm(cb, X_R11, r4 * 16) }
        x64_mov(cb, X_R9, X_RDX)
        if r4 > 0 { ts_x64_add_imm(cb, X_R9, r4 * ws_elem) }
        x64_ldr(cb, X_RCX, X_RSP, 16)
        x64_ldr(cb, X_R8, X_RSP, 24)
        x64_ldr(cb, X_RAX, X_RSP, 56)
        ts_x64_xorps(cb, 5, 5)
        blk := cb.len()
        x64_test(cb, X_RAX)
        blk_done := ts_x64_jcc_fwd(cb, CC_LE)
        ts_x64_q4_q8_block(cb, X_R11, X_RCX)
        if f16_scale {
            ts_x64_load_f16_to_xmm0(cb, X_R9, 80, 88)
        } else {
            ts_x64_movss_ld(cb, 0, X_R9, 0)
        }
        ts_x64_movss_ld(cb, 1, X_R8, 0)
        ts_x64_mulss(cb, 0, 1)
        ts_x64_mulss(cb, 4, 0)
        ts_x64_addss(cb, 5, 4)
        ts_x64_add_imm(cb, X_R11, 64)
        ts_x64_add_imm(cb, X_R9, ws_blk)
        ts_x64_add_imm(cb, X_RCX, 32)
        ts_x64_add_imm(cb, X_R8, 4)
        ts_x64_sub_imm(cb, X_RAX, 1)
        ts_x64_jmp_back(cb, blk)
        ts_x64_patch_rel32(cb, blk_done)
        ts_x64_movss_st(cb, 5, X_RDI, 0)
        ts_x64_add_imm(cb, X_RDI, 4)
    }
    x64_ldr(cb, X_RAX, X_RSP, 56)
    x64_mov(cb, X_R11, X_RAX)
    ts_x64_shl_imm(cb, X_R11, 6)
    ts_x64_add_rr(cb, X_RSI, X_R11)
    ts_x64_shl_imm(cb, X_RAX, ws_sh)
    ts_x64_add_rr(cb, X_RDX, X_RAX)
    x64_ldr(cb, X_RAX, X_RSP, 64)
    ts_x64_sub_imm(cb, X_RAX, 1)
    x64_str(cb, X_RAX, X_RSP, 64)
    ts_x64_jmp_back(cb, rg_loop)

    ts_x64_patch_rel32(cb, rg_done)
    x64_ldr(cb, X_RAX, X_RSP, 56) // nb
    x64_mov(cb, X_R11, X_RAX)
    ts_x64_shl_imm(cb, X_R11, 5)
    x64_ldr(cb, X_RCX, X_RSP, 16)
    ts_x64_add_rr(cb, X_RCX, X_R11)
    x64_str(cb, X_RCX, X_RSP, 16)
    ts_x64_shl_imm(cb, X_RAX, 2)
    x64_ldr(cb, X_R8, X_RSP, 24)
    ts_x64_add_rr(cb, X_R8, X_RAX)
    x64_str(cb, X_R8, X_RSP, 24)
    x64_ldr(cb, X_RAX, X_RSP, 48) // rg_cnt
    ts_x64_shl_imm(cb, X_RAX, 4)
    x64_ldr(cb, X_RDI, X_RSP, 32)
    ts_x64_add_rr(cb, X_RDI, X_RAX)
    x64_str(cb, X_RDI, X_RSP, 32)
    x64_ldr(cb, X_RAX, X_RSP, 40)
    ts_x64_sub_imm(cb, X_RAX, 1)
    x64_str(cb, X_RAX, X_RSP, 40)
    ts_x64_jmp_back(cb, m_loop)

    ts_x64_patch_rel32(cb, done_all)
    ts_x64_add_imm(cb, X_RSP, 96)
    ts_x64_patch_rel32(cb, early_m)
    ts_x64_patch_rel32(cb, early_rg)
    x64_ret(cb)
}

pub fn emit_x64_tensor_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    syms.define_label("__xu_tensor_mul_add_f32", cb.len())
    ts_x64_emit_mul_add(cb)
    syms.define_label("__xu_tensor_mul_add_fma_f32", cb.len())
    ts_x64_emit_mul_add(cb)
    syms.define_label("__xu_tensor_add_sqsum_f32", cb.len())
    ts_x64_emit_add_sqsum(cb, false)
    syms.define_label("__xu_tensor_add_sqsum_fast_f32", cb.len())
    ts_x64_emit_add_sqsum(cb, true)
    syms.define_label("__xu_tensor_norm_f32", cb.len())
    ts_x64_emit_norm(cb)
    syms.define_label("__xu_tensor_dot_f32", cb.len())
    ts_x64_emit_dot(cb, false)
    syms.define_label("__xu_tensor_dot_fast_f32", cb.len())
    ts_x64_emit_dot(cb, true)
    syms.define_label("__xu_tensor_axpy_f32", cb.len())
    ts_x64_emit_axpy(cb)
    syms.define_label("__xu_tensor_axpy_fma_f32", cb.len())
    ts_x64_emit_axpy(cb)
    syms.define_label("__xu_tensor_vadd_inplace_f32", cb.len())
    ts_x64_emit_vadd_inplace(cb)
    syms.define_label("__xu_tensor_dot_q4_0_f32", cb.len())
    ts_x64_emit_dot_q4_0(cb, false)
    syms.define_label("__xu_tensor_dot_q4_0_fast_f32", cb.len())
    ts_x64_emit_dot_q4_0(cb, true)
    syms.define_label("__xu_tensor_gemv4_f32", cb.len())
    ts_x64_emit_gemv4_f32(cb, false)
    syms.define_label("__xu_tensor_gemv4_fast_f32", cb.len())
    ts_x64_emit_gemv4_f32(cb, true)
    syms.define_label("__xu_tensor_dot_q4_0_q8_0_f32", cb.len())
    ts_x64_emit_dot_q4_0_q8_0(cb)
    syms.define_label("__xu_tensor_dot_q4_0_q8_0_fast_f32", cb.len())
    ts_x64_emit_dot_q4_0_q8_0(cb)
    syms.define_label("__xu_tensor_gemv4_q4_0_q8_0_f32", cb.len())
    ts_x64_emit_gemv4_q4_0_q8_0(cb)
    syms.define_label("__xu_tensor_gemv4_q4_0_q8_0_fast_f32", cb.len())
    ts_x64_emit_gemv4_q4_0_q8_0(cb)
    syms.define_label("__xu_tensor_quantize_q8_0", cb.len())
    ts_x64_emit_quantize_q8_0(cb)
    syms.define_label("__xu_tensor_quantize_q8_0_fast", cb.len())
    ts_x64_emit_quantize_q8_0(cb)
    syms.define_label("__xu_tensor_gemv4_q8_0_q8_0_f32", cb.len())
    ts_x64_emit_gemv4_q8_0_q8_0(cb)
