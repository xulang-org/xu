}
fn ts_a64_restore_q8_q15(cb $&mc.CodeBuffer) {
    e32(cb, 0xAD433FEE)
    e32(cb, 0xAD4237EC)
    e32(cb, 0xAD412FEA)
    e32(cb, 0xACC427E8)
}
fn ts_a64_dup_4s_u32(cb $&mc.CodeBuffer, vd int, scratch int, lo int, hi int) {
    e32(cb, 0x52800000 | ((lo & 0xffff) << 5) | scratch)
    if (hi & 0xffff) != 0 { e32(cb, 0x72A00000 | ((hi & 0xffff) << 5) | scratch) }
    ts_a64_dup_4s_w(cb, vd, scratch)
}
fn ts_a64_dup_2d_u16(cb $&mc.CodeBuffer, vd int, scratch int, s3 int, s2 int, s1 int, s0 int) {
    e32(cb, 0xD2800000 | ((s0 & 0xffff) << 5) | scratch)
    if (s1 & 0xffff) != 0 { e32(cb, 0xF2A00000 | ((s1 & 0xffff) << 5) | scratch) }
    if (s2 & 0xffff) != 0 { e32(cb, 0xF2C00000 | ((s2 & 0xffff) << 5) | scratch) }
    if (s3 & 0xffff) != 0 { e32(cb, 0xF2E00000 | ((s3 & 0xffff) << 5) | scratch) }
    ts_a64_dup_2d(cb, vd, scratch)
}

fn ts_a64_sdot_reduce4_off(cb $&mc.CodeBuffer, acc_reg int, off_reg int, s_regs &[]int, fast bool) {
    ts_a64_addp_4s(cb, 4, 4, 5)
    ts_a64_addp_4s(cb, 6, 6, 7)
    ts_a64_addp_4s(cb, 4, 4, 6)
    if off_reg >= 0 {
        ts_a64_add_4s(cb, 4, 4, off_reg)
    }
    ts_a64_scvtf_4s(cb, 4, 4)
    if s_regs.len == 4 {
        for r in 0:4 {
            ts_a64_ld1_s_lane_post(cb, 23, r, s_regs[r])
        }
    }
    ts_a64_fmul_4s_elem0(cb, 23, 23, 22)
    if fast {
        ts_a64_fmla_4s(cb, acc_reg, 4, 23)
    } else {
        ts_a64_fmul_4s(cb, 4, 4, 23)
        ts_a64_fadd_4s(cb, acc_reg, acc_reg, 4)
    }
}

fn ts_a64_sdot_reduce4(cb $&mc.CodeBuffer, acc_reg int, s_regs &[]int, fast bool) {
    ts_a64_sdot_reduce4_off(cb, acc_reg, -1, s_regs, fast)
}

fn ts_a64_emit_mul_add(cb $&mc.CodeBuffer, fma bool) {
    // (out=x0, x=x1, scale=x2, bias=x3, n=x4)
    ts_a64_cmp_imm(cb, 4, 0)
    done_early := ts_a64_b_cond_fwd(cb)

    loop4 := cb.len()
    ts_a64_cmp_imm(cb, 4, 4)
    to_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 1)
    ts_a64_ldr_q_post(cb, 1, 2)
    ts_a64_ldr_q_post(cb, 2, 3)
    if fma {
        ts_a64_fmla_4s(cb, 2, 0, 1)
        ts_a64_str_q_post(cb, 2, 0)
    } else {
        ts_a64_fmul_4s(cb, 0, 0, 1)
        ts_a64_fadd_4s(cb, 0, 0, 2)
        ts_a64_str_q_post(cb, 0, 0)
    }
    ts_a64_sub_imm(cb, 4, 4, 4)
    ts_a64_b_back(cb, loop4)

    ts_a64_patch_cond(cb, to_tail, A64_COND_LT)
    tail := cb.len()
    ts_a64_cmp_imm(cb, 4, 0)
    done_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 0, 1)
    ts_a64_ldr_s_post(cb, 1, 2)
    ts_a64_ldr_s_post(cb, 2, 3)
    if fma {
        ts_a64_fmadd_s(cb, 0, 0, 1, 2)
    } else {
        ts_a64_fmul_s(cb, 0, 0, 1)
        ts_a64_fadd_s(cb, 0, 0, 2)
    }
    ts_a64_str_s_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 4, 4, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_tail, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_add_sqsum_arm(cb $&mc.CodeBuffer, write_dst bool, fast bool) {
    // x0=dst, x1=x, x2=skip, x3=n, acc in s4 (strict) or s5+v4 (fast)
    if fast {
        ts_a64_zero_4s(cb, 4)
    }
    loop4 := cb.len()
    ts_a64_cmp_imm(cb, 3, 4)
    to_tail_or_fold := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 1)
    ts_a64_ldr_q_post(cb, 1, 2)
    ts_a64_fadd_4s(cb, 0, 0, 1)
    if write_dst {
        ts_a64_str_q_post(cb, 0, 0)
    }
    if fast {
        ts_a64_fmla_4s(cb, 4, 0, 0)
    } else {
        ts_a64_fmul_4s(cb, 0, 0, 0)
        ts_a64_serial_sum_v0(cb, 4)
    }
    ts_a64_sub_imm(cb, 3, 3, 4)
    ts_a64_b_back(cb, loop4)

    ts_a64_patch_cond(cb, to_tail_or_fold, A64_COND_LT)
    if fast {
        ts_a64_faddp_4s(cb, 4, 4, 4)
        ts_a64_faddp_2s(cb, 4, 4)
        ts_a64_fadd_s(cb, 5, 5, 4)
    }
    tail := cb.len()
    ts_a64_cmp_imm(cb, 3, 0)
    done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 0, 1)
    ts_a64_ldr_s_post(cb, 1, 2)
    ts_a64_fadd_s(cb, 0, 0, 1)
    if write_dst {
        ts_a64_str_s_post(cb, 0, 0)
    }
    if fast {
        ts_a64_fmadd_s(cb, 5, 0, 0, 5)
    } else {
        ts_a64_fmul_s(cb, 0, 0, 0)
        ts_a64_fadd_s(cb, 4, 4, 0)
    }
    ts_a64_sub_imm(cb, 3, 3, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done, A64_COND_LE)
    if fast {
        ts_a64_fmov_w_s(cb, 0, 5)
    } else {
        ts_a64_fmov_w_s(cb, 0, 4)
    }
    ts_a64_ret(cb)
}

fn ts_a64_emit_add_sqsum(cb $&mc.CodeBuffer, fast bool) {
    // (dst=x0, x=x1, skip=x2, n=x3, acc_bits=x4) -> x0
    ts_a64_cmp_imm(cb, 3, 0)
    positive := ts_a64_b_cond_fwd(cb)
    a64_mov(cb, 0, 4)
    ts_a64_ret(cb)

    ts_a64_patch_cond(cb, positive, A64_COND_GT)
    if fast {
        ts_a64_fmov_s_w(cb, 5, 4)
    } else {
        ts_a64_fmov_s_w(cb, 4, 4)
    }
    no_dst := ts_a64_cbz_fwd(cb)
    ts_a64_emit_add_sqsum_arm(cb, true, fast)
    ts_a64_patch_cbz(cb, no_dst, 0, false)
    ts_a64_emit_add_sqsum_arm(cb, false, fast)
}

fn ts_a64_emit_norm_arm(cb $&mc.CodeBuffer, weighted bool) {
    // x0=dst, x1=src, x2=weight, v3=broadcast(scale), x4=n
    loop4 := cb.len()
    ts_a64_cmp_imm(cb, 4, 4)
    to_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 1)
    ts_a64_fmul_4s(cb, 0, 0, 3)
    if weighted {
        ts_a64_ldr_q_post(cb, 1, 2)
        ts_a64_fmul_4s(cb, 0, 0, 1)
    }
    ts_a64_str_q_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 4, 4, 4)
    ts_a64_b_back(cb, loop4)

    ts_a64_patch_cond(cb, to_tail, A64_COND_LT)
    tail := cb.len()
    ts_a64_cmp_imm(cb, 4, 0)
    done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 0, 1)
    ts_a64_fmul_s(cb, 0, 0, 3)
    if weighted {
        ts_a64_ldr_s_post(cb, 1, 2)
        ts_a64_fmul_s(cb, 0, 0, 1)
    }
    ts_a64_str_s_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 4, 4, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_norm(cb $&mc.CodeBuffer) {
    // (dst=x0, src=x1, weight=x2, scale_bits=x3, n=x4)
    ts_a64_cmp_imm(cb, 4, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_fmov_s_w(cb, 3, 3)
    ts_a64_dup_4s_0(cb, 3, 3)
    weighted := ts_a64_cbz_fwd(cb)
    ts_a64_emit_norm_arm(cb, false)
    ts_a64_patch_cbz(cb, weighted, 2, true)
    ts_a64_emit_norm_arm(cb, true)
    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_dot(cb $&mc.CodeBuffer, fast bool) {
    // (a=x0, b=x1, n=x2, acc_bits=x3) -> x0
    ts_a64_cmp_imm(cb, 2, 0)
    positive := ts_a64_b_cond_fwd(cb)
    a64_mov(cb, 0, 3)
    ts_a64_ret(cb)

    ts_a64_patch_cond(cb, positive, A64_COND_GT)
    if !fast {
        ts_a64_fmov_s_w(cb, 4, 3)
        loop4 := cb.len()
        ts_a64_cmp_imm(cb, 2, 4)
        to_tail := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 0, 0)
        ts_a64_ldr_q_post(cb, 1, 1)
        ts_a64_fmul_4s(cb, 0, 0, 1)
        ts_a64_serial_sum_v0(cb, 4)
        ts_a64_sub_imm(cb, 2, 2, 4)
        ts_a64_b_back(cb, loop4)

        ts_a64_patch_cond(cb, to_tail, A64_COND_LT)
        tail := cb.len()
        ts_a64_cmp_imm(cb, 2, 0)
        done := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_s_post(cb, 0, 0)
        ts_a64_ldr_s_post(cb, 1, 1)
        ts_a64_fmul_s(cb, 0, 0, 1)
        ts_a64_fadd_s(cb, 4, 4, 0)
        ts_a64_sub_imm(cb, 2, 2, 1)
        ts_a64_b_back(cb, tail)

        ts_a64_patch_cond(cb, done, A64_COND_LE)
        ts_a64_fmov_w_s(cb, 0, 4)
        ts_a64_ret(cb)
        <<
    }

    // Fast 16-wide (4 independent 4-lane NEON FMA accumulators v4..v7).
    ts_a64_fmov_s_w(cb, 16, 3)
    ts_a64_zero_4s(cb, 4)
    ts_a64_zero_4s(cb, 5)
    ts_a64_zero_4s(cb, 6)
    ts_a64_zero_4s(cb, 7)

    loop16 := cb.len()
    ts_a64_cmp_imm(cb, 2, 16)
    to_loop4 := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 0)
    ts_a64_ldr_q_post(cb, 1, 0)
    ts_a64_ldr_q_post(cb, 2, 0)
    ts_a64_ldr_q_post(cb, 3, 0)
    ts_a64_ldr_q_post(cb, 17, 1)
    ts_a64_ldr_q_post(cb, 18, 1)
    ts_a64_ldr_q_post(cb, 19, 1)
    ts_a64_ldr_q_post(cb, 20, 1)
    ts_a64_fmla_4s(cb, 4, 0, 17)
    ts_a64_fmla_4s(cb, 5, 1, 18)
    ts_a64_fmla_4s(cb, 6, 2, 19)
    ts_a64_fmla_4s(cb, 7, 3, 20)
    ts_a64_sub_imm(cb, 2, 2, 16)
    ts_a64_b_back(cb, loop16)

    ts_a64_patch_cond(cb, to_loop4, A64_COND_LT)
    loop4 := cb.len()
    ts_a64_cmp_imm(cb, 2, 4)
    fold := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 0)
    ts_a64_ldr_q_post(cb, 1, 1)
    ts_a64_fmla_4s(cb, 4, 0, 1)
    ts_a64_sub_imm(cb, 2, 2, 4)
    ts_a64_b_back(cb, loop4)

    ts_a64_patch_cond(cb, fold, A64_COND_LT)
    ts_a64_fadd_4s(cb, 4, 4, 5)
    ts_a64_fadd_4s(cb, 6, 6, 7)
    ts_a64_fadd_4s(cb, 4, 4, 6)
    ts_a64_faddp_4s(cb, 4, 4, 4)
    ts_a64_faddp_2s(cb, 4, 4)
    ts_a64_fadd_s(cb, 16, 16, 4)

    tail := cb.len()
    ts_a64_cmp_imm(cb, 2, 0)
    done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 0, 0)
    ts_a64_ldr_s_post(cb, 1, 1)
    ts_a64_fmadd_s(cb, 16, 0, 1, 16)
    ts_a64_sub_imm(cb, 2, 2, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done, A64_COND_LE)
    ts_a64_fmov_w_s(cb, 0, 16)
    ts_a64_ret(cb)
}

fn ts_a64_emit_axpy(cb $&mc.CodeBuffer, fma bool) {
    // (dst=x0, src=x1, scale_bits=x2, n=x3)
    ts_a64_cmp_imm(cb, 3, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_fmov_s_w(cb, 2, 2)
    ts_a64_dup_4s_0(cb, 2, 2)

    loop4 := cb.len()
    ts_a64_cmp_imm(cb, 3, 4)
    to_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_off(cb, 0, 0, 0)
    ts_a64_ldr_q_post(cb, 1, 1)
    if fma {
        ts_a64_fmla_4s(cb, 0, 1, 2)
    } else {
        ts_a64_fmul_4s(cb, 1, 2, 1)
        ts_a64_fadd_4s(cb, 0, 0, 1)
    }
    ts_a64_str_q_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 3, 3, 4)
    ts_a64_b_back(cb, loop4)

    ts_a64_patch_cond(cb, to_tail, A64_COND_LT)
    tail := cb.len()
    ts_a64_cmp_imm(cb, 3, 0)
    done_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_zero(cb, 0, 0)
    ts_a64_ldr_s_post(cb, 1, 1)
    if fma {
        ts_a64_fmadd_s(cb, 0, 2, 1, 0)
    } else {
        ts_a64_fmul_s(cb, 1, 2, 1)
        ts_a64_fadd_s(cb, 0, 0, 1)
    }
    ts_a64_str_s_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 3, 3, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_tail, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_vadd_inplace(cb $&mc.CodeBuffer) {
    // (dst=x0, src=x1, n=x2)
    ts_a64_cmp_imm(cb, 2, 0)
    done_early := ts_a64_b_cond_fwd(cb)

    loop4 := cb.len()
    ts_a64_cmp_imm(cb, 2, 4)
    to_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_off(cb, 0, 0, 0)
    ts_a64_ldr_q_post(cb, 1, 1)
    ts_a64_fadd_4s(cb, 0, 0, 1)
    ts_a64_str_q_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 2, 2, 4)
    ts_a64_b_back(cb, loop4)

    ts_a64_patch_cond(cb, to_tail, A64_COND_LT)
    tail := cb.len()
    ts_a64_cmp_imm(cb, 2, 0)
    done_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_zero(cb, 0, 0)
    ts_a64_ldr_s_post(cb, 1, 1)
    ts_a64_fadd_s(cb, 0, 0, 1)
    ts_a64_str_s_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 2, 2, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_tail, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_dot_q4_0(cb $&mc.CodeBuffer, fast bool) {
    // (qs=x0, scales=x1, x=x2, n_blocks=x3, acc_bits=x4) -> x0
    ts_a64_cmp_imm(cb, 3, 0)
    positive := ts_a64_b_cond_fwd(cb)
    a64_mov(cb, 0, 4)
    ts_a64_ret(cb)

    ts_a64_patch_cond(cb, positive, A64_COND_GT)
    ts_a64_fmov_s_w(cb, 16, 4)
    ts_a64_movi_16b(cb, 20, 15)
    ts_a64_movi_16b(cb, 21, 8)

    loop_blk := cb.len()
    ts_a64_cmp_imm(cb, 3, 0)
    done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 0)
    ts_a64_and_16b(cb, 1, 0, 20)
    ts_a64_ushr_16b_4(cb, 2, 0)
    ts_a64_sub_16b(cb, 1, 1, 21)
    ts_a64_sub_16b(cb, 2, 2, 21)

    if !fast {
        ts_a64_zero_4s(cb, 4)
        for half in 0:2 {
            if half == 0 {
                ts_a64_sxtl_8h(cb, 17, 1)
                ts_a64_sxtl_8h(cb, 18, 2)
            } else {
                ts_a64_sxtl2_8h(cb, 17, 1)
                ts_a64_sxtl2_8h(cb, 18, 2)
            }
            off_lo_a := half * 2
            off_hi_a := 4 + half * 2
            ts_a64_sxtl_4s(cb, 19, 17)
            ts_a64_scvtf_4s(cb, 19, 19)
            ts_a64_sxtl_4s(cb, 22, 18)
            ts_a64_scvtf_4s(cb, 22, 22)
            ts_a64_ldr_q_off(cb, 0, 2, off_lo_a)
            ts_a64_ldr_q_off(cb, 5, 2, off_hi_a)
            ts_a64_fmul_4s(cb, 0, 19, 0)
            ts_a64_fmul_4s(cb, 5, 22, 5)
            ts_a64_fadd_4s(cb, 0, 0, 5)
            ts_a64_serial_sum_v0(cb, 4)

            off_lo_b := half * 2 + 1
            off_hi_b := 5 + half * 2
            ts_a64_sxtl2_4s(cb, 19, 17)
            ts_a64_scvtf_4s(cb, 19, 19)
            ts_a64_sxtl2_4s(cb, 22, 18)
            ts_a64_scvtf_4s(cb, 22, 22)
            ts_a64_ldr_q_off(cb, 0, 2, off_lo_b)
            ts_a64_ldr_q_off(cb, 5, 2, off_hi_b)
            ts_a64_fmul_4s(cb, 0, 19, 0)
            ts_a64_fmul_4s(cb, 5, 22, 5)
            ts_a64_fadd_4s(cb, 0, 0, 5)
            ts_a64_serial_sum_v0(cb, 4)
        }
        ts_a64_ldr_s_post(cb, 3, 1)
        ts_a64_fmul_s(cb, 4, 4, 3)
        ts_a64_fadd_s(cb, 16, 16, 4)
    } else {
        ts_a64_sxtl_8h(cb, 17, 1)
        ts_a64_sxtl2_8h(cb, 18, 1)
        ts_a64_sxtl_4s(cb, 19, 17)
        ts_a64_scvtf_4s(cb, 19, 19)
        ts_a64_ldr_q_off(cb, 0, 2, 0)
        ts_a64_fmul_4s(cb, 4, 19, 0)
        ts_a64_sxtl2_4s(cb, 22, 17)
        ts_a64_scvtf_4s(cb, 22, 22)
        ts_a64_ldr_q_off(cb, 3, 2, 1)
        ts_a64_fmul_4s(cb, 5, 22, 3)
        ts_a64_sxtl_4s(cb, 19, 18)
        ts_a64_scvtf_4s(cb, 19, 19)
        ts_a64_ldr_q_off(cb, 0, 2, 2)
        ts_a64_fmul_4s(cb, 6, 19, 0)
        ts_a64_sxtl2_4s(cb, 22, 18)
        ts_a64_scvtf_4s(cb, 22, 22)
        ts_a64_ldr_q_off(cb, 3, 2, 3)
        ts_a64_fmul_4s(cb, 7, 22, 3)

        ts_a64_sxtl_8h(cb, 17, 2)
        ts_a64_sxtl2_8h(cb, 18, 2)
        ts_a64_sxtl_4s(cb, 19, 17)
        ts_a64_scvtf_4s(cb, 19, 19)
        ts_a64_ldr_q_off(cb, 0, 2, 4)
        ts_a64_fmla_4s(cb, 4, 19, 0)
        ts_a64_sxtl2_4s(cb, 22, 17)
        ts_a64_scvtf_4s(cb, 22, 22)
        ts_a64_ldr_q_off(cb, 3, 2, 5)
        ts_a64_fmla_4s(cb, 5, 22, 3)
        ts_a64_sxtl_4s(cb, 19, 18)
        ts_a64_scvtf_4s(cb, 19, 19)
        ts_a64_ldr_q_off(cb, 0, 2, 6)
        ts_a64_fmla_4s(cb, 6, 19, 0)
        ts_a64_sxtl2_4s(cb, 22, 18)
        ts_a64_scvtf_4s(cb, 22, 22)
        ts_a64_ldr_q_off(cb, 3, 2, 7)
        ts_a64_fmla_4s(cb, 7, 22, 3)

        ts_a64_fadd_4s(cb, 4, 4, 5)
        ts_a64_fadd_4s(cb, 6, 6, 7)
        ts_a64_fadd_4s(cb, 4, 4, 6)
        ts_a64_faddp_4s(cb, 4, 4, 4)
        ts_a64_faddp_2s(cb, 4, 4)
        ts_a64_ldr_s_post(cb, 3, 1)
        ts_a64_fmadd_s(cb, 16, 4, 3, 16)
    }

    ts_a64_add_imm(cb, 2, 2, 128)
    ts_a64_sub_imm(cb, 3, 3, 1)
    ts_a64_b_back(cb, loop_blk)

    ts_a64_patch_cond(cb, done, A64_COND_LE)
    ts_a64_fmov_w_s(cb, 0, 16)
    ts_a64_ret(cb)
}

fn ts_a64_emit_gemv4_f32(cb $&mc.CodeBuffer, fast bool) {
    // (out=x0, w=x1, x=x2, rows=x3, cols=x4)
    ts_a64_cmp_imm(cb, 3, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_lsl_imm(cb, 5, 4, 2) // x5 = cols * 4

    w_regs := [1, 6, 7, 9]
    loop4_rows := cb.len()
    ts_a64_cmp_imm(cb, 3, 4)
    to_tail_rows := ts_a64_b_cond_fwd(cb)

    ts_a64_add_reg(cb, 6, 1, 5)
    ts_a64_add_reg(cb, 7, 6, 5)
    ts_a64_add_reg(cb, 9, 7, 5)
    a64_mov(cb, 10, 2)
    a64_mov(cb, 11, 4)

    if !fast {
        for r in 0:4 { ts_a64_zero_4s(cb, 4 + r) }
        c_loop4 := cb.len()
        ts_a64_cmp_imm(cb, 11, 4)
        to_c_tail := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 1, 10)
        for r in 0:4 {
            ts_a64_ldr_q_post(cb, 0, w_regs[r])
            ts_a64_fmul_4s(cb, 0, 0, 1)
            ts_a64_serial_sum_v0(cb, 4 + r)
        }
        ts_a64_sub_imm(cb, 11, 11, 4)
        ts_a64_b_back(cb, c_loop4)

        ts_a64_patch_cond(cb, to_c_tail, A64_COND_LT)
        c_tail := cb.len()
        ts_a64_cmp_imm(cb, 11, 0)
        to_store4 := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_s_post(cb, 1, 10)
        for r in 0:4 {
            ts_a64_ldr_s_post(cb, 0, w_regs[r])
            ts_a64_fmul_s(cb, 0, 0, 1)
            ts_a64_fadd_s(cb, 4 + r, 4 + r, 0)
        }
        ts_a64_sub_imm(cb, 11, 11, 1)
        ts_a64_b_back(cb, c_tail)

        ts_a64_patch_cond(cb, to_store4, A64_COND_LE)
        for r in 0:4 { ts_a64_str_s_post(cb, 4 + r, 0) }
    } else {
        for r in 0:4 {
            ts_a64_zero_4s(cb, 4 + r)
            ts_a64_zero_4s(cb, 16 + r)
        }
        c_loop16 := cb.len()
        ts_a64_cmp_imm(cb, 11, 16)
        to_c8 := ts_a64_b_cond_fwd(cb)
        ts_a64_ldp_q_post(cb, 0, 1, 10)
        ts_a64_ldp_q_post(cb, 2, 3, 10)
        for r in 0:4 {
            wr := w_regs[r]
            ts_a64_ldp_q_post(cb, 20, 21, wr)
            ts_a64_ldp_q_post(cb, 22, 23, wr)
            ts_a64_fmla_4s(cb, 4 + r, 20, 0)
            ts_a64_fmla_4s(cb, 16 + r, 21, 1)
            ts_a64_fmla_4s(cb, 4 + r, 22, 2)
            ts_a64_fmla_4s(cb, 16 + r, 23, 3)
        }
        ts_a64_sub_imm(cb, 11, 11, 16)
        ts_a64_b_back(cb, c_loop16)

        ts_a64_patch_cond(cb, to_c8, A64_COND_LT)
        c_loop8 := cb.len()
        ts_a64_cmp_imm(cb, 11, 8)
        to_c4 := ts_a64_b_cond_fwd(cb)
        ts_a64_ldp_q_post(cb, 0, 1, 10)
        for r in 0:4 {
            wr := w_regs[r]
            ts_a64_ldp_q_post(cb, 20, 21, wr)
            ts_a64_fmla_4s(cb, 4 + r, 20, 0)
            ts_a64_fmla_4s(cb, 16 + r, 21, 1)
        }
        ts_a64_sub_imm(cb, 11, 11, 8)
        ts_a64_b_back(cb, c_loop8)

        ts_a64_patch_cond(cb, to_c4, A64_COND_LT)
        c_loop4 := cb.len()
        ts_a64_cmp_imm(cb, 11, 4)
        to_fold := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 0, 10)
        for r in 0:4 {
            ts_a64_ldr_q_post(cb, 2, w_regs[r])
            ts_a64_fmla_4s(cb, 4 + r, 2, 0)
        }
        ts_a64_sub_imm(cb, 11, 11, 4)
        ts_a64_b_back(cb, c_loop4)

        ts_a64_patch_cond(cb, to_fold, A64_COND_LT)
        for r in 0:4 { ts_a64_fadd_4s(cb, 4 + r, 4 + r, 16 + r) }
        ts_a64_faddp_4s(cb, 4, 4, 5)
        ts_a64_faddp_4s(cb, 6, 6, 7)
        ts_a64_faddp_4s(cb, 4, 4, 6)

        ts_a64_cmp_imm(cb, 11, 0)
        has_tail := ts_a64_b_cond_fwd(cb)
        ts_a64_str_q_post(cb, 4, 0)
        skip_tail := ts_a64_b_cond_fwd(cb)

        ts_a64_patch_cond(cb, has_tail, A64_COND_GT)
        ts_a64_mov_s_lane(cb, 5, 4, 1)
        ts_a64_mov_s_lane(cb, 6, 4, 2)
        ts_a64_mov_s_lane(cb, 7, 4, 3)
        c_tail := cb.len()
        ts_a64_cmp_imm(cb, 11, 0)
        to_store_t := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_s_post(cb, 0, 10)
        for r in 0:4 {
            ts_a64_ldr_s_post(cb, 1, w_regs[r])
            ts_a64_fmadd_s(cb, 4 + r, 1, 0, 4 + r)
        }
        ts_a64_sub_imm(cb, 11, 11, 1)
        ts_a64_b_back(cb, c_tail)

        ts_a64_patch_cond(cb, to_store_t, A64_COND_LE)
        for r in 0:4 { ts_a64_str_s_post(cb, 4 + r, 0) }
        ts_a64_patch_cond(cb, skip_tail, A64_COND_LE)
    }

    a64_mov(cb, 1, 9)
    ts_a64_sub_imm(cb, 3, 3, 4)
    ts_a64_b_back(cb, loop4_rows)

    ts_a64_patch_cond(cb, to_tail_rows, A64_COND_LT)
    tail_rows := cb.len()
    ts_a64_cmp_imm(cb, 3, 0)
    done_tail := ts_a64_b_cond_fwd(cb)
    a64_mov(cb, 10, 2)
    a64_mov(cb, 11, 4)
    if !fast {
        ts_a64_zero_4s(cb, 4)
        rl4 := cb.len()
        ts_a64_cmp_imm(cb, 11, 4)
        rto_t := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 0, 1)
        ts_a64_ldr_q_post(cb, 1, 10)
        ts_a64_fmul_4s(cb, 0, 0, 1)
        ts_a64_serial_sum_v0(cb, 4)
        ts_a64_sub_imm(cb, 11, 11, 4)
        ts_a64_b_back(cb, rl4)

        ts_a64_patch_cond(cb, rto_t, A64_COND_LT)
        rt := cb.len()
        ts_a64_cmp_imm(cb, 11, 0)
        rdone := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_s_post(cb, 0, 1)
        ts_a64_ldr_s_post(cb, 1, 10)
        ts_a64_fmul_s(cb, 0, 0, 1)
        ts_a64_fadd_s(cb, 4, 4, 0)
        ts_a64_sub_imm(cb, 11, 11, 1)
        ts_a64_b_back(cb, rt)
        ts_a64_patch_cond(cb, rdone, A64_COND_LE)
        ts_a64_str_s_post(cb, 4, 0)
    } else {
        ts_a64_zero_4s(cb, 4)
        ts_a64_zero_4s(cb, 5)
        rl8 := cb.len()
        ts_a64_cmp_imm(cb, 11, 8)
        rto_4 := ts_a64_b_cond_fwd(cb)
        ts_a64_ldp_q_post(cb, 0, 1, 1)
        ts_a64_ldp_q_post(cb, 2, 3, 10)
        ts_a64_fmla_4s(cb, 4, 0, 2)
        ts_a64_fmla_4s(cb, 5, 1, 3)
        ts_a64_sub_imm(cb, 11, 11, 8)
        ts_a64_b_back(cb, rl8)

        ts_a64_patch_cond(cb, rto_4, A64_COND_LT)
        rl4 := cb.len()
        ts_a64_cmp_imm(cb, 11, 4)
        rfold := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 0, 1)
        ts_a64_ldr_q_post(cb, 2, 10)
        ts_a64_fmla_4s(cb, 4, 0, 2)
        ts_a64_sub_imm(cb, 11, 11, 4)
        ts_a64_b_back(cb, rl4)

        ts_a64_patch_cond(cb, rfold, A64_COND_LT)
        ts_a64_fadd_4s(cb, 4, 4, 5)
        ts_a64_faddp_4s(cb, 4, 4, 4)
        ts_a64_faddp_2s(cb, 4, 4)

        rt := cb.len()
        ts_a64_cmp_imm(cb, 11, 0)
        rdone := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_s_post(cb, 0, 1)
        ts_a64_ldr_s_post(cb, 1, 10)
        ts_a64_fmadd_s(cb, 4, 0, 1, 4)
        ts_a64_sub_imm(cb, 11, 11, 1)
        ts_a64_b_back(cb, rt)
        ts_a64_patch_cond(cb, rdone, A64_COND_LE)
        ts_a64_str_s_post(cb, 4, 0)
    }
    ts_a64_sub_imm(cb, 3, 3, 1)
    ts_a64_b_back(cb, tail_rows)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_tail, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_dot_q4_0_q8_0(cb $&mc.CodeBuffer, fast bool) {
    // (qs=x0, ws=x1, xq=x2, xs=x3, n_blocks=x4, acc_bits=x5) -> x0
    ts_a64_cmp_imm(cb, 4, 0)
    positive := ts_a64_b_cond_fwd(cb)
    a64_mov(cb, 0, 5)
    ts_a64_ret(cb)

    ts_a64_patch_cond(cb, positive, A64_COND_GT)
    ts_a64_fmov_s_w(cb, 16, 5)
    ts_a64_movi_16b(cb, 20, 15)
    ts_a64_movi_16b(cb, 21, 8)

    loop_blk := cb.len()
    ts_a64_cmp_imm(cb, 4, 0)
    done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 0)
    ts_a64_and_16b(cb, 1, 0, 20)
    ts_a64_ushr_16b_4(cb, 0, 0)
    ts_a64_sub_16b(cb, 1, 1, 21)
    ts_a64_sub_16b(cb, 0, 0, 21)
    ts_a64_ldr_q_post(cb, 2, 2)
    ts_a64_ldr_q_post(cb, 3, 2)
    ts_a64_zero_4s(cb, 4)
    ts_a64_sdot_4s(cb, 4, 1, 2)
    ts_a64_sdot_4s(cb, 4, 0, 3)
    ts_a64_addv_4s(cb, 4, 4)
    ts_a64_scvtf_s(cb, 4, 4)
    ts_a64_ldr_s_post(cb, 5, 1)
    ts_a64_ldr_s_post(cb, 6, 3)
    ts_a64_fmul_s(cb, 5, 5, 6)
    if fast {
        ts_a64_fmadd_s(cb, 16, 4, 5, 16)
    } else {
        ts_a64_fmul_s(cb, 4, 4, 5)
        ts_a64_fadd_s(cb, 16, 16, 4)
    }
    ts_a64_sub_imm(cb, 4, 4, 1)
    ts_a64_b_back(cb, loop_blk)

    ts_a64_patch_cond(cb, done, A64_COND_LE)
    ts_a64_fmov_w_s(cb, 0, 16)
    ts_a64_ret(cb)
}

fn ts_a64_b_fwd(cb $&mc.CodeBuffer) int {
    at := cb.len()
    e32(cb, 0)
    << at
}

fn ts_a64_patch_b(cb $&mc.CodeBuffer, at int) {
    disp := (cb.len() - at) >> 2
    cb.patch_u32_le(at, 0x14000000 | (disp & 0x3ffffff))
}

fn ts_a64_emit_gemv4_q4_0_q8_0(cb $&mc.CodeBuffer, fast bool) {
    // (out=x0, qs=x1, ws=x2, xq=x3, xs=x4, packed_dims=(rows<<32)|n_blocks in x5)
    ts_a64_mov_w(cb, 6, 5)       // x6 = n_blocks
    ts_a64_lsr_imm(cb, 5, 5, 32) // x5 = rows
    ts_a64_cmp_imm(cb, 5, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_lsl_imm(cb, 7, 6, 4)  // x7 = n_blocks * 16
    ts_a64_lsl_imm(cb, 8, 6, 2)  // x8 = n_blocks * 4
    ts_a64_movi_16b(cb, 20, 15)
    ts_a64_movi_16b(cb, 21, 248) // -8 in i8 for xq offset elimination

    q_regs := [1, 9, 10, 11]
    s_regs := [2, 12, 13, 14]
    loop4_rows := cb.len()
    ts_a64_cmp_imm(cb, 5, 4)
    to_tail_rows := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 9, 1, 7)
    ts_a64_add_reg(cb, 10, 9, 7)
    ts_a64_add_reg(cb, 11, 10, 7)
    ts_a64_add_reg(cb, 12, 2, 8)
    ts_a64_add_reg(cb, 13, 12, 8)
    ts_a64_add_reg(cb, 14, 13, 8)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 15, 6)

    blk4 := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    blk4_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_zero_4s(cb, 24)
    ts_a64_sdot_4s(cb, 24, 2, 21)
    ts_a64_sdot_4s(cb, 24, 3, 21)
    ts_a64_addv_4s(cb, 24, 24)
    ts_a64_dup_4s_0(cb, 24, 24)
    for r in 0:4 {
        ts_a64_ldr_q_post(cb, 0, q_regs[r])
        ts_a64_and_16b(cb, 1, 0, 20)
        ts_a64_ushr_16b_4(cb, 0, 0)
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 1, 2)
        ts_a64_sdot_4s(cb, 4 + r, 0, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 16, 24, &s_regs, fast)
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, blk4)

    ts_a64_patch_cond(cb, blk4_done, A64_COND_LE)
    ts_a64_str_q_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 1)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    a64_mov(cb, 1, 11)
    a64_mov(cb, 2, 14)
    ts_a64_sub_imm(cb, 5, 5, 4)
    ts_a64_b_back(cb, loop4_rows)

    ts_a64_patch_cond(cb, to_tail_rows, A64_COND_LT)
    ts_a64_movi_16b(cb, 21, 8)
    tail_rows := cb.len()
    ts_a64_cmp_imm(cb, 5, 0)
    done_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 15, 6)

    blkt := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    blkt_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_ldr_q_post(cb, 0, 1)
    ts_a64_and_16b(cb, 1, 0, 20)
    ts_a64_ushr_16b_4(cb, 0, 0)
    ts_a64_sub_16b(cb, 1, 1, 21)
    ts_a64_sub_16b(cb, 0, 0, 21)
    ts_a64_zero_4s(cb, 4)
    ts_a64_sdot_4s(cb, 4, 1, 2)
    ts_a64_sdot_4s(cb, 4, 0, 3)
    ts_a64_addv_4s(cb, 4, 4)
    ts_a64_scvtf_s(cb, 4, 4)
    ts_a64_ldr_s_post(cb, 23, 2)
    ts_a64_fmul_s(cb, 23, 23, 22)
    if fast {
        ts_a64_fmadd_s(cb, 16, 4, 23, 16)
    } else {
        ts_a64_fmul_s(cb, 4, 4, 23)
        ts_a64_fadd_s(cb, 16, 16, 4)
    }
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, blkt)

    ts_a64_patch_cond(cb, blkt_done, A64_COND_LE)
    ts_a64_str_s_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 1)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_b_back(cb, tail_rows)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_tail, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_quantize4_strict_2s(cb $&mc.CodeBuffer, src int, dst_s int) {
    // Expects v2[0]=inv (f64), v26=[0.5, 0.5], v27=[-0.0, -0.0]. Clobbers v16, v17, v18.
    ts_a64_fcvtl_2d(cb, 16, src)
    ts_a64_fcvtl2_2d(cb, 17, src)
    ts_a64_fmul_2d_elem0(cb, 16, 16, 2)
    ts_a64_fmul_2d_elem0(cb, 17, 17, 2)
    ts_a64_and_16b(cb, 18, 16, 27)
    ts_a64_orr_16b(cb, 18, 18, 26)
    ts_a64_fadd_2d(cb, 16, 16, 18)
    ts_a64_and_16b(cb, 18, 17, 27)
    ts_a64_orr_16b(cb, 18, 18, 26)
    ts_a64_fadd_2d(cb, 17, 17, 18)
    ts_a64_fcvtzs_2d(cb, 16, 16)
    ts_a64_fcvtzs_2d(cb, 17, 17)
    ts_a64_sqxtn_2s(cb, dst_s, 16)
    ts_a64_sqxtn2_4s(cb, dst_s, 17)
}

fn ts_a64_emit_quantize_q8_0(cb $&mc.CodeBuffer, fast bool) {
    // (x=x0, xq=x1, xs=x2, nb=x3)
    ts_a64_cmp_imm(cb, 3, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_fmov_d_127(cb, 24, 9)
    ts_a64_movi_16b(cb, 25, 129) // -127
    if !fast {
        e32(cb, 0xD2E00009 | (0x3fe0 << 5)) // movz x9, #0x3fe0, lsl #48 (0.5)
        ts_a64_dup_2d(cb, 26, 9)
        e32(cb, 0xD2E00009 | (0x8000 << 5)) // movz x9, #0x8000, lsl #48 (-0.0 sign mask)
        ts_a64_dup_2d(cb, 27, 9)
    }

    blk_loop := cb.len()
    ts_a64_cmp_imm(cb, 3, 0)
    done := ts_a64_b_cond_fwd(cb)

    a64_mov(cb, 4, 0)
    ts_a64_ldp_q_post(cb, 0, 1, 4)
    ts_a64_fabs_4s(cb, 0, 0)
    ts_a64_fabs_4s(cb, 1, 1)
    ts_a64_fmaxnm_4s(cb, 0, 0, 1)
    ts_a64_ldp_q_post(cb, 2, 3, 4)
    ts_a64_fabs_4s(cb, 2, 2)
    ts_a64_fabs_4s(cb, 3, 3)
    ts_a64_fmaxnm_4s(cb, 2, 2, 3)
    ts_a64_fmaxnm_4s(cb, 0, 0, 2)
    ts_a64_ldp_q_post(cb, 4, 5, 4)
    ts_a64_fabs_4s(cb, 4, 4)
    ts_a64_fabs_4s(cb, 5, 5)
    ts_a64_fmaxnm_4s(cb, 4, 4, 5)
    ts_a64_ldp_q_post(cb, 6, 7, 4)
    ts_a64_fabs_4s(cb, 6, 6)
    ts_a64_fabs_4s(cb, 7, 7)
    ts_a64_fmaxnm_4s(cb, 6, 6, 7)
    ts_a64_fmaxnm_4s(cb, 4, 4, 6)
    ts_a64_fmaxnm_4s(cb, 0, 0, 4)
    ts_a64_fmaxnmv_4s(cb, 0, 0)

    ts_a64_fcvt_ds(cb, 0, 0)
    ts_a64_fdiv_d(cb, 1, 0, 24)
    ts_a64_fcvt_sd(cb, 1, 1)
    ts_a64_str_s_post(cb, 1, 2)
    ts_a64_fcvt_ds(cb, 1, 1)
    ts_a64_fcmp_d0(cb, 1)
    br_zero := ts_a64_b_cond_fwd(cb)
    e32(cb, 0x1E6E1002) // fmov d2, #1.0
    ts_a64_fdiv_d(cb, 2, 2, 1)
    br_have_inv := ts_a64_b_fwd(cb)
    ts_a64_patch_cond(cb, br_zero, A64_COND_EQ)
    ts_a64_fmov_d_zero(cb, 2)
    ts_a64_patch_b(cb, br_have_inv)

    if !fast {
        dst_regs := [6, 7]
        for h in 0:2 {
            ts_a64_ldp_q_post(cb, 0, 1, 0)
            ts_a64_ldp_q_post(cb, 4, 5, 0)
            ts_a64_quantize4_strict_2s(cb, 0, 19)
            ts_a64_sqxtn_4h(cb, 20, 19)
            ts_a64_quantize4_strict_2s(cb, 1, 19)
            ts_a64_sqxtn2_8h(cb, 20, 19)
            ts_a64_sqxtn_8b(cb, dst_regs[h], 20)
            ts_a64_quantize4_strict_2s(cb, 4, 19)
            ts_a64_sqxtn_4h(cb, 20, 19)
            ts_a64_quantize4_strict_2s(cb, 5, 19)
            ts_a64_sqxtn2_8h(cb, 20, 19)
            ts_a64_sqxtn2_16b(cb, dst_regs[h], 20)
            ts_a64_smax_16b(cb, dst_regs[h], dst_regs[h], 25)
        }
        ts_a64_stp_q_post(cb, 6, 7, 1)
    } else {
        ts_a64_fcvt_sd(cb, 2, 2)
        dst_regs := [6, 7]
        for h in 0:2 {
            ts_a64_ldp_q_post(cb, 0, 1, 0)
            ts_a64_ldp_q_post(cb, 4, 5, 0)
            ts_a64_fmul_4s_elem0(cb, 0, 0, 2)
            ts_a64_fmul_4s_elem0(cb, 1, 1, 2)
            ts_a64_fmul_4s_elem0(cb, 4, 4, 2)
            ts_a64_fmul_4s_elem0(cb, 5, 5, 2)
            ts_a64_fcvtas_4s(cb, 0, 0)
            ts_a64_fcvtas_4s(cb, 1, 1)
            ts_a64_fcvtas_4s(cb, 4, 4)
            ts_a64_fcvtas_4s(cb, 5, 5)
            ts_a64_sqxtn_4h(cb, 19, 0)
            ts_a64_sqxtn2_8h(cb, 19, 1)
            ts_a64_sqxtn_8b(cb, dst_regs[h], 19)
            ts_a64_sqxtn_4h(cb, 19, 4)
            ts_a64_sqxtn2_8h(cb, 19, 5)
            ts_a64_sqxtn2_16b(cb, dst_regs[h], 19)
            ts_a64_smax_16b(cb, dst_regs[h], dst_regs[h], 25)
        }
        ts_a64_stp_q_post(cb, 6, 7, 1)
    }

    ts_a64_sub_imm(cb, 3, 3, 1)
    ts_a64_b_back(cb, blk_loop)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_gemv4_q8_0_q8_0(cb $&mc.CodeBuffer, fast bool) {
    // (out=x0, w_qs=x1, w_scales=x2, xq=x3, xs=x4, packed_dims=(rows<<32)|n_blocks in x5)
    ts_a64_mov_w(cb, 6, 5)       // x6 = n_blocks
    ts_a64_lsr_imm(cb, 5, 5, 32) // x5 = rows
    ts_a64_cmp_imm(cb, 5, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_lsl_imm(cb, 7, 6, 5)  // x7 = n_blocks * 32
    ts_a64_lsl_imm(cb, 8, 6, 2)  // x8 = n_blocks * 4

    q_regs := [1, 9, 10, 11]
    s_regs := [2, 12, 13, 14]
    loop4_rows := cb.len()
    ts_a64_cmp_imm(cb, 5, 4)
    to_tail_rows := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 9, 1, 7)
    ts_a64_add_reg(cb, 10, 9, 7)
    ts_a64_add_reg(cb, 11, 10, 7)
    ts_a64_add_reg(cb, 12, 2, 8)
    ts_a64_add_reg(cb, 13, 12, 8)
    ts_a64_add_reg(cb, 14, 13, 8)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 15, 6)

    blk4 := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    blk4_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    for r in 0:4 {
        ts_a64_ldp_q_post(cb, 0, 1, q_regs[r])
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 0, 2)
        ts_a64_sdot_4s(cb, 4 + r, 1, 3)
    }
    ts_a64_sdot_reduce4(cb, 16, &s_regs, fast)
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, blk4)

    ts_a64_patch_cond(cb, blk4_done, A64_COND_LE)
    ts_a64_str_q_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 0)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    a64_mov(cb, 1, 11)
    a64_mov(cb, 2, 14)
    ts_a64_sub_imm(cb, 5, 5, 4)
    ts_a64_b_back(cb, loop4_rows)

    ts_a64_patch_cond(cb, to_tail_rows, A64_COND_LT)
    tail_rows := cb.len()
    ts_a64_cmp_imm(cb, 5, 0)
    done_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 15, 6)

    blkt := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    blkt_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_ldp_q_post(cb, 0, 1, 1)
    ts_a64_zero_4s(cb, 4)
    ts_a64_sdot_4s(cb, 4, 0, 2)
    ts_a64_sdot_4s(cb, 4, 1, 3)
    ts_a64_addv_4s(cb, 4, 4)
    ts_a64_scvtf_s(cb, 4, 4)
    ts_a64_ldr_s_post(cb, 23, 2)
    ts_a64_fmul_s(cb, 23, 23, 22)
    if fast {
        ts_a64_fmadd_s(cb, 16, 4, 23, 16)
    } else {
        ts_a64_fmul_s(cb, 4, 4, 23)
        ts_a64_fadd_s(cb, 16, 16, 4)
    }
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, blkt)

    ts_a64_patch_cond(cb, blkt_done, A64_COND_LE)
    ts_a64_str_s_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 0)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_b_back(cb, tail_rows)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_tail, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_gemm4x4_f32(cb $&mc.CodeBuffer, fast bool) {
    // (out=x0, w=x1, x=x2, M=x3, N=x4, K=x5)
    ts_a64_cmp_imm(cb, 3, 0)
    early_m := ts_a64_b_cond_fwd(cb)
    ts_a64_cmp_imm(cb, 4, 0)
    early_n := ts_a64_b_cond_fwd(cb)

    ts_a64_save_x19_x26_frame128(cb)
    a64_mov(cb, 26, 5)          // x26 = K
    ts_a64_lsl_imm(cb, 25, 5, 2) // x25 = K * 4
    a64_mov(cb, 24, 4)          // x24 = N
    ts_a64_lsl_imm(cb, 23, 4, 2) // x23 = N * 4
    ts_a64_str_sp_u64(cb, 1, 0)  // [slot 0] = w_base
    ts_a64_str_sp_u64(cb, 2, 1)  // [slot 1] = x_m
    ts_a64_str_sp_u64(cb, 0, 2)  // [slot 2] = out_m
    ts_a64_str_sp_u64(cb, 3, 3)  // [slot 3] = M_rem

    out_regs := [19, 20, 21, 22]
    w_regs := [1, 6, 7, 9]
    x_regs := [10, 11, 12, 13]

    m_loop4 := cb.len()
    ts_a64_ldr_sp_u64(cb, 5, 3)
    ts_a64_cmp_imm(cb, 5, 4)
    to_m_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_sp_u64(cb, 1, 0)
    ts_a64_ldr_sp_u64(cb, 19, 2)
    ts_a64_add_reg(cb, 20, 19, 23)
    ts_a64_add_reg(cb, 21, 20, 23)
    ts_a64_add_reg(cb, 22, 21, 23)
    a64_mov(cb, 15, 24) // n_rem

    n_loop4 := cb.len()
    ts_a64_cmp_imm(cb, 15, 4)
    to_n_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 6, 1, 25)
    ts_a64_add_reg(cb, 7, 6, 25)
    ts_a64_add_reg(cb, 9, 7, 25)
    ts_a64_ldr_sp_u64(cb, 10, 1)
    ts_a64_add_reg(cb, 11, 10, 25)
    ts_a64_add_reg(cb, 12, 11, 25)
    ts_a64_add_reg(cb, 13, 12, 25)
    a64_mov(cb, 14, 26)
    for v in 16:32 { ts_a64_zero_4s(cb, v) }

    if !fast {
        k_loop4 := cb.len()
        ts_a64_cmp_imm(cb, 14, 4)
        to_k_tail := ts_a64_b_cond_fwd(cb)
        for t in 0:4 { ts_a64_ldr_q_post(cb, 4 + t, x_regs[t]) }
        for r in 0:4 {
            ts_a64_ldr_q_post(cb, 1, w_regs[r])
            for t in 0:4 {
                ts_a64_fmul_4s(cb, 0, 1, 4 + t)
                ts_a64_serial_sum_v0(cb, 16 + t * 4 + r)
            }
        }
        ts_a64_sub_imm(cb, 14, 14, 4)
        ts_a64_b_back(cb, k_loop4)

        ts_a64_patch_cond(cb, to_k_tail, A64_COND_LT)
        k_tail := cb.len()
        ts_a64_cmp_imm(cb, 14, 0)
        to_k_store := ts_a64_b_cond_fwd(cb)
        for t in 0:4 { ts_a64_ldr_s_post(cb, 4 + t, x_regs[t]) }
        for r in 0:4 {
            ts_a64_ldr_s_post(cb, 1, w_regs[r])
            for t in 0:4 {
                ts_a64_fmul_s(cb, 0, 1, 4 + t)
                ts_a64_fadd_s(cb, 16 + t * 4 + r, 16 + t * 4 + r, 0)
            }
        }
        ts_a64_sub_imm(cb, 14, 14, 1)
        ts_a64_b_back(cb, k_tail)

        ts_a64_patch_cond(cb, to_k_store, A64_COND_LE)
        for t in 0:4 {
            for r in 0:4 {
                ts_a64_str_s_post(cb, 16 + t * 4 + r, out_regs[t])
            }
        }
    } else {
        k_loop4 := cb.len()
        ts_a64_cmp_imm(cb, 14, 4)
        to_k_fold := ts_a64_b_cond_fwd(cb)
        for t in 0:4 { ts_a64_ldr_q_post(cb, 4 + t, x_regs[t]) }
        for r in 0:4 {
            ts_a64_ldr_q_post(cb, 0, w_regs[r])
            for t in 0:4 {
                ts_a64_fmla_4s(cb, 16 + t * 4 + r, 0, 4 + t)
            }
        }
        ts_a64_sub_imm(cb, 14, 14, 4)
        ts_a64_b_back(cb, k_loop4)

        ts_a64_patch_cond(cb, to_k_fold, A64_COND_LT)
        for t in 0:4 {
            b := 16 + t * 4
            ts_a64_faddp_4s(cb, b, b, b + 1)
            ts_a64_faddp_4s(cb, b + 2, b + 2, b + 3)
            ts_a64_faddp_4s(cb, b, b, b + 2)
        }
        ts_a64_cmp_imm(cb, 14, 0)
        has_kt := ts_a64_b_cond_fwd(cb)
        for t in 0:4 { ts_a64_str_q_post(cb, 16 + t * 4, out_regs[t]) }
        skip_kt := ts_a64_b_fwd(cb)

        ts_a64_patch_cond(cb, has_kt, A64_COND_GT)
        for t in 0:4 {
            b := 16 + t * 4
            ts_a64_mov_s_lane(cb, b + 1, b, 1)
            ts_a64_mov_s_lane(cb, b + 2, b, 2)
            ts_a64_mov_s_lane(cb, b + 3, b, 3)
        }
        k_tail := cb.len()
        ts_a64_cmp_imm(cb, 14, 0)
        to_st := ts_a64_b_cond_fwd(cb)
        for t in 0:4 { ts_a64_ldr_s_post(cb, 4 + t, x_regs[t]) }
        for r in 0:4 {
            ts_a64_ldr_s_post(cb, 0, w_regs[r])
            for t in 0:4 {
                b := 16 + t * 4 + r
                ts_a64_fmadd_s(cb, b, 0, 4 + t, b)
            }
        }
        ts_a64_sub_imm(cb, 14, 14, 1)
        ts_a64_b_back(cb, k_tail)

        ts_a64_patch_cond(cb, to_st, A64_COND_LE)
        for t in 0:4 {
            for r in 0:4 {
                ts_a64_str_s_post(cb, 16 + t * 4 + r, out_regs[t])
            }
        }
        ts_a64_patch_b(cb, skip_kt)
    }

    a64_mov(cb, 1, 9)
    ts_a64_sub_imm(cb, 15, 15, 4)
    ts_a64_b_back(cb, n_loop4)

    ts_a64_patch_cond(cb, to_n_tail, A64_COND_LT)
    n_tail := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    done_n_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_sp_u64(cb, 10, 1)
    ts_a64_add_reg(cb, 11, 10, 25)
    ts_a64_add_reg(cb, 12, 11, 25)
    ts_a64_add_reg(cb, 13, 12, 25)
    a64_mov(cb, 14, 26)
    for t in 0:4 { ts_a64_zero_4s(cb, 16 + t) }

    if !fast {
        nt_loop4 := cb.len()
        ts_a64_cmp_imm(cb, 14, 4)
        nt_to_t := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 1, 1)
        for t in 0:4 {
            ts_a64_ldr_q_post(cb, 2, x_regs[t])
            ts_a64_fmul_4s(cb, 0, 1, 2)
            ts_a64_serial_sum_v0(cb, 16 + t)
        }
        ts_a64_sub_imm(cb, 14, 14, 4)
        ts_a64_b_back(cb, nt_loop4)
        ts_a64_patch_cond(cb, nt_to_t, A64_COND_LT)
    } else {
        nt_loop4 := cb.len()
        ts_a64_cmp_imm(cb, 14, 4)
        nt_to_fold := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 0, 1)
        for t in 0:4 {
            ts_a64_ldr_q_post(cb, 2, x_regs[t])
            ts_a64_fmla_4s(cb, 16 + t, 0, 2)
        }
        ts_a64_sub_imm(cb, 14, 14, 4)
        ts_a64_b_back(cb, nt_loop4)
        ts_a64_patch_cond(cb, nt_to_fold, A64_COND_LT)
        for t in 0:4 {
            ts_a64_faddp_4s(cb, 16 + t, 16 + t, 16 + t)
            ts_a64_faddp_2s(cb, 16 + t, 16 + t)
        }
    }
    nt_tail := cb.len()
    ts_a64_cmp_imm(cb, 14, 0)
    nt_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 0, 1)
    for t in 0:4 {
        ts_a64_ldr_s_post(cb, 1, x_regs[t])
        if fast {
            ts_a64_fmadd_s(cb, 16 + t, 0, 1, 16 + t)
        } else {
            ts_a64_fmul_s(cb, 1, 0, 1)
            ts_a64_fadd_s(cb, 16 + t, 16 + t, 1)
        }
    }
    ts_a64_sub_imm(cb, 14, 14, 1)
    ts_a64_b_back(cb, nt_tail)
    ts_a64_patch_cond(cb, nt_done, A64_COND_LE)
    for t in 0:4 { ts_a64_str_s_post(cb, 16 + t, out_regs[t]) }
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, n_tail)

    ts_a64_patch_cond(cb, done_n_tail, A64_COND_LE)
    ts_a64_ldr_sp_u64(cb, 5, 1)
    ts_a64_add_reg_lsl(cb, 5, 5, 25, 2)
    ts_a64_str_sp_u64(cb, 5, 1)
    ts_a64_ldr_sp_u64(cb, 5, 2)
    ts_a64_add_reg_lsl(cb, 5, 5, 23, 2)
    ts_a64_str_sp_u64(cb, 5, 2)
    ts_a64_ldr_sp_u64(cb, 5, 3)
    ts_a64_sub_imm(cb, 5, 5, 4)
    ts_a64_str_sp_u64(cb, 5, 3)
    ts_a64_b_back(cb, m_loop4)

    ts_a64_patch_cond(cb, to_m_tail, A64_COND_LT)
    m_tail := cb.len()
    ts_a64_ldr_sp_u64(cb, 5, 3)
    ts_a64_cmp_imm(cb, 5, 0)
    done_all := ts_a64_b_cond_fwd(cb)

    ts_a64_ldr_sp_u64(cb, 1, 0)
    ts_a64_ldr_sp_u64(cb, 19, 2)
    a64_mov(cb, 15, 24)
    mt_n4 := cb.len()
    ts_a64_cmp_imm(cb, 15, 4)
    to_mt_n1 := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 6, 1, 25)
    ts_a64_add_reg(cb, 7, 6, 25)
    ts_a64_add_reg(cb, 9, 7, 25)
    ts_a64_ldr_sp_u64(cb, 10, 1)
    a64_mov(cb, 14, 26)
    for r in 0:4 { ts_a64_zero_4s(cb, 16 + r) }
    mt_k4 := cb.len()
    ts_a64_cmp_imm(cb, 14, 4)
    to_mt_kt := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 1, 10)
    for r in 0:4 {
        ts_a64_ldr_q_post(cb, 2, w_regs[r])
        if fast {
            ts_a64_fmla_4s(cb, 16 + r, 2, 1)
        } else {
            ts_a64_fmul_4s(cb, 0, 2, 1)
            ts_a64_serial_sum_v0(cb, 16 + r)
        }
    }
    ts_a64_sub_imm(cb, 14, 14, 4)
    ts_a64_b_back(cb, mt_k4)
    ts_a64_patch_cond(cb, to_mt_kt, A64_COND_LT)
    if fast {
        ts_a64_faddp_4s(cb, 16, 16, 17)
        ts_a64_faddp_4s(cb, 18, 18, 19)
        ts_a64_faddp_4s(cb, 16, 16, 18)
        ts_a64_mov_s_lane(cb, 17, 16, 1)
        ts_a64_mov_s_lane(cb, 18, 16, 2)
        ts_a64_mov_s_lane(cb, 19, 16, 3)
    }
    mt_kt := cb.len()
    ts_a64_cmp_imm(cb, 14, 0)
    to_mt_st := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 1, 10)
    for r in 0:4 {
        ts_a64_ldr_s_post(cb, 0, w_regs[r])
        if fast {
            ts_a64_fmadd_s(cb, 16 + r, 0, 1, 16 + r)
        } else {
            ts_a64_fmul_s(cb, 0, 0, 1)
            ts_a64_fadd_s(cb, 16 + r, 16 + r, 0)
        }
    }
    ts_a64_sub_imm(cb, 14, 14, 1)
    ts_a64_b_back(cb, mt_kt)
    ts_a64_patch_cond(cb, to_mt_st, A64_COND_LE)
    for r in 0:4 { ts_a64_str_s_post(cb, 16 + r, 19) }
    a64_mov(cb, 1, 9)
    ts_a64_sub_imm(cb, 15, 15, 4)
    ts_a64_b_back(cb, mt_n4)

    ts_a64_patch_cond(cb, to_mt_n1, A64_COND_LT)
    mt_n1 := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    done_mt_n := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_sp_u64(cb, 10, 1)
    a64_mov(cb, 14, 26)
    ts_a64_zero_4s(cb, 16)
    mt1_k4 := cb.len()
    ts_a64_cmp_imm(cb, 14, 4)
    to_mt1_kt := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 2, 1)
    ts_a64_ldr_q_post(cb, 1, 10)
    if fast {
        ts_a64_fmla_4s(cb, 16, 2, 1)
    } else {
        ts_a64_fmul_4s(cb, 0, 2, 1)
        ts_a64_serial_sum_v0(cb, 16)
    }
    ts_a64_sub_imm(cb, 14, 14, 4)
    ts_a64_b_back(cb, mt1_k4)
    ts_a64_patch_cond(cb, to_mt1_kt, A64_COND_LT)
    if fast {
        ts_a64_faddp_4s(cb, 16, 16, 16)
        ts_a64_faddp_2s(cb, 16, 16)
    }
    mt1_kt := cb.len()
    ts_a64_cmp_imm(cb, 14, 0)
    to_mt1_st := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 0, 1)
    ts_a64_ldr_s_post(cb, 1, 10)
    if fast {
        ts_a64_fmadd_s(cb, 16, 0, 1, 16)
    } else {
        ts_a64_fmul_s(cb, 0, 0, 1)
        ts_a64_fadd_s(cb, 16, 16, 0)
    }
    ts_a64_sub_imm(cb, 14, 14, 1)
    ts_a64_b_back(cb, mt1_kt)
    ts_a64_patch_cond(cb, to_mt1_st, A64_COND_LE)
    ts_a64_str_s_post(cb, 16, 19)
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, mt_n1)

    ts_a64_patch_cond(cb, done_mt_n, A64_COND_LE)
    ts_a64_ldr_sp_u64(cb, 5, 1)
    ts_a64_add_reg(cb, 5, 5, 25)
    ts_a64_str_sp_u64(cb, 5, 1)
    ts_a64_ldr_sp_u64(cb, 5, 2)
    ts_a64_add_reg(cb, 5, 5, 23)
    ts_a64_str_sp_u64(cb, 5, 2)
    ts_a64_ldr_sp_u64(cb, 5, 3)
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_str_sp_u64(cb, 5, 3)
    ts_a64_b_back(cb, m_tail)

    ts_a64_patch_cond(cb, done_all, A64_COND_LE)
    ts_a64_restore_x19_x26_frame128(cb)
    ts_a64_patch_cond(cb, early_m, A64_COND_LE)
    ts_a64_patch_cond(cb, early_n, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_gemm4x4_q4_0_q8_0(cb $&mc.CodeBuffer, fast bool) {
    // (out=x0, qs=x1, ws=x2, xq=x3, xs=x4, packed=(M<<42)|(N<<21)|nb in x5)
    ts_a64_and_21(cb, 6, 5)      // x6 = nb
    ts_a64_ubfx_21(cb, 7, 5, 21) // x7 = N
    ts_a64_ubfx_21(cb, 8, 5, 42) // x8 = M
    ts_a64_cmp_imm(cb, 8, 0)
    early_m := ts_a64_b_cond_fwd(cb)
    ts_a64_cmp_imm(cb, 7, 0)
    early_n := ts_a64_b_cond_fwd(cb)

    ts_a64_save_x19_x26_frame128(cb)
    ts_a64_str_sp_u64(cb, 1, 0) // slot 0 = qs_base
    ts_a64_str_sp_u64(cb, 2, 1) // slot 1 = ws_base
    ts_a64_str_sp_u64(cb, 7, 2) // slot 2 = N
    ts_a64_str_sp_u64(cb, 6, 3) // slot 3 = nb
    ts_a64_str_sp_u64(cb, 3, 4) // slot 4 = xq_m
    ts_a64_str_sp_u64(cb, 4, 5) // slot 5 = xs_m
    ts_a64_str_sp_u64(cb, 0, 6) // slot 6 = out_m
    ts_a64_str_sp_u64(cb, 8, 7) // slot 7 = M_rem

    ts_a64_movi_16b(cb, 20, 15)
    ts_a64_movi_16b(cb, 21, 8)
    ts_a64_mov_w(cb, 25, 6)     // x25 = nb
    ts_a64_lsl_imm(cb, 7, 25, 4) // x7 = nb * 16
    ts_a64_lsl_imm(cb, 8, 25, 2) // x8 = nb * 4

    q_regs := [1, 9, 10, 11]
    s_regs := [2, 12, 13, 14]
    xq_regs := [3, 15, 16, 17]
    xs_regs := [4, 19, 20, 26]
    out_regs := [0, 21, 22, 23]

    m_loop4 := cb.len()
    ts_a64_ldr_sp_u64(cb, 5, 7)
    ts_a64_cmp_imm(cb, 5, 4)
    to_m_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_sp_u64(cb, 24, 2) // n_rem = N
    ts_a64_lsl_imm(cb, 5, 24, 2) // N * 4
    ts_a64_ldr_sp_u64(cb, 0, 6)
    ts_a64_add_reg(cb, 21, 0, 5)
    ts_a64_add_reg(cb, 22, 21, 5)
    ts_a64_add_reg(cb, 23, 22, 5)
    ts_a64_ldr_sp_u64(cb, 1, 0)
    ts_a64_ldr_sp_u64(cb, 2, 1)

    n_loop4 := cb.len()
    ts_a64_cmp_imm(cb, 24, 4)
    to_n_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 9, 1, 7)
    ts_a64_add_reg(cb, 10, 9, 7)
    ts_a64_add_reg(cb, 11, 10, 7)
    ts_a64_add_reg(cb, 12, 2, 8)
    ts_a64_add_reg(cb, 13, 12, 8)
    ts_a64_add_reg(cb, 14, 13, 8)

    ts_a64_lsl_imm(cb, 5, 25, 5) // nb * 32
    ts_a64_ldr_sp_u64(cb, 3, 4)
    ts_a64_add_reg(cb, 15, 3, 5)
    ts_a64_add_reg(cb, 16, 15, 5)
    ts_a64_add_reg(cb, 17, 16, 5)
    ts_a64_ldr_sp_u64(cb, 4, 5)
    ts_a64_add_reg(cb, 19, 4, 8)
    ts_a64_add_reg(cb, 20, 19, 8)
    ts_a64_add_reg(cb, 26, 20, 8)

    for t in 0:4 { ts_a64_zero_4s(cb, 16 + t) }
    a64_mov(cb, 5, 25) // b_cnt = nb

    blk4 := cb.len()
    ts_a64_cmp_imm(cb, 5, 0)
    blk4_done := ts_a64_b_cond_fwd(cb)
    for r in 0:4 {
        ts_a64_ldr_q_post(cb, 0, q_regs[r])
        ts_a64_and_16b(cb, 24 + r, 0, 20)
        ts_a64_ushr_16b_4(cb, 0, 0)
        ts_a64_sub_16b(cb, 24 + r, 24 + r, 21)
        ts_a64_sub_16b(cb, 28 + r, 0, 21)
        ts_a64_ld1_s_lane_post(cb, 23, r, s_regs[r])
    }
    for t in 0:4 {
        ts_a64_ldp_q_post(cb, 2, 3, xq_regs[t])
        ts_a64_ldr_s_post(cb, 22, xs_regs[t])
        for r in 0:4 {
            ts_a64_zero_4s(cb, 4 + r)
            ts_a64_sdot_4s(cb, 4 + r, 24 + r, 2)
            ts_a64_sdot_4s(cb, 4 + r, 28 + r, 3)
        }
        ts_a64_addp_4s(cb, 4, 4, 5)
        ts_a64_addp_4s(cb, 6, 6, 7)
        ts_a64_addp_4s(cb, 4, 4, 6)
        ts_a64_scvtf_4s(cb, 4, 4)
        ts_a64_fmul_4s_elem0(cb, 1, 23, 22)
        if fast {
            ts_a64_fmla_4s(cb, 16 + t, 4, 1)
        } else {
            ts_a64_fmul_4s(cb, 4, 4, 1)
            ts_a64_fadd_4s(cb, 16 + t, 16 + t, 4)
        }
    }
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_b_back(cb, blk4)

    ts_a64_patch_cond(cb, blk4_done, A64_COND_LE)
    for t in 0:4 { ts_a64_str_q_post(cb, 16 + t, out_regs[t]) }
    a64_mov(cb, 1, 11)
    a64_mov(cb, 2, 14)
    ts_a64_sub_imm(cb, 24, 24, 4)
    ts_a64_b_back(cb, n_loop4)

    ts_a64_patch_cond(cb, to_n_tail, A64_COND_LT)
    n_tail := cb.len()
    ts_a64_cmp_imm(cb, 24, 0)
    done_n_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_lsl_imm(cb, 5, 25, 5)
    ts_a64_ldr_sp_u64(cb, 3, 4)
    ts_a64_add_reg(cb, 15, 3, 5)
    ts_a64_add_reg(cb, 16, 15, 5)
    ts_a64_add_reg(cb, 17, 16, 5)
    ts_a64_ldr_sp_u64(cb, 4, 5)
    ts_a64_add_reg(cb, 19, 4, 8)
    ts_a64_add_reg(cb, 20, 19, 8)
    ts_a64_add_reg(cb, 26, 20, 8)
    for t in 0:4 { ts_a64_zero_4s(cb, 16 + t) }
    a64_mov(cb, 5, 25)

    blkt := cb.len()
    ts_a64_cmp_imm(cb, 5, 0)
    blkt_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 0, 1)
    ts_a64_and_16b(cb, 24, 0, 20)
    ts_a64_ushr_16b_4(cb, 0, 0)
    ts_a64_sub_16b(cb, 24, 24, 21)
    ts_a64_sub_16b(cb, 28, 0, 21)
    ts_a64_ldr_s_post(cb, 23, 2)
    for t in 0:4 {
        ts_a64_ldp_q_post(cb, 2, 3, xq_regs[t])
        ts_a64_ldr_s_post(cb, 22, xs_regs[t])
        ts_a64_zero_4s(cb, 4)
        ts_a64_sdot_4s(cb, 4, 24, 2)
        ts_a64_sdot_4s(cb, 4, 28, 3)
        ts_a64_addv_4s(cb, 4, 4)
        ts_a64_scvtf_s(cb, 4, 4)
        ts_a64_fmul_s(cb, 1, 23, 22)
        if fast {
            ts_a64_fmadd_s(cb, 16 + t, 4, 1, 16 + t)
        } else {
            ts_a64_fmul_s(cb, 4, 4, 1)
            ts_a64_fadd_s(cb, 16 + t, 16 + t, 4)
        }
    }
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_b_back(cb, blkt)

    ts_a64_patch_cond(cb, blkt_done, A64_COND_LE)
    for t in 0:4 { ts_a64_str_s_post(cb, 16 + t, out_regs[t]) }
    ts_a64_sub_imm(cb, 24, 24, 1)
    ts_a64_b_back(cb, n_tail)

    ts_a64_patch_cond(cb, done_n_tail, A64_COND_LE)
    ts_a64_ldr_sp_u64(cb, 5, 4)
    ts_a64_add_reg_lsl(cb, 5, 5, 25, 7) // nb * 128 bytes (= nb << 7)
    ts_a64_str_sp_u64(cb, 5, 4)
    ts_a64_ldr_sp_u64(cb, 5, 5)
    ts_a64_add_reg_lsl(cb, 5, 5, 8, 2)  // nb*4 * 4 = nb * 16 bytes
    ts_a64_str_sp_u64(cb, 5, 5)
    ts_a64_ldr_sp_u64(cb, 6, 2)
    ts_a64_ldr_sp_u64(cb, 5, 6)
    ts_a64_add_reg_lsl(cb, 5, 5, 6, 4)  // N * 16 bytes
    ts_a64_str_sp_u64(cb, 5, 6)
    ts_a64_ldr_sp_u64(cb, 5, 7)
    ts_a64_sub_imm(cb, 5, 5, 4)
    ts_a64_str_sp_u64(cb, 5, 7)
    ts_a64_b_back(cb, m_loop4)

    // M tail (1..3 tokens)
    ts_a64_patch_cond(cb, to_m_tail, A64_COND_LT)
    m_tail := cb.len()
    ts_a64_ldr_sp_u64(cb, 5, 7)
    ts_a64_cmp_imm(cb, 5, 0)
    done_all := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_sp_u64(cb, 0, 6)
    ts_a64_ldr_sp_u64(cb, 1, 0)
    ts_a64_ldr_sp_u64(cb, 2, 1)
    ts_a64_ldr_sp_u64(cb, 3, 4)
    ts_a64_ldr_sp_u64(cb, 4, 5)
    ts_a64_ldr_sp_u64(cb, 24, 2)

    mt_n4 := cb.len()
    ts_a64_cmp_imm(cb, 24, 4)
    to_mt_n1 := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 9, 1, 7)
    ts_a64_add_reg(cb, 10, 9, 7)
    ts_a64_add_reg(cb, 11, 10, 7)
    ts_a64_add_reg(cb, 12, 2, 8)
    ts_a64_add_reg(cb, 13, 12, 8)
    ts_a64_add_reg(cb, 14, 13, 8)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 15, 25)
    mt_b4 := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    mt_b4_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    for r in 0:4 {
        ts_a64_ldr_q_post(cb, 0, q_regs[r])
        ts_a64_and_16b(cb, 1, 0, 20)
        ts_a64_ushr_16b_4(cb, 0, 0)
        ts_a64_sub_16b(cb, 1, 1, 21)
        ts_a64_sub_16b(cb, 0, 0, 21)
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 1, 2)
        ts_a64_sdot_4s(cb, 4 + r, 0, 3)
    }
    ts_a64_sdot_reduce4(cb, 16, &s_regs, fast)
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, mt_b4)
    ts_a64_patch_cond(cb, mt_b4_done, A64_COND_LE)
    ts_a64_str_q_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 1)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    a64_mov(cb, 1, 11)
    a64_mov(cb, 2, 14)
    ts_a64_sub_imm(cb, 24, 24, 4)
    ts_a64_b_back(cb, mt_n4)

    ts_a64_patch_cond(cb, to_mt_n1, A64_COND_LT)
    mt_n1 := cb.len()
    ts_a64_cmp_imm(cb, 24, 0)
    done_mt_n := ts_a64_b_cond_fwd(cb)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 15, 25)
    mt_b1 := cb.len()
    ts_a64_cmp_imm(cb, 15, 0)
    mt_b1_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_ldr_q_post(cb, 0, 1)
    ts_a64_and_16b(cb, 1, 0, 20)
    ts_a64_ushr_16b_4(cb, 0, 0)
    ts_a64_sub_16b(cb, 1, 1, 21)
    ts_a64_sub_16b(cb, 0, 0, 21)
    ts_a64_zero_4s(cb, 4)
    ts_a64_sdot_4s(cb, 4, 1, 2)
    ts_a64_sdot_4s(cb, 4, 0, 3)
    ts_a64_addv_4s(cb, 4, 4)
    ts_a64_scvtf_s(cb, 4, 4)
    ts_a64_ldr_s_post(cb, 23, 2)
    ts_a64_fmul_s(cb, 23, 23, 22)
    if fast {
        ts_a64_fmadd_s(cb, 16, 4, 23, 16)
    } else {
        ts_a64_fmul_s(cb, 4, 4, 23)
        ts_a64_fadd_s(cb, 16, 16, 4)
    }
    ts_a64_sub_imm(cb, 15, 15, 1)
    ts_a64_b_back(cb, mt_b1)
    ts_a64_patch_cond(cb, mt_b1_done, A64_COND_LE)
    ts_a64_str_s_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 1)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    ts_a64_sub_imm(cb, 24, 24, 1)
    ts_a64_b_back(cb, mt_n1)

    ts_a64_patch_cond(cb, done_mt_n, A64_COND_LE)
    ts_a64_ldr_sp_u64(cb, 5, 4)
    ts_a64_add_reg_lsl(cb, 5, 5, 25, 5) // nb * 32
    ts_a64_str_sp_u64(cb, 5, 4)
    ts_a64_ldr_sp_u64(cb, 5, 5)
    ts_a64_add_reg(cb, 5, 5, 8)        // nb * 4
    ts_a64_str_sp_u64(cb, 5, 5)
    ts_a64_ldr_sp_u64(cb, 6, 2)
    ts_a64_ldr_sp_u64(cb, 5, 6)
    ts_a64_add_reg_lsl(cb, 5, 5, 6, 2) // N * 4
    ts_a64_str_sp_u64(cb, 5, 6)
    ts_a64_ldr_sp_u64(cb, 5, 7)
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_str_sp_u64(cb, 5, 7)
    ts_a64_b_back(cb, m_tail)

    ts_a64_patch_cond(cb, done_all, A64_COND_LE)
    ts_a64_restore_x19_x26_frame128(cb)
    ts_a64_patch_cond(cb, early_m, A64_COND_LE)
    ts_a64_patch_cond(cb, early_n, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_swiglu_fast_step(cb $&mc.CodeBuffer) {
    // 4-wide f32 Cody-Waite exp(-g) + silu*up. Constants in v16..v27; v0=g, v1=up -> v0.
    ts_a64_fneg_4s(cb, 2, 0)
    ts_a64_fmaxnm_4s(cb, 2, 2, 16)
    ts_a64_fminnm_4s(cb, 2, 2, 17)
    ts_a64_fmul_4s(cb, 3, 2, 18)
    ts_a64_frintn_4s(cb, 3, 3)
    ts_a64_orr_16b(cb, 4, 2, 2)
    ts_a64_fmls_4s(cb, 4, 3, 19)
    ts_a64_fmls_4s(cb, 4, 3, 20)
    ts_a64_orr_16b(cb, 5, 25, 25)
    ts_a64_fmla_4s(cb, 5, 26, 4)
    ts_a64_orr_16b(cb, 6, 24, 24)
    ts_a64_fmla_4s(cb, 6, 5, 4)
    ts_a64_orr_16b(cb, 5, 23, 23)
    ts_a64_fmla_4s(cb, 5, 6, 4)
    ts_a64_orr_16b(cb, 6, 22, 22)
    ts_a64_fmla_4s(cb, 6, 5, 4)
    ts_a64_orr_16b(cb, 5, 21, 21)
    ts_a64_fmla_4s(cb, 5, 6, 4)
    ts_a64_orr_16b(cb, 6, 21, 21)
    ts_a64_fmla_4s(cb, 6, 5, 4)
    ts_a64_fcvtzs_4s(cb, 3, 3)
    ts_a64_add_4s(cb, 3, 3, 27)
    ts_a64_shl_4s_23(cb, 3, 3)
    ts_a64_fmul_4s(cb, 6, 6, 3)
    ts_a64_fadd_4s(cb, 6, 6, 21)
    ts_a64_fdiv_4s(cb, 0, 0, 6)
    ts_a64_fmul_4s(cb, 0, 0, 1)
}

fn ts_a64_silu_strict_2d(cb $&mc.CodeBuffer, dst_reg int) {
    // Expects v0 = 2 f64 g values, constants in v15..v31. Produces silu(g) in dst_reg.2d.
    ts_a64_fneg_2d(cb, 1, 0)
    ts_a64_fmaxnm_2d(cb, 1, 1, 16)
    ts_a64_fminnm_2d(cb, 1, 1, 17)
    ts_a64_fmul_2d(cb, 2, 1, 18)
    ts_a64_frintn_2d(cb, 2, 2)
    ts_a64_orr_16b(cb, 3, 1, 1)
    ts_a64_fmls_2d(cb, 3, 2, 19)
    ts_a64_fmls_2d(cb, 3, 2, 20)
    ts_a64_orr_16b(cb, 4, 30, 30)
    ts_a64_fmla_2d(cb, 4, 31, 3)
    for c_reg in [29, 28, 27, 26, 25, 24, 23, 22, 21, 21] {
        ts_a64_orr_16b(cb, 5, c_reg, c_reg)
        ts_a64_fmla_2d(cb, 5, 4, 3)
        ts_a64_orr_16b(cb, 4, 5, 5)
    }
    ts_a64_fcvtzs_2d(cb, 2, 2)
    ts_a64_add_2d(cb, 2, 2, 15)
    ts_a64_shl_2d_52(cb, 2, 2)
    ts_a64_fmul_2d(cb, 4, 4, 2)
    ts_a64_fadd_2d(cb, 4, 4, 21)
    ts_a64_fdiv_2d(cb, dst_reg, 0, 4)
}

fn ts_a64_emit_swiglu(cb $&mc.CodeBuffer, fast bool) {
    // (dst=x0, gate=x1, up=x2, n=x3)
    ts_a64_cmp_imm(cb, 3, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    if fast {
        ts_a64_dup_4s_u32(cb, 16, 9, 0x0000, 0xC2AE) // -87.0
        ts_a64_dup_4s_u32(cb, 17, 9, 0x999A, 0x42AE) // 87.3
        ts_a64_dup_4s_u32(cb, 18, 9, 0xAA3B, 0x3FB8) // 1.44269504
        ts_a64_dup_4s_u32(cb, 19, 9, 0x7200, 0x3F31) // ln2_hi
        ts_a64_dup_4s_u32(cb, 20, 9, 0xBE8E, 0x35BF) // ln2_lo
        ts_a64_dup_4s_u32(cb, 21, 9, 0x0000, 0x3F80) // 1.0
        ts_a64_dup_4s_u32(cb, 22, 9, 0x0000, 0x3F00) // 0.5
        ts_a64_dup_4s_u32(cb, 23, 9, 0xAAAB, 0x3E2A) // 1/6
        ts_a64_dup_4s_u32(cb, 24, 9, 0xAAAB, 0x3D2A) // 1/24
        ts_a64_dup_4s_u32(cb, 25, 9, 0x8889, 0x3C08) // 1/120
        ts_a64_dup_4s_u32(cb, 26, 9, 0x0B61, 0x3AB6) // 1/720
        ts_a64_dup_4s_u32(cb, 27, 9, 127, 0)         // 127

        loop4 := cb.len()
        ts_a64_cmp_imm(cb, 3, 4)
        to_tail := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_q_post(cb, 0, 1)
        ts_a64_ldr_q_post(cb, 1, 2)
        ts_a64_swiglu_fast_step(cb)
        ts_a64_str_q_post(cb, 0, 0)
        ts_a64_sub_imm(cb, 3, 3, 4)
        ts_a64_b_back(cb, loop4)

        ts_a64_patch_cond(cb, to_tail, A64_COND_LT)
        tail := cb.len()
        ts_a64_cmp_imm(cb, 3, 0)
        done_tail := ts_a64_b_cond_fwd(cb)
        ts_a64_ldr_s_post(cb, 0, 1)
        ts_a64_ldr_s_post(cb, 1, 2)
        ts_a64_dup_4s_0(cb, 0, 0)
        ts_a64_dup_4s_0(cb, 1, 1)
        ts_a64_swiglu_fast_step(cb)
        ts_a64_str_s_post(cb, 0, 0)
        ts_a64_sub_imm(cb, 3, 3, 1)
        ts_a64_b_back(cb, tail)

        ts_a64_patch_cond(cb, done_tail, A64_COND_LE)
        ts_a64_patch_cond(cb, done_early, A64_COND_LE)
        ts_a64_ret(cb)
        <<
    }

    // Strict 2-wide f64 Cody-Waite exp(-g) + degree-11 Horner (0 ULP in f32).
    ts_a64_save_q8_q15(cb)
    ts_a64_dup_2d_u16(cb, 16, 9, 0xC086, 0x2000, 0x0000, 0x0000) // -708.0
    ts_a64_dup_2d_u16(cb, 17, 9, 0x4086, 0x2000, 0x0000, 0x0000) // 708.0
    ts_a64_dup_2d_u16(cb, 18, 9, 0x3FF7, 0x1547, 0x652B, 0x82FE) // invln2
    ts_a64_dup_2d_u16(cb, 19, 9, 0x3FE6, 0x2E42, 0xFEFA, 0x39EF) // ln2_hi
    ts_a64_dup_2d_u16(cb, 20, 9, 0x3C7A, 0xBC9E, 0x3B39, 0x803F) // ln2_lo
    ts_a64_dup_2d_u16(cb, 21, 9, 0x3FF0, 0x0000, 0x0000, 0x0000) // 1.0
    ts_a64_dup_2d_u16(cb, 22, 9, 0x3FE0, 0x0000, 0x0000, 0x0000) // 1/2!
    ts_a64_dup_2d_u16(cb, 23, 9, 0x3FC5, 0x5555, 0x5555, 0x5555) // 1/3!
    ts_a64_dup_2d_u16(cb, 24, 9, 0x3FA5, 0x5555, 0x5555, 0x5555) // 1/4!
    ts_a64_dup_2d_u16(cb, 25, 9, 0x3F81, 0x1111, 0x1111, 0x1111) // 1/5!
    ts_a64_dup_2d_u16(cb, 26, 9, 0x3F56, 0xC16C, 0x16C1, 0x6C17) // 1/6!
    ts_a64_dup_2d_u16(cb, 27, 9, 0x3F2A, 0x01A0, 0x1A01, 0xA01A) // 1/7!
    ts_a64_dup_2d_u16(cb, 28, 9, 0x3EFA, 0x01A0, 0x1A01, 0xA01A) // 1/8!
    ts_a64_dup_2d_u16(cb, 29, 9, 0x3EC7, 0x1DE3, 0xA556, 0xC734) // 1/9!
    ts_a64_dup_2d_u16(cb, 30, 9, 0x3E92, 0x7E4F, 0xB778, 0x9F5C) // 1/10!
    ts_a64_dup_2d_u16(cb, 31, 9, 0x3E5A, 0xE645, 0x67F5, 0x44E4) // 1/11!
    ts_a64_dup_2d_u16(cb, 15, 9, 0x0000, 0x0000, 0x0000, 1023)   // 1023

    loop4s := cb.len()
    ts_a64_cmp_imm(cb, 3, 4)
    to_tail1 := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 8, 1)
    ts_a64_ldr_q_post(cb, 9, 2)
    ts_a64_fcvtl_2d(cb, 0, 8)
    ts_a64_silu_strict_2d(cb, 10)
    ts_a64_fcvtl2_2d(cb, 0, 8)
    ts_a64_silu_strict_2d(cb, 11)
    ts_a64_fcvtn_2s(cb, 0, 10)
    ts_a64_fcvtn2_4s(cb, 0, 11)
    ts_a64_fmul_4s(cb, 0, 0, 9)
    ts_a64_str_q_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 3, 3, 4)
    ts_a64_b_back(cb, loop4s)

    ts_a64_patch_cond(cb, to_tail1, A64_COND_LT)
    tail1 := cb.len()
    ts_a64_cmp_imm(cb, 3, 0)
    done_t1 := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 8, 1)
    ts_a64_ldr_s_post(cb, 9, 2)
    ts_a64_fcvtl_2d(cb, 0, 8)
    ts_a64_silu_strict_2d(cb, 10)
    ts_a64_fcvtn_2s(cb, 0, 10)
    ts_a64_fmul_4s(cb, 0, 0, 9)
    ts_a64_str_s_post(cb, 0, 0)
    ts_a64_sub_imm(cb, 3, 3, 1)
    ts_a64_b_back(cb, tail1)

    ts_a64_patch_cond(cb, done_t1, A64_COND_LE)
    ts_a64_restore_q8_q15(cb)
    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_argmax_f32(cb $&mc.CodeBuffer) {
    // (x=x0, n=x1) -> best_idx in x0
    ts_a64_cmp_imm(cb, 1, 1)
    too_small := ts_a64_b_cond_fwd(cb)
    ts_a64_cmp_imm(cb, 1, 8)
    small_scalar := ts_a64_b_cond_fwd(cb)

    // Vector path (n >= 8): seed best_v=x[0..3], best_i=[0,1,2,3], cur_i=[4,5,6,7], step=[4,4,4,4]
    ts_a64_ldr_q_post(cb, 0, 0)
    e32(cb, 0xD280002A)             // movz x10, #1
    e32(cb, 0xD280004B)             // movz x11, #2
    e32(cb, 0xD280006C)             // movz x12, #3
    ts_a64_zero_4s(cb, 1)
    e32(cb, 0x4E0C1D41)             // ins v1.s[1], w10
    e32(cb, 0x4E141D61)             // ins v1.s[2], w11
    e32(cb, 0x4E1C1D81)             // ins v1.s[3], w12
    ts_a64_dup_4s_u32(cb, 3, 9, 4, 0)
    ts_a64_add_4s(cb, 2, 1, 3)      // cur_i = [4,5,6,7]
    e32(cb, 0xD280008D)             // movz x13, #4 (idx = 4)
    ts_a64_sub_imm(cb, 1, 1, 4)     // rem = n - 4

    vec_loop := cb.len()
    ts_a64_cmp_imm(cb, 1, 4)
    vec_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_post(cb, 4, 0)
    ts_a64_fcmgt_4s(cb, 5, 4, 0)
    ts_a64_bit_16b(cb, 0, 4, 5)
    ts_a64_bit_16b(cb, 1, 2, 5)
    ts_a64_add_4s(cb, 2, 2, 3)
    ts_a64_add_imm(cb, 13, 13, 4)
    ts_a64_sub_imm(cb, 1, 1, 4)
    ts_a64_b_back(cb, vec_loop)

    ts_a64_patch_cond(cb, vec_done, A64_COND_LT)
    ts_a64_mov_w_lane(cb, 9, 1, 0)
    ts_a64_orr_16b(cb, 6, 0, 0)
    for lane in 1:4 {
        ts_a64_mov_s_lane(cb, 4, 6, lane)
        ts_a64_mov_w_lane(cb, 10, 1, lane)
        ts_a64_fcmp_s(cb, 4, 0)
        not_gt := ts_a64_b_cond_fwd(cb)
        a64_mov(cb, 9, 10)
        e32(cb, 0x1E204080) // fmov s0, s4
        gt_done := ts_a64_b_fwd(cb)
        ts_a64_patch_cond(cb, not_gt, A64_COND_LE)
        not_eq := ts_a64_b_cond_fwd(cb)
        e32(cb, 0xEB09015F) // cmp x10, x9
        eq_keep := ts_a64_b_cond_fwd(cb)
        a64_mov(cb, 9, 10)
        ts_a64_patch_cond(cb, not_eq, A64_COND_NE)
        ts_a64_patch_cond(cb, eq_keep, A64_COND_GE)
        ts_a64_patch_b(cb, gt_done)
    }
    b_fwd_tail := ts_a64_b_fwd(cb)

    // Small scalar path (1 < n < 8)
    ts_a64_patch_cond(cb, small_scalar, A64_COND_LT)
    ts_a64_ldr_s_post(cb, 0, 0)
    e32(cb, 0xD2800009)             // best_i = 0
    e32(cb, 0xD280002D)             // x13 = 1
    ts_a64_sub_imm(cb, 1, 1, 1)

    ts_a64_patch_b(cb, b_fwd_tail)
    tail := cb.len()
    ts_a64_cmp_imm(cb, 1, 0)
    done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_post(cb, 4, 0)
    ts_a64_fcmp_s(cb, 4, 0)
    skip_tail := ts_a64_b_cond_fwd(cb)
    e32(cb, 0x1E204080)             // fmov s0, s4
    a64_mov(cb, 9, 13)
    ts_a64_patch_cond(cb, skip_tail, A64_COND_LE)
    ts_a64_add_imm(cb, 13, 13, 1)
    ts_a64_sub_imm(cb, 1, 1, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done, A64_COND_LE)
    a64_mov(cb, 0, 9)
    ts_a64_ret(cb)

    ts_a64_patch_cond(cb, too_small, A64_COND_LE)
    e32(cb, 0xD2800000)             // movz x0, #0
    ts_a64_ret(cb)
}

fn ts_a64_emit_rope_f32(cb $&mc.CodeBuffer) {
    // (v0=x0, v1=x1, cos=x2, sin=x3, half=x4)
    ts_a64_cmp_imm(cb, 4, 0)
    done_early := ts_a64_b_cond_fwd(cb)

    loop4 := cb.len()
    ts_a64_cmp_imm(cb, 4, 4)
    to_tail := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_q_zero(cb, 0, 0)
    ts_a64_ldr_q_zero(cb, 1, 1)
    ts_a64_ldr_q_post(cb, 2, 2)
    ts_a64_ldr_q_post(cb, 3, 3)
    ts_a64_fmul_4s(cb, 4, 0, 2)
    ts_a64_fmul_4s(cb, 5, 1, 3)
    ts_a64_fsub_4s(cb, 4, 4, 5)
    ts_a64_fmul_4s(cb, 6, 0, 3)
    ts_a64_fmul_4s(cb, 7, 1, 2)
    ts_a64_fadd_4s(cb, 5, 6, 7)
    ts_a64_str_q_post(cb, 4, 0)
    ts_a64_str_q_post(cb, 5, 1)
    ts_a64_sub_imm(cb, 4, 4, 4)
    ts_a64_b_back(cb, loop4)

    ts_a64_patch_cond(cb, to_tail, A64_COND_LT)
    tail := cb.len()
    ts_a64_cmp_imm(cb, 4, 0)
    done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldr_s_zero(cb, 0, 0)
    ts_a64_ldr_s_zero(cb, 1, 1)
    ts_a64_ldr_s_post(cb, 2, 2)
    ts_a64_ldr_s_post(cb, 3, 3)
    ts_a64_fmul_s(cb, 4, 0, 2)
    ts_a64_fmul_s(cb, 5, 1, 3)
    ts_a64_fsub_s(cb, 4, 4, 5)
    ts_a64_fmul_s(cb, 6, 0, 3)
    ts_a64_fmul_s(cb, 7, 1, 2)
    ts_a64_fadd_s(cb, 5, 6, 7)
    ts_a64_str_s_post(cb, 4, 0)
    ts_a64_str_s_post(cb, 5, 1)
    ts_a64_sub_imm(cb, 4, 4, 1)
    ts_a64_b_back(cb, tail)

    ts_a64_patch_cond(cb, done, A64_COND_LE)
    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_gemv4_q4_0_p4_q8_0(cb $&mc.CodeBuffer, fast bool, f16_scale bool) {
    // (out=x0, qs_p=x1, ws_p=x2, xq=x3, xs=x4, packed=(rg_cnt<<32)|nb in x5)
    ts_a64_mov_w(cb, 6, 5)       // x6 = nb
    ts_a64_lsr_imm(cb, 5, 5, 32) // x5 = rg_cnt
    ts_a64_cmp_imm(cb, 5, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_lsl_imm(cb, 7, 6, 5)  // x7 = nb * 32
    ts_a64_lsl_imm(cb, 8, 6, 2)  // x8 = nb * 4
    ts_a64_lsl_imm(cb, 12, 6, 6) // x12 = nb * 64 (qs bytes per rg)
    $ws_shift := 4
    if f16_scale { ws_shift = 3 }
    ts_a64_lsl_imm(cb, 13, 6, ws_shift)
    ts_a64_movi_16b(cb, 20, 15)
    ts_a64_movi_16b(cb, 21, 248) // -8 in i8
    empty_s := []int{}
    q_b := [0, 1, 17, 18]
    q_b1 := [25, 26, 27, 28]

    // 8-row main loop (2 row groups per pass)
    rg_loop8 := cb.len()
    ts_a64_cmp_imm(cb, 5, 2)
    to_rg1 := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 10, 1, 12)
    ts_a64_add_reg(cb, 11, 2, 13)
    ts_a64_zero_4s(cb, 16)
    ts_a64_zero_4s(cb, 19)
    a64_mov(cb, 9, 6) // b_rem = nb

    b8_loop := cb.len()
    ts_a64_cmp_imm(cb, 9, 0)
    b8_done := ts_a64_b_cond_fwd(cb)
    ts_a64_prfm_pldl1(cb, 1, 512)
    ts_a64_prfm_pldl1(cb, 10, 512)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_zero_4s(cb, 24)
    ts_a64_sdot_4s(cb, 24, 2, 21)
    ts_a64_sdot_4s(cb, 24, 3, 21)
    ts_a64_addv_4s(cb, 24, 24)
    ts_a64_dup_4s_0(cb, 24, 24)

    ts_a64_ldp_q_post(cb, 0, 1, 1)
    ts_a64_ldp_q_post(cb, 17, 18, 1)
    ts_a64_ldp_q_post(cb, 25, 26, 10)
    ts_a64_ldp_q_post(cb, 27, 28, 10)

    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    for r in 0:4 {
        ts_a64_and_16b(cb, 29, q_b[r], 20)
        ts_a64_ushr_16b_4(cb, 30, q_b[r])
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 29, 2)
        ts_a64_sdot_4s(cb, 4 + r, 30, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 16, 24, &empty_s, fast)

    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 11)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 11)
    }
    for r in 0:4 {
        ts_a64_and_16b(cb, 29, q_b1[r], 20)
        ts_a64_ushr_16b_4(cb, 30, q_b1[r])
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 29, 2)
        ts_a64_sdot_4s(cb, 4 + r, 30, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 19, 24, &empty_s, fast)

    ts_a64_sub_imm(cb, 9, 9, 1)
    ts_a64_b_back(cb, b8_loop)

    ts_a64_patch_cond(cb, b8_done, A64_COND_LE)
    ts_a64_stp_q_post(cb, 16, 19, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 0)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    a64_mov(cb, 1, 10)
    a64_mov(cb, 2, 11)
    ts_a64_sub_imm(cb, 5, 5, 2)
    ts_a64_b_back(cb, rg_loop8)

    ts_a64_patch_cond(cb, to_rg1, A64_COND_LT)
    rg_loop := cb.len()
    ts_a64_cmp_imm(cb, 5, 0)
    done_rg := ts_a64_b_cond_fwd(cb)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 9, 6) // b_rem = nb

    // K-unrolled 2-block loop
    blk2 := cb.len()
    ts_a64_cmp_imm(cb, 9, 2)
    to_blk1 := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldp_q_post(cb, 25, 26, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_ldr_s_post(cb, 27, 4)

    ts_a64_zero_4s(cb, 24)
    ts_a64_sdot_4s(cb, 24, 2, 21)
    ts_a64_sdot_4s(cb, 24, 3, 21)
    ts_a64_addv_4s(cb, 24, 24)
    ts_a64_dup_4s_0(cb, 24, 24)

    ts_a64_zero_4s(cb, 28)
    ts_a64_sdot_4s(cb, 28, 25, 21)
    ts_a64_sdot_4s(cb, 28, 26, 21)
    ts_a64_addv_4s(cb, 28, 28)
    ts_a64_dup_4s_0(cb, 28, 28)

    // Block 0 (uses xq=v2,v3, xs=s22, xq_off=v24)
    ts_a64_ldp_q_post(cb, 0, 1, 1)
    ts_a64_ldp_q_post(cb, 17, 18, 1)
    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    for r in 0:4 {
        ts_a64_and_16b(cb, 29, q_b[r], 20)
        ts_a64_ushr_16b_4(cb, 30, q_b[r])
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 29, 2)
        ts_a64_sdot_4s(cb, 4 + r, 30, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 16, 24, &empty_s, fast)

    // Block 1 (uses xq=v25,v26, xs=s27, xq_off=v28)
    ts_a64_ldp_q_post(cb, 0, 1, 1)
    ts_a64_ldp_q_post(cb, 17, 18, 1)
    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    ts_a64_orr_16b(cb, 22, 27, 27)
    for r in 0:4 {
        ts_a64_and_16b(cb, 29, q_b[r], 20)
        ts_a64_ushr_16b_4(cb, 30, q_b[r])
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 29, 25)
        ts_a64_sdot_4s(cb, 4 + r, 30, 26)
    }
    ts_a64_sdot_reduce4_off(cb, 16, 28, &empty_s, fast)

    ts_a64_sub_imm(cb, 9, 9, 2)
    ts_a64_b_back(cb, blk2)

    ts_a64_patch_cond(cb, to_blk1, A64_COND_LT)
    blk1 := cb.len()
    ts_a64_cmp_imm(cb, 9, 0)
    blk1_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_zero_4s(cb, 24)
    ts_a64_sdot_4s(cb, 24, 2, 21)
    ts_a64_sdot_4s(cb, 24, 3, 21)
    ts_a64_addv_4s(cb, 24, 24)
    ts_a64_dup_4s_0(cb, 24, 24)
    ts_a64_ldp_q_post(cb, 0, 1, 1)
    ts_a64_ldp_q_post(cb, 17, 18, 1)
    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    for r in 0:4 {
        ts_a64_and_16b(cb, 29, q_b[r], 20)
        ts_a64_ushr_16b_4(cb, 30, q_b[r])
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 29, 2)
        ts_a64_sdot_4s(cb, 4 + r, 30, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 16, 24, &empty_s, fast)
    ts_a64_sub_imm(cb, 9, 9, 1)
    ts_a64_b_back(cb, blk1)

    ts_a64_patch_cond(cb, blk1_done, A64_COND_LE)
    ts_a64_str_q_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 0)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_b_back(cb, rg_loop)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_rg, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_gemv4_q8_0_p4_q8_0(cb $&mc.CodeBuffer, fast bool, f16_scale bool) {
    // (out=x0, qs_p=x1, ws_p=x2, xq=x3, xs=x4, packed=(rg_cnt<<32)|nb in x5)
    ts_a64_mov_w(cb, 6, 5)
    ts_a64_lsr_imm(cb, 5, 5, 32)
    ts_a64_cmp_imm(cb, 5, 0)
    done_early := ts_a64_b_cond_fwd(cb)
    ts_a64_lsl_imm(cb, 7, 6, 5)  // x7 = nb * 32
    ts_a64_lsl_imm(cb, 8, 6, 2)  // x8 = nb * 4
    ts_a64_lsl_imm(cb, 12, 6, 7) // x12 = nb * 128
    $ws_shift := 4
    if f16_scale { ws_shift = 3 }
    ts_a64_lsl_imm(cb, 13, 6, ws_shift)
    empty_s := []int{}

    // 8-row main loop (2 row groups per pass)
    rg_loop8 := cb.len()
    ts_a64_cmp_imm(cb, 5, 2)
    to_rg1 := ts_a64_b_cond_fwd(cb)
    ts_a64_add_reg(cb, 10, 1, 12)
    ts_a64_add_reg(cb, 11, 2, 13)
    ts_a64_zero_4s(cb, 16)
    ts_a64_zero_4s(cb, 19)
    a64_mov(cb, 9, 6)

    b8_loop := cb.len()
    ts_a64_cmp_imm(cb, 9, 0)
    b8_done := ts_a64_b_cond_fwd(cb)
    ts_a64_prfm_pldl1(cb, 1, 512)
    ts_a64_prfm_pldl1(cb, 10, 512)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)

    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    for r in 0:4 {
        ts_a64_ldp_q_post(cb, 0, 1, 1)
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 0, 2)
        ts_a64_sdot_4s(cb, 4 + r, 1, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 16, -1, &empty_s, fast)

    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 11)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 11)
    }
    for r in 0:4 {
        ts_a64_ldp_q_post(cb, 0, 1, 10)
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 0, 2)
        ts_a64_sdot_4s(cb, 4 + r, 1, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 19, -1, &empty_s, fast)

    ts_a64_sub_imm(cb, 9, 9, 1)
    ts_a64_b_back(cb, b8_loop)

    ts_a64_patch_cond(cb, b8_done, A64_COND_LE)
    ts_a64_stp_q_post(cb, 16, 19, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 0)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    a64_mov(cb, 1, 10)
    a64_mov(cb, 2, 11)
    ts_a64_sub_imm(cb, 5, 5, 2)
    ts_a64_b_back(cb, rg_loop8)

    ts_a64_patch_cond(cb, to_rg1, A64_COND_LT)
    rg_loop := cb.len()
    ts_a64_cmp_imm(cb, 5, 0)
    done_rg := ts_a64_b_cond_fwd(cb)
    ts_a64_zero_4s(cb, 16)
    a64_mov(cb, 9, 6)

    blk2 := cb.len()
    ts_a64_cmp_imm(cb, 9, 2)
    to_blk1 := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldp_q_post(cb, 24, 25, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    ts_a64_ldr_s_post(cb, 26, 4)

    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    for r in 0:4 {
        ts_a64_ldp_q_post(cb, 0, 1, 1)
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 0, 2)
        ts_a64_sdot_4s(cb, 4 + r, 1, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 16, -1, &empty_s, fast)

    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    ts_a64_orr_16b(cb, 22, 26, 26)
    for r in 0:4 {
        ts_a64_ldp_q_post(cb, 0, 1, 1)
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 0, 24)
        ts_a64_sdot_4s(cb, 4 + r, 1, 25)
    }
    ts_a64_sdot_reduce4_off(cb, 16, -1, &empty_s, fast)

    ts_a64_sub_imm(cb, 9, 9, 2)
    ts_a64_b_back(cb, blk2)

    ts_a64_patch_cond(cb, to_blk1, A64_COND_LT)
    blk1 := cb.len()
    ts_a64_cmp_imm(cb, 9, 0)
    blk1_done := ts_a64_b_cond_fwd(cb)
    ts_a64_ldp_q_post(cb, 2, 3, 3)
    ts_a64_ldr_s_post(cb, 22, 4)
    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 2)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 2)
    }
    for r in 0:4 {
        ts_a64_ldp_q_post(cb, 0, 1, 1)
        ts_a64_zero_4s(cb, 4 + r)
        ts_a64_sdot_4s(cb, 4 + r, 0, 2)
        ts_a64_sdot_4s(cb, 4 + r, 1, 3)
    }
    ts_a64_sdot_reduce4_off(cb, 16, -1, &empty_s, fast)
    ts_a64_sub_imm(cb, 9, 9, 1)
    ts_a64_b_back(cb, blk1)

    ts_a64_patch_cond(cb, blk1_done, A64_COND_LE)
    ts_a64_str_q_post(cb, 16, 0)
    ts_a64_sub_reg_lsl(cb, 3, 3, 7, 0)
    ts_a64_sub_reg_lsl(cb, 4, 4, 8, 0)
    ts_a64_sub_imm(cb, 5, 5, 1)
    ts_a64_b_back(cb, rg_loop)

    ts_a64_patch_cond(cb, done_early, A64_COND_LE)
    ts_a64_patch_cond(cb, done_rg, A64_COND_LE)
    ts_a64_ret(cb)
}

fn ts_a64_emit_gemm_p4_mtile(cb $&mc.CodeBuffer, fast bool, m_tile int, adv_shift int, f16_scale bool) {
    // Runs one M chunk of m_tile tokens across all rg_cnt groups:
    // Inputs: x19=qs_base, x20=ws_base, x21=out_m, x22=xq_m, x23=xs_m, x24=M_rem, x25=rg_cnt, x26=nb,
    //         x5=stride_xq (nb*32), x6=stride_xs (nb*4), x10=stride_out (rg_cnt*16), v20=0x0F, v21=0x08(+8).
    a64_mov(cb, 0, 19)
    a64_mov(cb, 1, 20)
    a64_mov(cb, 9, 21)
    a64_mov(cb, 12, 25) // rg_rem = rg_cnt
    w_in := [0, 1, 17, 18]

    rg_loop := cb.len()
    ts_a64_cmp_imm(cb, 12, 0)
    rg_done := ts_a64_b_cond_fwd(cb)
    for t in 0:m_tile { ts_a64_zero_4s(cb, 8 + t) }
    a64_mov(cb, 2, 26)  // b_rem = nb
    a64_mov(cb, 3, 22)  // xq_cur
    a64_mov(cb, 4, 23)  // xs_cur

    b_loop := cb.len()
    ts_a64_cmp_imm(cb, 2, 0)
    b_done := ts_a64_b_cond_fwd(cb)
    ts_a64_prfm_pldl1(cb, 0, 512)
    ts_a64_ldp_q_post(cb, 0, 1, 0)
    ts_a64_ldp_q_post(cb, 17, 18, 0)
    if f16_scale {
        ts_a64_ldr_d_post(cb, 23, 1)
        ts_a64_fcvtl_4s(cb, 23, 23)
    } else {
        ts_a64_ldr_q_post(cb, 23, 1)
    }
    for r in 0:4 {
        ts_a64_and_16b(cb, 24 + r, w_in[r], 20)
        ts_a64_ushr_16b_4(cb, 28 + r, w_in[r])
        ts_a64_sub_16b(cb, 24 + r, 24 + r, 21)
        ts_a64_sub_16b(cb, 28 + r, 28 + r, 21)
    }
    a64_mov(cb, 7, 3)
    a64_mov(cb, 8, 4)
    ts_a64_ldr_q_zero(cb, 2, 7)
    ts_a64_ldr_q_off(cb, 3, 7, 1)
    ts_a64_ldr_s_zero(cb, 22, 8)
    if m_tile > 1 {
        ts_a64_add_reg(cb, 7, 7, 5)
        ts_a64_add_reg(cb, 8, 8, 6)
    }
    for t in 0:m_tile {
        $cx0 := 2
        $cx1 := 3
        $cxs := 22
        $nx0 := 16
        $nx1 := 17
        $nxs := 18
        if (t & 1) != 0 {
            cx0 = 16
            cx1 = 17
            cxs = 18
            nx0 = 2
            nx1 = 3
            nxs = 22
        }
        if t + 1 < m_tile {
            ts_a64_ldr_q_zero(cb, nx0, 7)
            ts_a64_ldr_q_off(cb, nx1, 7, 1)
            ts_a64_ldr_s_zero(cb, nxs, 8)
            if t + 2 < m_tile {
                ts_a64_add_reg(cb, 7, 7, 5)
                ts_a64_add_reg(cb, 8, 8, 6)
            }
        }
        for r in 0:4 {
            ts_a64_zero_4s(cb, 4 + r)
            ts_a64_sdot_4s(cb, 4 + r, 24 + r, cx0)
            ts_a64_sdot_4s(cb, 4 + r, 28 + r, cx1)
        }
        ts_a64_addp_4s(cb, 4, 4, 5)
        ts_a64_addp_4s(cb, 6, 6, 7)
        ts_a64_addp_4s(cb, 4, 4, 6)
        ts_a64_scvtf_4s(cb, 4, 4)
        ts_a64_fmul_4s_elem0(cb, 1, 23, cxs)
        if fast {
            ts_a64_fmla_4s(cb, 8 + t, 4, 1)
        } else {
            ts_a64_fmul_4s(cb, 4, 4, 1)
            ts_a64_fadd_4s(cb, 8 + t, 8 + t, 4)
        }
    }
    ts_a64_add_imm(cb, 3, 3, 32)
    ts_a64_add_imm(cb, 4, 4, 4)
    ts_a64_sub_imm(cb, 2, 2, 1)
    ts_a64_b_back(cb, b_loop)

    ts_a64_patch_cond(cb, b_done, A64_COND_LE)
    a64_mov(cb, 11, 9)
    for t in 0:m_tile {
        ts_a64_str_q_zero(cb, 8 + t, 11)
        if t + 1 < m_tile {
            ts_a64_add_reg(cb, 11, 11, 10)
        }
    }
    ts_a64_add_imm(cb, 9, 9, 16)
    ts_a64_sub_imm(cb, 12, 12, 1)
    ts_a64_b_back(cb, rg_loop)

    ts_a64_patch_cond(cb, rg_done, A64_COND_LE)
    ts_a64_add_reg_lsl(cb, 21, 21, 10, adv_shift)
    ts_a64_add_reg_lsl(cb, 22, 22, 5, adv_shift)
    ts_a64_add_reg_lsl(cb, 23, 23, 6, adv_shift)
    ts_a64_sub_imm(cb, 24, 24, m_tile)
}

fn ts_a64_emit_gemm4x8_q4_0_p4_q8_0(cb $&mc.CodeBuffer, fast bool, f16_scale bool) {
    // (out=x0, qs_p=x1, ws_p=x2, xq=x3, xs=x4, packed=(M<<42)|(rg_cnt<<21)|nb in x5)
    ts_a64_and_21(cb, 6, 5)      // x6 = nb
    ts_a64_ubfx_21(cb, 7, 5, 21) // x7 = rg_cnt
    ts_a64_ubfx_21(cb, 8, 5, 42) // x8 = M
    ts_a64_cmp_imm(cb, 8, 0)
    early_m := ts_a64_b_cond_fwd(cb)
    ts_a64_cmp_imm(cb, 7, 0)
    early_rg := ts_a64_b_cond_fwd(cb)

    ts_a64_save_q8_q15(cb)
    ts_a64_save_x19_x26_frame128(cb)
    a64_mov(cb, 19, 1)           // qs_base
    a64_mov(cb, 20, 2)           // ws_base
    a64_mov(cb, 21, 0)           // out_m
    a64_mov(cb, 22, 3)           // xq_m
    a64_mov(cb, 23, 4)           // xs_m
    a64_mov(cb, 24, 8)           // M_rem
    a64_mov(cb, 25, 7)           // rg_cnt
    a64_mov(cb, 26, 6)           // nb
    ts_a64_lsl_imm(cb, 5, 26, 5) // x5 = nb * 32
    ts_a64_lsl_imm(cb, 6, 26, 2) // x6 = nb * 4
    ts_a64_lsl_imm(cb, 10, 25, 4)// x10 = rg_cnt * 16 = N * 4
    ts_a64_movi_16b(cb, 20, 15)
    ts_a64_movi_16b(cb, 21, 8)   // +8 in i8 for pre-unpacked sub.16b

    m_loop8 := cb.len()
    ts_a64_cmp_imm(cb, 24, 8)
    to_m4 := ts_a64_b_cond_fwd(cb)
    ts_a64_emit_gemm_p4_mtile(cb, fast, 8, 3, f16_scale)
    ts_a64_b_back(cb, m_loop8)

    ts_a64_patch_cond(cb, to_m4, A64_COND_LT)
    m_loop4 := cb.len()
    ts_a64_cmp_imm(cb, 24, 4)
    to_m1 := ts_a64_b_cond_fwd(cb)
    ts_a64_emit_gemm_p4_mtile(cb, fast, 4, 2, f16_scale)
    ts_a64_b_back(cb, m_loop4)

    ts_a64_patch_cond(cb, to_m1, A64_COND_LT)
    m_loop1 := cb.len()
    ts_a64_cmp_imm(cb, 24, 0)
    done_all := ts_a64_b_cond_fwd(cb)
    ts_a64_emit_gemm_p4_mtile(cb, fast, 1, 0, f16_scale)
    ts_a64_b_back(cb, m_loop1)

    ts_a64_patch_cond(cb, done_all, A64_COND_LE)
    ts_a64_restore_x19_x26_frame128(cb)
    ts_a64_restore_q8_q15(cb)
    ts_a64_patch_cond(cb, early_m, A64_COND_LE)
    ts_a64_patch_cond(cb, early_rg, A64_COND_LE)
    ts_a64_ret(cb)
}

pub fn emit_arm64_tensor_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    syms.define_label("__xu_tensor_mul_add_f32", cb.len())
    ts_a64_emit_mul_add(cb, false)
    syms.define_label("__xu_tensor_mul_add_fma_f32", cb.len())
    ts_a64_emit_mul_add(cb, true)
    syms.define_label("__xu_tensor_add_sqsum_f32", cb.len())
    ts_a64_emit_add_sqsum(cb, false)
    syms.define_label("__xu_tensor_add_sqsum_fast_f32", cb.len())
    ts_a64_emit_add_sqsum(cb, true)
    syms.define_label("__xu_tensor_norm_f32", cb.len())
    ts_a64_emit_norm(cb)
    syms.define_label("__xu_tensor_dot_f32", cb.len())
    ts_a64_emit_dot(cb, false)
    syms.define_label("__xu_tensor_dot_fast_f32", cb.len())
    ts_a64_emit_dot(cb, true)
    syms.define_label("__xu_tensor_axpy_f32", cb.len())
    ts_a64_emit_axpy(cb, false)
    syms.define_label("__xu_tensor_axpy_fma_f32", cb.len())
    ts_a64_emit_axpy(cb, true)
    syms.define_label("__xu_tensor_vadd_inplace_f32", cb.len())
    ts_a64_emit_vadd_inplace(cb)
    syms.define_label("__xu_tensor_dot_q4_0_f32", cb.len())
    ts_a64_emit_dot_q4_0(cb, false)
    syms.define_label("__xu_tensor_dot_q4_0_fast_f32", cb.len())
    ts_a64_emit_dot_q4_0(cb, true)
    syms.define_label("__xu_tensor_gemv4_f32", cb.len())
    ts_a64_emit_gemv4_f32(cb, false)
    syms.define_label("__xu_tensor_gemv4_fast_f32", cb.len())
    ts_a64_emit_gemv4_f32(cb, true)
    syms.define_label("__xu_tensor_dot_q4_0_q8_0_f32", cb.len())
    ts_a64_emit_dot_q4_0_q8_0(cb, false)
    syms.define_label("__xu_tensor_dot_q4_0_q8_0_fast_f32", cb.len())
    ts_a64_emit_dot_q4_0_q8_0(cb, true)
    syms.define_label("__xu_tensor_gemv4_q4_0_q8_0_f32", cb.len())
    ts_a64_emit_gemv4_q4_0_q8_0(cb, false)
    syms.define_label("__xu_tensor_gemv4_q4_0_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemv4_q4_0_q8_0(cb, true)
    syms.define_label("__xu_tensor_quantize_q8_0", cb.len())
    ts_a64_emit_quantize_q8_0(cb, false)
    syms.define_label("__xu_tensor_quantize_q8_0_fast", cb.len())
    ts_a64_emit_quantize_q8_0(cb, true)
    syms.define_label("__xu_tensor_gemv4_q8_0_q8_0_f32", cb.len())
    ts_a64_emit_gemv4_q8_0_q8_0(cb, false)
    syms.define_label("__xu_tensor_gemv4_q8_0_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemv4_q8_0_q8_0(cb, true)
    syms.define_label("__xu_tensor_gemm4x4_f32", cb.len())
    ts_a64_emit_gemm4x4_f32(cb, false)
    syms.define_label("__xu_tensor_gemm4x4_fast_f32", cb.len())
    ts_a64_emit_gemm4x4_f32(cb, true)
    syms.define_label("__xu_tensor_gemm4x4_q4_0_q8_0_f32", cb.len())
    ts_a64_emit_gemm4x4_q4_0_q8_0(cb, false)
    syms.define_label("__xu_tensor_gemm4x4_q4_0_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemm4x4_q4_0_q8_0(cb, true)
    syms.define_label("__xu_tensor_swiglu_f32", cb.len())
    ts_a64_emit_swiglu(cb, false)
    syms.define_label("__xu_tensor_swiglu_fast_f32", cb.len())
    ts_a64_emit_swiglu(cb, true)
    syms.define_label("__xu_tensor_argmax_f32", cb.len())
    ts_a64_emit_argmax_f32(cb)
    syms.define_label("__xu_tensor_rope_f32", cb.len())
    ts_a64_emit_rope_f32(cb)
    syms.define_label("__xu_tensor_gemv4_q4_0_p4_q8_0_f32", cb.len())
    ts_a64_emit_gemv4_q4_0_p4_q8_0(cb, false, false)
    syms.define_label("__xu_tensor_gemv4_q4_0_p4_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemv4_q4_0_p4_q8_0(cb, true, false)
    syms.define_label("__xu_tensor_gemv4_q8_0_p4_q8_0_f32", cb.len())
    ts_a64_emit_gemv4_q8_0_p4_q8_0(cb, false, false)
    syms.define_label("__xu_tensor_gemv4_q8_0_p4_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemv4_q8_0_p4_q8_0(cb, true, false)
    syms.define_label("__xu_tensor_gemm4x8_q4_0_p4_q8_0_f32", cb.len())
    ts_a64_emit_gemm4x8_q4_0_p4_q8_0(cb, false, false)
    syms.define_label("__xu_tensor_gemm4x8_q4_0_p4_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemm4x8_q4_0_p4_q8_0(cb, true, false)
    syms.define_label("__xu_tensor_gemv4_q4_0_p4_f16_q8_0_f32", cb.len())
    ts_a64_emit_gemv4_q4_0_p4_q8_0(cb, false, true)
    syms.define_label("__xu_tensor_gemv4_q4_0_p4_f16_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemv4_q4_0_p4_q8_0(cb, true, true)
    syms.define_label("__xu_tensor_gemv4_q8_0_p4_f16_q8_0_f32", cb.len())
    ts_a64_emit_gemv4_q8_0_p4_q8_0(cb, false, true)
    syms.define_label("__xu_tensor_gemv4_q8_0_p4_f16_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemv4_q8_0_p4_q8_0(cb, true, true)
    syms.define_label("__xu_tensor_gemm4x8_q4_0_p4_f16_q8_0_f32", cb.len())
    ts_a64_emit_gemm4x8_q4_0_p4_q8_0(cb, false, true)
    syms.define_label("__xu_tensor_gemm4x8_q4_0_p4_f16_q8_0_fast_f32", cb.len())
    ts_a64_emit_gemm4x8_q4_0_p4_q8_0(cb, true, true)
}

// ===== x86-64 SSE encoding & branch helpers =====

fn ts_x64_add_imm(cb $&mc.CodeBuffer, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0x83)
    x64_modrm_rr(cb, 0, r)
    xb(cb, imm)
}

fn ts_x64_add_imm32(cb $&mc.CodeBuffer, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0x81)
    x64_modrm_rr(cb, 0, r)
    cb.emit_u32_le(imm & 0xffffffff)
}

fn ts_x64_movd_ld(cb $&mc.CodeBuffer, xd int, base int, disp int) {
    xb(cb, 0x66)
    x64_rex(cb, false, xd, base, false)
    xb(cb, 0x0F)
    xb(cb, 0x6E)
    x64_modrm_mem(cb, xd, base, disp)
}

fn ts_x64_pcmpeqd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x76)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_punpcklbw(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x60)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_punpcklwd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x61)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_pslld_imm(cb $&mc.CodeBuffer, xd int, imm int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x72)
    x64_modrm_rr(cb, 6, xd)
    xb(cb, imm)
}

fn ts_x64_psrld_imm(cb $&mc.CodeBuffer, xd int, imm int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x72)
    x64_modrm_rr(cb, 2, xd)
    xb(cb, imm)
}

fn ts_x64_psubd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0xFA)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_cvtdq2ps(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x0F)
    xb(cb, 0x5B)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_mov32_rr(cb $&mc.CodeBuffer, rd int, rs int) {
    if rd >= 8 || rs >= 8 { x64_rex(cb, false, rs, rd, false) }
    xb(cb, 0x89)
    x64_modrm_rr(cb, rs, rd)
}

fn ts_x64_shr_imm(cb $&mc.CodeBuffer, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0xC1)
    x64_modrm_rr(cb, 5, r)
    xb(cb, imm)
}

fn ts_x64_shl_imm(cb $&mc.CodeBuffer, r int, imm int) {
    x64_rex(cb, true, 0, r, false)
    xb(cb, 0xC1)
    x64_modrm_rr(cb, 4, r)
    xb(cb, imm)
}

fn ts_x64_sub_rr(cb $&mc.CodeBuffer, rd int, rs int) {
    x64_rex(cb, true, rs, rd, false)
    xb(cb, 0x29)
    x64_modrm_rr(cb, rs, rd)
}

fn ts_x64_movq_ld(cb $&mc.CodeBuffer, xd int, base int, disp int) {
    xb(cb, 0xF3)
    if xd >= 8 || base >= 8 { x64_rex(cb, false, xd, base, false) }
    xb(cb, 0x0F)
    xb(cb, 0x7E)
    x64_modrm_mem(cb, xd, base, disp)
}

fn ts_x64_psrlw_imm(cb $&mc.CodeBuffer, xd int, imm int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0x71)
    x64_modrm_rr(cb, 2, xd)
    xb(cb, imm)
}

