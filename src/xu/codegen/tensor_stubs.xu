@xu/codegen
// Vectorized f32 tensor kernels for ARM64 (NEON) and x86-64 (SSE).
//
// Strict stubs preserve exact IEEE-754 single-precision rounding and serial
// reduction order. Fast-math variants (emitted and called under
// XU_TENSOR_FAST_MATH=1) opt into NEON FMA contraction and parallel lane
// accumulation while still preserving incoming acc_bits when n <= 0.
//
// Register contracts (never touch callee-saved or reserved registers):
//   ARM64: arguments x0..x4, result x0; uses only x0..x4, v0..v7, v16..v20.
//          Preserves x18..x30 and v8..v15.
//   x64:   arguments rdi, rsi, rdx, rcx, r8, result rax; uses only rax/rcx/
//          rdx/rsi/rdi/r8 and xmm0..xmm5. Preserves rbx/rbp/r12..r15, xmm6..xmm15.

#xu/mc

// ===== ARM64 encoding & branch helpers =====

const A64_COND_EQ = 0
const A64_COND_NE = 1
const A64_COND_GE = 10
const A64_COND_LT = 11
const A64_COND_GT = 12
const A64_COND_LE = 13

fn ts_a64_cmp_imm(cb $&mc.CodeBuffer, rn int, imm int) {
    e32(cb, 0xF100001F | ((imm & 0xfff) << 10) | (rn << 5))
}

fn ts_a64_sub_imm(cb $&mc.CodeBuffer, rd int, rn int, imm int) {
    e32(cb, 0xD1000000 | ((imm & 0xfff) << 10) | (rn << 5) | rd)
}

fn ts_a64_b_cond_fwd(cb $&mc.CodeBuffer) int {
    at := cb.len()
    e32(cb, 0)
    << at
}

fn ts_a64_patch_cond(cb $&mc.CodeBuffer, at int, cond int) {
    disp := (cb.len() - at) >> 2
    cb.patch_u32_le(at, 0x54000000 | ((disp & 0x7ffff) << 5) | cond)
}

fn ts_a64_cbz_fwd(cb $&mc.CodeBuffer) int {
    at := cb.len()
    e32(cb, 0)
    << at
}

fn ts_a64_patch_cbz(cb $&mc.CodeBuffer, at int, rn int, nz bool) {
    disp := (cb.len() - at) >> 2
    $base := 0xB4000000
    if nz { base = 0xB5000000 }
    cb.patch_u32_le(at, base | ((disp & 0x7ffff) << 5) | rn)
}

fn ts_a64_b_back(cb $&mc.CodeBuffer, target int) {
    disp := (target - cb.len()) >> 2
    e32(cb, 0x14000000 | (disp & 0x3ffffff))
}

fn ts_a64_ret(cb $&mc.CodeBuffer) {
    e32(cb, 0xD65F03C0)
}

