    xb(cb, 0x0F)
    xb(cb, 0xF9)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_pmaddwd(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0x66)
    xb(cb, 0x0F)
    xb(cb, 0xF5)
    x64_modrm_rr(cb, xd, xs)
