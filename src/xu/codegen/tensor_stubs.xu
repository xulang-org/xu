    xb(cb, 0x56)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_addss(cb $&mc.CodeBuffer, xd int, xs int) {
    xb(cb, 0xF3)
    xb(cb, 0x0F)
    xb(cb, 0x58)
    x64_modrm_rr(cb, xd, xs)
}

fn ts_x64_subss(cb $&mc.CodeBuffer, xd int, xs int) {
