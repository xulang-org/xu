// Accumulate lanes 0..3 of v0 serially into s<acc>, using s3 as scratch.
fn ts_a64_serial_sum_v0(cb $&mc.CodeBuffer, acc int) {
    ts_a64_fadd_s(cb, acc, acc, 0)
    ts_a64_mov_s_lane(cb, 3, 0, 1)
    ts_a64_fadd_s(cb, acc, acc, 3)
    ts_a64_mov_s_lane(cb, 3, 0, 2)
    ts_a64_fadd_s(cb, acc, acc, 3)
    ts_a64_mov_s_lane(cb, 3, 0, 3)
    ts_a64_fadd_s(cb, acc, acc, 3)
}

