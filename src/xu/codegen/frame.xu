@xu/codegen
// Stack frame layout and calling convention manager.
//
// Layer 4C module: computes stack slot offsets, callee-saved registers,
// and ensures target-specific stack alignment (e.g. 16-byte on ARM64/x64).

#xu/mc
#xu/target

pub struct FrameSlot {
    pub id int
    pub offset int
    pub size int
}

pub struct Frame {
    pub target target.Target
    pub local_slots []FrameSlot
    pub spill_slots []FrameSlot
    pub callee_saved_regs []int
    pub total_stack_size int
}

pub fn frame_new(t &target.Target) Frame {
    << Frame{
        target: ~t,
        local_slots: []FrameSlot{},
        spill_slots: []FrameSlot{},
        callee_saved_regs: []int{},
        total_stack_size: 0
    }
}

pub fn (f $&Frame) alloc_local(size int) int {
    $aligned_sz := size
    if aligned_sz < 8 { aligned_sz = 8 }
    slot_id := f.local_slots.len
    offset := f.total_stack_size
    f.local_slots.push(FrameSlot{
        id: slot_id,
        offset: offset,
        size: aligned_sz
    })
    f.total_stack_size += aligned_sz
    << slot_id
}

pub fn (f $&Frame) finalize_layout() {
    // Round total stack size up to 16 bytes for ABI compliance.
    rem := f.total_stack_size % 16
    if rem != 0 {
        f.total_stack_size += 16 - rem
    }
}

fn asm_is_ws(b int) bool {
    << b == 32 || b == 9 || b == 13 || b == 10
}

pub fn asm_trim(s string) string {
    $lo := 0
    $hi := s.len
    while lo < hi && asm_is_ws(s[lo] & 255) { lo += 1 }
    while hi > lo && asm_is_ws(s[hi - 1] & 255) { hi -= 1 }
    if lo == 0 && hi == s.len { << s }
    << s[lo:hi]
}

pub fn asm_split_stmts(s &string) []string {
    $out := []string{}
    $start := 0
    for i in 0:(s.len + 1) {
        if i == s.len || (s[i] & 255) == 59 { // ';'
            part := asm_trim((*s)[start:i])
            if part.len > 0 { out.push(part) }
            start = i + 1
        }
    }
    << out
}

fn asm_parse_u64_token(tok string) int {
    t := asm_trim(tok)
    if t.len == 0 { << -1 }
    $start := 0
    $base := 10
    if t.len > 2 && (t[0] & 255) == 48 && ((t[1] & 255) == 120 || (t[1] & 255) == 88) {
        start = 2
        base = 16
    }
    if start >= t.len { << -1 }
    $v := 0
    for i in start:t.len {
        b := t[i] & 255
        if b == 95 { -> } // allow '_' separators in hex/dec literals
        $d := -1
        if b >= 48 && b <= 57 { d = b - 48 }
        else if base == 16 && b >= 97 && b <= 102 { d = b - 87 }
        else if base == 16 && b >= 65 && b <= 70 { d = b - 55 }
        else { << -1 }
        v = v * base + d
    }
    << v
}

fn asm_starts_with(s &string, p string) bool {
    if s.len < p.len { << false }
    for i in 0:p.len {
        if ((*s)[i] & 255) != (p[i] & 255) { << false }
    }
    << true
}

// Handles `.byte 0x.., ...` and `.u32 0x.., ...` directives inside `asm("...")`.
pub fn asm_emit_directive(cb $&mc.CodeBuffer, stmt string) bool {
    $is_u32 := false
    $rest := ""
    if asm_starts_with(&stmt, ".byte") && stmt.len > 5 && asm_is_ws(stmt[5] & 255) {
        rest = stmt[5:stmt.len]
    } else if asm_starts_with(&stmt, ".u32") && stmt.len > 4 && asm_is_ws(stmt[4] & 255) {
        is_u32 = true
        rest = stmt[4:stmt.len]
    } else {
        << false
    }
    $start := 0
    for i in 0:(rest.len + 1) {
        if i == rest.len || (rest[i] & 255) == 44 { // ','
            val := asm_parse_u64_token(rest[start:i])
            if val >= 0 {
                if is_u32 { cb.emit_u32_le(val) }
                else { cb.emit_u8(val & 255) }
            }
            start = i + 1
        }
    }
    << true
}
