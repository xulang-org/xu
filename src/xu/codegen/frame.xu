@xu/codegen
// Stack frame layout and calling convention manager.
//
// Layer 4C module: computes stack slot offsets, callee-saved registers,
// and ensures target-specific stack alignment (e.g. 16-byte on ARM64/x64).

#xu/mc
#xu/target

pub struct FrameSlot {
    pub id int
    pub offset int
    pub size int
}

pub struct Frame {
    pub target target.Target
    pub local_slots []FrameSlot
    pub spill_slots []FrameSlot
    pub callee_saved_regs []int
    pub total_stack_size int
}

pub fn frame_new(t &target.Target) Frame {
    << Frame{
        target: ~t,
        local_slots: []FrameSlot{},
        spill_slots: []FrameSlot{},
        callee_saved_regs: []int{},
        total_stack_size: 0
    }
}

pub fn (f $&Frame) alloc_local(size int) int {
    $aligned_sz := size
    if aligned_sz < 8 { aligned_sz = 8 }
    slot_id := f.local_slots.len
    offset := f.total_stack_size
    f.local_slots.push(FrameSlot{
        id: slot_id,
        offset: offset,
        size: aligned_sz
    })
    f.total_stack_size += aligned_sz
    << slot_id
}

pub fn (f $&Frame) finalize_layout() {
    // Round total stack size up to 16 bytes for ABI compliance.
    rem := f.total_stack_size % 16
    if rem != 0 {
        f.total_stack_size += 16 - rem
    }
}
