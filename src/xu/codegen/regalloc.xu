@xu/codegen
// Register allocation for the typed backends: linear scan over
// conservative live intervals of temps and of scalar locals whose address
// is never taken.
//
// Positions number the instructions in block order: instruction k uses
// its operands at 2k and defines its result at 2k + 1; a call clobbers the
// caller-saved registers at 2k + 1. A value live in a block's entry or
// exit covers the whole block. Values that cross a call get callee-saved
// registers; anything left over keeps its frame slot.

#xu/mir

pub struct RaInfo {
    pub temp_reg []int
    pub local_reg []int
    pub used_callee []int
}

// Every value in its frame slot.
pub fn ra_none(f &mir.MFn) RaInfo {
    $t := []int{}
    for _ in 0:f.temps.len {
        t.push(-1)
    }
    $l := []int{}
    for _ in 0:f.locals.len {
        l.push(-1)
    }
    << RaInfo{temp_reg: t, local_reg: l, used_callee: []int{}}
}

struct RaScan {
    nt int
    start []int
    end []int
    home []int
    first_def []bool
    is_global []bool
    calls []int
    cur_w int
    // Uses and definitions weighted by loop depth; the cheapest value to
    // keep in memory has the smallest weight.
    weight []int
}

fn ra_touch(s $&RaScan, v int, pos int, blk int, is_def bool) {
    if v < 0 || v >= s.start.len {
        <<
    }
    s.weight[v] = s.weight[v] + s.cur_w
    if s.home[v] == -1 {
        s.home[v] = blk
        s.first_def[v] = is_def
    } else if s.home[v] != blk {
        s.is_global[v] = true
    }
    if pos < s.start[v] {
        s.start[v] = pos
    }
    if pos > s.end[v] {
        s.end[v] = pos
    }
}

fn ra_use(s $&RaScan, v int, pos int, blk int) {
    if v >= 0 && v < s.nt {
        ra_touch(s, v, pos, blk, false)
    }
}

pub fn is_noreturn_call(label &string) bool {
    << *label == "_xu_runtime_core_rt_panic" ||
       *label == "_xu_runtime_core_index_panic" ||
       *label == "_xu_runtime_core_exit_process" ||
       *label == "_xu_runtime_core_intrin_assert_fail" ||
       *label == "_xu_runtime_core_intrin_fatal" ||
       *label == "_xu_runtime_core_fatal_no_memory"
}

// The vreg operands an instruction reads, and the one it writes (-1 none).
fn ra_scan_instr(f &mir.MFn, s $&RaScan, ii int, ins &mir.MInstr, pos int, blk int, cand &[]bool) {
    k := ins.kind
    nt := s.nt
    if k == mir.MI_LOAD_LOCAL {
        if cand[ins.b] {
            ra_touch(s, nt + ins.b, pos, blk, false)
        }
        ra_touch(s, ins.a, pos + 1, blk, true)
    } else if k == mir.MI_STORE_LOCAL {
        ra_use(s, ins.b, pos, blk)
        if cand[ins.a] {
            ra_touch(s, nt + ins.a, pos + 1, blk, true)
        }
    } else if k == mir.MI_ADDR || k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
        ra_touch(s, ins.a, pos + 1, blk, true)
    } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD || k == mir.MI_COPY {
        ra_use(s, ins.b, pos, blk)
        ra_touch(s, ins.a, pos + 1, blk, true)
    } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
        ra_use(s, ins.a, pos, blk)
        ra_use(s, ins.b, pos, blk)
    } else if k == mir.MI_BIN {
        ra_use(s, ins.c, pos, blk)
        ra_use(s, ins.d, pos, blk)
        ra_touch(s, ins.a, pos + 1, blk, true)
    } else if k == mir.MI_UN {
        ra_use(s, ins.c, pos, blk)
        ra_touch(s, ins.a, pos + 1, blk, true)
    } else if k == mir.MI_SELECT {
        ra_use(s, ins.b, pos, blk)
        ra_use(s, ins.c, pos, blk)
        ra_use(s, ins.d, pos, blk)
        ra_touch(s, ins.a, pos + 1, blk, true)
    } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
        if k == mir.MI_CALL_IND {
            ra_use(s, ins.b, pos, blk)
        }
        $a := ins.c
        while a >= 0 {
            ra_use(s, f.margs[a].v, pos, blk)
            a = f.margs[a].next
        }
        if k == mir.MI_CALL_IND || !is_noreturn_call(&f.instrs[ii].sval) {
            s.calls.push(pos + 1)
        }
        ra_touch(s, ins.a, pos + 1, blk, true)
    }
}

fn ra_bit_set(bits $&[]int, base int, i int) {
    bits[base + (i >> 6)] = bits[base + (i >> 6)] | (1 << (i & 63))
}

fn ra_bit(bits &[]int, base int, i int) bool {
    << ((bits[base + (i >> 6)] >> (i & 63)) & 1) != 0
}

fn ra_gen(f &mir.MFn, s &RaScan, gidx &[]int, ins &mir.MInstr, use_b $&[]int, def_b $&[]int, base int, cand &[]bool) {
    k := ins.kind
    nt := s.nt
    $uses := []int{}
    $def := -1
    if k == mir.MI_LOAD_LOCAL {
        if cand[ins.b] {
            uses.push(nt + ins.b)
        }
        def = ins.a
    } else if k == mir.MI_STORE_LOCAL {
        uses.push(ins.b)
        if cand[ins.a] {
            def = nt + ins.a
        }
    } else if k == mir.MI_ADDR || k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
        def = ins.a
    } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD || k == mir.MI_COPY {
        uses.push(ins.b)
        def = ins.a
    } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
        uses.push(ins.a)
        uses.push(ins.b)
    } else if k == mir.MI_BIN {
        uses.push(ins.c)
        uses.push(ins.d)
        def = ins.a
    } else if k == mir.MI_UN {
        uses.push(ins.c)
        def = ins.a
    } else if k == mir.MI_SELECT {
        uses.push(ins.b)
        uses.push(ins.c)
        uses.push(ins.d)
        def = ins.a
    } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
        if k == mir.MI_CALL_IND {
            uses.push(ins.b)
        }
        $a := ins.c
        while a >= 0 {
            uses.push(f.margs[a].v)
            a = f.margs[a].next
        }
        def = ins.a
    }
    for i in 0:uses.len {
        u := uses[i]
        if u >= 0 && u < gidx.len && gidx[u] >= 0 && !ra_bit(def_b, base, gidx[u]) {
            ra_bit_set(use_b, base, gidx[u])
        }
    }
    if def >= 0 && def < gidx.len && gidx[def] >= 0 {
        ra_bit_set(def_b, base, gidx[def])
    }
}

fn ra_term_use(s $&RaScan, blk &mir.MBlock, pos int, bi int) {
    if blk.tkind == mir.TKIND_RETURN || blk.tkind == mir.TKIND_BRANCH {
        ra_use(s, blk.ta, pos, bi)
    }
}

fn fp_mark_int(v int, int_only $&[]bool) {
    if v >= 0 && v < int_only.len {
        int_only[v] = true
    }
}

fn fp_mark_float(v int, int_only &[]bool, is_fp $&[]bool) bool {
    if v >= 0 && v < is_fp.len && !int_only[v] && !is_fp[v] {
        is_fp[v] = true
        << true
    }
    << false
}

fn is_fneg_xor(f &mir.MFn, ins &mir.MInstr) int {
    if ins.kind != mir.MI_BIN || ins.b != mir.BIN_XOR {
        << -1
    }
    sb := -9223372036854775807 - 1
    if ins.d <= -2 && f.consts[0 - ins.d - 2] == sb && ins.c >= 0 {
        << ins.c
    }
    if ins.c <= -2 && f.consts[0 - ins.c - 2] == sb && ins.d >= 0 {
        << ins.d
    }
    << -1
}

fn ra_fp_mask(f &mir.MFn, cand &[]bool) []bool {
    $has_fp_op := false
    for ii in 0:f.instrs.len {
        k := f.instrs[ii].kind
        if k == mir.MI_UN {
            has_fp_op = true
            <-
        } else if k == mir.MI_BIN && f.instrs[ii].b >= mir.BIN_FADD && f.instrs[ii].b <= mir.BIN_FGE {
            has_fp_op = true
            <-
        }
    }
    if !has_fp_op {
        << []bool{}
    }
    nt := f.temps.len
    nl := f.locals.len
    nv := nt + nl
    $int_only := []bool{}
    $is_fp := []bool{}
    for _ in 0:nv {
        int_only.push(false)
        is_fp.push(false)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if k == mir.MI_ADDR || k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
                fp_mark_int(ins.a, $&int_only)
            } else if k == mir.MI_CALL_IND {
                fp_mark_int(ins.b, $&int_only)
            } else if k == mir.MI_SELECT {
                fp_mark_int(ins.b, $&int_only)
            } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD {
                fp_mark_int(ins.b, $&int_only)
                if ins.d == 1 || ins.d == 2 || ins.d == 4 || ins.d == -4 {
                    fp_mark_int(ins.a, $&int_only)
                }
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                fp_mark_int(ins.a, $&int_only)
                if ins.d == 1 || ins.d == 2 || ins.d == 4 || ins.d == -4 {
                    fp_mark_int(ins.b, $&int_only)
                }
            } else if k == mir.MI_LOAD_LOCAL {
                if ins.c > 0 && ins.b >= 0 && ins.b < nl {
                    fp_mark_int(nt + ins.b, $&int_only)
                }
            } else if k == mir.MI_STORE_LOCAL {
                if ins.c > 0 && ins.a >= 0 && ins.a < nl {
                    fp_mark_int(nt + ins.a, $&int_only)
                }
            } else if k == mir.MI_UN {
                if ins.b == mir.UN_I2F {
                    fp_mark_int(ins.c, $&int_only)
                } else if ins.b == mir.UN_F2I {
                    fp_mark_int(ins.a, $&int_only)
                } else if ins.b == mir.UN_F32_LOAD || ins.b == mir.UN_F32_STORE {
                    fp_mark_int(ins.a, $&int_only)
                    fp_mark_int(ins.c, $&int_only)
                }
            } else if k == mir.MI_BIN {
                if ins.b >= mir.BIN_FEQ && ins.b <= mir.BIN_FGE {
                    fp_mark_int(ins.a, $&int_only)
                } else if ins.b < mir.BIN_FADD && is_fneg_xor(f, &ins) < 0 {
                    fp_mark_int(ins.a, $&int_only)
                    fp_mark_int(ins.c, $&int_only)
                    fp_mark_int(ins.d, $&int_only)
                }
            }
            ii = ins.next
        }
        if f.blocks[bi].tkind == mir.TKIND_BRANCH {
            fp_mark_int(f.blocks[bi].ta, $&int_only)
        }
    }
    // Propagate int_only across plain copies/locals/selects so mixed values stay GPR.
    for _ in 0:8 {
        $ch := false
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                k := ins.kind
                if k == mir.MI_COPY {
                    if ins.a >= 0 && ins.b >= 0 && ins.a < nv && ins.b < nv && (int_only[ins.a] != int_only[ins.b]) {
                        int_only[ins.a] = true
                        int_only[ins.b] = true
                        ch = true
                    }
                } else if k == mir.MI_LOAD_LOCAL && ins.c <= 0 && ins.b >= 0 && ins.b < nl && cand[ins.b] {
                    if ins.a >= 0 && ins.a < nt && (int_only[ins.a] != int_only[nt + ins.b]) {
                        int_only[ins.a] = true
                        int_only[nt + ins.b] = true
                        ch = true
                    }
                } else if k == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && ins.a < nl && cand[ins.a] {
                    if ins.b >= 0 && ins.b < nt && (int_only[ins.b] != int_only[nt + ins.a]) {
                        int_only[ins.b] = true
                        int_only[nt + ins.a] = true
                        ch = true
                    }
                } else if k == mir.MI_SELECT {
                    a_i := ins.a >= 0 && ins.a < nt && int_only[ins.a]
                    c_i := ins.c >= 0 && ins.c < nt && int_only[ins.c]
                    d_i := ins.d >= 0 && ins.d < nt && int_only[ins.d]
                    if a_i || c_i || d_i {
                        if ins.a >= 0 && ins.a < nt && !int_only[ins.a] {
                            int_only[ins.a] = true
                            ch = true
                        }
                        if ins.c >= 0 && ins.c < nt && !int_only[ins.c] {
                            int_only[ins.c] = true
                            ch = true
                        }
                        if ins.d >= 0 && ins.d < nt && !int_only[ins.d] {
                            int_only[ins.d] = true
                            ch = true
                        }
                    }
                }
                ii = ins.next
            }
        }
        if !ch { <- }
    }
    // Seed float operands and results.
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if k == mir.MI_BIN {
                if ins.b >= mir.BIN_FADD && ins.b <= mir.BIN_FDIV {
                    fp_mark_float(ins.a, &int_only, $&is_fp)
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                    fp_mark_float(ins.d, &int_only, $&is_fp)
                } else if ins.b >= mir.BIN_FEQ && ins.b <= mir.BIN_FGE {
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                    fp_mark_float(ins.d, &int_only, $&is_fp)
                }
            } else if k == mir.MI_UN {
                if ins.b == mir.UN_I2F {
                    fp_mark_float(ins.a, &int_only, $&is_fp)
                } else if ins.b == mir.UN_F2I {
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                } else if ins.b == mir.UN_FSQRT {
                    fp_mark_float(ins.a, &int_only, $&is_fp)
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                }
            }
            ii = ins.next
        }
    }
    for _ in 0:8 {
        $ch := false
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                k := ins.kind
                if k == mir.MI_COPY {
                    if ins.a >= 0 && ins.b >= 0 && ins.a < nt && ins.b < nt && (is_fp[ins.a] || is_fp[ins.b]) {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(ins.b, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_LOAD_LOCAL && ins.c <= 0 && ins.b >= 0 && ins.b < nl && cand[ins.b] {
                    if ins.a >= 0 && ins.a < nt && (is_fp[ins.a] || is_fp[nt + ins.b]) {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(nt + ins.b, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && ins.a < nl && cand[ins.a] {
                    if ins.b >= 0 && ins.b < nt && (is_fp[ins.b] || is_fp[nt + ins.a]) {
                        if fp_mark_float(ins.b, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(nt + ins.a, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_SELECT {
                    a_f := ins.a >= 0 && ins.a < nt && is_fp[ins.a]
                    c_f := ins.c >= 0 && ins.c < nt && is_fp[ins.c]
                    d_f := ins.d >= 0 && ins.d < nt && is_fp[ins.d]
                    if a_f || c_f || d_f {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(ins.c, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(ins.d, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_BIN {
                    x := is_fneg_xor(f, &ins)
                    if x >= 0 && x < nt && ins.a >= 0 && ins.a < nt && (is_fp[ins.a] || is_fp[x]) {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(x, &int_only, $&is_fp) { ch = true }
                    }
                }
                ii = ins.next
            }
        }
        if !ch { <- }
    }
    $any_fp := false
    for v in 0:nv {
        if is_fp[v] {
            any_fp = true
            <-
        }
    }
    if !any_fp {
        << []bool{}
    }
    << is_fp
}

// Allocate registers for f. callee lists callee-saved registers, caller
// the scratch registers a call clobbers.
// CFG reverse-postorder traversal of reachable blocks, visiting colder /
// shallower / panic children first in DFS so the hot continuation immediately
// follows each branch in the linear scan order.
fn ra_block_hot_first(depth &[]int, is_panic &[]bool, a int, b int) bool {
    if is_panic[a] != is_panic[b] {
        << !is_panic[a]
    }
    if depth[a] != depth[b] {
        << depth[a] > depth[b]
    }
    << true
}

fn ra_block_order(f &mir.MFn, depth &[]int) []int {
    nb := f.blocks.len
    $order := []int{}
    if nb == 0 {
        << order
    }
    $is_panic := []bool{}
    for bi in 0:nb {
        $p := false
        if bi > 0 {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == mir.MI_CALL && is_noreturn_call(&f.instrs[ii].sval) {
                    p = true
                    <-
                }
                ii = ins.next
            }
        }
        is_panic.push(p)
    }
    $seen := []bool{}
    $next_i := []int{}
    $stack := []int{}
    $post := []int{}
    for _ in 0:nb {
        seen.push(false)
        next_i.push(0)
        stack.push(0)
    }
    seen[0] = true
    stack[0] = 0
    $sp := 1
    while sp > 0 {
        b := stack[sp - 1]
        $s0 := -1
        $s1 := -1
        $ns := 0
        if !is_panic[b] {
            tk := f.blocks[b].tkind
            if tk == mir.TKIND_JUMP {
                s := f.blocks[b].ta
                if s >= 0 && s < nb {
                    s0 = s
                    ns = 1
                }
            } else if tk == mir.TKIND_BRANCH {
                tb := f.blocks[b].tb
                tc := f.blocks[b].tc
                vb := tb >= 0 && tb < nb
                vc := tc >= 0 && tc < nb && tc != tb
                if vb && vc {
                    // Visit the colder child first so the hotter one lands right after b in RPO.
                    if ra_block_hot_first(depth, &is_panic, tb, tc) {
                        s0 = tc
                        s1 = tb
                    } else {
                        s0 = tb
                        s1 = tc
                    }
                    ns = 2
                } else if vb {
                    s0 = tb
                    ns = 1
                } else if vc {
                    s0 = tc
                    ns = 1
                }
            }
        }
        if next_i[b] < ns {
            $s := s0
            if next_i[b] == 1 {
                s = s1
            }
            next_i[b] = next_i[b] + 1
            if !seen[s] {
                seen[s] = true
                stack[sp] = s
                sp += 1
            }
        } else {
            post.push(b)
            sp -= 1
        }
    }
    $ri := post.len - 1
    while ri >= 0 {
        order.push(post[ri])
        ri -= 1
    }
    << order
}

pub fn ra_alloc(f &mir.MFn, callee &[]int, caller &[]int) RaInfo {
    $empty := []int{}
    << ra_alloc_fp(f, callee, caller, &empty, &empty)
}

pub fn ra_alloc_fp(f &mir.MFn, callee &[]int, caller &[]int, fp_callee &[]int, fp_caller &[]int) RaInfo {
    nt := f.temps.len
    nl := f.locals.len
    nv := nt + nl
    $cand := []bool{}
    for li in 0:nl {
        cand.push(li >= f.locals_nslots.len || f.locals_nslots[li] <= 1)
    }
    for i in 0:f.instrs.len {
        k := f.instrs[i].kind
        b := f.instrs[i].b
        a := f.instrs[i].a
        c := f.instrs[i].c
        if k == mir.MI_ADDR && b >= 0 && b < nl {
            cand[b] = false
        } else if k == mir.MI_LOAD_LOCAL && c > 0 && b >= 0 && b < nl {
            cand[b] = false
        } else if k == mir.MI_STORE_LOCAL && c > 0 && a >= 0 && a < nl {
            cand[a] = false
        }
    }
    $s := RaScan{nt: nt, start: []int{}, end: []int{}, home: []int{}, first_def: []bool{}, is_global: []bool{}, calls: []int{}, cur_w: 1, weight: []int{}}
    depth := mir.block_loop_depth(f)
    order := ra_block_order(f, &depth)
    for _ in 0:nv {
        s.weight.push(0)
        s.start.push(1 << 60)
        s.end.push(-1)
        s.home.push(-1)
        s.first_def.push(false)
        s.is_global.push(false)
    }
    // Parameters arrive at entry.
    for i in 0:f.nparams {
        if i < nl && cand[i] {
            ra_touch($&s, nt + i, 0, 0, true)
        }
    }
    $bstart := []int{}
    $bend := []int{}
    for _ in 0:f.blocks.len {
        bstart.push(-1)
        bend.push(-1)
    }
    $pos := 0
    for oi in 0:order.len {
        bi := order[oi]
        bstart[bi] = pos
        $dd := depth[bi]
        if dd > 5 { dd = 5 }
        s.cur_w = 1 << (3 * dd)
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            ra_scan_instr(f, $&s, ii, &ins, pos, bi, &cand)
            pos += 2
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        ra_term_use($&s, &blk, pos, bi)
        bend[bi] = pos
        pos += 2
    }
    // Values used before their first definition in a block are live into it.
    for v in 0:nv {
        if s.home[v] >= 0 && !s.first_def[v] {
            s.is_global[v] = true
        }
    }
    $gidx := []int{}
    $glist := []int{}
    for v in 0:nv {
        if s.is_global[v] {
            gidx.push(glist.len)
            glist.push(v)
        } else {
            gidx.push(-1)
        }
    }
    if glist.len > 0 {
        ra_global_live(f, $&s, &gidx, &glist, &bstart, &bend, &cand, &order)
    }
    $fp_mask := []bool{}
    if fp_callee.len > 0 || fp_caller.len > 0 {
        fp_mask = ra_fp_mask(f, &cand)
    }
    alias := ra_coalesce(f, $&s, &cand, &fp_mask, &order)
    $info := ra_none(f)
    ra_scan_class(f, &s, &cand, &fp_mask, false, callee, caller, $&info)
    if fp_mask.len > 0 {
        ra_scan_class(f, &s, &cand, &fp_mask, true, fp_callee, fp_caller, $&info)
    }
    for t in 0:nt {
        if alias[t] >= 0 {
            info.temp_reg[t] = info.local_reg[alias[t]]
        }
    }
    << info
}

// Temps that can share their local's register: t = load l, when l is not
// stored while t is live, and t computed right before store l, t as its
// only use. Their intervals merge into the local's.
fn ra_coalesce(f &mir.MFn, s $&RaScan, cand &[]bool, fp_mask &[]bool, order &[]int) []int {
    nt := s.nt
    $alias := []int{}
    $ndef := []int{}
    for _ in 0:nt {
        alias.push(-1)
        ndef.push(0)
    }
    for i in 0:f.instrs.len {
        ins := ~f.instrs[i]
        k := ins.kind
        if k != mir.MI_NOP && k != mir.MI_STORE_LOCAL && k != mir.MI_STORE_PTR && ins.a >= 0 && ins.a < nt {
            ndef[ins.a] = ndef[ins.a] + 1
        }
    }
    $st_loc := []int{}
    $st_pos := []int{}
    $scan_pos := 0
    for oi in 0:order.len {
        bi := order[oi]
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.kind == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && ins.a < cand.len && cand[ins.a] {
                st_loc.push(ins.a)
                st_pos.push(scan_pos)
            }
            scan_pos += 2
            ii = ins.next
        }
        scan_pos += 2
    }
    uses := temp_use_counts(f)
    $pos := 0
    $ids := []int{}
    $poss := []int{}
    for oi in 0:order.len {
        bi := order[oi]
        $n_blk := 0
        $ii := f.blocks[bi].head
        while ii >= 0 {
            if n_blk < ids.len {
                ids[n_blk] = ii
                poss[n_blk] = pos
            } else {
                ids.push(ii)
                poss.push(pos)
            }
            n_blk += 1
            pos += 2
            ii = f.instrs[ii].next
        }
        pos += 2
        for x in 0:n_blk {
            ins := ~f.instrs[ids[x]]
            k := ins.kind
            if k == mir.MI_LOAD_LOCAL && ins.c <= 0 && ins.b >= 0 && cand[ins.b] {
                t := ins.a
                if t >= 0 && t < nt && ndef[t] == 1 && alias[t] < 0 && s.end[t] >= 0 {
                    $ok := true
                    if !s.is_global[t] {
                        for y in x + 1:n_blk {
                            if poss[y] >= s.end[t] {
                                <-
                            }
                            o := ~f.instrs[ids[y]]
                            if o.kind == mir.MI_STORE_LOCAL && o.a == ins.b {
                                ok = false
                            }
                        }
                    } else {
                        st_t := s.start[t]
                        en_t := s.end[t]
                        for si in 0:st_loc.len {
                            if st_loc[si] == ins.b {
                                sp := st_pos[si]
                                if sp >= st_t && sp < en_t {
                                    ok = false
                                    <-
                                }
                            }
                        }
                    }
                    if ok {
                        alias[t] = ins.b
                    }
                }
            } else if k == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && cand[ins.a] && x > 0 {
                t := ins.b
                p := ~f.instrs[ids[x - 1]]
                if t >= 0 && t < nt && p.a == t && p.kind != mir.MI_STORE_LOCAL && p.kind != mir.MI_STORE_PTR && ndef[t] == 1 && uses[t] >= 1 && !s.is_global[t] && alias[t] < 0 && s.end[t] >= 0 {
                    $ok := true
                    if uses[t] > 1 {
                        for y in x + 1:n_blk {
                            if poss[y] >= s.end[t] {
                                <-
                            }
                            o := ~f.instrs[ids[y]]
                            if o.kind == mir.MI_STORE_LOCAL && o.a == ins.a {
                                ok = false
                                <-
                            }
                        }
                    }
                    if ok {
                        alias[t] = ins.a
                    }
                }
            }
        }
    }
    for t in 0:nt {
        if alias[t] >= 0 && fp_mask.len > 0 && fp_mask[t] != fp_mask[nt + alias[t]] {
            alias[t] = -1
        }
        if alias[t] >= 0 && s.end[t] >= 0 {
            v := nt + alias[t]
            s.weight[v] = s.weight[v] + s.weight[t]
            if s.start[t] < s.start[v] {
                s.start[v] = s.start[t]
            }
            if s.end[t] > s.end[v] {
                s.end[v] = s.end[t]
            }
            s.end[t] = -1
        }
    }
    << alias
}

// Block-level liveness of the values used outside one block; their
// intervals grow to cover every block they are live into or out of.
fn ra_global_live(f &mir.MFn, s $&RaScan, gidx &[]int, glist &[]int, bstart &[]int, bend &[]int, cand &[]bool, order &[]int) {
    nb := f.blocks.len
    w := (glist.len + 63) / 64
    $use_b := []int{}
    $def_b := []int{}
    $live_in := []int{}
    $live_out := []int{}
    for _ in 0:nb * w {
        use_b.push(0)
        def_b.push(0)
        live_in.push(0)
        live_out.push(0)
    }
    for oi in 0:order.len {
        bi := order[oi]
        base := bi * w
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            ra_gen(f, s, gidx, &ins, $&use_b, $&def_b, base, cand)
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        if blk.tkind == mir.TKIND_RETURN || blk.tkind == mir.TKIND_BRANCH {
            u := blk.ta
            if u >= 0 && u < gidx.len && gidx[u] >= 0 && !ra_bit(&def_b, base, gidx[u]) {
                ra_bit_set($&use_b, base, gidx[u])
            }
        }
    }
    $changed := true
    while changed {
        changed = false
        $oi := order.len - 1
        while oi >= 0 {
            bi := order[oi]
            blk := ~f.blocks[bi]
            base := bi * w
            for j in 0:w {
                $out := 0
                if blk.tkind == mir.TKIND_JUMP {
                    if blk.ta >= 0 && blk.ta < nb && bstart[blk.ta] >= 0 {
                        out = live_in[blk.ta * w + j]
                    }
                } else if blk.tkind == mir.TKIND_BRANCH {
                    if blk.tb >= 0 && blk.tb < nb && bstart[blk.tb] >= 0 {
                        out = out | live_in[blk.tb * w + j]
                    }
                    if blk.tc >= 0 && blk.tc < nb && bstart[blk.tc] >= 0 {
                        out = out | live_in[blk.tc * w + j]
                    }
                }
                inv := use_b[base + j] | (out & (-1 ^ def_b[base + j]))
                if out != live_out[base + j] || inv != live_in[base + j] {
                    live_out[base + j] = out
                    live_in[base + j] = inv
                    changed = true
                }
            }
            oi -= 1
        }
    }
    for oi in 0:order.len {
        bi := order[oi]
        base := bi * w
        for g in 0:glist.len {
            v := glist[g]
            if ra_bit(&live_in, base, g) && bstart[bi] < s.start[v] {
                s.start[v] = bstart[bi]
            }
            if ra_bit(&live_out, base, g) && bend[bi] + 1 > s.end[v] {
                s.end[v] = bend[bi] + 1
            }
        }
    }
}

fn ra_crosses_call(s &RaScan, v int) bool {
    // calls is sorted; binary search for the first call after start
    $lo := 0
    $hi := s.calls.len
    while lo < hi {
        mid := (lo + hi) / 2
        if s.calls[mid] <= s.start[v] {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    << lo < s.calls.len && s.calls[lo] < s.end[v]
}

fn ra_cand_ok(s &RaScan, v int, nt int, cand &[]bool, fp_mask &[]bool, want_fp bool) bool {
    if s.end[v] < 0 || (v >= nt && !cand[v - nt]) {
        << false
    }
    if fp_mask.len == 0 {
        << !want_fp
    }
    << fp_mask[v] == want_fp
}

fn ra_scan_class(f &mir.MFn, s &RaScan, cand &[]bool, fp_mask &[]bool, want_fp bool, callee &[]int, caller &[]int, info $&RaInfo) {
    nt := s.nt
    nv := s.start.len
    // Order values by interval start (counting sort over positions).
    $maxp := 0
    for v in 0:nv {
        if ra_cand_ok(s, v, nt, cand, fp_mask, want_fp) && s.start[v] > maxp {
            maxp = s.start[v]
        }
    }
    $count := []int{}
    for _ in 0:maxp + 2 {
        count.push(0)
    }
    for v in 0:nv {
        if ra_cand_ok(s, v, nt, cand, fp_mask, want_fp) {
            count[s.start[v] + 1] += 1
        }
    }
    for p in 1:count.len {
        count[p] += count[p - 1]
    }
    $order := []int{}
    for _ in 0:count[count.len - 1] {
        order.push(0)
    }
    for v in 0:nv {
        if ra_cand_ok(s, v, nt, cand, fp_mask, want_fp) {
            order[count[s.start[v]]] = v
            count[s.start[v]] += 1
        }
    }
    $reg := []int{}
    for _ in 0:nv {
        reg.push(-1)
    }
    $active := []int{}
    $free_callee := []bool{}
    for _ in 0:callee.len {
        free_callee.push(true)
    }
    $free_caller := []bool{}
    for _ in 0:caller.len {
        free_caller.push(true)
    }
    $callee_used := []bool{}
    for _ in 0:callee.len {
        callee_used.push(false)
    }
    for oi in 0:order.len {
        v := order[oi]
        st := s.start[v]
        // Expire intervals that ended before this one starts.
        $keep := []int{}
        for ai in 0:active.len {
            a := active[ai]
            if s.end[a] < st {
                ra_release(reg[a], callee, caller, $&free_callee, $&free_caller)
            } else {
                keep.push(a)
            }
        }
        active = keep
        crosses := ra_crosses_call(s, v)
        $r := -1
        if !crosses {
            for i in 0:caller.len {
                if r < 0 && free_caller[i] {
                    free_caller[i] = false
                    r = caller[i]
                }
            }
        }
        for i in 0:callee.len {
            if r < 0 && free_callee[i] {
                free_callee[i] = false
                callee_used[i] = true
                r = callee[i]
            }
        }
        if r < 0 {
            // Take the register of the lightest (or longest remaining at equal
            // weight) active value that suits this one.
            $victim := -1
            for ai in 0:active.len {
                a := active[ai]
                if (!crosses || ra_index(callee, reg[a]) >= 0) &&
                   (s.weight[a] < s.weight[v] || (s.weight[a] == s.weight[v] && s.end[a] > s.end[v])) {
                    if victim < 0 || s.weight[a] < s.weight[victim] ||
                       (s.weight[a] == s.weight[victim] && s.end[a] > s.end[victim]) {
                        victim = a
                    }
                }
            }
            if victim >= 0 {
                r = reg[victim]
                reg[victim] = -1
                $keep2 := []int{}
                for ai in 0:active.len {
                    if active[ai] != victim {
                        keep2.push(active[ai])
                    }
                }
                active = keep2
            }
        }
        if r >= 0 {
            reg[v] = r
            active.push(v)
        }
    }
    for v in 0:nv {
        if reg[v] >= 0 {
            if v < nt {
                info.temp_reg[v] = reg[v]
            } else {
                info.local_reg[v - nt] = reg[v]
            }
        }
    }
    for i in 0:callee.len {
        if callee_used[i] {
            info.used_callee.push(callee[i])
        }
    }
}

fn ra_index(list &[]int, r int) int {
    for i in 0:list.len {
        if list[i] == r {
            << i
        }
    }
    << -1
}

fn ra_release(r int, callee &[]int, caller &[]int, free_callee $&[]bool, free_caller $&[]bool) {
    i := ra_index(callee, r)
    if i >= 0 {
        free_callee[i] = true
        <<
    }
    j := ra_index(caller, r)
    if j >= 0 {
        free_caller[j] = true
    }
}

fn ra_bump_use(uses $&[]int, v int) {
    if v >= 0 && v < uses.len {
        uses[v] = uses[v] + 1
    }
}

// Number of reads of each temp (instruction operands, call arguments and
// branch/return values).
pub fn temp_use_counts(f &mir.MFn) []int {
    $uses := []int{}
    for _ in 0:f.temps.len {
        uses.push(0)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == mir.MI_COPY || k == mir.MI_STORE_LOCAL || k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD || k == mir.MI_CALL_IND {
                ra_bump_use($&uses, ins.b)
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                ra_bump_use($&uses, ins.a)
                ra_bump_use($&uses, ins.b)
            } else if k == mir.MI_UN {
                ra_bump_use($&uses, ins.c)
            } else if k == mir.MI_BIN {
                ra_bump_use($&uses, ins.c)
                ra_bump_use($&uses, ins.d)
            } else if k == mir.MI_SELECT {
                ra_bump_use($&uses, ins.b)
                ra_bump_use($&uses, ins.c)
                ra_bump_use($&uses, ins.d)
            }
            if k == mir.MI_CALL || k == mir.MI_CALL_IND {
                $a := ins.c
                while a >= 0 {
                    ra_bump_use($&uses, f.margs[a].v)
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == mir.TKIND_BRANCH || tk == mir.TKIND_RETURN {
            ra_bump_use($&uses, f.blocks[bi].ta)
        }
    }
    << uses
}
