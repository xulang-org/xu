@xu/codegen
// Register allocator state and physical register mapping.
//
// Layer 4C module: decoupled register allocator managing physical register
// allocation, spilling, and caller/callee-saved register tracking.

#xu/target

pub struct RegBinding {
    pub vreg int
    pub preg int
    pub is_dirty bool
    pub is_pinned bool
}

pub struct RegAlloc {
    pub target target.Target
    pub num_pregs int
    pub bindings []RegBinding
    pub free_regs []int
}

pub fn regalloc_new(t &target.Target, num_pregs int) RegAlloc {
    $free_list := []int{}
    for i in 0:num_pregs {
        free_list.push(i)
    }
    << RegAlloc{
        target: ~t,
        num_pregs: num_pregs,
        bindings: []RegBinding{},
        free_regs: free_list
    }
}

pub fn (ra $&RegAlloc) alloc_reg(vreg int) int {
    if ra.free_regs.len > 0 {
        last_idx := ra.free_regs.len - 1
        preg := ra.free_regs[last_idx]
        $next_free := []int{}
        for i in 0:last_idx {
            next_free.push(ra.free_regs[i])
        }
        ra.free_regs = next_free
        ra.bindings.push(RegBinding{
            vreg: vreg,
            preg: preg,
            is_dirty: false,
            is_pinned: false
        })
        << preg
    }
    // Spill required when free list is empty (-1 signals caller to spill)
    << -1
}

pub fn (ra $&RegAlloc) free_reg(preg int) {
    $next_bindings := []RegBinding{}
    $found := false
    for i in 0:ra.bindings.len {
        if ra.bindings[i].preg == preg {
            found = true
        } else {
            next_bindings.push(~ra.bindings[i])
        }
    }
    ra.bindings = next_bindings
    if found {
        ra.free_regs.push(preg)
    }
}

pub struct LocalAlloc {
    pub local_regs []int
    pub num_pairs int
}

pub fn alloc_locals_arm64(nlocals int, enabled bool) LocalAlloc {
    $reg_map := []int{}
    if !enabled || nlocals == 0 {
        for i in 0:nlocals {
            reg_map.push(-1)
        }
        << LocalAlloc{ local_regs: reg_map, num_pairs: 0 }
    }

    $pool := []int{}
    pool.push(19)
    pool.push(20)
    pool.push(21)
    pool.push(22)
    pool.push(23)
    pool.push(24)
    pool.push(25)
    pool.push(26)
    $used := 0
    for i in 0:nlocals {
        if i < pool.len {
            reg_map.push(pool[i])
            used += 1
        } else {
            reg_map.push(-1)
        }
    }

    // Round up pairs (1 or 2 regs -> 1 pair (16B); 3 or 4 regs -> 2 pairs (32B))
    $pairs := (used + 1) / 2
    if pairs > 4 { pairs = 4 }
    << LocalAlloc{ local_regs: reg_map, num_pairs: pairs }
}
