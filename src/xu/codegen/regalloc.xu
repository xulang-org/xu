@xu/codegen
// Register allocation for the typed backends: linear scan over
// conservative live intervals of temps and of scalar locals whose address
// is never taken.
//
// Positions number the instructions in block order: instruction k uses
// its operands at 2k and defines its result at 2k + 1; a call clobbers the
// caller-saved registers at 2k + 1. A value live in a block's entry or
// exit covers the whole block. Values that cross a call get callee-saved
// registers; anything left over keeps its frame slot.

#xu/mir

pub struct RaInfo {
    pub temp_reg []int
    pub local_reg []int
    pub used_callee []int
    pub call_save_off []int
    pub call_save_len []int
    pub call_save_regs []int
    pub max_call_saves int
    pub remat_addr []int
    pub remat_const []int
}

// Every value in its frame slot.
pub fn ra_none(f &mir.MFn) RaInfo {
    $t := []int{}
    for _ in 0:f.temps.len {
        t.push(-1)
    }
    $l := []int{}
    for _ in 0:f.locals.len {
        l.push(-1)
    }
    << RaInfo{
        temp_reg: t,
        local_reg: l,
        used_callee: []int{},
        call_save_off: []int{},
        call_save_len: []int{},
        call_save_regs: []int{},
        max_call_saves: 0,
        remat_addr: []int{},
        remat_const: []int{}
    }
}

struct RaScan {
    nt int
    start []int
    end []int
    home []int
    first_def []bool
    is_global []bool
    calls []int
    cur_w int
    // Uses and definitions weighted by loop depth; the cheapest value to
    // keep in memory has the smallest weight.
    weight []int
    max_w []int
}

fn ra_touch(s $&RaScan, v int, pos int, blk int, is_def bool) {
    if v < 0 || v >= s.start.len {
        <<
    }
    s.weight[v] = s.weight[v] + s.cur_w
    if s.cur_w > s.max_w[v] {
        s.max_w[v] = s.cur_w
    }
    if s.home[v] == -1 {
        s.home[v] = blk
        s.first_def[v] = is_def
    } else if s.home[v] != blk {
        s.is_global[v] = true
    }
    if pos < s.start[v] {
        s.start[v] = pos
    }
    if pos > s.end[v] {
        s.end[v] = pos
    }
}

fn ra_use(s $&RaScan, v int, pos int, blk int) {
    if v >= 0 && v < s.nt {
        ra_touch(s, v, pos, blk, false)
    }
}

pub fn is_noreturn_call(label &string) bool {
    << *label == "_xu_runtime_core_rt_panic" ||
       *label == "_xu_runtime_core_index_panic" ||
       *label == "_xu_runtime_core_exit_process" ||
       *label == "_xu_runtime_core_intrin_assert_fail" ||
       *label == "_xu_runtime_core_intrin_fatal" ||
       *label == "_xu_runtime_core_fatal_no_memory"
}

fn ra_is_clobber_call(ins &mir.MInstr, inline_bits bool) bool {
    if ins.kind == mir.MI_ASM && ins.c >= 0 { << true }
    if ins.kind == mir.MI_CALL_IND { << true }
    if ins.kind != mir.MI_CALL { << false }
    if is_noreturn_call(&ins.sval) { << false }
    if inline_bits && bits_hw_entry(&ins.sval, true) { << false }
    << true
}

fn ra_def_temp(s $&RaScan, uses &[]int, v int, pos int, blk int) {
    if v >= 0 && v < uses.len && uses[v] > 0 {
        ra_touch(s, v, pos, blk, true)
    }
}

// The vreg operands an instruction reads, and the one it writes (-1 none).
fn ra_scan_instr(f &mir.MFn, s $&RaScan, ii int, ins &mir.MInstr, pos int, blk int, cand &[]bool, uses &[]int, inline_bits bool) {
    k := ins.kind
    nt := s.nt
    if k == mir.MI_LOAD_LOCAL {
        if cand[ins.b] {
            ra_touch(s, nt + ins.b, pos, blk, false)
        }
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_STORE_LOCAL {
        ra_use(s, ins.b, pos, blk)
        if cand[ins.a] {
            ra_touch(s, nt + ins.a, pos + 1, blk, true)
        }
    } else if k == mir.MI_ADDR || k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD || k == mir.MI_COPY {
        ra_use(s, ins.b, pos, blk)
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
        ra_use(s, ins.a, pos, blk)
        ra_use(s, ins.b, pos, blk)
    } else if k == mir.MI_BIN {
        ra_use(s, ins.c, pos, blk)
        ra_use(s, ins.d, pos, blk)
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_UN {
        ra_use(s, ins.c, pos, blk)
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_SELECT {
        ra_use(s, ins.b, pos, blk)
        ra_use(s, ins.c, pos, blk)
        ra_use(s, ins.d, pos, blk)
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_VLOAD128 {
        ra_use(s, ins.b, pos, blk)
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_VSTORE128 {
        ra_use(s, ins.a, pos, blk)
        ra_use(s, ins.b, pos, blk)
    } else if k == mir.MI_VBIN128 {
        ra_use(s, ins.c, pos, blk)
        ra_use(s, ins.d, pos, blk)
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_VPACK128 {
        ra_use(s, ins.b, pos, blk)
        if ins.d != 0 {
            ra_use(s, ins.c, pos, blk)
        }
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_VEXTRACT {
        ra_use(s, ins.b, pos, blk)
        ra_def_temp(s, uses, ins.a, pos + 1, blk)
    } else if k == mir.MI_CALL || k == mir.MI_CALL_IND || (k == mir.MI_ASM && ins.c >= 0) {
        if k == mir.MI_CALL_IND {
            ra_use(s, ins.b, pos, blk)
        }
        $a := ins.c
        while a >= 0 {
            ra_use(s, f.margs[a].v, pos, blk)
            a = f.margs[a].next
        }
        if ra_is_clobber_call(&f.instrs[ii], inline_bits) {
            s.calls.push(pos + 1)
        }
        if k != mir.MI_ASM {
            ra_def_temp(s, uses, ins.a, pos + 1, blk)
        }
    }
}

fn ra_bit_set(bits $&[]int, base int, i int) {
    bits[base + (i >> 6)] = bits[base + (i >> 6)] | (1 << (i & 63))
}

fn ra_bit(bits &[]int, base int, i int) bool {
    << ((bits[base + (i >> 6)] >> (i & 63)) & 1) != 0
}

fn ra_gen(f &mir.MFn, s &RaScan, gidx &[]int, ins &mir.MInstr, use_b $&[]int, def_b $&[]int, base int, cand &[]bool) {
    k := ins.kind
    nt := s.nt
    $uses := []int{}
    $def := -1
    if k == mir.MI_LOAD_LOCAL {
        if cand[ins.b] {
            uses.push(nt + ins.b)
        }
        def = ins.a
    } else if k == mir.MI_STORE_LOCAL {
        uses.push(ins.b)
        if cand[ins.a] {
            def = nt + ins.a
        }
    } else if k == mir.MI_ADDR || k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
        def = ins.a
    } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD || k == mir.MI_COPY {
        uses.push(ins.b)
        def = ins.a
    } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
        uses.push(ins.a)
        uses.push(ins.b)
    } else if k == mir.MI_BIN {
        uses.push(ins.c)
        uses.push(ins.d)
        def = ins.a
    } else if k == mir.MI_UN {
        uses.push(ins.c)
        def = ins.a
    } else if k == mir.MI_SELECT {
        uses.push(ins.b)
        uses.push(ins.c)
        uses.push(ins.d)
        def = ins.a
    } else if k == mir.MI_VLOAD128 {
        uses.push(ins.b)
        def = ins.a
    } else if k == mir.MI_VSTORE128 {
        uses.push(ins.a)
        uses.push(ins.b)
    } else if k == mir.MI_VBIN128 {
        uses.push(ins.c)
        uses.push(ins.d)
        def = ins.a
    } else if k == mir.MI_VPACK128 {
        uses.push(ins.b)
        if ins.d != 0 {
            uses.push(ins.c)
        }
        def = ins.a
    } else if k == mir.MI_VEXTRACT {
        uses.push(ins.b)
        def = ins.a
    } else if k == mir.MI_CALL || k == mir.MI_CALL_IND || (k == mir.MI_ASM && ins.c >= 0) {
        if k == mir.MI_CALL_IND {
            uses.push(ins.b)
        }
        $a := ins.c
        while a >= 0 {
            uses.push(f.margs[a].v)
            a = f.margs[a].next
        }
        if k != mir.MI_ASM {
            def = ins.a
        }
    }
    for i in 0:uses.len {
        u := uses[i]
        if u >= 0 && u < gidx.len && gidx[u] >= 0 && !ra_bit(def_b, base, gidx[u]) {
            ra_bit_set(use_b, base, gidx[u])
        }
    }
    if def >= 0 && def < gidx.len && gidx[def] >= 0 {
        ra_bit_set(def_b, base, gidx[def])
    }
}

fn ra_term_use(s $&RaScan, blk &mir.MBlock, pos int, bi int) {
    if blk.tkind == mir.TKIND_RETURN || blk.tkind == mir.TKIND_BRANCH {
        ra_use(s, blk.ta, pos, bi)
    }
}

fn fp_mark_int(v int, int_only $&[]bool) {
    if v >= 0 && v < int_only.len {
        int_only[v] = true
    }
}

fn fp_mark_float(v int, int_only &[]bool, is_fp $&[]bool) bool {
    if v >= 0 && v < is_fp.len && !int_only[v] && !is_fp[v] {
        is_fp[v] = true
        << true
    }
    << false
}

fn is_fneg_xor(f &mir.MFn, ins &mir.MInstr) int {
    if ins.kind != mir.MI_BIN || ins.b != mir.BIN_XOR {
        << -1
    }
    sb := -9223372036854775807 - 1
    if ins.d <= -2 && f.consts[0 - ins.d - 2] == sb && ins.c >= 0 {
        << ins.c
    }
    if ins.c <= -2 && f.consts[0 - ins.c - 2] == sb && ins.d >= 0 {
        << ins.d
    }
    << -1
}

fn is_fabs_and(f &mir.MFn, ins &mir.MInstr) int {
    if ins.kind != mir.MI_BIN || ins.b != mir.BIN_AND {
        << -1
    }
    am := 9223372036854775807
    if ins.d <= -2 && f.consts[0 - ins.d - 2] == am && ins.c >= 0 {
        << ins.c
    }
    if ins.c <= -2 && f.consts[0 - ins.c - 2] == am && ins.d >= 0 {
        << ins.d
    }
    << -1
}

fn ra_fp_mask(f &mir.MFn, cand &[]bool) []bool {
    $has_fp_op := false
    for ii in 0:f.instrs.len {
        k := f.instrs[ii].kind
        if k == mir.MI_UN {
            has_fp_op = true
            <-
        } else if (k == mir.MI_BIN && f.instrs[ii].b >= mir.BIN_FADD && f.instrs[ii].b <= mir.BIN_FGE) ||
                  (k >= mir.MI_VLOAD128 && k <= mir.MI_VEXTRACT) {
            has_fp_op = true
            <-
        }
    }
    if !has_fp_op {
        << []bool{}
    }
    nt := f.temps.len
    nl := f.locals.len
    nv := nt + nl
    $int_only := []bool{}
    $is_fp := []bool{}
    for _ in 0:nv {
        int_only.push(false)
        is_fp.push(false)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if k == mir.MI_ADDR || k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
                fp_mark_int(ins.a, $&int_only)
            } else if k == mir.MI_CALL_IND {
                fp_mark_int(ins.b, $&int_only)
            } else if k == mir.MI_SELECT {
                fp_mark_int(ins.b, $&int_only)
            } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD {
                fp_mark_int(ins.b, $&int_only)
                if ins.d == 1 || ins.d == 2 || ins.d == 4 || ins.d == -4 {
                    fp_mark_int(ins.a, $&int_only)
                }
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                fp_mark_int(ins.a, $&int_only)
                if ins.d == 1 || ins.d == 2 || ins.d == 4 || ins.d == -4 {
                    fp_mark_int(ins.b, $&int_only)
                }
            } else if k == mir.MI_LOAD_LOCAL {
                if ins.c > 0 && ins.b >= 0 && ins.b < nl {
                    fp_mark_int(nt + ins.b, $&int_only)
                }
            } else if k == mir.MI_STORE_LOCAL {
                if ins.c > 0 && ins.a >= 0 && ins.a < nl {
                    fp_mark_int(nt + ins.a, $&int_only)
                }
            } else if k == mir.MI_UN {
                if ins.b == mir.UN_I2F {
                    fp_mark_int(ins.c, $&int_only)
                } else if ins.b == mir.UN_F2I {
                    fp_mark_int(ins.a, $&int_only)
                } else if ins.b == mir.UN_F32_LOAD || ins.b == mir.UN_F32_STORE {
                    fp_mark_int(ins.a, $&int_only)
                    fp_mark_int(ins.c, $&int_only)
                }
            } else if k == mir.MI_BIN {
                if ins.b >= mir.BIN_FEQ && ins.b <= mir.BIN_FGE {
                    fp_mark_int(ins.a, $&int_only)
                } else if ins.b < mir.BIN_FADD && is_fneg_xor(f, &ins) < 0 && is_fabs_and(f, &ins) < 0 {
                    fp_mark_int(ins.a, $&int_only)
                    fp_mark_int(ins.c, $&int_only)
                    fp_mark_int(ins.d, $&int_only)
                }
            } else if k == mir.MI_VLOAD128 {
                fp_mark_int(ins.b, $&int_only)
            } else if k == mir.MI_VSTORE128 {
                fp_mark_int(ins.a, $&int_only)
            } else if k == mir.MI_VEXTRACT && ins.d == 0 {
                fp_mark_int(ins.a, $&int_only)
            }
            ii = ins.next
        }
        if f.blocks[bi].tkind == mir.TKIND_BRANCH {
            fp_mark_int(f.blocks[bi].ta, $&int_only)
        }
    }
    // Propagate int_only across plain copies/locals/selects so mixed values stay GPR.
    for _ in 0:8 {
        $ch := false
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                k := ins.kind
                if k == mir.MI_COPY {
                    if ins.a >= 0 && ins.b >= 0 && ins.a < nv && ins.b < nv && (int_only[ins.a] != int_only[ins.b]) {
                        int_only[ins.a] = true
                        int_only[ins.b] = true
                        ch = true
                    }
                } else if k == mir.MI_LOAD_LOCAL && ins.c <= 0 && ins.b >= 0 && ins.b < nl && cand[ins.b] {
                    if ins.a >= 0 && ins.a < nt && (int_only[ins.a] != int_only[nt + ins.b]) {
                        int_only[ins.a] = true
                        int_only[nt + ins.b] = true
                        ch = true
                    }
                } else if k == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && ins.a < nl && cand[ins.a] {
                    if ins.b >= 0 && ins.b < nt && (int_only[ins.b] != int_only[nt + ins.a]) {
                        int_only[ins.b] = true
                        int_only[nt + ins.a] = true
                        ch = true
                    }
                } else if k == mir.MI_SELECT {
                    a_i := ins.a >= 0 && ins.a < nt && int_only[ins.a]
                    c_i := ins.c >= 0 && ins.c < nt && int_only[ins.c]
                    d_i := ins.d >= 0 && ins.d < nt && int_only[ins.d]
                    if a_i || c_i || d_i {
                        if ins.a >= 0 && ins.a < nt && !int_only[ins.a] {
                            int_only[ins.a] = true
                            ch = true
                        }
                        if ins.c >= 0 && ins.c < nt && !int_only[ins.c] {
                            int_only[ins.c] = true
                            ch = true
                        }
                        if ins.d >= 0 && ins.d < nt && !int_only[ins.d] {
                            int_only[ins.d] = true
                            ch = true
                        }
                    }
                }
                ii = ins.next
            }
        }
        if !ch { <- }
    }
    // Seed float operands and results.
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if k == mir.MI_BIN {
                if ins.b >= mir.BIN_FADD && ins.b <= mir.BIN_FDIV {
                    fp_mark_float(ins.a, &int_only, $&is_fp)
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                    fp_mark_float(ins.d, &int_only, $&is_fp)
                } else if ins.b >= mir.BIN_FEQ && ins.b <= mir.BIN_FGE {
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                    fp_mark_float(ins.d, &int_only, $&is_fp)
                }
            } else if k == mir.MI_UN {
                if ins.b == mir.UN_I2F {
                    fp_mark_float(ins.a, &int_only, $&is_fp)
                } else if ins.b == mir.UN_F2I {
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                } else if ins.b == mir.UN_FSQRT {
                    fp_mark_float(ins.a, &int_only, $&is_fp)
                    fp_mark_float(ins.c, &int_only, $&is_fp)
                }
            } else if k == mir.MI_VLOAD128 {
                fp_mark_float(ins.a, &int_only, $&is_fp)
            } else if k == mir.MI_VSTORE128 {
                fp_mark_float(ins.b, &int_only, $&is_fp)
            } else if k == mir.MI_VBIN128 {
                fp_mark_float(ins.a, &int_only, $&is_fp)
                fp_mark_float(ins.c, &int_only, $&is_fp)
                fp_mark_float(ins.d, &int_only, $&is_fp)
            } else if k == mir.MI_VPACK128 {
                fp_mark_float(ins.a, &int_only, $&is_fp)
            } else if k == mir.MI_VEXTRACT {
                fp_mark_float(ins.b, &int_only, $&is_fp)
            }
            ii = ins.next
        }
    }
    for _ in 0:8 {
        $ch := false
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                k := ins.kind
                if k == mir.MI_COPY {
                    if ins.a >= 0 && ins.b >= 0 && ins.a < nt && ins.b < nt && (is_fp[ins.a] || is_fp[ins.b]) {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(ins.b, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_LOAD_LOCAL && ins.c <= 0 && ins.b >= 0 && ins.b < nl && cand[ins.b] {
                    if ins.a >= 0 && ins.a < nt && (is_fp[ins.a] || is_fp[nt + ins.b]) {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(nt + ins.b, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && ins.a < nl && cand[ins.a] {
                    if ins.b >= 0 && ins.b < nt && (is_fp[ins.b] || is_fp[nt + ins.a]) {
                        if fp_mark_float(ins.b, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(nt + ins.a, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_SELECT {
                    a_f := ins.a >= 0 && ins.a < nt && is_fp[ins.a]
                    c_f := ins.c >= 0 && ins.c < nt && is_fp[ins.c]
                    d_f := ins.d >= 0 && ins.d < nt && is_fp[ins.d]
                    if a_f || c_f || d_f {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(ins.c, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(ins.d, &int_only, $&is_fp) { ch = true }
                    }
                } else if k == mir.MI_BIN {
                    $x := is_fneg_xor(f, &ins)
                    if x < 0 { x = is_fabs_and(f, &ins) }
                    if x >= 0 && x < nt && ins.a >= 0 && ins.a < nt && (is_fp[ins.a] || is_fp[x]) {
                        if fp_mark_float(ins.a, &int_only, $&is_fp) { ch = true }
                        if fp_mark_float(x, &int_only, $&is_fp) { ch = true }
                    }
                }
                ii = ins.next
            }
        }
        if !ch { <- }
    }
    $any_fp := false
    for v in 0:nv {
        if is_fp[v] {
            any_fp = true
            <-
        }
    }
    if !any_fp {
        << []bool{}
    }
    << is_fp
}

// Allocate registers for f. callee lists callee-saved registers, caller
// the scratch registers a call clobbers.
// CFG reverse-postorder traversal of reachable blocks, visiting colder /
// shallower / panic children first in DFS so the hot continuation immediately
// follows each branch in the linear scan order.
fn ra_block_hot_first(depth &[]int, is_panic &[]bool, a int, b int) bool {
    if is_panic[a] != is_panic[b] {
        << !is_panic[a]
    }
    if depth[a] != depth[b] {
        << depth[a] > depth[b]
    }
    << true
}

fn ra_block_order(f &mir.MFn, depth &[]int) []int {
    nb := f.blocks.len
    $order := []int{}
    if nb == 0 {
        << order
    }
    $is_panic := []bool{}
    for bi in 0:nb {
        $p := false
        if bi > 0 {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == mir.MI_CALL && is_noreturn_call(&f.instrs[ii].sval) {
                    p = true
                    <-
                }
                ii = ins.next
            }
        }
        is_panic.push(p)
    }
    $seen := []bool{}
    $next_i := []int{}
    $stack := []int{}
    $post := []int{}
    for _ in 0:nb {
        seen.push(false)
        next_i.push(0)
        stack.push(0)
    }
    seen[0] = true
    stack[0] = 0
    $sp := 1
    while sp > 0 {
        b := stack[sp - 1]
        $s0 := -1
        $s1 := -1
        $ns := 0
        if !is_panic[b] {
            tk := f.blocks[b].tkind
            if tk == mir.TKIND_JUMP {
                s := f.blocks[b].ta
                if s >= 0 && s < nb {
                    s0 = s
                    ns = 1
                }
            } else if tk == mir.TKIND_BRANCH {
                tb := f.blocks[b].tb
                tc := f.blocks[b].tc
                vb := tb >= 0 && tb < nb
                vc := tc >= 0 && tc < nb && tc != tb
                if vb && vc {
                    // Visit the colder child first so the hotter one lands right after b in RPO.
                    if ra_block_hot_first(depth, &is_panic, tb, tc) {
                        s0 = tc
                        s1 = tb
                    } else {
                        s0 = tb
                        s1 = tc
                    }
                    ns = 2
                } else if vb {
                    s0 = tb
                    ns = 1
                } else if vc {
                    s0 = tc
                    ns = 1
                }
            }
        }
        if next_i[b] < ns {
            $s := s0
            if next_i[b] == 1 {
                s = s1
            }
            next_i[b] = next_i[b] + 1
            if !seen[s] {
                seen[s] = true
                stack[sp] = s
                sp += 1
            }
        } else {
            post.push(b)
            sp -= 1
        }
    }
    $ri := post.len - 1
    while ri >= 0 {
        order.push(post[ri])
        ri -= 1
    }
    << order
}

pub fn ra_alloc(f &mir.MFn, callee &[]int, caller &[]int) RaInfo {
    $empty := []int{}
    << ra_alloc_fp_hints(f, callee, caller, &empty, &empty, &empty, -1)
}

pub fn ra_alloc_fp(f &mir.MFn, callee &[]int, caller &[]int, fp_callee &[]int, fp_caller &[]int) RaInfo {
    $empty := []int{}
    << ra_alloc_fp_hints(f, callee, caller, fp_callee, fp_caller, &empty, -1)
}

pub fn ra_alloc_fp_hints(f &mir.MFn, callee &[]int, caller &[]int, fp_callee &[]int, fp_caller &[]int, arg_regs &[]int, ret_reg int) RaInfo {
    << ra_alloc_fp_hints_ex(f, callee, caller, fp_callee, fp_caller, arg_regs, ret_reg, false)
}

fn ra_find_remat(f &mir.MFn, order &[]int, uses &[]int, s $&RaScan, t_addr_loc $&[]int, t_const_ci $&[]int, force_remat $&[]bool) {
    nt := f.temps.len
    $ndef := []int{}
    $is_addr := []bool{}
    $only_mem_call := []bool{}
    for _ in 0:nt {
        ndef.push(0)
        is_addr.push(false)
        only_mem_call.push(true)
        t_addr_loc.push(-1)
        t_const_ci.push(-1)
        force_remat.push(false)
    }
    for oi in 0:order.len {
        bi := order[oi]
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k != mir.MI_NOP && k != mir.MI_STORE_LOCAL && k != mir.MI_STORE_PTR && k != mir.MI_VOLATILE_STORE && k != mir.MI_VSTORE128 && ins.a >= 0 && ins.a < nt {
                d := ins.a
                ndef[d] = ndef[d] + 1
                if k == mir.MI_ADDR && ins.b >= 0 && ins.b < f.locals.len {
                    is_addr[d] = true
                    t_addr_loc[d] = ins.b
                } else if k == mir.MI_COPY && ins.b <= -2 {
                    ci := 0 - ins.b - 2
                    if ci >= 0 && ci < f.consts.len {
                        t_const_ci[d] = ci
                    }
                }
            }
            ii = ins.next
        }
    }
    for t in 0:nt {
        if ndef[t] != 1 {
            t_addr_loc[t] = -1
            t_const_ci[t] = -1
            is_addr[t] = false
        }
    }
    for oi in 0:order.len {
        bi := order[oi]
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == mir.MI_COPY || k == mir.MI_STORE_LOCAL || k == mir.MI_VOLATILE_LOAD || k == mir.MI_CALL_IND {
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
            } else if k == mir.MI_LOAD_PTR {
                if ins.b >= 0 && ins.b < nt && ins.c < 0 { only_mem_call[ins.b] = false }
            } else if k == mir.MI_STORE_PTR {
                if ins.a >= 0 && ins.a < nt && ins.c < 0 { only_mem_call[ins.a] = false }
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
            } else if k == mir.MI_VOLATILE_STORE {
                if ins.a >= 0 && ins.a < nt { only_mem_call[ins.a] = false }
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
            } else if k == mir.MI_UN {
                if ins.c >= 0 && ins.c < nt { only_mem_call[ins.c] = false }
            } else if k == mir.MI_BIN {
                if ins.c >= 0 && ins.c < nt { only_mem_call[ins.c] = false }
                if ins.d >= 0 && ins.d < nt { only_mem_call[ins.d] = false }
            } else if k == mir.MI_SELECT {
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
                if ins.c >= 0 && ins.c < nt { only_mem_call[ins.c] = false }
                if ins.d >= 0 && ins.d < nt { only_mem_call[ins.d] = false }
            } else if k == mir.MI_VLOAD128 {
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
            } else if k == mir.MI_VSTORE128 {
                if ins.a >= 0 && ins.a < nt { only_mem_call[ins.a] = false }
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
            } else if k == mir.MI_VBIN128 {
                if ins.c >= 0 && ins.c < nt { only_mem_call[ins.c] = false }
                if ins.d >= 0 && ins.d < nt { only_mem_call[ins.d] = false }
            } else if k == mir.MI_VPACK128 {
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
                if ins.d != 0 && ins.c >= 0 && ins.c < nt { only_mem_call[ins.c] = false }
            } else if k == mir.MI_VEXTRACT {
                if ins.b >= 0 && ins.b < nt { only_mem_call[ins.b] = false }
            }
            if k == mir.MI_CALL_IND {
                $a := ins.c
                while a >= 0 {
                    av := f.margs[a].v
                    if av >= 0 && av < nt { only_mem_call[av] = false }
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if (tk == mir.TKIND_BRANCH || tk == mir.TKIND_RETURN) && f.blocks[bi].ta >= 0 && f.blocks[bi].ta < nt {
            only_mem_call[f.blocks[bi].ta] = false
        }
    }
    for t in 0:nt {
        if is_addr[t] && uses[t] > 0 {
            if only_mem_call[t] {
                force_remat[t] = true
                s.end[t] = -1
                s.is_global[t] = false
            } else {
                $w := (s.weight[t] + 3) / 4
                if w < 1 { w = 1 }
                s.weight[t] = w
            }
        } else if t_const_ci[t] >= 0 && uses[t] > 0 {
            cv := f.consts[t_const_ci[t]]
            if cv >= -4095 && cv <= 65535 {
                $w := (s.weight[t] + 3) / 4
                if w < 1 { w = 1 }
                s.weight[t] = w
            }
        }
    }
}

fn ra_compute_call_weights(f &mir.MFn, order &[]int, depth &[]int, inline_bits bool) []int {
    nb := f.blocks.len
    $rpo_pos := []int{}
    $blk_has_call := []bool{}
    $blk_is_panic := []bool{}
    $pred_cnt := []int{}
    $is_loop_hdr := []bool{}
    $cold_arm := []bool{}
    $call_w := []int{}
    for _ in 0:nb {
        rpo_pos.push(-1)
        blk_has_call.push(false)
        blk_is_panic.push(false)
        pred_cnt.push(0)
        is_loop_hdr.push(false)
        cold_arm.push(false)
        call_w.push(1)
    }
    for oi in 0:order.len {
        bi := order[oi]
        rpo_pos[bi] = oi
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ra_is_clobber_call(ins, inline_bits) {
                blk_has_call[bi] = true
            } else if ins.kind == mir.MI_CALL && is_noreturn_call(&ins.sval) {
                blk_is_panic[bi] = true
            }
            ii = ins.next
        }
    }
    for oi in 0:order.len {
        bi := order[oi]
        if blk_is_panic[bi] { -> }
        tk := f.blocks[bi].tkind
        if tk == mir.TKIND_JUMP {
            s := f.blocks[bi].ta
            if s >= 0 && s < nb && rpo_pos[s] >= 0 {
                pred_cnt[s] = pred_cnt[s] + 1
                if rpo_pos[s] <= oi { is_loop_hdr[s] = true }
            }
        } else if tk == mir.TKIND_BRANCH {
            tb := f.blocks[bi].tb
            tc := f.blocks[bi].tc
            if tb >= 0 && tb < nb && rpo_pos[tb] >= 0 {
                pred_cnt[tb] = pred_cnt[tb] + 1
                if rpo_pos[tb] <= oi { is_loop_hdr[tb] = true }
            }
            if tc >= 0 && tc < nb && tc != tb && rpo_pos[tc] >= 0 {
                pred_cnt[tc] = pred_cnt[tc] + 1
                if rpo_pos[tc] <= oi { is_loop_hdr[tc] = true }
            }
        }
    }
    for oi in 0:order.len {
        bi := order[oi]
        if !blk_is_panic[bi] && f.blocks[bi].tkind == mir.TKIND_BRANCH {
            tb := f.blocks[bi].tb
            tc := f.blocks[bi].tc
            if tb >= 0 && tb < nb && tc >= 0 && tc < nb && tb != tc {
                if blk_has_call[tb] && !blk_has_call[tc] && !blk_is_panic[tc] && !is_loop_hdr[tb] && pred_cnt[tb] == 1 {
                    cold_arm[tb] = true
                }
                if blk_has_call[tc] && !blk_has_call[tb] && !blk_is_panic[tb] && !is_loop_hdr[tc] && pred_cnt[tc] == 1 {
                    cold_arm[tc] = true
                }
            }
        }
    }
    for bi in 0:nb {
        $dd := 0
        if bi < depth.len { dd = depth[bi] }
        if dd > 5 { dd = 5 }
        $w := 1 << (3 * dd)
        if cold_arm[bi] {
            w = w >> 3
            if w < 1 { w = 1 }
        }
        call_w[bi] = w
    }
    << call_w
}

pub fn ra_alloc_fp_hints_ex(f &mir.MFn, callee &[]int, caller &[]int, fp_callee &[]int, fp_caller &[]int, arg_regs &[]int, ret_reg int, inline_bits bool) RaInfo {
    nt := f.temps.len
    nl := f.locals.len
    nv := nt + nl
    $cand := []bool{}
    for li in 0:nl {
        cand.push(li >= f.locals_nslots.len || f.locals_nslots[li] <= 1)
    }
    for i in 0:f.instrs.len {
        k := f.instrs[i].kind
        b := f.instrs[i].b
        a := f.instrs[i].a
        c := f.instrs[i].c
        if k == mir.MI_ADDR && b >= 0 && b < nl {
            cand[b] = false
        } else if k == mir.MI_LOAD_LOCAL && c > 0 && b >= 0 && b < nl {
            cand[b] = false
        } else if k == mir.MI_STORE_LOCAL && c > 0 && a >= 0 && a < nl {
            cand[a] = false
        }
    }
    $s := RaScan{nt: nt, start: []int{}, end: []int{}, home: []int{}, first_def: []bool{}, is_global: []bool{}, calls: []int{}, cur_w: 1, weight: []int{}, max_w: []int{}}
    uses := temp_use_counts(f)
    depth := mir.block_loop_depth(f)
    order := ra_block_order(f, &depth)
    for _ in 0:nv {
        s.weight.push(0)
        s.max_w.push(0)
        s.start.push(1 << 60)
        s.end.push(-1)
        s.home.push(-1)
        s.first_def.push(false)
        s.is_global.push(false)
    }
    // Parameters arrive at entry.
    for i in 0:f.nparams {
        if i < nl && cand[i] {
            ra_touch($&s, nt + i, 0, 0, true)
        }
    }
    $bstart := []int{}
    $bend := []int{}
    for _ in 0:f.blocks.len {
        bstart.push(-1)
        bend.push(-1)
    }
    $pos := 0
    for oi in 0:order.len {
        bi := order[oi]
        bstart[bi] = pos
        $dd := depth[bi]
        if dd > 5 { dd = 5 }
        s.cur_w = 1 << (3 * dd)
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            ra_scan_instr(f, $&s, ii, &ins, pos, bi, &cand, &uses, inline_bits)
            pos += 2
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        ra_term_use($&s, &blk, pos, bi)
        bend[bi] = pos
        pos += 2
    }
    // Values used before their first definition in a block are live into it.
    for v in 0:nv {
        if s.home[v] >= 0 && !s.first_def[v] {
            s.is_global[v] = true
        }
    }
    $t_addr_loc := []int{}
    $t_const_ci := []int{}
    $force_remat := []bool{}
    ra_find_remat(f, &order, &uses, $&s, $&t_addr_loc, $&t_const_ci, $&force_remat)
    $gidx := []int{}
    $glist := []int{}
    for v in 0:nv {
        if s.is_global[v] {
            gidx.push(glist.len)
            glist.push(v)
        } else {
            gidx.push(-1)
        }
    }
    $crosses := []bool{}
    $cross_cost := []int{}
    for _ in 0:nv {
        crosses.push(false)
        cross_cost.push(0)
    }
    blk_call_w := ra_compute_call_weights(f, &order, &depth, inline_bits)
    $call_ii := []int{}
    $call_live_off := []int{}
    $call_live_len := []int{}
    $call_live_v := []int{}
    $live_in := []int{}
    $live_out := []int{}
    $live_w := 0
    if glist.len > 0 {
        live_w = ra_global_live(f, $&s, &gidx, &glist, &bstart, &bend, &cand, &order, &blk_call_w, $&crosses, $&cross_cost, $&call_ii, $&call_live_off, $&call_live_len, $&call_live_v, $&live_in, $&live_out, inline_bits)
    } else if s.calls.len > 0 {
        $empty_g := []int{}
        $empty_lo := []int{}
        ra_mark_block_call_crosses(f, &s, &empty_g, &empty_lo, 0, &cand, &order, &blk_call_w, $&crosses, $&cross_cost, $&call_ii, $&call_live_off, $&call_live_len, $&call_live_v, inline_bits)
    }
    $fp_mask := []bool{}
    if fp_callee.len > 0 || fp_caller.len > 0 {
        fp_mask = ra_fp_mask(f, &cand)
    }
    alias := ra_coalesce(f, $&s, &cand, &fp_mask, &order, &uses, &crosses, &gidx, &live_in, &live_out, live_w, &force_remat)
    for t in 0:nt {
        if alias[t] >= 0 {
            av := nt + alias[t]
            if crosses[t] {
                crosses[av] = true
            }
            cross_cost[av] = cross_cost[av] + cross_cost[t]
        }
    }
    $segs := ra_build_segments(f, $&s, &cand, &order, &bstart, &bend, &gidx, &glist, &live_in, &live_out, live_w, &alias, &force_remat)
    $hint := []int{}
    $empty_hint := []int{}
    if arg_regs.len > 0 || ret_reg >= 0 {
        for _ in 0:nv {
            hint.push(-1)
        }
        for i in 0:f.nparams {
            if i < arg_regs.len && i < nl && cand[i] && (fp_mask.len == 0 || !fp_mask[nt + i]) {
                hint[nt + i] = arg_regs[i]
            }
        }
        for oi in 0:order.len {
            bi := order[oi]
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == mir.MI_CALL_IND || (ins.kind == mir.MI_CALL && !(inline_bits && bits_hw_entry(&ins.sval, true))) {
                    if ret_reg >= 0 && ins.a >= 0 && ins.a < nt && hint[ins.a] < 0 {
                        hint[ins.a] = ret_reg
                    }
                    $a := ins.c
                    $ai := 0
                    while a >= 0 {
                        if ai < arg_regs.len {
                            av := f.margs[a].v
                            if av >= 0 && av < nt && hint[av] < 0 {
                                hint[av] = arg_regs[ai]
                            }
                        }
                        ai += 1
                        a = f.margs[a].next
                    }
                }
                ii = ins.next
            }
            if ret_reg >= 0 && f.blocks[bi].tkind == mir.TKIND_RETURN {
                rv := f.blocks[bi].ta
                if rv >= 0 && rv < nt && hint[rv] < 0 {
                    hint[rv] = ret_reg
                }
            }
        }
        for t in 0:nt {
            if alias[t] >= 0 && hint[t] >= 0 && hint[nt + alias[t]] < 0 {
                hint[nt + alias[t]] = hint[t]
            }
        }
    }
    $info := ra_none(f)
    ra_scan_class(f, &s, &segs, &cand, &fp_mask, false, callee, caller, &crosses, &cross_cost, &hint, $&info)
    if fp_mask.len > 0 {
        ra_scan_class(f, &s, &segs, &cand, &fp_mask, true, fp_callee, fp_caller, &crosses, &cross_cost, &empty_hint, $&info)
    }
    for t in 0:nt {
        if alias[t] >= 0 {
            info.temp_reg[t] = info.local_reg[alias[t]]
        }
    }
    for t in 0:nt {
        $ra_l := -1
        $rc_i := -1
        if force_remat[t] {
            ra_l = t_addr_loc[t]
        } else if t_addr_loc[t] >= 0 && info.temp_reg[t] < 0 && alias[t] < 0 {
            ra_l = t_addr_loc[t]
        } else if t_const_ci[t] >= 0 && info.temp_reg[t] < 0 && alias[t] < 0 {
            rc_i = t_const_ci[t]
        }
        info.remat_addr.push(ra_l)
        info.remat_const.push(rc_i)
    }
    ra_populate_call_saves(f, &uses, caller, fp_caller, &crosses, &call_ii, &call_live_off, &call_live_len, &call_live_v, $&info)
    << info
}

fn ra_instr_reads_temp(f &mir.MFn, ins &mir.MInstr, t int) bool {
    k := ins.kind
    if k == mir.MI_COPY || k == mir.MI_STORE_LOCAL || k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD {
        << ins.b == t
    }
    if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
        << ins.a == t || ins.b == t
    }
    if k == mir.MI_UN {
        << ins.c == t
    }
    if k == mir.MI_BIN {
        << ins.c == t || ins.d == t
    }
    if k == mir.MI_SELECT {
        << ins.b == t || ins.c == t || ins.d == t
    }
    if k == mir.MI_VLOAD128 { << ins.b == t }
    if k == mir.MI_VSTORE128 { << ins.a == t || ins.b == t }
    if k == mir.MI_VBIN128 { << ins.c == t || ins.d == t }
    if k == mir.MI_VPACK128 { << ins.b == t || (ins.d != 0 && ins.c == t) }
    if k == mir.MI_VEXTRACT { << ins.b == t }
    if k == mir.MI_CALL || k == mir.MI_CALL_IND {
        if k == mir.MI_CALL_IND && ins.b == t {
            << true
        }
        $a := ins.c
        while a >= 0 {
            if f.margs[a].v == t {
                << true
            }
            a = f.margs[a].next
        }
    }
    << false
}

fn ra_block_reads_after(f &mir.MFn, blk_i int, after_ii int, t int) bool {
    $ci := f.instrs[after_ii].next
    while ci >= 0 {
        if ra_instr_reads_temp(f, &f.instrs[ci], t) {
            << true
        }
        ci = f.instrs[ci].next
    }
    tk := f.blocks[blk_i].tkind
    if (tk == mir.TKIND_BRANCH || tk == mir.TKIND_RETURN) && f.blocks[blk_i].ta == t {
        << true
    }
    << false
}

// Temps that can share their local's register: t = load l, when l is not
// stored while t is live, and t computed in the same block before store l,
// t as long as l is untouched in between and no existing alias overlaps.
fn ra_coalesce(f &mir.MFn, s $&RaScan, cand &[]bool, fp_mask &[]bool, order &[]int, uses &[]int, crosses &[]bool, gidx &[]int, live_in &[]int, live_out &[]int, live_w int, force_remat &[]bool) []int {
    nt := s.nt
    nl := f.locals.len
    $alias := []int{}
    $next_alias := []int{}
    $ndef := []int{}
    for _ in 0:nt {
        alias.push(-1)
        next_alias.push(-1)
        ndef.push(0)
    }
    $head_alias := []int{}
    for _ in 0:nl {
        head_alias.push(-1)
    }
    for i in 0:f.instrs.len {
        ins := ~f.instrs[i]
        k := ins.kind
        if k != mir.MI_NOP && k != mir.MI_STORE_LOCAL && k != mir.MI_STORE_PTR && k != mir.MI_VOLATILE_STORE && k != mir.MI_VSTORE128 && ins.a >= 0 && ins.a < nt {
            ndef[ins.a] = ndef[ins.a] + 1
        }
    }
    $st_loc := []int{}
    $st_pos := []int{}
    $st_blk := []int{}
    $st_ii := []int{}
    $scan_pos := 0
    for oi in 0:order.len {
        bi := order[oi]
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.kind == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && ins.a < cand.len && cand[ins.a] {
                st_loc.push(ins.a)
                st_pos.push(scan_pos)
                st_blk.push(bi)
                st_ii.push(ii)
            }
            scan_pos += 2
            ii = ins.next
        }
        scan_pos += 2
    }
    $pos := 0
    $ids := []int{}
    $poss := []int{}
    // Pass 1: coalesce t = load l when l is not stored while t is live.
    for oi in 0:order.len {
        bi := order[oi]
        $n_blk := 0
        $ii := f.blocks[bi].head
        while ii >= 0 {
            if n_blk < ids.len {
                ids[n_blk] = ii
                poss[n_blk] = pos
            } else {
                ids.push(ii)
                poss.push(pos)
            }
            n_blk += 1
            pos += 2
            ii = f.instrs[ii].next
        }
        pos += 2
        for x in 0:n_blk {
            ins := ~f.instrs[ids[x]]
            if ins.kind == mir.MI_LOAD_LOCAL && ins.c <= 0 && ins.b >= 0 && cand[ins.b] {
                t := ins.a
                if t >= 0 && t < nt && ndef[t] == 1 && alias[t] < 0 && s.end[t] >= 0 &&
                   (fp_mask.len == 0 || fp_mask[t] == fp_mask[nt + ins.b]) {
                    $ok := true
                    if !s.is_global[t] {
                        for y in x + 1:n_blk {
                            if poss[y] >= s.end[t] {
                                <-
                            }
                            o := ~f.instrs[ids[y]]
                            if o.kind == mir.MI_STORE_LOCAL && o.a == ins.b {
                                ok = false
                            }
                        }
                    } else {
                        st_t := s.start[t]
                        en_t := s.end[t]
                        $gt := -1
                        if t < gidx.len { gt = gidx[t] }
                        def_pos := poss[x]
                        for si in 0:st_loc.len {
                            if st_loc[si] == ins.b {
                                sb := st_blk[si]
                                sp := st_pos[si]
                                sii := st_ii[si]
                                if gt < 0 || live_w <= 0 {
                                    if sp >= st_t && sp < en_t {
                                        ok = false
                                        <-
                                    }
                                } else if sb != bi {
                                    if ra_bit(live_in, sb * live_w, gt) && (ra_bit(live_out, sb * live_w, gt) || ra_block_reads_after(f, sb, sii, t)) {
                                        ok = false
                                        <-
                                    }
                                } else {
                                    if sp > def_pos {
                                        if ra_bit(live_out, bi * live_w, gt) || ra_block_reads_after(f, bi, sii, t) {
                                            ok = false
                                            <-
                                        }
                                    } else if sp < def_pos {
                                        if ra_bit(live_in, bi * live_w, gt) {
                                            ok = false
                                            <-
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if ok {
                        alias[t] = ins.b
                        next_alias[t] = head_alias[ins.b]
                        head_alias[ins.b] = t
                    }
                }
            }
        }
    }
    // Pass 2: coalesce store l, t back to t's block-local definition d_x.
    pos = 0
    for oi in 0:order.len {
        bi := order[oi]
        $n_blk := 0
        $ii := f.blocks[bi].head
        while ii >= 0 {
            if n_blk < ids.len {
                ids[n_blk] = ii
                poss[n_blk] = pos
            } else {
                ids.push(ii)
                poss.push(pos)
            }
            n_blk += 1
            pos += 2
            ii = f.instrs[ii].next
        }
        pos += 2
        for x in 0:n_blk {
            ins := ~f.instrs[ids[x]]
            if ins.kind == mir.MI_STORE_LOCAL && ins.c <= 0 && ins.a >= 0 && cand[ins.a] && x > 0 {
                l := ins.a
                t := ins.b
                if t >= 0 && t < nt && ndef[t] == 1 && uses[t] >= 1 && !s.is_global[t] && alias[t] < 0 && s.end[t] >= 0 &&
                   (fp_mask.len == 0 || fp_mask[t] == fp_mask[nt + l]) {
                    $d_x := -1
                    $yi := x - 1
                    while yi >= 0 {
                        pii := ids[yi]
                        p := &f.instrs[pii]
                        pk := p.kind
                        if pk != mir.MI_NOP && pk != mir.MI_STORE_LOCAL && pk != mir.MI_STORE_PTR && pk != mir.MI_VOLATILE_STORE && pk != mir.MI_VSTORE128 && p.a == t {
                            d_x = yi
                            <-
                        }
                        yi -= 1
                    }
                    if d_x >= 0 && (d_x == x - 1 || !crosses[t] || crosses[nt + l]) {
                        $ok := true
                        for y in d_x + 1:x {
                            oii := ids[y]
                            o := &f.instrs[oii]
                            if (o.kind == mir.MI_LOAD_LOCAL && o.b == l) || (o.kind == mir.MI_STORE_LOCAL && o.a == l) {
                                ok = false
                                <-
                            }
                        }
                        if ok {
                            $u := head_alias[l]
                            while u >= 0 {
                                if s.end[u] >= 0 && s.start[u] <= poss[x] && s.end[u] > poss[d_x] {
                                    if s.is_global[u] && u < gidx.len && gidx[u] >= 0 && live_w > 0 {
                                        gu := gidx[u]
                                        if ra_bit(live_out, bi * live_w, gu) || ra_block_reads_after(f, bi, ids[d_x], u) {
                                            ok = false
                                            <-
                                        }
                                    } else {
                                        ok = false
                                        <-
                                    }
                                }
                                u = next_alias[u]
                            }
                        }
                        if ok && uses[t] > 1 {
                            for y in x + 1:n_blk {
                                if poss[y] >= s.end[t] {
                                    <-
                                }
                                o := ~f.instrs[ids[y]]
                                if o.kind == mir.MI_STORE_LOCAL && o.a == l {
                                    ok = false
                                    <-
                                }
                            }
                        }
                        if ok {
                            alias[t] = l
                            next_alias[t] = head_alias[l]
                            head_alias[l] = t
                        }
                    }
                }
            }
        }
    }
    for t in 0:nt {
        if alias[t] >= 0 && s.end[t] >= 0 {
            v := nt + alias[t]
            s.weight[v] = s.weight[v] + s.weight[t]
            if s.max_w[t] > s.max_w[v] {
                s.max_w[v] = s.max_w[t]
            }
            if s.start[t] < s.start[v] {
                s.start[v] = s.start[t]
            }
            if s.end[t] > s.end[v] {
                s.end[v] = s.end[t]
            }
            s.end[t] = -1
        }
    }
    << alias
}

fn ra_mark_live_v(v int, nv int, tag int, stamp $&[]int, live_list $&[]int) {
    if v >= 0 && v < nv && stamp[v] != tag {
        stamp[v] = tag
        live_list.push(v)
    }
}

fn ra_mark_block_call_crosses(f &mir.MFn, s &RaScan, glist &[]int, live_out &[]int, w int, cand &[]bool, order &[]int, blk_call_w &[]int, crosses $&[]bool, cross_cost $&[]int, call_ii $&[]int, call_live_off $&[]int, call_live_len $&[]int, call_live_v $&[]int, inline_bits bool) {
    nv := crosses.len
    nt := s.nt
    nl := f.locals.len
    $stamp := []int{}
    for _ in 0:nv {
        stamp.push(0)
    }
    $tag := 0
    for oi in 0:order.len {
        bi := order[oi]
        $has_call := false
        $b_ins := []int{}
        $ii := f.blocks[bi].head
        while ii >= 0 {
            b_ins.push(ii)
            ins := &f.instrs[ii]
            if ra_is_clobber_call(ins, inline_bits) {
                has_call = true
            }
            ii = ins.next
        }
        if !has_call { -> }
        tag += 1
        cw2 := 2 * blk_call_w[bi]
        $live_list := []int{}
        if w > 0 {
            base := bi * w
            for g in 0:glist.len {
                if ra_bit(live_out, base, g) {
                    ra_mark_live_v(glist[g], nv, tag, $&stamp, $&live_list)
                }
            }
        }
        blk := &f.blocks[bi]
        if blk.tkind == mir.TKIND_RETURN || blk.tkind == mir.TKIND_BRANCH {
            ra_mark_live_v(blk.ta, nv, tag, $&stamp, $&live_list)
        }
        $idx := b_ins.len - 1
        while idx >= 0 {
            ci := b_ins[idx]
            ins := &f.instrs[ci]
            k := ins.kind
            $def_v := -1
            if k == mir.MI_STORE_LOCAL {
                if ins.a >= 0 && ins.a < nl && cand[ins.a] {
                    def_v = nt + ins.a
                }
            } else if k != mir.MI_NOP && k != mir.MI_STORE_PTR && k != mir.MI_VOLATILE_STORE && k != mir.MI_VSTORE128 {
                if ins.a >= 0 && ins.a < nt {
                    def_v = ins.a
                }
            }
            is_call := ra_is_clobber_call(ins, inline_bits)
            if def_v >= 0 && def_v < nv {
                stamp[def_v] = 0
            }
            if is_call {
                coff := call_live_v.len
                $next_list := []int{}
                for li in 0:live_list.len {
                    lv := live_list[li]
                    if stamp[lv] == tag {
                        crosses[lv] = true
                        cross_cost[lv] = cross_cost[lv] + cw2
                        call_live_v.push(lv)
                        next_list.push(lv)
                    }
                }
                live_list = ~next_list
                call_ii.push(ci)
                call_live_off.push(coff)
                call_live_len.push(call_live_v.len - coff)
            }
            if k == mir.MI_LOAD_LOCAL {
                if ins.b >= 0 && ins.b < nl && cand[ins.b] {
                    ra_mark_live_v(nt + ins.b, nv, tag, $&stamp, $&live_list)
                }
            } else if k == mir.MI_COPY || k == mir.MI_STORE_LOCAL || k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD {
                ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                ra_mark_live_v(ins.a, nv, tag, $&stamp, $&live_list)
                ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_UN {
                ra_mark_live_v(ins.c, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_BIN {
                ra_mark_live_v(ins.c, nv, tag, $&stamp, $&live_list)
                ra_mark_live_v(ins.d, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_SELECT {
                ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
                ra_mark_live_v(ins.c, nv, tag, $&stamp, $&live_list)
                ra_mark_live_v(ins.d, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_VLOAD128 {
                ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_VSTORE128 {
                ra_mark_live_v(ins.a, nv, tag, $&stamp, $&live_list)
                ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_VBIN128 {
                ra_mark_live_v(ins.c, nv, tag, $&stamp, $&live_list)
                ra_mark_live_v(ins.d, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_VPACK128 {
                ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
                if ins.d != 0 {
                    ra_mark_live_v(ins.c, nv, tag, $&stamp, $&live_list)
                }
            } else if k == mir.MI_VEXTRACT {
                ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
            } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
                if k == mir.MI_CALL_IND {
                    ra_mark_live_v(ins.b, nv, tag, $&stamp, $&live_list)
                }
                $a := ins.c
                while a >= 0 {
                    ra_mark_live_v(f.margs[a].v, nv, tag, $&stamp, $&live_list)
                    a = f.margs[a].next
                }
            }
            idx -= 1
        }
    }
}

// Block-level liveness of the values used outside one block; their
// intervals grow to cover every block they are live into or out of.
fn ra_global_live(f &mir.MFn, s $&RaScan, gidx &[]int, glist &[]int, bstart &[]int, bend &[]int, cand &[]bool, order &[]int, blk_call_w &[]int, crosses $&[]bool, cross_cost $&[]int, call_ii $&[]int, call_live_off $&[]int, call_live_len $&[]int, call_live_v $&[]int, live_in_out $&[]int, live_out_out $&[]int, inline_bits bool) int {
    nb := f.blocks.len
    w := (glist.len + 63) / 64
    $use_b := []int{}
    $def_b := []int{}
    for _ in 0:nb * w {
        use_b.push(0)
        def_b.push(0)
        live_in_out.push(0)
        live_out_out.push(0)
    }
    $blk_noreturn := []bool{}
    for _ in 0:nb {
        blk_noreturn.push(false)
    }
    for oi in 0:order.len {
        bi := order[oi]
        base := bi * w
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            if ins.kind == mir.MI_CALL && is_noreturn_call(&ins.sval) {
                blk_noreturn[bi] = true
            }
            ra_gen(f, s, gidx, &ins, $&use_b, $&def_b, base, cand)
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        if !blk_noreturn[bi] && (blk.tkind == mir.TKIND_RETURN || blk.tkind == mir.TKIND_BRANCH) {
            u := blk.ta
            if u >= 0 && u < gidx.len && gidx[u] >= 0 && !ra_bit(&def_b, base, gidx[u]) {
                ra_bit_set($&use_b, base, gidx[u])
            }
        }
    }
    $changed := true
    while changed {
        changed = false
        $oi := order.len - 1
        while oi >= 0 {
            bi := order[oi]
            blk := ~f.blocks[bi]
            base := bi * w
            nr := blk_noreturn[bi]
            for j in 0:w {
                $out := 0
                if !nr && blk.tkind == mir.TKIND_JUMP {
                    if blk.ta >= 0 && blk.ta < nb && bstart[blk.ta] >= 0 {
                        out = live_in_out[blk.ta * w + j]
                    }
                } else if !nr && blk.tkind == mir.TKIND_BRANCH {
                    if blk.tb >= 0 && blk.tb < nb && bstart[blk.tb] >= 0 {
                        out = out | live_in_out[blk.tb * w + j]
                    }
                    if blk.tc >= 0 && blk.tc < nb && bstart[blk.tc] >= 0 {
                        out = out | live_in_out[blk.tc * w + j]
                    }
                }
                inv := use_b[base + j] | (out & (-1 ^ def_b[base + j]))
                if out != live_out_out[base + j] || inv != live_in_out[base + j] {
                    live_out_out[base + j] = out
                    live_in_out[base + j] = inv
                    changed = true
                }
            }
            oi -= 1
        }
    }
    for oi in 0:order.len {
        bi := order[oi]
        base := bi * w
        for g in 0:glist.len {
            v := glist[g]
            if ra_bit(live_in_out, base, g) && bstart[bi] < s.start[v] {
                s.start[v] = bstart[bi]
            }
            if ra_bit(live_out_out, base, g) && bend[bi] + 1 > s.end[v] {
                s.end[v] = bend[bi] + 1
            }
        }
    }
    if s.calls.len > 0 {
        ra_mark_block_call_crosses(f, s, glist, live_out_out, w, cand, order, blk_call_w, crosses, cross_cost, call_ii, call_live_off, call_live_len, call_live_v, inline_bits)
    }
    << w
}

fn ra_cand_ok(s &RaScan, v int, nt int, cand &[]bool, fp_mask &[]bool, want_fp bool) bool {
    if s.end[v] < 0 || (v >= nt && !cand[v - nt]) {
        << false
    }
    if fp_mask.len == 0 {
        << !want_fp
    }
    << fp_mask[v] == want_fp
}

struct RaSegs {
    ss [][]int
    ee [][]int
}

fn ra_append_seg(segs $&RaSegs, v int, a int, b int) {
    n := segs.ss[v].len
    if n > 0 && a <= segs.ee[v][n - 1] + 1 {
        if b > segs.ee[v][n - 1] {
            segs.ee[v][n - 1] = b
        }
        <<
    }
    segs.ss[v].push(a)
    segs.ee[v].push(b)
}

fn ra_touch_seg_v(v int, pos int, mark_id int, mark $&[]int, min_p $&[]int, max_p $&[]int, touched $&[]int) {
    if mark[v] != mark_id {
        mark[v] = mark_id
        min_p[v] = pos
        max_p[v] = pos
        touched.push(v)
    } else {
        if pos < min_p[v] { min_p[v] = pos }
        if pos > max_p[v] { max_p[v] = pos }
    }
}

fn ra_merge_vreg_segs(segs $&RaSegs, dst int, src int) {
    ds := ~segs.ss[dst]
    de := ~segs.ee[dst]
    ss := &segs.ss[src]
    se := &segs.ee[src]
    $ms := []int{}
    $me := []int{}
    $i := 0
    $j := 0
    while i < ds.len || j < ss.len {
        $ns := 0
        $ne := 0
        if j >= ss.len || (i < ds.len && ds[i] <= ss[j]) {
            ns = ds[i]
            ne = de[i]
            i += 1
        } else {
            ns = ss[j]
            ne = se[j]
            j += 1
        }
        m := ms.len
        if m > 0 && ns <= me[m - 1] + 1 {
            if ne > me[m - 1] {
                me[m - 1] = ne
            }
        } else {
            ms.push(ns)
            me.push(ne)
        }
    }
    segs.ss[dst] = ~ms
    segs.ee[dst] = ~me
    segs.ss[src] = []int{}
    segs.ee[src] = []int{}
}

fn ra_build_segments(f &mir.MFn, s $&RaScan, cand &[]bool, order &[]int, bstart &[]int, bend &[]int, gidx &[]int, glist &[]int, live_in &[]int, live_out &[]int, live_w int, alias &[]int, force_remat &[]bool) RaSegs {
    nt := s.nt
    nl := f.locals.len
    nv := nt + nl
    $segs := RaSegs{ss: [][]int{}, ee: [][]int{}}
    $mark := []int{}
    $min_p := []int{}
    $max_p := []int{}
    for _ in 0:nv {
        segs.ss.push([]int{})
        segs.ee.push([]int{})
        mark.push(0)
        min_p.push(0)
        max_p.push(0)
    }
    for oi in 0:order.len {
        bi := order[oi]
        mark_id := oi + 1
        $touched := []int{}
        if bi == 0 {
            for pi in 0:f.nparams {
                if pi < nl && cand[pi] {
                    pv := nt + pi
                    ra_touch_seg_v(pv, 0, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            }
        }
        $pos := bstart[bi]
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == mir.MI_LOAD_LOCAL {
                if ins.b >= 0 && ins.b < nl && cand[ins.b] {
                    ra_touch_seg_v(nt + ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_STORE_LOCAL {
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nl && cand[ins.a] {
                    ra_touch_seg_v(nt + ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_ADDR || k == mir.MI_STR_CONST || k == mir.MI_LOAD_FN_ADDR {
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD || k == mir.MI_COPY {
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_BIN {
                if ins.c >= 0 && ins.c < nt && !force_remat[ins.c] {
                    ra_touch_seg_v(ins.c, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.d >= 0 && ins.d < nt && !force_remat[ins.d] {
                    ra_touch_seg_v(ins.d, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_UN {
                if ins.c >= 0 && ins.c < nt && !force_remat[ins.c] {
                    ra_touch_seg_v(ins.c, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_SELECT {
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.c >= 0 && ins.c < nt && !force_remat[ins.c] {
                    ra_touch_seg_v(ins.c, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.d >= 0 && ins.d < nt && !force_remat[ins.d] {
                    ra_touch_seg_v(ins.d, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_VLOAD128 {
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_VSTORE128 {
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_VBIN128 {
                if ins.c >= 0 && ins.c < nt && !force_remat[ins.c] {
                    ra_touch_seg_v(ins.c, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.d >= 0 && ins.d < nt && !force_remat[ins.d] {
                    ra_touch_seg_v(ins.d, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_VPACK128 {
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.d != 0 && ins.c >= 0 && ins.c < nt && !force_remat[ins.c] {
                    ra_touch_seg_v(ins.c, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_VEXTRACT {
                if ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
                if k == mir.MI_CALL_IND && ins.b >= 0 && ins.b < nt && !force_remat[ins.b] {
                    ra_touch_seg_v(ins.b, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
                $a := ins.c
                while a >= 0 {
                    av := f.margs[a].v
                    if av >= 0 && av < nt && !force_remat[av] {
                        ra_touch_seg_v(av, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                    }
                    a = f.margs[a].next
                }
                if ins.a >= 0 && ins.a < nt && !force_remat[ins.a] {
                    ra_touch_seg_v(ins.a, pos + 1, mark_id, $&mark, $&min_p, $&max_p, $&touched)
                }
            }
            pos += 2
            ii = ins.next
        }
        blk := &f.blocks[bi]
        if blk.tkind == mir.TKIND_RETURN || blk.tkind == mir.TKIND_BRANCH {
            ta := blk.ta
            if ta >= 0 && ta < nt && !force_remat[ta] {
                ra_touch_seg_v(ta, pos, mark_id, $&mark, $&min_p, $&max_p, $&touched)
            }
        }
        if live_w > 0 {
            base := bi * live_w
            for g in 0:glist.len {
                v := glist[g]
                in_b := ra_bit(live_in, base, g)
                out_b := ra_bit(live_out, base, g)
                is_t := mark[v] == mark_id
                if in_b || out_b || is_t {
                    $ss_v := bstart[bi]
                    $ee_v := bend[bi] + 1
                    if !in_b {
                        if is_t { ss_v = min_p[v] } else { ss_v = ee_v }
                    }
                    if !out_b {
                        if is_t { ee_v = max_p[v] } else { ee_v = bstart[bi] }
                    }
                    if is_t {
                        if min_p[v] < ss_v { ss_v = min_p[v] }
                        if max_p[v] > ee_v { ee_v = max_p[v] }
                    }
                    ra_append_seg($&segs, v, ss_v, ee_v)
                }
            }
        }
        for ti in 0:touched.len {
            v := touched[ti]
            if !s.is_global[v] {
                ra_append_seg($&segs, v, min_p[v], max_p[v])
            }
        }
    }
    for t in 0:nt {
        if alias[t] >= 0 {
            if segs.ss[t].len > 0 {
                ra_merge_vreg_segs($&segs, nt + alias[t], t)
            } else {
                segs.ss[t] = []int{}
                segs.ee[t] = []int{}
            }
        }
    }
    for v in 0:nv {
        n := segs.ss[v].len
        if n == 0 || (v >= nt && !cand[v - nt]) || (v < nt && force_remat[v]) {
            s.end[v] = -1
        } else if s.end[v] >= 0 {
            s.start[v] = segs.ss[v][0]
            s.end[v] = segs.ee[v][n - 1]
        }
    }
    << segs
}

fn ra_segs_overlap(segs &RaSegs, u int, v int) bool {
    us := &segs.ss[u]
    ue := &segs.ee[u]
    vs := &segs.ss[v]
    ve := &segs.ee[v]
    if us.len == 0 || vs.len == 0 {
        << false
    }
    if ue[ue.len - 1] < vs[0] || ve[ve.len - 1] < us[0] {
        << false
    }
    $i := 0
    $j := 0
    while i < us.len && j < vs.len {
        if us[i] <= ve[j] && vs[j] <= ue[i] {
            << true
        }
        if ue[i] < ve[j] {
            i += 1
        } else {
            j += 1
        }
    }
    << false
}

fn ra_slot_free(occ &[]int, segs &RaSegs, v int) bool {
    for i in 0:occ.len {
        if ra_segs_overlap(segs, occ[i], v) {
            << false
        }
    }
    << true
}

fn ra_eval_slot_evict(cur &[]int, segs &RaSegs, s &RaScan, v int, extra int, st int, len_v int, is_caller bool, si int, best_is_caller $&bool, best_idx $&int, best_cost $&int, best_end $&int, sparse_mode bool, best_w $&int, best_rem $&int) {
    if !sparse_mode {
        $tot_w := 0
        $max_e := -1
        $n_conf := 0
        for ai in 0:cur.len {
            a := cur[ai]
            if ra_segs_overlap(segs, a, v) {
                n_conf += 1
                tot_w += s.weight[a]
                if s.end[a] > max_e { max_e = s.end[a] }
            }
        }
        if n_conf == 0 { << }
        cost := tot_w + extra
        if cost < s.weight[v] || (extra == 0 && cost == s.weight[v] && max_e > s.end[v]) {
            if *best_idx < 0 || cost < *best_cost || (cost == *best_cost && max_e > *best_end) {
                *best_is_caller = is_caller
                *best_idx = si
                *best_cost = cost
                *best_end = max_e
            }
        }
        <<
    }
    if extra != 0 { << }
    $n_conf := 0
    $conf_a := -1
    for ai in 0:cur.len {
        a := cur[ai]
        if ra_segs_overlap(segs, a, v) {
            n_conf += 1
            conf_a = a
        }
    }
    if n_conf != 1 { << }
    a := conf_a
    rem_a := s.end[a] - st
    if s.max_w[a] <= s.max_w[v] && rem_a >= 32 && rem_a > len_v {
        $evict_k := 24
        if s.max_w[a] < s.max_w[v] { evict_k = 12 }
        if evict_k * s.weight[a] * len_v < s.weight[v] * rem_a {
            if *best_idx < 0 || s.weight[a] * *best_rem < *best_w * rem_a ||
               (s.weight[a] * *best_rem == *best_w * rem_a && rem_a > *best_rem) {
                *best_is_caller = is_caller
                *best_idx = si
                *best_w = s.weight[a]
                *best_rem = rem_a
            }
        }
    }
}

fn ra_scan_class(f &mir.MFn, s &RaScan, segs &RaSegs, cand &[]bool, fp_mask &[]bool, want_fp bool, callee &[]int, caller &[]int, cross_call &[]bool, cross_cost &[]int, hint &[]int, info $&RaInfo) {
    nt := s.nt
    nv := s.start.len
    // Order values by interval start (counting sort over positions).
    $maxp := 0
    for v in 0:nv {
        if ra_cand_ok(s, v, nt, cand, fp_mask, want_fp) && s.start[v] > maxp {
            maxp = s.start[v]
        }
    }
    $count := []int{}
    for _ in 0:maxp + 2 {
        count.push(0)
    }
    for v in 0:nv {
        if ra_cand_ok(s, v, nt, cand, fp_mask, want_fp) {
            count[s.start[v] + 1] += 1
        }
    }
    for p in 1:count.len {
        count[p] += count[p - 1]
    }
    $order := []int{}
    for _ in 0:count[count.len - 1] {
        order.push(0)
    }
    for v in 0:nv {
        if ra_cand_ok(s, v, nt, cand, fp_mask, want_fp) {
            order[count[s.start[v]]] = v
            count[s.start[v]] += 1
        }
    }
    $reg := []int{}
    for _ in 0:nv {
        reg.push(-1)
    }
    $occ_callee := [][]int{}
    $callee_used := []bool{}
    for _ in 0:callee.len {
        occ_callee.push([]int{})
        callee_used.push(false)
    }
    $occ_caller := [][]int{}
    for _ in 0:caller.len {
        occ_caller.push([]int{})
    }
    for oi in 0:order.len {
        v := order[oi]
        st := s.start[v]
        // Expire occupants whose final segment ended strictly before st.
        for ci in 0:occ_callee.len {
            $k_occ := []int{}
            cur := &occ_callee[ci]
            for ai in 0:cur.len {
                a := cur[ai]
                if s.end[a] >= st {
                    k_occ.push(a)
                }
            }
            occ_callee[ci] = ~k_occ
        }
        for ci in 0:occ_caller.len {
            $k_occ := []int{}
            cur := &occ_caller[ci]
            for ai in 0:cur.len {
                a := cur[ai]
                if s.end[a] >= st {
                    k_occ.push(a)
                }
            }
            occ_caller[ci] = ~k_occ
        }
        crosses := v < cross_call.len && cross_call[v]
        $cc_v := 0
        if v < cross_cost.len { cc_v = cross_cost[v] }
        can_cold_caller := crosses && caller.len > 0 && cc_v > 0 && 2 * cc_v < s.weight[v]
        $r := -1
        if !crosses {
            if v < hint.len && hint[v] >= 0 {
                hi := ra_index(caller, hint[v])
                if hi >= 0 && ra_slot_free(&occ_caller[hi], segs, v) {
                    occ_caller[hi].push(v)
                    r = caller[hi]
                }
            }
            if r < 0 {
                for i in 0:caller.len {
                    if occ_caller[i].len == 0 {
                        occ_caller[i].push(v)
                        r = caller[i]
                        <-
                    }
                }
            }
            if r < 0 {
                for i in 0:caller.len {
                    if ra_slot_free(&occ_caller[i], segs, v) {
                        occ_caller[i].push(v)
                        r = caller[i]
                        <-
                    }
                }
            }
        }
        if r < 0 {
            for i in 0:callee.len {
                if callee_used[i] && ra_slot_free(&occ_callee[i], segs, v) {
                    occ_callee[i].push(v)
                    r = callee[i]
                    <-
                }
            }
        }
        if r < 0 {
            for i in 0:callee.len {
                if !callee_used[i] && ra_slot_free(&occ_callee[i], segs, v) {
                    callee_used[i] = true
                    occ_callee[i].push(v)
                    r = callee[i]
                    <-
                }
            }
        }
        if r < 0 && can_cold_caller {
            $i := caller.len - 1
            while i >= 0 {
                if occ_caller[i].len == 0 {
                    occ_caller[i].push(v)
                    r = caller[i]
                    <-
                }
                i -= 1
            }
            if r < 0 {
                $i2 := caller.len - 1
                while i2 >= 0 {
                    if ra_slot_free(&occ_caller[i2], segs, v) {
                        occ_caller[i2].push(v)
                        r = caller[i2]
                        <-
                    }
                    i2 -= 1
                }
            }
        }
        if r < 0 {
            // Evict the lowest-cost conflicting occupant set across eligible slots.
            $best_is_caller := false
            $best_idx := -1
            $best_cost := 0
            $best_end := -1
            $best_w := 0
            $best_rem := 1
            for si in 0:callee.len {
                ra_eval_slot_evict(&occ_callee[si], segs, s, v, 0, st, 1, false, si, $&best_is_caller, $&best_idx, $&best_cost, $&best_end, false, $&best_w, $&best_rem)
            }
            if (!crosses || can_cold_caller) && caller.len > 0 {
                $extra := 0
                if crosses { extra = cc_v }
                for si in 0:caller.len {
                    ra_eval_slot_evict(&occ_caller[si], segs, s, v, extra, st, 1, true, si, $&best_is_caller, $&best_idx, $&best_cost, $&best_end, false, $&best_w, $&best_rem)
                }
            }
            if best_idx < 0 {
                $len_v := s.end[v] - st
                if len_v < 1 { len_v = 1 }
                for si in 0:callee.len {
                    ra_eval_slot_evict(&occ_callee[si], segs, s, v, 0, st, len_v, false, si, $&best_is_caller, $&best_idx, $&best_cost, $&best_end, true, $&best_w, $&best_rem)
                }
                if (!crosses || can_cold_caller) && caller.len > 0 {
                    $extra := 0
                    if crosses { extra = cc_v }
                    for si in 0:caller.len {
                        ra_eval_slot_evict(&occ_caller[si], segs, s, v, extra, st, len_v, true, si, $&best_is_caller, $&best_idx, $&best_cost, $&best_end, true, $&best_w, $&best_rem)
                    }
                }
            }
            if best_idx >= 0 {
                $k_occ := []int{}
                if best_is_caller {
                    cur := &occ_caller[best_idx]
                    for ai in 0:cur.len {
                        a := cur[ai]
                        if ra_segs_overlap(segs, a, v) {
                            reg[a] = -1
                        } else {
                            k_occ.push(a)
                        }
                    }
                    k_occ.push(v)
                    occ_caller[best_idx] = ~k_occ
                    r = caller[best_idx]
                } else {
                    cur := &occ_callee[best_idx]
                    for ai in 0:cur.len {
                        a := cur[ai]
                        if ra_segs_overlap(segs, a, v) {
                            reg[a] = -1
                        } else {
                            k_occ.push(a)
                        }
                    }
                    k_occ.push(v)
                    occ_callee[best_idx] = ~k_occ
                    callee_used[best_idx] = true
                    r = callee[best_idx]
                }
            }
        }
        if r >= 0 {
            reg[v] = r
        }
    }
    for v in 0:nv {
        if reg[v] >= 0 {
            if v < nt {
                info.temp_reg[v] = reg[v]
            } else {
                info.local_reg[v - nt] = reg[v]
            }
        }
    }
    for i in 0:callee.len {
        if callee_used[i] {
            info.used_callee.push(callee[i])
        }
    }
}

fn ra_populate_call_saves(f &mir.MFn, uses &[]int, caller &[]int, fp_caller &[]int, crosses &[]bool, call_ii &[]int, call_live_off &[]int, call_live_len &[]int, call_live_v &[]int, info $&RaInfo) {
    if call_ii.len == 0 { << }
    nt := f.temps.len
    nl := f.locals.len
    $any_cold := false
    for t in 0:nt {
        if t < crosses.len && crosses[t] && info.temp_reg[t] >= 0 {
            r := info.temp_reg[t]
            if ra_index(caller, r) >= 0 || ra_index(fp_caller, r) >= 0 {
                any_cold = true
                <-
            }
        }
    }
    if !any_cold {
        for l in 0:nl {
            if nt + l < crosses.len && crosses[nt + l] && info.local_reg[l] >= 0 {
                r := info.local_reg[l]
                if ra_index(caller, r) >= 0 || ra_index(fp_caller, r) >= 0 {
                    any_cold = true
                    <-
                }
            }
        }
    }
    if !any_cold { << }
    for _ in 0:f.instrs.len {
        info.call_save_off.push(-1)
        info.call_save_len.push(0)
    }
    for ci_idx in 0:call_ii.len {
        ii := call_ii[ci_idx]
        ins := &f.instrs[ii]
        $def_r := -1
        if ins.a >= 0 && ins.a < nt && ins.a < uses.len && uses[ins.a] > 0 {
            def_r = info.temp_reg[ins.a]
        }
        $gprs := []int{}
        $fprs := []int{}
        off := call_live_off[ci_idx]
        cnt := call_live_len[ci_idx]
        for j in 0:cnt {
            lv := call_live_v[off + j]
            $r := -1
            if lv < nt {
                r = info.temp_reg[lv]
            } else if lv - nt < nl {
                r = info.local_reg[lv - nt]
            }
            if r >= 0 && r != def_r {
                if ra_index(caller, r) >= 0 {
                    $seen := false
                    for gi in 0:gprs.len {
                        if gprs[gi] == r {
                            seen = true
                            <-
                        }
                    }
                    if !seen { gprs.push(r) }
                } else if ra_index(fp_caller, r) >= 0 {
                    $seen := false
                    for fi in 0:fprs.len {
                        if fprs[fi] == r {
                            seen = true
                            <-
                        }
                    }
                    if !seen { fprs.push(r) }
                }
            }
        }
        total := gprs.len + fprs.len
        if total > 0 {
            start_off := info.call_save_regs.len
            for gi in 0:gprs.len {
                info.call_save_regs.push(gprs[gi])
            }
            for fi in 0:fprs.len {
                info.call_save_regs.push(fprs[fi])
            }
            info.call_save_off[ii] = start_off
            info.call_save_len[ii] = total
            if total > info.max_call_saves {
                info.max_call_saves = total
            }
        }
    }
}

fn ra_index(list &[]int, r int) int {
    for i in 0:list.len {
        if list[i] == r {
            << i
        }
    }
    << -1
}

fn ra_release(r int, callee &[]int, caller &[]int, free_callee $&[]bool, free_caller $&[]bool) {
    i := ra_index(callee, r)
    if i >= 0 {
        free_callee[i] = true
        <<
    }
    j := ra_index(caller, r)
    if j >= 0 {
        free_caller[j] = true
    }
}

fn ra_bump_use(uses $&[]int, v int) {
    if v >= 0 && v < uses.len {
        uses[v] = uses[v] + 1
    }
}

// Number of reads of each temp (instruction operands, call arguments and
// branch/return values).
pub fn temp_use_counts(f &mir.MFn) []int {
    $uses := []int{}
    for _ in 0:f.temps.len {
        uses.push(0)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == mir.MI_COPY || k == mir.MI_STORE_LOCAL || k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD || k == mir.MI_CALL_IND {
                ra_bump_use($&uses, ins.b)
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                ra_bump_use($&uses, ins.a)
                ra_bump_use($&uses, ins.b)
            } else if k == mir.MI_UN {
                ra_bump_use($&uses, ins.c)
            } else if k == mir.MI_BIN {
                ra_bump_use($&uses, ins.c)
                ra_bump_use($&uses, ins.d)
            } else if k == mir.MI_SELECT {
                ra_bump_use($&uses, ins.b)
                ra_bump_use($&uses, ins.c)
                ra_bump_use($&uses, ins.d)
            } else if k == mir.MI_VLOAD128 {
                ra_bump_use($&uses, ins.b)
            } else if k == mir.MI_VSTORE128 {
                ra_bump_use($&uses, ins.a)
                ra_bump_use($&uses, ins.b)
            } else if k == mir.MI_VBIN128 {
                ra_bump_use($&uses, ins.c)
                ra_bump_use($&uses, ins.d)
            } else if k == mir.MI_VPACK128 {
                ra_bump_use($&uses, ins.b)
                if ins.d != 0 {
                    ra_bump_use($&uses, ins.c)
                }
            } else if k == mir.MI_VEXTRACT {
                ra_bump_use($&uses, ins.b)
            }
            if k == mir.MI_CALL || k == mir.MI_CALL_IND || (k == mir.MI_ASM && ins.c >= 0) {
                $a := ins.c
                while a >= 0 {
                    ra_bump_use($&uses, f.margs[a].v)
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == mir.TKIND_BRANCH || tk == mir.TKIND_RETURN {
            ra_bump_use($&uses, f.blocks[bi].ta)
        }
    }
    << uses
}
