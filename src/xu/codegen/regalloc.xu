@xu/codegen
// Register allocator state and physical register mapping.
//
// Layer 4C module: decoupled register allocator managing physical register
// allocation, spilling, and caller/callee-saved register tracking.

#xu/target

pub struct RegBinding {
    pub vreg int
    pub preg int
    pub is_dirty bool
    pub is_pinned bool
}

pub struct RegAlloc {
    pub target target.Target
    pub num_pregs int
    pub bindings []RegBinding
    pub free_regs []int
}

pub fn regalloc_new(t &target.Target, num_pregs int) RegAlloc {
    $free_list := []int{}
    for i in 0:num_pregs {
        free_list.push(i)
    }
    << RegAlloc{
        target: ~t,
        num_pregs: num_pregs,
        bindings: []RegBinding{},
        free_regs: free_list
    }
}

pub fn (ra $&RegAlloc) alloc_reg(vreg int) int {
    if ra.free_regs.len > 0 {
        last_idx := ra.free_regs.len - 1
        preg := ra.free_regs[last_idx]
        $next_free := []int{}
        for i in 0:last_idx {
            next_free.push(ra.free_regs[i])
        }
        ra.free_regs = next_free
        ra.bindings.push(RegBinding{
            vreg: vreg,
            preg: preg,
            is_dirty: false,
            is_pinned: false
        })
        << preg
    }
    // Spill required when free list is empty (-1 signals caller to spill)
    << -1
}

pub fn (ra $&RegAlloc) free_reg(preg int) {
    $next_bindings := []RegBinding{}
    $found := false
    for i in 0:ra.bindings.len {
        if ra.bindings[i].preg == preg {
            found = true
        } else {
            next_bindings.push(~ra.bindings[i])
        }
    }
    ra.bindings = next_bindings
    if found {
        ra.free_regs.push(preg)
    }
}
