@xu/codegen

#xu/mc

const MACOS_MONOTONIC = -12
const CLOCK_MONOTONIC = 6
pub const MACOS_CLOCK_SLOT = "__xu_clock_gettime_ptr"

// Forward the private runtime operation to libSystem, keeping the timespec
// pointer in the second argument register. Tail calls preserve the C stack
// alignment and return directly to the Xu caller.
fn emit_macos_arm64_clock(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, emit_object bool) {
    e32(cb, 0xB100001F | ((0 - MACOS_MONOTONIC) << 10)) // cmn x0, #12
    a64_branch_reloc(cb, relocs, 0x54000001, "__xu_after_clock", mc.RELOC_ARM64_COND_BR19)
    a64_mov_imm(cb, 0, CLOCK_MONOTONIC)
    if emit_object {
        a64_branch_reloc(cb, relocs, 0x14000000, "_clock_gettime", mc.RELOC_ARM64_CALL26)
    } else {
        a64_fn_addr(cb, relocs, 17, MACOS_CLOCK_SLOT)
        a64_ldr(cb, 17, 17, 0)
        e32(cb, 0xD61F0220) // br x17
    }
    syms.define_label("__xu_after_clock", cb.len())
}

fn emit_macos_x64_clock(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, emit_object bool) {
    x64_cmp_imm8(cb, X_RDI, MACOS_MONOTONIC)
    next := x64_jshort(cb, CC_NE)
    x64_mov_imm(cb, X_RDI, CLOCK_MONOTONIC)
    if emit_object {
        x64_jmp(cb, relocs, "_clock_gettime")
    } else {
        xb(cb, 0xFF)
        xb(cb, 0x25) // jmp [rip + disp32]
        x64_rel32(cb, relocs, MACOS_CLOCK_SLOT)
    }
    x64_land(cb, next)
}
