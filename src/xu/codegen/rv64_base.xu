@xu/codegen
// Baseline RV64GC (RV64IMD) instruction selection for typed MIR, Linux.
//
// The same model as arm64_base.xu: every temp has its own frame slot,
// operands go through scratch registers t0-t2 and the result is stored
// back.
//   - arguments in a0-a7, the rest at [sp + 8*(i-8)] of the caller's
//     outgoing area; scalar result in a0
//   - s11 holds the runtime state block for the whole process
//   - frame: [s0] saved s0, [s0+8] ra, sp = s0 - frame; locals and temps
//     at [sp + out_area + offset] (the arm64 layout)
// Calls, jumps and addresses use auipc pairs, so code size has no
// practical limit.

#xu/mir
#xu/mc
#xu/target

const RV_ZERO = 0
const RV_RA = 1
const RV_SP = 2
const RV_T0 = 5
const RV_T1 = 6
const RV_T2 = 7
const RV_S0 = 8
const RV_S1 = 9
const RV_A0 = 10
const RV_A7 = 17
const RV_S11 = 27
const RV_T3 = 28
const RV_T4 = 29
const RV_STATE = 27

// ===== encoders =====

fn rv_r(cb $&mc.CodeBuffer, f7 int, rs2 int, rs1 int, f3 int, rd int, op int) {
    e32(cb, (f7 << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op)
}

fn rv_i(cb $&mc.CodeBuffer, imm int, rs1 int, f3 int, rd int, op int) {
    e32(cb, ((imm & 0xfff) << 20) | (rs1 << 15) | (f3 << 12) | (rd << 7) | op)
}

fn rv_s(cb $&mc.CodeBuffer, imm int, rs2 int, rs1 int, f3 int) {
    e32(cb, (((imm >> 5) & 0x7f) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | ((imm & 0x1f) << 7) | 0x23)
}

// Conditional branch by byte offset from this instruction.
fn rv_b(cb $&mc.CodeBuffer, f3 int, rs1 int, rs2 int, off int) {
    e32(cb, (((off >> 12) & 1) << 31) | (((off >> 5) & 0x3f) << 25) | (rs2 << 20) | (rs1 << 15) | (f3 << 12) | (((off >> 1) & 0xf) << 8) | (((off >> 11) & 1) << 7) | 0x63)
}

fn rv_addi(cb $&mc.CodeBuffer, rd int, rs1 int, imm int) {
    rv_i(cb, imm, rs1, 0, rd, 0x13)
}

fn rv_mv(cb $&mc.CodeBuffer, rd int, rs int) {
    rv_addi(cb, rd, rs, 0)
}

fn rv_add(cb $&mc.CodeBuffer, rd int, rs1 int, rs2 int) {
    rv_r(cb, 0, rs2, rs1, 0, rd, 0x33)
}

fn rv_ret(cb $&mc.CodeBuffer) {
    rv_i(cb, 0, RV_RA, 0, RV_ZERO, 0x67)
}

fn rv_trap(cb $&mc.CodeBuffer) {
    e32(cb, 0x00100073)
}

fn rv_ecall(cb $&mc.CodeBuffer) {
    e32(cb, 0x00000073)
}

fn rv_li(cb $&mc.CodeBuffer, rd int, v int) {
    if v >= -2048 && v < 2048 {
        rv_addi(cb, rd, RV_ZERO, v)
        <<
    }
    if v >= -2147483648 && v < 2147483648 {
        hi20 := (v + 0x800) >> 12
        lo12 := v - (hi20 << 12)
        e32(cb, ((hi20 & 0xfffff) << 12) | (rd << 7) | 0x37)
        // addiw sign-extends the 32-bit sum
        rv_i(cb, lo12, rd, 0, rd, 0x1B)
        <<
    }
    $lo := v & 0xfff
    if lo >= 2048 {
        lo -= 4096
    }
    rv_li(cb, rd, (v - lo) >> 12)
    rv_i(cb, 12, rd, 1, rd, 0x13)
    if lo != 0 {
        rv_addi(cb, rd, rd, lo)
    }
}

// rd = rs + imm for any imm (rd may equal rs; uses t4 for large values).
fn rv_add_imm(cb $&mc.CodeBuffer, rd int, rs int, imm int) {
    if imm >= -2048 && imm < 2048 {
        rv_addi(cb, rd, rs, imm)
        <<
    }
    rv_li(cb, RV_T4, imm)
    rv_add(cb, rd, rs, RV_T4)
}

// Load/store of width 1, 2, 4 (zero-extended), -4 (sign-extended) or 8
// bytes at [rn + off].
fn rv_mem(cb $&mc.CodeBuffer, store bool, width int, rt int, rn int, off int) {
    $base := rn
    $o := off
    if off < -2048 || off >= 2048 {
        rv_li(cb, RV_T4, off)
        rv_add(cb, RV_T4, rn, RV_T4)
        base = RV_T4
        o = 0
    }
    if store {
        $f3 := 3
        if width == 1 { f3 = 0 }
        else if width == 2 { f3 = 1 }
        else if width == 4 || width == -4 { f3 = 2 }
        rv_s(cb, o, rt, base, f3)
        <<
    }
    $f3 := 3
    if width == 1 { f3 = 4 }
    else if width == 2 { f3 = 5 }
    else if width == 4 { f3 = 6 }
    else if width == -4 { f3 = 2 }
    rv_i(cb, o, base, f3, rt, 0x03)
}

fn rv_ld(cb $&mc.CodeBuffer, rt int, rn int, off int) {
    rv_mem(cb, false, 8, rt, rn, off)
}

fn rv_sd(cb $&mc.CodeBuffer, rt int, rn int, off int) {
    rv_mem(cb, true, 8, rt, rn, off)
}

// auipc rd, 0 ; <second> with a pc-relative relocation to label.
fn rv_pcrel_pair(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, rd int, label string, call bool) {
    $kind := mc.RELOC_RISCV_PCREL
    if call {
        kind = mc.RELOC_RISCV_CALL
    }
    relocs.push(mc.reloc_new(cb.len(), label + "", kind, 0))
    e32(cb, (rd << 7) | 0x17)
    if call {
        // jalr rd_link, 0(rd): rd is ra for calls, t3 (link x0) for jumps
        $link := RV_RA
        if rd != RV_RA {
            link = RV_ZERO
        }
        rv_i(cb, 0, rd, 0, link, 0x67)
    } else {
        rv_addi(cb, rd, rd, 0)
    }
}

fn rv_call(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, label string) {
    rv_pcrel_pair(cb, relocs, RV_RA, label, true)
}

fn rv_jump(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc, label string) {
    rv_pcrel_pair(cb, relocs, RV_T3, label, true)
}

// ===== frame =====

// Operand (temp or constant) into register rd.
fn rv_operand(cb $&mc.CodeBuffer, f &mir.MFn, fr &A64Frame, rd int, v int) {
    if v <= -2 {
        rv_li(cb, rd, f.consts[0 - v - 2])
        <<
    }
    if v >= 0 && v < fr.temp_off.len {
        rv_ld(cb, rd, RV_SP, fr.temp_off[v])
        <<
    }
    rv_li(cb, rd, 0)
}

fn rv_set_temp(cb $&mc.CodeBuffer, fr &A64Frame, t int, rs int) {
    if t >= 0 && t < fr.temp_off.len {
        rv_sd(cb, rs, RV_SP, fr.temp_off[t])
    }
}

// ===== operations: t0 = t0 op t1 =====

fn rv_fbin(cb $&mc.CodeBuffer, op int) {
    // fmv.d.x ft0, t0 ; fmv.d.x ft1, t1
    e32(cb, 0xF2000053 | (RV_T0 << 15) | (0 << 7))
    e32(cb, 0xF2000053 | (RV_T1 << 15) | (1 << 7))
    if op <= mir.BIN_FDIV {
        $f7 := 0x01
        if op == mir.BIN_FSUB { f7 = 0x05 }
        else if op == mir.BIN_FMUL { f7 = 0x09 }
        else if op == mir.BIN_FDIV { f7 = 0x0D }
        rv_r(cb, f7, 1, 0, 7, 0, 0x53)
        // fmv.x.d t0, ft0
        e32(cb, 0xE2000053 | (0 << 15) | (RV_T0 << 7))
        <<
    }
    // feq/flt/fle are false on unordered operands; ne is not-equal.
    if op == mir.BIN_FEQ || op == mir.BIN_FNE {
        rv_r(cb, 0x51, 1, 0, 2, RV_T0, 0x53)
        if op == mir.BIN_FNE {
            rv_i(cb, 1, RV_T0, 4, RV_T0, 0x13)
        }
    } else if op == mir.BIN_FLT {
        rv_r(cb, 0x51, 1, 0, 1, RV_T0, 0x53)
    } else if op == mir.BIN_FLE {
        rv_r(cb, 0x51, 1, 0, 0, RV_T0, 0x53)
    } else if op == mir.BIN_FGT {
        rv_r(cb, 0x51, 0, 1, 1, RV_T0, 0x53)
    } else {
        rv_r(cb, 0x51, 0, 1, 0, RV_T0, 0x53)
    }
}

fn rv_un(cb $&mc.CodeBuffer, op int) {
    if op == mir.UN_I2F {
        // fcvt.d.l ft0, t0 ; fmv.x.d t0, ft0
        rv_r(cb, 0x69, 2, RV_T0, 7, 0, 0x53)
        e32(cb, 0xE2000053 | (0 << 15) | (RV_T0 << 7))
    } else if op == mir.UN_F2I {
        // fcvt.l.d t0, ft0, rtz saturates like fcvtzs; NaN must give 0:
        // t1 = feq(ft0, ft0) ; t1 = -t1 ; t0 &= t1
        e32(cb, 0xF2000053 | (RV_T0 << 15) | (0 << 7))
        rv_r(cb, 0x61, 2, 0, 1, RV_T0, 0x53)
        rv_r(cb, 0x51, 0, 0, 2, RV_T1, 0x53)
        rv_r(cb, 0x20, RV_T1, RV_ZERO, 0, RV_T1, 0x33)
        rv_r(cb, 0, RV_T1, RV_T0, 7, RV_T0, 0x33)
    } else if op == mir.UN_F32_LOAD {
        // fmv.w.x ft0, t0 ; fcvt.d.s ft0, ft0 ; fmv.x.d t0, ft0
        e32(cb, 0xF0000053 | (RV_T0 << 15))
        e32(cb, 0x42000053)
        e32(cb, 0xE2000053 | (RV_T0 << 7))
    } else if op == mir.UN_F32_STORE {
        // fmv.d.x ft0, t0 ; fcvt.s.d ft0, ft0 ; fmv.x.w t0, ft0 ; zero-extend low 32
        e32(cb, 0xF2000053 | (RV_T0 << 15))
        e32(cb, 0x40107053)
        e32(cb, 0xE0000053 | (RV_T0 << 7))
        rv_i(cb, 32, RV_T0, 1, RV_T0, 0x13)
        rv_i(cb, 32, RV_T0, 5, RV_T0, 0x13)
    } else {
        rv_trap(cb)
    }
}

fn rv_bin(cb $&mc.CodeBuffer, op int) {
    if op >= mir.BIN_FADD && op <= mir.BIN_FGE {
        rv_fbin(cb, op)
        <<
    }
    if op == mir.BIN_ADD { rv_r(cb, 0, RV_T1, RV_T0, 0, RV_T0, 0x33) }
    else if op == mir.BIN_SUB { rv_r(cb, 0x20, RV_T1, RV_T0, 0, RV_T0, 0x33) }
    else if op == mir.BIN_MUL { rv_r(cb, 1, RV_T1, RV_T0, 0, RV_T0, 0x33) }
    else if op == mir.BIN_DIV {
        // x/0 is 0 (div gives -1): t2 = (t1 != 0) ? -1 : 0 ; t0 = div & t2
        rv_r(cb, 0, RV_T1, RV_ZERO, 3, RV_T2, 0x33)
        rv_r(cb, 0x20, RV_T2, RV_ZERO, 0, RV_T2, 0x33)
        rv_r(cb, 1, RV_T1, RV_T0, 4, RV_T0, 0x33)
        rv_r(cb, 0, RV_T2, RV_T0, 7, RV_T0, 0x33)
    }
    else if op == mir.BIN_MOD { rv_r(cb, 1, RV_T1, RV_T0, 6, RV_T0, 0x33) }
    else if op == mir.BIN_AND { rv_r(cb, 0, RV_T1, RV_T0, 7, RV_T0, 0x33) }
    else if op == mir.BIN_OR { rv_r(cb, 0, RV_T1, RV_T0, 6, RV_T0, 0x33) }
    else if op == mir.BIN_XOR { rv_r(cb, 0, RV_T1, RV_T0, 4, RV_T0, 0x33) }
    else if op == mir.BIN_SHL { rv_r(cb, 0, RV_T1, RV_T0, 1, RV_T0, 0x33) }
    else if op == mir.BIN_SHR { rv_r(cb, 0x20, RV_T1, RV_T0, 5, RV_T0, 0x33) }
    else if op == mir.BIN_EQ || op == mir.BIN_NE {
        rv_r(cb, 0x20, RV_T1, RV_T0, 0, RV_T0, 0x33)
        if op == mir.BIN_EQ {
            rv_i(cb, 1, RV_T0, 3, RV_T0, 0x13)
        } else {
            rv_r(cb, 0, RV_T0, RV_ZERO, 3, RV_T0, 0x33)
        }
    } else if op == mir.BIN_LT {
        rv_r(cb, 0, RV_T1, RV_T0, 2, RV_T0, 0x33)
    } else if op == mir.BIN_GT {
        rv_r(cb, 0, RV_T0, RV_T1, 2, RV_T0, 0x33)
    } else if op == mir.BIN_LE {
        rv_r(cb, 0, RV_T0, RV_T1, 2, RV_T0, 0x33)
        rv_i(cb, 1, RV_T0, 4, RV_T0, 0x13)
    } else if op == mir.BIN_GE {
        rv_r(cb, 0, RV_T1, RV_T0, 2, RV_T0, 0x33)
        rv_i(cb, 1, RV_T0, 4, RV_T0, 0x13)
    } else {
        rv_trap(cb)
    }
}

// lines receives (code offset, source line) pairs where the line changes.
pub fn isel_fn_rv64_base(f &mir.MFn, cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, lines $&[]int) {
    if f.is_naked {
        syms.define_label(f.label, cb.len())
        if f.src_line > 0 {
            lines.push(cb.len())
            lines.push(f.src_line)
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == mir.MI_ASM {
                    if ins.line > 0 {
                        lines.push(cb.len())
                        lines.push(ins.line)
                    }
                    rv_emit_asm_insn(cb, ins.sval)
                }
                ii = ins.next
            }
        }
        <<
    }
    fr := a64_frame(f)
    syms.define_label(f.label, cb.len())
    $last_line := f.src_line
    if last_line > 0 {
        lines.push(cb.len())
        lines.push(last_line)
    }
    // Prologue: push {s0, ra}; s0 = sp; sp -= frame.
    rv_addi(cb, RV_SP, RV_SP, -16)
    rv_sd(cb, RV_RA, RV_SP, 8)
    rv_sd(cb, RV_S0, RV_SP, 0)
    rv_mv(cb, RV_S0, RV_SP)
    if fr.size > 0 {
        rv_add_imm(cb, RV_SP, RV_SP, 0 - fr.size)
    }
    for i in 0:f.nparams {
        if i < 8 {
            rv_sd(cb, RV_A0 + i, RV_SP, fr.local_off[i])
        } else {
            rv_ld(cb, RV_T0, RV_S0, 16 + (i - 8) * 8)
            rv_sd(cb, RV_T0, RV_SP, fr.local_off[i])
        }
    }
    $strs := []StrFix{}
    epilogue := f.label + ".ret"
    for bi in 0:f.blocks.len {
        syms.define_label(f.label + ".bb" + str(bi), cb.len())
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if ins.line > 0 && ins.line != last_line {
                last_line = ins.line
                lines.push(cb.len())
                lines.push(last_line)
            }
            if k == mir.MI_LOAD_LOCAL {
                $w := ins.c
                if w < 0 { w = 0 }
                rv_ld(cb, RV_T0, RV_SP, fr.local_off[ins.b] + w * 8)
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_STORE_LOCAL {
                $w := ins.c
                if w < 0 { w = 0 }
                rv_operand(cb, f, &fr, RV_T0, ins.b)
                rv_sd(cb, RV_T0, RV_SP, fr.local_off[ins.a] + w * 8)
            } else if k == mir.MI_ADDR {
                rv_add_imm(cb, RV_T0, RV_SP, fr.local_off[ins.b])
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_LOAD_PTR || k == mir.MI_VOLATILE_LOAD {
                rv_operand(cb, f, &fr, RV_T1, ins.b)
                $w := ins.d
                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                rv_mem(cb, false, w, RV_T0, RV_T1, ins.c)
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_STORE_PTR || k == mir.MI_VOLATILE_STORE {
                rv_operand(cb, f, &fr, RV_T1, ins.a)
                rv_operand(cb, f, &fr, RV_T0, ins.b)
                $w := ins.d
                if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
                rv_mem(cb, true, w, RV_T0, RV_T1, ins.c)
            } else if k == mir.MI_BIN {
                rv_operand(cb, f, &fr, RV_T0, ins.c)
                rv_operand(cb, f, &fr, RV_T1, ins.d)
                rv_bin(cb, ins.b)
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_UN {
                rv_operand(cb, f, &fr, RV_T0, ins.c)
                rv_un(cb, ins.b)
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_COPY {
                rv_operand(cb, f, &fr, RV_T0, ins.b)
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_CALL || k == mir.MI_CALL_IND {
                $a := ins.c
                $i := 0
                while a >= 0 {
                    if i < 8 {
                        rv_operand(cb, f, &fr, RV_A0 + i, f.margs[a].v)
                    } else {
                        rv_operand(cb, f, &fr, RV_T0, f.margs[a].v)
                        rv_sd(cb, RV_T0, RV_SP, (i - 8) * 8)
                    }
                    i += 1
                    a = f.margs[a].next
                }
                if k == mir.MI_CALL_IND {
                    rv_operand(cb, f, &fr, RV_T3, ins.b)
                    rv_i(cb, 0, RV_T3, 0, RV_RA, 0x67)
                } else {
                    rv_call(cb, relocs, ins.sval)
                }
                rv_set_temp(cb, &fr, ins.a, RV_A0)
            } else if k == mir.MI_STR_CONST {
                strs.push(StrFix{adr_off: cb.len(), bytes: ins.sval + ""})
                e32(cb, (RV_T0 << 7) | 0x17)
                rv_addi(cb, RV_T0, RV_T0, 0)
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_LOAD_FN_ADDR {
                rv_pcrel_pair(cb, relocs, RV_T0, ins.sval, false)
                rv_set_temp(cb, &fr, ins.a, RV_T0)
            } else if k == mir.MI_ASM {
                rv_emit_asm_insn(cb, ins.sval)
            } else {
                rv_trap(cb)
            }
            ii = ins.next
        }
        blk := ~f.blocks[bi]
        if blk.tkind == mir.TKIND_RETURN {
            rv_operand(cb, f, &fr, RV_A0, blk.ta)
            rv_jump(cb, relocs, epilogue)
        } else if blk.tkind == mir.TKIND_JUMP {
            if blk.ta != bi + 1 {
                rv_jump(cb, relocs, f.label + ".bb" + str(blk.ta))
            }
        } else if blk.tkind == mir.TKIND_BRANCH {
            // beqz t0, past the jump to the taken block
            rv_operand(cb, f, &fr, RV_T0, blk.ta)
            rv_b(cb, 0, RV_T0, RV_ZERO, 12)
            rv_jump(cb, relocs, f.label + ".bb" + str(blk.tb))
            if blk.tc != bi + 1 {
                rv_jump(cb, relocs, f.label + ".bb" + str(blk.tc))
            }
        } else {
            rv_li(cb, RV_A0, 0)
            rv_jump(cb, relocs, epilogue)
        }
    }
    syms.define_label(epilogue, cb.len())
    rv_mv(cb, RV_SP, RV_S0)
    rv_ld(cb, RV_S0, RV_SP, 0)
    rv_ld(cb, RV_RA, RV_SP, 8)
    rv_addi(cb, RV_SP, RV_SP, 16)
    rv_ret(cb)
    // String literal pool, patched into the auipc/addi pairs above.
    for si in 0:strs.len {
        pos := cb.len()
        s := strs[si].bytes
        for bi2 in 0:s.len {
            cb.emit_u8(s[bi2])
        }
        cb.emit_u8(0)
        while cb.len() % 4 != 0 {
            cb.emit_u8(0)
        }
        at := strs[si].adr_off
        r := mc.reloc_new(at, "", mc.RELOC_RISCV_PCREL, 0)
        mc.apply_reloc(cb, &r, pos)
    }
}

// Task record slots (runtime/core chan.xu, named after arm64): 0..8 are
// s1-s9, 72 the state register s11, then s0 at 80, ra at 88, sp at 96.
fn rv_task_reg(i int) int {
    if i == 0 { << RV_S1 }
    if i == 9 { << RV_S11 }
    << 17 + i
}

fn rv_emit_asm_insn(cb $&mc.CodeBuffer, raw string) {
    stmts := asm_split_stmts(&raw)
    for si in 0:stmts.len {
        s := stmts[si] + ""
        if asm_emit_directive(cb, s) { -> }
        if s == "compiler_fence" {
            // Compiler optimization/scheduling barrier only; emits zero bytes.
        } else if s == "wfi" || s == "hlt" {
            e32(cb, 0x10500073)
        } else if s == "cli" {
            e32(cb, 0x10017073) // csrci sstatus, 2
        } else if s == "sti" {
            e32(cb, 0x10016073) // csrsi sstatus, 2
        } else if s == "pause" || s == "yield" || s == "wfe" {
            e32(cb, 0x0100000F)
        } else if s == "lfence" || s == "rmb" || s == "dmb ld" {
            e32(cb, 0x0AA0000F) // fence ir, ir
        } else if s == "sfence" || s == "wmb" || s == "dmb st" {
            e32(cb, 0x0550000F) // fence ow, ow
        } else if s == "fence" || s == "dsb sy" || s == "dmb sy" || s == "mfence" || s == "mb" {
            e32(cb, 0x0FF0000F) // fence iorw, iorw
        } else if s == "ret" {
            e32(cb, 0x00008067)
        } else if s == "sret" {
            e32(cb, 0x10200073)
        } else if s == "mret" {
            e32(cb, 0x30200073)
        } else if s == "ecall" {
            e32(cb, 0x00000073)
        } else if s == "ebreak" {
            e32(cb, 0x00100073)
        } else if s == "sfence.vma" {
            e32(cb, 0x12000073)
        } else if s == "fence.i" {
            e32(cb, 0x0000100F)
        } else {
            e32(cb, 0x00000013)
        }
    }
}

fn emit_rv64_task_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    // __xu_task_switch(from a0, to a1)
    syms.define_label("switch_context", cb.len())
    syms.define_label("__xu_task_switch", cb.len())
    for i in 0:10 {
        rv_sd(cb, rv_task_reg(i), RV_A0, i * 8)
    }
    rv_sd(cb, RV_S0, RV_A0, 80)
    rv_sd(cb, RV_RA, RV_A0, 88)
    rv_sd(cb, RV_SP, RV_A0, 96)
    for i in 0:10 {
        rv_ld(cb, rv_task_reg(i), RV_A0 + 1, i * 8)
    }
    rv_ld(cb, RV_S0, RV_A0 + 1, 80)
    rv_ld(cb, RV_RA, RV_A0 + 1, 88)
    rv_ld(cb, RV_SP, RV_A0 + 1, 96)
    rv_ret(cb)

    // Hardware and architecture intrinsics for baremetal kernels
    syms.define_label("in8", cb.len())
    syms.define_label("in16", cb.len())
    syms.define_label("in32", cb.len())
    syms.define_label("read_cr0", cb.len())
    syms.define_label("read_cr4", cb.len())
    syms.define_label("rdmsr", cb.len())
    syms.define_label("gs_read_u64", cb.len())
    syms.define_label("fs_read_u64", cb.len())
    syms.define_label("arm64_read_sctlr_el1", cb.len())
    syms.define_label("arm64_read_ttbr0_el1", cb.len())
    syms.define_label("arm64_read_ttbr1_el1", cb.len())
    syms.define_label("arm64_read_tcr_el1", cb.len())
    syms.define_label("arm64_read_mair_el1", cb.len())
    syms.define_label("arm64_read_esr_el1", cb.len())
    syms.define_label("arm64_read_far_el1", cb.len())
    syms.define_label("arm64_read_elr_el1", cb.len())
    syms.define_label("arm64_read_spsr_el1", cb.len())
    syms.define_label("arm64_read_tpidr_el1", cb.len())
    syms.define_label("arm64_read_mpidr_el1", cb.len())
    rv_li(cb, RV_A0, 0)
    rv_ret(cb)

    syms.define_label("out8", cb.len())
    syms.define_label("out16", cb.len())
    syms.define_label("out32", cb.len())
    syms.define_label("load_idt", cb.len())
    syms.define_label("set_vbar", cb.len())
    syms.define_label("write_cr0", cb.len())
    syms.define_label("write_cr4", cb.len())
    syms.define_label("load_gdt", cb.len())
    syms.define_label("load_tr", cb.len())
    syms.define_label("wrmsr", cb.len())
    syms.define_label("swapgs", cb.len())
    syms.define_label("fxsave", cb.len())
    syms.define_label("fxrstor", cb.len())
    syms.define_label("gs_write_u64", cb.len())
    syms.define_label("fs_write_u64", cb.len())
    syms.define_label("stac", cb.len())
    syms.define_label("clac", cb.len())
    syms.define_label("arm64_write_sctlr_el1", cb.len())
    syms.define_label("arm64_write_ttbr0_el1", cb.len())
    syms.define_label("arm64_write_ttbr1_el1", cb.len())
    syms.define_label("arm64_write_tcr_el1", cb.len())
    syms.define_label("arm64_write_mair_el1", cb.len())
    syms.define_label("arm64_write_elr_el1", cb.len())
    syms.define_label("arm64_write_spsr_el1", cb.len())
    syms.define_label("arm64_write_tpidr_el1", cb.len())
    syms.define_label("arm64_tlbi_vmalle1", cb.len())
    syms.define_label("arm64_tlbi_vae1", cb.len())
    syms.define_label("arm64_isb", cb.len())
    syms.define_label("arm64_dsb_sy", cb.len())
    rv_ret(cb)

    syms.define_label("read_rsp", cb.len())
    e32(cb, 0x00010513) // mv a0, sp
    rv_ret(cb)
    syms.define_label("read_rbp", cb.len())
    e32(cb, 0x00040513) // mv a0, s0
    rv_ret(cb)

    // RISC-V 64 S-mode CSRs & SFENCE.VMA (plus x64-compat CR/invlpg aliases).
    syms.define_label("read_cr3", cb.len())
    syms.define_label("rv64_read_satp", cb.len())
    e32(cb, 0x18002573)
    rv_ret(cb)
    syms.define_label("write_cr3", cb.len())
    syms.define_label("rv64_write_satp", cb.len())
    e32(cb, 0x18051073)
    e32(cb, 0x12000073)
    rv_ret(cb)
    syms.define_label("rv64_read_sstatus", cb.len())
    e32(cb, 0x10002573)
    rv_ret(cb)
    syms.define_label("rv64_write_sstatus", cb.len())
    e32(cb, 0x10051073)
    rv_ret(cb)
    syms.define_label("rv64_read_sie", cb.len())
    e32(cb, 0x10402573)
    rv_ret(cb)
    syms.define_label("rv64_write_sie", cb.len())
    e32(cb, 0x10451073)
    rv_ret(cb)
    syms.define_label("rv64_read_sip", cb.len())
    e32(cb, 0x14402573)
    rv_ret(cb)
    syms.define_label("rv64_write_sip", cb.len())
    e32(cb, 0x14451073)
    rv_ret(cb)
    syms.define_label("rv64_read_stvec", cb.len())
    e32(cb, 0x10502573)
    rv_ret(cb)
    syms.define_label("set_trap_vector", cb.len())
    syms.define_label("rv64_write_stvec", cb.len())
    e32(cb, 0x10551073)
    rv_ret(cb)
    syms.define_label("rv64_read_scause", cb.len())
    e32(cb, 0x14202573)
    rv_ret(cb)
    syms.define_label("read_cr2", cb.len())
    syms.define_label("rv64_read_stval", cb.len())
    e32(cb, 0x14302573)
    rv_ret(cb)
    syms.define_label("rv64_read_sepc", cb.len())
    e32(cb, 0x14102573)
    rv_ret(cb)
    syms.define_label("rv64_write_sepc", cb.len())
    e32(cb, 0x14151073)
    rv_ret(cb)
    syms.define_label("rv64_read_sscratch", cb.len())
    e32(cb, 0x14002573)
    rv_ret(cb)
    syms.define_label("rv64_write_sscratch", cb.len())
    e32(cb, 0x14051073)
    rv_ret(cb)
    syms.define_label("rv64_read_tp", cb.len())
    e32(cb, 0x00020513)
    rv_ret(cb)
    syms.define_label("rv64_write_tp", cb.len())
    e32(cb, 0x00050213)
    rv_ret(cb)
    syms.define_label("rv64_sfence_vma", cb.len())
    e32(cb, 0x12000073)
    rv_ret(cb)
    syms.define_label("invlpg", cb.len())
    syms.define_label("rv64_sfence_vma_addr", cb.len())
    e32(cb, 0x12050073)
    rv_ret(cb)

    syms.define_label("rdtsc", cb.len())
    e32(cb, 0xC0002573) // csrr a0, cycle
    rv_ret(cb)

    syms.define_label("syscall_entry", cb.len())
    e32(cb, 0x10200073) // sret

    syms.define_label("cpuid", cb.len())
    rv_sd(cb, RV_ZERO, RV_A0 + 2, 0)
    rv_sd(cb, RV_ZERO, RV_A0 + 2, 8)
    rv_ret(cb)

    syms.define_label("read_rflags", cb.len())
    e32(cb, 0x10002573) // csrr a0, sstatus
    rv_ret(cb)

    syms.define_label("syscall4", cb.len())
    rv_mv(cb, RV_A7, RV_A0)
    rv_mv(cb, RV_A0, RV_A0 + 1)
    rv_mv(cb, RV_A0 + 1, RV_A0 + 2)
    rv_mv(cb, RV_A0 + 2, RV_A0 + 3)
    rv_mv(cb, RV_A0 + 3, RV_A0 + 4)
    rv_ecall(cb)
    rv_ret(cb)

    // irq_save() -> sstatus with SIE cleared; irq_restore sets SIE back
    // only if it was set in flags.
    syms.define_label("irq_save", cb.len())
    e32(cb, 0x10017573) // csrrci a0, sstatus, 2
    rv_ret(cb)
    syms.define_label("irq_restore", cb.len())
    e32(cb, 0x00257513) // andi a0, a0, 2
    e32(cb, 0x10052073) // csrs sstatus, a0
    rv_ret(cb)
    syms.define_label("boot_magic", cb.len())
    syms.define_label("boot_info_addr", cb.len())
    rv_li(cb, RV_A0, 0)
    rv_ret(cb)

    // Hardware atomic primitives (RV64A + acquire/release fences; a0=ptr, a1=val/exp/delta, a2=desired).
    syms.define_label("atomic_load_u32", cb.len())
    rv_i(cb, 0, RV_A0, 6, RV_A0, 0x03) // lwu a0, 0(a0)
    e32(cb, 0x0230000F)                // fence r, rw
    rv_ret(cb)
    syms.define_label("atomic_store_u32", cb.len())
    e32(cb, 0x0310000F)                // fence rw, w
    rv_s(cb, 0, RV_A0 + 1, RV_A0, 2)   // sw a1, 0(a0)
    rv_ret(cb)
    syms.define_label("atomic_xchg_u32", cb.len())
    e32(cb, 0x0EB5252F)                // amoswap.w.aqrl a0, a1, (a0)
    e32(cb, 0x02051513)                // slli a0, a0, 32
    e32(cb, 0x02055513)                // srli a0, a0, 32
    rv_ret(cb)
    syms.define_label("atomic_cas_u32", cb.len())
    e32(cb, 0x0005859B)                // addiw a1, a1, 0
    e32(cb, 0x160522AF)                // lr.w.aqrl t0, (a0)
    rv_b(cb, 1, RV_T0, RV_A0 + 1, 12)  // bne t0, a1, +12
    e32(cb, 0x1EC5232F)                // sc.w.aqrl t1, a2, (a0)
    rv_b(cb, 1, RV_T1, RV_ZERO, -12)   // bne t1, zero, -12
    rv_i(cb, 32, RV_T0, 1, RV_A0, 0x13) // slli a0, t0, 32
    rv_i(cb, 32, RV_A0, 5, RV_A0, 0x13) // srli a0, a0, 32
    rv_ret(cb)
    syms.define_label("atomic_fetch_add_u32", cb.len())
    e32(cb, 0x06B5252F)                // amoadd.w.aqrl a0, a1, (a0)
    e32(cb, 0x02051513)                // slli a0, a0, 32
    e32(cb, 0x02055513)                // srli a0, a0, 32
    rv_ret(cb)

    syms.define_label("atomic_load_u64", cb.len())
    rv_ld(cb, RV_A0, RV_A0, 0)         // ld a0, 0(a0)
    e32(cb, 0x0230000F)                // fence r, rw
    rv_ret(cb)
    syms.define_label("atomic_store_u64", cb.len())
    e32(cb, 0x0310000F)                // fence rw, w
    rv_sd(cb, RV_A0 + 1, RV_A0, 0)     // sd a1, 0(a0)
    rv_ret(cb)
    syms.define_label("atomic_xchg_u64", cb.len())
    e32(cb, 0x0EB5352F)                // amoswap.d.aqrl a0, a1, (a0)
    rv_ret(cb)
    syms.define_label("atomic_cas_u64", cb.len())
    e32(cb, 0x160532AF)                // lr.d.aqrl t0, (a0)
    rv_b(cb, 1, RV_T0, RV_A0 + 1, 12)  // bne t0, a1, +12
    e32(cb, 0x1EC5332F)                // sc.d.aqrl t1, a2, (a0)
    rv_b(cb, 1, RV_T1, RV_ZERO, -12)   // bne t1, zero, -12
    rv_mv(cb, RV_A0, RV_T0)            // mv a0, t0
    rv_ret(cb)
    syms.define_label("atomic_fetch_add_u64", cb.len())
    e32(cb, 0x06B5352F)                // amoadd.d.aqrl a0, a1, (a0)
    rv_ret(cb)

    // Expanded RV64 atomics (subword LL/SC, bitwise AMO, relaxed & seq_cst).
    syms.define_label("atomic_load_u8", cb.len())
    e32(cb, 0x00054503)
    e32(cb, 0x0230000F)
    rv_ret(cb)
    syms.define_label("atomic_store_u8", cb.len())
    e32(cb, 0x0310000F)
    e32(cb, 0x00B50023)
    rv_ret(cb)
    syms.define_label("atomic_xchg_u8", cb.len())
    e32(cb, 0xFFC57293)
    e32(cb, 0x00357313)
    e32(cb, 0x00331313)
    e32(cb, 0x0FF00393)
    e32(cb, 0x0075F5B3)
    e32(cb, 0x006595B3)
    e32(cb, 0x006393B3)
    e32(cb, 0xFFF3C393)
    e32(cb, 0x1602AE2F)
    e32(cb, 0x007E7EB3)
    e32(cb, 0x00BEEEB3)
    e32(cb, 0x1FD2AF2F)
    e32(cb, 0xFE0F18E3)
    e32(cb, 0x006E5533)
    e32(cb, 0x0FF57513)
    rv_ret(cb)
    syms.define_label("atomic_cas_u8", cb.len())
    e32(cb, 0xFFC57293)
    e32(cb, 0x00357313)
    e32(cb, 0x00331313)
    e32(cb, 0x0FF00393)
    e32(cb, 0x0075F5B3)
    e32(cb, 0x00767633)
    e32(cb, 0x00661633)
    e32(cb, 0x006393B3)
    e32(cb, 0xFFF3C393)
    e32(cb, 0x1602AE2F)
    e32(cb, 0x006E5EB3)
    e32(cb, 0x0FFEFE93)
    e32(cb, 0x00BE9A63)
    e32(cb, 0x007E7F33)
    e32(cb, 0x00CF6F33)
    e32(cb, 0x1FE2AFAF)
    e32(cb, 0xFE0F92E3)
    e32(cb, 0x000E8513)
    rv_ret(cb)

    syms.define_label("atomic_load_u16", cb.len())
    e32(cb, 0x00055503)
    e32(cb, 0x0230000F)
    rv_ret(cb)
    syms.define_label("atomic_store_u16", cb.len())
    e32(cb, 0x0310000F)
    e32(cb, 0x00B51023)
    rv_ret(cb)
    syms.define_label("atomic_xchg_u16", cb.len())
    e32(cb, 0xFFC57293)
    e32(cb, 0x00357313)
    e32(cb, 0x00331313)
    e32(cb, 0x00100393)
    e32(cb, 0x01039393)
    e32(cb, 0xFFF38393)
    e32(cb, 0x0075F5B3)
    e32(cb, 0x006595B3)
    e32(cb, 0x006393B3)
    e32(cb, 0xFFF3C393)
    e32(cb, 0x1602AE2F)
    e32(cb, 0x007E7EB3)
    e32(cb, 0x00BEEEB3)
    e32(cb, 0x1FD2AF2F)
    e32(cb, 0xFE0F18E3)
    e32(cb, 0x006E5533)
    e32(cb, 0x03051513)
    e32(cb, 0x03055513)
    rv_ret(cb)
    syms.define_label("atomic_cas_u16", cb.len())
    e32(cb, 0xFFC57293)
    e32(cb, 0x00357313)
    e32(cb, 0x00331313)
    e32(cb, 0x00100393)
    e32(cb, 0x01039393)
    e32(cb, 0xFFF38393)
    e32(cb, 0x0075F5B3)
    e32(cb, 0x00767633)
    e32(cb, 0x00661633)
    e32(cb, 0x006393B3)
    e32(cb, 0xFFF3C393)
    e32(cb, 0x1602AE2F)
    e32(cb, 0x006E5EB3)
    e32(cb, 0x030E9E93)
    e32(cb, 0x030EDE93)
    e32(cb, 0x00BE9A63)
    e32(cb, 0x007E7F33)
    e32(cb, 0x00CF6F33)
    e32(cb, 0x1FE2AFAF)
    e32(cb, 0xFC0F9EE3)
    e32(cb, 0x000E8513)
    rv_ret(cb)

    syms.define_label("atomic_fetch_sub_u32", cb.len())
    e32(cb, 0x40B005BB)
    e32(cb, 0x06B5252F)
    e32(cb, 0x02051513)
    e32(cb, 0x02055513)
    rv_ret(cb)
    syms.define_label("atomic_fetch_and_u32", cb.len())
    e32(cb, 0x66B5252F)
    e32(cb, 0x02051513)
    e32(cb, 0x02055513)
    rv_ret(cb)
    syms.define_label("atomic_fetch_or_u32", cb.len())
    e32(cb, 0x46B5252F)
    e32(cb, 0x02051513)
    e32(cb, 0x02055513)
    rv_ret(cb)
    syms.define_label("atomic_fetch_xor_u32", cb.len())
    e32(cb, 0x26B5252F)
    e32(cb, 0x02051513)
    e32(cb, 0x02055513)
    rv_ret(cb)

    syms.define_label("atomic_fetch_sub_u64", cb.len())
    e32(cb, 0x40B005B3)
    e32(cb, 0x06B5352F)
    rv_ret(cb)
    syms.define_label("atomic_fetch_and_u64", cb.len())
    e32(cb, 0x66B5352F)
    rv_ret(cb)
    syms.define_label("atomic_fetch_or_u64", cb.len())
    e32(cb, 0x46B5352F)
    rv_ret(cb)
    syms.define_label("atomic_fetch_xor_u64", cb.len())
    e32(cb, 0x26B5352F)
    rv_ret(cb)

    syms.define_label("atomic_load_relaxed_u32", cb.len())
    e32(cb, 0x00056503)
    rv_ret(cb)
    syms.define_label("atomic_store_relaxed_u32", cb.len())
    e32(cb, 0x00B52023)
    rv_ret(cb)
    syms.define_label("atomic_load_relaxed_u64", cb.len())
    e32(cb, 0x00053503)
    rv_ret(cb)
    syms.define_label("atomic_store_relaxed_u64", cb.len())
    e32(cb, 0x00B53023)
    rv_ret(cb)
    syms.define_label("atomic_store_seqcst_u32", cb.len())
    e32(cb, 0x0330000F)
    e32(cb, 0x00B52023)
    e32(cb, 0x0330000F)
    rv_ret(cb)
    syms.define_label("atomic_store_seqcst_u64", cb.len())
    e32(cb, 0x0330000F)
    e32(cb, 0x00B53023)
    e32(cb, 0x0330000F)
    rv_ret(cb)

    // __xu_task_entry: s1 = task, s2 = function, s3 = 16 argument words,
    // s4 = exit function (never returns).
    syms.define_label("__xu_task_entry", cb.len())
    rv_addi(cb, RV_SP, RV_SP, -64)
    for i in 0:8 {
        rv_ld(cb, RV_T0, rv_task_reg(2), 64 + i * 8)
        rv_sd(cb, RV_T0, RV_SP, i * 8)
    }
    for i in 0:8 {
        rv_ld(cb, RV_A0 + i, rv_task_reg(2), i * 8)
    }
    rv_i(cb, 0, rv_task_reg(1), 0, RV_RA, 0x67)
    rv_addi(cb, RV_SP, RV_SP, 64)
    rv_mv(cb, RV_A0, RV_S1)
    rv_i(cb, 0, rv_task_reg(3), 0, RV_RA, 0x67)
    rv_trap(cb)
}

// Baremetal reset jump placed at 0x80000000 for QEMU virt -bios none.
pub fn emit_rv64_none_boot(cb $&mc.CodeBuffer, relocs $&[]mc.Reloc) {
    rv_jump(cb, relocs, "__xu_start")
}

// Process entry, raw system call and runtime-state accessor (Linux).
pub fn emit_rv64_runtime_stubs(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, main_label string) {
    emit_rv64_runtime_stubs_object(cb, syms, relocs, main_label, false)
}

fn rv_fld(cb $&mc.CodeBuffer, ft int, rs1 int, off int) {
    rv_i(cb, off, rs1, 3, ft, 0x07)
}

fn rv_fsd(cb $&mc.CodeBuffer, ft int, rs1 int, off int) {
    e32(cb, (((off >> 5) & 0x7f) << 25) | (ft << 20) | (rs1 << 15) | (3 << 12) | ((off & 0x1f) << 7) | 0x27)
}

pub fn emit_rv64_ffi_slots(cb $&mc.CodeBuffer, syms $&mc.SymbolTable) {
    while cb.len() % 8 != 0 { e32(cb, 0x00000013) }
    syms.define_label(FFI_GOT_LABEL, cb.len())
    syms.define_label(FFI_STATE_LABEL, cb.len() + 24)
    for i in 0:8 { e32(cb, 0) }
}

fn emit_rv64_ffi_calls(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc) {
    // -8: call a1 with call block a2 (a0..a7, fa0..fa7, stack args).
    rv_li(cb, RV_T0, -8)
    rv_b(cb, 1, RV_A0, RV_T0, 12)
    rv_jump(cb, relocs, "__xu_ffi_not8")
    rv_addi(cb, RV_SP, RV_SP, -32)
    rv_sd(cb, RV_RA, RV_SP, 24)
    rv_sd(cb, RV_S0, RV_SP, 16)
    rv_sd(cb, RV_S1, RV_SP, 8)
    rv_sd(cb, RV_S1 + 9, RV_SP, 0) // s2 = x18
    rv_mv(cb, RV_S0, RV_SP)
    rv_pcrel_pair(cb, relocs, RV_T0, FFI_STATE_LABEL, false)
    rv_sd(cb, RV_STATE, RV_T0, 0)
    rv_mv(cb, RV_S1, RV_A0 + 2) // s1 = blk
    rv_mv(cb, RV_S1 + 9, RV_A0 + 1) // s2 = fp
    rv_ld(cb, RV_T0, RV_S1, 128) // nstack
    rv_r(cb, 0x20, RV_T0, RV_SP, 0, RV_SP, 0x33) // sub sp, sp, t0
    rv_ld(cb, RV_T1, RV_S1, 136) // stk src
    rv_mv(cb, RV_T2, RV_SP) // dst
    rv_b(cb, 0, RV_T0, RV_ZERO, 28)
    rv_ld(cb, RV_T3, RV_T1, 0)
    rv_sd(cb, RV_T3, RV_T2, 0)
    rv_addi(cb, RV_T1, RV_T1, 8)
    rv_addi(cb, RV_T2, RV_T2, 8)
    rv_addi(cb, RV_T0, RV_T0, -8)
    rv_b(cb, 0, RV_ZERO, RV_ZERO, -24)
    for i in 0:8 { rv_fld(cb, 10 + i, RV_S1, 64 + i * 8) }
    for i in 0:8 { rv_ld(cb, RV_A0 + i, RV_S1, i * 8) }
    rv_i(cb, 0, RV_S1 + 9, 0, RV_RA, 0x67) // jalr ra, s2, 0
    rv_sd(cb, RV_A0, RV_S1, 152)
    rv_sd(cb, RV_A0 + 1, RV_S1, 160)
    rv_fsd(cb, 10, RV_S1, 168)
    rv_fsd(cb, 11, RV_S1, 176)
    rv_mv(cb, RV_SP, RV_S0)
    rv_ld(cb, RV_S1 + 9, RV_SP, 0)
    rv_ld(cb, RV_S1, RV_SP, 8)
    rv_ld(cb, RV_S0, RV_SP, 16)
    rv_ld(cb, RV_RA, RV_SP, 24)
    rv_addi(cb, RV_SP, RV_SP, 32)
    rv_ret(cb)
    syms.define_label("__xu_ffi_not8", cb.len())
    // -9: address of loader slots (FFI_GOT_LABEL).
    rv_li(cb, RV_T0, -9)
    rv_b(cb, 1, RV_A0, RV_T0, 24)
    rv_pcrel_pair(cb, relocs, RV_T0, FFI_STATE_LABEL, false)
    rv_sd(cb, RV_STATE, RV_T0, 0)
    rv_pcrel_pair(cb, relocs, RV_A0, FFI_GOT_LABEL, false)
    rv_ret(cb)
}

fn emit_rv64_ffi_thunk_one(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, label string, adapter string, is_clos bool) {
    // Frame 432B: [0..207]=call block (incl. FB_CLOSURE=200), [208..311]=ra+s0..s11, [312..407]=fs0..fs11.
    while cb.len() % 16 != 0 { e32(cb, 0x00000013) }
    syms.define_label(label + "", cb.len())
    rv_addi(cb, RV_SP, RV_SP, -432)
    rv_sd(cb, RV_RA, RV_SP, 208)
    rv_sd(cb, RV_S0, RV_SP, 216)
    rv_sd(cb, RV_S1, RV_SP, 224)
    for i in 0:10 { rv_sd(cb, 18 + i, RV_SP, 232 + i * 8) }
    rv_fsd(cb, 8, RV_SP, 312)
    rv_fsd(cb, 9, RV_SP, 320)
    for i in 0:10 { rv_fsd(cb, 18 + i, RV_SP, 328 + i * 8) }
    for i in 0:8 { rv_sd(cb, RV_A0 + i, RV_SP, i * 8) }
    for i in 0:8 { rv_fsd(cb, 10 + i, RV_SP, 64 + i * 8) }
    rv_addi(cb, RV_T1, RV_SP, 432)
    rv_sd(cb, RV_T1, RV_SP, 136)
    rv_pcrel_pair(cb, relocs, RV_STATE, FFI_STATE_LABEL, false)
    rv_ld(cb, RV_STATE, RV_STATE, 0)
    if is_clos {
        rv_li(cb, RV_T1, 24)
        rv_r(cb, 1, RV_T1, RV_T0, 0, RV_T0, 0x33) // mul t0, t0, t1
        rv_li(cb, RV_T1, 3072)
        rv_r(cb, 0, RV_T1, RV_STATE, 0, RV_T2, 0x33) // add t2, s11, t1
        rv_r(cb, 0, RV_T0, RV_T2, 0, RV_T2, 0x33) // add t2, t2, t0
        rv_addi(cb, RV_T1, RV_T2, 8)
        rv_sd(cb, RV_T1, RV_SP, 200)
        rv_ld(cb, RV_T0, RV_T2, 0)
        rv_mv(cb, RV_A0, RV_SP)
        rv_i(cb, 0, RV_T0, 0, RV_RA, 0x67) // jalr ra, t0, 0
    } else {
        rv_mv(cb, RV_A0, RV_SP)
        rv_call(cb, relocs, adapter + "")
    }
    rv_ld(cb, RV_A0, RV_SP, 152)
    rv_ld(cb, RV_A0 + 1, RV_SP, 160)
    rv_fld(cb, 10, RV_SP, 168)
    rv_fld(cb, 11, RV_SP, 176)
    rv_fld(cb, 8, RV_SP, 312)
    rv_fld(cb, 9, RV_SP, 320)
    for i in 0:10 { rv_fld(cb, 18 + i, RV_SP, 328 + i * 8) }
    rv_ld(cb, RV_RA, RV_SP, 208)
    rv_ld(cb, RV_S0, RV_SP, 216)
    rv_ld(cb, RV_S1, RV_SP, 224)
    for i in 0:10 { rv_ld(cb, 18 + i, RV_SP, 232 + i * 8) }
    rv_addi(cb, RV_SP, RV_SP, 432)
    rv_ret(cb)
}

pub fn emit_rv64_ffi_thunks(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, thunks &[]string, adapters &[]string, emit_clos bool) {
    for t in 0:thunks.len {
        emit_rv64_ffi_thunk_one(cb, syms, relocs, thunks[t] + "", adapters[t] + "", false)
    }
    if emit_clos {
        emit_rv64_ffi_thunk_one(cb, syms, relocs, "__xu_ffi_clos_dispatch", "", true)
        while cb.len() % 16 != 0 { e32(cb, 0x00000013) }
        syms.define_label("__xu_ffi_clos_stubs", cb.len())
        for k in 0:64 {
            rv_li(cb, RV_T0, k)
            rv_jump(cb, relocs, "__xu_ffi_clos_dispatch")
            e32(cb, 0x00000013)
            e32(cb, 0x00000013)
        }
    }
}

pub fn emit_rv64_runtime_stubs_object(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, main_label string, emit_object bool) {
    emit_rv64_runtime_stubs_os(cb, syms, relocs, target.OS_LINUX, main_label, emit_object)
}

pub fn emit_rv64_runtime_stubs_os(cb $&mc.CodeBuffer, syms $&mc.SymbolTable, relocs $&[]mc.Reloc, tgt_os int, main_label string, emit_object bool) {
    if tgt_os == target.OS_NONE {
        syms.define_label("__xu_start", cb.len())
        if !emit_object {
            syms.define_label("_start", cb.len())
            rv_pcrel_pair(cb, relocs, RV_SP, "__xu_boot_stack_top", false)
        }
        rv_li(cb, RV_S0, 0)
        // Enable supervisor floating-point state (sstatus.FS = Initial).
        e32(cb, 0x000022B7) // lui t0, 2 (0x2000)
        e32(cb, 0x1002A073) // csrs sstatus, t0
        rv_call(cb, relocs, main_label)
        syms.define_label("__xu_hang", cb.len())
        e32(cb, 0x10500073) // wfi
        rv_b(cb, 0, RV_ZERO, RV_ZERO, -4) // j __xu_hang
        syms.define_label("__xu_globals", cb.len())
        rv_addi(cb, RV_A0, RV_ZERO, 0)
        rv_ret(cb)
        syms.define_label("__xu_syscall", cb.len())
        rv_addi(cb, RV_A0, RV_ZERO, -1)
        rv_ret(cb)
        has_panic := syms.lookup_offset("__xu_panic_handler") >= 0
        if has_panic {
            syms.define_label("_runtime_core_missing_index_panic", cb.len())
            rv_li(cb, RV_A0, 1)
            syms.define_label("_runtime_core_missing_rt_panic", cb.len())
            rv_call(cb, relocs, "__xu_panic_handler")
            e32(cb, 0x10500073) // wfi
            rv_jump(cb, relocs, "__xu_hang")
        } else {
            syms.define_label("_runtime_core_missing_rt_panic", cb.len())
            syms.define_label("_runtime_core_missing_index_panic", cb.len())
            e32(cb, 0x10500073) // wfi
            rv_jump(cb, relocs, "__xu_hang")
        }
        syms.define_label("_runtime_core_missing_str_free", cb.len())
        rv_ret(cb)
        syms.define_label("_runtime_core_missing_u64_div", cb.len())
        e32(cb, 0x02B55533) // divu a0, a0, a1
        rv_ret(cb)
        syms.define_label("_runtime_core_missing_str_eq", cb.len())
        rv_ld(cb, RV_T0, RV_A0, 8)
        rv_ld(cb, RV_T1, RV_A0 + 1, 8)
        rv_b(cb, 1, RV_T0, RV_T1, 52)
        rv_ld(cb, RV_A0, RV_A0, 0)
        rv_ld(cb, RV_A0 + 1, RV_A0 + 1, 0)
        rv_b(cb, 0, RV_T0, RV_ZERO, 32)
        rv_i(cb, 0, RV_A0, 4, RV_T1, 0x03)
        rv_i(cb, 0, RV_A0 + 1, 4, RV_T2, 0x03)
        rv_b(cb, 1, RV_T1, RV_T2, 28)
        rv_addi(cb, RV_A0, RV_A0, 1)
        rv_addi(cb, RV_A0 + 1, RV_A0 + 1, 1)
        rv_addi(cb, RV_T0, RV_T0, -1)
        rv_b(cb, 0, RV_ZERO, RV_ZERO, -28)
        rv_addi(cb, RV_A0, RV_ZERO, 1)
        rv_ret(cb)
        rv_addi(cb, RV_A0, RV_ZERO, 0)
        rv_ret(cb)
        emit_rv64_task_stubs(cb, syms)
        if !emit_object {
            while cb.len() % 16 != 0 {
                e32(cb, 0)
            }
            for bi in 0:16384 {
                e32(cb, 0)
            }
            syms.define_label("__xu_boot_stack_top", cb.len())
        }
        <<
    }
    // __xu_start: argc/argv/envp from the initial stack, map the state
    // block into s11, run main, exit with its result.
    syms.define_label("__xu_start", cb.len())
    if emit_object {
        syms.define_label("xu_app_start", cb.len())
        rv_mv(cb, RV_S1, RV_A0)
        rv_mv(cb, 18, RV_A0 + 1)
        rv_mv(cb, 19, RV_A0 + 2)
    } else {
        rv_ld(cb, RV_S1, RV_SP, 0)
        rv_addi(cb, 18, RV_SP, 8)
        // envp = argv + 8 * (argc + 1)
        rv_i(cb, 3, RV_S1, 1, 19, 0x13)
        rv_add(cb, 19, 19, 18)
        rv_addi(cb, 19, 19, 8)
    }
    rv_li(cb, RV_A0, 0)
    rv_li(cb, RV_A0 + 1, 65536)
    rv_li(cb, RV_A0 + 2, 3)
    rv_li(cb, RV_A0 + 3, 34)
    rv_li(cb, RV_A0 + 4, -1)
    rv_li(cb, RV_A0 + 5, 0)
    rv_li(cb, RV_A7, 222)
    rv_ecall(cb)
    rv_mv(cb, RV_STATE, RV_A0)
    rv_sd(cb, RV_S1, RV_STATE, 0)
    rv_sd(cb, 18, RV_STATE, 8)
    rv_sd(cb, 19, RV_STATE, 32)
    rv_li(cb, RV_S0, 0)
    rv_call(cb, relocs, main_label)
    rv_li(cb, RV_A7, 94)
    rv_ecall(cb)
    // __xu_syscall(nr, a, b, c, d, e, f) -> result or -errno.
    // nr -1 switches tasks (from, to); -2 returns the caller's frame
    // pointer, -3 the address of __xu_start; -4 copies c bytes from b to
    // a, forward; -5 zeroes b bytes at a.
    syms.define_label("__xu_syscall", cb.len())
    emit_rv64_ffi_calls(cb, syms, relocs)
    rv_li(cb, RV_T0, -5)
    rv_b(cb, 1, RV_A0, RV_T0, 52)
    // while b >= 8: sd zero, 0(a) ...
    rv_li(cb, RV_T1, 8)
    rv_b(cb, 4, RV_A0 + 2, RV_T1, 20)
    rv_sd(cb, RV_ZERO, RV_A0 + 1, 0)
    rv_addi(cb, RV_A0 + 1, RV_A0 + 1, 8)
    rv_addi(cb, RV_A0 + 2, RV_A0 + 2, -8)
    rv_b(cb, 0, RV_ZERO, RV_ZERO, -16)
    // while b > 0: sb zero, 0(a) ...
    rv_b(cb, 0, RV_A0 + 2, RV_ZERO, 20)
    rv_s(cb, 0, RV_ZERO, RV_A0 + 1, 0)
    rv_addi(cb, RV_A0 + 1, RV_A0 + 1, 1)
    rv_addi(cb, RV_A0 + 2, RV_A0 + 2, -1)
    rv_b(cb, 0, RV_ZERO, RV_ZERO, -16)
    rv_ret(cb)
    rv_li(cb, RV_T0, -4)
    rv_b(cb, 1, RV_A0, RV_T0, 68)
    rv_li(cb, RV_T1, 8)
    rv_b(cb, 4, RV_A0 + 3, RV_T1, 28)
    rv_ld(cb, RV_T2, RV_A0 + 2, 0)
    rv_sd(cb, RV_T2, RV_A0 + 1, 0)
    rv_addi(cb, RV_A0 + 1, RV_A0 + 1, 8)
    rv_addi(cb, RV_A0 + 2, RV_A0 + 2, 8)
    rv_addi(cb, RV_A0 + 3, RV_A0 + 3, -8)
    rv_b(cb, 0, RV_ZERO, RV_ZERO, -24)
    rv_b(cb, 0, RV_A0 + 3, RV_ZERO, 28)
    rv_i(cb, 0, RV_A0 + 2, 4, RV_T2, 0x03)
    rv_s(cb, 0, RV_T2, RV_A0 + 1, 0)
    rv_addi(cb, RV_A0 + 1, RV_A0 + 1, 1)
    rv_addi(cb, RV_A0 + 2, RV_A0 + 2, 1)
    rv_addi(cb, RV_A0 + 3, RV_A0 + 3, -1)
    rv_b(cb, 0, RV_ZERO, RV_ZERO, -24)
    rv_ret(cb)
    rv_li(cb, RV_T0, -2)
    rv_b(cb, 1, RV_A0, RV_T0, 12)
    rv_mv(cb, RV_A0, RV_S0)
    rv_ret(cb)
    rv_li(cb, RV_T0, -3)
    rv_b(cb, 1, RV_A0, RV_T0, 16)
    rv_pcrel_pair(cb, relocs, RV_A0, "__xu_start", false)
    rv_ret(cb)
    rv_li(cb, RV_T0, -1)
    rv_b(cb, 1, RV_A0, RV_T0, 20)
    rv_mv(cb, RV_A0, RV_A0 + 1)
    rv_mv(cb, RV_A0 + 1, RV_A0 + 2)
    rv_jump(cb, relocs, "__xu_task_switch")
    rv_mv(cb, RV_A7, RV_A0)
    for i in 0:6 {
        rv_mv(cb, RV_A0 + i, RV_A0 + i + 1)
    }
    rv_ecall(cb)
    rv_ret(cb)
    syms.define_label("__xu_globals", cb.len())
    rv_mv(cb, RV_A0, RV_STATE)
    rv_ret(cb)
    syms.define_label("_runtime_core_missing_rt_panic", cb.len())
    syms.define_label("_runtime_core_missing_index_panic", cb.len())
    syms.define_label("_runtime_core_missing_str_free", cb.len())
    rv_ret(cb)
    syms.define_label("_runtime_core_missing_u64_div", cb.len())
    e32(cb, 0x02B55533) // divu a0, a0, a1
    rv_ret(cb)
    emit_rv64_task_stubs(cb, syms)
}
