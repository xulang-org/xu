@xu/types

// Old discriminants are part of the bootstrap/MIR compatibility format.
// Extended boxed types use exactly the shared kind/index encoding, so their
// ids never collide with another family's old discriminant window.
pub fn type_box_tag(ty int) int {
    if ty == 1 { << ANY_TAG_INT }
    if ty == 2 { << ANY_TAG_BOOL }
    if ty == 3 { << ANY_TAG_STRING }
    if ty == 4 { << ANY_TAG_F64 }
    if ty == 8 { << ANY_TAG_I32 }
    if ty == 9 { << ANY_TAG_U32 }
    if ty == 10 { << ANY_TAG_U8 }
    if is_struct_type(ty) { index := struct_index(ty)
        if index < ANY_TAG_INT { << index }
        << type_id(TYPE_KIND_STRUCT,index) }
    if is_array_type(ty) { index := array_index(ty)
        if index < 100 { << ANY_TAG_ARRAY_BASE + index }
        << type_id(TYPE_KIND_ARRAY,index) }
    if is_enum_type(ty) { index := enum_index(ty)
        if index < 100 { << ANY_TAG_ENUM_BASE + index }
        << type_id(TYPE_KIND_ENUM,index) }
    if is_throw_type(ty) { index := throw_index(ty)
        if index < 100 { << ANY_TAG_THROW_BASE + index }
        << type_id(TYPE_KIND_THROW,index) }
    if is_chan_type(ty) { index := chan_index(ty)
        if index < 100 { << ANY_TAG_CHAN_BASE + index }
        << type_id(TYPE_KIND_CHAN,index) }
    if is_fn_type(ty) { index := fn_index(ty)
        if index < 100 { << ANY_TAG_FN_BASE + index }
        << type_id(TYPE_KIND_FN,index) }
    if is_map_type(ty) { index := map_index(ty)
        if index < 50 { << ANY_TAG_MAP_BASE + index }
        << type_id(TYPE_KIND_MAP,index) }
    if is_param_type(ty) { index := param_index(ty)
        if index < 100 { << ANY_TAG_PARAM_BASE + index }
        << type_id(TYPE_KIND_PARAM,index) }
    << -1
}
pub fn box_type_kind(tag int) int {
    if tag >= 0 && tag < ANY_TAG_INT { << TYPE_KIND_STRUCT }
    kind := type_kind(tag)
    if kind >= TYPE_KIND_STRUCT && kind <= TYPE_KIND_MAP && kind != TYPE_KIND_INTERFACE { << kind }
    if tag >= ANY_TAG_ARRAY_BASE && tag < ANY_TAG_ARRAY_BASE + 100 { << TYPE_KIND_ARRAY }
    if tag >= ANY_TAG_ENUM_BASE && tag < ANY_TAG_ENUM_BASE + 100 { << TYPE_KIND_ENUM }
    if tag >= ANY_TAG_THROW_BASE && tag < ANY_TAG_THROW_BASE + 100 { << TYPE_KIND_THROW }
    if tag >= ANY_TAG_CHAN_BASE && tag < ANY_TAG_CHAN_BASE + 100 { << TYPE_KIND_CHAN }
    if tag >= ANY_TAG_FN_BASE && tag < ANY_TAG_FN_BASE + 100 { << TYPE_KIND_FN }
    if tag >= ANY_TAG_PARAM_BASE && tag < ANY_TAG_PARAM_BASE + 100 { << TYPE_KIND_PARAM }
    if tag >= ANY_TAG_MAP_BASE && tag < ANY_TAG_MAP_BASE + 50 { << TYPE_KIND_MAP }
    << 0
}
pub fn box_type_index(tag int) int {
    kind := box_type_kind(tag)
    if kind == 0 { << -1 }
    if type_kind(tag) != 0 { << type_index(tag) }
    if kind == TYPE_KIND_STRUCT { << tag }
    if kind == TYPE_KIND_ARRAY { << tag - ANY_TAG_ARRAY_BASE }
    if kind == TYPE_KIND_ENUM { << tag - ANY_TAG_ENUM_BASE }
    if kind == TYPE_KIND_THROW { << tag - ANY_TAG_THROW_BASE }
    if kind == TYPE_KIND_CHAN { << tag - ANY_TAG_CHAN_BASE }
    if kind == TYPE_KIND_FN { << tag - ANY_TAG_FN_BASE }
    if kind == TYPE_KIND_PARAM { << tag - ANY_TAG_PARAM_BASE }
    if kind == TYPE_KIND_MAP { << tag - ANY_TAG_MAP_BASE }
    << -1
}
