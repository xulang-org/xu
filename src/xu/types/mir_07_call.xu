@xu/types

#xu/ast
#xu/parser

fn (f &mut MFn) wrap_box_any(p &parser.Parser, c &mut Checker, n int, src0 int) int {
    mut src := src0
    if src < 0 {
        ety := c.ntype[n]
        mut ns := c.type_slots(ety)
        if ns < 1 {
            ns = 1
        }
        et := f.new_temp(ety, ns)
        mut cp := mkinstr(MI_COPY)
        cp.a = et
        cp.b = src
        f.emit(cp)
        src = et
    }
    f.mark_move_of(p, c, n)
    dest := f.new_temp(800, 2)
    tag := any_value_tag(c.ntype[n])
    mut nslots := c.type_slots(c.ntype[n])
    if nslots < 1 {
        nslots = any_value_nslots(tag)
    }
    mut ins := mkinstr(MI_BOX_TEMP)
    ins.a = dest
    ins.b = src
    ins.c = tag
    ins.d = nslots
    ins.sval = any_itab_label(tag)
    f.emit(ins)
    << dest
}

fn (f &mut MFn) wrap_box_interface(p &parser.Parser, c &mut Checker, n int, src0 int, want int) int {
    mut src := src0
    if src < 0 {
        ety := c.ntype[n]
        et := f.new_temp(ety, c.type_slots(ety))
        mut cp := mkinstr(MI_COPY)
        cp.a = et
        cp.b = src
        f.emit(cp)
        src = et
    }
    f.mark_move_of(p, c, n)
    dest := f.new_temp(want, 2)
    mut sid := -1
    if is_struct_type(c.ntype[n]) {
        sid = struct_index(c.ntype[n])
    }
    if sid < 0 && n >= 0 && n < c.nlocal.len {
        sid = c.nlocal[n]
    }
    if sid < 0 || sid >= c.structs.len {
        << dest
    }
    ii := interface_index(want)
    if ii < 0 || ii >= c.iface_mods.len {
        << dest
    }
    mut ins := mkinstr(MI_BOX_INTERFACE)
    ins.a = dest
    ins.b = src
    ins.c = sid
    ins.sval = iface_itab_label(c.iface_mods[ii], c.iface_names[ii], c.structs[sid].name)
    f.emit(ins)
    << dest
}

// Wave C: early ncall box/any/caller paths (W3).
fn (f &mut MFn) lower_call_box(p &parser.Parser, c &mut Checker, n int) int {
    // M170: runtime.caller → Frame{file,line,ok} literal (ncall -97).
    if c.ncall[n] == -97 {
        si := struct_index(c.ntype[n])
        dest := f.new_temp(c.ntype[n], c.structs[si].nslots)
        // file string
        ft := f.new_temp(3, 3)
        mut fs := mkinstr(MI_STR_CONST) // LoadStr / StrConst
        fs.a = ft
        fs.b = c.nstr[n]
        f.emit(fs)
        mut st0 := mkinstr(MI_STORE_FIELD)
        st0.a = ft
        st0.b = dest
        st0.c = c.structs[si].fields[0].slot
        st0.d = 3
        f.emit(st0)
        // line
        lt := f.new_temp(1, 1)
        mut lc := mkinstr(MI_COPY)
        lc.a = lt
        lc.b = f.vconst(c.nlocal[n])
        f.emit(lc)
        mut st1 := mkinstr(MI_STORE_FIELD)
        st1.a = lt
        st1.b = dest
        st1.c = c.structs[si].fields[1].slot
        st1.d = 1
        f.emit(st1)
        // ok bool
        ot := f.new_temp(2, 1)
        mut oc := mkinstr(MI_COPY)
        oc.a = ot
        oc.b = f.vconst(c.nclone[n])
        f.emit(oc)
        mut st2 := mkinstr(MI_STORE_FIELD)
        st2.a = ot
        st2.b = dest
        st2.c = c.structs[si].fields[2].slot
        st2.d = 1
        f.emit(st2)
        << dest
    }
    // MS2: struct@ method — dest type from the interface sig; extra args
    // marshaled like a user call (pointer for multi-slot). Emit switches
    // on itable type_id to a closed-world impl of sval.
    if c.ncall[n] == -94 {
        iface := f.lower_expr(p, c, p.nodes[n].a)
        ret := c.ntype[n]
        mut dest := -1
        if ret != 0 {
            dest = f.new_temp(ret, c.type_slots(ret))
        }
        mut args_head := -1
        mut args_last := -1
        mut arg := p.nodes[n].b
        while arg >= 0 {
            mut v := -1
            if mir_abi_by_pointer(c.ntype[arg]) {
                v = f.lower_pointer_arg(p, c, arg)
            } else {
                v = f.lower_expr(p, c, arg)
            }
            mi := f.margs.len
            f.margs.push(MArg{v: v, next: -1})
            if args_head < 0 {
                args_head = mi
            } else {
                f.link_marg(args_last, mi)
            }
            args_last = mi
            f.mark_move_of(p, c, arg)
            arg = p.nodes[arg].next
        }
        mut ins := mkinstr(MI_INTERFACE_METHOD)
        ins.a = dest
        ins.b = iface
        ins.c = c.nstr[n]
        ins.d = args_head
        ins.sval = p.nodes[n].sval
        f.emit(ins)
        if dest < 0 {
            << f.vconst(0)
        }
        << dest
    }
    // M201: heap-box a concrete struct into a dynamic struct@ value.
    if c.ncall[n] == -93 {
        mut arg := p.nodes[n].a
        if p.nodes[n].kind == ast.NK_METHOD_CALL { arg = p.nodes[n].b }
        mut src := f.lower_expr(p, c, arg)
        if src < 0 {
            ety := c.ntype[arg]
            et := f.new_temp(ety, c.type_slots(ety))
            mut cp := mkinstr(MI_COPY)
            cp.a = et
            cp.b = src
            f.emit(cp)
            src = et
        }
        f.mark_move_of(p, c, arg)
        dest := f.new_temp(c.ntype[n], 2)
        ii := c.nstr[n]
        sid := c.nlocal[n]
        mut ins := mkinstr(MI_BOX_INTERFACE)
        ins.a = dest
        ins.b = src
        ins.c = sid
        ins.sval = iface_itab_label(c.iface_mods[ii], c.iface_names[ii], c.structs[sid].name)
        f.emit(ins)
        << dest
    }
    // M200: heap-box a value into dynamic any.
    if c.ncall[n] == -98 {
        mut arg := p.nodes[n].a
        if p.nodes[n].kind == ast.NK_METHOD_CALL { arg = p.nodes[n].b }
        mut src := f.lower_expr(p, c, arg)
        if src < 0 {
            ety := c.ntype[arg]
            et := f.new_temp(ety, c.type_slots(ety))
            mut cp := mkinstr(MI_COPY)
            cp.a = et
            cp.b = src
            f.emit(cp)
            src = et
        }
        f.mark_move_of(p, c, arg)
        dest := f.new_temp(800, 2)
        tag := any_value_tag(c.ntype[arg])
        mut nslots := c.type_slots(c.ntype[arg])
        if nslots < 1 {
            nslots = any_value_nslots(tag)
        }
        mut ins := mkinstr(MI_BOX_TEMP)
        ins.a = dest
        ins.b = src
        ins.c = tag
        ins.d = nslots
        ins.sval = any_itab_label(tag)
        f.emit(ins)
        << dest
    }
    // Same fat layout: retype interface/any as any (no heap box).
    if c.ncall[n] == -99 {
        mut arg := p.nodes[n].a
        if p.nodes[n].kind == ast.NK_METHOD_CALL { arg = p.nodes[n].b }
        src := f.lower_expr(p, c, arg)
        f.mark_move_of(p, c, arg)
        dest := f.new_temp(800, 2)
        mut cp := mkinstr(MI_COPY)
        cp.a = dest
        cp.b = src
        f.emit(cp)
        << dest
    }
    << -1 // not a box special
}

// Wave C: fn-value indirect call and Ord.less builtins (W3).
fn (f &mut MFn) lower_call_fnval(p &parser.Parser, c &mut Checker, n int, fi int) int {
    if fi == -80 {
        lid := c.nlocal[n]
        fty := f.locals[lid]
        si := fn_index(fty)
        mut args_head := -1
        mut args_last := -1
        // args[0] = pointer to fat fn value (M109: 2 slots).
        ptr := f.new_temp(1, 1)
        mut ad := mkinstr(MI_ADDR)
        ad.a = ptr
        ad.b = lid
        ad.c = 0
        f.emit(ad)
        mi0 := f.margs.len
        f.margs.push(MArg{v: ptr, next: -1})
        args_head = mi0
        args_last = mi0
        mut arg := p.nodes[n].a
        mut arg_pos := 0
        while arg >= 0 {
            mut by_pointer := false
            if si >= 0 && si < c.fn_sigs.len {
                by_pointer = mir_abi_by_pointer(c.fn_sigs[si].params[arg_pos])
            }
            mut v := -1
            if is_ref_type(c.fn_sigs[si].params[arg_pos]) {
                v = f.lower_borrow_arg(p, c, arg)
            } else if by_pointer {
                v = f.lower_pointer_arg(p, c, arg)
            } else {
                v = f.lower_expr(p, c, arg)
            }
            mi := f.margs.len
            f.margs.push(MArg{v: v, next: -1})
            f.link_marg(args_last, mi)
            args_last = mi
            if !is_ref_type(c.fn_sigs[si].params[arg_pos]) { f.mark_move_of(p, c, arg) }
            arg_pos += 1
            arg = p.nodes[arg].next
        }
        mut ins := mkinstr(MI_CALL)
        ins.b = 80
        ins.c = args_head
        mut ret := 0
        if si >= 0 && si < c.fn_sigs.len {
            ret = c.fn_sigs[si].ret
        }
        if ret == 0 {
            ins.a = -1
        } else {
            ins.a = f.new_temp(ret, c.type_slots(ret))
        }
        dest := ins.a
        f.emit(ins)
        if dest < 0 {
            << f.vconst(0)
        }
        << dest
    }
    // M102: int/f64.less → BinOp Lt (receiver .a, arg .b).
    if fi == -70 {
        l := f.lower_expr(p, c, p.nodes[n].a)
        r := f.lower_expr(p, c, p.nodes[n].b)
        dest := f.new_temp(2, 1)
        mut bins := mkinstr(MI_BIN) // BinOp
        bins.a = dest
        bins.b = 8 // OpLt
        bins.c = l
        bins.d = r
        f.emit(bins)
        << dest
    }
    if fi == -71 {
        // string.less → call cmp.less_string(recv, other)
        mut lfid := -1
        for i in 0:c.fns.len {
            if c.fns[i].mod_id == "cmp" && c.fns[i].name == "less_string" && c.fns[i].recv < 0 {
                lfid = i
            }
        }
        if lfid < 0 {
            // Should have been caught at check time.
            lfid = 0
        }
        f.mark_move_of(p, c, p.nodes[n].a)
        f.mark_move_of(p, c, p.nodes[n].b)
        lv := f.lower_pointer_arg(p, c, p.nodes[n].a)
        rv := f.lower_pointer_arg(p, c, p.nodes[n].b)
        dest := f.new_temp(2, 1)
        mut ins := mkinstr(MI_CALL)
        ins.a = dest
        ins.b = 1 // user function (emit ib==1)
        ins.sval = c.fns[lfid].label
        mi0 := f.margs.len
        f.margs.push(MArg{v: lv, next: -1})
        mi1 := f.margs.len
        f.margs.push(MArg{v: rv, next: -1})
        mut prev := f.margs[mi0]
        prev.next = mi1
        f.margs[mi0] = prev
        ins.c = mi0
        f.emit(ins)
        << dest
    }
    << -1
}

// Wave C: Call instr ib dispatch after args are packed (W3).
fn (f &mut MFn) lower_call_print(p &parser.Parser, c &mut Checker, n int, args_head int, eprintln bool) int {
    mut ins := mkinstr(MI_CALL)
    ins.c = args_head
    arg_node := p.nodes[n].a
    mut argty := c.ntype[arg_node]
    if is_ref_type(argty) && args_head >= 0 {
        ov := f.margs[args_head].v
        nv := f.deref_print_operand(p, c, arg_node, ov)
        mut ma := f.margs[args_head]
        ma.v = nv
        f.margs[args_head] = ma
        for peel in 0:2 {
            if is_ref_type(argty) {
                argty = c.ref_inner_type(argty)
            }
        }
    }
    if eprintln {
        if is_integer_type(argty) {
            ins.b = 7
        } else if argty == 4 {
            ins.b = 23
        } else {
            ins.b = 6 + argty
        }
    } else {
        if is_integer_type(argty) {
            ins.b = 2
        } else if argty == 4 {
            ins.b = 22
        } else {
            ins.b = 1 + argty
        }
    }
    ins.a = -1
    f.emit(ins)
    // println/eprintln borrow the argument.  If it came from a fresh concat,
    // clone, slice, or string-returning call, give that value an immediate
    // owner after the print; aliases (locals/fields/array elements) are left
    // untouched by the provenance helper.
    if args_head >= 0 {
        v := f.margs[args_head].v
        f.drop_fresh_string_expr(p, c, arg_node, v)
    }
    << -1
}

fn (f &mut MFn) lower_call_emit_less(p &parser.Parser, c &mut Checker, n int) int {
    // Constraint-method `.less` (M102): resolve at lowering from concrete receiver type.
    mut rt := c.direct_type(c.ntype[p.nodes[n].a])
    bt := c.direct_type(c.ntype[p.nodes[n].b])
    if is_param_type(rt) && !is_param_type(bt) {
        rt = bt
    }
    if is_param_type(rt) && f.src_fi >= 0 {
        t0 := c.inst_elem_t0(f.src_fi)
        if t0 >= 0 {
            rt = t0
        }
    }
    if rt == 1 || rt == 4 {
        l := f.lower_expr(p, c, p.nodes[n].a)
        r := f.lower_expr(p, c, p.nodes[n].b)
        dest := f.new_temp(2, 1)
        mut bins := mkinstr(MI_BIN)
        bins.a = dest
        bins.b = 8 // OpLt
        bins.c = l
        bins.d = r
        f.emit(bins)
        << dest
    }
    if rt == 3 {
        mut lfid := -1
        for i in 0:c.fns.len {
            if c.fns[i].mod_id == "cmp" && c.fns[i].name == "less_string" && c.fns[i].recv < 0 {
                lfid = i
            }
        }
        if lfid < 0 {
            lfid = 0
        }
        f.mark_move_of(p, c, p.nodes[n].a)
        f.mark_move_of(p, c, p.nodes[n].b)
        lv := f.lower_pointer_arg(p, c, p.nodes[n].a)
        rv := f.lower_pointer_arg(p, c, p.nodes[n].b)
        dest := f.new_temp(2, 1)
        mut ins2 := mkinstr(MI_CALL)
        ins2.a = dest
        ins2.b = 1 // user function (emit ib==1)
        ins2.sval = c.fns[lfid].label
        mi0 := f.margs.len
        f.margs.push(MArg{v: lv, next: -1})
        mi1 := f.margs.len
        f.margs.push(MArg{v: rv, next: -1})
        mut prev := f.margs[mi0]
        prev.next = mi1
        f.margs[mi0] = prev
        ins2.c = mi0
        f.emit(ins2)
        << dest
    }
    << -1
}

fn (f &mut MFn) lower_call_emit_str_ops(p &parser.Parser, c &mut Checker, n int, fi int, args_head int, ins &mut MInstr) {
    if fi == -142 || fi == -143 {
        arg0 := p.nodes[n].a
        if is_ref_type(c.ntype[arg0]) && args_head >= 0 {
            ov := f.margs[args_head].v
            nv := f.deref_print_operand(p, c, arg0, ov)
            mut ma := f.margs[args_head]
            ma.v = nv
            f.margs[args_head] = ma
        }
        if fi == -142 {
            ins.b = 162
        } else {
            ins.b = 163
        }
        ins.a = f.new_temp(1, 1)
        <<
    }
    if fi == -144 {
        arg0 := p.nodes[n].a
        if is_ref_type(c.ntype[arg0]) && args_head >= 0 {
            ov := f.margs[args_head].v
            nv := f.deref_print_operand(p, c, arg0, ov)
            mut ma := f.margs[args_head]
            ma.v = nv
            f.margs[args_head] = ma
        }
        ins.b = 164
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
        <<
    }
    if fi == -145 {
        arg0 := p.nodes[n].a
        mut arg1 := -1
        if arg0 >= 0 {
            arg1 = p.nodes[arg0].next
        }
        mut sep_at := -1
        if args_head >= 0 {
            sep_at = f.margs[args_head].next
        }
        if arg1 >= 0 && is_ref_type(c.ntype[arg1]) && sep_at >= 0 {
            ov := f.margs[sep_at].v
            nv := f.deref_print_operand(p, c, arg1, ov)
            mut ma := f.margs[sep_at]
            ma.v = nv
            f.margs[sep_at] = ma
        }
        ins.b = 165
        ins.a = f.new_temp(3, 3)
        <<
    }
    <<
}

fn (f &mut MFn) lower_call_emit(p &parser.Parser, c &mut Checker, n int, fi int, args_head int) int {
    if fi == -2 {
        << f.lower_call_print(p, c, n, args_head, false)
    }
    if fi == -7 {
        << f.lower_call_print(p, c, n, args_head, true)
    }
    mut ins := mkinstr(MI_CALL)
    ins.c = args_head
    if fi == -3 { // string.push_str(&str, suffix)
        ins.b = 5 // push_str target kind
        ins.sval = "_rt_push_str"
        ins.a = -1
    } else if fi == -110 { // string.push_byte(&str, byte int)
        ins.b = 122
        ins.a = -1
    } else if fi == -72 {
        res := f.lower_call_emit_less(p, c, n)
        if res >= 0 { << res }
    } else if fi == -19 {
        // str(string) identity: reuse the already-lowered argument.  The
        // surrounding `lower_call` builds the argument list before dispatch;
        // lowering it again here duplicates side effects and leaks a fresh
        // result in nested forms such as `str(str(i))`.
        mut v := -1
        if args_head >= 0 { v = f.margs[args_head].v }
        << f.deref_print_operand(p, c, p.nodes[n].a, v)
    } else if fi == -20 {
        // str(bool): static "true"/"false" via emit target 21.  Reuse the
        // argument value for the same single-evaluation guarantee.
        mut v := -1
        if args_head >= 0 { v = f.margs[args_head].v }
        v = f.deref_print_operand(p, c, p.nodes[n].a, v)
        dest := f.new_temp(3, 3)
        mut insb := mkinstr(MI_CALL)
        insb.a = dest
        insb.b = 21
        mi := f.margs.len
        f.margs.push(MArg{v: v, next: -1})
        insb.c = mi
        f.emit(insb)
        << dest
    } else if fi == -33 {
        ins.b = 41 // volatile_store(addr, value) — freestanding MMIO (E7)
        ins.a = -1
    } else if fi == -34 {
        ins.b = 42 // volatile_store8(addr, value)
        ins.a = -1
    } else if fi == -35 {
        ins.b = 43 // volatile_load(addr) → int
        ins.a = f.new_temp(1, 1)
    } else if fi == -36 {
        ins.b = 44 // volatile_load8(addr) → int
        ins.a = f.new_temp(1, 1)
    } else if fi == -37 {
        ins.b = 40 // raise_irq(n)
        ins.a = -1
    } else if fi <= -6 && fi >= -18 {
        if fi == -6 {
            // M164: str(&int) auto-deref.
            arg_node := p.nodes[n].a
            if is_ref_type(c.ntype[arg_node]) && args_head >= 0 {
                ov := f.margs[args_head].v
                nv := f.deref_print_operand(p, c, arg_node, ov)
                mut ma := f.margs[args_head]
                ma.v = nv
                f.margs[args_head] = ma
            }
            ins.b = 6
        }   // str(int)
        if fi == -8 { ins.b = 10 }  // string_from_byte
        if fi == -9 {
            ins.b = 11 // string_from_bytes: fixed arrays have descending frame elements.
            ins.d = c.array_fixed_len_m(c.direct_type_m(c.ntype[p.nodes[n].a]))
        }
        if fi == -10 { ins.b = 12 } // read_file
        if fi == -11 { ins.b = 13 } // write_file
        if fi == -12 { ins.b = 14 } // args
        if fi == -13 { ins.b = 15 } // exit
        if fi == -15 { ins.b = 16 } // is_digit
        if fi == -16 { ins.b = 17 } // is_alpha
        if fi == -17 { ins.b = 18 } // is_alnum
        if fi == -18 { ins.b = 19 } // is_space
        if c.ntype[n] == 0 { ins.a = -1 } else { ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n])) }
    } else if fi == -140 {
        ins.b = 160 // make_ints(n) → owned []int. Not -111: that is os_chmod.
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -141 {
        ins.b = 161 // make_string(n) → owned string
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi >= -145 && fi <= -142 {
        f.lower_call_emit_str_ops(p, c, n, fi, args_head, mut &ins)
    } else if fi == -23 {
        ins.b = 24 // assert
        ins.a = -1
        ins.line = p.nodes[n].line
        ins.col = p.nodes[n].col
        ins.file = f.file
    } else if fi == -24 {
        ins.b = 25 // parse_int → throw<int, errors.Error>
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -25 {
        // starts_with(string, string) → bool.
        ins.b = 26
        ins.a = f.new_temp(2, 1)
    } else if fi == -26 {
        // read_dir(path) → throw<string, errors.Error> via _rt_read_dir.
        ins.b = 27
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -27 {
        ins.b = 28 // now_ns
        ins.a = f.new_temp(1, 1)
    } else if fi == -127 {
        ins.b = 136 // wall_time_ns
        ins.a = f.new_temp(1, 1)
    } else if fi == -129 {
        ins.b = 155 // sys_wait_cancel(chan int, ns) -> bool, does not consume
        ins.a = f.new_temp(2, 1)
    } else if fi == -28 {
        ins.b = 29 // sleep_ns
        ins.a = -1
    } else if fi <= -38 && fi >= -49 {
        // System info (Go os): 45 getpid, 46 getppid, 47 uid, 48 gid,
        // 49 euid, 50 egid, 51 pagesize, 52 host_name, 53 cwd,
        // 54 env_get, 55 env_list, 56 tmp_dir.
        ins.b = 45 + (0 - fi - 38)
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -50 {
        // stat(path) → throw<FileInfo, errors.Error> via _rt_stat.
        ins.b = 57
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -51 {
        // mkdir(path) → throw<int, errors.Error> via _rt_mkdir.
        ins.b = 58
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -52 {
        // rename(old, new) → throw<int, errors.Error> via _rt_rename.
        ins.b = 59
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -53 {
        // remove(path) → throw<int, errors.Error> via _rt_remove.
        ins.b = 60
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -54 {
        // atomic_load(mut &x) → int.
        ins.b = 61
        ins.a = f.new_temp(1, 1)
    } else if fi == -55 {
        // atomic_store(mut &x, v).
        ins.b = 62
        ins.a = -1
    } else if fi == -56 {
        // atomic_add(mut &x, d) → int (old value).
        ins.b = 63
        ins.a = f.new_temp(1, 1)
    } else if fi == -57 {
        // atomic_cas(mut &x, old, new) → bool.
        ins.b = 64
        ins.a = f.new_temp(2, 1)
    } else if fi == -58 {
        // sys_connect4(fd, a,b,c,d,port) → throw<int, errors.Error>.
        ins.b = 65
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -122 {
        // sys_bind6(fd, ip16, port) → throw<int, errors.Error>.
        ins.b = 131
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -123 {
        // sys_connect6(fd, ip16, port) → throw<int, errors.Error>.
        ins.b = 132
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -124 {
        // sys_bind_unix(fd, path) → throw<int, errors.Error>.
        ins.b = 133
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -125 {
        // sys_connect_unix(fd, path) → throw<int, errors.Error>.
        ins.b = 134
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -130 {
        ins.b = 156 // sys_socket_poll(fd, events) -> throw<int>
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -126 {
        // sys_interface_data(name) → throw<string, errors.Error>.
        ins.b = 135
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -59 {
        // retired net_listen_tcp4
        ins.b = 66
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -60 {
        // net_accept(fd) → throw<int, errors.Error>.
        ins.b = 67
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -61 {
        // net_conn_close(fd) → throw<int, errors.Error>.
        ins.b = 68
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -62 {
        // net_conn_write(fd, data) → throw<int, errors.Error>.
        ins.b = 69
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -63 {
        // net_conn_read(fd, max) → throw<string, errors.Error>.
        ins.b = 70
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -29 {
        // net_socket(domain, typ, proto) → throw<int, errors.Error>.
        ins.b = 93
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -79 {
        // net_udp_sendto(fd, addr, data) → throw<int, errors.Error>.
        ins.b = 94
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -81 {
        // net_udp_recvfrom(fd, max) → throw<string, errors.Error>.
        // 95 is reserved for FieldRMW in Gen1; keep recvfrom on the
        // dedicated hosted-net call id consumed by the emitter/runtime.
        ins.b = 104
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -100 {
        // net_bind4(fd, a,b,c,d,port) → throw<int, errors.Error>.
        ins.b = 96
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -82 {
        // net_listen_fd(fd, backlog) → throw<int, errors.Error>.
        ins.b = 97
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -64 {
        ins.b = 72
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -65 {
        ins.b = 73
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -66 {
        ins.b = 74
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -109 {
        // sys_setsockopt_timeo(fd, ns) → throw slot; emit ib==121.
        ins.b = 121
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -67 {
        ins.b = 75
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -111 {
        ins.b = 123
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -112 {
        ins.b = 124
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -113 {
        ins.b = 125
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -114 {
        ins.b = 126
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -115 {
        ins.b = 127
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -116 {
        ins.b = 128
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -117 {
        ins.b = 129
        ins.a = f.new_temp(1, 1)
    } else if fi == -118 {
        // sys_random_fill(n) → throw<string, errors.Error> via platform ABI.
        ins.b = 130
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -128 {
        // sys_security_store(name) → length-framed opaque platform entries.
        ins.b = 137
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -131 {
        ins.b = 138
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi == -101 {
        ins.b = 99 // xu_target_os → mov imm(a.os)
        ins.a = f.new_temp(1, 1)
    } else if fi == -102 {
        // ui_host_run(tmp) → int via _rt_ui_host_run.
        ins.b = 100
        ins.a = f.new_temp(1, 1)
    } else if fi == -106 {
        // test_soft_fail() marks the current test as failed.
        ins.b = 116
        ins.a = -1
    } else if fi == -107 {
        // test_skip() longjmps out of the current test as SKIP.
        ins.b = 117
        ins.a = -1
    } else if fi == -108 {
        // test_is_short() → int/bool flag from the harness runtime.
        ins.b = 120
        ins.a = f.new_temp(1, 1)
    } else if fi == -22 {
        // os_system(cmd) → int via _rt_os_system (Ret).
        ins.b = 71
        ins.a = f.new_temp(1, 1)
    } else if fi == -75 || fi == -76 {
        // s.bytes() / s.runes() → []int. Auto-deref &string like println.
        recv := p.nodes[n].a
        if is_ref_type(c.ntype[recv]) && args_head >= 0 {
            ov := f.margs[args_head].v
            nv := f.deref_print_operand(p, c, recv, ov)
            mut ma := f.margs[args_head]
            ma.v = nv
            f.margs[args_head] = ma
        }
        if fi == -75 {
            ins.b = 81
        } else {
            ins.b = 82
        }
        ins.a = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    } else if fi < 0 {
        // Missing ncall lowering used to index c.fns[-N] (OOB). Keep
        // going with an empty user-call so the next diagnostic is
        // "unhandled ncall" rather than a bounds trap in a later fn.
        eprintln("mir: unhandled ncall " + str(fi) + " in " + f.name)
        ins.b = 1
        ins.sval = ""
        ins.a = -1
    } else {
        ins.b = 1
        ins.sval = c.fns[fi].label
        mut call_ret := c.fns[fi].ret
        if fi < c.fn_throw_ty.len && is_throw_type(c.fn_throw_ty[fi]) {
            call_ret = c.fn_throw_ty[fi]
        }
        if call_ret == 0 {
            ins.a = -1
        } else {
            ins.a = f.new_temp(call_ret, c.type_slots(call_ret))
        }
    }
    dest := ins.a
    f.emit(ins)
    if dest < 0 {
        << f.vconst(0) // void; only reachable in stmt position
    }
    << dest
}

fn (f &mut MFn) lower_call(p &parser.Parser, c &mut Checker, n int, call_fi int) int {
    // Box / any / caller / iface specials (early ncall).
    if c.ncall[n] == -97 || c.ncall[n] == -94 || c.ncall[n] == -93 || c.ncall[n] == -98 || c.ncall[n] == -99 {
        << f.lower_call_box(p, c, n)
    }
    if c.ncall[n] == -84 || c.ncall[n] == -85 || c.ncall[n] == -86 || c.ncall[n] == -87 || c.ncall[n] == -88 {
        << f.lower_native_map_method(p, c, n)
    }
    mut raw_fi := c.ncall[n]
    if call_fi != -1 {
        raw_fi = call_fi
    }
    mut fi := c.resolve_call_instance(p, n, raw_fi, f.src_fi)
    mut redirected_br := false
    if p.nodes[n].kind == ast.NK_METHOD_CALL && (c.ncall[n] == -75 || c.ncall[n] == -76) {
        abi_syntax := p.nodes[n].sval + ""
        mut rfi := c.require_runtime_abi(p, n, runtime_abi_syntax_id(&abi_syntax))
        if rfi >= 0 {
            fi = rfi
            redirected_br = true
        }
    }
    // Monomorphized Ord.less: shared template markers may be stale (-72).
    if p.nodes[n].kind == ast.NK_METHOD_CALL && method_is(p, n, "less") && f.src_fi >= 0 {
        t0 := c.inst_elem_t0(f.src_fi)
        if t0 == 1 || t0 == 4 {
            fi = -70
        }
        if t0 == 3 {
            fi = -71
        }
    }
    // M103: indirect call through a fn-typed local/param.
    if fi == -80 || fi == -70 || fi == -71 {
        << f.lower_call_fnval(p, c, n, fi)
    }
    mut args_head := -1
    mut args_last := -1
    mut arg := p.nodes[n].a
    mut method_args := -1
    // `push_str` borrows its suffix.  Remember the source node/value so a
    // fresh temporary suffix can be reclaimed after the call emits.
    mut push_suffix_node := -1
    mut push_suffix_value := -1
    // MethodCall on a free function = module-qualified call (M9): args in .b only.
    mut is_method := p.nodes[n].kind == ast.NK_METHOD_CALL
    if is_method && fi >= 0 && c.fns[fi].recv < 0 {
        is_method = false
        if !redirected_br { arg = p.nodes[n].b }
    } else if p.nodes[n].kind == ast.NK_METHOD_CALL {
        method_args = p.nodes[n].b
    }
    // M37: a variadic call passes its trailing args packed into a single
    // `[]T` array literal (mirrors a written `[a, b, c]` argument). The
    // variadic param is the last slot in `params`.
    mut variadic := false
    mut fixed_params := 0
    mut variadic_ty := -1
    if fi >= 0 && c.fns[fi].variadic {
        variadic = true
        fixed_params = c.fns[fi].params.len - 1
        variadic_ty = c.fns[fi].params[fixed_params]
    }
    mut arg_pos := 0
    while arg >= 0 {
        is_receiver := is_method && arg_pos == 0
        mut pi := arg_pos
        if is_method { pi = pi - 1 }
        if variadic && !is_receiver && pi >= fixed_params {
            <-
        }
        mut borrowed := false
        mut by_pointer := false
        if fi >= 0 {
            if is_receiver {
                by_pointer = true
            } else {
                pty := c.fns[fi].params[pi]
                borrowed = is_ref_type(pty)
                by_pointer = mir_abi_by_pointer(pty)
                if borrowed && !is_ref_type(c.ntype[arg]) { by_pointer = true }
            }
        }
        if fi == -9 && c.array_fixed_len_m(c.direct_type_m(c.ntype[arg])) > 0 {
            by_pointer = true
        }
        if fi == -3 && is_receiver { by_pointer = true }
        if fi == -110 && is_receiver { by_pointer = true }
        mut v := -1
        if borrowed {
            v = f.lower_borrow_arg(p, c, arg)
        } else if by_pointer {
            v = f.lower_pointer_arg(p, c, arg)
        } else {
            v = f.lower_expr(p, c, arg)
        }
        if fi >= 0 && !is_receiver && !borrowed && !by_pointer && is_ref_type(c.ntype[arg]) {
            v = f.deref_print_operand(p, c, arg, v)
        }
        // M108/M2b: string by-value (ABI by-pointer) cloned at the call when
        // the argument is a caller local — callee drop must not free the
        // caller's descriptor. Non-owning local holds the clone; pass its Addr.
        // String clone-on-pass for user Ident args (m2b / own_loop).
        mut cloned_str := false
        if fi >= 0 && !is_receiver && pi >= 0 && pi < c.fns[fi].params.len {
            pty := c.fns[fi].params[pi]
            // A move-barrier identifier was already cloned by
            // lower_pointer_arg. Cloning again would orphan that allocation.
            already_cloned := arg >= 0 && arg < c.nclone.len && c.nclone[arg] == 1
            if pty == 3 && by_pointer && p.nodes[arg].kind == ast.NK_IDENT && !already_cloned {
                srcv := v
                // v is Addr(local) from lower_pointer_arg; load the descriptor
                desc := f.new_temp(3, 3)
                mut lp := mkinstr(MI_LOAD_PTR)
                lp.a = desc
                lp.b = srcv
                lp.c = 0
                lp.d = 3
                f.emit(lp)
                ctmp := f.new_temp(3, 3)
                mut cl := mkinstr(MI_STR_CLONE)
                cl.a = ctmp
                cl.b = desc
                f.emit(cl)
                lid := f.new_local(3, 3, false)
                mut st := mkinstr(MI_STORE_LOCAL)
                st.a = lid
                st.b = ctmp
                f.emit(st)
                ptr := f.new_temp(1, 1)
                mut ad := mkinstr(MI_ADDR)
                ad.a = ptr
                ad.b = lid
                ad.c = 0
                f.emit(ad)
                v = ptr
            }
        }
        if fi == -110 && !is_receiver {
            t := f.new_temp(1, 1)
            mut cp := mkinstr(MI_COPY)
            cp.a = t
            cp.b = v
            f.emit(cp)
            v = t
        }
        mi := f.margs.len
        f.margs.push(MArg{v: v, next: -1})
        if args_head < 0 {
            args_head = mi
        } else {
            f.link_marg(args_last, mi)
        }
        args_last = mi
        // Clone path: original local stays owned by the caller.
        if fi >= 0 && !is_receiver && pi >= 0 && pi < c.fns[fi].params.len {
            if c.fns[fi].params[pi] == 3 && by_pointer && p.nodes[arg].kind == ast.NK_IDENT {
                cloned_str = true
            }
        }
        if fi >= 0 && !is_receiver && !cloned_str && !borrowed { f.mark_move_of(p, c, arg) }
        if fi == -3 && !is_receiver {
            push_suffix_node = arg
            push_suffix_value = v
        }
        arg_pos += 1
        // M170: after receiver, inject compile-time file/line for log *_at.
        // String params are passed by pointer (same as lower_pointer_arg).
        if is_method && c.ncsite[n] == 1 && arg_pos == 1 {
            ft := f.new_temp(3, 3)
            mut fs := mkinstr(MI_STR_CONST)
            fs.a = ft
            fs.b = c.nstr[n]
            f.emit(fs)
            fptr := f.new_temp(1, 1)
            mut fad := mkinstr(MI_ADDR)
            fad.a = fptr
            fad.b = ft
            fad.c = 1
            f.emit(fad)
            mi_f := f.margs.len
            f.margs.push(MArg{v: fptr, next: -1})
            f.link_marg(args_last, mi_f)
            args_last = mi_f
            lt := f.new_temp(1, 1)
            mut lc := mkinstr(MI_COPY)
            lc.a = lt
            lc.b = f.vconst(c.nlocal[n])
            f.emit(lc)
            mi_l := f.margs.len
            f.margs.push(MArg{v: lt, next: -1})
            f.link_marg(args_last, mi_l)
            args_last = mi_l
            arg_pos += 2
        }
        if method_args >= 0 && arg == p.nodes[n].a {
            arg = method_args
            method_args = -1
        } else {
            arg = p.nodes[arg].next
        }
    }
    // M37: pack the trailing variadic args (possibly zero) into a single
    // `[]T` array literal and pass its descriptor by pointer — exactly what a
    // written `[a, b, c]` argument would lower to.
    if variadic {
        elem_ty := c.arrays[array_index(variadic_ty)].elem_ty
        mut n_elems := 0
        mut pack_head := -1
        mut pack_last := -1
        mut e := arg
        while e >= 0 {
            vt := f.lower_expr(p, c, e)
            f.mark_move_of(p, c, e)
            mi2 := f.margs.len
            f.margs.push(MArg{v: vt, next: -1})
            if pack_head < 0 {
                pack_head = mi2
            } else {
                f.link_marg(pack_last, mi2)
            }
            pack_last = mi2
            n_elems += 1
            e = p.nodes[e].next
        }
        dest := f.new_temp(variadic_ty, 3)
        mut al := mkinstr(MI_ARRAY_LIT)
        al.a = dest
        al.b = n_elems
        al.c = pack_head
        al.d = c.type_size_bytes(elem_ty)
        f.emit(al)
        ptr := f.new_temp(1, 1)
        mut adr := mkinstr(MI_ADDR)
        adr.a = ptr
        adr.b = dest
        adr.c = 1
        f.emit(adr)
        mi := f.margs.len
        f.margs.push(MArg{v: ptr, next: -1})
        if args_head < 0 {
            args_head = mi
        } else {
            f.link_marg(args_last, mi)
        }
        args_last = mi
    }
    result := f.lower_call_emit(p, c, n, fi, args_head)
    if fi == -9 && args_head >= 0 {
        source := p.nodes[n].a
        ty := c.ntype[source]
        kind := p.nodes[source].kind
        // The constructor borrows its input; only a fresh dynamic owner ends
        // here. Identifiers and fields retain their caller-owned lifetime.
        if is_array_type(ty) && c.array_fixed_len_m(ty) == 0 && (kind == ast.NK_CALL || kind == ast.NK_METHOD_CALL || kind == ast.NK_ARRAY_LIT || kind == ast.NK_EMPTY_ARRAY || kind == ast.NK_SLICE) {
            lid := f.new_local(ty, 3, true)
            mut st := mkinstr(MI_STORE_LOCAL)
            st.a = lid
            st.b = f.margs[args_head].v
            f.emit(st)
            mut drop := mkinstr(MI_DROP)
            drop.a = lid
            f.emit(drop)
        }
    }
    if fi == -3 && push_suffix_node >= 0 {
        f.drop_fresh_string_expr(p, c, push_suffix_node, push_suffix_value)
    }
    << result
}

// Native map helpers borrow keys; fresh string expressions own a descriptor
// until the helper has finished. The synthetic owner is never scope-tracked.
fn (f &mut MFn) lower_native_map_key(p &parser.Parser, c &mut Checker, n int, hold &mut int) int {
    *hold = -1
    if c.ntype[n] == 3 && f.fresh_string_expr(p, c, n) {
        value := f.lower_expr(p, c, n)
        lid := f.new_local(3, 3, true)
        *hold = lid
        mut st := mkinstr(MI_STORE_LOCAL)
        st.a = lid
        st.b = value
        f.emit(st)
        key := f.new_temp(1, 1)
        mut ad := mkinstr(MI_ADDR)
        ad.a = key
        ad.b = lid
        ad.c = 0
        f.emit(ad)
        << key
    }
    << f.lower_pointer_arg(p, c, n)
}
fn (f &mut MFn) drop_native_map_key(hold int) {
    if hold < 0 { << }
    mut di := mkinstr(MI_DROP)
    di.a = hold
    f.emit(di)
}

fn (f &mut MFn) lower_native_map_method(p &parser.Parser, c &mut Checker, n int) int {
    fi := c.ncall[n]
    handle := f.lower_map_handle(p, c, p.nodes[n].a)
    mut dest := -1
    mut kind := 0
    mut sval := ""
    if fi == -85 {
        dest = f.new_temp(1, 1)
        kind = 88
        sval = "_rt_map_len"
        mut ins := mkinstr(MI_CALL)
        ins.a = dest
        ins.b = kind
        ins.sval = sval
        mi0 := f.margs.len
        f.margs.push(MArg{v: handle, next: -1})
        ins.c = mi0
        f.emit(ins)
        << dest
    }
    mut key_hold := -1
    mut scalar_ty := c.native_map_scalar_type(p.nodes[n].a)
    // take still transfers through a descriptor; specialize only these methods.
    if fi != -84 && fi != -86 && fi != -87 { scalar_ty = 0 }
    mut key := -1
    if scalar_ty != 0 { key = f.lower_expr(p, c, p.nodes[n].b) } else {
        key = f.lower_native_map_key(p, c, p.nodes[n].b, mut &key_hold)
    }
    if fi == -84 {
        dest = f.new_temp(2, 1)
        kind = 87
        sval = "_rt_map_has"
    }
    if fi == -86 {
        kind = 89
        sval = "_rt_map_delete"
    }
    if fi == -88 {
        dest = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
        kind = 90
        sval = "_rt_map_take"
    }
    if fi == -87 {
        dest = f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
        kind = 91
        sval = "_rt_map_get_or"
        defn := p.nodes[p.nodes[n].b].next
        mut defv := -1
        if scalar_ty != 0 { defv = f.lower_expr(p, c, defn) } else {
            defv = f.lower_pointer_arg(p, c, defn)
        }
        f.mark_move_of(p, c, defn)
        mi0 := f.margs.len
        f.margs.push(MArg{v: handle, next: -1})
        mi1 := f.margs.len
        f.margs.push(MArg{v: key, next: -1})
        mi2 := f.margs.len
        f.margs.push(MArg{v: defv, next: -1})
        mut p0 := f.margs[mi0]
        p0.next = mi1
        f.margs[mi0] = p0
        mut p1 := f.margs[mi1]
        p1.next = mi2
        f.margs[mi1] = p1
        mut ins := mkinstr(MI_CALL)
        ins.a = dest
        ins.b = kind
        ins.d = scalar_ty
        ins.c = mi0
        ins.sval = sval
        f.emit(ins)
        f.drop_native_map_key(key_hold)
        << dest
    }
    mi0 := f.margs.len
    f.margs.push(MArg{v: handle, next: -1})
    mi1 := f.margs.len
    f.margs.push(MArg{v: key, next: -1})
    mut prev := f.margs[mi0]
    prev.next = mi1
    f.margs[mi0] = prev
    mut ins := mkinstr(MI_CALL)
    ins.a = dest
    ins.b = kind
    ins.d = scalar_ty
    ins.c = mi0
    ins.sval = sval
    f.emit(ins)
    f.drop_native_map_key(key_hold)
    << dest
}

fn (f &mut MFn) lower_map_elem_addr(p &parser.Parser, c &mut Checker, n int) int {
    mut cur := n
    while cur >= 0 && p.nodes[cur].kind == ast.NK_FIELD {
        cur = p.nodes[cur].a
    }
    handle := f.lower_map_handle(p, c, p.nodes[cur].a)
    mut key_hold := -1
    key := f.lower_native_map_key(p, c, p.nodes[cur].b, mut &key_hold)
    dest := f.new_temp(1, 1)
    mi0 := f.margs.len
    f.margs.push(MArg{v: handle, next: -1})
    mi1 := f.margs.len
    f.margs.push(MArg{v: key, next: -1})
    mut prev := f.margs[mi0]
    prev.next = mi1
    f.margs[mi0] = prev
    mut ins := mkinstr(MI_CALL)
    ins.a = dest
    ins.b = 98
    ins.c = mi0
    ins.sval = "_rt_map_val_ptr"
    f.emit(ins)
    f.drop_native_map_key(key_hold)
    << dest
}

fn (f &mut MFn) lower_map_handle(p &parser.Parser, c &mut Checker, n int) int {
    raw := c.ntype[n]
    v := f.lower_expr(p, c, n)
    if is_ref_type(raw) {
        h := f.new_temp(1, 1)
        mut lp := mkinstr(MI_LOAD_PTR)
        lp.a = h
        lp.b = v
        lp.c = 0
        lp.d = 1
        f.emit(lp)
        << h
    }
    << v
}

fn (f &mut MFn) lower_map_init(p &parser.Parser, c &mut Checker, n int) int {
    if c.ncall[n] != -89 {
        fi := c.ncall[n]
        dest := f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
        mut ins := mkinstr(MI_CALL)
        ins.a = dest
        ins.b = 1
        ins.sval = c.fns[fi].label
        ins.c = -1
        f.emit(ins)
        << dest
    }
    ty := c.ntype[n]
    mi := map_index(ty)
    dest := f.new_temp(ty, 1)
    mut cap_arg := -1
    if p.nodes[n].c >= 0 {
        cap_val := f.lower_expr(p, c, p.nodes[n].c)
        cap_arg = f.margs.len
        f.margs.push(MArg{v: cap_val, next: -1})
    }
    mut ins := mkinstr(MI_CALL)
    ins.a = dest
    ins.b = 84
    // Packed as emit_instr_call_map reads: kkind, vkind<<8, vslots<<16.
    // Dropping vslots left header@64 = 0, so n-slot copy_in/out only moved word 0
    // (Point.y garbage; Item.s empty; []T len/cap lost).
    ins.d = c.maps[mi].kkind + (c.maps[mi].vkind << 8) + (c.maps[mi].vslots << 16)
    ins.sval = "_rt_map_new"
    ins.c = cap_arg
    f.emit(ins)
    << dest
}

// Scalar native-map ABI is encoded by the exact map type in Call.d.
// Keep other key/value types on descriptor-pointer ABI, including owners.
fn (c &Checker) native_map_scalar_type(receiver int) int {
    mut ty := c.ntype[receiver]
    if is_ref_type(ty) { ty = c.ref_inner_type(ty) }
    mi := map_index(ty)
    if mi < 0 || mi >= c.maps.len { << 0 }
    if c.maps[mi].key_ty != 1 || c.maps[mi].val_ty != 1 { << 0 }
    if c.maps[mi].kkind != 0 || c.maps[mi].vkind != 0 || c.maps[mi].vslots != 1 { << 0 }
    << ty
}

fn (f &mut MFn) lower_native_map_get(p &parser.Parser, c &mut Checker, n int) int {
    handle := f.lower_map_handle(p, c, p.nodes[n].a)
    mut key_hold := -1
    scalar_ty := c.native_map_scalar_type(p.nodes[n].a)
    mut key := -1
    if scalar_ty != 0 { key = f.lower_expr(p, c, p.nodes[n].b) } else {
        key = f.lower_native_map_key(p, c, p.nodes[n].b, mut &key_hold)
    }
    dest := f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    mi0 := f.margs.len
    f.margs.push(MArg{v: handle, next: -1})
    mi1 := f.margs.len
    f.margs.push(MArg{v: key, next: -1})
    mut prev := f.margs[mi0]
    prev.next = mi1
    f.margs[mi0] = prev
    mut ins := mkinstr(MI_CALL)
    ins.a = dest
    ins.b = 85
    ins.d = scalar_ty
    ins.c = mi0
    ins.sval = "_rt_map_get"
    f.emit(ins)
    f.drop_native_map_key(key_hold)
    << dest
}

fn (f &mut MFn) lower_map_get(p &parser.Parser, c &mut Checker, n int, fi int) int {
    if c.ncall[n] == -77 {
        << f.lower_native_map_get(p, c, n)
    }
    recv := f.lower_pointer_arg(p, c, p.nodes[n].a)
    key := f.lower_pointer_arg(p, c, p.nodes[n].b)
    dest := f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    mut ins := mkinstr(MI_CALL)
    ins.a = dest
    ins.b = 1
    ins.sval = c.fns[fi].label
    mi0 := f.margs.len
    f.margs.push(MArg{v: recv, next: -1})
    mi1 := f.margs.len
    f.margs.push(MArg{v: key, next: -1})
    mut prev := f.margs[mi0]
    prev.next = mi1
    f.margs[mi0] = prev
    ins.c = mi0
    f.emit(ins)
    << dest
}

fn (f &mut MFn) lower_map_set(p &parser.Parser, c &mut Checker, n int) {
    t := p.nodes[n].a
    if c.ncall[t] == -78 {
        handle := f.lower_map_handle(p, c, p.nodes[t].a)
        key_node := p.nodes[t].b
        mut key_hold := -1
        scalar_ty := c.native_map_scalar_type(p.nodes[t].a)
        mut key := -1
        if scalar_ty != 0 { key = f.lower_expr(p, c, key_node) } else {
            key = f.lower_native_map_key(p, c, key_node, mut &key_hold)
        }
        val_node := p.nodes[n].b
        mut val := -1
        mut val_hold := -1
        if scalar_ty != 0 {
            val = f.lower_expr(p, c, val_node)
        } else if c.ntype[val_node] == 3 && f.fresh_string_expr(p, c, val_node) {
            // copy_in_val shallow-copies the descriptor; map becomes the owner.
            // Hold then mark moved — do not Drop after insert (double free).
            vv := f.lower_expr(p, c, val_node)
            val_hold = f.new_local(3, 3, true)
            mut stv := mkinstr(MI_STORE_LOCAL)
            stv.a = val_hold
            stv.b = vv
            f.emit(stv)
            val = f.new_temp(1, 1)
            mut adv := mkinstr(MI_ADDR)
            adv.a = val
            adv.b = val_hold
            adv.c = 0
            f.emit(adv)
        } else {
            val = f.lower_pointer_arg(p, c, val_node)
        }
        f.mark_move_of(p, c, val_node)
        if val_hold >= 0 {
            f.moved[val_hold] = true
        }
        mi0 := f.margs.len
        f.margs.push(MArg{v: handle, next: -1})
        mi1 := f.margs.len
        f.margs.push(MArg{v: key, next: -1})
        mi2 := f.margs.len
        f.margs.push(MArg{v: val, next: -1})
        mut p0 := f.margs[mi0]
        p0.next = mi1
        f.margs[mi0] = p0
        mut p1 := f.margs[mi1]
        p1.next = mi2
        f.margs[mi1] = p1
        mut ins := mkinstr(MI_CALL)
        ins.a = -1
        ins.b = 86
        ins.d = scalar_ty
        ins.c = mi0
        ins.sval = "_rt_map_insert"
        f.emit(ins)
        f.drop_native_map_key(key_hold)
        <<
    }
    fi := c.ncall[t]
    recv := f.lower_pointer_arg(p, c, p.nodes[t].a)
    key := f.lower_pointer_arg(p, c, p.nodes[t].b)
    mut val := -1
    if mir_abi_by_pointer(c.ntype[p.nodes[n].b]) {
        val = f.lower_pointer_arg(p, c, p.nodes[n].b)
    } else {
        val = f.lower_expr(p, c, p.nodes[n].b)
        f.mark_move_of(p, c, p.nodes[n].b)
    }
    mut ins := mkinstr(MI_CALL)
    ins.a = -1
    ins.b = 1
    ins.sval = c.fns[fi].label
    mi0 := f.margs.len
    f.margs.push(MArg{v: recv, next: -1})
    mi1 := f.margs.len
    f.margs.push(MArg{v: key, next: -1})
    mi2 := f.margs.len
    f.margs.push(MArg{v: val, next: -1})
    mut p0 := f.margs[mi0]
    p0.next = mi1
    f.margs[mi0] = p0
    mut p1 := f.margs[mi1]
    p1.next = mi2
    f.margs[mi1] = p1
    ins.c = mi0
    f.emit(ins)
}

fn (f &mut MFn) lower_map_foreach(p &parser.Parser, c &mut Checker, n int) {
    kid := c.nlocal[n]
    vid := c.nconst[n]
    handle := f.lower_map_handle(p, c, p.nodes[n].a)
    raw := c.ntype[p.nodes[n].a]
    mt := c.peel_map(raw)
    kty := c.maps[map_index(mt)].key_ty
    vty := c.maps[map_index(mt)].val_ty
    slot := f.new_temp(1, 1)
    mut iz := mkinstr(MI_COPY)
    iz.a = slot
    iz.b = f.vconst(0)
    f.emit(iz)
    kt := f.new_temp(kty, c.type_slots(kty))
    vt := f.new_temp(vty, c.type_slots(vty))
    found := f.new_temp(1, 1)
    f.push_scope()
    f.scope_add(kid)
    f.scope_add(vid)
    // Zero iterator locals so the first body rebind-drop is a no-op (cap=0)
    // instead of freeing frame garbage (unknown pointer / SIGSEGV).
    if kid >= 0 && kid < f.locals.len && f.locals_nslots[kid] > 0 {
        f.zero_field_slots(kid, 0, f.locals_nslots[kid])
    }
    if vid >= 0 && vid < f.locals.len && f.locals_nslots[vid] > 0 {
        f.zero_field_slots(vid, 0, f.locals_nslots[vid])
    }

    cond_bb := f.new_block()
    body_bb := f.new_block()
    cont_bb := f.new_block()
    end_bb := f.new_block()
    f.terminate(1, cond_bb, -1, -1)

    f.switch_to(cond_bb)
    mi0 := f.margs.len
    f.margs.push(MArg{v: handle, next: -1})
    mi1 := f.margs.len
    f.margs.push(MArg{v: slot, next: -1})
    mi2 := f.margs.len
    f.margs.push(MArg{v: kt, next: -1})
    mi3 := f.margs.len
    f.margs.push(MArg{v: vt, next: -1})
    mut a0 := f.margs[mi0]
    a0.next = mi1
    f.margs[mi0] = a0
    mut a1 := f.margs[mi1]
    a1.next = mi2
    f.margs[mi1] = a1
    mut a2 := f.margs[mi2]
    a2.next = mi3
    f.margs[mi2] = a2
    mut call := mkinstr(MI_CALL)
    call.a = found
    call.b = 92
    call.c = mi0
    call.sval = "_rt_map_iter_next"
    f.emit(call)
    ge := f.new_temp(2, 1)
    mut cmp := mkinstr(MI_BIN)
    cmp.a = ge
    cmp.b = 11 // Ge
    cmp.c = found
    cmp.d = f.vconst(0)
    f.emit(cmp)
    f.terminate(2, ge, body_bb, end_bb)

    f.switch_to(body_bb)
    // Map entries and body-local declarations have iteration lifetime.  Keep
    // this scope distinct from the iterator key/value bindings; Gen1's
    // conservative scope-drop policy can then reclaim scalar strings here.
    body_scope_depth := f.scopes.len
    f.push_scope()
    f.push_loop(end_bb, cont_bb, body_scope_depth)
    // iter_next clones string key/value into kt/vt each step. Rebind-drop the
    // owning loop locals before overwrite; otherwise only the last pair is
    // dropped at loop end (ledger leftover vs bootstrap).
    if kid >= 0 && kid < f.locals_owning.len && kid < f.locals.len && f.locals_owning[kid] && !f.moved[kid] {
        kty2 := f.locals[kid]
        if kty2 == 3 || is_struct_type(kty2) || is_array_type(kty2) {
            mut dk := mkinstr(MI_DROP)
            dk.a = kid
            f.emit(dk)
        }
    }
    if vid >= 0 && vid < f.locals_owning.len && vid < f.locals.len && f.locals_owning[vid] && !f.moved[vid] {
        vty2 := f.locals[vid]
        if vty2 == 3 || is_struct_type(vty2) || is_array_type(vty2) {
            mut dv := mkinstr(MI_DROP)
            dv.a = vid
            f.emit(dv)
        }
    }
    mut sk := mkinstr(MI_STORE_LOCAL)
    sk.a = kid
    sk.b = kt
    f.emit(sk)
    mut sv := mkinstr(MI_STORE_LOCAL)
    sv.a = vid
    sv.b = vt
    f.emit(sv)
    f.moved[kid] = false
    f.moved[vid] = false
    mut s := p.nodes[n].c
    while s >= 0 {
        f.lower_stmt(p, c, s)
        s = p.nodes[s].next
    }
    f.pop_scope_with_drops()
    if f.live_and_open() {
        f.terminate(1, cont_bb, -1, -1)
    }
    f.pop_loop()

    f.switch_to(cont_bb)
    next := f.new_temp(1, 1)
    mut inc := mkinstr(MI_BIN)
    inc.a = next
    inc.b = 1
    inc.c = found
    inc.d = f.vconst(1)
    f.emit(inc)
    mut cp := mkinstr(MI_COPY)
    cp.a = slot
    cp.b = next
    f.emit(cp)
    f.terminate(1, cond_bb, -1, -1)

    f.switch_to(end_bb)
    f.pop_scope_with_drops()
}

// Lower all concrete functions. Generic templates are skipped; monomorphized
// instances re-check their template body first (shared AST annotations).
