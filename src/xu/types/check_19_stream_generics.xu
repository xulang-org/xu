@xu/types

// Symbolic signatures are checked at the definition site, never emitted.
// A type argument may contain parameters inside a generic aggregate.
fn (c &Checker) generic_arg_symbolic(ty int) bool {
    if is_param_type(ty) { << true }
    if is_ref_type(ty) { << c.generic_arg_symbolic(c.ref_inner_type(ty)) }
    if is_array_type(ty) { << c.generic_arg_symbolic(c.arrays[ty - 200].elem_ty) }
    if is_chan_type(ty) { << c.generic_arg_symbolic(c.chans[ty - 600].elem_ty) }
    if is_map_type(ty) {
        << c.generic_arg_symbolic(c.maps[ty - 50].key_ty) || c.generic_arg_symbolic(c.maps[ty - 50].val_ty)
    }
    if is_fn_type(ty) {
        si := ty - 700
        if c.generic_arg_symbolic(c.fn_sigs[si].ret) { << true }
        for i in 0:c.fn_sigs[si].params.len {
            if c.generic_arg_symbolic(c.fn_sigs[si].params[i]) { << true }
        }
    }
    if is_enum_type(ty) {
        ei := ty - 500
        for i in 0:c.enums[ei].args.len {
            if c.generic_arg_symbolic(c.enums[ei].args[i]) { << true }
        }
    }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < c.sargs.len {
            for i in 0:c.sargs[si].len {
                if c.generic_arg_symbolic(c.sargs[si][i]) { << true }
            }
        }
    }
    << false
}
