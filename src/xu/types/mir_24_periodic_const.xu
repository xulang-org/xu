@xu/types

// Exact integer prefix for the low bits, including negative starting points.
// Requires mir_iand_periodic_mask(mask), which bounds the triangle below 2^32.
// Larger products and prefix differences use the loop's wrapping arithmetic.
pub fn mir_iand_periodic_prefix(x int, mask int) int {
    $bits := 0
    $period := mask + 1
    while period > 1 {
        period = period >> 1
        bits += 1
    }
    tail := x & mask
    cycle := mask * (mask + 1) / 2
    << (x >> bits) * cycle + tail * (tail - 1) / 2
}

fn mir_iand_constant_block(f $&MFn, bi int, s MirIandSsa) {
    delta := mir_iand_periodic_prefix(s.limit, s.mask) - mir_iand_periodic_prefix(s.init, s.mask) + s.bias * (s.limit - s.init)
    amount := mir_cfg_const(f, delta)
    limit := mir_cfg_const(f, s.limit)
    $block := f.blocks[bi]
    block.head = -1
    block.tail = -1
    block.tkind = 1
    block.ta = s.exit
    block.tb = -1
    block.tc = -1
    mfn_set_block($&f.blocks, bi, block)
    $sum := mkinstr(MI_BIN)
    sum.a = s.s_next
    sum.b = 1
    sum.c = s.s_phi
    sum.d = amount
    sum.line = block.line
    mir_cfg_append(f, bi, sum)
    $index := mkinstr(MI_COPY)
    index.a = s.i_next
    index.b = limit
    index.line = block.line
    mir_cfg_append(f, bi, index)
}

// Called for ARM64 after phi destruction, before frame/register planning.
// Reuse the complete emitter proof; every external entry must additionally
// provide the same constant induction. Unknown/differing starts keep the
// runtime periodic path. Only loop results may escape the removed body.
pub fn mir_fold_iand_constant_entries(m $&Mir) {
    if m.opt_level < 1 { << }
    n0 := m.fns.len
    for fi in 0:n0 {
        if mir_fn_is_extern(&*m, fi) { -> }
        nb := mir_nblocks(&*m, fi)
        if nb < 2 || nb > 64 || mir_ntemps(&*m, fi) > 512 || mir_nins(&*m, fi) > 512 { -> }
        $blocks := []int{}
        $proofs := []MirIandSsa{}
        for bi in 0:nb {
            if mir_btkind(&*m, fi, bi) != 2 { -> }
            s := mir_iand_ssa_match(&*m, fi, bi)
            if !s.ok || s.mul || !s.init_known || !mir_iand_periodic_mask(s.mask) { -> }
            blocks.push(bi)
            proofs.push(s)
        }
        if blocks.len == 0 { -> }
        $f := mir_clone_fn(m, fi, true)
        for p in 0:blocks.len { mir_iand_constant_block($&f, blocks[p], proofs[p]) }
        mir_zap_unreachable($&f)
        mir_copy_prop_fn($&f)
        mir_simplify_cfg($&f)
        mir_dce_pure($&f)
        if mir_verify_mfn_f(&f, false) != 0 { -> }
        mir_fn_commit(m, fi, f)
    }
    mir_sweep_superseded(m)
    $nins := 0
    for fi in 0:m.fns.len {
        if !mir_fn_is_extern(&*m, fi) { nins += mir_nins(&*m, fi) }
    }
    m.opt_nins_out = nins
}
