@xu/types

// TypeId is an opaque kind/index handle. Metadata lives in the matching
// Checker/Mir table, including reference targets. The shared resource budget
// bounds allocations; it is independent of the encoding's payload capacity.
pub const TYPE_TABLE_LIMIT = 1000000
const TYPE_KIND_BITS = 8
const TYPE_KIND_MASK = 255
pub const TYPE_KIND_MAP = 16
pub const TYPE_KIND_STRUCT = 17
pub const TYPE_KIND_ARRAY = 18
pub const TYPE_KIND_THROW = 19
pub const TYPE_KIND_PARAM = 20
pub const TYPE_KIND_ENUM = 21
pub const TYPE_KIND_CHAN = 22
pub const TYPE_KIND_FN = 23
pub const TYPE_KIND_INTERFACE = 24
pub const TYPE_KIND_SHARED_REF = 25
pub const TYPE_KIND_MUT_REF = 26
pub const TYPE_KIND_NESTED_REF = 27
pub const TYPE_KIND_MUT_NESTED_REF = 28


const TEMP_TY = 800
const ANY_TY = 801
const ERROR_TY = 802

pub fn type_kind(t int) int {
    if t >= 0 && t <= 10 { << 0 }
    if t == TEMP_TY || t == ANY_TY || t == ERROR_TY { << t }
    if t < 0 || (t >> TYPE_KIND_BITS) >= TYPE_TABLE_LIMIT { << -1 }
    kind := t & TYPE_KIND_MASK
    if kind < TYPE_KIND_MAP || kind > TYPE_KIND_MUT_NESTED_REF { << -1 }
    << kind
}

pub fn type_index(t int) int {
    kind := type_kind(t)
    if kind < TYPE_KIND_MAP || kind > TYPE_KIND_MUT_NESTED_REF { << -1 }
    << t >> TYPE_KIND_BITS
}

fn make_type_id(kind int, index int) int {
    if index < 0 || index >= TYPE_TABLE_LIMIT { << -1 }
    << (index << TYPE_KIND_BITS) | kind
}

pub fn map_type(index int) int { << make_type_id(TYPE_KIND_MAP, index) }
pub fn map_index(t int) int {
    if !is_map_type(t) { << -1 }
    << type_index(t)
}
pub fn is_map_type(t int) bool { << type_kind(t) == TYPE_KIND_MAP }

pub fn struct_type(index int) int { << make_type_id(TYPE_KIND_STRUCT, index) }
pub fn struct_index(t int) int {
    if !is_struct_type(t) { << -1 }
    << type_index(t)
}
pub fn is_struct_type(t int) bool { << type_kind(t) == TYPE_KIND_STRUCT }

pub fn array_type(index int) int { << make_type_id(TYPE_KIND_ARRAY, index) }
pub fn array_index(t int) int {
    if !is_array_type(t) { << -1 }
    << type_index(t)
}
pub fn is_array_type(t int) bool { << type_kind(t) == TYPE_KIND_ARRAY }

pub fn throw_type(index int) int { << make_type_id(TYPE_KIND_THROW, index) }
pub fn throw_index(t int) int {
    if !is_throw_type(t) { << -1 }
    << type_index(t)
}
pub fn is_throw_type(t int) bool { << type_kind(t) == TYPE_KIND_THROW }

pub fn param_type(index int) int { << make_type_id(TYPE_KIND_PARAM, index) }
pub fn param_index(t int) int {
    if !is_param_type(t) { << -1 }
    << type_index(t)
}
pub fn is_param_type(t int) bool { << type_kind(t) == TYPE_KIND_PARAM }

pub fn enum_type(index int) int { << make_type_id(TYPE_KIND_ENUM, index) }
pub fn enum_index(t int) int {
    if !is_enum_type(t) { << -1 }
    << type_index(t)
}
pub fn is_enum_type(t int) bool { << type_kind(t) == TYPE_KIND_ENUM }

pub fn chan_type(index int) int { << make_type_id(TYPE_KIND_CHAN, index) }
pub fn chan_index(t int) int {
    if !is_chan_type(t) { << -1 }
    << type_index(t)
}
pub fn is_chan_type(t int) bool { << type_kind(t) == TYPE_KIND_CHAN }

pub fn fn_type(index int) int { << make_type_id(TYPE_KIND_FN, index) }
pub fn fn_index(t int) int {
    if !is_fn_type(t) { << -1 }
    << type_index(t)
}
pub fn is_fn_type(t int) bool { << type_kind(t) == TYPE_KIND_FN }

pub fn interface_type(index int) int { << make_type_id(TYPE_KIND_INTERFACE, index) }
pub fn interface_index(t int) int {
    if !is_interface_type(t) { << -1 }
    << type_index(t)
}
pub fn is_interface_type(t int) bool { << type_kind(t) == TYPE_KIND_INTERFACE }

pub fn is_temp_type(t int) bool { << t == TEMP_TY }
pub fn is_any_type(t int) bool { << t == ANY_TY }
pub fn is_error_type(t int) bool { << t == ERROR_TY }
pub fn is_box_type_encoding(t int) bool {
    << is_temp_type(t) || is_any_type(t) || is_error_type(t) || is_interface_type(t)
}
pub fn is_ref_type(t int) bool {
    kind := type_kind(t)
    << kind >= TYPE_KIND_SHARED_REF && kind <= TYPE_KIND_MUT_NESTED_REF
}
pub fn is_direct_ref_type(t int) bool {
    << is_shared_direct_ref_type(t) || is_mut_direct_ref_type(t)
}
pub fn is_shared_direct_ref_type(t int) bool { << type_kind(t) == TYPE_KIND_SHARED_REF }
pub fn is_mut_direct_ref_type(t int) bool { << type_kind(t) == TYPE_KIND_MUT_REF }
pub fn is_indirect_ref_type(t int) bool {
    kind := type_kind(t)
    << kind == TYPE_KIND_NESTED_REF || kind == TYPE_KIND_MUT_NESTED_REF
}
pub fn is_mut_ref_type(t int) bool {
    kind := type_kind(t)
    << kind == TYPE_KIND_MUT_REF || kind == TYPE_KIND_MUT_NESTED_REF
}

// The payload is always a reference-table index, never a pointee TypeId.
pub fn reference_type(mutable bool, nested bool, index int) int {
    mut kind := TYPE_KIND_SHARED_REF
    if mutable { kind = TYPE_KIND_MUT_REF }
    if nested {
        kind = TYPE_KIND_NESTED_REF
        if mutable { kind = TYPE_KIND_MUT_NESTED_REF }
    }
    << make_type_id(kind, index)
}

pub fn ref_inner_type_at(payloads &[]int, t int) int {
    if !is_ref_type(t) { << t }
    index := type_index(t)
    if index < 0 || index >= payloads.len { << -1 }
    << payloads[index]
}

pub fn direct_ref_inner(payloads &[]int, t int) int {
    if !is_direct_ref_type(t) { << -1 }
    << ref_inner_type_at(payloads, t)
}

pub fn strip_direct_ref(payloads &[]int, t int) int {
    if is_direct_ref_type(t) { << direct_ref_inner(payloads, t) }
    << t
}
