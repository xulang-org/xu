@xu/types

// Per-caller budget for const/scalar/rmw leaf inlining. Unit-wide
// `nfn < 64` used to skip every user program that imported `#math`.
// Compiler helpers are far above this cap (thousands of instructions);
// user kernels with a large module stay inside it. CFG loop-leaf
// inlining keeps its own live-fn gate because that pass still
// miscompiles `time.date` / `unix_nano` on compiler-sized units.
fn mir_inline_caller_budget_ok(m &Mir, fi int) bool {
    if fi < 0 { << false }
    if mir_nblocks(m, fi) > 128 { << false }
    if mir_nins(m, fi) > 1024 { << false }
    << true
}

fn mir_inline_const_leaves(m $&Mir) {
    $labs := []string{}
    $vals := []int{}
    for i in 0:m.fns.len {
        // Inline leaf test (cannot move owning MFn out of m.fns).
        $ok := 1
        if mir_fn_is_extern(&*m, i) { ok = 0 }
        if m.fns[i].receiver { ok = 0 }
        if m.fns[i].nparams != 0 { ok = 0 }
        if m.fns[i].blocks.len == 0 { ok = 0 }
        if ok == 1 && m.fns[i].blocks[0].head >= 0 { ok = 0 }
        if ok == 1 && m.fns[i].blocks[0].tkind != 3 { ok = 0 }
        if ok == 1 && (starts_with(m.fns[i].label + "", "_xu_crypto_aes_aes_hw_") || starts_with(m.fns[i].label + "", "_xu_hash_crc32_crc32_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sha256_sha256_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sha512_sha512_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sha1_sha1_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sm4_sm4_hw_") || starts_with(m.fns[i].label + "", "_xu_math_math_hw_") || starts_with(m.fns[i].label + "", "_xu_tile_tile_hw_") || starts_with(m.fns[i].label + "", "_xu_encoding_hex_hex_hw_") || starts_with(m.fns[i].label + "", "_xu_encoding_base64_base64_hw_") || starts_with(m.fns[i].label + "", "_xu_strings_storage_")) { ok = 0 }
        $ta := -1
        if ok == 1 {
            ta = m.fns[i].blocks[0].ta
            if ta > -2 { ok = 0 }
        }
        if ok == 1 {
            for bi in 1:m.fns[i].blocks.len {
                if m.fns[i].blocks[bi].head >= 0 { ok = 0 }
            }
        }
        if ok == 1 && ta <= -2 {
            cidx := 0 - ta - 2
            if cidx >= 0 && cidx < m.fns[i].consts.len {
                labs.push(m.fns[i].label + "")
                vals.push(m.fns[i].consts[cidx])
            }
        }
    }
    if labs.len == 0 { << }
    n0 := m.fns.len
    for fi in 0:n0 {
        if mir_fn_is_extern(&*m, fi) { -> }
        if !mir_inline_caller_budget_ok(&*m, fi) { -> }
        $f := mir_clone_fn(m, fi, false)
        $changed := false
        $inlined := 0
        nins := f.instrs.len
        for ii in 0:nins {
            if mfn_ikind(&f.instrs, ii) != MI_CALL { -> }
            if mfn_ib(&f.instrs, ii) != 1 { -> }
            if mfn_ia(&f.instrs, ii) < 0 { -> }
            $hit := -1
            sval := mfn_isval(&f.instrs, ii)
            for li in 0:labs.len {
                if labs[li] == sval {
                    hit = li
                }
            }
            if hit < 0 { -> }
            // Cannot grow consts in place. Reuse an existing pool entry.
            $cidx := -1
            for k in 0:f.consts.len {
                if mfn_get_i(&f.consts, k) == vals[hit] {
                    cidx = k
                }
            }
            if cidx < 0 { -> }
            nv := 0 - cidx - 2
            mfn_become_copy($&f.instrs, ii, nv)
            changed = true
            inlined += 1
        }
        if !changed { -> }
        if mir_fn_commit(m, fi, f) >= 0 {
            m.opt_inline_ok += inlined
        }
    }
}

// Inlining a proven fn-value target can leave its descriptor address dead.
// AddrOfLocal is a pure frame-address calculation; remove only fn-typed
// materializations with one definition and no live instruction/edge use.
// Keep allocation, closure construction, owning copies and drops in place.
fn mir_inline_drop_dead_fnval_addresses(f $&MFn) {
    $defs := []int{}
    mir_count_temp_defs(&*f, $&defs)
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            next := mfn_inext(&f.instrs, ii)
            if mfn_ikind(&f.instrs, ii) == MI_ADDR {
                if mfn_ic(&f.instrs, ii) == 0 {
                    loc := mfn_ib(&f.instrs, ii)
                    dest := mfn_ia(&f.instrs, ii)
                    if loc >= 0 && loc < f.locals.len && is_fn_type(f.locals[loc]) {
                        if dest >= 0 && dest < defs.len && dest < f.temps_nslots.len && f.temps_nslots[dest] == 1 && defs[dest] == 1 && !f.temp_is_used(dest) {
                            mir_delete_instr(f, bi, ii)
                        }
                    }
                }
            }
            ii = next
        }
    }
}

fn mir_inline_scalar_leaves(m $&Mir) {
    $labs := []string{}
    $kinds := []int{}
    $ops := []int{}
    $cvals := []int{}
    $lis := []int{}
    $ris := []int{}
    $nps := []int{}
    for i in 0:m.fns.len {
        lf := mir_scalar_leaf(&*m, i)
        if lf.kind == 0 { -> }
        if starts_with(m.fns[i].label + "", "_xu_crypto_aes_aes_hw_") || starts_with(m.fns[i].label + "", "_xu_hash_crc32_crc32_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sha256_sha256_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sha512_sha512_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sha1_sha1_hw_") || starts_with(m.fns[i].label + "", "_xu_crypto_sm4_sm4_hw_") || starts_with(m.fns[i].label + "", "_xu_math_math_hw_") || starts_with(m.fns[i].label + "", "_xu_tile_tile_hw_") || starts_with(m.fns[i].label + "", "_xu_encoding_hex_hex_hw_") || starts_with(m.fns[i].label + "", "_xu_encoding_base64_base64_hw_") || starts_with(m.fns[i].label + "", "_xu_strings_storage_") { -> }
        labs.push(m.fns[i].label + "")
        kinds.push(lf.kind)
        ops.push(lf.op)
        cvals.push(lf.cval)
        lis.push(lf.li)
        ris.push(lf.ri)
        nps.push(m.fns[i].nparams)
    }
    if labs.len == 0 { << }
    n0 := m.fns.len
    for fi in 0:n0 {
        if mir_fn_is_extern(&*m, fi) { -> }
        if !mir_inline_caller_budget_ok(&*m, fi) { -> }
        $f := mir_clone_fn(m, fi, false)
        $changed := false
        $inlined := 0
        nins := f.instrs.len
        for ii in 0:nins {
            if mfn_ikind(&f.instrs, ii) != MI_CALL { -> }
            call_b := mfn_ib(&f.instrs, ii)
            if call_b != 1 && call_b != 80 { -> }
            if mfn_ia(&f.instrs, ii) < 0 { -> }
            $hit := -1
            $head := mfn_ic(&f.instrs, ii)
            if call_b == 80 {
                if head < 0 { -> }
                fat := mfn_marg_v(&f.margs, head)
                lab := mir_fnval_known_label(&*m, fi, mir_bi_of_ii(&*m, fi, ii), ii, fat)
                if lab.len == 0 { -> }
                for li in 0:labs.len {
                    if labs[li] == lab {
                        hit = li
                    }
                }
                head = mfn_marg_next(&f.margs, head)
            } else {
                sval := mfn_isval(&f.instrs, ii)
                for li in 0:labs.len {
                    if labs[li] == sval {
                        hit = li
                    }
                }
            }
            if hit < 0 { -> }
            $argc := 0
            $p := head
            while p >= 0 {
                argc += 1
                p = mfn_marg_next(&f.margs, p)
            }
            if argc != nps[hit] { -> }
            a0 := mir_call_arg(&f.margs, head, 0)
            knd := kinds[hit]
            if knd == 1 {
                mfn_become_copy($&f.instrs, ii, a0)
                changed = true
                inlined += 1
                ->
            }
            if knd == 2 {
                a1 := mir_call_arg(&f.margs, head, 1)
                $lhs := a0
                $rhs := a1
                if lis[hit] == 1 {
                    lhs = a1
                    rhs = a0
                }
                mfn_become_bin($&f.instrs, ii, ops[hit], lhs, rhs)
                changed = true
                inlined += 1
                ->
            }
            if knd == 3 {
                $cv := -1
                for k in 0:f.consts.len {
                    if mfn_get_i(&f.consts, k) == cvals[hit] {
                        cv = 0 - k - 2
                    }
                }
                if cv == -1 { -> }
                $lhs := a0
                $rhs := cv
                if lis[hit] == 1 {
                    lhs = cv
                    rhs = a0
                }
                mfn_become_bin($&f.instrs, ii, ops[hit], lhs, rhs)
                changed = true
                inlined += 1
                ->
            }
            if knd == 4 {
                mfn_become_un($&f.instrs, ii, ops[hit], a0)
                changed = true
                inlined += 1
            }
        }
        if !changed { -> }
        mir_inline_drop_dead_fnval_addresses($&f)
        if mir_fn_commit(m, fi, f) >= 0 {
            m.opt_inline_ok += inlined
        }
    }
}

// Wave 3b+: void mutable-method leaf that is just `recv.field op= arg`
// (LoadLocal recv; LoadPtr; LoadLocal arg; Bin; StorePtr). Inlining kills
// the call in method_sum-style hot loops without changing ABI for the
// standalone function (still emitted for address-taken / other callers).
fn mir_inline_rmw_leaves(m $&Mir) {
    $labs := []string{}
    $ops := []int{}
    $slots := []int{}
    for i in 0:m.fns.len {
        lf := mir_rmw_leaf(m, i)
        if lf.ok == 0 { -> }
        labs.push(m.fns[i].label + "")
        ops.push(lf.op)
        slots.push(lf.slot)
    }
    if labs.len == 0 { << }
    n0 := m.fns.len
    for fi in 0:n0 {
        if mir_fn_is_extern(&*m, fi) { -> }
        if !mir_inline_caller_budget_ok(&*m, fi) { -> }
        $f := mir_clone_fn(m, fi, false)
        $changed := false
        $inlined := 0
        nins := f.instrs.len
        for ii in 0:nins {
            if mfn_ikind(&f.instrs, ii) != MI_CALL { -> }
            if mfn_ib(&f.instrs, ii) != 1 { -> }
            // Void call only (ExprStmt / statement position).
            if mfn_ia(&f.instrs, ii) >= 0 { -> }
            $hit := -1
            sval := mfn_isval(&f.instrs, ii)
            for li in 0:labs.len {
                if labs[li] == sval {
                    hit = li
                }
            }
            if hit < 0 { -> }
            head := mfn_ic(&f.instrs, ii)
            $argc := 0
            $p := head
            while p >= 0 {
                argc += 1
                p = mfn_marg_next(&f.margs, p)
            }
            if argc != 2 { -> }
            // Clone+append commit: Call → target 95 (field RMW).
            // d = slot*64 + op (op < 64; slot is field byte offset).
            mfn_become_call_field_rmw($&f.instrs, ii, slots[hit] * 64 + ops[hit])
            changed = true
            inlined += 1
        }
        if !changed { -> }
        if mir_fn_commit(m, fi, f) >= 0 {
            m.opt_inline_ok += inlined
        }
    }
}

// A loop leaf is only profitable when the caller can still be admitted to
// the scalar fixed-home register tier after the clone. Inlining a counted
// loop into a caller that also owns channels, aggregate memory, drops, or
// other calls makes the caller a mixed-MIR function; the conservative vreg
// planner must then fall back to frame slots for *all* of its scalar temps.
// That is a particularly bad trade (a 20M-iteration helper becomes a stack
// load/store loop). Treat the non-scalar operations as an LLVM-style memory
// barrier for this loop-inline decision and keep the helper as a separate
// call. The helper itself remains fully promotable and receives fixed homes.
// This is a profitability gate only: it never changes legality or ownership.
fn mir_cfg_caller_loop_inline_safe(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len { << false }
    $f := mir_cfg_clone_fn(m, fi, false)
    $reachable := []bool{}
    mir_cfg_mark_reachable_f(&f, $&reachable)
    for bi in 0:f.blocks.len {
        if !reachable[bi] { -> }
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            // Only the pure scalar MIR window is allowed around an inlined
            // loop. Calls and all memory/ownership opcodes are barriers;
            // rejecting them keeps the fixed-home allocator's whole-function
            // clobber proof intact instead of relying on a partial alias
            // analysis.
            k := mfn_ikind(&f.instrs, ii)
            if k != MI_NOP && k != MI_COPY && k != MI_LOAD_LOCAL && k != MI_STORE_LOCAL && k != MI_BIN && k != MI_UN {
                << false
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << true
}

fn mir_cfg_has_loop(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len { << false }
    $f := mir_cfg_clone_fn(m, fi, false)
    for bi in 0:f.blocks.len {
        tk := f.blocks[bi].tkind
        if tk == 1 && f.blocks[bi].ta >= 0 && f.blocks[bi].ta <= bi && mir_cfg_can_reach_target(&f, f.blocks[bi].ta, bi) { << true }
        if tk == 2 {
            if f.blocks[bi].tb >= 0 && f.blocks[bi].tb <= bi && mir_cfg_can_reach_target(&f, f.blocks[bi].tb, bi) { << true }
            if f.blocks[bi].tc >= 0 && f.blocks[bi].tc <= bi && mir_cfg_can_reach_target(&f, f.blocks[bi].tc, bi) { << true }
        }
    }
    << false
}

// A scalar helper can have a cheap register body while its mixed caller is
// still frame-backed. At O3, cloning the helper into a loop in that caller
// increases spill traffic on every iteration. Bound the added scalar/frame
// words before cloning; this is independent of module or function names.
fn mir_inline_frame_growth_ok(m &Mir, caller &MFn, cfi int) bool {
    if m.opt_level < 3 { << true }
    $memory_body := caller.ret_nslots > 1
    for t in 0:caller.temps.len {
        if caller.temps_nslots[t] != 1 || !mir_scalar_ty(caller.temps[t]) { memory_body = true }
    }
    if !memory_body { << true }
    $loop := false
    $scalar_words := 0
    for bi in 0:caller.blocks.len {
        tk := caller.blocks[bi].tkind
        if tk == 1 && caller.blocks[bi].ta <= bi { loop = true }
        if tk == 2 && (caller.blocks[bi].tb <= bi || caller.blocks[bi].tc <= bi) { loop = true }
    }
    if !loop { << true }
    for t in 0:caller.temps.len {
        if caller.temps_nslots[t] == 1 && mir_scalar_ty(caller.temps[t]) { scalar_words += 1 }
    }
    $added := 0
    for t in 0:mir_ntemps(m, cfi) { added += mir_temp_nslots(m, cfi, t) }
    for l in 0:mir_nlocals(m, cfi) { added += mir_local_nslots(m, cfi, l) }
    if added <= 8 { << true }
    << scalar_words + added <= 128
}

// O3c: small call-free CFG inlining, selected by MIR legality/cost rather
// than package or function name.  Parameters/locals are cloned into fresh
// caller locals, temps into fresh caller temps, and every callee return joins
// a continuation block that owns the original post-call instructions.
// Deep-copy one MFn by pushing elements into fresh slices. Used to snapshot
// a callee while the caller is the in-place local root (`$&m.fns[fi]`).
fn mir_inline_cfg_apply(f $&MFn, callee &MFn, reachable &[]bool, dest int, args &[]int, bi int, ii int) {
    $cmap := []int{}
    for ci in 0:callee.consts.len {
        cv := callee.consts[ci]
        cmap.push(mir_cfg_const(f, cv))
    }

    local_base := f.locals.len
    temp_base := f.temps.len
    block_base := f.blocks.len
    ncb := callee.blocks.len
    cont_bi := block_base + ncb

    for i in 0:callee.locals.len {
        ty := callee.locals[i]
        ns := callee.locals_nslots[i]
        mir_cfg_add_local(f, ty, ns)
    }
    for i in 0:callee.temps.len {
        ty := callee.temps[i]
        ns := callee.temps_nslots[i]
        mir_cfg_add_temp(f, ty, ns)
    }

    old := MBlock{
        head: f.blocks[bi].head,
        tail: f.blocks[bi].tail,
        tkind: f.blocks[bi].tkind,
        ta: f.blocks[bi].ta,
        tb: f.blocks[bi].tb,
        tc: f.blocks[bi].tc,
        line: f.blocks[bi].line
    }
    $prev := -1
    $p := old.head
    for _ in 0:f.instrs.len {
        if p < 0 || p == ii { <- }
        prev = p
        p = f.instrs[p].next
    }
    suffix_head := f.instrs[ii].next
    $suffix_tail := old.tail
    if suffix_head < 0 { suffix_tail = -1 }
    // The callee replacement consumes this exact Call. Save the suffix
    // before deletion; its original records move to the continuation.
    mir_delete_instr(f, bi, ii)
    $prefix := old
    prefix.tail = prev
    prefix.tkind = 1
    prefix.ta = block_base
    prefix.tb = -1
    prefix.tc = -1
    if prev < 0 {
        prefix.head = -1
    } else {
        $pin := mkinstr(f.instrs[prev].kind)
        pin.a = f.instrs[prev].a
        pin.b = f.instrs[prev].b
        pin.c = f.instrs[prev].c
        pin.d = f.instrs[prev].d
        pin.sval = mfn_sval_clone_owned(&f.instrs, prev)
        pin.line = f.instrs[prev].line
        pin.col = f.instrs[prev].col
        pin.file = f.instrs[prev].file
        pin.next = -1
        mfn_set_instr($&f.instrs, prev, pin)
    }
    mfn_set_block($&f.blocks, bi, prefix)

    for cb in 0:ncb {
        srcb := callee.blocks[cb]
        $nb := MBlock{head: -1, tail: -1, tkind: srcb.tkind, ta: srcb.ta, tb: srcb.tb, tc: srcb.tc, line: srcb.line}
        if nb.tkind == 1 {
            nb.ta = block_base + nb.ta
        } else if nb.tkind == 2 {
            nb.ta = mir_cfg_value(nb.ta, temp_base, &cmap)
            nb.tb = block_base + nb.tb
            nb.tc = block_base + nb.tc
        } else if nb.tkind == 3 {
            nb.tkind = 1
            nb.ta = cont_bi
            nb.tb = -1
            nb.tc = -1
        }
        mir_cfg_add_block(f, nb)
    }
    mir_cfg_add_block(f, MBlock{head: suffix_head, tail: suffix_tail, tkind: old.tkind, ta: old.ta, tb: old.tb, tc: old.tc, line: old.line})

    for cb in 0:ncb {
        nbi := block_base + cb
        if cb == 0 {
            for ai in 0:args.len {
                $st := mkinstr(MI_STORE_LOCAL)
                st.a = local_base + ai
                st.b = args[ai]
                mir_cfg_append(f, nbi, st)
            }
        }
        $cii := callee.blocks[cb].head
        for _ in 0:callee.instrs.len {
            if cii < 0 { <- }
            ni := mir_cfg_clone_instr(callee, cii, local_base, temp_base, &cmap)
            mir_cfg_append(f, nbi, ni)
            cii = callee.instrs[cii].next
        }
        if reachable[cb] && callee.blocks[cb].tkind == 3 && dest >= 0 {
            $cp := mkinstr(MI_COPY)
            cp.a = dest
            cp.b = mir_cfg_value(callee.blocks[cb].ta, temp_base, &cmap)
            mir_cfg_append(f, nbi, cp)
        }
    }
}

fn mir_inline_cfg_call(m $&Mir, cfi int, fi int, bi int, ii int) int {
    if fi == cfi { << -1 }
    $fcall := mir_clone_fn(m, fi, true)
    dest := mfn_ia(&fcall.instrs, ii)
    head := mfn_ic(&fcall.instrs, ii)
    $args := []int{}
    $ap := head
    // For method calls (ib==80), the first marg is the LoadFnAddr temp
    // holding the callee address — skip it to get only real arguments
    // (receiver + params) that correspond to callee locals.
    call_b := mfn_ib(&fcall.instrs, ii)
    if call_b == 80 && ap >= 0 {
        ap = mfn_marg_next(&fcall.margs, ap)
    }
    while ap >= 0 {
        args.push(mfn_marg_v(&fcall.margs, ap))
        ap = mfn_marg_next(&fcall.margs, ap)
    }
    if args.len != m.fns[cfi].nparams { << -1 }
    $reachable := []bool{}
    mir_cfg_mark_reachable(&*m, cfi, $&reachable)
    for cb in 0:m.fns[cfi].blocks.len {
        if !reachable[cb] { -> }
        if m.fns[cfi].blocks[cb].tkind == 3 {
            rv := m.fns[cfi].blocks[cb].ta
            if (dest >= 0 && rv < -1) || (dest >= 0 && rv >= 0) {
                // scalar return is compatible
            } else if dest < 0 && rv == -1 {
                // void return is compatible
            } else {
                << -1
            }
        }
    }

    // Grow a local clone (push needs a local MFn root). Clone-assign back
    // into m.fns[fi] aliases slice headers and UAFs the pool, so keep the old
    // owner alive and append the replacement through the common commit path.
    $callee := mir_clone_fn(m, cfi, true)
    $f := mir_clone_fn(m, fi, true)
    nblk0 := f.blocks.len
    nloc0 := f.locals.len
    ntmp0 := f.temps.len
    mir_inline_cfg_apply($&f, &callee, &reachable, dest, &args, bi, ii)
    if !mir_verify_inline_cfg_f(&f, bi, nblk0, nloc0, ntmp0, &callee) {
        m.opt_inline_skip += 1
        << -1
    }
    seq := mir_fn_commit(m, fi, f)
    if seq < 0 {
        << -1
    }
    m.opt_inline_ok += 1
    << seq
}

fn mir_inline_cfg_leaves_once(m $&Mir) {
    small_unit := m.opt_nfn < 64
    $eff_opt := m.opt_level
    if small_unit && eff_opt == 1 {
        eff_opt = 2
    }
    n0 := m.fns.len
    $fi := 0
    while fi < n0 {
        if mir_fn_is_extern(&*m, fi) {
            fi += 1
            ->
        }
        $work := fi
        $bi := 0
        // Live block count: an inline splits the call site, moving the
        // remainder into a continuation block appended after the callee
        // clones. A frozen original_blocks bound would miss sequential
        // leaf calls in the same source block. Callee clones have no
        // Call (leaves cannot contain Call).
        // Walk a cloned MFn. `m.fns[i].instrs[j].x` and `&m.fns[i].instrs`
        // both OOB under Gen1 on small units (f64_sum / method_sum).
        $fwalk := mir_clone_fn(m, work, false)
        // The caller budget is unchanged. Reject it before per-call target
        // lookup, and reuse this already-owned snapshot for the proof.
        if !mir_cfg_caller_ok_f(&fwalk, eff_opt, small_unit) {
            fi += 1
            ->
        }
        while bi < fwalk.blocks.len {
            $ii := fwalk.blocks[bi].head
            nins := fwalk.instrs.len
            for _ in 0:nins {
                if ii < 0 { <- }
                if ii >= nins {
                    <-
                }
                next := mfn_inext(&fwalk.instrs, ii)
                ik := mfn_ikind(&fwalk.instrs, ii)
                ib := mfn_ib(&fwalk.instrs, ii)
                sval := mfn_isval(&fwalk.instrs, ii)
                if ik == MI_CALL && (ib == 1 || ib == 80) {
                    $hit := -1
                    // Resolve the callee label. ib==1 carries it in sval;
                    // ib==80 (method call) carries a LoadFnAddr temp as the
                    // first marg, with the label embedded in that temp.
                    $call_label := sval
                    if ib == 80 {
                        call_label = ""
                        mhead := mfn_ic(&fwalk.instrs, ii)
                        if mhead >= 0 {
                            fat := mfn_marg_v(&fwalk.margs, mhead)
                            call_label = mir_fnval_known_label(&*m, work, bi, ii, fat)
                        }
                    }
                    if call_label.len > 0 {
                        for ci in 0:m.fns.len {
                            if ci == work { -> }
                            if mir_fn_is_extern(&*m, ci) { -> }
                            clab := m.fns[ci].label + ""
                            if clab != call_label { -> }
                            if mir_cfg_leaf_safe_lvl(&*m, ci, eff_opt) {
                                hit = ci
                            }
                        }
                    }
                    if hit >= 0 && mir_cfg_caller_ok_f(&fwalk, eff_opt, small_unit) {
                        if !mir_inline_frame_growth_ok(&*m, &fwalk, hit) {
                            m.opt_inline_skip += 1
                            ii = next
                            ->
                        }
                        if mir_fn_block_is_self_loop(&*m, work, bi) && !mir_cfg_ok_in_self_loop(&*m, hit) {
                            ii = next
                            ->
                        }
                        // Keep a counted-loop helper out of a mixed caller.
                        // Cloning it beside channel/aggregate operations
                        // would make the whole caller fail the fixed-home
                        // vreg shape gate, turning a register-resident loop
                        // into a stack load/store loop. A pure scalar caller
                        // remains eligible for the usual inlining decision.
                        if mir_cfg_has_loop(&*m, hit) && !mir_cfg_caller_loop_inline_safe(&*m, work) {
                            ii = next
                            ->
                        }
                        nf := mir_inline_cfg_call(m, hit, work, bi, ii)
                        if nf >= 0 {
                            work = nf
                            fwalk = mir_clone_fn(m, work, false)
                            <-
                        }
                    }
                }
                ii = next
            }
            bi += 1
        }
        fi += 1
    }
}

fn mir_inline_cfg_leaves(m $&Mir) {
    if m.opt_level < 1 {
        <<
    }
    // CFG leaf inlining runs `mir_verify_inline_cfg_f` before commit
    // (edges, local/temp/const remap, no callee Phi). O2/O3 support acyclic
    // and loop leaves gated by caller and leaf size caps.
    // O2/O3 stay fail-closed above. O1 loop-leaf inlining used to skip
    // every unit with nfn>=64 (compiler self-host and `#math` programs).
    // Caller cost is `mir_cfg_caller_ok` (36 live ops at O1); loop leaves
    // also require `mir_cfg_caller_loop_inline_safe`. Those two gates
    // keep `time.date` / huge compiler helpers out without a unit nfn cap.
    $rounds := 1
    if m.opt_level >= 3 || m.opt_nfn < 64 {
        rounds = 3
    }
    $r := 0
    while r < rounds {
        mir_inline_cfg_leaves_once(m)
        r += 1
    }
    mir_each_tail_call_opt(m)
}
