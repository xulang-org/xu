@xu/types

// Read-only descriptor facts, separate from scalar optimization admission.
// A shared reference alone is not an alias proof. This domain excludes all
// calls, writes through pointers/indices, growth, ownership and address-taking
// in the whole function. Reads retain their original trap/order semantics.
// Reasons 0..9 follow MirValueFacts; 10 means descriptor provenance failed.
fn mir_readonly_array_type(m &Mir, ty int) bool {
    if ty < 200 || ty >= 300 { << false }
    ai := ty - 200
    if ai >= m.arrays.len { << false }
    << m.arrays[ai].fixed_len == 0 && m.arrays[ai].elem_ty == 1 && m.arrays[ai].elem_bytes == 8
}

fn mir_readonly_ref_type(m &Mir, ty int) bool {
    // Direct immutable references only; nested/mutable refs require a
    // separate table/provenance proof and are deliberately outside this API.
    if ty < 1200 || ty >= 1300 { << false }
    << mir_readonly_array_type(m, ty - 1000)
}

fn mir_readonly_cell_type(m &Mir, ty int, slots int, local bool, formal bool) bool {
    if slots == 1 && (ty == 1 || ty == 2) { << true }
    if slots == 1 && mir_readonly_ref_type(m, ty) { << !local || formal }
    << !local && slots == 3 && mir_readonly_array_type(m, ty)
}

fn mir_readonly_typed_copy(m &Mir, fi int, a int, b int) bool {
    if b < 0 || b >= mir_ntemps(m, fi) { << false }
    << mir_temp_ty(m, fi, a) == mir_temp_ty(m, fi, b) && mir_temp_nslots(m, fi, a) == mir_temp_nslots(m, fi, b)
}

fn mir_readonly_instr_ok(m &Mir, fi int, ii int) bool {
    if !mir_verify_emission_instr_shape(m, fi, ii) { << false }
    k := mir_ikind(m, fi, ii)
    a := mir_ia(m, fi, ii)
    b := mir_ib(m, fi, ii)
    if k == 1 {
        if mir_temp_ty(m, fi, a) == 1 || mir_temp_ty(m, fi, a) == 2 { << mir_scalar_instr_ok(m, fi, ii) }
        << mir_readonly_typed_copy(m, fi, a, b)
    }
    if k == 2 {
        << mir_temp_ty(m, fi, a) == mir_local_ty(m, fi, b) && mir_temp_nslots(m, fi, a) == mir_local_nslots(m, fi, b)
    }
    // Reference formals are immutable roots; scalar Local stores stay legal.
    if k >= 0 && k <= 5 { << mir_scalar_instr_ok(m, fi, ii) }
    c := mir_ic(m, fi, ii)
    d := mir_id(m, fi, ii)
    if k == 17 || k == 26 {
        if !mir_readonly_ref_type(m, mir_temp_ty(m, fi, b)) { << false }
        if c == 8 && d == 1 { << mir_temp_ty(m, fi, a) == 1 && mir_temp_nslots(m, fi, a) == 1 }
        << c == 0 && d == 3 && mir_temp_ty(m, fi, a) == mir_temp_ty(m, fi, b) - 1000 && mir_temp_nslots(m, fi, a) == 3
    }
    if k == 14 {
        if d != 8 || mir_temp_ty(m, fi, a) != 1 || mir_temp_nslots(m, fi, a) != 1 || !mir_scalar_typed_value(m, fi, c, 1) { << false }
        if b >= 1073741824 {
            loc := b - 1073741824
            << mir_readonly_ref_type(m, mir_local_ty(m, fi, loc))
        }
        << mir_readonly_array_type(m, mir_temp_ty(m, fi, b)) && mir_temp_nslots(m, fi, b) == 3
    }
    << false
}

// Returns the immutable reference's formal LocalId, or -1. Resolve at the
// exact use point, following actual earlier definitions. Merge tokens and
// cycles are never interpreted as equality across dynamic iterations.
pub fn mir_readonly_value_root(m &Mir, fi int, f &MirValueFacts, bi int, before int, kind int, id int) int {
    if !f.valid || f.reason != 0 { << -1 }
    if fi != f.fi || fi < 0 || fi >= m.fns.len { << -1 }
    if mir_nins(m, fi) != f.ni || mir_nblocks(m, fi) != f.nb || mir_nlocals(m, fi) != f.nl || mir_ntemps(m, fi) != f.nt { << -1 }
    mut block := bi
    mut point := before
    mut cell_kind := kind
    mut cell := id
    for _ in 0:32 {
        mut ty := 0
        if cell_kind == 1 {
            if cell < 0 || cell >= f.nl { << -1 }
            ty = mir_local_ty(m, fi, cell)
        } else if cell_kind == 2 {
            if cell < 0 || cell >= f.nt { << -1 }
            ty = mir_temp_ty(m, fi, cell)
        } else { << -1 }
        if !mir_readonly_ref_type(m, ty) && !mir_readonly_array_type(m, ty) { << -1 }
        version := mir_value_facts_version(m, fi, f, block, point, cell_kind, cell)
        if version < 0 { << -1 }
        if cell_kind == 1 && cell < f.np && version == f.ni + cell && mir_readonly_ref_type(m, ty) { << cell }
        if version >= f.ni { << -1 }
        block = mir_value_facts_owner(f, version)
        if block < 0 { << -1 }
        point = version
        k := mir_ikind(m, fi, version)
        if k == 1 { cell_kind = 2
            cell = mir_ib(m, fi, version) }
        else if k == 2 { cell_kind = 1
            cell = mir_ib(m, fi, version) }
        else if k == 17 || k == 26 {
            if mir_ic(m, fi, version) != 0 || mir_id(m, fi, version) != 3 { << -1 }
            cell_kind = 2
            cell = mir_ib(m, fi, version)
        } else { << -1 }
    }
    << -1
}

pub fn new_mir_readonly_value_facts(m &Mir, fi int) MirValueFacts {
    mut f := mir_value_facts_new(m, fi, true)
    if !f.valid || f.reason != 0 { << f }
    mut reads := 0
    for ii in 0:f.ni {
        bi := mir_value_facts_owner(&f, ii)
        if bi < 0 { -> }
        k := mir_ikind(m, fi, ii)
        if k != 14 && k != 17 && k != 26 { -> }
        reads += 1
        if reads > 128 { f.valid = false
            f.reason = 2
            << f }
        // Validate even dead linked reads structurally, but require a live
        // provenance only for reachable uses (the must-def policy).
        if !mir_value_facts_reachable(&f, bi) { -> }
        mut kind := 2
        mut id := mir_ib(m, fi, ii)
        if k == 14 && id >= 1073741824 { kind = 1
            id -= 1073741824 }
        if mir_readonly_value_root(m, fi, &f, bi, ii, kind, id) < 0 { f.valid = false
            f.reason = 10
            << f }
    }
    << f
}
