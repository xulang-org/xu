@xu/types

// Value simplification while single definitions and formal Phi nodes still
// exist. Never use this on de-SSA edge Copies: those have multiple definitions.
// Memory reads/writes, calls, traps and ownership operations remain in order.
// Bounds limit optimization work only; larger functions keep valid old SSA.
fn mir_ssa_scalar(f &MFn, t int) bool {
    if t < 0 || t >= f.temps.len || f.temps_nslots[t] != 1 { << false }
    ty := f.temps[t]
    // Narrow typed Copies perform width conversion at emission. Their raw
    // constant words cannot propagate without modelling that conversion.
    // Keep them and floating/owning values on the established path for now.
    << ty == 1 || ty == 2
}

fn mir_ssa_resolve(aliases &[]int, v int) int {
    mut at := v
    // N links can lead through all N temps to a constant. Check that final
    // endpoint too; otherwise even a one-temp constant Copy never resolves.
    for _ in 0:aliases.len + 1 {
        if at < 0 || at >= aliases.len { << at }
        next := aliases[at]
        if next == at { << at }
        at = next
    }
    // A valid strict SSA Copy graph cannot cycle. Keep a failed resolution
    // unchanged rather than substituting a partial walk through a cycle.
    << v
}

fn mir_ssa_same_value(f &MFn, a int, b int) bool {
    if a == b { << true }
    if a <= -2 && b <= -2 { << f.val_const(a) == f.val_const(b) }
    << false
}

fn mir_ssa_aliases(f &MFn, aliases &mut []int, pinned &[]bool) bool {
    mut changed := false
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_COPY {
                d := mfn_ia(&f.instrs, ii)
                s := mir_ssa_resolve(&*aliases, mfn_ib(&f.instrs, ii))
                if mir_ssa_scalar(f, d) && !pinned[d] && s != d {
                    mut compatible := s <= -2
                    if s >= 0 && s < f.temps.len { compatible = f.temps[s] == f.temps[d] }
                    // A pinned source can change through its address. This
                    // Copy is a snapshot at this instruction, not an alias
                    // that may read the mutable source later.
                    if s >= 0 && s < pinned.len && pinned[s] { compatible = false }
                    if compatible && aliases[d] != s {
                        mfn_set_i(aliases, d, s)
                        changed = true
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    for pi in 0:f.phis.len {
        d := f.phis[pi].dest
        if !mir_ssa_scalar(f, d) || pinned[d] { -> }
        mut same := -1
        mut conflict := false
        head := f.phis[pi].arg_head
        for ai in head:head + f.phis[pi].arg_count {
            v := mir_ssa_resolve(&*aliases, f.phi_args[ai].value)
            // phi(initial, self) is loop invariant. A phi with only self
            // inputs has no replacement witness and remains unchanged.
            if v == d { -> }
            if same == -1 { same = v }
            else if !mir_ssa_same_value(f, same, v) { conflict = true }
        }
        if same >= 0 && same < pinned.len && pinned[same] { conflict = true }
        if !conflict && same != -1 && same != d && aliases[d] != same {
            mfn_set_i(aliases, d, same)
            changed = true
        }
    }
    << changed
}

fn mir_ssa_replacement(aliases &[]int, old int, value_role bool) int {
    v := mir_ssa_resolve(aliases, old)
    // A Temp-only operand requires materialized storage. Constants can flow
    // through Value roles, while its defining Copy/Phi stays for Temp roles.
    if v < 0 && !value_role { << old }
    << v
}

fn mir_ssa_rewrite_instr(f &mut MFn, ii int, aliases &[]int) {
    schema := mir_instr_use_schema(mfn_ikind(&f.instrs, ii), mfn_ic(&f.instrs, ii))
    mask := mir_instr_use_mask(schema)
    a := mfn_ia(&f.instrs, ii)
    b := mfn_ib(&f.instrs, ii)
    c := mfn_ic(&f.instrs, ii)
    d := mfn_id(&f.instrs, ii)
    if (mask & 1) != 0 { mfn_set_ia(mut &f.instrs, ii, mir_ssa_replacement(aliases, a, (schema & 16) != 0)) }
    if (mask & 2) != 0 { mfn_set_ib(mut &f.instrs, ii, mir_ssa_replacement(aliases, b, (schema & 32) != 0)) }
    if (mask & 4) != 0 { mfn_set_ic(mut &f.instrs, ii, mir_ssa_replacement(aliases, c, (schema & 64) != 0)) }
    if (mask & 8) != 0 { mfn_set_id(mut &f.instrs, ii, mir_ssa_replacement(aliases, d, (schema & 128) != 0)) }
    mut ap := mir_instr_use_arg_head(schema, b, c, d)
    for _ in 0:f.margs.len {
        if ap < 0 { <- }
        next := mfn_marg_next(&f.margs, ap)
        value := mir_ssa_resolve(aliases, mfn_marg_v(&f.margs, ap))
        mfn_set_marg(mut &f.margs, ap, MArg{v: value, next: next})
        ap = next
    }
}

fn mir_ssa_rewrite(f &mut MFn, aliases &[]int) {
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            mir_ssa_rewrite_instr(f, ii, aliases)
            ii = mfn_inext(&f.instrs, ii)
        }
        if f.blocks[bi].tkind == 2 || f.blocks[bi].tkind == 3 {
            mut b := f.blocks[bi]
            b.ta = mir_ssa_resolve(aliases, b.ta)
            mfn_set_block(mut &f.blocks, bi, b)
        }
    }
    for ai in 0:f.phi_args.len {
        pred := f.phi_args[ai].pred
        value := mir_ssa_replacement(aliases, f.phi_args[ai].value, false)
        f.phi_args[ai] = MPhiArg{pred: pred, value: value}
    }
}

fn mir_ssa_mark(used &mut []bool, v int) {
    if v >= 0 && v < used.len { mfn_set_b(used, v, true) }
}

fn mir_ssa_mark_instr(f &MFn, ii int, used &mut []bool) {
    schema := mir_instr_use_schema(mfn_ikind(&f.instrs, ii), mfn_ic(&f.instrs, ii))
    mask := mir_instr_use_mask(schema)
    a := mfn_ia(&f.instrs, ii)
    b := mfn_ib(&f.instrs, ii)
    c := mfn_ic(&f.instrs, ii)
    d := mfn_id(&f.instrs, ii)
    if (mask & 1) != 0 { mir_ssa_mark(used, a) }
    if (mask & 2) != 0 { mir_ssa_mark(used, b) }
    if (mask & 4) != 0 { mir_ssa_mark(used, c) }
    if (mask & 8) != 0 { mir_ssa_mark(used, d) }
    mut ap := mir_instr_use_arg_head(schema, b, c, d)
    for _ in 0:f.margs.len {
        if ap < 0 { <- }
        mir_ssa_mark(used, mfn_marg_v(&f.margs, ap))
        ap = mfn_marg_next(&f.margs, ap)
    }
}

fn mir_ssa_binop_pure(op int) bool {
    << (op >= 1 && op <= 3) || (op >= 6 && op <= 11) || (op >= 14 && op <= 18)
}

fn mir_ssa_eval_const_binop(op int, lv int, rv int) int {
    if op == 1 { << lv + rv }
    if op == 2 { << lv - rv }
    if op == 3 { << lv * rv }
    if op == 14 { << lv & rv }
    if op == 15 { << lv | rv }
    if op == 16 { << lv ^ rv }
    if op == 17 {
        if rv >= 0 && rv < 64 { << lv << rv }
        << 0
    }
    if op == 18 {
        if rv >= 0 && rv < 64 { << lv >> rv }
        if lv >= 0 { << 0 }
        << -1
    }
    if op >= 6 && op <= 11 {
        << mir_eval_cmp(op, lv, rv)
    }
    << 0
}

fn mir_ssa_fold_algebraic(f &mut MFn, aliases &mut []int, pinned &[]bool) bool {
    mut changed := false
    nt := f.temps.len
    if nt <= 0 || nt > 512 { << false }

    mut def_instr := []int{}
    for _ in 0:nt { def_instr.push(-1) }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == MI_BIN && mfn_isval_len(&f.instrs, ii) == 0 {
                d := mfn_ia(&f.instrs, ii)
                if d >= 0 && d < nt {
                    mfn_set_i(mut &def_instr, d, ii)
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }

    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_BIN && mfn_isval_len(&f.instrs, ii) == 0 {
                dest := mfn_ia(&f.instrs, ii)
                op := mfn_ib(&f.instrs, ii)
                if mir_ssa_scalar(&*f, dest) && !pinned[dest] && mir_ssa_binop_pure(op) {
                    lhs := mir_ssa_resolve(&*aliases, mfn_ic(&f.instrs, ii))
                    rhs := mir_ssa_resolve(&*aliases, mfn_id(&f.instrs, ii))
                    mut usable := true
                    if lhs >= 0 && lhs < pinned.len && pinned[lhs] { usable = false }
                    if rhs >= 0 && rhs < pinned.len && pinned[rhs] { usable = false }

                    if usable {
                        if f.val_is_const(lhs) && f.val_is_const(rhs) {
                            lv := f.val_const(lhs)
                            rv := f.val_const(rhs)
                            res := mir_ssa_eval_const_binop(op, lv, rv)
                            cid := mir_cfg_const(f, res)
                            mfn_become_copy(mut &f.instrs, ii, cid)
                            mfn_set_i(aliases, dest, cid)
                            changed = true
                        } else {
                            mut l := lhs
                            mut r := rhs
                            if mir_bin_commutes(op) && f.val_is_const(l) && !f.val_is_const(r) {
                                tmp := l
                                l = r
                                r = tmp
                                mfn_set_cd(mut &f.instrs, ii, l, r)
                                changed = true
                            }

                            same := mir_ssa_same_value(&*f, l, r)
                            is_cr := f.val_is_const(r)
                            mut cr := 0
                            if is_cr { cr = f.val_const(r) }
                            is_cl := f.val_is_const(l)
                            mut cl := 0
                            if is_cl { cl = f.val_const(l) }

                            mut folded := false

                            if op == 14 {
                                if same {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                } else if (is_cr && cr == 0) || (is_cl && cl == 0) {
                                    c0 := mir_cfg_const(f, 0)
                                    mfn_become_copy(mut &f.instrs, ii, c0)
                                    mfn_set_i(aliases, dest, c0)
                                    folded = true
                                } else if is_cr && cr == -1 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                }
                            } else if op == 15 {
                                if same {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                } else if is_cr && cr == 0 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                } else if (is_cr && cr == -1) || (is_cl && cl == -1) {
                                    cm1 := mir_cfg_const(f, -1)
                                    mfn_become_copy(mut &f.instrs, ii, cm1)
                                    mfn_set_i(aliases, dest, cm1)
                                    folded = true
                                }
                            } else if op == 16 {
                                if same {
                                    c0 := mir_cfg_const(f, 0)
                                    mfn_become_copy(mut &f.instrs, ii, c0)
                                    mfn_set_i(aliases, dest, c0)
                                    folded = true
                                } else if is_cr && cr == 0 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                }
                            } else if op == 1 {
                                if is_cr && cr == 0 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                }
                            } else if op == 2 {
                                if same {
                                    c0 := mir_cfg_const(f, 0)
                                    mfn_become_copy(mut &f.instrs, ii, c0)
                                    mfn_set_i(aliases, dest, c0)
                                    folded = true
                                } else if is_cr && cr == 0 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                }
                            } else if op == 3 {
                                if (is_cr && cr == 0) || (is_cl && cl == 0) {
                                    c0 := mir_cfg_const(f, 0)
                                    mfn_become_copy(mut &f.instrs, ii, c0)
                                    mfn_set_i(aliases, dest, c0)
                                    folded = true
                                } else if is_cr && cr == 1 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                }
                            } else if op == 17 {
                                if is_cr && cr == 0 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                } else if is_cl && cl == 0 {
                                    c0 := mir_cfg_const(f, 0)
                                    mfn_become_copy(mut &f.instrs, ii, c0)
                                    mfn_set_i(aliases, dest, c0)
                                    folded = true
                                }
                            } else if op == 18 {
                                if is_cr && cr == 0 {
                                    mfn_become_copy(mut &f.instrs, ii, l)
                                    mfn_set_i(aliases, dest, l)
                                    folded = true
                                } else if is_cl && cl == 0 {
                                    c0 := mir_cfg_const(f, 0)
                                    mfn_become_copy(mut &f.instrs, ii, c0)
                                    mfn_set_i(aliases, dest, c0)
                                    folded = true
                                }
                            } else if op >= 6 && op <= 11 {
                                // The bool result is scalar even when its
                                // operands are f64. NaN invalidates integer
                                // self-comparison identities; admit the
                                // operand as well before folding them.
                                if same && mir_ssa_scalar(&*f, l) {
                                    mut cv := 0
                                    if op == 6 || op == 9 || op == 11 { cv = 1 }
                                    cid := mir_cfg_const(f, cv)
                                    mfn_become_copy(mut &f.instrs, ii, cid)
                                    mfn_set_i(aliases, dest, cid)
                                    folded = true
                                }
                            }

                            if folded {
                                changed = true
                            } else {
                                if is_cr && l >= 0 && l < def_instr.len {
                                    di := def_instr[l]
                                    if di >= 0 && mfn_ikind(&f.instrs, di) == MI_BIN && mfn_isval_len(&f.instrs, di) == 0 {
                                        pop := mfn_ib(&f.instrs, di)
                                        mut pl := mir_ssa_resolve(&*aliases, mfn_ic(&f.instrs, di))
                                        mut pr := mir_ssa_resolve(&*aliases, mfn_id(&f.instrs, di))
                                        if mir_bin_commutes(pop) && f.val_is_const(pl) && !f.val_is_const(pr) {
                                            ptmp := pl
                                            pl = pr
                                            pr = ptmp
                                        }
                                        if pop == op && f.val_is_const(pr) {
                                            c1 := f.val_const(pr)
                                            c2 := cr
                                            x := pl
                                            if op == 14 {
                                                new_c := c1 & c2
                                                if new_c == c1 {
                                                    mfn_become_copy(mut &f.instrs, ii, l)
                                                    mfn_set_i(aliases, dest, l)
                                                    changed = true
                                                } else if new_c == 0 {
                                                    c0 := mir_cfg_const(f, 0)
                                                    mfn_become_copy(mut &f.instrs, ii, c0)
                                                    mfn_set_i(aliases, dest, c0)
                                                    changed = true
                                                } else {
                                                    cid := mir_cfg_const(f, new_c)
                                                    mfn_set_cd(mut &f.instrs, ii, x, cid)
                                                    changed = true
                                                }
                                            } else if op == 16 {
                                                new_c := c1 ^ c2
                                                if new_c == 0 {
                                                    mfn_become_copy(mut &f.instrs, ii, x)
                                                    mfn_set_i(aliases, dest, x)
                                                    changed = true
                                                } else {
                                                    cid := mir_cfg_const(f, new_c)
                                                    mfn_set_cd(mut &f.instrs, ii, x, cid)
                                                    changed = true
                                                }
                                            } else if op == 15 {
                                                new_c := c1 | c2
                                                if new_c == c1 {
                                                    mfn_become_copy(mut &f.instrs, ii, l)
                                                    mfn_set_i(aliases, dest, l)
                                                    changed = true
                                                } else {
                                                    cid := mir_cfg_const(f, new_c)
                                                    mfn_set_cd(mut &f.instrs, ii, x, cid)
                                                    changed = true
                                                }
                                            } else if op == 1 {
                                                new_c := c1 + c2
                                                if new_c == 0 {
                                                    mfn_become_copy(mut &f.instrs, ii, x)
                                                    mfn_set_i(aliases, dest, x)
                                                    changed = true
                                                } else {
                                                    cid := mir_cfg_const(f, new_c)
                                                    mfn_set_cd(mut &f.instrs, ii, x, cid)
                                                    changed = true
                                                }
                                            } else if op == 17 {
                                                if c1 >= 0 && c2 >= 0 {
                                                    if c1 + c2 >= 64 {
                                                        c0 := mir_cfg_const(f, 0)
                                                        mfn_become_copy(mut &f.instrs, ii, c0)
                                                        mfn_set_i(aliases, dest, c0)
                                                        changed = true
                                                    } else {
                                                        cid := mir_cfg_const(f, c1 + c2)
                                                        mfn_set_cd(mut &f.instrs, ii, x, cid)
                                                        changed = true
                                                    }
                                                }
                                            } else if op == 18 {
                                                if c1 >= 0 && c2 >= 0 {
                                                    mut s := c1 + c2
                                                    if s > 63 { s = 63 }
                                                    cid := mir_cfg_const(f, s)
                                                    mfn_set_cd(mut &f.instrs, ii, x, cid)
                                                    changed = true
                                                }
                                            }
                                        }
                                    }
                                }

                                if !changed && op == 16 {
                                    if l >= 0 && l < def_instr.len {
                                        di := def_instr[l]
                                        if di >= 0 && mfn_ikind(&f.instrs, di) == MI_BIN && mfn_isval_len(&f.instrs, di) == 0 && mfn_ib(&f.instrs, di) == 16 {
                                            pl := mir_ssa_resolve(&*aliases, mfn_ic(&f.instrs, di))
                                            pr := mir_ssa_resolve(&*aliases, mfn_id(&f.instrs, di))
                                            if mir_ssa_same_value(&*f, pl, r) {
                                                mfn_become_copy(mut &f.instrs, ii, pr)
                                                mfn_set_i(aliases, dest, pr)
                                                changed = true
                                            } else if mir_ssa_same_value(&*f, pr, r) {
                                                mfn_become_copy(mut &f.instrs, ii, pl)
                                                mfn_set_i(aliases, dest, pl)
                                                changed = true
                                            }
                                        }
                                    }
                                    if !changed && r >= 0 && r < def_instr.len {
                                        di := def_instr[r]
                                        if di >= 0 && mfn_ikind(&f.instrs, di) == MI_BIN && mfn_isval_len(&f.instrs, di) == 0 && mfn_ib(&f.instrs, di) == 16 {
                                            pl := mir_ssa_resolve(&*aliases, mfn_ic(&f.instrs, di))
                                            pr := mir_ssa_resolve(&*aliases, mfn_id(&f.instrs, di))
                                            if mir_ssa_same_value(&*f, pl, l) {
                                                mfn_become_copy(mut &f.instrs, ii, pr)
                                                mfn_set_i(aliases, dest, pr)
                                                changed = true
                                            } else if mir_ssa_same_value(&*f, pr, l) {
                                                mfn_become_copy(mut &f.instrs, ii, pl)
                                                mfn_set_i(aliases, dest, pl)
                                                changed = true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << changed
}

fn mir_ssa_prune(f &mut MFn, aliases &[]int) int {
    mut used := []bool{}
    for _ in 0:f.temps.len { used.push(false) }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            mir_ssa_mark_instr(&*f, ii, mut &used)
            ii = mfn_inext(&f.instrs, ii)
        }
        if f.blocks[bi].tkind == 2 || f.blocks[bi].tkind == 3 { mir_ssa_mark(mut &used, f.blocks[bi].ta) }
    }
    for ai in 0:f.phi_args.len { mir_ssa_mark(mut &used, f.phi_args[ai].value) }
    mut removed := 0
    for bi in 0:f.blocks.len {
        mut kill := []int{}
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_COPY {
                dest := mfn_ia(&f.instrs, ii)
                if mir_ssa_scalar(&*f, dest) && !used[dest] { kill.push(ii) }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        for ki in 0:kill.len {
            mir_delete_instr(f, bi, kill[ki])
            removed += 1
        }
    }
    mut keep := []MPhi{}
    mut args := []MPhiArg{}
    for pi in 0:f.phis.len {
        d := f.phis[pi].dest
        replacement := mir_ssa_resolve(aliases, d)
        if mir_ssa_scalar(&*f, d) && replacement != d {
            // Phi inputs retain their historical Temp-only contract. When
            // another Temp-only use still needs this result, materialize one
            // definition at merge entry instead of one Copy on every edge.
            if used[d] {
                bi := f.phis[pi].block
                mut cp := mkinstr(MI_COPY)
                cp.a = d
                cp.b = replacement
                mir_prepend_instr(f, bi, cp)
            }
            removed += 1
            ->
        }
        if mir_ssa_scalar(&*f, d) && !used[d] { removed += 1
            -> }
        head := args.len
        old_head := f.phis[pi].arg_head
        count := f.phis[pi].arg_count
        for ai in old_head:old_head + count {
            args.push(MPhiArg{pred: f.phi_args[ai].pred, value: f.phi_args[ai].value})
        }
        keep.push(MPhi{block: f.phis[pi].block, local: f.phis[pi].local, dest: d,
            ty: f.phis[pi].ty, arg_head: head, arg_count: count})
    }
    f.phis = keep
    f.phi_args = args
    << removed
}

// The admission query, checked entry and trusted core share one work budget.
fn mir_ssa_work_budget_f(f &MFn) bool {
    nt := f.temps.len
    if nt > 512 || f.blocks.len > 64 || f.instrs.len > 4096 || f.phis.len > 512 || f.phi_args.len > 4096 || f.margs.len > 4096 { << false }
    if f.blocks.len * nt > 16384 { << false }
    if f.instrs.len * f.margs.len > 1048576 { << false }
    << true
}

// Checked entry for callers without a fresh strict SSA proof.
// -1 means rejected before mutation. Nonnegative results count removed
// Copy/Phi definitions, not dynamic loads, physical homes or elapsed time.
fn mir_ssa_simplify_f(f &mut MFn) int {
    if !mir_ssa_work_budget_f(&*f) { << -1 }
    if mir_verify_mfn_f(&*f, true) != 0 { << -1 }
    << mir_ssa_simplify_verified_f(f)
}

// Requires a strict SSA proof immediately before this call; no intervening mutation.
fn mir_ssa_simplify_verified_f(f &mut MFn) int {
    if !mir_ssa_work_budget_f(&*f) { << -1 }
    nt := f.temps.len
    mut pinned := []bool{}
    mut aliases := []int{}
    for t in 0:nt { pinned.push(false)
        aliases.push(t) }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            schema := mir_instr_use_schema(mfn_ikind(&f.instrs, ii), mfn_ic(&f.instrs, ii))
            if schema < 0 { << -1 }
            // Addr(Temp) observes the identity of a slot, not just its word.
            // It must not be redirected to an equal value's different slot.
            if mfn_ikind(&f.instrs, ii) == MI_ADDR && mfn_ic(&f.instrs, ii) == 1 {
                t := mfn_ib(&f.instrs, ii)
                mfn_set_b(mut &pinned, t, true)
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    // Bounded fixed point. Resolve whole alias chains at each use; a chain
    // of Copies therefore does not require one iteration per instruction.
    for _ in 0:16 {
        mut changed := false
        if mir_ssa_aliases(&*f, mut &aliases, &pinned) { changed = true }
        if mir_ssa_fold_algebraic(f, mut &aliases, &pinned) { changed = true }
        if !changed { <- }
    }
    // Only pure, unaddressed integer definitions can share an earlier
    // dominating result. CFG, loads, calls and ownership remain in place.
    if mir_ssa_cse_verified_f(f, mut &aliases, &pinned) {
        // CSE can make previously distinct Phi inputs identical.
        for _ in 0:16 {
            mut changed := false
            if mir_ssa_aliases(&*f, mut &aliases, &pinned) { changed = true }
            if mir_ssa_fold_algebraic(f, mut &aliases, &pinned) { changed = true }
            if !changed { <- }
        }
    }
    mir_ssa_rewrite(f, &aliases)
    mut removed := 0
    for _ in 0:16 {
        n := mir_ssa_prune(f, &aliases)
        removed += n
        if n == 0 { <- }
    }
    << removed
}

// Read-only admission on a strictly verified SSA function.
fn mir_ssa_has_value_work_verified_f(f &MFn) bool {
    if !mir_ssa_work_budget_f(f) { << false }
    for pi in 0:f.phis.len {
        if mir_ssa_scalar(f, f.phis[pi].dest) { << true }
    }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == MI_COPY && mir_ssa_scalar(f, mfn_ia(&f.instrs, ii)) { << true }
            if k == MI_BIN && mir_ssa_scalar(f, mfn_ia(&f.instrs, ii)) && mir_ssa_binop_pure(mfn_ib(&f.instrs, ii)) { << true }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << mir_ssa_cse_count_f(f) >= 2
}
