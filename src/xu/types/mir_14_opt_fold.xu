@xu/types

fn (f &MFn) pow2_shift(v int) int {
    if !f.val_is_const(v) { << -1 }
    k := f.val_const(v)
    if k < 2 { << -1 }
    if k > 4611686018427387904 { << -1 }
    $x := k
    $s := 0
    for _ in 0:63 {
        if x == 1 { << s }
        if (x / 2) * 2 != x { << -1 }
        x = x / 2
        s = s + 1
    }
    << -1
}

fn mir_pow2_shift(f &MFn, v int) int {
    << f.pow2_shift(v)
}

fn mir_fold_identities(f $&MFn) bool {
    // Slice header lives here (small frame). The binop folder is large;
    // Gen1 clobbers local []int headers in that size of function (same
    // split as mir_local_cse / mir_cse_step).
    nb := f.blocks.len
    nt := f.temps.len
    if nb == 0 || nt == 0 { << false }
    $can_inter := false
    if nb > 1 && nb * nt <= 65536 {
        can_inter = true
    }
    $out_def := []int{}
    $out_valid := []bool{}
    if can_inter {
        total := nb * nt
        for _ in 0:total {
            out_def.push(-1)
        }
        for _ in 0:nb {
            out_valid.push(false)
        }
    }
    $changed := false
    for bi in 0:nb {
        $last_def := []int{}
        for _ in 0:nt {
            last_def.push(-1)
        }
        if can_inter && bi > 0 {
            pred := f.strict_forward_pred(bi)
            if pred >= 0 && out_valid[pred] {
                pbase := pred * nt
                for t in 0:nt {
                    pd := out_def[pbase + t]
                    if pd >= 0 {
                        mfn_set_i($&last_def, t, pd)
                    }
                }
            }
        }
        if mir_fold_identities_block(f, bi, $&last_def) {
            changed = true
        }
        if can_inter {
            base := bi * nt
            for t in 0:nt {
                mfn_set_i($&out_def, base + t, last_def[t])
            }
            mfn_set_b($&out_valid, bi, true)
        }
    }
    << changed
}

fn mir_fold_identities_block(f $&MFn, bi int, last_def $&[]int) bool {
    $changed := false
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        nxt := f.instrs[ii].next
        k := f.instrs[ii].kind
        if k == 5 {
            if mir_fold_un_at(f, ii, last_def) {
                changed = true
            }
        } else if k == 4 {
            if mir_fold_bin_at(f, bi, ii, last_def) {
                changed = true
            }
        }
        if mir_instr_has_dest(f.instrs[ii].kind) {
            da := f.instrs[ii].a
            if da >= 0 && da < last_def.len {
                mfn_set_i(last_def, da, ii)
            }
        }
        ii = nxt
    }
    << changed
}

fn mir_fold_un_at(f $&MFn, ii int, last_def $&[]int) bool {
    dest := f.instrs[ii].a
    op := f.instrs[ii].b
    srcv := f.instrs[ii].c
    $changed := false
    if (op == 1 || op == 2) && srcv >= 0 && srcv < last_def.len {
        pi := last_def[srcv]
        if pi >= 0 && f.instrs[pi].kind == MI_UN && f.instrs[pi].b == op {
            pc := f.instrs[pi].c
            mfn_become_copy($&f.instrs, ii, pc)
            changed = true
        }
    }
    if dest >= 0 && dest < last_def.len {
        mfn_set_i(last_def, dest, ii)
    }
    << changed
}

fn mir_fold_bin_at(f $&MFn, bi int, ii int, last_def $&[]int) bool {
    dest := f.instrs[ii].a
    op := f.instrs[ii].b
    lhs := f.instrs[ii].c
    rhs := f.instrs[ii].d
    if mir_fold_bin_to_copy(f, ii, dest, op, lhs, rhs) { << true }
    if dest < 0 || dest >= f.temps.len { << false }
    if !is_integer_type(f.temps[dest]) { << false }
    if mir_is_cmp_op(op) { << false }
    << mir_fold_bin_reshape(f, bi, ii, op, lhs, rhs, last_def)
}

fn mir_fold_copy_if(f $&MFn, ii int, src int, ok bool) bool {
    if !ok { << false }
    mfn_become_copy($&f.instrs, ii, src)
    << true
}

fn mir_fold_bin_to_copy(f $&MFn, ii int, dest int, op int, lhs int, rhs int) bool {
    if mir_is_cmp_op(op) && lhs == rhs {
        // The result is bool, so inspect the operand type. NaN makes
        // x==x / x<=x / x>=x false and x!=x true; identity alone is
        // insufficient to fold any floating comparison.
        if lhs >= 0 && lhs < f.temps.len && f.temps[lhs] == 4 { << false }
        $cv := 0
        if op == 6 || op == 9 || op == 11 {
            cv = 1
        }
        src := mir_find_const(f, cv)
        << mir_fold_copy_if(f, ii, src, src <= -2)
    }
    if dest < 0 || dest >= f.temps.len { << false }
    if !is_integer_type(f.temps[dest]) { << false }
    if mir_is_cmp_op(op) { << false }
    if op == 1 {
        if f.val_is_const_k(rhs, 0) { << mir_fold_copy_if(f, ii, lhs, true) }
        if f.val_is_const_k(lhs, 0) { << mir_fold_copy_if(f, ii, rhs, true) }
        << false
    }
    if op == 2 { << mir_fold_sub_to_copy(f, ii, lhs, rhs) }
    if op == 3 { << mir_fold_mul_to_copy(f, ii, lhs, rhs) }
    if op == 15 { << mir_fold_or_to_copy(f, ii, lhs, rhs) }
    if op == 16 { << mir_fold_xor_to_copy(f, ii, lhs, rhs) }
    if op == 14 { << mir_fold_and_to_copy(f, ii, lhs, rhs) }
    if (op == 17 || op == 18) && f.val_is_const_k(rhs, 0) {
        << mir_fold_copy_if(f, ii, lhs, true)
    }
    << false
}

fn mir_fold_zero_copy(f $&MFn, ii int) bool {
    c0 := mir_find_const(f, 0)
    << mir_fold_copy_if(f, ii, c0, c0 <= -2)
}

fn mir_fold_sub_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) { << mir_fold_copy_if(f, ii, lhs, true) }
    if lhs == rhs && lhs >= 0 { << mir_fold_zero_copy(f, ii) }
    << false
}

fn mir_fold_mul_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 1) { << mir_fold_copy_if(f, ii, lhs, true) }
    if f.val_is_const_k(lhs, 1) { << mir_fold_copy_if(f, ii, rhs, true) }
    if f.val_is_const_k(rhs, 0) || f.val_is_const_k(lhs, 0) {
        << mir_fold_zero_copy(f, ii)
    }
    << false
}

fn mir_fold_or_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) || (lhs == rhs && lhs >= 0) {
        << mir_fold_copy_if(f, ii, lhs, true)
    }
    if f.val_is_const_k(lhs, 0) { << mir_fold_copy_if(f, ii, rhs, true) }
    << false
}

fn mir_fold_xor_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) { << mir_fold_copy_if(f, ii, lhs, true) }
    if f.val_is_const_k(lhs, 0) { << mir_fold_copy_if(f, ii, rhs, true) }
    if lhs == rhs && lhs >= 0 { << mir_fold_zero_copy(f, ii) }
    << false
}

fn mir_fold_and_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) || f.val_is_const_k(lhs, 0) {
        << mir_fold_zero_copy(f, ii)
    }
    if lhs == rhs && lhs >= 0 { << mir_fold_copy_if(f, ii, lhs, true) }
    << false
}

fn mir_fold_bin_reshape(f $&MFn, bi int, ii int, op int, lhs int, rhs int, last_def $&[]int) bool {
    $changed := false
    if op == 3 {
        $cur_lhs := lhs
        $cur_rhs := rhs
        if mir_fold_mul_chain(f, bi, ii, cur_lhs, cur_rhs, last_def) {
            changed = true
            cur_lhs = f.instrs[ii].c
            cur_rhs = f.instrs[ii].d
        }
        if mir_fold_mul_pow2(f, ii, cur_lhs, cur_rhs) { changed = true }
    }
    if op == 1 {
        if mir_fold_add_chain(f, bi, ii, lhs, rhs, last_def) {
            changed = true
        } else if mir_fold_add_sub_chain(f, bi, ii, lhs, rhs, last_def) {
            changed = true
        }
        if lhs == rhs && lhs >= 0 {
            cd := mir_find_const(f, 1)
            if cd <= -2 {
                mfn_set_bd($&f.instrs, ii, 17, cd)
                changed = true
            }
        }
    }
    if op == 2 {
        if mir_fold_sub_chain(f, bi, ii, lhs, rhs, last_def) {
            changed = true
        }
    }
    if op == 14 || op == 15 || op == 16 {
        if mir_fold_bitwise_chain(f, bi, ii, op, lhs, rhs, last_def) {
            changed = true
        }
    }
    if op == 17 || op == 18 {
        if mir_fold_shift_chain(f, bi, ii, op, lhs, rhs, last_def) {
            changed = true
        }
    }
    << changed
}

fn mir_fold_mul_chain(f $&MFn, bi int, ii int, lhs int, rhs int, last_def $&[]int) bool {
    $t := 0 - 1
    $c2 := 0
    $okc := false
    if lhs >= 0 && f.val_is_const(rhs) {
        t = lhs
        c2 = f.val_const(rhs)
        okc = true
    } else if rhs >= 0 && f.val_is_const(lhs) {
        t = rhs
        c2 = f.val_const(lhs)
        okc = true
    }
    if !okc || t < 0 || t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != 3 { << false }
    il := f.instrs[pi].c
    ir := f.instrs[pi].d
    $x := 0 - 1
    $c1 := 0
    $ok1 := false
    if il >= 0 && f.val_is_const(ir) {
        x = il
        c1 = f.val_const(ir)
        ok1 = true
    } else if ir >= 0 && f.val_is_const(il) {
        x = ir
        c1 = f.val_const(il)
        ok1 = true
    }
    if !ok1 { << false }
    $stale := f.is_self_loop(bi)
    if !stale && x >= 0 && x < last_def.len {
        if last_def[x] > pi {
            stale = true
        }
    }
    if stale { << false }
    cd := mir_cfg_const(f, c1 * c2)
    mfn_set_cd($&f.instrs, ii, x, cd)
    << true
}

fn mir_fold_mul_pow2(f $&MFn, ii int, lhs int, rhs int) bool {
    $sh := f.pow2_shift(rhs)
    if sh >= 0 {
        cd := mir_find_const(f, sh)
        if cd <= -2 {
            mfn_set_bd($&f.instrs, ii, 17, cd)
            << true
        }
        << false
    }
    sh = f.pow2_shift(lhs)
    if sh < 0 { << false }
    cd := mir_find_const(f, sh)
    if cd > -2 { << false }
    mfn_set_bcd($&f.instrs, ii, 17, rhs, cd)
    << true
}

fn mir_fold_add_chain(f $&MFn, bi int, ii int, lhs int, rhs int, last_def $&[]int) bool {
    $t := 0 - 1
    $c2 := 0
    $okc := false
    if lhs >= 0 && f.val_is_const(rhs) {
        t = lhs
        c2 = f.val_const(rhs)
        okc = true
    } else if rhs >= 0 && f.val_is_const(lhs) {
        t = rhs
        c2 = f.val_const(lhs)
        okc = true
    }
    if !okc || t < 0 || t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != 1 { << false }
    il := f.instrs[pi].c
    ir := f.instrs[pi].d
    $x := 0 - 1
    $c1 := 0
    $ok1 := false
    if il >= 0 && f.val_is_const(ir) {
        x = il
        c1 = f.val_const(ir)
        ok1 = true
    } else if ir >= 0 && f.val_is_const(il) {
        x = ir
        c1 = f.val_const(il)
        ok1 = true
    }
    if !ok1 { << false }
    $stale := f.is_self_loop(bi)
    if !stale && x >= 0 && x < last_def.len {
        if last_def[x] > pi {
            stale = true
        }
    }
    if stale { << false }
    cd := mir_cfg_const(f, c1 + c2)
    mfn_set_cd($&f.instrs, ii, x, cd)
    << true
}

fn mir_fold_add_sub_chain(f $&MFn, bi int, ii int, lhs int, rhs int, last_def $&[]int) bool {
    $t := 0 - 1
    $c2 := 0
    $okc := false
    if lhs >= 0 && f.val_is_const(rhs) {
        t = lhs
        c2 = f.val_const(rhs)
        okc = true
    } else if rhs >= 0 && f.val_is_const(lhs) {
        t = rhs
        c2 = f.val_const(lhs)
        okc = true
    }
    if !okc || t < 0 || t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != 2 { << false }
    il := f.instrs[pi].c
    ir := f.instrs[pi].d
    $stale := f.is_self_loop(bi)
    if il >= 0 && f.val_is_const(ir) {
        x := il
        c1 := f.val_const(ir)
        if !stale && x >= 0 && x < last_def.len {
            if last_def[x] > pi { stale = true }
        }
        if stale { << false }
        if c2 >= c1 {
            diff := c2 - c1
            cd := mir_cfg_const(f, diff)
            mfn_set_cd($&f.instrs, ii, x, cd)
        } else {
            diff := c1 - c2
            cd := mir_cfg_const(f, diff)
            mfn_set_bcd($&f.instrs, ii, 2, x, cd)
        }
        << true
    }
    if ir >= 0 && f.val_is_const(il) {
        x := ir
        c1 := f.val_const(il)
        if !stale && x >= 0 && x < last_def.len {
            if last_def[x] > pi { stale = true }
        }
        if stale { << false }
        cd := mir_cfg_const(f, c1 + c2)
        mfn_set_bcd($&f.instrs, ii, 2, cd, x)
        << true
    }
    << false
}

fn mir_fold_sub_chain(f $&MFn, bi int, ii int, lhs int, rhs int, last_def $&[]int) bool {
    $stale := f.is_self_loop(bi)
    if lhs >= 0 && f.val_is_const(rhs) {
        t := lhs
        c2 := f.val_const(rhs)
        if t < 0 || t >= last_def.len { << false }
        pi := last_def[t]
        if pi < 0 || f.instrs[pi].kind != MI_BIN { << false }
        pb := f.instrs[pi].b
        il := f.instrs[pi].c
        ir := f.instrs[pi].d
        if pb == 1 {
            $x := 0 - 1
            $c1 := 0
            $ok1 := false
            if il >= 0 && f.val_is_const(ir) {
                x = il
                c1 = f.val_const(ir)
                ok1 = true
            } else if ir >= 0 && f.val_is_const(il) {
                x = ir
                c1 = f.val_const(il)
                ok1 = true
            }
            if !ok1 { << false }
            if !stale && x >= 0 && x < last_def.len {
                if last_def[x] > pi { stale = true }
            }
            if stale { << false }
            if c1 >= c2 {
                diff := c1 - c2
                cd := mir_cfg_const(f, diff)
                mfn_set_bcd($&f.instrs, ii, 1, x, cd)
            } else {
                diff := c2 - c1
                cd := mir_cfg_const(f, diff)
                mfn_set_cd($&f.instrs, ii, x, cd)
            }
            << true
        } else if pb == 2 {
            if il >= 0 && f.val_is_const(ir) {
                x := il
                c1 := f.val_const(ir)
                if !stale && x >= 0 && x < last_def.len {
                    if last_def[x] > pi { stale = true }
                }
                if stale { << false }
                cd := mir_cfg_const(f, c1 + c2)
                mfn_set_cd($&f.instrs, ii, x, cd)
                << true
            } else if ir >= 0 && f.val_is_const(il) {
                x := ir
                c1 := f.val_const(il)
                if !stale && x >= 0 && x < last_def.len {
                    if last_def[x] > pi { stale = true }
                }
                if stale { << false }
                cd := mir_cfg_const(f, c1 - c2)
                mfn_set_cd($&f.instrs, ii, cd, x)
                << true
            }
        }
    } else if rhs >= 0 && f.val_is_const(lhs) {
        t := rhs
        c2 := f.val_const(lhs)
        if t < 0 || t >= last_def.len { << false }
        pi := last_def[t]
        if pi < 0 || f.instrs[pi].kind != MI_BIN { << false }
        pb := f.instrs[pi].b
        il := f.instrs[pi].c
        ir := f.instrs[pi].d
        if pb == 1 {
            $x := 0 - 1
            $c1 := 0
            $ok1 := false
            if il >= 0 && f.val_is_const(ir) {
                x = il
                c1 = f.val_const(ir)
                ok1 = true
            } else if ir >= 0 && f.val_is_const(il) {
                x = ir
                c1 = f.val_const(il)
                ok1 = true
            }
            if !ok1 { << false }
            if !stale && x >= 0 && x < last_def.len {
                if last_def[x] > pi { stale = true }
            }
            if stale { << false }
            cd := mir_cfg_const(f, c2 - c1)
            mfn_set_cd($&f.instrs, ii, cd, x)
            << true
        } else if pb == 2 && il >= 0 && f.val_is_const(ir) {
            x := il
            c1 := f.val_const(ir)
            if !stale && x >= 0 && x < last_def.len {
                if last_def[x] > pi { stale = true }
            }
            if stale { << false }
            cd := mir_cfg_const(f, c2 + c1)
            mfn_set_cd($&f.instrs, ii, cd, x)
            << true
        }
    }
    << false
}

fn mir_fold_bitwise_chain(f $&MFn, bi int, ii int, op int, lhs int, rhs int, last_def $&[]int) bool {
    $t := 0 - 1
    $c2 := 0
    $okc := false
    if lhs >= 0 && f.val_is_const(rhs) {
        t = lhs
        c2 = f.val_const(rhs)
        okc = true
    } else if rhs >= 0 && f.val_is_const(lhs) {
        t = rhs
        c2 = f.val_const(lhs)
        okc = true
    }
    if !okc || t < 0 || t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != op { << false }
    il := f.instrs[pi].c
    ir := f.instrs[pi].d
    $x := 0 - 1
    $c1 := 0
    $ok1 := false
    if il >= 0 && f.val_is_const(ir) {
        x = il
        c1 = f.val_const(ir)
        ok1 = true
    } else if ir >= 0 && f.val_is_const(il) {
        x = ir
        c1 = f.val_const(il)
        ok1 = true
    }
    if !ok1 { << false }
    $stale := f.is_self_loop(bi)
    if !stale && x >= 0 && x < last_def.len {
        if last_def[x] > pi {
            stale = true
        }
    }
    if stale { << false }
    $res := 0
    if op == 14 { res = c1 & c2 }
    else if op == 15 { res = c1 | c2 }
    else if op == 16 { res = c1 ^ c2 }
    cd := mir_cfg_const(f, res)
    mfn_set_cd($&f.instrs, ii, x, cd)
    << true
}

fn mir_fold_shift_chain(f $&MFn, bi int, ii int, op int, lhs int, rhs int, last_def $&[]int) bool {
    if lhs < 0 || !f.val_is_const(rhs) { << false }
    c2 := f.val_const(rhs)
    if c2 < 0 || c2 >= 64 { << false }
    t := lhs
    if t < 0 || t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != op { << false }
    il := f.instrs[pi].c
    ir := f.instrs[pi].d
    if il < 0 || !f.val_is_const(ir) { << false }
    c1 := f.val_const(ir)
    if c1 < 0 || c1 >= 64 { << false }
    x := il
    $stale := f.is_self_loop(bi)
    if !stale && x >= 0 && x < last_def.len {
        if last_def[x] > pi {
            stale = true
        }
    }
    if stale { << false }
    total := c1 + c2
    if total >= 64 {
        c0 := mir_find_const(f, 0)
        if c0 <= -2 {
            mfn_become_copy($&f.instrs, ii, c0)
            << true
        }
        << false
    }
    cd := mir_cfg_const(f, total)
    mfn_set_cd($&f.instrs, ii, x, cd)
    << true
}

fn mir_fold_const_cmps(f $&MFn) bool {
    $changed := false
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := f.instrs[ii].next
            if f.instrs[ii].kind == MI_BIN && mir_is_cmp_op(f.instrs[ii].b) {
                lhs := f.instrs[ii].c
                rhs := f.instrs[ii].d
                $lok := false
                $rok := false
                $lv := 0
                $rv := 0
                if lhs <= -2 {
                    li := 0 - lhs - 2
                    if li >= 0 && li < f.consts.len {
                        lok = true
                        lv = f.consts[li]
                    }
                }
                if rhs <= -2 {
                    ri := 0 - rhs - 2
                    if ri >= 0 && ri < f.consts.len {
                        rok = true
                        rv = f.consts[ri]
                    }
                }
                if lok && rok {
                    cv := mir_eval_cmp(f.instrs[ii].b, lv, rv)
                    $c := 0
                    $hitc := false
                    for k in 0:f.consts.len {
                        if f.consts[k] == cv {
                            c = 0 - k - 2
                            hitc = true
                        }
                    }
                    if hitc {
                        mfn_become_copy($&f.instrs, ii, c)
                        changed = true
                    }
                }
            }
            ii = nxt
        }
    }
    << changed
}

fn mir_fold_trivial_branches(f $&MFn) bool {
    $changed := false
    for bi in 0:f.blocks.len {
        if f.is_self_loop(bi) { -> }
        if f.blocks[bi].tkind != 2 { -> }
        cond := f.blocks[bi].ta
        th := f.blocks[bi].tb
        el := f.blocks[bi].tc
        $jump := -1
        if th == el {
            jump = th
        } else if f.val_is_const(cond) {
            k := f.val_const(cond)
            if k != 0 { jump = th } else { jump = el }
        }
        if jump >= 0 {
            $b := f.blocks[bi]
            b.tkind = 1
            b.ta = jump
            b.tb = -1
            b.tc = -1
            mfn_set_block($&f.blocks, bi, b)
            changed = true
        }
    }
    << changed
}
