@xu/types

fn (f &MFn) pow2_shift(v int) int {
    if !f.val_is_const(v) { << -1 }
    k := f.val_const(v)
    if k < 2 { << -1 }
    if k > 4611686018427387904 { << -1 }
    $x := k
    $s := 0
    for _ in 0:63 {
        if x == 1 { << s }
        if (x / 2) * 2 != x { << -1 }
        x = x / 2
        s = s + 1
    }
    << -1
}

fn mir_pow2_shift(f &MFn, v int) int {
    << f.pow2_shift(v)
}

fn mir_fold_identities(f $&MFn) bool {
    // Slice header lives here (small frame). The binop folder is large;
    // Gen1 clobbers local []int headers in that size of function (same
    // split as mir_local_cse / mir_cse_step).
    nb := f.blocks.len
    nt := f.temps.len
    if nb == 0 || nt == 0 { << false }
    $can_inter := false
    if nb > 1 && nb * nt <= 65536 {
        can_inter = true
    }
    $out_def := []int{}
    $out_valid := []bool{}
    if can_inter {
        total := nb * nt
        for _ in 0:total {
            out_def.push(-1)
        }
        for _ in 0:nb {
            out_valid.push(false)
        }
    }
    $changed := false
    for bi in 0:nb {
        $last_def := []int{}
        for _ in 0:nt {
            last_def.push(-1)
        }
        if can_inter && bi > 0 {
            pred := f.strict_forward_pred(bi)
            if pred >= 0 && out_valid[pred] {
                pbase := pred * nt
                for t in 0:nt {
                    pd := out_def[pbase + t]
                    if pd >= 0 {
                        mfn_set_i($&last_def, t, pd)
                    }
                }
            }
        }
        if mir_fold_identities_block(f, bi, $&last_def) {
            changed = true
        }
        if can_inter {
            base := bi * nt
            for t in 0:nt {
                mfn_set_i($&out_def, base + t, last_def[t])
            }
            mfn_set_b($&out_valid, bi, true)
        }
    }
    << changed
}

fn mir_fold_identities_block(f $&MFn, bi int, last_def $&[]int) bool {
    $changed := false
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        nxt := f.instrs[ii].next
        k := f.instrs[ii].kind
        if k == 5 {
            if mir_fold_un_at(f, bi, ii, last_def) {
                changed = true
            }
        } else if k == 4 {
            if mir_fold_bin_at(f, bi, ii, last_def) {
                changed = true
            }
        }
        if mir_instr_has_dest(f.instrs[ii].kind) {
            da := f.instrs[ii].a
            if da >= 0 && da < last_def.len {
                mfn_set_i(last_def, da, ii)
            }
        }
        ii = nxt
    }
    << changed
}

fn mir_fold_is_fresh(f &MFn, bi int, x int, pi int, last_def &[]int) bool {
    if f.is_self_loop(bi) { << false }
    if x < 0 || x >= last_def.len { << true }
    if last_def[x] > pi { << false }
    << true
}

fn mir_invert_cmp_op(op int) int {
    if op == 6 { << 7 }
    if op == 7 { << 6 }
    if op == 8 { << 11 }
    if op == 9 { << 10 }
    if op == 10 { << 9 }
    if op == 11 { << 8 }
    << -1
}

fn mir_fold_un_at(f $&MFn, bi int, ii int, last_def $&[]int) bool {
    dest := f.instrs[ii].a
    op := f.instrs[ii].b
    srcv := f.instrs[ii].c
    $changed := false

    if f.val_is_const(srcv) {
        c := f.val_const(srcv)
        if op == 1 {
            cd := mir_cfg_const(f, 0 - c)
            mfn_become_copy($&f.instrs, ii, cd)
            changed = true
        } else if op == 2 {
            $inv_c := 0
            if c == 0 { inv_c = 1 }
            cd := mir_cfg_const(f, inv_c)
            mfn_become_copy($&f.instrs, ii, cd)
            changed = true
        }
    }

    if !changed && op == 2 && srcv >= 0 && srcv < last_def.len {
        pi := last_def[srcv]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && mir_is_cmp_op(f.instrs[pi].b) {
            x := f.instrs[pi].c
            y := f.instrs[pi].d
            $is_fp := false
            if (x >= 0 && x < f.temps.len && f.temps[x] == 4) || (y >= 0 && y < f.temps.len && f.temps[y] == 4) {
                is_fp = true
            }
            if !is_fp && mir_fold_is_fresh(&*f, bi, x, pi, last_def) && mir_fold_is_fresh(&*f, bi, y, pi, last_def) {
                inv_op := mir_invert_cmp_op(f.instrs[pi].b)
                if inv_op >= 0 {
                    mfn_become_bin($&f.instrs, ii, inv_op, x, y)
                    changed = true
                }
            }
        }
    }

    if !changed && (op == 1 || op == 2) && srcv >= 0 && srcv < last_def.len {
        pi := last_def[srcv]
        if pi >= 0 && f.instrs[pi].kind == MI_UN && f.instrs[pi].b == op {
            pc := f.instrs[pi].c
            if mir_fold_is_fresh(&*f, bi, pc, pi, last_def) {
                mfn_become_copy($&f.instrs, ii, pc)
                changed = true
            }
        }
    }

    if dest >= 0 && dest < last_def.len {
        mfn_set_i(last_def, dest, ii)
    }
    << changed
}

fn mir_fold_bin_at(f $&MFn, bi int, ii int, last_def $&[]int) bool {
    dest := f.instrs[ii].a
    op := f.instrs[ii].b
    lhs := f.instrs[ii].c
    rhs := f.instrs[ii].d
    if mir_fold_bin_to_copy(f, ii, dest, op, lhs, rhs) { << true }
    if dest < 0 || dest >= f.temps.len { << false }
    if !is_integer_type(f.temps[dest]) { << false }
    if mir_is_cmp_op(op) { << false }
    << mir_fold_bin_reshape(f, bi, ii, op, lhs, rhs, last_def)
}

fn mir_fold_copy_if(f $&MFn, ii int, src int, ok bool) bool {
    if !ok { << false }
    mfn_become_copy($&f.instrs, ii, src)
    << true
}

fn mir_fold_const_binop(f $&MFn, ii int, dest int, op int, lhs int, rhs int) bool {
    if !f.val_is_const(lhs) || !f.val_is_const(rhs) { << false }
    if dest < 0 || dest >= f.temps.len { << false }
    dty := f.temps[dest]
    is_cmp := mir_is_cmp_op(op)
    if is_cmp {
        if !is_integer_type(dty) && dty != 2 { << false }
    } else {
        if !is_integer_type(dty) { << false }
    }
    lv := f.val_const(lhs)
    rv := f.val_const(rhs)
    $res := 0
    $ok := false
    if op == 1 {
        res = lv + rv
        ok = true
    } else if op == 2 {
        res = lv - rv
        ok = true
    } else if op == 3 {
        res = lv * rv
        ok = true
    } else if op == 4 {
        if rv != 0 && !(lv == -9223372036854775807 - 1 && rv == -1) {
            res = lv / rv
            ok = true
        }
    } else if op == 5 {
        if rv != 0 && !(lv == -9223372036854775807 - 1 && rv == -1) {
            res = lv % rv
            ok = true
        }
    } else if op == 14 {
        res = lv & rv
        ok = true
    } else if op == 15 {
        res = lv | rv
        ok = true
    } else if op == 16 {
        res = lv ^ rv
        ok = true
    } else if op == 17 {
        if rv >= 0 && rv < 64 {
            res = lv << rv
            ok = true
        }
    } else if op == 18 {
        if rv >= 0 && rv < 64 {
            res = lv >> rv
            ok = true
        }
    } else if is_cmp {
        res = mir_eval_cmp(op, lv, rv)
        ok = true
    }
    if !ok { << false }
    cd := mir_cfg_const(f, res)
    mfn_become_copy($&f.instrs, ii, cd)
    << true
}

fn mir_fold_bin_to_copy(f $&MFn, ii int, dest int, op int, lhs int, rhs int) bool {
    if mir_fold_const_binop(f, ii, dest, op, lhs, rhs) { << true }
    if mir_is_cmp_op(op) && lhs == rhs {
        // The result is bool, so inspect the operand type. NaN makes
        // x==x / x<=x / x>=x false and x!=x true; identity alone is
        // insufficient to fold any floating comparison.
        if lhs >= 0 && lhs < f.temps.len && f.temps[lhs] == 4 { << false }
        $cv := 0
        if op == 6 || op == 9 || op == 11 {
            cv = 1
        }
        src := mir_cfg_const(f, cv)
        << mir_fold_copy_if(f, ii, src, true)
    }
    if dest < 0 || dest >= f.temps.len { << false }
    if !is_integer_type(f.temps[dest]) { << false }
    if mir_is_cmp_op(op) { << false }
    if op == 1 {
        if f.val_is_const_k(rhs, 0) { << mir_fold_copy_if(f, ii, lhs, true) }
        if f.val_is_const_k(lhs, 0) { << mir_fold_copy_if(f, ii, rhs, true) }
        << false
    }
    if op == 2 { << mir_fold_sub_to_copy(f, ii, lhs, rhs) }
    if op == 3 { << mir_fold_mul_to_copy(f, ii, lhs, rhs) }
    if op == 4 {
        if f.val_is_const_k(rhs, 1) { << mir_fold_copy_if(f, ii, lhs, true) }
        if f.val_is_const_k(lhs, 0) && f.val_is_const(rhs) && f.val_const(rhs) != 0 {
            << mir_fold_zero_copy(f, ii)
        }
        << false
    }
    if op == 5 {
        if f.val_is_const_k(rhs, 1) { << mir_fold_zero_copy(f, ii) }
        if f.val_is_const_k(lhs, 0) && f.val_is_const(rhs) && f.val_const(rhs) != 0 {
            << mir_fold_zero_copy(f, ii)
        }
        << false
    }
    if op == 15 { << mir_fold_or_to_copy(f, ii, lhs, rhs) }
    if op == 16 { << mir_fold_xor_to_copy(f, ii, lhs, rhs) }
    if op == 14 { << mir_fold_and_to_copy(f, ii, lhs, rhs) }
    if (op == 17 || op == 18) {
        if f.val_is_const_k(rhs, 0) { << mir_fold_copy_if(f, ii, lhs, true) }
        if f.val_is_const_k(lhs, 0) { << mir_fold_zero_copy(f, ii) }
    }
    if (op == 17 || op == 18) && f.val_is_const_k(lhs, 0) {
        << mir_fold_zero_copy(f, ii)
    }
    if op == 17 && f.val_is_const(rhs) && f.val_const(rhs) >= 64 {
        << mir_fold_zero_copy(f, ii)
    }
    << false
}

fn mir_fold_zero_copy(f $&MFn, ii int) bool {
    c0 := mir_cfg_const(f, 0)
    << mir_fold_copy_if(f, ii, c0, true)
}

fn mir_fold_sub_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) { << mir_fold_copy_if(f, ii, lhs, true) }
    if lhs == rhs && lhs >= 0 { << mir_fold_zero_copy(f, ii) }
    << false
}

fn mir_fold_mul_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 1) { << mir_fold_copy_if(f, ii, lhs, true) }
    if f.val_is_const_k(lhs, 1) { << mir_fold_copy_if(f, ii, rhs, true) }
    if f.val_is_const_k(rhs, 0) || f.val_is_const_k(lhs, 0) {
        << mir_fold_zero_copy(f, ii)
    }
    << false
}

fn mir_fold_or_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) || (lhs == rhs && lhs >= 0) {
        << mir_fold_copy_if(f, ii, lhs, true)
    }
    if f.val_is_const_k(lhs, 0) { << mir_fold_copy_if(f, ii, rhs, true) }
    if f.val_is_const_k(rhs, -1) { << mir_fold_copy_if(f, ii, rhs, true) }
    if f.val_is_const_k(lhs, -1) { << mir_fold_copy_if(f, ii, lhs, true) }
    << false
}

fn mir_fold_xor_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) { << mir_fold_copy_if(f, ii, lhs, true) }
    if f.val_is_const_k(lhs, 0) { << mir_fold_copy_if(f, ii, rhs, true) }
    if lhs == rhs && lhs >= 0 { << mir_fold_zero_copy(f, ii) }
    << false
}

fn mir_fold_and_to_copy(f $&MFn, ii int, lhs int, rhs int) bool {
    if f.val_is_const_k(rhs, 0) || f.val_is_const_k(lhs, 0) {
        << mir_fold_zero_copy(f, ii)
    }
    if lhs == rhs && lhs >= 0 { << mir_fold_copy_if(f, ii, lhs, true) }
    if f.val_is_const_k(rhs, -1) { << mir_fold_copy_if(f, ii, lhs, true) }
    if f.val_is_const_k(lhs, -1) { << mir_fold_copy_if(f, ii, rhs, true) }
    << false
}

fn mir_fold_temp_fresh(f &MFn, bi int, last_def &[]int, pi int, t int) bool {
    if f.is_self_loop(bi) { << false }
    if t < 0 { << true }
    if t >= last_def.len { << false }
    if last_def[t] > pi { << false }
    << true
}

fn mir_fold_absorb_and(f $&MFn, bi int, ii int, a int, b int, last_def &[]int) bool {
    // a & (a | y) -> a or (b | y) & b -> b
    if b >= 0 && b < last_def.len {
        pi := last_def[b]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 15 {
            if f.instrs[pi].c == a || f.instrs[pi].d == a {
                if mir_fold_temp_fresh(&*f, bi, last_def, pi, a) {
                    mfn_become_copy($&f.instrs, ii, a)
                    << true
                }
            }
        }
    }
    if a >= 0 && a < last_def.len {
        pi := last_def[a]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 15 {
            if f.instrs[pi].c == b || f.instrs[pi].d == b {
                if mir_fold_temp_fresh(&*f, bi, last_def, pi, b) {
                    mfn_become_copy($&f.instrs, ii, b)
                    << true
                }
            }
        }
    }
    << false
}

fn mir_fold_absorb_or(f $&MFn, bi int, ii int, a int, b int, last_def &[]int) bool {
    // a | (a & y) -> a or (b & y) | b -> b
    if b >= 0 && b < last_def.len {
        pi := last_def[b]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 14 {
            if f.instrs[pi].c == a || f.instrs[pi].d == a {
                if mir_fold_temp_fresh(&*f, bi, last_def, pi, a) {
                    mfn_become_copy($&f.instrs, ii, a)
                    << true
                }
            }
        }
    }
    if a >= 0 && a < last_def.len {
        pi := last_def[a]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 14 {
            if f.instrs[pi].c == b || f.instrs[pi].d == b {
                if mir_fold_temp_fresh(&*f, bi, last_def, pi, b) {
                    mfn_become_copy($&f.instrs, ii, b)
                    << true
                }
            }
        }
    }
    << false
}

fn mir_fold_cancel_xor(f $&MFn, bi int, ii int, a int, b int, last_def &[]int) bool {
    // (b ^ y) ^ b -> y or (x ^ b) ^ b -> x
    if a >= 0 && a < last_def.len {
        pi := last_def[a]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 16 {
            $y := 0 - 1
            if f.instrs[pi].c == b { y = f.instrs[pi].d }
            else if f.instrs[pi].d == b { y = f.instrs[pi].c }
            if y >= 0 && mir_fold_temp_fresh(&*f, bi, last_def, pi, y) {
                mfn_become_copy($&f.instrs, ii, y)
                << true
            }
        }
    }
    if b >= 0 && b < last_def.len {
        pi := last_def[b]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 16 {
            $y := 0 - 1
            if f.instrs[pi].c == a { y = f.instrs[pi].d }
            else if f.instrs[pi].d == a { y = f.instrs[pi].c }
            if y >= 0 && mir_fold_temp_fresh(&*f, bi, last_def, pi, y) {
                mfn_become_copy($&f.instrs, ii, y)
                << true
            }
        }
    }
    << false
}

fn mir_fold_cancel_sub(f $&MFn, bi int, ii int, a int, b int, last_def &[]int) bool {
    // (b + y) - b -> y or (x + b) - b -> x
    if a >= 0 && a < last_def.len {
        pi := last_def[a]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 1 {
            $y := 0 - 1
            if f.instrs[pi].c == b { y = f.instrs[pi].d }
            else if f.instrs[pi].d == b { y = f.instrs[pi].c }
            if (y <= -2) || (y >= 0 && mir_fold_temp_fresh(&*f, bi, last_def, pi, y)) {
                mfn_become_copy($&f.instrs, ii, y)
                << true
            }
        }
    }
    // a - (a - y) -> y
    if b >= 0 && b < last_def.len {
        pi := last_def[b]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 2 {
            if f.instrs[pi].c == a {
                y := f.instrs[pi].d
                if (y <= -2) || (y >= 0 && mir_fold_temp_fresh(&*f, bi, last_def, pi, y)) {
                    mfn_become_copy($&f.instrs, ii, y)
                    << true
                }
            }
        }
    }
    << false
}

fn mir_fold_cancel_add(f $&MFn, bi int, ii int, a int, b int, last_def &[]int) bool {
    // (x - b) + b -> x
    if a >= 0 && a < last_def.len {
        pi := last_def[a]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 2 {
            if f.instrs[pi].d == b {
                x := f.instrs[pi].c
                if (x <= -2) || (x >= 0 && mir_fold_temp_fresh(&*f, bi, last_def, pi, x)) {
                    mfn_become_copy($&f.instrs, ii, x)
                    << true
                }
            }
        }
    }
    // a + (x - a) -> x
    if b >= 0 && b < last_def.len {
        pi := last_def[b]
        if pi >= 0 && f.instrs[pi].kind == MI_BIN && f.instrs[pi].b == 2 {
            if f.instrs[pi].d == a {
                x := f.instrs[pi].c
                if (x <= -2) || (x >= 0 && mir_fold_temp_fresh(&*f, bi, last_def, pi, x)) {
                    mfn_become_copy($&f.instrs, ii, x)
                    << true
                }
            }
        }
    }
    << false
}

fn mir_decompose_mul_const(f &MFn, bi int, last_def &[]int, val int, out_var $&int, out_c $&int) bool {
    if val < 0 || val >= last_def.len { << false }
    pi := last_def[val]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != 3 { << false }
    l := f.instrs[pi].c
    r := f.instrs[pi].d
    if l >= 0 && f.val_is_const(r) {
        if mir_fold_is_fresh(f, bi, l, pi, last_def) {
            *out_var = l
            *out_c = f.val_const(r)
            << true
        }
    } else if r >= 0 && f.val_is_const(l) {
        if mir_fold_is_fresh(f, bi, r, pi, last_def) {
            *out_var = r
            *out_c = f.val_const(l)
            << true
        }
    }
    << false
}

fn mir_fold_factor_emit(f $&MFn, ii int, a int, factor int) bool {
    if factor == 0 {
        << mir_fold_zero_copy(f, ii)
    }
    if factor == 1 {
        << mir_fold_copy_if(f, ii, a, true)
    }
    if factor == -1 {
        mfn_become_un($&f.instrs, ii, 1, a)
        << true
    }
    cd := mir_cfg_const(f, factor)
    sh := f.pow2_shift(cd)
    if sh >= 0 {
        scd := mir_cfg_const(f, sh)
        mfn_set_bcd($&f.instrs, ii, 17, a, scd)
        << true
    }
    mfn_set_bcd($&f.instrs, ii, 3, a, cd)
    << true
}

fn mir_fold_distrib_add(f $&MFn, bi int, ii int, lhs int, rhs int, last_def &[]int) bool {
    $la := -1
    $lc := 0
    l_mul := mir_decompose_mul_const(&*f, bi, last_def, lhs, $&la, $&lc)
    $ra := -1
    $rc := 0
    r_mul := mir_decompose_mul_const(&*f, bi, last_def, rhs, $&ra, $&rc)

    if l_mul && r_mul && la == ra {
        << mir_fold_factor_emit(f, ii, la, lc + rc)
    }
    if l_mul && la == rhs {
        << mir_fold_factor_emit(f, ii, rhs, lc + 1)
    }
    if r_mul && ra == lhs {
        << mir_fold_factor_emit(f, ii, lhs, rc + 1)
    }
    << false
}

fn mir_fold_distrib_sub(f $&MFn, bi int, ii int, lhs int, rhs int, last_def &[]int) bool {
    $la := -1
    $lc := 0
    l_mul := mir_decompose_mul_const(&*f, bi, last_def, lhs, $&la, $&lc)
    $ra := -1
    $rc := 0
    r_mul := mir_decompose_mul_const(&*f, bi, last_def, rhs, $&ra, $&rc)

    if l_mul && r_mul && la == ra {
        << mir_fold_factor_emit(f, ii, la, lc - rc)
    }
    if l_mul && la == rhs {
        << mir_fold_factor_emit(f, ii, rhs, lc - 1)
    }
    if r_mul && ra == lhs {
        << mir_fold_factor_emit(f, ii, lhs, 1 - rc)
    }
    << false
}

fn mir_fold_bin_reshape(f $&MFn, bi int, ii int, op int, lhs int, rhs int, last_def $&[]int) bool {
    $changed := false
    if op == 3 {
        if mir_fold_assoc_chain(f, bi, ii, 3, lhs, rhs, last_def) { changed = true }
        cur_l := f.instrs[ii].c
        cur_r := f.instrs[ii].d
        if mir_fold_mul_pow2(f, ii, cur_l, cur_r) { changed = true }
    } else if op == 1 {
        if mir_fold_add_mixed_chain(f, bi, ii, lhs, rhs, last_def) { << true }
        if mir_fold_assoc_chain(f, bi, ii, 1, lhs, rhs, last_def) { changed = true }
        cur_l := f.instrs[ii].c
        cur_r := f.instrs[ii].d
        if cur_l == cur_r && cur_l >= 0 {
            cd := mir_cfg_const(f, 1)
            mfn_set_bd($&f.instrs, ii, 17, cd)
            changed = true
        }
    } else if op == 2 {
        if mir_fold_sub_chain(f, bi, ii, lhs, rhs, last_def) { << true }
    } else if op == 14 || op == 15 || op == 16 {
        if mir_fold_assoc_chain(f, bi, ii, op, lhs, rhs, last_def) { changed = true }
    } else if op == 17 || op == 18 {
        if mir_fold_shift_chain(f, bi, ii, op, lhs, rhs, last_def) { changed = true }
    }
    if op == 1 {
        if mir_fold_distrib_add(f, bi, ii, lhs, rhs, last_def) { << true }
        if mir_fold_cancel_add(f, bi, ii, lhs, rhs, last_def) { << true }
    }
    if op == 2 {
        if mir_fold_distrib_sub(f, bi, ii, lhs, rhs, last_def) { << true }
        if mir_fold_cancel_sub(f, bi, ii, lhs, rhs, last_def) { << true }
    }
    if op == 14 {
        if mir_fold_absorb_and(f, bi, ii, lhs, rhs, last_def) { << true }
    }
    if op == 15 {
        if mir_fold_absorb_or(f, bi, ii, lhs, rhs, last_def) { << true }
    }
    if op == 16 {
        if mir_fold_cancel_xor(f, bi, ii, lhs, rhs, last_def) { << true }
    }
    if op == 17 || op == 18 {
        if mir_fold_shift_chain(f, bi, ii, op, lhs, rhs, last_def) { changed = true }
    }
    << changed
}

fn mir_fold_mul_pow2(f $&MFn, ii int, lhs int, rhs int) bool {
    $sh := f.pow2_shift(rhs)
    if sh >= 0 {
        cd := mir_cfg_const(f, sh)
        mfn_set_bd($&f.instrs, ii, 17, cd)
        << true
    }
    sh = f.pow2_shift(lhs)
    if sh < 0 { << false }
    cd := mir_cfg_const(f, sh)
    mfn_set_bcd($&f.instrs, ii, 17, rhs, cd)
    << true
}

fn mir_fold_assoc_chain(f $&MFn, bi int, ii int, op int, lhs int, rhs int, last_def $&[]int) bool {
    $t := 0 - 1
    $c2 := 0
    $okc := false
    if lhs >= 0 && f.val_is_const(rhs) {
        t = lhs
        c2 = f.val_const(rhs)
        okc = true
    } else if rhs >= 0 && f.val_is_const(lhs) {
        t = rhs
        c2 = f.val_const(lhs)
        okc = true
    }
    if !okc || t < 0 || t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != op { << false }
    il := f.instrs[pi].c
    ir := f.instrs[pi].d
    $x := 0 - 1
    $c1 := 0
    $ok1 := false
    if il >= 0 && f.val_is_const(ir) {
        x = il
        c1 = f.val_const(ir)
        ok1 = true
    } else if ir >= 0 && f.val_is_const(il) {
        x = ir
        c1 = f.val_const(il)
        ok1 = true
    }
    if !ok1 { << false }
    $stale := f.is_self_loop(bi)
    if !stale && x >= 0 && x < last_def.len {
        if last_def[x] > pi {
            stale = true
        }
    }
    if stale { << false }
    $c_new := 0
    if op == 1 {
        c_new = c1 + c2
    } else if op == 3 {
        c_new = c1 * c2
    } else if op == 14 {
        c_new = c1 & c2
    } else if op == 15 {
        c_new = c1 | c2
    } else if op == 16 {
        c_new = c1 ^ c2
    } else {
        << false
    }
    cd := mir_cfg_const(f, c_new)
    mfn_set_cd($&f.instrs, ii, x, cd)
    << true
}

fn mir_fold_sub_chain(f $&MFn, bi int, ii int, lhs int, rhs int, last_def $&[]int) bool {
    if lhs < 0 || !f.val_is_const(rhs) { << false }
    t := lhs
    c2 := f.val_const(rhs)
    if t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN { << false }
    pb := f.instrs[pi].b
    if pb == 2 {
        // (x - c1) - c2 -> x - (c1 + c2)
        x := f.instrs[pi].c
        ir := f.instrs[pi].d
        if x < 0 || !f.val_is_const(ir) { << false }
        c1 := f.val_const(ir)
        $stale := f.is_self_loop(bi)
        if !stale && x >= 0 && x < last_def.len {
            if last_def[x] > pi { stale = true }
        }
        if stale { << false }
        cd := mir_cfg_const(f, c1 + c2)
        mfn_set_cd($&f.instrs, ii, x, cd)
        << true
    } else if pb == 1 {
        // (x + c1) - c2 -> x + (c1 - c2) or x - (c2 - c1) or x
        $x := -1
        $c1 := 0
        $ok := false
        if f.val_is_const(f.instrs[pi].d) {
            x = f.instrs[pi].c
            c1 = f.val_const(f.instrs[pi].d)
            ok = true
        } else if f.val_is_const(f.instrs[pi].c) {
            x = f.instrs[pi].d
            c1 = f.val_const(f.instrs[pi].c)
            ok = true
        }
        if !ok || x < 0 { << false }
        $stale := f.is_self_loop(bi)
        if !stale && x >= 0 && x < last_def.len {
            if last_def[x] > pi { stale = true }
        }
        if stale { << false }
        if c1 == c2 {
            mfn_become_copy($&f.instrs, ii, x)
            << true
        } else if c1 > c2 {
            cd := mir_cfg_const(f, c1 - c2)
            mfn_set_bcd($&f.instrs, ii, 1, x, cd)
            << true
        } else {
            cd := mir_cfg_const(f, c2 - c1)
            mfn_set_bcd($&f.instrs, ii, 2, x, cd)
            << true
        }
    }
    << false
}

fn mir_fold_add_mixed_chain(f $&MFn, bi int, ii int, lhs int, rhs int, last_def $&[]int) bool {
    // (x - c1) + c2 -> x + (c2 - c1) or x - (c1 - c2) or x
    $t := -1
    $c2 := 0
    $okc := false
    if lhs >= 0 && f.val_is_const(rhs) {
        t = lhs
        c2 = f.val_const(rhs)
        okc = true
    } else if rhs >= 0 && f.val_is_const(lhs) {
        t = rhs
        c2 = f.val_const(lhs)
        okc = true
    }
    if !okc || t < 0 || t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != 2 { << false }
    x := f.instrs[pi].c
    ir := f.instrs[pi].d
    if x < 0 || !f.val_is_const(ir) { << false }
    c1 := f.val_const(ir)
    $stale := f.is_self_loop(bi)
    if !stale && x >= 0 && x < last_def.len {
        if last_def[x] > pi { stale = true }
    }
    if stale { << false }
    if c1 == c2 {
        mfn_become_copy($&f.instrs, ii, x)
        << true
    } else if c2 > c1 {
        cd := mir_cfg_const(f, c2 - c1)
        mfn_set_bcd($&f.instrs, ii, 1, x, cd)
        << true
    } else {
        cd := mir_cfg_const(f, c1 - c2)
        mfn_set_bcd($&f.instrs, ii, 2, x, cd)
        << true
    }
}

fn mir_fold_shift_chain(f $&MFn, bi int, ii int, op int, lhs int, rhs int, last_def $&[]int) bool {
    // (x << c1) << c2 -> x << (c1 + c2)
    // (x >> c1) >> c2 -> x >> (c1 + c2)
    if lhs < 0 || !f.val_is_const(rhs) { << false }
    t := lhs
    c2 := f.val_const(rhs)
    if c2 < 0 || c2 >= 64 { << false }
    if t >= last_def.len { << false }
    pi := last_def[t]
    if pi < 0 || f.instrs[pi].kind != MI_BIN || f.instrs[pi].b != op { << false }
    x := f.instrs[pi].c
    ir := f.instrs[pi].d
    if x < 0 || !f.val_is_const(ir) { << false }
    c1 := f.val_const(ir)
    if c1 < 0 || c1 >= 64 { << false }
    tot := c1 + c2
    if tot >= 64 { << false }
    $stale := f.is_self_loop(bi)
    if !stale && x >= 0 && x < last_def.len {
        if last_def[x] > pi {
            stale = true
        }
    }
    if stale { << false }
    cd := mir_cfg_const(f, tot)
    mfn_set_cd($&f.instrs, ii, x, cd)
    << true
}

fn mir_fold_const_cmps(f $&MFn) bool {
    $changed := false
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := f.instrs[ii].next
            if f.instrs[ii].kind == MI_BIN && mir_is_cmp_op(f.instrs[ii].b) {
                lhs := f.instrs[ii].c
                rhs := f.instrs[ii].d
                $lok := false
                $rok := false
                $lv := 0
                $rv := 0
                if lhs <= -2 {
                    li := 0 - lhs - 2
                    if li >= 0 && li < f.consts.len {
                        lok = true
                        lv = f.consts[li]
                    }
                }
                if rhs <= -2 {
                    ri := 0 - rhs - 2
                    if ri >= 0 && ri < f.consts.len {
                        rok = true
                        rv = f.consts[ri]
                    }
                }
                if lok && rok {
                    cv := mir_eval_cmp(f.instrs[ii].b, lv, rv)
                    c := mir_cfg_const(f, cv)
                    mfn_become_copy($&f.instrs, ii, c)
                    changed = true
                } else if lhs >= 0 && lhs == rhs && lhs < f.temps.len {
                    lty := f.temps[lhs]
                    if is_integer_type(lty) || lty == 2 {
                        cv := mir_eval_cmp(f.instrs[ii].b, 0, 0)
                        c := mir_cfg_const(f, cv)
                        mfn_become_copy($&f.instrs, ii, c)
                        changed = true
                    }
                }
            }
            ii = nxt
        }
    }
    << changed
}

fn mir_fold_trivial_branches(f $&MFn) bool {
    $changed := false
    for bi in 0:f.blocks.len {
        if f.is_self_loop(bi) { -> }
        if f.blocks[bi].tkind != 2 { -> }
        cond := f.blocks[bi].ta
        th := f.blocks[bi].tb
        el := f.blocks[bi].tc
        $jump := -1
        if th == el {
            jump = th
        } else {
            th_eff := f.skip_empty_jumps(th)
            el_eff := f.skip_empty_jumps(el)
            if th_eff >= 0 && th_eff == el_eff {
                jump = th_eff
            } else if f.val_is_const(cond) {
                k := f.val_const(cond)
                if k != 0 {
                    jump = th
                    if th_eff >= 0 { jump = th_eff }
                } else {
                    jump = el
                    if el_eff >= 0 { jump = el_eff }
                }
            }
        }
        if jump >= 0 {
            $b := f.blocks[bi]
            b.tkind = 1
            b.ta = jump
            b.tb = -1
            b.tc = -1
            mfn_set_block($&f.blocks, bi, b)
            changed = true
        }
    }
    << changed
}
