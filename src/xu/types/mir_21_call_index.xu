@xu/types

// One immutable emission-unit borrow: retain numeric function identities,
// never label owners or references into a large MFn. Optional caps bound the
// cache itself; an oversized unit uses the unchanged legacy resolver.
const MIR_CALL_INDEX_FN_CAP = 65536
const MIR_CALL_INDEX_BYTE_CAP = 16777216

pub struct MirCallIndex {
    nf int
    buckets []int
    next []int
    hashes []int
    lengths []int
}

fn mir_call_index_instr_hash(m &Mir, fi int, ii int, n int) int {
    $h := 5381
    for j in 0:n {
        h = (((h << 5) + h) + (mir_isval_byte(m, fi, ii, j) & 255)) & 2147483647
    }
    << h
}

fn mir_call_index_fn_hash(m &Mir, fi int, n int) int {
    $h := 5381
    for j in 0:n {
        h = (((h << 5) + h) + (mir_fn_label_byte(m, fi, j) & 255)) & 2147483647
    }
    << h
}

pub fn new_mir_call_index(m &Mir) MirCallIndex {
    $idx := MirCallIndex{nf: -1, buckets: []int{}, next: []int{}, hashes: []int{}, lengths: []int{}}
    nf := m.fns.len
    if nf < 0 || nf > MIR_CALL_INDEX_FN_CAP { << idx }
    $bytes := 0
    for j in 0:nf {
        if mir_fn_is_extern(m, j) { -> }
        n := mir_fn_label_len(m, j)
        // No valid direct Call can match labels outside this domain.
        if n <= 0 || n > MIR_VERIFY_MAX_ARG_CHAIN { -> }
        if bytes > MIR_CALL_INDEX_BYTE_CAP - n { << idx }
        bytes += n
    }
    $nb := 1
    while nb < nf * 2 { nb *= 2 }
    for _ in 0:nb { idx.buckets.push(-1) }
    for _ in 0:nf {
        idx.next.push(-1)
        idx.hashes.push(0)
        idx.lengths.push(0)
    }
    for j in 0:nf {
        if mir_fn_is_extern(m, j) { -> }
        n := mir_fn_label_len(m, j)
        if n <= 0 || n > MIR_VERIFY_MAX_ARG_CHAIN { -> }
        h := mir_call_index_fn_hash(m, j, n)
        bucket := h & (nb - 1)
        idx.next[j] = idx.buckets[bucket]
        idx.buckets[bucket] = j
        idx.hashes[j] = h
        idx.lengths[j] = n
    }
    idx.nf = nf
    << idx
}

// The unit must stay immutable between construction and consumption. The
// emitter holds the same &Mir for both; no cache is attached to Mir/MFn and
// no optimizer can leave it stale across a commit or generation.
fn mir_verify_emission_direct_call_indexed(m &Mir, fi int, ii int, head int, idx &MirCallIndex) bool {
    nf := m.fns.len
    nb := idx.buckets.len
    if idx.nf != nf || idx.nf < 0 || nf > MIR_CALL_INDEX_FN_CAP || nb <= 0 || nb > MIR_CALL_INDEX_FN_CAP * 2 || (nb & (nb - 1)) != 0 || idx.next.len != nf || idx.hashes.len != nf || idx.lengths.len != nf {
        << mir_verify_emission_direct_call(m, fi, ii, head)
    }
    n := mir_isval_len(m, fi, ii)
    if n <= 0 || n > MIR_VERIFY_MAX_ARG_CHAIN { << false }
    h := mir_call_index_instr_hash(m, fi, ii, n)
    $at := idx.buckets[h & (nb - 1)]
    $matched := false
    $arity_ok := false
    // Chains can contain hash collisions and duplicate labels. Bound even a
    // malformed chain, check exact bytes, and visit every matching signature:
    // any valid arity suffices, but an invalid matching nparams must reject.
    for _ in 0:nf {
        if at == -1 { << !matched || arity_ok }
        if at < 0 || at >= nf { << false }
        if idx.hashes[at] == h && idx.lengths[at] == n {
            $same := !mir_fn_is_extern(m, at) && mir_fn_label_len(m, at) == n
            for j in 0:n {
                if !same { <- }
                if mir_fn_label_byte(m, at, j) != mir_isval_byte(m, fi, ii, j) { same = false }
            }
            if same {
                matched = true
                np := mir_fn_nparams(m, at)
                if np < 0 || np > MIR_VERIFY_MAX_ARG_CHAIN { << false }
                if mir_verify_emission_arg_count(m, fi, head, np, np) { arity_ok = true }
            }
        }
        at = idx.next[at]
    }
    << at == -1 && (!matched || arity_ok)
}

pub fn mir_call_index_find_label(m &Mir, idx &MirCallIndex, lab string) int {
    nf := idx.nf
    nb := idx.buckets.len
    if nf <= 0 || nb <= 0 { << -1 }
    n := lab.len
    if n <= 0 || n > MIR_VERIFY_MAX_ARG_CHAIN { << -1 }
    $h := 5381
    for j in 0:n {
        h = (((h << 5) + h) + (lab[j] & 255)) & 2147483647
    }
    $at := idx.buckets[h & (nb - 1)]
    for _ in 0:nf {
        if at < 0 || at >= nf { << -1 }
        if idx.hashes[at] == h && idx.lengths[at] == n {
            if m.fns[at].label == lab {
                << at
            }
        }
        at = idx.next[at]
    }
    << -1
}
