@xu/types

// Final MIR-to-emitter promotion for scalar stack locals. Keep this pass
// after SimplifyCFG/O3 unroll: those transformations intentionally match
// LoadLocal/StoreLocal slot shapes. Promotion commits formal SSA versions and
// Phi metadata to MFn; a separate whole-program destruction pass later lowers
// them to Copy edges before the legacy emitter.

// Keep the temporary bit/data-flow arena bounded independently of the raw
// vector lengths.  The verifier admits at most 4096 blocks and 1M locals, but
// their Cartesian product would still be an attacker-sized allocation here.
// These limits are deliberately shared with the verifier's dense matrices.
const mir_promote_max_matrix = 16777216
const mir_promote_max_work = 67108864

fn mir_local_promotion_scalar(ty int) bool {
    // One-slot scalar classes with a complete emitter/register contract.
    // f64 uses the independent FP home bank (d2-d7 / xmm2-xmm5); it is
    // admitted only when all of the existing escape/CFG gates below pass.
    // References, channels, maps and boxes remain frame-backed because their
    // ownership/call ABI is not part of this promotion phase.
    << mir_scalar_ty(ty)
}

// Promotion rewrites only LoadLocal/StoreLocal of eligible scalars. Aggregate
// temps (nbody `Body` copies, `[N]T` descriptors) and field/index/Call ops
// stay in place; they must not abort the whole function. Escape scanning
// still strips address-taken locals.
fn mir_promote_body_kind_ok(k int) bool {
    if k >= 1 && k <= 5 { << true }
    if k == 0 || k == 7 || k == 8 { << true }
    if k == 10 || k == 11 || k == 12 || k == 13 || k == 14 || k == 16 || k == 17 || k == 18 { << true }
    if k == 20 || k == 23 || k == 25 || k == 26 || k == 47 || k == 48 { << true }
    << false
}

fn mir_promote_kind_scalar_only(k int) bool {
    // Keep calls outside this all-ALU promotion class. Even a scalar
    // println/runtime call is an ABI barrier, and routing the surrounding
    // loop through fixed homes currently adds more edge copies than the
    // legacy cache saves. Direct user-call promotion remains a separate,
    // explicitly admitted shape when its whole CFG is already scalar.
    << k == 1 || k == 2 || k == 3 || k == 4 || k == 5
}

// Intrinsic calls are lowered to ABI-free instructions by the emitter. Keep
// them eligible for scalar promotion, while requiring a function-level
// intrinsic witness before allowing a trailing println barrier. This avoids
// routing an ordinary loop through fixed homes merely because it prints at
// the end, but still removes local stack traffic from math-heavy kernels.
// Compare borrowed instruction labels without a string-valued getter. The
// instruction buffer owns them throughout the promotion pass.
fn mir_promote_sval_eq_lit(s &string, literal string) bool {
    if s.len != literal.len { << false }
    for i in 0:literal.len {
        if s[i] != literal[i] { << false }
    }
    << true
}

fn mir_promote_math_label_instr(ins &[]MInstr, ii int) bool {
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_sqrt") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_leading_zeros") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_trailing_zeros") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_reverse") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_reverse_bytes") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_ones_count") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_rotate_left") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_rotate_right") { << true }
    if mir_promote_sval_eq_lit(&ins[ii].sval, "_xu_math_bits_len") { << true }
    << false
}

fn mir_promote_call_terminal_f(f &MFn, ii int) bool {
    for bi in 0:f.blocks.len {
        if f.blocks[bi].tail == ii { << true }
    }
    << false
}

fn mir_promote_scalar_call_f(f &MFn, ii int) bool {
    if mfn_ikind(&f.instrs, ii) != 7 { << false }
    ck := mfn_ib(&f.instrs, ii)
    if (ck == 2 || ck == 3 || ck == 4 || ck == 5 || ck == 22) && mir_promote_call_terminal_f(&*f, ii) { << true }
    << ck == 1 && mir_promote_math_label_instr(&f.instrs, ii)
}

fn mir_promote_has_math_call_f(f &MFn) bool {
    for ii in 0:f.instrs.len {
        if mfn_ikind(&f.instrs, ii) != 7 { -> }
        if mfn_ib(&f.instrs, ii) != 1 { -> }
        if mir_promote_math_label_instr(&f.instrs, ii) {
            << true
        }
    }
    << false
}

// MFn fields in Mir.fns use buffer layout. Do not pass the address of
// their array descriptor to the frame-layout &[]MInstr helper.
fn mir_promote_sval_eq_lit_m(m &Mir, fi int, ii int, literal string) bool {
    if mir_isval_len(m, fi, ii) != literal.len { << false }
    for j in 0:literal.len {
        if mir_isval_byte(m, fi, ii, j) != literal[j] { << false }
    }
    << true
}

fn mir_promote_math_label_m(m &Mir, fi int, ii int) bool {
    if mir_ikind(m, fi, ii) != 7 || mir_ib(m, fi, ii) != 1 { << false }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_sqrt") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_leading_zeros") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_trailing_zeros") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_reverse") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_reverse_bytes") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_ones_count") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_rotate_left") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_rotate_right") { << true }
    if mir_promote_sval_eq_lit_m(m, fi, ii, "_xu_math_bits_len") { << true }
    << false
}

fn mir_promote_scalar_call_m(m &Mir, fi int, ii int) bool {
    if mir_ikind(m, fi, ii) != 7 { << false }
    ck := mir_ib(m, fi, ii)
    if (ck == 2 || ck == 3 || ck == 4 || ck == 5 || ck == 22) && mir_promote_call_terminal_m(m, fi, ii) { << true }
    << mir_promote_math_label_m(m, fi, ii)
}

fn mir_promote_has_math_call_m(m &Mir, fi int) bool {
    for ii in 0:mir_nins(m, fi) {
        if mir_promote_math_label_m(m, fi, ii) { << true }
    }
    << false
}

fn mir_promote_call_terminal_m(m &Mir, fi int, ii int) bool {
    for bi in 0:mir_nblocks(m, fi) {
        if mir_btail(m, fi, bi) == ii { << true }
    }
    << false
}

// Open mixed temps + FieldRMW/ElemAddr kinds only for f64 field-update
// kernels. loop_sum / f64_sum stay on the old all-scalar, kind 1-5 path so
// their SIMD/skip-store leaf is not rewritten into stack Copies.
fn mir_promote_mixed_shape_f(f &MFn) bool {
    mut has_f64 := false
    mut has_frmw := false
    mut other_st := false
    for i in 0:f.locals.len {
        if f.locals[i] == 4 { has_f64 = true }
    }
    for i in 0:f.temps.len {
        if f.temps[i] == 4 { has_f64 = true }
    }
    if !has_f64 { << false }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := mfn_ikind(&f.instrs, ii)
            if ik == 48 || ik == 25 || ik == 18 { has_frmw = true }
            if ik == 11 || ik == 13 || ik == 20 || ik == 46 || ik == 47 { other_st = true }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << has_frmw && !other_st
}

// f64 scalars plus byte/int LoadIndex/StoreIndex.
// Not FieldRMW (that shape rejects StoreIndex) and not the f64 index-acc
// kernel (`[]f64` stores stay on their own path).
fn mir_promote_f64_byte_index_shape_f(f &MFn) bool {
    mut has_f64 := false
    mut has_idx := false
    mut f64_idx := false
    mut other_st := false
    for i in 0:f.locals.len {
        if f.locals[i] == 4 { has_f64 = true }
    }
    for i in 0:f.temps.len {
        if f.temps[i] == 4 { has_f64 = true }
    }
    if !has_f64 { << false }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := mfn_ikind(&f.instrs, ii)
            if ik == 14 {
                has_idx = true
                d := mfn_ia(&f.instrs, ii)
                if d >= 0 && d < f.temps.len && f.temps[d] == 4 { f64_idx = true }
            }
            if ik == 20 {
                has_idx = true
                v := mfn_ic(&f.instrs, ii)
                if v >= 0 && v < f.temps.len && f.temps[v] == 4 { f64_idx = true }
            }
            if ik == 11 || ik == 13 || ik == 18 || ik == 25 || ik == 46 || ik == 47 || ik == 48 {
                other_st = true
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << has_f64 && has_idx && !f64_idx && !other_st
}

// Mixed integer-index promotion currently relies on stable descriptor shape.
// Growth needs a separate SSA-aware loop/emission proof; keep its legacy path
// without using verifier rejection as an accidental profitability gate.
fn mir_promote_int_index_shape_f(f &MFn) bool {
    mut has_f64 := false
    mut has_i64 := false
    mut has_ld := false
    mut has_st := false
    mut other_st := false
    for i in 0:f.locals.len {
        if f.locals[i] == 4 { has_f64 = true }
        if f.locals[i] == 1 { has_i64 = true }
    }
    for i in 0:f.temps.len {
        if f.temps[i] == 4 { has_f64 = true }
        if f.temps[i] == 1 { has_i64 = true }
    }
    if has_f64 || !has_i64 { << false }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := mfn_ikind(&f.instrs, ii)
            if ik == 14 || ik == 17 || ik == 23 { has_ld = true }
            if ik == 20 || ik == 18 { has_st = true }
            if ik == 47 {
                has_ld = true
                has_st = true
            }
            if ik == 13 || ik == 25 || ik == 46 || ik == 48 {
                other_st = true
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << has_ld && has_st && !other_st
}

fn mir_promote_f64_index_shape_f(f &MFn) bool {
    mut has_f64 := false
    mut has_ld := false
    mut other_st := false
    for i in 0:f.locals.len {
        if f.locals[i] == 4 { has_f64 = true }
    }
    for i in 0:f.temps.len {
        if f.temps[i] == 4 { has_f64 = true }
    }
    if !has_f64 { << false }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ik := mfn_ikind(&f.instrs, ii)
            if ik == 14 { has_ld = true }
            if ik == 47 { has_ld = true }
            if ik == 25 || ik == 46 || ik == 48 {
                other_st = true
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << has_ld && !other_st
}

fn mir_promote_edge_to(f &MFn, from int, to int) bool {
    tk := f.blocks[from].tkind
    if tk == 1 { << f.blocks[from].ta == to }
    if tk == 2 { << f.blocks[from].tb == to || f.blocks[from].tc == to }
    << false
}

fn mir_promote_escape_local_f(f &MFn, ii int) int {
    k := mfn_ikind(&f.instrs, ii)
    ia := mfn_ia(&f.instrs, ii)
    ib := mfn_ib(&f.instrs, ii)
    ic := mfn_ic(&f.instrs, ii)
    if k == 8 { << ia }
    if k == 16 && ic == 0 { << ib }
    // Optimized indexed bases may name a frame local directly.
    mut base := -1
    if k == 14 || k == 23 { base = ib }
    if k == 20 || k == 47 { base = ia }
    if base >= mir_local_operand_base { << base - mir_local_operand_base }
    << -1
}

fn mir_promote_escape_local_m(m &Mir, fi int, ii int) int {
    k := mir_ikind(m, fi, ii)
    ia := mir_ia(m, fi, ii)
    ib := mir_ib(m, fi, ii)
    ic := mir_ic(m, fi, ii)
    if k == 8 { << ia }
    if k == 16 && ic == 0 { << ib }
    mut base := -1
    if k == 14 || k == 23 { base = ib }
    if k == 20 || k == 47 { base = ia }
    if base >= mir_local_operand_base { << base - mir_local_operand_base }
    << -1
}

// Keep every packed word non-negative under the signed 64-bit Xu `int`.
// Using 62 payload bits also preserves the old hosted compiler's shift rules
// while removing the former whole-function 62-local / 62-block limit.
fn mir_promote_words(n int) int {
    mut nw := n / 62
    if n % 62 != 0 { nw += 1 }
    << nw
}

fn mir_promote_bit_has(a &[]int, off int, id int) bool {
    wi := id / 62
    mask := 1 << (id % 62)
    << (mfn_get_i(a, off + wi) & mask) != 0
}

fn mir_promote_bit_add(a &mut []int, off int, id int) {
    wi := id / 62
    at := off + wi
    mask := 1 << (id % 62)
    mfn_set_i(a, at, mfn_get_i(&*a, at) | mask)
}

fn mir_promote_bit_del(a &mut []int, off int, id int) {
    wi := id / 62
    at := off + wi
    mask := 1 << (id % 62)
    mfn_set_i(a, at, mfn_get_i(&*a, at) & (0 - mask - 1))
}

fn mir_promote_bits_any(a &[]int, off int, nw int) bool {
    for wi in 0:nw {
        if mfn_get_i(a, off + wi) != 0 { << true }
    }
    << false
}

// A promotion run is the only phase that promises SSA-shaped temporaries.
// Keep malformed legacy MIR fail-closed before allocating fresh versions;
// otherwise a duplicate old TempId could be mistaken for a Phi input and the
// fixed-home allocator would observe an ambiguous definition.

// Promote eligible locals into MFn's formal SSA/Phi dialect. A StoreLocal gets
// a distinct TempId version and a live merge gets a persistent Phi TempId with
// one incoming value per predecessor. The independent mir_phi_elim_f stage is
// solely responsible for inserting edge copies and splitting critical edges.
fn mir_promote_must_store_f(f &MFn, work &mut []int, nblk int, nloc int, lw int, reach_off int, bdef_off int, must_in_off int, must_out_off int) {
    // Must-store dataflow: all non-entry blocks start at top and converge by
    // predecessor intersection.  This is also the uninitialized-read guard.
    for bi in 0:nblk {
        if !mir_promote_bit_has(&*work, reach_off, bi) { -> }
        for wi in 0:lw {
            mut top := (1 << 62) - 1
            tail := nloc % 62
            if wi == lw - 1 && tail != 0 { top = (1 << tail) - 1 }
            if bi != 0 { mfn_set_i(mut &*work, must_in_off + bi * lw + wi, top) }
            mv := mfn_get_i(&*work, must_in_off + bi * lw + wi) | mfn_get_i(&*work, bdef_off + bi * lw + wi)
            mfn_set_i(mut &*work, must_out_off + bi * lw + wi, mv)
        }
    }
    for _ in 0:nblk + 1 {
        mut changed := false
        for bi in 0:nblk {
            if !mir_promote_bit_has(&*work, reach_off, bi) { -> }
            for wi in 0:lw {
                mut nv := 0
                if bi != 0 {
                    mut have := false
                    for pi in 0:nblk {
                        if mir_promote_bit_has(&*work, reach_off, pi) && mir_promote_edge_to(f, pi, bi) {
                            if !have {
                                nv = mfn_get_i(&*work, must_out_off + pi * lw + wi)
                                have = true
                            } else {
                                nv = nv & mfn_get_i(&*work, must_out_off + pi * lw + wi)
                            }
                        }
                    }
                    if !have { nv = 0 }
                }
                ov := nv | mfn_get_i(&*work, bdef_off + bi * lw + wi)
                if mfn_get_i(&*work, must_in_off + bi * lw + wi) != nv {
                    mfn_set_i(mut &*work, must_in_off + bi * lw + wi, nv)
                    changed = true
                }
                if mfn_get_i(&*work, must_out_off + bi * lw + wi) != ov {
                    mfn_set_i(mut &*work, must_out_off + bi * lw + wi, ov)
                    changed = true
                }
            }
        }
        if !changed { <- }
    }

}

fn mir_mfn_has_struct(f &MFn) bool {
    if is_struct_type(f.ret) { << true }
    for i in 0:f.locals.len {
        if is_struct_type(f.locals[i]) { << true }
    }
    for i in 0:f.temps.len {
        if is_struct_type(f.temps[i]) { << true }
    }
    << false
}

fn mir_promote_canonical_empty_tails(f &mut MFn) bool {
    // Legacy traversal is defined by head. A valid stale tail on an empty
    // block is inert, but the formal SSA window requires head/tail agreement.
    // Only normalize that metadata; malformed tails and non-empty chains
    // still go through the unchanged structural and strict SSA verifiers.
    if f.blocks.len > mir_verify_max_blocks || f.instrs.len > mir_verify_max_items { << false }
    for bi in 0:f.blocks.len {
        mut b := f.blocks[bi]
        if b.head == -1 {
            if b.tail < -1 || b.tail >= f.instrs.len { << false }
            if b.tail >= 0 {
                b.tail = -1
                mfn_set_block(mut &f.blocks, bi, b)
            }
        }
    }
    << true
}

fn mir_promote_scalar_locals_ssa_f(f &mut MFn) int {
    << mir_promote_scalar_locals_ssa_terminal_f(f, false)
}

// The extra terminal-call admission is used only after the bounded scalar
// x64 loop proof below. Other targets retain their existing slot-shaped
// cache/SIMD pipeline, including its intrinsic-call witness.
fn mir_promote_scalar_locals_ssa_terminal_f(f &mut MFn, terminal_calls bool) int {
    nloc := f.locals.len
    // Keep each denominator proof in its own early-return guard.  The Gen1
    // checker intentionally does not infer non-zero facts through a compound
    // `||`; without these two guards its static warning obscures the real
    // overflow admission checks below.
    if nloc == 0 { << 0 }
    if f.blocks.len == 0 { << 0 }
    mut records := false
    if mir_mfn_has_struct(&*f) {
        records = mir_promote_record_int_cfg_f(&*f)
        if !records { << 0 }
    }
    if !mir_promote_canonical_empty_tails(f) { << 0 }
    // Legacy MIR is structurally valid but not globally SSA: older passes may
    // legally reuse TempIds.  Strict single-def/dominance checks run only
    // after promotion has materialized and renamed the SSA window below.
    if mir_verify_mfn_f(&*f, false) != 0 { << 0 }
    // A cloned MFn should not carry a half-eliminated view from an earlier
    // optimizer invocation.  The metadata is owned by this SSA window.
    f.phis = []MPhi{}
    f.phi_args = []MPhiArg{}
    // Legacy block ids are stable storage indices. Canonicalize dead code to
    // empty tkind=0 tombstones before entering SSA; the strict verifier treats
    // those physical tombstones as outside the formal CFG.
    mir_zap_unreachable(f)
    nblk := f.blocks.len
    if f.ret != 0 && (!mir_local_promotion_scalar(f.ret) || f.ret_nslots != 1) { << 0 }
    mut mixed := mir_promote_mixed_shape_f(&*f)
    int_index := mir_promote_int_index_shape_f(&*f)
    f64_byte := mir_promote_f64_byte_index_shape_f(&*f)
    f64_index := mir_promote_f64_index_shape_f(&*f)
    if mixed || int_index || f64_byte || f64_index || records {
        mixed = true
    }
    // Aggregate temps (struct literals, sret, descriptors) stay
    // frame-backed. They used to abort the whole function, which hid
    // eligible scalar locals next to a by-value `color.RGBA` argument.
    // Per-local eligibility below already rejects non-scalar LoadLocal
    // dest / StoreLocal src; do not poison the function here.
    has_math_call := mir_promote_has_math_call_f(&*f)
    // Mixed kernels keep aggregate temps frame-backed. Only eligible scalar
    // locals are renamed; LoadLocal dest / StoreLocal src stay one-slot
    // scalars in the per-local scan below.

    // Parameters, owning values, non-scalars and every address/field/index
    // /drop base stay frame-backed.  This scan is deliberately all-before-mutation.
    lw := mir_promote_words(nloc)
    bw := mir_promote_words(nblk)
    if lw <= 0 { << 0 }
    if bw <= 0 { << 0 }
    // `mir_verify_mfn_f` already bounds these dimensions; repeat the caps at
    // this allocation boundary so a future caller cannot bypass that proof.
    if nloc > mir_verify_max_items || nblk > mir_verify_max_blocks { << 0 }
    // Under the caps above, both products are far below signed-int range; the
    // explicit budgets prevent a valid-looking but memory-hostile matrix.
    if nblk * lw > mir_promote_max_matrix { << 0 }
    matrix := nblk * lw
    if nblk * nloc > mir_promote_max_matrix { << 0 }
    vmatrix := nblk * nloc
    nin0 := f.instrs.len
    if nin0 > mir_verify_max_items { << 0 }
    mut total := bw
    total += lw * 4
    total += matrix * 6
    total += vmatrix * 4
    total += nin0
    total += nblk
    if total > mir_promote_max_work { << 0 }

    eligible_off := 0
    reach_off := eligible_off + lw
    bdef_off := reach_off + bw
    buse_off := bdef_off + matrix
    must_in_off := buse_off + matrix
    must_out_off := must_in_off + matrix
    live_in_off := must_out_off + matrix
    live_out_off := live_in_off + matrix
    saw_access_off := live_out_off + matrix
    saw_store_off := saw_access_off + lw
    cur_off := saw_store_off + lw
    phi_off := cur_off + lw
    in_ver_off := phi_off + vmatrix
    out_ver_off := in_ver_off + vmatrix
    last_def_off := out_ver_off + vmatrix
    store_ver_off := last_def_off + vmatrix
    pred_off := store_ver_off + nin0
    mut work := []int{}
    for _ in 0:total { work.push(0) }
    // Version sections use -1 as the invalid/unavailable sentinel.  Bit
    // sections remain zero-filled; pred counts are zero by construction.
    for at in phi_off:pred_off { mfn_set_i(mut &work, at, -1) }

    for loc in 0:nloc {
        mut ok := 1
        if loc < f.nparams { ok = 0 }
        if !mir_local_promotion_scalar(f.locals[loc]) || f.locals_nslots[loc] != 1 { ok = 0 }
        if loc < f.locals_owning.len && f.locals_owning[loc] { ok = 0 }
        if int_index && f.locals[loc] != 1 { ok = 0 }
        if ok == 1 { mir_promote_bit_add(mut &work, eligible_off, loc) }
    }
    for bi in 0:nblk {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            loc := mir_promote_escape_local_f(&*f, ii)
            if loc >= 0 && loc < nloc && mir_promote_bit_has(&work, eligible_off, loc) {
                mir_promote_bit_del(mut &work, eligible_off, loc)
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    if !mir_promote_bits_any(&work, eligible_off, lw) { << 0 }

    // Reachability and successor validation.
    mir_promote_bit_add(mut &work, reach_off, 0)
    for _ in 0:nblk {
        mut changed := false
        for bi in 0:nblk {
            if !mir_promote_bit_has(&work, reach_off, bi) { -> }
            tk := f.blocks[bi].tkind
            if tk == 1 {
                to := f.blocks[bi].ta
                if to < 0 || to >= nblk { << 0 }
                if !mir_promote_bit_has(&work, reach_off, to) {
                    mir_promote_bit_add(mut &work, reach_off, to)
                    changed = true
                }
            } else if tk == 2 {
                tb := f.blocks[bi].tb
                tc := f.blocks[bi].tc
                if tb < 0 || tb >= nblk || tc < 0 || tc >= nblk { << 0 }
                if !mir_promote_bit_has(&work, reach_off, tb) {
                    mir_promote_bit_add(mut &work, reach_off, tb)
                    changed = true
                }
                if !mir_promote_bit_has(&work, reach_off, tc) {
                    mir_promote_bit_add(mut &work, reach_off, tc)
                    changed = true
                }
            } else if tk != 3 {
                << 0
            }
        }
        if !changed { <- }
    }
    mut nreach := 0
    for bi in 0:nblk {
        if mir_promote_bit_has(&work, reach_off, bi) { nreach += 1 }
    }
    if nreach > 1 {
        for bi in 0:nblk {
            if !mir_promote_bit_has(&work, reach_off, bi) { -> }
            mut ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                k := mfn_ikind(&f.instrs, ii)
                if mixed {
                    if !mir_promote_body_kind_ok(k) { << 0 }
                } else if !mir_promote_kind_scalar_only(k) {
                    if !((has_math_call || terminal_calls) && mir_promote_scalar_call_f(&*f, ii)) { << 0 }
                }
                ii = mfn_inext(&f.instrs, ii)
            }
        }
    }

    // Build block def/use sets in one instruction walk.  `buse` is the
    // use-before-def set used by the backward local liveness calculation.
    for bi in 0:nblk {
        if !mir_promote_bit_has(&work, reach_off, bi) { -> }
        for wi in 0:lw { mfn_set_i(mut &work, cur_off + wi, 0) }
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == 3 {
                loc := mfn_ia(&f.instrs, ii)
                if loc >= 0 && loc < nloc {
                    mir_promote_bit_add(mut &work, bdef_off + bi * lw, loc)
                    mir_promote_bit_add(mut &work, cur_off, loc)
                }
            } else if k == 2 {
                loc := mfn_ib(&f.instrs, ii)
                if loc >= 0 && loc < nloc && !mir_promote_bit_has(&work, cur_off, loc) {
                    mir_promote_bit_add(mut &work, buse_off + bi * lw, loc)
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }

    mir_promote_must_store_f(&*f, mut &work, nblk, nloc, lw, reach_off, bdef_off, must_in_off, must_out_off)

    // Validate every candidate local and collect access/store facts.  The
    // per-block current bitset is seeded by must-in and updated by stores.
    nt0 := f.temps.len
    for bi in 0:nblk {
        if !mir_promote_bit_has(&work, reach_off, bi) { -> }
        for wi in 0:lw {
            iv0 := mfn_get_i(&work, must_in_off + bi * lw + wi)
            mfn_set_i(mut &work, cur_off + wi, iv0)
        }
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == 2 {
                loc := mfn_ib(&f.instrs, ii)
                if loc >= 0 && loc < nloc && mir_promote_bit_has(&work, eligible_off, loc) {
                    mir_promote_bit_add(mut &work, saw_access_off, loc)
                    dest := mfn_ia(&f.instrs, ii)
                    if !mir_promote_bit_has(&work, cur_off, loc) || dest < 0 || dest >= nt0 {
                        mir_promote_bit_del(mut &work, eligible_off, loc)
                    } else if !mir_local_promotion_scalar(f.temps[dest]) || f.temps_nslots[dest] != 1 {
                        mir_promote_bit_del(mut &work, eligible_off, loc)
                    }
                }
            } else if k == 3 {
                loc := mfn_ia(&f.instrs, ii)
                if loc >= 0 && loc < nloc && mir_promote_bit_has(&work, eligible_off, loc) {
                    mir_promote_bit_add(mut &work, saw_access_off, loc)
                    mir_promote_bit_add(mut &work, saw_store_off, loc)
                    src := mfn_ib(&f.instrs, ii)
                    if src == -1 || src >= nt0 {
                        mir_promote_bit_del(mut &work, eligible_off, loc)
                    } else if src >= 0 && (!mir_local_promotion_scalar(f.temps[src]) || f.temps_nslots[src] != 1) {
                        mir_promote_bit_del(mut &work, eligible_off, loc)
                    }
                    mir_promote_bit_add(mut &work, cur_off, loc)
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    for loc in 0:nloc {
        if !mir_promote_bit_has(&work, saw_access_off, loc) || !mir_promote_bit_has(&work, saw_store_off, loc) {
            mir_promote_bit_del(mut &work, eligible_off, loc)
        }
    }
    if !mir_promote_bits_any(&work, eligible_off, lw) { << 0 }

    // Count unique predecessors and compute local liveness.  Liveness is what
    // prunes Phi insertion: a merge only needs an incoming value when it is
    // read before a local definition or is live through the block.
    for bi in 0:nblk {
        mut np := 0
        if mir_promote_bit_has(&work, reach_off, bi) {
            for pi in 0:nblk {
                if mir_promote_bit_has(&work, reach_off, pi) && mir_promote_edge_to(&*f, pi, bi) { np += 1 }
            }
        }
        mfn_set_i(mut &work, pred_off + bi, np)
    }
    for _ in 0:nblk + 1 {
        mut changed := false
        for bi in 0:nblk {
            if !mir_promote_bit_has(&work, reach_off, bi) { -> }
            for wi in 0:lw {
                mut outv := 0
                tk := f.blocks[bi].tkind
                if tk == 1 {
                    to := f.blocks[bi].ta
                    if to >= 0 && to < nblk { outv = mfn_get_i(&work, live_in_off + to * lw + wi) }
                } else if tk == 2 {
                    tb := f.blocks[bi].tb
                    tc := f.blocks[bi].tc
                    if tb >= 0 && tb < nblk { outv = outv | mfn_get_i(&work, live_in_off + tb * lw + wi) }
                    if tc >= 0 && tc < nblk { outv = outv | mfn_get_i(&work, live_in_off + tc * lw + wi) }
                }
                inv_def := 0 - mfn_get_i(&work, bdef_off + bi * lw + wi) - 1
                nv := mfn_get_i(&work, buse_off + bi * lw + wi) | (outv & inv_def)
                if mfn_get_i(&work, live_out_off + bi * lw + wi) != outv {
                    mfn_set_i(mut &work, live_out_off + bi * lw + wi, outv)
                    changed = true
                }
                if mfn_get_i(&work, live_in_off + bi * lw + wi) != nv {
                    mfn_set_i(mut &work, live_in_off + bi * lw + wi, nv)
                    changed = true
                }
            }
        }
        if !changed { <- }
    }

    // Allocate one distinct TempId for each StoreLocal version, followed by
    // pruned Phi temps.  Version matrices are initialized to -1 above.
    mut npromoted := 0
    for loc in 0:nloc {
        if mir_promote_bit_has(&work, eligible_off, loc) { npromoted += 1 }
    }
    for bi in 0:nblk {
        if !mir_promote_bit_has(&work, reach_off, bi) { -> }
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == 3 {
                loc := mfn_ia(&f.instrs, ii)
                if loc >= 0 && loc < nloc && mir_promote_bit_has(&work, eligible_off, loc) {
                    src := mfn_ib(&f.instrs, ii)
                    mut sv := src
                    if src < 0 {
                        sv = f.temps.len
                        ty := f.locals[loc]
                        f.temps.push(ty)
                        f.temps_nslots.push(1)
                    }
                    mfn_set_i(mut &work, store_ver_off + ii, sv)
                    mfn_set_i(mut &work, last_def_off + bi * nloc + loc, sv)
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    for bi in 1:nblk {
        if !mir_promote_bit_has(&work, reach_off, bi) || mfn_get_i(&work, pred_off + bi) < 2 { -> }
        for loc in 0:nloc {
            if !mir_promote_bit_has(&work, eligible_off, loc) || !mir_promote_bit_has(&work, live_in_off + bi * lw, loc) { -> }
            pt := f.temps.len
            ty := f.locals[loc]
            f.temps.push(ty)
            f.temps_nslots.push(1)
            mfn_set_i(mut &work, phi_off + bi * nloc + loc, pt)
        }
    }

    // Solve the renamed incoming/outgoing version for every block.  Phi
    // blocks break loop cycles; a non-Phi block with differing dead incoming
    // values is intentionally left -1 because no later load can observe it.
    for _ in 0:nblk + 1 {
        mut changed := false
        for bi in 0:nblk {
            if !mir_promote_bit_has(&work, reach_off, bi) { -> }
            for loc in 0:nloc {
                if !mir_promote_bit_has(&work, eligible_off, loc) { -> }
                old_in := mfn_get_i(&work, in_ver_off + bi * nloc + loc)
                mut iv := old_in
                pt := mfn_get_i(&work, phi_off + bi * nloc + loc)
                if pt >= 0 {
                    iv = pt
                } else if bi == 0 {
                    iv = -1
                } else {
                    mut have := false
                    mut same := true
                    mut first := -1
                    for pi in 0:nblk {
                        if mir_promote_bit_has(&work, reach_off, pi) && mir_promote_edge_to(&*f, pi, bi) {
                            pv := mfn_get_i(&work, out_ver_off + pi * nloc + loc)
                            if !have {
                                first = pv
                                have = true
                            } else if pv != first {
                                same = false
                            }
                        }
                    }
                    if have && same { iv = first } else { iv = -1 }
                }
                mut ov := iv
                ld := mfn_get_i(&work, last_def_off + bi * nloc + loc)
                if ld >= 0 { ov = ld }
                if iv != old_in {
                    mfn_set_i(mut &work, in_ver_off + bi * nloc + loc, iv)
                    changed = true
                }
                if ov != mfn_get_i(&work, out_ver_off + bi * nloc + loc) {
                    mfn_set_i(mut &work, out_ver_off + bi * nloc + loc, ov)
                    changed = true
                }
            }
        }
        if !changed { <- }
    }

    // Confirm every observed load has a version and every Phi edge has a
    // source.  This is the final fail-closed check before rewriting.
    for bi in 0:nblk {
        if !mir_promote_bit_has(&work, reach_off, bi) { -> }
        for loc in 0:nloc {
            if !mir_promote_bit_has(&work, eligible_off, loc) { -> }
            mut curv := mfn_get_i(&work, in_ver_off + bi * nloc + loc)
            mut ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                k := mfn_ikind(&f.instrs, ii)
                if k == 2 && mfn_ib(&f.instrs, ii) == loc && curv < 0 { << 0 }
                if k == 3 && mfn_ia(&f.instrs, ii) == loc {
                    curv = mfn_get_i(&work, store_ver_off + ii)
                    if curv < 0 { << 0 }
                }
                ii = mfn_inext(&f.instrs, ii)
            }
        }
        for succ in 0:nblk {
            if !mir_promote_edge_to(&*f, bi, succ) { -> }
            for loc in 0:nloc {
                pt := mfn_get_i(&work, phi_off + succ * nloc + loc)
                if pt >= 0 && mfn_get_i(&work, out_ver_off + bi * nloc + loc) < 0 { << 0 }
            }
        }
    }

    // Materialize the solved merge table as persistent Phi metadata.  This is
    // intentionally separate from MInstr so legacy emitters never need to
    // understand a new instruction kind.  Each reachable predecessor gets
    // exactly one incoming record, including self-loop back-edges.
    for succ in 1:nblk {
        if !mir_promote_bit_has(&work, reach_off, succ) || mfn_get_i(&work, pred_off + succ) < 2 { -> }
        for loc in 0:nloc {
            pt := mfn_get_i(&work, phi_off + succ * nloc + loc)
            if pt < 0 { -> }
            ah := f.phi_args.len
            mut ac := 0
            for pi in 0:nblk {
                if !mir_promote_bit_has(&work, reach_off, pi) || !mir_promote_edge_to(&*f, pi, succ) { -> }
                srcv := mfn_get_i(&work, out_ver_off + pi * nloc + loc)
                if srcv < 0 { << 0 }
                f.phi_args.push(MPhiArg{pred: pi, value: srcv})
                ac += 1
            }
            pty := f.locals[loc]
            f.phis.push(MPhi{block: succ, local: loc, dest: pt, ty: pty, arg_head: ah, arg_count: ac})
        }
    }
    // Rename instructions.  Reusing the incoming-version row as a mutable
    // current map keeps the helper's slice ownership bounded.
    for bi in 0:nblk {
        if !mir_promote_bit_has(&work, reach_off, bi) { -> }
        mut kill := []int{}
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            next := mfn_inext(&f.instrs, ii)
            k := mfn_ikind(&f.instrs, ii)
            if k == 3 {
                loc := mfn_ia(&f.instrs, ii)
                if loc >= 0 && loc < nloc && mir_promote_bit_has(&work, eligible_off, loc) {
                    sv := mfn_get_i(&work, store_ver_off + ii)
                    src := mfn_ib(&f.instrs, ii)
                    if sv != src {
                        mut x := mfn_instr_snap(mut &f.instrs, ii)
                        x.kind = 1
                        x.a = sv
                        x.c = -1
                        x.d = -1
                        x.sval = ""
                        mfn_set_instr(mut &f.instrs, ii, x)
                    } else {
                        kill.push(ii)
                    }
                    mfn_set_i(mut &work, in_ver_off + bi * nloc + loc, sv)
                }
            } else if k == 2 {
                loc := mfn_ib(&f.instrs, ii)
                if loc >= 0 && loc < nloc && mir_promote_bit_has(&work, eligible_off, loc) {
                    srcv := mfn_get_i(&work, in_ver_off + bi * nloc + loc)
                    dest := mfn_ia(&f.instrs, ii)
                    if dest >= 0 && srcv >= 0 && dest != srcv {
                        mir_replace_temp_operands_all(f, dest, srcv)
                    }
                    kill.push(ii)
                }
            }
            ii = next
        }
        for ki in 0:kill.len {
            mir_delete_instr(f, bi, kill[ki])
        }
    }
    if mir_verify_mfn_f(&*f, true) != 0 { << 0 }
    << npromoted
}

// Schedule one edge's Phi assignments as a true parallel-copy bundle.
// Identity moves disappear. A cyclic component first saves one source in a
// fresh same-typed scratch TempId, then becomes peelable. Return the number of
// emitted Copy instructions, or -1 on malformed input.
fn mir_phi_schedule_copies(f &mut MFn, bi int, dests &[]int, srcs0 &[]int) int {
    if bi < 0 || bi >= f.blocks.len || dests.len != srcs0.len { << -1 }
    mut srcs := []int{}
    mut active := []bool{}
    mut remain := 0
    for i in 0:dests.len {
        d := dests[i]
        s := srcs0[i]
        if d < 0 || d >= f.temps.len || s < 0 || s >= f.temps.len { << -1 }
        if f.temps[d] != f.temps[s] || f.temps_nslots[d] != f.temps_nslots[s] { << -1 }
        srcs.push(s)
        on := d != s
        active.push(on)
        if on { remain += 1 }
    }
    mut emitted := 0
    while remain > 0 {
        mut pick := -1
        for i in 0:dests.len {
            if !active[i] { -> }
            mut blocked := false
            d := dests[i]
            for j in 0:dests.len {
                if active[j] && srcs[j] == d { blocked = true }
            }
            if !blocked {
                pick = i
                <-
            }
        }
        if pick >= 0 {
            mut cp := mkinstr(1)
            cp.a = dests[pick]
            cp.b = srcs[pick]
            mir_cfg_append(f, bi, cp)
            active[pick] = false
            remain -= 1
            emitted += 1
            ->
        }

        // Every remaining destination is also a source: preserve one source
        // before overwriting any member of the cyclic component.
        mut first := -1
        for i in 0:dests.len {
            if active[i] {
                first = i
                <-
            }
        }
        if first < 0 { << -1 }
        saved := srcs[first]
        scratch := f.temps.len
        sty := f.temps[saved]
        sns := f.temps_nslots[saved]
        f.temps.push(sty)
        f.temps_nslots.push(sns)
        mut keep := mkinstr(1)
        keep.a = scratch
        keep.b = saved
        mir_cfg_append(f, bi, keep)
        emitted += 1
        for j in 0:srcs.len {
            if active[j] && srcs[j] == saved { srcs[j] = scratch }
        }
    }
    << emitted
}

// Verify the exact newly appended schedule by symbolic execution. Each TempId
// initially denotes its pre-bundle value; after the emitted sequence every
// original destination must denote its original parallel source.
fn mir_phi_verify_schedule(f &MFn, start int, count int, dests &[]int, srcs &[]int) bool {
    if start < 0 || count < 0 || start + count > f.instrs.len || dests.len != srcs.len { << false }
    mut symbol := []int{}
    for t in 0:f.temps.len { symbol.push(t) }
    for k in 0:count {
        ii := start + k
        if mfn_ikind(&f.instrs, ii) != 1 { << false }
        d := mfn_ia(&f.instrs, ii)
        s := mfn_ib(&f.instrs, ii)
        if d < 0 || d >= symbol.len || s < 0 || s >= symbol.len { << false }
        symbol[d] = symbol[s]
    }
    for i in 0:dests.len {
        d := dests[i]
        s := srcs[i]
        if d < 0 || d >= symbol.len || s < 0 || s >= symbol.len || symbol[d] != s { << false }
    }
    << true
}

// Require an appended copy span to live at the tail of exactly one block.
// This complements symbolic schedule checking: a correct permutation in the
// merge block or the unsplit side of a branch is still incorrect Phi lowering.
fn mir_phi_gate_tail_copy_span(f &MFn, bi int, start int, count int) bool {
    if bi < 0 || bi >= f.blocks.len || start < 0 || count <= 0 { << false }
    mut ii := f.blocks[bi].head
    mut inside := false
    mut seen := 0
    for _ in 0:f.instrs.len + 1 {
        if ii < 0 { <- }
        if ii >= f.instrs.len { << false }
        if ii == start { inside = true }
        if inside {
            if mfn_ikind(&f.instrs, ii) != 1 { << false }
            seen += 1
        }
        ii = mfn_inext(&f.instrs, ii)
    }
    << ii < 0 && inside && seen == count && f.blocks[bi].tail == start + count - 1
}

// Exercise the complete strict-SSA -> legacy-MIR boundary, rather than only
// the isolated scheduler.  entry->header is a normal edge; the latch's
// conditional backedge is critical and must be split.  The crossed backedge
// inputs form a real two-Phi swap and therefore require one same-typed scratch.
fn mir_phi_parallel_copy_internal_gate() bool {
    mut f := mir_fn_blank()
    f.name = "mir_phi_parallel_copy_gate"
    f.label = "_mir_phi_parallel_copy_gate"
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    // t0/t1: entry values; t2/t3: header Phi destinations; t4: latch
    // branch condition.  Phi destinations dominate their backedge uses.
    for _ in 0:4 {
        f.temps.push(1)
        f.temps_nslots.push(1)
    }
    f.temps.push(2)
    f.temps_nslots.push(1)
    f.consts.push(11)
    f.consts.push(22)
    f.consts.push(1)
    // entry(0) -> header(1) -> latch(2) -> header(1), with exit(3) as
    // the latch's second successor so the backedge is genuinely critical.
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 1})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 2, tb: -1, tc: -1, line: 2})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 4, tb: 1, tc: 3, line: 3})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 4})
    mut init_a := mkinstr(1)
    init_a.a = 0
    init_a.b = -2
    mir_cfg_append(mut &f, 0, init_a)
    mut init_b := mkinstr(1)
    init_b.a = 1
    init_b.b = -3
    mir_cfg_append(mut &f, 0, init_b)
    mut cond := mkinstr(1)
    cond.a = 4
    cond.b = -4
    mir_cfg_append(mut &f, 0, cond)
    // On entry: t2 <- t0, t3 <- t1.  On the backedge: t2 <- old t3,
    // t3 <- old t2, which cannot be sequentialized without a scratch.
    f.phi_args.push(MPhiArg{pred: 0, value: 0})
    f.phi_args.push(MPhiArg{pred: 2, value: 3})
    f.phi_args.push(MPhiArg{pred: 0, value: 1})
    f.phi_args.push(MPhiArg{pred: 2, value: 2})
    f.phis.push(MPhi{block: 1, local: 0, dest: 2, ty: 1, arg_head: 0, arg_count: 2})
    f.phis.push(MPhi{block: 1, local: 1, dest: 3, ty: 1, arg_head: 2, arg_count: 2})
    if mir_verify_mfn_f(&f, true) != 0 {
        << false
    }

    old_nt := f.temps.len
    old_nb := f.blocks.len
    entry_start := f.instrs.len
    if !mir_phi_elim_f(mut &f) {
        << false
    }
    if f.phis.len != 0 || f.phi_args.len != 0 {
        << false
    }
    if mir_verify_mfn_f(&f, false) != 0 {
        << false
    }
    if f.temps.len != old_nt + 1 || f.temps[old_nt] != 1 || f.temps_nslots[old_nt] != 1 {
        << false
    }
    if f.blocks.len != old_nb + 1 {
        << false
    }

    // The non-critical entry assignments remain in entry and retain their
    // exact parallel semantics without allocating another scratch.
    entry_dests := [2, 3]
    entry_srcs := [0, 1]
    if !mir_phi_gate_tail_copy_span(&f, 0, entry_start, 2) {
        << false
    }
    if !mir_phi_verify_schedule(&f, entry_start, 2, &entry_dests, &entry_srcs) {
        << false
    }
    if f.blocks[0].tkind != 1 || f.blocks[0].ta != 1 {
        << false
    }

    // The latch itself stays copy-free. Its header arm now targets a line=0
    // synthetic Jump block, and the complete three-Copy swap lives there.
    if f.blocks[2].head >= 0 || f.blocks[2].tail >= 0 || f.blocks[2].tkind != 2 {
        << false
    }
    synth := old_nb
    if f.blocks[2].tb != synth || f.blocks[2].tc != 3 {
        << false
    }
    if f.blocks[synth].line != 0 || f.blocks[synth].tkind != 1 || f.blocks[synth].ta != 1 {
        << false
    }
    cycle_start := f.blocks[synth].head
    cycle_dests := [2, 3]
    cycle_srcs := [3, 2]
    if !mir_phi_gate_tail_copy_span(&f, synth, cycle_start, 3) {
        << false
    }
    if !mir_phi_verify_schedule(&f, cycle_start, 3, &cycle_dests, &cycle_srcs) {
        << false
    }
    << true
}

// Dedicated SSA destruction pass.  Keeping this separate from local
// promotion gives the optimizer a real, verifier-visible Phi boundary while
// preserving the legacy emitter contract.  A branch predecessor whose
// successor also has another predecessor is a critical edge; split it with a
// synthetic line=0 Jump block so copies stay edge-specific.
fn mir_phi_elim_f(f &mut MFn) bool {
    if mir_verify_mfn_f(&*f, true) != 0 { << false }
    nblk := f.blocks.len
    mut succ_scan := 1
    while succ_scan < nblk {
        succ := succ_scan
        mut has_phi := false
        for pidx in 0:f.phis.len {
            if f.phis[pidx].block == succ { has_phi = true }
        }
        if has_phi {
            mut pi := 0
            while pi < nblk {
                if mir_promote_edge_to(&*f, pi, succ) {
                    mut dests := []int{}
                    mut srcs := []int{}
                    for pidx in 0:f.phis.len {
                        p := f.phis[pidx]
                        if p.block != succ { -> }
                        mut srcv := -1
                        for ai in p.arg_head:p.arg_head + p.arg_count {
                            if ai >= 0 && ai < f.phi_args.len && f.phi_args[ai].pred == pi {
                                srcv = f.phi_args[ai].value
                            }
                        }
                        if srcv < 0 { << false }
                        dests.push(p.dest)
                        srcs.push(srcv)
                    }
                    mut need := false
                    for i in 0:dests.len { if dests[i] != srcs[i] { need = true } }
                    if need {
                        tk := f.blocks[pi].tkind
                        mut copy_bb := pi
                        if tk == 2 {
                            nbi := f.blocks.len
                            f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: succ, tb: -1, tc: -1, line: 0})
                            mut pb := f.blocks[pi]
                            if pb.tb == succ { pb.tb = nbi }
                            if pb.tc == succ { pb.tc = nbi }
                            mfn_set_block(mut &f.blocks, pi, pb)
                            copy_bb = nbi
                        }
                        start := f.instrs.len
                        ncopy := mir_phi_schedule_copies(f, copy_bb, &dests, &srcs)
                        if ncopy < 0 || !mir_phi_verify_schedule(&*f, start, ncopy, &dests, &srcs) { << false }
                    }
                }
                pi += 1
            }
        }
        succ_scan += 1
    }
    // Phi metadata is an SSA-window artifact.  The edge copies above are the
    // canonical legacy representation consumed by Gen1's emitter.
    f.phis = []MPhi{}
    f.phi_args = []MPhiArg{}
    << mir_verify_mfn_f(&*f, false) == 0
}

// Cheap non-mutating gate so the Gen1 ownership subset can move a grown MFn
// into mir_fn_commit unconditionally. The full pass still repeats all safety
// checks before rewriting; this gate only avoids retiring functions that
// cannot possibly promote a local.
fn mir_promote_mixed_shape_m(m &Mir, fi int) bool {
    mut has_f64 := false
    mut has_frmw := false
    mut other_st := false
    for i in 0:mir_nlocals(m, fi) {
        if mir_local_ty(m, fi, i) == 4 { has_f64 = true }
    }
    for i in 0:mir_ntemps(m, fi) {
        if mir_temp_ty(m, fi, i) == 4 { has_f64 = true }
    }
    if !has_f64 { << false }
    nblk := mir_nblocks(m, fi)
    for bi in 0:nblk {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := mir_ikind(m, fi, ii)
            if ik == 48 || ik == 25 || ik == 18 { has_frmw = true }
            if ik == 11 || ik == 13 || ik == 20 || ik == 46 || ik == 47 { other_st = true }
            ii = mir_inext(m, fi, ii)
        }
    }
    << has_frmw && !other_st
}

fn mir_promote_f64_byte_index_shape_m(m &Mir, fi int) bool {
    mut has_f64 := false
    mut has_idx := false
    mut f64_idx := false
    mut other_st := false
    for i in 0:mir_nlocals(m, fi) {
        if mir_local_ty(m, fi, i) == 4 { has_f64 = true }
    }
    for i in 0:mir_ntemps(m, fi) {
        if mir_temp_ty(m, fi, i) == 4 { has_f64 = true }
    }
    if !has_f64 { << false }
    nblk := mir_nblocks(m, fi)
    nt := mir_ntemps(m, fi)
    for bi in 0:nblk {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := mir_ikind(m, fi, ii)
            if ik == 14 {
                has_idx = true
                d := mir_ia(m, fi, ii)
                if d >= 0 && d < nt && mir_temp_ty(m, fi, d) == 4 { f64_idx = true }
            }
            if ik == 20 {
                has_idx = true
                v := mir_ic(m, fi, ii)
                if v >= 0 && v < nt && mir_temp_ty(m, fi, v) == 4 { f64_idx = true }
            }
            if ik == 11 || ik == 13 || ik == 18 || ik == 25 || ik == 46 || ik == 47 || ik == 48 {
                other_st = true
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    << has_f64 && has_idx && !f64_idx && !other_st
}

// Keep indexed preflight in lockstep with the owned-clone shape proof.
fn mir_promote_int_index_shape_m(m &Mir, fi int) bool {
    mut has_f64 := false
    mut has_i64 := false
    mut has_ld := false
    mut has_st := false
    mut other_st := false
    for i in 0:mir_nlocals(m, fi) {
        ty := mir_local_ty(m, fi, i)
        if ty == 4 { has_f64 = true }
        if ty == 1 { has_i64 = true }
    }
    for i in 0:mir_ntemps(m, fi) {
        ty := mir_temp_ty(m, fi, i)
        if ty == 4 { has_f64 = true }
        if ty == 1 { has_i64 = true }
    }
    if has_f64 || !has_i64 { << false }
    nblk := mir_nblocks(m, fi)
    for bi in 0:nblk {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := mir_ikind(m, fi, ii)
            if ik == 14 || ik == 17 || ik == 23 { has_ld = true }
            if ik == 20 || ik == 18 { has_st = true }
            if ik == 47 {
                has_ld = true
                has_st = true
            }
            if ik == 13 || ik == 25 || ik == 46 || ik == 48 {
                other_st = true
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    << has_ld && has_st && !other_st
}

fn mir_promote_f64_index_shape_m(m &Mir, fi int) bool {
    mut has_f64 := false
    mut has_ld := false
    mut other_st := false
    for i in 0:mir_nlocals(m, fi) {
        if mir_local_ty(m, fi, i) == 4 { has_f64 = true }
    }
    for i in 0:mir_ntemps(m, fi) {
        if mir_temp_ty(m, fi, i) == 4 { has_f64 = true }
    }
    if !has_f64 { << false }
    nblk := mir_nblocks(m, fi)
    for bi in 0:nblk {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii < 0 { <- }
            ik := mir_ikind(m, fi, ii)
            if ik == 14 { has_ld = true }
            if ik == 47 { has_ld = true }
            if ik == 25 || ik == 46 || ik == 48 {
                other_st = true
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    << has_ld && !other_st
}

fn mir_fn_has_struct(m &Mir, fi int) bool {
    if is_struct_type(mir_fn_ret(m, fi)) { << true }
    for i in 0:mir_nlocals(m, fi) {
        if is_struct_type(mir_local_ty(m, fi, i)) { << true }
    }
    for i in 0:mir_ntemps(m, fi) {
        if is_struct_type(mir_temp_ty(m, fi, i)) { << true }
    }
    << false
}

fn mir_fn_may_promote_scalar(m &Mir, fi int) bool {
    nloc := mir_nlocals(m, fi)
    nblk := mir_nblocks(m, fi)
    if nloc == 0 || nblk == 0 { << false }
    mut records := false
    if mir_fn_has_struct(m, fi) {
        records = mir_promote_record_int_cfg_m(m, fi)
        if !records { << false }
    }
    if mir_fn_ret(m, fi) != 0 && (!mir_local_promotion_scalar(mir_fn_ret(m, fi)) || mir_fn_ret_nslots(m, fi) != 1) { << false }
    mut mixed := mir_promote_mixed_shape_m(m, fi)
    int_index := mir_promote_int_index_shape_m(m, fi)
    f64_byte := mir_promote_f64_byte_index_shape_m(m, fi)
    f64_index := mir_promote_f64_index_shape_m(m, fi)
    if mixed || int_index || f64_byte || f64_index || records {
        mixed = true
    }
    has_math_call := mir_promote_has_math_call_m(m, fi)
    nw := mir_promote_words(nblk)
    lw := mir_promote_words(nloc)
    reach_off := 0
    stored_off := nw
    escaped_off := stored_off + lw
    mut work := []int{}
    for _ in 0:nw + lw * 2 { work.push(0) }
    mir_promote_bit_add(mut &work, reach_off, 0)
    for _ in 0:nblk {
        for bi in 0:nblk {
            if !mir_promote_bit_has(&work, reach_off, bi) { -> }
            tk := mir_btkind(m, fi, bi)
            if tk == 1 {
                to := mir_bta(m, fi, bi)
                if to < 0 || to >= nblk { << false }
                mir_promote_bit_add(mut &work, reach_off, to)
            } else if tk == 2 {
                tb := mir_btb(m, fi, bi)
                tc := mir_btc(m, fi, bi)
                if tb < 0 || tb >= nblk || tc < 0 || tc >= nblk { << false }
                mir_promote_bit_add(mut &work, reach_off, tb)
                mir_promote_bit_add(mut &work, reach_off, tc)
            } else if tk != 3 {
                << false
            }
        }
    }
    mut nreach := 0
    for bi in 0:nblk {
        if mir_promote_bit_has(&work, reach_off, bi) { nreach += 1 }
    }
    if nreach > 1 {
        for bi in 0:nblk {
            if !mir_promote_bit_has(&work, reach_off, bi) { -> }
            mut ii := mir_bhead(m, fi, bi)
            for _ in 0:mir_nins(m, fi) {
                if ii < 0 { <- }
                k := mir_ikind(m, fi, ii)
                if mixed {
                    if !mir_promote_body_kind_ok(k) { << false }
                } else if !mir_promote_kind_scalar_only(k) {
                    if !(has_math_call && mir_promote_scalar_call_m(m, fi, ii)) { << false }
                }
                ii = mir_inext(m, fi, ii)
            }
        }
    }

    // One instruction scan builds the local store/escape sets.  The previous
    // local-major walk rescanned every instruction for every local and made
    // compiler self-emission O(nlocals * ninstrs), twice per candidate.
    for bi in 0:nblk {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii < 0 { <- }
            if mir_ikind(m, fi, ii) == 3 {
                loc := mir_ia(m, fi, ii)
                if loc >= 0 && loc < nloc {
                    mir_promote_bit_add(mut &work, stored_off, loc)
                }
            }
            escaped := mir_promote_escape_local_m(m, fi, ii)
            if escaped >= 0 && escaped < nloc {
                mir_promote_bit_add(mut &work, escaped_off, escaped)
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    for loc in mir_fn_nparams(m, fi):nloc {
        if !mir_local_promotion_scalar(mir_local_ty(m, fi, loc)) || mir_local_nslots(m, fi, loc) != 1 {
            ->
        }
        if loc < m.fns[fi].locals_owning.len && m.fns[fi].locals_owning[loc] { -> }
        if int_index && mir_local_ty(m, fi, loc) != 1 { -> }
        if mir_promote_bit_has(&work, stored_off, loc) && !mir_promote_bit_has(&work, escaped_off, loc) { << true }
    }
    << false
}

// Scalar integer intrinsic loops have no aggregate/ownership state. Keep
// their admission independent of imported library count; the ordinary
// escape, SSA, edge-copy and fixed-home verifiers still apply afterwards.
// This is a body-shape proof, never a caller name or benchmark-size gate.
pub fn mir_scalar_math_body(m &Mir, fi int) bool {
    if mir_fn_is_extern(m, fi) { << false }
    if mir_nblocks(m, fi) > 128 || mir_nlocals(m, fi) > 48 { << false }
    if mir_ntemps(m, fi) > 768 || mir_nins(m, fi) > 2048 { << false }
    for li in 0:mir_nlocals(m, fi) {
        ty := mir_local_ty(m, fi, li)
        if !mir_local_promotion_scalar(ty) || ty == 4 || mir_local_nslots(m, fi, li) != 1 { << false }
    }
    for ti in 0:mir_ntemps(m, fi) {
        ty := mir_temp_ty(m, fi, ti)
        if !mir_local_promotion_scalar(ty) || ty == 4 || mir_temp_nslots(m, fi, ti) != 1 { << false }
    }
    mut witness := false
    for bi in 0:mir_nblocks(m, fi) {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii < 0 { <- }
            k := mir_ikind(m, fi, ii)
            if k == 7 {
                if mir_promote_math_label_m(m, fi, ii) {
                    witness = true
                } else if !mir_promote_scalar_call_m(m, fi, ii) { << false }
            } else if k != 0 && !mir_promote_kind_scalar_only(k) { << false }
            ii = mir_inext(m, fi, ii)
        }
    }
    << witness
}

// Integer CFG admission is independent of whole-unit library count.
// Only known ABI-free scalar operations participate; local storage and SSA
// validity are still proved by the unchanged promotion/verification stages.
// Calls, pointers, objects, indexed memory and trapping helper ops stay on
// their established paths. This proof does not mutate or cache anything.
fn mir_scalar_int_cfg_body(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || mir_fn_is_extern(m, fi) { << false }
    nb := mir_nblocks(m, fi)
    nl := mir_nlocals(m, fi)
    nt := mir_ntemps(m, fi)
    ni := mir_nins(m, fi)
    np := mir_fn_nparams(m, fi)
    rt := mir_fn_ret(m, fi)
    if nb <= 0 || nb > 64 || nl > 48 || nt > 512 || ni > 1024 { << false }
    if np < 0 || np > 6 || np > nl || (rt != 1 && rt != 2) || mir_fn_ret_nslots(m, fi) != 1 { << false }
    if !mir_int_leaf_lens(m, fi) { << false }
    for l in 0:nl {
        ty := mir_local_ty(m, fi, l)
        if (ty != 1 && ty != 2) || mir_local_nslots(m, fi, l) != 1 { << false }
        if l < m.fns[fi].locals_owning.len && m.fns[fi].locals_owning[l] { << false }
    }
    for t in 0:nt {
        ty := mir_temp_ty(m, fi, t)
        if (ty != 1 && ty != 2) || mir_temp_nslots(m, fi, t) != 1 { << false }
    }
    for bi in 0:nb {
        tk := mir_btkind(m, fi, bi)
        if tk == 0 {
            if mir_bhead(m, fi, bi) >= 0 { << false }
        } else if tk == 1 {
            to := mir_bta(m, fi, bi)
            if to < 0 || to >= nb { << false }
        } else if tk == 2 {
            yes := mir_btb(m, fi, bi)
            no := mir_btc(m, fi, bi)
            if yes < 0 || yes >= nb || no < 0 || no >= nb { << false }
        } else if tk != 3 { << false }
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:ni + 1 {
            if ii < 0 { <- }
            if ii >= ni { << false }
            k := mir_ikind(m, fi, ii)
            if k != 0 && (k < 1 || k > 5) { << false }
            op := mir_ib(m, fi, ii)
            if k == 4 && !((op >= 1 && op <= 3) || (op >= 6 && op <= 11) || (op >= 14 && op <= 16)) { << false }
            if k == 5 && (op < 1 || op > 2) { << false }
            ii = mir_inext(m, fi, ii)
        }
        if ii >= 0 { << false }
    }
    << mir_verify_emission_calls(m, fi)
}

// Keep the large-unit scope structural and bounded. Whole-unit size is not
// a reason to disable an otherwise identical user loop after a stdlib import.
// General scalar/compiler and field-update bodies retain the established
// small-unit gate; the exceptions cover indexed FP, scalar intrinsics and
// proven integer CFGs (including ordinary loops and branches).
fn mir_promote_unit_admit(m &Mir, fi int, small_unit bool) bool {
    if small_unit { << true }
    if mir_nblocks(m, fi) > 128 || mir_nlocals(m, fi) > 48 { << false }
    if mir_ntemps(m, fi) > 2048 || mir_nins(m, fi) > 4096 { << false }
    // Record traffic keeps its dedicated read-only proof. A broader indexed
    // shape must not re-admit a record write rejected by that contract.
    if mir_fn_has_struct(m, fi) { << mir_promote_record_int_cfg_m(m, fi) }
    // A return in the entry block has one reachable block, independent of
    // imported function count. The existing promotion/escape/strict-SSA
    // proofs already admit this shape in small units; keep those same proofs
    // for bounded functions next to an unrelated library import. Objects and
    // exposed locals retain their original frame identity.
    if mir_nblocks(m, fi) > 0 {
        if mir_btkind(m, fi, 0) == 3 { << true }
    }
    << mir_promote_record_int_cfg_m(m, fi) || mir_scalar_int_cfg_body(m, fi) || mir_scalar_int_leaf_body(m, fi) || mir_scalar_math_body(m, fi) || mir_promote_f64_byte_index_shape_m(m, fi) || mir_promote_f64_index_shape_m(m, fi) || mir_promote_int_index_shape_m(m, fi)
}

fn mir_each_promote_scalar_locals(m &mut Mir, small_unit bool) {
    if !mir_verify_internal_gate() {
        eprintln("internal error: MIR SSA verifier gate failed")
        <<< 1
    }
    n0 := m.fns.len
    mut has_candidate := false
    for fi in 0:n0 {
        if !mir_fn_is_extern(&*m, fi) && mir_promote_unit_admit(&*m, fi, small_unit) && mir_fn_may_promote_scalar(&*m, fi) {
            has_candidate = true
            <-
        }
    }
    if !has_candidate { << }
    mut fi := 0
    while fi < n0 {
        if !mir_fn_is_extern(&*m, fi) && mir_promote_unit_admit(&*m, fi, small_unit) && mir_fn_may_promote_scalar(&*m, fi) {
            mut f := mir_clone_fn(m, fi, true)
            npromoted := mir_promote_scalar_locals_ssa_f(mut &f)
            if npromoted == 0 {
                fi += 1
                ->
            }
            // npromoted > 0 carries the strict SSA proof from promotion.
            // The admission query is read-only; no pass mutates f before the
            // trusted core. Do not cache this proof on mutable MFn metadata.
            // No eligible Copy/Phi or a pre-mutation rejection keeps that
            // verified form. Any accepted rewrite still checks its output.
            if mir_ssa_has_value_work_verified_f(&f) {
                simplified := mir_ssa_simplify_verified_f(mut &f)
                if simplified >= 0 && mir_verify_mfn_f(&f, true) != 0 {
                    fi += 1
                    ->
                }
            }
            moved := mir_ssa_licm_verified_f(mut &f)
            if moved > 0 && mir_verify_mfn_f(&f, true) != 0 {
                fi += 1
                ->
            }
            // Commit formal SSA/Phi form. Phi destruction is a later pass.
            mir_fn_commit(m, fi, f)
        }
        fi += 1
    }
}

// A scalar output call in a returning block cannot be on a backedge. Prove
// that complete shape before allowing it through the SSA promotion gate;
// calls inside loops, addresses, memory, owning values and unknown opcodes
// retain their established storage and ABI behavior.
pub fn mir_terminal_scalar_loop_m(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || mir_fn_is_extern(m, fi) { << false }
    nb := mir_nblocks(m, fi)
    nl := mir_nlocals(m, fi)
    nt := mir_ntemps(m, fi)
    ni := mir_nins(m, fi)
    if nb <= 1 || nb > 64 || nl <= 0 || nl > 48 || nt > 512 || ni > 1024 { << false }
    if m.fns[fi].locals_nslots.len != nl || m.fns[fi].temps_nslots.len != nt { << false }
    rt := mir_fn_ret(m, fi)
    if rt != 0 && (!mir_local_promotion_scalar(rt) || mir_fn_ret_nslots(m, fi) != 1) { << false }
    for l in 0:nl {
        if !mir_local_promotion_scalar(mir_local_ty(m, fi, l)) || mir_local_nslots(m, fi, l) != 1 { << false }
        if l < m.fns[fi].locals_owning.len && m.fns[fi].locals_owning[l] { << false }
    }
    for t in 0:nt {
        if !mir_local_promotion_scalar(mir_temp_ty(m, fi, t)) || mir_temp_nslots(m, fi, t) != 1 { << false }
    }
    mut loop := false
    mut output := false
    for bi in 0:nb {
        tk := mir_btkind(m, fi, bi)
        if tk == 0 {
            if mir_bhead(m, fi, bi) >= 0 { << false }
        } else if tk == 1 {
            to := mir_bta(m, fi, bi)
            if to < 0 || to >= nb { << false }
            if to <= bi { loop = true }
        } else if tk == 2 {
            yes := mir_btb(m, fi, bi)
            no := mir_btc(m, fi, bi)
            if yes < 0 || yes >= nb || no < 0 || no >= nb { << false }
            if yes <= bi || no <= bi { loop = true }
        } else if tk != 3 { << false }
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:ni + 1 {
            if ii < 0 { <- }
            if ii >= ni { << false }
            k := mir_ikind(m, fi, ii)
            if k == 7 {
                ck := mir_ib(m, fi, ii)
                if tk != 3 || ii != mir_btail(m, fi, bi) { << false }
                if ck != 2 && ck != 3 && ck != 4 && ck != 5 && ck != 22 { << false }
                output = true
            } else if k != 0 && (k < 1 || k > 5) { << false }
            ii = mir_inext(m, fi, ii)
        }
        if ii >= 0 { << false }
    }
    << loop && output && mir_verify_emission_calls(m, fi)
}

fn mir_simplify_scalar_loop_commit(m &mut Mir, fi int) {
    if !mir_terminal_scalar_loop_m(&*m, fi) { << }
    mut f := mir_clone_fn(m, fi, true)
    mir_simplify_cfg(mut &f)
    if mir_verify_mfn_f(&f, false) != 0 { << }
    mir_fn_commit(m, fi, f)
}

pub fn mir_promote_x64_scalar_loops(m &mut Mir) {
    if m.opt_level < 1 { << }
    n0 := m.fns.len
    mut changed := false
    for fi in 0:n0 {
        if !mir_terminal_scalar_loop_m(&*m, fi) { -> }
        mut f := mir_clone_fn(m, fi, true)
        if mir_promote_scalar_locals_ssa_terminal_f(mut &f, true) == 0 { -> }
        if mir_ssa_has_value_work_verified_f(&f) {
            simplified := mir_ssa_simplify_verified_f(mut &f)
            if simplified >= 0 && mir_verify_mfn_f(&f, true) != 0 { -> }
        }
        moved := mir_ssa_licm_verified_f(mut &f)
        if moved > 0 && mir_verify_mfn_f(&f, true) != 0 { -> }
        mir_fn_commit(m, fi, f)
        changed = true
    }
    if !changed { << }
    mir_each_phi_elim(m)
    // Phi destruction introduces edge blocks after the ordinary CFG pass.
    // Reuse its checked copy/jump cleanup only for these scalar x64 loops.
    n1 := m.fns.len
    for fi in 0:n1 {
        mir_simplify_scalar_loop_commit(m, fi)
    }
    mir_each_late_const(m)
    m.opt_nfn = mir_nfn_live(&*m)
    mut nins := 0
    for fi in 0:m.fns.len {
        if !mir_fn_is_extern(&*m, fi) { nins += mir_nins(&*m, fi) }
    }
    m.opt_nins_out = nins
}

fn mir_fn_has_fieldrmw(m &Mir, fi int) bool {
    nins := mir_nins(m, fi)
    for bi in 0:mir_nblocks(m, fi) {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:nins {
            if ii < 0 { <- }
            if mir_ikind(m, fi, ii) == 48 { << true }
            ii = mir_inext(m, fi, ii)
        }
    }
    << false
}

fn mir_fn_has_f64_copy(m &Mir, fi int) bool {
    nt := mir_ntemps(m, fi)
    nins := mir_nins(m, fi)
    for bi in 0:mir_nblocks(m, fi) {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:nins {
            if ii < 0 { <- }
            if mir_ikind(m, fi, ii) == 1 {
                a := mir_ia(m, fi, ii)
                if a >= 0 && a < nt && mir_temp_ty(m, fi, a) == 4 && mir_temp_nslots(m, fi, a) == 1 {
                    << true
                }
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    << false
}

// Forward promotion/Phi Copies of f64 temps after de-SSA. Gated on an
// actual f64 Copy so compiler units (int-heavy) skip the clone.
fn mir_each_ssa_copy_prop(m &mut Mir) {
    n0 := m.fns.len
    mut fi := 0
    while fi < n0 {
        if !mir_fn_is_extern(&*m, fi) {
            if mir_fn_has_f64_copy(&*m, fi) || mir_fn_has_fieldrmw(&*m, fi) {
                mut f := mir_clone_fn(m, fi, true)
                mir_copy_prop_fn(mut &f)
                mir_cse_frmw_and_f64_loads(mut &f)
                mir_forward_f64_copies(mut &f)
                mir_bubble_frmw_loads(mut &f)
                mir_dce_pure(mut &f)
                // Latch Copies are live-out of the split block; DCE keeps
                // them. Folding first made dest look dead in the self-loop
                // and deleted the increment (pair `while k < n` spun).
                mir_fold_phi_backedge_copies(mut &f)
                mir_fn_commit(m, fi, f)
            }
        }
        fi += 1
    }
}

fn mir_replace_temp_operands_all(f &mut MFn, from int, to int) {
    if from < 0 || to < 0 || from == to { << }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == 1 || k == 3 || k == 9 {
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
            } else if k == 4 {
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
                if mfn_id(&f.instrs, ii) == from { mfn_set_id(mut &f.instrs, ii, to) }
            } else if k == 5 {
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
            } else if k == 7 || k == 33 {
                mut ap := mfn_ic(&f.instrs, ii)
                for _ in 0:f.margs.len {
                    if ap < 0 || ap >= f.margs.len { <- }
                    if f.margs[ap].v == from {
                        nxt := f.margs[ap].next
                        mfn_set_marg(mut &f.margs, ap, MArg{v: to, next: nxt})
                    }
                    ap = f.margs[ap].next
                }
            } else if k == 13 || k == 46 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
                if k == 13 {
                    if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
                } else {
                    mut ap := mfn_ib(&f.instrs, ii)
                    for _ in 0:f.margs.len {
                        if ap < 0 || ap >= f.margs.len { <- }
                        if f.margs[ap].v == from {
                            nxt := f.margs[ap].next
                            mfn_set_marg(mut &f.margs, ap, MArg{v: to, next: nxt})
                        }
                        ap = f.margs[ap].next
                    }
                }
            } else if k == 10 || k == 17 || k == 26 {
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
            } else if k == 11 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
            } else if k == 14 || k == 23 {
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
            } else if k == 16 {
                if mfn_ic(&f.instrs, ii) == 1 {
                    if mfn_ib(&f.instrs, ii) == from {
                        mfn_set_ib(mut &f.instrs, ii, to)
                    }
                }
            } else if k == 18 || k == 25 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
            } else if k == 21 || k == 22 || k == 24 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
            } else if k == 20 || k == 47 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
            } else if k == 30 {
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
            } else if k == 31 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
            } else if k == 32 {
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
            } else if k == 34 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
            } else if k == 35 {
                if mfn_ib(&f.instrs, ii) == from { mfn_set_ib(mut &f.instrs, ii, to) }
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
            } else if k == 36 {
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
            } else if k == 48 {
                if mfn_ia(&f.instrs, ii) == from { mfn_set_ia(mut &f.instrs, ii, to) }
                if mfn_ic(&f.instrs, ii) == from { mfn_set_ic(mut &f.instrs, ii, to) }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        mut b := f.blocks[bi]
        if (b.tkind == 2 || b.tkind == 3) && b.ta == from {
            b.ta = to
            mfn_set_block(mut &f.blocks, bi, b)
        }
    }
}

fn mir_count_temp_defs(f &MFn, ndef &mut []int) {
    nt := f.temps.len
    for _ in 0:nt { ndef.push(0) }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == 36 {
                da := mfn_ia(&f.instrs, ii)
                db := mfn_ib(&f.instrs, ii)
                if da >= 0 && da < nt { ndef[da] += 1 }
                if db >= 0 && db < nt { ndef[db] += 1 }
            } else if mir_instr_has_dest(k) {
                if k != 7 || mfn_ia(&f.instrs, ii) >= 0 {
                    d := mfn_ia(&f.instrs, ii)
                    if d >= 0 && d < nt { ndef[d] += 1 }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
}

fn mir_dedup_block_copies(f &mut MFn) bool {
    nt := f.temps.len
    if nt <= 0 || f.blocks.len <= 0 { << false }
    mut changed := false
    mut ndef := []int{}
    mir_count_temp_defs(&*f, mut &ndef)

    mut val_rep := []int{}
    for _ in 0:nt { val_rep.push(-1) }

    for bi in 0:f.blocks.len {
        for t in 0:nt { val_rep[t] = -1 }
        mut kill := []int{}
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            d := mfn_ia(&f.instrs, ii)
            if k == 1 {
                s := mfn_ib(&f.instrs, ii)
                mut d_slots := 1
                if d >= 0 && d < f.temps_nslots.len { d_slots = f.temps_nslots[d] }
                mut s_slots := 1
                if s >= 0 && s < f.temps_nslots.len { s_slots = f.temps_nslots[s] }
                if d >= 0 && s >= 0 && d < nt && s < nt && d != s && d_slots == 1 && s_slots == 1 {
                    if val_rep[s] >= 0 {
                        rep := val_rep[s]
                        if ndef[d] == 1 && rep != d {
                            mir_replace_temp_operands_all(f, d, rep)
                            kill.push(ii)
                            changed = true
                        }
                    } else if ndef[d] == 1 {
                        val_rep[s] = d
                    }
                }
            } else {
                if mir_instr_has_dest(k) && (k != 7 || d >= 0) {
                    if d >= 0 && d < nt {
                        val_rep[d] = -1
                        for t in 0:nt {
                            if val_rep[t] == d { val_rep[t] = -1 }
                        }
                    }
                }
                if k == 36 {
                    db := mfn_ib(&f.instrs, ii)
                    if d >= 0 && d < nt {
                        val_rep[d] = -1
                        for t in 0:nt { if val_rep[t] == d { val_rep[t] = -1 } }
                    }
                    if db >= 0 && db < nt {
                        val_rep[db] = -1
                        for t in 0:nt { if val_rep[t] == db { val_rep[t] = -1 } }
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        for ki in 0:kill.len {
            mir_delete_instr(f, bi, kill[ki])
        }
    }
    << changed
}

fn mir_local_binop_cse(f &mut MFn) bool {
    nt := f.temps.len
    if nt <= 0 || f.blocks.len <= 0 { << false }
    mut changed := false
    mut ndef := []int{}
    mir_count_temp_defs(&*f, mut &ndef)

    for bi in 0:f.blocks.len {
        mut rec_op := []int{}
        mut rec_lhs := []int{}
        mut rec_rhs := []int{}
        mut rec_dest := []int{}
        mut kill := []int{}

        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            d := mfn_ia(&f.instrs, ii)
            // Invalidate any earlier recorded expr using d before processing this instr
            if mir_instr_has_dest(k) && (k != 7 || d >= 0) {
                if d >= 0 {
                    for idx in 0:rec_dest.len {
                        if rec_dest[idx] == d || rec_lhs[idx] == d || rec_rhs[idx] == d {
                            rec_dest[idx] = -1
                        }
                    }
                }
            }
            if k == 36 {
                da := mfn_ia(&f.instrs, ii)
                db := mfn_ib(&f.instrs, ii)
                for idx in 0:rec_dest.len {
                    if rec_dest[idx] == da || rec_lhs[idx] == da || rec_rhs[idx] == da || rec_dest[idx] == db || rec_lhs[idx] == db || rec_rhs[idx] == db {
                        rec_dest[idx] = -1
                    }
                }
            }

            if k == 4 {
                op := mfn_ib(&f.instrs, ii)
                lhs := mfn_ic(&f.instrs, ii)
                rhs := mfn_id(&f.instrs, ii)
                mut d_slots := 1
                if d >= 0 && d < f.temps_nslots.len { d_slots = f.temps_nslots[d] }
                mut is_pure_bin := false
                if mir_binop_scalar_cse_op(op) {
                    if d_slots == 1 { is_pure_bin = true }
                }
                if is_pure_bin && d >= 0 && ndef[d] == 1 {
                    d_is_int := f.temps[d] == 1
                    mut matched_dest := -1
                    for idx in 0:rec_dest.len {
                        if rec_dest[idx] < 0 { -> }
                        if rec_op[idx] == op {
                            if rec_lhs[idx] == lhs && rec_rhs[idx] == rhs {
                                matched_dest = rec_dest[idx]
                                <-
                            }
                            if d_is_int && (op == 1 || op == 3 || (op >= 14 && op <= 16)) && rec_lhs[idx] == rhs && rec_rhs[idx] == lhs {
                                matched_dest = rec_dest[idx]
                                <-
                            }
                        }
                    }
                    if matched_dest >= 0 && matched_dest != d {
                        mir_replace_temp_operands_all(f, d, matched_dest)
                        kill.push(ii)
                        changed = true
                    } else {
                        rec_op.push(op)
                        rec_lhs.push(lhs)
                        rec_rhs.push(rhs)
                        rec_dest.push(d)
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        for ki in 0:kill.len {
            mir_delete_instr(f, bi, kill[ki])
        }
    }
    << changed
}

fn mir_hoist_f64_constants(f &mut MFn) {
    if f.blocks.len == 0 { << }
    mut cids := []int{}
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == 4 {
                ia := mfn_ia(&f.instrs, ii)
                op := mfn_ib(&f.instrs, ii)
                ic := mfn_ic(&f.instrs, ii)
                id := mfn_id(&f.instrs, ii)
                mut is_f64_op := false
                if ia >= 0 && ia < f.temps.len && f.temps[ia] == 4 {
                    is_f64_op = true
                } else if op >= 6 && op <= 11 {
                    if (ic >= 0 && ic < f.temps.len && f.temps[ic] == 4) || (id >= 0 && id < f.temps.len && f.temps[id] == 4) {
                        is_f64_op = true
                    }
                }
                if is_f64_op {
                    if ic < 0 {
                        mut seen := false
                        for ci in 0:cids.len { if cids[ci] == ic { seen = true } }
                        if !seen { cids.push(ic) }
                    }
                    if id < 0 {
                        mut seen := false
                        for ci in 0:cids.len { if cids[ci] == id { seen = true } }
                        if !seen { cids.push(id) }
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    if cids.len == 0 { << }
    mut temps := []int{}
    for ci in 0:cids.len {
        ct := f.temps.len
        f.temps.push(4)
        f.temps_nslots.push(1)
        temps.push(ct)
        mut cp := mkinstr(1)
        cp.a = ct
        cp.b = cids[ci]
        cp.line = 0
        cp.col = 0
        cp.file = 0
        mir_prepend_instr(f, 0, cp)
    }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == 4 {
                ia := mfn_ia(&f.instrs, ii)
                op := mfn_ib(&f.instrs, ii)
                ic := mfn_ic(&f.instrs, ii)
                id := mfn_id(&f.instrs, ii)
                mut is_f64_op := false
                if ia >= 0 && ia < f.temps.len && f.temps[ia] == 4 {
                    is_f64_op = true
                } else if op >= 6 && op <= 11 {
                    if (ic >= 0 && ic < f.temps.len && f.temps[ic] == 4) || (id >= 0 && id < f.temps.len && f.temps[id] == 4) {
                        is_f64_op = true
                    }
                }
                if is_f64_op {
                    mut new_c := ic
                    mut new_d := id
                    for ci in 0:cids.len {
                        if ic == cids[ci] { new_c = temps[ci] }
                        if id == cids[ci] { new_d = temps[ci] }
                    }
                    if new_c != ic || new_d != id {
                        mut ins := mfn_instr_snap(mut &f.instrs, ii)
                        ins.c = new_c
                        ins.d = new_d
                        mfn_set_instr(mut &f.instrs, ii, ins)
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
}

fn mir_each_phi_elim(m &mut Mir) {
    n0 := m.fns.len
    mut fi := 0
    while fi < n0 {
        if !mir_fn_is_extern(&*m, fi) && m.fns[fi].phis.len > 0 {
            mut f := mir_clone_fn(m, fi, true)
            if !mir_phi_elim_f(mut &f) {
                eprintln("internal error: MIR Phi elimination verification failed")
                <<< 1
            }
            mir_fold_phi_backedge_copies(mut &f)
            mir_dedup_block_copies(mut &f)
            mir_local_binop_cse(mut &f)
            mir_fold_phi_backedge_copies(mut &f)
            mir_hoist_f64_constants(mut &f)
            mir_fn_commit(m, fi, f)
        }
        fi += 1
    }
    // Hard emitter seam: no live function may retain formal Phi metadata.
    for i in 0:m.fns.len {
        if !mir_fn_is_extern(&*m, i) && (m.fns[i].phis.len != 0 || m.fns[i].phi_args.len != 0) {
            eprintln("internal error: MIR Phi reached legacy emitter")
            <<< 1
        }
    }
}

// Exercise label comparison through an MFn stored in the Mir heap buffer.
pub fn mir_promote_math_label_fixture() bool {
    mut f := mir_fn_blank()
    mut ins := mkinstr(7)
    ins.b = 1
    ins.sval = "_xu_math_sqrt"
    f.instrs.push(ins)
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    positive := mir_promote_math_label_m(&m, 0, 0)
    m.fns[0].instrs[0].sval = "ordinary_call"
    << positive && !mir_promote_math_label_m(&m, 0, 0)
}

fn mir_int_leaf_lens(m &Mir, fi int) bool {
    << m.fns[fi].locals_nslots.len == mir_nlocals(m, fi) && m.fns[fi].temps_nslots.len == mir_ntemps(m, fi)
}

// An imported module must not disable an identical bounded integer leaf.
// CFG inlining can split a straight body into an acyclic Jump chain; accept
// that chain, while keeping loops, branches, calls and memory out.
pub fn mir_scalar_int_leaf_body(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || mir_fn_is_extern(m, fi) { << false }
    nb := mir_nblocks(m, fi)
    nl := mir_nlocals(m, fi)
    nt := mir_ntemps(m, fi)
    ni := mir_nins(m, fi)
    np := mir_fn_nparams(m, fi)
    rt := mir_fn_ret(m, fi)
    if nb <= 0 || nb > 32 || nl > 48 || nt > 256 || ni > 512 { << false }
    if np < 0 || np > 6 || np > nl || (rt != 1 && rt != 2) || mir_fn_ret_nslots(m, fi) != 1 { << false }
    if !mir_int_leaf_lens(m, fi) { << false }
    for l in 0:nl {
        ty := mir_local_ty(m, fi, l)
        if (ty != 1 && ty != 2) || mir_local_nslots(m, fi, l) != 1 { << false }
    }
    for t in 0:nt {
        ty := mir_temp_ty(m, fi, t)
        if (ty != 1 && ty != 2) || mir_temp_nslots(m, fi, t) != 1 { << false }
    }
    mut seen := []bool{}
    for _ in 0:nb { seen.push(false) }
    mut b := 0
    mut returned := false
    for _ in 0:nb + 1 {
        if b < 0 || b >= nb || seen[b] { << false }
        seen[b] = true
        tk := mir_btkind(m, fi, b)
        if tk == 3 { returned = true
            <- }
        if tk != 1 { << false }
        b = mir_bta(m, fi, b)
    }
    if !returned { << false }
    for bi in 0:nb {
        tk := mir_btkind(m, fi, bi)
        head := mir_bhead(m, fi, bi)
        if !seen[bi] {
            if head >= 0 { << false }
            if tk == 1 {
                // CFG inlining leaves empty unreachable Jump tombstones.
                // Admit only a bounded chain joining the live path/Return;
                // an unreachable cycle or dangling target still rejects.
                mut cold := bi
                mut ends := false
                for _ in 0:nb + 1 {
                    if cold < 0 || cold >= nb { << false }
                    if seen[cold] || mir_btkind(m, fi, cold) == 3 { ends = true
                        <- }
                    if mir_btkind(m, fi, cold) != 1 || mir_bhead(m, fi, cold) >= 0 { << false }
                    cold = mir_bta(m, fi, cold)
                }
                if !ends { << false }
            } else if tk != 0 && tk != 3 { << false }
        }
        mut ii := head
        for _ in 0:ni + 1 {
            if ii < 0 { <- }
            if ii >= ni { << false }
            k := mir_ikind(m, fi, ii)
            if k != 0 && (k < 1 || k > 5) { << false }
            op := mir_ib(m, fi, ii)
            // Integer division has target-specific exceptional/clobber paths.
            if k == 4 && (op == 4 || op == 5 || op == 12 || op == 13) { << false }
            if k == 5 && (op == 3 || op == 4) { << false }
            ii = mir_inext(m, fi, ii)
        }
        if ii >= 0 { << false }
    }
    << mir_verify_emission_calls(m, fi)
}
