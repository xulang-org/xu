@xu/types

#xu/ast
#xu/parser

// Logical shapes are registry tags, not checker type IDs for arrays/refs.
// Ordinary Xu lowering owns target registers, hidden sret and throw slots.
fn (c &Checker) runtime_abi_shape_matches(ty int, shape int) bool {
    if shape == 1003 {
        if is_ref_type(ty) && !is_mut_ref_type(ty) && c.ref_inner_type(ty) == 3 && c.type_slots(ty) == 1 { << true }
        << false
    }
    if shape == 200 {
        if !is_array_type(ty) { << false }
        ai := ty - 200
        if ai < 0 || ai >= c.arrays.len { << false }
        << c.arrays[ai].elem_ty == 1 && c.arrays[ai].fixed_len == 0 && c.arrays[ai].elem_bytes == 8 && c.type_slots(ty) == 3
    }
    if shape == 1 || shape == 2 { << ty == shape && c.type_slots(ty) == 1 }
    if shape == 3 { << ty == 3 && c.type_slots(ty) == 3 }
    << false
}

fn (c &Checker) runtime_abi_signature_matches(fi int, id int) bool {
    count := runtime_abi_nparams(id)
    if count < 0 || fi < 0 || fi >= c.fns.len { << false }
    if fi >= c.fn_safe_name.len || fi >= c.fn_safe_mod.len { << false }
    if c.fn_safe_mod[fi] != "runtime" || c.fn_safe_name[fi] != runtime_abi_name(id) { << false }
    if c.fns[fi].recv >= 0 || c.fns[fi].is_extern || c.fns[fi].is_template || c.fns[fi].variadic || !c.fns[fi].is_pub { << false }
    if c.fns[fi].params.len != count { << false }
    for i in 0:count {
        if !c.runtime_abi_shape_matches(c.fns[fi].params[i], runtime_abi_param_shape(id, i)) { << false }
    }
    if !c.runtime_abi_shape_matches(c.fns[fi].ret, runtime_abi_result_shape(id)) { << false }
    if fi >= c.fn_may_throw.len || fi >= c.fn_throw_ty.len { << false }
    if c.fn_may_throw[fi] != runtime_abi_throws(id) { << false }
    if runtime_abi_throws(id) == 1 {
        thrown := c.fn_throw_ty[fi]
        if !is_throw_type(thrown) { << false }
        ti := throw_index(thrown)
        if ti < 0 || ti >= c.throws.len { << false }
        if c.throws[ti].ok_ty != c.fns[fi].ret { << false }
        if c.type_slots(thrown) != 3 { << false }
    } else {
        if c.fn_throw_ty[fi] != 0 { << false }
    }
    << true
}

// Validate any registered entry present in the compilation. Missing entries
// are diagnosed at an actual builtin/method binding, never treated as -N IDs.
// This gate checks ABI only: a name or matching signature does not prove the
// implementation's effects or authorize low-level memory/host primitives.
fn (c &mut Checker) validate_runtime_abi(p &parser.Parser) {
    for i in 0:runtime_abi_count() {
        id := runtime_abi_id_at(i)
        fi := c.find_fn_in_mod(runtime_abi_name(id), "runtime")
        if fi < 0 { -> }
        if !c.runtime_abi_signature_matches(fi, id) {
            d := c.fndecl[fi]
            c.set_cur_file(p, decl_file_id(p, d))
            c.fail_node(p, d, "runtime ABI mismatch: runtime." + runtime_abi_name(id))
        }
    }
    // Native map adapters call these ordinary functions even when source
    // syntax has no explicit runtime call. Reject missing declarations before
    // MIR or relocation, with the same shape/ownership gate as ordinary calls.
    for n in 0:p.nodes.len {
        k := p.nodes[n].kind
        if k != ast.NT_MAP && k != ast.NK_MAP_INIT { -> }
        for id in 10:14 { c.require_runtime_abi(p, n, id) }
        <<
    }
}

fn (c &mut Checker) require_runtime_abi(p &parser.Parser, n int, id int) int {
    if runtime_abi_nparams(id) < 0 {
        c.fail_node(p, n, "unknown runtime ABI ID " + str(id))
        << -1
    }
    fi := c.find_fn_in_mod(runtime_abi_name(id), "runtime")
    if fi < 0 {
        c.fail_node(p, n, "runtime." + runtime_abi_name(id) + " not found (" + runtime_abi_source(id) + ")")
        << -1
    }
    if !c.runtime_abi_signature_matches(fi, id) {
        c.fail_node(p, n, "runtime ABI mismatch: runtime." + runtime_abi_name(id))
        << -1
    }
    << fi
}
