@xu/types

// XU_DUMP_MIR=<fn name>: print the final optimized MIR of every live fn with
// that name to stderr. Debug aid for pattern matchers; operands are printed
// raw (value operands: >= 0 temp, <= -2 const index -(v+2), >=
// mir_local_operand_base frame local).

fn mir_kind_name(k int) string {
    if k == mi_nop { << "nop" }
    if k == mi_copy { << "copy" }
    if k == mi_load_local { << "load_local" }
    if k == mi_store_local { << "store_local" }
    if k == mi_bin { << "bin" }
    if k == mi_un { << "un" }
    if k == mi_str_const { << "str_const" }
    if k == mi_call { << "call" }
    if k == mi_drop { << "drop" }
    if k == mi_str_clone { << "str_clone" }
    if k == mi_load_field { << "load_field" }
    if k == mi_store_field { << "store_field" }
    if k == mi_array_lit { << "array_lit" }
    if k == mi_arr_push { << "arr_push" }
    if k == mi_load_index { << "load_index" }
    if k == mi_result_test { << "result_test" }
    if k == mi_addr { << "addr" }
    if k == mi_load_ptr { << "load_ptr" }
    if k == mi_store_ptr { << "store_ptr" }
    if k == mi_throw_unwrap { << "throw_unwrap" }
    if k == mi_store_index { << "store_index" }
    if k == mi_drop_field { << "drop_field" }
    if k == mi_drop_ptr_field { << "drop_ptr_field" }
    if k == mi_elem_addr { << "elem_addr" }
    if k == mi_drop_buf_field { << "drop_buf_field" }
    if k == mi_store_buf_ptr { << "store_buf_ptr" }
    if k == mi_load_buf_ptr { << "load_buf_ptr" }
    if k == mi_chan_new { << "chan_new" }
    if k == mi_chan_send { << "chan_send" }
    if k == mi_chan_recv { << "chan_recv" }
    if k == mi_xu { << "xu" }
    if k == mi_chan_close { << "chan_close" }
    if k == mi_chan_try_send { << "chan_try_send" }
    if k == mi_chan_try_recv { << "chan_try_recv" }
    if k == mi_xu_pump { << "xu_pump" }
    if k == mi_load_fn_addr { << "load_fn_addr" }
    if k == mi_make_closure { << "make_closure" }
    if k == mi_box_interface { << "box_interface" }
    if k == mi_interface_is { << "interface_is" }
    if k == mi_interface_as { << "interface_as" }
    if k == mi_interface_method { << "interface_method" }
    if k == mi_box_temp { << "box_temp" }
    if k == mi_throw_unwrap_err { << "throw_unwrap_err" }
    if k == mi_arr_push4 { << "arr_push4" }
    if k == mi_index_rmw { << "index_rmw" }
    if k == mi_field_rmw { << "field_rmw" }
    << "kind" + str(k)
}

pub fn mir_dump_named(m &Mir, name string) {
    for fi in 0:m.fns.len {
        if mir_fn_is_extern(m, fi) { -> }
        if fi < m.superseded.len && m.superseded[fi] != 0 { -> }
        if m.fns[fi].name != name { -> }
        eprintln("mir " + name + " (" + mir_fn_label(m, fi) + "): " + str(mir_nblocks(m, fi)) + " blocks, " + str(mir_nlocals(m, fi)) + " locals, " + str(mir_ntemps(m, fi)) + " temps")
        mut consts := "  consts:"
        for k in 0:mir_nconsts(m, fi) { consts = consts + " #" + str(k) + "=" + str(mir_const_at(m, fi, k)) }
        eprintln(consts)
        for bi in 0:mir_nblocks(m, fi) {
            eprintln("  bb" + str(bi) + ":")
            mut ii := mir_bhead(m, fi, bi)
            for _ in 0:mir_nins(m, fi) {
                if ii < 0 { <- }
                mut line := "    i" + str(ii) + " " + mir_kind_name(mir_ikind(m, fi, ii)) + " " + str(mir_ia(m, fi, ii)) + " " + str(mir_ib(m, fi, ii)) + " " + str(mir_ic(m, fi, ii)) + " " + str(mir_id(m, fi, ii))
                if mir_isval_len(m, fi, ii) > 0 { line = line + " \"" + mir_isval(m, fi, ii) + "\"" }
                eprintln(line)
                ii = mir_inext(m, fi, ii)
            }
            tk := mir_btkind(m, fi, bi)
            mut term := "    term " + str(tk)
            if tk == 1 { term = "    jump bb" + str(mir_bta(m, fi, bi)) }
            if tk == 2 { term = "    branch " + str(mir_bta(m, fi, bi)) + " ? bb" + str(mir_btb(m, fi, bi)) + " : bb" + str(mir_btc(m, fi, bi)) }
            if tk == 3 { term = "    return " + str(mir_bta(m, fi, bi)) }
            eprintln(term)
        }
    }
}
