@xu/types

// temp/any itable discriminants, shared by lowering, verification and emit.
// These values are part of the box ABI, distinct from Checker type codes.
// Keep scalar ids contiguous and family domains disjoint. Itable label
// spellings such as _xu_any_ff01 remain stable ABI symbols.
pub const any_tag_int = 65281
pub const any_tag_bool = 65282
pub const any_tag_string = 65283
pub const any_tag_f64 = 65284
pub const any_tag_i32 = 65285
pub const any_tag_u32 = 65286
pub const any_tag_u8 = 65287
pub const any_tag_enum_base = 4026531840
pub const any_tag_array_base = 3758096384
pub const any_tag_throw_base = 3489660928
pub const any_tag_chan_base = 3221225472
pub const any_tag_map_base = 2415919104
pub const any_tag_fn_base = 2952790016
pub const any_tag_param_base = 2684354560
