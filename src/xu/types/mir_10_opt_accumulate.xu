@xu/types

// Reassociate only wrapping int addition around a single recursive result.
// All state is scalar and call-free apart from self calls and checked
// arithmetic traps: no owners, references, memory effects or delayed work
// can observe moving the private addition before the next iteration.
// Return the new accumulator LocalId, or -1 without changing the function.
fn mir_accumulator_tail_prepare(f $&MFn) int {
    if f.ret != 1 || f.ret_nslots != 1 { << -1 }
    ni := f.instrs.len
    nb := f.blocks.len
    if ni > 2048 || nb > 128 || ni * nb > 65536 { << -1 }
    if f.locals_nslots.len != f.locals.len || f.temps_nslots.len != f.temps.len || f.nparams > f.locals.len { << -1 }
    for li in 0:f.locals.len {
        if f.locals_nslots[li] != 1 || (f.locals[li] != 1 && f.locals[li] != 2) { << -1 }
    }
    for ti in 0:f.temps.len {
        if f.temps_nslots[ti] != 1 || (f.temps[ti] != 1 && f.temps[ti] != 2) { << -1 }
    }
    $self_calls := 0
    for ii in 0:ni {
        k := mfn_ikind(&f.instrs, ii)
        if k == MI_CALL {
            if mfn_ib(&f.instrs, ii) != 1 { << -1 }
            label := mfn_isval(&f.instrs, ii)
            if mir_is_noreturn_trap(label + "") {
                if mfn_ia(&f.instrs, ii) != -1 || mfn_ic(&f.instrs, ii) != -1 { << -1 }
            } else if label == f.label {
                self_calls += 1
            } else {
                << -1
            }
        } else if k != MI_NOP && k != MI_COPY && k != MI_LOAD_LOCAL && k != MI_STORE_LOCAL && k != MI_BIN && k != MI_UN {
            << -1
        }
    }
    if self_calls == 0 { << -1 }
    $blocks := []int{}
    $calls := []int{}
    $adds := []int{}
    $deltas := []int{}
    $reachable := []bool{}
    mir_cfg_mark_reachable_f(&*f, $&reachable)
    for bi in 0:nb {
        if !reachable[bi] { -> }
        if f.blocks[bi].tkind != 3 { -> }
        ret := f.blocks[bi].ta
        if ret == -1 { << -1 }
        $last := -1
        $previous := -1
        $ii := f.blocks[bi].head
        for _ in 0:ni {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) != MI_NOP {
                previous = last
                last = ii
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        if last < 0 || previous < 0 { -> }
        if mfn_ikind(&f.instrs, last) != MI_BIN || mfn_ib(&f.instrs, last) != 1 || mfn_ia(&f.instrs, last) != ret { -> }
        if mfn_ikind(&f.instrs, previous) != MI_CALL || mfn_ib(&f.instrs, previous) != 1 { -> }
        if mfn_isval(&f.instrs, previous) != f.label { -> }
        cr := mfn_ia(&f.instrs, previous)
        if cr < 0 { << -1 }
        left := mfn_ic(&f.instrs, last)
        right := mfn_id(&f.instrs, last)
        $delta := -1
        if left == cr && right != cr { delta = right }
        if right == cr && left != cr { delta = left }
        if delta == -1 { << -1 }
        $ap := mfn_ic(&f.instrs, previous)
        $nargs := 0
        while ap >= 0 {
            if ap >= f.margs.len || nargs >= f.nparams { << -1 }
            nargs += 1
            ap = mfn_marg_next(&f.margs, ap)
        }
        if ap != -1 || nargs != f.nparams { << -1 }
        blocks.push(bi)
        calls.push(previous)
        adds.push(last)
        deltas.push(delta)
    }
    // A second recursive result, a non-additive use, or deferred work keeps
    // the original recursion. Do not partially transform such a function.
    if blocks.len != self_calls { << -1 }
    acc := mir_opt_add_local(f, 1)
    for ci in 0:blocks.len {
        bi := blocks[ci]
        call := calls[ci]
        cr := mfn_ia(&f.instrs, call)
        // Retain the original Call InstrId and its label owner; moving it
        // avoids copying an owning MInstr across the Gen1 slice ABI.
        if !mir_detach_instr(f, bi, call) || !mir_delete_instr(f, bi, adds[ci]) {
            eprintln("internal compiler error: accumulator call ownership")
            <<< 1
        }
        at := mir_opt_add_temp(f, 1)
        $load := mkinstr(MI_LOAD_LOCAL)
        load.a = at
        load.b = acc
        mir_cfg_append(f, bi, load)
        sum := mir_opt_add_temp(f, 1)
        $add := mkinstr(MI_BIN)
        add.a = sum
        add.b = 1
        add.c = at
        add.d = deltas[ci]
        mir_cfg_append(f, bi, add)
        $store := mkinstr(MI_STORE_LOCAL)
        store.a = acc
        store.b = sum
        mir_cfg_append(f, bi, store)
        mir_append_instr(f, bi, call)
        $block := f.blocks[bi]
        block.ta = cr
        mfn_set_block($&f.blocks, bi, block)
    }
    for bi in 0:nb {
        if !reachable[bi] { -> }
        if f.blocks[bi].tkind != 3 { -> }
        $recursive := false
        for b in blocks { if b == bi { recursive = true } }
        if recursive { -> }
        value := f.blocks[bi].ta
        at := mir_opt_add_temp(f, 1)
        $load := mkinstr(MI_LOAD_LOCAL)
        load.a = at
        load.b = acc
        mir_cfg_append(f, bi, load)
        result := mir_opt_add_temp(f, 1)
        $add := mkinstr(MI_BIN)
        add.a = result
        add.b = 1
        add.c = value
        add.d = at
        mir_cfg_append(f, bi, add)
        $block := f.blocks[bi]
        block.ta = result
        mfn_set_block($&f.blocks, bi, block)
    }
    << acc
}
