@xu/types

// An ordered scalar definition query. Local storage and Temp destinations
// are separate namespaces: StoreLocal.a is never a Temp definition.
// Return an InstrId, -1 for no definition in this block prefix, or -2 when
// the point/stream is malformed or outside this bounded reader's domain.
// This is not a dominance or all-path initialization proof.
pub fn mir_value_def_before(m &Mir, fi int, bi int, before int, cell_kind int, cell int) int {
    if fi < 0 || fi >= m.fns.len { << -2 }
    nb := mir_nblocks(m, fi)
    ni := mir_nins(m, fi)
    if bi < 0 || bi >= nb || ni < 0 || ni > 4096 { << -2 }
    if before < -1 || before >= ni { << -2 }
    if cell_kind == 1 {
        if cell < 0 || cell >= mir_nlocals(m, fi) { << -2 }
    } else if cell_kind == 2 {
        if cell < 0 || cell >= mir_ntemps(m, fi) { << -2 }
    } else { << -2 }
    $last := -1
    $seen := false
    $ii := mir_bhead(m, fi, bi)
    $tail := -1
    for _ in 0:ni + 1 {
        if ii == -1 {
            if tail != mir_btail(m, fi, bi) { << -2 }
            if before == -1 || seen { << last }
            << -2
        }
        if ii < 0 || ii >= ni { << -2 }
        if ii == before {
            if seen { << -2 }
            seen = true
        }
        k := mir_ikind(m, fi, ii)
        // Reserved/unknown opcodes cannot silently hide a definition.
        if k < 0 || k > 48 || (k >= 27 && k <= 29) { << -2 }
        if !seen {
            if cell_kind == 1 {
                if k == MI_STORE_LOCAL && mir_ia(m, fi, ii) == cell { last = ii }
            } else {
                if mir_instr_has_dest(k) && mir_ia(m, fi, ii) == cell { last = ii }
                // ChanRecv and TryRecv have a second Temp result.
                if k == MI_CHAN_RECV && mir_id(m, fi, ii) == cell { last = ii }
                if k == MI_CHAN_TRY_RECV && mir_ib(m, fi, ii) == cell { last = ii }
            }
        }
        tail = ii
        ii = mir_inext(m, fi, ii)
    }
    << -2
}

pub struct MirValueRef {
    pub kind int    // 0 unknown, 1 formal Local snapshot, 2 Temp snapshot, 3 Const
    pub id int
    pub ty int
    pub block int
    pub before int
    pub version int // defining instruction, or -1 for a formal entry value
}

// Resolve Copy/LoadLocal/StoreLocal by the actual scalar prefix at each read. A
// later rewrite of a Local or Temp cannot change an earlier snapshot. Values
// from another block decline until CFG/must-def facts are supplied by B0.2.
// Address-visible or effectful prefixes decline: pointer writes and calls can
// change storage without a StoreLocal or fresh Temp definition. Arithmetic
// snapshots are identities of already executed definitions, not permission
// to speculate potentially trapping operations.
pub fn mir_scalar_value_before(m &Mir, fi int, bi int, before int, cell_kind int, cell int) MirValueRef {
    $out := MirValueRef{kind: 0, id: -1, ty: -1, block: bi, before: before, version: -1}
    if fi < 0 || fi >= m.fns.len { << out }
    if m.fns[fi].temps_nslots.len != mir_ntemps(m, fi) || m.fns[fi].locals_nslots.len != mir_nlocals(m, fi) { << out }
    if mir_fn_nparams(m, fi) < 0 || mir_fn_nparams(m, fi) > mir_nlocals(m, fi) { << out }
    if mir_value_def_before(m, fi, bi, before, cell_kind, cell) < -1 { << out }
    $ii := mir_bhead(m, fi, bi)
    for _ in 0:mir_nins(m, fi) {
        if ii == -1 || ii == before { <- }
        k := mir_ikind(m, fi, ii)
        if k < 0 || k > 5 { << out }
        if k > 0 {
            dest := mir_ia(m, fi, ii)
            $dt := -1
            $ds := 0
            if k == MI_STORE_LOCAL {
                if dest < 0 || dest >= mir_nlocals(m, fi) { << out }
                dt = mir_local_ty(m, fi, dest)
                ds = mir_local_nslots(m, fi, dest)
            } else {
                if dest < 0 || dest >= mir_ntemps(m, fi) { << out }
                dt = mir_temp_ty(m, fi, dest)
                ds = mir_temp_nslots(m, fi, dest)
            }
            if ds != 1 || (dt != 1 && dt != 2) { << out }
            if k == MI_BIN || k == MI_UN {
                effects := mir_instr_effects_m(m, fi, ii)
                if mir_effect_has(effects, MIR_EFFECT_CALL) { << out }
            }
        }
        ii = mir_inext(m, fi, ii)
    }
    $kind := cell_kind
    $value := cell
    $point := before
    $ty := -1
    for _ in 0:32 {
        if kind == 3 {
            if value > -2 { << out }
            // Subtract only after rejecting INT_MIN, avoiding signed overflow.
            if value == 0 - 9223372036854775807 - 1 { << out }
            ci := 0 - value - 2
            if ci < 0 || ci >= mir_nconsts(m, fi) { << out }
            if ty != 1 && ty != 2 { << out }
            cv := mir_const_at(m, fi, ci)
            if ty == 2 && cv != 0 && cv != 1 { << out }
            out.kind = 3
            out.id = cv
            out.ty = ty
            out.before = point
            << out
        }
        def := mir_value_def_before(m, fi, bi, point, kind, value)
        if def < -1 { << out }
        $current_ty := -1
        $slots := 0
        if kind == 1 {
            current_ty = mir_local_ty(m, fi, value)
            slots = mir_local_nslots(m, fi, value)
        } else if kind == 2 {
            current_ty = mir_temp_ty(m, fi, value)
            slots = mir_temp_nslots(m, fi, value)
        } else { << out }
        if slots != 1 || (current_ty != 1 && current_ty != 2) { << out }
        if ty < 0 { ty = current_ty }
        if current_ty != ty { << out }
        if def == -1 {
            if kind != 1 || value >= mir_fn_nparams(m, fi) || bi != 0 { << out }
            // Only a true entry formal is known without predecessor facts.
            // Legacy MIR can contain a backedge to block zero; decline that
            // graph rather than assume every iteration reads the entry value.
            nb := mir_nblocks(m, fi)
            if nb > 4096 { << out }
            for b in 0:nb {
                tk := mir_btkind(m, fi, b)
                if tk == 1 && mir_bta(m, fi, b) == 0 { << out }
                if tk == 2 && (mir_btb(m, fi, b) == 0 || mir_btc(m, fi, b) == 0) { << out }
            }
            out.kind = 1
            out.id = value
            out.ty = ty
            out.before = point
            << out
        }
        k := mir_ikind(m, fi, def)
        if kind == 1 || k == MI_COPY {
            value = mir_ib(m, fi, def)
            kind = 2
            if value <= -2 { kind = 3 }
            point = def
        } else if k == MI_LOAD_LOCAL {
            value = mir_ib(m, fi, def)
            kind = 1
            point = def
        } else {
            out.kind = 2
            out.id = value
            out.ty = ty
            out.before = point
            out.version = def
            << out
        }
    }
    << out
}
