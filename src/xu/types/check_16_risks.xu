@xu/types

#xu/ast
#xu/parser

// Check-mode risk summaries (after ordinary warnings): unbounded loops
// (including cross-function paths) and process-exit sites. Never affects
// the exit code.

struct RiskBuf {
    loops []string
    exits []string
    fn_decl []int
    fn_name []string
    fn_disp []string
    fn_mod []string
    fn_file []int
    fn_recv []int
    nfn int
    cg_from []int
    cg_to []int
    loop_line []int
    loop_col []int
    loop_fid []int
    loop_fn []int
    local_loop []int
    in_cycle []int
    diverging []int
    next_hop []int
    cycle_of []int
    cycle_start []int
    cycle_msg []string
}

struct RiskFlow {
    may_exit bool
    may_ft bool
}

pub fn emit_check_risks(p &parser.Parser) {
    mut b := RiskBuf{
        loops: []string{},
        exits: []string{},
        fn_decl: []int{},
        fn_name: []string{},
        fn_disp: []string{},
        fn_mod: []string{},
        fn_file: []int{},
        fn_recv: []int{},
        nfn: 0,
        cg_from: []int{},
        cg_to: []int{},
        loop_line: []int{},
        loop_col: []int{},
        loop_fid: []int{},
        loop_fn: []int{},
        local_loop: []int{},
        in_cycle: []int{},
        diverging: []int{},
        next_hop: []int{},
        cycle_of: []int{},
        cycle_start: []int{},
        cycle_msg: []string{}
    }
    b.collect(p)
    b.analyze(p)
    eprintln("")
    eprintln("infinite loop risk:")
    if b.loops.len == 0 {
        eprintln("  (none)")
    } else {
        for i in 0:b.loops.len {
            eprintln("  " + b.loops[i])
        }
    }
    eprintln("process exit sites:")
    if b.exits.len == 0 {
        eprintln("  (none)")
    } else {
        for i in 0:b.exits.len {
            eprintln("  " + b.exits[i])
        }
    }
}

fn (b &mut RiskBuf) collect(p &parser.Parser) {
    for i in 0:p.decls.len {
        d := p.decls[i]
        if p.nodes[d].kind != ast.nk_fn {
            ->
        }
        fid := p.file_of(d)
        b.fn_decl.push(d)
        b.fn_name.push(p.nodes[d].sval + "")
        b.fn_disp.push(risk_fn_disp(p, d))
        b.fn_mod.push(p.nodes[d].sval2 + "")
        b.fn_file.push(fid)
        if p.nodes[d].d >= 0 {
            b.fn_recv.push(1)
        } else {
            b.fn_recv.push(0)
        }
        b.local_loop.push(0)
        b.in_cycle.push(0)
        b.diverging.push(0)
        b.next_hop.push(-1)
        b.cycle_of.push(-1)
        b.nfn = b.nfn + 1
        body := p.nodes[d].c
        b.scan_exits_list(p, body, fid)
        fi := b.nfn - 1
        b.scan_loops_list(p, body, fid, fi)
        b.walk_stmt_calls(p, body, fi)
    }
}

fn risk_fn_disp(p &parser.Parser, d int) string {
    name := p.nodes[d].sval + ""
    rd := p.nodes[d].d
    if rd < 0 {
        << name
    }
    ty := p.nodes[rd].a
    tname := risk_type_name(p, ty)
    if tname.len == 0 {
        << name
    }
    << tname + "." + name
}

fn risk_type_name(p &parser.Parser, n int) string {
    if n < 0 {
        << ""
    }
    k := p.nodes[n].kind
    if k == ast.nt_named {
        << p.nodes[n].sval + ""
    }
    if k == ast.nt_ref {
        << risk_type_name(p, p.nodes[n].a)
    }
    << ""
}

fn risk_path(p &parser.Parser, fid int) string {
    if fid >= 0 && fid < p.file_names.len {
        << p.file_names[fid] + ""
    }
    << ""
}

fn risk_line(p &parser.Parser, fid int, line int, col int, msg string) string {
    path := risk_path(p, fid)
    if path.len == 0 {
        << str(line) + ":" + str(col) + ": " + msg
    }
    << path + ":" + str(line) + ":" + str(col) + ": " + msg
}

fn (b &mut RiskBuf) scan_exits_list(p &parser.Parser, head int, fid int) {
    mut s := head
    while s >= 0 {
        b.scan_exits_stmt(p, s, fid)
        s = p.nodes[s].next
    }
}

fn (b &mut RiskBuf) scan_exits_stmt(p &parser.Parser, n int, fid int) {
    k := p.nodes[n].kind
    if k == ast.nk_exit {
        b.exits.push(risk_line(p, fid, p.nodes[n].line, p.nodes[n].col, "process exit (<<<)"))
        <<
    }
    if k == ast.nk_expr_stmt {
        e := p.nodes[n].a
        if e >= 0 && p.nodes[e].kind == ast.nk_call && p.nodes[e].sval == "assert" {
            b.exits.push(risk_line(p, fid, p.nodes[e].line, p.nodes[e].col, "assertion failure exits process"))
        }
        <<
    }
    if k == ast.nk_while {
        b.scan_exits_list(p, p.nodes[n].c, fid)
        <<
    }
    if k == ast.nk_for || k == ast.nk_for_each {
        b.scan_exits_list(p, p.nodes[n].c, fid)
        <<
    }
    if k == ast.nk_if {
        mut br := p.nodes[n].a
        while br >= 0 {
            b.scan_exits_list(p, p.nodes[br].b, fid)
            br = p.nodes[br].next
        }
        <<
    }
    if k == ast.nk_match {
        mut ar := p.nodes[n].b
        while ar >= 0 {
            b.scan_exits_list(p, p.nodes[ar].c, fid)
            ar = p.nodes[ar].next
        }
        <<
    }
}

fn (b &mut RiskBuf) scan_loops_list(p &parser.Parser, head int, fid int, fi int) {
    mut s := head
    while s >= 0 {
        b.scan_loops_stmt(p, s, fid, fi)
        s = p.nodes[s].next
    }
}

fn (b &mut RiskBuf) scan_loops_stmt(p &parser.Parser, n int, fid int, fi int) {
    k := p.nodes[n].kind
    if k == ast.nk_while {
        if is_const_true_expr(p, p.nodes[n].a) {
            if !stmt_list_has_terminator(p, p.nodes[n].c, 0) {
                b.loop_line.push(p.nodes[n].line)
                b.loop_col.push(p.nodes[n].col)
                b.loop_fid.push(fid)
                b.loop_fn.push(fi)
                b.local_loop[fi] = 1
            }
        }
        b.scan_loops_list(p, p.nodes[n].c, fid, fi)
        <<
    }
    if k == ast.nk_for || k == ast.nk_for_each {
        b.scan_loops_list(p, p.nodes[n].c, fid, fi)
        <<
    }
    if k == ast.nk_if {
        mut br := p.nodes[n].a
        while br >= 0 {
            b.scan_loops_list(p, p.nodes[br].b, fid, fi)
            br = p.nodes[br].next
        }
        <<
    }
    if k == ast.nk_match {
        mut ar := p.nodes[n].b
        while ar >= 0 {
            b.scan_loops_list(p, p.nodes[ar].c, fid, fi)
            ar = p.nodes[ar].next
        }
        <<
    }
    if k == ast.nt_fn_lit {
        b.scan_loops_list(p, p.nodes[n].c, fid, fi)
        <<
    }
}

fn (b &mut RiskBuf) add_edge(u int, v int) {
    if u < 0 || v < 0 || u >= b.nfn || v >= b.nfn {
        <<
    }
    b.cg_from.push(u)
    b.cg_to.push(v)
}

fn (b &mut RiskBuf) walk_stmt_calls(p &parser.Parser, head int, caller int) {
    mut s := head
    while s >= 0 {
        b.walk_one_stmt_calls(p, s, caller)
        s = p.nodes[s].next
    }
}

fn (b &mut RiskBuf) walk_one_stmt_calls(p &parser.Parser, n int, caller int) {
    if n < 0 {
        <<
    }
    k := p.nodes[n].kind
    if k == ast.nk_let {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        <<
    }
    if k == ast.nk_assign {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        b.walk_expr_calls(p, p.nodes[n].b, caller)
        <<
    }
    if k == ast.nk_expr_stmt {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        <<
    }
    if k == ast.nk_return || k == ast.nk_throw || k == ast.nk_exit {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        <<
    }
    if k == ast.nk_if {
        mut br := p.nodes[n].a
        while br >= 0 {
            b.walk_expr_calls(p, p.nodes[br].a, caller)
            b.walk_stmt_calls(p, p.nodes[br].b, caller)
            br = p.nodes[br].next
        }
        <<
    }
    if k == ast.nk_for {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        b.walk_expr_calls(p, p.nodes[n].b, caller)
        b.walk_stmt_calls(p, p.nodes[n].c, caller)
        <<
    }
    if k == ast.nk_for_each {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        b.walk_stmt_calls(p, p.nodes[n].c, caller)
        <<
    }
    if k == ast.nk_while {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        b.walk_stmt_calls(p, p.nodes[n].c, caller)
        <<
    }
    if k == ast.nk_match {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        mut ar := p.nodes[n].b
        while ar >= 0 {
            b.walk_stmt_calls(p, p.nodes[ar].c, caller)
            ar = p.nodes[ar].next
        }
        <<
    }
    if k == ast.nk_xu {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        <<
    }
    if k == ast.nt_fn_lit {
        b.walk_stmt_calls(p, p.nodes[n].c, caller)
        <<
    }
}

fn (b &mut RiskBuf) walk_expr_calls(p &parser.Parser, n int, caller int) {
    if n < 0 {
        <<
    }
    k := p.nodes[n].kind
    if k == ast.nk_call {
        j := b.resolve_callee(p, n, 0, caller)
        if j >= 0 {
            b.add_edge(caller, j)
        }
        mut a := p.nodes[n].a
        while a >= 0 {
            b.walk_expr_calls(p, a, caller)
            a = p.nodes[a].next
        }
        <<
    }
    if k == ast.nk_method_call {
        j := b.resolve_callee(p, n, 1, caller)
        if j >= 0 {
            b.add_edge(caller, j)
        }
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        mut a := p.nodes[n].b
        while a >= 0 {
            b.walk_expr_calls(p, a, caller)
            a = p.nodes[a].next
        }
        <<
    }
    if k == ast.nt_fn_lit {
        b.walk_stmt_calls(p, p.nodes[n].c, caller)
        <<
    }
    if k == ast.nk_or_catch {
        b.walk_expr_calls(p, p.nodes[n].a, caller)
        b.walk_stmt_calls(p, p.nodes[n].c, caller)
        <<
    }
    b.walk_expr_calls(p, p.nodes[n].a, caller)
    b.walk_expr_calls(p, p.nodes[n].b, caller)
    b.walk_expr_calls(p, p.nodes[n].c, caller)
}

fn module_last_seg(mid string) string {
    mut last := 0
    mut i := 0
    n := mid.len
    while i < n {
        if mid[i] == 47 {
            last = i + 1
        }
        i = i + 1
    }
    if last == 0 {
        << mid + ""
    }
    << mid[last:]
}

fn (b &RiskBuf) caller_mod(caller int) string {
    if caller >= 0 && caller < b.nfn {
        << b.fn_mod[caller] + ""
    }
    << ""
}

fn method_pkg(p &parser.Parser, obj int) string {
    if obj >= 0 && p.nodes[obj].kind == ast.nk_ident {
        << p.nodes[obj].sval + ""
    }
    << ""
}

fn (b &RiskBuf) resolve_callee(p &parser.Parser, call int, is_method int, caller int) int {
    if p.nodes[call].sval == "assert" {
        << -1
    }
    if p.nodes[call].sval == "println" {
        << -1
    }
    if p.nodes[call].sval == "print" {
        << -1
    }
    if p.nodes[call].sval == "args" {
        << -1
    }
    if p.nodes[call].sval == "now_ns" {
        << -1
    }
    if p.nodes[call].sval == "wall_time_ns" {
        << -1
    }
    if p.nodes[call].sval == "read_file" {
        << -1
    }
    if p.nodes[call].sval == "write_file" {
        << -1
    }
    if p.nodes[call].sval == "read_dir" {
        << -1
    }
    if p.nodes[call].sval == "parse_int" {
        << -1
    }
    if p.nodes[call].sval == "exit" {
        << -1
    }
    if is_method == 1 {
        pk := method_pkg(p, p.nodes[call].a)
        if pk.len > 0 {
            mut hits := 0
            mut found := -1
            for i in 0:b.nfn {
                if b.fn_recv[i] != 0 {
                    ->
                }
                if b.fn_name[i] != p.nodes[call].sval {
                    ->
                }
                last := module_last_seg(b.fn_mod[i] + "")
                pk1 := method_pkg(p, p.nodes[call].a)
                if b.fn_mod[i] == pk1 {
                    hits = hits + 1
                    found = i
                } else {
                    pk2 := method_pkg(p, p.nodes[call].a)
                    if last == pk2 {
                        hits = hits + 1
                        found = i
                    }
                }
            }
            if hits == 1 {
                << found
            }
        }
    }
    j := b.pick_named(p, call, is_method, caller)
    << j
}

fn (b &RiskBuf) pick_named(p &parser.Parser, call int, want_recv int, caller int) int {
    mut hits := 0
    mut found := -1
    mut same := 0
    mut same_found := -1
    for i in 0:b.nfn {
        if b.fn_name[i] != p.nodes[call].sval {
            ->
        }
        if b.fn_recv[i] != want_recv {
            ->
        }
        hits = hits + 1
        found = i
        cm := b.caller_mod(caller)
        if b.fn_mod[i] == cm {
            same = same + 1
            same_found = i
        }
    }
    if hits == 1 {
        << found
    }
    if want_recv == 1 {
        << -1
    }
    if same == 1 {
        << same_found
    }
    << -1
}

fn csr_push(g_head &mut []int, g_to &mut []int, g_next &mut []int, u int, v int, ne int) int {
    ei := ne
    head := g_head[u]
    g_to.push(v)
    g_next.push(head)
    g_head[u] = ei
    << ne + 1
}

fn (b &mut RiskBuf) analyze(p &parser.Parser) {
    n := b.nfn
    if n <= 0 {
        <<
    }
    mut g_head := []int{}
    mut g_to := []int{}
    mut g_next := []int{}
    mut gt_head := []int{}
    mut gt_to := []int{}
    mut gt_next := []int{}
    for i in 0:n {
        g_head.push(-1)
        gt_head.push(-1)
    }
    mut ne := 0
    mut net := 0
    n_cg := b.cg_from.len
    for e in 0:n_cg {
        u := b.cg_from[e]
        v := b.cg_to[e]
        if u < 0 || u >= n || v < 0 || v >= n {
            ->
        }
        ne = csr_push(mut &g_head, mut &g_to, mut &g_next, u, v, ne)
        net = csr_push(mut &gt_head, mut &gt_to, mut &gt_next, v, u, net)
    }
    mut order := []int{}
    for i in 0:n {
        order.push(0)
    }
    on := risk_dfs_finish(n, &g_head, &g_to, &g_next, mut &order)
    mut comp := []int{}
    for i in 0:n {
        comp.push(-1)
    }
    ncomp := risk_dfs_scc(n, on, &order, &gt_head, &gt_to, &gt_next, mut &comp)
    mut scc_count := []int{}
    mut scc_min := []int{}
    mut scc_self := []int{}
    for i in 0:ncomp {
        scc_count.push(0)
        scc_min.push(n)
        scc_self.push(0)
    }
    for i in 0:n {
        cid := comp[i]
        if cid < 0 || cid >= ncomp {
            ->
        }
        scc_count[cid] = scc_count[cid] + 1
        if i < scc_min[cid] {
            scc_min[cid] = i
        }
    }
    n_cg2 := b.cg_from.len
    for e in 0:n_cg2 {
        u := b.cg_from[e]
        v := b.cg_to[e]
        if u == v && u >= 0 && u < n {
            cid := comp[u]
            if cid >= 0 && cid < ncomp {
                scc_self[cid] = 1
            }
        }
    }
    for cid in 0:ncomp {
        if scc_count[cid] < 2 && scc_self[cid] == 0 {
            ->
        }
        mut in_scc := []int{}
        for i in 0:n {
            if comp[i] == cid {
                in_scc.push(1)
            } else {
                in_scc.push(0)
            }
        }
        mut escapes := false
        for i in 0:n {
            if in_scc[i] == 0 {
                ->
            }
            if b.fn_may_escape(p, i, &in_scc) {
                escapes = true
            }
        }
        if escapes {
            ->
        }
        cidx := b.cycle_start.len
        for i in 0:n {
            if in_scc[i] == 1 {
                b.in_cycle[i] = 1
                b.diverging[i] = 1
                b.cycle_of[i] = cidx
            }
        }
        start := scc_min[cid]
        msg := b.cycle_path_msg(start, cid, &comp, &g_head, &g_to, &g_next)
        b.cycle_start.push(start)
        b.cycle_msg.push(msg)
    }
    for i in 0:n {
        if b.local_loop[i] == 1 {
            b.diverging[i] = 1
        }
    }
    mut changed := true
    while changed {
        changed = false
        for i in 0:n {
            if b.diverging[i] == 1 {
                ->
            }
            d := b.fn_decl[i]
            g := b.stmts_must_hop(p, p.nodes[d].c, i)
            if g >= 0 {
                b.diverging[i] = 1
                b.next_hop[i] = g
                changed = true
            }
        }
    }
    b.emit_lines(p, &g_head, &g_to, &g_next)
}

fn (b &RiskBuf) fn_may_escape(p &parser.Parser, fi int, in_scc &[]int) bool {
    d := b.fn_decl[fi]
    fl := b.stmts_flow(p, p.nodes[d].c, fi, in_scc)
    if fl.may_exit {
        << true
    }
    if fl.may_ft {
        << true
    }
    << false
}

fn (b &RiskBuf) stmts_flow(p &parser.Parser, head int, fi int, in_scc &[]int) RiskFlow {
    mut may_exit := false
    mut reachable := true
    mut s := head
    while s >= 0 {
        if !reachable {
            <-
        }
        sf := b.stmt_flow(p, s, fi, in_scc)
        if sf.may_exit {
            may_exit = true
        }
        reachable = sf.may_ft
        s = p.nodes[s].next
    }
    << RiskFlow{may_exit: may_exit, may_ft: reachable}
}

fn (b &RiskBuf) stmt_flow(p &parser.Parser, n int, fi int, in_scc &[]int) RiskFlow {
    k := p.nodes[n].kind
    if k == ast.nk_return {
        if b.expr_calls_scc(p, p.nodes[n].a, fi, in_scc) {
            << RiskFlow{may_exit: false, may_ft: false}
        }
        << RiskFlow{may_exit: true, may_ft: false}
    }
    if k == ast.nk_throw || k == ast.nk_exit {
        << RiskFlow{may_exit: true, may_ft: false}
    }
    if k == ast.nk_expr_stmt {
        e := p.nodes[n].a
        if e >= 0 && p.nodes[e].kind == ast.nk_call && p.nodes[e].sval == "assert" {
            << RiskFlow{may_exit: true, may_ft: false}
        }
        if b.expr_calls_scc(p, e, fi, in_scc) {
            << RiskFlow{may_exit: false, may_ft: false}
        }
        << RiskFlow{may_exit: false, may_ft: true}
    }
    if k == ast.nk_let {
        if b.expr_calls_scc(p, p.nodes[n].a, fi, in_scc) {
            << RiskFlow{may_exit: false, may_ft: false}
        }
        << RiskFlow{may_exit: false, may_ft: true}
    }
    if k == ast.nk_assign {
        if b.expr_calls_scc(p, p.nodes[n].b, fi, in_scc) {
            << RiskFlow{may_exit: false, may_ft: false}
        }
        << RiskFlow{may_exit: false, may_ft: true}
    }
    if k == ast.nk_while {
        if is_const_true_expr(p, p.nodes[n].a) {
            if !stmt_list_has_terminator(p, p.nodes[n].c, 0) {
                << RiskFlow{may_exit: false, may_ft: false}
            }
        }
        bf := b.stmts_flow(p, p.nodes[n].c, fi, in_scc)
        << RiskFlow{may_exit: bf.may_exit, may_ft: true}
    }
    if k == ast.nk_for || k == ast.nk_for_each {
        bf := b.stmts_flow(p, p.nodes[n].c, fi, in_scc)
        << RiskFlow{may_exit: bf.may_exit, may_ft: true}
    }
    if k == ast.nk_if {
        mut may_exit := false
        mut may_ft := false
        mut has_else := false
        mut br := p.nodes[n].a
        while br >= 0 {
            if p.nodes[br].a < 0 {
                has_else = true
            }
            bf := b.stmts_flow(p, p.nodes[br].b, fi, in_scc)
            if bf.may_exit {
                may_exit = true
            }
            if bf.may_ft {
                may_ft = true
            }
            br = p.nodes[br].next
        }
        if !has_else {
            may_ft = true
        }
        << RiskFlow{may_exit: may_exit, may_ft: may_ft}
    }
    if k == ast.nk_match {
        mut may_exit := false
        mut may_ft := false
        mut ar := p.nodes[n].b
        mut saw := false
        while ar >= 0 {
            saw = true
            bf := b.stmts_flow(p, p.nodes[ar].c, fi, in_scc)
            if bf.may_exit {
                may_exit = true
            }
            if bf.may_ft {
                may_ft = true
            }
            ar = p.nodes[ar].next
        }
        if !saw {
            << RiskFlow{may_exit: false, may_ft: true}
        }
        << RiskFlow{may_exit: may_exit, may_ft: may_ft}
    }
    << RiskFlow{may_exit: false, may_ft: true}
}

fn (b &RiskBuf) expr_calls_scc(p &parser.Parser, n int, fi int, in_scc &[]int) bool {
    if n < 0 {
        << false
    }
    k := p.nodes[n].kind
    if k == ast.nk_call {
        j := b.resolve_callee(p, n, 0, fi)
        if j >= 0 && j < in_scc.len && in_scc[j] == 1 {
            << true
        }
        mut a := p.nodes[n].a
        while a >= 0 {
            if b.expr_calls_scc(p, a, fi, in_scc) {
                << true
            }
            a = p.nodes[a].next
        }
        << false
    }
    if k == ast.nk_method_call {
        j := b.resolve_callee(p, n, 1, fi)
        if j >= 0 && j < in_scc.len && in_scc[j] == 1 {
            << true
        }
    }
    if b.expr_calls_scc(p, p.nodes[n].a, fi, in_scc) {
        << true
    }
    if b.expr_calls_scc(p, p.nodes[n].b, fi, in_scc) {
        << true
    }
    if b.expr_calls_scc(p, p.nodes[n].c, fi, in_scc) {
        << true
    }
    << false
}

fn (b &RiskBuf) stmts_must_hop(p &parser.Parser, head int, fi int) int {
    mut s := head
    while s >= 0 {
        k := p.nodes[s].kind
        if k == ast.nk_return {
            g := b.expr_hop(p, p.nodes[s].a, fi)
            if g >= 0 {
                << g
            }
            << -1
        }
        if k == ast.nk_throw || k == ast.nk_exit {
            << -1
        }
        if k == ast.nk_expr_stmt {
            e := p.nodes[s].a
            if e >= 0 && p.nodes[e].kind == ast.nk_call && p.nodes[e].sval == "assert" {
                << -1
            }
            g := b.expr_hop(p, e, fi)
            if g >= 0 {
                << g
            }
        }
        if k == ast.nk_let {
            g := b.expr_hop(p, p.nodes[s].a, fi)
            if g >= 0 {
                << g
            }
        }
        if k == ast.nk_assign {
            g := b.expr_hop(p, p.nodes[s].b, fi)
            if g >= 0 {
                << g
            }
        }
        if k == ast.nk_if {
            g := b.if_must_hop(p, s, fi)
            if g >= 0 {
                << g
            }
        }
        s = p.nodes[s].next
    }
    << -1
}

fn (b &RiskBuf) if_must_hop(p &parser.Parser, n int, fi int) int {
    mut has_else := false
    mut hop := -1
    mut all := true
    mut saw := false
    mut br := p.nodes[n].a
    while br >= 0 {
        saw = true
        if p.nodes[br].a < 0 {
            has_else = true
        }
        g := b.stmts_must_hop(p, p.nodes[br].b, fi)
        if g < 0 {
            all = false
        } else {
            if hop < 0 {
                hop = g
            }
        }
        br = p.nodes[br].next
    }
    if !saw || !has_else || !all {
        << -1
    }
    << hop
}

fn (b &RiskBuf) expr_hop(p &parser.Parser, n int, fi int) int {
    if n < 0 {
        << -1
    }
    k := p.nodes[n].kind
    if k == ast.nk_call {
        j := b.resolve_callee(p, n, 0, fi)
        if j >= 0 && j < b.nfn && b.diverging[j] == 1 {
            << j
        }
        mut a := p.nodes[n].a
        while a >= 0 {
            g := b.expr_hop(p, a, fi)
            if g >= 0 {
                << g
            }
            a = p.nodes[a].next
        }
        << -1
    }
    if k == ast.nk_method_call {
        j := b.resolve_callee(p, n, 1, fi)
        if j >= 0 && j < b.nfn && b.diverging[j] == 1 {
            << j
        }
    }
    g0 := b.expr_hop(p, p.nodes[n].a, fi)
    if g0 >= 0 {
        << g0
    }
    g1 := b.expr_hop(p, p.nodes[n].b, fi)
    if g1 >= 0 {
        << g1
    }
    << b.expr_hop(p, p.nodes[n].c, fi)
}

fn (b &RiskBuf) cycle_path_msg(start int, cid int, comp &[]int, g_head &[]int, g_to &[]int, g_next &[]int) string {
    n := b.nfn
    mut stk := []int{}
    mut it := []int{}
    mut in_path := []int{}
    mut path := []int{}
    for i in 0:n {
        stk.push(0)
        it.push(0)
        in_path.push(0)
        path.push(0)
    }
    in_path[start] = 1
    mut path_n := 1
    path[0] = start
    mut sp := 1
    stk[0] = start
    it[0] = g_head[start]
    mut found := false
    while sp > 0 {
        if found {
            <-
        }
        top := sp - 1
        u := stk[top]
        mut e := it[top]
        mut advanced := false
        while e >= 0 {
            if found {
                <-
            }
            w := g_to[e]
            ne := g_next[e]
            if comp[w] == cid && w == start {
                found = true
                <-
            }
            if comp[w] == cid && in_path[w] == 0 {
                it[top] = ne
                in_path[w] = 1
                stk[sp] = w
                it[sp] = g_head[w]
                path[path_n] = w
                path_n = path_n + 1
                sp = sp + 1
                advanced = true
                <-
            }
            e = ne
        }
        if found {
            <-
        }
        if !advanced {
            in_path[u] = 0
            sp = top
            if path_n > 0 {
                path_n = path_n - 1
            }
        }
    }
    mut msg := b.fn_disp[start] + ""
    for k in 1:path_n {
        msg = msg + " -> " + b.fn_disp[path[k]]
    }
    msg = msg + " -> " + b.fn_disp[start]
    << msg
}

fn cycle_msg_tail(disp string, cm string) string {
    pre := disp + " -> "
    if cm.len < pre.len {
        << cm
    }
    mut i := 0
    mut ok := true
    while i < pre.len {
        if cm[i] != pre[i] {
            ok = false
        }
        i = i + 1
    }
    if ok {
        << cm[pre.len:]
    }
    << cm
}

fn (b &RiskBuf) format_call_path(start int, g_head &[]int, g_to &[]int, g_next &[]int) string {
    mut msg := b.fn_disp[start] + ""
    mut seen := []int{}
    for i in 0:b.nfn {
        seen.push(0)
    }
    seen[start] = 1
    mut cur := start
    mut step := 0
    while step < b.nfn + 2 {
        step = step + 1
        mut g := b.next_hop[cur]
        if g < 0 {
            mut e := g_head[cur]
            while e >= 0 {
                w := g_to[e]
                if w >= 0 && w < b.nfn && b.diverging[w] == 1 {
                    g = w
                    <-
                }
                e = g_next[e]
            }
        }
        if g < 0 {
            <-
        }
        msg = msg + " -> " + b.fn_disp[g]
        if seen[g] == 1 {
            <-
        }
        seen[g] = 1
        cur = g
        if b.in_cycle[cur] == 1 {
            cidx := b.cycle_of[cur]
            if cidx >= 0 && cidx < b.cycle_msg.len {
                tail := cycle_msg_tail(b.fn_disp[cur] + "", b.cycle_msg[cidx] + "")
                if tail.len > 0 {
                    msg = msg + " -> " + tail
                }
            }
            <-
        }
    }
    << msg
}

fn (b &mut RiskBuf) emit_lines(p &parser.Parser, g_head &[]int, g_to &[]int, g_next &[]int) {
    nl := b.loop_fn.len
    for i in 0:nl {
        fi := b.loop_fn[i]
        disp := b.fn_disp[fi] + ""
        fid := b.loop_fid[i]
        line := b.loop_line[i]
        col := b.loop_col[i]
        b.loops.push(risk_line(p, fid, line, col, "unbounded for/while with no break/return/exit in body; path: " + disp))
    }
    nc := b.cycle_start.len
    for i in 0:nc {
        st := b.cycle_start[i]
        d := b.fn_decl[st]
        fid := b.fn_file[st]
        line := p.nodes[d].line
        col := p.nodes[d].col
        msg := b.cycle_msg[i] + ""
        b.loops.push(risk_line(p, fid, line, col, "unbounded call cycle: " + msg))
    }
    nf := b.nfn
    for i in 0:nf {
        if b.diverging[i] == 0 {
            ->
        }
        if b.local_loop[i] == 1 {
            ->
        }
        if b.in_cycle[i] == 1 {
            ->
        }
        d := b.fn_decl[i]
        fid := b.fn_file[i]
        line := p.nodes[d].line
        col := p.nodes[d].col
        chain := b.format_call_path(i, g_head, g_to, g_next)
        b.loops.push(risk_line(p, fid, line, col, "unbounded call path: " + chain))
    }
}

fn risk_dfs_finish(n int, g_head &[]int, g_to &[]int, g_next &[]int, order &mut []int) int {
    mut visited := []int{}
    mut stk := []int{}
    mut it := []int{}
    mut on := 0
    for i in 0:n {
        visited.push(0)
        stk.push(0)
        it.push(0)
    }
    for s in 0:n {
        if visited[s] == 1 {
            ->
        }
        visited[s] = 1
        mut sp := 1
        stk[0] = s
        it[0] = g_head[s]
        while sp > 0 {
            top := sp - 1
            u := stk[top]
            e := it[top]
            if e >= 0 {
                it[top] = g_next[e]
                w := g_to[e]
                if visited[w] == 0 {
                    visited[w] = 1
                    stk[sp] = w
                    it[sp] = g_head[w]
                    sp = sp + 1
                }
            } else {
                order[on] = u
                on = on + 1
                sp = top
            }
        }
    }
    << on
}

fn risk_dfs_scc(n int, on int, order &[]int, gt_head &[]int, gt_to &[]int, gt_next &[]int, comp &mut []int) int {
    mut stk := []int{}
    for i in 0:n {
        stk.push(0)
    }
    mut ncomp := 0
    for oi in 0:on {
        r := order[on - 1 - oi]
        if comp[r] >= 0 {
            ->
        }
        comp[r] = ncomp
        mut sp := 1
        stk[0] = r
        while sp > 0 {
            top := sp - 1
            u := stk[top]
            sp = top
            mut e := gt_head[u]
            while e >= 0 {
                w := gt_to[e]
                if comp[w] < 0 {
                    comp[w] = ncomp
                    stk[sp] = w
                    sp = sp + 1
                }
                e = gt_next[e]
            }
        }
        ncomp = ncomp + 1
    }
    << ncomp
}

fn is_const_true_expr(p &parser.Parser, n int) bool {
    if n < 0 {
        << false
    }
    k := p.nodes[n].kind
    if k == ast.nk_bool {
        << p.nodes[n].ival != 0
    }
    if k == ast.nk_int {
        << p.nodes[n].ival != 0
    }
    << false
}

fn stmt_list_has_terminator(p &parser.Parser, head int, break_depth int) bool {
    mut s := head
    while s >= 0 {
        if stmt_has_terminator(p, s, break_depth) {
            << true
        }
        s = p.nodes[s].next
    }
    << false
}

fn stmt_has_terminator(p &parser.Parser, n int, break_depth int) bool {
    k := p.nodes[n].kind
    if k == ast.nk_break && break_depth == 0 {
        << true
    }
    if k == ast.nk_return || k == ast.nk_throw || k == ast.nk_exit {
        << true
    }
    if k == ast.nk_expr_stmt {
        e := p.nodes[n].a
        if e >= 0 && p.nodes[e].kind == ast.nk_call && p.nodes[e].sval == "assert" {
            << true
        }
    }
    if k == ast.nk_if {
        mut br := p.nodes[n].a
        while br >= 0 {
            if stmt_list_has_terminator(p, p.nodes[br].b, break_depth) {
                << true
            }
            br = p.nodes[br].next
        }
        << false
    }
    if k == ast.nk_while || k == ast.nk_for || k == ast.nk_for_each {
        << stmt_list_has_terminator(p, p.nodes[n].c, break_depth + 1)
    }
    << false
}
