@xu/types

// Bounded read-only frame traffic must not block independent integer locals.
// Records stay in their original parameter homes; only eligible scalar locals
// enter SSA. No memory operation is removed or moved by this admission proof.
// Calls, writes, ownership, aggregates in temps and unknown pointers retain
// their established fallback. The full SSA verifier still guards each commit.
fn mir_promote_record_temp(ty int) bool {
    << ty == 1 || ty == 2 || (ty > 1000 && ty < 2000)
}

fn mir_promote_record_kind(k int, op int) bool {
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 16 || k == 17 { << true }
    if k == 4 { << (op >= 1 && op <= 3) || (op >= 6 && op <= 11) || (op >= 14 && op <= 16) }
    << k == 5 && op >= 1 && op <= 2
}

fn mir_promote_record_int_cfg_f(f &MFn) bool {
    nb := f.blocks.len
    nl := f.locals.len
    nt := f.temps.len
    ni := f.instrs.len
    np := f.nparams
    if nb <= 0 || nb > 64 || nl > 48 || nt > 512 || ni > 1024 { << false }
    if np < 0 || np > 6 || np > nl || (f.ret != 1 && f.ret != 2) || f.ret_nslots != 1 { << false }
    if f.locals_nslots.len != nl || f.locals_owning.len != nl || f.temps_nslots.len != nt { << false }
    mut record := false
    for l in 0:nl {
        ty := f.locals[l]
        ns := f.locals_nslots[l]
        if f.locals_owning[l] { << false }
        if is_struct_type(ty) {
            if l >= np || ns <= 0 || ns > 64 { << false }
            record = true
        } else if (ty != 1 && ty != 2) || ns != 1 { << false }
    }
    if !record { << false }
    for t in 0:nt {
        if !mir_promote_record_temp(f.temps[t]) || f.temps_nslots[t] != 1 { << false }
    }
    // -1 is unseen, -2 is an unknown or multiply-defined value. A field load
    // must use one direct AddrLocal definition, never a copied/rebound pointer.
    mut bases := []int{}
    for _ in 0:nt { bases.push(-1) }
    for bi in 0:nb {
        tk := f.blocks[bi].tkind
        if tk == 0 {
            if f.blocks[bi].head >= 0 { << false }
        } else if tk == 1 {
            to := f.blocks[bi].ta
            if to < 0 || to >= nb { << false }
        } else if tk == 2 {
            yes := f.blocks[bi].tb
            no := f.blocks[bi].tc
            if yes < 0 || yes >= nb || no < 0 || no >= nb { << false }
        } else if tk != 3 { << false }
        mut ii := f.blocks[bi].head
        for _ in 0:ni + 1 {
            if ii < 0 { <- }
            if ii >= ni { << false }
            k := mfn_ikind(&f.instrs, ii)
            a := mfn_ia(&f.instrs, ii)
            b := mfn_ib(&f.instrs, ii)
            if !mir_promote_record_kind(k, b) { << false }
            if k == 2 || k == 3 {
                mut loc := b
                if k == 3 { loc = a }
                if loc < 0 || loc >= nl { << false }
                if f.locals[loc] != 1 && f.locals[loc] != 2 { << false }
            }
            if k == 16 {
                if a < 0 || a >= nt { << false }
                if mfn_ic(&f.instrs, ii) != 0 || b < 0 || b >= nl { << false }
                if f.temps[a] != 1 && f.temps[a] != 1000 + f.locals[b] { << false }
                if is_struct_type(f.locals[b]) && f.temps[a] != 1000 + f.locals[b] { << false }
            }
            if k != 0 && k != 3 {
                if a < 0 || a >= nt { << false }
                if k != 16 && (f.temps[a] != 1 && f.temps[a] != 2) { << false }
                mut origin := -2
                if k == 16 && mfn_get_i(&bases, a) == -1 { origin = b }
                mfn_set_i(mut &bases, a, origin)
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        if ii >= 0 { << false }
    }
    for bi in 0:nb {
        mut ii := f.blocks[bi].head
        for _ in 0:ni {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == 17 {
                b := mfn_ib(&f.instrs, ii)
                off := mfn_ic(&f.instrs, ii)
                if b < 0 || b >= nt || off < 0 || off % 8 != 0 || mfn_id(&f.instrs, ii) != 1 { << false }
                loc := mfn_get_i(&bases, b)
                if loc < 0 || loc >= nl || off / 8 >= f.locals_nslots[loc] { << false }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << true
}

fn mir_promote_record_int_cfg_m(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len || mir_fn_is_extern(m, fi) { << false }
    nb := mir_nblocks(m, fi)
    nl := mir_nlocals(m, fi)
    nt := mir_ntemps(m, fi)
    ni := mir_nins(m, fi)
    np := mir_fn_nparams(m, fi)
    if nb <= 0 || nb > 64 || nl > 48 || nt > 512 || ni > 1024 { << false }
    if np < 0 || np > 6 || np > nl || (mir_fn_ret(m, fi) != 1 && mir_fn_ret(m, fi) != 2) || mir_fn_ret_nslots(m, fi) != 1 { << false }
    if m.fns[fi].locals_nslots.len != nl || m.fns[fi].locals_owning.len != nl || m.fns[fi].temps_nslots.len != nt { << false }
    mut record := false
    for l in 0:nl {
        ty := mir_local_ty(m, fi, l)
        ns := mir_local_nslots(m, fi, l)
        if m.fns[fi].locals_owning[l] { << false }
        if is_struct_type(ty) {
            if l >= np || ns <= 0 || ns > 64 { << false }
            si := struct_index(ty)
            if si < 0 || si >= m.structs.len { << false }
            if m.structs[si].nslots != ns || m.structs[si].fields.len > 64 || m.structs[si].drop_label.len != 0 { << false }
            for j in 0:m.structs[si].fields.len {
                ft := m.structs[si].fields[j].ty
                if ft != 1 && ft != 2 { << false }
            }
            record = true
        } else if (ty != 1 && ty != 2) || ns != 1 { << false }
    }
    if !record { << false }
    for t in 0:nt {
        if !mir_promote_record_temp(mir_temp_ty(m, fi, t)) || mir_temp_nslots(m, fi, t) != 1 { << false }
    }
    // -1 is unseen, -2 is an unknown or multiply-defined value. A field load
    // must use one direct AddrLocal definition, never a copied/rebound pointer.
    mut bases := []int{}
    for _ in 0:nt { bases.push(-1) }
    for bi in 0:nb {
        tk := mir_btkind(m, fi, bi)
        if tk == 0 {
            if mir_bhead(m, fi, bi) >= 0 { << false }
        } else if tk == 1 {
            to := mir_bta(m, fi, bi)
            if to < 0 || to >= nb { << false }
        } else if tk == 2 {
            yes := mir_btb(m, fi, bi)
            no := mir_btc(m, fi, bi)
            if yes < 0 || yes >= nb || no < 0 || no >= nb { << false }
        } else if tk != 3 { << false }
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:ni + 1 {
            if ii < 0 { <- }
            if ii >= ni { << false }
            k := mir_ikind(m, fi, ii)
            a := mir_ia(m, fi, ii)
            b := mir_ib(m, fi, ii)
            if !mir_promote_record_kind(k, b) { << false }
            if k == 2 || k == 3 {
                mut loc := b
                if k == 3 { loc = a }
                if loc < 0 || loc >= nl { << false }
                if mir_local_ty(m, fi, loc) != 1 && mir_local_ty(m, fi, loc) != 2 { << false }
            }
            if k == 16 {
                if a < 0 || a >= nt { << false }
                if mir_ic(m, fi, ii) != 0 || b < 0 || b >= nl { << false }
                if mir_temp_ty(m, fi, a) != 1 && mir_temp_ty(m, fi, a) != 1000 + mir_local_ty(m, fi, b) { << false }
                if is_struct_type(mir_local_ty(m, fi, b)) && mir_temp_ty(m, fi, a) != 1000 + mir_local_ty(m, fi, b) { << false }
            }
            if k != 0 && k != 3 {
                if a < 0 || a >= nt { << false }
                if k != 16 && (mir_temp_ty(m, fi, a) != 1 && mir_temp_ty(m, fi, a) != 2) { << false }
                mut origin := -2
                if k == 16 && mfn_get_i(&bases, a) == -1 { origin = b }
                mfn_set_i(mut &bases, a, origin)
            }
            ii = mir_inext(m, fi, ii)
        }
        if ii >= 0 { << false }
    }
    for bi in 0:nb {
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:ni {
            if ii < 0 { <- }
            if mir_ikind(m, fi, ii) == 17 {
                b := mir_ib(m, fi, ii)
                off := mir_ic(m, fi, ii)
                if b < 0 || b >= nt || off < 0 || off % 8 != 0 || mir_id(m, fi, ii) != 1 { << false }
                loc := mfn_get_i(&bases, b)
                if loc < 0 || loc >= nl || off / 8 >= mir_local_nslots(m, fi, loc) { << false }
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    << mir_verify_emission_calls(m, fi)
}
