@xu/types

// Compiler-only StrMap policies. Capacities stay powers of two; the load
// fraction is numerator/denominator. Hash parameters keep probe order stable
// across targets; slot-state values are independent of integer map values.
const strmap_initial_capacity = 16
const strmap_max_capacity = 1048576
const strmap_growth_factor = 2
const strmap_load_numerator = 3
const strmap_load_denominator = 4
const strmap_hash_seed = 5381
const strmap_hash_shift = 5
const strmap_hash_mask = 2147483647
const strmap_bucket_mix_shift = 16
const strmap_bucket_mix_multiplier = 73244475
const strmap_byte_mask = 255
const strmap_slot_empty = 0
const strmap_slot_used = 1

// M189: open-addressing string → int map (compiler-internal; not a language map type).

pub struct StrMap {
    pub keys []string
    pub vals []int
    pub used []int
    pub n int
    pub cap int
}

fn empty_strmap() StrMap {
    << StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0}
}

// `s + ""` is a descriptor alias on the hosted Gen1 ABI. Map keys and the
// checker string pool outlive the temporary that produced them, so every
// stored key must own its own bytes. A dangling alias is what made distinct
// literals (database_sql "FROM") resolve to strings[0].
fn str_owned_copy(s &string) string {
    if s.len <= 0 {
        << ""
    }
    mut bytes := []int{}
    for i in 0:s.len {
        bytes.push(s[i] & strmap_byte_mask)
    }
    << string_from_bytes(bytes)
}

// Zero in place — avoids relying on empty_strmap() sret into Checker fields
// (WoA x64 can leave garbage cap/n on untouched maps like fn_map).
fn zero_strmap(m &mut StrMap) {
    m.keys = []string{}
    m.vals = []int{}
    m.used = []int{}
    m.n = 0
    m.cap = 0
}

fn strmap_sane(m &StrMap) bool {
    // cap==0: lazy empty shell (OK but not a live table).
    if m.cap <= 0 {
        << false
    }
    // Corrupt descriptors look like huge positive caps after bad sret.
    if m.cap > strmap_max_capacity {
        << false
    }
    if m.n < 0 || m.n > m.cap {
        << false
    }
    if m.keys.len < m.cap || m.vals.len < m.cap || m.used.len < m.cap {
        << false
    }
    << true
}

pub fn new_strmap() StrMap {
    << strmap_with_cap(strmap_initial_capacity)
}

fn strmap_with_cap(cap int) StrMap {
    mut ncap := cap
    if ncap < strmap_initial_capacity {
        ncap = strmap_initial_capacity
    }
    mut m := StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: ncap}
    for i in 0:ncap {
        m.keys.push("")
        m.vals.push(0)
        m.used.push(strmap_slot_empty)
    }
    << m
}

fn strmap_hash(s &string) int {
    mut h := strmap_hash_seed
    for i in 0:s.len {
        h = ((h << strmap_hash_shift) + h) + (s[i] & strmap_byte_mask)
        h = h & strmap_hash_mask
    }
    << h
}

// Compiler symbols share long common prefixes and numeric suffixes. Raw djb2
// low bits cluster badly in power-of-two tables. Mix the bucket selector to
// keep probe chains short and deterministic on every backend.
fn strmap_bucket(h int, cap int) int {
    if cap <= 0 {
        << 0
    }
    mut mixed := ((h ^ (h >> strmap_bucket_mix_shift)) * strmap_bucket_mix_multiplier) & strmap_hash_mask
    mixed = ((mixed ^ (mixed >> strmap_bucket_mix_shift)) * strmap_bucket_mix_multiplier) & strmap_hash_mask
    << (mixed ^ (mixed >> strmap_bucket_mix_shift)) % cap
}

fn (m &mut StrMap) init_empty(ncap int) {
    m.keys = []string{}
    m.vals = []int{}
    m.used = []int{}
    m.n = 0
    m.cap = ncap
    for i in 0:ncap {
        m.keys.push("")
        m.vals.push(0)
        m.used.push(strmap_slot_empty)
    }
}

// Free-fn form: field receivers like `c.fn_map.get` cannot take &StrMap
// (Xu requires a variable). Prefer strmap_get(&c.fn_map, &k).
fn strmap_find_ref(m &StrMap, h int, k &string) int {
    if m.cap <= 0 {
        << -1
    }
    mut i := strmap_bucket(h, m.cap)
    start := i
    while true {
        if m.used[i] == strmap_slot_empty {
            << -1
        }
        eq := strmap_key_equal(&m.keys[i], k)
        if m.used[i] == strmap_slot_used && eq {
            << i
        }
        i = (i + 1) % m.cap
        if i == start {
            << -1
        }
    }
    << -1
}

fn strmap_get(m &StrMap, k &string) int {
    if m.n <= 0 {
        << -1
    }
    if !strmap_sane(m) {
        << -1
    }
    h := strmap_hash(k)
    slot := strmap_find_ref(m, h, k)
    if slot < 0 {
        << -1
    }
    << m.vals[slot]
}

// Free-function form for mutable fields. Xu can pass `mut &c.fn_map` to a
// function, while a mutating method receiver requires a local variable.
// Keeping this adapter here avoids one identical wrapper per Checker map.
fn strmap_put(m &mut StrMap, k string, v int) {
    m.put(k, v)
}

// Local-variable receivers (e.g. loaded_map) may use methods.
fn (m &StrMap) find_ref(h int, k &string) int {
    << strmap_find_ref(m, h, k)
}

fn (m &StrMap) get(k &string) int {
    << strmap_get(m, k)
}

pub fn (m &StrMap) lookup(k &string) int {
    << strmap_get(m, k)
}

fn (m &mut StrMap) find_insert(h int, k string) int {
    << strmap_find_insert(&*m, h, &k)
}

fn (m &mut StrMap) insert_at(slot int, k string, v int) {
    if m.used[slot] == strmap_slot_used {
        m.vals[slot] = v
        <<
    }
    m.keys[slot] = k
    m.vals[slot] = v
    m.used[slot] = strmap_slot_used
    m.n += 1
}

fn (m &mut StrMap) grow() {
    old_cap := m.cap
    if old_cap <= 0 {
        m.init_empty(strmap_initial_capacity)
        <<
    }
    ncap := old_cap * strmap_growth_factor
    if ncap <= 0 {
        <<
    }
    mut new_keys := []string{}
    mut new_vals := []int{}
    mut new_used := []int{}
    for i in 0:ncap {
        new_keys.push("")
        new_vals.push(0)
        new_used.push(strmap_slot_empty)
    }
    mut new_n := 0
    for i in 0:old_cap {
        if m.used[i] == strmap_slot_used {
            key := str_owned_copy(&m.keys[i])
            h := strmap_hash(&key)
            mut j := strmap_bucket(h, ncap)
            start := j
            while true {
                if new_used[j] == strmap_slot_empty {
                    new_keys[j] = key
                    new_vals[j] = m.vals[i]
                    new_used[j] = strmap_slot_used
                    new_n += 1
                    <-
                }
                j = (j + 1) % ncap
                if j == start {
                    <-
                }
            }
        }
    }
    m.keys = new_keys
    m.vals = new_vals
    m.used = new_used
    m.cap = ncap
    m.n = new_n
}

pub fn (m &mut StrMap) put(k string, v int) {
    mut bad := m.cap <= 0
    if !bad {
        if m.cap > strmap_max_capacity {
            bad = true
        }
        if m.n < 0 || m.n > m.cap {
            bad = true
        }
        if m.keys.len < m.cap || m.vals.len < m.cap || m.used.len < m.cap {
            bad = true
        }
    }
    if bad {
        // Never inited, or sret left garbage — start clean.
        m.init_empty(strmap_initial_capacity)
    }
    if m.n * strmap_load_denominator >= m.cap * strmap_load_numerator {
        m.grow()
    }
    mut h := strmap_hash(&k)
    mut slot := strmap_find_insert(&*m, h, &k)
    if slot < 0 {
        m.grow()
        h = strmap_hash(&k)
        slot = strmap_find_insert(&*m, h, &k)
    }
    if slot < 0 {
        <<
    }
    owned := str_owned_copy(&k)
    if m.used[slot] == strmap_slot_used {
        // Same bytes: refresh the id. A probe that only looked equal because
        // its key alias had been reused must not steal this literal's id.
        if strmap_key_equal(&m.keys[slot], &owned) {
            m.vals[slot] = v
        }
        <<
    }
    m.insert_at(slot, owned, v)
}

// Borrow exact key bytes; no owning descriptor may escape this query.
fn strmap_key_equal(a &string, b &string) bool {
    if a.len != b.len { << false }
    for j in 0:b.len {
        if (a[j] & strmap_byte_mask) != (b[j] & strmap_byte_mask) { << false }
    }
    << true
}

fn strmap_find_insert(m &StrMap, h int, k &string) int {
    if m.cap <= 0 { << -1 }
    mut i := strmap_bucket(h, m.cap)
    start := i
    mut first_empty := -1
    while true {
        if m.used[i] == strmap_slot_empty {
            if first_empty < 0 { first_empty = i }
            << first_empty
        }
        if m.used[i] == strmap_slot_used && strmap_key_equal(&m.keys[i], k) { << i }
        i = (i + 1) % m.cap
        if i == start {
            if first_empty >= 0 { << first_empty }
            << -1
        }
    }
    << -1
}
