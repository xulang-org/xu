@xu/types

fn (f &MFn) local_dse_ok(loc int) bool {
    if loc < 0 || loc >= f.locals.len { << false }
    if loc < f.locals_owning.len && f.locals_owning[loc] { << false }
    ty := f.locals[loc]
    if is_integer_type(ty) { << true }
    if ty == 2 { << true }
    << false
}

fn mir_local_dse_ok(f &MFn, loc int) bool {
    << f.local_dse_ok(loc)
}

fn mir_dse(f $&MFn) bool {
    // Slice headers stay in the small per-block frame. Gen1 clobbers
    // local []int headers inside the old combined scan function.
    nb := f.blocks.len
    nloc := f.locals.len
    if nb == 0 || nloc == 0 { << false }
    $can_inter := false
    if nb > 1 && nb * nloc <= 65536 {
        can_inter = true
    }
    $out_on := []bool{}
    $out_v := []int{}
    $out_valid := []bool{}
    if can_inter {
        total := nb * nloc
        for _ in 0:total {
            out_on.push(false)
            out_v.push(0)
        }
        for _ in 0:nb {
            out_valid.push(false)
        }
    }
    $changed := false
    for bi in 0:nb {
        if f.is_self_loop(bi) { -> }
        $last := []int{}
        $held_on := []bool{}
        $held_v := []int{}
        for _ in 0:nloc {
            last.push(-1)
            held_on.push(false)
            held_v.push(0)
        }
        if can_inter && bi > 0 {
            pred := f.strict_forward_pred(bi)
            if pred >= 0 && out_valid[pred] {
                pbase := pred * nloc
                for l in 0:nloc {
                    if out_on[pbase + l] {
                        mfn_set_b($&held_on, l, true)
                        mfn_set_i($&held_v, l, out_v[pbase + l])
                    }
                }
            }
        }
        $kill := []int{}
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := f.instrs[ii].next
            mir_dse_step(&*f, ii, $&last, $&held_on, $&held_v, $&kill)
            ii = nxt
        }
        for ki in 0:kill.len {
            mir_delete_instr(f, bi, kill[ki])
            changed = true
        }
        if can_inter {
            base := bi * nloc
            for l in 0:nloc {
                mfn_set_b($&out_on, base + l, held_on[l])
                mfn_set_i($&out_v, base + l, held_v[l])
            }
            mfn_set_b($&out_valid, bi, true)
        }
    }
    << changed
}

fn mir_dse_kill_loc(last $&[]int, held_on $&[]bool, loc int) {
    if loc < 0 || loc >= last.len { << }
    mfn_set_i(last, loc, 0 - 1)
    mfn_set_b(held_on, loc, false)
}

fn mir_dse_kill_all(last $&[]int, held_on $&[]bool) {
    n := last.len
    for i in 0:n {
        mfn_set_i(last, i, 0 - 1)
        mfn_set_b(held_on, i, false)
    }
}

fn mir_dse_on_load(last $&[]int, held_on $&[]bool, held_v $&[]int, loc int, dest int) {
    if loc < 0 || loc >= last.len { << }
    mfn_set_i(last, loc, 0 - 1)
    mfn_set_b(held_on, loc, true)
    mfn_set_i(held_v, loc, dest)
}

fn mir_dse_on_store(f &MFn, last $&[]int, held_on $&[]bool, held_v $&[]int, kill $&[]int, ii int, loc int, src int) {
    nloc := last.len
    if loc < 0 || loc >= nloc { << }
    if f.local_dse_ok(loc) {
        if held_on[loc] && held_v[loc] == src {
            kill.push(ii)
            <<
        }
        prev := last[loc]
        if prev >= 0 { kill.push(prev) }
        mfn_set_i(last, loc, ii)
        mfn_set_b(held_on, loc, true)
        mfn_set_i(held_v, loc, src)
        <<
    }
    mir_dse_kill_loc(last, held_on, loc)
}

fn mir_dse_step(f &MFn, ii int, last $&[]int, held_on $&[]bool, held_v $&[]int, kill $&[]int) {
    k := f.instrs[ii].kind
    if k == 2 {
        mir_dse_on_load(last, held_on, held_v, f.instrs[ii].b, f.instrs[ii].a)
        <<
    }
    if k == 3 {
        mir_dse_on_store(f, last, held_on, held_v, kill, ii, f.instrs[ii].a, f.instrs[ii].b)
        <<
    }
    if k == 8 {
        mir_dse_kill_loc(last, held_on, f.instrs[ii].a)
        <<
    }
    if k == 16 && f.instrs[ii].c == 0 {
        mir_dse_kill_loc(last, held_on, f.instrs[ii].b)
        <<
    }
    if k == 7 || (k >= 30 && k <= 37) || k == 14 || k == 17 || k == 18 || k == 20 || k == 23 || k == 47 || k == 48 {
        mir_dse_kill_all(last, held_on)
    }
}

fn mir_dse_unread_locals(f $&MFn) bool {
    nloc := f.locals.len
    $seen := []bool{}
    for _ in 0:nloc {
        seen.push(false)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            for loc in 0:nloc {
                if f.instr_observes_local(ii, loc) {
                    seen[loc] = true
                }
            }
            ii = f.instrs[ii].next
        }
    }
    $changed := false
    for bi in 0:f.blocks.len {
        $kill := []int{}
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := f.instrs[ii].next
            if f.instrs[ii].kind == MI_STORE_LOCAL {
                loc := f.instrs[ii].a
                if loc >= 0 && loc < nloc && f.local_dse_ok(loc) && !seen[loc] {
                    kill.push(ii)
                }
            }
            ii = nxt
        }
        for ki in 0:kill.len {
            mir_delete_instr(f, bi, kill[ki])
            changed = true
        }
    }
    << changed
}

// Enumerate the same operands as instr_uses_temp without testing every TempId.
// delta=0 marks liveness; +/-1 maintains occurrence counts. Repeated operands
// are counted consistently in the whole-function and current-block tables.
fn mir_dce_use_value(uses $&[]int, value int, delta int) {
    if value < 0 || value >= uses.len { << }
    if delta == 0 {
        mfn_set_i(uses, value, 1)
    } else {
        mfn_set_i(uses, value, uses[value] + delta)
    }
}

fn mir_dce_use_all(uses $&[]int, delta int) {
    for t in 0:uses.len { mir_dce_use_value(uses, t, delta) }
}

fn mir_dce_instr_uses(f &MFn, ii int, uses $&[]int, delta int) {
    if ii < 0 || ii >= f.instrs.len { mir_dce_use_all(uses, delta)
        << }
    k := mfn_ikind(&f.instrs, ii)
    a := mfn_ia(&f.instrs, ii)
    b := mfn_ib(&f.instrs, ii)
    c := mfn_ic(&f.instrs, ii)
    d := mfn_id(&f.instrs, ii)
    schema := mir_instr_use_schema(k, c)
    mask := mir_instr_use_mask(schema)
    if mask < 0 { mir_dce_use_all(uses, delta)
        << }
    if (mask & 1) != 0 { mir_dce_use_value(uses, a, delta) }
    if (mask & 2) != 0 { mir_dce_use_value(uses, b, delta) }
    if (mask & 4) != 0 { mir_dce_use_value(uses, c, delta) }
    if (mask & 8) != 0 { mir_dce_use_value(uses, d, delta) }
    $ap := mir_instr_use_arg_head(schema, b, c, d)
    $limit := MIR_VERIFY_MAX_ARG_CHAIN
    if f.margs.len < limit { limit = f.margs.len }
    for _ in 0:limit {
        if ap == -1 { << }
        if ap < 0 || ap >= f.margs.len { mir_dce_use_all(uses, delta)
            << }
        mir_dce_use_value(uses, f.margs[ap].v, delta)
        ap = f.margs[ap].next
    }
    if ap != -1 { mir_dce_use_all(uses, delta) }
}

fn mir_dce_block_uses(f &MFn, bi int, uses $&[]int) {
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        mir_dce_instr_uses(f, ii, uses, 1)
        ii = mfn_inext(&f.instrs, ii)
    }
    tk := f.blocks[bi].tkind
    if tk == 2 || tk == 3 { mir_dce_use_value(uses, f.blocks[bi].ta, 1) }
}

fn mir_dce_pure(f $&MFn) bool {
    $changed := false
    nt := f.temps.len
    for _ in 0:16 {
        // Keep exact occurrence counts and remove killed instruction uses
        // immediately. Later blocks see the same current MIR as the original
        // temp_used_outside scan, including repeated definitions and operands.
        $all_uses := []int{}
        for _t in 0:nt { all_uses.push(0) }
        for bi in 0:f.blocks.len { mir_dce_block_uses(&*f, bi, $&all_uses) }
        $round := false
        for bi in 0:f.blocks.len {
            $ids := []int{}
            $ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                ids.push(ii)
                ii = f.instrs[ii].next
            }
            $block_uses := []int{}
            for _t in 0:nt { block_uses.push(0) }
            mir_dce_block_uses(&*f, bi, $&block_uses)
            $live := []int{}
            for _t in 0:nt {
                live.push(0)
            }
            tk := f.blocks[bi].tkind
            if tk == 2 || tk == 3 {
                ta := f.blocks[bi].ta
                if ta >= 0 && ta < nt {
                    live[ta] = 1
                }
            }
            for t in 0:nt {
                if live[t] != 0 {
                    ->
                }
                if all_uses[t] > block_uses[t] {
                    live[t] = 1
                }
            }
            $kill := []int{}
            $k := ids.len - 1
            while k >= 0 {
                ii = ids[k]
                $dest := f.pure_int_dest(ii)
                if dest < 0 && f.instrs[ii].kind == MI_COPY {
                    a := f.instrs[ii].a
                    if a >= 0 && a < nt {
                        if a < f.temps_nslots.len && f.temps_nslots[a] == 1 {
                            dest = a
                        }
                    }
                }
                $id_copy := false
                if f.instrs[ii].kind == MI_COPY && f.instrs[ii].a >= 0 && f.instrs[ii].a == f.instrs[ii].b {
                    id_copy = true
                }
                $dead := false
                if dest >= 0 {
                    dest_live := dest < nt && live[dest] != 0
                    if !dest_live || id_copy {
                        dead = true
                    }
                }
                if dead {
                    kill.push(ii)
                    k -= 1
                    ->
                }
                if dest >= 0 && dest < nt {
                    live[dest] = 0
                }
                mir_dce_instr_uses(&*f, ii, $&live, 0)
                k -= 1
            }
            for ki in 0:kill.len {
                mir_dce_instr_uses(&*f, kill[ki], $&all_uses, -1)
                mir_delete_instr(f, bi, kill[ki])
                round = true
            }
        }
        if !round {
            <-
        }
        changed = true
    }
    << changed
}

fn mir_zap_unreachable(f $&MFn) bool {
    n := f.blocks.len
    if n == 0 { << false }
    $seen := []bool{}
    for _ in 0:n { seen.push(false) }
    seen[0] = true
    for _ in 0:n {
        for bi in 0:n {
            if !seen[bi] { -> }
            tk := f.blocks[bi].tkind
            if tk == 1 {
                to := f.blocks[bi].ta
                if to >= 0 && to < n { seen[to] = true }
            } else if tk == 2 {
                t := f.blocks[bi].tb
                e := f.blocks[bi].tc
                if t >= 0 && t < n { seen[t] = true }
                if e >= 0 && e < n { seen[e] = true }
            }
        }
    }
    $changed := false
    for i in 1:n {
        if seen[i] { -> }
        if f.blocks[i].tkind == 0 && f.blocks[i].head == -1 && f.blocks[i].tail == -1 { -> }
        // Only this CFG-proven unreachable chain is retired. Live effects
        // and pre-existing executable orphans are not a cleanup target.
        $ii := f.blocks[i].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            next := mfn_inext(&f.instrs, ii)
            mir_delete_instr(f, i, ii)
            ii = next
        }
        $b := f.blocks[i]
        b.head = -1
        b.tail = -1
        b.tkind = 0
        b.ta = -1
        b.tb = -1
        b.tc = -1
        mfn_set_block($&f.blocks, i, b)
        changed = true
    }
    << changed
}

fn mir_replace_temp_operands(f $&MFn, ii int, from int, to int) {
    k := mfn_ikind(&f.instrs, ii)
    if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_STR_CLONE {
        if mfn_ib(&f.instrs, ii) == from {
            mfn_set_ib($&f.instrs, ii, to)
        }
    }
    if k == MI_BIN {
        if mfn_ic(&f.instrs, ii) == from {
            mfn_set_ic($&f.instrs, ii, to)
        }
        if mfn_id(&f.instrs, ii) == from {
            mfn_set_id($&f.instrs, ii, to)
        }
    }
    if k == MI_UN {
        if mfn_ic(&f.instrs, ii) == from {
            mfn_set_ic($&f.instrs, ii, to)
        }
    }
    if k == MI_ARR_PUSH || k == MI_ARR_PUSH4 {
        if mfn_ia(&f.instrs, ii) == from { mfn_set_ia($&f.instrs, ii, to) }
        if k == MI_ARR_PUSH {
            if mfn_ib(&f.instrs, ii) == from { mfn_set_ib($&f.instrs, ii, to) }
        } else {
            $ap := mfn_ib(&f.instrs, ii)
            for _ in 0:f.margs.len {
                if ap < 0 || ap >= f.margs.len { <- }
                if f.margs[ap].v == from {
                    nxt := f.margs[ap].next
                    mfn_set_marg($&f.margs, ap, MArg{v: to, next: nxt})
                }
                ap = f.margs[ap].next
            }
        }
    }
    if k == MI_FIELD_RMW {
        if mfn_ia(&f.instrs, ii) == from {
            mfn_set_ia($&f.instrs, ii, to)
        }
        if mfn_ic(&f.instrs, ii) == from {
            mfn_set_ic($&f.instrs, ii, to)
        }
    }
}

// Promotion/Phi-elim insert f64 Copies (`t2c = t2`) that copy-prop's
// FieldRMW kill_all leaves in the latch. Forward operands then drop the
// Copy so emit sees `mul; mul; FieldRMW` (nbody `dx*mj*mag`).
fn mir_fill_frmw_ptr(f &MFn, mark $&[]bool) {
    n := mark.len
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_FIELD_RMW {
                a := mfn_ia(&f.instrs, ii)
                if a >= 0 && a < n {
                    mfn_set_b(mark, a, true)
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
}

fn mir_copy_fwd_ok(f &MFn, d int, s int, mark &[]bool) bool {
    if d < 0 || s < 0 { << false }
    if d >= f.temps.len || s >= f.temps.len { << false }
    if d == s { << false }
    $ns := 1
    if d < f.temps_nslots.len {
        ns = f.temps_nslots[d]
    }
    if ns != 1 { << false }
    if f.temps[d] == 4 && f.temps[s] == 4 { << true }
    if d < mark.len && mark[d] { << true }
    if s < mark.len && mark[s] { << true }
    << false
}

fn mir_forward_f64_copies(f $&MFn) bool {
    $changed := false
    nt := f.temps.len
    $mark := []bool{}
    for _ in 0:nt {
        mark.push(false)
    }
    for _round in 0:8 {
        $round := false
        for i in 0:nt {
            mfn_set_b($&mark, i, false)
        }
        mir_fill_frmw_ptr(&*f, $&mark)
        for bi in 0:f.blocks.len {
            $kill := []int{}
            $ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                nxt := mfn_inext(&f.instrs, ii)
                if mfn_ikind(&f.instrs, ii) == MI_COPY {
                    d := mfn_ia(&f.instrs, ii)
                    s := mfn_ib(&f.instrs, ii)
                    if mir_copy_fwd_ok(&*f, d, s, &mark) {
                        for bi2 in 0:f.blocks.len {
                            $jj := f.blocks[bi2].head
                            for _u in 0:f.instrs.len {
                                if jj < 0 { <- }
                                if jj != ii {
                                    kk := mfn_ikind(&f.instrs, jj)
                                    if !(mir_instr_has_dest(kk) && mfn_ia(&f.instrs, jj) == d) {
                                        mir_replace_temp_operands(f, jj, d, s)
                                    }
                                }
                                jj = mfn_inext(&f.instrs, jj)
                            }
                        }
                        kill.push(ii)
                        round = true
                    }
                }
                ii = nxt
            }
            for ki in 0:kill.len {
                mir_delete_instr(f, bi, kill[ki])
            }
        }
        if !round { <- }
        changed = true
    }
    << changed
}

fn mir_cse_frmw_mark_locs(f &MFn, bi int, mark &[]bool, loc_ok $&[]bool) {
    nloc := loc_ok.len
    nt := f.temps.len
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        if mfn_ikind(&f.instrs, ii) == MI_LOAD_LOCAL {
            dest := mfn_ia(&f.instrs, ii)
            loc := mfn_ib(&f.instrs, ii)
            if loc >= 0 && loc < nloc && dest >= 0 && dest < nt {
                if f.temps[dest] == 4 {
                    mfn_set_b(loc_ok, loc, true)
                }
                if dest < mark.len && mark[dest] {
                    mfn_set_b(loc_ok, loc, true)
                }
            }
        }
        ii = mfn_inext(&f.instrs, ii)
    }
}

fn mir_cse_kill_last(last_on $&[]bool, last_t $&[]int, dest int) {
    n := last_on.len
    for li in 0:n {
        if last_on[li] && last_t[li] == dest {
            mfn_set_b(last_on, li, false)
        }
    }
}

fn mir_cse_clear_last(last_on $&[]bool) {
    n := last_on.len
    for li in 0:n {
        mfn_set_b(last_on, li, false)
    }
}

fn mir_cse_frmw_step(f $&MFn, ii int, loc_ok &[]bool, last_t $&[]int, last_on $&[]bool) bool {
    nloc := loc_ok.len
    k := mfn_ikind(&f.instrs, ii)
    ia := mfn_ia(&f.instrs, ii)
    ib := mfn_ib(&f.instrs, ii)
    $did := false
    if k == MI_LOAD_LOCAL {
        loc := ib
        if loc >= 0 && loc < nloc && loc_ok[loc] && last_on[loc] {
            mfn_become_copy($&f.instrs, ii, last_t[loc])
            did = true
        }
    }
    if k == MI_STORE_LOCAL || k == MI_DROP {
        loc := ia
        if loc >= 0 && loc < nloc {
            mfn_set_b(last_on, loc, false)
        }
    }
    if k == MI_CALL || k == MI_ARR_PUSH || k == MI_ARR_PUSH4 {
        mir_cse_clear_last(last_on)
    }
    if k == MI_ADDR && mfn_ic(&f.instrs, ii) == 0 {
        loc := ib
        if loc >= 0 && loc < nloc {
            mfn_set_b(last_on, loc, false)
        }
    }
    if mir_instr_has_dest(k) {
        mir_cse_kill_last(last_on, last_t, ia)
    }
    if k == MI_LOAD_LOCAL && !did {
        loc := ib
        dest := ia
        if loc >= 0 && loc < nloc && loc_ok[loc] {
            mfn_set_i(last_t, loc, dest)
            mfn_set_b(last_on, loc, true)
        }
    }
    << did
}

fn mir_cse_frmw_block(f $&MFn, bi int, mark &[]bool) bool {
    nloc := f.locals.len
    $loc_ok := []bool{}
    $last_t := []int{}
    $last_on := []bool{}
    for _ in 0:nloc {
        loc_ok.push(false)
        last_t.push(0 - 1)
        last_on.push(false)
    }
    mir_cse_frmw_mark_locs(&*f, bi, mark, $&loc_ok)
    $changed := false
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        nxt := mfn_inext(&f.instrs, ii)
        if mir_cse_frmw_step(f, ii, &loc_ok, $&last_t, $&last_on) {
            changed = true
        }
        ii = nxt
    }
    << changed
}

fn mir_cse_frmw_and_f64_loads(f $&MFn) bool {
    nt := f.temps.len
    $mark := []bool{}
    for _ in 0:nt {
        mark.push(false)
    }
    mir_fill_frmw_ptr(&*f, $&mark)
    $changed := false
    for bi in 0:f.blocks.len {
        if mir_cse_frmw_block(f, bi, &mark) {
            changed = true
        }
    }
    << changed
}

fn mir_swap_adj(f $&MFn, bi int, pred int, a int, b int) {
    bn := mfn_inext(&f.instrs, b)
    if pred < 0 {
        $blk := f.blocks[bi]
        blk.head = b
        mfn_set_block($&f.blocks, bi, blk)
    } else {
        mfn_set_inext($&f.instrs, pred, b)
    }
    mfn_set_inext($&f.instrs, b, a)
    mfn_set_inext($&f.instrs, a, bn)
    $blk2 := f.blocks[bi]
    if blk2.tail == b {
        blk2.tail = a
        mfn_set_block($&f.blocks, bi, blk2)
    }
}

fn mir_bubble_adj_ok(f &MFn, prv int, cur int, mark &[]bool) bool {
    if mfn_ikind(&f.instrs, cur) != MI_LOAD_LOCAL { << false }
    dest := mfn_ia(&f.instrs, cur)
    $is_ptr := false
    $is_f64 := false
    if dest >= 0 && dest < f.temps.len && f.temps[dest] == 4 {
        is_f64 = true
    }
    if dest >= 0 && dest < mark.len && mark[dest] {
        is_ptr = true
    }
    if !is_ptr && !is_f64 { << false }
    if f.instr_uses_temp(prv, dest) { << false }
    pk := mfn_ikind(&f.instrs, prv)
    if pk == MI_BIN {
        pd := mfn_ia(&f.instrs, prv)
        if pd >= 0 && pd < f.temps.len && f.temps[pd] == 4 && mfn_ib(&f.instrs, prv) == 3 {
            << true
        }
        << false
    }
    if pk == MI_LOAD_LOCAL && is_ptr {
        pdest := mfn_ia(&f.instrs, prv)
        if pdest >= 0 && pdest < f.temps.len && f.temps[pdest] == 4 { << true }
        << false
    }
    << false
}

fn mir_bubble_one(f $&MFn, bi int, mark &[]bool) bool {
    $pred := 0 - 1
    $prev := 0 - 1
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { << false }
        nxt := mfn_inext(&f.instrs, ii)
        if prev >= 0 {
            if mir_bubble_adj_ok(&*f, prev, ii, mark) {
                mir_swap_adj(f, bi, pred, prev, ii)
                << true
            }
        }
        pred = prev
        prev = ii
        ii = nxt
    }
    << false
}

fn mir_bubble_frmw_loads(f $&MFn) bool {
    nt := f.temps.len
    $mark := []bool{}
    for _ in 0:nt {
        mark.push(false)
    }
    mir_fill_frmw_ptr(&*f, $&mark)
    $changed := false
    for bi in 0:f.blocks.len {
        for _r in 0:32 {
            if !mir_bubble_one(f, bi, &mark) { <- }
            changed = true
        }
    }
    << changed
}
