@xu/types

// SSA promotion exposes constants that the earlier slot-shaped pipeline
// could not see. Propagate values, never aliases, in bounded return blocks.
// Calls, addresses, allocation and control flow retain the existing path.
fn mir_late_const_body(f &MFn) bool {
    if f.locals.len > 48 || f.temps.len > 512 || f.instrs.len >= 256 || f.blocks.len > 32 { << false }
    if !mir_verify_shape_mfn_f(f) { << false }
    // A comparison has a bool destination even for floating operands. Keep
    // floating bodies out rather than interpreting their pool bits as ints.
    for t in 0:f.temps.len {
        if f.temps[t] == 4 { << false }
    }
    mut load := false
    mut store := false
    for bi in 0:f.blocks.len {
        tk := f.blocks[bi].tkind
        if tk != 3 && !(tk == 0 && f.blocks[bi].head < 0) { << false }
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == 14 { load = true }
            if k == 20 { store = true }
            if k != 0 && !(k >= 1 && k <= 5) && k != 14 && k != 17 && k != 20 { << false }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << load && store
}

fn mir_late_const_key(f &MFn, known &[]int, value int) int {
    if value <= -2 {
        ci := 0 - value - 2
        if ci >= 0 && ci < f.consts.len { << ci }
        << -1
    }
    if value >= 0 && value < known.len { << known[value] }
    << -1
}

fn mir_late_const_value(f &MFn, known &[]int, value int) int {
    ci := mir_late_const_key(f, known, value)
    if ci < 0 { << value }
    << 0 - ci - 2
}

fn mir_late_const_type(f &MFn, t int) bool {
    if t < 0 || t >= f.temps.len || f.temps_nslots[t] != 1 { << false }
    << f.temps[t] == 1 || f.temps[t] == 2
}

fn mir_late_const_bin_ok(op int, lhs int, rhs int) bool {
    // Division/remainder retain target-specific exceptional behavior. Shift
    // counts outside the ordinary word range likewise stay in the emitter.
    if op == 4 || op == 5 || op == 12 || op == 13 { << false }
    if (op == 17 || op == 18) && (rhs < 0 || rhs >= 64) { << false }
    << op >= 1 && op <= 18
}

fn mir_late_const_bin(op int, lhs int, rhs int) int {
    if op == 1 { << lhs + rhs }
    if op == 2 { << lhs - rhs }
    if op == 3 { << lhs * rhs }
    if op >= 6 && op <= 11 { << mir_eval_cmp(op, lhs, rhs) }
    if op == 17 { << lhs << rhs }
    if op == 18 { << lhs >> rhs }
    if op == 14 { << lhs & rhs }
    if op == 15 { << lhs | rhs }
    if op == 16 { << lhs ^ rhs }
    << 0
}

fn mir_late_const_intern(f &mut MFn, value int) int {
    encoded := mir_find_const(f, value)
    if encoded <= -2 { << 0 - encoded - 2 }
    ci := f.consts.len
    f.consts.push(value)
    << ci
}

fn mir_late_const_block(f &mut MFn, bi int) bool {
    mut known := []int{}
    for _ in 0:f.temps.len { known.push(-1) }
    mut changed := false
    mut ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        k := mfn_ikind(&f.instrs, ii)
        a := mfn_ia(&f.instrs, ii)
        b := mfn_ib(&f.instrs, ii)
        c := mfn_ic(&f.instrs, ii)
        d := mfn_id(&f.instrs, ii)
        mut fact := -1
        if k == 1 || k == 3 {
            nb := mir_late_const_value(&*f, &known, b)
            if nb != b { mfn_set_ib(mut &f.instrs, ii, nb)
                changed = true }
            if k == 1 && mir_late_const_type(&*f, a) {
                fact = mir_late_const_key(&*f, &known, b)
                if fact >= 0 && f.temps[a] == 2 && f.consts[fact] != 0 && f.consts[fact] != 1 { fact = -1 }
            }
        } else if k == 4 || k == 5 {
            nc := mir_late_const_value(&*f, &known, c)
            if nc != c { mfn_set_ic(mut &f.instrs, ii, nc)
                changed = true }
            mut nd := d
            if k == 4 {
                nd = mir_late_const_value(&*f, &known, d)
                if nd != d { mfn_set_id(mut &f.instrs, ii, nd)
                    changed = true }
            }
            lc := mir_late_const_key(&*f, &known, nc)
            rc := mir_late_const_key(&*f, &known, nd)
            if mir_late_const_type(&*f, a) && lc >= 0 {
                lhs := f.consts[lc]
                mut fold := false
                mut value := 0
                if k == 4 && rc >= 0 {
                    rhs := f.consts[rc]
                    if mir_late_const_bin_ok(b, lhs, rhs) && (f.temps[a] == 1 || (b >= 6 && b <= 11)) {
                        value = mir_late_const_bin(b, lhs, rhs)
                        fold = true
                    }
                } else if k == 5 {
                    if b == 1 && f.temps[a] == 1 { value = 0 - lhs
                        fold = true }
                    if b == 2 && f.temps[a] == 2 {
                        if lhs == 0 { value = 1 }
                        fold = true
                    }
                }
                if fold {
                    fact = mir_late_const_intern(f, value)
                    mfn_set_copy(mut &f.instrs, ii, 0 - fact - 2)
                    changed = true
                }
            }
        } else if k == 14 {
            nc := mir_late_const_value(&*f, &known, c)
            if nc != c { mfn_set_ic(mut &f.instrs, ii, nc)
                changed = true }
        } else if k == 20 {
            nb := mir_late_const_value(&*f, &known, b)
            nc := mir_late_const_value(&*f, &known, c)
            if nb != b { mfn_set_ib(mut &f.instrs, ii, nb)
                changed = true }
            if nc != c { mfn_set_ic(mut &f.instrs, ii, nc)
                changed = true }
        }
        if (k == 1 || k == 2 || k == 4 || k == 5 || k == 14 || k == 17) && a >= 0 && a < known.len { known[a] = fact }
        ii = mfn_inext(&f.instrs, ii)
    }
    ta := f.blocks[bi].ta
    nt := mir_late_const_value(&*f, &known, ta)
    if nt != ta {
        mut blk := f.blocks[bi]
        blk.ta = nt
        mfn_set_block(mut &f.blocks, bi, blk)
        changed = true
    }
    << changed
}

fn mir_each_late_const(m &mut Mir) {
    n0 := m.fns.len
    mut fi := 0
    while fi < n0 {
        if mir_fn_is_extern(&*m, fi) { fi += 1
            -> }
        if mir_nlocals(&*m, fi) > 48 || mir_ntemps(&*m, fi) > 512 || mir_nins(&*m, fi) >= 256 || mir_nblocks(&*m, fi) > 32 { fi += 1
            -> }
        if !mir_summary_has(mir_fn_summary(m, fi), mir_sum_index) { fi += 1
            -> }
        mut f := mir_clone_fn(m, fi, true)
        if !mir_late_const_body(&f) { fi += 1
            -> }
        mut changed := false
        for bi in 0:f.blocks.len {
            if f.blocks[bi].tkind == 3 && mir_late_const_block(mut &f, bi) { changed = true }
        }
        if !changed { fi += 1
            -> }
        mir_dce_pure(mut &f)
        mir_fn_commit(m, fi, f)
        fi += 1
    }
}
