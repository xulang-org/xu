@xu/types

// Test structural containment without a recursion-depth quota. Nominal
// generic arguments participate through sargs; ordinary fields do not make
// unrelated declarations a recursively growing specialization.
fn (c &Checker) generic_type_contains(outer int,inner int) bool {
    mut pending := [outer]
    mut seen := []int{}
    mut cursor := 0
    while cursor < pending.len {
        ty := pending[cursor]
        cursor += 1
        if ty == inner { << true }
        mut visited := false
        for item in seen { if item == ty { visited = true } }
        if visited { -> }
        seen.push(ty)
        if is_ref_type(ty) { pending.push(c.ref_inner_type(ty)) }
        else if is_array_type(ty) { pending.push(c.arrays[array_index(ty)].elem_ty) }
        else if is_chan_type(ty) { pending.push(c.chans[chan_index(ty)].elem_ty) }
        else if is_map_type(ty) { index := map_index(ty)
            pending.push(c.maps[index].key_ty)
            pending.push(c.maps[index].val_ty) }
        else if is_struct_type(ty) { index := struct_index(ty)
            if index >= 0 && index < c.sargs.len { for arg in c.sargs[index] { pending.push(arg) } } }
        else if is_enum_type(ty) { for arg in c.enums[enum_index(ty)].args { pending.push(arg) } }
        else if is_fn_type(ty) { index := fn_index(ty)
            pending.push(c.fn_sigs[index].ret)
            for arg in c.fn_sigs[index].params { pending.push(arg) } }
        else if is_throw_type(ty) { index := throw_index(ty)
            pending.push(c.throws[index].ok_ty)
            pending.push(c.throws[index].err_ty) }
    }
    << false
}
fn (c &Checker) generic_expansion_grows(template_id int,args &[]int) bool {
    mut ancestor := c.cur_fn
    mut seen := []int{}
    while ancestor >= 0 && ancestor < c.fns.len {
        for item in seen { if item == ancestor { << false } }
        seen.push(ancestor)
        if ancestor < c.is_inst.len && c.is_inst[ancestor] != 0 && c.fndecl[ancestor] == c.fndecl[template_id] && ancestor < c.inst_targs.len && args.len == c.inst_targs[ancestor].len {
            mut embeds := true
            mut strict := false
            for i in 0:args.len {
                old := c.inst_targs[ancestor][i]
                if args[i] != old { strict = true }
                if !c.generic_type_contains(args[i],old) { embeds = false }
            }
            if embeds && strict { << true }
        }
        if ancestor >= c.inst_parent.len { << false }
        ancestor = c.inst_parent[ancestor]
    }
    << false
}
