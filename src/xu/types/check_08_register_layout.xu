@xu/types

#xu/ast
#xu/parser

fn (c &Checker) find_const(name string) int {
    // Unqualified: current module only (set during body check / register).
    << c.find_const_in_mod(name, c.cur_mod)
}

fn (c $&Checker) register_const(p &parser.Parser, d int) {
    // Read sval2 per use: string params / locals are by-value (move).
    c.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, decl_file_id(p, d))
    if c.find_const_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate const '" + p.nodes[d].sval + "'")
    }
    is_pub := p.nodes[d].ival == 1
    lit := p.nodes[d].a
    lk := p.nodes[lit].kind
    if lk == ast.NK_INT { // Int
        c.cnames.push(p.nodes[d].sval)
        c.ctypes.push(1)
        c.civals.push(p.nodes[lit].ival)
        c.cstr_idx.push(-1)
        c.cmods.push(p.nodes[d].sval2)
        c.cpubs.push(b2i(is_pub))
        ck := map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ci := c.cnames.len - 1
        strmap_put($&c.const_map, ck, ci)
        checker_set_i($&c.ntype, lit, 1)
        <<
    }
    if lk == ast.NK_BOOL { // Bool
        c.cnames.push(p.nodes[d].sval)
        c.ctypes.push(2)
        c.civals.push(p.nodes[lit].ival)
        c.cstr_idx.push(-1)
        c.cmods.push(p.nodes[d].sval2)
        c.cpubs.push(b2i(is_pub))
        ck := map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ci := c.cnames.len - 1
        strmap_put($&c.const_map, ck, ci)
        checker_set_i($&c.ntype, lit, 2)
        <<
    }
    if lk == ast.NK_STR { // Str
        idx := c.intern(p.nodes[lit].sval)
        c.cnames.push(p.nodes[d].sval)
        c.ctypes.push(3)
        c.civals.push(0)
        c.cstr_idx.push(idx)
        c.cmods.push(p.nodes[d].sval2)
        c.cpubs.push(b2i(is_pub))
        ck := map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ci := c.cnames.len - 1
        strmap_put($&c.const_map, ck, ci)
        checker_set_i($&c.nstr, lit, idx)
        checker_set_i($&c.ntype, lit, 3)
        <<
    }
    c.fail_node(p, d, "const initializer must be an int, bool, or string literal")
}

fn (c $&Checker) find_enum_in_mod(name string, mod_id string) int {
    for i in 0:c.enums.len {
        if c.enums[i].name == name && c.enums[i].mod_id == mod_id {
            << i
        }
    }
    << -1
}

fn (c $&Checker) register_enum(p &parser.Parser, d int) {
    c.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, decl_file_id(p, d))
    if c.find_enum_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate enum definition '" + p.nodes[d].sval + "'")
    }
    if c.find_etpl(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate enum definition '" + p.nodes[d].sval + "'")
    }
    if c.find_struct_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "type '" + p.nodes[d].sval + "' is already defined")
    }
    if c.find_stpl(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "type '" + p.nodes[d].sval + "' is already defined")
    }
    if p.nodes[d].e >= 0 {
        c.etpl_name.push(p.nodes[d].sval)
        c.etpl_mod.push(p.nodes[d].sval2)
        c.etpl_decl.push(d)
        c.etpl_pub.push(b2i(p.nodes[d].ival == 1))
        ek := map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ei := c.etpl_name.len - 1
        strmap_put($&c.etpl_map, ek, ei)
        <<
    }
    $en := CEnum{
        name: p.nodes[d].sval,
        variants: []CEnumVariant{},
        nslots: 1,
        owns: false,
        mod_id: p.nodes[d].sval2,
        is_pub: p.nodes[d].ival == 1,
        origin: "",
        args: []int{}
    }
    $max_payload := 0
    $v := p.nodes[d].a
    while v >= 0 {
    if p.nodes[v].kind != ast.NK_VARIANT_DECL {
        c.fail_node(p, v, "malformed enum variant")
    }
    // Duplicate variant name?
    for i in 0:en.variants.len {
        if en.variants[i].name == p.nodes[v].sval {
            c.fail_node(p, v, "variant '" + p.nodes[v].sval + "' is defined more than once")
        }
    }
    $fields := []int{}
    $field_slots := 0
    $ft := p.nodes[v].a
    while ft >= 0 {
        fty := c.type_of(p, ft)
        if is_ref_type(fty) {
            c.fail_node(p, ft, "enum payload cannot contain references without lifetime tracking")
        }
        slots := c.type_slots(fty)
        // Enum payloads are materialized as a tag plus the largest variant.
        // Reject a malformed/oversized field before the running sum can wrap;
        // zero-sized temporary/empty structs remain legal and preserve the
        // existing checker ordering.
        if slots < 0 || slots > MIR_MAX_LAYOUT_WORDS || field_slots > MIR_MAX_LAYOUT_WORDS - slots {
            c.fail_node(p, ft, "enum payload exceeds layout limit")
            <<
        }
        fields.push(fty)
        field_slots += slots
        if c.type_owning(fty) {
            en.owns = true
        }
        ft = p.nodes[ft].next
    }
    if field_slots >= MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, v, "enum payload exceeds layout limit")
        <<
    }
    if field_slots > max_payload {
        max_payload = field_slots
    }
    en.variants.push(CEnumVariant{
        name: p.nodes[v].sval,
        fields: fields,
        field_slots: field_slots
    })
    v = p.nodes[v].next
    }
    if max_payload >= MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, d, "enum payload exceeds layout limit")
        <<
    }
    en.nslots = 1 + max_payload
    if c.enums.len >= TYPE_TABLE_LIMIT {
        c.fail_node(p, d, "too many enum types")
        <<
    }
    c.enums.push(en)
}

fn (c $&Checker) register_struct_name(p &parser.Parser, d int) {
    c.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, decl_file_id(p, d))
    // We can't bind `name` to a local here and pass it to find_struct: in
    // s3a, `string` parameters are by-value (move), so the local would be
    // consumed. Inline the duplicate check by reading the sval field twice.
    if c.find_struct_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate struct definition '" + p.nodes[d].sval + "'")
    }
    if c.find_stpl(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate struct definition '" + p.nodes[d].sval + "'")
    }
    resource_label := c.resource_decl_drop_label(p, d)
    // Generic struct template: store decl; fields laid out on instantiation.
    if p.nodes[d].e >= 0 {
        c.stpl_name.push(p.nodes[d].sval)
        c.stpl_mod.push(p.nodes[d].sval2)
        c.stpl_decl.push(d)
        c.stpl_pub.push(b2i(p.nodes[d].ival == 1))
        sk := map_key(p.nodes[d].sval2, p.nodes[d].sval)
        si := c.stpl_name.len - 1
        strmap_put($&c.stpl_map, sk, si)
        <<
    }
    if c.type_table_full(c.structs.len, TYPE_TABLE_LIMIT, "struct", 5) { << }
    c.structs.push(CStruct{
        name: p.nodes[d].sval,
        fields: []CField{},
        nslots: 0,
        size_bytes: 0,
        align_bytes: 1,
        mod_id: p.nodes[d].sval2,
        is_pub: p.nodes[d].ival == 1,
        origin: "",
        drop_label: resource_label
    })
    c.note_st_index()
    c.sargs.push([]int{})
    c.sdecl.push(d)
    c.slaid.push(0)
    c.sdoing.push(0)
}

fn (c $&Checker) layout_struct(p &parser.Parser, d int) {
    if p.nodes[d].e >= 0 {
        <<
    }
    si := c.find_struct_in_mod(p.nodes[d].sval, p.nodes[d].sval2)
    if si < 0 {
        c.fail_node(p, d, "internal: struct '" + p.nodes[d].sval + "' was not registered")
        <<
    }
    c.layout_struct_at(p, si)
}

// Lay out struct `si` (recursively laying out any struct-typed fields first,
// mirroring bootstrap xuhir layout_one/slots_of). Structs may reference each
// other across modules in any declaration order; the layout of a field struct
// is computed on demand so imported structs (merged after the CLI module) are
// sized before the wrapping struct.
fn (c $&Checker) layout_struct_at(p &parser.Parser, si int) {
    if c.slaid[si] != 0 {
        <<
    }
    if c.sdoing[si] != 0 {
        <<
    }
    d := c.sdecl[si]
    checker_set_i($&c.sdoing, si, 1)
    saved_mod := c.cur_mod
    saved_file := c.cur_file
    saved_fname := c.cur_file_name
    c.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, decl_file_id(p, d))
    $fields := []CField{}
    $off := 0
    $mal := 1
    $f := p.nodes[d].a
    while f >= 0 {
    if p.nodes[f].kind != ast.NK_FIELD_DECL {
        c.fail_node(p, f, "malformed struct field")
    }
    fty := c.type_of(p, p.nodes[f].a)
    c.slots_of(p, fty, f)
    // M10: reference fields allowed for local use; escape checked at <<.
    // M165: capture `&a` lifetime from the field type node.
    $life := ""
    tn := p.nodes[f].a
    if tn >= 0 && p.nodes[tn].kind == ast.NT_REF {
        life = p.nodes[tn].sval
    }
    al := c.type_align_bytes(fty)
    if al < 1 || al > MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct field alignment exceeds layout limit")
        checker_set_i($&c.sdoing, si, 0)
        c.cur_mod = saved_mod
        c.cur_file = saved_file
        c.cur_file_name = saved_fname
        <<
    }
    aligned := align_up_bytes(off, al)
    if aligned < off || aligned > MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        checker_set_i($&c.sdoing, si, 0)
        c.cur_mod = saved_mod
        c.cur_file = saved_file
        c.cur_file_name = saved_fname
        <<
    }
    sz := c.type_size_bytes(fty)
    if sz < 0 || sz > MIR_MAX_LAYOUT_BYTES || aligned > MIR_MAX_LAYOUT_BYTES - sz {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        checker_set_i($&c.sdoing, si, 0)
        c.cur_mod = saved_mod
        c.cur_file = saved_file
        c.cur_file_name = saved_fname
        <<
    }
    if al > mal { mal = al }
    fields.push(CField{name: p.nodes[f].sval, ty: fty, slot: aligned, life: life, is_pub: p.nodes[f].ival == 1})
    off = aligned + sz
    f = p.nodes[f].next
    }
    aligned := align_up_bytes(off, mal)
    if aligned < off || aligned > MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, d, "struct layout exceeds byte limit")
        checker_set_i($&c.sdoing, si, 0)
        c.cur_mod = saved_mod
        c.cur_file = saved_file
        c.cur_file_name = saved_fname
        <<
    }
    off = aligned
    $nslots := off / 8
    if off % 8 != 0 { nslots += 1 }
    if nslots > MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, d, "struct layout exceeds slot limit")
        checker_set_i($&c.sdoing, si, 0)
        c.cur_mod = saved_mod
        c.cur_file = saved_file
        c.cur_file_name = saved_fname
        <<
    }
    // Whole-element replace: field assign through `c.structs[si].fields` is
    // not a local root (HIR/xumir).
    c.structs[si] = CStruct{
        name: p.nodes[d].sval,
        fields: fields,
        nslots: nslots,
        size_bytes: off,
        align_bytes: mal,
        mod_id: p.nodes[d].sval2,
        is_pub: p.nodes[d].ival == 1,
        origin: "",
        drop_label: c.structs[si].drop_label + ""
    }
    checker_set_i($&c.sdoing, si, 0)
    checker_set_i($&c.slaid, si, 1)
    c.cur_mod = saved_mod
    c.cur_file = saved_file
    c.cur_file_name = saved_fname
}

// Slot count for a field type, laying out struct-typed fields on demand.
fn (c $&Checker) slots_of(p &parser.Parser, ty int, n int) int {
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < c.structs.len && c.sdecl[si] >= 0 {
            if c.sdoing[si] != 0 {
                c.fail_node(p, n, "struct has infinite size (recursive layout)")
                << 1
            }
            c.layout_struct_at(p, si)
        }
    }
    << c.type_slots(ty)
}

fn (c $&Checker) register_interface_name(p &parser.Parser, d int) {
    // AST nodes own their spelling strings.  A direct field expression passed
    // to an owning slice push/call is lowered as a move by hosted Gen2; the
    // parser pool then loses the descriptor and interface method names can be
    // corrupted (e.g. Error.msg becoming an unrelated name).  Snapshot each
    // spelling before using it in maps or persistent checker tables.
    dname := p.nodes[d].sval + ""
    dmod := p.nodes[d].sval2 + ""
    c.cur_mod = dmod + ""
    c.set_cur_file(p, decl_file_id(p, d))
    if c.find_iface(dname + "", dmod + "") >= 0 {
        c.fail_node(p, d, "struct@ '" + dname + "' is defined more than once")
    }
    ii := c.iface_names.len
    if ii >= TYPE_TABLE_LIMIT {
        c.fail_node(p, d, "too many struct@ interface types")
        <<
    }
    c.iface_names.push(dname + "")
    c.iface_mods.push(dmod + "")
    strmap_put($&c.iface_map, map_key(dmod + "", dname + ""), ii)
    iname := dname + ""
    prev := strmap_get(&c.iface_glob_map, &iname)
    if prev < 0 {
        strmap_put($&c.iface_glob_map, iname, ii)
    } else if prev != -2 {
        strmap_put($&c.iface_glob_map, iname, -2)
    }
}

// Resolve signatures only after the concrete enum payloads are registered.
// Interfaces must already have names so enum payloads may box an interface.
fn (c $&Checker) resolve_interface_methods(p &parser.Parser, d int) {
    c.cur_mod = p.nodes[d].sval2 + ""
    c.set_cur_file(p, decl_file_id(p, d))
    ii := c.find_iface(p.nodes[d].sval + "", p.nodes[d].sval2 + "")
    if ii < 0 { c.fail_node(p, d, "internal: unregistered struct@")
        << }
    $m := p.nodes[d].a
    while m >= 0 {
        if p.nodes[m].kind != ast.NK_METHOD_SIG {
            c.fail_node(p, m, "malformed struct@ method")
        }
        c.im_ii.push(ii)
        mname := p.nodes[m].sval + ""
        c.im_name.push(mname + "")
        poff := c.im_ptys.len
        $plen := 0
        $pt := p.nodes[m].a
        while pt >= 0 {
            pty := c.type_of(p, pt)
            c.im_ptys.push(pty)
            plen += 1
            pt = p.nodes[pt].next
        }
        c.im_poff.push(poff)
        c.im_plen.push(plen)
        $ret := 0
        if p.nodes[m].b >= 0 {
            ret = c.type_of(p, p.nodes[m].b)
        }
        c.im_ret.push(ret)
        m = p.nodes[m].next
    }
}

// Resolve a linked type-node list into c.targs; returns its length.
// Collected locally first: type_of on a nested generic re-enters here and
// would otherwise clobber the outer list.
fn (c $&Checker) collect_type_list_n(p &parser.Parser, head int) int {
    $list := []int{}
    $a := head
    while a >= 0 {
        list.push(c.type_of(p, a))
        a = p.nodes[a].next
    }
    n := list.len
    c.targs = list
    c.targs_n = n
    << n
}

// Replace c.targs with the first n entries of src.
fn (c $&Checker) load_targs(src &[]int, n int) {
    $list := []int{}
    for i in 0:n {
        if i < src.len {
            list.push(src[i])
        } else {
            list.push(0)
        }
    }
    c.targs = list
    c.targs_n = n
}

// c.targs = c.uni_bind[0..n) (call-site inference result).
fn (c $&Checker) load_targs_uni(n int) {
    $list := []int{}
    for i in 0:n {
        $v := 0
        if i < c.uni_bind.len { v = c.uni_bind[i] }
        list.push(v)
    }
    c.targs = list
    c.targs_n = n
}

// c.targs = c.sargs[si] (generic struct instance args).
fn (c $&Checker) load_targs_sargs(si int) {
    $list := []int{}
    for i in 0:c.sargs[si].len {
        v := c.sargs[si][i]
        list.push(v)
    }
    c.targs_n = list.len
    c.targs = list
}

// Copy of c.targs (instantiators snapshot before nested instantiation).
fn (c &Checker) targs_copy() []int {
    $args := []int{}
    for i in 0:c.targs.len {
        args.push(c.targs[i])
    }
    << args
}

// Instantiate generic struct from type args already in c.targs.
// `at` is a TNamed/StructInit node whose sval is the template name; module is c.cur_mod.
// Saves/restores the caller's type-param subst (method registration may have one).
fn (c $&Checker) instantiate_struct(p &parser.Parser, at int) int {
    args := c.targs_copy()
    // Snapshot caller subst (parallel arrays; re-push after).
    $saved_sn := []string{}
    $saved_st := []int{}
    for i in 0:c.sub_names.len {
        saved_sn.push(c.sub_names[i])
        saved_st.push(c.sub_tys[i])
    }
    ti := c.find_stpl(c.named_local_of(p, at), c.named_mod_of(p, at))
    if ti < 0 {
        c.fail_node(p, at, "'" + p.nodes[at].sval + "' is not a generic struct")
        << -1
    }
    if c.named_mod_of(p, at) != c.cur_mod && c.stpl_pub[ti] == 0 {
        c.fail_node(p, at, "'" + c.named_local_of(p, at) + "' is private")
        << -1
    }
    // Count template type params.
    d := c.stpl_decl[ti]
    $ntp := 0
    $tp := p.nodes[d].e
    while tp >= 0 {
    ntp += 1
    tp = p.nodes[tp].next
    }
    if args.len != ntp {
        c.fail_node(p, at, "struct '" + p.nodes[at].sval + "' takes " + str(ntp) + " type argument(s), found " + str(args.len))
        << -1
    }
    // Dedup existing instances (re-read sval/mod each compare — strings move).
    for si in 0:c.structs.len {
        if c.structs[si].origin == c.named_local_of(p, at) && c.structs[si].mod_id == c.named_mod_of(p, at) {
            $same := c.sargs[si].len == args.len
            if same {
                for i in 0:args.len {
                    if c.sargs[si][i] != args[i] {
                        same = false
                    }
                }
            }
            if same {
                << si
            }
        }
    }
    // Build subst from template type params.
    c.clear_subst()
    tp = p.nodes[d].e
    $k := 0
    while tp >= 0 {
    c.set_subst_pair(p.nodes[tp].sval, args[k])
    k += 1
    tp = p.nodes[tp].next
    }
    $st := CStruct{
        name: p.nodes[at].sval,
        fields: []CField{},
        nslots: 0,
        size_bytes: 0,
        align_bytes: 1,
        mod_id: c.named_mod_of(p, at),
        is_pub: c.stpl_pub[ti] != 0,
        origin: c.named_local_of(p, at),
        drop_label: ""
    }
    // Pretty name: Box#int
    $nm := p.nodes[at].sval + "#"
    for i in 0:args.len {
        if i > 0 { nm = nm + "," }
        nm = nm + c.ty_display(args[i])
    }
    st.name = nm
    $f := p.nodes[d].a
    $off := 0
    $mal := 1
    while f >= 0 {
    if p.nodes[f].kind != ast.NK_FIELD_DECL {
        c.clear_subst()
        c.fail_node(p, f, "malformed struct field")
    }
    fty := c.type_of(p, p.nodes[f].a)
    // M10: reference fields allowed on monomorphized structs too.
    $life := ""
    tn := p.nodes[f].a
    if tn >= 0 && p.nodes[tn].kind == ast.NT_REF {
        life = p.nodes[tn].sval
    }
    al := c.type_align_bytes(fty)
    if al < 1 || al > MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct field alignment exceeds layout limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    aligned := align_up_bytes(off, al)
    if aligned < off || aligned > MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    sz := c.type_size_bytes(fty)
    if sz < 0 || sz > MIR_MAX_LAYOUT_BYTES || aligned > MIR_MAX_LAYOUT_BYTES - sz {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    if al > mal { mal = al }
    st.fields.push(CField{name: p.nodes[f].sval, ty: fty, slot: aligned, life: life, is_pub: p.nodes[f].ival == 1})
    off = aligned + sz
    f = p.nodes[f].next
    }
    aligned := align_up_bytes(off, mal)
    if aligned < off || aligned > MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, at, "struct layout exceeds byte limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    off = aligned
    $nslots := off / 8
    if off % 8 != 0 { nslots += 1 }
    if nslots > MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, at, "struct layout exceeds slot limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    st.nslots = nslots
    st.size_bytes = off
    st.align_bytes = mal
    c.clear_subst()
    // Restore caller subst.
    for i in 0:saved_sn.len {
        c.set_subst_pair(saved_sn[i], saved_st[i])
    }
    if c.type_table_full(c.structs.len, TYPE_TABLE_LIMIT, "struct", 5) { << -1 }
    c.structs.push(st)
    c.note_st_index()
    $arg_copy := []int{}
    for i in 0:args.len {
        arg_copy.push(args[i])
    }
    c.sargs.push(arg_copy)
    c.sdecl.push(-1)
    c.slaid.push(1)
    c.sdoing.push(0)
    << c.structs.len - 1
}

// Instantiate generic enum from type args already in c.targs.
fn (c $&Checker) instantiate_enum(p &parser.Parser, at int) int {
    args := c.targs_copy()
    $saved_sn := []string{}
    $saved_st := []int{}
    for i in 0:c.sub_names.len {
        saved_sn.push(c.sub_names[i])
        saved_st.push(c.sub_tys[i])
    }
    ti := c.find_etpl(c.named_local_of(p, at), c.named_mod_of(p, at))
    if ti < 0 {
        c.fail_node(p, at, "'" + p.nodes[at].sval + "' is not a generic enum")
        << -1
    }
    if c.named_mod_of(p, at) != c.cur_mod && c.etpl_pub[ti] == 0 {
        c.fail_node(p, at, "'" + c.named_local_of(p, at) + "' is private")
        << -1
    }
    d := c.etpl_decl[ti]
    $ntp := 0
    $tp := p.nodes[d].e
    while tp >= 0 {
        ntp += 1
        tp = p.nodes[tp].next
    }
    if args.len != ntp {
        c.fail_node(p, at, "enum '" + p.nodes[at].sval + "' takes " + str(ntp) + " type argument(s), found " + str(args.len))
        << -1
    }
    for ei in 0:c.enums.len {
        if c.enums[ei].origin == c.named_local_of(p, at) && c.enums[ei].mod_id == c.named_mod_of(p, at) {
            $same := c.enums[ei].args.len == args.len
            if same {
                for i in 0:args.len {
                    if c.enums[ei].args[i] != args[i] {
                        same = false
                    }
                }
            }
            if same {
                << ei
            }
        }
    }
    if c.enums.len >= TYPE_TABLE_LIMIT {
        c.fail_node(p, at, "too many enum types")
        << -1
    }
    c.clear_subst()
    tp = p.nodes[d].e
    $k := 0
    while tp >= 0 {
        c.set_subst_pair(p.nodes[tp].sval, args[k])
        k += 1
        tp = p.nodes[tp].next
    }
    $nm := p.nodes[at].sval + "#"
    for i in 0:args.len {
        if i > 0 { nm = nm + "," }
        nm = nm + c.ty_display(args[i])
    }
    $en := CEnum{
        name: nm,
        variants: []CEnumVariant{},
        nslots: 1,
        owns: false,
        mod_id: c.named_mod_of(p, at),
        is_pub: c.etpl_pub[ti] != 0,
        origin: c.named_local_of(p, at),
        args: []int{}
    }
    $arg_copy := []int{}
    for i in 0:args.len {
        arg_copy.push(args[i])
    }
    en.args = arg_copy
    $max_payload := 0
    $v := p.nodes[d].a
    while v >= 0 {
        if p.nodes[v].kind != ast.NK_VARIANT_DECL {
            c.clear_subst()
            c.fail_node(p, v, "malformed enum variant")
        }
        $fields := []int{}
        $field_slots := 0
        $ft := p.nodes[v].a
        while ft >= 0 {
            fty := c.type_of(p, ft)
            if is_ref_type(fty) {
                c.clear_subst()
                c.fail_node(p, ft, "enum payload cannot contain references without lifetime tracking")
            }
            slots := c.type_slots(fty)
            // Keep the tag+payload representation bounded even for generated
            // generic instances. Zero-sized temporary/empty structs are
            // valid; every positive contribution must fit before the sum.
            if slots < 0 || slots > MIR_MAX_LAYOUT_WORDS || field_slots > MIR_MAX_LAYOUT_WORDS - slots {
                c.fail_node(p, ft, "enum payload exceeds layout limit")
                c.clear_subst()
                for i in 0:saved_sn.len {
                    c.set_subst_pair(saved_sn[i], saved_st[i])
                }
                << -1
            }
            fields.push(fty)
            field_slots += slots
            if c.type_owning(fty) {
                en.owns = true
            }
            ft = p.nodes[ft].next
        }
        if field_slots >= MIR_MAX_LAYOUT_WORDS {
            c.fail_node(p, v, "enum payload exceeds layout limit")
            c.clear_subst()
            for i in 0:saved_sn.len {
                c.set_subst_pair(saved_sn[i], saved_st[i])
            }
            << -1
        }
        if field_slots > max_payload {
            max_payload = field_slots
        }
        en.variants.push(CEnumVariant{
            name: p.nodes[v].sval,
            fields: fields,
            field_slots: field_slots
        })
        v = p.nodes[v].next
    }
    if max_payload >= MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, at, "enum payload exceeds layout limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    en.nslots = 1 + max_payload
    c.clear_subst()
    for i in 0:saved_sn.len {
        c.set_subst_pair(saved_sn[i], saved_st[i])
    }
    c.enums.push(en)
    << c.enums.len - 1
}

fn (c &Checker) find_fn(name string) int {
    // Unqualified call: resolve in the current module only.
    << c.find_fn_in_mod(name, c.cur_mod)
}

// Name lookup may hit a monomorphized instance; generic calls need the template.
fn (c &Checker) template_for_fn(fi int) int {
    if fi < 0 || c.fns[fi].is_template || c.is_inst[fi] == 0 {
        << fi
    }
    d := c.fndecl[fi]
    for i in 0:c.fns.len {
        if c.fns[i].is_template && c.fndecl[i] == d {
            << i
        }
    }
    << fi
}

// Intern `fn(T,...) R` (M103/M109). Nested `fn` params are allowed.
// Kind/index handles share a metadata resource budget. Report an exhausted
// table once; the first valid handle permits checking to finish while the
// diagnostic prevents code generation. No kind can spill into another kind.
fn (c $&Checker) type_table_full(used int, limit int, kind string, bit int) bool {
    if used < limit { << false }
    if ((c.type_full_mask >> bit) & 1) == 0 {
        c.type_full_mask = c.type_full_mask | (1 << bit)
        c.fail_at(1, 1, "too many " + kind + " types in program (limit " + str(limit) + ")")
    }
    << true
}

fn (c $&Checker) intern_fn_sig(params []int, ret int) int {
    << c.intern_fn_sig_env(params, ret, 0, -1)
}

fn (c $&Checker) intern_fn_sig_env(params []int, ret int, has_env int, env_struct int) int {
    $sb := new_strbuf(32 + params.len * 4)
    sb.write_str(str(has_env))
    sb.write_byte(95)
    sb.write_str(str(env_struct))
    sb.write_byte(95)
    sb.write_str(str(ret))
    for i in 0:params.len {
        sb.write_byte(95)
        sb.write_str(str(params[i]))
    }
    key := sb.finish()
    hit := strmap_get(&c.fn_sig_map, &key)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.fn_sigs.len, TYPE_TABLE_LIMIT, "function signature", 0) { << fn_type(0) }
    $ps := []int{}
    for j in 0:params.len {
        ps.push(params[j])
    }
    c.fn_sigs.push(CFnSig{params: ps, ret: ret, has_env: has_env, env_struct: env_struct})
    id := fn_type(c.fn_sigs.len - 1)
    strmap_put($&c.fn_sig_map, key, id)
    << id
}

// M109: fn types compare params+ret only (has_env is a value-layout property).
fn (c &Checker) same_type(a int, b int) bool {
    if is_fn_type(a) && is_fn_type(b) {
        sa := fn_index(a)
        sb := fn_index(b)
        if sa < 0 || sb < 0 || sa >= c.fn_sigs.len || sb >= c.fn_sigs.len {
            << false
        }
        if c.fn_sigs[sa].ret != c.fn_sigs[sb].ret {
            << false
        }
        if c.fn_sigs[sa].params.len != c.fn_sigs[sb].params.len {
            << false
        }
        for i in 0:c.fn_sigs[sa].params.len {
            if c.fn_sigs[sa].params[i] != c.fn_sigs[sb].params[i] {
                << false
            }
        }
        << true
    }
    << a == b
}

fn (c $&Checker) coerce_to(p &parser.Parser, n int, got int, want int) int {
    if is_error_type(got) || is_error_type(want) {
        << ERROR_TY
    }
    if is_fn_type(got) && is_fn_type(want) && (c.closure_owns_resource(got) || c.closure_owns_resource(want)) {
        if c.fn_sigs[fn_index(got)].env_struct != c.fn_sigs[fn_index(want)].env_struct {
            c.fail_node(p, n, "cannot erase a resource-owning closure environment")
            << ERROR_TY
        }
    }
    if is_fn_type(got) && is_fn_type(want) && (c.type_contains_ref(got) || c.type_contains_ref(want)) {
        if c.fn_sigs[fn_index(got)].env_struct != c.fn_sigs[fn_index(want)].env_struct {
            c.fail_node(p, n, "cannot erase a borrowed closure environment")
            << ERROR_TY
        }
    }
    if c.same_type(got, want) { << got }
    // Spec34 B: only an identical direct pointee and a local reference name
    // can acquire a shared view. Keep the source permission separately; all
    // loan consumers must treat this adjustment exactly like explicit &*r.
    if is_mut_ref_type(got) && is_ref_type(want) && !is_mut_ref_type(want) {
        if c.same_type(c.ref_inner_type(got), c.ref_inner_type(want)) {
            if p.nodes[n].kind != ast.NK_IDENT || c.nlocal[n] < 0 {
                c.fail_node(p, n, "implicit shared reborrow requires a local reference name\nhelp: bind the reference to a local first, if moving it is allowed")
                << ERROR_TY
            }
            checker_set_i($&c.nshared, n, got)
            checker_set_i($&c.ntype, n, want)
            << want
        }
    }
    // Spec34 C / E21b: only Borrow(Deref(local)) takes its write permission
    // from an explicit expectation. Never upgrade a shared source reference.
    if is_mut_ref_type(want) && is_ref_type(got) && !is_mut_ref_type(got) && p.nodes[n].kind == ast.NK_BORROW && p.nodes[n].ival == 0 {
        target := p.nodes[n].a
        if p.nodes[target].kind == ast.NK_UN_OP && p.nodes[target].ival == 3 {
            inner := p.nodes[target].a
            if p.nodes[inner].kind == ast.NK_IDENT && c.same_type(c.ntype[inner], want) {
                checker_set_i($&c.nshared, n, -2)
                checker_set_i($&c.ntype, n, want)
                << want
            }
        }
    }
    // D16/F25: an ordinary place acquires a shared loan only under a known
    // identical direct-pointee expectation. Inference never enters this path.
    if !is_ref_type(got) && is_ref_type(want) && !is_mut_ref_type(want) && c.same_type(got, c.ref_inner_type(want)) {
        k := p.nodes[n].kind
        $root := c.borrow_root_local(p, n)
        deref := k == ast.NK_UN_OP && p.nodes[n].ival == 3
        if deref {
            inner := p.nodes[n].a
            if p.nodes[inner].kind != ast.NK_IDENT {
                c.fail_node(p, n, c.reborrow_place_error())
                << ERROR_TY
            }
            root = c.nlocal[inner]
        }
        if (k != ast.NK_IDENT && k != ast.NK_FIELD && k != ast.NK_INDEX && !deref) || root < 0 {
            c.fail_node(p, n, "automatic read-only borrow requires an ordinary place with a local root\nhelp: bind the value to a local first")
            << ERROR_TY
        }
        rt := c.check_borrow_target(p, n, n, false, got)
        checker_set_i($&c.nshared, n, -1)
        // Borrowing a string/index place must not retain a value-read clone.
        checker_set_i($&c.nclone, n, 0)
        << rt
    }
    if is_integer_type(want) && got == 1 && c.is_const_int_expr(p, n) {
        checker_set_i($&c.ntype, n, want)
        << want
    }
    // MS5: expected temp / dynamic struct@ — same box lowering as typed let.
    // Keep concrete ntype (tag / struct id). nbox holds the expected fat type
    // so MIR can wrap without overwriting a Call's ncall.
    if is_temp_type(want) || is_any_type(want) {
        if is_dynamic_box(got) {
            // Same fat layout: retype between temp/any/iface.
            << want
        }
        if !can_box_into_temp(got) || temp_box_type_id(got) < 0 || c.type_contains_ref(got) {
            $dest_name := "temp"
            if is_any_type(want) { dest_name = "any" }
            c.fail_node(p, n, "cannot box " + c.ty_display(got) + " into " + dest_name)
            << ERROR_TY
        }
        checker_set_i($&c.nbox, n, want)
        if c.ncall[n] == -1 {
            checker_set_i($&c.ncall, n, -98)
        }
        << want
    }
    if is_interface_type(want) {
        ii := interface_index(want)
        if !is_struct_type(got) {
            c.fail_node(p, n, "cannot box " + c.ty_display(got) + " into " + c.iface_names[ii] + " (only structs)")
            << ERROR_TY
        }
        if c.type_contains_ref(got) {
            c.fail_node(p, n, "cannot box " + c.ty_display(got) + " into " + c.iface_names[ii] + " (contains a reference)")
            << ERROR_TY
        }
        if !c.check_interface_box_contract(p, got, ii, n) { << ERROR_TY }
        checker_set_i($&c.nbox, n, want)
        if c.ncall[n] == -1 {
            checker_set_i($&c.ncall, n, -93)
        }
        << want
    }
    << got
}

// Type annotation node -> type tag. Respects active type-param substitution.
fn (c $&Checker) type_of(p &parser.Parser, t int) int {
    k := p.nodes[t].kind
    if k == ast.NT_INT {
        if p.nodes[t].ival == 1 { << 8 }
        if p.nodes[t].ival == 2 { << 9 }
        if p.nodes[t].ival == 3 { << 10 }
        << 1
    }
    if k == ast.NT_BOOL { << 2 }
    if k == ast.NT_STR { << 3 }
    if k == ast.NT_F64 { << 4 } // f64
    if k == ast.NT_SELF { << 5 } // Self (M102)
    if k == ast.NT_TEMP { << TEMP_TY } // nt_temp (M200)
    if k == ast.NT_ANY { << ANY_TY } // nt_any — keep box across `as`
    if k == ast.NT_NAMED { // TNamed: type param, plain struct, or generic instance
        // Type parameter of the current generic definition?
        if p.nodes[t].a < 0 {
            su := c.subst_lookup(p.nodes[t].sval)
            if su >= 0 {
                << su
            }
        }
        // Qualified `mod.Name`: require import (same rule as module calls).
        if c.named_mod_of(p, t) != c.cur_mod {
            if !c.module_visible(c.named_mod_of(p, t)) {
                c.fail_node(p, t, "module " + c.named_mod_of(p, t) + " not imported")
                << ERROR_TY
            }
        }
        // Generic struct/enum with type arguments.
        if p.nodes[t].a >= 0 {
            c.collect_type_list_n(p, p.nodes[t].a)
            if c.find_stpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
                si := c.instantiate_struct(p, t)
                << struct_type(si)
            }
            if c.find_etpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
                ei := c.instantiate_enum(p, t)
                << enum_type(ei)
            }
            c.fail_node(p, t, "'" + p.nodes[t].sval + "' is not a generic type")
            << -1
        }
        // Built-in FileInfo struct (M35), available unqualified in any module.
        if c.named_local_of(p, t) == "FileInfo" {
            << c.intern_file_info_type()
        }
        if p.nodes[t].a < 0 && c.named_local_of(p, t) == "temp" && c.named_mod_of(p, t) == c.cur_mod {
            << TEMP_TY
        }
        if p.nodes[t].a < 0 && c.named_local_of(p, t) == "any" && c.named_mod_of(p, t) == c.cur_mod {
            << ANY_TY
        }
        si := c.find_struct_in_mod(c.named_local_of(p, t), c.named_mod_of(p, t))
        if si >= 0 {
            if c.named_mod_of(p, t) != c.cur_mod && !c.structs[si].is_pub {
                c.fail_node(p, t, "'" + c.named_local_of(p, t) + "' is private")
            }
                << struct_type(si)
        }
        ei := c.find_enum_in_mod(c.named_local_of(p, t), c.named_mod_of(p, t))
        if ei >= 0 {
            if c.named_mod_of(p, t) != c.cur_mod && !c.enums[ei].is_pub {
                c.fail_node(p, t, "'" + c.named_local_of(p, t) + "' is private")
            }
            << enum_type(ei)
        }
        if c.find_stpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
            c.fail_node(p, t, "generic struct '" + p.nodes[t].sval + "' requires type arguments")
            << -1
        }
        if c.find_etpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
            c.fail_node(p, t, "generic enum '" + p.nodes[t].sval + "' requires type arguments")
            << -1
        }
        if c.find_iface_global(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
            ii := c.find_iface_global(c.named_local_of(p, t), c.named_mod_of(p, t))
            << interface_type(ii)
        }
        c.fail_node(p, t, "unknown type '" + p.nodes[t].sval + "'")
        << ERROR_TY
    }
    if k == ast.NT_ARRAY { // TArray(elem) — ival>0 → [N]T
        ety := c.type_of(p, p.nodes[t].a)
        << c.intern_array_type_n(ety, p.nodes[t].ival)
    }
    if k == ast.NT_CHAN { // TChan(elem) M17
        ety := c.type_of(p, p.nodes[t].a)
        if !c.type_is_send(ety) {
            c.fail_node(p, t, "channel element type cannot be a reference")
        }
        << c.intern_chan_type(ety)
    }
    if k == ast.NT_MAP { // TMap(key, val) L-C
        kty := c.type_of(p, p.nodes[t].a)
        vty := c.type_of(p, p.nodes[t].b)
        << c.intern_map_type(p, t, kty, vty)
    }
    if k == ast.NT_REF { // TRef(mutable, inner)
        mutable := p.nodes[t].ival == 1
        ity := c.type_of(p, p.nodes[t].a)
        if is_dynamic_box(ity) {
            c.fail_node(p, t, "cannot borrow a value of type " + c.ty_display(ity))
        }
        // M166: one nesting level via make_ref_type.
        rty := c.make_ref_type(mutable, ity)
        if rty < 0 {
            c.fail_node(p, t, "cannot borrow a value of type " + c.ty_display(ity))
        }
        << rty
    }
    if k == ast.NT_FN { // TFn(params..., ret) M103
        $params := []int{}
        $prm := p.nodes[t].a
        while prm >= 0 {
        params.push(c.type_of(p, prm))
        prm = p.nodes[prm].next
        }
        $ret := 0
        if p.nodes[t].b >= 0 {
            ret = c.type_of(p, p.nodes[t].b)
        }
        << c.intern_fn_sig(params, ret)
    }
    c.fail_node(p, t, "type not supported yet (M6b2-s3a/s3c: int/bool/string/struct)")
    << -1
}

// Total slot count a value of the given type tag occupies (Checker-aware for structs).
fn (c &Checker) type_slots(ty int) int {
    if ty == 3 { << 3 }
    if is_ref_type(ty) { << 1 }
    if is_param_type(ty) { << 1 }
    if is_throw_type(ty) {
        // Throw slot: tag (int, 1 slot) + payload of max(ok, err).
        ri := throw_index(ty)
        if ri >= 0 && ri < c.throws.len {
            ok_s := c.type_slots(c.throws[ri].ok_ty)
            er_s := c.type_slots(c.throws[ri].err_ty)
            $payload := er_s
            if ok_s > payload { payload = ok_s }
            // Keep the checker in lock-step with Mir.type_slots: malformed
            // child layouts must not wrap the tag+payload addition.
            if payload <= 0 || payload >= MIR_MAX_LAYOUT_WORDS { << 0 }
            << 1 + payload
        }
        << 1
    }
    if is_enum_type(ty) {
        ei := enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            ns := c.enums[ei].nslots
            if ns <= 0 || ns > MIR_MAX_LAYOUT_WORDS { << 0 }
            << ns
        }
        << 1
    }
    if is_array_type(ty) {
        ai := array_index(ty)
        if ai < 0 || ai >= c.arrays.len { << 0 }
        fl := c.array_fixed_len(ty)
        if fl < 0 { << 0 }
        if fl > 0 {
            es := c.type_slots(c.arrays[ai].elem_ty)
            if es <= 0 || es > MIR_MAX_LAYOUT_WORDS || fl > MIR_MAX_LAYOUT_WORDS { << 0 }
            // Both factors are bounded positive i64 values, so this product
            // check cannot overflow and malformed fixed arrays fail closed.
            if fl * es > MIR_MAX_LAYOUT_WORDS { << 0 }
            << fl * es
        }
        << 3
    }
    if is_chan_type(ty) { << 1 }
    if is_map_type(ty) { << 1 }
    if is_fn_type(ty) { << 2 }
    if is_temp_type(ty) { << 2 }
    if is_any_type(ty) { << 2 }
    if is_interface_type(ty) { << 2 }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < c.structs.len {
            ns := c.structs[si].nslots
            if ns < 0 || ns > MIR_MAX_LAYOUT_WORDS { << 0 }
            << ns
        }
    }
    << 1
}

// All language layouts use power-of-two alignment.  Keep the remainder
// calculation division-free: the checker intentionally treats alignment as
// untrusted metadata, and a path-insensitive divide/modulo warning here would
// otherwise obscure a real malformed-layout failure.
fn align_remainder_bytes(off int, align int) int {
    if align == 1 { << 0 }
    if align <= 1 || align > MIR_MAX_LAYOUT_BYTES { << -1 }
    if (align & (align - 1)) != 0 { << -1 }
    << off & (align - 1)
}

pub fn align_up_bytes(off int, align int) int {
    // Layout arithmetic is fed by generated/checker metadata as well as
    // source declarations.  Bound both operands before adding the rounding
    // delta so neither `off + align - 1` nor the final rounded offset wraps.
    if off < 0 || off > MIR_MAX_LAYOUT_BYTES { << 0 }
    if align == 1 { << off }
    rem := align_remainder_bytes(off, align)
    if rem < 0 { << 0 }
    if rem == 0 { << off }
    delta := align - rem
    if delta <= 0 || off > MIR_MAX_LAYOUT_BYTES - delta { << 0 }
    << off + delta
}

pub fn (c &Checker) type_size_bytes(ty int) int {
    if ty == 10 { << 1 }
    if ty == 8 || ty == 9 { << 4 }
    if ty == 0 { << 0 }
    if ty == 3 { << 24 }
    if is_array_type(ty) {
        ai := array_index(ty)
        if ai < 0 || ai >= c.arrays.len { << 0 }
        fl := c.array_fixed_len(ty)
        if fl < 0 { << 0 }
        if fl > 0 {
            eb := c.arrays[ai].elem_bytes
            if eb <= 0 || eb > MIR_MAX_LAYOUT_BYTES || fl > MIR_MAX_LAYOUT_BYTES { << 0 }
            // Guard the fixed-length product before multiplying; dynamic
            // arrays intentionally keep their descriptor-size path below.
            if fl * eb > MIR_MAX_LAYOUT_BYTES { << 0 }
            << fl * eb
        }
        << 24
    }
    if is_fn_type(ty) { << 16 }
    if is_temp_type(ty) { << 16 }
    if is_any_type(ty) { << 16 }
    if is_interface_type(ty) { << 16 }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < c.structs.len {
            bytes := c.structs[si].size_bytes
            if bytes < 0 || bytes > MIR_MAX_LAYOUT_BYTES { << 0 }
            << bytes
        }
    }
    if is_throw_type(ty) {
        ns := c.type_slots(ty)
        if ns <= 0 || ns > MIR_MAX_LAYOUT_BYTES / 8 { << 0 }
        << ns * 8
    }
    if is_enum_type(ty) {
        ns := c.type_slots(ty)
        if ns <= 0 || ns > MIR_MAX_LAYOUT_BYTES / 8 { << 0 }
        << ns * 8
    }
    << 8
}

pub fn (c &Checker) type_align_bytes(ty int) int {
    if ty == 10 { << 1 }
    if ty == 8 || ty == 9 { << 4 }
    if ty == 0 { << 1 }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < c.structs.len {
            al := c.structs[si].align_bytes
            if al < 1 { << 1 }
            << al
        }
    }
    << 8
}

fn (c &Checker) type_owning(ty int) bool {
    if ty == 3 { << true }
    if is_ref_type(ty) { << false }
    if is_temp_type(ty) { << true }
    if is_any_type(ty) { << true }
    if is_interface_type(ty) { << true }
    if is_fn_type(ty) {
        si := fn_index(ty)
        if si >= 0 && si < c.fn_sigs.len {
            << c.fn_sigs[si].has_env == 1
        }
        << false
    }
    if is_param_type(ty) { << false }
    if is_throw_type(ty) {
        ri := throw_index(ty)
        if ri >= 0 && ri < c.throws.len {
            << c.type_owning(c.throws[ri].ok_ty) || c.type_owning(c.throws[ri].err_ty)
        }
        << false
    }
    if is_enum_type(ty) {
        ei := enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            << c.enums[ei].owns
        }
        << false
    }
    if is_array_type(ty) {
        fl := c.array_fixed_len(ty)
        if fl > 0 {
            ai := array_index(ty)
            << c.type_owning(c.arrays[ai].elem_ty)
        }
        << true
    }
    if is_map_type(ty) { << true }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < c.structs.len {
            if c.structs[si].drop_label.len > 0 { << true }
            for i in 0:c.structs[si].fields.len {
                if c.type_owning(c.structs[si].fields[i].ty) { << true }
            }
        }
    }
    << false
}

// Owning values and exclusive references are linear on binding transfer
// (let / assign / << / xu / send). Sync Call/Method `$&` args reborrow
// (M107) — see `arg_pass`. Shared references copy. Type parameters move
// conservatively at the definition site (bootstrap).
fn (c &Checker) type_moves(ty int) bool {
    << c.type_owning(ty) || is_mut_ref_type(ty) || is_param_type(ty)
}

// M107: sync Call/Method argument. Exclusive-ref formal + actual → reborrow
// (no note_move). Otherwise same as move_of.
fn (c $&Checker) arg_pass(p &parser.Parser, n int, aty int, want int) {
    if is_mut_ref_type(want) && is_mut_ref_type(aty) {
        <<
    }
    c.move_of(p, n, aty, false)
}

fn (c &Checker) find_struct(name string) int {
    << c.find_struct_in_mod(name, c.cur_mod)
}

fn (c &Checker) find_field(si int, name string) int {
    for i in 0:c.structs[si].fields.len {
        if c.structs[si].fields[i].name == name {
            << i
        }
    }
    << -1
}

// §4.5: cross-module field access requires `pub` on the field.
fn (c $&Checker) require_field_visible(p &parser.Parser, n int, si int, fi int) {
    if c.structs[si].mod_id != c.cur_mod && !c.structs[si].fields[fi].is_pub {
        c.fail_node(p, n, "field '" + c.structs[si].fields[fi].name + "' is private")
    }
}

fn (c $&Checker) intern_array_type(elem_ty int) int {
    << c.intern_array_type_n(elem_ty, 0)
}

fn (c $&Checker) intern_array_type_n(elem_ty int, fixed_len int) int {
    // Parser paths normally enforce a positive fixed length, but generic and
    // generated paths can reach this helper directly.  Reject malformed
    // lengths before constructing a map key or growing the type table.
    if fixed_len < 0 || fixed_len > MIR_MAX_LAYOUT_WORDS { << 0 }
    eb := c.type_size_bytes(elem_ty)
    // Dynamic arrays carry a descriptor and can be interned while a
    // cross-module struct is still being laid out (its size is temporarily
    // zero).  Keep that established ordering; only a fixed array needs the
    // element-size product below.  Negative/oversized metadata is malformed
    // in either case.
    if eb < 0 || eb > MIR_MAX_LAYOUT_BYTES { << 0 }
    if fixed_len > 0 {
        if eb <= 0 { << 0 }
        if fixed_len > MIR_MAX_LAYOUT_BYTES || fixed_len * eb > MIR_MAX_LAYOUT_BYTES { << 0 }
    }
    k := str(elem_ty) + ":" + str(fixed_len)
    hit := strmap_get(&c.array_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.arrays.len, TYPE_TABLE_LIMIT, "array", 1) { << array_type(0) }
    c.arrays.push(CArray{elem_ty: elem_ty, elem_bytes: eb, fixed_len: fixed_len})
    id := array_type(c.arrays.len - 1)
    strmap_put($&c.array_map, k, id)
    << id
}

fn (c $&Checker) intern_chan_type(elem_ty int) int {
    k := str(elem_ty)
    hit := strmap_get(&c.chan_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.chans.len, TYPE_TABLE_LIMIT, "channel", 2) { << chan_type(0) }
    es := c.type_slots(elem_ty)
    c.chans.push(CChan{elem_ty: elem_ty, elem_slots: es})
    id := chan_type(c.chans.len - 1)
    strmap_put($&c.chan_map, k, id)
    << id
}

fn (c &Checker) is_maps_table(ty int) bool {
    if !is_struct_type(ty) {
        << false
    }
    si := struct_index(ty)
    if c.structs[si].mod_id != "maps" {
        << false
    }
    n := c.structs[si].name
    << n == "StrInt" || n == "StrStr"
}

fn (c &Checker) maps_val_ty(ty int) int {
    if c.structs[struct_index(ty)].name == "StrInt" {
        << 1
    }
    << 3
}

fn (c &Checker) find_maps_free(name string) int {
    for i in 0:c.fns.len {
        if c.fns[i].mod_id == "maps" && c.fns[i].name == name && c.fns[i].recv < 0 {
            << i
        }
    }
    << -1
}

fn (c $&Checker) intern_map_type(p &parser.Parser, n int, kty int, vty int) int {
    $kkind := -1
    if kty == 1 { kkind = 0 }
    if kty == 3 { kkind = 1 }
    if kkind < 0 {
        c.fail_node(p, n, "map key type must be int or string")
        << 0
    }
    if is_ref_type(vty) {
        c.fail_node(p, n, "map value type cannot be a reference")
        << 0
    }
    nslots := c.slots_of(p, vty, n)
    if nslots <= 0 || nslots > 255 {
        c.fail_node(p, n, "map value type is too large")
        << 0
    }
    $vkind := 2
    if vty == 3 {
        vkind = 1
    } else if !c.type_owning(vty) && nslots == 1 {
        vkind = 0
    }
    k := str(kty) + "," + str(vty)
    hit := strmap_get(&c.map_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.maps.len, TYPE_TABLE_LIMIT, "map", 3) { << map_type(0) }
    c.maps.push(CMap{key_ty: kty, val_ty: vty, kkind: kkind, vkind: vkind, vslots: nslots})
    id := map_type(c.maps.len - 1)
    strmap_put($&c.map_map, k, id)
    << id
}

// m37: minimum number of positionally-checked arguments a call must supply
// (fixed params; a trailing variadic param is optional).
fn (c &Checker) fn_min_arity(fi int) int {
    if fi < 0 { << 0 }
    if c.fns[fi].variadic { << c.fns[fi].params.len - 1 }
    << c.fns[fi].params.len
}

// m37: element type of the trailing variadic array param, or -1 when absent.
fn (c &Checker) fn_variadic_elem(fi int) int {
    if fi < 0 || !c.fns[fi].variadic { << -1 }
    aty := c.fns[fi].params[c.fns[fi].params.len - 1]
    << c.arrays[array_index(aty)].elem_ty
}

// m37: true when call argument index `ai` is consumed (moved) by the call.
// Variadic extras move into the packed array (array-literal element rule).
fn (c &Checker) call_arg_moves(fi int, ai int) bool {
    if fi < 0 { << false }
    if c.fns[fi].variadic {
        fixed := c.fns[fi].params.len - 1
        if ai >= fixed { << true }
        << c.type_owning(c.fns[fi].params[ai])
    }
    if ai >= c.fns[fi].params.len { << false }
    << c.type_owning(c.fns[fi].params[ai])
}

fn (c $&Checker) intern_throw_type(ok_ty int, err_ty int) int {
    k := str(ok_ty) + "_" + str(err_ty)
    hit := strmap_get(&c.throw_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.throws.len, TYPE_TABLE_LIMIT, "result", 4) { << throw_type(0) }
    c.throws.push(CThrow{ok_ty: ok_ty, err_ty: err_ty})
    id := throw_type(c.throws.len - 1)
    strmap_put($&c.throw_map, k, id)
    << id
}

// Built-in `FileInfo` struct (M35): { size int, is_dir bool, mode int }.
// Registered on first use so an unused builtin never perturbs the struct
// index space that the emitter's per-type drop helpers walk.
fn (c $&Checker) intern_file_info_type() int {
    for i in 0:c.structs.len {
        if c.structs[i].name == "FileInfo" && c.structs[i].mod_id == "" && c.structs[i].origin == "" {
            << struct_type(i)
        }
    }
    $fi := CStruct{
        name: "FileInfo",
        fields: []CField{},
        nslots: 0,
        size_bytes: 0,
        align_bytes: 1,
        mod_id: "",
        is_pub: true,
        origin: "",
        drop_label: ""
    }
    fi.fields.push(CField{name: "size", ty: 1, slot: 0, life: "", is_pub: true})
    fi.fields.push(CField{name: "is_dir", ty: 2, slot: 8, life: "", is_pub: true})
    fi.fields.push(CField{name: "mode", ty: 1, slot: 16, life: "", is_pub: true})
    fi.nslots = 3
    fi.size_bytes = 24
    fi.align_bytes = 8
    if c.type_table_full(c.structs.len, TYPE_TABLE_LIMIT, "struct", 5) { << -1 }
    c.structs.push(fi)
    c.note_st_index()
    c.sargs.push([]int{})
    c.sdecl.push(-1)
    c.slaid.push(1)
    c.sdoing.push(0)
    << struct_type(c.structs.len - 1)
}

// Method lookup: exact recv type, or by template origin name for instances.
