@xu/types

#xu/ast
#xu/parser

fn (c &mut Checker) check_call_hosted_env(p &parser.Parser, n int, name string) int {
    if name == "env_get" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "env_get is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "env_get takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 { c.fail_node(p, arg, "env_get expects string") }
        checker_set_i(mut &c.ncall, n, -47)
        checker_set_i(mut &c.ntype, n, 3)
        << 3
    }
    if name == "env_list" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "env_list is not available on freestanding targets")
        }
        if p.nodes[n].a >= 0 { c.fail_node(p, n, "env_list takes no arguments") }
        checker_set_i(mut &c.ncall, n, -48)
        si20 := c.intern_array_type(3)
        checker_set_i(mut &c.ntype, n, si20)
        << c.ntype[n]
    }
    << -1
}

fn (c &mut Checker) check_call_sys_setsockopt_timeo(p &parser.Parser, n int, name string) int {
    if c.freestanding == 1 {
        c.fail_node(p, n, name + " is not available on freestanding targets")
    }
    a1 := p.nodes[n].a
    if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
        c.fail_node(p, n, name + " takes exactly 2 arguments")
    }
    a2 := p.nodes[a1].next
    if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int") }
    if c.check_expr(p, a2) != 1 { c.fail_node(p, a2, name + " expects int") }
    << c.wrap_throwable_hosted_builtin(p, n, 1, -109)
}

// Wave C: hosted os_* — split from check_call_hosted (W3).
fn (c &mut Checker) check_call_hosted_os(p &parser.Parser, n int, name string) int {
    // M35: os 运行时内建（hosted only）。The os package wrappers are the
    // Go-shaped `stat`/`mkdir`/`rename`/`remove`, so the builtins use the
    // distinct `os_*` names (M28 lesson: tmp_dir/host_name); naming a
    // builtin after the Go name would shadow the wrapper and recurse.
    if name == "os_stat" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, c.intern_file_info_type(), -50)
    }
    if name == "os_mkdir" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -51)
    }
    if name == "os_rename" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 3 || c.check_expr(p, a2) != 3 {
            c.fail_node(p, n, name + " expects string arguments")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -52)
    }
    if name == "os_remove" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -53)
    }
    if name == "os_open" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 3 {
            c.fail_node(p, a1, name + " expects string")
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, name + " expects int")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -64)
    }
    if name == "os_fd_read" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 1 || c.check_expr(p, a2) != 1 {
            c.fail_node(p, n, name + " expects int arguments")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 3, -65)
    }
    if name == "os_fd_write" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 1 {
            c.fail_node(p, a1, name + " expects int")
        }
        if c.check_expr(p, a2) != 3 {
            c.fail_node(p, a2, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -66)
    }
    if name == "os_fd_close" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, name + " expects int")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -67)
    }
    if name == "os_chmod" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 3 {
            c.fail_node(p, a1, name + " expects string")
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, name + " expects int")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -111)
    }
    if name == "os_chdir" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -112)
    }
    if name == "os_symlink" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 3 || c.check_expr(p, a2) != 3 {
            c.fail_node(p, n, name + " expects string arguments")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -113)
    }
    if name == "os_readlink" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 3, -114)
    }
    if name == "os_fd_seek" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 {
            c.fail_node(p, n, name + " takes exactly 3 arguments")
        }
        a2 := p.nodes[a1].next
        if p.nodes[a2].next < 0 || p.nodes[p.nodes[a2].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 3 arguments")
        }
        a3 := p.nodes[a2].next
        if c.check_expr(p, a1) != 1 || c.check_expr(p, a2) != 1 || c.check_expr(p, a3) != 1 {
            c.fail_node(p, n, name + " expects int arguments")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -115)
    }
    if name == "os_pipe" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        if p.nodes[n].a >= 0 {
            c.fail_node(p, n, name + " takes no arguments")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -116)
    }
    // M183: os_system(cmd) → int (macOS system(3); else 127).
    if name == "os_system" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "os_system is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "os_system takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, "os_system expects string")
        }
        checker_set_i(mut &c.ncall, n, -22)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "os_exec" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "os_exec is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 {
            c.fail_node(p, n, "os_exec takes exactly 3 arguments")
        }
        a2 := p.nodes[a1].next
        if p.nodes[a2].next < 0 || p.nodes[p.nodes[a2].next].next >= 0 {
            c.fail_node(p, n, "os_exec takes exactly 3 arguments")
        }
        a3 := p.nodes[a2].next
        if c.check_expr(p, a1) != 3 || c.check_expr(p, a2) != 3 || c.check_expr(p, a3) != 3 {
            c.fail_node(p, n, "os_exec expects string arguments")
        }
        checker_set_i(mut &c.ncall, n, -117)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    // Minimal hosted random-fill ABI. The core only exposes platform bytes;
    // callers own selection and higher-level policy.
    if name == "sys_random_fill" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "sys_random_fill is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "sys_random_fill takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, "sys_random_fill expects int")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 3, -118)
    }
    if name == "ui_host_run" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "ui_host_run is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "ui_host_run takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, "ui_host_run expects string")
        }
        checker_set_i(mut &c.ncall, n, -102)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    << -1
}

fn (c &mut Checker) check_call_hosted_os_sys(p &parser.Parser, n int, name string) int {
    // Opaque platform security-store entries. The hosted ABI returns a
    // length-framed byte string; certificate parsing and policy are stdlib.
    if name == "sys_security_store" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 3, -128)
    }
    if name == "sys_socket_poll" {
        if c.freestanding == 1 { c.fail_node(p, n, name + " is not available on freestanding targets") }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int fd") }
        if c.check_expr(p, a2) != 1 { c.fail_node(p, a2, name + " expects int events") }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -130)
    }
    if name == "sys_interface_data" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 3, -126)
    }
    if name == "sys_socket" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next < 0 || p.nodes[p.nodes[p.nodes[a1].next].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 3 arguments")
        }
        a2 := p.nodes[a1].next
        a3 := p.nodes[a2].next
        if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int") }
        if c.check_expr(p, a2) != 1 { c.fail_node(p, a2, name + " expects int") }
        if c.check_expr(p, a3) != 1 { c.fail_node(p, a3, name + " expects int") }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -29)
    }
    if name == "sys_bind4" || name == "sys_connect4" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 { c.fail_node(p, n, name + " takes exactly 6 arguments") }
        a2 := p.nodes[a1].next
        if a2 < 0 { c.fail_node(p, n, name + " takes exactly 6 arguments") }
        a3 := p.nodes[a2].next
        if a3 < 0 { c.fail_node(p, n, name + " takes exactly 6 arguments") }
        a4 := p.nodes[a3].next
        if a4 < 0 { c.fail_node(p, n, name + " takes exactly 6 arguments") }
        a5 := p.nodes[a4].next
        if a5 < 0 { c.fail_node(p, n, name + " takes exactly 6 arguments") }
        a6 := p.nodes[a5].next
        if a6 < 0 || p.nodes[a6].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 6 arguments")
        }
        if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int") }
        if c.check_expr(p, a2) != 1 { c.fail_node(p, a2, name + " expects int") }
        if c.check_expr(p, a3) != 1 { c.fail_node(p, a3, name + " expects int") }
        if c.check_expr(p, a4) != 1 { c.fail_node(p, a4, name + " expects int") }
        if c.check_expr(p, a5) != 1 { c.fail_node(p, a5, name + " expects int") }
        if c.check_expr(p, a6) != 1 { c.fail_node(p, a6, name + " expects int") }
        if name == "sys_bind4" {
            << c.wrap_throwable_hosted_builtin(p, n, 1, -100)
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -58)
    }
    if name == "sys_bind6" || name == "sys_connect6" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 { c.fail_node(p, n, name + " takes exactly 3 arguments") }
        a2 := p.nodes[a1].next
        if a2 < 0 { c.fail_node(p, n, name + " takes exactly 3 arguments") }
        a3 := p.nodes[a2].next
        if a3 < 0 || p.nodes[a3].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 3 arguments")
        }
        if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int fd") }
        if c.check_expr(p, a2) != 3 { c.fail_node(p, a2, name + " expects string IPv6 address") }
        if c.check_expr(p, a3) != 1 { c.fail_node(p, a3, name + " expects int port") }
        if name == "sys_bind6" {
            << c.wrap_throwable_hosted_builtin(p, n, 1, -122)
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -123)
    }
    if name == "sys_bind_unix" || name == "sys_connect_unix" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 { c.fail_node(p, n, name + " takes exactly 2 arguments") }
        a2 := p.nodes[a1].next
        if a2 < 0 || p.nodes[a2].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int fd") }
        if c.check_expr(p, a2) != 3 { c.fail_node(p, a2, name + " expects string path") }
        if name == "sys_bind_unix" {
            << c.wrap_throwable_hosted_builtin(p, n, 1, -124)
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -125)
    }
    if name == "sys_listen" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int") }
        if c.check_expr(p, a2) != 1 { c.fail_node(p, a2, name + " expects int") }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -82)
    }
    if name == "sys_setsockopt_timeo" {
        << c.check_call_sys_setsockopt_timeo(p, n, name)
    }
    if name == "sys_accept" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, name + " expects int")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -60)
    }
    if name == "sys_sendto" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next < 0 || p.nodes[p.nodes[p.nodes[a1].next].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 3 arguments")
        }
        a2 := p.nodes[a1].next
        a3 := p.nodes[a2].next
        if c.check_expr(p, a1) != 1 {
            c.fail_node(p, a1, name + " expects int")
        }
        if c.check_expr(p, a2) != 3 {
            c.fail_node(p, a2, name + " expects string")
        }
        if c.check_expr(p, a3) != 3 {
            c.fail_node(p, a3, name + " expects string")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -79)
    }
    if name == "sys_recvfrom" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 1 {
            c.fail_node(p, a1, name + " expects int")
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, name + " expects int")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 3, -81)
    }
    if name == "sys_socket_read" || name == "sys_socket_write" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 1 {
            c.fail_node(p, a1, name + " expects int fd")
        }
        if name == "sys_socket_read" {
            if c.check_expr(p, a2) != 1 {
                c.fail_node(p, a2, name + " expects int max")
            }
            << c.wrap_throwable_hosted_builtin(p, n, 3, -63)
        }
        if c.check_expr(p, a2) != 3 {
            c.fail_node(p, a2, name + " expects string data")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -62)
    }
    if name == "sys_socket_close" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, name + " expects int fd")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -61)
    }
    if name == "sys_socket_wait" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        mut a2 := -1
        mut a3 := -1
        mut a4 := -1
        if a1 >= 0 { a2 = p.nodes[a1].next }
        if a2 >= 0 { a3 = p.nodes[a2].next }
        if a3 >= 0 { a4 = p.nodes[a3].next }
        if a1 < 0 || a2 < 0 || a3 < 0 || a4 >= 0 {
            c.fail_node(p, n, name + " takes exactly 3 arguments")
        }
        if c.check_expr(p, a1) != 1 { c.fail_node(p, a1, name + " expects int fd") }
        if c.check_expr(p, a2) != 1 { c.fail_node(p, a2, name + " expects int events") }
        if c.check_expr(p, a3) != 1 { c.fail_node(p, a3, name + " expects int timeout_ns") }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -131)
    }
    << -1
}

// Wave C: hosted atomic_* — split from check_call_hosted (W3).
fn (c &mut Checker) check_call_hosted_atomic(p &parser.Parser, n int, name string) int {
    // M35: sync/atomic 内建（hosted；地址经 mut &x）。
    if name == "atomic_load" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "atomic_load is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "atomic_load takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != c.make_ref_type(true, 1) {
            c.fail_node(p, arg, "atomic_load expects mut &int")
        }
        checker_set_i(mut &c.ncall, n, -54)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "atomic_store" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "atomic_store is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, "atomic_store takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != c.make_ref_type(true, 1) {
            c.fail_node(p, a1, "atomic_store expects mut &int")
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, "atomic_store expects int")
        }
        checker_set_i(mut &c.ncall, n, -55)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    if name == "atomic_add" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "atomic_add is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, "atomic_add takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != c.make_ref_type(true, 1) {
            c.fail_node(p, a1, "atomic_add expects mut &int")
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, "atomic_add expects int")
        }
        checker_set_i(mut &c.ncall, n, -56)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "atomic_cas" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "atomic_cas is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next < 0 || p.nodes[p.nodes[p.nodes[a1].next].next].next >= 0 {
            c.fail_node(p, n, "atomic_cas takes exactly 3 arguments")
        }
        a2 := p.nodes[a1].next
        a3 := p.nodes[a2].next
        if c.check_expr(p, a1) != c.make_ref_type(true, 1) {
            c.fail_node(p, a1, "atomic_cas expects mut &int")
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, "atomic_cas expects int")
        }
        if c.check_expr(p, a3) != 1 {
            c.fail_node(p, a3, "atomic_cas expects int")
        }
        checker_set_i(mut &c.ncall, n, -57)
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    << -1
}

fn (c &mut Checker) check_call_hosted_net(p &parser.Parser, n int, name string) int {
    << -1
}

// M184: hosted os/env/atomic/net builtins — split from check_call_builtin (W3).
// Wave C: thin dispatcher over env/os/atomic/net helpers.
fn (c &mut Checker) check_call_hosted(p &parser.Parser, n int, name string) int {
    if name == "env_get" || name == "env_list" {
        << c.check_call_hosted_env(p, n, name)
    }
        if name == "os_stat" || name == "os_mkdir" || name == "os_rename" || name == "os_remove" || name == "os_system" || name == "os_exec" || name == "ui_host_run" || name == "os_open" || name == "os_fd_read" || name == "os_fd_write" || name == "os_fd_close" || name == "os_chmod" || name == "os_chdir" || name == "os_symlink" || name == "os_readlink" || name == "os_fd_seek" || name == "os_pipe" || name == "sys_random_fill" {
        << c.check_call_hosted_os(p, n, name)
    }
    if name == "sys_socket_poll" || name == "sys_socket_wait" || name == "sys_security_store" || name == "sys_interface_data" || name == "sys_socket" || name == "sys_bind4" || name == "sys_connect4" || name == "sys_bind6" || name == "sys_connect6" || name == "sys_bind_unix" || name == "sys_connect_unix" || name == "sys_listen" || name == "sys_accept" || name == "sys_sendto" || name == "sys_recvfrom" || name == "sys_setsockopt_timeo" || name == "sys_socket_read" || name == "sys_socket_write" || name == "sys_socket_close" {
        << c.check_call_hosted_os_sys(p, n, name)
    }
    if name == "atomic_load" || name == "atomic_store" || name == "atomic_add" || name == "atomic_cas" {
        << c.check_call_hosted_atomic(p, n, name)
    }
    << -1
}

// Wave C: println/eprintln — split from check_call_builtin (W3).
fn (c &mut Checker) check_call_print(p &parser.Parser, n int, name string) int {
    if name == "println" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "println takes exactly 1 argument")
        }
        ty := c.check_expr(p, arg)
        // M163/M166: peel up to two ref levels.
        mut inner := ty
        for peel in 0:2 {
            if is_ref_type(inner) {
                inner = c.ref_inner_type(inner)
            }
        }
        if !is_error_type(ty) && inner != 1 && inner != 2 && inner != 3 && inner != 4 && inner != 8 && inner != 9 && inner != 10 {
            c.fail_node(p, n, "println does not support type " + c.ty_display(ty))
        }
        checker_set_i(mut &c.ncall, n, -2)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    if name == "eprintln" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "eprintln takes exactly 1 argument")
        }
        ty := c.check_expr(p, arg)
        mut inner := ty
        for peel in 0:2 {
            if is_ref_type(inner) {
                inner = c.ref_inner_type(inner)
            }
        }
        if !is_error_type(ty) && inner != 1 && inner != 2 && inner != 3 && inner != 4 && inner != 8 && inner != 9 && inner != 10 {
            c.fail_node(p, n, "eprintln does not support type " + c.ty_display(ty))
        }
        checker_set_i(mut &c.ncall, n, -7)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    << -1
}

// Wave C: str/parse_int/starts_with — split from check_call_builtin (W3).
fn (c &mut Checker) check_call_str(p &parser.Parser, n int, name string) int {
    if name == "str" || name == "string_from_byte" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        ty := c.check_expr(p, arg)
        if name == "string_from_byte" {
            if ty != 1 {
                c.fail_node(p, arg, "string_from_byte expects int")
            }
            checker_set_i(mut &c.ncall, n, -8)
            checker_set_i(mut &c.ntype, n, 3)
            << 3
        }
        // M14: str(int) → itoa; str(string) → identity; str(bool) → static.
        // M164: also `&T` / `&mut T` of those.
        mut inner := ty
        if is_ref_type(ty) {
            inner = c.ref_inner_type(ty)
        }
        if inner == 1 {
            abi_name := "itoa"
            mut rfi := c.require_runtime_abi(p, n, runtime_abi_id(&abi_name))
            if rfi < 0 {
                << ERROR_TY
            }
            checker_set_i(mut &c.ncall, n, rfi)
            c.record_call(rfi)
            checker_set_i(mut &c.ntype, n, 3)
            << 3
        }
        if inner == 3 {
            checker_set_i(mut &c.ncall, n, -19) // identity pass-through (deref if ref)
            checker_set_i(mut &c.ntype, n, 3)
            << 3
        }
        if inner == 2 {
            checker_set_i(mut &c.ncall, n, -20) // str(bool)
            checker_set_i(mut &c.ntype, n, 3)
            << 3
        }
        c.fail_node(p, arg, "str only supports int, bool, or string")
        << 0
    }
    if name == "string_from_bytes" {
        arg := p.nodes[n].a
        mut count := 0
        mut cursor := arg
        while cursor >= 0 {
            if count > 0 && c.check_expr(p, cursor) != 1 {
                c.fail_node(p, cursor, "string_from_bytes bounds must be int")
            }
            count += 1
            cursor = p.nodes[cursor].next
        }
        if count != 1 && count != 3 {
            c.fail_node(p, n, "string_from_bytes takes 1 or 3 arguments")
            << ERROR_TY
        }
        raw_ty := c.check_expr(p, arg)
        ty := c.direct_type(raw_ty)
        if is_ref_type(raw_ty) || !is_array_type(ty) || c.arrays[array_index(ty)].elem_ty != 1 {
            c.fail_node(p, arg, "string_from_bytes expects []int")
        }
        if count == 3 {
            start := p.nodes[arg].next
            end := p.nodes[start].next
            if !c.runtime_buffer_scalar_bound(p, start, 128) || !c.runtime_buffer_scalar_bound(p, end, 128) {
                c.fail_node(p, n, "string_from_bytes bounds must be evaluated before borrowing the buffer")
            }
        }
        checker_set_i(mut &c.ncall, n, -9)
        checker_set_i(mut &c.ntype, n, 3)
        << 3
    }
    if name == "make_ints" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "make_ints takes exactly 1 argument")
            << ERROR_TY
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, "make_ints expects int")
            << ERROR_TY
        }
        aty := c.intern_array_type(1)
        if !is_array_type(aty) {
            c.fail_node(p, n, "make_ints: int array type unavailable")
            << ERROR_TY
        }
        checker_set_i(mut &c.ncall, n, -140)
        checker_set_i(mut &c.ntype, n, aty)
        << aty
    }
    if name == "make_string" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "make_string takes exactly 1 argument")
            << ERROR_TY
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, "make_string expects int")
            << ERROR_TY
        }
        checker_set_i(mut &c.ncall, n, -141)
        checker_set_i(mut &c.ntype, n, 3)
        << 3
    }
    if name == "parse_int" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "parse_int takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 3 {
            c.fail_node(p, arg, "parse_int expects string")
        }
        abi_name := "parse_int"
        mut rfi := c.require_runtime_abi(p, n, runtime_abi_id(&abi_name))
        if rfi < 0 {
            << ERROR_TY
        }
        checker_set_i(mut &c.ncall, n, rfi)
        c.record_call(rfi)
        << c.wrap_throwable_call_result(p, n, rfi, 1)
    }
    if name == "starts_with" {
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, "starts_with takes 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 3 {
            c.fail_node(p, a1, "starts_with expects string")
        }
        if c.check_expr(p, a2) != 3 {
            c.fail_node(p, a2, "starts_with expects string")
        }
        abi_name := "starts_with"
        mut rfi := c.require_runtime_abi(p, n, runtime_abi_id(&abi_name))
        if rfi < 0 {
            << ERROR_TY
        }
        checker_set_i(mut &c.ncall, n, rfi)
        c.record_call(rfi)
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    if name == "count_byte" || name == "find_byte" {
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 {
            c.fail_node(p, n, name + " needs a string and a byte")
            << ERROR_TY
        }
        a2 := p.nodes[a1].next
        mut a3 := -1
        if name == "find_byte" {
            a3 = p.nodes[a2].next
            if a3 < 0 || p.nodes[a3].next >= 0 {
                c.fail_node(p, n, "find_byte takes 3 arguments")
                << ERROR_TY
            }
        } else if p.nodes[a2].next >= 0 {
            c.fail_node(p, n, "count_byte takes 2 arguments")
            << ERROR_TY
        }
        mut ty := c.check_expr(p, a1)
        if is_ref_type(ty) {
            ty = c.ref_inner_type(ty)
        }
        if ty != 3 {
            c.fail_node(p, a1, name + " expects string")
            << ERROR_TY
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, name + " expects int")
            << ERROR_TY
        }
        if name == "find_byte" && c.check_expr(p, a3) != 1 {
            c.fail_node(p, a3, "find_byte expects int")
            << ERROR_TY
        }
        if name == "count_byte" {
            checker_set_i(mut &c.ncall, n, -142)
        } else {
            checker_set_i(mut &c.ncall, n, -143)
        }
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "split_byte" {
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, "split_byte takes 2 arguments")
            << ERROR_TY
        }
        a2 := p.nodes[a1].next
        mut ty := c.check_expr(p, a1)
        if is_ref_type(ty) {
            ty = c.ref_inner_type(ty)
        }
        if ty != 3 {
            c.fail_node(p, a1, "split_byte expects string")
            << ERROR_TY
        }
        if c.check_expr(p, a2) != 1 {
            c.fail_node(p, a2, "split_byte expects int")
            << ERROR_TY
        }
        aty := c.intern_array_type(3)
        if !is_array_type(aty) {
            c.fail_node(p, n, "split_byte: string array type unavailable")
            << ERROR_TY
        }
        checker_set_i(mut &c.ncall, n, -144)
        checker_set_i(mut &c.ntype, n, aty)
        << aty
    }
    if name == "join_strings" {
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, "join_strings takes 2 arguments")
            << ERROR_TY
        }
        a2 := p.nodes[a1].next
        mut ty := c.check_expr(p, a1)
        if is_ref_type(ty) {
            ty = c.ref_inner_type(ty)
        }
        if !is_array_type(ty) || c.array_fixed_len_m(ty) != 0 {
            c.fail_node(p, a1, "join_strings expects []string")
            << ERROR_TY
        }
        ai := array_index(ty)
        if ai < 0 || ai >= c.arrays.len || c.arrays[ai].elem_ty != 3 {
            c.fail_node(p, a1, "join_strings expects []string")
            << ERROR_TY
        }
        mut sty := c.check_expr(p, a2)
        if is_ref_type(sty) {
            sty = c.ref_inner_type(sty)
        }
        if sty != 3 {
            c.fail_node(p, a2, "join_strings expects string")
            << ERROR_TY
        }
        checker_set_i(mut &c.ncall, n, -145)
        checker_set_i(mut &c.ntype, n, 3)
        << 3
    }
    << -1
}

// Wave C: volatile_*/raise_irq — split from check_call_builtin (W3).
fn (c &mut Checker) check_call_mmio(p &parser.Parser, n int, name string) int {
    if name == "volatile_store" || name == "volatile_store8" || name == "volatile_load" || name == "volatile_load8" {
        if c.allow_mmio == 0 {
            c.fail_node(p, n, name + " is not available on hosted targets")
        }
        mut want := 1
        if name == "volatile_store" || name == "volatile_store8" {
            want = 2
        }
        arg := p.nodes[n].a
        if want == 1 {
            if arg < 0 || p.nodes[arg].next >= 0 {
                c.fail_node(p, n, name + " takes exactly 1 argument")
            }
        }
        if want == 2 {
            if arg < 0 || p.nodes[arg].next < 0 || p.nodes[p.nodes[arg].next].next >= 0 {
                c.fail_node(p, n, name + " takes exactly 2 arguments")
            }
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, name + " expects int address")
        }
        if !c.is_const_int(p, arg) {
            c.fail_node(p, arg, name + " address must be a compile-time constant")
        }
        addr := c.const_int_value(p, arg)
        if addr < c.mmio_lo || addr >= c.mmio_hi {
            c.fail_node(p, arg, name + " address is outside the target MMIO window")
        }
        if want == 2 {
            if c.check_expr(p, p.nodes[arg].next) != 1 {
                c.fail_node(p, p.nodes[arg].next, name + " expects int value")
            }
            if name == "volatile_store8" {
                checker_set_i(mut &c.ncall, n, -34)
            } else {
                checker_set_i(mut &c.ncall, n, -33)
            }
            checker_set_i(mut &c.ntype, n, 0)
            << 0
        }
        if name == "volatile_load8" {
            checker_set_i(mut &c.ncall, n, -36)
        } else {
            checker_set_i(mut &c.ncall, n, -35)
        }
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "raise_irq" {
        if c.allow_mmio == 0 {
            c.fail_node(p, n, "raise_irq is not available on hosted targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "raise_irq takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, "raise_irq expects int")
        }
        checker_set_i(mut &c.ncall, n, -37)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    << -1
}

// Wave C: read_file/read_dir/write_file — split from check_call_builtin (W3).
fn (c &mut Checker) check_call_file(p &parser.Parser, n int, name string) int {
    if name == "read_file" {
