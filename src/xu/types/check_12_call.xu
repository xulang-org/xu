    }
    if name == "write_file" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "write_file is not available on freestanding targets")
        }
        a1 := p.nodes[n].a
        if a1 < 0 || p.nodes[a1].next < 0 || p.nodes[p.nodes[a1].next].next >= 0 {
            c.fail_node(p, n, "write_file takes exactly 2 arguments")
        }
        a2 := p.nodes[a1].next
        if c.check_expr(p, a1) != 3 || c.check_expr(p, a2) != 3 {
            c.fail_node(p, n, "write_file expects string arguments")
        }
        << c.wrap_throwable_hosted_builtin(p, n, 1, -11)
    }
    << -1
}

// Wave C: args/pid/host/sleep — split from check_call_builtin (W3).
fn (c &mut Checker) check_call_proc(p &parser.Parser, n int, name string) int {
    if name == "args" || name == "sys_args" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "args is not available on freestanding targets")
        }
        if p.nodes[n].a >= 0 { c.fail_node(p, n, "args takes no arguments") }
        checker_set_i(mut &c.ncall, n, -12)
        si21 := c.intern_array_type(3)
        checker_set_i(mut &c.ntype, n, si21)
        << c.ntype[n]
    }
    if name == "now_ns" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "now_ns is not available on freestanding targets")
        }
        if p.nodes[n].a >= 0 { c.fail_node(p, n, "now_ns takes no arguments") }
        checker_set_i(mut &c.ncall, n, -27)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "wall_time_ns" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "wall_time_ns is not available on freestanding targets")
        }
        if p.nodes[n].a >= 0 { c.fail_node(p, n, "wall_time_ns takes no arguments") }
        checker_set_i(mut &c.ncall, n, -127)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "xu_target_os" {
        if p.nodes[n].a >= 0 { c.fail_node(p, n, "xu_target_os takes no arguments") }
        checker_set_i(mut &c.ncall, n, -101)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "pid" || name == "ppid" || name == "uid" || name == "gid" || name == "euid" || name == "egid" || name == "pagesize" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        if p.nodes[n].a >= 0 { c.fail_node(p, n, name + " takes no arguments") }
        if name == "pid" { checker_set_i(mut &c.ncall, n, -38 ) }
        if name == "ppid" { checker_set_i(mut &c.ncall, n, -39 ) }
        if name == "uid" { checker_set_i(mut &c.ncall, n, -40 ) }
        if name == "gid" { checker_set_i(mut &c.ncall, n, -41 ) }
        if name == "euid" { checker_set_i(mut &c.ncall, n, -42 ) }
        if name == "egid" { checker_set_i(mut &c.ncall, n, -43 ) }
        if name == "pagesize" { checker_set_i(mut &c.ncall, n, -44 ) }
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if name == "host_name" || name == "cwd" || name == "tmp_dir" {
        if c.freestanding == 1 {
            c.fail_node(p, n, name + " is not available on freestanding targets")
        }
        if p.nodes[n].a >= 0 { c.fail_node(p, n, name + " takes no arguments") }
        if name == "host_name" { checker_set_i(mut &c.ncall, n, -45 ) }
        if name == "cwd" { checker_set_i(mut &c.ncall, n, -46 ) }
        if name == "tmp_dir" { checker_set_i(mut &c.ncall, n, -49 ) }
        checker_set_i(mut &c.ntype, n, 3)
        << 3
    }
    if name == "sys_wait_cancel" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "sys_wait_cancel is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 { c.fail_node(p, n, "sys_wait_cancel takes exactly 2 arguments") }
        second := p.nodes[arg].next
        if second < 0 || p.nodes[second].next >= 0 {
            c.fail_node(p, n, "sys_wait_cancel takes exactly 2 arguments")
        }
        ty := c.check_expr(p, arg)
        if !is_chan_type(ty) {
            c.fail_node(p, arg, "sys_wait_cancel expects chan int")
        } else if chan_index(ty) >= c.chans.len {
            c.fail_node(p, arg, "sys_wait_cancel expects chan int")
        } else if c.chans[chan_index(ty)].elem_ty != 1 {
            c.fail_node(p, arg, "sys_wait_cancel expects chan int")
        }
        if c.check_expr(p, second) != 1 { c.fail_node(p, second, "sys_wait_cancel expects int duration") }
        checker_set_i(mut &c.ncall, n, -129)
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    if name == "sleep_ns" {
        if c.freestanding == 1 {
            c.fail_node(p, n, "sleep_ns is not available on freestanding targets")
        }
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "sleep_ns takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 1 { c.fail_node(p, arg, "sleep_ns expects int") }
        checker_set_i(mut &c.ncall, n, -28)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    << -1
}

// Wave C: assert/close/is_* — split from check_call_builtin (W3).
fn (c &mut Checker) check_call_misc(p &parser.Parser, n int, name string) int {
    if name == "assert" {
        arg := p.nodes[n].a
        mut nargs := 0
        mut cur := arg
        while cur >= 0 {
        nargs += 1
        cur = p.nodes[cur].next
        }
        if nargs < 1 || nargs > 2 {
            c.fail_node(p, n, "assert takes 1 or 2 arguments, found " + str(nargs))
        }
        aty := c.check_expr(p, arg)
        if aty != 2 {
            c.fail_node(p, arg, "type mismatch: expected bool, found " + c.diag_type_display(aty))
        }
        if nargs == 2 {
            msg := p.nodes[arg].next
            mty := c.check_expr(p, msg)
            if mty != 3 {
                c.fail_node(p, msg, "type mismatch: expected string, found " + c.diag_type_display(mty))
            }
        }
        // MS6 A2: assert(n <= 1) refines upper bound for skip-loop.
        c.apply_le_ub(p, arg)
        checker_set_i(mut &c.ncall, n, -23)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    if name == "close" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "close takes exactly 1 argument")
        }
        cty := c.check_expr(p, arg)
        if !is_chan_type(cty) {
            c.fail_node(p, arg, "close requires a channel, found " + c.ty_display(cty))
        }
        checker_set_i(mut &c.ncall, n, -21)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    if name == "is_digit" || name == "is_alpha" || name == "is_alnum" || name == "is_space" {
        arg := p.nodes[n].a
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, name + " takes exactly 1 argument")
        }
        if c.check_expr(p, arg) != 1 { c.fail_node(p, arg, name + " expects int") }
        mut rfi := c.require_runtime_abi(p, n, runtime_abi_id(&name))
        if rfi < 0 { << ERROR_TY }
        checker_set_i(mut &c.ncall, n, rfi)
        c.record_call(rfi)
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    if name == "test_soft_fail" || name == "test_skip" || name == "test_is_short" {
        if p.nodes[n].a >= 0 {
            c.fail_node(p, n, name + " takes no arguments")
        }
        if name == "test_is_short" {
            checker_set_i(mut &c.ncall, n, -108)
            checker_set_i(mut &c.ntype, n, 1)
            << 1
        }
        if name == "test_skip" {
            checker_set_i(mut &c.ncall, n, -107)
        } else {
            checker_set_i(mut &c.ncall, n, -106)
        }
        checker_set_i(mut &c.ntype, n, 0)
        << 0
    }
    << -1
}

fn (c &mut Checker) check_call_builtin(p &parser.Parser, n int, name string) int {
    if name == "println" || name == "eprintln" {
        << c.check_call_print(p, n, name)
    }
    if name == "str" || name == "string_from_byte" || name == "string_from_bytes" || name == "make_ints" || name == "make_string" || name == "parse_int" || name == "starts_with" || name == "count_byte" || name == "find_byte" || name == "split_byte" || name == "join_strings" {
        << c.check_call_str(p, n, name)
    }
    if name == "volatile_store" || name == "volatile_store8" || name == "volatile_load" || name == "volatile_load8" || name == "raise_irq" {
        << c.check_call_mmio(p, n, name)
    }
    if name == "read_file" || name == "read_dir" || name == "sys_read_dir" || name == "write_file" {
        << c.check_call_file(p, n, name)
    }
    if name == "args" || name == "sys_args" || name == "now_ns" || name == "wall_time_ns" || name == "xu_target_os" || name == "pid" || name == "ppid" || name == "uid" || name == "gid" || name == "euid" || name == "egid" || name == "pagesize" || name == "host_name" || name == "cwd" || name == "tmp_dir" || name == "sleep_ns" || name == "sys_wait_cancel" || name == "exit" {
        << c.check_call_proc(p, n, name)
    }
    if name == "assert" || name == "close" || name == "is_digit" || name == "is_alpha" || name == "is_alnum" || name == "is_space" || name == "test_soft_fail" || name == "test_skip" || name == "test_is_short" {
        << c.check_call_misc(p, n, name)
    }
    << c.check_call_hosted(p, n, name)
}

fn (c &mut Checker) check_call_expr_fnval(p &parser.Parser, n int, name string) int {
    lid := c.find_local(name + "")
    if lid < 0 || !is_fn_type(c.ltype[lid]) {
        << -1
    }
    c.check_not_moved(p, lid, n)
    si := fn_index(c.ltype[lid])
    mut argc := 0
    mut arg := p.nodes[n].a
    while arg >= 0 {
        if argc >= c.fn_sigs[si].params.len {
            c.fail_node(p, n, "function value takes " + str(c.fn_sigs[si].params.len) + " argument(s), found more")
        }
        mut aty := c.check_expr(p, arg)
        want := c.fn_sigs[si].params[argc]
        aty = c.coerce_to(p, arg, aty, want)
        if !c.same_type(aty, want) {
            c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
        }
        c.arg_pass(p, arg, aty, want)
        argc += 1
        arg = p.nodes[arg].next
    }
    if argc != c.fn_sigs[si].params.len {
        c.fail_node(p, n, "function value takes " + str(c.fn_sigs[si].params.len) + " argument(s), found " + str(argc))
    }
    if argc > 4 {
        c.fail_node(p, n, "indirect calls support at most 4 arguments (env uses A0)")
    }
    checker_set_i(mut &c.nlocal, n, lid)
    checker_set_i(mut &c.ncall, n, -80)
    ty := c.fn_sigs[si].ret
    checker_set_i(mut &c.ntype, n, ty)
    << ty
}

fn (c &mut Checker) check_call_expr(p &parser.Parser, n int) int {
    name := p.nodes[n].sval
    if c.in_irq == 1 && !irq_safe_call(p.nodes[n].sval) {
        c.fail_node(p, n, "cannot call '" + p.nodes[n].sval + "' from irq handler (only xu, volatile_*, raise_irq, println, eprintln)")
    }
    // M103: call through a local/param of fn type (`f(x, y)`).
    fty := c.check_call_expr_fnval(p, n, name + "")
    if fty >= 0 {
        << fty
    }
    ii := c.find_iface_global(name + "", c.cur_mod)
    if ii >= 0 {
        << c.check_box_interface(p, n, p.nodes[n].a, ii)
    }
    // M178: builtin dispatch (separate frame). Bootstrap only dispatches
    // println/str/eprintln ahead of user functions; every other builtin
    // yields to a same-named user function in the current module.
    if name == "println" || name == "str" || name == "eprintln" || c.find_fn(name + "") < 0 {
        bty := c.check_call_builtin(p, n, name)
        if bty >= 0 {
            << bty
        }
    }
    mut fi := c.find_fn(p.nodes[n].sval)
    if fi < 0 {
        << c.fail_expr(p, n, "undefined name '" + p.nodes[n].sval + "'")
    }
    fi = c.template_for_fn(fi)
    // Generic free function: infer type args, check constraints, monomorphize.
    if c.fns[fi].is_template {
        mut argc := 0
        mut arg := p.nodes[n].a
        mut checked_tys := []int{}
        mut arg_nodes := []int{}
        while arg >= 0 {
        aty := c.check_expr(p, arg)
        checked_tys.push(aty)
        arg_nodes.push(arg)
        argc += 1
        arg = p.nodes[arg].next
        }
        if c.fns[fi].variadic {
            if argc < c.fn_min_arity(fi) {
                c.fail_node(p, n, "function '" + p.nodes[n].sval + "' takes at least " + str(c.fn_min_arity(fi)) + " argument(s), found " + str(argc))
            }
        } else {
            if argc != c.fns[fi].params.len {
                c.fail_node(p, n, "wrong number of arguments")
            }
        }
        // Count type parameters from the template decl (skip M156 lifetimes).
        d := c.fndecl[fi]
        mut ntp := 0
        mut tp := p.nodes[d].e
        while tp >= 0 {
        if !c.fn_has_lt(fi, p.nodes[tp].sval) {
            ntp += 1
        }
        tp = p.nodes[tp].next
        }
        c.uni_bind = []int{}
        for k in 0:ntp {
            c.uni_bind.push(-1)
        }
        mut fixed := c.fns[fi].params.len
        if c.fns[fi].variadic {
            fixed = c.fns[fi].params.len - 1
        }
        for i in 0:fixed {
            if !c.unify(c.fns[fi].params[i], checked_tys[i]) {
                c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.diag_type_display(c.fns[fi].params[i]) + ", found " + c.diag_type_display(checked_tys[i]) + c.borrow_type_hint(p, arg_nodes[i], c.fns[fi].params[i], checked_tys[i]))
            }
        }
        if c.fns[fi].variadic {
            elem := c.fn_variadic_elem(fi)
            mut concrete := -1
            for i in fixed:argc {
                if concrete < 0 {
                    concrete = checked_tys[i]
                } else {
                    if checked_tys[i] != concrete {
                        c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.diag_type_display(concrete) + ", found " + c.diag_type_display(checked_tys[i]) + c.borrow_type_hint(p, arg_nodes[i], concrete, checked_tys[i]))
                    }
                }
            }
            if concrete >= 0 {
                if !c.unify(elem, concrete) {
                    c.fail_node(p, arg_nodes[fixed], "type mismatch: expected " + c.diag_type_display(elem) + ", found " + c.diag_type_display(concrete) + c.borrow_type_hint(p, arg_nodes[fixed], elem, concrete))
                }
            }
        }
        tp = p.nodes[d].e
        for k in 0:ntp {
            while tp >= 0 && c.fn_has_lt(fi, p.nodes[tp].sval) {
                tp = p.nodes[tp].next
            }
            if c.uni_bind[k] < 0 {
                c.fail_node(p, n, "cannot infer type parameter '" + p.nodes[tp].sval + "' for function '" + p.nodes[n].sval + "'")
            }
            tp = p.nodes[tp].next
        }
        for i in 0:arg_nodes.len {
            mut want := checked_tys[i]
            if i < fixed {
                want = c.fns[fi].params[i]
            }
            c.arg_pass(p, arg_nodes[i], checked_tys[i], want)
        }
        c.load_targs_uni(ntp)
        inst := c.instantiate_fn_n(p, fi, n)
        if inst < 0 { << ERROR_TY }
        checker_set_i(mut &c.ncall, n, inst)
        c.record_call(inst)
        ty := c.fns[inst].ret
        << c.wrap_throwable_call_result(p, n, inst, ty)
    }
    mut argc := 0
    mut arg := p.nodes[n].a
    mut fixed := c.fns[fi].params.len
    mut variadic := c.fns[fi].variadic
    mut elem := -1
    if variadic {
        fixed = c.fns[fi].params.len - 1
        elem = c.fn_variadic_elem(fi)
    }
    while arg >= 0 {
    mut aty := c.check_expr(p, arg)
    mut want := -1
    if argc < fixed {
        want = c.fns[fi].params[argc]
    } else if variadic {
        want = elem
    }
    if want >= 0 {
        aty = c.coerce_to(p, arg, aty, want)
        if !c.same_type(aty, want) {
            c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
        }
    }
    // M107: &mut formals reborrow; other by-value args move.
    c.arg_pass(p, arg, aty, want)
    argc += 1
    arg = p.nodes[arg].next
    }
    if variadic {
        if argc < fixed {
            c.fail_node(p, n, "function '" + p.nodes[n].sval + "' takes at least " + str(fixed) + " argument(s), found " + str(argc))
        }
    } else {
        if argc != c.fns[fi].params.len {
            c.fail_node(p, n, "wrong number of arguments")
        }
    }
    checker_set_i(mut &c.ncall, n, fi)
    c.record_call(fi)
    ty := c.fns[fi].ret
    << c.wrap_throwable_call_result(p, n, fi, ty)
}

// Wave C: module-qualified / enum ctor paths of method call (W3).

// A buffer captured before an unknown bound call can be freed by that call,
// including a fixed array inside a growable container. Keep this primitive
// conservative until call effects/alias proofs
// can hold a read borrow across argument evaluation. Prepare other bounds in
// preceding statements; this is not a purity permission based on fn names.
fn (c &Checker) runtime_buffer_scalar_bound(p &parser.Parser, n int, depth int) bool {
    if n < 0 || n >= p.nodes.len || n >= c.ncall.len || depth <= 0 { << false }
    if c.ncall[n] != -1 { << false }
    k := p.nodes[n].kind
    if k == ast.NK_INT || k == ast.NK_BOOL || k == ast.NK_STR || k == ast.NK_IDENT { << true }
    if k == ast.NK_FIELD || k == ast.NK_UN_OP || k == ast.NK_CAST {
        << c.runtime_buffer_scalar_bound(p, p.nodes[n].a, depth - 1)
    }
    if k == ast.NK_INDEX || k == ast.NK_BIN_OP {
        << c.runtime_buffer_scalar_bound(p, p.nodes[n].a, depth - 1) && c.runtime_buffer_scalar_bound(p, p.nodes[n].b, depth - 1)
    }
    << false
}
