@xu/types

// A bounded, two-output scalar diamond interface. Sources are observed at
// the original Branch terminator; a later arm write cannot change that old
// snapshot. Consume with the same immutable (Mir, fi), rebuilding after any
// rewrite. No target, register-allocation or profitable-emission permission
// follows from this semantic reader alone.
// Reasons 1..9 follow MirValueFacts/ScalarEdgePlan; 11 is an escaping value
// or an output interface outside exactly two word int/bool storage cells.
pub struct MirSelectPairPlan {
    pub reason int
    valid bool
    fi int
    from int
    join int
    condition int
    nl int
    nt int
    outputs []int     // two triples: storage kind(1 Local/2 Temp), id, type
    expressions []int // output-major, then arm: source kind, id/word, type, +1
    starts []int      // three delimiters for the true/false private chains
    blocks []int
    touched []int     // arm-major: one write bit per flat Local/Temp cell
}

fn mir_select_pair_blank() MirSelectPairPlan {
    << MirSelectPairPlan{reason: 1, valid: false, fi: -1, from: -1, join: -1, condition: -1, nl: 0, nt: 0, outputs: []int{}, expressions: []int{}, starts: []int{}, blocks: []int{}, touched: []int{}}
}

fn mir_select_pair_context(m &Mir, fi int, f &MirValueFacts) bool {
    if !f.valid || f.reason != 0 || fi != f.fi || fi < 0 || fi >= m.fns.len { << false }
    << mir_nins(m, fi) == f.ni && mir_nblocks(m, fi) == f.nb && mir_nlocals(m, fi) == f.nl && mir_ntemps(m, fi) == f.nt
}

fn mir_select_pair_cell_type(m &Mir, fi int, nl int, cell int) int {
    mut ty := 0
    mut slots := 0
    if cell < 0 { << -1 }
    if cell < nl {
        ty = mir_local_ty(m, fi, cell)
        slots = mir_local_nslots(m, fi, cell)
    } else {
        t := cell - nl
        if t >= mir_ntemps(m, fi) { << -1 }
        ty = mir_temp_ty(m, fi, t)
        slots = mir_temp_nslots(m, fi, t)
    }
    if slots != 1 || (ty != 1 && ty != 2) { << -1 }
    << ty
}

// EdgeAssignments accepts its typed facts domain. A select arm is narrower:
// even a read-only descriptor Copy/load or an unused arithmetic definition
// cannot silently become a speculative/removed scalar operation.
fn mir_select_pair_arm_ok(m &Mir, fi int, e &MirScalarEdgePlan) int {
    if !e.valid || e.reason != 0 { << e.reason }
    for pos in 0:e.blocks.len {
        mut ii := mir_bhead(m, fi, e.blocks[pos])
        for _ in 0:mir_nins(m, fi) {
            if ii == -1 { <- }
            k := mir_ikind(m, fi, ii)
            if k != mi_nop {
                if k != mi_copy && k != mi_load_local && k != mi_store_local && k != mi_bin { << 9 }
                cell := mir_scalar_def_cell(m, fi, ii, e.nl)
                ty := mir_select_pair_cell_type(m, fi, e.nl, cell)
                if ty < 0 { << 3 }
                if k == mi_bin && (ty != 1 || mir_ib(m, fi, ii) != 1) { << 9 }
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    << 0
}

fn mir_select_pair_path_tail(e &MirScalarEdgePlan) int {
    if e.blocks.len == 0 { << e.from }
    << e.blocks[e.blocks.len - 1]
}

fn mir_select_pair_record_paths(p &mut MirSelectPairPlan, f &MirValueFacts, yes &MirScalarEdgePlan, no &MirScalarEdgePlan) int {
    if mir_value_facts_pred_count(f, p.join) != 2 { << 8 }
    yt := mir_select_pair_path_tail(yes)
    nt := mir_select_pair_path_tail(no)
    if yt == nt { << 8 }
    poff := mir_value_facts_off(f, 4)
    soff := mir_value_facts_off(f, 3)
    mut yc := 0
    mut nc := 0
    for pi in f.data[soff + p.join]:f.data[soff + p.join + 1] {
        pred := f.data[poff + pi]
        if pred == yt { yc += 1 }
        if pred == nt { nc += 1 }
    }
    if yc != 1 || nc != 1 { << 8 }
    p.starts.push(0)
    for i in 0:yes.blocks.len { p.blocks.push(yes.blocks[i]) }
    end := p.blocks.len
    p.starts.push(end)
    for i in 0:no.blocks.len {
        bi := no.blocks[i]
        for j in 0:yes.blocks.len { if yes.blocks[j] == bi { << 8 } }
        p.blocks.push(bi)
    }
    last := p.blocks.len
    p.starts.push(last)
    << 0
}

// Deliberately conservative outside-use test: a touched Temp read anywhere
// outside either private chain is an output, even if the read precedes the
// Branch or follows another definition. This may decline a safe diamond;
// it cannot drop an escaping arm definition. All Local writes are outputs.
fn mir_select_pair_escapes(m &Mir, fi int, p &MirSelectPairPlan, cell int) bool {
    if cell < p.nl { << true }
    for bi in 0:mir_nblocks(m, fi) {
        mut private := false
        for i in 0:p.blocks.len { if p.blocks[i] == bi { private = true } }
        if private { -> }
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:mir_nins(m, fi) {
            if ii == -1 { <- }
            for which in 0:2 {
                if mir_scalar_used_cell(m, fi, ii, which, p.nl) == cell { << true }
            }
            ii = mir_inext(m, fi, ii)
        }
        tk := mir_btkind(m, fi, bi)
        v := mir_bta(m, fi, bi)
        if (tk == 2 || tk == 3) && v >= 0 && p.nl + v == cell { << true }
    }
    << false
}

fn mir_select_pair_expression(m &Mir, fi int, f &MirValueFacts, p &mut MirSelectPairPlan, e &MirScalarEdgePlan, cell int, ty int) int {
    n := p.nl + p.nt
    ek := e.values[cell]
    value := e.values[n + cell]
    inc := e.values[n * 2 + cell]
    if ek == 0 { << 6 }
    if inc < 0 || inc > 1 || (inc == 1 && ty != 1) { << 9 }
    mut kind := 3
    mut id := value
    if ek == 1 {
        if value < 0 || value >= n { << 3 }
        if mir_select_pair_cell_type(m, fi, p.nl, value) != ty { << 3 }
        kind = 2
        id = value - p.nl
        if value < p.nl { kind = 1
            id = value }
        if mir_value_facts_version(m, fi, f, p.from, -1, kind, id) < 0 { << 6 }
    } else if ek == 2 {
        if ty == 2 && value != 0 && value != 1 { << 3 }
    } else { << 9 }
    p.expressions.push(kind)
    p.expressions.push(id)
    p.expressions.push(ty)
    p.expressions.push(inc)
    << 0
}

fn mir_select_pair_record_values(m &Mir, fi int, f &MirValueFacts, p &mut MirSelectPairPlan, yes &MirScalarEdgePlan, no &MirScalarEdgePlan) int {
    n := p.nl + p.nt
    for cell in 0:n { p.touched.push(yes.values[n * 3 + cell]) }
    for cell in 0:n { p.touched.push(no.values[n * 3 + cell]) }
    for cell in 0:n {
        if p.touched[cell] == 0 && p.touched[n + cell] == 0 { -> }
        if !mir_select_pair_escapes(m, fi, &*p, cell) { -> }
        if p.outputs.len >= 6 { << 11 }
        ty := mir_select_pair_cell_type(m, fi, p.nl, cell)
        if ty < 0 { << 3 }
        mut kind := 2
        mut id := cell - p.nl
        if cell < p.nl { kind = 1
            id = cell }
        p.outputs.push(kind)
        p.outputs.push(id)
        p.outputs.push(ty)
        yr := mir_select_pair_expression(m, fi, f, p, yes, cell, ty)
        if yr != 0 { << yr }
        nr := mir_select_pair_expression(m, fi, f, p, no, cell, ty)
        if nr != 0 { << nr }
    }
    if p.outputs.len != 6 { << 11 }
    << 0
}

pub fn new_mir_select_pair_plan(m &Mir, fi int, f &MirValueFacts, from int, join int) MirSelectPairPlan {
    mut p := mir_select_pair_blank()
    if !mir_select_pair_context(m, fi, f) {
        if !f.valid || f.reason != 0 { p.reason = f.reason
            if p.reason == 0 { p.reason = 1 } }
        << p
    }
    p.fi = fi
    p.nl = f.nl
    p.nt = f.nt
    p.from = from
    p.join = join
    p.reason = 8
    if from == join || !mir_value_facts_reachable(f, from) || !mir_value_facts_reachable(f, join) { << p }
    if mir_btkind(m, fi, from) != 2 { << p }
    p.condition = mir_bta(m, fi, from)
    yes := mir_read_scalar_edge(m, fi, f, from, mir_btb(m, fi, from), join)
    if !yes.valid || yes.reason != 0 { p.reason = yes.reason
        if p.reason == 0 { p.reason = 8 }
        << p }
    no := mir_read_scalar_edge(m, fi, f, from, mir_btc(m, fi, from), join)
    if !no.valid || no.reason != 0 { p.reason = no.reason
        if p.reason == 0 { p.reason = 8 }
        << p }
    ar := mir_select_pair_arm_ok(m, fi, &yes)
    if ar != 0 { p.reason = ar
        << p }
    br := mir_select_pair_arm_ok(m, fi, &no)
    if br != 0 { p.reason = br
        << p }
    cr := mir_select_pair_record_paths(mut &p, f, &yes, &no)
    if cr != 0 { p.reason = cr
        << p }
    dr := mir_select_pair_record_values(m, fi, f, mut &p, &yes, &no)
    if dr != 0 { p.reason = dr
        << p }
    p.reason = 0
    p.valid = true
    << p
}

// Discovery only follows deterministic Jump suffixes. Admission still uses
// the explicit constructor, proving the actual predecessors and expressions.
pub fn new_mir_select_pair_plan_discover(m &Mir, fi int, f &MirValueFacts, from int) MirSelectPairPlan {
    mut p := mir_select_pair_blank()
    if !mir_select_pair_context(m, fi, f) {
        if !f.valid || f.reason != 0 { p.reason = f.reason
            if p.reason == 0 { p.reason = 1 } }
        << p }
    p.reason = 8
    if !mir_value_facts_reachable(f, from) || mir_btkind(m, fi, from) != 2 { << p }
    mut yes := []int{}
    mut bi := mir_btb(m, fi, from)
    mut bounded := true
    for _ in 0:9 {
        if bi == from { bounded = false
            <- }
        if !mir_value_facts_reachable(f, bi) { << p }
        mut repeated := false
        for i in 0:yes.len { if yes[i] == bi { repeated = true } }
        if repeated { bounded = false
            <- }
        yes.push(bi)
        if mir_btkind(m, fi, bi) != 1 { bounded = false
            <- }
        bi = mir_bta(m, fi, bi)
    }
    bi = mir_btc(m, fi, from)
    mut seen := []int{}
    for _ in 0:9 {
        if bi == from || !mir_value_facts_reachable(f, bi) { << p }
        for i in 0:seen.len { if seen[i] == bi { << p } }
        for i in 0:yes.len {
            if yes[i] == bi { << new_mir_select_pair_plan(m, fi, f, from, bi) }
        }
        seen.push(bi)
        if mir_btkind(m, fi, bi) != 1 {
            if bounded { p.reason = 2 }
            << p }
        bi = mir_bta(m, fi, bi)
    }
    p.reason = 2
    << p
}

// 0 from, 1 join, 2 actual Branch condition ValueId, 3 nl, 4 nt, 5 fi.
pub fn mir_select_pair_field(p &MirSelectPairPlan, field int) int {
    if !p.valid || p.reason != 0 || field < 0 || field > 5 { << -1 }
    if field == 0 { << p.from }
    if field == 1 { << p.join }
    if field == 2 { << p.condition }
    if field == 3 { << p.nl }
    if field == 4 { << p.nt }
    << p.fi
}

// Output order is ascending flat cell: Local IDs, then Temp IDs.
pub fn mir_select_pair_output(p &MirSelectPairPlan, output int, lane int) int {
    if !p.valid || p.reason != 0 || output < 0 || output >= 2 || lane < 0 || lane >= 3 { << -1 }
    << p.outputs[output * 3 + lane]
}

// arm0 true, arm1 false; lanes kind, id/literal word, type, increment.
pub fn mir_select_pair_source(p &MirSelectPairPlan, output int, arm int, lane int) int {
    if !p.valid || p.reason != 0 || output < 0 || output >= 2 || arm < 0 || arm >= 2 || lane < 0 || lane >= 4 { << -1 }
    << p.expressions[(output * 2 + arm) * 4 + lane]
}

pub fn mir_select_pair_block_count(p &MirSelectPairPlan, arm int) int {
    if !p.valid || p.reason != 0 || arm < 0 || arm >= 2 { << -1 }
    << p.starts[arm + 1] - p.starts[arm]
}

pub fn mir_select_pair_block(p &MirSelectPairPlan, arm int, index int) int {
    count := mir_select_pair_block_count(p, arm)
    if index < 0 || index >= count { << -1 }
    << p.blocks[p.starts[arm] + index]
}

pub fn mir_select_pair_touched(p &MirSelectPairPlan, arm int, kind int, id int) int {
    if !p.valid || p.reason != 0 || arm < 0 || arm >= 2 { << -1 }
    mut cell := -1
    if kind == 1 && id >= 0 && id < p.nl { cell = id }
    if kind == 2 && id >= 0 && id < p.nt { cell = p.nl + id }
    if cell < 0 { << -1 }
    << p.touched[arm * (p.nl + p.nt) + cell]
}
