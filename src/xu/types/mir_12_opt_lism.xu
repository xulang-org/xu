@xu/types

fn mir_lism_field_type_at(m &Mir, ty int, off int) int {
    if !is_struct_type(ty) { << 0 }
    si := struct_index(ty)
    if si < 0 || si >= m.structs.len { << 0 }
    for fi in 0:m.structs[si].fields.len {
        if m.structs[si].fields[fi].slot == off {
            ft := m.structs[si].fields[fi].ty
            if mir_scalar_ty(ft) { << ft }
            << 0
        }
    }
    << 0
}

fn mir_lism_is_single_slot(m &Mir, ty int) bool {
    if !is_struct_type(ty) { << false }
    si := struct_index(ty)
    if si < 0 || si >= m.structs.len { << false }
    << m.structs[si].nslots == 1 && m.structs[si].fields.len == 1
}

fn mir_each_clone_lism(m &mut Mir) {
    // Universal Loop Scalar Promotion for struct locals and invariant pointers in self-loops.
    n0 := m.fns.len
    mut fi := 0
    while fi < n0 {
        if mir_fn_is_extern(&*m, fi) {
            fi += 1
            ->
        }
        summary := mir_fn_summary(m, fi)
        if !mir_summary_has(summary, MIR_SUM_FIELD_RMW) {
            fi += 1
            ->
        }
        if m.fns[fi].instrs.len >= 512 {
            fi += 1
            ->
        }
        mut f := mir_clone_fn(m, fi, false)
        changed := mir_lism_self_loops(&*m, mut &f)
        if !changed {
            fi += 1
            ->
        }
        mir_fn_commit(m, fi, f)
        fi += 1
    }
}

fn mir_lism_loop_exit(f &MFn, bi int) int {
    tk := f.blocks[bi].tkind
    if tk == 1 && f.blocks[bi].ta != bi {
        << f.blocks[bi].ta
    }
    if tk == 2 {
        if f.blocks[bi].tb == bi {
            << f.blocks[bi].tc
        }
        if f.blocks[bi].tc == bi {
            << f.blocks[bi].tb
        }
    }
    << -1
}

fn mir_lism_retarget_exit(f &mut MFn, bi int, nb int) {
    mut b := f.blocks[bi]
    if b.tkind == 1 && b.ta != bi {
        b.ta = nb
    }
    if b.tkind == 2 {
        if b.tb == bi {
            b.tc = nb
        } else if b.tc == bi {
            b.tb = nb
        }
    }
    mfn_set_block(mut &f.blocks, bi, b)
}

fn mir_lism_has_call(f &MFn, bi int) bool {
    mut ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { << false }
        k := mfn_ikind(&f.instrs, ii)
        if k == MI_CALL {
            mut is_pure_math := false
            if mfn_ib(&f.instrs, ii) == 1 {
                lab := mfn_isval(&f.instrs, ii)
                if lab == "_xu_math_sqrt" || lab == "_xu_math_clz" || lab == "_xu_math_ctz" || lab == "_xu_math_ones_count" || lab == "_xu_math_reverse_bits" || lab == "_xu_math_byte_swap" {
                    is_pure_math = true
                }
            }
            if !is_pure_math && mfn_ib(&f.instrs, ii) != 95 {
                << true
            }
        }
        if k == MI_ARRAY_LIT || k == MI_ARR_PUSH || k == MI_ARR_PUSH4 { << true }
        if k >= 30 && k <= 37 { << true }
        ii = mfn_inext(&f.instrs, ii)
    }
    << false
}

fn mir_lism_ptr_is_loop_invariant(f &MFn, bi int, ptr int) bool {
    if ptr < 0 || ptr >= f.temps.len { << false }
    mut ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        d := mir_licm_instr_dest(f, ii)
        if d == ptr { << false }
        ii = mfn_inext(&f.instrs, ii)
    }
    << true
}

// MIR temps are not necessarily SSA here. A last-seen ElemAddr alone is
// not provenance when another instruction can define the same temp.
fn mir_lism_unique_def(f &MFn, t int) int {
    if t < 0 || t >= f.temps.len { << -1 }
    mut found := -1
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            mut defines := mir_licm_instr_dest(f, ii) == t
            if mfn_ikind(&f.instrs, ii) == MI_CHAN_TRY_RECV {
                defines = mfn_ia(&f.instrs, ii) == t
                if !defines {
                    defines = mfn_ib(&f.instrs, ii) == t
                }
            }
            if defines {
                if found >= 0 { << -1 }
                found = ii
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << found
}

fn mir_lism_ptrs_disjoint(f &MFn, p1 int, p2 int) bool {
    if p1 == p2 { << false }
    d1 := mir_lism_unique_def(f, p1)
    d2 := mir_lism_unique_def(f, p2)
    if d1 < 0 || d2 < 0 { << false }
    if mfn_ikind(&f.instrs, d1) != MI_ELEM_ADDR { << false }
    if mfn_ikind(&f.instrs, d2) != MI_ELEM_ADDR { << false }
    arr := mfn_ib(&f.instrs, d1)
    arr2 := mfn_ib(&f.instrs, d2)
    if arr != arr2 { << false }
    if mir_lism_unique_def(f, arr) < 0 { << false }
    i1 := mfn_ic(&f.instrs, d1)
    i2 := mfn_ic(&f.instrs, d2)
    // Different value IDs can hold equal indices, including duplicate
    // constant-pool entries. Only distinct known values prove separation.
    if !mir_val_is_const(f, i1) || !mir_val_is_const(f, i2) { << false }
    v1 := mir_val_const(f, i1)
    v2 := mir_val_const(f, i2)
    if v1 < 0 || v2 < 0 || v1 == v2 { << false }
    mut stride1 := mfn_id(&f.instrs, d1)
    mut stride2 := mfn_id(&f.instrs, d2)
    if stride1 < 0 { stride1 = 0 - stride1 }
    if stride2 < 0 { stride2 = 0 - stride2 }
    << stride1 > 0 && stride1 == stride2
}

fn mir_lism_buf_access_disjoint(f &MFn, ptr int, off int, other int, other_off int, slots int) bool {
    if ptr != other { << mir_lism_ptrs_disjoint(f, ptr, other) }
    // Offsets are bytes on every target; even ARM32 MIR slots are 8 bytes.
    if off < 0 || other_off < 0 || slots <= 0 || slots > 512 { << false }
    if other_off > off { << other_off - off >= 8 }
    << off - other_off >= slots * 8
}

fn mir_lism_decode_rmw(f &MFn, ii int, ptr_of &[]int) LismRmw {
    mut z := LismRmw{ok: 0, loc: -1, off: 0, rhs: 0, op: 0, buf: 0, ptr: -1, fty: 0}
    k := mfn_ikind(&f.instrs, ii)
    if k == MI_FIELD_RMW {
        z.ptr = mfn_ia(&f.instrs, ii)
        z.buf = mfn_ib(&f.instrs, ii)
        z.rhs = mfn_ic(&f.instrs, ii)
        z.fty = mfn_id(&f.instrs, ii)
        z.op = mfn_icol(&f.instrs, ii)
        z.off = mfn_iline(&f.instrs, ii)
        if z.ptr >= 0 && z.ptr < ptr_of.len {
            z.loc = ptr_of[z.ptr]
        }
        z.ok = 1
        << z
    }
    if k == MI_CALL && mfn_ib(&f.instrs, ii) == 95 {
        head := mfn_ic(&f.instrs, ii)
        if head < 0 || head >= f.margs.len { << z }
        z.ptr = f.margs[head].v
        n1 := f.margs[head].next
        if n1 < 0 || n1 >= f.margs.len { << z }
        z.rhs = f.margs[n1].v
        packed := mfn_id(&f.instrs, ii)
        z.op = packed - (packed / 64) * 64
        z.off = packed / 64
        z.buf = 0
        z.fty = 1
        if z.ptr >= 0 && z.ptr < ptr_of.len {
            z.loc = ptr_of[z.ptr]
        }
        if z.loc >= 0 {
            z.ok = 1
        }
        << z
    }
    << z
}

fn mir_lism_exit_preds_ok(f &MFn, exb int, loop_bi int, pred int) bool {
    for pi in 0:f.blocks.len {
        mut hits := false
        tk := f.blocks[pi].tkind
        if tk == 1 && f.blocks[pi].ta == exb { hits = true }
        if tk == 2 && (f.blocks[pi].tb == exb || f.blocks[pi].tc == exb) { hits = true }
        if hits {
            if pi != loop_bi && pi != pred { << false }
        }
    }
    << true
}

fn mir_lism_other_touch(f &MFn, ii int, local int, ptr_of &[]int) bool {
    k := mfn_ikind(&f.instrs, ii)
    ia := mfn_ia(&f.instrs, ii)
    ib := mfn_ib(&f.instrs, ii)
    if k == MI_FIELD_RMW { << false }
    if k == MI_CALL && ib == 95 { << false }
    if k == MI_ADDR { << false }
    if k == MI_LOAD_LOCAL && ib == local { << true }
    if k == MI_STORE_LOCAL && ia == local { << true }
    if k == MI_DROP && ia == local { << true }
    mut p := -1
    if k == MI_LOAD_FIELD || k == MI_LOAD_PTR || k == MI_LOAD_BUF_PTR { p = ib }
    if k == MI_STORE_FIELD || k == MI_STORE_PTR || k == MI_STORE_BUF_PTR { p = ib }
    if k == MI_DROP_FIELD || k == MI_DROP_PTR_FIELD || k == MI_DROP_BUF_FIELD { p = ia }
    if p >= 0 && p < ptr_of.len {
        if ptr_of[p] == local { << true }
    }
    << false
}

fn mir_lism_temp_used(f &MFn, t int) bool {
    if t < 0 { << false }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if f.instr_uses_temp(ii, t) { << true }
            ii = mfn_inext(&f.instrs, ii)
        }
        tk := f.blocks[bi].tkind
        if tk == 2 || tk == 3 {
            if mir_val_is_temp_t(f.blocks[bi].ta, t) { << true }
        }
    }
    << false
}

fn mir_lism_self_loops(m &Mir, f &mut MFn) bool {
    nloc0 := f.locals.len
    ntmp0 := f.temps.len
    mut ptr_of := []int{}
    for _ in 0:ntmp0 {
        ptr_of.push(-1)
    }
    for bi0 in 0:f.blocks.len {
        mut p := f.blocks[bi0].head
        for _ in 0:f.instrs.len {
            if p < 0 { <- }
            k16 := mfn_ikind(&f.instrs, p)
            c16 := mfn_ic(&f.instrs, p)
            if k16 == MI_ADDR && c16 == 0 {
                d := mfn_ia(&f.instrs, p)
                loc := mfn_ib(&f.instrs, p)
                if d >= 0 && d < ptr_of.len {
                    mfn_set_i(mut &ptr_of, d, loc)
                }
            }
            p = mfn_inext(&f.instrs, p)
        }
    }
    mut changed := false
    nblk0 := f.blocks.len
    for bi in 0:nblk0 {
        if !f.is_self_loop(bi) { -> }
        if mir_lism_has_call(&*f, bi) { -> }
        pred := f.unique_ext_pred(bi)
        if pred < 0 { -> }
        // A unique predecessor need not be a preheader: a branch may bypass
        // this loop. Do not speculate loads or write back on its bypass edge.
        if f.blocks[pred].tkind != 1 || f.blocks[pred].ta != bi { -> }
        exb := mir_lism_loop_exit(&*f, bi)
        if exb < 0 || exb == bi || exb == pred { -> }

        // cand_kind: 0 for local struct field, 1 for loop-invariant buffer pointer
        mut cand_kind := []int{}
        mut cand_base := []int{}
        mut cand_off := []int{}
        mut cand_fty := []int{}
        mut cand_acc := []int{}

        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            rmw := mir_lism_decode_rmw(&*f, ii, &ptr_of)
            if rmw.ok == 1 {
                if rmw.loc >= 0 && rmw.loc < nloc0 {
                    fty := mir_lism_field_type_at(m, f.locals[rmw.loc], rmw.off)
                    if fty > 0 {
                        mut found := false
                        for ci in 0:cand_base.len {
                            if cand_kind[ci] == 0 && cand_base[ci] == rmw.loc && cand_off[ci] == rmw.off {
                                found = true
                                <-
                            }
                        }
                        if !found {
                            cand_kind.push(0)
                            cand_base.push(rmw.loc)
                            cand_off.push(rmw.off)
                            cand_fty.push(fty)
                            cand_acc.push(-1)
                        }
                    }
                } else if rmw.buf == 1 && rmw.ptr >= 0 {
                    if mir_lism_ptr_is_loop_invariant(&*f, bi, rmw.ptr) && mir_scalar_ty(rmw.fty) {
                        mut found := false
                        for ci in 0:cand_base.len {
                            if cand_kind[ci] == 1 && cand_base[ci] == rmw.ptr && cand_off[ci] == rmw.off {
                                found = true
                                <-
                            }
                        }
                        if !found {
                            cand_kind.push(1)
                            cand_base.push(rmw.ptr)
                            cand_off.push(rmw.off)
                            cand_fty.push(rmw.fty)
                            cand_acc.push(-1)
                        }
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        if cand_base.len == 0 { -> }

        // Conflict and aliasing validation
        mut cand_bad := []int{}
        for _ in 0:cand_base.len {
            cand_bad.push(0)
        }

        mut loc_invalid := []int{}
        for _ in 0:nloc0 {
            loc_invalid.push(0)
        }
        ii = f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            rmw2 := mir_lism_decode_rmw(&*f, ii, &ptr_of)
            if rmw2.ok == 0 {
                for ci in 0:cand_base.len {
                    if cand_kind[ci] == 0 {
                        loc := cand_base[ci]
                        if loc >= 0 && loc < nloc0 && loc_invalid[loc] == 0 {
                            if mir_lism_other_touch(&*f, ii, loc, &ptr_of) {
                                mfn_set_i(mut &loc_invalid, loc, 1)
                            }
                        }
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        for ci in 0:cand_base.len {
            if cand_kind[ci] == 0 {
                loc := cand_base[ci]
                if loc >= 0 && loc < nloc0 && loc_invalid[loc] == 1 {
                    mfn_set_i(mut &cand_bad, ci, 1)
                }
            }
        }

        // Promotion delays memory writes until exit. Both reads and writes
        // must be disjoint, including accesses through the same pointer.
        ii = f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            for ci in 0:cand_base.len {
                if cand_kind[ci] != 1 || cand_bad[ci] != 0 { -> }
                ptr := cand_base[ci]
                off := cand_off[ci]
                // Unmodelled aggregate/index/lifetime operations fail closed.
                if k == MI_DROP || k == MI_LOAD_FIELD || k == MI_STORE_FIELD || k == MI_ARR_PUSH || k == MI_LOAD_INDEX || k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_STORE_INDEX || k == MI_DROP_FIELD || k == MI_DROP_PTR_FIELD || k == MI_DROP_BUF_FIELD || k == MI_ARR_PUSH4 || k == MI_INDEX_RMW {
                    mfn_set_i(mut &cand_bad, ci, 1)
                } else if k == MI_STORE_BUF_PTR || k == MI_LOAD_BUF_PTR {
                    other := mfn_ib(&f.instrs, ii)
                    other_off := mfn_ic(&f.instrs, ii)
                    slots := mfn_id(&f.instrs, ii)
                    if !mir_lism_buf_access_disjoint(&*f, ptr, off, other, other_off, slots) {
                        mfn_set_i(mut &cand_bad, ci, 1)
                    }
                } else if k == MI_FIELD_RMW {
                    other := mfn_ia(&f.instrs, ii)
                    other_off := mfn_iline(&f.instrs, ii)
                    ib := mfn_ib(&f.instrs, ii)
                    fid_ty := mfn_id(&f.instrs, ii)
                    if ib != 1 {
                        mfn_set_i(mut &cand_bad, ci, 1)
                    } else if other != ptr || other_off != off {
                        if !mir_lism_buf_access_disjoint(&*f, ptr, off, other, other_off, 1) {
                            mfn_set_i(mut &cand_bad, ci, 1)
                        }
                    } else if fid_ty != cand_fty[ci] {
                        mfn_set_i(mut &cand_bad, ci, 1)
                    }
                } else if k == MI_CALL && mfn_ib(&f.instrs, ii) == 95 {
                    mfn_set_i(mut &cand_bad, ci, 1)
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }

        mut valid_cnt := 0
        for ci in 0:cand_base.len {
            if cand_bad[ci] == 0 {
                valid_cnt += 1
            }
        }
        if valid_cnt == 0 { -> }

        for ci in 0:cand_base.len {
            if cand_bad[ci] != 0 { -> }
            acc := mir_opt_add_local(f, cand_fty[ci])
            mfn_set_i(mut &cand_acc, ci, acc)
        }

        // Preheader initial loads
        for ci in 0:cand_base.len {
            if cand_bad[ci] != 0 || cand_acc[ci] < 0 { -> }
            off := cand_off[ci]
            fty := cand_fty[ci]
            acc := cand_acc[ci]
            if cand_kind[ci] == 0 {
                loc := cand_base[ci]
                single := mir_lism_is_single_slot(m, f.locals[loc]) && off == 0
                if single {
                    t := mir_opt_add_temp(f, fty)
                    mut ld := mkinstr(MI_LOAD_LOCAL)
                    ld.a = t
                    ld.b = loc
                    mir_cfg_append(f, pred, ld)
                    mut st := mkinstr(MI_STORE_LOCAL)
                    st.a = acc
                    st.b = t
                    mir_cfg_append(f, pred, st)
                } else {
                    p := mir_opt_add_temp(f, 1)
                    mut ad := mkinstr(MI_ADDR)
                    ad.a = p
                    ad.b = loc
                    ad.c = 0
                    mir_cfg_append(f, pred, ad)

                    t := mir_opt_add_temp(f, fty)
                    mut lp := mkinstr(MI_LOAD_PTR)
                    lp.a = t
                    lp.b = p
                    lp.c = off
                    lp.d = 1
                    mir_cfg_append(f, pred, lp)

                    mut st := mkinstr(MI_STORE_LOCAL)
                    st.a = acc
                    st.b = t
                    mir_cfg_append(f, pred, st)
                }
            } else {
                ptr := cand_base[ci]
                t := mir_opt_add_temp(f, fty)
                mut lp := mkinstr(MI_LOAD_BUF_PTR) // LoadBufPtr
                lp.a = t
                lp.b = ptr
                lp.c = off
                lp.d = 1
                mir_cfg_append(f, pred, lp)

                mut st := mkinstr(MI_STORE_LOCAL)
                st.a = acc
                st.b = t
                mir_cfg_append(f, pred, st)
            }
        }

        // Loop body rewrite
        ii = f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := mfn_inext(&f.instrs, ii)
            rmw3 := mir_lism_decode_rmw(&*f, ii, &ptr_of)
            if rmw3.ok == 1 {
                mut matched_ci := -1
                for ci in 0:cand_base.len {
                    if cand_bad[ci] == 0 && cand_acc[ci] >= 0 && cand_off[ci] == rmw3.off {
                        if cand_kind[ci] == 0 && rmw3.loc >= 0 && cand_base[ci] == rmw3.loc {
                            matched_ci = ci
                            <-
                        }
                        if cand_kind[ci] == 1 && rmw3.buf == 1 && cand_base[ci] == rmw3.ptr {
                            matched_ci = ci
                            <-
                        }
                    }
                }
                if matched_ci >= 0 {
                    fty := cand_fty[matched_ci]
                    acc := cand_acc[matched_ci]
                    t0 := mir_opt_add_temp(f, fty)
                    t1 := mir_opt_add_temp(f, fty)
                    mfn_become_load_local(mut &f.instrs, ii, t0, acc)
                    mut bn := mkinstr(MI_BIN)
                    bn.a = t1
                    bn.b = rmw3.op
                    bn.c = t0
                    bn.d = rmw3.rhs
                    bi2 := mir_insert_after(f, bi, ii, bn)
                    mut st2 := mkinstr(MI_STORE_LOCAL)
                    st2.a = acc
                    st2.b = t1
                    mir_insert_after(f, bi, bi2, st2)
                    changed = true
                }
            }
            ii = nxt
        }

        // Drop unused AddrOf of promoted locals
        ii = f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := mfn_inext(&f.instrs, ii)
            k16 := mfn_ikind(&f.instrs, ii)
            c16 := mfn_ic(&f.instrs, ii)
            mut dead := false
            if k16 == MI_ADDR && c16 == 0 {
                loc := mfn_ib(&f.instrs, ii)
                d := mfn_ia(&f.instrs, ii)
                mut promoted := false
                for ci in 0:cand_base.len {
                    if cand_kind[ci] == 0 && cand_base[ci] == loc && cand_acc[ci] >= 0 {
                        promoted = true
                        <-
                    }
                }
                if promoted {
                    if !mir_lism_temp_used(&*f, d) {
                        dead = true
                    }
                }
            }
            if dead {
                mir_delete_instr(f, bi, ii)
            }
            ii = nxt
        }

        mut wb := exb
        preds_ok := mir_lism_exit_preds_ok(&*f, exb, bi, pred)
        if !preds_ok {
            nb := f.blocks.len
            ln := f.blocks[bi].line
            f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: exb, tb: 0, tc: 0, line: ln})
            mir_lism_retarget_exit(f, bi, nb)
            wb = nb
        }

        // Loop exit write-backs (reverse prepend)
        mut ci_rev := cand_base.len - 1
        while ci_rev >= 0 {
            if cand_bad[ci_rev] == 0 && cand_acc[ci_rev] >= 0 {
                off := cand_off[ci_rev]
                fty := cand_fty[ci_rev]
                acc := cand_acc[ci_rev]
                if cand_kind[ci_rev] == 0 {
                    loc := cand_base[ci_rev]
                    single := mir_lism_is_single_slot(m, f.locals[loc]) && off == 0
                    if single {
                        t := mir_opt_add_temp(f, fty)
                        mut stw := mkinstr(MI_STORE_LOCAL)
                        stw.a = loc
                        stw.b = t
                        mir_prepend_instr(f, wb, stw)

                        mut ldw := mkinstr(MI_LOAD_LOCAL)
                        ldw.a = t
                        ldw.b = acc
                        mir_prepend_instr(f, wb, ldw)
                    } else {
                        t := mir_opt_add_temp(f, fty)
                        p := mir_opt_add_temp(f, 1)

                        mut sp := mkinstr(MI_STORE_PTR)
                        sp.a = t
                        sp.b = p
                        sp.c = off
                        sp.d = 1
                        mir_prepend_instr(f, wb, sp)

                        mut ad := mkinstr(MI_ADDR)
                        ad.a = p
                        ad.b = loc
                        ad.c = 0
                        mir_prepend_instr(f, wb, ad)

                        mut ldw := mkinstr(MI_LOAD_LOCAL)
                        ldw.a = t
                        ldw.b = acc
                        mir_prepend_instr(f, wb, ldw)
                    }
                } else {
                    ptr := cand_base[ci_rev]
                    t := mir_opt_add_temp(f, fty)

                    mut sp := mkinstr(MI_STORE_BUF_PTR) // StoreBufPtr
                    sp.a = t
                    sp.b = ptr
                    sp.c = off
                    sp.d = 1
                    mir_prepend_instr(f, wb, sp)

                    mut ldw := mkinstr(MI_LOAD_LOCAL) // LoadLocal
                    ldw.a = t
                    ldw.b = acc
                    mir_prepend_instr(f, wb, ldw)
                }
            }
            ci_rev -= 1
        }
    }
    << changed
}
