@xu/types

// Per-self-loop memory version. ArrPush, calls, pointer/index/FieldRMW
// stores and owning drops bump the version. LICM may hoist a memory load
// only when the version stays 0. Late-opt still does not run LICM.
struct LoopMemFacts {
    has_call int
    has_arr_push int
    has_field_rmw int
    has_ptr_store int
    has_index_store int
    version int
}

fn mir_loop_mem_facts(f &MFn, bi int) LoopMemFacts {
    mut z := LoopMemFacts{
        has_call: 0, has_arr_push: 0, has_field_rmw: 0,
        has_ptr_store: 0, has_index_store: 0, version: 0
    }
    if bi < 0 || bi >= f.blocks.len { << z }
    mut ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        k := mfn_ikind(&f.instrs, ii)
        if k == mi_call {
            mut is_pure_math := false
            if mfn_ib(&f.instrs, ii) == 1 {
                lab := mfn_isval(&f.instrs, ii)
                if lab == "_xu_math_sqrt" || lab == "_xu_math_clz" || lab == "_xu_math_ctz" || lab == "_xu_math_ones_count" || lab == "_xu_math_reverse_bits" || lab == "_xu_math_byte_swap" {
                    is_pure_math = true
                }
            }
            if !is_pure_math {
                z.has_call = 1
                z.version += 1
            }
        }
        if k == mi_arr_push || k == mi_arr_push4 {
            z.has_arr_push = 1
            z.version += 1
        }
        if k == mi_field_rmw {
            z.has_field_rmw = 1
            z.version += 1
        }
        if k == mi_store_field || k == mi_store_ptr || k == mi_store_buf_ptr {
            z.has_ptr_store = 1
            z.version += 1
        }
        if k == mi_store_index || k == mi_index_rmw {
            z.has_index_store = 1
            z.version += 1
        }
        if k == mi_drop || k == mi_drop_field || k == mi_drop_ptr_field || k == mi_drop_buf_field {
            z.version += 1
        }
        ii = mfn_inext(&f.instrs, ii)
    }
    << z
}

fn mir_loop_mem_can_hoist_load(z &LoopMemFacts) bool {
    if z.has_call != 0 { << false }
    if z.has_arr_push != 0 { << false }
    if z.has_field_rmw != 0 { << false }
    if z.has_ptr_store != 0 { << false }
    if z.has_index_store != 0 { << false }
    << true
}

fn mir_licm_instr_dest(f &MFn, ii int) int {
    k := mfn_ikind(&f.instrs, ii)
    ia := mfn_ia(&f.instrs, ii)
    if k == mi_chan_try_recv { << -1 }
    if !mir_instr_has_dest(k) { << -1 }
    if k == mi_call && ia < 0 { << -1 }
    << ia
}

fn mir_licm_redef_after(f &MFn, start int, dest int) bool {
    if dest < 0 { << false }
    mut p := start
    for _ in 0:f.instrs.len {
        if p < 0 { << false }
        if mfn_ikind(&f.instrs, p) == mi_chan_try_recv {
            da := mfn_ia(&f.instrs, p)
            db := mfn_ib(&f.instrs, p)
            if da == dest { << true }
            if db == dest { << true }
        } else {
            d := mir_licm_instr_dest(f, p)
            if d == dest { << true }
        }
        p = mfn_inext(&f.instrs, p)
    }
    << false
}

fn mir_licm_unique(ndef &[]int, dest int) bool {
    if dest < 0 || dest >= ndef.len { << false }
    << ndef[dest] == 1
}
fn mir_licm_block_stores(f &MFn, bi int, loc int) bool {
    mut p := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if p < 0 { << false }
        k := mfn_ikind(&f.instrs, p)
        ia := mfn_ia(&f.instrs, p)
        ic := mfn_ic(&f.instrs, p)
        // StoreLocal of this local only. FieldRMW/StoreField through an
        // ElemAddr pointer does not store the array descriptor local
        // (nbody sys[i].vx -= must not poison sys).
        if k == mi_store_local && ia == loc { << true }
        if k == mi_addr && ic == 0 { << true }
        p = mfn_inext(&f.instrs, p)
    }
    << false
}

fn mir_licm_val_inv(v int, loop_defs &[]bool, hoisted &[]bool) bool {
    if v < 0 { << true }
    if v >= 0 && v < loop_defs.len {
        << !loop_defs[v] || hoisted[v]
    }
    << true
}

fn mir_licm_local_addr_taken(f &MFn, loc int) bool {
    for bi in 0:f.blocks.len {
        mut p := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if p < 0 { <- }
            k := mfn_ikind(&f.instrs, p)
            ic := mfn_ic(&f.instrs, p)
            ib := mfn_ib(&f.instrs, p)
            if k == mi_addr && ic == 0 && ib == loc { << true }
            p = mfn_inext(&f.instrs, p)
        }
    }
    << false
}

fn mir_licm_self_loops(f &mut MFn) {
    nloc := f.locals.len
    ntmp := f.temps.len
    mut ndef := []int{}
    for _ in 0:ntmp {
        ndef.push(0)
    }
    for bi0 in 0:f.blocks.len {
        mut p := f.blocks[bi0].head
        for _ in 0:f.instrs.len {
            if p < 0 { <- }
            if mfn_ikind(&f.instrs, p) == mi_chan_try_recv {
                da := mfn_ia(&f.instrs, p)
                db := mfn_ib(&f.instrs, p)
                if da >= 0 && da < ndef.len {
                    nva := ndef[da] + 1
                    mfn_set_i(mut &ndef, da, nva)
                }
                if db >= 0 && db < ndef.len {
                    nvb := ndef[db] + 1
                    mfn_set_i(mut &ndef, db, nvb)
                }
            } else {
                d := mir_licm_instr_dest(&*f, p)
                if d >= 0 && d < ndef.len {
                    nvd := ndef[d] + 1
                    mfn_set_i(mut &ndef, d, nvd)
                }
            }
            p = mfn_inext(&f.instrs, p)
        }
    }
    for bi in 0:f.blocks.len {
        if !f.is_self_loop(bi) { -> }
        pred := f.unique_ext_pred(bi)
        if pred < 0 { -> }
        mut skip := false
        mut has_call := false
        mut stored := []bool{}
        for _ in 0:nloc {
            stored.push(false)
        }
        mut stored_ptr := []bool{}
        for _ in 0:ntmp {
            stored_ptr.push(false)
        }
        mut stored_slots := []int{}
        mut loop_defs := []bool{}
        for _ in 0:ntmp {
            loop_defs.push(false)
        }
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            ia := mfn_ia(&f.instrs, ii)
            ib := mfn_ib(&f.instrs, ii)
            ic := mfn_ic(&f.instrs, ii)
            if k == mi_call {
                mut is_pure_math := false
                if mfn_ib(&f.instrs, ii) == 1 {
                    lab := mfn_isval(&f.instrs, ii)
                    if lab == "_xu_math_sqrt" || lab == "_xu_math_clz" || lab == "_xu_math_ctz" || lab == "_xu_math_ones_count" || lab == "_xu_math_reverse_bits" || lab == "_xu_math_byte_swap" {
                        is_pure_math = true
                    }
                }
                if !is_pure_math {
                    has_call = true
                }
                if mfn_ib(&f.instrs, ii) == 95 {
                    packed := mfn_id(&f.instrs, ii)
                    stored_slots.push(packed / 64)
                }
            }
            if k == mi_array_lit || k == mi_arr_push || k == mi_arr_push4 || k == mi_chan_new || k == mi_chan_send || k == mi_chan_recv || k == mi_xu || k == mi_chan_close || k == mi_chan_try_send || k == mi_chan_try_recv || k == mi_xu_pump {
                skip = true
            }
            // Primer does not skip the whole latch on AddrOf. LoadLocal
            // hoist already uses mir_licm_local_addr_taken. Skipping here
            // killed nbody `sys[i]` ElemAddr LICM.
            if k == mi_store_local {
                if ia >= 0 && ia < stored.len {
                    stored[ia] = true
                }
            }
            // Pointer temps stored through. LoadField of sys[i].vx must stay
            // in the j loop; the array descriptor is a different temp.
            if k == mi_store_field || k == mi_store_ptr || k == mi_store_buf_ptr {
                if ib >= 0 && ib < stored_ptr.len {
                    stored_ptr[ib] = true
                }
                stored_slots.push(ic)
            }
            if k == mi_field_rmw {
                if ia >= 0 && ia < stored_ptr.len {
                    stored_ptr[ia] = true
                }
                stored_slots.push(mfn_iline(&f.instrs, ii))
            }
            d := mir_licm_instr_dest(&*f, ii)
            if d >= 0 && d < loop_defs.len { loop_defs[d] = true }
            if k == mi_chan_try_recv {
                if ia >= 0 && ia < loop_defs.len { loop_defs[ia] = true }
                if ib >= 0 && ib < loop_defs.len { loop_defs[ib] = true }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        if skip { -> }
        mem := mir_loop_mem_facts(&*f, bi)
        mem_ok := mir_loop_mem_can_hoist_load(&mem)
        pred_loop := f.is_self_loop(pred)
        mut hoist := []int{}
        mut hoisted := []bool{}
        for _ in 0:ntmp { hoisted.push(false) }
        ii = f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := mfn_inext(&f.instrs, ii)
            k := mfn_ikind(&f.instrs, ii)
            ib := mfn_ib(&f.instrs, ii)
            ic := mfn_ic(&f.instrs, ii)
            dest := mir_licm_instr_dest(&*f, ii)
            mut take := false
            if k == mi_store_local {
                // StoreLocal of an invariant f64 (nbody `mi := sys[i].mass`
                // in the j latch). Has no temp dest so the unique-dest
                // gate below would refuse it. A following LICM pass then
                // hoists LoadLocal of that local.
                lid := mfn_ia(&f.instrs, ii)
                src := ib
                if lid >= 0 && lid < f.locals.len && f.locals[lid] == 4 {
                    if mir_licm_val_inv(src, &loop_defs, &hoisted) {
                        take = true
                    }
                }
            }
            if !take && mir_licm_unique(&ndef, dest) {
                if dest < 0 || !mir_licm_redef_after(&*f, nxt, dest) {
                    if k == mi_load_local {
                        lid := ib
                        if lid >= 0 && lid < stored.len && !stored[lid] && (!has_call || !mir_licm_local_addr_taken(&*f, lid)) {
                            mut pred_st := false
                            if pred_loop {
                                pred_st = mir_licm_block_stores(&*f, pred, lid)
                            }
                            if !pred_st { take = true }
                        }
                    } else if k == mi_load_field || k == mi_load_ptr || k == mi_load_buf_ptr {
                        // LoadField / LoadPtr / LoadBufPtr: only when the
                        // loop's memory version is unchanged. FieldRMW,
                        // pointer/index stores, calls and ArrPush bump it.
                        // Or when the read field slot is never written in the loop
                        // and the loop contains no call, arr_push or index_store.
                        b_tmp := ib
                        slot := ic
                        mut slot_stored := false
                        for si in 0:stored_slots.len {
                            if stored_slots[si] == slot {
                                slot_stored = true
                            }
                        }
                        mut can_hoist_mem := mem_ok
                        if !can_hoist_mem && mem.has_call == 0 && mem.has_arr_push == 0 && !slot_stored {
                            slots := mfn_id(&f.instrs, ii)
                            if mem.has_index_store == 0 || (k == mi_load_ptr && slots >= 2) {
                                can_hoist_mem = true
                            }
                        }
                        if can_hoist_mem {
                            if mir_licm_val_inv(b_tmp, &loop_defs, &hoisted) {
                                mut blocked := false
                                if slot_stored && b_tmp >= 0 && b_tmp < stored_ptr.len && stored_ptr[b_tmp] {
                                    blocked = true
                                }
                                if !blocked {
                                    take = true
                                }
                            }
                        }
                    } else if k == mi_elem_addr {
                        // ElemAddr is pure address arithmetic (base + idx * stride).
                        // It does not access memory; it only requires invariant operands.
                        b_tmp := ib
                        idx_val := ic
                        if mir_licm_val_inv(b_tmp, &loop_defs, &hoisted) && mir_licm_val_inv(idx_val, &loop_defs, &hoisted) {
                            take = true
                        }
                    } else if k == mi_copy {
                        v := ib
                        if mir_licm_val_inv(v, &loop_defs, &hoisted) { take = true }
                    } else if k == mi_un {
                        v := ic
                        if mir_licm_val_inv(v, &loop_defs, &hoisted) { take = true }
                    }
                    // Bin LICM is intentionally omitted.  Hoisting an
                    // invariant Mul/Add out of indexed loops breaks the
                    // emitter's row-walk recognition; keep Load/Copy/Un
                    // LICM while a frame-neutral use analysis is designed.
                }
            }
            if take {
                if dest >= 0 && dest < hoisted.len { hoisted[dest] = true }
                hoist.push(ii)
            }
            ii = nxt
        }
        for hi in 0:hoist.len {
            mir_detach_instr(f, bi, hoist[hi])
            mir_append_instr(f, pred, hoist[hi])
        }
    }
    mir_licm_two_block_loops(f)
}

fn mir_unique_ext_pred_excluding(f &MFn, bi int, exclude int) int {
    mut pred := -1
    for pi in 0:f.blocks.len {
        if pi == bi || pi == exclude { -> }
        mut hits := false
        tk := f.blocks[pi].tkind
        if tk == 1 && f.blocks[pi].ta == bi { hits = true }
        if tk == 2 && (f.blocks[pi].tb == bi || f.blocks[pi].tc == bi) { hits = true }
        if hits {
            if pred >= 0 { << -1 }
            pred = pi
        }
    }
    << pred
}

fn mir_licm_two_block_loops(f &mut MFn) {
    nloc := f.locals.len
    ntmp := f.temps.len
    mut ndef := []int{}
    for _ in 0:ntmp { ndef.push(0) }
    for bi0 in 0:f.blocks.len {
        mut p := f.blocks[bi0].head
        for _ in 0:f.instrs.len {
            if p < 0 { <- }
            if mfn_ikind(&f.instrs, p) == mi_chan_try_recv {
                da := mfn_ia(&f.instrs, p)
                db := mfn_ib(&f.instrs, p)
                if da >= 0 && da < ndef.len {
                    nva := ndef[da] + 1
                    mfn_set_i(mut &ndef, da, nva)
                }
                if db >= 0 && db < ndef.len {
                    nvb := ndef[db] + 1
                    mfn_set_i(mut &ndef, db, nvb)
                }
            } else {
                d := mir_licm_instr_dest(&*f, p)
                if d >= 0 && d < ndef.len {
                    nvd := ndef[d] + 1
                    mfn_set_i(mut &ndef, d, nvd)
                }
            }
            p = mfn_inext(&f.instrs, p)
        }
    }
    for header in 0:f.blocks.len {
        if f.blocks[header].tkind != 2 { -> }
        mut body := -1
        tb := f.skip_empty_jumps(f.blocks[header].tb)
        tc := f.skip_empty_jumps(f.blocks[header].tc)
        if tb >= 0 && tb < f.blocks.len && tb != header && f.blocks[tb].tkind == 1 && f.skip_empty_jumps(f.blocks[tb].ta) == header {
            body = tb
        } else if tc >= 0 && tc < f.blocks.len && tc != header && f.blocks[tc].tkind == 1 && f.skip_empty_jumps(f.blocks[tc].ta) == header {
            body = tc
        }
        if body < 0 { -> }
        if f.unique_ext_pred(body) != header { -> }
        pred := mir_unique_ext_pred_excluding(&*f, header, body)
        if pred < 0 || pred == body || pred == header { -> }

        mut skip := false
        mut has_call := false
        mut stored := []bool{}
        for _ in 0:nloc { stored.push(false) }
        mut stored_ptr := []bool{}
        for _ in 0:ntmp { stored_ptr.push(false) }
        mut stored_slots := []int{}
        mut loop_defs := []bool{}
        for _ in 0:ntmp { loop_defs.push(false) }

        for step in 0:2 {
            mut cur_blk := header
            if step == 1 { cur_blk = body }
            mut ii := f.blocks[cur_blk].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                k := mfn_ikind(&f.instrs, ii)
                ia := mfn_ia(&f.instrs, ii)
                ib := mfn_ib(&f.instrs, ii)
                ic := mfn_ic(&f.instrs, ii)
                if k == mi_call {
                    mut is_pure_math := false
                    if mfn_ib(&f.instrs, ii) == 1 {
                        lab := mfn_isval(&f.instrs, ii)
                        if lab == "_xu_math_sqrt" || lab == "_xu_math_clz" || lab == "_xu_math_ctz" || lab == "_xu_math_ones_count" || lab == "_xu_math_reverse_bits" || lab == "_xu_math_byte_swap" {
                            is_pure_math = true
                        }
                    }
                    if !is_pure_math { has_call = true }
                    if mfn_ib(&f.instrs, ii) == 95 {
                        packed := mfn_id(&f.instrs, ii)
                        stored_slots.push(packed / 64)
                    }
                }
                if k == mi_array_lit || k == mi_arr_push || k == mi_arr_push4 || k == mi_chan_new || k == mi_chan_send || k == mi_chan_recv || k == mi_xu || k == mi_chan_close || k == mi_chan_try_send || k == mi_chan_try_recv || k == mi_xu_pump {
                    skip = true
                }
                if k == mi_store_local {
                    if ia >= 0 && ia < stored.len { stored[ia] = true }
                }
                if k == mi_store_field || k == mi_store_ptr || k == mi_store_buf_ptr {
                    if ib >= 0 && ib < stored_ptr.len { stored_ptr[ib] = true }
                    stored_slots.push(ic)
                }
                if k == mi_field_rmw {
                    if ia >= 0 && ia < stored_ptr.len { stored_ptr[ia] = true }
                    stored_slots.push(mfn_iline(&f.instrs, ii))
                }
                d := mir_licm_instr_dest(&*f, ii)
                if d >= 0 && d < loop_defs.len { loop_defs[d] = true }
                if k == mi_chan_try_recv {
                    if ia >= 0 && ia < loop_defs.len { loop_defs[ia] = true }
                    if ib >= 0 && ib < loop_defs.len { loop_defs[ib] = true }
                }
                ii = mfn_inext(&f.instrs, ii)
            }
        }
        if skip { -> }

        mem_h := mir_loop_mem_facts(&*f, header)
        mem_b := mir_loop_mem_facts(&*f, body)
        mem_ok := mir_loop_mem_can_hoist_load(&mem_h) && mir_loop_mem_can_hoist_load(&mem_b)
        pred_loop := f.is_self_loop(pred)

        mut hoist := []int{}
        mut hoisted := []bool{}
        for _ in 0:ntmp { hoisted.push(false) }

        mut ii := f.blocks[header].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := mfn_inext(&f.instrs, ii)
            k := mfn_ikind(&f.instrs, ii)
            ib := mfn_ib(&f.instrs, ii)
            ic := mfn_ic(&f.instrs, ii)
            dest := mir_licm_instr_dest(&*f, ii)
            mut take := false
            if mir_licm_unique(&ndef, dest) {
                if dest < 0 || !mir_licm_redef_after(&*f, nxt, dest) {
                    if k == mi_load_local {
                        lid := ib
                        if lid >= 0 && lid < stored.len && !stored[lid] && (!has_call || !mir_licm_local_addr_taken(&*f, lid)) {
                            mut pred_st := false
                            if pred_loop { pred_st = mir_licm_block_stores(&*f, pred, lid) }
                            if !pred_st { take = true }
                        }
                    } else if k == mi_load_field || k == mi_load_ptr || k == mi_load_buf_ptr {
                        b_tmp := ib
                        slot := ic
                        mut slot_stored := false
                        for si in 0:stored_slots.len {
                            if stored_slots[si] == slot { slot_stored = true }
                        }
                        mut can_hoist_mem := mem_ok
                        if !can_hoist_mem && mem_h.has_call == 0 && mem_b.has_call == 0 && mem_h.has_arr_push == 0 && mem_b.has_arr_push == 0 && !slot_stored {
                            slots := mfn_id(&f.instrs, ii)
                            if (mem_h.has_index_store == 0 && mem_b.has_index_store == 0) || (k == mi_load_ptr && slots >= 2) {
                                can_hoist_mem = true
                            }
                        }
                        if can_hoist_mem {
                            if mir_licm_val_inv(b_tmp, &loop_defs, &hoisted) {
                                mut blocked := false
                                if slot_stored && b_tmp >= 0 && b_tmp < stored_ptr.len && stored_ptr[b_tmp] {
                                    blocked = true
                                }
                                if !blocked { take = true }
                            }
                        }
                    } else if k == mi_elem_addr {
                        b_tmp := ib
                        idx_val := ic
                        if mir_licm_val_inv(b_tmp, &loop_defs, &hoisted) && mir_licm_val_inv(idx_val, &loop_defs, &hoisted) {
                            take = true
                        }
                    } else if k == mi_copy {
                        v := ib
                        if mir_licm_val_inv(v, &loop_defs, &hoisted) { take = true }
                    } else if k == mi_un {
                        v := ic
                        if mir_licm_val_inv(v, &loop_defs, &hoisted) { take = true }
                    }
                }
            }
            if take {
                if dest >= 0 && dest < hoisted.len { hoisted[dest] = true }
                hoist.push(ii)
            }
            ii = nxt
        }
        for hi in 0:hoist.len {
            mir_detach_instr(f, header, hoist[hi])
            mir_append_instr(f, pred, hoist[hi])
        }
    }
}

fn mir_bce_is_index(k int) bool {
    if k == 14 || k == 20 || k == 23 || k == 47 { << true }
    << false
}

fn mir_bce_base(k int, ia int, ib int) int {
    if k == 14 || k == 23 { << ib }
    << ia
}

fn mir_bce_idx(k int, ib int, ic int) int {
    if k == 14 || k == 23 { << ic }
    << ib
}

fn mir_bce_canon(tmap &[]int, v int) int {
    if v >= 0 && v < tmap.len {
        loc1 := tmap[v]
        if loc1 > 0 {
            << 0 - 2000000 - (loc1 - 1)
        }
        if loc1 < 0 {
            << loc1
        }
    }
    << v
}

fn mir_bce_set_nocheck(f &mut MFn, ii int) {
    d := mfn_id(&f.instrs, ii)
    if d <= 0 { << }
    f.instrs[ii].d = 0 - d
}

// Duplicate bounds-check elimination across all basic blocks (including self-loops).
// The first checked LoadIndex/StoreIndex/ElemAddr/IndexRMW of a proven (arr, i) pair
// stays loud; later ops in the same basic block or self-loop with the same canonical
// arr/i become nocheck. Duplicate ElemAddr in the same basic block are CSE'd to Copy.
// Call or ArrPush invalidates the cached pairs (descriptor/len may change).
// StoreLocal invalidates entries referencing that modified local.
fn mir_bce_dup_self_loops(f &mut MFn) {
    ntmp := f.temps.len
    nloc := f.locals.len
    for bi in 0:f.blocks.len {
        mut tmap := []int{}
        for _ in 0:ntmp { tmap.push(0) }
        mut kb := []int{}
        mut ki := []int{}
        mut kp := []int{}
        mut fb_base := []int{}
        mut fb_slot := []int{}
        mut fb_id := []int{}
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == mi_call || k == mi_arr_push || k == mi_arr_push4 {
                kb = []int{}
                ki = []int{}
                kp = []int{}
                fb_base = []int{}
                fb_slot = []int{}
                fb_id = []int{}
            }
            if k == mi_store_field || k == mi_store_ptr || k == mi_store_buf_ptr || k == mi_field_rmw {
                fb_base = []int{}
                fb_slot = []int{}
                fb_id = []int{}
            }
            ia := mfn_ia(&f.instrs, ii)
            ib := mfn_ib(&f.instrs, ii)
            ic := mfn_ic(&f.instrs, ii)
            id := mfn_id(&f.instrs, ii)
            dest := mir_licm_instr_dest(&*f, ii)
            if dest >= 0 && dest < tmap.len {
                mfn_set_i(mut &tmap, dest, 0)
            }
            if k == mi_load_local {
                if ia >= 0 && ia < tmap.len && ib >= 0 && ib < nloc {
                    mfn_set_i(mut &tmap, ia, ib + 1)
                }
            }
            if k == mi_copy {
                if ia >= 0 && ia < tmap.len && ib >= 0 && ib < tmap.len {
                    srcm := tmap[ib]
                    if srcm != 0 {
                        mfn_set_i(mut &tmap, ia, srcm)
                    } else {
                        cid := 0 - 4000000 - ib
                        mfn_set_i(mut &tmap, ib, cid)
                        mfn_set_i(mut &tmap, ia, cid)
                    }
                }
            }
            if (k == mi_load_field || k == mi_load_ptr) && ia >= 0 && ia < tmap.len {
                b_can := mir_bce_canon(&tmap, ib)
                slot := ic
                mut found := -1
                for fi in 0:fb_base.len {
                    if fb_base[fi] == b_can && fb_slot[fi] == slot {
                        found = fi
                    }
                }
                if found >= 0 {
                    mfn_set_i(mut &tmap, ia, fb_id[found])
                } else {
                    nid := 0 - 3000000 - fb_base.len
                    fb_base.push(b_can)
                    fb_slot.push(slot)
                    fb_id.push(nid)
                    mfn_set_i(mut &tmap, ia, nid)
                }
            }
            if k == mi_store_local && ia >= 0 && ia < nloc {
                lk := 0 - 2000000 - ia
                for j in 0:kb.len {
                    kbj := kb[j]
                    kij := ki[j]
                    if kbj == lk || kij == lk {
                        mfn_set_i(mut &kb, j, -1)
                        mfn_set_i(mut &kp, j, -1)
                    }
                }
                for fi in 0:fb_base.len {
                    if fb_base[fi] == lk {
                        mfn_set_i(mut &fb_base, fi, -1)
                    }
                }
                for t in 0:tmap.len {
                    cur := tmap[t]
                    if cur == ia + 1 {
                        mfn_set_i(mut &tmap, t, 0)
                    }
                }
            }
            if mir_bce_is_index(k) && id > 0 {
                b := mir_bce_canon(&tmap, mir_bce_base(k, ia, ib))
                ix := mir_bce_canon(&tmap, mir_bce_idx(k, ib, ic))
                mut hit := false
                mut hit_idx := -1
                for j in 0:kb.len {
                    if kb[j] == b && ki[j] == ix {
                        hit = true
                        hit_idx = j
                    }
                }
                if hit {
                    if k == mi_elem_addr && hit_idx >= 0 && hit_idx < kp.len && kp[hit_idx] >= 0 {
                        prev_ptr := kp[hit_idx]
                        mfn_set_copy(mut &f.instrs, ii, prev_ptr)
                        if ia >= 0 && ia < tmap.len {
                            cid := 0 - 4000000 - prev_ptr
                            mfn_set_i(mut &tmap, prev_ptr, cid)
                            mfn_set_i(mut &tmap, ia, cid)
                        }
                    } else {
                        mir_bce_set_nocheck(f, ii)
                    }
                } else {
                    kb.push(b)
                    ki.push(ix)
                    if k == mi_elem_addr && ia >= 0 {
                        kp.push(ia)
                    } else {
                        kp.push(-1)
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
}
