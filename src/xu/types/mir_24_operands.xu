@xu/types

// Index/descriptor operands encode a LocalId as base + LocalId; lower
// nonnegative values are TempIds. Shared by lowering, MIR passes, native
// emitters and WASM. This is an encoding contract, not a tuning budget.
pub const mir_local_operand_base = 1073741824

// Shared read roles, not instruction destinations or machine clobbers.
// Low bits a/b/c/d identify Temp-only operands; bits 4..7 identify Values
// (Temp or constant). A chain flag identifies an MArg head, never a Temp.
// Unknown/reserved kinds and invalid Addr modes are conservative barriers.
const mir_use_arg_b = 256
const mir_use_arg_c = 512
const mir_use_arg_d = 1024

// Semantic instruction effects.  These are target-independent MIR facts;
// selection may still discharge a Call through an inline instruction (for
// example hardware sqrt), so physical clobbers remain a later target query.
// `call` means some emitted path calls; `call_live` means a call can return
// to the following MIR and therefore clobber values live across this op.
pub const mir_effect_read = 1
pub const mir_effect_write = 2
pub const mir_effect_grow = 4
pub const mir_effect_alloc = 8
pub const mir_effect_free = 16
pub const mir_effect_call = 32
pub const mir_effect_call_live = 64
pub const mir_effect_trap = 128
pub const mir_effect_all = 255

// This refines the conservative Bin effect only after the consumer proves
// scalar operands and excludes string metadata. Div/Mod, shifts and unknown
// opcodes retain their established trap/effect path.
fn mir_binop_scalar_cse_op(op int) bool {
    << (op >= 1 && op <= 3) || (op >= 14 && op <= 16)
}

// Kind/subkind effects that do not depend on the containing function's type
// tables.  Unknown kinds are full barriers.  Context-dependent effects such
// as Drop and owning-element replacement are added by mir_instr_effects_m.
pub fn mir_instr_effects(k int, call_kind int) int {
    // Bin is overloaded with string concat/compare. Without the containing
    // type/sval contract it cannot be treated as scalar arithmetic.
    if k == 4 { << -1 }
    if k == 0 || k == 1 || k == 2 || k == 3 || k == 4 || k == 5 || k == 6 || k == 10 || k == 11 || k == 15 || k == 16 || k == 17 || k == 18 || k == 25 || k == 26 || k == 38 || k == 41 || k == 48 {
        if k == 2 || k == 10 || k == 15 || k == 17 || k == 26 || k == 41 { << mir_effect_read }
        if k == 48 { << mir_effect_read | mir_effect_write }
        if k == 3 || k == 11 || k == 18 || k == 25 { << mir_effect_write }
        if k == 4 || k == 5 { << mir_effect_trap }
        << 0
    }
    if k == 7 {
        // FieldRMW is represented as a Call for historical MIR compatibility,
        // but its selected operation is an inline load/op/store sequence.
        if call_kind == 95 { << mir_effect_read | mir_effect_write }
        // An opaque callee may grow, allocate or release memory. Consumers
        // must not derive absence of those effects from an unknown call.
        << mir_effect_all
    }
    if k == 8 || k == 21 || k == 22 || k == 24 {
        << mir_effect_read | mir_effect_write | mir_effect_free | mir_effect_call | mir_effect_call_live
    }
    if k == 9 || k == 39 || k == 40 || k == 44 {
        << mir_effect_read | mir_effect_write | mir_effect_alloc | mir_effect_call | mir_effect_call_live
    }
    if k == 12 {
        << mir_effect_write | mir_effect_alloc | mir_effect_call | mir_effect_call_live
    }
    if k == 13 || k == 46 {
        << mir_effect_read | mir_effect_write | mir_effect_grow | mir_effect_alloc | mir_effect_free | mir_effect_call | mir_effect_call_live
    }
    if k == 47 {
        << mir_effect_read | mir_effect_write | mir_effect_trap | mir_effect_call
    }
    if k == 14 || k == 23 {
        << mir_effect_read | mir_effect_trap | mir_effect_call
    }
    if k == 19 || k == 45 {
        // The failure helper does not return; the success edge bypasses it.
        << mir_effect_read | mir_effect_trap | mir_effect_call
    }
    if k == 20 {
        << mir_effect_read | mir_effect_write | mir_effect_trap | mir_effect_call
    }
    if k == 30 || k == 31 || k == 32 || k == 33 || k == 34 || k == 35 || k == 36 || k == 37 {
        << mir_effect_all
    }
    if k == 42 || k == 43 {
        << mir_effect_all
    }
    << -1
}

pub fn mir_effect_has(effects int, effect int) bool {
    if effects < 0 { << true }
    << (effects & effect) != 0
}

// Add type- and operand-dependent effects at the owning Mir boundary.  A
// Drop of a non-owning scalar is a no-op for call liveness; owning drops and
// replacement of owning array elements call release helpers and return.
pub fn mir_instr_effects_m(m &Mir, fi int, ii int) int {
    if fi < 0 || fi >= m.fns.len || ii < 0 || ii >= mir_nins(m, fi) { << -1 }
    k := mir_ikind(m, fi, ii)
    if k == mi_bin {
        dest := mir_ia(m, fi, ii)
        if dest < 0 || dest >= mir_ntemps(m, fi) { << -1 }
        if mir_ib(m, fi, ii) == 1 && mir_temp_ty(m, fi, dest) == 3 {
            << mir_effect_read | mir_effect_write | mir_effect_alloc | mir_effect_call | mir_effect_call_live
        }
        if mir_isval(m, fi, ii) == "str_cmp" {
            << mir_effect_read | mir_effect_call | mir_effect_call_live
        }
        << mir_effect_trap
    }
    e := mir_instr_effects(k, mir_ib(m, fi, ii))
    if e < 0 { << e }
    if k == mi_array_lit && mir_ib(m, fi, ii) == 0 {
        << e - mir_effect_alloc - mir_effect_call - mir_effect_call_live
    }
    if k == mi_drop {
        loc := mir_ia(m, fi, ii)
        if loc < 0 || loc >= mir_nlocals(m, fi) { << -1 }
        if !m.type_owning(mir_local_ty(m, fi, loc)) {
            << 0
        }
    }
    if k == mi_store_index {
        base := mir_ia(m, fi, ii)
        mut aty := -1
        if base >= mir_local_operand_base {
            lid := base - mir_local_operand_base
            if lid >= 0 && lid < mir_nlocals(m, fi) {
                aty = mir_local_ty(m, fi, lid)
            }
        } else if base >= 0 && base < mir_ntemps(m, fi) {
            aty = mir_temp_ty(m, fi, base)
        }
        if aty >= 2000 && aty < 3000 { aty = aty - 2000 }
        if aty >= 1000 && aty < 2000 { aty = aty - 1000 }
        if is_array_type(aty) {
            ai := aty - 200
            if ai >= 0 && ai < m.arrays.len {
                if m.type_owning(m.arrays[ai].elem_ty) {
                    << e | mir_effect_free | mir_effect_call | mir_effect_call_live
                }
            }
        }
    }
    << e
}

pub fn mir_instr_call_live_m(m &Mir, fi int, ii int) bool {
    << mir_effect_has(mir_instr_effects_m(m, fi, ii), mir_effect_call_live)
}

pub fn mir_instr_use_schema(k int, mode int) int {
    if k == 0 || k == 2 || k == 6 || k == 8 || k == 37 || k == 38 { << 0 }
    if k == 1 || k == 3 || k == 9 || k == 32 { << 32 } // b Value
    if k == 4 { << 192 } // c,d Values
    if k == 5 || k == 30 || k == 36 { << 64 } // c Value
    if k == 7 || k == 12 || k == 33 { << mir_use_arg_c }
    if k == 10 || k == 15 || k == 17 || k == 19 || k == 26 || k == 39 || k == 40 || k == 41 || k == 42 || k == 44 || k == 45 { << 2 } // b Temp
    if k == 11 { << 3 } // a,b Temps
    if k == 13 { << 3 } // descriptor a Temp, element b Temp
    if k == 14 || k == 23 { << 66 } // descriptor b Temp, index c Value
    if k == 16 {
        if mode == 0 { << 0 } // b Local
        if mode == 1 { << 2 } // b Temp
        << -1
    }
    if k == 18 || k == 25 { << 18 } // a Value, pointer b Temp
    if k == 20 || k == 47 { << 97 } // descriptor a Temp, b,c Values
    if k == 21 || k == 22 || k == 24 { << 1 } // a Temp
    if k == 31 { << 18 } // a Value, b Temp
    if k == 34 { << 16 } // a Value
    if k == 35 { << 36 } // channel b Value, payload c Temp
    if k == 43 { << 2 | mir_use_arg_d } // receiver b Temp, args d MArg
    if k == 46 { << 1 | mir_use_arg_b } // descriptor a Temp, args b MArg
    if k == 48 { << 65 } // pointer a Temp, RHS c Value
    << -1
}

pub fn mir_instr_use_mask(schema int) int {
    if schema < 0 { << -1 }
    << (schema & 15) | ((schema >> 4) & 15)
}

pub fn mir_instr_use_arg_head(schema int, b int, c int, d int) int {
    if schema < 0 { << -1 }
    if (schema & mir_use_arg_b) != 0 { << b }
    if (schema & mir_use_arg_c) != 0 { << c }
    if (schema & mir_use_arg_d) != 0 { << d }
    << -1
}

// Compact, ordered read values from the shared operand contract. Constants
// retain their negative Value encoding; LocalIds and MArg heads are never
// returned as TempIds. Consumers validate an unknown schema before walking.
pub fn mir_instr_read_m(m &Mir, fi int, ii int, pos int) int {
    if fi < 0 || fi >= m.fns.len || ii < 0 || ii >= mir_nins(m, fi) || pos < 0 { << -1 }
    a := mir_ia(m, fi, ii)
    b := mir_ib(m, fi, ii)
    c := mir_ic(m, fi, ii)
    d := mir_id(m, fi, ii)
    schema := mir_instr_use_schema(mir_ikind(m, fi, ii), c)
    mask := mir_instr_use_mask(schema)
    if mask < 0 { << -1 }
    mut at := 0
    for field in 0:4 {
        if (mask & (1 << field)) == 0 { -> }
        if at == pos {
            if field == 0 { << a }
            if field == 1 { << b }
            if field == 2 { << c }
            << d
        }
        at += 1
    }
    mut ap := mir_instr_use_arg_head(schema, b, c, d)
    for _ in 0:mir_verify_max_arg_chain {
        if ap < 0 || ap >= mir_nmargs(m, fi) { << -1 }
        if at == pos { << mir_marg_v(m, fi, ap) }
        at += 1
        ap = mir_marg_next(m, fi, ap)
    }
    << -1
}

pub fn mir_instr_def_m(m &Mir, fi int, ii int) int {
    if fi < 0 || fi >= m.fns.len || ii < 0 || ii >= mir_nins(m, fi) { << -1 }
    k := mir_ikind(m, fi, ii)
    if mir_instr_use_schema(k, mir_ic(m, fi, ii)) < 0 || !mir_instr_has_dest(k) { << -1 }
    << mir_ia(m, fi, ii)
}

// Exact multiplicity for peepholes that require a single remaining use.
// Invalid/unknown records return at least two uses: they can prove neither
// deadness nor single-use ownership of a physical scratch register.
pub fn mir_instr_read_occurrences_m(m &Mir, fi int, ii int, t int) int {
    if t < 0 { << 0 }
    if fi < 0 || fi >= m.fns.len || ii < 0 || ii >= mir_nins(m, fi) { << 2 }
    schema := mir_instr_use_schema(mir_ikind(m, fi, ii), mir_ic(m, fi, ii))
    mask := mir_instr_use_mask(schema)
    if mask < 0 { << 2 }
    a := mir_ia(m, fi, ii)
    b := mir_ib(m, fi, ii)
    c := mir_ic(m, fi, ii)
    d := mir_id(m, fi, ii)
    mut count := 0
    if (mask & 1) != 0 && a == t { count += 1 }
    if (mask & 2) != 0 && b == t { count += 1 }
    if (mask & 4) != 0 && c == t { count += 1 }
    if (mask & 8) != 0 && d == t { count += 1 }
    mut ap := mir_instr_use_arg_head(schema, b, c, d)
    mut limit := mir_nmargs(m, fi)
    if limit > mir_verify_max_arg_chain { limit = mir_verify_max_arg_chain }
    for _ in 0:limit {
        if ap == -1 { << count }
        if ap < 0 || ap >= mir_nmargs(m, fi) { << count + 2 }
        if mir_marg_v(m, fi, ap) == t { count += 1 }
        ap = mir_marg_next(m, fi, ap)
    }
    if ap != -1 { << count + 2 }
    << count
}

fn mir_instr_use_fields_match(schema int, a int, b int, c int, d int, t int) bool {
    mask := mir_instr_use_mask(schema)
    if mask < 0 { << true }
    if (mask & 1) != 0 && a == t { << true }
    if (mask & 2) != 0 && b == t { << true }
    if (mask & 4) != 0 && c == t { << true }
    << (mask & 8) != 0 && d == t
}

// Numeric indexed access avoids a borrow into a large owning MFn. All
// emission consumers use the same roles as the owning-function optimizer.
pub fn mir_instr_uses_temp_m(m &Mir, fi int, ii int, t int) bool {
    if t < 0 { << false }
    if fi < 0 || fi >= m.fns.len { << true }
    if t >= mir_ntemps(m, fi) { << false }
    if ii < 0 || ii >= mir_nins(m, fi) { << true }
    k := mir_ikind(m, fi, ii)
    a := mir_ia(m, fi, ii)
    b := mir_ib(m, fi, ii)
    c := mir_ic(m, fi, ii)
    d := mir_id(m, fi, ii)
    schema := mir_instr_use_schema(k, c)
    if mir_instr_use_fields_match(schema, a, b, c, d, t) { << true }
    mut ap := mir_instr_use_arg_head(schema, b, c, d)
    nmarg := mir_nmargs(m, fi)
    mut limit := mir_verify_max_arg_chain
    if nmarg < limit { limit = nmarg }
    for _ in 0:limit {
        if ap == -1 { << false }
        if ap < 0 || ap >= nmarg { << true }
        if mir_marg_v(m, fi, ap) == t { << true }
        ap = mir_marg_next(m, fi, ap)
    }
    // A malformed/cyclic/oversize chain cannot prove any Temp dead.
    << ap != -1
}
