@xu/types
// Typed program view consumed by MIR lowering.
//
// The checker's side tables are private and are released after checking.
// check_typed copies the facts lowering needs into public tables so the MIR
// layer depends on this view only, never on checker internals.
//
// Node tables (ntype/nlocal/ncall/...) are indexed by parser node id. Generic
// instances share one template AST, so each instance carries its own copy of
// the node tables; TypedProgram.use_fn selects the tables for a function.

#xu/ast

pub struct TField {
pub:
    name      string
    ty        int
    offset    int
    bit_off   int
    bit_width int
    bit_unit  int
}

pub struct TStruct {
pub:
    name       string
    fields     []TField
    size       int
    align      int
    is_union   bool
    // has a user drop function
    has_drop   bool
    drop_label string
}

pub struct TArray {
pub:
    elem_ty    int
    elem_bytes int
    fixed_len  int
}

pub struct TThrow {
pub:
    ok_ty  int
    err_ty int
}

pub struct TDataReloc {
pub:
    off    int
    sym    string
    addend int
}

pub struct TGlobal {
pub:
    name       string
    lib        string
    sym        string
    ty         int
    is_mut     bool
    is_bss     bool
    align      int
    section    string
    has_init   bool
    init_bytes []int
    relocs     []TDataReloc
}

// Enum layout: [tag word][payload], payload field i at offsets[i] bytes.
pub struct TVariant {
pub:
    name    string
    fields  []int
    offsets []int
}

pub struct TEnum {
pub:
    name     string
    variants []TVariant
    size     int
}

pub struct TMap {
pub:
    key_ty int
    val_ty int
}

pub struct TFn {
pub:
    name        string
    label       string
    mod_id      string
    ret         int
    params      []int
    recv        int
    recv_mut    bool
    decl        int
    is_extern   bool
    is_template bool
    is_inst     bool
    // The last param is `name <-> T`: trailing call arguments pack into []T.
    variadic    bool
    may_throw   bool
    throw_ty    int
    locals      []int
    local_names []string
}

pub struct TypedProgram {
pub:
    fns         []TFn
    structs     []TStruct
    arrays      []TArray
    throws      []TThrow
    enums       []TEnum
    maps        []TMap
    // Element type of each channel type, by chan_index.
    chan_elems  []int
    strings     []string
    ref_targets []int
    const_tys   []int
    const_ivals []int
    const_strs  []int
    globals     []TGlobal
    // Node tables for the function selected by use_fn.
    // Tables of non-instance functions; instance tables live in inst_*.
    base_type   []int
    base_local  []int
    base_call   []int
    base_str    []int
    base_const  []int
    base_clone  []int
    base_shared []int
    base_box    []int
    inst_type   [][]int
    inst_local  [][]int
    inst_call   [][]int
    inst_str    [][]int
    inst_const  [][]int
    inst_clone  [][]int
    inst_shared [][]int
    inst_box    [][]int
    // First node id covered by each instance's rows.
    inst_lo     []int
    cur_fn int
    // Instance whose rows overlay the base tables (-1 = none).
    cur_inst int
    // (interface type, struct type) pairs boxed anywhere; filled by lowering.
    boxed []int
    // Function signatures by fn type index.
    sig_params [][]int
    sig_ret    []int
    // Per function: outer local ids a closure captures (-(f+2) = field f of
    // the enclosing closure's env) and the method a bound trampoline calls.
    clos_caps [][]int
    bound_mfi []int
}

pub fn tp_copy_ints(src &[]int) []int {
    << src[0:src.len]
}

pub fn typed_program_new() TypedProgram {
    << TypedProgram{
        fns: []TFn{},
        structs: []TStruct{},
        arrays: []TArray{},
        throws: []TThrow{},
        enums: []TEnum{},
        maps: []TMap{},
        chan_elems: []int{},
        strings: []string{},
        ref_targets: []int{},
        const_tys: []int{},
        const_ivals: []int{},
        const_strs: []int{},
        globals: []TGlobal{},
        base_type: []int{},
        base_local: []int{},
        base_call: []int{},
        base_str: []int{},
        base_const: []int{},
        base_clone: []int{},
        base_shared: []int{},
        base_box: []int{},
        inst_type: [][]int{},
        inst_local: [][]int{},
        inst_call: [][]int{},
        inst_str: [][]int{},
        inst_const: [][]int{},
        inst_clone: [][]int{},
        inst_shared: [][]int{},
        inst_box: [][]int{},
        inst_lo: []int{},
        cur_fn: -1,
        cur_inst: -1,
        boxed: []int{},
        sig_params: [][]int{},
        sig_ret: []int{},
        clos_caps: [][]int{},
        bound_mfi: []int{}
    }
}

// Select the node tables of function fi: an instance's rows overlay the
// base tables over its declaration's node range.
pub fn (tp $&TypedProgram) use_fn(fi int) {
    tp.cur_fn = fi
    tp.cur_inst = -1
    if fi >= 0 && fi < tp.fns.len && tp.fns[fi].is_inst && fi < tp.inst_lo.len {
        tp.cur_inst = fi
    }
}

// Row index of node n in the current instance's rows, or -1.
fn (tp &TypedProgram) inst_row(n int) int {
    fi := tp.cur_inst
    if fi < 0 { << -1 }
    k := n - tp.inst_lo[fi]
    if k < 0 || k >= tp.inst_type[fi].len { << -1 }
    << k
}

// Node-table reads tolerate ids past the table (nodes created after checking).
pub fn (tp &TypedProgram) type_of(n int) int {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_type[tp.cur_inst][k] }
    if n < 0 || n >= tp.base_type.len { << 0 }
    << tp.base_type[n]
}

pub fn (tp &TypedProgram) local_of(n int) int {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_local[tp.cur_inst][k] }
    if n < 0 || n >= tp.base_local.len { << -1 }
    << tp.base_local[n]
}

pub fn (tp &TypedProgram) call_of(n int) int {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_call[tp.cur_inst][k] }
    if n < 0 || n >= tp.base_call.len { << -1 }
    << tp.base_call[n]
}

pub fn (tp &TypedProgram) str_of(n int) int {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_str[tp.cur_inst][k] }
    if n < 0 || n >= tp.base_str.len { << -1 }
    << tp.base_str[n]
}

pub fn (tp &TypedProgram) const_of(n int) int {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_const[tp.cur_inst][k] }
    if n < 0 || n >= tp.base_const.len { << -1 }
    << tp.base_const[n]
}

pub fn (tp &TypedProgram) global_of(n int) int {
    v := tp.const_of(n)
    if v <= -1000 { << -1000 - v }
    << -1
}

// 1 when the checker requires a clone of the value read at n (a place read
// in a move position that must leave the source owned).
pub fn (tp &TypedProgram) clone_of(n int) int {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_clone[tp.cur_inst][k] }
    if n < 0 || n >= tp.base_clone.len { << 0 }
    << tp.base_clone[n]
}

// Whether the checker inserted a shared borrow of an ordinary place.
pub fn (tp &TypedProgram) borrows_place(n int) bool {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_shared[tp.cur_inst][k] == -1 }
    if n < 0 || n >= tp.base_shared.len { << false }
    << tp.base_shared[n] == -1
}

// Expected box type of an expression coerced into temp/any/struct@ (0 = none).
pub fn (tp &TypedProgram) box_of(n int) int {
    k := tp.inst_row(n)
    if k >= 0 { << tp.inst_box[tp.cur_inst][k] }
    if n < 0 || n >= tp.base_box.len { << 0 }
    << tp.base_box[n]
}

// Strip one direct reference level (&T / $&T -> T).
pub fn (tp &TypedProgram) deref(t int) int {
    << strip_direct_ref(&tp.ref_targets, t)
}

// Strip one reference level or raw pointer level (&T / $&T / *raw T -> T).
pub fn (tp &TypedProgram) deref_ptr(t int) int {
    if is_raw_ptr_type(t) {
        << ref_inner_type_at(&tp.ref_targets, t)
    }
    << strip_direct_ref(&tp.ref_targets, t)
}

// Size in bytes of a value of type t as laid out by the checker.
pub fn (tp &TypedProgram) size_of(t int) int {
    if t == 10 { << 1 }
    if t == 8 || t == 9 || t == 14 { << 4 }
    if t == 7 { << 1 }
    if t == 11 || t == 12 { << 2 }
    if t == 0 { << 0 }
    if t == 3 { << 24 }
    if is_array_type(t) {
        ai := array_index(t)
        if ai >= 0 && ai < tp.arrays.len && tp.arrays[ai].fixed_len > 0 {
            << tp.arrays[ai].fixed_len * tp.arrays[ai].elem_bytes
        }
        << 24
    }
    if is_struct_type(t) {
        si := struct_index(t)
        if si >= 0 && si < tp.structs.len { << tp.structs[si].size }
        << 0
    }
    // An interface value is one word: 0 or a box pointer.
    if is_interface_type(t) { << 8 }
    if is_fn_type(t) || is_temp_type(t) || is_any_type(t) { << 16 }
    if is_enum_type(t) {
        ei := enum_index(t)
        if ei >= 0 && ei < tp.enums.len { << tp.enums[ei].size }
        << 8
    }
    if is_throw_type(t) {
        ri := throw_index(t)
        if ri >= 0 && ri < tp.throws.len {
            $payload := tp.size_of(tp.throws[ri].ok_ty)
            es := tp.size_of(tp.throws[ri].err_ty)
            if es > payload { payload = es }
            << 8 + (payload + 7) / 8 * 8
        }
    }
    << 8
}

// Natural alignment in bytes of a value of type t.
pub fn (tp &TypedProgram) align_of(t int) int {
    if t == 0 || t == 2 || t == 7 || t == 10 { << 1 }
    if t == 11 || t == 12 { << 2 }
    if t == 8 || t == 9 || t == 14 { << 4 }
    if is_array_type(t) {
        ai := array_index(t)
        if ai >= 0 && ai < tp.arrays.len && tp.arrays[ai].fixed_len > 0 {
            << tp.align_of(tp.arrays[ai].elem_ty)
        }
        << 8
    }
    if is_struct_type(t) {
        si := struct_index(t)
        if si >= 0 && si < tp.structs.len && tp.structs[si].align > 0 { << tp.structs[si].align }
        << 1
    }
    << 8
}

// Number of 8-byte words a value of type t occupies.
pub fn (tp &TypedProgram) words_of(t int) int {
    sz := tp.size_of(t)
    if sz <= 0 { << 0 }
    << (sz + 7) / 8
}

// A value is a scalar when it fits one register: ints, bools, bytes,
// references, handles. Everything else lives in memory and is passed by address.
pub fn (tp &TypedProgram) is_scalar(t int) bool {
    if t == 3 { << false }
    if is_struct_type(t) || is_array_type(t) || is_throw_type(t) { << false }
    if is_fn_type(t) || is_temp_type(t) || is_any_type(t) { << false }
    // Payload-free enums are a bare tag word.
    if is_enum_type(t) { << tp.size_of(t) <= 8 }
    << true
}

pub fn (tp &TypedProgram) field_of(t int, name &string) TField {
    st := tp.deref(t)
    si := struct_index(st)
    if si >= 0 && si < tp.structs.len {
        for i in 0:tp.structs[si].fields.len {
            if tp.structs[si].fields[i].name == *name {
                f := &tp.structs[si].fields[i]
                << TField{name: *name + "", ty: f.ty, offset: f.offset, bit_off: f.bit_off, bit_width: f.bit_width, bit_unit: f.bit_unit}
            }
        }
    }
    << TField{name: "", ty: -1, offset: -1, bit_off: 0, bit_width: 0, bit_unit: 0}
}

pub fn (tp &TypedProgram) elem_of(t int) int {
    at := tp.deref(t)
    ai := array_index(at)
    if ai >= 0 && ai < tp.arrays.len { << tp.arrays[ai].elem_ty }
    << -1
}

pub fn ast_kind_name(k int) string {
    << ast.node_name(k)
}
