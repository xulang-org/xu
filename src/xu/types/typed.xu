@xu/types
// Typed program view consumed by MIR lowering.
//
// The checker's side tables are private and are released after checking.
// check_typed copies the facts lowering needs into public tables so the MIR
// layer depends on this view only, never on checker internals.
//
// Node tables (ntype/nlocal/ncall/...) are indexed by parser node id. Generic
// instances share one template AST, so each instance carries its own copy of
// the node tables; TypedProgram.use_fn selects the tables for a function.

#xu/ast
#xu/parser

pub struct TField {
pub:
    name   string
    ty     int
    offset int
}

pub struct TStruct {
pub:
    name   string
    fields []TField
    size   int
    align  int
}

pub struct TArray {
pub:
    elem_ty    int
    elem_bytes int
    fixed_len  int
}

pub struct TThrow {
pub:
    ok_ty  int
    err_ty int
}

pub struct TFn {
pub:
    name        string
    label       string
    mod_id      string
    ret         int
    params      []int
    recv        int
    recv_mut    bool
    decl        int
    is_extern   bool
    is_template bool
    is_inst     bool
    may_throw   bool
    throw_ty    int
    locals      []int
    local_names []string
}

pub struct TypedProgram {
pub:
    fns         []TFn
    structs     []TStruct
    arrays      []TArray
    throws      []TThrow
    strings     []string
    ref_targets []int
    const_tys   []int
    const_ivals []int
    const_strs  []int
    // Node tables for the function selected by use_fn.
    ntype   []int
    nlocal  []int
    ncall   []int
    nstr    []int
    nconst  []int
    nclone  []int
    nshared []int
    nbox    []int
    // Tables of non-instance functions; instance tables live in inst_*.
    base_type   []int
    base_local  []int
    base_call   []int
    base_str    []int
    base_const  []int
    base_clone  []int
    base_shared []int
    base_box    []int
    inst_type   [][]int
    inst_local  [][]int
    inst_call   [][]int
    inst_str    [][]int
    inst_const  [][]int
    inst_clone  [][]int
    inst_shared [][]int
    inst_box    [][]int
    cur_fn int
}

fn tp_copy_ints(src &[]int) []int {
    $out := []int{}
    for i in 0:src.len {
        out.push(src[i])
    }
    << out
}

pub fn typed_program_new() TypedProgram {
    << TypedProgram{
        fns: []TFn{},
        structs: []TStruct{},
        arrays: []TArray{},
        throws: []TThrow{},
        strings: []string{},
        ref_targets: []int{},
        const_tys: []int{},
        const_ivals: []int{},
        const_strs: []int{},
        ntype: []int{},
        nlocal: []int{},
        ncall: []int{},
        nstr: []int{},
        nconst: []int{},
        nclone: []int{},
        nshared: []int{},
        nbox: []int{},
        base_type: []int{},
        base_local: []int{},
        base_call: []int{},
        base_str: []int{},
        base_const: []int{},
        base_clone: []int{},
        base_shared: []int{},
        base_box: []int{},
        inst_type: [][]int{},
        inst_local: [][]int{},
        inst_call: [][]int{},
        inst_str: [][]int{},
        inst_const: [][]int{},
        inst_clone: [][]int{},
        inst_shared: [][]int{},
        inst_box: [][]int{},
        cur_fn: -1
    }
}

// Run the checker and export the typed view. Exits with status 1 after
// printing diagnostics when the program is ill-typed.
pub fn check_typed(p &parser.Parser, target_code int, lib_mode int, c $&Checker, out $&TypedProgram) {
    c.rebind = -1
    c.move_err_n = -1
    c.attr = -1
    c.cur_while = 0 - 1
    c.errors_iface = -1
    c.test_count = 1
    c.opt_level = 1
    c.seed_strmaps()
    c.seed_slices()
    c.prep_nodes(p.nodes.len)
    c.apply_target(target_code)
    c.lib_mode = lib_mode
    c.check_program(p)
    c.emit_warnings(p)
    if c.error_count > 0 {
        <<< 1
    }
    c.export_typed(out)
    c.release_after_check()
}

fn (c $&Checker) export_typed(out $&TypedProgram) {
    for i in 0:c.structs.len {
        $fields := []TField{}
        for j in 0:c.structs[i].fields.len {
            fields.push(TField{
                name: c.structs[i].fields[j].name + "",
                ty: c.structs[i].fields[j].ty,
                offset: c.structs[i].fields[j].slot
            })
        }
        out.structs.push(TStruct{
            name: c.structs[i].name + "",
            fields: fields,
            size: c.structs[i].size_bytes,
            align: c.structs[i].align_bytes
        })
    }
    for i in 0:c.arrays.len {
        out.arrays.push(TArray{
            elem_ty: c.arrays[i].elem_ty,
            elem_bytes: c.arrays[i].elem_bytes,
            fixed_len: c.arrays[i].fixed_len
        })
    }
    for i in 0:c.throws.len {
        out.throws.push(TThrow{ok_ty: c.throws[i].ok_ty, err_ty: c.throws[i].err_ty})
    }
    for i in 0:c.strings.len {
        out.strings.push(c.strings[i] + "")
    }
    for i in 0:c.ref_targets.len {
        out.ref_targets.push(c.ref_targets[i])
    }
    for i in 0:c.ctypes.len {
        out.const_tys.push(c.ctypes[i])
        $iv := 0
        if i < c.civals.len { iv = c.civals[i] }
        out.const_ivals.push(iv)
        $sv := -1
        if i < c.cstr_idx.len { sv = c.cstr_idx[i] }
        out.const_strs.push(sv)
    }
    out.base_type = tp_copy_ints(&c.ntype)
    out.base_local = tp_copy_ints(&c.nlocal)
    out.base_call = tp_copy_ints(&c.ncall)
    out.base_str = tp_copy_ints(&c.nstr)
    out.base_const = tp_copy_ints(&c.nconst)
    out.base_clone = tp_copy_ints(&c.nclone)
    out.base_shared = tp_copy_ints(&c.nshared)
    out.base_box = tp_copy_ints(&c.nbox)
    for fi in 0:c.fns.len {
        $is_inst := false
        if fi < c.is_inst.len && c.is_inst[fi] != 0 {
            is_inst = true
        }
        if is_inst && fi < c.inst_snap_ready.len && c.inst_snap_ready[fi] != 0 && fi < c.inst_snap_type.len && fi < c.inst_snap_local.len && fi < c.inst_snap_call.len && fi < c.inst_snap_str.len && fi < c.inst_snap_const.len && fi < c.inst_snap_clone.len && fi < c.inst_snap_shared.len && fi < c.inst_snap_box.len {
            out.inst_type.push(tp_copy_ints(&c.inst_snap_type[fi]))
            out.inst_local.push(tp_copy_ints(&c.inst_snap_local[fi]))
            out.inst_call.push(tp_copy_ints(&c.inst_snap_call[fi]))
            out.inst_str.push(tp_copy_ints(&c.inst_snap_str[fi]))
            out.inst_const.push(tp_copy_ints(&c.inst_snap_const[fi]))
            out.inst_clone.push(tp_copy_ints(&c.inst_snap_clone[fi]))
            out.inst_shared.push(tp_copy_ints(&c.inst_snap_shared[fi]))
            out.inst_box.push(tp_copy_ints(&c.inst_snap_box[fi]))
        } else {
            is_inst = false
            out.inst_type.push([]int{})
            out.inst_local.push([]int{})
            out.inst_call.push([]int{})
            out.inst_str.push([]int{})
            out.inst_const.push([]int{})
            out.inst_clone.push([]int{})
            out.inst_shared.push([]int{})
            out.inst_box.push([]int{})
        }
        $params := []int{}
        for j in 0:c.fns[fi].params.len {
            params.push(c.fns[fi].params[j])
        }
        $locals := []int{}
        $names := []string{}
        if fi < c.fnlocals.len {
            for j in 0:c.fnlocals[fi].len {
                locals.push(c.fnlocals[fi][j])
            }
        }
        if fi < c.fnlocal_names.len {
            for j in 0:c.fnlocal_names[fi].len {
                names.push(c.fnlocal_names[fi][j] + "")
            }
        }
        $may_throw := false
        $throw_ty := 0
        if fi < c.fn_may_throw.len && c.fn_may_throw[fi] != 0 {
            may_throw = true
            if fi < c.fn_throw_ty.len {
                throw_ty = c.fn_throw_ty[fi]
            }
        }
        $decl := -1
        if fi < c.fndecl.len {
            decl = c.fndecl[fi]
        }
        $safe_name := c.fns[fi].name + ""
        if fi < c.fn_safe_name.len { safe_name = c.fn_safe_name[fi] + "" }
        $safe_mod := ""
        if fi < c.fn_safe_mod.len { safe_mod = c.fn_safe_mod[fi] + "" }
        out.fns.push(TFn{
            name: safe_name,
            label: c.fns[fi].label + "",
            mod_id: safe_mod,
            ret: c.fns[fi].ret,
            params: params,
            recv: c.fns[fi].recv,
            recv_mut: c.fns[fi].recv_mut,
            decl: decl,
            is_extern: c.fns[fi].is_extern,
            is_template: c.fns[fi].is_template,
            is_inst: is_inst,
            may_throw: may_throw,
            throw_ty: throw_ty,
            locals: locals,
            local_names: names
        })
    }
}

// Select the node tables of function fi (instance snapshot or base tables).
pub fn (tp $&TypedProgram) use_fn(fi int) {
    if tp.cur_fn == fi {
        <<
    }
    $inst := false
    if fi >= 0 && fi < tp.fns.len && tp.fns[fi].is_inst {
        inst = true
    }
    if inst {
        tp.ntype = tp_copy_ints(&tp.inst_type[fi])
        tp.nlocal = tp_copy_ints(&tp.inst_local[fi])
        tp.ncall = tp_copy_ints(&tp.inst_call[fi])
        tp.nstr = tp_copy_ints(&tp.inst_str[fi])
        tp.nconst = tp_copy_ints(&tp.inst_const[fi])
        tp.nclone = tp_copy_ints(&tp.inst_clone[fi])
        tp.nshared = tp_copy_ints(&tp.inst_shared[fi])
        tp.nbox = tp_copy_ints(&tp.inst_box[fi])
    } else if tp.cur_fn < 0 || tp.fns[tp.cur_fn].is_inst {
        tp.ntype = tp_copy_ints(&tp.base_type)
        tp.nlocal = tp_copy_ints(&tp.base_local)
        tp.ncall = tp_copy_ints(&tp.base_call)
        tp.nstr = tp_copy_ints(&tp.base_str)
        tp.nconst = tp_copy_ints(&tp.base_const)
        tp.nclone = tp_copy_ints(&tp.base_clone)
        tp.nshared = tp_copy_ints(&tp.base_shared)
        tp.nbox = tp_copy_ints(&tp.base_box)
    }
    tp.cur_fn = fi
}

// Node-table reads tolerate ids past the table (nodes created after checking).
pub fn (tp &TypedProgram) type_of(n int) int {
    if n < 0 || n >= tp.ntype.len { << 0 }
    << tp.ntype[n]
}

pub fn (tp &TypedProgram) local_of(n int) int {
    if n < 0 || n >= tp.nlocal.len { << -1 }
    << tp.nlocal[n]
}

pub fn (tp &TypedProgram) call_of(n int) int {
    if n < 0 || n >= tp.ncall.len { << -1 }
    << tp.ncall[n]
}

pub fn (tp &TypedProgram) str_of(n int) int {
    if n < 0 || n >= tp.nstr.len { << -1 }
    << tp.nstr[n]
}

pub fn (tp &TypedProgram) const_of(n int) int {
    if n < 0 || n >= tp.nconst.len { << -1 }
    << tp.nconst[n]
}

// Strip one direct reference level (&T / $&T -> T).
pub fn (tp &TypedProgram) deref(t int) int {
    << strip_direct_ref(&tp.ref_targets, t)
}

// Size in bytes of a value of type t as laid out by the checker.
pub fn (tp &TypedProgram) size_of(t int) int {
    if t == 10 { << 1 }
    if t == 8 || t == 9 { << 4 }
    if t == 0 { << 0 }
    if t == 3 { << 24 }
    if is_array_type(t) {
        ai := array_index(t)
        if ai >= 0 && ai < tp.arrays.len && tp.arrays[ai].fixed_len > 0 {
            << tp.arrays[ai].fixed_len * tp.arrays[ai].elem_bytes
        }
        << 24
    }
    if is_struct_type(t) {
        si := struct_index(t)
        if si >= 0 && si < tp.structs.len { << tp.structs[si].size }
        << 0
    }
    if is_fn_type(t) || is_temp_type(t) || is_any_type(t) || is_interface_type(t) { << 16 }
    if is_throw_type(t) {
        ri := throw_index(t)
        if ri >= 0 && ri < tp.throws.len {
            $payload := tp.size_of(tp.throws[ri].ok_ty)
            es := tp.size_of(tp.throws[ri].err_ty)
            if es > payload { payload = es }
            << 8 + (payload + 7) / 8 * 8
        }
    }
    << 8
}

// Number of 8-byte words a value of type t occupies.
pub fn (tp &TypedProgram) words_of(t int) int {
    sz := tp.size_of(t)
    if sz <= 0 { << 0 }
    << (sz + 7) / 8
}

// A value is a scalar when it fits one register: ints, bools, bytes,
// references, handles. Everything else lives in memory and is passed by address.
pub fn (tp &TypedProgram) is_scalar(t int) bool {
    if t == 3 { << false }
    if is_struct_type(t) || is_array_type(t) || is_throw_type(t) { << false }
    if is_fn_type(t) || is_temp_type(t) || is_any_type(t) || is_interface_type(t) { << false }
    if is_enum_type(t) { << false }
    << true
}

pub fn (tp &TypedProgram) field_of(t int, name &string) TField {
    st := tp.deref(t)
    si := struct_index(st)
    if si >= 0 && si < tp.structs.len {
        for i in 0:tp.structs[si].fields.len {
            if tp.structs[si].fields[i].name == *name {
                << TField{name: *name + "", ty: tp.structs[si].fields[i].ty, offset: tp.structs[si].fields[i].offset}
            }
        }
    }
    << TField{name: "", ty: -1, offset: -1}
}

pub fn (tp &TypedProgram) elem_of(t int) int {
    at := tp.deref(t)
    ai := array_index(at)
    if ai >= 0 && ai < tp.arrays.len { << tp.arrays[ai].elem_ty }
    << -1
}

pub fn ast_kind_name(k int) string {
    << ast.node_name(k)
}
