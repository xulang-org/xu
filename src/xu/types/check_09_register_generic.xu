@xu/types

#xu/ast
#xu/parser

fn (c &Checker) find_method(ty int, name string) int {
    if !is_struct_type(ty) {
        << -1
    }
    si := struct_index(ty)
    mut key_name := c.structs[si].name
    if c.structs[si].origin != "" {
        key_name = c.structs[si].origin
    }
    k := method_key(c.structs[si].mod_id + "", key_name, name + "")
    hit := strmap_get(&c.method_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.structs[si].origin != "" {
        << -1
    }
    for i in 0:c.fns.len {
        if c.fns[i].recv >= 0 && c.fns[i].name == name && c.fns[i].mod_id == c.structs[si].mod_id {
            rty := c.fns[i].recv
            if is_ref_type(rty) {
                if c.ref_inner_type(rty) == ty {
                    << i
                }
            } else if rty == ty {
                << i
            }
        }
    }
    << -1
}

// M156: collect lifetime names (`nt_ref.sval`) and named-type uses from a type node
// into c.lt_scan / c.named_scan.
fn (c &mut Checker) collect_lt_named(p &parser.Parser, t int) {
    if t < 0 { << }
    k := p.nodes[t].kind
    if k == ast.NT_REF { // TRef
        if p.nodes[t].sval != "" {
            c.lt_scan.push(p.nodes[t].sval + "")
        }
        c.collect_lt_named(p, p.nodes[t].a)
        <<
    }
    if k == ast.NT_NAMED { // TNamed
        c.named_scan.push(p.nodes[t].sval + "")
        mut a := p.nodes[t].a
        while a >= 0 {
            c.collect_lt_named(p, a)
            a = p.nodes[a].next
        }
        <<
    }
    if k == ast.NT_ARRAY || k == ast.NT_CHAN { // TArray / TChan
        c.collect_lt_named(p, p.nodes[t].a)
        <<
    }
    if k == ast.NT_FN { // TFn
        mut a := p.nodes[t].a
        while a >= 0 {
            c.collect_lt_named(p, a)
            a = p.nodes[a].next
        }
        c.collect_lt_named(p, p.nodes[t].b)
        <<
    }
}

fn (c &Checker) str_in_list(xs &[]string, s string) bool {
    for i in 0:xs.len {
        if xs[i] == s { << true }
    }
    << false
}

fn (c &Checker) fn_has_lt(fi int, s string) bool {
    for i in 0:c.fns[fi].lt_params.len {
        if c.fns[fi].lt_params[i] == s { << true }
    }
    << false
}

fn (c &Checker) dedup_lt_scan() []string {
    mut lts := []string{}
    for i in 0:c.lt_scan.len {
        name := c.lt_scan[i] + ""
        mut found := false
        nprev := lts.len
        for j in 0:nprev {
            if lts[j] == name {
                found = true
            }
        }
        if !found {
            lts.push(name)
        }
    }
    << lts
}

// M187: split register_fn (W3) — init label + CFn shell.
// Fills `f` in place (no CFn sret). Always clone AST strings — moving
// `p.nodes[d].sval` leaves a dirty slot that WoA x64 later OOMs on.
fn (c &mut Checker) register_fn_init(p &parser.Parser, d int, f &mut CFn) {
    c.cur_mod = p.nodes[d].sval2 + ""
    c.set_cur_file(p, decl_file_id(p, d))
    is_pub := p.nodes[d].ival == 1
    nm := p.nodes[d].sval + ""
    mod := p.nodes[d].sval2 + ""
    f.name = nm + ""
    f.label = "_xu_" + nm
    f.ret = 0
    f.params = []int{}
    f.recv = -1
    f.recv_mut = false
    f.mod_id = mod + ""
    f.is_pub = is_pub
    f.is_extern = false
    f.is_template = false
    f.recv_name = ""
    f.variadic = false
    f.lt_params = []string{}
    if mod.len > 0 {
        f.label = "_xu_" + mangle_mod(mod + "") + "_" + nm
    }
    if nm == "main" && (mod.len == 0 || mod == "main") {
        f.label = "_xu_main"
    }
    f.is_extern = c.fn_is_native_stub(p, d, f.label)
    c.clear_subst()
}

pub fn (c &mut Checker) add_lib_ext(lab string) {
    c.lib_ext_labs.push(lab + "")
}

// Only generated declarations may bind to native exports. Module/name
// mangling can otherwise make an unrelated Xu function share a C symbol.
fn (c &mut Checker) fn_is_native_stub(p &parser.Parser, d int, label string) bool {
    if !c.lib_ext_has(label) { << false }
    fid := decl_file_id(p, d)
    if fid >= 0 && fid < p.file_names.len {
        if p.file_names[fid] == "<native:" + p.nodes[d].sval2 + ">" { << true }
    }
    c.fail_node(p, d, "native symbol collision: " + label)
    << false
}

fn (c &Checker) lib_ext_has(lab string) bool {
    n := c.lib_ext_labs.len
    for i in 0:n {
        other := c.lib_ext_labs[i]
        if lab.len == other.len {
            mut same := true
            for k in 0:lab.len {
                if (lab[k] & 255) != (other[k] & 255) {
                    same = false
                }
            }
            if same {
                << true
            }
        }
    }
    << false
}

// Free functions: lifetime scan + `#` type params.
fn (c &mut Checker) register_fn_free_type_params(p &parser.Parser, d int, f &mut CFn) {
    c.lt_scan = []string{}
    c.named_scan = []string{}
    mut prm0 := p.nodes[d].a
    while prm0 >= 0 {
        c.collect_lt_named(p, p.nodes[prm0].a)
        prm0 = p.nodes[prm0].next
    }
    if p.nodes[d].b >= 0 {
        c.collect_lt_named(p, p.nodes[d].b)
    }
    lts := c.dedup_lt_scan()
    for i in 0:lts.len {
        f.lt_params.push(lts[i] + "")
    }
    if p.nodes[d].e >= 0 {
        mut tp := p.nodes[d].e
        mut k := 0
        while tp >= 0 {
            as_lt := c.str_in_list(&c.lt_scan, p.nodes[tp].sval)
            as_ty := c.str_in_list(&c.named_scan, p.nodes[tp].sval)
            if as_lt && as_ty {
                c.fail_node(p, tp, "parameter '" + p.nodes[tp].sval + "' cannot be both a lifetime and a type parameter")
            }
            if as_lt {
                c.fail_node(p, tp, "lifetime '" + p.nodes[tp].sval + "' is introduced by &" + p.nodes[tp].sval + "; do not list it after #")
            }
            if p.nodes[tp].sval2 != "" {
                if c.find_iface_global(p.nodes[tp].sval2, p.nodes[d].sval2) < 0 {
                    c.fail_node(p, tp, "unknown struct@ '" + p.nodes[tp].sval2 + "' in constraint")
                }
            }
            f.is_template = true
            c.set_subst_pair(p.nodes[tp].sval + "", param_type(k))
            k += 1
            tp = p.nodes[tp].next
        }
    }
}

// Methods: receiver, lt_params, label, duplicate check.
fn (c &mut Checker) register_fn_method_receiver(p &parser.Parser, d int, f &mut CFn) {
    if p.nodes[d].e >= 0 {
        c.fail_node(p, d, "methods use the struct's type parameters; fn-level type parameters on methods are not supported (M4)")
    }
    c.lt_scan = []string{}
    c.named_scan = []string{}
    recv_node0 := p.nodes[d].d
    c.collect_lt_named(p, p.nodes[recv_node0].a)
    mut prm_m := p.nodes[d].a
    while prm_m >= 0 {
        c.collect_lt_named(p, p.nodes[prm_m].a)
        prm_m = p.nodes[prm_m].next
    }
    if p.nodes[d].b >= 0 {
        c.collect_lt_named(p, p.nodes[d].b)
    }
    lts_m := c.dedup_lt_scan()
    for i in 0:lts_m.len {
        f.lt_params.push(lts_m[i] + "")
    }
    recv_node := p.nodes[d].d
    rty_node := p.nodes[recv_node].a
    mut named_node := rty_node
    if p.nodes[rty_node].kind == ast.NT_REF { // TRef
        named_node = p.nodes[rty_node].a
        if p.nodes[rty_node].ival == 1 {
            f.recv_mut = true
        }
    } else if p.nodes[recv_node].ival == 1 {
        f.recv_mut = true
    }
    if p.nodes[named_node].kind == ast.NT_NAMED {
        f.recv_name = p.nodes[named_node].sval + ""
    } else {
        c.clear_subst()
        c.fail_node(p, recv_node, "method receiver must be a struct")
    }
    ti := c.find_stpl(p.nodes[named_node].sval, p.nodes[d].sval2)
    if ti >= 0 {
        f.is_template = true
        mut tp := p.nodes[c.stpl_decl[ti]].e
        mut k := 0
        while tp >= 0 {
            c.set_subst_pair(p.nodes[tp].sval + "", param_type(k))
            k += 1
            tp = p.nodes[tp].next
        }
    }
    f.recv = c.type_of(p, rty_node)
    mut recv_struct := f.recv
    if is_ref_type(f.recv) {
        recv_struct = c.ref_inner_type(f.recv)
    }
    if !is_struct_type(recv_struct) {
        c.clear_subst()
        c.fail_node(p, recv_node, "method receiver must be a struct")
    }
    if f.recv_name.len == 0 {
        f.recv_name = c.structs[struct_index(recv_struct)].name + ""
    }
    fnm := p.nodes[d].sval + ""
    fmod := p.nodes[d].sval2 + ""
    if fmod.len == 0 {
        f.label = "_xu_" + f.recv_name + "_" + fnm
    } else {
        f.label = "_xu_" + mangle_mod(fmod + "") + "_" + f.recv_name + "_" + fnm
    }
    if c.find_method_by_key(fmod + "", f.recv_name + "", fnm + "") >= 0 {
        c.clear_subst()
        c.fail_node(p, d, "duplicate method definition")
    }
}

fn (c &mut Checker) register_fn_params(p &parser.Parser, d int, f &mut CFn) {
    mut prm := p.nodes[d].a
    while prm >= 0 {
        // Bootstrap resolves param types with the param's span, so type
        // errors (not imported / private / unknown) land on the param name.
        c.attr = prm
        mut ety := c.type_of(p, p.nodes[prm].a)
        c.attr = -1
        if ety == 5 {
            c.fail_node(p, prm, "'Self' is only valid in struct@ method signatures")
        }
        if p.nodes[prm].ival == 1 {
            if is_array_type(ety) {
                c.fail_node(p, prm, "<-> parameter must use an element type, found " + c.ty_display(ety))
            }
            f.variadic = true
            ety = c.intern_array_type(ety)
        }
        f.params.push(ety)
        prm = p.nodes[prm].next
    }
}

// Return type + ref/lifetime rules (fattest block).
// W3: embedded-ref return rules — split from register_fn_ret.
fn (c &mut Checker) register_fn_ret_embedded(p &parser.Parser, d int, f &mut CFn) {
    if !is_ref_type(f.ret) && c.type_contains_ref(f.ret) {
        mut ok := false
        if is_struct_type(f.ret) {
            si := struct_index(f.ret)
            mut explicit := 0
            mut bare := 0
            for i in 0:c.structs[si].fields.len {
                if is_ref_type(c.structs[si].fields[i].ty) {
                    if c.structs[si].fields[i].life.len > 0 {
                        explicit += 1
                    } else {
                        bare += 1
                    }
                }
            }
            if explicit > 0 && bare == 0 {
                mut all_found := true
                for i in 0:c.structs[si].fields.len {
                    lt := c.structs[si].fields[i].life
                    if is_ref_type(c.structs[si].fields[i].ty) && lt.len > 0 {
                        mut found := false
                        if p.nodes[d].d >= 0 {
                            rty := p.nodes[p.nodes[d].d].a
                            if rty >= 0 && p.nodes[rty].kind == ast.NT_REF && p.nodes[rty].sval == lt {
                                found = true
                            }
                        }
                        mut prm2 := p.nodes[d].a
                        while prm2 >= 0 {
                            pty := p.nodes[prm2].a
                            if pty >= 0 && p.nodes[pty].kind == ast.NT_REF && p.nodes[pty].sval == lt {
                                found = true
                            }
                            prm2 = p.nodes[prm2].next
                        }
                        if !found {
                            all_found = false
                        }
                    }
                }
                ok = all_found
            } else if bare > 0 && explicit == 0 {
                mut nref := 0
                for i in 0:f.params.len {
                    if is_ref_type(f.params[i]) {
                        nref += 1
                    }
                }
                if is_ref_type(f.recv) {
                    nref += 1
                }
                ok = nref == 1
            }
        } else if is_throw_type(f.ret) || is_array_type(f.ret) {
            if p.nodes[d].b >= 0 {
                ok = c.typeref_ref_return_ok(p, p.nodes[d].b, d)
            }
        }
        if !ok {
            c.clear_subst()
            c.fail_node(p, d, "cannot return type containing references without explicit lifetimes")
        }
    }
}

// W3: bare-ref return lifetime rules — split from register_fn_ret.
fn (c &mut Checker) register_fn_ret_bare_ref(p &parser.Parser, d int, f &mut CFn) {
    if is_ref_type(f.ret) {
        mut ret_lt := ""
        if p.nodes[d].b >= 0 {
            ret_lt = p.nodes[p.nodes[d].b].sval + ""
        }
        if ret_lt.len > 0 {
            mut found := false
            if p.nodes[d].d >= 0 {
                rty := p.nodes[p.nodes[d].d].a
                if rty >= 0 && p.nodes[rty].kind == ast.NT_REF && p.nodes[rty].sval == ret_lt {
                    found = true
                }
            }
            mut prm2 := p.nodes[d].a
            while prm2 >= 0 {
                pty := p.nodes[prm2].a
                if pty >= 0 && p.nodes[pty].kind == ast.NT_REF && p.nodes[pty].sval == ret_lt {
                    found = true
                }
                prm2 = p.nodes[prm2].next
            }
            if !found {
                c.clear_subst()
                c.fail_node(p, d, "lifetime '" + ret_lt + "' on return is not used by temp reference parameter")
            }
        } else {
            mut nref := 0
            if is_ref_type(f.recv) {
                nref += 1
            }
            for i in 0:f.params.len {
                if is_ref_type(f.params[i]) {
                    nref += 1
                }
            }
            if nref != 1 {
                c.clear_subst()
                c.fail_node(p, d, "functions returning a reference require exactly one reference-typed parameter")
            }
        }
    }
}

fn (c &mut Checker) register_fn_ret(p &parser.Parser, d int, f &mut CFn) {
    if p.nodes[d].b < 0 {
        <<
    }
    f.ret = c.type_of(p, p.nodes[d].b)
    if f.ret == 5 {
        c.fail_node(p, d, "'Self' is only valid in struct@ method signatures")
    }
    c.register_fn_ret_embedded(p, d, f)
    c.register_fn_ret_bare_ref(p, d, f)
}

fn (c &mut Checker) register_fn_commit(d int, f &CFn) {
    c.clear_subst()
    mut ps := []int{}
    mut plen := 0
    plen = f.params.len
    if plen < 0 || plen > 4096 {
        plen = 0
    }
    for i in 0:plen {
        ps.push(f.params[i])
    }
    mut lts := []string{}
    mut ltlen := 0
    ltlen = f.lt_params.len
    if ltlen < 0 || ltlen > 256 {
        ltlen = 0
    }
    for i in 0:ltlen {
        lts.push(f.lt_params[i] + "")
    }
    nm := f.name + ""
    lab := f.label + ""
    mid := f.mod_id + ""
    rn := f.recv_name + ""
    // Re-seed fns if descriptor looks corrupt (untouched array after Checker boot).
    if c.fns.len < 0 || c.fns.len > 1000000 {
        c.fns = []CFn{}
    }
    c.fns.push(CFn{
        name: nm + "",
        label: lab + "",
        ret: f.ret,
        params: ps,
        recv: f.recv,
        recv_mut: f.recv_mut,
        mod_id: mid + "",
        is_pub: f.is_pub,
        is_extern: f.is_extern,
        is_template: f.is_template,
        recv_name: rn + "",
        variadic: f.variadic,
        lt_params: lts
    })
    c.fn_safe_name.push(nm + "")
    c.fn_safe_mod.push(mid + "")
    c.note_fn_index()
    c.fndecl.push(d)
    cf := c.cur_file
    c.fn_file.push(cf)
    c.is_inst.push(0)
    c.inst_snap_ready.push(0)
    c.inst_keys.push("")
    c.fnlocals.push([]int{})
    c.clos_env.push(-1)
    c.clos_caps.push([]int{})
    c.bound_mfi.push(-1)
    c.inst_t0.push(-1)
    c.inst_targs.push([]int{})
}

// Free-function registration without &mut CFn (WoA x64 corrupts large
// pointed-to stack structs across calls). Locals only; one push at end.
fn (c &mut Checker) register_fn_free(p &parser.Parser, d int) {
    c.cur_mod = p.nodes[d].sval2 + ""
    c.set_cur_file(p, decl_file_id(p, d))
    is_pub := p.nodes[d].ival == 1
    mut nm := p.nodes[d].sval + ""
    mut mod := p.nodes[d].sval2 + ""
    mut label := "_xu_" + nm
    if mod.len > 0 {
        label = "_xu_" + mangle_mod(mod + "") + "_" + nm
    }
    if nm == "main" && (mod.len == 0 || mod == "main") {
        label = "_xu_main"
    }
    is_extern := c.fn_is_native_stub(p, d, label + "")
    c.clear_subst()

    c.lt_scan = []string{}
    c.named_scan = []string{}
    mut prm0 := p.nodes[d].a
    while prm0 >= 0 {
        c.collect_lt_named(p, p.nodes[prm0].a)
        prm0 = p.nodes[prm0].next
    }
    if p.nodes[d].b >= 0 {
        c.collect_lt_named(p, p.nodes[d].b)
    }
    mut lt_params := c.dedup_lt_scan()
    mut is_template := false
    if p.nodes[d].e >= 0 {
        mut tp := p.nodes[d].e
        mut k := 0
        while tp >= 0 {
            as_lt := c.str_in_list(&c.lt_scan, p.nodes[tp].sval)
            as_ty := c.str_in_list(&c.named_scan, p.nodes[tp].sval)
            if as_lt && as_ty {
                c.fail_node(p, tp, "parameter '" + p.nodes[tp].sval + "' cannot be both a lifetime and a type parameter")
            }
            if as_lt {
                c.fail_node(p, tp, "lifetime '" + p.nodes[tp].sval + "' is introduced by &" + p.nodes[tp].sval + "; do not list it after #")
            }
            if p.nodes[tp].sval2 != "" {
                if c.find_iface_global(p.nodes[tp].sval2, p.nodes[d].sval2) < 0 {
                    c.fail_node(p, tp, "unknown struct@ '" + p.nodes[tp].sval2 + "' in constraint")
                }
            }
            is_template = true
            c.set_subst_pair(p.nodes[tp].sval + "", param_type(k))
            k += 1
            tp = p.nodes[tp].next
        }
    }

    mut di := 0
    while di < c.fns.len {
        if c.fns[di].recv < 0 {
            if c.fns[di].name == nm && c.fns[di].mod_id == mod {
                c.clear_subst()
                c.fail_node(p, d, "duplicate function definition")
            }
        }
        di = di + 1
    }

    mut params := []int{}
    mut variadic := false
    mut prm := p.nodes[d].a
    while prm >= 0 {
        c.attr = prm
        mut ety := c.type_of(p, p.nodes[prm].a)
        c.attr = -1
        if ety == 5 {
            c.fail_node(p, prm, "'Self' is only valid in struct@ method signatures")
        }
        if p.nodes[prm].ival == 1 {
            if is_array_type(ety) {
                c.fail_node(p, prm, "<-> parameter must use an element type, found " + c.ty_display(ety))
            }
            variadic = true
            ety = c.intern_array_type(ety)
        }
        params.push(ety)
        prm = p.nodes[prm].next
    }

    mut ret := 0
    if p.nodes[d].b >= 0 {
        ret = c.type_of(p, p.nodes[d].b)
        if ret == 5 {
            c.fail_node(p, d, "'Self' is only valid in struct@ method signatures")
        }
        // Only build a CFn scratch when ref-return rules apply — avoids
        // &mut CFn across calls on the common int/void path (WoA x64).
        if is_ref_type(ret) || c.type_contains_ref(ret) {
            mut tmp := CFn{
                name: "",
                label: "",
                ret: ret,
                params: []int{},
                recv: -1,
                recv_mut: false,
                mod_id: "",
                is_pub: false,
                is_extern: false,
                is_template: false,
                recv_name: "",
                variadic: false,
                lt_params: []string{}
            }
            for i in 0:params.len {
                tmp.params.push(params[i])
            }
            for i in 0:lt_params.len {
                tmp.lt_params.push(lt_params[i] + "")
            }
            c.register_fn_ret_embedded(p, d, mut &tmp)
            c.register_fn_ret_bare_ref(p, d, mut &tmp)
            ret = tmp.ret
        }
    }

    c.clear_subst()
    if c.fns.len < 0 || c.fns.len > 1000000 {
        c.fns = []CFn{}
    }
    // Snapshot params/lt before the large CFn push consumes them; Gen1→gen2
    // (and WoA x64) can scramble in-slot []int/string headers, so we rewrite
    // those fields from the snapshots after push (methods use register_fn_commit).
    mut ps_fix := []int{}
    for i in 0:params.len {
        ps_fix.push(params[i])
    }
    mut lts_fix := []string{}
    for i in 0:lt_params.len {
        lts_fix.push(lt_params[i] + "")
    }
    c.fns.push(CFn{
        name: nm + "",
        label: label + "",
        ret: ret,
        params: ps_fix,
        recv: -1,
        recv_mut: false,
        mod_id: mod + "",
        is_pub: is_pub,
        is_extern: is_extern,
        is_template: is_template,
        recv_name: "",
        variadic: variadic,
        lt_params: lts_fix
    })
    fi := c.fns.len - 1
    c.fns[fi].name = nm + ""
    c.fns[fi].label = label + ""
    c.fns[fi].mod_id = mod + ""
    c.fns[fi].recv_name = ""
    // Re-copy snapshots — the push may have scrambled the in-slot headers.
    mut ps2 := []int{}
    for i in 0:params.len {
        ps2.push(params[i])
    }
    c.fns[fi].params = ps2
    mut lts2 := []string{}
    for i in 0:lt_params.len {
        lts2.push(lt_params[i] + "")
    }
    c.fns[fi].lt_params = lts2
    c.fns[fi].ret = ret
    c.fns[fi].recv = -1
    c.fns[fi].recv_mut = false
    c.fns[fi].is_pub = is_pub
    c.fns[fi].is_extern = is_extern
    c.fns[fi].is_template = is_template
    c.fns[fi].variadic = variadic
    c.fn_safe_name.push(nm + "")
    c.fn_safe_mod.push(mod + "")
    // Index with the locals we just pushed — do not re-read c.fns[i] strings.
    c.note_fn_index_named(nm + "", mod + "", is_template)
    c.fndecl.push(d)
    cf := c.cur_file
    c.fn_file.push(cf)
    c.is_inst.push(0)
    c.inst_snap_ready.push(0)
    c.inst_keys.push("")
    c.fnlocals.push([]int{})
    c.clos_env.push(-1)
    c.clos_caps.push([]int{})
    c.bound_mfi.push(-1)
    c.inst_t0.push(-1)
    c.inst_targs.push([]int{})
}

fn (c &mut Checker) register_fn(p &parser.Parser, d int) {
    // One path for free fns and methods. `register_fn_free`'s large
    // `CFn{params: …}` push scrambles the params slice under Gen1→gen2
    // (param types become void); `register_fn_commit` rebuilds field-by-field.
    mut f := CFn{
        name: "",
        label: "",
        ret: 0,
        params: []int{},
        recv: -1,
        recv_mut: false,
        mod_id: "",
        is_pub: false,
        is_extern: false,
        is_template: false,
        recv_name: "",
        variadic: false,
        lt_params: []string{}
    }
    c.register_fn_init(p, d, mut &f)
    if p.nodes[d].d < 0 {
        c.register_fn_free_type_params(p, d, mut &f)
        // Duplicate free-fn check (was in register_fn_free).
        mut di := 0
        while di < c.fns.len {
            if c.fns[di].recv < 0 {
                if c.fns[di].name == f.name && c.fns[di].mod_id == f.mod_id {
                    c.clear_subst()
                    c.fail_node(p, d, "duplicate function definition")
                }
            }
            di = di + 1
        }
    } else {
        c.register_fn_method_receiver(p, d, mut &f)
    }
    c.register_fn_params(p, d, mut &f)
    c.register_fn_ret(p, d, mut &f)
    c.register_fn_commit(d, &f)
}

fn (c &Checker) find_method_by_key(mod string, sname string, mname string) int {
    k := method_key(mod, sname, mname)
    << strmap_get(&c.method_map, &k)
}

// Unify signature type (may contain Param / generic structs) with actual.
// Uses c.uni_bind[k]: -1 if unset, else concrete type tag.
fn (c &mut Checker) unify(sig int, actual int) bool {
    if is_param_type(sig) {
        k := param_index(sig)
        if k < 0 || k >= c.uni_bind.len {
            << false
        }
        if c.uni_bind[k] >= 0 {
            << c.uni_bind[k] == actual
        }
        c.uni_bind[k] = actual
        << true
    }
    if is_struct_type(sig) && is_struct_type(actual) {
        ssi := struct_index(sig)
        asi := struct_index(actual)
        if c.structs[ssi].origin != "" && c.structs[asi].origin != "" {
            if c.structs[ssi].origin != c.structs[asi].origin {
                << false
            }
            if c.sargs[ssi].len != c.sargs[asi].len {
                << false
            }
            for i in 0:c.sargs[ssi].len {
                if !c.unify(c.sargs[ssi][i], c.sargs[asi][i]) {
                    << false
                }
            }
            << true
        }
        << sig == actual
    }
    if is_throw_type(sig) && is_throw_type(actual) {
        << c.unify(c.throws[throw_index(sig)].ok_ty, c.throws[throw_index(actual)].ok_ty) && c.unify(c.throws[throw_index(sig)].err_ty, c.throws[throw_index(actual)].err_ty)
    }
    if is_array_type(sig) && is_array_type(actual) {
        << c.unify(c.arrays[array_index(sig)].elem_ty, c.arrays[array_index(actual)].elem_ty)
    }
    if is_chan_type(sig) && is_chan_type(actual) {
        << c.unify(c.chans[chan_index(sig)].elem_ty, c.chans[chan_index(actual)].elem_ty)
    }
    if is_map_type(sig) && is_map_type(actual) {
        << c.unify(c.maps[map_index(sig)].key_ty, c.maps[map_index(actual)].key_ty) && c.unify(c.maps[map_index(sig)].val_ty, c.maps[map_index(actual)].val_ty)
    }
    // M103/M104: `fn(T, T) bool` against `fn(int, int) bool`.
    if is_fn_type(sig) && is_fn_type(actual) {
        ssi := fn_index(sig)
        asi := fn_index(actual)
        if ssi < 0 || asi < 0 || ssi >= c.fn_sigs.len || asi >= c.fn_sigs.len {
            << false
        }
        if c.fn_sigs[ssi].params.len != c.fn_sigs[asi].params.len {
            << false
        }
        for i in 0:c.fn_sigs[ssi].params.len {
            if !c.unify(c.fn_sigs[ssi].params[i], c.fn_sigs[asi].params[i]) {
                << false
            }
        }
        << c.unify(c.fn_sigs[ssi].ret, c.fn_sigs[asi].ret)
    }
    // M102: `&mut []T` / `&[]T` against concrete slice refs.
    if is_ref_type(sig) && is_ref_type(actual) {
        if is_mut_ref_type(sig) != is_mut_ref_type(actual) {
            << false
        }
        << c.unify(c.ref_inner_type(sig), c.ref_inner_type(actual))
    }
    << sig == actual
}

fn subst_self_ty(ty int, concrete int) int {
    if ty == 5 {
        << concrete
    }
    << ty
}

// Render an interface method as `name(params) ret` with Self substituted
// for the concrete type (bootstrap missing-method text).
fn (c &Checker) iface_method_sig(mi int, ty int) string {
    mut s := c.im_name[mi] + "("
    for pi in 0:c.im_plen[mi] {
        if pi > 0 {
            s = s + ", "
        }
        s = s + c.ty_display(subst_self_ty(c.im_ptys[c.im_poff[mi] + pi], ty))
    }
    s = s + ") "
    << s + c.ty_display(subst_self_ty(c.im_ret[mi], ty))
}

// Check that `ty` structurally satisfies struct@ named by AST node `cons_node`
// (TypeParam with sval2 = constraint) or by iface index. `iname` is only for
// error text and is re-read from iface table after lookup.
fn (c &mut Checker) check_constraint(p &parser.Parser, ty int, iname string, at int) {
    // M102: int/string/f64 auto-satisfy Ord.
    if iname == "Ord" {
        if ty == 1 || ty == 3 || ty == 4 {
            <<
        }
    }
    // Prefer current module; else unique match by name across modules.
    mut ii := c.find_iface_global(iname + "", c.cur_mod)
    if ii < 0 {
        c.fail_node(p, at, "unknown struct@ '" + iname + "'")
        <<
    }
    // Forwarding a parameter is valid only when its declared bound resolves
    // to the same interface. Resolve that bound in the caller's module.
    if is_param_type(ty) {
        k := param_index(ty)
        if k >= 0 && k < c.tp_cons.len && c.tp_cons[k].len > 0 && c.cur_fn >= 0 && c.cur_fn < c.fns.len {
            bound := c.find_iface_global(c.tp_cons[k] + "", c.fns[c.cur_fn].mod_id)
            if bound == ii { << }
        }
    }
    if !is_struct_type(ty) {
        mut mi0 := -1
        for i in 0:c.im_ii.len {
            if c.im_ii[i] == ii {
                mi0 = i
            }
        }
        if mi0 >= 0 {
            c.fail_node(p, at, "type '" + c.ty_display(ty) + "' does not satisfy '" + c.iface_names[ii] + "': missing method '" + c.im_name[mi0] + "() " + c.ty_display(subst_self_ty(c.im_ret[mi0], ty)) + "'")
        }
        c.fail_node(p, at, "type '" + c.ty_display(ty) + "' does not satisfy '" + c.iface_names[ii] + "'")
        <<
    }
    si := struct_index(ty)
    for mi in 0:c.im_ii.len {
        if c.im_ii[mi] != ii {
            ->
        }
        fid := c.find_method_for_struct(si, c.im_name[mi])
        if fid < 0 {
            c.fail_node(p, at, "type '" + c.structs[si].name + "' does not satisfy '" + c.iface_names[ii] + "': missing method '" + c.iface_method_sig(mi, ty) + "'")
            <<
        }
        mut ok := true
        if c.fns[fid].params.len != c.im_plen[mi] {
            ok = false
        }
        if ok {
            for pi in 0:c.fns[fid].params.len {
                want := subst_self_ty(c.im_ptys[c.im_poff[mi] + pi], ty)
                got := c.subst_type_si(c.fns[fid].params[pi], si)
                if got != want {
                    ok = false
                }
            }
            got_ret := c.subst_type_si(c.fns[fid].ret, si)
            if got_ret != subst_self_ty(c.im_ret[mi], ty) {
                ok = false
            }
        }
        if !ok {
            c.fail_node(p, at, "type '" + c.structs[si].name + "' does not satisfy '" + c.iface_names[ii] + "': missing method '" + c.iface_method_sig(mi, ty) + "'")
        }
    }
}

// Generic structural bounds call the concrete implementation and may handle
// its errors. Erased struct@ dispatch uses the declared result layout, which
// has no throw tag. Do not box an implementation requiring that wider ABI.
fn (c &mut Checker) check_interface_box_contract(p &parser.Parser, ty int, ii int, at int) bool {
    if !is_struct_type(ty) { << false }
    si := struct_index(ty)
    for mi in 0:c.im_ii.len {
        if c.im_ii[mi] != ii { -> }
        fid := c.find_method_for_struct(si, c.im_name[mi])
        if fid < 0 {
            c.fail_node(p, at, "type '" + c.ty_display(ty) + "' does not satisfy '" + c.iface_names[ii] + "': missing method '" + c.iface_method_sig(mi, ty) + "'")
            << false
        }
        mut ok := c.fns[fid].params.len == c.im_plen[mi]
        if ok {
            for pi in 0:c.fns[fid].params.len {
                want := subst_self_ty(c.im_ptys[c.im_poff[mi] + pi], ty)
                got := c.subst_type_si(c.fns[fid].params[pi], si)
                if got != want { ok = false }
            }
            if c.subst_type_si(c.fns[fid].ret, si) != subst_self_ty(c.im_ret[mi], ty) { ok = false }
        }
        if !ok {
            c.fail_node(p, at, "cannot box " + c.ty_display(ty) + " into " + c.iface_names[ii] + ": incompatible signature for '" + c.im_name[mi] + "'")
            << false
        }
        if is_ref_type(c.fns[fid].recv) || c.fns[fid].recv_mut {
            c.fail_node(p, at, "cannot box " + c.ty_display(ty) + " into " + c.iface_names[ii] + ": reference or mutable receiver is not supported by dynamic dispatch")
            << false
        }
        if c.type_contains_ref(c.subst_type_si(c.fns[fid].ret, si)) {
            c.fail_node(p, at, "cannot box " + c.ty_display(ty) + " into " + c.iface_names[ii] + ": reference result requires a dynamic lifetime contract")
            << false
        }
        if fid >= c.fn_may_throw.len || c.fn_may_throw[fid] != 0 {
            c.fail_node(p, at, "cannot box " + c.ty_display(ty) + " into " + c.iface_names[ii] + ": method '" + c.im_name[mi] + "' may throw")
            << false
        }
    }
    << true
}

// Find method on struct si by name (origin-aware). mname moved once.
fn (c &Checker) find_method_for_struct(si int, mname string) int {
    mut key_name := c.structs[si].name
    if c.structs[si].origin != "" {
        key_name = c.structs[si].origin
    }
    k := method_key(c.structs[si].mod_id + "", key_name, mname + "")
    hit := strmap_get(&c.method_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.structs[si].origin != "" {
        << -1
    }
    ty := struct_type(si)
    for i in 0:c.fns.len {
        if c.fns[i].recv < 0 || c.fns[i].name != mname {
            ->
        }
        if c.fns[i].mod_id != c.structs[si].mod_id {
            ->
        }
        if c.fns[i].recv_name == c.structs[si].name || c.fns[i].recv == ty {
            << i
        }
    }
    << -1
}

// Shallow Param(k) → sargs[si][k] for constraint method sig matching.
fn (c &Checker) subst_type_si(ty int, si int) int {
    if is_param_type(ty) {
        k := param_index(ty)
        if k >= 0 && k < c.sargs[si].len {
            << c.sargs[si][k]
        }
    }
    << ty
}

// Build instantiation mangle key from every type-arg tag in `args`.
fn (c &Checker) mangle_args_key(args &[]int) string {
    if args.len <= 0 { << "" }
    if args.len == 1 { << c.mangle_ty(args[0]) }
    mut sb := new_strbuf(64)
    for i in 0:args.len {
        if i > 0 { sb.write_byte(95) }
        sb.write_str(c.mangle_ty(args[i]))
    }
    << sb.finish()
}

fn (c &Checker) inst_label(template_id int, mkey string) string {
    mut sb := new_strbuf(c.fns[template_id].label.len + 1 + mkey.len)
    for i in 0:c.fns[template_id].label.len {
        sb.write_byte(c.fns[template_id].label[i])
    }
    sb.write_byte(95)
    sb.write_str(mkey)
    << sb.finish()
}

// Monomorphize using type args pre-loaded into c.targs (c.targs_n == len).
fn (c &mut Checker) instantiate_fn_n(p &parser.Parser, template_id int, at int) int {
    mut args := []int{}
    for i in 0:c.targs.len {
        args.push(c.targs[i])
    }
    n_args := args.len
    mut a0 := 0
    if n_args > 0 { a0 = args[0] }
    mkey := c.mangle_args_key(&args)
    mut ikb := new_strbuf(32)
    ikb.write_str(str(template_id))
    ikb.write_byte(47)
    ikb.write_str(mkey + "")
    ik := ikb.finish()
    hit := strmap_get(&c.inst_map, &ik)
    if hit >= 0 {
        << hit
    }
    if c.n_fn_inst >= 512 {
        c.fail_node(p, at, "generic instantiation limit exceeded (recursive generic with growing type arguments?)")
        << -1
    }
    d := c.fndecl[template_id]
    // Head of TypeParam chain for this template (fn or struct).
    mut tp_head := -1
    if c.fns[template_id].recv >= 0 {
        ti := c.find_stpl(c.fns[template_id].recv_name, c.fns[template_id].mod_id)
        if ti >= 0 {
            tp_head = p.nodes[c.stpl_decl[ti]].e
        }
    } else {
        tp_head = p.nodes[d].e
    }
    mut ntp := 0
    mut tp := tp_head
    while tp >= 0 {
    if c.fns[template_id].recv >= 0 || !c.fn_has_lt(template_id, p.nodes[tp].sval) {
        ntp += 1
    }
    tp = p.nodes[tp].next
    }
    if n_args != ntp {
        c.fail_node(p, at, "function '" + c.fns[template_id].name + "' takes " + str(ntp) + " type argument(s), found " + str(n_args))
        << -1
    }
    // Constraint checks (in the template's module).
    saved_mod := c.cur_mod
    saved_file := c.cur_file
    c.cur_mod = c.fns[template_id].mod_id
    c.set_cur_file(p, c.fn_file[template_id])
    tp = tp_head
    mut ai := 0
    while tp >= 0 {
    skip_lt := c.fns[template_id].recv < 0 && c.fn_has_lt(template_id, p.nodes[tp].sval)
    if !skip_lt {
        if p.nodes[tp].sval2 != "" {
            c.check_constraint(p, args[ai], p.nodes[tp].sval2, at)
        }
        ai += 1
    }
    tp = p.nodes[tp].next
    }
    // Nested generic calls must not erase the caller's substitutions.
    mut saved_sn := []string{}
    mut saved_st := []int{}
    for i in 0:c.sub_names.len {
        saved_sn.push(c.sub_names[i] + "")
        saved_st.push(c.sub_tys[i])
    }
    mut symbolic := c.generic_arg_symbolic(a0)
    for i in 0:n_args {
        if c.generic_arg_symbolic(args[i]) { symbolic = true }
    }
    // Resolve concrete signature with subst (re-read type-param names from AST).
    c.clear_subst()
    tp = tp_head
    ai = 0
    while tp >= 0 {
    skip_lt := c.fns[template_id].recv < 0 && c.fn_has_lt(template_id, p.nodes[tp].sval)
    if !skip_lt {
        c.set_subst_pair(p.nodes[tp].sval, args[ai])
        ai += 1
    }
    tp = p.nodes[tp].next
    }
    mut nf := CFn{
        name: c.fns[template_id].name,
        label: "",
        ret: 0,
        params: []int{},
        recv: -1,
        recv_mut: c.fns[template_id].recv_mut,
        mod_id: c.fns[template_id].mod_id,
        is_pub: c.fns[template_id].is_pub,
        is_extern: false,
        is_template: symbolic,
        recv_name: c.fns[template_id].recv_name,
        variadic: c.fns[template_id].variadic,
        lt_params: []string{}
    }
    for i in 0:c.fns[template_id].lt_params.len {
        nf.lt_params.push(c.fns[template_id].lt_params[i])
    }
    // Label then key (each consumes a fresh mangle string).
    nf.label = c.inst_label(template_id, mkey)
    if p.nodes[d].d >= 0 {
        recv_node := p.nodes[d].d
        nf.recv = c.type_of(p, p.nodes[recv_node].a)
    }
    mut prm := p.nodes[d].a
    while prm >= 0 {
    mut ety := c.type_of(p, p.nodes[prm].a)
    if p.nodes[prm].ival == 1 {
        ety = c.intern_array_type(ety)
    }
    nf.params.push(ety)
    prm = p.nodes[prm].next
    }
    if p.nodes[d].b >= 0 {
        nf.ret = c.type_of(p, p.nodes[d].b)
    }
    c.clear_subst()
    for i in 0:saved_sn.len { c.set_subst_pair(saved_sn[i], saved_st[i]) }
    c.cur_mod = saved_mod
    c.cur_file = saved_file
    key2 := c.mangle_args_key(&args)
    c.fns.push(nf)
    // Definition-only signatures must not shadow the original template in
    // the function/method name index (their parameters may already differ).
    if !symbolic { c.note_fn_index() }
    c.fndecl.push(d)
    tf := c.fn_file[template_id]
    c.fn_file.push(tf)
    // A signature containing parameters is needed for definition-site type
    // checking only. Its body is rechecked after concrete specialization.
    c.is_inst.push(b2i(!symbolic))
    c.inst_snap_ready.push(0)
    c.fnlocals.push([]int{})
    c.inst_keys.push(key2)
    c.clos_env.push(-1)
    c.clos_caps.push([]int{})
    c.bound_mfi.push(-1)
    mut t0store := a0
    pid := c.fns.len - 1
    mut may_inst := 0
    if template_id < c.fn_may_throw.len {
        may_inst = c.fn_may_throw[template_id]
    }
    c.fn_may_throw.push(may_inst)
    mut tr_inst := 0
    if template_id < c.fn_throw_ty.len {
        tr_inst = c.fn_throw_ty[template_id]
    }
    c.fn_throw_ty.push(tr_inst)
    if c.fns[pid].params.len == 1 {
        p0 := c.fns[pid].params[0]
        if is_ref_type(p0) {
            inner := c.ref_inner_type(p0)
            if is_array_type(inner) {
                t0store = c.arrays[array_index(inner)].elem_ty
            }
        } else if is_array_type(p0) {
            t0store = c.arrays[array_index(p0)].elem_ty
        }
    }
    c.inst_t0.push(t0store)
    // Prefer raw type-arg T0 when present: multi-param generics (slice_func)
    // cannot recover T0 from params[0] alone.
    if n_args > 0 {
        c.inst_t0[c.inst_t0.len - 1] = a0
    }
    c.inst_targs.push(args)
    c.n_fn_inst += 1
    strmap_put(mut &c.inst_map, ik, pid)
    << pid
}

fn (c &mut Checker) check_fn(p &parser.Parser, d int, fidx int) {
    c.lname = []string{}
    c.lname_id = []int{}
    c.lhead = []int{}
    c.lprev = []int{}
    c.ltype = []int{}
    c.lmut = []int{}
    c.lactive = []int{}
    c.lmoved = []int{}
    c.lfcons = []int{}
    c.lfpath = []int{}
    c.aj_off = []int{}
    c.aj_fc = []int{}
    c.aj_union = []int{}
    c.aj_path = []int{}
    c.aj_path_u = []int{}
    c.lview = []int{}
    c.lorigin = []int{}
    c.laref = []int{}
    c.llife = []string{}
    c.lrefok = []int{}
    c.lconst = []int{}
    c.lconst_ok = []int{}
    c.lub = []int{}
    c.lub_ok = []int{}
    c.llength = []int{}
    c.llength_ok = []int{}
    c.lnz = []int{}
    c.lnz_ok = []int{}
    c.fnz_recv = []int{}
    c.fnz_name = []string{}
    c.calias = []int{}
    c.marks = []int{}
    c.barriers = []int{}
    c.cur_ret = c.fns[fidx].ret
    c.cur_ret_life = ""
    c.cur_throw_ty = 0
    if fidx < c.fn_throw_ty.len && is_throw_type(c.fn_throw_ty[fidx]) {
        c.cur_throw_ty = c.fn_throw_ty[fidx]
    }
    c.in_or_catch = 0
    c.or_assign = ""
    if p.nodes[d].b >= 0 && p.nodes[p.nodes[d].b].kind == ast.NT_REF {
        c.cur_ret_life = p.nodes[p.nodes[d].b].sval
    }
    c.cur_mod = c.fns[fidx].mod_id
    c.cur_fn = fidx
    c.set_cur_file(p, c.fn_file[fidx])
    c.in_irq = 0
    if is_irq_name(p.nodes[d].sval) {
        c.in_irq = 1
    }
    // Type-param metadata for constraint method resolution (templates only).
    c.tp_names = []string{}
    c.tp_cons = []string{}
    if c.fns[fidx].is_template {
        if c.fns[fidx].recv >= 0 {
            sname := c.fns[fidx].recv_name
            ti := c.find_stpl(sname, c.fns[fidx].mod_id)
            if ti >= 0 {
                mut tp := p.nodes[c.stpl_decl[ti]].e
                while tp >= 0 {
                    c.tp_names.push(p.nodes[tp].sval)
                    c.tp_cons.push(p.nodes[tp].sval2)
                    tp = p.nodes[tp].next
                }
            }
        } else {
            mut tp := p.nodes[d].e
            while tp >= 0 {
                if !c.fn_has_lt(fidx, p.nodes[tp].sval) {
                    c.tp_names.push(p.nodes[tp].sval)
                    c.tp_cons.push(p.nodes[tp].sval2)
                }
                tp = p.nodes[tp].next
            }
        }
    }
    if c.fns[fidx].is_template {
        c.clear_subst()
        for i in 0:c.tp_names.len { c.set_subst_pair(c.tp_names[i] + "", param_type(i)) }
    }
    c.push_scope(0)
    // The receiver, when present, is local 0; explicit params follow it.
    if p.nodes[d].d >= 0 {
        recv_node := p.nodes[d].d
        // Ref receivers are not `mut` bindings; legacy `mut name` keeps lmut.
        mut recv_lmut := c.fns[fidx].recv_mut && !is_ref_type(c.fns[fidx].recv)
        id := c.add_local(p.nodes[recv_node].sval, c.fns[fidx].recv, recv_lmut)
        if is_ref_type(c.fns[fidx].recv) {
            checker_set_i(mut &c.lorigin, id, id)
            rty := p.nodes[recv_node].a
            if rty >= 0 && p.nodes[rty].kind == ast.NT_REF {
                c.llife[id] = p.nodes[rty].sval
            }
        }
    }
    mut prm := p.nodes[d].a
    mut pi := 0
    while prm >= 0 {
        id := c.add_local(p.nodes[prm].sval, c.fns[fidx].params[pi], false)
        // M10: reference parameters are Param origins (themselves).
        if is_ref_type(c.fns[fidx].params[pi]) {
            checker_set_i(mut &c.lorigin, id, id)
            pty := p.nodes[prm].a
            if pty >= 0 && p.nodes[pty].kind == ast.NT_REF {
                c.llife[id] = p.nodes[pty].sval
            }
        }
        pi += 1
        prm = p.nodes[prm].next
    }
    c.fn_err_base = c.error_count
    mut s := p.nodes[d].c
    while s >= 0 {
        if c.fn_failed() {
            <-
        }
        c.check_stmt(p, s)
        s = p.nodes[s].next
    }
    c.pop_scope(p, false, false)
    // Record the local layout for mir/emit.
    // Store in a flat parallel array keyed by fn: clear row fidx then re-push types.
    // Simpler: append-only shadow `fnlocals` is rebuilt from scratch for this fidx
    // by replacing the whole vector without nested index assign.
    c.set_fnlocals_row(fidx)
    c.set_fnlocal_names_row(fidx)
    c.set_fnfacts_row(fidx)
    if c.fns[fidx].is_template { c.clear_subst() }
    c.tp_names = []string{}
    c.tp_cons = []string{}
}

fn (c &mut Checker) set_fnlocals_row(fidx int) {
    mut row := []int{}
    for j in 0:c.ltype.len {
        row.push(c.ltype[j])
    }
    while c.fnlocals.len < fidx {
        c.fnlocals.push([]int{})
    }
    if c.fnlocals.len == fidx {
        c.fnlocals.push(row)
        <<
    }
    c.fnlocals[fidx] = row
}

fn (c &mut Checker) set_fnlocal_names_row(fidx int) {
    mut row := []string{}
    for j in 0:c.lname.len { row.push(c.lname[j] + "") }
    while c.fnlocal_names.len < fidx { c.fnlocal_names.push([]string{}) }
    if c.fnlocal_names.len == fidx {
        c.fnlocal_names.push(row)
        <<
    }
    c.fnlocal_names[fidx] = row
}

fn (c &mut Checker) set_fnfacts_row(fidx int) {
    mut cnst := []int{}
    mut cnst_ok := []int{}
    mut ln := []int{}
    mut ln_ok := []int{}
    for j in 0:c.lconst.len {
        cnst.push(c.lconst[j])
    }
    for j in 0:c.lconst_ok.len {
        cnst_ok.push(c.lconst_ok[j])
    }
    for j in 0:c.llength.len {
        ln.push(c.llength[j])
    }
    for j in 0:c.llength_ok.len {
        ln_ok.push(c.llength_ok[j])
    }
    while c.fnlconst.len < fidx {
        c.fnlconst.push([]int{})
        c.fnlconst_ok.push([]int{})
        c.fnllength.push([]int{})
        c.fnllength_ok.push([]int{})
    }
    if c.fnlconst.len == fidx {
        c.fnlconst.push(cnst)
        c.fnlconst_ok.push(cnst_ok)
        c.fnllength.push(ln)
        c.fnllength_ok.push(ln_ok)
        <<
    }
    c.fnlconst[fidx] = cnst
    c.fnlconst_ok[fidx] = cnst_ok
    c.fnllength[fidx] = ln
    c.fnllength_ok[fidx] = ln_ok
}

// ===== Pass 3: borrow checking (NLL-lite) =====

// Number statements in a stable preorder. This lets reference intervals
// span nested blocks without storing pointers into the AST pool.
