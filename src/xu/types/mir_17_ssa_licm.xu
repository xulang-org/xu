@xu/types

// Bounded code motion in the verified SSA window. Only nontrapping one-word
// integer ALU definitions move; loads, stores, calls and ownership stay put.
// Indexed bodies retain their established address-selection shape. This
// policy is independent of O1/O2/O3 and does not expand instructions or CFG.
const MIR_SSA_LICM_MAX_HOISTS = 4
const MIR_SSA_LICM_MAX_BOUNDARY = 8

// A single-entry self loop, or a header/body pair with an unconditional
// backedge. Returns the body (-1 on rejection). Header 0 has no preheader.
fn mir_ssa_licm_body(f &MFn, header int) int {
    if header <= 0 { << -1 }
    if f.is_self_loop(header) { << header }
    b := f.blocks[header]
    if b.tkind != 2 { << -1 }
    for arm in 0:2 {
        mut body := b.tb
        if arm == 1 { body = b.tc }
        if body <= 0 || body == header { -> }
        tail := f.blocks[body]
        if tail.tkind == 1 && tail.ta == header && f.unique_ext_pred(body) == header { << body }
    }
    << -1
}
fn mir_ssa_licm_preheader(f &MFn, header int, body int) int {
    mut pred := -1
    for bi in 0:f.blocks.len {
        if bi == header || bi == body { -> }
        if mir_verify_edge(f, bi, header) {
            if pred >= 0 { << -1 }
            pred = bi
        }
    }
    << pred
}
fn mir_ssa_licm_invariant(v int, defs &[]int, pinned &[]bool, header int, body int) bool {
    if v < 0 { << true }
    if pinned[v] { << false }
    << defs[v] >= 0 && defs[v] != header && defs[v] != body
}
fn mir_ssa_licm_boundary(v int, defs &[]int, boundary &mut []bool, header int, body int) {
    if v >= 0 && (defs[v] != header && defs[v] != body) { boundary[v] = true }
}

// Strict SSA was verified on this exact function immediately before entry.
// The caller re-verifies accepted movement before its append-only commit.
fn mir_ssa_licm_verified_f(f &mut MFn) int {
    nb := f.blocks.len
    nt := f.temps.len
    if nb > 32 || nt > 128 || f.instrs.len > 512 || f.phis.len > 32 { << 0 }
    if !mir_ssa_work_budget_f(&*f) || mir_ssa_cse_count_f(&*f) == 0 { << 0 }
    mut has_loop := false
    for bi in 1:nb { if mir_ssa_licm_body(&*f, bi) >= 0 { has_loop = true } }
    if !has_loop { << 0 }
    mut defs := []int{}
    mut pinned := []bool{}
    for _ in 0:nt { defs.push(-1)
        pinned.push(false) }
    for pi in 0:f.phis.len { defs[f.phis[pi].dest] = f.phis[pi].block }
    for bi in 0:nb {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            // Address kernels have a separate selection/profitability policy.
            if k == MI_LOAD_INDEX || k == MI_STORE_INDEX || k == MI_ELEM_ADDR || k == MI_INDEX_RMW { << 0 }
            dest := mir_licm_instr_dest(&*f, ii)
            if dest >= 0 { defs[dest] = bi }
            if k == MI_ADDR && mfn_ic(&f.instrs, ii) == 1 { pinned[mfn_ib(&f.instrs, ii)] = true }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    mut moved := 0
    for header in 1:nb {
        body := mir_ssa_licm_body(&*f, header)
        if body < 0 { -> }
        pre := mir_ssa_licm_preheader(&*f, header, body)
        if pre < 0 { -> }
        mut boundary := []bool{}
        for _ in 0:nt { boundary.push(false) }
        mut barrier := false
        for pi in 0:f.phis.len {
            if f.phis[pi].block == header || f.phis[pi].block == body { boundary[f.phis[pi].dest] = true }
        }
        for part in 0:2 {
            mut bi := header
            if part == 1 { if body == header { <- }
                bi = body }
            mut ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                k := mfn_ikind(&f.instrs, ii)
                effect := mir_instr_effects(k, mfn_ib(&f.instrs, ii))
                // Avoid extending new live ranges over ABI calls until the
                // allocator supplies a call-aware profit estimate.
                if k != MI_BIN && (effect < 0 || (effect & MIR_EFFECT_CALL_LIVE) != 0) { barrier = true }
                schema := mir_instr_use_schema(k, mfn_ic(&f.instrs, ii))
                if schema < 0 { barrier = true }
                for field in 0:4 {
                    if (schema & ((1 << field) | (16 << field))) == 0 { -> }
                    mut v := mfn_ia(&f.instrs, ii)
                    if field == 1 { v = mfn_ib(&f.instrs, ii) }
                    if field == 2 { v = mfn_ic(&f.instrs, ii) }
                    if field == 3 { v = mfn_id(&f.instrs, ii) }
                    mir_ssa_licm_boundary(v, &defs, mut &boundary, header, body)
                }
                ii = mfn_inext(&f.instrs, ii)
            }
            if f.blocks[bi].tkind == 2 { mir_ssa_licm_boundary(f.blocks[bi].ta, &defs, mut &boundary, header, body) }
        }
        if barrier { -> }
        mut pressure := 0
        for t in 0:nt { if boundary[t] { pressure += 1 } }
        mut n := 0
        // Header definitions precede body definitions. SSA order makes an
        // invariant chain available as each accepted definition moves.
        for part in 0:2 {
            mut bi := header
            if part == 1 { if body == header { <- }
                bi = body }
            mut ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                next := mfn_inext(&f.instrs, ii)
                if n < MIR_SSA_LICM_MAX_HOISTS && pressure < MIR_SSA_LICM_MAX_BOUNDARY && mir_ssa_cse_bin_f(&*f, ii) {
                    dest := mfn_ia(&f.instrs, ii)
                    lhs := mfn_ic(&f.instrs, ii)
                    rhs := mfn_id(&f.instrs, ii)
                    if !pinned[dest] && mir_ssa_licm_invariant(lhs, &defs, &pinned, header, body) && mir_ssa_licm_invariant(rhs, &defs, &pinned, header, body) {
                        if mir_detach_instr(f, bi, ii) {
                            mir_append_instr(f, pre, ii)
                            defs[dest] = pre
                            n += 1
                            pressure += 1
                            moved += 1
                        }
                    }
                }
                ii = next
            }
        }
    }
    << moved
}
