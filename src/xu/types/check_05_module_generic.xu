@xu/types

#xu/ast
#xu/parser

fn (c &Checker) module_exists(path string) bool {
    << strmap_get(&c.mod_map, &path) >= 0
}

// M18: dotted access-chain path rooted at an Ident — `strings` or
// `strings.fn`. Chain nodes are kind 4 (root ident) or kind 7/8
// (field / method call); any other shape yields ''.
fn (c &Checker) chain_path(p &parser.Parser, n int) string {
    if p.nodes[n].kind == ast.nk_ident {
        << p.nodes[n].sval
    }
    if p.nodes[n].kind == ast.nk_field || p.nodes[n].kind == ast.nk_method_call {
        pre := c.chain_path(p, p.nodes[n].a)
        mut tmp := pre + "."
        << tmp + p.nodes[n].sval
    }
    << ""
}

// Root ident of a dotted chain (`std` for `strings.fn`), for the
// local-shadow check; '' when the chain is not ident-rooted.
fn (c &Checker) chain_root(p &parser.Parser, n int) string {
    if p.nodes[n].kind == ast.nk_ident { << p.nodes[n].sval }
    if p.nodes[n].kind == ast.nk_field || p.nodes[n].kind == ast.nk_method_call {
        << c.chain_root(p, p.nodes[n].a)
    }
    << ""
}

// Longest registered module id that is `path` itself or a strict prefix
// of it (mirror of bootstrap split_module_path). '.' boundary check uses
// byte 46; the prefix bytes must equal the module id. '' when no
// registered module matches.
fn (c &Checker) longest_module(path string) string {
    mut cur := path + ""
    while cur.len > 0 {
        if strmap_get(&c.mod_map, &cur) >= 0 {
            << cur + ""
        }
        // `file_key`/`last_dot` take strings by value in the hosted ABI.  Pass
        // an explicit copy so probing a map cannot consume the working
        // prefix before we compute the next one.
        cut := last_dot(cur + "")
        if cut < 0 {
            <-
        }
        // Materialise the prefix; a borrowed slice can be invalidated by the
        // next StrMap probe under hosted Gen2's owning-string ABI.
        cur = local_before_dot(cur + "", cut)
    }
    << ""
}

// Module id of a TNamed/StructInit sval (`parser.Parser` → `xu.parser`). Falls
// back to the current module when the name has no known module prefix.
fn (c &Checker) named_mod_of(p &parser.Parser, t int) string {
    // Keep a private copy of the pooled spelling.  The hosted Gen2 lowering
    // may consume a by-value string field while probing aliases; subsequent
    // local-name extraction must see the original bytes.
    raw := p.nodes[t].sval + ""
    m := c.longest_module(raw + "")
    if m.len > 0 && raw.len > m.len && raw[m.len] == 46 {
        << m + ""
    }
    // First resolve the ordinary/default import qualifier (e.g. `ast` for
    // `xu.ast`).  This uses vis_map and also handles explicit aliases when
    // they are registered there.
    qm := c.mod_of_import_qual(raw + "")
    if qm.len > 0 {
        << qm + ""
    }
    // Keep the explicit alias path as a separate fallback.  alias_map is the
    // authoritative table for `import x as alias`; longest_alias must be
    // checked even when a malformed/legacy vis_map entry is absent.
    a := c.longest_alias(raw + "")
    if a.len > 0 && raw.len > a.len && raw[a.len] == 46 {
        am := c.alias_of(a + "")
        if am.len > 0 {
            << am + ""
        }
    }
    << c.cur_mod + ""
}

// Copy the suffix after a qualified-name dot without returning a borrowed
// slice.  This is deliberately byte-wise: Gen1's array/slice lowering can
// move a pooled string descriptor when a slice is passed across a call.
fn local_after_dot(path string, dot int) string {
    mut out := ""
    if dot < 0 || dot + 1 >= path.len {
        << out
    }
    for i in dot + 1:path.len {
        out = out + string_from_byte(path[i])
    }
    << out
}

// Real module path for an aliased import qualifier of the current file.
fn (c &Checker) alias_of(q string) string {
    k := file_key(c.cur_file, q + "")
    idx := strmap_get(&c.alias_map, &k)
    if idx >= 0 && idx < c.imp_path.len {
        << c.imp_path[idx] + ""
    }
    << ""
}

// Concrete enum constructors and patterns use a final type-name segment.
fn (c &Checker) enum_qualifier_module(spelling string) string {
    cut := last_dot(spelling + "")
    if cut < 0 { << "" }
    prefix := local_before_dot(spelling + "", cut)
    if c.module_exists(prefix + "") { << prefix + "" }
    real := c.alias_of(prefix + "")
    if real.len > 0 { << real }
    if first_dot(prefix + "") >= 0 { << "" }
    << c.mod_of_import_qual(spelling + "")
}

// Longest alias prefix of `path` among this file's aliased imports.
fn (c &Checker) longest_alias(path string) string {
    mut cur := path + ""
    while cur.len > 0 {
        k := file_key(c.cur_file, cur + "")
        if strmap_get(&c.alias_map, &k) >= 0 {
            << cur + ""
        }
        cut := last_dot(cur + "")
        if cut < 0 {
            <-
        }
        cur = local_before_dot(cur + "", cut)
    }
    << ""
}

// Local name of a TNamed/StructInit sval (`parser.Parser` → `Parser`).
fn (c &Checker) named_local_of(p &parser.Parser, t int) string {
    raw := p.nodes[t].sval + ""
    m := c.longest_module(raw + "")
    if m.len > 0 && raw.len > m.len && raw[m.len] == 46 {
        << local_after_dot(raw + "", m.len)
    }
    // Resolve the default import qualifier before consulting explicit aliases
    // so `ast.Token` and `import foo as ast` follow the same module rules.
    qm := c.mod_of_import_qual(raw + "")
    if qm.len > 0 {
        fd := first_dot(raw + "")
        if fd > 0 {
            << local_after_dot(raw + "", fd)
        }
    }
    a := c.longest_alias(raw + "")
    if a.len > 0 && raw.len > a.len && raw[a.len] == 46 {
        << local_after_dot(raw + "", a.len)
    }
    << raw + ""
}

fn decl_file_id(p &parser.Parser, d int) int {
    for i in 0:p.decls.len {
        if p.decls[i] == d {
            << p.decl_file[i]
        }
    }
    << 0
}

// True if the current file may use qualified names of `path`
// (same module, or this file imported it — Go file-scoped import).
fn (c &Checker) module_visible(path string) bool {
    if c.cur_mod == path {
        << true
    }
    k := file_key(c.cur_file, path)
    << strmap_get(&c.vis_map, &k) >= 0
}

fn (c &Checker) find_fn_in_mod(name string, mod string) int {
    k := map_key(mod + "", name + "")
    res := strmap_get(&c.fn_map, &k)
    << res
}

fn (c &Checker) find_struct_in_mod(name string, mod string) int {
    k := map_key(mod, name)
    << strmap_get(&c.st_map, &k)
}

fn (c &Checker) find_const_in_mod(name string, mod string) int {
    k := map_key(mod, name)
    << strmap_get(&c.const_map, &k)
}

// Entry-point main: `@main` only.
fn (c &Checker) find_entry_main() int {
    mut found := -1
    for i in 0:c.fns.len {
        if c.fns[i].recv < 0 && c.fns[i].name == "main" {
            if c.fns[i].mod_id == "" || c.fns[i].mod_id == "main" {
                if found >= 0 {
                    << -2 // duplicate entry
                }
                found = i
            }
        }
    }
    << found
}

// ===== M11 helpers =====

fn (c &mut Checker) clear_subst() {
    c.sub_names = []string{}
    c.sub_tys = []int{}
    c.subst_map = empty_strmap()
}

fn (c &mut Checker) set_subst_pair(name string, ty int) {
    n := name + ""
    strmap_put(mut &c.subst_map, n + "", ty)
    c.sub_names.push(n)
    c.sub_tys.push(ty)
}

fn (c &Checker) subst_lookup(name string) int {
    n := name + ""
    << strmap_get(&c.subst_map, &n)
}

fn (c &Checker) find_iface(name string, mod string) int {
    k := map_key(mod, name)
    << strmap_get(&c.iface_map, &k)
}

// Prefer current module; else unique match by name across modules (M102).
fn (c &Checker) find_iface_global(name string, mod string) int {
    // Empty maps: miss without map_key (WoA x64).
    icap := c.iface_map.cap
    gcap := c.iface_glob_map.cap
    if icap <= 0 && gcap <= 0 {
        << -1
    }
    n := name + ""
    mid := mod + ""
    exact := c.find_iface(n + "", mid + "")
    if exact >= 0 {
        << exact
    }
    hit := strmap_get(&c.iface_glob_map, &n)
    if hit >= 0 && hit != -2 {
        << hit
    }
    << -1
}

fn (c &Checker) find_stpl(name string, mod string) int {
    k := map_key(mod, name)
    << strmap_get(&c.stpl_map, &k)
}

fn (c &Checker) find_etpl(name string, mod string) int {
    k := map_key(mod, name)
    << strmap_get(&c.etpl_map, &k)
}

fn (c &Checker) enum_pattern_name(ei int) string {
    if c.enums[ei].origin.len > 0 {
        << c.enums[ei].origin
    }
    << c.enums[ei].name
}



fn (c &Checker) mangle_ty(ty int) string {
    if ty == 1 { << "int" }
    if ty == 2 { << "bool" }
    if ty == 3 { << "str" }
    if ty == 4 { << "f64" }
    if ty == 8 { << "i32" }
    if ty == 9 { << "u32" }
    if ty == 10 { << "u8" }
    if is_param_type(ty) { << "P" + str(param_index(ty)) }
    if is_struct_type(ty) {
        si := struct_index(ty)
        raw := c.structs[si].name
        mut sb := new_strbuf(raw.len)
        for i in 0:raw.len {
            ch := raw[i]
            if (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) {
                sb.write_byte(ch)
            } else {
                sb.write_byte(95)
            }
        }
        << sb.finish()
    }
    if is_array_type(ty) {
        << "arr_" + c.mangle_ty(c.arrays[ty - 200].elem_ty)
    }
    if is_map_type(ty) {
        mi := ty - 50
        << "map_" + c.mangle_ty(c.maps[mi].key_ty) + "_" + c.mangle_ty(c.maps[mi].val_ty)
    }
    if is_throw_type(ty) {
        ri := ty - 300
        << "Th_" + c.mangle_ty(c.throws[ri].ok_ty) + "_" + c.mangle_ty(c.throws[ri].err_ty)
    }
    if is_enum_type(ty) {
        << c.enums[ty - 500].name
    }
    if is_mut_ref_type(ty) { << "refmut" }
    if is_ref_type(ty) { << "ref" }
    << "void"
}



fn (c &Checker) ty_display(ty int) string {
    if ty == 1 { << "int" }
    if ty == 2 { << "bool" }
    if ty == 3 { << "string" }
    if ty == 4 { << "f64" }
    if ty == 8 { << "i32" }
    if ty == 9 { << "u32" }
    if ty == 10 { << "u8" }
    if is_param_type(ty) { << "T" + str(param_index(ty)) }
    if is_struct_type(ty) {
        if c.structs[struct_index(ty)].mod_id == "maps" {
            if c.structs[struct_index(ty)].name == "StrInt" {
                << "map[string]int"
            }
            if c.structs[struct_index(ty)].name == "StrStr" {
                << "map[string]string"
            }
        }
        << c.structs[struct_index(ty)].name
    }
    if is_map_type(ty) {
        mi := ty - 50
        << "map[" + c.ty_display(c.maps[mi].key_ty) + "]" + c.ty_display(c.maps[mi].val_ty)
    }
    if is_array_type(ty) {
        << "[]" + c.ty_display(c.arrays[ty - 200].elem_ty)
    }
    if is_throw_type(ty) {
        ri := ty - 300
        << "throw<" + c.ty_display(c.throws[ri].ok_ty) + ", " + c.ty_display(c.throws[ri].err_ty) + ">"
    }
    if is_enum_type(ty) {
        << c.enums[ty - 500].name
    }
    if is_fn_type(ty) {
        si := ty - 700
        if si >= 0 && si < c.fn_sigs.len {
            mut s := "fn("
            for i in 0:c.fn_sigs[si].params.len {
                if i > 0 { s = s + ", " }
                s = s + c.ty_display(c.fn_sigs[si].params[i])
            }
            s = s + ")"
            if c.fn_sigs[si].ret != 0 {
                s = s + " " + c.ty_display(c.fn_sigs[si].ret)
            }
            << s
        }
        << "fn"
    }
    if is_interface_type(ty) {
        ii := iface_index(ty)
        if ii >= 0 && ii < c.iface_names.len {
            if c.iface_mods[ii] != c.cur_mod {
                << c.iface_mods[ii] + "." + c.iface_names[ii]
            }
            << c.iface_names[ii]
        }
        << "interface"
    }
    if is_chan_type(ty) {
        << "chan " + c.ty_display(c.chans[ty - 600].elem_ty)
    }
    << type_name(ty)
}

// ===== top level =====

// Module-qualified call: resolve fn, check args and arg counts, set
// ncall/ntype. Shared by single-segment (strings.fn) and M18 dotted
// (strings.fn) module calls.
fn (c &mut Checker) check_module_call(p &parser.Parser, n int, mod string) int {
    if !c.module_visible(mod + "") {
        << c.fail_expr(p, n, "module " + mod + " not imported")
    }
    // M170: `runtime.caller(skip)` → Frame literal (ncall -97; -50 is os_stat).
    if mod == "runtime" && p.nodes[n].sval == "caller" {
        << c.check_runtime_caller(p, n)
    }
    ii := c.find_iface(p.nodes[n].sval, mod + "")
    if ii >= 0 {
        << c.check_box_interface(p, n, p.nodes[n].b, ii)
    }
    mut fi := c.find_fn_in_mod(p.nodes[n].sval, mod + "")
    if fi < 0 {
        << c.fail_expr(p, n, "undefined name '" + mod + "." + p.nodes[n].sval + "'")
    }
    fi = c.template_for_fn(fi)
    if mod != c.cur_mod && !c.fns[fi].is_pub {
        c.fail_node(p, n, "'" + p.nodes[n].sval + "' is private")
    }
    // Generic module function: infer type args, check constraints,
    // monomorphize — same path as a plain ident call, first arg from .b.
    if c.fns[fi].is_template {
        mut argc := 0
        mut arg := p.nodes[n].b
        mut checked_tys := []int{}
        mut arg_nodes := []int{}
        while arg >= 0 {
        aty := c.check_expr(p, arg)
        checked_tys.push(aty)
        arg_nodes.push(arg)
        argc += 1
        arg = p.nodes[arg].next
        }
        if c.fns[fi].variadic {
            if argc < c.fn_min_arity(fi) {
                c.fail_node(p, n, "function '" + p.nodes[n].sval + "' takes at least " + str(c.fn_min_arity(fi)) + " argument(s), found " + str(argc))
            }
        } else {
            if argc != c.fns[fi].params.len {
                c.fail_node(p, n, "wrong number of arguments")
            }
        }
        d := c.fndecl[fi]
        mut ntp := 0
        mut tp := p.nodes[d].e
        while tp >= 0 {
        // M156: skip lifetime-only `<>` names.
        if !c.fn_has_lt(fi, p.nodes[tp].sval) {
            ntp += 1
        }
        tp = p.nodes[tp].next
        }
        c.uni_bind = []int{}
        for k in 0:ntp {
            c.uni_bind.push(-1)
        }
        mut fixed := c.fns[fi].params.len
        if c.fns[fi].variadic {
            fixed = c.fns[fi].params.len - 1
        }
        for i in 0:fixed {
            if !c.unify(c.fns[fi].params[i], checked_tys[i]) {
                c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.ty_display(c.fns[fi].params[i]) + ", found " + c.ty_display(checked_tys[i]))
            }
        }
        if c.fns[fi].variadic {
            elem := c.fn_variadic_elem(fi)
            mut concrete := -1
            for i in fixed:argc {
                if concrete < 0 {
                    concrete = checked_tys[i]
                } else {
                    if checked_tys[i] != concrete {
                        c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.ty_display(concrete) + ", found " + c.ty_display(checked_tys[i]))
                    }
                }
            }
            if concrete >= 0 {
                if !c.unify(elem, concrete) {
                    c.fail_node(p, arg_nodes[fixed], "type mismatch: expected " + c.ty_display(elem) + ", found " + c.ty_display(concrete))
                }
            }
        }
        tp = p.nodes[d].e
        for k in 0:ntp {
            while tp >= 0 && c.fn_has_lt(fi, p.nodes[tp].sval) {
                tp = p.nodes[tp].next
            }
            if c.uni_bind[k] < 0 {
                c.fail_node(p, n, "cannot infer type parameter '" + p.nodes[tp].sval + "' for function '" + p.nodes[n].sval + "'")
            }
            tp = p.nodes[tp].next
        }
        for i in 0:arg_nodes.len {
            mut want := checked_tys[i]
            if i < fixed {
                want = c.fns[fi].params[i]
            }
            c.arg_pass(p, arg_nodes[i], checked_tys[i], want)
        }
        c.load_targs_uni(ntp)
        inst := c.instantiate_fn_n(p, fi, n)
        if inst < 0 { << error_ty }
        checker_set_i(mut &c.ncall, n, inst)
        c.record_call(inst)
        ty := c.fns[inst].ret
        << c.wrap_throwable_call_result(p, n, inst, ty)
    }
    mut argc := 0
    mut arg := p.nodes[n].b
    mut fixed := c.fns[fi].params.len
    mut variadic := c.fns[fi].variadic
    mut elem := -1
    if variadic {
        fixed = c.fns[fi].params.len - 1
        elem = c.fn_variadic_elem(fi)
    }
    while arg >= 0 {
        mut aty := c.check_expr(p, arg)
        mut want := -1
        if argc < fixed {
            want = c.fns[fi].params[argc]
        } else if variadic {
            want = elem
        }
        if want >= 0 {
            aty = c.coerce_to(p, arg, aty, want)
        }
        if want >= 0 && aty != want {
            c.fail_node(p, arg, "type mismatch: expected " + c.ty_display(want) + ", found " + c.ty_display(aty))
        }
        c.arg_pass(p, arg, aty, want)
        argc += 1
        arg = p.nodes[arg].next
    }
    if variadic {
        if argc < fixed {
            c.fail_node(p, n, "function '" + p.nodes[n].sval + "' takes at least " + str(fixed) + " argument(s), found " + str(argc))
        }
    } else {
        if argc != c.fns[fi].params.len {
            c.fail_node(p, n, "wrong number of arguments")
        }
    }
    checker_set_i(mut &c.ncall, n, fi)
    c.record_call(fi)
    ty := c.fns[fi].ret
    << c.wrap_throwable_call_result(p, n, fi, ty)
}

// M200: `temp(concrete)` moves a concrete struct into a heap-backed dynamic value.
fn (c &mut Checker) check_runtime_caller(p &parser.Parser, n int) int {
    arg := p.nodes[n].b
    if arg < 0 || p.nodes[arg].next >= 0 {
        c.fail_node(p, n, "caller takes exactly 1 argument")
    }
    if c.check_expr(p, arg) != 1 {
        c.fail_node(p, arg, "caller expects int")
    }
    // M174: compile-time callsite only — skip must be const 0 or 1 (no stack walk).
    if !c.is_const_int_expr(p, arg) {
        c.fail_node(p, arg, "runtime.caller skip must be a constant 0 or 1 (no stack walk)")
    }
    sk := c.const_int_expr_value(p, arg)
    if sk != 0 && sk != 1 {
        c.fail_node(p, arg, "runtime.caller: only skip 0 or 1 supported (compile-time; no stack walk)")
    }
    si := c.find_struct_in_mod("Frame", "runtime")
    if si < 0 {
        c.fail_node(p, n, "runtime.Frame not found (import runtime)")
    }
    // skip 0|1 both mean this call site (Go-style multi-skip needs frame walk).
    line := p.nodes[n].line
    file_idx := c.intern(c.cur_file_name)
    // M170: `runtime.caller(skip)` → Frame literal (ncall -97; -50 is os_stat).
    checker_set_i(mut &c.ncall, n, -97)
    checker_set_i(mut &c.nlocal, n, line)
    checker_set_i(mut &c.nstr, n, file_idx)
    checker_set_i(mut &c.nclone, n, 1)
    ty := struct_type(si)
    checker_set_i(mut &c.ntype, n, ty)
    << ty
}

// M200: `temp(value)` → heap-backed dynamic value (§0.1: 任意类型都可以入).
fn (c &mut Checker) check_box_any(p &parser.Parser, n int, args int) int {
    if args < 0 || p.nodes[args].next >= 0 {
        c.fail_node(p, n, "temp takes exactly 1 argument")
    }
    ty := c.check_expr(p, args)
    if is_dynamic_box(ty) {
        c.move_of(p, args, ty, false)
        checker_set_i(mut &c.ncall, n, -99) // Cast → temp (same fat layout)
        checker_set_i(mut &c.nlocal, n, 0)
        checker_set_i(mut &c.nstr, n, 0)
        checker_set_i(mut &c.ntype, n, temp_ty)
        << temp_ty
    }
    if !can_box_into_temp(ty) || temp_box_type_id(ty) < 0 || c.type_contains_ref(ty) {
        c.fail_node(p, args, "cannot box " + c.ty_display(ty) + " into temp")
    }
    c.move_of(p, args, ty, false)
    checker_set_i(mut &c.ncall, n, -98) // BoxTemp
    si3 := c.type_slots(ty)
    checker_set_i(mut &c.nstr, n, si3)
    checker_set_i(mut &c.ntype, n, temp_ty)
    << temp_ty
}

// M201/MS2: `Interface(concrete)` → heap-backed dynamic struct@ (structs only).
fn (c &mut Checker) check_box_interface(p &parser.Parser, n int, args int, ii int) int {
    if args < 0 || p.nodes[args].next >= 0 {
        c.fail_node(p, n, c.iface_names[ii] + " takes exactly 1 argument")
    }
    ty := c.check_expr(p, args)
    if !is_struct_type(ty) {
        c.fail_node(p, args, "cannot box " + c.ty_display(ty) + " into " + c.iface_names[ii] + " (only structs)")
    }
    if c.type_contains_ref(ty) {
        c.fail_node(p, args, "cannot box " + c.ty_display(ty) + " into " + c.iface_names[ii] + " (contains a reference)")
        << error_ty
    }
    if !c.check_interface_box_contract(p, ty, ii, args) { << error_ty }
    c.move_of(p, args, ty, false)
    checker_set_i(mut &c.ncall, n, -93) // BoxInterface
    checker_set_i(mut &c.nlocal, n, struct_index(ty)) // concrete struct id
    checker_set_i(mut &c.nstr, n, ii) // struct@ id for itable label
    checker_set_i(mut &c.ntype, n, iface_ty(ii))
    << c.ntype[n]
}

// ===== §5.7 throw/or =====
