@xu/types

// Bounded, function-local facts for word int/bool storage. No cache is
// attached to Mir/MFn: consume only with the same immutable (m, fi), and
// rebuild after any rewrite/commit. A version identifies a storage
// definition class, not equality of values across loop iterations.
// Reasons: 0 success, 1 context, 2 budget, 3 metadata/type, 4 stream/CFG,
// 5 unsupported/effects, 6 uninitialized read, 7 non-convergence,
// 8 non-private path, 9 expression outside Copy/wrapping +1.
pub struct MirValueFacts {
    pub reason int
    valid bool
    fi int
    ni int
    nb int
    nl int
    nt int
    np int
    data []int
}

// Flat owner avoids retaining nested MFn/array borrows in hosted frames.
// owner, ordinal, reachable, CSR starts, CSR preds, block-last-def,
// must-in, must-out, reaching-in, reaching-out.
fn mir_value_facts_off(f &MirValueFacts, part int) int {
    if part == 0 { << 0 }
    if part == 1 { << f.ni }
    if part == 2 { << f.ni * 2 }
    if part == 3 { << f.ni * 2 + f.nb }
    if part == 4 { << f.ni * 2 + f.nb * 2 + 1 }
    << f.ni * 2 + f.nb * 4 + 1 + (part - 5) * f.nb * (f.nl + f.nt)
}

fn mir_scalar_const_index(m &Mir, fi int, v int) int {
    if v > -2 { << -1 }
    // v+2 is safe even for INT_MIN; never evaluate -v first.
    ci := 0 - (v + 2)
    if ci < 0 || ci >= mir_nconsts(m, fi) { << -1 }
    << ci
}

fn mir_scalar_typed_value(m &Mir, fi int, v int, ty int) bool {
    if ty != 1 && ty != 2 { << false }
    if v >= 0 { << v < mir_ntemps(m, fi) && mir_temp_ty(m, fi, v) == ty }
    ci := mir_scalar_const_index(m, fi, v)
    if ci < 0 { << false }
    cv := mir_const_at(m, fi, ci)
    << ty == 1 || cv == 0 || cv == 1
}

fn mir_scalar_instr_ok(m &Mir, fi int, ii int) bool {
    k := mir_ikind(m, fi, ii)
    if k == 0 { << true }
    if k < 1 || k > 5 { << false }
    if !mir_verify_emission_instr_shape(m, fi, ii) { << false }
    a := mir_ia(m, fi, ii)
    b := mir_ib(m, fi, ii)
    mut ty := 0
    if k == 3 { ty = mir_local_ty(m, fi, a) }
    else { ty = mir_temp_ty(m, fi, a) }
    if k == 1 || k == 3 { << mir_scalar_typed_value(m, fi, b, ty) }
    if k == 2 { << mir_local_ty(m, fi, b) == ty }
    if mir_effect_has(mir_instr_effects_m(m, fi, ii), mir_effect_call) { << false }
    c := mir_ic(m, fi, ii)
    if k == 5 {
        // Numeric negation/word wrap cast, or boolean logical not. Floating
        // conversion opcodes 3/4 stay outside this scalar domain.
        if b == 1 || b == 5 { << ty == 1 && mir_scalar_typed_value(m, fi, c, 1) }
        if b == 2 { << ty == 2 && mir_scalar_typed_value(m, fi, c, 2) }
        << false
    }
    d := mir_id(m, fi, ii)
    if b >= 6 && b <= 11 {
        if ty != 2 { << false }
        if mir_scalar_typed_value(m, fi, c, 1) && mir_scalar_typed_value(m, fi, d, 1) { << true }
        << (b == 6 || b == 7) && mir_scalar_typed_value(m, fi, c, 2) && mir_scalar_typed_value(m, fi, d, 2)
    }
    << ty == 1 && mir_scalar_typed_value(m, fi, c, 1) && mir_scalar_typed_value(m, fi, d, 1)
}

fn mir_scalar_def_cell(m &Mir, fi int, ii int, nl int) int {
    k := mir_ikind(m, fi, ii)
    if k == 0 { << -1 }
    if k == 3 { << mir_ia(m, fi, ii) }
    << nl + mir_ia(m, fi, ii)
}

fn mir_scalar_used_cell(m &Mir, fi int, ii int, which int, nl int) int {
    k := mir_ikind(m, fi, ii)
    if k == 2 && which == 0 { << mir_ib(m, fi, ii) }
    mut v := -1
    if (k == 1 || k == 3) && which == 0 { v = mir_ib(m, fi, ii) }
    if (k == 4 || k == 5) && which == 0 { v = mir_ic(m, fi, ii) }
    if k == 4 && which == 1 { v = mir_id(m, fi, ii) }
    if (k == 17 || k == 26 || k == 14) && which == 0 {
        v = mir_ib(m, fi, ii)
        if k == 14 && v >= mir_local_operand_base { << v - mir_local_operand_base }
    }
    if k == 14 && which == 1 { v = mir_ic(m, fi, ii) }
    if v >= 0 { << nl + v }
    << -1
}

// Meet for may-reaching definitions: bottom=-1, conflicting=-2, exact>=0.
// Conflict is absorbing; it never equates distinct cells' merge values.
fn mir_scalar_key_join(a int, b int) int {
    if a == -1 { << b }
    if b == -1 { << a }
    if a == b { << a }
    << -2
}

fn mir_scalar_cfg_edge(m &Mir, fi int, from int, to int) bool {
    tk := mir_btkind(m, fi, from)
    if tk == 1 { << mir_bta(m, fi, from) == to }
    << tk == 2 && (mir_btb(m, fi, from) == to || mir_btc(m, fi, from) == to)
}

// Keep the original scalar domain closed. The separate readonly reader
// adds typed descriptor reads without changing scalar/SSA admission.
pub fn new_mir_value_facts(m &Mir, fi int) MirValueFacts {
    << mir_value_facts_new(m, fi, false)
}

fn mir_value_facts_new(m &Mir, fi int, readonly bool) MirValueFacts {
    mut f := MirValueFacts{reason: 1, valid: false, fi: fi, ni: 0, nb: 0, nl: 0, nt: 0, np: 0, data: []int{}}
    if fi < 0 || fi >= m.fns.len { << f }
    f.ni = mir_nins(m, fi)
    f.nb = mir_nblocks(m, fi)
    f.nl = mir_nlocals(m, fi)
    f.nt = mir_ntemps(m, fi)
    f.np = mir_fn_nparams(m, fi)
    f.reason = 2
    if f.ni < 0 || f.ni > 1024 || f.nb <= 0 || f.nb > 32 || f.nl < 0 || f.nl > 48 || f.nt < 0 || f.nt > 512 { << f }
    n := f.nl + f.nt
    if n > 256 || f.nb * n > 8192 || mir_nconsts(m, fi) > 4096 { << f }
    f.reason = 3
    if f.np < 0 || f.np > f.nl || m.fns[fi].locals_nslots.len != f.nl || m.fns[fi].temps_nslots.len != f.nt || m.fns[fi].locals_owning.len != f.nl { << f }
    if m.fns[fi].phis.len != 0 || m.fns[fi].phi_args.len != 0 { << f }
    for c in 0:n {
        mut ty := 0
        mut slots := 0
        if c < f.nl {
            if m.fns[fi].locals_owning[c] { << f }
            ty = mir_local_ty(m, fi, c)
            slots = mir_local_nslots(m, fi, c)
        } else {
            ty = mir_temp_ty(m, fi, c - f.nl)
            slots = mir_temp_nslots(m, fi, c - f.nl)
        }
        if readonly {
            if !mir_readonly_cell_type(m, ty, slots, c < f.nl, c < f.np) { << f }
        } else if slots != 1 || (ty != 1 && ty != 2) { << f }
    }
    for _ in 0:mir_value_facts_off(&f, 10) { f.data.push(0) }
    for ii in 0:f.ni { f.data[ii] = -1
        f.data[f.ni + ii] = -1 }
    last_off := mir_value_facts_off(&f, 5)
    min_off := mir_value_facts_off(&f, 6)
    mout_off := mir_value_facts_off(&f, 7)
    kin_off := mir_value_facts_off(&f, 8)
    kout_off := mir_value_facts_off(&f, 9)
    for i in 0:f.nb * n { f.data[last_off + i] = -1
        f.data[kin_off + i] = -1
        f.data[kout_off + i] = -1 }
    f.reason = 4
    for bi in 0:f.nb {
        mut ii := mir_bhead(m, fi, bi)
        mut last := -1
        mut ordinal := 0
        for _ in 0:f.ni + 1 {
            if ii == -1 { <- }
            if ii < 0 || ii >= f.ni || f.data[ii] != -1 { << f }
            f.data[ii] = bi
            f.data[f.ni + ii] = ordinal
            mut supported := mir_scalar_instr_ok(m, fi, ii)
            if readonly { supported = mir_readonly_instr_ok(m, fi, ii) }
            if !supported { f.reason = 5
                << f }
            cell := mir_scalar_def_cell(m, fi, ii, f.nl)
            if cell >= 0 { f.data[last_off + bi * n + cell] = ii }
            last = ii
            ordinal += 1
            ii = mir_inext(m, fi, ii)
        }
        if ii != -1 || last != mir_btail(m, fi, bi) { << f }
        tk := mir_btkind(m, fi, bi)
        a := mir_bta(m, fi, bi)
        b := mir_btb(m, fi, bi)
        c := mir_btc(m, fi, bi)
        if tk == 0 {
            if last != -1 || a != -1 || b != -1 || c != -1 { << f }
        } else if tk == 1 {
            if a < 0 || a >= f.nb { << f }
        } else if tk == 2 {
            if b < 0 || b >= f.nb || c < 0 || c >= f.nb || !mir_scalar_typed_value(m, fi, a, 2) { << f }
        } else if tk == 3 {
            if a != -1 && !mir_scalar_typed_value(m, fi, a, m.fns[fi].ret) { << f }
            if m.fns[fi].ret == 0 && a != -1 { << f }
            // Lowering may retain an empty, unreachable trailing Return
            // after a value return. Defer only that exact tombstone until
            // reachability is known; a reachable value-less return is invalid.
            if m.fns[fi].ret != 0 && a == -1 {
                if last != -1 || b != -1 || c != -1 { << f }
            }
        } else { << f }
    }
    // Only detached NoOps may remain in the pool. Executable orphan records
    // cannot silently escape ownership or effect checks.
    for ii in 0:f.ni {
        if f.data[ii] < 0 && mir_ikind(m, fi, ii) != 0 { << f }
    }
    roff := mir_value_facts_off(&f, 2)
    f.data[roff] = 1
    for _ in 0:f.nb {
        for bi in 0:f.nb {
            if f.data[roff + bi] == 0 { -> }
            tk := mir_btkind(m, fi, bi)
            if tk == 0 { << f }
            if tk == 1 { f.data[roff + mir_bta(m, fi, bi)] = 1 }
            if tk == 2 { f.data[roff + mir_btb(m, fi, bi)] = 1
                f.data[roff + mir_btc(m, fi, bi)] = 1 }
        }
    }
    for bi in 0:f.nb {
        if f.data[roff + bi] == 1 && mir_btkind(m, fi, bi) == 3 && m.fns[fi].ret != 0 && mir_bta(m, fi, bi) == -1 { << f }
    }
    soff := mir_value_facts_off(&f, 3)
    poff := mir_value_facts_off(&f, 4)
    mut edges := 0
    for to in 0:f.nb {
        f.data[soff + to] = edges
        for from in 0:f.nb {
            if f.data[roff + from] == 0 { -> }
            if mir_scalar_cfg_edge(m, fi, from, to) {
                f.data[poff + edges] = from
                edges += 1
            }
        }
    }
    f.data[soff + f.nb] = edges
    for bi in 0:f.nb {
        if f.data[roff + bi] == 0 { -> }
        for cell in 0:n {
            at := bi * n + cell
            mut seed := 0
            if bi != 0 || cell < f.np { seed = 1 }
            f.data[min_off + at] = seed
            if f.data[last_off + at] >= 0 { seed = 1 }
            f.data[mout_off + at] = seed
        }
    }
    f.reason = 7
    mut converged := false
    for _ in 0:f.nb + 2 {
        mut changed := false
        for bi in 0:f.nb {
            if f.data[roff + bi] == 0 { -> }
            for cell in 0:n {
                at := bi * n + cell
                mut value := 1
                if bi == 0 && cell >= f.np { value = 0 }
                for ei in f.data[soff + bi]:f.data[soff + bi + 1] {
                    pred := f.data[poff + ei]
                    if f.data[mout_off + pred * n + cell] == 0 { value = 0 }
                }
                if f.data[min_off + at] != value { f.data[min_off + at] = value
                    changed = true }
                if f.data[last_off + at] >= 0 { value = 1 }
                if f.data[mout_off + at] != value { f.data[mout_off + at] = value
                    changed = true }
            }
        }
        if !changed { converged = true
            <- }
    }
    if !converged { << f }
    converged = false
    for _ in 0:f.nb + 2 {
        mut changed := false
        for bi in 0:f.nb {
            if f.data[roff + bi] == 0 { -> }
            for cell in 0:n {
                at := bi * n + cell
                mut key := -1
                if bi == 0 && cell < f.np { key = f.ni + cell }
                for ei in f.data[soff + bi]:f.data[soff + bi + 1] {
                    pred := f.data[poff + ei]
                    key = mir_scalar_key_join(key, f.data[kout_off + pred * n + cell])
                }
                if f.data[kin_off + at] != key { f.data[kin_off + at] = key
                    changed = true }
                if f.data[last_off + at] >= 0 { key = f.data[last_off + at] }
                if f.data[kout_off + at] != key { f.data[kout_off + at] = key
                    changed = true }
            }
        }
        if !changed { converged = true
            <- }
    }
    if !converged { << f }
    // Prove every reachable read at its exact prefix, including terminators.
    f.reason = 6
    for bi in 0:f.nb {
        if f.data[roff + bi] == 0 { -> }
        mut available := []int{}
        for cell in 0:n { available.push(f.data[min_off + bi * n + cell]) }
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:f.ni {
            if ii == -1 { <- }
            for which in 0:2 {
                cell := mir_scalar_used_cell(m, fi, ii, which, f.nl)
                if cell >= 0 && available[cell] == 0 { << f }
            }
            cell := mir_scalar_def_cell(m, fi, ii, f.nl)
            if cell >= 0 { available[cell] = 1 }
            ii = mir_inext(m, fi, ii)
        }
        tk := mir_btkind(m, fi, bi)
        value := mir_bta(m, fi, bi)
        if (tk == 2 || tk == 3) && value >= 0 && available[f.nl + value] == 0 { << f }
    }
    f.reason = 0
    f.valid = true
    << f
}

pub fn mir_value_facts_reachable(f &MirValueFacts, bi int) bool {
    if !f.valid || f.reason != 0 || bi < 0 || bi >= f.nb { << false }
    << f.data[mir_value_facts_off(f, 2) + bi] == 1
}

pub fn mir_value_facts_owner(f &MirValueFacts, ii int) int {
    if !f.valid || f.reason != 0 || ii < 0 || ii >= f.ni { << -1 }
    << f.data[ii]
}

pub fn mir_value_facts_ordinal(f &MirValueFacts, ii int) int {
    if !f.valid || f.reason != 0 || ii < 0 || ii >= f.ni { << -1 }
    << f.data[f.ni + ii]
}

pub fn mir_value_facts_pred_count(f &MirValueFacts, bi int) int {
    if !mir_value_facts_reachable(f, bi) { << -1 }
    off := mir_value_facts_off(f, 3)
    << f.data[off + bi + 1] - f.data[off + bi]
}

fn mir_value_facts_cell(f &MirValueFacts, kind int, id int) int {
    if kind == 1 && id >= 0 && id < f.nl { << id }
    if kind == 2 && id >= 0 && id < f.nt { << f.nl + id }
    << -1
}

// -2 invalid/unreachable point, -1 not initialized on every entry path.
// >=0 exact definition/formal key, or distinct per-(block,cell) merge token.
// A token is NOT an authorization to equate dynamic iterations or to move
// arithmetic. before=-1 denotes the terminator; all other points are exact.
pub fn mir_value_facts_version(m &Mir, fi int, f &MirValueFacts, bi int, before int, kind int, id int) int {
    if fi != f.fi || fi < 0 || fi >= m.fns.len || mir_nins(m, fi) != f.ni || mir_nblocks(m, fi) != f.nb || mir_nlocals(m, fi) != f.nl || mir_ntemps(m, fi) != f.nt { << -2 }
    if !mir_value_facts_reachable(f, bi) || before < -1 || before >= f.ni { << -2 }
    if before >= 0 && f.data[before] != bi { << -2 }
    cell := mir_value_facts_cell(f, kind, id)
    if cell < 0 { << -2 }
    at := bi * (f.nl + f.nt) + cell
    mut initialized := f.data[mir_value_facts_off(f, 6) + at]
    mut key := f.data[mir_value_facts_off(f, 8) + at]
    mut ii := mir_bhead(m, fi, bi)
    for _ in 0:f.ni {
        if ii == -1 || ii == before { <- }
        if mir_scalar_def_cell(m, fi, ii, f.nl) == cell { initialized = 1
            key = ii }
        ii = mir_inext(m, fi, ii)
    }
    if initialized == 0 { << -1 }
    if key == -2 { << f.ni + f.nl + f.nt + at }
    << key
}

pub struct MirScalarEdgePlan {
    pub reason int
    pub from int
    pub start int
    pub join int
    valid bool
    nl int
    nt int
    blocks []int
    // Four flat lanes: kind(0 unknown,1 branch snapshot cell,2 constant),
    // source, wrapping increment(0/1), touched. All intermediate writes
    // remain represented; this reader never authorizes deleting their uses.
    values []int
}

fn mir_scalar_edge_source(m &Mir, fi int, e &MirScalarEdgePlan, value int) int {
    if value >= 0 { << e.nl + value }
    ci := mir_scalar_const_index(m, fi, value)
    if ci < 0 { << -1 }
    << 0 - ci - 2
}

pub fn mir_read_scalar_edge(m &Mir, fi int, f &MirValueFacts, from int, start int, join int) MirScalarEdgePlan {
    mut e := MirScalarEdgePlan{reason: 1, valid: false, from: from, start: start, join: join, nl: f.nl, nt: f.nt, blocks: []int{}, values: []int{}}
    if fi != f.fi || fi < 0 || fi >= m.fns.len || mir_nins(m, fi) != f.ni || mir_nblocks(m, fi) != f.nb || mir_nlocals(m, fi) != f.nl || mir_ntemps(m, fi) != f.nt { << e }
    if !f.valid || f.reason != 0 { e.reason = f.reason
        if e.reason == 0 { e.reason = 1 }
        << e }
    e.reason = 8
    if !mir_value_facts_reachable(f, from) || !mir_value_facts_reachable(f, start) || !mir_value_facts_reachable(f, join) { << e }
    if !mir_scalar_cfg_edge(m, fi, from, start) || from == start { << e }
    n := f.nl + f.nt
    for _ in 0:n * 4 { e.values.push(0) }
    for cell in 0:n {
        mut kind := 2
        mut id := cell - f.nl
        if cell < f.nl { kind = 1
            id = cell }
        if mir_value_facts_version(m, fi, f, from, -1, kind, id) >= 0 { e.values[cell] = 1 }
        e.values[n + cell] = cell
    }
    mut bi := start
    mut pred := from
    mut steps := 0
    for _ in 0:9 {
        if bi == join { e.reason = 0
            e.valid = true
            << e }
        if bi == from || mir_value_facts_pred_count(f, bi) != 1 { << e }
        for j in 0:e.blocks.len { if e.blocks[j] == bi { << e } }
        poff := mir_value_facts_off(f, 4)
        soff := mir_value_facts_off(f, 3)
        if f.data[poff + f.data[soff + bi]] != pred || mir_btkind(m, fi, bi) != 1 { << e }
        if e.blocks.len >= 8 { e.reason = 2
            << e }
        e.blocks.push(bi)
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:f.ni {
            if ii == -1 { <- }
            if steps >= 128 { e.reason = 2
                << e }
            steps += 1
            k := mir_ikind(m, fi, ii)
            if k != 0 {
                dest := mir_scalar_def_cell(m, fi, ii, f.nl)
                mut source := -1
                mut increment := 0
                if k == 1 || k == 3 { source = mir_scalar_edge_source(m, fi, &e, mir_ib(m, fi, ii)) }
                else if k == 2 { source = mir_ib(m, fi, ii) }
                else if k == 4 && mir_ib(m, fi, ii) == 1 {
                    c := mir_ic(m, fi, ii)
                    d := mir_id(m, fi, ii)
                    ci := mir_scalar_const_index(m, fi, c)
                    di := mir_scalar_const_index(m, fi, d)
                    if di >= 0 && mir_const_at(m, fi, di) == 1 { source = mir_scalar_edge_source(m, fi, &e, c) }
                    else if ci >= 0 && mir_const_at(m, fi, ci) == 1 { source = mir_scalar_edge_source(m, fi, &e, d) }
                    increment = 1
                }
                e.reason = 9
                if source == -1 { << e }
                mut sk := 2
                mut sv := 0
                mut add := increment
                if source >= 0 {
                    sk = e.values[source]
                    sv = e.values[n + source]
                    add += e.values[n * 2 + source]
                } else { sv = mir_const_at(m, fi, 0 - (source + 2)) }
                if sk == 0 { e.reason = 6
                    << e }
                if add > 1 { << e }
                e.values[dest] = sk
                e.values[n + dest] = sv
                e.values[n * 2 + dest] = add
                e.values[n * 3 + dest] = 1
                e.reason = 8
            }
            ii = mir_inext(m, fi, ii)
        }
        pred = bi
        bi = mir_bta(m, fi, bi)
    }
    e.reason = 2
    << e
}

// lane 0 kind, 1 source, 2 wrapping increment, 3 touched. Snapshot sources
// are flat cells: Local [0,nl), Temp [nl,nl+nt), observed at from's end.
pub fn mir_scalar_edge_value(e &MirScalarEdgePlan, kind int, id int, lane int) int {
    if !e.valid || e.reason != 0 || lane < 0 || lane > 3 { << -1 }
    mut cell := -1
    if kind == 1 && id >= 0 && id < e.nl { cell = id }
    if kind == 2 && id >= 0 && id < e.nt { cell = e.nl + id }
    if cell < 0 { << -1 }
    << e.values[lane * (e.nl + e.nt) + cell]
}

pub fn mir_scalar_edge_block_count(e &MirScalarEdgePlan) int {
    if !e.valid || e.reason != 0 { << -1 }
    << e.blocks.len
}
