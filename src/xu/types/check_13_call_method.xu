@xu/types

#xu/ast
#xu/parser

// Enum construction: `Color.Red` / `Opt#int.Some(5)` / inferred `Opt.Some(5)`.
// `n` is the Field or MethodCall node. Returns type tag, or -1 if not a ctor.
fn (c &mut Checker) try_enum_ctor(p &parser.Parser, n int, args_head int) int {
    recv := p.nodes[n].a
    qualified := p.nodes[recv].kind == ast.NK_FIELD
    if p.nodes[recv].kind != ast.NK_IDENT && !qualified { << -1 }
    mut enum_mod := c.cur_mod + ""
    mut enum_name := p.nodes[recv].sval + ""
    if qualified {
        if c.find_local(c.chain_root(p, recv)) >= 0 { << -1 }
        spelling := c.chain_path(p, recv)
        enum_mod = c.enum_qualifier_module(spelling + "")
        if enum_mod.len == 0 { << -1 }
        enum_name = local_after_dot(spelling + "", last_dot(spelling + ""))
    }
    has_targs := !qualified && p.nodes[recv].a >= 0
    if !has_targs {
        if c.find_local(p.nodes[recv].sval) >= 0 {
            << -1
        }
    }
    mut ei := -1
    if has_targs {
        c.collect_type_list_n(p, p.nodes[recv].a)
        if c.find_etpl(p.nodes[recv].sval, c.cur_mod) < 0 {
            if c.find_enum_in_mod(p.nodes[recv].sval, c.cur_mod) >= 0 {
                c.fail_node(p, n, "enum '" + p.nodes[recv].sval + "' is not generic")
            }
            << -1
        }
        ei = c.instantiate_enum(p, recv)
    } else {
        ei = c.find_enum_in_mod(enum_name + "", enum_mod + "")
        if ei < 0 {
            if qualified { << -1 }
            ti := c.find_etpl(p.nodes[recv].sval, c.cur_mod)
            if ti < 0 {
                << -1
            }
            ei = c.infer_enum_ctor(p, n, ti, args_head)
        }
    }
    if qualified {
        if !c.module_visible(enum_mod + "") { c.fail_node(p, n, "module " + enum_mod + " not imported") }
        if enum_mod != c.cur_mod && !c.enums[ei].is_pub { c.fail_node(p, n, "'" + enum_name + "' is private") }
    }
    mut vidx := -1
    for i in 0:c.enums[ei].variants.len {
        if c.enums[ei].variants[i].name == p.nodes[n].sval {
            vidx = i
        }
    }
    if vidx < 0 {
        c.fail_node(p, n, "enum '" + c.enums[ei].name + "' has no variant '" + p.nodes[n].sval + "'")
    }
    nfields := c.enums[ei].variants[vidx].fields.len
    mut argc := 0
    mut arg := args_head
    while arg >= 0 {
        mut aty := c.check_expr(p, arg)
        if argc < nfields {
            want := c.enums[ei].variants[vidx].fields[argc]
            aty = c.coerce_to(p, arg, aty, want)
            if aty != want {
                c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
            }
            c.move_of(p, arg, aty, false)
        }
        argc += 1
        arg = p.nodes[arg].next
    }
    if argc != nfields {
        c.fail_node(p, n, "variant '" + c.enum_pattern_name(ei) + "." + p.nodes[n].sval + "' expects " + str(nfields) + " argument(s), found " + str(argc))
    }
    checker_set_i(mut &c.ncall, n, -30)
    checker_set_i(mut &c.nlocal, n, vidx)
    ty := enum_type(ei)
    checker_set_i(mut &c.ntype, n, ty)
    << ty
}

fn (c &mut Checker) infer_enum_ctor(p &parser.Parser, n int, ti int, args_head int) int {
    d := c.etpl_decl[ti]
    vname := p.nodes[n].sval + ""
    tname := c.etpl_name[ti] + ""
    mut found := -1
    mut v := p.nodes[d].a
    while v >= 0 {
        if p.nodes[v].sval == vname {
            found = v
        }
        v = p.nodes[v].next
    }
    if found < 0 {
        c.fail_node(p, n, "enum '" + tname + "' has no variant '" + vname + "'")
    }
    mut nfields := 0
    mut ft := p.nodes[found].a
    while ft >= 0 {
        nfields += 1
        ft = p.nodes[ft].next
    }
    mut argc := 0
    mut arg := args_head
    while arg >= 0 {
        argc += 1
        arg = p.nodes[arg].next
    }
    if argc != nfields {
        c.fail_node(p, n, "variant '" + tname + "." + vname + "' expects " + str(nfields) + " argument(s), found " + str(argc))
    }
    if argc == 0 {
        c.fail_node(p, n, "generic enum '" + tname + "' requires type arguments")
    }
    mut pnames := []string{}
    mut tp := p.nodes[d].e
    while tp >= 0 {
        pnames.push(p.nodes[tp].sval)
        tp = p.nodes[tp].next
    }
    mut binds := []int{}
    for i in 0:pnames.len {
        binds.push(-1)
    }
    arg = args_head
    ft = p.nodes[found].a
    while arg >= 0 {
        aty := c.check_expr(p, arg)
        if p.nodes[ft].kind == ast.NT_NAMED && p.nodes[ft].a < 0 {
            for k in 0:pnames.len {
                if p.nodes[ft].sval == pnames[k] {
                    if binds[k] < 0 {
                        binds[k] = aty
                    }
                }
            }
        }
        arg = p.nodes[arg].next
        ft = p.nodes[ft].next
    }
    for k in 0:binds.len {
        if binds[k] < 0 {
            c.fail_node(p, n, "cannot infer type parameter '" + pnames[k] + "' for enum '" + tname + "'")
        }
    }
    c.load_targs(&binds, binds.len)
    << c.instantiate_enum(p, p.nodes[n].a)
}

fn (c &mut Checker) check_method_qual(p &parser.Parser, n int) int {
    recv := p.nodes[n].a
    if p.nodes[recv].kind == ast.NK_IDENT && p.nodes[recv].a >= 0 {
        ety := c.try_enum_ctor(p, n, p.nodes[n].b)
        if ety >= 0 {
            << ety
        }
    }
    if p.nodes[recv].kind == ast.NK_IDENT {
        lid := c.find_local(p.nodes[recv].sval)
        if lid < 0 {
            mut real2 := p.nodes[recv].sval + ""
            if !c.module_exists(real2 + "") {
                real2 = c.alias_of(real2 + "")
            }
            if !c.module_exists(real2 + "") {
                qm := c.qual_to_mod(p.nodes[recv].sval + "")
                if qm.len > 0 {
                    real2 = qm + ""
                }
            }
            if c.module_exists(real2 + "") {
                << c.check_module_call(p, n, real2)
            }
            ety := c.try_enum_ctor(p, n, p.nodes[n].b)
            if ety >= 0 {
                << ety
            }
        }
    }
    if p.nodes[recv].kind == ast.NK_FIELD {
        ety := c.try_enum_ctor(p, n, p.nodes[n].b)
        if ety >= 0 { << ety }
        // M18 dotted module call: strings.fn(...) — the full chain
        // must carry a registered module as a strict prefix, and the
        // root ident must not shadow a local.
        full := c.chain_path(p, n)
        mut m2 := c.longest_module(full + "")
        mut pre := m2.len
        if m2 == "" {
            a2 := c.longest_alias(full + "")
            if a2.len > 0 {
                pre = a2.len
                m2 = c.alias_of(a2 + "")
            }
        }
        if m2 == "" {
            hold := full + ""
            fd := first_dot(hold + "")
            if fd > 0 {
                head := local_before_dot(hold + "", fd)
                m2 = c.qual_to_mod(head + "")
                if m2.len > 0 {
                    pre = fd
                }
            } else {
                m2 = c.qual_to_mod(hold + "")
                if m2.len > 0 {
                    pre = hold.len
                }
            }
        }
        if m2 != "" && full.len > pre && full[pre] == 46 && c.find_local(c.chain_root(p, recv)) < 0 {
            << c.check_module_call(p, n, m2)
        }
    }
    << -1 // not a qualified / enum ctor call
}

// Wave C: push/iface/constraint/Ord.less specials (W3).
fn (c &mut Checker) check_method_bytes_runes(p &parser.Parser, n int) int {
    abi_syntax := p.nodes[n].sval + ""
    if c.require_runtime_abi(p, n, runtime_abi_syntax_id(&abi_syntax)) < 0 { << ERROR_TY }
    if p.nodes[n].b >= 0 {
        c.fail_node(p, n, p.nodes[n].sval + " takes no arguments")
    }
    if p.nodes[n].sval == "bytes" {
        checker_set_i(mut &c.ncall, n, -75)
    } else {
        checker_set_i(mut &c.ncall, n, -76)
    }
    si22 := c.intern_array_type(1)
    checker_set_i(mut &c.ntype, n, si22)
    << c.ntype[n]
}

fn (c &mut Checker) check_method_push_str(p &parser.Parser, n int, ot int, base_ty int) int {
        arg := p.nodes[n].b
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "push_str takes exactly 1 argument")
        }
        aty := c.check_expr(p, arg)
        if aty != 3 {
            c.fail_node(p, arg, "type mismatch: expected string, found " + c.diag_type_display(aty))
        }
        // Bootstrap accepts only a bare variable (or a &mut string receiver):
        // the descriptor write-back targets a local slot. Field receivers
        // compiled silently before — reject them like bootstrap does.
        if !is_mut_ref_type(ot) && p.nodes[p.nodes[n].a].kind != ast.NK_IDENT {
            c.fail_node(p, n, "push_str requires a variable or &mut string receiver")
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !is_mut_ref_type(ot) && (root < 0 || (c.lmut[root] == 0 && !is_mut_ref_type(c.ltype[root]))) {
            if root >= 0 && p.nodes[p.nodes[n].a].kind == ast.NK_IDENT {
                c.fail_node(p, n, "cannot call mut method 'push_str' on immutable variable '" + c.lname[root] + "'" + binding_mut_help(c.lname[root]))
            } else {
                c.fail_node(p, n, "push_str requires a mutable receiver")
            }
        }
        checker_set_i(mut &c.ncall, n, -3)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
}

fn (c &mut Checker) check_method_push_byte(p &parser.Parser, n int, ot int, base_ty int) int {
        arg := p.nodes[n].b
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "push_byte takes exactly 1 argument")
        }
        aty := c.check_expr(p, arg)
        if aty != 1 {
            c.fail_node(p, arg, "type mismatch: expected int, found " + c.diag_type_display(aty))
        }
        if !is_mut_ref_type(ot) && p.nodes[p.nodes[n].a].kind != ast.NK_IDENT {
            c.fail_node(p, n, "push_byte requires a variable or &mut string receiver")
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !is_mut_ref_type(ot) && (root < 0 || (c.lmut[root] == 0 && !is_mut_ref_type(c.ltype[root]))) {
            if root >= 0 && p.nodes[p.nodes[n].a].kind == ast.NK_IDENT {
                c.fail_node(p, n, "cannot call mut method 'push_byte' on immutable variable '" + c.lname[root] + "'" + binding_mut_help(c.lname[root]))
            } else {
                c.fail_node(p, n, "push_byte requires a mutable receiver")
            }
        }
        checker_set_i(mut &c.ncall, n, -110)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
}

fn (c &mut Checker) check_method_arr_push(p &parser.Parser, n int, ot int, base_ty int) int {
        if c.is_fixed_array_m(base_ty) {
            c.fail_node(p, n, "cannot push onto a fixed-size array")
        }
        arg := p.nodes[n].b
        if arg < 0 || p.nodes[arg].next >= 0 {
            c.fail_node(p, n, "push takes exactly 1 argument")
        }
        ai := array_index(base_ty)
        mut aty := c.check_expr(p, arg)
        aty = c.coerce_to(p, arg, aty, c.arrays[ai].elem_ty)
        if aty != c.arrays[ai].elem_ty {
            c.fail_node(p, arg, "type mismatch: push arg expected " + c.ty_display(c.arrays[ai].elem_ty) + ", found " + c.ty_display(aty))
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !is_mut_ref_type(ot) && (root < 0 || (c.lmut[root] == 0 && !is_mut_ref_type(c.ltype[root]))) {
            c.fail_node(p, n, "cannot call mut method 'push' on an immutable variable")
        }
        // M36 v1: push changes the length — drop the tracked length.
        if root >= 0 && root < c.llength_ok.len {
            checker_set_i(mut &c.llength_ok, root, 0)
        }
        c.move_of(p, arg, aty, false)
        checker_set_i(mut &c.ncall, n, -4) // arr.push marker
        checker_set_i(mut &c.ntype, n, 0)
        << 0
}

fn (c &mut Checker) check_method_arr_push4(p &parser.Parser, n int, ot int, base_ty int) int {
        if c.is_fixed_array_m(base_ty) {
            c.fail_node(p, n, "cannot push onto a fixed-size array")
        }
        // Four int appends in one grow (Gen1 emit32 / []int hot path).
        if c.arrays[array_index(base_ty)].elem_ty != 1 {
            c.fail_node(p, n, "push4 requires []int")
        }
        mut arg := p.nodes[n].b
        mut argc := 0
        while arg >= 0 {
            argc += 1
            mut aty := c.check_expr(p, arg)
            aty = c.coerce_to(p, arg, aty, 1)
            if aty != 1 {
                c.fail_node(p, arg, "type mismatch: push4 args must be int")
            }
            c.move_of(p, arg, aty, false)
            arg = p.nodes[arg].next
        }
        if argc != 4 {
            c.fail_node(p, n, "push4 takes exactly 4 arguments")
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !is_mut_ref_type(ot) && (root < 0 || (c.lmut[root] == 0 && !is_mut_ref_type(c.ltype[root]))) {
            c.fail_node(p, n, "cannot call mut method 'push4' on an immutable variable")
        }
        if root >= 0 && root < c.llength_ok.len {
            checker_set_i(mut &c.llength_ok, root, 0)
        }
        checker_set_i(mut &c.ncall, n, -51)
        checker_set_i(mut &c.ntype, n, 0)
        << 0
}

fn (c &mut Checker) check_method_iface(p &parser.Parser, n int, ot int, base_ty int) int {
        if is_ref_type(ot) {
            c.fail_node(p, n, "cannot call methods through &struct@ (M201)")
        }
        ii := interface_index(base_ty)
        mut found_mi := -1
        mut slot := 0
        for mi in 0:c.im_ii.len {
            if c.im_ii[mi] == ii && c.im_name[mi] == p.nodes[n].sval {
                if found_mi < 0 {
                    found_mi = mi
                    slot = 0
                    for j in 0:mi {
                        if c.im_ii[j] == ii {
                            slot += 1
                        }
                    }
                }
            }
        }
        if found_mi < 0 {
            c.fail_node(p, n, "struct@ value has no method '" + p.nodes[n].sval + "'")
        }
        if p.nodes[n].b >= 0 {
            mut argc := 0
            mut arg := p.nodes[n].b
            while arg >= 0 {
                mut aty := c.check_expr(p, arg)
                if argc < c.im_plen[found_mi] {
                    want := c.im_ptys[c.im_poff[found_mi] + argc]
                    aty = c.coerce_to(p, arg, aty, want)
                    if aty != want {
                        c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
                    }
                }
                argc += 1
                arg = p.nodes[arg].next
            }
            if argc != c.im_plen[found_mi] {
                c.fail_node(p, n, "method '" + p.nodes[n].sval + "' takes " + str(c.im_plen[found_mi]) + " argument(s)")
            }
        } else if c.im_plen[found_mi] != 0 {
            c.fail_node(p, n, "method '" + p.nodes[n].sval + "' takes " + str(c.im_plen[found_mi]) + " argument(s)")
        }
        checker_set_i(mut &c.ncall, n, -94) // InterfaceMethod
        checker_set_i(mut &c.nstr, n, slot)
        checker_set_i(mut &c.nlocal, n, ii)
        si23 := c.im_ret[found_mi]
        checker_set_i(mut &c.ntype, n, si23)
        << c.ntype[n]
}

fn (c &mut Checker) check_method_tparam(p &parser.Parser, n int, ot int, base_ty int) int {
        k := param_index(base_ty)
        if k < 0 || k >= c.tp_cons.len || c.tp_cons[k] == "" {
            c.fail_node(p, n, "type parameter has no method '" + p.nodes[n].sval + "' (no constraint)")
        }
        mut ii := -1
        mut hits := 0
        for i in 0:c.iface_names.len {
            if c.iface_names[i] == c.tp_cons[k] {
                if c.iface_mods[i] == c.cur_mod {
                    ii = i
                    hits = 1
                } else {
                    if ii < 0 {
                        ii = i
                    }
                    hits = hits + 1
                }
            }
        }
        if ii < 0 || (hits > 1 && c.iface_mods[ii] != c.cur_mod) {
            c.fail_node(p, n, "unknown struct@ '" + c.tp_cons[k] + "'")
        }
        mut found_mi := -1
        for mi in 0:c.im_ii.len {
            if c.im_ii[mi] == ii && c.im_name[mi] == p.nodes[n].sval {
                found_mi = mi
            }
        }
        if found_mi < 0 {
            c.fail_node(p, n, "struct@ '" + c.tp_cons[k] + "' has no method '" + p.nodes[n].sval + "'")
        }
        self_ty := base_ty
        mut argc := 0
        mut arg := p.nodes[n].b
        while arg >= 0 {
        aty := c.check_expr(p, arg)
        if argc < c.im_plen[found_mi] {
            want := subst_self_ty(c.im_ptys[c.im_poff[found_mi] + argc], self_ty)
            if aty != want {
                c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
            }
        }
        argc += 1
        arg = p.nodes[arg].next
        }
        if argc != c.im_plen[found_mi] {
            c.fail_node(p, n, "wrong number of arguments")
        }
        checker_set_i(mut &c.ncall, n, -72) // constraint method (M102); do not reuse -19 (str identity)
        si24 := subst_self_ty(c.im_ret[found_mi], self_ty)
        checker_set_i(mut &c.ntype, n, si24)
        << c.ntype[n]
}

fn (c &mut Checker) check_method_less(p &parser.Parser, n int, ot int, base_ty int) int {
        if p.nodes[n].b < 0 || p.nodes[p.nodes[n].b].next >= 0 {
            c.fail_node(p, n, "less takes exactly 1 argument")
        }
        argn := p.nodes[n].b
        aty := c.check_expr(p, argn)
        if aty != base_ty {
            c.fail_node(p, argn, "type mismatch: expected " + c.diag_type_display(base_ty) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, argn, base_ty, aty))
        }
        if base_ty == 1 || base_ty == 4 {
            // Desugar to BinOp Lt in MIR (ncall=-70).
            checker_set_i(mut &c.ncall, n, -70)
            checker_set_i(mut &c.ntype, n, 2)
            << 2
        }
        // string → cmp.less_string(recv, other); MIR ncall=-71
        if c.find_fn_in_mod("less_string", "cmp") < 0 {
            c.fail_node(p, n, "string.less requires cmp.less_string")
        }
        checker_set_i(mut &c.ncall, n, -71)
        checker_set_i(mut &c.ntype, n, 2)
        << 2
}

fn (c &mut Checker) check_method_special(p &parser.Parser, n int, ot int, base_ty int) int {
    if base_ty == 3 && (p.nodes[n].sval == "bytes" || p.nodes[n].sval == "runes") {
        << c.check_method_bytes_runes(p, n)
    }
    if base_ty == 3 && p.nodes[n].sval == "push_str" {
        << c.check_method_push_str(p, n, ot, base_ty)
    }
    if base_ty == 3 && p.nodes[n].sval == "push_byte" {
        << c.check_method_push_byte(p, n, ot, base_ty)
    }
    if is_array_type(base_ty) && p.nodes[n].sval == "push" {
        << c.check_method_arr_push(p, n, ot, base_ty)
    }
    if is_array_type(base_ty) && p.nodes[n].sval == "push4" {
        << c.check_method_arr_push4(p, n, ot, base_ty)
    }
    // M201/MS2: dynamic struct@ method dispatch (runtime via itable type_id).
    if is_interface_type(base_ty) {
        << c.check_method_iface(p, n, ot, base_ty)
    }
    // Constraint method on a type parameter (template definition site).
    if is_param_type(base_ty) {
        << c.check_method_tparam(p, n, ot, base_ty)
    }
    // M102: builtin Ord.less for int/f64/string.
    if p.nodes[n].sval == "less" && (base_ty == 1 || base_ty == 3 || base_ty == 4) {
        << c.check_method_less(p, n, ot, base_ty)
    }
    mt := c.peel_map(ot)
    if mt >= 0 {
        << c.check_method_native_map(p, n, ot, mt)
    }
    << -1 // fall through to user method
}

fn (c &mut Checker) check_method_native_map(p &parser.Parser, n int, ot int, mt int) int {
    mname := p.nodes[n].sval
    wantk := c.maps[map_index(mt)].key_ty
    wantv := c.maps[map_index(mt)].val_ty
        if mname == "delete" || mname == "take" {
            if is_ref_type(ot) && !is_mut_ref_type(ot) {
                c.fail_node(p, n, "cannot call mut method '" + mname + "' through a shared reference")
            }
            recv2 := p.nodes[n].a
            if !is_mut_ref_type(ot) && p.nodes[recv2].kind == ast.NK_IDENT {
                root := c.nlocal[recv2]
                if root < 0 || (c.lmut[root] == 0 && !is_mut_ref_type(c.ltype[root])) {
                    c.fail_node(p, n, "cannot call mut method '" + mname + "' on immutable variable '" + p.nodes[recv2].sval + "'" + binding_mut_help(p.nodes[recv2].sval))
                }
            } else if !is_mut_ref_type(ot) && p.nodes[recv2].kind != ast.NK_IDENT {
                c.fail_node(p, n, "mut method '" + mname + "' requires a variable as receiver")
            }
        }
        if mname == "len" {
            if p.nodes[n].b >= 0 {
                c.fail_node(p, n, "len takes no arguments")
            }
            checker_set_i(mut &c.ncall, n, -85)
            checker_set_i(mut &c.ntype, n, 1)
            << 1
        }
        if mname == "has" {
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next >= 0 {
                c.fail_node(p, n, "has takes exactly 1 argument")
            }
            aty := c.check_expr(p, arg)
            if aty != wantk {
                c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            checker_set_i(mut &c.ncall, n, -84)
            checker_set_i(mut &c.ntype, n, 2)
            << 2
        }
        if mname == "delete" {
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next >= 0 {
                c.fail_node(p, n, "delete takes exactly 1 argument")
            }
            aty := c.check_expr(p, arg)
            if aty != wantk {
                c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            checker_set_i(mut &c.ncall, n, -86)
            checker_set_i(mut &c.ntype, n, 0)
            << 0
        }
        if mname == "take" {
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next >= 0 {
                c.fail_node(p, n, "take takes exactly 1 argument")
            }
            aty := c.check_expr(p, arg)
            if aty != wantk {
                c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            checker_set_i(mut &c.ncall, n, -88)
            checker_set_i(mut &c.ntype, n, wantv)
            << wantv
        }
        if mname == "get_or" {
            if c.type_owning(wantv) && wantv != 3 {
                c.fail_node(p, n, "get_or is not supported for owning map values; use has/take")
            }
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next < 0 || p.nodes[p.nodes[arg].next].next >= 0 {
                c.fail_node(p, n, "get_or takes exactly 2 arguments")
            }
            aty := c.check_expr(p, arg)
            if aty != wantk {
                c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            defn := p.nodes[arg].next
            mut dty := c.check_expr(p, defn)
            dty = c.coerce_to(p, defn, dty, wantv)
            if dty != wantv {
                c.fail_node(p, defn, "type mismatch: expected " + c.diag_type_display(wantv) + ", found " + c.diag_type_display(dty) + c.borrow_type_hint(p, defn, wantv, dty))
            }
            c.move_of(p, defn, dty, false)
            checker_set_i(mut &c.ncall, n, -87)
            checker_set_i(mut &c.ntype, n, wantv)
            << wantv
        }
    c.fail_node(p, n, "type " + c.ty_display(ot) + " has no method '" + mname + "'")
    << 0
}

fn (c &mut Checker) check_method_expr(p &parser.Parser, n int) int {
    q := c.check_method_qual(p, n)
    if q != -1 {
        << q
    }
    if p.nodes[n].sval == "drop" {
        c.fail_node(p, n, "resource drop is compiler-managed; use an explicit close or finish method")
        << ERROR_TY
    }
    // May-throw calls must use `or (err) { }` — Result.unwrap/is_ok/is_err are removed.
    mut ot := c.check_expr(p, p.nodes[n].a)
    if is_error_type(ot) {
        checker_set_i(mut &c.ntype, n, ERROR_TY)
        << ERROR_TY
    }
    mut base_ty := c.direct_type(ot)
    // Monomorphized instance: shared template AST may still carry Param
    // types on nodes; use the instance's concrete type arg for Ord.less.
    if p.nodes[n].sval == "less" && c.is_inst[c.cur_fn] != 0 {
        t0 := c.inst_elem_t0(c.cur_fn)
        if t0 == 1 || t0 == 3 || t0 == 4 {
            base_ty = t0
        }
    }
    // Writable builtin signatures provide the same expectation as a user
    // method. Only an explicit &*local can take permission from it.
    recv := p.nodes[n].a
    m := p.nodes[n].sval
    builtin_write := (base_ty == 3 && (m == "push_str" || m == "push_byte")) || (is_array_type(base_ty) && (m == "push" || m == "push4")) || (is_map_type(base_ty) && (m == "delete" || m == "take"))
    if builtin_write && p.nodes[recv].kind == ast.NK_BORROW {
        want := c.make_ref_type(true, base_ty)
        if want >= 0 { ot = c.coerce_to(p, recv, ot, want) }
    }
    s := c.check_method_special(p, n, ot, base_ty)
    if s != -1 {
        << s
    }
    mut mname := p.nodes[n].sval + ""
    mut callsite := 0
    if is_struct_type(base_ty) {
        si0 := struct_index(base_ty)
        if c.structs[si0].mod_id == "log" && c.structs[si0].name == "Logger" {
            if mname == "println" {
                mname = "println_at"
                callsite = 1
            } else if mname == "print" {
                mname = "print_at"
                callsite = 1
            } else if mname == "printf" {
                mname = "printf_at"
                callsite = 1
            } else if mname == "fatal" {
                mname = "fatal_at"
                callsite = 1
            }
        }
    }
    mut fi := c.find_method(base_ty, mname)
    if fi < 0 {
        << c.fail_expr(p, n, "type " + c.ty_display(ot) + " has no method '" + p.nodes[n].sval + "'")
    }
    // Instantiate generic struct methods with the receiver's origin args.
    if c.fns[fi].is_template {
        if !is_struct_type(base_ty) {
            c.fail_node(p, n, "type " + c.ty_display(ot) + " has no method '" + p.nodes[n].sval + "'")
        }
        si := struct_index(base_ty)
        c.load_targs_sargs(si)
        fi = c.instantiate_fn_n(p, fi, n)
        if fi < 0 { << ERROR_TY }
    }
    if c.fns[fi].recv_mut {
        recv2 := p.nodes[n].a
        if p.nodes[recv2].kind == ast.NK_BORROW {
            ot = c.coerce_to(p, recv2, ot, c.fns[fi].recv)
        }
        allowed := is_mut_ref_type(ot) || (p.nodes[recv2].kind == ast.NK_IDENT && c.lmut[c.nlocal[recv2]] != 0)
        if !allowed {
            if is_ref_type(ot) && !is_mut_ref_type(ot) {
                c.fail_node(p, n, "cannot call mut method '" + p.nodes[n].sval + "' through a shared reference")
            }
            if p.nodes[recv2].kind == ast.NK_IDENT {
                c.fail_node(p, n, "cannot call mut method '" + p.nodes[n].sval + "' on immutable variable '" + p.nodes[recv2].sval + "'" + binding_mut_help(p.nodes[recv2].sval))
            }
            c.fail_node(p, n, "mut method '" + p.nodes[n].sval + "' requires a variable as receiver")
        }
    }
    mut argc := 0
    mut arg := p.nodes[n].b
    mut fixed := c.fns[fi].params.len
    mut variadic := c.fns[fi].variadic
    mut elem := -1
    if variadic {
        fixed = c.fns[fi].params.len - 1
        elem = c.fn_variadic_elem(fi)
    }
    // M170: virtual file/line args for log *at rewrite.
    mut virt := 0
    if callsite == 1 {
        virt = 2
        if fixed < 2 {
            c.fail_node(p, n, "internal: callsite rewrite needs file/line params")
        }
    }
    while arg >= 0 {
    mut aty := c.check_expr(p, arg)
    mut want := -1
    idx := argc + virt
    if idx < fixed {
        want = c.fns[fi].params[idx]
    } else if variadic {
        want = elem
    }
    if want >= 0 {
        aty = c.coerce_to(p, arg, aty, want)
    }
    if want >= 0 && aty != want {
        c.fail_node(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
    }
    c.arg_pass(p, arg, aty, want)
    argc += 1
    arg = p.nodes[arg].next
    }
    if variadic {
        if argc + virt < fixed {
            c.fail_node(p, n, "method '" + p.nodes[n].sval + "' takes at least " + str(fixed - virt) + " argument(s), found " + str(argc))
        }
    } else {
        if argc + virt != c.fns[fi].params.len {
            c.fail_node(p, n, "wrong number of arguments")
        }
    }
    checker_set_i(mut &c.ncall, n, fi)
    checker_set_i(mut &c.ncsite, n, callsite)
    if callsite == 1 {
        si25 := c.intern(c.cur_file_name)
        checker_set_i(mut &c.nstr, n, si25)
        checker_set_i(mut &c.nlocal, n, p.nodes[n].line)
    }
    c.record_call(fi)
    ty := c.fns[fi].ret
    << c.wrap_throwable_call_result(p, n, fi, ty)
}

// M184: field / module.const / enum.tag — split from check_expr (W3).
fn (c &mut Checker) check_field_expr(p &parser.Parser, n int) int {
    recv := p.nodes[n].a
    if p.nodes[recv].kind == ast.NK_FIELD {
        ety := c.try_enum_ctor(p, n, -1)
        if ety >= 0 { << ety }
    }
    if p.nodes[recv].kind == ast.NK_IDENT && p.nodes[recv].a >= 0 {
        ety := c.try_enum_ctor(p, n, -1)
        if ety >= 0 {
            << ety
        }
    }
    if p.nodes[recv].kind == ast.NK_IDENT {
            lid := c.find_local(p.nodes[recv].sval)
            if lid < 0 {
                // Re-read recv.sval each time (string locals move on use).
                mut real := p.nodes[recv].sval + ""
                if !c.module_exists(real + "") {
                    real = c.alias_of(real)
                }
                if !c.module_exists(real + "") {
                    qm := c.qual_to_mod(p.nodes[recv].sval + "")
                    if qm.len > 0 {
                        real = qm + ""
                    }
                }
                if c.module_exists(real + "") {
                    if !c.module_visible(real + "") {
                        c.fail_node(p, n, "module " + real + " not imported")
                    }
                    ci := c.find_const_in_mod(p.nodes[n].sval, real + "")
                    if ci < 0 {
                        fi := c.find_fn_in_mod(p.nodes[n].sval, real + "")
                        if fi >= 0 {
                            if real != c.cur_mod && !c.fns[fi].is_pub {
                                << c.fail_expr(p, n, "'" + p.nodes[n].sval + "' is private")
                            }
                            if c.fns[fi].is_template {
                                << c.fail_expr(p, n, "cannot take value of generic function (instantiate via a call)")
                            }
                            checker_set_i(mut &c.ncall, n, fi)
                            mut params := []int{}
                            for pi in 0:c.fns[fi].params.len { params.push(c.fns[fi].params[pi]) }
                            ty := c.intern_fn_sig(params, c.fns[fi].ret)
                            checker_set_i(mut &c.ntype, n, ty)
                            << ty
                        }
                        << c.fail_expr(p, n, "undefined name '" + real + "." + p.nodes[n].sval + "'")
                    }
                    if real != c.cur_mod && c.cpubs[ci] == 0 {
                        c.fail_node(p, n, "'" + p.nodes[n].sval + "' is private")
                    }
                    checker_set_i(mut &c.nconst, n, ci)
                    ty := c.ctypes[ci]
                    checker_set_i(mut &c.ntype, n, ty)
                    if ty == 3 {
                        si26 := c.cstr_idx[ci]
                        checker_set_i(mut &c.nstr, n, si26)
                    }
                    << ty
                }
                ety := c.try_enum_ctor(p, n, -1)
                if ety >= 0 {
                    << ety
                }
            }
        }
        if p.nodes[recv].kind == ast.NK_FIELD {
            // M18 dotted module const: xu.ast.tok_int (kind 8 already
            // handles xu.ast.token(...)).
            full := c.chain_path(p, n)
            mut m2 := c.longest_module(full + "")
            mut pre := m2.len
            if m2 == "" {
                a2 := c.longest_alias(full + "")
                if a2.len > 0 {
                    pre = a2.len
                    m2 = c.alias_of(a2 + "")
                }
            }
            if m2 != "" && full.len > pre && full[pre] == 46 {
                if c.find_local(c.chain_root(p, recv)) < 0 {
                    if !c.module_visible(m2 + "") {
                        c.fail_node(p, n, "module " + m2 + " not imported")
                    }
                    ci := c.find_const_in_mod(p.nodes[n].sval, m2 + "")
                    if ci < 0 {
                        c.fail_node(p, n, "undefined name '" + m2 + "." + p.nodes[n].sval + "'")
                    }
                    if m2 != c.cur_mod && c.cpubs[ci] == 0 {
                        c.fail_node(p, n, "'" + p.nodes[n].sval + "' is private")
                    }
                    checker_set_i(mut &c.nconst, n, ci)
                    ty := c.ctypes[ci]
                    checker_set_i(mut &c.ntype, n, ty)
                    if ty == 3 {
                        si27 := c.cstr_idx[ci]
                        checker_set_i(mut &c.nstr, n, si27)
                    }
                    << ty
                }
            }
        }
        ot := c.check_expr(p, p.nodes[n].a)
        if is_error_type(ot) {
            checker_set_i(mut &c.ntype, n, ERROR_TY)
            << ERROR_TY
        }
        oa := p.nodes[n].a
        if oa >= 0 && p.nodes[oa].kind == ast.NK_INDEX && oa < c.ncall.len && c.ncall[oa] == -77 {
            if ot != 3 && c.type_owning(ot) {
                c.fail_node(p, n, "cannot move an owning map value by index; borrow it or take it")
            }
        }
        base_ty := c.direct_type(ot)
        if base_ty == 3 && p.nodes[n].sval == "len" { // string .len
            checker_set_i(mut &c.ntype, n, 1)
            << 1
        }
        if is_array_type(base_ty) {
            // arr.len returns int. MIR field offsets are bytes.
            if p.nodes[n].sval == "len" {
                fl := c.array_fixed_len_m(base_ty)
                if fl > 0 {
                    // Fold to a compile-time constant (nlocal = length).
                    checker_set_i(mut &c.ncall, n, -96)
                    checker_set_i(mut &c.nlocal, n, fl)
                    checker_set_i(mut &c.ntype, n, 1)
                    << 1
                }
                checker_set_i(mut &c.nlocal, n, 8)
                checker_set_i(mut &c.ntype, n, 1)
                << 1
            }
            c.fail_node(p, n, "array has no field '" + p.nodes[n].sval + "'")
        }
        if is_struct_type(base_ty) {
            si := struct_index(base_ty)
            fi := c.find_field(si, p.nodes[n].sval)
            if fi < 0 {
                // M110: `obj.method` in value position → method value.
                << c.check_method_value(p, n, base_ty, ot)
            }
            c.require_field_visible(p, n, si, fi)
            checker_set_i(mut &c.nlocal, n, fi) // record the field index for mir/emit
            obj := p.nodes[n].a
            if p.nodes[obj].kind == ast.NK_IDENT {
                rid := c.nlocal[obj]
                c.check_field_not_moved(p, rid, fi, p.nodes[n].a)
            }
            pth := c.as_place_path(p, n)
            rid2 := c.as_top_field_id(p, n)
            if rid2 >= 0 && pth >= 64 {
                c.check_path_not_moved(p, rid2, pth, n)
            }
            fty := c.structs[si].fields[fi].ty
            checker_set_i(mut &c.ntype, n, fty)
            << fty
        }
        c.fail_node(p, n, "type has no fields")
        << -1
}
