@xu/types
// `xu cbind`: render the C side of a program's FFI surface as a C header.
//
// The header declares, for the declarations of the user's (non-stdlib)
// source files: int/bool/string consts as macros, @repr("C") structs and
// unions (bitfields, fixed arrays) with static layout assertions computed
// by the checker for the selected target, extern "C" globals and extern
// "C" function prototypes (callbacks as C function pointers). Including it
// from C checks that both sides agree on layout and signatures.

#xu/ast
#xu/parser

// Type-check p for target_code and return the generated header. Caller must
// pass a fresh `types.Checker{}` constructed outside `@xu/types`. Files
// whose path starts with skip_prefix (the stdlib root) are not emitted, but
// structs they define are emitted when a user declaration needs them.
pub fn cbind_header(c $&Checker, p &parser.Parser, target_code int, native_labels &[]string, skip_prefix string, guard_name string) string {
    c.cbind_on = true
    c.cbind_skip = skip_prefix + ""
    c.cbind_guard = guard_name + ""
    $m := DummyMir{dummy: 0, opt_level: 0}
    $out_fns := []CFn{}
    run_checker(c, p, target_code, 0, 1, ~native_labels, []string{}, 0, $&m, []string{}, "", false, false, 1, false, $&out_fns)
    << c.cbind_hdr + ""
}

fn cb_has_prefix(s &string, pre &string) bool {
    if pre.len == 0 || s.len < pre.len { << false }
    for i in 0:pre.len {
        if s[i] != pre[i] { << false }
    }
    << true
}

fn (c $&Checker) cb_user_decl(p &parser.Parser, d int) bool {
    fid := c.decl_file_id(p, d)
    if fid < 0 || fid >= p.file_names.len { << true }
    name := p.file_names[fid] + ""
    << !cb_has_prefix(&name, &c.cbind_skip)
}

fn cb_ident(s &string) string {
    $out := ""
    for i in 0:s.len {
        ch := s[i]
        if (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95 {
            out = out + string_from_byte(ch)
        } else {
            out = out + "_"
        }
    }
    << out
}

fn cb_c_string(s &string) string {
    $out := "\""
    for i in 0:s.len {
        ch := s[i]
        if ch == 34 { out = out + "\\\"" }
        else if ch == 92 { out = out + "\\\\" }
        else if ch == 10 { out = out + "\\n" }
        else if ch == 13 { out = out + "\\r" }
        else if ch == 9 { out = out + "\\t" }
        else if ch < 32 || ch >= 127 {
            hex := "0123456789abcdef"
            out = out + "\\x" + string_from_byte(hex[ch / 16]) + string_from_byte(hex[ch % 16]) + "\"\""
        } else { out = out + string_from_byte(ch) }
    }
    << out + "\""
}

fn (c &Checker) cb_struct_name(si int) string {
    for i in 0:c.structs.len {
        if i != si && c.structs[i].name == c.structs[si].name && c.struct_is_repr_c(i) {
            << cb_ident(&c.structs[si].mod_id) + "_" + c.structs[si].name
        }
    }
    << c.structs[si].name + ""
}

fn cb_named(base string, name &string) string {
    if name.len == 0 { << base }
    if base.len > 0 && base[base.len - 1] == 42 { << base + *name }
    << base + " " + *name
}

fn (c &Checker) cb_scalar(t int) string {
    if t == 0 { << "void" }
    if t == 1 { << "int64_t" }
    if t == 2 { << "bool" }
    if t == 3 { << "const char *" }
    if t == 4 { << "double" }
    if t == 6 { << "void *" }
    if t == 7 { << "int8_t" }
    if t == 8 { << "int32_t" }
    if t == 9 { << "uint32_t" }
    if t == 10 { << "uint8_t" }
    if t == 11 { << "int16_t" }
    if t == 12 { << "uint16_t" }
    if t == 13 { << "uint64_t" }
    if t == 14 { << "float" }
    if is_struct_type(t) {
        si := struct_index(t)
        << c.cb_struct_name(si)
    }
    << "/* unsupported Xu type " + c.ty_display(t) + " */ void"
}

// C declaration of `name` with type t (`name` may be empty: abstract).
fn (c &Checker) cb_decl(t int, name string) string {
    if is_fn_type(t) {
        sig := fn_index(t)
        $ps := ""
        for i in 0:c.fn_sigs[sig].params.len {
            if i > 0 { ps = ps + ", " }
            ps = ps + c.cb_decl(c.fn_sigs[sig].params[i], "")
        }
        if ps.len == 0 { ps = "void" }
        << c.cb_decl(c.fn_sigs[sig].ret, "(*" + name + ")(" + ps + ")")
    }
    if is_array_type(t) {
        ai := array_index(t)
        if c.arrays[ai].fixed_len > 0 {
            << c.cb_decl(c.arrays[ai].elem_ty, name + "[" + str(c.arrays[ai].fixed_len) + "]")
        }
        << c.cb_decl(c.arrays[ai].elem_ty, "*" + name)
    }
    if is_ref_type(t) {
        inner := c.ref_inner_type(t)
        if inner == 3 { << cb_named("const char *", &name) }
        $pre := ""
        if !is_mut_ref_type(t) { pre = "const " }
        if is_array_type(inner) {
            el := c.arrays[array_index(inner)].elem_ty
            << pre + c.cb_decl(el, "*" + name)
        }
        << pre + c.cb_decl(inner, "*" + name)
    }
    << cb_named(c.cb_scalar(t), &name)
}

// Emit structs needed by type t (dependencies first) into order.
fn (c &Checker) cb_need_type(t int, order $&[]int, seen $&[]bool) {
    if is_struct_type(t) {
        si := struct_index(t)
        if si < 0 || si >= seen.len || seen[si] || !c.struct_is_repr_c(si) { << }
        seen[si] = true
        for j in 0:c.structs[si].fields.len {
            c.cb_need_type(c.structs[si].fields[j].ty, order, seen)
        }
        order.push(si)
        <<
    }
    if is_array_type(t) {
        c.cb_need_type(c.arrays[array_index(t)].elem_ty, order, seen)
        <<
    }
    if is_ref_type(t) {
        c.cb_need_type(c.ref_inner_type(t), order, seen)
        <<
    }
    if is_fn_type(t) {
        sig := fn_index(t)
        for i in 0:c.fn_sigs[sig].params.len {
            c.cb_need_type(c.fn_sigs[sig].params[i], order, seen)
        }
        c.cb_need_type(c.fn_sigs[sig].ret, order, seen)
    }
}

fn (c $&Checker) cb_extern_fns(p &parser.Parser) []int {
    $out := []int{}
    for fi in 0:c.fns.len {
        for k in 0:c.ffi_labels.len {
            if c.ffi_labels[k] == c.fns[fi].label && (c.ffi_flags[k] & FFI_EXTERN) != 0 && c.cb_user_decl(p, c.ffi_decls[k]) {
                out.push(fi)
                ->
            }
        }
    }
    << out
}

fn (c &Checker) cb_extern_decl(fi int) int {
    for k in 0:c.ffi_labels.len {
        if c.ffi_labels[k] == c.fns[fi].label { << c.ffi_decls[k] }
    }
    << -1
}

fn cb_link_libs(p &parser.Parser, f int) string {
    if f < 0 { << "" }
    meta := p.nodes[f].b
    if meta < 0 || meta >= p.nodes.len { << "" }
    $s := p.nodes[meta].sval + ""
    while s.len > 0 && s[s.len - 1] == 44 { s = s[0:s.len - 1] }
    << s
}

fn (c $&Checker) emit_cbind_header(p &parser.Parser) string {
    $o := "/* Generated by `xu cbind` for target " + cb_os_name(c.target_os) + "-" + cb_arch_name(c.target_arch) + ". Do not edit. */\n"
    o = o + "/* Layout assertions reflect the Xu checker's C layout for that target. */\n"
    $guard := c.cbind_guard + ""
    if guard.len == 0 { guard = "XU_CBIND_H" }
    o = o + "#ifndef " + guard + "\n#define " + guard + "\n\n"
    o = o + "#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n"
    o = o + "#ifdef __cplusplus\n#define XU_CBIND_ASSERT(c, m) static_assert(c, m)\n#define XU_CBIND_ALIGNOF(t) alignof(t)\nextern \"C\" {\n#else\n#define XU_CBIND_ASSERT(c, m) _Static_assert(c, m)\n#define XU_CBIND_ALIGNOF(t) _Alignof(t)\n#endif\n"
    // consts
    $consts := ""
    $seen_consts := strmap_with_cap(16)
    for i in 0:p.decls.len {
        d := p.decls[i]
        if d < 0 || p.nodes[d].kind != ast.NK_CONST || !c.cb_user_decl(p, d) { -> }
        lit := p.nodes[d].a
        if lit < 0 { -> }
        lk := p.nodes[lit].kind
        $nm := cb_ident(&p.nodes[d].sval)
        if strmap_get(&seen_consts, &nm) >= 0 {
            nm = cb_ident(&p.nodes[d].sval2) + "_" + nm
        }
        strmap_put($&seen_consts, nm + "", 1)
        if lk == ast.NK_INT {
            consts = consts + "#define " + nm + " INT64_C(" + str(p.nodes[lit].ival) + ")\n"
        } else if lk == ast.NK_BOOL {
            $bv := "false"
            if p.nodes[lit].ival != 0 { bv = "true" }
            consts = consts + "#define " + nm + " " + bv + "\n"
        } else if lk == ast.NK_STR {
            consts = consts + "#define " + nm + " " + cb_c_string(&p.nodes[lit].sval) + "\n"
        }
    }
    if consts.len > 0 { o = o + "\n/* consts */\n" + consts }
    // structs in dependency order
    $order := []int{}
    $seen := []bool{}
    for i in 0:c.structs.len { seen.push(false) }
    for i in 0:p.ffi_nodes.len {
        f := p.ffi_nodes[i]
        if (p.nodes[f].ival & ast.FFI_STRUCT) == 0 { -> }
        d := p.nodes[f].a
        if !c.cb_user_decl(p, d) { -> }
        si := c.find_struct_in_mod(p.nodes[d].sval + "", p.nodes[d].sval2 + "")
        if si >= 0 { c.cb_need_type(struct_type(si), $&order, $&seen) }
    }
    $gis := []int{}
    $seen_syms := strmap_with_cap(16)
    for gi in 0:c.globals.len {
        if c.cb_user_decl(p, c.globals[gi].decl) {
            $gsym := c.globals[gi].sym + ""
            if gsym.len == 0 { gsym = c.globals[gi].name + "" }
            if strmap_get(&seen_syms, &gsym) < 0 {
                strmap_put($&seen_syms, gsym, 1)
                gis.push(gi)
            }
            c.cb_need_type(c.globals[gi].ty, $&order, $&seen)
        }
    }
    fis := c.cb_extern_fns(p)
    for k in 0:fis.len {
        fi := fis[k]
        for j in 0:c.fns[fi].params.len { c.cb_need_type(c.fns[fi].params[j], $&order, $&seen) }
        c.cb_need_type(c.fns[fi].ret, $&order, $&seen)
    }
    for k in 0:order.len {
        si := order[k]
        st := &c.structs[si]
        name := c.cb_struct_name(si)
        $kw := "struct"
        if st.is_union { kw = "union" }
        o = o + "\ntypedef " + kw + " " + name + " {\n"
        for j in 0:st.fields.len {
            fld := &st.fields[j]
            $line := "    " + c.cb_decl(fld.ty, fld.name + "")
            if fld.bit_width > 0 { line = line + " : " + str(fld.bit_width) }
            o = o + line + ";\n"
        }
        o = o + "} " + name + ";\n"
        o = o + "XU_CBIND_ASSERT(sizeof(" + name + ") == " + str(st.size_bytes) + ", \"" + name + ": size\");\n"
        o = o + "XU_CBIND_ASSERT(XU_CBIND_ALIGNOF(" + name + ") == " + str(st.align_bytes) + ", \"" + name + ": alignment\");\n"
        for j in 0:st.fields.len {
            fld := &st.fields[j]
            if fld.bit_width > 0 { -> }
            o = o + "XU_CBIND_ASSERT(offsetof(" + name + ", " + fld.name + ") == " + str(fld.slot) + ", \"" + name + "." + fld.name + ": offset\");\n"
        }
    }
    // extern globals
    if gis.len > 0 { o = o + "\n/* extern \"C\" globals */\n" }
    for k in 0:gis.len {
        gi := gis[k]
        g := &c.globals[gi]
        $sym := g.sym + ""
        if sym.len == 0 { sym = g.name + "" }
        $note := ""
        $lib := g.lib + ""
        while lib.len > 0 && lib[lib.len - 1] == 44 { lib = lib[0:lib.len - 1] }
        if lib.len > 0 { note = " /* link: " + lib + " */" }
        o = o + "extern " + c.cb_decl(g.ty, sym) + ";" + note + "\n"
    }
    // extern fns
    $fn_syms := strmap_with_cap(16)
    $fn_lines := ""
    for k in 0:fis.len {
        fi := fis[k]
        d := c.cb_extern_decl(fi)
        f := ffi_node_of(p, d)
        $sym := c.fns[fi].name + ""
        if f >= 0 && p.nodes[f].sval.len > 0 { sym = p.nodes[f].sval + "" }
        if strmap_get(&fn_syms, &sym) >= 0 { -> }
        strmap_put($&fn_syms, sym + "", 1)
        $np := c.fns[fi].params.len
        variadic := c.fn_is_c_variadic(fi)
        if variadic && np > 0 { np -= 1 }
        $ps := ""
        for j in 0:np {
            if j > 0 { ps = ps + ", " }
            ps = ps + c.cb_decl(c.fns[fi].params[j], "")
        }
        if variadic {
            if np == 0 { ps = "/* C requires a named parameter */ ..." } else { ps = ps + ", ..." }
        }
        if ps.len == 0 { ps = "void" }
        libs := cb_link_libs(p, f)
        $note := ""
        if libs.len > 0 { note = " /* link: " + libs + " */" }
        fn_lines = fn_lines + c.cb_decl(c.fns[fi].ret, sym + "(" + ps + ")") + ";" + note + "\n"
    }
    if fn_lines.len > 0 { o = o + "\n/* extern \"C\" functions */\n" + fn_lines }
    o = o + "\n#ifdef __cplusplus\n}\n#endif\n\n#endif /* " + guard + " */\n"
    << o
}

fn cb_os_name(os int) string {
    if os == 0 { << "macos" }
    if os == 1 { << "linux" }
    if os == 2 { << "windows" }
    if os == 3 { << "none" }
    if os == 4 { << "wasi" }
    << "os" + str(os)
}

fn cb_arch_name(arch int) string {
    if arch == 0 { << "arm64" }
    if arch == 1 { << "x64" }
    if arch == 2 { << "thumb" }
    if arch == 3 { << "riscv32" }
    if arch == 4 { << "riscv64" }
    if arch == 5 { << "loongarch64" }
    if arch == 6 { << "xtensa" }
    if arch == 7 { << "wasm" }
    << "arch" + str(arch)
}
