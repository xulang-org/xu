@xu/types

#xu/ast
#xu/parser

// Spawn records are sized per call; the checker and MIR verifier share this cap.
const XU_MAX_ARGS = 15

fn (c &mut Checker) check_enum_match(p &parser.Parser, n int, sty int) {
    // MS-enum: consume the subject (owning enums are linear; Copy payloads
    // are a no-op via type_moves). Payload bindings then own those slots.
    c.move_of(p, p.nodes[n].a, sty, false)
    snap := c.as_join_snap()
    mut join_cons := []int{}
    ei := enum_index(sty)
    nvars := c.enums[ei].variants.len
    mut covered := []bool{}
    for i in 0:nvars {
        covered.push(false)
    }
    mut has_else := false
    mut ar := p.nodes[n].b
    while ar >= 0 {
    ak := p.nodes[ar].kind
    if ak == ast.NK_ARM_ELSE {
        if has_else {
            c.fail_node(p, ar, "duplicate else arm")
        }
        has_else = true
        c.as_join_restore(&snap)
        c.push_scope(2)
        mut s := p.nodes[ar].c
        mut term := false
        while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
        }
        c.pop_scope(p, true, term)
        c.as_join_after_arm(&snap, term, mut &join_cons)
    } else if ak == ast.NK_ARM_ENUM {
        // sval = "Enum.Variant"
        q := p.nodes[ar].sval
        mut ename := ""
        mut vname := ""
        mut dot := -1
        for i in 0:q.len {
            if q[i] == 46 { // '.'
                dot = i
            }
        }
        if dot < 0 {
            c.fail_node(p, ar, "malformed enum match pattern")
        }
        ename = q[0:dot]
        vname = q[dot + 1:q.len]
        mut name_matches := ename == c.enum_pattern_name(ei) || ename == c.enums[ei].name
        edot := last_dot(ename + "")
        if edot >= 0 {
            emod := c.enum_qualifier_module(ename + "")
            local_name := local_after_dot(ename + "", edot)
            name_matches = emod == c.enums[ei].mod_id && (local_name == c.enum_pattern_name(ei) || local_name == c.enums[ei].name)
            if name_matches {
                if !c.module_visible(emod + "") { c.fail_node(p, ar, "module " + emod + " not imported") }
            }
        }
        if !name_matches {
            c.fail_node(p, ar, "match pattern enum '" + ename + "' does not match subject type '" + c.enums[ei].name + "'")
        }
        // Subject inference also accepts short Enum.Variant patterns. Apply
        // privacy after either spelling resolves, so dropping a module
        // qualifier cannot expose a private enum's payload.
        if c.enums[ei].mod_id != c.cur_mod && !c.enums[ei].is_pub {
            c.fail_node(p, ar, "'" + c.enums[ei].name + "' is private")
        }
        mut vidx := -1
        for i in 0:nvars {
            if c.enums[ei].variants[i].name == vname {
                vidx = i
            }
        }
        if vidx < 0 {
            c.fail_node(p, ar, "enum '" + c.enums[ei].name + "' has no variant '" + vname + "'")
        }
        if covered[vidx] {
            c.fail_node(p, ar, "variant '" + c.enums[ei].name + "." + vname + "' is covered more than once")
        }
        covered[vidx] = true
        nfields := c.enums[ei].variants[vidx].fields.len
        mut nbind := 0
        mut b := p.nodes[ar].a
        while b >= 0 {
            nbind += 1
            b = p.nodes[b].next
        }
        if nbind != nfields {
            c.fail_node(p, ar, "variant '" + c.enums[ei].name + "." + vname + "' expects " + str(nfields) + " binding(s), found " + str(nbind))
        }
        // Record tag + enum type on the arm node for MIR (no AST mutate).
        checker_set_i(mut &c.nlocal, ar, vidx)
        checker_set_i(mut &c.ntype, ar, sty)
        c.as_join_restore(&snap)
        c.push_scope(2)
        b = p.nodes[ar].a
        mut fi := 0
        while b >= 0 {
            fty := c.enums[ei].variants[vidx].fields[fi]
            lid := c.add_local(p.nodes[b].sval, fty, false)
            checker_set_i(mut &c.nlocal, b, lid)
            checker_set_i(mut &c.ntype, b, fty)
            fi += 1
            b = p.nodes[b].next
        }
        mut s := p.nodes[ar].c
        mut term := false
        while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
        }
        c.pop_scope(p, true, term)
        c.as_join_after_arm(&snap, term, mut &join_cons)
    } else if ak == ast.NK_ARM_STR {
        c.fail_node(p, ar, "string pattern cannot match an enum subject")
    } else {
        c.fail_node(p, ar, "int pattern cannot match an enum subject")
    }
    ar = p.nodes[ar].next
    }
    c.as_join_finish(&snap, join_cons)
    if !has_else {
        mut missing := ""
        mut first := true
        for i in 0:nvars {
            if !covered[i] {
                if !first {
                    missing = missing + ", "
                }
                missing = missing + c.enums[ei].variants[i].name
                first = false
            }
        }
        if missing != "" {
            c.fail_node(p, p.nodes[n].a, "non-exhaustive match on enum '" + c.enums[ei].name + "': missing " + missing)
        }
    }
}

// MS9c: string match is `==` sugar. Strings are not exhaustive; else is required.
// Subject is not consumed (M108 Copy-via-clone; compare reads in place).
fn (c &mut Checker) check_string_match(p &parser.Parser, n int) {
    snap := c.as_join_snap()
    mut join_cons := []int{}
    mut has_else := false
    mut seen_else := false
    mut ar := p.nodes[n].b
    while ar >= 0 {
        if seen_else {
            c.fail_node(p, ar, "'else' must be the last match arm")
        }
        ak := p.nodes[ar].kind
        if ak == ast.NK_ARM_ELSE {
            has_else = true
            seen_else = true
        } else if ak == ast.NK_ARM_STR {
            si12 := c.intern(p.nodes[ar].sval)
            checker_set_i(mut &c.nstr, ar, si12)
        } else if ak == ast.NK_ARM_ENUM {
            c.fail_node(p, ar, "enum pattern cannot match a string subject")
        } else {
            c.fail_node(p, ar, "int pattern cannot match a string subject")
        }
        c.as_join_restore(&snap)
        c.push_scope(2)
        mut s := p.nodes[ar].c
        mut term := false
        while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
        }
        c.pop_scope(p, true, term)
        c.as_join_after_arm(&snap, term, mut &join_cons)
        ar = p.nodes[ar].next
    }
    c.as_join_finish(&snap, join_cons)
    if !has_else {
        c.fail_node(p, p.nodes[n].a, "string match requires an else arm")
    }
}

// M184: assignment checking — split from check_stmt (W3).
fn (c &mut Checker) check_assign_ident(p &parser.Parser, n int, t int, aop int) {
        id := c.find_local(p.nodes[t].sval)
        if id < 0 {
            if c.cap_active == 1 {
                for ci in 0:c.cap_names.len {
                    if c.cap_names[ci] == p.nodes[t].sval {
                        c.fail_node(p, t, "cannot assign to captured variable '" + p.nodes[t].sval + "' in a function literal")
                        <<
                    }
                }
            }
            if c.find_const(p.nodes[t].sval) >= 0 {
                c.fail_node(p, t, "cannot assign to const '" + p.nodes[t].sval + "'")
                <<
            }
            c.fail_node(p, t, "undefined name '" + p.nodes[t].sval + "'")
            <<
        }
        if is_write_once_box(c.ltype[id]) {
            c.fail_node(p, n, "dynamic temp/any value can only be written once (at initialization)")
        }
        if c.lmut[id] == 0 {
            c.fail_node(p, t, "cannot assign to immutable variable '" + p.nodes[t].sval + "'")
        }
        if is_ref_type(c.ltype[id]) && aop >= 2 {
            c.fail_node(p, n, "cannot use compound assignment on a reference")
        }
        c.rebind = id
        mut ty := c.check_expr(p, p.nodes[n].b)
        c.rebind = -1
        ty = c.coerce_to(p, p.nodes[n].b, ty, c.ltype[id])
        if !c.same_type(ty, c.ltype[id]) {
            c.fail_node(p, n, "type mismatch: expected " + c.ty_display(c.ltype[id]) + ", found " + c.ty_display(ty))
        }
        if aop >= 2 && compound_ty_ok(aop, ty) == 0 {
            c.fail_node(p, n, compound_ty_msg(aop, c.ltype[id], ty))
        }
        if (aop == 5 || aop == 6) && ty == 1 {
            // E2's dividend is the target's value BEFORE the rebind.
            tknown := c.lconst_ok[id] != 0
            tval := c.lconst[id]
            c.check_compound_div(p, n, tknown, tval, p.nodes[n].b)
        }
        c.move_err_n = n
        c.move_of(p, p.nodes[n].b, ty, false)
        c.move_err_n = -1
        checker_set_i(mut &c.lmoved, id, 0)
        if id >= 0 && id < c.lfcons.len {
            checker_set_i(mut &c.lfcons, id, 0)
        }
        c.lp_clear(id)
        // M36 v1: temp reassignment invalidates the tracked constant/length.
        checker_set_i(mut &c.lconst_ok, id, 0)
        checker_set_i(mut &c.llength_ok, id, 0)
        if aop == 1 && ty == 1 && c.expr_int_range_nonzero(p, p.nodes[n].b) {
            c.note_nonzero(id)
        } else if id >= 0 && id < c.lnz_ok.len {
            checker_set_i(mut &c.lnz_ok, id, 0)
        }
        // Wave 2: pure Ident copy aliases; compound / other rhs clears.
        rhs := p.nodes[n].b
        if aop == 1 && rhs >= 0 && p.nodes[rhs].kind == ast.NK_IDENT {
            si13 := c.nlocal[rhs]
            checker_set_i(mut &c.calias, id, si13)
        } else {
            checker_set_i(mut &c.calias, id, -1)
        }
        // M149: ref local rebind updates origin (elision / << checks).
        // Gen1 borrowck incorrectly keeps `mut &c.lorigin` from the then
        // arm live across `else if` (bootstrap does not). Use two `if`s.
        lty_rebind := c.ltype[id]
        if is_ref_type(lty_rebind) {
            si14 := c.expr_ref_origin(p, p.nodes[n].b)
            checker_set_i(mut &c.lorigin, id, si14)
        }
        if !is_ref_type(lty_rebind) && c.type_contains_ref(lty_rebind) {
            si15 := b2i(c.refs_flow_from_param(p, p.nodes[n].b, lty_rebind))
            checker_set_i(mut &c.lrefok, id, si15)
        }
        checker_set_i(mut &c.nlocal, t, id)
        <<
}

fn (c &mut Checker) check_assign_field(p &parser.Parser, n int, t int, aop int) {
        // Base: an Ident naming a mutable local, or a Field/Index chain
        // rooted in one (nested lvalue, mirror bootstrap MIR). Writes
        // through ref-typed intermediates are rejected — M10 tracks
        // ref locals only (reads through stored refs are fine).
        obj := p.nodes[t].a
        kobj := p.nodes[obj].kind
        if kobj != ast.NK_IDENT && kobj != ast.NK_FIELD && kobj != ast.NK_INDEX {
            c.fail_node(p, n, "field assignment base must be a variable (M6b2-s3c)")
            <<
        }
        oty := c.direct_type(c.check_expr(p, obj))
        root := c.borrow_root_local(p, obj)
        if root < 0 {
            c.fail_node(p, obj, "field assignment base must be a variable (M6b2-s3c)")
            <<
        }
        mut root_ref := false
        if is_mut_ref_type(c.ltype[root]) {
            // `&mut` receiver/local: nested field writes (`d.dc.t0 = …`)
            // take mutability from the root, matching bootstrap.
            root_ref = true
        }
        if is_ref_type(c.ntype[obj]) {
            // M161: bare &mut local, or one-level field-stored &mut (`h.r.v`).
            if kobj == ast.NK_IDENT {
                // ok
            } else if kobj == ast.NK_FIELD && is_mut_ref_type(c.ntype[obj]) {
                // ok — field-stored exclusive ref
            } else {
                c.fail_node(p, obj, "cannot assign through a reference stored in a field or element")
            }
            if !is_mut_ref_type(c.ntype[obj]) {
                c.fail_node(p, obj, "cannot assign through shared reference '" + c.lname[root] + "'")
            }
            root_ref = true // &mut carries the mutability itself
        }
        if !root_ref && c.lmut[root] == 0 {
            c.fail_node(p, obj, "cannot assign to field of immutable variable '" + c.lname[root] + "'")
        }
        if c.lmoved[root] != 0 {
            c.fail_node(p, obj, "use of moved value '" + c.lname[root] + "'")
        }
        if !is_struct_type(oty) {
            c.fail_node(p, obj, "field assignment on non-struct value")
            <<
        }
        si := struct_index(oty)
        fi := c.find_field(si, p.nodes[t].sval)
        if fi < 0 {
            c.fail_node(p, t, "struct has no field '" + p.nodes[t].sval + "'")
            <<
        }
        c.require_field_visible(p, t, si, fi)
        // M151: allow rebinding a ref-typed field (`h.r = mut &y`).
        // Compound ops stay illegal. Write-through of a stored ref is
        // still rejected above. Array elements cannot hold refs.
        fty_expect := c.structs[si].fields[fi].ty
        if is_ref_type(fty_expect) && aop != 1 {
            c.fail_node(p, n, "cannot use compound assignment on a reference")
        }
        mut fty := c.check_expr(p, p.nodes[n].b)
        fty = c.coerce_to(p, p.nodes[n].b, fty, fty_expect)
        if fty != fty_expect {
            c.fail_node(p, n, "type mismatch: expected " + c.ty_display(fty_expect) + ", found " + c.ty_display(fty))
        }
        if aop >= 2 && compound_ty_ok(aop, fty) == 0 {
            c.fail_node(p, n, compound_ty_msg(aop, fty_expect, fty))
        }
        if (aop == 5 || aop == 6) && fty == 1 {
            c.check_compound_div(p, n, false, 0, p.nodes[n].b)
        }
        c.move_of(p, p.nodes[n].b, fty, false)
        if root >= 0 && root < c.lfcons.len {
            bit := field_bit(fi)
            if bit != 0 {
                old := c.lfcons[root]
                checker_set_i(mut &c.lfcons, root, old - (old & bit))
            }
        }
        if kobj == ast.NK_IDENT {
            c.lp_clear_at(root, fi + 1)
        }
        if kobj == ast.NK_FIELD {
            pp := c.as_place_path(p, obj)
            if pp > 0 && fi >= 0 && fi < 63 {
                c.lp_clear_at(root, pp * 64 + (fi + 1))
            }
        }
        if is_ref_type(fty_expect) && !is_ref_type(c.ltype[root]) {
            // Conservative: drop M150 elision eligibility for the root.
            checker_set_i(mut &c.lrefok, root, 0)
        }
        checker_set_i(mut &c.nlocal, t, root) // root local id (mir branches on the node kind)
        checker_set_i(mut &c.nlocal, n, fi  ) // field index
        <<
}

fn (c &mut Checker) check_assign_index(p &parser.Parser, n int, t int, aop int) {
        raw_at := c.check_expr(p, p.nodes[t].a)
        at := c.direct_type(raw_at)
        mt := c.peel_map(raw_at)
        if mt >= 0 {
            if aop != 1 {
                c.fail_node(p, n, "compound assignment is not supported on map elements")
            }
            root := c.borrow_root_local(p, p.nodes[t].a)
            if root < 0 {
                c.fail_node(p, t, "assignment target must be an element of a variable")
                <<
            }
            if is_ref_type(c.ltype[root]) {
                if !is_mut_ref_type(c.ltype[root]) {
                    c.fail_node(p, t, "cannot assign through shared reference '" + c.lname[root] + "'")
                }
            } else if c.lmut[root] == 0 {
                c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.lname[root] + "'")
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, t, "use of moved value '" + c.lname[root] + "'")
            }
            kt := c.check_expr(p, p.nodes[t].b)
            wantk := c.maps[map_index(mt)].key_ty
            if kt != wantk {
                c.fail_node(p, p.nodes[t].b, "type mismatch: expected " + c.ty_display(wantk) + ", found " + c.ty_display(kt))
            }
            want := c.maps[map_index(mt)].val_ty
            mut vty := c.check_expr(p, p.nodes[n].b)
            vty = c.coerce_to(p, p.nodes[n].b, vty, want)
            if vty != want {
                c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.ty_display(want) + ", found " + c.ty_display(vty))
            }
            checker_set_i(mut &c.ncall, t, -78)
            checker_set_i(mut &c.ncall, n, -78)
            c.move_of(p, p.nodes[n].b, vty, false)
            checker_set_i(mut &c.ntype, t, want)
            <<
        }
        if c.is_maps_table(at) {
            if aop != 1 {
                c.fail_node(p, n, "compound assignment is not supported on map elements")
            }
            root := c.borrow_root_local(p, p.nodes[t].a)
            if root < 0 {
                c.fail_node(p, t, "assignment target must be an element of a variable")
                <<
            }
            if is_ref_type(c.ltype[root]) {
                if !is_mut_ref_type(c.ltype[root]) {
                    c.fail_node(p, t, "cannot assign through shared reference '" + c.lname[root] + "'")
                }
            } else if c.lmut[root] == 0 {
                c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.lname[root] + "'")
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, t, "use of moved value '" + c.lname[root] + "'")
            }
            kt := c.check_expr(p, p.nodes[t].b)
            if kt != 3 {
                c.fail_node(p, p.nodes[t].b, "map key type must be string")
            }
            want := c.maps_val_ty(at)
            mut vty := c.check_expr(p, p.nodes[n].b)
            vty = c.coerce_to(p, p.nodes[n].b, vty, want)
            if vty != want {
                c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.ty_display(want) + ", found " + c.ty_display(vty))
            }
            set_fi := c.find_method(at, "set")
            if set_fi < 0 {
                c.fail_node(p, n, "internal: maps.set missing")
            }
            checker_set_i(mut &c.ncall, t, set_fi)
            checker_set_i(mut &c.ncall, n, set_fi)
            c.move_of(p, p.nodes[n].b, vty, false)
            checker_set_i(mut &c.ntype, t, want)
            <<
        }
        if at == 3 {
            if aop != 1 {
                c.fail_node(p, n, "compound assignment is not supported on string bytes")
                <<
            }
            if is_ref_type(raw_at) {
                c.fail_node(p, t, "string index assignment requires an owned local")
                <<
            }
            root := c.borrow_root_local(p, p.nodes[t].a)
            if root < 0 || p.nodes[p.nodes[t].a].kind != ast.NK_IDENT {
                c.fail_node(p, t, "string index assignment requires a local")
                <<
            }
            if c.lmut[root] == 0 {
                c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.lname[root] + "'")
                <<
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, t, "use of moved value '" + c.lname[root] + "'")
                <<
            }
            if c.check_expr(p, p.nodes[t].b) != 1 {
                c.fail_node(p, p.nodes[t].b, "string index must be int")
                <<
            }
            mut vty := c.check_expr(p, p.nodes[n].b)
            vty = c.coerce_to(p, p.nodes[n].b, vty, 1)
            if vty != 1 {
                c.fail_node(p, p.nodes[n].b, "string byte assignment expects int")
                <<
            }
            checker_set_i(mut &c.ntype, t, 1)
            <<
        }
        if !is_array_type(at) {
            c.fail_node(p, t, "index assignment requires an array")
            <<
        }
        root := c.borrow_root_local(p, p.nodes[t].a)
        if root < 0 {
            c.fail_node(p, t, "assignment target must be an element of a variable")
            <<
        }
        if is_ref_type(c.ltype[root]) {
            if !is_mut_ref_type(c.ltype[root]) {
                c.fail_node(p, t, "cannot assign through shared reference '" + c.lname[root] + "'")
            }
        } else if c.lmut[root] == 0 {
            c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.lname[root] + "'")
        }
        if c.lmoved[root] != 0 {
            c.fail_node(p, t, "use of moved value '" + c.lname[root] + "'")
        }
        it := c.check_expr(p, p.nodes[t].b)
        if it != 1 { c.fail_node(p, p.nodes[t].b, "array index must be int") }
        ety := c.arrays[array_index(at)].elem_ty
        mut vty := c.check_expr(p, p.nodes[n].b)
        vty = c.coerce_to(p, p.nodes[n].b, vty, ety)
        if vty != ety {
            c.fail_node(p, p.nodes[n].b, "array element assignment type mismatch")
        }
        if aop >= 2 && compound_ty_ok(aop, ety) == 0 {
            if aop == 6 {
                c.fail_node(p, n, "compound assignment %= requires int array elements")
            } else {
                c.fail_node(p, n, "compound assignment requires int or f64 array elements")
            }
        }
        if (aop == 5 || aop == 6) && ety == 1 {
            c.check_compound_div(p, n, false, 0, p.nodes[n].b)
        }
        c.move_of(p, p.nodes[n].b, vty, false)
        if root >= 0 && root < c.lfcons.len {
            ei := c.as_const_index(p, p.nodes[t].b)
            bit := field_bit(ei)
            if bit != 0 {
                old := c.lfcons[root]
                checker_set_i(mut &c.lfcons, root, old - (old & bit))
            }
        }
        checker_set_i(mut &c.ntype, t, ety)
        <<
}

fn (c &mut Checker) check_assign_deref(p &parser.Parser, n int, t int, aop int) {
    if p.nodes[t].ival != 3 {
        c.fail_node(p, n, "assignment target not supported yet (M6b2-s3c: variable or field)")
        <<
    }
    inner := p.nodes[t].a
    rty := c.check_expr(p, inner)
    if !is_ref_type(rty) {
        c.fail_node(p, t, "cannot dereference non-reference type '" + c.ty_display(rty) + "'")
        <<
    }
    if !is_mut_ref_type(rty) {
        mut msg := "cannot assign through shared reference"
        if p.nodes[inner].kind == ast.NK_IDENT {
            msg = "cannot assign through shared reference '" + p.nodes[inner].sval + "'"
        }
        c.fail_node(p, t, msg)
    }
    pty := c.ref_inner_type(rty)
    if !deref_copy_ok(pty) {
        c.fail_node(p, t, "cannot dereference owning type '" + c.ty_display(pty) + "'")
    }
    mut vty := c.check_expr(p, p.nodes[n].b)
    vty = c.coerce_to(p, p.nodes[n].b, vty, pty)
    if vty != pty {
        c.fail_node(p, n, "type mismatch: expected " + c.ty_display(pty) + ", found " + c.ty_display(vty))
    }
    if aop >= 2 && compound_ty_ok(aop, vty) == 0 {
        c.fail_node(p, n, compound_ty_msg(aop, pty, vty))
    }
    if (aop == 5 || aop == 6) && vty == 1 {
        c.check_compound_div(p, n, false, 0, p.nodes[n].b)
    }
    c.move_of(p, p.nodes[n].b, vty, false)
    checker_set_i(mut &c.ntype, t, pty)
    <<
}

fn (c &mut Checker) check_stmt_assign(p &parser.Parser, n int) {
    t := p.nodes[n].a
    tk := p.nodes[t].kind
    aop := p.nodes[n].ival
    if tk == ast.NK_IDENT {
        c.check_assign_ident(p, n, t, aop)
        <<
    }
    if tk == ast.NK_FIELD {
        c.check_assign_field(p, n, t, aop)
        <<
    }
    if tk == ast.NK_INDEX {
        c.check_assign_index(p, n, t, aop)
        <<
    }
    if tk == ast.NK_UN_OP {
        c.check_assign_deref(p, n, t, aop)
        <<
    }
    c.fail_node(p, n, "assignment target not supported yet (M6b2-s3c: variable or field)")
}

fn (c &mut Checker) check_stmt_let(p &parser.Parser, n int) {
    ann := p.nodes[n].b
    saved_or := c.or_assign
    c.or_assign = p.nodes[n].sval
    mut ty := c.check_expr(p, p.nodes[n].a)
    c.or_assign = saved_or
    if is_error_type(ty) {
        id := c.add_local(p.nodes[n].sval, ERROR_TY, p.nodes[n].ival == 1)
        checker_set_i(mut &c.nlocal, n, id)
        <<
    }
    if ann >= 0 {
        if p.nodes[n].ival == 1 {
            c.fail_node(p, n, "typed `let` bindings cannot be `mut`")
        }
        want := c.type_of(p, ann)
        ty = c.coerce_to(p, p.nodes[n].a, ty, want)
        if !c.same_type(ty, want) {
            c.fail_node(p, n, "type mismatch: expected " + c.ty_display(want) + ", found " + c.ty_display(ty))
        }
    }
    if ty == 0 {
        c.fail_node(p, n, "cannot bind a void value")
    }
    if is_write_once_box(ty) && p.nodes[n].ival == 1 {
        c.fail_node(p, n, "dynamic temp/any bindings must be immutable (use `let`, not `mut`)")
    }
    c.move_err_n = n
    c.move_of(p, p.nodes[n].a, ty, false)
    c.move_err_n = -1
    id := c.add_local(p.nodes[n].sval, ty, p.nodes[n].ival == 1)
    // M10: ref bindings inherit the initializer's origin.
    // Gen1: avoid `else if c.method(...)` after `mut &c.*` in the then arm.
    if is_ref_type(ty) {
        si16 := c.expr_ref_origin(p, p.nodes[n].a)
        checker_set_i(mut &c.lorigin, id, si16)
        // MS6 C: track owner of `mut &e` for temp/struct@ as through the ref.
        init := p.nodes[n].a
        if p.nodes[init].kind == ast.NK_BORROW && p.nodes[init].ival == 1 {
            tgt := p.nodes[init].a
            if p.nodes[tgt].kind == ast.NK_IDENT {
                oid := c.nlocal[tgt]
                if oid >= 0 && is_as_box(c.ltype[oid]) {
                    checker_set_i(mut &c.laref, id, oid)
                }
            }
        }
    }
    if !is_ref_type(ty) && c.type_contains_ref(ty) {
        // M150: track struct locals whose refs all flow from the param.
        si17 := b2i(c.refs_flow_from_param(p, p.nodes[n].a, ty))
        checker_set_i(mut &c.lrefok, id, si17)
    }
    // M36 v1: track a single-assignment int constant for ANY binding
    // (mutable too — reassignment removes the entry); lengths only for
    // immutable bindings (mirror xuhir track_let).
    if ty == 1 && c.is_expr_int(p, p.nodes[n].a) {
        si18 := c.expr_int_value(p, p.nodes[n].a)
        checker_set_i(mut &c.lconst, id, si18)
        checker_set_i(mut &c.lconst_ok, id, 1)
    }
    if ty == 1 && c.expr_int_range_nonzero(p, p.nodes[n].a) {
        c.note_nonzero(id)
    }
    if p.nodes[n].ival != 1 {
        if is_array_type(ty) || ty == 3 {
            ln := c.known_len_of(p, p.nodes[n].a)
            if ln >= 0 {
                checker_set_i(mut &c.llength, id, ln)
                checker_set_i(mut &c.llength_ok, id, 1)
            } else {
                lb := c.known_len_lb_of(p, p.nodes[n].a)
                if lb >= 0 {
                    checker_set_i(mut &c.llength, id, lb)
                    checker_set_i(mut &c.llength_ok, id, 2)
                }
            }
        }
    }
    initn := p.nodes[n].a
    if initn >= 0 && p.nodes[initn].kind == ast.NK_IDENT {
        src := c.nlocal[initn]
        if src >= 0 {
            checker_set_i(mut &c.calias, id, src)
            if src < c.int_len_of.len && c.int_len_of[src] >= 0 {
                src_arr := c.int_len_of[src]
                checker_set_i(mut &c.int_len_of, id, src_arr)
            }
        }
    }
    alen := c.len_field_local(p, initn)
    if alen >= 0 {
        checker_set_i(mut &c.int_len_of, id, alen)
    }
    c.maybe_binsearch_mid(p, n, id)
    checker_set_i(mut &c.nlocal, n, id)
    <<
}

fn (c &mut Checker) check_stmt_return(p &parser.Parser, n int) {
    if p.nodes[n].a >= 0 {
        mut ty := c.check_expr(p, p.nodes[n].a)
        if is_error_type(ty) {
            <<
        }
        if c.cur_ret == 0 {
            c.fail_node(p, n, "return with a value in a void function")
        }
        ty = c.coerce_to(p, p.nodes[n].a, ty, c.cur_ret)
        if !c.same_type(ty, c.cur_ret) {
            c.fail_node(p, n, "type mismatch: expected " + c.ty_display(c.cur_ret) + ", found " + c.ty_display(ty))
        }
        // M10/M150/M156: ref << must flow from param; explicit lifetime match.
        if is_ref_type(c.cur_ret) {
            origin := c.expr_ref_origin(p, p.nodes[n].a)
            if origin < 0 {
                c.fail_node(p, n, "cannot return a reference to local data")
            }
            if c.cur_ret_life != "" {
                if origin >= c.llife.len || c.llife[origin] != c.cur_ret_life {
                    c.fail_node(p, n, "returned reference does not match lifetime '" + c.cur_ret_life + "'")
                }
            }
        }
        if !is_ref_type(c.cur_ret) && c.type_contains_ref(c.cur_ret) {
            if !c.refs_flow_from_param(p, p.nodes[n].a, c.cur_ret) {
                c.fail_node(p, n, "cannot return type containing references to local data")
            }
        }
        c.move_of(p, p.nodes[n].a, ty, true)
    } else {
        if c.cur_ret != 0 {
            c.fail_node(p, n, "missing return value")
        }
    }
    <<
}

fn (c &mut Checker) check_stmt_if_loops(p &parser.Parser, n int) {
    k := p.nodes[n].kind
    if k == ast.NK_IF { // If
        // MS6: snapshot moved flags of locals live at if-entry. Each arm
        // starts from that set; after join, temp linear-dynamic box consumed
        // via `as` on a fall-through arm is dead on all paths.
        snap := c.as_join_snap()
        mut join_cons := []int{}
        mut br := p.nodes[n].a
        while br >= 0 {
        c.as_join_restore(&snap)
        mut ub_lid := -1
        mut ub_had := false
        mut ub_prev := 0
        mut nz_then := -1
        mut nz_then_had := false
        if p.nodes[br].a >= 0 {
            ty := c.check_expr(p, p.nodes[br].a)
            if ty != 2 {
                c.fail_node(p, br, "type mismatch: expected bool, found " + c.ty_display(ty))
            }
            // MS6 A2: then-arm `if n <= 1` refines lub for the arm body.
            ub_lid = c.le_ub_local(p, p.nodes[br].a)
            if ub_lid >= 0 && ub_lid < c.lub_ok.len {
                ub_had = c.lub_ok[ub_lid] != 0
                ub_prev = c.lub[ub_lid]
                c.note_lub(ub_lid, c.le_ub_value(p, p.nodes[br].a))
            }
            nz_then = c.then_nonzero_local(p, p.nodes[br].a)
            if nz_then >= 0 && nz_then < c.lnz_ok.len {
                nz_then_had = c.lnz_ok[nz_then] != 0
                c.note_nonzero(nz_then)
            }
        }
        c.push_scope(2)
        mut s := p.nodes[br].b
        first := s
        while s >= 0 {
            c.check_stmt(p, s)
            s = p.nodes[s].next
        }
        term := stmts_always_exit(p, first)
        c.pop_scope(p, true, term)
        // M36 W2: single-arm guard → proven nonzero after exit.
        if p.nodes[br].next < 0 && term {
            cond := p.nodes[br].a
            if cond >= 0 {
                nz_lid := c.guard_zero_local(p, cond)
                if nz_lid >= 0 {
                    c.note_nonzero(nz_lid)
                }
                nz_recv := c.guard_zero_field_recv(p, cond)
                if nz_recv >= 0 {
                    nz_name := c.guard_zero_field_name(p, cond)
                    if nz_name.len > 0 {
                        c.note_field_nonzero(nz_recv, nz_name)
                    }
                }
            }
        }
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            if ub_had {
                checker_set_i(mut &c.lub, ub_lid, ub_prev)
                checker_set_i(mut &c.lub_ok, ub_lid, 1)
            } else {
                checker_set_i(mut &c.lub_ok, ub_lid, 0)
            }
        }
        if nz_then >= 0 && nz_then < c.lnz_ok.len {
            if !nz_then_had {
                checker_set_i(mut &c.lnz_ok, nz_then, 0)
            }
        }
        c.as_join_after_arm(&snap, term, mut &join_cons)
        br = p.nodes[br].next
        }
        c.as_join_finish(&snap, join_cons)
        <<
    }
    if k == ast.NK_FOR { // For
        t1 := c.check_expr(p, p.nodes[n].a)
        t2 := c.check_expr(p, p.nodes[n].b)
        if t1 != 1 || t2 != 1 {
            c.fail_node(p, n, "for range bounds must be int")
        }
        c.loop_as_enter()
        c.push_scope(2)
        id := c.add_local(p.nodes[n].sval, 1, false)
        checker_set_i(mut &c.nlocal, n, id)
        // M175: resolve nlocal on range exprs before body (needed for len_field_local).
        pushed := c.try_induct_for(p, n, id)
        c.kill_lconst_written(p, p.nodes[n].c)
        mut ub_lid := -1
        mut ub_had := false
        mut ub_prev := 0
        fub := c.for_range_var_ub(p, n)
        if fub >= 0 && id >= 0 && id < c.lub_ok.len {
            ub_lid = id
            ub_had = c.lub_ok[id] != 0
            ub_prev = c.lub[id]
            c.note_lub(id, fub)
        }
        c.loop_depth += 1
        mut s := p.nodes[n].c
        mut term := false
        while s >= 0 {
        c.check_stmt(p, s)
        term = stmt_always_exit(p, s)
        s = p.nodes[s].next
        }
        c.loop_depth -= 1
        if pushed == 1 { c.induct_pop() }
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            if ub_had {
                checker_set_i(mut &c.lub, ub_lid, ub_prev)
                checker_set_i(mut &c.lub_ok, ub_lid, 1)
            } else {
                checker_set_i(mut &c.lub_ok, ub_lid, 0)
            }
        }
        if !term {
            c.loop_as_union(false)
        }
        c.pop_scope(p, true, term)
        c.loop_as_finish(p, n)
        <<
    }
    if k == ast.NK_FOR_EACH { // ForEach
        raw_at := c.check_expr(p, p.nodes[n].a)
        at := c.direct_type(raw_at)
        mt := c.peel_map(raw_at)
        if mt >= 0 {
            if p.nodes[n].sval2.len == 0 {
                c.fail_node(p, n, "map for-in requires two variables: for k, v in m")
            }
            kty := c.maps[map_index(mt)].key_ty
            vty := c.maps[map_index(mt)].val_ty
            if c.type_owning(vty) && vty != 3 {
                c.fail_node(p, n, "cannot iterate a map of non-string owning values; use take or an index loop")
            }
            checker_set_i(mut &c.ntype, n, vty)
            checker_set_i(mut &c.ncall, n, -91)
            c.loop_as_enter()
            c.push_scope(2)
            kid := c.add_local(p.nodes[n].sval, kty, false)
            vid := c.add_local(p.nodes[n].sval2, vty, false)
            checker_set_i(mut &c.nlocal, n, kid)
            checker_set_i(mut &c.nconst, n, vid)
            c.kill_lconst_written(p, p.nodes[n].c)
            c.loop_depth += 1
            mut s := p.nodes[n].c
            mut term := false
            while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
            }
            c.loop_depth -= 1
            if !term {
                c.loop_as_union(false)
            }
            c.pop_scope(p, true, term)
            c.loop_as_finish(p, n)
            <<
        }
        if p.nodes[n].sval2.len > 0 {
            c.fail_node(p, n, "for-in with two variables requires a map")
        }
        mut ety := 0
        mut view := false
        if is_array_type(at) {
            ai := array_index(at)
            ety = c.arrays[ai].elem_ty
            if c.type_owning(ety) && ety != 3 {
                if is_struct_type(ety) {
                    root := c.borrow_root_local(p, p.nodes[n].a)
                    if root < 0 {
                        c.fail_node(p, n, "cannot iterate an array of owning structs unless it is a local variable")
                    }
                    if c.place_has_index(p, p.nodes[n].a) {
                        c.fail_node(p, n, "cannot iterate a nested array of owning structs; use an index loop")
                    }
                    view = true
                } else {
                    c.fail_node(p, n, "cannot iterate an array of non-string owning values; use an index loop")
                }
            }
        } else if is_chan_type(at) {
            if c.in_irq == 1 {
                c.fail_node(p, n, "cannot use channels in irq handler")
            }
            ety = c.chans[chan_index(at)].elem_ty
        } else {
            c.fail_node(p, p.nodes[n].a, "for-in requires an array or channel, found " + c.ty_display(at))
        }
        checker_set_i(mut &c.ntype, n, ety)
        c.loop_as_enter()
        c.push_scope(2)
        id := c.add_local(p.nodes[n].sval, ety, false)
        if view {
            checker_set_i(mut &c.lview, id, 1)
        }
        checker_set_i(mut &c.nlocal, n, id)
        c.kill_lconst_written(p, p.nodes[n].c)
        c.loop_depth += 1
        mut s := p.nodes[n].c
        mut term := false
        while s >= 0 {
        c.check_stmt(p, s)
        term = stmt_always_exit(p, s)
        s = p.nodes[s].next
        }
        c.loop_depth -= 1
        if !term {
            c.loop_as_union(false)
        }
        c.pop_scope(p, true, term)
        c.loop_as_finish(p, n)
        <<
    }
    if k == ast.NK_WHILE { // While
        ty := c.check_expr(p, p.nodes[n].a)
        if ty != 2 {
            c.fail_node(p, n, "type mismatch: expected bool, found " + c.ty_display(ty))
        }
        pushed := c.try_induct_while(p, n)
        c.cur_while = n
        c.bs_ok = 0
        cn0 := p.nodes[n].a
        if cn0 >= 0 && p.nodes[cn0].kind == ast.NK_BIN_OP && p.nodes[cn0].ival == 8 {
            lol := c.ident_local(p, p.nodes[cn0].a)
            if lol >= 0 && lol < c.lconst_ok.len {
                if c.lconst_ok[lol] != 0 && c.lconst[lol] == 0 {
                    c.bs_ok = 1
                }
            }
        }
        nind := c.induct_var.len
        // Refine lub for the body from `i < K` / `i <= K` (same as if-arms).
        // Apply AFTER kill_lconst_written — that helper also clears lub on
        // written names (the loop counter), which would undo note_lub.
        mut ub_lid := -1
        mut ub_had := false
        mut ub_prev := 0
        ub_lid = c.le_ub_local(p, p.nodes[n].a)
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            ub_had = c.lub_ok[ub_lid] != 0
            ub_prev = c.lub[ub_lid]
        }
        mut t_zero := 0
        cond0 := p.nodes[n].a
        if cond0 >= 0 && p.nodes[cond0].kind == ast.NK_BIN_OP && p.nodes[cond0].ival == 8 {
            lh := p.nodes[cond0].a
            if lh >= 0 && p.nodes[lh].kind == ast.NK_IDENT {
                tl := c.nlocal[lh]
                if tl >= 0 && tl < c.lconst_ok.len {
                    if c.lconst_ok[tl] != 0 && c.lconst[tl] == 0 {
                        t_zero = 1
                    }
                }
            }
        }
        c.kill_lconst_written(p, p.nodes[n].c)
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            c.note_lub(ub_lid, c.le_ub_value(p, p.nodes[n].a))
        }
        // Lengths before the body: its pushes reset them while checking.
        mut len0 := []int{}
        mut len0_ok := []int{}
        if t_zero == 1 {
            copy_ints(mut &len0, &c.llength)
            copy_ints(mut &len0_ok, &c.llength_ok)
        }
        c.loop_as_enter()
        c.push_scope(2)
        c.loop_depth += 1
        mut s := p.nodes[n].c
        mut term := false
        while s >= 0 {
        c.check_stmt(p, s)
        term = stmt_always_exit(p, s)
        s = p.nodes[s].next
        }
        c.loop_depth -= 1
        c.cur_while = 0 - 1
        while c.induct_var.len > nind {
            c.induct_pop()
        }
        if pushed == 1 { c.induct_pop() }
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            if ub_had {
                checker_set_i(mut &c.lub, ub_lid, ub_prev)
                checker_set_i(mut &c.lub_ok, ub_lid, 1)
            } else {
                checker_set_i(mut &c.lub_ok, ub_lid, 0)
            }
        }
        if !term {
            c.loop_as_union(false)
        }
        c.pop_scope(p, true, term)
        c.loop_as_finish(p, n)
        c.try_note_fill_len(p, n, t_zero, &len0, &len0_ok)
        <<
    }
    if k == ast.NK_BREAK { // Break
        if c.loop_depth <= 0 {
            c.fail_node(p, n, "'<-' is only allowed inside a for or while loop")
        }
        c.loop_as_union(true)
        <<
    }
    if k == ast.NK_CONTINUE { // Continue
        if c.loop_depth <= 0 {
            c.fail_node(p, n, "'->' is only allowed inside a for or while loop")
        }
        c.loop_as_union(false)
        <<
    }
}

// Wave C: match stmt — split from check_stmt_match_select_xu (W3).
fn (c &mut Checker) check_stmt_match(p &parser.Parser, n int) {
 // Match
        sty := c.check_expr(p, p.nodes[n].a)
        if sty == 1 {
            c.push_scope(0)
            c.add_local("_match", sty, false)
            snap := c.as_join_snap()
            mut join_cons := []int{}
            mut ar := p.nodes[n].b
            mut seen_else := false
            while ar >= 0 {
            if p.nodes[ar].kind == ast.NK_ARM_ELSE {
                if seen_else {
                    c.fail_node(p, ar, "duplicate else arm")
                }
                seen_else = true
            } else if p.nodes[ar].kind == ast.NK_ARM_ENUM {
                c.fail_node(p, ar, "enum pattern cannot match an int subject")
            } else if p.nodes[ar].kind == ast.NK_ARM_STR {
                c.fail_node(p, ar, "string pattern cannot match an int subject")
            } else if p.nodes[ar].kind == ast.NK_ARM_RANGE {
                lo := p.nodes[ar].ival
                hi := p.nodes[ar].d
                rk := range_ival_from_str(p.nodes[ar].sval2)
                // Empty patterns are decided on the raw endpoints so `hi-1`
                // cannot overflow at INT_MIN / INT_MAX.
                //   : / -<  [lo,hi)  empty iff lo >= hi
                //   --      [lo,hi]  empty iff lo >  hi
                //   >-      (lo,hi]  empty iff lo >= hi
                //   >-<     (lo,hi)  empty iff lo + 1 >= hi
                mut empty := false
                if rk == 0 || rk == 1 || rk == 5 || rk == 2 {
                    // half-open / open-start: empty iff lo >= hi
                    empty = lo >= hi
                } else if rk == 4 {
                    empty = lo > hi
                } else {
                    // >-< open-open: empty iff no integer in (lo, hi)
                    if lo >= hi {
                        empty = true
                    } else if lo == 9223372036854775807 {
                        empty = true
                    } else {
                        empty = lo + 1 >= hi
                    }
                }
                if empty {
                    c.fail_node(p, ar, "match range " + match_range_display(p.nodes[ar].ival, p.nodes[ar].d, p.nodes[ar].sval2) + " is empty")
                }
            }
            c.as_join_restore(&snap)
            c.push_scope(2)
            mut s := p.nodes[ar].c
            mut term := false
            while s >= 0 {
                c.check_stmt(p, s)
                term = stmt_always_exit(p, s)
                s = p.nodes[s].next
            }
            c.pop_scope(p, true, term)
            c.as_join_after_arm(&snap, term, mut &join_cons)
            ar = p.nodes[ar].next
            }
            c.pop_scope(p, false, false)
            c.as_join_finish(&snap, join_cons)
            <<
        }
        if sty == 3 {
            c.check_string_match(p, n)
            <<
        }
        if is_enum_type(sty) {
            c.check_enum_match(p, n, sty)
            <<
        }
        c.fail_node(p, p.nodes[n].a, "match subject must be int, enum, or string, found " + c.ty_display(sty))
        <<
}

// Wave C: xu stmt — split from check_stmt_match_select_xu (W3).
fn (c &mut Checker) check_stmt_xu(p &parser.Parser, n int) {
 // Xu (M17)
        call := p.nodes[n].a
        if p.nodes[call].kind != ast.NK_CALL {
            c.fail_node(p, n, "xu requires a function call (xu f(args))")
        }
        // Clone name: find_fn takes by value (move).
        name := p.nodes[call].sval
        mut fi := c.find_fn(name)
        if fi < 0 {
            c.fail_node(p, n, "undefined function '" + p.nodes[call].sval + "' in xu")
        }
        mut argc := 0
        mut arg := p.nodes[call].a
        mut arg_nodes := []int{}
        mut arg_tys := []int{}
        while arg >= 0 {
            aty := c.check_expr(p, arg)
            // M155 Send: refs / capturing fn Env / nested containers.
            if !c.type_is_send(aty) {
                c.fail_node(p, arg, "xu argument cannot be a reference type (M17)")
            }
            arg_nodes.push(arg)
            arg_tys.push(aty)
            argc = argc + 1
            arg = p.nodes[arg].next
        }
        if argc != c.fns[fi].params.len {
            c.fail_node(p, n, "function '" + p.nodes[call].sval + "' expects " + str(c.fns[fi].params.len) + " argument(s), found " + str(argc))
        }
        if argc > XU_MAX_ARGS {
            c.fail_node(p, n, "xu supports at most " + str(XU_MAX_ARGS) + " arguments (M17)")
        }
        if c.fns[fi].is_template {
            d := c.fndecl[fi]
            mut ntp := 0
            mut tp := p.nodes[d].e
            while tp >= 0 {
                if !c.fn_has_lt(fi, p.nodes[tp].sval) {
                    ntp += 1
                }
                tp = p.nodes[tp].next
            }
            c.uni_bind = []int{}
            for k3 in 0:ntp {
                c.uni_bind.push(-1)
            }
            for i in 0:c.fns[fi].params.len {
                if !c.unify(c.fns[fi].params[i], arg_tys[i]) {
                    c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.ty_display(c.fns[fi].params[i]) + ", found " + c.ty_display(arg_tys[i]))
                }
            }
            tp = p.nodes[d].e
            for k3 in 0:ntp {
                while tp >= 0 && c.fn_has_lt(fi, p.nodes[tp].sval) {
                    tp = p.nodes[tp].next
                }
                if c.uni_bind[k3] < 0 {
                    c.fail_node(p, n, "cannot infer type parameter '" + p.nodes[tp].sval + "' for function '" + p.nodes[call].sval + "'")
                }
                tp = p.nodes[tp].next
            }
            c.load_targs_uni(ntp)
            fi = c.instantiate_fn_n(p, fi, n)
            if fi < 0 { << }
        } else {
            for i in 0:arg_tys.len {
                if !c.same_type(arg_tys[i], c.fns[fi].params[i]) {
                    c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.ty_display(c.fns[fi].params[i]) + ", found " + c.ty_display(arg_tys[i]))
                }
            }
        }
        for i in 0:arg_nodes.len {
            c.move_of(p, arg_nodes[i], arg_tys[i], false)
        }
        checker_set_i(mut &c.ncall, n, fi)
        c.record_call(fi)
        <<
}

// Wave C: send stmt — split from check_stmt_match_select_xu (W3).
fn (c &mut Checker) check_stmt_send(p &parser.Parser, n int) {
 // Send ch <- v (M17)
        if c.in_irq == 1 {
            c.fail_node(p, n, "cannot use channels in irq handler")
        }
        cty := c.check_expr(p, p.nodes[n].a)
        if !is_chan_type(cty) {
            c.fail_node(p, n, "send requires a channel, found " + c.ty_display(cty))
        }
        ci := chan_index(cty)
        elem := c.chans[ci].elem_ty
        vty := c.check_expr(p, p.nodes[n].b)
        if !c.same_type(vty, elem) {
            c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.ty_display(elem) + ", found " + c.ty_display(vty))
        }
        if !c.type_is_send(vty) {
            c.fail_node(p, p.nodes[n].b, "channel element type cannot be a reference")
        }
        c.move_of(p, p.nodes[n].b, vty, false)
        checker_set_i(mut &c.nlocal, n, ci) // chan id for mir
        <<
}

// Wave C: select stmt — split from check_stmt_match_select_xu (W3).
fn (c &mut Checker) check_stmt_select(p &parser.Parser, n int) {
 // Select
        if c.in_irq == 1 {
            c.fail_node(p, n, "cannot use channels in irq handler")
        }
        if p.nodes[n].a < 0 {
            c.fail_node(p, n, "select requires at least one send/recv case")
        }
        snap := c.as_join_snap()
        mut join_cons := []int{}
        mut ar := p.nodes[n].a
        while ar >= 0 {
        ak := p.nodes[ar].kind
        if ak == ast.NK_SEL_SEND { // SelSend
                cty := c.check_expr(p, p.nodes[ar].a)
                if !is_chan_type(cty) {
                    c.fail_node(p, ar, "send requires a channel, found " + c.ty_display(cty))
                }
                ci := chan_index(cty)
                elem := c.chans[ci].elem_ty
                vty := c.check_expr(p, p.nodes[ar].b)
                if !c.same_type(vty, elem) {
                    c.fail_node(p, p.nodes[ar].b, "type mismatch: expected " + c.ty_display(elem) + ", found " + c.ty_display(vty))
                }
                if !c.type_is_send(vty) {
                    c.fail_node(p, p.nodes[ar].b, "channel element type cannot be a reference")
                }
                if c.type_owning(vty) {
                    if vty != 3 {
                        c.fail_node(p, p.nodes[ar].b, "select send of owning non-string is not supported")
                    }
                    c.nclone[p.nodes[ar].b] = 1
                }
                checker_set_i(mut &c.nlocal, ar, ci)
                c.as_join_restore(&snap)
                c.push_scope(2)
                mut s := p.nodes[ar].c
                mut term := false
                while s >= 0 {
                    c.check_stmt(p, s)
                    term = stmt_always_exit(p, s)
                    s = p.nodes[s].next
                }
                c.pop_scope(p, true, term)
                c.as_join_after_arm(&snap, term, mut &join_cons)
            } else if ak == ast.NK_SEL_RECV { // SelRecv
                cty := c.check_expr(p, p.nodes[ar].a)
                if !is_chan_type(cty) {
                    c.fail_node(p, ar, "receive requires a channel, found " + c.ty_display(cty))
                }
                ci := chan_index(cty)
                elem := c.chans[ci].elem_ty
                c.as_join_restore(&snap)
                c.push_scope(2)
                id := c.add_local(p.nodes[ar].sval, elem, false)
                checker_set_i(mut &c.nlocal, ar, id)
                mut s := p.nodes[ar].c
                mut term := false
                while s >= 0 {
                    c.check_stmt(p, s)
                    term = stmt_always_exit(p, s)
                    s = p.nodes[s].next
                }
                c.pop_scope(p, true, term)
                c.as_join_after_arm(&snap, term, mut &join_cons)
            } else {
            c.fail_node(p, ar, "malformed select arm")
        }
        ar = p.nodes[ar].next
        }
        if p.nodes[n].ival == 1 || p.nodes[n].c >= 0 {
            c.as_join_restore(&snap)
            c.push_scope(2)
            mut s := p.nodes[n].c
            mut term := false
            while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
            }
            c.pop_scope(p, true, term)
            c.as_join_after_arm(&snap, term, mut &join_cons)
        }
        c.as_join_finish(&snap, join_cons)
        <<
}

// Wave C: thin dispatcher over match/xu/send/select — split check_stmt_match_select_xu (W3).
fn (c &mut Checker) check_stmt_match_select_xu(p &parser.Parser, n int) {
    k := p.nodes[n].kind
    if k == ast.NK_MATCH { // Match
        c.check_stmt_match(p, n)
        <<
    }
    if k == ast.NK_XU { // Xu (M17)
        c.check_stmt_xu(p, n)
        <<
    }
    if k == ast.NK_SEND { // Send ch <- v (M17)
        c.check_stmt_send(p, n)
        <<
    }
    if k == ast.NK_SELECT { // Select
        c.check_stmt_select(p, n)
        <<
    }
}

fn (c &mut Checker) check_stmt(p &parser.Parser, n int) {
    if c.fn_failed() {
        <<
    }
    k := p.nodes[n].kind
    if k == ast.NK_LET { // Let
        c.check_stmt_let(p, n)
        <<
    }
    if k == ast.NK_ASSIGN { // Assign
        c.check_stmt_assign(p, n)
        <<
    }
    if k == ast.NK_EXPR_STMT { // ExprStmt
        ec := p.nodes[n].a
        ety := c.check_expr(p, ec)
        if is_throw_type(ety) {
            c.fail_node(p, ec, "throwing call must be handled (use `or (err) { }`)")
        }
        <<
    }
    if k == ast.NK_THROW { // Throw
        if !is_throw_type(c.cur_throw_ty) {
            c.fail_node(p, n, "`>>` is only allowed in functions that may propagate errors")
        }
        c.check_throw_value(p, p.nodes[n].a)
        si19 := c.cur_throw_ty
        checker_set_i(mut &c.ntype, n, si19)
        <<
    }
    if k == ast.NK_EXIT { // Exit <<<
        arg := p.nodes[n].a
        if arg < 0 {
            c.fail_node(p, n, "`<<<` requires an int exit code")
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, "<<< expects int")
        }
        checker_set_i(mut &c.ncall, n, -13)
        checker_set_i(mut &c.ntype, n, 0)
        <<
    }
    if k == ast.NK_RETURN { // Return
        c.check_stmt_return(p, n)
        <<
    }
    if k == ast.NK_IF || k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE || k == ast.NK_BREAK || k == ast.NK_CONTINUE { // If / loops
        c.check_stmt_if_loops(p, n)
        <<
    }
    if k == ast.NK_MATCH || k == ast.NK_XU || k == ast.NK_SEND || k == ast.NK_SELECT { // Match / Xu / Send / Select
        c.check_stmt_match_select_xu(p, n)
        <<
    }
    c.fail_node(p, n, "statement not supported yet (M6b2-s3a)")
}

