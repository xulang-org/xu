@xu/types

#xu/ast
#xu/parser

// Expression kinds produced by the parser. The borrow walkers reject anything
// else so a new kind cannot silently bypass borrow analysis.
fn expr_kind_known(k int) bool {
    << (k >= ast.NK_INT && k <= ast.NK_CAST) || k == ast.NK_CHAN_INIT || k == ast.NK_RECV || k == ast.NK_UNWRAP || (k >= ast.NT_FN_LIT && k <= ast.NK_TYPE_AS) || (k >= ast.NK_THROW && k <= ast.NK_EXIT) || k == ast.NK_MAP_INIT
}

// Direct sub-expressions of expression node n, per parser layout. Type slots
// (cast target, chan/map/empty-array element types, FnLit params/ret) are not
// expressions and are omitted; or-catch fallback blocks and FnLit
// captures carry statement/capture semantics and are handled by each walker.
fn expr_kids(p &parser.Parser, n int) []int {
    mut out := []int{}
    if n < 0 { << out }
    k := p.nodes[n].kind
    if k == ast.NK_CALL || k == ast.NK_ARRAY_LIT {
        mut a := p.nodes[n].a
        while a >= 0 {
            out.push(a)
            a = p.nodes[a].next
        }
    } else if k == ast.NK_STRUCT_INIT {
        mut sf := p.nodes[n].a
        while sf >= 0 {
            out.push(p.nodes[sf].a)
            sf = p.nodes[sf].next
        }
    } else if k == ast.NK_METHOD_CALL {
        out.push(p.nodes[n].a)
        mut a := p.nodes[n].b
        while a >= 0 {
            out.push(a)
            a = p.nodes[a].next
        }
    } else if k == ast.NK_INDEX || k == ast.NK_BIN_OP {
        out.push(p.nodes[n].a)
        out.push(p.nodes[n].b)
    } else if k == ast.NK_SLICE {
        out.push(p.nodes[n].a)
        out.push(p.nodes[n].b)
        out.push(p.nodes[n].c)
    } else if k == ast.NK_CHAN_INIT {
        out.push(p.nodes[n].b)
    } else if k == ast.NK_FIELD || k == ast.NK_TRY || k == ast.NK_BORROW || k == ast.NK_UN_OP || k == ast.NK_S_FIELD || k == ast.NK_CAST || k == ast.NK_RECV || k == ast.NK_UNWRAP || k == ast.NK_TYPE_IS || k == ast.NK_TYPE_AS || k == ast.NK_THROW || k == ast.NK_OR_CATCH || k == ast.NK_EXIT {
        out.push(p.nodes[n].a)
    }
    << out
}

// Outer locals captured directly by FnLit n (env-field repacks excluded).
fn (c &Checker) fn_lit_captures(n int) []int {
    mut out := []int{}
    fid := c.ncall[n]
    if fid < 0 || fid >= c.clos_caps.len { << out }
    for i in 0:c.clos_caps[fid].len {
        id := c.clos_caps[fid][i]
        if id >= 0 && id < c.ltype.len { out.push(id) }
    }
    << out
}

// Error fallbacks contain real statements and borrow events. Number them
// with the surrounding expression so last-use analysis cannot skip a close.
fn (c &mut Checker) borrow_number_expr(p &parser.Parser, n int) {
    if n < 0 { << }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        c.borrow_number_expr(p, kids[i])
    }
    if p.nodes[n].kind == ast.NK_OR_CATCH {
        c.borrow_number_block(p, p.nodes[n].c)
    }
}

fn (c &mut Checker) borrow_number_block(p &parser.Parser, head int) {
    mut s := head
    while s >= 0 {
        seq := c.bseq
        checker_set_i(mut &c.bstmt, s, seq)
        c.bseq = seq + 1
        k := p.nodes[s].kind
        if k == ast.NK_LET || k == ast.NK_ASSIGN || k == ast.NK_EXPR_STMT || k == ast.NK_RETURN || k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_MATCH || k == ast.NK_WHILE || k == ast.NK_XU || k == ast.NK_SEND || k == ast.NK_THROW || k == ast.NK_EXIT {
            c.borrow_number_expr(p, p.nodes[s].a)
            if k == ast.NK_ASSIGN || k == ast.NK_FOR || k == ast.NK_SEND { c.borrow_number_expr(p, p.nodes[s].b) }
        }
        if k == ast.NK_IF {
            mut br := p.nodes[s].a
            while br >= 0 {
                c.borrow_number_expr(p, p.nodes[br].a)
                c.borrow_number_block(p, p.nodes[br].b)
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
            c.borrow_number_block(p, p.nodes[s].c)
        }
        if k == ast.NK_MATCH {
            mut ar := p.nodes[s].b
            while ar >= 0 {
                c.borrow_number_expr(p, p.nodes[ar].a)
                c.borrow_number_expr(p, p.nodes[ar].b)
                c.borrow_number_block(p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_SELECT {
            mut ar := p.nodes[s].a
            while ar >= 0 {
                c.borrow_number_block(p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                c.borrow_number_block(p, p.nodes[s].c)
            }
        }
        s = p.nodes[s].next
    }
}

fn max_bstmt(a int, b int) int { if a > b { << a }
    << b }

fn (c &Checker) last_bexpr(p &parser.Parser, n int) int {
    mut last := -1
    if n < 0 { << -1 }
    if p.nodes[n].kind == ast.NK_OR_CATCH {
        last = c.last_bstmt(p, p.nodes[n].c)
    }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        last = max_bstmt(last, c.last_bexpr(p, kids[i]))
    }
    << last
}

// max bstmt in a preorder-numbered block (same kinds as borrow_number_block).
fn (c &Checker) last_bstmt(p &parser.Parser, head int) int {
    mut last := -1
    mut s := head
    while s >= 0 {
        if s < c.bstmt.len && c.bstmt[s] > last {
            last = c.bstmt[s]
        }
        k := p.nodes[s].kind
        if k == ast.NK_LET || k == ast.NK_ASSIGN || k == ast.NK_EXPR_STMT || k == ast.NK_RETURN || k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_MATCH || k == ast.NK_WHILE || k == ast.NK_XU || k == ast.NK_SEND || k == ast.NK_THROW || k == ast.NK_EXIT {
            last = max_bstmt(last, c.last_bexpr(p, p.nodes[s].a))
            if k == ast.NK_ASSIGN || k == ast.NK_FOR || k == ast.NK_SEND { last = max_bstmt(last, c.last_bexpr(p, p.nodes[s].b)) }
        }
        if k == ast.NK_IF {
            mut br := p.nodes[s].a
            while br >= 0 {
                last = max_bstmt(last, c.last_bexpr(p, p.nodes[br].a))
                inner := c.last_bstmt(p, p.nodes[br].b)
                if inner > last { last = inner }
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
            inner := c.last_bstmt(p, p.nodes[s].c)
            if inner > last { last = inner }
        }
        if k == ast.NK_MATCH {
            mut ar := p.nodes[s].b
            while ar >= 0 {
                if k == ast.NK_SELECT {
                    last = max_bstmt(last, c.last_bexpr(p, p.nodes[ar].a))
                    last = max_bstmt(last, c.last_bexpr(p, p.nodes[ar].b))
                }
                inner := c.last_bstmt(p, p.nodes[ar].c)
                if inner > last { last = inner }
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_SELECT {
            mut ar := p.nodes[s].a
            while ar >= 0 {
                if k == ast.NK_SELECT {
                    last = max_bstmt(last, c.last_bexpr(p, p.nodes[ar].a))
                    last = max_bstmt(last, c.last_bexpr(p, p.nodes[ar].b))
                }
                inner := c.last_bstmt(p, p.nodes[ar].c)
                if inner > last { last = inner }
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                inner2 := c.last_bstmt(p, p.nodes[s].c)
                if inner2 > last { last = inner2 }
            }
        }
        s = p.nodes[s].next
    }
    << last
}

fn (c &mut Checker) borrow_note_use(id int, stmt_id int) {
    if id >= 0 && id < c.blast.len && stmt_id > c.blast[id] {
        checker_set_i(mut &c.blast, id, stmt_id)
    }
}

fn (c &mut Checker) borrow_collect_expr(p &parser.Parser, n int, stmt_id int) {
    if n < 0 { << }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT {
        c.borrow_note_use(c.nlocal[n], stmt_id)
        <<
    }
    if k == ast.NK_CALL && c.ncall[n] == -80 {
        c.borrow_note_use(c.nlocal[n], stmt_id)
    }
    if k == ast.NK_BORROW {
        // Reborrowing reads the source reference. Its existing loan must
        // remain live until this expression (including &r.field / &r[i]).
        c.borrow_collect_expr(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NT_FN_LIT {
        // Capturing a reference copies it into the closure env: a use.
        caps := c.fn_lit_captures(n)
        for i in 0:caps.len {
            c.borrow_note_use(caps[i], stmt_id)
        }
        <<
    }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        c.borrow_collect_expr(p, kids[i], stmt_id)
    }
    if k == ast.NK_OR_CATCH {
        c.borrow_collect_block(p, p.nodes[n].c)
    }
}

fn (c &mut Checker) borrow_collect_block(p &parser.Parser, head int) {
    mut s := head
    while s >= 0 {
        sid := c.bstmt[s]
        k := p.nodes[s].kind
        if k == ast.NK_LET { c.borrow_collect_expr(p, p.nodes[s].a, sid) }
        if k == ast.NK_ASSIGN {
            if p.nodes[p.nodes[s].a].kind != ast.NK_IDENT {
                c.borrow_collect_expr(p, p.nodes[s].a, sid)
            }
            c.borrow_collect_expr(p, p.nodes[s].b, sid)
        }
        if k == ast.NK_EXPR_STMT || k == ast.NK_RETURN || k == ast.NK_THROW || k == ast.NK_EXIT { c.borrow_collect_expr(p, p.nodes[s].a, sid) }
        if k == ast.NK_IF {
            mut br := p.nodes[s].a
            while br >= 0 {
                c.borrow_collect_expr(p, p.nodes[br].a, sid)
                c.borrow_collect_block(p, p.nodes[br].b)
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR {
            c.borrow_collect_expr(p, p.nodes[s].a, sid)
            c.borrow_collect_expr(p, p.nodes[s].b, sid)
            c.borrow_collect_block(p, p.nodes[s].c)
            c.borrow_extend_loop(p, sid, p.nodes[s].c)
        }
        if k == ast.NK_FOR_EACH {
            c.borrow_collect_expr(p, p.nodes[s].a, sid)
            c.borrow_collect_block(p, p.nodes[s].c)
            c.borrow_extend_loop(p, sid, p.nodes[s].c)
        }
        if k == ast.NK_WHILE {
            c.borrow_collect_expr(p, p.nodes[s].a, sid)
            c.borrow_collect_block(p, p.nodes[s].c)
            c.borrow_extend_loop(p, sid, p.nodes[s].c)
        }
        if k == ast.NK_MATCH {
            c.borrow_collect_expr(p, p.nodes[s].a, sid)
            mut ar := p.nodes[s].b
            while ar >= 0 {
                c.borrow_collect_block(p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_XU {
            call := p.nodes[s].a
            if call >= 0 {
                mut arg := p.nodes[call].a
                while arg >= 0 {
                    c.borrow_collect_expr(p, arg, sid)
                    arg = p.nodes[arg].next
                }
            }
        }
        if k == ast.NK_SEND {
            c.borrow_collect_expr(p, p.nodes[s].a, sid)
            c.borrow_collect_expr(p, p.nodes[s].b, sid)
        }
        if k == ast.NK_SELECT {
            mut ar := p.nodes[s].a
            while ar >= 0 {
                c.borrow_collect_expr(p, p.nodes[ar].a, sid)
                if p.nodes[ar].kind == ast.NK_SEL_SEND {
                    c.borrow_collect_expr(p, p.nodes[ar].b, sid)
                }
                c.borrow_collect_block(p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                c.borrow_collect_block(p, p.nodes[s].c)
            }
        }
        s = p.nodes[s].next
    }
}

// The loop body re-runs, so a local declared outside the loop and used
// anywhere in it (header included) is live until the body's last statement.
// Locals declared inside the body are fresh per iteration and keep their range.
fn (c &mut Checker) borrow_extend_loop(p &parser.Parser, start int, body int) {
    end := c.last_bstmt(p, body)
    if end <= start { << }
    mut inner := []int{}
    for i in 0:c.blast.len {
        inner.push(0)
    }
    c.borrow_mark_decls(p, body, mut &inner)
    for id in 0:c.blast.len {
        if inner[id] == 0 && c.blast[id] >= start && c.blast[id] < end {
            checker_set_i(mut &c.blast, id, end)
        }
    }
}

// Set marks[id] = 1 for every local bound by a statement in the block tree.
fn (c &Checker) borrow_mark_decls(p &parser.Parser, head int, marks &mut []int) {
    mut s := head
    while s >= 0 {
        k := p.nodes[s].kind
        if k == ast.NK_LET || k == ast.NK_FOR || k == ast.NK_FOR_EACH {
            id := c.nlocal[s]
            if id >= 0 && id < marks.len { marks[id] = 1 }
        }
        if k == ast.NK_IF {
            mut br := p.nodes[s].a
            while br >= 0 {
                c.borrow_mark_decls(p, p.nodes[br].b, marks)
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
            c.borrow_mark_decls(p, p.nodes[s].c, marks)
        }
        if k == ast.NK_MATCH {
            mut ar := p.nodes[s].b
            while ar >= 0 {
                c.borrow_mark_decls(p, p.nodes[ar].c, marks)
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_SELECT {
            mut ar := p.nodes[s].a
            while ar >= 0 {
                c.borrow_mark_decls(p, p.nodes[ar].c, marks)
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                c.borrow_mark_decls(p, p.nodes[s].c, marks)
            }
        }
        s = p.nodes[s].next
    }
}

fn (c &Checker) borrow_root_local(p &parser.Parser, n int) int {
    mut cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_IDENT { << c.nlocal[cur] }
        if k == ast.NK_FIELD || k == ast.NK_INDEX {
            cur = p.nodes[cur].a
        } else {
            << -1
        }
    }
    << -1
}

// Element Place through a ref local (`r := &n; &r.kids[i]`) hangs on `n`.
fn (c &Checker) peel_elem_owner(id int, elem bool) int {
    if !elem || id < 0 {
        << id
    }
    if id < c.ltype.len && is_ref_type(c.ltype[id]) && id < c.bowner.len && c.bowner[id] >= 0 {
        << c.bowner[id]
    }
    << id
}

// MS4 Place: LocalId + [Field | Index]. True if the lvalue chain has Index.
fn (c &Checker) place_has_index(p &parser.Parser, n int) bool {
    mut cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX { << true }
        if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            << false
        }
    }
    << false
}

fn (c &Checker) place_proj_of(p &parser.Parser, n int) int {
    if c.place_has_index(p, n) { << 1 }
    << 0
}

// Element-origin ref (`&xs[i]`, `&m[k]`) loads through buffer layout (+8k).
fn (c &Checker) expr_ref_is_buf(p &parser.Parser, n int) bool {
    if n < 0 { << false }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT {
        id := c.nlocal[n]
        if id >= 0 && id < c.bproj.len && c.bproj[id] == 1 { << true }
        << false
    }
    if k == ast.NK_BORROW {
        << c.place_has_index(p, p.nodes[n].a)
    }
    << false
}

fn (c &Checker) borrow_chain_is_map(p &parser.Parser, n int) bool {
    mut cur := n
    while cur >= 0 {
        if c.ncall[cur] == -77 { << true }
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX {
            if c.peel_map(c.ntype[p.nodes[cur].a]) >= 0 { << true }
            cur = p.nodes[cur].a
        } else if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            << false
        }
    }
    << false
}

fn (c &Checker) borrow_live(ref_local int, stmt_id int) bool {
    << ref_local >= 0 && ref_local < c.bowner.len && c.bowner[ref_local] >= 0 &&
        c.bdecl[ref_local] >= 0 && c.bdecl[ref_local] < stmt_id && c.blast[ref_local] >= stmt_id
}

fn (c &Checker) borrow_field_live(i int, stmt_id int) bool {
    if i < 0 || i >= c.bf_holder.len { << false }
    h := c.bf_holder[i]
    << h >= 0 && c.bf_owner[i] >= 0 && c.bf_decl[i] >= 0 && c.bf_decl[i] < stmt_id &&
        h < c.blast.len && c.blast[h] >= stmt_id
}

fn (c &Checker) borrow_has_any(owner int, stmt_id int) bool {
    for r in 0:c.bowner.len {
        if c.borrow_live(r, stmt_id) && c.bowner[r] == owner { << true }
    }
    for i in 0:c.bf_holder.len {
        if c.borrow_field_live(i, stmt_id) && c.bf_owner[i] == owner { << true }
    }
    for i in 0:c.btmp_owner.len {
        if c.btmp_owner[i] == owner { << true }
    }
    << false
}

fn (c &Checker) borrow_has_exclusive(owner int, stmt_id int) bool {
    for r in 0:c.bowner.len {
        if c.borrow_live(r, stmt_id) && c.bowner[r] == owner && c.bexcl[r] != 0 { << true }
    }
    for i in 0:c.bf_holder.len {
        if c.borrow_field_live(i, stmt_id) && c.bf_owner[i] == owner && c.bf_excl[i] != 0 { << true }
    }
    for i in 0:c.btmp_owner.len {
        if c.btmp_owner[i] == owner && c.btmp_excl[i] != 0 { << true }
    }
    << false
}

fn (c &Checker) borrow_has_elem(owner int, stmt_id int) bool {
    for r in 0:c.bowner.len {
        if c.borrow_live(r, stmt_id) && c.bowner[r] == owner && r < c.bproj.len && c.bproj[r] == 1 {
            << true
        }
    }
    for i in 0:c.bf_holder.len {
        if c.borrow_field_live(i, stmt_id) && c.bf_owner[i] == owner && i < c.bf_proj.len && c.bf_proj[i] == 1 {
            << true
        }
    }
    for i in 0:c.btmp_owner.len {
        if c.btmp_owner[i] == owner && i < c.btmp_proj.len && c.btmp_proj[i] == 1 { << true }
    }
    << false
}

fn (c &Checker) reborrow_reaches(from int, src int) bool {
    mut cur := from
    for i in 0:c.breb.len {
        if cur < 0 || cur >= c.breb.len { << false }
        if c.breb[cur] == src { << true }
        cur = c.breb[cur]
    }
    // A cycle is malformed provenance; treat it as possibly reaching src.
    << cur >= 0
}

fn (c &Checker) borrow_frozen(src int, stmt_id int) bool {
    if src < 0 { << false }
    // Shared references remain usable while shared descendants are live.
    if !is_mut_ref_type(c.ltype[src]) { << false }
    for r in 0:c.breb.len {
        if c.borrow_live(r, stmt_id) && c.reborrow_reaches(r, src) { << true }
    }
    for i in 0:c.bf_holder.len {
        if c.borrow_field_live(i, stmt_id) && c.bf_reb[i] >= 0 {
            parent := c.bf_reb[i]
            if parent == src || c.reborrow_reaches(parent, src) { << true }
        }
    }
    << false
}

fn (c &mut Checker) borrow_read_event(p &parser.Parser, owner int, n int, stmt_id int) {
    if owner >= 0 && (c.borrow_has_exclusive(owner, stmt_id) || c.borrow_frozen(owner, stmt_id)) {
        c.fail_node(p, n, "cannot use '" + c.lname[owner] + "' while it is mutably borrowed")
    }
}

fn (c &mut Checker) borrow_write_event(p &parser.Parser, owner int, n int, stmt_id int) {
    if owner >= 0 && (c.borrow_has_any(owner, stmt_id) || c.borrow_frozen(owner, stmt_id)) {
        c.fail_node(p, n, "cannot assign to '" + c.lname[owner] + "' because it is borrowed")
    }
}

fn (c &mut Checker) borrow_move_event(p &parser.Parser, owner int, n int, stmt_id int) {
    if owner >= 0 && (c.borrow_has_any(owner, stmt_id) || c.borrow_frozen(owner, stmt_id)) {
        c.fail_node(p, n, "cannot move '" + c.lname[owner] + "' because it is borrowed")
    }
}

fn (c &mut Checker) borrow_new_event(p &parser.Parser, owner int, exclusive bool, elem bool, n int, stmt_id int) {
    if owner < 0 { << }
    if exclusive && c.borrow_has_any(owner, stmt_id) {
        c.fail_node(p, n, "cannot borrow '" + c.lname[owner] + "' as mutable because it is also borrowed")
    }
    if !exclusive && c.borrow_has_exclusive(owner, stmt_id) {
        c.fail_node(p, n, "cannot borrow '" + c.lname[owner] + "' as immutable because it is also borrowed as mutable")
    }
    c.btmp_owner.push(owner)
    c.btmp_excl.push(b2i(exclusive))
    mut pj := 0
    if elem { pj = 1 }
    c.btmp_proj.push(pj)
}

// A holder keeps every loan carried by its value, including nested fields,
// call results and closure environments. Field -1 denotes a whole-value loan.
fn (c &mut Checker) borrow_add_held(holder int, field int, owner int, excl int, proj int, parent int, stmt_id int) {
    if owner < 0 { << }
    c.bf_holder.push(holder)
    c.bf_field.push(field)
    c.bf_owner.push(owner)
    c.bf_excl.push(excl)
    c.bf_decl.push(stmt_id)
    c.bf_proj.push(proj)
    c.bf_reb.push(parent)
}

fn (c &mut Checker) borrow_hold_local(holder int, field int, src int, stmt_id int) {
    if src < 0 || src >= c.bowner.len { << }
    if is_ref_type(c.ltype[src]) {
        mut parent := c.breb[src]
        if is_mut_ref_type(c.ltype[src]) { parent = src }
        c.borrow_add_held(holder, field, c.bowner[src], c.bexcl[src], c.bproj[src], parent, stmt_id)
    }
    // Bound the walk before appending, including when holder == src.
    count := c.bf_holder.len
    for i in 0:count {
        if c.bf_holder[i] == src {
            c.borrow_add_held(holder, field, c.bf_owner[i], c.bf_excl[i], c.bf_proj[i], c.bf_reb[i], stmt_id)
        }
    }
}

fn (c &mut Checker) borrow_hold_expr(p &parser.Parser, holder int, field int, init int, stmt_id int) {
    if init < 0 { << }
    k := p.nodes[init].kind
    if k == ast.NK_IDENT {
        c.borrow_hold_local(holder, field, c.nlocal[init], stmt_id)
        <<
    }
    if k == ast.NK_BORROW {
        tgt := p.nodes[init].a
        mut parent := -1
        mut owner := c.borrow_root_local(p, tgt)
        mut proj := c.place_proj_of(p, tgt)
        if p.nodes[tgt].kind == ast.NK_UN_OP && p.nodes[tgt].ival == 3 {
            parent = c.borrow_root_local(p, p.nodes[tgt].a)
            if parent >= 0 {
                owner = c.bowner[parent]
                proj = c.bproj[parent]
            }
        } else {
            if owner >= 0 && is_ref_type(c.ltype[owner]) {
                parent = owner
                owner = c.bowner[parent]
            }
        }
        c.borrow_add_held(holder, field, owner, b2i(p.nodes[init].ival == 1), proj, parent, stmt_id)
        if parent >= 0 {
            count := c.bf_holder.len
            for i in 0:count {
                if c.bf_holder[i] == parent {
                    c.borrow_add_held(holder, field, c.bf_owner[i], b2i(p.nodes[init].ival == 1), proj | c.bf_proj[i], parent, stmt_id)
                }
            }
        }
        <<
    }
    if k == ast.NT_FN_LIT {
        caps := c.fn_lit_captures(init)
        for i in 0:caps.len { c.borrow_hold_local(holder, field, caps[i], stmt_id) }
        <<
    }
    if !c.type_contains_ref(c.ntype[init]) { << }
    // A result may retain any reference-bearing input. Conservatively keep
    // their union; selecting only one argument would lose valid provenance.
    kids := expr_kids(p, init)
    for i in 0:kids.len {
        c.borrow_hold_expr(p, holder, field, kids[i], stmt_id)
    }
    if k == ast.NK_METHOD_CALL {
        recv := p.nodes[init].a
        root := c.borrow_root_local(p, recv)
        if root >= 0 && !is_ref_type(c.ltype[root]) {
            c.borrow_add_held(holder, field, root, b2i(is_mut_ref_type(c.ntype[init])), c.place_proj_of(p, recv), -1, stmt_id)
        }
    }
}

fn (c &mut Checker) borrow_register_ref(p &parser.Parser, local int, init int, stmt_id int) {
    if local < 0 { << }
    // Self-assignment must preserve the input's provenance while collecting.
    first := c.bf_holder.len
    c.borrow_hold_expr(p, local, -1, init, stmt_id)
    mut owner := -1
    mut excl := 0
    mut proj := 0
    mut parent := -1
    for i in first:c.bf_holder.len {
        if c.bf_holder[i] == local {
            if owner < 0 { owner = c.bf_owner[i] }
            excl = excl | c.bf_excl[i]
            proj = proj | c.bf_proj[i]
            if parent < 0 { parent = c.bf_reb[i] }
        }
    }
    // Earlier records are retained conservatively. They expire with this
    // holder's last use; this also preserves loans across control-flow paths.
    checker_set_i(mut &c.bowner, local, owner)
    checker_set_i(mut &c.bexcl, local, excl)
    checker_set_i(mut &c.bproj, local, proj)
    checker_set_i(mut &c.breb, local, parent)
    checker_set_i(mut &c.bdecl, local, stmt_id)
}

fn (c &mut Checker) borrow_register_field(p &parser.Parser, holder int, field int, init int, stmt_id int) {
    c.borrow_hold_expr(p, holder, field, init, stmt_id)
}

fn (c &mut Checker) borrow_walk_move(p &parser.Parser, n int, stmt_id int) {
    if n < 0 { << }
    if p.nodes[n].kind == ast.NK_IDENT && c.type_owning(c.ntype[n]) {
        c.borrow_move_event(p, c.nlocal[n], n, stmt_id)
        <<
    }
    c.borrow_walk_expr(p, n, stmt_id)
}

fn (c &mut Checker) borrow_walk_receiver(p &parser.Parser, n int, write bool, stmt_id int) {
    root := c.borrow_root_local(p, n)
    if root >= 0 && !is_ref_type(c.ltype[root]) {
        if write {
            c.borrow_write_event(p, root, n, stmt_id)
        } else {
            c.borrow_read_event(p, root, n, stmt_id)
        }
        <<
    }
    c.borrow_walk_expr(p, n, stmt_id)
}

fn (c &mut Checker) borrow_walk_expr(p &parser.Parser, n int, stmt_id int) {
    if n < 0 { << }
    k := p.nodes[n].kind
    if k == ast.NK_OR_CATCH {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        c.borrow_check_block(p, p.nodes[n].c)
        <<
    }
    if k == ast.NK_IDENT {
        c.borrow_read_event(p, c.nlocal[n], n, stmt_id)
        <<
    }
    if k == ast.NK_BORROW {
        target := p.nodes[n].a
        if p.nodes[target].kind == ast.NK_UN_OP && p.nodes[target].ival == 3 {
            src := c.borrow_root_local(p, p.nodes[target].a)
            if src >= 0 && c.borrow_frozen(src, stmt_id) {
                c.fail_node(p, n, "cannot reborrow a frozen reference")
            }
            <<
        }
        mut owner := c.borrow_root_local(p, target)
        elem := c.place_has_index(p, target)
        owner = c.peel_elem_owner(owner, elem)
        c.borrow_new_event(p, owner, p.nodes[n].ival == 1, elem, n, stmt_id)
        c.borrow_walk_place_index(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_CALL {
        fi := c.ncall[n]
        if fi == -80 { c.borrow_read_event(p, c.nlocal[n], n, stmt_id) }
        mut arg := p.nodes[n].a
        mut ai := 0
        while arg >= 0 {
            if c.call_arg_moves(fi, ai) {
                c.borrow_walk_move(p, arg, stmt_id)
            } else {
                c.borrow_walk_expr(p, arg, stmt_id)
            }
            ai += 1
            arg = p.nodes[arg].next
        }
        <<
    }
    if k == ast.NK_STRUCT_INIT {
        mut sf := p.nodes[n].a
        while sf >= 0 {
            c.borrow_walk_move(p, p.nodes[sf].a, stmt_id)
            sf = p.nodes[sf].next
        }
        <<
    }
    if k == ast.NK_FIELD {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_METHOD_CALL {
        fi := c.ncall[n]
        if fi == -86 || fi == -88 {
            root := c.borrow_root_local(p, p.nodes[n].a)
            if root >= 0 && c.borrow_has_any(root, stmt_id) {
                c.fail_node(p, n, "cannot mutate '" + c.lname[root] + "' while it is borrowed")
            }
        }
        if fi == -3 || fi == -4 || fi == -51 {
            root := c.borrow_root_local(p, p.nodes[n].a)
            if (fi == -4 || fi == -51) && root >= 0 && c.borrow_has_elem(root, stmt_id) {
                c.fail_node(p, n, "cannot mutate '" + c.lname[root] + "' while an element is borrowed")
            }
            if root >= 0 && !is_ref_type(c.ltype[root]) {
                c.borrow_new_event(p, root, true, false, n, stmt_id)
            } else {
                c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
            }
        } else if fi == -14 || fi == -96 {
            c.borrow_walk_move(p, p.nodes[n].a, stmt_id)
        } else if fi >= 0 {
            c.borrow_walk_receiver(p, p.nodes[n].a, c.fns[fi].recv_mut, stmt_id)
        } else {
            c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        }
        mut arg := p.nodes[n].b
        mut ai := 0
        while arg >= 0 {
            if fi == -4 || fi == -51 {
                c.borrow_walk_move(p, arg, stmt_id)
            } else if c.call_arg_moves(fi, ai) {
                c.borrow_walk_move(p, arg, stmt_id)
            } else {
                c.borrow_walk_expr(p, arg, stmt_id)
            }
            ai += 1
            arg = p.nodes[arg].next
        }
        <<
    }
    if k == ast.NK_TRY {
        c.borrow_walk_move(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_ARRAY_LIT {
        mut e := p.nodes[n].a
        while e >= 0 {
            c.borrow_walk_move(p, e, stmt_id)
            e = p.nodes[e].next
        }
        <<
    }
    if k == ast.NT_FN_LIT {
        // Captures copy `&T` / move owning values and `&mut T` into the env.
        caps := c.fn_lit_captures(n)
        for i in 0:caps.len {
            id := caps[i]
            if c.type_owning(c.ltype[id]) || is_mut_ref_type(c.ltype[id]) {
                c.borrow_move_event(p, id, n, stmt_id)
            } else {
                c.borrow_read_event(p, id, n, stmt_id)
            }
        }
        <<
    }
    if !expr_kind_known(k) {
        c.fail_node(p, n, "internal error: borrow checker cannot analyze expression kind " + str(k))
        <<
    }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        c.borrow_walk_expr(p, kids[i], stmt_id)
    }
}

fn (c &mut Checker) borrow_walk_place_index(p &parser.Parser, n int, stmt_id int) {
    mut cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX {
            c.borrow_walk_expr(p, p.nodes[cur].b, stmt_id)
            cur = p.nodes[cur].a
        } else if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            <<
        }
    }
}

fn (c &mut Checker) borrow_check_stmt(p &parser.Parser, n int) {
    old_control := c.bcontrol
    k := p.nodes[n].kind
    if c.bcontrol < 0 && (k == ast.NK_IF || k == ast.NK_MATCH || k == ast.NK_SELECT || k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE) {
        c.bcontrol = c.bstmt[n]
    }
    c.borrow_check_stmt_inner(p, n)
    c.bcontrol = old_control
}

fn (c &mut Checker) borrow_check_stmt_inner(p &parser.Parser, n int) {
    stmt_id := c.bstmt[n]
    c.btmp_owner = []int{}
    c.btmp_excl = []int{}
    c.btmp_proj = []int{}
    k := p.nodes[n].kind
    if k == ast.NK_LET {
        c.borrow_walk_move(p, p.nodes[n].a, stmt_id)
        c.borrow_register_ref(p, c.nlocal[n], p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_ASSIGN {
        target := p.nodes[n].a
        root := c.borrow_root_local(p, target)
        mut target_ty := c.ntype[target]
        if root >= 0 && p.nodes[target].kind == ast.NK_IDENT { target_ty = c.ltype[root] }
        if target_ty <= 0 { target_ty = c.ntype[p.nodes[n].b] }
        if root >= 0 && p.nodes[target].kind != ast.NK_IDENT && is_ref_type(c.ltype[root]) && c.type_contains_ref(target_ty) {
            c.fail_node(p, n, "cannot store a reference-bearing value through a reference without a proven lifetime")
        }
        if root >= 0 && c.bcontrol >= 0 && c.bdecl[root] < c.bcontrol && c.type_contains_ref(target_ty) {
            c.fail_node(p, n, "cannot rebind a reference-bearing value across control-flow paths")
        }
        if c.ncall[n] == -78 || c.ncall[target] == -78 {
            if root >= 0 && c.borrow_has_any(root, stmt_id) {
                c.fail_node(p, n, "cannot mutate '" + c.lname[root] + "' while it is borrowed")
            }
        }
        // M149: rebinding a reference local replaces the borrow record.
        if p.nodes[target].kind == ast.NK_IDENT && root >= 0 && is_ref_type(c.ltype[root]) {
            c.borrow_walk_move(p, p.nodes[n].b, stmt_id)
            c.borrow_register_ref(p, root, p.nodes[n].b, stmt_id)
            <<
        }
        // M162: rebinding a ref-typed field `h.r = mut &y`.
        if p.nodes[target].kind == ast.NK_FIELD && root >= 0 {
            base := p.nodes[target].a
            if p.nodes[base].kind == ast.NK_IDENT {
                bty := c.direct_type(c.ntype[base])
                if is_struct_type(bty) {
                    si := struct_index(bty)
                    fi := c.find_field(si, p.nodes[target].sval)
                    if fi >= 0 && is_ref_type(c.structs[si].fields[fi].ty) {
                        c.borrow_write_event(p, root, p.nodes[n].b, stmt_id)
                        c.borrow_walk_move(p, p.nodes[n].b, stmt_id)
                        c.borrow_register_field(p, root, fi, p.nodes[n].b, stmt_id)
                        <<
                    }
                }
            }
        }
        // Whole-struct assign clears field-stored borrows then re-registers.
        if p.nodes[target].kind == ast.NK_IDENT && root >= 0 && is_struct_type(c.ltype[root]) {
            c.borrow_write_event(p, root, p.nodes[n].b, stmt_id)
            c.borrow_walk_move(p, p.nodes[n].b, stmt_id)
            c.borrow_register_ref(p, root, p.nodes[n].b, stmt_id)
            <<
        }
        if root >= 0 && !is_ref_type(c.ltype[root]) {
            c.borrow_write_event(p, root, p.nodes[n].b, stmt_id)
        } else {
            c.borrow_walk_expr(p, target, stmt_id)
        }
        if p.nodes[target].kind == ast.NK_INDEX {
            c.borrow_walk_expr(p, p.nodes[target].b, stmt_id)
        }
        c.borrow_walk_move(p, p.nodes[n].b, stmt_id)
        if root >= 0 {
            c.borrow_hold_expr(p, root, -1, p.nodes[n].b, stmt_id)
        }
        <<
    }
    if k == ast.NK_EXPR_STMT {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_RETURN {
        c.borrow_walk_move(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_IF {
        mut br := p.nodes[n].a
        while br >= 0 {
            c.borrow_walk_expr(p, p.nodes[br].a, stmt_id)
            c.borrow_check_block(p, p.nodes[br].b)
            br = p.nodes[br].next
        }
        <<
    }
    if k == ast.NK_FOR {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        c.borrow_walk_expr(p, p.nodes[n].b, stmt_id)
        c.borrow_check_block(p, p.nodes[n].c)
        <<
    }
    if k == ast.NK_FOR_EACH {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        varid := c.nlocal[n]
        mut hang := false
        if c.ncall[n] == -91 {
            hang = true
        }
        if varid >= 0 && varid < c.lview.len && c.lview[varid] != 0 {
            hang = true
        }
        if hang {
            root := c.borrow_root_local(p, p.nodes[n].a)
            last := c.last_bstmt(p, p.nodes[n].c)
            if root >= 0 && last >= 0 && varid >= 0 {
                checker_set_i(mut &c.bowner, varid, root)
                checker_set_i(mut &c.bexcl, varid, 0)
                if varid < c.bproj.len { checker_set_i(mut &c.bproj, varid, 1) }
                checker_set_i(mut &c.bdecl, varid, stmt_id)
                if last > c.blast[varid] {
                    checker_set_i(mut &c.blast, varid, last)
                }
            }
        }
        c.borrow_check_block(p, p.nodes[n].c)
        <<
    }
    if k == ast.NK_WHILE {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        c.borrow_check_block(p, p.nodes[n].c)
        <<
    }
    if k == ast.NK_BREAK || k == ast.NK_CONTINUE {
        <<
    }
    if k == ast.NK_THROW {
        c.borrow_walk_move(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_EXIT {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_MATCH {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        mut ar := p.nodes[n].b
        while ar >= 0 {
            c.borrow_check_block(p, p.nodes[ar].c)
            ar = p.nodes[ar].next
        }
        <<
    }
    if k == ast.NK_XU {
        call := p.nodes[n].a
        if call >= 0 {
            mut arg := p.nodes[call].a
            while arg >= 0 {
                c.borrow_walk_move(p, arg, stmt_id)
                arg = p.nodes[arg].next
            }
        }
        <<
    }
    if k == ast.NK_SEND {
        c.borrow_walk_expr(p, p.nodes[n].a, stmt_id)
        c.borrow_walk_move(p, p.nodes[n].b, stmt_id)
        <<
    }
    if k == ast.NK_SELECT {
        mut ar := p.nodes[n].a
        while ar >= 0 {
            c.borrow_walk_expr(p, p.nodes[ar].a, stmt_id)
            if p.nodes[ar].kind == ast.NK_SEL_SEND {
                c.borrow_walk_move(p, p.nodes[ar].b, stmt_id)
            }
            c.borrow_check_block(p, p.nodes[ar].c)
            ar = p.nodes[ar].next
        }
        if p.nodes[n].c >= 0 {
            c.borrow_check_block(p, p.nodes[n].c)
        }
        <<
    }
}

fn (c &mut Checker) borrow_check_block(p &parser.Parser, head int) {
    mut s := head
    while s >= 0 {
        c.borrow_check_stmt(p, s)
        s = p.nodes[s].next
    }
}

fn (c &mut Checker) borrow_check_fn(p &parser.Parser, d int) {
    c.blast = []int{}
    c.bdecl = []int{}
    c.bowner = []int{}
    c.bexcl = []int{}
    c.bproj = []int{}
    c.breb = []int{}
    c.bf_holder = []int{}
    c.bf_field = []int{}
    c.bf_owner = []int{}
    c.bf_excl = []int{}
    c.bf_decl = []int{}
    c.bf_proj = []int{}
    c.bf_reb = []int{}
    c.bcontrol = -1
    for i in 0:c.ltype.len {
        c.blast.push(-1)
        c.bdecl.push(-1)
        c.bowner.push(-1)
        c.bexcl.push(0)
        c.bproj.push(0)
        c.breb.push(-1)
    }
    mut nparams := 0
    if p.nodes[d].d >= 0 { nparams += 1 }
    mut param := p.nodes[d].a
    while param >= 0 {
        nparams += 1
        param = p.nodes[param].next
    }
    for id in 0:nparams {
        if is_ref_type(c.ltype[id]) {
            exclusive := b2i(is_mut_ref_type(c.ltype[id]))
            checker_set_i(mut &c.bowner, id, id)
            checker_set_i(mut &c.bexcl, id, exclusive)
        }
    }
    c.bseq = 0
    c.borrow_number_block(p, p.nodes[d].c)
    c.borrow_collect_block(p, p.nodes[d].c)
    c.borrow_check_block(p, p.nodes[d].c)
}

// ===== statements =====
