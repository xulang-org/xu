@xu/types

// Closed-world call-site propagation. A callee is narrowed only when every
// reference to it is a direct call in this MIR and it is not exported,
// external, an entry point, or address-taken.

fn w32_label_eq(m &Mir, fi int, label string) bool {
    << mir_fn_label(m, fi) == label
}

fn w32_label_taken(m &Mir, fi int, label string) bool {
    for ii in 0:mir_nins(m, fi) {
        k := mir_ikind(m, fi, ii)
        if k == MI_LOAD_FN_ADDR || k == MI_MAKE_CLOSURE {
            if mir_isval(m, fi, ii) == label { << true }
        }
    }
    << false
}

fn w32_fn_propagable(m &Mir, fi int) bool {
    if fi < 0 || fi >= m.fns.len { << false }
    if mir_fn_is_extern(m, fi) || mir_fn_is_pub(m, fi) { << false }
    if mir_fn_name(m, fi) == "main" { << false }
    name := mir_fn_name(m, fi)
    if name.len >= 4 && name[0] == 105 && name[1] == 114 && name[2] == 113 && name[3] == 95 { << false }
    label := mir_fn_label(m, fi)
    for caller in 0:m.fns.len {
        if w32_label_taken(m, caller, label) { << false }
    }
    << true
}

fn w32_find_fn(m &Mir, label string) int {
    for fi in 0:m.fns.len {
        if mir_fn_label(m, fi) == label { << fi }
    }
    << -1
}

fn w32_call_label(m &Mir, fi int, ii int) string {
    << mir_isval(m, fi, ii)
}

// Do not solve a caller's CFG when it cannot contribute to this callee.
// Imported packages may contain hundreds of functions; solving every CFG
// for every callee turns a small hosted program into a quadratic analysis.
fn w32_has_direct_call(m &Mir, fi int, label string) bool {
    for ii in 0:mir_nins(m, fi) {
        k := mir_ikind(m, fi, ii)
        if k == MI_XU || (k == MI_CALL && mir_ib(m, fi, ii) == 1) {
            if mir_isval(m, fi, ii) == label { << true }
        }
    }
    << false
}

fn w32_collect_from_chain(m &Mir, fi int, head int, params $&[]W32Iv) {
    $ap := head
    $i := 0
    while ap >= 0 && i < params.len && i < W32_ARG_LIMIT {
        // Arguments are interval values at the call site's current state;
        // the caller of this helper supplies the state-derived value below.
        ap = mir_marg_next(m, fi, ap)
        i += 1
    }
}

// Collect direct-call arguments after the caller's block fixpoint. `out` is
// one interval per callee parameter and starts bottom (represented by a
// separate `seen` bit in the caller below).
fn w32_call_args_from_entries(m &Mir, fi int, params &[]W32Iv, callee_label string, out $&[]W32Iv, seen $&[]bool) bool {
    $entries := []W32Iv{}
    $reachable := []bool{}
    if !w32_fixpoint(m, fi, params, $&entries, $&reachable) { << false }
    nl := mir_nlocals(m, fi)
    nc := nl + mir_ntemps(m, fi)
    nb := mir_nblocks(m, fi)
    for bi in 0:nb {
        if !reachable[bi] { -> }
        $st := []W32Iv{}
        for c in 0:nc {
            v := entries[bi * nc + c]
            st.push(w32_copy_iv(&v))
        }
        $ii := mir_bhead(m, fi, bi)
        while ii >= 0 {
            k := mir_ikind(m, fi, ii)
            $direct := false
            if k == MI_XU && w32_call_label(m, fi, ii) == callee_label { direct = true }
            if k == MI_CALL && mir_ib(m, fi, ii) == 1 && w32_call_label(m, fi, ii) == callee_label { direct = true }
            if direct {
                $ap := mir_ic(m, fi, ii)
                $p := 0
                $n := 0
                while ap >= 0 && p < out.len && n < W32_ARG_LIMIT {
                    v := mir_marg_v(m, fi, ap)
                    x := w32_value(m, fi, &st, nl, v)
                    if !seen[p] {
                        out[p] = w32_copy_iv(&x)
                        seen[p] = true
                    } else {
                        old := out[p]
                        out[p] = w32_join(&old, &x)
                    }
                    p += 1
                    n += 1
                    ap = mir_marg_next(m, fi, ap)
                }
            }
            $scratch := []W32Bad{}
            w32_step(m, fi, ii, bi, $&st, nl, false, $&scratch)
            ii = mir_inext(m, fi, ii)
        }
    }
    << true
}

// Flat storage avoids borrowing nested heap slice descriptors as frame
// descriptors. Each extracted parameter list is an ordinary local slice.
fn w32_params_for(all &[]W32Iv, offsets &[]int, fi int) []W32Iv {
    $out := []W32Iv{}
    for i in offsets[fi]:offsets[fi + 1] { out.push(all[i]) }
    << out
}

fn w32_compute_params(m &Mir, offsets &[]int) []W32Iv {
    $params := []W32Iv{}
    for i in 0:offsets[m.fns.len] { params.push(w32_full()) }
    for round in 0:8 {
        $next := []W32Iv{}
        for callee in 0:m.fns.len {
            np := mir_fn_nparams(m, callee)
            $out := []W32Iv{}
            $seen := []bool{}
            for i in 0:np { out.push(w32_full())
                seen.push(false) }
            $complete := true
            if np > 0 && w32_fn_propagable(m, callee) {
                label := mir_fn_label(m, callee)
                for caller in 0:m.fns.len {
                    if mir_fn_is_extern(m, caller) { -> }
                    if !w32_has_direct_call(m, caller, label) { -> }
                    cp := w32_params_for(&params, offsets, caller)
                    if !w32_call_args_from_entries(m, caller, &cp, label, $&out, $&seen) { complete = false }
                }
            }
            for p in 0:np {
                if !complete || !seen[p] { next.push(w32_full()) } else { next.push(out[p]) }
            }
        }
        if w32_state_eq(&params, &next) { << next }
        params = next
    }
    // No fixed point: restore every caller boundary to a full carrier.
    for i in 0:params.len { params[i] = w32_full() }
    << params
}

fn w32_reason_text(reason int) string {
    if reason == 1 { << "result of int operation may not fit" }
    if reason == 2 { << "constant does not fit" }
    if reason == 3 { << "conversion result may not fit" }
    if reason == 4 { << "runtime int result may not fit" }
    << "analysis budget exceeded"
}

fn w32_op_text(op int) string {
    if op == 1 { << "+" }
    if op == 2 { << "-" }
    if op == 3 { << "*" }
    if op == 4 { << "/" }
    if op == 5 { << "%" }
    if op == 17 { << "<<" }
    if op == 18 { << ">>" }
    << "int operation"
}

pub fn mir_width32_gate(m &Mir, target_name string, warn bool) int {
    $offsets := [0]
    $total := 0
    for fi in 0:m.fns.len { total += mir_fn_nparams(m, fi)
        offsets.push(total) }
    params := w32_compute_params(m, &offsets)
    $bad := []W32Bad{}
    for fi in 0:m.fns.len {
        if mir_fn_is_extern(m, fi) { -> }
        fp := w32_params_for(&params, &offsets, fi)
        if !w32_check_fn(m, fi, &fp, $&bad) {
            w32_note($&bad, fi, -1, 0, 0, 5)
        }
    }
    $kind := "error"
    if warn { kind = "warning" }
    for i in 0:bad.len {
        fi := bad[i].fi
        $line := 0
        $col := 0
        if bad[i].ii >= 0 {
            line = mir_iline(m, fi, bad[i].ii)
            col = mir_icol(m, fi, bad[i].ii)
        }
        if line == 0 && bad[i].bi >= 0 { line = mir_bline(m, fi, bad[i].bi) }
        file_id := mir_fn_file(m, fi)
        $fname := "?"
        if file_id >= 0 && file_id < m.files.len { fname = m.files[file_id] }
        eprintln(fname + ":" + str(line) + ":" + str(col) + ": " + kind + ": int value may exceed 32 bits on " + target_name +
            " (in fn " + mir_fn_label(m, fi) + ": " + w32_reason_text(bad[i].reason) + ") [" + w32_op_text(bad[i].op) + "]; use i32 explicitly, or build for a 64-bit target")
    }
    if warn { << 0 }
    << bad.len
}
