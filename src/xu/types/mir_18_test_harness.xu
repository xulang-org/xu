// SSA consumes a canonical linked-list view, while legacy DCE/CFG may leave
// an in-range tail on an empty block. Exercise the actual promotion seam.
pub fn mir_empty_tail_promotion_fixture(mode int) bool {
    mut f := mir_fn_blank()
    f.nparams = 1
    f.ret = 1
    f.ret_nslots = 1
    for _ in 0:2 {
        f.locals.push(1)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
    }
    for _ in 0:4 { f.temps.push(1)
        f.temps_nslots.push(1) }
    f.consts.push(19)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: 1, tkind: 3, ta: 3, tb: -1, tc: -1, line: 0})
    mir_reduce_safety_instr(mut &f, 0, 2, 0, 0, 0, 0)
    mir_reduce_safety_instr(mut &f, 0, 3, 1, 0, 0, 0)
    mir_reduce_safety_instr(mut &f, 0, 2, 1, 1, 0, 0)
    mir_reduce_safety_instr(mut &f, 0, 4, 2, 1, 1, -2)
    mir_reduce_safety_instr(mut &f, 0, 3, 1, 2, 0, 0)
    mir_reduce_safety_instr(mut &f, 0, 2, 3, 1, 0, 0)
    if mode == 1 { f.blocks[1].tail = -1 }
    if mode == 2 { f.blocks[1].tail = 999 }
    if mode == 3 { f.blocks[1].tail = -2 }
    if mode == 4 { f.blocks[1].head = -2 }
    if mode == 5 { f.blocks[1].head = 0
        f.blocks[1].tail = -1 }
    if mode == 6 { f.locals_nslots[1] = 2 }
    if mode == 7 { f.temps[0] = 4 }
    if mode == 8 { mir_reduce_safety_instr(mut &f, 0, 16, 3, 1, 0, 0) }
    if mode == 9 {
        mut ins := mfn_instr_snap(mut &f.instrs, 5)
        ins.next = 999
        mfn_set_instr(mut &f.instrs, 5, ins)
    }
    if mode == 10 { f.blocks[1].head = 0
        f.blocks[1].tail = 5 }
    if mode == 11 { f.blocks[1].ta = 999 }
    if mode == 12 { f.blocks[1].ta = -1 }
    if mode == 13 || mode == 14 {
        mut tk := 1
        mut to := 1
        if mode == 14 { tk = 3
            to = -1 }
        f.blocks.push(MBlock{head: -1, tail: 3, tkind: tk, ta: to, tb: -1, tc: -1, line: 0})
    }
    if mode == 15 {
        mut ins := mfn_instr_snap(mut &f.instrs, 0)
        ins.b = 1
        mfn_set_instr(mut &f.instrs, 0, ins)
    }
    promoted := mir_promote_scalar_locals_ssa_f(mut &f)
    if promoted != 1 || f.blocks[1].head != -1 || f.blocks[1].tail != -1 { << false }
    if mir_verify_mfn_f(&f, true) != 0 { << false }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == mi_load_local && mfn_ib(&f.instrs, ii) == 1 { << false }
            if k == mi_store_local && mfn_ia(&f.instrs, ii) == 1 { << false }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << true
}

