pub fn mir_operand_probe(kind int) Mir {
    mut f := mir_fn_blank()
    for _ in 0:224 {
        f.temps.push(1)
        f.temps_nslots.push(1)
    }
    mut end := 113
    if kind == 43 { end = 123 }
    if kind == 46 { end = 23 }
    for i in 0:128 {
        mut next := i + 1
        if i == end || i == 127 { next = -1 }
        f.margs.push(MArg{v: i + 60, next: next})
    }
    mut ins := mkinstr(kind)
    ins.a = 10
    ins.b = 20
    ins.c = 30
    ins.d = 40
    if kind == 46 { ins.c = 1
        ins.d = 8 }
    f.instrs.push(ins)
    f.blocks.push(MBlock{head: 0, tail: 0, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    mut m := empty_mir()
    m.fns.push(f)
    << m
}
pub fn mir_operand_probe_front(kind int) []bool {
    m := mir_operand_probe(kind)
    f := mir_cfg_clone_fn(&m, 0, true)
    mut out := []bool{}
    for t in 0:224 { out.push(mir_instr_uses_temp(&f, 0, t)) }
    << out
}
pub fn mir_operand_probe_verify(kind int) []bool {
    m := mir_operand_probe(kind)
    f := mir_cfg_clone_fn(&m, 0, true)
    mut out := []bool{}
    for t in 0:224 { out.push(mir_verify_instr_uses_temp(&f, 0, t)) }
    << out
}
pub fn mir_operand_probe_counts(kind int, delta int) []int {
    m := mir_operand_probe(kind)
    f := mir_cfg_clone_fn(&m, 0, true)
    mut out := []int{}
    for _ in 0:224 { out.push(0) }
    mir_dce_instr_uses(&f, 0, mut &out, delta)
    << out
}
pub fn mir_operand_probe_reversible(kind int) bool {
    m := mir_operand_probe(kind)
    f := mir_cfg_clone_fn(&m, 0, true)
    mut out := []int{}
    for _ in 0:224 { out.push(0) }
    mir_dce_instr_uses(&f, 0, mut &out, 1)
    mir_dce_instr_uses(&f, 0, mut &out, -1)
    for t in 0:224 { if out[t] != 0 { << false } }
    << true
}
pub fn mir_operand_edge_probe(mode int) Mir {
    mut f := mir_fn_blank()
    for _ in 0:8 { f.temps.push(1)
        f.temps_nslots.push(1) }
    f.consts.push(73)
    mut count := 8
    if mode == 6 { count = 4096 }
    if mode == 7 { count = 4097 }
    for i in 0:count {
        mut value := 2
        if mode == 1 { value = -2 }
        mut next := i + 1
        if i == count - 1 { next = -1 }
        if mode <= 1 && i == 6 { next = -1 }
        if mode == 5 && i == 4 { next = 3 }
        if mode == 8 && i == 3 { next = 30 }
        f.margs.push(MArg{v: value, next: next})
    }
    mut ins := mkinstr(mi_call)
    ins.a = 0
    ins.b = 1
    ins.c = 3
    if mode == 0 || mode == 1 { ins.kind = mi_arr_push4
        ins.b = 3
        ins.c = 1 }
    if mode == 2 { ins.c = -1 }
    if mode == 3 { ins.c = -2 }
    if mode == 4 { ins.c = 30 }
    if mode == 6 || mode == 7 { ins.c = 0 }
    if mode >= 9 { ins.kind = mi_addr
        ins.b = 2
        ins.c = mode - 9 }
    f.instrs.push(ins)
    f.blocks.push(MBlock{head: 0, tail: 0, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    mut m := empty_mir()
    m.fns.push(f)
    << m
}
pub fn mir_operand_edge_front(m &Mir, verify bool) []bool {
    f := mir_cfg_clone_fn(m, 0, true)
    mut out := []bool{}
    for t in 0:8 {
        mut used := mir_instr_uses_temp(&f, 0, t)
        if verify { used = mir_verify_instr_uses_temp(&f, 0, t) }
        out.push(used)
    }
    << out
}
pub fn mir_operand_edge_counts(m &Mir, delta int) []int {
    f := mir_cfg_clone_fn(m, 0, true)
    mut out := []int{}
    for _ in 0:8 { out.push(0) }
    mir_dce_instr_uses(&f, 0, mut &out, delta)
    << out
}
pub fn mir_operand_edge_reversible(m &Mir) bool {
    f := mir_cfg_clone_fn(m, 0, true)
    mut out := []int{}
    for _ in 0:8 { out.push(0) }
    mir_dce_instr_uses(&f, 0, mut &out, 1)
    mir_dce_instr_uses(&f, 0, mut &out, -1)
    for t in 0:8 { if out[t] != 0 { << false } }
    << true
}
pub fn mir_operand_box_dce_probe(stage int) int {
    mut f := mir_fn_blank()
    f.ret = any_ty
    f.ret_nslots = 2
    f.temps.push(1)
    f.temps_nslots.push(1)
    f.temps.push(any_ty)
    f.temps_nslots.push(2)
    f.consts.push(42)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: 1, tb: -1, tc: -1, line: 0})
    mir_reduce_safety_instr(mut &f, 0, 1, 0, -2, 0, 0)
    mir_reduce_safety_instr(mut &f, 0, 44, 1, 0, any_tag_int, 1)
    if stage == 0 { << mir_verify_mfn_f(&f, true) }
    changed := mir_dce_pure(mut &f)
    if stage == 1 { if changed { << 1 }
        << 0 }
    << mir_verify_mfn_f(&f, true)
}
