@xu/types

#xu/parser

// Strong clone for names handed across the driver -> Checker -> MIR boundary.
// Empty-string concatenation is not an ownership boundary in hosted Gen1.
fn mir_test_name_owned(names &[]string, i int) string {
    mut out := []int{}
    for j in 0:names[i].len { out.push(names[i][j]) }
    << string_from_bytes(out)
}

fn mir_test_append_main(m &mut Mir, f MFn) {
    // The source main is dead in test mode. Retire it without freeing its
    // storage; this preserves the append-only MFn ownership invariant.
    for fi in 0:m.fns.len {
        if !mir_fn_is_extern(&*m, fi) && m.fns[fi].name == "main" {
            mfn_set_i(mut &m.superseded, fi, 1)
        }
    }
    mut owned := f
    mir_fn_facts_fill_f(mut &owned)
    m.fns.push(owned)
    m.superseded.push(0)
}

// Keep the owning harness MFn in the caller while this helper only appends
// scalar MIR pieces. This avoids the hosted compiler's large-frame/sret bug.
fn mir_test_emit_one(c &Checker, m &mut Mir, f &mut MFn, names &[]string, ni int, verbose bool, summary_bb int) {
    rcur := f.new_temp(1, 1)
    mut lr := mkinstr(mi_load_local)
    lr.a = rcur
    lr.b = 2
    f.emit(lr)
    rinc := f.new_temp(1, 1)
    mut ar := mkinstr(mi_bin)
    ar.a = rinc
    ar.b = 1
    ar.c = rcur
    ar.d = f.vconst(1)
    f.emit(ar)
    mut sr := mkinstr(mi_store_local)
    sr.a = 2
    sr.b = rinc
    f.emit(sr)

    m.strings.push(names[ni] + " ... ")
    st := f.new_temp(3, 3)
    mut sc := mkinstr(mi_str_const)
    sc.a = st
    sc.b = m.strings.len - 1
    f.emit(sc)
    pi := f.margs.len
    f.margs.push(MArg{v: st, next: -1})
    mut pn := mkinstr(mi_call)
    pn.a = -1
    pn.b = 30
    pn.c = pi
    f.emit(pn)

    mut t0 := -1
    if verbose {
        t0 = f.new_temp(1, 1)
        mut nw := mkinstr(mi_call)
        nw.a = t0
        nw.b = 28
        nw.c = -1
        f.emit(nw)
    }
    mut clr := mkinstr(mi_call)
    clr.a = -1
    clr.b = 119
    clr.c = -1
    f.emit(clr)

    sj := f.new_temp(1, 1)
    mut sjc := mkinstr(mi_call)
    sjc.a = sj
    sjc.b = 31
    sjc.c = -1
    f.emit(sjc)
    succ_bb := f.new_block()
    notok_bb := f.new_block()
    skip_bb := f.new_block()
    fail_bb := f.new_block()
    ok_bb := f.new_block()
    next_bb := f.new_block()
    f.terminate(2, sj, notok_bb, succ_bb)

    f.switch_to(notok_bb)
    eq2 := f.new_temp(2, 1)
    mut eq := mkinstr(mi_bin)
    eq.a = eq2
    eq.b = 6
    eq.c = sj
    eq.d = f.vconst(2)
    f.emit(eq)
    f.terminate(2, eq2, skip_bb, fail_bb)

    f.switch_to(succ_bb)
    mut found := false
    mut call_label := ""
    for fi in 0:m.fns.len {
        if !mir_fn_is_extern(&*m, fi) && m.fns[fi].name == names[ni] {
            call_label = mir_cfg_clone_label_owned(&*m, fi)
            found = true
        }
    }
    if !found {
        eprintln("test function '" + names[ni] + "' not found in MIR")
        <<< 1
    }
    mut tc := mkinstr(mi_call)
    tc.a = -1
    tc.b = 1
    tc.c = -1
    tc.sval = call_label
    f.emit(tc)
    flags := f.new_temp(1, 1)
    mut fc := mkinstr(mi_call)
    fc.a = flags
    fc.b = 118
    fc.c = -1
    f.emit(fc)
    f.terminate(2, flags, fail_bb, ok_bb)

    f.switch_to(ok_bb)
    mut report_v := f.vconst(-2)
    if verbose {
        t1 := f.new_temp(1, 1)
        mut nw2 := mkinstr(mi_call)
        nw2.a = t1
        nw2.b = 28
        nw2.c = -1
        f.emit(nw2)
        report_v = f.new_temp(1, 1)
        mut sub := mkinstr(mi_bin)
        sub.a = report_v
        sub.b = 2
        sub.c = t1
        sub.d = t0
        f.emit(sub)
    }
    oi := f.margs.len
    f.margs.push(MArg{v: report_v, next: -1})
    mut okr := mkinstr(mi_call)
    okr.a = -1
    okr.b = 32
    okr.c = oi
    f.emit(okr)
    f.terminate(1, next_bb, -1, -1)

    f.switch_to(skip_bb)
    si := f.margs.len
    skip_report := f.vconst(-3)
    f.margs.push(MArg{v: skip_report, next: -1})
    mut skr := mkinstr(mi_call)
    skr.a = -1
    skr.b = 32
    skr.c = si
    f.emit(skr)
    scur := f.new_temp(1, 1)
    mut ls := mkinstr(mi_load_local)
    ls.a = scur
    ls.b = 1
    f.emit(ls)
    sinc := f.new_temp(1, 1)
    mut asi := mkinstr(mi_bin)
    asi.a = sinc
    asi.b = 1
    asi.c = scur
    asi.d = f.vconst(1)
    f.emit(asi)
    mut ss := mkinstr(mi_store_local)
    ss.a = 1
    ss.b = sinc
    f.emit(ss)
    f.terminate(1, next_bb, -1, -1)

    f.switch_to(fail_bb)
    fiarg := f.margs.len
    fail_report := f.vconst(-1)
    f.margs.push(MArg{v: fail_report, next: -1})
    mut far := mkinstr(mi_call)
    far.a = -1
    far.b = 32
    far.c = fiarg
    f.emit(far)
    fcur := f.new_temp(1, 1)
    mut lf := mkinstr(mi_load_local)
    lf.a = fcur
    lf.b = 0
    f.emit(lf)
    finc := f.new_temp(1, 1)
    mut afi := mkinstr(mi_bin)
    afi.a = finc
    afi.b = 1
    afi.c = fcur
    afi.d = f.vconst(1)
    f.emit(afi)
    mut sf := mkinstr(mi_store_local)
    sf.a = 0
    sf.b = finc
    f.emit(sf)
    mut fail_to := next_bb
    if c.test_failfast != 0 { fail_to = summary_bb }
    f.terminate(1, fail_to, -1, -1)
    f.switch_to(next_bb)
}

fn mir_test_emit_summary(f &mut MFn, summary_bb int) {
    f.terminate(1, summary_bb, -1, -1)
    f.switch_to(summary_bb)
    run_t := f.new_temp(1, 1)
    mut lrun := mkinstr(mi_load_local)
    lrun.a = run_t
    lrun.b = 2
    f.emit(lrun)
    fails_t := f.new_temp(1, 1)
    mut lfail := mkinstr(mi_load_local)
    lfail.a = fails_t
    lfail.b = 0
    f.emit(lfail)
    skips_t := f.new_temp(1, 1)
    mut lskip := mkinstr(mi_load_local)
    lskip.a = skips_t
    lskip.b = 1
    f.emit(lskip)
    pass0 := f.new_temp(1, 1)
    mut sp0 := mkinstr(mi_bin)
    sp0.a = pass0
    sp0.b = 2
    sp0.c = run_t
    sp0.d = fails_t
    f.emit(sp0)
    pass_t := f.new_temp(1, 1)
    mut sp1 := mkinstr(mi_bin)
    sp1.a = pass_t
    sp1.b = 2
    sp1.c = pass0
    sp1.d = skips_t
    f.emit(sp1)
    ai := f.margs.len
    f.margs.push(MArg{v: pass_t, next: ai + 1})
    f.margs.push(MArg{v: run_t, next: -1})
    mut sm := mkinstr(mi_call)
    sm.a = -1
    sm.b = 33
    sm.c = ai
    f.emit(sm)

    gt := f.new_temp(2, 1)
    mut gg := mkinstr(mi_bin)
    gg.a = gt
    gg.b = 10
    gg.c = fails_t
    gg.d = f.vconst(0)
    f.emit(gg)
    ret1 := f.new_block()
    ret0 := f.new_block()
    f.terminate(2, gt, ret1, ret0)
    f.switch_to(ret1)
    one := f.vconst(1)
    f.terminate(3, one, -1, -1)
    f.switch_to(ret0)
    zero := f.vconst(0)
    f.terminate(3, zero, -1, -1)
}

// Generate the test harness main after normal MIR optimization. Call kinds:
// 30 print-name, 31 setjmp, 32 report, 33 summary, 118 flags, 119 clear.
pub fn (c &mut Checker) inject_test_harness_mir(m &mut Mir, p &parser.Parser, names []string, filter string, verbose bool) {
    mut matched := []int{}
    for i in 0:names.len {
        mut ok := filter.len == 0
        if !ok && names[i].len >= filter.len {
            ok = true
            for j in 0:filter.len {
                if names[i][j] != filter[j] { ok = false }
            }
        }
        if ok { matched.push(i) }
    }
    if matched.len == 0 {
        c.set_cur_file(p, 0)
        eprintln(c.cur_file_name + ":no test functions match -run pattern '" + filter + "'")
        <<< 1
    }

    mut f := MFn{
        name: "main", label: "_xu_main", ret: 1, ret_nslots: 1,
        nparams: 0, receiver: false, receiver_mut: false, is_extern: false,
        locals: [1, 1, 1], locals_nslots: [1, 1, 1],
        locals_owning: [false, false, false],
        temps: []int{}, temps_nslots: []int{}, instrs: []MInstr{},
        margs: []MArg{}, phis: []MPhi{}, phi_args: []MPhiArg{}, blocks: []MBlock{}, consts: []int{},
        cur: 0, dead: false, scope_ids: []int{}, scopes: []int{},
        scount: []int{}, moved: [false, false, false], fcons: [0, 0, 0], lit_hold: -1, alias_on: false, alias_node: 0, alias_hit: false,
        loop_break: []int{}, loop_cont: []int{}, loop_scope_depth: []int{}, file: 0, src_fi: -1,
        cur_line: 0, induct_var: []int{}, induct_arr: []int{},
        ea_arr: []int{}, ea_ilocal: []int{}, ea_iconst: []int{},
        ea_nc: []int{}, ea_ptr: []int{},
        sdesc_lid: []int{}, sdesc_temp: []int{}, opt_level: m.opt_level,
        facts_gen: 0, facts_bits: 0, facts_nins: 0, facts_nblocks: 0
    }
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 0, ta: -1, tb: -1, tc: -1, line: 0})

    if c.test_list != 0 {
        for mi in 0:matched.len {
            ni := matched[mi]
            m.strings.push(mir_test_name_owned(&names, ni))
            st := f.new_temp(3, 3)
            mut sc := mkinstr(mi_str_const)
            sc.a = st
            sc.b = m.strings.len - 1
            f.emit(sc)
            ai := f.margs.len
            f.margs.push(MArg{v: st, next: -1})
            mut pn := mkinstr(mi_call)
            pn.a = -1
            pn.b = 4
            pn.c = ai
            f.emit(pn)
        }
        ret0 := f.vconst(0)
        f.terminate(3, ret0, -1, -1)
        mir_test_append_main(m, f)
        <<
    }

    // locals: 0=fails, 1=skips, 2=executed.
    for loc in 0:3 {
        mut z := mkinstr(mi_store_local)
        z.a = loc
        z.b = f.vconst(0)
        f.emit(z)
    }
    summary_bb := f.new_block()
    mut repeat := c.test_count
    if repeat < 1 { repeat = 1 }

    for _ in 0:repeat {
        for mi in 0:matched.len {
            ni := matched[mi]
            mir_test_emit_one(&*c, m, mut &f, &names, ni, verbose, summary_bb)
        }
    }
    mir_test_emit_summary(mut &f, summary_bb)
    mir_test_append_main(m, f)
}


// Build MIR directly so CFG simplification and inlining cannot hide an
// unsafe admission. This calls the production pass on its actual IR seam.
// 0 distinct constants; 1 dynamic indices; 2 equal constant values;
// 3 different strides; 4 RMW only; 5 overlapping read; 6 overlapping write;
// 7 disjoint field read; 8 disjoint field write; 9 unknown read alias;
// 10 aggregate index read; 11 multi-slot overlapping write;
// 12 bypass predecessor; 13 multiply-defined element pointer.
pub fn mir_lism_safety_fixture(mode int) bool {
    mut f := mir_fn_blank()
    for _ in 0:8 {
        f.temps.push(1)
        f.temps_nslots.push(1)
    }
    f.consts.push(0)
    f.consts.push(1)
    f.consts.push(0)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 7, tb: 1, tc: 2, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    mut array := mkinstr(mi_load_local)
    array.a = 0
    array.b = 0
    mir_cfg_append(mut &f, 0, array)
    mut ea := mkinstr(mi_elem_addr)
    ea.a = 1
    ea.b = 0
    ea.c = -2
    ea.d = 16
    if mode == 1 { ea.c = 3 }
    mir_cfg_append(mut &f, 0, ea)
    mut eb := mkinstr(mi_elem_addr)
    eb.a = 2
    eb.b = 0
    eb.c = -3
    eb.d = 16
    if mode == 1 { eb.c = 4 }
    if mode == 2 { eb.c = -4 }
    if mode == 3 { eb.d = 8 }
    if mode < 4 {
        mir_cfg_append(mut &f, 0, eb)
        << mir_lism_ptrs_disjoint(&f, 1, 2)
    }
    if mode == 13 {
        // A second definition means the ElemAddr provenance is ambiguous.
        mut cp := mkinstr(mi_copy)
        cp.a = 1
        cp.b = 2
        mir_cfg_append(mut &f, 0, cp)
        mir_cfg_append(mut &f, 0, eb)
        << mir_lism_ptrs_disjoint(&f, 1, 2)
    }
    if mode == 12 {
        // The predecessor may bypass the loop: no speculative memory load.
        mut pre := f.blocks[0]
        pre.tkind = 2
        pre.ta = 7
        pre.tb = 1
        pre.tc = 2
        mfn_set_block(mut &f.blocks, 0, pre)
    }
    mut rmw := mkinstr(mi_field_rmw)
    rmw.a = 1
    rmw.b = 1
    rmw.c = -3
    rmw.d = 1
    rmw.col = 1
    rmw.line = 0
    if mode == 11 { rmw.line = 8 }
    mir_cfg_append(mut &f, 1, rmw)
    if mode >= 5 && mode <= 11 {
        mut touch := mkinstr(mi_load_buf_ptr)
        touch.a = 5
        touch.b = 1
        touch.c = 0
        touch.d = 1
        if mode == 6 {
            touch.kind = mi_store_buf_ptr
            touch.a = -3
        }
        if mode == 7 { touch.c = 8 }
        if mode == 8 {
            touch.kind = mi_store_buf_ptr
            touch.a = -3
            touch.c = 8
        }
        if mode == 9 { touch.b = 2 }
        if mode == 10 {
            touch.kind = mi_load_index
            touch.b = 0
            touch.c = -2
            touch.d = 16
        }
        if mode == 11 {
            touch.kind = mi_store_buf_ptr
            touch.a = -3
            touch.c = 0
            touch.d = 2
        }
        mir_cfg_append(mut &f, 1, touch)
    }
    mut m := empty_mir()
    << mir_lism_self_loops(&m, mut &f)
}

// Exercise the entry invariant proof on live MIR before an optimizer can
// erase escapes or additional writes. Mode 0 admits the named target;
// modes 1..9 must reject the stronger entry invariant; mode 10 has a
// single initialization whose dynamic result does not prove a target.
fn mir_fnval_safety_store(f &mut MFn, bi int) {
    mut store := mkinstr(mi_store_local)
    store.a = 0
    store.b = 0
    mir_cfg_append(f, bi, store)
}

pub fn mir_fnval_invariant_safety_fixture(mode int) bool {
    mut f := mir_fn_blank()
    f.locals.push(700)
    f.locals_nslots.push(2)
    f.locals_owning.push(false)
    f.temps.push(700)
    f.temps_nslots.push(2)
    for _ in 0:3 {
        f.temps.push(1)
        f.temps_nslots.push(1)
    }
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 1, ta: 1, tb: -1, tc: -1, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 2, tb: 1, tc: 2, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    mut init := mkinstr(mi_load_fn_addr)
    init.a = 0
    init.sval = "_xu_fnval_safety_target"
    if mode == 10 {
        init.kind = mi_call
        init.b = 1
        init.c = -1
        init.sval = "_xu_dynamic_target"
    }
    mir_cfg_append(mut &f, 0, init)
    if mode != 3 && mode != 9 { mir_fnval_safety_store(mut &f, 0) }
    if mode == 3 { mir_fnval_safety_store(mut &f, 1) }
    mut addr := mkinstr(mi_addr)
    addr.a = 1
    addr.b = 0
    addr.c = 0
    mut query_bi := 1
    if mode == 9 { query_bi = 0 }
    query := f.instrs.len
    mir_cfg_append(mut &f, query_bi, addr)
    if mode == 9 { mir_fnval_safety_store(mut &f, 0) }
    f.margs.push(MArg{v: 1, next: -1})
    mut call := mkinstr(mi_call)
    call.a = 2
    call.b = 80
    call.c = 0
    mir_cfg_append(mut &f, 1, call)
    if mode == 1 { mir_fnval_safety_store(mut &f, 1) }
    if mode == 2 { f.blocks[1].tc = 0 }
    if mode == 4 {
        mut drop := mkinstr(mi_drop)
        drop.a = 0
        mir_cfg_append(mut &f, 1, drop)
    }
    if mode == 5 || mode == 7 {
        mut copy := mkinstr(mi_copy)
        copy.a = 3
        copy.b = 1
        if mode == 7 {
            copy.a = 1
            copy.b = 3
        }
        mir_cfg_append(mut &f, 1, copy)
    }
    if mode == 6 {
        f.margs[0].next = 1
        f.margs.push(MArg{v: 1, next: -1})
    }
    if mode == 8 { f.nparams = 1 }
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    if mode == 0 || mode == 10 {
        << mir_fnval_known_label(&m, 0, 1, query + 1, 1).len > 0
    }
    << mir_fnval_invariant_entry_store(&m, 0, query_bi, query, 0) >= 0
}

fn mir_reduce_safety_instr(f &mut MFn, bi int, k int, a int, b int, c int, d int) {
    mut ins := mkinstr(k)
    ins.a = a
    ins.b = b
    ins.c = c
    ins.d = d
    mir_cfg_append(f, bi, ins)
}

// Mode 0 is the complete masked + constant recurrence. The remaining
// modes retain extra effects, uncertain entries or escaping temporaries.
// Call the production proof directly so earlier passes cannot hide them.
pub fn mir_reduce_safety_fixture(mode int) bool {
    mut f := mir_fn_blank()
    for _ in 0:3 {
        f.locals.push(1)
        f.locals_nslots.push(1)
        f.locals_owning.push(false)
    }
    for _ in 0:12 {
        f.temps.push(1)
        f.temps_nslots.push(1)
    }
    f.temps[1] = 2
    f.temps[10] = 2
    f.consts.push(1)
    f.consts.push(15)
    f.consts.push(7)
    f.consts.push(35)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 1, tb: 1, tc: 2, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 2, ta: 10, tb: 1, tc: 2, line: 0})
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    mir_reduce_safety_instr(mut &f, 0, 2, 0, 0, 0, 0)
    mut guard_limit := -5
    if mode == 10 { guard_limit = -3 }
    mir_reduce_safety_instr(mut &f, 0, 4, 1, 8, 0, guard_limit)
    if mode == 8 { mir_reduce_safety_instr(mut &f, 0, 3, 0, -2, 0, 0) }
    mir_reduce_safety_instr(mut &f, 1, 2, 2, 0, 0, 0)
    mir_reduce_safety_instr(mut &f, 1, 4, 3, 14, 2, -3)
    mir_reduce_safety_instr(mut &f, 1, 4, 4, 1, 3, -4)
    mir_reduce_safety_instr(mut &f, 1, 2, 5, 1, 0, 0)
    mut addend := 4
    if mode == 9 { addend = 2 }
    mir_reduce_safety_instr(mut &f, 1, 4, 6, 1, 5, addend)
    mir_reduce_safety_instr(mut &f, 1, 3, 1, 6, 0, 0)
    mir_reduce_safety_instr(mut &f, 1, 2, 7, 0, 0, 0)
    mir_reduce_safety_instr(mut &f, 1, 4, 8, 1, 7, -2)
    mir_reduce_safety_instr(mut &f, 1, 3, 0, 8, 0, 0)
    mir_reduce_safety_instr(mut &f, 1, 2, 9, 0, 0, 0)
    mut cmp_ind := 9
    if mode == 6 { cmp_ind = 7 }
    mir_reduce_safety_instr(mut &f, 1, 4, 10, 8, cmp_ind, -5)
    if mode == 1 { mir_reduce_safety_instr(mut &f, 1, 3, 2, 6, 0, 0) }
    if mode == 2 {
        f.blocks[0].tkind = 1
        f.blocks[0].ta = 1
    }
    if mode == 3 {
        f.blocks[0].tb = 2
        f.blocks[0].tc = 1
    }
    if mode == 4 { f.blocks[2].ta = 3 }
    if mode == 5 { mir_reduce_safety_instr(mut &f, 2, 1, 3, -2, 0, 0) }
    if mode == 7 { mir_reduce_safety_instr(mut &f, 1, 3, 0, 8, 0, 0) }
    mut m := empty_mir()
    m.fns.push(f)
    m.superseded.push(0)
    << mir_iand_body_proved(&m, 0, 1, 0, 1, 15, 7, 35)
}

// Direct proof tests run before any ordinary optimizer could simplify the
// address, call or redefinition that is meant to prevent local-load reuse.
pub fn mir_cse_memory_safety_fixture(mode int) bool {
    mut f := mir_fn_blank()
    f.locals.push(1)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    for _ in 0:5 {
        f.temps.push(1)
        f.temps_nslots.push(1)
    }
    f.temps[0] = 200
    f.temps_nslots[0] = 3
