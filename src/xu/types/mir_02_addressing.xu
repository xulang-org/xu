@xu/types

#xu/ast
#xu/parser

fn (f &mut MFn) lower_addr(p &parser.Parser, c &mut Checker, n int) int {
    if p.nodes[n].kind == ast.NK_IDENT { // Ident
        // Module const: materialize the value in a temp first (mirrors
        // bootstrap "other expressions through their temp" — consts have no
        // frame slot; nlocal is -1 here and must not index f.locals).
        if c.nconst[n] >= 0 {
            v := f.lower_expr(p, c, n)
            t := f.new_temp(1, 1)
            mut ad := mkinstr(MI_ADDR)
            ad.a = t
            ad.b = v
            ad.c = 1
            f.emit(ad)
            << t
        }
        lid := c.nlocal[n]
        if lid < 0 {
            // Bare fn value / other non-local ident: materialize first, then
            // &temp (mirrors nconst path — no frame slot to AddrLocal).
            v := f.lower_expr(p, c, n)
            t := f.new_temp(1, 1)
            mut ad0 := mkinstr(MI_ADDR)
            ad0.a = t
            ad0.b = v
            ad0.c = 1
            f.emit(ad0)
            << t
        }
        if (f.receiver && lid == 0) || is_ref_type(f.locals[lid]) {
            t := f.new_temp(1, 1)
            mut li := mkinstr(MI_LOAD_LOCAL)
            li.a = t
            li.b = lid
            f.emit(li)
            << t
        }
        mut pty := 1
        if lid >= 0 && lid < f.locals.len {
            lty := f.locals[lid]
            if lty > 0 && !is_ref_type(lty) {
                pty = c.make_ref_type(true, lty)
            }
        }
        t := f.new_temp(pty, 1)
        mut ad := mkinstr(MI_ADDR)
        ad.a = t
        ad.b = lid
        ad.c = 0
        f.emit(ad)
        << t
    }
    if p.nodes[n].kind == ast.NK_FIELD { // Field
        obj := p.nodes[n].a
        base := f.lower_addr(p, c, obj)
        oty := c.direct_type(c.ntype[obj])
        si := struct_index(oty)
        field_index := c.nlocal[n]
        slot := c.structs[si].fields[field_index].slot
        mut field_loc := base
        w := slot / 8
        r := slot % 8
        if w != 0 {
            t := f.new_temp(1, 1)
            mut add := mkinstr(MI_BIN)
            add.a = t
            add.b = 2 // Sub
            add.c = field_loc
            add.d = f.vconst(w * 8)
            f.emit(add)
            field_loc = t
        }
        if r != 0 {
            t2 := f.new_temp(1, 1)
            mut add2 := mkinstr(MI_BIN)
            add2.a = t2
            add2.b = 1 // Add remainder within the word
            add2.c = field_loc
            add2.d = f.vconst(r)
            f.emit(add2)
            field_loc = t2
        }
        << field_loc
    }
    v := f.lower_expr(p, c, n)
    t := f.new_temp(1, 1)
    mut ad := mkinstr(MI_ADDR)
    ad.a = t
    ad.b = v
    ad.c = 1
    f.emit(ad)
    << t
}

// Does the lvalue chain contain an Index step? If so, every Field step at
// or above it operates on a BUFFER address (words ascend, +8k); the steps
// below it are frame addresses (words descend, -8k).
fn chain_has_index(p &parser.Parser, n int) bool {
    if n < 0 { << false }
    if p.nodes[n].kind == ast.NK_INDEX { << true }
    if p.nodes[n].kind == ast.NK_FIELD { << chain_has_index(p, p.nodes[n].a) }
    << false
}

// Field-of-Index layout: `[N]T` and `&mut [N]T` / `&[N]T` live as a
// descending frame blob (ElemAddr scale_sub, LoadPtr -off). `[]T` and
// `&mut []T` / `&[]T` are heap descriptors (scale_add, LoadBufPtr +off).
// Use the Index operand's ntype — Checker.ltype is the last function.
fn (f &MFn) chain_index_is_buf(p &parser.Parser, c &Checker, n int) bool {
    mut s := n
    while s >= 0 {
        if p.nodes[s].kind == ast.NK_INDEX {
            arr := p.nodes[s].a
            if arr < 0 { << true }
            if c.array_fixed_len(c.direct_type(c.ntype[arr])) > 0 { << false }
            << true
        }
        if p.nodes[s].kind == ast.NK_FIELD {
            s = p.nodes[s].a
            ->
        }
        << true
    }
    << true
}

fn (f &mut MFn) addr_of_local(lid int) int {
    mut ty := 1
    if lid >= 0 && lid < f.locals.len {
        lty := f.locals[lid]
        if is_array_type(lty) {
            ty = lty
        }
    }
    t := f.new_temp(ty, 1)
    mut ad := mkinstr(MI_ADDR)
    ad.a = t
    ad.b = lid
    ad.c = 0
    f.emit(ad)
    << t
}

fn (f &mut MFn) addr_of_temp(v int) int {
    mut ty := 1
    if v >= 0 && v < f.temps.len {
        tty := f.temps[v]
        if is_array_type(tty) {
            ty = tty
        }
    }
    t := f.new_temp(ty, 1)
    mut ad := mkinstr(MI_ADDR)
    ad.a = t
    ad.b = v
    ad.c = 1
    f.emit(ad)
    << t
}

fn (f &mut MFn) load_local_word(lid int) int {
    mut ty := 1
    if lid >= 0 && lid < f.locals.len {
        lty := f.locals[lid]
        if is_ref_type(lty) {
            ty = lty
        }
    }
    t := f.new_temp(ty, 1)
    mut li := mkinstr(MI_LOAD_LOCAL)
    li.a = t
    li.b = lid
    f.emit(li)
    << t
}

fn (f &mut MFn) load_slice_desc(p &parser.Parser, c &mut Checker, arr int, ptr int, aty int) int {
    desc := f.new_temp(aty, 3)
    mut lp := mkinstr(MI_LOAD_PTR)
    if f.ref_expr_is_buf(p, &*c, arr, 0) {
        lp.kind = MI_LOAD_BUF_PTR
    }
    lp.a = desc
    lp.b = ptr
    lp.c = 0
    lp.d = 3
    f.emit(lp)
    << desc
}

// Address or descriptor consumed by LoadIndex / StoreIndex / ElemAddr.
// `[N]T` → &blob; `&mut [N]T` → the data pointer; `[]T` → 3-word desc.
fn (f &mut MFn) lower_index_base(p &parser.Parser, c &mut Checker, arr int) int {
    raw := c.ntype[arr]
    aty := c.direct_type(raw)
    fl := c.array_fixed_len_m(aty)
    if p.nodes[arr].kind == ast.NK_IDENT {
        lid := c.nlocal[arr]
        if lid >= 0 && lid < f.locals.len {
            lty := f.locals[lid]
            if is_ref_type(lty) || (f.receiver && lid == 0) {
                ptr := f.load_local_word(lid)
                if fl == 0 && is_ref_type(raw) {
                    << f.load_slice_desc(p, c, arr, ptr, aty)
                }
                << ptr
            }
            if fl > 0 {
                << f.addr_of_local(lid)
            }
            if fl == 0 && !is_ref_type(raw) && is_array_type(aty) {
                key0 := (lid + 10000) * 1000 + 1
                key_cur := -(f.cur * 1000000 + key0)
                for i in 0:f.sdesc_lid.len {
                    k := f.sdesc_lid[i]
                    if k == key0 || (f.cur != 0 && k == key_cur) {
                        << f.sdesc_temp[i]
                    }
                }
                mut base := f.lower_expr(p, c, arr)
                if f.cur == 0 {
                    f.sdesc_lid.push(key0)
                    f.sdesc_temp.push(base)
                } else {
                    f.sdesc_lid.push(key_cur)
                    f.sdesc_temp.push(base)
                }
                << base
            }
        }
    }
    if p.nodes[arr].kind == ast.NK_FIELD {
        obj := p.nodes[arr].a
        if p.nodes[obj].kind == ast.NK_IDENT {
            lid := c.nlocal[obj]
            if lid >= 0 && lid < f.locals.len {
                lty := f.locals[lid]
                if is_ref_type(lty) || (f.receiver && lid == 0) {
                    if fl == 0 && !is_ref_type(raw) && is_array_type(aty) {
                        fi := c.nlocal[arr]
                        key0 := lid * 1000 + fi + 1
                        key_cur := -(f.cur * 1000000 + key0)
                        for i in 0:f.sdesc_lid.len {
                            k := f.sdesc_lid[i]
                            if k == key0 || (f.cur != 0 && k == key_cur) {
                                << f.sdesc_temp[i]
                            }
                        }
                        mut base := f.lower_expr(p, c, arr)
                        if f.cur == 0 {
                            f.sdesc_lid.push(key0)
                            f.sdesc_temp.push(base)
                        } else {
                            f.sdesc_lid.push(key_cur)
                            f.sdesc_temp.push(base)
                        }
                        << base
                    }
                }
            }
        }
    }
    mut base := f.lower_expr(p, c, arr)
    if fl > 0 && !is_ref_type(raw) {
        << f.addr_of_temp(base)
    }
    if is_ref_type(raw) && fl == 0 {
        << f.load_slice_desc(p, c, arr, base, aty)
    }
    << base
}

// ForEach borrows named places/references, but owns fresh iterable results.
// Materialize fresh results once in the loop scope, before taking a fixed
// array's address. Do not register until evaluation succeeds: a throwing
// call may clean all scopes before there is a value to drop.
fn (f &mut MFn) lower_foreach_base(p &parser.Parser, c &mut Checker, n int) int {
    ty := c.ntype[n]
    k := p.nodes[n].kind
    fresh := k == ast.NK_CALL || k == ast.NK_METHOD_CALL || k == ast.NK_ARRAY_LIT || k == ast.NK_EMPTY_ARRAY || k == ast.NK_SLICE || k == ast.NK_OR_CATCH
    if is_ref_type(ty) || !c.type_owning(ty) || !fresh {
        << f.lower_index_base(p, c, n)
    }
    value := f.lower_expr(p, c, n)
    lid := f.new_local(ty, c.type_slots(ty), true)
    mut st := mkinstr(MI_STORE_LOCAL)
    st.a = lid
    st.b = value
    f.emit(st)
    f.scope_add(lid)
    if c.array_fixed_len_m(ty) > 0 {
        << f.addr_of_local(lid)
    }
    dest := f.new_temp(ty, c.type_slots(ty))
    mut ld := mkinstr(MI_LOAD_LOCAL)
    ld.a = dest
    ld.b = lid
    f.emit(ld)
    << dest
}

// Address of an lvalue chain for nested field writes (`p.m.v = x`,
// `a[i].v = x`). `buf` selects the layout convention: frame fields descend
// by the slot offset; buffer fields (at/above an Index step) ascend. Index
// steps go through the bounds-checked ElemAddr instruction (kind 23), so no
// unsafe raw pointer is ever produced (mirror bootstrap field_base_of).
fn (f &mut MFn) lower_chain_addr(p &parser.Parser, c &mut Checker, n int, buf bool) int {
    if p.nodes[n].kind == ast.NK_IDENT { // Ident (frame; buf never true here)
        lid := c.nlocal[n]
        if lid < 0 {
            v := f.lower_expr(p, c, n)
            t := f.new_temp(1, 1)
            mut ad0 := mkinstr(MI_ADDR)
            ad0.a = t
            ad0.b = v
            ad0.c = 1
            f.emit(ad0)
            << t
        }
        if (f.receiver && lid == 0) || is_ref_type(f.locals[lid]) {
            t := f.new_temp(1, 1)
            mut li := mkinstr(MI_LOAD_LOCAL)
            li.a = t
            li.b = lid
            f.emit(li)
            << t
        }
        t := f.new_temp(1, 1)
        mut ad := mkinstr(MI_ADDR)
        ad.a = t
        ad.b = lid
        ad.c = 0
        f.emit(ad)
        << t
    }
    if p.nodes[n].kind == ast.NK_FIELD { // Field
        obj := p.nodes[n].a
        base := f.lower_chain_addr(p, c, obj, buf)
        // Auto-deref a reference only when `base` is the *address of* the
        // pointer (frame/buffer). Ident/`&mut` receiver already loaded the
        // pointer (kind 2 LoadLocal); loading again would treat the first
        // field as a pointer (nested_field_write SIGBUS).
        mut base2 := base
        // Ident (4) already yielded the pointer; Field (7) of ref type
        // already loaded it at the end of the recursive call.
        if is_ref_type(c.ntype[obj]) && p.nodes[obj].kind != ast.NK_IDENT && p.nodes[obj].kind != ast.NK_FIELD {
            ptr0 := f.new_temp(1, 1)
            mut lp0 := mkinstr(MI_LOAD_PTR)
            if buf { lp0.kind = 26 }
            lp0.a = ptr0
            lp0.b = base
            lp0.c = 0
            lp0.d = 1
            f.emit(lp0)
            base2 = ptr0
        }
        oty := c.direct_type(c.ntype[obj])
        si := struct_index(oty)
        slot := c.structs[si].fields[c.nlocal[n]].slot
        mut field_loc := base2
        if buf {
            if slot != 0 {
                t := f.new_temp(1, 1)
                mut add := mkinstr(MI_BIN)
                add.a = t
                add.b = 1 // Add: buffer fields ascend by bytes
                add.c = base2
                add.d = f.vconst(slot)
                f.emit(add)
                field_loc = t
            }
        } else {
            w := slot / 8
            r := slot % 8
            if w != 0 {
                t := f.new_temp(1, 1)
                mut add := mkinstr(MI_BIN)
                add.a = t
                add.b = 2
                add.c = field_loc
                add.d = f.vconst(w * 8)
                f.emit(add)
                field_loc = t
            }
            if r != 0 {
                t2 := f.new_temp(1, 1)
                mut add2 := mkinstr(MI_BIN)
                add2.a = t2
                add2.b = 1
                add2.c = field_loc
                add2.d = f.vconst(r)
                f.emit(add2)
                field_loc = t2
            }
        }
        // M161: field expression that *is* `&mut`/`&` — further write-through
        // uses the loaded pointer, not the address of the pointer slot.
        if is_ref_type(c.ntype[n]) {
            ptr := f.new_temp(1, 1)
            mut lp := mkinstr(MI_LOAD_PTR)
            if buf { lp.kind = 26 }
            lp.a = ptr
            lp.b = field_loc
            lp.c = 0
            lp.d = 1
            f.emit(lp)
            << ptr
        }
        << field_loc
    }
    if p.nodes[n].kind == ast.NK_INDEX { // Index — bounds-checked element address
        arr := p.nodes[n].a
        raw_ty := c.ntype[arr]
        aty := c.direct_type(raw_ty)
        idx_node := p.nodes[n].b
        mut arr_l := -1
        if p.nodes[arr].kind == ast.NK_IDENT {
            arr_l = c.nlocal[arr]
        }
        mut idx_loc := -1
        mut idx_c := -1
        mut have_key := false
        if idx_node >= 0 && idx_node < p.nodes.len {
            ik := p.nodes[idx_node].kind
            if ik == ast.NK_IDENT {
                lid := c.nlocal[idx_node]
                if lid >= 0 {
                    idx_loc = lid
                    have_key = true
                }
            } else if ik == ast.NK_INT {
                idx_c = p.nodes[idx_node].ival
                have_key = true
            } else if idx_node < c.nconst.len {
                ci := c.nconst[idx_node]
                if ci >= 0 && ci < c.ctypes.len && c.ctypes[ci] == 1 {
                    idx_c = c.civals[ci]
                    have_key = true
                }
            }
        }
        nc_bool := f.index_nocheck(p, c, arr, idx_node)
        // Share the index layout lowering: inline fixed arrays use their
        // frame address; borrowed fixed arrays already carry that address;
        // dynamic references load the three-word descriptor exactly once.
        base := f.lower_index_base(p, c, arr)
        idx := f.lower_expr(p, c, idx_node)
        ety := c.elem_ty_of_array(aty, f.src_fi)
        elem_bytes := c.type_size_bytes(ety)
        t := f.new_temp(1, 1)
        mut ea := mkinstr(MI_ELEM_ADDR)
        ea.a = t
        ea.b = base
        ea.c = idx
        ea.d = elem_d(elem_bytes, nc_bool)
        fl := c.array_fixed_len_m(aty)
        if fl > 0 {
            ea.col = fl
        }
        f.emit(ea)
        << t
    }
    << f.lower_addr(p, c, n)
}

// Typed shared-reference argument. Borrow lvalues in place; materialized
// expressions get a caller-owned hold that outlives the call. In particular,
// an indexed string read may clone: the borrow must reclaim that clone.
// Convert a borrowed buffer string descriptor to the ordinary Xu frame
// descriptor ABI. Only descriptor words are copied; the payload remains
// owned by the source place and this non-owning hold never drops it.
fn (f &mut MFn) lower_buf_string_borrow(ptr int) int {
    value := f.new_temp(3, 3)
    mut load := mkinstr(MI_LOAD_BUF_PTR)
    load.a = value
    load.b = ptr
    load.c = 0
    load.d = 3
    f.emit(load)
    lid := f.new_local(3, 3, false)
    f.scope_add(lid)
    mut st := mkinstr(MI_STORE_LOCAL)
    st.a = lid
    st.b = value
    f.emit(st)
    << f.addr_of_local(lid)
}

// Find a binding in this function's statement tree. Do not enter
// expression/closure bodies, whose checker local IDs belong to another scope.
fn borrow_immutable_init(p &parser.Parser, c &Checker, head int, lid int, depth int) int {
    if depth > 64 { << -1 }
    mut s := head
    for _ in 0:p.nodes.len {
        if s < 0 { <- }
        k := p.nodes[s].kind
        if k == ast.NK_LET && c.nlocal[s] == lid {
            << p.nodes[s].a
        }
        mut child := -1
        if k == ast.NK_IF || k == ast.NK_SELECT { child = p.nodes[s].a }
        if k == ast.NK_BRANCH { child = p.nodes[s].b }
        if k == ast.NK_MATCH { child = p.nodes[s].b }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE || k == ast.NK_ARM_INT || k == ast.NK_ARM_RANGE || k == ast.NK_ARM_ELSE || k == ast.NK_ARM_ENUM || k == ast.NK_ARM_STR || k == ast.NK_SEL_SEND || k == ast.NK_SEL_RECV {
            child = p.nodes[s].c
        }
        if child >= 0 {
            init := borrow_immutable_init(p, c, child, lid, depth + 1)
            if init >= 0 { << init }
        }
        s = p.nodes[s].next
    }
    << -1
}

fn borrow_local_written(p &parser.Parser, c &Checker, head int, lid int, depth int) bool {
    if depth > 64 { << true }
    mut s := head
    for _ in 0:p.nodes.len {
        if s < 0 { <- }
        k := p.nodes[s].kind
        if k == ast.NK_ASSIGN {
            target := p.nodes[s].a
            if target >= 0 && p.nodes[target].kind == ast.NK_IDENT && c.nlocal[target] == lid { << true }
        }
        mut child := -1
        if k == ast.NK_IF || k == ast.NK_SELECT { child = p.nodes[s].a }
        if k == ast.NK_BRANCH || k == ast.NK_MATCH { child = p.nodes[s].b }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE || k == ast.NK_ARM_INT || k == ast.NK_ARM_RANGE || k == ast.NK_ARM_ELSE || k == ast.NK_ARM_ENUM || k == ast.NK_ARM_STR || k == ast.NK_SEL_SEND || k == ast.NK_SEL_RECV {
            child = p.nodes[s].c
        }
        if child >= 0 && borrow_local_written(p, c, child, lid, depth + 1) { << true }
        s = p.nodes[s].next
    }
    << false
}

// Layout belongs to this lowering function, not Checker.bproj (the final
// borrow-check pass may have cleared a scoped local or checked another fn).
// Resolve explicit places and locals without reassignment through this fn's
// AST. Indexed map/dynamic-array storage ascends; fixed-array/frame storage
// descends. Unknown references use the ordinary frame ABI. Alias recursion
// and statement walks are bounded; mutable/rebound provenance is deferred.
fn (f &MFn) ref_expr_is_buf(p &parser.Parser, c &Checker, n int, depth int) bool {
    if n < 0 || depth > 32 { << false }
    k := p.nodes[n].kind
    if k == ast.NK_BORROW {
        place := p.nodes[n].a
        if place < 0 { << false }
        if p.nodes[place].kind == ast.NK_UN_OP && p.nodes[place].ival == 3 {
            << f.ref_expr_is_buf(p, c, p.nodes[place].a, depth + 1)
        }
        if !chain_has_index(p, place) { << false }
        << f.chain_index_is_buf(p, c, place)
    }
    if k == ast.NK_IDENT && f.src_fi >= 0 && f.src_fi < c.fndecl.len {
        d := c.fndecl[f.src_fi]
        if d >= 0 {
            lid := c.nlocal[n]
            head := p.nodes[d].c
            if borrow_local_written(p, c, head, lid, 0) { << false }
            init := borrow_immutable_init(p, c, head, lid, 0)
            if init >= 0 { << f.ref_expr_is_buf(p, c, init, depth + 1) }
        }
    }
    << false
}

fn (f &MFn) string_ref_is_buf(p &parser.Parser, c &Checker, n int, depth int) bool {
    << f.ref_expr_is_buf(p, c, n, depth)
}

fn (f &mut MFn) lower_borrow_arg(p &parser.Parser, c &mut Checker, n int) int {
    ty := c.ntype[n]
    if is_ref_type(ty) {
        ptr := f.lower_expr(p, c, n)
        if !is_mut_ref_type(ty) && c.direct_type(ty) == 3 && f.string_ref_is_buf(p, &*c, n, 0) {
            << f.lower_buf_string_borrow(ptr)
        }
        << ptr
    }
    indexed := chain_has_index(p, n)
    if ty == 3 && indexed && !c.borrow_chain_is_map(p, n) {
        buf := f.chain_index_is_buf(p, &*c, n)
        ptr := f.lower_chain_addr(p, c, n, buf)
        if buf { << f.lower_buf_string_borrow(ptr) }
        << ptr
    }
    if (p.nodes[n].kind == ast.NK_IDENT || p.nodes[n].kind == ast.NK_FIELD) && !indexed {
        << f.lower_chain_addr(p, c, n, false)
    }
    v := f.lower_expr(p, c, n)
    ns := c.type_slots(ty)
    lid := f.new_local(ty, ns, c.type_owning(ty))
    f.scope_add(lid)
    mut st := mkinstr(MI_STORE_LOCAL)
    st.a = lid
    st.b = v
    f.emit(st)
    << f.addr_of_local(lid)
}

// By-value multi-slot args are passed as a pointer to a descriptor the
// callee shallow-copies into its frame (and may Drop). Ident locals are
// addressed in place (caller mark_move) unless the ident is being boxed
// into any/struct@ (nbox): ntype stays concrete (int=1 slot) so AddrOf
// the local would pass a scalar as a fat pointer (Gen1 `as` SIGSEGV /
// type assert failed). Any other expression — especially Field/Index
// string reads — must be materialized first (string fields clone) so
// the callee free cannot touch the source storage (AST names).
fn (f &mut MFn) lower_pointer_arg(p &parser.Parser, c &mut Checker, n int) int {
    if is_ref_type(c.ntype[n]) { << f.lower_expr(p, c, n) }
    boxed := n >= 0 && n < c.nbox.len && c.nbox[n] != 0
    cloned := n >= 0 && n < c.nclone.len && c.nclone[n] == 1
    // A cloned read keeps the caller's owner alive. Taking its address would
    // hand the same owned allocation to the callee/coroutine without cloning.
    if !boxed && !cloned && p.nodes[n].kind == ast.NK_IDENT { << f.lower_addr(p, c, n) }
    mut v := f.lower_expr(p, c, n)
    if v < 0 {
        mut ns := c.type_slots(c.ntype[n])
        if ns < 1 { ns = 1 }
        tmp := f.new_temp(c.ntype[n], ns)
        mut cp := mkinstr(MI_COPY)
        cp.a = tmp
        cp.b = v
        f.emit(cp)
        v = tmp
    }
    // Index / Call / MethodCall / BinOp (e.g. s+".xu") as by-pointer args:
    // spill into a fresh local, then Addr that local. Matches source-level
    // `hold := roots[ri]+""` — nested Call sibling args otherwise smash
    // temp-backed descriptors under Gen1→Gen2 (load_unit abort).
    // Index: non-owning hold (descriptor aliases the array elem; `+""` clone
    // is not required if the local outlives the callee). Call/BinOp: owning.
    k := p.nodes[n].kind
    if k == ast.NK_CALL || k == ast.NK_METHOD_CALL || k == ast.NK_INDEX || k == ast.NK_BIN_OP {
        mut ns2 := c.type_slots(c.ntype[n])
        if ns2 < 1 { ns2 = 1 }
        if ns2 > 1 {
            mut own := c.type_owning(c.ntype[n])
            if k == ast.NK_INDEX { own = false }
            lid := f.new_local(c.ntype[n], ns2, own)
            mut st := mkinstr(MI_STORE_LOCAL)
            st.a = lid
            st.b = v
            f.emit(st)
            tloc := f.new_temp(1, 1)
            mut ad0 := mkinstr(MI_ADDR)
            ad0.a = tloc
            ad0.b = lid
            ad0.c = 0
            f.emit(ad0)
            << tloc
        }
    }
    t := f.new_temp(1, 1)
    mut ad := mkinstr(MI_ADDR)
    ad.a = t
    ad.b = v
    ad.c = 1
    f.emit(ad)
    << t
}


// ===== lowering =====

// LoadIndex (14) and ElemAddr (23) keep the array in b and the result in a.
// StoreIndex (20) and IndexRMW (47) keep the array in a. Reading a for every
// kind treated a nested slice element as the array and rewrote its stride
// to the inner element size.
fn mir_align_index_base(f &MFn, ii int) int {
    k := mfn_ikind(&f.instrs, ii)
    if k == MI_LOAD_INDEX || k == MI_ELEM_ADDR {
        << mfn_ib(&f.instrs, ii)
    }
    << mfn_ia(&f.instrs, ii)
}

// Rewrite LoadIndex / StoreIndex / ElemAddr / IndexRMW widths to the
// base array's final stride. nocheck keeps the negative sign. A stale
// Param width must not fail the emitter's owning-element check.
fn mir_align_index_widths(f &mut MFn, m &Mir) {
    for ii in 0:f.instrs.len {
        k := mfn_ikind(&f.instrs, ii)
        if k != MI_LOAD_INDEX && k != MI_STORE_INDEX && k != MI_ELEM_ADDR && k != MI_INDEX_RMW {
            ->
        }
        base := mir_align_index_base(&*f, ii)
        mut aty := -1
        if base >= MIR_LOCAL_OPERAND_BASE {
            lid := base - MIR_LOCAL_OPERAND_BASE
            if lid >= 0 && lid < f.locals.len {
                aty = f.locals[lid]
            }
        } else if base >= 0 && base < f.temps.len {
            aty = f.temps[base]
        }
        aty = strip_direct_ref(&m.ref_targets, aty)
        if !is_array_type(aty) { -> }
        ai := array_index(aty)
        if ai < 0 || ai >= m.arrays.len { -> }
        eb := m.arrays[ai].elem_bytes
        if eb <= 0 { -> }
        mut d := mfn_id(&f.instrs, ii)
        mut neg := false
        if d < 0 {
            neg = true
            d = 0 - d
        }
        if d == eb { -> }
        mut nd := eb
        if neg { nd = 0 - eb }
        mfn_set_id(mut &f.instrs, ii, nd)
    }
}

// Monomorphized `[]T`: template AST may still tag elem as Param or a stale
// concrete elem from a prior prepare_instance (shared template body).
fn (c &Checker) elem_ty_of_array(aty int, src_fi int) int {
    ai := array_index(aty)
    if ai < 0 || ai >= c.arrays.len {
        << -1
    }
    ety := c.arrays[ai].elem_ty
    if src_fi >= 0 && src_fi < c.fns.len && c.is_inst[src_fi] != 0 {
        t0 := c.inst_elem_t0(src_fi)
        // Only this instance's []T. Other arrays in the same function
        // (scratch []int) keep their own element size, or StoreIndex's
        // width disagrees with the array record and the emitter aborts.
        if t0 >= 0 && (is_param_type(ety) || ety == t0) {
            << t0
        }
    }
    if is_param_type(ety) && src_fi >= 0 {
        t0 := c.inst_elem_t0(src_fi)
        if t0 >= 0 {
            << t0
        }
    }
    << ety
}

// M154: synthesize trampoline body for bound method values.
// Params: local0 = &Env{self: &T|&mut T}, then user args.
// Body: call real method with env.self as receiver + user args.
fn lower_bound_trampoline(c &mut Checker, fi int) MFn {
    mfi := c.bound_mfi[fi]
    mut param_count := c.fns[fi].params.len
    mut f := MFn{
        name: c.fns[fi].name,
        label: c.fns[fi].label,
        ret: c.fns[fi].ret,
        ret_nslots: c.type_slots(c.fns[fi].ret),
        nparams: param_count,
        receiver: false,
        receiver_mut: false,
        is_extern: c.fns[fi].is_extern,
        is_pub: c.fns[fi].is_pub,
        local_names: []string{},
        locals: []int{},
        locals_nslots: []int{},
        locals_owning: []bool{},
        temps: []int{},
        temps_nslots: []int{},
        instrs: []MInstr{},
        margs: []MArg{},
        phis: []MPhi{},
        phi_args: []MPhiArg{},
        blocks: []MBlock{},
        consts: []int{},
        cur: 0,
        dead: false,
        scope_ids: []int{},
        scopes: []int{},
        scount: []int{},
        moved: []bool{},
        fcons: []int{},
        lit_hold: -1, alias_on: false, alias_node: 0, alias_hit: false,
        loop_break: []int{},
        loop_cont: []int{},
        loop_scope_depth: []int{},
        file: c.fn_file[fi],
        src_fi: fi,
        cur_line: 0, cur_col: 0,
        induct_var: []int{},
        induct_arr: []int{},
        ea_arr: []int{}, ea_ilocal: []int{}, ea_iconst: []int{},
        ea_nc: []int{}, ea_ptr: []int{},
        sdesc_lid: []int{}, sdesc_temp: []int{},
        opt_level: 0,
        facts_gen: 0, facts_bits: 0, facts_nins: 0, facts_nblocks: 0
    }
    mut names := []string{}
    if fi >= 0 && fi < c.fnlocal_names.len {
        for ni in 0:c.fnlocal_names[fi].len { names.push(c.fnlocal_names[fi][ni] + "") }
    }
    for i in 0:c.fnlocals[fi].len {
        if i < names.len { f.local_names.push(names[i] + "") } else { f.local_names.push("local" + str(i)) }
        f.locals.push(c.fnlocals[fi][i])
        f.locals_nslots.push(c.type_slots(c.fnlocals[fi][i]))
        f.locals_owning.push(false)
        f.moved.push(false)
        f.fcons.push(0)
    }
    f.scopes.push(0)
    f.scount.push(0)
    for i in 0:f.nparams {
        f.scope_ids.push(i)
        nn := f.scount[0] + 1
        f.scount[0] = nn
    }
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 0, ta: -1, tb: -1, tc: -1, line: 0})
    env_ptr := f.new_temp(1, 1)
    mut ld := mkinstr(MI_LOAD_LOCAL)
    ld.a = env_ptr
    ld.b = 0
    f.emit(ld)
    recv := f.new_temp(1, 1)
    mut lp := mkinstr(MI_LOAD_PTR)
    lp.a = recv
    lp.b = env_ptr
    lp.c = 0
    lp.d = 1
    f.emit(lp)
    mut args_head := -1
    mut args_last := -1
    mi0 := f.margs.len
    f.margs.push(MArg{v: recv, next: -1})
    args_head = mi0
    args_last = mi0
    for i in 1:f.nparams {
        pty := f.locals[i]
        mut v := -1
        if mir_abi_by_pointer(pty) || is_fn_type(pty) {
            v = f.new_temp(1, 1)
            mut ad := mkinstr(MI_ADDR)
            ad.a = v
            ad.b = i
            ad.c = 0
            f.emit(ad)
        } else {
            v = f.new_temp(pty, c.type_slots(pty))
            mut ll := mkinstr(MI_LOAD_LOCAL)
            ll.a = v
            ll.b = i
            f.emit(ll)
        }
        mi := f.margs.len
        f.margs.push(MArg{v: v, next: -1})
        f.link_marg(args_last, mi)
        args_last = mi
    }
    mut call := mkinstr(MI_CALL)
    call.b = 1
    call.c = args_head
    mut call_label := []int{}
    for i in 0:c.fns[mfi].label.len {
        call_label.push(c.fns[mfi].label[i])
    }
    call.sval = string_from_bytes(call_label)
    ret := c.fns[fi].ret
    mut dest := -1
    if ret != 0 {
        dest = f.new_temp(ret, c.type_slots(ret))
    }
    call.a = dest
    f.emit(call)
    f.terminate(3, dest, -1, -1)
    << f
}

// Lower one function. `d` is its AST decl node; `fi` its Checker index.
fn lower_fn(p &parser.Parser, c &mut Checker, d int, fi int) MFn {
    if d < 0 && fi < c.bound_mfi.len && c.bound_mfi[fi] >= 0 {
        bound := lower_bound_trampoline(c, fi)
        if c.mir_borrow_gate && !mir_borrow_enforce(&bound) { <<< 1 }
        << bound
    }
    c.prepare_lower_fn(fi)
    mut param_count := c.fns[fi].params.len
    if c.fns[fi].recv >= 0 { param_count += 1 }
    mut fn_ret := c.fns[fi].ret
    if fi < c.fn_throw_ty.len && is_throw_type(c.fn_throw_ty[fi]) {
        fn_ret = c.fn_throw_ty[fi]
    }
    mut f := MFn{
        name: c.fns[fi].name,
        label: c.fns[fi].label,
        ret: fn_ret,
        ret_nslots: c.type_slots(fn_ret),
        nparams: param_count,
        receiver: c.fns[fi].recv >= 0,
        receiver_mut: c.fns[fi].recv_mut,
        is_extern: c.fns[fi].is_extern,
        is_pub: c.fns[fi].is_pub,
        local_names: []string{},
        locals: []int{},
        locals_nslots: []int{},
        locals_owning: []bool{},
        temps: []int{},
        temps_nslots: []int{},
        instrs: []MInstr{},
        margs: []MArg{},
        phis: []MPhi{},
        phi_args: []MPhiArg{},
        blocks: []MBlock{},
        consts: []int{},
        cur: 0,
        dead: false,
        scope_ids: []int{},
        scopes: []int{},
        scount: []int{},
        moved: []bool{},
        fcons: []int{},
        lit_hold: -1, alias_on: false, alias_node: 0, alias_hit: false,
        loop_break: []int{},
        loop_cont: []int{},
        loop_scope_depth: []int{},
        file: c.fn_file[fi],
        src_fi: fi,
        cur_line: 0, cur_col: 0,
        induct_var: []int{},
        induct_arr: []int{},
        ea_arr: []int{}, ea_ilocal: []int{}, ea_iconst: []int{},
        ea_nc: []int{}, ea_ptr: []int{},
        sdesc_lid: []int{}, sdesc_temp: []int{},
        opt_level: 0,
        facts_gen: 0, facts_bits: 0, facts_nins: 0, facts_nblocks: 0
    }
    mut names := []string{}
    if fi >= 0 && fi < c.fnlocal_names.len {
        for ni in 0:c.fnlocal_names[fi].len { names.push(c.fnlocal_names[fi][ni] + "") }
    }
    for i in 0:c.fnlocals[fi].len {
        if i < names.len { f.local_names.push(names[i] + "") } else { f.local_names.push("local" + str(i)) }
        f.locals.push(c.fnlocals[fi][i])
        if i == 0 && f.receiver {
            // Every receiver is represented by the caller-provided pointer.
            f.locals_nslots.push(1)
            f.locals_owning.push(false)
        } else {
            f.locals_nslots.push(c.type_slots(c.fnlocals[fi][i]))
            f.locals_owning.push(c.type_owning(c.fnlocals[fi][i]))
        }
        f.moved.push(false)
        f.fcons.push(0)
    }
    // scope 0: params (locals 0..nparams-1), recorded by id
    f.scopes.push(0)
    f.scount.push(0)
    for i in 0:f.nparams {
        f.scope_ids.push(i)
        n := f.scount[0] + 1
        f.scount[0] = n
    }
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 0, ta: -1, tb: -1, tc: -1, line: 0})
    mut s := p.nodes[d].c
    while s >= 0 {
        f.lower_stmt(p, c, s)
        s = p.nodes[s].next
    }
    // A block left unterminated is the natural end of a void function;
    // drop every still-alive owning local before the final <<.
    if f.blocks[f.cur].tkind == 0 {
        if !f.dead {
            f.emit_drops_all()
        }
        f.terminate(3, -1, -1, -1)
    }
    if c.mir_borrow_gate && !mir_borrow_enforce(&f) { <<< 1 }
    << f
}

// M184: assignment lowering — split from lower_stmt (W3).
