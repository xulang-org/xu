@xu/types

// Complete initial-guard/body/latch lower-bound reader. The same bounded
// readonly facts and exact ordered edge interpreter gate every path.
// No emitter, register, bounds, NoTrap, movement or deletion authority.
// Kind-2 field extensions: 34 kind=2; 35 latch; 36 latch LT; 37 initial
// true start; 38 back true start; 39/40 initial/latch false starts;
// 41/42 latch lo kind/id; 43/44 latch hi kind/id; 45/46 initial guard
// operand Values; 47 actual Return Value; 48 descriptor InstrId/-1.
// Fields 1/2 are body, 5 is shared exit join, 17 is initial LT, 21 is
// initial guard. Other first-34 fields retain the kind-1 point meanings.
// Eight chains: entry through guard, two body updates, initial/back true,
// initial/latch false, shared exit through Return. Five role phases:
// body entry, body branch, Return, initial guard branch, latch branch.
// Six edge snapshots: updates, initial true, back true, initial/latch false.
// Latch roles 21/22/25/26 are old body lo/hi/mid/mid+1; they cannot be
// substituted for the newly selected current latch lo/hi roles 1/2.

// Discovery only. Predicate counts and ownership are proved separately.
fn mir_latch_walk(m &Mir, fi int, f &MirValueFacts, start int, entry bool) []int {
    mut out := []int{}
    mut bi := start
    mut steps := 0
    for _ in 0:8 {
        if bi < 0 || bi >= f.nb || !mir_value_facts_reachable(f, bi) { << []int{} }
        for j in 0:out.len { if out[j] == bi { << []int{} } }
        out.push(bi)
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:f.ni {
            if ii == -1 { <- }
            steps += 1
            if steps > 128 { << []int{} }
            ii = mir_inext(m, fi, ii)
        }
        tk := mir_btkind(m, fi, bi)
        if (entry && tk == 2) || (!entry && tk == 3) { << out }
        if tk != 1 { << []int{} }
        bi = mir_bta(m, fi, bi)
    }
    << []int{}
}

fn mir_latch_append_chain(f &MirValueFacts, p &mut MirLoopPlan, chain &[]int, owners &mut []int, owner int) bool {
    for j in 0:chain.len {
        bi := chain[j]
        if bi < 0 || bi >= f.nb || owners[bi] != 0 { << false }
        owners[bi] = owner
        p.blocks.push(bi)
    }
    end := p.blocks.len
    p.starts.push(end)
    << true
}

fn mir_latch_tail(chain &[]int, from int) int {
    if chain.len == 0 { << from }
    << chain[chain.len - 1]
}

fn mir_latch_cfg(m &Mir, fi int, f &MirValueFacts, p &mut MirLoopPlan, body int, latch int) int {
    if body <= 0 || body >= f.nb || latch <= 0 || latch >= f.nb || body == latch { << 4 }
    if mir_btkind(m, fi, body) != 2 || mir_btkind(m, fi, latch) != 2 { << 4 }
    mut entry := mir_latch_walk(m, fi, f, 0, true)
    if entry.len == 0 { << 4 }
    guard := entry[entry.len - 1]
    if guard == body || guard == latch { << 4 }
    mut entry_prefix := mir_loop_chain(m, fi, f, 0, guard, -1, true, false)
    if entry_prefix.len + 1 != entry.len { << 4 }
    if guard == 0 {
        if mir_value_facts_pred_count(f, guard) != 0 { << 4 }
    } else {
        tail := mir_latch_tail(&entry_prefix, -1)
        if mir_value_facts_pred_count(f, guard) != 1 || !mir_scalar_cfg_edge(m, fi, tail, guard) { << 4 }
    }
    ts := mir_btb(m, fi, body)
    fs := mir_btc(m, fi, body)
    initial := mir_btb(m, fi, guard)
    back := mir_btb(m, fi, latch)
    ef := mir_btc(m, fi, guard)
    lf := mir_btc(m, fi, latch)
    if ts == fs || initial == ef || back == lf { << 4 }
    mut tchain := mir_loop_chain(m, fi, f, ts, latch, body, false, false)
    mut fchain := mir_loop_chain(m, fi, f, fs, latch, body, false, false)
    mut ichain := mir_loop_chain(m, fi, f, initial, body, guard, false, false)
    mut bchain := mir_loop_chain(m, fi, f, back, body, latch, false, false)
    if (tchain.len == 0 && ts != latch) || (fchain.len == 0 && fs != latch) || (ichain.len == 0 && initial != body) || (bchain.len == 0 && back != body) { << 4 }
    tt := mir_latch_tail(&tchain, body)
    ft := mir_latch_tail(&fchain, body)
    it := mir_latch_tail(&ichain, guard)
    bt := mir_latch_tail(&bchain, latch)
    if tt == ft || it == bt || mir_value_facts_pred_count(f, body) != 2 || mir_value_facts_pred_count(f, latch) != 2 { << 4 }
    if !mir_scalar_cfg_edge(m, fi, tt, latch) || !mir_scalar_cfg_edge(m, fi, ft, latch) || !mir_scalar_cfg_edge(m, fi, it, body) || !mir_scalar_cfg_edge(m, fi, bt, body) { << 4 }
    mut ew := mir_latch_walk(m, fi, f, ef, false)
    mut lw := mir_latch_walk(m, fi, f, lf, false)
    if ew.len == 0 || lw.len == 0 { << 4 }
    mut join := -1
    mut epos := -1
    mut lpos := -1
    for a in 0:ew.len {
        for b in 0:lw.len {
            if join < 0 && ew[a] == lw[b] { join = ew[a]
                epos = a
                lpos = b }
        }
    }
    if join < 0 || ew.len - epos != lw.len - lpos || mir_value_facts_pred_count(f, join) != 2 { << 4 }
    mut ech := mir_loop_chain(m, fi, f, ef, join, guard, false, false)
    mut lch := mir_loop_chain(m, fi, f, lf, join, latch, false, false)
    if ech.len != epos || lch.len != lpos { << 4 }
    et := mir_latch_tail(&ech, guard)
    lt := mir_latch_tail(&lch, latch)
    if et == lt || !mir_scalar_cfg_edge(m, fi, et, join) || !mir_scalar_cfg_edge(m, fi, lt, join) { << 4 }
    mut common := []int{}
    mut previous := -1
    for j in epos:ew.len {
        bi := ew[j]
        if bi != lw[lpos + j - epos] { << 4 }
        if j != epos && (mir_value_facts_pred_count(f, bi) != 1 || !mir_scalar_cfg_edge(m, fi, previous, bi)) { << 4 }
        common.push(bi)
        previous = bi
    }
    mut owners := []int{}
    for _ in 0:f.nb { owners.push(0) }
    owners[body] = 1
    owners[latch] = 2
    p.starts.push(0)
    if !mir_latch_append_chain(f, p, &entry, mut &owners, 3) { << 4 }
    if !mir_latch_append_chain(f, p, &tchain, mut &owners, 4) { << 4 }
    if !mir_latch_append_chain(f, p, &fchain, mut &owners, 5) { << 4 }
    if !mir_latch_append_chain(f, p, &ichain, mut &owners, 6) { << 4 }
    if !mir_latch_append_chain(f, p, &bchain, mut &owners, 7) { << 4 }
    if !mir_latch_append_chain(f, p, &ech, mut &owners, 8) { << 4 }
    if !mir_latch_append_chain(f, p, &lch, mut &owners, 9) { << 4 }
    if !mir_latch_append_chain(f, p, &common, mut &owners, 10) { << 4 }
    for bi in 0:f.nb { if mir_value_facts_reachable(f, bi) && owners[bi] == 0 { << 4 } }
    p.fields[0] = 0
    p.fields[1] = body
    p.fields[2] = body
    p.fields[3] = ts
    p.fields[4] = fs
    p.fields[5] = join
    p.fields[19] = tt
    p.fields[20] = ft
    p.fields[21] = guard
    p.fields[22] = common[common.len - 1]
    p.fields[23] = 0
    p.fields[34] = 2
    p.fields[35] = latch
    p.fields[37] = initial
    p.fields[38] = back
    p.fields[39] = ef
    p.fields[40] = lf
    p.fields[47] = mir_bta(m, fi, p.fields[22])
    << 0
}

fn mir_latch_set_cell(p &mut MirLoopPlan, at int, cell int) {
    p.fields[at] = 2
    p.fields[at + 1] = cell - p.nl
    if cell < p.nl { p.fields[at] = 1
        p.fields[at + 1] = cell }
}

fn mir_latch_cell(p &MirLoopPlan, at int) int {
    if p.fields[at] == 1 { << p.fields[at + 1] }
    << p.nl + p.fields[at + 1]
}

fn mir_latch_value_origin(m &Mir, fi int, f &MirValueFacts, bi int, before int, value int) MirLoopOrigin {
    mut kind := 2
    if value < 0 { kind = 3 }
    << mir_loop_scalar_origin(m, fi, f, bi, before, kind, value)
}

fn mir_latch_describe(m &Mir, fi int, f &MirValueFacts, p &mut MirLoopPlan) int {
    body := p.fields[2]
    guard := p.fields[21]
    latch := p.fields[35]
    ec := mir_loop_condition(m, fi, f, guard)
    bc := mir_loop_condition(m, fi, f, body)
    lc := mir_loop_condition(m, fi, f, latch)
    if ec < 0 || bc < 0 || lc < 0 { << 6 }
    mut sub := -1
    mut index := -1
    mut desc := -1
    mut ii := mir_bhead(m, fi, body)
    for _ in 0:f.ni {
        if ii == -1 { <- }
        k := mir_ikind(m, fi, ii)
        if k == mi_bin && mir_ib(m, fi, ii) == 2 { if sub >= 0 { << 6 }
            sub = ii }
        if k == mi_load_index { if index >= 0 { << 6 }
            index = ii }
        if k == mi_load_ptr || k == mi_load_buf_ptr {
            if desc >= 0 || mir_ic(m, fi, ii) != 0 || mir_id(m, fi, ii) != 3 { << 9 }
            desc = ii
        }
        ii = mir_inext(m, fi, ii)
    }
    if sub < 0 || index < 0 { << 6 }
    lo := mir_loop_header_cell(m, fi, f, body, sub, mir_id(m, fi, sub))
    hi := mir_loop_header_cell(m, fi, f, body, sub, mir_ic(m, fi, sub))
    ll := mir_loop_header_cell(m, fi, f, latch, lc, mir_ic(m, fi, lc))
    lh := mir_loop_header_cell(m, fi, f, latch, lc, mir_id(m, fi, lc))
    if lo == hi || ll == lh || !mir_loop_int_cell(m, fi, lo, p.nl) || !mir_loop_int_cell(m, fi, hi, p.nl) || !mir_loop_int_cell(m, fi, ll, p.nl) || !mir_loop_int_cell(m, fi, lh, p.nl) { << 6 }
    needle := mir_latch_value_origin(m, fi, f, body, bc, mir_id(m, fi, bc))
    if needle.kind != 1 { << 6 }
    mut bk := 2
    mut bid := mir_ib(m, fi, index)
    if bid >= mir_local_operand_base { bk = 1
        bid -= mir_local_operand_base }
    root := mir_readonly_value_root(m, fi, f, body, index, bk, bid)
    if root < 0 || (bk == 2 && desc < 0) || (bk == 1 && desc >= 0) { << 9 }
    mut len := -1
    for b in p.starts[0]:p.starts[1] {
        bi := p.blocks[b]
        ii = mir_bhead(m, fi, bi)
        for _ in 0:f.ni {
            if ii == -1 { <- }
            k := mir_ikind(m, fi, ii)
            if k == mi_load_ptr || k == mi_load_buf_ptr {
                if len >= 0 || mir_ic(m, fi, ii) != 8 || mir_id(m, fi, ii) != 1 { << 5 }
                len = ii
            } else if (k < 0 || k > 3) && ii != ec { << 5 }
            ii = mir_inext(m, fi, ii)
        }
    }
    low := mir_latch_value_origin(m, fi, f, guard, ec, mir_ic(m, fi, ec))
    high := mir_latch_value_origin(m, fi, f, guard, ec, mir_id(m, fi, ec))
    if low.kind == 0 || high.kind == 0 || (low.kind == high.kind && low.value == high.value) { << 6 }
    mut lenroot := -1
    mut lenop := -1
    if len >= 0 {
        lb := mir_value_facts_owner(f, len)
        lenroot = mir_readonly_value_root(m, fi, f, lb, len, 2, mir_ib(m, fi, len))
        lenop = mir_ikind(m, fi, len)
        if lenroot != root { << 9 }
    }
    mir_latch_set_cell(p, 6, lo)
    mir_latch_set_cell(p, 8, hi)
    mir_latch_set_cell(p, 41, ll)
    mir_latch_set_cell(p, 43, lh)
    p.fields[11] = needle.value
    p.fields[12] = root
    p.fields[13] = 0
    p.fields[14] = -1
    if desc >= 0 { p.fields[13] = mir_ikind(m, fi, desc)
        p.fields[14] = mir_ia(m, fi, desc) }
    p.fields[15] = index
    p.fields[16] = len
    p.fields[17] = ec
    p.fields[18] = bc
    p.fields[24] = low.kind
    p.fields[25] = low.value
    p.fields[26] = low.definition
    p.fields[27] = high.kind
    p.fields[28] = high.value
    p.fields[29] = high.definition
    p.fields[31] = lenroot
    p.fields[32] = lenop
    p.fields[33] = 1
    if desc >= 0 { p.fields[33] = 2 }
    p.fields[36] = lc
    p.fields[45] = mir_ic(m, fi, ec)
    p.fields[46] = mir_id(m, fi, ec)
    p.fields[48] = desc
    << 0
}

fn mir_latch_seed(m &Mir, fi int, f &MirValueFacts, p &MirLoopPlan, bi int, point int, initial bool) []int {
    mut roles := []int{}
    for cell in 0:p.nl + p.nt {
        mut ck := 2
        mut cid := cell - p.nl
        if cell < p.nl { ck = 1
            cid = cell }
        origin := mir_loop_scalar_origin(m, fi, f, bi, point, ck, cid)
        mut role := 0
        if origin.kind == 1 && origin.value == p.fields[11] { role = 7 }
        root := mir_readonly_value_root(m, fi, f, bi, point, ck, cid)
        if root == p.fields[12] {
            role = 8
            if ck == 2 && mir_readonly_array_type(m, mir_temp_ty(m, fi, cid)) { role = 9 }
        }
        if initial && origin.kind != 0 {
            if origin.kind == p.fields[24] && origin.value == p.fields[25] { role = 1 }
            if origin.kind == p.fields[27] && origin.value == p.fields[28] { role = 2 }
        }
        roles.push(role)
    }
    << roles
}

// Literal updates are permitted only on the initial edge and only when
// equal to the precise initial scalar origin. Current loop states never
// acquire literal roles through an assumed runtime value.
fn mir_latch_edge_role(e &MirScalarEdgePlan, roles &[]int, p &MirLoopPlan, cell int, initial bool) int {
    role := mir_loop_same_edge_role(e, roles, cell)
    if role != 0 || !initial { << role }
    n := p.nl + p.nt
    if !e.valid || e.reason != 0 || cell < 0 || cell >= n || e.values[cell] != 2 || e.values[n * 2 + cell] != 0 { << 0 }
    word := e.values[n + cell]
    if p.fields[24] == 2 && word == p.fields[25] { << 1 }
    if p.fields[27] == 2 && word == p.fields[28] { << 2 }
    << 0
}

fn mir_latch_save_edge(e &MirScalarEdgePlan, roles &[]int, p &mut MirLoopPlan, lo int, hi int, initial bool, update bool) int {
    if !e.valid || e.reason != 0 { << 7 }
    n := p.nl + p.nt
    for cell in 0:n {
        if e.values[n * 3 + cell] != 0 {
            role := mir_latch_edge_role(e, roles, &*p, cell, initial)
            if cell < p.nl && cell != lo && cell != hi { << 8 }
            if role != 1 && role != 2 && (!update || (role != 5 && role != 12)) { << 7 }
        }
    }
    for at in 0:n * 4 { p.edges.push(e.values[at]) }
    << 0
}

fn mir_latch_scan_guard(m &Mir, fi int, f &MirValueFacts, bi int, cmp int, roles &mut []int) int {
    mut ii := mir_bhead(m, fi, bi)
    mut count := 0
    for _ in 0:f.ni {
        if ii == -1 { <- }
        k := mir_ikind(m, fi, ii)
        if k != mi_nop {
            dest := mir_scalar_def_cell(m, fi, ii, f.nl)
            mut role := 0
            if k == mi_copy { role = mir_loop_value_role(m, fi, &*roles, f.nl, mir_ib(m, fi, ii)) }
            else if k == mi_load_local { role = roles[mir_ib(m, fi, ii)] }
            else if ii == cmp && k == mi_bin && mir_ib(m, fi, ii) == 8 {
                if mir_loop_value_role(m, fi, &*roles, f.nl, mir_ic(m, fi, ii)) != 1 || mir_loop_value_role(m, fi, &*roles, f.nl, mir_id(m, fi, ii)) != 2 { << 6 }
                role = 10
                count += 1
            } else { << 5 }
            if role == 0 || roles[dest] == 1 || roles[dest] == 2 { << 8 }
            roles[dest] = role
        }
        ii = mir_inext(m, fi, ii)
    }
    if count != 1 || mir_loop_value_role(m, fi, &*roles, f.nl, mir_bta(m, fi, bi)) != 10 { << 6 }
    << 0
}

fn mir_latch_match(m &Mir, fi int, f &MirValueFacts, p &mut MirLoopPlan) int {
    n := p.nl + p.nt
    body := p.fields[2]
    guard := p.fields[21]
    latch := p.fields[35]
    lo := mir_latch_cell(&*p, 6)
    hi := mir_latch_cell(&*p, 8)
    ll := mir_latch_cell(&*p, 41)
    lh := mir_latch_cell(&*p, 43)
    mut entry_roles := mir_latch_seed(m, fi, f, &*p, guard, -1, true)
    mut roles := mir_latch_seed(m, fi, f, &*p, body, mir_bhead(m, fi, body), false)
    roles[lo] = 1
    roles[hi] = 2
    for cell in 0:n { p.roles.push(roles[cell]) }
    r := mir_loop_scan_body(m, fi, f, p, mut &roles)
    if r != 0 { << r }
    for cell in 0:n { p.roles.push(roles[cell]) }
    mut te := mir_read_scalar_edge(m, fi, f, body, p.fields[3], latch)
    mut fe := mir_read_scalar_edge(m, fi, f, body, p.fields[4], latch)
    if mir_loop_same_edge_role(&te, &roles, ll) != 12 || mir_loop_same_edge_role(&te, &roles, lh) != 2 || mir_loop_same_edge_role(&fe, &roles, ll) != 1 || mir_loop_same_edge_role(&fe, &roles, lh) != 5 { << 7 }
    tr := mir_latch_save_edge(&te, &roles, p, ll, lh, false, true)
    fr := mir_latch_save_edge(&fe, &roles, p, ll, lh, false, true)
    if tr != 0 { << tr }
    if fr != 0 { << fr }
    mut latch_roles := []int{}
    for cell in 0:n {
        t := mir_loop_same_edge_role(&te, &roles, cell)
        v := mir_loop_same_edge_role(&fe, &roles, cell)
        mut role := 0
        if t == v { role = t }
        if role == 1 { role = 21 }
        if role == 2 { role = 22 }
        if role == 5 { role = 25 }
        if role == 12 { role = 26 }
        latch_roles.push(role)
    }
    latch_roles[ll] = 1
    latch_roles[lh] = 2
    lr := mir_latch_scan_guard(m, fi, f, latch, p.fields[36], mut &latch_roles)
    if lr != 0 { << lr }
    mut ie := mir_read_scalar_edge(m, fi, f, guard, p.fields[37], body)
    mut be := mir_read_scalar_edge(m, fi, f, latch, p.fields[38], body)
    if mir_latch_edge_role(&ie, &entry_roles, &*p, lo, true) != 1 || mir_latch_edge_role(&ie, &entry_roles, &*p, hi, true) != 2 || mir_loop_same_edge_role(&be, &latch_roles, lo) != 1 || mir_loop_same_edge_role(&be, &latch_roles, hi) != 2 { << 7 }
    ir := mir_latch_save_edge(&ie, &entry_roles, p, lo, hi, true, false)
    br := mir_latch_save_edge(&be, &latch_roles, p, lo, hi, false, false)
    if ir != 0 { << ir }
    if br != 0 { << br }
    mut ee := mir_read_scalar_edge(m, fi, f, guard, p.fields[39], p.fields[5])
    mut le := mir_read_scalar_edge(m, fi, f, latch, p.fields[40], p.fields[5])
    // Exit copies may store the returned lo into a distinct Local. Only
    // writes that actually carry exit lo are admitted; nothing is deleted.
    mut exit_roles := []int{}
    for cell in 0:n {
        er := mir_latch_edge_role(&ee, &entry_roles, &*p, cell, true)
        lr2 := mir_loop_same_edge_role(&le, &latch_roles, cell)
        mut role := 0
        if er == 1 && lr2 == 1 { role = 1 }
        exit_roles.push(role)
        if !ee.valid || !le.valid || ee.reason != 0 || le.reason != 0 { << 7 }
        if ee.values[n * 3 + cell] != 0 && er != 1 { << 8 }
        if le.values[n * 3 + cell] != 0 && lr2 != 1 { << 8 }
    }
    for at in 0:n * 4 { p.edges.push(ee.values[at]) }
    for at in 0:n * 4 { p.edges.push(le.values[at]) }
    for b in p.starts[7]:p.starts[8] {
        bi := p.blocks[b]
        mut ii := mir_bhead(m, fi, bi)
        for _ in 0:f.ni {
            if ii == -1 { <- }
            k := mir_ikind(m, fi, ii)
            if k != mi_nop {
                dest := mir_scalar_def_cell(m, fi, ii, p.nl)
                mut role := 0
                if k == mi_copy || k == mi_store_local { role = mir_loop_value_role(m, fi, &exit_roles, p.nl, mir_ib(m, fi, ii)) }
                else if k == mi_load_local { role = exit_roles[mir_ib(m, fi, ii)] }
                else { << 8 }
                if role != 1 { << 8 }
                exit_roles[dest] = role
            }
            ii = mir_inext(m, fi, ii)
        }
    }
    if mir_loop_value_role(m, fi, &exit_roles, p.nl, p.fields[47]) != 1 { << 8 }
    for cell in 0:n { p.roles.push(exit_roles[cell]) }
    for cell in 0:n { p.roles.push(entry_roles[cell]) }
    for cell in 0:n { p.roles.push(latch_roles[cell]) }
    << 0
}

pub fn new_mir_latch_lower_bound_loop_plan(m &Mir, fi int, body int, latch int) MirLoopPlan {
    mut p := mir_loop_blank()
    if fi < 0 || fi >= m.fns.len { << p }
    mut facts := new_mir_readonly_value_facts(m, fi)
    p.reason = 3
    if !facts.valid || facts.reason != 0 {
        if facts.reason == 2 { p.reason = 2 }
        << p }
    p.nl = facts.nl
    p.nt = facts.nt
    for _ in 0:49 { p.fields.push(-1) }
    p.reason = mir_latch_cfg(m, fi, &facts, mut &p, body, latch)
    if p.reason != 0 { << p }
    p.reason = mir_latch_describe(m, fi, &facts, mut &p)
    if p.reason != 0 { << p }
    p.reason = mir_latch_match(m, fi, &facts, mut &p)
    if p.reason != 0 { << p }
    p.valid = true
    << p
}
