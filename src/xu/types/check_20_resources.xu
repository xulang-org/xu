@xu/types

#xu/ast
#xu/parser

// A reserved `drop` receiver method gives a concrete struct semantic ownership,
// even when every field is Copy. No marker allocation or fake owning field.
fn (c $&Checker) resource_decl_drop_label(p &parser.Parser, d int) string {
    for i in 0:p.decls.len {
        f := p.decls[i]
        if p.nodes[f].kind != ast.NK_FN || p.nodes[f].sval != "drop" || p.nodes[f].d < 0 {
            ->
        }
        if p.nodes[f].sval2 != p.nodes[d].sval2 { -> }
        $recv := p.nodes[p.nodes[f].d].a
        if p.nodes[recv].kind == ast.NT_REF { recv = p.nodes[recv].a }
        if p.nodes[recv].kind != ast.NT_NAMED || p.nodes[recv].sval != p.nodes[d].sval { -> }
        if p.nodes[d].e >= 0 {
            c.fail_node(p, f, "resource drop hooks on generic structs are not supported")
            << ""
        }
        if p.nodes[d].sval2.len == 0 { << "_xu_" + p.nodes[d].sval + "_drop" }
        << "_xu_" + mangle_mod(p.nodes[d].sval2 + "") + "_" + p.nodes[d].sval + "_drop"
    }
    << ""
}

fn (c $&Checker) validate_resource_drops(p &parser.Parser) {
    for i in 0:c.fns.len {
        if c.fns[i].name != "drop" || c.fns[i].recv < 0 { -> }
        d := c.fndecl[i]
        if i < c.fn_file.len { c.set_cur_file(p, c.fn_file[i]) }
        if c.fns[i].is_template || c.fns[i].is_extern || !is_mut_ref_type(c.fns[i].recv) || c.fns[i].params.len != 0 || c.fns[i].ret != 0 {
            c.fail_node(p, d, "resource drop must be a concrete &mut receiver with no arguments and no return value")
            ->
        }
        if i < c.fn_may_throw.len && c.fn_may_throw[i] != 0 {
            c.fail_node(p, d, "resource drop must handle every error and cannot propagate")
        }
        ty := c.ref_inner_type(c.fns[i].recv)
        if !is_struct_type(ty) {
            c.fail_node(p, d, "resource drop requires a concrete struct receiver")
            ->
        }
        si := struct_index(ty)
        // Buffer-to-frame marshalling uses complete words. Fail closed until
        // packed/zero-sized hook storage has an independently checked adapter.
        if c.structs[si].nslots < 1 || !c.resource_word_layout(ty) {
            c.fail_node(p, d, "resource drop requires a nonempty word-aligned layout")
        }
    }
}

// A zero-filled private field must not manufacture a live descriptor owner.
// Empty dynamic containers and null fat pointers have no payload to close.
fn (c &Checker) zero_requires_resource_constructor(ty int) bool {
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si < 0 || si >= c.structs.len { << false }
        if c.structs[si].drop_label.len > 0 { << true }
        for i in 0:c.structs[si].fields.len {
            if c.zero_requires_resource_constructor(c.structs[si].fields[i].ty) { << true }
        }
    }
    if is_array_type(ty) {
        ai := array_index(ty)
        if ai >= 0 && ai < c.arrays.len && c.arrays[ai].fixed_len > 0 {
            << c.zero_requires_resource_constructor(c.arrays[ai].elem_ty)
        }
    }
    if is_enum_type(ty) {
        ei := enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            for vi in 0:c.enums[ei].variants.len {
                for fi in 0:c.enums[ei].variants[vi].fields.len {
                    if c.zero_requires_resource_constructor(c.enums[ei].variants[vi].fields[fi]) { << true }
                }
            }
        }
    }
    << false
}

// Fixed array literals still use a scoped descriptor hold in hosted MIR.
// Keep new resource owners off that representation until move/return of
// every inline/descriptor boundary has a checked lowering.
fn (c &Checker) type_contains_resource(ty int) bool {
    $seen := []int{}
    << c.resource_type_walk(ty, $&seen)
}

fn (c &Checker) resource_type_walk(ty int, seen $&[]int) bool {
    if is_ref_type(ty) { << false }
    for i in 0:seen.len { if seen[i] == ty { << false } }
    seen.push(ty)
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si < 0 || si >= c.structs.len { << false }
        if c.structs[si].drop_label.len > 0 { << true }
        for i in 0:c.structs[si].fields.len {
            if c.resource_type_walk(c.structs[si].fields[i].ty, seen) { << true }
        }
    }
    if is_array_type(ty) {
        ai := array_index(ty)
        if ai >= 0 && ai < c.arrays.len { << c.resource_type_walk(c.arrays[ai].elem_ty, seen) }
    }
    if is_map_type(ty) {
        mi := map_index(ty)
        if mi >= 0 && mi < c.maps.len { << c.resource_type_walk(c.maps[mi].val_ty, seen) }
    }
    if is_enum_type(ty) {
        ei := enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            for vi in 0:c.enums[ei].variants.len {
                for fi in 0:c.enums[ei].variants[vi].fields.len {
                    if c.resource_type_walk(c.enums[ei].variants[vi].fields[fi], seen) { << true }
                }
            }
        }
    }
    // Dynamic boxes could hide a resource. Fixed owning boxes are rejected
    // conservatively; ordinary dynamic arrays retain type-directed drop.
    if is_temp_type(ty) || is_any_type(ty) || is_interface_type(ty) || is_fn_type(ty) { << true }
    << false
}

// A hook observes the complete value. Dynamic `as` extraction cannot leave
// one of its fields moved-from while the hook still expects it to be live.
fn (c &Checker) resource_move_ancestor(p &parser.Parser, n int) bool {
    $cur := n
    for _ in 0:p.nodes.len {
        if cur < 0 { << false }
        k := p.nodes[cur].kind
        if k == ast.NK_FIELD || k == ast.NK_INDEX || k == ast.NK_UN_OP {
            cur = p.nodes[cur].a
            if cur < 0 { << false }
            ty := c.direct_type(c.ntype[cur])
            if is_struct_type(ty) {
                si := struct_index(ty)
                if si >= 0 && si < c.structs.len && c.structs[si].drop_label.len > 0 { << true }
            }
        } else if k == ast.NK_IDENT {
            id := c.nlocal[cur]
            if id >= 0 && id < c.laref.len && c.laref[id] >= 0 {
                owner := c.laref[id]
                if owner < c.ltype.len {
                    ty := c.direct_type(c.ltype[owner])
                    if is_struct_type(ty) {
                        si := struct_index(ty)
                        if si >= 0 && si < c.structs.len && c.structs[si].drop_label.len > 0 { << true }
                    }
                }
            }
            << false
        } else { << false }
    }
    << false
}

fn (c &Checker) closure_owns_resource(ty int) bool {
    if !is_fn_type(ty) { << false }
    fi := fn_index(ty)
    if fi < 0 || fi >= c.fn_sigs.len || c.fn_sigs[fi].has_env != 1 { << false }
    si := c.fn_sigs[fi].env_struct
    if si < 0 || si >= c.structs.len { << false }
    << c.type_contains_resource(struct_type(si))
}

// Reversing complete words preserves frame fields only when no inline field
// shares a word with another field. Whole-struct alignment alone is weaker.
fn (c &Checker) resource_word_layout(ty int) bool {
    size := c.type_size_bytes(ty)
    if size < 1 || size % 8 != 0 || c.type_align_bytes(ty) != 8 { << false }
    if is_struct_type(ty) {
        si := struct_index(ty)
        for i in 0:c.structs[si].fields.len {
            if c.structs[si].fields[i].slot % 8 != 0 || !c.resource_word_layout(c.structs[si].fields[i].ty) { << false }
        }
    }
    if is_enum_type(ty) {
        ei := enum_index(ty)
        for vi in 0:c.enums[ei].variants.len {
            for fi in 0:c.enums[ei].variants[vi].fields.len {
                if !c.resource_word_layout(c.enums[ei].variants[vi].fields[fi]) { << false }
            }
        }
    }
    << true
}
