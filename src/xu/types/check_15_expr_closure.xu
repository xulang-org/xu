@xu/types

#xu/ast
#xu/parser

fn copy_ints(dst $&[]int, src &[]int) {
    for i in 0:src.len {
        dst.push(src[i])
    }
}

fn copy_strs(dst $&[]string, src &[]string) {
    for i in 0:src.len {
        dst.push(src[i] + "")
    }
}

fn (c $&Checker) check_method_value(p &parser.Parser, n int, base_ty int, ot int) int {
    if p.nodes[n].sval == "drop" {
        c.fail_node(p, n, "resource drop is compiler-managed; use an explicit close or finish method")
        << ERROR_TY
    }
    $fi := c.find_method(base_ty, p.nodes[n].sval)
    if fi < 0 {
        if is_struct_type(base_ty) {
            si := struct_index(base_ty)
            c.fail_node(p, n, "struct '" + c.structs[si].name + "' has no field '" + (p.nodes[n].sval + "") + "'")
        } else {
            c.fail_node(p, n, "type '" + c.ty_display(base_ty) + "' has no field '" + (p.nodes[n].sval + "") + "'")
        }
        << ERROR_TY
    }
    if c.fns[fi].mod_id != c.cur_mod && !c.fns[fi].is_pub {
        c.fail_node(p, n, "'" + (p.nodes[n].sval + "") + "' is private")
    }
    if c.fns[fi].variadic {
        c.fail_node(p, n, "cannot take method value of variadic method '" + (p.nodes[n].sval + "") + "' (M110)")
    }
    if c.fns[fi].is_template {
        if !is_struct_type(base_ty) {
            c.fail_node(p, n, "struct has no field '" + (p.nodes[n].sval + "") + "'")
            << ERROR_TY
        }
        si := struct_index(base_ty)
        if c.structs[si].origin == "" {
            c.fail_node(p, n, "cannot take value of generic method '" + (p.nodes[n].sval + "") + "' (instantiate via a call)")
        }
        c.load_targs_sargs(si)
        fi = c.instantiate_fn_n(p, fi, n)
        if fi < 0 { << ERROR_TY }
    }
    if c.fns[fi].params.len > 4 {
        c.fail_node(p, n, "indirect calls support at most 4 arguments (env uses A0)")
    }
    method_is_mut := c.fns[fi].recv_mut
    through_ref := is_ref_type(ot)
    if method_is_mut || through_ref {
        << c.check_method_value_bound(p, n, base_ty, ot, fi, method_is_mut)
    }
    // M110: value method on a value.
    c.closure_seq += 1
    seq := c.closure_seq
    recv_ty := base_ty
    $fields := []CField{}
    fields.push(CField{name: "self", ty: recv_ty, slot: 0, life: "", is_pub: false})
    ns := c.type_slots(recv_ty)
    env_si := c.structs.len
    mod := c.cur_mod + ""
    c.structs.push(CStruct{
        name: "__MethodEnv" + str(seq),
        fields: fields,
        nslots: ns,
        size_bytes: ns * 8,
        align_bytes: 8,
        mod_id: mod,
        is_pub: false,
        origin: "",
        drop_label: ""
    })
    c.note_st_index()
    c.sargs.push([]int{})
    c.sdecl.push(-1)
    c.slaid.push(1)
    c.sdoing.push(0)
    c.move_of(p, p.nodes[n].a, recv_ty, false)
    $user_params := []int{}
    for i in 0:c.fns[fi].params.len {
        user_params.push(c.fns[fi].params[i])
    }
    ty := c.intern_fn_sig_env(user_params, c.fns[fi].ret, 1, env_si)
    checker_set_i($&c.ncall, n, -92)
    checker_set_i($&c.nlocal, n, fi)
    checker_set_i($&c.nstr, n, env_si)
    checker_set_i($&c.ntype, n, ty)
    << ty
}

fn (c $&Checker) check_method_value_bound(p &parser.Parser, n int, base_ty int, ot int, fi int, method_is_mut bool) int {
    name := p.nodes[n].sval
    if method_is_mut && is_ref_type(ot) && !is_mut_ref_type(ot) {
        c.fail_node(p, n, "cannot take method value of mut method '" + (name + "") + "' through a shared reference")
    }
    $ptr_ty := 0
    if is_ref_type(ot) {
        if is_mut_ref_type(ot) {
            ptr_ty = c.make_ref_type(true, base_ty)
        } else {
            ptr_ty = c.make_ref_type(false, base_ty)
        }
        c.move_of(p, p.nodes[n].a, ot, false)
    } else {
        // mut method on a value: require mut variable; take address (no move).
        obj := p.nodes[n].a
        if p.nodes[obj].kind != ast.NK_IDENT {
            c.fail_node(p, n, "mut method value '" + (name + "") + "' requires a variable as receiver")
        }
        root := c.find_local(p.nodes[obj].sval)
        if root < 0 || c.lmut[root] == 0 {
            c.fail_node(p, n, "cannot take mut method value '" + (name + "") + "' on immutable variable '" + p.nodes[obj].sval + "'" + binding_mut_help(p.nodes[obj].sval))
        }
        ptr_ty = c.make_ref_type(true, base_ty)
    }
    c.closure_seq += 1
    seq := c.closure_seq
    $fields := []CField{}
    fields.push(CField{name: "self", ty: ptr_ty, slot: 0, life: "", is_pub: false})
    env_si := c.structs.len
    mod := c.cur_mod + ""
    c.structs.push(CStruct{
        name: "__BoundEnv" + str(seq),
        fields: fields,
        nslots: 1,
        size_bytes: 8,
        align_bytes: 8,
        mod_id: mod + "",
        is_pub: false,
        origin: "",
        drop_label: ""
    })
    c.note_st_index()
    c.sargs.push([]int{})
    c.sdecl.push(-1)
    c.slaid.push(1)
    c.sdoing.push(0)
    env_sty := struct_type(env_si)
    env_ref := c.make_ref_type(false, env_sty)
    $tramp_params := []int{}
    tramp_params.push(env_ref)
    for i in 0:c.fns[fi].params.len {
        tramp_params.push(c.fns[fi].params[i])
    }
    label := "_xu_bound_" + str(seq)
    $nf := CFn{
        name: "bound_" + str(seq),
        label: label,
        ret: c.fns[fi].ret,
        params: tramp_params,
        recv: -1,
        recv_mut: false,
        mod_id: mod + "",
        is_pub: false,
        is_extern: false,
        is_template: false,
        recv_name: "",
        variadic: false,
        lt_params: []string{}
    }
    tramp_fi := c.fns.len
    c.fns.push(nf)
    c.fndecl.push(-1) // no AST body — MIR synthesizes trampoline
    file_id := c.cur_file
    c.fn_file.push(file_id)
    c.is_inst.push(0)
    c.inst_snap_ready.push(0)
    c.inst_keys.push("")
    $fl := []int{}
    fl.push(env_ref)
    for i in 0:c.fns[fi].params.len {
        fl.push(c.fns[fi].params[i])
    }
    c.fnlocals.push(fl)
    c.clos_env.push(env_sty)
    c.clos_caps.push([]int{})
    c.bound_mfi.push(fi)
    c.inst_t0.push(-1)
    c.inst_targs.push([]int{})
    $user_params := []int{}
    for i in 0:c.fns[fi].params.len {
        user_params.push(c.fns[fi].params[i])
    }
    ty := c.intern_fn_sig_env(user_params, c.fns[fi].ret, 1, env_si)
    checker_set_i($&c.ncall, n, -95)
    checker_set_i($&c.nlocal, n, tramp_fi)
    checker_set_i($&c.nstr, n, env_si)
    checker_set_i($&c.ntype, n, ty)
    << ty
}

// M109/M111: lower `fn(params) [Ret] { body }` to a synthetic function (+ optional Env).
// M111: nested FnLit allowed (recursive); free-ident collection enters nested bodies.
fn (c $&Checker) check_fn_lit(p &parser.Parser, n int) int {
    // Resolve user params + ret.
    $param_tys := []int{}
    $prm := p.nodes[n].a
    while prm >= 0 {
    if p.nodes[prm].ival == 1 {
        c.fail_node(p, prm, "variadic parameters are not supported in function literals")
    }
    pty := c.type_of(p, p.nodes[prm].a)
    param_tys.push(pty)
    prm = p.nodes[prm].next
    }
    $ret_ty := 0
    if p.nodes[n].b >= 0 {
        ret_ty = c.type_of(p, p.nodes[n].b)
    }
    // Collect free idents.
    $bound := []string{}
    prm = p.nodes[n].a
    while prm >= 0 {
    bound.push(p.nodes[prm].sval)
    prm = p.nodes[prm].next
    }
    $cap_names := []string{}
    $seen := []string{}
    c.collect_free_idents(p, p.nodes[n].c, bound, $&cap_names, $&seen)
    // Resolve captures against outer locals or outer remapped captures (M111).
    $cap_outer := []int{}
    $cap_tys := []int{}
    $cap_resolved := []string{}
    $cap_from_env := []int{} // 1 = pack from outer env.field (cap_outer holds field idx)
    for i in 0:cap_names.len {
        $oid := c.find_local(cap_names[i] + "")
        $from_env := 0
        $ty := 0
        if oid >= 0 {
            c.check_not_moved(p, oid, n)
            if c.field_cons_any(oid) {
                c.fail_node(p, n, "use of moved value '" + c.lname[oid] + "'")
            }
            ty = c.ltype[oid]
        } else if c.cap_active == 1 {
            $found := -1
            for j in 0:c.cap_names.len {
                if c.cap_names[j] == cap_names[i] {
                    found = j
                }
            }
            if found < 0 {
                ->
            }
            from_env = 1
            oid = c.cap_fields[found]
            ty = c.cap_tys[found]
            // Nested pack from env.field: Copy ok; string clones in MIR; other owning rejected.
            if c.type_moves(ty) && ty != 3 {
                c.fail_node(p, n, "cannot capture owning value '" + (cap_names[i] + "") + "' from enclosing closure environment (M111)")
            }
        } else {
            -> // const / free fn resolved inside body
        }
        // M153: `&T` copies into Env; `&mut T` moves (type_moves). Remapped
        // capture Idents keep Local origin for elision (nlocal=-1).
        if is_fn_type(ty) {
            si := fn_index(ty)
            if si >= 0 && si < c.fn_sigs.len && c.fn_sigs[si].has_env == 1 {
                c.fail_node(p, n, "cannot capture owning function value '" + (cap_names[i] + "") + "' in a function literal (M109)")
            }
        }
        cap_resolved.push(cap_names[i] + "")
        cap_outer.push(oid)
        cap_tys.push(ty)
        cap_from_env.push(from_env)
    }
    c.closure_seq += 1
    seq := c.closure_seq
    label := "_xu_closure_" + str(seq)
    // Save outer function local state.
    $ol_name := []string{}
    $ol_name_id := []int{}
    $ol_head := []int{}
    $ol_prev := []int{}
    $ol_type := []int{}
    $ol_mut := []int{}
    $ol_active := []int{}
    $ol_moved := []int{}
    $ol_fcons := []int{}
    $ol_path := []int{}
    $ol_view := []int{}
    $ol_origin := []int{}
    $ol_aref := []int{}
    $ol_life := []string{}
    $ol_refok := []int{}
    $ol_const := []int{}
    $ol_const_ok := []int{}
    $ol_ub := []int{}
    $ol_ub_ok := []int{}
    $ol_length := []int{}
    $ol_length_ok := []int{}
    $ol_nz := []int{}
    $ol_nz_ok := []int{}
    $ol_fnz_recv := []int{}
    $ol_fnz_name := []string{}
    $ol_alias := []int{}
    $ol_marks := []int{}
    $ol_barriers := []int{}
    $ol_pend_ids := []int{}
    $ol_pend_nodes := []int{}
    $ol_pend_marks := []int{}
    copy_strs($&ol_name, &c.lname)
    copy_ints($&ol_name_id, &c.lname_id)
    copy_ints($&ol_type, &c.ltype)
    copy_ints($&ol_mut, &c.lmut)
    copy_ints($&ol_active, &c.lactive)
    copy_ints($&ol_moved, &c.lmoved)
    copy_ints($&ol_fcons, &c.lfcons)
    copy_ints($&ol_view, &c.lview)
    copy_ints($&ol_origin, &c.lorigin)
    copy_ints($&ol_aref, &c.laref)
    copy_strs($&ol_life, &c.llife)
    copy_ints($&ol_refok, &c.lrefok)
    copy_ints($&ol_const, &c.lconst)
    copy_ints($&ol_const_ok, &c.lconst_ok)
    copy_ints($&ol_ub, &c.lub)
    copy_ints($&ol_ub_ok, &c.lub_ok)
    copy_ints($&ol_length, &c.llength)
    copy_ints($&ol_length_ok, &c.llength_ok)
    copy_ints($&ol_nz, &c.lnz)
    copy_ints($&ol_nz_ok, &c.lnz_ok)
    copy_ints($&ol_alias, &c.calias)
    copy_ints($&ol_fnz_recv, &c.fnz_recv)
    copy_strs($&ol_fnz_name, &c.fnz_name)
    copy_ints($&ol_path, &c.lfpath)
    copy_ints($&ol_marks, &c.marks)
    copy_ints($&ol_barriers, &c.barriers)
    copy_ints($&ol_pend_ids, &c.pend_ids)
    copy_ints($&ol_pend_nodes, &c.pend_nodes)
    copy_ints($&ol_pend_marks, &c.pend_marks)
    copy_ints($&ol_head, &c.lhead)
    copy_ints($&ol_prev, &c.lprev)
    saved_ret := c.cur_ret
    saved_fn := c.cur_fn
    saved_rebind := c.rebind
    saved_loop := c.loop_depth

    $env_sty := -1
    $clos_params := []int{}
    if cap_resolved.len > 0 {
        // Build Env struct.
        $fields := []CField{}
        $off := 0
        $mal := 1
        for i in 0:cap_resolved.len {
            al := c.type_align_bytes(cap_tys[i])
            if al > mal { mal = al }
            off = align_up_bytes(off, al)
            fields.push(CField{name: cap_resolved[i], ty: cap_tys[i], slot: off, life: "", is_pub: false})
            off += c.type_size_bytes(cap_tys[i])
        }
        off = align_up_bytes(off, mal)
        si := c.structs.len
        mod := c.cur_mod + ""
        c.structs.push(CStruct{
            name: "__Env" + str(seq),
            fields: fields,
            nslots: (off + 7) / 8,
            size_bytes: off,
            align_bytes: mal,
            mod_id: mod,
            is_pub: false,
            origin: "",
        drop_label: ""
        })
        c.sargs.push([]int{})
        c.sdecl.push(-1)
        c.slaid.push(1)
        c.sdoing.push(0)
        env_sty = struct_type(si)
        clos_params.push(c.make_ref_type(false, env_sty)) // &Env
    }
    for i in 0:param_tys.len {
        clos_params.push(param_tys[i])
    }
    // Register synthetic function.
    mod2 := c.cur_mod + ""
    $nf := CFn{
        name: "closure_" + str(seq),
        label: label,
        ret: ret_ty,
        params: clos_params,
        recv: -1,
        recv_mut: false,
        mod_id: mod2,
        is_pub: false,
        is_extern: false,
        is_template: false,
        recv_name: "",
        variadic: false,
        lt_params: []string{}
    }
    fid := c.fns.len
    c.fns.push(nf)
    c.fndecl.push(n) // FnLit node doubles as decl (a/b/c layout)
    file_id := c.cur_file
    c.fn_file.push(file_id)
    c.is_inst.push(0)
    c.inst_snap_ready.push(0)
    c.inst_keys.push("")
    c.inst_t0.push(-1)
    c.inst_targs.push([]int{})
    c.fnlocals.push([]int{})
    c.clos_env.push(env_sty)
    $cap_row := []int{}
    for i in 0:cap_outer.len {
        // M111: negative = pack from outer env field (-(field+2)).
        if cap_from_env[i] == 1 {
            cap_row.push(0 - (cap_outer[i] + 2))
        } else {
            cap_row.push(cap_outer[i])
        }
    }
    c.clos_caps.push(cap_row)
    c.bound_mfi.push(-1)

    // Save outer capture remapping (M111 nested).
    $oc_active := c.cap_active
    $oc_names := []string{}
    $oc_fields := []int{}
    $oc_tys := []int{}
    for i in 0:c.cap_names.len {
        oc_names.push(c.cap_names[i])
        oc_fields.push(c.cap_fields[i])
        oc_tys.push(c.cap_tys[i])
    }

    // Check body in fresh locals.
    c.lname = []string{}
    c.lname_id = []int{}
    c.lhead = []int{}
    c.lprev = []int{}
    c.ltype = []int{}
    c.lmut = []int{}
    c.lactive = []int{}
    c.lmoved = []int{}
    c.lfcons = []int{}
    c.lfpath = []int{}
    c.lview = []int{}
    c.lorigin = []int{}
    c.laref = []int{}
    c.llife = []string{}
    c.lrefok = []int{}
    c.lconst = []int{}
    c.lconst_ok = []int{}
    c.lub = []int{}
    c.lub_ok = []int{}
    c.llength = []int{}
    c.llength_ok = []int{}
    c.lnz = []int{}
    c.lnz_ok = []int{}
    c.fnz_recv = []int{}
    c.fnz_name = []string{}
    c.calias = []int{}
    c.marks = []int{}
    c.barriers = []int{}
    c.pend_ids = []int{}
    c.pend_nodes = []int{}
    c.pend_marks = []int{}
    c.rebind = -1
    c.loop_depth = 0
    c.cur_ret = ret_ty
    c.cur_fn = fid
    c.push_scope(0)
    c.cap_names = []string{}
    c.cap_fields = []int{}
    c.cap_tys = []int{}
    if env_sty >= 0 {
        c.cap_active = 1
        eid := c.add_local("_env", c.make_ref_type(false, env_sty), false)
        checker_set_i($&c.lorigin, eid, eid)
        for i in 0:cap_resolved.len {
            c.cap_names.push(cap_resolved[i])
            c.cap_fields.push(i)
            c.cap_tys.push(cap_tys[i])
        }
    } else {
        c.cap_active = 0
    }
    prm = p.nodes[n].a
    $pi := 0
    while prm >= 0 {
    c.add_local(p.nodes[prm].sval, param_tys[pi], false)
    pi += 1
    prm = p.nodes[prm].next
    }
    $s := p.nodes[n].c
    while s >= 0 {
    c.check_stmt(p, s)
    s = p.nodes[s].next
    }
    if ret_ty != 0 {
        // Must end with << (mirror bootstrap). nk_return = 23.
        $last := p.nodes[n].c
        $prev := -1
        while last >= 0 {
        prev = last
        last = p.nodes[last].next
        }
        if prev < 0 || p.nodes[prev].kind != ast.NK_RETURN {
            c.fail_node(p, n, "non-void function literal must end with a return")
        }
        if p.nodes[prev].a < 0 {
            c.fail_node(p, n, "non-void function literal must end with a return")
        }
    }
    c.pop_scope(p, false, false)
    c.set_fnlocals_row(fid)

    // Restore outer locals and capture remapping; apply capture moves.
    c.lname = ol_name
    c.lname_id = ol_name_id
    c.lhead = ol_head
    c.lprev = ol_prev
    c.ltype = ol_type
    c.lmut = ol_mut
    c.lactive = ol_active
    c.lmoved = ol_moved
    c.lfcons = ol_fcons
    c.lfpath = ol_path
    c.lview = ol_view
    c.lorigin = ol_origin
    c.laref = ol_aref
    c.llife = ol_life
    c.lrefok = ol_refok
    c.lconst = ol_const
    c.lconst_ok = ol_const_ok
    c.lub = ol_ub
    c.lub_ok = ol_ub_ok
    c.llength = ol_length
    c.llength_ok = ol_length_ok
    c.lnz = ol_nz
    c.lnz_ok = ol_nz_ok
    c.fnz_recv = ol_fnz_recv
    c.fnz_name = ol_fnz_name
    c.calias = ol_alias
    c.marks = ol_marks
    c.barriers = ol_barriers
    c.pend_ids = ol_pend_ids
    c.pend_nodes = ol_pend_nodes
    c.pend_marks = ol_pend_marks
    c.cur_ret = saved_ret
    c.cur_fn = saved_fn
    c.rebind = saved_rebind
    c.loop_depth = saved_loop
    c.cap_active = oc_active
    c.cap_names = oc_names
    c.cap_fields = oc_fields
    c.cap_tys = oc_tys
    for i in 0:cap_outer.len {
        // Move owning captures out of outer locals (not from env.field copies).
        if cap_from_env[i] == 0 && c.type_moves(cap_tys[i]) {
            c.note_move(p, cap_outer[i], n)
        }
    }

    $has_env := 0
    $env_si := -1
    if env_sty >= 0 {
        has_env = 1
        env_si = struct_index(env_sty)
    }
    ty := c.intern_fn_sig_env(param_tys, ret_ty, has_env, env_si)
    checker_set_i($&c.ncall, n, fid)
    checker_set_i($&c.ntype, n, ty)
    << ty
}


fn (c $&Checker) collect_free_idents(p &parser.Parser, head int, bound []string, out $&[]string, seen $&[]string) {
    $s := head
    $bcopy := []string{}
    for i in 0:bound.len { bcopy.push(bound[i]) }
    while s >= 0 {
    c.collect_free_idents_stmt(p, s, $&bcopy, out, seen)
    s = p.nodes[s].next
    }
}

fn (c $&Checker) collect_free_idents_stmt(p &parser.Parser, s int, bound $&[]string, out $&[]string, seen $&[]string) {
    k := p.nodes[s].kind
    if k == ast.NK_LET { // Let
        if p.nodes[s].a >= 0 {
            c.collect_free_idents_expr(p, p.nodes[s].a, bound, out, seen)
        }
        bound.push(p.nodes[s].sval)
        <<
    }
    if k == ast.NK_ASSIGN { // Assign
        if p.nodes[s].a >= 0 { c.collect_free_idents_expr(p, p.nodes[s].a, bound, out, seen) }
        if p.nodes[s].b >= 0 { c.collect_free_idents_expr(p, p.nodes[s].b, bound, out, seen) }
        <<
    }
    if k == ast.NK_EXPR_STMT || k == ast.NK_RETURN || k == ast.NK_THROW || k == ast.NK_EXIT { // ExprStmt / Return / Throw / Exit
        if p.nodes[s].a >= 0 { c.collect_free_idents_expr(p, p.nodes[s].a, bound, out, seen) }
        <<
    }
    if k == ast.NK_IF { // If
        $br := p.nodes[s].a
        while br >= 0 {
        c.collect_free_idents_expr(p, p.nodes[br].a, bound, out, seen)
        $inner := []string{}
        for j in 0:bound.len { inner.push(bound[j]) }
        c.collect_free_idents(p, p.nodes[br].b, inner, out, seen)
        br = p.nodes[br].next
        }
        if p.nodes[s].b >= 0 {
            $inner := []string{}
            for j in 0:bound.len { inner.push(bound[j]) }
            c.collect_free_idents(p, p.nodes[s].b, inner, out, seen)
        }
        <<
    }
    if k == ast.NK_FOR { // For
        if p.nodes[s].a >= 0 { c.collect_free_idents_expr(p, p.nodes[s].a, bound, out, seen) }
        if p.nodes[s].b >= 0 { c.collect_free_idents_expr(p, p.nodes[s].b, bound, out, seen) }
        $inner := []string{}
        for j in 0:bound.len { inner.push(bound[j]) }
        inner.push(p.nodes[s].sval)
        c.collect_free_idents(p, p.nodes[s].c, inner, out, seen)
        <<
    }
    if k == ast.NK_FOR_EACH || k == ast.NK_WHILE { // ForEach / While
        if p.nodes[s].a >= 0 { c.collect_free_idents_expr(p, p.nodes[s].a, bound, out, seen) }
        $inner := []string{}
        for j in 0:bound.len { inner.push(bound[j]) }
        if k == ast.NK_FOR_EACH {
            inner.push(p.nodes[s].sval)
            if p.nodes[s].sval2.len > 0 {
                inner.push(p.nodes[s].sval2)
            }
        }
        c.collect_free_idents(p, p.nodes[s].c, inner, out, seen)
    }
}

fn (c $&Checker) collect_free_idents_expr(p &parser.Parser, e int, bound $&[]string, out $&[]string, seen $&[]string) {
    if e < 0 { << }
    // Own the traversal bounds across recursive closure analysis.
    $bnd := []string{}
    for j in 0:bound.len { bnd.push(bound[j]) }
    k := p.nodes[e].kind
    // M111: recurse into nested FnLit with its params bound (transitive free vars).
    if k == ast.NT_FN_LIT {
        $inner := []string{}
        for j in 0:bnd.len { inner.push(bnd[j]) }
        $prm := p.nodes[e].a
        while prm >= 0 {
        inner.push(p.nodes[prm].sval)
        prm = p.nodes[prm].next
        }
        c.collect_free_idents(p, p.nodes[e].c, inner, out, seen)
        <<
    }
    if k == ast.NK_IDENT {
        name := p.nodes[e].sval
        $is_bound := false
        for i in 0:bnd.len {
            if bnd[i] == name { is_bound = true }
        }
        $is_seen := false
        for i in 0:seen.len {
            if seen[i] == name { is_seen = true }
        }
        if !is_bound && !is_seen {
            seen.push(name)
            out.push(name)
        }
        <<
    }
    if k == ast.NK_CALL || k == ast.NK_METHOD_CALL || k == ast.NK_ARRAY_LIT {
        if k != ast.NK_CALL && p.nodes[e].a >= 0 {
            c.collect_free_idents_expr(p, p.nodes[e].a, $&bnd, out, seen)
        }
        $a := p.nodes[e].a
        if k == ast.NK_METHOD_CALL { a = p.nodes[e].b }
        while a >= 0 {
        c.collect_free_idents_expr(p, a, $&bnd, out, seen)
        a = p.nodes[a].next
        }
        <<
    }
    if k == ast.NK_OR_CATCH {
        c.collect_free_idents_expr(p, p.nodes[e].a, $&bnd, out, seen)
        $inner := []string{}
        for j in 0:bnd.len { inner.push(bnd[j]) }
        inner.push(p.nodes[e].sval)
        c.collect_free_idents(p, p.nodes[e].c, inner, out, seen)
        <<
    }
    if p.nodes[e].a >= 0 { c.collect_free_idents_expr(p, p.nodes[e].a, $&bnd, out, seen) }
    if p.nodes[e].b >= 0 { c.collect_free_idents_expr(p, p.nodes[e].b, $&bnd, out, seen) }
    if p.nodes[e].c >= 0 { c.collect_free_idents_expr(p, p.nodes[e].c, $&bnd, out, seen) }
}
