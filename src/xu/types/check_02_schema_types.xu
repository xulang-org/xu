@xu/types

fn type_name(t int) string {
    if is_nest_ref_type(t) {
        if is_mut_ref_type(t) { << "&mut _" }
        << "&_"
    }
    if is_mut_ref_type(t) { << "&mut _" }
    if is_ref_type(t) { << "&_" }
    if t == 1 { << "int" }
    if t == 2 { << "bool" }
    if t == 3 { << "string" }
    if t == 4 { << "f64" }
    if t == 5 { << "Self" }
    if t == 8 { << "i32" }
    if t == 9 { << "u32" }
    if t == 10 { << "u8" }
    if is_param_type(t) { << "T" + str(param_index(t)) }
    if is_struct_type(t) { << "struct" }
    if is_array_type(t) { << "array" }
    if is_throw_type(t) { << "throw" }
    if is_enum_type(t) { << "enum" }
    if is_chan_type(t) { << "chan" }
    if is_map_type(t) { << "map" }
    if is_fn_type(t) { << "fn" }
    if is_temp_type(t) { << "temp" }
    if is_any_type(t) { << "any" }
    if is_interface_type(t) { << "interface" }
    if is_error_type(t) { << "_" }
    << "void"
}

// Struct type tags keep the original 100..199 domain for compatibility.
// Larger structs use the legacy overflow format, then the shared dynamic
// encoding. These formats are not registration quotas. All consumers use
// struct_type/struct_index instead of spelling `100 + index` directly.
const STRUCT_OVERFLOW_BASE = 5000
// Keep raw StructId values below the scalar temp-box ids (0xff01+).
const LEGACY_STRUCT_OVERFLOW_COUNT = 60000

pub fn struct_type(si int) int {
    if si < 0 { << -1 }
    if si < 100 {
        << 100 + si
    }
    if si < LEGACY_STRUCT_OVERFLOW_COUNT + 100 { << STRUCT_OVERFLOW_BASE + si - 100 }
    << type_id(TYPE_KIND_STRUCT,si)
}

pub fn struct_index(t int) int {
    if type_kind(t) == TYPE_KIND_STRUCT { << type_index(t) }
    if t >= 100 && t < 200 {
        << t - 100
    }
    if t >= STRUCT_OVERFLOW_BASE && t < STRUCT_OVERFLOW_BASE + LEGACY_STRUCT_OVERFLOW_COUNT {
        << t - STRUCT_OVERFLOW_BASE + 100
    }
    << -1
}

pub fn is_struct_type(t int) bool { << struct_index(t) >= 0 }
pub fn is_array_type(t int) bool { << array_index(t) >= 0 }

pub fn array_fixed_len_at(arrays &[]CArray, t int) int {
    if !is_array_type(t) { << 0 }
    ai := array_index(t)
    if ai < 0 || ai >= arrays.len { << 0 }
    << arrays[ai].fixed_len
}

pub fn is_fixed_array_at(arrays &[]CArray, t int) bool {
    << array_fixed_len_at(arrays, t) > 0
}

pub fn (c &Checker) array_fixed_len(t int) int {
    if !is_array_type(t) { << 0 }
    ai := array_index(t)
    if ai < 0 || ai >= c.arrays.len { << 0 }
    << c.arrays[ai].fixed_len
}

pub fn (c &Checker) is_fixed_array(t int) bool {
    << c.array_fixed_len(t) > 0
}

// &mut Checker receivers — Xu does not coerce &mut to & for method calls.
pub fn (c &mut Checker) array_fixed_len_m(t int) int {
    if !is_array_type(t) { << 0 }
    ai := array_index(t)
    if ai < 0 || ai >= c.arrays.len { << 0 }
    << c.arrays[ai].fixed_len
}

pub fn (c &mut Checker) is_fixed_array_m(t int) bool {
    << c.array_fixed_len_m(t) > 0
}

pub fn (c &mut Checker) direct_type_m(t int) int {
    if is_ref_type(t) { << ref_inner_at(&c.cnest,t) }
    << t
}
pub fn map_type(index int) int { if index < 0 { << -1 }
    if index < 50 { << 50 + index }
    << type_id(TYPE_KIND_MAP,index) }
pub fn map_index(t int) int { if t >= 50 && t < 100 { << t - 50 }
    if type_kind(t) == TYPE_KIND_MAP { << type_index(t) }
    << -1 }
pub fn is_map_type(t int) bool { << map_index(t) >= 0 }
// Legacy result ids remain readable; newly extended layouts share type_id().
const LEGACY_THROW_OVERFLOW_BASE = 70000
const LEGACY_THROW_OVERFLOW_COUNT = 3996
pub fn throw_type(index int) int { if index < 0 { << -1 }
    if index < 100 { << 300 + index }
    if index < LEGACY_THROW_OVERFLOW_COUNT + 100 { << LEGACY_THROW_OVERFLOW_BASE + index - 100 }
    << type_id(TYPE_KIND_THROW,index) }
pub fn throw_index(t int) int {
    if t >= 300 && t < 400 { << t - 300 }
    if t >= LEGACY_THROW_OVERFLOW_BASE && t < LEGACY_THROW_OVERFLOW_BASE + LEGACY_THROW_OVERFLOW_COUNT {
        << t - LEGACY_THROW_OVERFLOW_BASE + 100 }
    if type_kind(t) == TYPE_KIND_THROW { << type_index(t) }
    << -1
}
pub fn is_throw_type(t int) bool { << throw_index(t) >= 0 }
// Type parameters of a generic definition: 400 + index.
pub fn is_param_type(t int) bool { << param_index(t) >= 0 }
// User enums (M15): 500 + index.
pub fn is_enum_type(t int) bool { << enum_index(t) >= 0 }
pub fn is_chan_type(t int) bool { << chan_index(t) >= 0 }
pub fn is_fn_type(t int) bool { << fn_index(t) >= 0 }
// M200: dynamic `temp` — fat pointer `(data*, itable*)`.
// Write-once read-only container. Method/`is` reads borrow; `as` consumes.
const TEMP_TY = 800
// Like `temp`, but `as` copies/clones out and keeps the box.
const ANY_TY = 801
// Failed expression placeholder. Not a real type; suppresses follow-on errors.
const ERROR_TY = 802

fn is_temp_type(t int) bool { << t == TEMP_TY }
fn is_any_type(t int) bool { << t == ANY_TY }
fn is_error_type(t int) bool { << t == ERROR_TY }

pub fn is_value_type(t int) bool {
    // Scalars + type params (boxed after monomorph; §0.1 a# → temp).
    if t == 1 || t == 2 || t == 3 || t == 4 || t == 8 || t == 9 || t == 10 { << true }
    << is_param_type(t)
}

pub fn is_integer_type(t int) bool {
    << t == 1 || t == 8 || t == 9 || t == 10
}

// MS3: unary `*` read/write of these pointees (scalar copy; string clones).
fn deref_copy_ok(t int) bool {
    if is_integer_type(t) { << true }
    if t == 2 || t == 3 || t == 4 { << true }
    << false
}

// MS4: element borrow `&xs[i]` pointees — match bootstrap elem_borrow_ok
// (scalars, string, struct, array; maps use the same helper for values).
fn elem_borrow_ok(t int) bool {
    if is_integer_type(t) { << true }
    if t == 2 || t == 3 || t == 4 { << true } // bool, string, f64
    if is_struct_type(t) { << true }
    if is_array_type(t) { << true }
    if is_map_type(t) { << true }
    << false
}

// §0.1: bare `temp`/`any` accept value types except void / borrows.
pub fn can_box_into_temp(t int) bool {
    if t == 0 { << false }
    if is_ref_type(t) { << false }
    << true
}

pub fn is_interface_type(t int) bool { << interface_index(t) >= 0 }

fn is_dynamic_box(t int) bool { << is_temp_type(t) || is_any_type(t) || is_interface_type(t) }

// Write-once: temp / any only. struct@ is Go-like (mut + reassign).
fn is_write_once_box(t int) bool { << is_temp_type(t) || is_any_type(t) }

// `as` may consume: temp always; struct@ when concrete owning (checked at cast).
fn is_linear_dynamic(t int) bool { << is_temp_type(t) }

fn is_as_box(t int) bool { << is_temp_type(t) || is_interface_type(t) }

fn iface_ty(ii int) int { << interface_type(ii) }

fn iface_index(t int) int { << interface_index(t) }

// Discriminants follow the same dynamic registry identity as concrete types.
fn temp_box_type_id(ty int) int { << type_box_tag(ty) }

fn any_value_tag(ty int) int { << temp_box_type_id(ty) }

pub fn any_value_nslots(tag int) int {
    if tag == ANY_TAG_STRING { << 3 }
    << 1
}

pub fn any_itab_label(tag int) string {
    if tag == ANY_TAG_INT { << "_xu_any_ff01" }
    if tag == ANY_TAG_BOOL { << "_xu_any_ff02" }
    if tag == ANY_TAG_STRING { << "_xu_any_ff03" }
    if tag == ANY_TAG_F64 { << "_xu_any_ff04" }
    if tag == ANY_TAG_I32 { << "_xu_any_ff05" }
    if tag == ANY_TAG_U32 { << "_xu_any_ff06" }
    if tag == ANY_TAG_U8 { << "_xu_any_ff07" }
    kind := box_type_kind(tag)
    index := box_type_index(tag)
    if kind == TYPE_KIND_STRUCT { << "_xu_any_s" + str(index) }
    if kind == TYPE_KIND_ENUM { << "_xu_any_e" + str(index) }
    if kind == TYPE_KIND_ARRAY { << "_xu_any_a" + str(index) }
    if kind == TYPE_KIND_THROW { << "_xu_any_th" + str(index) }
    if kind == TYPE_KIND_CHAN { << "_xu_any_c" + str(index) }
    if kind == TYPE_KIND_MAP { << "_xu_any_m" + str(index) }
    if kind == TYPE_KIND_FN { << "_xu_any_f" + str(index) }
    if kind == TYPE_KIND_PARAM { << "_xu_any_p" + str(index) }
    << "_xu_any_unknown"
}

pub fn iface_itab_label(mod string, iface string, struct_name string) string {
    << "_xu_itab_" + mod + "_" + iface + "_" + struct_name
}

// AssignOp 1=  2+=  3-=  4*=  5/=  6%=. Mirror bootstrap: +=-=*=/=
// accept matching int or f64; %= is int only. 1 means ok.
fn compound_ty_ok(aop int, ty int) int {
    if aop < 2 { << 1 }
    if aop == 6 {
        if is_integer_type(ty) { << 1 }
        << 0
    }
    if is_integer_type(ty) || ty == 4 { << 1 }
    << 0
}

fn compound_ty_msg(aop int, expect int, got int) string {
    if aop == 6 {
        << "operator '%=' requires int operands, found " + type_name(expect) + " and " + type_name(got)
    }
    mut op := "+="
    if aop == 3 { op = "-=" }
    if aop == 4 { op = "*=" }
    if aop == 5 { op = "/=" }
    << "operator '" + op + "' requires matching int or f64 operands, found " + type_name(expect) + " and " + type_name(got)
}
pub fn is_ref_type(t int) bool {
    << (t >= 1000 && t < 5000) || type_kind(t) == TYPE_KIND_REF || type_kind(t) == TYPE_KIND_MUT_REF
}
pub fn is_mut_ref_type(t int) bool {
    << (t >= 2000 && t < 3000) || (t >= 4000 && t < 5000) || type_kind(t) == TYPE_KIND_MUT_REF
}
fn is_nest_ref_type(t int) bool { << registry_ref_index(t) >= 0 }
fn make_param_type(k int) int { if k < 0 { << -1 }
    if k < 100 { << 400 + k }
    << type_id(TYPE_KIND_PARAM,k) }
fn param_index(t int) int { if t >= 400 && t < 500 { << t - 400 }
    if type_kind(t) == TYPE_KIND_PARAM { << type_index(t) }
    << -1 }
fn (c &Checker) ref_inner_type(t int) int { << ref_inner_at(&c.cnest,t) }
fn (c &mut Checker) make_ref_type(mutable bool,inner int) int {
    if inner < 0 { << -1 }
    // Compact direct references preserve the established bootstrap encoding.
    if inner < 1000 { if mutable { << 2000 + inner }
        << 1000 + inner }
    for i in 0:c.cnest.len { if c.cnest[i] == inner { << registry_ref_type(mutable,i) } }
    index := c.cnest.len
    if type_id(TYPE_KIND_REF,index) < 0 { c.fail_at(1,1,"reference registry exceeds addressable type id range")
        << -1 }
    c.cnest.push(inner)
    << registry_ref_type(mutable,index)
}

fn (c &Checker) direct_type(t int) int {
    if is_ref_type(t) { << c.ref_inner_type(t) }
    << t
}

// ===== scopes & locals =====
