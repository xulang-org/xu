@xu/types

fn type_name(t int) string {
    if is_nest_ref_type(t) {
        if is_mut_ref_type(t) { << "&mut _" }
        << "&_"
    }
    if is_mut_ref_type(t) { << "&mut _" }
    if is_ref_type(t) { << "&_" }
    if t == 1 { << "int" }
    if t == 2 { << "bool" }
    if t == 3 { << "string" }
    if t == 4 { << "f64" }
    if t == 5 { << "Self" }
    if t == 8 { << "i32" }
    if t == 9 { << "u32" }
    if t == 10 { << "u8" }
    if is_param_type(t) { << "T" + str(t - 400) }
    if is_struct_type(t) { << "struct" }
    if is_array_type(t) { << "array" }
    if is_throw_type(t) { << "throw" }
    if is_enum_type(t) { << "enum" }
    if is_chan_type(t) { << "chan" }
    if is_map_type(t) { << "map" }
    if is_fn_type(t) { << "fn" }
    if is_temp_type(t) { << "temp" }
    if is_any_type(t) { << "any" }
    if is_interface_type(t) { << "interface" }
    if is_error_type(t) { << "_" }
    << "void"
}

// Struct type tags keep the original 100..199 domain for compatibility.
// Additional structs use a disjoint overflow domain. All consumers must use
// struct_type/struct_index instead of spelling `100 + index` directly.
const struct_overflow_base = 5000
// Keep raw StructId values below the scalar temp-box ids (0xff01+).
const struct_overflow_limit = 60000

pub fn struct_type(si int) int {
    if si < 100 {
        << 100 + si
    }
    << struct_overflow_base + si - 100
}

pub fn struct_index(t int) int {
    if t >= 100 && t < 200 {
        << t - 100
    }
    if t >= struct_overflow_base && t < struct_overflow_base + struct_overflow_limit {
        << t - struct_overflow_base + 100
    }
    << -1
}

pub fn is_struct_type(t int) bool {
    << (t >= 100 && t < 200) || (t >= struct_overflow_base && t < struct_overflow_base + struct_overflow_limit)
}
pub fn is_array_type(t int) bool { << t >= 200 && t < 300 }

pub fn array_fixed_len_at(arrays &[]CArray, t int) int {
    if !is_array_type(t) { << 0 }
    ai := t - 200
    if ai < 0 || ai >= arrays.len { << 0 }
    << arrays[ai].fixed_len
}

pub fn is_fixed_array_at(arrays &[]CArray, t int) bool {
    << array_fixed_len_at(arrays, t) > 0
}

pub fn (c &Checker) array_fixed_len(t int) int {
    if !is_array_type(t) { << 0 }
    ai := t - 200
    if ai < 0 || ai >= c.arrays.len { << 0 }
    << c.arrays[ai].fixed_len
}

pub fn (c &Checker) is_fixed_array(t int) bool {
    << c.array_fixed_len(t) > 0
}

// &mut Checker receivers — Xu does not coerce &mut to & for method calls.
pub fn (c &mut Checker) array_fixed_len_m(t int) int {
    if !is_array_type(t) { << 0 }
    ai := t - 200
    if ai < 0 || ai >= c.arrays.len { << 0 }
    << c.arrays[ai].fixed_len
}

pub fn (c &mut Checker) is_fixed_array_m(t int) bool {
    << c.array_fixed_len_m(t) > 0
}

pub fn (c &mut Checker) direct_type_m(t int) int {
    if t >= 4000 && t < 5000 {
        << c.cnest[t - 4000]
    }
    if t >= 3000 && t < 4000 {
        << c.cnest[t - 3000]
    }
    if t >= 2000 && t < 3000 { << t - 2000 }
    if t >= 1000 && t < 2000 { << t - 1000 }
    << t
}
pub fn is_map_type(t int) bool { << t >= 50 && t < 100 }
pub fn is_throw_type(t int) bool { << t >= 300 && t < 400 }
// Type parameters of a generic definition: 400 + index.
pub fn is_param_type(t int) bool { << t >= 400 && t < 500 }
// User enums (M15): 500 + index.
pub fn is_enum_type(t int) bool { << t >= 500 && t < 600 }
pub fn is_chan_type(t int) bool { << t >= 600 && t < 700 }
pub fn is_fn_type(t int) bool { << t >= 700 && t < 800 }
// M200: dynamic `temp` — fat pointer `(data*, itable*)`.
// Write-once read-only container. Method/`is` reads borrow; `as` consumes.
const temp_ty = 800
// Like `temp`, but `as` copies/clones out and keeps the box.
const any_ty = 801
// Failed expression placeholder. Not a real type; suppresses follow-on errors.
const error_ty = 802
const interface_ty_base = 810

fn is_temp_type(t int) bool { << t == temp_ty }
fn is_any_type(t int) bool { << t == any_ty }
fn is_error_type(t int) bool { << t == error_ty }

pub fn is_value_type(t int) bool {
    // Scalars + type params (boxed after monomorph; §0.1 a# → temp).
    if t == 1 || t == 2 || t == 3 || t == 4 || t == 8 || t == 9 || t == 10 { << true }
    << is_param_type(t)
}

pub fn is_integer_type(t int) bool {
    << t == 1 || t == 8 || t == 9 || t == 10
}

// MS3: unary `*` read/write of these pointees (scalar copy; string clones).
fn deref_copy_ok(t int) bool {
    if is_integer_type(t) { << true }
    if t == 2 || t == 3 || t == 4 { << true }
    << false
}

// MS4: element borrow `&xs[i]` pointees — match bootstrap elem_borrow_ok
// (scalars, string, struct, array; maps use the same helper for values).
fn elem_borrow_ok(t int) bool {
    if is_integer_type(t) { << true }
    if t == 2 || t == 3 || t == 4 { << true } // bool, string, f64
    if is_struct_type(t) { << true }
    if is_array_type(t) { << true }
    if is_map_type(t) { << true }
    << false
}

// §0.1: bare `temp`/`any` accept value types except void / borrows.
pub fn can_box_into_temp(t int) bool {
    if t == 0 { << false }
    if is_ref_type(t) { << false }
    << true
}

pub fn is_interface_type(t int) bool { << t >= interface_ty_base && t < 1000 }

fn is_dynamic_box(t int) bool { << is_temp_type(t) || is_any_type(t) || is_interface_type(t) }

// Write-once: temp / any only. struct@ is Go-like (mut + reassign).
fn is_write_once_box(t int) bool { << is_temp_type(t) || is_any_type(t) }

// `as` may consume: temp always; struct@ when concrete owning (checked at cast).
fn is_linear_dynamic(t int) bool { << is_temp_type(t) }

fn is_as_box(t int) bool { << is_temp_type(t) || is_interface_type(t) }

fn iface_ty(ii int) int { << interface_ty_base + ii }

fn iface_index(t int) int { << t - interface_ty_base }

// Discriminant stored in the temp itable (mirrors bootstrap temp_box_type_id).
fn temp_box_type_id(ty int) int {
    if ty == 1 { << any_tag_int } // 0xFF01
    if ty == 2 { << any_tag_bool } // 0xFF02
    if ty == 3 { << any_tag_string } // 0xFF03
    if ty == 4 { << any_tag_f64 } // 0xFF04
    if ty == 8 { << any_tag_i32 } // 0xFF05 i32
    if ty == 9 { << any_tag_u32 } // 0xFF06 u32
    if ty == 10 { << any_tag_u8 } // 0xFF07 u8
    if is_struct_type(ty) { << struct_index(ty) }
    if is_enum_type(ty) { << any_tag_enum_base + (ty - 500) } // 0xF000_0000 | id
    if is_array_type(ty) { << any_tag_array_base + (ty - 200) } // 0xE000_0000 | id
    if is_throw_type(ty) { << any_tag_throw_base + (ty - 300) } // 0xD000_0000 | id
    if is_chan_type(ty) { << any_tag_chan_base + (ty - 600) } // 0xC000_0000 | id
    if is_map_type(ty) { << any_tag_map_base + (ty - 50) } // 0x9000_0000 | id
    if is_fn_type(ty) { << any_tag_fn_base + (ty - 700) } // 0xB000_0000 | id
    if is_param_type(ty) { << any_tag_param_base + (ty - 400) } // 0xA000_0000 | k
    if is_temp_type(ty) || is_any_type(ty) || is_interface_type(ty) { << 0 - 1 }
    << 0 - 1
}

fn any_value_tag(ty int) int { << temp_box_type_id(ty) }

pub fn any_value_nslots(tag int) int {
    if tag == any_tag_string { << 3 }
    << 1
}

pub fn any_itab_label(tag int) string {
    if tag == any_tag_int { << "_xu_any_ff01" }
    if tag == any_tag_bool { << "_xu_any_ff02" }
    if tag == any_tag_string { << "_xu_any_ff03" }
    if tag == any_tag_f64 { << "_xu_any_ff04" }
    if tag == any_tag_i32 { << "_xu_any_ff05" }
    if tag == any_tag_u32 { << "_xu_any_ff06" }
    if tag == any_tag_u8 { << "_xu_any_ff07" }
    if tag >= 0 && tag < struct_overflow_limit + 100 { << "_xu_any_s" + str(tag) }
    if tag >= any_tag_enum_base && tag < any_tag_enum_base + 100 {
        << "_xu_any_e" + str(tag - any_tag_enum_base)
    }
    if tag >= any_tag_array_base && tag < any_tag_array_base + 100 {
        << "_xu_any_a" + str(tag - any_tag_array_base)
    }
    if tag >= any_tag_throw_base && tag < any_tag_throw_base + 100 {
        << "_xu_any_th" + str(tag - any_tag_throw_base)
    }
    if tag >= any_tag_chan_base && tag < any_tag_chan_base + 100 {
        << "_xu_any_c" + str(tag - any_tag_chan_base)
    }
    if tag >= any_tag_map_base && tag < any_tag_map_base + 50 {
        << "_xu_any_m" + str(tag - any_tag_map_base)
    }
    if tag >= any_tag_fn_base && tag < any_tag_fn_base + 100 {
        << "_xu_any_f" + str(tag - any_tag_fn_base)
    }
    if tag >= any_tag_param_base && tag < any_tag_param_base + 100 {
        << "_xu_any_p" + str(tag - any_tag_param_base)
    }
    << "_xu_any_unknown"
}

pub fn iface_itab_label(mod string, iface string, struct_name string) string {
    << "_xu_itab_" + mod + "_" + iface + "_" + struct_name
}

// AssignOp 1=  2+=  3-=  4*=  5/=  6%=. Mirror bootstrap: +=-=*=/=
// accept matching int or f64; %= is int only. 1 means ok.
fn compound_ty_ok(aop int, ty int) int {
    if aop < 2 { << 1 }
    if aop == 6 {
        if is_integer_type(ty) { << 1 }
        << 0
    }
    if is_integer_type(ty) || ty == 4 { << 1 }
    << 0
}

fn compound_ty_msg(aop int, expect int, got int) string {
    if aop == 6 {
        << "operator '%=' requires int operands, found " + type_name(expect) + " and " + type_name(got)
    }
    mut op := "+="
    if aop == 3 { op = "-=" }
    if aop == 4 { op = "*=" }
    if aop == 5 { op = "/=" }
    << "operator '" + op + "' requires matching int or f64 operands, found " + type_name(expect) + " and " + type_name(got)
}
pub fn is_ref_type(t int) bool {
    << (t >= 1000 && t < 3000) || (t >= 3000 && t < 5000)
}
fn is_mut_ref_type(t int) bool {
    if t >= 4000 && t < 5000 { << true }
    << t >= 2000 && t < 3000
}
fn is_nest_ref_type(t int) bool { << t >= 3000 && t < 5000 }
fn make_param_type(k int) int { << 400 + k }
fn param_index(t int) int { << t - 400 }

fn (c &Checker) ref_inner_type(t int) int {
    if t >= 4000 && t < 5000 {
        << c.cnest[t - 4000]
    }
    if t >= 3000 && t < 4000 {
        << c.cnest[t - 3000]
    }
    if t >= 2000 { << t - 2000 }
    << t - 1000
}

fn (c &mut Checker) make_ref_type(mutable bool, inner int) int {
    if is_nest_ref_type(inner) {
        << -1
    }
    // Overflow structs cannot use the legacy 1000+inner arithmetic (that
    // would leave the recognised 1000..4999 ref domain). Store their payload
    // in the existing side table, like nested references.
    if is_struct_type(inner) && struct_index(inner) >= 100 {
        for i in 0:c.cnest.len {
            if c.cnest[i] == inner {
                if i >= 1000 {
                    << -1
                }
                if mutable {
                    << 4000 + i
                }
                << 3000 + i
            }
        }
        idx := c.cnest.len
        if idx >= 1000 {
            << -1
        }
        c.cnest.push(inner)
        if mutable {
            << 4000 + idx
        }
        << 3000 + idx
    }
    if is_ref_type(inner) {
        idx := c.cnest.len
        if idx >= 1000 {
            << -1
        }
        c.cnest.push(inner)
        if mutable {
            << 4000 + idx
        }
        << 3000 + idx
    }
    if mutable {
        << 2000 + inner
    }
    << 1000 + inner
}

fn (c &Checker) direct_type(t int) int {
    if is_ref_type(t) { << c.ref_inner_type(t) }
    << t
}

// ===== scopes & locals =====
