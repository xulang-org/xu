@xu/types

// A small value-numbering table over the already verified SSA window.
// Bounded bitset dominators avoid the verifier's dense per-bit predecessor
// walk. No proof is cached on mutable MFn, and no instruction is moved.
const mir_ssa_cse_max_bins = 128

fn mir_ssa_cse_int(f &MFn, t int) bool {
    << t >= 0 && t < f.temps.len && f.temps[t] == 1 && f.temps_nslots[t] == 1
}
fn mir_ssa_cse_bin_f(f &MFn, ii int) bool {
    if mfn_ikind(&f.instrs, ii) != 4 || mfn_isval_len(&f.instrs, ii) != 0 { << false }
    if !mir_binop_scalar_cse_op(mfn_ib(&f.instrs, ii)) { << false }
    if !mir_ssa_cse_int(f, mfn_ia(&f.instrs, ii)) { << false }
    lhs := mfn_ic(&f.instrs, ii)
    rhs := mfn_id(&f.instrs, ii)
    if lhs >= 0 && !mir_ssa_cse_int(f, lhs) { << false }
    if rhs >= 0 && !mir_ssa_cse_int(f, rhs) { << false }
    << true
}
fn mir_ssa_cse_count_f(f &MFn) int {
    mut n := 0
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mir_ssa_cse_bin_f(f, ii) {
                n += 1
                if n > mir_ssa_cse_max_bins { << 0 }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << n
}

// Strict SSA, including reachable CFG and single definitions, must have
// been proved on this exact MFn. The caller keeps every Addr(Temp) pinned.
fn mir_ssa_cse_verified_f(f &mut MFn, aliases &mut []int, pinned &[]bool) bool {
    nb := f.blocks.len
    if nb <= 0 || nb > 64 || !mir_ssa_work_budget_f(&*f) { << false }
    if mir_ssa_cse_count_f(&*f) < 2 { << false }
    // At most 64 blocks: bit 63 is a valid signed-word bit, never a bound.
    mut reach := 1
    for _ in 0:nb {
        for bi in 0:nb {
            if (reach & (1 << bi)) == 0 { -> }
            b := f.blocks[bi]
            if b.tkind == 1 { reach = reach | (1 << b.ta) }
            if b.tkind == 2 { reach = reach | (1 << b.tb) | (1 << b.tc) }
        }
    }
    mut dom := []int{}
    for bi in 0:nb {
        if bi == 0 { dom.push(1) }
        else if (reach & (1 << bi)) != 0 { dom.push(reach) }
        else { dom.push(0) }
    }
    mut converged := false
    for _ in 0:nb + 1 {
        mut changed := false
        for bi in 1:nb {
            if (reach & (1 << bi)) == 0 { -> }
            mut incoming := reach
            for pr in 0:nb {
                if (reach & (1 << pr)) != 0 && mir_verify_edge(&*f, pr, bi) {
                    incoming = incoming & dom[pr]
                }
            }
            incoming = incoming | (1 << bi)
            if incoming != dom[bi] {
                mfn_set_i(mut &dom, bi, incoming)
                changed = true
            }
        }
        if !changed { converged = true
            <- }
    }
    // Nothing has been mutated on a failed analysis/budget path.
    if !converged { << false }
    mut depth := []int{}
    for bi in 0:nb {
        mut n := 0
        for di in 0:nb { if (dom[bi] & (1 << di)) != 0 { n += 1 } }
        depth.push(n)
    }
    mut rec_op := []int{}
    mut rec_lhs := []int{}
    mut rec_rhs := []int{}
    mut rec_dest := []int{}
    mut rec_block := []int{}
    mut changed := false
    // Strict dominators have smaller depth. Visit them first even when CFG
    // block IDs run backwards; siblings never provide a replacement.
    for level in 1:nb + 1 {
        for bi in 0:nb {
            if depth[bi] != level { -> }
            mut ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                if mir_ssa_cse_bin_f(&*f, ii) {
                    dest := mfn_ia(&f.instrs, ii)
                    op := mfn_ib(&f.instrs, ii)
                    lhs := mir_ssa_resolve(&*aliases, mfn_ic(&f.instrs, ii))
                    rhs := mir_ssa_resolve(&*aliases, mfn_id(&f.instrs, ii))
                    mut usable := !pinned[dest]
                    if lhs >= 0 && pinned[lhs] { usable = false }
                    if rhs >= 0 && pinned[rhs] { usable = false }
                    if usable {
                        mut found := -1
                        for ri in 0:rec_dest.len {
                            if rec_op[ri] != op || (dom[bi] & (1 << rec_block[ri])) == 0 { -> }
                            same := mir_ssa_same_value(&*f, lhs, rec_lhs[ri]) && mir_ssa_same_value(&*f, rhs, rec_rhs[ri])
                            mut swapped := false
                            if op != 2 { swapped = mir_ssa_same_value(&*f, lhs, rec_rhs[ri]) && mir_ssa_same_value(&*f, rhs, rec_lhs[ri]) }
                            if same || swapped { found = rec_dest[ri]
                                <- }
                        }
                        if found >= 0 {
                            // Preserve the original ID/link/source location;
                            // established alias rewriting/pruning removes Copy.
                            mfn_become_copy(mut &f.instrs, ii, found)
                            mfn_set_i(aliases, dest, found)
                            changed = true
                        } else {
                            rec_op.push(op)
                            rec_lhs.push(lhs)
                            rec_rhs.push(rhs)
                            rec_dest.push(dest)
                            rec_block.push(bi)
                        }
                    }
                }
                ii = mfn_inext(&f.instrs, ii)
            }
        }
    }
    << changed
}
