fn (c &mut Checker) intern_ref(s &string) int {
    hit := strmap_get(&c.str_map, s)
    if hit >= 0 && hit < c.strings.len {
        // Verify the hit really is this string — a false-positive map match
        // would intern many distinct literals at the same id (database_sql
        // `"FROM"` aliased onto strings[0] garbage).
        stored0 := c.strings[hit] + ""
        if stored0.len == s.len {
            mut same := true
            mut i := 0
            while i < s.len {
                if (stored0[i] & 255) != (s[i] & 255) {
                    same = false
                    <-
                }
                i = i + 1
            }
            if same {
                << hit
            }
        }
    }
    stored := str_owned_copy(s)
    id := c.strings.len
    strmap_put(mut &c.str_map, stored, id)
    c.strings.push(str_owned_copy(s))
    << id
}

fn (c &mut Checker) intern(s string) int {
    << c.intern_ref(&s)
}

// M191: growable string builder for hot concat (map keys, mangle, labels).
// Backed by the runtime push_str path (amortized doubling, memmove-speed
// appends) instead of byte-wise []int pushes. Byte-wise writers stage into
// `pend` and flush on write_str/finish or when the stage fills.
struct StrBuf {
    buf string
    pend []int
}

fn new_strbuf(cap int) StrBuf {
    << StrBuf{buf: "", pend: []int{}}
}

fn (sb &mut StrBuf) flush() {
    if sb.pend.len > 0 {
        chunk := string_from_bytes(sb.pend)
        sb.pend = []int{}
        r := mut &sb.buf
        r.push_str(chunk)
    }
}

fn (sb &mut StrBuf) write_byte(c int) {
    sb.pend.push(c & 255)
    if sb.pend.len >= 64 {
        sb.flush()
    }
}

fn (sb &mut StrBuf) write_str(s string) {
    sb.flush()
    r := mut &sb.buf
    r.push_str(s)
}

fn (sb &mut StrBuf) finish() string {
    sb.flush()
    << sb.buf + ""
}

fn map_key(mod string, name string) string {
    mut sb := new_strbuf(mod.len + 1 + name.len)
    sb.write_str(mod)
    sb.write_byte(31)
    sb.write_str(name)
    << sb.finish()
}

fn method_key(mod string, sname string, mname string) string {
    << map_key(mod, sname + "." + mname)
}

fn file_key(file int, name string) string {
    << str(file) + string_from_byte(31) + name
}

fn last_dot(s string) int {
    mut i := s.len - 1
    while i >= 0 {
    if s[i] == 46 {
        << i
    }
    i = i - 1
    }
    << -1
}

fn first_dot(s string) int {
    for i in 0:s.len {
        if s[i] == 46 {
            << i
        }
    }
    << -1
}

// Materialise the prefix before a dot instead of returning a borrowed slice.
// Hosted Gen2 can invalidate a slice descriptor when it crosses the
// by-value `file_key` call; module/import lookup must remain stable.
fn local_before_dot(path string, dot int) string {
    mut out := ""
    if dot <= 0 {
        << out
    }
    for i in 0:dot {
        out = out + string_from_byte(path[i])
    }
    << out
}

fn import_default_qualifier(path string, alias string) string {
    if alias.len > 0 {
        << alias + ""
    }
    s := path + ""
    mut cut := -1
    mut i := s.len - 1
    while i >= 0 {
        if s[i] == 47 {
            cut = i
            <-
        }
        i = i - 1
    }
    if cut < 0 {
        << s + ""
    }
    << s[cut + 1:s.len]
}

fn (c &Checker) qual_to_mod(q string) string {
    k := file_key(c.cur_file, q)
    idx := strmap_get(&c.vis_map, &k)
    if idx >= 0 && idx < c.imp_path.len {
        << c.imp_path[idx] + ""
    }
    << ""
}

// Resolve the import qualifier in a type spelling (e.g. `ast` in
// `ast.Token`).  The parser argument was never used and made hosted Gen2
// type lowering synthesize an unstable cross-module reference; keep this
// helper checker-local and pass only the copied spelling.
fn (c &Checker) mod_of_import_qual(sval string) string {
    hold := sval + ""
    fd := first_dot(hold + "")
    if fd <= 0 {
        << ""
    }
    // Do not pass a borrowed `hold[..fd]` slice into file_key: Gen2's
    // by-value string ABI may consume that descriptor before the map probe.
    head := local_before_dot(hold + "", fd)
    k := file_key(c.cur_file, head + "")
    idx := strmap_get(&c.vis_map, &k)
    if idx >= 0 && idx < c.imp_path.len {
        << c.imp_path[idx] + ""
    }
    << ""
}

fn (c &mut Checker) note_fn_index() {
    i := c.fns.len - 1
    if i < 0 {
        <<
    }
    // Clone out of the array slot first — reading c.fns[i].name by value into
    // map_key on WoA x64 can see a dirty string after large CFn push.
    if c.fns[i].recv >= 0 {
        mid := c.fns[i].mod_id + ""
        rn := c.fns[i].recv_name + ""
        nm := c.fns[i].name + ""
        k := method_key(mid + "", rn + "", nm + "")
        prev := strmap_get(&c.method_map, &k)
        if prev < 0 || c.fns[i].is_template {
            strmap_put(mut &c.method_map, k, i)
        }
        <<
    }
    mid := c.fns[i].mod_id + ""
    nm := c.fns[i].name + ""
    c.note_fn_index_named(nm + "", mid + "", c.fns[i].is_template)
}

// Index using caller-owned name/mod (do not re-read from c.fns[i]).
fn (c &mut Checker) note_fn_index_named(name string, mod string, is_template bool) {
    i := c.fns.len - 1
    if i < 0 {
        <<
    }
    nm := name + ""
    mid := mod + ""
    // Simple key — avoid map_key StrBuf path on the hot register path.
    k := mid + string_from_byte(31) + nm
    prev := strmap_get(&c.fn_map, &k)
    if prev < 0 || is_template {
        strmap_put(mut &c.fn_map, k, i)
    }
}

fn (c &mut Checker) note_st_index() {
    i := c.structs.len - 1
    k := map_key(c.structs[i].mod_id, c.structs[i].name)
    if strmap_get(&c.st_map, &k) < 0 {
        strmap_put(mut &c.st_map, k, i)
    }
}

// ===== M9 module helpers =====

// Replace '.' with '_' for label mangling (math.vec → math_vec).
fn mangle_mod(mod string) string {
    if modulepath.is_external(&mod) { << modulepath.symbol(&mod) }
    mut out := ""
    for i in 0:mod.len {
        ch := mod[i]
        if ch == 47 {
            out = out + "_"
        } else {
            out = out + string_from_byte(ch)
        }
    }
    << out
}
