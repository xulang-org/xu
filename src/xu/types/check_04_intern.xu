fn (c &mut Checker) seed_strmaps() {
    zero_strmap(mut &c.str_map)
    zero_strmap(mut &c.fn_map)
    zero_strmap(mut &c.st_map)
    zero_strmap(mut &c.inst_map)
    zero_strmap(mut &c.mod_map)
    zero_strmap(mut &c.alias_map)
    zero_strmap(mut &c.vis_map)
    zero_strmap(mut &c.const_map)
    zero_strmap(mut &c.iface_map)
    zero_strmap(mut &c.stpl_map)
    zero_strmap(mut &c.etpl_map)
    zero_strmap(mut &c.method_map)
    zero_strmap(mut &c.subst_map)
    zero_strmap(mut &c.array_map)
    zero_strmap(mut &c.throw_map)
    zero_strmap(mut &c.chan_map)
    zero_strmap(mut &c.map_map)
    zero_strmap(mut &c.fn_sig_map)
    zero_strmap(mut &c.iface_glob_map)
    // Parallel fn tables — untouched until register/throw; corrupt caps from
    // Checker field init would OOM on first reassignment drop.
    c.fns = []CFn{}
    c.fndecl = []int{}
    c.fn_file = []int{}
    c.fnlocals = [][]int{}
    c.is_inst = []int{}
    c.inst_snap_ready = []int{}
    c.inst_keys = []string{}
    c.clos_env = []int{}
    c.clos_caps = [][]int{}
    c.bound_mfi = []int{}
    c.inst_t0 = []int{}
    c.inst_targs = [][]int{}
    c.targs = []int{}
    c.fn_may_throw = []int{}
    c.fn_throw_ty = []int{}
    c.fn_safe_name = []string{}
    c.fn_safe_mod = []string{}
}

