@xu/types

#xu/ast
#xu/parser

fn (c &Checker) fn_is_user_main(fi int) bool {
    if fi < 0 || fi >= c.fn_safe_mod.len {
        << false
    }
    m := c.fn_safe_mod[fi] + ""
    << m == "main" || m.len == 0
}

fn (c &mut Checker) detect_recursion(p &parser.Parser) {
    n := c.n_src_fns
    if n <= 0 {
        <<
    }
    // Self-host / large @main units: tree walkers are expected. Same
    // nfn>=64 gate as RA. Small user programs (fib, ping/pong) still warn.
    mut n_main := 0
    for i in 0:n {
        if c.fn_is_user_main(i) {
            n_main += 1
        }
    }
    if n_main >= 64 {
        <<
    }
    mut g_head := []int{}
    mut g_to := []int{}
    mut g_next := []int{}
    mut gt_head := []int{}
    mut gt_to := []int{}
    mut gt_next := []int{}
    for i in 0:n {
        g_head.push(-1)
        gt_head.push(-1)
    }
    c.dr_build_csr(n, mut &g_head, mut &g_to, mut &g_next, mut &gt_head, mut &gt_to, mut &gt_next)
    mut order := []int{}
    for i in 0:n {
        order.push(0)
    }
    on := c.dr_dfs_finish(n, &g_head, &g_to, &g_next, mut &order)
    mut comp := []int{}
    for i in 0:n {
        comp.push(-1)
    }
    ncomp := c.dr_dfs_scc(n, on, &order, &gt_head, &gt_to, &gt_next, mut &comp)
    c.dr_emit_warns(p, n, ncomp, &comp, &g_head, &g_to, &g_next)
}

fn (c &Checker) dr_build_csr(n int, g_head &mut []int, g_to &mut []int, g_next &mut []int, gt_head &mut []int, gt_to &mut []int, gt_next &mut []int) {
    // Manual edge indices: Gen1→Gen2 must not trust live `[]T.len` across push/call.
    n_cg := c.cg_from.len
    mut ne := 0
    mut net := 0
    for e in 0:n_cg {
        u := c.canonical_fn(c.cg_from[e])
        v := c.canonical_fn(c.cg_to[e])
        if u < 0 || u >= n || v < 0 || v >= n {
            ->
        }
        ei := ne
        g_to.push(v)
        g_next.push(g_head[u])
        g_head[u] = ei
        ne = ne + 1
        e2 := net
        gt_to.push(u)
        gt_next.push(gt_head[v])
        gt_head[v] = e2
        net = net + 1
    }
}

fn (c &Checker) dr_dfs_finish(n int, g_head &[]int, g_to &[]int, g_next &[]int, order &mut []int) int {
    mut visited := []bool{}
    mut stk := []int{}
    mut it := []int{}
    mut on := 0
    for i in 0:n {
        visited.push(false)
        stk.push(0)
        it.push(0)
    }
    for s in 0:n {
        if visited[s] {
            ->
        }
        visited[s] = true
        mut sp := 1
        stk[0] = s
        it[0] = g_head[s]
        while sp > 0 {
            top := sp - 1
            u := stk[top]
            e := it[top]
            if e >= 0 {
                it[top] = g_next[e]
                w := g_to[e]
                if !visited[w] {
                    visited[w] = true
                    stk[sp] = w
                    it[sp] = g_head[w]
                    sp = sp + 1
                }
            } else {
                order[on] = u
                on = on + 1
                sp = top
            }
        }
    }
    << on
}

fn (c &Checker) dr_dfs_scc(n int, on int, order &[]int, gt_head &[]int, gt_to &[]int, gt_next &[]int, comp &mut []int) int {
    mut stk := []int{}
    for i in 0:n {
        stk.push(0)
    }
    mut ncomp := 0
    for oi in 0:on {
        r := order[on - 1 - oi]
        if comp[r] >= 0 {
            ->
        }
        comp[r] = ncomp
        mut sp := 1
        stk[0] = r
        while sp > 0 {
            top := sp - 1
            u := stk[top]
            sp = top
            mut e := gt_head[u]
            while e >= 0 {
                w := gt_to[e]
                if comp[w] < 0 {
                    comp[w] = ncomp
                    stk[sp] = w
                    sp = sp + 1
                }
                e = gt_next[e]
            }
        }
        ncomp = ncomp + 1
    }
    << ncomp
}

fn (c &mut Checker) dr_emit_warns(p &parser.Parser, n int, ncomp int, comp &[]int, g_head &[]int, g_to &[]int, g_next &[]int) {
    mut scc_count := []int{}
    mut scc_min := []int{}
    mut scc_selfloop := []bool{}
    for i in 0:ncomp {
        scc_count.push(0)
        scc_min.push(n)
        scc_selfloop.push(false)
    }
    for i in 0:n {
        cid := comp[i]
        if cid < 0 || cid >= ncomp {
            ->
        }
        scc_count[cid] = scc_count[cid] + 1
        if i < scc_min[cid] {
            scc_min[cid] = i
        }
    }
    n_cg := c.cg_from.len
    for e in 0:n_cg {
        u := c.canonical_fn(c.cg_from[e])
        v := c.canonical_fn(c.cg_to[e])
        if u < 0 || u >= n || v < 0 || v >= n {
            ->
        }
        if u == v && comp[u] >= 0 && comp[u] < ncomp {
            scc_selfloop[comp[u]] = true
        }
    }
    mut stk := []int{}
    mut it := []int{}
    mut in_path := []bool{}
    mut path := []int{}
    for i in 0:n {
        stk.push(0)
        it.push(0)
        in_path.push(false)
        path.push(0)
    }
    for start in 0:n {
        cid := comp[start]
        if cid < 0 || cid >= ncomp {
            ->
        }
        if start != scc_min[cid] {
            ->
        }
        if !c.fn_is_user_main(start) {
            ->
        }
        if scc_count[cid] < 2 && !scc_selfloop[cid] {
            ->
        }
        for i in 0:n {
            in_path[i] = false
        }
        in_path[start] = true
        mut path_n := 1
        path[0] = start
        mut sp := 1
        stk[0] = start
        it[0] = g_head[start]
        mut found := false
        while sp > 0 {
            if found {
                <-
            }
            top := sp - 1
            u := stk[top]
            mut e := it[top]
            mut advanced := false
            while e >= 0 {
                if found {
                    <-
                }
                w := g_to[e]
                ne := g_next[e]
                if comp[w] == cid && w == start {
                    found = true
                    <-
                }
                if comp[w] == cid && !in_path[w] {
                    it[top] = ne
                    in_path[w] = true
                    stk[sp] = w
                    it[sp] = g_head[w]
                    path[path_n] = w
                    path_n = path_n + 1
                    sp = sp + 1
                    advanced = true
                    <-
                }
                e = ne
            }
            if found {
                <-
            }
            if !advanced {
                in_path[u] = false
                sp = top
                if path_n > 0 {
                    path_n = path_n - 1
                }
            }
        }
        mut msg := c.fns[start].name + ""
        for k in 1:path_n {
            msg = msg + " -> " + c.fns[path[k]].name
        }
        msg = msg + " -> " + c.fns[start].name
        d := c.fndecl[start]
        c.warn_at(c.fn_file[start], p.nodes[d].line, p.nodes[d].col, "recursive call cycle: " + msg + " (may overflow the stack)")
    }
}

// Prepare a monomorphized instance for MIR: re-check body with concrete
// signature so ntype/ncall/fnlocals match this instance.
fn (c &mut Checker) prepare_instance(p &parser.Parser, fi int) {
    if c.is_inst[fi] == 0 {
        <<
    }
    d := c.fndecl[fi]
    // Restore Param→concrete subst from type args stored at instantiate time.
    // Multi-param generics (sort.slice_func#T) cannot recover T from a
    // params.len==1 heuristic; use inst_t0 / inst_targs.
    c.clear_subst()
    mut tp := p.nodes[d].e
    if c.fns[fi].recv >= 0 {
        ti := c.find_stpl(c.fns[fi].recv_name, c.fns[fi].mod_id)
        if ti >= 0 { tp = p.nodes[c.stpl_decl[ti]].e }
    }
    mut ai := 0
    while tp >= 0 {
        skip_lt := c.fns[fi].recv < 0 && c.fn_has_lt(fi, p.nodes[tp].sval)
        if !skip_lt {
            mut concrete := -1
            if fi < c.inst_t0.len {
                if ai == 0 {
                    concrete = c.inst_t0[fi]
                } else if fi < c.inst_targs.len && ai < c.inst_targs[fi].len {
                    concrete = c.inst_targs[fi][ai]
                }
            }
            if concrete < 0 && c.fns[fi].params.len >= 1 && ai == 0 {
                p0 := c.fns[fi].params[0]
                if is_param_type(p0) {
                    concrete = p0
                } else if is_ref_type(p0) {
                    inner := c.ref_inner_type(p0)
                    if is_array_type(inner) {
                        concrete = c.arrays[array_index(inner)].elem_ty
                    } else {
                        concrete = inner
                    }
                } else {
                    concrete = p0
                }
            }
            if concrete >= 0 {
                c.set_subst_pair(p.nodes[tp].sval, concrete)
            }
            ai += 1
        }
        tp = p.nodes[tp].next
    }
    c.check_fn(p, d, fi)
    c.borrow_check_fn(p, d)
    c.fix_inst_fnlocals(fi)
    c.clear_subst()
}

fn (c &mut Checker) snap_instance(fi int) {
    while c.inst_snap_type.len <= fi {
        c.inst_snap_type.push([]int{})
        c.inst_snap_local.push([]int{})
        c.inst_snap_call.push([]int{})
        c.inst_snap_str.push([]int{})
        c.inst_snap_const.push([]int{})
        c.inst_snap_clone.push([]int{})
        c.inst_snap_box.push([]int{})
    }
    mut trow := []int{}
    mut lrow := []int{}
    mut crow := []int{}
    mut srow := []int{}
    mut krow := []int{}
    mut clrow := []int{}
    mut brow := []int{}
    for i in 0:c.ntype.len {
        trow.push(c.ntype[i])
        lrow.push(c.nlocal[i])
        crow.push(c.ncall[i])
        srow.push(c.nstr[i])
        krow.push(c.nconst[i])
        clrow.push(c.nclone[i])
        brow.push(c.nbox[i])
    }
    c.inst_snap_type[fi] = trow
    c.inst_snap_local[fi] = lrow
    c.inst_snap_call[fi] = crow
    c.inst_snap_str[fi] = srow
    c.inst_snap_const[fi] = krow
    c.inst_snap_clone[fi] = clrow
    c.inst_snap_box[fi] = brow
    while c.inst_snap_ready.len <= fi {
        c.inst_snap_ready.push(0)
    }
    checker_set_i(mut &c.inst_snap_ready, fi, 1)
}

fn (c &mut Checker) restore_instance(fi int) {
    if fi < 0 || fi >= c.inst_snap_ready.len || c.inst_snap_ready[fi] == 0 {
        <<
    }
    if fi >= c.inst_snap_type.len {
        <<
    }
    for i in 0:c.ntype.len {
        si5 := c.inst_snap_type[fi][i]
        checker_set_i(mut &c.ntype, i, si5)
        si6 := c.inst_snap_local[fi][i]
        checker_set_i(mut &c.nlocal, i, si6)
        si7 := c.inst_snap_call[fi][i]
        checker_set_i(mut &c.ncall, i, si7)
        si8 := c.inst_snap_str[fi][i]
        checker_set_i(mut &c.nstr, i, si8)
        si9 := c.inst_snap_const[fi][i]
        checker_set_i(mut &c.nconst, i, si9)
        si10 := c.inst_snap_clone[fi][i]
        checker_set_i(mut &c.nclone, i, si10)
        si11 := c.inst_snap_box[fi][i]
        checker_set_i(mut &c.nbox, i, si11)
    }
}

fn (c &mut Checker) finalize_instance(p &parser.Parser, fi int) {
    c.prepare_instance(p, fi)
    c.snap_instance(fi)
}

// Monomorphized bodies share one AST; locals may still carry Param(T) or other
// stale tags after a prior instance prepare. Refresh fnlocals from inst_elem_t0.
fn (c &mut Checker) fix_inst_fnlocals(fi int) {
    if fi < 0 || fi >= c.fns.len || c.is_inst[fi] == 0 {
        <<
    }
    t0 := c.inst_elem_t0(fi)
    if t0 < 0 {
        <<
    }
    if fi >= c.fnlocals.len {
        <<
    }
    mut row := []int{}
    for j in 0:c.fnlocals[fi].len {
        mut ty := c.fnlocals[fi][j]
        if is_param_type(ty) {
            ty = t0
        } else if ty == 3 && t0 == 4 {
            ty = t0
        } else if is_ref_type(ty) {
            inner := c.ref_inner_type(ty)
            if is_array_type(inner) {
                ai := array_index(inner)
                if is_param_type(c.arrays[ai].elem_ty) {
                    inner2 := c.intern_array_type(t0)
                    if is_mut_ref_type(ty) {
                        ty = c.make_ref_type(true, inner2)
                    } else {
                        ty = c.make_ref_type(false, inner2)
                    }
                }
            }
        } else if is_array_type(ty) {
            ai := array_index(ty)
            if is_param_type(c.arrays[ai].elem_ty) {
                ty = c.intern_array_type(t0)
            }
        }
        row.push(ty)
    }
    c.fnlocals[fi] = row
}

fn (c &Checker) inst_elem_t0(fi int) int {
    if fi < 0 || fi >= c.fns.len || c.is_inst[fi] == 0 {
        << -1
    }
    if c.fns[fi].params.len == 1 {
        mut p0 := c.fns[fi].params[0]
        if is_ref_type(p0) {
            p0 = c.ref_inner_type(p0)
        }
        if is_array_type(p0) {
            << c.arrays[array_index(p0)].elem_ty
        }
        if !is_param_type(p0) {
            << p0
        }
    }
    if fi < c.inst_t0.len {
        t0 := c.inst_t0[fi]
        if t0 >= 0 {
            << t0
        }
    }
    << -1
}

fn (c &Checker) find_inst_for_key(template_fi int, mkey string) int {
    ik := str(template_fi) + "/" + mkey
    << strmap_get(&c.inst_map, &ik)
}

// Element type of the first array argument at a call (for generic dispatch).
fn (c &Checker) call_arg_array_elem(p &parser.Parser, n int) int {
    mut arg := p.nodes[n].a
    if p.nodes[n].kind == ast.NK_METHOD_CALL {
        fi0 := c.ncall[n]
        if fi0 >= 0 && fi0 < c.fns.len && c.fns[fi0].recv < 0 {
            arg = p.nodes[n].b
        }
    }
    if arg < 0 {
        << -1
    }
    mut aty := c.direct_type(c.ntype[arg])
    if is_ref_type(c.ntype[arg]) {
        aty = c.ref_inner_type(aty)
    }
    if !is_array_type(aty) {
        << -1
    }
    << c.arrays[array_index(aty)].elem_ty
}

// Shared-template monomorphs can leave a stale ncall (e.g. slice<string> on
// an f64 wrapper call). Re-resolve from call-site array element type.
fn (c &Checker) resolve_call_instance(p &parser.Parser, n int, fi int, caller_fi int) int {
    mut elem := c.call_arg_array_elem(p, n)
    if elem < 0 || is_param_type(elem) {
        if caller_fi >= 0 && caller_fi < c.fns.len {
            ce := c.fn_array_elem_param(caller_fi)
            if ce >= 0 && !is_param_type(ce) {
                elem = ce
            }
        }
    }
    if elem < 0 || is_param_type(elem) {
        << fi
    }
    mut tmpl := fi
    if fi >= 0 && fi < c.fns.len {
        if c.is_inst[fi] != 0 {
            inst_elem := c.inst_elem_t0(fi)
            if inst_elem < 0 || inst_elem == elem {
                << fi
            }
            tmpl = c.template_for_fn(fi)
        } else if c.fns[fi].is_template {
            tmpl = fi
        } else {
            << fi
        }
    } else {
        << fi
    }
    if tmpl < 0 || !c.fns[tmpl].is_template {
        << fi
    }
    d := c.fndecl[tmpl]
    mut ntp := 0
    mut tp := p.nodes[d].e
    while tp >= 0 {
    ntp += 1
    tp = p.nodes[tp].next
    }
    if ntp != 1 {
        << fi
    }
    mkey := c.mangle_ty(elem)
    alt := c.find_inst_for_key(tmpl, mkey)
    if alt >= 0 {
        << alt
    }
    << fi
}

fn (c &Checker) fn_array_elem_param(fi int) int {
    if fi < 0 || fi >= c.fns.len || c.fns[fi].params.len != 1 {
        << -1
    }
    mut p0 := c.fns[fi].params[0]
    if is_ref_type(p0) {
        p0 = c.ref_inner_type(p0)
    }
    if is_array_type(p0) {
        << c.arrays[array_index(p0)].elem_ty
    }
    << -1
}
