@xu/types

#xu/parser

// The LoadIndex temp currently aliases owning string headers inside `base`.
// Replace each string field with a StrClone so a later StoreIndex drop of
// some other slot cannot free the source element. StoreField copies words
// and does not drop the previous header.
fn (f &mut MFn) clone_struct_fields(c &Checker, base int, ty int, depth int) {
    if depth > 8 { << }
    if !is_struct_type(ty) { << }
    si := struct_index(ty)
    if si < 0 || si >= c.structs.len { << }
    for i in 0:c.structs[si].fields.len {
        fty := c.structs[si].fields[i].ty
        off := c.structs[si].fields[i].slot
        if fty == 3 {
            cur := f.new_temp(3, 3)
            mut lf := mkinstr(10)
            lf.a = cur
            lf.b = base
            lf.c = off
            lf.d = 3
            f.emit(lf)
            cloned := f.new_temp(3, 3)
            mut cp := mkinstr(9)
            cp.a = cloned
            cp.b = cur
            f.emit(cp)
            mut sf := mkinstr(11)
            sf.a = cloned
            sf.b = base
            sf.c = off
            sf.d = 3
            f.emit(sf)
        } else if is_struct_type(fty) && c.type_owning(fty) {
            ns := c.type_slots(fty)
            cur := f.new_temp(fty, ns)
            mut lf2 := mkinstr(10)
            lf2.a = cur
            lf2.b = base
            lf2.c = off
            lf2.d = ns
            f.emit(lf2)
            f.clone_struct_fields(c, cur, fty, depth + 1)
            mut sf2 := mkinstr(11)
            sf2.a = cur
            sf2.b = base
            sf2.c = off
            sf2.d = ns
            f.emit(sf2)
        }
    }
}

fn (f &mut MFn) lower_expr_ident(p &parser.Parser, c &mut Checker, n int) int {
    // Package const (M8): fold to immediate / StrConst.
    if c.nconst[n] >= 0 {
        ci := c.nconst[n]
        if c.ctypes[ci] == 3 {
            t := f.new_temp(3, 3)
            mut ins := mkinstr(6)
            ins.a = t
            ins.b = c.cstr_idx[ci]
            f.emit(ins)
            << t
        }
        << f.vconst(c.civals[ci])
    }
    // M109: capture remapped to env.field (nstr = field index).
    if c.ncall[n] == -90 {
        env_ptr := f.new_temp(1, 1)
        mut pl := mkinstr(2)
        pl.a = env_ptr
        pl.b = 0 // local _env
        f.emit(pl)
        env_ty := f.locals[0]
        si := struct_index(c.ref_inner_type(env_ty))
        fi := c.nstr[n]
        slot := c.structs[si].fields[fi].slot
        fty := c.structs[si].fields[fi].ty
        count := c.type_slots(fty)
        dest := f.new_temp(fty, count)
        mut lf := mkinstr(17) // LoadPtrField
        lf.a = dest
        lf.b = env_ptr
        lf.c = slot
        lf.d = count
        f.emit(lf)
        if c.nclone[n] == 1 && fty == 3 {
            cloned := f.new_temp(3, 3)
            mut cp := mkinstr(9)
            cp.a = cloned
            cp.b = dest
            f.emit(cp)
            << cloned
        }
        << dest
    }
    // M103/M109: bare function name → LoadFnAddr (ncall holds fn index).
    if c.nlocal[n] < 0 && c.ncall[n] >= 0 {
        fi := c.ncall[n]
        t := f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
        mut ins := mkinstr(38)
        ins.a = t
        // `b` remains zero for the legacy LoadFnAddr ABI; emission resolves
        // the stable shim label from `sval` and does not depend on checker
        // function indices (which include templates).
        ins.b = 0
        // Shim so indirect ABI can pass A0=env: _xu_foo → _xu_fnval_foo
        // Hosted Gen1 cannot reliably take a reference to a string nested in
        // the large `c.fns` slice.  Materialise the descriptor as a local
        // before borrowing it; the shim helper then copies every byte into an
        // independently-owned result.
        real_label := c.fns[fi].label + ""
        shim := mir_fnval_real_to_shim(&real_label)
        ins.sval = shim
        f.emit(ins)
        << t
    }
    // f.locals (not c.ltype): the checker's tables hold the LAST
    // checked function's locals.
    lid := c.nlocal[n]
    // Legacy `fn (mut x T)`: local type is T, slot holds a pointer — deref.
    // M159 `fn (x &mut T)` / `&T`: local type is Ref, slot already holds the
    // pointer — LoadLocal only (do not LoadField through it as a struct).
    if f.receiver && lid == 0 && !is_ref_type(f.locals[lid]) {
        ptr := f.new_temp(1, 1)
        mut pl := mkinstr(2)
        pl.a = ptr
        pl.b = lid
        f.emit(pl)
        t := f.new_temp(f.locals[lid], c.type_slots(f.locals[lid]))
        mut lp := mkinstr(17)
        lp.a = t
        lp.b = ptr
        lp.c = 0
        lp.d = c.type_slots(f.locals[lid])
        f.emit(lp)
        << t
    }
    t := f.new_temp(f.locals[lid], f.locals_nslots[lid])
    mut ins := mkinstr(2)
    ins.a = t
    ins.b = c.nlocal[n]
    f.emit(ins)
    // M108 / M4: string Ident marked nclone → heap clone (barrier auto-clone).
    if c.nclone[n] == 1 && c.ntype[n] == 3 {
        cloned := f.new_temp(3, 3)
        mut cp := mkinstr(9)
        cp.a = cloned
        cp.b = t
        f.emit(cp)
        << cloned
    }
    << t
}

// M178: Field arm of lower_expr
fn (f &mut MFn) lower_expr_field(p &parser.Parser, c &mut Checker, n int) int {
    // Module-qualified free function values use the same fat-pointer
    // materialization as a bare function identifier.
    if is_fn_type(c.ntype[n]) && c.ncall[n] >= 0 {
        << f.lower_expr_ident(p, c, n)
    }
    if c.ncall[n] == -92 {
        // Method value: Env{self=obj} + MakeClosure(method label).
        mfi := c.nlocal[n]
        si := c.nstr[n]
        env_sty := struct_type(si)
        ns := c.structs[si].nslots
        obj_t := f.lower_expr(p, c, p.nodes[n].a)
        f.mark_move_of(p, c, p.nodes[n].a)
        env_t := f.new_temp(env_sty, ns)
        fty := c.structs[si].fields[0].ty
        count := c.type_slots(fty)
        mut sf := mkinstr(11)
        sf.a = obj_t
        sf.b = env_t
        sf.c = 0
        sf.d = count
        f.emit(sf)
        dest := f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
        mut mc := mkinstr(39)
        mc.a = dest
        mc.b = env_t
        mc.c = si
        mc.sval = c.fns[mfi].label
        f.emit(mc)
        << dest
    }
    if c.ncall[n] == -95 {
        // M154: Env{self=&T|&mut T} + MakeClosure(trampoline).
        tramp_fi := c.nlocal[n]
        si := c.nstr[n]
        env_sty := struct_type(si)
        obj := p.nodes[n].a
        mut ptr_t := -1
        if is_ref_type(c.ntype[obj]) {
            ptr_t = f.lower_expr(p, c, obj)
            f.mark_move_of(p, c, obj)
        } else {
            ptr_t = f.lower_addr(p, c, obj)
        }
        env_t := f.new_temp(env_sty, 1)
        mut sf := mkinstr(11)
        sf.a = ptr_t
        sf.b = env_t
        sf.c = 0
        sf.d = 1
        f.emit(sf)
        dest := f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
        mut mc := mkinstr(39)
        mc.a = dest
        mc.b = env_t
        mc.c = si
        mc.sval = c.fns[tramp_fi].label
        f.emit(mc)
        << dest
    }
    if c.ncall[n] == -96 {
        // Folded `[N]T.len` (nlocal holds N).
        << f.vconst(c.nlocal[n])
    }
    if c.ncall[n] == -30 {
        // Unit enum variant construction: tag only.
        sty := c.ntype[n]
        dest := f.new_temp(sty, c.type_slots(sty))
        tagt := f.new_temp(1, 1)
        mut cp := mkinstr(1)
        cp.a = tagt
        cp.b = f.vconst(c.nlocal[n])
        f.emit(cp)
        mut tag := mkinstr(11) // StoreField
        tag.a = tagt
        tag.b = dest
        tag.c = 0
        tag.d = 1
        f.emit(tag)
        << dest
    }
    if c.nconst[n] >= 0 {
        ci := c.nconst[n]
        if c.ctypes[ci] == 3 {
            t := f.new_temp(3, 3)
            mut ins := mkinstr(6)
            ins.a = t
            ins.b = c.cstr_idx[ci]
            f.emit(ins)
            << t
        }
        << f.vconst(c.civals[ci])
    }
    obj := p.nodes[n].a
    raw_oty := c.ntype[obj]
    oty := c.direct_type(raw_oty)
    // through_ptr: by-pointer receiver, or any reference value (M10: ref
    // may live in a struct field — auto-deref via the pointer temp).
    through_ptr := is_ref_type(raw_oty) || (p.nodes[obj].kind == 4 && f.receiver && c.nlocal[obj] == 0)
    buf := through_ptr && is_ref_type(raw_oty) && f.ref_expr_is_buf(p, &*c, obj, 0)
    through_struct_local := !through_ptr && p.nodes[obj].kind == 4 && is_struct_type(oty)
    // `sys[i].x` must not LoadIndex the whole Body then LoadField. The
    // write path already uses ElemAddr + buffer loads; reads of a struct
    // element field use the same address.
    through_index := !through_ptr && !through_struct_local && is_struct_type(oty) && chain_has_index(p, obj)
    index_buf := through_index && f.chain_index_is_buf(p, &*c, obj)
    // Base for LoadField/LoadPtrField: ref values already ARE pointers
    // (lower_expr); by-ptr locals need lower_addr. Direct struct locals
    // take the frame address so SROA can see field traffic instead of a
    // whole-aggregate copy.
    mut base := -1
    if through_ptr {
        if is_ref_type(raw_oty) {
            base = f.lower_expr(p, c, obj)
        } else {
            base = f.lower_addr(p, c, obj)
        }
    } else if through_struct_local {
        // A direct field read borrows a known local frame object. Preserve
        // its pointee type so the address contract can keep it frame-backed
        // while independent integer Temps use the general register allocator.
        lid := c.nlocal[obj]
        if lid >= 0 && lid < f.locals.len && !(f.receiver && lid == 0) && f.locals[lid] == oty && oty > 0 && oty < 1000 {
            base = f.new_temp(1000 + oty, 1)
            mut ad := mkinstr(16)
            ad.a = base
            ad.b = lid
            ad.c = 0
            f.emit(ad)
        } else {
            base = f.lower_addr(p, c, obj)
        }
    } else if through_index {
        base = f.lower_chain_addr(p, c, obj, index_buf)
    } else {
        base = f.lower_expr(p, c, obj)
    }
    if oty == 3 { // string.len
        dest := f.new_temp(1, 1)
        mut load_kind := 10
        if through_ptr {
            if buf { load_kind = 26 } else { load_kind = 17 }
        }
        mut ins := mkinstr(load_kind)
        ins.a = dest
        ins.b = base
        // LoadField/LoadPtr offsets are bytes; string len is the second word.
        ins.c = 8
        ins.d = 1
        f.emit(ins)
        // `.len` borrows the descriptor.  Release a fresh temporary receiver
        // after the load; ordinary local/field aliases stay owned by their
        // lexical binding.
        f.drop_fresh_string_expr(p, c, obj, base)
        << dest
    }
    if is_array_type(oty) {
        // Array field (s3c 阶段二: only `len` for now). nlocal holds
        // the slot offset (1 for len); 1-slot read.
        slot := c.nlocal[n]
        dest := f.new_temp(1, 1)
        mut load_kind := 10
        if through_ptr {
            if buf { load_kind = 26 } else { load_kind = 17 }
        }
        mut ins := mkinstr(load_kind)
        ins.a = dest
        ins.b = base
        ins.c = slot
        ins.d = 1
        f.emit(ins)
        << dest
    }
    si := struct_index(oty)
    fi := c.nlocal[n] // field index recorded by the checker
    slot := c.structs[si].fields[fi].slot
    fty := c.structs[si].fields[fi].ty
    count := c.type_slots(fty)
    dest := f.new_temp(fty, count)
    mut load_kind := 10
    if through_ptr {
        if buf { load_kind = 26 } else { load_kind = 17 }
    } else if through_struct_local {
        load_kind = 17
    } else if through_index {
        if index_buf { load_kind = 26 } else { load_kind = 17 }
    }
    mut ins := mkinstr(load_kind)
    ins.a = dest
    ins.b = base
    ins.c = slot
    ins.d = count
    f.emit(ins)
    if c.nclone[n] == 1 && fty == 3 {
        cloned := f.new_temp(3, 3)
        mut cp := mkinstr(9)
        cp.a = cloned
        cp.b = dest
        f.emit(cp)
        << cloned
    }
    << dest
}


// M178: MethodCall arm of lower_expr
fn (f &mut MFn) lower_expr_method(p &parser.Parser, c &mut Checker, n int) int {
    fi := c.ncall[n]
    if fi == -84 || fi == -85 || fi == -86 || fi == -87 || fi == -88 {
        << f.lower_native_map_method(p, c, n)
    }
    if fi == -30 {
        // Tuple enum variant construction: Color.Rgb(a,b,c)
        sty := c.ntype[n]
        ei := sty - 500
        vidx := c.nlocal[n]
        dest := f.new_temp(sty, c.type_slots(sty))
        tagt := f.new_temp(1, 1)
        mut cp := mkinstr(1)
        cp.a = tagt
        cp.b = f.vconst(vidx)
        f.emit(cp)
        mut tag := mkinstr(11)
        tag.a = tagt
        tag.b = dest
        tag.c = 0
        tag.d = 1
        f.emit(tag)
        mut off := 8
        mut arg := p.nodes[n].b
        mut fi2 := 0
        while arg >= 0 {
            fty := c.enums[ei].variants[vidx].fields[fi2]
            ns := c.type_slots(fty)
            vt := f.lower_expr(p, c, arg)
            f.mark_move_of(p, c, arg)
            mut stf := mkinstr(11)
            stf.a = vt
            stf.b = dest
            stf.c = off
            stf.d = ns
            f.emit(stf)
            off += ns * 8
            fi2 += 1
            arg = p.nodes[arg].next
        }
        << dest
    }
    if fi == -4 {
        // arr.push(v) — lower receiver and value, emit ArrPush.
        recv := p.nodes[n].a
        recv_ty := c.direct_type(c.ntype[recv])
        ai := recv_ty - 200
        elem_ty := c.elem_ty_of_array(recv_ty, f.src_fi)
        mut base := f.lower_addr(p, c, recv)
        mut vt := f.lower_expr(p, c, p.nodes[n].b)
        f.mark_move_of(p, c, p.nodes[n].b)
        // The runtime takes a pointer to the element value. Materialize
        // scalar constants into a real temp first.
        if vt < 0 {
            et := f.new_temp(elem_ty, c.type_slots(elem_ty))
            mut cp := mkinstr(1)
            cp.a = et
            cp.b = vt
            f.emit(cp)
            vt = et
        }
        mut wb_ptr := -1
        mut wb_desc := -1
        if f.ref_expr_is_buf(p, &*c, recv, 0) {
            // `r.push` of `mut &[]T` into an outer buffer: copy the
            // descriptor to a frame temp, push, write ptr/len/cap back.
            wb_ptr = base
            wb_desc = f.new_temp(recv_ty, 3)
            mut lp := mkinstr(26)
            lp.a = wb_desc
            lp.b = wb_ptr
            lp.c = 0
            lp.d = 3
            f.emit(lp)
            ad := f.new_temp(1, 1)
            mut ao := mkinstr(16)
            ao.a = ad
            ao.b = wb_desc
            ao.c = 1
            f.emit(ao)
            base = ad
        }
        mut ins := mkinstr(13)
        ins.a = base
        ins.b = vt
        ins.c = 1 // base is the descriptor pointer itself
        ins.d = c.type_size_bytes(elem_ty)
        f.emit(ins)
        if wb_ptr >= 0 {
            mut sp := mkinstr(25)
            sp.a = wb_desc
            sp.b = wb_ptr
            sp.c = 0
            sp.d = 3
            f.emit(sp)
        }
        << f.vconst(0)
    }
    if fi == -5 {
        // Result.is_ok() / is_err(): load the Result's tag field
        // (slot 0) and emit ResultTest.
        base := f.lower_expr(p, c, p.nodes[n].a)
        dest := f.new_temp(2, 1)
        mut ins := mkinstr(15)
        ins.a = dest
        ins.b = base
        ins.sval = p.nodes[n].sval // 'is_ok' or 'is_err'
        f.emit(ins)
        << dest
    }
    if fi == -14 {
        f.mark_move_of(p, c, p.nodes[n].a)
        base := f.lower_expr(p, c, p.nodes[n].a)
        ty := c.ntype[n]
        dest := f.new_temp(ty, c.type_slots(ty))
        mut ins := mkinstr(19)
        ins.a = dest
        ins.b = base
        ins.d = c.type_slots(ty)
        // M38: c=1 when the Err payload is a string, so the emitter passes
        // its (ptr,len) to _rt_unwrap_fail for `unwrap on Err: <msg>`.
        rty := c.ntype[p.nodes[n].a]
        ri := rty - 300
        if c.throws[ri].err_ty == 3 { ins.c = 1 } else { ins.c = 0 }
        f.emit(ins)
        << dest
    }
    if fi == -96 {
        // M157: unwrap_err — Ok fails; Err payload to dest.
        f.mark_move_of(p, c, p.nodes[n].a)
        base := f.lower_expr(p, c, p.nodes[n].a)
        ty := c.ntype[n]
        dest := f.new_temp(ty, c.type_slots(ty))
        mut ins := mkinstr(45)
        ins.a = dest
        ins.b = base
        ins.d = c.type_slots(ty)
        f.emit(ins)
        << dest
    }
    << f.lower_call(p, c, n, -1)
}

// Pure lvalue reads that may share one lowered temp as both Bin operands
// (`dx * dx`, `sys[i].vx * sys[i].vx`). Calls and other effects stay out.
fn ast_same_pure_read(p &parser.Parser, c &Checker, a int, b int) bool {
    if a < 0 || b < 0 { << false }
    if a == b { << true }
    ka := p.nodes[a].kind
    if ka != p.nodes[b].kind { << false }
    if ka == 4 {
        lid := c.nlocal[a]
        if lid < 0 || lid != c.nlocal[b] { << false }
        if c.nconst[a] >= 0 || c.nconst[b] >= 0 { << false }
        << true
    }
    if ka == 7 {
        if c.nlocal[a] != c.nlocal[b] { << false }
        << ast_same_pure_read(p, c, p.nodes[a].a, p.nodes[b].a)
    }
    if ka == 13 {
        if !ast_same_pure_read(p, c, p.nodes[a].a, p.nodes[b].a) { << false }
        << ast_same_pure_read(p, c, p.nodes[a].b, p.nodes[b].b)
    }
    << false
}

// M178: BinOp arm of lower_expr
fn (f &mut MFn) lower_expr_binop(p &parser.Parser, c &mut Checker, n int) int {
    op := p.nodes[n].ival
    if op == 12 || op == 13 { // && / || : short-circuit
        << f.lower_short_circuit(p, c, n, op)
    }
    // M173: fold int Bin when both sides are int literals (not nested folds).
    if c.ntype[n] == 1 && p.nodes[p.nodes[n].a].kind == 1 && p.nodes[p.nodes[n].b].kind == 1 {
        if op >= 1 && op <= 5 && const_binop_ok(op, p.nodes[p.nodes[n].a].ival, p.nodes[p.nodes[n].b].ival) {
            << f.vconst(const_binop_value(op, p.nodes[p.nodes[n].a].ival, p.nodes[p.nodes[n].b].ival))
        }
    }
    // Literal identities that still evaluate the non-literal operand.
    if c.ntype[n] == 1 {
        if op == 1 && p.nodes[p.nodes[n].b].kind == 1 && p.nodes[p.nodes[n].b].ival == 0 {
            << f.lower_expr(p, c, p.nodes[n].a)
        }
        if op == 1 && p.nodes[p.nodes[n].a].kind == 1 && p.nodes[p.nodes[n].a].ival == 0 {
            << f.lower_expr(p, c, p.nodes[n].b)
        }
        if op == 2 && p.nodes[p.nodes[n].b].kind == 1 && p.nodes[p.nodes[n].b].ival == 0 {
            << f.lower_expr(p, c, p.nodes[n].a)
        }
        if op == 3 && p.nodes[p.nodes[n].b].kind == 1 && p.nodes[p.nodes[n].b].ival == 1 {
            << f.lower_expr(p, c, p.nodes[n].a)
        }
    }
    mut l := 0
    mut r := 0
    if ast_same_pure_read(p, &*c, p.nodes[n].a, p.nodes[n].b) {
        l = f.lower_expr(p, c, p.nodes[n].a)
        r = l
    } else {
        l = f.lower_expr(p, c, p.nodes[n].a)
        r = f.lower_expr(p, c, p.nodes[n].b)
    }
    // Wave 3: fold Bin of two already-lowered int consts (nested  (1+2)*4 ).
    if c.ntype[n] == 1 && l <= -2 && r <= -2 && op != 4 && op != 5 {
        lv := f.consts[0 - l - 2]
        rv := f.consts[0 - r - 2]
        if op >= 1 && op <= 3 && const_binop_ok(op, lv, rv) {
            << f.vconst(const_binop_value(op, lv, rv))
        }
        if op == 14 { << f.vconst(lv & rv) }
        if op == 15 { << f.vconst(lv | rv) }
        if op == 16 { << f.vconst(lv ^ rv) }
        if op == 17 && rv >= 0 && rv < 64 { << f.vconst(lv << rv) }
        if op == 18 && rv >= 0 && rv < 64 { << f.vconst(lv >> rv) }
    }
    // Both operands have been lowered in source order. Absorbing constants
    // may discard the arithmetic result, never the operand's calls, loads,
    // growth or fail-loud checks. This also covers a folded zero expression.
    if c.ntype[n] == 1 {
        if op == 2 && l == r { << f.vconst(0) }
        if op == 16 && l == r { << f.vconst(0) }
        if r <= -2 && f.consts[0 - r - 2] == 0 {
            if op == 3 || op == 14 { << f.vconst(0) }
            if op == 15 { << l }
            if op == 16 { << l }
        }
        if l <= -2 && f.consts[0 - l - 2] == 0 {
            if op == 3 || op == 14 { << f.vconst(0) }
            if op == 15 { << r }
        }
    }
    // G3/D2: int Div/Mod gets runtime zero + INT_MIN/-1 checks
    // (mirror of xumir's div_int_guard). f64 div keeps IEEE.
    if (op == 4 || op == 5) && c.ntype[n] != 4 {
        f.div_int_guard(l, r, c.ntype[n])
    }
    // L2c-amp: `+` accepts `&string` operands; deref-read the
    // (ptr,len,cap) triple through the borrow, mirroring the `[i]` /
    // slice auto-deref path, so the concat emission below sees an
    // owned string value.
    if op == 1 {
        if r == l {
            l = f.deref_str_operand(p, c, p.nodes[n].a, l)
            r = l
        } else {
            l = f.deref_str_operand(p, c, p.nodes[n].a, l)
            r = f.deref_str_operand(p, c, p.nodes[n].b, r)
        }
    }
    t := f.new_temp(c.ntype[n], c.type_slots(c.ntype[n]))
    mut ins := mkinstr(4)
    ins.a = t
    ins.b = op
    ins.c = l
    ins.d = r
    if c.ntype[p.nodes[n].a] == 3 && (op == 6 || op == 7) {
        // str_cmp emit indexes temp_slot; copy local/const operands to temps.
        if l < 0 || l >= 1073741824 {
            lt := f.new_temp(3, 3)
            mut lc := mkinstr(1)
            lc.a = lt
            lc.b = l
            f.emit(lc)
            ins.c = lt
        }
        if r < 0 || r >= 1073741824 {
            rt := f.new_temp(3, 3)
            mut rc := mkinstr(1)
            rc.a = rt
            rc.b = r
            f.emit(rc)
            ins.d = rt
        }
        ins.sval = "str_cmp"
    }
    f.emit(ins)
    // BinOp borrows both operands (string concat and comparisons alike).
    // Reclaim only fresh expression results; a plain local/field/index read is
    // an alias and remains owned by its original binding.
    f.drop_fresh_string_expr(p, c, p.nodes[n].a, l)
    if r != l {
        f.drop_fresh_string_expr(p, c, p.nodes[n].b, r)
    }
    << t
}

// Wave C: array lit / index / slice arms of lower_expr (W3).
fn (f &mut MFn) store_fixed_array_elem(c &mut Checker, dest int, i int, eb int, elem_ty int, vt int) {
    base := i * eb
    if is_struct_type(elem_ty) {
        si := struct_index(elem_ty)
        for fi in 0:c.structs[si].fields.len {
            slot := c.structs[si].fields[fi].slot
            fty := c.structs[si].fields[fi].ty
            count := c.type_slots(fty)
            ft := f.new_temp(fty, count)
            mut lf := mkinstr(10)
            lf.a = ft
            lf.b = vt
            lf.c = slot
            lf.d = count
            f.emit(lf)
            mut sf := mkinstr(11)
            sf.a = ft
            sf.b = dest
            sf.c = base + slot
            sf.d = count
            f.emit(sf)
        }
        <<
    }
    mut sf2 := mkinstr(11)
    sf2.a = vt
    sf2.b = dest
    sf2.c = base
    sf2.d = c.type_slots(elem_ty)
    f.emit(sf2)
}

fn (f &mut MFn) lower_fixed_array_from_args(c &mut Checker, sty int, elem_ty int, n_elems int, args_head int) int {
    ns := c.type_slots(sty)
    dest := f.new_temp(sty, ns)
    eb := c.type_size_bytes(elem_ty)
    mut ai := args_head
    mut i := 0
    while i < n_elems {
        mut arg := f.margs[ai]
        f.store_fixed_array_elem(c, dest, i, eb, elem_ty, arg.v)
        ai = arg.next
        i += 1
    }
    << dest
}

fn (f &mut MFn) lower_expr_array(p &parser.Parser, c &mut Checker, n int) int {
    k := p.nodes[n].kind
    if k == 11 { // ArrayLit
        // `[N]T{…}` with N>0 is an inline frame blob (nslots = N*elem).
        // Dynamic `[]T{…}` and zero-init `[N]T{}` stay a 3-slot ArrayLit.
        sty := c.ntype[n]
        ai := sty - 200
        elem_ty := c.arrays[ai].elem_ty
        fl := c.array_fixed_len_m(sty)
        mut n_elems := 0
        mut args_head := -1
        mut args_last := -1
        mut e := p.nodes[n].a
        while e >= 0 {
            mut vt := f.lower_expr(p, c, e)
            f.mark_move_of(p, c, e)
            vt = f.typed_value(vt, elem_ty)
            mi := f.margs.len
            f.margs.push(MArg{v: vt, next: -1})
            if args_head < 0 { args_head = mi } else {
                f.link_marg(args_last, mi)
            }
            args_last = mi
            n_elems += 1
            e = p.nodes[e].next
        }
        if fl > 0 && n_elems > 0 {
            << f.lower_fixed_array_from_args(c, sty, elem_ty, n_elems, args_head)
        }
        dest := f.new_temp(sty, 3)
        mut ins := mkinstr(12)
        ins.a = dest
        ins.b = n_elems
        ins.c = args_head
        ins.d = c.type_size_bytes(elem_ty)
        f.emit(ins)
        // Typed `[N]T` ArrayLit still heap-allocates a 3-slot descriptor, but
        // `type_owning([N]T)` is false for non-owning elems so the user local
        // is never scope-dropped (ledger leftover). Attach a synthetic
        // dynamic `[]T` hold that owns the same descriptor and is dropped at
        // scope exit — frees the buffer without changing index/ABI layout.
        fl_lit := c.array_fixed_len(sty)
        f.lit_hold = -1
        if n_elems > 0 && fl_lit > 0 {
            dyn_ty := c.intern_array_type_n(elem_ty, 0)
            if dyn_ty > 0 {
                lid := f.new_local(dyn_ty, 3, true)
                mut st := mkinstr(3)
                st.a = lid
                st.b = dest
                f.emit(st)
                f.scope_add(lid)
                f.lit_hold = lid
            }
        }
        << dest
    }
    if k == 12 { // EmptyArrayLit
        sty := c.ntype[n]
        ai := sty - 200
        elem_ty := c.arrays[ai].elem_ty
        dest := f.new_temp(sty, 3)
        mut ins := mkinstr(12)
        ins.a = dest
        ins.b = 0
        ins.c = -1
        ins.d = c.type_size_bytes(elem_ty)
        f.emit(ins)
        << dest
    }
    if k == 13 { // Index read
        if c.ncall[n] == -77 {
            << f.lower_native_map_get(p, c, n)
        }
        mut map_fi := c.ncall[n]
        if map_fi == -83 {
            map_fi = c.nconst[n]
        }
        if map_fi >= 0 {
            if c.ncall[n] == -83 {
                ok_ty := c.ntype[n]
                throw_ty := c.throw_ok_err_ty(ok_ty, iface_ty(c.errors_iface))
                c.ntype[n] = throw_ty
                res := f.lower_map_get(p, c, n, map_fi)
                c.ntype[n] = ok_ty
                tag := f.new_temp(1, 1)
                mut lf := mkinstr(10)
                lf.a = tag
                lf.b = res
                lf.c = 0
                lf.d = 1
                f.emit(lf)
                dest := f.new_temp(ok_ty, c.type_slots(ok_ty))
                err_bb := f.new_block()
                ok_bb := f.new_block()
                f.terminate(2, tag, err_bb, ok_bb)
                f.switch_to(err_bb)
                f.emit_drops_all()
                f.terminate(3, res, 0, 0)
                f.switch_to(ok_bb)
                mut lf2 := mkinstr(10)
                lf2.a = dest
                lf2.b = res
                lf2.c = 8
                lf2.d = c.type_slots(ok_ty)
                f.emit(lf2)
                << dest
            }
            << f.lower_map_get(p, c, n, map_fi)
        }
        raw_ty := c.ntype[p.nodes[n].a]
        bty := c.direct_type(raw_ty)
        mut base := f.lower_index_base(p, c, p.nodes[n].a)
        idx := f.lower_expr(p, c, p.nodes[n].b)
        if bty == 3 {
            // string byte access — existing s3a path; load from string buf
            sty := 1 // int result
            dest := f.new_temp(sty, 1)
            mut ins := mkinstr(14)
            ins.a = dest
            ins.b = base
            ins.c = idx
            ins.d = elem_d(1, f.index_nocheck(p, c, p.nodes[n].a, p.nodes[n].b)) // one byte from string
            f.emit(ins)
            // String byte indexing only observes the source descriptor.
            f.drop_fresh_string_expr(p, c, p.nodes[n].a, base)
            << dest
        }
        if is_array_type(bty) {
            ai := bty - 200
            ety := c.elem_ty_of_array(bty, f.src_fi)
            dest := f.new_temp(ety, c.type_slots(ety))
            elem_sz := c.type_size_bytes(ety)
            mut ins := mkinstr(14)
            ins.a = dest
            ins.b = base
            ins.c = idx
            ins.d = elem_d(elem_sz, f.index_nocheck(p, c, p.nodes[n].a, p.nodes[n].b))
            fl := c.array_fixed_len_m(bty)
            if fl > 0 {
                ins.col = fl
            }
            f.emit(ins)
            if ety == 3 {
                if f.alias_on && n == f.alias_node {
                    f.alias_hit = true
                    << dest
                }
                cloned := f.new_temp(3, 3)
                mut cp := mkinstr(9)
                cp.a = cloned
                cp.b = dest
                f.emit(cp)
                << cloned
            }
            if c.nclone[n] == 1 && ety == 3 {
                cloned := f.new_temp(3, 3)
                mut cp := mkinstr(9)
                cp.a = cloned
                cp.b = dest
                f.emit(cp)
                << cloned
            }
            if n >= 0 && n < c.nclone.len && c.nclone[n] == 1 && is_struct_type(ety) {
                f.clone_struct_fields(&*c, dest, ety, 0)
            }
            << dest
        }
        << -1
    }
    if k == 14 { // Slice: string copy or array copy (MS9d)
        raw_ty := c.ntype[p.nodes[n].a]
        mut bty := c.direct_type(raw_ty)
        if is_ref_type(bty) {
            bty = c.direct_type(bty)
        }
        if is_array_type(bty) {
            mut desc := 0
            if is_ref_type(raw_ty) {
                ptr := f.lower_expr(p, c, p.nodes[n].a)
                if f.ref_expr_is_buf(p, &*c, p.nodes[n].a, 0) {
                    tmp := f.new_temp(bty, 3)
                    mut lp := mkinstr(26)
                    lp.a = tmp
                    lp.b = ptr
                    lp.c = 0
                    lp.d = 3
                    f.emit(lp)
                    desc = f.new_temp(1, 1)
                    mut ad := mkinstr(16)
                    ad.a = desc
                    ad.b = tmp
                    ad.c = 1
                    f.emit(ad)
                } else {
                    desc = ptr
                }
            } else {
                desc = f.lower_addr(p, c, p.nodes[n].a)
            }
            mut start := f.vconst(0)
            if p.nodes[n].b >= 0 { start = f.lower_expr(p, c, p.nodes[n].b) }
            mut end := -1
            if p.nodes[n].c >= 0 {
                end = f.lower_expr(p, c, p.nodes[n].c)
            } else {
                sfl := c.array_fixed_len_m(bty)
                if sfl > 0 {
                    end = f.vconst(sfl)
                } else {
                    end = f.new_temp(1, 1)
                    mut ll := mkinstr(17)
                    ll.a = end
                    ll.b = desc
                    ll.c = 8
                    ll.d = 1
                    f.emit(ll)
                }
            }
            srk := p.nodes[n].ival
            if p.nodes[n].b >= 0 && range_start_excl(srk) {
                start = f.emit_int_add_imm(start, 1)
            }
            if p.nodes[n].c >= 0 && !range_end_excl(srk) {
                end = f.emit_int_add_imm(end, 1)
            }
            ety := c.elem_ty_of_array(bty, f.src_fi)
            mut esz := c.type_size_bytes(ety)
            if esz < 1 { esz = 1 }
            mut helper := "_rt_array_slice"
            if ety == 3 { helper = "_rt_array_slice_str" }
            first := f.margs.len
            f.margs.push(MArg{v: desc, next: first + 1})
            f.margs.push(MArg{v: start, next: first + 2})
            f.margs.push(MArg{v: end, next: -1})
            dest := f.new_temp(bty, 3)
            mut call := mkinstr(7)
            call.a = dest
            call.b = 83
            call.c = first
            call.d = esz
            call.sval = helper
            f.emit(call)
            << dest
        }
        mut base := f.lower_expr(p, c, p.nodes[n].a)
        if is_ref_type(raw_ty) {
            desc := f.new_temp(3, 3)
            mut lp := mkinstr(17)
            lp.a = desc
            lp.b = base
            lp.c = 0
            lp.d = 3
            f.emit(lp)
            base = desc
        }
        mut start := f.vconst(0)
        if p.nodes[n].b >= 0 { start = f.lower_expr(p, c, p.nodes[n].b) }
        mut end := -1
        if p.nodes[n].c >= 0 {
            end = f.lower_expr(p, c, p.nodes[n].c)
        } else {
            end = f.new_temp(1, 1)
            mut ll := mkinstr(10)
            ll.a = end
            ll.b = base
            // LoadField offsets are bytes; string len is the second word.
            ll.c = 8
            ll.d = 1
            f.emit(ll)
        }
        srk := p.nodes[n].ival
        if p.nodes[n].b >= 0 && range_start_excl(srk) {
            start = f.emit_int_add_imm(start, 1)
        }
        if p.nodes[n].c >= 0 && !range_end_excl(srk) {
            end = f.emit_int_add_imm(end, 1)
        }
        first := f.margs.len
        f.margs.push(MArg{v: base, next: first + 1})
        f.margs.push(MArg{v: start, next: first + 2})
        f.margs.push(MArg{v: end, next: -1})
        dest := f.new_temp(3, 3)
        mut call := mkinstr(7)
        call.a = dest
        call.b = 20
        call.c = first
        call.sval = "_rt_str_slice"
        f.emit(call)
        // Slice is a copy operation; release a fresh source after copying.
        f.drop_fresh_string_expr(p, c, p.nodes[n].a, base)
        << dest
    }
    << -1
}

fn (f &mut MFn) lower_expr_struct_init(p &parser.Parser, c &mut Checker, n int) int {
    sty := c.ntype[n]
    si := struct_index(sty)
    ns := c.structs[si].nslots
    dest := f.new_temp(sty, ns)
    mut inited := []bool{}
    for i in 0:c.structs[si].fields.len {
        inited.push(false)
    }
    mut sf := p.nodes[n].a
    while sf >= 0 {
        fid := c.find_field(si, p.nodes[sf].sval)
        slot := c.structs[si].fields[fid].slot
        count := c.type_slots(c.structs[si].fields[fid].ty)
        mut vt := f.lower_expr(p, c, p.nodes[sf].a)
        f.mark_move_of(p, c, p.nodes[sf].a)
        vt = f.typed_value(vt, c.structs[si].fields[fid].ty)
        mut ins := mkinstr(11)
        ins.a = vt
        ins.b = dest
        ins.c = slot
        ins.d = count
        f.emit(ins)
        inited[fid] = true
        sf = p.nodes[sf].next
    }
    for i in 0:c.structs[si].fields.len {
        if inited[i] {
            ->
        }
        fty := c.structs[si].fields[i].ty
        slot := c.structs[si].fields[i].slot
        count := c.type_slots(fty)
        zv := f.zero_for_type(c, fty)
        mut zins := mkinstr(11)
        zins.a = zv
        zins.b = dest
        zins.c = slot
        zins.d = count
        f.emit(zins)
    }
    << dest
}
