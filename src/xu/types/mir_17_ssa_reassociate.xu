@xu/types

// Reassociate only wrapping word integers. Single-use interior nodes belong
// to this tree; shared definitions, Phi nodes and other blocks are leaves.
// The bound limits compile work, never the meaning of an oversized tree.
const MIR_SSA_REASSOC_MAX_NODES = 32

struct MirReassocTerm {
    value int
    sign int
}

fn mir_ssa_reassoc_value(f &MFn, v int, pinned &[]bool) bool {
    if f.val_is_const(v) { << true }
    << mir_ssa_cse_int(f, v) && !pinned[v]
}

fn mir_ssa_reassoc_bin(f &MFn, ii int, family int, pinned &[]bool) bool {
    if mfn_ikind(&f.instrs, ii) != MI_BIN || mfn_isval_len(&f.instrs, ii) != 0 { << false }
    op := mfn_ib(&f.instrs, ii)
    if family == 1 {
        if op != 1 && op != 2 { << false }
    } else if op != family { << false }
    << mir_ssa_reassoc_value(f, mfn_ia(&f.instrs, ii), pinned) &&
        mir_ssa_reassoc_value(f, mfn_ic(&f.instrs, ii), pinned) &&
        mir_ssa_reassoc_value(f, mfn_id(&f.instrs, ii), pinned)
}

// Sort by SSA value, with positive arithmetic terms first. Combining equal
// terms exposes cancellation/idempotence without introducing multiplication.
fn mir_ssa_reassoc_terms(terms $&[]MirReassocTerm, family int) []MirReassocTerm {
    for i in 1:terms.len {
        term := terms[i]
        $j := i
        while j > 0 && terms[j - 1].value > term.value {
            terms[j] = terms[j - 1]
            j -= 1
        }
        terms[j] = term
    }
    $merged := []MirReassocTerm{}
    $i := 0
    while i < terms.len {
        value := terms[i].value
        $sum := 0
        $count := 0
        while i < terms.len && terms[i].value == value {
            sum += terms[i].sign
            count += 1
            i += 1
        }
        if family == 1 {
            $sign := 1
            if sum < 0 { sign = -1
                sum = 0 - sum }
            for _ in 0:sum { merged.push(MirReassocTerm{value: value, sign: sign}) }
        } else if family != 16 || (count & 1) != 0 {
            merged.push(MirReassocTerm{value: value, sign: 1})
        }
    }
    $ordered := []MirReassocTerm{}
    for sign in 0:2 {
        for ti in 0:merged.len {
            term := merged[ti]
            if (sign == 0 && term.sign > 0) || (sign == 1 && term.sign < 0) { ordered.push(term) }
        }
    }
    << ordered
}

fn mir_ssa_reassoc_tree(f $&MFn, bi int, root int, defs &[]int, owners &[]int,
    uses $&[]int, pinned &[]bool) bool {
    $family := mfn_ib(&f.instrs, root)
    if family == 2 { family = 1 }
    if family != 1 && family != 14 && family != 15 && family != 16 { << false }
    if !mir_ssa_reassoc_bin(&*f, root, family, pinned) { << false }
    $interior := false
    for side in 0:2 {
        $v := mfn_ic(&f.instrs, root)
        if side == 1 { v = mfn_id(&f.instrs, root) }
        if v >= 0 && defs[v] >= 0 && owners[v] == bi && uses[v] == 1 &&
            mir_ssa_reassoc_bin(&*f, defs[v], family, pinned) { interior = true }
    }
    if !interior { << false }
    $stack := []MirReassocTerm{}
    $nodes := []int{}
    $terms := []MirReassocTerm{}
    stack.push(MirReassocTerm{value: mfn_ia(&f.instrs, root), sign: 1})
    $constant := 0
    if family == 14 { constant = -1 }
    $cursor := 0
    while cursor < stack.len {
        term := stack[cursor]
        cursor += 1
        value := term.value
        $di := -1
        if value >= 0 { di = defs[value] }
        if di >= 0 && owners[value] == bi && (di == root || uses[value] == 1) &&
            mir_ssa_reassoc_bin(&*f, di, family, pinned) {
            if nodes.len >= MIR_SSA_REASSOC_MAX_NODES { << false }
            nodes.push(di)
            $right_sign := term.sign
            if family == 1 && mfn_ib(&f.instrs, di) == 2 { right_sign = 0 - right_sign }
            stack.push(MirReassocTerm{value: mfn_id(&f.instrs, di), sign: right_sign})
            stack.push(MirReassocTerm{value: mfn_ic(&f.instrs, di), sign: term.sign})
        } else if f.val_is_const(value) {
            cv := f.val_const(value)
            if family == 1 {
                if term.sign > 0 { constant += cv } else { constant -= cv }
            } else { constant = mir_ssa_eval_const_binop(family, constant, cv) }
        } else { terms.push(term) }
    }
    if nodes.len < 2 { << false }
    $ordered := mir_ssa_reassoc_terms($&terms, family)
    if (family == 14 && constant == 0) || (family == 15 && constant == -1) { ordered = []MirReassocTerm{} }
    $identity := 0
    if family == 14 { identity = -1 }
    // Plan before mutating. A negative-only sum starts at zero; constants
    // otherwise go last so the emitter can use one immediate operation.
    $values := []int{}
    $ops := []int{}
    seed_constant := ordered.len == 0 || ordered[0].sign < 0
    tail_constant := ordered.len > 0 && constant != identity
    if seed_constant { values.push(-1) }
    for ti in 0:ordered.len {
        term := ordered[ti]
        if values.len > 0 {
            $op := family
            if family == 1 && term.sign < 0 { op = 2 }
            ops.push(op)
        }
        values.push(term.value)
    }
    if tail_constant {
        ops.push(family)
        values.push(-1)
    }
    if ops.len > nodes.len { << false }
    if seed_constant {
        $cv := identity
        if ordered.len == 0 { cv = constant }
        values[0] = mir_cfg_const(f, cv)
    }
    if tail_constant { values[values.len - 1] = mir_cfg_const(f, constant) }
    // Reuse existing definitions and instruction IDs. Move only these pure
    // nodes to immediately before the root, after every leaf's definition.
    // Calls/memory/traps retain their order; pinned operands were excluded.
    $ids := []int{}
    for ni in 1:ops.len { ids.push(nodes[ni]) }
    ids.push(root)
    $same := ops.len == nodes.len
    if same {
        $lhs := values[0]
        for ni in 0:ops.len {
            ii := ids[ni]
            if mfn_ib(&f.instrs, ii) != ops[ni] || mfn_ic(&f.instrs, ii) != lhs ||
                mfn_id(&f.instrs, ii) != values[ni + 1] { same = false }
            lhs = mfn_ia(&f.instrs, ii)
        }
    }
    if same { << false }
    $dests := []int{}
    for ni in 0:ids.len { dests.push(mfn_ia(&f.instrs, ids[ni])) }
    for ni in 0:nodes.len { mir_dce_instr_uses(&*f, nodes[ni], uses, -1) }
    for ni in 1:nodes.len { mir_delete_instr(f, bi, nodes[ni]) }
    $prev := -1
    $at := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if at < 0 || at == root { <- }
        prev = at
        at = mfn_inext(&f.instrs, at)
    }
    $lhs := values[0]
    for ni in 0:ops.len {
        ii := ids[ni]
        $ins := mkinstr(MI_BIN)
        ins.a = dests[ni]
        ins.b = ops[ni]
        ins.c = lhs
        ins.d = values[ni + 1]
        ins.line = mfn_iline(&f.instrs, root)
        ins.col = mfn_icol(&f.instrs, root)
        ins.file = mfn_ifile(&f.instrs, root)
        ins.next = root
        if ii == root { ins.next = mfn_inext(&f.instrs, root) }
        mfn_set_instr($&f.instrs, ii, ins)
        if ii != root {
            if prev >= 0 { mfn_set_inext($&f.instrs, prev, ii) }
            else {
                $block := f.blocks[bi]
                block.head = ii
                mfn_set_block($&f.blocks, bi, block)
            }
            prev = ii
        }
        lhs = dests[ni]
    }
    if ops.len == 0 { mfn_become_copy($&f.instrs, root, lhs) }
    for ni in 0:ids.len { mir_dce_instr_uses(&*f, ids[ni], uses, 1) }
    << true
}

// Requires strict SSA and freshly rewritten aliases. Counts include call
// arguments, terminators and Phi edges, so shared values never get consumed.
fn mir_ssa_reassociate_verified_f(f $&MFn, pinned &[]bool) bool {
    $defs := []int{}
    $owners := []int{}
    $uses := []int{}
    for _ in 0:f.temps.len { defs.push(-1)
        owners.push(-1)
        uses.push(0) }
    for bi in 0:f.blocks.len {
        mir_dce_block_uses(&*f, bi, $&uses)
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_BIN {
                dest := mfn_ia(&f.instrs, ii)
                mfn_set_i($&defs, dest, ii)
                mfn_set_i($&owners, dest, bi)
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    for ai in 0:f.phi_args.len { mir_dce_use_value($&uses, f.phi_args[ai].value, 1) }
    $changed := false
    for bi in 0:f.blocks.len {
        $ids := []int{}
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_BIN { ids.push(ii) }
            ii = mfn_inext(&f.instrs, ii)
        }
        // Roots first: a long expression is flattened once before its old
        // interior nodes are visited, without a fixed-point rescan.
        $ni := ids.len - 1
        while ni >= 0 {
            root := ids[ni]
            if mfn_ikind(&f.instrs, root) == MI_BIN &&
                mir_ssa_reassoc_tree(f, bi, root, &defs, &owners, $&uses, pinned) { changed = true }
            ni -= 1
        }
    }
    << changed
}
