@xu/types

// `s + ""` is not an ownership boundary under the Gen1 hosted compiler: it
// may preserve the original backing allocation. Committed clones outlive the
// optimizer pass, so their strings need independent ownership. Read scalar
// bytes directly: both a temporary string alias and a nested pointer such as
// `&m.fns[fi].label` are known Gen1 hazards.
fn mir_cfg_clone_name_owned(m &Mir, fi int) string {
    n := mir_fn_name_len(m, fi)
    if n == 0 { << "" }
    $out := []int{}
    for i in 0:n {
        out.push(mir_fn_name_byte(m, fi, i))
    }
    << string_from_bytes(out)
}

fn mir_cfg_clone_label_owned(m &Mir, fi int) string {
    n := mir_fn_label_len(m, fi)
    if n == 0 { << "" }
    $out := []int{}
    for i in 0:n {
        out.push(mir_fn_label_byte(m, fi, i))
    }
    << string_from_bytes(out)
}

fn mir_cfg_clone_sval_owned(m &Mir, fi int, ii int) string {
    n := mir_isval_len(m, fi, ii)
    if n == 0 { << "" }
    $out := []int{}
    for i in 0:n {
        out.push(mir_isval_byte(m, fi, ii, i))
    }
    << string_from_bytes(out)
}

fn mir_fn_blank() MFn {
    << MFn{
        name: "", label: "", ret: 0, ret_nslots: 0, nparams: 0,
        receiver: false, receiver_mut: false, is_extern: false, is_pub: false,
        local_names: []string{},
        locals: []int{}, locals_nslots: []int{}, locals_owning: []bool{},
        temps: []int{}, temps_nslots: []int{}, instrs: []MInstr{},
        margs: []MArg{}, phis: []MPhi{}, phi_args: []MPhiArg{}, blocks: []MBlock{}, consts: []int{},
        cur: 0, dead: false,
        scope_ids: []int{}, scopes: []int{}, scount: []int{},
        moved: []bool{}, fcons: []int{}, lit_hold: -1, alias_on: false, alias_node: 0, alias_hit: false, loop_break: []int{}, loop_cont: []int{}, loop_scope_depth: []int{},
        file: 0, src_fi: 0, cur_line: 0, cur_col: 0,
        induct_var: []int{}, induct_arr: []int{},
        ea_arr: []int{}, ea_ilocal: []int{}, ea_iconst: []int{},
        ea_nc: []int{}, ea_ptr: []int{},
        sdesc_lid: []int{}, sdesc_temp: []int{},
        opt_level: 0,
        facts_gen: 0, facts_bits: 0, facts_nins: 0, facts_nblocks: 0
    }
}

pub fn mir_cfg_clone_fn(m &Mir, fi int, keep_sval bool) MFn {
    $f := mir_fn_blank()
    mir_cfg_clone_fn_meta(m, fi, $&f)
    mir_cfg_clone_fn_fill(m, fi, $&f)
    << f
}

pub fn mir_clone_fn(m $&Mir, fi int, keep_sval bool) MFn {
    m.opt_clone += 1
    << mir_cfg_clone_fn(&*m, fi, keep_sval)
}

fn mir_cfg_clone_fn_meta(m &Mir, fi int, f $&MFn) {
    f.name = mir_cfg_clone_name_owned(m, fi)
    f.label = mir_cfg_clone_label_owned(m, fi)
    f.ret = m.fns[fi].ret
    f.ret_nslots = m.fns[fi].ret_nslots
    f.nparams = m.fns[fi].nparams
    f.receiver = m.fns[fi].receiver
    f.receiver_mut = m.fns[fi].receiver_mut
    f.is_extern = mir_fn_decl_is_extern(m, fi)
    f.cur = m.fns[fi].cur
    f.dead = m.fns[fi].dead
    f.file = m.fns[fi].file
    f.src_fi = m.fns[fi].src_fi
    f.cur_line = m.fns[fi].cur_line
    f.cur_col = m.fns[fi].cur_col
    f.opt_level = m.fns[fi].opt_level
    mir_fn_facts_invalidate_f(f)
}

fn mir_cfg_clone_fn_fill(m &Mir, fi int, f $&MFn) {
    nloc := mir_nlocals(m, fi)
    for i in 0:m.fns[fi].local_names.len { f.local_names.push(m.fns[fi].local_names[i] + "") }
    for i in 0:nloc { f.locals.push(mir_local_ty(m, fi, i)) }
    for i in 0:m.fns[fi].locals_nslots.len { f.locals_nslots.push(mir_local_nslots(m, fi, i)) }
    for i in 0:m.fns[fi].locals_owning.len { f.locals_owning.push(m.fns[fi].locals_owning[i]) }
    nt := mir_ntemps(m, fi)
    for i in 0:nt { f.temps.push(mir_temp_ty(m, fi, i)) }
    for i in 0:m.fns[fi].temps_nslots.len { f.temps_nslots.push(mir_temp_nslots(m, fi, i)) }
    nins := mir_nins(m, fi)
    for i in 0:nins {
        // CSE/copy-prop snapshots used to keep sval only for Call/Assert/
        // MakeClosure; that dropped Xu (33) labels and emitted lea "".
        $x := mkinstr(mir_ikind(m, fi, i))
        x.a = mir_ia(m, fi, i)
        x.b = mir_ib(m, fi, i)
        x.c = mir_ic(m, fi, i)
        x.d = mir_id(m, fi, i)
        x.sval = mir_cfg_clone_sval_owned(m, fi, i)
        x.next = mir_inext(m, fi, i)
        x.line = mir_iline(m, fi, i)
        x.col = mir_icol(m, fi, i)
        x.file = mir_ifile(m, fi, i)
        f.instrs.push(x)
    }
    for i in 0:m.fns[fi].margs.len { f.margs.push(MArg{v: m.fns[fi].margs[i].v, next: m.fns[fi].margs[i].next}) }
    for i in 0:m.fns[fi].phis.len {
        p := m.fns[fi].phis[i]
        f.phis.push(MPhi{block: p.block, local: p.local, dest: p.dest, ty: p.ty, arg_head: p.arg_head, arg_count: p.arg_count})
    }
    for i in 0:m.fns[fi].phi_args.len {
        a := m.fns[fi].phi_args[i]
        f.phi_args.push(MPhiArg{pred: a.pred, value: a.value})
    }
    nb := mir_nblocks(m, fi)
    for i in 0:nb {
        f.blocks.push(MBlock{head: mir_bhead(m, fi, i), tail: mir_btail(m, fi, i), tkind: mir_btkind(m, fi, i), ta: mir_bta(m, fi, i), tb: mir_btb(m, fi, i), tc: mir_btc(m, fi, i), line: mir_bline(m, fi, i)})
    }
    nc := mir_nconsts(m, fi)
    for i in 0:nc { f.consts.push(mir_const_at(m, fi, i)) }
}

fn mir_cfg_mark_reachable_f(f &MFn, out $&[]bool) {
    for _ in 0:f.blocks.len { out.push(false) }
    if out.len == 0 { << }
    out[0] = true
    for _ in 0:f.blocks.len {
        for bi in 0:f.blocks.len {
            if !out[bi] { -> }
            tk := f.blocks[bi].tkind
            if tk == 1 {
                to := f.blocks[bi].ta
                if to >= 0 && to < out.len { out[to] = true }
            } else if tk == 2 {
                t := f.blocks[bi].tb
                e := f.blocks[bi].tc
                if t >= 0 && t < out.len { out[t] = true }
                if e >= 0 && e < out.len { out[e] = true }
            }
        }
    }
}

fn mir_cfg_mark_reachable(m &Mir, fi int, out $&[]bool) {
    // Clone, don't take `&m.fns[fi]`: a pointer into the large MFn slice
    // is a Gen1 miscompile (blocks.len reads as 0, leaf_safe always false).
    $f := mir_cfg_clone_fn(m, fi, false)
    mir_cfg_mark_reachable_f(&f, out)
}

fn mir_cfg_can_reach_target(f &MFn, start int, target int) bool {
    if start == target { << true }
    if start < 0 || start >= f.blocks.len { << false }
    if target < 0 || target >= f.blocks.len { << false }
    $reach := []bool{}
    for _ in 0:f.blocks.len { reach.push(false) }
    reach[start] = true
    for _ in 0:f.blocks.len {
        $expanded := false
        for bi in 0:f.blocks.len {
            if !reach[bi] { -> }
            tk := f.blocks[bi].tkind
            if tk == 1 {
                to := f.blocks[bi].ta
                if to == target { << true }
                if to >= 0 && to < reach.len && !reach[to] {
                    reach[to] = true
                    expanded = true
                }
            } else if tk == 2 {
                t := f.blocks[bi].tb
                e := f.blocks[bi].tc
                if t == target || e == target { << true }
                if t >= 0 && t < reach.len && !reach[t] {
                    reach[t] = true
                    expanded = true
                }
                if e >= 0 && e < reach.len && !reach[e] {
                    reach[e] = true
                    expanded = true
                }
            }
        }
        if !expanded { <- }
    }
    << reach[target]
}

fn mir_cfg_leaf_safe_f(f &MFn, opt_level int, small_unit bool) bool {
    if f.is_extern { << false }
    // These bodies are placeholders; instruction selection redirects their
    // calls to capability queries or runtime helpers. CFG inlining must
    // preserve the same boundary as scalar/constant leaf inlining.
    if starts_with(f.label + "", "_xu_crypto_aes_aes_hw_") || starts_with(f.label + "", "_xu_hash_crc32_crc32_hw_") || starts_with(f.label + "", "_xu_crypto_sha256_sha256_hw_") || starts_with(f.label + "", "_xu_crypto_sha512_sha512_hw_") || starts_with(f.label + "", "_xu_crypto_sha1_sha1_hw_") || starts_with(f.label + "", "_xu_crypto_sm4_sm4_hw_") || starts_with(f.label + "", "_xu_math_math_hw_") || starts_with(f.label + "", "_xu_tile_tile_hw_") || starts_with(f.label + "", "_xu_encoding_hex_hex_hw_") || starts_with(f.label + "", "_xu_encoding_base64_base64_hw_") || starts_with(f.label + "", "_xu_strings_storage_") { << false }
    // Preserve the canonical scalar intrinsic until target instruction
    // selection. Expanding its portable implementation here loses the
    // hardware operation and inflates every caller's CFG/register pressure.
    // Targets without a lowering still call the portable function body.
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_leading_zeros") { << false }
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_trailing_zeros") { << false }
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_reverse") { << false }
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_reverse_bytes") { << false }
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_ones_count") { << false }
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_rotate_left") { << false }
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_rotate_right") { << false }
    if mir_promote_sval_eq_lit(&f.label, "_xu_math_bits_len") { << false }
    // O2+: allow receiver methods as inlinable leaves. The receiver is a
    // pointer in locals[0] (1 slot); mir_inline_cfg_apply seeds it via
    // StoreLocal just like any other parameter. O1 allows receiver leaves
    // on small compilation units (nfn<64); large units (nfn>=64) keep the
    // historical ban to avoid regressions in the compiler self-host.
    if f.receiver && opt_level < 2 && !small_unit { << false }
    // Receiver nparams already includes the receiver slot; the existing
    // arity and cost gates therefore still apply.
    if f.blocks.len == 0 || f.blocks.len > 32 {
        << false
    }
    if f.nparams > 6 || f.ret_nslots > 1 {
        << false
    }
    if f.locals.len < f.nparams {
        << false
    }
    // Aggregate/string/array parameters use a hidden pointer in the user ABI.
    // mir_inline_cfg_apply currently seeds cloned locals with StoreLocal, so
    // accepting such a callee would store the pointer as the aggregate value
    // and leave its remaining slots uninitialized.  Keep the call until the
    // CFG inliner grows a typed aggregate copy (bootstrap xumir parity).
    for i in 0:f.nparams {
        if f.receiver && i == 0 { -> }
        if mir_abi_by_pointer(f.locals[i]) {
            << false
        }
    }
    for i in 0:f.locals.len {
        if f.locals_owning[i] {
            << false
        }
        // Non-owning internal 2-slot locals are legal; indirect parameters
        // were rejected above because StoreLocal cannot copy their payload.
        ns := f.locals_nslots[i]
        if ns < 1 || ns > 2 {
            << false
        }
    }
    $cost := 0
    $returns := 0
    $has_loop := false
    $nreach := 0
    $reachable := []bool{}
    mir_cfg_mark_reachable_f(f, $&reachable)
    for bi in 0:f.blocks.len {
        if !reachable[bi] { -> }
        if f.blocks[bi].tkind == 0 {
            << false
        }
        tk := f.blocks[bi].tkind
        empty_jump := tk == 1 && f.blocks[bi].head < 0
        if !empty_jump {
            nreach += 1
        }
        if tk == 1 && f.blocks[bi].ta <= bi && mir_cfg_can_reach_target(f, f.blocks[bi].ta, bi) {
            has_loop = true
        }
        if tk == 2 {
            if f.blocks[bi].tb <= bi && mir_cfg_can_reach_target(f, f.blocks[bi].tb, bi) {
                has_loop = true
            }
            if f.blocks[bi].tc <= bi && mir_cfg_can_reach_target(f, f.blocks[bi].tc, bi) {
                has_loop = true
            }
        }
        if tk == 3 { returns += 1 }
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            cost += 1
            $scan := 48
            if opt_level >= 3 {
                scan = 80
            }
            if has_loop {
                scan = 12
            }
            if cost > scan {
                << false
            }
            ik := f.instrs[ii].kind
            // 11 StoreField / 20 StoreIndex / 25 StorePtr / 47 IndexRMW / 48 FieldRMW:
            // LLVM inlines stores; cost cap (O3 scan 80) is the gate, not the opcode.
            if ik == 1 || ik == 2 || ik == 3 || ik == 4 || ik == 5 || ik == 10 || ik == 11 || ik == 14 || ik == 16 || ik == 17 || ik == 18 || ik == 20 || ik == 23 || ik == 25 || ik == 26 || ik == 47 || ik == 48 {
                ii = f.instrs[ii].next
                ->
            }
            << false
        }
    }
    if cost == 0 || returns == 0 {
        << false
    }
    if has_loop {
        // Primer inlines loop leaves at O1. Gen1 only reaches this at O1
        // when nfn<64 (mir_inline_cfg_leaves); compiler units skip the
        // pass so time.date / gen2==gen3 hold.
        << returns == 1
    }
    // O2: acyclic scalar leaves O1's single-Bin classifier misses.
    // O3: same legality, higher cost / block / arity caps.
    // Small units (nfn < 64) allow acyclic leaves and multi-return leaves at O1.
    if opt_level < 2 && !small_unit {
        << false
    }
    if opt_level < 3 && returns != 1 && !small_unit {
        << false
    }
    $max_cost := 32
    $max_params := 4
    $max_blocks := 12
    if opt_level >= 3 {
        max_cost = 80
        if has_loop {
            max_cost = 16
        }
        max_params = 6
        max_blocks = 16
    }
    if cost > max_cost {
        << false
    }
    if f.nparams < 1 || f.nparams > max_params {
        << false
    }
    if nreach > max_blocks {
        << false
    }
    << true
}

pub fn mir_cfg_leaf_safe_lvl(m &Mir, fi int, opt_level int) bool {
    $f := mir_cfg_clone_fn(m, fi, false)
    << mir_cfg_leaf_safe_f(&f, opt_level, m.opt_nfn < 64)
}

pub fn mir_cfg_leaf_safe(m &Mir, fi int) bool {
    << mir_cfg_leaf_safe_lvl(m, fi, m.opt_level)
}

// Self-loop call sites: loop-shaped leaves stay inlinable. Acyclic
// leaves must stay tiny so SWAR bodies are not dumped into a pin latch.
fn mir_cfg_ok_in_self_loop_f(f &MFn) bool {
    $cost := 0
    $returns := 0
    $has_loop := false
    $nreach := 0
    $reachable := []bool{}
    mir_cfg_mark_reachable_f(f, $&reachable)
    for bi in 0:f.blocks.len {
        if !reachable[bi] { -> }
        tk := f.blocks[bi].tkind
        empty_jump := tk == 1 && f.blocks[bi].head < 0
        if !empty_jump {
            nreach += 1
        }
        if tk == 1 && f.blocks[bi].ta <= bi && mir_cfg_can_reach_target(f, f.blocks[bi].ta, bi) {
            has_loop = true
        }
        if tk == 2 {
            if f.blocks[bi].tb <= bi && mir_cfg_can_reach_target(f, f.blocks[bi].tb, bi) {
                has_loop = true
            }
            if f.blocks[bi].tc <= bi && mir_cfg_can_reach_target(f, f.blocks[bi].tc, bi) {
                has_loop = true
            }
        }
        if tk == 3 { returns += 1 }
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            cost += 1
            ii = f.instrs[ii].next
        }
    }
    if returns < 1 || returns > 2 { << false }
    if cost < 1 { << false }
    if has_loop { << true }
    if nreach > 4 { << false }
    if cost > 32 { << false }
    << true
}

fn mir_cfg_ok_in_self_loop(m &Mir, fi int) bool {
    $f := mir_cfg_clone_fn(m, fi, false)
    << mir_cfg_ok_in_self_loop_f(&f)
}

fn mir_cfg_value(v int, temp_base int, cmap &[]int) int {
    if v >= 0 { << temp_base + v }
    if v == -1 { << -1 }
    k := 0 - v - 2
    if k >= 0 && k < cmap.len { << cmap[k] }
    << -1
}

fn mir_cfg_index_base(v int, local_base int, temp_base int) int {
    if v >= MIR_LOCAL_OPERAND_BASE {
        << MIR_LOCAL_OPERAND_BASE + local_base + (v - MIR_LOCAL_OPERAND_BASE)
    }
    << temp_base + v
}

fn mir_cfg_const(f $&MFn, cv int) int {
    for k in 0:f.consts.len {
        if f.consts[k] == cv { << 0 - k - 2 }
    }
    mfn_push_i($&f.consts, cv)
    << 0 - f.consts.len - 1
}

fn mir_cfg_add_local(f $&MFn, ty int, ns int) {
    f.locals.push(ty)
    f.locals_nslots.push(ns)
    f.locals_owning.push(false)
}

fn mir_cfg_add_temp(f $&MFn, ty int, ns int) {
    f.temps.push(ty)
    f.temps_nslots.push(ns)
}

fn mir_cfg_add_block(f $&MFn, b MBlock) {
    f.blocks.push(b)
}

fn mir_cfg_append(f $&MFn, bi int, ins0 MInstr) {
    $ins := ins0
    ins.next = -1
    idx := f.instrs.len
    f.instrs.push(ins)
    $blk := MBlock{
        head: f.blocks[bi].head,
        tail: f.blocks[bi].tail,
        tkind: f.blocks[bi].tkind,
        ta: f.blocks[bi].ta,
        tb: f.blocks[bi].tb,
        tc: f.blocks[bi].tc,
        line: f.blocks[bi].line
    }
    if blk.tail >= 0 {
        f.instrs[blk.tail].next = idx
    } else {
        blk.head = idx
    }
    blk.tail = idx
    mfn_set_block($&f.blocks, bi, blk)
}

fn mir_cfg_clone_instr(cf &MFn, cii int, local_base int, temp_base int, cmap &[]int) MInstr {
    k := cf.instrs[cii].kind
    ia := cf.instrs[cii].a
    ib := cf.instrs[cii].b
    ic := cf.instrs[cii].c
    id := cf.instrs[cii].d
    $z := mkinstr(k)
    z.sval = mfn_sval_clone_owned(&cf.instrs, cii)
    z.line = cf.instrs[cii].line
    z.col = cf.instrs[cii].col
    z.file = cf.instrs[cii].file
    if k == 1 {
        z.a = temp_base + ia
        z.b = mir_cfg_value(ib, temp_base, cmap)
    } else if k == 2 {
        z.a = temp_base + ia
        z.b = local_base + ib
    } else if k == 3 {
        z.a = local_base + ia
        z.b = mir_cfg_value(ib, temp_base, cmap)
    } else if k == 4 {
        z.a = temp_base + ia
        z.b = ib
        z.c = mir_cfg_value(ic, temp_base, cmap)
        z.d = mir_cfg_value(id, temp_base, cmap)
    } else if k == 5 {
        z.a = temp_base + ia
        z.b = ib
        z.c = mir_cfg_value(ic, temp_base, cmap)
    } else if k == 10 {
        z.a = temp_base + ia
        z.b = temp_base + ib
        z.c = ic
        z.d = id
    } else if k == 11 {
        z.a = mir_cfg_value(ia, temp_base, cmap)
        z.b = temp_base + ib
        z.c = ic
        z.d = id
    } else if k == 14 {
        z.a = temp_base + ia
        z.b = mir_cfg_index_base(ib, local_base, temp_base)
        z.c = mir_cfg_value(ic, temp_base, cmap)
        z.d = id
    } else if k == 16 {
        z.a = temp_base + ia
        if ic == 0 { z.b = local_base + ib } else { z.b = temp_base + ib }
        z.c = ic
    } else if k == 17 || k == 26 {
        z.a = temp_base + ia
        z.b = temp_base + ib
        z.c = ic
        z.d = id
    } else if k == 18 || k == 25 {
        z.a = mir_cfg_value(ia, temp_base, cmap)
        z.b = temp_base + ib
        z.c = ic
        z.d = id
    } else if k == 20 {
        z.a = mir_cfg_index_base(ia, local_base, temp_base)
        z.b = mir_cfg_value(ib, temp_base, cmap)
        z.c = mir_cfg_value(ic, temp_base, cmap)
        z.d = id
    } else if k == 23 {
        z.a = temp_base + ia
        z.b = mir_cfg_index_base(ib, local_base, temp_base)
        z.c = mir_cfg_value(ic, temp_base, cmap)
        z.d = id
    } else if k == 47 {
        z.a = mir_cfg_index_base(ia, local_base, temp_base)
        z.b = mir_cfg_value(ib, temp_base, cmap)
        z.c = mir_cfg_value(ic, temp_base, cmap)
        z.d = id
    } else if k == 48 {
        z.a = temp_base + ia
        z.b = ib
        z.c = mir_cfg_value(ic, temp_base, cmap)
        z.d = id
    }
    << z
}

fn mir_cfg_caller_ok(m &Mir, fi int) bool {
    $f := mir_cfg_clone_fn(m, fi, false)
    << mir_cfg_caller_ok_f(&f, m.opt_level, m.opt_nfn < 64)
}

fn mir_cfg_caller_ok_f(f &MFn, opt_level int, small_unit bool) bool {
    if f.is_extern { << false }
    // Cost/size gate, not a function-name special case. O1/O2 keep the
    // historical 36/8 cap so clone+push stays small. O3 matches the
    // late_opt 256-instr skip: bootstrap has no caller cap; Gen1 still
    // needs one to avoid clone UAF on huge grown bodies.
    // Count reachable live ops, not instrs.len/blocks.len: CFG splits
    // leave detached instructions in the pool and would block
    // search_ints from inlining into search_sum (algorithm_search).
    $max_ins := 36
    $max_bb := 8
    if small_unit {
        max_ins = 128
        max_bb = 24
    }
    if opt_level >= 3 {
        max_ins = 256
        max_bb = 32
    }
    $reachable := []bool{}
    mir_cfg_mark_reachable_f(f, $&reachable)
    $nins := 0
    $nbb := 0
    for bi in 0:f.blocks.len {
        if !reachable[bi] { -> }
        tk := f.blocks[bi].tkind
        empty_jump := tk == 1 && f.blocks[bi].head < 0
        if !empty_jump {
            nbb += 1
        }
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nins += 1
            ii = f.instrs[ii].next
        }
    }
    if nins >= max_ins { << false }
    if nbb > max_bb { << false }
    << true
}

fn (f &MFn) skip_empty_jumps(start int) int {
    $b := start
    n := f.blocks.len
    for _ in 0:n {
        if b < 0 || b >= n { << start }
        if f.blocks[b].head >= 0 { << b }
        if f.blocks[b].tkind != 1 { << b }
        nxt := f.blocks[b].ta
        if nxt == b { << b }
        b = nxt
    }
    << b
}

fn mir_skip_empty_jumps(f &MFn, start int) int {
    << f.skip_empty_jumps(start)
}

fn mir_contract_empty_jumps(f $&MFn) {
    n := f.blocks.len
    $jmp_map := []int{}
    for i in 0:n {
        jmp_map.push(f.skip_empty_jumps(i))
    }
    for bi in 0:n {
        $b := f.blocks[bi]
        tk := b.tkind
        if tk == 1 {
            t := b.ta
            if t >= 0 && t < jmp_map.len { b.ta = jmp_map[t] }
            mfn_set_block($&f.blocks, bi, b)
        } else if tk == 2 {
            t := b.tb
            e := b.tc
            if t >= 0 && t < jmp_map.len { b.tb = jmp_map[t] }
            if e >= 0 && e < jmp_map.len { b.tc = jmp_map[e] }
            mfn_set_block($&f.blocks, bi, b)
        }
    }
}

fn mir_retarget_edge(f $&MFn, pi int, from int, to int) bool {
    $b := f.blocks[pi]
    $hit := false
    if b.tkind == 1 && b.ta == from {
        b.ta = to
        hit = true
    } else if b.tkind == 2 {
        if b.tb == from {
            b.tb = to
            hit = true
        }
        if b.tc == from {
            b.tc = to
            hit = true
        }
    }
    if hit {
        mfn_set_block($&f.blocks, pi, b)
    }
    << hit
}

fn mir_merge_jump_blocks(f $&MFn) bool {
    n := f.blocks.len
    $changed := false
    for bi in 0:n {
        if f.is_self_loop(bi) { -> }
        if f.blocks[bi].tkind != 1 { -> }
        si := f.blocks[bi].ta
        if si < 0 || si >= n || si == bi || si == 0 { -> }
        if f.blocks[si].tkind == 0 { -> }
        if f.is_self_loop(si) { -> }
        if f.unique_ext_pred(si) != bi { -> }
        $ids := []int{}
        $ii := f.blocks[si].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            ids.push(ii)
            ii = f.instrs[ii].next
        }
        for k in 0:ids.len {
            mir_detach_instr(f, si, ids[k])
        }
        for k in 0:ids.len {
            mir_append_instr(f, bi, ids[k])
        }
        $pb := f.blocks[bi]
        sb := f.blocks[si]
        pb.tkind = sb.tkind
        pb.ta = sb.ta
        pb.tb = sb.tb
        pb.tc = sb.tc
        if pb.tkind == 1 && pb.ta == si { pb.ta = bi }
        if pb.tkind == 2 {
            if pb.tb == si { pb.tb = bi }
            if pb.tc == si { pb.tc = bi }
        }
        mfn_set_block($&f.blocks, bi, pb)
        $dead := f.blocks[si]
        dead.head = -1
        dead.tail = -1
        dead.tkind = 0
        dead.ta = -1
        dead.tb = -1
        dead.tc = -1
        mfn_set_block($&f.blocks, si, dead)
        changed = true
    }
    << changed
}

fn mir_temp_used_as_index(f &MFn, bi int, t int) bool {
    if t < 0 { << false }
    $ii := f.blocks[bi].head
    $alias := -1
    for _ in 0:f.instrs.len {
        if ii < 0 { << false }
        k := f.instrs[ii].kind
        if k == 1 && f.instrs[ii].b == t {
            alias = f.instrs[ii].a
        }
        if k == 14 || k == 23 {
            if f.instrs[ii].c == t || (alias >= 0 && f.instrs[ii].c == alias) { << true }
        }
        if k == 20 || k == 47 {
            if f.instrs[ii].b == t || (alias >= 0 && f.instrs[ii].b == alias) { << true }
        }
        ii = f.instrs[ii].next
    }
    << false
}

fn mir_temp_used_outside_blocks(f &MFn, bi int, latch int, t int) bool {
    if t < 0 { << false }
    for b in 0:f.blocks.len {
        if b == bi || b == latch { -> }
        if f.blocks[b].tkind == 0 { -> }
        $ii := f.blocks[b].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if f.instr_uses_temp(ii, t) { << true }
            ii = mfn_inext(&f.instrs, ii)
        }
        tk := f.blocks[b].tkind
        if tk == 2 || tk == 3 {
            if f.blocks[b].ta == t { << true }
        }
    }
    << false
}

fn mir_block_reloads_temp(f &MFn, bi int, t int) bool {
    if t < 0 { << false }
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { << false }
        if mfn_ikind(&f.instrs, ii) == 2 && mfn_ia(&f.instrs, ii) == t { << true }
        ii = mfn_inext(&f.instrs, ii)
    }
    << false
}

fn mir_temp_used_in_body(f &MFn, bi int, t int) bool {
    if t < 0 { << false }
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { << false }
        if f.instr_uses_temp(ii, t) { << true }
        ii = mfn_inext(&f.instrs, ii)
    }
    tk := f.blocks[bi].tkind
    if tk == 2 || tk == 3 {
        if f.blocks[bi].ta == t { << true }
    }
    << false
}

// Fold `body: Branch c, latch, exit; latch: StoreLocal*; Jump body`
// into a self-loop so the increment sits in the same block as the test.
fn mir_merge_branch_latch(f $&MFn) bool {
    n := f.blocks.len
    $changed := false
    for bi in 0:n {
        if f.blocks[bi].tkind != 2 { -> }
        $latch := f.skip_empty_jumps(f.blocks[bi].tb)
        if latch == bi {
            if f.blocks[bi].tb != bi {
                $pb := f.blocks[bi]
                pb.tb = bi
                mfn_set_block($&f.blocks, bi, pb)
                changed = true
            }
            ->
        }
        if latch < 0 || latch >= n { -> }
        if f.blocks[latch].tkind != 1 { -> }
        back := f.skip_empty_jumps(f.blocks[latch].ta)
        if back != bi { -> }
        pred := f.unique_ext_pred(latch)
        if pred != bi {
            if pred < 0 { -> }
            if f.blocks[pred].head >= 0 { -> }
            if f.blocks[pred].tkind != 1 { -> }
            if f.unique_ext_pred(pred) != bi { -> }
        }
        $nins := 0
        $ok := true
        $ids := []int{}
        $ii := f.blocks[latch].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := f.instrs[ii].kind
            if k != 1 && k != 3 { ok = false }
            if k == 1 {
                // Phi Copies of a stack trip counter (pair `k += 1`) have
                // no index use. Folding them into the self-loop lets RA
                // put dest in a vreg and leave the next iter's add loading
                // a stale frame slot. Index temps (nbody `j`) stay in a
                // home the body already uses. f64 scalar temps (e.g. accumulator)
                // stay in FP registers without stack-slot stale reloads.
                // Pure SSA scalar integers/bools are also safe to merge when
                // used exclusively inside the loop body without stale reloads.
                dest := f.instrs[ii].a
                $dest_ok := mir_temp_used_as_index(&*f, bi, dest)
                if !dest_ok && dest >= 0 && dest < f.temps.len {
                    if f.temps[dest] == 4 {
                        dest_ok = true
                    } else if (f.temps[dest] == 1 || f.temps[dest] == 2) && f.temps_nslots[dest] == 1 {
                        if !mir_block_reloads_temp(&*f, bi, dest) && mir_temp_used_in_body(&*f, bi, dest) && !mir_temp_used_outside_blocks(&*f, bi, latch, dest) {
                            dest_ok = true
                        }
                    }
                }
                if !dest_ok { ok = false }
            }
            nins += 1
            if nins > 4 { ok = false }
            ids.push(ii)
            ii = f.instrs[ii].next
        }
        if !ok { -> }
        for k in 0:ids.len {
            mir_detach_instr(f, latch, ids[k])
        }
        for k in 0:ids.len {
            mir_append_instr(f, bi, ids[k])
        }
        $pb := f.blocks[bi]
        pb.tb = bi
        mfn_set_block($&f.blocks, bi, pb)
        $dead := f.blocks[latch]
        dead.head = -1
        dead.tail = -1
        dead.tkind = 0
        dead.ta = -1
        dead.tb = -1
        dead.tc = -1
        mfn_set_block($&f.blocks, latch, dead)
        changed = true
    }
    << changed
}

// Phi elim splits a self-loop's critical back-edge into
// `body: Branch latch, exit; latch: Copy; Jump body`. SimplifyCFG runs
// before promotion, so that latch is born after merge_branch_latch's
// window. Fold it here so emit sees `tb == bi` again (nbody inner j).
fn mir_thread_empty_jumps(f $&MFn) bool {
    $changed := false
    for bi in 0:f.blocks.len {
        tk := f.blocks[bi].tkind
        if tk == 1 {
            to := mir_skip_empty_jump_fn(&*f, f.blocks[bi].ta)
            if to >= 0 && to != f.blocks[bi].ta {
                $b := f.blocks[bi]
                b.ta = to
                mfn_set_block($&f.blocks, bi, b)
                changed = true
            }
        } else if tk == 2 {
            tb := mir_skip_empty_jump_fn(&*f, f.blocks[bi].tb)
            tc := mir_skip_empty_jump_fn(&*f, f.blocks[bi].tc)
            $b := f.blocks[bi]
            $b_changed := false
            if tb >= 0 && tb != b.tb {
                b.tb = tb
                b_changed = true
            }
            if tc >= 0 && tc != b.tc {
                b.tc = tc
                b_changed = true
            }
            if b_changed {
                mfn_set_block($&f.blocks, bi, b)
                changed = true
            }
        }
    }
    << changed
}

fn mir_fold_phi_backedge_copies(f $&MFn) {
    for _ in 0:8 {
        if !mir_merge_branch_latch(f) { <- }
    }
    mir_zap_unreachable(f)
}

fn mir_skip_empty_jump_fn(f &MFn, start int) int {
    $bi := start
    for _ in 0:f.blocks.len {
        if bi < 0 || bi >= f.blocks.len { << -1 }
        if f.blocks[bi].head >= 0 || f.blocks[bi].tkind != 1 { << bi }
        to := f.blocks[bi].ta
        if to == bi { << bi }
        bi = to
    }
    << -1
}

fn mir_simplify_cfg(f $&MFn) {
    if mir_fn_keeps_branch_diamond(&*f) { << }
    // Same pass set as bootstrap simplify_cfg (no SSA). Store DSE still
    // skips self-loop latches so RA can pin them. LoadLocal CSE + DCE run
    // on latches: CSE Copies of induction loads are forwarded then DCE'd,
    // leaving one LoadLocal feeding every `a*b+j` (row-walk / madd seed).
    // DCE is liveness (killed-by-redef), so unroll's extra latch `lt`s die.
    for _round in 0:8 {
        $changed := mir_local_cse(f)
        if changed {
            mir_copy_prop_fn(f)
        }
        if mir_fold_identities(f) { changed = true }
        if mir_fold_const_cmps(f) { changed = true }
        if mir_binop_cse(f) { changed = true }
        if mir_dse(f) { changed = true }
        if mir_dse_unread_locals(f) { changed = true }
        if mir_dce_pure(f) { changed = true }
        if changed {
            mir_copy_prop_fn(f)
        }
        if mir_fold_trivial_branches(f) { changed = true }
        if mir_thread_implied(f) { changed = true }
        if mir_hoist_common_branch(f) { changed = true }
        // A back-edge that only hops through an empty Jump is still the
        // same latch. Retarget it so counted loops are self-loops again;
        // the old jmp_map form of this fold is what faulted parse_duration.
        if mir_thread_empty_jumps(f) { changed = true }
        if mir_merge_jump_blocks(f) { changed = true }
        if mir_merge_branch_latch(f) { changed = true }
        if mir_zap_unreachable(f) { changed = true }
        if !changed { <- }
    }
}
