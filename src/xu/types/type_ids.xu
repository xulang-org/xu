@xu/types

// A type id is a kind plus an index into a growable registry. Legacy ids are
// retained by the family helpers for bootstrap/MIR compatibility. Additional
// entries share this encoding; no family owns a fixed-size numeric window.
pub const TYPE_KIND_STRUCT = 1
pub const TYPE_KIND_ARRAY = 2
pub const TYPE_KIND_THROW = 3
pub const TYPE_KIND_PARAM = 4
pub const TYPE_KIND_ENUM = 5
pub const TYPE_KIND_CHAN = 6
pub const TYPE_KIND_FN = 7
pub const TYPE_KIND_INTERFACE = 8
pub const TYPE_KIND_MAP = 9
pub const TYPE_KIND_REF = 10
pub const TYPE_KIND_MUT_REF = 11
const TYPE_DYNAMIC_BASE = 4294967296
const TYPE_KIND_BITS = 4
const TYPE_KIND_MASK = 15
// Arithmetic addressability, not a program-size policy. The allocator is the
// practical boundary long before a registry can hold this many entries.
// Derived from (INT_MAX - TYPE_DYNAMIC_BASE - TYPE_KIND_MASK) / 16.
const TYPE_INDEX_MAX = 576460752034988031

pub fn type_id(kind int,index int) int {
    if kind < TYPE_KIND_STRUCT || kind > TYPE_KIND_MUT_REF || index < 0 || index > TYPE_INDEX_MAX { << -1 }
    << TYPE_DYNAMIC_BASE + (index << TYPE_KIND_BITS) + kind
}
pub fn type_kind(t int) int {
    if t < TYPE_DYNAMIC_BASE { << 0 }
    kind := (t - TYPE_DYNAMIC_BASE) & TYPE_KIND_MASK
    if kind < TYPE_KIND_STRUCT || kind > TYPE_KIND_MUT_REF { << 0 }
    << kind
}
pub fn type_index(t int) int {
    if type_kind(t) == 0 { << -1 }
    << (t - TYPE_DYNAMIC_BASE) >> TYPE_KIND_BITS
}
pub fn array_type(index int) int { if index < 0 { << -1 }
    if index < 100 { << 200 + index }
    << type_id(TYPE_KIND_ARRAY,index) }
pub fn array_index(t int) int { if t >= 200 && t < 300 { << t - 200 }
    if type_kind(t) == TYPE_KIND_ARRAY { << type_index(t) }
    << -1 }
pub fn enum_type(index int) int { if index < 0 { << -1 }
    if index < 100 { << 500 + index }
    << type_id(TYPE_KIND_ENUM,index) }
pub fn enum_index(t int) int { if t >= 500 && t < 600 { << t - 500 }
    if type_kind(t) == TYPE_KIND_ENUM { << type_index(t) }
    << -1 }
pub fn chan_type(index int) int { if index < 0 { << -1 }
    if index < 100 { << 600 + index }
    << type_id(TYPE_KIND_CHAN,index) }
pub fn chan_index(t int) int { if t >= 600 && t < 700 { << t - 600 }
    if type_kind(t) == TYPE_KIND_CHAN { << type_index(t) }
    << -1 }
pub fn fn_type(index int) int { if index < 0 { << -1 }
    if index < 100 { << 700 + index }
    << type_id(TYPE_KIND_FN,index) }
pub fn fn_index(t int) int { if t >= 700 && t < 800 { << t - 700 }
    if type_kind(t) == TYPE_KIND_FN { << type_index(t) }
    << -1 }
pub fn interface_type(index int) int { if index < 0 { << -1 }
    if index < 190 { << 810 + index }
    << type_id(TYPE_KIND_INTERFACE,index) }
pub fn interface_index(t int) int { if t >= 810 && t < 1000 { << t - 810 }
    if type_kind(t) == TYPE_KIND_INTERFACE { << type_index(t) }
    << -1 }
fn registry_ref_type(mutable bool,index int) int {
    if index < 1000 { if mutable { << 4000 + index }
        << 3000 + index }
    mut kind := TYPE_KIND_REF
    if mutable { kind = TYPE_KIND_MUT_REF }
    << type_id(kind,index)
}
fn registry_ref_index(t int) int {
    if t >= 3000 && t < 4000 { << t - 3000 }
    if t >= 4000 && t < 5000 { << t - 4000 }
    kind := type_kind(t)
    if kind == TYPE_KIND_REF || kind == TYPE_KIND_MUT_REF { << type_index(t) }
    << -1
}
// Shared by Checker, MIR and emitters. Unknown registry indices fail closed.
pub fn ref_inner_at(refs &[]int,t int) int {
    if t >= 1000 && t < 2000 { << t - 1000 }
    if t >= 2000 && t < 3000 { << t - 2000 }
    index := registry_ref_index(t)
    if index < 0 || index >= refs.len { << -1 }
    << refs[index]
}
