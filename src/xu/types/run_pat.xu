@xu/types

// Go `testing -run` 风格：非锚定正则。空模式匹配全部。
// 子集：字面量、`.`、`*`/`+`/`?`、`^`/`$`、`|`、`()`、`[abc]`/`[a-z]`/`[^]`、`\`。

pub fn run_pattern_matches(pat string, name string) bool {
    if pat.len == 0 {
        << true
    }
    if pat[0] == 94 {
        << match_here(pat, 1, name, 0)
    }
    if match_here(pat, 0, name, 0) {
        << true
    }
    mut i := 1
    while i <= name.len {
        if match_here(pat, 0, name, i) {
            << true
        }
        i = i + 1
    }
    << false
}

fn match_here(p0 string, pi0 int, s0 string, si0 int) bool {
    mut p := p0 + ""
    mut s := s0 + ""
    mut pi := pi0
    mut si := si0
    if pi >= p.len {
        << true
    }
    if p[pi] == 36 && pi + 1 == p.len {
        << si == s.len
    }
    if p[pi] == 124 {
        << false
    }
    alt := find_alt(p + "", pi)
    if alt >= 0 {
        left := p[pi:alt] + ""
        if match_here(left, 0, s + "", si) {
            << true
        }
        << match_here(p + "", alt + 1, s + "", si)
    }
    atom_end := parse_atom_end(p + "", pi)
    if atom_end < 0 {
        << false
    }
    next_pi := atom_end
    mut quant := 3
    if next_pi < p.len {
        q := p[next_pi]
        if q == 42 {
            quant = 0
        } else {
            if q == 43 {
                quant = 1
            } else {
                if q == 63 {
                    quant = 2
                }
            }
        }
    }
    mut after := next_pi
    if quant < 3 {
        after = next_pi + 1
    }
    if quant == 0 {
        << star_match(p + "", pi, atom_end, after, s + "", si)
    }
    if quant == 1 {
        nsi := consume_atom(p + "", pi, atom_end, s + "", si)
        if nsi < 0 {
            << false
        }
        << star_match(p + "", pi, atom_end, after, s + "", nsi)
    }
    if quant == 2 {
        nsi := consume_atom(p + "", pi, atom_end, s + "", si)
        if nsi >= 0 {
            if match_here(p + "", after, s + "", nsi) {
                << true
            }
        }
        << match_here(p + "", after, s + "", si)
    }
    nsi2 := consume_atom(p + "", pi, atom_end, s + "", si)
    if nsi2 < 0 {
        << false
    }
    << match_here(p + "", after, s + "", nsi2)
}

fn find_alt(p string, from int) int {
    mut depth := 0
    mut i := from
    while i < p.len {
        ch := p[i]
        if ch == 92 {
            i = i + 2
        } else {
            if ch == 91 {
                i = i + 1
                while i < p.len && p[i] != 93 {
                    if p[i] == 92 {
                        i = i + 1
                    }
                    i = i + 1
                }
            } else {
                if ch == 40 {
                    depth = depth + 1
                    i = i + 1
                } else {
                    if ch == 41 {
                        if depth == 0 {
                            << -1
                        }
                        depth = depth - 1
                        i = i + 1
                    } else {
                        if ch == 124 && depth == 0 {
                            << i
                        } else {
                            i = i + 1
                        }
                    }
                }
            }
        }
    }
    << -1
}

fn parse_atom_end(p string, pi int) int {
    if pi >= p.len {
        << -1
    }
    ch := p[pi]
    if ch == 92 {
        if pi + 1 >= p.len {
            << -1
        }
        << pi + 2
    }
    if ch == 91 {
        mut i := pi + 1
        if i < p.len && p[i] == 94 {
            i = i + 1
        }
        while i < p.len && p[i] != 93 {
            if p[i] == 92 {
                i = i + 1
            }
            i = i + 1
        }
        if i >= p.len {
            << -1
        }
        << i + 1
    }
    if ch == 40 {
        mut depth := 1
        mut i := pi + 1
        while i < p.len && depth > 0 {
            c2 := p[i]
            if c2 == 92 {
                i = i + 2
            } else {
                if c2 == 40 {
                    depth = depth + 1
                    i = i + 1
                } else {
                    if c2 == 41 {
                        depth = depth - 1
                        i = i + 1
                    } else {
                        i = i + 1
                    }
                }
            }
        }
        if depth != 0 {
            << -1
        }
        << i
    }
    if ch == 94 || ch == 36 || ch == 124 || ch == 41 || ch == 42 || ch == 43 || ch == 63 {
        << -1
    }
    << pi + 1
}

fn consume_atom(p string, pi int, atom_end int, s string, si int) int {
    if pi >= p.len {
        << -1
    }
    ch := p[pi]
    if ch == 46 {
        if si >= s.len {
            << -1
        }
        << si + 1
    }
    if ch == 92 {
        if pi + 1 >= p.len || si >= s.len {
            << -1
        }
        if s[si] == p[pi + 1] {
            << si + 1
        }
        << -1
    }
    if ch == 91 {
        if si >= s.len {
            << -1
        }
        if class_match(p[pi:atom_end], s[si]) {
            << si + 1
        }
        << -1
    }
    if ch == 40 {
        inner := p[(pi + 1):(atom_end - 1)]
        << greedy_group(inner, s, si)
    }
    if si < s.len && s[si] == ch {
        << si + 1
    }
    << -1
}

fn greedy_group(inner string, s string, si int) int {
    mut end := s.len
    while end >= si {
        slice := s[si:end]
        if match_full(inner, slice) {
            << end
        }
        end = end - 1
    }
    << -1
}

fn match_full(p string, s string) bool {
    wrapped := p + string_from_byte(36)
    << match_here(wrapped, 0, s, 0)
}

fn class_match(class string, ch int) bool {
    if class.len < 2 || class[0] != 91 || class[class.len - 1] != 93 {
        << false
    }
    mut i := 1
    mut neg := false
    if i < class.len - 1 && class[i] == 94 {
        neg = true
        i = i + 1
    }
    mut ok := false
    while i < class.len - 1 {
        if class[i] == 92 && i + 1 < class.len - 1 {
            if ch == class[i + 1] {
                ok = true
            }
            i = i + 2
        } else {
            if i + 2 < class.len - 1 && class[i + 1] == 45 {
                a := class[i]
                b := class[i + 2]
                if ch >= a && ch <= b {
                    ok = true
                }
                i = i + 3
            } else {
                if ch == class[i] {
                    ok = true
                }
                i = i + 1
            }
        }
    }
    if neg {
        << !ok
    }
    << ok
}

fn star_match(p string, atom_pi int, atom_end int, after int, s string, si0 int) bool {
    mut positions := []int{}
    positions.push(si0)
    mut si := si0
    while 1 == 1 {
        nsi := consume_atom(p, atom_pi, atom_end, s, si)
        if nsi < 0 || nsi == si {
            <-
        }
        si = nsi
        positions.push(si)
        if positions.len > 256 {
            <-
        }
    }
    mut k := positions.len - 1
    while k >= 0 {
        if match_here(p, after, s, positions[k]) {
            << true
        }
        k = k - 1
    }
    << false
}
