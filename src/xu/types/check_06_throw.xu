@xu/types

#xu/parser

fn (c &Checker) resolve_throw_callee(name string, caller_mod string, index &mut ThrowCallIndex) int {
    mut nm := name + ""
    mut mod := caller_mod + ""
    mut dot := -1
    for i in 0:nm.len {
        if nm[i] == 46 {
            dot = i
        }
    }
    if dot >= 0 {
        << c.find_fn_in_mod_safe(nm[dot + 1:nm.len], nm[0:dot], index)
    }
    << c.find_fn_in_mod_safe(nm + "", mod + "", index)
}

// Prefer fn_safe_* tables — do not read c.fns[i].name/mod_id.
fn (c &Checker) find_fn_in_mod_safe(name string, mod string, index &mut ThrowCallIndex) int {
    if !throw_use_call_index(c, index) { << c.find_fn_in_mod_safe_linear(name, mod) }
    key := throw_call_key(name, mod)
    << strmap_get(&index.first, &key)
}

fn (c &Checker) ast_method_call_propagates_throw(p &parser.Parser, e int, caller_mod string, index &mut ThrowCallIndex) bool {
    if e < 0 || p.nodes[e].kind != 8 {
        << false
    }
    if !throw_use_call_index(c, index) { << c.ast_method_call_propagates_throw_linear(p, e, caller_mod) }
    mname := p.nodes[e].sval + ""
    mod := caller_mod + ""
    // Every same-module/name candidate participates, including free fns.
    // Inspect live flags on each pass; a cached negative would be stale.
    key := throw_call_key(mname, mod)
    mut i := strmap_get(&index.heads, &key)
    while i >= 0 {
        if i < c.fn_may_throw.len && c.fn_may_throw[i] != 0 { << true }
        i = index.next[i]
    }
    << false
}

fn (c &Checker) ast_expr_propagates_throw(p &parser.Parser, e int, caller_mod string, index &mut ThrowCallIndex) bool {
    if e < 0 {
        << false
    }
    k := p.nodes[e].kind
    if k == 71 {
        << c.ast_stmts_propagate_throw(p, p.nodes[e].c, caller_mod, index)
    }
    if k == 5 {
        name := p.nodes[e].sval + ""
        fi := c.resolve_throw_callee(name + "", caller_mod + "", index)
        if fi >= 0 && fi < c.fn_may_throw.len {
            << c.fn_may_throw[fi] != 0
        }
        if name == "parse_int" || name == "read_file" || name == "read_dir" || name == "write_file" || name == "os_stat" || name == "os_mkdir" || name == "os_rename" || name == "os_remove" || name == "os_open" || name == "os_fd_read" || name == "os_fd_write" || name == "os_fd_close" || name == "os_chmod" || name == "os_chdir" || name == "os_symlink" || name == "os_readlink" || name == "os_fd_seek" || name == "os_pipe" || name == "sys_random_fill" || name == "sys_security_store" || name == "sys_interface_data" || name == "sys_socket" || name == "sys_bind4" || name == "sys_connect4" || name == "sys_bind6" || name == "sys_connect6" || name == "sys_bind_unix" || name == "sys_connect_unix" || name == "sys_listen" || name == "sys_accept" || name == "sys_sendto" || name == "sys_recvfrom" || name == "sys_setsockopt_timeo" {
            << true
        }
    }
    if k == 8 {
        obj := p.nodes[e].a
        if obj >= 0 {
            ok := p.nodes[obj].kind
            if ok == 7 || ok == 13 {
                << false
            }
        }
        << c.ast_method_call_propagates_throw(p, e, caller_mod, index)
    }
    << false
}

fn (c &Checker) ast_stmt_has_throw(p &parser.Parser, s int) bool {
    if s < 0 {
        << false
    }
    k := p.nodes[s].kind
    if k == 70 {
        << true
    }
    if k == 24 {
        mut br := p.nodes[s].a
        while br >= 0 {
            if c.ast_stmts_has_throw(p, p.nodes[br].b) {
                << true
            }
            br = p.nodes[br].next
        }
        if p.nodes[s].b >= 0 && c.ast_stmts_has_throw(p, p.nodes[s].b) {
            << true
        }
        << false
    }
    if k == 27 {
        // A for-in iterable is evaluated before entering the body. An
        // explicit rethrow in that expression makes this function throwing.
        ec := p.nodes[s].a
        if ec >= 0 && p.nodes[ec].kind == 71 {
            if c.ast_stmts_has_throw(p, p.nodes[ec].c) { << true }
        }
        << c.ast_stmts_has_throw(p, p.nodes[s].c)
    }
    if k == 26 || k == 32 {
        << c.ast_stmts_has_throw(p, p.nodes[s].c)
    }
    if k == 28 {
        mut arm := p.nodes[s].b
        while arm >= 0 {
            if c.ast_stmts_has_throw(p, p.nodes[arm].c) {
                << true
            }
            arm = p.nodes[arm].next
        }
        << false
    }
    if k == 60 {
        mut arm := p.nodes[s].a
        while arm >= 0 {
            if c.ast_stmts_has_throw(p, p.nodes[arm].c) {
                << true
            }
            arm = p.nodes[arm].next
        }
        if p.nodes[s].b >= 0 && c.ast_stmts_has_throw(p, p.nodes[s].b) {
            << true
        }
        << false
    }
    if k == 22 {
        ec := p.nodes[s].a
        if ec >= 0 {
            ek := p.nodes[ec].kind
            if ek == 70 {
                << true
            }
            if ek == 71 {
                << c.ast_stmts_has_throw(p, p.nodes[ec].c)
            }
        }
        << false
    }
    // << expr / let x := expr — throw may sit inside `or (err) { >> … }`.
    if k == 23 || k == 20 {
        ec := p.nodes[s].a
        if ec >= 0 {
            ek := p.nodes[ec].kind
            if ek == 70 {
                << true
            }
            if ek == 71 {
                << c.ast_stmts_has_throw(p, p.nodes[ec].c)
            }
        }
        << false
    }
    << false
}

fn (c &Checker) ast_stmts_has_throw(p &parser.Parser, head int) bool {
    mut s := head
    while s >= 0 {
        if c.ast_stmt_has_throw(p, s) {
            << true
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &Checker) ast_stmt_propagates_throw(p &parser.Parser, s int, caller_mod string, index &mut ThrowCallIndex) bool {
    if s < 0 {
        << false
    }
    k := p.nodes[s].kind
    if k == 22 {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    if k == 20 {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    if k == 23 && p.nodes[s].a >= 0 {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    if k == 24 {
        mut br := p.nodes[s].a
        while br >= 0 {
            if c.ast_stmts_propagate_throw(p, p.nodes[br].b, caller_mod, index) {
                << true
            }
            br = p.nodes[br].next
        }
        if p.nodes[s].b >= 0 && c.ast_stmts_propagate_throw(p, p.nodes[s].b, caller_mod, index) {
            << true
        }
        << false
    }
    if k == 27 {
        // Include the once-evaluated iterable in the throw fixed point.
        // ast_expr_propagates_throw preserves handled-or semantics.
        if c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index) {
            << true
        }
        << c.ast_stmts_propagate_throw(p, p.nodes[s].c, caller_mod, index)
    }
    if k == 26 || k == 32 {
        << c.ast_stmts_propagate_throw(p, p.nodes[s].c, caller_mod, index)
    }
    if k == 28 {
        if c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index) { << true }
        mut arm := p.nodes[s].b
        while arm >= 0 {
            if c.ast_stmts_propagate_throw(p, p.nodes[arm].c, caller_mod, index) {
                << true
            }
            arm = p.nodes[arm].next
        }
        << false
    }
    if k == 22 {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    << false
}

fn (c &Checker) ast_stmts_propagate_throw(p &parser.Parser, head int, caller_mod string, index &mut ThrowCallIndex) bool {
    mut s := head
    while s >= 0 {
        if c.ast_stmt_propagates_throw(p, s, caller_mod, index) {
            << true
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &mut Checker) setup_throw_metadata(p &parser.Parser) {
    n := c.fns.len
    // Grow in place — do not `= []int{}` (drop of a corrupt boot descriptor OOMs).
    while c.fn_may_throw.len < n {
        c.fn_may_throw.push(0)
    }
    while c.fn_throw_ty.len < n {
        c.fn_throw_ty.push(0)
    }
    for i in 0:n {
        checker_set_i(mut &c.fn_may_throw, i, 0)
        checker_set_i(mut &c.fn_throw_ty, i, 0)
    }
    for i in 0:n {
        d := c.fndecl[i]
        if c.ast_stmts_has_throw(p, p.nodes[d].c) {
            checker_set_i(mut &c.fn_may_throw, i, 1)
        }
    }
    mut index := ThrowCallIndex{first: StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0}, heads: StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0}, next: []int{}, queries: 0, ready: false}
    zero_strmap(mut &index.first)
    zero_strmap(mut &index.heads)
    mut changed := true
    while changed {
        changed = false
        for i in 0:n {
            if c.fn_may_throw[i] != 0 {
                ->
            }
            d := c.fndecl[i]
            // Use fn_safe_mod — never c.fns[i].mod_id (scrambled after CFn push).
            mut mod := ""
            if i < c.fn_safe_mod.len {
                mod = c.fn_safe_mod[i] + ""
            }
            if c.ast_stmts_propagate_throw(p, p.nodes[d].c, mod + "", mut &index) {
                checker_set_i(mut &c.fn_may_throw, i, 1)
                changed = true
            }
        }
    }
    // Resolve errors.Error only when some non-main fn actually throws.
    // find_iface_global → map_key/strmap on WoA x64 OOMs for hello (no throw).
    mut need_err := false
    for i in 0:n {
        mut nm0 := ""
        if i < c.fn_safe_name.len {
            nm0 = c.fn_safe_name[i] + ""
        }
        if c.fn_may_throw[i] != 0 && c.fns[i].ret != 0 && nm0 != "main" {
            need_err = true
        }
    }
    if need_err {
        c.errors_iface = c.find_iface_global("Error", "errors")
    } else {
        c.errors_iface = -1
    }
    err_ty := iface_ty(c.errors_iface)
    for i in 0:n {
        mut nm := ""
        if i < c.fn_safe_name.len {
            nm = c.fn_safe_name[i] + ""
        }
        if c.fn_may_throw[i] != 0 && c.fns[i].ret != 0 && nm != "main" {
            si1003 := c.intern_throw_type(c.fns[i].ret, err_ty)
            checker_set_i(mut &c.fn_throw_ty, i, si1003)
        }
    }
}

fn (c &Checker) or_body_definite(p &parser.Parser, head int, assign_name string) bool {
    mut s := head
    while s >= 0 {
        k := p.nodes[s].kind
        if k == 23 || k == 33 || k == 34 || k == 70 || k == 72 {
            << true
        }
        if k == 21 && assign_name.len > 0 {
            t := p.nodes[s].a
            if p.nodes[t].kind == 4 && p.nodes[t].sval == assign_name {
                << true
            }
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &mut Checker) check_throw_value(p &parser.Parser, n int) int {
    ty := c.check_expr(p, n)
    err_ty := iface_ty(c.errors_iface)
    if ty == err_ty {
        c.move_of(p, n, ty, true)
        << err_ty
    }
    if is_struct_type(ty) {
        if c.type_contains_ref(ty) {
            c.fail_node(p, n, "cannot throw " + c.ty_display(ty) + " (contains a reference)")
            << error_ty
        }
        if !c.check_interface_box_contract(p, ty, c.errors_iface, n) { << error_ty }
        c.move_of(p, n, ty, true)
        // Keep the expression's original call/constructor metadata. Throw
        // lowering boxes its evaluated value; replacing ncall here would
        // reinterpret a factory call's first argument as the entire error.
        << err_ty
    }
    c.fail_node(p, n, ">> expects errors.Error or a struct implementing it, found " + c.ty_display(ty))
    << 0
}

fn (c &mut Checker) wrap_throwable_parse_int(p &parser.Parser, n int) int {
    err_ty := iface_ty(c.errors_iface)
    throw_ty := c.intern_throw_type(1, err_ty)
    if c.in_or_catch == 1 {
        checker_set_i(mut &c.ncall, n, -24)
        checker_set_i(mut &c.ntype, n, throw_ty)
        << throw_ty
    }
    if c.cur_throw_ty >= 300 {
        checker_set_i(mut &c.ncall, n, -83)
        checker_set_i(mut &c.nconst, n, -24)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    // Keep fail-closed for unhandled throw (negative fixtures: err_throw_no_or).
    c.fail_node(p, n, "call may throw; use `or (err) { }` to handle the error")
    << 0
}

fn (c &mut Checker) assign_hosted_ncall(n int, builtin_ncall int) {
    // Literal assignments keep NCALL_REGISTRY ↔ check.xu in sync.
    if builtin_ncall == -10 { checker_set_i(mut &c.ncall, n, -10 ) }
    if builtin_ncall == -11 { checker_set_i(mut &c.ncall, n, -11 ) }
    if builtin_ncall == -26 { checker_set_i(mut &c.ncall, n, -26 ) }
    if builtin_ncall == -50 { checker_set_i(mut &c.ncall, n, -50 ) }
    if builtin_ncall == -51 { checker_set_i(mut &c.ncall, n, -51 ) }
    if builtin_ncall == -52 { checker_set_i(mut &c.ncall, n, -52 ) }
    if builtin_ncall == -53 { checker_set_i(mut &c.ncall, n, -53 ) }
    if builtin_ncall == -58 { checker_set_i(mut &c.ncall, n, -58 ) }
    if builtin_ncall == -59 { checker_set_i(mut &c.ncall, n, -59 ) }
    if builtin_ncall == -60 { checker_set_i(mut &c.ncall, n, -60 ) }
    if builtin_ncall == -61 { checker_set_i(mut &c.ncall, n, -61 ) }
    if builtin_ncall == -62 { checker_set_i(mut &c.ncall, n, -62 ) }
    if builtin_ncall == -63 { checker_set_i(mut &c.ncall, n, -63 ) }
    if builtin_ncall == -64 { checker_set_i(mut &c.ncall, n, -64 ) }
    if builtin_ncall == -65 { checker_set_i(mut &c.ncall, n, -65 ) }
    if builtin_ncall == -66 { checker_set_i(mut &c.ncall, n, -66 ) }
    if builtin_ncall == -67 { checker_set_i(mut &c.ncall, n, -67 ) }
    if builtin_ncall == -29 { checker_set_i(mut &c.ncall, n, -29 ) }
    if builtin_ncall == -79 { checker_set_i(mut &c.ncall, n, -79 ) }
    if builtin_ncall == -81 { checker_set_i(mut &c.ncall, n, -81 ) }
    if builtin_ncall == -82 { checker_set_i(mut &c.ncall, n, -82 ) }
    if builtin_ncall == -100 { checker_set_i(mut &c.ncall, n, -100 ) }
    if builtin_ncall == -109 { checker_set_i(mut &c.ncall, n, -109 ) }
    if builtin_ncall == -111 { checker_set_i(mut &c.ncall, n, -111 ) }
    if builtin_ncall == -112 { checker_set_i(mut &c.ncall, n, -112 ) }
    if builtin_ncall == -113 { checker_set_i(mut &c.ncall, n, -113 ) }
    if builtin_ncall == -114 { checker_set_i(mut &c.ncall, n, -114 ) }
    if builtin_ncall == -115 { checker_set_i(mut &c.ncall, n, -115 ) }
    if builtin_ncall == -116 { checker_set_i(mut &c.ncall, n, -116 ) }
    if builtin_ncall == -118 { checker_set_i(mut &c.ncall, n, -118 ) }
    if builtin_ncall == -122 { checker_set_i(mut &c.ncall, n, -122 ) }
    if builtin_ncall == -123 { checker_set_i(mut &c.ncall, n, -123 ) }
    if builtin_ncall == -124 { checker_set_i(mut &c.ncall, n, -124 ) }
    if builtin_ncall == -125 { checker_set_i(mut &c.ncall, n, -125 ) }
    if builtin_ncall == -126 { checker_set_i(mut &c.ncall, n, -126 ) }
    if builtin_ncall == -128 { checker_set_i(mut &c.ncall, n, -128 ) }
}

fn (c &mut Checker) wrap_throwable_hosted_builtin(p &parser.Parser, n int, ok_ty int, builtin_ncall int) int {
    err_ty := iface_ty(c.errors_iface)
    throw_ty := c.intern_throw_type(ok_ty, err_ty)
    if c.in_or_catch == 1 {
        c.assign_hosted_ncall(n, builtin_ncall)
        checker_set_i(mut &c.ntype, n, throw_ty)
        << throw_ty
    }
    if c.cur_throw_ty >= 300 {
        checker_set_i(mut &c.ncall, n, -83)
        checker_set_i(mut &c.nconst, n, builtin_ncall)
        checker_set_i(mut &c.ntype, n, ok_ty)
        << ok_ty
    }
    c.fail_node(p, n, "call may throw; use `or (err) { }` to handle the error")
    << 0
}

fn (c &mut Checker) wrap_throwable_call_result(p &parser.Parser, n int, fi int, user_ret int) int {
    if fi < 0 || fi >= c.fn_may_throw.len || c.fn_may_throw[fi] == 0 {
        checker_set_i(mut &c.ntype, n, user_ret)
        << user_ret
    }
    err_ty := iface_ty(c.errors_iface)
    throw_ty := c.intern_throw_type(user_ret, err_ty)
    if c.in_or_catch == 1 {
        checker_set_i(mut &c.ntype, n, throw_ty)
        << throw_ty
    }
    if c.cur_throw_ty >= 300 {
        checker_set_i(mut &c.nconst, n, fi)
        checker_set_i(mut &c.ncall, n, -83)
        checker_set_i(mut &c.ntype, n, user_ret)
        << user_ret
    }
    c.fail_node(p, n, "call may throw; use `or (err) { }` to handle the error")
    << 0
}

// Private to one metadata pass; Checker/MIR layouts are unchanged.
struct ThrowCallIndex {
    first StrMap
    heads StrMap
    next []int
    queries int
    ready bool
}

// Length-prefix the module so the pair is unambiguous even for unusual bytes.
fn throw_call_key(name string, mod string) string {
    << str(mod.len) + ":" + mod + name
}

fn build_throw_call_index(c &Checker, index &mut ThrowCallIndex) {
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n { n = c.fn_safe_mod.len }
    for i in 0:n {
        key := throw_call_key(c.fn_safe_name[i] + "", c.fn_safe_mod[i] + "")
        head := strmap_get(&index.heads, &key)
        index.next.push(head)
        if strmap_get(&index.first, &key) < 0 {
            strmap_put(mut &index.first, key + "", i)
        }
        strmap_put(mut &index.heads, key, i)
    }
}

// Amortize construction only after a pass has actually made many queries.
// Leaf-heavy units can make one query despite declaring thousands of fns.
fn throw_use_call_index(c &Checker, index &mut ThrowCallIndex) bool {
    if index.ready { << true }
    index.queries += 1
    if index.queries <= 64 { << false }
    build_throw_call_index(c, index)
    index.ready = true
    << true
}

fn (c &Checker) find_fn_in_mod_safe_linear(name string, mod string) int {
    nm := name + ""
    mid := mod + ""
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n {
        n = c.fn_safe_mod.len
    }
    for i in 0:n {
        if c.fn_safe_name[i] == nm && c.fn_safe_mod[i] == mid {
            << i
        }
    }
    << -1
}

fn (c &Checker) ast_method_call_propagates_throw_linear(p &parser.Parser, e int, caller_mod string) bool {
    if e < 0 || p.nodes[e].kind != 8 {
        << false
    }
    mname := p.nodes[e].sval + ""
    mod := caller_mod + ""
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n {
        n = c.fn_safe_mod.len
    }
    // Match by name + module. Do not read c.fns[i].recv: that field is
    // scrambled after CFn push, same class as mod_id. A same-module free
    // function with the same name is rare and still a throwing callee.
    for i in 0:n {
        if c.fn_safe_mod[i] != mod {
            ->
        }
        if c.fn_safe_name[i] != mname {
            ->
        }
        if i < c.fn_may_throw.len && c.fn_may_throw[i] != 0 {
            << true
        }
    }
    << false
}
