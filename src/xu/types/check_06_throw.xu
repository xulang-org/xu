@xu/types

#xu/ast
#xu/parser

fn (c &Checker) resolve_throw_callee(name string, caller_mod string, index &mut ThrowCallIndex) int {
    mut nm := name + ""
    mut mod := caller_mod + ""
    mut dot := -1
    for i in 0:nm.len {
        if nm[i] == 46 {
            dot = i
        }
    }
    if dot >= 0 {
        << c.find_fn_in_mod_safe(nm[dot + 1:nm.len], nm[0:dot], index)
    }
    << c.find_fn_in_mod_safe(nm + "", mod + "", index)
}

// Prefer fn_safe_* tables — do not read c.fns[i].name/mod_id.
fn (c &Checker) find_fn_in_mod_safe(name string, mod string, index &mut ThrowCallIndex) int {
    if !throw_use_call_index(c, index) { << c.find_fn_in_mod_safe_linear(name, mod, &*index) }
    key := throw_call_key(name, mod)
    << strmap_get(&index.first, &key)
}

fn (c &Checker) ast_method_call_propagates_throw(p &parser.Parser, e int, caller_mod string, index &mut ThrowCallIndex) bool {
    if e < 0 || p.nodes[e].kind != ast.NK_METHOD_CALL {
        << false
    }
    if e < index.qualified_fns.len && index.qualified_fns[e] >= 0 { fi := index.qualified_fns[e]
        << fi < c.fn_may_throw.len && c.fn_may_throw[fi] != 0 }
    if !throw_use_call_index(c, index) { << c.ast_method_call_propagates_throw_linear(p, e, caller_mod, &*index) }
    mname := p.nodes[e].sval + ""
    recv := throw_receiver_at(&*index,e)
    if is_interface_type(recv) { << false }
    mod := c.throw_receiver_module(recv,caller_mod)
    // Known receivers select their own method, never another type's/free fn's
    // effect. Only unresolved generic/interface receivers retain the fallback.
    key := throw_call_key(mname, mod)
    mut i := strmap_get(&index.heads, &key)
    while i >= 0 {
        if throw_method_matches(p,&*index,i,recv) && i < c.fn_may_throw.len && c.fn_may_throw[i] != 0 { << true }
        i = index.next[i]
    }
    << false
}

fn (c &Checker) ast_expr_propagates_throw(p &parser.Parser, e int, caller_mod string, index &mut ThrowCallIndex) bool {
    if e < 0 {
        << false
    }
    k := p.nodes[e].kind
    if k == ast.NK_OR_CATCH {
        << c.ast_stmts_propagate_throw(p, p.nodes[e].c, caller_mod, index)
    }
    if k == ast.NK_CALL {
        name := p.nodes[e].sval + ""
        fi := c.resolve_throw_callee(name + "", caller_mod + "", index)
        if fi >= 0 && fi < c.fn_may_throw.len {
            << c.fn_may_throw[fi] != 0
        }
        if name == "parse_int" || name == "read_file" || name == "read_dir" || name == "write_file" || name == "os_stat" || name == "os_mkdir" || name == "os_rename" || name == "os_remove" || name == "os_open" || name == "os_fd_read" || name == "os_fd_write" || name == "os_fd_close" || name == "os_chmod" || name == "os_chdir" || name == "os_symlink" || name == "os_readlink" || name == "os_fd_seek" || name == "os_pipe" || name == "sys_random_fill" || name == "sys_security_store" || name == "sys_socket_poll" || name == "sys_socket_wait" || name == "sys_interface_data" || name == "sys_socket" || name == "sys_bind4" || name == "sys_connect4" || name == "sys_bind6" || name == "sys_connect6" || name == "sys_bind_unix" || name == "sys_connect_unix" || name == "sys_listen" || name == "sys_accept" || name == "sys_sendto" || name == "sys_recvfrom" || name == "sys_setsockopt_timeo" {
            << true
        }
    }
    if k == ast.NK_METHOD_CALL {
        << c.ast_method_call_propagates_throw(p, e, caller_mod, index)
    }
    << false
}

fn (c &Checker) ast_stmt_has_throw(p &parser.Parser, s int) bool {
    if s < 0 {
        << false
    }
    k := p.nodes[s].kind
    if k == ast.NK_THROW {
        << true
    }
    if k == ast.NK_IF {
        mut br := p.nodes[s].a
        while br >= 0 {
            if c.ast_stmts_has_throw(p, p.nodes[br].b) {
                << true
            }
            br = p.nodes[br].next
        }
        if p.nodes[s].b >= 0 && c.ast_stmts_has_throw(p, p.nodes[s].b) {
            << true
        }
        << false
    }
    if k == ast.NK_FOR_EACH {
        // A for-in iterable is evaluated before entering the body. An
        // explicit rethrow in that expression makes this function throwing.
        ec := p.nodes[s].a
        if ec >= 0 && p.nodes[ec].kind == ast.NK_OR_CATCH {
            if c.ast_stmts_has_throw(p, p.nodes[ec].c) { << true }
        }
        << c.ast_stmts_has_throw(p, p.nodes[s].c)
    }
    if k == ast.NK_FOR || k == ast.NK_WHILE {
        << c.ast_stmts_has_throw(p, p.nodes[s].c)
    }
    if k == ast.NK_MATCH {
        mut arm := p.nodes[s].b
        while arm >= 0 {
            if c.ast_stmts_has_throw(p, p.nodes[arm].c) {
                << true
            }
            arm = p.nodes[arm].next
        }
        << false
    }
    if k == ast.NK_SELECT {
        mut arm := p.nodes[s].a
        while arm >= 0 {
            if c.ast_stmts_has_throw(p, p.nodes[arm].c) {
                << true
            }
            arm = p.nodes[arm].next
        }
        if p.nodes[s].b >= 0 && c.ast_stmts_has_throw(p, p.nodes[s].b) {
            << true
        }
        << false
    }
    if k == ast.NK_EXPR_STMT {
        ec := p.nodes[s].a
        if ec >= 0 {
            ek := p.nodes[ec].kind
            if ek == ast.NK_THROW {
                << true
            }
            if ek == ast.NK_OR_CATCH {
                << c.ast_stmts_has_throw(p, p.nodes[ec].c)
            }
        }
        << false
    }
    // << expr / let x := expr — throw may sit inside `or (err) { >> … }`.
    if k == ast.NK_RETURN || k == ast.NK_LET {
        ec := p.nodes[s].a
        if ec >= 0 {
            ek := p.nodes[ec].kind
            if ek == ast.NK_THROW {
                << true
            }
            if ek == ast.NK_OR_CATCH {
                << c.ast_stmts_has_throw(p, p.nodes[ec].c)
            }
        }
        << false
    }
    << false
}

fn (c &Checker) ast_stmts_has_throw(p &parser.Parser, head int) bool {
    mut s := head
    while s >= 0 {
        if c.ast_stmt_has_throw(p, s) {
            << true
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &Checker) ast_stmt_propagates_throw(p &parser.Parser, s int, caller_mod string, index &mut ThrowCallIndex) bool {
    if s < 0 {
        << false
    }
    k := p.nodes[s].kind
    if k == ast.NK_EXPR_STMT {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    if k == ast.NK_LET {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    if k == ast.NK_RETURN && p.nodes[s].a >= 0 {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    if k == ast.NK_IF {
        mut br := p.nodes[s].a
        while br >= 0 {
            if c.ast_stmts_propagate_throw(p, p.nodes[br].b, caller_mod, index) {
                << true
            }
            br = p.nodes[br].next
        }
        if p.nodes[s].b >= 0 && c.ast_stmts_propagate_throw(p, p.nodes[s].b, caller_mod, index) {
            << true
        }
        << false
    }
    if k == ast.NK_FOR_EACH {
        // Include the once-evaluated iterable in the throw fixed point.
        // ast_expr_propagates_throw preserves handled-or semantics.
        if c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index) {
            << true
        }
        << c.ast_stmts_propagate_throw(p, p.nodes[s].c, caller_mod, index)
    }
    if k == ast.NK_FOR || k == ast.NK_WHILE {
        << c.ast_stmts_propagate_throw(p, p.nodes[s].c, caller_mod, index)
    }
    if k == ast.NK_MATCH {
        if c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index) { << true }
        mut arm := p.nodes[s].b
        while arm >= 0 {
            if c.ast_stmts_propagate_throw(p, p.nodes[arm].c, caller_mod, index) {
                << true
            }
            arm = p.nodes[arm].next
        }
        << false
    }
    if k == ast.NK_EXPR_STMT {
        << c.ast_expr_propagates_throw(p, p.nodes[s].a, caller_mod, index)
    }
    << false
}

fn (c &Checker) ast_stmts_propagate_throw(p &parser.Parser, head int, caller_mod string, index &mut ThrowCallIndex) bool {
    mut s := head
    while s >= 0 {
        if c.ast_stmt_propagates_throw(p, s, caller_mod, index) {
            << true
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &mut Checker) setup_throw_metadata(p &parser.Parser) {
    n := c.fns.len
    // Grow in place — do not `= []int{}` (drop of a corrupt boot descriptor OOMs).
    while c.fn_may_throw.len < n {
        c.fn_may_throw.push(0)
    }
    while c.fn_throw_ty.len < n {
        c.fn_throw_ty.push(0)
    }
    for i in 0:n {
        checker_set_i(mut &c.fn_may_throw, i, 0)
        checker_set_i(mut &c.fn_throw_ty, i, 0)
    }
    for i in 0:n {
        d := c.fndecl[i]
        if c.ast_stmts_has_throw(p, p.nodes[d].c) {
            checker_set_i(mut &c.fn_may_throw, i, 1)
        }
    }
    mut index := new_throw_call_index()
    zero_strmap(mut &index.first)
    zero_strmap(mut &index.heads)
    c.build_throw_receiver_index(p,mut &index)
    mut changed := true
    while changed {
        changed = false
        for i in 0:n {
            if c.fn_may_throw[i] != 0 {
                ->
            }
            d := c.fndecl[i]
            // Use fn_safe_mod — never c.fns[i].mod_id (scrambled after CFn push).
            mut mod := ""
            if i < c.fn_safe_mod.len {
                mod = c.fn_safe_mod[i] + ""
            }
            if c.ast_stmts_propagate_throw(p, p.nodes[d].c, mod + "", mut &index) {
                checker_set_i(mut &c.fn_may_throw, i, 1)
                changed = true
            }
        }
    }
    // Resolve errors.Error only when some non-main fn actually throws.
    // find_iface_global → map_key/strmap on WoA x64 OOMs for hello (no throw).
    mut need_err := false
    for i in 0:n {
        mut nm0 := ""
        if i < c.fn_safe_name.len {
            nm0 = c.fn_safe_name[i] + ""
        }
        if c.fn_may_throw[i] != 0 && c.fns[i].ret != 0 && nm0 != "main" {
            need_err = true
        }
    }
    if need_err {
        c.errors_iface = c.find_iface_global("Error", "errors")
    } else {
        c.errors_iface = -1
    }
    err_ty := iface_ty(c.errors_iface)
    for i in 0:n {
        mut nm := ""
        if i < c.fn_safe_name.len {
            nm = c.fn_safe_name[i] + ""
        }
        if c.fn_may_throw[i] != 0 && c.fns[i].ret != 0 && nm != "main" {
            si1003 := c.intern_throw_type(c.fns[i].ret, err_ty)
            checker_set_i(mut &c.fn_throw_ty, i, si1003)
        }
    }
}

fn (c &Checker) or_body_definite(p &parser.Parser, head int, assign_name string) bool {
    mut s := head
    while s >= 0 {
        k := p.nodes[s].kind
        if k == ast.NK_RETURN || k == ast.NK_BREAK || k == ast.NK_CONTINUE || k == ast.NK_THROW || k == ast.NK_EXIT {
            << true
        }
        if k == ast.NK_ASSIGN && assign_name.len > 0 {
            t := p.nodes[s].a
            if p.nodes[t].kind == ast.NK_IDENT && p.nodes[t].sval == assign_name {
                << true
            }
        }
        s = p.nodes[s].next
    }
    << false
}

fn (c &mut Checker) check_throw_value(p &parser.Parser, n int) int {
    ty := c.check_expr(p, n)
    err_ty := iface_ty(c.errors_iface)
    if ty == err_ty {
        c.move_of(p, n, ty, true)
        << err_ty
    }
    if is_struct_type(ty) {
        if c.type_contains_ref(ty) {
            c.fail_node(p, n, "cannot throw " + c.ty_display(ty) + " (contains a reference)")
            << ERROR_TY
        }
        if !c.check_interface_box_contract(p, ty, c.errors_iface, n) { << ERROR_TY }
        c.move_of(p, n, ty, true)
        // Keep the expression's original call/constructor metadata. Throw
        // lowering boxes its evaluated value; replacing ncall here would
        // reinterpret a factory call's first argument as the entire error.
        << err_ty
    }
    c.fail_node(p, n, ">> expects errors.Error or a struct implementing it, found " + c.ty_display(ty))
    << 0
}

fn (c &mut Checker) wrap_throwable_parse_int(p &parser.Parser, n int) int {
    err_ty := iface_ty(c.errors_iface)
    throw_ty := c.intern_throw_type(1, err_ty)
    if c.in_or_catch == 1 {
        checker_set_i(mut &c.ncall, n, -24)
        checker_set_i(mut &c.ntype, n, throw_ty)
        << throw_ty
    }
    if is_throw_type(c.cur_throw_ty) {
        checker_set_i(mut &c.ncall, n, -83)
        checker_set_i(mut &c.nconst, n, -24)
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    // Keep fail-closed for unhandled throw (negative fixtures: err_throw_no_or).
    c.fail_node(p, n, "call may throw; use `or (err) { }` to handle the error")
    << 0
}

fn (c &mut Checker) assign_hosted_ncall(n int, builtin_ncall int) {
    // Literal assignments keep NCALL_REGISTRY ↔ check.xu in sync.
    if builtin_ncall == -10 { checker_set_i(mut &c.ncall, n, -10 ) }
    if builtin_ncall == -11 { checker_set_i(mut &c.ncall, n, -11 ) }
    if builtin_ncall == -26 { checker_set_i(mut &c.ncall, n, -26 ) }
    if builtin_ncall == -50 { checker_set_i(mut &c.ncall, n, -50 ) }
    if builtin_ncall == -51 { checker_set_i(mut &c.ncall, n, -51 ) }
    if builtin_ncall == -52 { checker_set_i(mut &c.ncall, n, -52 ) }
    if builtin_ncall == -53 { checker_set_i(mut &c.ncall, n, -53 ) }
    if builtin_ncall == -58 { checker_set_i(mut &c.ncall, n, -58 ) }
    if builtin_ncall == -59 { checker_set_i(mut &c.ncall, n, -59 ) }
    if builtin_ncall == -60 { checker_set_i(mut &c.ncall, n, -60 ) }
    if builtin_ncall == -61 { checker_set_i(mut &c.ncall, n, -61 ) }
    if builtin_ncall == -62 { checker_set_i(mut &c.ncall, n, -62 ) }
    if builtin_ncall == -63 { checker_set_i(mut &c.ncall, n, -63 ) }
    if builtin_ncall == -64 { checker_set_i(mut &c.ncall, n, -64 ) }
    if builtin_ncall == -65 { checker_set_i(mut &c.ncall, n, -65 ) }
    if builtin_ncall == -66 { checker_set_i(mut &c.ncall, n, -66 ) }
    if builtin_ncall == -67 { checker_set_i(mut &c.ncall, n, -67 ) }
    if builtin_ncall == -29 { checker_set_i(mut &c.ncall, n, -29 ) }
    if builtin_ncall == -79 { checker_set_i(mut &c.ncall, n, -79 ) }
    if builtin_ncall == -81 { checker_set_i(mut &c.ncall, n, -81 ) }
    if builtin_ncall == -82 { checker_set_i(mut &c.ncall, n, -82 ) }
    if builtin_ncall == -100 { checker_set_i(mut &c.ncall, n, -100 ) }
    if builtin_ncall == -109 { checker_set_i(mut &c.ncall, n, -109 ) }
    if builtin_ncall == -111 { checker_set_i(mut &c.ncall, n, -111 ) }
    if builtin_ncall == -112 { checker_set_i(mut &c.ncall, n, -112 ) }
    if builtin_ncall == -113 { checker_set_i(mut &c.ncall, n, -113 ) }
    if builtin_ncall == -114 { checker_set_i(mut &c.ncall, n, -114 ) }
    if builtin_ncall == -115 { checker_set_i(mut &c.ncall, n, -115 ) }
    if builtin_ncall == -116 { checker_set_i(mut &c.ncall, n, -116 ) }
    if builtin_ncall == -118 { checker_set_i(mut &c.ncall, n, -118 ) }
    if builtin_ncall == -122 { checker_set_i(mut &c.ncall, n, -122 ) }
    if builtin_ncall == -123 { checker_set_i(mut &c.ncall, n, -123 ) }
    if builtin_ncall == -124 { checker_set_i(mut &c.ncall, n, -124 ) }
    if builtin_ncall == -125 { checker_set_i(mut &c.ncall, n, -125 ) }
    if builtin_ncall == -126 { checker_set_i(mut &c.ncall, n, -126 ) }
    if builtin_ncall == -128 { checker_set_i(mut &c.ncall, n, -128 ) }
    if builtin_ncall == -130 { checker_set_i(mut &c.ncall, n, -130 ) }
    if builtin_ncall == -131 { checker_set_i(mut &c.ncall, n, -131 ) }
}

fn (c &mut Checker) wrap_throwable_hosted_builtin(p &parser.Parser, n int, ok_ty int, builtin_ncall int) int {
    err_ty := iface_ty(c.errors_iface)
    throw_ty := c.intern_throw_type(ok_ty, err_ty)
    if c.in_or_catch == 1 {
        c.assign_hosted_ncall(n, builtin_ncall)
        checker_set_i(mut &c.ntype, n, throw_ty)
        << throw_ty
    }
    if is_throw_type(c.cur_throw_ty) {
        checker_set_i(mut &c.ncall, n, -83)
        checker_set_i(mut &c.nconst, n, builtin_ncall)
        checker_set_i(mut &c.ntype, n, ok_ty)
        << ok_ty
    }
    c.fail_node(p, n, "call may throw; use `or (err) { }` to handle the error")
    << 0
}

fn (c &mut Checker) wrap_throwable_call_result(p &parser.Parser, n int, fi int, user_ret int) int {
    if fi < 0 || fi >= c.fn_may_throw.len || c.fn_may_throw[fi] == 0 {
        checker_set_i(mut &c.ntype, n, user_ret)
        << user_ret
    }
    err_ty := iface_ty(c.errors_iface)
    throw_ty := c.intern_throw_type(user_ret, err_ty)
    if c.in_or_catch == 1 {
        checker_set_i(mut &c.ntype, n, throw_ty)
        << throw_ty
    }
    if is_throw_type(c.cur_throw_ty) {
        checker_set_i(mut &c.nconst, n, fi)
        checker_set_i(mut &c.ncall, n, -83)
        checker_set_i(mut &c.ntype, n, user_ret)
        << user_ret
    }
    c.fail_node(p, n, "call may throw; use `or (err) { }` to handle the error")
    << 0
}

// Private to one metadata pass; Checker/MIR layouts are unchanged.
struct ThrowCallIndex {
    first StrMap
    heads StrMap
    next []int
    queries int
    ready bool
    // AST-derived, pass-local metadata avoids the old CFn.recv boot-layout
    // hazard without changing Checker or MIR layouts. -1 means unresolved.
    receiver_types []int
    fn_recv []int
    fn_ret []int
    fn_methods []int
    qualified_fns []int
}

fn new_throw_call_index() ThrowCallIndex {
    << ThrowCallIndex{first: StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0},heads: StrMap{keys: []string{}, vals: []int{}, used: []int{}, n: 0, cap: 0},next: []int{},queries: 0,ready: false,receiver_types: []int{},fn_recv: []int{},fn_ret: []int{},fn_methods: []int{},qualified_fns: []int{}}
}

fn throw_receiver_at(index &ThrowCallIndex,e int) int {
    if e >= 0 && e < index.receiver_types.len { << index.receiver_types[e] }
    << -1
}
fn (c &Checker) throw_receiver_module(recv int,fallback string) string {
    if is_struct_type(recv) {
        si := struct_index(recv)
        if si >= 0 && si < c.structs.len { << c.structs[si].mod_id + "" }
    }
    << fallback + ""
}
fn throw_method_matches(p &parser.Parser,index &ThrowCallIndex,fi int,recv int) bool {
    if fi < 0 || fi >= index.fn_methods.len || index.fn_methods[fi] == 0 { << false }
    // Primitive receivers cannot invoke a user struct method. An unresolved
    // receiver keeps the conservative union of method candidates only.
    if recv < 0 { << true }
    if fi >= index.fn_recv.len || index.fn_recv[fi] < 0 { << true }
    << index.fn_recv[fi] == recv
}
fn (c &Checker) throw_base_type(ty int) int {
    mut value := ty
    for i in 0:8 { if !is_ref_type(value) { <- }
        value = c.ref_inner_type(value) }
    if is_param_type(value) || value == TEMP_TY || value == ANY_TY { << -1 }
    << value
}
fn (c &Checker) throw_ast_type(p &parser.Parser,t int,depth int) int {
    if t < 0 || t >= p.nodes.len || depth > 64 { << -1 }
    k := p.nodes[t].kind
    if k == ast.NT_REF { << c.throw_ast_type(p,p.nodes[t].a,depth + 1) }
    if k == ast.NT_NAMED {
        // Generic template instances may not yet exist at this precheck phase.
        if p.nodes[t].a >= 0 { << -1 }
        si := c.find_struct_in_mod(c.named_local_of(p,t),c.named_mod_of(p,t))
        if si >= 0 { << struct_type(si) }
        ii := c.find_iface_global(c.named_local_of(p,t),c.named_mod_of(p,t))
        if ii >= 0 { << iface_ty(ii) }
        << -1
    }
    if k == ast.NT_INT { << 1 }
    if k == ast.NT_BOOL { << 2 }
    if k == ast.NT_STR { << 3 }
    if k == ast.NT_F64 { << 4 }
    if k == ast.NT_ARRAY {
        elem := c.throw_ast_type(p,p.nodes[t].a,depth + 1)
        for i in 0:c.arrays.len { if c.arrays[i].elem_ty == elem && c.arrays[i].fixed_len == p.nodes[t].ival { << 200 + i } }
    }
    << -1
}
struct ThrowScope { names []string
    types []int
    used int }
fn (scope &ThrowScope) lookup(name &string) int {
    mut i := scope.used
    while i > 0 { i -= 1
        if scope.names[i] == name + "" { << scope.types[i] } }
    << -1
}
fn (scope &ThrowScope) contains(name &string) bool {
    for i in 0:scope.used { if scope.names[i] == name + "" { << true } }
    << false
}
fn (scope &mut ThrowScope) push(name &string,ty int) {
    if scope.used < scope.names.len { scope.names[scope.used] = name + ""
        scope.types[scope.used] = ty }
    else { scope.names.push(name + "")
        scope.types.push(ty) }
    scope.used += 1
}
fn (scope &mut ThrowScope) restore(length int) {
    scope.used = length
}
fn (c &Checker) throw_array_of(elem int) int {
    if elem < 0 { << -1 }
    for i in 0:c.arrays.len { if c.arrays[i].elem_ty == elem && c.arrays[i].fixed_len == 0 { << 200 + i } }
    << -1
}
fn (c &Checker) throw_method_return(p &parser.Parser,index &ThrowCallIndex,name &string,recv int) int {
    if !is_struct_type(recv) { << -1 }
    for i in 0:index.fn_recv.len {
        if index.fn_methods[i] != 0 && index.fn_recv[i] == recv && i < c.fn_safe_name.len && c.fn_safe_name[i] == name + "" { << index.fn_ret[i] }
    }
    << -1
}
fn (c &Checker) throw_module_callee(p &parser.Parser,e int,scope &ThrowScope,index &mut ThrowCallIndex) int {
    if e < 0 || e >= p.nodes.len || p.nodes[e].a < 0 || p.nodes[e].a >= p.nodes.len { << -1 }
    root := c.chain_root(p,p.nodes[e].a)
    if root.len == 0 || scope.contains(&root) { << -1 }
    receiver := p.nodes[e].a
    mut mid := ""
    if receiver >= 0 && p.nodes[receiver].kind == ast.NK_IDENT {
        name := p.nodes[receiver].sval + ""
        if c.module_exists(name + "") { mid = name + "" }
        if mid.len == 0 { mid = c.alias_of(name + "") }
        if mid.len == 0 { mid = c.qual_to_mod(name + "") }
    } else if receiver >= 0 && p.nodes[receiver].kind == ast.NK_FIELD {
        path := c.chain_path(p,receiver)
        if c.module_exists(path + "") { mid = path + "" }
        if mid.len == 0 { mid = c.alias_of(path + "") }
        if mid.len == 0 { mid = c.mod_of_import_qual(path + "." + p.nodes[e].sval) }
    }
    if mid.len == 0 || !c.module_exists(mid + "") { << -1 }
    << c.find_fn_in_mod_safe(p.nodes[e].sval + "",mid + "",index)
}
// A small lexical type walk resolves receiver identity before the effect fixed
// point. It does not typecheck, instantiate generics, or modify Checker/MIR
// layout. Unknowns remain conservative; block scopes prevent shadow aliases
// from escaping into a later call on an unrelated type.
fn (c &Checker) throw_scan_expr(p &parser.Parser,e int,scope &mut ThrowScope,index &mut ThrowCallIndex,depth int) int {
    if e < 0 || e >= p.nodes.len || depth > 128 { << -1 }
    k := p.nodes[e].kind
    if k == ast.NK_IDENT { name := p.nodes[e].sval + ""
        << (&*scope).lookup(&name) }
    if k == ast.NK_INT { << 1 }
    if k == ast.NK_BOOL { << 2 }
    if k == ast.NK_STR { << 3 }
    if k == ast.NK_FLOAT { << 4 }
    if k == ast.NK_BORROW || k == ast.NK_UN_OP { << c.throw_scan_expr(p,p.nodes[e].a,scope,index,depth + 1) }
    if k == ast.NK_FIELD {
        ty := c.throw_scan_expr(p,p.nodes[e].a,scope,index,depth + 1)
        if is_struct_type(ty) { si := struct_index(ty)
            fi := c.find_field(si,p.nodes[e].sval + "")
            if fi >= 0 { << c.throw_base_type(c.structs[si].fields[fi].ty) } }
        << -1
    }
    if k == ast.NK_INDEX || k == ast.NK_SLICE {
        ty := c.throw_scan_expr(p,p.nodes[e].a,scope,index,depth + 1)
        _ := c.throw_scan_expr(p,p.nodes[e].b,scope,index,depth + 1)
        if k == ast.NK_SLICE { << ty }
        if is_array_type(ty) { ai := ty - 200
            if ai >= 0 && ai < c.arrays.len { << c.throw_base_type(c.arrays[ai].elem_ty) } }
        if ty == 3 { << 1 }
        << -1
    }
    if k == ast.NK_CALL || k == ast.NK_METHOD_CALL {
        mut receiver := -1
        if k == ast.NK_METHOD_CALL { receiver = c.throw_scan_expr(p,p.nodes[e].a,scope,index,depth + 1)
            checker_set_i(mut &index.receiver_types,e,receiver) }
        mut arg := p.nodes[e].b
        if k == ast.NK_CALL { arg = p.nodes[e].a }
        while arg >= 0 { _ := c.throw_scan_expr(p,arg,scope,index,depth + 1)
            arg = p.nodes[arg].next }
        name := p.nodes[e].sval + ""
        if k == ast.NK_METHOD_CALL {
            fi := c.throw_module_callee(p,e,&*scope,index)
            if fi >= 0 && fi < index.fn_ret.len { checker_set_i(mut &index.qualified_fns,e,fi)
                << index.fn_ret[fi] }
            << c.throw_method_return(p,&*index,&name,receiver)
        }
        fi := c.resolve_throw_callee(name + "",c.cur_mod + "",index)
        if fi >= 0 && fi < index.fn_ret.len { << index.fn_ret[fi] }
        << -1
    }
    if k == ast.NK_STRUCT_INIT {
        mut field := p.nodes[e].a
        while field >= 0 { _ := c.throw_scan_expr(p,p.nodes[field].a,scope,index,depth + 1)
            field = p.nodes[field].next }
        if p.nodes[e].b >= 0 { << -1 }
        si := c.find_struct_in_mod(c.named_local_of(p,e),c.named_mod_of(p,e))
        if si >= 0 { << struct_type(si) }
        << -1
    }
    if k == ast.NK_EMPTY_ARRAY { << c.throw_array_of(c.throw_ast_type(p,p.nodes[e].a,depth + 1)) }
    if k == ast.NK_ARRAY_LIT {
        mut elem := -1
        if p.nodes[e].b >= 0 { elem = c.throw_ast_type(p,p.nodes[e].b,depth + 1) }
        mut item := p.nodes[e].a
        while item >= 0 { value := c.throw_scan_expr(p,item,scope,index,depth + 1)
            if elem < 0 { elem = value }
            item = p.nodes[item].next }
        << c.throw_array_of(elem)
    }
    if k == ast.NK_OR_CATCH {
        ty := c.throw_scan_expr(p,p.nodes[e].a,scope,index,depth + 1)
        c.throw_scan_stmts(p,p.nodes[e].c,scope,index,depth + 1)
        << ty
    }
    if k == ast.NK_BIN_OP {
        left := c.throw_scan_expr(p,p.nodes[e].a,scope,index,depth + 1)
        _ := c.throw_scan_expr(p,p.nodes[e].b,scope,index,depth + 1)
        if p.nodes[e].ival >= 6 && p.nodes[e].ival <= 13 { << 2 }
        << left
    }
    if k == ast.NK_CAST || k == ast.NK_TYPE_AS || k == ast.NK_TYPE_IS {
        _ := c.throw_scan_expr(p,p.nodes[e].a,scope,index,depth + 1)
        if k == ast.NK_TYPE_IS { << 2 }
        << c.throw_ast_type(p,p.nodes[e].b,depth + 1)
    }
    << -1
}
fn (c &Checker) throw_scan_stmts(p &parser.Parser,head int,scope &mut ThrowScope,index &mut ThrowCallIndex,depth int) {
    if depth > 128 { << }
    length := scope.used
    mut s := head
    while s >= 0 && s < p.nodes.len {
        k := p.nodes[s].kind
        if k == ast.NK_LET {
            mut ty := c.throw_scan_expr(p,p.nodes[s].a,scope,index,depth + 1)
            if p.nodes[s].b >= 0 { ty = c.throw_ast_type(p,p.nodes[s].b,depth + 1) }
            name := p.nodes[s].sval + ""
            scope.push(&name,ty)
        } else if k == ast.NK_IF {
            mut br := p.nodes[s].a
            while br >= 0 { _ := c.throw_scan_expr(p,p.nodes[br].a,scope,index,depth + 1)
                c.throw_scan_stmts(p,p.nodes[br].b,scope,index,depth + 1)
                br = p.nodes[br].next }
            c.throw_scan_stmts(p,p.nodes[s].b,scope,index,depth + 1)
        } else if k == ast.NK_FOR_EACH {
            ty := c.throw_scan_expr(p,p.nodes[s].a,scope,index,depth + 1)
            before := scope.used
            mut elem := -1
            if is_array_type(ty) { ai := ty - 200
                if ai >= 0 && ai < c.arrays.len { elem = c.throw_base_type(c.arrays[ai].elem_ty) } }
            name := p.nodes[s].sval + ""
            scope.push(&name,elem)
            c.throw_scan_stmts(p,p.nodes[s].c,scope,index,depth + 1)
            scope.restore(before)
        } else if k == ast.NK_FOR || k == ast.NK_WHILE {
            _ := c.throw_scan_expr(p,p.nodes[s].a,scope,index,depth + 1)
            _ := c.throw_scan_expr(p,p.nodes[s].b,scope,index,depth + 1)
            before := scope.used
            if k == ast.NK_FOR { name := p.nodes[s].sval + ""
                scope.push(&name,1) }
            c.throw_scan_stmts(p,p.nodes[s].c,scope,index,depth + 1)
            scope.restore(before)
        } else if k == ast.NK_MATCH || k == ast.NK_SELECT {
            mut arm := p.nodes[s].b
            if k == ast.NK_MATCH { _ := c.throw_scan_expr(p,p.nodes[s].a,scope,index,depth + 1) }
            else { arm = p.nodes[s].a }
            while arm >= 0 { c.throw_scan_stmts(p,p.nodes[arm].c,scope,index,depth + 1)
                arm = p.nodes[arm].next }
            if k == ast.NK_SELECT { c.throw_scan_stmts(p,p.nodes[s].c,scope,index,depth + 1) }
        } else {
            _ := c.throw_scan_expr(p,p.nodes[s].a,scope,index,depth + 1)
            if k == ast.NK_ASSIGN || k == ast.NK_SEND { _ := c.throw_scan_expr(p,p.nodes[s].b,scope,index,depth + 1) }
        }
        s = p.nodes[s].next
    }
    scope.restore(length)
}
fn (c &mut Checker) build_throw_receiver_index(p &parser.Parser,index &mut ThrowCallIndex) {
    saved_mod := c.cur_mod + ""
    saved_file := c.cur_file
    for i in 0:p.nodes.len { index.receiver_types.push(-1)
        index.qualified_fns.push(-1) }
    for i in 0:c.fndecl.len {
        d := c.fndecl[i]
        mut receiver := -1
        mut result := -1
        mut method := 0
        if i < c.fn_safe_mod.len { c.cur_mod = c.fn_safe_mod[i] + "" }
        if i < c.fn_file.len { c.cur_file = c.fn_file[i] }
        if d >= 0 && d < p.nodes.len {
            if p.nodes[d].d >= 0 { method = 1
                receiver = c.throw_ast_type(p,p.nodes[p.nodes[d].d].a,0) }
            if p.nodes[d].b >= 0 { result = c.throw_ast_type(p,p.nodes[d].b,0) }
            else { result = 0 }
        }
        index.fn_methods.push(method)
        index.fn_recv.push(receiver)
        index.fn_ret.push(result)
    }
    for i in 0:c.fndecl.len {
        d := c.fndecl[i]
        if d < 0 || d >= p.nodes.len { -> }
        if i < c.fn_safe_mod.len { c.cur_mod = c.fn_safe_mod[i] + "" }
        if i < c.fn_file.len { c.cur_file = c.fn_file[i] }
        mut scope := ThrowScope{names: []string{},types: []int{},used: 0}
        receiver := p.nodes[d].d
        if receiver >= 0 { name := p.nodes[receiver].sval + ""
            scope.push(&name,index.fn_recv[i]) }
        mut param := p.nodes[d].a
        while param >= 0 { name := p.nodes[param].sval + ""
            ty := c.throw_ast_type(p,p.nodes[param].a,0)
            scope.push(&name,ty)
            param = p.nodes[param].next }
        c.throw_scan_stmts(p,p.nodes[d].c,mut &scope,index,0)
    }
    c.cur_mod = saved_mod
    c.cur_file = saved_file
}

// Length-prefix the module so the pair is unambiguous even for unusual bytes.
fn throw_call_key(name string, mod string) string {
    << str(mod.len) + ":" + mod + name
}

fn build_throw_call_index(c &Checker, index &mut ThrowCallIndex) {
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n { n = c.fn_safe_mod.len }
    for i in 0:n {
        key := throw_call_key(c.fn_safe_name[i] + "", c.fn_safe_mod[i] + "")
        head := strmap_get(&index.heads, &key)
        index.next.push(head)
        if (i >= index.fn_methods.len || index.fn_methods[i] == 0) && strmap_get(&index.first, &key) < 0 {
            strmap_put(mut &index.first, key + "", i)
        }
        strmap_put(mut &index.heads, key, i)
    }
}

// Amortize construction only after a pass has actually made many queries.
// Leaf-heavy units can make one query despite declaring thousands of fns.
fn throw_use_call_index(c &Checker, index &mut ThrowCallIndex) bool {
    if index.ready { << true }
    index.queries += 1
    if index.queries <= 64 { << false }
    build_throw_call_index(c, index)
    index.ready = true
    << true
}

fn (c &Checker) find_fn_in_mod_safe_linear(name string, mod string,index &ThrowCallIndex) int {
    nm := name + ""
    mid := mod + ""
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n {
        n = c.fn_safe_mod.len
    }
    for i in 0:n {
        if c.fn_safe_name[i] == nm && c.fn_safe_mod[i] == mid && (i >= index.fn_methods.len || index.fn_methods[i] == 0) {
            << i
        }
    }
    << -1
}

fn (c &Checker) ast_method_call_propagates_throw_linear(p &parser.Parser, e int, caller_mod string, index &ThrowCallIndex) bool {
    if e < 0 || p.nodes[e].kind != ast.NK_METHOD_CALL {
        << false
    }
    mname := p.nodes[e].sval + ""
    recv := throw_receiver_at(index,e)
    if is_interface_type(recv) { << false }
    mod := c.throw_receiver_module(recv,caller_mod)
    mut n := c.fn_safe_name.len
    if c.fn_safe_mod.len < n {
        n = c.fn_safe_mod.len
    }
    for i in 0:n {
        if c.fn_safe_mod[i] != mod {
            ->
        }
        if c.fn_safe_name[i] != mname {
            ->
        }
        if throw_method_matches(p,index,i,recv) && i < c.fn_may_throw.len && c.fn_may_throw[i] != 0 {
            << true
        }
    }
    << false
}
