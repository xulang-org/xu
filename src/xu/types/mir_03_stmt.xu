@xu/types

#xu/ast
#xu/parser

fn index_rmw_op_ok(op int) bool {
    if op == 1 || op == 2 || op == 3 {
        << true
    }
    if op == 14 || op == 15 || op == 16 {
        << true
    }
    << false
}

fn (f $&MFn) emit_index_rmw(base int, idx int, rhs int, elem_bytes int, nocheck bool, bop int) {
    $rmw := mkinstr(MI_INDEX_RMW)
    rmw.a = base
    rmw.b = idx
    rmw.c = rhs
    rmw.d = elem_d(elem_bytes, nocheck)
    rmw.col = bop
    rmw.line = 0
    f.emit(rmw)
}

fn field_rmw_ok(fty int, count int, owning bool, bop int) bool {
    if count != 1 { << false }
    if owning { << false }
    if !mir_scalar_ty(fty) { << false }
    << index_rmw_op_ok(bop)
}

fn (f $&MFn) emit_field_rmw(ptr int, buf bool, rhs int, slot int, fty int, bop int) {
    $rmw := mkinstr(MI_FIELD_RMW)
    rmw.a = ptr
    rmw.b = 0
    if buf {
        rmw.b = 1
    }
    rmw.c = rhs
    rmw.d = fty
    rmw.col = bop
    rmw.line = slot
    f.emit(rmw)
}

fn (f $&MFn) lower_stmt_assign_index(p &parser.Parser, c $&Checker, n int) {
    t := p.nodes[n].a
    if c.ncall[t] >= 0 || c.ncall[t] == -78 {
        f.lower_map_set(p, c, n)
        <<
    }
    raw_ty := c.ntype[p.nodes[t].a]
    aty := c.direct_type(raw_ty)
    if aty == 3 {
        // Store through the local descriptor. A temp copy would alias the
        // same buffer and could be dropped as a second owner.
        lid := c.nlocal[p.nodes[t].a]
        base := MIR_LOCAL_OPERAND_BASE + lid
        idx := f.lower_expr(p, c, p.nodes[t].b)
        value := f.lower_expr(p, c, p.nodes[n].b)
        f.mark_move_of(p, c, p.nodes[n].b)
        $sb := mkinstr(MI_STORE_INDEX)
        sb.a = base
        sb.b = idx
        sb.c = value
        sb.d = 1
        f.emit(sb)
        <<
    }
    fl := c.array_fixed_len_m(aty)
    $base := f.lower_index_base(p, c, p.nodes[t].a)
    idx := f.lower_expr(p, c, p.nodes[t].b)
    ety := c.elem_ty_of_array(aty, f.src_fi)
    elem_bytes := c.type_size_bytes(ety)
    nocheck := f.index_nocheck(p, c, p.nodes[t].a, p.nodes[t].b)
    owning := c.type_owning(ety)
    if p.nodes[n].ival != 1 {
        bop := compound_binop(p.nodes[n].ival)
        // IndexRMW.col is the binop; it cannot also carry [N]T length.
        if elem_bytes == 8 && !owning && index_rmw_op_ok(bop) && fl <= 0 {
            rhs := f.lower_expr(p, c, p.nodes[n].b)
            f.emit_index_rmw(base, idx, rhs, elem_bytes, nocheck, bop)
            <<
        }
        cur := f.new_temp(ety, c.type_slots(ety))
        $li := mkinstr(MI_LOAD_INDEX)
        li.a = cur
        li.b = base
        li.c = idx
        li.d = elem_d(elem_bytes, nocheck)
        if fl > 0 {
            li.col = fl
        }
        f.emit(li)
        rhs := f.lower_expr(p, c, p.nodes[n].b)
        if bop == 4 || bop == 5 { f.div_int_guard(cur, rhs, ety) }
        value := f.new_temp(ety, c.type_slots(ety))
        $bi := mkinstr(MI_BIN)
        bi.a = value
        bi.b = bop
        bi.c = cur
        bi.d = rhs
        f.emit(bi)
        $si := mkinstr(MI_STORE_INDEX)
        si.a = base
        si.b = idx
        si.c = value
        si.d = elem_d(elem_bytes, nocheck)
        if fl > 0 {
            si.col = fl
        }
        f.emit(si)
        <<
    }
    value := f.lower_expr(p, c, p.nodes[n].b)
    f.mark_move_of(p, c, p.nodes[n].b)
    $si2 := mkinstr(MI_STORE_INDEX)
    si2.a = base
    si2.b = idx
    si2.c = value
    si2.d = elem_d(elem_bytes, nocheck)
    if fl > 0 {
        si2.col = fl
    }
    f.emit(si2)
}

fn (f $&MFn) lower_stmt_assign(p &parser.Parser, c $&Checker, n int) {
    t := p.nodes[n].a
        if p.nodes[t].kind == ast.NK_IDENT { // local = value
            id := c.nlocal[t]
            if p.nodes[n].ival == 1 {
                v := f.lower_expr(p, c, p.nodes[n].b)
                f.mark_move_of(p, c, p.nodes[n].b)
                if id >= 0 && id < f.locals_owning.len && f.locals_owning[id] && !f.moved[id] {
                    ty := f.locals[id]
                    if ty == 3 || is_array_type(ty) || is_struct_type(ty) || is_throw_type(ty) || is_enum_type(ty) || is_map_type(ty) || is_any_type(ty) || is_interface_type(ty) {
                        $di := mkinstr(MI_DROP)
                        di.a = id
                        f.emit(di)
                    }
                }
                if id >= 0 && id < f.moved.len {
                    f.moved[id] = false
                }
                $ins := mkinstr(MI_STORE_LOCAL)
                ins.a = id
                ins.b = v
                f.emit(ins)
                // Re-assign fixed ArrayLit: hold owns the heap buffer.
                if f.lit_hold >= 0 && p.nodes[p.nodes[n].b].kind == ast.NK_ARRAY_LIT {
                    sty := c.ntype[p.nodes[n].b]
                    if is_array_type(sty) && c.array_fixed_len(sty) > 0 {
                        if id >= 0 && id < f.locals_owning.len {
                            f.locals_owning[id] = false
                        }
                    }
                }
                f.lit_hold = -1
                <<
            }
            // compound / other: fall through existing paths below
        }
        if p.nodes[t].kind == ast.NK_INDEX { // array[index] = / += value
            f.lower_stmt_assign_index(p, c, n)
            <<
        }
        if p.nodes[t].kind == ast.NK_FIELD { // obj.field = value
            obj := p.nodes[t].a
            fi := c.nlocal[n] // field index (target)
            if p.nodes[obj].kind != ast.NK_IDENT {
                // Nested lvalue (Field/Index chain base): compute the object
                // address — Index steps bounds-checked via ElemAddr (23) —
                // then field ops through the pointer (mirror bootstrap).
                // Buffer layout above an Index step ascends (+8k); frame
                // layout descends (-8k): kinds 24/25/26 vs 22/18/17.
                buf := chain_has_index(p, obj) && f.chain_index_is_buf(p, &*c, obj)
                base := f.lower_chain_addr(p, c, obj, buf)
                oty := c.direct_type(c.ntype[obj])
                si2 := struct_index(oty)
                slot2 := c.structs[si2].fields[fi].slot
                fty2 := c.structs[si2].fields[fi].ty
                count2 := c.type_slots(fty2)
                if p.nodes[n].ival == 1 { // =
                    $value := f.lower_expr(p, c, p.nodes[n].b)
                    f.mark_move_of(p, c, p.nodes[n].b)
                    value = f.typed_value(value, fty2)
                    // Overwriting an owning field drops its old value first.
                    if c.type_owning(fty2) {
                        $df := mkinstr(MI_DROP_PTR_FIELD)
                        if buf { df.kind = 24 } // DropBufField
                        df.a = base
                        df.b = slot2
                        df.c = fty2
                        f.emit(df)
                    }
                    $sp := mkinstr(MI_STORE_PTR)
                    if buf { sp.kind = 25 } // StoreBufPtr
                    sp.a = value
                    sp.b = base
                    sp.c = slot2
                    sp.d = count2
                    f.emit(sp)
                } else { // compound: load field, binop, store back.
                    bop := compound_binop(p.nodes[n].ival)
                    if field_rmw_ok(fty2, count2, c.type_owning(fty2), bop) {
                        rhs := f.lower_expr(p, c, p.nodes[n].b)
                        f.emit_field_rmw(base, buf, rhs, slot2, fty2, bop)
                        <<
                    }
                    cur := f.new_temp(fty2, count2)
                    $lp := mkinstr(MI_LOAD_PTR)
                    if buf { lp.kind = 26 } // LoadBufPtr
                    lp.a = cur
                    lp.b = base
                    lp.c = slot2
                    lp.d = count2
                    f.emit(lp)
                    rhs := f.lower_expr(p, c, p.nodes[n].b)
                    if bop == 4 || bop == 5 { f.div_int_guard(cur, rhs, fty2) }
                    t2 := f.new_temp(fty2, count2)
                    $bi := mkinstr(MI_BIN)
                    bi.a = t2
                    bi.b = bop
                    bi.c = cur
                    bi.d = rhs
                    f.emit(bi)
                    $sp2 := mkinstr(MI_STORE_PTR)
                    if buf { sp2.kind = 25 } // StoreBufPtr
                    sp2.a = t2
                    sp2.b = base
                    sp2.c = slot2
                    sp2.d = count2
                    f.emit(sp2)
                }
                <<
            }
            base_local := c.nlocal[t] // base local id
            si := struct_index(c.direct_type(f.locals[base_local]))
            slot := c.structs[si].fields[fi].slot
            count := c.type_slots(c.structs[si].fields[fi].ty)
            // Address the field directly through a pointer (receiver/ref
            // locals already hold the pointer; plain locals get AddrOf).
            // Never read-modify-write-back through a scratch copy: the RHS
            // may mutate the same struct (`d.x = d.mk()`), and the stale
            // scratch would clobber those writes.
            ptr := f.lower_addr(p, c, obj)
            buf := f.ref_expr_is_buf(p, &*c, obj, 0)
            fty := c.structs[si].fields[fi].ty
            $value := -1
            if p.nodes[n].ival == 1 { // =
                value = f.lower_expr(p, c, p.nodes[n].b)
                f.mark_move_of(p, c, p.nodes[n].b)
                value = f.typed_value(value, fty)
                // Overwriting an owning field drops its old value first.
                if c.type_owning(fty) {
                    $df := mkinstr(MI_DROP_PTR_FIELD)
                    if buf { df.kind = 24 }
                    df.a = ptr
                    df.b = slot
                    df.c = fty
                    f.emit(df)
                }
            } else { // compound: load field, binop, store back.
                bop := compound_binop(p.nodes[n].ival)
                if field_rmw_ok(fty, count, c.type_owning(fty), bop) {
                    rhs := f.lower_expr(p, c, p.nodes[n].b)
                    f.emit_field_rmw(ptr, buf, rhs, slot, fty, bop)
                    <<
                }
                cur := f.new_temp(fty, count)
                $lp := mkinstr(MI_LOAD_PTR)
                if buf { lp.kind = 26 }
                lp.a = cur
                lp.b = ptr
                lp.c = slot
                lp.d = count
                f.emit(lp)
                rhs := f.lower_expr(p, c, p.nodes[n].b)
                if bop == 4 || bop == 5 { f.div_int_guard(cur, rhs, fty) }
                value = f.new_temp(fty, count)
                $bi := mkinstr(MI_BIN)
                bi.a = value
                bi.b = bop
                bi.c = cur
                bi.d = rhs
                f.emit(bi)
            }
            $sp := mkinstr(MI_STORE_PTR)
            if buf { sp.kind = 25 }
            sp.a = value
            sp.b = ptr
            sp.c = slot
            sp.d = count
            f.emit(sp)
            <<
        }
        if p.nodes[t].kind == ast.NK_UN_OP { // *ptr = / op= (MS3)
            inner := p.nodes[t].a
            buf := f.ref_expr_is_buf(p, &*c, inner, 0)
            ptr := f.lower_expr(p, c, inner)
            pty := c.ntype[t]
            ns := c.type_slots(pty)
            if p.nodes[n].ival == 1 {
                $value := f.lower_expr(p, c, p.nodes[n].b)
                f.mark_move_of(p, c, p.nodes[n].b)
                value = f.typed_value(value, pty)
                if c.type_owning(pty) {
                    $df := mkinstr(MI_DROP_PTR_FIELD)
                    if buf {
                        df.kind = MI_DROP_BUF_FIELD
                    }
                    df.a = ptr
                    df.b = 0
                    df.c = pty
                    f.emit(df)
                }
                $sp := mkinstr(MI_STORE_PTR)
                if buf {
                    sp.kind = MI_STORE_BUF_PTR
                }
                sp.a = value
                sp.b = ptr
                sp.c = 0
                sp.d = ns
                f.emit(sp)
            } else {
                cur := f.new_temp(pty, ns)
                $lp := mkinstr(MI_LOAD_PTR)
                if buf {
                    lp.kind = MI_LOAD_BUF_PTR
                }
                lp.a = cur
                lp.b = ptr
                lp.c = 0
                lp.d = ns
                f.emit(lp)
                rhs := f.lower_expr(p, c, p.nodes[n].b)
                bop := compound_binop(p.nodes[n].ival)
                if bop == 4 || bop == 5 { f.div_int_guard(cur, rhs, pty) }
                t2 := f.new_temp(pty, ns)
                $bi := mkinstr(MI_BIN)
                bi.a = t2
                bi.b = bop
                bi.c = cur
                bi.d = rhs
                f.emit(bi)
                $sp2 := mkinstr(MI_STORE_PTR)
                if buf {
                    sp2.kind = MI_STORE_BUF_PTR
                }
                sp2.a = t2
                sp2.b = ptr
                sp2.c = 0
                sp2.d = ns
                f.emit(sp2)
            }
            <<
        }
        local := c.nlocal[t]
        if local >= 0 && local < c.lconst_ok.len {
            checker_set_i($&c.lconst_ok, local, 0)
        }
        if p.nodes[n].ival == 1 { // =
            v := f.lower_expr(p, c, p.nodes[n].b)
            f.mark_move_of(p, c, p.nodes[n].b)
            // Rebinding drops the old value (RHS already evaluated).
            if f.locals_owning[local] && !f.moved[local] {
                $di := mkinstr(MI_DROP)
                di.a = local
                f.emit(di)
            }
            f.moved[local] = false
            if local >= 0 && local < f.fcons.len {
                f.fcons[local] = 0
            }
            $ins := mkinstr(MI_STORE_LOCAL)
            ins.a = local
            ins.b = v
            f.emit(ins)
        } else { // compound: load, binop, store
            lty := f.locals[local]
            cur := f.new_temp(lty, 1)
            $li := mkinstr(MI_LOAD_LOCAL)
            li.a = cur
            li.b = local
            f.emit(li)
            v := f.lower_expr(p, c, p.nodes[n].b)
            bop := compound_binop(p.nodes[n].ival)
            if bop == 4 || bop == 5 { f.div_int_guard(cur, v, lty) }
            t2 := f.new_temp(lty, 1)
            $bi := mkinstr(MI_BIN)
            bi.a = t2
            bi.b = bop
            bi.c = cur
            bi.d = v
            f.emit(bi)
            $si := mkinstr(MI_STORE_LOCAL)
            si.a = local
            si.b = t2
            f.emit(si)
        }
        <<
}

// §5.7: wrap a plain value as throw Ok (tag=0, payload=v).
fn (f $&MFn) wrap_throw_ok(c $&Checker, throw_ty int, ok_ty int, v int) int {
    dest := f.new_temp(throw_ty, c.type_slots(throw_ty))
    tagt := f.new_temp(1, 1)
    $cp := mkinstr(MI_COPY)
    cp.a = tagt
    cp.b = f.vconst(0)
    f.emit(cp)
    $tag := mkinstr(MI_STORE_FIELD)
    tag.a = tagt
    tag.b = dest
    tag.c = 0
    tag.d = 1
    f.emit(tag)
    $stf := mkinstr(MI_STORE_FIELD)
    stf.a = v
    stf.b = dest
    stf.c = 8
    stf.d = c.type_slots(ok_ty)
    f.emit(stf)
    << dest
}

fn (f $&MFn) lower_stmt_throw_return(p &parser.Parser, c $&Checker, n int) {
    k := p.nodes[n].kind
    if k == ast.NK_THROW { // Throw → << throw Err (§5.7)
        ri := throw_index(c.ntype[n])
        throw_ty := c.ntype[n]
        dest := f.new_temp(throw_ty, c.type_slots(throw_ty))
        expr := p.nodes[n].a
        $ev := f.lower_expr(p, c, expr)
        want := c.throws[ri].err_ty
        if is_struct_type(c.ntype[expr]) {
            ev = f.wrap_box_interface(p, c, expr, ev, want)
        } else {
            f.mark_move_of(p, c, expr)
        }
        tagt := f.new_temp(1, 1)
        $cp := mkinstr(MI_COPY)
        cp.a = tagt
        cp.b = f.vconst(1)
        f.emit(cp)
        $tag := mkinstr(MI_STORE_FIELD)
        tag.a = tagt
        tag.b = dest
        tag.c = 0
        tag.d = 1
        f.emit(tag)
        $stf := mkinstr(MI_STORE_FIELD)
        stf.a = ev
        stf.b = dest
        stf.c = 8
        stf.d = c.type_slots(want)
        f.emit(stf)
        f.emit_drops_all()
        f.terminate(3, dest, -1, -1)
        dead := f.new_block()
        f.switch_to(dead)
        f.dead = true
        <<
    }
    if k == ast.NK_RETURN { // Return
        $v := -1
        $tr := 0
        if f.src_fi >= 0 && f.src_fi < c.fn_throw_ty.len {
            tr = c.fn_throw_ty[f.src_fi]
        }
        if p.nodes[n].a >= 0 {
            ec := p.nodes[n].a
            v = f.lower_expr(p, c, ec)
            // Returning a fixed ArrayLit moves the synthetic []T hold into
            // the caller; do not drop it on the callee return path.
            if f.lit_hold >= 0 && p.nodes[ec].kind == ast.NK_ARRAY_LIT {
                f.moved[f.lit_hold] = true
            }
            f.lit_hold = -1
            // A returned local moves out — mark it before computing drops.
            f.mark_move_of(p, c, ec)
            // §5.7: plain returns in may-throw fns become throw Ok.
            if is_throw_type(tr) && !is_throw_type(c.ntype[ec]) {
                ri := throw_index(tr)
                ok_ty := c.throws[ri].ok_ty
                v = f.wrap_throw_ok(c, tr, ok_ty, v)
            }
        }
        f.emit_drops_all()
        f.terminate(3, v, -1, -1)
        // Statements after a << land in a fresh unreachable block.
        dead := f.new_block()
        f.switch_to(dead)
        f.dead = true
        <<
    }
}

fn (f $&MFn) lower_stmt_if(p &parser.Parser, c $&Checker, n int) {
    join := f.new_block()
    // MS6: outer locals (already in a scope) may be consumed via `as` on
    // some fall-through arm. Unconsumed live arms drop them before join.
    $outer := []int{}
    for i in 0:f.scope_ids.len {
        outer.push(f.scope_ids[i])
    }
    $pre := []bool{}
    for i in 0:f.moved.len {
        pre.push(f.moved[i])
    }
    $pre_fc := []int{}
    for i in 0:f.fcons.len {
        pre_fc.push(f.fcons[i])
    }
    $pads := []int{}
    $cons_off := []int{}
    $cons_ids := []int{}
    $cons_fc := []int{}
    $br := p.nodes[n].a
    while br >= 0 {
        if p.nodes[br].a >= 0 {
            cond := f.lower_expr(p, c, p.nodes[br].a)
            // The condition can consume an outer owner (e.g. join(parts)).
            // Both successors inherit that state. Keep the original `pre`
            // for join reconciliation, and restore the post-condition state
            // when continuing into the next else-if/else arm.
            // Only save changed owners; ordinary scalar conditions need no
            // extra allocation or full local-table copy.
            $cond_state := []int{}
            for i in 0:outer.len {
                id := outer[i]
                if f.moved[id] != pre[id] || f.fcons[id] != pre_fc[id] {
                    cond_state.push(id)
                    $moved := 0
                    if f.moved[id] { moved = 1 }
                    cond_state.push(moved)
                    cond_state.push(f.fcons[id])
                }
            }
            then_bb := f.new_block()
            cont_bb := f.new_block()
            f.terminate(2, cond, then_bb, cont_bb)
            f.switch_to(then_bb)
            // Each conditional arm is a lexical scope.  Without a branch
            // scope, owning locals declared in the arm are recorded in the
            // surrounding scope and their drops run even when that arm was
            // never entered.  Besides leaking on the taken path, this makes
            // the untaken path free uninitialised string descriptors (the
            // hosted Gen2 parser used to crash in `_rt_free` here).
            f.push_scope()
            $s := p.nodes[br].b
            while s >= 0 {
                f.lower_stmt(p, c, s)
                s = p.nodes[s].next
            }
            f.pop_scope_with_drops()
            if f.live_and_open() {
                f.as_push_pad(&outer, &pre, &pre_fc, $&pads, $&cons_off, $&cons_ids, $&cons_fc)
            }
            f.switch_to(cont_bb)
            f.as_restore_outer(&outer, &pre, &pre_fc)
            $ci := 0
            while ci < cond_state.len {
                id := cond_state[ci]
                f.moved[id] = cond_state[ci + 1] != 0
                f.fcons[id] = cond_state[ci + 2]
                ci += 3
            }
        } else {
            f.push_scope()
            $s := p.nodes[br].b
            while s >= 0 {
                f.lower_stmt(p, c, s)
                s = p.nodes[s].next
            }
            f.pop_scope_with_drops()
        }
        br = p.nodes[br].next
    }
    if f.live_and_open() {
        f.as_push_pad(&outer, &pre, &pre_fc, $&pads, $&cons_off, $&cons_ids, $&cons_fc)
    }
    f.as_finish_pads(join, &outer, &pre, &pre_fc, pads, cons_off, cons_ids, cons_fc, c)
    <<
}

fn (f $&MFn) as_restore_outer(outer &[]int, pre &[]bool, pre_fc &[]int) {
    for i in 0:outer.len {
        id := outer[i]
        if id >= 0 && id < f.moved.len && id < pre.len {
            f.moved[id] = pre[id]
        }
        if id >= 0 && id < f.fcons.len && id < pre_fc.len {
            f.fcons[id] = pre_fc[id]
        }
    }
}

fn (f $&MFn) as_push_pad(outer &[]int, pre &[]bool, pre_fc &[]int, pads $&[]int, cons_off $&[]int, cons_ids $&[]int, cons_fc $&[]int) {
    pad := f.new_block()
    f.terminate(1, pad, -1, -1)
    pads.push(pad)
    cons_off.push(cons_ids.len)
    for i in 0:outer.len {
        id := outer[i]
        if id >= 0 && id < f.moved.len && id < pre.len && f.moved[id] && !pre[id] && (is_linear_dynamic(f.locals[id]) || is_struct_type(f.locals[id]) || is_array_type(f.locals[id])) {
            cons_ids.push(id)
            cons_fc.push(0 - 1)
        } else {
            $preb := 0
            if id >= 0 && id < pre_fc.len {
                preb = pre_fc[id]
            }
            $cur := 0
            if id >= 0 && id < f.fcons.len {
                cur = f.fcons[id]
            }
            delta := cur - (cur & preb)
            if delta != 0 {
                cons_ids.push(id)
                cons_fc.push(delta)
            }
        }
    }
}

fn (f $&MFn) as_finish_pads(join int, outer &[]int, pre &[]bool, pre_fc &[]int, pads []int, cons_off []int, cons_ids []int, cons_fc []int, c $&Checker) {
    $union := []int{}
    $union_whole := []bool{}
    $union_fc := []int{}
    for i in 0:cons_ids.len {
        id := cons_ids[i]
        mask := cons_fc[i]
        $u := -1
        for j in 0:union.len {
            if union[j] == id {
                u = j
            }
        }
        if u < 0 {
            union.push(id)
            union_whole.push(false)
            union_fc.push(0)
            u = union.len - 1
        }
        if mask == 0 - 1 {
            union_whole[u] = true
        } else {
            union_fc[u] = union_fc[u] | mask
        }
    }
    $ai := 0
    while ai < pads.len {
        f.switch_to(pads[ai])
        start := cons_off[ai]
        $end := cons_ids.len
        if ai + 1 < cons_off.len {
            end = cons_off[ai + 1]
        }
        for u in 0:union.len {
            id := union[u]
            $arm_whole := false
            $arm_fc := 0
            for k in start:end {
                if cons_ids[k] == id {
                    if cons_fc[k] == 0 - 1 {
                        arm_whole = true
                    } else {
                        arm_fc = arm_fc | cons_fc[k]
                    }
                }
            }
            if union_whole[u] {
                if !arm_whole && f.locals_owning[id] {
                    $di := mkinstr(MI_DROP)
                    di.a = id
                    f.emit(di)
                }
            } else {
                bits := union_fc[u] - (union_fc[u] & arm_fc)
                f.emit_drop_field_bits(c, id, bits)
                f.emit_drop_elem_bits(c, id, bits)
            }
        }
        f.terminate(1, join, -1, -1)
        ai += 1
    }
    f.as_restore_outer(outer, pre, pre_fc)
    for u in 0:union.len {
        id := union[u]
        if union_whole[u] {
            f.moved[id] = true
        } else if id >= 0 && id < f.fcons.len {
            v := f.fcons[id] | union_fc[u]
            f.fcons[id] = v
        }
    }
    f.switch_to(join)
}

fn ast_add1_of_lid(p &parser.Parser, c &Checker, n int, lid int) bool {
    if n < 0 || p.nodes[n].kind != ast.NK_BIN_OP || p.nodes[n].ival != 1 {
        << false
    }
    la := p.nodes[n].a
    lb := p.nodes[n].b
    if la >= 0 && p.nodes[la].kind == ast.NK_IDENT && c.nlocal[la] == lid {
        if lb >= 0 && p.nodes[lb].kind == ast.NK_INT && p.nodes[lb].ival == 1 {
            << true
        }
    }
    if lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT && c.nlocal[lb] == lid {
        if la >= 0 && p.nodes[la].kind == ast.NK_INT && p.nodes[la].ival == 1 {
            << true
        }
    }
    << false
}

fn ast_lt_lid_const(p &parser.Parser, c &Checker, n int, lid int, k int) bool {
    if n < 0 || p.nodes[n].kind != ast.NK_BIN_OP || p.nodes[n].ival != 8 {
        << false
    }
    la := p.nodes[n].a
    lb := p.nodes[n].b
    if la < 0 || lb < 0 { << false }
    if p.nodes[la].kind != ast.NK_IDENT || c.nlocal[la] != lid { << false }
    if p.nodes[lb].kind != ast.NK_INT || p.nodes[lb].ival != k { << false }
    << true
}

fn const_zero_excl_for_k(p &parser.Parser, n int) int {
    if n < 0 || p.nodes[n].kind != ast.NK_FOR { << 0 }
    if range_start_excl(p.nodes[n].ival) { << 0 }
    if !range_end_excl(p.nodes[n].ival) { << 0 }
    a := p.nodes[n].a
    b := p.nodes[n].b
    if a < 0 || b < 0 { << 0 }
    if p.nodes[a].kind != ast.NK_INT || p.nodes[a].ival != 0 { << 0 }
    if p.nodes[b].kind != ast.NK_INT { << 0 }
    k := p.nodes[b].ival
    if k < 2 || k > 8 { << 0 }
    << k
}

fn triangle_j_let(p &parser.Parser, c &Checker, head int, i_lid int) int {
    $s := head
    while s >= 0 {
        if p.nodes[s].kind == ast.NK_LET {
            if ast_add1_of_lid(p, c, p.nodes[s].a, i_lid) {
                << s
            }
        }
        s = p.nodes[s].next
    }
    << -1
}

fn (f $&MFn) emit_store_local_const(lid int, v int) {
    $st := mkinstr(MI_STORE_LOCAL)
    st.a = lid
    st.b = f.vconst(v)
    f.emit(st)
}

fn (c $&Checker) set_local_const(lid int, v int) {
    if lid < 0 || lid >= c.lconst_ok.len { << }
    checker_set_i($&c.lconst, lid, v)
    checker_set_i($&c.lconst_ok, lid, 1)
}

fn (c $&Checker) clear_local_const(lid int, had int, prev int) {
    if lid < 0 || lid >= c.lconst_ok.len { << }
    checker_set_i($&c.lconst, lid, prev)
    checker_set_i($&c.lconst_ok, lid, had)
}

fn ast_stmt_list_len(p &parser.Parser, head int) int {
    $n := 0
    $s := head
    while s >= 0 {
        n += 1
        s = p.nodes[s].next
    }
    << n
}

fn ast_stmt_list_len_until(p &parser.Parser, head int, stop int) int {
    $n := 0
    $s := head
    while s >= 0 && s != stop {
        n += 1
        s = p.nodes[s].next
    }
    << n
}

// AST-lower unroll copies each body statement into new temps. A 10-pair
// nbody nest blew past the FP-home budget and slowed N=5e5 from ~110ms
// to ~200ms (p46 256-copy retry: 3.4x -> 5.1x Clang, gold still held).
// Current RA (sticky x24 / inv_t last-dest) gold-fails that shape
// (`-730/-1155`). Keep the leaf budget; do not raise until unroll+emit
// is diagnosed gold-correct.
const MIR_UNROLL_STMT_BUDGET = 32

// Fully unroll `for i in 0 -< K { prefix; j  -< = i+1; while j < K { body } suffix }`
// when K is a small literal. Not a function-name special case: nbody's 10
// pairs and any other fixed triangular nest share this shape.
fn (f $&MFn) try_lower_const_triangle(p &parser.Parser, c $&Checker, n int) bool {
    k := const_zero_excl_for_k(p, n)
    if k < 2 { << false }
    i_lid := c.nlocal[n]
    if i_lid < 0 { << false }
    body := p.nodes[n].c
    if stmts_have_own_continue(p, body) || stmts_have_own_break(p, body) {
        << false
    }
    let_n := triangle_j_let(p, &*c, body, i_lid)
    if let_n < 0 { << false }
    j_lid := c.nlocal[let_n]
    if j_lid < 0 { << false }
    wn := p.nodes[let_n].next
    if wn < 0 || p.nodes[wn].kind != ast.NK_WHILE { << false }
    if !ast_lt_lid_const(p, &*c, p.nodes[wn].a, j_lid, k) { << false }
    inner := p.nodes[wn].c
    if stmts_have_own_continue(p, inner) || stmts_have_own_break(p, inner) {
        << false
    }
    if c.stmts_write_local(p, inner, i_lid) { << false }
    pairs := k * (k - 1) / 2
    $copies := ast_stmt_list_len(p, inner) * pairs
    copies = copies + ast_stmt_list_len_until(p, body, let_n) * k
    copies = copies + ast_stmt_list_len(p, p.nodes[wn].next) * k
    if copies > MIR_UNROLL_STMT_BUDGET { << false }
    f.push_scope()
    f.scope_add(i_lid)
    f.push_scope()
    f.scope_add(j_lid)
    lub_i := c.lower_for_range_lub_enter(p, n, i_lid)
    c.note_lub(j_lid, k - 1)
    $had_i := 0
    $prev_i := 0
    if i_lid < c.lconst_ok.len {
        had_i = c.lconst_ok[i_lid]
        prev_i = c.lconst[i_lid]
    }
    $had_j := 0
    $prev_j := 0
    if j_lid < c.lconst_ok.len {
        had_j = c.lconst_ok[j_lid]
        prev_j = c.lconst[j_lid]
    }
    $ii := 0
    while ii < k {
        c.set_local_const(i_lid, ii)
        f.emit_store_local_const(i_lid, ii)
        f.push_scope()
        $pre := body
        while pre >= 0 && pre != let_n {
            f.lower_stmt(p, c, pre)
            pre = p.nodes[pre].next
        }
        $jj := ii + 1
        while jj < k {
            c.set_local_const(j_lid, jj)
            f.emit_store_local_const(j_lid, jj)
            f.push_scope()
            $s := inner
            while s >= 0 {
                f.lower_stmt(p, c, s)
                s = p.nodes[s].next
            }
            f.pop_scope_with_drops()
            jj += 1
        }
        $suf := p.nodes[wn].next
        while suf >= 0 {
            f.lower_stmt(p, c, suf)
            suf = p.nodes[suf].next
        }
        f.pop_scope_with_drops()
        ii += 1
    }
    c.clear_local_const(i_lid, had_i, prev_i)
    c.clear_local_const(j_lid, had_j, prev_j)
    c.lower_lub_leave(lub_i)
    f.pop_scope_with_drops()
    f.pop_scope_with_drops()
    << true
}

fn (f $&MFn) try_lower_const_for(p &parser.Parser, c $&Checker, n int) bool {
    k := const_zero_excl_for_k(p, n)
    if k < 2 { << false }
    i_lid := c.nlocal[n]
    if i_lid < 0 { << false }
    body := p.nodes[n].c
    if stmts_have_own_continue(p, body) || stmts_have_own_break(p, body) {
        << false
    }
    $s0 := body
    while s0 >= 0 {
        sk := p.nodes[s0].kind
        if sk == ast.NK_FOR || sk == ast.NK_FOR_EACH || sk == ast.NK_WHILE { << false }
        s0 = p.nodes[s0].next
    }
    if ast_stmt_list_len(p, body) * k > MIR_UNROLL_STMT_BUDGET { << false }
    f.push_scope()
    f.scope_add(i_lid)
    lub_i := c.lower_for_range_lub_enter(p, n, i_lid)
    $had_i := 0
    $prev_i := 0
    if i_lid < c.lconst_ok.len {
        had_i = c.lconst_ok[i_lid]
        prev_i = c.lconst[i_lid]
    }
    $ii := 0
    while ii < k {
        c.set_local_const(i_lid, ii)
        f.emit_store_local_const(i_lid, ii)
        f.push_scope()
        $s := body
        while s >= 0 {
            f.lower_stmt(p, c, s)
            s = p.nodes[s].next
        }
        f.pop_scope_with_drops()
        ii += 1
    }
    c.clear_local_const(i_lid, had_i, prev_i)
    c.lower_lub_leave(lub_i)
    f.pop_scope_with_drops()
    << true
}

fn (f $&MFn) lower_stmt_loops(p &parser.Parser, c $&Checker, n int) {
    k := p.nodes[n].kind
    if k == ast.NK_FOR { // For
        if f.try_lower_const_triangle(p, c, n) {
            <<
        }
        if f.try_lower_const_for(p, c, n) {
            <<
        }
        varid := c.nlocal[n]
        rk := p.nodes[n].ival
        $start_v := f.lower_expr(p, c, p.nodes[n].a)
        if range_start_excl(rk) {
            start_v = f.emit_int_add_imm(start_v, 1)
        }
        $si := mkinstr(MI_STORE_LOCAL)
        si.a = varid
        si.b = start_v
        f.emit(si)
        // The loop variable lives in its own scope spanning the loop.
        body_scope_depth := f.scopes.len
        f.push_scope()
        f.scope_add(varid)
        // Half-open limit: `-<`/`>-<` use hi; `--`/`>-` use hi+1. Test is `i < limit`.
        limit := f.new_temp(1, 1)
        $end_v := f.lower_expr(p, c, p.nodes[n].b)
        if !range_end_excl(rk) {
            end_v = f.emit_int_add_imm(end_v, 1)
        }
        $cp := mkinstr(MI_COPY)
        cp.a = limit
        cp.b = end_v
        f.emit(cp)

        // OPT P1: invert so the back-edge is the latch test. Fuse increment
        // + re-test into the body block when there is no continue.
        body_bb := f.new_block()
        end_bb := f.new_block()
        has_cont := stmts_have_own_continue(p, p.nodes[n].c)
        $latch := body_bb
        if has_cont {
            latch = f.new_block()
        }
        cond0 := f.emit_int_lt_local(varid, limit)
        f.terminate(2, cond0, body_bb, end_bb)

        f.switch_to(body_bb)
        // Keep locals declared in the loop body in a per-iteration scope.
        // Gen1 historically tracked only the loop variable, which made an
        // owned value declared in the body survive until function exit.
        f.push_scope()
        // M176: induction active while lowering body indices.
        $pushed := 0
        if c.literal_int_zero_val(p, p.nodes[n].a) {
            $alid := c.len_field_local(p, p.nodes[n].b)
            if alid < 0 {
                nlid := c.ident_local(p, p.nodes[n].b)
                if nlid >= 0 && nlid < c.int_len_of.len {
                    alid = c.int_len_of[nlid]
                }
            }
            if alid >= 0 {
                if !c.stmts_write_local(p, p.nodes[n].c, alid) {
                    f.induct_push(varid, alid)
                    pushed = 1
                }
            }
        }
        // `for i in 0 -< K` is not `i < a.len` induction; re-apply lub so
        // `a[i]` against a known-length `[K]T` / `&[K]T` can skip rt_oob.
        c.lower_kill_assigns(p, p.nodes[n].c)
        lub := c.lower_for_range_lub_enter(p, n, varid)
        f.push_loop(end_bb, latch, body_scope_depth)
        $s := p.nodes[n].c
        while s >= 0 {
            f.lower_stmt(p, c, s)
            s = p.nodes[s].next
        }
        f.pop_scope_with_drops()
        if f.live_and_open() {
            if has_cont {
                f.terminate(1, latch, -1, -1)
            } else {
                f.emit_int_inc_local(varid)
                cond1 := f.emit_int_lt_local(varid, limit)
                f.terminate(2, cond1, body_bb, end_bb)
            }
        }
        f.pop_loop()
        if pushed == 1 { f.induct_pop() }
        c.lower_lub_leave(lub)

        if has_cont {
            f.switch_to(latch)
            f.emit_int_inc_local(varid)
            cond1 := f.emit_int_lt_local(varid, limit)
            f.terminate(2, cond1, body_bb, end_bb)
        }

        f.switch_to(end_bb)
        f.pop_scope_with_drops() // the loop variable's own scope
        <<
    }
    if k == ast.NK_FOR_EACH { // ForEach: map (MS8c), chan (MS9e), or array
        if c.ncall[n] == -91 {
            f.lower_map_foreach(p, c, n)
            <<
        }
        varid := c.nlocal[n]
        raw_ty := c.ntype[p.nodes[n].a]
        aty := c.direct_type(raw_ty)
        if is_chan_type(aty) {
            ci := chan_index(aty)
            ch := f.lower_expr(p, c, p.nodes[n].a)
            elem := c.chans[ci].elem_ty
            slots := c.chans[ci].elem_slots
            dest := f.new_temp(elem, slots)
            status := f.new_temp(1, 1)
            loop_bb := f.new_block()
            body_bb := f.new_block()
            end_bb := f.new_block()
            f.terminate(1, loop_bb, -1, -1)
            f.switch_to(loop_bb)
            $recv := mkinstr(MI_CHAN_RECV)
            recv.a = dest
            recv.b = ch
            recv.c = slots
            recv.d = status
            f.emit(recv)
            closed := f.new_temp(2, 1)
            $eq := mkinstr(MI_BIN)
            eq.a = closed
            eq.b = 6 // Eq
            eq.c = status
            eq.d = f.vconst(2)
            f.emit(eq)
            f.terminate(2, closed, end_bb, body_bb)
            f.switch_to(body_bb)
            body_scope_depth := f.scopes.len
            f.push_scope()
            f.push_loop(end_bb, loop_bb, body_scope_depth)
            f.scope_add(varid)
            $sv := mkinstr(MI_STORE_LOCAL)
            sv.a = varid
            sv.b = dest
            f.emit(sv)
            $s := p.nodes[n].c
            while s >= 0 {
                f.lower_stmt(p, c, s)
                s = p.nodes[s].next
            }
            f.pop_scope_with_drops()
            if f.live_and_open() {
                f.terminate(1, loop_bb, -1, -1)
            }
            f.pop_loop()
            f.switch_to(end_bb)
            <<
        }
        fl := c.array_fixed_len_m(aty)
        // The iterable owner outlives each body/continue edge but is reclaimed
        // at the loop exit (including break) or by return/throw scope cleanup.
        // Enter its scope before evaluation: fixed literals can attach holds.
        f.push_scope()
        $array := f.lower_foreach_base(p, c, p.nodes[n].a)
        idx := f.new_temp(1, 1)
        $iz := mkinstr(MI_COPY)
        iz.a = idx
        iz.b = f.vconst(0)
        f.emit(iz)
        f.scope_add(varid)
        // Zero the iterator binding so the first body rebind-drop is a no-op.
        if varid >= 0 && varid < f.locals.len && f.locals_nslots[varid] > 0 {
            f.zero_field_slots(varid, 0, f.locals_nslots[varid])
        }

        cond_bb := f.new_block()
        body_bb := f.new_block()
        cont_bb := f.new_block()
        end_bb := f.new_block()
        f.terminate(1, cond_bb, -1, -1)
        f.switch_to(cond_bb)
        len := f.new_temp(1, 1)
        if fl > 0 {
            $lc := mkinstr(MI_COPY)
            lc.a = len
            lc.b = f.vconst(fl)
            f.emit(lc)
        } else {
            $ll := mkinstr(MI_LOAD_FIELD)
            ll.a = len
            ll.b = array
            // LoadField offsets are bytes; array len is the second word.
            ll.c = 8
            ll.d = 1
            f.emit(ll)
        }
        cond := f.new_temp(2, 1)
        $lt := mkinstr(MI_BIN)
        lt.a = cond
        lt.b = 8
        lt.c = idx
        lt.d = len
        f.emit(lt)
        f.terminate(2, cond, body_bb, end_bb)

        f.switch_to(body_bb)
        // Body declarations are recreated on every array iteration.  Keep
        // them separate from the iterator binding so narrow Gen1 scope-drop
        // can reclaim scalar owning values promptly.
        body_scope_depth := f.scopes.len
        f.push_scope()
        f.push_loop(end_bb, cont_bb, body_scope_depth)
        ety := c.elem_ty_of_array(aty, f.src_fi)
        // MS9a: owning-struct for-in is a borrow view — do not drop the copy.
        if varid >= 0 && varid < f.locals_owning.len && c.type_owning(ety) && is_struct_type(ety) {
            f.locals_owning[varid] = false
        }
        elem := f.new_temp(ety, c.type_slots(ety))
        $ai := mkinstr(MI_LOAD_INDEX)
        ai.a = elem
        ai.b = array
        ai.c = idx
        // ForEach i runs under i < len — proven in-bounds (M172).
        ai.d = elem_d(c.type_size_bytes(ety), true)
        if fl > 0 {
            ai.col = fl
        }
        f.emit(ai)
        $bound := elem
        if ety == 3 {
            bound = f.new_temp(3, 3)
            $clone := mkinstr(MI_STR_CLONE)
            clone.a = bound
            clone.b = elem
            f.emit(clone)
        }
        // String for-in clones each elem into `bound`. Rebind-drop the owning
        // loop local before overwrite; varid lives in the outer scope so body
        // pop_scope would only drop the last iteration otherwise.
        if varid >= 0 && varid < f.locals_owning.len && varid < f.locals.len && f.locals_owning[varid] && !f.moved[varid] {
            if f.locals[varid] == 3 || is_struct_type(f.locals[varid]) {
                $dv := mkinstr(MI_DROP)
                dv.a = varid
                f.emit(dv)
            }
        }
        $sv := mkinstr(MI_STORE_LOCAL)
        sv.a = varid
        sv.b = bound
        f.emit(sv)
        if varid >= 0 && varid < f.moved.len {
            f.moved[varid] = false
        }
        $s := p.nodes[n].c
        while s >= 0 {
            f.lower_stmt(p, c, s)
            s = p.nodes[s].next
        }
        f.pop_scope_with_drops()
        if f.live_and_open() {
            f.terminate(1, cont_bb, -1, -1)
        }
        f.pop_loop()

        f.switch_to(cont_bb)
        next := f.new_temp(1, 1)
        $inc := mkinstr(MI_BIN)
        inc.a = next
        inc.b = 1
        inc.c = idx
        inc.d = f.vconst(1)
        f.emit(inc)
        $cp := mkinstr(MI_COPY)
        cp.a = idx
        cp.b = next
        f.emit(cp)
        f.terminate(1, cond_bb, -1, -1)

        f.switch_to(end_bb)
        f.pop_scope_with_drops()
        <<
    }
    if k == ast.NK_WHILE { // While
        body_bb := f.new_block()
        end_bb := f.new_block()
        cheap := expr_is_cheap_cond(p, p.nodes[n].a) && f.cond_len_int_arrays(p, &*c, p.nodes[n].a)
        has_cont := stmts_have_own_continue(p, p.nodes[n].c)
        $pushed := 0
        if c.while_is_induct(n) {
            cn := p.nodes[n].a
            ilid := c.nlocal[p.nodes[cn].a]
            alid := c.while_bound_array(p, p.nodes[cn].b)
            if ilid >= 0 && alid >= 0 {
                f.induct_push(ilid, alid)
                pushed = 1
            }
        }
        // Re-apply `i < n` lub while lowering the body so affine
        // `i*n+j` nocheck still fires (check restores lub after the while).
        // Drop init consts of body assigns first: `$i := 0; while i < n`
        // with n a param must not fold the body as `i == 0`.
        c.lower_kill_assigns(p, p.nodes[n].c)
        lub := c.lower_lub_enter(p, p.nodes[n].a)
        if !cheap {
            cond_bb := f.new_block()
            f.terminate(1, cond_bb, -1, -1)
            f.switch_to(cond_bb)
            cond := f.lower_expr(p, c, p.nodes[n].a)
            f.terminate(2, cond, body_bb, end_bb)
            f.switch_to(body_bb)
            body_scope_depth := f.scopes.len
            f.push_scope()
            f.push_loop(end_bb, cond_bb, body_scope_depth)
            $s := p.nodes[n].c
            while s >= 0 {
                f.lower_stmt(p, c, s)
                s = p.nodes[s].next
            }
            f.pop_scope_with_drops()
            if f.live_and_open() {
                f.terminate(1, cond_bb, -1, -1)
            }
            f.pop_loop()
            if pushed == 1 { f.induct_pop() }
            c.lower_lub_leave(lub)
            f.switch_to(end_bb)
            <<
        }
        $latch := body_bb
        if has_cont {
            latch = f.new_block()
        }
        cond := f.lower_expr(p, c, p.nodes[n].a)
        f.terminate(2, cond, body_bb, end_bb)
        f.switch_to(body_bb)
        body_scope_depth := f.scopes.len
        f.push_scope()
        f.push_loop(end_bb, latch, body_scope_depth)
        $s2 := p.nodes[n].c
        while s2 >= 0 {
            f.lower_stmt(p, c, s2)
            s2 = p.nodes[s2].next
        }
        f.pop_scope_with_drops()
        if f.live_and_open() {
            if has_cont {
                f.terminate(1, latch, -1, -1)
            } else {
                cond1 := f.lower_expr(p, c, p.nodes[n].a)
                f.terminate(2, cond1, body_bb, end_bb)
            }
        }
        f.pop_loop()
        if has_cont {
            f.switch_to(latch)
            cond1 := f.lower_expr(p, c, p.nodes[n].a)
            f.terminate(2, cond1, body_bb, end_bb)
        }
        if pushed == 1 { f.induct_pop() }
        c.lower_lub_leave(lub)
        f.switch_to(end_bb)
        <<
    }
    if k == ast.NK_BREAK { // Break
        if f.loop_break.len == 0 {
            c.fail_node(p, n, "break outside loop")
            <<
        }
        end_bb := f.loop_break[f.loop_break.len - 1]
        $depth := f.scopes.len
        if f.loop_scope_depth.len > 0 {
            depth = f.loop_scope_depth[f.loop_scope_depth.len - 1]
        }
        f.emit_loop_scope_drops(depth)
        f.terminate(1, end_bb, -1, -1)
        dead := f.new_block()
        f.switch_to(dead)
        f.dead = true
        <<
    }
    if k == ast.NK_CONTINUE { // Continue
        if f.loop_cont.len == 0 {
            c.fail_node(p, n, "continue outside loop")
            <<
        }
        cont_bb := f.loop_cont[f.loop_cont.len - 1]
        $depth := f.scopes.len
        if f.loop_scope_depth.len > 0 {
            depth = f.loop_scope_depth[f.loop_scope_depth.len - 1]
        }
        f.emit_loop_scope_drops(depth)
        f.terminate(1, cont_bb, -1, -1)
        dead := f.new_block()
        f.switch_to(dead)
        f.dead = true
        <<
    }
}

// Wave C: xu stmt — split from lower_stmt_match_select_xu (W3).
