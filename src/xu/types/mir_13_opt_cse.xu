@xu/types

fn mir_each_clone_cse(m $&Mir) {
    // rustc CopyProp at mir_opt_level>=1. Clone into a local MFn, rewrite,
    // then append through the owning commit path. Nested field stores into
    // `m.fns[fi].instrs[i]` miscompile under Gen1.
    // Do not use a unit-wide nfn cap.  Importing `#math` used to skip CSE
    // for every user index kernel.  Non-index functions are already skipped
    // below; compiler helpers without LoadIndex/StoreIndex stay off this pass.
    n0 := m.fns.len
    $fi := 0
    while fi < n0 {
        if mir_fn_is_extern(&*m, fi) {
            fi += 1
            ->
        }
        // Per-fn cap: whole-element store of a large MFn into []MFn
        // miscompiles under Gen1. User kernels stay under this.
        if m.fns[fi].instrs.len >= 256 {
            fi += 1
            ->
        }
        // O1: clone+store-back of a tiny method (unix_nano) in a ~59-fn
        // unit rewrote `sec * 1e9 + nsec` into `sec * 112 + nsec` (the
        // 0x70 frame offset). Match SimplifyCFG: only index kernels.
        // O2 must keep this skip: copy-prop folds match `Copy 19` and the
        // jump-table peep misses (16ms → 34ms).
        summary := mir_fn_summary(m, fi)
        if !mir_summary_has(summary, MIR_SUM_INDEX) {
            fi += 1
            ->
        }
        $f := mir_clone_fn(m, fi, false)
        if mir_local_cse($&f) {
            mir_copy_prop_fn($&f)
        }
        mir_copy_prop_fn($&f)
        mir_fn_commit(m, fi, f)
        fi += 1
    }
}

fn mir_temp_cse_ok(f &MFn, t int) bool {
    << f.temp_cse_ok(t)
}

fn (f &MFn) temp_cse_ok(t int) bool {
    if t < 0 || t >= f.temps.len { << false }
    ty := f.temps[t]
    if is_integer_type(ty) { << true }
    if ty == 2 { << true }
    << false
}

fn mir_cse_mem_kind(k int) bool {
    if k == 12 || k == 13 || k == 46 {
        << true
    }
    if k == 11 || k == 18 || k == 20 || k == 25 || k == 47 || k == 48 {
        << true
    }
    if k >= 30 && k <= 37 {
        << true
    }
    << false
}

fn mir_cse_fill_last(f $&MFn, bi int, nloc int, last $&[]int) bool {
    $scan := f.blocks[bi].head
    $clobber := false
    for _ in 0:f.instrs.len {
        if scan < 0 { << clobber }
        k := mfn_ikind(&f.instrs, scan)
        if k == MI_LOAD_LOCAL {
            loc := mfn_ib(&f.instrs, scan)
            if loc >= 0 && loc < nloc {
                mfn_set_i(last, loc, scan)
            }
        }
        if mir_cse_mem_kind(k) {
            clobber = true
        }
        scan = mfn_inext(&f.instrs, scan)
    }
    << clobber
}

fn mir_cse_load_skip(f $&MFn, bi int, ii int, dest int, src int, from_st bool, latch bool, last_ii int, had bool, mem_clobber bool) bool {
    $skip := false
    if !f.temp_cse_ok(dest) { skip = true }
    if src >= 0 && !f.temp_cse_ok(src) { skip = true }
    if latch && ii == last_ii { skip = true }
    if from_st {
        $allow := false
        blk := f.blocks[bi]
        if blk.tkind == 3 {
            allow = true
            if dest < 0 { allow = false }
        } else if latch && src >= 0 && had {
            allow = true
        }
        if !allow { skip = true }
        if !skip {
            if f.temp_used_outside(dest, bi) { skip = true }
        }
        // Store-forward last latch reload so skip-store sees one
        // LoadLocal; RA pins off add1 StoreLocal.
        if allow && latch && ii == last_ii {
            if mem_clobber {
                skip = true
            } else if f.temp_cse_ok(dest) {
                if src < 0 || f.temp_cse_ok(src) {
                    if !f.temp_used_outside(dest, bi) {
                        skip = false
                    }
                }
            }
        }
    }
    << skip
}

fn mir_cse_clear_on(on $&[]bool) {
    for i in 0:on.len {
        mfn_set_b(on, i, false)
    }
}

fn mir_cse_kill_eq(on $&[]bool, v $&[]int, dest int) {
    if dest < 0 { << }
    for i in 0:on.len {
        if on[i] && v[i] == dest {
            mfn_set_b(on, i, false)
        }
    }
}

fn mir_cse_step(f $&MFn, bi int, ii int, latch bool, clobber bool, live_on $&[]bool, live_v $&[]int, live_st $&[]bool, had_load $&[]bool, last_load $&[]int) bool {
    nloc := live_on.len
    k := mfn_ikind(&f.instrs, ii)
    ia2 := mfn_ia(&f.instrs, ii)
    ib2 := mfn_ib(&f.instrs, ii)
    ic2 := mfn_ic(&f.instrs, ii)
    $changed := false
    $pend := false
    $pend_loc := 0
    $pend_v := 0
    $pend_st := false
    if k == MI_LOAD_LOCAL {
        loc := ib2
        dest := ia2
        if loc >= 0 && loc < nloc && live_on[loc] {
            src := live_v[loc]
            from_st := live_st[loc]
            skip := mir_cse_load_skip(f, bi, ii, dest, src, from_st, latch, last_load[loc], had_load[loc], clobber)
            if skip {
                pend = true
                pend_loc = loc
                pend_v = dest
                pend_st = false
                mfn_set_b(had_load, loc, true)
            } else {
                mfn_set_copy($&f.instrs, ii, src)
                changed = true
            }
        } else if loc >= 0 && loc < nloc {
            pend = true
            pend_loc = loc
            pend_v = dest
            pend_st = false
            mfn_set_b(had_load, loc, true)
        }
    } else if k == MI_STORE_LOCAL {
        loc := ia2
        if loc >= 0 && loc < nloc {
            pend = true
            pend_loc = loc
            pend_v = ib2
            pend_st = true
        }
    } else if k == MI_DROP {
        loc := ia2
        if loc >= 0 && loc < nloc {
            mfn_set_b(live_on, loc, false)
        }
    } else if k == MI_ADDR && ic2 == 0 {
        loc := ib2
        if loc >= 0 && loc < nloc {
            mfn_set_b(live_on, loc, false)
        }
    } else if (k == MI_CALL && ib2 != 95) || mir_cse_mem_kind(k) {
        mir_cse_clear_on(live_on)
    }
    $da := 0 - 1
    $db := 0 - 1
    if k == MI_CHAN_TRY_RECV {
        da = ia2
        db = ib2
    } else if mir_instr_has_dest(k) {
        if k != MI_CALL || ia2 >= 0 {
            da = ia2
        }
    }
    mir_cse_kill_eq(live_on, live_v, da)
    mir_cse_kill_eq(live_on, live_v, db)
    if pend && pend_loc >= 0 && pend_loc < nloc {
        mfn_set_b(live_on, pend_loc, true)
        mfn_set_i(live_v, pend_loc, pend_v)
        mfn_set_b(live_st, pend_loc, pend_st)
    }
    << changed
}

// This block has memory effects, so the old all-memory barrier remains the
// fallback. A frame scalar cannot be changed through indexed heap writes if
// no instruction in the entire function exposes a frame address. Only reuse
// integer/bool LoadLocal values; explicit local stores and TempId redefinitions
// invalidate them, and ABI/hidden-call operations clear the entire table.
fn mir_cse_memory_scalar_block(f $&MFn, bi int) bool {
    if f.locals.len > 48 || f.instrs.len > 256 || f.blocks.len > 32 { << false }
    if f.blocks[bi].tkind != 3 { << false }
    for b in 0:f.blocks.len {
        $ji := f.blocks[b].head
        for _ in 0:f.instrs.len {
            if ji < 0 { <- }
            if mfn_ikind(&f.instrs, ji) == MI_ADDR { << false }
            ji = mfn_inext(&f.instrs, ji)
        }
    }
    $last := []int{}
    for _ in 0:f.locals.len { last.push(-1) }
    $changed := false
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { << changed }
        k := mfn_ikind(&f.instrs, ii)
        a := mfn_ia(&f.instrs, ii)
        b := mfn_ib(&f.instrs, ii)
        if mir_instr_has_dest(k) && a >= 0 {
            for l in 0:last.len {
                if last[l] == a { last[l] = -1 }
            }
        }
        if k == MI_LOAD_LOCAL && b >= 0 && b < last.len && a >= 0 && a < f.temps.len {
            ty := f.locals[b]
            if f.locals_nslots[b] == 1 && f.temps_nslots[a] == 1 && f.temps[a] == ty && mir_temp_cse_ok(&*f, a) {
                src := last[b]
                if src >= 0 {
                    mfn_set_copy($&f.instrs, ii, src)
                    changed = true
                }
                last[b] = a
            }
        } else if k == MI_STORE_LOCAL && a >= 0 && a < last.len {
            last[a] = -1
        } else {
            $keep := k == MI_NOP || (k >= 1 && k <= 5) || k == MI_LOAD_INDEX || k == MI_LOAD_PTR
            if k == MI_STORE_INDEX {
                rhs := mfn_ic(&f.instrs, ii)
                // Typed primitive stores cannot drop an owning old element.
                // Other stores may hide a real runtime call and stay barriers.
                if rhs >= 0 && rhs < f.temps.len {
                    keep = f.temps_nslots[rhs] == 1 && mir_temp_cse_ok(&*f, rhs)
                }
            }
            if !keep {
                for l in 0:last.len { last[l] = -1 }
            }
        }
        ii = mfn_inext(&f.instrs, ii)
    }
    << changed
}

fn mir_cse_block_has_memory(f &MFn, bi int) bool {
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        if mir_cse_mem_kind(mfn_ikind(&f.instrs, ii)) { << true }
        ii = mfn_inext(&f.instrs, ii)
    }
    << false
}

fn mir_local_cse(f $&MFn) bool {
    nb := f.blocks.len
    nloc := f.locals.len
    if nb == 0 || nloc == 0 { << false }
    $can_inter := false
    if nb > 1 && nb * nloc <= 65536 {
        can_inter = true
    }
    $out_on := []bool{}
    $out_v := []int{}
    $out_st := []bool{}
    $out_valid := []bool{}
    if can_inter {
        total := nb * nloc
        for _ in 0:total {
            out_on.push(false)
            out_v.push(0)
            out_st.push(false)
        }
        for _ in 0:nb {
            out_valid.push(false)
        }
    }
    $changed := false
    for bi in 0:nb {
        if f.is_self_loop(bi) { -> }
        if mir_cse_block_has_memory(&*f, bi) {
            if mir_cse_memory_scalar_block(f, bi) { changed = true }
            ->
        }
        $live_on := []bool{}
        $live_v := []int{}
        $live_st := []bool{}
        $had_load := []bool{}
        $last_load := []int{}
        for _ in 0:nloc {
            live_on.push(false)
            live_v.push(0)
            live_st.push(false)
            had_load.push(false)
            last_load.push(-1)
        }
        if can_inter && bi > 0 {
            pred := f.strict_forward_pred(bi)
            if pred >= 0 && out_valid[pred] {
                pbase := pred * nloc
                for l in 0:nloc {
                    if out_on[pbase + l] {
                        mfn_set_b($&live_on, l, true)
                        mfn_set_i($&live_v, l, out_v[pbase + l])
                        mfn_set_b($&live_st, l, out_st[pbase + l])
                    }
                }
            }
        }
        clobber := mir_cse_fill_last(f, bi, nloc, $&last_load)
        if clobber { -> }
        latch := f.is_self_loop(bi)
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := mfn_inext(&f.instrs, ii)
            if mir_cse_step(f, bi, ii, latch, clobber, $&live_on, $&live_v, $&live_st, $&had_load, $&last_load) {
                changed = true
            }
            ii = nxt
        }
        if can_inter {
            base := bi * nloc
            for l in 0:nloc {
                mfn_set_b($&out_on, base + l, live_on[l])
                mfn_set_i($&out_v, base + l, live_v[l])
                mfn_set_b($&out_st, base + l, live_st[l])
            }
            mfn_set_b($&out_valid, bi, true)
        }
    }
    << changed
}

fn mir_binop_cse(f $&MFn) bool {
    $changed := false
    nb := f.blocks.len
    if nb == 0 { << false }
    $can_inter := false
    if nb > 1 && nb * 64 <= 16384 {
        can_inter = true
    }
    $out_tknd := []int{}
    $out_op := []int{}
    $out_lh := []int{}
    $out_rh := []int{}
    $out_dst := []int{}
    $out_n := []int{}
    $out_valid := []bool{}
    if can_inter {
        total := nb * 64
        for _ in 0:total {
            out_tknd.push(0)
            out_op.push(-1)
            out_lh.push(0)
            out_rh.push(0)
            out_dst.push(0)
        }
        for _ in 0:nb {
            out_n.push(0)
            out_valid.push(false)
        }
    }
    for bi in 0:nb {
        $tknd := []int{}
        $top := []int{}
        $tlh := []int{}
        $trh := []int{}
        $tdst := []int{}
        if can_inter && bi > 0 {
            pred := f.strict_forward_pred(bi)
            if pred >= 0 && out_valid[pred] {
                cnt := out_n[pred]
                pbase := pred * 64
                for i in 0:cnt {
                    op := out_op[pbase + i]
                    if op >= 0 {
                        tknd.push(out_tknd[pbase + i])
                        top.push(op)
                        tlh.push(out_lh[pbase + i])
                        trh.push(out_rh[pbase + i])
                        tdst.push(out_dst[pbase + i])
                    }
                }
            }
        }
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            nxt := f.instrs[ii].next
            k := f.instrs[ii].kind
            if k == 7 || k == 13 || k == 33 || k == 37 {
                for i in 0:top.len {
                    top[i] = 0 - 1
                }
            }
            $ins_knd := 0
            $ins_op := 0
            $ins_a := 0
            $ins_b := 0
            $ins_d := 0
            $do_ins := false
            if k == 4 {
                dest := f.instrs[ii].a
                op := f.instrs[ii].b
                lhs := f.instrs[ii].c
                rhs := f.instrs[ii].d
                $skip := false
                if dest >= 0 && dest < f.temps.len && f.temps[dest] == 4 {
                    skip = true
                }
                if !skip {
                    $a := lhs
                    $b := rhs
                    if mir_bin_commutes(op) && a > b {
                        tmp := a
                        a = b
                        b = tmp
                    }
                    $found := 0 - 1
                    for ti in 0:top.len {
                        if found >= 0 { -> }
                        if top[ti] >= 0 && tknd[ti] == 4 && top[ti] == op && tlh[ti] == a && trh[ti] == b {
                            found = tdst[ti]
                        }
                    }
                    if found >= 0 {
                        mfn_become_copy($&f.instrs, ii, found)
                        changed = true
                    } else if dest >= 0 && top.len < 64 {
                        do_ins = true
                        ins_knd = 4
                        ins_op = op
                        ins_a = a
                        ins_b = b
                        ins_d = dest
                    }
                }
            } else if k == 5 {
                dest := f.instrs[ii].a
                op := f.instrs[ii].b
                src := f.instrs[ii].c
                $skip := false
                if dest >= 0 && dest < f.temps.len && f.temps[dest] == 4 {
                    skip = true
                }
                if !skip {
                    $found := 0 - 1
                    for ti in 0:top.len {
                        if found >= 0 { -> }
                        if top[ti] >= 0 && tknd[ti] == 5 && top[ti] == op && tlh[ti] == src {
                            found = tdst[ti]
                        }
                    }
                    if found >= 0 {
                        mfn_become_copy($&f.instrs, ii, found)
                        changed = true
                    } else if dest >= 0 && top.len < 64 {
                        do_ins = true
                        ins_knd = 5
                        ins_op = op
                        ins_a = src
                        ins_b = -1
                        ins_d = dest
                    }
                }
            } else if k == 23 {
                dest := f.instrs[ii].a
                base := f.instrs[ii].b
                idx := f.instrs[ii].c
                stride := f.instrs[ii].d
                $found := 0 - 1
                for ti in 0:top.len {
                    if found >= 0 { -> }
                    if top[ti] >= 0 && tknd[ti] == 23 && top[ti] == stride && tlh[ti] == base && trh[ti] == idx {
                        found = tdst[ti]
                    }
                }
                if found >= 0 {
                    mfn_become_copy($&f.instrs, ii, found)
                    changed = true
                } else if dest >= 0 && top.len < 64 {
                    do_ins = true
                    ins_knd = 23
                    ins_op = stride
                    ins_a = base
                    ins_b = idx
                    ins_d = dest
                }
            }
            if k == 36 {
                da := f.instrs[ii].a
                db := f.instrs[ii].b
                for i in 0:top.len {
                    if top[i] < 0 { -> }
                    if tdst[i] == da || tlh[i] == da || trh[i] == da { top[i] = 0 - 1 }
                    if tdst[i] == db || tlh[i] == db || trh[i] == db { top[i] = 0 - 1 }
                }
            } else if mir_instr_has_dest(k) {
                if k != 7 || f.instrs[ii].a >= 0 {
                    da := f.instrs[ii].a
                    for i in 0:top.len {
                        if top[i] < 0 { -> }
                        if tdst[i] == da || tlh[i] == da || trh[i] == da { top[i] = 0 - 1 }
                    }
                }
            }
            if do_ins {
                tknd.push(ins_knd)
                top.push(ins_op)
                tlh.push(ins_a)
                trh.push(ins_b)
                tdst.push(ins_d)
            }
            ii = nxt
        }
        if can_inter {
            $saved := 0
            base := bi * 64
            for i in 0:top.len {
                if saved >= 64 { -> }
                if top[i] >= 0 {
                    mfn_set_i($&out_tknd, base + saved, tknd[i])
                    mfn_set_i($&out_op, base + saved, top[i])
                    mfn_set_i($&out_lh, base + saved, tlh[i])
                    mfn_set_i($&out_rh, base + saved, trh[i])
                    mfn_set_i($&out_dst, base + saved, tdst[i])
                    saved += 1
                }
            }
            mfn_set_i($&out_n, bi, saved)
            mfn_set_b($&out_valid, bi, true)
        }
    }
    << changed
}
