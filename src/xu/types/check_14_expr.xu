@xu/types

#xu/ast
#xu/parser

fn (c &mut Checker) check_binop_expr(p &parser.Parser, n int) int {
    op := p.nodes[n].ival
    mut lt := c.check_expr(p, p.nodes[n].a)
    mut rt := c.check_expr(p, p.nodes[n].b)
    if is_error_type(lt) || is_error_type(rt) {
        checker_set_i(mut &c.ntype, n, ERROR_TY)
        << ERROR_TY
    }
    if is_integer_type(lt) && lt != rt {
        rt = c.coerce_to(p, p.nodes[n].b, rt, lt)
    }
    if is_integer_type(rt) && lt != rt {
        lt = c.coerce_to(p, p.nodes[n].a, lt, rt)
    }
    // string + : heap concat. L2c-amp: `+` also accepts `&string` on
    // either side (or both); mir reads the borrow through at concat
    // time, so the result type is the owned string.
    lstr := lt == 3 || (is_ref_type(lt) && c.ref_inner_type(lt) == 3)
    rstr := rt == 3 || (is_ref_type(rt) && c.ref_inner_type(rt) == 3)
    if op == 1 && lstr && rstr {
        if c.in_irq == 1 {
            c.fail_node(p, n, "cannot allocate in irq handler")
        }
        checker_set_i(mut &c.ntype, n, 3)
        << 3
    }
    if op >= 1 && op <= 4 { // + - * / : int family or f64 (matched)
        if is_integer_type(lt) && lt == rt {
            if op == 4 {
                c.check_int_div(p, n, p.nodes[n].a, p.nodes[n].b)
            }
            checker_set_i(mut &c.ntype, n, lt)
            << lt
        }
        if lt == 4 && rt == 4 {
            checker_set_i(mut &c.ntype, n, 4)
            << 4
        }
        if op == 1 {
            << c.fail_expr(p, n, "operator '+' requires int, f64, or string operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        << c.fail_expr(p, n, "arithmetic requires matching int or f64 operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
    }
    if op == 5 { // % integer family
        if !is_integer_type(lt) || lt != rt {
            << c.fail_expr(p, n, "arithmetic/bitwise requires int operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        c.check_int_div(p, n, p.nodes[n].a, p.nodes[n].b)
        checker_set_i(mut &c.ntype, n, lt)
        << lt
    }
    if op >= 6 && op <= 7 { // == !=
        eqok := (is_integer_type(lt) && lt == rt) || (lt == 2 && rt == 2) || (lt == 3 && rt == 3) || (lt == 4 && rt == 4)
        if !eqok {
            << c.fail_expr(p, n, "cannot compare " + c.ty_display(lt) + " with " + c.ty_display(rt))
        }
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    if op <= 11 { // < <= > >=
        if !(is_integer_type(lt) && lt == rt) && !(lt == 4 && rt == 4) {
            << c.fail_expr(p, n, "comparison requires matching int or f64 operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    if op <= 13 { // && ||
        if lt != 2 || rt != 2 {
            << c.fail_expr(p, n, "logical operator requires bool operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    // bitwise: matching integer family
    if !is_integer_type(lt) || lt != rt {
        << c.fail_expr(p, n, "arithmetic/bitwise requires int operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
    }
    checker_set_i(mut &c.ntype, n, lt)
    << lt
}

fn (c &mut Checker) check_struct_init_expr(p &parser.Parser, n int) int {
    mut si := c.find_struct_in_mod(c.named_local_of(p, n), c.named_mod_of(p, n))
    if c.named_mod_of(p, n) != c.cur_mod {
        if !c.module_visible(c.named_mod_of(p, n)) {
            c.fail_node(p, n, "module " + c.named_mod_of(p, n) + " not imported")
        }
    }
    // Generic: Box<int>{...} via explicit type args (node.b).
    if p.nodes[n].b >= 0 {
        c.collect_type_list_n(p, p.nodes[n].b)
        si = c.instantiate_struct(p, n)
        if si < 0 {
            checker_set_i(mut &c.ntype, n, ERROR_TY)
            << ERROR_TY
        }
    } else if si < 0 {
        if c.find_stpl(c.named_local_of(p, n), c.named_mod_of(p, n)) >= 0 {
            << c.fail_expr(p, n, "generic struct '" + p.nodes[n].sval + "' requires type arguments")
        }
        << c.fail_expr(p, n, "unknown struct '" + p.nodes[n].sval + "'")
    }
    if c.named_mod_of(p, n) != c.cur_mod && !c.structs[si].is_pub {
        c.fail_node(p, n, "'" + c.named_local_of(p, n) + "' is private")
    }
    cross := c.structs[si].mod_id != c.cur_mod
    mut seen := []bool{}
    for i in 0:c.structs[si].fields.len {
        seen.push(false)
    }
    mut sf := p.nodes[n].a
    while sf >= 0 {
    if p.nodes[sf].kind != ast.NK_S_FIELD {
        c.fail_node(p, sf, "malformed struct init field")
        sf = p.nodes[sf].next
        ->
    }
    fi := c.find_field(si, p.nodes[sf].sval)
    if fi < 0 {
        c.fail_node(p, sf, "struct '" + p.nodes[n].sval + "' has no field '" + p.nodes[sf].sval + "'")
        sf = p.nodes[sf].next
        ->
    }
    if cross {
        c.require_field_visible(p, sf, si, fi)
    }
    if seen[fi] {
        c.fail_node(p, sf, "duplicate field '" + p.nodes[sf].sval + "' in struct init")
    }
    seen[fi] = true
    mut fty := c.check_expr(p, p.nodes[sf].a)
    fty = c.coerce_to(p, p.nodes[sf].a, fty, c.structs[si].fields[fi].ty)
    if fty != c.structs[si].fields[fi].ty {
        c.fail_node(p, p.nodes[sf].a, "type mismatch: expected " + c.ty_display(c.structs[si].fields[fi].ty) + ", found " + c.ty_display(fty))
    }
    // M165: field `&a T` must come from a param with lifetime `a`.
    want := c.structs[si].fields[fi].life
    if want.len > 0 && is_ref_type(c.structs[si].fields[fi].ty) {
        origin := c.expr_ref_origin(p, p.nodes[sf].a)
        if origin < 0 {
            c.fail_node(p, sf, "cannot store a reference to local data in field '" + p.nodes[sf].sval + "'")
        }
        if origin >= c.llife.len || c.llife[origin] != want {
            c.fail_node(p, sf, "field '" + p.nodes[sf].sval + "' requires lifetime '" + want + "'")
        }
    }
    c.move_of(p, p.nodes[sf].a, fty, false)
    sf = p.nodes[sf].next
    }
    for i in 0:c.structs[si].fields.len {
        if seen[i] {
            ->
        }
        if cross {
            if c.structs[si].fields[i].is_pub {
                c.fail_node(p, n, "missing public field '" + c.structs[si].fields[i].name + "' in initializer of struct '" + c.structs[si].name + "'")
            }
            if c.structs[si].drop_label.len > 0 || c.zero_requires_resource_constructor(c.structs[si].fields[i].ty) {
                c.fail_node(p, n, "resource with private fields requires a constructor")
            }
            // Other private fields: MIR zero-fills at codegen.
        } else {
            c.fail_node(p, n, "missing field '" + c.structs[si].fields[i].name + "' in initializer of struct '" + c.structs[si].name + "'")
        }
    }
    ty := struct_type(si)
    checker_set_i(mut &c.ntype, n, ty)
    << ty
}

fn (c &mut Checker) check_index_expr(p &parser.Parser, n int) int {
    ot := c.check_expr(p, p.nodes[n].a)
    oa := p.nodes[n].a
    if oa >= 0 && p.nodes[oa].kind == ast.NK_INDEX && oa < c.ncall.len && c.ncall[oa] == -77 {
        if ot != 3 && c.type_owning(ot) {
            c.fail_node(p, n, "cannot move an owning map value by index; borrow it or take it")
        }
    }
    base_ty := c.direct_type(ot)
    mt := c.peel_map(ot)
    if mt >= 0 {
        it := c.check_expr(p, p.nodes[n].b)
        wantk := c.maps[map_index(mt)].key_ty
        if it != wantk {
            c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.ty_display(wantk) + ", found " + c.ty_display(it))
        }
        checker_set_i(mut &c.ncall, n, -77)
        vt := c.maps[map_index(mt)].val_ty
        checker_set_i(mut &c.ntype, n, vt)
        << vt
    }
    if c.is_maps_table(base_ty) {
        it := c.check_expr(p, p.nodes[n].b)
        if it != 3 {
            c.fail_node(p, p.nodes[n].b, "map key type must be string")
        }
        get_fi := c.find_method(base_ty, "get")
        if get_fi < 0 {
            c.fail_node(p, n, "internal: maps.get missing")
        }
        checker_set_i(mut &c.ncall, n, get_fi)
        << c.wrap_throwable_call_result(p, n, get_fi, c.maps_val_ty(base_ty))
    }
    it := c.check_expr(p, p.nodes[n].b)
    if it != 1 {
        c.fail_node(p, p.nodes[n].b, "type mismatch: expected int, found " + c.ty_display(it))
    }
    // M36 E3: constant negative index on temp array/string; constant index
    // past the known length of an array literal.
    if c.is_const_int_expr(p, p.nodes[n].b) {
        iv := c.const_int_expr_value(p, p.nodes[n].b)
        if iv < 0 {
            c.fail_node(p, p.nodes[n].b, "negative index " + str(iv))
        }
        if is_array_type(base_ty) {
            ln := c.known_len_of(p, p.nodes[n].a)
            if ln >= 0 && iv >= ln {
                c.fail_node(p, p.nodes[n].b, "index " + str(iv) + " out of bounds for array of length " + str(ln))
            }
        }
    }
    if base_ty == 3 { // string byte access
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if is_array_type(base_ty) {
        // Array index: result type is the element type.
        ai := array_index(base_ty)
        mut et := c.arrays[ai].elem_ty
        if c.is_inst[c.cur_fn] != 0 {
            t0 := c.inst_elem_t0(c.cur_fn)
            if t0 >= 0 && (is_param_type(et) || (et == 3 && t0 == 4)) {
                et = t0
            }
        }
        checker_set_i(mut &c.ntype, n, et)
        obj := p.nodes[n].a
        if p.nodes[obj].kind == ast.NK_IDENT {
            rid := c.nlocal[obj]
            ei := c.as_const_index(p, p.nodes[n].b)
            if ei >= 0 {
                c.check_field_not_moved(p, rid, ei, p.nodes[n].a)
            }
        }
        pth := c.as_place_path(p, n)
        rid2 := c.as_top_field_id(p, n)
        if rid2 >= 0 && pth >= 64 {
            c.check_path_not_moved(p, rid2, pth, n)
        }
        << et
    }
    c.fail_node(p, n, "cannot index into " + c.ty_display(ot))
    << -1
}

// W3: Ident — split from check_expr.
fn (c &mut Checker) check_expr_ident(p &parser.Parser, n int) int {
    // M109: remapped capture → env.field
    if c.cap_active == 1 {
        name := p.nodes[n].sval
        for i in 0:c.cap_names.len {
            if c.cap_names[i] == name {
                checker_set_i(mut &c.ncall, n, -90)
                si28 := c.cap_fields[i]
                checker_set_i(mut &c.nstr, n, si28)
                checker_set_i(mut &c.nlocal, n, -1)
                ty := c.cap_tys[i]
                checker_set_i(mut &c.ntype, n, ty)
                << ty
            }
        }
    }
    id := c.find_local(p.nodes[n].sval)
    if id < 0 {
        ci := c.find_const(p.nodes[n].sval)
        if ci >= 0 {
            checker_set_i(mut &c.nconst, n, ci)
            ty := c.ctypes[ci]
            checker_set_i(mut &c.ntype, n, ty)
            if ty == 3 {
                si29 := c.cstr_idx[ci]
                checker_set_i(mut &c.nstr, n, si29)
            }
            << ty
        }
        // M103: bare free function name → fn value (code pointer).
        fi := c.find_fn(p.nodes[n].sval)
        if fi >= 0 {
            if c.fns[fi].is_template {
                << c.fail_expr(p, n, "cannot take value of generic function '" + p.nodes[n].sval + "' (instantiate via a call)")
            }
            checker_set_i(mut &c.ncall, n, fi)
            mut params := []int{}
            for pi in 0:c.fns[fi].params.len {
                params.push(c.fns[fi].params[pi])
            }
            ty := c.intern_fn_sig(params, c.fns[fi].ret)
            checker_set_i(mut &c.ntype, n, ty)
            << ty
        }
        << c.fail_expr(p, n, "undefined name '" + p.nodes[n].sval + "'")
    }
    c.check_not_moved(p, id, n)
    checker_set_i(mut &c.nlocal, n, id)
    ty := c.ltype[id]
    checker_set_i(mut &c.ntype, n, ty)
    << ty
}

// W3: Borrow — split from check_expr.
fn (c &mut Checker) check_expr_borrow(p &parser.Parser, n int) int {
    mutable := p.nodes[n].ival == 1
    target := p.nodes[n].a
    tk := p.nodes[target].kind
    if tk == ast.NK_UN_OP && p.nodes[target].ival == 3 {
        // `&*r` of shared `&T`: copy the pointer. `mut &*r` of `&mut T`:
        // exclusive reborrow. `&*r` of `&mut T`: shared reborrow (freeze `r`).
        inner := p.nodes[target].a
        mut ity := c.check_expr(p, inner)
        if mutable {
            if !is_mut_ref_type(ity) || p.nodes[inner].kind != ast.NK_IDENT {
                c.fail_node(p, n, "cannot take address of dereference")
            }
            checker_set_i(mut &c.ntype, n, ity)
        } else if !is_ref_type(ity) {
            c.fail_node(p, n, "cannot take address of dereference")
        } else if is_mut_ref_type(ity) {
            if p.nodes[inner].kind != ast.NK_IDENT {
                c.fail_node(p, n, "cannot take address of dereference")
            }
            pty := c.ref_inner_type(ity)
            rt := c.make_ref_type(false, pty)
            if rt < 0 {
                c.fail_node(p, n, "cannot take address of dereference")
            }
            checker_set_i(mut &c.ntype, n, rt)
            ity = rt
        } else {
            checker_set_i(mut &c.ntype, n, ity)
        }
        if p.nodes[inner].kind == ast.NK_IDENT {
            si30 := c.nlocal[inner]
            checker_set_i(mut &c.nlocal, n, si30)
        }
        << ity
    }
    if tk == ast.NK_INDEX {
        << c.check_expr_borrow_index(p, n)
    }
    if tk == ast.NK_FIELD {
        mut b := p.nodes[target].a
        while b >= 0 && p.nodes[b].kind == ast.NK_FIELD {
            b = p.nodes[b].a
        }
        if b >= 0 && p.nodes[b].kind == ast.NK_INDEX {
            << c.check_expr_borrow_index(p, n)
        }
    }
    ity := c.check_expr(p, p.nodes[n].a)
    // Shared borrow of a literal/temp is legal (stdlib `"int=")`); only
    // `mut &` still requires a real place. Fields/Idents keep the old path.
    if tk != ast.NK_IDENT && tk != ast.NK_FIELD && tk != ast.NK_STR && tk != ast.NK_INT && tk != ast.NK_BOOL {
        if mutable {
            c.fail_node(p, n, "can only borrow variables or fields")
        }
    }
    // MS6 C: shared `&temp`/`&any` rejected; `mut &e` allowed for is/as.
    if !mutable && is_dynamic_box(ity) {
        c.fail_node(p, n, "cannot borrow a value of type " + c.ty_display(ity))
    }
    if tk == ast.NK_IDENT {
        bid := c.nlocal[target]
        if c.field_cons_any(bid) {
            c.fail_node(p, n, "use of moved value '" + c.lname[bid] + "'")
        }
    }
    if tk == ast.NK_FIELD {
        pth := c.as_place_path(p, target)
        rid := c.as_top_field_id(p, target)
        if rid >= 0 && pth > 0 {
            for s in 0:4 {
                lp := c.lp_get(rid, s)
                if lp == 0 {
                    ->
                }
                if lp == pth || path_is_prefix(lp, pth) || path_is_prefix(pth, lp) {
                    c.fail_node(p, n, "use of moved value '" + c.lname[rid] + "'")
                }
            }
        }
    }
    if mutable {
        mut root := target
        if tk == ast.NK_FIELD { root = p.nodes[target].a }
        if p.nodes[root].kind != ast.NK_IDENT {
            c.fail_node(p, n, "mutable field borrow requires a local root")
        }
        id := c.nlocal[root]
        // MS6 C: exclusive borrow of temp/any/struct@ for is/as; binding need not be mut.
        if id < 0 || (c.lmut[id] == 0 && !is_mut_ref_type(c.ltype[id]) && !is_dynamic_box(ity)) {
            c.fail_node(p, n, "cannot mutably borrow immutable variable '" + p.nodes[root].sval + "'")
        }
    }
    // M166: allow one nesting level via make_ref_type.
    rty := c.make_ref_type(mutable, ity)
    if rty < 0 {
        c.fail_node(p, n, "cannot borrow a value of type " + c.ty_display(ity))
    }
    checker_set_i(mut &c.ntype, n, rty)
    << rty
}

// MS4: `&xs[i]` / `mut &xs[i]` / `&xs[i].f` — Place hung on the container root.
fn (c &mut Checker) check_expr_borrow_index(p &parser.Parser, n int) int {
    mutable := p.nodes[n].ival == 1
    target := p.nodes[n].a
    mut cur := target
    mut saw_index := false
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX {
            saw_index = true
            idx := p.nodes[cur].b
            if idx < 0 || (p.nodes[idx].kind != ast.NK_IDENT && p.nodes[idx].kind != ast.NK_INT && p.nodes[idx].kind != ast.NK_STR) {
                c.fail_node(p, n, "element borrow index must be a variable or integer literal")
            }
            cur = p.nodes[cur].a
        } else if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            <-
        }
    }
    if !saw_index {
        c.fail_node(p, n, "can only borrow array elements")
    }
    ity := c.check_expr(p, target)
    is_map := c.borrow_chain_is_map(p, target)
    if is_map && p.nodes[target].kind != ast.NK_INDEX {
        c.fail_node(p, n, "cannot borrow a map element")
    }
    if !is_map && p.nodes[target].kind == ast.NK_INDEX {
        base := p.nodes[target].a
        aty := c.direct_type(c.ntype[base])
        if !is_array_type(aty) {
            c.fail_node(p, n, "can only borrow array elements")
        }
    }
    if !elem_borrow_ok(ity) {
        if is_map {
            c.fail_node(p, n, "cannot borrow map elements of type " + c.ty_display(ity))
        }
        c.fail_node(p, n, "cannot borrow array elements of type " + c.ty_display(ity))
    }
    root := c.borrow_root_local(p, target)
    if root < 0 {
        if is_map {
            c.fail_node(p, n, "can only borrow map elements of a variable")
        }
        c.fail_node(p, n, "can only borrow array elements of a variable")
    }
    rty := c.ltype[root]
    if is_ref_type(rty) {
        inner := c.ref_inner_type(rty)
        if !is_struct_type(inner) && !is_array_type(inner) && !is_map_type(inner) {
            if is_map {
                c.fail_node(p, n, "can only borrow map elements of a local map")
            }
            c.fail_node(p, n, "can only borrow array elements of a local array")
        }
        if mutable && !is_mut_ref_type(rty) {
            c.fail_node(p, n, "cannot mutably borrow a field through a shared reference")
        }
    } else if !is_array_type(rty) && !is_struct_type(rty) && !is_map_type(rty) {
        if is_map {
            c.fail_node(p, n, "can only borrow map elements of a local map")
        }
        c.fail_node(p, n, "can only borrow array elements of a local array")
    }
    if mutable && !is_ref_type(rty) && c.lmut[root] == 0 {
        c.fail_node(p, n, "cannot mutably borrow immutable variable '" + c.lname[root] + "'")
    }
    rt := c.make_ref_type(mutable, ity)
    if rt < 0 {
        c.fail_node(p, n, "cannot borrow a value of type " + c.ty_display(ity))
    }
    checker_set_i(mut &c.ntype, n, rt)
    << rt
}

// W3: ArrayLit / EmptyArrayLit — split from check_expr.
fn (c &mut Checker) check_expr_array_lit(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_ARRAY_LIT { // ArrayLit — `[…]` or `[N]T{…}`
        fl := p.nodes[n].ival
        if fl > 0 {
            // Fixed composite: element type from annotation node `b`.
            ety := c.type_of(p, p.nodes[n].b)
            mut cnt := 0
            mut e := p.nodes[n].a
            while e >= 0 {
                mut et := c.check_expr(p, e)
                et = c.coerce_to(p, e, et, ety)
                if et != ety {
                    c.fail_node(p, e, "type mismatch: expected " + c.ty_display(ety) + ", found " + c.ty_display(et))
                }
                c.move_of(p, e, ety, false)
                cnt += 1
                e = p.nodes[e].next
            }
            if cnt != fl && cnt != 0 {
                c.fail_node(p, n, "fixed array literal has " + str(cnt) + " elements, expected " + str(fl) + " (or 0 for zero-init)")
            }
            si31 := c.intern_array_type_n(ety, fl)
            // Always pre-intern `[]T`: MIR copies c.arrays after check, before
            // lower. Owning and non-owning fixed ArrayLit both use a synthetic
            // dynamic hold whose type id must already exist in m.arrays.
            if fl > 0 {
                c.intern_array_type_n(ety, 0)
            }
            checker_set_i(mut &c.ntype, n, si31)
            << c.ntype[n]
        }
        if c.in_irq == 1 {
            c.fail_node(p, n, "cannot allocate in irq handler")
        }
        if p.nodes[n].a < 0 {
            c.fail_node(p, n, "array literal needs at least one element")
        }
        ety := c.check_expr(p, p.nodes[n].a)
        // M167: array literals may hold references.
        // Remaining elements coerce to the first (int narrowing / MS5 box).
        mut e := p.nodes[n].a
        while e >= 0 {
        if e != p.nodes[n].a {
            mut et := c.check_expr(p, e)
            et = c.coerce_to(p, e, et, ety)
            if et != ety {
                c.fail_node(p, e, "type mismatch: expected " + c.ty_display(ety) + ", found " + c.ty_display(et))
            }
        }
        // The inference element transfers too; skipping it creates a
        // second owner for the same allocation.
        c.move_of(p, e, ety, false)
        e = p.nodes[e].next
        }
        // Dedup array type
        si32 := c.intern_array_type(ety)
        checker_set_i(mut &c.ntype, n, si32)
        << c.ntype[n]
    }
    // EmptyArrayLit: []T{}
    if c.in_irq == 1 {
        c.fail_node(p, n, "cannot allocate in irq handler")
    }
    ety := c.type_of(p, p.nodes[n].a)
    si33 := c.intern_array_type(ety)
    checker_set_i(mut &c.ntype, n, si33)
    << c.ntype[n]
}

// W3: slice s[a -< b] / xs[a -< b] — split from check_expr.
fn (c &mut Checker) check_expr_slice(p &parser.Parser, n int) int {
    ot := c.check_expr(p, p.nodes[n].a)
    mut base := ot
    if is_ref_type(base) {
        base = c.ref_inner_type(base)
    }
    if is_ref_type(base) {
        base = c.ref_inner_type(base)
    }
    mut result := 3
    if base == 3 {
        result = 3
    } else if is_array_type(base) {
        if c.is_fixed_array_m(base) {
            c.fail_node(p, n, "cannot slice a fixed-size array")
        }
        if c.in_irq == 1 {
            c.fail_node(p, n, "cannot allocate in irq handler")
        }
        ety := c.elem_ty_of_array(base, c.cur_fn)
        if c.type_owning(ety) && ety != 3 {
            c.fail_node(p, n, "cannot slice an array of non-string owning values")
        }
        result = base
    } else {
        c.fail_node(p, n, "cannot slice " + c.ty_display(ot))
    }
    if p.nodes[n].b >= 0 {
        st := c.check_expr(p, p.nodes[n].b)
        if st != 1 {
            c.fail_node(p, p.nodes[n].b, "slice bounds must be int")
        }
    }
    if p.nodes[n].c >= 0 {
        et := c.check_expr(p, p.nodes[n].c)
        if et != 1 {
            c.fail_node(p, p.nodes[n].c, "slice bounds must be int")
        }
    }
    // M36 E4 / MS9d: constant slice bounds out of range for a known-length
    // string or array.
    if p.nodes[n].b >= 0 && p.nodes[n].c >= 0 {
        ln := c.known_len_of(p, p.nodes[n].a)
        if ln >= 0 && c.is_const_int_expr(p, p.nodes[n].b) && c.is_const_int_expr(p, p.nodes[n].c) {
            sv := c.const_int_expr_value(p, p.nodes[n].b)
            ev := c.const_int_expr_value(p, p.nodes[n].c)
            rk := p.nodes[n].ival
            mut ls := sv
            mut le := ev
            if range_start_excl(rk) { ls = sv + 1 }
            if !range_end_excl(rk) { le = ev + 1 }
            if ls < 0 || le > ln || ls > le {
                c.fail_node(p, n, "slice " + str(sv) + " " + range_op_str(rk) + " " + str(ev) + " out of bounds for length " + str(ln))
            }
        }
    }
    checker_set_i(mut &c.ntype, n, result)
    << result
}

// W3: UnOp — split from check_expr.
fn (c &mut Checker) check_expr_unop(p &parser.Parser, n int) int {
    op := p.nodes[n].ival
    t := c.check_expr(p, p.nodes[n].a)
    if op == 1 { // -
        if is_integer_type(t) {
            checker_set_i(mut &c.ntype, n, t)
            << t
        }
        if t == 4 {
            checker_set_i(mut &c.ntype, n, 4)
            << 4
        }
        c.fail_node(p, n, "unary '-' requires int or f64")
    }
    if op == 3 { // *e — MS3
        if !is_ref_type(t) {
            c.fail_node(p, n, "cannot dereference non-reference type '" + c.ty_display(t) + "'")
        }
        pty := c.ref_inner_type(t)
        // MS6 C: `(*r) as T` / `is` may deref `&mut temp`.
        if c.in_or_catch == 3 && is_mut_ref_type(t) && is_as_box(pty) {
            checker_set_i(mut &c.ntype, n, pty)
            << pty
        }
        if !deref_copy_ok(pty) {
            c.fail_node(p, n, "cannot dereference owning type '" + c.ty_display(pty) + "'")
        }
        checker_set_i(mut &c.ntype, n, pty)
        << pty
    }
    if t != 2 {
        c.fail_node(p, n, "unary '!' requires bool")
    }
    checker_set_i(mut &c.ntype, n, 2)
    << 2
}

// W3: ChanInit / Recv — split from check_expr.
fn (c &mut Checker) check_expr_chan(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_CHAN_INIT { // ChanInit a=elem type, b=cap (M17)
        if c.in_irq == 1 {
            c.fail_node(p, n, "cannot use channels in irq handler")
        }
        ety := c.type_of(p, p.nodes[n].a)
        if !c.type_is_send(ety) {
            c.fail_node(p, n, "channel element type cannot be a reference")
        }
        si34 := c.intern_chan_type(ety)
        checker_set_i(mut &c.ntype, n, si34)
        cty := c.check_expr(p, p.nodes[n].b)
        if cty != 1 {
            c.fail_node(p, p.nodes[n].b, "type mismatch: expected int, found " + c.ty_display(cty))
        }
        // M36 E5: constant negative capacity (cap 0 = unbuffered, M17b).
        // `-1` parses as UnOp(Neg, Int(1)), not Int(-1) — mirror xuhir.
        capn := p.nodes[n].b
        if p.nodes[capn].kind == ast.NK_INT {
            if p.nodes[capn].ival < 0 {
                c.fail_node(p, capn, "channel capacity must not be negative")
            }
        }
        if p.nodes[capn].kind == ast.NK_UN_OP && p.nodes[capn].ival == 1 {
            inner := p.nodes[capn].a
            if inner >= 0 && p.nodes[inner].kind == ast.NK_INT {
                if p.nodes[inner].ival > 0 {
                    c.fail_node(p, capn, "channel capacity must not be negative")
                }
            }
        }
        ci := chan_index(c.ntype[n])
        checker_set_i(mut &c.nlocal, n, ci)
        << c.ntype[n]
    }
    // Recv <-ch (M17)
    if c.in_irq == 1 {
        c.fail_node(p, n, "cannot use channels in irq handler")
    }
    cty := c.check_expr(p, p.nodes[n].a)
    if !is_chan_type(cty) {
        c.fail_node(p, n, "receive requires a channel, found " + c.ty_display(cty))
    }
    ci := chan_index(cty)
    elem := c.chans[ci].elem_ty
    checker_set_i(mut &c.nlocal, n, ci)
    checker_set_i(mut &c.ntype, n, elem)
    << elem
}

// W3: OrCatch — split from check_expr.
fn (c &mut Checker) check_expr_or_try(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_OR_CATCH { // OrCatch: call or (err) { } (§5.7)
        c.in_or_catch = 1
        call_ty := c.check_expr(p, p.nodes[n].a)
        c.in_or_catch = 0
        // Non-throwing calls may still use `or` as a fallback (fixtures/stdlib
        // wrap write_string/int helpers). Result type is the call's native type.
        mut res_ty := call_ty
        if is_throw_type(call_ty) {
            ri := throw_index(call_ty)
            if ri < 0 || ri >= c.throws.len {
                c.fail_node(p, n, "invalid throw type on `or`")
                << -1
            }
            res_ty = c.throws[ri].ok_ty
            if !c.or_body_definite(p, p.nodes[n].c, c.or_assign) {
                c.fail_node(p, n, "`or` block must assign the target or terminate (`<<`/`<-`/`->`/`>>`)")
            }
        }
        c.push_scope(0)
        err_ty := iface_ty(c.errors_iface)
        err_id := c.add_local(p.nodes[n].sval, err_ty, false)
        mut s := p.nodes[n].c
        while s >= 0 {
            c.check_stmt(p, s)
            s = p.nodes[s].next
        }
        c.pop_scope(p, false, false)
        checker_set_i(mut &c.nlocal, n, err_id)
        checker_set_i(mut &c.ntype, n, res_ty)
        << res_ty
    }
    c.fail_node(p, n, "expression not supported yet (M6b2-s3a)")
    << -1
}

// W3: Cast / nk_type_is / nk_type_as — split from check_expr.
fn (c &mut Checker) check_expr_cast_is_as(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_CAST { // Cast ival=to_ty, a=expr
        ity := c.check_expr(p, p.nodes[n].a)
        to := p.nodes[n].ival
        if to == 4 {
            if ity != 1 {
                c.fail_node(p, n, "f64(...) expects int")
            }
            checker_set_i(mut &c.ntype, n, 4)
            << 4
        }
        if to == 1 {
            if !is_integer_type(ity) && ity != 4 {
                c.fail_node(p, n, "int(...) expects int or f64")
            }
            checker_set_i(mut &c.ntype, n, 1)
            << 1
        }
        if to == 8 || to == 9 || to == 10 {
            if !is_integer_type(ity) {
                c.fail_node(p, n, "integer cast expects an integer")
            }
            checker_set_i(mut &c.ntype, n, to)
            << to
        }
        c.fail_node(p, n, "unsupported cast")
        << 0
    }
    if k == ast.NK_TYPE_IS { // nk_type_is (M147)
        saved_peel := c.in_or_catch
        c.in_or_catch = 3
        raw := c.check_expr(p, p.nodes[n].a)
        c.in_or_catch = saved_peel
        mut ity := raw
        if is_mut_ref_type(raw) {
            inner := c.ref_inner_type(raw)
            if is_dynamic_box(inner) {
                ity = inner
            }
        }
        concrete := c.type_of(p, p.nodes[n].b)
        if is_temp_type(ity) || is_any_type(ity) {
            tid := temp_box_type_id(concrete)
            if tid < 0 {
                mut box_name := "temp"
                if is_any_type(ity) { box_name = "any" }
                c.fail_node(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type assert on " + box_name)
            }
            checker_set_i(mut &c.nlocal, n, tid)
        } else if is_interface_type(ity) {
            if !is_struct_type(concrete) {
                c.fail_node(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type assert on struct@ (only structs)")
            }
            checker_set_i(mut &c.nlocal, n, type_box_tag(concrete)) // concrete type id
        } else {
            c.fail_node(p, n, "'is' requires a temp, any, or struct@ value, found " + c.ty_display(ity))
        }
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    // nk_type_as (M147): `e as T` → T; mismatch fail-loud
    saved_peel := c.in_or_catch
    // Reuse in_or_catch=3 as as_peel for deref of &mut temp (is/as operand).
    c.in_or_catch = 3
    raw := c.check_expr(p, p.nodes[n].a)
    c.in_or_catch = saved_peel
    // MS6 C: peel `&mut temp` / deref result already temp.
    mut ity := raw
    if is_mut_ref_type(raw) {
        inner := c.ref_inner_type(raw)
        if is_dynamic_box(inner) {
            ity = inner
        }
    }
    concrete := c.type_of(p, p.nodes[n].b)
    if is_temp_type(ity) || is_any_type(ity) {
        tid := temp_box_type_id(concrete)
        if tid < 0 {
            mut box_name := "temp"
            if is_any_type(ity) { box_name = "any" }
            c.fail_node(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type cast on " + box_name)
        }
        if is_any_type(ity) && c.type_owning(concrete) && concrete != 3 {
            c.fail_node(p, n, "cannot cast owning " + c.ty_display(concrete) + " out of any without consuming; use temp")
        }
        checker_set_i(mut &c.nlocal, n, tid)
    } else if is_interface_type(ity) {
        if !is_struct_type(concrete) {
            c.fail_node(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type cast on struct@ (only structs)")
        }
        checker_set_i(mut &c.nlocal, n, type_box_tag(concrete)) // concrete type id
    } else {
        c.fail_node(p, n, "'as' requires a temp, any, or struct@ value, found " + c.ty_display(ity))
    }
    // temp: always consume. struct@: consume iff concrete owning. any: keep.
    mut consume := is_temp_type(ity)
    if is_interface_type(ity) {
        consume = c.type_owning(concrete)
    }
    if consume {
        saved_or := c.in_or_catch
        c.in_or_catch = 2
        c.move_err_n = p.nodes[n].a
        c.move_of(p, p.nodes[n].a, ity, false)
        c.move_err_n = -1
        c.in_or_catch = saved_or
    } else {
        checker_set_i(mut &c.nstr, n, 1) // MIR keep
    }
    checker_set_i(mut &c.ntype, n, concrete)
    << concrete
}

fn (c &Checker) peel_map(ty int) int {
    mut t := c.direct_type(ty)
    if is_ref_type(t) {
        t = c.direct_type(t)
    }
    if is_map_type(t) {
        << t
    }
    << -1
}

fn (c &mut Checker) check_map_init_expr(p &parser.Parser, n int) int {
    if c.in_irq == 1 {
        c.fail_node(p, n, "cannot allocate in irq handler")
    }
    kty := c.type_of(p, p.nodes[n].a)
    vty := c.type_of(p, p.nodes[n].b)
    ty := c.intern_map_type(p, n, kty, vty)
    checker_set_i(mut &c.ncall, n, -89)
    checker_set_i(mut &c.ntype, n, ty)
    << ty
}

fn (c &mut Checker) check_expr(p &parser.Parser, n int) int {
    if n < 0 {
        << ERROR_TY
    }
    if c.fn_failed() {
        checker_set_i(mut &c.ntype, n, ERROR_TY)
        << ERROR_TY
    }
    k := p.nodes[n].kind
    if k == ast.NK_INT { // Int
        checker_set_i(mut &c.ntype, n, 1)
        << 1
    }
    if k == ast.NK_FLOAT { // Float
        checker_set_i(mut &c.ntype, n, 4)
        << 4
    }
    if k == ast.NK_CAST { // Cast
        << c.check_expr_cast_is_as(p, n)
    }
    if k == ast.NK_BOOL { // Bool
        checker_set_i(mut &c.ntype, n, 2)
        << 2
    }
    if k == ast.NK_STR { // Str literal: intern (first-seen order)
        idx := c.intern(p.nodes[n].sval)
        checker_set_i(mut &c.nstr, n, idx)
        checker_set_i(mut &c.ntype, n, 3)
        << 3
    }
    if k == ast.NK_IDENT { // Ident
        << c.check_expr_ident(p, n)
    }
    if k == ast.NK_BORROW { // Borrow
        << c.check_expr_borrow(p, n)
    }
    if k == ast.NK_CALL { // Call
        << c.check_call_expr(p, n)
    }
    if k == ast.NK_BIN_OP { // BinOp
        << c.check_binop_expr(p, n)
    }
    if k == ast.NK_STRUCT_INIT { // StructInit
        << c.check_struct_init_expr(p, n)
    }
    if k == ast.NK_FIELD { // obj.field — or module.Const (M9) / Color.Red (M15)
        << c.check_field_expr(p, n)
    }
    if k == ast.NK_METHOD_CALL { // obj.method(args) — or module.fn(args) (M9) / Color.Rgb(...) (M15)
        << c.check_method_expr(p, n)
    }
    if k == ast.NK_INDEX { // obj[index]
        << c.check_index_expr(p, n)
    }
    if k == ast.NK_MAP_INIT { // map[K]V{}
        << c.check_map_init_expr(p, n)
    }
    if k == ast.NK_ARRAY_LIT || k == ast.NK_EMPTY_ARRAY { // ArrayLit / EmptyArrayLit
        << c.check_expr_array_lit(p, n)
    }
    if k == ast.NK_SLICE { // s[a -< b] slice
        << c.check_expr_slice(p, n)
    }
    if k == ast.NK_UN_OP { // UnOp
        << c.check_expr_unop(p, n)
    }
    if k == ast.NK_CHAN_INIT || k == ast.NK_RECV { // ChanInit / Recv
        << c.check_expr_chan(p, n)
    }
    if k == ast.NK_OR_CATCH { // OrCatch
        << c.check_expr_or_try(p, n)
    }
    if k == ast.NT_FN_LIT { // nt_fn_lit (M109)
        << c.check_fn_lit(p, n)
    }
    if k == ast.NK_TYPE_IS || k == ast.NK_TYPE_AS { // nk_type_is / nk_type_as
        << c.check_expr_cast_is_as(p, n)
    }
    << c.fail_expr(p, n, "expression not supported yet (M6b2-s3a)")
}

// M110/M154: `obj.method` as a value — fat fn `(code*, env*)`.
// Value method on a value: Env{self:T}, code=method (ncall=-92).
// Mut method or temp method through &/&mut: Env{self:&T|&mut T} + trampoline
// (ncall=-95); trampoline calls the real method with env.self.
