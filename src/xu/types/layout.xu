@xu/types

// TypeLayout is the single layout seam for checker, promotion, emitter and
// RA. Callers that need more than one of slots/size/align/owning/ABI should
// take this struct instead of re-deriving the same facts. Specialized ABI
// adapters (hidden pointer, descriptor frame home) still consult abi_class.

pub const TY_ABI_GPR = 0
pub const TY_ABI_FP = 1
pub const TY_ABI_HANDLE = 2
pub const TY_ABI_POINTER = 3
pub const TY_ABI_VOID = 4

pub struct TypeLayout {
    pub slots int
    pub size_bytes int
    pub align_bytes int
    pub owning bool
    pub descriptor bool
    pub abi_class int
}

pub fn mir_type_abi_class(ty int) int {
    if ty == 0 { << TY_ABI_VOID }
    if ty == 4 { << TY_ABI_FP }
    if ty == 1 || ty == 2 || ty == 8 || ty == 9 || ty == 10 { << TY_ABI_GPR }
    if is_ref_type(ty) { << TY_ABI_HANDLE }
    if is_chan_type(ty) { << TY_ABI_HANDLE }
    if is_map_type(ty) { << TY_ABI_HANDLE }
    << TY_ABI_POINTER
}

pub fn (lay &TypeLayout) pass_by_value() bool {
    if lay.abi_class == TY_ABI_GPR { << true }
    if lay.abi_class == TY_ABI_FP { << true }
    if lay.abi_class == TY_ABI_HANDLE { << true }
    << false
}

pub fn (lay &TypeLayout) is_scalar() bool {
    if lay.abi_class == TY_ABI_GPR { << true }
    if lay.abi_class == TY_ABI_FP { << true }
    << false
}

pub fn (m &Mir) type_align_bytes(ty int) int {
    if ty == 10 { << 1 }
    if ty == 8 || ty == 9 { << 4 }
    if ty == 0 { << 1 }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < m.structs.len {
            al := m.structs[si].align_bytes
            if al < 1 { << 1 }
            << al
        }
    }
    << 8
}

pub fn (m &Mir) type_is_descriptor(ty int) bool {
    << mir_ty_is_descriptor(ty)
}

pub fn (m &Mir) type_layout(ty int) TypeLayout {
    << TypeLayout{
        slots: m.type_slots(ty),
        size_bytes: m.type_size_bytes(ty),
        align_bytes: m.type_align_bytes(ty),
        owning: m.type_owning(ty),
        descriptor: mir_ty_is_descriptor(ty),
        abi_class: mir_type_abi_class(ty)
    }
}

pub fn (c &Checker) type_layout(ty int) TypeLayout {
    << TypeLayout{
        slots: c.type_slots(ty),
        size_bytes: c.type_size_bytes(ty),
        align_bytes: c.type_align_bytes(ty),
        owning: c.type_owning(ty),
        descriptor: mir_ty_is_descriptor(ty),
        abi_class: mir_type_abi_class(ty)
    }
}
