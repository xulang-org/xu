@xu/types

#xu/ast
#xu/parser

pub const MIR_MAX_LAYOUT_WORDS = 1048576
pub const MIR_MAX_LAYOUT_BYTES = 8388608

pub const NCALL_RT_SYSCALL = -200
pub const NCALL_RT_LOAD = -201
pub const NCALL_RT_STORE = -202
pub const NCALL_RT_ADDR = -203
pub const NCALL_RT_GLOBALS = -204
pub const NCALL_C_CALLBACK = -205
pub const NCALL_C_CALLBACK_FREE = -206

pub const FFI_EXTERN = 256

pub fn mir_ty_is_descriptor(ty int) bool {
    if ty == 3 { << true }
    if is_array_type(ty) { << true }
    if is_map_type(ty) { << true }
    << false
}

pub fn b2i(b bool) int {
    if b { << 1 }
    << 0
}

// FFI flags of the declaration d (NK_FFI ival), or -1 when d has none.
pub fn ffi_decl_flags(p &parser.Parser, d int) int {
    $flags := -1
    for i in 0:p.ffi_nodes.len {
        f := p.ffi_nodes[i]
        if p.nodes[f].a == d {
            if flags < 0 { flags = 0 }
            flags = flags | p.nodes[f].ival
        }
    }
    << flags
}

// Custom alignment from @repr(align(N)) or @align(N), or 0 if default.
pub fn ffi_decl_align(p &parser.Parser, d int) int {
    for i in 0:p.ffi_nodes.len {
        f := p.ffi_nodes[i]
        if p.nodes[f].a == d {
            if p.nodes[f].c > 0 {
                << p.nodes[f].c
            }
        }
    }
    << 0
}

// NK_FFI node describing extern d, or -1.
pub fn ffi_node_of(p &parser.Parser, d int) int {
    for i in 0:p.ffi_nodes.len {
        f := p.ffi_nodes[i]
        if p.nodes[f].a == d && (p.nodes[f].ival & (ast.FFI_STRUCT | ast.FFI_UNSAFE_FN | ast.FFI_EXPORT | ast.FFI_BSS | ast.FFI_NORETURN | ast.FFI_SECTION)) == 0 { << f }
    }
    << -1
}

// Exported C/linker symbol name from @export("sym") or @no_mangle on fn decl d, or "".
pub fn ffi_export_symbol(p &parser.Parser, d int) string {
    for i in 0:p.ffi_nodes.len {
        f := p.ffi_nodes[i]
        if p.nodes[f].a == d && (p.nodes[f].ival & ast.FFI_EXPORT) != 0 {
            << p.nodes[f].sval + ""
        }
    }
    << ""
}

fn align_remainder_bytes(off int, align int) int {
    if align == 1 { << 0 }
    if align <= 1 || align > MIR_MAX_LAYOUT_BYTES { << -1 }
    if (align & (align - 1)) != 0 { << -1 }
    << off & (align - 1)
}

pub fn align_up_bytes(off int, align int) int {
    if off < 0 || off > MIR_MAX_LAYOUT_BYTES { << 0 }
    if align == 1 { << off }
    rem := align_remainder_bytes(off, align)
    if rem < 0 { << 0 }
    if rem == 0 { << off }
    delta := align - rem
    if delta <= 0 || off > MIR_MAX_LAYOUT_BYTES - delta { << 0 }
    << off + delta
}

pub fn type_name(t int) string {
    if is_indirect_ref_type(t) {
        if is_mut_ref_type(t) { << "\$&_" }
        << "&_"
    }
    if is_mut_ref_type(t) { << "\$&_" }
    if is_ref_type(t) { << "&_" }
    if is_raw_ptr_type(t) { << "*raw" }
    if t == 1 { << "int" }
    if t == 2 { << "bool" }
    if t == 3 { << "string" }
    if t == 4 { << "f64" }
    if t == 5 { << "Self" }
    if t == 8 { << "i32" }
    if t == 9 { << "u32" }
    if t == 10 { << "u8" }
    if t == 6 { << "c_ptr" }
    if t == 7 { << "i8" }
    if t == 11 { << "i16" }
    if t == 12 { << "u16" }
    if t == 13 { << "u64" }
    if t == 14 { << "f32" }
    if is_param_type(t) { << "T" + str(param_index(t)) }
    if is_struct_type(t) { << "struct" }
    if is_array_type(t) { << "array" }
    if is_throw_type(t) { << "throw" }
    if is_enum_type(t) { << "enum" }
    if is_chan_type(t) { << "chan" }
    if is_map_type(t) { << "map" }
    if is_fn_type(t) { << "fn" }
    if is_temp_type(t) { << "temp" }
    if is_any_type(t) { << "any" }
    if is_interface_type(t) { << "interface" }
    if is_error_type(t) { << "_" }
    << "void"
}

pub fn is_value_type(t int) bool {
    if t == 1 || t == 2 || t == 3 || t == 4 || t == 8 || t == 9 || t == 10 { << true }
    if t == 6 || t == 7 || t == 11 || t == 12 || t == 13 || t == 14 { << true }
    if is_raw_ptr_type(t) { << true }
    << is_param_type(t)
}

pub fn is_integer_type(t int) bool {
    << t == 1 || t == 8 || t == 9 || t == 10 || t == 7 || t == 11 || t == 12 || t == 13
}

pub fn is_float_type(t int) bool {
    << t == 4 || t == 14
}

pub fn deref_copy_ok(t int) bool {
    if is_integer_type(t) { << true }
    if t == 2 || t == 3 || t == 4 || t == 6 || t == 14 || is_raw_ptr_type(t) { << true }
    << false
}

pub fn elem_borrow_ok(t int) bool {
    if is_integer_type(t) { << true }
    if t == 2 || t == 3 || t == 4 || t == 6 || t == 14 { << true }
    if is_struct_type(t) { << true }
    if is_array_type(t) { << true }
    if is_map_type(t) { << true }
    << false
}

pub fn can_box_into_temp(t int) bool {
    if t == 0 { << false }
    if is_ref_type(t) { << false }
    << true
}

pub fn is_dynamic_box(t int) bool { << is_temp_type(t) || is_any_type(t) || is_interface_type(t) }

pub fn is_write_once_box(t int) bool { << is_temp_type(t) || is_any_type(t) }

pub fn is_linear_dynamic(t int) bool { << is_temp_type(t) }

pub fn is_as_box(t int) bool { << is_temp_type(t) || is_interface_type(t) }

pub fn temp_box_type_id(ty int) int {
    if ty == 1 { << ANY_TAG_INT }
    if ty == 2 { << ANY_TAG_BOOL }
    if ty == 3 { << ANY_TAG_STRING }
    if ty == 4 { << ANY_TAG_F64 }
    if ty == 8 { << ANY_TAG_I32 }
    if ty == 9 { << ANY_TAG_U32 }
    if ty == 10 { << ANY_TAG_U8 }
    if is_struct_type(ty) { << box_struct_tag(struct_index(ty)) }
    if is_enum_type(ty) { << ANY_TAG_ENUM_BASE + (enum_index(ty)) }
    if is_array_type(ty) { << ANY_TAG_ARRAY_BASE + (array_index(ty)) }
    if is_throw_type(ty) { << ANY_TAG_THROW_BASE + throw_index(ty) }
    if is_chan_type(ty) { << ANY_TAG_CHAN_BASE + (chan_index(ty)) }
    if is_map_type(ty) { << ANY_TAG_MAP_BASE + (map_index(ty)) }
    if is_fn_type(ty) { << ANY_TAG_FN_BASE + (fn_index(ty)) }
    if is_param_type(ty) { << ANY_TAG_PARAM_BASE + (param_index(ty)) }
    if is_temp_type(ty) || is_any_type(ty) || is_interface_type(ty) { << 0 - 1 }
    << 0 - 1
}

pub fn any_value_tag(ty int) int { << temp_box_type_id(ty) }

pub fn any_value_nslots(tag int) int {
    if tag == ANY_TAG_STRING { << 3 }
    << 1
}

pub fn any_itab_label(tag int) string {
    if tag == ANY_TAG_INT { << "_xu_any_ff01" }
    if tag == ANY_TAG_BOOL { << "_xu_any_ff02" }
    if tag == ANY_TAG_STRING { << "_xu_any_ff03" }
    if tag == ANY_TAG_F64 { << "_xu_any_ff04" }
    if tag == ANY_TAG_I32 { << "_xu_any_ff05" }
    if tag == ANY_TAG_U32 { << "_xu_any_ff06" }
    if tag == ANY_TAG_U8 { << "_xu_any_ff07" }
    if tag >= ANY_TAG_STRUCT_BASE && tag < ANY_TAG_STRUCT_BASE + TYPE_TABLE_LIMIT { << "_xu_any_s" + str(tag - ANY_TAG_STRUCT_BASE) }
    if tag >= ANY_TAG_ENUM_BASE && tag < ANY_TAG_ENUM_BASE + TYPE_TABLE_LIMIT {
        << "_xu_any_e" + str(tag - ANY_TAG_ENUM_BASE)
    }
    if tag >= ANY_TAG_ARRAY_BASE && tag < ANY_TAG_ARRAY_BASE + TYPE_TABLE_LIMIT {
        << "_xu_any_a" + str(tag - ANY_TAG_ARRAY_BASE)
    }
    if tag >= ANY_TAG_THROW_BASE && tag < ANY_TAG_THROW_BASE + TYPE_TABLE_LIMIT {
        << "_xu_any_th" + str(tag - ANY_TAG_THROW_BASE)
    }
    if tag >= ANY_TAG_CHAN_BASE && tag < ANY_TAG_CHAN_BASE + TYPE_TABLE_LIMIT {
        << "_xu_any_c" + str(tag - ANY_TAG_CHAN_BASE)
    }
    if tag >= ANY_TAG_MAP_BASE && tag < ANY_TAG_MAP_BASE + TYPE_TABLE_LIMIT {
        << "_xu_any_m" + str(tag - ANY_TAG_MAP_BASE)
    }
    if tag >= ANY_TAG_FN_BASE && tag < ANY_TAG_FN_BASE + TYPE_TABLE_LIMIT {
        << "_xu_any_f" + str(tag - ANY_TAG_FN_BASE)
    }
    if tag >= ANY_TAG_PARAM_BASE && tag < ANY_TAG_PARAM_BASE + TYPE_TABLE_LIMIT {
        << "_xu_any_p" + str(tag - ANY_TAG_PARAM_BASE)
    }
    << "_xu_any_unknown"
}

pub fn iface_itab_label(mod string, iface string, struct_name string) string {
    << "_xu_itab_" + mod + "_" + iface + "_" + struct_name
}

pub fn compound_ty_ok(aop int, ty int) int {
    if aop < 2 { << 1 }
    if aop == 6 {
        if is_integer_type(ty) { << 1 }
        << 0
    }
    if is_integer_type(ty) || is_float_type(ty) { << 1 }
    << 0
}

pub fn compound_ty_msg(aop int, expect int, got int) string {
    if aop == 6 {
        << "operator '%=' requires int operands, found " + type_name(expect) + " and " + type_name(got)
    }
    $op := "+="
    if aop == 3 { op = "-=" }
    if aop == 4 { op = "*=" }
    if aop == 5 { op = "/=" }
    << "operator '" + op + "' requires matching int or f64 operands, found " + type_name(expect) + " and " + type_name(got)
}
