@xu/types

// ARM32/RV32 int-width proof domain. Bounds are host i64 values, but all
// arithmetic is checked before it is performed. A top interval means the
// operation could not be bounded soundly.
pub const W32_MIN = -2147483648
pub const W32_MAX = 2147483647
const W32_CAP = 1099511627776 // 2^40; below the safe host-i64 product gate.

pub struct W32Iv {
    pub lo int
    pub hi int
    pub top bool
}

pub fn w32_top() W32Iv { << W32Iv{lo: 0, hi: 0, top: true} }

pub fn w32_iv(lo int, hi int) W32Iv {
    if lo > hi { << w32_top() }
    if lo < 0 - W32_CAP || hi > W32_CAP { << w32_top() }
    << W32Iv{lo: lo, hi: hi, top: false}
}

pub fn w32_full() W32Iv { << W32Iv{lo: W32_MIN, hi: W32_MAX, top: false} }
pub fn w32_const(c int) W32Iv { << w32_iv(c, c) }

pub fn w32_fits(x &W32Iv) bool {
    << !x.top && x.lo >= W32_MIN && x.hi <= W32_MAX
}

fn w32_min2(a int, b int) int { if a < b { << a } << b }
fn w32_max2(a int, b int) int { if a > b { << a } << b }

fn w32_abs(a int) int {
    if a < 0 { << 0 - a }
    << a
}

fn w32_add_safe(a int, b int, out $&int) bool {
    if b > 0 && a > W32_CAP - b { << false }
    if b < 0 && a < (0 - W32_CAP) - b { << false }
    *out = a + b
    << true
}

fn w32_sub_safe(a int, b int, out $&int) bool {
    if b > 0 && a < (0 - W32_CAP) + b { << false }
    if b < 0 && a > W32_CAP + b { << false }
    *out = a - b
    << true
}

fn w32_mul_safe(a int, b int, out $&int) bool {
    if a == 0 || b == 0 {
        *out = 0
        << true
    }
    aa := w32_abs(a)
    bb := w32_abs(b)
    if bb == 0 { << false }
    if aa > W32_CAP / bb { << false }
    *out = a * b
    << true
}

fn w32_pow2(n int, out $&int) bool {
    if n < 0 || n > 62 { << false }
    // This expression is only evaluated for n <= 40 in callers. Keep the
    // helper independent so a future caller cannot shift by an invalid count.
    *out = 1 << n
    << true
}

fn w32_div_safe(a int, b int, out $&int) bool {
    if b == 0 { << false }
    if a == W32_MIN && b == -1 { << false }
    *out = a / b
    << true
}

pub fn w32_join(a &W32Iv, b &W32Iv) W32Iv {
    if a.top || b.top { << w32_top() }
    << w32_iv(w32_min2(a.lo, b.lo), w32_max2(a.hi, b.hi))
}

// Widen only unstable sides. If a bound already escaped the representable
// domain, preserve top rather than wrapping it into a small interval.
pub fn w32_widen(old &W32Iv, new &W32Iv) W32Iv {
    if old.top || new.top { << w32_top() }
    if new.lo < W32_MIN || new.hi > W32_MAX { << w32_top() }
    $lo := old.lo
    $hi := old.hi
    if new.lo < old.lo { lo = W32_MIN }
    if new.hi > old.hi { hi = W32_MAX }
    if new.lo < (0 - W32_CAP) || new.hi > W32_CAP { << w32_top() }
    << w32_iv(lo, hi)
}

fn w32_mul_iv(a &W32Iv, b &W32Iv) W32Iv {
    if a.top || b.top { << w32_top() }
    $p1 := 0
    $p2 := 0
    $p3 := 0
    $p4 := 0
    if !w32_mul_safe(a.lo, b.lo, $&p1) || !w32_mul_safe(a.lo, b.hi, $&p2) ||
       !w32_mul_safe(a.hi, b.lo, $&p3) || !w32_mul_safe(a.hi, b.hi, $&p4) { << w32_top() }
    << w32_iv(w32_min2(w32_min2(p1, p2), w32_min2(p3, p4)),
              w32_max2(w32_max2(p1, p2), w32_max2(p3, p4)))
}

fn w32_abs_max(a &W32Iv) int {
    if a.top { << W32_CAP }
    << w32_max2(w32_abs(a.lo), w32_abs(a.hi))
}

pub fn w32_neg(a &W32Iv) W32Iv {
    if a.top { << w32_top() }
    $lo := 0
    $hi := 0
    if !w32_sub_safe(0, a.hi, $&lo) || !w32_sub_safe(0, a.lo, $&hi) { << w32_top() }
    << w32_iv(lo, hi)
}

fn w32_cmp_result() W32Iv { << w32_iv(0, 1) }

pub fn w32_binop(op int, a &W32Iv, b &W32Iv) W32Iv {
    if op >= 6 && op <= 13 { << w32_cmp_result() }
    // For signed 32-bit operands, OR/XOR remain signed 32-bit values. AND
    // with a known non-negative constant has a useful non-negative bound.
    if op == 14 {
        if !a.top && !b.top && b.lo == b.hi && b.lo >= 0 { << w32_iv(0, b.hi) }
        if !a.top && !b.top && a.lo == a.hi && a.lo >= 0 { << w32_iv(0, a.hi) }
        << w32_full()
    }
    if op == 15 || op == 16 { << w32_full() }
    if a.top || b.top { << w32_top() }
    $lo := 0
    $hi := 0
    if op == 1 {
        if !w32_add_safe(a.lo, b.lo, $&lo) || !w32_add_safe(a.hi, b.hi, $&hi) { << w32_top() }
        << w32_iv(lo, hi)
    }
    if op == 2 {
        if !w32_sub_safe(a.lo, b.hi, $&lo) || !w32_sub_safe(a.hi, b.lo, $&hi) { << w32_top() }
        << w32_iv(lo, hi)
    }
    if op == 3 { << w32_mul_iv(a, b) }
    if op == 4 {
        if a.lo <= W32_MIN && b.lo <= -1 && b.hi >= -1 { << w32_top() }
        if b.lo <= 0 && b.hi >= 0 { << w32_full() }
        $q1 := 0
        $q2 := 0
        $q3 := 0
        $q4 := 0
        if !w32_div_safe(a.lo, b.lo, $&q1) || !w32_div_safe(a.lo, b.hi, $&q2) ||
           !w32_div_safe(a.hi, b.lo, $&q3) || !w32_div_safe(a.hi, b.hi, $&q4) { << w32_top() }
        << w32_iv(w32_min2(w32_min2(q1, q2), w32_min2(q3, q4)),
                  w32_max2(w32_max2(q1, q2), w32_max2(q3, q4)))
    }
    if op == 5 {
        ma := w32_abs_max(a)
        mb := w32_abs_max(b)
        if mb == 0 { << w32_top() }
        bound := w32_min2(ma, mb - 1)
        $low := 0 - bound
        $high := bound
        if a.lo >= 0 { low = 0 }
        if a.hi <= 0 { high = 0 }
        << w32_iv(low, high)
    }
    if op == 17 {
        if a.lo == 0 && a.hi == 0 { << w32_const(0) }
        if b.lo < 0 || b.hi > 30 { << w32_top() }
        $sl := 0
        $sh := 0
        if !w32_pow2(b.lo, $&sl) || !w32_pow2(b.hi, $&sh) { << w32_top() }
        // Variable shifts may use any exponent in the interval. The extrema
        // of a signed interval times positive powers are sound bounds.
        left := w32_iv(sl, sh)
        << w32_mul_iv(a, &left)
    }
    if op == 18 {
        if b.lo < 0 || b.hi > 63 { << w32_top() }
        if b.lo == b.hi { << w32_iv(a.lo >> b.lo, a.hi >> b.lo) }
        q1 := a.lo >> b.lo
        q2 := a.lo >> b.hi
        q3 := a.hi >> b.lo
        q4 := a.hi >> b.hi
        << w32_iv(w32_min2(w32_min2(q1, q2), w32_min2(q3, q4)),
                  w32_max2(w32_max2(q1, q2), w32_max2(q3, q4)))
    }
    << w32_top()
}

// Narrow the left comparison operand on a taken branch. Unsupported and
// contradictory refinements leave the incoming interval unchanged.
pub fn w32_refine(op int, x &W32Iv, y &W32Iv, taken bool) W32Iv {
    if x.top || y.top { << W32Iv{lo: x.lo, hi: x.hi, top: x.top} }
    $o := op
    if !taken {
        if op == 6 { o = 7 }
        if op == 7 { o = 6 }
        if op == 8 { o = 11 }
        if op == 9 { o = 10 }
        if op == 10 { o = 9 }
        if op == 11 { o = 8 }
    }
    $lo := x.lo
    $hi := x.hi
    if o == 6 {
        lo = w32_max2(lo, y.lo)
        hi = w32_min2(hi, y.hi)
    }
    if o == 8 { hi = w32_min2(hi, y.hi - 1) }
    if o == 9 { hi = w32_min2(hi, y.hi) }
    if o == 10 { lo = w32_max2(lo, y.lo + 1) }
    if o == 11 { lo = w32_max2(lo, y.lo) }
    if lo > hi { << W32Iv{lo: x.lo, hi: x.hi, top: false} }
    << w32_iv(lo, hi)
}
