@xu/types

#xu/ast
#xu/parser

fn range_start_excl(ival int) bool {
    if ival == 2 { << true }
    if ival == 3 { << true }
    << false
}

fn range_end_excl(ival int) bool {
    if ival == 2 { << false }
    if ival == 4 { << false }
    << true
}

fn range_op_str(ival int) string {
    if ival == 2 { << ">-" }
    if ival == 3 { << ">-<" }
    if ival == 4 { << "--" }
    if ival == 1 { << "-<" }
    << ":"
}

fn range_ival_from_str(s string) int {
    if s == ">-" { << 2 }
    if s == ">-<" { << 3 }
    if s == "-<" { << 1 }
    if s == "--" { << 4 }
    if s == ":" { << 5 }
    << 0
}

fn match_range_display(lo int, hi int, spell string) string {
    if spell == ":" { << str(lo) + ":" + str(hi) }
    if spell.len == 0 {
        << str(lo) + " -- " + str(hi)
    }
    << str(lo) + " " + spell + " " + str(hi)
}

fn is_irq_name(name string) bool {
    if name.len < 5 {
        << false
    }
    if name[0] != 105 || name[1] != 114 || name[2] != 113 || name[3] != 95 {
        << false
    }
    if name.len == 4 {
        << false
    }
    for i in 4:name.len {
        ch := name[i]
        if ch < 48 || ch > 57 {
            << false
        }
    }
    << true
}

fn irq_safe_call(name string) bool {
    if name == "println" { << true }
    if name == "eprintln" { << true }
    if name == "volatile_store" { << true }
    if name == "volatile_store8" { << true }
    if name == "volatile_load" { << true }
    if name == "volatile_load8" { << true }
    if name == "raise_irq" { << true }
    << false
}

fn (c &Checker) is_const_int(p &parser.Parser, n int) bool {
    k := p.nodes[n].kind
    if k == ast.NK_INT {
        << true
    }
    if k == ast.NK_IDENT && c.nconst[n] >= 0 && c.ctypes[c.nconst[n]] == 1 {
        << true
    }
    if k == ast.NK_CAST {
        << c.is_const_int(p, p.nodes[n].a)
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 1 {
        << c.is_const_int(p, p.nodes[n].a)
    }
    << false
}

fn (c &Checker) const_int_value(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_INT {
        << p.nodes[n].ival
    }
    if k == ast.NK_IDENT && c.nconst[n] >= 0 {
        << c.civals[c.nconst[n]]
    }
    if k == ast.NK_CAST {
        << c.const_int_value(p, p.nodes[n].a)
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 1 {
        << 0 - c.const_int_value(p, p.nodes[n].a)
    }
    << 0
}

pub fn (c $&Checker) apply_test_mode() {
    c.test_mode = 1
}

pub fn (c $&Checker) apply_target(target_code int) {
    os := target_code / 10
    arch := target_code % 10
    if os != 3 {
        <<
    }
    c.freestanding = 1
    if arch == 2 {
        c.allow_mmio = 1
        c.mmio_lo = 0x40000000
        c.mmio_hi = 0x60000000
    }
    if arch == 3 {
        c.allow_mmio = 1
        c.mmio_lo = 0x10000000
        c.mmio_hi = 0x20000000
    }
    // arch 7 = Xtensa (ESP32 / E8). ESP32 memory map (soc.h v5.4):
    // DROM 0x3F400000-0x3F800000, DRAM 0x3FFAE000-0x40000000,
    // IRAM 0x40080000-0x400AA000, IROM 0x400D0000-0x40400000.
    // Peripheral blocks sit at 0x3FF00000 (DPORT) .. 0x3FFB0000.
    // Window spans DPORT through IROM so volatile_* can touch GPIO/UART/timers.
    if arch == 7 {
        c.allow_mmio = 1
        c.mmio_lo = 0x3FF00000
        c.mmio_hi = 0x40400000
    }
}

fn (c $&Checker) fail_at(line int, col int, msg string) {
    $prefix := ""
    if c.cur_file_name.len > 0 {
        prefix = c.cur_file_name + ":"
    }
    eprintln(prefix + str(line) + ":" + str(col) + ": error: " + msg)
    c.error_count += 1
    // Recovery callers do not all propagate ERROR_TY before using metadata.
    // Stop here so every error fails compilation before any invalid access.
    <<< 1
}

fn (c &Checker) fn_failed() bool {
    << c.error_count > c.fn_err_base
}

fn (c $&Checker) fail_expr(p &parser.Parser, n int, msg string) int {
    c.fail_node(p, n, msg)
    if n >= 0 && n < c.ntype.len {
        checker_set_i($&c.ntype, n, ERROR_TY)
    }
    << ERROR_TY
}

fn (c $&Checker) set_cur_file(p &parser.Parser, fid int) {
    c.cur_file = fid
    if fid >= 0 && fid < p.file_names.len {
        // Clone — do not move out of the parser's table (WoA x64: a moved-from
        // string slot can look like a huge cap and OOM on the next use).
        c.cur_file_name = p.file_names[fid] + ""
    }
}

fn (c $&Checker) fail_node(p &parser.Parser, n int, msg string) {
    $at := n
    if c.attr >= 0 {
        at = c.attr
    }
    if at < 0 || at >= p.nodes.len {
        c.fail_at(0, 0, msg)
        <<
    }
    c.fail_at(p.nodes[at].line, p.nodes[at].col, msg)
}

// Keep permission-aware display local to diagnostics. ty_display also builds
// generic instance names, whose behavior must not change in Phase A.
fn (c &Checker) diag_type_display(ty int) string {
    if is_ref_type(ty) {
        if is_mut_ref_type(ty) { << "\$&" + c.diag_type_display(c.ref_inner_type(ty)) }
        << "&" + c.diag_type_display(c.ref_inner_type(ty))
    }
    << c.ty_display(ty)
}

// Hints for rejected conversions. Supported Phase B local adjustments have
// already passed through coerce_to; type equality itself remains strict.
fn (c &Checker) borrow_type_hint(p &parser.Parser, n int, want int, got int) string {
    if !is_ref_type(want) || !is_ref_type(got) { << "" }
    if !c.same_type(c.ref_inner_type(want), c.ref_inner_type(got)) { << "" }
    if is_mut_ref_type(want) && !is_mut_ref_type(got) {
        << "\nnote: cannot obtain an exclusive writable borrow from a shared reference\nhelp: borrow mutably from the owner, after conflicting borrows end"
    }
    if !is_mut_ref_type(want) && is_mut_ref_type(got) {
        $hint := "\nnote: a shared reborrow temporarily freezes the writable reference"
        if p.nodes[n].kind == ast.NK_IDENT {
            << hint + "\nhelp: use &*" + p.nodes[n].sval + " to borrow the same value for reading"
        }
        << hint + "\nhelp: shared reborrowing currently requires a local reference name; bind the reference to a local first, if moving it is allowed"
    }
    << ""
}

fn binding_mut_help(name string) string {
    << "\nhelp: declare a mutable binding with '\$" + name + " := value'; assignment uses the plain name afterwards"
}

fn (c &Checker) shared_write_help(id int) string {
    $hint := "\nnote: cannot write through a shared reference; binding mutability and borrow permission are independent"
    if id >= 0 && c.lmut[id] != 0 {
        hint = hint + "\nnote: '\$" + c.lname[id] + "' allows rebinding the reference; it does not grant write access to the borrowed value"
    }
    << hint + "\nhelp: borrow mutably from the owner with '\$&owner', after conflicting borrows end"
}

// ===== M36 warning channel =====

fn (c $&Checker) warn_at(fid int, line int, col int, msg string) {
    c.warn_file.push(fid)
    c.warn_line.push(line)
    c.warn_col.push(col)
    c.warn_msg.push(msg)
}

fn (c $&Checker) warn_node(p &parser.Parser, n int, msg string) {
    c.warn_at(c.cur_file, p.nodes[n].line, p.nodes[n].col, msg)
}

// Print collected warnings as `path:line:col: warning: ...` to stderr.
// Never affects the exit code.
pub fn (c &Checker) emit_warnings(p &parser.Parser) {
    for i in 0:c.warn_msg.len {
        msg := c.warn_msg[i] + ""
        $prefix := ""
        fid := c.warn_file[i]
        if fid >= 0 && fid < p.file_names.len {
            prefix = p.file_names[fid] + ":"
        }
        eprintln(prefix + str(c.warn_line[i]) + ":" + str(c.warn_col[i]) + ": warning: " + msg)
    }
}

// ===== M36 v1 constant folding =====
// Mirrors xuhir `const_int_of`: folds Int literals, package consts, int(...)
// casts, unary `-`, and CHECKED binary arithmetic (overflow -> not foldable).
// It never looks at local single-assignment constants — those are read by
// `expr_int_value` (mirror of xuhir reading `known_ints`).

fn int_min_val() int { << 0 - 9223372036854775807 - 1 }
fn int_max_val() int { << 9223372036854775807 }

// Checked overflow / div-zero test for folding (mirror xuhir checked_*).
fn const_binop_ok(op int, a int, b int) bool {
    min := int_min_val()
    max := int_max_val()
    if op == 1 { // Add
        if b > 0 && a > max - b { << false }
        if b < 0 && a < min - b { << false }
        << true
    }
    if op == 2 { // Sub
        if b < 0 && a > max + b { << false }
        if b > 0 && a < min + b { << false }
        << true
    }
    if op == 3 { // Mul
        if b == 0 { << true }
        if a == 0 { << true }
        if a == 0 - 1 && b == min { << false }
        if b == 0 - 1 && a == min { << false }
        r := a * b
        << r / b == a
    }
    if op == 4 { // Div
        if b == 0 { << false }
        if a == min && b == 0 - 1 { << false }
        << true
    }
    if op == 5 { // Mod
        if b == 0 { << false }
        if a == min && b == 0 - 1 { << false }
        << true
    }
    << false
}

fn const_binop_value(op int, a int, b int) int {
    if op == 1 { << a + b }
    if op == 2 { << a - b }
    if op == 3 { << a * b }
    if op == 4 {
        if b == 0 { << 0 }
        if a == int_min_val() && b == 0 - 1 { << 0 }
        << a / b
    }
    if op == 5 {
        if b == 0 { << 0 }
        if a == int_min_val() && b == 0 - 1 { << 0 }
        << a % b
    }
    << 0
}

// Folds WITHOUT local single-assignment constants (mirror const_int_of).
fn (c &Checker) is_const_int_expr(p &parser.Parser, n int) bool {
    if n < 0 { << false }
    k := p.nodes[n].kind
    if k == ast.NK_INT { << true }
    if k == ast.NK_IDENT {
        << c.nconst[n] >= 0 && c.ctypes[c.nconst[n]] == 1
    }
    if k == ast.NK_CAST { << c.is_const_int_expr(p, p.nodes[n].a) }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 1 {
        if !c.is_const_int_expr(p, p.nodes[n].a) { << false }
        << c.const_int_expr_value(p, p.nodes[n].a) != int_min_val()
    }
    if k == ast.NK_BIN_OP {
        op := p.nodes[n].ival
        if op < 1 || op > 5 { << false }
        if !c.is_const_int_expr(p, p.nodes[n].a) || !c.is_const_int_expr(p, p.nodes[n].b) { << false }
        a := c.const_int_expr_value(p, p.nodes[n].a)
        b := c.const_int_expr_value(p, p.nodes[n].b)
        << const_binop_ok(op, a, b)
    }
    << false
}

fn (c &Checker) const_int_expr_value(p &parser.Parser, n int) int {
    if n < 0 { << 0 }
    k := p.nodes[n].kind
    if k == ast.NK_INT { << p.nodes[n].ival }
    if k == ast.NK_IDENT {
        if c.nconst[n] >= 0 && c.ctypes[c.nconst[n]] == 1 { << c.civals[c.nconst[n]] }
        << 0
    }
    if k == ast.NK_CAST { << c.const_int_expr_value(p, p.nodes[n].a) }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 1 {
        << 0 - c.const_int_expr_value(p, p.nodes[n].a)
    }
    if k == ast.NK_BIN_OP {
        << const_binop_value(p.nodes[n].ival, c.const_int_expr_value(p, p.nodes[n].a), c.const_int_expr_value(p, p.nodes[n].b))
    }
    << 0
}

// With local single-assignment constants (mirror xuhir expr_int_value).
fn (c &Checker) is_expr_int(p &parser.Parser, n int) bool {
    if c.is_const_int_expr(p, n) { << true }
    if n < 0 { << false }
    if p.nodes[n].kind == ast.NK_IDENT {
        lid := c.nlocal[n]
        if lid >= 0 && lid < c.lconst_ok.len && c.lconst_ok[lid] != 0 { << true }
        << false
    }
    // Fold `n*n` etc. when operands are tracked locals (not only AST consts).
    if p.nodes[n].kind == ast.NK_BIN_OP {
        op := p.nodes[n].ival
        if op < 1 || op > 5 { << false }
        if !c.is_expr_int(p, p.nodes[n].a) || !c.is_expr_int(p, p.nodes[n].b) { << false }
        a := c.expr_int_value(p, p.nodes[n].a)
        b := c.expr_int_value(p, p.nodes[n].b)
        << const_binop_ok(op, a, b)
    }
    << false
}

fn (c &Checker) expr_int_value(p &parser.Parser, n int) int {
    if n >= 0 && p.nodes[n].kind == ast.NK_IDENT {
        lid := c.nlocal[n]
        if lid >= 0 && lid < c.lconst_ok.len && c.lconst_ok[lid] != 0 { << c.lconst[lid] }
    }
    if n >= 0 && p.nodes[n].kind == ast.NK_BIN_OP {
        op := p.nodes[n].ival
        if op >= 1 && op <= 5 {
            if c.is_expr_int(p, p.nodes[n].a) && c.is_expr_int(p, p.nodes[n].b) {
                << const_binop_value(op, c.expr_int_value(p, p.nodes[n].a), c.expr_int_value(p, p.nodes[n].b))
            }
        }
    }
    << c.const_int_expr_value(p, n)
}

// Known length of an array/string expression (M36 v1): -1 if unknown.
// (mirror xuhir known_obj_len).
fn (c &Checker) known_len_of(p &parser.Parser, n int) int {
    if n < 0 { << -1 }
    k := p.nodes[n].kind
    if k == ast.NK_STR { << p.nodes[n].sval.len }
    if k == ast.NK_ARRAY_LIT {
        if p.nodes[n].ival > 0 {
            << p.nodes[n].ival
        }
        $cnt := 0
        $e := p.nodes[n].a
        while e >= 0 {
        cnt += 1
        e = p.nodes[e].next
        }
        << cnt
    }
    if k == ast.NK_EMPTY_ARRAY { << 0 }
    if k == ast.NK_IDENT {
        lid := c.nlocal[n]
        if lid >= 0 && lid < c.ltype.len {
            fl := c.array_fixed_len(c.direct_type(c.ltype[lid]))
            if fl > 0 { << fl }
        }
        if lid >= 0 && lid < c.llength_ok.len && c.llength_ok[lid] == 1 { << c.llength[lid] }
    }
    // `e.len` on a fixed array (or & [N]T).
    if k == ast.NK_FIELD && c.ncall[n] == -96 {
        << c.nlocal[n]
    }
    if k == ast.NK_FIELD && p.nodes[n].sval == "len" {
        ot := c.ntype[p.nodes[n].a]
        fl := c.array_fixed_len(c.direct_type(ot))
        if fl > 0 { << fl }
    }
    << -1
}

// Exact length, or a proved lower bound (llength_ok 2) for a local.
fn (c &Checker) known_len_lb_of(p &parser.Parser, n int) int {
    ln := c.known_len_of(p, n)
    if ln >= 0 || n < 0 || p.nodes[n].kind != ast.NK_IDENT { << ln }
    lid := c.nlocal[n]
    if lid >= 0 && lid < c.llength_ok.len && c.llength_ok[lid] == 2 { << c.llength[lid] }
    << -1
}

// M172: constant (or tracked) index proven < known length — emit may skip rt_oob.
// M176: also `for i in 0 -> a.len` induction (see M175 SPEC).
fn (c &Checker) index_bounds_proven(p &parser.Parser, arr int, idx int) bool {
    if c.index_bounds_by_induction(p, arr, idx) {
        << true
    }
    if c.index_bounds_by_affine(p, arr, idx) {
        << true
    }
    ln := c.known_len_lb_of(p, arr)
    if ln < 0 { << false }
    // MS6 A2: Ident with lub (e.g. `while i < n` → i ≤ n-1).
    ub := c.expr_int_ub(p, idx)
    if ub >= 0 && ub < ln {
        << true
    }
    if !c.is_expr_int(p, idx) { << false }
    iv := c.expr_int_value(p, idx)
    if iv < 0 { << false }
    << iv < ln
}

// Const scale of `i*n` / `n*i`; -1 if the other operand is not Ident.
fn (c &Checker) affine_mul_scale(p &parser.Parser, mul int) int {
    if mul < 0 || p.nodes[mul].kind != ast.NK_BIN_OP || p.nodes[mul].ival != 3 {
        << -1
    }
    ma := p.nodes[mul].a
    mb := p.nodes[mul].b
    if ma < 0 || mb < 0 {
        << -1
    }
    if c.is_expr_int(p, ma) && p.nodes[mb].kind == ast.NK_IDENT {
        << ma
    }
    if c.is_expr_int(p, mb) && p.nodes[ma].kind == ast.NK_IDENT {
        << mb
    }
    << -1
}

fn (c &Checker) affine_mul_var(p &parser.Parser, mul int) int {
    if mul < 0 || p.nodes[mul].kind != ast.NK_BIN_OP || p.nodes[mul].ival != 3 {
        << -1
    }
    ma := p.nodes[mul].a
    mb := p.nodes[mul].b
    if ma < 0 || mb < 0 {
        << -1
    }
    if c.is_expr_int(p, ma) && p.nodes[mb].kind == ast.NK_IDENT {
        << mb
    }
    if c.is_expr_int(p, mb) && p.nodes[ma].kind == ast.NK_IDENT {
        << ma
    }
    << -1
}

// `i*n+j` / `j+i*n` / `n*i+j` with i,j < n (lub) and known_len(arr) >= n*n.
fn (c &Checker) index_bounds_by_affine(p &parser.Parser, arr int, idx int) bool {
    if arr < 0 || idx < 0 { << false }
    if p.nodes[idx].kind != ast.NK_BIN_OP { << false }
    if p.nodes[idx].ival != 1 { << false } // Add
    la := p.nodes[idx].a
    lb := p.nodes[idx].b
    $i_n := -1
    $j_n := -1
    $n_n := -1
    $sc := c.affine_mul_scale(p, la)
    $vr := c.affine_mul_var(p, la)
    // (i*n)+j  or  (n*i)+j
    if sc >= 0 && vr >= 0 && lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT {
        n_n = sc
        i_n = vr
        j_n = lb
    }
    // j+(i*n)  or  j+(n*i)
    if i_n < 0 {
        sc = c.affine_mul_scale(p, lb)
        vr = c.affine_mul_var(p, lb)
        if sc >= 0 && vr >= 0 && la >= 0 && p.nodes[la].kind == ast.NK_IDENT {
            n_n = sc
            i_n = vr
            j_n = la
        }
    }
    if i_n < 0 || j_n < 0 || n_n < 0 { << false }
    if !c.is_expr_int(p, n_n) { << false }
    nv := c.expr_int_value(p, n_n)
    if nv <= 0 { << false }
    if !const_binop_ok(3, nv, nv) { << false }
    iu := c.expr_int_ub(p, i_n)
    ju := c.expr_int_ub(p, j_n)
    if iu < 0 || ju < 0 { << false }
    if iu >= nv || ju >= nv { << false }
    ln := c.known_len_lb_of(p, arr)
    if ln < 0 { << false }
    << ln >= nv * nv
}

// `while t < K { a.push(_); …; t = t + 1 }` with t==0 at entry → each a.len = K.
fn (c $&Checker) try_note_fill_len(p &parser.Parser, n int, t_zero int, len0 &[]int, len0_ok &[]int) {
    if t_zero == 0 { << }
    cond := p.nodes[n].a
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP { << }
    if p.nodes[cond].ival != 8 { << }
    lhs := p.nodes[cond].a
    rhs := p.nodes[cond].b
    if lhs < 0 || p.nodes[lhs].kind != ast.NK_IDENT { << }
    if !c.is_expr_int(p, rhs) { << }
    klen := c.expr_int_value(p, rhs)
    if klen < 0 { << }
    tlid := c.nlocal[lhs]
    if tlid < 0 { << }
    body := p.nodes[n].c
    last := c.last_stmt(p, body)
    if last < 0 { << }
    tname := c.lname[tlid] + ""
    if !c.assign_is_inc1(p, last, tname + "") { << }
    $s := body
    $lids := []int{}
    $npush := []int{}
    while s >= 0 {
        if s == last {
            s = p.nodes[s].next
            ->
        }
        if c.stmt_writes_name(p, s, tname + "") { << }
        $mc := s
        if p.nodes[s].kind == ast.NK_EXPR_STMT {
            mc = p.nodes[s].a
        }
        if mc < 0 || p.nodes[mc].kind != ast.NK_METHOD_CALL { << }
        if p.nodes[mc].sval != "push" { << }
        recv := p.nodes[mc].a
        if recv < 0 || p.nodes[recv].kind != ast.NK_IDENT { << }
        alid := c.nlocal[recv]
        if alid < 0 { << }
        $seen := false
        for i in 0:lids.len {
            if lids[i] == alid {
                seen = true
                npush[i] += 1
            }
        }
        if !seen {
            lids.push(alid)
            npush.push(1)
        }
        s = p.nodes[s].next
    }
    if lids.len == 0 { << }
    for i in 0:lids.len {
        alid := lids[i]
        if alid < 0 || alid >= c.llength_ok.len || alid >= len0_ok.len { << }
        if !const_binop_ok(3, klen, npush[i]) || !const_binop_ok(1, len0[alid], klen * npush[i]) { << }
    }
    // Each array grows by klen * pushes. An unknown start length leaves
    // only a lower bound (llength_ok 2): bounds-check elision may use it,
    // diagnostics that need the exact length may not.
    for i in 0:lids.len {
        alid := lids[i]
        add := klen * npush[i]
        if len0_ok[alid] == 0 {
            checker_set_i($&c.llength, alid, add)
            checker_set_i($&c.llength_ok, alid, 2)
        } else {
            checker_set_i($&c.llength, alid, len0[alid] + add)
            checker_set_i($&c.llength_ok, alid, len0_ok[alid])
        }
    }
    <<
}

// Bound of `while i < rhs`: `a.len`, or Ident `n` that is `a.len`.
fn (c &Checker) while_bound_array(p &parser.Parser, rhs int) int {
    alid := c.len_field_local(p, rhs)
    if alid >= 0 { << alid }
    nlid := c.ident_local(p, rhs)
    if nlid < 0 || nlid >= c.int_len_of.len { << -1 }
    << c.int_len_of[nlid]
}

// M175 c2: `end` is `a.len` for Ident `a` → local id; else -1.
fn (c &Checker) len_field_local(p &parser.Parser, n int) int {
    if n < 0 || p.nodes[n].kind != ast.NK_FIELD { << -1 }
    if p.nodes[n].sval != "len" { << -1 }
    $base := p.nodes[n].a
    // peel one Borrow
    if base >= 0 && p.nodes[base].kind == ast.NK_BORROW {
        base = p.nodes[base].a
    }
    if base < 0 || p.nodes[base].kind != ast.NK_IDENT { << -1 }
    << c.nlocal[base]
}

// M175 c1: literal int 0.
fn (c &Checker) literal_int_zero_val(p &parser.Parser, n int) bool {
    << n >= 0 && p.nodes[n].kind == ast.NK_INT && p.nodes[n].ival == 0
}

// Root local of an expression used as assign/index target (Ident / Field / Index / Borrow).
fn (c &Checker) expr_root_local_id(p &parser.Parser, n int) int {
    if n < 0 { << -1 }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT { << c.nlocal[n] }
    if k == ast.NK_BORROW { << c.expr_root_local_id(p, p.nodes[n].a) }
    if k == ast.NK_FIELD || k == ast.NK_INDEX { << c.expr_root_local_id(p, p.nodes[n].a) }
    << -1
}

// Ident name at root of expr (M175 C5 AST scan — body may lack nlocal yet).
fn (c &Checker) expr_root_name(p &parser.Parser, n int) string {
    if n < 0 { << "" }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT { << p.nodes[n].sval }
    if k == ast.NK_BORROW { << c.expr_root_name(p, p.nodes[n].a) }
    if k == ast.NK_FIELD || k == ast.NK_INDEX || k == ast.NK_METHOD_CALL || k == ast.NK_UN_OP { << c.expr_root_name(p, p.nodes[n].a) }
    << ""
}

// M175 C5: body writes local `lid` (assign / mutable method on that local).
// Uses local *name* (not nlocal) so it works before the body is checked.
fn (c &Checker) stmts_write_local(p &parser.Parser, head int, lid int) bool {
    if lid < 0 || lid >= c.lname.len { << false }
    << c.stmts_write_name(p, head, c.lname[lid])
}

fn (c &Checker) stmts_write_name(p &parser.Parser, head int, name string) bool {
    $s := head
    while s >= 0 {
        if c.stmt_writes_name(p, s, name) { << true }
        s = p.nodes[s].next
    }
    << false
}

fn (c &Checker) stmt_writes_name(p &parser.Parser, n int, name string) bool {
    k := p.nodes[n].kind
    if k == ast.NK_ASSIGN { // Assign
        tk := p.nodes[p.nodes[n].a].kind
        if tk == ast.NK_IDENT {
            << p.nodes[p.nodes[n].a].sval == name
        }
        if tk == ast.NK_UN_OP {
            << c.expr_root_name(p, p.nodes[n].a) == name
        }
        << false
    }
    if k == ast.NK_EXPR_STMT { // ExprStmt
        << c.stmt_writes_name(p, p.nodes[n].a, name)
    }
    if k == ast.NK_METHOD_CALL { // Method — any method on name (conservative C5)
        << c.expr_root_name(p, p.nodes[n].a) == name
    }
    if k == ast.NK_CALL { // Call
        << false
    }
    if k == ast.NK_IF { // If — branch list is .a (parse_if); .c is unused
        $br := p.nodes[n].a
        while br >= 0 {
            if c.stmts_write_name(p, p.nodes[br].b, name) { << true }
            br = p.nodes[br].next
        }
        << false
    }
    if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
        << c.stmts_write_name(p, p.nodes[n].c, name)
    }
    if k == ast.NK_MATCH { // Match
        $arm := p.nodes[n].b
        while arm >= 0 {
            if c.stmts_write_name(p, p.nodes[arm].c, name) { << true }
            arm = p.nodes[arm].next
        }
        << false
    }
    << false
}

fn (c $&Checker) induct_push(var_lid int, arr_lid int) {
    c.induct_var.push(var_lid)
    c.induct_arr.push(arr_lid)
}

fn (c $&Checker) induct_pop() {
    if c.induct_var.len == 0 { << }
    $nv := []int{}
    $na := []int{}
    for i in 0:c.induct_var.len - 1 {
        nv.push(c.induct_var[i])
        na.push(c.induct_arr[i])
    }
    c.induct_var = nv
    c.induct_arr = na
}

// Try to open induction for `for var in start -< end` body. Returns 1 if pushed.
fn (c $&Checker) try_induct_for(p &parser.Parser, n int, var_lid int) int {
    if range_start_excl(p.nodes[n].ival) { << 0 }
    if !range_end_excl(p.nodes[n].ival) { << 0 }
    $arr_lid := c.len_field_local(p, p.nodes[n].b)
    if arr_lid < 0 {
        nlid := c.ident_local(p, p.nodes[n].b)
        if nlid >= 0 && nlid < c.int_len_of.len {
            arr_lid = c.int_len_of[nlid]
        }
    }
    if arr_lid < 0 { << 0 }
    if c.stmts_write_local(p, p.nodes[n].c, arr_lid) { << 0 }
    c.induct_push(var_lid, arr_lid)
    << 1
}

// Exclusive upper bound of a for-range variable (`i <= ub` in the body),
// or -1 if start may be negative or the end is not a tracked int.
fn (c &Checker) for_range_var_ub(p &parser.Parser, n int) int {
    if n < 0 { << -1 }
    rk := p.nodes[n].ival
    lb := c.expr_int_lb(p, p.nodes[n].a)
    if lb < 0 { << -1 }
    if !c.is_expr_int(p, p.nodes[n].b) { << -1 }
    ev := c.expr_int_value(p, p.nodes[n].b)
    if range_end_excl(rk) {
        // Half-open `start:end` with end <= 0 runs zero times when start >= 0.
        // Handle this before end-1 so INT_MIN cannot wrap into a bogus bound.
        if ev <= 0 { << -1 }
        << ev - 1
    }
    if ev < 0 { << -1 }
    << ev
}

// check_fn resets ltype/lub to the function being checked. MIR lower runs
// after every function has been checked, so reload this function's locals
// or known_len_of / lub would see the last function's frame.
fn (c $&Checker) prepare_lower_fn(fi int) {
    $nloc := 0
    if fi >= 0 && fi < c.fnlocals.len {
        nloc = c.fnlocals[fi].len
    }
    $saved_len := []int{}
    $saved_len_ok := []int{}
    $saved_c := []int{}
    $saved_c_ok := []int{}
    if fi >= 0 && fi < c.fnllength.len {
        for j in 0:c.fnllength[fi].len {
            saved_len.push(c.fnllength[fi][j])
        }
    }
    if fi >= 0 && fi < c.fnllength_ok.len {
        for j in 0:c.fnllength_ok[fi].len {
            saved_len_ok.push(c.fnllength_ok[fi][j])
        }
    }
    if fi >= 0 && fi < c.fnlconst.len {
        for j in 0:c.fnlconst[fi].len {
            saved_c.push(c.fnlconst[fi][j])
        }
    }
    if fi >= 0 && fi < c.fnlconst_ok.len {
        for j in 0:c.fnlconst_ok[fi].len {
            saved_c_ok.push(c.fnlconst_ok[fi][j])
        }
    }
    c.ltype = []int{}
    c.lub = []int{}
    c.lub_ok = []int{}
    c.llength = []int{}
    c.llength_ok = []int{}
    c.lconst = []int{}
    c.lconst_ok = []int{}
    c.calias = []int{}
    for i in 0:nloc {
        ty := c.fnlocals[fi][i]
        c.ltype.push(ty)
        c.lub.push(0)
        c.lub_ok.push(0)
        c.llength.push(0)
        c.llength_ok.push(0)
        c.lconst.push(0)
        c.lconst_ok.push(0)
        c.calias.push(-1)
        inner := c.direct_type_m(ty)
        fl := c.array_fixed_len_m(inner)
        if fl > 0 {
            checker_set_i($&c.llength, i, fl)
            checker_set_i($&c.llength_ok, i, 1)
        } else if i < saved_len.len {
            checker_set_i($&c.llength, i, saved_len[i])
            $lok := 0
            if i < saved_len_ok.len {
                lok = saved_len_ok[i]
            }
            checker_set_i($&c.llength_ok, i, lok)
        }
        if i < saved_c.len {
            checker_set_i($&c.lconst, i, saved_c[i])
            $cok := 0
            if i < saved_c_ok.len {
                cok = saved_c_ok[i]
            }
            checker_set_i($&c.lconst_ok, i, cok)
        }
    }
}

fn (c &Checker) last_stmt(p &parser.Parser, head int) int {
    $s := head
    $last := -1
    while s >= 0 {
        last = s
        s = p.nodes[s].next
    }
    << last
}

// `i = i + 1` or `i += 1`.
fn (c &Checker) assign_is_inc1(p &parser.Parser, n int, name string) bool {
    if n < 0 || p.nodes[n].kind != ast.NK_ASSIGN { << false }
    t := p.nodes[n].a
    if p.nodes[t].kind != ast.NK_IDENT { << false }
    if p.nodes[t].sval != name { << false }
    aop := p.nodes[n].ival
    rhs := p.nodes[n].b
    if aop == 2 {
        << p.nodes[rhs].kind == ast.NK_INT && p.nodes[rhs].ival == 1
    }
    if aop != 1 { << false }
    if p.nodes[rhs].kind != ast.NK_BIN_OP { << false }
    if p.nodes[rhs].ival != 1 { << false }
    la := p.nodes[rhs].a
    lb := p.nodes[rhs].b
    if p.nodes[la].kind == ast.NK_IDENT && p.nodes[la].sval == name {
        if p.nodes[lb].kind == ast.NK_INT && p.nodes[lb].ival == 1 { << true }
    }
    if p.nodes[lb].kind == ast.NK_IDENT && p.nodes[lb].sval == name {
        if p.nodes[la].kind == ast.NK_INT && p.nodes[la].ival == 1 { << true }
    }
    << false
}

// Loop bodies mutate written locals; drop single-assignment proofs so
// `$i := 0; while … { a[i]; i += 1 }` does not treat `a[i]` as `a[0]`.
fn (c $&Checker) kill_lconst_written(p &parser.Parser, head int) {
    for i in 0:c.lconst_ok.len {
        if c.lconst_ok[i] != 0 {
            if c.stmts_write_name(p, head, c.lname[i] + "") {
                checker_set_i($&c.lconst_ok, i, 0)
                if i < c.calias.len {
                    checker_set_i($&c.calias, i, -1)
                }
            }
        }
    }
    for i in 0:c.lub_ok.len {
        if c.lub_ok[i] != 0 {
            if c.stmts_write_name(p, head, c.lname[i] + "") {
                checker_set_i($&c.lub_ok, i, 0)
            }
        }
    }
    for i in 0:c.lnz_ok.len {
        if c.lnz_ok[i] != 0 {
            if c.stmts_write_name(p, head, c.lname[i] + "") {
                checker_set_i($&c.lnz_ok, i, 0)
            }
        }
    }
    for i in 0:c.calias.len {
        if c.calias[i] >= 0 {
            if c.stmts_write_name(p, head, c.lname[i] + "") {
                checker_set_i($&c.calias, i, -1)
            }
        }
    }
}

// MS6 A2: `x <= K` / `x < K` / `K >= x` / `K > x` → local id, or -1.
fn (c &Checker) le_ub_local(p &parser.Parser, n int) int {
    if n < 0 || p.nodes[n].kind != ast.NK_BIN_OP {
        << -1
    }
    op := p.nodes[n].ival
    la := p.nodes[n].a
    lb := p.nodes[n].b
    if op == 9 || op == 8 { // <= or <
        if la >= 0 && p.nodes[la].kind == ast.NK_IDENT && c.is_expr_int(p, lb) {
            << c.nlocal[la]
        }
    }
    if op == 11 || op == 10 { // >= or >
        if lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT && c.is_expr_int(p, la) {
            << c.nlocal[lb]
        }
    }
    << -1
}

fn (c &Checker) le_ub_value(p &parser.Parser, n int) int {
    if n < 0 || p.nodes[n].kind != ast.NK_BIN_OP {
        << 0
    }
    op := p.nodes[n].ival
    la := p.nodes[n].a
    lb := p.nodes[n].b
    if op == 9 || op == 8 {
        if la >= 0 && p.nodes[la].kind == ast.NK_IDENT && c.is_expr_int(p, lb) {
            k := c.expr_int_value(p, lb)
            if op == 8 {
                << k - 1
            }
            << k
        }
    }
    if op == 11 || op == 10 {
        if lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT && c.is_expr_int(p, la) {
            k := c.expr_int_value(p, la)
            if op == 10 {
                << k - 1
            }
            << k
        }
    }
    << 0
}

struct LowerLub {
    lid  int
    had  int
    prev int
}

// Ident on the compared side of `<` / `<=` / `>` / `>=`. Unlike
// le_ub_local this does not require the other side to be a tracked const
// (`while i < n` with n a param must still drop i's init const).
fn (c &Checker) cond_lhs_local(p &parser.Parser, n int) int {
    if n < 0 || p.nodes[n].kind != ast.NK_BIN_OP {
        << -1
    }
    op := p.nodes[n].ival
    la := p.nodes[n].a
    lb := p.nodes[n].b
    if op == 8 || op == 9 {
        if la >= 0 && p.nodes[la].kind == ast.NK_IDENT {
            << c.nlocal[la]
        }
    }
    if op == 10 || op == 11 {
        if lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT {
            << c.nlocal[lb]
        }
    }
    << -1
}

fn (c $&Checker) lower_kill_ident_const(lid int) {
    if lid >= 0 && lid < c.lconst_ok.len {
        checker_set_i($&c.lconst_ok, lid, 0)
    }
}

// Drop init consts of Ident assign targets in a statement list (and nested
// loops/ifs). Uses nlocal, not lname — prepare_lower_fn does not restore
// names, so kill_lconst_written is check-time only.
fn (c $&Checker) lower_kill_assigns(p &parser.Parser, head int) {
    $s := head
    for _ in 0:p.nodes.len {
        if s < 0 {
            <-
        }
        k := p.nodes[s].kind
        if k == ast.NK_ASSIGN {
            t := p.nodes[s].a
            if t >= 0 && p.nodes[t].kind == ast.NK_IDENT {
                c.lower_kill_ident_const(c.nlocal[t])
            }
        } else if k == ast.NK_IF {
            // If.a is the branch list (not .b).
            $br := p.nodes[s].a
            for _ in 0:p.nodes.len {
                if br < 0 {
                    <-
                }
                c.lower_kill_assigns(p, p.nodes[br].b)
                br = p.nodes[br].next
            }
        } else if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
            c.lower_kill_assigns(p, p.nodes[s].c)
        }
        s = p.nodes[s].next
    }
}

// Lowering-time `i < n` lub so affine `i*n+j` still proves after check
// restores the pre-loop bound.
fn (c $&Checker) lower_lub_enter(p &parser.Parser, cond int) LowerLub {
    $s := LowerLub{lid: -1, had: 0, prev: 0}
    var_lid := c.cond_lhs_local(p, cond)
    c.lower_kill_ident_const(var_lid)
    lid := c.le_ub_local(p, cond)
    if lid < 0 || lid >= c.lub_ok.len {
        << s
    }
    s.lid = lid
    if c.lub_ok[lid] != 0 {
        s.had = 1
    }
    s.prev = c.lub[lid]
    c.note_lub(lid, c.le_ub_value(p, cond))
    << s
}

fn (c $&Checker) lower_for_range_lub_enter(p &parser.Parser, n int, var_lid int) LowerLub {
    $s := LowerLub{lid: -1, had: 0, prev: 0}
    // Increment is compiler-generated, not an AST assign. Always drop
    // the var's init const even when the end bound is not a tracked int.
    c.lower_kill_ident_const(var_lid)
    ub := c.for_range_var_ub(p, n)
    if ub < 0 || var_lid < 0 || var_lid >= c.lub_ok.len {
        << s
    }
    s.lid = var_lid
    if c.lub_ok[var_lid] != 0 {
        s.had = 1
    }
    s.prev = c.lub[var_lid]
    if var_lid < c.lconst_ok.len {
        checker_set_i($&c.lconst_ok, var_lid, 0)
    }
    c.note_lub(var_lid, ub)
    << s
}

fn (c $&Checker) lower_lub_leave(s LowerLub) {
    if s.lid < 0 || s.lid >= c.lub_ok.len {
        <<
    }
    if s.had == 1 {
        checker_set_i($&c.lub, s.lid, s.prev)
        checker_set_i($&c.lub_ok, s.lid, 1)
    } else {
        checker_set_i($&c.lub_ok, s.lid, 0)
    }
}

fn (c $&Checker) note_lub(lid int, ub int) {
    if lid < 0 || lid >= c.lub.len {
        <<
    }
    if c.lub_ok[lid] != 0 {
        if ub < c.lub[lid] {
            checker_set_i($&c.lub, lid, ub)
        }
    } else {
        checker_set_i($&c.lub, lid, ub)
        checker_set_i($&c.lub_ok, lid, 1)
    }
}

fn (c $&Checker) apply_le_ub(p &parser.Parser, cond int) {
    lid := c.le_ub_local(p, cond)
    if lid >= 0 {
        c.note_lub(lid, c.le_ub_value(p, cond))
    }
}

// M36 W2: guard `if x <= 0 { << }` / `if x == 0 { << }` / `if x < 1 { << }`
// returns local id of the proven-nonzero variable, or -1.
fn (c &Checker) guard_zero_local(p &parser.Parser, cond int) int {
    if cond < 0 { << -1 }
    k := p.nodes[cond].kind
    if k != ast.NK_BIN_OP { << -1 }
    op := p.nodes[cond].ival
    la := p.nodes[cond].a
    lb := p.nodes[cond].b
    // x == 0  or  0 == x
    if op == 6 {
        if la >= 0 && p.nodes[la].kind == ast.NK_IDENT && c.literal_int_zero(p, lb) { << c.nlocal[la] }
        if lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT && c.literal_int_zero(p, la) { << c.nlocal[lb] }
    }
    // x <= 0
    if op == 9 && la >= 0 && p.nodes[la].kind == ast.NK_IDENT && c.literal_int_zero(p, lb) { << c.nlocal[la] }
    // x <= 1  (remaining x >= 2; align_up / pad-to-n)
    if op == 9 && la >= 0 && p.nodes[la].kind == ast.NK_IDENT && lb >= 0 && p.nodes[lb].kind == ast.NK_INT && p.nodes[lb].ival == 1 { << c.nlocal[la] }
    // x < 1
    if op == 8 && la >= 0 && p.nodes[la].kind == ast.NK_IDENT && lb >= 0 && p.nodes[lb].kind == ast.NK_INT && p.nodes[lb].ival == 1 { << c.nlocal[la] }
    // 0 >= x
    if op == 11 && lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT && c.literal_int_zero(p, la) { << c.nlocal[lb] }
    // 1 > x
    if op == 10 && lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT && la >= 0 && p.nodes[la].kind == ast.NK_INT && p.nodes[la].ival == 1 { << c.nlocal[lb] }
    << -1
}

// Then-arm of `if x != 0` / `if x > 0` / `if x >= 1`: x is nonzero in the arm.
fn (c &Checker) then_nonzero_local(p &parser.Parser, cond int) int {
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP { << -1 }
    op := p.nodes[cond].ival
    la := p.nodes[cond].a
    lb := p.nodes[cond].b
    if op == 7 {
        if la >= 0 && p.nodes[la].kind == ast.NK_IDENT && c.literal_int_zero(p, lb) { << c.nlocal[la] }
        if lb >= 0 && p.nodes[lb].kind == ast.NK_IDENT && c.literal_int_zero(p, la) { << c.nlocal[lb] }
    }
    if op == 10 && la >= 0 && p.nodes[la].kind == ast.NK_IDENT && c.literal_int_zero(p, lb) { << c.nlocal[la] }
    if op == 11 && la >= 0 && p.nodes[la].kind == ast.NK_IDENT && lb >= 0 && p.nodes[lb].kind == ast.NK_INT && p.nodes[lb].ival == 1 { << c.nlocal[la] }
    << -1
}

// M36 W2: guard on field access `if m.cap <= 0 { << }`.
// Returns receiver local id or -1.
fn (c &Checker) guard_zero_field_recv(p &parser.Parser, cond int) int {
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP { << -1 }
    op := p.nodes[cond].ival
    la := p.nodes[cond].a
    lb := p.nodes[cond].b
    $fnode := -1
    // field == 0  /  field <= 0
    if op == 6 || op == 9 {
        if la >= 0 && p.nodes[la].kind == ast.NK_FIELD && c.literal_int_zero(p, lb) { fnode = la }
    }
    // field < 1
    if op == 8 {
        if la >= 0 && p.nodes[la].kind == ast.NK_FIELD && lb >= 0 && p.nodes[lb].kind == ast.NK_INT && p.nodes[lb].ival == 1 { fnode = la }
    }
    if fnode < 0 { << -1 }
    recv := p.nodes[fnode].a
    if recv < 0 || p.nodes[recv].kind != ast.NK_IDENT { << -1 }
    << c.nlocal[recv]
}

// M36 W2: field name from a guard condition (call after guard_zero_field_recv).
fn (c &Checker) guard_zero_field_name(p &parser.Parser, cond int) string {
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP { << "" }
    op := p.nodes[cond].ival
    la := p.nodes[cond].a
    $fnode := -1
    if op == 6 || op == 9 || op == 8 {
        if la >= 0 && p.nodes[la].kind == ast.NK_FIELD { fnode = la }
    }
    if fnode < 0 { << "" }
    << p.nodes[fnode].sval
}

fn (c $&Checker) note_nonzero(lid int) {
    if lid < 0 || lid >= c.lnz_ok.len { << }
    checker_set_i($&c.lnz, lid, 1)
    checker_set_i($&c.lnz_ok, lid, 1)
}

fn (c $&Checker) note_field_nonzero(recv int, name string) {
    if recv < 0 { << }
    c.fnz_recv.push(recv)
    c.fnz_name.push(name)
}

fn (c &Checker) is_local_nonzero(lid int) bool {
    if lid < 0 || lid >= c.lnz_ok.len { << false }
    << c.lnz_ok[lid] != 0
}

fn (c &Checker) is_field_nonzero(recv int, name string) bool {
    if recv < 0 { << false }
    for i in 0:c.fnz_recv.len {
        if c.fnz_recv[i] == recv && c.fnz_name[i] == name {
            << true
        }
    }
    << false
}

fn (c &Checker) while_is_induct(n int) bool {
    for i in 0:c.winduct.len {
        if c.winduct[i] == n { << true }
    }
    << false
}

// `while i < a.len { …; i = i + 1 }` with i known 0 at entry.
fn (c $&Checker) try_induct_while(p &parser.Parser, n int) int {
    cond := p.nodes[n].a
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP { << 0 }
    if p.nodes[cond].ival != 8 { << 0 }
    lhs := p.nodes[cond].a
    rhs := p.nodes[cond].b
    if lhs < 0 || p.nodes[lhs].kind != ast.NK_IDENT { << 0 }
    ilid := c.nlocal[lhs]
    if ilid < 0 { << 0 }
    if ilid >= c.lconst_ok.len || c.lconst_ok[ilid] == 0 || c.lconst[ilid] != 0 { << 0 }
    alid := c.while_bound_array(p, rhs)
    if alid < 0 { << 0 }
    body := p.nodes[n].c
    if c.stmts_write_local(p, body, alid) { << 0 }
    last := c.last_stmt(p, body)
    if last < 0 { << 0 }
    iname := c.lname[ilid] + ""
    if !c.assign_is_inc1(p, last, iname + "") { << 0 }
    $s := body
    while s >= 0 {
        if s != last {
            if c.stmt_writes_name(p, s, iname + "") { << 0 }
        }
        s = p.nodes[s].next
    }
    c.induct_push(ilid, alid)
    c.winduct.push(n)
    << 1
}

fn (c &Checker) ident_local(p &parser.Parser, n int) int {
    if n < 0 || p.nodes[n].kind != ast.NK_IDENT {
        << -1
    }
    << c.nlocal[n]
}

// `lo + ((hi - lo) >> 1)` / `((hi - lo) >> 1) + lo`
fn (c &Checker) expr_is_midpoint(p &parser.Parser, n int, lo int, hi int) bool {
    if n < 0 || p.nodes[n].kind != ast.NK_BIN_OP || p.nodes[n].ival != 1 {
        << false
    }
    la := p.nodes[n].a
    lb := p.nodes[n].b
    if c.ident_local(p, la) == lo && c.expr_is_half_span(p, lb, lo, hi) {
        << true
    }
    if c.ident_local(p, lb) == lo && c.expr_is_half_span(p, la, lo, hi) {
        << true
    }
    << false
}

fn (c &Checker) expr_is_half_span(p &parser.Parser, n int, lo int, hi int) bool {
    if n < 0 || p.nodes[n].kind != ast.NK_BIN_OP || p.nodes[n].ival != 18 {
        << false
    }
    sh := p.nodes[n].b
    if sh < 0 || p.nodes[sh].kind != ast.NK_INT || p.nodes[sh].ival != 1 {
        << false
    }
    sub := p.nodes[n].a
    if sub < 0 || p.nodes[sub].kind != ast.NK_BIN_OP || p.nodes[sub].ival != 2 {
        << false
    }
    if c.ident_local(p, p.nodes[sub].a) != hi {
        << false
    }
    if c.ident_local(p, p.nodes[sub].b) != lo {
        << false
    }
    << true
}

fn (c $&Checker) maybe_binsearch_mid(p &parser.Parser, let_n int, mid int) {
    if c.cur_while < 0 || mid < 0 {
        <<
    }
    wn := c.cur_while
    cond := p.nodes[wn].a
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP || p.nodes[cond].ival != 8 {
        <<
    }
    lo := c.ident_local(p, p.nodes[cond].a)
    hi := c.ident_local(p, p.nodes[cond].b)
    if lo < 0 || hi < 0 || hi >= c.int_len_of.len {
        <<
    }
    arr := c.int_len_of[hi]
    if arr < 0 {
        <<
    }
    if c.bs_ok == 0 {
        <<
    }
    if !c.expr_is_midpoint(p, p.nodes[let_n].a, lo, hi) {
        <<
    }
    c.induct_push(mid, arr)
    c.wsearch.push(wn)
    c.wsearch_mid.push(mid)
    c.wsearch_arr.push(arr)
}

fn (c &Checker) index_bounds_by_induction(p &parser.Parser, arr int, idx int) bool {
    if arr < 0 || idx < 0 { << false }
    // peel Borrow on arr
    $abase := arr
    if p.nodes[abase].kind == ast.NK_BORROW {
        abase = p.nodes[abase].a
    }
    if p.nodes[abase].kind != ast.NK_IDENT { << false }
    if p.nodes[idx].kind != ast.NK_IDENT { << false }
    alid := c.nlocal[abase]
    ilid := c.nlocal[idx]
    if alid < 0 || ilid < 0 { << false }
    for i in 0:c.induct_var.len {
        if c.induct_var[i] == ilid && c.induct_arr[i] == alid {
            << true
        }
    }
    // One hop: `j := i` / `j = i` (do not chain).
    if ilid < c.calias.len {
        alid2 := c.calias[ilid]
        if alid2 >= 0 {
            for i in 0:c.induct_var.len {
                if c.induct_var[i] == alid2 && c.induct_arr[i] == alid {
                    << true
                }
            }
        }
    }
    << false
}

// Literal zero divisor (M36 E1): Int 0 or unary negation of Int 0. a folded
// expression like `0 - 0` is not a literal zero (mirror xuhir literal_int_zero).
fn (c &Checker) literal_int_zero(p &parser.Parser, n int) bool {
    if n < 0 { << false }
    k := p.nodes[n].kind
    if k == ast.NK_INT { << p.nodes[n].ival == 0 }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 1 {
        a := p.nodes[n].a
        if a >= 0 && p.nodes[a].kind == ast.NK_INT { << p.nodes[a].ival == 0 }
    }
    << false
}

// Literal non-zero divisor (M36 W2 exemption, mirror xuhir literal_int_nonzero).
fn (c &Checker) literal_int_nonzero(p &parser.Parser, n int) bool {
    if n < 0 { << false }
    k := p.nodes[n].kind
    if k == ast.NK_INT { << p.nodes[n].ival != 0 }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 1 {
        a := p.nodes[n].a
        if a >= 0 && p.nodes[a].kind == ast.NK_INT { << p.nodes[a].ival != 0 }
    }
    << false
}

struct IntRange {
    ok int
    lo int
    hi int
}

// Conservative integer interval analysis for static non-zero divisor proof.
// Handles constants, known lengths, `a % m`, `a & mask`, `a | mask`, and
// checked `+`, `-`, `*`, and unary `-`.
fn (c &Checker) expr_int_bounds(p &parser.Parser, n int, depth int) IntRange {
    if n < 0 || depth > 8 { << IntRange{ok: 0, lo: 0, hi: 0} }
    if c.is_expr_int(p, n) {
        v := c.expr_int_value(p, n)
        << IntRange{ok: 1, lo: v, hi: v}
    }
    k := p.nodes[n].kind
    if k == ast.NK_FIELD && p.nodes[n].sval == "len" {
        ln := c.known_len_of(p, n)
        if ln >= 0 { << IntRange{ok: 1, lo: ln, hi: ln} }
        << IntRange{ok: 0, lo: 0, hi: 0}
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 1 {
        sub := c.expr_int_bounds(p, p.nodes[n].a, depth + 1)
        if sub.ok == 1 && sub.lo != int_min_val() && sub.hi != int_min_val() {
            << IntRange{ok: 1, lo: 0 - sub.hi, hi: 0 - sub.lo}
        }
        << IntRange{ok: 0, lo: 0, hi: 0}
    }
    if k == ast.NK_BIN_OP {
        op := p.nodes[n].ival
        la := p.nodes[n].a
        lb := p.nodes[n].b
        if op == 5 { // Mod: a % m
            if c.is_expr_int(p, lb) {
                $m := c.expr_int_value(p, lb)
                if m != 0 && m != int_min_val() {
                    if m < 0 { m = 0 - m }
                    rmax := m - 1
                    ba := c.expr_int_bounds(p, la, depth + 1)
                    if ba.ok == 1 && ba.lo >= 0 {
                        << IntRange{ok: 1, lo: 0, hi: rmax}
                    }
                    << IntRange{ok: 1, lo: 0 - rmax, hi: rmax}
                }
            }
            << IntRange{ok: 0, lo: 0, hi: 0}
        }
        if op == 14 { // BitAnd: a & mask
            if c.is_expr_int(p, lb) {
                mask := c.expr_int_value(p, lb)
                if mask >= 0 { << IntRange{ok: 1, lo: 0, hi: mask} }
            }
            if c.is_expr_int(p, la) {
                mask := c.expr_int_value(p, la)
                if mask >= 0 { << IntRange{ok: 1, lo: 0, hi: mask} }
            }
            << IntRange{ok: 0, lo: 0, hi: 0}
        }
        if op == 15 { // BitOr: a | mask
            ba := c.expr_int_bounds(p, la, depth + 1)
            bb := c.expr_int_bounds(p, lb, depth + 1)
            if ba.ok == 1 && bb.ok == 1 && ba.lo >= 0 && bb.lo >= 0 {
                $lo := ba.lo
                if bb.lo > lo { lo = bb.lo }
                $hi := ba.hi
                if bb.hi > hi { hi = bb.hi }
                if const_binop_ok(1, ba.hi, bb.hi) {
                    << IntRange{ok: 1, lo: lo, hi: ba.hi + bb.hi}
                }
            }
            << IntRange{ok: 0, lo: 0, hi: 0}
        }
        if op == 3 { // Mul
            ba := c.expr_int_bounds(p, la, depth + 1)
            bb := c.expr_int_bounds(p, lb, depth + 1)
            if ba.ok == 1 && bb.ok == 1 && ba.lo >= 0 && bb.lo >= 0 {
                if const_binop_ok(3, ba.lo, bb.lo) && const_binop_ok(3, ba.hi, bb.hi) {
                    << IntRange{ok: 1, lo: ba.lo * bb.lo, hi: ba.hi * bb.hi}
                }
            }
            << IntRange{ok: 0, lo: 0, hi: 0}
        }
        if op == 1 { // Add
            ba := c.expr_int_bounds(p, la, depth + 1)
            bb := c.expr_int_bounds(p, lb, depth + 1)
            if ba.ok == 1 && bb.ok == 1 {
                if const_binop_ok(1, ba.lo, bb.lo) && const_binop_ok(1, ba.hi, bb.hi) {
                    << IntRange{ok: 1, lo: ba.lo + bb.lo, hi: ba.hi + bb.hi}
                }
            }
            << IntRange{ok: 0, lo: 0, hi: 0}
        }
        if op == 2 { // Sub
            ba := c.expr_int_bounds(p, la, depth + 1)
            bb := c.expr_int_bounds(p, lb, depth + 1)
            if ba.ok == 1 && bb.ok == 1 {
                if const_binop_ok(2, ba.lo, bb.hi) && const_binop_ok(2, ba.hi, bb.lo) {
                    << IntRange{ok: 1, lo: ba.lo - bb.hi, hi: ba.hi - bb.lo}
                }
            }
            << IntRange{ok: 0, lo: 0, hi: 0}
        }
    }
    << IntRange{ok: 0, lo: 0, hi: 0}
}

pub fn (c &Checker) expr_int_range_nonzero(p &parser.Parser, n int) bool {
    r := c.expr_int_bounds(p, n, 0)
    if r.ok == 0 { << false }
    << r.lo > 0 || r.hi < 0
}

// M36 E1/E2/W2 on an int div/mod binop. `at` is the diagnostic node, `lhs`/`rhs`
// the dividend/divisor AST nodes.
fn (c $&Checker) check_int_div(p &parser.Parser, at int, lhs int, rhs int) {
    // E1: literal zero divisor.
    if c.literal_int_zero(p, rhs) {
        c.fail_node(p, at, "division by zero (constant divisor)")
        <<
    }
    // E2: constant INT_MIN / -1 (both operands fold, incl. locals).
    if c.is_expr_int(p, lhs) && c.is_expr_int(p, rhs) {
        lv := c.expr_int_value(p, lhs)
        rv := c.expr_int_value(p, rhs)
        if lv == int_min_val() && rv == 0 - 1 {
            c.fail_node(p, at, "division overflow (INT_MIN / -1)")
            <<
        }
    }
    // W2: divisor not proven non-zero (literal, foldable, range-proven, or guarded).
    literal_nz := c.literal_int_nonzero(p, rhs)
    folded_nz := (c.is_expr_int(p, rhs) && c.expr_int_value(p, rhs) != 0) || c.expr_int_range_nonzero(p, rhs)
    $guarded_nz := false
    if !literal_nz && !folded_nz && rhs >= 0 {
        if p.nodes[rhs].kind == ast.NK_IDENT {
            guarded_nz = c.is_local_nonzero(c.nlocal[rhs])
        }
        if p.nodes[rhs].kind == ast.NK_FIELD {
            recv := p.nodes[rhs].a
            if recv >= 0 && p.nodes[recv].kind == ast.NK_IDENT {
                guarded_nz = c.is_field_nonzero(c.nlocal[recv], p.nodes[rhs].sval)
            }
        }
    }
    if !literal_nz && !folded_nz && !guarded_nz {
        c.warn_node(p, at, "possible division by zero")
    }
}

// M36 E1/E2/W2 on a compound `/=` / `%=` (mirror xuhir check_assign_value).
// `target_known`/`target_val` is the target's tracked int value BEFORE the
// rebind (E2's dividend); field/index targets pass (false, 0).
fn (c $&Checker) check_compound_div(p &parser.Parser, at int, target_known bool, target_val int, rhs int) {
    // E1: literal zero divisor.
    if c.literal_int_zero(p, rhs) {
        c.fail_node(p, at, "division by zero (constant divisor)")
        <<
    }
    // E2: target INT_MIN / -1.
    if target_known && target_val == int_min_val() && c.is_expr_int(p, rhs) && c.expr_int_value(p, rhs) == 0 - 1 {
        c.fail_node(p, at, "division overflow (INT_MIN / -1)")
    }
    // W2: divisor not proven non-zero (literal, foldable, range-proven, or guarded).
    literal_nz := c.literal_int_nonzero(p, rhs)
    folded_nz := (c.is_expr_int(p, rhs) && c.expr_int_value(p, rhs) != 0) || c.expr_int_range_nonzero(p, rhs)
    $guarded_nz := false
    if !literal_nz && !folded_nz && rhs >= 0 {
        if p.nodes[rhs].kind == ast.NK_IDENT {
            guarded_nz = c.is_local_nonzero(c.nlocal[rhs])
        }
        if p.nodes[rhs].kind == ast.NK_FIELD {
            recv := p.nodes[rhs].a
            if recv >= 0 && p.nodes[recv].kind == ast.NK_IDENT {
                guarded_nz = c.is_field_nonzero(c.nlocal[recv], p.nodes[rhs].sval)
            }
        }
    }
    if !literal_nz && !folded_nz && !guarded_nz {
        c.warn_node(p, at, "possible division by zero")
    }
}

// Record a call edge (current function -> resolved target) for W1.
fn (c $&Checker) record_call(target int) {
    if target < 0 { << }
    cf := c.cur_fn
    c.cg_from.push(cf)
    c.cg_to.push(target)
}

// Map a function index to its source function (templates for instances).
fn (c &Checker) canonical_fn(fi int) int {
    if fi < 0 { << fi }
    if fi < c.n_src_fns { << fi }
    if fi >= c.fns.len { << fi }
    d := c.fndecl[fi]
    for i in 0:c.n_src_fns {
        if c.fndecl[i] == d { << i }
    }
    << fi
}
