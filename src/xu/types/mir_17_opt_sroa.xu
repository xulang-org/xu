@xu/types

// Scalar SROA for non-escaping, non-owning struct locals. Direct field
// traffic (Addr+LoadPtr/StorePtr) and whole StoreLocal of a matching
// aggregate become synthetic one-slot locals so LocalPromotion can
// version them. Nested, packed, owning, address-escaping and whole-load
// shapes stay frame-backed.

fn mir_sroa_local_tag() int {
    << MIR_LOCAL_OPERAND_BASE
}

fn mir_sroa_encoded_local(v int) int {
    tag := mir_sroa_local_tag()
    if v >= tag { << v - tag }
    << -1
}

fn mir_sroa_layout(m &Mir, ty int, offs &mut []int, tys &mut []int) int {
    if !is_struct_type(ty) { << -1 }
    si := struct_index(ty)
    if si < 0 || si >= m.structs.len { << -1 }
    if m.type_owning(ty) { << -1 }
    nf := m.structs[si].fields.len
    tsz := m.type_size_bytes(ty)
    if nf <= 0 || tsz <= 0 { << -1 }
    mut tmp_off := []int{}
    mut tmp_ty := []int{}
    for fi in 0:nf {
        ft := m.structs[si].fields[fi].ty
        off := m.structs[si].fields[fi].slot
        abi := mir_type_abi_class(ft)
        if abi != TY_ABI_GPR && abi != TY_ABI_FP { << -1 }
        if m.type_slots(ft) != 1 { << -1 }
        sz := m.type_size_bytes(ft)
        if sz <= 0 || off % 8 != 0 { << -1 }
        if off < 0 || off + sz > tsz { << -1 }
        for j in 0:tmp_off.len {
            old := tmp_off[j]
            if off < old + 8 && old < off + 8 { << -1 }
        }
        tmp_off.push(off)
        tmp_ty.push(ft)
    }
    if tmp_off.len == 0 { << -1 }
    for i in 0:tmp_off.len {
        offs.push(tmp_off[i])
        tys.push(tmp_ty[i])
    }
    << tmp_off.len
}

fn mir_sroa_piece_at(offs &[]int, n int, off int) int {
    for i in 0:n {
        if offs[i] == off { << i }
    }
    << -1
}

fn mir_sroa_args_use_temp(f &MFn, head int, t int) bool {
    mut p := head
    for _ in 0:f.margs.len {
        if p < 0 { << false }
        if mfn_marg_v(&f.margs, p) == t { << true }
        p = mfn_marg_next(&f.margs, p)
    }
    << false
}

fn mir_sroa_uses_temp(f &MFn, ii int, t int) bool {
    k := mfn_ikind(&f.instrs, ii)
    ia := mfn_ia(&f.instrs, ii)
    ib := mfn_ib(&f.instrs, ii)
    ic := mfn_ic(&f.instrs, ii)
    id := mfn_id(&f.instrs, ii)
    if k == MI_COPY || k == MI_STR_CLONE { << ia == t || ib == t }
    if k == MI_LOAD_LOCAL { << ia == t }
    if k == MI_STORE_LOCAL { << ib == t }
    if k == MI_BIN { << ia == t || ic == t || id == t }
    if k == MI_UN { << ia == t || ic == t }
    if k == MI_STR_CONST || k == MI_LOAD_FN_ADDR { << ia == t }
    if k == MI_CALL || k == MI_XU {
        if ia == t { << true }
        << mir_sroa_args_use_temp(f, ic, t)
    }
    if k == MI_LOAD_FIELD || k == MI_LOAD_PTR || k == MI_LOAD_BUF_PTR { << ia == t || ib == t }
    if k == MI_STORE_FIELD || k == MI_STORE_PTR || k == MI_STORE_BUF_PTR { << ia == t || ib == t }
    if k == MI_FIELD_RMW { << ia == t || ic == t }
    if k == MI_ADDR {
        if ia == t { << true }
        if ic != 0 && ib == t { << true }
        << false
    }
    if k == MI_DROP { << false }
    if k == MI_INTERFACE_METHOD {
        if ia == t || ib == t { << true }
        << mir_sroa_args_use_temp(f, id, t)
    }
    << ia == t || ib == t
}

fn mir_sroa_mentions_local(f &MFn, ii int, local int) int {
    k := mfn_ikind(&f.instrs, ii)
    ia := mfn_ia(&f.instrs, ii)
    ib := mfn_ib(&f.instrs, ii)
    ic := mfn_ic(&f.instrs, ii)
    if k == MI_LOAD_LOCAL && ib == local { << 1 }
    if k == MI_STORE_LOCAL && ia == local { << 2 }
    if k == MI_DROP && ia == local { << 3 }
    if k == MI_ADDR && ic == 0 && ib == local { << 4 }
    enc := mir_sroa_encoded_local(ib)
    if (k == MI_LOAD_INDEX || k == MI_ELEM_ADDR) && enc == local { << 3 }
    enc2 := mir_sroa_encoded_local(ia)
    if (k == MI_STORE_INDEX || k == MI_INDEX_RMW) && enc2 == local { << 3 }
    << 0
}

fn mir_sroa_src_ok(f &MFn, src int, ty int) bool {
    if src <= -2 { << true }
    if src < 0 { << false }
    if src >= f.temps.len { << false }
    << f.temps[src] == ty
}

fn mir_sroa_scan_local(f &MFn, local int, ty int, offs &[]int, tys &[]int, n int, touched &mut []bool, init_temps &mut []int) int {
    ntmp := f.temps.len
    mut is_addr := []int{}
    for _ in 0:ntmp { is_addr.push(0) }
    mut found := []int{}
    mut whole := 0
    mut saw := 0
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            kind := mir_sroa_mentions_local(f, ii, local)
            if kind == 1 { << 0 }
            if kind == 3 { << 0 }
            if kind == 2 {
                src := mfn_ib(&f.instrs, ii)
                if src < 0 || src >= ntmp { << 0 }
                if f.temps[src] != ty { << 0 }
                whole = 1
                found.push(src)
                saw = 1
            }
            if kind == 4 {
                dest := mfn_ia(&f.instrs, ii)
                if dest < 0 || dest >= ntmp { << 0 }
                mfn_set_i(mut &is_addr, dest, 1)
                saw = 1
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            ia := mfn_ia(&f.instrs, ii)
            ib := mfn_ib(&f.instrs, ii)
            // Keep each borrowed field in a local before combining the
            // predicates.  Xu's borrow checker correctly rejects two
            // overlapping immutable borrows of `f.instrs` in one condition;
            // this also makes the SROA scan's field/slot test explicit.
            ic := mfn_ic(&f.instrs, ii)
            if k == MI_ADDR && ic == 0 && ib == local {
                ii = mfn_inext(&f.instrs, ii)
                ->
            }
            if (k == MI_LOAD_PTR || k == MI_STORE_PTR) && ib >= 0 && ib < ntmp && is_addr[ib] == 1 {
                off := mfn_ic(&f.instrs, ii)
                pi := mir_sroa_piece_at(offs, n, off)
                if pi < 0 { << 0 }
                if mfn_id(&f.instrs, ii) != 1 { << 0 }
                if k == MI_LOAD_PTR {
                    dest := mfn_ia(&f.instrs, ii)
                    if dest < 0 || dest >= ntmp { << 0 }
                    if f.temps[dest] != tys[pi] { << 0 }
                }
                if k == MI_STORE_PTR {
                    src := mfn_ia(&f.instrs, ii)
                    if !mir_sroa_src_ok(f, src, tys[pi]) { << 0 }
                }
                mfn_set_b(touched, pi, true)
                saw = 1
                ii = mfn_inext(&f.instrs, ii)
                ->
            }
            if k == MI_FIELD_RMW && ib == 0 && ia >= 0 && ia < ntmp && is_addr[ia] == 1 {
                off := mfn_iline(&f.instrs, ii)
                pi := mir_sroa_piece_at(offs, n, off)
                if pi < 0 { << 0 }
                rhs := mfn_ic(&f.instrs, ii)
                if !mir_sroa_src_ok(f, rhs, tys[pi]) { << 0 }
                mfn_set_b(touched, pi, true)
                saw = 1
                ii = mfn_inext(&f.instrs, ii)
                ->
            }
            if k == MI_CALL && ib == 95 {
                head := mfn_ic(&f.instrs, ii)
                if head >= 0 && head < f.margs.len {
                    ptr := f.margs[head].v
                    if ptr >= 0 && ptr < ntmp && is_addr[ptr] == 1 {
                        n1 := f.margs[head].next
                        if n1 >= 0 && n1 < f.margs.len {
                            rhs := f.margs[n1].v
                            packed := mfn_id(&f.instrs, ii)
                            off := packed / 64
                            pi := mir_sroa_piece_at(offs, n, off)
                            if pi < 0 { << 0 }
                            if !mir_sroa_src_ok(f, rhs, tys[pi]) { << 0 }
                            mfn_set_b(touched, pi, true)
                            saw = 1
                            ii = mfn_inext(&f.instrs, ii)
                            ->
                        }
                    }
                }
            }
            if k == MI_STORE_FIELD && ib >= 0 && ib < ntmp {
                mut is_init_t := false
                for ti in 0:found.len {
                    if found[ti] == ib { is_init_t = true }
                }
                if is_init_t {
                    ii = mfn_inext(&f.instrs, ii)
                    ->
                }
            }
            for t in 0:ntmp {
                if is_addr[t] == 1 && mir_sroa_uses_temp(f, ii, t) { << 0 }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    if saw == 0 { << 0 }
    if whole == 1 {
        for i in 0:n { mfn_set_b(touched, i, true) }
    }
    mut hit := false
    for i in 0:n {
        if touched[i] { hit = true }
    }
    if !hit { << 0 }
    // Only publish init temps after the local is fully eligible. A
    // rejected candidate (by-value call arg, Drop, mixed shape) must
    // not mark its StoreField constructor as dead: rewrite drops those
    // stores, and the still-live aggregate local stays uninitialized.
    for i in 0:found.len {
        init_temps.push(found[i])
    }
    << 1
}

fn mir_sroa_reset_block(f &mut MFn, bi int) {
    mut b := f.blocks[bi]
    b.head = -1
    b.tail = -1
    mfn_set_block(mut &f.blocks, bi, b)
}

fn mir_sroa_emit(f &mut MFn, bi int, ins MInstr) {
    old := f.cur
    f.cur = bi
    f.emit(ins)
    f.cur = old
}

fn mir_sroa_map_local(aggs &[]int, offs &[]int, locs &[]int, agg int, off int) int {
    for i in 0:aggs.len {
        if aggs[i] == agg && offs[i] == off { << locs[i] }
    }
    << -1
}

fn mir_sroa_is_agg(aggs &[]int, local int) bool {
    for i in 0:aggs.len {
        if aggs[i] == local { << true }
    }
    << false
}

fn mir_sroa_is_init_temp(init_temps &[]int, t int) bool {
    for i in 0:init_temps.len {
        if init_temps[i] == t { << true }
    }
    << false
}

fn mir_sroa_lookup_init(in_t &[]int, in_off &[]int, in_val &[]int, t int, off int) int {
    for i in 0:in_t.len {
        if in_t[i] == t && in_off[i] == off { << in_val[i] }
    }
    << -1
}

fn mir_sroa_rewrite(f &mut MFn, aggs &[]int, piece_off &[]int, piece_ty &[]int, piece_loc &[]int, is_addr &[]int, init_temps &[]int, in_t &[]int, in_off &[]int, in_val &[]int) int {
    mut changed := 0
    nblk := f.blocks.len
    for bi in 0:nblk {
        mut old := []int{}
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            old.push(ii)
            ii = mfn_inext(&f.instrs, ii)
        }
        mir_sroa_reset_block(f, bi)
        for oi in 0:old.len {
            src_ii := old[oi]
            snap := mfn_instr_snap(mut &f.instrs, src_ii)
            // This block's old chain was replaced, not moved. Keep the
            // owned payload in snap for cloning before retiring its source.
            mir_nop_mfni(mut &f.instrs, src_ii)
            mfn_set_inext(mut &f.instrs, src_ii, -1)
            k := snap.kind
            ia := snap.a
            ib := snap.b
            ic := snap.c
            if k == 16 && ic == 0 && mir_sroa_is_agg(aggs, ib) {
                changed += 1
                ->
            }
            if k == 11 && mir_sroa_is_init_temp(init_temps, ib) {
                changed += 1
                ->
            }
            if k == 17 || k == 18 {
                if ib >= 0 && ib < is_addr.len && is_addr[ib] >= 0 {
                    loc := mir_sroa_map_local(aggs, piece_off, piece_loc, is_addr[ib], ic)
                    if loc >= 0 {
                        mut ins := mkinstr(MI_LOAD_LOCAL)
                        if k == 17 {
                            ins.kind = MI_LOAD_LOCAL
                            ins.a = ia
                            ins.b = loc
                        } else {
                            ins.kind = MI_STORE_LOCAL
                            ins.a = loc
                            ins.b = ia
                        }
                        ins.line = snap.line
                        ins.col = snap.col
                        ins.file = snap.file
                        mir_sroa_emit(f, bi, ins)
                        changed += 1
                        ->
                    }
                }
            }
            if k == 48 && snap.b == 0 {
                if ia >= 0 && ia < is_addr.len && is_addr[ia] >= 0 {
                    loc := mir_sroa_map_local(aggs, piece_off, piece_loc, is_addr[ia], snap.line)
                    if loc >= 0 {
                        mut fty := snap.d
                        if fty == 0 {
                            for pi in 0:piece_off.len {
                                if piece_loc[pi] == loc { fty = piece_ty[pi] }
                            }
                        }
                        t0 := f.temps.len
                        f.temps.push(fty)
                        f.temps_nslots.push(1)
                        t1 := f.temps.len
                        f.temps.push(fty)
                        f.temps_nslots.push(1)

                        mut ld := mkinstr(MI_LOAD_LOCAL)
                        ld.a = t0
                        ld.b = loc
                        ld.line = snap.line
                        ld.col = snap.col
                        ld.file = snap.file
                        mir_sroa_emit(f, bi, ld)

                        mut bo := mkinstr(MI_BIN)
                        bo.a = t1
                        bo.b = snap.col
                        bo.c = t0
                        bo.d = ic
                        bo.line = snap.line
                        bo.col = snap.col
                        bo.file = snap.file
                        mir_sroa_emit(f, bi, bo)

                        mut st := mkinstr(MI_STORE_LOCAL)
                        st.a = loc
                        st.b = t1
                        st.line = snap.line
                        st.col = snap.col
                        st.file = snap.file
                        mir_sroa_emit(f, bi, st)

                        changed += 1
                        ->
                    }
                }
            }
            if k == 7 && ib == 95 {
                head := ic
                if head >= 0 && head < f.margs.len {
                    ptr := f.margs[head].v
                    if ptr >= 0 && ptr < is_addr.len && is_addr[ptr] >= 0 {
                        n1 := f.margs[head].next
                        if n1 >= 0 && n1 < f.margs.len {
                            rhs := f.margs[n1].v
                            packed := snap.d
                            off := packed / 64
                            bop := packed - off * 64
                            loc := mir_sroa_map_local(aggs, piece_off, piece_loc, is_addr[ptr], off)
                            if loc >= 0 {
                                mut fty := 1
                                for pi in 0:piece_off.len {
                                    if piece_loc[pi] == loc { fty = piece_ty[pi] }
                                }
                                t0 := f.temps.len
                                f.temps.push(fty)
                                f.temps_nslots.push(1)
                                t1 := f.temps.len
                                f.temps.push(fty)
                                f.temps_nslots.push(1)

                                mut ld := mkinstr(MI_LOAD_LOCAL)
                                ld.a = t0
                                ld.b = loc
                                ld.line = snap.line
                                ld.col = snap.col
                                ld.file = snap.file
                                mir_sroa_emit(f, bi, ld)

                                mut bo := mkinstr(MI_BIN)
                                bo.a = t1
                                bo.b = bop
                                bo.c = t0
                                bo.d = rhs
                                bo.line = snap.line
                                bo.col = snap.col
                                bo.file = snap.file
                                mir_sroa_emit(f, bi, bo)

                                mut st := mkinstr(MI_STORE_LOCAL)
                                st.a = loc
                                st.b = t1
                                st.line = snap.line
                                st.col = snap.col
                                st.file = snap.file
                                mir_sroa_emit(f, bi, st)

                                changed += 1
                                ->
                            }
                        }
                    }
                }
            }
            if k == 3 && mir_sroa_is_agg(aggs, ia) {
                src := ib
                if src < 0 { << 0 }
                for pi in 0:piece_off.len {
                    if aggs[pi] != ia { -> }
                    val := mir_sroa_lookup_init(in_t, in_off, in_val, src, piece_off[pi])
                    mut st := mkinstr(MI_STORE_LOCAL)
                    st.a = piece_loc[pi]
                    if val != -1 {
                        st.b = val
                    } else {
                        nt := f.temps.len
                        f.temps.push(piece_ty[pi])
                        f.temps_nslots.push(1)
                        mut lf := mkinstr(MI_LOAD_FIELD)
                        lf.a = nt
                        lf.b = src
                        lf.c = piece_off[pi]
                        lf.d = 1
                        mir_sroa_emit(f, bi, lf)
                        st.b = nt
                    }
                    st.line = snap.line
                    st.col = snap.col
                    st.file = snap.file
                    mir_sroa_emit(f, bi, st)
                    changed += 1
                }
                ->
            }
            mut keep := snap
            keep.next = -1
            mir_sroa_emit(f, bi, keep)
        }
    }
    // A whole aggregate source temp keeps its original type and slot width.
    // It may still be consumed by an aggregate-returning call or another
    // path after the split; narrowing it to the Int/one-slot shape here
    // silently truncates the value.  Dead synthetic sources are reclaimed by
    // the normal liveness/frame pass, so there is no correctness-preserving
    // reason to mutate this MIR ABI metadata.
    << changed
}

fn mir_sroa_collect_addr(f &MFn, aggs &[]int, is_addr &mut []int) {
    ntmp := is_addr.len
    for i in 0:ntmp { mfn_set_i(is_addr, i, -1) }
    for bi in 0:f.blocks.len {
            mut ii := f.blocks[bi].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            ic := mfn_ic(&f.instrs, ii)
            if k == MI_ADDR && ic == 0 {
                loc := mfn_ib(&f.instrs, ii)
                dest := mfn_ia(&f.instrs, ii)
                for ai in 0:aggs.len {
                    if loc == aggs[ai] && dest >= 0 && dest < ntmp {
                        mfn_set_i(is_addr, dest, loc)
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
}

fn mir_sroa_collect_inits(f &MFn, init_temps &[]int, in_t &mut []int, in_off &mut []int, in_val &mut []int) {
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_STORE_FIELD {
                t := mfn_ib(&f.instrs, ii)
                if mir_sroa_is_init_temp(init_temps, t) {
                    in_t.push(t)
                    in_off.push(mfn_ic(&f.instrs, ii))
                    in_val.push(mfn_ia(&f.instrs, ii))
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
}

fn mir_sroa_scalar_struct_locals(m &Mir, f &mut MFn) int {
    if f.blocks.len == 0 { << 0 }
    if f.phis.len != 0 { << 0 }
    nloc := f.locals.len
    param_n := f.nparams
    mut aggs := []int{}
    mut piece_off := []int{}
    mut piece_ty := []int{}
    mut piece_loc := []int{}
    mut init_temps := []int{}
    for loc in param_n:nloc {
        if loc < f.locals_owning.len && f.locals_owning[loc] { -> }
        mut offs := []int{}
        mut tys := []int{}
        n := mir_sroa_layout(m, f.locals[loc], mut &offs, mut &tys)
        if n <= 0 { -> }
        mut touched := []bool{}
        for _ in 0:n { touched.push(false) }
        mut cand := []int{}
        if mir_sroa_scan_local(&*f, loc, f.locals[loc], &offs, &tys, n, mut &touched, mut &cand) == 0 {
            ->
        }
        mut all_t := true
        for i in 0:n {
            if !touched[i] { all_t = false }
        }
        if !all_t { -> }
        for i in 0:n {
            sl := f.locals.len
            f.locals.push(tys[i])
            f.locals_nslots.push(1)
            f.locals_owning.push(false)
            aggs.push(loc)
            piece_off.push(offs[i])
            piece_ty.push(tys[i])
            piece_loc.push(sl)
        }
        for i in 0:cand.len {
            init_temps.push(cand[i])
        }
    }
    if aggs.len == 0 { << 0 }
    ntmp := f.temps.len
    mut is_addr := []int{}
    for _ in 0:ntmp { is_addr.push(-1) }
    mir_sroa_collect_addr(&*f, &aggs, mut &is_addr)
    mut in_t := []int{}
    mut in_off := []int{}
    mut in_val := []int{}
    mir_sroa_collect_inits(&*f, &init_temps, mut &in_t, mut &in_off, mut &in_val)
    << mir_sroa_rewrite(f, &aggs, &piece_off, &piece_ty, &piece_loc, &is_addr, &init_temps, &in_t, &in_off, &in_val)
}

fn mir_sroa_gate_pair() CStruct {
    mut st := CStruct{
        name: "SroaPair",
        fields: []CField{},
        nslots: 2,
        size_bytes: 16,
        align_bytes: 8,
        mod_id: "",
        is_pub: true,
        origin: "",
        drop_label: ""
    }
    st.fields.push(CField{name: "a", ty: 1, slot: 0, life: "", is_pub: true})
    st.fields.push(CField{name: "b", ty: 4, slot: 8, life: "", is_pub: true})
    << st
}

fn mir_sroa_gate_fn() MFn {
    mut f := mir_fn_blank()
    f.name = "sroa_gate"
    f.label = "_sroa_gate"
    f.locals.push(100)
    f.locals_nslots.push(2)
    f.locals_owning.push(false)
    f.moved.push(false)
    f.fcons.push(0)
    f.temps.push(1)
    f.temps_nslots.push(1)
    f.temps.push(1)
    f.temps_nslots.push(1)
    f.temps.push(4)
    f.temps_nslots.push(1)
    f.consts.push(7)
    f.blocks.push(MBlock{head: -1, tail: -1, tkind: 3, ta: -1, tb: -1, tc: -1, line: 0})
    f.cur = 0
    mut ad := mkinstr(MI_ADDR)
    ad.a = 0
    ad.b = 0
    ad.c = 0
    f.emit(ad)
    mut st0 := mkinstr(MI_STORE_PTR)
    st0.a = -2
    st0.b = 0
    st0.c = 0
    st0.d = 1
    f.emit(st0)
    mut ld0 := mkinstr(MI_LOAD_PTR)
    ld0.a = 1
    ld0.b = 0
    ld0.c = 0
    ld0.d = 1
    f.emit(ld0)
    mut ld1 := mkinstr(MI_LOAD_PTR)
    ld1.a = 2
    ld1.b = 0
    ld1.c = 8
    ld1.d = 1
    f.emit(ld1)
    << f
}

fn mir_sroa_has_ptr_field(f &MFn) bool {
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == MI_ADDR || k == MI_LOAD_PTR || k == MI_STORE_PTR { << true }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << false
}

fn mir_sroa_has_piece_store(f &MFn) bool {
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            ia := mfn_ia(&f.instrs, ii)
            if k == MI_STORE_LOCAL && ia != 0 { << true }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    << false
}

fn mir_sroa_internal_gate() bool {
    // The production pass is already guarded by `mir_fn_commit` and the
    // allocation-free shape verifier at the emitter boundary.  Do not build
    // and transform a synthetic aggregate MFn for every small source
    // function: that self-test allocates large nested slices on the hosted
    // compiler's stack and was a recurrent Gen2 ABI/stack-pressure trigger.
    // Keep the fixture helpers above for the dedicated MIR tests; production
    // admission itself is the real-MIR verifier below.
    << true
}

// Flatten a non-owning `[N]struct` of scalar fields into one piece per
// element field. Cap N at 8 so nbody-sized locals (`[5]Body`) fit. This
// pass is independent of struct SROA: it only admits array locals and
// never rewrites Addr+ElemAddr of a struct.
fn mir_sroa_array_layout(m &Mir, ty int, offs &mut []int, tys &mut []int) int {
    if !is_array_type(ty) { << -1 }
    ai := array_index(ty)
    if ai < 0 || ai >= m.arrays.len { << -1 }
    fl := m.arrays[ai].fixed_len
    if fl <= 0 || fl > 8 { << -1 }
    ety := m.arrays[ai].elem_ty
    eb := m.arrays[ai].elem_bytes
    if eb <= 0 || eb % 8 != 0 { << -1 }
    if m.type_owning(ety) { << -1 }
    mut eoff := []int{}
    mut etys := []int{}
    n := mir_sroa_layout(m, ety, mut &eoff, mut &etys)
    if n <= 0 { << -1 }
    if fl * n > 64 { << -1 }
    for ei in 0:fl {
        base := ei * eb
        for pi in 0:n {
            offs.push(base + eoff[pi])
            tys.push(etys[pi])
        }
    }
    << fl * n
}

fn mir_sroa_array_scan(f &MFn, local int, ty int, offs &[]int, tys &[]int, n int, eb int, touched &mut []bool, init_temps &mut []int) int {
    ntmp := f.temps.len
    mut is_addr := []int{}
    mut desc := []int{}
    mut elem_addr := []int{}
    for _ in 0:ntmp {
        is_addr.push(0)
        desc.push(0)
        elem_addr.push(-1)
    }
    mut found := []int{}
    mut whole := 0
    mut saw := 0
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            kind := mir_sroa_mentions_local(f, ii, local)
            if kind == 3 { << 0 }
            if kind == 1 {
                dest := mfn_ia(&f.instrs, ii)
                if dest < 0 || dest >= ntmp { << 0 }
                desc[dest] = 1
                saw = 1
            }
            if kind == 2 {
                src := mfn_ib(&f.instrs, ii)
                if src < 0 || src >= ntmp { << 0 }
                if f.temps[src] != ty { << 0 }
                if src >= f.temps_nslots.len || local >= f.locals_nslots.len { << 0 }
                if f.temps_nslots[src] != f.locals_nslots[local] { << 0 }
                whole = 1
                found.push(src)
                saw = 1
            }
            if kind == 4 {
                dest := mfn_ia(&f.instrs, ii)
                if dest < 0 || dest >= ntmp { << 0 }
                is_addr[dest] = 1
                saw = 1
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            ib := mfn_ib(&f.instrs, ii)
            ic := mfn_ic(&f.instrs, ii)
            if k == MI_ADDR && ic == 0 && ib == local {
                ii = mfn_inext(&f.instrs, ii)
                ->
            }
            if k == MI_LOAD_LOCAL && ib == local {
                ii = mfn_inext(&f.instrs, ii)
                ->
            }
            if k == MI_ELEM_ADDR && ib >= 0 && ib < ntmp && (is_addr[ib] == 1 || desc[ib] == 1) {
                if !mir_val_is_const(f, ic) { << 0 }
                dest := mfn_ia(&f.instrs, ii)
                if dest < 0 || dest >= ntmp { << 0 }
                elem_addr[dest] = mir_val_const(f, ic)
                saw = 1
                ii = mfn_inext(&f.instrs, ii)
                ->
            }
            if (k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_STORE_BUF_PTR || k == MI_LOAD_BUF_PTR) && ib >= 0 && ib < ntmp && elem_addr[ib] >= 0 {
                abs_off := elem_addr[ib] * eb + mfn_ic(&f.instrs, ii)
                pi := mir_sroa_piece_at(offs, n, abs_off)
                if pi < 0 { << 0 }
                if mfn_id(&f.instrs, ii) != 1 { << 0 }
                if k == MI_LOAD_PTR || k == MI_LOAD_BUF_PTR {
                    dest := mfn_ia(&f.instrs, ii)
                    if dest < 0 || dest >= ntmp { << 0 }
                    if f.temps[dest] != tys[pi] { << 0 }
                }
                if k == MI_STORE_PTR || k == MI_STORE_BUF_PTR {
                    src := mfn_ia(&f.instrs, ii)
                    if !mir_sroa_src_ok(f, src, tys[pi]) { << 0 }
                }
                mfn_set_b(touched, pi, true)
                saw = 1
                ii = mfn_inext(&f.instrs, ii)
                ->
            }
            if k == MI_STORE_FIELD && ib >= 0 && ib < ntmp {
                mut is_init_t := false
                for ti in 0:found.len {
                    if found[ti] == ib { is_init_t = true }
                }
                if is_init_t {
                    ii = mfn_inext(&f.instrs, ii)
                    ->
                }
            }
            for t in 0:ntmp {
                if is_addr[t] == 1 && mir_sroa_uses_temp(f, ii, t) { << 0 }
                if desc[t] == 1 && k != MI_ELEM_ADDR && mir_sroa_uses_temp(f, ii, t) { << 0 }
                if elem_addr[t] >= 0 && k != MI_LOAD_PTR && k != MI_STORE_PTR && k != MI_STORE_BUF_PTR && k != MI_LOAD_BUF_PTR && mir_sroa_uses_temp(f, ii, t) { << 0 }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    if saw == 0 { << 0 }
    if whole == 1 {
        for i in 0:n { mfn_set_b(touched, i, true) }
    }
    mut hit := false
    for i in 0:n {
        if touched[i] { hit = true }
    }
    if !hit { << 0 }
    for i in 0:found.len {
        init_temps.push(found[i])
    }
    << 1
}

fn mir_sroa_array_rewrite(f &mut MFn, aggs &[]int, piece_off &[]int, piece_ty &[]int, piece_loc &[]int, is_addr &[]int, elem_idx &[]int, elem_agg &[]int, ebs &[]int, init_temps &[]int, in_t &[]int, in_off &[]int, in_val &[]int) int {
    mut changed := 0
    nblk := f.blocks.len
    for bi in 0:nblk {
        mut old := []int{}
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            old.push(ii)
            ii = mfn_inext(&f.instrs, ii)
        }
        mir_sroa_reset_block(f, bi)
        for oi in 0:old.len {
            src_ii := old[oi]
            snap := mfn_instr_snap(mut &f.instrs, src_ii)
            // Preserve cloned effects and strings; retire only their exact
            // replaced source records, never unrelated pool orphans.
            mir_nop_mfni(mut &f.instrs, src_ii)
            mfn_set_inext(mut &f.instrs, src_ii, -1)
            k := snap.kind
            ia := snap.a
            ib := snap.b
            ic := snap.c
            if k == 16 && ic == 0 && mir_sroa_is_agg(aggs, ib) {
                changed += 1
                ->
            }
            if k == 2 && mir_sroa_is_agg(aggs, ib) {
                changed += 1
                ->
            }
            if k == 23 && ia >= 0 && ia < elem_idx.len && elem_idx[ia] >= 0 {
                changed += 1
                ->
            }
            if k == 12 && mir_sroa_is_init_temp(init_temps, ia) {
                changed += 1
                ->
            }
            if k == 11 && mir_sroa_is_init_temp(init_temps, ib) {
                changed += 1
                ->
            }
            if k == 17 || k == 18 || k == 25 || k == 26 {
                mut loc := -1
                if ib >= 0 && ib < is_addr.len && is_addr[ib] >= 0 {
                    loc = mir_sroa_map_local(aggs, piece_off, piece_loc, is_addr[ib], ic)
                }
                if loc < 0 && ib >= 0 && ib < elem_idx.len && elem_idx[ib] >= 0 {
                    agg := elem_agg[ib]
                    mut eb := 0
                    for ai in 0:aggs.len {
                        if aggs[ai] == agg {
                            eb = ebs[ai]
                        }
                    }
                    if eb > 0 {
                        loc = mir_sroa_map_local(aggs, piece_off, piece_loc, agg, elem_idx[ib] * eb + ic)
                    }
                    if loc < 0 {
                        << 0
                    }
                }
                if loc >= 0 {
                    mut ins := mkinstr(MI_LOAD_LOCAL)
                    if k == 17 || k == 26 {
                        ins.kind = MI_LOAD_LOCAL
                        ins.a = ia
                        ins.b = loc
                    } else {
                        ins.kind = MI_STORE_LOCAL
                        ins.a = loc
                        ins.b = ia
                    }
                    ins.line = snap.line
                    ins.col = snap.col
                    ins.file = snap.file
                    mir_sroa_emit(f, bi, ins)
                    changed += 1
                    ->
                }
            }
            if k == 3 && mir_sroa_is_agg(aggs, ia) {
                src := ib
                if src < 0 { << 0 }
                for pi in 0:piece_off.len {
                    if aggs[pi] != ia { -> }
                    val := mir_sroa_lookup_init(in_t, in_off, in_val, src, piece_off[pi])
                    mut st := mkinstr(MI_STORE_LOCAL)
                    st.a = piece_loc[pi]
                    if val != -1 {
                        st.b = val
                    } else {
                        nt := f.temps.len
                        f.temps.push(piece_ty[pi])
                        f.temps_nslots.push(1)
                        mut lf := mkinstr(MI_LOAD_FIELD)
                        lf.a = nt
                        lf.b = src
                        lf.c = piece_off[pi]
                        lf.d = 1
                        mir_sroa_emit(f, bi, lf)
                        st.b = nt
                    }
                    st.line = snap.line
                    st.col = snap.col
                    st.file = snap.file
                    mir_sroa_emit(f, bi, st)
                    changed += 1
                }
                ->
            }
            mut keep := snap
            keep.next = -1
            mir_sroa_emit(f, bi, keep)
        }
    }
    << changed
}

fn mir_sroa_array_locals(m &Mir, f &mut MFn) int {
    if f.blocks.len == 0 { << 0 }
    if f.phis.len != 0 { << 0 }
    nloc := f.locals.len
    param_n := f.nparams
    mut aggs := []int{}
    mut piece_off := []int{}
    mut piece_ty := []int{}
    mut piece_loc := []int{}
    mut ebs := []int{}
    mut init_temps := []int{}
    for loc in param_n:nloc {
        if loc < f.locals_owning.len && f.locals_owning[loc] { -> }
        if !is_array_type(f.locals[loc]) { -> }
        mut offs := []int{}
        mut tys := []int{}
        n := mir_sroa_array_layout(m, f.locals[loc], mut &offs, mut &tys)
        if n <= 0 { -> }
        ai := array_index(f.locals[loc])
        eb := m.arrays[ai].elem_bytes
        mut touched := []bool{}
        for _ in 0:n { touched.push(false) }
        mut cand := []int{}
        if mir_sroa_array_scan(&*f, loc, f.locals[loc], &offs, &tys, n, eb, mut &touched, mut &cand) == 0 {
            ->
        }
        mut all_t := true
        for i in 0:n {
            if !touched[i] { all_t = false }
        }
        if !all_t { -> }
        for i in 0:n {
            sl := f.locals.len
            f.locals.push(tys[i])
            f.locals_nslots.push(1)
            f.locals_owning.push(false)
            aggs.push(loc)
            piece_off.push(offs[i])
            piece_ty.push(tys[i])
            piece_loc.push(sl)
            ebs.push(eb)
        }
        for i in 0:cand.len {
            init_temps.push(cand[i])
        }
    }
    if aggs.len == 0 { << 0 }
    ntmp := f.temps.len
    mut is_addr := []int{}
    for _ in 0:ntmp { is_addr.push(-1) }
    mir_sroa_collect_addr(&*f, &aggs, mut &is_addr)
    mut elem_idx := []int{}
    mut elem_agg := []int{}
    mut desc := []int{}
    for _ in 0:ntmp {
        elem_idx.push(-1)
        elem_agg.push(-1)
        desc.push(-1)
    }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_LOAD_LOCAL {
                loc := mfn_ib(&f.instrs, ii)
                dest := mfn_ia(&f.instrs, ii)
                if dest >= 0 && dest < ntmp {
                    mut is_a := false
                    for ai in 0:aggs.len {
                        if aggs[ai] == loc { is_a = true }
                    }
                    if is_a {
                        desc[dest] = loc
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    for bi in 0:f.blocks.len {
        mut ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if mfn_ikind(&f.instrs, ii) == MI_ELEM_ADDR {
                base := mfn_ib(&f.instrs, ii)
                dest := mfn_ia(&f.instrs, ii)
                idx := mfn_ic(&f.instrs, ii)
                if dest >= 0 && dest < ntmp && base >= 0 && base < ntmp && mir_val_is_const(&*f, idx) {
                    mut agg := -1
                    if is_addr[base] >= 0 { agg = is_addr[base] }
                    if desc[base] >= 0 { agg = desc[base] }
                    if agg >= 0 {
                        elem_idx[dest] = mir_val_const(&*f, idx)
                        elem_agg[dest] = agg
                    }
                }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    mut in_t := []int{}
    mut in_off := []int{}
    mut in_val := []int{}
    mir_sroa_collect_inits(&*f, &init_temps, mut &in_t, mut &in_off, mut &in_val)
    << mir_sroa_array_rewrite(f, &aggs, &piece_off, &piece_ty, &piece_loc, &is_addr, &elem_idx, &elem_agg, &ebs, &init_temps, &in_t, &in_off, &in_val)
}

fn mir_sroa_fn_worth(m &Mir, fi int) bool {
    nb := mir_nblocks(m, fi)
    if nb <= 0 || nb > 128 { << false }
    if mir_nlocals(m, fi) > 64 { << false }
    if mir_nins(m, fi) > 2048 { << false }
    mut param_n := mir_fn_nparams(m, fi)
    if param_n < 0 { param_n = 0 }
    nloc := mir_nlocals(m, fi)
    for loc in param_n:nloc {
        ty := mir_local_ty(m, fi, loc)
        if is_struct_type(ty) || is_array_type(ty) { << true }
    }
    << false
}

fn mir_each_sroa_scalar_fields(m &mut Mir) {
    if !mir_sroa_internal_gate() {
        eprintln("internal error: MIR SROA verifier gate failed")
        <<< 1
    }
    n0 := m.fns.len
    mut fi := 0
    while fi < n0 {
        if mir_fn_is_extern(&*m, fi) {
            fi += 1
            ->
        }
        if m.fns[fi].phis.len != 0 {
            fi += 1
            ->
        }
        if !mir_sroa_fn_worth(&*m, fi) {
            fi += 1
            ->
        }
        mut f := mir_clone_fn(m, fi, true)
        n := mir_sroa_scalar_struct_locals(&*m, mut &f)
        na := mir_sroa_array_locals(&*m, mut &f)
        if n == 0 && na == 0 {
            fi += 1
            ->
        }
        if mir_verify_mfn_f(&f, false) != 0 {
            fi += 1
            ->
        }
        mir_fn_commit(m, fi, f)
        fi += 1
    }
}
