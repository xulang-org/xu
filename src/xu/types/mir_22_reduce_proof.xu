@xu/types

// Symbolic tags for the complete scalar recurrence, evaluated in live
// instruction order. Unknown values and additional stores fail closed.
fn mir_iand_tag(f &MFn, tags &[]int, v int) int {
    if v <= -2 && -v - 2 < f.consts.len { << 8 }
    if v < 0 || v >= tags.len { << 0 }
    << tags[v]
}

fn mir_iand_value(f &MFn, vals &[]int, v int) int {
    if v <= -2 { << f.consts[-v - 2] }
    << vals[v]
}

// Every external entry must already have checked current i < limit.
// Clearing tags on writes/calls prevents a stale comparison from proving
// the guard, including a do-while-style entry with no initial check.
fn mir_iand_entry_guard(f &MFn, bi int, ind int, limit int, exit_bb int) bool {
    $entries := 0
    for pi in 0:f.blocks.len {
        if pi == bi { -> }
        tk := f.blocks[pi].tkind
        $incoming := false
        if tk == 1 && f.blocks[pi].ta == bi { incoming = true }
        if tk == 2 && (f.blocks[pi].tb == bi || f.blocks[pi].tc == bi) { incoming = true }
        if !incoming { -> }
        entries += 1
        if tk != 2 || f.blocks[pi].tb != bi || f.blocks[pi].tc != exit_bb { << false }
        $tags := []int{}
        for _ in 0:f.temps.len { tags.push(0) }
        $ii := f.blocks[pi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            da := mfn_ia(&f.instrs, ii)
            db := mfn_ib(&f.instrs, ii)
            if k == MI_STORE_LOCAL {
                if da == ind {
                    for t in 0:tags.len { tags[t] = 0 }
                }
            } else if k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_BIN {
                if da < 0 || da >= tags.len { << false }
                $tag := 0
                if k == MI_LOAD_LOCAL && db == ind { tag = 1 }
                if k == MI_COPY && db >= 0 && db < tags.len { tag = tags[db] }
                if k == MI_BIN && db == 8 {
                    lc := mfn_ic(&f.instrs, ii)
                    ld := mfn_id(&f.instrs, ii)
                    if lc >= 0 && lc < tags.len && tags[lc] == 1 && ld <= -2 && -ld - 2 < f.consts.len && f.consts[-ld - 2] == limit { tag = 7 }
                }
                tags[da] = tag
            } else {
                // A barrier before the final load/compare is harmless.
                for t in 0:tags.len { tags[t] = 0 }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        cond := f.blocks[pi].ta
        if cond < 0 || cond >= tags.len || tags[cond] != 7 { << false }
    }
    << entries > 0
}

pub fn mir_iand_body_proved(m &Mir, fi int, bi int, ind int, acc int, mask int, bias int, limit int) bool {
    if fi < 0 || fi >= m.fns.len || bi < 0 || bi >= mir_nblocks(m, fi) || limit <= 16 { << false }
    if mir_btkind(m, fi, bi) != 2 || mir_btb(m, fi, bi) != bi || mir_btc(m, fi, bi) == bi { << false }
    if mir_nblocks(m, fi) > 32 || mir_nins(m, fi) > 256 || mir_ntemps(m, fi) > 256 { << false }
    $f := mir_cfg_clone_fn(m, fi, false)
    if f.phis.len != 0 { << false }
    if ind < 0 || acc < 0 || ind >= f.locals.len || acc >= f.locals.len || ind == acc { << false }
    if f.locals[ind] != 1 || f.locals[acc] != 1 || f.locals_nslots[ind] != 1 || f.locals_nslots[acc] != 1 { << false }
    if !mir_iand_entry_guard(&f, bi, ind, limit, f.blocks[bi].tc) { << false }
    $defs := []int{}
    mir_count_temp_defs(&f, $&defs)
    $tags := []int{}
    $vals := []int{}
    for _ in 0:f.temps.len {
        tags.push(0)
        vals.push(0)
    }
    $ni := 0
    $na := 0
    $nm := 0
    $nb := 0
    $ns := 0
    $nc := 0
    $nadd := 0
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        k := mfn_ikind(&f.instrs, ii)
        da := mfn_ia(&f.instrs, ii)
        db := mfn_ib(&f.instrs, ii)
        if k == MI_NOP {
            ii = mfn_inext(&f.instrs, ii)
            ->
        }
        if k == MI_STORE_LOCAL {
            tag := mir_iand_tag(&f, &tags, db)
            if da == ind && tag == 6 && ni == 0 { ni = 1 }
            else if da == acc && tag == 5 && na == 0 { na = 1 }
            else { << false }
        } else if k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_BIN {
            if da < 0 || da >= tags.len || defs[da] != 1 || f.temps_nslots[da] != 1 { << false }
            if mir_temp_used_outside(&f, da, bi) { << false }
            $tag := 0
            $val := 0
            if k == MI_COPY {
                tag = mir_iand_tag(&f, &tags, db)
                if tag == 8 { val = mir_iand_value(&f, &vals, db) }
            } else if k == MI_LOAD_LOCAL {
                if db == ind {
                    tag = 1
                    if ni != 0 { tag = 6 }
                } else if db == acc && na == 0 { tag = 2 }
            } else {
                lc := mfn_ic(&f.instrs, ii)
                ld := mfn_id(&f.instrs, ii)
                ct := mir_iand_tag(&f, &tags, lc)
                dt := mir_iand_tag(&f, &tags, ld)
                if db == 14 && ((ct == 1 && dt == 8) || (ct == 8 && dt == 1)) {
                    $cv := lc
                    if dt == 8 { cv = ld }
                    if mir_iand_value(&f, &vals, cv) == mask {
                        tag = 3
                        nm += 1
                    }
                } else if db == 1 {
                    if (ct == 1 && dt == 8) || (ct == 8 && dt == 1) {
                        $cv := lc
                        if dt == 8 { cv = ld }
                        if mir_iand_value(&f, &vals, cv) == 1 {
                            tag = 6
                            ns += 1
                        }
                    } else if (ct == 3 && dt == 8) || (ct == 8 && dt == 3) {
                        $cv := lc
                        if dt == 8 { cv = ld }
                        if mir_iand_value(&f, &vals, cv) == bias {
                            tag = 4
                            nb += 1
                        }
                    } else if (ct == 2 && ((dt == 3 && bias == 0) || dt == 4)) || (dt == 2 && ((ct == 3 && bias == 0) || ct == 4)) {
                        tag = 5
                        nadd += 1
                    }
                } else if db == 8 && ct == 6 && dt == 8 && mir_iand_value(&f, &vals, ld) == limit {
                    tag = 7
                    nc += 1
                }
            }
            if tag == 0 { << false }
            if f.temps[da] != 1 && !(tag == 7 && f.temps[da] == 2) { << false }
            tags[da] = tag
            vals[da] = val
        } else { << false }
        ii = mfn_inext(&f.instrs, ii)
    }
    cond := f.blocks[bi].ta
    if cond < 0 || cond >= tags.len || tags[cond] != 7 { << false }
    if bias != 0 && nb != 1 { << false }
    << ni == 1 && na == 1 && nm == 1 && nb <= 1 && ns == 1 && nc == 1 && nadd == 1
}

pub fn mir_mul_iand_body_proved(m &Mir, fi int, bi int, ind int, acc int, mask int, fac int, limit int) bool {
    if fi < 0 || fi >= m.fns.len || bi < 0 || bi >= mir_nblocks(m, fi) || limit <= 16 { << false }
    if mir_btkind(m, fi, bi) != 2 || mir_btb(m, fi, bi) != bi || mir_btc(m, fi, bi) == bi { << false }
    if mir_nblocks(m, fi) > 32 || mir_nins(m, fi) > 256 || mir_ntemps(m, fi) > 256 { << false }
    if !mir_verify_emission_calls(m, fi) { << false }
    $f := mir_cfg_clone_fn(m, fi, false)
    if f.phis.len != 0 { << false }
    if ind < 0 || acc < 0 || ind >= f.locals.len || acc >= f.locals.len || ind == acc { << false }
    if f.locals[ind] != 1 || f.locals[acc] != 1 || f.locals_nslots[ind] != 1 || f.locals_nslots[acc] != 1 { << false }
    if !mir_iand_entry_guard(&f, bi, ind, limit, f.blocks[bi].tc) { << false }
    if fac < 0 || fac >= f.locals.len || fac == ind || fac == acc { << false }
    if f.locals[fac] != 1 || f.locals_nslots[fac] != 1 { << false }
    // No address of a recurrence/factor local may escape anywhere in the
    // function. The complete body below rejects all memory and call effects.
    for at in 0:f.instrs.len {
        if mfn_ikind(&f.instrs, at) == MI_ADDR {
            loc := mfn_ib(&f.instrs, at)
            if loc == ind || loc == acc || loc == fac { << false }
        }
    }
    $defs := []int{}
    mir_count_temp_defs(&f, $&defs)
    $tags := []int{}
    $vals := []int{}
    for _ in 0:f.temps.len {
        tags.push(0)
        vals.push(0)
    }
    $ni := 0
    $na := 0
    $nm := 0
    $nx := 0
    $ns := 0
    $nc := 0
    $nadd := 0
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        k := mfn_ikind(&f.instrs, ii)
        da := mfn_ia(&f.instrs, ii)
        db := mfn_ib(&f.instrs, ii)
        if k == MI_NOP {
            ii = mfn_inext(&f.instrs, ii)
            ->
        }
        if k == MI_STORE_LOCAL {
            tag := mir_iand_tag(&f, &tags, db)
            if da == ind && tag == 6 && ni == 0 { ni = 1 }
            else if da == acc && tag == 5 && na == 0 { na = 1 }
            else { << false }
        } else if k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_BIN {
            if da < 0 || da >= tags.len || defs[da] != 1 || f.temps_nslots[da] != 1 { << false }
            if mir_temp_used_outside(&f, da, bi) { << false }
            $tag := 0
            $val := 0
            if k == MI_COPY {
                tag = mir_iand_tag(&f, &tags, db)
                if tag == 8 { val = mir_iand_value(&f, &vals, db) }
            } else if k == MI_LOAD_LOCAL {
                if db == ind {
                    tag = 1
                    if ni != 0 { tag = 6 }
                } else if db == acc && na == 0 { tag = 2 }
                else if db == fac { tag = 9 }
            } else {
                lc := mfn_ic(&f.instrs, ii)
                ld := mfn_id(&f.instrs, ii)
                ct := mir_iand_tag(&f, &tags, lc)
                dt := mir_iand_tag(&f, &tags, ld)
                if db == 14 && ((ct == 10 && dt == 8) || (ct == 8 && dt == 10)) {
                    $cv := lc
                    if dt == 8 { cv = ld }
                    if mir_iand_value(&f, &vals, cv) == mask {
                        tag = 3
                        nm += 1
                    }
                } else if db == 1 {
                    if (ct == 1 && dt == 8) || (ct == 8 && dt == 1) {
                        $cv := lc
                        if dt == 8 { cv = ld }
                        if mir_iand_value(&f, &vals, cv) == 1 {
                            tag = 6
                            ns += 1
                        }
                    } else if (ct == 2 && dt == 3) || (dt == 2 && ct == 3) {
                        tag = 5
                        nadd += 1
                    }
                } else if db == 3 && ((ct == 1 && dt == 9) || (ct == 9 && dt == 1)) {
                    tag = 10
                    nx += 1
                } else if db == 8 && ct == 6 && dt == 8 && mir_iand_value(&f, &vals, ld) == limit {
                    tag = 7
                    nc += 1
                }
            }
            if tag == 0 { << false }
            if f.temps[da] != 1 && !(tag == 7 && f.temps[da] == 2) { << false }
            tags[da] = tag
            vals[da] = val
        } else { << false }
        ii = mfn_inext(&f.instrs, ii)
    }
    cond := f.blocks[bi].ta
    if cond < 0 || cond >= tags.len || tags[cond] != 7 { << false }
    << ni == 1 && na == 1 && nm == 1 && nx == 1 && ns == 1 && nc == 1 && nadd == 1
}

// SSA form of the same recurrences. Header `bi` branches to a latch that
// only moves (i_next, s_next) back into the phis (i_phi, s_phi), or to the
// exit. Every other entry is a jump whose i_phi copy is a constant below the
// limit, so the scalar do-while and a counted replacement agree. Only
// i_next and s_next may be observed after the loop.
pub struct MirIandSsa {
    pub ok bool
    pub mul bool
    pub exit int
    pub i_phi int
    pub s_phi int
    pub i_next int
    pub s_next int
    pub fac int
    pub mask int
    pub bias int
    pub limit int
}

pub fn mir_iand_ssa_none() MirIandSsa {
    << MirIandSsa{ok: false, mul: false, exit: -1, i_phi: -1, s_phi: -1, i_next: -1, s_next: -1, fac: -1, mask: 0, bias: 0, limit: 0}
}

fn mir_iand_ssa_tag(f &MFn, tags &[]int, inloop &[]bool, ip int, sp int, v int) int {
    if v <= -2 && -v - 2 < f.consts.len { << 8 }
    if v < 0 || v >= tags.len { << 0 }
    if v == ip { << 1 }
    if v == sp { << 2 }
    if !inloop[v] { << 9 }
    << tags[v]
}

fn mir_iand_ssa_used_beyond(f &MFn, t int, b1 int, b2 int) bool {
    for bj in 0:f.blocks.len {
        if bj == b1 || bj == b2 { -> }
        $ii := f.blocks[bj].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            if f.instr_uses_temp(ii, t) { << true }
            ii = mfn_inext(&f.instrs, ii)
        }
        tk := f.blocks[bj].tkind
        if (tk == 2 || tk == 3) && mir_val_is_temp_t(f.blocks[bj].ta, t) { << true }
    }
    << false
}

// Follows single-definition copies to a constant; -1 index when unknown.
fn mir_iand_ssa_const_ix(f &MFn, defs &[]int, v0 int) int {
    $v := v0
    for _ in 0:8 {
        if v <= -2 {
            if -v - 2 < f.consts.len { << -v - 2 }
            << -1
        }
        if v < 0 || v >= defs.len || defs[v] != 1 { << -1 }
        $src := -3 - f.consts.len
        for bj in 0:f.blocks.len {
            $ii := f.blocks[bj].head
            for _ in 0:f.instrs.len {
                if ii < 0 { <- }
                k := mfn_ikind(&f.instrs, ii)
                if mir_instr_has_dest(k) && mfn_ia(&f.instrs, ii) == v {
                    if k != MI_COPY { << -1 }
                    src = mfn_ib(&f.instrs, ii)
                }
                ii = mfn_inext(&f.instrs, ii)
            }
        }
        if src == -3 - f.consts.len { << -1 }
        v = src
    }
    << -1
}

fn mir_iand_ssa_body(f &MFn, bi int, ip int, sp int, inext int, snext int, defs &[]int, inloop &[]bool) MirIandSsa {
    $r := mir_iand_ssa_none()
    $tags := []int{}
    $vals := []int{}
    for _ in 0:f.temps.len {
        tags.push(0)
        vals.push(0)
    }
    $nm := 0
    $nx := 0
    $ns := 0
    $nb := 0
    $nc := 0
    $nadd := 0
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        k := mfn_ikind(&f.instrs, ii)
        if k == MI_NOP {
            ii = mfn_inext(&f.instrs, ii)
            ->
        }
        if k != MI_COPY && k != MI_BIN { << r }
        da := mfn_ia(&f.instrs, ii)
        db := mfn_ib(&f.instrs, ii)
        if da < 0 || da >= tags.len || da == ip || da == sp || defs[da] != 1 || f.temps_nslots[da] != 1 { << r }
        $tag := 0
        $val := 0
        if k == MI_COPY {
            tag = mir_iand_ssa_tag(f, &tags, inloop, ip, sp, db)
            if tag == 8 { val = mir_iand_value(f, &vals, db) }
            if tag == 9 { tag = 0 }
        } else {
            lc := mfn_ic(&f.instrs, ii)
            ld := mfn_id(&f.instrs, ii)
            ct := mir_iand_ssa_tag(f, &tags, inloop, ip, sp, lc)
            dt := mir_iand_ssa_tag(f, &tags, inloop, ip, sp, ld)
            $cv := lc
            if dt == 8 { cv = ld }
            if db == 14 && (((ct == 1 || ct == 10) && dt == 8) || (ct == 8 && (dt == 1 || dt == 10))) {
                tag = 3
                nm += 1
                r.mask = mir_iand_value(f, &vals, cv)
                if ct == 10 || dt == 10 { r.mul = true }
            } else if db == 3 && ((ct == 1 && dt == 9) || (ct == 9 && dt == 1)) {
                tag = 10
                nx += 1
                r.fac = lc
                if dt == 9 { r.fac = ld }
            } else if db == 1 {
                if (ct == 1 && dt == 8) || (ct == 8 && dt == 1) {
                    if mir_iand_value(f, &vals, cv) == 1 {
                        tag = 6
                        ns += 1
                    }
                } else if (ct == 3 && dt == 8) || (ct == 8 && dt == 3) {
                    tag = 4
                    nb += 1
                    r.bias = mir_iand_value(f, &vals, cv)
                } else if (ct == 2 && (dt == 3 || dt == 4)) || (dt == 2 && (ct == 3 || ct == 4)) {
                    tag = 5
                    nadd += 1
                }
            } else if db == 8 && ct == 6 && dt == 8 {
                tag = 7
                nc += 1
                r.limit = mir_iand_value(f, &vals, ld)
            }
        }
        if tag == 0 { << r }
        if f.temps[da] != 1 && !(tag == 7 && f.temps[da] == 2) { << r }
        if da != inext && da != snext && mir_temp_used_outside(f, da, bi) { << r }
        tags[da] = tag
        vals[da] = val
        ii = mfn_inext(&f.instrs, ii)
    }
    cond := f.blocks[bi].ta
    if cond < 0 || cond >= tags.len || tags[cond] != 7 { << r }
    if nm != 1 || ns != 1 || nc != 1 || nadd != 1 || nb > 1 { << r }
    if r.mul && (nx != 1 || nb != 0) { << r }
    if !r.mul && nx != 0 { << r }
    if r.limit <= 16 { << r }
    if inext < 0 || snext < 0 || tags[inext] != 6 || tags[snext] != 5 { << r }
    r.i_phi = ip
    r.s_phi = sp
    r.i_next = inext
    r.s_next = snext
    r.exit = f.blocks[bi].tc
    r.ok = true
    << r
}

pub fn mir_iand_ssa_match(m &Mir, fi int, bi int) MirIandSsa {
    none := mir_iand_ssa_none()
    if fi < 0 || fi >= m.fns.len || bi < 0 { << none }
    nblk := mir_nblocks(m, fi)
    if bi >= nblk || nblk > 64 || mir_nins(m, fi) > 512 || mir_ntemps(m, fi) > 512 { << none }
    if mir_btkind(m, fi, bi) != 2 { << none }
    lb := mir_btb(m, fi, bi)
    ex := mir_btc(m, fi, bi)
    if lb < 0 || lb >= nblk || ex < 0 || ex >= nblk || lb == bi || ex == bi || lb == ex { << none }
    if mir_btkind(m, fi, lb) != 1 || mir_bta(m, fi, lb) != bi { << none }
    $ncopy := 0
    $ii := mir_bhead(m, fi, lb)
    for _ in 0:mir_nins(m, fi) {
        if ii < 0 { <- }
        k := mir_ikind(m, fi, ii)
        if k == MI_COPY { ncopy += 1 } else if k != MI_NOP { << none }
        ii = mir_inext(m, fi, ii)
    }
    if ncopy != 2 { << none }
    f := mir_cfg_clone_fn(m, fi, false)
    if f.phis.len != 0 { << none }
    $dst := []int{}
    $src := []int{}
    ii = f.blocks[lb].head
    for _ in 0:f.instrs.len {
        if ii < 0 { <- }
        if mfn_ikind(&f.instrs, ii) == MI_COPY {
            dst.push(mfn_ia(&f.instrs, ii))
            src.push(mfn_ib(&f.instrs, ii))
        }
        ii = mfn_inext(&f.instrs, ii)
    }
    nt := f.temps.len
    for c in 0:2 {
        if dst[c] < 0 || dst[c] >= nt || src[c] < 0 || src[c] >= nt { << none }
        if f.temps[dst[c]] != 1 || f.temps_nslots[dst[c]] != 1 { << none }
    }
    if dst[0] == dst[1] { << none }
    $defs := []int{}
    mir_count_temp_defs(&f, $&defs)
    $inloop := []bool{}
    for _ in 0:nt { inloop.push(false) }
    for b in 0:2 {
        $blk := bi
        if b == 1 { blk = lb }
        ii = f.blocks[blk].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if mir_instr_has_dest(k) {
                d := mfn_ia(&f.instrs, ii)
                if d >= 0 && d < nt { inloop[d] = true }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    $r := mir_iand_ssa_body(&f, bi, dst[0], dst[1], src[0], src[1], &defs, &inloop)
    if !r.ok { r = mir_iand_ssa_body(&f, bi, dst[1], dst[0], src[1], src[0], &defs, &inloop) }
    if !r.ok { << none }
    if r.mul && (r.fac < 0 || r.fac >= nt || f.temps[r.fac] != 1 || f.temps_nslots[r.fac] != 1) { << none }
    if mir_iand_ssa_used_beyond(&f, r.i_phi, bi, lb) || mir_iand_ssa_used_beyond(&f, r.s_phi, bi, lb) { << none }
    for pi in 0:f.blocks.len {
        if pi == bi { -> }
        tk := f.blocks[pi].tkind
        if tk == 2 && (f.blocks[pi].tb == lb || f.blocks[pi].tc == lb) { << none }
        if tk == 1 && f.blocks[pi].ta == lb && pi != bi { << none }
    }
    $entries := 0
    for pi in 0:f.blocks.len {
        if pi == lb { -> }
        tk := f.blocks[pi].tkind
        if tk == 2 && (f.blocks[pi].tb == bi || f.blocks[pi].tc == bi) { << none }
        if tk != 1 || f.blocks[pi].ta != bi { -> }
        entries += 1
        $init := -3 - f.consts.len
        ii = f.blocks[pi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            if k == MI_CHAN_TRY_RECV && (mfn_ia(&f.instrs, ii) == r.i_phi || mfn_ib(&f.instrs, ii) == r.i_phi) { << none }
            if mir_instr_has_dest(k) && mfn_ia(&f.instrs, ii) == r.i_phi {
                if k != MI_COPY { << none }
                init = mfn_ib(&f.instrs, ii)
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        if init == -3 - f.consts.len { << none }
        cix := mir_iand_ssa_const_ix(&f, &defs, init)
        if cix < 0 || f.consts[cix] >= r.limit { << none }
    }
    if entries == 0 { << none }
    if r.mul && !mir_verify_emission_calls(m, fi) { << none }
    << r
}
