@xu/types

#xu/ast
#xu/parser

// kind: 0 = no barrier, 1 = loop/select, 2 = if/match (MS6 as-consume).
fn (c &mut Checker) push_scope(kind int) {
    n := c.lname.len // hoisted: the push mutably borrows `c`
    c.marks.push(n)
    if kind > 0 {
        mut mark := n
        if kind == 2 {
            mark = 0 - n - 1
        }
        c.barriers.push(mark)
        m := c.pend_ids.len // hoisted: the push mutably borrows `c`
        c.pend_marks.push(m)
    }
}

fn barrier_locals(b int) int {
    if b < 0 {
        << 0 - b - 1
    }
    << b
}

// `term` = the body's last statement was a <<. a barrier scope whose
// deferred moves were confined to a <<-terminated body leaves the
// locals unmoved (the fall-through path never sees the moves); otherwise
// the first deferred move is the M2b violation.
fn (c &mut Checker) pop_scope(p &parser.Parser, barrier bool, term bool) {
    mark := c.marks[c.marks.len - 1]
    for i in mark:c.lname.len {
        nid := c.lname_id[i]
        if nid >= 0 && nid < c.lhead.len && c.lactive[i] != 0 {
            si1001 := c.lprev[i]
            checker_set_i(mut &c.lhead, nid, si1001)
        }
        checker_set_i(mut &c.lactive, i, 0)
    }
    // pop the mark (no truncate in Xu: rewrite a shortened copy)
    mut ms := []int{}
    for i in 0:c.marks.len - 1 {
        ms.push(c.marks[i])
    }
    c.marks = ms
    if barrier {
        mut bs := []int{}
        for i in 0:c.barriers.len - 1 {
            bs.push(c.barriers[i])
        }
        c.barriers = bs
        pm := c.pend_marks[c.pend_marks.len - 1]
        mut pms := []int{}
        for i in 0:c.pend_marks.len - 1 {
            pms.push(c.pend_marks[i])
        }
        c.pend_marks = pms
        if c.pend_ids.len > pm {
            if term {
                for i in pm:c.pend_ids.len {
                    c.lmoved[c.pend_ids[i]] = 0
                }
            } else {
                c.fail_node(p, c.pend_nodes[pm], "cannot move '" + c.lname[c.pend_ids[pm]] + "' out of a conditional or loop scope (M2b)")
            }
            mut pi := []int{}
            mut pn := []int{}
            for i in 0:c.pend_ids.len {
                if i < pm {
                    pi.push(c.pend_ids[i])
                    pn.push(c.pend_nodes[i])
                }
            }
            c.pend_ids = pi
            c.pend_nodes = pn
        }
    }
}

fn field_bit(fi int) int {
    if fi < 0 || fi >= 63 {
        << 0
    }
    << (1 << fi)
}

fn (c &Checker) as_const_index(p &parser.Parser, n int) int {
    if !c.is_const_int_expr(p, n) {
        << -1
    }
    iv := c.const_int_expr_value(p, n)
    if iv < 0 || iv >= 63 {
        << -1
    }
    << iv
}

// Ident root of a Field/Index `as` place (`xs[0].e` → local `xs`).
fn (c &Checker) as_top_field_id(p &parser.Parser, n int) int {
    mut x := n
    for _ in 0:p.nodes.len {
        k := p.nodes[x].kind
        if k != ast.NK_FIELD && k != ast.NK_INDEX {
            << -1
        }
        obj := p.nodes[x].a
        if p.nodes[obj].kind == ast.NK_IDENT {
            << c.nlocal[obj]
        }
        x = obj
    }
    << -1
}

fn (c &Checker) as_top_field_fi(p &parser.Parser, n int) int {
    mut x := n
    for _ in 0:p.nodes.len {
        if p.nodes[x].kind != ast.NK_FIELD {
            << -1
        }
        obj := p.nodes[x].a
        if p.nodes[obj].kind == ast.NK_IDENT {
            << c.nlocal[x]
        }
        x = obj
    }
    << -1
}

// Packed Ident-rooted Field/const-Index path (root-first, base 64, digit = id+1).
// Starts at Field or Index. Const Index 0..62 is a digit; runtime Index → 0.
// Depth 1 → path in 1..63; depth>=2 → path>=64; 0 = not a packed place.
fn (c &Checker) as_place_path(p &parser.Parser, n int) int {
    k0 := p.nodes[n].kind
    if k0 != ast.NK_FIELD && k0 != ast.NK_INDEX {
        << 0
    }
    mut fis := []int{}
    mut x := n
    for _ in 0:p.nodes.len {
        k := p.nodes[x].kind
        if k == ast.NK_FIELD {
            fi := c.nlocal[x]
            if fi < 0 || fi >= 63 {
                << 0
            }
            fis.push(fi)
            x = p.nodes[x].a
        } else {
            if k == ast.NK_INDEX {
                ei := c.as_const_index(p, p.nodes[x].b)
                if ei < 0 {
                    << 0
                }
                fis.push(ei)
                x = p.nodes[x].a
            } else {
                if k == ast.NK_IDENT {
                    if fis.len < 1 || fis.len > 8 {
                        << 0
                    }
                    mut path := 0
                    mut d := fis.len - 1
                    for _ in 0:fis.len {
                        path = path * 64 + (fis[d] + 1)
                        d -= 1
                    }
                    << path
                }
                << 0
            }
        }
    }
    << 0
}

fn path_is_prefix(short int, long int) bool {
    if short <= 0 || long <= 0 {
        << false
    }
    if short == long {
        << true
    }
    mut x := long
    for _ in 0:8 {
        x = x / 64
        if x <= 0 {
            << false
        }
        if x == short {
            << true
        }
    }
    << false
}

fn (c &Checker) lp_get(id int, slot int) int {
    i := id * 4 + slot
    if i < 0 || i >= c.lfpath.len {
        << 0
    }
    << c.lfpath[i]
}

fn (c &mut Checker) lp_set(id int, slot int, v int) {
    i := id * 4 + slot
    if i < 0 || i >= c.lfpath.len {
        <<
    }
    checker_set_i(mut &c.lfpath, i, v)
}

fn (c &Checker) lp_any(id int) bool {
    if id < 0 {
        << false
    }
    for s in 0:4 {
        if c.lp_get(id, s) != 0 {
            << true
        }
    }
    << false
}

fn (c &mut Checker) lp_clear(id int) {
    for s in 0:4 {
        c.lp_set(id, s, 0)
    }
}

fn (c &Checker) lp_has(id int, path int) bool {
    if path == 0 {
        << false
    }
    for s in 0:4 {
        if c.lp_get(id, s) == path {
            << true
        }
    }
    << false
}

fn (c &mut Checker) lp_add(id int, path int) bool {
    if path == 0 {
        << false
    }
    if c.lp_has(id, path) {
        << true
    }
    for s in 0:4 {
        if c.lp_get(id, s) == 0 {
            c.lp_set(id, s, path)
            << true
        }
    }
    << false
}

fn (c &mut Checker) lp_clear_at(id int, path int) {
    if path == 0 {
        <<
    }
    mut keep := []int{}
    for s in 0:4 {
        lp := c.lp_get(id, s)
        if lp == 0 {
            ->
        }
        if lp == path || path_is_prefix(path, lp) {
            ->
        }
        keep.push(lp)
    }
    c.lp_clear(id)
    for i in 0:keep.len {
        c.lp_add(id, keep[i])
    }
}

fn (c &Checker) field_cons_any(id int) bool {
    if id < 0 {
        << false
    }
    if id < c.lfcons.len && c.lfcons[id] != 0 {
        << true
    }
    << c.lp_any(id)
}

// MS6: snapshot / restore / union / finish for if+match as-consume join.
fn (c &mut Checker) as_join_snap() []int {
    mut snap := []int{}
    for i in 0:c.lmoved.len {
        snap.push(c.lmoved[i])
    }
    off := c.aj_fc.len
    c.aj_off.push(off)
    nfc := c.lfcons.len
    for i in 0:nfc {
        v := c.lfcons[i]
        c.aj_fc.push(v)
        c.aj_union.push(0)
        for s in 0:4 {
            pv := c.lp_get(i, s)
            c.aj_path.push(pv)
            c.aj_path_u.push(0)
        }
    }
    << snap
}

fn (c &mut Checker) as_join_restore(snap &[]int) {
    n0 := snap.len
    for i in 0:n0 {
        if i < c.lmoved.len {
            checker_set_i(mut &c.lmoved, i, snap[i])
        }
    }
    if c.aj_off.len == 0 {
        <<
    }
    off := c.aj_off[c.aj_off.len - 1]
    n1 := c.aj_fc.len - off
    for i in 0:n1 {
        if i < c.lfcons.len {
            v := c.aj_fc[off + i]
            checker_set_i(mut &c.lfcons, i, v)
        }
        base := (off + i) * 4
        for s in 0:4 {
            mut pv := 0
            if base + s < c.aj_path.len {
                pv = c.aj_path[base + s]
            }
            c.lp_set(i, s, pv)
        }
    }
}

fn (c &mut Checker) as_join_after_arm(snap &[]int, term bool, join_cons &mut []int) {
    if term {
        <<
    }
    n0 := snap.len
    for i in 0:n0 {
        if i < c.lmoved.len && c.lmoved[i] != 0 && snap[i] == 0 && (is_as_box(c.ltype[i]) || is_struct_type(c.ltype[i]) || is_array_type(c.ltype[i])) {
            mut seen := false
            for j in 0:join_cons.len {
                if join_cons[j] == i {
                    seen = true
                }
            }
            if !seen {
                join_cons.push(i)
            }
        }
    }
    if c.aj_off.len == 0 {
        <<
    }
    off := c.aj_off[c.aj_off.len - 1]
    n1 := c.aj_fc.len - off
    for i in 0:n1 {
        if i < c.lfcons.len {
            cur := c.lfcons[i]
            old := c.aj_fc[off + i]
            newly := cur - (cur & old)
            if newly != 0 {
                u := c.aj_union[off + i] | newly
                c.aj_union[off + i] = u
            }
        }
        snap_base := (off + i) * 4
        un_base := (off + i) * 4
        for s in 0:4 {
            curp := c.lp_get(i, s)
            if curp == 0 {
                ->
            }
            mut in_snap := false
            for t in 0:4 {
                if snap_base + t < c.aj_path.len && c.aj_path[snap_base + t] == curp {
                    in_snap = true
                }
            }
            if in_snap {
                ->
            }
            mut placed := false
            for t in 0:4 {
                if !placed && un_base + t < c.aj_path_u.len {
                    if c.aj_path_u[un_base + t] == 0 {
                        c.aj_path_u[un_base + t] = curp
                        placed = true
                    } else if c.aj_path_u[un_base + t] == curp {
                        placed = true
                    }
                }
            }
        }
    }
}

fn (c &mut Checker) as_join_finish(snap &[]int, join_cons []int) {
    c.as_join_restore(snap)
    for j in 0:join_cons.len {
        id := join_cons[j]
        if id >= 0 && id < c.lmoved.len {
            checker_set_i(mut &c.lmoved, id, 1)
        }
    }
    if c.aj_off.len == 0 {
        <<
    }
    off := c.aj_off[c.aj_off.len - 1]
    n1 := c.aj_fc.len - off
    for i in 0:n1 {
        if i < c.lfcons.len {
            u := c.aj_union[off + i]
            si1 := c.lfcons[i] | u
            checker_set_i(mut &c.lfcons, i, si1)
        }
        un_base := (off + i) * 4
        for s in 0:4 {
            mut up := 0
            if un_base + s < c.aj_path_u.len {
                up = c.aj_path_u[un_base + s]
            }
            if up != 0 {
                if !c.lp_add(i, up) {
                    if i < c.lmoved.len {
                        checker_set_i(mut &c.lmoved, i, 1)
                    }
                }
            }
        }
    }
    mut fc := []int{}
    mut un := []int{}
    mut pth := []int{}
    mut pthu := []int{}
    poff := off * 4
    for i in 0:off {
        fc.push(c.aj_fc[i])
        un.push(c.aj_union[i])
    }
    for i in 0:poff {
        pth.push(c.aj_path[i])
        pthu.push(c.aj_path_u[i])
    }
    c.aj_fc = fc
    c.aj_union = un
    c.aj_path = pth
    c.aj_path_u = pthu
    mut offs := []int{}
    for i in 0:c.aj_off.len - 1 {
        offs.push(c.aj_off[i])
    }
    c.aj_off = offs
}

fn stmt_always_exit(p &parser.Parser, n int) bool {
    if n < 0 {
        << false
    }
    k := p.nodes[n].kind
    if k == ast.NK_RETURN || k == ast.NK_BREAK || k == ast.NK_CONTINUE || k == ast.NK_THROW || k == ast.NK_EXIT {
        << true
    }
    if k == ast.NK_IF {
        mut br := p.nodes[n].a
        mut has_else := false
        mut all := true
        while br >= 0 {
            if p.nodes[br].a < 0 {
                has_else = true
            }
            if !stmts_always_exit(p, p.nodes[br].b) {
                all = false
            }
            br = p.nodes[br].next
        }
        << all && has_else
    }
    if k == ast.NK_MATCH {
        mut ar := p.nodes[n].b
        mut all := true
        mut has_else := false
        while ar >= 0 {
            if p.nodes[ar].kind == ast.NK_ARM_ELSE {
                has_else = true
            }
            if !stmts_always_exit(p, p.nodes[ar].c) {
                all = false
            }
            ar = p.nodes[ar].next
        }
        << all && has_else
    }
    if k == ast.NK_SELECT {
        mut ar := p.nodes[n].a
        mut all := true
        while ar >= 0 {
            if !stmts_always_exit(p, p.nodes[ar].c) {
                all = false
            }
            ar = p.nodes[ar].next
        }
        if p.nodes[n].c < 0 {
            << false
        }
        << all && stmts_always_exit(p, p.nodes[n].c)
    }
    << false
}

fn stmts_always_exit(p &parser.Parser, first int) bool {
    mut s := first
    mut last := -1
    while s >= 0 {
        last = s
        s = p.nodes[s].next
    }
    << stmt_always_exit(p, last)
}

fn (c &mut Checker) loop_as_enter() {
    off := c.las_snap.len
    n0 := c.lmoved.len
    c.las_off.push(off)
    for i in 0:n0 {
        mv := c.lmoved[i]
        c.las_snap.push(mv)
        c.las_brk.push(0)
        c.las_back.push(0)
        mut fc := 0
        if i < c.lfcons.len {
            fc = c.lfcons[i]
        }
        c.las_fc.push(fc)
        c.las_fc_brk.push(0)
        c.las_fc_back.push(0)
        for s in 0:4 {
            pv2 := c.lp_get(i, s)
            c.las_path.push(pv2)
            c.las_path_brk.push(0)
            c.las_path_back.push(0)
        }
    }
}

fn (c &mut Checker) loop_as_union(into_brk bool) {
    if c.las_off.len == 0 {
        <<
    }
    off := c.las_off[c.las_off.len - 1]
    n0 := c.las_snap.len - off
    for i in 0:n0 {
        mut hit := false
        if i < c.lmoved.len {
            if c.lmoved[i] != 0 && c.las_snap[off + i] == 0 && (is_as_box(c.ltype[i]) || is_struct_type(c.ltype[i]) || is_array_type(c.ltype[i])) {
                hit = true
            }
        }
        if hit {
            if into_brk {
                c.las_brk[off + i] = 1
            } else {
                c.las_back[off + i] = 1
            }
        }
        mut newly := 0
        if i < c.lfcons.len {
            cur := c.lfcons[i]
            old := c.las_fc[off + i]
            newly = cur - (cur & old)
        }
        if newly != 0 {
            if into_brk {
                u := c.las_fc_brk[off + i] | newly
                c.las_fc_brk[off + i] = u
            } else {
                u2 := c.las_fc_back[off + i] | newly
                c.las_fc_back[off + i] = u2
            }
        }
        pbase := (off + i) * 4
        for s in 0:4 {
            curp := c.lp_get(i, s)
            if curp == 0 {
                ->
            }
            mut in_snap := false
            for t in 0:4 {
                if pbase + t < c.las_path.len && c.las_path[pbase + t] == curp {
                    in_snap = true
                }
            }
            if in_snap {
                ->
            }
            mut placed := false
            for t in 0:4 {
                if placed {
                    ->
                }
                idx := pbase + t
                if into_brk {
                    if idx < c.las_path_brk.len {
                        if c.las_path_brk[idx] == 0 {
                            c.las_path_brk[idx] = curp
                            placed = true
                        } else if c.las_path_brk[idx] == curp {
                            placed = true
                        }
                    }
                } else {
                    if idx < c.las_path_back.len {
                        if c.las_path_back[idx] == 0 {
                            c.las_path_back[idx] = curp
                            placed = true
                        } else if c.las_path_back[idx] == curp {
                            placed = true
                        }
                    }
                }
            }
        }
    }
}

fn (c &Checker) loop_as_zero_iters(p &parser.Parser, n int) bool {
    k := p.nodes[n].kind
    if k == ast.NK_FOR {
        if !c.is_expr_int(p, p.nodes[n].a) || !c.is_expr_int(p, p.nodes[n].b) {
            << false
        }
        a := c.expr_int_value(p, p.nodes[n].a)
        b := c.expr_int_value(p, p.nodes[n].b)
        << b <= a
    }
    if k == ast.NK_WHILE {
        cond := p.nodes[n].a
        << p.nodes[cond].kind == ast.NK_BOOL && p.nodes[cond].ival == 0
    }
    << false
}

// Exact lower bound when known (const / lconst); -1 if unknown.
fn (c &Checker) expr_int_lb(p &parser.Parser, n int) int {
    if c.is_expr_int(p, n) {
        << c.expr_int_value(p, n)
    }
    << -1
}

// Upper bound: exact value, else lub; -1 if unknown.
// Add/mul close `i*n+j` when i,j have lub and n is const.
fn (c &Checker) expr_int_ub(p &parser.Parser, n int) int {
    if c.is_expr_int(p, n) {
        << c.expr_int_value(p, n)
    }
    if n < 0 {
        << -1
    }
    if p.nodes[n].kind == ast.NK_IDENT {
        lid := c.nlocal[n]
        if lid >= 0 && lid < c.lub_ok.len && c.lub_ok[lid] != 0 {
            << c.lub[lid]
        }
        << -1
    }
    if p.nodes[n].kind != ast.NK_BIN_OP {
        << -1
    }
    op := p.nodes[n].ival
    if op == 1 {
        a := c.expr_int_ub(p, p.nodes[n].a)
        b := c.expr_int_ub(p, p.nodes[n].b)
        if a >= 0 && b >= 0 && const_binop_ok(1, a, b) {
            << a + b
        }
        << -1
    }
    if op == 3 {
        if c.is_expr_int(p, p.nodes[n].a) {
            k := c.expr_int_value(p, p.nodes[n].a)
            u := c.expr_int_ub(p, p.nodes[n].b)
            if k >= 0 && u >= 0 && const_binop_ok(3, k, u) {
                << k * u
            }
        }
        if c.is_expr_int(p, p.nodes[n].b) {
            k := c.expr_int_value(p, p.nodes[n].b)
            u := c.expr_int_ub(p, p.nodes[n].a)
            if k >= 0 && u >= 0 && const_binop_ok(3, u, k) {
                << u * k
            }
        }
    }
    << -1
}

fn (c &Checker) loop_as_at_most_once(p &parser.Parser, n int) bool {
    if c.loop_as_zero_iters(p, n) {
        << true
    }
    k := p.nodes[n].kind
    if k == ast.NK_FOR {
        if c.is_expr_int(p, p.nodes[n].a) && c.is_expr_int(p, p.nodes[n].b) {
            a := c.expr_int_value(p, p.nodes[n].a)
            b := c.expr_int_value(p, p.nodes[n].b)
            << (b - a) <= 1
        }
        // A2: start exact lb + end ub (assert / if-refined).
        a := c.expr_int_lb(p, p.nodes[n].a)
        b := c.expr_int_ub(p, p.nodes[n].b)
        if a >= 0 && b >= 0 {
            << (b - a) <= 1
        }
        << false
    }
    << false
}

fn (c &mut Checker) loop_as_finish(p &parser.Parser, loop_n int) {
    if c.las_off.len == 0 {
        <<
    }
    off := c.las_off[c.las_off.len - 1]
    n0 := c.las_snap.len - off
    once := c.loop_as_at_most_once(p, loop_n)
    zero := c.loop_as_zero_iters(p, loop_n)
    mut back_id := -1
    for i in 0:n0 {
        if c.las_back[off + i] != 0 {
            if back_id < 0 {
                back_id = i
            }
        }
        if c.las_fc_back[off + i] != 0 {
            if back_id < 0 {
                back_id = i
            }
        }
        pbase := (off + i) * 4
        for s in 0:4 {
            if pbase + s < c.las_path_back.len && c.las_path_back[pbase + s] != 0 {
                if back_id < 0 {
                    back_id = i
                }
            }
        }
    }
    if back_id >= 0 && !once {
        nm := c.lname[back_id]
        c.fail_node(p, loop_n, "use of moved value '" + nm + "'")
    }
    for i in 0:n0 {
        if i < c.lmoved.len {
            si2 := c.las_snap[off + i]
            checker_set_i(mut &c.lmoved, i, si2)
            if c.las_brk[off + i] != 0 || (c.las_back[off + i] != 0 && !zero) {
                checker_set_i(mut &c.lmoved, i, 1)
            }
        }
        if i < c.lfcons.len {
            mut v := c.las_fc[off + i] | c.las_fc_brk[off + i]
            if !zero {
                v = v | c.las_fc_back[off + i]
            }
            checker_set_i(mut &c.lfcons, i, v)
        }
        pbase := (off + i) * 4
        for s in 0:4 {
            mut pv := 0
            if pbase + s < c.las_path.len {
                pv = c.las_path[pbase + s]
            }
            c.lp_set(i, s, pv)
        }
        for s in 0:4 {
            mut bp := 0
            if pbase + s < c.las_path_brk.len {
                bp = c.las_path_brk[pbase + s]
            }
            if bp != 0 {
                if !c.lp_add(i, bp) {
                    if i < c.lmoved.len {
                        checker_set_i(mut &c.lmoved, i, 1)
                    }
                }
            }
            if !zero {
                mut bakp := 0
                if pbase + s < c.las_path_back.len {
                    bakp = c.las_path_back[pbase + s]
                }
                if bakp != 0 {
                    if !c.lp_add(i, bakp) {
                        if i < c.lmoved.len {
                            checker_set_i(mut &c.lmoved, i, 1)
                        }
                    }
                }
            }
        }
    }
    mut snap := []int{}
    mut brk := []int{}
    mut bak := []int{}
    mut fc := []int{}
    mut fc_brk := []int{}
    mut fc_bak := []int{}
    mut pth := []int{}
    mut pth_brk := []int{}
    mut pth_bak := []int{}
    poff := off * 4
    for i in 0:off {
        snap.push(c.las_snap[i])
        brk.push(c.las_brk[i])
        bak.push(c.las_back[i])
        fc.push(c.las_fc[i])
        fc_brk.push(c.las_fc_brk[i])
        fc_bak.push(c.las_fc_back[i])
    }
    for i in 0:poff {
        pth.push(c.las_path[i])
        pth_brk.push(c.las_path_brk[i])
        pth_bak.push(c.las_path_back[i])
    }
    c.las_snap = snap
    c.las_brk = brk
    c.las_back = bak
    c.las_fc = fc
    c.las_fc_brk = fc_brk
    c.las_fc_back = fc_bak
    c.las_path = pth
    c.las_path_brk = pth_brk
    c.las_path_back = pth_bak
    mut offs := []int{}
    for i in 0:c.las_off.len - 1 {
        offs.push(c.las_off[i])
    }
    c.las_off = offs
}

fn (c &mut Checker) add_local(name string, ty int, mutable bool) int {
    nid := c.intern_ref(&name)
    while c.lhead.len <= nid {
        c.lhead.push(-1)
    }
    mut prev := -1
    if nid >= 0 && nid < c.lhead.len {
        prev = c.lhead[nid]
    }
    c.lname.push(name)
    c.lname_id.push(nid)
    c.lprev.push(prev)
    c.ltype.push(ty)
    c.lmut.push(b2i(mutable))
    c.lactive.push(1)
    c.lmoved.push(0)
    c.lfcons.push(0)
    c.lfpath.push(0)
    c.lfpath.push(0)
    c.lfpath.push(0)
    c.lfpath.push(0)
    c.lview.push(0)
    c.lorigin.push(-1)
    c.laref.push(-1)
    c.llife.push("")
    c.lrefok.push(0)
    c.lconst.push(0)
    c.lconst_ok.push(0)
    c.lub.push(0)
    c.lub_ok.push(0)
    c.llength.push(0)
    c.llength_ok.push(0)
    c.lnz.push(0)
    c.lnz_ok.push(0)
    c.calias.push(-1)
    c.int_len_of.push(-1)
    if nid >= 0 && nid < c.lhead.len {
        si1002 := c.lname.len - 1
        checker_set_i(mut &c.lhead, nid, si1002)
    }
    << c.lname.len - 1
}

// True if ty is a reference or embeds one (M10/M155).
// M155: also true for capturing fn values whose Env embeds a reference.
fn (c &Checker) type_contains_ref(ty int) bool {
    if is_ref_type(ty) { << true }
    if ty < 50 { << false }
    mut seen := []int{}
    << c.type_ref_walk(ty, mut &seen)
}

// Container edges may point back to a previously visited struct/enum. They
// do not make reference containment false; inspect each reachable type once.
fn (c &Checker) type_ref_walk(ty int, seen &mut []int) bool {
    if is_ref_type(ty) { << true }
    for i in 0:seen.len { if seen[i] == ty { << false } }
    seen.push(ty)
    if is_fn_type(ty) {
        si := ty - 700
        if si >= 0 && si < c.fn_sigs.len && c.fn_sigs[si].has_env == 1 {
            esi := c.fn_sigs[si].env_struct
            if esi >= 0 {
                << c.type_ref_walk(struct_type(esi), seen)
            }
        }
        << false
    }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si >= 0 && si < c.structs.len {
            for i in 0:c.structs[si].fields.len {
                if c.type_ref_walk(c.structs[si].fields[i].ty, seen) { << true }
            }
        }
    }
    if is_array_type(ty) {
        ai := ty - 200
        if ai >= 0 && ai < c.arrays.len {
            << c.type_ref_walk(c.arrays[ai].elem_ty, seen)
        }
    }
    if is_throw_type(ty) {
        ri := throw_index(ty)
        if ri >= 0 && ri < c.throws.len {
            << c.type_ref_walk(c.throws[ri].ok_ty, seen) || c.type_ref_walk(c.throws[ri].err_ty, seen)
        }
    }
    if is_enum_type(ty) {
        ei := ty - 500
        if ei >= 0 && ei < c.enums.len {
            for vi in 0:c.enums[ei].variants.len {
                for fi in 0:c.enums[ei].variants[vi].fields.len {
                    if c.type_ref_walk(c.enums[ei].variants[vi].fields[fi], seen) { << true }
                }
            }
        }
    }
    if is_chan_type(ty) {
        ci := ty - 600
        if ci >= 0 && ci < c.chans.len {
            << c.type_ref_walk(c.chans[ci].elem_ty, seen)
        }
    }
    if is_map_type(ty) {
        mi := ty - 50
        if mi >= 0 && mi < c.maps.len {
            << c.type_ref_walk(c.maps[mi].key_ty, seen) || c.type_ref_walk(c.maps[mi].val_ty, seen)
        }
    }
    << false
}

// M155: may cross xu / chan (Send). Sync = refs never cross that boundary.
// Dynamic boxes are not Send: the payload is not visible in the static type,
// so a boxed struct-with-ref would otherwise bypass type_contains_ref.
fn (c &Checker) type_is_send(ty int) bool {
    if is_dynamic_box(ty) {
        << false
    }
    << !c.type_contains_ref(ty)
}

// M10 elision: origin of a reference-typed expression.
// Returns param local id (>=0) or -1 for Local (not returnable).
fn (c &Checker) expr_ref_origin(p &parser.Parser, n int) int {
    if n < 0 { << -1 }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT { // Ident
        lid := c.nlocal[n]
        if lid >= 0 && is_ref_type(c.ltype[lid]) {
            << c.lorigin[lid]
        }
        << -1
    }
    if k == ast.NK_BORROW { // Borrow
        // M159 / MS4: reborrow through a ref-typed root (field, `&xs[i]`,
        // `&xs[i].f`, `&n.kids[i].v`) inherits that origin.
        // `mut &*r` / `&*r`: target is Deref; inherit the inner ident.
        target := p.nodes[n].a
        if p.nodes[target].kind == ast.NK_UN_OP && p.nodes[target].ival == 3 {
            inner := p.nodes[target].a
            if p.nodes[inner].kind == ast.NK_IDENT {
                lid := c.nlocal[inner]
                if lid >= 0 && is_ref_type(c.ltype[lid]) {
                    << c.lorigin[lid]
                }
            }
        }
        root := c.borrow_root_local(p, target)
        if root >= 0 && is_ref_type(c.ltype[root]) {
            << c.lorigin[root]
        }
        << -1
    }
    if k == ast.NK_FIELD { // Field
        oty := c.ntype[p.nodes[n].a]
        if is_ref_type(oty) {
            << c.expr_ref_origin(p, p.nodes[n].a)
        }
        // Field of a local struct that stores a ref: Local.
        << -1
    }
    if k == ast.NK_CALL || k == ast.NK_METHOD_CALL { // Call / MethodCall
        // Propagate unique ref-arg origin when call returns a ref.
        mut origins := []int{}
        mut a := p.nodes[n].a
        if k == ast.NK_METHOD_CALL {
            // method: receiver is first arg chain on .b; also check recv obj
            ro := c.expr_ref_origin(p, p.nodes[n].a)
            if ro >= 0 || is_ref_type(c.ntype[p.nodes[n].a]) {
                if is_ref_type(c.ntype[p.nodes[n].a]) {
                    origins.push(c.expr_ref_origin(p, p.nodes[n].a))
                }
            }
            a = p.nodes[n].b
        }
        while a >= 0 {
            if is_ref_type(c.ntype[a]) {
                origins.push(c.expr_ref_origin(p, a))
            }
            a = p.nodes[a].next
        }
        if origins.len == 1 {
            << origins[0]
        }
        << -1
    }
    << -1
}

// M150: every reference leaf in expr (type ty) flows from the unique ref param.
fn (c &Checker) refs_flow_from_param(p &parser.Parser, n int, ty int) bool {
    if n < 0 { << false }
    if is_ref_type(ty) {
        << c.expr_ref_origin(p, n) >= 0
    }
    if !c.type_contains_ref(ty) {
        << true
    }
    k := p.nodes[n].kind
    if k == ast.NK_STRUCT_INIT { // StructInit
        if !is_struct_type(ty) { << false }
        si := struct_index(ty)
        mut sf := p.nodes[n].a
        mut seen := 0
        while sf >= 0 {
        if p.nodes[sf].kind != ast.NK_S_FIELD { << false }
        fi := c.find_field(si, p.nodes[sf].sval)
        if fi < 0 { << false }
        want := c.structs[si].fields[fi].life
        if want.len > 0 && is_ref_type(c.structs[si].fields[fi].ty) {
            origin := c.expr_ref_origin(p, p.nodes[sf].a)
            if origin < 0 || origin >= c.llife.len || c.llife[origin] != want {
                << false
            }
        } else if !c.refs_flow_from_param(p, p.nodes[sf].a, c.structs[si].fields[fi].ty) {
            << false
        }
        seen += 1
        sf = p.nodes[sf].next
        }
        << seen == c.structs[si].fields.len
    }
    // M167: Call with ref args, or Ident local.
    if k == ast.NK_ARRAY_LIT && is_array_type(ty) { // ArrayLit
        ai := ty - 200
        et := c.arrays[ai].elem_ty
        mut e := p.nodes[n].a
        while e >= 0 {
        if !c.refs_flow_from_param(p, e, et) {
            << false
        }
        e = p.nodes[e].next
        }
        << true
    }
    if k == ast.NK_IDENT { // Ident of a tracked struct local
        lid := c.nlocal[n]
        << lid >= 0 && lid < c.lrefok.len && c.lrefok[lid] != 0
    }
    if k == ast.NK_CALL { // Call returning ref-embedding type: unique ref arg must be Param
        mut origins := []int{}
        mut a := p.nodes[n].a
        while a >= 0 {
        if is_ref_type(c.ntype[a]) {
            origins.push(c.expr_ref_origin(p, a))
        }
        a = p.nodes[a].next
        }
        << origins.len == 1 && origins[0] >= 0
    }
    << false
}

// M167: []T << TypeRef leaves — bare elision or explicit `&a` on params.
fn (c &Checker) typeref_has_lifetime(p &parser.Parser, t int, lt string) bool {
    if t < 0 { << false }
    k := p.nodes[t].kind
    if k == ast.NT_REF { // TRef
        if p.nodes[t].sval == lt { << true }
        << c.typeref_has_lifetime(p, p.nodes[t].a, lt)
    }
    if k == ast.NT_ARRAY { // TArray
        << c.typeref_has_lifetime(p, p.nodes[t].a, lt)
    }
    << false
}

fn (c &Checker) fn_introduces_lifetime(p &parser.Parser, fn_n int, lt string) bool {
    if p.nodes[fn_n].d >= 0 {
        rty := p.nodes[p.nodes[fn_n].d].a
        if rty >= 0 && p.nodes[rty].kind == ast.NT_REF && p.nodes[rty].sval == lt {
            << true
        }
    }
    mut prm := p.nodes[fn_n].a
    while prm >= 0 {
    if c.typeref_has_lifetime(p, p.nodes[prm].a, lt) {
        << true
    }
    prm = p.nodes[prm].next
    }
    << false
}

fn (c &Checker) typeref_count_bare_refs(p &parser.Parser, t int) int {
    if t < 0 { << 0 }
    k := p.nodes[t].kind
    if k == ast.NT_REF {
        mut n := 0
        if p.nodes[t].sval.len == 0 { n = 1 }
        << n + c.typeref_count_bare_refs(p, p.nodes[t].a)
    }
    if k == ast.NT_ARRAY {
        << c.typeref_count_bare_refs(p, p.nodes[t].a)
    }
    << 0
}

fn (c &Checker) typeref_count_explicit_refs(p &parser.Parser, t int) int {
    if t < 0 { << 0 }
    k := p.nodes[t].kind
    if k == ast.NT_REF {
        mut n := 0
        if p.nodes[t].sval.len > 0 { n = 1 }
        << n + c.typeref_count_explicit_refs(p, p.nodes[t].a)
    }
    if k == ast.NT_ARRAY {
        << c.typeref_count_explicit_refs(p, p.nodes[t].a)
    }
    << 0
}

fn (c &Checker) typeref_all_explicit_ok(p &parser.Parser, t int, fn_n int) bool {
    if t < 0 { << true }
    k := p.nodes[t].kind
    if k == ast.NT_REF {
        lt := p.nodes[t].sval
        if lt.len > 0 && !c.fn_introduces_lifetime(p, fn_n, lt) {
            << false
        }
        << c.typeref_all_explicit_ok(p, p.nodes[t].a, fn_n)
    }
    if k == ast.NT_ARRAY {
        << c.typeref_all_explicit_ok(p, p.nodes[t].a, fn_n)
    }
    << true
}

fn (c &Checker) typeref_ref_return_ok(p &parser.Parser, ret_n int, fn_n int) bool {
    bare := c.typeref_count_bare_refs(p, ret_n)
    expl := c.typeref_count_explicit_refs(p, ret_n)
    if bare == 0 && expl == 0 { << true }
    if bare > 0 && expl > 0 { << false }
    if bare > 0 {
        mut nref := 0
        mut prm := p.nodes[fn_n].a
        while prm >= 0 {
        pty := p.nodes[prm].a
        if pty >= 0 && p.nodes[pty].kind == ast.NT_REF {
            nref += 1
        }
        prm = p.nodes[prm].next
        }
        << nref == 1
    }
    << c.typeref_all_explicit_ok(p, ret_n, fn_n)
}

fn (c &Checker) find_local(name string) int {
    nm := name + ""
    nid := strmap_get(&c.str_map, &nm)
    if nid >= 0 && nid < c.lhead.len {
        id := c.lhead[nid]
        if id >= 0 && id < c.lactive.len && c.lactive[id] != 0 {
            << id
        }
    }
    for i in 0:c.lname.len {
        j := c.lname.len - 1 - i
        if c.lactive[j] != 0 && c.lname[j] == nm {
            << j
        }
    }
    << -1
}

// ===== move tracking (mirror xuhir) =====

// True when a by-value array-element read can be a clone and the slot
// stays initialized. Dynamic arrays, maps and resource drops cannot.
fn (c &Checker) index_elem_copyable(ty int, depth int) bool {
    if depth > 8 { << false }
    if ty == 3 { << true }
    if is_param_type(ty) { << false }
    if !c.type_owning(ty) { << true }
    if is_struct_type(ty) {
        si := struct_index(ty)
        if si < 0 || si >= c.structs.len { << false }
        if c.structs[si].drop_label.len > 0 { << false }
        for i in 0:c.structs[si].fields.len {
            if !c.index_elem_copyable(c.structs[si].fields[i].ty, depth + 1) {
                << false
            }
        }
        << true
    }
    << false
}

fn (c &mut Checker) move_fail_node(p &parser.Parser, n int, err_n int, msg string) {
    if c.move_err_n >= 0 {
        c.fail_node(p, c.move_err_n, msg)
        <<
    }
    c.fail_node(p, err_n, msg)
}

// Walk Field/Index to the Ident local consumed by nested `as` (whole binding).
fn (c &Checker) as_move_root_local(p &parser.Parser, n int) int {
    mut x := n
    for _ in 0:p.nodes.len {
        k := p.nodes[x].kind
        if k == ast.NK_FIELD || k == ast.NK_INDEX {
            x = p.nodes[x].a
        } else {
            if k == ast.NK_IDENT {
                << c.nlocal[x]
            }
            << -1
        }
    }
    << -1
}

fn (c &mut Checker) check_not_moved(p &parser.Parser, id int, n int) {
    if c.lmoved[id] != 0 {
        mut err_n := n
        if c.move_err_n >= 0 {
            err_n = c.move_err_n
        }
        c.fail_node(p, err_n, "use of moved value '" + c.lname[id] + "'")
    }
}

fn (c &mut Checker) check_field_not_moved(p &parser.Parser, id int, fi int, n int) {
    bit := field_bit(fi)
    if bit != 0 && id >= 0 && id < c.lfcons.len && (c.lfcons[id] & bit) != 0 {
        c.fail_node(p, n, "use of moved value '" + c.lname[id] + "'")
    }
}

fn (c &mut Checker) note_field_cons(p &parser.Parser, id int, fi int, n int) {
    c.check_not_moved(p, id, n)
    bit := field_bit(fi)
    if bit == 0 {
        c.note_move(p, id, n)
        <<
    }
    c.check_field_not_moved(p, id, fi, n)
    v := c.lfcons[id] | bit
    checker_set_i(mut &c.lfcons, id, v)
}

fn (c &mut Checker) check_path_not_moved(p &parser.Parser, id int, path int, n int) {
    if id < 0 || path == 0 {
        <<
    }
    mut top := path
    for _ in 0:8 {
        if top < 64 {
            <-
        }
        top = top / 64
    }
    if top > 0 {
        c.check_field_not_moved(p, id, top - 1, n)
    }
    for s in 0:4 {
        lp := c.lp_get(id, s)
        if lp == 0 {
            ->
        }
        if lp == path || path_is_prefix(lp, path) {
            c.fail_node(p, n, "use of moved value '" + c.lname[id] + "'")
        }
    }
}

fn (c &mut Checker) note_path_cons(p &parser.Parser, id int, path int, n int) {
    c.check_not_moved(p, id, n)
    if path < 64 {
        c.note_move(p, id, n)
        <<
    }
    c.check_path_not_moved(p, id, path, n)
    if !c.lp_add(id, path) {
        c.note_move(p, id, n)
    }
}

// Record a move out of an owning local (barrier-checked).
fn (c &mut Checker) note_move(p &parser.Parser, id int, n int) {
    c.check_not_moved(p, id, n)
    // Crossing an active barrier defers the decision to the scope pop:
    // legal if that scope's body terminates in a << (bootstrap mirror),
    // else an M2b error at the move.
    mut defer := false
    mut across_if := false
    mut across_other := false
    if id != c.rebind {
        for i in 0:c.barriers.len {
            b := c.barriers[i]
            mark := barrier_locals(b)
            if id < mark {
                defer = true
                if b < 0 {
                    across_if = true
                } else {
                    across_other = true
                }
            }
        }
    }
    // MS6: TypeAs consume across if/match (not loop/select) is not M2b;
    // join marks the binding dead and MIR compensates. Root may be an Ident
    // box or a struct/array whose LD field/element was `as`-consumed.
    // in_or_catch==2 is the TypeAs consume flag (no extra Checker field).
    if c.in_or_catch == 2 && across_if && !across_other {
        checker_set_i(mut &c.lmoved, id, 1)
        <<
    }
    if defer && c.pend_marks.len > 0 {
        c.pend_ids.push(id)
        c.pend_nodes.push(n)
    }
    checker_set_i(mut &c.lmoved, id, 1)
}

// Move-check a value consumed in an owning position (let init, by-value
// argument, assignment RHS, struct payload). `barrier_exempt` marks function
// returns. An owning string FIELD read in a move position produces a heap
// clone (m4 rule; nclone marks the node for mir). M108: a string local used
// across an active if/for/while barrier also clones (no note_move).
fn (c &mut Checker) move_of(p &parser.Parser, n int, ty int, barrier_exempt bool) {
    // MS5: boxing coerce returns temp/struct@ but the payload move uses the
    // concrete ntype (int stays copy; string/struct still move).
    mut mty := ty
    if n >= 0 && n < c.nbox.len && c.nbox[n] != 0 {
        mty = c.ntype[n]
    } else if n >= 0 && n < c.ncall.len && (c.ncall[n] == -98 || c.ncall[n] == -93) {
        k0 := p.nodes[n].kind
        if k0 != ast.NK_CALL && k0 != ast.NK_METHOD_CALL {
            mty = c.ntype[n]
        }
    }
    if !c.type_moves(mty) {
        << // scalars and shared references copy
    }
    k := p.nodes[n].kind
    if c.in_or_catch == 2 && is_as_box(mty) && c.resource_move_ancestor(p, n) {
        c.move_fail_node(p, n, n, "cannot partially move a field from a resource with drop")
        <<
    }
    if k == ast.NK_IDENT { // Ident
        // Package consts fold like literals — never moved out of a local.
        if c.nconst[n] >= 0 {
            <<
        }
        // M109: capture remapped to env.field
        if c.ncall[n] == -90 {
            if mty == 3 {
                checker_set_i(mut &c.nclone, n, 1)
                <<
            }
            if is_param_type(mty) {
                <<
            }
            c.move_fail_node(p, n, n, "cannot move a non-string field out of a struct (partial move, M2b)")
            <<
        }
        id := c.nlocal[n]
        if id >= 0 && id < c.lview.len && c.lview[id] != 0 {
            c.move_fail_node(p, n, n, "cannot move '" + c.lname[id] + "' because it is a for-in borrow view")
            <<
        }
        if c.field_cons_any(id) {
            c.move_fail_node(p, n, n, "use of moved value '" + c.lname[id] + "'")
            <<
        }
        if barrier_exempt {
            c.check_not_moved(p, id, n)
            <<
        }
        // MS6 C: `r as T` where r is `&mut temp` consumes the owner.
        if c.in_or_catch == 2 && id >= 0 && id < c.ltype.len && is_mut_ref_type(c.ltype[id]) {
            inner := c.ref_inner_type(c.ltype[id])
            if is_as_box(inner) && id < c.laref.len && c.laref[id] >= 0 {
                c.note_move(p, c.laref[id], n)
                <<
            }
        }
        // M108: string across barrier → clone (keep outer binding).
        if mty == 3 && id != c.rebind {
            mut across := false
            for i in 0:c.barriers.len {
                if id < barrier_locals(c.barriers[i]) {
                    across = true
                }
            }
            if across {
                c.check_not_moved(p, id, n)
                checker_set_i(mut &c.nclone, n, 1)
                <<
            }
        }
        c.note_move(p, id, n)
        <<
    }
    if k == ast.NK_BORROW { // Borrow — MS6 C: `(mut &e) as T` consumes e.
        if c.in_or_catch == 2 && is_as_box(mty) {
            tgt := p.nodes[n].a
            if p.nodes[tgt].kind == ast.NK_IDENT {
                oid := c.nlocal[tgt]
                if oid >= 0 {
                    c.note_move(p, oid, n)
                    <<
                }
            }
        }
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == 3 { // Deref — MS6 C: `(*r) as T`.
        if c.in_or_catch == 2 && is_as_box(mty) {
            inner := p.nodes[n].a
            if p.nodes[inner].kind == ast.NK_IDENT {
                rid := c.nlocal[inner]
                if rid >= 0 && rid < c.laref.len && c.laref[rid] >= 0 {
                    c.note_move(p, c.laref[rid], n)
                    <<
                }
            }
        }
    }
    if k == ast.NK_FIELD { // Field read
        // M110/M154: method value is a fat fn temp; receiver handled in check_method_value.
        if c.ncall[n] == -92 || c.ncall[n] == -95 {
            <<
        }
        if mty == 3 {
            checker_set_i(mut &c.nclone, n, 1)
            <<
        }
        // Generic def-site: Param fields may move (instances recompute).
        if is_param_type(mty) {
            <<
        }
        // MS6: `b.x as T` consumes field `x`. Nested `b.inner.e as T` /
        // `b.a.b.c as T` / const-Index `xs[0].e as T` consumes the packed
        // leaf path (siblings stay live). Runtime index still whole-root.
        if c.in_or_catch == 2 && is_as_box(mty) {
            pth := c.as_place_path(p, n)
            rid := c.as_top_field_id(p, n)
            if rid >= 0 && pth >= 64 {
                c.note_path_cons(p, rid, pth, n)
                <<
            }
            fi := c.as_top_field_fi(p, n)
            if rid >= 0 && fi >= 0 {
                c.note_field_cons(p, rid, fi, n)
                <<
            }
            root := c.as_move_root_local(p, n)
            if root >= 0 {
                c.note_move(p, root, n)
                <<
            }
        }
        c.move_fail_node(p, n, n, "cannot move a non-string field out of a struct (partial move, M2b)")
    }
    if k == ast.NK_INDEX { // Array index read: the array retains ownership.
        if n >= 0 && n < c.ncall.len && c.ncall[n] == -77 {
            if mty == 3 {
                checker_set_i(mut &c.nclone, n, 1)
                <<
            }
            if c.type_owning(mty) {
                c.move_fail_node(p, n, n, "cannot move an owning map value by index; borrow it or take it")
                <<
            }
            <<
        }
        if mty == 3 {
            checker_set_i(mut &c.nclone, n, 1)
            <<
        }
        // Generic def-site: Param elements may move (instances recompute).
        if is_param_type(mty) {
            <<
        }
        // MS6: `xs[0] as T` with a constant index consumes only that
        // element. Runtime index of a local does **not** whole-move the
        // array (B2: sibling elems stay as-able; same index fail-loud via
        // null itable). Runtime `h.xs[i] as` consumes the array field.
        if c.in_or_catch == 2 && is_as_box(mty) {
            pth := c.as_place_path(p, n)
            ridp := c.as_top_field_id(p, n)
            if ridp >= 0 && pth >= 64 {
                c.note_path_cons(p, ridp, pth, n)
                <<
            }
            obj := p.nodes[n].a
            if p.nodes[obj].kind == ast.NK_IDENT {
                rid := c.nlocal[obj]
                ei := c.as_const_index(p, p.nodes[n].b)
                if rid >= 0 && ei >= 0 {
                    c.note_field_cons(p, rid, ei, n)
                    <<
                }
                // B2: local runtime index — element-level; no whole-root move.
                if rid >= 0 && ei < 0 {
                    <<
                }
            }
            if p.nodes[obj].kind == ast.NK_FIELD {
                ptha := c.as_place_path(p, obj)
                rida := c.as_top_field_id(p, obj)
                if rida >= 0 && ptha >= 64 {
                    c.note_path_cons(p, rida, ptha, n)
                    <<
                }
                if rida >= 0 && ptha > 0 && ptha < 64 {
                    c.note_field_cons(p, rida, ptha - 1, n)
                    <<
                }
            }
            rid := c.as_move_root_local(p, n)
            if rid >= 0 {
                c.note_move(p, rid, n)
                <<
            }
        }
        // The array keeps the element. A by-value read copies: strings and
        // structs whose owning leaves are strings are cloned in MIR. Anything
        // else (array, map, interface, resource drop) stays a loud error
        // instead of an internal compiler abort.
        if c.index_elem_copyable(mty, 0) {
            if n >= 0 {
                checker_set_i(mut &c.nclone, n, 1)
            }
            <<
        }
        c.move_fail_node(p, n, n, "cannot move an owning array element by index; borrow it or clone it")
    }
    // freshly constructed value (temp): no tracking
}

// ===== intern pool =====
