@xu/types

#internal/modulepath
// Language-level identifier style (dual-end with bootstrap xuhir/names.rs):
// types PascalCase, values snake_case. Visibility stays `pub`.


#xu/ast
#xu/parser

fn is_upper_byte(c int) bool {
    << c >= 65 && c <= 90
}

fn is_lower_byte(c int) bool {
    << c >= 97 && c <= 122
}

fn is_digit_byte(c int) bool {
    << c >= 48 && c <= 57
}

fn is_pascal_case(name string) bool {
    if name.len == 0 {
        << false
    }
    if !is_upper_byte(name[0]) {
        << false
    }
    for i in 0:name.len {
        c := name[i]
        if c == 95 {
            << false
        }
        if is_upper_byte(c) || is_lower_byte(c) || is_digit_byte(c) {
            ->
        }
        << false
    }
    << true
}

fn is_snake_case(name string) bool {
    if name == "_" {
        << true
    }
    if name.len == 0 {
        << false
    }
    mut start := 0
    if name.len >= 2 && name[0] == 95 && name[1] != 95 {
        start = 1
    }
    if start >= name.len {
        << false
    }
    if !is_lower_byte(name[start]) {
        << false
    }
    mut prev_us := false
    last := name.len - 1
    for i in start:name.len {
        c := name[i]
        if c == 95 {
            if prev_us || i == last {
                << false
            }
            prev_us = true
        } else if is_lower_byte(c) || is_digit_byte(c) {
            prev_us = false
        } else {
            << false
        }
    }
    << true
}

fn (c &mut Checker) require_pascal(p &parser.Parser, n int, slot string) {
    if p.nodes[n].sval.len >= 2 {
        if p.nodes[n].sval[0] == 95 && p.nodes[n].sval[1] == 95 {
            <<
        }
    }
    if is_pascal_case(p.nodes[n].sval + "") {
        <<
    }
    c.fail_node(p, n, slot + " '" + p.nodes[n].sval + "' must be PascalCase")
}

fn (c &mut Checker) require_snake(p &parser.Parser, n int, slot string) {
    if p.nodes[n].sval.len == 0 {
        <<
    }
    if is_snake_case(p.nodes[n].sval + "") {
        <<
    }
    c.fail_node(p, n, slot + " '" + p.nodes[n].sval + "' must be snake_case")
}

fn (c &mut Checker) require_snake_at(line int, col int, slot string, name string) {
    if name.len == 0 {
        <<
    }
    if is_snake_case(name + "") {
        <<
    }
    c.fail_at(line, col, slot + " '" + name + "' must be snake_case")
}

fn (c &mut Checker) check_name_node(p &parser.Parser, n int) {
    if n < 0 {
        <<
    }
    k := p.nodes[n].kind
    if k == ast.nk_let || k == ast.nk_for {
        c.require_snake(p, n, "variable")
    }
    if k == ast.nk_for_each {
        c.require_snake(p, n, "variable")
        if p.nodes[n].sval2.len > 0 {
            c.require_snake_at(p.nodes[n].line, p.nodes[n].col, "variable", p.nodes[n].sval2 + "")
        }
    }
    if k == ast.nk_fn {
        c.require_snake(p, n, "fn")
    }
    if k == ast.nk_param || k == ast.nk_recv_decl {
        c.require_snake(p, n, "parameter")
    }
    if k == ast.nk_type_param {
        c.require_pascal(p, n, "type parameter")
    }
    if k == ast.nk_struct || k == ast.nk_interface || k == ast.nk_enum {
        c.require_pascal(p, n, "type name")
    }
    if k == ast.nk_field_decl {
        c.require_snake(p, n, "field")
    }
    if k == ast.nk_method_sig {
        c.require_snake(p, n, "fn")
    }
    if k == ast.nk_const {
        c.require_snake(p, n, "const")
    }
    if k == ast.nt_ref {
        if p.nodes[n].sval.len > 0 {
            c.require_snake(p, n, "lifetime")
        }
    }
    if k == ast.nk_variant_decl {
        c.require_pascal(p, n, "variant")
    }
    if k == ast.nk_sel_recv || k == ast.nk_or_catch {
        c.require_snake(p, n, "variable")
    }
    if k == ast.nk_arm_enum {
        mut b := p.nodes[n].a
        while b >= 0 {
            c.require_snake(p, b, "variable")
            b = p.nodes[b].next
        }
    }
}

fn (c &mut Checker) walk_name_tree(p &parser.Parser, n int, follow_next bool) {
    if n < 0 {
        <<
    }
    c.check_name_node(p, n)
    k := p.nodes[n].kind
    // ArmRange: ival=lo, d=hi are integers; e unused. Only c is the body.
    if k == ast.nk_arm_range {
        c.walk_name_tree(p, p.nodes[n].c, true)
        if follow_next {
            c.walk_name_tree(p, p.nodes[n].next, true)
        }
        <<
    }
    c.walk_name_tree(p, p.nodes[n].a, true)
    c.walk_name_tree(p, p.nodes[n].b, true)
    c.walk_name_tree(p, p.nodes[n].c, true)
    c.walk_name_tree(p, p.nodes[n].d, true)
    c.walk_name_tree(p, p.nodes[n].e, true)
    if follow_next {
        c.walk_name_tree(p, p.nodes[n].next, true)
    }
}

fn (c &mut Checker) check_names(p &parser.Parser) {
    n_mods := p.mod_ids.len
    for i in 0:n_mods {
        mid := p.mod_ids[i] + ""
        if !modulepath.valid_path(&mid) {
            c.fail_at(1, 1, "invalid package path '" + mid + "'")
        }
    }
    n_imps := p.imp_path.len
    for i in 0:n_imps {
        c.set_cur_file(p, p.imp_file[i])
        qualifier := import_default_qualifier(p.imp_path[i] + "", p.imp_alias[i] + "")
        c.require_snake_at(1, 1, "import alias", qualifier)
    }
    n_decls := p.decls.len
    for i in 0:n_decls {
        d := p.decls[i]
        c.set_cur_file(p, decl_file_id(p, d))
        c.walk_name_tree(p, d, false)
    }
}
