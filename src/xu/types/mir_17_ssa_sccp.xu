@xu/types

// A monotone unknown -> constant -> overdefined lattice over verified SSA.
// Executable edges and value users drive a block worklist. Analysis is private:
// no instruction/CFG/Phi mutation occurs unless the bounded solver converges.
const MIR_SCCP_UNKNOWN = 0
const MIR_SCCP_CONSTANT = 1
const MIR_SCCP_OVERDEFINED = 2
const MIR_SCCP_MAX_WORK = 131072
const MIR_SCCP_MAX_QUEUE = 8192

struct MirSccp {
    kinds []int
    values []int
    users []int
    pinned []bool
    edges []int
    queued []bool
    queue []int
    reach int
    work int
}

fn mir_sccp_schedule(s $&MirSccp, bi int) {
    if (s.reach & (1 << bi)) == 0 || s.queued[bi] { << }
    s.queued[bi] = true
    s.queue.push(bi)
}

fn mir_sccp_edge(s $&MirSccp, from int, to int) {
    bit := 1 << to
    if (s.edges[from] & bit) != 0 { << }
    s.edges[from] = s.edges[from] | bit
    s.reach = s.reach | bit
    mir_sccp_schedule(s, to)
}

fn mir_sccp_merge(s $&MirSccp, d int, kind int, value int) {
    if d < 0 || d >= s.kinds.len || kind == MIR_SCCP_UNKNOWN { << }
    old := s.kinds[d]
    if old == MIR_SCCP_OVERDEFINED { << }
    $next := kind
    if old == MIR_SCCP_CONSTANT {
        if kind == MIR_SCCP_CONSTANT && s.values[d] == value { << }
        next = MIR_SCCP_OVERDEFINED
    }
    s.kinds[d] = next
    s.values[d] = value
    for bi in 0:s.edges.len {
        if (s.users[d] & (1 << bi)) != 0 { mir_sccp_schedule(s, bi) }
    }
}

fn mir_sccp_kind(f &MFn, s &MirSccp, v int) int {
    if v <= -2 && -v - 2 < f.consts.len { << MIR_SCCP_CONSTANT }
    if v < 0 || v >= s.kinds.len { << MIR_SCCP_OVERDEFINED }
    << s.kinds[v]
}

fn mir_sccp_value(f &MFn, s &MirSccp, v int) int {
    if v <= -2 { << f.consts[-v - 2] }
    << s.values[v]
}

fn mir_sccp_user(s $&MirSccp, v int, bi int) {
    if v >= 0 && v < s.users.len { s.users[v] = s.users[v] | (1 << bi) }
}

fn mir_sccp_users(f &MFn, s $&MirSccp) bool {
    for pi in 0:f.phis.len {
        p := f.phis[pi]
        for ai in p.arg_head:p.arg_head + p.arg_count { mir_sccp_user(s, f.phi_args[ai].value, p.block) }
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            c := mfn_ic(&f.instrs, ii)
            schema := mir_instr_use_schema(k, c)
            if schema < 0 { << false }
            mask := mir_instr_use_mask(schema)
            a := mfn_ia(&f.instrs, ii)
            b := mfn_ib(&f.instrs, ii)
            d := mfn_id(&f.instrs, ii)
            if (mask & 1) != 0 { mir_sccp_user(s, a, bi) }
            if (mask & 2) != 0 { mir_sccp_user(s, b, bi) }
            if (mask & 4) != 0 { mir_sccp_user(s, c, bi) }
            if (mask & 8) != 0 { mir_sccp_user(s, d, bi) }
            if k == MI_ADDR && c == 1 { s.pinned[b] = true }
            $ap := mir_instr_use_arg_head(schema, b, c, d)
            for _ in 0:f.margs.len {
                if ap < 0 { <- }
                mir_sccp_user(s, mfn_marg_v(&f.margs, ap), bi)
                ap = mfn_marg_next(&f.margs, ap)
            }
            ii = mfn_inext(&f.instrs, ii)
        }
        if f.blocks[bi].tkind == 2 || f.blocks[bi].tkind == 3 { mir_sccp_user(s, f.blocks[bi].ta, bi) }
    }
    for t in 0:f.temps.len {
        if s.pinned[t] || !mir_ssa_scalar(f, t) { s.kinds[t] = MIR_SCCP_OVERDEFINED }
    }
    << true
}

fn mir_sccp_operand(f &MFn, v int, ty int) bool {
    if v <= -2 { << -v - 2 < f.consts.len }
    << v >= 0 && v < f.temps.len && f.temps[v] == ty && f.temps_nslots[v] == 1
}

fn mir_sccp_phi(f &MFn, s $&MirSccp, pi int) {
    p := f.phis[pi]
    if s.pinned[p.dest] || !mir_ssa_scalar(f, p.dest) { << }
    for ai in p.arg_head:p.arg_head + p.arg_count {
        a := f.phi_args[ai]
        if (s.edges[a.pred] & (1 << p.block)) == 0 { -> }
        kind := mir_sccp_kind(f, &*s, a.value)
        $value := 0
        if kind == MIR_SCCP_CONSTANT { value = mir_sccp_value(f, &*s, a.value) }
        mir_sccp_merge(s, p.dest, kind, value)
    }
}

fn mir_sccp_eval(f &MFn, s $&MirSccp, ii int) {
    k := mfn_ikind(&f.instrs, ii)
    d := mfn_ia(&f.instrs, ii)
    if !mir_instr_has_dest(k) || d < 0 { << }
    if !mir_ssa_scalar(f, d) || s.pinned[d] { << }
    op := mfn_ib(&f.instrs, ii)
    l := mfn_ic(&f.instrs, ii)
    r := mfn_id(&f.instrs, ii)
    $kind := MIR_SCCP_OVERDEFINED
    $value := 0
    ty := f.temps[d]
    if k == MI_COPY && mir_sccp_operand(f, op, ty) {
        kind = mir_sccp_kind(f, &*s, op)
        if kind == MIR_SCCP_CONSTANT { value = mir_sccp_value(f, &*s, op) }
        if ty == 2 && value != 0 && value != 1 { kind = MIR_SCCP_OVERDEFINED }
    } else if k == MI_UN && ((op == 1 && ty == 1) || (op == 2 && ty == 2)) && mir_sccp_operand(f, l, ty) {
        kind = mir_sccp_kind(f, &*s, l)
        if kind == MIR_SCCP_CONSTANT {
            value = 0 - mir_sccp_value(f, &*s, l)
            if op == 2 {
                value = 0
                if mir_sccp_value(f, &*s, l) == 0 { value = 1 }
            }
        }
    } else if k == MI_BIN && mfn_isval_len(&f.instrs, ii) == 0 && mir_ssa_binop_pure(op) {
        $operands := mir_sccp_operand(f, l, 1) && mir_sccp_operand(f, r, 1)
        if op >= 6 && op <= 11 {
            // At least one typed temp witnesses the comparison domain;
            // untyped pool bits alone cannot distinguish integer from f64.
            operands = (l >= 0 || r >= 0) && ((mir_sccp_operand(f, l, 1) && mir_sccp_operand(f, r, 1)) || (mir_sccp_operand(f, l, 2) && mir_sccp_operand(f, r, 2))) && ty == 2
        } else if ty != 1 { operands = false }
        if operands {
            lk := mir_sccp_kind(f, &*s, l)
            rk := mir_sccp_kind(f, &*s, r)
            if lk == MIR_SCCP_CONSTANT && rk == MIR_SCCP_CONSTANT {
                value = mir_ssa_eval_const_binop(op, mir_sccp_value(f, &*s, l), mir_sccp_value(f, &*s, r))
                kind = MIR_SCCP_CONSTANT
            } else if lk == MIR_SCCP_UNKNOWN || rk == MIR_SCCP_UNKNOWN { kind = MIR_SCCP_UNKNOWN }
        }
    }
    mir_sccp_merge(s, d, kind, value)
}

fn mir_sccp_block(f &MFn, s $&MirSccp, bi int) {
    for pi in 0:f.phis.len {
        if f.phis[pi].block == bi { mir_sccp_phi(f, s, pi)
            s.work += 1 }
    }
    $ii := f.blocks[bi].head
    for _ in 0:f.instrs.len {
        if ii < 0 || s.work > MIR_SCCP_MAX_WORK { <- }
        mir_sccp_eval(f, s, ii)
        k := mfn_ikind(&f.instrs, ii)
        if k == MI_CHAN_RECV { mir_sccp_merge(s, mfn_id(&f.instrs, ii), MIR_SCCP_OVERDEFINED, 0) }
        if k == MI_CHAN_TRY_RECV { mir_sccp_merge(s, mfn_ib(&f.instrs, ii), MIR_SCCP_OVERDEFINED, 0) }
        s.work += 1
        ii = mfn_inext(&f.instrs, ii)
    }
    b := f.blocks[bi]
    if b.tkind == 1 { mir_sccp_edge(s, bi, b.ta) }
    if b.tkind == 2 {
        kind := mir_sccp_kind(f, &*s, b.ta)
        if kind == MIR_SCCP_CONSTANT {
            $to := b.tc
            if mir_sccp_value(f, &*s, b.ta) != 0 { to = b.tb }
            mir_sccp_edge(s, bi, to)
        } else if kind == MIR_SCCP_OVERDEFINED {
            mir_sccp_edge(s, bi, b.tb)
            mir_sccp_edge(s, bi, b.tc)
        }
    }
}

fn mir_sccp_solve(f &MFn, s $&MirSccp) bool {
    mir_sccp_schedule(s, 0)
    $cursor := 0
    for _ in 0:f.blocks.len + 1 {
        while cursor < s.queue.len {
            if s.queue.len > MIR_SCCP_MAX_QUEUE || s.work > MIR_SCCP_MAX_WORK { << false }
            bi := s.queue[cursor]
            cursor += 1
            s.queued[bi] = false
            mir_sccp_block(f, s, bi)
        }
        // Unknown is not language-level undef. If a reachable cycle cannot
        // supply a condition, expose both arms conservatively and resume.
        $added := false
        for bi in 0:f.blocks.len {
            b := f.blocks[bi]
            if (s.reach & (1 << bi)) == 0 || b.tkind != 2 { -> }
            if mir_sccp_kind(f, &*s, b.ta) != MIR_SCCP_UNKNOWN { -> }
            old := s.edges[bi]
            mir_sccp_edge(s, bi, b.tb)
            mir_sccp_edge(s, bi, b.tc)
            if old != s.edges[bi] { added = true }
        }
        if !added { << s.work <= MIR_SCCP_MAX_WORK }
    }
    << false
}

fn mir_sccp_apply(f $&MFn, s &MirSccp) {
    $aliases := []int{}
    for t in 0:f.temps.len {
        $v := t
        if s.kinds[t] == MIR_SCCP_CONSTANT { v = mir_cfg_const(f, s.values[t]) }
        aliases.push(v)
    }
    for bi in 0:f.blocks.len {
        if (s.reach & (1 << bi)) == 0 { -> }
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            k := mfn_ikind(&f.instrs, ii)
            d := mfn_ia(&f.instrs, ii)
            if mir_instr_has_dest(k) && d >= 0 && s.kinds[d] == MIR_SCCP_CONSTANT { mfn_become_copy($&f.instrs, ii, aliases[d]) }
            ii = mfn_inext(&f.instrs, ii)
        }
        $b := f.blocks[bi]
        if b.tkind == 2 && mir_sccp_kind(&*f, s, b.ta) == MIR_SCCP_CONSTANT {
            $to := b.tc
            if mir_sccp_value(&*f, s, b.ta) != 0 { to = b.tb }
            b.tkind = 1
            b.ta = to
            b.tb = -1
            b.tc = -1
            mfn_set_block($&f.blocks, bi, b)
        }
    }
    // Recompute actual reachability after branch pruning: executable edges
    // are an overapproximation when an unknown condition was exposed above.
    $reach := 1
    for _ in 0:f.blocks.len {
        for bi in 0:f.blocks.len {
            if (reach & (1 << bi)) == 0 { -> }
            b := f.blocks[bi]
            if b.tkind == 1 { reach = reach | (1 << b.ta) }
            if b.tkind == 2 { reach = reach | (1 << b.tb) | (1 << b.tc) }
        }
    }
    for bi in 0:f.blocks.len {
        if (reach & (1 << bi)) != 0 { -> }
        $b := f.blocks[bi]
        b.head = -1
        b.tail = -1
        b.tkind = 0
        b.ta = -1
        b.tb = -1
        b.tc = -1
        mfn_set_block($&f.blocks, bi, b)
    }
    $phis := []MPhi{}
    $args := []MPhiArg{}
    for pi in 0:f.phis.len {
        p := f.phis[pi]
        if (reach & (1 << p.block)) == 0 { -> }
        head := args.len
        for ai in p.arg_head:p.arg_head + p.arg_count {
            a := f.phi_args[ai]
            if (reach & (1 << a.pred)) != 0 && mir_verify_edge(&*f, a.pred, p.block) { args.push(a) }
        }
        phis.push(MPhi{block: p.block, local: p.local, dest: p.dest, ty: p.ty, arg_head: head, arg_count: args.len - head})
    }
    f.phis = phis
    f.phi_args = args
    mir_ssa_rewrite(f, &aliases)
    mir_fn_facts_invalidate_f(f)
}

// Requires a fresh strict SSA proof. Rejected/over-budget analysis is read-only.
fn mir_ssa_sccp_verified_f(f $&MFn) bool {
    if !mir_ssa_work_budget_f(&*f) || f.blocks.len == 0 { << false }
    // Branch-free value propagation already belongs to the existing SSA
    // simplifier. Allocate executable-edge state only for conditional CFGs.
    $conditional := false
    for bi in 0:f.blocks.len { if f.blocks[bi].tkind == 2 { conditional = true } }
    if !conditional { << false }
    $s := MirSccp{kinds: []int{}, values: []int{}, users: []int{}, pinned: []bool{}, edges: []int{}, queued: []bool{}, queue: []int{}, reach: 1, work: 0}
    for _ in 0:f.temps.len {
        s.kinds.push(MIR_SCCP_UNKNOWN)
        s.values.push(0)
        s.users.push(0)
        s.pinned.push(false)
    }
    for _ in 0:f.blocks.len { s.edges.push(0)
        s.queued.push(false) }
    if !mir_sccp_users(&*f, $&s) || !mir_sccp_solve(&*f, $&s) { << false }
    // A newly constant shift must stay in the common 64-bit ISA domain.
    // Preserve the entire original function if target-specific oversized
    // shift behavior would otherwise become exposed by constant rewriting.
    for bi in 0:f.blocks.len {
        if (s.reach & (1 << bi)) == 0 { -> }
        $ii := f.blocks[bi].head
        for _ in 0:f.instrs.len {
            if ii < 0 { <- }
            op := mfn_ib(&f.instrs, ii)
            rhs := mfn_id(&f.instrs, ii)
            if mfn_ikind(&f.instrs, ii) == MI_BIN && (op == 17 || op == 18) && mir_sccp_kind(&*f, &s, rhs) == MIR_SCCP_CONSTANT {
                count := mir_sccp_value(&*f, &s, rhs)
                if count < 0 || count >= 64 { << false }
            }
            ii = mfn_inext(&f.instrs, ii)
        }
    }
    $changed := false
    for t in 0:s.kinds.len { if s.kinds[t] == MIR_SCCP_CONSTANT { changed = true } }
    for bi in 0:f.blocks.len {
        if (s.reach & (1 << bi)) == 0 && f.blocks[bi].tkind != 0 { changed = true }
    }
    if !changed { << false }
    mir_sccp_apply(f, &s)
    << true
}
