@xu/parser

#xu/ast

fn (p &mut Parser) parse_interface() int {
    // `struct@ Name { ... }` — structural generic (replaces `interface` / `temp@`).
    p.expect(11, "struct")
    p.expect(84, "@")
    p.niface += 1
    mut node := ast.mknode(ast.NK_INTERFACE, p.line(), p.col())
    node.sval = p.expect_ident()
    p.expect(21, "{")
    mut methods := -1
    mut last := -1
    mut done := false
    while !done {
            p.skip_newlines()
            k2 := p.kind()
            if k2 == 22 { // }
                p.bump()
                done = true
            } else if k2 == 54 {
                p.fail("unexpected end of file inside struct@")
            } else if k2 == 4 { // fn
                line := p.line()
                col := p.col()
                p.bump()
                mut msig := ast.mknode(ast.NK_METHOD_SIG, line, col)
                msig.sval = p.expect_ident()
                p.expect(19, "(")
                mut params := -1
                mut plast := -1
                p.skip_newlines()
                if p.kind() != 20 {
                    mut pdone := false
                    while !pdone {
                            ty := p.parse_type()
                            if params < 0 { params = ty } else { p.set_next(plast, ty) }
                            plast = ty
                            p.skip_newlines()
                            if p.kind() == 25 { // ,
                                p.bump()
                                p.skip_newlines()
                            } else {
                                pdone = true
                            }
                    }
                }
                p.expect(20, ")")
                // Optional << type (note: interfaces allow '&' here; M103: `fn`).
                rk := p.kind()
                if rk == 4 || rk == 16 || rk == 17 || rk == 18 || rk == 67 || rk == 72 || rk == 73 || rk == 74 || rk == 79 || rk == 91 || rk == 1 || rk == 69 || rk == 39 || rk == 23 || rk == 70 || rk == 89 {
                    msig.b = p.parse_type()
                }
                msig.a = params
                idx := p.add(msig)
                if methods < 0 { methods = idx } else { p.set_next(last, idx) }
                last = idx
            } else {
                p.fail("expected method signature, found " + p.describe_here())
            }
    }
    node.a = methods
    << p.add(node)
}

// Desugar `name#` / `name# Ord` params into type_params + Named("__temp").
// `name@` / `name@ T` keeps its type (struct path). Mutates fn node `ni` already in the pool.
// Indexed field writes `p.nodes[i].f = …` on `&mut Parser` segfault under Gen1 —
// always get_node/set_node for mutations.
fn (p &mut Parser) desugar_fn_temp_marks(ni int) {
    mut has_var := false
    mut constraint := ""
    mut saw_constraint := false
    mut pi := p.nodes[ni].a
    while pi >= 0 {
        if p.nodes[pi].sval2 == "#" {
            has_var = true
            ty := p.nodes[pi].a
            if ty >= 0 {
                if p.nodes[ty].kind == ast.NT_TEMP || p.nodes[ty].kind == ast.NT_ANY { // sentinel
                    // unconstrained
                } else if p.nodes[ty].kind == ast.NT_NAMED {
                    if !saw_constraint {
                        constraint = p.nodes[ty].sval
                        saw_constraint = true
                    }
                }
            }
        }
        pi = p.nodes[pi].next
    }
    if !has_var {
        // Clear mark-only sval2 without get_node/set_node round-trip.
        // Gen1→gen2: get_node+set_node on Param nodes was zeroing sval
        // (LoadBufPtr/string field from []Node); leave sval2 as "" from parse.
        <<
    }
    mut tp_name := "__temp"
    e0 := p.nodes[ni].e
    if e0 < 0 {
        mut tp := ast.mknode(ast.NK_TYPE_PARAM, p.nodes[ni].line, p.nodes[ni].col)
        tp.sval = tp_name
        if saw_constraint {
            tp.sval2 = constraint
        }
        mut fn0 := p.get_node(ni)
        fn0.e = p.add(tp)
        p.set_node(ni, fn0)
    } else {
        tp_name = p.nodes[e0].sval
        if saw_constraint && p.nodes[e0].sval2.len == 0 {
            mut tpn := p.get_node(e0)
            tpn.sval2 = constraint
            p.set_node(e0, tpn)
        }
    }
    pi = p.nodes[ni].a
    while pi >= 0 {
        mut pn := p.get_node(pi)
        // Preserve sval across get_node/set_node: Gen1→gen2 can zero the
        // pooled string when rewriting sval2 (same class of bug as parse_fn
        // mark probes clobbering stack prm.sval).
        keep := pn.sval + ""
        if pn.sval2 == "#" {
            // In-place rewrite — do not p.add a second Named (orphan TTemp).
            mut nty := p.get_node(pn.a)
            nty.kind = 53 // TNamed
            nty.sval = tp_name
            nty.sval2 = ""
            nty.ival = 0
            nty.a = -1
            nty.b = -1
            nty.c = -1
            nty.d = -1
            nty.e = -1
            nty.next = -1
            p.set_node(pn.a, nty)
        }
        pn.sval2 = ""
        pn.sval = keep
        p.set_node(pi, pn)
        pi = p.nodes[pi].next
    }
    b0 := p.nodes[ni].b
    if b0 >= 0 {
        bk := p.nodes[b0].kind
        mut rewrite := false
        if bk == ast.NT_NAMED {
            if p.nodes[b0].sval == tp_name {
                rewrite = true
            } else if saw_constraint && p.nodes[b0].sval == constraint {
                rewrite = true
            }
        }
        if rewrite {
            mut nty := p.get_node(b0)
            nty.kind = 53
            nty.sval = tp_name
            nty.sval2 = ""
            nty.ival = 0
            nty.a = -1
            nty.b = -1
            nty.c = -1
            nty.d = -1
            nty.e = -1
            nty.next = -1
            p.set_node(b0, nty)
        }
    }
}

// `#T` / `#T: ToString, U: Other` — returns the TypeParam chain head.
fn (p &mut Parser) parse_type_params() int {
    if p.kind() == 33 { // <
        p.fail("`<T>` is removed; use #T / #T: Bound (value generics temp# / T#)")
    }
    p.expect(88, "#")
    mut head := -1
    mut last := -1
    mut done := false
    while !done {
            mut tp := ast.mknode(ast.NK_TYPE_PARAM, p.line(), p.col())
            tp.sval = p.expect_ident()
            if p.kind() == 48 { // :
                p.bump()
                tp.sval2 = p.expect_ident()
                if p.kind() == 84 { // optional Ord@
                    p.bump()
                }
            }
            idx := p.add(tp)
            if head < 0 { head = idx } else { p.set_next(last, idx) }
            last = idx
            if p.kind() == 25 { // ,
                p.bump()
            } else {
                done = true
            }
    }
    << head
}

fn (p &mut Parser) parse_struct() int {
    p.expect(11, "struct")
    p.nstruct += 1
    mut node := ast.mknode(ast.NK_STRUCT, p.line(), p.col())
    node.sval = p.expect_ident()
    if p.kind() == 88 || p.kind() == 33 { // # or legacy <
        node.e = p.parse_type_params()
    }
    p.expect(21, "{")
    mut fields := -1
    mut last := -1
    mut in_pub := false
    mut done := false
    while !done {
            p.skip_newlines()
            k2 := p.kind()
            if k2 == 22 { // }
                p.bump()
                done = true
            } else if k2 == 54 {
                p.fail("unexpected end of file inside struct")
            } else if k2 == 65 && p.kind_at(1) == 48 { // pub :
                p.bump() // pub
                p.bump() // :
                in_pub = true
            } else if k2 == 65 { // pub field
                p.bump()
                mut fd := ast.mknode(ast.NK_FIELD_DECL, p.line(), p.col())
                fd.sval = p.expect_ident()
                fd.a = p.parse_type()
                fd.ival = 1
                idx := p.add(fd)
                if fields < 0 { fields = idx } else { p.set_next(last, idx) }
                last = idx
                if p.kind() == 25 {
                    p.bump()
                }
            } else {
                mut fd := ast.mknode(ast.NK_FIELD_DECL, p.line(), p.col())
                fd.sval = p.expect_ident()
                fd.a = p.parse_type()
                if in_pub { fd.ival = 1 } else { fd.ival = 0 }
                idx := p.add(fd)
                if fields < 0 { fields = idx } else { p.set_next(last, idx) }
                last = idx
                if p.kind() == 25 {
                    p.bump()
                }
            }
    }
    node.a = fields
    << p.add(node)
}

fn (p &mut Parser) parse_enum() int {
    p.expect(68, "enum")
    mut node := ast.mknode(ast.NK_ENUM, p.line(), p.col())
    node.sval = p.expect_ident()
    if p.kind() == 88 || p.kind() == 33 { // # or legacy <
        node.e = p.parse_type_params()
    }
    p.expect(21, "{")
    mut variants := -1
    mut last := -1
    mut nvars := 0
    mut done := false
    while !done {
            p.skip_newlines()
            k2 := p.kind()
            if k2 == 22 {
                p.bump()
                done = true
            } else if k2 == 54 {
                p.fail("unexpected end of file inside enum")
            } else {
                mut vd := ast.mknode(ast.NK_VARIANT_DECL, p.line(), p.col())
                vd.sval = p.expect_ident()
                mut fields := -1
                mut flast := -1
                if p.kind() == 19 { // (
                    p.bump()
                    p.skip_newlines()
                    if p.kind() != 20 {
                        mut more := true
                        while more {
                                t := p.parse_type()
                                if fields < 0 { fields = t } else { p.set_next(flast, t) }
                                flast = t
                                p.skip_newlines()
                                if p.kind() == 25 {
                                    p.bump()
                                    p.skip_newlines()
                                } else {
                                    more = false
                                }
                        }
                    }
                    p.expect(20, ")")
                }
                vd.a = fields
                idx := p.add(vd)
                if variants < 0 { variants = idx } else { p.set_next(last, idx) }
                last = idx
                nvars += 1
                if p.kind() == 25 {
                    p.bump()
                }
            }
    }
    if nvars == 0 {
        p.fail("enum must have at least one variant")
    }
    node.a = variants
    << p.add(node)
}

fn (p &mut Parser) parse_fn() int {
    // Record the `fn` keyword position (not the name) so diagnostics and the
    // M36 W1 recursion warning attribute to the declaration like bootstrap.
    fline := p.line()
    fcol := p.col()
    p.expect(4, "fn")
    p.nfn += 1
    mut node := ast.mknode(ast.NK_FN, fline, fcol)
    // Optional method receiver:
    //   `fn (u User)` / `fn (u &User)` / `fn (u &a User)` / `fn (u &mut User)` (M159)
    // Legacy `fn (mut u User)` is rejected — write `fn (u &mut User)`.
    if p.kind() == 19 && (p.kind_at(1) == 1 || p.kind_at(1) == 5) {
        p.bump() // (
        mut recv := ast.mknode(ast.NK_RECV_DECL, 0, 0)
        if p.kind() == 5 { // legacy mut name Type
            p.fail("legacy `fn (mut name T)` receiver is removed; write `fn (name &mut T)`")
        }
        recv.line = p.line()
        recv.col = p.col()
        recv.sval = p.expect_ident()
        recv.a = p.parse_type()
        p.expect(20, ")")
        node.d = p.add(recv)
    }
    node.sval = p.expect_ident()
    if p.kind() == 88 || p.kind() == 33 { // # or legacy <
        node.e = p.parse_type_params()
    }
    p.expect(19, "(")
    mut params := -1
    mut last := -1
    // m37: `<->` positions for the not-last / multiple diagnostics, resolved
    // after the full parameter list (a second `<->` wins over a non-trailing
    // first one — mirrors bootstrap xuparse).
    mut variadic_count := 0
    mut first_line := 0
    mut first_col := 0
    mut second_line := 0
    mut second_col := 0
    mut last_variadic := false
    p.skip_newlines()
    if p.kind() != 20 {
        mut pdone := false
        while !pdone {
                mut prm := ast.mknode(ast.NK_PARAM, p.line(), p.col())
                name0 := p.expect_ident()
                // `name#` / `name# Bound` (var) / `name@` / `name@ Bound` (struct).
                mut mark := ""
                if p.kind() == 88 { // #
                    p.bump()
                    mark = "#"
                } else if p.kind() == 84 { // @
                    p.bump()
                    mark = "@"
                }
                // m37: `name <-> T` — variadic trailing parameter.
                if p.kind() == 50 { // leftover `...`
                    p.fail("`...` in parameters is removed; use `name <-> T`")
                }
                if p.kind() == 92 { // <->
                    variadic_count += 1
                    if variadic_count == 1 {
                        first_line = p.line()
                        first_col = p.col()
                    }
                    if variadic_count == 2 {
                        second_line = p.line()
                        second_col = p.col()
                    }
                    prm.ival = 1
                    p.bump()
                }
                if mark.len > 0 {
                    if !p.is_type_start_at(0) {
                        prm.a = p.add(ast.mknode(ast.NT_TEMP, prm.line, prm.col)) // nt_temp sentinel
                    } else if p.kind() == 79 || p.kind() == 91 { // temp | any
                        p.fail("use bare name# / name@ for unconstrained; temp/any are box types")
                    } else {
                        prm.a = p.parse_type()
                    }
                } else {
                    prm.a = p.parse_type()
                }
                prm.sval2 = mark
                // Gen1→gen2: mark/kind probes above can clobber prm.sval on the
                // stack; re-bind from the stable local before pooling.
                prm.sval = name0
                variadic := prm.ival == 1
                idx := p.add(prm)
                last_variadic = variadic
                if params < 0 { params = idx } else { p.set_next(last, idx) }
                last = idx
                p.skip_newlines()
                if p.kind() == 25 { // ,
                    p.bump()
                    p.skip_newlines()
                } else {
                    pdone = true
                }
        }
    }
    if variadic_count > 1 {
        p.fail_at2(second_line, second_col, "multiple <-> parameters are not allowed")
    }
    if variadic_count == 1 && !last_variadic {
        p.fail_at2(first_line, first_col, "<-> is only allowed on the last parameter")
    }
    p.expect(20, ")")
    // Optional << type (absent = void). Allow int/bool/string/Named/[]T/&T/chan T/fn
    rk := p.kind()
    if rk == 4 || rk == 16 || rk == 17 || rk == 18 || rk == 67 || rk == 72 || rk == 73 || rk == 74 || rk == 79 || rk == 91 || rk == 1 || rk == 69 || rk == 23 || rk == 39 || rk == 70 || rk == 89 {
        node.b = p.parse_type()
    }
    node.a = params
    ni := p.add(node)
    p.desugar_fn_temp_marks(ni)
    mut n := p.get_node(ni)
    n.c = p.parse_block()
    p.set_node(ni, n)
    << ni
}

// Optional `#T` / `#int, string` type-argument list; -1 when absent.
fn (p &mut Parser) parse_type_args() int {
    if p.kind() == 33 { // <
        p.fail("`Name<...>` type args are removed; use Name#...")
    }
    if p.kind() != 88 { // #
        << -1
    }
    p.bump()
    mut head := -1
    mut last := -1
    mut done := false
    while !done {
            ty := p.parse_type()
            if head < 0 { head = ty } else { p.set_next(last, ty) }
            last = ty
            if p.kind() == 25 { // ,
                p.bump()
            } else {
                done = true
            }
    }
    << head
}

fn (p &mut Parser) parse_type() int {
    k := p.kind()
    if k == 4 { // fn (T, U) R / fn() — M103 function type
        line := p.line()
        col := p.col()
        p.bump() // fn
        p.expect(19, "(")
        mut params := -1
        mut plast := -1
        p.skip_newlines()
        if p.kind() != 20 {
            mut pdone := false
            while !pdone {
                    ty := p.parse_type()
                    if params < 0 { params = ty } else { p.set_next(plast, ty) }
                    plast = ty
                    p.skip_newlines()
                    if p.kind() == 25 { // ,
                        p.bump()
                        p.skip_newlines()
                    } else {
                        pdone = true
                    }
            }
        }
        p.expect(20, ")")
        mut n := ast.mknode(ast.NT_FN, line, col) // nt_fn
        n.a = params
        rk := p.kind()
        // Optional << type (absent = void). Same starters as parse_fn plus `fn`.
        if rk == 4 || rk == 16 || rk == 17 || rk == 18 || rk == 67 || rk == 72 || rk == 73 || rk == 74 || rk == 79 || rk == 91 || rk == 1 || rk == 69 || rk == 23 || rk == 39 || rk == 70 || rk == 89 {
            n.b = p.parse_type()
        }
        << p.add(n)
    }
    if k == 70 { // chan T (M17)
        line := p.line()
        col := p.col()
        p.bump()
        inner := p.parse_type()
        mut n := ast.mknode(ast.NT_CHAN, line, col)
        n.a = inner
        << p.add(n)
    }
    if k == 89 { // map[K]V
        line := p.line()
        col := p.col()
        p.bump()
        p.expect(23, "[")
        key := p.parse_type()
        p.expect(24, "]")
        val := p.parse_type()
        mut n := ast.mknode(ast.NT_MAP, line, col)
        n.a = key
        n.b = val
        p.ensure_maps_import()
        << p.add(n)
    }
    if k == 23 { // [ — `[]T` or `[N]T` (N = positive int literal)
        line := p.line()
        col := p.col()
        p.bump()
        if p.kind() == 2 { // Int → [N]T
            nlen := p.ival()
            if nlen <= 0 {
                p.fail("fixed array length must be positive, found " + str(nlen))
            }
            p.bump()
            p.expect(24, "]")
            inner := p.parse_type()
            mut n := ast.mknode(ast.NT_ARRAY, line, col)
            n.a = inner
            n.ival = nlen
            << p.add(n)
        }
        p.expect(24, "]")
        inner := p.parse_type()
        mut n := ast.mknode(ast.NT_ARRAY, line, col)
        n.a = inner
        << p.add(n)
    }
    if k == 39 { // &
        line := p.line()
        col := p.col()
        p.bump()
        mut n := ast.mknode(ast.NT_REF, line, col)
        if p.kind() == 5 { // mut
            p.bump()
            n.ival = 1
        }
        // M156: `&a T` — Ident is lifetime when next token starts a type.
        if p.kind() == 1 {
            nk := p.kind_at(1)
            if nk == 4 || nk == 16 || nk == 17 || nk == 18 || nk == 67 || nk == 72 || nk == 73 || nk == 74 || nk == 79 || nk == 91 || nk == 1 || nk == 69 || nk == 23 || nk == 39 || nk == 70 || nk == 89 {
                n.sval = p.sval()
                p.bump()
            }
        }
        n.a = p.parse_type()
        << p.add(n)
    }
    if k == 16 || k == 72 || k == 73 || k == 74 { // int / i32 / u32 / u8
        line := p.line()
        col := p.col()
        mut n := ast.mknode(ast.NT_INT, line, col)
        if k == 72 { n.ival = 1 } // i32
        if k == 73 { n.ival = 2 } // u32
        if k == 74 { n.ival = 3 } // u8 / byte
        p.bump()
        << p.add(n)
    }
    if k == 17 { // bool
        line := p.line()
        col := p.col()
        p.bump()
        << p.add(ast.mknode(ast.NT_BOOL, line, col))
    }
    if k == 67 { // f64
        line := p.line()
        col := p.col()
        p.bump()
        << p.add(ast.mknode(ast.NT_F64, line, col))
    }
    if k == 18 { // string
        line := p.line()
        col := p.col()
        p.bump()
        << p.add(ast.mknode(ast.NT_STR, line, col))
    }
    if k == 79 { // temp (M200) or temp# value generic
        line := p.line()
        col := p.col()
        p.bump()
        if p.kind() == 88 { // temp#
            p.bump()
            mut n := ast.mknode(ast.NT_NAMED, line, col)
            n.sval = "__temp"
            << p.add(n)
        }
        << p.add(ast.mknode(ast.NT_TEMP, line, col))
    }
    if k == 91 { // any — same surface as temp, non-consuming `as`
        line := p.line()
        col := p.col()
        p.bump()
        if p.kind() == 88 { // any#
            p.bump()
            mut n := ast.mknode(ast.NT_NAMED, line, col)
            n.sval = "__any"
            << p.add(n)
        }
        << p.add(ast.mknode(ast.NT_ANY, line, col))
    }
    if k == 1 || k == 69 { // Ident, or `xu` as package path root
        line := p.line()
        col := p.col()
        mut name := ""
        if k == 69 {
            name = "xu"
        } else {
            name = p.sval()
        }
        p.bump()
        // M102: bare `Self` → nt_self (only valid in struct@ method sigs).
        if name == "Self" && p.kind() != 51 {
            << p.add(ast.mknode(ast.NT_SELF, line, col))
        }
        if name == "Result" && p.kind() == 33 {
            p.fail_at2(line, col, "`Result<T, E>` is removed; use `>>` and `or (err) { }` for errors")
        }
        // Qualified type: `math.Vec2` (M9). Join segments into one TNamed
        // sval, matching bootstrap xuparse.
        mut qdone := false
        while !qdone {
                if p.kind() == 51 { // .
                    p.bump()
                    seg := p.expect_path_ident()
                    name = name + "." + seg
                } else {
                    qdone = true
                }
        }
        // `T#` sugar (no type args after #)
        if p.kind() == 88 && !p.is_type_start_at(1) {
            p.bump()
            mut n := ast.mknode(ast.NT_NAMED, line, col)
            n.sval = name
            << p.add(n)
        }
        mut n := ast.mknode(ast.NT_NAMED, line, col)
        n.sval = name
        n.a = p.parse_type_args()
        << p.add(n)
    }
    p.fail("expected type, found " + p.describe_here())
    << -1
}
