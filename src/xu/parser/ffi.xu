@xu/parser
// C FFI declarations.
//
//   extern "C" [link "lib"...] fn name(p T, ...[, ...]) [T] [= "symbol" | = dynamic]
//   extern "C" [link "lib"...] { [pub] fn ... }
//   @repr("C") [pub] struct Name { field T ... }
//   unsafe fn name(...) { ... }   unsafe { ... }
//
// Extern parameter and result types are Xu types (the C names c_int, c_ptr,
// ... are aliases, see ident_scalar_ival) plus `cstr`: a borrowed string
// passed as a NUL-terminated copy, or a C string result copied into a Xu
// string. An extern becomes an ordinary body-less NK_FN plus an NK_FFI node
// (listed in ffi_nodes) that keeps the C-level facts for lowering.

#xu/ast

fn (p $&Parser) ffi_param_type(spells $&string) int {
    line := p.line()
    col := p.col()
    if p.kind() == 1 && p.sval() == "cstr" && p.kind_at(1) != 51 {
        p.bump()
        $n := ast.mknode(ast.NT_REF, line, col)
        n.a = p.add(ast.mknode(ast.NT_STR, line, col))
        spells.push_str("|cstr")
        << p.add(n)
    }
    spells.push_str("|")
    << p.parse_type()
}

fn (p &Parser) ffi_ret_start() bool {
    k := p.kind()
    if k == 1 && p.sval() == "dynamic" { << false }
    << k == 1 || k == 4 || k == 16 || k == 17 || k == 18 || k == 67 || k == 72 || k == 73 || k == 74 ||
        k == 39 || k == ast.TOK_DOLLAR || k == 23 || k == 70 || k == 89
}

// At `extern`: one declaration or a `{ ... }` block. is_pub applies to a
// single declaration; block members carry their own `pub`.
fn (p $&Parser) parse_extern(is_pub int) {
    eline := p.line()
    ecol := p.col()
    p.bump() // extern
    abi := p.sval()
    if abi != "C" && abi != "c" { p.fail("only extern \"C\" is supported") }
    p.bump()
    $libs := ""
    while p.kind() == 1 && p.sval() == "link" {
        p.bump()
        if p.kind() != 3 { p.fail("expected a library name string after link") }
        while p.kind() == 3 {
            name := p.sval()
            if name.len == 0 || ffi_has_byte(&name, 44) { p.fail("invalid library name") }
            libs = libs + name + ","
            p.bump()
        }
    }
    $meta := ast.mknode(ast.NK_FFI, eline, ecol)
    meta.ival = ast.FFI_META
    meta.sval = libs
    meta_idx := p.add(meta)
    if p.kind() == 4 || p.kind() == 80 || (p.kind() == 1 && p.sval() == "static") || (p.kind() == 90 && (p.kind_at(1) == 80 || (p.kind_at(1) == 1 && p.sval_at(1) == "static"))) {
        p.parse_extern_item(is_pub, meta_idx)
        <<
    }
    if is_pub == 1 { p.fail("write pub on each declaration inside an extern block") }
    p.expect(21, "{")
    $done := false
    while !done {
        p.skip_newlines()
        k := p.kind()
        if k == 22 {
            p.bump()
            done = true
        } else if k == 54 {
            p.fail("unexpected end of file inside extern block")
        } else {
            $fpub := 0
            if k == 65 {
                p.bump()
                p.skip_newlines()
                fpub = 1
            }
            p.parse_extern_item(fpub, meta_idx)
        }
    }
}

fn (p $&Parser) parse_extern_item(is_pub int, meta int) {
    if p.kind() == 4 {
        p.parse_extern_fn(is_pub, meta)
        <<
    }
    if p.kind() == 80 || (p.kind() == 1 && p.sval() == "static") || (p.kind() == 90 && (p.kind_at(1) == 80 || (p.kind_at(1) == 1 && p.sval_at(1) == "static"))) {
        p.parse_extern_var(is_pub, meta)
        <<
    }
    p.fail("expected fn, let, or static in extern block, found " + p.describe_here())
}

fn (p $&Parser) parse_extern_var(is_pub int, meta int) {
    vline := p.line()
    vcol := p.col()
    $is_mut := 0
    if p.kind() == 90 {
        p.bump()
        is_mut = 1
    }
    if p.kind() == 1 && p.sval() == "static" {
        p.bump()
        if p.kind() == 90 {
            p.bump()
            is_mut = 1
        }
    } else {
        p.expect(80, "let")
    }
    name := p.expect_ident()
    ty := p.parse_type()
    $symbol := name + ""
    if p.kind() == 45 {
        p.bump()
        if p.kind() != 3 { p.fail("expected a C symbol string after = on extern global") }
        symbol = p.sval()
        if symbol.len == 0 { p.fail("empty C symbol name") }
        p.bump()
    }
    $node := ast.mknode(ast.NK_EXTERN_VAR, vline, vcol)
    node.sval = ~name
    node.a = ty
    ni := p.add(node)
    p.stamp_decl(ni, is_pub + is_mut * 2)
    p.push_decl(ni)
    $ffi := ast.mknode(ast.NK_FFI, vline, vcol)
    ffi.a = ni
    ffi.b = meta
    ffi.ival = ast.FFI_GLOBAL
    ffi.sval = symbol
    p.ffi_nodes.push(p.add(ffi))
}

fn ffi_has_byte(s &string, b int) bool {
    for i in 0:s.len {
        if (s[i] & 255) == b { << true }
    }
    << false
}

fn (p $&Parser) parse_extern_fn(is_pub int, meta int) {
    fline := p.line()
    fcol := p.col()
    p.expect(4, "fn")
    p.nfn += 1
    $node := ast.mknode(ast.NK_FN, fline, fcol)
    node.sval = p.expect_ident()
    p.expect(19, "(")
    $params := -1
    $last := -1
    $spells := ""
    $flags := 0
    p.skip_newlines()
    if p.kind() != 20 {
        $done := false
        while !done {
            if p.kind() == 50 { // ... — C variadic tail
                p.bump()
                flags = flags | ast.FFI_VARIADIC
                p.skip_newlines()
                if p.kind() != 20 { p.fail("... must end the C parameter list") }
                done = true
            } else {
                $prm := ast.mknode(ast.NK_PARAM, p.line(), p.col())
                name := p.expect_ident()
                prm.a = p.ffi_param_type($&spells)
                prm.sval = name
                idx := p.add(prm)
                if params < 0 { params = idx } else { p.set_next(last, idx) }
                last = idx
                p.skip_newlines()
                if p.kind() == 25 {
                    p.bump()
                    p.skip_newlines()
                } else {
                    done = true
                }
            }
        }
    }
    p.expect(20, ")")
    if (flags & ast.FFI_VARIADIC) != 0 {
        // The checker accepts any FFI-passable arguments here; lowering
        // specializes the C call from their static types.
        $prm := ast.mknode(ast.NK_PARAM, p.line(), p.col())
        prm.sval = "c_varargs"
        prm.ival = 1
        prm.a = p.add(ast.mknode(ast.NT_ANY, p.line(), p.col()))
        idx := p.add(prm)
        if params < 0 { params = idx } else { p.set_next(last, idx) }
    }
    $ret_spell := ""
    if p.kind() == 1 && p.sval() == "c_void" {
        p.bump()
    } else if p.kind() == 1 && p.sval() == "cstr" && p.kind_at(1) != 51 {
        node.b = p.add(ast.mknode(ast.NT_STR, p.line(), p.col()))
        p.bump()
        ret_spell = "cstr"
    } else if p.ffi_ret_start() {
        node.b = p.parse_type()
    }
    $symbol := node.sval + ""
    if p.kind() == 45 { // = "symbol" | = dynamic
        p.bump()
        if p.kind() == 3 {
            symbol = p.sval()
            if symbol.len == 0 { p.fail("empty C symbol name") }
            p.bump()
        } else if p.kind() == 1 && p.sval() == "dynamic" {
            p.bump()
            flags = flags | ast.FFI_DYNAMIC
            if params < 0 || p.nodes[params].a < 0 || p.nodes[p.nodes[params].a].kind != ast.NT_INT ||
                p.nodes[p.nodes[params].a].ival != 4 {
                p.fail("a dynamic extern takes the C function pointer (c_ptr) as its first parameter")
            }
        } else {
            p.fail("expected \"symbol\" or dynamic after =")
        }
    }
    node.a = params
    ni := p.add(node)
    p.stamp_decl(ni, is_pub)
    p.push_decl(ni)
    $ffi := ast.mknode(ast.NK_FFI, fline, fcol)
    ffi.a = ni
    ffi.b = meta
    ffi.ival = flags
    ffi.sval = symbol
    ffi.sval2 = ret_spell + spells
    p.ffi_nodes.push(p.add(ffi))
}

// [pub] static [$]name T [= init] (with optional @align(N|CONST), @export("sym"), @no_mangle, @section("..."), @weak).
fn (p $&Parser) parse_static_var(is_pub int, has_export bool, export_sym string, custom_align int, align_expr int, section_name string, has_weak bool, attr_line int, attr_col int) {
    vline := p.line()
    vcol := p.col()
    if p.kind() != 1 || p.sval() != "static" {
        p.fail("expected static variable declaration, found " + p.describe_here())
    }
    p.bump() // static
    $is_mut := 0
    if p.kind() == 90 { // $
        p.bump()
        is_mut = 1
    }
    name := p.expect_ident()
    ty := p.parse_type()
    $init_expr := -1
    if p.kind() == 45 { // =
        p.bump()
        init_expr = p.parse_expr()
    }
    $node := ast.mknode(ast.NK_EXTERN_VAR, vline, vcol)
    node.sval = ~name
    node.a = ty
    node.b = init_expr
    ni := p.add(node)
    p.stamp_decl(ni, is_pub + is_mut * 2)
    p.push_decl(ni)
    $ffi := ast.mknode(ast.NK_FFI, attr_line, attr_col)
    ffi.a = ni
    ffi.b = -1
    $flags := ast.FFI_GLOBAL | ast.FFI_BSS
    $sym := export_sym + ""
    if has_export {
        flags = flags | ast.FFI_EXPORT
        if sym.len == 0 {
            sym = name + ""
        }
    }
    if has_weak {
        flags = flags | ast.FFI_WEAK
    }
    if custom_align > 0 || align_expr >= 0 {
        flags = flags | ast.FFI_ALIGNED
        ffi.c = custom_align
        ffi.d = align_expr
    }
    if section_name.len > 0 {
        flags = flags | ast.FFI_SECTION
        ffi.sval2 = section_name + ""
    }
    ffi.ival = flags
    ffi.sval = sym
    p.ffi_nodes.push(p.add(ffi))
}

fn (p $&Parser) mark_unsafe_fn(d int) {
    $ffi := ast.mknode(ast.NK_FFI, p.nodes[d].line, p.nodes[d].col)
    ffi.a = d
    ffi.ival = ast.FFI_UNSAFE_FN
    p.ffi_nodes.push(p.add(ffi))
}

// Unified attribute-chain parser: `@repr`, `@align`, `@packed`, `@export`,
// `@no_mangle`, `@noreturn`, `@section`, `@panic_handler`, `@weak`, `@naked`
// in any valid combination before struct/union, static, or fn.
fn (p $&Parser) parse_attr_decl(is_pub0 int) {
    first_line := p.line()
    first_col := p.col()
    $has_repr := false
    $is_packed := 0
    $custom_align := 0
    $align_expr := -1
    $has_align := false
    $has_export := false
    $has_no_mangle := false
    $has_noreturn := false
    $has_section := false
    $has_panic_handler := false
    $has_weak := false
    $has_naked := false
    $has_interrupt := false
    $export_sym := ""
    $interrupt_mode := ""
    $section_name := ""

    while p.kind() == 84 && p.kind_at(1) == 1 &&
        (p.sval_at(1) == "repr" || p.sval_at(1) == "align" || p.sval_at(1) == "packed" ||
         p.sval_at(1) == "export" || p.sval_at(1) == "no_mangle" || p.sval_at(1) == "noreturn" ||
         p.sval_at(1) == "section" || p.sval_at(1) == "panic_handler" ||
         p.sval_at(1) == "weak" || p.sval_at(1) == "naked" || p.sval_at(1) == "interrupt") {
        p.bump() // @
        attr := p.sval()
        p.bump() // attr name
        if attr == "repr" {
            has_repr = true
            p.expect(19, "(")
            $done := false
            while !done && p.kind() != 20 && p.kind() != 54 {
                if p.kind() == 3 { // "C"
                    s := p.sval()
                    if s != "C" && s != "c" { p.fail("only @repr(\"C\") or @repr(packed, align(...)) is supported") }
                    p.bump()
                } else if p.kind() == 1 {
                    w := p.sval()
                    if w == "C" || w == "c" {
                        p.bump()
                    } else if w == "packed" {
                        is_packed = 1
                        p.bump()
                    } else if w == "align" {
                        p.bump()
                        if p.kind() == 48 { // align: N
                            p.bump()
                            if p.kind() != 2 { p.fail("expected integer alignment after align:") }
                            custom_align = p.ival()
                            if custom_align <= 0 { p.fail("alignment must be a positive power of two") }
                            align_expr = -1
                            has_align = true
                            p.bump()
                        } else if p.kind() == 19 { // align(N)
                            p.bump()
                            if p.kind() == 2 && p.kind_at(1) == 20 {
                                custom_align = p.ival()
                                if custom_align <= 0 { p.fail("alignment must be a positive power of two") }
                                align_expr = -1
                                p.bump()
                            } else {
                                align_expr = p.parse_expr()
                                custom_align = 0
                            }
                            has_align = true
                            p.expect(20, ")")
                        } else {
                            p.fail("expected align: N or align(N)")
                        }
                    } else {
                        p.fail("unknown repr attribute: " + w)
                    }
                } else {
                    p.fail("expected repr attribute, found " + p.describe_here())
                }
                if p.kind() == 25 { // ,
                    p.bump()
                } else {
                    done = true
                }
            }
            p.expect(20, ")")
        } else if attr == "align" {
            p.expect(19, "(")
            if p.kind() == 2 && p.kind_at(1) == 20 {
                custom_align = p.ival()
                if custom_align <= 0 { p.fail("@align alignment must be a positive power of two") }
                align_expr = -1
                p.bump()
            } else {
                align_expr = p.parse_expr()
                custom_align = 0
            }
            has_align = true
            p.expect(20, ")")
        } else if attr == "packed" {
            if p.kind() == 19 {
                p.bump()
                p.expect(20, ")")
            }
            is_packed = 1
        } else if attr == "export" {
            has_export = true
            p.expect(19, "(")
            if p.kind() != 3 {
                p.fail("@export expects a symbol name string literal")
            }
            export_sym = p.sval()
            if export_sym.len == 0 {
                p.fail("@export symbol name cannot be empty")
            }
            p.bump()
            p.expect(20, ")")
        } else if attr == "no_mangle" {
            has_no_mangle = true
            if p.kind() == 19 {
                p.bump()
                p.expect(20, ")")
            }
        } else if attr == "noreturn" {
            has_noreturn = true
            if p.kind() == 19 {
                p.bump()
                p.expect(20, ")")
            }
        } else if attr == "section" {
            has_section = true
            p.expect(19, "(")
            if p.kind() != 3 {
                p.fail("@section expects a section name string literal")
            }
            section_name = p.sval()
            if section_name.len == 0 {
                p.fail("@section name cannot be empty")
            }
            p.bump()
            p.expect(20, ")")
        } else if attr == "panic_handler" {
            has_panic_handler = true
            if p.kind() == 19 {
                p.bump()
                p.expect(20, ")")
            }
        } else if attr == "weak" {
            has_weak = true
            if p.kind() == 19 {
                p.bump()
                p.expect(20, ")")
            }
        } else if attr == "naked" {
            has_naked = true
            if p.kind() == 19 {
                p.bump()
                p.expect(20, ")")
            }
        } else if attr == "interrupt" {
            has_interrupt = true
            if p.kind() == 19 {
                p.bump()
                if p.kind() == 3 {
                    interrupt_mode = p.sval()
                    if interrupt_mode != "machine" && interrupt_mode != "supervisor" {
                        p.fail("@interrupt mode must be \"machine\" or \"supervisor\"")
                    }
                    p.bump()
                }
                p.expect(20, ")")
            }
        }
        p.skip_newlines()
    }

    $is_pub := is_pub0
    if p.kind() == 65 { // pub
        p.bump()
        p.skip_newlines()
        is_pub = 1
    }
    is_union := p.kind() == 1 && p.sval() == "union"
    if p.kind() == 11 || is_union {
        if has_export || has_no_mangle || has_noreturn || has_panic_handler || has_weak || has_naked || has_interrupt {
            p.fail("@export/@no_mangle/@noreturn/@panic_handler/@weak/@naked/@interrupt cannot be applied to a struct or union")
        }
        if has_section {
            p.fail("@section cannot be applied to a struct or union")
        }
        d := p.parse_struct_or_union(is_union)
        p.stamp_decl(d, is_pub)
        p.push_decl(d)
        $ffi := ast.mknode(ast.NK_FFI, p.nodes[d].line, p.nodes[d].col)
        ffi.a = d
        $flags := ast.FFI_STRUCT
        if is_union { flags = flags | ast.FFI_UNION }
        if is_packed == 1 { flags = flags | ast.FFI_PACKED }
        if custom_align > 0 || align_expr >= 0 {
            flags = flags | ast.FFI_ALIGNED
            ffi.c = custom_align
            ffi.d = align_expr
        }
        ffi.ival = flags
        ffi.sval = p.nodes[d].sval + ""
        p.ffi_nodes.push(p.add(ffi))
        <<
    }
    if p.kind() == 1 && p.sval() == "static" {
        if has_repr || is_packed == 1 || has_noreturn || has_panic_handler || has_naked || has_interrupt {
            p.fail("@repr/@packed/@noreturn/@panic_handler/@naked/@interrupt cannot be applied to a static variable")
        }
        p.parse_static_var(is_pub, has_export || has_no_mangle, export_sym, custom_align, align_expr, section_name, has_weak, first_line, first_col)
        <<
    }
    $is_unsafe := false
    if p.kind() == 1 && p.sval() == "unsafe" && p.kind_at(1) == 4 {
        p.bump()
        is_unsafe = true
    }
    if p.kind() == 4 {
        if has_repr || is_packed == 1 || has_align {
            p.fail("@repr/@packed/@align cannot be applied to a function declaration")
        }
        if has_section {
            p.fail("@section is currently supported on static variables")
        }
        d := p.parse_fn()
        if has_panic_handler {
            if has_export || has_no_mangle {
                p.fail("@panic_handler cannot be combined with @export or @no_mangle")
            }
            if p.nodes[d].d >= 0 {
                p.fail("@panic_handler cannot be applied to a method")
            }
            if p.nodes[d].e >= 0 {
                p.fail("@panic_handler cannot be applied to a generic function")
            }
        }
        if has_naked {
            if p.nodes[d].d >= 0 {
                p.fail("@naked cannot be applied to a method")
            }
            if p.nodes[d].e >= 0 {
                p.fail("@naked cannot be applied to a generic function")
            }
        }
        if has_interrupt {
            if p.nodes[d].d >= 0 {
                p.fail("@interrupt cannot be applied to a method")
            }
            if p.nodes[d].e >= 0 {
                p.fail("@interrupt cannot be applied to a generic function")
            }
        }
        if has_export || has_no_mangle {
            if p.nodes[d].d >= 0 {
                p.fail("@export/@no_mangle cannot be applied to a method")
            }
            if p.nodes[d].e >= 0 {
                p.fail("@export/@no_mangle cannot be applied to a generic function")
            }
            if export_sym.len == 0 {
                export_sym = p.nodes[d].sval + ""
            }
        }
        if is_unsafe {
            p.mark_unsafe_fn(d)
        }
        p.stamp_decl(d, is_pub)
        p.push_decl(d)
        if has_panic_handler {
            $pfi := ast.mknode(ast.NK_FFI, first_line, first_col)
            pfi.a = d
            pfi.ival = ast.FFI_EXPORT | ast.FFI_PANIC_HANDLER
            pfi.sval = "__xu_panic_handler"
            p.ffi_nodes.push(p.add(pfi))
        }
        if has_export || has_no_mangle {
            $ffi := ast.mknode(ast.NK_FFI, first_line, first_col)
            ffi.a = d
            ffi.ival = ast.FFI_EXPORT
            ffi.sval = export_sym
            p.ffi_nodes.push(p.add(ffi))
        }
        if has_noreturn || has_panic_handler {
            $nr := ast.mknode(ast.NK_FFI, first_line, first_col)
            nr.a = d
            nr.ival = ast.FFI_NORETURN
            p.ffi_nodes.push(p.add(nr))
        }
        if has_weak {
            $wk := ast.mknode(ast.NK_FFI, first_line, first_col)
            wk.a = d
            wk.ival = ast.FFI_WEAK
            p.ffi_nodes.push(p.add(wk))
        }
        if has_naked {
            $nk := ast.mknode(ast.NK_FFI, first_line, first_col)
            nk.a = d
            nk.ival = ast.FFI_NAKED
            p.ffi_nodes.push(p.add(nk))
        }
        if has_interrupt {
            $intr := ast.mknode(ast.NK_FFI, first_line, first_col)
            intr.a = d
            intr.ival = ast.FFI_INTERRUPT
            intr.sval = ~interrupt_mode
            p.ffi_nodes.push(p.add(intr))
        }
        <<
    }
    p.fail("expected struct, union, static, or fn after attribute, found " + p.describe_here())
}
