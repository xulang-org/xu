@xu/parser

#xu/ast

// ===== Expressions =====

fn (p &mut Parser) parse_expr() int { << p.parse_or() }

fn (p &mut Parser) parse_or() int {
    mut lhs := p.parse_and()
    while p.kind() == 38 { // ||
            line := p.line()
            col := p.col()
            p.bump()
            p.skip_newlines()
            rhs := p.parse_and()
            lhs = p.mk_binop(13, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_and() int {
    mut lhs := p.parse_bitor()
    while p.kind() == 37 { // &&
            line := p.line()
            col := p.col()
            p.bump()
            p.skip_newlines()
            rhs := p.parse_bitor()
            lhs = p.mk_binop(12, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_bitor() int {
    mut lhs := p.parse_bitxor()
    while p.kind() == 40 { // |
            line := p.line()
            col := p.col()
            p.bump()
            p.skip_newlines()
            rhs := p.parse_bitxor()
            lhs = p.mk_binop(15, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_bitxor() int {
    mut lhs := p.parse_bitand()
    while p.kind() == 41 { // ^
            line := p.line()
            col := p.col()
            p.bump()
            p.skip_newlines()
            rhs := p.parse_bitand()
            lhs = p.mk_binop(16, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_bitand() int {
    mut lhs := p.parse_equality()
    while p.kind() == 39 { // & (infix; a prefix & is a borrow)
            line := p.line()
            col := p.col()
            p.bump()
            p.skip_newlines()
            rhs := p.parse_equality()
            lhs = p.mk_binop(14, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_equality() int {
    mut lhs := p.parse_comparison()
    while true {
        mut op := 0
        k2 := p.kind()
        if k2 == 31 { op = 6 }  // ==
        if k2 == 32 { op = 7 }  // !=
        if op == 0 {
            <-
        }
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        rhs := p.parse_comparison()
        lhs = p.mk_binop(op, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_comparison() int {
    mut lhs := p.parse_shift()
    // M147: `e is T` / `e as T` (tok_is=78, tok_as=77).
    k0 := p.kind()
    if k0 == 78 || k0 == 77 {
        line := p.line()
        col := p.col()
        is_kw := k0 == 78
        p.bump()
        p.skip_newlines()
        ty := p.parse_type()
        if is_kw {
            << p.mk_type_is(lhs, ty, line, col)
        }
        << p.mk_type_as(lhs, ty, line, col)
    }
    while true {
        mut op := 0
        k2 := p.kind()
        if k2 == 33 { op = 8 }  // <
        if k2 == 34 { op = 9 }  // <=
        if k2 == 35 { op = 10 } // >
        if k2 == 36 { op = 11 } // >=
        if op == 0 {
            <-
        }
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        rhs := p.parse_shift()
        lhs = p.mk_binop(op, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_shift() int {
    mut lhs := p.parse_additive()
    while true {
        mut op := 0
        k2 := p.kind()
        if k2 == 42 { op = 17 } // <<
        if k2 == 43 { op = 18 } // >>
        if op == 0 {
            <-
        }
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        rhs := p.parse_additive()
        lhs = p.mk_binop(op, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_additive() int {
    mut lhs := p.parse_multiplicative()
    while true {
        mut op := 0
        k2 := p.kind()
        if k2 == 26 { op = 1 } // +
        if k2 == 27 { op = 2 } // -
        if op == 0 {
            <-
        }
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        rhs := p.parse_multiplicative()
        lhs = p.mk_binop(op, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_multiplicative() int {
    mut lhs := p.parse_unary()
    while true {
        mut op := 0
        k2 := p.kind()
        if k2 == 28 { op = 3 } // *
        if k2 == 29 { op = 4 } // /
        if k2 == 30 { op = 5 } // %
        if op == 0 {
            <-
        }
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        rhs := p.parse_unary()
        lhs = p.mk_binop(op, lhs, rhs, line, col)
    }
    << lhs
}

fn (p &mut Parser) parse_unary() int {
    k := p.kind()
    // Spec34 H38: reject marker permutations before unary parsing.
    if k == ast.TOK_DOLLAR && p.kind_at(1) == 39 && p.kind_at(2) == 28 {
        p.fail("H38: explicit reborrow uses '&*r' (or just 'r' under expectation)")
    }
    if k == ast.TOK_DOLLAR && p.kind_at(1) != 39 {
        p.fail("H38: '\$name' is not a value use; use plain 'name' here; mutable declarations use '\$name :='")
    }
    if k == 28 && p.kind_at(1) == ast.TOK_DOLLAR && p.kind_at(2) == 39 {
        p.fail("H38: explicit reborrow uses '&*r' (or just 'r' under expectation)")
    }
    if k == 39 && p.kind_at(1) == ast.TOK_DOLLAR {
        p.fail("H38: rejected spelling; use '\$name :=' for mutable binding, '\$&name' for writable borrow")
    }
    if k == 39 && p.kind_at(1) == 5 && p.kind_at(2) != 39 {
        p.fail("expected an expression after '&'; writable borrow expressions use 'mut &x'; '&mut T' is a type spelling (writable borrow spelling: '\$&x')")
    }
    if k == 44 { // !
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        << p.mk_unop(2, p.parse_unary(), line, col)
    }
    if k == 27 { // -
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        << p.mk_unop(1, p.parse_unary(), line, col)
    }
    if k == 28 { // *e — MS3 unary deref (infix * stays in parse_multiplicative)
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        << p.mk_unop(3, p.parse_unary(), line, col)
    }
    if k == 71 { // <-ch receive (M17)
        line := p.line()
        col := p.col()
        p.bump()
        p.skip_newlines()
        mut n := ast.mknode(ast.NK_RECV, line, col)
        n.a = p.parse_unary()
        << p.add(n)
    }
    if k == 39 { // &x — shared borrow
        line := p.line()
        col := p.col()
        p.bump()
        mut n := ast.mknode(ast.NK_BORROW, line, col)
        n.a = p.parse_unary()
        << p.add(n)
    }
    if (k == 5 || k == ast.TOK_DOLLAR) && p.kind_at(1) == 39 { // mut &x / $&x
        line := p.line()
        col := p.col()
        p.bump() // 'mut'
        p.bump() // '&'
        // Inner is unary so `mut &*r` parses as Borrow of Deref (bootstrap).
        mut n := ast.mknode(ast.NK_BORROW, line, col)
        n.ival = 1
        n.a = p.parse_unary()
        << p.add(n)
    }
    << p.parse_postfix()
}

// Flatten Ident / Field chain (`a` / `a.b.c`) into a dotted path string.
// Returns '' when `n` is not a path prefix (mirrors bootstrap path_prefix_ident).
fn (p &Parser) path_prefix(n int) string {
    k := p.nodes[n].kind
    if k == ast.NK_IDENT {
        << p.nodes[n].sval + ""
    }
    if k == ast.NK_FIELD {
        base := p.path_prefix(p.nodes[n].a)
        if base.len == 0 {
            << ""
        }
        << base + "." + (p.nodes[n].sval + "")
    }
    << ""
}

fn (p &mut Parser) parse_postfix() int {
    mut expr := p.parse_primary()
    mut done := false
    while !done {
            k2 := p.kind()
            if k2 == 19 { // call: callee must be a plain identifier
                lline := p.line()
                lcol := p.col()
                p.bump()
                args := p.parse_call_args()
                if p.nodes[expr].kind != ast.NK_IDENT {
                    p.fail_at2(lline, lcol, "only named functions can be called")
                }
                // Convert the Ident node in place into the Call node: the
                // Rust AST has Call{name, args} with the callee's span and
                // no separate Ident node.
                mut n := p.get_node(expr)
                n.kind = 5
                n.a = args
                p.set_node(expr, n)
            } else if k2 == 23 { // [ — index or slice
                p.bump()
                p.skip_newlines()
                mut start := -1
                if p.kind() != ast.TOK_RIGHT_ARROW && p.kind() != 49 && !ast.tok_is_range(p.kind()) {
                    start = p.parse_expr()
                    p.skip_newlines()
                }
                if p.kind() == 49 { // ..
                    p.fail("`..` in slices is removed; use `start:end`")
                }
                if p.kind() == ast.TOK_RIGHT_ARROW {
                    p.fail("`->` in slices is removed; use `start:end`")
                }
                if ast.tok_is_range(p.kind()) {
                    rk := ast.tok_range_ival(p.kind())
                    p.bump()
                    p.skip_newlines()
                    mut end := -1
                    if p.kind() != 24 { // ]
                        end = p.parse_expr()
                        p.skip_newlines()
                    }
                    p.expect(24, "]")
                    mut n := ast.mknode(ast.NK_SLICE, p.nodes[expr].line, p.nodes[expr].col)
                    n.a = expr
                    n.b = start
                    n.c = end
                    n.ival = rk
                    expr = p.add(n)
                } else {
                    if start < 0 {
                        p.fail("expected index or range inside '[]'")
                    }
                    p.expect(24, "]")
                    mut n := ast.mknode(ast.NK_INDEX, p.nodes[expr].line, p.nodes[expr].col)
                    n.a = expr
                    n.b = start
                    expr = p.add(n)
                }
            } else if k2 == 51 && p.kind_at(1) != 49 { // . — field, method, or qualified struct lit
                p.bump()
                // Field node created before the branch (M2b: `name` cannot
                // move inside a conditional); method call / struct init
                // convert it in place (same node count as the Rust AST).
                mut n := ast.mknode(ast.NK_FIELD, p.nodes[expr].line, p.nodes[expr].col)
                n.a = expr
                n.sval = p.expect_ident()
                if p.kind() == 19 { // method call
                    p.bump()
                    n.kind = 8
                    n.b = p.parse_call_args()
                } else if !p.no_struct_lit && p.kind() == 21 {
                    // `math.Vec2{...}` / `image.color.RGBA{...}` (M9 + nested pkgs)
                    base := p.path_prefix(expr)
                    if base.len > 0 {
                        fname := n.sval + ""
                        p.bump() // {
                        mut fields := -1
                        mut last := -1
                        p.skip_newlines()
                        if p.kind() != 22 {
                            mut done2 := false
                            while !done2 {
                                    mut sf := ast.mknode(ast.NK_S_FIELD, p.line(), p.col())
                                    sf.sval = p.expect_ident()
                                    p.expect(48, ":")
                                    sf.a = p.parse_expr()
                                    idx := p.add(sf)
                                    if fields < 0 {
                                        fields = idx
                                    } else {
                                        p.set_next(last, idx)
                                    }
                                    last = idx
                                    p.skip_newlines()
                                    if p.kind() == 25 {
                                        p.bump()
                                        p.skip_newlines()
                                    } else {
                                        done2 = true
                                    }
                            }
                        }
                        p.expect(22, "}")
                        n.kind = 6
                        n.a = fields
                        n.b = -1
                        n.sval = base + "." + fname
                    }
                }
                expr = p.add(n)
            } else if k2 == 52 { // ?
                p.fail_at2(p.nodes[expr].line, p.nodes[expr].col, "operator `?` is removed; use `>>` and `or (err) { }`")
            } else {
                done = true
            }
    }
    if p.kind() == 82 { // or — `call or (err) { }` / sugar `call or >>` (not `||`)
        ek := p.nodes[expr].kind
        if ek != ast.NK_CALL && ek != ast.NK_METHOD_CALL && ek != ast.NK_INDEX {
            p.fail("'or' must follow a function call")
        }
        p.bump()
        mut bind := ""
        mut body := -1
        if p.kind() == 43 { // >> — `or >>` ≡ `or (err) { >> err }`
            tline := p.line()
            tcol := p.col()
            p.bump()
            mut id := ast.mknode(ast.NK_IDENT, tline, tcol)
            id.sval = "err"
            mut th := ast.mknode(ast.NK_THROW, tline, tcol)
            th.a = p.add(id)
            body = p.add(th)
            bind = "err"
        } else {
            p.expect(19, "(")
            bind = p.expect_ident()
            p.expect(20, ")")
            body = p.parse_block()
        }
        mut n := ast.mknode(ast.NK_OR_CATCH, p.nodes[expr].line, p.nodes[expr].col)
        n.a = expr
        n.sval = bind
        n.c = body
        expr = p.add(n)
    }
    << expr
}

// fail with an explicit position (used where the Rust parser reports the
// span of an already-consumed token). Attributes the path like `fail` (M22).
fn (p &Parser) fail_at2(line int, col int, msg string) {
    mut prefix := ""
    if p.file_name.len > 0 {
        prefix = p.file_name + ":"
    }
    eprintln(prefix + str(line) + ":" + str(col) + ": error: " + msg)
    <<< 1
}

// m32 test-harness diagnostics surface as a bare String prefixed with the
// first input path (mirror bootstrap `{first}:{message}`).
fn (p &Parser) fail_test(msg string) {
    mut pre := ""
    if p.file_names.len > 0 {
        pre = p.file_names[0]
    }
    eprintln(pre + ":" + msg)
    <<< 1
}

// Arguments after an opening `(` has been consumed; -1 when empty.
fn (p &mut Parser) parse_call_args() int {
    p.skip_newlines()
    mut head := -1
    mut last := -1
    if p.kind() != 20 {
        mut done := false
        while !done {
                arg := p.parse_expr()
                if head < 0 { head = arg } else { p.set_next(last, arg) }
                last = arg
                p.skip_newlines()
                if p.kind() == 25 { // ,
                    p.bump()
                    p.skip_newlines()
                } else {
                    done = true
                }
        }
    }
    p.expect(20, ")")
    << head
}

// Pure lookahead: from the `#` at the current position, does a type-argument
// list followed by `{` follow? Consumes nothing.
// Pure lookahead: from `#` at the current position, does a type-argument
// list followed by `.Variant` (generic enum ctor) follow? Consumes nothing.
fn (p &Parser) generic_ctor_ahead() bool {
    if p.kind() != 88 { // #
        << false
    }
    mut j := p.pos + 1
    mut seen := false
    mut depth := 0
    mut scanning := true
    mut result := false
    while scanning && j < p.tokens.len {
            k2 := p.tokens[j].kind
            if k2 == 19 || k2 == 23 { // ( [
                depth += 1
                seen = true
                j += 1
            } else if k2 == 20 || k2 == 24 { // ) ]
                depth = depth - 1
                j += 1
            } else if depth == 0 && k2 == 51 { // .
                // `.Ident#` / `.Ident.` continues a qualified/generic type;
                // otherwise this dot starts the variant.
                if j + 1 < p.tokens.len && p.tokens[j + 1].kind == 1 {
                    mut after := 0
                    if j + 2 < p.tokens.len {
                        after = p.tokens[j + 2].kind
                    }
                    if after == 88 || after == 51 {
                        seen = true
                        j += 1
                    } else {
                        result = seen
                        scanning = false
                    }
                } else {
                    scanning = false
                }
            } else if k2 == 1 || k2 == 16 || k2 == 17 || k2 == 18 || k2 == 67 || k2 == 72 || k2 == 73 || k2 == 74 || k2 == 79 || k2 == 91 || k2 == 39 || k2 == ast.TOK_DOLLAR || k2 == 5 || k2 == 25 || k2 == 69 || k2 == 70 || k2 == 4 || k2 == 88 {
                seen = true
                j += 1
            } else {
                scanning = false
            }
    }
    << result
}

fn (p &Parser) generic_init_ahead() bool {
    if p.kind() != 88 { // #
        << false
    }
    mut j := p.pos + 1
    mut seen := false
    mut scanning := true
    mut result := false
    while scanning && j < p.tokens.len {
            k2 := p.tokens[j].kind
            if k2 == 21 { // {
                result = seen
                scanning = false
            } else if k2 == 1 || k2 == 16 || k2 == 17 || k2 == 18 || k2 == 67 || k2 == 72 || k2 == 73 || k2 == 74 || k2 == 79 || k2 == 91 || k2 == 23 || k2 == 24 || k2 == 39 || k2 == ast.TOK_DOLLAR || k2 == 5 || k2 == 25 || k2 == 69 || k2 == 70 || k2 == 4 || k2 == 88 || k2 == 19 || k2 == 20 || k2 == 51 {
                // type-ish tokens including nested # and fn(...)
                seen = true
                j += 1
            } else {
                scanning = false
            }
    }
    << result
}

fn (p &Parser) is_type_start_at(ahead int) bool {
    k := p.kind_at(ahead)
    if k == ast.TOK_DOLLAR && p.kind_at(ahead + 1) == 39 { << true }
    if k == 4 || k == 70 || k == 89 || k == 23 || k == 39 { << true } // fn chan map [ &
    if k == 16 || k == 17 || k == 18 || k == 67 || k == 72 || k == 73 || k == 74 || k == 79 || k == 91 { << true }
    if k == 1 || k == 69 { << true } // Ident / xu
    << false
}

// Qualified struct literals are represented by one AST node in the Rust
// parser, with the complete dotted name (for example `types.Checker`).  Do
// the same in the Xu parser before parse_postfix builds temporary Ident/Field
// nodes; otherwise those unreachable path nodes remain in the pool and make
// Gen1 frontend statistics drift from the frozen oracle.
fn (p &Parser) qualified_struct_init_ahead() bool {
    if p.kind() != 1 || p.no_struct_lit { << false }
    mut j := p.pos + 1
    mut dotted := false
    while j + 1 < p.tokens.len && p.tokens[j].kind == 51 && p.tokens[j + 1].kind == 1 {
        dotted = true
        j += 2
    }
    << dotted && j < p.tokens.len && p.tokens[j].kind == 21
}

fn (p &Parser) legacy_generic_init_ahead() bool {
    mut depth := 0
    mut j := p.pos
    mut result := false
    mut scanning := true
    while scanning && j < p.tokens.len {
            k2 := p.tokens[j].kind
            if k2 == 33 { // <
                depth += 1
            } else if k2 == 35 { // >
                depth = depth - 1
                if depth == 0 {
                    result = p.tokens[j + 1].kind == 21 // {
                    scanning = false
                }
                if depth < 0 {
                    scanning = false
                }
            } else if k2 == 43 { // >>
                depth = depth - 2
                if depth == 0 {
                    result = p.tokens[j + 1].kind == 21
                    scanning = false
                }
                if depth < 0 {
                    scanning = false
                }
            } else if k2 == 1 || k2 == 16 || k2 == 17 || k2 == 18 || k2 == 23 || k2 == 24 || k2 == 39 || k2 == ast.TOK_DOLLAR || k2 == 5 || k2 == 25 {
            } else {
                scanning = false
            }
            j += 1
    }
    << result
}

fn (p &mut Parser) parse_primary() int {
    line := p.line()
    col := p.col()
    k := p.kind()
    if k == 2 { // Int
        v := p.ival()
        p.bump()
        mut n := ast.mknode(ast.NK_INT, line, col)
        n.ival = v
        << p.add(n)
    }
    if k == 66 { // Float — ival holds ieee bits
        v := p.ival()
        p.bump()
        mut n := ast.mknode(ast.NK_FLOAT, line, col)
        n.ival = v
        << p.add(n)
    }
    // Casts: int(x) / i32(x) / u32(x) / u8(x) / f64(x)
    if k == 16 && p.kind_at(1) == 19 {
        p.bump()
        p.expect(19, "(")
        inner := p.parse_expr()
        p.expect(20, ")")
        mut n := ast.mknode(ast.NK_CAST, line, col)
        n.ival = 1 // to int
        n.a = inner
        << p.add(n)
    }
    if k == 72 && p.kind_at(1) == 19 {
        p.bump()
        p.expect(19, "(")
        inner := p.parse_expr()
        p.expect(20, ")")
        mut n := ast.mknode(ast.NK_CAST, line, col)
        n.ival = 8 // to i32
        n.a = inner
        << p.add(n)
    }
    if k == 73 && p.kind_at(1) == 19 {
        p.bump()
        p.expect(19, "(")
        inner := p.parse_expr()
        p.expect(20, ")")
        mut n := ast.mknode(ast.NK_CAST, line, col)
        n.ival = 9 // to u32
        n.a = inner
        << p.add(n)
    }
    if k == 74 && p.kind_at(1) == 19 {
        p.bump()
        p.expect(19, "(")
        inner := p.parse_expr()
        p.expect(20, ")")
        mut n := ast.mknode(ast.NK_CAST, line, col)
        n.ival = 10 // to u8
        n.a = inner
        << p.add(n)
    }
    if k == 67 && p.kind_at(1) == 19 {
        p.bump()
        p.expect(19, "(")
        inner := p.parse_expr()
        p.expect(20, ")")
        mut n := ast.mknode(ast.NK_CAST, line, col)
        n.ival = 4 // to f64
        n.a = inner
        << p.add(n)
    }
    if k == 79 { // `temp` as an ordinary name in expression position
        p.bump()
        mut n := ast.mknode(ast.NK_IDENT, line, col)
        n.sval = "temp"
        << p.add(n)
    }
    if k == 91 { // `any` as an ordinary name in expression position
        p.bump()
        mut n := ast.mknode(ast.NK_IDENT, line, col)
        n.sval = "any"
        << p.add(n)
    }
    // map[K]V{} or map[K]V{cap: expr}
    if k == 89 {
        p.bump()
        p.expect(23, "[")
        key := p.parse_type()
        p.expect(24, "]")
        val := p.parse_type()
        p.expect(21, "{")
        p.skip_newlines()
        mut cap_expr := -1
        if p.kind() == 22 {
            p.bump()
        } else {
            fname := p.expect_ident()
            if fname != "cap" {
                p.fail("map literal must be empty `map[K]V{}` or `map[K]V{cap: N}`; assign entries with m[k] = v")
            }
            p.expect(48, ":")
            cap_expr = p.parse_expr()
            p.skip_newlines()
            p.expect(22, "}")
        }
        mut n := ast.mknode(ast.NK_MAP_INIT, line, col)
        n.a = key
        n.b = val
        n.c = cap_expr
        p.ensure_maps_import()
        << p.add(n)
    }
    // chan T{cap: expr} (M17)
    if k == 70 {
        p.bump() // chan
        elem := p.parse_type()
        p.expect(21, "{")
        p.skip_newlines()
        fname := p.expect_ident()
        if fname != "cap" {
            p.fail("channel init requires field 'cap'")
        }
        p.expect(48, ":")
        cap := p.parse_expr()
        p.skip_newlines()
        p.expect(22, "}")
        mut n := ast.mknode(ast.NK_CHAN_INIT, line, col)
        n.a = elem
        n.b = cap
        << p.add(n)
    }
    if k == 3 { // Str — M14: expand `$ident` / `\$` / `$$`; raw ival=1 skips.
        s := p.sval()
        is_raw := p.ival()
        p.bump()
        if is_raw == 1 {
            mut n := ast.mknode(ast.NK_STR, line, col)
            n.sval = s
            << p.add(n)
        }
        << p.expand_string_interp(s, line, col)
    }
    if k == 14 { // true
        p.bump()
        mut n := ast.mknode(ast.NK_BOOL, line, col)
        n.ival = 1
        << p.add(n)
    }
    if k == 15 { // false
        p.bump()
        << p.add(ast.mknode(ast.NK_BOOL, line, col))
    }
    if k == 69 && p.kind_at(1) == 51 { // xu.ast… (keyword as path root)
        mut n := ast.mknode(ast.NK_IDENT, line, col)
        n.sval = "xu"
        p.bump()
        << p.add(n)
    }
    if k == 1 { // Ident, maybe a struct literal
        // Parse a qualified literal directly so the dotted path does not
        // leave temporary field nodes behind in the AST pool.
        if p.qualified_struct_init_ahead() {
            mut qname := p.sval()
            p.bump()
            while p.kind() == 51 {
                p.bump()
                seg := p.expect_ident()
                qname = qname + "." + seg
            }
            p.expect(21, "{")
            mut fields := -1
            mut last := -1
            p.skip_newlines()
            if p.kind() != 22 {
                mut done := false
                while !done {
                        mut sf := ast.mknode(ast.NK_S_FIELD, p.line(), p.col())
                        sf.sval = p.expect_ident()
                        p.expect(48, ":")
                        sf.a = p.parse_expr()
                        idx := p.add(sf)
                        if fields < 0 { fields = idx } else { p.set_next(last, idx) }
                        last = idx
                        p.skip_newlines()
                        if p.kind() == 25 {
                            p.bump()
                            p.skip_newlines()
                        } else {
                            done = true
                        }
                }
            }
            p.expect(22, "}")
            mut qn := ast.mknode(ast.NK_STRUCT_INIT, line, col)
            qn.sval = qname
            qn.a = fields
            qn.b = -1
            << p.add(qn)
        }
        // Node created before the branch (M2b); a struct literal converts
        // it in place (same node count as the Rust AST).
        mut n := ast.mknode(ast.NK_IDENT, line, col)
        n.sval = p.sval()
        p.bump()
        if !p.no_struct_lit {
            mut ty_args := -1
            mut is_init := p.kind() == 21 // {
            if !is_init && p.kind() == 88 { // Name#...{ or Name#....Variant
                if p.generic_init_ahead() {
                    ty_args = p.parse_type_args()
                    is_init = true
                } else if p.generic_ctor_ahead() {
                    n.a = p.parse_type_args()
                }
            } else if !is_init && p.kind() == 33 { // legacy Name<...>{
                if p.legacy_generic_init_ahead() {
                    p.fail("`Name<...>` type args are removed; use Name#...")
                }
            }
            if is_init {
                p.bump() // {
                mut fields := -1
                mut last := -1
                p.skip_newlines()
                if p.kind() != 22 {
                    mut done := false
                    while !done {
                            mut sf := ast.mknode(ast.NK_S_FIELD, p.line(), p.col())
                            sf.sval = p.expect_ident()
                            p.expect(48, ":")
                            sf.a = p.parse_expr()
                            idx := p.add(sf)
                            if fields < 0 { fields = idx } else { p.set_next(last, idx) }
                            last = idx
                            p.skip_newlines()
                            if p.kind() == 25 { // ,
                                p.bump()
                                p.skip_newlines()
                            } else {
                                done = true
                            }
                    }
                }
                p.expect(22, "}")
                n.kind = 6
                n.a = fields
                n.b = ty_args
            }
        }
        << p.add(n)
    }
    if k == 23 { // [ — array literal, []T{}, or [N]T{…}
        p.bump()
        if p.kind() == 24 { // ] → []T{}
            p.bump()
            elem := p.parse_type()
            p.expect(21, "{")
            p.expect(22, "}")
            mut n := ast.mknode(ast.NK_EMPTY_ARRAY, line, col)
            n.a = elem
            << p.add(n)
        }
        // [N]T{ elems } — fixed-size composite (N = positive int literal).
        if p.kind() == 2 && p.kind_at(1) == 24 && p.is_type_start_at(2) {
            nlen := p.ival()
            if nlen <= 0 {
                p.fail("fixed array length must be positive, found " + str(nlen))
            }
            p.bump() // Int
            p.bump() // ]
            elem_ty := p.parse_type()
            p.expect(21, "{")
            p.skip_newlines()
            mut elems := -1
            mut last := -1
            if p.kind() != 22 {
                mut done := false
                while !done {
                    e := p.parse_expr()
                    if elems < 0 { elems = e } else { p.set_next(last, e) }
                    last = e
                    p.skip_newlines()
                    if p.kind() == 25 {
                        p.bump()
                        p.skip_newlines()
                    } else {
                        done = true
                    }
                }
            }
            p.expect(22, "}")
            mut n := ast.mknode(ast.NK_ARRAY_LIT, line, col)
            n.a = elems
            n.b = elem_ty
            n.ival = nlen
            << p.add(n)
        }
        mut elems := -1
        mut last := -1
        mut done := false
        while !done {
                e := p.parse_expr()
                if elems < 0 { elems = e } else { p.set_next(last, e) }
                last = e
                p.skip_newlines()
                if p.kind() == 25 { // ,
                    p.bump()
                    p.skip_newlines()
                } else {
                    done = true
                }
        }
        p.expect(24, "]")
        mut n := ast.mknode(ast.NK_ARRAY_LIT, line, col)
        n.a = elems
        << p.add(n)
    }
    if k == 19 { // ( expr )
        p.bump()
        p.skip_newlines()
        e := p.parse_expr()
        p.skip_newlines()
        p.expect(20, ")")
        << e
    }
    // M109: `fn(params) [Ret] { body }` function literal.
    if k == 4 { // tok_fn
        p.bump()
        p.expect(19, "(")
        mut params := -1
        mut last_p := -1
        p.skip_newlines()
        if p.kind() != 20 {
            mut done := false
            while !done {
                    mut pr := ast.mknode(ast.NK_PARAM, p.line(), p.col()) // nk_param
                    pr.sval = p.expect_ident()
                    pr.a = p.parse_type()
                    idx := p.add(pr)
                    if params < 0 { params = idx } else { p.set_next(last_p, idx) }
                    last_p = idx
                    p.skip_newlines()
                    if p.kind() == 25 {
                        p.bump()
                        p.skip_newlines()
                    } else {
                        done = true
                    }
            }
        }
        p.expect(20, ")")
        mut ret := -1
        // Optional return type. Starters must match parse_type, including `&T`.
        if p.is_type_start_at(0) || p.kind() == ast.TOK_DOLLAR {
            ret = p.parse_type()
        }
        body := p.parse_block()
        mut n := ast.mknode(ast.NT_FN_LIT, line, col) // nt_fn_lit
        n.a = params
        n.b = ret
        n.c = body
        << p.add(n)
    }
    p.fail("expected expression, found " + p.describe_here())
    << -1
}
