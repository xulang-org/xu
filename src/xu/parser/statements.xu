@xu/parser

#xu/ast

// ===== Statements =====

// `{ stmt ... }` — returns the statement chain head (-1 when empty).
fn (p &mut Parser) parse_block() int {
    p.expect(21, "{")
    mut head := -1
    mut last := -1
    mut done := false
    while !done {
            p.skip_newlines()
            k2 := p.kind()
            if k2 == 22 { // }
                p.bump()
                done = true
            } else if k2 == 54 {
                p.fail("unexpected end of file inside block")
            } else {
                s := p.parse_stmt()
                if head < 0 { head = s } else { p.set_next(last, s) }
                last = s
            }
    }
    << head
}

fn (p &mut Parser) parse_const() int {
    line := p.line()
    col := p.col()
    p.expect(58, "const")
    name := p.expect_ident()
    p.expect(45, "=")
    // M8: RHS must be an int / bool / string literal.
    k := p.kind()
    mut lit := -1
    if k == 2 { // Int (decimal or hex)
        mut n := ast.mknode(ast.NK_INT, p.line(), p.col())
        n.ival = p.ival()
        p.bump()
        lit = p.add(n)
    } else if k == 27 { // '-': negative int literal (bootstrap folds at parse)
        line2 := p.line()
        col2 := p.col()
        p.bump()
        if p.kind() != 2 {
            p.fail("const initializer must be an int, bool, or string literal, found " + p.describe_here())
        }
        mut n := ast.mknode(ast.NK_INT, line2, col2)
        n.ival = 0 - p.ival()
        p.bump()
        lit = p.add(n)
    } else if k == 14 || k == 15 { // true / false
        mut n := ast.mknode(ast.NK_BOOL, p.line(), p.col())
        if k == 14 { n.ival = 1 } else { n.ival = 0 }
        p.bump()
        lit = p.add(n)
    } else if k == 3 { // Str
        sl := p.line()
        sc := p.col()
        is_raw := p.ival()
        raw := p.sval()
        p.bump()
        mut n := ast.mknode(ast.NK_STR, sl, sc)
        if is_raw == 1 {
            n.sval = raw
        } else {
            n.sval = p.cook_string_escapes(raw, sl, sc)
        }
        lit = p.add(n)
    } else {
        p.fail("const initializer must be an int, bool, or string literal, found " + p.describe_here())
    }
    mut n := ast.mknode(ast.NK_CONST, line, col)
    n.sval = name
    n.a = lit
    << p.add(n)
}

fn (p &mut Parser) parse_stmt() int {
    k := p.kind()
    // Spec34 H38: the left side marks the binding, never a borrow.
    if k == 39 && p.kind_at(1) == 1 && p.kind_at(2) == 47 {
        p.fail("a borrow is not a mutable binding declaration\nhelp: use 'mut x :=' today; the planned form is '\$x :='")
    }
    if k == 39 && p.kind_at(1) == ast.TOK_DOLLAR && p.kind_at(2) == 1 && p.kind_at(3) == 47 {
        p.fail("invalid mutable binding spelling '&\$name :='; use '\$name :=' (currently 'mut name :=')")
    }
    if k == ast.TOK_DOLLAR && p.kind_at(1) == 39 && p.kind_at(2) == 1 && p.kind_at(3) == 47 {
        p.fail("'\$&x' is a writable borrow, not a mutable binding; use '\$x :=' (currently 'mut x :=')")
    }
    if k == ast.TOK_DOLLAR && p.kind_at(1) == 1 && p.kind_at(2) == 47 {
        p.fail("mutable binding spelling '\$name :=' is not supported yet; use 'mut name :='")
    }
    if k == 80 { // let
        line := p.line()
        col := p.col()
        p.bump()
        if p.kind() == 90 {
            p.fail("mutable typed binding spelling 'let \$x: T' is not yet supported\nhelp: use 'mut x := value' with an inferred type today")
        }
        mut n := ast.mknode(ast.NK_LET, line, col)
        n.sval = p.expect_ident()
        p.expect(48, ":")
        n.b = p.parse_type()
        p.expect(45, "=")
        n.a = p.parse_expr()
        << p.add(n)
    }
    if k == 5 { // mut
        line := p.line()
        col := p.col()
        p.bump()
        mut n := ast.mknode(ast.NK_LET, line, col)
        n.ival = 1
        n.sval = p.expect_ident()
        p.expect(47, ":=")
        n.a = p.parse_expr()
        << p.add(n)
    }
    if k == 1 && p.kind_at(1) == 47 { // x :=
        line := p.line()
        col := p.col()
        name := p.sval()
        p.bump()
        p.bump() // ':='
        mut n := ast.mknode(ast.NK_LET, line, col)
        n.sval = name
        n.a = p.parse_expr()
        << p.add(n)
    }
    if k == 1 {
        p.fail_removed_ident()
    }
    if k == 86 { // <<<
        line := p.line()
        col := p.col()
        p.bump()
        mut n := ast.mknode(ast.NK_EXIT, line, col)
        n.a = p.parse_expr()
        << p.add(n)
    }
    if k == 42 { // << << (statement)
        line := p.line()
        col := p.col()
        p.bump()
        mut n := ast.mknode(ast.NK_RETURN, line, col)
        k2 := p.kind()
        if k2 != 53 && k2 != 22 && k2 != 54 {
            n.a = p.parse_expr()
        }
        << p.add(n)
    }
    if k == 43 { // >> throw (statement)
        line := p.line()
        col := p.col()
        p.bump()
        mut n := ast.mknode(ast.NK_THROW, line, col)
        n.a = p.parse_expr()
        << p.add(n)
    }
    if k == 7 { << p.parse_if() }
    if k == 9 { << p.parse_for() }
    if k == 55 { << p.parse_while() }
    if k == 83 { // -> ->
        line := p.line()
        col := p.col()
        p.bump()
        << p.add(ast.mknode(ast.NK_CONTINUE, line, col))
    }
    if k == 71 && (p.kind_at(1) == 53 || p.kind_at(1) == 22 || p.kind_at(1) == 54) {
        // Bare `<-` = <-; `<- expr` falls through to parse_expr as recv.
        line := p.line()
        col := p.col()
        p.bump()
        << p.add(ast.mknode(ast.NK_BREAK, line, col))
    }
    if k == 12 { << p.parse_match() }
    if k == 69 && p.kind_at(1) != 51 { // xu f(args) (M17); `xu.pkg` is a path
        line := p.line()
        col := p.col()
        p.bump()
        call := p.parse_expr()
        if p.nodes[call].kind != ast.NK_CALL {
            p.fail_at2(line, col, "xu requires a function call (xu f(args))")
        }
        mut n := ast.mknode(ast.NK_XU, line, col)
        n.a = call
        << p.add(n)
    }
    if k == 75 { // select { ... } (M17d)
        << p.parse_select()
    }
    expr := p.parse_expr()
    k2 := p.kind()
    // = / += / -= / *= / /= / %=
    if k2 == 45 || k2 == 46 || k2 == 59 || k2 == 60 || k2 == 61 || k2 == 62 {
        tk := p.nodes[expr].kind
        if tk != ast.NK_IDENT && tk != ast.NK_FIELD && tk != ast.NK_INDEX && !(tk == ast.NK_UN_OP && p.nodes[expr].ival == 3) {
            p.fail("invalid assignment target (must be a variable, field, or index)")
        }
        line := p.nodes[expr].line
        col := p.nodes[expr].col
        mut n := ast.mknode(ast.NK_ASSIGN, line, col)
        if k2 == 45 { n.ival = 1 }       // =
        else if k2 == 46 { n.ival = 2 }  // +=
        else if k2 == 59 { n.ival = 3 }  // -=
        else if k2 == 60 { n.ival = 4 }  // *=
        else if k2 == 61 { n.ival = 5 }  // /=
        else { n.ival = 6 }              // %=
        p.bump()
        n.a = expr
        n.b = p.parse_expr()
        << p.add(n)
    }
    if k2 == 71 { // ch <- value (M17)
        line := p.nodes[expr].line
        col := p.nodes[expr].col
        p.bump()
        mut n := ast.mknode(ast.NK_SEND, line, col)
        n.a = expr
        n.b = p.parse_expr()
        << p.add(n)
    }
    mut n := ast.mknode(ast.NK_EXPR_STMT, p.nodes[expr].line, p.nodes[expr].col)
    n.a = expr
    << p.add(n)
}

fn (p &mut Parser) parse_while() int {
    line := p.line()
    col := p.col()
    p.expect(55, "while")
    cond := p.parse_condition()
    body := p.parse_block()
    mut n := ast.mknode(ast.NK_WHILE, line, col)
    n.a = cond
    n.c = body
    << p.add(n)
}

fn (p &mut Parser) parse_select() int {
    line := p.line()
    col := p.col()
    p.expect(75, "select")
    p.expect(21, "{")
    mut arms := -1
    mut last := -1
    mut else_body := -1
    mut has_else := 0
    mut done := false
    while !done {
            p.skip_newlines()
            k2 := p.kind()
            if k2 == 22 {
                p.bump()
                done = true
            } else if k2 == 54 {
                p.fail("unexpected end of file inside select")
            } else if k2 == 8 { // else
                if else_body >= 0 {
                    p.fail("select has multiple else clauses")
                }
                if arms < 0 {
                    p.fail("select requires at least one send/recv case")
                }
                p.bump()
                else_body = p.parse_block()
                has_else = 1
                p.skip_newlines()
                if p.kind() != 22 {
                    p.fail("else must be the last clause in select")
                }
            } else if k2 == 1 && p.kind_at(1) == 47 && p.kind_at(2) == 71 {
                aline := p.line()
                acol := p.col()
                name := p.expect_ident()
                p.expect(47, ":=")
                p.expect(71, "<-")
                p.skip_newlines()
                chn := p.parse_condition()
                body := p.parse_block()
                mut ar := ast.mknode(ast.NK_SEL_RECV, aline, acol)
                ar.sval = name
                ar.a = chn
                ar.c = body
                idx := p.add(ar)
                if arms < 0 { arms = idx } else { p.set_next(last, idx) }
                last = idx
            } else {
                chn := p.parse_expr()
                aline := p.nodes[chn].line
                acol := p.nodes[chn].col
                p.expect(71, "<-")
                value := p.parse_condition()
                body := p.parse_block()
                mut ar := ast.mknode(ast.NK_SEL_SEND, aline, acol)
                ar.a = chn
                ar.b = value
                ar.c = body
                idx := p.add(ar)
                if arms < 0 { arms = idx } else { p.set_next(last, idx) }
                last = idx
            }
    }
    if arms < 0 {
        p.fail_at2(line, col, "select requires at least one send/recv case")
    }
    mut n := ast.mknode(ast.NK_SELECT, line, col)
    n.a = arms
    n.c = else_body
    n.ival = has_else
    << p.add(n)
}

fn (p &mut Parser) parse_if() int {
    line := p.line()
    col := p.col()
    p.expect(7, "if")
    cond := p.parse_condition()
    body := p.parse_block()
    mut br := ast.mknode(ast.NK_BRANCH, line, col)
    br.a = cond
    br.b = body
    head := p.add(br)
    mut last := head
    mut done := false
    while !done {
            saved := p.pos
            p.skip_newlines()
            if p.kind() == 8 { // else
                p.bump()
                if p.kind() == 7 { // else if
                    bline := p.line()
                    bcol := p.col()
                    p.bump()
                    c := p.parse_condition()
                    b := p.parse_block()
                    mut nb := ast.mknode(ast.NK_BRANCH, bline, bcol)
                    nb.a = c
                    nb.b = b
                    idx := p.add(nb)
                    p.set_next(last, idx)
                    last = idx
                } else {
                    b := p.parse_block()
                    mut nb := ast.mknode(ast.NK_BRANCH, line, col)
                    nb.b = b // a = -1: trailing else
                    idx := p.add(nb)
                    p.set_next(last, idx)
                    last = idx
                    done = true
                }
            } else {
                p.pos = saved // the newlines belong to the next statement
                done = true
            }
    }
    mut n := ast.mknode(ast.NK_IF, line, col)
    n.a = head
    << p.add(n)
}

// Parse an if/for condition: struct literals are suppressed so that the
// block's `{` is not swallowed by `Name{...}`.
fn (p &mut Parser) parse_condition() int {
    saved := p.no_struct_lit
    p.no_struct_lit = true
    expr := p.parse_expr()
    p.no_struct_lit = saved
    << expr
}

fn (p &mut Parser) parse_for() int {
    line := p.line()
    col := p.col()
    p.expect(9, "for")
    if p.kind() == 21 { // { — `for { }` infinite loop, lowered as while true
        mut t := ast.mknode(ast.NK_BOOL, line, col) // Bool(true)
        t.ival = 1
        mut n := ast.mknode(ast.NK_WHILE, line, col) // While
        n.a = p.add(t)
        n.c = p.parse_block()
        << p.add(n)
    }
    var := p.expect_ident()
    mut var2 := ""
    if p.kind() == 25 { // comma: `for k, v in m`
        p.bump()
        var2 = p.expect_ident()
    }
    p.expect(10, "in")
    first := p.parse_condition()
    // `var` moves into the node outside the branch: moving an outer local
    // inside a conditional scope is rejected (M2b).
    mut n := ast.mknode(ast.NK_FOR_EACH, line, col) // ForEach
    n.sval = var
    n.sval2 = var2
    n.a = first
    if p.kind() == 49 { // ..
        p.fail("`..` in for-in is removed; use `start:end`")
    }
    if p.kind() == ast.TOK_RIGHT_ARROW {
        p.fail("`->` in for-in is removed; use `start:end`")
    }
    if ast.tok_is_range(p.kind()) {
        if n.sval2.len > 0 {
            p.fail("for-range takes one variable")
        }
        n.ival = ast.tok_range_ival(p.kind())
        p.bump()
        n.kind = 26 // For
        n.b = p.parse_condition()
    }
    n.c = p.parse_block()
    << p.add(n)
}

fn (p &mut Parser) parse_match() int {
    line := p.line()
    col := p.col()
    p.expect(12, "match")
    subject := p.parse_condition()
    p.expect(21, "{")
    mut arms := -1
    mut last := -1
    mut done := false
    while !done {
            p.skip_newlines()
            k2 := p.kind()
            if k2 == 22 { // }
                p.bump()
                done = true
            } else if k2 == 54 {
                p.fail("unexpected end of file inside match")
            } else {
                arm := p.parse_match_arm()
                if arms < 0 { arms = arm } else { p.set_next(last, arm) }
                last = arm
            }
    }
    mut n := ast.mknode(ast.NK_MATCH, line, col)
    n.a = subject
    n.b = arms
    << p.add(n)
}

fn (p &mut Parser) parse_match_arm() int {
    line := p.line()
    col := p.col()
    if p.kind() == 8 { // else
        p.bump()
        mut n := ast.mknode(ast.NK_ARM_ELSE, line, col)
        n.c = p.parse_block()
        << p.add(n)
    }
    // Ident: Enum.Variant (M15).
    if p.kind() == 1 {
        w := p.sval()
        if w == "Ok" || w == "Err" {
            p.fail("`Result<T, E>` is removed; use `>>` and `or (err) { }` for errors")
        }
        mut name := p.expect_ident()
        p.expect(51, ".")
        mut vname := p.expect_ident()
        while p.kind() == 51 {
            name = name + "." + vname
            p.bump()
            vname = p.expect_ident()
        }
        mut bindings := -1
        mut blast := -1
        if p.kind() == 19 { // (
            p.bump()
            p.skip_newlines()
            if p.kind() != 20 {
                mut more := true
                while more {
                        mut b := ast.mknode(ast.NK_IDENT, p.line(), p.col()) // Ident
                        b.sval = p.expect_ident()
                        bi := p.add(b)
                        if bindings < 0 { bindings = bi } else { p.set_next(blast, bi) }
                        blast = bi
                        p.skip_newlines()
                        if p.kind() == 25 {
                            p.bump()
                            p.skip_newlines()
                        } else {
                            more = false
                        }
                }
            }
            p.expect(20, ")")
        }
        mut n := ast.mknode(ast.NK_ARM_ENUM, line, col)
        n.sval = name + "." + vname
        n.a = bindings
        n.c = p.parse_block()
        << p.add(n)
    }
    // MS9c: string literal pattern (`"red" { ... }`).
    if p.kind() == 3 {
        s := p.sval()
        p.bump()
        mut n := ast.mknode(ast.NK_ARM_STR, line, col)
        n.sval = s
        n.c = p.parse_block()
        << p.add(n)
    }
    lo := p.parse_pattern_int()
    if p.kind() == 50 { // ...
        p.fail("`...` in match is removed; use `start:end`")
    }
    if ast.tok_is_range(p.kind()) {
        rk := ast.tok_range_ival(p.kind())
        p.bump()
        hi := p.parse_pattern_int()
        mut n := ast.mknode(ast.NK_ARM_RANGE, line, col)
        n.ival = lo
        n.d = hi
        n.sval2 = ast.range_op_str(rk)
        n.c = p.parse_block()
        << p.add(n)
    }
    mut n := ast.mknode(ast.NK_ARM_INT, line, col)
    n.ival = lo
    n.c = p.parse_block()
    << p.add(n)
}

// a (possibly negative) integer literal in a match pattern.
fn (p &mut Parser) parse_pattern_int() int {
    mut neg := false
    if p.kind() == 27 { // -
        p.bump()
        neg = true
    }
    if p.kind() == 2 { // Int
        v := p.ival()
        p.bump()
        if neg {
            << -v
        }
        << v
    }
    p.fail("expected integer literal or 'else' in match pattern, found " + p.describe_here())
    << 0
}
