@xu/checker

#xu/ast
#xu/parser
#xu/typeenv
#xu/types

fn (c &Checker) find_const(name string) int {
    // Unqualified: current module only (set during body check / register).
    << c.find_const_in_mod(name, c.env.cur_mod)
}

fn (c $&Checker) register_const(p &parser.Parser, d int) {
    // Read sval2 per use: string params / locals are by-value (move).
    c.env.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, c.decl_file_id(p, d))
    if c.find_const_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate const '" + p.nodes[d].sval + "'")
    }
    is_pub := p.nodes[d].ival == 1
    lit := p.nodes[d].a
    lk := p.nodes[lit].kind
    if lk == ast.NK_INT { // Int
        c.env.cnames.push(p.nodes[d].sval)
        c.env.ctypes.push(1)
        c.env.civals.push(p.nodes[lit].ival)
        c.env.cstr_idx.push(-1)
        c.env.cmods.push(p.nodes[d].sval2)
        c.env.cpubs.push(types.b2i(is_pub))
        ck := typeenv.map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ci := c.env.cnames.len - 1
        strmap_put($&c.const_map, ck, ci)
        c.set_ntype(lit, 1)
        <<
    }
    if lk == ast.NK_BOOL { // Bool
        c.env.cnames.push(p.nodes[d].sval)
        c.env.ctypes.push(2)
        c.env.civals.push(p.nodes[lit].ival)
        c.env.cstr_idx.push(-1)
        c.env.cmods.push(p.nodes[d].sval2)
        c.env.cpubs.push(types.b2i(is_pub))
        ck := typeenv.map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ci := c.env.cnames.len - 1
        strmap_put($&c.const_map, ck, ci)
        c.set_ntype(lit, 2)
        <<
    }
    if lk == ast.NK_STR { // Str
        idx := c.intern(p.nodes[lit].sval)
        c.env.cnames.push(p.nodes[d].sval)
        c.env.ctypes.push(3)
        c.env.civals.push(0)
        c.env.cstr_idx.push(idx)
        c.env.cmods.push(p.nodes[d].sval2)
        c.env.cpubs.push(types.b2i(is_pub))
        ck := typeenv.map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ci := c.env.cnames.len - 1
        strmap_put($&c.const_map, ck, ci)
        c.set_nstr(lit, idx)
        c.set_ntype(lit, 3)
        <<
    }
    c.fail_node(p, d, "const initializer must be an int, bool, or string literal")
}

fn (c $&Checker) find_enum_in_mod(name string, mod_id string) int {
    for i in 0:c.env.enums.len {
        if c.env.enums[i].name == name && c.env.enums[i].mod_id == mod_id {
            << i
        }
    }
    << -1
}

fn (c $&Checker) register_enum(p &parser.Parser, d int) {
    c.env.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, c.decl_file_id(p, d))
    if c.find_enum_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate enum definition '" + p.nodes[d].sval + "'")
    }
    if c.find_etpl(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate enum definition '" + p.nodes[d].sval + "'")
    }
    if c.find_struct_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "type '" + p.nodes[d].sval + "' is already defined")
    }
    if c.find_stpl(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "type '" + p.nodes[d].sval + "' is already defined")
    }
    if p.nodes[d].e >= 0 {
        c.etpl_name.push(p.nodes[d].sval)
        c.etpl_mod.push(p.nodes[d].sval2)
        c.etpl_decl.push(d)
        c.etpl_pub.push(types.b2i(p.nodes[d].ival == 1))
        ek := typeenv.map_key(p.nodes[d].sval2, p.nodes[d].sval)
        ei := c.etpl_name.len - 1
        strmap_put($&c.etpl_map, ek, ei)
        <<
    }
    $en := typeenv.CEnum{
        name: p.nodes[d].sval,
        variants: []typeenv.CEnumVariant{},
        nslots: 1,
        owns: false,
        mod_id: p.nodes[d].sval2,
        is_pub: p.nodes[d].ival == 1,
        origin: "",
        args: []int{}
    }
    $max_payload := 0
    $v := p.nodes[d].a
    while v >= 0 {
    if p.nodes[v].kind != ast.NK_VARIANT_DECL {
        c.fail_node(p, v, "malformed enum variant")
    }
    // Duplicate variant name?
    for i in 0:en.variants.len {
        if en.variants[i].name == p.nodes[v].sval {
            c.fail_node(p, v, "variant '" + p.nodes[v].sval + "' is defined more than once")
        }
    }
    $fields := []int{}
    $field_slots := 0
    $ft := p.nodes[v].a
    while ft >= 0 {
        fty := c.type_of(p, ft)
        if types.is_ref_type(fty) {
            c.fail_node(p, ft, "enum payload cannot contain references without lifetime tracking")
        }
        slots := c.type_slots(fty)
        // Enum payloads are materialized as a tag plus the largest variant.
        // Reject a malformed/oversized field before the running sum can wrap;
        // zero-sized temporary/empty structs remain legal and preserve the
        // existing checker ordering.
        if slots < 0 || slots > types.MIR_MAX_LAYOUT_WORDS || field_slots > types.MIR_MAX_LAYOUT_WORDS - slots {
            c.fail_node(p, ft, "enum payload exceeds layout limit")
            <<
        }
        fields.push(fty)
        field_slots += slots
        if c.type_owning(fty) {
            en.owns = true
        }
        ft = p.nodes[ft].next
    }
    if field_slots >= types.MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, v, "enum payload exceeds layout limit")
        <<
    }
    if field_slots > max_payload {
        max_payload = field_slots
    }
    en.variants.push(typeenv.CEnumVariant{
        name: p.nodes[v].sval,
        fields: fields,
        field_slots: field_slots
    })
    v = p.nodes[v].next
    }
    if max_payload >= types.MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, d, "enum payload exceeds layout limit")
        <<
    }
    en.nslots = 1 + max_payload
    if c.env.enums.len >= types.TYPE_TABLE_LIMIT {
        c.fail_node(p, d, "too many enum types")
        <<
    }
    c.env.enums.push(en)
}

fn (c $&Checker) register_struct_name(p &parser.Parser, d int) {
    c.env.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, c.decl_file_id(p, d))
    // We can't bind `name` to a local here and pass it to find_struct: in
    // s3a, `string` parameters are by-value (move), so the local would be
    // consumed. Inline the duplicate check by reading the sval field twice.
    if c.find_struct_in_mod(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate struct definition '" + p.nodes[d].sval + "'")
    }
    if c.find_stpl(p.nodes[d].sval, p.nodes[d].sval2) >= 0 {
        c.fail_node(p, d, "duplicate struct definition '" + p.nodes[d].sval + "'")
    }
    resource_label := c.resource_decl_drop_label(p, d)
    // Generic struct template: store decl; fields laid out on instantiation.
    if p.nodes[d].e >= 0 {
        c.stpl_name.push(p.nodes[d].sval)
        c.stpl_mod.push(p.nodes[d].sval2)
        c.stpl_decl.push(d)
        c.stpl_pub.push(types.b2i(p.nodes[d].ival == 1))
        sk := typeenv.map_key(p.nodes[d].sval2, p.nodes[d].sval)
        si := c.stpl_name.len - 1
        strmap_put($&c.stpl_map, sk, si)
        <<
    }
    if c.type_table_full(c.env.structs.len, types.TYPE_TABLE_LIMIT, "struct", 5) { << }
    c.env.structs.push(typeenv.CStruct{
        name: p.nodes[d].sval,
        fields: []typeenv.CField{},
        nslots: 0,
        size_bytes: 0,
        align_bytes: 1,
        mod_id: p.nodes[d].sval2,
        is_pub: p.nodes[d].ival == 1,
        is_union: false,
        origin: "",
        drop_label: resource_label
    })
    c.note_st_index()
    c.env.sargs.push([]int{})
    c.env.sdecl.push(d)
    c.env.slaid.push(0)
    c.env.sdoing.push(0)
}

fn (c $&Checker) layout_struct(p &parser.Parser, d int) {
    if p.nodes[d].e >= 0 {
        <<
    }
    si := c.find_struct_in_mod(p.nodes[d].sval, p.nodes[d].sval2)
    if si < 0 {
        c.fail_node(p, d, "internal: struct '" + p.nodes[d].sval + "' was not registered")
        <<
    }
    c.layout_struct_at(p, si)
}

// Lay out struct `si` (recursively laying out any struct-typed fields first,
// mirroring bootstrap xuhir layout_one/slots_of). Structs may reference each
// other across modules in any declaration order; the layout of a field struct
// is computed on demand so imported structs (merged after the CLI module) are
// sized before the wrapping struct.
fn (c $&Checker) layout_struct_at(p &parser.Parser, si int) {
    if c.env.slaid[si] != 0 {
        <<
    }
    if c.env.sdoing[si] != 0 {
        <<
    }
    d := c.env.sdecl[si]
    c.set_sdoing(si, 1)
    saved_mod := c.env.cur_mod
    saved_file := c.env.cur_file
    saved_fname := c.env.cur_file_name
    c.env.cur_mod = p.nodes[d].sval2
    c.set_cur_file(p, c.decl_file_id(p, d))
    $fields := []typeenv.CField{}
    $off := 0
    $mal := 1
    $bit_pos := 0
    $win_bf_sz := 0
    $win_bf_off := 0
    $win_bf_used := 0
    rflags := types.ffi_decl_flags(p, d)
    repr_c := rflags >= 0 && (rflags & ast.FFI_STRUCT) != 0
    is_union := rflags >= 0 && (rflags & ast.FFI_UNION) != 0
    is_packed := rflags >= 0 && (rflags & ast.FFI_PACKED) != 0
    custom_align := types.ffi_decl_align(p, d)
    if custom_align > mal { mal = custom_align }
    $f := p.nodes[d].a
    while f >= 0 {
    if p.nodes[f].kind != ast.NK_FIELD_DECL {
        c.fail_node(p, f, "malformed struct field")
    }
    fty := c.type_of(p, p.nodes[f].a)
    c.slots_of(p, fty, f)
    // M10: reference fields allowed for local use; escape checked at <<.
    // M165: capture `&a` lifetime from the field type node.
    $life := ""
    tn := p.nodes[f].a
    if tn >= 0 && p.nodes[tn].kind == ast.NT_REF {
        life = p.nodes[tn].sval
    }
    $al := c.type_align_bytes(fty)
    if repr_c { al = c.c_align_bytes(fty) }
    if is_packed { al = 1 }
    if al < 1 || al > types.MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct field alignment exceeds layout limit")
        c.set_sdoing(si, 0)
        c.env.cur_mod = saved_mod
        c.env.cur_file = saved_file
        c.env.cur_file_name = saved_fname
        <<
    }
    sz := c.type_size_bytes(fty)
    if sz < 0 || sz > types.MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        c.set_sdoing(si, 0)
        c.env.cur_mod = saved_mod
        c.env.cur_file = saved_file
        c.env.cur_file_name = saved_fname
        <<
    }
    bw := p.nodes[f].ival / 2
    f_pub := (p.nodes[f].ival & 1) == 1
    if bw > 0 {
        if !repr_c {
            c.fail_node(p, f, "@bits is only allowed on fields of @repr(\"C\") structs or unions")
        }
        if !types.is_integer_type(fty) {
            c.fail_node(p, f, "@bits field '" + p.nodes[f].sval + "' must have an integer type")
        } else {
            tb := sz * 8
            if tb <= 0 {
                c.fail_node(p, f, "@bits(" + str(bw) + ") exceeds width of field type (" + str(tb) + " bits)")
                f = p.nodes[f].next
                ->
            }
            if bw > tb {
                c.fail_node(p, f, "@bits(" + str(bw) + ") exceeds width of field type (" + str(tb) + " bits)")
            } else {
                if !is_packed && al > mal { mal = al }
                if is_union {
                    fields.push(typeenv.CField{name: p.nodes[f].sval, ty: fty, slot: 0, life: life, is_pub: f_pub, bit_off: 0, bit_width: bw, bit_unit: sz})
                    if sz > off { off = sz }
                } else if c.env.target_os == 2 {
                    if win_bf_sz != sz || win_bf_used + bw > tb {
                        aligned := types.align_up_bytes(off, al)
                        if aligned < off || aligned > types.MIR_MAX_LAYOUT_BYTES - sz {
                            c.fail_node(p, f, "struct layout exceeds byte limit")
                            c.set_sdoing(si, 0)
                            c.env.cur_mod = saved_mod
                            c.env.cur_file = saved_file
                            c.env.cur_file_name = saved_fname
                            <<
                        }
                        win_bf_off = aligned
                        win_bf_sz = sz
                        win_bf_used = 0
                        off = aligned + sz
                    }
                    fields.push(typeenv.CField{name: p.nodes[f].sval, ty: fty, slot: win_bf_off, life: life, is_pub: f_pub, bit_off: win_bf_used, bit_width: bw, bit_unit: sz})
                    win_bf_used += bw
                } else {
                    if bit_pos / tb != (bit_pos + bw - 1) / tb {
                        bit_pos = (bit_pos / tb + 1) * tb
                    }
                    unit_off := (bit_pos / tb) * sz
                    boff := bit_pos % tb
                    if unit_off > types.MIR_MAX_LAYOUT_BYTES - sz {
                        c.fail_node(p, f, "struct layout exceeds byte limit")
                        c.set_sdoing(si, 0)
                        c.env.cur_mod = saved_mod
                        c.env.cur_file = saved_file
                        c.env.cur_file_name = saved_fname
                        <<
                    }
                    fields.push(typeenv.CField{name: p.nodes[f].sval, ty: fty, slot: unit_off, life: life, is_pub: f_pub, bit_off: boff, bit_width: bw, bit_unit: sz})
                    bit_pos += bw
                    off = (bit_pos + 7) / 8
                }
            }
        }
        f = p.nodes[f].next
        ->
    }
    win_bf_sz = 0
    if is_union {
        if !is_packed && al > mal { mal = al }
        fields.push(typeenv.CField{name: p.nodes[f].sval, ty: fty, slot: 0, life: life, is_pub: f_pub, bit_off: 0, bit_width: 0, bit_unit: 0})
        if sz > off { off = sz }
        f = p.nodes[f].next
        ->
    }
    aligned := types.align_up_bytes(off, al)
    if aligned < off || aligned > types.MIR_MAX_LAYOUT_BYTES || aligned > types.MIR_MAX_LAYOUT_BYTES - sz {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        c.set_sdoing(si, 0)
        c.env.cur_mod = saved_mod
        c.env.cur_file = saved_file
        c.env.cur_file_name = saved_fname
        <<
    }
    if !is_packed && al > mal { mal = al }
    fields.push(typeenv.CField{name: p.nodes[f].sval, ty: fty, slot: aligned, life: life, is_pub: f_pub, bit_off: 0, bit_width: 0, bit_unit: 0})
    off = aligned + sz
    bit_pos = off * 8
    f = p.nodes[f].next
    }
    aligned := types.align_up_bytes(off, mal)
    if aligned < off || aligned > types.MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, d, "struct layout exceeds byte limit")
        c.set_sdoing(si, 0)
        c.env.cur_mod = saved_mod
        c.env.cur_file = saved_file
        c.env.cur_file_name = saved_fname
        <<
    }
    off = aligned
    $nslots := off / 8
    if off % 8 != 0 { nslots += 1 }
    if nslots > types.MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, d, "struct layout exceeds slot limit")
        c.set_sdoing(si, 0)
        c.env.cur_mod = saved_mod
        c.env.cur_file = saved_file
        c.env.cur_file_name = saved_fname
        <<
    }
    // Whole-element replace: field assign through `c.structs[si].fields` is
    // not a local root (HIR/xumir).
    c.env.structs[si] = typeenv.CStruct{
        name: p.nodes[d].sval,
        fields: fields,
        nslots: nslots,
        size_bytes: off,
        align_bytes: mal,
        mod_id: p.nodes[d].sval2,
        is_pub: p.nodes[d].ival == 1,
        is_union: is_union,
        origin: "",
        drop_label: ~c.env.structs[si].drop_label
    }
    c.set_sdoing(si, 0)
    c.set_slaid(si, 1)
    c.env.cur_mod = saved_mod
    c.env.cur_file = saved_file
    c.env.cur_file_name = saved_fname
}

// Slot count for a field type, laying out struct-typed fields on demand.
fn (c $&Checker) slots_of(p &parser.Parser, ty int, n int) int {
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < c.env.structs.len && c.env.sdecl[si] >= 0 {
            if c.env.sdoing[si] != 0 {
                c.fail_node(p, n, "struct has infinite size (recursive layout)")
                << 1
            }
            c.layout_struct_at(p, si)
        }
    }
    << c.type_slots(ty)
}

fn (c $&Checker) register_interface_name(p &parser.Parser, d int) {
    dname := ~p.nodes[d].sval
    dmod := ~p.nodes[d].sval2
    c.env.cur_mod = ~dmod
    c.set_cur_file(p, c.decl_file_id(p, d))
    if c.find_iface(~dname, ~dmod) >= 0 {
        c.fail_node(p, d, "struct@ '" + dname + "' is defined more than once")
    }
    ii := c.env.iface_names.len
    if ii >= types.TYPE_TABLE_LIMIT {
        c.fail_node(p, d, "too many struct@ interface types")
        <<
    }
    c.env.iface_names.push(~dname)
    c.env.iface_mods.push(~dmod)
    strmap_put($&c.iface_map, typeenv.map_key(~dmod, ~dname), ii)
    iname := ~dname
    prev := strmap_get(&c.iface_glob_map, &iname)
    if prev < 0 {
        strmap_put($&c.iface_glob_map, iname, ii)
    } else if prev != -2 {
        strmap_put($&c.iface_glob_map, iname, -2)
    }
}

// Resolve signatures only after the concrete enum payloads are registered.
// Interfaces must already have names so enum payloads may box an interface.
fn (c $&Checker) resolve_interface_methods(p &parser.Parser, d int) {
    c.env.cur_mod = ~p.nodes[d].sval2
    c.set_cur_file(p, c.decl_file_id(p, d))
    ii := c.find_iface(~p.nodes[d].sval, ~p.nodes[d].sval2)
    if ii < 0 { c.fail_node(p, d, "internal: unregistered struct@")
        << }
    $m := p.nodes[d].a
    while m >= 0 {
        if p.nodes[m].kind != ast.NK_METHOD_SIG {
            c.fail_node(p, m, "malformed struct@ method")
        }
        c.env.im_ii.push(ii)
        mname := ~p.nodes[m].sval
        c.env.im_name.push(~mname)
        poff := c.env.im_ptys.len
        $plen := 0
        $pt := p.nodes[m].a
        while pt >= 0 {
            pty := c.type_of(p, pt)
            c.env.im_ptys.push(pty)
            plen += 1
            pt = p.nodes[pt].next
        }
        c.env.im_poff.push(poff)
        c.env.im_plen.push(plen)
        $ret := 0
        if p.nodes[m].b >= 0 {
            ret = c.type_of(p, p.nodes[m].b)
        }
        c.env.im_ret.push(ret)
        m = p.nodes[m].next
    }
}

// Resolve a linked type-node list into c.targs; returns its length.
// Collected locally first: type_of on a nested generic re-enters here and
// would otherwise clobber the outer list.
fn (c $&Checker) collect_type_list_n(p &parser.Parser, head int) int {
    $list := []int{}
    $a := head
    while a >= 0 {
        list.push(c.type_of(p, a))
        a = p.nodes[a].next
    }
    n := list.len
    c.targs = list
    c.targs_n = n
    << n
}

// Replace c.targs with the first n entries of src.
fn (c $&Checker) load_targs(src &[]int, n int) {
    $list := []int{}
    for i in 0:n {
        if i < src.len {
            list.push(src[i])
        } else {
            list.push(0)
        }
    }
    c.targs = list
    c.targs_n = n
}

// c.targs = c.uni_bind[0..n) (call-site inference result).
fn (c $&Checker) load_targs_uni(n int) {
    $list := []int{}
    for i in 0:n {
        $v := 0
        if i < c.uni_bind.len { v = c.uni_bind[i] }
        list.push(v)
    }
    c.targs = list
    c.targs_n = n
}

// c.targs = c.sargs[si] (generic struct instance args).
fn (c $&Checker) load_targs_sargs(si int) {
    $list := []int{}
    for i in 0:c.env.sargs[si].len {
        v := c.env.sargs[si][i]
        list.push(v)
    }
    c.targs_n = list.len
    c.targs = list
}

// Copy of c.targs (instantiators snapshot before nested instantiation).
fn (c &Checker) targs_copy() []int {
    $args := []int{}
    for i in 0:c.targs.len {
        args.push(c.targs[i])
    }
    << args
}

// Instantiate generic struct from type args already in c.targs.
// `at` is a TNamed/StructInit node whose sval is the template name; module is c.cur_mod.
// Saves/restores the caller's type-param subst (method registration may have one).
fn (c $&Checker) instantiate_struct(p &parser.Parser, at int) int {
    args := c.targs_copy()
    // Snapshot caller subst (parallel arrays; re-push after).
    $saved_sn := []string{}
    $saved_st := []int{}
    for i in 0:c.sub_names.len {
        saved_sn.push(c.sub_names[i])
        saved_st.push(c.sub_tys[i])
    }
    ti := c.find_stpl(c.named_local_of(p, at), c.named_mod_of(p, at))
    if ti < 0 {
        c.fail_node(p, at, "'" + p.nodes[at].sval + "' is not a generic struct")
        << -1
    }
    if c.named_mod_of(p, at) != c.env.cur_mod && c.stpl_pub[ti] == 0 {
        c.fail_node(p, at, "'" + c.named_local_of(p, at) + "' is private")
        << -1
    }
    // Count template type params.
    d := c.stpl_decl[ti]
    $ntp := 0
    $tp := p.nodes[d].e
    while tp >= 0 {
    ntp += 1
    tp = p.nodes[tp].next
    }
    if args.len != ntp {
        c.fail_node(p, at, "struct '" + p.nodes[at].sval + "' takes " + str(ntp) + " type argument(s), found " + str(args.len))
        << -1
    }
    // Dedup existing instances (re-read sval/mod each compare — strings move).
    for si in 0:c.env.structs.len {
        if c.env.structs[si].origin == c.named_local_of(p, at) && c.env.structs[si].mod_id == c.named_mod_of(p, at) {
            $same := c.env.sargs[si].len == args.len
            if same {
                for i in 0:args.len {
                    if c.env.sargs[si][i] != args[i] {
                        same = false
                    }
                }
            }
            if same {
                << si
            }
        }
    }
    // Build subst from template type params.
    c.clear_subst()
    tp = p.nodes[d].e
    $k := 0
    while tp >= 0 {
    c.set_subst_pair(p.nodes[tp].sval, args[k])
    k += 1
    tp = p.nodes[tp].next
    }
    $st := typeenv.CStruct{
        name: p.nodes[at].sval,
        fields: []typeenv.CField{},
        nslots: 0,
        size_bytes: 0,
        align_bytes: 1,
        mod_id: c.named_mod_of(p, at),
        is_pub: c.stpl_pub[ti] != 0,
        is_union: false,
        origin: c.named_local_of(p, at),
        drop_label: ""
    }
    // Pretty name: Box#int
    $nm := p.nodes[at].sval + "#"
    for i in 0:args.len {
        if i > 0 { nm = nm + "," }
        nm = nm + c.ty_display(args[i])
    }
    st.name = nm
    $f := p.nodes[d].a
    $off := 0
    $mal := 1
    rflags := types.ffi_decl_flags(p, d)
    is_packed := rflags >= 0 && (rflags & ast.FFI_PACKED) != 0
    custom_align := types.ffi_decl_align(p, d)
    if custom_align > mal { mal = custom_align }
    while f >= 0 {
    if p.nodes[f].kind != ast.NK_FIELD_DECL {
        c.clear_subst()
        c.fail_node(p, f, "malformed struct field")
    }
    fty := c.type_of(p, p.nodes[f].a)
    // M10: reference fields allowed on monomorphized structs too.
    $life := ""
    tn := p.nodes[f].a
    if tn >= 0 && p.nodes[tn].kind == ast.NT_REF {
        life = p.nodes[tn].sval
    }
    $al := c.type_align_bytes(fty)
    if is_packed { al = 1 }
    if al < 1 || al > types.MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct field alignment exceeds layout limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    aligned := types.align_up_bytes(off, al)
    if aligned < off || aligned > types.MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    sz := c.type_size_bytes(fty)
    if sz < 0 || sz > types.MIR_MAX_LAYOUT_BYTES || aligned > types.MIR_MAX_LAYOUT_BYTES - sz {
        c.fail_node(p, f, "struct layout exceeds byte limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    if !is_packed && al > mal { mal = al }
    st.fields.push(typeenv.CField{name: p.nodes[f].sval, ty: fty, slot: aligned, life: life, is_pub: (p.nodes[f].ival & 1) == 1, bit_off: 0, bit_width: 0, bit_unit: 0})
    off = aligned + sz
    f = p.nodes[f].next
    }
    aligned := types.align_up_bytes(off, mal)
    if aligned < off || aligned > types.MIR_MAX_LAYOUT_BYTES {
        c.fail_node(p, at, "struct layout exceeds byte limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    off = aligned
    $nslots := off / 8
    if off % 8 != 0 { nslots += 1 }
    if nslots > types.MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, at, "struct layout exceeds slot limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    st.nslots = nslots
    st.size_bytes = off
    st.align_bytes = mal
    c.clear_subst()
    // Restore caller subst.
    for i in 0:saved_sn.len {
        c.set_subst_pair(saved_sn[i], saved_st[i])
    }
    if c.type_table_full(c.env.structs.len, types.TYPE_TABLE_LIMIT, "struct", 5) { << -1 }
    c.env.structs.push(st)
    c.note_st_index()
    $arg_copy := []int{}
    for i in 0:args.len {
        arg_copy.push(args[i])
    }
    c.env.sargs.push(arg_copy)
    c.env.sdecl.push(-1)
    c.env.slaid.push(1)
    c.env.sdoing.push(0)
    << c.env.structs.len - 1
}

// Instantiate generic enum from type args already in c.targs.
fn (c $&Checker) instantiate_enum(p &parser.Parser, at int) int {
    args := c.targs_copy()
    $saved_sn := []string{}
    $saved_st := []int{}
    for i in 0:c.sub_names.len {
        saved_sn.push(c.sub_names[i])
        saved_st.push(c.sub_tys[i])
    }
    ti := c.find_etpl(c.named_local_of(p, at), c.named_mod_of(p, at))
    if ti < 0 {
        c.fail_node(p, at, "'" + p.nodes[at].sval + "' is not a generic enum")
        << -1
    }
    if c.named_mod_of(p, at) != c.env.cur_mod && c.etpl_pub[ti] == 0 {
        c.fail_node(p, at, "'" + c.named_local_of(p, at) + "' is private")
        << -1
    }
    d := c.etpl_decl[ti]
    $ntp := 0
    $tp := p.nodes[d].e
    while tp >= 0 {
        ntp += 1
        tp = p.nodes[tp].next
    }
    if args.len != ntp {
        c.fail_node(p, at, "enum '" + p.nodes[at].sval + "' takes " + str(ntp) + " type argument(s), found " + str(args.len))
        << -1
    }
    for ei in 0:c.env.enums.len {
        if c.env.enums[ei].origin == c.named_local_of(p, at) && c.env.enums[ei].mod_id == c.named_mod_of(p, at) {
            $same := c.env.enums[ei].args.len == args.len
            if same {
                for i in 0:args.len {
                    if c.env.enums[ei].args[i] != args[i] {
                        same = false
                    }
                }
            }
            if same {
                << ei
            }
        }
    }
    if c.env.enums.len >= types.TYPE_TABLE_LIMIT {
        c.fail_node(p, at, "too many enum types")
        << -1
    }
    c.clear_subst()
    tp = p.nodes[d].e
    $k := 0
    while tp >= 0 {
        c.set_subst_pair(p.nodes[tp].sval, args[k])
        k += 1
        tp = p.nodes[tp].next
    }
    $nm := p.nodes[at].sval + "#"
    for i in 0:args.len {
        if i > 0 { nm = nm + "," }
        nm = nm + c.ty_display(args[i])
    }
    $en := typeenv.CEnum{
        name: nm,
        variants: []typeenv.CEnumVariant{},
        nslots: 1,
        owns: false,
        mod_id: c.named_mod_of(p, at),
        is_pub: c.etpl_pub[ti] != 0,
        origin: c.named_local_of(p, at),
        args: []int{}
    }
    $arg_copy := []int{}
    for i in 0:args.len {
        arg_copy.push(args[i])
    }
    en.args = arg_copy
    $max_payload := 0
    $v := p.nodes[d].a
    while v >= 0 {
        if p.nodes[v].kind != ast.NK_VARIANT_DECL {
            c.clear_subst()
            c.fail_node(p, v, "malformed enum variant")
        }
        $fields := []int{}
        $field_slots := 0
        $ft := p.nodes[v].a
        while ft >= 0 {
            fty := c.type_of(p, ft)
            if types.is_ref_type(fty) {
                c.clear_subst()
                c.fail_node(p, ft, "enum payload cannot contain references without lifetime tracking")
            }
            slots := c.type_slots(fty)
            // Keep the tag+payload representation bounded even for generated
            // generic instances. Zero-sized temporary/empty structs are
            // valid; every positive contribution must fit before the sum.
            if slots < 0 || slots > types.MIR_MAX_LAYOUT_WORDS || field_slots > types.MIR_MAX_LAYOUT_WORDS - slots {
                c.fail_node(p, ft, "enum payload exceeds layout limit")
                c.clear_subst()
                for i in 0:saved_sn.len {
                    c.set_subst_pair(saved_sn[i], saved_st[i])
                }
                << -1
            }
            fields.push(fty)
            field_slots += slots
            if c.type_owning(fty) {
                en.owns = true
            }
            ft = p.nodes[ft].next
        }
        if field_slots >= types.MIR_MAX_LAYOUT_WORDS {
            c.fail_node(p, v, "enum payload exceeds layout limit")
            c.clear_subst()
            for i in 0:saved_sn.len {
                c.set_subst_pair(saved_sn[i], saved_st[i])
            }
            << -1
        }
        if field_slots > max_payload {
            max_payload = field_slots
        }
        en.variants.push(typeenv.CEnumVariant{
            name: p.nodes[v].sval,
            fields: fields,
            field_slots: field_slots
        })
        v = p.nodes[v].next
    }
    if max_payload >= types.MIR_MAX_LAYOUT_WORDS {
        c.fail_node(p, at, "enum payload exceeds layout limit")
        c.clear_subst()
        for i in 0:saved_sn.len {
            c.set_subst_pair(saved_sn[i], saved_st[i])
        }
        << -1
    }
    en.nslots = 1 + max_payload
    c.clear_subst()
    for i in 0:saved_sn.len {
        c.set_subst_pair(saved_sn[i], saved_st[i])
    }
    c.env.enums.push(en)
    << c.env.enums.len - 1
}

fn (c &Checker) find_fn(name string) int {
    // Unqualified call: resolve in the current module only.
    << c.find_fn_in_mod(name, c.env.cur_mod)
}

// Name lookup may hit a monomorphized instance; generic calls need the template.
fn (c &Checker) template_for_fn(fi int) int {
    if fi < 0 || c.env.fns[fi].is_template || c.env.is_inst[fi] == 0 {
        << fi
    }
    d := c.env.fndecl[fi]
    for i in 0:c.env.fns.len {
        if c.env.fns[i].is_template && c.env.fndecl[i] == d {
            << i
        }
    }
    << fi
}

// Intern `fn(T,...) R` (M103/M109). Nested `fn` params are allowed.
// Kind/index handles share a metadata resource budget. Report an exhausted
// table once; the first valid handle permits checking to finish while the
// diagnostic prevents code generation. No kind can spill into another kind.
fn (c $&Checker) type_table_full(used int, limit int, kind string, bit int) bool {
    if used < limit { << false }
    if ((c.type_full_mask >> bit) & 1) == 0 {
        c.type_full_mask = c.type_full_mask | (1 << bit)
        c.fail_at(1, 1, "too many " + kind + " types in program (limit " + str(limit) + ")")
    }
    << true
}

fn (c $&Checker) intern_fn_sig(params []int, ret int) int {
    << c.intern_fn_sig_env(params, ret, 0, -1)
}

fn (c $&Checker) intern_fn_sig_env(params []int, ret int, has_env int, env_struct int) int {
    $sb := new_strbuf(32 + params.len * 4)
    sb.write_str(str(has_env))
    sb.write_byte(95)
    sb.write_str(str(env_struct))
    sb.write_byte(95)
    sb.write_str(str(ret))
    for i in 0:params.len {
        sb.write_byte(95)
        sb.write_str(str(params[i]))
    }
    key := sb.finish()
    hit := strmap_get(&c.fn_sig_map, &key)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.env.fn_sigs.len, types.TYPE_TABLE_LIMIT, "function signature", 0) { << types.fn_type(0) }
    $ps := []int{}
    for j in 0:params.len {
        ps.push(params[j])
    }
    c.env.fn_sigs.push(typeenv.CFnSig{params: ps, ret: ret, has_env: has_env, env_struct: env_struct})
    id := types.fn_type(c.env.fn_sigs.len - 1)
    strmap_put($&c.fn_sig_map, key, id)
    << id
}

// M109: fn types compare params+ret unless an environment carries
// unique resources or borrowed references (those cannot be erased silently).
fn (c &Checker) same_type(a int, b int) bool {
    if types.is_fn_type(a) && types.is_fn_type(b) {
        sa := types.fn_index(a)
        sb := types.fn_index(b)
        if sa < 0 || sb < 0 || sa >= c.env.fn_sigs.len || sb >= c.env.fn_sigs.len {
            << false
        }
        if (c.closure_owns_resource(a) || c.closure_owns_resource(b) || c.type_contains_ref(a) || c.type_contains_ref(b)) &&
           c.env.fn_sigs[sa].env_struct != c.env.fn_sigs[sb].env_struct {
            << false
        }
        if c.env.fn_sigs[sa].ret != c.env.fn_sigs[sb].ret {
            << false
        }
        if c.env.fn_sigs[sa].params.len != c.env.fn_sigs[sb].params.len {
            << false
        }
        for i in 0:c.env.fn_sigs[sa].params.len {
            if c.env.fn_sigs[sa].params[i] != c.env.fn_sigs[sb].params[i] {
                << false
            }
        }
        << true
    }
    << a == b
}

fn (c $&Checker) coerce_to(p &parser.Parser, n int, got int, want int) int {
    if types.is_error_type(got) || types.is_error_type(want) {
        << types.ERROR_TY
    }
    if types.is_fn_type(got) && types.is_fn_type(want) && (c.closure_owns_resource(got) || c.closure_owns_resource(want)) {
        if c.env.fn_sigs[types.fn_index(got)].env_struct != c.env.fn_sigs[types.fn_index(want)].env_struct {
            c.fail_node(p, n, "cannot erase a resource-owning closure environment")
            << types.ERROR_TY
        }
    }
    if types.is_fn_type(got) && types.is_fn_type(want) && (c.type_contains_ref(got) || c.type_contains_ref(want)) {
        if c.env.fn_sigs[types.fn_index(got)].env_struct != c.env.fn_sigs[types.fn_index(want)].env_struct {
            c.fail_node(p, n, "cannot erase a borrowed closure environment")
            << types.ERROR_TY
        }
    }
    if c.same_type(got, want) { << got }
    // Spec34 B: only an identical direct pointee and a local reference name
    // can acquire a shared view. Keep the source permission separately; all
    // loan consumers must treat this adjustment exactly like explicit &*r.
    if types.is_mut_ref_type(got) && types.is_ref_type(want) && !types.is_mut_ref_type(want) {
        if c.same_type(c.ref_inner_type(got), c.ref_inner_type(want)) {
            if p.nodes[n].kind != ast.NK_IDENT || c.env.nlocal[n] < 0 {
                c.fail_node(p, n, "implicit shared reborrow requires a local reference name\nhelp: bind the reference to a local first, if moving it is allowed")
                << types.ERROR_TY
            }
            c.set_nshared(n, got)
            c.set_ntype(n, want)
            << want
        }
    }
    // Spec34 C / E21b: only Borrow(Deref(local)) takes its write permission
    // from an explicit expectation. Never upgrade a shared source reference.
    if types.is_mut_ref_type(want) && types.is_ref_type(got) && !types.is_mut_ref_type(got) && p.nodes[n].kind == ast.NK_BORROW && p.nodes[n].ival == 0 {
        target := p.nodes[n].a
        if p.nodes[target].kind == ast.NK_UN_OP && p.nodes[target].ival == 3 {
            inner := p.nodes[target].a
            if p.nodes[inner].kind == ast.NK_IDENT && c.same_type(c.env.ntype[inner], want) {
                c.set_nshared(n, -2)
                c.set_ntype(n, want)
                << want
            }
        }
    }
    // D16/F25: an ordinary place acquires a shared loan only under a known
    // identical direct-pointee expectation. Inference never enters this path.
    if !types.is_ref_type(got) && types.is_ref_type(want) && !types.is_mut_ref_type(want) && c.same_type(got, c.ref_inner_type(want)) {
        k := p.nodes[n].kind
        $root := c.borrow_root_local(p, n)
        deref := k == ast.NK_UN_OP && p.nodes[n].ival == 3
        if deref {
            inner := p.nodes[n].a
            if p.nodes[inner].kind != ast.NK_IDENT {
                c.fail_node(p, n, c.reborrow_place_error())
                << types.ERROR_TY
            }
            root = c.env.nlocal[inner]
        }
        // A method value or a constant array length has no field storage.
        computed_field := k == ast.NK_FIELD && (c.env.ncall[n] == -92 || c.env.ncall[n] == -95 || c.env.ncall[n] == -96)
        if (k != ast.NK_IDENT && k != ast.NK_FIELD && k != ast.NK_INDEX && !deref) || root < 0 || computed_field {
            c.fail_node(p, n, "automatic read-only borrow requires an ordinary place with a local root\nhelp: bind the value to a local first")
            << types.ERROR_TY
        }
        rt := c.check_borrow_target(p, n, n, false, got)
        c.set_nshared(n, -1)
        // Borrowing a string/index place must not retain a value-read clone.
        c.set_nclone(n, 0)
        << rt
    }
    if types.is_integer_type(want) && got == 1 && c.is_const_int_expr(p, n) {
        c.set_ntype(n, want)
        << want
    }
    // A float literal (optionally negated) takes f32 from its context.
    if want == 14 && got == 4 && is_float_literal(p, n) {
        c.set_ntype(n, want)
        if p.nodes[n].kind == ast.NK_UN_OP { c.set_ntype(p.nodes[n].a, want) }
        << want
    }
    // MS5: expected temp / dynamic struct@ — same box lowering as typed let.
    // Keep concrete ntype (tag / struct id). nbox holds the expected fat type
    // so MIR can wrap without overwriting a Call's ncall.
    if types.is_temp_type(want) || types.is_any_type(want) {
        if types.is_dynamic_box(got) {
            // Same fat layout: retype between temp/any/iface.
            if types.is_interface_type(got) {
                c.set_nbox(n, want)
            }
            << want
        }
        if !types.can_box_into_temp(got) || types.temp_box_type_id(got) < 0 || c.type_contains_ref(got) {
            $dest_name := "temp"
            if types.is_any_type(want) { dest_name = "any" }
            c.fail_node(p, n, "cannot box " + c.ty_display(got) + " into " + dest_name)
            << types.ERROR_TY
        }
        if types.is_any_type(want) && c.type_has_drop_hook(got) {
            c.fail_node(p, n, "cannot box resource type " + c.ty_display(got) + " into any (use temp or an interface)")
            << types.ERROR_TY
        }
        c.set_nbox(n, want)
        if c.env.ncall[n] == -1 {
            c.set_ncall(n, -98)
        }
        << want
    }
    if types.is_interface_type(want) {
        ii := types.interface_index(want)
        if !types.is_struct_type(got) {
            c.fail_node(p, n, "cannot box " + c.ty_display(got) + " into " + c.env.iface_names[ii] + " (only structs)")
            << types.ERROR_TY
        }
        if c.type_contains_ref(got) {
            c.fail_node(p, n, "cannot box " + c.ty_display(got) + " into " + c.env.iface_names[ii] + " (contains a reference)")
            << types.ERROR_TY
        }
        if !c.check_interface_box_contract(p, got, ii, n) { << types.ERROR_TY }
        c.set_nbox(n, want)
        if c.env.ncall[n] == -1 {
            c.set_ncall(n, -93)
        }
        << want
    }
    << got
}

// Type annotation node -> type tag. Respects active type-param substitution.
fn (c $&Checker) type_of(p &parser.Parser, t int) int {
    k := p.nodes[t].kind
    if k == ast.NT_INT {
        if p.nodes[t].ival == 1 { << 8 }
        if p.nodes[t].ival == 2 { << 9 }
        if p.nodes[t].ival == 3 { << 10 }
        if p.nodes[t].ival == 4 { << 6 }
        if p.nodes[t].ival == 5 { << 7 }
        if p.nodes[t].ival == 6 { << 11 }
        if p.nodes[t].ival == 7 { << 12 }
        if p.nodes[t].ival == 8 { << 13 }
        if p.nodes[t].ival == 9 { << c.ffi_c_long_ty() }
        if p.nodes[t].ival == 10 { << c.ffi_c_ulong_ty() }
        << 1
    }
    if k == ast.NT_BOOL { << 2 }
    if k == ast.NT_STR { << 3 }
    if k == ast.NT_F64 {
        if p.nodes[t].ival == 1 { << 14 }
        << 4
    } // f64 / f32
    if k == ast.NT_SELF { << 5 } // Self (M102)
    if k == ast.NT_TEMP { << types.TEMP_TY } // nt_temp (M200)
    if k == ast.NT_ANY { << types.ANY_TY } // nt_any — keep box across `as`
    if k == ast.NT_NAMED { // TNamed: type param, plain struct, or generic instance
        // Type parameter of the current generic definition?
        if p.nodes[t].a < 0 {
            su := c.subst_lookup(p.nodes[t].sval)
            if su >= 0 {
                << su
            }
        }
        // Qualified `mod.Name`: require import (same rule as module calls).
        if c.named_mod_of(p, t) != c.env.cur_mod {
            if !c.module_visible(c.named_mod_of(p, t)) {
                c.fail_node(p, t, "module " + c.named_mod_of(p, t) + " not imported")
                << types.ERROR_TY
            }
        }
        // Generic struct/enum with type arguments.
        if p.nodes[t].a >= 0 {
            c.collect_type_list_n(p, p.nodes[t].a)
            if c.find_stpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
                si := c.instantiate_struct(p, t)
                << types.struct_type(si)
            }
            if c.find_etpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
                ei := c.instantiate_enum(p, t)
                << types.enum_type(ei)
            }
            c.fail_node(p, t, "'" + p.nodes[t].sval + "' is not a generic type")
            << -1
        }
        // Built-in FileInfo struct (M35), available unqualified in any module.
        if c.named_local_of(p, t) == "FileInfo" {
            << c.intern_file_info_type()
        }
        if p.nodes[t].a < 0 && c.named_local_of(p, t) == "temp" && c.named_mod_of(p, t) == c.env.cur_mod {
            << types.TEMP_TY
        }
        if p.nodes[t].a < 0 && c.named_local_of(p, t) == "any" && c.named_mod_of(p, t) == c.env.cur_mod {
            << types.ANY_TY
        }
        si := c.find_struct_in_mod(c.named_local_of(p, t), c.named_mod_of(p, t))
        if si >= 0 {
            if c.named_mod_of(p, t) != c.env.cur_mod && !c.env.structs[si].is_pub {
                c.fail_node(p, t, "'" + c.named_local_of(p, t) + "' is private")
            }
                << types.struct_type(si)
        }
        ei := c.find_enum_in_mod(c.named_local_of(p, t), c.named_mod_of(p, t))
        if ei >= 0 {
            if c.named_mod_of(p, t) != c.env.cur_mod && !c.env.enums[ei].is_pub {
                c.fail_node(p, t, "'" + c.named_local_of(p, t) + "' is private")
            }
            << types.enum_type(ei)
        }
        if c.find_stpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
            c.fail_node(p, t, "generic struct '" + p.nodes[t].sval + "' requires type arguments")
            << -1
        }
        if c.find_etpl(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
            c.fail_node(p, t, "generic enum '" + p.nodes[t].sval + "' requires type arguments")
            << -1
        }
        if c.find_iface_global(c.named_local_of(p, t), c.named_mod_of(p, t)) >= 0 {
            ii := c.find_iface_global(c.named_local_of(p, t), c.named_mod_of(p, t))
            << types.interface_type(ii)
        }
        c.fail_node(p, t, "unknown type '" + p.nodes[t].sval + "'")
        << types.ERROR_TY
    }
    if k == ast.NT_ARRAY { // TArray(elem) — ival>0 → [N]T
        ety := c.type_of(p, p.nodes[t].a)
        << c.intern_array_type_n(ety, p.nodes[t].ival)
    }
    if k == ast.NT_CHAN { // TChan(elem) M17
        ety := c.type_of(p, p.nodes[t].a)
        if !c.type_is_send(ety) {
            c.fail_node(p, t, "channel element type cannot be a reference")
        }
        << c.intern_chan_type(ety)
    }
    if k == ast.NT_MAP { // TMap(key, val) L-C
        kty := c.type_of(p, p.nodes[t].a)
        vty := c.type_of(p, p.nodes[t].b)
        << c.intern_map_type(p, t, kty, vty)
    }
    if k == ast.NT_RAW_PTR { // TRawPtr(inner)
        ity := c.type_of(p, p.nodes[t].a)
        rty := c.make_raw_ptr_type(ity)
        if rty < 0 {
            c.fail_node(p, t, "cannot form raw pointer to type " + c.ty_display(ity))
        }
        << rty
    }
    if k == ast.NT_REF { // TRef(mutable, inner)
        mutable := p.nodes[t].ival == 1
        ity := c.type_of(p, p.nodes[t].a)
        if types.is_dynamic_box(ity) {
            c.fail_node(p, t, "cannot borrow a value of type " + c.ty_display(ity))
        }
        // M166: one nesting level via make_ref_type.
        rty := c.make_ref_type(mutable, ity)
        if rty < 0 {
            c.fail_node(p, t, "cannot borrow a value of type " + c.ty_display(ity))
        }
        << rty
    }
    if k == ast.NT_FN { // TFn(params..., ret) M103
        $params := []int{}
        $prm := p.nodes[t].a
        while prm >= 0 {
        params.push(c.type_of(p, prm))
        prm = p.nodes[prm].next
        }
        $ret := 0
        if p.nodes[t].b >= 0 {
            ret = c.type_of(p, p.nodes[t].b)
        }
        << c.intern_fn_sig(params, ret)
    }
    c.fail_node(p, t, "type not supported yet (M6b2-s3a/s3c: int/bool/string/struct)")
    << -1
}

// M107: sync Call/Method argument. Exclusive-ref formal + actual → reborrow
// (no note_move). Otherwise same as move_of.
fn (c $&Checker) arg_pass(p &parser.Parser, n int, aty int, want int) {
    if types.is_mut_ref_type(want) && types.is_mut_ref_type(aty) {
        <<
    }
    c.move_of(p, n, aty, false)
}

fn (c &Checker) find_struct(name string) int {
    << c.find_struct_in_mod(name, c.env.cur_mod)
}

// §4.5: cross-module field access requires `pub` on the field.
fn (c $&Checker) require_field_visible(p &parser.Parser, n int, si int, fi int) {
    if c.env.structs[si].mod_id != c.env.cur_mod && !c.env.structs[si].fields[fi].is_pub {
        c.fail_node(p, n, "field '" + c.env.structs[si].fields[fi].name + "' is private")
    }
}

fn (c $&Checker) intern_array_type(elem_ty int) int {
    << c.intern_array_type_n(elem_ty, 0)
}

fn (c $&Checker) intern_array_type_n(elem_ty int, fixed_len int) int {
    // Parser paths normally enforce a positive fixed length, but generic and
    // generated paths can reach this helper directly.  Reject malformed
    // lengths before constructing a map key or growing the type table.
    if fixed_len < 0 || fixed_len > types.MIR_MAX_LAYOUT_WORDS { << 0 }
    eb := c.type_size_bytes(elem_ty)
    // Dynamic arrays carry a descriptor and can be interned while a
    // cross-module struct is still being laid out (its size is temporarily
    // zero).  Keep that established ordering; only a fixed array needs the
    // element-size product below.  Negative/oversized metadata is malformed
    // in either case.
    if eb < 0 || eb > types.MIR_MAX_LAYOUT_BYTES { << 0 }
    if fixed_len > 0 {
        if eb <= 0 { << 0 }
        if fixed_len > types.MIR_MAX_LAYOUT_BYTES || fixed_len * eb > types.MIR_MAX_LAYOUT_BYTES { << 0 }
    }
    k := str(elem_ty) + ":" + str(fixed_len)
    hit := strmap_get(&c.array_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.env.arrays.len, types.TYPE_TABLE_LIMIT, "array", 1) { << types.array_type(0) }
    c.env.arrays.push(typeenv.CArray{elem_ty: elem_ty, elem_bytes: eb, fixed_len: fixed_len})
    id := types.array_type(c.env.arrays.len - 1)
    strmap_put($&c.array_map, k, id)
    << id
}

fn (c $&Checker) intern_chan_type(elem_ty int) int {
    k := str(elem_ty)
    hit := strmap_get(&c.chan_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.env.chans.len, types.TYPE_TABLE_LIMIT, "channel", 2) { << types.chan_type(0) }
    es := c.type_slots(elem_ty)
    c.env.chans.push(typeenv.CChan{elem_ty: elem_ty, elem_slots: es})
    id := types.chan_type(c.env.chans.len - 1)
    strmap_put($&c.chan_map, k, id)
    << id
}

fn (c &Checker) is_maps_table(ty int) bool {
    if !types.is_struct_type(ty) {
        << false
    }
    si := types.struct_index(ty)
    if c.env.structs[si].mod_id != "maps" {
        << false
    }
    n := c.env.structs[si].name
    << n == "StrInt" || n == "StrStr"
}

fn (c &Checker) maps_val_ty(ty int) int {
    if c.env.structs[types.struct_index(ty)].name == "StrInt" {
        << 1
    }
    << 3
}

fn (c &Checker) find_maps_free(name string) int {
    for i in 0:c.env.fns.len {
        if c.env.fns[i].mod_id == "maps" && c.env.fns[i].name == name && c.env.fns[i].recv < 0 {
            << i
        }
    }
    << -1
}

fn (c $&Checker) intern_map_type(p &parser.Parser, n int, kty int, vty int) int {
    $kkind := -1
    if kty == 1 { kkind = 0 }
    if kty == 3 { kkind = 1 }
    if kkind < 0 {
        c.fail_node(p, n, "map key type must be int or string")
        << 0
    }
    if types.is_ref_type(vty) {
        c.fail_node(p, n, "map value type cannot be a reference")
        << 0
    }
    nslots := c.slots_of(p, vty, n)
    if nslots <= 0 || nslots > 255 {
        c.fail_node(p, n, "map value type is too large")
        << 0
    }
    $vkind := 2
    if vty == 3 {
        vkind = 1
    } else if !c.type_owning(vty) && nslots == 1 {
        vkind = 0
    }
    k := str(kty) + "," + str(vty)
    hit := strmap_get(&c.map_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.env.maps.len, types.TYPE_TABLE_LIMIT, "map", 3) { << types.map_type(0) }
    c.env.maps.push(typeenv.CMap{key_ty: kty, val_ty: vty, kkind: kkind, vkind: vkind, vslots: nslots})
    id := types.map_type(c.env.maps.len - 1)
    strmap_put($&c.map_map, k, id)
    << id
}

// m37: minimum number of positionally-checked arguments a call must supply
// (fixed params; a trailing variadic param is optional).
fn (c &Checker) fn_min_arity(fi int) int {
    if fi < 0 { << 0 }
    if c.env.fns[fi].variadic { << c.env.fns[fi].params.len - 1 }
    << c.env.fns[fi].params.len
}

// m37: element type of the trailing variadic array param, or -1 when absent.
fn (c &Checker) fn_variadic_elem(fi int) int {
    if fi < 0 || !c.env.fns[fi].variadic { << -1 }
    aty := c.env.fns[fi].params[c.env.fns[fi].params.len - 1]
    << c.env.arrays[types.array_index(aty)].elem_ty
}

fn (c $&Checker) intern_throw_type(ok_ty int, err_ty int) int {
    k := str(ok_ty) + "_" + str(err_ty)
    hit := strmap_get(&c.throw_map, &k)
    if hit >= 0 {
        << hit
    }
    if c.type_table_full(c.env.throws.len, types.TYPE_TABLE_LIMIT, "result", 4) { << types.throw_type(0) }
    c.env.throws.push(typeenv.CThrow{ok_ty: ok_ty, err_ty: err_ty})
    id := types.throw_type(c.env.throws.len - 1)
    strmap_put($&c.throw_map, k, id)
    << id
}

// Built-in `FileInfo` struct (M35): { size int, is_dir bool, mode int }.
// Registered on first use so an unused builtin never perturbs the struct
// index space that the emitter's per-type drop helpers walk.
fn (c $&Checker) intern_file_info_type() int {
    for i in 0:c.env.structs.len {
        if c.env.structs[i].name == "FileInfo" && c.env.structs[i].mod_id == "" && c.env.structs[i].origin == "" {
            << types.struct_type(i)
        }
    }
    $fi := typeenv.CStruct{
        name: "FileInfo",
        fields: []typeenv.CField{},
        nslots: 0,
        size_bytes: 0,
        align_bytes: 1,
        mod_id: "",
        is_pub: true,
        is_union: false,
        origin: "",
        drop_label: ""
    }
    fi.fields.push(typeenv.CField{name: "size", ty: 1, slot: 0, life: "", is_pub: true, bit_off: 0, bit_width: 0, bit_unit: 0})
    fi.fields.push(typeenv.CField{name: "is_dir", ty: 2, slot: 8, life: "", is_pub: true, bit_off: 0, bit_width: 0, bit_unit: 0})
    fi.fields.push(typeenv.CField{name: "mode", ty: 1, slot: 16, life: "", is_pub: true, bit_off: 0, bit_width: 0, bit_unit: 0})
    fi.nslots = 3
    fi.size_bytes = 24
    fi.align_bytes = 8
    if c.type_table_full(c.env.structs.len, types.TYPE_TABLE_LIMIT, "struct", 5) { << -1 }
    c.env.structs.push(fi)
    c.note_st_index()
    c.env.sargs.push([]int{})
    c.env.sdecl.push(-1)
    c.env.slaid.push(1)
    c.env.sdoing.push(0)
    << types.struct_type(c.env.structs.len - 1)
}

pub fn (c &Checker) type_layout(ty int) types.TypeLayout {
    << types.TypeLayout{
        slots: c.type_slots(ty),
        size_bytes: c.type_size_bytes(ty),
        align_bytes: c.type_align_bytes(ty),
        owning: c.type_owning(ty),
        descriptor: types.mir_ty_is_descriptor(ty),
        abi_class: types.mir_type_abi_class(ty)
    }
}

// Method lookup: exact recv type, or by template origin name for instances.

fn is_float_literal(p &parser.Parser, n int) bool {
    if p.nodes[n].kind == ast.NK_FLOAT { << true }
    << p.nodes[n].kind == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_NEG && p.nodes[p.nodes[n].a].kind == ast.NK_FLOAT
}

// C alignment: a fixed array aligns as its element (Xu otherwise word-aligns
// fixed arrays); everything else matches type_align_bytes.
fn (c &Checker) c_align_bytes(ty int) int {
    if types.is_array_type(ty) && c.env.arrays[types.array_index(ty)].fixed_len > 0 {
        << c.c_align_bytes(c.env.arrays[types.array_index(ty)].elem_ty)
    }
    << c.type_align_bytes(ty)
}
