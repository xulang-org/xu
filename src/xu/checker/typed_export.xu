@xu/checker

#xu/parser
#xu/typeenv
#xu/types

// Run the checker and export the typed view. Exits with status 1 after
// printing diagnostics when the program is ill-typed.
pub fn check_typed(p &parser.Parser, target_code int, lib_mode int, c $&Checker, out $&types.TypedProgram) {
    empty := []string{}
    check_typed_native(p, target_code, lib_mode, &empty, c, out)
}

pub fn check_typed_native(p &parser.Parser, target_code int, lib_mode int, native_labels &[]string, c $&Checker, out $&types.TypedProgram) {
    c.rebind = -1
    c.move_err_n = -1
    c.env.attr = -1
    c.cur_while = 0 - 1
    c.env.errors_iface = -1
    c.env.test_count = 1
    c.env.opt_level = 1
    c.seed_strmaps()
    c.seed_slices()
    c.prep_nodes(p.nodes.len)
    c.apply_target(target_code)
    c.env.lib_mode = lib_mode
    for i in 0:native_labels.len { c.add_lib_ext(~native_labels[i]) }
    c.check_program(p)
    c.emit_warnings(p)
    if c.env.error_count > 0 {
        <<< 1
    }
    c.export_typed(out)
    c.release_after_check()
}

// Type-check p for target_code and return the generated C FFI header.
pub fn cbind_header(c $&Checker, p &parser.Parser, target_code int, native_labels &[]string, skip_prefix string, guard_name string) string {
    c.cbind_on = true
    c.cbind_skip = skip_prefix + ""
    c.cbind_guard = guard_name + ""
    $m := DummyMir{dummy: 0, opt_level: 0}
    $out_fns := []typeenv.CFn{}
    run_checker(c, p, target_code, 0, 1, ~native_labels, []string{}, 0, $&m, []string{}, "", false, false, 1, false, $&out_fns)
    << c.cbind_hdr + ""
}

fn (c $&Checker) export_typed(out $&types.TypedProgram) {
    for i in 0:c.env.structs.len {
        $fields := []types.TField{}
        for j in 0:c.env.structs[i].fields.len {
            fields.push(types.TField{
                name: c.env.structs[i].fields[j].name + "",
                ty: c.env.structs[i].fields[j].ty,
                offset: c.env.structs[i].fields[j].slot,
                bit_off: c.env.structs[i].fields[j].bit_off,
                bit_width: c.env.structs[i].fields[j].bit_width,
                bit_unit: c.env.structs[i].fields[j].bit_unit
            })
        }
        out.structs.push(types.TStruct{
            name: c.env.structs[i].name + "",
            fields: fields,
            size: c.env.structs[i].size_bytes,
            align: c.env.structs[i].align_bytes,
            is_union: c.env.structs[i].is_union,
            has_drop: c.env.structs[i].drop_label.len > 0,
            drop_label: c.env.structs[i].drop_label + ""
        })
    }
    for i in 0:c.env.arrays.len {
        out.arrays.push(types.TArray{
            elem_ty: c.env.arrays[i].elem_ty,
            elem_bytes: c.env.arrays[i].elem_bytes,
            fixed_len: c.env.arrays[i].fixed_len
        })
    }
    for i in 0:c.env.throws.len {
        out.throws.push(types.TThrow{ok_ty: c.env.throws[i].ok_ty, err_ty: c.env.throws[i].err_ty})
    }
    for i in 0:c.env.enums.len {
        $variants := []types.TVariant{}
        for vi in 0:c.env.enums[i].variants.len {
            $fields := []int{}
            $offsets := []int{}
            $off := 8
            for fi in 0:c.env.enums[i].variants[vi].fields.len {
                fty := c.env.enums[i].variants[vi].fields[fi]
                fields.push(fty)
                offsets.push(off)
                off += c.type_slots(fty) * 8
            }
            variants.push(types.TVariant{name: c.env.enums[i].variants[vi].name + "", fields: fields, offsets: offsets})
        }
        out.enums.push(types.TEnum{name: c.env.enums[i].name + "", variants: variants, size: c.type_size_bytes(types.enum_type(i))})
    }
    for i in 0:c.env.chans.len {
        out.chan_elems.push(c.env.chans[i].elem_ty)
    }
    for i in 0:c.env.maps.len {
        out.maps.push(types.TMap{key_ty: c.env.maps[i].key_ty, val_ty: c.env.maps[i].val_ty})
    }
    for i in 0:c.env.strings.len {
        out.strings.push(c.env.strings[i] + "")
    }
    for i in 0:c.env.ref_targets.len {
        out.ref_targets.push(c.env.ref_targets[i])
    }
    for i in 0:c.env.ctypes.len {
        out.const_tys.push(c.env.ctypes[i])
        $iv := 0
        if i < c.env.civals.len { iv = c.env.civals[i] }
        out.const_ivals.push(iv)
        $sv := -1
        if i < c.env.cstr_idx.len { sv = c.env.cstr_idx[i] }
        out.const_strs.push(sv)
    }
    for i in 0:c.env.globals.len {
        out.globals.push(types.TGlobal{
            name: c.env.globals[i].name + "",
            lib: c.env.globals[i].lib + "",
            sym: c.env.globals[i].sym + "",
            ty: c.env.globals[i].ty,
            is_mut: c.env.globals[i].is_mut
        })
    }
    for i in 0:c.env.fn_sigs.len {
        out.sig_params.push(types.tp_copy_ints(&c.env.fn_sigs[i].params))
        out.sig_ret.push(c.env.fn_sigs[i].ret)
    }
    for fi in 0:c.env.fns.len {
        if fi < c.env.clos_caps.len {
            out.clos_caps.push(types.tp_copy_ints(&c.env.clos_caps[fi]))
        } else {
            out.clos_caps.push([]int{})
        }
        $m := -1
        if fi < c.env.bound_mfi.len { m = c.env.bound_mfi[fi] }
        out.bound_mfi.push(m)
    }
    out.base_type = types.tp_copy_ints(&c.env.ntype)
    out.base_local = types.tp_copy_ints(&c.env.nlocal)
    out.base_call = types.tp_copy_ints(&c.env.ncall)
    out.base_str = types.tp_copy_ints(&c.env.nstr)
    out.base_const = types.tp_copy_ints(&c.env.nconst)
    out.base_clone = types.tp_copy_ints(&c.env.nclone)
    out.base_shared = types.tp_copy_ints(&c.env.nshared)
    out.base_box = types.tp_copy_ints(&c.env.nbox)
    for fi in 0:c.env.fns.len {
        $is_inst := false
        if fi < c.env.is_inst.len && c.env.is_inst[fi] != 0 {
            is_inst = true
        }
        if is_inst && fi < c.inst_snap_ready.len && c.inst_snap_ready[fi] != 0 && fi < c.inst_snap_type.len && fi < c.inst_snap_local.len && fi < c.inst_snap_call.len && fi < c.inst_snap_str.len && fi < c.inst_snap_const.len && fi < c.inst_snap_clone.len && fi < c.inst_snap_shared.len && fi < c.inst_snap_box.len {
            out.inst_type.push(types.tp_copy_ints(&c.inst_snap_type[fi]))
            out.inst_local.push(types.tp_copy_ints(&c.inst_snap_local[fi]))
            out.inst_call.push(types.tp_copy_ints(&c.inst_snap_call[fi]))
            out.inst_str.push(types.tp_copy_ints(&c.inst_snap_str[fi]))
            out.inst_const.push(types.tp_copy_ints(&c.inst_snap_const[fi]))
            out.inst_clone.push(types.tp_copy_ints(&c.inst_snap_clone[fi]))
            out.inst_shared.push(types.tp_copy_ints(&c.inst_snap_shared[fi]))
            out.inst_box.push(types.tp_copy_ints(&c.inst_snap_box[fi]))
            out.inst_lo.push(c.inst_snap_lo[fi])
        } else {
            is_inst = false
            out.inst_type.push([]int{})
            out.inst_local.push([]int{})
            out.inst_call.push([]int{})
            out.inst_str.push([]int{})
            out.inst_const.push([]int{})
            out.inst_clone.push([]int{})
            out.inst_shared.push([]int{})
            out.inst_box.push([]int{})
            out.inst_lo.push(0)
        }
        $params := []int{}
        for j in 0:c.env.fns[fi].params.len {
            params.push(c.env.fns[fi].params[j])
        }
        $locals := []int{}
        $names := []string{}
        if fi < c.env.fnlocals.len {
            for j in 0:c.env.fnlocals[fi].len {
                locals.push(c.env.fnlocals[fi][j])
            }
        }
        if fi < c.env.fnlocal_names.len {
            for j in 0:c.env.fnlocal_names[fi].len {
                names.push(c.env.fnlocal_names[fi][j] + "")
            }
        }
        $may_throw := false
        $throw_ty := 0
        if fi < c.env.fn_may_throw.len && c.env.fn_may_throw[fi] != 0 {
            may_throw = true
            if fi < c.env.fn_throw_ty.len {
                throw_ty = c.env.fn_throw_ty[fi]
            }
        }
        $decl := -1
        if fi < c.env.fndecl.len {
            decl = c.env.fndecl[fi]
        }
        $safe_name := c.env.fns[fi].name + ""
        if fi < c.env.fn_safe_name.len { safe_name = c.env.fn_safe_name[fi] + "" }
        $safe_mod := ""
        if fi < c.env.fn_safe_mod.len { safe_mod = c.env.fn_safe_mod[fi] + "" }
        out.fns.push(types.TFn{
            name: safe_name,
            label: c.env.fns[fi].label + "",
            mod_id: safe_mod,
            ret: c.env.fns[fi].ret,
            params: params,
            recv: c.env.fns[fi].recv,
            recv_mut: c.env.fns[fi].recv_mut,
            decl: decl,
            is_extern: c.env.fns[fi].is_extern,
            is_template: c.env.fns[fi].is_template,
            is_inst: is_inst,
            variadic: c.env.fns[fi].variadic,
            may_throw: may_throw,
            throw_ty: throw_ty,
            locals: locals,
            local_names: names
        })
    }
}
