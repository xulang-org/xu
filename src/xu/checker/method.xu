        << 0
}

fn (c $&Checker) check_method_arr_resize_zero(p &parser.Parser, n int, ot int, base_ty int) int {
        if c.is_fixed_array_m(base_ty) {
            << c.fail_expr(p, n, "cannot resize_zero on a fixed-size array")
        }
        ety := c.env.arrays[types.array_index(base_ty)].elem_ty
        if !types.is_integer_type(ety) && !types.is_float_type(ety) && ety != 2 {
            << c.fail_expr(p, n, "resize_zero requires primitive scalar element type")
        }
        arg := p.nodes[n].b
        if arg < 0 || p.nodes[arg].next >= 0 {
            << c.fail_expr(p, n, "resize_zero takes exactly 1 argument")
        }
        $aty := c.check_expr(p, arg)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        aty = c.coerce_to(p, arg, aty, 1)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        if aty != 1 {
            << c.fail_expr(p, arg, "type mismatch: resize_zero arg expected int, found " + c.ty_display(aty))
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !types.is_mut_ref_type(ot) && (root < 0 || (c.env.lmut[root] == 0 && !types.is_mut_ref_type(c.env.ltype[root]))) {
            << c.fail_expr(p, n, "cannot call mut method 'resize_zero' on an immutable variable")
        }
        if root >= 0 && root < c.llength_ok.len {
            typeenv.checker_set_i($&c.llength_ok, root, 0)
        }
        c.set_ncall(n, -171) // arr.resize_zero marker
        c.set_ntype(n, 0)
        << 0
}

fn (c $&Checker) check_method_iface(p &parser.Parser, n int, ot int, base_ty int) int {
        if types.is_ref_type(ot) {
            << c.fail_expr(p, n, "cannot call methods through &struct@ (M201)")
        }
        ii := types.interface_index(base_ty)
        $found_mi := -1
        $slot := 0
        for mi in 0:c.env.im_ii.len {
            if c.env.im_ii[mi] == ii && c.env.im_name[mi] == p.nodes[n].sval {
                if found_mi < 0 {
                    found_mi = mi
                    slot = 0
                    for j in 0:mi {
                        if c.env.im_ii[j] == ii {
                            slot += 1
                        }
                    }
                }
            }
        }
        if found_mi < 0 {
            << c.fail_expr(p, n, "struct@ value has no method '" + p.nodes[n].sval + "'")
        }
        if p.nodes[n].b >= 0 {
            $argc := 0
            $arg := p.nodes[n].b
            while arg >= 0 {
                $aty := c.check_expr(p, arg)
                if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
                if argc < c.env.im_plen[found_mi] {
                    want := c.env.im_ptys[c.env.im_poff[found_mi] + argc]
                    aty = c.coerce_to(p, arg, aty, want)
                    if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
                    if aty != want {
                        << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
                    }
                    c.arg_pass(p, arg, aty, want)
                }
                argc += 1
                arg = p.nodes[arg].next
            }
            if argc != c.env.im_plen[found_mi] {
                << c.fail_expr(p, n, "method '" + p.nodes[n].sval + "' takes " + str(c.env.im_plen[found_mi]) + " argument(s)")
            }
        } else if c.env.im_plen[found_mi] != 0 {
            << c.fail_expr(p, n, "method '" + p.nodes[n].sval + "' takes " + str(c.env.im_plen[found_mi]) + " argument(s)")
        }
        c.set_ncall(n, -94) // InterfaceMethod
        c.set_nstr(n, slot)
        c.set_nlocal(n, ii)
        si23 := c.env.im_ret[found_mi]
        c.set_ntype(n, si23)
        << c.env.ntype[n]
}

fn (c $&Checker) check_method_tparam(p &parser.Parser, n int, ot int, base_ty int) int {
        k := types.param_index(base_ty)
        if k < 0 || k >= c.tp_cons.len || c.tp_cons[k] == "" {
            << c.fail_expr(p, n, "type parameter has no method '" + p.nodes[n].sval + "' (no constraint)")
        }
        $ii := -1
        $hits := 0
        for i in 0:c.env.iface_names.len {
            if c.env.iface_names[i] == c.tp_cons[k] {
                if c.env.iface_mods[i] == c.env.cur_mod {
                    ii = i
                    hits = 1
                } else {
                    if ii < 0 {
                        ii = i
                    }
                    hits = hits + 1
                }
            }
        }
        if ii < 0 || (hits > 1 && c.env.iface_mods[ii] != c.env.cur_mod) {
            << c.fail_expr(p, n, "unknown struct@ '" + c.tp_cons[k] + "'")
        }
        $found_mi := -1
        for mi in 0:c.env.im_ii.len {
            if c.env.im_ii[mi] == ii && c.env.im_name[mi] == p.nodes[n].sval {
                found_mi = mi
            }
        }
        if found_mi < 0 {
            << c.fail_expr(p, n, "struct@ '" + c.tp_cons[k] + "' has no method '" + p.nodes[n].sval + "'")
        }
        self_ty := base_ty
        $argc := 0
        $arg := p.nodes[n].b
        while arg >= 0 {
        aty := c.check_expr(p, arg)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        if argc < c.env.im_plen[found_mi] {
            want := subst_self_ty(c.env.im_ptys[c.env.im_poff[found_mi] + argc], self_ty)
            if aty != want {
                << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
            }
        }
        argc += 1
        arg = p.nodes[arg].next
        }
        if argc != c.env.im_plen[found_mi] {
            << c.fail_expr(p, n, "wrong number of arguments")
        }
        c.set_ncall(n, -72) // constraint method (M102); do not reuse -19 (str identity)
        si24 := subst_self_ty(c.env.im_ret[found_mi], self_ty)
        c.set_ntype(n, si24)
        << c.env.ntype[n]
}

fn (c $&Checker) check_method_less(p &parser.Parser, n int, ot int, base_ty int) int {
        if p.nodes[n].b < 0 || p.nodes[p.nodes[n].b].next >= 0 {
            << c.fail_expr(p, n, "less takes exactly 1 argument")
        }
        argn := p.nodes[n].b
        aty := c.check_expr(p, argn)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        if aty != base_ty {
            << c.fail_expr(p, argn, "type mismatch: expected " + c.diag_type_display(base_ty) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, argn, base_ty, aty))
        }
        if base_ty == 1 || base_ty == 4 {
            // Desugar to BinOp Lt in MIR (ncall=-70).
            c.set_ncall(n, -70)
            c.set_ntype(n, 2)
            << 2
        }
        // string → cmp.less_string(recv, other); MIR ncall=-71
        if c.find_fn_in_mod("less_string", "cmp") < 0 {
            << c.fail_expr(p, n, "string.less requires cmp.less_string")
        }
        c.set_ncall(n, -71)
        c.set_ntype(n, 2)
        << 2
}

fn (c $&Checker) check_method_special(p &parser.Parser, n int, ot int, base_ty int) int {
    if base_ty == 3 && (p.nodes[n].sval == "bytes" || p.nodes[n].sval == "runes") {
        << c.check_method_bytes_runes(p, n)
    }
    if base_ty == 3 && p.nodes[n].sval == "push_str" {
        << c.check_method_push_str(p, n, ot, base_ty)
    }
    if base_ty == 3 && p.nodes[n].sval == "push_byte" {
        << c.check_method_push_byte(p, n, ot, base_ty)
    }
    if types.is_array_type(base_ty) && p.nodes[n].sval == "push" {
        << c.check_method_arr_push(p, n, ot, base_ty)
    }
    if types.is_array_type(base_ty) && p.nodes[n].sval == "push4" {
        << c.check_method_arr_push4(p, n, ot, base_ty)
    }
    if types.is_array_type(base_ty) && p.nodes[n].sval == "reserve" {
        << c.check_method_arr_reserve(p, n, ot, base_ty)
    }
    if types.is_array_type(base_ty) && p.nodes[n].sval == "resize_zero" {
        << c.check_method_arr_resize_zero(p, n, ot, base_ty)
    }
    // M201/MS2: dynamic struct@ method dispatch (runtime via itable type_id).
    if types.is_interface_type(base_ty) {
        << c.check_method_iface(p, n, ot, base_ty)
    }
    // Constraint method on a type parameter (template definition site).
    if types.is_param_type(base_ty) {
        << c.check_method_tparam(p, n, ot, base_ty)
    }
    // M102: builtin Ord.less for int/f64/string.
    if p.nodes[n].sval == "less" && (base_ty == 1 || base_ty == 3 || base_ty == 4) {
        << c.check_method_less(p, n, ot, base_ty)
    }
    mt := c.peel_map(ot)
    if mt >= 0 {
        << c.check_method_native_map(p, n, ot, mt)
    }
    << -1 // fall through to user method
}

fn (c $&Checker) check_method_native_map(p &parser.Parser, n int, ot int, mt int) int {
    mname := p.nodes[n].sval
    wantk := c.env.maps[types.map_index(mt)].key_ty
    wantv := c.env.maps[types.map_index(mt)].val_ty
        if mname == "delete" || mname == "take" {
            if types.is_ref_type(ot) && !types.is_mut_ref_type(ot) {
                << c.fail_expr(p, n, "cannot call mut method '" + mname + "' through a shared reference")
            }
            recv2 := p.nodes[n].a
            if !types.is_mut_ref_type(ot) && p.nodes[recv2].kind == ast.NK_IDENT {
                root := c.env.nlocal[recv2]
                if root < 0 || (c.env.lmut[root] == 0 && !types.is_mut_ref_type(c.env.ltype[root])) {
                    << c.fail_expr(p, n, "cannot call mut method '" + mname + "' on immutable variable '" + p.nodes[recv2].sval + "'" + binding_mut_help(p.nodes[recv2].sval))
                }
            } else if !types.is_mut_ref_type(ot) && p.nodes[recv2].kind != ast.NK_IDENT {
                << c.fail_expr(p, n, "mut method '" + mname + "' requires a variable as receiver")
            }
        }
        if mname == "len" {
            if p.nodes[n].b >= 0 {
                << c.fail_expr(p, n, "len takes no arguments")
            }
            c.set_ncall(n, -85)
            c.set_ntype(n, 1)
            << 1
        }
        if mname == "has" {
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next >= 0 {
                << c.fail_expr(p, n, "has takes exactly 1 argument")
            }
            aty := c.check_expr(p, arg)
            if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
            if aty != wantk {
                << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            c.set_ncall(n, -84)
            c.set_ntype(n, 2)
            << 2
        }
        if mname == "delete" {
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next >= 0 {
                << c.fail_expr(p, n, "delete takes exactly 1 argument")
            }
            aty := c.check_expr(p, arg)
            if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
            if aty != wantk {
                << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            c.set_ncall(n, -86)
            c.set_ntype(n, 0)
            << 0
        }
        if mname == "take" {
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next >= 0 {
                << c.fail_expr(p, n, "take takes exactly 1 argument")
            }
            aty := c.check_expr(p, arg)
            if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
            if aty != wantk {
                << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            c.set_ncall(n, -88)
            c.set_ntype(n, wantv)
            << wantv
        }
        if mname == "get_or" {
            if c.type_owning(wantv) && wantv != 3 {
                << c.fail_expr(p, n, "get_or is not supported for owning map values; use has/take")
            }
            arg := p.nodes[n].b
            if arg < 0 || p.nodes[arg].next < 0 || p.nodes[p.nodes[arg].next].next >= 0 {
                << c.fail_expr(p, n, "get_or takes exactly 2 arguments")
            }
            aty := c.check_expr(p, arg)
            if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
            if aty != wantk {
                << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, wantk, aty))
            }
            defn := p.nodes[arg].next
            $dty := c.check_expr(p, defn)
            if types.is_error_type(dty) || c.fn_failed() { << types.ERROR_TY }
            dty = c.coerce_to(p, defn, dty, wantv)
            if types.is_error_type(dty) || c.fn_failed() { << types.ERROR_TY }
            if dty != wantv {
                << c.fail_expr(p, defn, "type mismatch: expected " + c.diag_type_display(wantv) + ", found " + c.diag_type_display(dty) + c.borrow_type_hint(p, defn, wantv, dty))
            }
            c.move_of(p, defn, dty, false)
            c.set_ncall(n, -87)
            c.set_ntype(n, wantv)
            << wantv
        }
    << c.fail_expr(p, n, "type " + c.ty_display(ot) + " has no method '" + mname + "'")
}

fn (c $&Checker) check_method_expr(p &parser.Parser, n int) int {
    q := c.check_method_qual(p, n)
    if q != -1 {
        << q
    }
    if p.nodes[n].sval == "drop" {
        c.fail_node(p, n, "resource drop is compiler-managed; use an explicit close or finish method")
        << types.ERROR_TY
    }
    // May-throw calls must use `>>> (err) { }` or `>>>` — Result.unwrap/is_ok/is_err are removed.
    $ot := c.check_expr(p, p.nodes[n].a)
    if types.is_error_type(ot) {
        c.set_ntype(n, types.ERROR_TY)
        << types.ERROR_TY
    }
    $base_ty := c.direct_type(ot)
    // Monomorphized instance: shared template AST may still carry Param
    // types on nodes; use the instance's concrete type arg for Ord.less.
    if p.nodes[n].sval == "less" && c.env.is_inst[c.env.cur_fn] != 0 {
        t0 := c.inst_elem_t0(c.env.cur_fn)
        if t0 == 1 || t0 == 3 || t0 == 4 {
            base_ty = t0
        }
    }
    // Writable builtin signatures provide the same expectation as a user
    // method. Only an explicit &*local can take permission from it.
    recv := p.nodes[n].a
    m := p.nodes[n].sval
    builtin_write := (base_ty == 3 && (m == "push_str" || m == "push_byte")) || (types.is_array_type(base_ty) && (m == "push" || m == "push4" || m == "reserve" || m == "resize_zero")) || (types.is_map_type(base_ty) && (m == "delete" || m == "take"))
    if builtin_write && p.nodes[recv].kind == ast.NK_BORROW {
        want := c.make_ref_type(true, base_ty)
        if want >= 0 { ot = c.coerce_to(p, recv, ot, want) }
    }
    s := c.check_method_special(p, n, ot, base_ty)
    if s != -1 {
        << s
    }
    $mname := ~p.nodes[n].sval
    $callsite := 0
    if types.is_struct_type(base_ty) {
        si0 := types.struct_index(base_ty)
        if c.env.structs[si0].mod_id == "log" && c.env.structs[si0].name == "Logger" {
            if mname == "println" {
                mname = "println_at"
                callsite = 1
            } else if mname == "print" {
                mname = "print_at"
                callsite = 1
            } else if mname == "printf" {
                mname = "printf_at"
                callsite = 1
            } else if mname == "fatal" {
                mname = "fatal_at"
                callsite = 1
            }
        }
    }
    $fi := c.find_method(base_ty, mname)
    if fi < 0 {
        << c.fail_expr(p, n, "type " + c.ty_display(ot) + " has no method '" + p.nodes[n].sval + "'")
    }
    // Instantiate generic struct methods with the receiver's origin args.
    if c.env.fns[fi].is_template {
        if !types.is_struct_type(base_ty) {
            << c.fail_expr(p, n, "type " + c.ty_display(ot) + " has no method '" + p.nodes[n].sval + "'")
        }
        si := types.struct_index(base_ty)
        c.load_targs_sargs(si)
        c.ffi_call_check(p, n, fi)
        fi = c.instantiate_fn_n(p, fi, n)
        if fi < 0 { << types.ERROR_TY }
    } else {
        c.ffi_call_check(p, n, fi)
    }
    if c.env.fns[fi].recv_mut {
        recv2 := p.nodes[n].a
        if p.nodes[recv2].kind == ast.NK_BORROW {
            ot = c.coerce_to(p, recv2, ot, c.env.fns[fi].recv)
            if types.is_error_type(ot) || c.fn_failed() { << types.ERROR_TY }
        }
        root_g := c.expr_global_root(p, recv2)
        if root_g >= 0 {
            c.check_global_write(p, n, root_g)
            if c.fn_failed() { << types.ERROR_TY }
        }
        allowed := types.is_mut_ref_type(ot) || (p.nodes[recv2].kind == ast.NK_IDENT && c.env.nlocal[recv2] >= 0 && c.env.lmut[c.env.nlocal[recv2]] != 0) ||
            (c.env.unsafe_depth > 0 && c.place_raw_deref_root(p, recv2)) ||
            (root_g >= 0 && c.env.unsafe_depth > 0 && c.env.globals[root_g].is_mut)
        if !allowed && root_g < 0 {
            if types.is_ref_type(ot) && !types.is_mut_ref_type(ot) {
                << c.fail_expr(p, n, "cannot call mut method '" + p.nodes[n].sval + "' through a shared reference")
            }
            if p.nodes[recv2].kind == ast.NK_IDENT {
                << c.fail_expr(p, n, "cannot call mut method '" + p.nodes[n].sval + "' on immutable variable '" + p.nodes[recv2].sval + "'" + binding_mut_help(p.nodes[recv2].sval))
            }
            << c.fail_expr(p, n, "mut method '" + p.nodes[n].sval + "' requires a variable as receiver")
        }
    }
    $argc := 0
    $arg := p.nodes[n].b
    $fixed := c.env.fns[fi].params.len
    $variadic := c.env.fns[fi].variadic
    $elem := -1
    if variadic {
        fixed = c.env.fns[fi].params.len - 1
        elem = c.fn_variadic_elem(fi)
    }
    // M170: virtual file/line args for log *at rewrite.
    $virt := 0
    if callsite == 1 {
        virt = 2
        if fixed < 2 {
            << c.fail_expr(p, n, "internal: callsite rewrite needs file/line params")
        }
    }
    while arg >= 0 {
    $aty := c.check_expr(p, arg)
    if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
    $want := -1
    idx := argc + virt
    if idx < fixed {
        want = c.env.fns[fi].params[idx]
    } else if variadic {
        want = elem
    }
    if want >= 0 {
        aty = c.coerce_to(p, arg, aty, want)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
    }
    if want >= 0 && aty != want {
        << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
    }
    c.arg_pass(p, arg, aty, want)
    argc += 1
    arg = p.nodes[arg].next
    }
    if variadic {
        if argc + virt < fixed {
            << c.fail_expr(p, n, "method '" + p.nodes[n].sval + "' takes at least " + str(fixed - virt) + " argument(s), found " + str(argc))
        }
    } else {
        if argc + virt != c.env.fns[fi].params.len {
            << c.fail_expr(p, n, "wrong number of arguments")
        }
    }
    c.set_ncall(n, fi)
    c.set_ncsite(n, callsite)
    if callsite == 1 {
        si25 := c.intern(c.env.cur_file_name)
        c.set_nstr(n, si25)
        c.set_nlocal(n, p.nodes[n].line)
    }
    c.record_call(fi)
    ty := c.env.fns[fi].ret
    << c.wrap_throwable_call_result(p, n, fi, ty)
}

// M184: field / module.const / enum.tag — split from check_expr (W3).
fn (c $&Checker) check_mod_fn_value(p &parser.Parser, n int, mod_id string, fi int) int {
    if mod_id != c.env.cur_mod && !c.env.fns[fi].is_pub {
        << c.fail_expr(p, n, "'" + p.nodes[n].sval + "' is private")
    }
    if c.env.fns[fi].is_template {
        << c.fail_expr(p, n, "cannot take value of generic function (instantiate via a call)")
    }
    if c.env.fns[fi].is_extern {
        << c.fail_expr(p, n, "native function values require a Xu wrapper; invoke the native function directly")
    }
    ff := c.ffi_label_flags(&c.env.fns[fi].label)
    if ff >= 0 && (ff & ast.FFI_UNSAFE_FN) != 0 {
        << c.fail_expr(p, n, "unsafe function values require a safe Xu wrapper; invoke the unsafe function inside an unsafe { } block")
    }
    c.set_ncall(n, fi)
    $params := []int{}
    for pi in 0:c.env.fns[fi].params.len { params.push(c.env.fns[fi].params[pi]) }
    ty := c.intern_fn_sig(params, c.env.fns[fi].ret)
    c.set_ntype(n, ty)
    << ty
}

fn (c $&Checker) check_mod_member_value(p &parser.Parser, n int, mod_id string) int {
    if !c.module_visible(~mod_id) {
        << c.fail_expr(p, n, "module " + mod_id + " not imported")
    }
    ci := c.find_const_in_mod(p.nodes[n].sval, ~mod_id)
    if ci >= 0 {
        if mod_id != c.env.cur_mod && c.env.cpubs[ci] == 0 {
            << c.fail_expr(p, n, "'" + p.nodes[n].sval + "' is private")
        }
        c.set_nconst(n, ci)
        ty := c.env.ctypes[ci]
        c.set_ntype(n, ty)
        if ty == 3 {
            si26 := c.env.cstr_idx[ci]
            c.set_nstr(n, si26)
        }
        << ty
    }
    fi := c.find_fn_in_mod(p.nodes[n].sval, ~mod_id)
    if fi >= 0 {
        << c.check_mod_fn_value(p, n, ~mod_id, fi)
    }
    gi := c.find_global_in_mod(p.nodes[n].sval, ~mod_id)
    if gi >= 0 {
        if mod_id != c.env.cur_mod && !c.env.globals[gi].is_pub {
            << c.fail_expr(p, n, "'" + p.nodes[n].sval + "' is private")
        }
        if c.env.unsafe_depth == 0 {
            $kind_s := "extern \"C\" global"
            if c.env.globals[gi].is_bss { kind_s = "static variable" }
            << c.fail_expr(p, n, "accessing " + kind_s + " '" + mod_id + "." + p.nodes[n].sval + "' requires an unsafe block")
        }
        c.set_nconst(n, -1000 - gi)
        gty := c.env.globals[gi].ty
        c.set_ntype(n, gty)
        << gty
    }
    << -1
}

fn (c $&Checker) check_field_expr(p &parser.Parser, n int) int {
    recv := p.nodes[n].a
    if p.nodes[recv].kind == ast.NK_FIELD {
        ety := c.try_enum_ctor(p, n, -1)
        if ety >= 0 { << ety }
    }
    if p.nodes[recv].kind == ast.NK_IDENT && p.nodes[recv].a >= 0 {
        ety := c.try_enum_ctor(p, n, -1)
        if ety >= 0 {
            << ety
        }
    }
    if p.nodes[recv].kind == ast.NK_IDENT {
            lid := c.find_local(p.nodes[recv].sval)
            if lid < 0 {
                // Re-read recv.sval each time (string locals move on use).
                $real := ~p.nodes[recv].sval
                if !c.module_exists(~real) {
                    real = c.alias_of(real)
                }
                if !c.module_exists(~real) {
                    qm := c.qual_to_mod(~p.nodes[recv].sval)
                    if qm.len > 0 {
                        real = ~qm
                    }
                }
                if c.module_exists(~real) {
                    mty := c.check_mod_member_value(p, n, ~real)
                    if mty >= 0 { << mty }
                    << c.fail_expr(p, n, "undefined name '" + real + "." + p.nodes[n].sval + "'")
                }
                ety := c.try_enum_ctor(p, n, -1)
                if ety >= 0 {
                    << ety
                }
            }
        }
        if p.nodes[recv].kind == ast.NK_FIELD {
            // M18 dotted module member: a.b.CONST / a.b.fn / a.b.global.
            rpath := c.chain_path(p, recv)
            $m2 := c.longest_module(~rpath)
            $pre := m2.len
            if m2 == "" {
                a2 := c.longest_alias(~rpath)
                if a2.len > 0 {
                    pre = a2.len
                    m2 = c.alias_of(~a2)
                }
            }
            if m2 != "" && pre == rpath.len {
                if c.find_local(c.chain_root(p, recv)) < 0 {
                    mty := c.check_mod_member_value(p, n, ~m2)
                    if mty >= 0 { << mty }
                    << c.fail_expr(p, n, "undefined name '" + m2 + "." + p.nodes[n].sval + "'")
                }
            }
        }
        ot := c.check_expr(p, p.nodes[n].a)
        if types.is_error_type(ot) || c.fn_failed() {
            c.set_ntype(n, types.ERROR_TY)
            << types.ERROR_TY
        }
        oa := p.nodes[n].a
        if oa >= 0 && p.nodes[oa].kind == ast.NK_INDEX && oa < c.env.ncall.len && c.env.ncall[oa] == -77 {
            if ot != 3 && c.type_owning(ot) {
                << c.fail_expr(p, n, "cannot move an owning map value by index; borrow it or take it")
            }
        }
        base_ty := c.direct_type(ot)
        if base_ty == 3 && p.nodes[n].sval == "len" { // string .len
            c.set_ntype(n, 1)
            << 1
        }
        if types.is_array_type(base_ty) {
            // arr.len returns int. MIR field offsets are bytes.
            if p.nodes[n].sval == "len" {
                fl := c.array_fixed_len_m(base_ty)
                if fl > 0 {
                    // Fold to a compile-time constant (nlocal = length).
                    c.set_ncall(n, -96)
                    c.set_nlocal(n, fl)
                    c.set_ntype(n, 1)
                    << 1
                }
                c.set_nlocal(n, 8)
                c.set_ntype(n, 1)
                << 1
            }
            << c.fail_expr(p, n, "array has no field '" + p.nodes[n].sval + "'")
        }
        if types.is_struct_type(base_ty) {
            si := types.struct_index(base_ty)
            fi := c.find_field(si, p.nodes[n].sval)
            if fi < 0 {
                // M110: `obj.method` in value position → method value.
                << c.check_method_value(p, n, base_ty, ot)
            }
            c.require_field_visible(p, n, si, fi)
            c.set_nlocal(n, fi) // record the field index for mir/emit
            obj := p.nodes[n].a
            if p.nodes[obj].kind == ast.NK_IDENT {
                rid := c.env.nlocal[obj]
                c.check_field_not_moved(p, rid, fi, p.nodes[n].a)
            }
            pth := c.as_place_path(p, n)
            rid2 := c.as_top_field_id(p, n)
            if rid2 >= 0 && pth >= 64 {
                c.check_path_not_moved(p, rid2, pth, n)
            }
            fty := c.env.structs[si].fields[fi].ty
            c.set_ntype(n, fty)
            << fty
        }
        << c.fail_expr(p, n, "type has no fields")
}
