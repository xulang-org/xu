@xu/checker

#xu/ast
#xu/parser
#xu/typeenv
#xu/types

// Enum construction: `Color.Red` / `Opt#int.Some(5)` / inferred `Opt.Some(5)`.
// `n` is the Field or MethodCall node. Returns type tag, or -1 if not a ctor.
fn (c $&Checker) try_enum_ctor(p &parser.Parser, n int, args_head int) int {
    recv := p.nodes[n].a
    qualified := p.nodes[recv].kind == ast.NK_FIELD
    if p.nodes[recv].kind != ast.NK_IDENT && !qualified { << -1 }
    $enum_mod := ~c.env.cur_mod
    $enum_name := ~p.nodes[recv].sval
    if qualified {
        if c.find_local(c.chain_root(p, recv)) >= 0 { << -1 }
        spelling := c.chain_path(p, recv)
        enum_mod = c.enum_qualifier_module(~spelling)
        if enum_mod.len == 0 { << -1 }
        enum_name = local_after_dot(~spelling, last_dot(~spelling))
    }
    has_targs := !qualified && p.nodes[recv].a >= 0
    if !has_targs {
        if c.find_local(p.nodes[recv].sval) >= 0 {
            << -1
        }
    }
    $ei := -1
    if has_targs {
        c.collect_type_list_n(p, p.nodes[recv].a)
        if c.find_etpl(p.nodes[recv].sval, c.env.cur_mod) < 0 {
            if c.find_enum_in_mod(p.nodes[recv].sval, c.env.cur_mod) >= 0 {
                << c.fail_expr(p, n, "enum '" + p.nodes[recv].sval + "' is not generic")
            }
            << -1
        }
        ei = c.instantiate_enum(p, recv)
        if ei < 0 { << types.ERROR_TY }
    } else {
        ei = c.find_enum_in_mod(~enum_name, ~enum_mod)
        if ei < 0 {
            if qualified { << -1 }
            ti := c.find_etpl(p.nodes[recv].sval, c.env.cur_mod)
            if ti < 0 {
                << -1
            }
            ei = c.infer_enum_ctor(p, n, ti, args_head)
            if ei < 0 { << types.ERROR_TY }
        }
    }
    if qualified {
        if !c.module_visible(~enum_mod) { << c.fail_expr(p, n, "module " + enum_mod + " not imported") }
        if enum_mod != c.env.cur_mod && !c.env.enums[ei].is_pub { << c.fail_expr(p, n, "'" + enum_name + "' is private") }
    }
    $vidx := -1
    for i in 0:c.env.enums[ei].variants.len {
        if c.env.enums[ei].variants[i].name == p.nodes[n].sval {
            vidx = i
        }
    }
    if vidx < 0 {
        << c.fail_expr(p, n, "enum '" + c.env.enums[ei].name + "' has no variant '" + p.nodes[n].sval + "'")
    }
    nfields := c.env.enums[ei].variants[vidx].fields.len
    $argc := 0
    $arg := args_head
    while arg >= 0 {
        $aty := c.check_expr(p, arg)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        if argc < nfields {
            want := c.env.enums[ei].variants[vidx].fields[argc]
            aty = c.coerce_to(p, arg, aty, want)
            if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
            if aty != want {
                << c.fail_expr(p, arg, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(aty) + c.borrow_type_hint(p, arg, want, aty))
            }
            c.move_of(p, arg, aty, false)
        }
        argc += 1
        arg = p.nodes[arg].next
    }
    if argc != nfields {
        << c.fail_expr(p, n, "variant '" + c.enum_pattern_name(ei) + "." + p.nodes[n].sval + "' expects " + str(nfields) + " argument(s), found " + str(argc))
    }
    c.set_ncall(n, -30)
    c.set_nlocal(n, vidx)
    ty := types.enum_type(ei)
    c.set_ntype(n, ty)
    << ty
}

fn (c $&Checker) infer_enum_ctor(p &parser.Parser, n int, ti int, args_head int) int {
    d := c.etpl_decl[ti]
    vname := ~p.nodes[n].sval
    tname := ~c.etpl_name[ti]
    $found := -1
    $v := p.nodes[d].a
    while v >= 0 {
        if p.nodes[v].sval == vname {
            found = v
        }
        v = p.nodes[v].next
    }
    if found < 0 {
        c.fail_node(p, n, "enum '" + tname + "' has no variant '" + vname + "'")
        << -1
    }
    $nfields := 0
    $ft := p.nodes[found].a
    while ft >= 0 {
        nfields += 1
        ft = p.nodes[ft].next
    }
    $argc := 0
    $arg := args_head
    while arg >= 0 {
        argc += 1
        arg = p.nodes[arg].next
    }
    if argc != nfields {
        c.fail_node(p, n, "variant '" + tname + "." + vname + "' expects " + str(nfields) + " argument(s), found " + str(argc))
        << -1
    }
    if argc == 0 {
        c.fail_node(p, n, "generic enum '" + tname + "' requires type arguments")
        << -1
    }
    $pnames := []string{}
    $tp := p.nodes[d].e
    while tp >= 0 {
        pnames.push(p.nodes[tp].sval)
        tp = p.nodes[tp].next
    }
    $binds := []int{}
    for i in 0:pnames.len {
        binds.push(-1)
    }
    arg = args_head
    ft = p.nodes[found].a
    while arg >= 0 {
        aty := c.check_expr(p, arg)
        if types.is_error_type(aty) || c.fn_failed() { << -1 }
        if p.nodes[ft].kind == ast.NT_NAMED && p.nodes[ft].a < 0 {
            for k in 0:pnames.len {
                if p.nodes[ft].sval == pnames[k] {
                    if binds[k] < 0 {
                        binds[k] = aty
                    }
                }
            }
        }
        arg = p.nodes[arg].next
        ft = p.nodes[ft].next
    }
    for k in 0:binds.len {
        if binds[k] < 0 {
            c.fail_node(p, n, "cannot infer type parameter '" + pnames[k] + "' for enum '" + tname + "'")
            << -1
        }
    }
    c.load_targs(&binds, binds.len)
    << c.instantiate_enum(p, p.nodes[n].a)
}

fn (c $&Checker) check_method_qual(p &parser.Parser, n int) int {
    recv := p.nodes[n].a
    if p.nodes[recv].kind == ast.NK_IDENT && p.nodes[recv].a >= 0 {
        ety := c.try_enum_ctor(p, n, p.nodes[n].b)
        if ety >= 0 {
            << ety
        }
    }
    if p.nodes[recv].kind == ast.NK_IDENT {
        lid := c.find_local(p.nodes[recv].sval)
        if lid < 0 {
            $real2 := ~p.nodes[recv].sval
            if !c.module_exists(~real2) {
                real2 = c.alias_of(~real2)
            }
            if !c.module_exists(~real2) {
                qm := c.qual_to_mod(~p.nodes[recv].sval)
                if qm.len > 0 {
                    real2 = ~qm
                }
            }
            if c.module_exists(~real2) {
                << c.check_module_call(p, n, real2)
            }
            ety := c.try_enum_ctor(p, n, p.nodes[n].b)
            if ety >= 0 {
                << ety
            }
        }
    }
    if p.nodes[recv].kind == ast.NK_FIELD {
        ety := c.try_enum_ctor(p, n, p.nodes[n].b)
        if ety >= 0 { << ety }
        // M18 dotted module call: strings.fn(...) — the full chain
        // must carry a registered module as a strict prefix, and the
        // root ident must not shadow a local.
        full := c.chain_path(p, n)
        $m2 := c.longest_module(~full)
        $pre := m2.len
        if m2 == "" {
            a2 := c.longest_alias(~full)
            if a2.len > 0 {
                pre = a2.len
                m2 = c.alias_of(~a2)
            }
        }
        if m2 == "" {
            hold := ~full
            fd := first_dot(~hold)
            if fd > 0 {
                head := local_before_dot(~hold, fd)
                m2 = c.qual_to_mod(~head)
                if m2.len > 0 {
                    pre = fd
                }
            } else {
                m2 = c.qual_to_mod(~hold)
                if m2.len > 0 {
                    pre = hold.len
                }
            }
        }
        if m2 != "" && full.len > pre && full[pre] == 46 && c.find_local(c.chain_root(p, recv)) < 0 {
            << c.check_module_call(p, n, m2)
        }
    }
    << -1 // not a qualified / enum ctor call
}

// Wave C: push/iface/constraint/Ord.less specials (W3).
fn (c $&Checker) check_method_bytes_runes(p &parser.Parser, n int) int {
    abi_syntax := ~p.nodes[n].sval
    if c.require_runtime_abi(p, n, types.runtime_abi_syntax_id(&abi_syntax)) < 0 { << types.ERROR_TY }
    if p.nodes[n].b >= 0 {
        << c.fail_expr(p, n, p.nodes[n].sval + " takes no arguments")
    }
    if p.nodes[n].sval == "bytes" {
        c.set_ncall(n, -75)
    } else {
        c.set_ncall(n, -76)
    }
    si22 := c.intern_array_type(1)
    c.set_ntype(n, si22)
    << c.env.ntype[n]
}

fn (c $&Checker) check_method_push_str(p &parser.Parser, n int, ot int, base_ty int) int {
        arg := p.nodes[n].b
        if arg < 0 || p.nodes[arg].next >= 0 {
            << c.fail_expr(p, n, "push_str takes exactly 1 argument")
        }
        aty := c.check_expr(p, arg)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        if aty != 3 {
            << c.fail_expr(p, arg, "type mismatch: expected string, found " + c.diag_type_display(aty))
        }
        // Bootstrap accepts only a bare variable (or a `$&string` receiver):
        // the descriptor write-back targets a local slot. Field receivers
        // compiled silently before — reject them like bootstrap does.
        if !types.is_mut_ref_type(ot) && p.nodes[p.nodes[n].a].kind != ast.NK_IDENT {
            << c.fail_expr(p, n, "push_str requires a variable or \$&string receiver")
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !types.is_mut_ref_type(ot) && (root < 0 || (c.env.lmut[root] == 0 && !types.is_mut_ref_type(c.env.ltype[root]))) {
            if root >= 0 && p.nodes[p.nodes[n].a].kind == ast.NK_IDENT {
                << c.fail_expr(p, n, "cannot call mut method 'push_str' on immutable variable '" + c.env.lname[root] + "'" + binding_mut_help(c.env.lname[root]))
            } else {
                << c.fail_expr(p, n, "push_str requires a mutable receiver")
            }
        }
        c.set_ncall(n, -3)
        c.set_ntype(n, 0)
        << 0
}

