}

fn (c $&Checker) check_method_arr_push(p &parser.Parser, n int, ot int, base_ty int) int {
        if c.is_fixed_array_m(base_ty) {
            << c.fail_expr(p, n, "cannot push onto a fixed-size array")
        }
        arg := p.nodes[n].b
        if arg < 0 || p.nodes[arg].next >= 0 {
            << c.fail_expr(p, n, "push takes exactly 1 argument")
        }
        ai := types.array_index(base_ty)
        $aty := c.check_expr(p, arg)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        aty = c.coerce_to(p, arg, aty, c.env.arrays[ai].elem_ty)
        if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
        if aty != c.env.arrays[ai].elem_ty {
            << c.fail_expr(p, arg, "type mismatch: push arg expected " + c.ty_display(c.env.arrays[ai].elem_ty) + ", found " + c.ty_display(aty))
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !types.is_mut_ref_type(ot) && (root < 0 || (c.env.lmut[root] == 0 && !types.is_mut_ref_type(c.env.ltype[root]))) {
            << c.fail_expr(p, n, "cannot call mut method 'push' on an immutable variable")
        }
        // M36 v1: push changes the length — drop the tracked length.
        if root >= 0 && root < c.llength_ok.len {
            typeenv.checker_set_i($&c.llength_ok, root, 0)
        }
        if root >= 0 && root < c.lrefok.len && c.type_contains_ref(aty) {
            typeenv.checker_set_i($&c.lrefok, root, 0)
        }
        c.move_of(p, arg, aty, false)
        c.set_ncall(n, -4) // arr.push marker
        c.set_ntype(n, 0)
        << 0
}

fn (c $&Checker) check_method_arr_push4(p &parser.Parser, n int, ot int, base_ty int) int {
        if c.is_fixed_array_m(base_ty) {
            << c.fail_expr(p, n, "cannot push onto a fixed-size array")
        }
        // Four int appends in one grow (Gen1 emit32 / []int hot path).
        if c.env.arrays[types.array_index(base_ty)].elem_ty != 1 {
            << c.fail_expr(p, n, "push4 requires []int")
        }
        $arg := p.nodes[n].b
        $argc := 0
        while arg >= 0 {
            argc += 1
            $aty := c.check_expr(p, arg)
            if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
            aty = c.coerce_to(p, arg, aty, 1)
            if types.is_error_type(aty) || c.fn_failed() { << types.ERROR_TY }
            if aty != 1 {
                << c.fail_expr(p, arg, "type mismatch: push4 args must be int")
            }
            c.move_of(p, arg, aty, false)
            arg = p.nodes[arg].next
        }
        if argc != 4 {
            << c.fail_expr(p, n, "push4 takes exactly 4 arguments")
        }
        root := c.borrow_root_local(p, p.nodes[n].a)
        if !types.is_mut_ref_type(ot) && (root < 0 || (c.env.lmut[root] == 0 && !types.is_mut_ref_type(c.env.ltype[root]))) {
            << c.fail_expr(p, n, "cannot call mut method 'push4' on an immutable variable")
        }
        if root >= 0 && root < c.llength_ok.len {
            typeenv.checker_set_i($&c.llength_ok, root, 0)
        }
        if root >= 0 && root < c.lrefok.len {
            typeenv.checker_set_i($&c.lrefok, root, 0)
        }
        c.set_ncall(n, -51)
        c.set_ntype(n, 0)
        << 0
}

