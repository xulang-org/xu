// --- @xu/borrow ---

fn (c $&Checker) borrow_check_fn(p &parser.Parser, d int) { borrow.borrow_check_fn($&c.env, p, d) }

fn (c &Checker) borrow_target(p &parser.Parser, n int) int { << borrow.borrow_target(&c.env, p, n) }

fn (c &Checker) borrow_root_local(p &parser.Parser, n int) int { << borrow.borrow_root_local(&c.env, p, n) }

// A field/index place whose root is `*ptr` with ptr a raw pointer, e.g.
// `(*st).lock` or `(*st).a.b`. Node types must already be checked.
fn (c &Checker) place_raw_deref_root(p &parser.Parser, n int) bool {
    $cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_UN_OP && p.nodes[cur].ival == ast.UN_DEREF {
            inner := p.nodes[cur].a
            << inner >= 0 && inner < c.env.ntype.len && types.is_raw_ptr_type(c.env.ntype[inner])
        }
        if k == ast.NK_FIELD || k == ast.NK_INDEX {
            cur = p.nodes[cur].a
        } else {
            << false
        }
    }
    << false
}

fn (c &Checker) place_has_index(p &parser.Parser, n int) bool { << borrow.place_has_index(p, n) }

fn (c &Checker) borrow_chain_is_map(p &parser.Parser, n int) bool { << borrow.borrow_chain_is_map(&c.env, p, n) }

