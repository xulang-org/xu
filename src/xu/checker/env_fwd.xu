fn (c $&Checker) ffi_check_decls(p &parser.Parser) {
    ffi.ffi_check_structs($&c.env, p)
    $init_gis := []int{}
    $init_decls := []int{}
    for i in 0:p.ffi_nodes.len {
        f := p.ffi_nodes[i]
        if (p.nodes[f].ival & ast.FFI_GLOBAL) != 0 {
            d := p.nodes[f].a
            mod_id := p.nodes[d].sval2 + ""
            name := p.nodes[d].sval + ""
            saved_mod := c.env.cur_mod + ""
            c.env.cur_mod = mod_id + ""
            c.set_cur_file(p, c.decl_file_id(p, d))
            if (p.nodes[f].ival & ast.FFI_BSS) != 0 {
                if c.find_fn_in_mod(name + "", mod_id + "") >= 0 {
                    c.fail_node(p, d, "static variable '" + name + "' conflicts with function '" + name + "'")
                }
                if c.find_const_in_mod(name + "", mod_id + "") >= 0 {
                    c.fail_node(p, d, "static variable '" + name + "' conflicts with const '" + name + "'")
                }
            }
            $al := p.nodes[f].c
            if (p.nodes[f].ival & ast.FFI_ALIGNED) != 0 && al <= 0 && p.nodes[f].d >= 0 {
                cv := c.eval_const_expr(p, p.nodes[f].d)
                if cv.ok && cv.ty == 1 {
                    al = cv.ival
                } else {
                    al = -1
                }
            }
            gty := c.type_of(p, p.nodes[d].a)
            has_init := p.nodes[d].b >= 0
            c.env.cur_mod = saved_mod
            gi := ffi.ffi_register_global($&c.env, p, f, d, gty, al, has_init)
            if gi >= 0 && has_init && c.env.target_os == 3 {
                init_gis.push(gi)
                init_decls.push(d)
            }
        }
    }
    for k in 0:init_gis.len {
        gi := init_gis[k]
        d := init_decls[k]
        saved_mod := c.env.cur_mod + ""
        c.env.cur_mod = c.env.globals[gi].mod_id + ""
        c.set_cur_file(p, c.decl_file_id(p, d))
        c.eval_static_init_global(p, d, gi)
        c.env.cur_mod = saved_mod
    }
    ffi.ffi_check_extern_fns($&c.env, p)
}

fn (c $&Checker) check_call_c_callback(p &parser.Parser, n int) int {
    arg := p.nodes[n].a
    if arg < 0 || p.nodes[arg].next >= 0 {
        c.fail_node(p, n, "c_callback takes exactly 1 argument")
        << 6
    }
    t := c.check_expr(p, arg)
    << ffi.check_call_c_callback_with_ty($&c.env, p, n, arg, t)
}

fn (c $&Checker) check_call_c_callback_free(p &parser.Parser, n int) int {
    if c.env.cur_mod != "ffi" {
        c.fail_node(p, n, "c_callback_free is only available through ffi.callback_free")
        << 0
    }
    arg := p.nodes[n].a
    if arg < 0 || p.nodes[arg].next >= 0 {
        c.fail_node(p, n, "c_callback_free takes exactly 1 argument")
        << 0
    }
    t := c.check_expr(p, arg)
    << ffi.check_call_c_callback_free_with_ty($&c.env, p, n, arg, t)
}
