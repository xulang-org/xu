fn (c $&Checker) validate_resource_drops(p &parser.Parser) { borrow.validate_resource_drops($&c.env, p) }

fn (c &Checker) zero_requires_resource_constructor(ty int) bool { << borrow.zero_requires_resource_constructor(&c.env, ty) }

