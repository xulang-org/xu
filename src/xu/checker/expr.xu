@xu/checker

#xu/ast
#xu/parser
#xu/types

fn (c $&Checker) check_binop_expr(p &parser.Parser, n int) int {
    op := p.nodes[n].ival
    $lt := c.check_expr(p, p.nodes[n].a)
    $rt := 0
    if op == 12 || op == 13 {
        $lids := []int{}
        if op == 12 {
            c.collect_then_nonzero(p, p.nodes[n].a, $&lids)
        } else {
            $dummy_recvs := []int{}
            $dummy_names := []string{}
            c.collect_guard_nonzero(p, p.nodes[n].a, $&lids, $&dummy_recvs, $&dummy_names)
        }
        had := c.push_nonzero_list(&lids)
        rt = c.check_expr(p, p.nodes[n].b)
        c.pop_nonzero_list(&lids, &had)
    } else {
        rt = c.check_expr(p, p.nodes[n].b)
    }
    if types.is_error_type(lt) || types.is_error_type(rt) {
        c.set_ntype(n, types.ERROR_TY)
        << types.ERROR_TY
    }
    if types.is_integer_type(lt) && lt != rt {
        rt = c.coerce_to(p, p.nodes[n].b, rt, lt)
    }
    if types.is_integer_type(rt) && lt != rt {
        lt = c.coerce_to(p, p.nodes[n].a, lt, rt)
    }
    if lt == 14 && rt == 4 {
        rt = c.coerce_to(p, p.nodes[n].b, rt, lt)
    }
    if rt == 14 && lt == 4 {
        lt = c.coerce_to(p, p.nodes[n].a, lt, rt)
    }
    // string + : heap concat. L2c-amp: `+` also accepts `&string` on
    // either side (or both); mir reads the borrow through at concat
    // time, so the result type is the owned string.
    lstr := lt == 3 || (types.is_ref_type(lt) && c.ref_inner_type(lt) == 3)
    rstr := rt == 3 || (types.is_ref_type(rt) && c.ref_inner_type(rt) == 3)
    if op == 1 && lstr && rstr {
        if c.env.in_irq == 1 {
            c.fail_node(p, n, "cannot allocate in irq handler")
        }
        c.set_ntype(n, 3)
        << 3
    }
    if op >= 1 && op <= 4 { // + - * / : int family or f64 (matched)
        if types.is_integer_type(lt) && lt == rt {
            if op == 4 {
                c.check_int_div(p, n, p.nodes[n].a, p.nodes[n].b)
            }
            c.set_ntype(n, lt)
            << lt
        }
        if types.is_float_type(lt) && lt == rt {
            c.set_ntype(n, lt)
            << lt
        }
        if op == 1 {
            << c.fail_expr(p, n, "operator '+' requires int, f64, or string operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        << c.fail_expr(p, n, "arithmetic requires matching int or f64 operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
    }
    if op == 5 { // % integer family
        if !types.is_integer_type(lt) || lt != rt {
            << c.fail_expr(p, n, "arithmetic/bitwise requires int operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        c.check_int_div(p, n, p.nodes[n].a, p.nodes[n].b)
        c.set_ntype(n, lt)
        << lt
    }
    if op >= 6 && op <= 7 { // == !=
        eqok := (types.is_integer_type(lt) && lt == rt) || (lt == 2 && rt == 2) || (lt == 3 && rt == 3) || (types.is_float_type(lt) && lt == rt) || (lt == 6 && rt == 6) || (types.is_raw_ptr_type(lt) && lt == rt)
        if !eqok {
            << c.fail_expr(p, n, "cannot compare " + c.ty_display(lt) + " with " + c.ty_display(rt))
        }
        c.set_ntype(n, 2)
        << 2
    }
    if op <= 11 { // < <= > >=
        if !(types.is_integer_type(lt) && lt == rt) && !(types.is_float_type(lt) && lt == rt) && !(types.is_raw_ptr_type(lt) && lt == rt) {
            << c.fail_expr(p, n, "comparison requires matching int or f64 operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        c.set_ntype(n, 2)
        << 2
    }
    if op <= 13 { // && ||
        if lt != 2 || rt != 2 {
            << c.fail_expr(p, n, "logical operator requires bool operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
        }
        c.set_ntype(n, 2)
        << 2
    }
    // bitwise: matching integer family
    if !types.is_integer_type(lt) || lt != rt {
        << c.fail_expr(p, n, "arithmetic/bitwise requires int operands, found " + c.ty_display(lt) + " and " + c.ty_display(rt))
    }
    c.set_ntype(n, lt)
    << lt
}

fn (c $&Checker) check_struct_init_expr(p &parser.Parser, n int) int {
    $si := c.find_struct_in_mod(c.named_local_of(p, n), c.named_mod_of(p, n))
    if c.named_mod_of(p, n) != c.env.cur_mod {
        if !c.module_visible(c.named_mod_of(p, n)) {
            << c.fail_expr(p, n, "module " + c.named_mod_of(p, n) + " not imported")
        }
    }
    // Generic: Box<int>{...} via explicit type args (node.b).
    if p.nodes[n].b >= 0 {
        c.collect_type_list_n(p, p.nodes[n].b)
        si = c.instantiate_struct(p, n)
        if si < 0 {
            c.set_ntype(n, types.ERROR_TY)
            << types.ERROR_TY
        }
    } else if si < 0 {
        if c.find_stpl(c.named_local_of(p, n), c.named_mod_of(p, n)) >= 0 {
            << c.fail_expr(p, n, "generic struct '" + p.nodes[n].sval + "' requires type arguments")
        }
        << c.fail_expr(p, n, "unknown struct '" + p.nodes[n].sval + "'")
    }
    if c.named_mod_of(p, n) != c.env.cur_mod && !c.env.structs[si].is_pub {
        << c.fail_expr(p, n, "'" + c.named_local_of(p, n) + "' is private")
    }
    cross := c.env.structs[si].mod_id != c.env.cur_mod
    $seen := []bool{}
    for i in 0:c.env.structs[si].fields.len {
        seen.push(false)
    }
    $sf := p.nodes[n].a
    $n_init := 0
    while sf >= 0 {
    if p.nodes[sf].kind != ast.NK_S_FIELD {
        << c.fail_expr(p, sf, "malformed struct init field")
    }
    n_init += 1
    fi := c.find_field(si, p.nodes[sf].sval)
    if fi < 0 {
        << c.fail_expr(p, sf, "struct '" + p.nodes[n].sval + "' has no field '" + p.nodes[sf].sval + "'")
    }
    if cross {
        c.require_field_visible(p, sf, si, fi)
        if c.fn_failed() { << types.ERROR_TY }
    }
    if seen[fi] {
        << c.fail_expr(p, sf, "duplicate field '" + p.nodes[sf].sval + "' in struct init")
    }
    seen[fi] = true
    $fty := c.check_expr(p, p.nodes[sf].a)
    if types.is_error_type(fty) || c.fn_failed() { << types.ERROR_TY }
    fty = c.coerce_to(p, p.nodes[sf].a, fty, c.env.structs[si].fields[fi].ty)
    if types.is_error_type(fty) || c.fn_failed() { << types.ERROR_TY }
    if fty != c.env.structs[si].fields[fi].ty {
        << c.fail_expr(p, p.nodes[sf].a, "type mismatch: expected " + c.diag_type_display(c.env.structs[si].fields[fi].ty) + ", found " + c.diag_type_display(fty) + c.borrow_type_hint(p, p.nodes[sf].a, c.env.structs[si].fields[fi].ty, fty))
    }
    // M165: field `&a T` must come from a param with lifetime `a`.
    want := c.env.structs[si].fields[fi].life
    if want.len > 0 && types.is_ref_type(c.env.structs[si].fields[fi].ty) {
        origin := c.expr_ref_origin(p, p.nodes[sf].a)
        if origin < 0 {
            << c.fail_expr(p, sf, "cannot store a reference to local data in field '" + p.nodes[sf].sval + "'")
        }
        if origin >= c.llife.len || c.llife[origin] != want {
            << c.fail_expr(p, sf, "field '" + p.nodes[sf].sval + "' requires lifetime '" + want + "'")
        }
    }
    c.move_of(p, p.nodes[sf].a, fty, false)
    sf = p.nodes[sf].next
    }
    if c.env.structs[si].is_union {
        if n_init > 1 {
            << c.fail_expr(p, n, "union initializer may specify at most one field")
        }
    } else {
        for i in 0:c.env.structs[si].fields.len {
            if seen[i] {
                ->
            }
            if cross {
                if c.env.structs[si].fields[i].is_pub {
                    << c.fail_expr(p, n, "missing public field '" + c.env.structs[si].fields[i].name + "' in initializer of struct '" + c.env.structs[si].name + "'")
                }
                if c.env.structs[si].drop_label.len > 0 || c.zero_requires_resource_constructor(c.env.structs[si].fields[i].ty) {
                    << c.fail_expr(p, n, "resource with private fields requires a constructor")
                }
                // Other private fields: MIR zero-fills at codegen.
            } else {
                << c.fail_expr(p, n, "missing field '" + c.env.structs[si].fields[i].name + "' in initializer of struct '" + c.env.structs[si].name + "'")
            }
        }
    }
    ty := types.struct_type(si)
    c.set_ntype(n, ty)
    << ty
}

fn (c $&Checker) check_index_expr(p &parser.Parser, n int) int {
    ot := c.check_expr(p, p.nodes[n].a)
    if types.is_error_type(ot) || c.fn_failed() { << types.ERROR_TY }
    oa := p.nodes[n].a
    if oa >= 0 && p.nodes[oa].kind == ast.NK_INDEX && oa < c.env.ncall.len && c.env.ncall[oa] == -77 {
        if ot != 3 && c.type_owning(ot) {
            << c.fail_expr(p, n, "cannot move an owning map value by index; borrow it or take it")
        }
    }
    base_ty := c.direct_type(ot)
    mt := c.peel_map(ot)
    if mt >= 0 {
        it := c.check_expr(p, p.nodes[n].b)
        if types.is_error_type(it) || c.fn_failed() { << types.ERROR_TY }
        wantk := c.env.maps[types.map_index(mt)].key_ty
        if it != wantk {
            << c.fail_expr(p, p.nodes[n].b, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(it) + c.borrow_type_hint(p, p.nodes[n].b, wantk, it))
        }
        c.set_ncall(n, -77)
        vt := c.env.maps[types.map_index(mt)].val_ty
        c.set_ntype(n, vt)
        << vt
    }
    if c.is_maps_table(base_ty) {
        it := c.check_expr(p, p.nodes[n].b)
        if types.is_error_type(it) || c.fn_failed() { << types.ERROR_TY }
        if it != 3 {
            << c.fail_expr(p, p.nodes[n].b, "map key type must be string")
        }
        get_fi := c.find_method(base_ty, "get")
        if get_fi < 0 {
            << c.fail_expr(p, n, "internal: maps.get missing")
        }
        c.set_ncall(n, get_fi)
        << c.wrap_throwable_call_result(p, n, get_fi, c.maps_val_ty(base_ty))
    }
    it := c.check_expr(p, p.nodes[n].b)
    if types.is_error_type(it) || c.fn_failed() { << types.ERROR_TY }
    if it != 1 {
        << c.fail_expr(p, p.nodes[n].b, "type mismatch: expected int, found " + c.diag_type_display(it))
    }
    // M36 E3: constant negative index on temp array/string; constant index
    // past the known length of an array literal.
    if c.is_const_int_expr(p, p.nodes[n].b) {
        iv := c.const_int_expr_value(p, p.nodes[n].b)
        if iv < 0 {
            << c.fail_expr(p, p.nodes[n].b, "negative index " + str(iv))
        }
        if types.is_array_type(base_ty) {
            ln := c.known_len_of(p, p.nodes[n].a)
            if ln >= 0 && iv >= ln {
                << c.fail_expr(p, p.nodes[n].b, "index " + str(iv) + " out of bounds for array of length " + str(ln))
            }
        }
    }
    if base_ty == 3 { // string byte access
        c.set_ntype(n, 1)
        << 1
    }
    if types.is_array_type(base_ty) {
        // Array index: result type is the element type.
        ai := types.array_index(base_ty)
        $et := c.env.arrays[ai].elem_ty
        if c.env.is_inst[c.env.cur_fn] != 0 {
            t0 := c.inst_elem_t0(c.env.cur_fn)
            if t0 >= 0 && (types.is_param_type(et) || (et == 3 && t0 == 4)) {
                et = t0
            }
        }
        c.set_ntype(n, et)
        obj := p.nodes[n].a
        if p.nodes[obj].kind == ast.NK_IDENT {
            rid := c.env.nlocal[obj]
            ei := c.as_const_index(p, p.nodes[n].b)
            if ei >= 0 {
                c.check_field_not_moved(p, rid, ei, p.nodes[n].a)
            }
        }
        pth := c.as_place_path(p, n)
        rid2 := c.as_top_field_id(p, n)
        if rid2 >= 0 && pth >= 64 {
            c.check_path_not_moved(p, rid2, pth, n)
        }
        << et
    }
    << c.fail_expr(p, n, "cannot index into " + c.ty_display(ot))
}

// W3: Ident — split from check_expr.
fn (c $&Checker) check_expr_ident(p &parser.Parser, n int) int {
    // M109: remapped capture → env.field
    if c.cap_active == 1 {
        name := p.nodes[n].sval
        for i in 0:c.cap_names.len {
            if c.cap_names[i] == name {
                c.set_ncall(n, -90)
                si28 := c.cap_fields[i]
                c.set_nstr(n, si28)
                c.set_nlocal(n, -1)
                ty := c.cap_tys[i]
                c.set_ntype(n, ty)
                << ty
            }
        }
    }
    id := c.find_local(p.nodes[n].sval)
    if id < 0 {
        ci := c.find_const(p.nodes[n].sval)
        if ci >= 0 {
            c.set_nconst(n, ci)
            ty := c.env.ctypes[ci]
            c.set_ntype(n, ty)
            if ty == 3 {
                si29 := c.env.cstr_idx[ci]
                c.set_nstr(n, si29)
            }
            << ty
        }
        // M103: bare free function name → fn value (code pointer).
        fi := c.find_fn(p.nodes[n].sval)
        if fi >= 0 {
            if c.env.fns[fi].is_extern {
                << c.fail_expr(p, n, "native function values require a Xu wrapper; invoke the native function directly")
            }
            ff := c.ffi_label_flags(&c.env.fns[fi].label)
            if ff >= 0 && (ff & ast.FFI_UNSAFE_FN) != 0 {
                << c.fail_expr(p, n, "unsafe function values require a safe Xu wrapper; invoke the unsafe function inside an unsafe { } block")
            }
            if c.env.fns[fi].is_template {
                << c.fail_expr(p, n, "cannot take value of generic function '" + p.nodes[n].sval + "' (instantiate via a call)")
            }
            c.set_ncall(n, fi)
            $params := []int{}
            for pi in 0:c.env.fns[fi].params.len {
                params.push(c.env.fns[fi].params[pi])
            }
            ty := c.intern_fn_sig(params, c.env.fns[fi].ret)
            c.set_ntype(n, ty)
            << ty
        }
        gi := c.find_global_in_mod(p.nodes[n].sval, c.env.cur_mod)
        if gi >= 0 {
            if c.env.unsafe_depth == 0 {
                $kind_s := "extern \"C\" global"
                if c.env.globals[gi].is_bss { kind_s = "static variable" }
                << c.fail_expr(p, n, "accessing " + kind_s + " '" + p.nodes[n].sval + "' requires an unsafe block")
            }
            c.set_nconst(n, -1000 - gi)
            gty := c.env.globals[gi].ty
            c.set_ntype(n, gty)
            << gty
        }
        << c.fail_expr(p, n, "undefined name '" + p.nodes[n].sval + "'")
    }
    c.check_not_moved(p, id, n)
    if c.fn_failed() { << types.ERROR_TY }
    c.set_nlocal(n, id)
    ty := c.env.ltype[id]
    c.set_ntype(n, ty)
    << ty
}

// Spec34 E24: extracting a local may move it; do not suggest an automatic fix.
fn (c &Checker) reborrow_place_error() string {
    << "cannot take address of dereference\nnote: reborrowing a \$& reference currently requires a local reference name\nhelp: bind the reference to a local first; this may move it out of its previous binding"
}

// W3: Borrow — split from check_expr.
fn (c $&Checker) check_expr_borrow(p &parser.Parser, n int) int {
    mutable := p.nodes[n].ival == 1
    target := p.nodes[n].a
    tk := p.nodes[target].kind
    if tk == ast.NK_UN_OP && p.nodes[target].ival == 3 {
        // `&*r` of shared `&T`: copy the pointer. Reborrowing `$&T`
        // may be exclusive or shared according to the expected reference type.
        inner := p.nodes[target].a
        $ity := c.check_expr(p, inner)
        if types.is_error_type(ity) || c.fn_failed() { << types.ERROR_TY }
        if mutable {
            if types.is_ref_type(ity) && !types.is_mut_ref_type(ity) {
                << c.fail_expr(p, n, "cannot take address of dereference: cannot obtain an exclusive writable borrow from a shared reference\nhelp: borrow mutably from the owner, after conflicting borrows end")
            }
            if !types.is_mut_ref_type(ity) {
                << c.fail_expr(p, n, "cannot take address of dereference")
            }
            if p.nodes[inner].kind != ast.NK_IDENT {
                << c.fail_expr(p, n, c.reborrow_place_error())
            }
            c.set_ntype(n, ity)
        } else if !types.is_ref_type(ity) {
            << c.fail_expr(p, n, "cannot take address of dereference")
        } else if types.is_mut_ref_type(ity) {
            if p.nodes[inner].kind != ast.NK_IDENT {
                << c.fail_expr(p, n, c.reborrow_place_error())
            }
            pty := c.ref_inner_type(ity)
            rt := c.make_ref_type(false, pty)
            if rt < 0 {
                << c.fail_expr(p, n, "cannot take address of dereference")
            }
            c.set_ntype(n, rt)
            ity = rt
        } else {
            c.set_ntype(n, ity)
        }
        if p.nodes[inner].kind == ast.NK_IDENT {
            si30 := c.env.nlocal[inner]
            c.set_nlocal(n, si30)
        }
        << ity
    }
    ity := c.check_expr(p, target)
    if types.is_error_type(ity) || c.fn_failed() { << types.ERROR_TY }
    << c.check_borrow_target(p, n, target, mutable, ity)
}

// Shared by explicit borrows and expected-type ordinary-place adjustments.
// The target has already been checked, so do not recheck/reset its tables.
fn (c $&Checker) check_borrow_target(p &parser.Parser, n int, target int, mutable bool, ity int) int {
    if types.is_error_type(ity) || c.fn_failed() { << types.ERROR_TY }
    tk := p.nodes[target].kind
    if tk == ast.NK_INDEX {
        << c.check_borrow_index(p, n, target, mutable, ity)
    }
    if tk == ast.NK_FIELD {
        bty_bf := c.direct_type(c.env.ntype[p.nodes[target].a])
        if types.is_struct_type(bty_bf) {
            si_bf := types.struct_index(bty_bf)
            fi_bf := c.find_field(si_bf, p.nodes[target].sval)
            if fi_bf >= 0 && c.env.structs[si_bf].fields[fi_bf].bit_width > 0 {
                << c.fail_expr(p, n, "cannot take address of bitfield '" + p.nodes[target].sval + "'")
            }
        }
        $b := p.nodes[target].a
        while b >= 0 && p.nodes[b].kind == ast.NK_FIELD {
            b = p.nodes[b].a
        }
        if b >= 0 && p.nodes[b].kind == ast.NK_INDEX {
            << c.check_borrow_index(p, n, target, mutable, ity)
        }
    }
    // Shared borrow of a literal/temp is legal (stdlib `"int=")`); only
    // `$&` still requires a real place. Fields/Idents keep the old path.
    if tk != ast.NK_IDENT && tk != ast.NK_FIELD && tk != ast.NK_STR && tk != ast.NK_INT && tk != ast.NK_BOOL {
        if mutable {
            << c.fail_expr(p, n, "can only borrow variables or fields")
        }
    }
    // MS6 C: shared `&temp`/`&any` rejected; `$&e` allowed for is/as.
    if !mutable && types.is_dynamic_box(ity) {
        << c.fail_expr(p, n, "cannot borrow a value of type " + c.ty_display(ity))
    }
    if tk == ast.NK_IDENT {
        bid := c.env.nlocal[target]
        if c.field_cons_any(bid) {
            << c.fail_expr(p, n, "use of moved value '" + c.env.lname[bid] + "'")
        }
    }
    if tk == ast.NK_FIELD {
        pth := c.as_place_path(p, target)
        rid := c.as_top_field_id(p, target)
        if rid >= 0 && pth > 0 {
            for s in 0:4 {
                lp := c.lp_get(rid, s)
                if lp == 0 {
                    ->
                }
                if lp == pth || path_is_prefix(lp, pth) || path_is_prefix(pth, lp) {
                    << c.fail_expr(p, n, "use of moved value '" + c.env.lname[rid] + "'")
                }
            }
        }
    }
    if mutable {
        root_g := c.expr_global_root(p, target)
        if root_g >= 0 {
            c.check_global_write(p, n, root_g)
            if c.fn_failed() { << types.ERROR_TY }
        } else {
            $root := target
            if tk == ast.NK_FIELD { root = p.nodes[target].a }
            if p.nodes[root].kind != ast.NK_IDENT {
                << c.fail_expr(p, n, "mutable field borrow requires a local root")
            }
            id := c.env.nlocal[root]
            // MS6 C: exclusive borrow of temp/any/struct@ for is/as; binding need not be mutable.
            if id < 0 || (c.env.lmut[id] == 0 && !types.is_mut_ref_type(c.env.ltype[id]) && !types.is_dynamic_box(ity)) {
                $hint := binding_mut_help(p.nodes[root].sval)
                if id >= 0 && types.is_ref_type(c.env.ltype[id]) && !types.is_mut_ref_type(c.env.ltype[id]) {
                    hint = c.shared_write_help(id)
                }
                << c.fail_expr(p, n, "cannot mutably borrow immutable variable '" + p.nodes[root].sval + "'" + hint)
            }
        }
    }
    // M166: allow one nesting level via make_ref_type.
    rty := c.make_ref_type(mutable, ity)
    if rty < 0 {
        << c.fail_expr(p, n, "cannot borrow a value of type " + c.ty_display(ity))
    }
    c.set_ntype(n, rty)
    << rty
}

// MS4: `&xs[i]` / `$&xs[i]` / `&xs[i].f` — Place hung on the container root.
fn (c $&Checker) check_borrow_index(p &parser.Parser, n int, target int, mutable bool, ity int) int {
    if types.is_error_type(ity) || c.fn_failed() { << types.ERROR_TY }
    $cur := target
    $saw_index := false
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX {
            saw_index = true
            idx := p.nodes[cur].b
            if idx < 0 || (p.nodes[idx].kind != ast.NK_IDENT && p.nodes[idx].kind != ast.NK_INT && p.nodes[idx].kind != ast.NK_STR) {
                << c.fail_expr(p, n, "element borrow index must be a variable or integer literal")
            }
            cur = p.nodes[cur].a
        } else if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            <-
        }
    }
    if !saw_index {
        << c.fail_expr(p, n, "can only borrow array elements")
    }
    is_map := c.borrow_chain_is_map(p, target)
    if is_map && p.nodes[target].kind != ast.NK_INDEX {
        << c.fail_expr(p, n, "cannot borrow a map element")
    }
    if !is_map && p.nodes[target].kind == ast.NK_INDEX {
        base := p.nodes[target].a
        aty := c.direct_type(c.env.ntype[base])
        if !types.is_array_type(aty) {
            << c.fail_expr(p, n, "can only borrow array elements")
        }
    }
    if !types.elem_borrow_ok(ity) {
        if is_map {
            << c.fail_expr(p, n, "cannot borrow map elements of type " + c.ty_display(ity))
        }
        << c.fail_expr(p, n, "cannot borrow array elements of type " + c.ty_display(ity))
    }
    root := c.borrow_root_local(p, target)
    root_g := c.expr_global_root(p, target)
    if root < 0 && root_g < 0 {
        if is_map {
            << c.fail_expr(p, n, "can only borrow map elements of a variable")
        }
        << c.fail_expr(p, n, "can only borrow array elements of a variable")
    }
    if root_g >= 0 && root < 0 {
        if mutable {
            c.check_global_write(p, n, root_g)
            if c.fn_failed() { << types.ERROR_TY }
        }
    } else {
        if root < 0 || root >= c.env.ltype.len {
            << c.fail_expr(p, n, "can only borrow array elements of a variable")
        }
        rty := c.env.ltype[root]
        if types.is_ref_type(rty) {
            inner := c.ref_inner_type(rty)
            if !types.is_struct_type(inner) && !types.is_array_type(inner) && !types.is_map_type(inner) {
                if is_map {
                    << c.fail_expr(p, n, "can only borrow map elements of a local map")
                }
                << c.fail_expr(p, n, "can only borrow array elements of a local array")
            }
            if mutable && !types.is_mut_ref_type(rty) {
                << c.fail_expr(p, n, "cannot mutably borrow a field through a shared reference")
            }
        } else if !types.is_array_type(rty) && !types.is_struct_type(rty) && !types.is_map_type(rty) {
            if is_map {
                << c.fail_expr(p, n, "can only borrow map elements of a local map")
            }
            << c.fail_expr(p, n, "can only borrow array elements of a local array")
        }
        if mutable && !types.is_ref_type(rty) && c.env.lmut[root] == 0 {
            << c.fail_expr(p, n, "cannot mutably borrow immutable variable '" + c.env.lname[root] + "'" + binding_mut_help(c.env.lname[root]))
        }
    }
    rt := c.make_ref_type(mutable, ity)
    if rt < 0 {
        << c.fail_expr(p, n, "cannot borrow a value of type " + c.ty_display(ity))
    }
    c.set_ntype(n, rt)
    << rt
}

// W3: ArrayLit / EmptyArrayLit — split from check_expr.
fn (c $&Checker) check_expr_array_lit(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_ARRAY_LIT { // ArrayLit — `[…]` or `[N]T{…}`
        fl := p.nodes[n].ival
        if fl > 0 {
            // Fixed composite: element type from annotation node `b`.
            ety := c.type_of(p, p.nodes[n].b)
            if types.is_error_type(ety) || c.fn_failed() { << types.ERROR_TY }
            $cnt := 0
            $e := p.nodes[n].a
            while e >= 0 {
                $et := c.check_expr(p, e)
                if types.is_error_type(et) || c.fn_failed() { << types.ERROR_TY }
                et = c.coerce_to(p, e, et, ety)
                if types.is_error_type(et) || c.fn_failed() { << types.ERROR_TY }
                if et != ety {
                    << c.fail_expr(p, e, "type mismatch: expected " + c.diag_type_display(ety) + ", found " + c.diag_type_display(et) + c.borrow_type_hint(p, e, ety, et))
                }
                c.move_of(p, e, ety, false)
                cnt += 1
                e = p.nodes[e].next
            }
            if cnt != fl && cnt != 0 {
                << c.fail_expr(p, n, "fixed array literal has " + str(cnt) + " elements, expected " + str(fl) + " (or 0 for zero-init)")
            }
            si31 := c.intern_array_type_n(ety, fl)
            // Always pre-intern `[]T`: MIR copies c.arrays after check, before
            // lower. Owning and non-owning fixed ArrayLit both use a synthetic
            // dynamic hold whose type id must already exist in m.arrays.
            if fl > 0 {
                c.intern_array_type_n(ety, 0)
            }
            c.set_ntype(n, si31)
            << c.env.ntype[n]
        }
        if c.env.in_irq == 1 {
            << c.fail_expr(p, n, "cannot allocate in irq handler")
        }
        if p.nodes[n].a < 0 {
            << c.fail_expr(p, n, "array literal needs at least one element")
        }
        ety := c.check_expr(p, p.nodes[n].a)
        if types.is_error_type(ety) || c.fn_failed() { << types.ERROR_TY }
        // M167: array literals may hold references.
        // Remaining elements coerce to the first (int narrowing / MS5 box).
        $e := p.nodes[n].a
        while e >= 0 {
        if e != p.nodes[n].a {
            $et := c.check_expr(p, e)
            if types.is_error_type(et) || c.fn_failed() { << types.ERROR_TY }
            et = c.coerce_to(p, e, et, ety)
            if types.is_error_type(et) || c.fn_failed() { << types.ERROR_TY }
            if et != ety {
                << c.fail_expr(p, e, "type mismatch: expected " + c.diag_type_display(ety) + ", found " + c.diag_type_display(et) + c.borrow_type_hint(p, e, ety, et))
            }
        }
        // The inference element transfers too; skipping it creates a
        // second owner for the same allocation.
        c.move_of(p, e, ety, false)
        e = p.nodes[e].next
        }
        // Dedup array type
        si32 := c.intern_array_type(ety)
        c.set_ntype(n, si32)
        << c.env.ntype[n]
    }
    // EmptyArrayLit: []T{}
    if c.env.in_irq == 1 {
        << c.fail_expr(p, n, "cannot allocate in irq handler")
    }
    ety := c.type_of(p, p.nodes[n].a)
    if types.is_error_type(ety) || c.fn_failed() { << types.ERROR_TY }
    si33 := c.intern_array_type(ety)
    c.set_ntype(n, si33)
    << c.env.ntype[n]
}

// W3: slice s[a -< b] / xs[a -< b] — split from check_expr.
fn (c $&Checker) check_expr_slice(p &parser.Parser, n int) int {
    ot := c.check_expr(p, p.nodes[n].a)
    if types.is_error_type(ot) || c.fn_failed() { << types.ERROR_TY }
    $base := ot
    if types.is_ref_type(base) {
        base = c.ref_inner_type(base)
    }
    if types.is_ref_type(base) {
        base = c.ref_inner_type(base)
    }
    $result := 3
    if base == 3 {
        result = 3
    } else if types.is_array_type(base) {
        if c.is_fixed_array_m(base) {
            << c.fail_expr(p, n, "cannot slice a fixed-size array")
        }
        if c.env.in_irq == 1 {
            << c.fail_expr(p, n, "cannot allocate in irq handler")
        }
        ety := c.elem_ty_of_array(base, c.env.cur_fn)
        if c.type_owning(ety) && ety != 3 {
            << c.fail_expr(p, n, "cannot slice an array of non-string owning values")
        }
        result = base
    } else {
        << c.fail_expr(p, n, "cannot slice " + c.ty_display(ot))
    }
    if p.nodes[n].b >= 0 {
        st := c.check_expr(p, p.nodes[n].b)
        if types.is_error_type(st) || c.fn_failed() { << types.ERROR_TY }
        if st != 1 {
            << c.fail_expr(p, p.nodes[n].b, "slice bounds must be int")
        }
    }
    if p.nodes[n].c >= 0 {
        et := c.check_expr(p, p.nodes[n].c)
        if types.is_error_type(et) || c.fn_failed() { << types.ERROR_TY }
        if et != 1 {
            << c.fail_expr(p, p.nodes[n].c, "slice bounds must be int")
        }
    }
    // M36 E4 / MS9d: constant slice bounds out of range for a known-length
    // string or array.
    if p.nodes[n].b >= 0 && p.nodes[n].c >= 0 {
        ln := c.known_len_of(p, p.nodes[n].a)
        if ln >= 0 && c.is_const_int_expr(p, p.nodes[n].b) && c.is_const_int_expr(p, p.nodes[n].c) {
            sv := c.const_int_expr_value(p, p.nodes[n].b)
            ev := c.const_int_expr_value(p, p.nodes[n].c)
            rk := p.nodes[n].ival
            $ls := sv
            $le := ev
            if range_start_excl(rk) { ls = sv + 1 }
            if !range_end_excl(rk) { le = ev + 1 }
            if ls < 0 || le > ln || ls > le {
                << c.fail_expr(p, n, "slice " + str(sv) + " " + range_op_str(rk) + " " + str(ev) + " out of bounds for length " + str(ln))
            }
        }
    }
    c.set_ntype(n, result)
    << result
}

// W3: UnOp — split from check_expr.
fn (c $&Checker) check_expr_unop(p &parser.Parser, n int) int {
    op := p.nodes[n].ival
    t := c.check_expr(p, p.nodes[n].a)
    if types.is_error_type(t) || c.fn_failed() { << types.ERROR_TY }
    if op == 1 { // -
        if types.is_integer_type(t) {
            c.set_ntype(n, t)
            << t
        }
        if types.is_float_type(t) {
            c.set_ntype(n, t)
            << t
        }
        << c.fail_expr(p, n, "unary '-' requires int or f64")
    }
    if op == 3 { // *e — MS3
        if types.is_raw_ptr_type(t) {
            if c.env.unsafe_depth == 0 {
                << c.fail_expr(p, n, "dereferencing raw pointer requires an unsafe block")
            }
            pty := c.ref_inner_type(t)
            c.set_ntype(n, pty)
            << pty
        }
        if !types.is_ref_type(t) {
            << c.fail_expr(p, n, "cannot dereference non-reference type '" + c.ty_display(t) + "'")
        }
        pty := c.ref_inner_type(t)
        // MS6 C: `(*r) as T` / `is` may deref `$&temp`.
        if c.env.in_or_catch == 3 && types.is_mut_ref_type(t) && types.is_as_box(pty) {
            c.set_ntype(n, pty)
            << pty
        }
        if !types.deref_copy_ok(pty) {
            << c.fail_expr(p, n, "cannot dereference owning type '" + c.ty_display(pty) + "'")
        }
        c.set_ntype(n, pty)
        << pty
    }
    if t != 2 {
        << c.fail_expr(p, n, "unary '!' requires bool")
    }
    c.set_ntype(n, 2)
    << 2
}

// W3: ChanInit / Recv — split from check_expr.
fn (c $&Checker) check_expr_chan(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_CHAN_INIT { // ChanInit a=elem type, b=cap (M17)
        if c.env.in_irq == 1 {
            << c.fail_expr(p, n, "cannot use channels in irq handler")
        }
        ety := c.type_of(p, p.nodes[n].a)
        if types.is_error_type(ety) || c.fn_failed() { << types.ERROR_TY }
        if !c.type_is_send(ety) {
            << c.fail_expr(p, n, "channel element type cannot be a reference")
        }
        si34 := c.intern_chan_type(ety)
        c.set_ntype(n, si34)
        cty := c.check_expr(p, p.nodes[n].b)
        if types.is_error_type(cty) || c.fn_failed() { << types.ERROR_TY }
        if cty != 1 {
            << c.fail_expr(p, p.nodes[n].b, "type mismatch: expected int, found " + c.diag_type_display(cty))
        }
        // M36 E5: constant negative capacity (cap 0 = unbuffered, M17b).
        // `-1` parses as UnOp(Neg, Int(1)), not Int(-1) — mirror xuhir.
        capn := p.nodes[n].b
        if p.nodes[capn].kind == ast.NK_INT {
            if p.nodes[capn].ival < 0 {
                << c.fail_expr(p, capn, "channel capacity must not be negative")
            }
        }
        if p.nodes[capn].kind == ast.NK_UN_OP && p.nodes[capn].ival == 1 {
            inner := p.nodes[capn].a
            if inner >= 0 && p.nodes[inner].kind == ast.NK_INT {
                if p.nodes[inner].ival > 0 {
                    << c.fail_expr(p, capn, "channel capacity must not be negative")
                }
            }
        }
        ci := types.chan_index(c.env.ntype[n])
        c.set_nlocal(n, ci)
        << c.env.ntype[n]
    }
    // Recv <-ch (M17)
    if c.env.in_irq == 1 {
        << c.fail_expr(p, n, "cannot use channels in irq handler")
    }
    cty := c.check_expr(p, p.nodes[n].a)
    if types.is_error_type(cty) || c.fn_failed() { << types.ERROR_TY }
    if !types.is_chan_type(cty) {
        << c.fail_expr(p, n, "receive requires a channel, found " + c.ty_display(cty))
    }
    ci := types.chan_index(cty)
    elem := c.env.chans[ci].elem_ty
    c.set_nlocal(n, ci)
    c.set_ntype(n, elem)
    << elem
}

// W3: OrCatch — split from check_expr.
fn (c $&Checker) check_expr_or_try(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_OR_CATCH { // OrCatch: call >>> (err) { } (§5.7)
        c.env.in_or_catch = 1
        call_ty := c.check_expr(p, p.nodes[n].a)
        c.env.in_or_catch = 0
        if types.is_error_type(call_ty) || c.fn_failed() { << types.ERROR_TY }
        // Non-throwing calls may still use `>>>` as a fallback (fixtures/stdlib
        // wrap write_string/int helpers). Result type is the call's native type.
        $res_ty := call_ty
        is_throwing := types.is_throw_type(call_ty)
        or_target := ~c.env.or_assign
        if is_throwing {
            ri := types.throw_index(call_ty)
            if ri < 0 || ri >= c.env.throws.len {
                << c.fail_expr(p, n, "invalid throw type on `>>>`")
            }
            res_ty = c.env.throws[ri].ok_ty
            if !c.or_body_definite(p, p.nodes[n].c, or_target) {
                << c.fail_expr(p, n, "`>>>` block must assign the target or terminate (`<<`/`<-`/`->`/`>>>`)")
            }
        }
        snap := c.as_join_snap()
        $join_cons := []int{}
        c.as_join_after_arm(&snap, false, $&join_cons)
        c.as_join_restore(&snap)
        c.push_scope(2)
        err_ty := types.interface_type(c.env.errors_iface)
        err_id := c.add_local(p.nodes[n].sval, err_ty, false)
        saved_or_a := ~c.env.or_assign
        c.env.or_assign = ""
        $s := p.nodes[n].c
        $term := false
        while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
        }
        c.env.or_assign = saved_or_a
        c.pop_scope(p, true, c.fn_failed() || term)
        if c.fn_failed() { << types.ERROR_TY }
        if is_throwing {
            c.as_join_after_arm(&snap, term, $&join_cons)
        }
        c.as_join_finish(&snap, join_cons)
        $fall_tgt := -1
        if is_throwing && !term {
            tgt := or_fallthrough_ident_node(p, p.nodes[n].c, or_target)
            if tgt == -2 {
                << c.fail_expr(p, n, "cannot shadow `>>>` target '" + or_target + "' inside fallback block")
            } else if tgt >= 0 {
                lid := c.env.nlocal[tgt]
                if lid < 0 || lid >= err_id || !c.same_type(c.env.ltype[lid], res_ty) {
                    << c.fail_expr(p, tgt, "`>>>` fallback assignment target type mismatch")
                } else {
                    fall_tgt = tgt
                }
            }
        }
        c.set_nconst(n, fall_tgt)
        c.set_nlocal(n, err_id)
        c.set_ntype(n, res_ty)
        << res_ty
    }
    << c.fail_expr(p, n, "expression not supported yet (M6b2-s3a)")
}

// W3: Cast / nk_type_is / nk_type_as — split from check_expr.
fn (c $&Checker) check_expr_cast_is_as(p &parser.Parser, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_CAST { // Cast ival=to_ty, a=expr
        ity := c.check_expr(p, p.nodes[n].a)
        if types.is_error_type(ity) || c.fn_failed() { << types.ERROR_TY }
        raw_to := p.nodes[n].ival
        $to := raw_to
        if to == 15 { to = c.ffi_c_long_ty() }
        if to == 16 { to = c.ffi_c_ulong_ty() }
        if to == 17 { to = c.target_isize_ty() }
        if to == 18 { to = c.target_usize_ty() }
        if to == 4 {
            if ity != 1 && ity != 14 {
                << c.fail_expr(p, n, "f64(...) expects int or f32")
            }
            c.set_ntype(n, 4)
            << 4
        }
        if to == 14 {
            if ity != 1 && ity != 4 && ity != 14 {
                << c.fail_expr(p, n, "f32(...) expects int or f64")
            }
            c.set_ntype(n, 14)
            << 14
        }
        if to == 6 {
            if !types.is_integer_type(ity) && ity != 6 {
                << c.fail_expr(p, n, "c_ptr(...) expects an integer or c_ptr address")
            }
            c.set_ntype(n, 6)
            << 6
        }
        if to == 1 || to == 13 {
            if !types.is_integer_type(ity) && !types.is_float_type(ity) && ity != 6 {
                << c.fail_expr(p, n, "int(...) expects an integer, float or c_ptr")
            }
            if to == 13 && types.is_float_type(ity) {
                << c.fail_expr(p, n, "u64(...) expects an integer or c_ptr")
            }
            c.set_ntype(n, to)
            << to
        }
        if to == 8 || to == 9 || to == 10 || to == 7 || to == 11 || to == 12 {
            if !types.is_integer_type(ity) && !((raw_to == 17 || raw_to == 18) && ity == 6) {
                << c.fail_expr(p, n, "integer cast expects an integer")
            }
            c.set_ntype(n, to)
            << to
        }
        << c.fail_expr(p, n, "unsupported cast")
    }
    if k == ast.NK_TYPE_IS { // nk_type_is (M147)
        saved_peel := c.env.in_or_catch
        c.env.in_or_catch = 3
        raw := c.check_expr(p, p.nodes[n].a)
        c.env.in_or_catch = saved_peel
        if types.is_error_type(raw) || c.fn_failed() { << types.ERROR_TY }
        $ity := raw
        if types.is_mut_ref_type(raw) {
            inner := c.ref_inner_type(raw)
            if types.is_dynamic_box(inner) {
                ity = inner
            }
        }
        concrete := c.type_of(p, p.nodes[n].b)
        if types.is_error_type(concrete) || c.fn_failed() { << types.ERROR_TY }
        if types.is_temp_type(ity) || types.is_any_type(ity) {
            tid := types.temp_box_type_id(concrete)
            if tid < 0 {
                $box_name := "temp"
                if types.is_any_type(ity) { box_name = "any" }
                << c.fail_expr(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type assert on " + box_name)
            }
            c.set_nlocal(n, tid)
        } else if types.is_interface_type(ity) {
            if !types.is_struct_type(concrete) {
                << c.fail_expr(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type assert on struct@ (only structs)")
            }
            c.set_nlocal(n, types.box_struct_tag(types.struct_index(concrete))) // box discriminant
        } else {
            << c.fail_expr(p, n, "'is' requires a temp, any, or struct@ value, found " + c.ty_display(ity))
        }
        c.set_ntype(n, 2)
        << 2
    }
    // nk_type_as (M147): `e as T` → T; mismatch fail-loud
    saved_peel := c.env.in_or_catch
    // Reuse in_or_catch=3 as as_peel for deref of $&temp (is/as operand).
    c.env.in_or_catch = 3
    raw := c.check_expr(p, p.nodes[n].a)
    c.env.in_or_catch = saved_peel
    if types.is_error_type(raw) || c.fn_failed() { << types.ERROR_TY }
    // MS6 C: peel `$&temp` / deref result already temp.
    $ity := raw
    if types.is_mut_ref_type(raw) {
        inner := c.ref_inner_type(raw)
        if types.is_dynamic_box(inner) {
            ity = inner
        }
    }
    concrete := c.type_of(p, p.nodes[n].b)
    if types.is_error_type(concrete) || c.fn_failed() { << types.ERROR_TY }
    if types.is_temp_type(ity) || types.is_any_type(ity) {
        tid := types.temp_box_type_id(concrete)
        if tid < 0 {
            $box_name := "temp"
            if types.is_any_type(ity) { box_name = "any" }
            << c.fail_expr(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type cast on " + box_name)
        }
        if types.is_any_type(ity) && c.type_owning(concrete) && concrete != 3 {
            << c.fail_expr(p, n, "cannot cast owning " + c.ty_display(concrete) + " out of any without consuming; use temp")
        }
        c.set_nlocal(n, tid)
    } else if types.is_interface_type(ity) {
        if !types.is_struct_type(concrete) {
            << c.fail_expr(p, p.nodes[n].b, "cannot use " + c.ty_display(concrete) + " in type cast on struct@ (only structs)")
        }
        c.set_nlocal(n, types.box_struct_tag(types.struct_index(concrete))) // box discriminant
    } else if types.is_raw_ptr_type(concrete) || types.is_raw_ptr_type(ity) {
        if types.is_raw_ptr_type(concrete) {
            if !types.is_integer_type(ity) && !types.is_raw_ptr_type(ity) && !types.is_ref_type(ity) && ity != 6 && !types.is_fn_type(ity) {
                << c.fail_expr(p, n, "cannot cast " + c.ty_display(ity) + " to raw pointer")
            }
        } else {
            if !types.is_integer_type(concrete) && !types.is_raw_ptr_type(concrete) && !types.is_ref_type(concrete) && concrete != 6 && !types.is_fn_type(concrete) {
                << c.fail_expr(p, n, "cannot cast raw pointer to " + c.ty_display(concrete))
            }
        }
    } else if types.is_fn_type(ity) && types.is_integer_type(concrete) {
        // Allow casting fn directly to integer (e.g. usize for kernel context init)
    } else {
        << c.fail_expr(p, n, "'as' requires a temp, any, or struct@ value, found " + c.ty_display(ity))
    }
    // temp: always consume. struct@: consume iff concrete owning. any: keep.
    $consume := types.is_temp_type(ity)
    if types.is_interface_type(ity) {
        consume = c.type_owning(concrete)
    }
    if consume {
        saved_or := c.env.in_or_catch
        c.env.in_or_catch = 2
        c.move_err_n = p.nodes[n].a
        c.move_of(p, p.nodes[n].a, ity, false)
        c.move_err_n = -1
        c.env.in_or_catch = saved_or
    } else {
        c.set_nstr(n, 1) // MIR keep
    }
    c.set_ntype(n, concrete)
    << concrete
}

fn (c $&Checker) check_map_init_expr(p &parser.Parser, n int) int {
    if c.env.in_irq == 1 {
        << c.fail_expr(p, n, "cannot allocate in irq handler")
    }
    kty := c.type_of(p, p.nodes[n].a)
    vty := c.type_of(p, p.nodes[n].b)
    ty := c.intern_map_type(p, n, kty, vty)
    if types.is_error_type(ty) || c.fn_failed() { << types.ERROR_TY }
    if p.nodes[n].c >= 0 {
        cty := c.check_expr(p, p.nodes[n].c)
        if types.is_error_type(cty) || c.fn_failed() { << types.ERROR_TY }
        if cty != 1 {
            << c.fail_expr(p, p.nodes[n].c, "type mismatch: expected int, found " + c.diag_type_display(cty))
        }
    }
    c.set_ncall(n, -89)
    c.set_ntype(n, ty)
    << ty
}

fn asm_valid_reg_name(reg &string) bool {
    << *reg == "rax" || *reg == "eax" || *reg == "ax" || *reg == "al" ||
       *reg == "rcx" || *reg == "ecx" || *reg == "cx" || *reg == "cl" ||
       *reg == "rdx" || *reg == "edx" || *reg == "dx" || *reg == "dl" ||
       *reg == "rbx" || *reg == "ebx" || *reg == "bx" || *reg == "bl" ||
       *reg == "rsi" || *reg == "esi" || *reg == "si" || *reg == "sil" ||
       *reg == "rdi" || *reg == "edi" || *reg == "di" || *reg == "dil" ||
       *reg == "r8" || *reg == "r8d" || *reg == "r8w" || *reg == "r8b" ||
       *reg == "r9" || *reg == "r9d" || *reg == "r9w" || *reg == "r9b" ||
       *reg == "r10" || *reg == "r10d" || *reg == "r10w" || *reg == "r10b" ||
       *reg == "r11" || *reg == "r11d" || *reg == "r11w" || *reg == "r11b" ||
       *reg == "r12" || *reg == "r12d" || *reg == "r12w" || *reg == "r12b" ||
       *reg == "r13" || *reg == "r13d" || *reg == "r13w" || *reg == "r13b" ||
       *reg == "r14" || *reg == "r14d" || *reg == "r14w" || *reg == "r14b" ||
       *reg == "r15" || *reg == "r15d" || *reg == "r15w" || *reg == "r15b"
}

fn (c $&Checker) check_inline_asm(p &parser.Parser, n int) int {
    $op := p.nodes[n].a
    while op >= 0 {
        if p.nodes[op].kind != ast.NK_CALL {
            << c.fail_expr(p, op, "asm operand must be in(\"reg\", expr), out(\"reg\", \$&var), inout(\"reg\", \$&var), or clobber(\"reg\")")
        }
        kind_name := p.nodes[op].sval + ""
        a0 := p.nodes[op].a
        if a0 < 0 || p.nodes[a0].kind != ast.NK_STR {
            << c.fail_expr(p, op, "asm " + kind_name + "(...) expects a register name string literal as first argument")
        }
        reg_name := p.nodes[a0].sval + ""
        if kind_name == "clobber" {
            if reg_name != "memory" && reg_name != "cc" && !asm_valid_reg_name(&reg_name) {
                << c.fail_expr(p, a0, "unknown or reserved register '" + reg_name + "' in asm clobber")
            }
            if p.nodes[a0].next >= 0 {
                << c.fail_expr(p, op, "asm clobber(...) takes only 1 argument")
            }
        } else if kind_name == "in" || kind_name == "out" || kind_name == "inout" {
            if !asm_valid_reg_name(&reg_name) {
                << c.fail_expr(p, a0, "unknown or reserved register '" + reg_name + "' in asm " + kind_name)
            }
            a1 := p.nodes[a0].next
            if a1 < 0 || p.nodes[a1].next >= 0 {
                << c.fail_expr(p, op, "asm " + kind_name + "(\"reg\", expr) expects exactly 2 arguments")
            }
            vty := c.check_expr(p, a1)
            if types.is_error_type(vty) || c.fn_failed() { << types.ERROR_TY }
            if kind_name == "out" || kind_name == "inout" {
                if !types.is_mut_ref_type(vty) && !types.is_raw_ptr_type(vty) {
                    << c.fail_expr(p, a1, "asm " + kind_name + " destination must be a writable reference (\$&var) or *raw pointer")
                }
            }
        } else {
            << c.fail_expr(p, op, "unsupported asm operand '" + kind_name + "' (expected in, out, inout, or clobber)")
        }
        c.set_ntype(op, 0)
        op = p.nodes[op].next
    }
    c.set_ntype(n, 0)
    << 0
}

fn (c $&Checker) check_expr(p &parser.Parser, n int) int {
    if n < 0 {
        << types.ERROR_TY
    }
    if c.fn_failed() {
        c.set_ntype(n, types.ERROR_TY)
        << types.ERROR_TY
    }
    c.set_nshared(n, 0)
    k := p.nodes[n].kind
    if k == ast.NK_INT { // Int
        $ity := 1
        if p.nodes[n].sval == "u64" { ity = 13 }
        c.set_ntype(n, ity)
        << ity
    }
    if k == ast.NK_FLOAT { // Float
        c.set_ntype(n, 4)
        << 4
    }
    if k == ast.NK_CAST { // Cast
        << c.check_expr_cast_is_as(p, n)
    }
    if k == ast.NK_BOOL { // Bool
        c.set_ntype(n, 2)
        << 2
    }
    if k == ast.NK_STR { // Str literal: intern (first-seen order)
        idx := c.intern(p.nodes[n].sval)
        c.set_nstr(n, idx)
        c.set_ntype(n, 3)
        << 3
    }
    if k == ast.NK_IDENT { // Ident
        << c.check_expr_ident(p, n)
    }
    if k == ast.NK_BORROW { // Borrow
        << c.check_expr_borrow(p, n)
    }
    if k == ast.NK_CALL { // Call
        << c.check_call_expr(p, n)
    }
    if k == ast.NK_BIN_OP { // BinOp
        << c.check_binop_expr(p, n)
    }
    if k == ast.NK_STRUCT_INIT { // StructInit
        << c.check_struct_init_expr(p, n)
    }
    if k == ast.NK_FIELD { // obj.field — or module.Const (M9) / Color.Red (M15)
        << c.check_field_expr(p, n)
    }
    if k == ast.NK_METHOD_CALL { // obj.method(args) — or module.fn(args) (M9) / Color.Rgb(...) (M15)
        << c.check_method_expr(p, n)
    }
    if k == ast.NK_INDEX { // obj[index]
        << c.check_index_expr(p, n)
    }
    if k == ast.NK_MAP_INIT { // map[K]V{}
        << c.check_map_init_expr(p, n)
    }
    if k == ast.NK_ARRAY_LIT || k == ast.NK_EMPTY_ARRAY { // ArrayLit / EmptyArrayLit
        << c.check_expr_array_lit(p, n)
    }
    if k == ast.NK_SLICE { // s[a -< b] slice
        << c.check_expr_slice(p, n)
    }
    if k == ast.NK_UN_OP { // UnOp
        << c.check_expr_unop(p, n)
    }
    if k == ast.NK_CHAN_INIT || k == ast.NK_RECV { // ChanInit / Recv
        << c.check_expr_chan(p, n)
    }
    if k == ast.NK_OR_CATCH { // OrCatch
        << c.check_expr_or_try(p, n)
    }
    if k == ast.NT_FN_LIT { // nt_fn_lit (M109)
        << c.check_fn_lit(p, n)
    }
    if k == ast.NK_TYPE_IS || k == ast.NK_TYPE_AS { // nk_type_is / nk_type_as
        << c.check_expr_cast_is_as(p, n)
    }
    if k == ast.NK_CLONE { // Prefix explicit clone ~expr
        << c.check_expr_clone(p, n)
    }
    if k == ast.NK_INLINE_ASM {
        << c.check_inline_asm(p, n)
    }
    if k == ast.NK_TYPE_QUERY {
        val := c.eval_type_query(p, n)
        c.set_nlocal(n, val)
        c.set_ntype(n, 1)
        << 1
    }
    << c.fail_expr(p, n, "expression not supported yet (M6b2-s3a)")
}

fn (c &Checker) type_cloneable(ty int) bool {
    if ty <= 0 { << false }
    if types.is_ref_type(ty) { << false }
    if types.is_chan_type(ty) || types.is_fn_type(ty) || types.is_throw_type(ty) { << false }
    if types.is_temp_type(ty) || types.is_any_type(ty) || types.is_interface_type(ty) { << false }
    if c.type_contains_ref(ty) { << false }
    if c.type_contains_resource(ty) { << false }
    << true
}

fn (c $&Checker) check_expr_clone(p &parser.Parser, n int) int {
    if p.nodes[n].a < 0 {
        << c.fail_expr(p, n, "clone requires an operand")
    }
    raw_ty := c.check_expr(p, p.nodes[n].a)
    if types.is_error_type(raw_ty) {
        c.set_ntype(n, types.ERROR_TY)
        << types.ERROR_TY
    }
    $ty := raw_ty
    while types.is_ref_type(ty) {
        ty = c.ref_inner_type(ty)
    }
    if ty == 0 {
        << c.fail_expr(p, n, "cannot clone void expression")
    }
    if types.is_param_type(ty) {
        c.set_ntype(n, ty)
        << ty
    }
    if !c.type_cloneable(ty) {
        << c.fail_expr(p, n, "type '" + c.ty_display(ty) + "' owns unique resource or reference and cannot be cloned with '~'")
    }
    if c.env.in_irq == 1 && c.type_owning(ty) {
        << c.fail_expr(p, n, "cannot allocate in irq handler")
    }
    c.set_ntype(n, ty)
    << ty
}

// M110/M154: `obj.method` as a value — fat fn `(code*, env*)`.
// Value method on a value: Env{self:T}, code=method (ncall=-92).
// Mut method or temp method through &/$&: Env{self:&T|$&T} + trampoline
// (ncall=-95); trampoline calls the real method with env.self.
