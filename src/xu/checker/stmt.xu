@xu/checker

#xu/ast
#xu/parser
#xu/typeenv
#xu/types

// Spawn records are sized per call; the checker and MIR verifier share this cap.
const XU_MAX_ARGS = 15

fn (c $&Checker) check_enum_match(p &parser.Parser, n int, sty int) {
    // MS-enum: consume the subject (owning enums are linear; Copy payloads
    // are a no-op via type_moves). Payload bindings then own those slots.
    c.move_of(p, p.nodes[n].a, sty, false)
    snap := c.as_join_snap()
    $join_cons := []int{}
    ei := types.enum_index(sty)
    nvars := c.env.enums[ei].variants.len
    $covered := []bool{}
    for i in 0:nvars {
        covered.push(false)
    }
    $has_else := false
    $ar := p.nodes[n].b
    while ar >= 0 {
    ak := p.nodes[ar].kind
    if ak == ast.NK_ARM_ELSE {
        if has_else {
            c.fail_node(p, ar, "duplicate else arm")
        }
        has_else = true
        c.as_join_restore(&snap)
        c.push_scope(2)
        $s := p.nodes[ar].c
        $term := false
        while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
        }
        c.pop_scope(p, true, term)
        c.as_join_after_arm(&snap, term, $&join_cons)
    } else if ak == ast.NK_ARM_ENUM {
        // sval = "Enum.Variant"
        q := p.nodes[ar].sval
        $ename := ""
        $vname := ""
        $dot := -1
        for i in 0:q.len {
            if q[i] == 46 { // '.'
                dot = i
            }
        }
        if dot < 0 {
            c.fail_node(p, ar, "malformed enum match pattern")
        }
        ename = q[0:dot]
        vname = q[dot + 1:q.len]
        $name_matches := ename == c.enum_pattern_name(ei) || ename == c.env.enums[ei].name
        edot := last_dot(~ename)
        if edot >= 0 {
            emod := c.enum_qualifier_module(~ename)
            local_name := local_after_dot(~ename, edot)
            name_matches = emod == c.env.enums[ei].mod_id && (local_name == c.enum_pattern_name(ei) || local_name == c.env.enums[ei].name)
            if name_matches {
                if !c.module_visible(~emod) { c.fail_node(p, ar, "module " + emod + " not imported") }
            }
        }
        if !name_matches {
            c.fail_node(p, ar, "match pattern enum '" + ename + "' does not match subject type '" + c.env.enums[ei].name + "'")
        }
        // Subject inference also accepts short Enum.Variant patterns. Apply
        // privacy after either spelling resolves, so dropping a module
        // qualifier cannot expose a private enum's payload.
        if c.env.enums[ei].mod_id != c.env.cur_mod && !c.env.enums[ei].is_pub {
            c.fail_node(p, ar, "'" + c.env.enums[ei].name + "' is private")
        }
        $vidx := -1
        for i in 0:nvars {
            if c.env.enums[ei].variants[i].name == vname {
                vidx = i
            }
        }
        if vidx < 0 {
            c.fail_node(p, ar, "enum '" + c.env.enums[ei].name + "' has no variant '" + vname + "'")
        }
        if covered[vidx] {
            c.fail_node(p, ar, "variant '" + c.env.enums[ei].name + "." + vname + "' is covered more than once")
        }
        covered[vidx] = true
        nfields := c.env.enums[ei].variants[vidx].fields.len
        $nbind := 0
        $b := p.nodes[ar].a
        while b >= 0 {
            nbind += 1
            b = p.nodes[b].next
        }
        if nbind != nfields {
            c.fail_node(p, ar, "variant '" + c.env.enums[ei].name + "." + vname + "' expects " + str(nfields) + " binding(s), found " + str(nbind))
        }
        // Record tag + enum type on the arm node for MIR (no AST mutate).
        c.set_nlocal(ar, vidx)
        c.set_ntype(ar, sty)
        c.as_join_restore(&snap)
        c.push_scope(2)
        b = p.nodes[ar].a
        $fi := 0
        while b >= 0 {
            fty := c.env.enums[ei].variants[vidx].fields[fi]
            lid := c.add_local(p.nodes[b].sval, fty, false)
            c.set_nlocal(b, lid)
            c.set_ntype(b, fty)
            fi += 1
            b = p.nodes[b].next
        }
        $s := p.nodes[ar].c
        $term := false
        while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
        }
        c.pop_scope(p, true, term)
        c.as_join_after_arm(&snap, term, $&join_cons)
    } else if ak == ast.NK_ARM_STR {
        c.fail_node(p, ar, "string pattern cannot match an enum subject")
    } else {
        c.fail_node(p, ar, "int pattern cannot match an enum subject")
    }
    ar = p.nodes[ar].next
    }
    c.as_join_finish(&snap, join_cons)
    if !has_else {
        $missing := ""
        $first := true
        for i in 0:nvars {
            if !covered[i] {
                if !first {
                    missing = missing + ", "
                }
                missing = missing + c.env.enums[ei].variants[i].name
                first = false
            }
        }
        if missing != "" {
            c.fail_node(p, p.nodes[n].a, "non-exhaustive match on enum '" + c.env.enums[ei].name + "': missing " + missing)
        }
    }
}

// MS9c: string match is `==` sugar. Strings are not exhaustive; else is required.
// Subject is not consumed (M108 Copy-via-clone; compare reads in place).
fn (c $&Checker) check_string_match(p &parser.Parser, n int) {
    snap := c.as_join_snap()
    $join_cons := []int{}
    $has_else := false
    $seen_else := false
    $ar := p.nodes[n].b
    while ar >= 0 {
        if seen_else {
            c.fail_node(p, ar, "'else' must be the last match arm")
        }
        ak := p.nodes[ar].kind
        if ak == ast.NK_ARM_ELSE {
            has_else = true
            seen_else = true
        } else if ak == ast.NK_ARM_STR {
            si12 := c.intern(p.nodes[ar].sval)
            c.set_nstr(ar, si12)
        } else if ak == ast.NK_ARM_ENUM {
            c.fail_node(p, ar, "enum pattern cannot match a string subject")
        } else {
            c.fail_node(p, ar, "int pattern cannot match a string subject")
        }
        c.as_join_restore(&snap)
        c.push_scope(2)
        $s := p.nodes[ar].c
        $term := false
        while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
        }
        c.pop_scope(p, true, term)
        c.as_join_after_arm(&snap, term, $&join_cons)
        ar = p.nodes[ar].next
    }
    c.as_join_finish(&snap, join_cons)
    if !has_else {
        c.fail_node(p, p.nodes[n].a, "string match requires an else arm")
    }
}

// M184: assignment checking — split from check_stmt (W3).
fn (c $&Checker) check_assign_ident(p &parser.Parser, n int, t int, aop int) {
        id := c.find_local(p.nodes[t].sval)
        if id < 0 {
            if c.cap_active == 1 {
                for ci in 0:c.cap_names.len {
                    if c.cap_names[ci] == p.nodes[t].sval {
                        c.fail_node(p, t, "cannot assign to captured variable '" + p.nodes[t].sval + "' in a function literal")
                        <<
                    }
                }
            }
            if c.find_const(p.nodes[t].sval) >= 0 {
                c.fail_node(p, t, "cannot assign to const '" + p.nodes[t].sval + "'")
                <<
            }
            gi := c.find_global_in_mod(p.nodes[t].sval, c.env.cur_mod)
            if gi >= 0 {
                c.check_global_write(p, t, gi)
                gty := c.env.globals[gi].ty
                $ty := c.check_expr(p, p.nodes[n].b)
                ty = c.coerce_to(p, p.nodes[n].b, ty, gty)
                if !c.same_type(ty, gty) {
                    c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.diag_type_display(gty) + ", found " + c.diag_type_display(ty) + c.borrow_type_hint(p, p.nodes[n].b, gty, ty))
                }
                if aop >= 2 && types.compound_ty_ok(aop, ty) == 0 {
                    c.fail_node(p, n, types.compound_ty_msg(aop, gty, ty))
                }
                if (aop == 5 || aop == 6) && ty == 1 {
                    c.check_compound_div(p, n, false, 0, p.nodes[n].b)
                }
                c.set_nconst(t, -1000 - gi)
                c.set_ntype(t, gty)
                <<
            }
            c.fail_node(p, t, "undefined name '" + p.nodes[t].sval + "'")
            <<
        }
        if types.is_write_once_box(c.env.ltype[id]) {
            c.fail_node(p, n, "dynamic temp/any value can only be written once (at initialization)")
        }
        if c.env.lmut[id] == 0 {
            c.fail_node(p, t, "cannot assign to immutable variable '" + p.nodes[t].sval + "'" + binding_mut_help(p.nodes[t].sval))
        }
        if types.is_ref_type(c.env.ltype[id]) && aop >= 2 {
            c.fail_node(p, n, "cannot use compound assignment on a reference")
        }
        c.rebind = id
        $ty := c.check_expr(p, p.nodes[n].b)
        c.rebind = -1
        ty = c.coerce_to(p, p.nodes[n].b, ty, c.env.ltype[id])
        if !c.same_type(ty, c.env.ltype[id]) {
            c.fail_node(p, n, "type mismatch: expected " + c.diag_type_display(c.env.ltype[id]) + ", found " + c.diag_type_display(ty) + c.borrow_type_hint(p, p.nodes[n].b, c.env.ltype[id], ty))
        }
        if aop >= 2 && types.compound_ty_ok(aop, ty) == 0 {
            c.fail_node(p, n, types.compound_ty_msg(aop, c.env.ltype[id], ty))
        }
        if (aop == 5 || aop == 6) && ty == 1 {
            // E2's dividend is the target's value BEFORE the rebind.
            tknown := c.lconst_ok[id] != 0
            tval := c.lconst[id]
            c.check_compound_div(p, n, tknown, tval, p.nodes[n].b)
        }
        c.move_err_n = n
        c.move_of(p, p.nodes[n].b, ty, false)
        c.move_err_n = -1
        typeenv.checker_set_i($&c.lmoved, id, 0)
        if id >= 0 && id < c.lfcons.len {
            typeenv.checker_set_i($&c.lfcons, id, 0)
        }
        c.lp_clear(id)
        // M36 v1: temp reassignment invalidates the tracked constant/length.
        typeenv.checker_set_i($&c.lconst_ok, id, 0)
        typeenv.checker_set_i($&c.llength_ok, id, 0)
        if aop == 1 && ty == 1 && c.expr_int_range_nonzero(p, p.nodes[n].b) {
            c.note_nonzero(id)
        } else if id >= 0 && id < c.lnz_ok.len {
            typeenv.checker_set_i($&c.lnz_ok, id, 0)
        }
        // Wave 2: pure Ident copy aliases; compound / other rhs clears.
        rhs := p.nodes[n].b
        if aop == 1 && rhs >= 0 && p.nodes[rhs].kind == ast.NK_IDENT {
            si13 := c.env.nlocal[rhs]
            typeenv.checker_set_i($&c.calias, id, si13)
        } else {
            typeenv.checker_set_i($&c.calias, id, -1)
        }
        // M149: ref local rebind updates origin (elision / << checks).
        // Gen1 borrowck incorrectly keeps `$&c.lorigin` from the then
        // arm live across `else if` (bootstrap does not). Use two `if`s.
        lty_rebind := c.env.ltype[id]
        if types.is_ref_type(lty_rebind) {
            si14 := c.expr_ref_origin(p, p.nodes[n].b)
            typeenv.checker_set_i($&c.lorigin, id, si14)
        }
        if !types.is_ref_type(lty_rebind) && c.type_contains_ref(lty_rebind) {
            si15 := types.b2i(c.refs_flow_from_param(p, p.nodes[n].b, lty_rebind))
            typeenv.checker_set_i($&c.lrefok, id, si15)
        }
        c.set_nlocal(t, id)
        <<
}

fn (c $&Checker) try_assign_mod_global(p &parser.Parser, n int, t int, aop int) bool {
        recv := p.nodes[t].a
        if p.nodes[recv].kind == ast.NK_IDENT && c.find_local(p.nodes[recv].sval) < 0 {
            $real := ~p.nodes[recv].sval
            if !c.module_exists(~real) { real = c.alias_of(real) }
            if !c.module_exists(~real) {
                qm := c.qual_to_mod(~p.nodes[recv].sval)
                if qm.len > 0 { real = ~qm }
            }
            if c.module_exists(~real) {
                << c.finish_mod_global_assign(p, n, t, aop, ~real)
            }
        }
        if p.nodes[recv].kind == ast.NK_FIELD && c.find_local(c.chain_root(p, recv)) < 0 {
            rpath := c.chain_path(p, recv)
            $m2 := c.longest_module(~rpath)
            $pre := m2.len
            if m2 == "" {
                a2 := c.longest_alias(~rpath)
                if a2.len > 0 {
                    pre = a2.len
                    m2 = c.alias_of(~a2)
                }
            }
            if m2 != "" && pre == rpath.len {
                << c.finish_mod_global_assign(p, n, t, aop, ~m2)
            }
        }
        << false
}

fn (c $&Checker) finish_mod_global_assign(p &parser.Parser, n int, t int, aop int, mod_id string) bool {
        if !c.module_visible(~mod_id) {
            c.fail_node(p, t, "module " + mod_id + " not imported")
            << true
        }
        ci := c.find_const_in_mod(p.nodes[t].sval, ~mod_id)
        if ci >= 0 {
            c.fail_node(p, t, "cannot assign to const '" + p.nodes[t].sval + "'")
            << true
        }
        gi := c.find_global_in_mod(p.nodes[t].sval, ~mod_id)
        if gi < 0 {
            c.fail_node(p, t, "undefined name '" + mod_id + "." + p.nodes[t].sval + "'")
            << true
        }
        if mod_id != c.env.cur_mod && !c.env.globals[gi].is_pub {
            c.fail_node(p, t, "'" + p.nodes[t].sval + "' is private")
        }
        c.check_global_write(p, t, gi)
        gty := c.env.globals[gi].ty
        $ty := c.check_expr(p, p.nodes[n].b)
        ty = c.coerce_to(p, p.nodes[n].b, ty, gty)
        if !c.same_type(ty, gty) {
            c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.diag_type_display(gty) + ", found " + c.diag_type_display(ty) + c.borrow_type_hint(p, p.nodes[n].b, gty, ty))
        }
        if aop >= 2 && types.compound_ty_ok(aop, ty) == 0 {
            c.fail_node(p, n, types.compound_ty_msg(aop, gty, ty))
        }
        if (aop == 5 || aop == 6) && ty == 1 {
            c.check_compound_div(p, n, false, 0, p.nodes[n].b)
        }
        c.set_nconst(t, -1000 - gi)
        c.set_ntype(t, gty)
        << true
}

fn (c $&Checker) check_assign_field(p &parser.Parser, n int, t int, aop int) {
        if c.try_assign_mod_global(p, n, t, aop) {
            <<
        }
        // Base: an Ident naming a mutable local, extern global, or a Field/Index chain
        // rooted in one (nested lvalue, mirror bootstrap MIR). Writes
        // through ref-typed intermediates are rejected — M10 tracks
        // ref locals only (reads through stored refs are fine).
        obj := p.nodes[t].a
        kobj := p.nodes[obj].kind
        deref_obj := kobj == ast.NK_UN_OP && p.nodes[obj].ival == ast.UN_DEREF
        if kobj != ast.NK_IDENT && kobj != ast.NK_FIELD && kobj != ast.NK_INDEX && !deref_obj {
            c.fail_node(p, n, "field assignment base must be a variable (M6b2-s3c)")
            <<
        }
        obj_ty := c.check_expr(p, obj)
        oty := c.direct_type(obj_ty)
        root := c.borrow_root_local(p, obj)
        root_g := c.expr_global_root(p, obj)
        // `(*p).f = v` / `(*p).a.b = v` through a raw pointer: the write goes
        // to memory the program vouched for in an unsafe block; there is no
        // owning local to track.
        raw_root := root < 0 && root_g < 0 && c.place_raw_deref_root(p, obj)
        if raw_root && c.env.unsafe_depth == 0 {
            c.fail_node(p, obj, "writing through a raw pointer requires an unsafe block")
            <<
        }
        if root < 0 && root_g < 0 && !raw_root {
            c.fail_node(p, obj, "field assignment base must be a variable (M6b2-s3c)")
            <<
        }
        $root_ref := false
        if root >= 0 {
            if types.is_mut_ref_type(c.env.ltype[root]) {
                // `$&` receiver/local: nested field writes (`d.dc.t0 = …`)
                // take mutability from the root, matching bootstrap.
                root_ref = true
            }
            if types.is_ref_type(c.env.ntype[obj]) {
                // M161: bare writable reference local, or one-level field-stored writable reference (`h.r.v`).
                if kobj == ast.NK_IDENT {
                    // ok
                } else if kobj == ast.NK_FIELD && types.is_mut_ref_type(c.env.ntype[obj]) {
                    // ok — field-stored exclusive ref
                } else {
                    c.fail_node(p, obj, "cannot assign through a reference stored in a field or element")
                }
                if !types.is_mut_ref_type(c.env.ntype[obj]) {
                    c.fail_node(p, obj, "cannot assign through shared reference '" + c.env.lname[root] + "'" + c.shared_write_help(root))
                }
                root_ref = true // A writable reference carries the mutability itself
            }
            if !root_ref && c.env.lmut[root] == 0 {
                c.fail_node(p, obj, "cannot assign to field of immutable variable '" + c.env.lname[root] + "'" + binding_mut_help(c.env.lname[root]))
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, obj, "use of moved value '" + c.env.lname[root] + "'")
            }
        } else if root_g >= 0 {
            c.check_global_write(p, obj, root_g)
        }
        if !types.is_struct_type(oty) {
            c.fail_node(p, obj, "field assignment on non-struct value")
            <<
        }
        si := types.struct_index(oty)
        fi := c.find_field(si, p.nodes[t].sval)
        if fi < 0 {
            c.fail_node(p, t, "struct has no field '" + p.nodes[t].sval + "'")
            <<
        }
        c.require_field_visible(p, t, si, fi)
        // M151: allow rebinding a ref-typed field (`h.r = $&y`).
        // Compound ops stay illegal. Write-through of a stored ref is
        // still rejected above. Array elements cannot hold refs.
        fty_expect := c.env.structs[si].fields[fi].ty
        if types.is_ref_type(fty_expect) && aop != 1 {
            c.fail_node(p, n, "cannot use compound assignment on a reference")
        }
        $fty := c.check_expr(p, p.nodes[n].b)
        fty = c.coerce_to(p, p.nodes[n].b, fty, fty_expect)
        if fty != fty_expect {
            c.fail_node(p, n, "type mismatch: expected " + c.diag_type_display(fty_expect) + ", found " + c.diag_type_display(fty) + c.borrow_type_hint(p, p.nodes[n].b, fty_expect, fty))
        }
        if aop >= 2 && types.compound_ty_ok(aop, fty) == 0 {
            c.fail_node(p, n, types.compound_ty_msg(aop, fty_expect, fty))
        }
        if (aop == 5 || aop == 6) && fty == 1 {
            c.check_compound_div(p, n, false, 0, p.nodes[n].b)
        }
        c.move_of(p, p.nodes[n].b, fty, false)
        if kobj == ast.NK_IDENT && root >= 0 && root < c.lfcons.len {
            bit := field_bit(fi)
            if bit != 0 {
                old := c.lfcons[root]
                typeenv.checker_set_i($&c.lfcons, root, old - (old & bit))
            }
        }
        if kobj == ast.NK_IDENT {
            c.lp_clear_at(root, fi + 1)
        }
        if kobj == ast.NK_FIELD && root >= 0 {
            pp := c.as_place_path(p, obj)
            if pp > 0 && fi >= 0 && fi < 63 {
                c.lp_clear_at(root, pp * 64 + (fi + 1))
            }
        }
        if root >= 0 && c.type_contains_ref(fty_expect) && !types.is_ref_type(c.env.ltype[root]) {
            // Conservative: drop M150 elision eligibility for the root.
            typeenv.checker_set_i($&c.lrefok, root, 0)
        }
        c.set_nlocal(t, root) // root local id (mir branches on the node kind)
        c.set_nlocal(n, fi  ) // field index
        <<
}

fn (c $&Checker) check_assign_index(p &parser.Parser, n int, t int, aop int) {
        raw_at := c.check_expr(p, p.nodes[t].a)
        at := c.direct_type(raw_at)
        mt := c.peel_map(raw_at)
        if mt >= 0 {
            if aop != 1 {
                c.fail_node(p, n, "compound assignment is not supported on map elements")
            }
            root := c.borrow_root_local(p, p.nodes[t].a)
            if root < 0 {
                c.fail_node(p, t, "assignment target must be an element of a variable")
                <<
            }
            if types.is_ref_type(c.env.ltype[root]) {
                if !types.is_mut_ref_type(c.env.ltype[root]) {
                    c.fail_node(p, t, "cannot assign through shared reference '" + c.env.lname[root] + "'" + c.shared_write_help(root))
                }
            } else if c.env.lmut[root] == 0 {
                c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.env.lname[root] + "'" + binding_mut_help(c.env.lname[root]))
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, t, "use of moved value '" + c.env.lname[root] + "'")
            }
            kt := c.check_expr(p, p.nodes[t].b)
            wantk := c.env.maps[types.map_index(mt)].key_ty
            if kt != wantk {
                c.fail_node(p, p.nodes[t].b, "type mismatch: expected " + c.diag_type_display(wantk) + ", found " + c.diag_type_display(kt) + c.borrow_type_hint(p, p.nodes[t].b, wantk, kt))
            }
            want := c.env.maps[types.map_index(mt)].val_ty
            $vty := c.check_expr(p, p.nodes[n].b)
            vty = c.coerce_to(p, p.nodes[n].b, vty, want)
            if vty != want {
                c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(vty) + c.borrow_type_hint(p, p.nodes[n].b, want, vty))
            }
            c.set_ncall(t, -78)
            c.set_ncall(n, -78)
            c.move_of(p, p.nodes[n].b, vty, false)
            c.set_ntype(t, want)
            <<
        }
        if c.is_maps_table(at) {
            if aop != 1 {
                c.fail_node(p, n, "compound assignment is not supported on map elements")
            }
            root := c.borrow_root_local(p, p.nodes[t].a)
            if root < 0 {
                c.fail_node(p, t, "assignment target must be an element of a variable")
                <<
            }
            if types.is_ref_type(c.env.ltype[root]) {
                if !types.is_mut_ref_type(c.env.ltype[root]) {
                    c.fail_node(p, t, "cannot assign through shared reference '" + c.env.lname[root] + "'" + c.shared_write_help(root))
                }
            } else if c.env.lmut[root] == 0 {
                c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.env.lname[root] + "'" + binding_mut_help(c.env.lname[root]))
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, t, "use of moved value '" + c.env.lname[root] + "'")
            }
            kt := c.check_expr(p, p.nodes[t].b)
            if kt != 3 {
                c.fail_node(p, p.nodes[t].b, "map key type must be string")
            }
            want := c.maps_val_ty(at)
            $vty := c.check_expr(p, p.nodes[n].b)
            vty = c.coerce_to(p, p.nodes[n].b, vty, want)
            if vty != want {
                c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(vty) + c.borrow_type_hint(p, p.nodes[n].b, want, vty))
            }
            set_fi := c.find_method(at, "set")
            if set_fi < 0 {
                c.fail_node(p, n, "internal: maps.set missing")
            }
            c.set_ncall(t, set_fi)
            c.set_ncall(n, set_fi)
            c.move_of(p, p.nodes[n].b, vty, false)
            c.set_ntype(t, want)
            <<
        }
        if at == 3 {
            if aop != 1 {
                c.fail_node(p, n, "compound assignment is not supported on string bytes")
                <<
            }
            if types.is_ref_type(raw_at) {
                c.fail_node(p, t, "string index assignment requires an owned local")
                <<
            }
            root := c.borrow_root_local(p, p.nodes[t].a)
            if root < 0 || p.nodes[p.nodes[t].a].kind != ast.NK_IDENT {
                c.fail_node(p, t, "string index assignment requires a local")
                <<
            }
            if c.env.lmut[root] == 0 {
                c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.env.lname[root] + "'" + binding_mut_help(c.env.lname[root]))
                <<
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, t, "use of moved value '" + c.env.lname[root] + "'")
                <<
            }
            if c.check_expr(p, p.nodes[t].b) != 1 {
                c.fail_node(p, p.nodes[t].b, "string index must be int")
                <<
            }
            $vty := c.check_expr(p, p.nodes[n].b)
            vty = c.coerce_to(p, p.nodes[n].b, vty, 1)
            if vty != 1 {
                c.fail_node(p, p.nodes[n].b, "string byte assignment expects int")
                <<
            }
            c.set_ntype(t, 1)
            <<
        }
        if !types.is_array_type(at) {
            c.fail_node(p, t, "index assignment requires an array")
            <<
        }
        root := c.borrow_root_local(p, p.nodes[t].a)
        root_g := c.expr_global_root(p, p.nodes[t].a)
        if root < 0 && root_g < 0 {
            c.fail_node(p, t, "assignment target must be an element of a variable")
            <<
        }
        if root >= 0 {
            if types.is_ref_type(c.env.ltype[root]) {
                if !types.is_mut_ref_type(c.env.ltype[root]) {
                    c.fail_node(p, t, "cannot assign through shared reference '" + c.env.lname[root] + "'" + c.shared_write_help(root))
                }
            } else if c.env.lmut[root] == 0 {
                c.fail_node(p, t, "cannot assign to an element of immutable variable '" + c.env.lname[root] + "'" + binding_mut_help(c.env.lname[root]))
            }
            if c.lmoved[root] != 0 {
                c.fail_node(p, t, "use of moved value '" + c.env.lname[root] + "'")
            }
        } else {
            c.check_global_write(p, t, root_g)
        }
        it := c.check_expr(p, p.nodes[t].b)
        if it != 1 { c.fail_node(p, p.nodes[t].b, "array index must be int") }
        ety := c.env.arrays[types.array_index(at)].elem_ty
        $vty := c.check_expr(p, p.nodes[n].b)
        vty = c.coerce_to(p, p.nodes[n].b, vty, ety)
        if vty != ety {
            c.fail_node(p, p.nodes[n].b, "array element assignment type mismatch")
        }
        if aop >= 2 && types.compound_ty_ok(aop, ety) == 0 {
            if aop == 6 {
                c.fail_node(p, n, "compound assignment %= requires int array elements")
            } else {
                c.fail_node(p, n, "compound assignment requires int or f64 array elements")
            }
        }
        if (aop == 5 || aop == 6) && ety == 1 {
            c.check_compound_div(p, n, false, 0, p.nodes[n].b)
        }
        c.move_of(p, p.nodes[n].b, vty, false)
        if p.nodes[p.nodes[t].a].kind == ast.NK_IDENT && root >= 0 && root < c.lfcons.len {
            ei := c.as_const_index(p, p.nodes[t].b)
            bit := field_bit(ei)
            if bit != 0 {
                old := c.lfcons[root]
                typeenv.checker_set_i($&c.lfcons, root, old - (old & bit))
            }
        }
        if root >= 0 && p.nodes[p.nodes[t].a].kind == ast.NK_FIELD {
            pp := c.as_place_path(p, t)
            if pp >= 64 {
                c.lp_clear_at(root, pp)
            }
        }
        if root >= 0 && c.type_contains_ref(vty) && !types.is_ref_type(c.env.ltype[root]) {
            typeenv.checker_set_i($&c.lrefok, root, 0)
        }
        c.set_ntype(t, ety)
        <<
}

fn (c $&Checker) check_assign_deref(p &parser.Parser, n int, t int, aop int) {
    if p.nodes[t].ival != 3 {
        c.fail_node(p, n, "assignment target not supported yet (M6b2-s3c: variable or field)")
        <<
    }
    inner := p.nodes[t].a
    rty := c.check_expr(p, inner)
    if types.is_raw_ptr_type(rty) {
        if c.env.unsafe_depth == 0 {
            c.fail_node(p, t, "dereferencing raw pointer requires an unsafe block")
        }
        pty := c.ref_inner_type(rty)
        $vty := c.check_expr(p, p.nodes[n].b)
        vty = c.coerce_to(p, p.nodes[n].b, vty, pty)
        if vty != pty {
            c.fail_node(p, n, "type mismatch: expected " + c.diag_type_display(pty) + ", found " + c.diag_type_display(vty) + c.borrow_type_hint(p, p.nodes[n].b, pty, vty))
        }
        c.move_of(p, p.nodes[n].b, vty, false)
        c.set_ntype(t, pty)
        <<
    }
    if !types.is_ref_type(rty) {
        c.fail_node(p, t, "cannot dereference non-reference type '" + c.ty_display(rty) + "'")
        <<
    }
    if !types.is_mut_ref_type(rty) {
        $msg := "cannot assign through shared reference"
        if p.nodes[inner].kind == ast.NK_IDENT {
            msg = "cannot assign through shared reference '" + p.nodes[inner].sval + "'"
        }
        $id := -1
        if p.nodes[inner].kind == ast.NK_IDENT { id = c.env.nlocal[inner] }
        msg = msg + c.shared_write_help(id)
        c.fail_node(p, t, msg)
    }
    pty := c.ref_inner_type(rty)
    if !types.deref_copy_ok(pty) {
        c.fail_node(p, t, "cannot dereference owning type '" + c.ty_display(pty) + "'")
    }
    $vty := c.check_expr(p, p.nodes[n].b)
    vty = c.coerce_to(p, p.nodes[n].b, vty, pty)
    if vty != pty {
        c.fail_node(p, n, "type mismatch: expected " + c.diag_type_display(pty) + ", found " + c.diag_type_display(vty) + c.borrow_type_hint(p, p.nodes[n].b, pty, vty))
    }
    if aop >= 2 && types.compound_ty_ok(aop, vty) == 0 {
        c.fail_node(p, n, types.compound_ty_msg(aop, pty, vty))
    }
    if (aop == 5 || aop == 6) && vty == 1 {
        c.check_compound_div(p, n, false, 0, p.nodes[n].b)
    }
    c.move_of(p, p.nodes[n].b, vty, false)
    c.set_ntype(t, pty)
    <<
}

fn (c $&Checker) check_stmt_assign(p &parser.Parser, n int) {
    t := p.nodes[n].a
    tk := p.nodes[t].kind
    aop := p.nodes[n].ival
    if tk == ast.NK_IDENT {
        c.check_assign_ident(p, n, t, aop)
        <<
    }
    if tk == ast.NK_FIELD {
        c.check_assign_field(p, n, t, aop)
        <<
    }
    if tk == ast.NK_INDEX {
        c.check_assign_index(p, n, t, aop)
        <<
    }
    if tk == ast.NK_UN_OP {
        c.check_assign_deref(p, n, t, aop)
        <<
    }
    c.fail_node(p, n, "assignment target not supported yet (M6b2-s3c: variable or field)")
}

fn (c $&Checker) check_stmt_let(p &parser.Parser, n int) {
    ann := p.nodes[n].b
    saved_or := c.env.or_assign
    c.env.or_assign = p.nodes[n].sval
    $ty := c.check_expr(p, p.nodes[n].a)
    c.env.or_assign = saved_or
    if types.is_error_type(ty) {
        id := c.add_local(p.nodes[n].sval, types.ERROR_TY, p.nodes[n].ival == 1)
        c.set_nlocal(n, id)
        <<
    }
    if ann >= 0 {
        want := c.type_of(p, ann)
        ty = c.coerce_to(p, p.nodes[n].a, ty, want)
        if !c.same_type(ty, want) {
            c.fail_node(p, n, "type mismatch: expected " + c.diag_type_display(want) + ", found " + c.diag_type_display(ty) + c.borrow_type_hint(p, p.nodes[n].a, want, ty))
        }
    }
    if ty == 0 {
        c.fail_node(p, n, "cannot bind a void value")
    }
    if types.is_write_once_box(ty) && p.nodes[n].ival == 1 {
        c.fail_node(p, n, "dynamic temp/any bindings must be immutable")
    }
    c.move_err_n = n
    c.move_of(p, p.nodes[n].a, ty, false)
    c.move_err_n = -1
    id := c.add_local(p.nodes[n].sval, ty, p.nodes[n].ival == 1)
    // M10: ref bindings inherit the initializer's origin.
    // Gen1: avoid `else if c.method(...)` after `$&c.*` in the then arm.
    if types.is_ref_type(ty) {
        si16 := c.expr_ref_origin(p, p.nodes[n].a)
        typeenv.checker_set_i($&c.lorigin, id, si16)
        // MS6 C: track owner of `$&e` for temp/struct@ as through the ref.
        init := p.nodes[n].a
        if p.nodes[init].kind == ast.NK_BORROW && p.nodes[init].ival == 1 {
            tgt := p.nodes[init].a
            if p.nodes[tgt].kind == ast.NK_IDENT {
                oid := c.env.nlocal[tgt]
                if oid >= 0 && types.is_as_box(c.env.ltype[oid]) {
                    c.set_laref(id, oid)
                }
            }
        }
    }
    if !types.is_ref_type(ty) && c.type_contains_ref(ty) {
        // M150: track struct locals whose refs all flow from the param.
        si17 := types.b2i(c.refs_flow_from_param(p, p.nodes[n].a, ty))
        typeenv.checker_set_i($&c.lrefok, id, si17)
    }
    // M36 v1: track a single-assignment int constant for ANY binding
    // (mutable too — reassignment removes the entry); lengths only for
    // immutable bindings (mirror xuhir track_let).
    if ty == 1 && c.is_expr_int(p, p.nodes[n].a) {
        si18 := c.expr_int_value(p, p.nodes[n].a)
        typeenv.checker_set_i($&c.lconst, id, si18)
        typeenv.checker_set_i($&c.lconst_ok, id, 1)
    }
    if ty == 1 && c.expr_int_range_nonzero(p, p.nodes[n].a) {
        c.note_nonzero(id)
    }
    if p.nodes[n].ival != 1 {
        if types.is_array_type(ty) || ty == 3 {
            ln := c.known_len_of(p, p.nodes[n].a)
            if ln >= 0 {
                typeenv.checker_set_i($&c.llength, id, ln)
                typeenv.checker_set_i($&c.llength_ok, id, 1)
            } else {
                lb := c.known_len_lb_of(p, p.nodes[n].a)
                if lb >= 0 {
                    typeenv.checker_set_i($&c.llength, id, lb)
                    typeenv.checker_set_i($&c.llength_ok, id, 2)
                }
            }
        }
    }
    initn := p.nodes[n].a
    if initn >= 0 && p.nodes[initn].kind == ast.NK_IDENT {
        src := c.env.nlocal[initn]
        if src >= 0 {
            typeenv.checker_set_i($&c.calias, id, src)
            if src < c.int_len_of.len && c.int_len_of[src] >= 0 {
                src_arr := c.int_len_of[src]
                typeenv.checker_set_i($&c.int_len_of, id, src_arr)
            }
        }
    }
    alen := c.len_field_local(p, initn)
    if alen >= 0 {
        typeenv.checker_set_i($&c.int_len_of, id, alen)
    }
    c.maybe_binsearch_mid(p, n, id)
    c.set_nlocal(n, id)
    <<
}

fn (c $&Checker) check_stmt_return(p &parser.Parser, n int) {
    if c.env.cur_noreturn != 0 {
        c.fail_node(p, n, "cannot return from @noreturn function")
        <<
    }
    if p.nodes[n].a >= 0 {
        $ty := c.check_expr(p, p.nodes[n].a)
        if types.is_error_type(ty) {
            <<
        }
        if c.env.cur_ret == 0 {
            c.fail_node(p, n, "return with a value in a void function")
        }
        ty = c.coerce_to(p, p.nodes[n].a, ty, c.env.cur_ret)
        if !c.same_type(ty, c.env.cur_ret) {
            c.fail_node(p, n, "type mismatch: expected " + c.diag_type_display(c.env.cur_ret) + ", found " + c.diag_type_display(ty) + c.borrow_type_hint(p, p.nodes[n].a, c.env.cur_ret, ty))
        }
        // M10/M150/M156: ref << must flow from param; explicit lifetime match.
        if types.is_ref_type(c.env.cur_ret) {
            origin := c.expr_ref_origin(p, p.nodes[n].a)
            if origin < 0 {
                c.fail_node(p, n, "cannot return a reference to local data")
            }
            if c.env.cur_ret_life != "" {
                if origin >= c.llife.len || c.llife[origin] != c.env.cur_ret_life {
                    c.fail_node(p, n, "returned reference does not match lifetime '" + c.env.cur_ret_life + "'")
                }
            }
        }
        if !types.is_ref_type(c.env.cur_ret) && c.type_contains_ref(c.env.cur_ret) {
            if !c.refs_flow_from_param(p, p.nodes[n].a, c.env.cur_ret) {
                c.fail_node(p, n, "cannot return type containing references to local data")
            }
        }
        c.move_of(p, p.nodes[n].a, ty, true)
    } else {
        if c.env.cur_ret != 0 {
            c.fail_node(p, n, "missing return value")
        }
    }
    <<
}

fn (c $&Checker) check_stmt_if_loops(p &parser.Parser, n int) {
    k := p.nodes[n].kind
    if k == ast.NK_IF { // If
        // MS6: snapshot moved flags of locals live at if-entry. Each arm
        // starts from that set; after join, temp linear-dynamic box consumed
        // via `as` on a fall-through arm is dead on all paths.
        $snap := c.as_join_snap()
        $join_cons := []int{}
        $br := p.nodes[n].a
        $arm_idx := 0
        while br >= 0 {
        c.as_join_restore(&snap)
        $ub_lid := -1
        $ub_had := false
        $ub_prev := 0
        $nz_then_lids := []int{}
        $nz_then_had := []int{}
        if p.nodes[br].a >= 0 {
            ty := c.check_expr(p, p.nodes[br].a)
            if ty != 2 {
                c.fail_node(p, br, "type mismatch: expected bool, found " + c.diag_type_display(ty))
            }
            c.as_join_update_snap($&snap)
            // MS6 A2: then-arm `if n <= 1` refines lub for the arm body.
            ub_lid = c.le_ub_local(p, p.nodes[br].a)
            if ub_lid >= 0 && ub_lid < c.lub_ok.len {
                ub_had = c.lub_ok[ub_lid] != 0
                ub_prev = c.lub[ub_lid]
                c.note_lub(ub_lid, c.le_ub_value(p, p.nodes[br].a))
            }
            c.collect_then_nonzero(p, p.nodes[br].a, $&nz_then_lids)
            nz_then_had = c.push_nonzero_list(&nz_then_lids)
        }
        c.push_scope(2)
        $s := p.nodes[br].b
        first := s
        while s >= 0 {
            c.check_stmt(p, s)
            s = p.nodes[s].next
        }
        term := stmts_always_exit(p, first)
        c.pop_scope(p, true, term)
        // M36 W2: single-arm guard → proven nonzero after exit.
        if arm_idx == 0 && p.nodes[br].next < 0 && term {
            cond := p.nodes[br].a
            if cond >= 0 {
                $g_lids := []int{}
                $g_recvs := []int{}
                $g_names := []string{}
                c.collect_guard_nonzero(p, cond, $&g_lids, $&g_recvs, $&g_names)
                for gi in 0:g_lids.len {
                    c.note_nonzero(g_lids[gi])
                }
                for gi in 0:g_recvs.len {
                    c.note_field_nonzero(g_recvs[gi], ~g_names[gi])
                }
            }
        }
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            if ub_had {
                typeenv.checker_set_i($&c.lub, ub_lid, ub_prev)
                typeenv.checker_set_i($&c.lub_ok, ub_lid, 1)
            } else {
                typeenv.checker_set_i($&c.lub_ok, ub_lid, 0)
            }
        }
        c.pop_nonzero_list(&nz_then_lids, &nz_then_had)
        c.as_join_after_arm(&snap, term, $&join_cons)
        br = p.nodes[br].next
        arm_idx += 1
        }
        c.as_join_finish(&snap, join_cons)
        <<
    }
    if k == ast.NK_FOR { // For
        t1 := c.check_expr(p, p.nodes[n].a)
        t2 := c.check_expr(p, p.nodes[n].b)
        if t1 != 1 || t2 != 1 {
            c.fail_node(p, n, "for range bounds must be int")
        }
        c.loop_as_enter()
        c.push_scope(2)
        id := c.add_local(p.nodes[n].sval, 1, false)
        c.set_nlocal(n, id)
        // M175: resolve nlocal on range exprs before body (needed for len_field_local).
        pushed := c.try_induct_for(p, n, id)
        c.kill_lconst_written(p, p.nodes[n].c)
        lnz_snap_for := c.snapshot_lnz()
        $ub_lid := -1
        $ub_had := false
        $ub_prev := 0
        fub := c.for_range_var_ub(p, n)
        if fub >= 0 && id >= 0 && id < c.lub_ok.len {
            ub_lid = id
            ub_had = c.lub_ok[id] != 0
            ub_prev = c.lub[id]
            c.note_lub(id, fub)
        }
        c.loop_depth += 1
        $s := p.nodes[n].c
        $term := false
        while s >= 0 {
        c.check_stmt(p, s)
        term = stmt_always_exit(p, s)
        s = p.nodes[s].next
        }
        c.loop_depth -= 1
        c.restore_lnz_after_loop(&lnz_snap_for)
        if pushed == 1 { c.induct_pop() }
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            if ub_had {
                typeenv.checker_set_i($&c.lub, ub_lid, ub_prev)
                typeenv.checker_set_i($&c.lub_ok, ub_lid, 1)
            } else {
                typeenv.checker_set_i($&c.lub_ok, ub_lid, 0)
            }
        }
        if !term {
            c.loop_as_union(false)
        }
        c.pop_scope(p, true, term)
        c.loop_as_finish(p, n)
        <<
    }
    if k == ast.NK_FOR_EACH { // ForEach
        raw_at := c.check_expr(p, p.nodes[n].a)
        at := c.direct_type(raw_at)
        mt := c.peel_map(raw_at)
        if mt >= 0 {
            if p.nodes[n].sval2.len == 0 {
                c.fail_node(p, n, "map for-in requires two variables: for k, v in m")
            }
            kty := c.env.maps[types.map_index(mt)].key_ty
            vty := c.env.maps[types.map_index(mt)].val_ty
            if c.type_owning(vty) && vty != 3 {
                c.fail_node(p, n, "cannot iterate a map of non-string owning values; use take or an index loop")
            }
            c.set_ntype(n, vty)
            c.set_ncall(n, -91)
            c.loop_as_enter()
            c.push_scope(2)
            kid := c.add_local(p.nodes[n].sval, kty, false)
            vid := c.add_local(p.nodes[n].sval2, vty, false)
            c.set_nlocal(n, kid)
            c.set_nconst(n, vid)
            c.kill_lconst_written(p, p.nodes[n].c)
            lnz_snap_map := c.snapshot_lnz()
            c.loop_depth += 1
            $s := p.nodes[n].c
            $term := false
            while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
            }
            c.loop_depth -= 1
            c.restore_lnz_after_loop(&lnz_snap_map)
            if !term {
                c.loop_as_union(false)
            }
            c.pop_scope(p, true, term)
            c.loop_as_finish(p, n)
            <<
        }
        if p.nodes[n].sval2.len > 0 {
            c.fail_node(p, n, "for-in with two variables requires a map")
        }
        $ety := 0
        $view := false
        if types.is_array_type(at) {
            ai := types.array_index(at)
            ety = c.env.arrays[ai].elem_ty
            if c.type_owning(ety) && ety != 3 {
                if types.is_struct_type(ety) {
                    root := c.borrow_root_local(p, p.nodes[n].a)
                    if root < 0 {
                        c.fail_node(p, n, "cannot iterate an array of owning structs unless it is a local variable")
                    }
                    if c.place_has_index(p, p.nodes[n].a) {
                        c.fail_node(p, n, "cannot iterate a nested array of owning structs; use an index loop")
                    }
                    view = true
                } else {
                    c.fail_node(p, n, "cannot iterate an array of non-string owning values; use an index loop")
                }
            }
        } else if types.is_chan_type(at) {
            if c.env.in_irq == 1 {
                c.fail_node(p, n, "cannot use channels in irq handler")
            }
            ety = c.env.chans[types.chan_index(at)].elem_ty
        } else {
            c.fail_node(p, p.nodes[n].a, "for-in requires an array or channel, found " + c.ty_display(at))
        }
        c.set_ntype(n, ety)
        c.loop_as_enter()
        c.push_scope(2)
        id := c.add_local(p.nodes[n].sval, ety, false)
        if view {
            c.set_lview(id, 1)
        }
        c.set_nlocal(n, id)
        c.kill_lconst_written(p, p.nodes[n].c)
        lnz_snap_arr := c.snapshot_lnz()
        c.loop_depth += 1
        $s := p.nodes[n].c
        $term := false
        while s >= 0 {
        c.check_stmt(p, s)
        term = stmt_always_exit(p, s)
        s = p.nodes[s].next
        }
        c.loop_depth -= 1
        c.restore_lnz_after_loop(&lnz_snap_arr)
        if !term {
            c.loop_as_union(false)
        }
        c.pop_scope(p, true, term)
        c.loop_as_finish(p, n)
        <<
    }
    if k == ast.NK_WHILE { // While
        ty := c.check_expr(p, p.nodes[n].a)
        if ty != 2 {
            c.fail_node(p, n, "type mismatch: expected bool, found " + c.diag_type_display(ty))
        }
        pushed := c.try_induct_while(p, n)
        c.cur_while = n
        c.bs_ok = 0
        cn0 := p.nodes[n].a
        if cn0 >= 0 && p.nodes[cn0].kind == ast.NK_BIN_OP && p.nodes[cn0].ival == 8 {
            lol := c.ident_local(p, p.nodes[cn0].a)
            if lol >= 0 && lol < c.lconst_ok.len {
                if c.lconst_ok[lol] != 0 && c.lconst[lol] == 0 {
                    c.bs_ok = 1
                }
            }
        }
        nind := c.induct_var.len
        // Refine lub for the body from `i < K` / `i <= K` (same as if-arms).
        // Apply AFTER kill_lconst_written — that helper also clears lub on
        // written names (the loop counter), which would undo note_lub.
        $ub_lid := -1
        $ub_had := false
        $ub_prev := 0
        ub_lid = c.le_ub_local(p, p.nodes[n].a)
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            ub_had = c.lub_ok[ub_lid] != 0
            ub_prev = c.lub[ub_lid]
        }
        $t_zero := 0
        cond0 := p.nodes[n].a
        if cond0 >= 0 && p.nodes[cond0].kind == ast.NK_BIN_OP && p.nodes[cond0].ival == 8 {
            lh := p.nodes[cond0].a
            if lh >= 0 && p.nodes[lh].kind == ast.NK_IDENT {
                tl := c.env.nlocal[lh]
                if tl >= 0 && tl < c.lconst_ok.len {
                    if c.lconst_ok[tl] != 0 && c.lconst[tl] == 0 {
                        t_zero = 1
                    }
                }
            }
        }
        c.kill_lconst_written(p, p.nodes[n].c)
        lnz_snap_while := c.snapshot_lnz()
        $nz_while_lids := []int{}
        c.collect_then_nonzero(p, p.nodes[n].a, $&nz_while_lids)
        _ := c.push_nonzero_list(&nz_while_lids)
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            c.note_lub(ub_lid, c.le_ub_value(p, p.nodes[n].a))
        }
        // Lengths before the body: its pushes reset them while checking.
        $len0 := []int{}
        $len0_ok := []int{}
        if t_zero == 1 {
            copy_ints($&len0, &c.llength)
            copy_ints($&len0_ok, &c.llength_ok)
        }
        c.loop_as_enter()
        c.push_scope(2)
        c.loop_depth += 1
        $s := p.nodes[n].c
        $term := false
        while s >= 0 {
        c.check_stmt(p, s)
        term = stmt_always_exit(p, s)
        s = p.nodes[s].next
        }
        c.loop_depth -= 1
        c.restore_lnz_after_loop(&lnz_snap_while)
        c.cur_while = 0 - 1
        while c.induct_var.len > nind {
            c.induct_pop()
        }
        if pushed == 1 { c.induct_pop() }
        if ub_lid >= 0 && ub_lid < c.lub_ok.len {
            if ub_had {
                typeenv.checker_set_i($&c.lub, ub_lid, ub_prev)
                typeenv.checker_set_i($&c.lub_ok, ub_lid, 1)
            } else {
                typeenv.checker_set_i($&c.lub_ok, ub_lid, 0)
            }
        }
        if !term {
            c.loop_as_union(false)
        }
        c.pop_scope(p, true, term)
        c.loop_as_finish(p, n)
        c.try_note_fill_len(p, n, t_zero, &len0, &len0_ok)
        <<
    }
    if k == ast.NK_BREAK { // Break
        if c.loop_depth <= 0 {
            c.fail_node(p, n, "'<-' is only allowed inside a for or while loop")
        }
        c.loop_as_union(true)
        <<
    }
    if k == ast.NK_CONTINUE { // Continue
        if c.loop_depth <= 0 {
            c.fail_node(p, n, "'->' is only allowed inside a for or while loop")
        }
        c.loop_as_union(false)
        <<
    }
}

// Wave C: match stmt — split from check_stmt_match_select_xu (W3).
fn (c $&Checker) check_stmt_match(p &parser.Parser, n int) {
 // Match
        sty := c.check_expr(p, p.nodes[n].a)
        if sty == 1 {
            c.push_scope(0)
            c.add_local("_match", sty, false)
            $snap := c.as_join_snap()
            $join_cons := []int{}
            $ar := p.nodes[n].b
            $seen_else := false
            while ar >= 0 {
            if p.nodes[ar].kind == ast.NK_ARM_ELSE {
                if seen_else {
                    c.fail_node(p, ar, "duplicate else arm")
                }
                seen_else = true
            } else if p.nodes[ar].kind == ast.NK_ARM_ENUM {
                c.fail_node(p, ar, "enum pattern cannot match an int subject")
            } else if p.nodes[ar].kind == ast.NK_ARM_STR {
                c.fail_node(p, ar, "string pattern cannot match an int subject")
            } else if p.nodes[ar].kind == ast.NK_ARM_RANGE {
                lo := p.nodes[ar].ival
                hi := p.nodes[ar].d
                rk := range_ival_from_str(p.nodes[ar].sval2)
                // Empty patterns are decided on the raw endpoints so `hi-1`
                // cannot overflow at INT_MIN / INT_MAX.
                //   : / -<  [lo,hi)  empty iff lo >= hi
                //   --      [lo,hi]  empty iff lo >  hi
                //   >-      (lo,hi]  empty iff lo >= hi
                //   >-<     (lo,hi)  empty iff lo + 1 >= hi
                $empty := false
                if rk == 0 || rk == 1 || rk == 5 || rk == 2 {
                    // half-open / open-start: empty iff lo >= hi
                    empty = lo >= hi
                } else if rk == 4 {
                    empty = lo > hi
                } else {
                    // >-< open-open: empty iff no integer in (lo, hi)
                    if lo >= hi {
                        empty = true
                    } else if lo == 9223372036854775807 {
                        empty = true
                    } else {
                        empty = lo + 1 >= hi
                    }
                }
                if empty {
                    c.fail_node(p, ar, "match range " + match_range_display(p.nodes[ar].ival, p.nodes[ar].d, p.nodes[ar].sval2) + " is empty")
                }
            }
            c.as_join_restore(&snap)
            c.push_scope(2)
            $s := p.nodes[ar].c
            $term := false
            while s >= 0 {
                c.check_stmt(p, s)
                term = stmt_always_exit(p, s)
                s = p.nodes[s].next
            }
            c.pop_scope(p, true, term)
            c.as_join_after_arm(&snap, term, $&join_cons)
            ar = p.nodes[ar].next
            }
            c.pop_scope(p, false, false)
            c.as_join_finish(&snap, join_cons)
            <<
        }
        if sty == 3 {
            c.check_string_match(p, n)
            <<
        }
        if types.is_enum_type(sty) {
            c.check_enum_match(p, n, sty)
            <<
        }
        c.fail_node(p, p.nodes[n].a, "match subject must be int, enum, or string, found " + c.ty_display(sty))
        <<
}

// Wave C: xu stmt — split from check_stmt_match_select_xu (W3).
fn (c $&Checker) check_stmt_xu(p &parser.Parser, n int) {
 // Xu (M17)
        call := p.nodes[n].a
        if p.nodes[call].kind != ast.NK_CALL {
            c.fail_node(p, n, "xu requires a function call (xu f(args))")
        }
        // Clone name: find_fn takes by value (move).
        name := p.nodes[call].sval
        $fi := c.find_fn(name)
        if fi < 0 {
            c.fail_node(p, n, "undefined function '" + p.nodes[call].sval + "' in xu")
        }
        $argc := 0
        $arg := p.nodes[call].a
        $arg_nodes := []int{}
        $arg_tys := []int{}
        while arg >= 0 {
            aty := c.check_expr(p, arg)
            // M155 Send: refs / capturing fn Env / nested containers.
            if !c.type_is_send(aty) {
                c.fail_node(p, arg, "xu argument cannot be a reference type (M17)")
            }
            arg_nodes.push(arg)
            arg_tys.push(aty)
            argc = argc + 1
            arg = p.nodes[arg].next
        }
        if argc != c.env.fns[fi].params.len {
            c.fail_node(p, n, "function '" + p.nodes[call].sval + "' expects " + str(c.env.fns[fi].params.len) + " argument(s), found " + str(argc))
        }
        if argc > XU_MAX_ARGS {
            c.fail_node(p, n, "xu supports at most " + str(XU_MAX_ARGS) + " arguments (M17)")
        }
        c.ffi_call_check(p, call, fi)
        if c.env.fns[fi].is_template {
            d := c.env.fndecl[fi]
            $ntp := 0
            $tp := p.nodes[d].e
            while tp >= 0 {
                if !c.fn_has_lt(fi, p.nodes[tp].sval) {
                    ntp += 1
                }
                tp = p.nodes[tp].next
            }
            c.uni_bind = []int{}
            for k3 in 0:ntp {
                c.uni_bind.push(-1)
            }
            for i in 0:c.env.fns[fi].params.len {
                if !c.unify(c.env.fns[fi].params[i], arg_tys[i]) {
                    c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.diag_type_display(c.env.fns[fi].params[i]) + ", found " + c.diag_type_display(arg_tys[i]) + c.borrow_type_hint(p, arg_nodes[i], c.env.fns[fi].params[i], arg_tys[i]))
                }
            }
            tp = p.nodes[d].e
            for k3 in 0:ntp {
                while tp >= 0 && c.fn_has_lt(fi, p.nodes[tp].sval) {
                    tp = p.nodes[tp].next
                }
                if c.uni_bind[k3] < 0 {
                    c.fail_node(p, n, "cannot infer type parameter '" + p.nodes[tp].sval + "' for function '" + p.nodes[call].sval + "'")
                }
                tp = p.nodes[tp].next
            }
            c.load_targs_uni(ntp)
            fi = c.instantiate_fn_n(p, fi, n)
            if fi < 0 { << }
        } else {
            for i in 0:arg_tys.len {
                if !c.same_type(arg_tys[i], c.env.fns[fi].params[i]) {
                    c.fail_node(p, arg_nodes[i], "type mismatch: expected " + c.diag_type_display(c.env.fns[fi].params[i]) + ", found " + c.diag_type_display(arg_tys[i]) + c.borrow_type_hint(p, arg_nodes[i], c.env.fns[fi].params[i], arg_tys[i]))
                }
            }
        }
        for i in 0:arg_nodes.len {
            c.move_of(p, arg_nodes[i], arg_tys[i], false)
        }
        c.set_ncall(n, fi)
        c.record_call(fi)
        <<
}

// Wave C: send stmt — split from check_stmt_match_select_xu (W3).
fn (c $&Checker) check_stmt_send(p &parser.Parser, n int) {
 // Send ch <- v (M17)
        if c.env.in_irq == 1 {
            c.fail_node(p, n, "cannot use channels in irq handler")
        }
        cty := c.check_expr(p, p.nodes[n].a)
        if !types.is_chan_type(cty) {
            c.fail_node(p, n, "send requires a channel, found " + c.ty_display(cty))
        }
        ci := types.chan_index(cty)
        elem := c.env.chans[ci].elem_ty
        vty := c.check_expr(p, p.nodes[n].b)
        if !c.same_type(vty, elem) {
            c.fail_node(p, p.nodes[n].b, "type mismatch: expected " + c.diag_type_display(elem) + ", found " + c.diag_type_display(vty) + c.borrow_type_hint(p, p.nodes[n].b, elem, vty))
        }
        if !c.type_is_send(vty) {
            c.fail_node(p, p.nodes[n].b, "channel element type cannot be a reference")
        }
        c.move_of(p, p.nodes[n].b, vty, false)
        c.set_nlocal(n, ci) // chan id for mir
        <<
}

// Wave C: select stmt — split from check_stmt_match_select_xu (W3).
fn (c $&Checker) check_stmt_select(p &parser.Parser, n int) {
 // Select
        if c.env.in_irq == 1 {
            c.fail_node(p, n, "cannot use channels in irq handler")
        }
        if p.nodes[n].a < 0 {
            c.fail_node(p, n, "select requires at least one send/recv case")
        }
        $snap := c.as_join_snap()
        $join_cons := []int{}
        $ar := p.nodes[n].a
        while ar >= 0 {
        ak := p.nodes[ar].kind
        if ak == ast.NK_SEL_SEND { // SelSend
                cty := c.check_expr(p, p.nodes[ar].a)
                if !types.is_chan_type(cty) {
                    c.fail_node(p, ar, "send requires a channel, found " + c.ty_display(cty))
                }
                ci := types.chan_index(cty)
                elem := c.env.chans[ci].elem_ty
                vty := c.check_expr(p, p.nodes[ar].b)
                if !c.same_type(vty, elem) {
                    c.fail_node(p, p.nodes[ar].b, "type mismatch: expected " + c.diag_type_display(elem) + ", found " + c.diag_type_display(vty) + c.borrow_type_hint(p, p.nodes[ar].b, elem, vty))
                }
                if !c.type_is_send(vty) {
                    c.fail_node(p, p.nodes[ar].b, "channel element type cannot be a reference")
                }
                if c.type_owning(vty) {
                    if vty != 3 {
                        c.fail_node(p, p.nodes[ar].b, "select send of owning non-string is not supported")
                    }
                    c.env.nclone[p.nodes[ar].b] = 1
                }
                c.set_nlocal(ar, ci)
                c.as_join_restore(&snap)
                c.push_scope(2)
                $s := p.nodes[ar].c
                $term := false
                while s >= 0 {
                    c.check_stmt(p, s)
                    term = stmt_always_exit(p, s)
                    s = p.nodes[s].next
                }
                c.pop_scope(p, true, term)
                c.as_join_after_arm(&snap, term, $&join_cons)
            } else if ak == ast.NK_SEL_RECV { // SelRecv
                cty := c.check_expr(p, p.nodes[ar].a)
                if !types.is_chan_type(cty) {
                    c.fail_node(p, ar, "receive requires a channel, found " + c.ty_display(cty))
                }
                ci := types.chan_index(cty)
                elem := c.env.chans[ci].elem_ty
                c.as_join_restore(&snap)
                c.push_scope(2)
                id := c.add_local(p.nodes[ar].sval, elem, false)
                c.set_nlocal(ar, id)
                $s := p.nodes[ar].c
                $term := false
                while s >= 0 {
                    c.check_stmt(p, s)
                    term = stmt_always_exit(p, s)
                    s = p.nodes[s].next
                }
                c.pop_scope(p, true, term)
                c.as_join_after_arm(&snap, term, $&join_cons)
            } else {
            c.fail_node(p, ar, "malformed select arm")
        }
        ar = p.nodes[ar].next
        }
        if p.nodes[n].ival == 1 || p.nodes[n].c >= 0 {
            c.as_join_restore(&snap)
            c.push_scope(2)
            $s := p.nodes[n].c
            $term := false
            while s >= 0 {
            c.check_stmt(p, s)
            term = stmt_always_exit(p, s)
            s = p.nodes[s].next
            }
            c.pop_scope(p, true, term)
            c.as_join_after_arm(&snap, term, $&join_cons)
        }
        c.as_join_finish(&snap, join_cons)
        <<
}

// Wave C: thin dispatcher over match/xu/send/select — split check_stmt_match_select_xu (W3).
fn (c $&Checker) check_stmt_match_select_xu(p &parser.Parser, n int) {
    k := p.nodes[n].kind
    if k == ast.NK_MATCH { // Match
        c.check_stmt_match(p, n)
        <<
    }
    if k == ast.NK_XU { // Xu (M17)
        c.check_stmt_xu(p, n)
        <<
    }
    if k == ast.NK_SEND { // Send ch <- v (M17)
        c.check_stmt_send(p, n)
        <<
    }
    if k == ast.NK_SELECT { // Select
        c.check_stmt_select(p, n)
        <<
    }
}

fn (c $&Checker) check_stmt(p &parser.Parser, n int) {
    if c.fn_failed() {
        <<
    }
    k := p.nodes[n].kind
    if k == ast.NK_LET { // Let
        c.check_stmt_let(p, n)
        <<
    }
    if k == ast.NK_ASSIGN { // Assign
        c.check_stmt_assign(p, n)
        <<
    }
    if k == ast.NK_EXPR_STMT { // ExprStmt
        ec := p.nodes[n].a
        ety := c.check_expr(p, ec)
        if types.is_throw_type(ety) {
            c.fail_node(p, ec, "throwing call must be handled (use `or (err) { }`)")
        }
        <<
    }
    if k == ast.NK_THROW { // Throw
        if !types.is_throw_type(c.env.cur_throw_ty) {
            c.fail_node(p, n, "`>>` is only allowed in functions that may propagate errors")
        }
        c.check_throw_value(p, p.nodes[n].a)
        si19 := c.env.cur_throw_ty
        c.set_ntype(n, si19)
        <<
    }
    if k == ast.NK_EXIT { // Exit <<<
        arg := p.nodes[n].a
        if arg < 0 {
            c.fail_node(p, n, "`<<<` requires an int exit code")
        }
        if c.check_expr(p, arg) != 1 {
            c.fail_node(p, arg, "<<< expects int")
        }
        c.set_ncall(n, -13)
        c.set_ntype(n, 0)
        <<
    }
    if k == ast.NK_RETURN { // Return
        c.check_stmt_return(p, n)
        <<
    }
    if k == ast.NK_IF || k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE || k == ast.NK_BREAK || k == ast.NK_CONTINUE { // If / loops
        unsafe_blk := k == ast.NK_IF && p.nodes[n].sval == "unsafe"
        if unsafe_blk { c.env.unsafe_depth += 1 }
        c.check_stmt_if_loops(p, n)
        if unsafe_blk { c.env.unsafe_depth -= 1 }
        <<
    }
    if k == ast.NK_MATCH || k == ast.NK_XU || k == ast.NK_SEND || k == ast.NK_SELECT { // Match / Xu / Send / Select
        c.check_stmt_match_select_xu(p, n)
        <<
    }
    c.fail_node(p, n, "statement not supported yet (M6b2-s3a)")
}

// ===== expressions =====


// M178: builtins extracted from check_call_expr to shrink stack frame.
// Returns result type if name is a builtin (ntype set); else -1.
// Wave C: hosted env — split from check_call_hosted (W3).
