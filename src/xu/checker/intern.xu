fn (c $&Checker) seed_strmaps() {
    zero_strmap($&c.str_map)
    zero_strmap($&c.fn_map)
    zero_strmap($&c.inst_map)
    zero_strmap($&c.mod_map)
    zero_strmap($&c.alias_map)
    zero_strmap($&c.vis_map)
    zero_strmap($&c.const_map)
    zero_strmap($&c.iface_map)
    zero_strmap($&c.stpl_map)
    zero_strmap($&c.etpl_map)
    zero_strmap($&c.method_map)
    zero_strmap($&c.subst_map)
    zero_strmap($&c.array_map)
    zero_strmap($&c.throw_map)
    zero_strmap($&c.chan_map)
    zero_strmap($&c.map_map)
    zero_strmap($&c.fn_sig_map)
    zero_strmap($&c.iface_glob_map)
}

// Unique empty backing for every slice. run_checker may seed the Checker
// literal from a handful of shared empties; first push must not alias.
fn (c $&Checker) seed_slices() {
    e := $&c.env
    e.seed_env()
    c.imp_owner = []string{}
    c.imp_path = []string{}
    c.imp_alias = []string{}
    c.imp_file = []int{}
    c.mod_ids = []string{}
    c.lmoved = []int{}
    c.pend_ids = []int{}
    c.pend_nodes = []int{}
    c.pend_marks = []int{}
    c.lorigin = []int{}
    c.llife = []string{}
    c.lrefok = []int{}
    c.marks = []int{}
    c.barriers = []int{}
    c.induct_var = []int{}
    c.induct_arr = []int{}
    c.winduct = []int{}
    c.int_len_of = []int{}
    c.wsearch = []int{}
    c.wsearch_mid = []int{}
    c.wsearch_arr = []int{}
    c.sub_names = []string{}
    c.sub_tys = []int{}
    c.tp_names = []string{}
    c.tp_cons = []string{}
    c.stpl_name = []string{}
    c.stpl_mod = []string{}
    c.stpl_decl = []int{}
    c.stpl_pub = []int{}
    c.etpl_name = []string{}
    c.etpl_mod = []string{}
    c.etpl_decl = []int{}
    c.etpl_pub = []int{}
    c.inst_snap_ready = []int{}
    c.inst_snap_type = [][]int{}
    c.inst_snap_local = [][]int{}
    c.inst_snap_call = [][]int{}
    c.inst_snap_str = [][]int{}
    c.inst_snap_const = [][]int{}
    c.inst_snap_clone = [][]int{}
    c.inst_snap_shared = [][]int{}
    c.inst_snap_box = [][]int{}
    c.inst_snap_lo = []int{}
    c.inst_t0 = []int{}
    c.inst_targs = [][]int{}
    c.targs = []int{}
    c.uni_bind = []int{}
    c.lconst = []int{}
    c.lconst_ok = []int{}
    c.lub = []int{}
    c.lub_ok = []int{}
    c.llength = []int{}
    c.llength_ok = []int{}
