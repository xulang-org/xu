@xu/checker
// Semantic checking: name and type resolution, generics, ownership and
// lifetime validation before MIR lowering.

#xu/ast
#xu/borrow
#xu/cbind
#xu/ds
#xu/ffi
#xu/parser
#xu/risks
#xu/typeenv
#xu/types

pub struct Checker {
    env typeenv.TypeEnv
    // M9 imports: (imp_file[i], imp_path[i], imp_alias[i]) triples;
    // import is file-scoped (Go). Alias '' = plain path (M30).
    imp_owner []string
    imp_path []string
    imp_alias []string
    imp_file []int
    mod_ids []string
    // current-function state
    loop_depth int
    // M175/M176: for i in 0 -> a.len induction (parallel stacks; MIR+check).
    induct_var []int
    induct_arr []int
    // Wave 2: while stmt nodes whose body is proven `i < a.len` induction.
    winduct []int
    // Int local that holds `arr.len` (or a copy of such a local).
    int_len_of []int
    // Current while node while checking its body (-1 none).
    cur_while int
    // lo of current while started at 0 (binsearch invariant).
    bs_ok int
    // Binary-search while: node, mid local, array local (persist for MIR).
    wsearch []int
    wsearch_mid []int
    wsearch_arr []int
    lmoved []int
    // M2b deferred moves: locals moved out of an active barrier scope.
    pend_ids []int
    pend_nodes []int
    pend_marks []int
    // M10: for ref-typed locals, origin is Param(local_id) if >=0, else Local (-1).
    lorigin []int
    // M156: lifetime name on ref params ("" = none / elision).
    llife []string
    // M150: struct locals whose embedded refs all flow from the unique ref param.
    lrefok []int
    marks []int
    barriers []int
    rebind int
    // Statement node for move_of errors.
    move_err_n int
    // M11: active type-param substitution (name -> type tag) for type_of.
    sub_names []string
    sub_tys []int
    // Type-param names/constraints of the function being checked (constraint methods).
    tp_names []string
    tp_cons []string
    // Generic struct templates (not yet laid out).
    stpl_name []string
    stpl_mod []string
    stpl_decl []int
    stpl_pub []int
    // Generic enum templates (MS7); laid out on instantiation.
    etpl_name []string
    etpl_mod []string
    etpl_decl []int
    etpl_pub []int
    etpl_map ds.StrMap
    // M190: per-instance AST annotation snapshots (shared template bodies).
    inst_snap_ready []int
    inst_snap_type [][]int
    inst_snap_local [][]int
    inst_snap_call [][]int
    inst_snap_str [][]int
    inst_snap_const [][]int
    inst_snap_clone [][]int
    inst_snap_shared [][]int
    inst_snap_box [][]int
    inst_snap_lo []int
    // Source fn count after pass 1 (instances append after this).
    n_src_fns int
    // Instantiation budget.
    n_fn_inst int
    // Scratch bindings for generic call-site inference (Param index -> type).
    uni_bind []int
    // Scratch type args (collect_type_list_n / instantiate_fn_n); targs_n == targs.len.
    targs []int
    targs_n int
    // Bit per type-tag range already reported as exhausted (type_table_full).
    type_full_mask int
    // M36 v1 constant tracking per local.
    lconst []int
    lconst_ok []int
    // MS6 A2: proven upper bound (local <= lub[i]); independent of exact lconst.
    lub []int
    lub_ok []int
    llength []int
    llength_ok []int
    // M36 W2: proven-nonzero locals after guard.
    lnz []int
    lnz_ok []int
    // M36 W2: proven-nonzero field paths (receiver_local, field_name).
    fnz_recv []int
    fnz_name []string
    // Wave 2: one-hop copy of a local (`j := i` / `j = i`); -1 = none.
    calias []int
    // M36 W1: call-graph edges collected while checking bodies.
    cg_from []int
    cg_to []int
    // M109: closure seq + capture remapping while checking a FnLit body.
    closure_seq int
    cap_active int
    cap_names []string
    cap_fields []int
    cap_tys []int
    // Per-fn: env struct type tag (struct_type(si)) or -1.
    clos_env []int
    // Per-fn: monomorph T0 hint and concrete type-arg list.
    inst_t0 []int
    inst_targs [][]int
    // Scratch for M156 lifetime/named-type collection while registering fns.
    lt_scan []string
    named_scan []string
    // M188/M189: intern + open-address maps.
    str_map ds.StrMap
    fn_map ds.StrMap
    inst_map ds.StrMap
    mod_map ds.StrMap
    alias_map ds.StrMap
    vis_map ds.StrMap
    const_map ds.StrMap
    iface_map ds.StrMap
    stpl_map ds.StrMap
    method_map ds.StrMap
    subst_map ds.StrMap
    array_map ds.StrMap
    throw_map ds.StrMap
    chan_map ds.StrMap
    map_map ds.StrMap
    fn_sig_map ds.StrMap
    iface_glob_map ds.StrMap
    lname_id []int
    lhead []int
    lprev []int
    // MS6 loop CFG: stacked snapshots of lmoved at loop entry.
    las_off []int
    las_snap []int
    las_brk []int
    las_back []int
    // MS6 field-level `as`: per-local bitmask of consumed temp/struct@ fields.
    lfcons []int
    // Nested Field `as` paths.
    lfpath []int
    // Stacked lfcons snapshots / unions for if+match+select as-join.
    aj_off []int
    aj_fc []int
    aj_union []int
    aj_path []int
    aj_path_u []int
    // Loop field-consume snap / break / back-edge unions.
    las_fc []int
    las_fc_brk []int
    las_fc_back []int
    las_path []int
    las_path_brk []int
    las_path_back []int
    mir_lower_ns int
    mir_borrow_gate bool
    mir_verify_passes bool
    mir_ssa_trace bool
    cbind_on bool
    cbind_skip string
    cbind_guard string
    cbind_hdr string
}

// Typecheck (+ optional lower). Caller must allocate Checker in another
// module via `Checker{}` (all fields private → MIR zero-fill). Never return
// Checker by value: windows-x64 large sret leaves map fields as garbage.
pub fn (c &Checker) mir_time_ns() int { << c.mir_lower_ns }

pub fn (c $&Checker) set_mir_borrow_gate(enabled bool) { c.mir_borrow_gate = enabled }

pub fn (c $&Checker) set_mir_verify_passes(enabled bool) { c.mir_verify_passes = enabled }

pub fn (c $&Checker) set_mir_ssa_trace(enabled bool) { c.mir_ssa_trace = enabled }

pub struct DummyMir {
    pub dummy int
    pub opt_level int
}

pub fn run_checker(c $&Checker, p &parser.Parser, target_code int, test_mode int, lib_mode int, lib_ext []string, extern_labs []string, do_lower int, m $&DummyMir, test_names []string, test_filter string, test_verbose bool, test_failfast bool, test_count int, test_list bool, out_fns $&[]typeenv.CFn) {
    c.finish_check(p, target_code, test_mode, lib_mode, lib_ext, extern_labs, do_lower, m, test_names, test_filter, test_verbose, test_failfast, test_count, test_list, out_fns)
}


fn (c $&Checker) finish_check(p &parser.Parser, target_code int, test_mode int, lib_mode int, lib_ext []string, extern_labs []string, do_lower int, m $&DummyMir, test_names []string, test_filter string, test_verbose bool, test_failfast bool, test_count int, test_list bool, out_fns $&[]typeenv.CFn) {
    // Cross-module Checker{} zero-fills private fields. Restore sentinels
    // that are not 0, then unique-empty every map/slice (WoA x64 sret-safe).
    c.rebind = -1
    c.move_err_n = -1
    c.env.attr = -1
    c.cur_while = 0 - 1
    c.env.errors_iface = -1
    c.env.test_count = 1
    c.env.opt_level = 1
    c.seed_strmaps()
    c.seed_slices()
    c.env.opt_level = m.opt_level
    c.prep_nodes(p.nodes.len)
    c.apply_target(target_code)
    if test_mode == 1 {
        c.apply_test_mode()
    }
    if test_failfast {
        c.env.test_failfast = 1
    }
    if test_count > 0 {
        c.env.test_count = test_count
    }
    if test_list {
        c.env.test_list = 1
    }
    c.env.lib_mode = lib_mode
    for i in 0:lib_ext.len {
        c.add_lib_ext(lib_ext[i] + "")
    }
    c.check_program(p)
    for i in 0:c.env.fns.len {
        for j in 0:extern_labs.len {
            if c.env.fns[i].label == extern_labs[j] {
                c.env.fns[i].is_extern = true
            }
        }
    }
    c.emit_warnings(p)
    if c.env.error_count > 0 {
        <<< 1
    }
    if c.cbind_on {
        skip := c.cbind_skip + ""
        guard := c.cbind_guard + ""
        c.cbind_hdr = cbind.emit_cbind_header($&c.env, p, skip, guard)
    }
    c.mir_lower_ns = 0
    for i in 0:c.env.fns.len {
        $ps := []int{}
        plen := c.env.fns[i].params.len
        for j in 0:plen {
            ps.push(c.env.fns[i].params[j])
        }
        $lts := []string{}
        ltlen := c.env.fns[i].lt_params.len
        for j in 0:ltlen {
            lts.push(c.env.fns[i].lt_params[j] + "")
        }
        out_fns.push(typeenv.CFn{
            name: c.env.fns[i].name + "",
            label: c.env.fns[i].label + "",
            ret: c.env.fns[i].ret,
            params: ps,
            recv: c.env.fns[i].recv,
            recv_mut: c.env.fns[i].recv_mut,
            mod_id: c.env.fns[i].mod_id + "",
            is_pub: c.env.fns[i].is_pub,
            is_extern: c.env.fns[i].is_extern,
            is_template: c.env.fns[i].is_template,
            recv_name: c.env.fns[i].recv_name + "",
            variadic: c.env.fns[i].variadic,
            lt_params: lts
        })
    }
    c.release_after_check()
}

pub fn (c $&Checker) release_after_check() {
    e := $&c.env
    e.release_env()
}

pub fn check_only(p &parser.Parser, target_code int, lib_mode int, c $&Checker) {
    empty := []string{}
    check_only_native(p, target_code, lib_mode, &empty, c)
}

pub fn check_only_native(p &parser.Parser, target_code int, lib_mode int, native_labels &[]string, c $&Checker) {
    $m := DummyMir{dummy: 0, opt_level: 0}
    $out_fns := []typeenv.CFn{}
    run_checker(c, p, target_code, 0, lib_mode, ~native_labels, []string{}, 0, $&m, []string{}, "", false, false, 1, false, $&out_fns)
    risks.emit_check_risks(p)
}

pub fn (c &Checker) elem_ty_of_array(aty int, src_fi int) int {
    ai := types.array_index(aty)
    if ai < 0 || ai >= c.env.arrays.len {
        << -1
    }
    ety := c.env.arrays[ai].elem_ty
    if src_fi >= 0 && src_fi < c.env.fns.len && c.env.is_inst[src_fi] != 0 {
        t0 := c.inst_elem_t0(src_fi)
        if t0 >= 0 && (types.is_param_type(ety) || ety == t0) {
            << t0
        }
    }
    if types.is_param_type(ety) && src_fi >= 0 {
        t0 := c.inst_elem_t0(src_fi)
        if t0 >= 0 {
            << t0
        }
    }
    << ety
}

pub fn (c $&Checker) prep_nodes(nnodes int) {
    e := $&c.env
    e.prep_nodes(nnodes)
}


pub fn (c $&Checker) check_program(p &parser.Parser) {
    // Default attribution: the first CLI file (file 0).
    c.set_cur_file(p, 0)
    c.check_names(p)
    // Copy module table / imports from the merged parser.
    // Cache `.len` in ints — Gen1→Gen2 emit drops live `.len` across calls
    // (push / map_put), which skipped module registration and false-failed
    // `module_exists` (e.g. `xu.ast not found`).
    n_mods := p.mod_ids.len
    for i in 0:n_mods {
        mid := p.mod_ids[i] + ""
        c.mod_ids.push(mid + "")
        strmap_put($&c.mod_map, mid + "", i)
    }
    n_imps := p.imp_path.len
    for i in 0:n_imps {
        c.imp_owner.push(p.imp_owner[i] + "")
        c.imp_path.push(p.imp_path[i] + "")
        c.imp_alias.push(p.imp_alias[i] + "")
        c.imp_file.push(p.imp_file[i])
        strmap_put($&c.vis_map, file_key(p.imp_file[i], p.imp_path[i] + ""), i)
        qual := import_default_qualifier(p.imp_path[i] + "", p.imp_alias[i] + "")
        qual_key := file_key(p.imp_file[i], qual + "")
        existing := strmap_get(&c.alias_map, &qual_key)
        if existing >= 0 {
            c.fail_at(1, 1, "duplicate import alias '" + qual + "'")
        }
        strmap_put($&c.alias_map, qual_key, i)
        if qual.len > 0 && qual != p.imp_path[i] {
            strmap_put($&c.vis_map, file_key(p.imp_file[i], qual + ""), i)
            strmap_put($&c.alias_map, file_key(p.imp_file[i], qual + ""), i)
        }
        if p.imp_alias[i].len > 0 {
            strmap_put($&c.alias_map, file_key(p.imp_file[i], p.imp_alias[i] + ""), i)
        }
    }
    // Imports must name a module present in this compilation.
    n_imps2 := c.imp_path.len
    for i in 0:n_imps2 {
        if !c.module_exists(c.imp_path[i]) {
            c.fail_at(1, 1, "module '" + c.imp_path[i] + "' not found in compilation inputs")
        }
    }
    // Pass 0: register struct names (so cross-package field types like
    // `[]ast.Token` resolve even if the field's struct is declared later).
    n_decls := p.decls.len
    for i in 0:n_decls {
        d := p.decls[i]
        if p.nodes[d].kind == ast.NK_STRUCT {
            c.register_struct_name(p, d)
        }
    }
    for i in 0:n_decls {
        d := p.decls[i]
        if p.nodes[d].kind == ast.NK_INTERFACE {
            c.register_interface_name(p, d)
        }
    }
    for i in 0:n_decls {
        d := p.decls[i]
        if p.nodes[d].kind == ast.NK_STRUCT {
            c.layout_struct(p, d)
        }
    }
    for i in 0:n_decls {
        d := p.decls[i]
        if p.nodes[d].kind == ast.NK_ENUM {
            c.register_enum(p, d)
        }
    }
    for i in 0:n_decls {
        d := p.decls[i]
        if p.nodes[d].kind == ast.NK_INTERFACE {
            c.resolve_interface_methods(p, d)
        }
    }
    for i in 0:n_decls {
        d := p.decls[i]
        if p.nodes[d].kind == ast.NK_CONST {
            c.register_const(p, d)
        }
    }
    for i in 0:n_decls {
        d := p.decls[i]
        k := p.nodes[d].kind
        if k == ast.NK_FN {
            c.register_fn(p, d)
        }
    }
    c.setup_throw_metadata(p)
    c.validate_resource_drops(p)
    c.validate_runtime_abi(p)
    c.ffi_check_decls(p)
    if c.env.error_count > 0 { << }
    c.n_src_fns = c.env.fns.len
    n_src := c.n_src_fns
    for i in 0:n_src {
        err0 := c.env.error_count
        c.check_fn(p, c.env.fndecl[i], i)
        if c.env.error_count == err0 {
            if c.env.fns[i].mod_id == "main" || c.env.fns[i].mod_id.len == 0 {
                c.borrow_check_fn(p, c.env.fndecl[i])
            }
        }
    }
    if c.env.test_mode == 0 {
        em := c.find_entry_main()
        if em == -1 {
            if c.env.lib_mode == 0 {
                c.set_cur_file(p, 0)
                c.fail_at(1, 1, "no main function")
            }
        }
        if em == -2 {
            c.set_cur_file(p, 0)
            c.fail_at(1, 1, "multiple main functions")
        }
    }
    if c.env.error_count > 0 {
        <<
    }
    c.detect_recursion(p)
    // Preparing a concrete body can discover another generic helper. Keep
    // processing the worklist until all transitive specializations are ready.
    $fi := c.n_src_fns
    while fi < c.env.fns.len {
        if fi < c.env.is_inst.len && c.env.is_inst[fi] != 0 {
            if fi >= c.inst_snap_ready.len || c.inst_snap_ready[fi] == 0 {
                c.finalize_instance(p, fi)
                if c.env.error_count > 0 { << }
            }
        }
        fi += 1
    }
    for ai in 0:c.env.arrays.len {
        if c.env.arrays[ai].fixed_len > 0 && c.type_contains_resource(c.env.arrays[ai].elem_ty) {
            c.fail_at(1, 1, "fixed arrays containing resource owners are not supported")
        }
    }
    if c.env.error_count > 0 { << }
    // A struct field can intern chan T before T's payload layout is complete.
    // Refresh widths after declarations and generic instances are finalized,
    // before MIR emits channel allocation/send/receive using this table.
    for ci in 0:c.env.chans.len {
        elem := c.env.chans[ci].elem_ty
        slots := c.type_slots(elem)
        c.env.chans[ci].elem_slots = slots
    }
}
