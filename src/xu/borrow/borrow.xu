@xu/borrow

#xu/ast
#xu/parser
#xu/typeenv
#xu/types

pub struct BorrowCtx {
    bstmt         []int
    bnote_stmt    []int
    blast         []int
    bdecl         []int
    bowner        []int
    bexcl         []int
    bproj         []int
    breb          []int
    bf_holder     []int
    bf_field      []int
    bf_owner      []int
    bf_excl       []int
    bf_decl       []int
    bf_proj       []int
    bf_reb        []int
    bcontrol      int
    bfallback     bool
    bseq          int
    btmp_start    int
    btmp_reb      []int
    btmp_node     []int
    btmp_reserved []int
    btmp_owner    []int
    btmp_excl     []int
    btmp_proj     []int
}

fn new_borrow_ctx() BorrowCtx {
    << BorrowCtx{
        bstmt: []int{},
        bnote_stmt: []int{},
        blast: []int{},
        bdecl: []int{},
        bowner: []int{},
        bexcl: []int{},
        bproj: []int{},
        breb: []int{},
        bf_holder: []int{},
        bf_field: []int{},
        bf_owner: []int{},
        bf_excl: []int{},
        bf_decl: []int{},
        bf_proj: []int{},
        bf_reb: []int{},
        bcontrol: -1,
        bfallback: false,
        bseq: 0,
        btmp_start: 0,
        btmp_reb: []int{},
        btmp_node: []int{},
        btmp_reserved: []int{},
        btmp_owner: []int{},
        btmp_excl: []int{},
        btmp_proj: []int{}
    }
}

// Spec34 C adjustments preserve the source AST and source coordinates.
fn (b &BorrowCtx) borrow_target(e &typeenv.TypeEnv, p &parser.Parser, n int) int {
    << borrow_target(e, p, n)
}

fn (b &BorrowCtx) borrow_exclusive(e &typeenv.TypeEnv, p &parser.Parser, n int) bool {
    << (p.nodes[n].kind == ast.NK_BORROW && p.nodes[n].ival == 1) || e.nshared[n] == -2
}

// A branch owns a deep snapshot. Sibling arms start from the same incoming
// state; only reaching predecessors contribute loans at the join. The scalar
// tables summarize a reference for lowering; bf_* carries its complete set.
struct BorrowState {
    btmp_start int
    btmp_reb []int
    btmp_node []int
    btmp_reserved []int
    btmp_proj []int
    btmp_excl []int
    btmp_owner []int
    blast []int
    bowner []int
    bexcl []int
    bproj []int
    breb []int
    bdecl []int
    bf_holder []int
    bf_field []int
    bf_owner []int
    bf_excl []int
    bf_decl []int
    bf_proj []int
    bf_reb []int
}

fn (b &BorrowCtx) borrow_snapshot(e &typeenv.TypeEnv) BorrowState {
    << BorrowState{
        btmp_start: b.btmp_start,
        btmp_reb: b.btmp_reb[0:b.btmp_reb.len],
        btmp_node: b.btmp_node[0:b.btmp_node.len],
        btmp_reserved: b.btmp_reserved[0:b.btmp_reserved.len],
        btmp_proj: b.btmp_proj[0:b.btmp_proj.len],
        btmp_excl: b.btmp_excl[0:b.btmp_excl.len],
        btmp_owner: b.btmp_owner[0:b.btmp_owner.len],
        blast: b.blast[0:b.blast.len],
        bowner: b.bowner[0:b.bowner.len],
        bexcl: b.bexcl[0:b.bexcl.len],
        bproj: b.bproj[0:b.bproj.len],
        breb: b.breb[0:b.breb.len],
        bdecl: b.bdecl[0:b.bdecl.len],
        bf_holder: b.bf_holder[0:b.bf_holder.len],
        bf_field: b.bf_field[0:b.bf_field.len],
        bf_owner: b.bf_owner[0:b.bf_owner.len],
        bf_excl: b.bf_excl[0:b.bf_excl.len],
        bf_decl: b.bf_decl[0:b.bf_decl.len],
        bf_proj: b.bf_proj[0:b.bf_proj.len],
        bf_reb: b.bf_reb[0:b.bf_reb.len]
    }
}

fn (b $&BorrowCtx) borrow_restore(e $&typeenv.TypeEnv, s &BorrowState) {
    b.btmp_start = s.btmp_start
    b.btmp_reb = s.btmp_reb[0:s.btmp_reb.len]
    b.btmp_node = s.btmp_node[0:s.btmp_node.len]
    b.btmp_reserved = s.btmp_reserved[0:s.btmp_reserved.len]
    b.btmp_proj = s.btmp_proj[0:s.btmp_proj.len]
    b.btmp_excl = s.btmp_excl[0:s.btmp_excl.len]
    b.btmp_owner = s.btmp_owner[0:s.btmp_owner.len]
    b.blast = s.blast[0:s.blast.len]
    b.bowner = s.bowner[0:s.bowner.len]
    b.bexcl = s.bexcl[0:s.bexcl.len]
    b.bproj = s.bproj[0:s.bproj.len]
    b.breb = s.breb[0:s.breb.len]
    b.bdecl = s.bdecl[0:s.bdecl.len]
    b.bf_holder = s.bf_holder[0:s.bf_holder.len]
    b.bf_field = s.bf_field[0:s.bf_field.len]
    b.bf_owner = s.bf_owner[0:s.bf_owner.len]
    b.bf_excl = s.bf_excl[0:s.bf_excl.len]
    b.bf_decl = s.bf_decl[0:s.bf_decl.len]
    b.bf_proj = s.bf_proj[0:s.bf_proj.len]
    b.bf_reb = s.bf_reb[0:s.bf_reb.len]
}

// Deduplicate the finite may-loan set. A loan's creation statement is kept
// at its earliest predecessor so it is live at every following join use.
fn (b $&BorrowCtx) borrow_join(e $&typeenv.TypeEnv, s &BorrowState) {
    for i in 0:s.btmp_owner.len {
        if s.btmp_owner[i] < 0 { -> }
        $found := false
        for j in 0:b.btmp_owner.len {
            if b.btmp_owner[j] == s.btmp_owner[i] && b.btmp_excl[j] == s.btmp_excl[i] && b.btmp_proj[j] == s.btmp_proj[i] && b.btmp_reb[j] == s.btmp_reb[i] && b.btmp_node[j] == s.btmp_node[i] && b.btmp_reserved[j] == s.btmp_reserved[i] { found = true }
        }
        if !found {
            b.btmp_owner.push(s.btmp_owner[i])
            b.btmp_excl.push(s.btmp_excl[i])
            b.btmp_proj.push(s.btmp_proj[i])
            b.btmp_reb.push(s.btmp_reb[i])
            b.btmp_node.push(s.btmp_node[i])
            b.btmp_reserved.push(s.btmp_reserved[i])
        }
    }
    for id in 0:s.bowner.len {
        if s.blast[id] > b.blast[id] { typeenv.checker_set_i($&b.blast, id, s.blast[id]) }
        if b.bowner[id] < 0 {
            typeenv.checker_set_i($&b.bowner, id, s.bowner[id])
            typeenv.checker_set_i($&b.breb, id, s.breb[id])
        }
        excl := b.bexcl[id] | s.bexcl[id]
        proj := b.bproj[id] | s.bproj[id]
        typeenv.checker_set_i($&b.bexcl, id, excl)
        typeenv.checker_set_i($&b.bproj, id, proj)
        if s.bdecl[id] >= 0 && (b.bdecl[id] < 0 || s.bdecl[id] < b.bdecl[id]) {
            typeenv.checker_set_i($&b.bdecl, id, s.bdecl[id])
        }
    }
    for i in 0:s.bf_holder.len {
        if s.bf_holder[i] >= 0 {
            b.borrow_add_held(e, s.bf_holder[i], s.bf_field[i], s.bf_owner[i], s.bf_excl[i], s.bf_proj[i], s.bf_reb[i], s.bf_decl[i])
        }
    }
}

// Only unconditional transfers kill a predecessor. A conditional return or
// a possibly empty loop does not prove that its whole block terminates.
fn borrow_block_reaches(p &parser.Parser, head int) bool {
    $s := head
    while s >= 0 {
        k := p.nodes[s].kind
        if k == ast.NK_RETURN || k == ast.NK_THROW || k == ast.NK_EXIT || k == ast.NK_BREAK || k == ast.NK_CONTINUE { << false }
        if k == ast.NK_IF {
            $all_stop := true
            $has_else := false
            $br := p.nodes[s].a
            while br >= 0 {
                if p.nodes[br].a < 0 { has_else = true }
                if borrow_block_reaches(p, p.nodes[br].b) { all_stop = false }
                br = p.nodes[br].next
            }
            if has_else && all_stop { << false }
        }
        s = p.nodes[s].next
    }
    << true
}

// Uses in sibling arms are not reachable from this edge. Preserve uses
// beyond the whole construct, and recompute last uses within this arm.
fn (b $&BorrowCtx) borrow_arm_liveness(e $&typeenv.TypeEnv, p &parser.Parser, body int, end int) {
    for id in 0:b.blast.len {
        // A loop header/body use is also reachable on the next iteration,
        // even when this branch is the final statement of the loop.
        carried := b.bcontrol >= 0 && b.bdecl[id] < b.bcontrol && b.blast[id] >= b.bcontrol
        if !carried && b.blast[id] <= end { typeenv.checker_set_i($&b.blast, id, -1) }
    }
    b.borrow_collect_block(e, p, body)
}

// Mark locals bound directly by a match or select arm pattern/binding.
fn (b &BorrowCtx) borrow_mark_arm_bindings(e &typeenv.TypeEnv, p &parser.Parser, arm int, marks $&[]int) {
    if arm < 0 { << }
    ak := p.nodes[arm].kind
    if ak == ast.NK_ARM_ENUM {
        $b := p.nodes[arm].a
        while b >= 0 {
            bid := e.nlocal[b]
            if bid >= 0 && bid < marks.len { marks[bid] = 1 }
            b = p.nodes[b].next
        }
    } else if ak == ast.NK_SEL_RECV {
        sid2 := e.nlocal[arm]
        if sid2 >= 0 && sid2 < marks.len { marks[sid2] = 1 }
    }
}

// An arm-local holder dies on the edge. An outer holder cannot retain a
// loan of an arm-local owner beyond that owner's scope.
fn (b $&BorrowCtx) borrow_leave_arm_with(e $&typeenv.TypeEnv, p &parser.Parser, arm int, body int) {
    $inner := []int{}
    nlocals := e.ltype.len
    for id in 0:nlocals { inner.push(0) }
    b.borrow_mark_arm_bindings(&*e, p, arm, $&inner)
    b.borrow_mark_decls(&*e, p, body, $&inner)
    end := b.last_bstmt(&*e, p, body)
    for i in 0:b.bf_holder.len {
        h := b.bf_holder[i]
        o := b.bf_owner[i]
        $escapes := false
        if h >= 0 && o >= 0 { escapes = inner[o] != 0 && b.blast[h] > end }
        if h >= 0 {
            if inner[h] != 0 {
                typeenv.checker_set_i($&b.bf_holder, i, -1)
            } else if escapes {
                e.fail_node(p, body, "reference owner does not outlive the control-flow arm")
            }
        }
    }
    for id in 0:inner.len {
        if inner[id] != 0 {
            typeenv.checker_set_i($&b.bowner, id, -1)
            typeenv.checker_set_i($&b.breb, id, -1)
        }
    }
}

fn (b $&BorrowCtx) borrow_leave_arm(e $&typeenv.TypeEnv, p &parser.Parser, body int) {
    b.borrow_leave_arm_with(e, p, -1, body)
}

// Expression kinds produced by the parser. The borrow walkers reject anything
// else so a new kind cannot silently bypass borrow analysis.
fn expr_kind_known(k int) bool {
    << (k >= ast.NK_INT && k <= ast.NK_CAST) || k == ast.NK_CHAN_INIT || k == ast.NK_RECV || k == ast.NK_UNWRAP || (k >= ast.NT_FN_LIT && k <= ast.NK_TYPE_AS) || (k >= ast.NK_THROW && k <= ast.NK_EXIT) || k == ast.NK_MAP_INIT || k == ast.NK_CLONE || k == ast.NK_INLINE_ASM || k == ast.NK_TYPE_QUERY
}

// Direct sub-expressions of expression node n, per parser layout. Type slots
// (cast target, chan/map/empty-array element types, FnLit params/ret) are not
// expressions and are omitted; or-catch fallback blocks and FnLit
// captures carry statement/capture semantics and are handled by each walker.
fn expr_kids(p &parser.Parser, n int) []int {
    $out := []int{}
    if n < 0 { << out }
    k := p.nodes[n].kind
    if k == ast.NK_CALL || k == ast.NK_ARRAY_LIT || k == ast.NK_INLINE_ASM {
        $a := p.nodes[n].a
        while a >= 0 {
            out.push(a)
            a = p.nodes[a].next
        }
    } else if k == ast.NK_STRUCT_INIT {
        $sf := p.nodes[n].a
        while sf >= 0 {
            out.push(p.nodes[sf].a)
            sf = p.nodes[sf].next
        }
    } else if k == ast.NK_METHOD_CALL {
        out.push(p.nodes[n].a)
        $a := p.nodes[n].b
        while a >= 0 {
            out.push(a)
            a = p.nodes[a].next
        }
    } else if k == ast.NK_INDEX || k == ast.NK_BIN_OP {
        out.push(p.nodes[n].a)
        out.push(p.nodes[n].b)
    } else if k == ast.NK_SLICE {
        out.push(p.nodes[n].a)
        out.push(p.nodes[n].b)
        out.push(p.nodes[n].c)
    } else if k == ast.NK_CHAN_INIT {
        out.push(p.nodes[n].b)
    } else if k == ast.NK_MAP_INIT {
        out.push(p.nodes[n].c)
    } else if k == ast.NK_FIELD || k == ast.NK_TRY || k == ast.NK_BORROW || k == ast.NK_UN_OP || k == ast.NK_S_FIELD || k == ast.NK_CAST || k == ast.NK_RECV || k == ast.NK_UNWRAP || k == ast.NK_TYPE_IS || k == ast.NK_TYPE_AS || k == ast.NK_THROW || k == ast.NK_OR_CATCH || k == ast.NK_EXIT || k == ast.NK_CLONE {
        out.push(p.nodes[n].a)
    }
    << out
}

// Outer locals captured directly by FnLit n (env-field repacks excluded).
fn (b &BorrowCtx) fn_lit_captures(e &typeenv.TypeEnv, n int) []int {
    $out := []int{}
    fid := e.ncall[n]
    if fid < 0 || fid >= e.clos_caps.len { << out }
    for i in 0:e.clos_caps[fid].len {
        id := e.clos_caps[fid][i]
        if id >= 0 && id < e.ltype.len { out.push(id) }
    }
    << out
}

// Error fallbacks contain real statements and borrow events. Number them
// with the surrounding expression so last-use analysis cannot skip a close.
fn (b $&BorrowCtx) borrow_number_expr(e $&typeenv.TypeEnv, p &parser.Parser, n int) {
    if n < 0 { << }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        b.borrow_number_expr(e, p, kids[i])
    }
    if p.nodes[n].kind == ast.NK_OR_CATCH {
        b.borrow_number_block(e, p, p.nodes[n].c)
    }
}

fn (b $&BorrowCtx) borrow_number_block(e $&typeenv.TypeEnv, p &parser.Parser, head int) {
    $s := head
    while s >= 0 {
        seq := b.bseq
        typeenv.checker_set_i($&b.bstmt, s, seq)
        b.bnote_stmt.push(s)
        b.bseq = seq + 1
        k := p.nodes[s].kind
        if k == ast.NK_LET || k == ast.NK_ASSIGN || k == ast.NK_EXPR_STMT || k == ast.NK_RETURN || k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_MATCH || k == ast.NK_WHILE || k == ast.NK_XU || k == ast.NK_SEND || k == ast.NK_THROW || k == ast.NK_EXIT {
            b.borrow_number_expr(e, p, p.nodes[s].a)
            if k == ast.NK_ASSIGN || k == ast.NK_FOR || k == ast.NK_SEND { b.borrow_number_expr(e, p, p.nodes[s].b) }
        }
        if k == ast.NK_IF {
            $br := p.nodes[s].a
            while br >= 0 {
                b.borrow_number_expr(e, p, p.nodes[br].a)
                b.borrow_number_block(e, p, p.nodes[br].b)
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
            b.borrow_number_block(e, p, p.nodes[s].c)
        }
        if k == ast.NK_MATCH {
            $ar := p.nodes[s].b
            while ar >= 0 {
                b.borrow_number_expr(e, p, p.nodes[ar].a)
                b.borrow_number_expr(e, p, p.nodes[ar].b)
                b.borrow_number_block(e, p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_SELECT {
            $ar := p.nodes[s].a
            while ar >= 0 {
                b.borrow_number_block(e, p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                b.borrow_number_block(e, p, p.nodes[s].c)
            }
        }
        s = p.nodes[s].next
    }
}

fn max_bstmt(a int, b int) int { if a > b { << a }
    << b }

fn (b &BorrowCtx) last_bexpr(e &typeenv.TypeEnv, p &parser.Parser, n int) int {
    $last := -1
    if n < 0 { << -1 }
    if p.nodes[n].kind == ast.NK_OR_CATCH {
        last = b.last_bstmt(e, p, p.nodes[n].c)
    }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        last = max_bstmt(last, b.last_bexpr(e, p, kids[i]))
    }
    << last
}

// max bstmt in a preorder-numbered block (same kinds as borrow_number_block).
fn (b &BorrowCtx) last_bstmt(e &typeenv.TypeEnv, p &parser.Parser, head int) int {
    $last := -1
    $s := head
    while s >= 0 {
        if s < b.bstmt.len && b.bstmt[s] > last {
            last = b.bstmt[s]
        }
        k := p.nodes[s].kind
        if k == ast.NK_LET || k == ast.NK_ASSIGN || k == ast.NK_EXPR_STMT || k == ast.NK_RETURN || k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_MATCH || k == ast.NK_WHILE || k == ast.NK_XU || k == ast.NK_SEND || k == ast.NK_THROW || k == ast.NK_EXIT {
            last = max_bstmt(last, b.last_bexpr(e, p, p.nodes[s].a))
            if k == ast.NK_ASSIGN || k == ast.NK_FOR || k == ast.NK_SEND { last = max_bstmt(last, b.last_bexpr(e, p, p.nodes[s].b)) }
        }
        if k == ast.NK_IF {
            $br := p.nodes[s].a
            while br >= 0 {
                last = max_bstmt(last, b.last_bexpr(e, p, p.nodes[br].a))
                inner := b.last_bstmt(e, p, p.nodes[br].b)
                if inner > last { last = inner }
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
            inner := b.last_bstmt(e, p, p.nodes[s].c)
            if inner > last { last = inner }
        }
        if k == ast.NK_MATCH {
            $ar := p.nodes[s].b
            while ar >= 0 {
                if k == ast.NK_SELECT {
                    last = max_bstmt(last, b.last_bexpr(e, p, p.nodes[ar].a))
                    last = max_bstmt(last, b.last_bexpr(e, p, p.nodes[ar].b))
                }
                inner := b.last_bstmt(e, p, p.nodes[ar].c)
                if inner > last { last = inner }
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_SELECT {
            $ar := p.nodes[s].a
            while ar >= 0 {
                if k == ast.NK_SELECT {
                    last = max_bstmt(last, b.last_bexpr(e, p, p.nodes[ar].a))
                    last = max_bstmt(last, b.last_bexpr(e, p, p.nodes[ar].b))
                }
                inner := b.last_bstmt(e, p, p.nodes[ar].c)
                if inner > last { last = inner }
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                inner2 := b.last_bstmt(e, p, p.nodes[s].c)
                if inner2 > last { last = inner2 }
            }
        }
        s = p.nodes[s].next
    }
    << last
}

fn (b $&BorrowCtx) borrow_note_use(e $&typeenv.TypeEnv, id int, stmt_id int) {
    if id >= 0 && id < b.blast.len && stmt_id > b.blast[id] {
        typeenv.checker_set_i($&b.blast, id, stmt_id)
    }
}

fn (b $&BorrowCtx) borrow_collect_expr(e $&typeenv.TypeEnv, p &parser.Parser, n int, stmt_id int) {
    if n < 0 { << }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT {
        b.borrow_note_use(e, e.nlocal[n], stmt_id)
        <<
    }
    if k == ast.NK_CALL && e.ncall[n] == -80 {
        b.borrow_note_use(e, e.nlocal[n], stmt_id)
    }
    if k == ast.NK_BORROW {
        // Reborrowing reads the source reference. Its existing loan must
        // remain live until this expression (including &r.field / &r[i]).
        b.borrow_collect_expr(e, p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NT_FN_LIT {
        // Capturing a reference copies it into the closure env: a use.
        caps := b.fn_lit_captures(&*e, n)
        for i in 0:caps.len {
            b.borrow_note_use(e, caps[i], stmt_id)
        }
        <<
    }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        b.borrow_collect_expr(e, p, kids[i], stmt_id)
    }
    if k == ast.NK_OR_CATCH {
        b.borrow_collect_block(e, p, p.nodes[n].c)
    }
}

fn (b $&BorrowCtx) borrow_collect_block(e $&typeenv.TypeEnv, p &parser.Parser, head int) {
    $s := head
    while s >= 0 {
        sid := b.bstmt[s]
        k := p.nodes[s].kind
        if k == ast.NK_LET { b.borrow_collect_expr(e, p, p.nodes[s].a, sid) }
        if k == ast.NK_ASSIGN {
            if p.nodes[p.nodes[s].a].kind != ast.NK_IDENT {
                b.borrow_collect_expr(e, p, p.nodes[s].a, sid)
            }
            b.borrow_collect_expr(e, p, p.nodes[s].b, sid)
        }
        if k == ast.NK_EXPR_STMT || k == ast.NK_RETURN || k == ast.NK_THROW || k == ast.NK_EXIT { b.borrow_collect_expr(e, p, p.nodes[s].a, sid) }
        if k == ast.NK_IF {
            $br := p.nodes[s].a
            while br >= 0 {
                b.borrow_collect_expr(e, p, p.nodes[br].a, sid)
                b.borrow_collect_block(e, p, p.nodes[br].b)
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR {
            b.borrow_collect_expr(e, p, p.nodes[s].a, sid)
            b.borrow_collect_expr(e, p, p.nodes[s].b, sid)
            b.borrow_collect_block(e, p, p.nodes[s].c)
            b.borrow_extend_loop(e, p, sid, p.nodes[s].c)
        }
        if k == ast.NK_FOR_EACH {
            b.borrow_collect_expr(e, p, p.nodes[s].a, sid)
            b.borrow_collect_block(e, p, p.nodes[s].c)
            b.borrow_extend_loop(e, p, sid, p.nodes[s].c)
        }
        if k == ast.NK_WHILE {
            b.borrow_collect_expr(e, p, p.nodes[s].a, sid)
            b.borrow_collect_block(e, p, p.nodes[s].c)
            b.borrow_extend_loop(e, p, sid, p.nodes[s].c)
        }
        if k == ast.NK_MATCH {
            b.borrow_collect_expr(e, p, p.nodes[s].a, sid)
            $ar := p.nodes[s].b
            while ar >= 0 {
                b.borrow_collect_block(e, p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_XU {
            call := p.nodes[s].a
            if call >= 0 {
                $arg := p.nodes[call].a
                while arg >= 0 {
                    b.borrow_collect_expr(e, p, arg, sid)
                    arg = p.nodes[arg].next
                }
            }
        }
        if k == ast.NK_SEND {
            b.borrow_collect_expr(e, p, p.nodes[s].a, sid)
            b.borrow_collect_expr(e, p, p.nodes[s].b, sid)
        }
        if k == ast.NK_SELECT {
            $ar := p.nodes[s].a
            while ar >= 0 {
                b.borrow_collect_expr(e, p, p.nodes[ar].a, sid)
                if p.nodes[ar].kind == ast.NK_SEL_SEND {
                    b.borrow_collect_expr(e, p, p.nodes[ar].b, sid)
                }
                b.borrow_collect_block(e, p, p.nodes[ar].c)
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                b.borrow_collect_block(e, p, p.nodes[s].c)
            }
        }
        s = p.nodes[s].next
    }
}

// The loop body re-runs, so a local declared outside the loop and used
// anywhere in it (header included) is live until the body's last statement.
// Locals declared inside the body are fresh per iteration and keep their range.
fn (b $&BorrowCtx) borrow_extend_loop(e $&typeenv.TypeEnv, p &parser.Parser, start int, body int) {
    end := b.last_bstmt(&*e, p, body)
    if end <= start { << }
    $inner := []int{}
    for i in 0:b.blast.len {
        inner.push(0)
    }
    b.borrow_mark_decls(&*e, p, body, $&inner)
    for id in 0:b.blast.len {
        if inner[id] == 0 && b.blast[id] >= start && b.blast[id] < end {
            typeenv.checker_set_i($&b.blast, id, end)
        }
    }
}

// Set marks[id] = 1 for every local bound by a statement in the block tree.
fn (b &BorrowCtx) borrow_mark_decls(e &typeenv.TypeEnv, p &parser.Parser, head int, marks $&[]int) {
    $s := head
    while s >= 0 {
        k := p.nodes[s].kind
        if k == ast.NK_LET || k == ast.NK_FOR || k == ast.NK_FOR_EACH {
            id := e.nlocal[s]
            if id >= 0 && id < marks.len { marks[id] = 1 }
            if k == ast.NK_FOR_EACH && e.ncall[s] == -91 {
                vid := e.nconst[s]
                if vid >= 0 && vid < marks.len { marks[vid] = 1 }
            }
        }
        if k == ast.NK_IF {
            $br := p.nodes[s].a
            while br >= 0 {
                b.borrow_mark_decls(e, p, p.nodes[br].b, marks)
                br = p.nodes[br].next
            }
        }
        if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
            b.borrow_mark_decls(e, p, p.nodes[s].c, marks)
        }
        if k == ast.NK_MATCH {
            $ar := p.nodes[s].b
            while ar >= 0 {
                b.borrow_mark_arm_bindings(e, p, ar, marks)
                b.borrow_mark_decls(e, p, p.nodes[ar].c, marks)
                ar = p.nodes[ar].next
            }
        }
        if k == ast.NK_SELECT {
            $ar := p.nodes[s].a
            while ar >= 0 {
                b.borrow_mark_arm_bindings(e, p, ar, marks)
                b.borrow_mark_decls(e, p, p.nodes[ar].c, marks)
                ar = p.nodes[ar].next
            }
            if p.nodes[s].c >= 0 {
                b.borrow_mark_decls(e, p, p.nodes[s].c, marks)
            }
        }
        s = p.nodes[s].next
    }
}

fn (b &BorrowCtx) borrow_root_local(e &typeenv.TypeEnv, p &parser.Parser, n int) int {
    << borrow_root_local(e, p, n)
}

// Element Place through a ref local (`r := &n; &r.kids[i]`) hangs on `n`.
fn (b &BorrowCtx) peel_elem_owner(e &typeenv.TypeEnv, id int, elem bool) int {
    if !elem || id < 0 {
        << id
    }
    if id < e.ltype.len && types.is_ref_type(e.ltype[id]) && id < b.bowner.len && b.bowner[id] >= 0 {
        << b.bowner[id]
    }
    << id
}

// MS4 Place: LocalId + [Field | Index]. True if the lvalue chain has Index.
fn (b &BorrowCtx) place_has_index(e &typeenv.TypeEnv, p &parser.Parser, n int) bool {
    << place_has_index(p, n)
}

fn (b &BorrowCtx) place_proj_of(e &typeenv.TypeEnv, p &parser.Parser, n int) int {
    if b.place_has_index(e, p, n) { << 1 }
    << 0
}

// Element-origin ref (`&xs[i]`, `&m[k]`) loads through buffer layout (+8k).
fn (b &BorrowCtx) expr_ref_is_buf(e &typeenv.TypeEnv, p &parser.Parser, n int) bool {
    if n < 0 { << false }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT {
        id := e.nlocal[n]
        if id >= 0 && id < b.bproj.len && b.bproj[id] == 1 { << true }
        << false
    }
    if k == ast.NK_BORROW || e.nshared[n] == -1 {
        << b.place_has_index(e, p, b.borrow_target(e, p, n))
    }
    << false
}

fn (b &BorrowCtx) borrow_chain_is_map(e &typeenv.TypeEnv, p &parser.Parser, n int) bool {
    << borrow_chain_is_map(e, p, n)
}

fn (b &BorrowCtx) borrow_live(e &typeenv.TypeEnv, ref_local int, stmt_id int) bool {
    << ref_local >= 0 && ref_local < b.bowner.len && b.bowner[ref_local] >= 0 &&
        b.bdecl[ref_local] >= 0 && b.bdecl[ref_local] < stmt_id && b.blast[ref_local] >= stmt_id
}

fn (b &BorrowCtx) borrow_field_live(e &typeenv.TypeEnv, i int, stmt_id int) bool {
    if i < 0 || i >= b.bf_holder.len { << false }
    h := b.bf_holder[i]
    << h >= 0 && b.bf_owner[i] >= 0 && b.bf_decl[i] >= 0 && b.bf_decl[i] < stmt_id &&
        h < b.blast.len && b.blast[h] >= stmt_id
}

fn (b &BorrowCtx) borrow_has_any(e &typeenv.TypeEnv, owner int, stmt_id int) bool {
    for r in 0:b.bowner.len {
        if b.borrow_live(e, r, stmt_id) && b.bowner[r] == owner { << true }
    }
    for i in 0:b.bf_holder.len {
        if b.borrow_field_live(e, i, stmt_id) && b.bf_owner[i] == owner { << true }
    }
    for i in 0:b.btmp_owner.len {
        if b.btmp_owner[i] == owner { << true }
    }
    << false
}

fn (b &BorrowCtx) borrow_has_exclusive_held(e &typeenv.TypeEnv, owner int, stmt_id int) bool {
    for r in 0:b.bowner.len {
        if b.borrow_live(e, r, stmt_id) && b.bowner[r] == owner && b.bexcl[r] != 0 { << true }
    }
    for i in 0:b.bf_holder.len {
        if b.borrow_field_live(e, i, stmt_id) && b.bf_owner[i] == owner && b.bf_excl[i] != 0 { << true }
    }
    << false
}

fn (b &BorrowCtx) borrow_has_exclusive(e &typeenv.TypeEnv, owner int, stmt_id int) bool {
    if b.borrow_has_exclusive_held(e, owner, stmt_id) { << true }
    for i in 0:b.btmp_owner.len {
        if b.btmp_owner[i] == owner && b.btmp_excl[i] != 0 && b.btmp_reserved[i] == 0 { << true }
    }
    << false
}

fn (b &BorrowCtx) borrow_has_any_for_write(e &typeenv.TypeEnv, owner int, stmt_id int) bool {
    for r in 0:b.bowner.len {
        if b.borrow_live(e, r, stmt_id) && b.bowner[r] == owner { << true }
    }
    for i in 0:b.bf_holder.len {
        if b.borrow_field_live(e, i, stmt_id) && b.bf_owner[i] == owner { << true }
    }
    for i in 0:b.btmp_owner.len {
        if i < b.btmp_start && b.btmp_reserved[i] != 0 && b.btmp_proj[i] == 0 { -> }
        if b.btmp_owner[i] == owner { << true }
    }
    << false
}

fn (b &BorrowCtx) borrow_has_tmp_conflict(e &typeenv.TypeEnv, owner int, exclusive bool, stmt_id int) bool {
    if exclusive {
        << b.borrow_has_any_for_write(e, owner, stmt_id)
    }
    if b.borrow_has_exclusive_held(e, owner, stmt_id) { << true }
    for i in 0:b.btmp_owner.len {
        if i < b.btmp_start && b.btmp_reserved[i] != 0 { -> }
        if b.btmp_owner[i] == owner && b.btmp_excl[i] != 0 { << true }
    }
    << false
}

fn (b &BorrowCtx) place_writes_through_ref(e &typeenv.TypeEnv, p &parser.Parser, n int) bool {
    $cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_UN_OP && p.nodes[cur].ival == ast.UN_DEREF {
            << true
        }
        if k != ast.NK_FIELD && k != ast.NK_INDEX {
            <-
        }
        base := p.nodes[cur].a
        if base >= 0 && base < e.ntype.len && types.is_ref_type(e.ntype[base]) {
            << true
        }
        cur = base
    }
    << false
}

fn (b &BorrowCtx) borrow_has_elem(e &typeenv.TypeEnv, owner int, stmt_id int) bool {
    for r in 0:b.bowner.len {
        if b.borrow_live(e, r, stmt_id) && b.bowner[r] == owner && r < b.bproj.len && b.bproj[r] == 1 {
            << true
        }
    }
    for i in 0:b.bf_holder.len {
        if b.borrow_field_live(e, i, stmt_id) && b.bf_owner[i] == owner && i < b.bf_proj.len && b.bf_proj[i] == 1 {
            << true
        }
    }
    for i in 0:b.btmp_owner.len {
        if b.btmp_owner[i] == owner && i < b.btmp_proj.len && b.btmp_proj[i] == 1 { << true }
    }
    << false
}

fn (b &BorrowCtx) reborrow_reaches(e &typeenv.TypeEnv, from int, src int) bool {
    $pending := []int{}
    $seen := []int{}
    pending.push(from)
    $pos := 0
    while pos < pending.len {
        cur := pending[pos]
        pos += 1
        if cur >= 0 && cur < b.breb.len {
            $visited := false
            for i in 0:seen.len { if seen[i] == cur { visited = true } }
            if !visited {
                seen.push(cur)
                parent := b.breb[cur]
                if parent == src { << true }
                if parent >= 0 && parent != cur { pending.push(parent) }
                for i in 0:b.bf_holder.len {
                    if b.bf_holder[i] == cur {
                        alt := b.bf_reb[i]
                        if alt == src { << true }
                        if alt >= 0 && alt != cur { pending.push(alt) }
                    }
                }
            }
        }
    }
    << false
}

fn (b &BorrowCtx) borrow_frozen_held(e &typeenv.TypeEnv, src int, stmt_id int, exclusive_only bool) bool {
    if src < 0 { << false }
    // Shared references remain usable while shared descendants are live.
    if !types.is_mut_ref_type(e.ltype[src]) { << false }
    for r in 0:b.breb.len {
        if b.borrow_live(e, r, stmt_id) && (!exclusive_only || b.bexcl[r] != 0) && b.reborrow_reaches(e, r, src) { << true }
    }
    for i in 0:b.bf_holder.len {
        if b.borrow_field_live(e, i, stmt_id) && (!exclusive_only || b.bf_excl[i] != 0) && b.bf_reb[i] >= 0 {
            parent := b.bf_reb[i]
            if parent == src || b.reborrow_reaches(e, parent, src) { << true }
        }
    }
    << false
}

fn (b &BorrowCtx) borrow_frozen(e &typeenv.TypeEnv, src int, stmt_id int, exclusive_only bool) bool {
    if b.borrow_frozen_held(e, src, stmt_id, exclusive_only) { << true }
    if src < 0 || !types.is_mut_ref_type(e.ltype[src]) { << false }
    for i in 0:b.btmp_reb.len {
        parent := b.btmp_reb[i]
        if b.btmp_owner[i] >= 0 && parent >= 0 && b.btmp_reserved[i] == 0 && (!exclusive_only || b.btmp_excl[i] != 0) {
            if parent == src || b.reborrow_reaches(e, parent, src) { << true }
        }
    }
    << false
}

fn (b &BorrowCtx) borrow_tmp_note(e &typeenv.TypeEnv, p &parser.Parser, i int) string {
    n := b.btmp_node[i]
    $why := "conflicting temporary loan starts here"
    if e.nshared[n] > 0 { why = why + "; implicit shared reborrow inserted for a read-only expectation" }
    if e.nshared[n] == -1 { why = why + "; automatic read-only borrow inserted for a read-only expectation" }
    << "\n" + e.cur_file_name + ":" + str(p.nodes[n].line) + ":" + str(p.nodes[n].col) + ": note: " + why
}

fn (b &BorrowCtx) borrow_tmp_alias(e &typeenv.TypeEnv, i int, owner int, parent int) bool {
    if b.btmp_owner[i] < 0 { << false }
    if b.btmp_owner[i] == owner { << true }
    other := b.btmp_reb[i]
    << parent >= 0 && other >= 0 && (parent == other || b.reborrow_reaches(e, parent, other) || b.reborrow_reaches(e, other, parent))
}

// Track a pointee loan against every possible owner and the parent reference.
// The parent's held loan supplies permission; it is not a conflicting sibling.
// A writable argument reservation activates after nested argument evaluation.
// A nested call may complete first; any reference it returns is checked again
// against that reservation before the outer invocation.
fn (b $&BorrowCtx) borrow_tmp_ref(e $&typeenv.TypeEnv, p &parser.Parser, src int, exclusive bool, n int, stmt_id int, receiver bool, reserved bool) {
    if src < 0 { << }
    if b.borrow_frozen_held(&*e, src, stmt_id, receiver && !exclusive) {
        e.fail_node(p, n, "cannot reborrow a frozen reference" + b.borrow_shared_conflict_help(&*e, p, src, stmt_id))
    }
    if b.borrow_has_exclusive_held(&*e, src, stmt_id) {
        e.fail_node(p, n, "cannot use '" + e.lname[src] + "' while it is mutably borrowed")
    }
    first := b.btmp_owner.len
    count := b.bf_holder.len
    for j in 0:count + 1 {
        $owner := b.bowner[src]
        $proj := b.bproj[src]
        if j < count {
            if b.bf_holder[j] != src { -> }
            owner = b.bf_owner[j]
            proj = b.bf_proj[j]
        }
        if owner < 0 { -> }
        for i in 0:first {
            if i < b.btmp_start && b.btmp_reserved[i] != 0 { -> }
            if (exclusive || b.btmp_excl[i] != 0) && b.borrow_tmp_alias(&*e, i, owner, src) {
                e.fail_node(p, n, "conflicting temporary call loans: shared and writable or multiple writable arguments alias parent reference '" + e.lname[src] + "'" + b.borrow_tmp_note(&*e, p, i))
            }
        }
        b.btmp_owner.push(owner)
        b.btmp_excl.push(types.b2i(exclusive))
        b.btmp_proj.push(proj)
        b.btmp_reb.push(src)
        b.btmp_node.push(n)
        b.btmp_reserved.push(types.b2i(reserved))
    }
}

// Only reference-bearing results retain argument loans after invocation.
// Such results are active loans, never reservations of the enclosing call.
fn (b $&BorrowCtx) borrow_finish_call(e $&typeenv.TypeEnv, p &parser.Parser, first int, outer int, n int) {
    b.btmp_start = outer
    for j in first:b.btmp_owner.len {
        if !e.type_contains_ref(e.ntype[n]) {
            typeenv.checker_set_i($&b.btmp_owner, j, -1)
            typeenv.checker_set_i($&b.btmp_reb, j, -1)
        } else {
            // Older hosted seeds carry the then arm's temporary loans into
            // an else-if condition. A new statement ends those call loans.
            if b.btmp_owner[j] >= 0 {
                typeenv.checker_set_i($&b.btmp_reserved, j, 0)
                for i in 0:first {
                    if (b.btmp_excl[i] != 0 || b.btmp_excl[j] != 0) && b.borrow_tmp_alias(&*e, i, b.btmp_owner[j], b.btmp_reb[j]) {
                        e.fail_node(p, n, "conflicting temporary call loans: reference result aliases another shared or writable argument" + b.borrow_tmp_note(&*e, p, i))
                    }
                }
            }
        }
    }
}

fn (b $&BorrowCtx) borrow_walk_arg(e $&typeenv.TypeEnv, p &parser.Parser, n int, stmt_id int) {
    if p.nodes[n].kind == ast.NK_IDENT && types.is_mut_ref_type(e.ntype[n]) {
        b.borrow_tmp_ref(e, p, e.nlocal[n], true, n, stmt_id, false, true)
    } else {
        b.borrow_walk_expr(e, p, n, stmt_id)
    }
}

// Spec34 H33: statement-granularity source notes for the shared descendant
// that freezes a writable parent. Use the holder's last use, including fields.
fn (b &BorrowCtx) borrow_shared_note_at(e &typeenv.TypeEnv, p &parser.Parser, stmt_id int, message string) string {
    if stmt_id < 0 || stmt_id >= b.bnote_stmt.len { << "" }
    n := b.bnote_stmt[stmt_id]
    << "\n" + e.cur_file_name + ":" + str(p.nodes[n].line) + ":" + str(p.nodes[n].col) + ": note: " + message
}

// Locate the actual source expression of an inserted place borrow in a
// declaration/call/aggregate, without inventing an '&' in the diagnostic.
fn (b &BorrowCtx) borrow_auto_source(e &typeenv.TypeEnv, p &parser.Parser, n int) int {
    if n < 0 { << -1 }
    if e.nshared[n] == -1 { << n }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        found := b.borrow_auto_source(e, p, kids[i])
        if found >= 0 { << found }
    }
    << -1
}

fn (b &BorrowCtx) borrow_auto_conflict_help(e &typeenv.TypeEnv, p &parser.Parser, owner int, stmt_id int) string {
    for i in 0:b.bf_holder.len {
        if b.borrow_field_live(e, i, stmt_id) && b.bf_owner[i] == owner && b.bf_excl[i] == 0 {
            decl := b.bf_decl[i]
            node := b.bnote_stmt[decl]
            $init := p.nodes[node].a
            if p.nodes[node].kind == ast.NK_ASSIGN { init = p.nodes[node].b }
            src := b.borrow_auto_source(e, p, init)
            if src >= 0 {
                << "\n" + e.cur_file_name + ":" + str(p.nodes[src].line) + ":" + str(p.nodes[src].col) +
                    ": note: automatic read-only borrow inserted for a read-only expectation" +
                    b.borrow_shared_note_at(e, p, b.blast[b.bf_holder[i]], "read-only borrow is last used here") +
                    "\nhelp: move the write or exclusive borrow after the last use of the read-only borrow"
            }
        }
    }
    << ""
}

fn (b &BorrowCtx) borrow_shared_conflict_help(e &typeenv.TypeEnv, p &parser.Parser, src int, stmt_id int) string {
    $decl := -1
    $last := -1
    for r in 0:b.breb.len {
        if b.borrow_live(e, r, stmt_id) && b.bexcl[r] == 0 && b.reborrow_reaches(e, r, src) {
            decl = b.bdecl[r]
            last = b.blast[r]
        }
    }
    for i in 0:b.bf_holder.len {
        if b.borrow_field_live(e, i, stmt_id) && b.bf_excl[i] == 0 && b.bf_reb[i] >= 0 {
            parent := b.bf_reb[i]
            if parent == src || b.reborrow_reaches(e, parent, src) {
                decl = b.bf_decl[i]
                last = b.blast[b.bf_holder[i]]
            }
        }
    }
    if decl < 0 { << b.borrow_auto_conflict_help(e, p, src, stmt_id) }
    $why := ""
    node := b.bnote_stmt[decl]
    $init := p.nodes[node].a
    if p.nodes[node].kind == ast.NK_ASSIGN { init = p.nodes[node].b }
    if init >= 0 && e.nshared[init] > 0 {
        why = "\nnote: implicit shared reborrow inserted for a read-only expectation at '" + p.nodes[init].sval + "'"
    }
    << why + b.borrow_shared_note_at(e, p, decl, "shared reborrow starts here") +
        b.borrow_shared_note_at(e, p, last, "shared reborrow is last used here") +
        "\nhelp: move the write or exclusive reborrow after the last use of the shared reborrow"
}

fn (b $&BorrowCtx) borrow_read_event(e $&typeenv.TypeEnv, p &parser.Parser, owner int, n int, stmt_id int) {
    if owner >= 0 && (b.borrow_has_exclusive(&*e, owner, stmt_id) || b.borrow_frozen(&*e, owner, stmt_id, false)) {
        e.fail_node(p, n, "cannot use '" + e.lname[owner] + "' while it is mutably borrowed" + b.borrow_shared_conflict_help(&*e, p, owner, stmt_id))
    }
}

fn (b $&BorrowCtx) borrow_write_event(e $&typeenv.TypeEnv, p &parser.Parser, owner int, n int, stmt_id int) {
    if owner >= 0 && (b.borrow_has_any_for_write(&*e, owner, stmt_id) || b.borrow_frozen(&*e, owner, stmt_id, false)) {
        e.fail_node(p, n, "cannot assign to '" + e.lname[owner] + "' because it is borrowed" + b.borrow_shared_conflict_help(&*e, p, owner, stmt_id))
    }
}

fn (b $&BorrowCtx) borrow_move_event(e $&typeenv.TypeEnv, p &parser.Parser, owner int, n int, stmt_id int) {
    if owner >= 0 && (b.borrow_has_any(&*e, owner, stmt_id) || b.borrow_frozen(&*e, owner, stmt_id, false)) {
        e.fail_node(p, n, "cannot move '" + e.lname[owner] + "' because it is borrowed")
    }
}

fn (b $&BorrowCtx) borrow_new_event(e $&typeenv.TypeEnv, p &parser.Parser, owner int, exclusive bool, elem bool, n int, stmt_id int) {
    if owner < 0 { << }
    if b.borrow_has_tmp_conflict(&*e, owner, exclusive, stmt_id) {
        $hint := b.borrow_auto_conflict_help(&*e, p, owner, stmt_id)
        for i in 0:b.btmp_owner.len {
            if !exclusive && i < b.btmp_start && b.btmp_reserved[i] != 0 { -> }
            if b.btmp_owner[i] == owner && (exclusive || b.btmp_excl[i] != 0) {
                hint = hint + b.borrow_tmp_note(&*e, p, i)
                <-
            }
        }
        if e.nshared[n] == -1 {
            hint = hint + "\nnote: automatic read-only borrow inserted for a read-only expectation"
        }
        if exclusive {
            e.fail_node(p, n, "cannot borrow '" + e.lname[owner] + "' as mutable because it is also borrowed" + hint)
        } else {
            e.fail_node(p, n, "cannot borrow '" + e.lname[owner] + "' as immutable because it is also borrowed as mutable" + hint)
        }
    }
    b.btmp_reb.push(-1)
    b.btmp_node.push(n)
    b.btmp_reserved.push(0)
    b.btmp_owner.push(owner)
    b.btmp_excl.push(types.b2i(exclusive))
    $pj := 0
    if elem { pj = 1 }
    b.btmp_proj.push(pj)
}

// A holder keeps every loan carried by its value, including nested fields,
// call results and closure environments. Field -1 denotes a whole-value loan.
fn (b $&BorrowCtx) borrow_add_held(e $&typeenv.TypeEnv, holder int, field int, owner int, excl int, proj int, parent int, stmt_id int) {
    if owner < 0 { << }
    for i in 0:b.bf_holder.len {
        if b.bf_holder[i] == holder && b.bf_field[i] == field && b.bf_owner[i] == owner && b.bf_excl[i] == excl && b.bf_proj[i] == proj && b.bf_reb[i] == parent {
            if stmt_id < b.bf_decl[i] { typeenv.checker_set_i($&b.bf_decl, i, stmt_id) }
            <<
        }
    }
    b.bf_holder.push(holder)
    b.bf_field.push(field)
    b.bf_owner.push(owner)
    b.bf_excl.push(excl)
    b.bf_decl.push(stmt_id)
    b.bf_proj.push(proj)
    b.bf_reb.push(parent)
}

fn (b $&BorrowCtx) borrow_hold_local(e $&typeenv.TypeEnv, holder int, field int, src int, stmt_id int) {
    if src < 0 || src >= b.bowner.len { << }
    if types.is_ref_type(e.ltype[src]) {
        $parent := b.breb[src]
        if types.is_mut_ref_type(e.ltype[src]) { parent = src }
        b.borrow_add_held(e, holder, field, b.bowner[src], b.bexcl[src], b.bproj[src], parent, stmt_id)
    }
    // Bound the walk before appending, including when holder == src.
    count := b.bf_holder.len
    for i in 0:count {
        if b.bf_holder[i] == src {
            b.borrow_add_held(e, holder, field, b.bf_owner[i], b.bf_excl[i], b.bf_proj[i], b.bf_reb[i], stmt_id)
        }
    }
}

// A shared adjustment inherits every possible source but never its exclusive
// permission. The parent identity still freezes conflicting parent access.
fn (b $&BorrowCtx) borrow_hold_shared(e $&typeenv.TypeEnv, holder int, field int, src int, stmt_id int) {
    if src < 0 { << }
    b.borrow_add_held(e, holder, field, b.bowner[src], 0, b.bproj[src], src, stmt_id)
    count := b.bf_holder.len
    for i in 0:count {
        if b.bf_holder[i] == src {
            b.borrow_add_held(e, holder, field, b.bf_owner[i], 0, b.bf_proj[i], src, stmt_id)
        }
    }
}

fn (b &BorrowCtx) bound_method_mut(e &typeenv.TypeEnv, ty int) bool {
    if !types.is_fn_type(ty) { << false }
    si := types.fn_index(ty)
    if si < 0 || si >= e.fn_sigs.len || e.fn_sigs[si].has_env == 0 { << false }
    esi := e.fn_sigs[si].env_struct
    if esi < 0 || esi >= e.structs.len || e.structs[esi].fields.len == 0 { << false }
    << types.is_mut_ref_type(e.structs[esi].fields[0].ty)
}

fn (b &BorrowCtx) call_node_arg_moves(e &typeenv.TypeEnv, p &parser.Parser, n int, fi int, ai int) bool {
    if fi >= 0 {
        << e.call_arg_moves(fi, ai)
    }
    if fi == -83 {
        real_fi := e.nconst[n]
        if real_fi >= 0 {
            << e.call_arg_moves(real_fi, ai)
        }
        << false
    }
    if fi == -80 {
        lid := e.nlocal[n]
        if lid >= 0 && lid < e.ltype.len && types.is_fn_type(e.ltype[lid]) {
            si := types.fn_index(e.ltype[lid])
            if si >= 0 && si < e.fn_sigs.len && ai < e.fn_sigs[si].params.len {
                pty := e.fn_sigs[si].params[ai]
                << e.type_owning(pty) || (!types.is_mut_ref_type(pty) && e.type_contains_mut_ref(pty))
            }
        }
        << false
    }
    if fi == -94 {
        ii := e.nlocal[n]
        for mi in 0:e.im_ii.len {
            if e.im_ii[mi] == ii && e.im_name[mi] == p.nodes[n].sval {
                if ai < e.im_plen[mi] {
                    pty := e.im_ptys[e.im_poff[mi] + ai]
                    << e.type_owning(pty) || (!types.is_mut_ref_type(pty) && e.type_contains_mut_ref(pty))
                }
                << false
            }
        }
        << false
    }
    << false
}

fn (b $&BorrowCtx) borrow_hold_expr(e $&typeenv.TypeEnv, p &parser.Parser, holder int, field int, init int, stmt_id int) {
    if init < 0 { << }
    k := p.nodes[init].kind
    if k == ast.NK_IDENT && e.nshared[init] > 0 {
        b.borrow_hold_shared(e, holder, field, e.nlocal[init], stmt_id)
        <<
    }
    if k == ast.NK_IDENT && e.nshared[init] != -1 {
        b.borrow_hold_local(e, holder, field, e.nlocal[init], stmt_id)
        <<
    }
    if k == ast.NK_BORROW || e.nshared[init] == -1 {
        tgt := b.borrow_target(&*e, p, init)
        $parent := -1
        $owner := b.borrow_root_local(&*e, p, tgt)
        $proj := b.place_proj_of(&*e, p, tgt)
        if p.nodes[tgt].kind == ast.NK_UN_OP && p.nodes[tgt].ival == 3 {
            parent = b.borrow_root_local(&*e, p, p.nodes[tgt].a)
            if parent >= 0 {
                owner = b.bowner[parent]
                proj = b.bproj[parent]
            }
        } else {
            if owner >= 0 && types.is_ref_type(e.ltype[owner]) {
                parent = owner
                owner = b.bowner[parent]
            }
        }
        b.borrow_add_held(e, holder, field, owner, types.b2i(b.borrow_exclusive(&*e, p, init)), proj, parent, stmt_id)
        if parent >= 0 {
            count := b.bf_holder.len
            for i in 0:count {
                if b.bf_holder[i] == parent {
                    b.borrow_add_held(e, holder, field, b.bf_owner[i], types.b2i(b.borrow_exclusive(&*e, p, init)), proj | b.bf_proj[i], parent, stmt_id)
                }
            }
        } else if owner >= 0 && !types.is_ref_type(e.ltype[owner]) {
            // Borrowing a struct holding reference fields keeps those referenced
            // owners pinned transitively for the lifetime of the new reference.
            count := b.bf_holder.len
            excl_b := types.b2i(b.borrow_exclusive(&*e, p, init))
            for i in 0:count {
                if b.bf_holder[i] == owner {
                    b.borrow_add_held(e, holder, field, b.bf_owner[i], excl_b & b.bf_excl[i], proj | b.bf_proj[i], -1, stmt_id)
                }
            }
        }
        <<
    }
    if k == ast.NK_FIELD && e.ncall[init] == -95 {
        bm_excl := types.b2i(b.bound_method_mut(&*e, e.ntype[init]))
        obj := p.nodes[init].a
        root := b.borrow_root_local(&*e, p, obj)
        if root >= 0 {
            if types.is_ref_type(e.ltype[root]) {
                if bm_excl != 0 {
                    b.borrow_hold_local(e, holder, field, root, stmt_id)
                } else {
                    b.borrow_hold_shared(e, holder, field, root, stmt_id)
                }
            } else {
                b.borrow_add_held(e, holder, field, root, bm_excl, b.place_proj_of(&*e, p, obj), -1, stmt_id)
            }
        }
        <<
    }
    if k == ast.NT_FN_LIT {
        caps := b.fn_lit_captures(&*e, init)
        for i in 0:caps.len { b.borrow_hold_local(e, holder, field, caps[i], stmt_id) }
        <<
    }
    if !e.type_contains_ref(e.ntype[init]) { << }
    // A result may retain any reference-bearing input. Conservatively keep
    // their union; selecting only one argument would lose valid provenance.
    $shared_recv := -1
    if k == ast.NK_METHOD_CALL {
        fi := e.ncall[init]
        if fi >= 0 && types.is_ref_type(e.fns[fi].recv) && !e.fns[fi].recv_mut {
            root := b.borrow_root_local(&*e, p, p.nodes[init].a)
            if root >= 0 && types.is_ref_type(e.ltype[root]) {
                shared_recv = p.nodes[init].a
                b.borrow_hold_shared(e, holder, field, root, stmt_id)
            }
        }
    }
    kids := expr_kids(p, init)
    for i in 0:kids.len {
        if kids[i] == shared_recv { -> }
        b.borrow_hold_expr(e, p, holder, field, kids[i], stmt_id)
    }
    if k == ast.NK_METHOD_CALL {
        recv := p.nodes[init].a
        root := b.borrow_root_local(&*e, p, recv)
        if root >= 0 && !types.is_ref_type(e.ltype[root]) {
            b.borrow_add_held(e, holder, field, root, types.b2i(types.is_mut_ref_type(e.ntype[init])), b.place_proj_of(&*e, p, recv), -1, stmt_id)
        }
    }
}

fn (b $&BorrowCtx) borrow_register_ref(e $&typeenv.TypeEnv, p &parser.Parser, local int, init int, stmt_id int) {
    if local < 0 { << }
    // Self-assignment must preserve the input's provenance while collecting.
    first := b.bf_holder.len
    scratch := e.ltype.len
    b.borrow_hold_expr(e, p, scratch, -1, init, stmt_id)
    for i in 0:first {
        if b.bf_holder[i] == local { typeenv.checker_set_i($&b.bf_holder, i, -1) }
    }
    $owner := -1
    $excl := 0
    $proj := 0
    $parent := -1
    for i in first:b.bf_holder.len {
        if b.bf_holder[i] == scratch {
            typeenv.checker_set_i($&b.bf_holder, i, local)
            if owner < 0 { owner = b.bf_owner[i] }
            excl = excl | b.bf_excl[i]
            proj = proj | b.bf_proj[i]
            if parent < 0 { parent = b.bf_reb[i] }
        }
    }
    // Assignment kills the previous value's loans on this path. Branch
    // joins, rather than assignment, preserve alternative-path provenance.
    typeenv.checker_set_i($&b.bowner, local, owner)
    typeenv.checker_set_i($&b.bexcl, local, excl)
    typeenv.checker_set_i($&b.bproj, local, proj)
    typeenv.checker_set_i($&b.breb, local, parent)
    typeenv.checker_set_i($&b.bdecl, local, stmt_id)
}

fn (b $&BorrowCtx) borrow_register_field(e $&typeenv.TypeEnv, p &parser.Parser, holder int, field int, init int, stmt_id int) {
    first := b.bf_holder.len
    scratch := e.ltype.len
    b.borrow_hold_expr(e, p, scratch, field, init, stmt_id)
    for i in 0:first {
        if b.bf_holder[i] == holder && b.bf_field[i] == field { typeenv.checker_set_i($&b.bf_holder, i, -1) }
    }
    for i in first:b.bf_holder.len { typeenv.checker_set_i($&b.bf_holder, i, holder) }
}

fn (b $&BorrowCtx) borrow_walk_move(e $&typeenv.TypeEnv, p &parser.Parser, n int, stmt_id int) {
    if n < 0 { << }
    // Moving a field is not a shared place read.
    if e.type_owning(e.ntype[n]) {
        root := b.borrow_root_local(&*e, p, n)
        if root >= 0 && types.is_ref_type(e.ltype[root]) {
            // A checked clone of reference-free data reads the place. It
            // may coexist with a temporary shared receiver, but not with an
            // active writable temporary or the existing held-parent freeze.
            if e.nclone[n] == 1 && !e.type_contains_ref(e.ntype[n]) && !b.borrow_frozen_held(&*e, root, stmt_id, false) {
                b.borrow_walk_receiver(e, p, n, false, stmt_id)
                <<
            }
            b.borrow_read_event(e, p, root, n, stmt_id)
        }
    }
    if p.nodes[n].kind == ast.NK_IDENT && e.type_owning(e.ntype[n]) {
        b.borrow_move_event(e, p, e.nlocal[n], n, stmt_id)
        <<
    }
    b.borrow_walk_expr(e, p, n, stmt_id)
}

fn (b $&BorrowCtx) borrow_walk_receiver(e $&typeenv.TypeEnv, p &parser.Parser, n int, write bool, stmt_id int) {
    root := b.borrow_root_local(&*e, p, n)
    // An &T receiver reborrows the parent for reading; shared descendants
    // permit that even when the parent is $&T. Keep moves and mutations
    // on the full frozen check, and still reject exclusive descendants.
    if root >= 0 && types.is_ref_type(e.ltype[root]) && !write {
        if b.borrow_has_exclusive(&*e, root, stmt_id) || b.borrow_frozen(&*e, root, stmt_id, true) {
            e.fail_node(p, n, "cannot use '" + e.lname[root] + "' while it is mutably borrowed")
        }
        b.borrow_walk_place_index(e, p, n, stmt_id)
        <<
    }
    if root >= 0 && !types.is_ref_type(e.ltype[root]) {
        if write {
            b.borrow_write_event(e, p, root, n, stmt_id)
        } else {
            b.borrow_read_event(e, p, root, n, stmt_id)
        }
        <<
    }
    if root >= 0 && write {
        b.borrow_read_event(e, p, root, n, stmt_id)
    }
    b.borrow_walk_expr(e, p, n, stmt_id)
}

fn (b $&BorrowCtx) borrow_walk_expr(e $&typeenv.TypeEnv, p &parser.Parser, n int, stmt_id int) {
    if n < 0 { << }
    k := p.nodes[n].kind
    if k == ast.NK_OR_CATCH {
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        incoming := b.borrow_snapshot(&*e)
        old_fallback := b.bfallback
        b.bfallback = true
        b.borrow_check_block(e, p, p.nodes[n].c)
        b.bfallback = old_fallback
        if borrow_block_reaches(p, p.nodes[n].c) {
            b.borrow_leave_arm(e, p, p.nodes[n].c)
            b.borrow_join(e, &incoming)
            b.btmp_start = incoming.btmp_start
        } else {
            b.borrow_restore(e, &incoming)
        }
        <<
    }
    if k == ast.NK_IDENT && e.nshared[n] > 0 {
        b.borrow_tmp_ref(e, p, e.nlocal[n], false, n, stmt_id, false, false)
        <<
    }
    if k == ast.NK_IDENT && e.nshared[n] != -1 {
        b.borrow_read_event(e, p, e.nlocal[n], n, stmt_id)
        <<
    }
    if k == ast.NK_BORROW || e.nshared[n] == -1 {
        target := b.borrow_target(&*e, p, n)
        if p.nodes[target].kind == ast.NK_UN_OP && p.nodes[target].ival == 3 {
            src := b.borrow_root_local(&*e, p, p.nodes[target].a)
            b.borrow_tmp_ref(e, p, src, b.borrow_exclusive(&*e, p, n), n, stmt_id, false, false)
            <<
        }
        $owner := b.borrow_root_local(&*e, p, target)
        elem := b.place_has_index(&*e, p, target)
        if owner >= 0 && types.is_ref_type(e.ltype[owner]) && p.nodes[target].kind != ast.NK_IDENT {
            first := b.btmp_owner.len
            b.borrow_tmp_ref(e, p, owner, b.borrow_exclusive(&*e, p, n), n, stmt_id, true, false)
            if elem {
                for i in first:b.btmp_proj.len { typeenv.checker_set_i($&b.btmp_proj, i, 1) }
            }
            b.borrow_walk_place_index(e, p, target, stmt_id)
            <<
        }
        owner = b.peel_elem_owner(&*e, owner, elem)
        b.borrow_new_event(e, p, owner, b.borrow_exclusive(&*e, p, n), elem, n, stmt_id)
        b.borrow_walk_place_index(e, p, target, stmt_id)
        <<
    }
    if k == ast.NK_CALL {
        first := b.btmp_owner.len
        outer := b.btmp_start
        b.btmp_start = first
        fi := e.ncall[n]
        if fi == -80 { b.borrow_read_event(e, p, e.nlocal[n], n, stmt_id) }
        $arg := p.nodes[n].a
        $ai := 0
        while arg >= 0 {
            if b.call_node_arg_moves(&*e, p, n, fi, ai) {
                b.borrow_walk_move(e, p, arg, stmt_id)
            } else {
                b.borrow_walk_arg(e, p, arg, stmt_id)
            }
            ai += 1
            arg = p.nodes[arg].next
        }
        b.borrow_finish_call(e, p, first, outer, n)
        <<
    }
    if k == ast.NK_STRUCT_INIT {
        $sf := p.nodes[n].a
        while sf >= 0 {
            b.borrow_walk_move(e, p, p.nodes[sf].a, stmt_id)
            sf = p.nodes[sf].next
        }
        <<
    }
    if k == ast.NK_FIELD && e.ncall[n] == -95 {
        bm_excl := b.bound_method_mut(&*e, e.ntype[n])
        root := b.borrow_root_local(&*e, p, p.nodes[n].a)
        if root >= 0 && !types.is_ref_type(e.ltype[root]) {
            b.borrow_new_event(e, p, root, bm_excl, b.place_has_index(&*e, p, p.nodes[n].a), n, stmt_id)
            b.borrow_walk_place_index(e, p, p.nodes[n].a, stmt_id)
        } else {
            b.borrow_walk_receiver(e, p, p.nodes[n].a, bm_excl, stmt_id)
            if root >= 0 && types.is_ref_type(e.ltype[root]) {
                b.borrow_tmp_ref(e, p, root, bm_excl, n, stmt_id, true, false)
            }
        }
        <<
    }
    if k == ast.NK_FIELD || k == ast.NK_INDEX {
        root := b.borrow_root_local(&*e, p, n)
        // Reading data through a place can share the parent with shared
        // descendants. Reference-bearing values still use the strict path:
        // copying one could grant the caller mutable access to the referent.
        if root >= 0 && types.is_ref_type(e.ltype[root]) && !e.type_contains_ref(e.ntype[n]) {
            b.borrow_walk_receiver(e, p, n, false, stmt_id)
            <<
        }
        if root >= 0 && e.type_contains_ref(e.ntype[n]) {
            b.borrow_read_event(e, p, root, n, stmt_id)
        }
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        if k == ast.NK_INDEX { b.borrow_walk_expr(e, p, p.nodes[n].b, stmt_id) }
        <<
    }
    if k == ast.NK_METHOD_CALL {
        first := b.btmp_owner.len
        outer := b.btmp_start
        b.btmp_start = first
        fi := e.ncall[n]
        if fi == -86 || fi == -88 {
            root := b.borrow_root_local(&*e, p, p.nodes[n].a)
            if root >= 0 && b.borrow_has_any(&*e, root, stmt_id) {
                e.fail_node(p, n, "cannot mutate '" + e.lname[root] + "' while it is borrowed")
            }
        }
        if fi == -3 || fi == -4 || fi == -51 || fi == -110 {
            root := b.borrow_root_local(&*e, p, p.nodes[n].a)
            if (fi == -4 || fi == -51) && root >= 0 && b.borrow_has_elem(&*e, root, stmt_id) {
                e.fail_node(p, n, "cannot mutate '" + e.lname[root] + "' while an element is borrowed")
            }
            if root >= 0 && !types.is_ref_type(e.ltype[root]) {
                b.borrow_new_event(e, p, root, true, false, n, stmt_id)
            } else {
                b.borrow_walk_receiver(e, p, p.nodes[n].a, true, stmt_id)
            }
        } else if fi == -96 {
            b.borrow_walk_move(e, p, p.nodes[n].a, stmt_id)
        } else if fi >= 0 {
            if !types.is_ref_type(e.fns[fi].recv) {
                root := b.borrow_root_local(&*e, p, p.nodes[n].a)
                b.borrow_read_event(e, p, root, p.nodes[n].a, stmt_id)
            }
            b.borrow_walk_receiver(e, p, p.nodes[n].a, e.fns[fi].recv_mut, stmt_id)
        } else if fi == -86 || fi == -88 {
            b.borrow_walk_receiver(e, p, p.nodes[n].a, true, stmt_id)
        } else {
            b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        }
        // The receiver is evaluated before arguments. Shared permission is
        // active immediately; writable permission reserves the parent until
        // invocation, just like a bare writable function argument.
        if fi >= 0 && types.is_ref_type(e.fns[fi].recv) {
            root := b.borrow_root_local(&*e, p, p.nodes[n].a)
            if root >= 0 && types.is_ref_type(e.ltype[root]) {
                b.borrow_tmp_ref(e, p, root, e.fns[fi].recv_mut, p.nodes[n].a, stmt_id, true, e.fns[fi].recv_mut)
            } else if root >= 0 {
                b.borrow_new_event(e, p, root, e.fns[fi].recv_mut, b.place_has_index(&*e, p, p.nodes[n].a), p.nodes[n].a, stmt_id)
                if e.fns[fi].recv_mut && b.btmp_reserved.len > 0 {
                    last_i := b.btmp_reserved.len - 1
                    typeenv.checker_set_i($&b.btmp_reserved, last_i, 1)
                }
            }
        }
        $arg := p.nodes[n].b
        $ai := 0
        while arg >= 0 {
            if fi == -4 || fi == -51 {
                b.borrow_walk_move(e, p, arg, stmt_id)
            } else if b.call_node_arg_moves(&*e, p, n, fi, ai) {
                b.borrow_walk_move(e, p, arg, stmt_id)
            } else {
                b.borrow_walk_arg(e, p, arg, stmt_id)
            }
            ai += 1
            arg = p.nodes[arg].next
        }
        if fi == -4 {
            b.borrow_hold_push(e, p, n, stmt_id)
        }
        b.borrow_finish_call(e, p, first, outer, n)
        <<
    }
    if k == ast.NK_TRY {
        b.borrow_walk_move(e, p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_ARRAY_LIT {
        $el := p.nodes[n].a
        while el >= 0 {
            b.borrow_walk_move(e, p, el, stmt_id)
            el = p.nodes[el].next
        }
        <<
    }
    if k == ast.NT_FN_LIT {
        // Captures copy `&T` / move owning values and `$&T` into the env.
        caps := b.fn_lit_captures(&*e, n)
        for i in 0:caps.len {
            id := caps[i]
            if e.type_owning(e.ltype[id]) || types.is_mut_ref_type(e.ltype[id]) {
                b.borrow_move_event(e, p, id, n, stmt_id)
            } else {
                b.borrow_read_event(e, p, id, n, stmt_id)
            }
        }
        <<
    }
    if !expr_kind_known(k) {
        e.fail_node(p, n, "internal error: borrow checker cannot analyze expression kind " + str(k))
        <<
    }
    kids := expr_kids(p, n)
    for i in 0:kids.len {
        b.borrow_walk_expr(e, p, kids[i], stmt_id)
    }
}

// `xs.push(v)` stores v in xs exactly as `xs[i] = v` does. When v carries a
// reference, xs becomes a holder of that loan: the owner then cannot be
// written, moved or leave scope while xs is still used. The cases an
// assignment rejects for lack of lifetime tracking are rejected here too.
fn (b $&BorrowCtx) borrow_hold_push(e $&typeenv.TypeEnv, p &parser.Parser, n int, stmt_id int) {
    arg := p.nodes[n].b
    if arg < 0 || !e.type_contains_ref(e.ntype[arg]) {
        <<
    }
    root := b.borrow_root_local(&*e, p, p.nodes[n].a)
    if root < 0 || types.is_ref_type(e.ltype[root]) {
        e.fail_node(p, n, "cannot store a reference-bearing value through a reference without a proven lifetime")
        <<
    }
    if b.bfallback {
        e.fail_node(p, n, "cannot rebind a reference-bearing value in an error fallback without expression-level loan tracking")
        <<
    }
    if b.bcontrol >= 0 && b.bdecl[root] < b.bcontrol {
        e.fail_node(p, n, "cannot rebind a reference-bearing value across a loop back-edge")
        <<
    }
    b.borrow_hold_expr(e, p, root, -1, arg, stmt_id)
}

fn (b $&BorrowCtx) borrow_walk_place_index(e $&typeenv.TypeEnv, p &parser.Parser, n int, stmt_id int) {
    $cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX {
            b.borrow_walk_expr(e, p, p.nodes[cur].b, stmt_id)
            cur = p.nodes[cur].a
        } else if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            <<
        }
    }
}

fn (b $&BorrowCtx) borrow_check_stmt(e $&typeenv.TypeEnv, p &parser.Parser, n int) {
    old_control := b.bcontrol
    first := b.btmp_owner.len
    k := p.nodes[n].kind
    if k == ast.NK_FOR || k == ast.NK_FOR_EACH || k == ast.NK_WHILE {
        b.bcontrol = b.bstmt[n]
    }
    b.borrow_check_stmt_inner(e, p, n)
    // Fallback statements execute inside an expression. Keep its incoming
    // temporary loans, but release each statement's own temporary suffix.
    if b.bfallback {
        for i in first:b.btmp_owner.len {
            typeenv.checker_set_i($&b.btmp_owner, i, -1)
            typeenv.checker_set_i($&b.btmp_reb, i, -1)
        }
    }
    b.bcontrol = old_control
}

fn (b $&BorrowCtx) borrow_check_stmt_inner(e $&typeenv.TypeEnv, p &parser.Parser, n int) {
    stmt_id := b.bstmt[n]
    b.btmp_start = 0
    if !b.bfallback {
        b.btmp_reb = []int{}
        b.btmp_node = []int{}
        b.btmp_reserved = []int{}
        b.btmp_owner = []int{}
        b.btmp_excl = []int{}
        b.btmp_proj = []int{}
    }
    k := p.nodes[n].kind
    if k == ast.NK_LET {
        b.borrow_walk_move(e, p, p.nodes[n].a, stmt_id)
        b.borrow_register_ref(e, p, e.nlocal[n], p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_ASSIGN {
        target := p.nodes[n].a
        root := b.borrow_root_local(&*e, p, target)
        $target_ty := e.ntype[target]
        if root >= 0 && p.nodes[target].kind == ast.NK_IDENT { target_ty = e.ltype[root] }
        if target_ty <= 0 { target_ty = e.ntype[p.nodes[n].b] }
        if (b.place_writes_through_ref(&*e, p, target) || (root >= 0 && p.nodes[target].kind != ast.NK_IDENT && types.is_ref_type(e.ltype[root]))) && e.type_contains_ref(target_ty) {
            e.fail_node(p, n, "cannot store a reference-bearing value through a reference without a proven lifetime")
        }
        if b.bfallback && e.type_contains_ref(target_ty) {
            e.fail_node(p, n, "cannot rebind a reference-bearing value in an error fallback without expression-level loan tracking")
        }
        if root >= 0 && b.bcontrol >= 0 && b.bdecl[root] < b.bcontrol && e.type_contains_ref(target_ty) {
            e.fail_node(p, n, "cannot rebind a reference-bearing value across a loop back-edge")
        }
        if e.ncall[n] == -78 || e.ncall[target] == -78 {
            if root >= 0 && b.borrow_has_any(&*e, root, stmt_id) {
                e.fail_node(p, n, "cannot mutate '" + e.lname[root] + "' while it is borrowed")
            }
        }
        // M149: rebinding a reference local replaces the borrow record.
        if p.nodes[target].kind == ast.NK_IDENT && root >= 0 && types.is_ref_type(e.ltype[root]) {
            b.borrow_write_event(e, p, root, target, stmt_id)
            b.borrow_walk_move(e, p, p.nodes[n].b, stmt_id)
            b.borrow_register_ref(e, p, root, p.nodes[n].b, stmt_id)
            <<
        }
        // M162: rebinding a ref-typed field `h.r = $&y`.
        if p.nodes[target].kind == ast.NK_FIELD && root >= 0 {
            base := p.nodes[target].a
            if p.nodes[base].kind == ast.NK_IDENT {
                bty := e.direct_type(e.ntype[base])
                if types.is_struct_type(bty) {
                    si := types.struct_index(bty)
                    fi := e.find_field(si, p.nodes[target].sval)
                    if fi >= 0 && types.is_ref_type(e.structs[si].fields[fi].ty) {
                        b.borrow_write_event(e, p, root, p.nodes[n].b, stmt_id)
                        b.borrow_walk_move(e, p, p.nodes[n].b, stmt_id)
                        b.borrow_register_field(e, p, root, fi, p.nodes[n].b, stmt_id)
                        <<
                    }
                }
            }
        }
        // Whole-struct assign clears field-stored borrows then re-registers.
        if p.nodes[target].kind == ast.NK_IDENT && root >= 0 && types.is_struct_type(e.ltype[root]) {
            b.borrow_write_event(e, p, root, p.nodes[n].b, stmt_id)
            b.borrow_walk_move(e, p, p.nodes[n].b, stmt_id)
            b.borrow_register_ref(e, p, root, p.nodes[n].b, stmt_id)
            <<
        }
        if root >= 0 && !types.is_ref_type(e.ltype[root]) {
            b.borrow_write_event(e, p, root, p.nodes[n].b, stmt_id)
        } else {
            if root >= 0 { b.borrow_read_event(e, p, root, target, stmt_id) }
            b.borrow_walk_expr(e, p, target, stmt_id)
        }
        if p.nodes[target].kind == ast.NK_INDEX {
            b.borrow_walk_expr(e, p, p.nodes[target].b, stmt_id)
        }
        b.borrow_walk_move(e, p, p.nodes[n].b, stmt_id)
        if root >= 0 {
            b.borrow_hold_expr(e, p, root, -1, p.nodes[n].b, stmt_id)
        }
        <<
    }
    if k == ast.NK_EXPR_STMT {
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_RETURN {
        b.borrow_walk_move(e, p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_IF {
        incoming := b.borrow_snapshot(&*e)
        $fallthrough := b.borrow_snapshot(&*e)
        $end := stmt_id
        $edge := p.nodes[n].a
        while edge >= 0 {
            body := p.nodes[edge].b
            end = max_bstmt(end, b.last_bstmt(&*e, p, body))
            edge = p.nodes[edge].next
        }
        $joined := BorrowState{btmp_start: 0, btmp_reb: []int{}, btmp_node: []int{}, btmp_reserved: []int{}, btmp_proj: []int{}, btmp_excl: []int{}, btmp_owner: []int{}, blast: []int{}, bowner: []int{}, bexcl: []int{}, bproj: []int{}, breb: []int{}, bdecl: []int{}, bf_holder: []int{}, bf_field: []int{}, bf_owner: []int{}, bf_excl: []int{}, bf_decl: []int{}, bf_proj: []int{}, bf_reb: []int{}}
        $have_join := false
        $has_else := false
        $br := p.nodes[n].a
        while br >= 0 {
            b.borrow_restore(e, &fallthrough)
            if p.nodes[br].a < 0 { has_else = true }
            b.borrow_walk_expr(e, p, p.nodes[br].a, stmt_id)
            fallthrough = b.borrow_snapshot(&*e)
            body := p.nodes[br].b
            b.borrow_arm_liveness(e, p, body, end)
            b.borrow_check_block(e, p, body)
            if borrow_block_reaches(p, body) {
                b.borrow_leave_arm(e, p, body)
                if have_join { b.borrow_join(e, &joined) }
                joined = b.borrow_snapshot(&*e)
                have_join = true
            }
            br = p.nodes[br].next
        }
        if !has_else {
            b.borrow_restore(e, &fallthrough)
            if have_join { b.borrow_join(e, &joined) }
        } else if have_join {
            b.borrow_restore(e, &joined)
        } else {
            b.borrow_restore(e, &incoming)
        }
        <<
    }
    if k == ast.NK_FOR {
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        b.borrow_walk_expr(e, p, p.nodes[n].b, stmt_id)
        b.borrow_check_block(e, p, p.nodes[n].c)
        <<
    }
    if k == ast.NK_FOR_EACH {
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        varid := e.nlocal[n]
        $hang := false
        if e.ncall[n] == -91 {
            hang = true
        }
        if varid >= 0 && varid < e.lview.len && e.lview[varid] != 0 {
            hang = true
        }
        at := e.direct_type(e.ntype[p.nodes[n].a])
        if types.is_array_type(at) {
            ety := e.arrays[types.array_index(at)].elem_ty
            if e.type_owning(ety) || e.type_contains_ref(ety) {
                hang = true
            }
        }
        if hang {
            root := b.borrow_root_local(&*e, p, p.nodes[n].a)
            last := b.last_bstmt(&*e, p, p.nodes[n].c)
            if root >= 0 && last >= 0 && varid >= 0 {
                typeenv.checker_set_i($&b.bowner, varid, root)
                typeenv.checker_set_i($&b.bexcl, varid, 0)
                if varid < b.bproj.len { typeenv.checker_set_i($&b.bproj, varid, 1) }
                typeenv.checker_set_i($&b.bdecl, varid, stmt_id)
                if last > b.blast[varid] {
                    typeenv.checker_set_i($&b.blast, varid, last)
                }
            }
        }
        b.borrow_check_block(e, p, p.nodes[n].c)
        <<
    }
    if k == ast.NK_WHILE {
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        b.borrow_check_block(e, p, p.nodes[n].c)
        <<
    }
    if k == ast.NK_BREAK || k == ast.NK_CONTINUE {
        <<
    }
    if k == ast.NK_THROW {
        b.borrow_walk_move(e, p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_EXIT {
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        <<
    }
    if k == ast.NK_MATCH {
        if types.is_enum_type(e.direct_type(e.ntype[p.nodes[n].a])) {
            b.borrow_walk_move(e, p, p.nodes[n].a, stmt_id)
        } else {
            b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        }
        incoming := b.borrow_snapshot(&*e)
        $end := stmt_id
        // Enum exhaustiveness was proved by type checking. Integer matches
        // may fall through unless an else arm covers the unmatched values.
        $complete := types.is_enum_type(e.direct_type(e.ntype[p.nodes[n].a]))
        $edge := p.nodes[n].b
        while edge >= 0 {
            if p.nodes[edge].kind == ast.NK_ARM_ELSE { complete = true }
            end = max_bstmt(end, b.last_bstmt(&*e, p, p.nodes[edge].c))
            edge = p.nodes[edge].next
        }
        $joined := b.borrow_snapshot(&*e)
        $have_join := !complete
        $ar := p.nodes[n].b
        while ar >= 0 {
            b.borrow_restore(e, &incoming)
            body := p.nodes[ar].c
            b.borrow_arm_liveness(e, p, body, end)
            b.borrow_check_block(e, p, body)
            if borrow_block_reaches(p, body) {
                b.borrow_leave_arm_with(e, p, ar, body)
                if have_join { b.borrow_join(e, &joined) }
                joined = b.borrow_snapshot(&*e)
                have_join = true
            }
            ar = p.nodes[ar].next
        }
        if have_join { b.borrow_restore(e, &joined) } else { b.borrow_restore(e, &incoming) }
        <<
    }
    if k == ast.NK_XU {
        call := p.nodes[n].a
        if call >= 0 {
            $arg := p.nodes[call].a
            while arg >= 0 {
                b.borrow_walk_move(e, p, arg, stmt_id)
                arg = p.nodes[arg].next
            }
        }
        <<
    }
    if k == ast.NK_SEND {
        b.borrow_walk_expr(e, p, p.nodes[n].a, stmt_id)
        b.borrow_walk_move(e, p, p.nodes[n].b, stmt_id)
        <<
    }
    if k == ast.NK_SELECT {
        $operand := p.nodes[n].a
        while operand >= 0 {
            b.borrow_walk_expr(e, p, p.nodes[operand].a, stmt_id)
            if p.nodes[operand].kind == ast.NK_SEL_SEND {
                b.borrow_walk_move(e, p, p.nodes[operand].b, stmt_id)
            }
            operand = p.nodes[operand].next
        }
        incoming := b.borrow_snapshot(&*e)
        $end := stmt_id
        $edge := p.nodes[n].a
        while edge >= 0 {
            body := p.nodes[edge].c
            end = max_bstmt(end, b.last_bstmt(&*e, p, body))
            edge = p.nodes[edge].next
        }
        end = max_bstmt(end, b.last_bstmt(&*e, p, p.nodes[n].c))
        $joined := BorrowState{btmp_start: 0, btmp_reb: []int{}, btmp_node: []int{}, btmp_reserved: []int{}, btmp_proj: []int{}, btmp_excl: []int{}, btmp_owner: []int{}, blast: []int{}, bowner: []int{}, bexcl: []int{}, bproj: []int{}, breb: []int{}, bdecl: []int{}, bf_holder: []int{}, bf_field: []int{}, bf_owner: []int{}, bf_excl: []int{}, bf_decl: []int{}, bf_proj: []int{}, bf_reb: []int{}}
        $have_join := false
        $ar := p.nodes[n].a
        while ar >= 0 {
            b.borrow_restore(e, &incoming)
            body := p.nodes[ar].c
            b.borrow_arm_liveness(e, p, body, end)
            b.borrow_check_block(e, p, body)
            if borrow_block_reaches(p, body) {
                b.borrow_leave_arm_with(e, p, ar, body)
                if have_join { b.borrow_join(e, &joined) }
                joined = b.borrow_snapshot(&*e)
                have_join = true
            }
            ar = p.nodes[ar].next
        }
        if p.nodes[n].c >= 0 {
            b.borrow_restore(e, &incoming)
            body := p.nodes[n].c
            b.borrow_arm_liveness(e, p, body, end)
            b.borrow_check_block(e, p, body)
            if borrow_block_reaches(p, body) {
                b.borrow_leave_arm(e, p, body)
                if have_join { b.borrow_join(e, &joined) }
                joined = b.borrow_snapshot(&*e)
                have_join = true
            }
        }
        if p.nodes[n].ival == 1 && p.nodes[n].c < 0 {
            b.borrow_restore(e, &incoming)
            if have_join { b.borrow_join(e, &joined) }
        } else if have_join { b.borrow_restore(e, &joined) } else { b.borrow_restore(e, &incoming) }
        <<
    }
}

fn (b $&BorrowCtx) borrow_check_block(e $&typeenv.TypeEnv, p &parser.Parser, head int) {
    $s := head
    while s >= 0 {
        b.borrow_check_stmt(e, p, s)
        k := p.nodes[s].kind
        if k == ast.NK_RETURN || k == ast.NK_THROW || k == ast.NK_EXIT || k == ast.NK_BREAK || k == ast.NK_CONTINUE { << }
        s = p.nodes[s].next
    }
}

fn (b $&BorrowCtx) borrow_check_fn_ctx(e $&typeenv.TypeEnv, p &parser.Parser, d int) {
    b.bnote_stmt = []int{}
    b.blast = []int{}
    b.bdecl = []int{}
    b.bowner = []int{}
    b.bexcl = []int{}
    b.bproj = []int{}
    b.breb = []int{}
    b.bf_holder = []int{}
    b.bf_field = []int{}
    b.bf_owner = []int{}
    b.bf_excl = []int{}
    b.bf_decl = []int{}
    b.bf_proj = []int{}
    b.bf_reb = []int{}
    b.bcontrol = -1
    b.bfallback = false
    for i in 0:e.ltype.len {
        b.blast.push(-1)
        b.bdecl.push(-1)
        b.bowner.push(-1)
        b.bexcl.push(0)
        b.bproj.push(0)
        b.breb.push(-1)
    }
    $nparams := 0
    if p.nodes[d].kind == ast.NT_FN_LIT {
        nparams = e.fns[e.cur_fn].params.len
    } else {
        if p.nodes[d].d >= 0 { nparams += 1 }
        $param := p.nodes[d].a
        while param >= 0 {
            nparams += 1
            param = p.nodes[param].next
        }
    }
    for id in 0:nparams {
        if types.is_ref_type(e.ltype[id]) {
            exclusive := types.b2i(types.is_mut_ref_type(e.ltype[id]))
            typeenv.checker_set_i($&b.bowner, id, id)
            typeenv.checker_set_i($&b.bexcl, id, exclusive)
        }
    }
    b.bseq = 0
    b.borrow_number_block(e, p, p.nodes[d].c)
    b.borrow_collect_block(e, p, p.nodes[d].c)
    b.borrow_check_block(e, p, p.nodes[d].c)
}

// ===== statements =====

pub fn borrow_check_fn(e $&typeenv.TypeEnv, p &parser.Parser, d int) {
    $b := new_borrow_ctx()
    b.borrow_check_fn_ctx(e, p, d)
}

pub fn borrow_target(e &typeenv.TypeEnv, p &parser.Parser, n int) int {
    if e.nshared[n] == -1 { << n }
    << p.nodes[n].a
}

pub fn borrow_root_local(e &typeenv.TypeEnv, p &parser.Parser, n int) int {
    $cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_IDENT { << e.nlocal[cur] }
        if k == ast.NK_FIELD || k == ast.NK_INDEX {
            cur = p.nodes[cur].a
        } else {
            << -1
        }
    }
    << -1
}

pub fn place_has_index(p &parser.Parser, n int) bool {
    $cur := n
    while cur >= 0 {
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX { << true }
        if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            << false
        }
    }
    << false
}

pub fn borrow_chain_is_map(e &typeenv.TypeEnv, p &parser.Parser, n int) bool {
    $cur := n
    while cur >= 0 {
        if e.ncall[cur] == -77 { << true }
        k := p.nodes[cur].kind
        if k == ast.NK_INDEX {
            if e.peel_map(e.ntype[p.nodes[cur].a]) >= 0 { << true }
            cur = p.nodes[cur].a
        } else if k == ast.NK_FIELD {
            cur = p.nodes[cur].a
        } else {
            << false
        }
    }
    << false
}
