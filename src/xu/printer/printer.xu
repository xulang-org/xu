@xu/printer
// Product source formatter. Frozen bootstrap formatting uses its old syntax.
//
// Ownership: lex_full takes an owning string, and helper functions that take
// `string` / `[]Token` by value would move the source and token list. Hold
// both on FmtBuf and use methods so lexeme reprint can still slice `src`.


#xu/ast
#xu/scanner

struct FmtBuf {
    src  string
    toks []ast.Token
}

fn fmt_is_word(k int) bool {
    << ast.tok_is_word(k)
}

fn fmt_is_infix(k int) bool {
    << ast.tok_is_infix(k)
}

// Tokens that can end a value expression (so a following `[` is index/slice).
fn fmt_ends_value(k int) bool {
    if k == 1 { << true }   // Ident
    if k == 2 { << true }   // Int
    if k == 3 { << true }   // Str
    if k == 14 { << true }  // true
    if k == 15 { << true }  // false
    if k == 20 { << true }  // )
    if k == 24 { << true }  // ]
    if k == 66 { << true }  // Float
    << false
}

// Range colon hugs both endpoints (`0:10`, `xs[lo:hi]`). Type/field colon
// keeps a space after (`let e: T`, `field: v`). Context flags are maintained
// by run(): for-header after `in`, index brackets, and `Int: Int` match arms.
fn fmt_colon_is_range(prev int, next int, in_for_hdr int, bracket_idx int) bool {
    if in_for_hdr == 2 { << true }
    if bracket_idx > 0 { << true }
    // match arm integer range: `0:13` (for-header already covered above)
    if prev == 2 && next == 2 { << true }
    << false
}

fn fmt_space(a int, b int, c int) bool {
    if b == 76 { << true }
    if b == 23 {
        if a == 24 || a == 19 || a == 23 { << false }
        if c == 24 { << fmt_is_word(a) }
        << false
    }
    if b == 50 { << a == 1 } // match `lo...hi` (no space); leftover ident+... still spaced
    if b == 20 || b == 24 || b == 25 || b == 52 || b == 51 || b == 49 {
        << false
    }
    if a == 19 || a == 23 || a == 51 { << false }
    if a == 76 { << true }
    if b == 19 {
        if a == 4 || a == 8 { << true }
        << false
    }
    if b == 21 {
        if a == 1 { << false }
        << true
    }
    if a == 48 { << true }
    if b == 48 { << false }
    if fmt_is_infix(a) || fmt_is_infix(b) { << true }
    if a == 25 { << true }
    if a == 39 { << false } // Amp
    if a == 84 { << false } // At hugs @name
    if a == 90 { << false } // Dollar hugs $linux
    if a == 88 { << false } // Pound hugs temp# / Foo#int
    if b == 88 { << false } // glued #
    if a == 44 { << false }
    if b == 44 {
        // M38: postfix `!` (fail-loud unwrap) hugs its operand; prefix `!x`
        // after keywords/operators/punctuation keeps its space (`<< !x`,
        // `= !x`, `if !x`). Tokens that can end an expression: Ident, RParen,
        // RBracket, Int, Float, Str, true, false.
        if a == 1 || a == 20 || a == 24 || a == 2 || a == 66 || a == 3 || a == 14 || a == 15 {
            << false
        }
        << true
    }
    if a == 22 && b == 8 { << true }
    if fmt_is_word(a) && fmt_is_word(b) { << true }
    if fmt_is_word(a) && (b == 39 || b == 44 || b == 27) { << true }
    if a == 20 && fmt_is_word(b) { << true }
    if a == 20 && b == 21 { << true }
    << false
}

fn fmt_line_empty(out string) bool {
    $p := -1
    for i in 0:out.len {
        if out[i] == 10 { p = i }
    }
    $i := p + 1
    for k in 0:out.len {
        if i < out.len {
            if out[i] != 32 { << false }
            i = i + 1
        }
    }
    << true
}

fn (f FmtBuf) offset(line int, col int) int {
    $l := 1
    $c := 1
    $i := 0
    for k in 0:f.src.len {
        if i < f.src.len {
            if l == line && c == col { << i }
            if f.src[i] == 10 {
                l = l + 1
                c = 1
            } else {
                c = c + 1
            }
            i = i + 1
        }
    }
    << f.src.len
}

fn (f FmtBuf) token_end(i int) int {
    start := f.offset(f.toks[i].line, f.toks[i].col)
    line := f.toks[i].line
    $end := f.src.len
    $j := i + 1
    for k in 0:f.toks.len {
        if j < f.toks.len {
            if f.toks[j].kind != 54 {
                if f.toks[j].line == line {
                    end = f.offset(f.toks[j].line, f.toks[j].col)
                    j = f.toks.len
                } else {
                    if f.toks[j].line > line {
                        ls := f.offset(line, 1)
                        $e := ls
                        for k2 in 0:f.src.len {
                            if e < f.src.len && f.src[e] != 10 { e = e + 1 }
                        }
                        end = e
                        j = f.toks.len
                    }
                }
            }
            j = j + 1
        }
    }
    for k in 0:f.src.len {
        if end > start && end <= f.src.len {
            ch := f.src[end - 1]
            if ch == 32 || ch == 9 || ch == 13 {
                end = end - 1
            } else {
                << end
            }
        }
    }
    << end
}

fn (f FmtBuf) token_text(i int) string {
    tk := f.toks[i].kind
    if tk == 6 { << "<<" }   // tok_return
    if tk == 56 { << "<-" }  // tok_break
    if tk == 57 { << "->" }  // tok_continue
    if tk == 84 { << "@" }   // tok_at
    if tk == 90 { << "$$" }   // tok_dollar
    if tk == 88 { << "#" }   // tok_pound
    start := f.offset(f.toks[i].line, f.toks[i].col)
    end := f.token_end(i)
    if end > start && end <= f.src.len {
        << f.src[start:end]
    }
    << ""
}

fn (f $&FmtBuf) collect_tokens() {
    $toks := []ast.Token{}
    copy := f.src + ""
    scanner.lex_full(copy, $&toks)
    for i in 0:toks.len {
        f.toks.push(ast.token(toks[i].kind, toks[i].line, toks[i].col, toks[i].ival, toks[i].sval))
    }
}

fn (f FmtBuf) run() string {
    $out := ""
    $depth := 0
    $line_start := true
    $blank_run := 0
    $prev := -1
    $i := 0
    // Colon context: 0/1/2 = before for / after `for` / after `in` in for-header.
    $in_for_hdr := 0
    $bracket_idx := 0
    $last_colon_range := false
    $package_path := false
    for k in 0:f.toks.len {
        if i < f.toks.len && f.toks[i].kind != 54 {
            tk := f.toks[i].kind
            if i == 0 && tk == 84 { package_path = true }
            if tk == 53 {
                package_path = false
                blank_run = blank_run + 1
                if blank_run <= 2 { out = out + "\n" }
                line_start = true
                prev = tk
                i = i + 1
            } else {
                blank_run = 0
                if tk == 22 {
                    depth = depth - 1
                    if depth < 0 { depth = 0 }
                }
                $nxt := 54
                if i + 1 < f.toks.len { nxt = f.toks[i + 1].kind }
                // Classify `:` before spacing so the following token can hug.
                if tk == 48 {
                    last_colon_range = fmt_colon_is_range(prev, nxt, in_for_hdr, bracket_idx)
                }
                if line_start {
                    for d in 0:depth { out = out + "    " }
                    line_start = false
                } else {
                    if prev >= 0 {
                        $space := fmt_space(prev, tk, nxt)
                        if package_path && (prev == 29 || tk == 29) { space = false }
                        // Range colon hugs its endpoints: `0:10` / `xs[lo:hi]`.
                        if last_colon_range && prev == 48 { space = false }
                        if space { out = out + " " }
                    }
                }
                if tk == 76 {
                    probe := out + ""
                    if !fmt_line_empty(probe) {
                        for k2 in 0:out.len {
                            if out.len > 0 && out[out.len - 1] == 32 {
                                out = out[0:out.len - 1]
                            }
                        }
                        out = out + "  "
                    }
                    out = out + "//"
                    if f.toks[i].sval.len > 0 {
                        out = out + " " + f.toks[i].sval
                    }
                } else {
                    out = out + f.token_text(i)
                }
                // Track for-header / index brackets for later range-colon calls.
                if tk == 9 { in_for_hdr = 1 }
                if tk == 10 && in_for_hdr == 1 { in_for_hdr = 2 }
                if tk == 21 && in_for_hdr == 2 { in_for_hdr = 0 }
                if tk == 23 {
                    if fmt_ends_value(prev) { bracket_idx = bracket_idx + 1 }
                }
                if tk == 24 {
                    if bracket_idx > 0 { bracket_idx = bracket_idx - 1 }
                }
                if tk == 21 { depth = depth + 1 }
                prev = tk
                i = i + 1
            }
        }
    }
    for k in 0:out.len {
        if out.len > 0 && out[out.len - 1] == 32 { out = out[0:out.len - 1] }
    }
    for k in 0:out.len {
        if out.len > 0 && out[out.len - 1] == 10 { out = out[0:out.len - 1] }
    }
    << out + "\n"
}

pub fn format_source(src string) string {
    $f := FmtBuf{src: src, toks: []ast.Token{}}
    f.collect_tokens()
    << f.run()
}
