@xu/format
// Source formatter API, analogous to Go's `go/format`.
//
// Go's `format.Source` parses to AST then `printer.Fprint`. Xu's formatter
// reprints from tokens (must match bootstrap `xuparse/fmt.rs` byte-for-byte),
// so this package is a thin wrapper over `xu.printer`.


#xu/printer

pub fn source(src string) string {
    << printer.format_source(src)
}

fn is_ident_char(c int) bool {
    << (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95 || c == 36
}

pub fn migrate_copy(src string) string {
    $out := ""
    $i := 0
    n := src.len
    while i < n {
        c := src[i]
        if c == 34 { // '"'
            out = out + "\""
            i += 1
            while i < n && src[i] != 34 {
                if src[i] == 92 && i + 1 < n { // '\'
                    out = out + src[i:i + 2]
                    i += 2
                } else {
                    out = out + src[i:i + 1]
                    i += 1
                }
            }
            if i < n {
                out = out + "\""
                i += 1
            }
        } else if c == 39 { // '\''
            out = out + "'"
            i += 1
            while i < n && src[i] != 39 {
                if src[i] == 92 && i + 1 < n {
                    out = out + src[i:i + 2]
                    i += 2
                } else {
                    out = out + src[i:i + 1]
                    i += 1
                }
            }
            if i < n {
                out = out + "'"
                i += 1
            }
        } else if c == 47 && i + 1 < n && src[i + 1] == 47 { // "//"
            while i < n && src[i] != 10 {
                out = out + src[i:i + 1]
                i += 1
            }
        } else if c == 47 && i + 1 < n && src[i + 1] == 42 { // "/*"
            out = out + "/*"
            i += 2
            while i + 1 < n && !(src[i] == 42 && src[i + 1] == 47) {
                out = out + src[i:i + 1]
                i += 1
            }
            if i + 1 < n {
                out = out + "*/"
                i += 2
            }
        } else if i + 9 < n && src[i:i + 9] == "str_clone" && (i == 0 || !is_ident_char(src[i - 1])) {
            $j := i + 9
            while j < n && (src[j] == 32 || src[j] == 9) { j += 1 }
            if j < n && src[j] == 40 { // '('
                $arg_start := j + 1
                while arg_start < n && (src[arg_start] == 32 || src[arg_start] == 9) { arg_start += 1 }
                if arg_start < n && src[arg_start] == 38 { // '&'
                    arg_start += 1
                    while arg_start < n && (src[arg_start] == 32 || src[arg_start] == 9) { arg_start += 1 }
                }
                $depth := 1
                $k := j + 1
                while k < n && depth > 0 {
                    if src[k] == 40 { depth += 1 }
                    else if src[k] == 41 { depth -= 1 }
                    else if src[k] == 34 {
                        k += 1
                        while k < n && src[k] != 34 {
                            if src[k] == 92 { k += 1 }
                            k += 1
                        }
                    }
                    if depth > 0 { k += 1 }
                }
                if depth == 0 {
                    arg := src[arg_start:k]
                    out = out + "~" + arg
                    i = k + 1
                } else {
                    out = out + src[i:i + 1]
                    i += 1
                }
            } else {
                out = out + src[i:i + 1]
                i += 1
            }
        } else {
            out = out + src[i:i + 1]
            i += 1
        }
    }

    // Second pass: replace `expr + ""` with `~expr`
    $out2 := ""
    $m := 0
    total := out.len
    while m < total {
        c := out[m]
        if c == 34 {
            $start_str := m
            m += 1
            while m < total && out[m] != 34 {
                if out[m] == 92 && m + 1 < total { m += 2 } else { m += 1 }
            }
            if m < total { m += 1 }
            out2 = out2 + out[start_str:m]
        } else if c == 47 && m + 1 < total && out[m + 1] == 47 {
            while m < total && out[m] != 10 {
                out2 = out2 + out[m:m + 1]
                m += 1
            }
        } else if m + 5 <= total && out[m:m + 5] == " + \"\"" {
            $p := out2.len
            while p > 0 && (out2[p - 1] == 32 || out2[p - 1] == 9) { p -= 1 }
            $expr_end := p
            $pdepth := 0
            $bdepth := 0
            $stop := false
            while p > 0 && !stop {
                ch := out2[p - 1]
                if ch == 41 { pdepth += 1 }
                else if ch == 40 {
                    if pdepth > 0 { pdepth -= 1 }
                    else { stop = true }
                }
                else if ch == 93 { bdepth += 1 }
                else if ch == 91 {
                    if bdepth > 0 { bdepth -= 1 }
                    else { stop = true }
                }
                else if pdepth == 0 && bdepth == 0 {
                    if ch == 32 || ch == 9 || ch == 59 || ch == 44 || ch == 61 || ch == 123 || ch == 125 || ch == 10 {
                        stop = true
                    }
                }
                if !stop { p -= 1 }
            }
            if p < expr_end {
                prefix := out2[0:p]
                lhs := out2[p:expr_end]
                out2 = prefix + "~" + lhs
                m += 5
            } else {
                out2 = out2 + out[m:m + 1]
                m += 1
            }
        } else {
            out2 = out2 + out[m:m + 1]
            m += 1
        }
    }
    << printer.format_source(out2)
}
