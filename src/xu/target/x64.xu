@xu/target
// x86-64 (AMD64) machine instruction encoder.
//
// Layer 4B module: pure instruction encoding functions writing to CodeBuffer.
// Completely decoupled from AST, types, symbols, or object file format.

#xu/mc

// 64-bit general purpose register encodings
pub const REG_X64_RAX = 0
pub const REG_X64_RCX = 1
pub const REG_X64_RDX = 2
pub const REG_X64_RBX = 3
pub const REG_X64_RSP = 4
pub const REG_X64_RBP = 5
pub const REG_X64_RSI = 6
pub const REG_X64_RDI = 7
pub const REG_X64_R8  = 8
pub const REG_X64_R9  = 9
pub const REG_X64_R10 = 10
pub const REG_X64_R11 = 11
pub const REG_X64_R12 = 12
pub const REG_X64_R13 = 13
pub const REG_X64_R14 = 14
pub const REG_X64_R15 = 15

// Condition codes (for jcc and setcc)
pub const X64_COND_O  = 0
pub const X64_COND_NO = 1
pub const X64_COND_B  = 2  // ULT
pub const X64_COND_AE = 3  // UGE
pub const X64_COND_E  = 4  // EQ
pub const X64_COND_NE = 5  // NE
pub const X64_COND_BE = 6  // ULE
pub const X64_COND_A  = 7  // UGT
pub const X64_COND_S  = 8
pub const X64_COND_NS = 9
pub const X64_COND_P  = 10
pub const X64_COND_NP = 11
pub const X64_COND_L  = 12 // SLT
pub const X64_COND_GE = 13 // SGE
pub const X64_COND_LE = 14 // SLE
pub const X64_COND_G  = 15 // SGT

fn rex(w bool, r int, x int, b int) int {
    $v := 0x40
    if w { v = v | 8 }
    if (r & 8) != 0 { v = v | 4 }
    if (x & 8) != 0 { v = v | 2 }
    if (b & 8) != 0 { v = v | 1 }
    << v
}

fn modrm(mod int, reg int, rm int) int {
    << ((mod & 3) << 6) | ((reg & 7) << 3) | (rm & 7)
}

fn sib(scale int, index int, base int) int {
    << ((scale & 3) << 6) | ((index & 7) << 3) | (base & 7)
}

pub fn x64_nop(buf $&mc.CodeBuffer) {
    buf.emit_u8(0x90)
}

pub fn x64_ret(buf $&mc.CodeBuffer) {
    buf.emit_u8(0xc3)
}

pub fn x64_syscall(buf $&mc.CodeBuffer) {
    buf.emit_u8(0x0f)
    buf.emit_u8(0x05)
}

pub fn x64_push(buf $&mc.CodeBuffer, reg int) {
    if (reg & 8) != 0 {
        buf.emit_u8(rex(false, 0, 0, reg))
    }
    buf.emit_u8(0x50 + (reg & 7))
}

pub fn x64_pop(buf $&mc.CodeBuffer, reg int) {
    if (reg & 8) != 0 {
        buf.emit_u8(rex(false, 0, 0, reg))
    }
    buf.emit_u8(0x58 + (reg & 7))
}

pub fn x64_mov_imm64(buf $&mc.CodeBuffer, reg int, val int) {
    buf.emit_u8(rex(true, 0, 0, reg))
    buf.emit_u8(0xb8 + (reg & 7))
    buf.emit_u64_le(val)
}

pub fn x64_mov_reg(buf $&mc.CodeBuffer, dst int, src int) {
    buf.emit_u8(rex(true, src, 0, dst))
    buf.emit_u8(0x89)
    buf.emit_u8(modrm(3, src, dst))
}

pub fn x64_add_reg(buf $&mc.CodeBuffer, dst int, src int) {
    buf.emit_u8(rex(true, src, 0, dst))
    buf.emit_u8(0x01)
    buf.emit_u8(modrm(3, src, dst))
}

pub fn x64_sub_reg(buf $&mc.CodeBuffer, dst int, src int) {
    buf.emit_u8(rex(true, src, 0, dst))
    buf.emit_u8(0x29)
    buf.emit_u8(modrm(3, src, dst))
}

pub fn x64_imul_reg(buf $&mc.CodeBuffer, dst int, src int) {
    buf.emit_u8(rex(true, dst, 0, src))
    buf.emit_u8(0x0f)
    buf.emit_u8(0xaf)
    buf.emit_u8(modrm(3, dst, src))
}

pub fn x64_sub_imm32(buf $&mc.CodeBuffer, dst int, imm int) {
    buf.emit_u8(rex(true, 0, 0, dst))
    buf.emit_u8(0x81)
    buf.emit_u8(modrm(3, 5, dst)) // /5 is sub
    buf.emit_u32_le(imm)
}

pub fn x64_add_imm32(buf $&mc.CodeBuffer, dst int, imm int) {
    buf.emit_u8(rex(true, 0, 0, dst))
    buf.emit_u8(0x81)
    buf.emit_u8(modrm(3, 0, dst)) // /0 is add
    buf.emit_u32_le(imm)
}

pub fn x64_cmp_reg(buf $&mc.CodeBuffer, reg1 int, reg2 int) {
    buf.emit_u8(rex(true, reg2, 0, reg1))
    buf.emit_u8(0x39)
    buf.emit_u8(modrm(3, reg2, reg1))
}

pub fn x64_cmp_imm32(buf $&mc.CodeBuffer, reg int, imm int) {
    buf.emit_u8(rex(true, 0, 0, reg))
    buf.emit_u8(0x81)
    buf.emit_u8(modrm(3, 7, reg)) // /7 is cmp
    buf.emit_u32_le(imm)
}

pub fn x64_setcc(buf $&mc.CodeBuffer, dst int, cond int) {
    if (dst & 8) != 0 || dst >= 4 {
        buf.emit_u8(rex(false, 0, 0, dst))
    }
    buf.emit_u8(0x0f)
    buf.emit_u8(0x90 + (cond & 15))
    buf.emit_u8(modrm(3, 0, dst))
}

// Memory: mov [rsp + disp], reg
pub fn x64_str_rsp(buf $&mc.CodeBuffer, src int, disp int) {
    buf.emit_u8(rex(true, src, 0, REG_X64_RSP))
    buf.emit_u8(0x89)
    if disp >= -128 && disp <= 127 {
        buf.emit_u8(modrm(1, src, 4)) // mod=1: disp8, rm=4: SIB follows
        buf.emit_u8(sib(0, 4, 4))     // SIB: rsp
        buf.emit_u8(disp & 255)
    } else {
        buf.emit_u8(modrm(2, src, 4)) // mod=2: disp32, rm=4: SIB follows
        buf.emit_u8(sib(0, 4, 4))
        buf.emit_u32_le(disp)
    }
}

// Memory: mov reg, [rsp + disp]
pub fn x64_ldr_rsp(buf $&mc.CodeBuffer, dst int, disp int) {
    buf.emit_u8(rex(true, dst, 0, REG_X64_RSP))
    buf.emit_u8(0x8b)
    if disp >= -128 && disp <= 127 {
        buf.emit_u8(modrm(1, dst, 4))
        buf.emit_u8(sib(0, 4, 4))
        buf.emit_u8(disp & 255)
    } else {
        buf.emit_u8(modrm(2, dst, 4))
        buf.emit_u8(sib(0, 4, 4))
        buf.emit_u32_le(disp)
    }
}

pub fn x64_call(buf $&mc.CodeBuffer, rel32 int) {
    buf.emit_u8(0xe8)
    buf.emit_u32_le(rel32)
}

pub fn x64_jmp(buf $&mc.CodeBuffer, rel32 int) {
    buf.emit_u8(0xe9)
    buf.emit_u32_le(rel32)
}

pub fn x64_jcc(buf $&mc.CodeBuffer, cond int, rel32 int) {
    buf.emit_u8(0x0f)
    buf.emit_u8(0x80 + (cond & 15))
    buf.emit_u32_le(rel32)
}
