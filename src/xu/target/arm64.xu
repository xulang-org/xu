@xu/target
// ARM64 A64 machine instruction encoder.
//
// Layer 4B module: pure instruction encoding functions that emit 32-bit ARM64
// opcodes directly into a CodeBuffer. No register allocator or compiler state.

#xu/mc

// 64-bit integer registers
pub const REG_ARM64_X0 = 0
pub const REG_ARM64_X1 = 1
pub const REG_ARM64_X2 = 2
pub const REG_ARM64_X3 = 3
pub const REG_ARM64_X4 = 4
pub const REG_ARM64_X5 = 5
pub const REG_ARM64_X6 = 6
pub const REG_ARM64_X7 = 7
pub const REG_ARM64_X8 = 8
pub const REG_ARM64_X9 = 9
pub const REG_ARM64_X10 = 10
pub const REG_ARM64_X11 = 11
pub const REG_ARM64_X12 = 12
pub const REG_ARM64_X13 = 13
pub const REG_ARM64_X14 = 14
pub const REG_ARM64_X15 = 15
pub const REG_ARM64_X16 = 16
pub const REG_ARM64_X17 = 17
pub const REG_ARM64_X18 = 18
pub const REG_ARM64_X19 = 19
pub const REG_ARM64_X20 = 20
pub const REG_ARM64_X21 = 21
pub const REG_ARM64_X22 = 22
pub const REG_ARM64_X23 = 23
pub const REG_ARM64_X24 = 24
pub const REG_ARM64_X25 = 25
pub const REG_ARM64_X26 = 26
pub const REG_ARM64_X27 = 27
pub const REG_ARM64_X28 = 28
pub const REG_ARM64_FP = 29
pub const REG_ARM64_LR = 30
pub const REG_ARM64_SP = 31
pub const REG_ARM64_XZR = 31

// ARM64 condition codes
pub const ARM64_COND_EQ = 0
pub const ARM64_COND_NE = 1
pub const ARM64_COND_CS = 2
pub const ARM64_COND_CC = 3
pub const ARM64_COND_MI = 4
pub const ARM64_COND_PL = 5
pub const ARM64_COND_VS = 6
pub const ARM64_COND_VC = 7
pub const ARM64_COND_HI = 8
pub const ARM64_COND_LS = 9
pub const ARM64_COND_GE = 10
pub const ARM64_COND_LT = 11
pub const ARM64_COND_GT = 12
pub const ARM64_COND_LE = 13
pub const ARM64_COND_AL = 14

pub fn arm64_ret(buf $&mc.CodeBuffer) {
    // ret lr -> 0xd65f03c0
    buf.emit_u32_le(0xd65f03c0)
}

pub fn arm64_nop(buf $&mc.CodeBuffer) {
    // nop -> 0xd503201f
    buf.emit_u32_le(0xd503201f)
}

pub fn arm64_svc(buf $&mc.CodeBuffer, imm16 int) {
    // svc #imm -> 0xd4000001 | ((imm16 & 0xffff) << 5)
    op := 0xd4000001 | ((imm16 & 0xffff) << 5)
    buf.emit_u32_le(op)
}

pub fn arm64_add_reg(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // add xd, xn, xm (sf=1, op=0, S=0) -> 0x8b000000 | (rm << 16) | (rn << 5) | rd
    op := 0x8b000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_add_imm(buf $&mc.CodeBuffer, rd int, rn int, imm12 int) {
    // add xd, xn, #imm (sf=1, op=0, S=0) -> 0x91000000 | ((imm12 & 0xfff) << 10) | (rn << 5) | rd
    op := 0x91000000 | ((imm12 & 0xfff) << 10) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_add_reg_lsr(buf $&mc.CodeBuffer, rd int, rn int, rm int, shift int) {
    // add xd, xn, xm, lsr #shift
    op := 0x8b400000 | ((shift & 63) << 10) | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_asr_imm(buf $&mc.CodeBuffer, rd int, rn int, shift int) {
    // asr xd, xn, #shift -> sbfm xd, xn, #shift, #63
    op := 0x9340fc00 | ((shift & 63) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_lsr_imm(buf $&mc.CodeBuffer, rd int, rn int, shift int) {
    // lsr xd, xn, #shift -> ubfm xd, xn, #shift, #63
    op := 0xd340fc00 | ((shift & 63) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_sub_reg(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // sub xd, xn, xm (sf=1, op=1, S=0) -> 0xcb000000 | (rm << 16) | (rn << 5) | rd
    op := 0xcb000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_sub_imm(buf $&mc.CodeBuffer, rd int, rn int, imm12 int) {
    // sub xd, xn, #imm (sf=1, op=1, S=0) -> 0xd1000000 | ((imm12 & 0xfff) << 10) | (rn << 5) | rd
    op := 0xd1000000 | ((imm12 & 0xfff) << 10) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_mul(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // mul xd, xn, xm -> madd xd, xn, xm, xzr -> 0x9b007c00 | (rm << 16) | (rn << 5) | rd
    op := 0x9b007c00 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_madd(buf $&mc.CodeBuffer, rd int, rn int, rm int, ra int) {
    // madd xd, xn, xm, xa -> 0x9b000000 | (rm << 16) | (ra << 10) | (rn << 5) | rd
    op := 0x9b000000 | ((rm & 31) << 16) | ((ra & 31) << 10) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_msub(buf $&mc.CodeBuffer, rd int, rn int, rm int, ra int) {
    // msub xd, xn, xm, xa -> 0x9b008000 | (rm << 16) | (ra << 10) | (rn << 5) | rd
    op := 0x9b008000 | ((rm & 31) << 16) | ((ra & 31) << 10) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_smulh(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // smulh xd, xn, xm -> 0x9b407c00 | (rm << 16) | (rn << 5) | rd
    op := 0x9b407c00 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_csel(buf $&mc.CodeBuffer, rd int, rn int, rm int, cond int) {
    // csel xd, xn, xm, cond -> 0x9a800000 | (rm << 16) | (cond << 12) | (rn << 5) | rd
    op := 0x9a800000 | ((rm & 31) << 16) | ((cond & 15) << 12) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_sdiv(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // sdiv xd, xn, xm -> 0x9ac00c00 | (rm << 16) | (rn << 5) | rd
    op := 0x9ac00c00 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_udiv(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // udiv xd, xn, xm -> 0x9ac00800 | (rm << 16) | (rn << 5) | rd
    op := 0x9ac00800 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_and_imm(buf $&mc.CodeBuffer, rd int, rn int, imms int) {
    // and xd, xn, #imm (bitmask with imms ones, immr=0, N=1)
    // 0x92400000 | ((imms & 63) << 10) | ((rn & 31) << 5) | (rd & 31)
    op := 0x92400000 | ((imms & 63) * 1024) | ((rn & 31) * 32) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_and_reg(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // and xd, xn, xm -> 0x8a000000 | (rm << 16) | (rn << 5) | rd
    op := 0x8a000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_orr_reg(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // orr xd, xn, xm -> 0xaa000000 | (rm << 16) | (rn << 5) | rd
    op := 0xaa000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_eor_reg(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    // eor xd, xn, xm -> 0xca000000 | (rm << 16) | (rn << 5) | rd
    op := 0xca000000 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_mov_reg(buf $&mc.CodeBuffer, rd int, rm int) {
    // mov xd, xm -> orr xd, xzr, xm
    arm64_orr_reg(buf, rd, REG_ARM64_XZR, rm)
}

pub fn arm64_cmp_reg(buf $&mc.CodeBuffer, rn int, rm int) {
    // cmp xn, xm -> subs xzr, xn, xm -> 0xeb00001f | (rm << 16) | (rn << 5)
    op := 0xeb00001f | ((rm & 31) << 16) | ((rn & 31) << 5)
    buf.emit_u32_le(op)
}

pub fn arm64_cmp_imm(buf $&mc.CodeBuffer, rn int, imm12 int) {
    // cmp xn, #imm -> subs xzr, xn, #imm -> 0xf100001f | ((imm12 & 0xfff) << 10) | (rn << 5)
    op := 0xf100001f | ((imm12 & 0xfff) << 10) | ((rn & 31) << 5)
    buf.emit_u32_le(op)
}

pub fn arm64_cset(buf $&mc.CodeBuffer, rd int, cond int) {
    // cset xd, cond -> csinc xd, xzr, xzr, invert(cond)
    // inverted cond is cond ^ 1
    inv := cond ^ 1
    op := 0x9a9f07e0 | ((inv & 15) << 12) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_movz(buf $&mc.CodeBuffer, rd int, imm16 int, shift_hw int) {
    // movz xd, #imm, lsl #(hw*16) -> 0xd2800000 | (hw << 21) | (imm16 << 5) | rd
    op := 0xd2800000 | ((shift_hw & 3) << 21) | ((imm16 & 0xffff) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_movk(buf $&mc.CodeBuffer, rd int, imm16 int, shift_hw int) {
    // movk xd, #imm, lsl #(hw*16) -> 0xf2800000 | (hw << 21) | (imm16 << 5) | rd
    op := 0xf2800000 | ((shift_hw & 3) << 21) | ((imm16 & 0xffff) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_mov_imm64(buf $&mc.CodeBuffer, rd int, val int) {
    w0 := val & 0xffff
    w1 := (val >> 16) & 0xffff
    w2 := (val >> 32) & 0xffff
    w3 := (val >> 48) & 0xffff
    arm64_movz(buf, rd, w0, 0)
    if w1 != 0 || w2 != 0 || w3 != 0 {
        arm64_movk(buf, rd, w1, 1)
    }
    if w2 != 0 || w3 != 0 {
        arm64_movk(buf, rd, w2, 2)
    }
    if w3 != 0 {
        arm64_movk(buf, rd, w3, 3)
    }
}

pub fn arm64_ldr_imm(buf $&mc.CodeBuffer, rt int, rn int, imm_bytes int) {
    // ldr xt, [xn, #imm] (scale=8, imm12 = imm_bytes / 8) -> 0xf9400000 | (imm12 << 10) | (rn << 5) | rt
    imm12 := (imm_bytes / 8) & 0xfff
    op := 0xf9400000 | (imm12 << 10) | ((rn & 31) << 5) | (rt & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_str_imm(buf $&mc.CodeBuffer, rt int, rn int, imm_bytes int) {
    // str xt, [xn, #imm] (scale=8, imm12 = imm_bytes / 8) -> 0xf9000000 | (imm12 << 10) | (rn << 5) | rt
    imm12 := (imm_bytes / 8) & 0xfff
    op := 0xf9000000 | (imm12 << 10) | ((rn & 31) << 5) | (rt & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_ldr_reg_lsl3(buf $&mc.CodeBuffer, rt int, rn int, rm int) {
    // ldr xt, [xn, xm, lsl #3] -> 0xf8607800 | (rm << 16) | (rn << 5) | rt
    op := 0xf8607800 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rt & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_str_reg_lsl3(buf $&mc.CodeBuffer, rt int, rn int, rm int) {
    // str xt, [xn, xm, lsl #3] -> 0xf8207800 | (rm << 16) | (rn << 5) | rt
    op := 0xf8207800 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rt & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_stp_pre(buf $&mc.CodeBuffer, rt1 int, rt2 int, rn int, imm7_bytes int) {
    // stp rt1, rt2, [rn, #imm]! -> 0xa9bf0000 with scaled imm7 (imm / 8)
    imm7 := (imm7_bytes / 8) & 0x7f
    op := 0xa9800000 | 0x00200000 | ((imm7 & 0x7f) << 15) | ((rt2 & 31) << 10) | ((rn & 31) << 5) | (rt1 & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_ldp_post(buf $&mc.CodeBuffer, rt1 int, rt2 int, rn int, imm7_bytes int) {
    // ldp rt1, rt2, [rn], #imm -> 0xa8c00000 with scaled imm7 (imm / 8)
    imm7 := (imm7_bytes / 8) & 0x7f
    op := 0xa8c00000 | ((imm7 & 0x7f) << 15) | ((rt2 & 31) << 10) | ((rn & 31) << 5) | (rt1 & 31)
    buf.emit_u32_le(op)
}

pub fn arm64_b(buf $&mc.CodeBuffer, imm26 int) {
    // b label -> 0x14000000 | (imm26 & 0x03ffffff)
    op := 0x14000000 | (imm26 & 0x03ffffff)
    buf.emit_u32_le(op)
}

pub fn arm64_bl(buf $&mc.CodeBuffer, imm26 int) {
    // bl label -> 0x94000000 | (imm26 & 0x03ffffff)
    op := 0x94000000 | (imm26 & 0x03ffffff)
    buf.emit_u32_le(op)
}

pub fn arm64_b_cond(buf $&mc.CodeBuffer, cond int, imm19 int) {
    // b.cond label -> 0x54000000 | ((imm19 & 0x7ffff) << 5) | (cond & 15)
    op := 0x54000000 | ((imm19 & 0x7ffff) << 5) | (cond & 15)
    buf.emit_u32_le(op)
}

pub fn arm64_br(buf $&mc.CodeBuffer, rn int) {
    // br xn -> 0xd61f0000 | (rn << 5)
    op := 0xd61f0000 | ((rn & 31) << 5)
    buf.emit_u32_le(op)
}

pub fn arm64_blr(buf $&mc.CodeBuffer, rn int) {
    // blr xn -> 0xd63f0000 | (rn << 5)
    op := 0xd63f0000 | ((rn & 31) << 5)
    buf.emit_u32_le(op)
}
