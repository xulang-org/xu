@xu/target/chips/cortex_m4
// ARM Cortex-M4 microarchitecture package.
//
// Layer 4B module: defines instruction capabilities and pipeline limits for
// Cortex-M microcontroller cores with DSP and saturating arithmetic.

#xu/target/chips/model

pub fn name() string {
    << "cortex-m4"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "cortex-m4",
        issue_width: 1,
        vector_bits: 0,
        unroll_factor: 1,
        has_fast_mul: true,
        has_cond_select: false,
        has_fused_alu: false,
        has_shifted_reg: true,
        has_lse: false,
        has_popcnt_clz: true,
        has_crypto_aes: false,
        has_crypto_sha1: false,
        has_crypto_sha2: false,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: false,
        has_bmi2: false,
        has_dsp: true,
        has_zero_loop: false
    }
}
