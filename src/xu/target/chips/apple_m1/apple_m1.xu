@xu/target/chips/apple_m1
// Apple Silicon (M1/M2/M3/M4, A14-A18) microarchitecture package.
//
// Layer 4B module: defines instruction capabilities, pipeline limits, and
// special cryptographic/system extensions for Apple ARM64 processors.

#xu/target/chips/model

pub fn name() string {
    << "apple-m1"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "apple-m1",
        issue_width: 8,
        vector_bits: 128,
        unroll_factor: 2,
        has_fast_mul: true,
        has_cond_select: true,
        has_fused_alu: true,
        has_shifted_reg: true,
        has_lse: true,
        has_popcnt_clz: true,
        has_crypto_aes: true,
        has_crypto_sha1: true,
        has_crypto_sha2: true,
        has_crypto_sha3: true,
        has_crypto_sha512: true,
        has_crypto_sm3: true,
        has_crypto_sm4: true,
        has_crc32: true,
        has_bmi2: false,
        has_dsp: false,
        has_zero_loop: false
    }
}

// Apple Silicon special cryptographic instruction opcode hints:
// AESE: 0x4e284800 (AES Single Round Encryption)
// AESMC: 0x4e286800 (AES Mix Columns)
// SHA256H: 0x5e004000 (SHA-256 Hash Update part 1)
// SHA256H2: 0x5e005000 (SHA-256 Hash Update part 2)
// CRC32X: 0x9ac04800 (CRC32 64-bit scalar checksum)
// CASAL: 0xc8e0fc00 (Atomic Compare-and-Swap with acquire-release)
pub fn is_crypto_accelerated() bool {
    << true
}
