@xu/target/chips/arm_a76
// ARM Cortex-A76 microarchitecture package.
//
// Layer 4B module: defines instruction capabilities and pipeline limits for
// high-performance ARMv8.2-A out-of-order processors.

#xu/target/chips/model

pub fn name() string {
    << "cortex-a76"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "cortex-a76",
        issue_width: 4,
        vector_bits: 128,
        unroll_factor: 2,
        has_fast_mul: true,
        has_cond_select: true,
        has_fused_alu: true,
        has_shifted_reg: true,
        has_lse: true,
        has_popcnt_clz: true,
        has_crypto_aes: true,
        has_crypto_sha1: true,
        has_crypto_sha2: true,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: true,
        has_bmi2: false,
        has_dsp: false,
        has_zero_loop: false
    }
}
