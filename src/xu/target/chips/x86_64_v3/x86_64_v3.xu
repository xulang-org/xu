@xu/target/chips/x86_64_v3
// x86-64-v3 microarchitecture package (Haswell / Zen 2 baseline).
//
// Layer 4B module: defines instruction capabilities and pipeline limits for
// modern 64-bit x86 processors with AVX2, FMA3, and BMI1/BMI2.

#xu/target/chips/model

pub fn name() string {
    << "x86-64-v3"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "x86-64-v3",
        issue_width: 4,
        vector_bits: 256,
        unroll_factor: 2,
        has_fast_mul: true,
        has_cond_select: true,
        has_fused_alu: true,
        has_shifted_reg: false,
        has_lse: false,
        has_popcnt_clz: true,
        has_crypto_aes: true,
        has_crypto_sha1: true,
        has_crypto_sha2: true,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: true,
        has_bmi2: true,
        has_dsp: false,
        has_zero_loop: false
    }
}
