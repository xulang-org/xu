@xu/target/chips/generic
// Generic conservative microarchitecture fallback package.
//
// Layer 4B module: defines baseline capabilities for unknown or generic chips.

#xu/target/chips/model

pub fn name() string {
    << "generic"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "generic",
        issue_width: 1,
        vector_bits: 0,
        unroll_factor: 1,
        has_fast_mul: false,
        has_cond_select: false,
        has_fused_alu: false,
        has_shifted_reg: false,
        has_lse: false,
        has_popcnt_clz: false,
        has_crypto_aes: false,
        has_crypto_sha1: false,
        has_crypto_sha2: false,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: false,
        has_bmi2: false,
        has_dsp: false,
        has_zero_loop: false
    }
}
