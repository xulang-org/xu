@xu/target/chips/esp32_lx6
// ESP32-LX6 (Xtensa dual-core) microarchitecture package.
//
// Layer 4B module: defines instruction capabilities and pipeline limits for
// Espressif Xtensa LX6 processors with hardware zero-overhead loops.

#xu/target/chips/model

pub fn name() string {
    << "esp32-lx6"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "esp32-lx6",
        issue_width: 1,
        vector_bits: 0,
        unroll_factor: 1,
        has_fast_mul: true,
        has_cond_select: false,
        has_fused_alu: false,
        has_shifted_reg: false,
        has_lse: false,
        has_popcnt_clz: false,
        has_crypto_aes: false,
        has_crypto_sha1: false,
        has_crypto_sha2: false,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: false,
        has_bmi2: false,
        has_dsp: false,
        has_zero_loop: true
    }
}
