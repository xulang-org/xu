@xu/target
// Target architecture and operating system definitions.
//
// Layer 4B module: hardware platform metadata, register definitions, and ABI limits.

#xu/target/chips/model
#xu/target/chips/apple_m1
#xu/target/chips/arm_a76
#xu/target/chips/arm_a53
#xu/target/chips/x86_64_v3
#xu/target/chips/cortex_m4
#xu/target/chips/esp32_c3
#xu/target/chips/esp32_lx6
#xu/target/chips/generic

pub const OS_MACOS = 0
pub const OS_LINUX = 1
pub const OS_WINDOWS = 2
pub const OS_NONE = 3

pub const ARCH_ARM64 = 0
pub const ARCH_X64 = 1
pub const ARCH_THUMB = 2
pub const ARCH_RISCV32 = 3
pub const ARCH_RISCV64 = 4
pub const ARCH_LOONG64 = 5
pub const ARCH_XTENSA = 6
pub const ARCH_WASM = 7

// Microarchitecture / Chip identifiers
pub const CHIP_GENERIC = 0
pub const CHIP_NATIVE = 1
pub const CHIP_APPLE_M1 = 2
pub const CHIP_ARM_A76 = 3
pub const CHIP_ARM_A53 = 4
pub const CHIP_X86_64_V3 = 5
pub const CHIP_X86_64_GENERIC = 6
pub const CHIP_CORTEX_M4 = 7
pub const CHIP_ESP32_LX6 = 8
pub const CHIP_ESP32_C3 = 9

pub struct TargetFeatures {
    pub has_cond_select bool
    pub has_fused_alu bool
    pub has_shifted_reg bool
    pub has_lse bool
    pub has_popcnt_clz bool
    pub has_fast_mul bool
    pub unroll_factor int
    pub vector_bits int
    pub has_crypto_aes bool
    pub has_crypto_sha1 bool
    pub has_crypto_sha2 bool
    pub has_crypto_sha3 bool
    pub has_crypto_sha512 bool
    pub has_crypto_sm3 bool
    pub has_crypto_sm4 bool
    pub has_crc32 bool
    pub has_bmi2 bool
    pub has_dsp bool
    pub has_zero_loop bool
}

fn features_from_caps(c &model.ChipCaps) TargetFeatures {
    << TargetFeatures{
        has_cond_select: c.has_cond_select,
        has_fused_alu: c.has_fused_alu,
        has_shifted_reg: c.has_shifted_reg,
        has_lse: c.has_lse,
        has_popcnt_clz: c.has_popcnt_clz,
        has_fast_mul: c.has_fast_mul,
        unroll_factor: c.unroll_factor,
        vector_bits: c.vector_bits,
        has_crypto_aes: c.has_crypto_aes,
        has_crypto_sha1: c.has_crypto_sha1,
        has_crypto_sha2: c.has_crypto_sha2,
        has_crypto_sha3: c.has_crypto_sha3,
        has_crypto_sha512: c.has_crypto_sha512,
        has_crypto_sm3: c.has_crypto_sm3,
        has_crypto_sm4: c.has_crypto_sm4,
        has_crc32: c.has_crc32,
        has_bmi2: c.has_bmi2,
        has_dsp: c.has_dsp,
        has_zero_loop: c.has_zero_loop
    }
}

pub fn target_features_for_chip(os int, arch int, chip int) TargetFeatures {
    if chip == CHIP_APPLE_M1 {
        c := apple_m1.caps()
        << features_from_caps(&c)
    }
    if chip == CHIP_ARM_A76 {
        c := arm_a76.caps()
        << features_from_caps(&c)
    }
    if chip == CHIP_ARM_A53 {
        c := arm_a53.caps()
        << features_from_caps(&c)
    }
    if chip == CHIP_X86_64_V3 {
        c := x86_64_v3.caps()
        << features_from_caps(&c)
    }
    if chip == CHIP_CORTEX_M4 {
        c := cortex_m4.caps()
        << features_from_caps(&c)
    }
    if chip == CHIP_ESP32_C3 {
        c := esp32_c3.caps()
        << features_from_caps(&c)
    }
    if chip == CHIP_ESP32_LX6 {
        c := esp32_lx6.caps()
        << features_from_caps(&c)
    }
    if arch == ARCH_ARM64 {
        if os == OS_MACOS {
            c := apple_m1.caps()
            << features_from_caps(&c)
        }
        c := arm_a76.caps()
        << features_from_caps(&c)
    }
    if arch == ARCH_X64 {
        c := x86_64_v3.caps()
        << features_from_caps(&c)
    }
    c_gen := generic.caps()
    << features_from_caps(&c_gen)
}

pub fn target_features_default(os int, arch int) TargetFeatures {
    << target_features_for_chip(os, arch, CHIP_GENERIC)
}

pub fn target_features_conservative() TargetFeatures {
    c_gen := generic.caps()
    << features_from_caps(&c_gen)
}

pub struct Target {
    pub os int
    pub arch int
    pub chip int
    pub pointer_size int
    pub page_size int
    pub features TargetFeatures
}

pub fn detect_host_chip(os int, arch int) int {
    if os == OS_MACOS && arch == ARCH_ARM64 {
        << CHIP_APPLE_M1
    }
    if arch == ARCH_X64 {
        << CHIP_X86_64_V3
    }
    if arch == ARCH_XTENSA {
        << CHIP_ESP32_LX6
    }
    if arch == ARCH_RISCV32 {
        << CHIP_ESP32_C3
    }
    if arch == ARCH_THUMB {
        << CHIP_CORTEX_M4
    }
    << CHIP_GENERIC
}

pub fn target_new_with_chip(os int, arch int, chip int) Target {
    $c := chip
    if c == CHIP_NATIVE {
        c = detect_host_chip(os, arch)
    }
    $ptr_sz := 8
    if arch == ARCH_THUMB || arch == ARCH_RISCV32 || arch == ARCH_XTENSA || arch == ARCH_WASM {
        ptr_sz = 4
    }
    $pg_sz := 4096
    if os == OS_MACOS && arch == ARCH_ARM64 {
        pg_sz = 16384
    }
    << Target{
        os: os,
        arch: arch,
        chip: c,
        pointer_size: ptr_sz,
        page_size: pg_sz,
        features: target_features_for_chip(os, arch, c)
    }
}

pub fn target_new(os int, arch int) Target {
    c := detect_host_chip(os, arch)
    << target_new_with_chip(os, arch, c)
}

pub fn (t &Target) is_64bit() bool {
    << t.pointer_size == 8
}

pub fn target_code(os int, arch int) int {
    << os * 10 + arch
}

pub fn target_os(code int) int {
    << code / 10
}

pub fn target_arch(code int) int {
    << code % 10
}

pub fn target_from_code(code int) Target {
    os := code / 10
    arch := code % 10
    << target_new(os, arch)
}

pub fn target_os_name(os int) string {
    if os == OS_MACOS { << "macos" }
    if os == OS_LINUX { << "linux" }
    if os == OS_WINDOWS { << "windows" }
    if os == OS_NONE { << "none" }
    << "unknown"
}

pub fn target_arch_name(arch int) string {
    if arch == ARCH_ARM64 { << "arm64" }
    if arch == ARCH_X64 { << "x64" }
    if arch == ARCH_THUMB { << "arm32" }
    if arch == ARCH_RISCV32 { << "riscv32" }
    if arch == ARCH_RISCV64 { << "riscv64" }
    if arch == ARCH_LOONG64 { << "loong64" }
    if arch == ARCH_XTENSA { << "xtensa" }
    if arch == ARCH_WASM { << "wasm32" }
    << "unknown"
}

pub fn target_name(code int) string {
    if code == 0 { << "macos-arm64" }
    if code == 1 { << "macos-x64" }
    if code == 10 { << "linux-arm64" }
    if code == 11 { << "linux-x64" }
    if code == 12 { << "linux-arm32" }
    if code == 14 { << "linux-riscv64" }
    if code == 15 { << "linux-loongarch64" }
    if code == 20 { << "windows-arm64" }
    if code == 21 { << "windows-x64" }
    if code == 30 { << "freestanding" }
    if code == 32 { << "thumbv7em-none" }
    if code == 33 { << "riscv32imac-none" }
    if code == 36 { << "xtensa-esp32-none" }
    if code == 37 { << "wasm32" }
    << "unknown"
}

pub fn target_triple_name(t &Target) string {
    if t.os == OS_NONE {
        if t.arch == ARCH_WASM { << "wasm32" }
        if t.arch == ARCH_THUMB { << "thumbv7em-none" }
        if t.arch == ARCH_RISCV32 { << "riscv32imac-none" }
        if t.arch == ARCH_XTENSA { << "xtensa-esp32-none" }
        << "freestanding"
    }
    os_n := target_os_name(t.os)
    arch_n := target_arch_name(t.arch)
    << os_n + "-" + arch_n
}

pub fn target_host() Target {
    // Current native host is macOS ARM64
    << target_new(OS_MACOS, ARCH_ARM64)
}

pub fn parse_target(s string) int {
    if s.len == 0 {
        << -1
    }
    if s == "wasm32" || s == "wasm" {
        << 37
    }
    if s == "xtensa-esp32-none" || s == "xtensa" || s == "esp32" {
        << 36
    }
    if s == "riscv32imac-none" || s == "riscv32" || s == "esp32c3" {
        << 35
    }
    if s == "thumbv7em-none" || s == "thumb" || s == "cortex-m4" || s == "stm32" {
        << 34
    }
    if s == "linux-x64" || s == "linux-amd64" || s == "linux" {
        << 11
    }
    if s == "linux-arm64" || s == "linux-aarch64" {
        << 10
    }
    if s == "windows-x64" || s == "windows-amd64" || s == "windows" || s == "win64" {
        << 21
    }
    if s == "windows-arm64" {
        << 20
    }
    if s == "macos-arm64" || s == "darwin-arm64" || s == "macos" {
        << 0
    }
    if s == "macos-x64" || s == "darwin-x64" {
        << 1
    }
    if s == "riscv64-linux" || s == "riscv64" {
        << 12
    }
    if s == "loong64-linux" || s == "loong64" {
        << 13
    }
    << -1
}

pub fn ensure_bin_suffix(path string, os int, arch int) string {
    << ~path
}

pub fn parse_chip(s string) int {
    if s == "native" || s == "host" {
        << CHIP_NATIVE
    }
    if s == "apple-m1" || s == "m1" || s == "m2" || s == "m3" || s == "m4" || s == "apple" {
        << CHIP_APPLE_M1
    }
    if s == "cortex-a76" || s == "a76" || s == "neoverse-n1" {
        << CHIP_ARM_A76
    }
    if s == "cortex-a53" || s == "a53" || s == "rpi3" {
        << CHIP_ARM_A53
    }
    if s == "x86-64-v3" || s == "x86_64-v3" || s == "haswell" || s == "zen3" {
        << CHIP_X86_64_V3
    }
    if s == "x86-64-generic" || s == "generic-x64" {
        << CHIP_X86_64_GENERIC
    }
    if s == "cortex-m4" || s == "stm32" {
        << CHIP_CORTEX_M4
    }
    if s == "esp32" || s == "xtensa" {
        << CHIP_ESP32_LX6
    }
    if s == "esp32c3" || s == "riscv32" {
        << CHIP_ESP32_C3
    }
    if s == "generic" {
        << CHIP_GENERIC
    }
    << -1
}

pub fn chip_name(chip int) string {
    if chip == CHIP_APPLE_M1 { << "apple-m1" }
    if chip == CHIP_ARM_A76 { << "cortex-a76" }
    if chip == CHIP_ARM_A53 { << "cortex-a53" }
    if chip == CHIP_X86_64_V3 { << "x86-64-v3" }
    if chip == CHIP_X86_64_GENERIC { << "x86-64-generic" }
    if chip == CHIP_CORTEX_M4 { << "cortex-m4" }
    if chip == CHIP_ESP32_LX6 { << "esp32-lx6" }
    if chip == CHIP_ESP32_C3 { << "esp32-c3" }
    if chip == CHIP_NATIVE { << "native" }
    << "generic"
}
