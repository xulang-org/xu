@xu/pkgmgr
// Package manager, module lookup and dependency resolver.
//
// Layer 5 module: manages package manifests, imports, module roots, and
// dependency graphs independently of compiler emission.

#os

pub struct PackageInfo {
    pub name string
    pub version string
    pub path string
}

pub fn package_info_new(name string, version string, path string) PackageInfo {
    << PackageInfo{
        name: ~name,
        version: ~version,
        path: ~path
    }
}

pub fn resolve_package_files(pkg_name &string, root &string, out_files $&[]string) bool {
    p := ~pkg_name
    r := ~root

    if p == "xu/span" {
        out_files.push(r + "/xu/span/span.xu")
        << true
    }
    if p == "xu/token" {
        out_files.push(r + "/xu/token/token.xu")
        << true
    }
    if p == "xu/ast" {
        out_files.push(r + "/xu/ast/ast.xu")
        out_files.push(r + "/xu/ast/kind.xu")
        out_files.push(r + "/xu/ast/make.xu")
        out_files.push(r + "/xu/ast/print.xu")
        out_files.push(r + "/xu/ast/walk.xu")
        << true
    }
    if p == "xu/lexer" {
        out_files.push(r + "/xu/lexer/lexer.xu")
        << true
    }
    if p == "xu/scanner" {
        out_files.push(r + "/xu/scanner/scanner.xu")
