        out_files.push(r + "/xu/target/host_arch_thumb.xu")
        out_files.push(r + "/xu/target/host_arch_x64.xu")
        out_files.push(r + "/xu/target/target.xu")
        out_files.push(r + "/xu/target/x64.xu")
        << true
