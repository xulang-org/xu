        out_files.push(r + "/xu/mir/opt_cfg.xu")
        out_files.push(r + "/xu/mir/opt_const.xu")
        out_files.push(r + "/xu/mir/opt_cse.xu")
        out_files.push(r + "/xu/mir/opt_dce.xu")
        out_files.push(r + "/xu/mir/opt_fuse.xu")
        out_files.push(r + "/xu/mir/opt_inline.xu")
        out_files.push(r + "/xu/mir/opt_licm.xu")
        out_files.push(r + "/xu/mir/opt_select.xu")
        out_files.push(r + "/xu/mir/opt_sroa.xu")
        out_files.push(r + "/xu/mir/opt_tile.xu")
