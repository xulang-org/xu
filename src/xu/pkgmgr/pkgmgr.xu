@xu/pkgmgr
// Package manager, module lookup and dependency resolver.
//
// Layer 5 module: manages package manifests, imports, module roots, and
// dependency graphs independently of compiler emission.

#os

pub struct PackageInfo {
    pub name string
    pub version string
    pub path string
}

pub fn package_info_new(name string, version string, path string) PackageInfo {
    << PackageInfo{
        name: ~name,
        version: ~version,
        path: ~path
    }
}

pub fn resolve_package_files(pkg_name &string, root &string, out_files $&[]string) bool {
    dir := root + "/" + pkg_name
    << collect_sources(&dir, out_files)
}

fn bytes_less(a &string, b &string) bool {
    $i := 0
    while i < a.len && i < b.len {
        if a[i] != b[i] {
            << a[i] < b[i]
        }
        i += 1
    }
    << a.len < b.len
}

fn ends_with(s &string, suffix string) bool {
    if s.len < suffix.len {
        << false
    }
    << s[s.len - suffix.len:s.len] == suffix
}

fn is_source_name(name &string) bool {
    << name.len > 3 && name[0] != 46 && ends_with(name, ".xu") &&
        !ends_with(name, "_test.xu") && !(name.len > 5 && name[0:5] == "test.")
}

// List production sources in byte order for both imports and CLI directories.
pub fn collect_sources(dir &string, out_files $&[]string) bool {
    listing := os.read_dir(dir + "") or (err) {
        << false
    }
    $names := []string{}
    $start := 0
    $i := 0
    while i <= listing.len {
        if i == listing.len || listing[i] == 10 {
            if i > start {
                nm := listing[start:i]
                if is_source_name(&nm) && !os.is_dir(dir + "/" + nm) {
                    $j := names.len
                    names.push(nm + "")
                    while j > 0 {
                        prev := j - 1
                        if !bytes_less(&names[j], &names[prev]) {
                            <-
                        }
                        tmp := names[j - 1] + ""
                        names[j - 1] = names[j] + ""
                        names[j] = tmp
                        j -= 1
                    }
                }
            }
            start = i + 1
        }
        i += 1
    }
    if names.len == 0 {
        << false
    }
    for k in 0:names.len {
        out_files.push(dir + "/" + names[k])
    }
    << true
}
