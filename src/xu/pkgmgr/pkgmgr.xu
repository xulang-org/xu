    if p == "xu/target/chips/generic" {
        out_files.push(r + "/xu/target/chips/generic/generic.xu")
        << true
    }
    if p == "xu/target/chips/apple_m1" {
        out_files.push(r + "/xu/target/chips/apple_m1/apple_m1.xu")
        << true
    }
    if p == "xu/target/chips/arm_a53" {
        out_files.push(r + "/xu/target/chips/arm_a53/arm_a53.xu")
        << true
    }
    if p == "xu/target/chips/arm_a76" {
        out_files.push(r + "/xu/target/chips/arm_a76/arm_a76.xu")
        << true
    }
    if p == "xu/target/chips/cortex_m4" {
        out_files.push(r + "/xu/target/chips/cortex_m4/cortex_m4.xu")
        << true
    }
    if p == "xu/target/chips/x86_64_v3" {
        out_files.push(r + "/xu/target/chips/x86_64_v3/x86_64_v3.xu")
        << true
    }
    if p == "xu/target/chips/esp32_c3" {
        out_files.push(r + "/xu/target/chips/esp32_c3/esp32_c3.xu")
        << true
    }
    if p == "xu/target/chips/esp32_lx6" {
        out_files.push(r + "/xu/target/chips/esp32_lx6/esp32_lx6.xu")
        << true
