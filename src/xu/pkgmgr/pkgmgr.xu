@xu/pkgmgr
// Package manager, module lookup and dependency resolver.
//
// Layer 5 module: manages package manifests, imports, module roots, and
// dependency graphs independently of compiler emission.

pub struct PackageInfo {
    pub name string
    pub version string
    pub path string
}

pub fn package_info_new(name string, version string, path string) PackageInfo {
    << PackageInfo{
        name: ~name,
        version: ~version,
        path: ~path
    }
}

pub fn resolve_package_files(pkg_name &string, root &string, out_files $&[]string) bool {
    p := ~pkg_name
    r := ~root

    if p == "xu/span" {
        out_files.push(r + "/xu/span/span.xu")
        << true
    }
    if p == "xu/token" {
        out_files.push(r + "/xu/token/token.xu")
        << true
    }
    if p == "xu/ast" {
        out_files.push(r + "/xu/ast/ast.xu")
        out_files.push(r + "/xu/ast/kind.xu")
        out_files.push(r + "/xu/ast/make.xu")
        out_files.push(r + "/xu/ast/print.xu")
        out_files.push(r + "/xu/ast/walk.xu")
        << true
    }
    if p == "xu/lexer" {
        out_files.push(r + "/xu/lexer/lexer.xu")
        << true
    }
    if p == "xu/scanner" {
        out_files.push(r + "/xu/scanner/scanner.xu")
        << true
    }
    if p == "xu/parser" {
        out_files.push(r + "/xu/parser/declarations.xu")
        out_files.push(r + "/xu/parser/expressions.xu")
        out_files.push(r + "/xu/parser/parser.xu")
        out_files.push(r + "/xu/parser/statements.xu")
        << true
    }
    if p == "xu/printer" {
        out_files.push(r + "/xu/printer/printer.xu")
        << true
    }
    if p == "xu/format" {
        out_files.push(r + "/xu/format/format.xu")
        << true
    }
    if p == "xu/types" {
        out_files.push(r + "/xu/types/any_constants.xu")
        out_files.push(r + "/xu/types/check.xu")
        out_files.push(r + "/xu/types/check_00_names.xu")
        out_files.push(r + "/xu/types/check_01_diag.xu")
        out_files.push(r + "/xu/types/check_02_schema_types.xu")
        out_files.push(r + "/xu/types/check_03_scope_move.xu")
        out_files.push(r + "/xu/types/check_04_intern.xu")
        out_files.push(r + "/xu/types/check_05_module_generic.xu")
        out_files.push(r + "/xu/types/check_06_throw.xu")
        out_files.push(r + "/xu/types/check_07_module_generic_instances.xu")
        out_files.push(r + "/xu/types/check_08_register_layout.xu")
        out_files.push(r + "/xu/types/check_09_register_generic.xu")
        out_files.push(r + "/xu/types/check_10_borrow.xu")
        out_files.push(r + "/xu/types/check_11_stmt.xu")
        out_files.push(r + "/xu/types/check_12_call.xu")
        out_files.push(r + "/xu/types/check_13_call_method.xu")
        out_files.push(r + "/xu/types/check_14_expr.xu")
        out_files.push(r + "/xu/types/check_15_expr_closure.xu")
        out_files.push(r + "/xu/types/check_16_risks.xu")
        out_files.push(r + "/xu/types/check_18_runtime_abi.xu")
        out_files.push(r + "/xu/types/check_19_stream_generics.xu")
        out_files.push(r + "/xu/types/check_20_resources.xu")
        out_files.push(r + "/xu/types/layout.xu")
        out_files.push(r + "/xu/types/map.xu")
        out_files.push(r + "/xu/types/run_pat.xu")
        out_files.push(r + "/xu/types/runtime_abi_generated.xu")
        out_files.push(r + "/xu/types/type_encoding.xu")
        << true
    }
    if p == "xu/mir" {
        out_files.push(r + "/xu/mir/lower.xu")
        out_files.push(r + "/xu/mir/mir.xu")
        out_files.push(r + "/xu/mir/opt_cfg.xu")
        out_files.push(r + "/xu/mir/opt_const.xu")
        out_files.push(r + "/xu/mir/opt_cse.xu")
        out_files.push(r + "/xu/mir/opt_dce.xu")
        out_files.push(r + "/xu/mir/opt_fuse.xu")
        out_files.push(r + "/xu/mir/opt_inline.xu")
        out_files.push(r + "/xu/mir/opt_licm.xu")
        out_files.push(r + "/xu/mir/opt_select.xu")
        out_files.push(r + "/xu/mir/opt_sroa.xu")
        out_files.push(r + "/xu/mir/opt_tile.xu")
        out_files.push(r + "/xu/mir/opt_tre.xu")
        << true
    }
    if p == "xu/mc" {
        out_files.push(r + "/xu/mc/code_buffer.xu")
        out_files.push(r + "/xu/mc/reloc.xu")
        out_files.push(r + "/xu/mc/symbol.xu")
        << true
    }
    if p == "xu/target" {
        out_files.push(r + "/xu/target/arm64.xu")
        out_files.push(r + "/xu/target/host_arch_arm64.xu")
        out_files.push(r + "/xu/target/host_arch_loong64.xu")
        out_files.push(r + "/xu/target/host_arch_riscv32.xu")
        out_files.push(r + "/xu/target/host_arch_riscv64.xu")
        out_files.push(r + "/xu/target/host_arch_thumb.xu")
        out_files.push(r + "/xu/target/host_arch_x64.xu")
        out_files.push(r + "/xu/target/target.xu")
        out_files.push(r + "/xu/target/x64.xu")
        << true
    }
    if p == "xu/codegen" {
        out_files.push(r + "/xu/codegen/frame.xu")
        out_files.push(r + "/xu/codegen/isel.xu")
        out_files.push(r + "/xu/codegen/regalloc.xu")
        out_files.push(r + "/xu/codegen/tile_arm64.xu")
        << true
    }
    if p == "xu/obj" {
        out_files.push(r + "/xu/obj/elf.xu")
        out_files.push(r + "/xu/obj/elf32.xu")
        out_files.push(r + "/xu/obj/macho.xu")
        out_files.push(r + "/xu/obj/obj.xu")
        out_files.push(r + "/xu/obj/pe.xu")
        out_files.push(r + "/xu/obj/wasm.xu")
        << true
    }
    if p == "xu/rtgen" {
        out_files.push(r + "/xu/rtgen/rtgen.xu")
        << true
    }
    if p == "xu/pkgmgr" {
        out_files.push(r + "/xu/pkgmgr/pkgmgr.xu")
        << true
    }
    if p == "xu/driver" {
        out_files.push(r + "/xu/driver/driver.xu")
        << true
    }
    if p == "xu/target/chips/model" {
        out_files.push(r + "/xu/target/chips/model/model.xu")
        << true
    }
    if p == "xu/target/chips/generic" {
        out_files.push(r + "/xu/target/chips/generic/generic.xu")
        << true
    }
    if p == "xu/target/chips/apple_m1" {
        out_files.push(r + "/xu/target/chips/apple_m1/apple_m1.xu")
        << true
    }
    if p == "xu/target/chips/arm_a53" {
        out_files.push(r + "/xu/target/chips/arm_a53/arm_a53.xu")
        << true
    }
    if p == "xu/target/chips/arm_a76" {
        out_files.push(r + "/xu/target/chips/arm_a76/arm_a76.xu")
        << true
    }
    if p == "xu/target/chips/cortex_m4" {
        out_files.push(r + "/xu/target/chips/cortex_m4/cortex_m4.xu")
        << true
    }
    if p == "xu/target/chips/x86_64_v3" {
        out_files.push(r + "/xu/target/chips/x86_64_v3/x86_64_v3.xu")
        << true
    }
    if p == "xu/target/chips/esp32_c3" {
        out_files.push(r + "/xu/target/chips/esp32_c3/esp32_c3.xu")
        << true
    }
    if p == "xu/target/chips/esp32_lx6" {
        out_files.push(r + "/xu/target/chips/esp32_lx6/esp32_lx6.xu")
        << true
    }
    if p == "internal/modulepath" {
        out_files.push(r + "/internal/modulepath/mod.xu")
        << true
    }

    << false
}
