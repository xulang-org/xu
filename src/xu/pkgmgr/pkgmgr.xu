    if p == "internal/modulepath" {
        out_files.push(r + "/internal/modulepath/mod.xu")
        << true
    }

    << resolve_package_dir(&p, &r, out_files)
}

fn bytes_less(a &string, b &string) bool {
    $i := 0
    while i < a.len && i < b.len {
        if a[i] != b[i] {
            << a[i] < b[i]
        }
        i += 1
    }
    << a.len < b.len
}

fn ends_with(s &string, suffix string) bool {
    if s.len < suffix.len {
        << false
    }
    << s[s.len - suffix.len:s.len] == suffix
}

// Package files are every non-test `.xu` directly under <root>/<pkg>, in byte
// order so declaration order is identical on every host.
fn resolve_package_dir(pkg &string, root &string, out_files $&[]string) bool {
    dir := root + "/" + pkg
    listing := os.read_dir(dir + "") or (err) {
        << false
    }
    $names := []string{}
    $start := 0
    $i := 0
    while i <= listing.len {
        if i == listing.len || listing[i] == 10 {
            if i > start {
                nm := listing[start:i]
                if ends_with(&nm, ".xu") && !ends_with(&nm, "_test.xu") {
                    $j := names.len
                    names.push(nm + "")
                    while j > 0 {
                        prev := j - 1
                        if !bytes_less(&names[j], &names[prev]) {
                            <-
                        }
                        tmp := names[j - 1] + ""
                        names[j - 1] = names[j] + ""
                        names[j] = tmp
                        j -= 1
                    }
                }
            }
            start = i + 1
        }
        i += 1
    }
    if names.len == 0 {
        << false
    }
    for k in 0:names.len {
        out_files.push(dir + "/" + names[k])
    }
    << true
}
