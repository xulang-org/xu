@xu/typeenv

#xu/ast
#xu/ds
#xu/parser
#xu/types

// Shared type tables, per-node/per-local resolution state, FFI metadata,
// target configuration, and diagnostics shared across @xu/checker, @xu/borrow,
// @xu/ffi, and @xu/cbind.
pub struct TypeEnv {
pub:
    fns           []CFn
    strings       []string
    ntype         []int
    nlocal        []int
    ncall         []int
    nstr          []int
    ncsite        []int
    nconst        []int
    nclone        []int
    nshared       []int
    nbox          []int
    fnlocals      [][]int
    fnlocal_names [][]string
    fnlconst      [][]int
    fnlconst_ok   [][]int
    fnllength     [][]int
    fnllength_ok  [][]int
    structs       []CStruct
    arrays        []CArray
    throws        []CThrow
    enums         []CEnum
    chans         []CChan
    maps          []CMap
    fn_sigs       []CFnSig
    cnames        []string
    ctypes        []int
    civals        []int
    cstr_idx      []int
    cmods         []string
    cpubs         []int
    globals       []CGlobal
    global_map    ds.StrMap
    st_map        ds.StrMap
    ref_targets   []int
    ref_map       ds.StrMap
    iface_names   []string
    iface_mods    []string
    im_ii         []int
    im_name       []string
    im_ret        []int
    im_poff       []int
    im_plen       []int
    im_ptys       []int
    sargs         [][]int
    sdecl         []int
    slaid         []int
    sdoing        []int
    fndecl        []int
    fn_file       []int
    is_inst       []int
    inst_keys     []string
    dfile_of      []int
    dfile_ndecls  int
    span_mark     []int
    span_stamp    int
    lname         []string
    ltype         []int
    lmut          []int
    lactive       []int
    lview         []int
    laref         []int
    clos_caps     [][]int
    bound_mfi     []int
    fn_may_throw  []int
    fn_throw_ty   []int
    fn_safe_name  []string
    fn_safe_mod   []string
    errors_iface  int
    cur_throw_ty  int
    in_or_catch   int
    or_assign     string
    target_os     int
    target_arch   int
    freestanding  int
    test_mode     int
    opt_level     int
    test_failfast int
    test_count    int
    test_list     int
    lib_mode      int
    lib_ext_labs  []string
    ffi_labels    []string
    ffi_flags     []int
    ffi_decls     []int
    repr_c_structs []int
    unsafe_depth  int
    allow_mmio    int
    mmio_lo       int
    mmio_hi       int
    in_irq        int
    cur_fn        int
    cur_ret       int
    cur_ret_life  string
    cur_mod       string
    cur_file      int
    cur_file_name string
    attr          int
    warn_file     []int
    warn_line     []int
    warn_col      []int
    warn_msg      []string
    error_count   int
    fn_err_base   int
}

pub fn (c $&TypeEnv) seed_env() {
    ds.zero_strmap($&c.global_map)
    ds.zero_strmap($&c.st_map)
    ds.zero_strmap($&c.ref_map)
    c.fns = []CFn{}
    c.strings = []string{}
    c.ntype = []int{}
    c.nlocal = []int{}
    c.ncall = []int{}
    c.nstr = []int{}
    c.ncsite = []int{}
    c.nconst = []int{}
    c.nclone = []int{}
    c.nshared = []int{}
    c.nbox = []int{}
    c.fnlocals = [][]int{}
    c.fnlocal_names = [][]string{}
    c.fnlconst = [][]int{}
    c.fnlconst_ok = [][]int{}
    c.fnllength = [][]int{}
    c.fnllength_ok = [][]int{}
    c.structs = []CStruct{}
    c.arrays = []CArray{}
    c.throws = []CThrow{}
    c.enums = []CEnum{}
    c.chans = []CChan{}
    c.maps = []CMap{}
    c.fn_sigs = []CFnSig{}
    c.cnames = []string{}
    c.ctypes = []int{}
    c.civals = []int{}
    c.cstr_idx = []int{}
    c.cmods = []string{}
    c.cpubs = []int{}
    c.globals = []CGlobal{}
    c.ref_targets = []int{}
    c.iface_names = []string{}
    c.iface_mods = []string{}
    c.im_ii = []int{}
    c.im_name = []string{}
    c.im_ret = []int{}
    c.im_poff = []int{}
    c.im_plen = []int{}
    c.im_ptys = []int{}
    c.sargs = [][]int{}
    c.sdecl = []int{}
    c.slaid = []int{}
    c.sdoing = []int{}
    c.fndecl = []int{}
    c.fn_file = []int{}
    c.is_inst = []int{}
    c.inst_keys = []string{}
    c.dfile_of = []int{}
    c.span_mark = []int{}
    c.lname = []string{}
    c.ltype = []int{}
    c.lmut = []int{}
    c.lactive = []int{}
    c.lview = []int{}
    c.laref = []int{}
    c.clos_caps = [][]int{}
    c.bound_mfi = []int{}
    c.fn_may_throw = []int{}
    c.fn_throw_ty = []int{}
    c.fn_safe_name = []string{}
    c.fn_safe_mod = []string{}
    c.lib_ext_labs = []string{}
    c.ffi_labels = []string{}
    c.ffi_flags = []int{}
    c.ffi_decls = []int{}
    c.repr_c_structs = []int{}
    c.unsafe_depth = 0
    c.warn_file = []int{}
    c.warn_line = []int{}
    c.warn_col = []int{}
    c.warn_msg = []string{}
}

pub fn (c $&TypeEnv) prep_nodes(nnodes int) {
    for i in 0:nnodes {
        c.ntype.push(0)
        c.nlocal.push(-1)
        c.ncall.push(-1)
        c.nstr.push(-1)
        c.ncsite.push(0)
        c.nconst.push(-1)
        c.nclone.push(0)
        c.nshared.push(0)
        c.nbox.push(0)
    }
}

pub fn (c $&TypeEnv) release_env() {
    c.ntype = []int{}
    c.nlocal = []int{}
    c.ncall = []int{}
    c.nstr = []int{}
    c.ncsite = []int{}
    c.nconst = []int{}
    c.nclone = []int{}
    c.nshared = []int{}
    c.nbox = []int{}
    c.fnlocals = [][]int{}
    c.fnlocal_names = [][]string{}
    c.fnlconst = [][]int{}
    c.fnlconst_ok = [][]int{}
    c.fnllength = [][]int{}
    c.fnllength_ok = [][]int{}
    c.fndecl = []int{}
    c.bound_mfi = []int{}
    c.is_inst = []int{}
    c.fns = []CFn{}
    c.strings = []string{}
    c.cnames = []string{}
    c.ctypes = []int{}
    c.civals = []int{}
    c.cstr_idx = []int{}
    c.cmods = []string{}
    c.cpubs = []int{}
    c.globals = []CGlobal{}
    c.fn_file = []int{}
    c.structs = []CStruct{}
    c.arrays = []CArray{}
    c.throws = []CThrow{}
    c.enums = []CEnum{}
    c.chans = []CChan{}
    c.maps = []CMap{}
    c.fn_sigs = []CFnSig{}
}

pub fn (c $&TypeEnv) fail_at(line int, col int, msg string) {
    $prefix := ""
    if c.cur_file_name.len > 0 {
        prefix = c.cur_file_name + ":"
    }
    eprintln(prefix + str(line) + ":" + str(col) + ": error: " + msg)
    c.error_count += 1
    <<< 1
}

pub fn (c &TypeEnv) fn_failed() bool {
    << c.error_count > c.fn_err_base
}

pub fn (c $&TypeEnv) set_cur_file(p &parser.Parser, fid int) {
    c.cur_file = fid
    if fid >= 0 && fid < p.file_names.len {
        c.cur_file_name = ~p.file_names[fid]
    }
}

pub fn (c $&TypeEnv) fail_node(p &parser.Parser, n int, msg string) {
    $at := n
    if c.attr >= 0 {
        at = c.attr
    }
    if at < 0 || at >= p.nodes.len {
        c.fail_at(0, 0, msg)
        <<
    }
    c.fail_at(p.nodes[at].line, p.nodes[at].col, msg)
}

pub fn (c $&TypeEnv) fail_expr(p &parser.Parser, n int, msg string) int {
    c.fail_node(p, n, msg)
    if n >= 0 && n < c.ntype.len {
        checker_set_i($&c.ntype, n, types.ERROR_TY)
    }
    << types.ERROR_TY
}

pub fn (c $&TypeEnv) decl_file_id(p &parser.Parser, d int) int {
    if c.dfile_ndecls != p.decls.len || c.dfile_of.len != p.nodes.len {
        $tab := []int{}
        for i in 0:p.nodes.len {
            tab.push(0)
        }
        $i := p.decls.len - 1
        while i >= 0 {
            x := p.decls[i]
            if x >= 0 && x < tab.len {
                tab[x] = p.decl_file[i]
            }
            i -= 1
        }
        c.dfile_of = tab
        c.dfile_ndecls = p.decls.len
    }
    if d < 0 || d >= c.dfile_of.len { << 0 }
    << c.dfile_of[d]
}

pub fn (c &TypeEnv) find_struct_in_mod(name string, mod string) int {
    k := map_key(mod, name)
    << ds.strmap_get(&c.st_map, &k)
}

pub fn (c &TypeEnv) find_global_in_mod(name string, mod string) int {
    k := map_key(mod, name)
    << ds.strmap_get(&c.global_map, &k)
}

pub fn (c &TypeEnv) find_field(si int, name string) int {
    for i in 0:c.structs[si].fields.len {
        if c.structs[si].fields[i].name == name {
            << i
        }
    }
    << -1
}

pub fn (c &TypeEnv) ref_inner_type(t int) int {
    << types.ref_inner_type_at(&c.ref_targets, t)
}

pub fn (c $&TypeEnv) make_ref_type(mutable bool, inner int) int {
    if types.is_indirect_ref_type(inner) || types.type_kind(inner) < 0 { << -1 }
    key := str(inner)
    hit := ds.strmap_get(&c.ref_map, &key)
    if hit >= 0 { << types.reference_type(mutable, types.is_ref_type(inner), hit) }
    index := c.ref_targets.len
    if index >= types.TYPE_TABLE_LIMIT { << -1 }
    c.ref_targets.push(inner)
    ds.strmap_put($&c.ref_map, key, index)
    << types.reference_type(mutable, types.is_ref_type(inner), index)
}

pub fn (c &TypeEnv) direct_type(t int) int {
    if types.is_ref_type(t) { << c.ref_inner_type(t) }
    << t
}

pub fn (c &TypeEnv) array_fixed_len(t int) int {
    if !types.is_array_type(t) { << 0 }
    ai := types.array_index(t)
    if ai < 0 || ai >= c.arrays.len { << 0 }
    << c.arrays[ai].fixed_len
}

pub fn (c &TypeEnv) is_fixed_array(t int) bool {
    << c.array_fixed_len(t) > 0
}

pub fn (c $&TypeEnv) array_fixed_len_m(t int) int {
    if !types.is_array_type(t) { << 0 }
    ai := types.array_index(t)
    if ai < 0 || ai >= c.arrays.len { << 0 }
    << c.arrays[ai].fixed_len
}

pub fn (c $&TypeEnv) is_fixed_array_m(t int) bool {
    << c.array_fixed_len_m(t) > 0
}

pub fn (c $&TypeEnv) direct_type_m(t int) int {
    << types.ref_inner_type_at(&c.ref_targets, t)
}

pub fn (c &TypeEnv) ty_display(ty int) string {
    if ty == 1 { << "int" }
    if ty == 2 { << "bool" }
    if ty == 3 { << "string" }
    if ty == 4 { << "f64" }
    if ty == 8 { << "i32" }
    if ty == 9 { << "u32" }
    if ty == 10 { << "u8" }
    if ty == 6 { << "c_ptr" }
    if ty == 7 { << "i8" }
    if ty == 11 { << "i16" }
    if ty == 12 { << "u16" }
    if ty == 13 { << "u64" }
    if ty == 14 { << "f32" }
    if types.is_param_type(ty) { << "T" + str(types.param_index(ty)) }
    if types.is_struct_type(ty) {
        if c.structs[types.struct_index(ty)].mod_id == "maps" {
            if c.structs[types.struct_index(ty)].name == "StrInt" {
                << "map[string]int"
            }
            if c.structs[types.struct_index(ty)].name == "StrStr" {
                << "map[string]string"
            }
        }
        << c.structs[types.struct_index(ty)].name
    }
    if types.is_map_type(ty) {
        mi := types.map_index(ty)
        << "map[" + c.ty_display(c.maps[mi].key_ty) + "]" + c.ty_display(c.maps[mi].val_ty)
    }
    if types.is_array_type(ty) {
        << "[]" + c.ty_display(c.arrays[types.array_index(ty)].elem_ty)
    }
    if types.is_throw_type(ty) {
        ri := types.throw_index(ty)
        << "throw<" + c.ty_display(c.throws[ri].ok_ty) + ", " + c.ty_display(c.throws[ri].err_ty) + ">"
    }
    if types.is_enum_type(ty) {
        << c.enums[types.enum_index(ty)].name
    }
    if types.is_fn_type(ty) {
        si := types.fn_index(ty)
        if si >= 0 && si < c.fn_sigs.len {
            $s := "fn("
            for i in 0:c.fn_sigs[si].params.len {
                if i > 0 { s = s + ", " }
                s = s + c.ty_display(c.fn_sigs[si].params[i])
            }
            s = s + ")"
            if c.fn_sigs[si].ret != 0 {
                s = s + " " + c.ty_display(c.fn_sigs[si].ret)
            }
            << s
        }
        << "fn"
    }
    if types.is_interface_type(ty) {
        ii := types.interface_index(ty)
        if ii >= 0 && ii < c.iface_names.len {
            if c.iface_mods[ii] != c.cur_mod {
                << c.iface_mods[ii] + "." + c.iface_names[ii]
            }
            << c.iface_names[ii]
        }
        << "interface"
    }
    if types.is_chan_type(ty) {
        << "chan " + c.ty_display(c.chans[types.chan_index(ty)].elem_ty)
    }
    << types.type_name(ty)
}

pub fn (c &TypeEnv) diag_type_display(ty int) string {
    if types.is_ref_type(ty) {
        if types.is_mut_ref_type(ty) { << "\$&" + c.diag_type_display(c.ref_inner_type(ty)) }
        << "&" + c.diag_type_display(c.ref_inner_type(ty))
    }
    << c.ty_display(ty)
}

pub fn (c &TypeEnv) type_slots(ty int) int {
    if ty == 3 { << 3 }
    if types.is_ref_type(ty) { << 1 }
    if types.is_param_type(ty) { << 1 }
    if types.is_throw_type(ty) {
        ri := types.throw_index(ty)
        if ri >= 0 && ri < c.throws.len {
            ok_s := c.type_slots(c.throws[ri].ok_ty)
            er_s := c.type_slots(c.throws[ri].err_ty)
            $payload := er_s
            if ok_s > payload { payload = ok_s }
            if payload <= 0 || payload >= types.MIR_MAX_LAYOUT_WORDS { << 0 }
            << 1 + payload
        }
        << 1
    }
    if types.is_enum_type(ty) {
        ei := types.enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            ns := c.enums[ei].nslots
            if ns <= 0 || ns > types.MIR_MAX_LAYOUT_WORDS { << 0 }
            << ns
        }
        << 1
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if ai < 0 || ai >= c.arrays.len { << 0 }
        fl := c.array_fixed_len(ty)
        if fl < 0 { << 0 }
        if fl > 0 {
            es := c.type_slots(c.arrays[ai].elem_ty)
            if es <= 0 || es > types.MIR_MAX_LAYOUT_WORDS || fl > types.MIR_MAX_LAYOUT_WORDS { << 0 }
            if fl * es > types.MIR_MAX_LAYOUT_WORDS { << 0 }
            << fl * es
        }
        << 3
    }
    if types.is_chan_type(ty) { << 1 }
    if types.is_map_type(ty) { << 1 }
    if types.is_fn_type(ty) { << 2 }
    if types.is_temp_type(ty) { << 2 }
    if types.is_any_type(ty) { << 2 }
    if types.is_interface_type(ty) { << 2 }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < c.structs.len {
            ns := c.structs[si].nslots
            if ns < 0 || ns > types.MIR_MAX_LAYOUT_WORDS { << 0 }
            << ns
        }
    }
    << 1
}

pub fn (c &TypeEnv) type_size_bytes(ty int) int {
    if ty == 10 { << 1 }
    if ty == 8 || ty == 9 { << 4 }
    if ty == 7 { << 1 }
    if ty == 11 || ty == 12 { << 2 }
    if ty == 14 { << 4 }
    if ty == 0 { << 0 }
    if ty == 3 { << 24 }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if ai < 0 || ai >= c.arrays.len { << 0 }
        fl := c.array_fixed_len(ty)
        if fl < 0 { << 0 }
        if fl > 0 {
            eb := c.arrays[ai].elem_bytes
            if eb <= 0 || eb > types.MIR_MAX_LAYOUT_BYTES || fl > types.MIR_MAX_LAYOUT_BYTES { << 0 }
            if fl * eb > types.MIR_MAX_LAYOUT_BYTES { << 0 }
            << fl * eb
        }
        << 24
    }
    if types.is_fn_type(ty) { << 16 }
    if types.is_temp_type(ty) { << 16 }
    if types.is_any_type(ty) { << 16 }
    if types.is_interface_type(ty) { << 16 }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < c.structs.len {
            bytes := c.structs[si].size_bytes
            if bytes < 0 || bytes > types.MIR_MAX_LAYOUT_BYTES { << 0 }
            << bytes
        }
    }
    if types.is_throw_type(ty) {
        ns := c.type_slots(ty)
        if ns <= 0 || ns > types.MIR_MAX_LAYOUT_BYTES / 8 { << 0 }
        << ns * 8
    }
    if types.is_enum_type(ty) {
        ns := c.type_slots(ty)
        if ns <= 0 || ns > types.MIR_MAX_LAYOUT_BYTES / 8 { << 0 }
        << ns * 8
    }
    << 8
}

pub fn (c &TypeEnv) type_align_bytes(ty int) int {
    if ty == 10 || ty == 7 { << 1 }
    if ty == 11 || ty == 12 { << 2 }
    if ty == 8 || ty == 9 || ty == 14 { << 4 }
    if ty == 0 { << 1 }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < c.structs.len {
            al := c.structs[si].align_bytes
            if al < 1 { << 1 }
            << al
        }
    }
    << 8
}

pub fn (c &TypeEnv) type_owning(ty int) bool {
    if ty == 3 { << true }
    if types.is_ref_type(ty) { << false }
    if types.is_temp_type(ty) { << true }
    if types.is_any_type(ty) { << true }
    if types.is_interface_type(ty) { << true }
    if types.is_fn_type(ty) {
        si := types.fn_index(ty)
        if si >= 0 && si < c.fn_sigs.len {
            << c.fn_sigs[si].has_env == 1
        }
        << false
    }
    if types.is_param_type(ty) { << false }
    if types.is_throw_type(ty) {
        ri := types.throw_index(ty)
        if ri >= 0 && ri < c.throws.len {
            << c.type_owning(c.throws[ri].ok_ty) || c.type_owning(c.throws[ri].err_ty)
        }
        << false
    }
    if types.is_enum_type(ty) {
        ei := types.enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            << c.enums[ei].owns
        }
        << false
    }
    if types.is_array_type(ty) {
        fl := c.array_fixed_len(ty)
        if fl > 0 {
            ai := types.array_index(ty)
            << c.type_owning(c.arrays[ai].elem_ty)
        }
        << true
    }
    if types.is_map_type(ty) { << true }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < c.structs.len {
            if c.structs[si].drop_label.len > 0 { << true }
            for i in 0:c.structs[si].fields.len {
                if c.type_owning(c.structs[si].fields[i].ty) { << true }
            }
        }
    }
    << false
}

pub fn (c &TypeEnv) type_contains_mut_ref(ty int) bool {
    if types.is_mut_ref_type(ty) { << true }
    if ty == 0 || ty == 5 || types.is_integer_type(ty) || ty == 2 || ty == 3 || ty == 4 || ty == 6 || ty == 14 { << false }
    $seen := []int{}
    << c.type_mut_ref_walk(ty, $&seen)
}

pub fn (c &TypeEnv) type_mut_ref_walk(ty int, seen $&[]int) bool {
    if types.is_mut_ref_type(ty) { << true }
    if types.is_ref_type(ty) { << false }
    for i in 0:seen.len { if seen[i] == ty { << false } }
    seen.push(ty)
    if types.is_fn_type(ty) {
        si := types.fn_index(ty)
        if si >= 0 && si < c.fn_sigs.len && c.fn_sigs[si].has_env == 1 {
            esi := c.fn_sigs[si].env_struct
            if esi >= 0 { << c.type_mut_ref_walk(types.struct_type(esi), seen) }
        }
        << false
    }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < c.structs.len {
            for i in 0:c.structs[si].fields.len {
                if c.type_mut_ref_walk(c.structs[si].fields[i].ty, seen) { << true }
            }
        }
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if ai >= 0 && ai < c.arrays.len {
            << c.type_mut_ref_walk(c.arrays[ai].elem_ty, seen)
        }
    }
    if types.is_throw_type(ty) {
        ri := types.throw_index(ty)
        if ri >= 0 && ri < c.throws.len {
            << c.type_mut_ref_walk(c.throws[ri].ok_ty, seen) || c.type_mut_ref_walk(c.throws[ri].err_ty, seen)
        }
    }
    if types.is_enum_type(ty) {
        ei := types.enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            for vi in 0:c.enums[ei].variants.len {
                for fi in 0:c.enums[ei].variants[vi].fields.len {
                    if c.type_mut_ref_walk(c.enums[ei].variants[vi].fields[fi], seen) { << true }
                }
            }
        }
    }
    if types.is_chan_type(ty) {
        ci := types.chan_index(ty)
        if ci >= 0 && ci < c.chans.len { << c.type_mut_ref_walk(c.chans[ci].elem_ty, seen) }
    }
    if types.is_map_type(ty) {
        mi := types.map_index(ty)
        if mi >= 0 && mi < c.maps.len {
            << c.type_mut_ref_walk(c.maps[mi].key_ty, seen) || c.type_mut_ref_walk(c.maps[mi].val_ty, seen)
        }
    }
    << false
}

pub fn (c &TypeEnv) type_contains_ref(ty int) bool {
    if types.is_ref_type(ty) { << true }
    if ty == 0 || ty == 5 || types.is_integer_type(ty) || ty == 2 || ty == 3 || ty == 4 || ty == 6 || ty == 14 { << false }
    $seen := []int{}
    << c.type_ref_walk(ty, $&seen)
}

pub fn (c &TypeEnv) type_ref_walk(ty int, seen $&[]int) bool {
    << c.type_ref_walk_mode(ty, false, seen)
}

pub fn (c &TypeEnv) type_ref_walk_mode(ty int, reject_dyn bool, seen $&[]int) bool {
    if types.is_ref_type(ty) { << true }
    if reject_dyn && (types.is_temp_type(ty) || types.is_any_type(ty)) { << true }
    for i in 0:seen.len { if seen[i] == ty { << false } }
    seen.push(ty)
    if types.is_fn_type(ty) {
        si := types.fn_index(ty)
        if si >= 0 && si < c.fn_sigs.len && c.fn_sigs[si].has_env == 1 {
            esi := c.fn_sigs[si].env_struct
            if esi >= 0 {
                << c.type_ref_walk_mode(types.struct_type(esi), reject_dyn, seen)
            }
        }
        << false
    }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if si >= 0 && si < c.structs.len {
            for i in 0:c.structs[si].fields.len {
                if c.type_ref_walk_mode(c.structs[si].fields[i].ty, reject_dyn, seen) { << true }
            }
        }
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if ai >= 0 && ai < c.arrays.len {
            << c.type_ref_walk_mode(c.arrays[ai].elem_ty, reject_dyn, seen)
        }
    }
    if types.is_throw_type(ty) {
        ri := types.throw_index(ty)
        if ri >= 0 && ri < c.throws.len {
            << c.type_ref_walk_mode(c.throws[ri].ok_ty, reject_dyn, seen) || c.type_ref_walk_mode(c.throws[ri].err_ty, reject_dyn, seen)
        }
    }
    if types.is_enum_type(ty) {
        ei := types.enum_index(ty)
        if ei >= 0 && ei < c.enums.len {
            for vi in 0:c.enums[ei].variants.len {
                for fi in 0:c.enums[ei].variants[vi].fields.len {
                    if c.type_ref_walk_mode(c.enums[ei].variants[vi].fields[fi], reject_dyn, seen) { << true }
                }
            }
        }
    }
    if types.is_chan_type(ty) {
        ci := types.chan_index(ty)
        if ci >= 0 && ci < c.chans.len {
            << c.type_ref_walk_mode(c.chans[ci].elem_ty, reject_dyn, seen)
        }
    }
    if types.is_map_type(ty) {
        mi := types.map_index(ty)
        if mi >= 0 && mi < c.maps.len {
            << c.type_ref_walk_mode(c.maps[mi].key_ty, reject_dyn, seen) || c.type_ref_walk_mode(c.maps[mi].val_ty, reject_dyn, seen)
        }
    }
    << false
}

pub fn (c &TypeEnv) type_moves(ty int) bool {
    << c.type_owning(ty) || c.type_contains_mut_ref(ty) || types.is_param_type(ty)
}

pub fn (c &TypeEnv) call_arg_moves(fi int, ai int) bool {
    if fi < 0 { << false }
    if c.fns[fi].variadic {
        fixed := c.fns[fi].params.len - 1
        if ai >= fixed { << true }
        pty := c.fns[fi].params[ai]
        << c.type_owning(pty) || (!types.is_mut_ref_type(pty) && c.type_contains_mut_ref(pty))
    }
    if ai >= c.fns[fi].params.len { << false }
    pty := c.fns[fi].params[ai]
    << c.type_owning(pty) || (!types.is_mut_ref_type(pty) && c.type_contains_mut_ref(pty))
}

pub fn (c &TypeEnv) peel_map(ty int) int {
    $t := c.direct_type(ty)
    if types.is_ref_type(t) {
        t = c.direct_type(t)
    }
    if types.is_map_type(t) {
        << t
    }
    << -1
}

pub fn (c &TypeEnv) ffi_label_flags(label &string) int {
    for i in 0:c.ffi_labels.len {
        if c.ffi_labels[i] == *label { << c.ffi_flags[i] }
    }
    << -1
}

pub fn (c &TypeEnv) fn_is_c_variadic(fi int) bool {
    if fi < 0 || fi >= c.fns.len { << false }
    f := c.ffi_label_flags(&c.fns[fi].label)
    << f >= 0 && (f & types.FFI_EXTERN) != 0 && (f & ast.FFI_VARIADIC) != 0
}

pub fn (c &TypeEnv) struct_is_repr_c(si int) bool {
    for i in 0:c.repr_c_structs.len {
        if c.repr_c_structs[i] == si { << true }
    }
    << false
}

pub fn (c &TypeEnv) node_global(n int) int {
    if n < 0 || n >= c.nconst.len { << -1 }
    v := c.nconst[n]
    if v <= -1000 { << -1000 - v }
    << -1
}
