@xu/typeenv

#internal/modulepath
#xu/ds

pub fn checker_set_i(a $&[]int, i int, v int) {
    if i < 0 {
        <<
    }
    if i > 2000000 {
        eprintln("internal compiler error: checker side-table index limit exceeded")
        <<< 1
    }
    while a.len <= i {
        a.push(0)
    }
    a[i] = v
}

pub struct CFn {
pub:
    name        string
    label       string
    ret         int
    params      []int
    recv        int
    recv_mut    bool
    mod_id      string
    is_pub      bool
    is_extern   bool
    is_template bool
    recv_name   string
    variadic    bool
    lt_params   []string
}

pub struct CField {
pub:
    name      string
    ty        int
    slot      int
    life      string
    is_pub    bool
    bit_off   int
    bit_width int
    bit_unit  int
}

pub struct CGlobal {
pub:
    name   string
    mod_id string
    lib    string
    sym    string
    ty     int
    is_pub bool
    is_mut bool
    decl   int
}

pub struct CStruct {
pub:
    name        string
    fields      []CField
    nslots      int
    size_bytes  int
    align_bytes int
    mod_id      string
    is_pub      bool
    is_union    bool
    origin      string
    drop_label  string
}

pub struct CArray {
pub:
    elem_ty    int
    elem_bytes int
    fixed_len  int
}

pub struct CChan {
pub:
    elem_ty    int
    elem_slots int
}

pub struct CMap {
pub:
    key_ty int
    val_ty int
    kkind  int
    vkind  int
    vslots int
}

pub struct CFnSig {
pub:
    params     []int
    ret        int
    has_env    int
    env_struct int
}

pub struct CThrow {
pub:
    ok_ty  int
    err_ty int
}

pub struct CEnumVariant {
pub:
    name        string
    fields      []int
    field_slots int
}

pub struct CEnum {
pub:
    name     string
    variants []CEnumVariant
    nslots   int
    owns     bool
    mod_id   string
    is_pub   bool
    origin   string
    args     []int
}

pub fn mangle_mod(mod string) string {
    if modulepath.is_external(&mod) { << modulepath.symbol(&mod) }
    $out := ""
    for i in 0:mod.len {
        ch := mod[i]
        if ch == 47 {
            out = out + "_"
        } else {
            out = out + string_from_byte(ch)
        }
    }
    << out
}

pub fn map_key(mod string, name string) string {
    $sb := ds.new_strbuf(mod.len + 1 + name.len)
    sb.write_str(mod)
    sb.write_byte(31)
    sb.write_str(name)
    << sb.finish()
}

pub fn method_key(mod string, sname string, mname string) string {
    << map_key(mod, sname + "." + mname)
}
