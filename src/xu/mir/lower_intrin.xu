@xu/mir
// String, array, assert and atomic builtins backed by runtime/core/intrin.xu.
//
// Arguments follow lower_host: wide values pass their address, scalars
// their (dereferenced) value. Atomic builtins take the address behind
// their `$&int` operand; tasks share one thread, so they are plain
// loads and stores.
//
// Fixed-size arrays ([N]T) hold their N elements inline, elem_bytes apart;
// a fixed-array value or place is the address of its first element.

#xu/ast
#xu/parser
#xu/types

// Name of the runtime entry for a builtin with a wide result, or "".
fn intrin_wide_name(code int) string {
    if code == -141 { << "intrin_make_string" }
    if code == -140 { << "intrin_make_ints" }
    if code == -144 { << "intrin_split_byte" }
    if code == -145 { << "intrin_join_strings" }
    if code == -20 { << "intrin_str_bool" }
    << ""
}

// Address behind a `$&T` operand.
fn (w $&Lw) intrin_ref(p &parser.Parser, tp &types.TypedProgram, arg int) int {
    if w.expr_is_ref(p, tp, arg) {
        << w.lower_expr(p, tp, arg)
    }
    << w.lower_addr(p, tp, arg)
}

fn (w $&Lw) intrin_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    a0 := p.nodes[n].a
    wide := intrin_wide_name(code)
    if wide.len > 0 {
        out := w.scratch_words(3)
        $args := []int{}
        args.push(out)
        $arg := a0
        while arg >= 0 {
            args.push(w.host_arg(p, tp, arg))
            arg = p.nodes[arg].next
        }
        w.call_core(wide, &args)
        << out
    }
    if code == -142 || code == -143 {
        $args := []int{}
        $arg := a0
        while arg >= 0 {
            args.push(w.host_arg(p, tp, arg))
            arg = p.nodes[arg].next
        }
        if code == -142 {
            << w.call_core("intrin_count_byte", &args)
        }
        << w.call_core("intrin_find_byte", &args)
    }
    if code == -23 {
        w.intrin_assert(p, tp, n)
        << w.konst(0)
    }
    if code == -54 {
        << w.load_ptr(w.intrin_ref(p, tp, a0), 0, 8)
    }
    if code == -55 {
        ptr := w.intrin_ref(p, tp, a0)
        w.store_ptr(ptr, 0, w.host_arg(p, tp, p.nodes[a0].next), 8)
        << w.konst(0)
    }
    if code == -56 || code == -57 {
        $args := []int{}
        args.push(w.intrin_ref(p, tp, a0))
        $arg := p.nodes[a0].next
        while arg >= 0 {
            args.push(w.host_arg(p, tp, arg))
            arg = p.nodes[arg].next
        }
        if code == -56 {
            << w.call_core("intrin_atomic_add", &args)
        }
        << w.call_core("intrin_atomic_cas", &args)
    }
    << NOT_HANDLED
}

// assert(cond[, msg]): the message is evaluated only on failure.
fn (w $&Lw) intrin_assert(p &parser.Parser, tp &types.TypedProgram, n int) {
    a0 := p.nodes[n].a
    cond := w.host_arg(p, tp, a0)
    fail_b := w.new_block()
    ok_b := w.new_block()
    w.branch(cond, ok_b, fail_b)
    w.f.active_bb = fail_b
    $msg := w.konst(0)
    if p.nodes[a0].next >= 0 {
        msg = w.host_arg(p, tp, p.nodes[a0].next)
    }
    $file := ""
    fid := p.file_of(tp.fns[w.fi].decl)
    if fid >= 0 && fid < p.file_names.len {
        file = p.file_names[fid] + ""
    }
    $args := []int{}
    args.push(w.lower_str_lit(file))
    args.push(w.konst(p.nodes[n].line))
    args.push(w.konst(p.nodes[n].col))
    args.push(msg)
    w.call_core("intrin_assert_fail", &args)
    w.jump(ok_b)
    w.f.active_bb = ok_b
}

// ===== fixed-size arrays =====

// N for a fixed-size array type, 0 otherwise.
fn fixed_len_of(tp &types.TypedProgram, ty int) int {
    t := tp.deref(tp.deref(ty))
    if !types.is_array_type(t) {
        << 0
    }
    ai := types.array_index(t)
    if ai < 0 || ai >= tp.arrays.len {
        << 0
    }
    << tp.arrays[ai].fixed_len
}

fn fixed_stride(tp &types.TypedProgram, ty int) int {
    << tp.arrays[types.array_index(tp.deref(tp.deref(ty)))].elem_bytes
}

// `[N]T{...}`; an empty element list zero-fills.
fn (w $&Lw) fixed_lit(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    out := w.scratch(tp, ty)
    w.zero_mem(out, tp.size_of(ty))
    ety := tp.elem_of(ty)
    stride := fixed_stride(tp, ty)
    $e := p.nodes[n].a
    $i := 0
    while e >= 0 {
        w.store_value(tp, out, i * stride, w.lower_expr(p, tp, e), ety)
        i += 1
        e = p.nodes[e].next
    }
    << out
}

// Address of element node n (NK_INDEX) of a fixed array of type bty.
fn (w $&Lw) fixed_elem_addr(p &parser.Parser, tp &types.TypedProgram, n int, bty int) int {
    base := w.base_addr(p, tp, p.nodes[n].a)
    idx := w.lower_expr(p, tp, p.nodes[n].b)
    w.bounds_check(idx, w.konst(fixed_len_of(tp, bty)))
    stride := fixed_stride(tp, bty)
    if stride == 1 {
        << w.bin(BIN_ADD, base, idx)
    }
    << w.bin(BIN_ADD, base, w.bin(BIN_MUL, idx, w.konst(stride)))
}

// A descriptor {data, N, N} viewing the fixed array at node n.
fn (w $&Lw) fixed_view(p &parser.Parser, tp &types.TypedProgram, n int, bty int) int {
    d := w.scratch_words(3)
    fl := w.konst(fixed_len_of(tp, bty))
    w.store_ptr(d, 0, w.base_addr(p, tp, n), 8)
    w.store_ptr(d, 8, fl, 8)
    w.store_ptr(d, 16, fl, 8)
    << d
}

// ===== string copies =====

// Value of e stored into a mutable string local: a string read from a
// field or element is copied, so byte stores through the local cannot
// reach the original.
fn (w $&Lw) string_copy_init(p &parser.Parser, tp &types.TypedProgram, e int) int {
    k := p.nodes[e].kind
    place := tp.const_of(e) < 0 && tp.call_of(e) != -77 && tp.call_of(e) != -30
    if (k == ast.NK_FIELD || k == ast.NK_INDEX) && place && tp.deref(tp.type_of(e)) == 3 {
        << w.lower_clone(p, tp, e)
    }
    << w.lower_expr(p, tp, e)
}
