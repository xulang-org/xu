@xu/mir
// Fold a counted, side-effect-free integer reduction of (i & (2^k - 1)).

fn periodic_load(f &MFn, block int, value int) int {
    ii := block_def(f, block, value)
    if ii >= 0 && f.instrs[ii].kind == MI_LOAD_LOCAL && f.instrs[ii].c == 0 {
        << f.instrs[ii].b
    }
    << -1
}

fn periodic_bin(f &MFn, block int, value int, op int) int {
    ii := block_def(f, block, value)
    if ii >= 0 && f.instrs[ii].kind == MI_BIN && f.instrs[ii].b == op {
        << ii
    }
    << -1
}

fn periodic_store_value(f &MFn, block int, local int) int {
    $v := -1
    $ii := f.blocks[block].head
    while ii >= 0 {
        ins := &f.instrs[ii]
        if ins.kind == MI_STORE_LOCAL && ins.a == local && ins.c == 0 {
            v = ins.b
        }
        ii = ins.next
    }
    << v
}

fn periodic_triangle(n int) int {
    // Divide before multiplying so the triangular number fits for n <= 2^32.
    << (n / 2) * (n - 1 + (n & 1))
}

fn periodic_prefix(n int, mask int, shift int) int {
    << (n >> shift) * periodic_triangle(mask + 1) + periodic_triangle(n & mask)
}

fn fold_periodic_loop(f $&MFn, header int) bool {
    h := ~f.blocks[header]
    if h.tkind != TKIND_BRANCH || h.tb == header || h.tc == header || h.tb == h.tc {
        << false
    }
    body := h.tb
    if f.blocks[body].tkind != TKIND_JUMP || f.blocks[body].ta != header {
        << false
    }
    cmp := periodic_bin(f, header, h.ta, BIN_LT)
    if cmp < 0 || f.instrs[cmp].d > -2 { << false }
    iv := periodic_load(f, header, f.instrs[cmp].c)
    if iv < 0 || f.locals[iv] != 1 || f.locals_nslots[iv] != 1 { << false }

    // Find the one edge entering the loop from outside. No edge may enter
    // the body except the header's true branch.
    $pre := -1
    for bi in 0:f.blocks.len {
        if bi == body { -> }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH {
            if f.blocks[bi].tc == body || f.blocks[bi].tb == body && bi != header ||
               f.blocks[bi].tb == header || f.blocks[bi].tc == header {
                << false
            }
        } else if tk == TKIND_JUMP {
            to := f.blocks[bi].ta
            if to == body { << false }
            if to == header {
                if pre >= 0 { << false }
                pre = bi
            }
        }
    }
    if pre < 0 || header == 0 || body == 0 { << false }
    start_arg := periodic_store_value(f, pre, iv)
    if start_arg > -2 { << false }
    start := fold_cval(f, start_arg)
    limit := fold_cval(f, f.instrs[cmp].d)
    if start < 0 || limit <= start { << false }

    $acc := -1
    $step := -1
    $sum := -1
    $ii := f.blocks[body].head
    while ii >= 0 {
        ins := &f.instrs[ii]
        if ins.kind == MI_STORE_LOCAL {
            if ins.c != 0 { << false }
            if ins.a == iv {
                if step != -1 { << false }
                step = ins.b
            } else {
                if acc >= 0 { << false }
                acc = ins.a
                sum = ins.b
            }
        }
        ii = ins.next
    }
    if acc < 0 || f.locals[acc] != 1 || f.locals_nslots[acc] != 1 { << false }
    inc := periodic_bin(f, body, step, BIN_ADD)
    if inc < 0 || f.instrs[inc].d > -2 || fold_cval(f, f.instrs[inc].d) != 1 ||
       periodic_load(f, body, f.instrs[inc].c) != iv {
        << false
    }
    add := periodic_bin(f, body, sum, BIN_ADD)
    if add < 0 || periodic_load(f, body, f.instrs[add].c) != acc { << false }
    band := periodic_bin(f, body, f.instrs[add].d, BIN_AND)
    if band < 0 || f.instrs[band].d > -2 || periodic_load(f, body, f.instrs[band].c) != iv {
        << false
    }
    mask := fold_cval(f, f.instrs[band].d)
    if mask < 0 || mask > 0xffffffff || (mask & (mask + 1)) != 0 { << false }

    // Addresses would allow a prior store through a pointer to change the
    // initial value. Also reject any use of a loop temp outside its block.
    for i in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[i].kind) { << false }
        if f.instrs[i].kind == MI_ADDR && (f.instrs[i].b == iv || f.instrs[i].b == acc) {
            << false
        }
    }
    uses := fold_use_blocks(f)
    if !periodic_pure_block(f, header, &uses, -1, -1) { << false }
    if !periodic_pure_block(f, body, &uses, iv, acc) { << false }

    $shift := 0
    $bits := mask
    while bits != 0 {
        shift += 1
        bits = bits >> 1
    }
    delta := alloc_const(f, periodic_prefix(limit, mask, shift) - periodic_prefix(start, mask, shift))
    end := alloc_const(f, limit)
    line := h.line
    initial := alloc_temp(f)
    result := alloc_temp(f)
    add_instr(f, pre, new_instr(MI_LOAD_LOCAL, initial, acc, 0, 0, line))
    add_instr(f, pre, new_instr(MI_BIN, result, BIN_ADD, initial, delta, line))
    add_instr(f, pre, new_instr(MI_STORE_LOCAL, acc, result, 0, 0, line))
    add_instr(f, pre, new_instr(MI_STORE_LOCAL, iv, end, 0, 0, line))
    f.blocks[pre].ta = h.tc
    << true
}

fn periodic_pure_block(f &MFn, b int, uses &[]int, iv int, acc int) bool {
    $stored_iv := false
    $stored_acc := false
    $ii := f.blocks[b].head
    while ii >= 0 {
        ins := &f.instrs[ii]
        k := ins.kind
        if k == MI_LOAD_LOCAL || k == MI_COPY || k == MI_BIN {
            // Unrelated calculations may trap. Admit only the three total
            // integer operations used by the reduction.
            if k == MI_BIN && ins.b != BIN_ADD && ins.b != BIN_AND && ins.b != BIN_LT {
                << false
            }
            if k == MI_LOAD_LOCAL && (stored_iv && ins.b == iv || stored_acc && ins.b == acc) {
                << false
            }
            if uses[ins.a] != -1 && uses[ins.a] != b { << false }
        } else if k == MI_STORE_LOCAL && iv >= 0 {
            if ins.a == iv { stored_iv = true }
            if ins.a == acc { stored_acc = true }
        } else if k != MI_NOP {
            << false
        }
        ii = ins.next
    }
    << true
}

pub fn opt_periodic(f $&MFn) bool {
    $changed := false
    for h in 0:f.blocks.len {
        if fold_periodic_loop(f, h) { changed = true }
    }
    << changed
}
