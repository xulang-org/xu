@xu/mir
// temp/any values and their type queries (`x is T`, `x as T`).
//
// A temp/any value is two words, as the checker sizes it:
//   [type id word][payload word]
// The type id is types.temp_box_type_id of the concrete type (0 = empty).
// A scalar payload is the value itself; a wide value is copied into a heap
// box laid out like an interface box, [type id word][value], and the
// payload is the address of the value inside it. A struct payload minus 8
// is therefore a valid interface word for the same struct.
//
// `as` on a mismatching type id panics (the checker has no `or` form for it).

#xu/ast
#xu/parser
#xu/types

fn is_dyn_box_type(t int) bool {
    << types.is_temp_type(t) || types.is_any_type(t)
}

fn (w &Lw) iface_wants_box(tp &types.TypedProgram, n int) bool {
    if !is_dyn_box_type(tp.box_of(n)) {
        << false
    }
    << !is_dyn_box_type(tp.deref(tp.type_of(n)))
}

// Box the concrete value of expression n into a fresh temp/any value.
fn (w $&Lw) iface_box(p &parser.Parser, tp &types.TypedProgram, n int) int {
    saved := w.unboxed
    w.unboxed = n
    $v := w.lower_expr(p, tp, n)
    w.unboxed = saved
    $ty := tp.type_of(n)
    if types.is_ref_type(ty) && w.expr_is_ref(p, tp, n) {
        ty = tp.deref(ty)
        if !is_wide(tp, ty) {
            v = w.load_ptr(v, 0, width_of(tp, ty))
        }
    }
    << w.dyn_pack(tp, v, ty)
}

// Two-word temp/any value holding v (a scalar or the address of a wide value).
fn (w $&Lw) dyn_pack(tp &types.TypedProgram, v int, ty int) int {
    out := w.scratch_words(2)
    if types.is_interface_type(ty) {
        w.zero_mem(out, 16)
        some_b := w.new_block()
        done_b := w.new_block()
        w.branch(v, some_b, done_b)
        w.f.active_bb = some_b
        w.store_ptr(out, 0, w.load_ptr(v, 0, 8), 8)
        w.store_ptr(out, 8, w.bin(BIN_ADD, v, w.konst(8)), 8)
        w.jump(done_b)
        w.f.active_bb = done_b
        << out
    }
    tid := types.temp_box_type_id(ty)
    w.store_ptr(out, 0, w.konst(tid), 8)
    if !is_wide(tp, ty) {
        w.store_ptr(out, 8, v, 8)
        << out
    }
    sz := tp.size_of(ty)
    $args := []int{}
    args.push(w.konst(8 + sz))
    bx := w.call_core("alloc", &args)
    w.store_ptr(bx, 0, w.konst(tid), 8)
    payload := w.bin(BIN_ADD, bx, w.konst(8))
    if sz > 0 {
        w.copy_mem(payload, v, sz)
    }
    w.store_ptr(out, 8, payload, 8)
    << out
}

fn (w $&Lw) dyn_type_test(p &parser.Parser, tp &types.TypedProgram, n int) int {
    a := p.nodes[n].a
    if !is_dyn_box_type(tp.deref(tp.deref(tp.type_of(a)))) {
        << NOT_HANDLED
    }
    d := w.base_addr(p, tp, a)
    tid := tp.local_of(n)
    tag := w.load_ptr(d, 0, 8)
    hit := w.bin(BIN_EQ, tag, w.konst(tid))
    if p.nodes[n].kind == ast.NK_TYPE_IS {
        << hit
    }
    w.type_assert(hit)
    ty := tp.type_of(n)
    payload := w.load_ptr(d, 8, 8)
    if !is_wide(tp, ty) {
        << payload
    }
    // `any` keeps its value: hand out a copy.
    if tp.str_of(n) == 1 {
        out := w.scratch(tp, ty)
        w.clone_into(tp, out, payload, ty)
        << out
    }
    << payload
}

// Fail the program with "type assert failed" unless hit is set.
fn (w $&Lw) type_assert(hit int) {
    bad_b := w.new_block()
    ok_b := w.new_block()
    w.branch(hit, ok_b, bad_b)
    w.f.active_bb = bad_b
    w.call_noargs(w.core("type_assert_fail"))
    w.jump(ok_b)
    w.f.active_bb = ok_b
}

// assert(cond[, msg]).
fn (w $&Lw) lower_assert(p &parser.Parser, tp &types.TypedProgram, n int) int {
    cond := p.nodes[n].a
    c := w.lower_expr(p, tp, cond)
    bad_b := w.new_block()
    ok_b := w.new_block()
    w.branch(c, ok_b, bad_b)
    w.f.active_bb = bad_b
    $msg := w.konst(0)
    if p.nodes[cond].next >= 0 {
        msg = w.base_addr(p, tp, p.nodes[cond].next)
    }
    $path := ""
    fid := p.file_of(tp.fns[w.fi].decl)
    if fid >= 0 && fid < p.file_names.len {
        path = p.file_names[fid] + ""
    }
    $args := []int{}
    args.push(w.lower_str_lit(path))
    args.push(w.konst(p.nodes[n].line))
    args.push(w.konst(p.nodes[n].col))
    args.push(msg)
    w.call_core("assert_fail", &args)
    w.jump(ok_b)
    w.f.active_bb = ok_b
    << w.konst(0)
}

// ===== hooks =====

fn (w $&Lw) iface_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_TYPE_IS || k == ast.NK_TYPE_AS {
        << w.dyn_type_test(p, tp, n)
    }
    << NOT_HANDLED
}

fn (w $&Lw) iface_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    if code == -23 {
        << w.lower_assert(p, tp, n)
    }
    << NOT_HANDLED
}
