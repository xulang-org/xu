@xu/mir
// Integer division and remainder by a constant without a divide
// instruction (Hacker's Delight chapter 10, signed, 64-bit words).
//
// MI_BIN BIN_DIV / BIN_MOD are sdiv semantics on 64-bit words: the
// quotient truncates toward zero and the remainder has the dividend's
// sign. Narrow integer types are normalised words before and after
// (wrap_int), so rewriting the word operation is exact for them too.
// BIN_SHR is an arithmetic shift. For a temp x and a constant d:
//   d == 1:   q = x                  r = 0
//   d == -1:  q = 0 - x              r = 0
//   |d| == 2^k, k >= 1 (d == MIN is k = 63):
//     s = x >> 63; b = s & (2^k - 1); t = x + b
//     q = t >> k, negated when d < 0;  r = x - (t & -2^k)
//   otherwise, with (m, sh) = dc_magic(d):
//     h = mulh x, m; h = h + x when d > 0 && m < 0;
//     h = h - x when d < 0 && m > 0; h = h >> sh
//     q = h - (h >> 63);  r = x - q * d
// BIN_MULH (high word of the signed 128-bit product) exists only in
// backends that implement it, and the shift forms assume 64-bit words:
// with mulh false the pass does nothing.

fn dc_min() int {
    m := 1 << 63
    << m
}

// a < b as unsigned 64-bit values.
fn dc_ult(a int, b int) bool {
    m := dc_min()
    << (a ^ m) < (b ^ m)
}

// Unsigned n / d into qr[0] and n % d into qr[1], d != 0, by
// shift-subtract. r < d (unsigned) holds before each step, so a set top
// bit before the shift means 2r + bit >= 2^64 > d.
fn dc_udivmod(n int, d int, qr $&[]int) {
    $q := 0
    $r := 0
    $i := 63
    while i >= 0 {
        top := r < 0
        r = (r << 1) | ((n >> i) & 1)
        if top || !dc_ult(r, d) {
            r = r - d
            q = q | (1 << i)
        }
        i -= 1
    }
    qr[0] = q
    qr[1] = r
}

// High 64 bits of the signed 128-bit product a * b.
fn dc_mulhs(a int, b int) int {
    lo := 0xffffffff
    a0 := a & lo
    a1 := (a >> 32) & lo
    b0 := b & lo
    b1 := (b >> 32) & lo
    p00 := a0 * b0
    p01 := a0 * b1
    p10 := a1 * b0
    p11 := a1 * b1
    mid := ((p00 >> 32) & lo) + (p01 & lo) + (p10 & lo)
    $hi := p11 + ((p01 >> 32) & lo) + ((p10 >> 32) & lo) + (mid >> 32)
    if a < 0 {
        hi = hi - b
    }
    if b < 0 {
        hi = hi - a
    }
    << hi
}

// High 64 bits of the unsigned 128-bit product a * b.
fn dc_mulhu(a int, b int) int {
    lo := 0xffffffff
    a0 := a & lo
    a1 := (a >> 32) & lo
    b0 := b & lo
    b1 := (b >> 32) & lo
    p00 := a0 * b0
    p01 := a0 * b1
    p10 := a1 * b0
    p11 := a1 * b1
    mid := ((p00 >> 32) & lo) + (p01 & lo) + (p10 & lo)
    << p11 + ((p01 >> 32) & lo) + ((p10 >> 32) & lo) + (mid >> 32)
}

// Magic multiplier mr[0] and shift mr[1] for signed division by d,
// 2 <= |d| < 2^63 (Hacker's Delight figure 10-1 at 64 bits; ad, anc,
// delta, q1, r1, q2, r2 and t are unsigned). mr[1] = -1 on failure.
fn dc_magic(d int, mr $&[]int) {
    mr[0] = 0
    mr[1] = -1
    two63 := dc_min()
    $ad := d
    $t := two63
    if d < 0 {
        ad = 0 - d
        t = two63 + 1
    }
    if ad < 2 {
        <<
    }
    $qr := []int{}
    qr.push(0)
    qr.push(0)
    dc_udivmod(t, ad, $&qr)
    anc := t - 1 - qr[1]
    dc_udivmod(two63, anc, $&qr)
    $q1 := qr[0]
    $r1 := qr[1]
    dc_udivmod(two63, ad, $&qr)
    $q2 := qr[0]
    $r2 := qr[1]
    $p := 63
    $done := false
    for _ in 0:70 {
        p += 1
        q1 = q1 << 1
        r1 = r1 << 1
        if !dc_ult(r1, anc) {
            q1 += 1
            r1 = r1 - anc
        }
        q2 = q2 << 1
        r2 = r2 << 1
        if !dc_ult(r2, ad) {
            q2 += 1
            r2 = r2 - ad
        }
        delta := ad - r2
        if !(dc_ult(q1, delta) || (q1 == delta && r1 == 0)) {
            done = true
            <-
        }
    }
    if !done || p - 64 < 0 || p - 64 > 63 {
        <<
    }
    $m := q2 + 1
    if d < 0 {
        m = 0 - m
    }
    mr[0] = m
    mr[1] = p - 64
}

// Unsigned magic multiplier mr[0] and shift mr[1] >= 1 for dividing
// non-negative signed 64-bit x (0 <= x < 2^63) by non-pow2 d >= 3:
// floor(x / d) == (UMULH(x, mr[0]) >> mr[1]), where UMULH < 2^63 always.
fn dc_magic_u(d int, mr $&[]int) {
    mr[0] = 0
    mr[1] = -1
    if d < 3 || (d & (d - 1)) == 0 {
        <<
    }
    $s := 0
    $td := d
    while td > 1 {
        td = td >> 1
        s += 1
    }
    if s < 1 || s > 62 {
        <<
    }
    $qr := []int{}
    qr.push(0)
    qr.push(0)
    dc_udivmod(dc_min(), d, $&qr)
    $q := qr[0]
    $r := qr[1]
    for _ in 0:1 + s {
        top := r < 0
        r = r << 1
        q = q << 1
        if top || !dc_ult(r, d) {
            r = r - d
            q += 1
        }
    }
    if r == 0 {
        <<
    }
    mr[0] = q + 1
    mr[1] = s
}

// k when |v| == 2^k with k >= 1 (MIN gives 63), else -1.
fn dc_log2(v int) int {
    if v == dc_min() {
        << 63
    }
    $a := v
    if a < 0 {
        a = 0 - a
    }
    << fold_log2(a)
}

fn dc_put(f $&MFn, out $&[]int, src &MInstr, kind int, a int, b int, c int, d int) {
    $ins := minstr_new(kind)
    ins.a = a
    ins.b = b
    ins.c = c
    ins.d = d
    ins.line = src.line
    ins.col = src.col
    ins.file = src.file
    out.push(f.instrs.len)
    f.instrs.push(ins)
}

// New temp = x op y.
fn dc_op(f $&MFn, out $&[]int, src &MInstr, op int, x int, y int) int {
    t := alloc_temp(f)
    dc_put(f, out, src, MI_BIN, t, op, x, y)
    << t
}

// The original destination = x op y.
fn dc_fin(f $&MFn, out $&[]int, src &MInstr, op int, x int, y int) {
    dc_put(f, out, src, MI_BIN, src.a, op, x, y)
}

// Appends the replacement of src (div/mod of temp x by a nonzero
// constant d) to out. Returns -2 when it keeps the division, else the
// temp holding the quotient x / d afterwards (-1 when none does). cq >= 0
// is a temp already holding x / d in this block (same x, same d).
// is_nn: x is known >= 0 at src.
fn dc_expand(f $&MFn, src &MInstr, out $&[]int, cq int, is_nn bool) int {
    x := src.c
    d := f.consts[0 - src.d - 2]
    is_div := src.b == BIN_DIV
    if d == 1 || d == -1 {
        if !is_div {
            dc_put(f, out, src, MI_COPY, src.a, alloc_const(f, 0), -1, -1)
        } else if d == 1 {
            dc_put(f, out, src, MI_COPY, src.a, x, -1, -1)
        } else {
            dc_fin(f, out, src, BIN_SUB, alloc_const(f, 0), x)
        }
        << -1
    }
    k := dc_log2(d)
    if k > 0 && d > 0 && is_nn {
        if !is_div {
            dc_fin(f, out, src, BIN_AND, x, alloc_const(f, (1 << k) - 1))
            << -1
        }
        if cq >= 0 {
            dc_put(f, out, src, MI_COPY, src.a, cq, -1, -1)
            << src.a
        }
        dc_fin(f, out, src, BIN_SHR, x, alloc_const(f, k))
        << src.a
    }
    if cq >= 0 {
        if is_div {
            dc_put(f, out, src, MI_COPY, src.a, cq, -1, -1)
            << src.a
        }
        p := dc_op(f, out, src, BIN_MUL, cq, alloc_const(f, d))
        dc_fin(f, out, src, BIN_SUB, x, p)
        << cq
    }
    if k > 0 {
        // b = 2^k - 1 for negative x, else 0: t = x + b makes the shift
        // round toward zero.
        s := dc_op(f, out, src, BIN_SHR, x, alloc_const(f, 63))
        b := dc_op(f, out, src, BIN_AND, s, alloc_const(f, (1 << k) - 1))
        t := dc_op(f, out, src, BIN_ADD, x, b)
        if !is_div {
            m := dc_op(f, out, src, BIN_AND, t, alloc_const(f, 0 - (1 << k)))
            dc_fin(f, out, src, BIN_SUB, x, m)
            << -1
        }
        if d > 0 {
            dc_fin(f, out, src, BIN_SHR, t, alloc_const(f, k))
        } else {
            q := dc_op(f, out, src, BIN_SHR, t, alloc_const(f, k))
            dc_fin(f, out, src, BIN_SUB, alloc_const(f, 0), q)
        }
        << src.a
    }
    $mr := []int{}
    mr.push(0)
    mr.push(0 - 1)
    if d >= 3 && is_nn {
        dc_magic_u(d, $&mr)
        if mr[1] > 0 {
            hu := dc_op(f, out, src, BIN_MULH_U, x, alloc_const(f, mr[0]))
            if is_div {
                dc_fin(f, out, src, BIN_SHR, hu, alloc_const(f, mr[1]))
                << src.a
            }
            qu := dc_op(f, out, src, BIN_SHR, hu, alloc_const(f, mr[1]))
            pu := dc_op(f, out, src, BIN_MUL, qu, alloc_const(f, d))
            dc_fin(f, out, src, BIN_SUB, x, pu)
            << qu
        }
    }
    dc_magic(d, $&mr)
    m := mr[0]
    sh := mr[1]
    if sh < 0 {
        << -2
    }
    $h := dc_op(f, out, src, BIN_MULH, x, alloc_const(f, m))
    if d > 0 && m < 0 {
        h = dc_op(f, out, src, BIN_ADD, h, x)
    }
    if d < 0 && m > 0 {
        h = dc_op(f, out, src, BIN_SUB, h, x)
    }
    if d > 0 && is_nn {
        if sh > 0 {
            if is_div {
                dc_fin(f, out, src, BIN_SHR, h, alloc_const(f, sh))
                << src.a
            }
            h = dc_op(f, out, src, BIN_SHR, h, alloc_const(f, sh))
        } else if is_div {
            dc_put(f, out, src, MI_COPY, src.a, h, -1, -1)
            << src.a
        }
        p := dc_op(f, out, src, BIN_MUL, h, alloc_const(f, d))
        dc_fin(f, out, src, BIN_SUB, x, p)
        << h
    }
    if sh > 0 {
        h = dc_op(f, out, src, BIN_SHR, h, alloc_const(f, sh))
    }
    sg := dc_op(f, out, src, BIN_SHR, h, alloc_const(f, 63))
    if is_div {
        dc_fin(f, out, src, BIN_SUB, h, sg)
        << src.a
    }
    q := dc_op(f, out, src, BIN_SUB, h, sg)
    p := dc_op(f, out, src, BIN_MUL, q, alloc_const(f, d))
    dc_fin(f, out, src, BIN_SUB, x, p)
    << q
}

fn dc_max_int() int {
    << (1 << 62) + ((1 << 62) - 1)
}

fn dc_val_nn(f &MFn, nn &[]bool, v int) bool {
    if v <= -2 {
        << f.consts[0 - v - 2] >= 0
    }
    if v >= 0 && v < nn.len {
        << nn[v]
    }
    << false
}

fn dc_val_ub(f &MFn, ub &[]int, v int) int {
    if v <= -2 {
        c := f.consts[0 - v - 2]
        if c >= 0 {
            << c
        }
        << -1
    }
    if v >= 0 && v < ub.len {
        << ub[v]
    }
    << -1
}

fn dc_reach(f &MFn) []bool {
    nb := f.blocks.len
    $r := []bool{}
    for _ in 0:nb { r.push(false) }
    if nb == 0 { << r }
    $q := []int{}
    r[0] = true
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !r[s] {
                r[s] = true
                q.push(s)
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if sb >= 0 && sb < nb && !r[sb] {
                r[sb] = true
                q.push(sb)
            }
            sc := f.blocks[b].tc
            if sc >= 0 && sc < nb && !r[sc] {
                r[sc] = true
                q.push(sc)
            }
        }
    }
    << r
}

fn dc_edge_dom_work(f &MFn, reach &[]bool, gb int, succ int, target int, vis $&[]int, tag int) bool {
    nb := f.blocks.len
    if target == 0 || gb < 0 || gb >= nb || !reach[gb] || !reach[target] || gb == target {
        << false
    }
    $q := []int{}
    vis[0] = tag
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if !(b == gb && s == succ) && s >= 0 && s < nb && vis[s] != tag {
                if s == target { << false }
                vis[s] = tag
                q.push(s)
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if !(b == gb && sb == succ) && sb >= 0 && sb < nb && vis[sb] != tag {
                if sb == target { << false }
                vis[sb] = tag
                q.push(sb)
            }
            sc := f.blocks[b].tc
            if !(b == gb && sc == succ) && sc >= 0 && sc < nb && vis[sc] != tag {
                if sc == target { << false }
                vis[sc] = tag
                q.push(sc)
            }
        }
    }
    << true
}

fn dc_edge_dom(f &MFn, reach &[]bool, gb int, succ int, target int) bool {
    $vis := []int{}
    for _ in 0:f.blocks.len { vis.push(0) }
    << dc_edge_dom_work(f, reach, gb, succ, target, $&vis, 1)
}

fn dc_local_init_dom(f &MFn, gb int, init_mark &[]int, mark_tag int, vis $&[]int, vis_tag int) bool {
    nb := f.blocks.len
    if gb == 0 {
        << false
    }
    if init_mark[0] == mark_tag {
        << true
    }
    $q := []int{}
    vis[0] = vis_tag
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && vis[s] != vis_tag {
                if s == gb { << false }
                if init_mark[s] != mark_tag {
                    vis[s] = vis_tag
                    q.push(s)
                }
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if sb >= 0 && sb < nb && vis[sb] != vis_tag {
                if sb == gb { << false }
                if init_mark[sb] != mark_tag {
                    vis[sb] = vis_tag
                    q.push(sb)
                }
            }
            sc := f.blocks[b].tc
            if sc >= 0 && sc < nb && vis[sc] != vis_tag {
                if sc == gb { << false }
                if init_mark[sc] != mark_tag {
                    vis[sc] = vis_tag
                    q.push(sc)
                }
            }
        }
    }
    << true
}

fn dc_path_no_store(f &MFn, start_b int, end_b int, gb int, store_mark &[]int, mark_tag int, vis $&[]int, vis_tag int) bool {
    nb := f.blocks.len
    if start_b == end_b {
        << store_mark[gb] != mark_tag
    }
    if start_b < 0 || start_b >= nb || store_mark[gb] == mark_tag || store_mark[start_b] == mark_tag {
        << false
    }
    $q := []int{}
    vis[start_b] = vis_tag
    q.push(start_b)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && s != end_b && s != gb && vis[s] != vis_tag {
                if store_mark[s] == mark_tag { << false }
                vis[s] = vis_tag
                q.push(s)
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if sb >= 0 && sb < nb && sb != end_b && sb != gb && vis[sb] != vis_tag {
                if store_mark[sb] == mark_tag { << false }
                vis[sb] = vis_tag
                q.push(sb)
            }
            sc := f.blocks[b].tc
            if sc >= 0 && sc < nb && sc != end_b && sc != gb && vis[sc] != vis_tag {
                if store_mark[sc] == mark_tag { << false }
                vis[sc] = vis_tag
                q.push(sc)
            }
        }
    }
    << true
}

// True when every reachable use of single-def temp t is an equality/inequality
// compare against 0 (so x % 2^k and x & (2^k - 1) are indistinguishable).
fn dc_mod_zero_cmp_only(f &MFn, reach &[]bool, def_cnt &[]int, t int) bool {
    if t < 0 || t >= def_cnt.len || def_cnt[t] != 1 {
        << false
    }
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_BIN {
                if ins.c == t || ins.d == t {
                    is_eq0 := (ins.b == BIN_EQ || ins.b == BIN_NE) &&
                              ((ins.c == t && ins.d <= -2 && f.consts[0 - ins.d - 2] == 0) ||
                               (ins.d == t && ins.c <= -2 && f.consts[0 - ins.c - 2] == 0))
                    if !is_eq0 {
                        << false
                    }
                }
            } else if k == MI_CALL || k == MI_CALL_IND {
                if k == MI_CALL_IND && ins.b == t {
                    << false
                }
                $a := ins.c
                while a >= 0 {
                    if f.margs[a].v == t {
                        << false
                    }
                    a = f.margs[a].next
                }
            } else if k == MI_UN {
                if ins.c == t { << false }
            } else if k == MI_SELECT {
                if ins.b == t || ins.c == t || ins.d == t { << false }
            } else if k == MI_COPY || k == MI_LOAD_PTR || k == MI_STORE_LOCAL {
                if ins.b == t { << false }
            } else if k == MI_STORE_PTR {
                if ins.a == t || ins.b == t { << false }
            } else if k != MI_NOP && k != MI_LOAD_LOCAL && k != MI_ADDR && k != MI_STR_CONST && k != MI_LOAD_FN_ADDR {
                << false
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if (tk == TKIND_RETURN || tk == TKIND_BRANCH) && f.blocks[bi].ta == t {
            << false
        }
    }
    << true
}

fn dc_single_pred(f &MFn, reach &[]bool, gb int, bi int) bool {
    if bi == 0 {
        << false
    }
    $edges := 0
    for b in 0:f.blocks.len {
        if !reach[b] { -> }
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            if f.blocks[b].ta == bi {
                << false
            }
        } else if tk == TKIND_BRANCH {
            if f.blocks[b].tb == bi {
                if b != gb { << false }
                edges += 1
            }
            if f.blocks[b].tc == bi {
                if b != gb { << false }
                edges += 1
            }
        }
    }
    << edges == 1
}

fn dc_loc_stored_after(f &MFn, bi int, start_ii int, loc int) bool {
    $ii := f.instrs[start_ii].next
    while ii >= 0 {
        ins := &f.instrs[ii]
        if ins.kind == MI_STORE_LOCAL && ins.a == loc {
            << true
        }
        ii = ins.next
    }
    << false
}

fn dc_loc_stored_before(f &MFn, bi int, stop_ii int, loc int) bool {
    $ii := f.blocks[bi].head
    while ii >= 0 && ii != stop_ii {
        ins := &f.instrs[ii]
        if ins.kind == MI_STORE_LOCAL && ins.a == loc {
            << true
        }
        ii = ins.next
    }
    << false
}

// True when block bi is guaranteed to execute with (x & ((1 << k) - 1)) == 0,
// so signed x / 2^k == x >> k with no rounding bias (exact for all 64-bit x).
fn dc_guarded_pow2_div(f &MFn, reach &[]bool, def_cnt &[]int, def_blk &[]int, def_ii &[]int, addr_taken &[]bool, bi int, x int, k int) bool {
    nt := f.temps.len
    if k <= 0 || k >= 63 || x < 0 || x >= nt || def_cnt[x] != 1 {
        << false
    }
    mask := (1 << k) - 1
    $xloc := -1
    xii := def_ii[x]
    xins := &f.instrs[xii]
    if xins.kind == MI_LOAD_LOCAL && xins.c == 0 && xins.b >= 0 && xins.b < addr_taken.len &&
       !addr_taken[xins.b] && (xins.b >= f.locals_nslots.len || f.locals_nslots[xins.b] == 1) &&
       def_blk[x] == bi && !dc_loc_stored_before(f, bi, xii, xins.b) {
        xloc = xins.b
    }
    for gb in 0:f.blocks.len {
        if !reach[gb] || f.blocks[gb].tkind != TKIND_BRANCH {
            ->
        }
        if f.blocks[gb].tb == f.blocks[gb].tc {
            ->
        }
        cond := f.blocks[gb].ta
        if cond < 0 || cond >= nt || def_cnt[cond] != 1 {
            ->
        }
        cii := def_ii[cond]
        cins := &f.instrs[cii]
        if cins.kind != MI_BIN || (cins.b != BIN_EQ && cins.b != BIN_NE) {
            ->
        }
        $rem := -1
        if cins.c >= 0 && cins.d <= -2 && f.consts[0 - cins.d - 2] == 0 {
            rem = cins.c
        } else if cins.d >= 0 && cins.c <= -2 && f.consts[0 - cins.c - 2] == 0 {
            rem = cins.d
        }
        if rem < 0 || rem >= nt || def_cnt[rem] != 1 {
            ->
        }
        rii := def_ii[rem]
        rins := &f.instrs[rii]
        $gx := -1
        if rins.kind == MI_BIN && rins.b == BIN_AND {
            if rins.c >= 0 && rins.d <= -2 && (f.consts[0 - rins.d - 2] & mask) == mask {
                gx = rins.c
            } else if rins.d >= 0 && rins.c <= -2 && (f.consts[0 - rins.c - 2] & mask) == mask {
                gx = rins.d
            }
        } else if rins.kind == MI_BIN && rins.b == BIN_MOD && rins.c >= 0 && rins.d <= -2 {
            dv := f.consts[0 - rins.d - 2]
            mk := dc_log2(dv)
            if mk >= k && mk < 63 {
                gx = rins.c
            }
        }
        if gx < 0 || gx >= nt || def_cnt[gx] != 1 {
            ->
        }
        $zero_succ := f.blocks[gb].tb
        if cins.b == BIN_NE {
            zero_succ = f.blocks[gb].tc
        }
        if gx == x && dc_edge_dom(f, reach, gb, zero_succ, bi) {
            << true
        }
        if xloc >= 0 && zero_succ == bi && def_blk[gx] == gb {
            gii := def_ii[gx]
            gins := &f.instrs[gii]
            if gins.kind == MI_LOAD_LOCAL && gins.c == 0 && gins.b == xloc &&
               dc_single_pred(f, reach, gb, bi) && !dc_loc_stored_after(f, gb, gii, xloc) {
                << true
            }
        }
    }
    << false
}

fn dc_guarded_nn(f &MFn, reach &[]bool, def_cnt &[]int, def_blk &[]int, def_ii &[]int, addr_taken &[]bool, bi int, x int) bool {
    nt := f.temps.len
    if x < 0 || x >= nt || def_cnt[x] != 1 {
        << false
    }
    $sub_y := -1
    $sub_k := 0
    $y_loc := -1
    xii := def_ii[x]
    xins := &f.instrs[xii]
    if xins.kind == MI_BIN && xins.b == BIN_SUB && xins.c >= 0 && xins.c < nt && xins.d <= -2 {
        sk := f.consts[0 - xins.d - 2]
        if sk >= 0 && sk <= 1024 && def_cnt[xins.c] == 1 {
            sub_y = xins.c
            sub_k = sk
            yii := def_ii[sub_y]
            yins := &f.instrs[yii]
            if yins.kind == MI_LOAD_LOCAL && yins.c == 0 && yins.b >= 0 && yins.b < addr_taken.len &&
               !addr_taken[yins.b] && (yins.b >= f.locals_nslots.len || f.locals_nslots[yins.b] == 1) &&
               def_blk[sub_y] == bi && !dc_loc_stored_before(f, bi, yii, yins.b) {
                y_loc = yins.b
            }
        }
    }
    for gb in 0:f.blocks.len {
        if !reach[gb] || f.blocks[gb].tkind != TKIND_BRANCH || f.blocks[gb].tb == f.blocks[gb].tc {
            ->
        }
        cond := f.blocks[gb].ta
        if cond < 0 || cond >= nt || def_cnt[cond] != 1 {
            ->
        }
        cond_ii := def_ii[cond]
        cins := &f.instrs[cond_ii]
        if cins.kind != MI_BIN {
            ->
        }
        op := cins.b
        $t_ok := false
        $f_ok := false
        if cins.c == x && cins.d <= -2 {
            cv := f.consts[0 - cins.d - 2]
            if (op == BIN_GE && cv >= 0) || (op == BIN_GT && cv >= -1) { t_ok = true }
            if (op == BIN_LT && cv >= 0) || (op == BIN_LE && cv >= -1) { f_ok = true }
        } else if cins.d == x && cins.c <= -2 {
            cv := f.consts[0 - cins.c - 2]
            if (op == BIN_LE && cv >= 0) || (op == BIN_LT && cv >= -1) { t_ok = true }
            if (op == BIN_GT && cv >= 0) || (op == BIN_GE && cv >= -1) { f_ok = true }
        }
        if t_ok && dc_edge_dom(f, reach, gb, f.blocks[gb].tb, bi) {
            << true
        }
        if f_ok && dc_edge_dom(f, reach, gb, f.blocks[gb].tc, bi) {
            << true
        }
        if sub_y >= 0 {
            $gx := -1
            $st_ok := false
            $sf_ok := false
            if cins.c >= 0 && cins.d <= -2 {
                cv := f.consts[0 - cins.d - 2]
                if (op == BIN_GE && cv >= sub_k) || (op == BIN_GT && cv >= sub_k - 1) {
                    gx = cins.c
                    st_ok = true
                }
                if (op == BIN_LT && cv >= sub_k) || (op == BIN_LE && cv >= sub_k - 1) {
                    gx = cins.c
                    sf_ok = true
                }
            } else if cins.d >= 0 && cins.c <= -2 {
                cv := f.consts[0 - cins.c - 2]
                if (op == BIN_LE && cv >= sub_k) || (op == BIN_LT && cv >= sub_k - 1) {
                    gx = cins.d
                    st_ok = true
                }
                if (op == BIN_GT && cv >= sub_k) || (op == BIN_GE && cv >= sub_k - 1) {
                    gx = cins.d
                    sf_ok = true
                }
            }
            if gx >= 0 && gx < nt && def_cnt[gx] == 1 {
                $succ := -1
                if st_ok { succ = f.blocks[gb].tb }
                else if sf_ok { succ = f.blocks[gb].tc }
                if succ >= 0 {
                    if gx == sub_y && dc_edge_dom(f, reach, gb, succ, bi) {
                        << true
                    }
                    if y_loc >= 0 && succ == bi && def_blk[gx] == gb {
                        gii := def_ii[gx]
                        gins := &f.instrs[gii]
                        if gins.kind == MI_LOAD_LOCAL && gins.c == 0 && gins.b == y_loc &&
                           dc_single_pred(f, reach, gb, bi) && !dc_loc_stored_after(f, gb, gii, y_loc) {
                            << true
                        }
                    }
                }
            }
        }
    }
    << false
}

fn dc_is_self_load(f &MFn, def_cnt &[]int, def_ii &[]int, l int, v int) bool {
    $cur := v
    for _ in 0:8 {
        if cur < 0 || cur >= def_cnt.len || def_cnt[cur] != 1 {
            << false
        }
        dii := def_ii[cur]
        ins := &f.instrs[dii]
        if ins.kind == MI_LOAD_LOCAL && ins.c == 0 && ins.b == l {
            << true
        }
        if ins.kind == MI_COPY {
            cur = ins.b
        } else {
            << false
        }
    }
    << false
}

fn dc_bin_pos_const(f &MFn, def_cnt &[]int, def_ii &[]int, v int, want_op int) int {
    $cur := v
    for _ in 0:8 {
        if cur < 0 || cur >= def_cnt.len || def_cnt[cur] != 1 {
            << 0
        }
        dii := def_ii[cur]
        ins := &f.instrs[dii]
        if ins.kind == MI_BIN && ins.b == want_op && ins.d <= -2 {
            dv := f.consts[0 - ins.d - 2]
            if dv > 0 {
                << dv
            }
            << 0
        }
        if ins.kind == MI_COPY {
            cur = ins.b
        } else {
            << 0
        }
    }
    << 0
}

fn dc_mod_pos_const(f &MFn, def_cnt &[]int, def_ii &[]int, v int) int {
    << dc_bin_pos_const(f, def_cnt, def_ii, v, BIN_MOD)
}

fn dc_propagate_temps(f &MFn, cand_temps &[]int, def_ii &[]int, local_nn &[]bool, local_ub &[]int, call_nn &[]bool, call_ub &[]int, nn $&[]bool, ub $&[]int, n_iters int) {
    nl := local_nn.len
    max_i := dc_max_int()
    for _ in 0:n_iters {
        $chg := false
        for ti in 0:cand_temps.len {
            t := cand_temps[ti]
            tii := def_ii[t]
            ins := &f.instrs[tii]
            k := ins.kind
            $next_nn := nn[t]
            $next_ub := ub[t]
            if k == MI_COPY {
                if dc_val_nn(f, nn, ins.b) { next_nn = true }
                u := dc_val_ub(f, ub, ins.b)
                if u >= 0 && (next_ub < 0 || u < next_ub) { next_ub = u }
            } else if k == MI_LOAD_LOCAL {
                if ins.c == 0 && ins.b >= 0 && ins.b < nl && local_nn[ins.b] {
                    next_nn = true
                    lu := local_ub[ins.b]
                    if lu >= 0 && (next_ub < 0 || lu < next_ub) { next_ub = lu }
                }
            } else if k == MI_CALL {
                if tii < call_nn.len && call_nn[tii] {
                    next_nn = true
                    cu := call_ub[tii]
                    if cu >= 0 && (next_ub < 0 || cu < next_ub) { next_ub = cu }
                }
            } else if k == MI_SELECT {
                if dc_val_nn(f, nn, ins.c) && dc_val_nn(f, nn, ins.d) {
                    next_nn = true
                    uc := dc_val_ub(f, ub, ins.c)
                    ud := dc_val_ub(f, ub, ins.d)
                    if uc >= 0 && ud >= 0 {
                        $m := uc
                        if ud > m { m = ud }
                        if next_ub < 0 || m < next_ub { next_ub = m }
                    }
                }
            } else if k == MI_BIN {
                op := ins.b
                if (op >= BIN_EQ && op <= BIN_GE) || (op >= BIN_FEQ && op <= BIN_FGE) {
                    next_nn = true
                    next_ub = 1
                } else if op == BIN_AND {
                    if dc_val_nn(f, nn, ins.c) || dc_val_nn(f, nn, ins.d) {
                        next_nn = true
                        uc := dc_val_ub(f, ub, ins.c)
                        ud := dc_val_ub(f, ub, ins.d)
                        $u := uc
                        if ud >= 0 && (u < 0 || ud < u) { u = ud }
                        if u >= 0 && (next_ub < 0 || u < next_ub) { next_ub = u }
                    }
                } else if op == BIN_OR || op == BIN_XOR {
                    if dc_val_nn(f, nn, ins.c) && dc_val_nn(f, nn, ins.d) {
                        next_nn = true
                    }
                } else if op == BIN_SHR {
                    if dc_val_nn(f, nn, ins.c) {
                        next_nn = true
                        uc := dc_val_ub(f, ub, ins.c)
                        if uc >= 0 {
                            $u := uc
                            if ins.d <= -2 {
                                sh := f.consts[0 - ins.d - 2]
                                if sh >= 0 && sh < 63 { u = uc >> sh }
                            }
                            if next_ub < 0 || u < next_ub { next_ub = u }
                        }
                    }
                } else if op == BIN_ADD {
                    if dc_val_nn(f, nn, ins.c) && dc_val_nn(f, nn, ins.d) {
                        next_nn = true
                        uc := dc_val_ub(f, ub, ins.c)
                        ud := dc_val_ub(f, ub, ins.d)
                        if uc >= 0 && ud >= 0 && uc <= max_i - ud {
                            u := uc + ud
                            if next_ub < 0 || u < next_ub { next_ub = u }
                        }
                    }
                } else if op == BIN_SUB {
                    if dc_val_nn(f, nn, ins.c) && ins.d <= -2 {
                        cv := f.consts[0 - ins.d - 2]
                        if cv == 0 {
                            next_nn = true
                            uc := dc_val_ub(f, ub, ins.c)
                            if uc >= 0 && (next_ub < 0 || uc < next_ub) { next_ub = uc }
                        }
                    }
                } else if op == BIN_MUL {
                    nn_c := dc_val_nn(f, nn, ins.c)
                    nn_d := dc_val_nn(f, nn, ins.d)
                    uc := dc_val_ub(f, ub, ins.c)
                    ud := dc_val_ub(f, ub, ins.d)
                    if (nn_c && uc == 0) || (nn_d && ud == 0) {
                        next_nn = true
                        next_ub = 0
                    } else if nn_c && nn_d {
                        next_nn = true
                        if uc > 0 {
                            if ud > 0 && ud <= max_i / uc {
                                u := uc * ud
                                if next_ub < 0 || u < next_ub { next_ub = u }
                            }
                        }
                    }
                } else if op == BIN_DIV {
                    if ins.d <= -2 {
                        dv := f.consts[0 - ins.d - 2]
                        if dv > 0 && dc_val_nn(f, nn, ins.c) {
                            next_nn = true
                            uc := dc_val_ub(f, ub, ins.c)
                            if uc >= 0 {
                                u := uc / dv
                                if next_ub < 0 || u < next_ub { next_ub = u }
                            }
                        }
                    } else if dc_val_nn(f, nn, ins.c) && dc_val_nn(f, nn, ins.d) {
                        next_nn = true
                    }
                } else if op == BIN_MOD && ins.d <= -2 {
                    dv := f.consts[0 - ins.d - 2]
                    if dv > 0 && dc_val_nn(f, nn, ins.c) {
                        next_nn = true
                        $u := dv - 1
                        uc := dc_val_ub(f, ub, ins.c)
                        if uc >= 0 && uc < u { u = uc }
                        if next_ub < 0 || u < next_ub { next_ub = u }
                    }
                } else if op == BIN_ROTR32 {
                    next_nn = true
                    if next_ub < 0 || 4294967295 < next_ub { next_ub = 4294967295 }
                }
            }
            if next_nn && !nn[t] {
                nn[t] = true
                chg = true
            }
            if next_ub >= 0 && (ub[t] < 0 || next_ub < ub[t]) {
                ub[t] = next_ub
                chg = true
            }
        }
        if !chg { <- }
    }
}

fn dc_try_local_inv(f &MFn, cand_temps &[]int, def_cnt &[]int, def_ii &[]int, local_nn $&[]bool, local_ub $&[]int, call_nn &[]bool, call_ub &[]int, nn $&[]bool, ub $&[]int, l int, cand_u int, store_head int, st_val &[]int, st_next &[]int, check_ub bool) bool {
    $tnn := []bool{}
    $tub := []int{}
    for i in 0:nn.len { tnn.push(nn[i]) }
    for i in 0:ub.len { tub.push(ub[i]) }
    local_nn[l] = true
    local_ub[l] = cand_u
    dc_propagate_temps(f, cand_temps, def_ii, local_nn, local_ub, call_nn, call_ub, $&tnn, $&tub, 4)
    $si := store_head
    while si >= 0 {
        sv := st_val[si]
        if !dc_is_self_load(f, def_cnt, def_ii, l, sv) {
            if !dc_val_nn(f, &tnn, sv) {
                local_nn[l] = false
                local_ub[l] = -1
                << false
            }
            if check_ub {
                su := dc_val_ub(f, &tub, sv)
                if su < 0 || su > cand_u {
                    local_nn[l] = false
                    local_ub[l] = -1
                    << false
                }
            }
        }
        si = st_next[si]
    }
    for i in 0:nn.len { nn[i] = tnn[i] }
    for i in 0:ub.len { ub[i] = tub[i] }
    << true
}

fn dc_compute_nn_ext(f &MFn, reach &[]bool, def_cnt &[]int, def_blk &[]int, def_ii &[]int, ext_p_nn &[]bool, ext_p_ub &[]int, call_nn &[]bool, call_ub &[]int, nn $&[]bool, ub $&[]int) {
    nt := f.temps.len
    nl := f.locals.len
    nb := f.blocks.len
    max_i := dc_max_int()
    $local_nn := []bool{}
    $local_ub := []int{}
    $l_bad := []bool{}
    $l_param_ok := []bool{}
    $l_store_head := []int{}
    $l_guard_head := []int{}
    $l_lo_gd_head := []int{}
    for l in 0:nl {
        local_nn.push(false)
        local_ub.push(-1)
        is_p := l < f.nparams
        l_bad.push(is_p || f.locals_nslots[l] != 1)
        l_param_ok.push(is_p && f.locals_nslots[l] == 1 && l < ext_p_nn.len && ext_p_nn[l])
        l_store_head.push(-1)
        l_guard_head.push(-1)
        l_lo_gd_head.push(-1)
    }
    $cand_temps := []int{}
    for t in 0:nt {
        ub.push(-1)
        if def_cnt[t] == 1 {
            k := f.instrs[def_ii[t]].kind
            if k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_SELECT || k == MI_BIN || k == MI_CALL {
                cand_temps.push(t)
            }
        }
    }
    $st_ii := []int{}
    $st_blk := []int{}
    $st_val := []int{}
    $st_next := []int{}
    $gd_blk := []int{}
    $gd_bnd := []int{}
    $gd_le := []bool{}
    $gd_next := []int{}
    $lg_blk := []int{}
    $lg_succ := []int{}
    $lg_min_one := []int{}
    $lg_is_ne0 := []bool{}
    $lg_next := []int{}
    for bi in 0:nb {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.kind == MI_ADDR && ins.b >= 0 && ins.b < nl {
                l_bad[ins.b] = true
                l_param_ok[ins.b] = false
            } else if ins.kind == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && ins.c != 0 {
                l_bad[ins.b] = true
                l_param_ok[ins.b] = false
            } else if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                if ins.c != 0 {
                    l_bad[ins.a] = true
                    l_param_ok[ins.a] = false
                } else {
                    st_ii.push(ii)
                    st_blk.push(bi)
                    st_val.push(ins.b)
                    st_next.push(l_store_head[ins.a])
                    l_store_head[ins.a] = st_ii.len - 1
                }
            }
            ii = ins.next
        }
        if f.blocks[bi].tkind == TKIND_BRANCH {
            cond := f.blocks[bi].ta
            if cond >= 0 && cond < nt && def_cnt[cond] == 1 && def_blk[cond] == bi {
                g_ii := def_ii[cond]
                g_ins := &f.instrs[g_ii]
                if g_ins.kind == MI_BIN && (g_ins.b == BIN_LT || g_ins.b == BIN_LE) {
                    cmp_t := g_ins.c
                    bnd_t := g_ins.d
                    if cmp_t >= 0 && cmp_t < nt && def_cnt[cmp_t] == 1 && def_blk[cmp_t] == bi {
                        cmp_ii := def_ii[cmp_t]
                        ci := &f.instrs[cmp_ii]
                        if ci.kind == MI_LOAD_LOCAL && ci.c == 0 && ci.b >= 0 && ci.b < nl {
                            gl := ci.b
                            gd_blk.push(bi)
                            gd_bnd.push(bnd_t)
                            gd_le.push(g_ins.b == BIN_LE)
                            gd_next.push(l_guard_head[gl])
                            l_guard_head[gl] = gd_blk.len - 1
                        }
                    }
                }
                if g_ins.kind == MI_BIN && g_ins.b >= BIN_EQ && g_ins.b <= BIN_GE {
                    $cop := g_ins.b
                    $var_t := -1
                    $c_t := -1
                    if g_ins.c >= 0 && g_ins.d <= -2 && (0 - g_ins.d - 2) < f.consts.len {
                        var_t = g_ins.c
                        c_t = g_ins.d
                    } else if g_ins.d >= 0 && g_ins.c <= -2 && (0 - g_ins.c - 2) < f.consts.len {
                        var_t = g_ins.d
                        c_t = g_ins.c
                        if cop == BIN_LT { cop = BIN_GT }
                        else if cop == BIN_LE { cop = BIN_GE }
                        else if cop == BIN_GT { cop = BIN_LT }
                        else if cop == BIN_GE { cop = BIN_LE }
                    }
                    if var_t >= 0 && var_t < nt && def_cnt[var_t] == 1 && def_blk[var_t] == bi && c_t <= -2 {
                        cv := f.consts[0 - c_t - 2]
                        ci_ii := def_ii[var_t]
                        ci := &f.instrs[ci_ii]
                        if ci.kind == MI_LOAD_LOCAL && ci.c == 0 && ci.b >= 0 && ci.b < nl && cv >= 0 && cv < max_i {
                            $succ := -1
                            $min_one := -1
                            $is_ne0 := false
                            if cop == BIN_NE && cv == 0 {
                                succ = f.blocks[bi].tb
                                min_one = 1
                                is_ne0 = true
                            } else if cop == BIN_EQ && cv == 0 {
                                succ = f.blocks[bi].tc
                                min_one = 1
                                is_ne0 = true
                            } else if cop == BIN_GT {
                                succ = f.blocks[bi].tb
                                min_one = cv + 1
                            } else if cop == BIN_LE {
                                succ = f.blocks[bi].tc
                                min_one = cv + 1
                            } else if cop == BIN_GE && cv >= 1 {
                                succ = f.blocks[bi].tb
                                min_one = cv
                            } else if cop == BIN_LT && cv >= 1 {
                                succ = f.blocks[bi].tc
                                min_one = cv
                            }
                            if succ >= 0 && succ < nb && min_one >= 1 {
                                lg_blk.push(bi)
                                lg_succ.push(succ)
                                lg_min_one.push(min_one)
                                lg_is_ne0.push(is_ne0)
                                lg_next.push(l_lo_gd_head[ci.b])
                                l_lo_gd_head[ci.b] = lg_blk.len - 1
                            }
                        }
                    }
                }
            }
        }
    }
    $active_locals := []int{}
    $active_params := []int{}
    for l in 0:nl {
        if !l_bad[l] && l_store_head[l] >= 0 {
            active_locals.push(l)
        } else if l_param_ok[l] {
            active_params.push(l)
        }
    }
    $store_mark := []int{}
    $init_mark := []int{}
    $vis_mark := []int{}
    for _ in 0:nb {
        store_mark.push(0)
        init_mark.push(0)
        vis_mark.push(0)
    }
    $mark_tag := 0
    $vis_tag := 0

    // Seed loads guarded by l < bnd_t along store-free dominating edges.
    for ti in 0:cand_temps.len {
        t := cand_temps[ti]
        tii := def_ii[t]
        ins := &f.instrs[tii]
        if ins.kind != MI_LOAD_LOCAL || ins.c != 0 || ins.b < 0 || ins.b >= nl { -> }
        l := ins.b
        if l_guard_head[l] < 0 { -> }
        tb := def_blk[t]
        $has_prior_st := false
        $pii := f.blocks[tb].head
        while pii >= 0 && pii != tii {
            pins := &f.instrs[pii]
            if pins.kind == MI_STORE_LOCAL && pins.a == l {
                has_prior_st = true
                <-
            }
            pii = pins.next
        }
        if has_prior_st { -> }
        mark_tag += 1
        $msi := l_store_head[l]
        while msi >= 0 {
            store_mark[st_blk[msi]] = mark_tag
            msi = st_next[msi]
        }
        $gi := l_guard_head[l]
        while gi >= 0 {
            gb := gd_blk[gi]
            if dc_val_nn(f, nn, gd_bnd[gi]) {
                bu := dc_val_ub(f, ub, gd_bnd[gi])
                is_le := gd_le[gi]
                if ((is_le && bu >= 0) || (!is_le && bu > 0)) && store_mark[gb] != mark_tag {
                    succ := f.blocks[gb].tb
                    vis_tag += 1
                    if dc_edge_dom_work(f, reach, gb, succ, tb, $&vis_mark, vis_tag) {
                        vis_tag += 1
                        if dc_path_no_store(f, succ, tb, gb, &store_mark, mark_tag, $&vis_mark, vis_tag) {
                            $u := bu
                            if !is_le { u = bu - 1 }
                            if ub[t] < 0 || u < ub[t] {
                                ub[t] = u
                            }
                        }
                    }
                }
            }
            gi = gd_next[gi]
        }
    }

    for _ in 0:6 {
        $nn_before := 0
        for t in 0:nt {
            if nn[t] { nn_before += 1 }
        }
        dc_propagate_temps(f, &cand_temps, def_ii, &local_nn, &local_ub, call_nn, call_ub, nn, ub, 6)
        for t in 0:nt {
            if nn[t] { nn_before -= 1 }
        }
        $chg := nn_before != 0

        // Check non-public parameters whose incoming value is non-negative and bounded.
        for pi in 0:active_params.len {
            p := active_params[pi]
            if local_nn[p] { -> }
            $all_id := true
            $si := l_store_head[p]
            while si >= 0 {
                if !dc_is_self_load(f, def_cnt, def_ii, p, st_val[si]) {
                    all_id = false
                    <-
                }
                si = st_next[si]
            }
            if all_id {
                local_nn[p] = true
                if p < ext_p_ub.len && ext_p_ub[p] >= 0 {
                    local_ub[p] = ext_p_ub[p]
                }
                chg = true
                ->
            }
            $proved_p := false
            $ext_u := -1
            if p < ext_p_ub.len { ext_u = ext_p_ub[p] }
            if ext_u >= 0 {
                $cand_u := ext_u
                $can_mod := true
                $si2 := l_store_head[p]
                while si2 >= 0 {
                    sv := st_val[si2]
                    if !dc_is_self_load(f, def_cnt, def_ii, p, sv) {
                        dv := dc_mod_pos_const(f, def_cnt, def_ii, sv)
                        if dv <= 0 {
                            can_mod = false
                            <-
                        }
                        if dv - 1 > cand_u { cand_u = dv - 1 }
                    }
                    si2 = st_next[si2]
                }
                if can_mod && dc_try_local_inv(f, &cand_temps, def_cnt, def_ii, $&local_nn, $&local_ub, call_nn, call_ub, nn, ub, p, cand_u, l_store_head[p], &st_val, &st_next, true) {
                    proved_p = true
                    chg = true
                }
                if !proved_p && dc_try_local_inv(f, &cand_temps, def_cnt, def_ii, $&local_nn, $&local_ub, call_nn, call_ub, nn, ub, p, ext_u, l_store_head[p], &st_val, &st_next, true) {
                    proved_p = true
                    chg = true
                }
            }
            if !proved_p && dc_try_local_inv(f, &cand_temps, def_cnt, def_ii, $&local_nn, $&local_ub, call_nn, call_ub, nn, ub, p, -1, l_store_head[p], &st_val, &st_next, false) {
                chg = true
            }
        }

        // Check locals whose only non-trivial store is a loop-bounded non-overflowing increment
        // or a modulo-bounded accumulator (v % pos_const).
        for ai in 0:active_locals.len {
            l := active_locals[ai]
            if !local_nn[l] {
                $all_ok := true
                $has_real := false
                $step_si := -1
                $max_su := -1
                $has_open_ub := false
                $si := l_store_head[l]
                while si >= 0 {
                    if dc_is_self_load(f, def_cnt, def_ii, l, st_val[si]) {
                        si = st_next[si]
                        ->
                    }
                    has_real = true
                    if !dc_val_nn(f, nn, st_val[si]) {
                        if step_si < 0 {
                            step_si = si
                        } else {
                            all_ok = false
                            <-
                        }
                    } else {
                        su := dc_val_ub(f, ub, st_val[si])
                        if su < 0 { has_open_ub = true }
                        else if su > max_su { max_su = su }
                    }
                    si = st_next[si]
                }
                if has_real && all_ok && step_si < 0 {
                    local_nn[l] = true
                    if !has_open_ub && max_su >= 0 {
                        local_ub[l] = max_su
                    }
                    chg = true
                    ->
                }
                if !all_ok || step_si >= 0 {
                    // Check inductive modulo/div accumulator invariant: non-divmod stores nonneg, mod/div stores % or / pos_const.
                    $cand_u := 0
                    $ok_mod := true
                    $has_mod := false
                    $has_ub := true
                    $only_self_div := true
                    $sm := l_store_head[l]
                    while sm >= 0 {
                        sv := st_val[sm]
                        dv := dc_mod_pos_const(f, def_cnt, def_ii, sv)
                        divv := dc_bin_pos_const(f, def_cnt, def_ii, sv, BIN_DIV)
                        if dv > 0 {
                            has_mod = true
                            only_self_div = false
                            if dv - 1 > cand_u { cand_u = dv - 1 }
                        } else if divv > 0 {
                            has_mod = true
                            // Pure shrinking div(load l, pos) cannot overflow even when initial upper bound is open.
                            $cur_d := sv
                            $d_self := false
                            for _ in 0:8 {
                                if cur_d >= 0 && cur_d < def_cnt.len && def_cnt[cur_d] == 1 {
                                    dii2 := def_ii[cur_d]
                                    d_ins := &f.instrs[dii2]
                                    if d_ins.kind == MI_BIN && d_ins.b == BIN_DIV {
                                        d_self = dc_is_self_load(f, def_cnt, def_ii, l, d_ins.c)
                                        <-
                                    } else if d_ins.kind == MI_COPY {
                                        cur_d = d_ins.b
                                    } else {
                                        <-
                                    }
                                } else {
                                    <-
                                }
                            }
                            if !d_self { only_self_div = false }
                        } else if !dc_is_self_load(f, def_cnt, def_ii, l, sv) {
                            if !dc_val_nn(f, nn, sv) {
                                ok_mod = false
                                <-
                            }
                            su := dc_val_ub(f, ub, sv)
                            if su < 0 {
                                has_ub = false
                            } else if su > cand_u {
                                cand_u = su
                            }
                        }
                        sm = st_next[sm]
                    }
                    if ok_mod && has_mod {
                        if has_ub && dc_try_local_inv(f, &cand_temps, def_cnt, def_ii, $&local_nn, $&local_ub, call_nn, call_ub, nn, ub, l, cand_u, l_store_head[l], &st_val, &st_next, true) {
                            chg = true
                            ->
                        } else if !has_ub && only_self_div && dc_try_local_inv(f, &cand_temps, def_cnt, def_ii, $&local_nn, $&local_ub, call_nn, call_ub, nn, ub, l, -1, l_store_head[l], &st_val, &st_next, false) {
                            chg = true
                            ->
                        }
                    }
                }
                if !all_ok || step_si < 0 { -> }
                sb := st_blk[step_si]
                sv := st_val[step_si]
                if sv < 0 || sv >= nt || def_cnt[sv] != 1 { -> }
                sv_ii := def_ii[sv]
                sins := &f.instrs[sv_ii]
                if sins.kind != MI_BIN || (sins.b != BIN_ADD && sins.b != BIN_SUB) || sins.c < 0 || sins.c >= nt || sins.d > -2 {
                    ->
                }
                step_k := f.consts[0 - sins.d - 2]
                if step_k < 1 || step_k > 65536 { -> }
                cur_t := sins.c
                if def_cnt[cur_t] != 1 { -> }
                ld_b := def_blk[cur_t]
                cur_ii := def_ii[cur_t]
                c_ins := &f.instrs[cur_ii]
                if c_ins.kind != MI_LOAD_LOCAL || c_ins.b != l || c_ins.c != 0 { -> }
                if sins.b == BIN_ADD {
                    if l_guard_head[l] < 0 { -> }
                    mark_tag += 1
                    $cnt_in_sb := 0
                    $msi := l_store_head[l]
                    while msi >= 0 {
                        mbi := st_blk[msi]
                        store_mark[mbi] = mark_tag
                        if dc_val_nn(f, nn, st_val[msi]) {
                            init_mark[mbi] = mark_tag
                        }
                        if mbi == sb { cnt_in_sb += 1 }
                        msi = st_next[msi]
                    }
                    if cnt_in_sb != 1 { -> }
                    $guarded := false
                    $gi := l_guard_head[l]
                    while gi >= 0 {
                        gb := gd_blk[gi]
                        bnd_t := gd_bnd[gi]
                        is_le := gd_le[gi]
                        $bnd_ok := step_k == 1 && !is_le
                        if !bnd_ok {
                            bu := dc_val_ub(f, ub, bnd_t)
                            if bu >= 0 && bu <= max_i - step_k { bnd_ok = true }
                        }
                        if bnd_ok {
                            succ := f.blocks[gb].tb
                            if ld_b == sb || (ld_b == succ && store_mark[ld_b] != mark_tag) {
                                vis_tag += 1
                                if dc_edge_dom_work(f, reach, gb, succ, sb, $&vis_mark, vis_tag) {
                                    vis_tag += 1
                                    if dc_path_no_store(f, succ, sb, gb, &store_mark, mark_tag, $&vis_mark, vis_tag) {
                                        vis_tag += 1
                                        if dc_local_init_dom(f, gb, &init_mark, mark_tag, $&vis_mark, vis_tag) {
                                            guarded = true
                                            <-
                                        }
                                    }
                                }
                            }
                        }
                        gi = gd_next[gi]
                    }
                    if guarded {
                        local_nn[l] = true
                        chg = true
                    }
                } else {
                    // Countdown induction: l -= step_k guarded by l >= step_k (or l != 0 when step_k == 1).
                    if l_lo_gd_head[l] < 0 { -> }
                    mark_tag += 1
                    $cnt_in_sb := 0
                    $init_ub := -1
                    $init_ok := true
                    $msi := l_store_head[l]
                    while msi >= 0 {
                        mbi := st_blk[msi]
                        store_mark[mbi] = mark_tag
                        if mbi == sb {
                            cnt_in_sb += 1
                        } else if !dc_is_self_load(f, def_cnt, def_ii, l, st_val[msi]) {
                            if dc_val_nn(f, nn, st_val[msi]) {
                                init_mark[mbi] = mark_tag
                                su := dc_val_ub(f, ub, st_val[msi])
                                if su < 0 {
                                    init_ok = false
                                } else if su > init_ub {
                                    init_ub = su
                                }
                            } else {
                                init_ok = false
                            }
                        }
                        msi = st_next[msi]
                    }
                    if cnt_in_sb != 1 || !init_ok || init_ub < 0 { -> }
                    $guarded := false
                    $gi := l_lo_gd_head[l]
                    while gi >= 0 {
                        gb := lg_blk[gi]
                        succ := lg_succ[gi]
                        min_one := lg_min_one[gi]
                        is_ne0 := lg_is_ne0[gi]
                        g_ok := min_one >= step_k && (!is_ne0 || step_k == 1)
                        if g_ok && (ld_b == sb || (ld_b == succ && store_mark[ld_b] != mark_tag)) {
                            vis_tag += 1
                            if dc_edge_dom_work(f, reach, gb, succ, sb, $&vis_mark, vis_tag) {
                                vis_tag += 1
                                if dc_path_no_store(f, succ, sb, gb, &store_mark, mark_tag, $&vis_mark, vis_tag) {
                                    vis_tag += 1
                                    if dc_local_init_dom(f, gb, &init_mark, mark_tag, $&vis_mark, vis_tag) {
                                        guarded = true
                                        <-
                                    }
                                }
                            }
                        }
                        gi = lg_next[gi]
                    }
                    if guarded {
                        local_nn[l] = true
                        local_ub[l] = init_ub
                        chg = true
                    }
                }
            }
        }
        if !chg {
            // Simultaneous optimistic non-negative fixpoint over mutually recursive locals.
            $cands := []int{}
            $try_loc := []bool{}
            $opt_loc := []bool{}
            for l in 0:nl {
                try_loc.push(false)
                opt_loc.push(local_nn[l])
            }
            for ai in 0:active_locals.len {
                l := active_locals[ai]
                if !local_nn[l] && l_store_head[l] >= 0 {
                    cands.push(l)
                    try_loc[l] = true
                    opt_loc[l] = true
                }
            }
            if cands.len > 1 {
                $tnn := []bool{}
                $tub := []int{}
                for _ in 0:nt {
                    tnn.push(false)
                    tub.push(-1)
                }
                $pruning := true
                while pruning {
                    pruning = false
                    for ti in 0:nt {
                        tnn[ti] = nn[ti]
                        tub[ti] = ub[ti]
                    }
                    for l in 0:nl {
                        opt_loc[l] = local_nn[l] || try_loc[l]
                    }
                    dc_propagate_temps(f, &cand_temps, def_ii, &opt_loc, &local_ub, call_nn, call_ub, $&tnn, $&tub, 6)
                    for ci in 0:cands.len {
                        l := cands[ci]
                        if !try_loc[l] { -> }
                        $si := l_store_head[l]
                        while si >= 0 {
                            sv := st_val[si]
                            if !dc_is_self_load(f, def_cnt, def_ii, l, sv) && !dc_val_nn(f, &tnn, sv) {
                                try_loc[l] = false
                                pruning = true
                                <-
                            }
                            si = st_next[si]
                        }
                    }
                }
                // Grounding check: each surviving local must be reachable from non-cyclic nn stores.
                $grd := []bool{}
                $gnn := []bool{}
                $gub := []int{}
                for l in 0:nl { grd.push(local_nn[l]) }
                for ti in 0:nt {
                    gnn.push(nn[ti])
                    gub.push(ub[ti])
                }
                for _ in 0:cands.len {
                    dc_propagate_temps(f, &cand_temps, def_ii, &grd, &local_ub, call_nn, call_ub, $&gnn, $&gub, 6)
                    $gprog := false
                    for ci in 0:cands.len {
                        l := cands[ci]
                        if try_loc[l] && !grd[l] {
                            $si := l_store_head[l]
                            while si >= 0 {
                                if !dc_is_self_load(f, def_cnt, def_ii, l, st_val[si]) && dc_val_nn(f, &gnn, st_val[si]) {
                                    grd[l] = true
                                    gprog = true
                                    <-
                                }
                                si = st_next[si]
                            }
                        }
                    }
                    if !gprog { <- }
                }
                for ci in 0:cands.len {
                    l := cands[ci]
                    if try_loc[l] && grd[l] {
                        local_nn[l] = true
                        chg = true
                    }
                }
                if chg {
                    dc_propagate_temps(f, &cand_temps, def_ii, &local_nn, &local_ub, call_nn, call_ub, nn, ub, 6)
                }
            }
        }
        if !chg { <- }
    }
}

fn dc_compute_nn(f &MFn, reach &[]bool, def_cnt &[]int, def_blk &[]int, def_ii &[]int, nn $&[]bool) {
    $ub := []int{}
    $ep_nn := []bool{}
    $ep_ub := []int{}
    $c_nn := []bool{}
    $c_ub := []int{}
    dc_compute_nn_ext(f, reach, def_cnt, def_blk, def_ii, &ep_nn, &ep_ub, &c_nn, &c_ub, nn, $&ub)
}

// Signed non-power-of-two magic modulo emits a sign-correction live chain (x, h, sg)
// that can push a 6-reg x64 leaf/frame-elidable function into a callee-saved spill,
// disabling can_elide_frame.
fn dc_x64_mod_spills_frame(f &MFn, reach &[]bool, target_bi int, target_ii int) bool {
    if f.nparams > 6 {
        << false
    }
    nl := f.locals.len
    nt := f.temps.len
    $ref_loc := []bool{}
    for l in 0:nl {
        if f.locals_nslots[l] != 1 {
            << false
        }
        ref_loc.push(l < f.nparams)
    }
    $def_bi := []int{}
    $last_use_bi := []int{}
    for _ in 0:nt {
        def_bi.push(-1)
        last_use_bi.push(-1)
    }
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_CALL || k == MI_CALL_IND || k == MI_ADDR {
                << false
            }
            if (k == MI_LOAD_LOCAL || k == MI_STORE_LOCAL) && ins.c != 0 {
                << false
            }
            if k == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl {
                ref_loc[ins.b] = true
            } else if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                ref_loc[ins.a] = true
            }
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                if def_bi[ins.a] == -1 { def_bi[ins.a] = bi }
                else if def_bi[ins.a] != bi { def_bi[ins.a] = -2 }
            }
            if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR {
                if ins.b >= 0 && ins.b < nt {
                    if last_use_bi[ins.b] == -1 { last_use_bi[ins.b] = bi }
                    else if last_use_bi[ins.b] != bi { last_use_bi[ins.b] = -2 }
                }
            } else if k == MI_STORE_PTR {
                if ins.a >= 0 && ins.a < nt { last_use_bi[ins.a] = -2 }
                if ins.b >= 0 && ins.b < nt { last_use_bi[ins.b] = -2 }
            } else if k == MI_UN {
                if ins.c >= 0 && ins.c < nt { last_use_bi[ins.c] = -2 }
            } else if k == MI_BIN || k == MI_SELECT {
                if k == MI_SELECT && ins.b >= 0 && ins.b < nt { last_use_bi[ins.b] = -2 }
                if ins.c >= 0 && ins.c < nt {
                    if last_use_bi[ins.c] == -1 { last_use_bi[ins.c] = bi }
                    else if last_use_bi[ins.c] != bi { last_use_bi[ins.c] = -2 }
                }
                if ins.d >= 0 && ins.d < nt {
                    if last_use_bi[ins.d] == -1 { last_use_bi[ins.d] = bi }
                    else if last_use_bi[ins.d] != bi { last_use_bi[ins.d] = -2 }
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if (tk == TKIND_RETURN || tk == TKIND_BRANCH) && f.blocks[bi].ta >= 0 && f.blocks[bi].ta < nt {
            last_use_bi[f.blocks[bi].ta] = -2
        }
    }
    $n_live := 0
    for l in 0:nl {
        if ref_loc[l] { n_live += 1 }
    }
    // Count distinct temps live strictly across target_ii inside target_bi.
    $before := []bool{}
    for _ in 0:nt { before.push(false) }
    $saw_target := false
    $ii := f.blocks[target_bi].head
    while ii >= 0 {
        ins := &f.instrs[ii]
        if ii == target_ii {
            saw_target = true
        } else if !saw_target {
            if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                before[ins.a] = true
            }
        } else {
            if ins.b >= 0 && ins.b < nt && (ins.kind == MI_COPY || ins.kind == MI_STORE_LOCAL || ins.kind == MI_LOAD_PTR) && before[ins.b] {
                n_live += 1
                before[ins.b] = false
            }
            if ins.c >= 0 && ins.c < nt && (ins.kind == MI_UN || ins.kind == MI_BIN || ins.kind == MI_SELECT) && before[ins.c] {
                n_live += 1
                before[ins.c] = false
            }
            if ins.d >= 0 && ins.d < nt && (ins.kind == MI_BIN || ins.kind == MI_SELECT) && before[ins.d] {
                n_live += 1
                before[ins.d] = false
            }
        }
        ii = ins.next
    }
    tk := f.blocks[target_bi].tkind
    if (tk == TKIND_RETURN || tk == TKIND_BRANCH) && f.blocks[target_bi].ta >= 0 && f.blocks[target_bi].ta < nt && before[f.blocks[target_bi].ta] {
        n_live += 1
        before[f.blocks[target_bi].ta] = false
    }
    for t in 0:nt {
        if before[t] && (last_use_bi[t] == -2 || (last_use_bi[t] >= 0 && last_use_bi[t] != target_bi)) {
            n_live += 1
        }
    }
    << n_live >= 4
}

fn dc_collect_defs(f &MFn, reach &[]bool, def_cnt $&[]int, def_blk $&[]int, def_ii $&[]int) {
    nt := f.temps.len
    for _ in 0:nt {
        def_cnt.push(0)
        def_blk.push(-1)
        def_ii.push(-1)
    }
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                def_cnt[ins.a] = def_cnt[ins.a] + 1
                def_blk[ins.a] = bi
                def_ii[ins.a] = ii
            }
            ii = ins.next
        }
    }
}

fn dc_compute_return_bounds(f &MFn, reach &[]bool, nn &[]bool, ub &[]int, out_nn $&bool, out_ub $&int) {
    *out_nn = false
    *out_ub = -1
    if f.ret_nslots != 1 || f.blocks.len == 0 {
        <<
    }
    $n_ret := 0
    $max_u := -1
    $has_open := false
    for bi in 0:f.blocks.len {
        if !reach[bi] || f.blocks[bi].tkind != TKIND_RETURN { -> }
        v := f.blocks[bi].ta
        if !dc_val_nn(f, nn, v) {
            <<
        }
        n_ret += 1
        u := dc_val_ub(f, ub, v)
        if u < 0 {
            has_open = true
        } else if u > max_u {
            max_u = u
        }
    }
    if n_ret > 0 {
        *out_nn = true
        if !has_open {
            *out_ub = max_u
        }
    }
}

fn dc_count_args(f &MFn, ii int) int {
    $argc := 0
    $ai := f.instrs[ii].c
    while ai >= 0 && ai < f.margs.len {
        argc += 1
        ai = f.margs[ai].next
    }
    << argc
}

fn opt_divc_fn(f $&MFn, mulh bool, tight_x64 bool, ext_p_nn &[]bool, ext_p_ub &[]int, call_nn &[]bool, call_ub &[]int) bool {
    if !mulh {
        << false
    }
    $has_divc := false
    for ii in 0:f.instrs.len {
        ins := &f.instrs[ii]
        if !fold_known_kind(ins.kind) {
            << false
        }
        if ins.kind == MI_BIN && (ins.b == BIN_DIV || ins.b == BIN_MOD) && ins.c >= 0 && ins.d <= -2 && f.consts[0 - ins.d - 2] != 0 {
            has_divc = true
        }
    }
    if !has_divc {
        << false
    }
    nt := f.temps.len
    reach := dc_reach(f)
    $def_cnt := []int{}
    $def_blk := []int{}
    $def_ii := []int{}
    dc_collect_defs(f, &reach, $&def_cnt, $&def_blk, $&def_ii)
    $addr_taken := []bool{}
    for _ in 0:f.locals.len { addr_taken.push(false) }
    for ii in 0:f.instrs.len {
        if f.instrs[ii].kind == MI_ADDR && f.instrs[ii].b >= 0 && f.instrs[ii].b < addr_taken.len {
            addr_taken[f.instrs[ii].b] = true
        }
    }
    $nn := []bool{}
    for _ in 0:nt { nn.push(false) }
    $ub := []int{}
    dc_compute_nn_ext(f, &reach, &def_cnt, &def_blk, &def_ii, ext_p_nn, ext_p_ub, call_nn, call_ub, $&nn, $&ub)
    $changed := false
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $order := []int{}
        $hit := false
        // Known quotients: ck_q[j] holds ck_x[j] / ck_d[j].
        $ck_x := []int{}
        $ck_d := []int{}
        $ck_q := []int{}
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            nx := ins.next
            $q := -1
            $done := false
            if ins.kind == MI_BIN && (ins.b == BIN_DIV || ins.b == BIN_MOD) && ins.c >= 0 && ins.d <= -2 && f.consts[0 - ins.d - 2] != 0 {
                dv := f.consts[0 - ins.d - 2]
                dk := dc_log2(dv)
                if ins.b == BIN_MOD && dk > 0 && dk < 63 && dc_mod_zero_cmp_only(f, &reach, &def_cnt, ins.a) {
                    f.instrs[ii].b = BIN_AND
                    f.instrs[ii].d = alloc_const(f, (1 << dk) - 1)
                    changed = true
                } else {
                    $cq := -1
                    for j in 0:ck_x.len {
                        if ck_x[j] == ins.c && ck_d[j] == dv {
                            cq = ck_q[j]
                        }
                    }
                    $is_nn := dc_val_nn(f, &nn, ins.c) || dc_guarded_nn(f, &reach, &def_cnt, &def_blk, &def_ii, &addr_taken, bi, ins.c)
                    if !is_nn && ins.b == BIN_DIV && dv > 0 && dk > 0 && dk < 63 &&
                       dc_guarded_pow2_div(f, &reach, &def_cnt, &def_blk, &def_ii, &addr_taken, bi, ins.c, dk) {
                        is_nn = true
                    }
                    $skip_x64 := tight_x64 && !is_nn && ins.b == BIN_MOD && dv > 0 && dk <= 0 && dc_x64_mod_spills_frame(f, &reach, bi, ii)
                    if !skip_x64 {
                        r := dc_expand(f, &ins, $&order, cq, is_nn)
                        if r != -2 {
                            f.instrs[ii].kind = MI_NOP
                            f.instrs[ii].next = -1
                            hit = true
                            done = true
                            q = r
                        }
                    }
                }
            }
            if !done {
                order.push(ii)
            }
            // A redefinition invalidates the quotients it touches.
            if fold_defines(ins.kind) && ins.a >= 0 {
                $nx_x := []int{}
                $nx_d := []int{}
                $nx_q := []int{}
                for j in 0:ck_x.len {
                    if ck_x[j] != ins.a && ck_q[j] != ins.a {
                        nx_x.push(ck_x[j])
                        nx_d.push(ck_d[j])
                        nx_q.push(ck_q[j])
                    }
                }
                ck_x = ~nx_x
                ck_d = ~nx_d
                ck_q = ~nx_q
            }
            if q >= 0 && ins.c != ins.a {
                ck_x.push(ins.c)
                ck_d.push(f.consts[0 - ins.d - 2])
                ck_q.push(q)
            }
            ii = nx
        }
        if hit {
            for oi in 0:order.len {
                if oi + 1 < order.len {
                    f.instrs[order[oi]].next = order[oi + 1]
                } else {
                    f.instrs[order[oi]].next = -1
                }
            }
            if order.len > 0 {
                f.blocks[bi].head = order[0]
                f.blocks[bi].tail = order[order.len - 1]
            } else {
                f.blocks[bi].head = -1
                f.blocks[bi].tail = -1
            }
            changed = true
        }
    }
    << changed
}

// Rewrites div/mod of a temp by a nonzero constant across a unit, propagating
// caller-proven non-negative parameter bounds to non-public callees and keeping
// signed non-power-of-2 modulo from breaking x64 frame elision.
pub fn opt_divc_unit(unit $&Mir, mulh bool, tight_x64 bool) []bool {
    nf := unit.fns.len
    $res := []bool{}
    for _ in 0:nf { res.push(false) }
    if !mulh || nf == 0 {
        << res
    }
    $li := label_index_new(nf)
    $known_ok := []bool{}
    $has_divc := []bool{}
    $escaped := []bool{}
    $fn_ret_nn := []bool{}
    $fn_ret_ub := []int{}
    $param_off := []int{}
    $tot_params := 0
    for fi in 0:nf {
        f := &unit.fns[fi]
        li.put(&unit.fns[fi].label, fi)
        known_ok.push(true)
        has_divc.push(false)
        $esc := f.is_pub || f.is_extern || f.receiver || !f.scalar_params || f.ret_nslots != 1 || f.blocks.len == 0 || f.nparams <= 0 || f.locals.len < f.nparams || f.param_locals.len != f.nparams || f.label == "_xu_main" || f.label == "main"
        if !esc {
            for pi in 0:f.nparams {
                if f.param_locals[pi] != pi {
                    esc = true
                    <-
                }
            }
        }
        escaped.push(esc)
        fn_ret_nn.push(false)
        fn_ret_ub.push(-1)
        param_off.push(tot_params)
        tot_params += f.nparams
    }
    $any_divc := false
    for fi in 0:nf {
        f := &unit.fns[fi]
        for ii in 0:f.instrs.len {
            ins := &f.instrs[ii]
            k := ins.kind
            if !fold_known_kind(k) {
                known_ok[fi] = false
            }
            if k == MI_BIN && (ins.b == BIN_DIV || ins.b == BIN_MOD) && ins.c >= 0 && ins.d <= -2 && f.consts[0 - ins.d - 2] != 0 {
                has_divc[fi] = true
                any_divc = true
            }
            if k != MI_CALL && ins.sval.len > 0 {
                gi := li.get(&unit.fns[fi].instrs[ii].sval)
                if gi >= 0 {
                    escaped[gi] = true
                }
            }
        }
    }
    if !any_divc {
        << res
    }
    $ipo_target := []bool{}
    $need_nn := []bool{}
    $any_ipo := false
    for fi in 0:nf {
        t := !escaped[fi] && has_divc[fi] && known_ok[fi]
        ipo_target.push(t)
        need_nn.push(has_divc[fi] && known_ok[fi])
        if t { any_ipo = true }
    }
    $param_nn := []bool{}
    $param_ub := []int{}
    $param_seen := []bool{}
    for _ in 0:tot_params {
        param_nn.push(false)
        param_ub.push(-1)
        param_seen.push(false)
    }
    if any_ipo {
        // Identify callers of ipo_target functions and filter out self-calls / bad arity.
        for fi in 0:nf {
            f := &unit.fns[fi]
            $calls_t := false
            for ii in 0:f.instrs.len {
                if f.instrs[ii].kind == MI_CALL {
                    gi := li.get(&f.instrs[ii].sval)
                    if gi >= 0 && ipo_target[gi] {
                        calls_t = true
                        <-
                    }
                }
            }
            if !calls_t { -> }
            if !known_ok[fi] {
                for ii in 0:f.instrs.len {
                    if f.instrs[ii].kind == MI_CALL {
                        gi := li.get(&f.instrs[ii].sval)
                        if gi >= 0 && ipo_target[gi] {
                            ipo_target[gi] = false
                        }
                    }
                }
                ->
            }
            reach := dc_reach(f)
            $used_caller := false
            for bi in 0:f.blocks.len {
                if !reach[bi] { -> }
                $ii := f.blocks[bi].head
                while ii >= 0 {
                    if f.instrs[ii].kind == MI_CALL {
                        gi := li.get(&f.instrs[ii].sval)
                        if gi >= 0 && ipo_target[gi] {
                            if gi == fi || dc_count_args(f, ii) != unit.fns[gi].nparams {
                                ipo_target[gi] = false
                            } else {
                                used_caller = true
                            }
                        }
                    }
                    ii = f.instrs[ii].next
                }
            }
            if used_caller {
                need_nn[fi] = true
            }
        }
        // Propagate caller -> callee parameter bounds and callee -> caller return bounds.
        for _ in 0:2 {
            $next_nn := []bool{}
            $next_ub := []int{}
            $next_seen := []bool{}
            for _ in 0:tot_params {
                next_nn.push(false)
                next_ub.push(-1)
                next_seen.push(false)
            }
            for fi in 0:nf {
                if !need_nn[fi] || !known_ok[fi] { -> }
                f := &unit.fns[fi]
                nt := f.temps.len
                reach := dc_reach(f)
                $def_cnt := []int{}
                $def_blk := []int{}
                $def_ii := []int{}
                dc_collect_defs(f, &reach, $&def_cnt, $&def_blk, $&def_ii)
                $ep_nn := []bool{}
                $ep_ub := []int{}
                if ipo_target[fi] {
                    off := param_off[fi]
                    for pi in 0:f.nparams {
                        ep_nn.push(param_nn[off + pi])
                        ep_ub.push(param_ub[off + pi])
                    }
                }
                $c_nn := []bool{}
                $c_ub := []int{}
                $has_ret_call := false
                for bi in 0:f.blocks.len {
                    if !reach[bi] { -> }
                    $ii := f.blocks[bi].head
                    while ii >= 0 {
                        if f.instrs[ii].kind == MI_CALL {
                            gi := li.get(&f.instrs[ii].sval)
                            if gi >= 0 && fn_ret_nn[gi] {
                                has_ret_call = true
                                <-
                            }
                        }
                        ii = f.instrs[ii].next
                    }
                    if has_ret_call { <- }
                }
                if has_ret_call {
                    for _ in 0:f.instrs.len {
                        c_nn.push(false)
                        c_ub.push(-1)
                    }
                    for bi in 0:f.blocks.len {
                        if !reach[bi] { -> }
                        $ii := f.blocks[bi].head
                        while ii >= 0 {
                            if f.instrs[ii].kind == MI_CALL {
                                gi := li.get(&f.instrs[ii].sval)
                                if gi >= 0 && fn_ret_nn[gi] {
                                    c_nn[ii] = true
                                    c_ub[ii] = fn_ret_ub[gi]
                                }
                            }
                            ii = f.instrs[ii].next
                        }
                    }
                }
                $nn := []bool{}
                for _ in 0:nt { nn.push(false) }
                $ub := []int{}
                dc_compute_nn_ext(f, &reach, &def_cnt, &def_blk, &def_ii, &ep_nn, &ep_ub, &c_nn, &c_ub, $&nn, $&ub)
                $rnn := false
                $rub := -1
                dc_compute_return_bounds(f, &reach, &nn, &ub, $&rnn, $&rub)
                if rnn {
                    fn_ret_nn[fi] = true
                    fn_ret_ub[fi] = rub
                }
                for bi in 0:f.blocks.len {
                    if !reach[bi] { -> }
                    $ii := f.blocks[bi].head
                    while ii >= 0 {
                        if f.instrs[ii].kind == MI_CALL {
                            gi := li.get(&f.instrs[ii].sval)
                            if gi >= 0 && ipo_target[gi] {
                                goff := param_off[gi]
                                $ai := f.instrs[ii].c
                                $pi := 0
                                while ai >= 0 && ai < f.margs.len && pi < unit.fns[gi].nparams {
                                    idx := goff + pi
                                    av := f.margs[ai].v
                                    ann := dc_val_nn(f, &nn, av)
                                    $aub := -1
                                    if ann { aub = dc_val_ub(f, &ub, av) }
                                    if !next_seen[idx] {
                                        next_seen[idx] = true
                                        next_nn[idx] = ann
                                        next_ub[idx] = aub
                                    } else {
                                        if !ann {
                                            next_nn[idx] = false
                                            next_ub[idx] = -1
                                        } else if next_nn[idx] {
                                            if aub < 0 || next_ub[idx] < 0 {
                                                next_ub[idx] = -1
                                            } else if aub > next_ub[idx] {
                                                next_ub[idx] = aub
                                            }
                                        }
                                    }
                                    pi += 1
                                    ai = f.margs[ai].next
                                }
                            }
                        }
                        ii = f.instrs[ii].next
                    }
                }
            }
            for k in 0:tot_params {
                if next_seen[k] {
                    param_nn[k] = next_nn[k]
                    param_ub[k] = next_ub[k]
                }
            }
        }
    }
    for fi in 0:nf {
        if !has_divc[fi] || !known_ok[fi] { -> }
        f := $&unit.fns[fi]
        $ep_nn := []bool{}
        $ep_ub := []int{}
        if ipo_target[fi] {
            off := param_off[fi]
            for pi in 0:f.nparams {
                ep_nn.push(param_nn[off + pi])
                ep_ub.push(param_ub[off + pi])
            }
        }
        $c_nn := []bool{}
        $c_ub := []int{}
        $has_ret_call := false
        for ii in 0:f.instrs.len {
            if f.instrs[ii].kind == MI_CALL {
                gi := li.get(&f.instrs[ii].sval)
                if gi >= 0 && fn_ret_nn[gi] {
                    has_ret_call = true
                    <-
                }
            }
        }
        if has_ret_call {
            for _ in 0:f.instrs.len {
                c_nn.push(false)
                c_ub.push(-1)
            }
            for ii in 0:f.instrs.len {
                if f.instrs[ii].kind == MI_CALL {
                    gi := li.get(&f.instrs[ii].sval)
                    if gi >= 0 && fn_ret_nn[gi] {
                        c_nn[ii] = true
                        c_ub[ii] = fn_ret_ub[gi]
                    }
                }
            }
        }
        res[fi] = opt_divc_fn(f, mulh, tight_x64, &ep_nn, &ep_ub, &c_nn, &c_ub)
    }
    << res
}

// Rewrites div/mod of a temp by a nonzero constant; true when anything
// changed. mulh: the target backend implements BIN_MULH on 64-bit words.
// Within a block a quotient x / d is reused by a later div or mod of the
// same x by the same d while neither x nor the quotient temp is redefined.
pub fn opt_divc(f $&MFn, mulh bool) bool {
    $ep_nn := []bool{}
    $ep_ub := []int{}
    $c_nn := []bool{}
    $c_ub := []int{}
    << opt_divc_fn(f, mulh, false, &ep_nn, &ep_ub, &c_nn, &c_ub)
}
