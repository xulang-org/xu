@xu/mir
// Integer division and remainder by a constant without a divide
// instruction (Hacker's Delight chapter 10, signed, 64-bit words).
//
// MI_BIN BIN_DIV / BIN_MOD are sdiv semantics on 64-bit words: the
// quotient truncates toward zero and the remainder has the dividend's
// sign. Narrow integer types are normalised words before and after
// (wrap_int), so rewriting the word operation is exact for them too.
// BIN_SHR is an arithmetic shift. For a temp x and a constant d:
//   d == 1:   q = x                  r = 0
//   d == -1:  q = 0 - x              r = 0
//   |d| == 2^k, k >= 1 (d == MIN is k = 63):
//     s = x >> 63; b = s & (2^k - 1); t = x + b
//     q = t >> k, negated when d < 0;  r = x - (t & -2^k)
//   otherwise, with (m, sh) = dc_magic(d):
//     h = mulh x, m; h = h + x when d > 0 && m < 0;
//     h = h - x when d < 0 && m > 0; h = h >> sh
//     q = h - (h >> 63);  r = x - q * d
// BIN_MULH (high word of the signed 128-bit product) exists only in
// backends that implement it, and the shift forms assume 64-bit words:
// with mulh false the pass does nothing.

fn dc_min() int {
    m := 1 << 63
    << m
}

// a < b as unsigned 64-bit values.
fn dc_ult(a int, b int) bool {
    m := dc_min()
    << (a ^ m) < (b ^ m)
}

// Unsigned n / d into qr[0] and n % d into qr[1], d != 0, by
// shift-subtract. r < d (unsigned) holds before each step, so a set top
// bit before the shift means 2r + bit >= 2^64 > d.
fn dc_udivmod(n int, d int, qr $&[]int) {
    $q := 0
    $r := 0
    $i := 63
    while i >= 0 {
        top := r < 0
        r = (r << 1) | ((n >> i) & 1)
        if top || !dc_ult(r, d) {
            r = r - d
            q = q | (1 << i)
        }
        i -= 1
    }
    qr[0] = q
    qr[1] = r
}

// High 64 bits of the signed 128-bit product a * b.
fn dc_mulhs(a int, b int) int {
    lo := 0xffffffff
    a0 := a & lo
    a1 := (a >> 32) & lo
    b0 := b & lo
    b1 := (b >> 32) & lo
    p00 := a0 * b0
    p01 := a0 * b1
    p10 := a1 * b0
    p11 := a1 * b1
    mid := ((p00 >> 32) & lo) + (p01 & lo) + (p10 & lo)
    $hi := p11 + ((p01 >> 32) & lo) + ((p10 >> 32) & lo) + (mid >> 32)
    if a < 0 {
        hi = hi - b
    }
    if b < 0 {
        hi = hi - a
    }
    << hi
}

// Magic multiplier mr[0] and shift mr[1] for signed division by d,
// 2 <= |d| < 2^63 (Hacker's Delight figure 10-1 at 64 bits; ad, anc,
// delta, q1, r1, q2, r2 and t are unsigned). mr[1] = -1 on failure.
fn dc_magic(d int, mr $&[]int) {
    mr[0] = 0
    mr[1] = -1
    two63 := dc_min()
    $ad := d
    $t := two63
    if d < 0 {
        ad = 0 - d
        t = two63 + 1
    }
    if ad < 2 {
        <<
    }
    $qr := []int{}
    qr.push(0)
    qr.push(0)
    dc_udivmod(t, ad, $&qr)
    anc := t - 1 - qr[1]
    dc_udivmod(two63, anc, $&qr)
    $q1 := qr[0]
    $r1 := qr[1]
    dc_udivmod(two63, ad, $&qr)
    $q2 := qr[0]
    $r2 := qr[1]
    $p := 63
    $done := false
    for _ in 0:70 {
        p += 1
        q1 = q1 << 1
        r1 = r1 << 1
        if !dc_ult(r1, anc) {
            q1 += 1
            r1 = r1 - anc
        }
        q2 = q2 << 1
        r2 = r2 << 1
        if !dc_ult(r2, ad) {
            q2 += 1
            r2 = r2 - ad
        }
        delta := ad - r2
        if !(dc_ult(q1, delta) || (q1 == delta && r1 == 0)) {
            done = true
            <-
        }
    }
    if !done || p - 64 < 0 || p - 64 > 63 {
        <<
    }
    $m := q2 + 1
    if d < 0 {
        m = 0 - m
    }
    mr[0] = m
    mr[1] = p - 64
}

// k when |v| == 2^k with k >= 1 (MIN gives 63), else -1.
fn dc_log2(v int) int {
    if v == dc_min() {
        << 63
    }
    $a := v
    if a < 0 {
        a = 0 - a
    }
    << fold_log2(a)
}

fn dc_put(f $&MFn, out $&[]int, src &MInstr, kind int, a int, b int, c int, d int) {
    $ins := minstr_new(kind)
    ins.a = a
    ins.b = b
    ins.c = c
    ins.d = d
    ins.line = src.line
    ins.col = src.col
    ins.file = src.file
    out.push(f.instrs.len)
    f.instrs.push(ins)
}

// New temp = x op y.
fn dc_op(f $&MFn, out $&[]int, src &MInstr, op int, x int, y int) int {
    t := alloc_temp(f)
    dc_put(f, out, src, MI_BIN, t, op, x, y)
    << t
}

// The original destination = x op y.
fn dc_fin(f $&MFn, out $&[]int, src &MInstr, op int, x int, y int) {
    dc_put(f, out, src, MI_BIN, src.a, op, x, y)
}

// Appends the replacement of src (div/mod of temp x by a nonzero
// constant d) to out. Returns -2 when it keeps the division, else the
// temp holding the quotient x / d afterwards (-1 when none does). cq >= 0
// is a temp already holding x / d in this block (same x, same d).
fn dc_expand(f $&MFn, src &MInstr, out $&[]int, cq int) int {
    x := src.c
    d := f.consts[0 - src.d - 2]
    is_div := src.b == BIN_DIV
    if d == 1 || d == -1 {
        if !is_div {
            dc_put(f, out, src, MI_COPY, src.a, alloc_const(f, 0), -1, -1)
        } else if d == 1 {
            dc_put(f, out, src, MI_COPY, src.a, x, -1, -1)
        } else {
            dc_fin(f, out, src, BIN_SUB, alloc_const(f, 0), x)
        }
        << -1
    }
    if cq >= 0 {
        if is_div {
            dc_put(f, out, src, MI_COPY, src.a, cq, -1, -1)
            << src.a
        }
        p := dc_op(f, out, src, BIN_MUL, cq, alloc_const(f, d))
        dc_fin(f, out, src, BIN_SUB, x, p)
        << cq
    }
    k := dc_log2(d)
    if k > 0 {
        // b = 2^k - 1 for negative x, else 0: t = x + b makes the shift
        // round toward zero.
        s := dc_op(f, out, src, BIN_SHR, x, alloc_const(f, 63))
        b := dc_op(f, out, src, BIN_AND, s, alloc_const(f, (1 << k) - 1))
        t := dc_op(f, out, src, BIN_ADD, x, b)
        if !is_div {
            m := dc_op(f, out, src, BIN_AND, t, alloc_const(f, 0 - (1 << k)))
            dc_fin(f, out, src, BIN_SUB, x, m)
            << -1
        }
        if d > 0 {
            dc_fin(f, out, src, BIN_SHR, t, alloc_const(f, k))
        } else {
            q := dc_op(f, out, src, BIN_SHR, t, alloc_const(f, k))
            dc_fin(f, out, src, BIN_SUB, alloc_const(f, 0), q)
        }
        << src.a
    }
    $mr := []int{}
    mr.push(0)
    mr.push(0 - 1)
    dc_magic(d, $&mr)
    m := mr[0]
    sh := mr[1]
    if sh < 0 {
        << -2
    }
    $h := dc_op(f, out, src, BIN_MULH, x, alloc_const(f, m))
    if d > 0 && m < 0 {
        h = dc_op(f, out, src, BIN_ADD, h, x)
    }
    if d < 0 && m > 0 {
        h = dc_op(f, out, src, BIN_SUB, h, x)
    }
    if sh > 0 {
        h = dc_op(f, out, src, BIN_SHR, h, alloc_const(f, sh))
    }
    sg := dc_op(f, out, src, BIN_SHR, h, alloc_const(f, 63))
    if is_div {
        dc_fin(f, out, src, BIN_SUB, h, sg)
        << src.a
    }
    q := dc_op(f, out, src, BIN_SUB, h, sg)
    p := dc_op(f, out, src, BIN_MUL, q, alloc_const(f, d))
    dc_fin(f, out, src, BIN_SUB, x, p)
    << q
}

// Rewrites div/mod of a temp by a nonzero constant; true when anything
// changed. mulh: the target backend implements BIN_MULH on 64-bit words.
// Within a block a quotient x / d is reused by a later div or mod of the
// same x by the same d while neither x nor the quotient temp is redefined.
pub fn opt_divc(f $&MFn, mulh bool) bool {
    if !mulh {
        << false
    }
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            << false
        }
    }
    $changed := false
    for bi in 0:f.blocks.len {
        $order := []int{}
        $hit := false
        // Known quotients: ck_q[j] holds ck_x[j] / ck_d[j].
        $ck_x := []int{}
        $ck_d := []int{}
        $ck_q := []int{}
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            nx := ins.next
            $q := -1
            $done := false
            if ins.kind == MI_BIN && (ins.b == BIN_DIV || ins.b == BIN_MOD) && ins.c >= 0 && ins.d <= -2 && f.consts[0 - ins.d - 2] != 0 {
                dv := f.consts[0 - ins.d - 2]
                $cq := -1
                for j in 0:ck_x.len {
                    if ck_x[j] == ins.c && ck_d[j] == dv {
                        cq = ck_q[j]
                    }
                }
                r := dc_expand(f, &ins, $&order, cq)
                if r != -2 {
                    f.instrs[ii].kind = MI_NOP
                    f.instrs[ii].next = -1
                    hit = true
                    done = true
                    q = r
                }
            }
            if !done {
                order.push(ii)
            }
            // A redefinition invalidates the quotients it touches.
            if fold_defines(ins.kind) && ins.a >= 0 {
                $nx_x := []int{}
                $nx_d := []int{}
                $nx_q := []int{}
                for j in 0:ck_x.len {
                    if ck_x[j] != ins.a && ck_q[j] != ins.a {
                        nx_x.push(ck_x[j])
                        nx_d.push(ck_d[j])
                        nx_q.push(ck_q[j])
                    }
                }
                ck_x = ~nx_x
                ck_d = ~nx_d
                ck_q = ~nx_q
            }
            if q >= 0 && ins.c != ins.a {
                ck_x.push(ins.c)
                ck_d.push(f.consts[0 - ins.d - 2])
                ck_q.push(q)
            }
            ii = nx
        }
        if hit {
            for oi in 0:order.len {
                if oi + 1 < order.len {
                    f.instrs[order[oi]].next = order[oi + 1]
                } else {
                    f.instrs[order[oi]].next = -1
                }
            }
            if order.len > 0 {
                f.blocks[bi].head = order[0]
                f.blocks[bi].tail = order[order.len - 1]
            } else {
                f.blocks[bi].head = -1
                f.blocks[bi].tail = -1
            }
            changed = true
        }
    }
    << changed
}
