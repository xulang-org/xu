@xu/mir
// Constant folding, algebraic simplification, and copy propagation pass.
//
// Layer 3 module: simplifies constant expressions, prunes dead conditional
// branches, propagates known constants, performs store-to-load forwarding,
// and eliminates multi-step algebraic identity cancellation chains.

fn resolve_val(v int, copy_map &[]int, temp_const &[]int) int {
    $cur := v
    for _ in 0:16 {
        if cur >= 0 && cur < temp_const.len && temp_const[cur] <= -2 {
            << temp_const[cur]
        }
        if cur >= 0 && cur < copy_map.len && copy_map[cur] >= 0 {
            cur = copy_map[cur]
        } else {
            << cur
        }
    }
    << cur
}

pub fn opt_const_fold(mfn $&MFn) {
    if mfn.instrs.len == 0 {
        <<
    }

    // Map temp -> constant id (or -1 if not constant)
    $temp_const := []int{}
    for i in 0:mfn.temps.len {
        temp_const.push(-1)
    }

    // 1. Fold instructions across basic blocks with Store-to-Load forwarding
    for _ in 0:2 {
        for bi in 0:mfn.blocks.len {
            $local_val := []int{}
            for _ in 0:mfn.locals.len {
                local_val.push(-1)
            }
            $last_def := []int{}
            $copy_map := []int{}
            for _ in 0:mfn.temps.len {
                last_def.push(-1)
                copy_map.push(-1)
            }

            $ii := mfn.blocks[bi].head
            while ii >= 0 && ii < mfn.instrs.len {
                $ins := ~mfn.instrs[ii]
                if ins.kind == MI_STORE_LOCAL {
                    loc := ins.a
                    src := resolve_val(ins.b, &copy_map, &temp_const)
                    if loc >= 0 && loc < local_val.len {
                        local_val[loc] = src
                    }
                } else if ins.kind == MI_LOAD_LOCAL {
                    loc := ins.b
                    if loc >= 0 && loc < local_val.len {
                        if local_val[loc] != -1 {
                            known := resolve_val(local_val[loc], &copy_map, &temp_const)
                            ins.kind = MI_COPY
                            ins.b = known
                            mfn.instrs[ii] = ~ins
                            if ins.a >= 0 && ins.a < copy_map.len {
                                copy_map[ins.a] = known
                            }
                            if ins.a >= 0 && ins.a < temp_const.len && known <= -2 {
                                temp_const[ins.a] = known
                            }
                        } else {
                            local_val[loc] = ins.a
                        }
                    }
                } else if ins.kind == MI_CALL {
                    for li in 0:local_val.len {
                        local_val[li] = -1
                    }
                } else if ins.kind == MI_COPY {
                    ins.b = resolve_val(ins.b, &copy_map, &temp_const)
                    if ins.b <= -2 {
                        if ins.a >= 0 && ins.a < temp_const.len {
                            temp_const[ins.a] = ins.b
                        }
                    } else if ins.a >= 0 && ins.a < copy_map.len {
                        copy_map[ins.a] = ins.b
                    }
                    mfn.instrs[ii] = ~ins
                } else if ins.kind == MI_BIN {
                    ins.c = resolve_val(ins.c, &copy_map, &temp_const)
                    ins.d = resolve_val(ins.d, &copy_map, &temp_const)

                    // Both operands are compile-time constants: fold them!
                    if ins.c <= -2 && ins.d <= -2 {
                        c1_idx := 0 - ins.c - 2
                        c2_idx := 0 - ins.d - 2
                        if c1_idx >= 0 && c1_idx < mfn.consts.len && c2_idx >= 0 && c2_idx < mfn.consts.len {
                            c1 := mfn.consts[c1_idx]
                            c2 := mfn.consts[c2_idx]
                            $folded := false
                            $res := 0
                            if ins.b == BIN_ADD {
                                res = c1 + c2
                                folded = true
                            } else if ins.b == BIN_SUB {
                                res = c1 - c2
                                folded = true
                            } else if ins.b == BIN_MUL {
                                res = c1 * c2
                                folded = true
                            } else if ins.b == BIN_DIV {
                                if c2 != 0 {
                                    res = c1 / c2
                                    folded = true
                                }
                            } else if ins.b == BIN_AND {
                                res = c1 & c2
                                folded = true
                            } else if ins.b == BIN_OR {
                                res = c1 | c2
                                folded = true
                            } else if ins.b == BIN_EQ {
                                if c1 == c2 { res = 1 } else { res = 0 }
                                folded = true
                            } else if ins.b == BIN_NE {
                                if c1 != c2 { res = 1 } else { res = 0 }
                                folded = true
                            } else if ins.b == BIN_LT {
                                if c1 < c2 { res = 1 } else { res = 0 }
                                folded = true
                            } else if ins.b == BIN_LE {
                                if c1 <= c2 { res = 1 } else { res = 0 }
                                folded = true
                            } else if ins.b == BIN_GT {
                                if c1 > c2 { res = 1 } else { res = 0 }
                                folded = true
                            } else if ins.b == BIN_GE {
                                if c1 >= c2 { res = 1 } else { res = 0 }
                                folded = true
                            }

                            if folded {
                                const_ref := alloc_const(mfn, res)
                                ins.kind = MI_COPY
                                ins.b = const_ref
                                mfn.instrs[ii] = ~ins
                                if ins.a >= 0 && ins.a < temp_const.len {
                                    temp_const[ins.a] = const_ref
                                }
                                if ins.a >= 0 && ins.a < copy_map.len {
                                    copy_map[ins.a] = const_ref
                                }
                            }
                        }
                    } else {
                        // Algebraic simplifications
                        $algebraic_folded := false
                        $copy_src := -1

                        $c_val := 0
                        $c_is_const := false
                        if ins.c <= -2 {
                            idx := 0 - ins.c - 2
                            if idx >= 0 && idx < mfn.consts.len {
                                c_val = mfn.consts[idx]
                                c_is_const = true
                            }
                        }

                        $d_val := 0
                        $d_is_const := false
                        if ins.d <= -2 {
                            idx := 0 - ins.d - 2
                            if idx >= 0 && idx < mfn.consts.len {
                                d_val = mfn.consts[idx]
                                d_is_const = true
                            }
                        }

                        if ins.b == BIN_ADD {
                            if c_is_const && c_val == 0 {
                                copy_src = ins.d
                                algebraic_folded = true
                            } else if d_is_const && d_val == 0 {
                                copy_src = ins.c
                                algebraic_folded = true
                            }
                        } else if ins.b == BIN_SUB {
                            if ins.c >= 0 && ins.c == ins.d {
                                copy_src = alloc_const(mfn, 0)
                                algebraic_folded = true
                            } else if d_is_const && d_val == 0 {
                                copy_src = ins.c
                                algebraic_folded = true
                            }
                        } else if ins.b == BIN_MUL {
                            if (c_is_const && c_val == 0) || (d_is_const && d_val == 0) {
                                copy_src = alloc_const(mfn, 0)
                                algebraic_folded = true
                            } else if c_is_const && c_val == 1 {
                                copy_src = ins.d
                                algebraic_folded = true
                            } else if d_is_const && d_val == 1 {
                                copy_src = ins.c
                                algebraic_folded = true
                            }
                        } else if ins.b == BIN_DIV {
                            if d_is_const && d_val == 1 {
                                copy_src = ins.c
                                algebraic_folded = true
                            } else if ins.c >= 0 && ins.c == ins.d {
                                copy_src = alloc_const(mfn, 1)
                                algebraic_folded = true
                            }
                        } else if ins.b == BIN_AND {
                            if (c_is_const && c_val == 0) || (d_is_const && d_val == 0) {
                                copy_src = alloc_const(mfn, 0)
                                algebraic_folded = true
                            } else if ins.c >= 0 && ins.c == ins.d {
                                copy_src = ins.c
                                algebraic_folded = true
                            } else if c_is_const && c_val == -1 {
                                copy_src = ins.d
                                algebraic_folded = true
                            } else if d_is_const && d_val == -1 {
                                copy_src = ins.c
                                algebraic_folded = true
                            }
                        } else if ins.b == BIN_OR {
                            if c_is_const && c_val == 0 {
                                copy_src = ins.d
                                algebraic_folded = true
                            } else if d_is_const && d_val == 0 {
                                copy_src = ins.c
                                algebraic_folded = true
                            } else if ins.c >= 0 && ins.c == ins.d {
                                copy_src = ins.c
                                algebraic_folded = true
                            }
                        } else if ins.c >= 0 && ins.c == ins.d {
                            if ins.b == BIN_EQ || ins.b == BIN_LE || ins.b == BIN_GE {
                                copy_src = alloc_const(mfn, 1)
                                algebraic_folded = true
                            } else if ins.b == BIN_NE || ins.b == BIN_LT || ins.b == BIN_GT {
                                copy_src = alloc_const(mfn, 0)
                                algebraic_folded = true
                            }
                        }

                        // Multi-step algebraic cancellations
                        if !algebraic_folded && ins.b == BIN_SUB {
                            // (x + d) - d -> x or (d + x) - d -> x
                            if ins.c >= 0 && ins.c < last_def.len {
                                pi := last_def[ins.c]
                                if pi >= 0 && mfn.instrs[pi].kind == MI_BIN && mfn.instrs[pi].b == BIN_ADD {
                                    p_lhs := resolve_val(mfn.instrs[pi].c, &copy_map, &temp_const)
                                    p_rhs := resolve_val(mfn.instrs[pi].d, &copy_map, &temp_const)
                                    if p_rhs == ins.d {
                                        copy_src = p_lhs
                                        algebraic_folded = true
                                    } else if p_lhs == ins.d {
                                        copy_src = p_rhs
                                        algebraic_folded = true
                                    }
                                }
                            }
                            // a - (a - y) -> y
                            if !algebraic_folded && ins.d >= 0 && ins.d < last_def.len {
                                pi := last_def[ins.d]
                                if pi >= 0 && mfn.instrs[pi].kind == MI_BIN && mfn.instrs[pi].b == BIN_SUB {
                                    p_lhs := resolve_val(mfn.instrs[pi].c, &copy_map, &temp_const)
                                    p_rhs := resolve_val(mfn.instrs[pi].d, &copy_map, &temp_const)
                                    if p_lhs == ins.c {
                                        copy_src = p_rhs
                                        algebraic_folded = true
                                    }
                                }
                            }
                        } else if !algebraic_folded && ins.b == BIN_ADD {
                            // (x - d) + d -> x
                            if ins.c >= 0 && ins.c < last_def.len {
                                pi := last_def[ins.c]
                                if pi >= 0 && mfn.instrs[pi].kind == MI_BIN && mfn.instrs[pi].b == BIN_SUB {
                                    p_lhs := resolve_val(mfn.instrs[pi].c, &copy_map, &temp_const)
                                    p_rhs := resolve_val(mfn.instrs[pi].d, &copy_map, &temp_const)
                                    if p_rhs == ins.d {
                                        copy_src = p_lhs
                                        algebraic_folded = true
                                    }
                                }
                            }
                            // d + (x - d) -> x
                            if !algebraic_folded && ins.d >= 0 && ins.d < last_def.len {
                                pi := last_def[ins.d]
                                if pi >= 0 && mfn.instrs[pi].kind == MI_BIN && mfn.instrs[pi].b == BIN_SUB {
                                    p_lhs := resolve_val(mfn.instrs[pi].c, &copy_map, &temp_const)
                                    p_rhs := resolve_val(mfn.instrs[pi].d, &copy_map, &temp_const)
                                    if p_rhs == ins.c {
                                        copy_src = p_lhs
                                        algebraic_folded = true
                                    }
                                }
                            }
                        }

                        if algebraic_folded {
                            ins.kind = MI_COPY
                            ins.b = copy_src
                            mfn.instrs[ii] = ~ins
                            if ins.a >= 0 && ins.a < temp_const.len && copy_src <= -2 {
                                temp_const[ins.a] = copy_src
                            }
                            if ins.a >= 0 && ins.a < copy_map.len {
                                copy_map[ins.a] = copy_src
                            }
                        } else {
                            mfn.instrs[ii] = ~ins
                        }
                    }
                }

                if instr_has_dest(mfn.instrs[ii].kind) {
                    d := mfn.instrs[ii].a
                    if d >= 0 && d < last_def.len {
                        last_def[d] = ii
                    }
                }

                if ii == mfn.blocks[bi].tail {
                    <-
                }
                ii = mfn.instrs[ii].next
            }
        }
    }

    // 2. Prune constant branches in basic blocks
    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].tkind == TKIND_BRANCH {
            cond := mfn.blocks[bi].ta
            $known_cond := cond
            if cond >= 0 && cond < temp_const.len {
                if temp_const[cond] <= -2 {
                    known_cond = temp_const[cond]
                }
            }
            if known_cond <= -2 {
                c_idx := 0 - known_cond - 2
                if c_idx >= 0 && c_idx < mfn.consts.len {
                    val := mfn.consts[c_idx]
                    if val != 0 {
                        mfn.blocks[bi].tkind = TKIND_JUMP
                        mfn.blocks[bi].ta = mfn.blocks[bi].tb
                        mfn.blocks[bi].tb = -1
                        mfn.blocks[bi].tc = -1
                    } else {
                        mfn.blocks[bi].tkind = TKIND_JUMP
                        mfn.blocks[bi].ta = mfn.blocks[bi].tc
                        mfn.blocks[bi].tb = -1
                        mfn.blocks[bi].tc = -1
                    }
                }
            }
        }
    }
}
