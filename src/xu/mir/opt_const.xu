@xu/mir
// Constant folding and algebraic simplification optimization pass.
//
// Layer 3 module: simplifies constant expressions, prunes dead conditional
// branches, and propagates known constant values across basic blocks.

pub fn opt_const_fold(mfn $&MFn) {
    if mfn.instrs.len == 0 {
        <<
    }

    // Map temp -> constant id (or -1 if not constant)
    $temp_const := []int{}
    for i in 0:mfn.temps.len {
        temp_const.push(-1)
    }

    // 1. Fold instructions
    for ii in 0:mfn.instrs.len {
        $ins := ~mfn.instrs[ii]
        if ins.kind == MI_COPY {
            if ins.b <= -2 {
                if ins.a >= 0 && ins.a < temp_const.len {
                    temp_const[ins.a] = ins.b
                }
            } else if ins.b >= 0 && ins.b < temp_const.len {
                if temp_const[ins.b] <= -2 {
                    ins.b = temp_const[ins.b]
                    mfn.instrs[ii] = ~ins
                    if ins.a >= 0 && ins.a < temp_const.len {
                        temp_const[ins.a] = ins.b
                    }
                }
            }
        } else if ins.kind == MI_BIN {
            // Propagate constants to operands
            if ins.c >= 0 && ins.c < temp_const.len {
                if temp_const[ins.c] <= -2 {
                    ins.c = temp_const[ins.c]
                }
            }
            if ins.d >= 0 && ins.d < temp_const.len {
                if temp_const[ins.d] <= -2 {
                    ins.d = temp_const[ins.d]
                }
            }

            // Both operands are compile-time constants: fold them!
            if ins.c <= -2 && ins.d <= -2 {
                c1_idx := 0 - ins.c - 2
                c2_idx := 0 - ins.d - 2
                if c1_idx >= 0 && c1_idx < mfn.consts.len && c2_idx >= 0 && c2_idx < mfn.consts.len {
                    c1 := mfn.consts[c1_idx]
                    c2 := mfn.consts[c2_idx]
                    $folded := false
                    $res := 0
                    if ins.b == BIN_ADD {
                        res = c1 + c2
                        folded = true
                    } else if ins.b == BIN_SUB {
                        res = c1 - c2
                        folded = true
                    } else if ins.b == BIN_MUL {
                        res = c1 * c2
                        folded = true
                    } else if ins.b == BIN_DIV {
                        if c2 != 0 {
                            res = c1 / c2
                            folded = true
                        }
                    } else if ins.b == BIN_AND {
                        res = c1 & c2
                        folded = true
                    } else if ins.b == BIN_OR {
                        res = c1 | c2
                        folded = true
                    } else if ins.b == BIN_EQ {
                        if c1 == c2 { res = 1 } else { res = 0 }
                        folded = true
                    } else if ins.b == BIN_NE {
                        if c1 != c2 { res = 1 } else { res = 0 }
                        folded = true
                    } else if ins.b == BIN_LT {
                        if c1 < c2 { res = 1 } else { res = 0 }
                        folded = true
                    } else if ins.b == BIN_LE {
                        if c1 <= c2 { res = 1 } else { res = 0 }
                        folded = true
                    } else if ins.b == BIN_GT {
                        if c1 > c2 { res = 1 } else { res = 0 }
                        folded = true
                    } else if ins.b == BIN_GE {
                        if c1 >= c2 { res = 1 } else { res = 0 }
                        folded = true
                    }

                    if folded {
                        cid := alloc_const(mfn, res)
                        ins.kind = MI_COPY
                        ins.b = cid
                        mfn.instrs[ii] = ~ins
                        if ins.a >= 0 && ins.a < temp_const.len {
                            temp_const[ins.a] = cid
                        }
                    }
                }
            } else {
                mfn.instrs[ii] = ~ins
            }
        }
    }

    // 2. Prune constant branches in basic blocks
    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].tkind == TKIND_BRANCH {
            cond := mfn.blocks[bi].ta
            $known_cond := cond
            if cond >= 0 && cond < temp_const.len {
                if temp_const[cond] <= -2 {
                    known_cond = temp_const[cond]
                }
            }
            if known_cond <= -2 {
                c_idx := 0 - known_cond - 2
                if c_idx >= 0 && c_idx < mfn.consts.len {
                    val := mfn.consts[c_idx]
                    if val != 0 {
                        mfn.blocks[bi].tkind = TKIND_JUMP
                        mfn.blocks[bi].ta = mfn.blocks[bi].tb
                        mfn.blocks[bi].tb = -1
                        mfn.blocks[bi].tc = -1
                    } else {
                        mfn.blocks[bi].tkind = TKIND_JUMP
                        mfn.blocks[bi].ta = mfn.blocks[bi].tc
                        mfn.blocks[bi].tb = -1
                        mfn.blocks[bi].tc = -1
                    }
                }
            }
        }
    }
}
