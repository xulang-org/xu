@xu/mir
// C FFI calls (extern "C" functions).
//
// A call site fills a runtime/core call block (see core ffi.xu) from a
// compile-time classification of the C arguments, resolves the symbol
// through the per-extern cache (core.ffi_sym) and calls core.ffi_call,
// which the backend implements as a register loader. Supported ABIs:
// AAPCS64 (Linux, and Apple's packed stack arguments and all-stack
// variadics), x86-64 System V (Linux, macOS) and Win64 (one register or
// stack slot per argument by position; aggregates of 1, 2, 4 or 8 bytes by
// value, others by reference).
//
// Values cross as Xu stores them: integers fully extended in a word, f32
// as single bits, c_ptr as an address, @repr("C") structs in their C
// layout, &T / &[]T as the address of the value / the first element.
// `cstr` arguments are NUL-terminated heap copies freed after the call.

#xu/ast
#xu/parser
#xu/types

// Target OS/arch codes matching src/xu/target/target.xu (Layer 4B).
const FFI_OS_MACOS = 0
const FFI_OS_LINUX = 1
const FFI_OS_WINDOWS = 2
const FFI_ARCH_ARM64 = 0
const FFI_ARCH_X64 = 1
const FFI_ARCH_RISCV64 = 4
const FFI_ARCH_LOONG64 = 5

const FB_FPR = 64
const FB_NSTACK = 128
const FB_STACK = 136
const FB_X8 = 144
const FB_RET = 152
const FB_FRET = 168
const FB_CLOSURE = 200
const BOX_HDR_SZ = 24

struct FfiCc {
    ngr int
    nfr int
    nstack int
    max_gr int
    blk int
    stk int
    emit bool
    apple bool
    x64 bool
    win bool
    win_arm64 bool
    lp64d bool
    arch int
    npos int
}

fn ffi_cc_new(tgt_os int, tgt_arch int, emit bool, blk int, stk int) FfiCc {
    x64 := tgt_arch == FFI_ARCH_X64
    lp64d := tgt_arch == FFI_ARCH_RISCV64 || tgt_arch == FFI_ARCH_LOONG64
    win := x64 && tgt_os == FFI_OS_WINDOWS
    win_arm64 := tgt_arch == FFI_ARCH_ARM64 && tgt_os == FFI_OS_WINDOWS
    $max := 8
    if x64 { max = 6 }
    if win { max = 4 }
    << FfiCc{ngr: 0, nfr: 0, nstack: 0, max_gr: max, blk: blk, stk: stk, emit: emit, apple: tgt_os == FFI_OS_MACOS && !x64, x64: x64, win: win, win_arm64: win_arm64, lp64d: lp64d, arch: tgt_arch, npos: 0}
}

fn ffi_align(n int, a int) int {
    if a <= 1 { << n }
    << (n + a - 1) / a * a
}

// Scalar leaves of a C aggregate: byte offsets and Xu types.
fn ffi_leaves(tp &types.TypedProgram, ty int, base int, offs $&[]int, tys $&[]int) {
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        for i in 0:tp.structs[si].fields.len {
            fld := &tp.structs[si].fields[i]
            if fld.bit_width > 0 {
                offs.push(base + fld.offset + fld.bit_off / 8)
                tys.push(fld.ty)
            } else {
                ffi_leaves(tp, fld.ty, base + fld.offset, offs, tys)
            }
        }
        <<
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        for i in 0:tp.arrays[ai].fixed_len {
            ffi_leaves(tp, tp.arrays[ai].elem_ty, base + i * tp.arrays[ai].elem_bytes, offs, tys)
        }
        <<
    }
    offs.push(base)
    tys.push(ty)
}

// True when `ty` is or contains a C union or bitfield (disqualifies LP64D FP-reg flattening).
fn ffi_has_union_or_bitfield(tp &types.TypedProgram, ty int) bool {
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if tp.structs[si].is_union { << true }
        for i in 0:tp.structs[si].fields.len {
            if tp.structs[si].fields[i].bit_width > 0 { << true }
            if ffi_has_union_or_bitfield(tp, tp.structs[si].fields[i].ty) { << true }
        }
        << false
    }
    if types.is_array_type(ty) {
        << ffi_has_union_or_bitfield(tp, tp.arrays[types.array_index(ty)].elem_ty)
    }
    << false
}

// Homogeneous floating aggregate: member count (1..4), else 0.
fn ffi_hfa(tp &types.TypedProgram, ty int) int {
    $offs := []int{}
    $tys := []int{}
    ffi_leaves(tp, ty, 0, $&offs, $&tys)
    if tys.len < 1 || !types.is_float_type(tys[0]) { << 0 }
    for i in 0:tys.len {
        if tys[i] != tys[0] { << 0 }
    }
    elem_sz := tp.size_of(tys[0])
    total := tp.size_of(ty)
    if elem_sz <= 0 { << 0 }
    if total % elem_sz != 0 { << 0 }
    cnt := total / elem_sz
    if cnt < 1 || cnt > 4 { << 0 }
    if types.is_struct_type(ty) && !tp.structs[types.struct_index(ty)].is_union {
        if !ffi_has_union_or_bitfield(tp, ty) && tys.len != cnt { << 0 }
    }
    << cnt
}

fn (w $&Lw) ffi_gr(cc $&FfiCc, v int) {
    w.ffi_gr_w(cc, v, 8)
}

// An integer argument; on the stack it takes `width` bytes (Apple arm64
// packs narrow stack arguments by their natural size).
fn (w $&Lw) ffi_gr_w(cc $&FfiCc, v int, width int) {
    if cc.win {
        if cc.npos < 4 {
            if cc.emit { w.store_ptr(cc.blk, cc.npos * 8, v, 8) }
        } else {
            w.ffi_stack_word(cc, v, 8)
        }
        cc.npos += 1
        <<
    }
    if cc.ngr < cc.max_gr {
        if cc.emit { w.store_ptr(cc.blk, cc.ngr * 8, v, 8) }
        cc.ngr += 1
        <<
    }
    w.ffi_stack_word(cc, v, width)
}

fn (w $&Lw) ffi_store_fpr(blk int, off int, v int, width int, arch int) {
    if arch == FFI_ARCH_RISCV64 && width == 4 {
        w.store_ptr(blk, off, w.bin(BIN_OR, w.wrap_int(v, 9), w.konst(-4294967296)), 8)
    } else {
        w.store_ptr(blk, off, v, width)
    }
}

fn (w $&Lw) ffi_fr(cc $&FfiCc, v int, width int) {
    if cc.win {
        if cc.npos < 4 {
            if cc.emit { w.store_ptr(cc.blk, FB_FPR + cc.npos * 8, v, width) }
        } else {
            w.ffi_stack_word(cc, v, width)
        }
        cc.npos += 1
        <<
    }
    if cc.nfr < 8 {
        if cc.emit { w.ffi_store_fpr(cc.blk, FB_FPR + cc.nfr * 8, v, width, cc.arch) }
        cc.nfr += 1
        <<
    }
    if cc.lp64d && cc.ngr < cc.max_gr {
        w.ffi_gr(cc, v)
        <<
    }
    w.ffi_stack_word(cc, v, width)
}

// A scalar of `width` bytes on the stack: Apple arm64 packs by natural
// alignment; the other ABIs use 8-byte slots.
fn (w $&Lw) ffi_stack_word(cc $&FfiCc, v int, width int) {
    $size := 8
    if cc.apple { size = width }
    cc.nstack = ffi_align(cc.nstack, size)
    if cc.emit { w.store_ptr(cc.stk, cc.nstack, v, width) }
    cc.nstack += size
}

fn (w $&Lw) ffi_stack_mem_slot(cc $&FfiCc, size int, align int) int {
    $a := align
    if !cc.apple && a < 8 { a = 8 }
    cc.nstack = ffi_align(cc.nstack, a)
    off := cc.nstack
    $sz := size
    if !cc.apple { sz = ffi_align(size, 8) }
    cc.nstack += sz
    << off
}

fn (w $&Lw) ffi_stack_mem(cc $&FfiCc, src int, size int, align int) {
    off := w.ffi_stack_mem_slot(cc, size, align)
    if cc.emit { w.copy_mem(w.bin(BIN_ADD, cc.stk, w.konst(off)), src, size) }
}

fn struct_align(tp &types.TypedProgram, ty int) int {
    << tp.structs[types.struct_index(ty)].align
}

// One C argument of Xu type ty with MIR value v (a word, or the address of
// a struct). vararg: in the variadic tail.
fn (w $&Lw) ffi_arg(tp &types.TypedProgram, cc $&FfiCc, ty int, v int, vararg bool) {
    if types.is_struct_type(ty) {
        w.ffi_struct_arg(tp, cc, ty, v)
        <<
    }
    if types.is_float_type(ty) {
        $fv := v
        $width := 8
        if ty == 14 {
            if vararg {
                if cc.emit { fv = w.float_un(UN_F32_LOAD, v) }
            } else {
                width = 4
            }
        }
        if vararg && cc.apple {
            w.ffi_stack_word(cc, fv, 8)
        } else if vararg && (cc.win_arm64 || cc.lp64d) {
            w.ffi_gr(cc, fv)
        } else if vararg && cc.win {
            // Win64 variadics: the value in both the integer and the vector
            // register of its slot.
            if cc.npos < 4 && cc.emit { w.store_ptr(cc.blk, FB_FPR + cc.npos * 8, fv, 8) }
            w.ffi_gr_w(cc, fv, 8)
        } else {
            w.ffi_fr(cc, fv, width)
        }
        <<
    }
    if vararg && cc.apple {
        w.ffi_stack_word(cc, v, 8)
        <<
    }
    if vararg && (cc.win_arm64 || cc.lp64d) {
        w.ffi_gr(cc, v)
        <<
    }
    w.ffi_gr_w(cc, v, ffi_int_width(tp, ty))
}

fn (w $&Lw) ffi_struct_arg(tp &types.TypedProgram, cc $&FfiCc, ty int, addr int) {
    size := tp.size_of(ty)
    al := struct_align(tp, ty)
    if cc.win {
        if size == 1 || size == 2 || size == 4 || size == 8 {
            $word := w.konst(0)
            if cc.emit {
                tmp := w.scratch_words(1)
                w.zero_mem(tmp, 8)
                w.copy_mem(tmp, addr, size)
                word = w.load_ptr(tmp, 0, 8)
            }
            w.ffi_gr(cc, word)
            <<
        }
        $copy := addr
        if cc.emit {
            copy = w.scratch_words((size + 7) / 8)
            w.copy_mem(copy, addr, size)
        }
        w.ffi_gr(cc, copy)
        <<
    }
    if cc.x64 {
        if size > 16 {
            w.ffi_stack_mem(cc, addr, size, al)
            <<
        }
        $cls := []bool{}
        w.ffi_x64_classes(tp, ty, $&cls)
        $ng := 0
        $nf := 0
        for i in 0:cls.len {
            if cls[i] { nf += 1 } else { ng += 1 }
        }
        if cc.ngr + ng > cc.max_gr || cc.nfr + nf > 8 {
            w.ffi_stack_mem(cc, addr, size, al)
            <<
        }
        $tmp := addr
        if cc.emit {
            tmp = w.scratch_words(2)
            w.zero_mem(tmp, 16)
            w.copy_mem(tmp, addr, size)
        }
        for i in 0:cls.len {
            $word := w.konst(0)
            if cc.emit { word = w.load_ptr(tmp, i * 8, 8) }
            if cls[i] { w.ffi_fr(cc, word, 8) } else { w.ffi_gr(cc, word) }
        }
        <<
    }
    if cc.lp64d {
        if size > 16 {
            $copy := addr
            if cc.emit {
                copy = w.scratch_words((size + 7) / 8)
                w.copy_mem(copy, addr, size)
            }
            w.ffi_gr(cc, copy)
            <<
        }
        if !ffi_has_union_or_bitfield(tp, ty) {
            $offs := []int{}
            $tys := []int{}
            ffi_leaves(tp, ty, 0, $&offs, $&tys)
            if tys.len == 1 && types.is_float_type(tys[0]) && cc.nfr < 8 {
                $width := 8
                if tys[0] == 14 { width = 4 }
                $fv := w.konst(0)
                if cc.emit { fv = w.load_ptr(addr, offs[0], width) }
                w.ffi_fr(cc, fv, width)
                <<
            }
            if tys.len == 2 && types.is_float_type(tys[0]) && types.is_float_type(tys[1]) && cc.nfr + 2 <= 8 {
                for i in 0:2 {
                    $width := 8
                    if tys[i] == 14 { width = 4 }
                    $fv := w.konst(0)
                    if cc.emit { fv = w.load_ptr(addr, offs[i], width) }
                    w.ffi_fr(cc, fv, width)
                }
                <<
            }
            if tys.len == 2 && (types.is_float_type(tys[0]) != types.is_float_type(tys[1])) && cc.nfr < 8 && cc.ngr < cc.max_gr {
                for i in 0:2 {
                    if types.is_float_type(tys[i]) {
                        $width := 8
                        if tys[i] == 14 { width = 4 }
                        $fv := w.konst(0)
                        if cc.emit { fv = w.load_ptr(addr, offs[i], width) }
                        w.ffi_fr(cc, fv, width)
                    } else {
                        isz := ffi_int_width(tp, tys[i])
                        $iv := w.konst(0)
                        if cc.emit { iv = w.wrap_int(w.load_ptr(addr, offs[i], isz), tys[i]) }
                        w.ffi_gr(cc, iv)
                    }
                }
                <<
            }
        }
        words := (size + 7) / 8
        $tmp := addr
        if cc.emit {
            tmp = w.scratch_words(2)
            w.zero_mem(tmp, 16)
            w.copy_mem(tmp, addr, size)
        }
        for i in 0:words {
            $word := w.konst(0)
            if cc.emit { word = w.load_ptr(tmp, i * 8, 8) }
            w.ffi_gr(cc, word)
        }
        <<
    }
    hfa := ffi_hfa(tp, ty)
    if hfa > 0 {
        if cc.nfr + hfa <= 8 {
            $offs := []int{}
            $tys := []int{}
            ffi_leaves(tp, ty, 0, $&offs, $&tys)
            $width := 8
            if tys[0] == 14 { width = 4 }
            for i in 0:hfa {
                $word := w.konst(0)
                if cc.emit { word = w.load_ptr(addr, i * width, width) }
                w.ffi_fr(cc, word, width)
            }
            <<
        }
        cc.nfr = 8
        w.ffi_stack_mem(cc, addr, size, al)
        <<
    }
    if size > 16 {
        // Passed by reference to a caller-owned copy.
        $copy := addr
        if cc.emit {
            copy = w.scratch_words((size + 7) / 8)
            w.copy_mem(copy, addr, size)
        }
        w.ffi_gr(cc, copy)
        <<
    }
    words := (size + 7) / 8
    if cc.ngr + words > cc.max_gr {
        cc.ngr = cc.max_gr
        w.ffi_stack_mem(cc, addr, size, al)
        <<
    }
    $tmp := addr
    if cc.emit {
        tmp = w.scratch_words(2)
        w.zero_mem(tmp, 16)
        w.copy_mem(tmp, addr, size)
    }
    for i in 0:words {
        $word := w.konst(0)
        if cc.emit { word = w.load_ptr(tmp, i * 8, 8) }
        w.ffi_gr(cc, word)
    }
}

// x86-64 SysV eightbyte classes of a struct of at most 16 bytes: true =
// SSE (every leaf in the eightbyte is floating), false = INTEGER.
fn (w &Lw) ffi_x64_classes(tp &types.TypedProgram, ty int, cls $&[]bool) {
    size := tp.size_of(ty)
    $offs := []int{}
    $tys := []int{}
    ffi_leaves(tp, ty, 0, $&offs, $&tys)
    for e in 0:(size + 7) / 8 {
        $sse := true
        for i in 0:offs.len {
            if offs[i] >= e * 8 && offs[i] < e * 8 + 8 && !types.is_float_type(tys[i]) { sse = false }
        }
        cls.push(sse)
    }
}

// Value of a C argument expression for an extern parameter of type pty.
// Records cstr copies, fresh strings, and transient closure trampolines to release after the call.
fn (w $&Lw) ffi_arg_value(p &parser.Parser, tp &types.TypedProgram, arg int, pty int, cstr bool, frees $&[]int, fresh $&[]int, fresh_nodes $&[]int, cb_frees $&[]int) int {
    if cstr || (pty == 3) {
        $d := 0
        if tp.type_of(arg) == 3 {
            d = w.lower_expr(p, tp, arg)
            if w.fresh_str(p, tp, arg) {
                fresh.push(d)
                fresh_nodes.push(arg)
            }
        } else {
            d = w.lower_arg(p, tp, arg, pty)
        }
        $args := []int{}
        args.push(d)
        c := w.call_core("ffi_cstr", &args)
        frees.push(c)
        << c
    }
    if types.is_fn_type(pty) {
        << w.lower_c_callback_ref(p, tp, arg, pty, cb_frees)
    }
    if types.is_ref_type(pty) {
        a := w.lower_arg(p, tp, arg, pty)
        inner := tp.deref(pty)
        if types.is_array_type(inner) && fixed_len_of(tp, inner) == 0 {
            << w.load_ptr(a, 0, 8)
        }
        << a
    }
    if types.is_struct_type(pty) {
        << w.lower_expr(p, tp, arg)
    }
    << w.lower_arg(p, tp, arg, pty)
}

fn (w $&Lw) lower_global_addr(tp &types.TypedProgram, gi int) int {
    g := &tp.globals[gi]
    if w.tgt_os == 3 || w.tgt_os == 5 {
        t := w.new_temp()
        $ins := minstr_new(MI_LOAD_FN_ADDR)
        ins.a = t
        ins.d = 1
        ins.sval = g.sym + ""
        w.emit(ins)
        << t
    }
    $args := []int{}
    args.push(w.konst(tp.fns.len + gi))
    args.push(w.ffi_str_ptr(g.sym + ""))
    args.push(w.ffi_str_ptr(g.lib + ""))
    << w.call_core("ffi_sym", &args)
}

fn (w $&Lw) lower_global_val(tp &types.TypedProgram, gi int) int {
    addr := w.lower_global_addr(tp, gi)
    gty := tp.globals[gi].ty
    if is_wide(tp, gty) { << addr }
    << w.load_ptr(addr, 0, width_of(tp, gty))
}

fn (w $&Lw) ffi_str_ptr(s string) int {
    t := w.new_temp()
    $ins := minstr_new(MI_STR_CONST)
    ins.a = t
    ins.sval = s + string_from_byte(0)
    w.emit(ins)
    << t
}

// Call node n of extern "C" function fi (ffi = its NK_FFI node).
fn (w $&Lw) lower_ffi_call(p &parser.Parser, tp &types.TypedProgram, n int, fi int, ffi int) int {
    if w.tgt_os == 3 || w.tgt_os == 5 {
        // Freestanding direct static call (assembly stub or kernel C symbol)
        $args := []int{}
        $arg := p.nodes[n].a
        if p.nodes[n].kind == ast.NK_METHOD_CALL { arg = p.nodes[n].b }
        while arg >= 0 {
            args.push(w.lower_expr(p, tp, arg))
            arg = p.nodes[arg].next
        }
        $sym := p.nodes[ffi].sval + ""
        if sym.len == 0 { sym = tp.fns[fi].name }
        << w.call(sym, &args)
    }
    hosted := (w.tgt_os == FFI_OS_MACOS && (w.tgt_arch == FFI_ARCH_ARM64 || w.tgt_arch == FFI_ARCH_X64)) ||
        (w.tgt_os == FFI_OS_LINUX && (w.tgt_arch == FFI_ARCH_ARM64 || w.tgt_arch == FFI_ARCH_X64 || w.tgt_arch == FFI_ARCH_RISCV64 || w.tgt_arch == FFI_ARCH_LOONG64)) ||
        (w.tgt_os == FFI_OS_WINDOWS && (w.tgt_arch == FFI_ARCH_ARM64 || w.tgt_arch == FFI_ARCH_X64))
    if !hosted {
        w.fail(p, n, "extern \"C\" calls are not supported on this target yet")
        << w.konst(0)
    }
    flags := p.nodes[ffi].ival
    variadic := (flags & ast.FFI_VARIADIC) != 0
    dynamic := (flags & ast.FFI_DYNAMIC) != 0
    spells := p.nodes[ffi].sval2
    // spells: "<ret>|<p1>|<p2>..." with "cstr" marking C strings.
    $parts := []string{}
    $start := 0
    for i in 0:spells.len + 1 {
        if i == spells.len || spells[i] == 124 {
            parts.push(spells[start:i])
            start = i + 1
        }
    }
    $fixed := tp.fns[fi].params.len
    if variadic { fixed -= 1 }
    // Lower the arguments first, left to right.
    $vals := []int{}
    $tys := []int{}
    $frees := []int{}
    $fresh := []int{}
    $fresh_nodes := []int{}
    $cb_frees := []int{}
    $arg := p.nodes[n].a
    if p.nodes[n].kind == ast.NK_METHOD_CALL { arg = p.nodes[n].b }
    $ai := 0
    while arg >= 0 {
        $pty := 0
        $cstr := false
        if ai < fixed {
            pty = tp.fns[fi].params[ai]
            cstr = ai + 1 < parts.len && parts[ai + 1] == "cstr"
        } else {
            pty = tp.type_of(arg)
            if types.is_ref_type(pty) && tp.deref(pty) == 3 { pty = 3 }
        }
        v := w.ffi_arg_value(p, tp, arg, pty, cstr, $&frees, $&fresh, $&fresh_nodes, $&cb_frees)
        vals.push(v)
        $cty := pty
        if cstr || pty == 3 || types.is_ref_type(pty) || types.is_fn_type(pty) { cty = 6 }
        tys.push(cty)
        ai += 1
        arg = p.nodes[arg].next
    }
    $first := 0
    $fp := w.konst(0)
    if dynamic {
        fp = vals[0]
        first = 1
    }
    rty := tp.fns[fi].ret
    ret_cstr := parts.len > 0 && parts[0] == "cstr"
    sret := ffi_sret_for(tp, rty, w.tgt_os, w.tgt_arch) && !ret_cstr
    // Pass 1 sizes the stack area; pass 2 fills the block.
    $probe := ffi_cc_new(w.tgt_os, w.tgt_arch, false, 0, 0)
    if sret && w.tgt_arch != 0 {
        probe.ngr = 1
        probe.npos = 1
    }
    for i in first:vals.len {
        w.ffi_arg(tp, $&probe, tys[i], vals[i], i >= fixed)
    }
    blk := w.scratch_words(25)
    w.zero_mem(blk, 200)
    stack_bytes := ffi_align(probe.nstack, 16)
    $stk := w.konst(0)
    if stack_bytes > 0 { stk = w.scratch_words(stack_bytes / 8) }
    $cc := ffi_cc_new(w.tgt_os, w.tgt_arch, true, blk, stk)
    $out := -1
    if rty != 0 && (types.is_struct_type(rty) || ret_cstr) { out = w.scratch(tp, rty) }
    if sret {
        if w.tgt_arch != 0 {
            w.ffi_gr($&cc, out)
        } else {
            w.store_ptr(blk, FB_X8, out, 8)
        }
    }
    for i in first:vals.len {
        w.ffi_arg(tp, $&cc, tys[i], vals[i], i >= fixed)
    }
    w.store_ptr(blk, FB_NSTACK, w.konst(stack_bytes), 8)
    w.store_ptr(blk, FB_STACK, stk, 8)
    if w.tgt_arch == 1 { w.store_ptr(blk, FB_X8, w.konst(cc.nfr), 8) }
    if !dynamic {
        $libs := ""
        meta := p.nodes[ffi].b
        if meta >= 0 { libs = p.nodes[meta].sval + "" }
        $sargs := []int{}
        sargs.push(w.konst(fi))
        sargs.push(w.ffi_str_ptr(p.nodes[ffi].sval + ""))
        sargs.push(w.ffi_str_ptr(libs))
        fp = w.call_core("ffi_sym", &sargs)
    }
    $cargs := []int{}
    cargs.push(fp)
    cargs.push(blk)
    w.call_core("ffi_call", &cargs)
    for i in 0:frees.len {
        $fa := []int{}
        fa.push(frees[i])
        w.call_core("free", &fa)
    }
    for i in 0:fresh.len {
        w.drop_fresh_str(p, tp, fresh_nodes[i], fresh[i])
    }
    for i in 0:cb_frees.len {
        w.free_closure_cb(tp, cb_frees[i])
    }
    << w.ffi_result(tp, rty, ret_cstr, sret, blk, out)
}

fn (w $&Lw) ffi_result(tp &types.TypedProgram, rty int, ret_cstr bool, sret bool, blk int, out int) int {
    if rty == 0 { << w.konst(0) }
    if ret_cstr {
        $args := []int{}
        args.push(out)
        args.push(w.load_ptr(blk, FB_RET, 8))
        w.call_core("ffi_string_from", &args)
        << out
    }
    if types.is_struct_type(rty) {
        if sret { << out }
        size := tp.size_of(rty)
        if w.tgt_os == FFI_OS_WINDOWS && w.tgt_arch == FFI_ARCH_X64 {
            w.copy_mem(out, w.bin(BIN_ADD, blk, w.konst(FB_RET)), size)
            << out
        }
        if w.tgt_arch == FFI_ARCH_RISCV64 || w.tgt_arch == FFI_ARCH_LOONG64 {
            if !ffi_has_union_or_bitfield(tp, rty) {
                $offs := []int{}
                $tys := []int{}
                ffi_leaves(tp, rty, 0, $&offs, $&tys)
                if (tys.len == 1 && types.is_float_type(tys[0])) || (tys.len == 2 && types.is_float_type(tys[0]) && types.is_float_type(tys[1])) {
                    for i in 0:tys.len {
                        $width := 8
                        if tys[i] == 14 { width = 4 }
                        w.store_ptr(out, offs[i], w.load_ptr(blk, FB_FRET + i * 8, width), width)
                    }
                    << out
                }
                if tys.len == 2 && (types.is_float_type(tys[0]) != types.is_float_type(tys[1])) {
                    for i in 0:2 {
                        if types.is_float_type(tys[i]) {
                            $width := 8
                            if tys[i] == 14 { width = 4 }
                            w.store_ptr(out, offs[i], w.load_ptr(blk, FB_FRET, width), width)
                        } else {
                            w.store_ptr(out, offs[i], w.load_ptr(blk, FB_RET, 8), ffi_int_width(tp, tys[i]))
                        }
                    }
                    << out
                }
            }
            w.copy_mem(out, w.bin(BIN_ADD, blk, w.konst(FB_RET)), size)
            << out
        }
        if w.tgt_arch == 1 {
            $cls := []bool{}
            w.ffi_x64_classes(tp, rty, $&cls)
            $ng := 0
            $nf := 0
            tmp := w.scratch_words(2)
            for i in 0:cls.len {
                $word := 0
                if cls[i] {
                    word = w.load_ptr(blk, FB_FRET + nf * 8, 8)
                    nf += 1
                } else {
                    word = w.load_ptr(blk, FB_RET + ng * 8, 8)
                    ng += 1
                }
                w.store_ptr(tmp, i * 8, word, 8)
            }
            w.copy_mem(out, tmp, size)
            << out
        }
        hfa := ffi_hfa(tp, rty)
        if hfa > 0 {
            $offs := []int{}
            $tys := []int{}
            ffi_leaves(tp, rty, 0, $&offs, $&tys)
            $width := 8
            if tys[0] == 14 { width = 4 }
            for i in 0:hfa {
                w.store_ptr(out, i * width, w.load_ptr(blk, FB_FRET + i * 8, width), width)
            }
            << out
        }
        w.copy_mem(out, w.bin(BIN_ADD, blk, w.konst(FB_RET)), size)
        << out
    }
    if rty == 4 { << w.load_ptr(blk, FB_FRET, 8) }
    if rty == 14 { << w.load_ptr(blk, FB_FRET, 4) }
    r := w.load_ptr(blk, FB_RET, 8)
    // Narrow results: the callee leaves the upper bits unspecified.
    if rty == 2 { << w.bin(BIN_NE, w.bin(BIN_AND, r, w.konst(255)), w.konst(0)) }
    if rty == 8 { << w.wrap_int(r, 8) }
    if rty == 7 || rty == 10 || rty == 11 || rty == 12 || rty == 9 { << w.wrap_int(r, rty) }
    << r
}

// ===== C callbacks =====
//
// A named Xu function passed for an extern `fn(...)` parameter becomes the
// address of a thunk: a C-ABI entry the backend emits per target function,
// which saves the C callee-saved registers, spills the argument registers
// into a call block and calls the adapter below, then returns the result
// registers the adapter stored in the block. The C call has to come back on
// the calling thread (the runtime state register is callee-saved in C).

fn ffi_sret_for(tp &types.TypedProgram, rty int, tgt_os int, tgt_arch int) bool {
    if rty == 0 || !types.is_struct_type(rty) { << false }
    rsz := tp.size_of(rty)
    if tgt_os == FFI_OS_WINDOWS && tgt_arch == FFI_ARCH_X64 {
        << rsz != 1 && rsz != 2 && rsz != 4 && rsz != 8
    }
    if tgt_arch == FFI_ARCH_ARM64 {
        << ffi_hfa(tp, rty) == 0 && rsz > 16
    }
    << rsz > 16
}

// Lowers a C callback argument or `c_callback(fn_ref)` expression:
// named top-level non-throwing fns lower directly to a zero-cost static
// thunk; closures, lambdas, local fn values, and bound methods allocate a
// W^X static closure stub slot paired with a generated signature adapter.
fn (w $&Lw) lower_c_callback_ref(p &parser.Parser, tp &types.TypedProgram, arg int, sig_ty int, cb_frees $&[]int) int {
    k := p.nodes[arg].kind
    fi := tp.call_of(arg)
    if (k == ast.NK_IDENT || k == ast.NK_FIELD) && tp.local_of(arg) < 0 && fi >= 0 && fi < tp.fns.len && !fn_throws(tp, fi) {
        << w.fn_addr(FFI_THUNK_PREFIX + tp.fns[fi].label)
    }
    $ty := sig_ty
    if ty <= 0 || !types.is_fn_type(ty) { ty = tp.type_of(arg) }
    sig := types.fn_index(ty)
    if sig < 0 || sig >= tp.sig_params.len {
        w.fail(p, arg, "c_callback expects a valid function or closure")
        << w.konst(0)
    }
    fv := w.lower_expr(p, tp, arg)
    code := w.load_ptr(fv, 0, 8)
    env := w.load_ptr(fv, 8, 8)
    own_b := w.new_block()
    after_b := w.new_block()
    w.branch(w.bin(BIN_AND, env, w.konst(1)), own_b, after_b)
    w.f.active_bb = own_b
    w.box_retain(w.bin(BIN_SUB, w.bin(BIN_AND, env, w.konst(-2)), w.konst(BOX_HDR_SZ)))
    w.jump(after_b)
    w.f.active_bb = after_b
    adapter := w.fn_addr(FFI_SIG_ADAPTER_PREFIX + str(sig))
    stubs := w.fn_addr("__xu_ffi_clos_stubs")
    $aargs := []int{}
    aargs.push(adapter)
    aargs.push(code)
    aargs.push(env)
    aargs.push(stubs)
    tramp := w.call_core("ffi_closure_alloc", &aargs)
    if cb_frees.len >= 0 {
        // Callers from extern "C" call sites pass cb_frees to release after the call;
        // explicit c_callback(...) relies on the sentinel slot check (only pushed by extern calls).
        if cb_frees.len == 0 || cb_frees[cb_frees.len - 1] != -999999 {
            cb_frees.push(tramp)
        }
    }
    << tramp
}

fn (w $&Lw) free_closure_cb(tp &types.TypedProgram, p_val int) {
    stubs := w.fn_addr("__xu_ffi_clos_stubs")
    $args := []int{}
    args.push(p_val)
    args.push(stubs)
    env := w.call_core("ffi_closure_take_env", &args)
    own_b := w.new_block()
    done_b := w.new_block()
    w.branch(w.bin(BIN_AND, env, w.konst(1)), own_b, done_b)
    w.f.active_bb = own_b
    w.box_release(tp, w.bin(BIN_SUB, w.bin(BIN_AND, env, w.konst(-2)), w.konst(BOX_HDR_SZ)))
    w.jump(done_b)
    w.f.active_bb = done_b
}

const FFI_THUNK_PREFIX = "__xu_ffi_thunk."
const FFI_ADAPTER_PREFIX = "__xu_ffi_adapter."
const FFI_SIG_ADAPTER_PREFIX = "__xu_ffi_clos_adapter."

// Queue the adapter of thunk label `label` once; returns the target
// function's queue key so it is lowered too.
fn ffi_thunk_request(tp &types.TypedProgram, by_label &LabelIndex, label &string, tgt_os int, tgt_arch int, core_names &[]string, core_labels &[]string, out $&Mir) int {
    target := label[FFI_THUNK_PREFIX.len:label.len]
    fi := by_label.get(&target)
    if fi < 0 { << -1 }
    for i in 0:out.ffi_thunks.len {
        if out.ffi_thunks[i] == *label { << fi }
    }
    adapter := FFI_ADAPTER_PREFIX + target
    out.ffi_thunks.push(*label + "")
    out.ffi_adapters.push(adapter + "")
    out.fns.push(lower_ffi_adapter(tp, fi, &adapter, tgt_os, tgt_arch, core_names, core_labels))
    << fi
}

fn ffi_is_sig_adapter(label &string) bool {
    if label.len <= FFI_SIG_ADAPTER_PREFIX.len { << false }
    << label[0:FFI_SIG_ADAPTER_PREFIX.len] == FFI_SIG_ADAPTER_PREFIX
}

fn ffi_parse_pos_int(s &string) int {
    if s.len == 0 { << -1 }
    $v := 0
    for i in 0:s.len {
        ch := s[i] & 255
        if ch < 48 || ch > 57 { << -1 }
        v = v * 10 + (ch - 48)
    }
    << v
}

fn ffi_sig_adapter_request(tp &types.TypedProgram, label &string, tgt_os int, tgt_arch int, core_names &[]string, core_labels &[]string, out $&Mir) bool {
    for i in 0:out.fns.len {
        if out.fns[i].label == *label { << false }
    }
    tail := label[FFI_SIG_ADAPTER_PREFIX.len:label.len]
    sig := ffi_parse_pos_int(&tail)
    if sig < 0 || sig >= tp.sig_params.len { << false }
    out.fns.push(lower_ffi_sig_adapter(tp, sig, label, tgt_os, tgt_arch, core_names, core_labels))
    << true
}

fn (w $&Lw) ffi_adapter_init_sret(tp &types.TypedProgram, blk int, cc $&FfiCc, rty int) int {
    if !ffi_sret_for(tp, rty, w.tgt_os, w.tgt_arch) { << 0 }
    if w.tgt_arch == FFI_ARCH_ARM64 {
        << w.load_ptr(blk, FB_X8, 8)
    }
    cc.ngr = 1
    cc.npos = 1
    << w.load_ptr(blk, 0, 8)
}

fn (w $&Lw) ffi_adapter_store_ret(tp &types.TypedProgram, blk int, rty int, r int, sret bool, sret_ptr int) {
    if rty == 0 { << }
    if types.is_struct_type(rty) {
        size := tp.size_of(rty)
        if sret {
            w.copy_mem(sret_ptr, r, size)
            if w.tgt_arch != FFI_ARCH_ARM64 { w.store_ptr(blk, FB_RET, sret_ptr, 8) }
            <<
        }
        if w.tgt_os == FFI_OS_WINDOWS && w.tgt_arch == FFI_ARCH_X64 {
            w.copy_mem(w.bin(BIN_ADD, blk, w.konst(FB_RET)), r, size)
            <<
        }
        if w.tgt_arch == FFI_ARCH_RISCV64 || w.tgt_arch == FFI_ARCH_LOONG64 {
            if !ffi_has_union_or_bitfield(tp, rty) {
                $offs := []int{}
                $tys := []int{}
                ffi_leaves(tp, rty, 0, $&offs, $&tys)
                if (tys.len == 1 && types.is_float_type(tys[0])) || (tys.len == 2 && types.is_float_type(tys[0]) && types.is_float_type(tys[1])) {
                    for i in 0:tys.len {
                        $width := 8
                        if tys[i] == 14 { width = 4 }
                        w.ffi_store_fpr(blk, FB_FRET + i * 8, w.load_ptr(r, offs[i], width), width, w.tgt_arch)
                    }
                    <<
                }
                if tys.len == 2 && (types.is_float_type(tys[0]) != types.is_float_type(tys[1])) {
                    for i in 0:2 {
                        if types.is_float_type(tys[i]) {
                            $width := 8
                            if tys[i] == 14 { width = 4 }
                            w.ffi_store_fpr(blk, FB_FRET, w.load_ptr(r, offs[i], width), width, w.tgt_arch)
                        } else {
                            iw := ffi_int_width(tp, tys[i])
                            w.store_ptr(blk, FB_RET, w.wrap_int(w.load_ptr(r, offs[i], iw), tys[i]), 8)
                        }
                    }
                    <<
                }
            }
            w.copy_mem(w.bin(BIN_ADD, blk, w.konst(FB_RET)), r, size)
            <<
        }
        if w.tgt_arch == FFI_ARCH_X64 {
            $cls := []bool{}
            w.ffi_x64_classes(tp, rty, $&cls)
            tmp := w.scratch_words(2)
            w.zero_mem(tmp, 16)
            w.copy_mem(tmp, r, size)
            $ng := 0
            $nf := 0
            for i in 0:cls.len {
                word := w.load_ptr(tmp, i * 8, 8)
                if cls[i] {
                    w.store_ptr(blk, FB_FRET + nf * 8, word, 8)
                    nf += 1
                } else {
                    w.store_ptr(blk, FB_RET + ng * 8, word, 8)
                    ng += 1
                }
            }
            <<
        }
        hfa := ffi_hfa(tp, rty)
        if hfa > 0 {
            $offs := []int{}
            $tys := []int{}
            ffi_leaves(tp, rty, 0, $&offs, $&tys)
            $width := 8
            if tys[0] == 14 { width = 4 }
            for i in 0:hfa {
                w.store_ptr(blk, FB_FRET + i * 8, w.load_ptr(r, i * width, width), width)
            }
            <<
        }
        w.copy_mem(w.bin(BIN_ADD, blk, w.konst(FB_RET)), r, size)
        <<
    }
    if types.is_float_type(rty) {
        $width := 8
        if rty == 14 { width = 4 }
        w.ffi_store_fpr(blk, FB_FRET, r, width, w.tgt_arch)
    } else {
        w.store_ptr(blk, FB_RET, r, 8)
    }
}

fn (w $&Lw) ffi_free_cb_strs(str_frees &[]int) {
    for i in 0:str_frees.len {
        $sargs := []int{}
        sargs.push(str_frees[i])
        w.call_core("str_free", &sargs)
    }
}

// Adapter of Xu function fi: one incoming word, the call block address.
fn lower_ffi_adapter(tp &types.TypedProgram, fi int, label &string, tgt_os int, tgt_arch int, core_names &[]string, core_labels &[]string) MFn {
    $w := lw_new(tp.fns[fi].name + ".c", *label + "", fi, tgt_os, tgt_arch)
    for i in 0:core_names.len {
        w.core_names.push(core_names[i] + "")
        w.core_labels.push(core_labels[i] + "")
    }
    w.f.ret = 0
    w.f.blocks.push(mblock_new())
    w.f.active_bb = 0
    inb := w.new_local(1, 1, "blk")
    w.f.nparams = w.f.locals.len
    blk := w.load_local(inb, 0)
    stk := w.load_ptr(blk, FB_STACK, 8)
    $cc := ffi_cc_new(tgt_os, tgt_arch, true, blk, stk)
    rty := tp.fns[fi].ret
    sret := ffi_sret_for(tp, rty, tgt_os, tgt_arch)
    sret_ptr := w.ffi_adapter_init_sret(tp, blk, $&cc, rty)
    $args := []int{}
    $xu_out := 0
    if rty != 0 && is_wide(tp, rty) {
        xu_out = w.scratch(tp, rty)
        args.push(xu_out)
    }
    $str_frees := []int{}
    for i in 0:tp.fns[fi].params.len {
        args.push(w.ffi_take(tp, $&cc, tp.fns[fi].params[i], $&str_frees))
    }
    $r := w.call(tp.fns[fi].label, &args)
    if rty != 0 && is_wide(tp, rty) { r = xu_out }
    w.ffi_free_cb_strs(&str_frees)
    w.ffi_adapter_store_ret(tp, blk, rty, r, sret, sret_ptr)
    w.ret(w.konst(0))
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    << mfn_copy(&w.f)
}

// Generic adapter for closure/dynamic callback signature `sig`:
// incoming blk holds `[blk + FB_CLOSURE] -> [code, env]`.
fn lower_ffi_sig_adapter(tp &types.TypedProgram, sig int, label &string, tgt_os int, tgt_arch int, core_names &[]string, core_labels &[]string) MFn {
    $w := lw_new("__clos_sig" + str(sig) + ".c", *label + "", 0, tgt_os, tgt_arch)
    for i in 0:core_names.len {
        w.core_names.push(core_names[i] + "")
        w.core_labels.push(core_labels[i] + "")
    }
    w.f.ret = 0
    w.f.blocks.push(mblock_new())
    w.f.active_bb = 0
    inb := w.new_local(1, 1, "blk")
    w.f.nparams = w.f.locals.len
    blk := w.load_local(inb, 0)
    stk := w.load_ptr(blk, FB_STACK, 8)
    $cc := ffi_cc_new(tgt_os, tgt_arch, true, blk, stk)
    rty := tp.sig_ret[sig]
    sret := ffi_sret_for(tp, rty, tgt_os, tgt_arch)
    sret_ptr := w.ffi_adapter_init_sret(tp, blk, $&cc, rty)
    $args := []int{}
    $str_frees := []int{}
    for i in 0:tp.sig_params[sig].len {
        args.push(w.ffi_take(tp, $&cc, tp.sig_params[sig][i], $&str_frees))
    }
    fv := w.load_ptr(blk, FB_CLOSURE, 8)
    r := w.fnval_invoke(tp, fv, rty, &args)
    w.ffi_free_cb_strs(&str_frees)
    w.ffi_adapter_store_ret(tp, blk, rty, r, sret, sret_ptr)
    w.ret(w.konst(0))
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    << mfn_copy(&w.f)
}

fn (w $&Lw) ffi_take_stack_mem(cc $&FfiCc, dst int, size int, align int) {
    off := w.ffi_stack_mem_slot(cc, size, align)
    w.copy_mem(dst, w.bin(BIN_ADD, cc.stk, w.konst(off)), size)
}

// Read one incoming C parameter of Xu type ty (callee side of ffi_arg).
fn (w $&Lw) ffi_take(tp &types.TypedProgram, cc $&FfiCc, ty int, str_frees $&[]int) int {
    if ty == 3 || (types.is_ref_type(ty) && !types.is_mut_ref_type(ty) && tp.deref(ty) == 3) {
        cp := w.ffi_take_scalar(tp, cc, 6)
        desc := w.scratch_words(3)
        $args := []int{}
        args.push(desc)
        args.push(cp)
        w.call_core("ffi_string_from", &args)
        if ty != 3 { str_frees.push(desc) }
        << desc
    }
    if types.is_struct_type(ty) {
        out := w.scratch(tp, ty)
        size := tp.size_of(ty)
        al := struct_align(tp, ty)
        if cc.win {
            if size == 1 || size == 2 || size == 4 || size == 8 {
                tmp := w.scratch_words(1)
                w.store_ptr(tmp, 0, w.ffi_take_scalar(tp, cc, 1), 8)
                w.copy_mem(out, tmp, size)
            } else {
                w.copy_mem(out, w.ffi_take_scalar(tp, cc, 6), size)
            }
            << out
        }
        if cc.x64 {
            if size > 16 {
                w.ffi_take_stack_mem(cc, out, size, al)
                << out
            }
            $cls := []bool{}
            w.ffi_x64_classes(tp, ty, $&cls)
            $ng := 0
            $nf := 0
            for i in 0:cls.len {
                if cls[i] { nf += 1 } else { ng += 1 }
            }
            if cc.ngr + ng > cc.max_gr || cc.nfr + nf > 8 {
                w.ffi_take_stack_mem(cc, out, size, al)
                << out
            }
            tmp := w.scratch_words(2)
            for i in 0:cls.len {
                $word := 0
                if cls[i] {
                    cc.nfr += 1
                    word = w.load_ptr(cc.blk, FB_FPR + (cc.nfr - 1) * 8, 8)
                } else {
                    cc.ngr += 1
                    word = w.load_ptr(cc.blk, (cc.ngr - 1) * 8, 8)
                }
                w.store_ptr(tmp, i * 8, word, 8)
            }
            w.copy_mem(out, tmp, size)
            << out
        }
        if cc.lp64d {
            if size > 16 {
                w.copy_mem(out, w.ffi_take_scalar(tp, cc, 6), size)
                << out
            }
            if !ffi_has_union_or_bitfield(tp, ty) {
                $offs := []int{}
                $tys := []int{}
                ffi_leaves(tp, ty, 0, $&offs, $&tys)
                if tys.len == 1 && types.is_float_type(tys[0]) && cc.nfr < 8 {
                    $width := 8
                    if tys[0] == 14 { width = 4 }
                    cc.nfr += 1
                    w.store_ptr(out, offs[0], w.load_ptr(cc.blk, FB_FPR + (cc.nfr - 1) * 8, width), width)
                    << out
                }
                if tys.len == 2 && types.is_float_type(tys[0]) && types.is_float_type(tys[1]) && cc.nfr + 2 <= 8 {
                    for i in 0:2 {
                        $width := 8
                        if tys[i] == 14 { width = 4 }
                        cc.nfr += 1
                        w.store_ptr(out, offs[i], w.load_ptr(cc.blk, FB_FPR + (cc.nfr - 1) * 8, width), width)
                    }
                    << out
                }
                if tys.len == 2 && (types.is_float_type(tys[0]) != types.is_float_type(tys[1])) && cc.nfr < 8 && cc.ngr < cc.max_gr {
                    for i in 0:2 {
                        if types.is_float_type(tys[i]) {
                            $width := 8
                            if tys[i] == 14 { width = 4 }
                            cc.nfr += 1
                            w.store_ptr(out, offs[i], w.load_ptr(cc.blk, FB_FPR + (cc.nfr - 1) * 8, width), width)
                        } else {
                            isz := ffi_int_width(tp, tys[i])
                            cc.ngr += 1
                            w.store_ptr(out, offs[i], w.wrap_int(w.load_ptr(cc.blk, (cc.ngr - 1) * 8, 8), tys[i]), isz)
                        }
                    }
                    << out
                }
            }
            words := (size + 7) / 8
            tmp := w.scratch_words(words)
            for i in 0:words {
                w.store_ptr(tmp, i * 8, w.ffi_take_scalar(tp, cc, 1), 8)
            }
            w.copy_mem(out, tmp, size)
            << out
        }
        hfa := ffi_hfa(tp, ty)
        if hfa > 0 {
            if cc.nfr + hfa <= 8 {
                $offs := []int{}
                $tys := []int{}
                ffi_leaves(tp, ty, 0, $&offs, $&tys)
                $width := 8
                if tys[0] == 14 { width = 4 }
                for i in 0:hfa {
                    cc.nfr += 1
                    w.store_ptr(out, i * width, w.load_ptr(cc.blk, FB_FPR + (cc.nfr - 1) * 8, width), width)
                }
                << out
            }
            cc.nfr = 8
            w.ffi_take_stack_mem(cc, out, size, al)
            << out
        }
        if size > 16 {
            w.copy_mem(out, w.ffi_take_scalar(tp, cc, 6), size)
            << out
        }
        words := (size + 7) / 8
        if cc.ngr + words > cc.max_gr {
            cc.ngr = cc.max_gr
            w.ffi_take_stack_mem(cc, out, size, al)
            << out
        }
        tmp := w.scratch_words(2)
        for i in 0:words {
            w.store_ptr(tmp, i * 8, w.ffi_take_scalar(tp, cc, 1), 8)
        }
        w.copy_mem(out, tmp, size)
        << out
    }
    << w.ffi_take_scalar(tp, cc, ty)
}

fn (w $&Lw) ffi_take_scalar(tp &types.TypedProgram, cc $&FfiCc, ty int) int {
    if cc.win {
        pos := cc.npos
        cc.npos += 1
        $width := 8
        if ty == 14 { width = 4 }
        $raw := 0
        if pos < 4 {
            if types.is_float_type(ty) { << w.load_ptr(cc.blk, FB_FPR + pos * 8, width) }
            raw = w.load_ptr(cc.blk, pos * 8, 8)
        } else {
            if types.is_float_type(ty) { << w.load_ptr(cc.stk, (pos - 4) * 8, width) }
            raw = w.load_ptr(cc.stk, (pos - 4) * 8, 8)
        }
        if ty == 2 { << w.bin(BIN_NE, w.bin(BIN_AND, raw, w.konst(255)), w.konst(0)) }
        << w.wrap_int(raw, ty)
    }
    if types.is_float_type(ty) {
        $width := 8
        if ty == 14 { width = 4 }
        if cc.nfr < 8 {
            cc.nfr += 1
            << w.load_ptr(cc.blk, FB_FPR + (cc.nfr - 1) * 8, width)
        }
        if cc.lp64d && cc.ngr < cc.max_gr {
            cc.ngr += 1
            raw := w.load_ptr(cc.blk, (cc.ngr - 1) * 8, 8)
            if ty == 14 { << w.wrap_int(raw, 9) }
            << raw
        }
        << w.ffi_take_stack(cc, width)
    }
    $raw := 0
    if cc.ngr < cc.max_gr {
        cc.ngr += 1
        raw = w.load_ptr(cc.blk, (cc.ngr - 1) * 8, 8)
    } else {
        raw = w.ffi_take_stack(cc, ffi_int_width(tp, ty))
    }
    // The C caller may leave the bits above a narrow value unspecified.
    if ty == 2 { << w.bin(BIN_NE, w.bin(BIN_AND, raw, w.konst(255)), w.konst(0)) }
    << w.wrap_int(raw, ty)
}

fn (w $&Lw) ffi_take_stack(cc $&FfiCc, width int) int {
    $size := 8
    if cc.apple { size = width }
    cc.nstack = ffi_align(cc.nstack, size)
    off := cc.nstack
    cc.nstack += size
    $wd := width
    if wd == 1 || wd == 2 { wd = 0 - wd }
    << w.load_ptr(cc.stk, off, wd)
}

fn ffi_is_thunk(label &string) bool {
    if label.len <= FFI_THUNK_PREFIX.len { << false }
    << label[0:FFI_THUNK_PREFIX.len] == FFI_THUNK_PREFIX
}

// Bytes of a C integer argument (C _Bool is one byte; Xu stores bool in a word).
fn ffi_int_width(tp &types.TypedProgram, ty int) int {
    if ty == 2 { << 1 }
    sz := tp.size_of(ty)
    if sz == 1 || sz == 2 || sz == 4 { << sz }
    << 8
}
