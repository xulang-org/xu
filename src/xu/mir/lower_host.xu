@xu/mir
// Hosted builtins (os, files, processes, time, env, string/byte helpers) backed by runtime/core.
//
// Each builtin maps to a runtime/core entry point (host*.xu). String and
// other wide arguments pass their address. Result shapes:
//   HR_WORD   scalar result returned by the call
//   HR_WIDE   wide result written through a leading out address
//   HR_TWORD  may throw: leading okp word, returns the error word
//   HR_TWIDE  may throw: leading out address filled on success, returns
//             the error word
// Throwing builtins leave the error word in w.last_err.

#xu/parser
#xu/types

const HR_WORD = 0
const HR_WIDE = 1
const HR_TWORD = 2
const HR_TWIDE = 3

struct HostSig {
    name string
    shape int
    // out size in words for wide shapes
    words int
}

fn host_sig(name string, shape int, words int) HostSig {
    << HostSig{name: name, shape: shape, words: words}
}

fn host_sig_of(code int) HostSig {
    if code == -8 { << host_sig("host_string_from_byte", HR_WIDE, 3) }
    if code == -9 { << host_sig("host_string_from_bytes", HR_WIDE, 3) }
    if code == -12 { << host_sig("host_args", HR_WIDE, 3) }
    if code == -22 { << host_sig("host_system", HR_WORD, 0) }
    if code == -27 { << host_sig("host_now_ns", HR_WORD, 0) }
    if code == -127 { << host_sig("host_wall_time_ns", HR_WORD, 0) }
    if code == -28 { << host_sig("host_sleep_ns", HR_WORD, 0) }
    if code == -129 { << host_sig("host_wait_cancel", HR_WORD, 0) }
    if code == -38 { << host_sig("host_pid", HR_WORD, 0) }
    if code == -39 { << host_sig("host_ppid", HR_WORD, 0) }
    if code == -40 { << host_sig("host_uid", HR_WORD, 0) }
    if code == -41 { << host_sig("host_gid", HR_WORD, 0) }
    if code == -42 { << host_sig("host_euid", HR_WORD, 0) }
    if code == -43 { << host_sig("host_egid", HR_WORD, 0) }
    if code == -44 { << host_sig("host_pagesize", HR_WORD, 0) }
    if code == -45 { << host_sig("host_host_name", HR_WIDE, 3) }
    if code == -46 { << host_sig("host_cwd", HR_WIDE, 3) }
    if code == -47 { << host_sig("host_env_get", HR_WIDE, 3) }
    if code == -48 { << host_sig("host_env_list", HR_WIDE, 3) }
    if code == -49 { << host_sig("host_tmp_dir", HR_WIDE, 3) }
    if code == -117 { << host_sig("host_exec", HR_WORD, 0) }
    if code == -10 { << host_sig("host_read_file", HR_TWIDE, 3) }
    if code == -11 { << host_sig("host_write_file", HR_TWORD, 0) }
    if code == -26 { << host_sig("host_read_dir", HR_TWIDE, 3) }
    if code == -50 { << host_sig("host_stat", HR_TWIDE, 3) }
    if code == -51 { << host_sig("host_mkdir", HR_TWORD, 0) }
    if code == -52 { << host_sig("host_rename", HR_TWORD, 0) }
    if code == -53 { << host_sig("host_remove", HR_TWORD, 0) }
    if code == -64 { << host_sig("host_os_open", HR_TWORD, 0) }
    if code == -65 { << host_sig("host_fd_read", HR_TWIDE, 3) }
    if code == -66 { << host_sig("host_fd_write", HR_TWORD, 0) }
    if code == -67 { << host_sig("host_fd_close", HR_TWORD, 0) }
    if code == -111 { << host_sig("host_chmod", HR_TWORD, 0) }
    if code == -112 { << host_sig("host_chdir", HR_TWORD, 0) }
    if code == -113 { << host_sig("host_symlink", HR_TWORD, 0) }
    if code == -114 { << host_sig("host_readlink", HR_TWIDE, 3) }
    if code == -115 { << host_sig("host_fd_seek", HR_TWORD, 0) }
    if code == -116 { << host_sig("host_pipe", HR_TWORD, 0) }
    if code == -118 { << host_sig("host_random_fill", HR_TWIDE, 3) }
    if code == -134 { << host_sig("host_fd_peek_read", HR_TWORD, 0) }
    if code == -29 { << host_sig("host_socket", HR_TWORD, 0) }
    if code == -100 { << host_sig("host_bind4", HR_TWORD, 0) }
    if code == -58 { << host_sig("host_connect4", HR_TWORD, 0) }
    if code == -122 { << host_sig("host_bind6", HR_TWORD, 0) }
    if code == -123 { << host_sig("host_connect6", HR_TWORD, 0) }
    if code == -124 { << host_sig("host_bind_unix", HR_TWORD, 0) }
    if code == -125 { << host_sig("host_connect_unix", HR_TWORD, 0) }
    if code == -82 { << host_sig("host_listen", HR_TWORD, 0) }
    if code == -60 { << host_sig("host_accept", HR_TWORD, 0) }
    if code == -79 { << host_sig("host_sendto", HR_TWORD, 0) }
    if code == -81 { << host_sig("host_recvfrom", HR_TWIDE, 3) }
    if code == -109 { << host_sig("host_setsockopt_timeo", HR_TWORD, 0) }
    if code == -149 { << host_sig("host_setsockopt", HR_TWORD, 0) }
    if code == -63 { << host_sig("host_fd_read", HR_TWIDE, 3) }
    if code == -62 { << host_sig("host_fd_write", HR_TWORD, 0) }
    if code == -61 { << host_sig("host_socket_close", HR_TWORD, 0) }
    if code == -130 { << host_sig("host_socket_poll", HR_TWORD, 0) }
    if code == -131 { << host_sig("host_socket_wait", HR_TWORD, 0) }
    if code == -126 { << host_sig("host_interface_data", HR_TWIDE, 3) }
    << host_sig("", HR_WORD, 0)
}

fn (w $&Lw) host_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    << NOT_HANDLED
}

// Argument word: the address of a wide value, otherwise the value.
fn (w $&Lw) host_arg(p &parser.Parser, tp &types.TypedProgram, arg int) int {
    ty := tp.deref(tp.deref(tp.type_of(arg)))
    if is_wide(tp, ty) {
        << w.array_desc(p, tp, arg, ty)
    }
    v := w.lower_expr(p, tp, arg)
    if w.expr_is_ref(p, tp, arg) {
        << w.load_ptr(v, 0, width_of(tp, ty))
    }
    << v
}

fn (w $&Lw) host_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    sig := host_sig_of(code)
    if sig.name.len == 0 {
        << NOT_HANDLED
    }
    $out := -1
    $args := []int{}
    if sig.shape == HR_WIDE || sig.shape == HR_TWIDE {
        out = w.scratch_words(sig.words)
        w.zero_mem(out, sig.words * 8)
        args.push(out)
    } else if sig.shape == HR_TWORD {
        out = w.scratch_words(1)
        w.store_ptr(out, 0, w.konst(0), 8)
        args.push(out)
    }
    $vals := []int{}
    $arg := p.nodes[n].a
    while arg >= 0 {
        vals.push(w.host_arg(p, tp, arg))
        arg = p.nodes[arg].next
    }
    if code == -117 {
        // os_exec(path, blob, redir[, cancel, deadline]): the runtime takes
        // (path, blob, redir, has_deadline, deadline); cancel is dropped.
        for i in 0:3 {
            args.push(vals[i])
        }
        if vals.len >= 5 {
            args.push(w.konst(1))
            args.push(vals[4])
        } else {
            args.push(w.konst(0))
            args.push(w.konst(0))
        }
    } else {
        for i in 0:vals.len {
            args.push(vals[i])
        }
    }
    // string_from_bytes(a) covers the whole array.
    if code == -9 && vals.len == 1 {
        args.push(w.konst(0))
        args.push(w.konst(-1))
    }
    r := w.call_core(sig.name, &args)
    if sig.shape == HR_WORD {
        << r
    }
    if sig.shape == HR_WIDE {
        << out
    }
    w.last_err = r
    if sig.shape == HR_TWIDE {
        << out
    }
    << w.load_ptr(out, 0, 8)
}

fn (w $&Lw) host_method_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    << NOT_HANDLED
}
