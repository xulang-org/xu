@xu/mir

#xu/mir/ai

#xu/ast
#xu/parser
#xu/types

const TENSOR_U8 = 10

// Lower canonical GGUF Q4_0 block-32 dot products into ARM64 NEON / x86-64 SSE2 stubs:
//   for b in 0:n_blocks {
//       $bsum := f32(0)
//       q_base := q_off + b * 16
//       x_base := x_off + b * 32
//       for j in 0:16 {
//           byte := int(qs[q_base + j])
//           q0 := (byte & 15) - 8
//           q1 := (byte >> 4) - 8
//           bsum += f32(q0) * x[x_base + j] + f32(q1) * x[x_base + 16 + j]
//       }
//       acc += bsum * scales[s_off + b]
//   }
struct TensorQ4DotPlan {
    loop int
    bound int
    qs int
    scales int
    x int
    off_q int
    off_s int
    off_x int
    accum_slot int
}

fn (w &Lw) tensor_scaled_offset_in(p &parser.Parser, tp &types.TypedProgram, expr int, iv int, stride int, allow &[]int) int {
    if expr < 0 { << -2 }
    if ai.tensor_scaled_mul_iv(p, tp, expr, iv, stride) { << -1 }
    node := &p.nodes[expr]
    if node.kind != ast.NK_BIN_OP || node.ival != ast.OP_ADD { << -2 }
    $off := -1
    if ai.tensor_scaled_mul_iv(p, tp, node.b, iv, stride) {
        off = node.a
    } else if ai.tensor_scaled_mul_iv(p, tp, node.a, iv, stride) {
        off = node.b
    } else {
        << -2
    }
    if off < 0 { << -2 }
    if p.nodes[off].kind == ast.NK_INT { << off }
    id := w.tensor_offset_local(p, tp, off, allow)
    if id < 0 || id == iv || w.local_type(tp, id) != 1 { << -2 }
    << off
}

fn (w &Lw) tensor_scaled_offset(p &parser.Parser, tp &types.TypedProgram, expr int, iv int, stride int) int {
    empty := []int{}
    << w.tensor_scaled_offset_in(p, tp, expr, iv, stride, &empty)
}

fn (w &Lw) tensor_q4_dot_plan(p &parser.Parser, tp &types.TypedProgram, loop int) TensorQ4DotPlan {
    no_match := TensorQ4DotPlan{loop: -1, bound: -1, qs: -1, scales: -1, x: -1,
                                off_q: -2, off_s: -2, off_x: -2, accum_slot: -1}
    bound := ai.tensor_dynamic_bound(p, loop)
    if !w.tensor_dot_bound_ok(p, tp, bound) { << no_match }
    b_iv := tp.local_of(loop)
    if b_iv < 0 { << no_match }

    s1 := p.nodes[loop].c
    if s1 < 0 || p.nodes[s1].kind != ast.NK_LET || !ai.tensor_is_f32_zero(p, tp, p.nodes[s1].a) {
        << no_match
    }
    bsum_id := tp.local_of(s1)
    if bsum_id < 0 || w.local_type(tp, bsum_id) != ai.TENSOR_F32 { << no_match }

    s2 := p.nodes[s1].next
    if s2 < 0 || p.nodes[s2].kind != ast.NK_LET { << no_match }
    q_base_id := tp.local_of(s2)
    if q_base_id < 0 || w.local_type(tp, q_base_id) != 1 { << no_match }
    off_q := w.tensor_scaled_offset(p, tp, p.nodes[s2].a, b_iv, 16)
    if off_q == -2 { << no_match }

    s3 := p.nodes[s2].next
    if s3 < 0 || p.nodes[s3].kind != ast.NK_LET { << no_match }
    x_base_id := tp.local_of(s3)
    if x_base_id < 0 || x_base_id == q_base_id || w.local_type(tp, x_base_id) != 1 { << no_match }
    off_x := w.tensor_scaled_offset(p, tp, p.nodes[s3].a, b_iv, 32)
    if off_x == -2 { << no_match }

    s4 := p.nodes[s3].next
    if ai.static_range_extent(p, s4) != 16 { << no_match }
    j_iv := tp.local_of(s4)
    if j_iv < 0 || j_iv == b_iv { << no_match }

    is1 := p.nodes[s4].c
    if is1 < 0 || p.nodes[is1].kind != ast.NK_LET { << no_match }
    byte_id := tp.local_of(is1)
    if byte_id < 0 || w.local_type(tp, byte_id) != 1 { << no_match }
    byte_cast := p.nodes[is1].a
    if byte_cast < 0 || p.nodes[byte_cast].kind != ast.NK_CAST || tp.type_of(byte_cast) != 1 {
        << no_match
    }
    qs_idx := p.nodes[byte_cast].a
    if qs_idx < 0 || p.nodes[qs_idx].kind != ast.NK_INDEX || tp.type_of(qs_idx) != TENSOR_U8 {
        << no_match
    }
    qs := p.nodes[qs_idx].a
    if !w.tensor_typed_array_base(p, tp, qs, TENSOR_U8) { << no_match }
    if !ai.tensor_add_local_iv(p, tp, p.nodes[qs_idx].b, q_base_id, j_iv) { << no_match }

    is2 := p.nodes[is1].next
    if is2 < 0 || p.nodes[is2].kind != ast.NK_LET { << no_match }
    q0_id := tp.local_of(is2)
    if q0_id < 0 || w.local_type(tp, q0_id) != 1 { << no_match }
    q0_sub := p.nodes[is2].a
    if q0_sub < 0 || p.nodes[q0_sub].kind != ast.NK_BIN_OP || p.nodes[q0_sub].ival != ast.OP_SUB ||
       !ai.tensor_bit_and_byte_15(p, tp, p.nodes[q0_sub].a, byte_id) ||
       !ai.tensor_int_lit(p, p.nodes[q0_sub].b, 8) {
        << no_match
    }

    is3 := p.nodes[is2].next
    if is3 < 0 || p.nodes[is3].kind != ast.NK_LET { << no_match }
    q1_id := tp.local_of(is3)
    if q1_id < 0 || q1_id == q0_id || w.local_type(tp, q1_id) != 1 { << no_match }
    q1_sub := p.nodes[is3].a
    if q1_sub < 0 || p.nodes[q1_sub].kind != ast.NK_BIN_OP || p.nodes[q1_sub].ival != ast.OP_SUB ||
       !ai.tensor_shr_byte_4(p, tp, p.nodes[q1_sub].a, byte_id) ||
       !ai.tensor_int_lit(p, p.nodes[q1_sub].b, 8) {
        << no_match
    }

    is4 := p.nodes[is3].next
    if is4 < 0 || p.nodes[is4].kind != ast.NK_ASSIGN || p.nodes[is4].ival != ast.AS_ADD ||
       p.nodes[is4].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[is4].a, bsum_id) {
        << no_match
    }
    pair := p.nodes[is4].b
    if pair < 0 || p.nodes[pair].kind != ast.NK_BIN_OP || p.nodes[pair].ival != ast.OP_ADD ||
       tp.type_of(pair) != ai.TENSOR_F32 {
        << no_match
    }
    $x0 := -1
    $x1 := -1
    if !ai.tensor_q4_term(p, tp, p.nodes[pair].a, q0_id, x_base_id, 0, j_iv, $&x0) ||
       !ai.tensor_q4_term(p, tp, p.nodes[pair].b, q1_id, x_base_id, 16, j_iv, $&x1) {
        << no_match
    }
    if !w.tensor_f32_array_base(p, tp, x0) || !w.tensor_f32_array_base(p, tp, x1) ||
       tp.local_of(x0) != tp.local_of(x1) {
        << no_match
    }

    s5 := p.nodes[s4].next
    if s5 < 0 || p.nodes[s5].next >= 0 { << no_match }
    stmt5 := ai.tensor_assignment(p, s5, ast.AS_ADD, ast.OP_MUL)
    if stmt5 < 0 { << no_match }
    acc_id := w.tensor_read_local(p, tp, p.nodes[stmt5].a)
    if acc_id < 0 || acc_id == bsum_id || w.local_type(tp, acc_id) != ai.TENSOR_F32 { << no_match }

    mul := p.nodes[stmt5].b
    if tp.type_of(mul) != ai.TENSOR_F32 { << no_match }
    ma := p.nodes[mul].a
    mb := p.nodes[mul].b
    $sc_idx := -1
    if ai.tensor_ident_id(p, tp, ma, bsum_id) && mb >= 0 && p.nodes[mb].kind == ast.NK_INDEX {
        sc_idx = mb
    } else if ai.tensor_ident_id(p, tp, mb, bsum_id) && ma >= 0 && p.nodes[ma].kind == ast.NK_INDEX {
        sc_idx = ma
    } else {
        << no_match
    }
    if tp.type_of(sc_idx) != ai.TENSOR_F32 { << no_match }
    scales := p.nodes[sc_idx].a
    if !w.tensor_f32_array_base(p, tp, scales) { << no_match }
    off_s := w.tensor_dot_offset(p, tp, p.nodes[sc_idx].b, b_iv)
    if off_s == -2 { << no_match }

    << TensorQ4DotPlan{loop: loop, bound: bound, qs: qs, scales: scales, x: x0,
                       off_q: off_q, off_s: off_s, off_x: off_x, accum_slot: w.lslot[acc_id]}
}

fn (w $&Lw) lower_tensor_dot_q4_0(p &parser.Parser, tp &types.TypedProgram, loop int) int {
    if w.tgt_arch != 0 && w.tgt_arch != 1 { << -1 }
    plan := w.tensor_q4_dot_plan(p, tp, loop)
    if plan.loop < 0 { << -1 }

    w.cur_line = p.nodes[plan.loop].line
    n_blocks := w.lower_expr(p, tp, plan.bound)
    done := w.new_block()
    check := w.new_block()
    w.branch(w.bin(BIN_GT, n_blocks, w.konst(0)), check, done)

    w.f.active_bb = check
    n_fits := w.bin(BIN_LE, n_blocks, w.konst(1 << 50))
    off_limit := w.konst(1 << 54)
    q_elems := w.bin(BIN_MUL, n_blocks, w.konst(16))
    x_elems := w.bin(BIN_MUL, n_blocks, w.konst(32))
    op_qs := w.tensor_strided_operand(p, tp, plan.qs, plan.off_q, q_elems, 1, off_limit)
    op_scales := w.tensor_strided_operand(p, tp, plan.scales, plan.off_s, n_blocks, 4, off_limit)
    op_x := w.tensor_strided_operand(p, tp, plan.x, plan.off_x, x_elems, 4, off_limit)
    valid := w.bin(BIN_AND, n_fits, w.bin(BIN_AND, op_qs.valid, w.bin(BIN_AND, op_scales.valid, op_x.valid)))
    fast := w.new_block()
    slow := w.new_block()
    w.branch(valid, fast, slow)

    w.f.active_bb = fast
    $stub := "__xu_tensor_dot_q4_0_f32"
    if w.tensor_fast_math { stub = "__xu_tensor_dot_q4_0_fast_f32" }
    $args := []int{}
    args.push(op_qs.ptr)
    args.push(op_scales.ptr)
    args.push(op_x.ptr)
    args.push(n_blocks)
    args.push(w.load_local(plan.accum_slot, 0))
    sum := w.call(stub, &args)
    w.store_local(plan.accum_slot, 0, sum)
    w.jump(done)

    w.f.active_bb = slow
    w.lower_stmt(p, tp, plan.loop)
    w.jump(done)

    w.f.active_bb = done
    << plan.loop
}

struct TensorQ4Q8DotPlan {
    loop int
    bound int
    qs int
    ws int
    xq int
    xs int
    off_q int
    off_ws int
    off_xq int
    off_xs int
    accum_id int
    accum_slot int
}

fn (w &Lw) tensor_q4_q8_dot_match_in(p &parser.Parser, tp &types.TypedProgram, b_loop int,
                                      expect_q_off_id int, expect_ws_off_id int, expect_acc_id int,
                                      allow &[]int) TensorQ4Q8DotPlan {
    no_match := TensorQ4Q8DotPlan{loop: -1, bound: -1, qs: -1, ws: -1, xq: -1, xs: -1,
                                  off_q: -2, off_ws: -2, off_xq: -2, off_xs: -2,
                                  accum_id: -1, accum_slot: -1}
    bound := ai.tensor_dynamic_bound(p, b_loop)
    if !w.tensor_dot_bound_ok(p, tp, bound) { << no_match }
    b_iv := tp.local_of(b_loop)
    if b_iv < 0 { << no_match }

    s1 := p.nodes[b_loop].c
    if s1 < 0 || p.nodes[s1].kind != ast.NK_LET || !ai.tensor_int_zero(p, p.nodes[s1].a) {
        << no_match
    }
    isum_id := tp.local_of(s1)
    if isum_id < 0 || w.local_type(tp, isum_id) != 1 { << no_match }

    s2 := p.nodes[s1].next
    if s2 < 0 || p.nodes[s2].kind != ast.NK_LET { << no_match }
    q_base_id := tp.local_of(s2)
    if q_base_id < 0 || w.local_type(tp, q_base_id) != 1 { << no_match }
    $off_q := -2
    if expect_q_off_id >= 0 {
        q_init := p.nodes[s2].a
        if q_init < 0 || p.nodes[q_init].kind != ast.NK_BIN_OP || p.nodes[q_init].ival != ast.OP_ADD {
            << no_match
        }
        if ai.tensor_ident_id(p, tp, p.nodes[q_init].a, expect_q_off_id) &&
           ai.tensor_scaled_mul_iv(p, tp, p.nodes[q_init].b, b_iv, 16) {
            off_q = -1
        } else if ai.tensor_ident_id(p, tp, p.nodes[q_init].b, expect_q_off_id) &&
                  ai.tensor_scaled_mul_iv(p, tp, p.nodes[q_init].a, b_iv, 16) {
            off_q = -1
        } else {
            << no_match
        }
    } else {
        off_q = w.tensor_scaled_offset_in(p, tp, p.nodes[s2].a, b_iv, 16, allow)
        if off_q == -2 { << no_match }
    }

    s3 := p.nodes[s2].next
    if s3 < 0 || p.nodes[s3].kind != ast.NK_LET { << no_match }
    x_base_id := tp.local_of(s3)
    if x_base_id < 0 || x_base_id == q_base_id || w.local_type(tp, x_base_id) != 1 { << no_match }
    off_xq := w.tensor_scaled_offset_in(p, tp, p.nodes[s3].a, b_iv, 32, allow)
    if off_xq == -2 { << no_match }

    s4 := p.nodes[s3].next
    if ai.static_range_extent(p, s4) != 16 { << no_match }
    j_iv := tp.local_of(s4)
    if j_iv < 0 || j_iv == b_iv { << no_match }

    is1 := p.nodes[s4].c
    if is1 < 0 || p.nodes[is1].kind != ast.NK_LET { << no_match }
    bv_id := tp.local_of(is1)
    if bv_id < 0 || w.local_type(tp, bv_id) != 1 { << no_match }
    bv_cast := p.nodes[is1].a
    if bv_cast < 0 || p.nodes[bv_cast].kind != ast.NK_CAST || tp.type_of(bv_cast) != 1 {
        << no_match
    }
    qs_idx := p.nodes[bv_cast].a
    if qs_idx < 0 || p.nodes[qs_idx].kind != ast.NK_INDEX || tp.type_of(qs_idx) != TENSOR_U8 {
        << no_match
    }
    qs := p.nodes[qs_idx].a
    if !w.tensor_typed_array_base(p, tp, qs, TENSOR_U8) { << no_match }
    if !ai.tensor_add_local_iv(p, tp, p.nodes[qs_idx].b, q_base_id, j_iv) { << no_match }

    is2 := p.nodes[is1].next
    if is2 < 0 || p.nodes[is2].kind != ast.NK_LET { << no_match }
    q0_id := tp.local_of(is2)
    if q0_id < 0 || w.local_type(tp, q0_id) != 1 { << no_match }
    q0_sub := p.nodes[is2].a
    if q0_sub < 0 || p.nodes[q0_sub].kind != ast.NK_BIN_OP || p.nodes[q0_sub].ival != ast.OP_SUB ||
       !ai.tensor_bit_and_byte_15(p, tp, p.nodes[q0_sub].a, bv_id) ||
       !ai.tensor_int_lit(p, p.nodes[q0_sub].b, 8) {
        << no_match
    }

    is3 := p.nodes[is2].next
    if is3 < 0 || p.nodes[is3].kind != ast.NK_LET { << no_match }
    q1_id := tp.local_of(is3)
    if q1_id < 0 || q1_id == q0_id || w.local_type(tp, q1_id) != 1 { << no_match }
    q1_sub := p.nodes[is3].a
    if q1_sub < 0 || p.nodes[q1_sub].kind != ast.NK_BIN_OP || p.nodes[q1_sub].ival != ast.OP_SUB ||
       !ai.tensor_shr_byte_4(p, tp, p.nodes[q1_sub].a, bv_id) ||
       !ai.tensor_int_lit(p, p.nodes[q1_sub].b, 8) {
        << no_match
    }

    is4 := p.nodes[is3].next
    if is4 < 0 || p.nodes[is4].kind != ast.NK_ASSIGN || p.nodes[is4].ival != ast.AS_ADD ||
       p.nodes[is4].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[is4].a, isum_id) {
        << no_match
    }
    pair := p.nodes[is4].b
    if pair < 0 || p.nodes[pair].kind != ast.NK_BIN_OP || p.nodes[pair].ival != ast.OP_ADD ||
       tp.type_of(pair) != 1 {
        << no_match
    }
    $xq0 := -1
    $xq1 := -1
    if !ai.tensor_q4_q8_term(p, tp, p.nodes[pair].a, q0_id, x_base_id, 0, j_iv, $&xq0) ||
       !ai.tensor_q4_q8_term(p, tp, p.nodes[pair].b, q1_id, x_base_id, 16, j_iv, $&xq1) {
        << no_match
    }
    if !w.tensor_typed_array_base(p, tp, xq0, ai.TENSOR_I8) ||
       !w.tensor_typed_array_base(p, tp, xq1, ai.TENSOR_I8) ||
       tp.local_of(xq0) != tp.local_of(xq1) {
        << no_match
    }

    s5 := p.nodes[s4].next
    if s5 < 0 || p.nodes[s5].next >= 0 { << no_match }
    stmt5 := ai.tensor_assignment(p, s5, ast.AS_ADD, ast.OP_MUL)
    if stmt5 < 0 { << no_match }
    $acc_id := expect_acc_id
    $acc_slot := -1
    if expect_acc_id >= 0 {
        if !ai.tensor_ident_id(p, tp, p.nodes[stmt5].a, expect_acc_id) { << no_match }
    } else {
        acc_id = w.tensor_read_local(p, tp, p.nodes[stmt5].a)
        if acc_id < 0 || w.local_type(tp, acc_id) != ai.TENSOR_F32 { << no_match }
        acc_slot = w.lslot[acc_id]
    }

    mul := p.nodes[stmt5].b
    if tp.type_of(mul) != ai.TENSOR_F32 { << no_match }
    ma := p.nodes[mul].a
    mb := p.nodes[mul].b
    $smul := -1
    if ai.tensor_f32_cast_ident(p, tp, ma, isum_id) {
        smul = mb
    } else if ai.tensor_f32_cast_ident(p, tp, mb, isum_id) {
        smul = ma
    } else {
        << no_match
    }
    if smul < 0 || p.nodes[smul].kind != ast.NK_BIN_OP || p.nodes[smul].ival != ast.OP_MUL ||
       tp.type_of(smul) != ai.TENSOR_F32 {
        << no_match
    }
    si_a := p.nodes[smul].a
    si_b := p.nodes[smul].b
    if si_a < 0 || p.nodes[si_a].kind != ast.NK_INDEX || tp.type_of(si_a) != ai.TENSOR_F32 ||
       si_b < 0 || p.nodes[si_b].kind != ast.NK_INDEX || tp.type_of(si_b) != ai.TENSOR_F32 {
        << no_match
    }

    $ws_idx := si_a
    $xs_idx := si_b
    if expect_ws_off_id >= 0 {
        if ai.tensor_add_local_iv(p, tp, p.nodes[si_a].b, expect_ws_off_id, b_iv) {
            ws_idx = si_a
            xs_idx = si_b
        } else if ai.tensor_add_local_iv(p, tp, p.nodes[si_b].b, expect_ws_off_id, b_iv) {
            ws_idx = si_b
            xs_idx = si_a
        } else {
            << no_match
        }
    }
    ws := p.nodes[ws_idx].a
    xs := p.nodes[xs_idx].a
    if !w.tensor_f32_array_base(p, tp, ws) || !w.tensor_f32_array_base(p, tp, xs) {
        << no_match
    }
    $off_ws := -1
    if expect_ws_off_id < 0 {
        off_ws = w.tensor_dot_offset_in(p, tp, p.nodes[ws_idx].b, b_iv, allow)
        if off_ws == -2 { << no_match }
    }
    off_xs := w.tensor_dot_offset_in(p, tp, p.nodes[xs_idx].b, b_iv, allow)
    if off_xs == -2 { << no_match }

    << TensorQ4Q8DotPlan{loop: b_loop, bound: bound, qs: qs, ws: ws, xq: xq0, xs: xs,
                         off_q: off_q, off_ws: off_ws, off_xq: off_xq, off_xs: off_xs,
                         accum_id: acc_id, accum_slot: acc_slot}
}

fn (w &Lw) tensor_q4_q8_dot_match(p &parser.Parser, tp &types.TypedProgram, b_loop int,
                                   expect_q_off_id int, expect_ws_off_id int, expect_acc_id int) TensorQ4Q8DotPlan {
    empty := []int{}
    << w.tensor_q4_q8_dot_match_in(p, tp, b_loop, expect_q_off_id, expect_ws_off_id, expect_acc_id, &empty)
}

fn (w $&Lw) lower_tensor_dot_q4_0_q8_0(p &parser.Parser, tp &types.TypedProgram, loop int) int {
    if w.tgt_arch != 0 && w.tgt_arch != 1 { << -1 }
    plan := w.tensor_q4_q8_dot_match(p, tp, loop, -1, -1, -1)
    if plan.loop < 0 { << -1 }

    w.cur_line = p.nodes[plan.loop].line
    n_blocks := w.lower_expr(p, tp, plan.bound)
    done := w.new_block()
    check := w.new_block()
    w.branch(w.bin(BIN_GT, n_blocks, w.konst(0)), check, done)

    w.f.active_bb = check
    n_fits := w.bin(BIN_LE, n_blocks, w.konst(1 << 50))
    off_limit := w.konst(1 << 54)
    q_elems := w.bin(BIN_MUL, n_blocks, w.konst(16))
    x_elems := w.bin(BIN_MUL, n_blocks, w.konst(32))
    op_qs := w.tensor_strided_operand(p, tp, plan.qs, plan.off_q, q_elems, 1, off_limit)
    op_ws := w.tensor_strided_operand(p, tp, plan.ws, plan.off_ws, n_blocks, 4, off_limit)
    op_xq := w.tensor_strided_operand(p, tp, plan.xq, plan.off_xq, x_elems, 1, off_limit)
    op_xs := w.tensor_strided_operand(p, tp, plan.xs, plan.off_xs, n_blocks, 4, off_limit)
    valid := w.bin(BIN_AND, n_fits,
             w.bin(BIN_AND, op_qs.valid,
             w.bin(BIN_AND, op_ws.valid,
             w.bin(BIN_AND, op_xq.valid, op_xs.valid))))
    fast := w.new_block()
    slow := w.new_block()
    w.branch(valid, fast, slow)

    w.f.active_bb = fast
    $stub := "__xu_tensor_dot_q4_0_q8_0_f32"
    if w.tensor_fast_math { stub = "__xu_tensor_dot_q4_0_q8_0_fast_f32" }
    $args := []int{}
    args.push(op_qs.ptr)
    args.push(op_ws.ptr)
    args.push(op_xq.ptr)
    args.push(op_xs.ptr)
    args.push(n_blocks)
    args.push(w.load_local(plan.accum_slot, 0))
    sum := w.call(stub, &args)
    w.store_local(plan.accum_slot, 0, sum)
    w.jump(done)

    w.f.active_bb = slow
    w.lower_stmt(p, tp, plan.loop)
    w.jump(done)

    w.f.active_bb = done
    << plan.loop
}

const F64_BITS_HALF = 0x3fe0000000000000
const F64_BITS_ONE = 0x3ff0000000000000
const F64_BITS_127 = 0x405fc00000000000

// Lower canonical block-32 Q8_0 activation quantization loops into ARM64 NEON / x64 SSE2:
//   for b in 0:nb {
//       base := b * 32
//       $amax := 0.0
//       for i in 0:32 { $v := f64(x[base + i]); if v < 0.0 { v = -v }; if v > amax { amax = v } }
//       scale := f32(amax / 127.0)
//       x_scales[off_xs + b] = scale
//       $inv := 0.0
//       if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
//       for i in 0:32 {
//           vf := f64(x[base + i]) * inv
//           $q := 0
//           if vf >= 0.0 { q = int(vf + 0.5) } else { q = -int(0.5 - vf) }
//           if q > 127 { q = 127 }
//           if q < -127 { q = -127 }
//           xq[base + i] = i8(q)
//       }
//   }
struct TensorQ8Plan {
    loop int
    bound int
    x int
    xq int
    xs int
    off_x int
    off_xq int
    off_xs int
}

fn (w &Lw) tensor_q8_quant_plan(p &parser.Parser, tp &types.TypedProgram, loop int) TensorQ8Plan {
    no_match := TensorQ8Plan{loop: -1, bound: -1, x: -1, xq: -1, xs: -1,
                             off_x: -2, off_xq: -2, off_xs: -2}
    bound := ai.tensor_dynamic_bound(p, loop)
    if !w.tensor_dot_bound_ok(p, tp, bound) { << no_match }
    b_iv := tp.local_of(loop)
    if b_iv < 0 { << no_match }

    // base := b * 32
    s1 := p.nodes[loop].c
    if s1 < 0 || p.nodes[s1].kind != ast.NK_LET { << no_match }
    base_id := tp.local_of(s1)
    if base_id < 0 || w.local_type(tp, base_id) != 1 { << no_match }
    if !ai.tensor_scaled_mul_iv(p, tp, p.nodes[s1].a, b_iv, 32) { << no_match }

    // $amax := 0.0
    s2 := p.nodes[s1].next
    if s2 < 0 || p.nodes[s2].kind != ast.NK_LET || !ai.tensor_f64_lit(p, tp, p.nodes[s2].a, 0) {
        << no_match
    }
    amax_id := tp.local_of(s2)
    if amax_id < 0 || w.local_type(tp, amax_id) != ai.TENSOR_F64 { << no_match }

    // for i in 0:32 { $v := f64(x[base + i]); if v < 0.0 { v = -v }; if v > amax { amax = v } }
    s3 := p.nodes[s2].next
    if ai.static_range_extent(p, s3) != 32 { << no_match }
    i_iv := tp.local_of(s3)
    if i_iv < 0 || i_iv == b_iv { << no_match }

    l1 := p.nodes[s3].c
    if l1 < 0 || p.nodes[l1].kind != ast.NK_LET { << no_match }
    v_id := tp.local_of(l1)
    if v_id < 0 || w.local_type(tp, v_id) != ai.TENSOR_F64 { << no_match }
    v_cast := p.nodes[l1].a
    if v_cast < 0 || p.nodes[v_cast].kind != ast.NK_CAST || tp.type_of(v_cast) != ai.TENSOR_F64 {
        << no_match
    }
    x1_idx := p.nodes[v_cast].a
    if x1_idx < 0 || p.nodes[x1_idx].kind != ast.NK_INDEX || tp.type_of(x1_idx) != ai.TENSOR_F32 {
        << no_match
    }
    x_arr := p.nodes[x1_idx].a
    if !w.tensor_f32_array_base(p, tp, x_arr) { << no_match }
    if !ai.tensor_add_local_iv(p, tp, p.nodes[x1_idx].b, base_id, i_iv) { << no_match }

    l2 := p.nodes[l1].next
    if l2 < 0 || p.nodes[l2].kind != ast.NK_IF { << no_match }
    l2_br := p.nodes[l2].a
    if l2_br < 0 || p.nodes[l2_br].next >= 0 { << no_match }
    l2_c := p.nodes[l2_br].a
    if l2_c < 0 || p.nodes[l2_c].kind != ast.NK_BIN_OP || p.nodes[l2_c].ival != ast.OP_LT ||
       !ai.tensor_ident_id(p, tp, p.nodes[l2_c].a, v_id) ||
       !ai.tensor_f64_lit(p, tp, p.nodes[l2_c].b, 0) {
        << no_match
    }
    l2_b := p.nodes[l2_br].b
    if l2_b < 0 || p.nodes[l2_b].kind != ast.NK_ASSIGN || p.nodes[l2_b].ival != ast.AS_ASSIGN ||
       p.nodes[l2_b].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[l2_b].a, v_id) {
        << no_match
    }
    neg_v := p.nodes[l2_b].b
    if neg_v < 0 || p.nodes[neg_v].kind != ast.NK_UN_OP || p.nodes[neg_v].ival != ast.UN_NEG ||
       !ai.tensor_ident_id(p, tp, p.nodes[neg_v].a, v_id) {
        << no_match
    }

    l3 := p.nodes[l2].next
    if l3 < 0 || p.nodes[l3].kind != ast.NK_IF || p.nodes[l3].next >= 0 { << no_match }
    l3_br := p.nodes[l3].a
    if l3_br < 0 || p.nodes[l3_br].next >= 0 { << no_match }
    l3_c := p.nodes[l3_br].a
    if l3_c < 0 || p.nodes[l3_c].kind != ast.NK_BIN_OP || p.nodes[l3_c].ival != ast.OP_GT ||
       !ai.tensor_ident_id(p, tp, p.nodes[l3_c].a, v_id) ||
       !ai.tensor_ident_id(p, tp, p.nodes[l3_c].b, amax_id) {
        << no_match
    }
    l3_b := p.nodes[l3_br].b
    if l3_b < 0 || p.nodes[l3_b].kind != ast.NK_ASSIGN || p.nodes[l3_b].ival != ast.AS_ASSIGN ||
       p.nodes[l3_b].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[l3_b].a, amax_id) ||
       !ai.tensor_ident_id(p, tp, p.nodes[l3_b].b, v_id) {
        << no_match
    }

    // scale := f32(amax / 127.0)
    s4 := p.nodes[s3].next
    if s4 < 0 || p.nodes[s4].kind != ast.NK_LET { << no_match }
    scale_id := tp.local_of(s4)
    if scale_id < 0 || w.local_type(tp, scale_id) != ai.TENSOR_F32 { << no_match }
    sc_cast := p.nodes[s4].a
    if sc_cast < 0 || p.nodes[sc_cast].kind != ast.NK_CAST || tp.type_of(sc_cast) != ai.TENSOR_F32 {
        << no_match
    }
    sc_div := p.nodes[sc_cast].a
    if sc_div < 0 || p.nodes[sc_div].kind != ast.NK_BIN_OP || p.nodes[sc_div].ival != ast.OP_DIV ||
       !ai.tensor_ident_id(p, tp, p.nodes[sc_div].a, amax_id) ||
       !ai.tensor_f64_lit(p, tp, p.nodes[sc_div].b, F64_BITS_127) {
        << no_match
    }

    // x_scales[off_xs + b] = scale
    s5 := p.nodes[s4].next
    if s5 < 0 || p.nodes[s5].kind != ast.NK_ASSIGN || p.nodes[s5].ival != ast.AS_ASSIGN ||
       !ai.tensor_ident_id(p, tp, p.nodes[s5].b, scale_id) {
        << no_match
    }
    xs_idx := p.nodes[s5].a
    if xs_idx < 0 || p.nodes[xs_idx].kind != ast.NK_INDEX || tp.type_of(xs_idx) != ai.TENSOR_F32 {
        << no_match
    }
    xs_arr := p.nodes[xs_idx].a
    if !w.tensor_f32_array_base(p, tp, xs_arr) { << no_match }
    off_xs := w.tensor_dot_offset(p, tp, p.nodes[xs_idx].b, b_iv)
    if off_xs == -2 { << no_match }

    // $inv := 0.0
    s6 := p.nodes[s5].next
    if s6 < 0 || p.nodes[s6].kind != ast.NK_LET || !ai.tensor_f64_lit(p, tp, p.nodes[s6].a, 0) {
        << no_match
    }
    inv_id := tp.local_of(s6)
    if inv_id < 0 || inv_id == amax_id || w.local_type(tp, inv_id) != ai.TENSOR_F64 { << no_match }

    // if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
    s7 := p.nodes[s6].next
    if s7 < 0 || p.nodes[s7].kind != ast.NK_IF { << no_match }
    s7_br := p.nodes[s7].a
    if s7_br < 0 || p.nodes[s7_br].next >= 0 { << no_match }
    s7_c := p.nodes[s7_br].a
    if s7_c < 0 || p.nodes[s7_c].kind != ast.NK_BIN_OP || p.nodes[s7_c].ival != ast.OP_NE ||
       !ai.tensor_f64_cast_ident(p, tp, p.nodes[s7_c].a, scale_id) ||
       !ai.tensor_f64_lit(p, tp, p.nodes[s7_c].b, 0) {
        << no_match
    }
    s7_b := p.nodes[s7_br].b
    if s7_b < 0 || p.nodes[s7_b].kind != ast.NK_ASSIGN || p.nodes[s7_b].ival != ast.AS_ASSIGN ||
       p.nodes[s7_b].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[s7_b].a, inv_id) {
        << no_match
    }
    inv_div := p.nodes[s7_b].b
    if inv_div < 0 || p.nodes[inv_div].kind != ast.NK_BIN_OP || p.nodes[inv_div].ival != ast.OP_DIV ||
       !ai.tensor_f64_lit(p, tp, p.nodes[inv_div].a, F64_BITS_ONE) ||
       !ai.tensor_f64_cast_ident(p, tp, p.nodes[inv_div].b, scale_id) {
        << no_match
    }

    // for i in 0:32 { vf := ...; $q := 0; if vf >= 0.0 ... else ...; clamps; xq[base + i] = i8(q) }
    s8 := p.nodes[s7].next
    if s8 < 0 || p.nodes[s8].next >= 0 || ai.static_range_extent(p, s8) != 32 { << no_match }
    j_iv := tp.local_of(s8)
    if j_iv < 0 || j_iv == b_iv { << no_match }

    k1 := p.nodes[s8].c
    if k1 < 0 || p.nodes[k1].kind != ast.NK_LET { << no_match }
    vf_id := tp.local_of(k1)
    if vf_id < 0 || w.local_type(tp, vf_id) != ai.TENSOR_F64 { << no_match }
    vf_mul := p.nodes[k1].a
    if vf_mul < 0 || p.nodes[vf_mul].kind != ast.NK_BIN_OP || p.nodes[vf_mul].ival != ast.OP_MUL ||
       tp.type_of(vf_mul) != ai.TENSOR_F64 {
        << no_match
    }
    $x2_cast := -1
    if ai.tensor_ident_id(p, tp, p.nodes[vf_mul].b, inv_id) {
        x2_cast = p.nodes[vf_mul].a
    } else if ai.tensor_ident_id(p, tp, p.nodes[vf_mul].a, inv_id) {
        x2_cast = p.nodes[vf_mul].b
    } else {
        << no_match
    }
    if x2_cast < 0 || p.nodes[x2_cast].kind != ast.NK_CAST || tp.type_of(x2_cast) != ai.TENSOR_F64 {
        << no_match
    }
    x2_idx := p.nodes[x2_cast].a
    if x2_idx < 0 || p.nodes[x2_idx].kind != ast.NK_INDEX || tp.type_of(x2_idx) != ai.TENSOR_F32 {
        << no_match
    }
    if tp.local_of(p.nodes[x2_idx].a) != tp.local_of(x_arr) ||
       !ai.tensor_add_local_iv(p, tp, p.nodes[x2_idx].b, base_id, j_iv) {
        << no_match
    }

    k2 := p.nodes[k1].next
    if k2 < 0 || p.nodes[k2].kind != ast.NK_LET || !ai.tensor_int_zero(p, p.nodes[k2].a) {
        << no_match
    }
    q_id := tp.local_of(k2)
    if q_id < 0 || w.local_type(tp, q_id) != 1 { << no_match }

    // if vf >= 0.0 { q = int(vf + 0.5) } else { q = -int(0.5 - vf) }
    k3 := p.nodes[k2].next
    if k3 < 0 || p.nodes[k3].kind != ast.NK_IF { << no_match }
    k3_b0 := p.nodes[k3].a
    if k3_b0 < 0 { << no_match }
    k3_c := p.nodes[k3_b0].a
    if k3_c < 0 || p.nodes[k3_c].kind != ast.NK_BIN_OP || p.nodes[k3_c].ival != ast.OP_GE ||
       !ai.tensor_ident_id(p, tp, p.nodes[k3_c].a, vf_id) ||
       !ai.tensor_f64_lit(p, tp, p.nodes[k3_c].b, 0) {
        << no_match
    }
    k3_t := p.nodes[k3_b0].b
    if k3_t < 0 || p.nodes[k3_t].kind != ast.NK_ASSIGN || p.nodes[k3_t].ival != ast.AS_ASSIGN ||
       p.nodes[k3_t].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[k3_t].a, q_id) {
        << no_match
    }
    pos_cast := p.nodes[k3_t].b
    if pos_cast < 0 || p.nodes[pos_cast].kind != ast.NK_CAST || tp.type_of(pos_cast) != 1 {
        << no_match
    }
    pos_add := p.nodes[pos_cast].a
    if pos_add < 0 || p.nodes[pos_add].kind != ast.NK_BIN_OP || p.nodes[pos_add].ival != ast.OP_ADD ||
       !((ai.tensor_ident_id(p, tp, p.nodes[pos_add].a, vf_id) && ai.tensor_f64_lit(p, tp, p.nodes[pos_add].b, F64_BITS_HALF)) ||
         (ai.tensor_ident_id(p, tp, p.nodes[pos_add].b, vf_id) && ai.tensor_f64_lit(p, tp, p.nodes[pos_add].a, F64_BITS_HALF))) {
        << no_match
    }

    k3_b1 := p.nodes[k3_b0].next
    if k3_b1 < 0 || p.nodes[k3_b1].a >= 0 || p.nodes[k3_b1].next >= 0 { << no_match }
    k3_e := p.nodes[k3_b1].b
    if k3_e < 0 || p.nodes[k3_e].kind != ast.NK_ASSIGN || p.nodes[k3_e].ival != ast.AS_ASSIGN ||
       p.nodes[k3_e].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[k3_e].a, q_id) {
        << no_match
    }
    neg_q := p.nodes[k3_e].b
    if neg_q < 0 || p.nodes[neg_q].kind != ast.NK_UN_OP || p.nodes[neg_q].ival != ast.UN_NEG {
        << no_match
    }
    neg_cast := p.nodes[neg_q].a
    if neg_cast < 0 || p.nodes[neg_cast].kind != ast.NK_CAST || tp.type_of(neg_cast) != 1 {
        << no_match
    }
    neg_sub := p.nodes[neg_cast].a
    if neg_sub < 0 || p.nodes[neg_sub].kind != ast.NK_BIN_OP || p.nodes[neg_sub].ival != ast.OP_SUB ||
       !ai.tensor_f64_lit(p, tp, p.nodes[neg_sub].a, F64_BITS_HALF) ||
       !ai.tensor_ident_id(p, tp, p.nodes[neg_sub].b, vf_id) {
        << no_match
    }

    k4 := p.nodes[k3].next
    if !ai.tensor_q8_clamp_if(p, tp, k4, q_id, ast.OP_GT, 127) { << no_match }
    k5 := p.nodes[k4].next
    if !ai.tensor_q8_clamp_if(p, tp, k5, q_id, ast.OP_LT, -127) { << no_match }

    k6 := p.nodes[k5].next
    if k6 < 0 || p.nodes[k6].kind != ast.NK_ASSIGN || p.nodes[k6].ival != ast.AS_ASSIGN ||
       p.nodes[k6].next >= 0 {
        << no_match
    }
    xq_cast := p.nodes[k6].b
    if xq_cast < 0 || p.nodes[xq_cast].kind != ast.NK_CAST || tp.type_of(xq_cast) != ai.TENSOR_I8 ||
       !ai.tensor_ident_id(p, tp, p.nodes[xq_cast].a, q_id) {
        << no_match
    }
    xq_idx := p.nodes[k6].a
    if xq_idx < 0 || p.nodes[xq_idx].kind != ast.NK_INDEX || tp.type_of(xq_idx) != ai.TENSOR_I8 {
        << no_match
    }
    xq_arr := p.nodes[xq_idx].a
    if !w.tensor_typed_array_base(p, tp, xq_arr, ai.TENSOR_I8) { << no_match }
    if !ai.tensor_add_local_iv(p, tp, p.nodes[xq_idx].b, base_id, j_iv) { << no_match }

    << TensorQ8Plan{loop: loop, bound: bound, x: x_arr, xq: xq_arr, xs: xs_arr,
                    off_x: -1, off_xq: -1, off_xs: off_xs}
}

fn (w $&Lw) lower_tensor_quantize_q8_0(p &parser.Parser, tp &types.TypedProgram, loop int) int {
    if w.tgt_arch != 0 && w.tgt_arch != 1 { << -1 }
    plan := w.tensor_q8_quant_plan(p, tp, loop)
    if plan.loop < 0 { << -1 }

    w.cur_line = p.nodes[plan.loop].line
    nb := w.lower_expr(p, tp, plan.bound)
    done := w.new_block()
    check := w.new_block()
    w.branch(w.bin(BIN_GT, nb, w.konst(0)), check, done)

    w.f.active_bb = check
    nb_fits := w.bin(BIN_LE, nb, w.konst(1 << 24))
    off_limit := w.konst(1 << 54)
    elems := w.bin(BIN_MUL, nb, w.konst(32))
    op_x := w.tensor_strided_operand(p, tp, plan.x, plan.off_x, elems, 4, off_limit)
    op_xq := w.tensor_strided_operand(p, tp, plan.xq, plan.off_xq, elems, 1, off_limit)
    op_xs := w.tensor_strided_operand(p, tp, plan.xs, plan.off_xs, nb, 4, off_limit)

    x_span := w.bin(BIN_MUL, elems, w.konst(4))
    xs_span := w.bin(BIN_MUL, nb, w.konst(4))
    addr_lim := w.konst(1 << 56)
    addr_ok := w.bin(BIN_AND, w.u64_bin(BIN_LE, op_x.ptr, w.bin(BIN_SUB, addr_lim, x_span)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_xq.ptr, w.bin(BIN_SUB, addr_lim, elems)),
                              w.u64_bin(BIN_LE, op_xs.ptr, w.bin(BIN_SUB, addr_lim, xs_span))))
    disj := w.bin(BIN_AND, w.tensor_disjoint_ranges(op_xq.ptr, elems, op_x.ptr, x_span),
            w.bin(BIN_AND, w.tensor_disjoint_ranges(op_xs.ptr, xs_span, op_x.ptr, x_span),
                           w.tensor_disjoint_ranges(op_xq.ptr, elems, op_xs.ptr, xs_span)))

    valid := w.bin(BIN_AND, nb_fits,
             w.bin(BIN_AND, op_x.valid,
             w.bin(BIN_AND, op_xq.valid,
             w.bin(BIN_AND, op_xs.valid, w.bin(BIN_AND, addr_ok, disj)))))
    fast := w.new_block()
    slow := w.new_block()
    w.branch(valid, fast, slow)

    w.f.active_bb = fast
    $stub := "__xu_tensor_quantize_q8_0"
    if w.tensor_fast_math { stub = "__xu_tensor_quantize_q8_0_fast" }
    $args := []int{}
    args.push(op_x.ptr)
    args.push(op_xq.ptr)
    args.push(op_xs.ptr)
    args.push(nb)
    w.call(stub, &args)
    w.jump(done)

    w.f.active_bb = slow
    w.lower_stmt(p, tp, plan.loop)
    w.jump(done)

    w.f.active_bb = done
    << plan.loop
}

// Lower #tensor K-quant row dot products (dot_q{4,5,6}_k_q8_k_row_f32) after bounds
// validation directly onto ARM64 NEON sdot / x86-64 SSSE3 pmaddubsw micro-kernels.
fn (w $&Lw) lower_tensor_dot_k_quant(p &parser.Parser, tp &types.TypedProgram, loop int) int {
    if w.tgt_arch != 0 && w.tgt_arch != 1 { << -1 }
    if tp.fns[w.fi].mod_id != "tensor" { << -1 }
    $stub := ""
    $is_q6 := false
    if w.f.name == "dot_q4_k_q8_k_row_f32" {
        stub = "__xu_tensor_dot_q4_k_q8_k_f32"
    } else if w.f.name == "dot_q5_k_q8_k_row_f32" {
        stub = "__xu_tensor_dot_q5_k_q8_k_f32"
    } else if w.f.name == "dot_q6_k_q8_k_row_f32" {
        stub = "__xu_tensor_dot_q6_k_q8_k_f32"
        is_q6 = true
    } else {
        << -1
    }

    ret_stmt := p.nodes[loop].next
    if ret_stmt < 0 || p.nodes[ret_stmt].kind != ast.NK_RETURN || p.nodes[ret_stmt].a < 0 {
        << -1
    }
    ret_expr := p.nodes[ret_stmt].a
    if p.nodes[ret_expr].kind != ast.NK_IDENT || tp.type_of(ret_expr) != ai.TENSOR_F32 {
        << -1
    }
    total_id := tp.local_of(ret_expr)
    if total_id < 0 || total_id >= w.lslot.len || w.lslot[total_id] < 0 { << -1 }

    w.cur_line = p.nodes[loop].line
    storage_ptr := w.load_ptr(w.load_local(w.lslot[0], 0), 0, 8)
    src_ptr := w.bin(BIN_ADD, storage_ptr, w.load_local(w.lslot[1], 0))
    qs_ptr := w.load_ptr(w.load_local(w.lslot[2], 0), 0, 8)
    d_ptr := w.load_ptr(w.load_local(w.lslot[3], 0), 0, 8)

    $args := []int{}
    args.push(src_ptr)
    args.push(qs_ptr)
    args.push(d_ptr)
    if is_q6 {
        args.push(w.load_local(w.lslot[4], 0))
    } else {
        bs_ptr := w.load_ptr(w.load_local(w.lslot[4], 0), 0, 8)
        args.push(bs_ptr)
        args.push(w.load_local(w.lslot[5], 0))
    }
    sum := w.call(stub, &args)
    w.store_local(w.lslot[total_id], 0, sum)
    << loop
}
