@xu/mir
// Loop-Invariant Code Motion (LICM) optimization pass.
//
// Layer 3 module: identifies natural loops (self-loops and multi-block loops),
// finds loop-invariant computations (pure arithmetic, constants, unmodified
// local variable loads), and hoists them to loop preheaders.

fn is_pure_instr(kind int) bool {
    if kind == MI_COPY || kind == MI_LOAD_LOCAL || kind == MI_UN ||
       kind == MI_BIN || kind == MI_STR_CONST || kind == MI_LOAD_FIELD ||
       kind == MI_ELEM_ADDR || kind == MI_LOAD_PTR || kind == MI_LOAD_BUF_PTR {
        << true
    }
    << false
}

pub fn instr_has_dest(kind int) bool {
    if kind == MI_NOP || kind == MI_STORE_LOCAL || kind == MI_DROP ||
       kind == MI_STORE_FIELD || kind == MI_ARR_PUSH || kind == MI_STORE_PTR ||
       kind == MI_STORE_INDEX || kind == MI_DROP_FIELD || kind == MI_DROP_PTR_FIELD ||
       kind == MI_DROP_BUF_FIELD || kind == MI_STORE_BUF_PTR || kind == MI_CHAN_SEND ||
       kind == MI_XU || kind == MI_CHAN_CLOSE || kind == MI_XU_PUMP ||
       kind == MI_ARR_PUSH4 || kind == MI_INDEX_RMW || kind == MI_FIELD_RMW {
        << false
    }
    << true
}

fn licm_instr_dest(f &MFn, ii int) int {
    if ii < 0 || ii >= f.instrs.len {
        << -1
    }
    k := f.instrs[ii].kind
    if !instr_has_dest(k) {
        << -1
    }
    << f.instrs[ii].a
}

fn block_is_effectively_empty(f &MFn, bi int) bool {
    if bi < 0 || bi >= f.blocks.len {
        << false
    }
    $ii := f.blocks[bi].head
    while ii >= 0 && ii < f.instrs.len {
        if f.instrs[ii].kind != MI_NOP {
            << false
        }
        ii = f.instrs[ii].next
    }
    << true
}

fn skip_empty_jumps(f &MFn, start int) int {
    $b := start
    n := f.blocks.len
    for _ in 0:n {
        if b < 0 || b >= n {
            << start
        }
        if !block_is_effectively_empty(f, b) {
            << b
        }
        tk := f.blocks[b].tkind
        $nxt := -1
        if tk == TKIND_JUMP {
            nxt = f.blocks[b].ta
        } else if tk == TKIND_BRANCH {
            tb := f.blocks[b].tb
            tc := f.blocks[b].tc
            if tb == tc && tb >= 0 {
                nxt = tb
            } else {
                << b
            }
        } else {
            << b
        }
        if nxt == b || nxt < 0 || nxt >= n {
            << b
        }
        b = nxt
    }
    << b
}

fn is_self_loop(f &MFn, bi int) bool {
    if bi < 0 || bi >= f.blocks.len {
        << false
    }
    tk := f.blocks[bi].tkind
    if tk == TKIND_JUMP && f.blocks[bi].ta == bi {
        << true
    }
    if tk == TKIND_BRANCH && (f.blocks[bi].tb == bi || f.blocks[bi].tc == bi) {
        << true
    }
    << false
}

fn unique_ext_pred_excluding(f &MFn, bi int, exclude int) int {
    $pred := -1
    for pi in 0:f.blocks.len {
        if pi == bi || pi == exclude {
            ->
        }
        $hits := false
        tk := f.blocks[pi].tkind
        if tk == TKIND_JUMP && f.blocks[pi].ta == bi {
            hits = true
        }
        if tk == TKIND_BRANCH && (f.blocks[pi].tb == bi || f.blocks[pi].tc == bi) {
            hits = true
        }
        if hits {
            if pred >= 0 {
                << -1
            }
            pred = pi
        }
    }
    << pred
}

fn unique_ext_pred(f &MFn, bi int) int {
    << unique_ext_pred_excluding(f, bi, -1)
}

pub fn mir_detach_instr(f $&MFn, bi int, ii int) bool {
    if bi < 0 || bi >= f.blocks.len || ii < 0 || ii >= f.instrs.len {
        << false
    }
    $b := ~f.blocks[bi]
    $prev := -1
    $p := b.head
    while p >= 0 && p < f.instrs.len {
        if p == ii {
            nxt := f.instrs[p].next
            if prev < 0 {
                b.head = nxt
            } else {
                f.instrs[prev].next = nxt
            }
            if b.tail == ii {
                b.tail = prev
            }
            f.instrs[ii].next = -1
            f.blocks[bi] = ~b
            << true
        }
        prev = p
        p = f.instrs[p].next
    }
    << false
}

pub fn mir_append_instr(f $&MFn, bi int, ii int) {
    if bi < 0 || bi >= f.blocks.len || ii < 0 || ii >= f.instrs.len {
        <<
    }
    $b := ~f.blocks[bi]
    f.instrs[ii].next = -1
    if b.head < 0 {
        b.head = ii
        b.tail = ii
    } else {
        tail := b.tail
        if tail >= 0 && tail < f.instrs.len {
            f.instrs[tail].next = ii
        }
        b.tail = ii
    }
    f.blocks[bi] = ~b
}

fn is_val_invariant(v int, loop_defs &[]bool, hoisted &[]bool) bool {
    if v <= -2 {
        << true
    }
    if v >= 0 && v < loop_defs.len {
        if !loop_defs[v] {
            << true
        }
        if v < hoisted.len && hoisted[v] {
            << true
        }
        << false
    }
    << true
}

pub fn opt_licm(f $&MFn) {
    if f.blocks.len == 0 || f.instrs.len == 0 {
        <<
    }

    nloc := f.locals.len
    ntmp := f.temps.len

    // Count definitions of each temporary across the whole function
    $ndef := []int{}
    for _ in 0:ntmp {
        ndef.push(0)
    }
    for bi0 in 0:f.blocks.len {
        $p := f.blocks[bi0].head
        while p >= 0 && p < f.instrs.len {
            d := licm_instr_dest(f, p)
            if d >= 0 && d < ndef.len {
                ndef[d] = ndef[d] + 1
            }
            p = f.instrs[p].next
        }
    }

    // 1. Process single-block self loops
    for bi in 0:f.blocks.len {
        if !is_self_loop(f, bi) {
            ->
        }
        pred := unique_ext_pred(f, bi)
        if pred < 0 {
            ->
        }

        $skip := false
        $has_call := false
        $stored := []bool{}
        for _ in 0:nloc {
            stored.push(false)
        }
        $loop_defs := []bool{}
        for _ in 0:ntmp {
            loop_defs.push(false)
        }

        $ii := f.blocks[bi].head
        while ii >= 0 && ii < f.instrs.len {
            k := f.instrs[ii].kind
            ia := f.instrs[ii].a
            if k == MI_CALL {
                has_call = true
            }
            if k == MI_STORE_LOCAL {
                if ia >= 0 && ia < stored.len {
                    stored[ia] = true
                }
            }
            if k == MI_ARRAY_LIT || k == MI_ARR_PUSH || k == MI_ARR_PUSH4 ||
               k == MI_CHAN_NEW || k == MI_CHAN_SEND || k == MI_CHAN_RECV ||
               k == MI_XU || k == MI_CHAN_CLOSE || k == MI_CHAN_TRY_SEND ||
               k == MI_CHAN_TRY_RECV || k == MI_XU_PUMP {
                skip = true
            }
            d := licm_instr_dest(f, ii)
            if d >= 0 && d < loop_defs.len {
                loop_defs[d] = true
            }
            ii = f.instrs[ii].next
        }

        if skip || has_call {
            ->
        }

        $hoist := []int{}
        $hoisted := []bool{}
        for _ in 0:ntmp {
            hoisted.push(false)
        }

        ii = f.blocks[bi].head
        while ii >= 0 && ii < f.instrs.len {
            nxt := f.instrs[ii].next
            k := f.instrs[ii].kind
            dest := licm_instr_dest(f, ii)
            $take := false

            if dest >= 0 && dest < ndef.len && ndef[dest] == 1 && is_pure_instr(k) {
                if k == MI_LOAD_LOCAL {
                    loc := f.instrs[ii].b
                    if loc >= 0 && loc < stored.len && !stored[loc] {
                        take = true
                    }
                } else if k == MI_COPY {
                    v := f.instrs[ii].b
                    if is_val_invariant(v, &loop_defs, &hoisted) {
                        take = true
                    }
                } else if k == MI_UN {
                    v := f.instrs[ii].c
                    if is_val_invariant(v, &loop_defs, &hoisted) {
                        take = true
                    }
                } else if k == MI_STR_CONST {
                    take = true
                } else if k == MI_BIN {
                    op := f.instrs[ii].b
                    lhs := f.instrs[ii].c
                    rhs := f.instrs[ii].d
                    if is_val_invariant(lhs, &loop_defs, &hoisted) && is_val_invariant(rhs, &loop_defs, &hoisted) {
                        if op != BIN_DIV && op != BIN_MOD {
                            take = true
                        } else if rhs <= -2 {
                            cidx := 0 - rhs - 2
                            if cidx >= 0 && cidx < f.consts.len && f.consts[cidx] != 0 {
                                take = true
                            }
                        }
                    }
                }
            }

            if take {
                if dest >= 0 && dest < hoisted.len {
                    hoisted[dest] = true
                }
                hoist.push(ii)
            }
            ii = nxt
        }

        for hi in 0:hoist.len {
            mir_detach_instr(f, bi, hoist[hi])
            mir_append_instr(f, pred, hoist[hi])
        }
    }

    // 2. Process multi-block loops (header -> body -> header)
    for header in 0:f.blocks.len {
        if f.blocks[header].tkind != TKIND_BRANCH {
            ->
        }
        tb := skip_empty_jumps(f, f.blocks[header].tb)
        tc := skip_empty_jumps(f, f.blocks[header].tc)
        $loop_blks := []int{}
        $back_blk := -1

        for arm in 0:2 {
            if back_blk >= 0 {
                <-
            }
            $b1 := tb
            if arm == 1 {
                b1 = tc
            }
            if b1 < 0 || b1 >= f.blocks.len || b1 == header {
                ->
            }
            if unique_ext_pred(f, b1) != header {
                ->
            }
            if f.blocks[b1].tkind != TKIND_JUMP {
                ->
            }
            succ1 := skip_empty_jumps(f, f.blocks[b1].ta)
            if succ1 == header {
                loop_blks.push(header)
                loop_blks.push(b1)
                back_blk = b1
            } else if succ1 >= 0 && succ1 < f.blocks.len && succ1 != b1 && succ1 != header {
                b2 := succ1
                if unique_ext_pred(f, b2) == b1 && f.blocks[b2].tkind == TKIND_JUMP {
                    succ2 := skip_empty_jumps(f, f.blocks[b2].ta)
                    if succ2 == header {
                        loop_blks.push(header)
                        loop_blks.push(b1)
                        loop_blks.push(b2)
                        back_blk = b2
                    }
                }
            }
        }

        if back_blk < 0 || loop_blks.len < 2 {
            ->
        }

        pred := unique_ext_pred_excluding(f, header, back_blk)
        if pred < 0 || pred == header {
            ->
        }
        $pred_in_loop := false
        for lbi in 0:loop_blks.len {
            if loop_blks[lbi] == pred {
                pred_in_loop = true
            }
        }
        if pred_in_loop {
            ->
        }

        $skip := false
        $has_call := false
        $stored := []bool{}
        for _ in 0:nloc {
            stored.push(false)
        }
        $loop_defs := []bool{}
        for _ in 0:ntmp {
            loop_defs.push(false)
        }

        for step in 0:loop_blks.len {
            cur_blk := loop_blks[step]
            $ii := f.blocks[cur_blk].head
            while ii >= 0 && ii < f.instrs.len {
                k := f.instrs[ii].kind
                ia := f.instrs[ii].a
                if k == MI_CALL {
                    has_call = true
                }
                if k == MI_STORE_LOCAL {
                    if ia >= 0 && ia < stored.len {
                        stored[ia] = true
                    }
                }
                if k == MI_ARRAY_LIT || k == MI_ARR_PUSH || k == MI_ARR_PUSH4 ||
                   k == MI_CHAN_NEW || k == MI_CHAN_SEND || k == MI_CHAN_RECV ||
                   k == MI_XU || k == MI_CHAN_CLOSE || k == MI_CHAN_TRY_SEND ||
                   k == MI_CHAN_TRY_RECV || k == MI_XU_PUMP {
                    skip = true
                }
                d := licm_instr_dest(f, ii)
                if d >= 0 && d < loop_defs.len {
                    loop_defs[d] = true
                }
                ii = f.instrs[ii].next
            }
        }

        if skip || has_call {
            ->
        }

        $hoisted := []bool{}
        for _ in 0:ntmp {
            hoisted.push(false)
        }

        for step in 0:loop_blks.len {
            cur_blk := loop_blks[step]
            $hoist := []int{}
            $ii := f.blocks[cur_blk].head
            while ii >= 0 && ii < f.instrs.len {
                nxt := f.instrs[ii].next
                k := f.instrs[ii].kind
                dest := licm_instr_dest(f, ii)
                $take := false

                if dest >= 0 && dest < ndef.len && ndef[dest] == 1 && is_pure_instr(k) {
                    if k == MI_LOAD_LOCAL {
                        loc := f.instrs[ii].b
                        if loc >= 0 && loc < stored.len && !stored[loc] {
                            take = true
                        }
                    } else if k == MI_COPY {
                        v := f.instrs[ii].b
                        if is_val_invariant(v, &loop_defs, &hoisted) {
                            take = true
                        }
                    } else if k == MI_UN {
                        v := f.instrs[ii].c
                        if is_val_invariant(v, &loop_defs, &hoisted) {
                            take = true
                        }
                    } else if k == MI_STR_CONST {
                        take = true
                    } else if k == MI_BIN {
                        op := f.instrs[ii].b
                        lhs := f.instrs[ii].c
                        rhs := f.instrs[ii].d
                        if is_val_invariant(lhs, &loop_defs, &hoisted) && is_val_invariant(rhs, &loop_defs, &hoisted) {
                            if op != BIN_DIV && op != BIN_MOD {
                                take = true
                            } else if rhs <= -2 {
                                cidx := 0 - rhs - 2
                                if cidx >= 0 && cidx < f.consts.len && f.consts[cidx] != 0 {
                                    take = true
                                }
                            }
                        }
                    }
                }

                if take {
                    if dest >= 0 && dest < hoisted.len {
                        hoisted[dest] = true
                    }
                    hoist.push(ii)
                }
                ii = nxt
            }

            for hi in 0:hoist.len {
                mir_detach_instr(f, cur_blk, hoist[hi])
                mir_append_instr(f, pred, hoist[hi])
            }
        }
    }
}

// ===== Typed-MIR LICM =====

pub struct LicmWork {
    reach []bool
    def_cnt []int
    def_blk []int
    def_ii []int
    addr_root []int
    addr_off []int
    addr_exact []bool
    maybe_loc []int
    loc_addr_taken []bool
    loc_escaped []bool
    fn_loc_stored []bool
    desc_root []int
    desc_off []int
    canon_base []int
    canon_off []int
    slice_desc_loc []bool
    buf_owner []int
    buf_scope []int
    blk_unk []bool
    inv []bool
    loc_stored []bool
    dom_cache []int
    dom_vis []bool
    dom_q []int
}

pub fn licm_work_new() LicmWork {
    << LicmWork{
        reach: []bool{},
        def_cnt: []int{},
        def_blk: []int{},
        def_ii: []int{},
        addr_root: []int{},
        addr_off: []int{},
        addr_exact: []bool{},
        maybe_loc: []int{},
        loc_addr_taken: []bool{},
        loc_escaped: []bool{},
        fn_loc_stored: []bool{},
        desc_root: []int{},
        desc_off: []int{},
        canon_base: []int{},
        canon_off: []int{},
        slice_desc_loc: []bool{},
        buf_owner: []int{},
        buf_scope: []int{},
        blk_unk: []bool{},
        inv: []bool{},
        loc_stored: []bool{},
        dom_cache: []int{},
        dom_vis: []bool{},
        dom_q: []int{}
    }
}

fn licm_fill_int(a $&[]int, n int, v int) {
    while a.len < n {
        a.push(v)
    }
    for i in 0:n {
        a[i] = v
    }
}

fn licm_fill_bool(a $&[]bool, n int, v bool) {
    while a.len < n {
        a.push(v)
    }
    for i in 0:n {
        a[i] = v
    }
}

fn licm_wbytes(d int) int {
    if d == 1 || d == 2 || d == 4 || d == 8 {
        << d
    }
    << 8
}

fn licm_is_safe_bin(f &MFn, op int, d int) bool {
    if op == BIN_STR_EQ || op == BIN_STR_NE || op == BIN_STR_ADD {
        << false
    }
    if op == BIN_DIV || op == BIN_MOD {
        if d <= -2 {
            dv := f.consts[0 - d - 2]
            << dv != 0 && dv != -1
        }
        << false
    }
    << true
}

fn licm_escape_call_exempt(ins &MInstr, ai int) bool {
    if ins.kind != MI_CALL || ai != 0 {
        << false
    }
    << ins.sval == "_xu_runtime_core_slice_push" ||
       ins.sval == "_xu_runtime_core_str_push_byte" ||
       ins.sval == "_xu_runtime_core_str_push" ||
       ins.sval == "_xu_runtime_core_desc_reserve" ||
       ins.sval == "_xu_runtime_core_intrin_make_ints" ||
       ins.sval == "_xu_runtime_core_intrin_make_string" ||
       ins.sval == "_xu_runtime_core_str_free" ||
       ins.sval == "_xu_runtime_core_arr_free" ||
       ins.sval == "_xu_runtime_core_slice_free" ||
       ins.sval == "_xu_runtime_core_bytes_new"
}

fn licm_mark_reach(f &MFn, w $&LicmWork) {
    nb := f.blocks.len
    licm_fill_bool($&w.reach, nb, false)
    if nb == 0 {
        <<
    }
    $qh := 0
    $qt := 0
    w.reach[0] = true
    if w.dom_q.len == 0 {
        w.dom_q.push(0)
    } else {
        w.dom_q[0] = 0
    }
    qt = 1
    while qh < qt {
        b := w.dom_q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !w.reach[s] {
                w.reach[s] = true
                if qt < w.dom_q.len { w.dom_q[qt] = s } else { w.dom_q.push(s) }
                qt += 1
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if sb >= 0 && sb < nb && !w.reach[sb] {
                w.reach[sb] = true
                if qt < w.dom_q.len { w.dom_q[qt] = sb } else { w.dom_q.push(sb) }
                qt += 1
            }
            sc := f.blocks[b].tc
            if sc >= 0 && sc < nb && !w.reach[sc] {
                w.reach[sc] = true
                if qt < w.dom_q.len { w.dom_q[qt] = sc } else { w.dom_q.push(sc) }
                qt += 1
            }
        }
    }
}

fn licm_dom(f &MFn, d int, target int, w $&LicmWork) bool {
    if d == 0 || d == target {
        << true
    }
    nb := f.blocks.len
    if d < 0 || d >= nb || target < 0 || target >= nb {
        << false
    }
    if w.dom_cache[d] != -1 {
        << w.dom_cache[d] == 1
    }
    licm_fill_bool($&w.dom_vis, nb, false)
    w.dom_vis[0] = true
    w.dom_vis[d] = true
    $qh := 0
    $qt := 0
    if w.dom_q.len == 0 { w.dom_q.push(0) } else { w.dom_q[0] = 0 }
    qt = 1
    while qh < qt {
        b := w.dom_q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !w.dom_vis[s] {
                if s == target {
                    w.dom_cache[d] = 0
                    << false
                }
                w.dom_vis[s] = true
                if qt < w.dom_q.len { w.dom_q[qt] = s } else { w.dom_q.push(s) }
                qt += 1
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if sb >= 0 && sb < nb && !w.dom_vis[sb] {
                if sb == target {
                    w.dom_cache[d] = 0
                    << false
                }
                w.dom_vis[sb] = true
                if qt < w.dom_q.len { w.dom_q[qt] = sb } else { w.dom_q.push(sb) }
                qt += 1
            }
            sc := f.blocks[b].tc
            if sc >= 0 && sc < nb && !w.dom_vis[sc] {
                if sc == target {
                    w.dom_cache[d] = 0
                    << false
                }
                w.dom_vis[sc] = true
                if qt < w.dom_q.len { w.dom_q[qt] = sc } else { w.dom_q.push(sc) }
                qt += 1
            }
        }
    }
    w.dom_cache[d] = 1
    << true
}

fn licm_is_inv(f &MFn, w $&LicmWork, lp &LoopInfo, v int) bool {
    if v <= -2 {
        << true
    }
    if v < 0 || v >= f.temps.len {
        << false
    }
    if w.def_cnt[v] != 1 {
        << false
    }
    if w.inv[v] {
        << true
    }
    db := w.def_blk[v]
    if db < 0 || db >= lp.body.len {
        << false
    }
    if lp.body[db] {
        << false
    }
    << licm_dom(f, db, lp.header, w)
}

fn licm_ranges_disjoint(o1 int, w1 int, o2 int, w2 int) bool {
    if w1 <= 0 || w2 <= 0 { << false }
    a := u64(o1)
    b := u64(o2)
    << b - a >= u64(w1) && a - b >= u64(w2)
}

fn licm_same_base_disjoint(w &LicmWork, p1 int, off1 int, w1 int, p2 int, off2 int, w2 int, p1_inv bool) bool {
    if off1 < 0 || off2 < 0 || off1 >= 1048576 || off2 >= 1048576 || w1 <= 0 || w2 <= 0 {
        << false
    }
    if p1_inv && p1 >= 0 && p1 == p2 && p1 < w.def_cnt.len && w.def_cnt[p1] == 1 {
        << licm_ranges_disjoint(off1, w1, off2, w2)
    }
    if p1 >= 0 && p2 >= 0 && p1 < w.desc_root.len && p2 < w.desc_root.len {
        r1 := w.desc_root[p1]
        if r1 >= 0 && r1 == w.desc_root[p2] {
            d1 := w.desc_off[p1]
            d2 := w.desc_off[p2]
            if d1 >= 0 && d2 >= 0 && d1 < 1048576 && d2 < 1048576 {
                << licm_ranges_disjoint(d1 + off1, w1, d2 + off2, w2)
            }
        }
    }
    if p1_inv && p1 >= 0 && p2 >= 0 && p1 < w.canon_base.len && p2 < w.canon_base.len {
        cb1 := w.canon_base[p1]
        cb2 := w.canon_base[p2]
        if cb1 >= 0 && cb1 == cb2 && cb1 < w.def_cnt.len && w.def_cnt[cb1] == 1 {
            co1 := w.canon_off[p1] + off1
            co2 := w.canon_off[p2] + off2
            if co1 >= 0 && co2 >= 0 && co1 < 1048576 && co2 < 1048576 {
                << licm_ranges_disjoint(co1, w1, co2, w2)
            }
        }
    }
    << false
}

fn licm_scope_disjoint_from_stores(f &MFn, w &LicmWork, stores &[]int, load_scope int, is_slice_hdr bool, ptr int, off int, wl int, ptr_inv bool) bool {
    if load_scope <= 0 { << false }
    if stores.len == 0 { << true }
    for si in 0:stores.len {
        sii := stores[si]
        sins := &f.instrs[sii]
        sp := sins.a
        if licm_same_base_disjoint(w, ptr, off, wl, sp, sins.c, licm_wbytes(sins.d), ptr_inv) {
            ->
        }
        s_scope := sins.scope_id
        if s_scope > 0 {
            if s_scope == load_scope {
                << false
            }
            ->
        }
        if sp >= 0 && sp < w.buf_scope.len && w.buf_scope[sp] > 0 {
            if w.buf_scope[sp] != load_scope || is_slice_hdr {
                ->
            }
        }
        << false
    }
    << true
}

fn licm_is_arg0_append_call(ins &MInstr) bool {
    << ins.kind == MI_CALL &&
       (ins.sval == "_xu_runtime_core_str_push_byte" ||
        ins.sval == "_xu_runtime_core_slice_push" ||
        ins.sval == "_xu_runtime_core_str_push")
}

fn licm_is_pure_vec_call(ins &MInstr) bool {
    << ins.kind == MI_CALL && ins.sval == "__xu_vec_sum64"
}

fn licm_is_arg0_buf_write_call(ins &MInstr) bool {
    << ins.kind == MI_CALL &&
       (ins.sval == "__xu_vec_fill8" ||
        ins.sval == "__xu_vec_fill16" ||
        ins.sval == "__xu_vec_fill32" ||
        ins.sval == "__xu_vec_fill64" ||
        ins.sval == "__xu_vec_copy8" ||
        ins.sval == "__xu_vec_copy16" ||
        ins.sval == "__xu_vec_copy32" ||
        ins.sval == "__xu_vec_copy64")
}

fn licm_is_fresh_alloc_call(ins &MInstr) bool {
    << ins.kind == MI_CALL &&
       (ins.sval == "_xu_runtime_core_intrin_make_ints" ||
        ins.sval == "_xu_runtime_core_intrin_make_string" ||
        ins.sval == "_xu_runtime_core_desc_reserve" ||
        ins.sval == "_xu_runtime_core_slice_push" ||
        ins.sval == "_xu_runtime_core_str_push_byte" ||
        ins.sval == "_xu_runtime_core_str_push")
}

fn licm_resolve_ptr_origin(f &MFn, w &LicmWork, v int, out_kind $&int, out_id $&int) bool {
    *out_kind = 0
    *out_id = -1
    $cur := v
    for _ in 0:4 {
        if cur >= 0 && cur < w.addr_exact.len && w.addr_exact[cur] {
            l := w.addr_root[cur]
            if l >= 0 && l < w.loc_escaped.len && !w.loc_escaped[l] {
                *out_kind = 1
                *out_id = l
                << true
            }
            << false
        }
        if cur < 0 || cur >= w.def_cnt.len || w.def_cnt[cur] != 1 {
            << false
        }
        dii := w.def_ii[cur]
        dins := &f.instrs[dii]
        if dins.kind == MI_COPY {
            cur = dins.b
            ->
        }
        if dins.kind == MI_LOAD_LOCAL && dins.c == 0 && dins.b >= 0 && dins.b < f.nparams &&
           dins.b < w.loc_addr_taken.len && !w.loc_addr_taken[dins.b] && !w.fn_loc_stored[dins.b] {
            *out_kind = 2
            *out_id = dins.b
            << true
        }
        << false
    }
    << false
}

fn licm_load_disjoint_from_append_calls(f &MFn, w &LicmWork, ptr int, load_scope int, ck &[]int, cid &[]int, cbscopes &[]int, fresh_scope_base int) bool {
    $lk := 0
    $lid := -1
    if !licm_resolve_ptr_origin(f, w, ptr, $&lk, $&lid) {
        << false
    }
    if lk == 2 && load_scope <= 0 {
        << false
    }
    for i in 0:ck.len {
        if lk == ck[i] && lid == cid[i] {
            << false
        }
    }
    for j in 0:cbscopes.len {
        bs := cbscopes[j]
        if !((load_scope > 0 && load_scope != bs) || (lk == 1 && bs >= fresh_scope_base)) {
            << false
        }
    }
    << true
}

fn licm_load_ptr_alias_safe(f &MFn, w &LicmWork, stores &[]int, ptr int, off int, wl int, ptr_inv bool) bool {
    if stores.len == 0 {
        << true
    }
    if ptr < 0 || ptr >= w.addr_exact.len {
        << false
    }
    if !w.addr_exact[ptr] {
        // Slice descriptor header loads ({data, len, cap}) via an invariant slice
        // local are disjoint from element-buffer writes derived from that same slice's data ptr;
        // and non-overlapping same-base constant fields are disjoint from sibling field stores.
        dl := w.desc_root[ptr]
        is_shdr := dl >= 0 && dl < w.slice_desc_loc.len && w.slice_desc_loc[dl] && (off == 0 || off == 8 || off == 16) && off + wl <= 24
        for si in 0:stores.len {
            sii := stores[si]
            ins := &f.instrs[sii]
            sp := ins.a
            if licm_same_base_disjoint(w, ptr, off, wl, sp, ins.c, licm_wbytes(ins.d), ptr_inv) {
                ->
            }
            if sp < 0 || sp >= w.buf_owner.len {
                << false
            }
            if is_shdr && w.buf_owner[sp] == dl {
                ->
            }
            if dl >= 0 && w.addr_exact[sp] {
                ls := w.addr_root[sp]
                if ls >= 0 && ls != dl && ls < w.loc_escaped.len && !w.loc_escaped[ls] {
                    ->
                }
            }
            << false
        }
        << true
    }
    l_load := w.addr_root[ptr]
    if l_load >= 0 && l_load < w.loc_stored.len && w.loc_stored[l_load] {
        << false
    }
    if stores.len == 0 {
        << true
    }
    off_l := w.addr_off[ptr] + off
    is_slice_hdr := l_load >= 0 && l_load < w.slice_desc_loc.len && w.slice_desc_loc[l_load] && (off_l == 0 || off_l == 8 || off_l == 16) && off_l + wl <= 24
    for si in 0:stores.len {
        sii := stores[si]
        ins := &f.instrs[sii]
        sp := ins.a
        if is_slice_hdr && sp >= 0 && sp < w.buf_owner.len && w.buf_owner[sp] == l_load {
            ->
        }
        if sp < 0 || sp >= w.addr_exact.len {
            if w.loc_escaped[l_load] {
                << false
            }
            ->
        }
        if w.addr_exact[sp] {
            l_store := w.addr_root[sp]
            if l_store == l_load {
                ws := licm_wbytes(ins.d)
                off_s := w.addr_off[sp] + ins.c
                if ins.c < 0 || !(off_s + ws <= off_l || off_l + wl <= off_s) {
                    << false
                }
            }
        } else if w.maybe_loc[sp] >= 0 {
            if w.maybe_loc[sp] == l_load {
                << false
            }
        } else {
            if w.loc_escaped[l_load] {
                << false
            }
        }
    }
    << true
}

fn licm_load_ptr_trap_safe(f &MFn, w $&LicmWork, lp &LoopInfo, b int, ii int, ptr int, off int, wl int) bool {
    if ptr >= 0 && ptr < w.addr_exact.len && w.addr_exact[ptr] {
        l := w.addr_root[ptr]
        tot := w.addr_off[ptr] + off
        if l >= 0 && l < f.locals_nslots.len && tot >= 0 && tot + wl <= f.locals_nslots[l] * 8 {
            << true
        }
    }
    if b == lp.header {
        // Walk from header start: ii is guaranteed to execute on loop entry
        // if no preceding instruction in the header can trap, call, or store.
        $cur := f.blocks[lp.header].head
        while cur >= 0 {
            if cur == ii {
                << true
            }
            cins := &f.instrs[cur]
            ck := cins.kind
            if ck == MI_CALL || ck == MI_CALL_IND || ck == MI_STORE_PTR || ck == MI_LOAD_PTR {
                <-
            }
            if ck == MI_BIN && !licm_is_safe_bin(f, cins.b, cins.d) {
                <-
            }
            cur = cins.next
        }
    }
    if off < 0 || off >= 4096 {
        << false
    }
    $ptr_root := -1
    $ptr_doff := 0
    if ptr >= 0 && ptr < w.desc_root.len {
        ptr_root = w.desc_root[ptr]
        if ptr < w.desc_off.len {
            ptr_doff = w.desc_off[ptr]
        }
    }
    // Pre-dereferenced on the same invariant pointer in a dominating non-loop block.
    for db in 0:f.blocks.len {
        if !w.reach[db] || lp.body[db] || db >= w.blk_unk.len {
            ->
        }
        if !licm_dom(f, db, lp.header, w) {
            ->
        }
        $di := f.blocks[db].head
        while di >= 0 {
            dins := &f.instrs[di]
            if dins.kind == MI_LOAD_PTR && (dins.b == ptr || (ptr_root >= 0 && dins.b >= 0 && dins.b < w.desc_root.len && w.desc_root[dins.b] == ptr_root && w.desc_off[dins.b] == ptr_doff)) && (dins.c == off || (off <= 64 && dins.c >= off && dins.c <= 64)) {
                << true
            }
            if dins.kind == MI_STORE_PTR && (dins.a == ptr || (ptr_root >= 0 && dins.a >= 0 && dins.a < w.desc_root.len && w.desc_root[dins.a] == ptr_root)) && (dins.c == off || (off <= 64 && dins.c >= off && dins.c <= 64)) {
                << true
            }
            di = dins.next
        }
    }
    << false
}

fn licm_h_val_inv(f &MFn, w $&LicmWork, lp &LoopInfo, h int, v int) bool {
    if v <= -2 {
        << true
    }
    if v < 0 || v >= f.temps.len || w.def_cnt[v] != 1 {
        << false
    }
    if w.inv[v] {
        << true
    }
    db := w.def_blk[v]
    if db < 0 || db >= lp.body.len || lp.body[db] {
        << false
    }
    << licm_dom(f, db, h, w)
}

fn licm_is_h_var(w &LicmWork, h int, v int) bool {
    << v >= 0 && v < w.def_blk.len && w.def_blk[v] == h && !w.inv[v]
}

fn licm_h_var_used_outside(f &MFn, w &LicmWork, h int) bool {
    for bi in 0:f.blocks.len {
        if bi == h || !w.reach[bi] { -> }
        if w.blk_unk[bi] { << true }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                if licm_is_h_var(w, h, ins.b) { << true }
            } else if k == MI_STORE_PTR {
                if licm_is_h_var(w, h, ins.a) || licm_is_h_var(w, h, ins.b) { << true }
            } else if k == MI_UN {
                if licm_is_h_var(w, h, ins.c) { << true }
            } else if k == MI_BIN {
                if licm_is_h_var(w, h, ins.c) || licm_is_h_var(w, h, ins.d) { << true }
            } else if k == MI_SELECT {
                if licm_is_h_var(w, h, ins.b) || licm_is_h_var(w, h, ins.c) || licm_is_h_var(w, h, ins.d) { << true }
            }
            if k == MI_CALL || k == MI_CALL_IND {
                $a := ins.c
                while a >= 0 {
                    if licm_is_h_var(w, h, f.margs[a].v) { << true }
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if (tk == TKIND_BRANCH || tk == TKIND_RETURN) && licm_is_h_var(w, h, f.blocks[bi].ta) {
            << true
        }
    }
    << false
}

fn opt_peel_inv_guards(f $&MFn, w $&LicmWork, init_loops &[]LoopInfo) bool {
    nt := f.temps.len
    nl := f.locals.len
    $any_peeled := false
    $extra_loops := []LoopInfo{}
    for step in 0:4 {
        $cur_loops := init_loops
        if step > 0 {
            cur_loops = &extra_loops
        }
        nb := f.blocks.len
        licm_fill_int($&w.def_cnt, nt, 0)
        licm_fill_int($&w.def_blk, nt, -1)
        licm_fill_int($&w.def_ii, nt, -1)
        licm_fill_bool($&w.loc_addr_taken, nl, false)
        licm_fill_bool($&w.blk_unk, nb, false)
        for bi in 0:nb {
            if !w.reach[bi] { -> }
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                if !fold_known_kind(k) { w.blk_unk[bi] = true }
                if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                    w.def_cnt[ins.a] = w.def_cnt[ins.a] + 1
                    w.def_blk[ins.a] = bi
                    w.def_ii[ins.a] = ii
                }
                if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                    w.loc_addr_taken[ins.b] = true
                }
                ii = ins.next
            }
        }
        $step_peeled := false
        for li in 0:cur_loops.len {
            lp := &cur_loops[li]
            h := lp.header
            if h <= 0 || h >= nb || !w.reach[h] || lp.blocks.len < 2 { -> }
            if f.blocks[h].tkind != TKIND_BRANCH { -> }
            htb := f.blocks[h].tb
            htc := f.blocks[h].tc
            if htb < 0 || htb >= nb || htc < 0 || htc >= nb { -> }
            $cont_b := -1
            $exit_b := -1
            if htb != h && htb < lp.body.len && lp.body[htb] && (htc >= lp.body.len || !lp.body[htc]) {
                cont_b = htb
                exit_b = htc
            } else if htc != h && htc < lp.body.len && lp.body[htc] && (htb >= lp.body.len || !lp.body[htb]) {
                cont_b = htc
                exit_b = htb
            }
            if cont_b < 0 { -> }
            $irreducible := false
            $ext_preds := []int{}
            for p in 0:nb {
                if !w.reach[p] || (p < lp.body.len && lp.body[p]) { -> }
                tk := f.blocks[p].tkind
                if tk == TKIND_JUMP {
                    s := f.blocks[p].ta
                    if s == h { ext_preds.push(p) }
                    else if s >= 0 && s < lp.body.len && lp.body[s] {
                        irreducible = true
                        <-
                    }
                } else if tk == TKIND_BRANCH {
                    sb := f.blocks[p].tb
                    sc := f.blocks[p].tc
                    if sb == h || sc == h { ext_preds.push(p) }
                    if (sb != h && sb >= 0 && sb < lp.body.len && lp.body[sb]) ||
                       (sc != h && sc >= 0 && sc < lp.body.len && lp.body[sc]) {
                        irreducible = true
                        <-
                    }
                } else if tk != TKIND_RETURN && tk != TKIND_OPEN {
                    irreducible = true
                    <-
                }
            }
            if irreducible || ext_preds.len == 0 { -> }
            licm_fill_bool($&w.loc_stored, nl, false)
            $lp_unk := false
            for bi_i in 0:lp.blocks.len {
                b := lp.blocks[bi_i]
                if b >= w.blk_unk.len || w.blk_unk[b] {
                    lp_unk = true
                    <-
                }
                $ii := f.blocks[b].head
                while ii >= 0 {
                    ins := &f.instrs[ii]
                    if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                        w.loc_stored[ins.a] = true
                    }
                    ii = ins.next
                }
            }
            if lp_unk { -> }
            licm_fill_int($&w.dom_cache, nb, -1)
            licm_fill_bool($&w.inv, nt, false)
            $h_pure := true
            $all_inv := true
            $ii := f.blocks[h].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                dest := ins.a
                if fold_defines(k) && (dest < 0 || dest >= nt || w.def_cnt[dest] != 1) {
                    h_pure = false
                    all_inv = false
                    <-
                }
                $pure_ok := false
                $inv_ok := false
                if k == MI_NOP || k == MI_STR_CONST {
                    pure_ok = true
                    inv_ok = true
                } else if k == MI_COPY {
                    pure_ok = true
                    inv_ok = licm_h_val_inv(f, w, lp, h, ins.b)
                } else if k == MI_LOAD_LOCAL {
                    pure_ok = ins.b >= 0 && ins.b < nl && ins.c == 0 && !w.loc_addr_taken[ins.b]
                    inv_ok = pure_ok && !w.loc_stored[ins.b]
                } else if k == MI_UN {
                    pure_ok = true
                    inv_ok = licm_h_val_inv(f, w, lp, h, ins.c)
                } else if k == MI_BIN {
                    pure_ok = licm_is_safe_bin(f, ins.b, ins.d)
                    inv_ok = pure_ok && licm_h_val_inv(f, w, lp, h, ins.c) && licm_h_val_inv(f, w, lp, h, ins.d)
                } else if k == MI_SELECT {
                    pure_ok = true
                    inv_ok = licm_h_val_inv(f, w, lp, h, ins.b) && licm_h_val_inv(f, w, lp, h, ins.c) && licm_h_val_inv(f, w, lp, h, ins.d)
                }
                if !pure_ok {
                    h_pure = false
                    all_inv = false
                    <-
                }
                if inv_ok {
                    if fold_defines(k) && dest >= 0 && dest < nt {
                        w.inv[dest] = true
                    }
                } else {
                    all_inv = false
                }
                ii = ins.next
            }
            if !h_pure { -> }
            if all_inv && licm_h_val_inv(f, w, lp, h, f.blocks[h].ta) {
                for bi_i in 0:lp.blocks.len {
                    b := lp.blocks[bi_i]
                    if f.blocks[b].tkind == TKIND_JUMP && f.blocks[b].ta == h {
                        f.blocks[b].ta = cont_b
                    } else if f.blocks[b].tkind == TKIND_BRANCH {
                        if f.blocks[b].tb == h { f.blocks[b].tb = cont_b }
                        if f.blocks[b].tc == h { f.blocks[b].tc = cont_b }
                    }
                }
                step_peeled = true
                any_peeled = true
                <-
            }
            // Split loop-invariant short-circuit disjunction/conjunction MI_SELECT guards out of header.
            cnd := f.blocks[h].ta
            if cnd >= 0 && cnd < nt && w.def_cnt[cnd] == 1 && w.def_blk[cnd] == h {
                sii := w.def_ii[cnd]
                if sii >= 0 && f.instrs[sii].kind == MI_SELECT {
                    sb := f.instrs[sii].b
                    sc := f.instrs[sii].c
                    sd := f.instrs[sii].d
                    $matched := false
                    $exit_on_true := true
                    $inv_c := -1
                    $rem_c := -1
                    if exit_b == htb && sb >= 0 && sb == sc && licm_h_val_inv(f, w, lp, h, sb) && !licm_h_val_inv(f, w, lp, h, sd) {
                        matched = true
                        exit_on_true = true
                        inv_c = sb
                        rem_c = sd
                    } else if exit_b == htc && sb >= 0 && licm_h_val_inv(f, w, lp, h, sb) && sd <= -2 && f.consts[0 - sd - 2] == 0 && !licm_h_val_inv(f, w, lp, h, sc) {
                        matched = true
                        exit_on_true = false
                        inv_c = sb
                        rem_c = sc
                    }
                    if matched && !licm_h_var_used_outside(f, w, h) {
                        $ph := -1
                        if ext_preds.len == 1 && f.blocks[ext_preds[0]].tkind == TKIND_JUMP && f.blocks[ext_preds[0]].ta == h {
                            ph = ext_preds[0]
                        } else {
                            ph = f.blocks.len
                            $nblk := mblock_new()
                            nblk.tkind = TKIND_JUMP
                            nblk.ta = h
                            nblk.line = f.blocks[h].line
                            f.blocks.push(nblk)
                            if ph < w.reach.len { w.reach[ph] = true } else { w.reach.push(true) }
                            if ph < w.blk_unk.len { w.blk_unk[ph] = false } else { w.blk_unk.push(false) }
                            for ei in 0:ext_preds.len {
                                p := ext_preds[ei]
                                if f.blocks[p].tkind == TKIND_JUMP && f.blocks[p].ta == h {
                                    f.blocks[p].ta = ph
                                } else if f.blocks[p].tkind == TKIND_BRANCH {
                                    if f.blocks[p].tb == h { f.blocks[p].tb = ph }
                                    if f.blocks[p].tc == h { f.blocks[p].tc = ph }
                                }
                            }
                        }
                        $mi := f.blocks[h].head
                        while mi >= 0 {
                            nx := f.instrs[mi].next
                            md := f.instrs[mi].a
                            if fold_defines(f.instrs[mi].kind) && md >= 0 && md < nt && w.inv[md] {
                                mir_detach_instr(f, h, mi)
                                mir_append_instr(f, ph, mi)
                                w.def_blk[md] = ph
                            }
                            mi = nx
                        }
                        f.instrs[sii].kind = MI_COPY
                        f.instrs[sii].b = rem_c
                        f.instrs[sii].c = -1
                        f.instrs[sii].d = -1
                        f.blocks[h].ta = rem_c
                        f.blocks[ph].tkind = TKIND_BRANCH
                        f.blocks[ph].ta = inv_c
                        if exit_on_true {
                            f.blocks[ph].tb = exit_b
                            f.blocks[ph].tc = h
                        } else {
                            f.blocks[ph].tb = h
                            f.blocks[ph].tc = exit_b
                        }
                        step_peeled = true
                        any_peeled = true
                        <-
                    }
                }
            }
        }
        if !step_peeled { <- }
        extra_loops = find_loops(f, false)
        if extra_loops.len == 0 { <- }
        licm_mark_reach(f, w)
    }
    << any_peeled
}

fn licm_sync_temp_arrays(w $&LicmWork, old_nt int, nt int) {
    while w.def_cnt.len < nt { w.def_cnt.push(0) }
    while w.def_blk.len < nt { w.def_blk.push(-1) }
    while w.def_ii.len < nt { w.def_ii.push(-1) }
    while w.addr_root.len < nt { w.addr_root.push(-1) }
    while w.addr_off.len < nt { w.addr_off.push(0) }
    while w.addr_exact.len < nt { w.addr_exact.push(false) }
    while w.maybe_loc.len < nt { w.maybe_loc.push(-1) }
    while w.desc_root.len < nt { w.desc_root.push(-1) }
    while w.desc_off.len < nt { w.desc_off.push(0) }
    while w.buf_owner.len < nt { w.buf_owner.push(-1) }
    while w.inv.len < nt { w.inv.push(false) }
    for i in old_nt:nt {
        w.def_cnt[i] = 0
        w.def_blk[i] = -1
        w.def_ii[i] = -1
        w.addr_root[i] = -1
        w.addr_off[i] = 0
        w.addr_exact[i] = false
        w.maybe_loc[i] = -1
        w.desc_root[i] = -1
        w.desc_off[i] = 0
        w.buf_owner[i] = -1
        w.inv[i] = false
    }
}

fn licm_precedes_in_blk(f &MFn, bi int, first_ii int, second_ii int) bool {
    if first_ii < 0 || second_ii < 0 || first_ii == second_ii {
        << false
    }
    $ii := f.blocks[bi].head
    while ii >= 0 {
        if ii == first_ii { << true }
        if ii == second_ii { << false }
        ii = f.instrs[ii].next
    }
    << false
}

fn licm_insert_before(f $&MFn, bi int, target_ii int, prev_ii int, ins MInstr) int {
    idx := f.instrs.len
    f.instrs.push(ins)
    f.instrs[idx].next = target_ii
    if prev_ii < 0 {
        f.blocks[bi].head = idx
    } else {
        f.instrs[prev_ii].next = idx
    }
    << idx
}

fn licm_try_scale_const(f &MFn, ins &MInstr, out_arg $&int, out_op $&int, out_c $&int) bool {
    if ins.kind != MI_BIN { << false }
    if ins.b == BIN_SHL && ins.c >= 0 && ins.d <= -2 {
        cv := f.consts[0 - ins.d - 2]
        if cv > 0 && cv < 64 {
            *out_arg = ins.c
            *out_op = BIN_SHL
            *out_c = ins.d
            << true
        }
        << false
    }
    if ins.b == BIN_MUL {
        if ins.c >= 0 && ins.d <= -2 {
            *out_arg = ins.c
            *out_op = BIN_MUL
            *out_c = ins.d
            << true
        }
        if ins.d >= 0 && ins.c <= -2 {
            *out_arg = ins.d
            *out_op = BIN_MUL
            *out_c = ins.c
            << true
        }
    }
    << false
}

// Reassociates base + ((var +/- inv) << C) (or * C) into
// (base +/- (inv << C)) + (var << C) so the loop-invariant row base hoists out.
fn licm_distribute_affine(f $&MFn, w $&LicmWork, lp &LoopInfo, max_hoist int) bool {
    $added := 0
    $cap := max_hoist / 3
    if cap > 8 { cap = 8 }
    if cap <= 0 { << false }
    for bi_i in 0:lp.blocks.len {
        if added >= cap { <- }
        b := lp.blocks[bi_i]
        $prev := -1
        $ii := f.blocks[b].head
        while ii >= 0 && added < cap {
            nx := f.instrs[ii].next
            nt := f.temps.len
            $did := false
            if f.instrs[ii].kind == MI_BIN && f.instrs[ii].b == BIN_ADD &&
               f.instrs[ii].a >= 0 && f.instrs[ii].a < nt && w.def_cnt[f.instrs[ii].a] == 1 {
                ic := f.instrs[ii].c
                id := f.instrs[ii].d
                for pass in 0:2 {
                    if did { <- }
                    $base := ic
                    $scaled := id
                    if pass == 1 {
                        base = id
                        scaled = ic
                    }
                    if base < 0 || base >= nt || !licm_is_inv(f, w, lp, base) { -> }
                    if scaled < 0 || scaled >= nt || w.def_cnt[scaled] != 1 || w.def_blk[scaled] != b { -> }
                    scaled_ii := w.def_ii[scaled]
                    if !licm_precedes_in_blk(f, b, scaled_ii, ii) { -> }
                    $inner := -1
                    $scale_op := 0
                    $scale_c := -1
                    if !licm_try_scale_const(f, &f.instrs[scaled_ii], $&inner, $&scale_op, $&scale_c) { -> }
                    if inner < 0 || inner >= nt || w.def_cnt[inner] != 1 || w.def_blk[inner] != b { -> }
                    inner_ii := w.def_ii[inner]
                    if !licm_precedes_in_blk(f, b, inner_ii, scaled_ii) { -> }
                    iins := &f.instrs[inner_ii]
                    if iins.kind != MI_BIN || (iins.b != BIN_ADD && iins.b != BIN_SUB) { -> }
                    $inv := -1
                    $var := -1
                    $sub_inv := false
                    if iins.b == BIN_ADD {
                        if licm_is_inv(f, w, lp, iins.c) && iins.d >= 0 && iins.d < nt &&
                           w.def_cnt[iins.d] == 1 && !licm_is_inv(f, w, lp, iins.d) {
                            inv = iins.c
                            var = iins.d
                        } else if licm_is_inv(f, w, lp, iins.d) && iins.c >= 0 && iins.c < nt &&
                                  w.def_cnt[iins.c] == 1 && !licm_is_inv(f, w, lp, iins.c) {
                            inv = iins.d
                            var = iins.c
                        }
                    } else {
                        if iins.c >= 0 && iins.c < nt && w.def_cnt[iins.c] == 1 &&
                           !licm_is_inv(f, w, lp, iins.c) && licm_is_inv(f, w, lp, iins.d) {
                            var = iins.c
                            inv = iins.d
                            sub_inv = true
                        }
                    }
                    if var < 0 { -> }
                    line := f.instrs[ii].line
                    t_inv_s := alloc_temp(f)
                    t_row := alloc_temp(f)
                    t_var_s := alloc_temp(f)
                    licm_sync_temp_arrays(w, nt, f.temps.len)

                    $ins1 := minstr_new(MI_BIN)
                    ins1.a = t_inv_s
                    ins1.b = scale_op
                    ins1.c = inv
                    ins1.d = scale_c
                    ins1.line = line
                    p1 := licm_insert_before(f, b, ii, prev, ins1)
                    w.def_cnt[t_inv_s] = 1
                    w.def_blk[t_inv_s] = b
                    w.def_ii[t_inv_s] = p1

                    $ins2 := minstr_new(MI_BIN)
                    ins2.a = t_row
                    ins2.b = BIN_ADD
                    if sub_inv { ins2.b = BIN_SUB }
                    ins2.c = base
                    ins2.d = t_inv_s
                    ins2.line = line
                    p2 := licm_insert_before(f, b, ii, p1, ins2)
                    w.def_cnt[t_row] = 1
                    w.def_blk[t_row] = b
                    w.def_ii[t_row] = p2
                    if base >= 0 && base < w.buf_owner.len && w.buf_owner[base] >= 0 {
                        w.buf_owner[t_row] = w.buf_owner[base]
                    }

                    $ins3 := minstr_new(MI_BIN)
                    ins3.a = t_var_s
                    ins3.b = scale_op
                    ins3.c = var
                    ins3.d = scale_c
                    ins3.line = line
                    p3 := licm_insert_before(f, b, ii, p2, ins3)
                    w.def_cnt[t_var_s] = 1
                    w.def_blk[t_var_s] = b
                    w.def_ii[t_var_s] = p3
                    prev = p3

                    f.instrs[ii].c = t_row
                    f.instrs[ii].d = t_var_s
                    added += 1
                    did = true
                }
            }
            prev = ii
            ii = nx
        }
    }
    << added > 0
}

fn licm_build_alias_info(f &MFn, w $&LicmWork, sdesc_roots $&[]int, sdesc_offs $&[]int, out_any_unk $&bool, out_fresh_base $&int) {
    nb0 := f.blocks.len
    nt := f.temps.len
    nl := f.locals.len
    licm_fill_int($&w.def_cnt, nt, 0)
    licm_fill_int($&w.def_blk, nt, -1)
    licm_fill_int($&w.def_ii, nt, -1)
    licm_fill_int($&w.addr_root, nt, -1)
    licm_fill_int($&w.addr_off, nt, 0)
    licm_fill_bool($&w.addr_exact, nt, false)
    licm_fill_int($&w.maybe_loc, nt, -1)
    licm_fill_bool($&w.loc_addr_taken, nl, false)
    licm_fill_bool($&w.loc_escaped, nl, false)
    licm_fill_bool($&w.fn_loc_stored, nl, false)
    licm_fill_int($&w.desc_root, nt, -1)
    licm_fill_int($&w.desc_off, nt, 0)
    licm_fill_int($&w.canon_base, nt, -1)
    licm_fill_int($&w.canon_off, nt, 0)
    for ti in 0:nt {
        w.canon_base[ti] = ti
    }
    licm_fill_bool($&w.slice_desc_loc, nl, false)
    licm_fill_int($&w.buf_owner, nt, -1)
    licm_fill_int($&w.buf_scope, nt, 0)
    licm_fill_bool($&w.blk_unk, nb0, false)
    $any_unk := false
    for bi in 0:nb0 {
        if !w.reach[bi] {
            ->
        }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if !fold_known_kind(k) {
                w.blk_unk[bi] = true
                any_unk = true
            }
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                w.def_cnt[ins.a] = w.def_cnt[ins.a] + 1
                w.def_blk[ins.a] = bi
                w.def_ii[ins.a] = ii
            }
            if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                w.loc_addr_taken[ins.b] = true
            } else if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                w.fn_loc_stored[ins.a] = true
            }
            ii = ins.next
        }
    }
    // Propagate stack MI_ADDR base+const derivations and invariant descriptor roots.
    for _ in 0:3 {
        $prog := false
        for bi in 0:nb0 {
            if !w.reach[bi] {
                ->
            }
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                t := ins.a
                if fold_defines(ins.kind) && t >= 0 && t < nt && w.def_cnt[t] == 1 {
                    if ins.kind == MI_ADDR && ins.b >= 0 && ins.b < nl {
                        if !w.addr_exact[t] {
                            w.addr_root[t] = ins.b
                            w.addr_off[t] = 0
                            w.addr_exact[t] = true
                            w.maybe_loc[t] = ins.b
                            w.desc_root[t] = ins.b
                            w.desc_off[t] = 0
                            prog = true
                        }
                    } else if ins.kind == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && ins.c == 0 && !w.fn_loc_stored[ins.b] && !w.loc_addr_taken[ins.b] {
                        if w.desc_root[t] < 0 {
                            w.desc_root[t] = ins.b
                            w.desc_off[t] = 0
                            prog = true
                        }
                    } else if ins.kind == MI_COPY && ins.b >= 0 && ins.b < nt && w.def_cnt[ins.b] == 1 {
                        if w.addr_exact[ins.b] && !w.addr_exact[t] {
                            w.addr_root[t] = w.addr_root[ins.b]
                            w.addr_off[t] = w.addr_off[ins.b]
                            w.addr_exact[t] = true
                            prog = true
                        }
                        if w.maybe_loc[ins.b] >= 0 && w.maybe_loc[t] < 0 {
                            w.maybe_loc[t] = w.maybe_loc[ins.b]
                            prog = true
                        }
                        if w.desc_root[ins.b] >= 0 && w.desc_root[t] < 0 {
                            w.desc_root[t] = w.desc_root[ins.b]
                            w.desc_off[t] = w.desc_off[ins.b]
                            prog = true
                        }
                        if w.canon_base[ins.b] >= 0 && (w.canon_base[t] != w.canon_base[ins.b] || w.canon_off[t] != w.canon_off[ins.b]) {
                            w.canon_base[t] = w.canon_base[ins.b]
                            w.canon_off[t] = w.canon_off[ins.b]
                            prog = true
                        }
                    } else if ins.kind == MI_BIN && (ins.b == BIN_ADD || ins.b == BIN_SUB) {
                        if ins.c >= 0 && ins.c < nt && w.def_cnt[ins.c] == 1 && ins.d <= -2 {
                            $cv := f.consts[0 - ins.d - 2]
                            if w.addr_exact[ins.c] && !w.addr_exact[t] {
                                w.addr_root[t] = w.addr_root[ins.c]
                                if ins.b == BIN_ADD {
                                    w.addr_off[t] = w.addr_off[ins.c] + cv
                                } else {
                                    w.addr_off[t] = w.addr_off[ins.c] - cv
                                }
                                w.addr_exact[t] = true
                                prog = true
                            }
                            if w.maybe_loc[ins.c] >= 0 && w.maybe_loc[t] < 0 {
                                w.maybe_loc[t] = w.maybe_loc[ins.c]
                                prog = true
                            }
                            if ins.b == BIN_ADD && cv >= 0 && w.desc_root[ins.c] >= 0 && w.desc_root[t] < 0 {
                                w.desc_root[t] = w.desc_root[ins.c]
                                w.desc_off[t] = w.desc_off[ins.c] + cv
                                prog = true
                            }
                            if w.canon_base[ins.c] >= 0 {
                                $no := w.canon_off[ins.c] + cv
                                if ins.b == BIN_SUB { no = w.canon_off[ins.c] - cv }
                                if no >= 0 && no < 1048576 && (w.canon_base[t] != w.canon_base[ins.c] || w.canon_off[t] != no) {
                                    w.canon_base[t] = w.canon_base[ins.c]
                                    w.canon_off[t] = no
                                    prog = true
                                }
                            }
                        } else if ins.b == BIN_ADD && ins.d >= 0 && ins.d < nt && w.def_cnt[ins.d] == 1 && ins.c <= -2 {
                            cv := f.consts[0 - ins.c - 2]
                            if w.addr_exact[ins.d] && !w.addr_exact[t] {
                                w.addr_root[t] = w.addr_root[ins.d]
                                w.addr_off[t] = w.addr_off[ins.d] + cv
                                w.addr_exact[t] = true
                                prog = true
                            }
                            if w.maybe_loc[ins.d] >= 0 && w.maybe_loc[t] < 0 {
                                w.maybe_loc[t] = w.maybe_loc[ins.d]
                                prog = true
                            }
                            if cv >= 0 && w.desc_root[ins.d] >= 0 && w.desc_root[t] < 0 {
                                w.desc_root[t] = w.desc_root[ins.d]
                                w.desc_off[t] = w.desc_off[ins.d] + cv
                                prog = true
                            }
                            if w.canon_base[ins.d] >= 0 {
                                no := w.canon_off[ins.d] + cv
                                if no >= 0 && no < 1048576 && (w.canon_base[t] != w.canon_base[ins.d] || w.canon_off[t] != no) {
                                    w.canon_base[t] = w.canon_base[ins.d]
                                    w.canon_off[t] = no
                                    prog = true
                                }
                            }
                        } else if ins.c >= 0 && ins.c < nt && w.maybe_loc[ins.c] >= 0 && (ins.d < 0 || w.maybe_loc[ins.d] < 0) {
                            if w.maybe_loc[t] < 0 {
                                w.maybe_loc[t] = w.maybe_loc[ins.c]
                                prog = true
                            }
                        } else if ins.b == BIN_ADD && ins.d >= 0 && ins.d < nt && w.maybe_loc[ins.d] >= 0 && (ins.c < 0 || w.maybe_loc[ins.c] < 0) {
                            if w.maybe_loc[t] < 0 {
                                w.maybe_loc[t] = w.maybe_loc[ins.d]
                                prog = true
                            }
                        }
                    }
                }
                ii = ins.next
            }
        }
        if !prog {
            <-
        }
    }
    if any_unk {
        licm_fill_bool($&w.loc_escaped, nl, true)
    } else {
        for bi in 0:nb0 {
            if !w.reach[bi] {
                ->
            }
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                if k == MI_STORE_LOCAL || k == MI_STORE_PTR {
                    if ins.b >= 0 && ins.b < nt && w.maybe_loc[ins.b] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.b]] = true
                    }
                } else if k == MI_CALL || k == MI_CALL_IND {
                    if k == MI_CALL_IND && ins.b >= 0 && ins.b < nt && w.maybe_loc[ins.b] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.b]] = true
                    }
                    $a := ins.c
                    $ai := 0
                    while a >= 0 {
                        av := f.margs[a].v
                        if av >= 0 && av < nt && w.maybe_loc[av] >= 0 && !licm_escape_call_exempt(ins, ai) {
                            w.loc_escaped[w.maybe_loc[av]] = true
                        }
                        a = f.margs[a].next
                        ai += 1
                    }
                } else if k == MI_SELECT {
                    if ins.b >= 0 && ins.b < nt && w.maybe_loc[ins.b] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.b]] = true
                    }
                    if ins.c >= 0 && ins.c < nt && w.maybe_loc[ins.c] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.c]] = true
                    }
                    if ins.d >= 0 && ins.d < nt && w.maybe_loc[ins.d] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.d]] = true
                    }
                } else if k == MI_BIN && ins.b != BIN_ADD && ins.b != BIN_SUB {
                    if ins.c >= 0 && ins.c < nt && w.maybe_loc[ins.c] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.c]] = true
                    }
                    if ins.d >= 0 && ins.d < nt && w.maybe_loc[ins.d] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.d]] = true
                    }
                } else if k == MI_UN {
                    if ins.c >= 0 && ins.c < nt && w.maybe_loc[ins.c] >= 0 {
                        w.loc_escaped[w.maybe_loc[ins.c]] = true
                    }
                }
                ii = ins.next
            }
            if f.blocks[bi].tkind == TKIND_RETURN {
                rv := f.blocks[bi].ta
                if rv >= 0 && rv < nt && w.maybe_loc[rv] >= 0 {
                    w.loc_escaped[w.maybe_loc[rv]] = true
                }
            }
        }
    }
    $max_scope := 0
    $fresh_alloc_loc := []bool{}
    $fresh_has_alloc := []bool{}
    $fresh_bad := []bool{}
    for _ in 0:nl {
        fresh_alloc_loc.push(false)
        fresh_has_alloc.push(false)
        fresh_bad.push(false)
    }
    for bi in 0:nb0 {
        if !w.reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.scope_id > max_scope {
                max_scope = ins.scope_id
            }
            if licm_is_fresh_alloc_call(ins) && ins.c >= 0 && ins.c < f.margs.len {
                dp := f.margs[ins.c].v
                if dp >= 0 && dp < nt && w.addr_exact[dp] && w.addr_off[dp] == 0 {
                    lr := w.addr_root[dp]
                    if lr >= 0 && lr < nl {
                        fresh_has_alloc[lr] = true
                    }
                }
            }
            if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl && ins.c == 0 {
                fresh_bad[ins.a] = true
            } else if ins.kind == MI_STORE_PTR {
                if ins.a >= 0 && ins.a < nt && w.addr_exact[ins.a] {
                    lr := w.addr_root[ins.a]
                    lo := w.addr_off[ins.a] + ins.c
                    lw := licm_wbytes(ins.d)
                    if lr >= 0 && lr < nl && lo < 8 && lo + lw > 0 {
                        if !(lo == 0 && lw == 8 && ins.b <= -2 && f.consts[0 - ins.b - 2] == 0) {
                            fresh_bad[lr] = true
                        }
                    }
                } else if ins.a >= 0 && ins.a < nt && w.maybe_loc[ins.a] >= 0 {
                    lr := w.maybe_loc[ins.a]
                    if lr >= 0 && lr < nl {
                        fresh_bad[lr] = true
                    }
                }
            }
            ii = ins.next
        }
    }
    for l in 0:nl {
        fresh_alloc_loc[l] = l >= f.nparams && !w.loc_escaped[l] && fresh_has_alloc[l] && !fresh_bad[l]
    }
    $fresh_scope_base := max_scope + 1
    if fresh_scope_base < 10000 {
        fresh_scope_base = 10000
    }
    // Identify proven slice descriptors via bounds checks (idx >= load8 [desc+8])
    // and track pointers derived from their element buffer [desc+0].
    for bi in 0:nb0 {
        if !w.reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.kind == MI_BIN && ins.sval == "bounds" && ins.b == BIN_GE && ins.d >= 0 && ins.d < nt && w.def_cnt[ins.d] == 1 {
                li := w.def_ii[ins.d]
                if li >= 0 && f.instrs[li].kind == MI_LOAD_PTR && f.instrs[li].c >= 8 && (f.instrs[li].c & 7) == 0 && licm_wbytes(f.instrs[li].d) == 8 {
                    dp := f.instrs[li].b
                    if dp >= 0 && dp < nt && w.desc_root[dp] >= 0 {
                        dr := w.desc_root[dp]
                        doff := w.desc_off[dp] + f.instrs[li].c - 8
                        if doff == 0 {
                            w.slice_desc_loc[dr] = true
                        }
                        $seen_sd := false
                        for sdi in 0:sdesc_roots.len {
                            if sdesc_roots[sdi] == dr && sdesc_offs[sdi] == doff {
                                seen_sd = true
                                <-
                            }
                        }
                        if !seen_sd {
                            sdesc_roots.push(dr)
                            sdesc_offs.push(doff)
                        }
                    }
                }
            } else if licm_is_arg0_append_call(ins) && ins.c >= 0 && ins.c < f.margs.len {
                dp := f.margs[ins.c].v
                if dp >= 0 && dp < nt && w.desc_root[dp] >= 0 {
                    dr := w.desc_root[dp]
                    doff := w.desc_off[dp]
                    if doff == 0 {
                        w.slice_desc_loc[dr] = true
                    }
                    $seen_sd := false
                    for sdi in 0:sdesc_roots.len {
                        if sdesc_roots[sdi] == dr && sdesc_offs[sdi] == doff {
                            seen_sd = true
                            <-
                        }
                    }
                    if !seen_sd {
                        sdesc_roots.push(dr)
                        sdesc_offs.push(doff)
                    }
                }
            }
            ii = ins.next
        }
    }
    for _ in 0:4 {
        $bprog := false
        for bi in 0:nb0 {
            if !w.reach[bi] { -> }
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                t := ins.a
                if fold_defines(ins.kind) && t >= 0 && t < nt && w.def_cnt[t] == 1 && w.buf_owner[t] < 0 && w.buf_scope[t] == 0 {
                    if ins.kind == MI_LOAD_PTR && licm_wbytes(ins.d) == 8 && ins.b >= 0 && ins.b < nt {
                        dl := w.desc_root[ins.b]
                        if dl >= 0 {
                            ld_off := w.desc_off[ins.b] + ins.c
                            $matched_sd := false
                            for sdi in 0:sdesc_roots.len {
                                if sdesc_roots[sdi] == dl && sdesc_offs[sdi] == ld_off {
                                    matched_sd = true
                                    <-
                                }
                            }
                            if matched_sd {
                                w.buf_owner[t] = dl
                                if ins.scope_id > 0 {
                                    w.buf_scope[t] = ins.scope_id
                                }
                                bprog = true
                            }
                        }
                        if w.buf_scope[t] == 0 && w.addr_exact[ins.b] && w.addr_off[ins.b] + ins.c == 0 {
                            fl := w.addr_root[ins.b]
                            if fl >= 0 && fl < nl && fresh_alloc_loc[fl] {
                                if w.buf_owner[t] < 0 {
                                    w.buf_owner[t] = fl
                                }
                                w.buf_scope[t] = fresh_scope_base + fl
                                bprog = true
                            }
                        }
                    } else if ins.kind == MI_COPY && ins.b >= 0 && ins.b < nt && w.def_cnt[ins.b] == 1 && (w.buf_owner[ins.b] >= 0 || w.buf_scope[ins.b] > 0) {
                        w.buf_owner[t] = w.buf_owner[ins.b]
                        w.buf_scope[t] = w.buf_scope[ins.b]
                        bprog = true
                    } else if ins.kind == MI_BIN && ins.b == BIN_ADD {
                        $oc := -1
                        $sc := 0
                        if ins.c >= 0 && ins.c < nt && w.def_cnt[ins.c] == 1 {
                            oc = w.buf_owner[ins.c]
                            sc = w.buf_scope[ins.c]
                        }
                        $od := -1
                        $sd := 0
                        if ins.d >= 0 && ins.d < nt && w.def_cnt[ins.d] == 1 {
                            od = w.buf_owner[ins.d]
                            sd = w.buf_scope[ins.d]
                        }
                        if (oc >= 0 || sc > 0) && od < 0 && sd == 0 {
                            w.buf_owner[t] = oc
                            w.buf_scope[t] = sc
                            bprog = true
                        } else if (od >= 0 || sd > 0) && oc < 0 && sc == 0 {
                            w.buf_owner[t] = od
                            w.buf_scope[t] = sd
                            bprog = true
                        }
                    } else if ins.kind == MI_BIN && ins.b == BIN_SUB {
                        if ins.c >= 0 && ins.c < nt && w.def_cnt[ins.c] == 1 && (w.buf_owner[ins.c] >= 0 || w.buf_scope[ins.c] > 0) &&
                           (ins.d < 0 || ins.d >= nt || (w.buf_owner[ins.d] < 0 && w.buf_scope[ins.d] == 0)) {
                            w.buf_owner[t] = w.buf_owner[ins.c]
                            w.buf_scope[t] = w.buf_scope[ins.c]
                            bprog = true
                        }
                    }
                }
                ii = ins.next
            }
        }
        if !bprog { <- }
    }
    *out_any_unk = any_unk
    *out_fresh_base = fresh_scope_base
}

fn licm_recompute_loc_escaped_with_calls(f &MFn, w $&LicmWork, gw &GvnWork, any_unk bool) {
    nl := f.locals.len
    nt := f.temps.len
    if any_unk {
        licm_fill_bool($&w.loc_escaped, nl, true)
        <<
    }
    licm_fill_bool($&w.loc_escaped, nl, false)
    for bi in 0:f.blocks.len {
        if bi >= w.reach.len || !w.reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_STORE_LOCAL || k == MI_STORE_PTR || k == MI_VOLATILE_STORE {
                if ins.b >= 0 && ins.b < nt && w.maybe_loc[ins.b] >= 0 {
                    w.loc_escaped[w.maybe_loc[ins.b]] = true
                }
            } else if k == MI_CALL_IND {
                if ins.b >= 0 && ins.b < nt && w.maybe_loc[ins.b] >= 0 {
                    w.loc_escaped[w.maybe_loc[ins.b]] = true
                }
                $a := ins.c
                while a >= 0 && a < f.margs.len {
                    av := f.margs[a].v
                    if av >= 0 && av < nt && w.maybe_loc[av] >= 0 {
                        w.loc_escaped[w.maybe_loc[av]] = true
                    }
                    a = f.margs[a].next
                }
            } else if k == MI_CALL && !is_panic_call(ins) {
                is_known_rt := licm_is_pure_vec_call(ins) || licm_is_arg0_append_call(ins) ||
                               licm_is_arg0_buf_write_call(ins) || licm_is_fresh_alloc_call(ins)
                $ceff := -1
                $noesc := 0
                if !is_known_rt {
                    ceff = gvn_call_effect_of(gw, ins)
                    if ceff >= 0 {
                        noesc = gvn_call_noesc_mask(gw, &ins.sval)
                    }
                }
                $a := ins.c
                $ai := 0
                while a >= 0 && a < f.margs.len {
                    av := f.margs[a].v
                    if av >= 0 && av < nt && w.maybe_loc[av] >= 0 {
                        if is_known_rt {
                            if ai > 0 {
                                w.loc_escaped[w.maybe_loc[av]] = true
                            }
                        } else if ceff < 0 || ai >= 58 || (noesc & (1 << ai)) == 0 {
                            w.loc_escaped[w.maybe_loc[av]] = true
                        }
                    }
                    ai += 1
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        if f.blocks[bi].tkind == TKIND_RETURN {
            rv := f.blocks[bi].ta
            if rv >= 0 && rv < nt && w.maybe_loc[rv] >= 0 {
                w.loc_escaped[w.maybe_loc[rv]] = true
            }
        }
    }
}

fn licm_call_arg_at(f &MFn, head int, param int) int {
    $a := head
    $ai := 0
    while a >= 0 && a < f.margs.len {
        if ai == param { << f.margs[a].v }
        ai += 1
        a = f.margs[a].next
    }
    << -1
}

pub fn opt_licm_typed_with(f $&MFn, w $&LicmWork) bool {
    dummy_gw := gvn_work_new()
    << licm_typed_impl(f, w, false, &dummy_gw)
}

pub fn opt_licm_typed_with_calls(f $&MFn, w $&LicmWork, gw &GvnWork) bool {
    << licm_typed_impl(f, w, true, gw)
}

fn licm_typed_impl(f $&MFn, w $&LicmWork, use_gvn bool, gw &GvnWork) bool {
    nb0 := f.blocks.len
    $nt := f.temps.len
    nl := f.locals.len
    if nb0 < 2 || nt == 0 {
        << false
    }
    $loops := find_loops(f, false)
    if loops.len == 0 {
        << false
    }
    licm_mark_reach(f, w)
    peeled := opt_peel_inv_guards(f, w, &loops)
    if peeled {
        loops = find_loops(f, false)
        if loops.len == 0 {
            << true
        }
        licm_mark_reach(f, w)
    }
    $sdesc_roots := []int{}
    $sdesc_offs := []int{}
    $any_unk := false
    $fresh_scope_base := 10000
    licm_build_alias_info(f, w, $&sdesc_roots, $&sdesc_offs, $&any_unk, $&fresh_scope_base)
    if use_gvn {
        licm_recompute_loc_escaped_with_calls(f, w, gw, any_unk)
    }
    // Order loops smallest-body first (inner-to-outer).
    $order := []int{}
    for i in 0:loops.len {
        order.push(i)
    }
    for i in 1:order.len {
        key := order[i]
        klen := loops[key].blocks.len
        $j := i - 1
        while j >= 0 && loops[order[j]].blocks.len > klen {
            order[j + 1] = order[j]
            j -= 1
        }
        order[j + 1] = key
    }
    $changed := false
    for oi in 0:order.len {
        lidx := order[oi]
        lp := &loops[lidx]
        h := lp.header
        if h <= 0 || h >= f.blocks.len || !w.reach[h] {
            ->
        }
        $has_unk := false
        $has_impure_call := false
        $has_opaque_call := false
        $lp_stores := []int{}
        $lp_call_k := []int{}
        $lp_call_id := []int{}
        $lp_call_bscopes := []int{}
        licm_fill_bool($&w.loc_stored, nl, false)
        for bi_i in 0:lp.blocks.len {
            b := lp.blocks[bi_i]
            if b < w.blk_unk.len && w.blk_unk[b] {
                has_unk = true
                <-
            }
            $ii := f.blocks[b].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_CALL_IND {
                    has_impure_call = true
                    has_opaque_call = true
                } else if ins.kind == MI_CALL && !is_panic_call(ins) {
                    if !licm_is_pure_vec_call(ins) {
                        if licm_is_arg0_append_call(ins) && ins.c >= 0 && ins.c < f.margs.len {
                            has_impure_call = true
                            $ak := 0
                            $aid := -1
                            if licm_resolve_ptr_origin(f, w, f.margs[ins.c].v, $&ak, $&aid) {
                                lp_call_k.push(ak)
                                lp_call_id.push(aid)
                            } else {
                                has_opaque_call = true
                            }
                        } else if licm_is_arg0_buf_write_call(ins) && ins.c >= 0 && ins.c < f.margs.len {
                            has_impure_call = true
                            av := f.margs[ins.c].v
                            if av >= 0 && av < nt && w.buf_scope[av] > 0 {
                                lp_call_bscopes.push(w.buf_scope[av])
                            } else {
                                has_opaque_call = true
                            }
                        } else if use_gvn {
                            ceff := gvn_call_effect_of(gw, ins)
                            if ceff == 0 {
                                // Pure/readonly call per interprocedural summary.
                            } else if ceff > 0 {
                                has_impure_call = true
                                nw_c := gvn_call_write_count(gw, ceff)
                                $cw_ok := nw_c > 0
                                for wi in 0:nw_c {
                                    param := gvn_call_write_param(gw, ceff, wi)
                                    av := licm_call_arg_at(f, ins.c, param)
                                    if av < 0 {
                                        cw_ok = false
                                        <-
                                    }
                                    $ak := 0
                                    $aid := -1
                                    if licm_resolve_ptr_origin(f, w, av, $&ak, $&aid) {
                                        lp_call_k.push(ak)
                                        lp_call_id.push(aid)
                                    } else if gvn_call_write_is_buf(gw, ceff, wi) && av < nt && w.buf_scope[av] > 0 {
                                        lp_call_bscopes.push(w.buf_scope[av])
                                    } else {
                                        cw_ok = false
                                        <-
                                    }
                                }
                                if !cw_ok {
                                    has_opaque_call = true
                                }
                            } else {
                                has_impure_call = true
                                has_opaque_call = true
                            }
                        } else {
                            has_impure_call = true
                            has_opaque_call = true
                        }
                    }
                }
                if ins.kind == MI_STORE_PTR {
                    lp_stores.push(ii)
                } else if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                    w.loc_stored[ins.a] = true
                }
                ii = ins.next
            }
        }
        if has_unk {
            ->
        }
        // Verify single-entry naturalness and collect external reachable preds of h.
        $irreducible := false
        $ext_preds := []int{}
        for p in 0:f.blocks.len {
            if !w.reach[p] || lp.body[p] {
                ->
            }
            tk := f.blocks[p].tkind
            if tk == TKIND_JUMP {
                s := f.blocks[p].ta
                if s == h {
                    ext_preds.push(p)
                } else if s >= 0 && s < lp.body.len && lp.body[s] {
                    irreducible = true
                    <-
                }
            } else if tk == TKIND_BRANCH {
                sb := f.blocks[p].tb
                sc := f.blocks[p].tc
                if sb == h || sc == h {
                    ext_preds.push(p)
                }
                if (sb != h && sb >= 0 && sb < lp.body.len && lp.body[sb]) ||
                   (sc != h && sc >= 0 && sc < lp.body.len && lp.body[sc]) {
                    irreducible = true
                    <-
                }
            }
        }
        if irreducible || ext_preds.len == 0 {
            ->
        }
        licm_fill_int($&w.dom_cache, f.blocks.len, -1)
        licm_fill_bool($&w.inv, nt, false)
        $max_hoist := 24
        if has_impure_call {
            if has_opaque_call {
                max_hoist = 6
            } else {
                max_hoist = 16
            }
        } else if licm_distribute_affine(f, w, lp, max_hoist) {
            nt = f.temps.len
            changed = true
        }
        $hoist_ii := []int{}
        $hoist_blk := []int{}
        $hoist_cost := 0
        $h_addr_loc := []int{}
        $h_addr_t := []int{}
        $h_ld_k := []int{}
        $h_ld_id := []int{}
        $h_ld_off := []int{}
        $h_ld_w := []int{}
        $h_ld_t := []int{}
        for _ in 0:8 {
            $found := false
            for bi_i in 0:lp.blocks.len {
                b := lp.blocks[bi_i]
                $ii := f.blocks[b].head
                while ii >= 0 {
                    k := f.instrs[ii].kind
                    dest := f.instrs[ii].a
                    ib := f.instrs[ii].b
                    ic := f.instrs[ii].c
                    id := f.instrs[ii].d
                    nx := f.instrs[ii].next
                    if hoist_cost < max_hoist && fold_defines(k) && dest >= 0 && dest < nt && w.def_cnt[dest] == 1 && !w.inv[dest] {
                        $ok := false
                        if k == MI_ADDR {
                            ok = !has_opaque_call
                        } else if k == MI_STR_CONST || k == MI_LOAD_FN_ADDR {
                            ok = !has_impure_call
                        } else if k == MI_COPY {
                            ok = licm_is_inv(f, w, lp, ib)
                        } else if k == MI_LOAD_LOCAL {
                            ok = !any_unk && ib >= 0 && ib < nl && !w.loc_addr_taken[ib] && !w.loc_stored[ib] && ic >= 0
                        } else if k == MI_UN {
                            ok = licm_is_inv(f, w, lp, ic)
                        } else if k == MI_BIN {
                            ok = licm_is_safe_bin(f, ib, id) && licm_is_inv(f, w, lp, ic) && licm_is_inv(f, w, lp, id)
                        } else if k == MI_SELECT {
                            ok = licm_is_inv(f, w, lp, ib) && licm_is_inv(f, w, lp, ic) && licm_is_inv(f, w, lp, id)
                        } else if k == MI_LOAD_PTR && !has_opaque_call {
                            wl := licm_wbytes(id)
                            ptr_inv := ib >= 0 && ic >= 0 && licm_is_inv(f, w, lp, ib)
                            $alias_ok := ptr_inv && licm_load_ptr_alias_safe(f, w, &lp_stores, ib, ic, wl, ptr_inv)
                            if ptr_inv && !alias_ok && f.instrs[ii].scope_id > 0 {
                                $is_shdr := false
                                if wl == 8 && ib >= 0 && ib < w.desc_root.len && w.desc_root[ib] >= 0 {
                                    hr := w.desc_root[ib]
                                    ho := w.desc_off[ib] + ic
                                    for sdi in 0:sdesc_roots.len {
                                        if sdesc_roots[sdi] == hr {
                                            sd_o := sdesc_offs[sdi]
                                            if ho == sd_o || ho == sd_o + 8 || ho == sd_o + 16 {
                                                is_shdr = true
                                                <-
                                            }
                                        }
                                    }
                                }
                                alias_ok = licm_scope_disjoint_from_stores(f, w, &lp_stores, f.instrs[ii].scope_id, is_shdr, ib, ic, wl, ptr_inv)
                            }
                            $trap_ok := ptr_inv && licm_load_ptr_trap_safe(f, w, lp, b, ii, ib, ic, wl)
                            if ptr_inv && !trap_ok && f.instrs[ii].scope_id > 0 && ic >= 0 && ic < 4096 {
                                trap_ok = true
                            }
                            $call_ok := true
                            if has_impure_call {
                                call_ok = licm_load_disjoint_from_append_calls(f, w, ib, f.instrs[ii].scope_id, &lp_call_k, &lp_call_id, &lp_call_bscopes, fresh_scope_base)
                            }
                            if ptr_inv && alias_ok && trap_ok && call_ok {
                                ok = true
                            }
                        }
                        if ok {
                            $dedup_t := -1
                            if k == MI_ADDR {
                                for ai in 0:h_addr_loc.len {
                                    if h_addr_loc[ai] == ib {
                                        dedup_t = h_addr_t[ai]
                                        <-
                                    }
                                }
                                if dedup_t < 0 {
                                    h_addr_loc.push(ib)
                                    h_addr_t.push(dest)
                                }
                            } else if k == MI_LOAD_PTR {
                                $lk := 2
                                $lid := ib
                                $loff := ic
                                if ib >= 0 && ib < w.desc_root.len && w.desc_root[ib] >= 0 {
                                    lk = 1
                                    lid = w.desc_root[ib]
                                    loff = w.desc_off[ib] + ic
                                }
                                for li2 in 0:h_ld_k.len {
                                    if h_ld_k[li2] == lk && h_ld_id[li2] == lid && h_ld_off[li2] == loff && h_ld_w[li2] == id {
                                        dedup_t = h_ld_t[li2]
                                        <-
                                    }
                                }
                                if dedup_t < 0 {
                                    h_ld_k.push(lk)
                                    h_ld_id.push(lid)
                                    h_ld_off.push(loff)
                                    h_ld_w.push(id)
                                    h_ld_t.push(dest)
                                }
                            }
                            w.inv[dest] = true
                            if dedup_t >= 0 {
                                f.instrs[ii].kind = MI_COPY
                                f.instrs[ii].b = dedup_t
                                f.instrs[ii].c = -1
                                f.instrs[ii].d = -1
                                f.instrs[ii].sval = ""
                                f.instrs[ii].scope_id = 0
                                changed = true
                            } else {
                                hoist_cost += 1
                            }
                            hoist_ii.push(ii)
                            hoist_blk.push(b)
                            found = true
                        }
                    }
                    ii = nx
                }
            }
            if !found || hoist_cost >= max_hoist {
                <-
            }
        }
        if hoist_ii.len == 0 {
            ->
        }
        $ph := -1
        if ext_preds.len == 1 {
            ep := ext_preds[0]
            if f.blocks[ep].tkind == TKIND_JUMP && f.blocks[ep].ta == h {
                ph = ep
            }
        }
        if ph < 0 {
            ph = f.blocks.len
            $nb := mblock_new()
            nb.tkind = TKIND_JUMP
            nb.ta = h
            nb.line = f.blocks[h].line
            f.blocks.push(nb)
            if ph < w.reach.len { w.reach[ph] = true } else { w.reach.push(true) }
            if ph < w.blk_unk.len { w.blk_unk[ph] = false } else { w.blk_unk.push(false) }
            for ei in 0:ext_preds.len {
                p := ext_preds[ei]
                if f.blocks[p].tkind == TKIND_JUMP && f.blocks[p].ta == h {
                    f.blocks[p].ta = ph
                } else if f.blocks[p].tkind == TKIND_BRANCH {
                    if f.blocks[p].tb == h { f.blocks[p].tb = ph }
                    if f.blocks[p].tc == h { f.blocks[p].tc = ph }
                }
            }
            for mi in oi + 1:order.len {
                om := order[mi]
                olp := $&loops[om]
                if olp.header != h && h < olp.body.len && olp.body[h] {
                    $all_in := true
                    for ei in 0:ext_preds.len {
                        ep := ext_preds[ei]
                        if ep >= olp.body.len || !olp.body[ep] {
                            all_in = false
                            <-
                        }
                    }
                    olp.body.push(all_in)
                    if all_in {
                        olp.blocks.push(ph)
                    }
                } else {
                    olp.body.push(false)
                }
            }
        }
        for ki in 0:hoist_ii.len {
            hii := hoist_ii[ki]
            mir_detach_instr(f, hoist_blk[ki], hii)
            mir_append_instr(f, ph, hii)
            hd := f.instrs[hii].a
            if hd >= 0 && hd < nt {
                w.def_blk[hd] = ph
            }
        }
        changed = true
    }
    if opt_iv_sr_with(f, w) {
        changed = true
    }
    << peeled || changed
}
// ===== Loop-Carried Store-to-Load Forwarding =====

fn lc_new_local(f $&MFn, ty int, name string) int {
    id := f.locals.len
    while f.locals_nslots.len < id {
        f.locals_nslots.push(1)
    }
    while f.locals_owning.len < id {
        f.locals_owning.push(false)
    }
    while f.local_names.len < id {
        f.local_names.push("")
    }
    f.locals.push(ty)
    f.locals_nslots.push(1)
    f.locals_owning.push(false)
    f.local_names.push(name)
    << id
}

fn iv_insert_after(f $&MFn, blk int, after_ii int, ins MInstr) int {
    ni := f.instrs.len
    $new_ins := ~ins
    nx := f.instrs[after_ii].next
    new_ins.next = nx
    f.instrs.push(~new_ins)
    f.instrs[after_ii].next = ni
    if nx < 0 {
        f.blocks[blk].tail = ni
    }
    << ni
}

fn opt_iv_sr_with(f $&MFn, w $&LicmWork) bool {
    nt := f.temps.len
    nl := f.locals.len
    if f.blocks.len < 2 || nt == 0 || nl == 0 {
        << false
    }
    $has_mul := false
    for ii in 0:f.instrs.len {
        if f.instrs[ii].kind == MI_BIN && f.instrs[ii].b == BIN_MUL && f.instrs[ii].c >= 0 && f.instrs[ii].d >= 0 {
            has_mul = true
            <-
        }
    }
    if !has_mul {
        << false
    }
    $loops := find_loops(f, false)
    if loops.len == 0 {
        << false
    }
    licm_mark_reach(f, w)
    nb0 := f.blocks.len
    licm_fill_int($&w.def_cnt, nt, 0)
    licm_fill_int($&w.def_blk, nt, -1)
    licm_fill_int($&w.def_ii, nt, -1)
    licm_fill_bool($&w.loc_addr_taken, nl, false)
    licm_fill_bool($&w.blk_unk, nb0, false)
    for bi in 0:nb0 {
        if !w.reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if !fold_known_kind(k) { w.blk_unk[bi] = true }
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                w.def_cnt[ins.a] = w.def_cnt[ins.a] + 1
                w.def_blk[ins.a] = bi
                w.def_ii[ins.a] = ii
            }
            if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                w.loc_addr_taken[ins.b] = true
            }
            ii = ins.next
        }
    }
    $changed := false
    for li in 0:loops.len {
        lp := &loops[li]
        h := lp.header
        if h <= 0 || h >= f.blocks.len || !w.reach[h] || lp.blocks.len < 2 { -> }
        $has_call := false
        $step_blk := -1
        $back_cnt := 0
        for bi_i in 0:lp.blocks.len {
            b := lp.blocks[bi_i]
            if b >= w.blk_unk.len || w.blk_unk[b] {
                has_call = true
                <-
            }
            $ii := f.blocks[b].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_CALL_IND || (ins.kind == MI_CALL && !is_panic_call(ins)) {
                    has_call = true
                    <-
                }
                ii = ins.next
            }
            if has_call { <- }
            tk := f.blocks[b].tkind
            if tk == TKIND_JUMP && f.blocks[b].ta == h {
                step_blk = b
                back_cnt += 1
            } else if tk == TKIND_BRANCH && (f.blocks[b].tb == h || f.blocks[b].tc == h) {
                back_cnt += 2
            }
        }
        if has_call || back_cnt != 1 || step_blk < 0 { -> }
        // Require single-entry loop and collect external reachable predecessors.
        $irreducible := false
        $ext_preds := []int{}
        for p in 0:f.blocks.len {
            if !w.reach[p] || (p < lp.body.len && lp.body[p]) { -> }
            tk := f.blocks[p].tkind
            if tk == TKIND_JUMP {
                s := f.blocks[p].ta
                if s == h { ext_preds.push(p) }
                else if s >= 0 && s < lp.body.len && lp.body[s] {
                    irreducible = true
                    <-
                }
            } else if tk == TKIND_BRANCH {
                sb := f.blocks[p].tb
                sc := f.blocks[p].tc
                if sb == h || sc == h { ext_preds.push(p) }
                if (sb != h && sb >= 0 && sb < lp.body.len && lp.body[sb]) ||
                   (sc != h && sc >= 0 && sc < lp.body.len && lp.body[sc]) {
                    irreducible = true
                    <-
                }
            }
        }
        if irreducible || ext_preds.len == 0 { -> }
        // Find single-store integer induction local updated in step_blk.
        $iv := -1
        $step_store_ii := -1
        $step_val := -1
        $iv_store_cnt := []int{}
        for _ in 0:nl { iv_store_cnt.push(0) }
        for bi_i in 0:lp.blocks.len {
            b := lp.blocks[bi_i]
            $ii := f.blocks[b].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl && ins.c == 0 {
                    iv_store_cnt[ins.a] = iv_store_cnt[ins.a] + 1
                }
                ii = ins.next
            }
        }
        licm_fill_int($&w.dom_cache, f.blocks.len, -1)
        $sii := f.blocks[step_blk].head
        while sii >= 0 {
            sins := &f.instrs[sii]
            if sins.kind == MI_STORE_LOCAL && sins.a >= 0 && sins.a < nl && sins.c == 0 &&
               iv_store_cnt[sins.a] == 1 && !w.loc_addr_taken[sins.a] &&
               sins.a < f.locals_nslots.len && f.locals_nslots[sins.a] == 1 && f.locals[sins.a] == 1 {
                cand_iv := sins.a
                v := sins.b
                if v >= 0 && v < w.def_cnt.len && w.def_cnt[v] == 1 && w.def_blk[v] == step_blk {
                    adi := w.def_ii[v]
                    if adi >= 0 && f.instrs[adi].kind == MI_BIN && f.instrs[adi].b == BIN_ADD {
                        $ld_t := -1
                        $st_v := -1
                        ac := f.instrs[adi].c
                        ad := f.instrs[adi].d
                        if ac >= 0 && ac < w.def_cnt.len && w.def_cnt[ac] == 1 && w.def_blk[ac] == step_blk {
                            lci := w.def_ii[ac]
                            if lci >= 0 && f.instrs[lci].kind == MI_LOAD_LOCAL && f.instrs[lci].b == cand_iv && f.instrs[lci].c == 0 {
                                ld_t = ac
                                st_v = ad
                            }
                        }
                        if ld_t < 0 && ad >= 0 && ad < w.def_cnt.len && w.def_cnt[ad] == 1 && w.def_blk[ad] == step_blk {
                            ldi := w.def_ii[ad]
                            if ldi >= 0 && f.instrs[ldi].kind == MI_LOAD_LOCAL && f.instrs[ldi].b == cand_iv && f.instrs[ldi].c == 0 {
                                ld_t = ad
                                st_v = ac
                            }
                        }
                        if ld_t >= 0 {
                            $st_ok := false
                            if st_v <= -2 {
                                st_ok = true
                            } else if st_v >= 0 && st_v < w.def_cnt.len && w.def_cnt[st_v] == 1 {
                                db := w.def_blk[st_v]
                                if db >= 0 && (db >= lp.body.len || !lp.body[db]) && licm_dom(f, db, h, w) {
                                    st_ok = true
                                }
                            }
                            if st_ok {
                                iv = cand_iv
                                step_store_ii = sii
                                step_val = st_v
                                <-
                            }
                        }
                    }
                }
            }
            sii = sins.next
        }
        if iv < 0 { -> }
        // Collect up to 2 invariant*iv multiplications in lp executed before step_store_ii.
        $sr_muls := []int{}
        $sr_invs := []int{}
        for bi_i in 0:lp.blocks.len {
            b := lp.blocks[bi_i]
            $ii := f.blocks[b].head
            $past_step := false
            while ii >= 0 {
                if ii == step_store_ii {
                    past_step = true
                }
                ins := &f.instrs[ii]
                if ins.kind == MI_BIN && ins.b == BIN_MUL && ins.a >= 0 && ins.a < nt &&
                   ins.c >= 0 && ins.d >= 0 && sr_muls.len < 2 {
                    if b == step_blk && past_step {
                        <-
                    }
                    $inv := -1
                    $c_ok := ins.c < w.def_cnt.len && w.def_cnt[ins.c] == 1
                    $d_ok := ins.d < w.def_cnt.len && w.def_cnt[ins.d] == 1
                    if c_ok {
                        cii := w.def_ii[ins.c]
                        if cii >= 0 && f.instrs[cii].kind == MI_LOAD_LOCAL && f.instrs[cii].b == iv && f.instrs[cii].c == 0 {
                            cblk := w.def_blk[ins.c]
                            if cblk != step_blk || licm_dom(f, b, step_blk, w) {
                                if d_ok && (w.def_blk[ins.d] >= lp.body.len || !lp.body[w.def_blk[ins.d]]) && licm_dom(f, w.def_blk[ins.d], h, w) {
                                    inv = ins.d
                                }
                            }
                        }
                    }
                    if inv < 0 && d_ok {
                        dii := w.def_ii[ins.d]
                        if dii >= 0 && f.instrs[dii].kind == MI_LOAD_LOCAL && f.instrs[dii].b == iv && f.instrs[dii].c == 0 {
                            dblk := w.def_blk[ins.d]
                            if dblk != step_blk || licm_dom(f, b, step_blk, w) {
                                if c_ok && (w.def_blk[ins.c] >= lp.body.len || !lp.body[w.def_blk[ins.c]]) && licm_dom(f, w.def_blk[ins.c], h, w) {
                                    inv = ins.c
                                }
                            }
                        }
                    }
                    if inv >= 0 {
                        sr_muls.push(ii)
                        sr_invs.push(inv)
                    }
                }
                ii = ins.next
            }
        }
        if sr_muls.len == 0 { -> }
        // Reuse or create preheader ph jumping unconditionally to h.
        $ph := -1
        if ext_preds.len == 1 {
            ep := ext_preds[0]
            if f.blocks[ep].tkind == TKIND_JUMP && f.blocks[ep].ta == h {
                ph = ep
            }
        }
        if ph < 0 {
            ph = f.blocks.len
            $nb := mblock_new()
            nb.tkind = TKIND_JUMP
            nb.ta = h
            nb.line = f.blocks[h].line
            f.blocks.push(nb)
            if ph < w.reach.len { w.reach[ph] = true } else { w.reach.push(true) }
            if ph < w.blk_unk.len { w.blk_unk[ph] = false } else { w.blk_unk.push(false) }
            for ei in 0:ext_preds.len {
                p := ext_preds[ei]
                if f.blocks[p].tkind == TKIND_JUMP && f.blocks[p].ta == h {
                    f.blocks[p].ta = ph
                } else if f.blocks[p].tkind == TKIND_BRANCH {
                    if f.blocks[p].tb == h { f.blocks[p].tb = ph }
                    if f.blocks[p].tc == h { f.blocks[p].tc = ph }
                }
            }
            for mi in li + 1:loops.len {
                olp := $&loops[mi]
                if olp.header != h && h < olp.body.len && olp.body[h] {
                    $all_in := true
                    for ei in 0:ext_preds.len {
                        ep := ext_preds[ei]
                        if ep >= olp.body.len || !olp.body[ep] {
                            all_in = false
                            <-
                        }
                    }
                    olp.body.push(all_in)
                    if all_in { olp.blocks.push(ph) }
                } else {
                    olp.body.push(false)
                }
            }
        }
        hline := f.blocks[h].line
        t_iv0 := alloc_temp(f)
        $ldi0 := minstr_new(MI_LOAD_LOCAL)
        ldi0.a = t_iv0
        ldi0.b = iv
        ldi0.c = 0
        ldi0.line = hline
        f.instrs.push(ldi0)
        mir_append_instr(f, ph, f.instrs.len - 1)
        for si in 0:sr_muls.len {
            mii := sr_muls[si]
            inv := sr_invs[si]
            l_sr := lc_new_local(f, 1, ".ivsr")
            t_sr0 := alloc_temp(f)
            $mi0 := minstr_new(MI_BIN)
            mi0.a = t_sr0
            mi0.b = BIN_MUL
            mi0.c = t_iv0
            mi0.d = inv
            mi0.line = hline
            f.instrs.push(mi0)
            mir_append_instr(f, ph, f.instrs.len - 1)
            $si0 := minstr_new(MI_STORE_LOCAL)
            si0.a = l_sr
            si0.b = t_sr0
            si0.c = 0
            si0.line = hline
            f.instrs.push(si0)
            mir_append_instr(f, ph, f.instrs.len - 1)
            $delta_v := inv
            if !(step_val <= -2 && f.consts[0 - step_val - 2] == 1) {
                delta_v = alloc_temp(f)
                $di := minstr_new(MI_BIN)
                di.a = delta_v
                di.b = BIN_MUL
                di.c = inv
                di.d = step_val
                di.line = hline
                f.instrs.push(di)
                mir_append_instr(f, ph, f.instrs.len - 1)
            }
            f.instrs[mii].kind = MI_LOAD_LOCAL
            f.instrs[mii].b = l_sr
            f.instrs[mii].c = 0
            f.instrs[mii].d = 0
            t_cur := alloc_temp(f)
            t_nxt := alloc_temp(f)
            $ins_ld := minstr_new(MI_LOAD_LOCAL)
            ins_ld.a = t_cur
            ins_ld.b = l_sr
            ins_ld.c = 0
            ins_ld.line = f.instrs[step_store_ii].line
            i1 := iv_insert_after(f, step_blk, step_store_ii, ins_ld)
            $ins_add := minstr_new(MI_BIN)
            ins_add.a = t_nxt
            ins_add.b = BIN_ADD
            ins_add.c = t_cur
            ins_add.d = delta_v
            ins_add.line = f.instrs[step_store_ii].line
            i2 := iv_insert_after(f, step_blk, i1, ins_add)
            $ins_st := minstr_new(MI_STORE_LOCAL)
            ins_st.a = l_sr
            ins_st.b = t_nxt
            ins_st.c = 0
            ins_st.line = f.instrs[step_store_ii].line
            iv_insert_after(f, step_blk, i2, ins_st)
            changed = true
        }
    }
    << changed
}

fn lc_temp_used_in_instr(f &MFn, ins &MInstr, t1 int, t2 int) bool {
    k := ins.kind
    if k == MI_NOP || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_STR_CONST || k == MI_LOAD_FN_ADDR {
        << false
    }
    if k == MI_COPY || k == MI_LOAD_PTR {
        << ins.b == t1 || ins.b == t2
    }
    if k == MI_STORE_LOCAL {
        << ins.b == t1 || ins.b == t2
    }
    if k == MI_STORE_PTR {
        << ins.a == t1 || ins.a == t2 || ins.b == t1 || ins.b == t2
    }
    if k == MI_BIN {
        << ins.c == t1 || ins.c == t2 || ins.d == t1 || ins.d == t2
    }
    if k == MI_UN {
        << ins.c == t1 || ins.c == t2
    }
    if k == MI_SELECT || k == MI_MADD || k == MI_MSUB {
        << ins.b == t1 || ins.b == t2 || ins.c == t1 || ins.c == t2 || ins.d == t1 || ins.d == t2
    }
    if k == MI_CALL || k == MI_CALL_IND {
        if k == MI_CALL_IND && (ins.b == t1 || ins.b == t2) {
            << true
        }
        $a := ins.c
        while a >= 0 {
            av := f.margs[a].v
            if av == t1 || av == t2 {
                << true
            }
            a = f.margs[a].next
        }
        << false
    }
    << true
}

fn lc_is_iv_temp(iv_temps &[]int, v int) bool {
    for i in 0:iv_temps.len {
        if iv_temps[i] == v {
            << true
        }
    }
    << false
}

fn lc_peel_const_inv(f &MFn, w $&LicmWork, lp &LoopInfo, v int, out_off $&int) int {
    *out_off = 0
    if v >= 0 && v < f.temps.len && w.def_cnt[v] == 1 && licm_is_inv(f, w, lp, v) {
        dii := w.def_ii[v]
        ins := &f.instrs[dii]
        if ins.kind == MI_BIN && (ins.b == BIN_ADD || ins.b == BIN_SUB) {
            if ins.c >= 0 && ins.d <= -2 && (0 - ins.d - 2) < f.consts.len && licm_is_inv(f, w, lp, ins.c) {
                $cv := f.consts[0 - ins.d - 2]
                if ins.b == BIN_SUB { cv = 0 - cv }
                if (cv & 7) == 0 && cv >= -512 && cv <= 512 {
                    *out_off = cv
                    << ins.c
                }
            } else if ins.b == BIN_ADD && ins.d >= 0 && ins.c <= -2 && (0 - ins.c - 2) < f.consts.len && licm_is_inv(f, w, lp, ins.d) {
                cv := f.consts[0 - ins.c - 2]
                if (cv & 7) == 0 && cv >= -512 && cv <= 512 {
                    *out_off = cv
                    << ins.d
                }
            }
        }
    }
    << v
}

fn lc_canon_base(f &MFn, w $&LicmWork, lp &LoopInfo, v int, out_ca $&int, out_cb $&int, out_off $&int) {
    $off0 := 0
    cur := lc_peel_const_inv(f, w, lp, v, $&off0)
    $off := off0
    if cur >= 0 && cur < f.temps.len && w.def_cnt[cur] == 1 && licm_is_inv(f, w, lp, cur) {
        cii := w.def_ii[cur]
        cins := &f.instrs[cii]
        if cins.kind == MI_BIN && cins.b == BIN_ADD && cins.c >= 0 && cins.d >= 0 &&
           licm_is_inv(f, w, lp, cins.c) && licm_is_inv(f, w, lp, cins.d) {
            $ox := 0
            $oy := 0
            $ca := lc_peel_const_inv(f, w, lp, cins.c, $&ox)
            $cb := lc_peel_const_inv(f, w, lp, cins.d, $&oy)
            if ca > cb {
                t := ca
                ca = cb
                cb = t
            }
            *out_ca = ca
            *out_cb = cb
            *out_off = off + ox + oy
            <<
        }
    }
    *out_ca = cur
    *out_cb = -1
    *out_off = off
}

fn lc_match_addr8_ex(f &MFn, w $&LicmWork, lp &LoopInfo, ptr int, byte_off int, iv_temps &[]int, body_bi int, out_base $&int, out_anchor_eoff $&int, out_ca $&int, out_cb $&int, out_eoff $&int) bool {
    if ptr < 0 || ptr >= f.temps.len || w.def_cnt[ptr] != 1 || w.def_blk[ptr] != body_bi {
        << false
    }
    if byte_off % 8 != 0 {
        << false
    }
    p_ii := w.def_ii[ptr]
    pins := &f.instrs[p_ii]
    if pins.kind != MI_BIN || pins.b != BIN_ADD {
        << false
    }
    for pass in 0:2 {
        $base := pins.c
        $scaled := pins.d
        if pass == 1 {
            base = pins.d
            scaled = pins.c
        }
        if base < 0 || base >= f.temps.len || !licm_is_inv(f, w, lp, base) {
            ->
        }
        $ca := -1
        $cb := -1
        $extra_byte := 0
        lc_canon_base(f, w, lp, base, $&ca, $&cb, $&extra_byte)
        if scaled < 0 || scaled >= f.temps.len || w.def_cnt[scaled] != 1 || w.def_blk[scaled] != body_bi {
            ->
        }
        s_ii := w.def_ii[scaled]
        sins := &f.instrs[s_ii]
        $idx_t := -1
        if sins.kind == MI_BIN && sins.b == BIN_SHL && sins.d <= -2 {
            cidx := 0 - sins.d - 2
            if cidx >= 0 && cidx < f.consts.len && f.consts[cidx] == 3 {
                idx_t = sins.c
            }
        } else if sins.kind == MI_BIN && sins.b == BIN_MUL {
            if sins.d <= -2 && (0 - sins.d - 2) < f.consts.len && f.consts[0 - sins.d - 2] == 8 {
                idx_t = sins.c
            } else if sins.c <= -2 && (0 - sins.c - 2) < f.consts.len && f.consts[0 - sins.c - 2] == 8 {
                idx_t = sins.d
            }
        }
        if idx_t < 0 || idx_t >= f.temps.len {
            ->
        }
        $eoff := 0
        $ok_idx := false
        if lc_is_iv_temp(iv_temps, idx_t) {
            ok_idx = true
        } else if w.def_cnt[idx_t] == 1 && w.def_blk[idx_t] == body_bi {
            i_ii := w.def_ii[idx_t]
            iins := &f.instrs[i_ii]
            if iins.kind == MI_BIN && iins.b == BIN_ADD {
                if lc_is_iv_temp(iv_temps, iins.c) && iins.d <= -2 {
                    eoff = f.consts[0 - iins.d - 2]
                    ok_idx = true
                } else if lc_is_iv_temp(iv_temps, iins.d) && iins.c <= -2 {
                    eoff = f.consts[0 - iins.c - 2]
                    ok_idx = true
                }
            } else if iins.kind == MI_BIN && iins.b == BIN_SUB {
                if lc_is_iv_temp(iv_temps, iins.c) && iins.d <= -2 {
                    eoff = 0 - f.consts[0 - iins.d - 2]
                    ok_idx = true
                }
            }
        }
        if ok_idx {
            *out_base = base
            *out_anchor_eoff = eoff + byte_off / 8
            *out_ca = ca
            *out_cb = cb
            *out_eoff = eoff + (byte_off + extra_byte) / 8
            << true
        }
    }
    << false
}

fn lc_try_once(f $&MFn, w $&LicmWork) bool {
    loops := find_loops(f, false)
    if loops.len == 0 {
        << false
    }
    nb := f.blocks.len
    nt := f.temps.len
    nl := f.locals.len
    licm_mark_reach(f, w)
    licm_fill_int($&w.def_cnt, nt, 0)
    licm_fill_int($&w.def_blk, nt, -1)
    licm_fill_int($&w.def_ii, nt, -1)
    licm_fill_bool($&w.loc_addr_taken, nl, false)
    licm_fill_bool($&w.inv, nt, false)
    for bi in 0:nb {
        if !w.reach[bi] {
            ->
        }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                w.def_cnt[ins.a] = w.def_cnt[ins.a] + 1
                w.def_blk[ins.a] = bi
                w.def_ii[ins.a] = ii
            }
            if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                w.loc_addr_taken[ins.b] = true
            }
            ii = ins.next
        }
    }

    for li in 0:loops.len {
        lp := &loops[li]
        if lp.blocks.len != 1 && lp.blocks.len != 2 {
            ->
        }
        is_one_blk := lp.blocks.len == 1
        h := lp.header
        if h <= 0 || h >= nb || !w.reach[h] {
            ->
        }
        $body := h
        if !is_one_blk {
            body = lp.blocks[0]
            if body == h {
                body = lp.blocks[1]
            }
            if body <= 0 || body >= nb || body == h || !w.reach[body] {
                ->
            }
            if f.blocks[body].tkind != TKIND_JUMP || f.blocks[body].ta != h {
                ->
            }
        }
        if f.blocks[h].tkind != TKIND_BRANCH {
            ->
        }
        htb := f.blocks[h].tb
        htc := f.blocks[h].tc
        if htb == htc {
            ->
        }
        $cond_flip := false
        $exit_b := -1
        if htb == body {
            exit_b = htc
        } else if htc == body {
            cond_flip = true
            exit_b = htb
        } else {
            ->
        }
        if exit_b < 0 || exit_b >= nb || exit_b == h || (exit_b < lp.body.len && lp.body[exit_b]) {
            ->
        }
        // Require exactly one outside predecessor pre -> h.
        $pre := -1
        $n_out_pred := 0
        for p in 0:nb {
            if !w.reach[p] || (p < lp.body.len && lp.body[p]) {
                ->
            }
            ptk := f.blocks[p].tkind
            if ptk == TKIND_JUMP && f.blocks[p].ta == h {
                pre = p
                n_out_pred += 1
            } else if ptk == TKIND_BRANCH && (f.blocks[p].tb == h || f.blocks[p].tc == h) {
                if f.blocks[p].tb == f.blocks[p].tc {
                    n_out_pred += 2
                } else {
                    pre = p
                    n_out_pred += 1
                }
            }
        }
        if n_out_pred != 1 || pre < 0 {
            ->
        }
        $t_iv := -1
        $l_iv := -1
        $h_iv_ii := -1
        $h_cmp_ii := -1
        $post_iv_ld_ii := -1
        $t_cmp := -1
        if !is_one_blk {
            // Header must have only: t_iv = load l_iv+0 ; t_cmp = lt/le/gt/ge ...
            $h_bad := false
            $hii := f.blocks[h].head
            while hii >= 0 {
                hins := ~f.instrs[hii]
                hk := hins.kind
                if hk == MI_NOP {
                    hii = hins.next
                    ->
                }
                if h_iv_ii < 0 && hk == MI_LOAD_LOCAL && hins.c == 0 {
                    h_iv_ii = hii
                } else if h_iv_ii >= 0 && h_cmp_ii < 0 && hk == MI_BIN {
                    h_cmp_ii = hii
                } else {
                    h_bad = true
                    <-
                }
                hii = hins.next
            }
            if h_bad || h_iv_ii < 0 || h_cmp_ii < 0 {
                ->
            }
            t_iv = f.instrs[h_iv_ii].a
            l_iv = f.instrs[h_iv_ii].b
            t_cmp = f.instrs[h_cmp_ii].a
        } else {
            // Bottom-tested 1-block loop: trailing MI_BIN defines h.ta after optional MI_LOAD_LOCAL l_iv.
            $last_ii := -1
            $prev_ii := -1
            $sii := f.blocks[h].head
            while sii >= 0 {
                if f.instrs[sii].kind != MI_NOP {
                    prev_ii = last_ii
                    last_ii = sii
                }
                sii = f.instrs[sii].next
            }
            if last_ii < 0 || f.instrs[last_ii].kind != MI_BIN || f.instrs[last_ii].a != f.blocks[h].ta {
                ->
            }
            h_cmp_ii = last_ii
            t_cmp = f.instrs[h_cmp_ii].a
            if prev_ii >= 0 && f.instrs[prev_ii].kind == MI_LOAD_LOCAL && f.instrs[prev_ii].c == 0 &&
               (f.instrs[h_cmp_ii].c == f.instrs[prev_ii].a || f.instrs[h_cmp_ii].d == f.instrs[prev_ii].a) {
                $st_before := -1
                $scan := f.blocks[h].head
                while scan >= 0 && scan != prev_ii {
                    if f.instrs[scan].kind == MI_STORE_LOCAL && f.instrs[scan].a == f.instrs[prev_ii].b {
                        st_before = scan
                    }
                    scan = f.instrs[scan].next
                }
                if st_before >= 0 && f.instrs[st_before].next == prev_ii {
                    post_iv_ld_ii = prev_ii
                    t_iv = f.instrs[prev_ii].a
                    l_iv = f.instrs[prev_ii].b
                }
            }
            if l_iv < 0 {
                // Step-temp direct compare: find MI_STORE_LOCAL whose stored temp is compared in h_cmp_ii.
                $scan := f.blocks[h].head
                while scan >= 0 {
                    if f.instrs[scan].kind == MI_STORE_LOCAL && f.instrs[scan].c == 0 &&
                       (f.instrs[scan].b == f.instrs[h_cmp_ii].c || f.instrs[scan].b == f.instrs[h_cmp_ii].d) {
                        l_iv = f.instrs[scan].a
                        t_iv = f.instrs[scan].b
                        <-
                    }
                    scan = f.instrs[scan].next
                }
            }
            if l_iv < 0 {
                ->
            }
        }
        cmp_op := f.instrs[h_cmp_ii].b
        if t_iv < 0 || t_iv >= nt || t_cmp < 0 || t_cmp >= nt || f.blocks[h].ta != t_cmp {
            ->
        }
        if l_iv < 0 || l_iv >= nl || w.loc_addr_taken[l_iv] || f.locals_nslots[l_iv] != 1 {
            ->
        }
        if w.def_cnt[t_iv] != 1 || w.def_cnt[t_cmp] != 1 {
            ->
        }
        if cmp_op != BIN_LT && cmp_op != BIN_LE && cmp_op != BIN_GT && cmp_op != BIN_GE {
            ->
        }
        cmp_lhs := f.instrs[h_cmp_ii].c
        cmp_rhs := f.instrs[h_cmp_ii].d
        $lhs_is_iv := false
        $bound_v := -1
        if cmp_lhs == t_iv && cmp_rhs != t_iv {
            lhs_is_iv = true
            bound_v = cmp_rhs
        } else if cmp_rhs == t_iv && cmp_lhs != t_iv {
            lhs_is_iv = false
            bound_v = cmp_lhs
        } else {
            ->
        }
        // Only upper-bounded +1 iteration prevents signed int64 wrap on l_iv += 1.
        upper_bounded := (!cond_flip && ((lhs_is_iv && cmp_op == BIN_LT) || (!lhs_is_iv && cmp_op == BIN_GT))) ||
                         (cond_flip && ((lhs_is_iv && cmp_op == BIN_GE) || (!lhs_is_iv && cmp_op == BIN_LE)))
        if !upper_bounded {
            ->
        }
        licm_fill_int($&w.dom_cache, nb, -1)
        if !licm_is_inv(f, w, lp, bound_v) {
            ->
        }
        // Check t_iv and t_cmp are not used outside loop blocks.
        $ext_used := false
        for obi in 0:nb {
            if !w.reach[obi] || obi == h || obi == body {
                ->
            }
            $oii := f.blocks[obi].head
            while oii >= 0 {
                oi_ins := ~f.instrs[oii]
                if lc_temp_used_in_instr(f, &oi_ins, t_iv, t_cmp) {
                    ext_used = true
                    <-
                }
                oii = f.instrs[oii].next
            }
            if ext_used {
                <-
            }
            otk := f.blocks[obi].tkind
            if (otk == TKIND_BRANCH || otk == TKIND_RETURN) && (f.blocks[obi].ta == t_iv || f.blocks[obi].ta == t_cmp) {
                ext_used = true
                <-
            }
        }
        if ext_used {
            ->
        }
        // Find initialization of l_iv in pre (valid at end of pre).
        $iv0 := -1
        $init_seen := false
        $pii := f.blocks[pre].head
        while pii >= 0 {
            pins := ~f.instrs[pii]
            if pins.kind == MI_STORE_LOCAL && pins.a == l_iv {
                if pins.c == 0 {
                    iv0 = pins.b
                    init_seen = true
                } else {
                    init_seen = false
                }
            }
            pii = pins.next
        }
        if !init_seen {
            ->
        }
        $iv0_ok := false
        if iv0 <= -2 {
            cidx := 0 - iv0 - 2
            iv0_ok = cidx >= 0 && cidx < f.consts.len
        } else if iv0 >= 0 && iv0 < nt && w.def_cnt[iv0] == 1 {
            db := w.def_blk[iv0]
            iv0_ok = db == pre || (db >= 0 && db < lp.body.len && !lp.body[db] && licm_dom(f, db, h, w))
        }
        if !iv0_ok {
            ->
        }

        // Validate body: no calls, no addr/drop, single MI_STORE_PTR (width 8), +1 IV step,
        // no l_iv reload after the IV step store (except post_iv_ld_ii for 1-block bottom compare).
        $b_bad := false
        $store_w_ii := -1
        $iv_step_seen := false
        $n_stores := 0
        $iv_temps := []int{}
        if !is_one_blk {
            iv_temps.push(t_iv)
        }
        $bii := f.blocks[body].head
        while bii >= 0 {
            bins := ~f.instrs[bii]
            bk := bins.kind
            if !fold_known_kind(bk) || bk == MI_CALL || bk == MI_CALL_IND || bk == MI_ADDR || bk == MI_DROP {
                b_bad = true
                <-
            }
            if is_one_blk && (bii == h_cmp_ii || bii == post_iv_ld_ii) {
                bii = bins.next
                ->
            }
            if is_one_blk && iv_step_seen && bk != MI_NOP {
                b_bad = true
                <-
            }
            if bk == MI_BIN && !licm_is_safe_bin(f, bins.b, bins.d) {
                b_bad = true
                <-
            }
            if bk == MI_LOAD_LOCAL && bins.b == l_iv {
                if iv_step_seen || bins.c != 0 || bins.a < 0 || bins.a >= nt || w.def_cnt[bins.a] != 1 {
                    b_bad = true
                    <-
                }
                iv_temps.push(bins.a)
            }
            if bk == MI_STORE_LOCAL && bins.a == l_iv {
                if bins.c != 0 || iv_step_seen || (is_one_blk && store_w_ii < 0) {
                    b_bad = true
                    <-
                }
                nv := bins.b
                if nv < 0 || nv >= nt || w.def_cnt[nv] != 1 || w.def_blk[nv] != body {
                    b_bad = true
                    <-
                }
                n_ii := w.def_ii[nv]
                nins := &f.instrs[n_ii]
                if nins.kind != MI_BIN || nins.b != BIN_ADD {
                    b_bad = true
                    <-
                }
                $step_ok := false
                if lc_is_iv_temp(&iv_temps, nins.c) && nins.d <= -2 && f.consts[0 - nins.d - 2] == 1 {
                    step_ok = true
                } else if lc_is_iv_temp(&iv_temps, nins.d) && nins.c <= -2 && f.consts[0 - nins.c - 2] == 1 {
                    step_ok = true
                }
                if !step_ok {
                    b_bad = true
                    <-
                }
                iv_step_seen = true
            } else if bk == MI_STORE_PTR {
                if is_one_blk && iv_step_seen {
                    b_bad = true
                    <-
                }
                n_stores += 1
                if n_stores > 1 || bins.d != 8 {
                    b_bad = true
                    <-
                }
                store_w_ii = bii
            }
            bii = bins.next
        }
        if b_bad || !iv_step_seen || n_stores != 1 || store_w_ii < 0 || iv_temps.len == 0 {
            ->
        }
        store_val := f.instrs[store_w_ii].b
        $val_ok := false
        if store_val <= -2 {
            val_ok = (0 - store_val - 2) < f.consts.len
        } else if store_val >= 0 && store_val < nt && w.def_cnt[store_val] == 1 {
            val_ok = true
        }
        if !val_ok {
            ->
        }
        $base_w := -1
        $eoff_w_anchor := 0
        $ca_w := -1
        $cb_w := -1
        $ceoff_w := 0
        if !lc_match_addr8_ex(f, w, lp, f.instrs[store_w_ii].a, f.instrs[store_w_ii].c, &iv_temps, body, $&base_w, $&eoff_w_anchor, $&ca_w, $&cb_w, $&ceoff_w) {
            ->
        }
        // Collect matching MI_LOAD_PTR(same canonical base, ceoff_w - 1, width=8) appearing BEFORE store_w_ii.
        $carry_loads := []int{}
        $cii := f.blocks[body].head
        while cii >= 0 {
            if cii == store_w_ii {
                <-
            }
            cins := ~f.instrs[cii]
            if cins.kind == MI_LOAD_PTR && cins.d == 8 {
                $base_r := -1
                $aeoff_r := 0
                $ca_r := -1
                $cb_r := -1
                $ceoff_r := 0
                if lc_match_addr8_ex(f, w, lp, cins.b, cins.c, &iv_temps, body, $&base_r, $&aeoff_r, $&ca_r, $&cb_r, $&ceoff_r) {
                    if ca_r == ca_w && cb_r == cb_w && ceoff_r == ceoff_w - 1 {
                        carry_loads.push(cii)
                    }
                }
            }
            cii = cins.next
        }
        if carry_loads.len == 0 {
            ->
        }

        // Rewrite!
        hline := f.blocks[h].line
        $lc_ty := f.locals[l_iv]
        cl0 := carry_loads[0]
        if f.instrs[cl0].a >= 0 && f.instrs[cl0].a < f.temps.len {
            lc_ty = f.temps[f.instrs[cl0].a]
        }
        l_carry := lc_new_local(f, lc_ty, ".lc")
        bb_init := f.blocks.len
        $ib := mblock_new()
        ib.line = hline
        f.blocks.push(ib)

        $entry_target := bb_init
        if !is_one_blk {
            bb_guard := f.blocks.len
            $gb := mblock_new()
            gb.line = hline
            f.blocks.push(gb)
            entry_target = bb_guard

            // bb_guard: compare iv0 vs bound; enter bb_init iff header branch enters body.
            g_cmp := alloc_temp(f)
            $gci := minstr_new(MI_BIN)
            gci.a = g_cmp
            gci.b = cmp_op
            if lhs_is_iv {
                gci.c = iv0
                gci.d = cmp_rhs
            } else {
                gci.c = cmp_lhs
                gci.d = iv0
            }
            gci.line = hline
            gcii := f.instrs.len
            f.instrs.push(gci)
            mir_append_instr(f, bb_guard, gcii)
            f.blocks[bb_guard].tkind = TKIND_BRANCH
            f.blocks[bb_guard].ta = g_cmp
            if cond_flip {
                f.blocks[bb_guard].tb = exit_b
                f.blocks[bb_guard].tc = bb_init
            } else {
                f.blocks[bb_guard].tb = bb_init
                f.blocks[bb_guard].tc = exit_b
            }
        }

        // Redirect pre -> entry_target (bb_guard for 2-block, bb_init for 1-block).
        if f.blocks[pre].tkind == TKIND_JUMP {
            f.blocks[pre].ta = entry_target
        } else {
            if f.blocks[pre].tb == h {
                f.blocks[pre].tb = entry_target
            }
            if f.blocks[pre].tc == h {
                f.blocks[pre].tc = entry_target
            }
        }

        // bb_init: carry0 = load8 [base_w + ((iv0 + eoff_w_anchor - 1) * 8)] ; store l_carry, carry0 ; jump h
        c_r := eoff_w_anchor - 1
        carry0 := alloc_temp(f)
        $init_off := 0
        $use_direct := false
        if iv0 <= -2 {
            cval := f.consts[0 - iv0 - 2]
            if cval >= -1000 && cval <= 4095 && c_r >= -1000 && c_r <= 4095 {
                bo := (cval + c_r) * 8
                if bo >= 0 && bo <= 32760 {
                    init_off = bo
                    use_direct = true
                }
            }
        }
        if use_direct {
            $li0 := minstr_new(MI_LOAD_PTR)
            li0.a = carry0
            li0.b = base_w
            li0.c = init_off
            li0.d = 8
            li0.line = hline
            li0i := f.instrs.len
            f.instrs.push(li0)
            mir_append_instr(f, bb_init, li0i)
        } else {
            $idx0 := iv0
            if c_r != 0 {
                idx0 = alloc_temp(f)
                $ai0 := minstr_new(MI_BIN)
                ai0.a = idx0
                ai0.b = BIN_ADD
                ai0.c = iv0
                ai0.d = alloc_const(f, c_r)
                ai0.line = hline
                ai0i := f.instrs.len
                f.instrs.push(ai0)
                mir_append_instr(f, bb_init, ai0i)
            }
            sh0 := alloc_temp(f)
            $si0 := minstr_new(MI_BIN)
            si0.a = sh0
            si0.b = BIN_SHL
            si0.c = idx0
            si0.d = alloc_const(f, 3)
            si0.line = hline
            si0i := f.instrs.len
            f.instrs.push(si0)
            mir_append_instr(f, bb_init, si0i)
            ptr0 := alloc_temp(f)
            $pi0 := minstr_new(MI_BIN)
            pi0.a = ptr0
            pi0.b = BIN_ADD
            pi0.c = base_w
            pi0.d = sh0
            pi0.line = hline
            pi0i := f.instrs.len
            f.instrs.push(pi0)
            mir_append_instr(f, bb_init, pi0i)
            $li0 := minstr_new(MI_LOAD_PTR)
            li0.a = carry0
            li0.b = ptr0
            li0.c = 0
            li0.d = 8
            li0.line = hline
            li0i := f.instrs.len
            f.instrs.push(li0)
            mir_append_instr(f, bb_init, li0i)
        }
        $sti := minstr_new(MI_STORE_LOCAL)
        sti.a = l_carry
        sti.b = carry0
        sti.c = 0
        sti.line = hline
        stii := f.instrs.len
        f.instrs.push(sti)
        mir_append_instr(f, bb_init, stii)
        f.blocks[bb_init].tkind = TKIND_JUMP
        f.blocks[bb_init].ta = h

        // Replace matching carry_loads in body with MI_LOAD_LOCAL l_carry.
        for ci in 0:carry_loads.len {
            rii := carry_loads[ci]
            f.instrs[rii].kind = MI_LOAD_LOCAL
            f.instrs[rii].b = l_carry
            f.instrs[rii].c = 0
            f.instrs[rii].d = 0
        }

        // Insert MI_STORE_LOCAL l_carry, store_val immediately after store_w_ii.
        ni := f.instrs.len
        $up := minstr_new(MI_STORE_LOCAL)
        up.a = l_carry
        up.b = store_val
        up.c = 0
        up.line = f.instrs[store_w_ii].line
        nx := f.instrs[store_w_ii].next
        up.next = nx
        f.instrs.push(up)
        f.instrs[store_w_ii].next = ni
        if nx < 0 {
            f.blocks[body].tail = ni
        }
        << true
    }
    << false
}

// Post-unroll / post-ptr_sr pointer-IV loop-carried load forwarding:
// for a 1-block loop entered unconditionally from pre, if pointer IV l_p steps by +step_bytes > 0
// and body writes [t_p + off_w] (d=8) and reads [t_p + (off_w - step_bytes)] before any alias write,
// carry [t_p + off_w] in a typed register-allocated local .lc across the backedge.
fn lc_try_piv_once(f $&MFn, w $&LicmWork) bool {
    loops := find_loops(f, false)
    if loops.len == 0 { << false }
    nb := f.blocks.len
    nt := f.temps.len
    nl := f.locals.len
    licm_mark_reach(f, w)
    licm_fill_int($&w.def_cnt, nt, 0)
    licm_fill_int($&w.def_blk, nt, -1)
    licm_fill_int($&w.def_ii, nt, -1)
    licm_fill_bool($&w.loc_addr_taken, nl, false)
    for bi in 0:nb {
        if !w.reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                w.def_cnt[ins.a] = w.def_cnt[ins.a] + 1
                w.def_blk[ins.a] = bi
                w.def_ii[ins.a] = ii
            }
            if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                w.loc_addr_taken[ins.b] = true
            }
            ii = ins.next
        }
    }
    for li in 0:loops.len {
        lp := &loops[li]
        if lp.blocks.len != 1 { -> }
        h := lp.header
        if h <= 0 || h >= nb || !w.reach[h] { -> }
        $pre := -1
        $n_out := 0
        for p in 0:nb {
            if !w.reach[p] || p == h { -> }
            ptk := f.blocks[p].tkind
            if ptk == TKIND_JUMP && f.blocks[p].ta == h {
                pre = p
                n_out += 1
            } else if ptk == TKIND_BRANCH && (f.blocks[p].tb == h || f.blocks[p].tc == h) {
                n_out += 2
            }
        }
        if n_out != 1 || pre < 0 { -> }
        // Require no calls/addr/volatile in h, and identify candidate stepping locals l_p.
        $bad := false
        $step_locals := []int{}
        $step_bytes := []int{}
        $step_tp := []int{}
        $step_ld_ii := []int{}
        $step_st_ii := []int{}
        $stores_ptr := []int{}
        $hi := f.blocks[h].head
        $pos := 0
        while hi >= 0 {
            hins := &f.instrs[hi]
            hk := hins.kind
            if !fold_known_kind(hk) || hk == MI_CALL || hk == MI_CALL_IND || hk == MI_ADDR || hk == MI_DROP {
                bad = true
                <-
            }
            if hk == MI_STORE_PTR {
                stores_ptr.push(hi)
            }
            if hk == MI_STORE_LOCAL && hins.c == 0 && hins.a >= 0 && hins.a < nl &&
               !w.loc_addr_taken[hins.a] && f.locals_nslots[hins.a] == 1 {
                lp_id := hins.a
                nv := hins.b
                if nv >= 0 && nv < nt && w.def_cnt[nv] == 1 && w.def_blk[nv] == h {
                    nv_ii := w.def_ii[nv]
                    nins := &f.instrs[nv_ii]
                    if nins.kind == MI_BIN && nins.b == BIN_ADD {
                        $tp := -1
                        $sb := 0
                        if nins.c >= 0 && nins.d <= -2 && (0 - nins.d - 2) < f.consts.len {
                            tp = nins.c
                            sb = f.consts[0 - nins.d - 2]
                        } else if nins.d >= 0 && nins.c <= -2 && (0 - nins.c - 2) < f.consts.len {
                            tp = nins.d
                            sb = f.consts[0 - nins.c - 2]
                        }
                        if sb > 0 && sb <= 256 && (sb & 7) == 0 && tp >= 0 && tp < nt &&
                           w.def_cnt[tp] == 1 && w.def_blk[tp] == h {
                            tp_ii := w.def_ii[tp]
                            tins := &f.instrs[tp_ii]
                            if tins.kind == MI_LOAD_LOCAL && tins.b == lp_id && tins.c == 0 {
                                // Ensure no other load/store on lp_id in h.
                                $only_one := true
                                $si := f.blocks[h].head
                                while si >= 0 {
                                    sins := &f.instrs[si]
                                    if si != hi && si != tp_ii {
                                        if (sins.kind == MI_LOAD_LOCAL && sins.b == lp_id) ||
                                           (sins.kind == MI_STORE_LOCAL && sins.a == lp_id) {
                                            only_one = false
                                            <-
                                        }
                                    }
                                    si = sins.next
                                }
                                if only_one {
                                    step_locals.push(lp_id)
                                    step_bytes.push(sb)
                                    step_tp.push(tp)
                                    step_ld_ii.push(w.def_ii[tp])
                                    step_st_ii.push(hi)
                                }
                            }
                        }
                    }
                }
            }
            pos += 1
            hi = hins.next
        }
        if bad || stores_ptr.len == 0 || step_locals.len == 0 { -> }
        // Build instr index -> order map in h.
        $ord := []int{}
        for _ in 0:f.instrs.len { ord.push(-1) }
        $oi := 0
        $hi2 := f.blocks[h].head
        while hi2 >= 0 {
            ord[hi2] = oi
            oi += 1
            hi2 = f.instrs[hi2].next
        }
        // Try each stepping pointer local whose preheader initializes it with a valid live p0.
        for si in 0:step_locals.len {
            lp_id := step_locals[si]
            sb := step_bytes[si]
            tp := step_tp[si]
            ld_ii := step_ld_ii[si]
            st_ii := step_st_ii[si]
            if ord[st_ii] <= ord[ld_ii] { -> }
            // Check ALL MI_STORE_PTR in h use base tp (no unknown-base store aliasing tp).
            $all_tp_stores := true
            for spi in 0:stores_ptr.len {
                spii := stores_ptr[spi]
                if f.instrs[spii].a != tp {
                    all_tp_stores = false
                    <-
                }
            }
            if !all_tp_stores { -> }
            // Find p0 at end of pre.
            $p0 := -1
            $p0_ok := false
            $p0_st_ii := -1
            $pii := f.blocks[pre].head
            while pii >= 0 {
                pins := &f.instrs[pii]
                if pins.kind == MI_STORE_LOCAL && pins.a == lp_id {
                    if pins.c == 0 && pins.b >= 0 && pins.b < nt {
                        p0 = pins.b
                        p0_ok = true
                        p0_st_ii = pii
                    } else {
                        p0_ok = false
                    }
                }
                pii = pins.next
            }
            if !p0_ok || p0 < 0 || p0_st_ii < 0 { -> }
            // Verify p0 is not redefined between p0_st_ii and end of pre.
            $chk := f.instrs[p0_st_ii].next
            while chk >= 0 {
                cins := &f.instrs[chk]
                if fold_defines(cins.kind) && cins.a == p0 {
                    p0_ok = false
                    <-
                }
                chk = cins.next
            }
            if !p0_ok { -> }
            // Look for a store_w_ii on [tp + off_w] (width 8, before st_ii) paired with
            // carry_loads [tp + (off_w - sb)] before store_w_ii.
            for spi in 0:stores_ptr.len {
                w_ii := stores_ptr[spi]
                if ord[w_ii] >= ord[st_ii] { -> }
                wins := &f.instrs[w_ii]
                if wins.d != 8 { -> }
                off_w := wins.c
                off_r := off_w - sb
                if off_r < 0 || off_r > 32760 { -> }
                sv := wins.b
                if sv >= 0 && (sv >= nt || w.def_cnt[sv] != 1) { -> }
                if sv <= -2 && (0 - sv - 2) >= f.consts.len { -> }
                // Every OTHER store in h (all are on base tp) must be disjoint from [off_w, off_w+8) and [off_r, off_r+8).
                $disjoint_ok := true
                for sj in 0:stores_ptr.len {
                    if sj == spi { -> }
                    oii := stores_ptr[sj]
                    oins := &f.instrs[oii]
                    mw := licm_wbytes(oins.d)
                    if mw <= 0 || !licm_ranges_disjoint(oins.c, mw, off_w, 8) || !licm_ranges_disjoint(oins.c, mw, off_r, 8) {
                        disjoint_ok = false
                        <-
                    }
                }
                if !disjoint_ok { -> }
                // Collect carry_loads [tp + off_r], width 8 strictly after ld_ii and before w_ii.
                $carry_loads := []int{}
                $li2 := f.instrs[ld_ii].next
                while li2 >= 0 && li2 != w_ii {
                    lins := &f.instrs[li2]
                    if lins.kind == MI_LOAD_PTR && lins.b == tp && lins.c == off_r && lins.d == 8 && lins.a >= 0 && lins.a < nt {
                        carry_loads.push(li2)
                    }
                    li2 = lins.next
                }
                if carry_loads.len == 0 { -> }
                cl0 := carry_loads[0]
                $lc_ty := f.temps[f.instrs[cl0].a]
                if sv >= 0 && f.temps[sv] == 2 {
                    lc_ty = 2
                }
                // Rewrite!
                hline := f.blocks[h].line
                l_carry := lc_new_local(f, lc_ty, ".lc")
                carry0 := alloc_temp(f)
                f.temps[carry0] = lc_ty
                $li0 := minstr_new(MI_LOAD_PTR)
                li0.a = carry0
                li0.b = p0
                li0.c = off_r
                li0.d = 8
                li0.line = hline
                li0i := f.instrs.len
                f.instrs.push(li0)
                mir_append_instr(f, pre, li0i)
                $sti := minstr_new(MI_STORE_LOCAL)
                sti.a = l_carry
                sti.b = carry0
                sti.c = 0
                sti.line = hline
                stii := f.instrs.len
                f.instrs.push(sti)
                mir_append_instr(f, pre, stii)
                for ci in 0:carry_loads.len {
                    rii := carry_loads[ci]
                    f.instrs[rii].kind = MI_LOAD_LOCAL
                    f.instrs[rii].b = l_carry
                    f.instrs[rii].c = 0
                    f.instrs[rii].d = 0
                }
                ni := f.instrs.len
                $up := minstr_new(MI_STORE_LOCAL)
                up.a = l_carry
                up.b = sv
                up.c = 0
                up.line = f.instrs[w_ii].line
                nx := f.instrs[w_ii].next
                up.next = nx
                f.instrs.push(up)
                f.instrs[w_ii].next = ni
                if nx < 0 {
                    f.blocks[h].tail = ni
                }
                << true
            }
        }
    }
    << false
}

pub fn opt_loop_carry_with(f $&MFn, w $&LicmWork) bool {
    $has_st := false
    $has_ld := false
    for i in 0:f.instrs.len {
        k := f.instrs[i].kind
        if k == MI_STORE_PTR && f.instrs[i].d == 8 {
            has_st = true
        } else if k == MI_LOAD_PTR && f.instrs[i].d == 8 {
            has_ld = true
        }
        if has_st && has_ld {
            <-
        }
    }
    if !has_st || !has_ld {
        << false
    }
    $changed := false
    for _ in 0:8 {
        if !lc_try_once(f, w) && !lc_try_piv_once(f, w) {
            <-
        }
        changed = true
    }
    << changed
}

// ===== Cooper & Lu (PLDI 1997) Loop Invariant-Address Register Promotion =====

struct LpPromCand {
    ckind int
    cid int
    coff int
    base_t int
    emit_off int
    c_scope int
    prom_ty int
    match_loads []int
    match_stores []int
}

fn lp_is_pure_panic_blk(f &MFn, b int) bool {
    if b < 0 || b >= f.blocks.len { << false }
    $ii := f.blocks[b].head
    while ii >= 0 {
        ins := &f.instrs[ii]
        k := ins.kind
        if k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_CALL_IND ||
           k == MI_VOLATILE_LOAD || k == MI_VOLATILE_STORE || k == MI_ASM {
            << false
        }
        if k == MI_CALL {
            << ins.sval == "_xu_runtime_core_rt_panic" ||
               ins.sval == "_xu_runtime_core_index_panic" ||
               ins.sval == "_xu_runtime_core_exit_process" ||
               ins.sval == "_xu_runtime_core_intrin_assert_fail" ||
               ins.sval == "_xu_runtime_core_intrin_fatal" ||
               ins.sval == "_xu_runtime_core_fatal_no_memory"
        }
        ii = ins.next
    }
    << false
}

fn lp_mem_disjoint(w &LicmWork, c_ptr int, c_off int, c_scope int, c_is_shdr bool, m_ptr int, m_off int, m_w int, m_scope int) bool {
    mw := licm_wbytes(m_w)
    if mw <= 0 { << false }
    if licm_same_base_disjoint(w, c_ptr, c_off, 8, m_ptr, m_off, mw, true) {
        << true
    }
    if c_scope > 0 && m_scope > 0 && c_scope != m_scope {
        << true
    }
    if c_scope > 0 && m_ptr >= 0 && m_ptr < w.buf_scope.len && w.buf_scope[m_ptr] > 0 {
        if w.buf_scope[m_ptr] != c_scope || c_is_shdr {
            << true
        }
    }
    if c_ptr >= 0 && c_ptr < w.buf_scope.len && w.buf_scope[c_ptr] > 0 {
        if m_scope > 0 && w.buf_scope[c_ptr] != m_scope {
            << true
        }
        if m_ptr >= 0 && m_ptr < w.buf_scope.len && w.buf_scope[m_ptr] > 0 && w.buf_scope[c_ptr] != w.buf_scope[m_ptr] {
            << true
        }
    }
    if c_ptr >= 0 && c_ptr < w.addr_exact.len && w.addr_exact[c_ptr] {
        lc := w.addr_root[c_ptr]
        oc := w.addr_off[c_ptr] + c_off
        if m_ptr >= 0 && m_ptr < w.addr_exact.len && w.addr_exact[m_ptr] {
            if w.addr_root[m_ptr] != lc {
                << true
            }
            if m_off >= 0 && licm_ranges_disjoint(oc, 8, w.addr_off[m_ptr] + m_off, mw) {
                << true
            }
        } else if lc >= 0 && lc < w.loc_escaped.len && !w.loc_escaped[lc] {
            if m_ptr < 0 || m_ptr >= w.maybe_loc.len || w.maybe_loc[m_ptr] != lc {
                << true
            }
        }
    }
    if m_ptr >= 0 && m_ptr < w.addr_exact.len && w.addr_exact[m_ptr] {
        lm := w.addr_root[m_ptr]
        if lm >= 0 && lm < w.loc_escaped.len && !w.loc_escaped[lm] {
            if c_ptr < 0 || c_ptr >= w.maybe_loc.len || w.maybe_loc[c_ptr] != lm {
                << true
            }
        }
    }
    << false
}

fn lp_key_of(w &LicmWork, ptr int, off int, out_k $&int, out_id $&int, out_off $&int) bool {
    if ptr < 0 || ptr >= w.desc_root.len || off < 0 || off >= 4096 {
        << false
    }
    dr := w.desc_root[ptr]
    if dr >= 0 {
        doff := w.desc_off[ptr]
        if doff < 0 || doff >= 1048576 {
            << false
        }
        *out_k = 1
        *out_id = dr
        *out_off = doff + off
        << true
    }
    if ptr < w.canon_base.len && w.canon_base[ptr] >= 0 {
        co := w.canon_off[ptr] + off
        if co >= 0 && co < 1048576 {
            *out_k = 2
            *out_id = w.canon_base[ptr]
            *out_off = co
            << true
        }
    }
    *out_k = 2
    *out_id = ptr
    *out_off = off
    << true
}

fn lp_header_has_uncond(f &MFn, h int, target_ii int) bool {
    $cur := f.blocks[h].head
    while cur >= 0 {
        if cur == target_ii {
            << true
        }
        cins := &f.instrs[cur]
        ck := cins.kind
        if ck == MI_CALL || ck == MI_CALL_IND || ck == MI_VOLATILE_LOAD || ck == MI_VOLATILE_STORE || ck == MI_ASM {
            <-
        }
        if ck == MI_BIN && !licm_is_safe_bin(f, cins.b, cins.d) {
            <-
        }
        cur = cins.next
    }
    << false
}

fn lp_promote_once(f $&MFn, w $&LicmWork) bool {
    nb := f.blocks.len
    nt := f.temps.len
    nl := f.locals.len
    if nb < 2 || nt == 0 {
        << false
    }
    $loops := find_loops(f, false)
    if loops.len == 0 {
        << false
    }
    licm_mark_reach(f, w)
    $sdesc_roots := []int{}
    $sdesc_offs := []int{}
    $any_unk := false
    $fresh_scope_base := 10000
    licm_build_alias_info(f, w, $&sdesc_roots, $&sdesc_offs, $&any_unk, $&fresh_scope_base)
    if any_unk {
        << false
    }

    // Order inner-to-outer (smallest block count first).
    $order := []int{}
    for i in 0:loops.len {
        order.push(i)
    }
    for i in 1:order.len {
        key := order[i]
        klen := loops[key].blocks.len
        $j := i - 1
        while j >= 0 && loops[order[j]].blocks.len > klen {
            order[j + 1] = order[j]
            j -= 1
        }
        order[j + 1] = key
    }

    for oi in 0:order.len {
        lidx := order[oi]
        lp := &loops[lidx]
        h := lp.header
        if h <= 0 || h >= nb || !w.reach[h] {
            ->
        }
        $bad_lp := false
        $lp_stores := []int{}
        $lp_loads := []int{}
        $lp_loc_touched := []bool{}
        for _ in 0:nl {
            lp_loc_touched.push(false)
        }
        for bi_i in 0:lp.blocks.len {
            b := lp.blocks[bi_i]
            if b < 0 || b >= nb || (b < w.blk_unk.len && w.blk_unk[b]) {
                bad_lp = true
                <-
            }
            tk := f.blocks[b].tkind
            if tk != TKIND_JUMP && tk != TKIND_BRANCH {
                bad_lp = true
                <-
            }
            $ii := f.blocks[b].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                if k == MI_CALL_IND || (k == MI_CALL && !is_panic_call(ins)) ||
                   k == MI_VOLATILE_LOAD || k == MI_VOLATILE_STORE || k == MI_ASM {
                    bad_lp = true
                    <-
                }
                if k == MI_STORE_PTR {
                    lp_stores.push(ii)
                } else if k == MI_LOAD_PTR {
                    lp_loads.push(ii)
                } else if k == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl {
                    lp_loc_touched[ins.b] = true
                } else if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                    lp_loc_touched[ins.a] = true
                }
                ii = ins.next
            }
            if bad_lp { <- }
        }
        if bad_lp || lp_stores.len == 0 {
            ->
        }
        // Single-entry naturalness + external predecessors of header.
        $irreducible := false
        $ext_preds := []int{}
        for p in 0:nb {
            if !w.reach[p] || (p < lp.body.len && lp.body[p]) {
                ->
            }
            tk := f.blocks[p].tkind
            if tk == TKIND_JUMP {
                s := f.blocks[p].ta
                if s == h {
                    ext_preds.push(p)
                } else if s >= 0 && s < lp.body.len && lp.body[s] {
                    irreducible = true
                    <-
                }
            } else if tk == TKIND_BRANCH {
                sb := f.blocks[p].tb
                sc := f.blocks[p].tc
                if sb == h || sc == h {
                    ext_preds.push(p)
                }
                if (sb != h && sb >= 0 && sb < lp.body.len && lp.body[sb]) ||
                   (sc != h && sc >= 0 && sc < lp.body.len && lp.body[sc]) {
                    irreducible = true
                    <-
                }
            }
        }
        if irreducible || ext_preds.len == 0 {
            ->
        }

        // Collect all non-panic exit target blocks outside lp.
        $exit_targets := []int{}
        for bi_i in 0:lp.blocks.len {
            b := lp.blocks[bi_i]
            tk := f.blocks[b].tkind
            if tk == TKIND_JUMP {
                ex := f.blocks[b].ta
                if ex >= 0 && ex < nb && (ex >= lp.body.len || !lp.body[ex]) && !lp_is_pure_panic_blk(f, ex) {
                    $seen_ex := false
                    for ei in 0:exit_targets.len {
                        if exit_targets[ei] == ex {
                            seen_ex = true
                            <-
                        }
                    }
                    if !seen_ex { exit_targets.push(ex) }
                }
            } else if tk == TKIND_BRANCH {
                ex1 := f.blocks[b].tb
                if ex1 >= 0 && ex1 < nb && (ex1 >= lp.body.len || !lp.body[ex1]) && !lp_is_pure_panic_blk(f, ex1) {
                    $seen_ex := false
                    for ei in 0:exit_targets.len {
                        if exit_targets[ei] == ex1 {
                            seen_ex = true
                            <-
                        }
                    }
                    if !seen_ex { exit_targets.push(ex1) }
                }
                ex2 := f.blocks[b].tc
                if ex2 >= 0 && ex2 < nb && (ex2 >= lp.body.len || !lp.body[ex2]) && !lp_is_pure_panic_blk(f, ex2) {
                    $seen_ex := false
                    for ei in 0:exit_targets.len {
                        if exit_targets[ei] == ex2 {
                            seen_ex = true
                            <-
                        }
                    }
                    if !seen_ex { exit_targets.push(ex2) }
                }
            }
        }
        if exit_targets.len == 0 {
            ->
        }

        licm_fill_int($&w.dom_cache, nb, -1)
        licm_fill_bool($&w.inv, nt, false)
        $seen_k := []int{}
        $seen_id := []int{}
        $seen_off := []int{}
        $cands := []LpPromCand{}

        $max_cands := 8
        if lp.blocks.len <= 2 {
            max_cands = 16
        }
        for si in 0:lp_stores.len {
            if cands.len >= max_cands {
                <-
            }
            sii := lp_stores[si]
            sins := &f.instrs[sii]
            if sins.d != 8 || sins.c < 0 || sins.c >= 4096 {
                ->
            }
            base_t := sins.a
            if base_t < 0 || base_t >= nt || !licm_is_inv(f, w, lp, base_t) {
                ->
            }
            $ck := 0
            $cid := -1
            $coff := 0
            if !lp_key_of(w, base_t, sins.c, $&ck, $&cid, $&coff) {
                ->
            }
            $dup := false
            for ki in 0:seen_k.len {
                if seen_k[ki] == ck && seen_id[ki] == cid && seen_off[ki] == coff {
                    dup = true
                    <-
                }
            }
            if dup {
                ->
            }
            seen_k.push(ck)
            seen_id.push(cid)
            seen_off.push(coff)

            // Do not fight local-slot access via direct MI_LOAD_LOCAL/MI_STORE_LOCAL on same slot.
            if base_t < w.addr_exact.len && w.addr_exact[base_t] {
                ar := w.addr_root[base_t]
                if ar >= 0 && ar < nl && lp_loc_touched[ar] {
                    ->
                }
            }

            $c_is_shdr := false
            if base_t < w.desc_root.len && w.desc_root[base_t] >= 0 {
                hr := w.desc_root[base_t]
                ho := w.desc_off[base_t] + sins.c
                for sdi in 0:sdesc_roots.len {
                    if sdesc_roots[sdi] == hr {
                        sd_o := sdesc_offs[sdi]
                        if ho == sd_o || ho == sd_o + 8 || ho == sd_o + 16 {
                            c_is_shdr = true
                            <-
                        }
                    }
                }
            }
            c_scope := sins.scope_id
            $m_stores := []int{}
            $m_loads := []int{}
            $all_ok := true
            $scope_mismatch := false

            for si2 in 0:lp_stores.len {
                s2ii := lp_stores[si2]
                s2 := &f.instrs[s2ii]
                $sk2 := 0
                $sid2 := -1
                $soff2 := 0
                if s2.d == 8 && lp_key_of(w, s2.a, s2.c, $&sk2, $&sid2, $&soff2) &&
                   sk2 == ck && sid2 == cid && soff2 == coff {
                    if s2.scope_id > 0 && c_scope > 0 && s2.scope_id != c_scope {
                        scope_mismatch = true
                        all_ok = false
                        <-
                    }
                    m_stores.push(s2ii)
                } else if !lp_mem_disjoint(w, base_t, sins.c, c_scope, c_is_shdr, s2.a, s2.c, s2.d, s2.scope_id) {
                    all_ok = false
                    <-
                }
            }
            if !all_ok || scope_mismatch {
                ->
            }
            for li2 in 0:lp_loads.len {
                l2ii := lp_loads[li2]
                l2 := &f.instrs[l2ii]
                $lk2 := 0
                $lid2 := -1
                $loff2 := 0
                if l2.d == 8 && lp_key_of(w, l2.b, l2.c, $&lk2, $&lid2, $&loff2) &&
                   lk2 == ck && lid2 == cid && loff2 == coff {
                    if l2.scope_id > 0 && c_scope > 0 && l2.scope_id != c_scope {
                        scope_mismatch = true
                        all_ok = false
                        <-
                    }
                    m_loads.push(l2ii)
                } else if !lp_mem_disjoint(w, base_t, sins.c, c_scope, c_is_shdr, l2.b, l2.c, l2.d, l2.scope_id) {
                    all_ok = false
                    <-
                }
            }
            if !all_ok || scope_mismatch || m_stores.len == 0 {
                ->
            }
            if cands.len >= 4 && m_loads.len + m_stores.len < 2 {
                ->
            }

            // Trap-safety & writeback-safety check:
            // preheader load + exit writeback must be safe even if the loop runs 0 times.
            $safe := false
            if base_t < w.addr_exact.len && w.addr_exact[base_t] {
                lr := w.addr_root[base_t]
                tot := w.addr_off[base_t] + sins.c
                if lr >= 0 && lr < f.locals_nslots.len && tot >= 0 && tot + 8 <= f.locals_nslots[lr] * 8 {
                    safe = true
                }
            }
            if !safe && c_scope > 0 && (base_t >= w.buf_scope.len || w.buf_scope[base_t] == 0) {
                for mli in 0:m_loads.len {
                    if lp_header_has_uncond(f, h, m_loads[mli]) {
                        safe = true
                        <-
                    }
                }
                if !safe {
                    for msi in 0:m_stores.len {
                        if lp_header_has_uncond(f, h, m_stores[msi]) {
                            safe = true
                            <-
                        }
                    }
                }
                if !safe {
                    for db in 0:nb {
                        if !w.reach[db] || (db < lp.body.len && lp.body[db]) || !licm_dom(f, db, h, w) {
                            ->
                        }
                        $di := f.blocks[db].head
                        while di >= 0 {
                            dins := &f.instrs[di]
                            if dins.kind == MI_LOAD_PTR && dins.d == 8 {
                                $dk := 0
                                $did := -1
                                $doff := 0
                                if lp_key_of(w, dins.b, dins.c, $&dk, $&did, $&doff) && dk == ck && did == cid && doff == coff {
                                    safe = true
                                    <-
                                }
                            } else if dins.kind == MI_STORE_PTR && dins.d == 8 {
                                $dk := 0
                                $did := -1
                                $doff := 0
                                if lp_key_of(w, dins.a, dins.c, $&dk, $&did, $&doff) && dk == ck && did == cid && doff == coff {
                                    safe = true
                                    <-
                                }
                            }
                            di = dins.next
                        }
                        if safe { <- }
                    }
                }
            }
            if !safe {
                // Unconditional header stores guarantee writable memory on loop entry.
                for msi in 0:m_stores.len {
                    if lp_header_has_uncond(f, h, m_stores[msi]) {
                        safe = true
                        <-
                    }
                }
            }
            if !safe {
                // Non-scoped pointers are only promoted when a dominating non-loop store proves writable memory.
                for db in 0:nb {
                    if !w.reach[db] || (db < lp.body.len && lp.body[db]) || !licm_dom(f, db, h, w) {
                        ->
                    }
                    $di := f.blocks[db].head
                    while di >= 0 {
                        dins := &f.instrs[di]
                        if dins.kind == MI_STORE_PTR && dins.d == 8 {
                            $dk := 0
                            $did := -1
                            $doff := 0
                            if lp_key_of(w, dins.a, dins.c, $&dk, $&did, $&doff) && dk == ck && did == cid && doff == coff {
                                safe = true
                                <-
                            }
                        } else if dins.kind == MI_CALL && (dins.sval == "__xu_vec_fill64" || dins.sval == "__xu_vec_copy64") && dins.c >= 0 && dins.c < f.margs.len {
                            a0 := f.margs[dins.c].v
                            a0_nx := f.margs[dins.c].next
                            $cnt_v := -1
                            if a0_nx >= 0 && a0_nx < f.margs.len {
                                if dins.sval == "__xu_vec_fill64" {
                                    cnt_v = f.margs[a0_nx].v
                                } else {
                                    a2_nx := f.margs[a0_nx].next
                                    if a2_nx >= 0 && a2_nx < f.margs.len {
                                        cnt_v = f.margs[a2_nx].v
                                    }
                                }
                            }
                            if cnt_v <= -2 && (0 - cnt_v - 2) < f.consts.len {
                                cnt_w := f.consts[0 - cnt_v - 2]
                                if cnt_w > 0 && cnt_w <= 65536 {
                                    $ak := 0
                                    $aid := -1
                                    $aoff := 0
                                    if lp_key_of(w, a0, 0, $&ak, $&aid, $&aoff) && ak == ck && aid == cid &&
                                       coff >= aoff && coff + 8 <= aoff + cnt_w * 8 {
                                        safe = true
                                        <-
                                    }
                                }
                            }
                        }
                        di = dins.next
                    }
                    if safe { <- }
                }
            }
            if !safe {
                ->
            }

            $prom_ty := 1
            if m_loads.len > 0 {
                ld := f.instrs[m_loads[0]].a
                if ld >= 0 && ld < f.temps.len { prom_ty = f.temps[ld] }
            } else if sins.b >= 0 && sins.b < f.temps.len {
                prom_ty = f.temps[sins.b]
            }
            cands.push(LpPromCand{
                ckind: ck,
                cid: cid,
                coff: coff,
                base_t: base_t,
                emit_off: sins.c,
                c_scope: c_scope,
                prom_ty: prom_ty,
                match_loads: ~m_loads,
                match_stores: ~m_stores
            })
        }

        if cands.len == 0 {
            ->
        }

        // Create or reuse loop preheader ph.
        $ph := -1
        if ext_preds.len == 1 {
            ep := ext_preds[0]
            if f.blocks[ep].tkind == TKIND_JUMP && f.blocks[ep].ta == h {
                ph = ep
            }
        }
        hline := f.blocks[h].line
        if ph < 0 {
            ph = f.blocks.len
            $nb_blk := mblock_new()
            nb_blk.tkind = TKIND_JUMP
            nb_blk.ta = h
            nb_blk.line = hline
            f.blocks.push(nb_blk)
            for ei in 0:ext_preds.len {
                p := ext_preds[ei]
                if f.blocks[p].tkind == TKIND_JUMP && f.blocks[p].ta == h {
                    f.blocks[p].ta = ph
                } else if f.blocks[p].tkind == TKIND_BRANCH {
                    if f.blocks[p].tb == h { f.blocks[p].tb = ph }
                    if f.blocks[p].tc == h { f.blocks[p].tc = ph }
                }
            }
        }

        $prom_locs := []int{}
        for ci in 0:cands.len {
            cand := &cands[ci]
            l_prom := lc_new_local(f, cand.prom_ty, ".prom")
            prom_locs.push(l_prom)

            t_init := alloc_temp(f)
            f.temps[t_init] = cand.prom_ty
            $li0 := minstr_new(MI_LOAD_PTR)
            li0.a = t_init
            li0.b = cand.base_t
            li0.c = cand.emit_off
            li0.d = 8
            li0.scope_id = cand.c_scope
            li0.line = hline
            emit_to_bb(f, ph, li0)

            $si0 := minstr_new(MI_STORE_LOCAL)
            si0.a = l_prom
            si0.b = t_init
            si0.c = 0
            si0.line = hline
            emit_to_bb(f, ph, si0)

            for mli in 0:cand.match_loads.len {
                rii := cand.match_loads[mli]
                f.instrs[rii].kind = MI_LOAD_LOCAL
                f.instrs[rii].b = l_prom
                f.instrs[rii].c = 0
                f.instrs[rii].d = 0
                f.instrs[rii].sval = ""
                f.instrs[rii].scope_id = 0
            }
            for msi in 0:cand.match_stores.len {
                wii := cand.match_stores[msi]
                f.instrs[wii].kind = MI_STORE_LOCAL
                f.instrs[wii].a = l_prom
                f.instrs[wii].c = 0
                f.instrs[wii].d = 0
                f.instrs[wii].sval = ""
                f.instrs[wii].scope_id = 0
            }
        }

        // Emit writeback trampolines on all non-panic loop exit edges.
        for ei in 0:exit_targets.len {
            ex := exit_targets[ei]
            wb := f.blocks.len
            $wbb := mblock_new()
            wbb.tkind = TKIND_JUMP
            wbb.ta = ex
            wbb.line = hline
            f.blocks.push(wbb)
            for ci in 0:cands.len {
                cand := &cands[ci]
                t_wb := alloc_temp(f)
                f.temps[t_wb] = cand.prom_ty
                $lwi := minstr_new(MI_LOAD_LOCAL)
                lwi.a = t_wb
                lwi.b = prom_locs[ci]
                lwi.c = 0
                lwi.line = hline
                emit_to_bb(f, wb, lwi)

                $swi := minstr_new(MI_STORE_PTR)
                swi.a = cand.base_t
                swi.b = t_wb
                swi.c = cand.emit_off
                swi.d = 8
                swi.scope_id = cand.c_scope
                swi.line = hline
                emit_to_bb(f, wb, swi)
            }
            for bi_i in 0:lp.blocks.len {
                b := lp.blocks[bi_i]
                tk := f.blocks[b].tkind
                if tk == TKIND_JUMP && f.blocks[b].ta == ex {
                    f.blocks[b].ta = wb
                } else if tk == TKIND_BRANCH {
                    if f.blocks[b].tb == ex { f.blocks[b].tb = wb }
                    if f.blocks[b].tc == ex { f.blocks[b].tc = wb }
                }
            }
        }
        << true
    }
    << false
}

pub fn opt_loop_promote_with(f $&MFn, w $&LicmWork) bool {
    if f.blocks.len < 2 || f.temps.len == 0 {
        << false
    }
    $has_st8 := false
    for i in 0:f.instrs.len {
        if f.instrs[i].kind == MI_STORE_PTR && f.instrs[i].d == 8 {
            has_st8 = true
            <-
        }
    }
    if !has_st8 {
        << false
    }
    $changed := false
    for _ in 0:16 {
        if !lp_promote_once(f, w) {
            <-
        }
        changed = true
    }
    << changed
}

fn hc_is_panic_call(ins &MInstr) bool {
    << ins.kind == MI_CALL && (ins.sval == "_xu_runtime_core_rt_panic" ||
       ins.sval == "_xu_runtime_core_iface_tag_panic" ||
       ins.sval == "panic" || ins.sval == "rt_panic")
}

fn hc_imm_cost(cv int) int {
    if cv >= -65536 && cv <= 65535 { << 1 }
    if cv >= -4294967296 && cv <= 4294967295 { << 2 }
    << 4
}

fn hc_u64_shr(x int, k int) int {
    if k <= 0 { << x }
    if k >= 64 { << 0 }
    if k == 1 { << (x >> 1) & 9223372036854775807 }
    << (x >> k) & ((1 << (64 - k)) - 1)
}

fn hc_is_bitmask_imm(v int) bool {
    if v == 0 || v == -1 { << false }
    $sz := 64
    $p := v
    hi32 := hc_u64_shr(p, 32)
    lo32 := p & 4294967295
    if hi32 == lo32 {
        sz = 32
        p = lo32
        while sz > 2 {
            half := sz / 2
            mask := (1 << half) - 1
            if (p & mask) == ((p >> half) & mask) {
                sz = half
                p = p & mask
            } else {
                <-
            }
        }
    }
    $ones := 0
    if (p & 1) == 0 {
        $tz := 1
        while tz < sz && ((p >> tz) & 1) == 0 { tz += 1 }
        if tz >= sz { << false }
        q := hc_u64_shr(p, tz)
        if (q & (q + 1)) != 0 { << false }
        while (q >> ones) != 0 { ones += 1 }
    } else {
        $emask := -1
        if sz < 64 { emask = (1 << sz) - 1 }
        np := p ^ emask
        if np == 0 { << false }
        $tz := 1
        while tz < sz && ((np >> tz) & 1) == 0 { tz += 1 }
        if tz >= sz { << false }
        q := hc_u64_shr(np, tz)
        if (q & (q + 1)) != 0 { << false }
        $zeros := 0
        while (q >> zeros) != 0 { zeros += 1 }
        ones = sz - zeros
    }
    << ones >= 1 && ones < sz
}

fn hc_const_cost(ins &MInstr, op_pos int, cv int, arm64_mode bool) int {
    // Skip bounds checks and ops where small immediates already fold natively.
    if ins.kind != MI_BIN || ins.sval == "bounds" {
        << 0
    }
    op := ins.b
    if op == BIN_SHL || op == BIN_SHR || op == BIN_ROTR32 || op == BIN_ROTR64 {
        << 0
    }
    if op == BIN_AND || op == BIN_OR || op == BIN_XOR {
        if cv == 0 || cv == -1 { << 0 }
        if arm64_mode {
            if hc_is_bitmask_imm(cv) { << 0 }
        } else {
            if cv >= -2147483648 && cv <= 2147483647 { << 0 }
        }
        << hc_imm_cost(cv)
    }
    if op >= BIN_FADD && op <= BIN_FGE {
        << 0
    }
    // Skip div/mod directly in case opt_divc kept any constant divisor as immediate.
    if (op == BIN_DIV || op == BIN_MOD) && op_pos == 1 {
        << 0
    }
    if op == BIN_MUL || op == BIN_MULH || op == BIN_MULH_U {
        if cv >= -1 && cv <= 1 {
            << 0
        }
        if arm64_mode && op == BIN_MUL && cv > 2 && ((cv - 1) & (cv - 2)) == 0 {
            << 0
        }
        << hc_imm_cost(cv)
    }
    // Add/Sub/Compare fit 12-bit (or shifted 12-bit) immediates on ARM64 and imm32 on x64.
    if op_pos == 1 || op == BIN_ADD || op == BIN_EQ || op == BIN_NE {
        if cv >= -4095 && cv <= 4095 {
            << 0
        }
        if cv > 0 && (cv & 4095) == 0 && (cv >> 12) <= 4095 {
            << 0
        }
        if cv < 0 && cv >= -16773120 && ((0 - cv) & 4095) == 0 {
            << 0
        }
    }
    << hc_imm_cost(cv)
}

fn hc_is_inline_bits_call(ins &MInstr) bool {
    if ins.kind != MI_CALL { << false }
    s := ins.sval
    << s == "_xu_math_bits_reverse_bytes" ||
       s == "_xu_math_bits_reverse" ||
       s == "_xu_math_bits_ones_count" ||
       s == "_xu_math_bits_rotate_left" ||
       s == "_xu_math_bits_rotate_right" ||
       s == "_xu_math_bits_len" ||
       s == "_xu_math_bits_leading_zeros" ||
       s == "_xu_math_bits_trailing_zeros" ||
       s == "_xu_runtime_core_intrin_trailing_zeros"
}

fn hc_is_cold_alloc_call(ins &MInstr) bool {
    if ins.kind != MI_CALL { << false }
    s := ins.sval
    << s == "_xu_runtime_core_desc_reserve" ||
       s == "_xu_runtime_core_slice_push" ||
       s == "_xu_runtime_core_str_push_byte" ||
       s == "_xu_runtime_core_str_push"
}

fn hc_record_cand(cand_idx $&[]int, cand_score $&[]int, cand_cost $&[]int, op_v int, cs int, mul_w int) {
    $pos := -1
    for ki in 0:cand_idx.len {
        if cand_idx[ki] == op_v {
            pos = ki
            <-
        }
    }
    if pos < 0 {
        cand_idx.push(op_v)
        cand_score.push(cs * mul_w)
        cand_cost.push(cs)
    } else {
        cand_score[pos] = cand_score[pos] + cs * mul_w
        if cs > cand_cost[pos] { cand_cost[pos] = cs }
    }
}

// Materialize expensive loop-invariant integer constants into temps in the
// preheader of call-free loops (run after opt_fold/opt_gvn so copy-prop
// does not fold them back inline).
pub fn opt_hoist_loop_consts(f $&MFn, allow_cost1 bool) bool {
    if f.blocks.len < 2 || f.consts.len == 0 || f.instrs.len == 0 {
        << false
    }
    $loops := find_loops(f, false)
    if loops.len == 0 {
        << false
    }
    // Compute incoming edge sources per block to find unique external preheaders.
    nb := f.blocks.len
    $order := []int{}
    for i in 0:loops.len {
        order.push(i)
    }
    // Sort outermost-first (descending block count) so outer preheaders win.
    for i in 0:order.len {
        for j in i + 1:order.len {
            if loops[order[j]].blocks.len > loops[order[i]].blocks.len {
                tmp := order[i]
                order[i] = order[j]
                order[j] = tmp
            }
        }
    }
    $preds := [][]int{}
    for _ in 0:nb {
        preds.push([]int{})
    }
    for b in 0:nb {
        ss := loop_succs(f, b)
        for si in 0:ss.len {
            s := ss[si]
            if s >= 0 && s < nb {
                preds[s].push(b)
            }
        }
    }
    $changed := false
    for oi in 0:order.len {
        lo_idx := order[oi]
        lp := ~loops[lo_idx]
        h := lp.header
        $has_call := false
        $has_hot_call := false
        $cold_blk := []bool{}
        for _ in 0:nb { cold_blk.push(false) }
        $loc_seen := []bool{}
        for _ in 0:f.locals.len { loc_seen.push(false) }
        $loop_locals := 0
        for bi in 0:lp.blocks.len {
            blk_b := lp.blocks[bi]
            $is_cond_arm := blk_b != h && preds[blk_b].len == 1 &&
                            preds[blk_b][0] >= 0 && preds[blk_b][0] < lp.body.len &&
                            lp.body[preds[blk_b][0]] && f.blocks[preds[blk_b][0]].tkind == TKIND_BRANCH
            $saw_cold_call := false
            $saw_hot_call := false
            $ii := f.blocks[blk_b].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_CALL_IND {
                    has_call = true
                    saw_hot_call = true
                } else if ins.kind == MI_CALL && !hc_is_panic_call(ins) && !(allow_cost1 && hc_is_inline_bits_call(ins)) {
                    has_call = true
                    if is_cond_arm && hc_is_cold_alloc_call(ins) {
                        saw_cold_call = true
                    } else {
                        saw_hot_call = true
                    }
                } else if (ins.kind == MI_LOAD_LOCAL || ins.kind == MI_ADDR) && ins.b >= 0 && ins.b < loc_seen.len {
                    if !loc_seen[ins.b] {
                        loc_seen[ins.b] = true
                        loop_locals += 1
                    }
                } else if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < loc_seen.len {
                    if !loc_seen[ins.a] {
                        loc_seen[ins.a] = true
                        loop_locals += 1
                    }
                }
                ii = ins.next
            }
            if saw_hot_call {
                has_hot_call = true
            } else if saw_cold_call {
                cold_blk[blk_b] = true
            }
        }
        // Check if an inner loop sits inside lp so outer-only constants don't
        // occupy registers across a complex inner loop.
        $inner_only := []bool{}
        $has_inner := false
        for _ in 0:nb { inner_only.push(false) }
        for li2 in 0:loops.len {
            if loops[li2].header != h && loops[li2].header < lp.body.len && lp.body[loops[li2].header] {
                has_inner = true
                for b2i in 0:loops[li2].blocks.len {
                    inner_only[loops[li2].blocks[b2i]] = true
                }
            }
        }
        // Only hoist multi-instruction constants in simple non-nested call loops,
        // unless all calls sit on conditional cold allocation/push branches.
        if has_hot_call && (has_inner || loop_locals > 14 || lp.blocks.len > 10) {
            ->
        }
        cold_call_only := has_call && !has_hot_call && (has_inner || loop_locals > 14 || lp.blocks.len > 10)
        // Find unique external predecessor (either jump preheader or single branch arm).
        $ph := -1
        $ext_cnt := 0
        for pi in 0:preds[h].len {
            p := preds[h][pi]
            if p >= 0 && p < lp.body.len && !lp.body[p] {
                ph = p
                ext_cnt += 1
            }
        }
        is_jmp_ph := ph >= 0 && f.blocks[ph].tkind == TKIND_JUMP && f.blocks[ph].ta == h
        is_br_ph := ph >= 0 && f.blocks[ph].tkind == TKIND_BRANCH && (f.blocks[ph].tb == h || f.blocks[ph].tc == h)
        if ext_cnt != 1 || (!is_jmp_ph && !is_br_ph) {
            ->
        }
        // Keep empty entry trampoline block 0 clean in parametric functions so
        // fast-entry shrink-wrapping can still skip block 0 when beneficial.
        if ph == 0 && f.nparams > 0 && f.blocks[0].head < 0 && is_jmp_ph {
            ->
        }
        // Collect unique constant indices used in loop, scored by savings * frequency.
        $cand_idx := []int{}
        $cand_score := []int{}
        $cand_cost := []int{}
        for bi in 0:lp.blocks.len {
            blk_id := lp.blocks[bi]
            if cold_blk[blk_id] { -> }
            in_inner := inner_only[blk_id]
            $ii := f.blocks[blk_id].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                $mul_w := 1
                if in_inner { mul_w = 16 }
                if ins.kind == MI_BIN {
                    if ins.c <= -2 {
                        cv := f.consts[0 - ins.c - 2]
                        $cs := hc_const_cost(ins, 0, cv, allow_cost1)
                        if has_inner && !in_inner && cs < 4 && (has_call || loop_locals > 10 || cs < 2) { cs = 0 }
                        if cs > 0 {
                            hc_record_cand($&cand_idx, $&cand_score, $&cand_cost, ins.c, cs, mul_w)
                        }
                    }
                    if ins.d <= -2 {
                        $cv := f.consts[0 - ins.d - 2]
                        $cs := hc_const_cost(ins, 1, cv, allow_cost1)
                        if has_inner && !in_inner && cs < 4 && (has_call || loop_locals > 10 || cs < 2) { cs = 0 }
                        if cs > 0 {
                            hc_record_cand($&cand_idx, $&cand_score, $&cand_cost, ins.d, cs, mul_w)
                        }
                    }
                } else if ins.kind == MI_SELECT {
                    if ins.c <= -2 {
                        cv := f.consts[0 - ins.c - 2]
                        if cv != 0 && cv != 1 && cv != -1 {
                            $cs := hc_imm_cost(cv)
                            if has_inner && !in_inner && cs < 4 && (has_call || loop_locals > 10 || cs < 2) { cs = 0 }
                            if cs > 0 {
                                hc_record_cand($&cand_idx, $&cand_score, $&cand_cost, ins.c, cs, mul_w)
                            }
                        }
                    }
                    if ins.d <= -2 {
                        $cv := f.consts[0 - ins.d - 2]
                        if cv != 0 && cv != 1 && cv != -1 {
                            $cs := hc_imm_cost(cv)
                            if has_inner && !in_inner && cs < 4 && (has_call || loop_locals > 10 || cs < 2) { cs = 0 }
                            if cs > 0 {
                                hc_record_cand($&cand_idx, $&cand_score, $&cand_cost, ins.d, cs, mul_w)
                            }
                        }
                    }
                }
                ii = ins.next
            }
        }
        if cand_idx.len == 0 { -> }
        // Pick up to 3 top candidates; only hoist 1-cost immediates in tiny uncrowded ARM64 inner loops.
        allow_c1_loop := allow_cost1 && !has_call && !has_inner && lp.blocks.len <= 4 && loop_locals <= 6
        $max_hoist := 3
        $min_cost := 1
        if cold_call_only {
            max_hoist = 2
            min_cost = 4
        } else if has_call {
            max_hoist = 2
            min_cost = 2
            if !allow_cost1 { min_cost = 4 }
        }
        $emit_ph := ph
        $taken := []int{}
        $hoist_temp := []int{}
        for _ in 0:max_hoist {
            $best := -1
            for ki in 0:cand_idx.len {
                if cand_score[ki] <= 0 || cand_cost[ki] < min_cost { -> }
                if cand_cost[ki] < 2 && !allow_c1_loop { -> }
                $already := false
                for ti in 0:taken.len {
                    if taken[ti] == cand_idx[ki] {
                        already = true
                        <-
                    }
                }
                if !already && (best < 0 || cand_score[ki] > cand_score[best]) {
                    best = ki
                }
            }
            if best < 0 { <- }
            if f.blocks[emit_ph].tkind == TKIND_BRANCH {
                new_ph := f.blocks.len
                $nblk := mblock_new()
                nblk.tkind = TKIND_JUMP
                nblk.ta = h
                nblk.line = f.blocks[h].line
                f.blocks.push(nblk)
                if f.blocks[emit_ph].tb == h { f.blocks[emit_ph].tb = new_ph }
                if f.blocks[emit_ph].tc == h { f.blocks[emit_ph].tc = new_ph }
                $np := []int{}
                np.push(emit_ph)
                preds.push(np)
                for pi in 0:preds[h].len {
                    if preds[h][pi] == emit_ph { preds[h][pi] = new_ph }
                }
                for mi in 0:loops.len {
                    olp := $&loops[mi]
                    $add_in := olp.header != h && emit_ph < olp.body.len && olp.body[emit_ph] && h < olp.body.len && olp.body[h]
                    olp.body.push(add_in)
                    if add_in { olp.blocks.push(new_ph) }
                }
                emit_ph = new_ph
            }
            c_op := cand_idx[best]
            t_c := alloc_temp(f)
            $ci := minstr_new(MI_COPY)
            ci.a = t_c
            ci.b = c_op
            ci.line = f.blocks[emit_ph].line
            ni := f.instrs.len
            f.instrs.push(ci)
            mir_append_instr(f, emit_ph, ni)
            taken.push(c_op)
            hoist_temp.push(t_c)
        }
        if taken.len == 0 { -> }
        for bi in 0:lp.blocks.len {
            $ii := f.blocks[lp.blocks[bi]].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                if ins.kind == MI_BIN {
                    for ti in 0:taken.len {
                        tc := taken[ti]
                        if ins.c == tc && hc_const_cost(&ins, 0, f.consts[0 - tc - 2], allow_cost1) > 0 {
                            f.instrs[ii].c = hoist_temp[ti]
                        }
                        if ins.d == tc && hc_const_cost(&ins, 1, f.consts[0 - tc - 2], allow_cost1) > 0 {
                            f.instrs[ii].d = hoist_temp[ti]
                        }
                    }
                } else if ins.kind == MI_SELECT {
                    for ti in 0:taken.len {
                        tc := taken[ti]
                        cv := f.consts[0 - tc - 2]
                        if cv != 0 && cv != 1 && cv != -1 && hc_imm_cost(cv) > 0 {
                            if ins.c == tc { f.instrs[ii].c = hoist_temp[ti] }
                            if ins.d == tc { f.instrs[ii].d = hoist_temp[ti] }
                        }
                    }
                }
                ii = ins.next
            }
        }
        changed = true
    }
    << changed
}
