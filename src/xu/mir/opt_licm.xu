@xu/mir
// Loop-Invariant Code Motion (LICM) optimization pass.
//
// Layer 3 module: identifies natural loops (self-loops and multi-block loops),
// finds loop-invariant computations (pure arithmetic, constants, unmodified
// local variable loads), and hoists them to loop preheaders.

fn is_pure_instr(kind int) bool {
    if kind == MI_COPY || kind == MI_LOAD_LOCAL || kind == MI_UN ||
       kind == MI_BIN || kind == MI_STR_CONST || kind == MI_LOAD_FIELD ||
       kind == MI_ELEM_ADDR || kind == MI_LOAD_PTR || kind == MI_LOAD_BUF_PTR {
        << true
    }
    << false
}

pub fn instr_has_dest(kind int) bool {
    if kind == MI_NOP || kind == MI_STORE_LOCAL || kind == MI_DROP ||
       kind == MI_STORE_FIELD || kind == MI_ARR_PUSH || kind == MI_STORE_PTR ||
       kind == MI_STORE_INDEX || kind == MI_DROP_FIELD || kind == MI_DROP_PTR_FIELD ||
       kind == MI_DROP_BUF_FIELD || kind == MI_STORE_BUF_PTR || kind == MI_CHAN_SEND ||
       kind == MI_XU || kind == MI_CHAN_CLOSE || kind == MI_XU_PUMP ||
       kind == MI_ARR_PUSH4 || kind == MI_INDEX_RMW || kind == MI_FIELD_RMW {
        << false
    }
    << true
}

fn licm_instr_dest(f &MFn, ii int) int {
    if ii < 0 || ii >= f.instrs.len {
        << -1
    }
    k := f.instrs[ii].kind
    if !instr_has_dest(k) {
        << -1
    }
    << f.instrs[ii].a
}

fn block_is_effectively_empty(f &MFn, bi int) bool {
    if bi < 0 || bi >= f.blocks.len {
        << false
    }
    $ii := f.blocks[bi].head
    while ii >= 0 && ii < f.instrs.len {
        if f.instrs[ii].kind != MI_NOP {
            << false
        }
        ii = f.instrs[ii].next
    }
    << true
}

fn skip_empty_jumps(f &MFn, start int) int {
    $b := start
    n := f.blocks.len
    for _ in 0:n {
        if b < 0 || b >= n {
            << start
        }
        if !block_is_effectively_empty(f, b) {
            << b
        }
        tk := f.blocks[b].tkind
        $nxt := -1
        if tk == TKIND_JUMP {
            nxt = f.blocks[b].ta
        } else if tk == TKIND_BRANCH {
            tb := f.blocks[b].tb
            tc := f.blocks[b].tc
            if tb == tc && tb >= 0 {
                nxt = tb
            } else {
                << b
            }
        } else {
            << b
        }
        if nxt == b || nxt < 0 || nxt >= n {
            << b
        }
        b = nxt
    }
    << b
}

fn is_self_loop(f &MFn, bi int) bool {
    if bi < 0 || bi >= f.blocks.len {
        << false
    }
    tk := f.blocks[bi].tkind
    if tk == TKIND_JUMP && f.blocks[bi].ta == bi {
        << true
    }
    if tk == TKIND_BRANCH && (f.blocks[bi].tb == bi || f.blocks[bi].tc == bi) {
        << true
    }
    << false
}

fn unique_ext_pred_excluding(f &MFn, bi int, exclude int) int {
    $pred := -1
    for pi in 0:f.blocks.len {
        if pi == bi || pi == exclude {
            ->
        }
        $hits := false
        tk := f.blocks[pi].tkind
        if tk == TKIND_JUMP && f.blocks[pi].ta == bi {
            hits = true
        }
        if tk == TKIND_BRANCH && (f.blocks[pi].tb == bi || f.blocks[pi].tc == bi) {
            hits = true
        }
        if hits {
            if pred >= 0 {
                << -1
            }
            pred = pi
        }
    }
    << pred
}

fn unique_ext_pred(f &MFn, bi int) int {
    << unique_ext_pred_excluding(f, bi, -1)
}

pub fn mir_detach_instr(f $&MFn, bi int, ii int) bool {
    if bi < 0 || bi >= f.blocks.len || ii < 0 || ii >= f.instrs.len {
        << false
    }
    $b := ~f.blocks[bi]
    $prev := -1
    $p := b.head
    while p >= 0 && p < f.instrs.len {
        if p == ii {
            nxt := f.instrs[p].next
            if prev < 0 {
                b.head = nxt
            } else {
                f.instrs[prev].next = nxt
            }
            if b.tail == ii {
                b.tail = prev
            }
            f.instrs[ii].next = -1
            f.blocks[bi] = ~b
            << true
        }
        prev = p
        p = f.instrs[p].next
    }
    << false
}

pub fn mir_append_instr(f $&MFn, bi int, ii int) {
    if bi < 0 || bi >= f.blocks.len || ii < 0 || ii >= f.instrs.len {
        <<
    }
    $b := ~f.blocks[bi]
    f.instrs[ii].next = -1
    if b.head < 0 {
        b.head = ii
        b.tail = ii
    } else {
        tail := b.tail
        if tail >= 0 && tail < f.instrs.len {
            f.instrs[tail].next = ii
        }
        b.tail = ii
    }
    f.blocks[bi] = ~b
}

fn is_val_invariant(v int, loop_defs &[]bool, hoisted &[]bool) bool {
    if v <= -2 {
        << true
    }
    if v >= 0 && v < loop_defs.len {
        if !loop_defs[v] {
            << true
        }
        if v < hoisted.len && hoisted[v] {
            << true
        }
        << false
    }
    << true
}

pub fn opt_licm(f $&MFn) {
    if f.blocks.len == 0 || f.instrs.len == 0 {
        <<
    }

    nloc := f.locals.len
    ntmp := f.temps.len

    // Count definitions of each temporary across the whole function
    $ndef := []int{}
    for _ in 0:ntmp {
        ndef.push(0)
    }
    for bi0 in 0:f.blocks.len {
        $p := f.blocks[bi0].head
        while p >= 0 && p < f.instrs.len {
            d := licm_instr_dest(f, p)
            if d >= 0 && d < ndef.len {
                ndef[d] = ndef[d] + 1
            }
            p = f.instrs[p].next
        }
    }

    // 1. Process single-block self loops
    for bi in 0:f.blocks.len {
        if !is_self_loop(f, bi) {
            ->
        }
        pred := unique_ext_pred(f, bi)
        if pred < 0 {
            ->
        }

        $skip := false
        $has_call := false
        $stored := []bool{}
        for _ in 0:nloc {
            stored.push(false)
        }
        $loop_defs := []bool{}
        for _ in 0:ntmp {
            loop_defs.push(false)
        }

        $ii := f.blocks[bi].head
        while ii >= 0 && ii < f.instrs.len {
            k := f.instrs[ii].kind
            ia := f.instrs[ii].a
            if k == MI_CALL {
                has_call = true
            }
            if k == MI_STORE_LOCAL {
                if ia >= 0 && ia < stored.len {
                    stored[ia] = true
                }
            }
            if k == MI_ARRAY_LIT || k == MI_ARR_PUSH || k == MI_ARR_PUSH4 ||
               k == MI_CHAN_NEW || k == MI_CHAN_SEND || k == MI_CHAN_RECV ||
               k == MI_XU || k == MI_CHAN_CLOSE || k == MI_CHAN_TRY_SEND ||
               k == MI_CHAN_TRY_RECV || k == MI_XU_PUMP {
                skip = true
            }
            d := licm_instr_dest(f, ii)
            if d >= 0 && d < loop_defs.len {
                loop_defs[d] = true
            }
            ii = f.instrs[ii].next
        }

        if skip || has_call {
            ->
        }

        $hoist := []int{}
        $hoisted := []bool{}
        for _ in 0:ntmp {
            hoisted.push(false)
        }

        ii = f.blocks[bi].head
        while ii >= 0 && ii < f.instrs.len {
            nxt := f.instrs[ii].next
            k := f.instrs[ii].kind
            dest := licm_instr_dest(f, ii)
            $take := false

            if dest >= 0 && dest < ndef.len && ndef[dest] == 1 && is_pure_instr(k) {
                if k == MI_LOAD_LOCAL {
                    loc := f.instrs[ii].b
                    if loc >= 0 && loc < stored.len && !stored[loc] {
                        take = true
                    }
                } else if k == MI_COPY {
                    v := f.instrs[ii].b
                    if is_val_invariant(v, &loop_defs, &hoisted) {
                        take = true
                    }
                } else if k == MI_UN {
                    v := f.instrs[ii].c
                    if is_val_invariant(v, &loop_defs, &hoisted) {
                        take = true
                    }
                } else if k == MI_STR_CONST {
                    take = true
                } else if k == MI_BIN {
                    op := f.instrs[ii].b
                    lhs := f.instrs[ii].c
                    rhs := f.instrs[ii].d
                    if is_val_invariant(lhs, &loop_defs, &hoisted) && is_val_invariant(rhs, &loop_defs, &hoisted) {
                        if op != BIN_DIV && op != BIN_MOD {
                            take = true
                        } else if rhs <= -2 {
                            cidx := 0 - rhs - 2
                            if cidx >= 0 && cidx < f.consts.len && f.consts[cidx] != 0 {
                                take = true
                            }
                        }
                    }
                }
            }

            if take {
                if dest >= 0 && dest < hoisted.len {
                    hoisted[dest] = true
                }
                hoist.push(ii)
            }
            ii = nxt
        }

        for hi in 0:hoist.len {
            mir_detach_instr(f, bi, hoist[hi])
            mir_append_instr(f, pred, hoist[hi])
        }
    }

    // 2. Process multi-block loops (header -> body -> header)
    for header in 0:f.blocks.len {
        if f.blocks[header].tkind != TKIND_BRANCH {
            ->
        }
        tb := skip_empty_jumps(f, f.blocks[header].tb)
        tc := skip_empty_jumps(f, f.blocks[header].tc)
        $loop_blks := []int{}
        $back_blk := -1

        for arm in 0:2 {
            if back_blk >= 0 {
                <-
            }
            $b1 := tb
            if arm == 1 {
                b1 = tc
            }
            if b1 < 0 || b1 >= f.blocks.len || b1 == header {
                ->
            }
            if unique_ext_pred(f, b1) != header {
                ->
            }
            if f.blocks[b1].tkind != TKIND_JUMP {
                ->
            }
            succ1 := skip_empty_jumps(f, f.blocks[b1].ta)
            if succ1 == header {
                loop_blks.push(header)
                loop_blks.push(b1)
                back_blk = b1
            } else if succ1 >= 0 && succ1 < f.blocks.len && succ1 != b1 && succ1 != header {
                b2 := succ1
                if unique_ext_pred(f, b2) == b1 && f.blocks[b2].tkind == TKIND_JUMP {
                    succ2 := skip_empty_jumps(f, f.blocks[b2].ta)
                    if succ2 == header {
                        loop_blks.push(header)
                        loop_blks.push(b1)
                        loop_blks.push(b2)
                        back_blk = b2
                    }
                }
            }
        }

        if back_blk < 0 || loop_blks.len < 2 {
            ->
        }

        pred := unique_ext_pred_excluding(f, header, back_blk)
        if pred < 0 || pred == header {
            ->
        }
        $pred_in_loop := false
        for lbi in 0:loop_blks.len {
            if loop_blks[lbi] == pred {
                pred_in_loop = true
            }
        }
        if pred_in_loop {
            ->
        }

        $skip := false
        $has_call := false
        $stored := []bool{}
        for _ in 0:nloc {
            stored.push(false)
        }
        $loop_defs := []bool{}
        for _ in 0:ntmp {
            loop_defs.push(false)
        }

        for step in 0:loop_blks.len {
            cur_blk := loop_blks[step]
            $ii := f.blocks[cur_blk].head
            while ii >= 0 && ii < f.instrs.len {
                k := f.instrs[ii].kind
                ia := f.instrs[ii].a
                if k == MI_CALL {
                    has_call = true
                }
                if k == MI_STORE_LOCAL {
                    if ia >= 0 && ia < stored.len {
                        stored[ia] = true
                    }
                }
                if k == MI_ARRAY_LIT || k == MI_ARR_PUSH || k == MI_ARR_PUSH4 ||
                   k == MI_CHAN_NEW || k == MI_CHAN_SEND || k == MI_CHAN_RECV ||
                   k == MI_XU || k == MI_CHAN_CLOSE || k == MI_CHAN_TRY_SEND ||
                   k == MI_CHAN_TRY_RECV || k == MI_XU_PUMP {
                    skip = true
                }
                d := licm_instr_dest(f, ii)
                if d >= 0 && d < loop_defs.len {
                    loop_defs[d] = true
                }
                ii = f.instrs[ii].next
            }
        }

        if skip || has_call {
            ->
        }

        $hoisted := []bool{}
        for _ in 0:ntmp {
            hoisted.push(false)
        }

        for step in 0:loop_blks.len {
            cur_blk := loop_blks[step]
            $hoist := []int{}
            $ii := f.blocks[cur_blk].head
            while ii >= 0 && ii < f.instrs.len {
                nxt := f.instrs[ii].next
                k := f.instrs[ii].kind
                dest := licm_instr_dest(f, ii)
                $take := false

                if dest >= 0 && dest < ndef.len && ndef[dest] == 1 && is_pure_instr(k) {
                    if k == MI_LOAD_LOCAL {
                        loc := f.instrs[ii].b
                        if loc >= 0 && loc < stored.len && !stored[loc] {
                            take = true
                        }
                    } else if k == MI_COPY {
                        v := f.instrs[ii].b
                        if is_val_invariant(v, &loop_defs, &hoisted) {
                            take = true
                        }
                    } else if k == MI_UN {
                        v := f.instrs[ii].c
                        if is_val_invariant(v, &loop_defs, &hoisted) {
                            take = true
                        }
                    } else if k == MI_STR_CONST {
                        take = true
                    } else if k == MI_BIN {
                        op := f.instrs[ii].b
                        lhs := f.instrs[ii].c
                        rhs := f.instrs[ii].d
                        if is_val_invariant(lhs, &loop_defs, &hoisted) && is_val_invariant(rhs, &loop_defs, &hoisted) {
                            if op != BIN_DIV && op != BIN_MOD {
                                take = true
                            } else if rhs <= -2 {
                                cidx := 0 - rhs - 2
                                if cidx >= 0 && cidx < f.consts.len && f.consts[cidx] != 0 {
                                    take = true
                                }
                            }
                        }
                    }
                }

                if take {
                    if dest >= 0 && dest < hoisted.len {
                        hoisted[dest] = true
                    }
                    hoist.push(ii)
                }
                ii = nxt
            }

            for hi in 0:hoist.len {
                mir_detach_instr(f, cur_blk, hoist[hi])
                mir_append_instr(f, pred, hoist[hi])
            }
        }
    }
}
