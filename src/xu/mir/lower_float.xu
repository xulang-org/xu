@xu/mir
// f64 values: literals, arithmetic, comparisons, casts and printing.
//
// An f64 is its IEEE-754 bit pattern in an ordinary word, so locals, fields,
// arguments and results need nothing beyond the integer value model.

#xu/ast
#xu/parser
#xu/types

fn float_bin_code(op int) int {
    if op == ast.OP_ADD { << BIN_FADD }
    if op == ast.OP_SUB { << BIN_FSUB }
    if op == ast.OP_MUL { << BIN_FMUL }
    if op == ast.OP_DIV { << BIN_FDIV }
    if op == ast.OP_EQ { << BIN_FEQ }
    if op == ast.OP_NE { << BIN_FNE }
    if op == ast.OP_LT { << BIN_FLT }
    if op == ast.OP_LE { << BIN_FLE }
    if op == ast.OP_GT { << BIN_FGT }
    if op == ast.OP_GE { << BIN_FGE }
    << -1
}

// Compound assignment operator on a value of type ty.
fn assign_op_code(ty int, aop int) int {
    if ty == 4 {
        if aop == ast.AS_ADD { << BIN_FADD }
        if aop == ast.AS_SUB { << BIN_FSUB }
        if aop == ast.AS_MUL { << BIN_FMUL }
        if aop == ast.AS_DIV { << BIN_FDIV }
        << -1
    }
    << assign_bin_code(aop)
}

fn (w $&Lw) float_binop(p &parser.Parser, tp &types.TypedProgram, n int) int {
    op := p.nodes[n].ival
    code := float_bin_code(op)
    if code < 0 {
        w.fail(p, n, "f64 operator " + ast.binop_name(op) + " is not supported yet")
        << w.konst(0)
    }
    a := w.lower_expr(p, tp, p.nodes[n].a)
    b := w.lower_expr(p, tp, p.nodes[n].b)
    << w.bin(code, a, b)
}

fn (w $&Lw) float_neg(v int) int {
    << w.bin(BIN_XOR, v, w.konst(1 << 63))
}

fn (w $&Lw) float_un(op int, v int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_UN)
    ins.a = t
    ins.b = op
    ins.c = v
    w.emit(ins)
    << t
}

fn (w $&Lw) float_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if p.nodes[n].kind == ast.NK_FLOAT {
        << w.konst(p.nodes[n].ival)
    }
    << NOT_HANDLED
}

fn (w $&Lw) float_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    << NOT_HANDLED
}

fn (w $&Lw) float_method_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    << NOT_HANDLED
}

// Cast n (to or from f64) of the already lowered operand v.
fn (w $&Lw) float_cast(p &parser.Parser, tp &types.TypedProgram, n int, v int) int {
    to := p.nodes[n].ival
    from := tp.deref(tp.type_of(p.nodes[n].a))
    if to == 4 {
        if from == 4 {
            << v
        }
        << w.float_un(UN_I2F, v)
    }
    i := w.float_un(UN_F2I, v)
    if to == 10 {
        << w.bin(BIN_AND, i, w.konst(255))
    }
    if to == 9 {
        << w.bin(BIN_AND, i, w.konst(4294967295))
    }
    if to == 8 {
        sh := w.bin(BIN_SHL, i, w.konst(32))
        << w.bin(BIN_SHR, sh, w.konst(32))
    }
    << i
}

// println / eprintln of an f64 value.
fn (w $&Lw) float_print(fd int, v int) {
    $args := []int{}
    args.push(w.konst(fd))
    args.push(v)
    args.push(w.konst(1))
    w.call_core("print_f64", &args)
}
