@xu/mir
// Value forwarding and dead-store removal for scalar locals in typed MIR.
//
// A one-word local whose address is never taken can only change through
// its own stores, so inside a block a load after a store (or after an
// earlier load) is a copy of the value already at hand, and a store that
// no path reads again before the next store is dead. Inlining and
// tail-recursion elimination leave many such store/load pairs behind;
// opt_fold then propagates the copies.

fn local_bit(bits &[]int, base int, i int) bool {
    << ((bits[base + i / 32] >> (i % 32)) & 1) != 0
}

fn local_bit_set(bits $&[]int, base int, i int) {
    bits[base + i / 32] = bits[base + i / 32] | (1 << (i % 32))
}

fn local_bit_clear(bits $&[]int, base int, i int) {
    if local_bit(bits, base, i) {
        bits[base + i / 32] = bits[base + i / 32] - (1 << (i % 32))
    }
}

pub fn opt_locals(f $&MFn) bool {
    nl := f.locals.len
    nt := f.temps.len
    if nl == 0 || f.blocks.len == 0 {
        << false
    }
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            << false
        }
    }
    // Candidates: one word, never address-taken, only read and written
    // at word 0.
    $cand := []bool{}
    for l in 0:nl {
        cand.push(f.locals_nslots[l] == 1)
    }
    $ndef := []int{}
    for _ in 0:nt {
        ndef.push(0)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                cand[ins.b] = false
            } else if k == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && ins.c > 0 {
                cand[ins.b] = false
            } else if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl && ins.c > 0 {
                cand[ins.a] = false
            }
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                ndef[ins.a] = ndef[ins.a] + 1
            }
            ii = ins.next
        }
    }
    $changed := false
    // Forwarding inside each block. known[l] is the value local l holds
    // (a constant or a temp defined once) while kblk[l] is the block being
    // scanned; otherwise nothing is known. A load whose temp is also read
    // in other blocks is only replaced by a constant: opt_fold cannot
    // propagate a copy of a temp across blocks, and the copy would keep
    // two temps live where the register allocator gives the load the
    // local's own register.
    ub := fold_use_blocks(f)
    $known := []int{}
    $kblk := []int{}
    for _ in 0:nl {
        known.push(0 - 1)
        kblk.push(0 - 1)
    }
    $nstores := 0
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl && cand[ins.a] {
                $v := 0 - 1
                if ins.b <= 0 - 2 {
                    v = ins.b
                } else if ins.b >= 0 && ins.b < nt && ndef[ins.b] == 1 {
                    v = ins.b
                }
                known[ins.a] = v
                kblk[ins.a] = bi
                nstores += 1
            } else if k == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && cand[ins.b] {
                if kblk[ins.b] == bi && known[ins.b] != 0 - 1 && (known[ins.b] <= 0 - 2 || ins.a < 0 || ins.a >= nt || ub[ins.a] == bi || ub[ins.a] == 0 - 1) {
                    f.instrs[ii].kind = MI_COPY
                    f.instrs[ii].b = known[ins.b]
                    f.instrs[ii].c = 0 - 1
                    changed = true
                } else if ins.a >= 0 && ins.a < nt && ndef[ins.a] == 1 {
                    known[ins.b] = ins.a
                    kblk[ins.b] = bi
                }
            }
            ii = ins.next
        }
    }
    if nstores == 0 {
        << changed
    }
    // Liveness of candidate locals: live-in sets per block, to a fixpoint.
    nw := (nl + 31) / 32
    nb := f.blocks.len
    $gen := []int{}
    $kill := []int{}
    $live_in := []int{}
    for _ in 0:nb * nw {
        gen.push(0)
        kill.push(0)
        live_in.push(0)
    }
    for bi in 0:nb {
        base := bi * nw
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            if ins.kind == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && cand[ins.b] {
                if !local_bit(&kill, base, ins.b) {
                    local_bit_set($&gen, base, ins.b)
                }
            } else if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl && cand[ins.a] {
                local_bit_set($&kill, base, ins.a)
            }
            ii = ins.next
        }
        for w in 0:nw {
            live_in[base + w] = gen[base + w]
        }
    }
    $out := []int{}
    for _ in 0:nw {
        out.push(0)
    }
    $more := true
    while more {
        more = false
        $bi := nb - 1
        while bi >= 0 {
            base := bi * nw
            for w in 0:nw {
                out[w] = 0
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                sb := f.blocks[bi].ta * nw
                for w in 0:nw {
                    out[w] = live_in[sb + w]
                }
            } else if tk == TKIND_BRANCH {
                sb := f.blocks[bi].tb * nw
                sc := f.blocks[bi].tc * nw
                for w in 0:nw {
                    out[w] = live_in[sb + w] | live_in[sc + w]
                }
            }
            for w in 0:nw {
                // in = gen | (out & ~kill)
                nv := gen[base + w] | (out[w] - (out[w] & kill[base + w]))
                if nv != live_in[base + w] {
                    live_in[base + w] = nv
                    more = true
                }
            }
            bi -= 1
        }
    }
    // Backward over each block: a store to a local that is not live after
    // it goes away.
    for bi in 0:nb {
        for w in 0:nw {
            out[w] = 0
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_JUMP {
            sb := f.blocks[bi].ta * nw
            for w in 0:nw {
                out[w] = live_in[sb + w]
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[bi].tb * nw
            sc := f.blocks[bi].tc * nw
            for w in 0:nw {
                out[w] = live_in[sb + w] | live_in[sc + w]
            }
        }
        ids := loop_ids(f, bi)
        $dead := []bool{}
        for _ in 0:ids.len {
            dead.push(false)
        }
        $has_dead := false
        $k := ids.len - 1
        while k >= 0 {
            ins := ~f.instrs[ids[k]]
            if ins.kind == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && cand[ins.b] {
                local_bit_set($&out, 0, ins.b)
            } else if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl && cand[ins.a] {
                if local_bit(&out, 0, ins.a) {
                    local_bit_clear($&out, 0, ins.a)
                } else {
                    dead[k] = true
                    has_dead = true
                }
            }
            k -= 1
        }
        if !has_dead {
            ->
        }
        $prev := 0 - 1
        f.blocks[bi].head = 0 - 1
        for k2 in 0:ids.len {
            if dead[k2] {
                ->
            }
            if prev < 0 {
                f.blocks[bi].head = ids[k2]
            } else {
                f.instrs[prev].next = ids[k2]
            }
            prev = ids[k2]
        }
        if prev >= 0 {
            f.instrs[prev].next = 0 - 1
        }
        f.blocks[bi].tail = prev
        changed = true
    }
    << changed
}
