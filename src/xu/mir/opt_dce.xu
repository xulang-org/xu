@xu/mir
// Dead Code Elimination (DCE) and Dead Store Elimination (DSE) optimization pass.
//
// Layer 3 module: eliminates unused pure computations (dead temporary values,
// redundant identity copies, dead expressions) and unread local variable stores
// through iterative usage counting and liveness tracking.

fn is_pure_dce_instr(kind int) bool {
    if kind == MI_COPY || kind == MI_LOAD_LOCAL || kind == MI_BIN ||
       kind == MI_UN || kind == MI_STR_CONST || kind == MI_LOAD_FIELD ||
       kind == MI_ELEM_ADDR || kind == MI_LOAD_PTR || kind == MI_LOAD_BUF_PTR ||
       kind == MI_SELECT {
        << true
    }
    << false
}

fn count_temp_uses(f &MFn, uses $&[]int) {
    for u in 0:uses.len {
        uses[u] = 0
    }

    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 && ii < f.instrs.len {
            k := f.instrs[ii].kind
            if k != MI_NOP {
                if k == MI_STORE_LOCAL {
                    v := f.instrs[ii].b
                    if v >= 0 && v < uses.len {
                        uses[v] = uses[v] + 1
                    }
                } else if k == MI_COPY {
                    v := f.instrs[ii].b
                    if v >= 0 && v < uses.len {
                        uses[v] = uses[v] + 1
                    }
                } else if k == MI_UN {
                    v := f.instrs[ii].c
                    if v >= 0 && v < uses.len {
                        uses[v] = uses[v] + 1
                    }
                } else if k == MI_BIN {
                    v1 := f.instrs[ii].c
                    if v1 >= 0 && v1 < uses.len {
                        uses[v1] = uses[v1] + 1
                    }
                    v2 := f.instrs[ii].d
                    if v2 >= 0 && v2 < uses.len {
                        uses[v2] = uses[v2] + 1
                    }
                } else if k == MI_SELECT {
                    cb := f.instrs[ii].b
                    if cb >= 0 && cb < uses.len {
                        uses[cb] = uses[cb] + 1
                    }
                    v1 := f.instrs[ii].c
                    if v1 >= 0 && v1 < uses.len {
                        uses[v1] = uses[v1] + 1
                    }
                    v2 := f.instrs[ii].d
                    if v2 >= 0 && v2 < uses.len {
                        uses[v2] = uses[v2] + 1
                    }
                } else if k == MI_CALL {
                    $ap := f.instrs[ii].c
                    while ap >= 0 && ap < f.margs.len {
                        v := f.margs[ap].v
                        if v >= 0 && v < uses.len {
                            uses[v] = uses[v] + 1
                        }
                        ap = f.margs[ap].next
                    }
                } else if k == MI_LOAD_FIELD || k == MI_LOAD_PTR || k == MI_LOAD_BUF_PTR {
                    v := f.instrs[ii].b
                    if v >= 0 && v < uses.len {
                        uses[v] = uses[v] + 1
                    }
                } else if k == MI_STORE_FIELD || k == MI_STORE_PTR || k == MI_STORE_BUF_PTR {
                    v1 := f.instrs[ii].b
                    if v1 >= 0 && v1 < uses.len {
                        uses[v1] = uses[v1] + 1
                    }
                    v2 := f.instrs[ii].c
                    if v2 >= 0 && v2 < uses.len {
                        uses[v2] = uses[v2] + 1
                    }
                } else if k == MI_ELEM_ADDR {
                    v1 := f.instrs[ii].b
                    if v1 >= 0 && v1 < uses.len {
                        uses[v1] = uses[v1] + 1
                    }
                    v2 := f.instrs[ii].c
                    if v2 >= 0 && v2 < uses.len {
                        uses[v2] = uses[v2] + 1
                    }
                }
            }

            if ii == f.blocks[bi].tail {
                <-
            }
            ii = f.instrs[ii].next
        }

        // Terminator usage
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            ta := f.blocks[bi].ta
            if ta >= 0 && ta < uses.len {
                uses[ta] = uses[ta] + 1
            }
        }
    }
}

fn opt_dse_unread_locals(mfn $&MFn) bool {
    nloc := mfn.locals.len
    $observed := []bool{}
    for _ in 0:nloc {
        observed.push(false)
    }

    for bi in 0:mfn.blocks.len {
        $ii := mfn.blocks[bi].head
        while ii >= 0 && ii < mfn.instrs.len {
            k := mfn.instrs[ii].kind
            if k == MI_LOAD_LOCAL {
                loc := mfn.instrs[ii].b
                if loc >= 0 && loc < observed.len {
                    observed[loc] = true
                }
            } else if k == MI_ADDR {
                loc := mfn.instrs[ii].b
                if loc >= 0 && loc < observed.len {
                    observed[loc] = true
                }
            }
            if ii == mfn.blocks[bi].tail {
                <-
            }
            ii = mfn.instrs[ii].next
        }
    }

    $changed := false
    for bi in 0:mfn.blocks.len {
        $kill := []int{}
        $ii := mfn.blocks[bi].head
        while ii >= 0 && ii < mfn.instrs.len {
            if mfn.instrs[ii].kind == MI_STORE_LOCAL {
                loc := mfn.instrs[ii].a
                if loc >= 0 && loc < observed.len && !observed[loc] {
                    kill.push(ii)
                }
            }
            if ii == mfn.blocks[bi].tail {
                <-
            }
            ii = mfn.instrs[ii].next
        }

        for ki in 0:kill.len {
            mir_detach_instr(mfn, bi, kill[ki])
            mfn.instrs[kill[ki]].kind = MI_NOP
            changed = true
        }
    }

    << changed
}

pub fn opt_dce(mfn $&MFn) {
    if mfn.blocks.len == 0 || mfn.instrs.len == 0 {
        <<
    }

    nt := mfn.temps.len
    $uses := []int{}
    for _ in 0:nt {
        uses.push(0)
    }

    for _ in 0:8 {
        $changed := false

        // 1. Eliminate stores to unread local variables
        if opt_dse_unread_locals(mfn) {
            changed = true
        }

        // 2. Count uses of all temporaries
        count_temp_uses(mfn, $&uses)

        // 3. Eliminate dead pure computations and identity copies
        for bi in 0:mfn.blocks.len {
            $kill := []int{}
            $ii := mfn.blocks[bi].head
            while ii >= 0 && ii < mfn.instrs.len {
                k := mfn.instrs[ii].kind
                if k != MI_NOP {
                    // Redundant identity copies: x = copy x
                    if k == MI_COPY && mfn.instrs[ii].a >= 0 && mfn.instrs[ii].a == mfn.instrs[ii].b {
                        kill.push(ii)
                    } else if is_pure_dce_instr(k) && instr_has_dest(k) {
                        dest := mfn.instrs[ii].a
                        // Dead pure computations whose results are never read
                        if dest >= 0 && dest < uses.len && uses[dest] == 0 {
                            kill.push(ii)
                        }
                    }
                }

                if ii == mfn.blocks[bi].tail {
                    <-
                }
                ii = mfn.instrs[ii].next
            }

            for ki in 0:kill.len {
                idx := kill[ki]
                mir_detach_instr(mfn, bi, idx)
                mfn.instrs[idx].kind = MI_NOP
                changed = true
            }
        }

        if !changed {
            <-
        }
    }
}
