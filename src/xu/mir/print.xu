@xu/mir
// Text form of typed MIR, for debugging and for pass tests.
//
// One line per instruction: temps print as tN, constants as their value,
// locals as lN (with the source name when there is one). A block starts
// with "bbN:" and ends with its terminator.

fn dump_val(f &MFn, v int) string {
    if v >= 0 {
        << "t" + str(v)
    }
    ci := 0 - v - 2
    if ci >= 0 && ci < f.consts.len {
        << str(f.consts[ci])
    }
    << "?"
}

fn dump_local(f &MFn, l int) string {
    $s := "l" + str(l)
    if l >= 0 && l < f.local_names.len && f.local_names[l].len > 0 {
        s = s + "(" + f.local_names[l] + ")"
    }
    << s
}

fn dump_bin(op int) string {
    if op == BIN_ADD { << "add" }
    if op == BIN_SUB { << "sub" }
    if op == BIN_MUL { << "mul" }
    if op == BIN_DIV { << "div" }
    if op == BIN_MOD { << "mod" }
    if op == BIN_EQ { << "eq" }
    if op == BIN_NE { << "ne" }
    if op == BIN_LT { << "lt" }
    if op == BIN_LE { << "le" }
    if op == BIN_GT { << "gt" }
    if op == BIN_GE { << "ge" }
    if op == BIN_AND { << "and" }
    if op == BIN_OR { << "or" }
    if op == BIN_XOR { << "xor" }
    if op == BIN_SHL { << "shl" }
    if op == BIN_SHR { << "shr" }
    if op == BIN_MULH { << "mulh" }
    << "bin" + str(op)
}

fn dump_args(f &MFn, first int) string {
    $s := ""
    $a := first
    while a >= 0 {
        if s.len > 0 {
            s = s + ", "
        }
        s = s + dump_val(f, f.margs[a].v)
        a = f.margs[a].next
    }
    << s
}

fn dump_instr(f &MFn, ins &MInstr) string {
    k := ins.kind
    if k == MI_NOP { << "nop" }
    if k == MI_COPY { << "t" + str(ins.a) + " = " + dump_val(f, ins.b) }
    if k == MI_LOAD_LOCAL { << "t" + str(ins.a) + " = load " + dump_local(f, ins.b) + "+" + str(ins.c) }
    if k == MI_STORE_LOCAL { << "store " + dump_local(f, ins.a) + "+" + str(ins.c) + ", " + dump_val(f, ins.b) }
    if k == MI_ADDR { << "t" + str(ins.a) + " = addr " + dump_local(f, ins.b) }
    if k == MI_LOAD_PTR { << "t" + str(ins.a) + " = load" + str(ins.d) + " [" + dump_val(f, ins.b) + "+" + str(ins.c) + "]" }
    if k == MI_STORE_PTR { << "store" + str(ins.d) + " [" + dump_val(f, ins.a) + "+" + str(ins.c) + "], " + dump_val(f, ins.b) }
    if k == MI_BIN {
        $tag := ""
        if ins.sval.len > 0 {
            tag = "  ; " + ins.sval
        }
        << "t" + str(ins.a) + " = " + dump_bin(ins.b) + " " + dump_val(f, ins.c) + ", " + dump_val(f, ins.d) + tag
    }
    if k == MI_UN { << "t" + str(ins.a) + " = un" + str(ins.b) + " " + dump_val(f, ins.c) }
    if k == MI_SELECT { << "t" + str(ins.a) + " = select " + dump_val(f, ins.b) + ", " + dump_val(f, ins.c) + ", " + dump_val(f, ins.d) }
    if k == MI_CALL { << "t" + str(ins.a) + " = call " + ins.sval + "(" + dump_args(f, ins.c) + ")" }
    if k == MI_CALL_IND { << "t" + str(ins.a) + " = call_ind " + dump_val(f, ins.b) + "(" + dump_args(f, ins.c) + ")" }
    if k == MI_STR_CONST { << "t" + str(ins.a) + " = str " + str(ins.sval.len) + " bytes" }
    if k == MI_LOAD_FN_ADDR { << "t" + str(ins.a) + " = fnaddr " + ins.sval }
    << "kind" + str(k) + " a=" + str(ins.a) + " b=" + str(ins.b) + " c=" + str(ins.c) + " d=" + str(ins.d)
}

// Prints f to stdout.
pub fn mir_dump(f &MFn) {
    $scalar := ""
    if f.scalar_params {
        scalar = " scalar"
    }
    println("fn " + f.label + " params=" + str(f.nparams) + scalar + " locals=" + str(f.locals.len) + " temps=" + str(f.temps.len))
    for bi in 0:f.blocks.len {
        println("  bb" + str(bi) + ":")
        $ii := f.blocks[bi].head
        while ii >= 0 {
            println("    " + dump_instr(f, &f.instrs[ii]))
            ii = f.instrs[ii].next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_JUMP {
            println("    jump bb" + str(f.blocks[bi].ta))
        } else if tk == TKIND_BRANCH {
            println("    br " + dump_val(f, f.blocks[bi].ta) + ", bb" + str(f.blocks[bi].tb) + ", bb" + str(f.blocks[bi].tc))
        } else if tk == TKIND_RETURN {
            println("    ret " + dump_val(f, f.blocks[bi].ta))
        } else {
            println("    open")
        }
    }
}
