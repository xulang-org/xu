@xu/mir
// Errors, throw/or handling and interface values (see lower.xu).
//
// A box is [type id word][concrete struct]; the type id is
// types.box_struct_tag(struct index), or ERR_STR_TAG for errors made by the
// runtime (err_from_str), whose payload is a string like errors.StrErr.
// Interface method calls compare the type id against every struct boxed
// into that interface anywhere in the program (TypedProgram.boxed).

#xu/ast
#xu/parser
#xu/types

// Must match ERR_STR_TAG in runtime/core/err.xu.
const ERR_STR_TAG = 2147483647

// Function fi uses the throwing ABI (hidden okp, error word result).
fn fn_throws(tp &types.TypedProgram, fi int) bool {
    << tp.fns[fi].may_throw && types.is_throw_type(tp.fns[fi].throw_ty)
}

// ===== boxing =====

fn (w &Lw) err_wants_box(tp &types.TypedProgram, n int) bool {
    bt := tp.box_of(n)
    if bt == 0 || !types.is_interface_type(bt) {
        << false
    }
    << types.is_struct_type(tp.deref(tp.type_of(n)))
}

fn (w $&Lw) err_box(p &parser.Parser, tp &types.TypedProgram, n int) int {
    saved := w.unboxed
    w.unboxed = n
    v := w.lower_expr(p, tp, n)
    w.unboxed = saved
    << w.box_struct(tp, v, tp.deref(tp.type_of(n)))
}

// Heap box holding a copy of the struct value at address v.
fn (w $&Lw) box_struct(tp &types.TypedProgram, v int, sty int) int {
    sz := tp.size_of(sty)
    $args := []int{}
    args.push(w.konst(8 + sz))
    bx := w.call_core("alloc", &args)
    w.store_ptr(bx, 0, w.konst(types.box_struct_tag(types.struct_index(sty))), 8)
    if sz > 0 {
        w.copy_mem(w.bin(BIN_ADD, bx, w.konst(8)), v, sz)
    }
    << bx
}

// Interface word of expression n, boxing a struct value.
fn (w $&Lw) err_value(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if w.err_wants_box(tp, n) {
        << w.lower_expr(p, tp, n)
    }
    ty := tp.deref(tp.deref(tp.type_of(n)))
    v := w.lower_expr(p, tp, n)
    if types.is_struct_type(ty) {
        << w.box_struct(tp, v, ty)
    }
    if w.expr_is_ref(p, tp, n) {
        << w.load_ptr(v, 0, 8)
    }
    << v
}

// Interface word of the receiver/operand n (which may be a reference).
fn (w $&Lw) iface_word(p &parser.Parser, tp &types.TypedProgram, n int) int {
    v := w.lower_expr(p, tp, n)
    if w.expr_is_ref(p, tp, n) {
        << w.load_ptr(v, 0, 8)
    }
    << v
}

fn add_boxed(tp $&types.TypedProgram, ity int, sty int) {
    $i := 0
    while i + 1 < tp.boxed.len {
        if tp.boxed[i] == ity && tp.boxed[i + 1] == sty {
            <<
        }
        i += 2
    }
    tp.boxed.push(ity)
    tp.boxed.push(sty)
}

// Scan nodes lo..hi under the node tables selected by tp.use_fn.
fn scan_boxes(tp $&types.TypedProgram, lo int, hi int, refs &[]int, throws &[]int) {
    $n := lo
    while n < hi {
        bt := tp.box_of(n)
        t := tp.type_of(n)
        if bt != 0 && types.is_interface_type(bt) {
            sty := types.strip_direct_ref(refs, t)
            if types.is_struct_type(sty) {
                add_boxed(tp, bt, sty)
            }
        } else if tp.call_of(n) == -93 && types.is_interface_type(t) && tp.local_of(n) >= 0 {
            add_boxed(tp, t, types.struct_type(tp.local_of(n)))
        }
        n += 1
    }
    $i := 0
    while i + 1 < throws.len {
        t := throws[i]
        a := throws[i + 1]
        if t < tp.base_type.len && a < tp.base_type.len && types.is_throw_type(tp.type_of(t)) {
            ri := types.throw_index(tp.type_of(t))
            sty := types.strip_direct_ref(refs, tp.type_of(a))
            if ri >= 0 && ri < tp.throws.len && types.is_struct_type(sty) {
                add_boxed(tp, tp.throws[ri].err_ty, sty)
            }
        }
        i += 2
    }
}

// Record every (interface, struct) pair boxed by the program.
fn err_collect_boxes(p &parser.Parser, tp $&types.TypedProgram) {
    // (throw node, value node) pairs.
    $throws := []int{}
    for n in 0:p.nodes.len {
        if p.nodes[n].kind == ast.NK_THROW && p.nodes[n].a >= 0 {
            throws.push(n)
            throws.push(p.nodes[n].a)
        }
    }
    refs := tp_ints(&tp.ref_targets)
    prev := tp.cur_fn
    tp.use_fn(-1)
    $hi := tp.base_box.len
    if tp.base_type.len < hi {
        hi = tp.base_type.len
    }
    scan_boxes(tp, 0, hi, &refs, &throws)
    for fi in 0:tp.fns.len {
        if tp.fns[fi].is_inst && fi < tp.inst_box.len && tp.inst_box[fi].len > 0 {
            tp.use_fn(fi)
            lo := tp.inst_lo[fi]
            scan_boxes(tp, lo, lo + tp.inst_box[fi].len, &refs, &throws)
        }
    }
    tp.use_fn(prev)
}

fn tp_ints(src &[]int) []int {
    << src[0:src.len]
}

// Struct index of errors.StrErr (-1 when absent).
fn strerr_index(tp &types.TypedProgram) int {
    for i in 0:tp.structs.len {
        if tp.structs[i].name == "StrErr" || tp.structs[i].name == "errors.StrErr" {
            if tp.structs[i].fields.len == 1 && tp.structs[i].fields[0].ty == 3 {
                << i
            }
        }
    }
    << -1
}

// ===== throwing calls =====

// Call of a throwing function: okp first; the error word goes to last_err.
fn (w $&Lw) err_finish_call(tp &types.TypedProgram, callee int, args &[]int) int {
    rty := tp.fns[callee].ret
    $okp := w.konst(0)
    $out := -1
    if rty != 0 {
        if is_wide(tp, rty) {
            out = w.scratch(tp, rty)
        } else {
            out = w.scratch_words(1)
        }
        okp = out
    }
    $all := []int{}
    all.push(okp)
    for i in 0:args.len {
        all.push(args[i])
    }
    w.last_err = w.call(tp.fns[callee].label, &all)
    if rty == 0 {
        << w.konst(0)
    }
    if is_wide(tp, rty) {
        << out
    }
    << w.load_ptr(out, 0, width_of(tp, rty))
}

// Return error word e from the current function when it is non-zero.
fn (w $&Lw) err_propagate(p &parser.Parser, n int, e int) {
    if w.okp < 0 {
        w.fail(p, n, "error propagation outside a throwing function")
        <<
    }
    prop_b := w.new_block()
    cont_b := w.new_block()
    w.branch(e, prop_b, cont_b)
    w.f.active_bb = prop_b
    w.ret(e)
    w.f.active_bb = cont_b
}

// ncall -83: a throwing call whose error propagates to the caller.
fn (w $&Lw) err_propagating_call(p &parser.Parser, tp &types.TypedProgram, n int, method bool) int {
    target := tp.const_of(n)
    w.last_err = -1
    $v := NOT_HANDLED
    if target >= 0 {
        if method {
            v = w.lower_user_method_call(p, tp, n, target)
        } else {
            v = w.lower_user_call(p, tp, n, target)
        }
    } else if method {
        v = w.host_method_call(p, tp, n, target)
    } else {
        v = w.host_call(p, tp, n, target)
    }
    if v == NOT_HANDLED {
        w.fail(p, n, "throwing builtin '" + p.nodes[n].sval + "' (code " + str(target) + ") is not supported yet")
        << w.konst(0)
    }
    if w.last_err < 0 {
        w.fail(p, n, "throwing call '" + p.nodes[n].sval + "' produced no error word")
        << v
    }
    e := w.last_err
    w.last_err = -1
    w.err_propagate(p, n, e)
    << v
}

// `<< a` in a throwing function: store the ok value through okp.
fn (w $&Lw) err_return(p &parser.Parser, tp &types.TypedProgram, a int) {
    if a < 0 {
        w.ret(w.konst(0))
        <<
    }
    if w.ret_ty == 0 {
        w.lower_expr(p, tp, a)
        w.ret(w.konst(0))
        <<
    }
    $v := -1
    if types.is_ref_type(w.ret_ty) && !w.expr_is_ref(p, tp, a) {
        v = w.lower_addr(p, tp, a)
    } else {
        v = w.lower_expr(p, tp, a)
    }
    w.ensure_open()
    okp := w.load_local(w.okp, 0)
    w.store_value(tp, okp, 0, v, w.ret_ty)
    w.ret(w.konst(0))
}

// ===== or-catch =====

fn (w $&Lw) lower_or_catch(p &parser.Parser, tp &types.TypedProgram, n int) int {
    w.last_err = -1
    v := w.lower_expr(p, tp, p.nodes[n].a)
    e := w.last_err
    w.last_err = -1
    if e < 0 {
        // Not a throwing call: the handler is dead.
        << v
    }
    ty := tp.type_of(n)
    wide := ty != 0 && is_wide(tp, ty)
    $res := -1
    if ty != 0 {
        res = w.new_local(ty, tp.words_of(ty), "orv")
    }
    err_b := w.new_block()
    ok_b := w.new_block()
    done_b := w.new_block()
    w.branch(e, err_b, ok_b)
    w.f.active_bb = ok_b
    if res >= 0 {
        if wide {
            w.copy_mem(w.addr_local(res), v, tp.size_of(ty))
        } else {
            w.store_local(res, 0, v)
        }
    }
    w.jump(done_b)
    w.f.active_bb = err_b
    if res >= 0 {
        if wide {
            w.zero_mem(w.addr_local(res), tp.size_of(ty))
        } else {
            w.store_local(res, 0, w.konst(0))
        }
    }
    id := tp.local_of(n)
    if id >= 0 {
        w.store_to_local(tp, id, e)
    }
    w.lower_block(p, tp, p.nodes[n].c)
    if w.open() && res >= 0 {
        // A handler that falls through assigned the binding target; the
        // expression then yields that value.
        tgt := last_assigned_ident(p, tp, p.nodes[n].c)
        if tgt >= 0 {
            fv := w.lower_expr(p, tp, tgt)
            if wide {
                w.copy_mem(w.addr_local(res), fv, tp.size_of(ty))
            } else {
                w.store_local(res, 0, fv)
            }
        }
    }
    w.jump(done_b)
    w.f.active_bb = done_b
    if res < 0 {
        << w.konst(0)
    }
    if wide {
        << w.addr_local(res)
    }
    << w.load_local(res, 0)
}

fn last_assigned_ident(p &parser.Parser, tp &types.TypedProgram, head int) int {
    $found := -1
    $s := head
    while s >= 0 {
        if p.nodes[s].kind == ast.NK_ASSIGN {
            t := p.nodes[s].a
            if t >= 0 && p.nodes[t].kind == ast.NK_IDENT && tp.local_of(t) >= 0 {
                found = t
            }
        }
        s = p.nodes[s].next
    }
    << found
}

// ===== interface methods and type tests =====

// Method fi of struct type sty named name (-1 when absent).
fn struct_method(tp &types.TypedProgram, sty int, name &string) int {
    for i in 0:tp.fns.len {
        if tp.fns[i].recv >= 0 && !tp.fns[i].is_template && !tp.fns[i].is_extern && tp.fns[i].decl >= 0 {
            if tp.deref(tp.fns[i].recv) == sty && tp.fns[i].name == *name {
                << i
            }
        }
    }
    << -1
}

// ncall -94: call through an interface value, dispatching on the box type id.
fn (w $&Lw) lower_iface_call(p &parser.Parser, tp &types.TypedProgram, n int) int {
    mname := p.nodes[n].sval + ""
    ity := types.interface_type(tp.local_of(n))
    $cand_si := []int{}
    $cand_fi := []int{}
    $i := 0
    while i + 1 < tp.boxed.len {
        if tp.boxed[i] == ity {
            sty := tp.boxed[i + 1]
            fi := struct_method(tp, sty, &mname)
            if fi >= 0 {
                cand_si.push(types.struct_index(sty))
                cand_fi.push(fi)
            }
        }
        i += 2
    }
    bx := w.iface_word(p, tp, p.nodes[n].a)
    $args := []int{}
    $arg := p.nodes[n].b
    $pi := 0
    while arg >= 0 {
        $pty := tp.type_of(arg)
        if cand_fi.len > 0 && pi < tp.fns[cand_fi[0]].params.len {
            pty = tp.fns[cand_fi[0]].params[pi]
        }
        args.push(w.lower_arg(p, tp, arg, pty))
        pi += 1
        arg = p.nodes[arg].next
    }
    rty := tp.type_of(n)
    wide := rty != 0 && is_wide(tp, rty)
    $out := -1
    $res := -1
    if wide {
        out = w.scratch(tp, rty)
    } else if rty != 0 {
        res = w.new_local(rty, 1, "im")
    }
    tag := w.load_ptr(bx, 0, 8)
    self := w.bin(BIN_ADD, bx, w.konst(8))
    done_b := w.new_block()
    for c in 0:cand_fi.len {
        fi := cand_fi[c]
        then_b := w.new_block()
        next_b := w.new_block()
        w.branch(w.bin(BIN_EQ, tag, w.konst(types.box_struct_tag(cand_si[c]))), then_b, next_b)
        w.f.active_bb = then_b
        $all := []int{}
        if wide {
            all.push(out)
        }
        all.push(self)
        for j in 0:args.len {
            all.push(args[j])
        }
        if fn_throws(tp, fi) {
            w.fail(p, n, "throwing method '" + mname + "' called through an interface is not supported yet")
        }
        r := w.call(tp.fns[fi].label, &all)
        if res >= 0 {
            w.store_local(res, 0, r)
        }
        w.jump(done_b)
        w.f.active_bb = next_b
    }
    if mname == "msg" && rty == 3 {
        then_b := w.new_block()
        next_b := w.new_block()
        w.branch(w.bin(BIN_EQ, tag, w.konst(ERR_STR_TAG)), then_b, next_b)
        w.f.active_bb = then_b
        $margs := []int{}
        margs.push(out)
        margs.push(bx)
        w.call_core("err_msg_copy", &margs)
        w.jump(done_b)
        w.f.active_bb = next_b
    }
    $pargs := []int{}
    pargs.push(tag)
    w.call_core("iface_tag_panic", &pargs)
    w.jump(done_b)
    w.f.active_bb = done_b
    if wide {
        << out
    }
    if res >= 0 {
        << w.load_local(res, 0)
    }
    << w.konst(0)
}

// Box type id test: 1 when interface word bx holds a struct with tag.
fn (w $&Lw) tag_matches(tp &types.TypedProgram, bx int, tag int) int {
    res := w.new_local(2, 1, "is")
    w.store_local(res, 0, w.konst(0))
    some_b := w.new_block()
    done_b := w.new_block()
    w.branch(bx, some_b, done_b)
    w.f.active_bb = some_b
    t := w.load_ptr(bx, 0, 8)
    $hit := w.bin(BIN_EQ, t, w.konst(tag))
    si := strerr_index(tp)
    if si >= 0 && tag == types.box_struct_tag(si) {
        hit = w.bin(BIN_OR, hit, w.bin(BIN_EQ, t, w.konst(ERR_STR_TAG)))
    }
    w.store_local(res, 0, hit)
    w.jump(done_b)
    w.f.active_bb = done_b
    << w.load_local(res, 0)
}

fn (w $&Lw) lower_type_test(p &parser.Parser, tp &types.TypedProgram, n int) int {
    a := p.nodes[n].a
    if !types.is_interface_type(tp.deref(tp.deref(tp.type_of(a)))) {
        << NOT_HANDLED
    }
    bx := w.iface_word(p, tp, a)
    tag := tp.local_of(n)
    hit := w.tag_matches(tp, bx, tag)
    if p.nodes[n].kind == ast.NK_TYPE_IS {
        << hit
    }
    w.type_assert(hit)
    << w.bin(BIN_ADD, bx, w.konst(8))
}

// ===== hooks =====

fn (w $&Lw) err_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_OR_CATCH {
        << w.lower_or_catch(p, tp, n)
    }
    if k == ast.NK_TYPE_IS || k == ast.NK_TYPE_AS {
        << w.lower_type_test(p, tp, n)
    }
    << NOT_HANDLED
}

fn (w $&Lw) err_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    if code == -83 {
        << w.err_propagating_call(p, tp, n, false)
    }
    if code == -93 && types.is_interface_type(tp.type_of(n)) {
        arg := p.nodes[n].a
        v := w.lower_expr(p, tp, arg)
        << w.box_struct(tp, v, types.struct_type(tp.local_of(n)))
    }
    << NOT_HANDLED
}

fn (w $&Lw) err_method_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    if code == -83 {
        << w.err_propagating_call(p, tp, n, true)
    }
    if code == -94 {
        << w.lower_iface_call(p, tp, n)
    }
    if code == -93 && types.is_interface_type(tp.type_of(n)) {
        arg := p.nodes[n].b
        v := w.lower_expr(p, tp, arg)
        << w.box_struct(tp, v, types.struct_type(tp.local_of(n)))
    }
    << NOT_HANDLED
}

fn (w $&Lw) err_stmt(p &parser.Parser, tp &types.TypedProgram, s int) bool {
    if p.nodes[s].kind == ast.NK_THROW {
        if w.okp < 0 {
            w.fail(p, s, "`>>` outside a throwing function")
            << true
        }
        v := w.err_value(p, tp, p.nodes[s].a)
        w.ret(v)
        << true
    }
    << false
}
