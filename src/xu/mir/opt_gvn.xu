                f.instrs[ii].a = na
                ia = na
                w.changed = true
            }
            nb := gvn_rep_of(w, f, ib)
            if nb != ib {
                f.instrs[ii].b = nb
                ib = nb
                w.changed = true
            }
            $owner := -1
            $owner_off := 0
            gvn_buf_owner_info(w, f, ia, $&owner, $&owner_off)
            pvid := gvn_vid_of(w, ia)
            vvid := gvn_vid_of(w, ib)
