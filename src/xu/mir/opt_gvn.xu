            w.elem_epoch = w.elem_epoch + 1
            if owner >= 0 {
                // Backing-buffer stores cannot overwrite slice headers on the same root or any local frame slot.
                oloc := gvn_location(w, f, owner, owner_off)
                oroot := oloc.base_vid
                nh := w.hdr_top
                for hi in 0:nh {
                    if w.hdrs[hi].epoch == old_g {
                        $h_slot := w.hdrs[hi].frame_slot
                        if h_slot < 0 {
                            h_loc := GvnLocation{base_vid: w.hdrs[hi].root_vid, off: w.hdrs[hi].root_off}
                            h_slot = gvn_frame_slot(w, f, &h_loc, 8)
                        }
                        if (w.hdrs[hi].desc_vid == owner && (w.hdrs[hi].off == owner_off || w.hdrs[hi].off == owner_off + 8 || w.hdrs[hi].off == owner_off + 16)) ||
                           (oroot >= 0 && w.hdrs[hi].root_vid == oroot) ||
                           h_slot >= 0 {
                            gvn_push_hdr(w, GvnHdr{
                                desc_vid: w.hdrs[hi].desc_vid,
                                root_vid: w.hdrs[hi].root_vid,
                                root_off: w.hdrs[hi].root_off,
                                frame_slot: h_slot,
                                off: w.hdrs[hi].off,
                                val_vid: w.hdrs[hi].val_vid,
                                epoch: w.gen_epoch
                            })
                        }
                    }
                }
            } else if has_sloc && (s_slot >= 0 || s_param >= 0 || sloc.base_vid >= 0) {
                nh := w.hdr_top
                for hi in 0:nh {
                    if w.hdrs[hi].epoch == old_g {
                        $h_slot := w.hdrs[hi].frame_slot
                        if h_slot < 0 {
                            h_loc := GvnLocation{base_vid: w.hdrs[hi].root_vid, off: w.hdrs[hi].root_off}
                            h_slot = gvn_frame_slot(w, f, &h_loc, 8)
                        }
                        $h_param := -1
                        if h_slot < 0 { h_param = gvn_param_of_vid(w, f, w.hdrs[hi].root_vid) }
                        same_root := (h_slot >= 0 && s_slot >= 0 && h_slot == s_slot) ||
                                     (h_param >= 0 && s_param >= 0 && h_param == s_param) ||
                                     (sloc.base_vid >= 0 && w.hdrs[hi].root_vid == sloc.base_vid)
                        if (h_slot >= 0 && s_slot >= 0 && h_slot != s_slot) ||
                           (h_param >= 0 && s_slot >= 0) ||
                           (h_slot >= 0 && s_param >= 0) ||
                           (same_root && gvn_disjoint_ranges(sloc.off, nw, w.hdrs[hi].root_off, 8)) {
                            gvn_push_hdr(w, GvnHdr{
                                desc_vid: w.hdrs[hi].desc_vid,
                                root_vid: w.hdrs[hi].root_vid,
                                root_off: w.hdrs[hi].root_off,
                                frame_slot: h_slot,
                                off: w.hdrs[hi].off,
                                val_vid: w.hdrs[hi].val_vid,
                                epoch: w.gen_epoch
                            })
                        }
                    }
                }
            }
            if !has_sloc {
                w.exact_epoch = w.exact_epoch + 1
            } else {
                $ok_fwd := nw == 8
                if !ok_fwd && vvid <= -2 {
                    ok_fwd = gvn_width_ok_for_const(nw, f.consts[0 - vvid - 2])
                }
                $stored := -1
                if ok_fwd {
                    stored = vvid
                }
                gvn_push_exact(w, GvnExact{
                    frame_slot: s_slot,
                    param_id: s_param,
                    buf_owner: owner,
                    buf_owner_off: owner_off,
                    base_vid: sloc.base_vid,
                    off: sloc.off,
                    width: nw,
                    val_vid: stored,
                    epoch: w.exact_epoch,
                    is_store: true
                })
            }
        } else if k == MI_UN {
            nc := gvn_rep_of(w, f, ic)
            if nc != ic {
                f.instrs[ii].c = nc
                ic = nc
                w.changed = true
            }
            vc := gvn_vid_of(w, ic)
            if vc != -1 && ia >= 0 && w.ndef[ia] == 1 {
                hit := gvn_find_expr(w, MI_UN, ib, vc, 0)
                if hit >= 0 {
                    rep := w.vid_rep[hit]
                    f.instrs[ii].kind = MI_COPY
                    f.instrs[ii].b = rep
                    f.instrs[ii].c = -1
                    f.instrs[ii].d = -1
                    w.changed = true
                    gvn_bind_temp(w, ia, hit)
                } else {
                    nv := gvn_fresh_vid(w, ia)
                    gvn_bind_temp(w, ia, nv)
                    gvn_push_expr(w, MI_UN, ib, vc, 0, nv)
                }
            }
        } else if k == MI_BIN {
            nc := gvn_rep_of(w, f, ic)
            if nc != ic {
                f.instrs[ii].c = nc
                ic = nc
                w.changed = true
            }
            nd := gvn_rep_of(w, f, id)
            if nd != id {
                f.instrs[ii].d = nd
                id = nd
                w.changed = true
            }
            op := ib
            vc := gvn_vid_of(w, ic)
            vd := gvn_vid_of(w, id)
            if vc != -1 && vd != -1 && ia >= 0 && w.ndef[ia] == 1 {
                $folded_zero := false
                $folded_one := false
                if op == BIN_LT {
                    if gvn_is_le(w, f, vd, vc) { folded_zero = true }
                    else if gvn_is_lt(w, f, vc, vd) { folded_one = true }
                } else if op == BIN_LE {
                    if gvn_is_lt(w, f, vd, vc) { folded_zero = true }
                    else if gvn_is_le(w, f, vc, vd) { folded_one = true }
                } else if op == BIN_GT {
                    if gvn_is_le(w, f, vc, vd) { folded_zero = true }
                    else if gvn_is_lt(w, f, vd, vc) { folded_one = true }
                } else if op == BIN_GE {
                    if gvn_is_lt(w, f, vc, vd) { folded_zero = true }
                    else if gvn_is_le(w, f, vd, vc) { folded_one = true }
                } else if op == BIN_EQ {
                    if gvn_is_neq(w, f, vc, vd) { folded_zero = true }
                    else if vc == vd { folded_one = true }
                } else if op == BIN_NE {
                    if vc == vd { folded_zero = true }
                    else if gvn_is_neq(w, f, vc, vd) { folded_one = true }
                } else if op == BIN_AND {
                    if gvn_is_const_zero(w, f, vc) || gvn_is_const_zero(w, f, vd) {
                        folded_zero = true
                    }
                } else if op == BIN_OR && gvn_is_const_zero(w, f, vc) && gvn_is_const_zero(w, f, vd) {
                    folded_zero = true
                } else if op == BIN_DIV && vc == vd && gvn_is_neq_zero(w, f, vc) {
                    folded_one = true
                } else if op == BIN_MOD && vc == vd && gvn_is_neq_zero(w, f, vc) {
                    folded_zero = true
                } else if op == BIN_SUB && vc == vd {
                    folded_zero = true
                } else if op == BIN_SHR && vd <= -2 && f.consts[0 - vd - 2] == 63 && gvn_is_nonneg(w, f, vc) {
                    folded_zero = true
                }
                if folded_zero {
                    cz := gvn_get_zero(w, f)
                    f.instrs[ii].kind = MI_COPY
                    f.instrs[ii].b = cz
                    f.instrs[ii].c = -1
                    f.instrs[ii].d = -1
                    w.changed = true
                    rewritten = true
                    gvn_bind_temp(w, ia, cz)
                } else if folded_one {
                    c1 := gvn_get_one(w, f)
                    f.instrs[ii].kind = MI_COPY
                    f.instrs[ii].b = c1
                    f.instrs[ii].c = -1
                    f.instrs[ii].d = -1
                    w.changed = true
                    rewritten = true
                    gvn_bind_temp(w, ia, c1)
                } else if (op == BIN_OR || op == BIN_ADD) && (gvn_is_const_zero(w, f, vc) || gvn_is_const_zero(w, f, vd)) {
                    $keep_op := ic
                    $keep_vid := vc
                    if gvn_is_const_zero(w, f, vc) {
                        keep_op = id
                        keep_vid = vd
                    }
                    f.instrs[ii].kind = MI_COPY
                    f.instrs[ii].b = keep_op
                    f.instrs[ii].c = -1
                    f.instrs[ii].d = -1
                    w.changed = true
                    rewritten = true
                    gvn_bind_temp(w, ia, keep_vid)
                    if op == BIN_ADD && keep_op >= 0 && keep_op < w.nt && w.buf_owner[keep_op] >= 0 {
                        gvn_set_buf_owner(w, ia, w.buf_owner[keep_op], w.buf_owner_off[keep_op])
                    }
