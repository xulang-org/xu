                    f.instrs[ii].kind = MI_COPY
                    f.instrs[ii].b = ic
                    f.instrs[ii].c = -1
                    f.instrs[ii].d = -1
                    w.changed = true
                    rewritten = true
                    gvn_bind_temp(w, ia, vc)
                    if ic >= 0 && ic < w.nt && w.buf_owner[ic] >= 0 {
                        gvn_set_buf_owner(w, ia, w.buf_owner[ic], w.buf_owner_off[ic])
                    }
                } else {
                    $k1 := vc
                    $k2 := vd
                    if gvn_is_comm_bin(op) && k1 > k2 {
                        k1 = vd
                        k2 = vc
                    }
                    hit := gvn_find_expr(w, MI_BIN, op, k1, k2)
                    if hit != -1 {
                        rep := gvn_rep_of_vid(w, hit)
                        if rep != -1 && rep != ia {
                            f.instrs[ii].kind = MI_COPY
                            f.instrs[ii].b = rep
                            f.instrs[ii].c = -1
                            f.instrs[ii].d = -1
                            w.changed = true
                            rewritten = true
                            gvn_bind_temp(w, ia, hit)
                            if op == BIN_ADD && rep >= 0 && rep < w.nt && w.buf_owner[rep] >= 0 {
                                gvn_set_buf_owner(w, ia, w.buf_owner[rep], w.buf_owner_off[rep])
                            }
                        }
                    }
                    if !rewritten {
                        nv := gvn_fresh_vid(w, ia)
                        gvn_bind_temp(w, ia, nv)
                        gvn_push_expr(w, MI_BIN, op, k1, k2, nv)
                        if op == BIN_ADD || op == BIN_SUB {
                            if ic >= 0 && ic < w.nt && w.buf_owner[ic] >= 0 {
                                gvn_set_buf_owner(w, ia, w.buf_owner[ic], w.buf_owner_off[ic])
                            } else if op == BIN_ADD && id >= 0 && id < w.nt && w.buf_owner[id] >= 0 {
                                gvn_set_buf_owner(w, ia, w.buf_owner[id], w.buf_owner_off[id])
                            }
                            if op == BIN_SUB && gvn_is_nonneg(w, f, vd) && gvn_is_le(w, f, vd, vc) {
                                gvn_add_nn(w, nv)
                                gvn_add_le(w, nv, vc)
                                if vd <= -2 && f.consts[0 - vd - 2] > 0 {
                                    gvn_add_lt(w, nv, vc)
                                }
                            }
                        } else if op == BIN_AND {
                            if vc <= -2 && f.consts[0 - vc - 2] >= 0 {
                                gvn_add_nn(w, nv)
                                gvn_add_le(w, nv, vc)
                            } else if vd <= -2 && f.consts[0 - vd - 2] >= 0 {
                                gvn_add_nn(w, nv)
                                gvn_add_le(w, nv, vd)
                            }
                        } else if op == BIN_SHR {
                            if vd <= -2 && f.consts[0 - vd - 2] >= 0 && f.consts[0 - vd - 2] <= 63 && gvn_is_nonneg(w, f, vc) {
                                gvn_add_nn(w, nv)
                                gvn_add_le(w, nv, vc)
                            }
                        } else if op == BIN_MOD {
                            if gvn_is_nonneg(w, f, vc) {
                                gvn_add_nn(w, nv)
                            }
                        } else if op == BIN_DIV {
                            if gvn_is_nonneg(w, f, vc) && gvn_is_nonneg(w, f, vd) {
                                gvn_add_nn(w, nv)
                            }
                        }
                    }
                }
            }
        } else if k == MI_SELECT {
            nb := gvn_rep_of(w, f, ib)
            if nb != ib {
                f.instrs[ii].b = nb
                ib = nb
                w.changed = true
            }
            nc := gvn_rep_of(w, f, ic)
            if nc != ic {
                f.instrs[ii].c = nc
                ic = nc
                w.changed = true
            }
            nd := gvn_rep_of(w, f, id)
            if nd != id {
                f.instrs[ii].d = nd
                id = nd
                w.changed = true
            }
            vb := gvn_vid_of(w, ib)
            vc := gvn_vid_of(w, ic)
            vd := gvn_vid_of(w, id)
            if vb != -1 && vc != -1 && vd != -1 && ia >= 0 && w.ndef[ia] == 1 {
                hit := gvn_find_expr(w, MI_SELECT, vb, vc, vd)
                if hit >= 0 {
                    rep := w.vid_rep[hit]
                    f.instrs[ii].kind = MI_COPY
                    f.instrs[ii].b = rep
                    f.instrs[ii].c = -1
                    f.instrs[ii].d = -1
                    w.changed = true
                    gvn_bind_temp(w, ia, hit)
                } else {
                    nv := gvn_fresh_vid(w, ia)
                    gvn_bind_temp(w, ia, nv)
                    gvn_push_expr(w, MI_SELECT, vb, vc, vd, nv)
                }
            }
        } else if k == MI_CALL || k == MI_CALL_IND {
            if k == MI_CALL_IND {
                nb := gvn_rep_ptr(w, f, ib)
                if nb != ib {
                    f.instrs[ii].b = nb
                    ib = nb
                    w.changed = true
                }
            }
            $a := ic
            while a >= 0 {
                nv := gvn_rep_of(w, f, f.margs[a].v)
                if nv != f.margs[a].v {
                    f.margs[a].v = nv
                    w.changed = true
