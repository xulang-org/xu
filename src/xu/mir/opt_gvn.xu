            $push_base := -1
            $push_slot := -1
            $push_next_len := -1
            if k == MI_CALL && (f.instrs[ii].sval == "_xu_runtime_core_slice_push" || f.instrs[ii].sval == "_xu_runtime_core_str_push_byte") {
                parg0 := gvn_call_arg(f, ic, 0)
                push_base = gvn_vid_of(w, parg0)
                if push_base != -1 {
                    ploc := gvn_location(w, f, push_base, 8)
                    push_slot = gvn_frame_slot(w, f, &ploc, 8)
                    $ppid := -1
                    if push_slot < 0 { ppid = gvn_param_of_vid(w, f, ploc.base_vid) }
                    $old_lv := gvn_find_hdr(w, push_base, 8, push_slot, ploc.off)
                    if old_lv == -1 {
                        old_lv = gvn_find_exact(w, &ploc, 8, push_slot, ppid, -1, 0)
                    }
                    if old_lv <= -2 {
                        oci := 0 - old_lv - 2
                        if oci >= 0 && oci < f.consts.len && f.consts[oci] >= 0 && f.consts[oci] < 4611686018427387904 {
                            push_next_len = f.consts[oci] + 1
                        }
                    }
                }
            }
            effect := gvn_call_effect(w, &f.instrs[ii])
            if effect != 0 {
                old_g := w.gen_epoch
                w.gen_epoch = old_g + 1
                w.elem_epoch = w.elem_epoch + 1
                $has_buf := false
                exact_top := w.exact_top
                if effect < 0 || !gvn_record_call_writes(w, f, ic, effect, $&has_buf) {
                    w.exact_top = exact_top
                    w.exact_epoch = w.exact_epoch + 1
                } else if has_buf {
                    w.exact_epoch = w.exact_epoch + 1
                }
                if effect > 0 {
                    gvn_preserve_call_hdrs(w, f, ic, effect, old_g)
                }
            }
            if push_next_len >= 0 && push_base != -1 {
                gvn_push_slice_len_facts(w, f, push_base, push_slot, push_next_len)
            }
            if k == MI_CALL && (f.instrs[ii].sval == "_xu_runtime_core_intrin_make_ints" || f.instrs[ii].sval == "_xu_runtime_core_intrin_make_string") {
                arg0 := gvn_call_arg(f, ic, 0)
                arg1 := gvn_call_arg(f, ic, 1)
                base := gvn_vid_of(w, arg0)
                len_vid := gvn_vid_of(w, arg1)
                if base != -1 && len_vid != -1 {
                    if len_vid >= 0 {
                        gvn_add_nn(w, len_vid)
                    }
                    gvn_mark_slice_loc(w, f, base, 0)
                    for step_i in 0:2 {
                        off := 8 + step_i * 8
                        loc := gvn_location(w, f, base, off)
                        slot := gvn_frame_slot(w, f, &loc, 8)
                        $pid := -1
                        if slot < 0 {
                            pid = gvn_param_of_vid(w, f, loc.base_vid)
                        }
                        gvn_push_exact(w, GvnExact{
                            frame_slot: slot,
                            param_id: pid,
                            buf_owner: -1,
                            buf_owner_off: 0,
                            base_vid: loc.base_vid,
                            off: loc.off,
                            width: 8,
                            val_vid: len_vid,
                            epoch: w.exact_epoch,
                            is_store: false
                        })
                        gvn_push_hdr(w, GvnHdr{
                            desc_vid: base,
                            root_vid: loc.base_vid,
                            root_off: loc.off,
                            frame_slot: slot,
                            off: off,
                            val_vid: len_vid,
                            epoch: w.gen_epoch
                        })
                    }
                }
            }
        } else {
            if fold_defines(k) && ia >= 0 && w.ndef[ia] == 1 {
                nv := gvn_fresh_vid(w, ia)
                gvn_bind_temp(w, ia, nv)
            }
        }
        ii = next_ii
    }

    tk := f.blocks[b].tkind
    if tk == TKIND_BRANCH || tk == TKIND_RETURN {
        nta := gvn_rep_of(w, f, f.blocks[b].ta)
        if nta != f.blocks[b].ta {
            f.blocks[b].ta = nta
            w.changed = true
        }
    }
    << tk
}

fn gvn_enter_block(w $&GvnWork, f $&MFn, b int, depth int) bool {
    if w.is_panic[b] || depth > 512 {
        << false
    }
    w.in_dom[b] = true
    saved_expr_len := w.expr_top
    saved_t_len := w.t_top
    saved_vrep_len := w.vrep_top
    saved_buf_len := w.buf_top
    saved_sd_len := w.sd_top
    saved_sl_len := w.sl_top
    saved_loc_len := w.loc_top
    saved_hdr_len := w.hdr_top
    saved_exact_len := w.exact_top
    saved_gen_epoch := w.gen_epoch
    saved_elem_epoch := w.elem_epoch
    saved_exact_epoch := w.exact_epoch
    saved_nn_len := w.nn_top
    saved_lt_len := w.lt_top
    saved_le_len := w.le_top
    saved_neq_len := w.neq_top

    tk := gvn_visit_block(w, f, b)

    fr := GvnDfsFrame{
        b: b,
        depth: depth,
        next_ch: w.dom_first[b],
        tk: tk,
        sn: w.nn_top,
        sl: w.lt_top,
        se: w.le_top,
        sq: w.neq_top,
        saved_expr_len: saved_expr_len,
        saved_t_len: saved_t_len,
        saved_vrep_len: saved_vrep_len,
        saved_buf_len: saved_buf_len,
        saved_sd_len: saved_sd_len,
        saved_sl_len: saved_sl_len,
        saved_loc_len: saved_loc_len,
        saved_hdr_len: saved_hdr_len,
        saved_exact_len: saved_exact_len,
        saved_gen_epoch: saved_gen_epoch,
        saved_elem_epoch: saved_elem_epoch,
        saved_exact_epoch: saved_exact_epoch,
        saved_nn_len: saved_nn_len,
        saved_lt_len: saved_lt_len,
        saved_le_len: saved_le_len,
        saved_neq_len: saved_neq_len
    }
    if w.dfs_top < w.dfs_frames.len {
        w.dfs_frames[w.dfs_top] = ~fr
    } else {
        w.dfs_frames.push(~fr)
    }
    w.dfs_top = w.dfs_top + 1
    << true
}

fn gvn_leave_block(w $&GvnWork, fi int) {
    b := w.dfs_frames[fi].b
    saved_expr_len := w.dfs_frames[fi].saved_expr_len
    saved_t_len := w.dfs_frames[fi].saved_t_len
    saved_vrep_len := w.dfs_frames[fi].saved_vrep_len
    saved_buf_len := w.dfs_frames[fi].saved_buf_len
    saved_sd_len := w.dfs_frames[fi].saved_sd_len
    saved_sl_len := w.dfs_frames[fi].saved_sl_len
    saved_loc_len := w.dfs_frames[fi].saved_loc_len

    while w.expr_top > saved_expr_len {
        etop := w.expr_top - 1
        w.expr_top = etop
        eb := w.exprs[etop].bucket
        ep := w.exprs[etop].prev
        w.buckets[eb] = ep
    }
    while w.t_top > saved_t_len {
        w.t_top = w.t_top - 1
        t := w.t_undo[w.t_top]
        w.temp_vn[t] = -1
    }
    while w.vrep_top > saved_vrep_len {
        w.vrep_top = w.vrep_top - 1
        vv := w.vrep_undo_vid[w.vrep_top]
        w.vid_rep[vv] = w.vrep_undo_rep[w.vrep_top]
    }
    while w.buf_top > saved_buf_len {
        w.buf_top = w.buf_top - 1
        t := w.buf_undo[w.buf_top]
        w.buf_owner[t] = -1
        w.buf_owner_off[t] = 0
    }
    while w.sd_top > saved_sd_len {
        w.sd_top = w.sd_top - 1
        v := w.sd_undo[w.sd_top]
        w.is_slice_desc[v] = false
    }
    w.sl_top = saved_sl_len
    while w.loc_top > saved_loc_len {
        w.loc_top = w.loc_top - 1
        l := w.loc_undo_l[w.loc_top]
        w.local_vid[l] = w.loc_undo_v[w.loc_top]
        w.local_blk[l] = w.loc_undo_b[w.loc_top]
    }
    w.hdr_top = w.dfs_frames[fi].saved_hdr_len
    w.exact_top = w.dfs_frames[fi].saved_exact_len
    w.gen_epoch = w.dfs_frames[fi].saved_gen_epoch
    w.elem_epoch = w.dfs_frames[fi].saved_elem_epoch
    w.exact_epoch = w.dfs_frames[fi].saved_exact_epoch
    w.nn_top = w.dfs_frames[fi].saved_nn_len
    w.lt_top = w.dfs_frames[fi].saved_lt_len
    w.le_top = w.dfs_frames[fi].saved_le_len
    w.neq_top = w.dfs_frames[fi].saved_neq_len
    w.in_dom[b] = false
}

// Iterative dominator-tree GVN walk keeps call-stack depth O(1) across targets.
fn gvn_dfs(w $&GvnWork, f $&MFn, root int) {
    if !gvn_enter_block(w, f, root, 0) {
        <<
    }
    while w.dfs_top > 0 {
        fi := w.dfs_top - 1
        ch := w.dfs_frames[fi].next_ch
        if ch >= 0 {
            w.dfs_frames[fi].next_ch = w.dom_next[ch]
            b := w.dfs_frames[fi].b
            cdepth := w.dfs_frames[fi].depth + 1
            if !w.is_panic[ch] && cdepth <= 512 {
                tk := w.dfs_frames[fi].tk
                if tk == TKIND_BRANCH && f.blocks[b].tb != f.blocks[b].tc && w.n_eff_preds[ch] == 1 {
                    if ch == f.blocks[b].tb {
                        gvn_assume_cond(w, f, f.blocks[b].ta, true, 0, false)
                    } else if ch == f.blocks[b].tc {
                        gvn_assume_cond(w, f, f.blocks[b].ta, false, 0, false)
                    }
                }
                if !gvn_enter_block(w, f, ch, cdepth) {
                    w.nn_top = w.dfs_frames[fi].sn
                    w.lt_top = w.dfs_frames[fi].sl
                    w.le_top = w.dfs_frames[fi].se
                    w.neq_top = w.dfs_frames[fi].sq
                }
            }
        } else {
            gvn_leave_block(w, fi)
            w.dfs_top = w.dfs_top - 1
            if w.dfs_top > 0 {
                pfi := w.dfs_top - 1
                w.nn_top = w.dfs_frames[pfi].sn
                w.lt_top = w.dfs_frames[pfi].sl
                w.le_top = w.dfs_frames[pfi].se
                w.neq_top = w.dfs_frames[pfi].sq
            }
        }
    }
}

fn gvn_rep_of_vid(w &GvnWork, vid int) int {
    if vid <= -2 {
        << vid
    }
    if vid >= 0 && vid < w.vid_top {
        << w.vid_rep[vid]
    }
    << -1
}

fn gvn_no_store_on_path(w &GvnWork, f &MFn, par int, cmp_ii int, bi int, base_ii int, l int) bool {
    if par < 0 || bi < 0 || par >= w.nb || bi >= w.nb || par == bi {
        << false
    }
    // Check par strictly after cmp_ii.
    $pii := -1
    if cmp_ii >= 0 && cmp_ii < f.instrs.len {
        pii = f.instrs[cmp_ii].next
    }
    while pii >= 0 {
        pins := &f.instrs[pii]
        if pins.kind == MI_STORE_LOCAL && pins.a == l {
            << false
        }
        pii = pins.next
    }
    // Check bi strictly before base_ii.
    $seen_base := false
    $bii := f.blocks[bi].head
    while bii >= 0 {
        if bii == base_ii {
            seen_base = true
            <-
        }
        bins := &f.instrs[bii]
        if bins.kind == MI_STORE_LOCAL && bins.a == l {
            << false
        }
        bii = bins.next
    }
    if !seen_base {
        << false
    }
    // Reverse BFS from bi's effective predecessors back to par (do not pre-mark bi
    // so inner backedges through bi still inspect bi in full).
    $vis := []bool{}
    for _ in 0:w.nb {
        vis.push(false)
    }
    $q := []int{}
    $pe := w.pred_head[bi]
    while pe >= 0 {
        p := w.pred_from[pe]
        if p != par {
            if p == 0 {
                << false
            }
            if p > 0 && p < w.nb && !vis[p] {
                vis[p] = true
                q.push(p)
            }
        }
        pe = w.pred_next[pe]
    }
    $qh := 0
    while qh < q.len {
        u := q[qh]
        qh += 1
        $ui := f.blocks[u].head
        while ui >= 0 {
            uins := &f.instrs[ui]
            if uins.kind == MI_STORE_LOCAL && uins.a == l {
                << false
            }
            ui = uins.next
        }
        $upe := w.pred_head[u]
        while upe >= 0 {
            up := w.pred_from[upe]
            if up != par {
                if up == 0 {
                    << false
                }
                if up > 0 && up < w.nb && !vis[up] {
                    vis[up] = true
                    q.push(up)
                }
            }
            upe = w.pred_next[upe]
        }
    }
    << true
}

fn gvn_peel_copy(w &GvnWork, f &MFn, init_v int) int {
    $v := init_v
    for _ in 0:3 {
        if v >= 0 && v < w.nt && w.tdef[v] >= 0 && f.instrs[w.tdef[v]].kind == MI_COPY {
            v = f.instrs[w.tdef[v]].b
        } else {
            <-
        }
    }
    << v
}

fn gvn_edge_proves_lb(f &MFn, cop int, lc int, ld int, is_true bool, min_k int, cmp_x_out $&int) bool {
    *cmp_x_out = -1
    if min_k < 1 || min_k > 1024 {
        << false
    }
    $ok := false
    $cx := -1
    if is_true {
        if cop == BIN_GE && ld <= -2 && (0 - ld - 2) < f.consts.len && f.consts[0 - ld - 2] >= min_k {
            cx = lc
            ok = true
        } else if cop == BIN_GT && ld <= -2 && (0 - ld - 2) < f.consts.len && f.consts[0 - ld - 2] >= min_k - 1 {
            cx = lc
            ok = true
        } else if cop == BIN_LE && lc <= -2 && (0 - lc - 2) < f.consts.len && f.consts[0 - lc - 2] >= min_k {
            cx = ld
            ok = true
        } else if cop == BIN_LT && lc <= -2 && (0 - lc - 2) < f.consts.len && f.consts[0 - lc - 2] >= min_k - 1 {
            cx = ld
            ok = true
        } else if cop == BIN_EQ {
            if ld <= -2 && (0 - ld - 2) < f.consts.len && f.consts[0 - ld - 2] >= min_k {
                cx = lc
                ok = true
            } else if lc <= -2 && (0 - lc - 2) < f.consts.len && f.consts[0 - lc - 2] >= min_k {
                cx = ld
                ok = true
            }
        }
    } else {
        if cop == BIN_LT && ld <= -2 && (0 - ld - 2) < f.consts.len && f.consts[0 - ld - 2] >= min_k {
            cx = lc
            ok = true
        } else if cop == BIN_LE && ld <= -2 && (0 - ld - 2) < f.consts.len && f.consts[0 - ld - 2] >= min_k - 1 {
            cx = lc
            ok = true
        } else if cop == BIN_GT && lc <= -2 && (0 - lc - 2) < f.consts.len && f.consts[0 - lc - 2] >= min_k {
            cx = ld
            ok = true
        } else if cop == BIN_GE && lc <= -2 && (0 - lc - 2) < f.consts.len && f.consts[0 - lc - 2] >= min_k - 1 {
            cx = ld
            ok = true
        }
    }
    if ok && cx >= 0 {
        *cmp_x_out = cx
        << true
    }
    << false
}

fn gvn_edge_cond_proves_local_lb(w &GvnWork, f &MFn, par int, cur int, l int, min_k int) bool {
    if par < 0 || par >= w.nb || f.blocks[par].tkind != TKIND_BRANCH || f.blocks[par].tb == f.blocks[par].tc {
        << false
    }
    is_true := cur == f.blocks[par].tb
    if !is_true && cur != f.blocks[par].tc {
        << false
    }
    cond := f.blocks[par].ta
    cond_ii := w.tdef[cond]
    if f.instrs[cond_ii].kind != MI_BIN {
        << false
    }
    cins := &f.instrs[cond_ii]
    $cx := -1
    if cins.b == BIN_OR && !is_true {
        $ok_or := false
        if cins.c >= 0 && cins.c < w.nt && w.tdef[cins.c] >= 0 {
            c1_ii := w.tdef[cins.c]
            if f.instrs[c1_ii].kind == MI_BIN {
                ci1 := &f.instrs[c1_ii]
                if gvn_edge_proves_lb(f, ci1.b, ci1.c, ci1.d, false, min_k, $&cx) {
                    ok_or = true
                }
            }
        }
        if !ok_or && cins.d >= 0 && cins.d < w.nt && w.tdef[cins.d] >= 0 {
            c2_ii := w.tdef[cins.d]
            if f.instrs[c2_ii].kind == MI_BIN {
                ci2 := &f.instrs[c2_ii]
                if gvn_edge_proves_lb(f, ci2.b, ci2.c, ci2.d, false, min_k, $&cx) {
                    ok_or = true
                }
            }
        }
        if !ok_or { << false }
    } else if cins.b == BIN_AND && is_true {
        $ok_and := false
        if cins.c >= 0 && cins.c < w.nt && w.tdef[cins.c] >= 0 {
            c1_ii := w.tdef[cins.c]
            if f.instrs[c1_ii].kind == MI_BIN {
                ci1 := &f.instrs[c1_ii]
                if gvn_edge_proves_lb(f, ci1.b, ci1.c, ci1.d, true, min_k, $&cx) {
                    ok_and = true
                }
            }
        }
        if !ok_and && cins.d >= 0 && cins.d < w.nt && w.tdef[cins.d] >= 0 {
            c2_ii := w.tdef[cins.d]
            if f.instrs[c2_ii].kind == MI_BIN {
                ci2 := &f.instrs[c2_ii]
                if gvn_edge_proves_lb(f, ci2.b, ci2.c, ci2.d, true, min_k, $&cx) {
                    ok_and = true
                }
            }
        }
        if !ok_and { << false }
    } else {
        if !gvn_edge_proves_lb(f, cins.b, cins.c, cins.d, is_true, min_k, $&cx) {
            << false
        }
    }
    cx = gvn_peel_copy(w, f, cx)
    if cx < 0 || cx >= w.nt || w.tdef[cx] < 0 {
        << false
    }
    // Verify cx represents local l at exit of par.
    if w.tdef_blk[cx] == par {
        cxi := w.tdef[cx]
        cxins := &f.instrs[cxi]
        if cxins.kind == MI_LOAD_LOCAL && cxins.c == 0 && cxins.b == l {
            $ni := cxins.next
            $stored_after := false
            while ni >= 0 {
                if f.instrs[ni].kind == MI_STORE_LOCAL && f.instrs[ni].a == l {
                    stored_after = true
                    <-
                }
                ni = f.instrs[ni].next
            }
            if !stored_after {
                << true
            }
        }
    }
    $last_st := -1
    $pi := f.blocks[par].head
    while pi >= 0 {
        pins := &f.instrs[pi]
        if pins.kind == MI_STORE_LOCAL && pins.a == l {
            last_st = pins.b
        }
        pi = pins.next
    }
    if last_st != -1 && gvn_peel_copy(w, f, last_st) == cx {
        << true
    }
    << false
}

fn gvn_local_at_least_at(w &GvnWork, f &MFn, target_b int, target_store_ii int, l int, min_k int) bool {
    if target_b < 0 || target_b >= w.nb || min_k < 1 || min_k > 1024 {
        << false
    }
    $last_st := -1
    $ii := f.blocks[target_b].head
    while ii >= 0 && ii != target_store_ii {
        ins := &f.instrs[ii]
        if ins.kind == MI_STORE_LOCAL && ins.a == l {
            last_st = ins.b
        }
        ii = ins.next
    }
    if last_st != -1 {
        pv := gvn_peel_copy(w, f, last_st)
        if pv <= -2 && (0 - pv - 2) < w.nc {
            << f.consts[0 - pv - 2] >= min_k
        }
        << false
    }
    if target_b == 0 {
        << false
    }
    $vis := []bool{}
    for _ in 0:w.nb { vis.push(false) }
    $q := []int{}
    vis[target_b] = true
    q.push(target_b)
    $qh := 0
    while qh < q.len {
        cur := q[qh]
        qh += 1
        $pe := w.pred_head[cur]
        if pe < 0 {
            << false
        }
        while pe >= 0 {
            p := w.pred_from[pe]
            if p < 0 || p >= w.nb || w.rpo_idx[p] < 0 {
                pe = w.pred_next[pe]
                ->
            }
            if !gvn_edge_cond_proves_local_lb(w, f, p, cur, l, min_k) {
                $p_last := -1
                $pii := f.blocks[p].head
                while pii >= 0 {
                    pins := &f.instrs[pii]
                    if pins.kind == MI_STORE_LOCAL && pins.a == l {
                        p_last = pins.b
                    }
                    pii = pins.next
                }
                if p_last != -1 {
                    pv := gvn_peel_copy(w, f, p_last)
                    if !(pv <= -2 && (0 - pv - 2) < w.nc && f.consts[0 - pv - 2] >= min_k) {
                        << false
                    }
                } else {
                    if p == 0 {
                        << false
                    }
                    if !vis[p] {
                        if q.len >= 64 {
                            << false
                        }
                        vis[p] = true
                        q.push(p)
                    }
                }
            }
            pe = w.pred_next[pe]
        }
    }
    << true
}

fn gvn_branch_ub_proves_nowrap(w &GvnWork, f &MFn, par int, bi int, l int, base_t int, base_ii int, cop int, cc int, cd int, is_true bool, step_c int) bool {
    $cmp_x := -1
    $u_op := -1
    $strict := false
    $has_ub := false
    if is_true {
        if cop == BIN_LT {
            cmp_x = cc
            u_op = cd
            strict = true
            has_ub = true
        } else if cop == BIN_GT {
            cmp_x = cd
            u_op = cc
            strict = true
            has_ub = true
        } else if cop == BIN_LE {
            cmp_x = cc
            u_op = cd
            strict = false
            has_ub = true
        } else if cop == BIN_GE {
            cmp_x = cd
            u_op = cc
            strict = false
            has_ub = true
        }
    } else {
        if cop == BIN_GE {
            cmp_x = cc
            u_op = cd
            strict = true
            has_ub = true
        } else if cop == BIN_LE {
            cmp_x = cd
            u_op = cc
            strict = true
            has_ub = true
        } else if cop == BIN_GT {
            cmp_x = cc
            u_op = cd
            strict = false
            has_ub = true
        } else if cop == BIN_LT {
            cmp_x = cd
            u_op = cc
            strict = false
            has_ub = true
        }
    }
    if !has_ub { << false }
    $no_wrap := false
    if strict && step_c == 1 {
        no_wrap = true
    } else if u_op <= -2 && (0 - u_op - 2) < w.nc {
        uval := f.consts[0 - u_op - 2]
        if strict {
            no_wrap = uval <= 9223372036854775807 - (step_c - 1)
        } else {
            no_wrap = uval <= 9223372036854775807 - step_c
        }
    }
    if !no_wrap { << false }
    cmp_x = gvn_peel_copy(w, f, cmp_x)
    if cmp_x == base_t {
        << true
    }
    if cmp_x >= 0 && cmp_x < w.nt && w.tdef[cmp_x] >= 0 &&
       w.tdef_blk[cmp_x] == par && w.tdef_blk[base_t] == bi {
        cx_ii := w.tdef[cmp_x]
        cx_ins := &f.instrs[cx_ii]
        if cx_ins.kind == MI_LOAD_LOCAL && cx_ins.c == 0 && cx_ins.b == l &&
           gvn_no_store_on_path(w, f, par, cx_ii, bi, base_ii, l) {
            << true
        }
    }
    << false
}

fn gvn_val_nonneg_at_depth(w &GvnWork, f &MFn, bi int, l int, init_val int, store_ii int, depth int) bool {
    if depth > 4 {
        << false
    }
    $val := gvn_peel_copy(w, f, init_val)
    if val <= -2 {
        ci := 0 - val - 2
        << ci >= 0 && ci < w.nc && f.consts[ci] >= 0
    }
    if val < 0 || val >= w.nt || w.tdef[val] < 0 {
        << false
    }
    dii := w.tdef[val]
    dins := &f.instrs[dii]
    dk := dins.kind
    if dk == MI_LOAD_PTR && (dins.d == 1 || dins.d == 2 || dins.d == 4) {
        << true
    }
    if dk == MI_BIN && dins.b == BIN_AND {
        if (dins.c <= -2 && (0 - dins.c - 2) < w.nc && f.consts[0 - dins.c - 2] >= 0) ||
           (dins.d <= -2 && (0 - dins.d - 2) < w.nc && f.consts[0 - dins.d - 2] >= 0) {
            << true
        }
    }
    if dk == MI_BIN && dins.b == BIN_MOD {
        << gvn_val_nonneg_at_depth(w, f, bi, l, dins.c, -1, depth + 1)
    }
    if dk == MI_BIN && dins.b == BIN_DIV {
        << gvn_val_nonneg_at_depth(w, f, bi, l, dins.c, -1, depth + 1) &&
           gvn_val_nonneg_at_depth(w, f, bi, l, dins.d, -1, depth + 1)
    }
    if dk == MI_LOAD_LOCAL && dins.c == 0 && dins.b >= 0 && dins.b < w.nl && w.l_nonneg[dins.b] {
        << true
    }
    if dk == MI_SELECT {
        $c_ok := false
        $d_ok := false
        if dins.c <= -2 && (0 - dins.c - 2) < w.nc && f.consts[0 - dins.c - 2] >= 0 {
            c_ok = true
        } else if dins.c >= 0 && dins.c < w.nt && w.tdef[dins.c] >= 0 {
            td_c := w.tdef[dins.c]
            ci := &f.instrs[td_c]
            if ci.kind == MI_LOAD_LOCAL && ci.c == 0 && ci.b >= 0 && ci.b < w.nl && w.l_nonneg[ci.b] {
                c_ok = true
            }
        }
        if dins.d <= -2 && (0 - dins.d - 2) < w.nc && f.consts[0 - dins.d - 2] >= 0 {
            d_ok = true
        } else if dins.d >= 0 && dins.d < w.nt && w.tdef[dins.d] >= 0 {
            td_d := w.tdef[dins.d]
            di := &f.instrs[td_d]
            if di.kind == MI_LOAD_LOCAL && di.c == 0 && di.b >= 0 && di.b < w.nl && w.l_nonneg[di.b] {
                d_ok = true
            }
        }
        if c_ok && d_ok {
            << true
        }
    }
    if dk == MI_BIN && dins.b == BIN_SUB && dins.c >= 0 && dins.d <= -2 && (0 - dins.d - 2) < w.nc {
        step_c := f.consts[0 - dins.d - 2]
        if step_c >= 1 && step_c <= 1024 {
            base_t := gvn_peel_copy(w, f, dins.c)
            if base_t >= 0 && base_t < w.nt && w.tdef[base_t] >= 0 {
                base_ii := w.tdef[base_t]
                base_ins := &f.instrs[base_ii]
                is_self_l := base_ins.kind == MI_LOAD_LOCAL && base_ins.c == 0 && base_ins.b == l
                if is_self_l && store_ii >= 0 && gvn_local_at_least_at(w, f, bi, store_ii, l, step_c) {
                    << true
                }
                if w.tdef_blk[base_t] == bi {
                    $child := bi
                    for _ in 0:32 {
                        if child <= 0 || child >= w.nb { <- }
                        par := w.idom[child]
                        if par < 0 || par >= w.nb || par == child { <- }
                        if w.n_eff_preds[child] == 1 && f.blocks[par].tkind == TKIND_BRANCH && f.blocks[par].tb != f.blocks[par].tc {
                            cond := f.blocks[par].ta
                            if cond >= 0 && cond < w.nt && w.tdef[cond] >= 0 {
                                cond_ii := w.tdef[cond]
                                if f.instrs[cond_ii].kind == MI_BIN {
                                    cins := &f.instrs[cond_ii]
                                    is_true := child == f.blocks[par].tb
                                    $cx := -1
                                    if gvn_edge_proves_lb(f, cins.b, cins.c, cins.d, is_true, step_c, $&cx) {
                                        cx = gvn_peel_copy(w, f, cx)
                                        if cx == base_t {
                                            << true
                                        }
                                        if is_self_l && cx >= 0 && cx < w.nt && w.tdef[cx] >= 0 && w.tdef_blk[cx] == par {
                                            cx_ii := w.tdef[cx]
                                            cx_ins := &f.instrs[cx_ii]
                                            if cx_ins.kind == MI_LOAD_LOCAL && cx_ins.c == 0 && cx_ins.b == l &&
                                               gvn_no_store_on_path(w, f, par, cx_ii, bi, base_ii, l) {
                                                << true
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        child = par
                    }
                }
            }
        }
    }
    if dk == MI_BIN && dins.b == BIN_ADD {
        $base_t := -1
        $step_c := 0
        if dins.c >= 0 && dins.d <= -2 && (0 - dins.d - 2) < w.nc {
            base_t = dins.c
            step_c = f.consts[0 - dins.d - 2]
        } else if dins.d >= 0 && dins.c <= -2 && (0 - dins.c - 2) < w.nc {
            base_t = dins.d
            step_c = f.consts[0 - dins.c - 2]
        }
        if step_c >= 1 && step_c <= 1024 && base_t >= 0 {
            base_t = gvn_peel_copy(w, f, base_t)
            if base_t >= 0 && base_t < w.nt && w.tdef[base_t] >= 0 {
                base_ii := w.tdef[base_t]
                base_ins := &f.instrs[base_ii]
                if base_ins.kind == MI_LOAD_LOCAL && base_ins.c == 0 && base_ins.b == l {
                    $child := bi
                    for _ in 0:32 {
                        if child <= 0 || child >= w.nb { <- }
                        par := w.idom[child]
                        if par < 0 || par >= w.nb || par == child { <- }
                        if w.n_eff_preds[child] == 1 && f.blocks[par].tkind == TKIND_BRANCH && f.blocks[par].tb != f.blocks[par].tc {
                            cond := f.blocks[par].ta
                            if cond >= 0 && cond < w.nt && w.tdef[cond] >= 0 {
                                cond_ii := w.tdef[cond]
                                if f.instrs[cond_ii].kind == MI_BIN {
                                    cins := &f.instrs[cond_ii]
                                    cop := cins.b
                                    is_true := child == f.blocks[par].tb
                                    if !is_true && cop == BIN_OR {
                                        if cins.c >= 0 && cins.c < w.nt && w.tdef[cins.c] >= 0 {
                                            c1_ii := w.tdef[cins.c]
                                            if f.instrs[c1_ii].kind == MI_BIN {
                                                ci1 := &f.instrs[c1_ii]
                                                if gvn_branch_ub_proves_nowrap(w, f, par, bi, l, base_t, base_ii, ci1.b, ci1.c, ci1.d, false, step_c) {
                                                    << true
                                                }
                                            }
                                        }
                                        if cins.d >= 0 && cins.d < w.nt && w.tdef[cins.d] >= 0 {
                                            c2_ii := w.tdef[cins.d]
                                            if f.instrs[c2_ii].kind == MI_BIN {
                                                ci2 := &f.instrs[c2_ii]
                                                if gvn_branch_ub_proves_nowrap(w, f, par, bi, l, base_t, base_ii, ci2.b, ci2.c, ci2.d, false, step_c) {
                                                    << true
                                                }
                                            }
                                        }
                                    } else {
                                        if gvn_branch_ub_proves_nowrap(w, f, par, bi, l, base_t, base_ii, cop, cins.c, cins.d, is_true, step_c) {
                                            << true
                                        }
                                    }
                                }
                            }
                        }
                        child = par
                    }
                }
            }
        }
    }
    << false
}

fn gvn_val_nonneg_at(w &GvnWork, f &MFn, bi int, l int, init_val int) bool {
    << gvn_val_nonneg_at_depth(w, f, bi, l, init_val, -1, 0)
}

fn gvn_compute_nonneg_locals(w $&GvnWork, f &MFn, reachable int) {
    gvn_fill_bool($&w.l_nonneg, w.nl, false)
    $any_cand := false
    for l in f.nparams:w.nl {
        if l >= 0 && l < w.nl && w.l_cand[l] && w.l_stores[l] > 0 {
            w.l_nonneg[l] = true
            any_cand = true
        }
    }
    if !any_cand {
        <<
    }
    for _ in 0:8 {
        $shrunk := false
        for ri in 0:reachable {
            bi := w.rpo[ri]
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < w.nl && w.l_nonneg[ins.a] {
                    if !gvn_val_nonneg_at_depth(w, f, bi, ins.a, ins.b, ii, 0) {
                        w.l_nonneg[ins.a] = false
                        shrunk = true
                    }
                }
                ii = ins.next
            }
        }
        if !shrunk {
            <-
        }
    }
}

fn gvn_val_ub_at(w &GvnWork, f &MFn, bi int, l int, init_val int, grounded &[]bool, out_ub $&int) bool {
    $cur := init_val
    for _ in 0:6 {
        if cur <= -2 {
            ci := 0 - cur - 2
            if ci >= 0 && ci < f.consts.len {
                *out_ub = f.consts[ci]
                << true
            }
            << false
        }
        if cur < 0 || cur >= w.nt || w.ndef[cur] != 1 || w.tdef_blk[cur] != bi {
            << false
        }
        di := w.tdef[cur]
        dins := &f.instrs[di]
        dk := dins.kind
        if dk == MI_COPY {
            cur = dins.b
            ->
        }
        if dk == MI_LOAD_LOCAL && dins.c == 0 && dins.b >= 0 && dins.b < w.nl && w.l_has_ub[dins.b] && grounded[dins.b] {
            *out_ub = w.l_ub[dins.b]
            << true
        }
        if dk == MI_LOAD_PTR && gvn_norm_width(dins.d) == 1 {
            *out_ub = 255
            << true
        }
        if dk == MI_BIN {
            if dins.b == BIN_AND {
                if dins.d <= -2 && (0 - dins.d - 2) < f.consts.len && f.consts[0 - dins.d - 2] >= 0 {
                    *out_ub = f.consts[0 - dins.d - 2]
                    << true
                }
                if dins.c <= -2 && (0 - dins.c - 2) < f.consts.len && f.consts[0 - dins.c - 2] >= 0 {
                    *out_ub = f.consts[0 - dins.c - 2]
                    << true
                }
            } else if dins.b == BIN_SHR && dins.d <= -2 && (0 - dins.d - 2) < f.consts.len {
                sh := f.consts[0 - dins.d - 2]
                if sh >= 0 && sh <= 63 && gvn_val_nonneg_at(w, f, bi, l, dins.c) {
                    $sub_u := 0
                    if gvn_val_ub_at(w, f, bi, l, dins.c, grounded, $&sub_u) && sub_u >= 0 {
                        *out_ub = sub_u >> sh
                        << true
                    }
                    *out_ub = 9223372036854775807 >> sh
                    << true
                }
            }
        }
        if dk == MI_SELECT {
            $uc := 0
            $ud := 0
            if gvn_val_ub_at(w, f, bi, l, dins.c, grounded, $&uc) &&
               gvn_val_ub_at(w, f, bi, l, dins.d, grounded, $&ud) {
                if ud > uc { uc = ud }
                *out_ub = uc
                << true
            }
        }
        << false
    }
    << false
}

fn gvn_compute_ub_locals(w $&GvnWork, f &MFn, reachable int) {
    gvn_fill_bool($&w.l_has_ub, w.nl, false)
    gvn_fill_int($&w.l_ub, w.nl, 0)
    $cand := []bool{}
    $grounded := []bool{}
    for _ in 0:w.nl {
        cand.push(false)
        grounded.push(false)
    }
    $has_any := false
    for l in f.nparams:w.nl {
        if l >= 0 && l < w.nl && w.l_cand[l] && w.l_stores[l] > 0 {
            w.l_has_ub[l] = true
            cand[l] = true
            has_any = true
        }
    }
    if !has_any { << }
    $seen := []bool{}
    $pass_ub := []int{}
    for _ in 0:w.nl {
        seen.push(false)
        pass_ub.push(0)
    }
    for _ in 0:8 {
        for l in 0:w.nl {
            seen[l] = false
            pass_ub[l] = 0
        }
        for ri in 0:reachable {
            bi := w.rpo[ri]
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < w.nl && cand[ins.a] {
                    $su := 0
                    if !gvn_val_ub_at(w, f, bi, ins.a, ins.b, &grounded, $&su) {
                        cand[ins.a] = false
                        w.l_has_ub[ins.a] = false
                    } else if !seen[ins.a] {
                        seen[ins.a] = true
                        pass_ub[ins.a] = su
                    } else if su > pass_ub[ins.a] {
                        pass_ub[ins.a] = su
                    }
                }
                ii = ins.next
            }
        }
        $changed := false
        for l in f.nparams:w.nl {
            if !cand[l] { -> }
            if !seen[l] {
                cand[l] = false
                w.l_has_ub[l] = false
            } else if !grounded[l] || pass_ub[l] > w.l_ub[l] {
                grounded[l] = true
                w.l_ub[l] = pass_ub[l]
                changed = true
            }
        }
        if !changed { <- }
    }
    for l in f.nparams:w.nl {
        if !cand[l] || !grounded[l] {
            w.l_has_ub[l] = false
        }
    }
}

pub fn opt_gvn_with(f $&MFn, w $&GvnWork) bool {
    nb := f.blocks.len
    nt := f.temps.len
    nl := f.locals.len
    if nb == 0 || nb > GVN_MAX_BLOCKS || f.instrs.len > GVN_MAX_INSTRS || f.instrs.len < 4 {
        << false
    }
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            << false
        }
    }

    w.nb = nb
    w.nt = nt
    w.nl = nl
    w.nc = f.consts.len
    w.vid_top = 0
    w.pred_top = 0
    w.const_zero = -1
    w.const_one = -1
    w.const_255 = -1
    w.t_top = 0
    w.vrep_top = 0
    w.buf_top = 0
    w.sd_top = 0
    w.sl_top = 0
    w.struct_sl_top = 0
    w.loc_top = 0
    w.expr_top = 0
    w.hdr_top = 0
    w.exact_top = 0
    w.gen_epoch = 0
    w.elem_epoch = 0
    w.exact_epoch = 0
    w.nn_top = 0
    w.lt_top = 0
    w.le_top = 0
    w.neq_top = 0
    w.dfs_top = 0
    w.changed = false

    gvn_fill_bool($&w.is_panic, nb, false)
    gvn_fill_bool($&w.in_dom, nb, false)
    gvn_fill_int($&w.dom_first, nb, -1)
    gvn_fill_int($&w.loc_region_mark, nb, 0)
    gvn_fill_int($&w.loc_clobber_gen, nl, 0)
    w.loc_region_gen = 0

    $has_multi_pred := false
    $reachable := 1
    if nb == 1 {
        gvn_fill_int($&w.rpo_idx, 1, 0)
        gvn_fill_int($&w.n_eff_preds, 1, 0)
        gvn_ensure_int($&w.rpo, 1, 0)
        w.rpo[0] = 0
    } else {
        for bi in 1:nb {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                if f.instrs[ii].kind == MI_CALL && gvn_is_noreturn(&f.instrs[ii].sval) {
                    w.is_panic[bi] = true
                    <-
                }
                ii = f.instrs[ii].next
            }
        }

        // RPO over reachable effective CFG (pruning edges out of panic blocks).
        gvn_fill_bool($&w.seen, nb, false)
        gvn_fill_int($&w.next_i, nb, 0)
        gvn_fill_int($&w.rpo_idx, nb, -1)
        gvn_fill_int($&w.pred_head, nb, -1)
        gvn_fill_int($&w.n_eff_preds, nb, 0)
        gvn_fill_int($&w.idom, nb, -1)
        gvn_fill_int($&w.dom_last, nb, -1)
        gvn_fill_int($&w.dom_next, nb, -1)
        gvn_ensure_int($&w.stack, nb, 0)
        gvn_ensure_int($&w.post, nb, 0)
        gvn_ensure_int($&w.rpo, nb, 0)

        w.stack[0] = 0
        $sp := 1
        $post_top := 0
        w.seen[0] = true
        while sp > 0 {
            b := w.stack[sp - 1]
            $s0 := -1
            $s1 := -1
            $ns := 0
            if !w.is_panic[b] {
                tk := f.blocks[b].tkind
                if tk == TKIND_JUMP {
                    s := f.blocks[b].ta
                    if s >= 0 && s < nb {
                        s0 = s
                        ns = 1
                    }
                } else if tk == TKIND_BRANCH {
                    tb := f.blocks[b].tb
                    tc := f.blocks[b].tc
                    if tb >= 0 && tb < nb {
                        s0 = tb
                        ns = 1
                    }
                    if tc >= 0 && tc < nb && tc != tb {
                        if ns == 0 { s0 = tc } else { s1 = tc }
                        ns += 1
                    }
                }
            }
            if w.next_i[b] < ns {
                $s := s0
                if w.next_i[b] == 1 { s = s1 }
                w.next_i[b] = w.next_i[b] + 1
                if !w.seen[s] {
                    w.seen[s] = true
                    w.stack[sp] = s
                    sp += 1
                }
            } else {
                w.post[post_top] = b
                post_top += 1
                sp -= 1
            }
        }

        nr := post_top
        if nr == 0 {
            << false
        }
        reachable = nr
        for ri in 0:nr {
            b := w.post[nr - 1 - ri]
            w.rpo[ri] = b
            w.rpo_idx[b] = ri
        }

        for ri in 0:nr {
            b := w.rpo[ri]
            if w.is_panic[b] { -> }
            tk := f.blocks[b].tkind
            if tk == TKIND_JUMP {
                s := f.blocks[b].ta
                if s >= 0 && s < nb && w.rpo_idx[s] >= 0 {
                    gvn_add_pred(w, b, s)
                    if w.n_eff_preds[s] > 1 { has_multi_pred = true }
                }
            } else if tk == TKIND_BRANCH {
                tb := f.blocks[b].tb
                tc := f.blocks[b].tc
                if tb >= 0 && tb < nb && w.rpo_idx[tb] >= 0 {
                    gvn_add_pred(w, b, tb)
                    if w.n_eff_preds[tb] > 1 { has_multi_pred = true }
                }
                if tc >= 0 && tc < nb && tc != tb && w.rpo_idx[tc] >= 0 {
                    gvn_add_pred(w, b, tc)
                    if w.n_eff_preds[tc] > 1 { has_multi_pred = true }
                }
            }
        }

        w.idom[0] = 0
        if !has_multi_pred {
            for ri in 1:nr {
                b := w.rpo[ri]
                pi := w.pred_head[b]
                if pi >= 0 {
                    w.idom[b] = w.pred_from[pi]
                }
            }
        } else {
            $dom_changed := true
            while dom_changed {
                dom_changed = false
                for ri in 1:nr {
                    b := w.rpo[ri]
                    $new_idom := -1
                    $pi := w.pred_head[b]
                    while pi >= 0 {
                        p := w.pred_from[pi]
                        if w.idom[p] != -1 {
                            if new_idom == -1 {
                                new_idom = p
                            } else {
                                new_idom = gvn_intersect(&w.idom, &w.rpo_idx, p, new_idom)
                            }
                        }
                        pi = w.pred_next[pi]
                    }
                    if new_idom != -1 && w.idom[b] != new_idom {
                        w.idom[b] = new_idom
                        dom_changed = true
                    }
                }
            }
        }

        for ri in 1:nr {
            b := w.rpo[ri]
            p := w.idom[b]
            if p >= 0 && p < nb && !w.is_panic[b] {
                if w.dom_first[p] < 0 {
                    w.dom_first[p] = b
                } else {
                    w.dom_next[w.dom_last[p]] = b
                }
                w.dom_last[p] = b
            }
        }
    }

    // Scalar local metadata and single-def SSA info.
    gvn_fill_int($&w.ndef, nt, 0)
    gvn_fill_int($&w.tdef, nt, -1)
    gvn_fill_int($&w.tdef_blk, nt, -1)
    gvn_fill_int($&w.temp_vn, nt, -1)
    gvn_fill_int($&w.buf_owner, nt, -1)
    gvn_fill_int($&w.buf_owner_off, nt, 0)

    gvn_fill_bool($&w.l_cand, nl, true)
    n_nslots := f.locals_nslots.len
    $lim_l := nl
    if n_nslots < lim_l { lim_l = n_nslots }
    for l in 0:lim_l {
        if f.locals_nslots[l] != 1 {
            w.l_cand[l] = false
        }
    }
    gvn_fill_int($&w.l_stores, nl, 0)
    gvn_fill_int($&w.l_store_blk, nl, -1)
    gvn_fill_int($&w.local_vid, nl, -1)
    gvn_fill_int($&w.local_blk, nl, -1)

    for bi in 0:nb {
        if w.rpo_idx[bi] < 0 { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                w.ndef[ins.a] = w.ndef[ins.a] + 1
                w.tdef[ins.a] = ii
                w.tdef_blk[ins.a] = bi
            }
            if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                w.l_cand[ins.b] = false
            } else if k == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && ins.c != 0 {
                w.l_cand[ins.b] = false
            } else if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                if ins.c != 0 {
                    w.l_cand[ins.a] = false
                } else {
                    w.l_stores[ins.a] = w.l_stores[ins.a] + 1
                    w.l_store_blk[ins.a] = bi
                }
            }
            ii = ins.next
        }
    }
    for t in 0:nt {
        if w.ndef[t] != 1 {
            w.tdef[t] = -1
            w.tdef_blk[t] = -1
        }
    }
    gvn_compute_nonneg_locals(w, f, reachable)
    gvn_compute_ub_locals(w, f, reachable)
    if has_multi_pred {
        gvn_prepare_memory_joins(w, f, reachable)
    }
    gvn_collect_struct_slices_all(f, &w.tdef, &w.rpo_idx, false, true, $&w.struct_sl_kind, $&w.struct_sl_id, $&w.struct_sl_off, $&w.struct_sl_top)

    nc := w.nc
    gvn_ensure_int($&w.const_canon, nc, 0)
    if nc <= 16 {
        for ci in 0:nc {
            v := f.consts[ci]
            $canon := 0 - ci - 2
            for cj in 0:ci {
                if f.consts[cj] == v {
                    canon = 0 - cj - 2
                    <-
                }
            }
            w.const_canon[ci] = canon
            if v == 0 && w.const_zero > -2 {
                w.const_zero = canon
            }
            if v == 1 && w.const_one > -2 {
                w.const_one = canon
            }
        }
    } else {
        w.const_gen = w.const_gen + 1
        gen := w.const_gen
        for ci in 0:nc {
            v := f.consts[ci]
            $canon := 0 - ci - 2
            $h := (v ^ (v >> 32)) * 2654435761
            $slot := h & GVN_CONST_MASK
            $probe := 0
            while probe < 64 {
                if w.const_ht_gen[slot] != gen {
                    w.const_ht_gen[slot] = gen
                    w.const_ht_val[slot] = v
                    w.const_ht_canon[slot] = canon
                    <-
                }
                if w.const_ht_val[slot] == v {
                    canon = w.const_ht_canon[slot]
                    <-
                }
                slot = (slot + 1) & GVN_CONST_MASK
                probe += 1
            }
            w.const_canon[ci] = canon
            if v == 0 && w.const_zero > -2 {
                w.const_zero = canon
            }
            if v == 1 && w.const_one > -2 {
                w.const_one = canon
            }
        }
    }

    $bmask := 63
    if f.instrs.len > 32 { bmask = 255 }
    if f.instrs.len > 128 { bmask = 1023 }
    w.bucket_mask = bmask

    gvn_dfs(w, f, 0)
    << w.changed
}

pub fn opt_gvn(f $&MFn) bool {
    $w := gvn_work_new()
    << opt_gvn_with(f, $&w)
}
