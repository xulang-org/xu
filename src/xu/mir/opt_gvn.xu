            $has_sloc := false
            $sloc := GvnLocation{base_vid: -1, off: 0}
            $s_slot := -1
            $s_param := -1
            if pvid != -1 {
                has_sloc = true
                sloc = gvn_location(w, f, pvid, ic)
                s_slot = gvn_frame_slot(w, f, &sloc, nw)
                if s_slot < 0 { s_param = gvn_param_of_vid(w, f, sloc.base_vid) }
