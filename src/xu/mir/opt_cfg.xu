@xu/mir

#strings
// Control Flow Graph (CFG) Simplification and Jump Threading pass.
//
// Layer 3 module: eliminates redundant trampoline blocks, collapses identical
// branch targets, prunes unreachable control flow graphs, and performs
// Cold Block Out-of-Line Reordering & Profile-Guided Trace Scheduling.

fn is_empty_block(mfn &MFn, bi int) bool {
    if bi < 0 || bi >= mfn.blocks.len {
        << false
    }
    if mfn.blocks[bi].head < 0 {
        << true
    }
    $ii := mfn.blocks[bi].head
    while ii >= 0 && ii < mfn.instrs.len {
        if mfn.instrs[ii].kind != MI_NOP {
            << false
        }
        if ii == mfn.blocks[bi].tail {
            <-
        }
        ii = mfn.instrs[ii].next
    }
    << true
}

fn resolve_trampoline(mfn &MFn, target int) int {
    $cur := target
    for _ in 0:16 {
        if cur >= 0 && cur < mfn.blocks.len {
            if mfn.blocks[cur].tkind == TKIND_JUMP {
                if is_empty_block(mfn, cur) {
                    next_t := mfn.blocks[cur].ta
                    if next_t >= 0 && next_t != cur {
                        cur = next_t
                        ->
                    }
                }
            }
        }
        << cur
    }
    << cur
}

fn fuse_plain(mfn $&MFn) bool {
    $any_fused := false
    for _ in 0:16 {
        $changed := false
        in_deg := compute_in_degrees(mfn)

        for bi in 0:mfn.blocks.len {
            if mfn.blocks[bi].tkind == TKIND_JUMP {
                target_bb := mfn.blocks[bi].ta
                // Requirements:
                // 1. target_bb is valid and not entry block (0)
                // 2. target_bb is not self (bi)
                // 3. target_bb has strictly only one predecessor (in_deg == 1)
                if target_bb > 0 && target_bb < mfn.blocks.len && target_bb != bi {
                    if in_deg[target_bb] == 1 {
                        // Merge target_bb's instructions into bi
                        if mfn.blocks[bi].head < 0 {
                            mfn.blocks[bi].head = mfn.blocks[target_bb].head
                            mfn.blocks[bi].tail = mfn.blocks[target_bb].tail
                        } else if mfn.blocks[target_bb].head >= 0 {
                            mfn.instrs[mfn.blocks[bi].tail].next = mfn.blocks[target_bb].head
                            mfn.blocks[bi].tail = mfn.blocks[target_bb].tail
                        }

                        // bi adopts target_bb's control terminator
                        mfn.blocks[bi].tkind = mfn.blocks[target_bb].tkind
                        mfn.blocks[bi].ta = mfn.blocks[target_bb].ta
                        mfn.blocks[bi].tb = mfn.blocks[target_bb].tb
                        mfn.blocks[bi].tc = mfn.blocks[target_bb].tc

                        // Clear target_bb to avoid dangling references
                        mfn.blocks[target_bb].head = -1
                        mfn.blocks[target_bb].tail = -1
                        mfn.blocks[target_bb].tkind = TKIND_OPEN
                        mfn.blocks[target_bb].ta = -1
                        mfn.blocks[target_bb].tb = -1
                        mfn.blocks[target_bb].tc = -1

                        changed = true
                        any_fused = true
                    }
                }
            }
        }

        if !changed {
            <-
        }
    }
    << any_fused
}

fn is_cold_instruction(ins &MInstr) bool {
    if ins.kind == MI_CALL {
        if ins.sval == "_xu_runtime_core_rt_panic" ||
           ins.sval == "_xu_runtime_core_iface_tag_panic" ||
           ins.sval == "panic" ||
           ins.sval == "rt_panic" {
            << true
        }
    }
    if ins.kind == MI_THROW_UNWRAP || ins.kind == MI_THROW_UNWRAP_ERR {
        << true
    }
    << false
}

fn compute_cold_blocks(mfn &MFn, in_deg &[]int) []bool {
    $cold := []bool{}
    for _ in 0:mfn.blocks.len {
        cold.push(false)
    }
    if mfn.blocks.len <= 1 {
        << cold
    }

    // Pass 1: Mark intrinsically cold blocks (panic calls, unwrap aborts, unreferenced/empty)
    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].head < 0 {
            cold[bi] = true
            ->
        }
        $ii := mfn.blocks[bi].head
        while ii >= 0 && ii < mfn.instrs.len {
            if is_cold_instruction(&mfn.instrs[ii]) {
                cold[bi] = true
                <-
            }
            if ii == mfn.blocks[bi].tail {
                <-
            }
            ii = mfn.instrs[ii].next
        }
    }

    // Pass 2: Mark error propagation returns
    // In lower_err.xu, an error branch does: branch(e, prop_b, cont_b); prop_b: ret e.
    // If a block tb ends in TKIND_RETURN and returns the tested error condition e, mark tb cold.
    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].tkind == TKIND_BRANCH {
            cond := mfn.blocks[bi].ta
            tb := mfn.blocks[bi].tb
            if tb > 0 && tb < mfn.blocks.len {
                if mfn.blocks[tb].tkind == TKIND_RETURN {
                    if cond >= 0 && mfn.blocks[tb].ta == cond {
                        cold[tb] = true
                    } else {
                        $has_work := false
                        $ii := mfn.blocks[tb].head
                        while ii >= 0 && ii < mfn.instrs.len {
                            if mfn.instrs[ii].kind != MI_NOP {
                                has_work = true
                                <-
                            }
                            if ii == mfn.blocks[tb].tail {
                                <-
                            }
                            ii = mfn.instrs[ii].next
                        }
                        if !has_work {
                            cold[tb] = true
                        }
                    }
                }
            }
        }
    }

    // Pass 3: Propagate coldness forward.
    // If all predecessors of a block are cold, it is cold.
    $cold_pred_cnt := []int{}
    for _ in 0:mfn.blocks.len {
        cold_pred_cnt.push(0)
    }
    for bi in 0:mfn.blocks.len {
        if cold[bi] {
            tk := mfn.blocks[bi].tkind
            if tk == TKIND_JUMP && mfn.blocks[bi].ta >= 0 && mfn.blocks[bi].ta < mfn.blocks.len {
                cold_pred_cnt[mfn.blocks[bi].ta] += 1
            } else if tk == TKIND_BRANCH {
                if mfn.blocks[bi].tb >= 0 && mfn.blocks[bi].tb < mfn.blocks.len {
                    cold_pred_cnt[mfn.blocks[bi].tb] += 1
                }
                if mfn.blocks[bi].tc >= 0 && mfn.blocks[bi].tc < mfn.blocks.len {
                    cold_pred_cnt[mfn.blocks[bi].tc] += 1
                }
            }
        }
    }
    for bi in 1:mfn.blocks.len {
        if !cold[bi] && in_deg[bi] > 0 && cold_pred_cnt[bi] == in_deg[bi] {
            cold[bi] = true
        }
    }

    // Entry block is never cold
    cold[0] = false
    << cold
}

pub fn reorder_blocks_out_of_line(mfn $&MFn, pgo_counts &[]int) {
    $empty := []int{}
    layout_blocks(mfn, pgo_counts, &empty, &empty)
}

// Encode the pre-layout topology in block order. Branch pairs in an edge
// profile follow this same order, with the true successor first.
pub fn pgo_cfg_key(f &MFn) string {
    $parts := []string{}
    for b in &f.blocks {
        if b.tkind == TKIND_BRANCH {
            parts.push("b" + str(b.tb) + "." + str(b.tc))
        } else if b.tkind == TKIND_JUMP {
            parts.push("j" + str(b.ta))
        } else if b.tkind == TKIND_RETURN {
            parts.push("r")
        } else {
            parts.push("o")
        }
    }
    << strings.join(~parts, "-")
}

pub fn layout_edge_profile(f $&MFn, values &[]int) bool {
    $taken := []int{}
    $other := []int{}
    $i := 0
    for b in &f.blocks {
        if b.tkind == TKIND_BRANCH {
            if i + 1 >= values.len { << false }
            taken.push(values[i])
            other.push(values[i + 1])
            i += 2
        } else {
            taken.push(0)
            other.push(0)
        }
    }
    if i != values.len { << false }
    $empty := []int{}
    layout_blocks(f, &empty, &taken, &other)
    << true
}

struct LoopRotInfo {
    header int
    body_entry int
    latch int
    exit_blk int
    loop_idx int
}

fn find_rotatable_loops(mfn &MFn, loops &[]LoopInfo, cold &[]bool) []LoopRotInfo {
    $res := []LoopRotInfo{}
    for li in 0:loops.len {
        h := loops[li].header
        if h <= 0 || h >= mfn.blocks.len { -> }
        hb := ~mfn.blocks[h]
        if hb.tkind != TKIND_BRANCH { -> }
        tb := hb.tb
        tc := hb.tc
        $body_entry := -1
        $exit_blk := -1
        if tb >= 0 && tb < mfn.blocks.len && tc >= 0 && tc < mfn.blocks.len {
            if loops[li].body[tb] && !loops[li].body[tc] {
                body_entry = tb
                exit_blk = tc
            } else if loops[li].body[tc] && !loops[li].body[tb] {
                body_entry = tc
                exit_blk = tb
            }
        }
        if body_entry < 0 || exit_blk < 0 || cold[body_entry] || cold[exit_blk] {
            ->
        }
        $latch := -1
        $latch_cnt := 0
        for bi in 0:loops[li].blocks.len {
            b := loops[li].blocks[bi]
            if b != h && b >= 0 && b < mfn.blocks.len {
                if mfn.blocks[b].tkind == TKIND_JUMP && mfn.blocks[b].ta == h {
                    latch = b
                    latch_cnt += 1
                }
            }
        }
        if latch_cnt != 1 || latch < 0 || cold[latch] {
            ->
        }
        res.push(LoopRotInfo{header: h, body_entry: body_entry, latch: latch, exit_blk: exit_blk, loop_idx: li})
    }
    << res
}

fn cfg_block_size(mfn &MFn, bi int) int {
    $cnt := 0
    $ii := mfn.blocks[bi].head
    while ii >= 0 && ii < mfn.instrs.len {
        if mfn.instrs[ii].kind != MI_NOP {
            cnt += 1
        }
        if ii == mfn.blocks[bi].tail { <- }
        ii = mfn.instrs[ii].next
    }
    sz := cnt * 4
    if sz < 4 { << 4 }
    << sz
}

fn cfg_blk_depth(loops &[]LoopInfo, n int) []int {
    $d := []int{}
    for _ in 0:n { d.push(0) }
    for li in 0:loops.len {
        for bi in 0:loops[li].blocks.len {
            b := loops[li].blocks[bi]
            if b >= 0 && b < n && d[b] < 6 {
                d[b] = d[b] + 1
            }
        }
    }
    << d
}

fn cfg_exttsp_hot_order(mfn &MFn, hot_list &[]int, cold &[]bool, is_hot &[]bool, w_ta &[]int, w_tb &[]int, w_tc &[]int, blk_sz &[]int, latch_rot &[]int, rot_loops &[]LoopRotInfo) []int {
    n := mfn.blocks.len
    nh := hot_list.len
    if nh <= 1 {
        << ~hot_list
    }
    // Map hot block id -> compact index 0..nh-1; initialize one chain per hot block.
    $blk_to_chain := []int{}
    for _ in 0:n { blk_to_chain.push(-1) }
    $chain_head := []int{}
    $chain_tail := []int{}
    $chain_sz := []int{}
    $chain_alive := []bool{}
    $chain_has0 := []bool{}
    $next_in_chain := []int{}
    $blk_offset := []int{}
    for i in 0:n {
        next_in_chain.push(-1)
        blk_offset.push(0)
    }
    for hi in 0:nh {
        b := hot_list[hi]
        blk_to_chain[b] = hi
        chain_head.push(b)
        chain_tail.push(b)
        chain_sz.push(blk_sz[b])
        chain_alive.push(true)
        chain_has0.push(b == 0)
    }

    // Build incoming edge list per hot block for fast cross-chain Ext-TSP scoring.
    $in_src := []int{}
    $in_w := []int{}
    $in_head := []int{}
    $in_cnt := []int{}
    for _ in 0:n {
        in_head.push(0)
        in_cnt.push(0)
    }
    for hi in 0:nh {
        u := hot_list[hi]
        tk := mfn.blocks[u].tkind
        if tk == TKIND_JUMP {
            v := mfn.blocks[u].ta
            if v >= 0 && v < n && is_hot[v] && u != v { in_cnt[v] = in_cnt[v] + 1 }
        } else if tk == TKIND_BRANCH {
            vb := mfn.blocks[u].tb
            vc := mfn.blocks[u].tc
            if vb >= 0 && vb < n && is_hot[vb] && u != vb { in_cnt[vb] = in_cnt[vb] + 1 }
            if vc >= 0 && vc < n && is_hot[vc] && u != vc && vc != vb { in_cnt[vc] = in_cnt[vc] + 1 }
        }
    }
    $tot_e := 0
    $in_pos := []int{}
    for b in 0:n {
        in_head[b] = tot_e
        in_pos.push(tot_e)
        tot_e += in_cnt[b]
    }
    in_head.push(tot_e)
    for _ in 0:tot_e {
        in_src.push(-1)
        in_w.push(0)
    }
    for hi in 0:nh {
        u := hot_list[hi]
        tk := mfn.blocks[u].tkind
        if tk == TKIND_JUMP {
            v := mfn.blocks[u].ta
            if v >= 0 && v < n && is_hot[v] && u != v {
                p := in_pos[v]
                in_src[p] = u
                in_w[p] = w_ta[u]
                in_pos[v] = p + 1
            }
        } else if tk == TKIND_BRANCH {
            vb := mfn.blocks[u].tb
            vc := mfn.blocks[u].tc
            if vb >= 0 && vb < n && is_hot[vb] && u != vb {
                p := in_pos[vb]
                in_src[p] = u
                in_w[p] = w_tb[u]
                in_pos[vb] = p + 1
            }
            if vc >= 0 && vc < n && is_hot[vc] && u != vc && vc != vb {
                p := in_pos[vc]
                in_src[p] = u
                in_w[p] = w_tc[u]
                in_pos[vc] = p + 1
            }
        }
    }

    // Greedy Ext-TSP chain merging: repeatedly merge (c1, c2) with max Ext-TSP gain.
    $merges := 0
    while merges < nh - 1 {
        $best_gain := 0
        $best_c1 := -1
        $best_c2 := -1
        for c1 in 0:nh {
            if !chain_alive[c1] { -> }
            tail1 := chain_tail[c1]
            s1 := chain_sz[c1]
            tk1 := mfn.blocks[tail1].tkind
            // Candidate partner chains c2 are targets of tail1 plus hot blocks linked out of c1.
            $cands := []int{}
            if tk1 == TKIND_JUMP {
                v := mfn.blocks[tail1].ta
                if v >= 0 && v < n && is_hot[v] {
                    c2 := blk_to_chain[v]
                    if c2 >= 0 && c2 != c1 && chain_alive[c2] && !chain_has0[c2] && chain_head[c2] == v {
                        cands.push(c2)
                    }
                }
            } else if tk1 == TKIND_BRANCH {
                vb := mfn.blocks[tail1].tb
                vc := mfn.blocks[tail1].tc
                if vb >= 0 && vb < n && is_hot[vb] {
                    c2 := blk_to_chain[vb]
                    if c2 >= 0 && c2 != c1 && chain_alive[c2] && !chain_has0[c2] && chain_head[c2] == vb {
                        cands.push(c2)
                    }
                }
                if vc >= 0 && vc < n && is_hot[vc] {
                    c2 := blk_to_chain[vc]
                    if c2 >= 0 && c2 != c1 && chain_alive[c2] && !chain_has0[c2] && chain_head[c2] == vc {
                        $dup := false
                        for ci in 0:cands.len {
                            if cands[ci] == c2 { dup = true }
                        }
                        if !dup { cands.push(c2) }
                    }
                }
            }
            if cands.len == 0 {
                // Also evaluate blocks in c1 whose outgoing edge jumps to head of another chain.
                $u := chain_head[c1]
                while u >= 0 {
                    utk := mfn.blocks[u].tkind
                    $t1 := -1
                    $t2 := -1
                    if utk == TKIND_JUMP { t1 = mfn.blocks[u].ta }
                    else if utk == TKIND_BRANCH {
                        t1 = mfn.blocks[u].tb
                        t2 = mfn.blocks[u].tc
                    }
                    for pass in 0:2 {
                        $tv := t1
                        if pass == 1 { tv = t2 }
                        if tv >= 0 && tv < n && is_hot[tv] {
                            c2 := blk_to_chain[tv]
                            if c2 >= 0 && c2 != c1 && chain_alive[c2] && !chain_has0[c2] && cands.len < 8 {
                                $dup := false
                                for ci in 0:cands.len {
                                    if cands[ci] == c2 { dup = true }
                                }
                                if !dup { cands.push(c2) }
                            }
                        }
                    }
                    u = next_in_chain[u]
                }
            }
            for ci in 0:cands.len {
                c2 := cands[ci]
                $gain := 0
                head2 := chain_head[c2]
                // 1. Direct fallthrough bonus (tail1 -> head2).
                if tk1 == TKIND_JUMP && mfn.blocks[tail1].ta == head2 {
                    $ft := w_ta[tail1] * 10
                    if latch_rot[tail1] >= 0 && rot_loops[latch_rot[tail1]].header == head2 {
                        ft = ft * 2
                    }
                    gain += ft
                } else if tk1 == TKIND_BRANCH {
                    if mfn.blocks[tail1].tb == head2 {
                        gain += w_tb[tail1] * 8
                    } else if mfn.blocks[tail1].tc == head2 {
                        gain += w_tc[tail1] * 8
                    }
                }
                // 2. Ext-TSP forward & backward proximity locality over edges crossing c1 <-> c2.
                $u := chain_head[c1]
                while u >= 0 {
                    utk := mfn.blocks[u].tkind
                    if utk == TKIND_JUMP {
                        v := mfn.blocks[u].ta
                        if v >= 0 && v < n && blk_to_chain[v] == c2 {
                            dist := (s1 - blk_offset[u] - blk_sz[u]) + blk_offset[v]
                            if dist <= 1024 {
                                gain += (w_ta[u] * (1024 - dist)) / 1024
                            }
                        }
                    } else if utk == TKIND_BRANCH {
                        vb := mfn.blocks[u].tb
                        if vb >= 0 && vb < n && blk_to_chain[vb] == c2 {
                            dist := (s1 - blk_offset[u] - blk_sz[u]) + blk_offset[vb]
                            if dist <= 1024 {
                                gain += (w_tb[u] * (1024 - dist)) / 1024
                            }
                        }
                        vc := mfn.blocks[u].tc
                        if vc >= 0 && vc < n && blk_to_chain[vc] == c2 && vc != vb {
                            dist := (s1 - blk_offset[u] - blk_sz[u]) + blk_offset[vc]
                            if dist <= 1024 {
                                gain += (w_tc[u] * (1024 - dist)) / 1024
                            }
                        }
                    }
                    u = next_in_chain[u]
                }
                $v2 := chain_head[c2]
                while v2 >= 0 {
                    ps := in_head[v2]
                    pe := in_head[v2 + 1]
                    for pj in ps:pe {
                        src := in_src[pj]
                        if src >= 0 && blk_to_chain[src] == c1 {
                            dist := (s1 - blk_offset[src] - blk_sz[src]) + blk_offset[v2]
                            if dist <= 640 {
                                gain += (in_w[pj] * (640 - dist)) / 1280
                            }
                        }
                    }
                    // Also score backward jumps c2 -> c1 within BWD_MAX = 640.
                    v2tk := mfn.blocks[v2].tkind
                    if v2tk == TKIND_JUMP {
                        tgt := mfn.blocks[v2].ta
                        if tgt >= 0 && tgt < n && blk_to_chain[tgt] == c1 {
                            dist := (s1 + blk_offset[v2] + blk_sz[v2]) - blk_offset[tgt]
                            if dist <= 640 {
                                gain += (w_ta[v2] * (640 - dist)) / 1280
                            }
                        }
                    } else if v2tk == TKIND_BRANCH {
                        tb := mfn.blocks[v2].tb
                        if tb >= 0 && tb < n && blk_to_chain[tb] == c1 {
                            dist := (s1 + blk_offset[v2] + blk_sz[v2]) - blk_offset[tb]
                            if dist <= 640 {
                                gain += (w_tb[v2] * (640 - dist)) / 1280
                            }
                        }
                        tc := mfn.blocks[v2].tc
                        if tc >= 0 && tc < n && blk_to_chain[tc] == c1 && tc != tb {
                            dist := (s1 + blk_offset[v2] + blk_sz[v2]) - blk_offset[tc]
                            if dist <= 640 {
                                gain += (w_tc[v2] * (640 - dist)) / 1280
                            }
                        }
                    }
                    v2 = next_in_chain[v2]
                }
                if gain > best_gain {
                    best_gain = gain
                    best_c1 = c1
                    best_c2 = c2
                }
            }
        }
        if best_c1 < 0 || best_gain <= 0 {
            <-
        }
        // Concatenate chain best_c2 onto end of best_c1.
        old_s1 := chain_sz[best_c1]
        t1 := chain_tail[best_c1]
        h2 := chain_head[best_c2]
        next_in_chain[t1] = h2
        $cur := h2
        while cur >= 0 {
            blk_to_chain[cur] = best_c1
            blk_offset[cur] = blk_offset[cur] + old_s1
            cur = next_in_chain[cur]
        }
        chain_tail[best_c1] = chain_tail[best_c2]
        chain_sz[best_c1] = old_s1 + chain_sz[best_c2]
        chain_alive[best_c2] = false
        merges += 1
    }

    // Order chains: entry chain (containing 0) first, then highest-affinity remaining chains.
    $chain_used := []bool{}
    for _ in 0:nh { chain_used.push(false) }
    $out := []int{}
    $c_cur := blk_to_chain[0]
    while c_cur >= 0 {
        chain_used[c_cur] = true
        $b := chain_head[c_cur]
        while b >= 0 {
            out.push(b)
            b = next_in_chain[b]
        }
        // Pick next unused hot chain with max transition weight from just-placed blocks or already-placed chains.
        $nxt_c := -1
        $best_link := -1
        for c in 0:nh {
            if !chain_alive[c] || chain_used[c] { -> }
            $score := 0
            // Incoming from placed blocks
            $cb := chain_head[c]
            while cb >= 0 {
                ps := in_head[cb]
                pe := in_head[cb + 1]
                for pj in ps:pe {
                    src := in_src[pj]
                    if src >= 0 && blk_to_chain[src] >= 0 && chain_used[blk_to_chain[src]] {
                        score += in_w[pj] * 4
                    }
                }
                cb = next_in_chain[cb]
            }
            if score > best_link {
                best_link = score
                nxt_c = c
            }
        }
        if nxt_c < 0 {
            for c in 0:nh {
                if chain_alive[c] && !chain_used[c] {
                    nxt_c = c
                    <-
                }
            }
        }
        c_cur = nxt_c
    }
    << out
}

fn layout_blocks(mfn $&MFn, pgo_counts &[]int, taken &[]int, other &[]int) {
    n := mfn.blocks.len
    if n <= 1 {
        <<
    }

    in_deg := compute_in_degrees(mfn)
    cold := compute_cold_blocks(mfn, &in_deg)
    loops := find_loops(mfn, false)
    rot_loops := find_rotatable_loops(mfn, &loops, &cold)
    depth := cfg_blk_depth(&loops, n)
    $header_rot := []int{}
    $latch_rot := []int{}
    $blk_sz := []int{}
    for bi in 0:n {
        header_rot.push(-1)
        latch_rot.push(-1)
        blk_sz.push(cfg_block_size(mfn, bi))
    }
    for ri in 0:rot_loops.len {
        header_rot[rot_loops[ri].header] = ri
        latch_rot[rot_loops[ri].latch] = ri
    }

    // Compute edge weights from PGO/edge-profile if present, else Wu-Larus static prediction.
    $w_ta := []int{}
    $w_tb := []int{}
    $w_tc := []int{}
    for bi in 0:n {
        d := depth[bi]
        $d_shift := d * 4
        if d_shift > 20 { d_shift = 20 }
        $freq := 1 << d_shift
        if pgo_counts.len == n && pgo_counts[bi] > 0 {
            freq = pgo_counts[bi]
        } else if cold[bi] {
            freq = 1
        }
        $wa := 0
        $wb := 0
        $wc := 0
        tk := mfn.blocks[bi].tkind
        if tk == TKIND_JUMP {
            ta := mfn.blocks[bi].ta
            wa = freq
            if ta >= 0 && ta < n && cold[ta] && !cold[bi] { wa = 1 }
        } else if tk == TKIND_BRANCH {
            tb := mfn.blocks[bi].tb
            tc := mfn.blocks[bi].tc
            if taken.len == n && taken[bi] != other[bi] {
                tot := taken[bi] + other[bi]
                if tot > 0 {
                    wb = taken[bi]
                    wc = other[bi]
                } else {
                    wb = freq / 2 + 1
                    wc = freq / 2
                }
            } else if pgo_counts.len == n && tb >= 0 && tb < n && tc >= 0 && tc < n {
                $cnt_b := pgo_counts[tb]
                $cnt_c := pgo_counts[tc]
                total := pgo_counts[bi]
                if in_deg[tb] == 1 && in_deg[tc] > 1 && cnt_b <= total && total - cnt_b <= cnt_c {
                    cnt_c = total - cnt_b
                } else if in_deg[tc] == 1 && in_deg[tb] > 1 && cnt_c <= total && total - cnt_c <= cnt_b {
                    cnt_b = total - cnt_c
                }
                wb = cnt_b + 1
                wc = cnt_c + 1
            } else if tb >= 0 && tb < n && tc >= 0 && tc < n {
                $ptb := 50
                if cold[tb] && !cold[tc] { ptb = 2 }
                else if cold[tc] && !cold[tb] { ptb = 98 }
                else if depth[tb] > depth[tc] {
                    if d > 0 { ptb = 90 } else { ptb = 88 }
                } else if depth[tc] > depth[tb] {
                    if d > 0 { ptb = 10 } else { ptb = 12 }
                } else if mfn.blocks[tb].tkind == TKIND_RETURN && mfn.blocks[tc].tkind != TKIND_RETURN {
                    ptb = 25
                } else if mfn.blocks[tc].tkind == TKIND_RETURN && mfn.blocks[tb].tkind != TKIND_RETURN {
                    ptb = 75
                } else if in_deg[tb] == 1 && in_deg[tc] > 1 {
                    ptb = 55
                } else if in_deg[tc] == 1 && in_deg[tb] > 1 {
                    ptb = 45
                }
                wb = (freq * ptb + 99) / 100
                wc = (freq * (100 - ptb) + 99) / 100
            }
        }
        w_ta.push(wa)
        w_tb.push(wb)
        w_tc.push(wc)
    }

    $placed := []bool{}
    $is_hot := []bool{}
    $hot_list := []int{}
    for bi in 0:n {
        placed.push(false)
        hot_b := (bi == 0) || (!cold[bi] && mfn.blocks[bi].head >= 0)
        is_hot.push(hot_b)
        if hot_b {
            hot_list.push(bi)
        }
    }

    $order := []int{}
    // Use Ext-TSP chain merging when hot block count is bounded; fallback to static-weight trace for huge CFGs.
    if hot_list.len <= 512 {
        ext_ord := cfg_exttsp_hot_order(mfn, &hot_list, &cold, &is_hot, &w_ta, &w_tb, &w_tc, &blk_sz, &latch_rot, &rot_loops)
        for oi in 0:ext_ord.len {
            b := ext_ord[oi]
            if !placed[b] {
                order.push(b)
                placed[b] = true
            }
        }
    } else {
        order.push(0)
        placed[0] = true
        $cur := 0
        while cur >= 0 {
            $next_cand := -1
            tk := mfn.blocks[cur].tkind
            if tk == TKIND_JUMP {
                ta := mfn.blocks[cur].ta
                if ta >= 0 && ta < n && !placed[ta] && !cold[ta] {
                    next_cand = ta
                }
            } else if tk == TKIND_BRANCH {
                tb := mfn.blocks[cur].tb
                tc := mfn.blocks[cur].tc
                tb_ok := tb >= 0 && tb < n && !placed[tb] && !cold[tb]
                tc_ok := tc >= 0 && tc < n && !placed[tc] && !cold[tc]
                if tb_ok && tc_ok {
                    if w_tc[cur] > w_tb[cur] { next_cand = tc }
                    else { next_cand = tb }
                } else if tb_ok {
                    next_cand = tb
                } else if tc_ok {
                    next_cand = tc
                }
            }
            if next_cand >= 0 && !placed[next_cand] {
                order.push(next_cand)
                placed[next_cand] = true
                cur = next_cand
            } else {
                $found_hot := -1
                for bi in 0:n {
                    if !placed[bi] && is_hot[bi] {
                        found_hot = bi
                        <-
                    }
                }
                if found_hot >= 0 {
                    order.push(found_hot)
                    placed[found_hot] = true
                }
                cur = found_hot
            }
        }
    }

    // Now append all cold and unplaced blocks out-of-line at function end
    for bi in 0:n {
        if !placed[bi] {
            order.push(bi)
            placed[bi] = true
        }
    }

    // If order is identical to 0..n-1, no change needed
    $changed := false
    for i in 0:n {
        if order[i] != i {
            changed = true
            <-
        }
    }
    if !changed {
        <<
    }

    $old_to_new := []int{}
    for _ in 0:n {
        old_to_new.push(0)
    }
    for new_idx in 0:n {
        old_idx := order[new_idx]
        old_to_new[old_idx] = new_idx
    }

    $new_blocks := []MBlock{}
    for new_idx in 0:n {
        old_idx := order[new_idx]
        $b := mfn.blocks[old_idx]
        if b.tkind == TKIND_JUMP {
            if b.ta >= 0 && b.ta < n {
                b.ta = old_to_new[b.ta]
            }
        } else if b.tkind == TKIND_BRANCH {
            if b.tb >= 0 && b.tb < n {
                b.tb = old_to_new[b.tb]
            }
            if b.tc >= 0 && b.tc < n {
                b.tc = old_to_new[b.tc]
            }
        }
        new_blocks.push(b)
    }

    mfn.blocks = new_blocks
}

pub fn opt_cfg(mfn $&MFn) {
    $empty_pgo := []int{}
    opt_cfg_pgo(mfn, &empty_pgo)
}

pub fn opt_cfg_pgo(mfn $&MFn, pgo_counts &[]int) {
    simplify_cfg(mfn)
    reorder_blocks_out_of_line(mfn, pgo_counts)
}

fn cfg_bump_use(uses $&[]int, v int) {
    if v >= 0 && v < uses.len {
        uses[v] = uses[v] + 1
    }
}

fn cfg_count_temp_uses(mfn &MFn) []int {
    $uses := []int{}
    for _ in 0:mfn.temps.len {
        uses.push(0)
    }
    for bi in 0:mfn.blocks.len {
        $ii := mfn.blocks[bi].head
        while ii >= 0 && ii < mfn.instrs.len {
            ins := &mfn.instrs[ii]
            k := ins.kind
            if k != MI_NOP {
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_VOLATILE_LOAD || k == MI_CALL_IND || k == MI_LOAD_FIELD || k == MI_LOAD_BUF_PTR {
                    cfg_bump_use($&uses, ins.b)
                } else if k == MI_STORE_PTR || k == MI_VOLATILE_STORE {
                    cfg_bump_use($&uses, ins.a)
                    cfg_bump_use($&uses, ins.b)
                } else if k == MI_UN {
                    cfg_bump_use($&uses, ins.c)
                } else if k == MI_BIN || k == MI_STORE_FIELD || k == MI_STORE_BUF_PTR || k == MI_ELEM_ADDR || k == MI_LOAD_INDEX {
                    cfg_bump_use($&uses, ins.c)
                    if k == MI_BIN {
                        cfg_bump_use($&uses, ins.d)
                    } else {
                        cfg_bump_use($&uses, ins.b)
                    }
                } else if k == MI_SELECT || k == MI_MADD || k == MI_MSUB {
                    cfg_bump_use($&uses, ins.b)
                    cfg_bump_use($&uses, ins.c)
                    cfg_bump_use($&uses, ins.d)
                } else if k == MI_STORE_INDEX {
                    cfg_bump_use($&uses, ins.a)
                    cfg_bump_use($&uses, ins.b)
                    cfg_bump_use($&uses, ins.c)
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $ap := ins.c
                    while ap >= 0 && ap < mfn.margs.len {
                        cfg_bump_use($&uses, mfn.margs[ap].v)
                        ap = mfn.margs[ap].next
                    }
                }
            }
            if ii == mfn.blocks[bi].tail {
                <-
            }
            ii = ins.next
        }
        tk := mfn.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            cfg_bump_use($&uses, mfn.blocks[bi].ta)
        }
    }
    << uses
}

fn cfg_norm_int_bound(mfn &MFn, ins &MInstr) []int {
    $out := []int{}
    if ins.kind != MI_BIN || ins.sval == "bounds" {
        << out
    }
    $op := ins.b
    if op != BIN_LT && op != BIN_LE && op != BIN_GT && op != BIN_GE {
        << out
    }
    $xv := -1
    $cv := 0
    if ins.c >= 0 && ins.d <= -2 {
        xv = ins.c
        cv = mfn.consts[0 - ins.d - 2]
    } else if ins.d >= 0 && ins.c <= -2 {
        xv = ins.d
        cv = mfn.consts[0 - ins.c - 2]
        if op == BIN_LT { op = BIN_GT }
        else if op == BIN_LE { op = BIN_GE }
        else if op == BIN_GT { op = BIN_LT }
        else if op == BIN_GE { op = BIN_LE }
    } else {
        << out
    }
    if cv < -1000000000 || cv > 1000000000 {
        << out
    }
    $kind := 0
    $val := cv
    if op == BIN_GE {
        kind = 1
    } else if op == BIN_GT {
        kind = 1
        val = cv + 1
    } else if op == BIN_LE {
        kind = 2
    } else if op == BIN_LT {
        kind = 2
        val = cv - 1
    }
    if val < -1000000000 || val > 1000000000 {
        << out
    }
    out.push(xv)
    out.push(kind)
    out.push(val)
    << out
}

fn cfg_last_non_nop(mfn &MFn, bi int) int {
    $last := -1
    $ii := mfn.blocks[bi].head
    while ii >= 0 && ii < mfn.instrs.len {
        if mfn.instrs[ii].kind != MI_NOP {
            last = ii
        }
        if ii == mfn.blocks[bi].tail {
            <-
        }
        ii = mfn.instrs[ii].next
    }
    << last
}

fn cfg_only_non_nop(mfn &MFn, bi int) int {
    $only := -1
    $ii := mfn.blocks[bi].head
    while ii >= 0 && ii < mfn.instrs.len {
        if mfn.instrs[ii].kind != MI_NOP {
            if only >= 0 {
                << -1
            }
            only = ii
        }
        if ii == mfn.blocks[bi].tail {
            <-
        }
        ii = mfn.instrs[ii].next
    }
    << only
}

fn fuse_range_checks(mfn $&MFn) bool {
    $did_fuse := false
    for _ in 0:8 {
        $changed := false
        in_deg := compute_in_degrees(mfn)
        uses := cfg_count_temp_uses(mfn)
        for bi in 0:mfn.blocks.len {
            if mfn.blocks[bi].tkind != TKIND_BRANCH {
                ->
            }
            cond1 := mfn.blocks[bi].ta
            if cond1 < 0 || cond1 >= uses.len || uses[cond1] != 1 {
                ->
            }
            cmp1_ii := cfg_last_non_nop(mfn, bi)
            if cmp1_ii < 0 || mfn.instrs[cmp1_ii].a != cond1 {
                ->
            }
            b1 := cfg_norm_int_bound(mfn, &mfn.instrs[cmp1_ii])
            if b1.len != 3 {
                ->
            }
            tb1 := mfn.blocks[bi].tb
            tc1 := mfn.blocks[bi].tc
            for side in 0:2 {
                $b2_idx := tb1
                $out1 := tc1
                $enter_true := true
                if side == 1 {
                    b2_idx = tc1
                    out1 = tb1
                    enter_true = false
                }
                if b2_idx <= 0 || b2_idx >= mfn.blocks.len || b2_idx == bi || in_deg[b2_idx] != 1 {
                    ->
                }
                if mfn.blocks[b2_idx].tkind != TKIND_BRANCH {
                    ->
                }
                cond2 := mfn.blocks[b2_idx].ta
                if cond2 < 0 || cond2 >= uses.len || uses[cond2] != 1 {
                    ->
                }
                cmp2_ii := cfg_only_non_nop(mfn, b2_idx)
                if cmp2_ii < 0 || mfn.instrs[cmp2_ii].a != cond2 {
                    ->
                }
                b2 := cfg_norm_int_bound(mfn, &mfn.instrs[cmp2_ii])
                if b2.len != 3 || b2[0] != b1[0] {
                    ->
                }
                tb2 := mfn.blocks[b2_idx].tb
                tc2 := mfn.blocks[b2_idx].tc
                if tb2 == b2_idx || tc2 == b2_idx {
                    ->
                }
                $in_target := -1
                $need2_true := true
                if tc2 == out1 {
                    in_target = tb2
                    need2_true = true
                } else if tb2 == out1 {
                    in_target = tc2
                    need2_true = false
                } else {
                    ->
                }
                if in_target < 0 || out1 < 0 || in_target == out1 {
                    ->
                }
                $k1 := b1[1]
                $v1 := b1[2]
                if !enter_true {
                    if k1 == 1 {
                        k1 = 2
                        v1 = v1 - 1
                    } else {
                        k1 = 1
                        v1 = v1 + 1
                    }
                }
                $k2 := b2[1]
                $v2 := b2[2]
                if !need2_true {
                    if k2 == 1 {
                        k2 = 2
                        v2 = v2 - 1
                    } else {
                        k2 = 1
                        v2 = v2 + 1
                    }
                }
                if k1 == k2 {
                    ->
                }
                $lo := v1
                $hi := v2
                if k1 == 2 {
                    lo = v2
                    hi = v1
                }
                if lo < -1000000000 || hi > 1000000000 || lo > hi {
                    ->
                }
                x := b1[0]
                src_line := mfn.instrs[cmp1_ii].line
                mfn.instrs[cmp1_ii].kind = MI_NOP
                mfn.instrs[cmp2_ii].kind = MI_NOP
                mfn.blocks[b2_idx].head = -1
                mfn.blocks[b2_idx].tail = -1
                mfn.blocks[b2_idx].tkind = TKIND_OPEN
                mfn.blocks[b2_idx].ta = -1
                mfn.blocks[b2_idx].tb = -1
                mfn.blocks[b2_idx].tc = -1
                if lo == hi {
                    clo := alloc_const(mfn, lo)
                    t_ne := alloc_temp(mfn)
                    $ins_ne := minstr_new(MI_BIN)
                    ins_ne.a = t_ne
                    ins_ne.b = BIN_NE
                    ins_ne.c = x
                    ins_ne.d = clo
                    ins_ne.line = src_line
                    emit_to_bb(mfn, bi, ins_ne)
                    mfn.blocks[bi].ta = t_ne
                    mfn.blocks[bi].tb = out1
                    mfn.blocks[bi].tc = in_target
                } else {
                    span := hi - lo + 1
                    $u := x
                    if lo != 0 {
                        clo := alloc_const(mfn, lo)
                        u = alloc_temp(mfn)
                        $ins_sub := minstr_new(MI_BIN)
                        ins_sub.a = u
                        ins_sub.b = BIN_SUB
                        ins_sub.c = x
                        ins_sub.d = clo
                        ins_sub.line = src_line
                        emit_to_bb(mfn, bi, ins_sub)
                    }
                    c0 := alloc_const(mfn, 0)
                    cspan := alloc_const(mfn, span)
                    t1 := alloc_temp(mfn)
                    t2 := alloc_temp(mfn)
                    t3 := alloc_temp(mfn)
                    $i1 := minstr_new(MI_BIN)
                    i1.a = t1
                    i1.b = BIN_LT
                    i1.c = u
                    i1.d = c0
                    i1.line = src_line
                    emit_to_bb(mfn, bi, i1)
                    $i2 := minstr_new(MI_BIN)
                    i2.a = t2
                    i2.b = BIN_GE
                    i2.c = u
                    i2.d = cspan
                    i2.sval = "bounds"
                    i2.line = src_line
                    emit_to_bb(mfn, bi, i2)
                    $i3 := minstr_new(MI_BIN)
                    i3.a = t3
                    i3.b = BIN_OR
                    i3.c = t1
                    i3.d = t2
                    i3.sval = "bounds"
                    i3.line = src_line
                    emit_to_bb(mfn, bi, i3)
                    mfn.blocks[bi].ta = t3
                    mfn.blocks[bi].tb = out1
                    mfn.blocks[bi].tc = in_target
                }
                changed = true
                did_fuse = true
                <-
            }
        }
        if !changed {
            <-
        }
    }
    << did_fuse
}

fn cfg_match_int_eq(mfn &MFn, ins &MInstr) []int {
    $out := []int{}
    if ins.kind != MI_BIN || ins.sval == "bounds" {
        << out
    }
    if ins.b != BIN_EQ && ins.b != BIN_NE {
        << out
    }
    $xv := -1
    $cv := 0
    if ins.c >= 0 && ins.d <= -2 {
        xv = ins.c
        cv = mfn.consts[0 - ins.d - 2]
    } else if ins.d >= 0 && ins.c <= -2 {
        xv = ins.d
        cv = mfn.consts[0 - ins.c - 2]
    } else {
        << out
    }
    if cv < -1000000000 || cv > 1000000000 {
        << out
    }
    $is_eq := 0
    if ins.b == BIN_EQ { is_eq = 1 }
    out.push(xv)
    out.push(cv)
    out.push(is_eq)
    << out
}

fn cfg_emit_bst(mfn $&MFn, cur_bi int, x int, cs &[]int, tgts &[]int, lo int, hi int, def_t int, line int) {
    cnt := hi - lo
    if cnt == 1 {
        t := alloc_temp(mfn)
        $ins := minstr_new(MI_BIN)
        ins.a = t
        ins.b = BIN_EQ
        ins.c = x
        ins.d = alloc_const(mfn, cs[lo])
        ins.line = line
        emit_to_bb(mfn, cur_bi, ins)
        mfn.blocks[cur_bi].tkind = TKIND_BRANCH
        mfn.blocks[cur_bi].ta = t
        mfn.blocks[cur_bi].tb = tgts[lo]
        mfn.blocks[cur_bi].tc = def_t
        mfn.blocks[cur_bi].line = line
        <<
    }
    if cnt == 2 {
        b_next := mfn.blocks.len
        mfn.blocks.push(mblock_new())
        t1 := alloc_temp(mfn)
        $ins1 := minstr_new(MI_BIN)
        ins1.a = t1
        ins1.b = BIN_EQ
        ins1.c = x
        ins1.d = alloc_const(mfn, cs[lo])
        ins1.line = line
        emit_to_bb(mfn, cur_bi, ins1)
        mfn.blocks[cur_bi].tkind = TKIND_BRANCH
        mfn.blocks[cur_bi].ta = t1
        mfn.blocks[cur_bi].tb = tgts[lo]
        mfn.blocks[cur_bi].tc = b_next
        mfn.blocks[cur_bi].line = line
        t2 := alloc_temp(mfn)
        $ins2 := minstr_new(MI_BIN)
        ins2.a = t2
        ins2.b = BIN_EQ
        ins2.c = x
        ins2.d = alloc_const(mfn, cs[lo + 1])
        ins2.line = line
        emit_to_bb(mfn, b_next, ins2)
        mfn.blocks[b_next].tkind = TKIND_BRANCH
        mfn.blocks[b_next].ta = t2
        mfn.blocks[b_next].tb = tgts[lo + 1]
        mfn.blocks[b_next].tc = def_t
        mfn.blocks[b_next].line = line
        <<
    }
    mid := lo + cnt / 2
    b_left := mfn.blocks.len
    mfn.blocks.push(mblock_new())
    b_right := mfn.blocks.len
    mfn.blocks.push(mblock_new())
    t := alloc_temp(mfn)
    $ins := minstr_new(MI_BIN)
    ins.a = t
    ins.b = BIN_LT
    ins.c = x
    ins.d = alloc_const(mfn, cs[mid])
    ins.line = line
    emit_to_bb(mfn, cur_bi, ins)
    mfn.blocks[cur_bi].tkind = TKIND_BRANCH
    mfn.blocks[cur_bi].ta = t
    mfn.blocks[cur_bi].tb = b_left
    mfn.blocks[cur_bi].tc = b_right
    mfn.blocks[cur_bi].line = line
    cfg_emit_bst(mfn, b_left, x, cs, tgts, lo, mid, def_t, line)
    cfg_emit_bst(mfn, b_right, x, cs, tgts, mid, hi, def_t, line)
}

fn opt_dispatch_bst(mfn $&MFn) bool {
    $did_opt := false
    in_deg := compute_in_degrees(mfn)
    uses := cfg_count_temp_uses(mfn)
    nb0 := mfn.blocks.len
    for bi in 0:nb0 {
        if mfn.blocks[bi].tkind != TKIND_BRANCH { -> }
        cond0 := mfn.blocks[bi].ta
        if cond0 < 0 || cond0 >= uses.len || uses[cond0] != 1 { -> }
        cmp0_ii := cfg_last_non_nop(mfn, bi)
        if cmp0_ii < 0 || mfn.instrs[cmp0_ii].a != cond0 { -> }
        m0 := cfg_match_int_eq(mfn, &mfn.instrs[cmp0_ii])
        if m0.len != 3 { -> }
        x := m0[0]
        $chain_blks := [bi]
        $chain_cmps := [cmp0_ii]
        $raw_cs := [m0[1]]
        $mt0 := mfn.blocks[bi].tb
        $cur := mfn.blocks[bi].tc
        if m0[2] == 0 {
            mt0 = mfn.blocks[bi].tc
            cur = mfn.blocks[bi].tb
        }
        $raw_tgts := [mt0]
        while chain_blks.len < 64 && cur > 0 && cur < nb0 && cur != bi && in_deg[cur] == 1 {
            $seen := false
            for ci in 0:chain_blks.len {
                if chain_blks[ci] == cur {
                    seen = true
                    <-
                }
            }
            if seen { <- }
            if mfn.blocks[cur].tkind != TKIND_BRANCH { <- }
            cnd := mfn.blocks[cur].ta
            if cnd < 0 || cnd >= uses.len || uses[cnd] != 1 { <- }
            cii := cfg_only_non_nop(mfn, cur)
            if cii < 0 || mfn.instrs[cii].a != cnd { <- }
            mi := cfg_match_int_eq(mfn, &mfn.instrs[cii])
            if mi.len != 3 || mi[0] != x { <- }
            chain_blks.push(cur)
            chain_cmps.push(cii)
            raw_cs.push(mi[1])
            $mt := mfn.blocks[cur].tb
            $nxt := mfn.blocks[cur].tc
            if mi[2] == 0 {
                mt = mfn.blocks[cur].tc
                nxt = mfn.blocks[cur].tb
            }
            raw_tgts.push(mt)
            cur = nxt
        }
        def_t := cur
        if chain_blks.len < 5 || def_t < 0 { -> }
        $bad_tgt := false
        for ti in 0:raw_tgts.len {
            if raw_tgts[ti] < 0 {
                bad_tgt = true
                <-
            }
            for ci in 1:chain_blks.len {
                if raw_tgts[ti] == chain_blks[ci] {
                    bad_tgt = true
                    <-
                }
            }
        }
        for ci in 1:chain_blks.len {
            if def_t == chain_blks[ci] {
                bad_tgt = true
                <-
            }
        }
        if bad_tgt { -> }
        $cs := []int{}
        $tgts := []int{}
        for i in 0:raw_cs.len {
            $dup := false
            for j in 0:cs.len {
                if cs[j] == raw_cs[i] {
                    dup = true
                    <-
                }
            }
            if !dup {
                cs.push(raw_cs[i])
                tgts.push(raw_tgts[i])
            }
        }
        if cs.len < 5 { -> }
        for i in 1:cs.len {
            kc := cs[i]
            kt := tgts[i]
            $j := i - 1
            while j >= 0 && cs[j] > kc {
                cs[j + 1] = cs[j]
                tgts[j + 1] = tgts[j]
                j -= 1
            }
            cs[j + 1] = kc
            tgts[j + 1] = kt
        }
        src_line := mfn.instrs[cmp0_ii].line
        mfn.instrs[cmp0_ii].kind = MI_NOP
        for ci in 1:chain_blks.len {
            cb := chain_blks[ci]
            mfn.instrs[chain_cmps[ci]].kind = MI_NOP
            mfn.blocks[cb].head = -1
            mfn.blocks[cb].tail = -1
            mfn.blocks[cb].tkind = TKIND_OPEN
            mfn.blocks[cb].ta = -1
            mfn.blocks[cb].tb = -1
            mfn.blocks[cb].tc = -1
        }
        cfg_emit_bst(mfn, bi, x, &cs, &tgts, 0, cs.len, def_t, src_line)
        did_opt = true
    }
    << did_opt
}

pub fn simplify_cfg(mfn $&MFn) {
    if mfn.blocks.len <= 1 {
        <<
    }

    // 1. Jump Threading: redirect jumps and branches that land on trampoline blocks
    for bi in 0:mfn.blocks.len {
        tk := mfn.blocks[bi].tkind
        if tk == TKIND_JUMP {
            ta := mfn.blocks[bi].ta
            if ta >= 0 {
                new_ta := resolve_trampoline(mfn, ta)
                if new_ta != ta {
                    mfn.blocks[bi].ta = new_ta
                }
            }
        } else if tk == TKIND_BRANCH {
            tb := mfn.blocks[bi].tb
            tc := mfn.blocks[bi].tc
            if tb >= 0 {
                new_tb := resolve_trampoline(mfn, tb)
                if new_tb != tb {
                    mfn.blocks[bi].tb = new_tb
                }
            }
            if tc >= 0 {
                new_tc := resolve_trampoline(mfn, tc)
                if new_tc != tc {
                    mfn.blocks[bi].tc = new_tc
                }
            }
            // Collapse identical branch targets: if cond { goto T } else { goto T } => goto T
            if mfn.blocks[bi].tb == mfn.blocks[bi].tc && mfn.blocks[bi].tb >= 0 {
                mfn.blocks[bi].tkind = TKIND_JUMP
                mfn.blocks[bi].ta = mfn.blocks[bi].tb
                mfn.blocks[bi].tb = -1
                mfn.blocks[bi].tc = -1
            }
        }
    }

    // 1b. Correlated Jump Threading & CFG Cleanup
    $jt_round := 0
    while jt_round < 3 {
        if !opt_jump_thread(mfn) {
            <-
        }
        fuse_plain(mfn)
        for bi in 0:mfn.blocks.len {
            if mfn.blocks[bi].tkind == TKIND_JUMP {
                mfn.blocks[bi].ta = resolve_trampoline(mfn, mfn.blocks[bi].ta)
            } else if mfn.blocks[bi].tkind == TKIND_BRANCH {
                mfn.blocks[bi].tb = resolve_trampoline(mfn, mfn.blocks[bi].tb)
                mfn.blocks[bi].tc = resolve_trampoline(mfn, mfn.blocks[bi].tc)
            }
        }
        jt_round += 1
    }

    // 2. CFG Fusion: merge single-predecessor blocks into their unconditional pred (fusePlain)
    fuse_plain(mfn)

    // 2b. Range-Check Fusion: collapse two-block integer range guards into a single unsigned check
    if fuse_range_checks(mfn) {
        fuse_plain(mfn)
    }

    // 2c. Multi-way Integer Equality Dispatch -> Balanced Decision Tree
    if opt_dispatch_bst(mfn) {
        fuse_plain(mfn)
    }

    // 3. Unreachable Block Pruning: BFS from entry block 0
    $reachable := []bool{}
    for _ in 0:mfn.blocks.len {
        reachable.push(false)
    }
    reachable[0] = true

    $worklist := []int{}
    worklist.push(0)

    $head_idx := 0
    while head_idx < worklist.len {
        curr := worklist[head_idx]
        head_idx += 1

        tk := mfn.blocks[curr].tkind
        if tk == TKIND_JUMP {
            ta := mfn.blocks[curr].ta
            if ta >= 0 && ta < reachable.len && !reachable[ta] {
                reachable[ta] = true
                worklist.push(ta)
            }
        } else if tk == TKIND_BRANCH {
            tb := mfn.blocks[curr].tb
            tc := mfn.blocks[curr].tc
            if tb >= 0 && tb < reachable.len && !reachable[tb] {
                reachable[tb] = true
                worklist.push(tb)
            }
            if tc >= 0 && tc < reachable.len && !reachable[tc] {
                reachable[tc] = true
                worklist.push(tc)
            }
        }
    }

    // Clear unreachable blocks
    for bi in 1:mfn.blocks.len {
        if !reachable[bi] {
            $ii := mfn.blocks[bi].head
            while ii >= 0 && ii < mfn.instrs.len {
                mfn.instrs[ii].kind = MI_NOP
                if ii == mfn.blocks[bi].tail {
                    <-
                }
                ii = mfn.instrs[ii].next
            }
            mfn.blocks[bi].head = -1
            mfn.blocks[bi].tail = -1
            mfn.blocks[bi].tkind = TKIND_OPEN
            mfn.blocks[bi].ta = -1
            mfn.blocks[bi].tb = -1
            mfn.blocks[bi].tc = -1
        }
    }

}
