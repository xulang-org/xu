@xu/mir

#strings
// Control Flow Graph (CFG) Simplification and Jump Threading pass.
//
// Layer 3 module: eliminates redundant trampoline blocks, collapses identical
// branch targets, prunes unreachable control flow graphs, and performs
// Cold Block Out-of-Line Reordering & Profile-Guided Trace Scheduling.

fn is_empty_block(mfn &MFn, bi int) bool {
    if bi < 0 || bi >= mfn.blocks.len {
        << false
    }
    if mfn.blocks[bi].head < 0 {
        << true
    }
    $ii := mfn.blocks[bi].head
    while ii >= 0 && ii < mfn.instrs.len {
        if mfn.instrs[ii].kind != MI_NOP {
            << false
        }
        if ii == mfn.blocks[bi].tail {
            <-
        }
        ii = mfn.instrs[ii].next
    }
    << true
}

fn resolve_trampoline(mfn &MFn, target int) int {
    $cur := target
    for _ in 0:16 {
        if cur >= 0 && cur < mfn.blocks.len {
            if mfn.blocks[cur].tkind == TKIND_JUMP {
                if is_empty_block(mfn, cur) {
                    next_t := mfn.blocks[cur].ta
                    if next_t >= 0 && next_t != cur {
                        cur = next_t
                        ->
                    }
                }
            }
        }
        << cur
    }
    << cur
}

fn fuse_plain(mfn $&MFn) bool {
    $any_fused := false
    for _ in 0:16 {
        $changed := false
        in_deg := compute_in_degrees(mfn)

        for bi in 0:mfn.blocks.len {
            if mfn.blocks[bi].tkind == TKIND_JUMP {
                target_bb := mfn.blocks[bi].ta
                // Requirements:
                // 1. target_bb is valid and not entry block (0)
                // 2. target_bb is not self (bi)
                // 3. target_bb has strictly only one predecessor (in_deg == 1)
                if target_bb > 0 && target_bb < mfn.blocks.len && target_bb != bi {
                    if in_deg[target_bb] == 1 {
                        // Merge target_bb's instructions into bi
                        if mfn.blocks[bi].head < 0 {
                            mfn.blocks[bi].head = mfn.blocks[target_bb].head
                            mfn.blocks[bi].tail = mfn.blocks[target_bb].tail
                        } else if mfn.blocks[target_bb].head >= 0 {
                            mfn.instrs[mfn.blocks[bi].tail].next = mfn.blocks[target_bb].head
                            mfn.blocks[bi].tail = mfn.blocks[target_bb].tail
                        }

                        // bi adopts target_bb's control terminator
                        mfn.blocks[bi].tkind = mfn.blocks[target_bb].tkind
                        mfn.blocks[bi].ta = mfn.blocks[target_bb].ta
                        mfn.blocks[bi].tb = mfn.blocks[target_bb].tb
                        mfn.blocks[bi].tc = mfn.blocks[target_bb].tc

                        // Clear target_bb to avoid dangling references
                        mfn.blocks[target_bb].head = -1
                        mfn.blocks[target_bb].tail = -1
                        mfn.blocks[target_bb].tkind = TKIND_OPEN
                        mfn.blocks[target_bb].ta = -1
                        mfn.blocks[target_bb].tb = -1
                        mfn.blocks[target_bb].tc = -1

                        changed = true
                        any_fused = true
                    }
                }
            }
        }

        if !changed {
            <-
        }
    }
    << any_fused
}

fn is_cold_instruction(ins &MInstr) bool {
    if ins.kind == MI_CALL {
        if ins.sval == "_xu_runtime_core_rt_panic" ||
           ins.sval == "_xu_runtime_core_iface_tag_panic" ||
           ins.sval == "panic" ||
           ins.sval == "rt_panic" {
            << true
        }
    }
    if ins.kind == MI_THROW_UNWRAP || ins.kind == MI_THROW_UNWRAP_ERR {
        << true
    }
    << false
}

fn compute_cold_blocks(mfn &MFn, in_deg &[]int) []bool {
    $cold := []bool{}
    for _ in 0:mfn.blocks.len {
        cold.push(false)
    }
    if mfn.blocks.len <= 1 {
        << cold
    }

    // Pass 1: Mark intrinsically cold blocks (panic calls, unwrap aborts, unreferenced/empty)
    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].head < 0 {
            cold[bi] = true
            ->
        }
        $ii := mfn.blocks[bi].head
        while ii >= 0 && ii < mfn.instrs.len {
            if is_cold_instruction(&mfn.instrs[ii]) {
                cold[bi] = true
                <-
            }
            if ii == mfn.blocks[bi].tail {
                <-
            }
            ii = mfn.instrs[ii].next
        }
    }

    // Pass 2: Mark error propagation returns
    // In lower_err.xu, an error branch does: branch(e, prop_b, cont_b); prop_b: ret e.
    // If a block tb ends in TKIND_RETURN and returns the tested error condition e, mark tb cold.
    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].tkind == TKIND_BRANCH {
            cond := mfn.blocks[bi].ta
            tb := mfn.blocks[bi].tb
            if tb > 0 && tb < mfn.blocks.len {
                if mfn.blocks[tb].tkind == TKIND_RETURN {
                    if cond >= 0 && mfn.blocks[tb].ta == cond {
                        cold[tb] = true
                    } else {
                        $has_work := false
                        $ii := mfn.blocks[tb].head
                        while ii >= 0 && ii < mfn.instrs.len {
                            if mfn.instrs[ii].kind != MI_NOP {
                                has_work = true
                                <-
                            }
                            if ii == mfn.blocks[tb].tail {
                                <-
                            }
                            ii = mfn.instrs[ii].next
                        }
                        if !has_work {
                            cold[tb] = true
                        }
                    }
                }
            }
        }
    }

    // Pass 3: Propagate coldness forward.
    // If all predecessors of a block are cold, it is cold.
    $cold_pred_cnt := []int{}
    for _ in 0:mfn.blocks.len {
        cold_pred_cnt.push(0)
    }
    for bi in 0:mfn.blocks.len {
        if cold[bi] {
            tk := mfn.blocks[bi].tkind
            if tk == TKIND_JUMP && mfn.blocks[bi].ta >= 0 && mfn.blocks[bi].ta < mfn.blocks.len {
                cold_pred_cnt[mfn.blocks[bi].ta] += 1
            } else if tk == TKIND_BRANCH {
                if mfn.blocks[bi].tb >= 0 && mfn.blocks[bi].tb < mfn.blocks.len {
                    cold_pred_cnt[mfn.blocks[bi].tb] += 1
                }
                if mfn.blocks[bi].tc >= 0 && mfn.blocks[bi].tc < mfn.blocks.len {
                    cold_pred_cnt[mfn.blocks[bi].tc] += 1
                }
            }
        }
    }
    for bi in 1:mfn.blocks.len {
        if !cold[bi] && in_deg[bi] > 0 && cold_pred_cnt[bi] == in_deg[bi] {
            cold[bi] = true
        }
    }

    // Entry block is never cold
    cold[0] = false
    << cold
}

pub fn reorder_blocks_out_of_line(mfn $&MFn, pgo_counts &[]int) {
    $empty := []int{}
    layout_blocks(mfn, pgo_counts, &empty, &empty)
}

// Encode the pre-layout topology in block order. Branch pairs in an edge
// profile follow this same order, with the true successor first.
pub fn pgo_cfg_key(f &MFn) string {
    $parts := []string{}
    for b in &f.blocks {
        if b.tkind == TKIND_BRANCH {
            parts.push("b" + str(b.tb) + "." + str(b.tc))
        } else if b.tkind == TKIND_JUMP {
            parts.push("j" + str(b.ta))
        } else if b.tkind == TKIND_RETURN {
            parts.push("r")
        } else {
            parts.push("o")
        }
    }
    << strings.join(~parts, "-")
}

pub fn layout_edge_profile(f $&MFn, values &[]int) bool {
    $taken := []int{}
    $other := []int{}
    $i := 0
    for b in &f.blocks {
        if b.tkind == TKIND_BRANCH {
            if i + 1 >= values.len { << false }
            taken.push(values[i])
            other.push(values[i + 1])
            i += 2
        } else {
            taken.push(0)
            other.push(0)
        }
    }
    if i != values.len { << false }
    $empty := []int{}
    layout_blocks(f, &empty, &taken, &other)
    << true
}

struct LoopRotInfo {
    header int
    body_entry int
    latch int
    exit_blk int
    loop_idx int
}

fn find_rotatable_loops(mfn &MFn, loops &[]LoopInfo, cold &[]bool) []LoopRotInfo {
    $res := []LoopRotInfo{}
    for li in 0:loops.len {
        h := loops[li].header
        if h <= 0 || h >= mfn.blocks.len { -> }
        hb := ~mfn.blocks[h]
        if hb.tkind != TKIND_BRANCH { -> }
        tb := hb.tb
        tc := hb.tc
        $body_entry := -1
        $exit_blk := -1
        if tb >= 0 && tb < mfn.blocks.len && tc >= 0 && tc < mfn.blocks.len {
            if loops[li].body[tb] && !loops[li].body[tc] {
                body_entry = tb
                exit_blk = tc
            } else if loops[li].body[tc] && !loops[li].body[tb] {
                body_entry = tc
                exit_blk = tb
            }
        }
        if body_entry < 0 || exit_blk < 0 || cold[body_entry] || cold[exit_blk] {
            ->
        }
        $latch := -1
        $latch_cnt := 0
        for bi in 0:loops[li].blocks.len {
            b := loops[li].blocks[bi]
            if b != h && b >= 0 && b < mfn.blocks.len {
                if mfn.blocks[b].tkind == TKIND_JUMP && mfn.blocks[b].ta == h {
                    latch = b
                    latch_cnt += 1
                }
            }
        }
        if latch_cnt != 1 || latch < 0 || cold[latch] {
            ->
        }
        res.push(LoopRotInfo{header: h, body_entry: body_entry, latch: latch, exit_blk: exit_blk, loop_idx: li})
    }
    << res
}

fn layout_blocks(mfn $&MFn, pgo_counts &[]int, taken &[]int, other &[]int) {
    n := mfn.blocks.len
    if n <= 1 {
        <<
    }

    in_deg := compute_in_degrees(mfn)
    cold := compute_cold_blocks(mfn, &in_deg)
    loops := find_loops(mfn, false)
    rot_loops := find_rotatable_loops(mfn, &loops, &cold)
    $header_rot := []int{}
    $latch_rot := []int{}
    for _ in 0:n {
        header_rot.push(-1)
        latch_rot.push(-1)
    }
    for ri in 0:rot_loops.len {
        header_rot[rot_loops[ri].header] = ri
        latch_rot[rot_loops[ri].latch] = ri
    }

    $placed := []bool{}
    for _ in 0:n {
        placed.push(false)
    }

    $order := []int{}
    order.push(0)
    placed[0] = true

    $cur := 0
    while cur >= 0 {
        $next_cand := -1
        tk := mfn.blocks[cur].tkind

        if tk == TKIND_JUMP {
            ta := mfn.blocks[cur].ta
            if ta >= 0 && ta < n && !placed[ta] && !cold[ta] {
                if header_rot[ta] >= 0 {
                    ri := header_rot[ta]
                    be := rot_loops[ri].body_entry
                    if !placed[rot_loops[ri].header] && !placed[be] && !cold[be] {
                        next_cand = be
                    } else {
                        next_cand = ta
                    }
                } else {
                    next_cand = ta
                }
            }
        } else if tk == TKIND_BRANCH {
            $tb := mfn.blocks[cur].tb
            $tc := mfn.blocks[cur].tc
            if tb >= 0 && tb < n && header_rot[tb] >= 0 {
                ri := header_rot[tb]
                be := rot_loops[ri].body_entry
                if !placed[rot_loops[ri].header] && !placed[be] && !cold[be] {
                    tb = be
                }
            }
            if tc >= 0 && tc < n && header_rot[tc] >= 0 {
                ri := header_rot[tc]
                be := rot_loops[ri].body_entry
                if !placed[rot_loops[ri].header] && !placed[be] && !cold[be] {
                    tc = be
                }
            }

            tb_ok := tb >= 0 && tb < n && !placed[tb]
            tc_ok := tc >= 0 && tc < n && !placed[tc]

            if taken.len == n && tb_ok && tc_ok && taken[cur] != other[cur] {
                next_cand = tc
                if taken[cur] > other[cur] { next_cand = tb }
            } else if pgo_counts.len == n {
                $cnt_b := 0
                $cnt_c := 0
                if tb >= 0 && tb < n { cnt_b = pgo_counts[tb] }
                if tc >= 0 && tc < n { cnt_c = pgo_counts[tc] }
                if tb_ok && tc_ok {
                    total := pgo_counts[cur]
                    if in_deg[tb] == 1 && in_deg[tc] > 1 && cnt_b <= total && total - cnt_b <= cnt_c {
                        cnt_c = total - cnt_b
                    } else if in_deg[tc] == 1 && in_deg[tb] > 1 && cnt_c <= total && total - cnt_c <= cnt_b {
                        cnt_b = total - cnt_c
                    }
                    if cnt_c >= cnt_b {
                        next_cand = tc
                    } else {
                        next_cand = tb
                    }
                } else if tb_ok && !cold[tb] {
                    next_cand = tb
                } else if tc_ok && !cold[tc] {
                    next_cand = tc
                }
            } else {
                if tb >= 0 && tb < n && cold[tb] && tc_ok && !cold[tc] {
                    next_cand = tc
                } else if tc >= 0 && tc < n && cold[tc] && tb_ok && !cold[tb] {
                    next_cand = tb
                } else if tb_ok && !cold[tb] {
                    next_cand = tb
                } else if tc_ok && !cold[tc] {
                    next_cand = tc
                }
            }
        }

        if next_cand >= 0 && !placed[next_cand] {
            order.push(next_cand)
            placed[next_cand] = true
            cur = next_cand
            while cur >= 0 && latch_rot[cur] >= 0 {
                lri := latch_rot[cur]
                rh := rot_loops[lri].header
                re := rot_loops[lri].exit_blk
                if placed[rh] {
                    <-
                }
                li := rot_loops[lri].loop_idx
                $all_placed := true
                for bi in 0:loops[li].blocks.len {
                    b := loops[li].blocks[bi]
                    if b != rh && !cold[b] && !placed[b] {
                        all_placed = false
                        <-
                    }
                }
                if !all_placed {
                    <-
                }
                order.push(rh)
                placed[rh] = true
                if !placed[re] && !cold[re] {
                    order.push(re)
                    placed[re] = true
                    cur = re
                } else {
                    cur = rh
                    <-
                }
            }
        } else {
            $found_hot := -1
            for bi in 0:n {
                if !placed[bi] && !cold[bi] && mfn.blocks[bi].head >= 0 {
                    $cand := bi
                    if header_rot[cand] >= 0 {
                        ri := header_rot[cand]
                        be := rot_loops[ri].body_entry
                        if !placed[rot_loops[ri].header] && !placed[be] && !cold[be] {
                            cand = be
                        }
                    }
                    found_hot = cand
                    <-
                }
            }
            if found_hot >= 0 {
                order.push(found_hot)
                placed[found_hot] = true
                cur = found_hot
                while cur >= 0 && latch_rot[cur] >= 0 {
                    lri := latch_rot[cur]
                    rh := rot_loops[lri].header
                    re := rot_loops[lri].exit_blk
                    if placed[rh] {
                        <-
                    }
                    li := rot_loops[lri].loop_idx
                    $all_placed := true
                    for bi in 0:loops[li].blocks.len {
                        b := loops[li].blocks[bi]
                        if b != rh && !cold[b] && !placed[b] {
                            all_placed = false
                            <-
                        }
                    }
                    if !all_placed {
                        <-
                    }
                    order.push(rh)
                    placed[rh] = true
                    if !placed[re] && !cold[re] {
                        order.push(re)
                        placed[re] = true
                        cur = re
                    } else {
                        cur = rh
                        <-
                    }
                }
            } else {
                cur = -1
            }
        }
    }

    // Now append all cold and unplaced blocks out-of-line at function end
    for bi in 0:n {
        if !placed[bi] {
            order.push(bi)
            placed[bi] = true
        }
    }

    // If order is identical to 0..n-1, no change needed
    $changed := false
    for i in 0:n {
        if order[i] != i {
            changed = true
            <-
        }
    }
    if !changed {
        <<
    }

    $old_to_new := []int{}
    for _ in 0:n {
        old_to_new.push(0)
    }
    for new_idx in 0:n {
        old_idx := order[new_idx]
        old_to_new[old_idx] = new_idx
    }

    $new_blocks := []MBlock{}
    for new_idx in 0:n {
        old_idx := order[new_idx]
        $b := mfn.blocks[old_idx]
        if b.tkind == TKIND_JUMP {
            if b.ta >= 0 && b.ta < n {
                b.ta = old_to_new[b.ta]
            }
        } else if b.tkind == TKIND_BRANCH {
            if b.tb >= 0 && b.tb < n {
                b.tb = old_to_new[b.tb]
            }
            if b.tc >= 0 && b.tc < n {
                b.tc = old_to_new[b.tc]
            }
        }
        new_blocks.push(b)
    }

    mfn.blocks = new_blocks
}

pub fn opt_cfg(mfn $&MFn) {
    $empty_pgo := []int{}
    opt_cfg_pgo(mfn, &empty_pgo)
}

pub fn opt_cfg_pgo(mfn $&MFn, pgo_counts &[]int) {
    simplify_cfg(mfn)
    reorder_blocks_out_of_line(mfn, pgo_counts)
}

pub fn simplify_cfg(mfn $&MFn) {
    if mfn.blocks.len <= 1 {
        <<
    }

    // 1. Jump Threading: redirect jumps and branches that land on trampoline blocks
    for bi in 0:mfn.blocks.len {
        tk := mfn.blocks[bi].tkind
        if tk == TKIND_JUMP {
            ta := mfn.blocks[bi].ta
            if ta >= 0 {
                new_ta := resolve_trampoline(mfn, ta)
                if new_ta != ta {
                    mfn.blocks[bi].ta = new_ta
                }
            }
        } else if tk == TKIND_BRANCH {
            tb := mfn.blocks[bi].tb
            tc := mfn.blocks[bi].tc
            if tb >= 0 {
                new_tb := resolve_trampoline(mfn, tb)
                if new_tb != tb {
                    mfn.blocks[bi].tb = new_tb
                }
            }
            if tc >= 0 {
                new_tc := resolve_trampoline(mfn, tc)
                if new_tc != tc {
                    mfn.blocks[bi].tc = new_tc
                }
            }
            // Collapse identical branch targets: if cond { goto T } else { goto T } => goto T
            if mfn.blocks[bi].tb == mfn.blocks[bi].tc && mfn.blocks[bi].tb >= 0 {
                mfn.blocks[bi].tkind = TKIND_JUMP
                mfn.blocks[bi].ta = mfn.blocks[bi].tb
                mfn.blocks[bi].tb = -1
                mfn.blocks[bi].tc = -1
            }
        }
    }

    // 2. CFG Fusion: merge single-predecessor blocks into their unconditional pred (fusePlain)
    fuse_plain(mfn)

    // 3. Unreachable Block Pruning: BFS from entry block 0
    $reachable := []bool{}
    for _ in 0:mfn.blocks.len {
        reachable.push(false)
    }
    reachable[0] = true

    $worklist := []int{}
    worklist.push(0)

    $head_idx := 0
    while head_idx < worklist.len {
        curr := worklist[head_idx]
        head_idx += 1

        tk := mfn.blocks[curr].tkind
        if tk == TKIND_JUMP {
            ta := mfn.blocks[curr].ta
            if ta >= 0 && ta < reachable.len && !reachable[ta] {
                reachable[ta] = true
                worklist.push(ta)
            }
        } else if tk == TKIND_BRANCH {
            tb := mfn.blocks[curr].tb
            tc := mfn.blocks[curr].tc
            if tb >= 0 && tb < reachable.len && !reachable[tb] {
                reachable[tb] = true
                worklist.push(tb)
            }
            if tc >= 0 && tc < reachable.len && !reachable[tc] {
                reachable[tc] = true
                worklist.push(tc)
            }
        }
    }

    // Clear unreachable blocks
    for bi in 1:mfn.blocks.len {
        if !reachable[bi] {
            $ii := mfn.blocks[bi].head
            while ii >= 0 && ii < mfn.instrs.len {
                mfn.instrs[ii].kind = MI_NOP
                if ii == mfn.blocks[bi].tail {
                    <-
                }
                ii = mfn.instrs[ii].next
            }
            mfn.blocks[bi].head = -1
            mfn.blocks[bi].tail = -1
            mfn.blocks[bi].tkind = TKIND_OPEN
            mfn.blocks[bi].ta = -1
            mfn.blocks[bi].tb = -1
            mfn.blocks[bi].tc = -1
        }
    }

}
