@xu/mir
// Control Flow Graph (CFG) Simplification and Jump Threading pass.
//
// Layer 3 module: eliminates redundant trampoline blocks, collapses identical
// branch targets, and prunes unreachable control flow graphs.

fn is_empty_block(mfn &MFn, bi int) bool {
    if bi < 0 || bi >= mfn.blocks.len {
        << false
    }
    if mfn.blocks[bi].head < 0 {
        << true
    }
    $ii := mfn.blocks[bi].head
    while ii >= 0 && ii < mfn.instrs.len {
        if mfn.instrs[ii].kind != MI_NOP {
            << false
        }
        if ii == mfn.blocks[bi].tail {
            <-
        }
        ii = mfn.instrs[ii].next
    }
    << true
}

fn resolve_trampoline(mfn &MFn, target int) int {
    $cur := target
    for _ in 0:16 {
        if cur >= 0 && cur < mfn.blocks.len {
            if mfn.blocks[cur].tkind == TKIND_JUMP {
                if is_empty_block(mfn, cur) {
                    next_t := mfn.blocks[cur].ta
                    if next_t >= 0 && next_t != cur {
                        cur = next_t
                        ->
                    }
                }
            }
        }
        << cur
    }
    << cur
}

fn fuse_plain(mfn $&MFn) bool {
    $any_fused := false
    for _ in 0:16 {
        $changed := false
        in_deg := compute_in_degrees(mfn)

        for bi in 0:mfn.blocks.len {
            if mfn.blocks[bi].tkind == TKIND_JUMP {
                target_bb := mfn.blocks[bi].ta
                // Requirements:
                // 1. target_bb is valid and not entry block (0)
                // 2. target_bb is not self (bi)
                // 3. target_bb has strictly only one predecessor (in_deg == 1)
                if target_bb > 0 && target_bb < mfn.blocks.len && target_bb != bi {
                    if in_deg[target_bb] == 1 {
                        // Merge target_bb's instructions into bi
                        if mfn.blocks[bi].head < 0 {
                            mfn.blocks[bi].head = mfn.blocks[target_bb].head
                            mfn.blocks[bi].tail = mfn.blocks[target_bb].tail
                        } else if mfn.blocks[target_bb].head >= 0 {
                            mfn.instrs[mfn.blocks[bi].tail].next = mfn.blocks[target_bb].head
                            mfn.blocks[bi].tail = mfn.blocks[target_bb].tail
                        }

                        // bi adopts target_bb's control terminator
                        mfn.blocks[bi].tkind = mfn.blocks[target_bb].tkind
                        mfn.blocks[bi].ta = mfn.blocks[target_bb].ta
                        mfn.blocks[bi].tb = mfn.blocks[target_bb].tb
                        mfn.blocks[bi].tc = mfn.blocks[target_bb].tc

                        // Clear target_bb to avoid dangling references
                        mfn.blocks[target_bb].head = -1
                        mfn.blocks[target_bb].tail = -1
                        mfn.blocks[target_bb].tkind = TKIND_OPEN
                        mfn.blocks[target_bb].ta = -1
                        mfn.blocks[target_bb].tb = -1
                        mfn.blocks[target_bb].tc = -1

                        changed = true
                        any_fused = true
                    }
                }
            }
        }

        if !changed {
            <-
        }
    }
    << any_fused
}

pub fn opt_cfg(mfn $&MFn) {
    if mfn.blocks.len <= 1 {
        <<
    }

    // 1. Jump Threading: redirect jumps and branches that land on trampoline blocks
    for bi in 0:mfn.blocks.len {
        tk := mfn.blocks[bi].tkind
        if tk == TKIND_JUMP {
            ta := mfn.blocks[bi].ta
            if ta >= 0 {
                new_ta := resolve_trampoline(mfn, ta)
                if new_ta != ta {
                    mfn.blocks[bi].ta = new_ta
                }
            }
        } else if tk == TKIND_BRANCH {
            tb := mfn.blocks[bi].tb
            tc := mfn.blocks[bi].tc
            if tb >= 0 {
                new_tb := resolve_trampoline(mfn, tb)
                if new_tb != tb {
                    mfn.blocks[bi].tb = new_tb
                }
            }
            if tc >= 0 {
                new_tc := resolve_trampoline(mfn, tc)
                if new_tc != tc {
                    mfn.blocks[bi].tc = new_tc
                }
            }
            // Collapse identical branch targets: if cond { goto T } else { goto T } => goto T
            if mfn.blocks[bi].tb == mfn.blocks[bi].tc && mfn.blocks[bi].tb >= 0 {
                mfn.blocks[bi].tkind = TKIND_JUMP
                mfn.blocks[bi].ta = mfn.blocks[bi].tb
                mfn.blocks[bi].tb = -1
                mfn.blocks[bi].tc = -1
            }
        }
    }

    // 2. CFG Fusion: merge single-predecessor blocks into their unconditional pred (fusePlain)
    fuse_plain(mfn)

    // 3. Unreachable Block Pruning: BFS from entry block 0
    $reachable := []bool{}
    for _ in 0:mfn.blocks.len {
        reachable.push(false)
    }
    reachable[0] = true

    $worklist := []int{}
    worklist.push(0)

    $head_idx := 0
    while head_idx < worklist.len {
        curr := worklist[head_idx]
        head_idx += 1

        tk := mfn.blocks[curr].tkind
        if tk == TKIND_JUMP {
            ta := mfn.blocks[curr].ta
            if ta >= 0 && ta < reachable.len && !reachable[ta] {
                reachable[ta] = true
                worklist.push(ta)
            }
        } else if tk == TKIND_BRANCH {
            tb := mfn.blocks[curr].tb
            tc := mfn.blocks[curr].tc
            if tb >= 0 && tb < reachable.len && !reachable[tb] {
                reachable[tb] = true
                worklist.push(tb)
            }
            if tc >= 0 && tc < reachable.len && !reachable[tc] {
                reachable[tc] = true
                worklist.push(tc)
            }
        }
    }

    // Clear unreachable blocks
    for bi in 1:mfn.blocks.len {
        if !reachable[bi] {
            $ii := mfn.blocks[bi].head
            while ii >= 0 && ii < mfn.instrs.len {
                mfn.instrs[ii].kind = MI_NOP
                if ii == mfn.blocks[bi].tail {
                    <-
                }
                ii = mfn.instrs[ii].next
            }
            mfn.blocks[bi].head = -1
            mfn.blocks[bi].tail = -1
            mfn.blocks[bi].tkind = TKIND_OPEN
            mfn.blocks[bi].ta = -1
            mfn.blocks[bi].tb = -1
            mfn.blocks[bi].tc = -1
        }
    }
}
