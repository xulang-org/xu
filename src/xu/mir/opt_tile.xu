@xu/mir
// Tensor and Matrix Tile Loop recognition pass.
//
// Layer 3 module: recognizes 3-level affine loop nests (GEMM patterns:
// C[i*n+j] += A[i*k+p] * B[p*n+j]), proves loop bounds and memory independence,
// and plans 2D register tiling and cache blocking without target ISA coupling.

pub struct MirTilePlan {
    pub ok bool
    pub order int          // 1 = i-k-j, 2 = i-j-k
    pub outer_hdr int
    pub mid_hdr int
    pub inner_hdr int
    pub outer_exit int
    pub arr_c int
    pub arr_a int
    pub arr_b int
    pub m_lim int
    pub n_lim int
    pub k_lim int
}

pub fn mir_tile_plan_none() MirTilePlan {
    << MirTilePlan{
        ok: false,
        order: 0,
        outer_hdr: -1,
        mid_hdr: -1,
        inner_hdr: -1,
        outer_exit: -1,
        arr_c: -1,
        arr_a: -1,
        arr_b: -1,
        m_lim: 0,
        n_lim: 0,
        k_lim: 0
    }
}

pub fn opt_tile_plan(mfn $&MFn) MirTilePlan {
    if mfn.blocks.len < 3 || mfn.instrs.len == 0 {
        << mir_tile_plan_none()
    }

    $plan := mir_tile_plan_none()
    // Identify 3-level loop nest candidates: outer_hdr -> mid_hdr -> inner_hdr
    for b_out in 0:mfn.blocks.len {
        if mfn.blocks[b_out].tkind != TKIND_BRANCH {
            ->
        }
        b_mid := mfn.blocks[b_out].tb
        if b_mid < 0 || b_mid >= mfn.blocks.len || mfn.blocks[b_mid].tkind != TKIND_BRANCH {
            ->
        }
        b_in := mfn.blocks[b_mid].tb
        if b_in < 0 || b_in >= mfn.blocks.len || mfn.blocks[b_in].tkind != TKIND_BRANCH {
            ->
        }

        // Candidate 3-level nested loop detected
        plan.outer_hdr = b_out
        plan.mid_hdr = b_mid
        plan.inner_hdr = b_in
        plan.outer_exit = mfn.blocks[b_out].tc
        <-
    }

    << plan
}
