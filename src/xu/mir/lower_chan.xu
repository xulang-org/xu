@xu/mir
// Channels, `xu` tasks and select.
//
// A channel value is one word: the address of a runtime/core channel
// record. Elements travel through memory: wide values by address and size,
// scalars as one 8-byte word. Blocking and scheduling live in
// runtime/core (chan.xu); `xu f(args)` packs the incoming argument words of
// f into a heap block and starts f on a new task.

#xu/ast
#xu/parser
#xu/types
#os

// Argument words handed to a task (x0-x7 plus eight stack words).
const XU_ARG_WORDS = 16

fn chan_esize(tp &types.TypedProgram, ty int) int {
    if is_wide(tp, ty) {
        << tp.size_of(ty)
    }
    << 8
}

fn (w $&Lw) chan_operand(p &parser.Parser, tp &types.TypedProgram, n int) int {
    v := w.lower_expr(p, tp, n)
    if w.expr_is_ref(p, tp, n) && !types.is_chan_type(tp.type_of(n)) {
        << w.load_ptr(v, 0, 8)
    }
    << v
}

// Address of memory holding value v of type ty (scalars spilled to a word).
fn (w $&Lw) chan_value_addr(tp &types.TypedProgram, v int, ty int) int {
    if is_wide(tp, ty) {
        << v
    }
    a := w.scratch_words(1)
    w.store_ptr(a, 0, v, 8)
    << a
}

// Fresh frame memory for one received element of type ty.
fn (w $&Lw) chan_elem_slot(tp &types.TypedProgram, ty int) int {
    if is_wide(tp, ty) {
        << w.scratch(tp, ty)
    }
    << w.scratch_words(1)
}

fn (w $&Lw) chan_elem_value(tp &types.TypedProgram, addr int, ty int) int {
    if is_wide(tp, ty) {
        << addr
    }
    << w.load_ptr(addr, 0, width_of(tp, ty))
}

fn (w $&Lw) chan_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_CHAN_INIT {
        $args := []int{}
        args.push(w.lower_expr(p, tp, p.nodes[n].b))
        << w.call_core("chan_new", &args)
    }
    if k == ast.NK_RECV {
        cn := p.nodes[n].a
        cty := tp.deref(tp.type_of(cn))
        ch := w.chan_operand(p, tp, cn)
        ety := tp.type_of(n)
        dst := w.chan_elem_slot(tp, ety)
        $args := []int{}
        args.push(ch)
        args.push(dst)
        args.push(w.konst(chan_esize(tp, ety)))
        w.call_core("chan_recv", &args)
        val := w.chan_elem_value(tp, dst, ety)
        w.drop_temp(p, tp, cn, ch, cty)
        << val
    }
    << NOT_HANDLED
}

fn (w $&Lw) chan_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    if code == -21 {
        cn := p.nodes[n].a
        cty := tp.deref(tp.type_of(cn))
        ch := w.chan_operand(p, tp, cn)
        $args := []int{}
        args.push(ch)
        w.call_core("chan_close", &args)
        w.drop_temp(p, tp, cn, ch, cty)
        << w.konst(0)
    }
    << NOT_HANDLED
}

fn (w $&Lw) chan_method_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    << NOT_HANDLED
}

fn (w $&Lw) chan_stmt(p &parser.Parser, tp &types.TypedProgram, s int) bool {
    k := p.nodes[s].kind
    if k == ast.NK_SEND {
        cn := p.nodes[s].a
        cty := tp.deref(tp.type_of(cn))
        ch := w.chan_operand(p, tp, cn)
        vn := p.nodes[s].b
        vty := tp.deref(tp.type_of(vn))
        src := w.chan_value_addr(tp, w.own_val(p, tp, vn, w.lower_expr(p, tp, vn), vty), vty)
        $args := []int{}
        args.push(ch)
        args.push(src)
        args.push(w.konst(chan_esize(tp, vty)))
        w.call_core("chan_send", &args)
        w.drop_temp(p, tp, cn, ch, cty)
        << true
    }
    if k == ast.NK_XU {
        w.lower_xu(p, tp, s)
        << true
    }
    if k == ast.NK_SELECT {
        w.lower_select(p, tp, s)
        << true
    }
    << false
}

fn (w $&Lw) fn_addr(label string) int {
    t := w.new_temp()
    $ins := minstr_new(MI_LOAD_FN_ADDR)
    ins.a = t
    ins.sval = label + ""
    w.emit(ins)
    << t
}

fn collect_callees_in_node(p &parser.Parser, tp &types.TypedProgram, root int, callees $&[]int) {
    if root < 0 || root >= p.nodes.len { << }
    $visited := []int{}
    for _ in 0:p.nodes.len {
        visited.push(0)
    }
    $work := []int{}
    work.push(root)
    visited[root] = 1
    $head := 0
    while head < work.len {
        curr := work[head]
        head += 1
        if curr < 0 || curr >= p.nodes.len { -> }
        k := p.nodes[curr].kind
        if k == ast.NK_CALL {
            tgt := tp.call_of(curr)
            if tgt >= 0 && tgt < tp.fns.len {
                $already := false
                for ci in 0:callees.len {
                    if callees[ci] == tgt {
                        already = true
                        <-
                    }
                }
                if !already {
                    callees.push(tgt)
                }
            }
        }
        na := p.nodes[curr].a
        if na >= 0 && na < p.nodes.len && visited[na] == 0 {
            visited[na] = 1
            work.push(na)
        }
        nb := p.nodes[curr].b
        if nb >= 0 && nb < p.nodes.len && visited[nb] == 0 {
            visited[nb] = 1
            work.push(nb)
        }
        nc := p.nodes[curr].c
        if nc >= 0 && nc < p.nodes.len && visited[nc] == 0 {
            visited[nc] = 1
            work.push(nc)
        }
        nn := p.nodes[curr].next
        if nn >= 0 && nn < p.nodes.len && visited[nn] == 0 {
            visited[nn] = 1
            work.push(nn)
        }
    }
}

fn compute_fn_stack_bound(p &parser.Parser, tp &types.TypedProgram, fi int, visited $&[]int, bounds $&[]int) int {
    if fi < 0 || fi >= tp.fns.len { << 999999 }
    if visited[fi] == 1 {
        // Recursive cycle detected: unbounded stack
        << 999999
    }
    if visited[fi] == 2 {
        << bounds[fi]
    }
    f := &tp.fns[fi]
    if f.is_extern {
        << 999999
    }
    visited[fi] = 1
    // Estimate frame: locals + callee-saved registers + ABI scratch alignment
    frame := f.locals.len * 8 + 64

    $callees := []int{}
    if f.decl >= 0 && f.decl < p.nodes.len {
        collect_callees_in_node(p, tp, p.nodes[f.decl].c, $&callees)
    }

    $max_callee := 0
    for ci in 0:callees.len {
        cb := compute_fn_stack_bound(p, tp, callees[ci], visited, bounds)
        if cb >= 999999 {
            visited[fi] = 2
            bounds[fi] = 999999
            << 999999
        }
        if cb > max_callee {
            max_callee = cb
        }
    }

    visited[fi] = 2
    total := frame + max_callee
    bounds[fi] = total
    << total
}

fn str_ends_with(s &string, suffix string) bool {
    if s.len < suffix.len { << false }
    off := s.len - suffix.len
    for i in 0:suffix.len {
        if (*s)[off + i] != suffix[i] { << false }
    }
    << true
}

const TASK_POLL_INTERVAL = 65536

fn (w $&Lw) new_loop_poll_counter() int {
    if !w.poll_loops { << -1 }
    slot := w.new_local(1, 1, "task_poll_counter")
    w.store_local(slot, 0, w.konst(TASK_POLL_INTERVAL))
    << slot
}

fn (w $&Lw) loop_poll(slot int) {
    if slot < 0 { << }
    next := w.bin(BIN_SUB, w.load_local(slot, 0), w.konst(1))
    w.store_local(slot, 0, next)
    slow := w.new_block()
    done := w.new_block()
    w.branch(w.bin(BIN_EQ, next, w.konst(0)), slow, done)
    w.f.active_bb = slow
    w.store_local(slot, 0, w.konst(TASK_POLL_INTERVAL))
    none := []int{}
    w.call_core("task_poll", &none)
    w.jump(done)
    w.f.active_bb = done
}

fn is_coroutine_tiny_bounded(p &parser.Parser, tp &types.TypedProgram, fi int) bool {
    if fi < 0 || fi >= tp.fns.len { << false }
    if tp.fns[fi].may_throw { << false }
    fn_name := ~tp.fns[fi].name
    $explicit_tiny := os.getenv("XU_TINY_STACK") == "1"
    if !explicit_tiny {
        if str_ends_with(&fn_name, "_tiny") || str_ends_with(&fn_name, "_tiny_stack") {
            explicit_tiny = true
        }
    }
    if !explicit_tiny {
        << false
    }
    $visited := []int{}
    $bounds := []int{}
    for _ in 0:tp.fns.len {
        visited.push(0)
        bounds.push(0)
    }
    b := compute_fn_stack_bound(p, tp, fi, $&visited, $&bounds)
    // 16KB tiny slab has 16384 bytes. If total call-graph stack <= 12288, safe.
    << b <= 12288
}

// xu f(args): copy the incoming words of f (wide values included) to the heap
// so the task does not depend on this frame.
fn (w $&Lw) lower_xu(p &parser.Parser, tp &types.TypedProgram, s int) {
    call := p.nodes[s].a
    $fi := tp.call_of(s)
    if fi < 0 {
        fi = tp.call_of(call)
    }
    if fi < 0 || fi >= tp.fns.len {
        w.fail(p, s, "unresolved xu target")
        <<
    }
    tfn := ~tp.fns[fi]
    $lead := 0
    $lead_size := 0
    if tfn.may_throw {
        lead = 1
        if tfn.throw_ty > 0 && types.throw_index(tfn.throw_ty) < tp.throws.len {
            ok := tp.throws[types.throw_index(tfn.throw_ty)].ok_ty
            if ok != 0 {
                lead_size = (tp.size_of(ok) + 7) / 8 * 8
            }
        }
    } else if tfn.ret != 0 && is_wide(tp, tfn.ret) {
        lead = 1
        lead_size = (tp.size_of(tfn.ret) + 7) / 8 * 8
    }
    $extra := lead_size
    for i in 0:tfn.params.len {
        if is_wide(tp, tfn.params[i]) {
            extra += (tp.size_of(tfn.params[i]) + 7) / 8 * 8
        }
    }
    if lead + tfn.params.len > XU_ARG_WORDS {
        w.fail(p, s, "too many xu arguments")
        <<
    }
    $aargs := []int{}
    aargs.push(w.konst(XU_ARG_WORDS * 8 + extra))
    block := w.call_core("alloc", &aargs)
    $tail := XU_ARG_WORDS * 8
    if lead == 1 && lead_size > 0 {
        w.store_ptr(block, 0, w.bin(BIN_ADD, block, w.konst(tail)), 8)
        tail += lead_size
    }
    $arg := p.nodes[call].a
    $pi := 0
    while arg >= 0 {
        $pty := 1
        if pi < tfn.params.len {
            pty = tfn.params[pi]
        }
        v := w.lower_arg(p, tp, arg, pty)
        slot := (lead + pi) * 8
        if is_wide(tp, pty) {
            dst := w.bin(BIN_ADD, block, w.konst(tail))
            w.copy_mem(dst, v, tp.size_of(pty))
            w.store_ptr(block, slot, dst, 8)
            tail += (tp.size_of(pty) + 7) / 8 * 8
        } else {
            w.store_ptr(block, slot, v, 8)
        }
        pi += 1
        arg = p.nodes[arg].next
    }
    $args := []int{}
    args.push(w.fn_addr("__xu_task_entry"))
    args.push(w.fn_addr(tfn.label))
    args.push(w.fn_addr(w.core("task_exit")))
    args.push(block)
    $spawn_fn := "task_spawn"
    // The source stack-bound estimate does not include inserted poll calls.
    if !w.task_poll && is_coroutine_tiny_bounded(p, tp, fi) {
        tiny_lbl := w.core("task_spawn_tiny")
        if tiny_lbl.len > 0 {
            spawn_fn = "task_spawn_tiny"
        }
    }
    w.call_core(spawn_fn, &args)
}

fn (w $&Lw) drop_unselected_sends(p &parser.Parser, tp &types.TypedProgram, arms &[]int, bufs &[]int, send_vtys &[]int, chosen int) {
    for j in 0:arms.len {
        if j != chosen && p.nodes[arms[j]].kind == ast.NK_SEL_SEND && w.needs_drop(tp, send_vtys[j]) {
            w.drop_value(tp, bufs[j], send_vtys[j])
        }
    }
}

// select: evaluate every channel (and sent value) once, then poll the arms
// in order; without an else arm, yield and poll again until one is ready.
fn (w $&Lw) lower_select(p &parser.Parser, tp &types.TypedProgram, s int) {
    $arms := []int{}
    $chans := []int{}
    $bufs := []int{}
    $sizes := []int{}
    $send_vtys := []int{}
    sel_mark := w.scope_ids.len
    $ar := p.nodes[s].a
    while ar >= 0 {
        ak := p.nodes[ar].kind
        cnode := p.nodes[ar].a
        cty := tp.deref(tp.type_of(cnode))
        ch := w.chan_operand(p, tp, cnode)
        $cslot := -1
        if w.fresh_temp(p, tp, cnode) {
            cslot = w.own_temp_slot(tp, cty, "selch")
        } else {
            cslot = w.new_local(1, 1, "selch")
        }
        w.store_local(cslot, 0, ch)
        if ak == ast.NK_SEL_SEND {
            vn := p.nodes[ar].b
            vty := tp.deref(tp.type_of(vn))
            v := w.own_val(p, tp, vn, w.lower_expr(p, tp, vn), vty)
            $buf := -1
            if w.needs_drop(tp, vty) {
                bslot := w.own_temp_slot(tp, vty, "selv")
                buf = w.addr_local(bslot)
            } else {
                buf = w.chan_elem_slot(tp, vty)
            }
            if is_wide(tp, vty) {
                w.copy_mem(buf, v, tp.size_of(vty))
            } else {
                w.store_ptr(buf, 0, v, 8)
            }
            bufs.push(buf)
            sizes.push(chan_esize(tp, vty))
            send_vtys.push(vty)
        } else {
            ety := w.local_type(tp, tp.local_of(ar))
            bufs.push(w.chan_elem_slot(tp, ety))
            sizes.push(chan_esize(tp, ety))
            send_vtys.push(-1)
        }
        arms.push(ar)
        chans.push(cslot)
        ar = p.nodes[ar].next
    }
    w.scope_truncate(sel_mark)
    poll_b := w.new_block()
    done_b := w.new_block()
    w.jump(poll_b)
    w.f.active_bb = poll_b
    for i in 0:arms.len {
        a := arms[i]
        $args := []int{}
        args.push(w.load_local(chans[i], 0))
        args.push(bufs[i])
        args.push(w.konst(sizes[i]))
        $r := -1
        if p.nodes[a].kind == ast.NK_SEL_SEND {
            r = w.call_core("chan_try_send", &args)
        } else {
            r = w.call_core("chan_try_recv", &args)
        }
        arm_b := w.new_block()
        next_b := w.new_block()
        w.branch(r, arm_b, next_b)
        w.f.active_bb = arm_b
        w.drop_unselected_sends(p, tp, &arms, &bufs, &send_vtys, i)
        for ci in 0:arms.len {
            cn := p.nodes[arms[ci]].a
            ct := tp.deref(tp.type_of(cn))
            w.drop_temp(p, tp, cn, w.load_local(chans[ci], 0), ct)
        }
        mark := w.scope_ids.len
        if p.nodes[a].kind == ast.NK_SEL_RECV {
            id := tp.local_of(a)
            w.store_to_local(tp, id, w.chan_elem_value(tp, bufs[i], w.local_type(tp, id)))
            // The arm owns the element it received.
            w.own_declare(tp, id)
        }
        w.lower_block(p, tp, p.nodes[a].c)
        if w.scope_ids.len > mark {
            if w.open() {
                w.drop_owned_from(mark)
            }
            w.scope_truncate(mark)
        }
        w.jump(done_b)
        w.f.active_bb = next_b
    }
    if p.nodes[s].ival == 1 || p.nodes[s].c >= 0 {
        w.drop_unselected_sends(p, tp, &arms, &bufs, &send_vtys, -1)
        for ci in 0:arms.len {
            cn := p.nodes[arms[ci]].a
            ct := tp.deref(tp.type_of(cn))
            w.drop_temp(p, tp, cn, w.load_local(chans[ci], 0), ct)
        }
        w.lower_block(p, tp, p.nodes[s].c)
        w.jump(done_b)
    } else {
        w.call_noargs(w.core("task_block"))
        w.jump(poll_b)
    }
    w.f.active_bb = done_b
}

// ===== shared channel records =====

// Give up the holder of the channel whose handle is at address a. The last
// holder drops the unread elements and frees the channel.
fn (w $&Lw) chan_drop(tp &types.TypedProgram, a int, ty int) {
    ch := w.new_local(1, 1, "chd")
    w.store_local(ch, 0, w.load_ptr(a, 0, 8))
    $rargs := []int{}
    rargs.push(w.load_local(ch, 0))
    last := w.call_core("chan_release", &rargs)
    last_b := w.new_block()
    done_b := w.new_block()
    w.branch(last, last_b, done_b)
    w.f.active_bb = last_b
    ety := tp.chan_elems[types.chan_index(ty)]
    if w.needs_drop(tp, ety) {
        buf := w.chan_elem_slot(tp, ety)
        bslot := w.new_local(1, 1, "chb")
        w.store_local(bslot, 0, buf)
        cond_b := w.new_block()
        body_b := w.new_block()
        free_b := w.new_block()
        w.jump(cond_b)
        w.f.active_bb = cond_b
        $targs := []int{}
        targs.push(w.load_local(ch, 0))
        targs.push(w.load_local(bslot, 0))
        targs.push(w.konst(chan_esize(tp, ety)))
        got := w.call_core("chan_take_unread", &targs)
        w.branch(got, body_b, free_b)
        w.f.active_bb = body_b
        w.drop_value(tp, w.load_local(bslot, 0), ety)
        w.jump(cond_b)
        w.f.active_bb = free_b
    }
    $fargs := []int{}
    fargs.push(w.load_local(ch, 0))
    w.call_core("chan_free", &fargs)
    w.jump(done_b)
    w.f.active_bb = done_b
}
