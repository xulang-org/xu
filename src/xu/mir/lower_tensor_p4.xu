@xu/mir

#xu/mir/ai

#xu/ast
#xu/parser
#xu/types

// Lower 4-row contiguous pre-packed (p4) quantized GEMV and Prefill GEMM loops:
//   1. GEMV Q4_0_p4 x Q8_0: for rg in 0:rg_cnt { g_off := p4_blk_off + rg * nb; out_off := ...; for r4 in 0:4 { ... } }
//   2. GEMV Q8_0_p4 x Q8_0: same with 128B/block weights and 32-elem Q8xQ8 inner loop
//   3. GEMM Q4_0_p4 x Q8_0: for m in 0:m_cnt { xm_s := m * nb; xm_q := xm_s * 32; m_out := m * rows; GEMV_Q4_p4(...) }
const TENSOR_U16 = 12

struct TensorGemvP4Plan {
    loop int
    is_q8 bool
    is_f16_scale bool
    is_k4 bool
    signed_nibbles bool
    rg_cnt int
    n_blocks int
    out int
    qs_p int
    ws_p int
    xq int
    xs int
    blk_off int
    off_out int
    off_xq int
    off_xs int
}

struct TensorGemmP4Plan {
    loop int
    is_q8 bool
    is_f16_scale bool
    is_k4 bool
    signed_nibbles bool
    m_bound int
    rg_bound int
    nb_bound int
    rows_bound int
    out int
    qs_p int
    ws_p int
    xq int
    xs int
    blk_off int
    off_out int
    off_xs int
}

// Each XOR toggles the sign bit of both packed Q4 nibbles.
fn tensor_p4k4_sign_flip(p &parser.Parser, expr int) bool {
    << expr >= 0 && p.nodes[expr].kind == ast.NK_BIN_OP &&
       p.nodes[expr].ival == ast.OP_BIT_XOR && ai.tensor_int_lit(p, p.nodes[expr].b, 136)
}

fn (w &Lw) tensor_p4_scale_arg(p &parser.Parser, tp &types.TypedProgram, n int, gb_id int, r4_iv int, is_f16 $&bool) int {
    if n < 0 { << -1 }
    if p.nodes[n].kind == ast.NK_INDEX && tp.type_of(n) == ai.TENSOR_F32 {
        ws_p := p.nodes[n].a
        if w.tensor_f32_array_base(p, tp, ws_p) && ai.tensor_p4_scale_idx(p, tp, p.nodes[n].b, gb_id, r4_iv) {
            *is_f16 = false
            << ws_p
        }
        << -1
    }
    k := p.nodes[n].kind
    if k != ast.NK_CALL && k != ast.NK_METHOD_CALL { << -1 }
    fi := tp.call_of(n)
    if fi < 0 || fi >= tp.fns.len || tp.fns[fi].label != "_xu_math_float16_to_f32" { << -1 }
    $arg := p.nodes[n].a
    if k == ast.NK_METHOD_CALL { arg = p.nodes[n].b }
    if arg < 0 || p.nodes[arg].next >= 0 || p.nodes[arg].kind != ast.NK_CAST || tp.type_of(arg) != 1 { << -1 }
    idx := p.nodes[arg].a
    if idx < 0 || p.nodes[idx].kind != ast.NK_INDEX || tp.type_of(idx) != TENSOR_U16 { << -1 }
    ws_p := p.nodes[idx].a
    if !w.tensor_typed_array_base(p, tp, ws_p, TENSOR_U16) ||
       !ai.tensor_p4_scale_idx(p, tp, p.nodes[idx].b, gb_id, r4_iv) {
        << -1
    }
    *is_f16 = true
    << ws_p
}

fn (w &Lw) tensor_gemv_p4_plan_in(p &parser.Parser, tp &types.TypedProgram, rg_loop int,
                                  is_q8 bool, allow &[]int) TensorGemvP4Plan {
    no_match := TensorGemvP4Plan{loop: -1, is_q8: is_q8, is_f16_scale: false, is_k4: false, signed_nibbles: false,
                                 rg_cnt: -1, n_blocks: -1,
                                 out: -1, qs_p: -1, ws_p: -1, xq: -1, xs: -1,
                                 blk_off: -2, off_out: -2, off_xq: -2, off_xs: -2}
    rg_cnt := ai.tensor_dynamic_bound(p, rg_loop)
    if !w.tensor_dot_bound_ok(p, tp, rg_cnt) { << no_match }
    rg_iv := tp.local_of(rg_loop)
    if rg_iv < 0 { << no_match }

    // g_off := [p4_blk_off +] rg * nb
    s1 := p.nodes[rg_loop].c
    if s1 < 0 || p.nodes[s1].kind != ast.NK_LET { << no_match }
    g_off_id := tp.local_of(s1)
    if g_off_id < 0 || w.local_type(tp, g_off_id) != 1 { << no_match }

    // out_off := [m_out +] rg * 4
    s2 := p.nodes[s1].next
    if s2 < 0 || p.nodes[s2].kind != ast.NK_LET { << no_match }
    out_off_id := tp.local_of(s2)
    if out_off_id < 0 || out_off_id == g_off_id || w.local_type(tp, out_off_id) != 1 { << no_match }
    off_out := w.tensor_scaled_offset_in(p, tp, p.nodes[s2].a, rg_iv, 4, allow)
    if off_out == -2 { << no_match }

    // for r4 in 0:4
    r4_loop := p.nodes[s2].next
    if r4_loop < 0 || p.nodes[r4_loop].next >= 0 || ai.static_range_extent(p, r4_loop) != 4 { << no_match }
    r4_iv := tp.local_of(r4_loop)
    if r4_iv < 0 || r4_iv == rg_iv { << no_match }

    // $acc := f32(0)
    r1 := p.nodes[r4_loop].c
    if r1 < 0 || p.nodes[r1].kind != ast.NK_LET || !ai.tensor_is_f32_zero(p, tp, p.nodes[r1].a) {
        << no_match
    }
    acc_id := tp.local_of(r1)
    if acc_id < 0 || w.local_type(tp, acc_id) != ai.TENSOR_F32 { << no_match }

    // for b in 0:nb
    b_loop := p.nodes[r1].next
    if b_loop < 0 || p.nodes[b_loop].kind != ast.NK_FOR { << no_match }
    nb := ai.tensor_dynamic_bound(p, b_loop)
    if !w.tensor_dot_bound_ok(p, tp, nb) { << no_match }
    b_iv := tp.local_of(b_loop)
    if b_iv < 0 || b_iv == rg_iv || b_iv == r4_iv { << no_match }

    // Confirm g_off uses nb
    blk_off := w.tensor_bound_offset(p, tp, p.nodes[s1].a, rg_iv, nb)
    if blk_off == -2 { << no_match }

    // gb := g_off + b
    bs1 := p.nodes[b_loop].c
    if bs1 < 0 || p.nodes[bs1].kind != ast.NK_LET { << no_match }
    gb_id := tp.local_of(bs1)
    if gb_id < 0 || w.local_type(tp, gb_id) != 1 || !ai.tensor_add_local_iv(p, tp, p.nodes[bs1].a, g_off_id, b_iv) {
        << no_match
    }

    // q_base := gb * (64|128) + r4 * (16|32)   [or + r4 * 4 for p4k4]
    $q_blk_b := 64
    $q_row_b := 16
    if is_q8 {
        q_blk_b = 128
        q_row_b = 32
    }
    bs2 := p.nodes[bs1].next
    if bs2 < 0 || p.nodes[bs2].kind != ast.NK_LET { << no_match }
    q_base_id := tp.local_of(bs2)
    if q_base_id < 0 || q_base_id == gb_id || w.local_type(tp, q_base_id) != 1 { << no_match }
    $is_k4 := false
    if ai.tensor_p4_add_scaled_iv(p, tp, p.nodes[bs2].a, gb_id, q_blk_b, r4_iv, q_row_b) {
        is_k4 = false
    } else if ai.tensor_p4_add_scaled_iv(p, tp, p.nodes[bs2].a, gb_id, q_blk_b, r4_iv, 4) {
        is_k4 = true
    } else {
        << no_match
    }

    // x_base := [xm_q +] b * 32
    bs3 := p.nodes[bs2].next
    if bs3 < 0 || p.nodes[bs3].kind != ast.NK_LET { << no_match }
    x_base_id := tp.local_of(bs3)
    if x_base_id < 0 || x_base_id == q_base_id || w.local_type(tp, x_base_id) != 1 { << no_match }
    off_xq := w.tensor_scaled_offset_in(p, tp, p.nodes[bs3].a, b_iv, 32, allow)
    if off_xq == -2 { << no_match }

    // $isum := 0
    bs4 := p.nodes[bs3].next
    if bs4 < 0 || p.nodes[bs4].kind != ast.NK_LET || !ai.tensor_int_zero(p, p.nodes[bs4].a) {
        << no_match
    }
    isum_id := tp.local_of(bs4)
    if isum_id < 0 || w.local_type(tp, isum_id) != 1 { << no_match }

    // j loop (0:16 for q4, 0:32 for q8)
    bs5 := p.nodes[bs4].next
    if ai.static_range_extent(p, bs5) != q_row_b { << no_match }
    j_iv := tp.local_of(bs5)
    if j_iv < 0 || j_iv == b_iv { << no_match }

    $signed_nibbles := false
    $qs_p := -1
    $xq := -1
    if is_q8 {
        mul_stmt := ai.tensor_assignment(p, p.nodes[bs5].c, ast.AS_ADD, ast.OP_MUL)
        if mul_stmt < 0 || !ai.tensor_ident_id(p, tp, p.nodes[mul_stmt].a, isum_id) { << no_match }
        prod := p.nodes[mul_stmt].b
        if tp.type_of(prod) != 1 { << no_match }
        pa := p.nodes[prod].a
        pb := p.nodes[prod].b
        if is_k4 {
            qs_p = ai.tensor_i8_cast_p4k4_ident(p, tp, pa, q_base_id, j_iv)
            xq = ai.tensor_i8_cast_ident(p, tp, pb, x_base_id, j_iv)
            if qs_p < 0 || xq < 0 {
                qs_p = ai.tensor_i8_cast_p4k4_ident(p, tp, pb, q_base_id, j_iv)
                xq = ai.tensor_i8_cast_ident(p, tp, pa, x_base_id, j_iv)
            }
        } else {
            qs_p = ai.tensor_i8_cast_ident(p, tp, pa, q_base_id, j_iv)
            xq = ai.tensor_i8_cast_ident(p, tp, pb, x_base_id, j_iv)
            if qs_p < 0 || xq < 0 {
                qs_p = ai.tensor_i8_cast_ident(p, tp, pb, q_base_id, j_iv)
                xq = ai.tensor_i8_cast_ident(p, tp, pa, x_base_id, j_iv)
            }
        }
        if qs_p < 0 || xq < 0 || !w.tensor_typed_array_base(p, tp, qs_p, ai.TENSOR_I8) ||
           !w.tensor_typed_array_base(p, tp, xq, ai.TENSOR_I8) {
            << no_match
        }
    } else {
        is1 := p.nodes[bs5].c
        if is1 < 0 || p.nodes[is1].kind != ast.NK_LET { << no_match }
        bv_id := tp.local_of(is1)
        if bv_id < 0 || w.local_type(tp, bv_id) != 1 { << no_match }
        $bv_cast := p.nodes[is1].a
        if is_k4 && tensor_p4k4_sign_flip(p, bv_cast) {
            signed_nibbles = true
            bv_cast = p.nodes[bv_cast].a
        }
        if bv_cast < 0 || p.nodes[bv_cast].kind != ast.NK_CAST || tp.type_of(bv_cast) != 1 { << no_match }
        qs_idx := p.nodes[bv_cast].a
        if qs_idx < 0 || p.nodes[qs_idx].kind != ast.NK_INDEX || tp.type_of(qs_idx) != TENSOR_U8 { << no_match }
        qs_p = p.nodes[qs_idx].a
        $qs_idx_ok := false
        if is_k4 {
            qs_idx_ok = ai.tensor_p4k4_idx(p, tp, p.nodes[qs_idx].b, q_base_id, j_iv)
        } else {
            qs_idx_ok = ai.tensor_add_local_iv(p, tp, p.nodes[qs_idx].b, q_base_id, j_iv)
        }
        if !w.tensor_typed_array_base(p, tp, qs_p, TENSOR_U8) || !qs_idx_ok {
            << no_match
        }
        is2 := p.nodes[is1].next
        if is2 < 0 || p.nodes[is2].kind != ast.NK_LET { << no_match }
        q0_id := tp.local_of(is2)
        q0_sub := p.nodes[is2].a
        if q0_id < 0 || w.local_type(tp, q0_id) != 1 || q0_sub < 0 || p.nodes[q0_sub].kind != ast.NK_BIN_OP ||
           p.nodes[q0_sub].ival != ast.OP_SUB || !ai.tensor_bit_and_byte_15(p, tp, p.nodes[q0_sub].a, bv_id) ||
           !ai.tensor_int_lit(p, p.nodes[q0_sub].b, 8) {
            << no_match
        }
        is3 := p.nodes[is2].next
        if is3 < 0 || p.nodes[is3].kind != ast.NK_LET { << no_match }
        q1_id := tp.local_of(is3)
        q1_sub := p.nodes[is3].a
        if q1_id < 0 || q1_id == q0_id || w.local_type(tp, q1_id) != 1 || q1_sub < 0 || p.nodes[q1_sub].kind != ast.NK_BIN_OP ||
           p.nodes[q1_sub].ival != ast.OP_SUB || !ai.tensor_shr_byte_4(p, tp, p.nodes[q1_sub].a, bv_id) ||
           !ai.tensor_int_lit(p, p.nodes[q1_sub].b, 8) {
            << no_match
        }
        is4 := p.nodes[is3].next
        if is4 < 0 || p.nodes[is4].kind != ast.NK_ASSIGN || p.nodes[is4].ival != ast.AS_ADD ||
           p.nodes[is4].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[is4].a, isum_id) {
            << no_match
        }
        pair := p.nodes[is4].b
        if pair < 0 || p.nodes[pair].kind != ast.NK_BIN_OP || p.nodes[pair].ival != ast.OP_ADD || tp.type_of(pair) != 1 {
            << no_match
        }
        $xq0 := -1
        $xq1 := -1
        if !ai.tensor_q4_q8_term(p, tp, p.nodes[pair].a, q0_id, x_base_id, 0, j_iv, $&xq0) ||
           !ai.tensor_q4_q8_term(p, tp, p.nodes[pair].b, q1_id, x_base_id, 16, j_iv, $&xq1) {
            << no_match
        }
        if !w.tensor_typed_array_base(p, tp, xq0, ai.TENSOR_I8) || !w.tensor_typed_array_base(p, tp, xq1, ai.TENSOR_I8) ||
           tp.local_of(xq0) != tp.local_of(xq1) {
            << no_match
        }
        xq = xq0
    }

    // acc += f32(isum) * (ws_p[gb * 4 + r4] * xs[[xm_s +] b])
    bs6 := p.nodes[bs5].next
    if bs6 < 0 || p.nodes[bs6].next >= 0 { << no_match }
    stmt6 := ai.tensor_assignment(p, bs6, ast.AS_ADD, ast.OP_MUL)
    if stmt6 < 0 || !ai.tensor_ident_id(p, tp, p.nodes[stmt6].a, acc_id) { << no_match }
    mul6 := p.nodes[stmt6].b
    if tp.type_of(mul6) != ai.TENSOR_F32 { << no_match }
    $smul := -1
    if ai.tensor_f32_cast_ident(p, tp, p.nodes[mul6].a, isum_id) {
        smul = p.nodes[mul6].b
    } else if ai.tensor_f32_cast_ident(p, tp, p.nodes[mul6].b, isum_id) {
        smul = p.nodes[mul6].a
    } else {
        << no_match
    }
    if smul < 0 || p.nodes[smul].kind != ast.NK_BIN_OP || p.nodes[smul].ival != ast.OP_MUL || tp.type_of(smul) != ai.TENSOR_F32 {
        << no_match
    }
    si_a := p.nodes[smul].a
    si_b := p.nodes[smul].b
    $is_f16_scale := false
    $ws_p := -1
    $xs_idx := -1
    cand_ws_a := w.tensor_p4_scale_arg(p, tp, si_a, gb_id, r4_iv, $&is_f16_scale)
    if cand_ws_a >= 0 && si_b >= 0 && p.nodes[si_b].kind == ast.NK_INDEX && tp.type_of(si_b) == ai.TENSOR_F32 {
        ws_p = cand_ws_a
        xs_idx = si_b
    } else {
        cand_ws_b := w.tensor_p4_scale_arg(p, tp, si_b, gb_id, r4_iv, $&is_f16_scale)
        if cand_ws_b >= 0 && si_a >= 0 && p.nodes[si_a].kind == ast.NK_INDEX && tp.type_of(si_a) == ai.TENSOR_F32 {
            ws_p = cand_ws_b
            xs_idx = si_a
        } else {
            << no_match
        }
    }
    xs := p.nodes[xs_idx].a
    if !w.tensor_f32_array_base(p, tp, xs) { << no_match }
    off_xs := w.tensor_dot_offset_in(p, tp, p.nodes[xs_idx].b, b_iv, allow)
    if off_xs == -2 { << no_match }

    // out[out_off + r4] = acc
    r3 := p.nodes[b_loop].next
    if r3 < 0 || p.nodes[r3].kind != ast.NK_ASSIGN || p.nodes[r3].ival != ast.AS_ASSIGN ||
       p.nodes[r3].next >= 0 || !ai.tensor_ident_id(p, tp, p.nodes[r3].b, acc_id) {
        << no_match
    }
    out_idx := p.nodes[r3].a
    if out_idx < 0 || p.nodes[out_idx].kind != ast.NK_INDEX || tp.type_of(out_idx) != ai.TENSOR_F32 { << no_match }
    out := p.nodes[out_idx].a
    if !w.tensor_f32_array_base(p, tp, out) || !ai.tensor_add_local_iv(p, tp, p.nodes[out_idx].b, out_off_id, r4_iv) {
        << no_match
    }

    << TensorGemvP4Plan{loop: rg_loop, is_q8: is_q8, is_f16_scale: is_f16_scale, is_k4: is_k4, signed_nibbles: signed_nibbles,
                        rg_cnt: rg_cnt, n_blocks: nb,
                        out: out, qs_p: qs_p, ws_p: ws_p, xq: xq, xs: xs,
                        blk_off: blk_off, off_out: off_out, off_xq: off_xq, off_xs: off_xs}
}

// P4 guards cap every start and end at 2^56 before accepting the fast
// path. Within that range signed comparisons also order byte addresses.
fn (w $&Lw) tensor_bounded_disjoint_ranges(a int, a_span int, b int, b_span int) int {
    a_end := w.bin(BIN_ADD, a, a_span)
    b_end := w.bin(BIN_ADD, b, b_span)
    << w.bin(BIN_OR, w.bin(BIN_LE, a_end, b), w.bin(BIN_LE, b_end, a))
}

fn (w $&Lw) lower_tensor_gemv_p4(p &parser.Parser, tp &types.TypedProgram, loop int) int {
    if w.tgt_arch != 0 && w.tgt_arch != 1 { << -1 }
    empty := []int{}
    $plan := w.tensor_gemv_p4_plan_in(p, tp, loop, false, &empty)
    if plan.loop < 0 {
        plan = w.tensor_gemv_p4_plan_in(p, tp, loop, true, &empty)
    }
    if plan.loop < 0 { << -1 }
    if plan.is_k4 && !plan.is_f16_scale { << -1 }
    if plan.off_out >= 0 || plan.off_xq >= 0 || plan.off_xs >= 0 { << -1 }

    w.cur_line = p.nodes[plan.loop].line
    rg := w.lower_expr(p, tp, plan.rg_cnt)
    done := w.new_block()
    pos_rg := w.new_block()
    w.branch(w.bin(BIN_GT, rg, w.konst(0)), pos_rg, done)

    w.f.active_bb = pos_rg
    nb := w.lower_expr(p, tp, plan.n_blocks)
    check := w.new_block()
    slow := w.new_block()
    w.branch(w.bin(BIN_GT, nb, w.konst(0)), check, slow)

    w.f.active_bb = check
    cap_rc := w.konst(1 << 24)
    rc_fits := w.bin(BIN_AND, w.bin(BIN_LE, rg, cap_rc), w.bin(BIN_LE, nb, cap_rc))
    blk_limit := w.konst(1 << 46)
    off_limit := w.konst(1 << 54)
    $q_blk_bytes := 64
    if plan.is_q8 { q_blk_bytes = 128 }
    rows := w.bin(BIN_MUL, rg, w.konst(4))
    grp_cnt := w.bin(BIN_MUL, rg, nb)
    q_elems := w.bin(BIN_MUL, grp_cnt, w.konst(q_blk_bytes))
    ws_elems := w.bin(BIN_MUL, grp_cnt, w.konst(4))
    xq_elems := w.bin(BIN_MUL, nb, w.konst(32))

    $ws_eb := 4
    if plan.is_f16_scale { ws_eb = 2 }
    op_out := w.tensor_strided_operand(p, tp, plan.out, -1, rows, 4, off_limit)
    op_qs := w.tensor_scaled_block_operand(p, tp, plan.qs_p, plan.blk_off, q_blk_bytes, q_elems, 1, blk_limit)
    op_ws := w.tensor_scaled_block_operand(p, tp, plan.ws_p, plan.blk_off, 4, ws_elems, ws_eb, blk_limit)
    op_xq := w.tensor_strided_operand(p, tp, plan.xq, -1, xq_elems, 1, off_limit)
    op_xs := w.tensor_strided_operand(p, tp, plan.xs, -1, nb, 4, off_limit)

    out_span := w.bin(BIN_MUL, rows, w.konst(4))
    ws_span := w.bin(BIN_MUL, ws_elems, w.konst(ws_eb))
    xs_span := w.bin(BIN_MUL, nb, w.konst(4))
    addr_lim := w.konst(1 << 56)
    addr_ok := w.bin(BIN_AND, w.u64_bin(BIN_LE, op_out.ptr, w.bin(BIN_SUB, addr_lim, out_span)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_qs.ptr, w.bin(BIN_SUB, addr_lim, q_elems)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_ws.ptr, w.bin(BIN_SUB, addr_lim, ws_span)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_xq.ptr, w.bin(BIN_SUB, addr_lim, xq_elems)),
                              w.u64_bin(BIN_LE, op_xs.ptr, w.bin(BIN_SUB, addr_lim, xs_span))))))
    disj := w.bin(BIN_AND, w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_qs.ptr, q_elems),
            w.bin(BIN_AND, w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_ws.ptr, ws_span),
            w.bin(BIN_AND, w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_xq.ptr, xq_elems),
                           w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_xs.ptr, xs_span))))

    valid := w.bin(BIN_AND, rc_fits,
             w.bin(BIN_AND, op_out.valid,
             w.bin(BIN_AND, op_qs.valid,
             w.bin(BIN_AND, op_ws.valid,
             w.bin(BIN_AND, op_xq.valid,
             w.bin(BIN_AND, op_xs.valid, w.bin(BIN_AND, addr_ok, disj)))))))
    fast := w.new_block()
    w.branch(valid, fast, slow)

    w.f.active_bb = fast
    packed := w.bin(BIN_OR, w.bin(BIN_SHL, rg, w.konst(32)), nb)
    $stub := "__xu_tensor_gemv4_q4_0_p4_q8_0_f32"
    if plan.signed_nibbles {
        stub = "__xu_tensor_gemv4_q4_0_p4k4_signed_f16_q8_0_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_gemv4_q4_0_p4k4_signed_f16_q8_0_fast_f32" }
    } else if plan.is_k4 {
        if plan.is_q8 {
            stub = "__xu_tensor_gemv4_q8_0_p4k4_f16_q8_0_f32"
            if w.tensor_fast_math { stub = "__xu_tensor_gemv4_q8_0_p4k4_f16_q8_0_fast_f32" }
        } else {
            stub = "__xu_tensor_gemv4_q4_0_p4k4_f16_q8_0_f32"
            if w.tensor_fast_math { stub = "__xu_tensor_gemv4_q4_0_p4k4_f16_q8_0_fast_f32" }
        }
    } else if plan.is_f16_scale {
        if plan.is_q8 {
            stub = "__xu_tensor_gemv4_q8_0_p4_f16_q8_0_f32"
            if w.tensor_fast_math { stub = "__xu_tensor_gemv4_q8_0_p4_f16_q8_0_fast_f32" }
        } else {
            stub = "__xu_tensor_gemv4_q4_0_p4_f16_q8_0_f32"
            if w.tensor_fast_math { stub = "__xu_tensor_gemv4_q4_0_p4_f16_q8_0_fast_f32" }
        }
    } else if plan.is_q8 {
        stub = "__xu_tensor_gemv4_q8_0_p4_q8_0_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_gemv4_q8_0_p4_q8_0_fast_f32" }
    } else if w.tensor_fast_math {
        stub = "__xu_tensor_gemv4_q4_0_p4_q8_0_fast_f32"
    }
    $args := []int{}
    args.push(op_out.ptr)
    args.push(op_qs.ptr)
    args.push(op_ws.ptr)
    args.push(op_xq.ptr)
    args.push(op_xs.ptr)
    args.push(packed)
    w.call(stub, &args)
    w.jump(done)

    w.f.active_bb = slow
    w.lower_stmt(p, tp, plan.loop)
    w.jump(done)

    w.f.active_bb = done
    << plan.loop
}

fn (w &Lw) tensor_gemm_p4_plan(p &parser.Parser, tp &types.TypedProgram, m_loop int) TensorGemmP4Plan {
    no_match := TensorGemmP4Plan{loop: -1, is_q8: false, is_f16_scale: false, is_k4: false, signed_nibbles: false,
                                 m_bound: -1, rg_bound: -1, nb_bound: -1, rows_bound: -1,
                                 out: -1, qs_p: -1, ws_p: -1, xq: -1, xs: -1,
                                 blk_off: -2, off_out: -2, off_xs: -2}
    m_bound := ai.tensor_dynamic_bound(p, m_loop)
    if !w.tensor_dot_bound_ok(p, tp, m_bound) { << no_match }
    m_iv := tp.local_of(m_loop)
    if m_iv < 0 { << no_match }

    s1 := p.nodes[m_loop].c
    $s2 := -1
    $s3 := -1
    if s1 >= 0 { s2 = p.nodes[s1].next }
    if s2 >= 0 { s3 = p.nodes[s2].next }
    if s1 < 0 || s2 < 0 || s3 < 0 ||
       p.nodes[s1].kind != ast.NK_LET || p.nodes[s2].kind != ast.NK_LET || p.nodes[s3].kind != ast.NK_LET {
        << no_match
    }
    id1 := tp.local_of(s1)
    id2 := tp.local_of(s2)
    id3 := tp.local_of(s3)
    if id1 < 0 || id2 < 0 || id3 < 0 || id1 == id2 || id1 == id3 || id2 == id3 ||
       w.local_type(tp, id1) != 1 || w.local_type(tp, id2) != 1 || w.local_type(tp, id3) != 1 {
        << no_match
    }
    s4 := p.nodes[s3].next
    if s4 < 0 || p.nodes[s4].kind != ast.NK_FOR || p.nodes[s4].next >= 0 { << no_match }

    allow := [id1, id2, id3]
    $inner := w.tensor_gemv_p4_plan_in(p, tp, s4, false, &allow)
    if inner.loop < 0 && w.tgt_arch == 0 {
        inner = w.tensor_gemv_p4_plan_in(p, tp, s4, true, &allow)
        if !inner.is_k4 || !inner.is_f16_scale { << no_match }
    }
    if inner.loop < 0 || inner.off_out < 0 || inner.off_xq < 0 || inner.off_xs < 0 { << no_match }
    if inner.blk_off >= 0 && ai.range_uses_iv(p, tp, inner.blk_off, m_iv) { << no_match }

    $xs_stmt := -1
    $xq_stmt := -1
    $out_stmt := -1
    if ai.tensor_ident_id(p, tp, inner.off_xs, id1) &&
       ai.tensor_ident_id(p, tp, inner.off_xq, id2) &&
       ai.tensor_ident_id(p, tp, inner.off_out, id3) {
        xs_stmt = s1
        xq_stmt = s2
        out_stmt = s3
    } else {
        << no_match
    }

    off_xs := w.tensor_bound_offset(p, tp, p.nodes[xs_stmt].a, m_iv, inner.n_blocks)
    if off_xs == -2 { << no_match }
    if !ai.tensor_scaled_mul_iv(p, tp, p.nodes[xq_stmt].a, id1, 32) { << no_match }
    out_expr := p.nodes[out_stmt].a
    if out_expr < 0 || p.nodes[out_expr].kind != ast.NK_BIN_OP || p.nodes[out_expr].ival != ast.OP_MUL {
        << no_match
    }
    $rows_node := -1
    if ai.range_uses_iv(p, tp, p.nodes[out_expr].a, m_iv) {
        rows_node = p.nodes[out_expr].b
    } else if ai.range_uses_iv(p, tp, p.nodes[out_expr].b, m_iv) {
        rows_node = p.nodes[out_expr].a
    } else {
        << no_match
    }
    if !w.tensor_dot_bound_ok(p, tp, rows_node) { << no_match }

    << TensorGemmP4Plan{loop: m_loop, is_q8: inner.is_q8, is_f16_scale: inner.is_f16_scale, is_k4: inner.is_k4, signed_nibbles: inner.signed_nibbles,
                        m_bound: m_bound, rg_bound: inner.rg_cnt, nb_bound: inner.n_blocks,
                        rows_bound: rows_node, out: inner.out, qs_p: inner.qs_p, ws_p: inner.ws_p,
                        xq: inner.xq, xs: inner.xs, blk_off: inner.blk_off, off_out: -1, off_xs: off_xs}
}

fn (w $&Lw) lower_tensor_gemm_p4(p &parser.Parser, tp &types.TypedProgram, loop int) int {
    if w.tgt_arch != 0 && w.tgt_arch != 1 { << -1 }
    plan := w.tensor_gemm_p4_plan(p, tp, loop)
    if plan.loop < 0 { << -1 }
    if plan.is_k4 && !plan.is_f16_scale { << -1 }

    w.cur_line = p.nodes[plan.loop].line
    m_val := w.lower_expr(p, tp, plan.m_bound)
    done := w.new_block()
    pos_m := w.new_block()
    w.branch(w.bin(BIN_GT, m_val, w.konst(0)), pos_m, done)

    w.f.active_bb = pos_m
    rg_val := w.lower_expr(p, tp, plan.rg_bound)
    nb_val := w.lower_expr(p, tp, plan.nb_bound)
    rows_val := w.lower_expr(p, tp, plan.rows_bound)
    check := w.new_block()
    slow := w.new_block()
    dims_pos := w.bin(BIN_AND, w.bin(BIN_GT, rg_val, w.konst(0)),
                w.bin(BIN_AND, w.bin(BIN_GT, nb_val, w.konst(0)),
                               w.bin(BIN_EQ, rows_val, w.bin(BIN_MUL, rg_val, w.konst(4)))))
    w.branch(dims_pos, check, slow)

    w.f.active_bb = check
    m_cap := w.konst((1 << 21) - 1)
    dims_fit := w.bin(BIN_AND, w.bin(BIN_LE, m_val, m_cap),
                w.bin(BIN_AND, w.bin(BIN_LE, rg_val, m_cap), w.bin(BIN_LE, nb_val, m_cap)))
    blk_limit := w.konst(1 << 46)
    off_limit := w.konst(1 << 54)
    out_elems := w.bin(BIN_MUL, m_val, rows_val)
    grp_cnt := w.bin(BIN_MUL, rg_val, nb_val)
    $q_blk_bytes := 64
    if plan.is_q8 { q_blk_bytes = 128 }
    q_elems := w.bin(BIN_MUL, grp_cnt, w.konst(q_blk_bytes))
    ws_elems := w.bin(BIN_MUL, grp_cnt, w.konst(4))
    xs_elems := w.bin(BIN_MUL, m_val, nb_val)
    xq_elems := w.bin(BIN_MUL, xs_elems, w.konst(32))

    $ws_eb := 4
    if plan.is_f16_scale { ws_eb = 2 }
    op_out := w.tensor_strided_operand(p, tp, plan.out, plan.off_out, out_elems, 4, off_limit)
    op_qs := w.tensor_scaled_block_operand(p, tp, plan.qs_p, plan.blk_off, q_blk_bytes, q_elems, 1, blk_limit)
    op_ws := w.tensor_scaled_block_operand(p, tp, plan.ws_p, plan.blk_off, 4, ws_elems, ws_eb, blk_limit)
    op_xs := w.tensor_strided_operand(p, tp, plan.xs, plan.off_xs, xs_elems, 4, off_limit)
    $off_xq := -1
    if plan.off_xs >= 0 { off_xq = -2 }
    $op_xq := w.tensor_strided_operand(p, tp, plan.xq, -1, xq_elems, 1, off_limit)
    if off_xq == -2 {
        // Non-zero xs offset implies xq offset is off_xs * 32; keep scalar fallback cleanly.
        op_xq.valid = w.konst(0)
    }

    out_span := w.bin(BIN_MUL, out_elems, w.konst(4))
    ws_span := w.bin(BIN_MUL, ws_elems, w.konst(ws_eb))
    xs_span := w.bin(BIN_MUL, xs_elems, w.konst(4))
    addr_lim := w.konst(1 << 56)
    addr_ok := w.bin(BIN_AND, w.u64_bin(BIN_LE, op_out.ptr, w.bin(BIN_SUB, addr_lim, out_span)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_qs.ptr, w.bin(BIN_SUB, addr_lim, q_elems)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_ws.ptr, w.bin(BIN_SUB, addr_lim, ws_span)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_xq.ptr, w.bin(BIN_SUB, addr_lim, xq_elems)),
                              w.u64_bin(BIN_LE, op_xs.ptr, w.bin(BIN_SUB, addr_lim, xs_span))))))
    disj := w.bin(BIN_AND, w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_qs.ptr, q_elems),
            w.bin(BIN_AND, w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_ws.ptr, ws_span),
            w.bin(BIN_AND, w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_xq.ptr, xq_elems),
                           w.tensor_bounded_disjoint_ranges(op_out.ptr, out_span, op_xs.ptr, xs_span))))

    valid := w.bin(BIN_AND, dims_fit,
             w.bin(BIN_AND, op_out.valid,
             w.bin(BIN_AND, op_qs.valid,
             w.bin(BIN_AND, op_ws.valid,
             w.bin(BIN_AND, op_xq.valid,
             w.bin(BIN_AND, op_xs.valid, w.bin(BIN_AND, addr_ok, disj)))))))
    fast := w.new_block()
    w.branch(valid, fast, slow)

    w.f.active_bb = fast
    packed := w.bin(BIN_OR, w.bin(BIN_SHL, m_val, w.konst(42)),
              w.bin(BIN_OR, w.bin(BIN_SHL, rg_val, w.konst(21)), nb_val))
    $stub := "__xu_tensor_gemm4x8_q4_0_p4_q8_0_f32"
    if plan.is_q8 {
        stub = "__xu_tensor_gemm4x8_q8_0_p4k4_f16_q8_0_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_gemm4x8_q8_0_p4k4_f16_q8_0_fast_f32" }
    } else if plan.signed_nibbles {
        stub = "__xu_tensor_gemm4x8_q4_0_p4k4_signed_f16_q8_0_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_gemm4x8_q4_0_p4k4_signed_f16_q8_0_fast_f32" }
    } else if plan.is_k4 {
        stub = "__xu_tensor_gemm4x8_q4_0_p4k4_f16_q8_0_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_gemm4x8_q4_0_p4k4_f16_q8_0_fast_f32" }
    } else if plan.is_f16_scale {
        stub = "__xu_tensor_gemm4x8_q4_0_p4_f16_q8_0_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_gemm4x8_q4_0_p4_f16_q8_0_fast_f32" }
    } else if w.tensor_fast_math {
        stub = "__xu_tensor_gemm4x8_q4_0_p4_q8_0_fast_f32"
    }
    $args := []int{}
    args.push(op_out.ptr)
    args.push(op_qs.ptr)
    args.push(op_ws.ptr)
    args.push(op_xq.ptr)
    args.push(op_xs.ptr)
    args.push(packed)
    w.call(stub, &args)
    w.jump(done)

    w.f.active_bb = slow
    w.lower_stmt(p, tp, plan.loop)
    w.jump(done)

    w.f.active_bb = done
    << plan.loop
}
