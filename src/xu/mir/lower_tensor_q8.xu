@xu/mir

#xu/ast
#xu/parser
#xu/types

const TENSOR_F64 = 4
const F64_BITS_HALF = 0x3fe0000000000000
const F64_BITS_ONE = 0x3ff0000000000000
const F64_BITS_127 = 0x405fc00000000000

// Lower canonical block-32 Q8_0 activation quantization loops into ARM64 NEON / x64 SSE2:
//   for b in 0:nb {
//       base := b * 32
//       $amax := 0.0
//       for i in 0:32 { $v := f64(x[base + i]); if v < 0.0 { v = -v }; if v > amax { amax = v } }
//       scale := f32(amax / 127.0)
//       x_scales[off_xs + b] = scale
//       $inv := 0.0
//       if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
//       for i in 0:32 {
//           vf := f64(x[base + i]) * inv
//           $q := 0
//           if vf >= 0.0 { q = int(vf + 0.5) } else { q = -int(0.5 - vf) }
//           if q > 127 { q = 127 }
//           if q < -127 { q = -127 }
//           xq[base + i] = i8(q)
//       }
//   }
struct TensorQ8Plan {
    loop int
    bound int
    x int
    xq int
    xs int
    off_x int
    off_xq int
    off_xs int
}

fn tensor_f64_lit(p &parser.Parser, tp &types.TypedProgram, n int, want_bits int) bool {
    if n < 0 || tp.type_of(n) != TENSOR_F64 { << false }
    if p.nodes[n].kind == ast.NK_FLOAT {
        << p.nodes[n].ival == want_bits
    }
    if want_bits == 0 && p.nodes[n].kind == ast.NK_CAST {
        arg := p.nodes[n].a
        << arg >= 0 && ((p.nodes[arg].kind == ast.NK_INT && p.nodes[arg].ival == 0) ||
                       (p.nodes[arg].kind == ast.NK_FLOAT && p.nodes[arg].ival == 0))
    }
    << false
}

fn tensor_signed_int_lit(p &parser.Parser, n int, want int) bool {
    if n < 0 { << false }
    if p.nodes[n].kind == ast.NK_INT && p.nodes[n].ival == want { << true }
    if want < 0 && p.nodes[n].kind == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_NEG {
        << tensor_int_lit(p, p.nodes[n].a, -want)
    }
    << false
}

fn tensor_f64_cast_ident(p &parser.Parser, tp &types.TypedProgram, n int, expect_id int) bool {
    << n >= 0 && tp.type_of(n) == TENSOR_F64 && p.nodes[n].kind == ast.NK_CAST &&
       tensor_ident_id(p, tp, p.nodes[n].a, expect_id)
}

fn tensor_q8_clamp_if(p &parser.Parser, tp &types.TypedProgram, stmt int, q_id int, op int, lim int) bool {
    if stmt < 0 || p.nodes[stmt].kind != ast.NK_IF { << false }
    br := p.nodes[stmt].a
    if br < 0 || p.nodes[br].next >= 0 { << false }
    cond := p.nodes[br].a
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP || p.nodes[cond].ival != op ||
       !tensor_ident_id(p, tp, p.nodes[cond].a, q_id) ||
       !tensor_signed_int_lit(p, p.nodes[cond].b, lim) {
        << false
    }
    body := p.nodes[br].b
    if body < 0 || p.nodes[body].kind != ast.NK_ASSIGN || p.nodes[body].ival != ast.AS_ASSIGN ||
       p.nodes[body].next >= 0 {
        << false
    }
    << tensor_ident_id(p, tp, p.nodes[body].a, q_id) && tensor_signed_int_lit(p, p.nodes[body].b, lim)
}

fn (w &Lw) tensor_q8_quant_plan(p &parser.Parser, tp &types.TypedProgram, loop int) TensorQ8Plan {
    no_match := TensorQ8Plan{loop: -1, bound: -1, x: -1, xq: -1, xs: -1,
                             off_x: -2, off_xq: -2, off_xs: -2}
    bound := tensor_dynamic_bound(p, loop)
    if !w.tensor_dot_bound_ok(p, tp, bound) { << no_match }
    b_iv := tp.local_of(loop)
    if b_iv < 0 { << no_match }

    // base := b * 32
    s1 := p.nodes[loop].c
    if s1 < 0 || p.nodes[s1].kind != ast.NK_LET { << no_match }
    base_id := tp.local_of(s1)
    if base_id < 0 || w.local_type(tp, base_id) != 1 { << no_match }
    if !tensor_scaled_mul_iv(p, tp, p.nodes[s1].a, b_iv, 32) { << no_match }

    // $amax := 0.0
    s2 := p.nodes[s1].next
    if s2 < 0 || p.nodes[s2].kind != ast.NK_LET || !tensor_f64_lit(p, tp, p.nodes[s2].a, 0) {
        << no_match
    }
    amax_id := tp.local_of(s2)
    if amax_id < 0 || w.local_type(tp, amax_id) != TENSOR_F64 { << no_match }

    // for i in 0:32 { $v := f64(x[base + i]); if v < 0.0 { v = -v }; if v > amax { amax = v } }
    s3 := p.nodes[s2].next
    if static_range_extent(p, s3) != 32 { << no_match }
    i_iv := tp.local_of(s3)
    if i_iv < 0 || i_iv == b_iv { << no_match }

    l1 := p.nodes[s3].c
    if l1 < 0 || p.nodes[l1].kind != ast.NK_LET { << no_match }
    v_id := tp.local_of(l1)
    if v_id < 0 || w.local_type(tp, v_id) != TENSOR_F64 { << no_match }
    v_cast := p.nodes[l1].a
    if v_cast < 0 || p.nodes[v_cast].kind != ast.NK_CAST || tp.type_of(v_cast) != TENSOR_F64 {
        << no_match
    }
    x1_idx := p.nodes[v_cast].a
    if x1_idx < 0 || p.nodes[x1_idx].kind != ast.NK_INDEX || tp.type_of(x1_idx) != TENSOR_F32 {
        << no_match
    }
    x_arr := p.nodes[x1_idx].a
    if !w.tensor_f32_array_base(p, tp, x_arr) { << no_match }
    if !tensor_add_local_iv(p, tp, p.nodes[x1_idx].b, base_id, i_iv) { << no_match }

    l2 := p.nodes[l1].next
    if l2 < 0 || p.nodes[l2].kind != ast.NK_IF { << no_match }
    l2_br := p.nodes[l2].a
    if l2_br < 0 || p.nodes[l2_br].next >= 0 { << no_match }
    l2_c := p.nodes[l2_br].a
    if l2_c < 0 || p.nodes[l2_c].kind != ast.NK_BIN_OP || p.nodes[l2_c].ival != ast.OP_LT ||
       !tensor_ident_id(p, tp, p.nodes[l2_c].a, v_id) ||
       !tensor_f64_lit(p, tp, p.nodes[l2_c].b, 0) {
        << no_match
    }
    l2_b := p.nodes[l2_br].b
    if l2_b < 0 || p.nodes[l2_b].kind != ast.NK_ASSIGN || p.nodes[l2_b].ival != ast.AS_ASSIGN ||
       p.nodes[l2_b].next >= 0 || !tensor_ident_id(p, tp, p.nodes[l2_b].a, v_id) {
        << no_match
    }
    neg_v := p.nodes[l2_b].b
    if neg_v < 0 || p.nodes[neg_v].kind != ast.NK_UN_OP || p.nodes[neg_v].ival != ast.UN_NEG ||
       !tensor_ident_id(p, tp, p.nodes[neg_v].a, v_id) {
        << no_match
    }

    l3 := p.nodes[l2].next
    if l3 < 0 || p.nodes[l3].kind != ast.NK_IF || p.nodes[l3].next >= 0 { << no_match }
    l3_br := p.nodes[l3].a
    if l3_br < 0 || p.nodes[l3_br].next >= 0 { << no_match }
    l3_c := p.nodes[l3_br].a
    if l3_c < 0 || p.nodes[l3_c].kind != ast.NK_BIN_OP || p.nodes[l3_c].ival != ast.OP_GT ||
       !tensor_ident_id(p, tp, p.nodes[l3_c].a, v_id) ||
       !tensor_ident_id(p, tp, p.nodes[l3_c].b, amax_id) {
        << no_match
    }
    l3_b := p.nodes[l3_br].b
    if l3_b < 0 || p.nodes[l3_b].kind != ast.NK_ASSIGN || p.nodes[l3_b].ival != ast.AS_ASSIGN ||
       p.nodes[l3_b].next >= 0 || !tensor_ident_id(p, tp, p.nodes[l3_b].a, amax_id) ||
       !tensor_ident_id(p, tp, p.nodes[l3_b].b, v_id) {
        << no_match
    }

    // scale := f32(amax / 127.0)
    s4 := p.nodes[s3].next
    if s4 < 0 || p.nodes[s4].kind != ast.NK_LET { << no_match }
    scale_id := tp.local_of(s4)
    if scale_id < 0 || w.local_type(tp, scale_id) != TENSOR_F32 { << no_match }
    sc_cast := p.nodes[s4].a
    if sc_cast < 0 || p.nodes[sc_cast].kind != ast.NK_CAST || tp.type_of(sc_cast) != TENSOR_F32 {
        << no_match
    }
    sc_div := p.nodes[sc_cast].a
    if sc_div < 0 || p.nodes[sc_div].kind != ast.NK_BIN_OP || p.nodes[sc_div].ival != ast.OP_DIV ||
       !tensor_ident_id(p, tp, p.nodes[sc_div].a, amax_id) ||
       !tensor_f64_lit(p, tp, p.nodes[sc_div].b, F64_BITS_127) {
        << no_match
    }

    // x_scales[off_xs + b] = scale
    s5 := p.nodes[s4].next
    if s5 < 0 || p.nodes[s5].kind != ast.NK_ASSIGN || p.nodes[s5].ival != ast.AS_ASSIGN ||
       !tensor_ident_id(p, tp, p.nodes[s5].b, scale_id) {
        << no_match
    }
    xs_idx := p.nodes[s5].a
    if xs_idx < 0 || p.nodes[xs_idx].kind != ast.NK_INDEX || tp.type_of(xs_idx) != TENSOR_F32 {
        << no_match
    }
    xs_arr := p.nodes[xs_idx].a
    if !w.tensor_f32_array_base(p, tp, xs_arr) { << no_match }
    off_xs := w.tensor_dot_offset(p, tp, p.nodes[xs_idx].b, b_iv)
    if off_xs == -2 { << no_match }

    // $inv := 0.0
    s6 := p.nodes[s5].next
    if s6 < 0 || p.nodes[s6].kind != ast.NK_LET || !tensor_f64_lit(p, tp, p.nodes[s6].a, 0) {
        << no_match
    }
    inv_id := tp.local_of(s6)
    if inv_id < 0 || inv_id == amax_id || w.local_type(tp, inv_id) != TENSOR_F64 { << no_match }

    // if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
    s7 := p.nodes[s6].next
    if s7 < 0 || p.nodes[s7].kind != ast.NK_IF { << no_match }
    s7_br := p.nodes[s7].a
    if s7_br < 0 || p.nodes[s7_br].next >= 0 { << no_match }
    s7_c := p.nodes[s7_br].a
    if s7_c < 0 || p.nodes[s7_c].kind != ast.NK_BIN_OP || p.nodes[s7_c].ival != ast.OP_NE ||
       !tensor_f64_cast_ident(p, tp, p.nodes[s7_c].a, scale_id) ||
       !tensor_f64_lit(p, tp, p.nodes[s7_c].b, 0) {
        << no_match
    }
    s7_b := p.nodes[s7_br].b
    if s7_b < 0 || p.nodes[s7_b].kind != ast.NK_ASSIGN || p.nodes[s7_b].ival != ast.AS_ASSIGN ||
       p.nodes[s7_b].next >= 0 || !tensor_ident_id(p, tp, p.nodes[s7_b].a, inv_id) {
        << no_match
    }
    inv_div := p.nodes[s7_b].b
    if inv_div < 0 || p.nodes[inv_div].kind != ast.NK_BIN_OP || p.nodes[inv_div].ival != ast.OP_DIV ||
       !tensor_f64_lit(p, tp, p.nodes[inv_div].a, F64_BITS_ONE) ||
       !tensor_f64_cast_ident(p, tp, p.nodes[inv_div].b, scale_id) {
        << no_match
    }

    // for i in 0:32 { vf := ...; $q := 0; if vf >= 0.0 ... else ...; clamps; xq[base + i] = i8(q) }
    s8 := p.nodes[s7].next
    if s8 < 0 || p.nodes[s8].next >= 0 || static_range_extent(p, s8) != 32 { << no_match }
    j_iv := tp.local_of(s8)
    if j_iv < 0 || j_iv == b_iv { << no_match }

    k1 := p.nodes[s8].c
    if k1 < 0 || p.nodes[k1].kind != ast.NK_LET { << no_match }
    vf_id := tp.local_of(k1)
    if vf_id < 0 || w.local_type(tp, vf_id) != TENSOR_F64 { << no_match }
    vf_mul := p.nodes[k1].a
    if vf_mul < 0 || p.nodes[vf_mul].kind != ast.NK_BIN_OP || p.nodes[vf_mul].ival != ast.OP_MUL ||
       tp.type_of(vf_mul) != TENSOR_F64 {
        << no_match
    }
    $x2_cast := -1
    if tensor_ident_id(p, tp, p.nodes[vf_mul].b, inv_id) {
        x2_cast = p.nodes[vf_mul].a
    } else if tensor_ident_id(p, tp, p.nodes[vf_mul].a, inv_id) {
        x2_cast = p.nodes[vf_mul].b
    } else {
        << no_match
    }
    if x2_cast < 0 || p.nodes[x2_cast].kind != ast.NK_CAST || tp.type_of(x2_cast) != TENSOR_F64 {
        << no_match
    }
    x2_idx := p.nodes[x2_cast].a
    if x2_idx < 0 || p.nodes[x2_idx].kind != ast.NK_INDEX || tp.type_of(x2_idx) != TENSOR_F32 {
        << no_match
    }
    if tp.local_of(p.nodes[x2_idx].a) != tp.local_of(x_arr) ||
       !tensor_add_local_iv(p, tp, p.nodes[x2_idx].b, base_id, j_iv) {
        << no_match
    }

    k2 := p.nodes[k1].next
    if k2 < 0 || p.nodes[k2].kind != ast.NK_LET || !tensor_int_zero(p, p.nodes[k2].a) {
        << no_match
    }
    q_id := tp.local_of(k2)
    if q_id < 0 || w.local_type(tp, q_id) != 1 { << no_match }

    // if vf >= 0.0 { q = int(vf + 0.5) } else { q = -int(0.5 - vf) }
    k3 := p.nodes[k2].next
    if k3 < 0 || p.nodes[k3].kind != ast.NK_IF { << no_match }
    k3_b0 := p.nodes[k3].a
    if k3_b0 < 0 { << no_match }
    k3_c := p.nodes[k3_b0].a
    if k3_c < 0 || p.nodes[k3_c].kind != ast.NK_BIN_OP || p.nodes[k3_c].ival != ast.OP_GE ||
       !tensor_ident_id(p, tp, p.nodes[k3_c].a, vf_id) ||
       !tensor_f64_lit(p, tp, p.nodes[k3_c].b, 0) {
        << no_match
    }
    k3_t := p.nodes[k3_b0].b
    if k3_t < 0 || p.nodes[k3_t].kind != ast.NK_ASSIGN || p.nodes[k3_t].ival != ast.AS_ASSIGN ||
       p.nodes[k3_t].next >= 0 || !tensor_ident_id(p, tp, p.nodes[k3_t].a, q_id) {
        << no_match
    }
    pos_cast := p.nodes[k3_t].b
    if pos_cast < 0 || p.nodes[pos_cast].kind != ast.NK_CAST || tp.type_of(pos_cast) != 1 {
        << no_match
    }
    pos_add := p.nodes[pos_cast].a
    if pos_add < 0 || p.nodes[pos_add].kind != ast.NK_BIN_OP || p.nodes[pos_add].ival != ast.OP_ADD ||
       !((tensor_ident_id(p, tp, p.nodes[pos_add].a, vf_id) && tensor_f64_lit(p, tp, p.nodes[pos_add].b, F64_BITS_HALF)) ||
         (tensor_ident_id(p, tp, p.nodes[pos_add].b, vf_id) && tensor_f64_lit(p, tp, p.nodes[pos_add].a, F64_BITS_HALF))) {
        << no_match
    }

    k3_b1 := p.nodes[k3_b0].next
    if k3_b1 < 0 || p.nodes[k3_b1].a >= 0 || p.nodes[k3_b1].next >= 0 { << no_match }
    k3_e := p.nodes[k3_b1].b
    if k3_e < 0 || p.nodes[k3_e].kind != ast.NK_ASSIGN || p.nodes[k3_e].ival != ast.AS_ASSIGN ||
       p.nodes[k3_e].next >= 0 || !tensor_ident_id(p, tp, p.nodes[k3_e].a, q_id) {
        << no_match
    }
    neg_q := p.nodes[k3_e].b
    if neg_q < 0 || p.nodes[neg_q].kind != ast.NK_UN_OP || p.nodes[neg_q].ival != ast.UN_NEG {
        << no_match
    }
    neg_cast := p.nodes[neg_q].a
    if neg_cast < 0 || p.nodes[neg_cast].kind != ast.NK_CAST || tp.type_of(neg_cast) != 1 {
        << no_match
    }
    neg_sub := p.nodes[neg_cast].a
    if neg_sub < 0 || p.nodes[neg_sub].kind != ast.NK_BIN_OP || p.nodes[neg_sub].ival != ast.OP_SUB ||
       !tensor_f64_lit(p, tp, p.nodes[neg_sub].a, F64_BITS_HALF) ||
       !tensor_ident_id(p, tp, p.nodes[neg_sub].b, vf_id) {
        << no_match
    }

    k4 := p.nodes[k3].next
    if !tensor_q8_clamp_if(p, tp, k4, q_id, ast.OP_GT, 127) { << no_match }
    k5 := p.nodes[k4].next
    if !tensor_q8_clamp_if(p, tp, k5, q_id, ast.OP_LT, -127) { << no_match }

    k6 := p.nodes[k5].next
    if k6 < 0 || p.nodes[k6].kind != ast.NK_ASSIGN || p.nodes[k6].ival != ast.AS_ASSIGN ||
       p.nodes[k6].next >= 0 {
        << no_match
    }
    xq_cast := p.nodes[k6].b
    if xq_cast < 0 || p.nodes[xq_cast].kind != ast.NK_CAST || tp.type_of(xq_cast) != TENSOR_I8 ||
       !tensor_ident_id(p, tp, p.nodes[xq_cast].a, q_id) {
        << no_match
    }
    xq_idx := p.nodes[k6].a
    if xq_idx < 0 || p.nodes[xq_idx].kind != ast.NK_INDEX || tp.type_of(xq_idx) != TENSOR_I8 {
        << no_match
    }
    xq_arr := p.nodes[xq_idx].a
    if !w.tensor_typed_array_base(p, tp, xq_arr, TENSOR_I8) { << no_match }
    if !tensor_add_local_iv(p, tp, p.nodes[xq_idx].b, base_id, j_iv) { << no_match }

    << TensorQ8Plan{loop: loop, bound: bound, x: x_arr, xq: xq_arr, xs: xs_arr,
                    off_x: -1, off_xq: -1, off_xs: off_xs}
}

fn (w $&Lw) lower_tensor_quantize_q8_0(p &parser.Parser, tp &types.TypedProgram, loop int) int {
    if w.tgt_arch != 0 && w.tgt_arch != 1 { << -1 }
    plan := w.tensor_q8_quant_plan(p, tp, loop)
    if plan.loop < 0 { << -1 }

    w.cur_line = p.nodes[plan.loop].line
    nb := w.lower_expr(p, tp, plan.bound)
    done := w.new_block()
    check := w.new_block()
    w.branch(w.bin(BIN_GT, nb, w.konst(0)), check, done)

    w.f.active_bb = check
    nb_fits := w.bin(BIN_LE, nb, w.konst(1 << 24))
    off_limit := w.konst(1 << 54)
    elems := w.bin(BIN_MUL, nb, w.konst(32))
    op_x := w.tensor_strided_operand(p, tp, plan.x, plan.off_x, elems, 4, off_limit)
    op_xq := w.tensor_strided_operand(p, tp, plan.xq, plan.off_xq, elems, 1, off_limit)
    op_xs := w.tensor_strided_operand(p, tp, plan.xs, plan.off_xs, nb, 4, off_limit)

    x_span := w.bin(BIN_MUL, elems, w.konst(4))
    xs_span := w.bin(BIN_MUL, nb, w.konst(4))
    addr_lim := w.konst(1 << 56)
    addr_ok := w.bin(BIN_AND, w.u64_bin(BIN_LE, op_x.ptr, w.bin(BIN_SUB, addr_lim, x_span)),
               w.bin(BIN_AND, w.u64_bin(BIN_LE, op_xq.ptr, w.bin(BIN_SUB, addr_lim, elems)),
                              w.u64_bin(BIN_LE, op_xs.ptr, w.bin(BIN_SUB, addr_lim, xs_span))))
    disj := w.bin(BIN_AND, w.tensor_disjoint_ranges(op_xq.ptr, elems, op_x.ptr, x_span),
            w.bin(BIN_AND, w.tensor_disjoint_ranges(op_xs.ptr, xs_span, op_x.ptr, x_span),
                           w.tensor_disjoint_ranges(op_xq.ptr, elems, op_xs.ptr, xs_span)))

    valid := w.bin(BIN_AND, nb_fits,
             w.bin(BIN_AND, op_x.valid,
             w.bin(BIN_AND, op_xq.valid,
             w.bin(BIN_AND, op_xs.valid, w.bin(BIN_AND, addr_ok, disj)))))
    fast := w.new_block()
    slow := w.new_block()
    w.branch(valid, fast, slow)

    w.f.active_bb = fast
    $stub := "__xu_tensor_quantize_q8_0"
    if w.tensor_fast_math { stub = "__xu_tensor_quantize_q8_0_fast" }
    $args := []int{}
    args.push(op_x.ptr)
    args.push(op_xq.ptr)
    args.push(op_xs.ptr)
    args.push(nb)
    w.call(stub, &args)
    w.jump(done)

    w.f.active_bb = slow
    w.lower_stmt(p, tp, plan.loop)
    w.jump(done)

    w.f.active_bb = done
    << plan.loop
}
