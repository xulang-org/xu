@xu/mir
// Scalar replacement of address-taken locals in typed MIR.
//
// Wide locals (structs, fixed arrays, descriptors) are reached through
// t = addr l and loads/stores at [t + offset], which keeps them in the
// frame. A local is direct when every address of it is only ever the base
// of a full-word load or store at an aligned offset inside the local, so
// no pointer to it can exist anywhere else: then each access names one
// fixed word, and the local can become one ordinary one-word local per
// word, which opt_locals and the register allocator handle like any scalar.
//
// Address temps: a temp defined exactly once, by addr l, or by a copy of
// an address temp, or by add of an address temp and a constant, holds
// &l + a known byte offset (nested fields and constant array indexes
// lower to such adds).
//
// Escape rules (anything else leaves the local alone):
// - the function holds only kinds fold_known_kind accepts;
// - a temp defined by addr l has exactly one definition;
// - an address temp of l is only used as the base operand of MI_LOAD_PTR
//   or MI_STORE_PTR of width 8 whose total byte offset is 8k with
//   0 <= k < nslots(l), or as the operand of a copy / constant add that
//   defines another address temp;
// - any other use of an address temp (store value, other arithmetic,
//   comparison, call or indirect-call operand, branch condition, return
//   value, narrow or misaligned access, a copy or add into a temp with
//   several definitions) escapes l;
// - l is not an incoming parameter and not marked owning.
// An access through an address temp or MI_LOAD_LOCAL / MI_STORE_LOCAL
// that reaches outside its local's words (which could touch a neighbour
// through the frame layout) makes the whole function ineligible.
//
// Holders: a split word (or any one-word, never address-taken local)
// that is only ever assigned one fixed address &l + off is itself an
// address of l: its loads are address temps and its stores go away when
// l is split. This catches the descriptor a fixed array index builds
// ({data, len, cap} in a .tmp) and references to locals kept in locals.
// Rounds repeat (at most 4) while a round stored an address into a split
// word, since that word can only be seen as a holder in the next round.
//
// The driver runs it after opt_bce and opt_periodic, for arm64 / x64 only.

fn addr_esc(taddr &[]int, esc $&[]bool, v int) {
    if v >= 0 && v < taddr.len && taddr[v] >= 0 {
        esc[taddr[v]] = true
    }
}

fn addr_is(taddr &[]int, v int) bool {
    << v >= 0 && v < taddr.len && taddr[v] >= 0
}

// Word k of split local l.
fn addr_word_local(l int, k int, wbase &[]int) int {
    if k == 0 {
        << l
    }
    << wbase[l] + k - 1
}

pub fn opt_addr(f $&MFn) bool {
    $changed := false
    $hint := []bool{}
    hint.push(false)
    for _ in 0:4 {
        hint[0] = false
        r := addr_round(f, $&hint)
        if !r {
            <-
        }
        changed = true
        if !hint[0] {
            <-
        }
    }
    << changed
}

// One round of opt_addr. hint[0] is set when an address of a local left
// alone was stored into a split word: the next round may find that word
// to be a holder.
fn addr_round(f $&MFn, hint $&[]bool) bool {
    nl := f.locals.len
    nt := f.temps.len
    if nl == 0 || f.blocks.len == 0 || f.locals_nslots.len < nl || f.local_names.len < nl {
        << false
    }
    $has_addr := false
    for ii in 0:f.instrs.len {
        k := f.instrs[ii].kind
        if !fold_known_kind(k) {
            << false
        }
        if k == MI_ADDR {
            has_addr = true
        }
    }
    if !has_addr {
        << false
    }
    // Definitions per temp; taddr[t] = l and toff[t] = byte offset when t
    // is an address temp of l.
    $ndef := []int{}
    $taddr := []int{}
    $toff := []int{}
    for _ in 0:nt {
        ndef.push(0)
        taddr.push(0 - 1)
        toff.push(0)
    }
    $esc := []bool{}
    $taken := []bool{}
    for l in 0:nl {
        $e := l < f.nparams
        if l < f.locals_owning.len && f.locals_owning[l] {
            e = true
        }
        esc.push(e)
        taken.push(false)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            k := f.instrs[ii].kind
            a := f.instrs[ii].a
            if k == MI_ADDR {
                b := f.instrs[ii].b
                if b < 0 || b >= nl {
                    << false
                }
                taken[b] = true
                if a < 0 || a >= nt {
                    esc[b] = true
                }
            }
            if fold_defines(k) && a >= 0 && a < nt {
                ndef[a] = ndef[a] + 1
            }
            ii = f.instrs[ii].next
        }
    }
    // Holders: one-word locals that are not parameters, never
    // address-taken, and stored at least once, where every store that is
    // not dead stores an address temp of the same (local, offset). Reading one yields
    // that address (or, before any store, an undefined value, which MIR
    // never reads), so its loads are address temps too.
    $hok := []bool{}
    $hset := []bool{}
    $hold := []int{}
    $hoff := []int{}
    for l in 0:nl {
        $ok := l >= f.nparams && f.locals_nslots[l] == 1 && !taken[l]
        if l < f.locals_owning.len && f.locals_owning[l] {
            ok = false
        }
        hok.push(ok)
        hset.push(false)
        hold.push(0 - 1)
        hoff.push(0)
    }
    // A store to a one-word local that the same block stores again before
    // any load of it is dead (only loads read a local that is never
    // address-taken), so it does not count against a holder; struct
    // literals zero a word before storing the field.
    $deadst := []bool{}
    for _ in 0:f.instrs.len {
        deadst.push(false)
    }
    $lastst := []int{}
    $lastblk := []int{}
    for _ in 0:nl {
        lastst.push(0 - 1)
        lastblk.push(0 - 1)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.kind == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl {
                lastblk[ins.b] = 0 - 1
            } else if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                if lastblk[ins.a] == bi {
                    deadst[lastst[ins.a]] = true
                }
                lastblk[ins.a] = bi
                lastst[ins.a] = ii
            }
            ii = ins.next
        }
    }
    // Address temps: addr first, then copies, constant adds and loads of
    // holders until nothing new is found (definitions need not come in
    // block order).
    $outer := true
    $round := 0
    while outer {
    outer = false
    $again := true
    while again {
        again = false
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                a := ins.a
                if a >= 0 && a < nt && taddr[a] < 0 && ndef[a] == 1 {
                    if k == MI_ADDR {
                        if round == 0 {
                            taddr[a] = ins.b
                            again = true
                        }
                    } else if k == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl && hset[ins.b] {
                        taddr[a] = hold[ins.b]
                        toff[a] = hoff[ins.b]
                        again = true
                    } else if k == MI_COPY && addr_is(&taddr, ins.b) {
                        taddr[a] = taddr[ins.b]
                        toff[a] = toff[ins.b]
                        again = true
                    } else if k == MI_BIN && ins.b == BIN_ADD {
                        if addr_is(&taddr, ins.c) && ins.d <= 0 - 2 {
                            taddr[a] = taddr[ins.c]
                            toff[a] = toff[ins.c] + f.consts[0 - ins.d - 2]
                            again = true
                        } else if addr_is(&taddr, ins.d) && ins.c <= 0 - 2 {
                            taddr[a] = taddr[ins.d]
                            toff[a] = toff[ins.d] + f.consts[0 - ins.c - 2]
                            again = true
                        }
                    }
                }
                ii = ins.next
            }
        }
        round += 1
    }
    // New holders, given the address temps known so far.
    for l in 0:nl {
        if hok[l] && !hset[l] {
            hold[l] = 0 - 1
        }
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            m := ins.a
            if ins.kind == MI_STORE_LOCAL && m >= 0 && m < nl && hok[m] && !hset[m] && hold[m] != 0 - 2 && !deadst[ii] {
                if !addr_is(&taddr, ins.b) {
                    hold[m] = 0 - 2
                } else if hold[m] == 0 - 1 {
                    hold[m] = taddr[ins.b]
                    hoff[m] = toff[ins.b]
                } else if hold[m] != taddr[ins.b] || hoff[m] != toff[ins.b] {
                    hold[m] = 0 - 2
                }
            }
            ii = ins.next
        }
    }
    for l in 0:nl {
        if hok[l] && !hset[l] && hold[l] >= 0 {
            hset[l] = true
            outer = true
        }
    }
    }
    // An addr into a temp defined more than once escapes.
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            if ins.kind == MI_ADDR && ins.a >= 0 && ins.a < nt && ndef[ins.a] != 1 {
                esc[ins.b] = true
            }
            ii = ins.next
        }
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_LOAD_LOCAL {
                if ins.b < 0 || ins.b >= nl || ins.c >= f.locals_nslots[ins.b] {
                    << false
                }
                // A holder read into a temp that is not an address temp.
                if hset[ins.b] && !addr_is(&taddr, ins.a) {
                    esc[hold[ins.b]] = true
                }
            } else if k == MI_STORE_LOCAL {
                if ins.a < 0 || ins.a >= nl || ins.c >= f.locals_nslots[ins.a] {
                    << false
                }
                // A holder's live stores store its own address; a dead one
                // may store anything.
                if !hset[ins.a] || !addr_is(&taddr, ins.b) || taddr[ins.b] != hold[ins.a] {
                    addr_esc(&taddr, $&esc, ins.b)
                }
            } else if k == MI_LOAD_PTR || k == MI_STORE_PTR {
                $base := ins.b
                if k == MI_STORE_PTR {
                    base = ins.a
                    addr_esc(&taddr, $&esc, ins.b)
                }
                if addr_is(&taddr, base) {
                    l := taddr[base]
                    off := toff[base] + ins.c
                    w := ins.d
                    $nb := 8
                    if w == 1 {
                        nb = 1
                    } else if w == 4 || w == 0 - 4 {
                        nb = 4
                    }
                    if off < 0 || off + nb > f.locals_nslots[l] * 8 {
                        << false
                    }
                    if w != 8 || off % 8 != 0 {
                        esc[l] = true
                    }
                }
            } else if k == MI_COPY {
                if !addr_is(&taddr, ins.a) {
                    addr_esc(&taddr, $&esc, ins.b)
                }
            } else if k == MI_BIN {
                if !addr_is(&taddr, ins.a) {
                    addr_esc(&taddr, $&esc, ins.c)
                    addr_esc(&taddr, $&esc, ins.d)
                }
            } else if k == MI_UN {
                addr_esc(&taddr, $&esc, ins.c)
            } else if k == MI_CALL_IND {
                addr_esc(&taddr, $&esc, ins.b)
            }
            if k == MI_CALL || k == MI_CALL_IND {
                $ai := ins.c
                while ai >= 0 {
                    addr_esc(&taddr, $&esc, f.margs[ai].v)
                    ai = f.margs[ai].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            addr_esc(&taddr, $&esc, f.blocks[bi].ta)
        }
    }
    // Split: word 0 stays in l (now one word), words 1.. get new locals.
    $wbase := []int{}
    $nsplit := 0
    for l in 0:nl {
        wbase.push(0 - 1)
        if esc[l] || (!taken[l] && f.locals_nslots[l] <= 1) {
            esc[l] = true
            ->
        }
        nsplit += 1
        n := f.locals_nslots[l]
        if n > 1 {
            wbase[l] = f.locals.len
            for k in 1:n {
                f.locals.push(1)
                f.locals_nslots.push(1)
                f.locals_owning.push(false)
                f.local_names.push("." + f.local_names[l] + "." + str(k))
            }
            f.locals_nslots[l] = 1
        }
    }
    if nsplit == 0 {
        << false
    }
    $linked := []bool{}
    for _ in 0:f.instrs.len {
        linked.push(false)
    }
    for bi in 0:f.blocks.len {
        $prev := 0 - 1
        $ii := f.blocks[bi].head
        f.blocks[bi].head = 0 - 1
        while ii >= 0 {
            nx := f.instrs[ii].next
            k := f.instrs[ii].kind
            $drop := false
            if k == MI_ADDR || k == MI_COPY || k == MI_BIN {
                // Definitions of address temps of a split local.
                a := f.instrs[ii].a
                drop = addr_is(&taddr, a) && !esc[taddr[a]]
            } else if k == MI_LOAD_PTR || k == MI_STORE_PTR {
                $base := f.instrs[ii].b
                if k == MI_STORE_PTR {
                    base = f.instrs[ii].a
                }
                if addr_is(&taddr, base) && !esc[taddr[base]] {
                    if k == MI_STORE_PTR && addr_is(&taddr, f.instrs[ii].b) {
                        hint[0] = true
                    }
                    l := taddr[base]
                    nlw := addr_word_local(l, (toff[base] + f.instrs[ii].c) / 8, &wbase)
                    if k == MI_LOAD_PTR {
                        f.instrs[ii].kind = MI_LOAD_LOCAL
                        f.instrs[ii].b = nlw
                    } else {
                        f.instrs[ii].kind = MI_STORE_LOCAL
                        f.instrs[ii].a = nlw
                    }
                    f.instrs[ii].c = 0
                    f.instrs[ii].d = 0 - 1
                }
            } else if k == MI_LOAD_LOCAL {
                l := f.instrs[ii].b
                a := f.instrs[ii].a
                if hset[l] {
                    drop = addr_is(&taddr, a) && !esc[taddr[a]]
                } else if !esc[l] {
                    $w := f.instrs[ii].c
                    if w < 0 {
                        w = 0
                    }
                    f.instrs[ii].b = addr_word_local(l, w, &wbase)
                    f.instrs[ii].c = 0
                }
            } else if k == MI_STORE_LOCAL {
                l := f.instrs[ii].a
                if hset[l] {
                    drop = !esc[hold[l]]
                } else if !esc[l] {
                    if addr_is(&taddr, f.instrs[ii].b) {
                        hint[0] = true
                    }
                    $w := f.instrs[ii].c
                    if w < 0 {
                        w = 0
                    }
                    f.instrs[ii].a = addr_word_local(l, w, &wbase)
                    f.instrs[ii].c = 0
                }
            }
            if drop {
                f.instrs[ii].kind = MI_NOP
            } else {
                linked[ii] = true
                if prev < 0 {
                    f.blocks[bi].head = ii
                } else {
                    f.instrs[prev].next = ii
                }
                prev = ii
            }
            ii = nx
        }
        if prev >= 0 {
            f.instrs[prev].next = 0 - 1
        }
        f.blocks[bi].tail = prev
    }
    // Instructions no block reaches still count in the register
    // allocator's address-taken scan and the frame's call scan.
    for ii in 0:f.instrs.len {
        if !linked[ii] {
            f.instrs[ii].kind = MI_NOP
        }
    }
    << true
}

// True when g is a 1-arg drop glue that immediately returns 0 whenever
// ([arg0 + 8] & 1) == 0 (the function-value drop shape for non-capturing values).
fn is_zero_env_drop_fn(g &MFn) bool {
    if g.is_extern || g.nparams != 1 || g.blocks.len < 2 {
        << false
    }
    b0 := &g.blocks[0]
    if b0.tkind != TKIND_BRANCH {
        << false
    }
    $i0 := -1
    $i1 := -1
    $i2 := -1
    $ii := b0.head
    while ii >= 0 {
        if g.instrs[ii].kind != MI_NOP {
            if i0 < 0 {
                i0 = ii
            } else if i1 < 0 {
                i1 = ii
            } else if i2 < 0 {
                i2 = ii
            } else {
                << false
            }
        }
        ii = g.instrs[ii].next
    }
    if i2 < 0 {
        << false
    }
    s0 := &g.instrs[i0]
    s1 := &g.instrs[i1]
    s2 := &g.instrs[i2]
    if s0.kind != MI_LOAD_LOCAL || s0.b != 0 || s0.c != 0 || s0.a < 0 {
        << false
    }
    if s1.kind != MI_LOAD_PTR || s1.b != s0.a || s1.c != 8 || s1.d != 8 || s1.a < 0 {
        << false
    }
    if s2.kind != MI_BIN || s2.b != BIN_AND || s2.a != b0.ta {
        << false
    }
    $mask_ok := false
    if s2.c == s1.a && s2.d <= -2 && fold_cval(g, s2.d) == 1 {
        mask_ok = true
    } else if s2.d == s1.a && s2.c <= -2 && fold_cval(g, s2.c) == 1 {
        mask_ok = true
    }
    if !mask_ok {
        << false
    }
    ret_b := b0.tc
    if ret_b < 0 || ret_b >= g.blocks.len {
        << false
    }
    rb := &g.blocks[ret_b]
    if rb.tkind != TKIND_RETURN || rb.ta > -2 || fold_cval(g, rb.ta) != 0 {
        << false
    }
    $ri := rb.head
    while ri >= 0 {
        if g.instrs[ri].kind != MI_NOP {
            << false
        }
        ri = g.instrs[ri].next
    }
    << true
}

fn drop_label_match(labels &[]string, s &string) bool {
    for i in 0:labels.len {
        if labels[i] == *s {
            << true
        }
    }
    << false
}

fn fnval_even_const(f &MFn, tconst &[]int, v int) bool {
    $cv := v
    if cv >= 0 && cv < tconst.len && tconst[cv] <= -2 {
        cv = tconst[cv]
    }
    if cv > -2 {
        << false
    }
    << (fold_cval(f, cv) & 1) == 0
}

// Eliminate calls to verified zero-env fn-value drop glue for 2-word locals
// whose address never escapes except to that drop glue and whose env word
// (+8) is only ever written with compile-time even constants (e.g. 0),
// initialized before any drop. This allows opt_addr to scalar-replace the
// function value and expose direct call devirtualization + inlining.
fn fnval_elim_zero_drops_fn(f $&MFn, drop_labels &[]string) bool {
    nl := f.locals.len
    nt := f.temps.len
    if nl == 0 || f.blocks.len == 0 || f.locals_nslots.len < nl {
        << false
    }
    $has_drop_call := false
    for ii in 0:f.instrs.len {
        k := f.instrs[ii].kind
        if !fold_known_kind(k) {
            << false
        }
        if k == MI_CALL && drop_label_match(drop_labels, &f.instrs[ii].sval) {
            has_drop_call = true
        }
    }
    if !has_drop_call {
        << false
    }
    $ndef := []int{}
    $tconst := []int{}
    $taddr := []int{}
    $toff := []int{}
    for _ in 0:nt {
        ndef.push(0)
        tconst.push(-1)
        taddr.push(-1)
        toff.push(0)
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                ndef[ins.a] = ndef[ins.a] + 1
                if k == MI_COPY && ins.b <= -2 {
                    tconst[ins.a] = ins.b
                }
            }
            ii = ins.next
        }
    }
    for t in 0:nt {
        if ndef[t] != 1 {
            tconst[t] = -1
        }
    }
    $again := true
    while again {
        again = false
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                k := f.instrs[ii].kind
                a := f.instrs[ii].a
                b := f.instrs[ii].b
                c := f.instrs[ii].c
                d := f.instrs[ii].d
                nx := f.instrs[ii].next
                if a >= 0 && a < nt && taddr[a] < 0 && ndef[a] == 1 {
                    if k == MI_ADDR && b >= 0 && b < nl {
                        taddr[a] = b
                        toff[a] = 0
                        again = true
                    } else if k == MI_COPY && addr_is(&taddr, b) {
                        taddr[a] = taddr[b]
                        toff[a] = toff[b]
                        again = true
                    } else if k == MI_BIN && b == BIN_ADD {
                        if addr_is(&taddr, c) && d <= -2 {
                            taddr[a] = taddr[c]
                            toff[a] = toff[c] + fold_cval(f, d)
                            again = true
                        } else if addr_is(&taddr, d) && c <= -2 {
                            taddr[a] = taddr[d]
                            toff[a] = toff[d] + fold_cval(f, c)
                            again = true
                        }
                    }
                }
                ii = nx
            }
        }
    }
    $esc := []bool{}
    $has_drop := []bool{}
    $bb0_init := []bool{}
    $bb0_saw_drop := []bool{}
    $blk_init := []bool{}
    $drops_safe := []bool{}
    for l in 0:nl {
        $e := l < f.nparams || f.locals_nslots[l] != 2
        if l < f.locals_owning.len && f.locals_owning[l] {
            e = true
        }
        esc.push(e)
        has_drop.push(false)
        bb0_init.push(false)
        bb0_saw_drop.push(false)
        blk_init.push(false)
        drops_safe.push(true)
    }
    for bi in 0:f.blocks.len {
        for l in 0:nl {
            blk_init[l] = false
        }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            k := f.instrs[ii].kind
            a := f.instrs[ii].a
            b := f.instrs[ii].b
            c := f.instrs[ii].c
            d := f.instrs[ii].d
            nx := f.instrs[ii].next
            if k == MI_ADDR {
                if b >= 0 && b < nl && (a < 0 || a >= nt || ndef[a] != 1) {
                    esc[b] = true
                }
            } else if k == MI_LOAD_LOCAL {
                if b >= 0 && b < nl {
                    esc[b] = true
                }
            } else if k == MI_STORE_LOCAL {
                if a >= 0 && a < nl {
                    esc[a] = true
                }
                addr_esc(&taddr, $&esc, b)
            } else if k == MI_LOAD_PTR {
                if addr_is(&taddr, b) {
                    l := taddr[b]
                    off := toff[b] + c
                    if d != 8 || (off != 0 && off != 8) {
                        esc[l] = true
                    }
                }
            } else if k == MI_STORE_PTR {
                addr_esc(&taddr, $&esc, b)
                if addr_is(&taddr, a) {
                    l := taddr[a]
                    off := toff[a] + c
                    if d != 8 || (off != 0 && off != 8) {
                        esc[l] = true
                    } else if off == 8 {
                        if fnval_even_const(f, &tconst, b) {
                            blk_init[l] = true
                            if bi == 0 && !bb0_saw_drop[l] {
                                bb0_init[l] = true
                            }
                        } else {
                            esc[l] = true
                        }
                    }
                }
            } else if k == MI_COPY {
                if !addr_is(&taddr, a) {
                    addr_esc(&taddr, $&esc, b)
                }
            } else if k == MI_BIN {
                if !addr_is(&taddr, a) {
                    addr_esc(&taddr, $&esc, c)
                    addr_esc(&taddr, $&esc, d)
                }
            } else if k == MI_UN {
                addr_esc(&taddr, $&esc, c)
            } else if k == MI_SELECT {
                addr_esc(&taddr, $&esc, b)
                addr_esc(&taddr, $&esc, c)
                addr_esc(&taddr, $&esc, d)
            } else if k == MI_CALL_IND {
                addr_esc(&taddr, $&esc, b)
                $ai := c
                while ai >= 0 {
                    addr_esc(&taddr, $&esc, f.margs[ai].v)
                    ai = f.margs[ai].next
                }
            } else if k == MI_CALL {
                $is_zero_drop := false
                if drop_label_match(drop_labels, &f.instrs[ii].sval) && c >= 0 && f.margs[c].next < 0 {
                    v := f.margs[c].v
                    if addr_is(&taddr, v) && toff[v] == 0 {
                        l := taddr[v]
                        is_zero_drop = true
                        has_drop[l] = true
                        if bi == 0 {
                            bb0_saw_drop[l] = true
                        }
                        if !bb0_init[l] && !blk_init[l] {
                            drops_safe[l] = false
                        }
                    }
                }
                if !is_zero_drop {
                    $ai := c
                    while ai >= 0 {
                        addr_esc(&taddr, $&esc, f.margs[ai].v)
                        ai = f.margs[ai].next
                    }
                }
            }
            ii = nx
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            addr_esc(&taddr, $&esc, f.blocks[bi].ta)
        }
    }
    $any_ok := false
    for l in 0:nl {
        if !esc[l] && has_drop[l] && drops_safe[l] {
            any_ok = true
        }
    }
    if !any_ok {
        << false
    }
    zero := alloc_const(f, 0)
    $changed := false
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            if f.instrs[ii].kind == MI_CALL && drop_label_match(drop_labels, &f.instrs[ii].sval) {
                ai := f.instrs[ii].c
                if ai >= 0 && f.margs[ai].next < 0 {
                    v := f.margs[ai].v
                    if addr_is(&taddr, v) && toff[v] == 0 {
                        l := taddr[v]
                        if !esc[l] && has_drop[l] && drops_safe[l] {
                            if l < f.locals_owning.len {
                                f.locals_owning[l] = false
                            }
                            if f.instrs[ii].a >= 0 {
                                f.instrs[ii].kind = MI_COPY
                                f.instrs[ii].b = zero
                                f.instrs[ii].c = -1
                                f.instrs[ii].d = -1
                                f.instrs[ii].sval = ""
                            } else {
                                f.instrs[ii].kind = MI_NOP
                            }
                            changed = true
                        }
                    }
                }
            }
            ii = f.instrs[ii].next
        }
    }
    << changed
}

pub fn opt_fnval_zero_env_drops(u $&Mir) []bool {
    $changed := []bool{}
    for _ in 0:u.fns.len {
        changed.push(false)
    }
    $drop_labels := []string{}
    for fi in 0:u.fns.len {
        if is_zero_env_drop_fn(&u.fns[fi]) {
            drop_labels.push(u.fns[fi].label + "")
        }
    }
    if drop_labels.len == 0 {
        << changed
    }
    for fi in 0:u.fns.len {
        if fnval_elim_zero_drops_fn($&u.fns[fi], &drop_labels) {
            changed[fi] = true
        }
    }
    << changed
}

fn fp_mark_nonmem(nonmem $&[]bool, nt int, v int) {
    if v >= 0 && v < nt {
        nonmem[v] = true
    }
}

fn fp_disp_ok(w_raw int, off int, max_disp int, align_disp bool) bool {
    if !align_disp {
        << off >= (0 - 2147483648) && off <= max_disp
    }
    $w := w_raw
    if w != 1 && w != 2 && w != 4 && w != -4 { w = 8 }
    $align := w
    if w == -4 { align = 4 }
    << off >= 0 && off % align == 0 && off / align < 4096 && off < max_disp
}

// Fold single-def `p = base +/- small_const` into MI_LOAD_PTR/MI_STORE_PTR
// displacements when every use of `p` is a foldable memory access, dropping
// redundant derived-pointer register pressure and spills before regalloc.
pub fn opt_fold_ptr_offs(f $&MFn, max_disp int, align_disp bool) bool {
    nt := f.temps.len
    if nt == 0 || f.blocks.len == 0 {
        << false
    }
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            << false
        }
    }
    $ndef := []int{}
    $def_ii := []int{}
    $nonmem := []bool{}
    $u_head := []int{}
    for _ in 0:nt {
        ndef.push(0)
        def_ii.push(-1)
        nonmem.push(false)
        u_head.push(-1)
    }
    $u_ii := []int{}
    $u_next := []int{}
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                ndef[ins.a] = ndef[ins.a] + 1
                def_ii[ins.a] = ii
            }
            if k == MI_LOAD_PTR {
                b := ins.b
                if b >= 0 && b < nt {
                    idx := u_ii.len
                    u_ii.push(ii)
                    u_next.push(u_head[b])
                    u_head[b] = idx
                }
            } else if k == MI_STORE_PTR {
                a := ins.a
                if a >= 0 && a < nt {
                    idx := u_ii.len
                    u_ii.push(ii)
                    u_next.push(u_head[a])
                    u_head[a] = idx
                }
                fp_mark_nonmem($&nonmem, nt, ins.b)
            } else if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_VOLATILE_LOAD {
                fp_mark_nonmem($&nonmem, nt, ins.b)
            } else if k == MI_VOLATILE_STORE {
                fp_mark_nonmem($&nonmem, nt, ins.a)
                fp_mark_nonmem($&nonmem, nt, ins.b)
            } else if k == MI_UN {
                fp_mark_nonmem($&nonmem, nt, ins.c)
            } else if k == MI_BIN {
                fp_mark_nonmem($&nonmem, nt, ins.c)
                fp_mark_nonmem($&nonmem, nt, ins.d)
            } else if k == MI_SELECT {
                fp_mark_nonmem($&nonmem, nt, ins.b)
                fp_mark_nonmem($&nonmem, nt, ins.c)
                fp_mark_nonmem($&nonmem, nt, ins.d)
            } else if k == MI_CALL || k == MI_CALL_IND {
                if k == MI_CALL_IND {
                    fp_mark_nonmem($&nonmem, nt, ins.b)
                }
                $ai := ins.c
                while ai >= 0 {
                    fp_mark_nonmem($&nonmem, nt, f.margs[ai].v)
                    ai = f.margs[ai].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            fp_mark_nonmem($&nonmem, nt, f.blocks[bi].ta)
        }
    }
    $changed := false
    for _ in 0:4 {
        $round_changed := false
        for p in 0:nt {
            if ndef[p] != 1 || nonmem[p] || u_head[p] < 0 { -> }
            dii := def_ii[p]
            if dii < 0 { -> }
            dins := &f.instrs[dii]
            if dins.kind != MI_BIN || (dins.b != BIN_ADD && dins.b != BIN_SUB) { -> }
            $base := -1
            $delta := 0
            if dins.b == BIN_ADD {
                if dins.c >= 0 && dins.d <= -2 {
                    base = dins.c
                    delta = f.consts[0 - dins.d - 2]
                } else if dins.d >= 0 && dins.c <= -2 {
                    base = dins.d
                    delta = f.consts[0 - dins.c - 2]
                }
            } else {
                if dins.c >= 0 && dins.d <= -2 {
                    base = dins.c
                    delta = 0 - f.consts[0 - dins.d - 2]
                }
            }
            if base < 0 || base >= nt || base == p || ndef[base] != 1 { -> }
            if delta < (0 - 65536) || delta > 65536 { -> }
            $ok := true
            $ui := u_head[p]
            while ui >= 0 {
                mii := u_ii[ui]
                mins := &f.instrs[mii]
                if mins.kind != MI_LOAD_PTR && mins.kind != MI_STORE_PTR {
                    ok = false
                    <-
                }
                if !fp_disp_ok(mins.d, mins.c + delta, max_disp, align_disp) {
                    ok = false
                    <-
                }
                ui = u_next[ui]
            }
            if !ok { -> }
            $tail := -1
            ui = u_head[p]
            while ui >= 0 {
                mii := u_ii[ui]
                if f.instrs[mii].kind == MI_LOAD_PTR {
                    f.instrs[mii].b = base
                } else {
                    f.instrs[mii].a = base
                }
                f.instrs[mii].c = f.instrs[mii].c + delta
                tail = ui
                ui = u_next[ui]
            }
            if tail >= 0 {
                u_next[tail] = u_head[base]
                u_head[base] = u_head[p]
            }
            u_head[p] = -1
            f.instrs[dii].kind = MI_NOP
            round_changed = true
            changed = true
        }
        if !round_changed { <- }
    }
    << changed
}
