@xu/mir
// Constant folding and dead-code removal for typed MIR.
//
// Only understands the instruction kinds typed lowering emits; a function
// containing anything else is left untouched. Constants propagate through
// temps defined exactly once by a constant copy, branches on constants
// become jumps, unreachable blocks are emptied and pure definitions whose
// temp is never read are removed.

fn fold_known_kind(k int) bool {
    << k == MI_NOP || k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_STORE_LOCAL ||
       k == MI_ADDR || k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_BIN ||
       k == MI_UN || k == MI_CALL || k == MI_CALL_IND || k == MI_STR_CONST ||
       k == MI_LOAD_FN_ADDR
}

fn fold_defines(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_LOAD_PTR ||
       k == MI_BIN || k == MI_UN || k == MI_CALL || k == MI_CALL_IND ||
       k == MI_STR_CONST || k == MI_LOAD_FN_ADDR
}

// Removing these cannot change behaviour when the result is unused.
fn fold_pure(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_BIN ||
       k == MI_UN || k == MI_STR_CONST || k == MI_LOAD_FN_ADDR
}

// v's replacement: a constant, or the temp it copies.
fn fold_sub(v int, tconst &[]int) int {
    $cur := v
    for _ in 0:8 {
        if cur >= 0 && cur < tconst.len && tconst[cur] != -1 {
            cur = tconst[cur]
        } else {
            << cur
        }
    }
    << cur
}

// The block reading each temp: -1 when unread, -2 when read in several.
fn fold_use_blocks(f &MFn) []int {
    $ub := []int{}
    for _ in 0:f.temps.len {
        ub.push(-1)
    }
    for bi in 0:f.blocks.len {
        $vs := []int{}
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            k := ins.kind
            if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                vs.push(ins.b)
            } else if k == MI_STORE_PTR {
                vs.push(ins.a)
                vs.push(ins.b)
            } else if k == MI_UN {
                vs.push(ins.c)
            } else if k == MI_BIN {
                vs.push(ins.c)
                vs.push(ins.d)
            }
            if k == MI_CALL || k == MI_CALL_IND {
                $a := ins.c
                while a >= 0 {
                    vs.push(f.margs[a].v)
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            vs.push(f.blocks[bi].ta)
        }
        for vi in 0:vs.len {
            v := vs[vi]
            if v >= 0 && v < ub.len {
                if ub[v] == -1 {
                    ub[v] = bi
                } else if ub[v] != bi {
                    ub[v] = -2
                }
            }
        }
    }
    << ub
}

fn fold_cval(f &MFn, v int) int {
    << f.consts[0 - v - 2]
}

// Folds op on two constants; ok[0] reports whether it applied. Division by
// 0 or -1 and float ops keep their run-time semantics.
fn fold_bin(op int, x int, y int, ok $&[]bool) int {
    ok[0] = true
    if op == BIN_ADD { << x + y }
    if op == BIN_SUB { << x - y }
    if op == BIN_MUL { << x * y }
    if op == BIN_AND { << x & y }
    if op == BIN_OR { << x | y }
    if op == BIN_XOR { << x ^ y }
    if op == BIN_SHL {
        r := x << (y & 63)
        << r
    }
    if op == BIN_SHR {
        r := x >> (y & 63)
        << r
    }
    if (op == BIN_DIV || op == BIN_MOD) && y != 0 && y != -1 {
        if op == BIN_DIV { << x / y }
        << x % y
    }
    if op == BIN_EQ {
        if x == y { << 1 }
        << 0
    }
    if op == BIN_NE {
        if x != y { << 1 }
        << 0
    }
    if op == BIN_LT {
        if x < y { << 1 }
        << 0
    }
    if op == BIN_LE {
        if x <= y { << 1 }
        << 0
    }
    if op == BIN_GT {
        if x > y { << 1 }
        << 0
    }
    if op == BIN_GE {
        if x >= y { << 1 }
        << 0
    }
    ok[0] = false
    << 0
}

// k when v == 1 << k, else -1.
fn fold_log2(v int) int {
    if v <= 0 || (v & (v - 1)) != 0 {
        << -1
    }
    $k := 0
    while (1 << k) != v {
        k += 1
    }
    << k
}

fn fold_thread(f &MFn, b int) int {
    $cur := b
    for _ in 0:8 {
        if cur > 0 && cur < f.blocks.len && f.blocks[cur].head < 0 && f.blocks[cur].tkind == TKIND_JUMP && f.blocks[cur].ta != cur {
            cur = f.blocks[cur].ta
        } else {
            << cur
        }
    }
    << cur
}

fn fold_use(uses $&[]int, v int) {
    if v >= 0 && v < uses.len {
        uses[v] = uses[v] + 1
    }
}

pub fn opt_fold(f $&MFn) {
    nt := f.temps.len
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            <<
        }
    }
    $reach := []bool{}
    for _ in 0:f.blocks.len {
        reach.push(false)
    }
    for _ in 0:8 {
        $changed := false
        // Temps defined once, by a constant copy.
        $ndef := []int{}
        $tconst := []int{}
        for _ in 0:nt {
            ndef.push(0)
            tconst.push(-1)
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    ndef[ins.a] = ndef[ins.a] + 1
                    if ins.kind == MI_COPY && ins.b <= -2 {
                        tconst[ins.a] = ins.b
                    }
                }
                ii = ins.next
            }
        }
        for t in 0:nt {
            if ndef[t] != 1 {
                tconst[t] = -1
            }
        }
        // t = copy s, both defined once and t only read in its own block:
        // s cannot change between t's definition and those reads.
        ublk := fold_use_blocks(f)
        $dblk := []int{}
        for _ in 0:nt {
            dblk.push(-1)
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                if fold_defines(f.instrs[ii].kind) && f.instrs[ii].a >= 0 && f.instrs[ii].a < nt {
                    dblk[f.instrs[ii].a] = bi
                }
                ii = f.instrs[ii].next
            }
        }
        $seen_here := []bool{}
        for _ in 0:nt {
            seen_here.push(false)
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                if ins.kind == MI_COPY && ins.a >= 0 && ins.a < nt && ins.b >= 0 && ins.b < nt && ins.a != ins.b && ndef[ins.a] == 1 && ndef[ins.b] == 1 && tconst[ins.a] == -1 && (ublk[ins.a] == bi || ublk[ins.a] == -1) && (dblk[ins.b] != bi || seen_here[ins.b]) {
                    tconst[ins.a] = ins.b
                }
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    seen_here[ins.a] = true
                }
                ii = ins.next
            }
            $jj := f.blocks[bi].head
            while jj >= 0 {
                if fold_defines(f.instrs[jj].kind) && f.instrs[jj].a >= 0 && f.instrs[jj].a < nt {
                    seen_here[f.instrs[jj].a] = false
                }
                jj = f.instrs[jj].next
            }
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                $ins := ~f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    ins.b = fold_sub(ins.b, &tconst)
                } else if k == MI_STORE_PTR {
                    ins.a = fold_sub(ins.a, &tconst)
                    ins.b = fold_sub(ins.b, &tconst)
                } else if k == MI_UN {
                    ins.c = fold_sub(ins.c, &tconst)
                } else if k == MI_BIN {
                    ins.c = fold_sub(ins.c, &tconst)
                    ins.d = fold_sub(ins.d, &tconst)
                    if ins.c <= -2 && ins.d <= -2 {
                        $ok := []bool{}
                        ok.push(false)
                        r := fold_bin(ins.b, fold_cval(f, ins.c), fold_cval(f, ins.d), $&ok)
                        if ok[0] {
                            ins.kind = MI_COPY
                            ins.b = alloc_const(f, r)
                        }
                    } else if ins.b == BIN_MUL && ins.d <= -2 && fold_log2(fold_cval(f, ins.d)) > 0 {
                        ins.b = BIN_SHL
                        ins.d = alloc_const(f, fold_log2(fold_cval(f, ins.d)))
                    } else if ins.b == BIN_AND && ((ins.c <= -2 && fold_cval(f, ins.c) == 0) || (ins.d <= -2 && fold_cval(f, ins.d) == 0)) {
                        ins.kind = MI_COPY
                        ins.b = alloc_const(f, 0)
                    }
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        f.margs[a].v = fold_sub(f.margs[a].v, &tconst)
                        a = f.margs[a].next
                    }
                }
                if ins.kind != k || ins.b != f.instrs[ii].b || ins.c != f.instrs[ii].c || ins.d != f.instrs[ii].d || ins.a != f.instrs[ii].a {
                    changed = true
                }
                f.instrs[ii] = ~ins
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                ta := fold_sub(f.blocks[bi].ta, &tconst)
                if tk == TKIND_BRANCH && ta <= -2 {
                    $dest := f.blocks[bi].tc
                    if fold_cval(f, ta) != 0 {
                        dest = f.blocks[bi].tb
                    }
                    f.blocks[bi].tkind = TKIND_JUMP
                    f.blocks[bi].ta = dest
                    f.blocks[bi].tb = -1
                    f.blocks[bi].tc = -1
                    changed = true
                } else {
                    f.blocks[bi].ta = ta
                }
            }
        }
        // Jumps into empty blocks that only jump go straight to the target.
        for bi in 0:f.blocks.len {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                t := fold_thread(f, f.blocks[bi].ta)
                if t != f.blocks[bi].ta {
                    f.blocks[bi].ta = t
                    changed = true
                }
            } else if tk == TKIND_BRANCH {
                tb := fold_thread(f, f.blocks[bi].tb)
                tc := fold_thread(f, f.blocks[bi].tc)
                if tb != f.blocks[bi].tb || tc != f.blocks[bi].tc {
                    f.blocks[bi].tb = tb
                    f.blocks[bi].tc = tc
                    changed = true
                }
            }
        }
        // A block jumping to a block it alone enters absorbs it.
        $npred := []int{}
        for _ in 0:f.blocks.len {
            npred.push(0)
        }
        for bi in 0:f.blocks.len {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                npred[f.blocks[bi].ta] = npred[f.blocks[bi].ta] + 1
            } else if tk == TKIND_BRANCH {
                npred[f.blocks[bi].tb] = npred[f.blocks[bi].tb] + 1
                npred[f.blocks[bi].tc] = npred[f.blocks[bi].tc] + 1
            }
        }
        for bi in 0:f.blocks.len {
            for _ in 0:64 {
                t := f.blocks[bi].ta
                if f.blocks[bi].tkind != TKIND_JUMP || t <= 0 || t == bi || npred[t] != 1 {
                    <-
                }
                th := f.blocks[t].head
                if th >= 0 {
                    if f.blocks[bi].head < 0 {
                        f.blocks[bi].head = th
                    } else {
                        $last := f.blocks[bi].head
                        while f.instrs[last].next >= 0 {
                            last = f.instrs[last].next
                        }
                        f.instrs[last].next = th
                    }
                }
                tb := ~f.blocks[t]
                f.blocks[bi].tkind = tb.tkind
                f.blocks[bi].ta = tb.ta
                f.blocks[bi].tb = tb.tb
                f.blocks[bi].tc = tb.tc
                f.blocks[t].head = -1
                f.blocks[t].tail = -1
                f.blocks[t].tkind = TKIND_OPEN
                f.blocks[t].ta = -1
                f.blocks[t].tb = -1
                f.blocks[t].tc = -1
                npred[t] = 0
                changed = true
            }
        }
        // Unreachable blocks keep their label but lose their code.
        for bi in 0:f.blocks.len {
            reach[bi] = false
        }
        if f.blocks.len > 0 {
            reach[0] = true
            $work := []int{}
            work.push(0)
            $wi := 0
            while wi < work.len {
                b := work[wi]
                wi += 1
                tk := f.blocks[b].tkind
                $succ := []int{}
                if tk == TKIND_JUMP {
                    succ.push(f.blocks[b].ta)
                } else if tk == TKIND_BRANCH {
                    succ.push(f.blocks[b].tb)
                    succ.push(f.blocks[b].tc)
                }
                for si in 0:succ.len {
                    s := succ[si]
                    if s >= 0 && s < f.blocks.len && !reach[s] {
                        reach[s] = true
                        work.push(s)
                    }
                }
            }
        }
        for bi in 0:f.blocks.len {
            if !reach[bi] && (f.blocks[bi].head >= 0 || f.blocks[bi].tkind != TKIND_OPEN) {
                f.blocks[bi].head = -1
                f.blocks[bi].tail = -1
                f.blocks[bi].tkind = TKIND_OPEN
                f.blocks[bi].ta = -1
                f.blocks[bi].tb = -1
                f.blocks[bi].tc = -1
                changed = true
            }
        }
        // Dead pure definitions.
        $uses := []int{}
        for _ in 0:nt {
            uses.push(0)
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    fold_use($&uses, ins.b)
                } else if k == MI_STORE_PTR {
                    fold_use($&uses, ins.a)
                    fold_use($&uses, ins.b)
                } else if k == MI_UN {
                    fold_use($&uses, ins.c)
                } else if k == MI_BIN {
                    fold_use($&uses, ins.c)
                    fold_use($&uses, ins.d)
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        fold_use($&uses, f.margs[a].v)
                        a = f.margs[a].next
                    }
                }
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                fold_use($&uses, f.blocks[bi].ta)
            }
        }
        for bi in 0:f.blocks.len {
            $prev := -1
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                nx := ins.next
                if fold_pure(ins.kind) && ins.a >= 0 && ins.a < nt && uses[ins.a] == 0 {
                    if prev < 0 {
                        f.blocks[bi].head = nx
                    } else {
                        f.instrs[prev].next = nx
                    }
                    f.instrs[ii].kind = MI_NOP
                    changed = true
                } else {
                    prev = ii
                }
                ii = nx
            }
            f.blocks[bi].tail = prev
        }
        if !changed {
            <-
        }
    }
    fold_compact(f, &reach)
}

// Drops unreachable blocks from the layout (block 0 stays first).
fn fold_compact(f $&MFn, reach0 &[]bool) {
    $reach := []bool{}
    for bi in 0:f.blocks.len {
        reach.push(bi == 0)
    }
    $work := []int{}
    work.push(0)
    $wi := 0
    while wi < work.len {
        b := work[wi]
        wi += 1
        tk := f.blocks[b].tkind
        $succ := []int{}
        if tk == TKIND_JUMP {
            succ.push(f.blocks[b].ta)
        } else if tk == TKIND_BRANCH {
            succ.push(f.blocks[b].tb)
            succ.push(f.blocks[b].tc)
        }
        for si in 0:succ.len {
            sb := succ[si]
            if sb >= 0 && sb < f.blocks.len && !reach[sb] {
                reach[sb] = true
                work.push(sb)
            }
        }
    }
    $pos := []int{}
    $n := 0
    for bi in 0:f.blocks.len {
        if reach[bi] {
            pos.push(n)
            n += 1
        } else {
            pos.push(-1)
        }
    }
    if n == f.blocks.len {
        <<
    }
    $nbl := []MBlock{}
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $blk := ~f.blocks[bi]
        if blk.tkind == TKIND_JUMP {
            blk.ta = pos[blk.ta]
        } else if blk.tkind == TKIND_BRANCH {
            blk.tb = pos[blk.tb]
            blk.tc = pos[blk.tc]
        }
        nbl.push(~blk)
    }
    f.blocks = ~nbl
}
