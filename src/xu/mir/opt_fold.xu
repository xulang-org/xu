@xu/mir
// Constant folding and dead-code removal for typed MIR.
//
// Only understands the instruction kinds typed lowering emits; a function
// containing anything else is left untouched. Constants propagate through
// temps defined exactly once by a constant copy, branches on constants
// become jumps, unreachable blocks are emptied and pure definitions whose
// temp is never read are removed.

fn fold_known_kind(k int) bool {
    << k == MI_NOP || k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_STORE_LOCAL ||
       k == MI_ADDR || k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_BIN ||
       k == MI_UN || k == MI_CALL || k == MI_CALL_IND || k == MI_STR_CONST ||
       k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

fn fold_defines(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_LOAD_PTR ||
       k == MI_BIN || k == MI_UN || k == MI_CALL || k == MI_CALL_IND ||
       k == MI_STR_CONST || k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

// Removing these cannot change behaviour when the result is unused.
fn fold_pure(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_BIN ||
       k == MI_UN || k == MI_STR_CONST || k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

pub struct FoldWork {
    reach []bool
    npred []int
    pos []int
    work []int
    ndef []int
    tconst []int
    tfn []int
    bmay []int
    ublk []int
    dblk []int
    seen_here []bool
    uses []int
    lbad []bool
    lstore_cnt []int
    lstore_blk []int
    lstore_val []int
    lloads []int
    lno_dse []bool
    cp_to []int
    cp_from []int
    ok []bool
}

pub fn fold_work_new() FoldWork {
    << FoldWork{
        reach: []bool{},
        npred: []int{},
        pos: []int{},
        work: []int{},
        ndef: []int{},
        tconst: []int{},
        tfn: []int{},
        bmay: []int{},
        ublk: []int{},
        dblk: []int{},
        seen_here: []bool{},
        uses: []int{},
        lbad: []bool{},
        lstore_cnt: []int{},
        lstore_blk: []int{},
        lstore_val: []int{},
        lloads: []int{},
        lno_dse: []bool{},
        cp_to: []int{},
        cp_from: []int{},
        ok: [false]
    }
}

fn mir_fill_int(arr $&[]int, n int, val int) {
    $limit := arr.len
    if n < limit {
        limit = n
    }
    for i in 0:limit {
        arr[i] = val
    }
    while arr.len < n {
        arr.push(val)
    }
}

fn mir_fill_bool(arr $&[]bool, n int, val bool) {
    $limit := arr.len
    if n < limit {
        limit = n
    }
    for i in 0:limit {
        arr[i] = val
    }
    while arr.len < n {
        arr.push(val)
    }
}

fn fold_ensure(w $&FoldWork, nb int, nt int, nl int) {
    while w.reach.len < nb {
        w.reach.push(false)
        w.npred.push(0)
        w.pos.push(-1)
        w.work.push(0)
    }
    while w.ndef.len < nt {
        w.ndef.push(0)
        w.tconst.push(-1)
        w.tfn.push(-1)
        w.bmay.push(-1)
        w.ublk.push(-1)
        w.dblk.push(-1)
        w.seen_here.push(false)
        w.uses.push(0)
    }
    while w.lbad.len < nl {
        w.lbad.push(false)
        w.lstore_cnt.push(0)
        w.lstore_blk.push(-1)
        w.lstore_val.push(-1)
        w.lloads.push(0)
        w.lno_dse.push(false)
    }
}

// v's replacement: a constant, or the temp it copies.
fn fold_sub(v int, tconst &[]int, nt int) int {
    $cur := v
    for _ in 0:8 {
        if cur >= 0 && cur < nt && tconst[cur] != -1 {
            cur = tconst[cur]
        } else {
            << cur
        }
    }
    << cur
}

fn fold_mark_ub(ub $&[]int, nt int, bi int, v int) {
    if v >= 0 && v < nt {
        if ub[v] == -1 {
            ub[v] = bi
        } else if ub[v] != bi {
            ub[v] = -2
        }
    }
}

fn fold_use_blocks(f &MFn) []int {
    $ub := []int{}
    for _ in 0:f.temps.len {
        ub.push(-1)
    }
    fold_use_blocks_into(f, $&ub, f.temps.len)
    << ub
}

// The block reading each temp: -1 when unread, -2 when read in several.
fn fold_use_blocks_into(f &MFn, ub $&[]int, nt int) {
    for t in 0:nt {
        ub[t] = -1
    }
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                fold_mark_ub(ub, nt, bi, ins.b)
            } else if k == MI_STORE_PTR {
                fold_mark_ub(ub, nt, bi, ins.a)
                fold_mark_ub(ub, nt, bi, ins.b)
            } else if k == MI_UN {
                fold_mark_ub(ub, nt, bi, ins.c)
            } else if k == MI_BIN {
                fold_mark_ub(ub, nt, bi, ins.c)
                fold_mark_ub(ub, nt, bi, ins.d)
            } else if k == MI_SELECT {
                fold_mark_ub(ub, nt, bi, ins.b)
                fold_mark_ub(ub, nt, bi, ins.c)
                fold_mark_ub(ub, nt, bi, ins.d)
            }
            if k == MI_CALL || k == MI_CALL_IND {
                $a := ins.c
                while a >= 0 {
                    fold_mark_ub(ub, nt, bi, f.margs[a].v)
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            fold_mark_ub(ub, nt, bi, f.blocks[bi].ta)
        }
    }
}

fn fold_cval(f &MFn, v int) int {
    << f.consts[0 - v - 2]
}

// Folds op on two constants; ok[0] reports whether it applied. Division by
// 0 or -1 and float ops keep their run-time semantics.
fn fold_bin(op int, x int, y int, ok $&[]bool) int {
    ok[0] = true
    if op == BIN_ADD { << x + y }
    if op == BIN_SUB { << x - y }
    if op == BIN_MUL { << x * y }
    if op == BIN_AND { << x & y }
    if op == BIN_OR { << x | y }
    if op == BIN_XOR { << x ^ y }
    if op == BIN_SHL {
        r := x << (y & 63)
        << r
    }
    if op == BIN_SHR {
        r := x >> (y & 63)
        << r
    }
    if op == BIN_MULH { << dc_mulhs(x, y) }
    if op == BIN_ROTR32 {
        k := y & 31
        v := x & 4294967295
        if k == 0 { << v }
        r := (v >> k) | ((v << (32 - k)) & 4294967295)
        << r
    }
    if op == BIN_ROTR64 {
        k := y & 63
        if k == 0 { << x }
        $mask := 9223372036854775807
        if k > 1 { mask = (1 << (64 - k)) - 1 }
        r := ((x >> k) & mask) | (x << (64 - k))
        << r
    }
    if y != 0 {
        if (op == BIN_DIV || op == BIN_MOD) && y != -1 {
            if op == BIN_DIV { << x / y }
            << x % y
        }
    }
    if op == BIN_EQ {
        if x == y { << 1 }
        << 0
    }
    if op == BIN_NE {
        if x != y { << 1 }
        << 0
    }
    if op == BIN_LT {
        if x < y { << 1 }
        << 0
    }
    if op == BIN_LE {
        if x <= y { << 1 }
        << 0
    }
    if op == BIN_GT {
        if x > y { << 1 }
        << 0
    }
    if op == BIN_GE {
        if x >= y { << 1 }
        << 0
    }
    ok[0] = false
    << 0
}

// k when v == 1 << k, else -1.
fn fold_log2(v int) int {
    if v <= 0 || (v & (v - 1)) != 0 {
        << -1
    }
    $k := 0
    while (1 << k) != v {
        k += 1
    }
    << k
}

fn fold_thread(f &MFn, b int) int {
    $cur := b
    for _ in 0:8 {
        if cur > 0 && cur < f.blocks.len && f.blocks[cur].head < 0 && f.blocks[cur].tkind == TKIND_JUMP && f.blocks[cur].ta != cur {
            cur = f.blocks[cur].ta
        } else {
            << cur
        }
    }
    << cur
}

fn fold_use(uses $&[]int, nt int, v int) {
    if v >= 0 && v < nt {
        uses[v] = uses[v] + 1
    }
}

fn fold_is_cmp(op int) bool {
    << (op >= BIN_EQ && op <= BIN_GE) || (op >= BIN_FEQ && op <= BIN_FGE)
}

fn fold_op_mask(f &MFn, bmay &[]int, nt int, v int) int {
    if v <= -2 {
        << fold_cval(f, v)
    }
    if v >= 0 && v < nt {
        << bmay[v]
    }
    << -1
}

fn fold_hi_mask(m int) int {
    if m < 0 { << -1 }
    if m == 0 { << 0 }
    if m <= 1 { << 1 }
    if m <= 255 { << 255 }
    if m <= 65535 { << 65535 }
    if m <= 4294967295 { << 4294967295 }
    << 9223372036854775807
}

fn fold_id_rhs(op int, y int) bool {
    if (op == BIN_ADD || op == BIN_SUB || op == BIN_OR || op == BIN_XOR) && y == 0 { << true }
    if (op == BIN_MUL || op == BIN_DIV) && y == 1 { << true }
    if op == BIN_AND && y == -1 { << true }
    if (op == BIN_SHL || op == BIN_SHR || op == BIN_ROTR64) && (y & 63) == 0 { << true }
    << false
}

fn fold_id_lhs(op int, x int) bool {
    if (op == BIN_ADD || op == BIN_OR || op == BIN_XOR) && x == 0 { << true }
    if op == BIN_MUL && x == 1 { << true }
    if op == BIN_AND && x == -1 { << true }
    << false
}

pub fn opt_fold(f $&MFn) {
    $w := fold_work_new()
    opt_fold_with(f, $&w)
}

pub fn opt_fold_with(f $&MFn, w $&FoldWork) {
    nt := f.temps.len
    nl := f.locals.len
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            <<
        }
    }
    nb := f.blocks.len
    fold_ensure(w, nb, nt, nl)
    for t in 0:nt {
        w.seen_here[t] = false
    }
    for round in 0:8 {
        $changed := false
        for t in 0:nt {
            w.ndef[t] = 0
            w.tconst[t] = -1
            w.tfn[t] = -1
            w.bmay[t] = -1
            w.dblk[t] = -1
            w.uses[t] = 0
        }
        for l in 0:nl {
            w.lbad[l] = l < f.nparams || (l < f.locals_nslots.len && f.locals_nslots[l] != 1)
            w.lstore_cnt[l] = 0
            w.lstore_blk[l] = -1
            w.lstore_val[l] = -1
            w.lloads[l] = 0
            w.lno_dse[l] = l < f.locals_nslots.len && f.locals_nslots[l] != 1
        }
        $cp_n := 0
        $has_call_ind := false
        $has_fn_addr := false
        $has_bin := false
        for bi in 0:nb {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    w.ndef[ins.a] = w.ndef[ins.a] + 1
                    w.dblk[ins.a] = bi
                    if ins.kind == MI_COPY && ins.b <= -2 {
                        w.tconst[ins.a] = ins.b
                    } else if ins.kind == MI_LOAD_FN_ADDR {
                        w.tfn[ins.a] = ii
                        has_fn_addr = true
                    } else if ins.kind == MI_COPY && ins.b >= 0 && ins.b < nt {
                        if cp_n < w.cp_to.len {
                            w.cp_to[cp_n] = ins.a
                            w.cp_from[cp_n] = ins.b
                        } else {
                            w.cp_to.push(ins.a)
                            w.cp_from.push(ins.b)
                        }
                        cp_n += 1
                    }
                }
                if ins.kind == MI_CALL_IND {
                    has_call_ind = true
                } else if ins.kind == MI_BIN {
                    has_bin = true
                }
                if ins.kind == MI_ADDR && ins.b >= 0 && ins.b < nl {
                    w.lbad[ins.b] = true
                } else if ins.kind == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl {
                    if ins.c != 0 {
                        w.lbad[ins.b] = true
                    } else if bi == 0 && w.lstore_cnt[ins.b] == 0 {
                        w.lbad[ins.b] = true
                    }
                } else if ins.kind == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl {
                    if ins.c != 0 {
                        w.lbad[ins.a] = true
                    } else {
                        w.lstore_cnt[ins.a] = w.lstore_cnt[ins.a] + 1
                        w.lstore_blk[ins.a] = bi
                        w.lstore_val[ins.a] = ins.b
                    }
                }
                ii = ins.next
            }
        }
        for t in 0:nt {
            if w.ndef[t] != 1 {
                w.tconst[t] = -1
                w.tfn[t] = -1
            }
        }
        if has_fn_addr && (has_call_ind || nl > 0) {
            for _ in 0:4 {
                $p := false
                for ci in 0:cp_n {
                    dst := w.cp_to[ci]
                    src := w.cp_from[ci]
                    if w.ndef[dst] == 1 && w.ndef[src] == 1 && w.tfn[dst] < 0 && w.tfn[src] >= 0 {
                        w.tfn[dst] = w.tfn[src]
                        p = true
                    }
                }
                if !p { <- }
            }
        }
        if has_bin {
            for _ in 0:2 {
                for bi in 0:nb {
                    $ii := f.blocks[bi].head
                    while ii >= 0 {
                        k := f.instrs[ii].kind
                        a := f.instrs[ii].a
                        b := f.instrs[ii].b
                        c := f.instrs[ii].c
                        d := f.instrs[ii].d
                        nx := f.instrs[ii].next
                        if fold_defines(k) && a >= 0 && a < nt && w.ndef[a] == 1 {
                            if k == MI_COPY {
                                v := fold_op_mask(f, &w.bmay, nt, b)
                                w.bmay[a] = v
                            } else if k == MI_LOAD_PTR {
                                if d == 1 { w.bmay[a] = 255 }
                                else if d == 2 { w.bmay[a] = 65535 }
                                else if d == 4 { w.bmay[a] = 4294967295 }
                            } else if k == MI_SELECT {
                                v := fold_op_mask(f, &w.bmay, nt, c) | fold_op_mask(f, &w.bmay, nt, d)
                                w.bmay[a] = v
                            } else if k == MI_BIN {
                                mc := fold_op_mask(f, &w.bmay, nt, c)
                                md := fold_op_mask(f, &w.bmay, nt, d)
                                if fold_is_cmp(b) {
                                    w.bmay[a] = 1
                                } else if b == BIN_AND {
                                    w.bmay[a] = mc & md
                                } else if b == BIN_OR || b == BIN_XOR {
                                    w.bmay[a] = mc | md
                                } else if b == BIN_SHR && mc >= 0 {
                                    if d <= -2 {
                                        w.bmay[a] = mc >> (fold_cval(f, d) & 63)
                                    } else {
                                        w.bmay[a] = fold_hi_mask(mc)
                                    }
                                } else if b == BIN_SHL && d <= -2 && mc >= 0 && mc <= 4294967295 {
                                    sh := fold_cval(f, d) & 63
                                    if sh <= 31 {
                                        w.bmay[a] = mc << sh
                                    }
                                } else if b == BIN_ROTR32 {
                                    w.bmay[a] = 4294967295
                                }
                            }
                        }
                        ii = nx
                    }
                }
            }
        }
        // t = copy s, both defined once and t only read in its own block:
        // s cannot change between t's definition and those reads.
        fold_use_blocks_into(f, $&w.ublk, nt)
        for bi in 0:nb {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_COPY && ins.a >= 0 && ins.a < nt && ins.b >= 0 && ins.b < nt && ins.a != ins.b && w.ndef[ins.a] == 1 && w.ndef[ins.b] == 1 && w.tconst[ins.a] == -1 && (w.ublk[ins.a] == bi || w.ublk[ins.a] == -1) && (w.dblk[ins.b] != bi || w.seen_here[ins.b]) {
                    w.tconst[ins.a] = ins.b
                }
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    w.seen_here[ins.a] = true
                }
                ii = ins.next
            }
            $jj := f.blocks[bi].head
            while jj >= 0 {
                if fold_defines(f.instrs[jj].kind) && f.instrs[jj].a >= 0 && f.instrs[jj].a < nt {
                    w.seen_here[f.instrs[jj].a] = false
                }
                jj = f.instrs[jj].next
            }
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                orig_k := f.instrs[ii].kind
                orig_a := f.instrs[ii].a
                orig_b := f.instrs[ii].b
                orig_c := f.instrs[ii].c
                orig_d := f.instrs[ii].d
                nx := f.instrs[ii].next
                $k := orig_k
                $a := orig_a
                $b := orig_b
                $c := orig_c
                $d := orig_d
                $tfn_src := -1
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR {
                    b = fold_sub(b, &w.tconst, nt)
                } else if k == MI_CALL_IND {
                    b = fold_sub(b, &w.tconst, nt)
                    if b >= 0 && b < nt && w.tfn[b] >= 0 {
                        k = MI_CALL
                        tfn_src = w.tfn[b]
                        b = -1
                        d = -1
                    }
                } else if k == MI_LOAD_LOCAL {
                    if c == 0 && b >= 0 && b < nl && !w.lbad[b] && w.lstore_cnt[b] == 1 && w.lstore_blk[b] == 0 {
                        sv := w.lstore_val[b]
                        cv := fold_sub(sv, &w.tconst, nt)
                        if cv <= -2 {
                            k = MI_COPY
                            b = cv
                            c = -1
                            d = -1
                        } else if sv >= 0 && sv < nt && w.tfn[sv] >= 0 {
                            k = MI_LOAD_FN_ADDR
                            tfn_src = w.tfn[sv]
                            b = -1
                            c = -1
                            d = -1
                        }
                    }
                } else if k == MI_STORE_PTR {
                    a = fold_sub(a, &w.tconst, nt)
                    b = fold_sub(b, &w.tconst, nt)
                } else if k == MI_UN {
                    c = fold_sub(c, &w.tconst, nt)
                } else if k == MI_BIN {
                    c = fold_sub(c, &w.tconst, nt)
                    d = fold_sub(d, &w.tconst, nt)
                    if c <= -2 && d <= -2 {
                        w.ok[0] = false
                        r := fold_bin(b, fold_cval(f, c), fold_cval(f, d), $&w.ok)
                        if w.ok[0] {
                            k = MI_COPY
                            b = alloc_const(f, r)
                            c = -1
                            d = -1
                        }
                    } else if b == BIN_MUL && d <= -2 && fold_log2(fold_cval(f, d)) > 0 {
                        b = BIN_SHL
                        d = alloc_const(f, fold_log2(fold_cval(f, d)))
                    } else if b == BIN_MUL && c <= -2 && fold_log2(fold_cval(f, c)) > 0 {
                        lg := fold_log2(fold_cval(f, c))
                        b = BIN_SHL
                        c = d
                        d = alloc_const(f, lg)
                    } else if b == BIN_AND && ((c <= -2 && fold_cval(f, c) == 0) || (d <= -2 && fold_cval(f, d) == 0)) {
                        k = MI_COPY
                        b = alloc_const(f, 0)
                        c = -1
                        d = -1
                    } else if b == BIN_MUL && ((c <= -2 && fold_cval(f, c) == 0) || (d <= -2 && fold_cval(f, d) == 0)) {
                        k = MI_COPY
                        b = alloc_const(f, 0)
                        c = -1
                        d = -1
                    } else if b == BIN_OR && ((c <= -2 && fold_cval(f, c) == -1) || (d <= -2 && fold_cval(f, d) == -1)) {
                        k = MI_COPY
                        b = alloc_const(f, -1)
                        c = -1
                        d = -1
                    } else if (b == BIN_SHL || b == BIN_SHR) && c <= -2 && fold_cval(f, c) == 0 {
                        k = MI_COPY
                        b = alloc_const(f, 0)
                        c = -1
                        d = -1
                    } else if b == BIN_MOD && d <= -2 && fold_cval(f, d) == 1 {
                        k = MI_COPY
                        b = alloc_const(f, 0)
                        c = -1
                        d = -1
                    } else if c == d && c >= 0 && (b == BIN_SUB || b == BIN_XOR || b == BIN_LT || b == BIN_GT || b == BIN_NE) {
                        k = MI_COPY
                        b = alloc_const(f, 0)
                        c = -1
                        d = -1
                    } else if c == d && c >= 0 && (b == BIN_EQ || b == BIN_LE || b == BIN_GE) {
                        k = MI_COPY
                        b = alloc_const(f, 1)
                        c = -1
                        d = -1
                    } else if c == d && c >= 0 && (b == BIN_AND || b == BIN_OR) {
                        k = MI_COPY
                        b = c
                        c = -1
                        d = -1
                    } else if b == BIN_LT && d <= -2 && fold_cval(f, d) == 0 && fold_op_mask(f, &w.bmay, nt, c) >= 0 {
                        k = MI_COPY
                        b = alloc_const(f, 0)
                        c = -1
                        d = -1
                    } else if b == BIN_GE && d <= -2 && fold_cval(f, d) == 0 && fold_op_mask(f, &w.bmay, nt, c) >= 0 {
                        k = MI_COPY
                        b = alloc_const(f, 1)
                        c = -1
                        d = -1
                    } else if b == BIN_AND && d <= -2 && (fold_op_mask(f, &w.bmay, nt, c) & fold_cval(f, d)) == fold_op_mask(f, &w.bmay, nt, c) {
                        k = MI_COPY
                        b = c
                        c = -1
                        d = -1
                    } else if b == BIN_AND && c <= -2 && (fold_op_mask(f, &w.bmay, nt, d) & fold_cval(f, c)) == fold_op_mask(f, &w.bmay, nt, d) {
                        k = MI_COPY
                        b = d
                        c = -1
                        d = -1
                    } else if b == BIN_ROTR32 && d <= -2 && (fold_cval(f, d) & 31) == 0 {
                        mc := fold_op_mask(f, &w.bmay, nt, c)
                        if mc >= 0 && mc <= 4294967295 {
                            k = MI_COPY
                            b = c
                            c = -1
                            d = -1
                        } else {
                            b = BIN_AND
                            d = alloc_const(f, 4294967295)
                        }
                    } else {
                        if d <= -2 && fold_id_rhs(b, fold_cval(f, d)) {
                            k = MI_COPY
                            b = c
                            c = -1
                            d = -1
                        } else if c <= -2 && fold_id_lhs(b, fold_cval(f, c)) {
                            k = MI_COPY
                            b = d
                            c = -1
                            d = -1
                        }
                    }
                } else if k == MI_SELECT {
                    b = fold_sub(b, &w.tconst, nt)
                    c = fold_sub(c, &w.tconst, nt)
                    d = fold_sub(d, &w.tconst, nt)
                    if b <= -2 || c == d {
                        $v := d
                        if c == d || fold_cval(f, b) != 0 {
                            v = c
                        }
                        k = MI_COPY
                        b = v
                        c = -1
                        d = -1
                    }
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $ma := c
                    while ma >= 0 {
                        f.margs[ma].v = fold_sub(f.margs[ma].v, &w.tconst, nt)
                        ma = f.margs[ma].next
                    }
                }
                if k != orig_k || a != orig_a || b != orig_b || c != orig_c || d != orig_d {
                    changed = true
                    f.instrs[ii].kind = k
                    f.instrs[ii].a = a
                    f.instrs[ii].b = b
                    f.instrs[ii].c = c
                    f.instrs[ii].d = d
                    if tfn_src >= 0 {
                        f.instrs[ii].sval = f.instrs[tfn_src].sval + ""
                    } else if orig_k == MI_LOAD_LOCAL && k == MI_COPY {
                        f.instrs[ii].sval = ""
                    }
                }
                ii = nx
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                ta := fold_sub(f.blocks[bi].ta, &w.tconst, nt)
                if tk == TKIND_BRANCH && ta <= -2 {
                    $dest := f.blocks[bi].tc
                    if fold_cval(f, ta) != 0 {
                        dest = f.blocks[bi].tb
                    }
                    f.blocks[bi].tkind = TKIND_JUMP
                    f.blocks[bi].ta = dest
                    f.blocks[bi].tb = -1
                    f.blocks[bi].tc = -1
                    changed = true
                } else {
                    f.blocks[bi].ta = ta
                }
            }
        }
        // Jumps into empty blocks that only jump go straight to the target.
        for bi in 0:f.blocks.len {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                t := fold_thread(f, f.blocks[bi].ta)
                if t != f.blocks[bi].ta {
                    f.blocks[bi].ta = t
                    changed = true
                }
            } else if tk == TKIND_BRANCH {
                tb := fold_thread(f, f.blocks[bi].tb)
                tc := fold_thread(f, f.blocks[bi].tc)
                if tb != f.blocks[bi].tb || tc != f.blocks[bi].tc {
                    f.blocks[bi].tb = tb
                    f.blocks[bi].tc = tc
                    changed = true
                }
            }
        }
        // A block jumping to a block it alone enters absorbs it.
        for bi in 0:nb {
            w.npred[bi] = 0
        }
        for bi in 0:nb {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                w.npred[f.blocks[bi].ta] = w.npred[f.blocks[bi].ta] + 1
            } else if tk == TKIND_BRANCH {
                w.npred[f.blocks[bi].tb] = w.npred[f.blocks[bi].tb] + 1
                w.npred[f.blocks[bi].tc] = w.npred[f.blocks[bi].tc] + 1
            }
        }
        for bi in 0:nb {
            for _ in 0:64 {
                t := f.blocks[bi].ta
                if f.blocks[bi].tkind != TKIND_JUMP || t <= 0 || t == bi || w.npred[t] != 1 {
                    <-
                }
                th := f.blocks[t].head
                if th >= 0 {
                    if f.blocks[bi].head < 0 {
                        f.blocks[bi].head = th
                    } else {
                        $last := f.blocks[bi].head
                        while f.instrs[last].next >= 0 {
                            last = f.instrs[last].next
                        }
                        f.instrs[last].next = th
                    }
                }
                ttk := f.blocks[t].tkind
                tta := f.blocks[t].ta
                ttb := f.blocks[t].tb
                ttc := f.blocks[t].tc
                tkb := f.blocks[t].keep_branch
                f.blocks[bi].tkind = ttk
                f.blocks[bi].ta = tta
                f.blocks[bi].tb = ttb
                f.blocks[bi].tc = ttc
                f.blocks[bi].keep_branch = tkb
                f.blocks[t].head = -1
                f.blocks[t].tail = -1
                f.blocks[t].tkind = TKIND_OPEN
                f.blocks[t].ta = -1
                f.blocks[t].tb = -1
                f.blocks[t].tc = -1
                w.npred[t] = 0
                changed = true
            }
        }
        // Unreachable blocks keep their label but lose their code.
        for bi in 0:nb {
            w.reach[bi] = false
        }
        if nb > 0 {
            w.reach[0] = true
            w.work[0] = 0
            $work_n := 1
            $wi := 0
            while wi < work_n {
                b := w.work[wi]
                wi += 1
                tk := f.blocks[b].tkind
                if tk == TKIND_JUMP {
                    s := f.blocks[b].ta
                    if s >= 0 && s < nb && !w.reach[s] {
                        w.reach[s] = true
                        w.work[work_n] = s
                        work_n += 1
                    }
                } else if tk == TKIND_BRANCH {
                    s0 := f.blocks[b].tb
                    if s0 >= 0 && s0 < nb && !w.reach[s0] {
                        w.reach[s0] = true
                        w.work[work_n] = s0
                        work_n += 1
                    }
                    s1 := f.blocks[b].tc
                    if s1 >= 0 && s1 < nb && !w.reach[s1] {
                        w.reach[s1] = true
                        w.work[work_n] = s1
                        work_n += 1
                    }
                }
            }
        }
        for bi in 0:nb {
            if !w.reach[bi] && (f.blocks[bi].head >= 0 || f.blocks[bi].tkind != TKIND_OPEN) {
                f.blocks[bi].head = -1
                f.blocks[bi].tail = -1
                f.blocks[bi].tkind = TKIND_OPEN
                f.blocks[bi].ta = -1
                f.blocks[bi].tb = -1
                f.blocks[bi].tc = -1
                changed = true
            }
        }
        // Dead pure definitions and dead scalar local stores.
        for bi in 0:nb {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                if k == MI_ADDR && ins.b >= 0 && ins.b < nl {
                    w.lno_dse[ins.b] = true
                } else if k == MI_LOAD_LOCAL && ins.b >= 0 && ins.b < nl {
                    if ins.c != 0 {
                        w.lno_dse[ins.b] = true
                    } else {
                        w.lloads[ins.b] = w.lloads[ins.b] + 1
                    }
                } else if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < nl && ins.c != 0 {
                    w.lno_dse[ins.a] = true
                }
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    fold_use($&w.uses, nt, ins.b)
                } else if k == MI_STORE_PTR {
                    fold_use($&w.uses, nt, ins.a)
                    fold_use($&w.uses, nt, ins.b)
                } else if k == MI_UN {
                    fold_use($&w.uses, nt, ins.c)
                } else if k == MI_BIN {
                    fold_use($&w.uses, nt, ins.c)
                    fold_use($&w.uses, nt, ins.d)
                } else if k == MI_SELECT {
                    fold_use($&w.uses, nt, ins.b)
                    fold_use($&w.uses, nt, ins.c)
                    fold_use($&w.uses, nt, ins.d)
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        fold_use($&w.uses, nt, f.margs[a].v)
                        a = f.margs[a].next
                    }
                }
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                fold_use($&w.uses, nt, f.blocks[bi].ta)
            }
        }
        for bi in 0:f.blocks.len {
            $prev := -1
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ik := f.instrs[ii].kind
                ia := f.instrs[ii].a
                ic := f.instrs[ii].c
                nx := f.instrs[ii].next
                dead_pure := fold_pure(ik) && ia >= 0 && ia < nt && w.uses[ia] == 0
                dead_st := ik == MI_STORE_LOCAL && ic == 0 && ia >= 0 && ia < nl && !w.lno_dse[ia] && w.lloads[ia] == 0
                if dead_pure || dead_st {
                    if prev < 0 {
                        f.blocks[bi].head = nx
                    } else {
                        f.instrs[prev].next = nx
                    }
                    f.instrs[ii].kind = MI_NOP
                    changed = true
                } else {
                    prev = ii
                }
                ii = nx
            }
            f.blocks[bi].tail = prev
        }
        if !changed {
            <-
        }
    }
    $has_unreach := false
    for bi in 0:nb {
        if !w.reach[bi] {
            has_unreach = true
            <-
        }
    }
    if has_unreach {
        fold_compact(f, w)
    }
}

// Drops unreachable blocks from the layout (block 0 stays first).
fn fold_compact(f $&MFn, w $&FoldWork) {
    nbf := f.blocks.len
    if nbf == 0 { << }
    for bi in 0:nbf {
        w.reach[bi] = bi == 0
    }
    w.work[0] = 0
    $work_n := 1
    $wi := 0
    while wi < work_n {
        b := w.work[wi]
        wi += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            sb := f.blocks[b].ta
            if sb >= 0 && sb < nbf && !w.reach[sb] {
                w.reach[sb] = true
                w.work[work_n] = sb
                work_n += 1
            }
        } else if tk == TKIND_BRANCH {
            sb0 := f.blocks[b].tb
            if sb0 >= 0 && sb0 < nbf && !w.reach[sb0] {
                w.reach[sb0] = true
                w.work[work_n] = sb0
                work_n += 1
            }
            sb1 := f.blocks[b].tc
            if sb1 >= 0 && sb1 < nbf && !w.reach[sb1] {
                w.reach[sb1] = true
                w.work[work_n] = sb1
                work_n += 1
            }
        }
    }
    $n := 0
    for bi in 0:nbf {
        if w.reach[bi] {
            w.pos[bi] = n
            n += 1
        } else {
            w.pos[bi] = -1
        }
    }
    if n == nbf {
        <<
    }
    $nbl := []MBlock{}
    for bi in 0:nbf {
        if !w.reach[bi] { -> }
        $blk := ~f.blocks[bi]
        if blk.tkind == TKIND_JUMP {
            blk.ta = w.pos[blk.ta]
        } else if blk.tkind == TKIND_BRANCH {
            blk.tb = w.pos[blk.tb]
            blk.tc = w.pos[blk.tc]
        }
        nbl.push(~blk)
    }
    f.blocks = ~nbl
}

pub fn lower_target_sqrt(u $&Mir) {
    for fi in 0:u.fns.len {
        $f := $&u.fns[fi]
        if f.label == "_xu_math_sqrt" { -> }
        for ii in 0:f.instrs.len {
            if f.instrs[ii].kind == MI_CALL && f.instrs[ii].sval == "_xu_math_sqrt" {
                c := f.instrs[ii].c
                if c >= 0 && f.margs[c].next < 0 {
                    arg := f.margs[c].v
                    if f.instrs[ii].a >= 0 {
                        f.instrs[ii].kind = MI_UN
                        f.instrs[ii].b = UN_FSQRT
                        f.instrs[ii].c = arg
                        f.instrs[ii].d = 0
                        f.instrs[ii].sval = ""
                    } else {
                        f.instrs[ii].kind = MI_NOP
                        f.instrs[ii].c = -1
                        f.instrs[ii].sval = ""
                    }
                }
            }
        }
    }
}

fn rotr_reach(f &MFn) []bool {
    nb := f.blocks.len
    $r := []bool{}
    for _ in 0:nb { r.push(false) }
    if nb == 0 { << r }
    $q := []int{}
    r[0] = true
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !r[s] {
                r[s] = true
                q.push(s)
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if sb >= 0 && sb < nb && !r[sb] {
                r[sb] = true
                q.push(sb)
            }
            sc := f.blocks[b].tc
            if sc >= 0 && sc < nb && !r[sc] {
                r[sc] = true
                q.push(sc)
            }
        }
    }
    << r
}

fn rotr_add_use(u_head $&[]int, u_ii $&[]int, u_next $&[]int, v int, ii int) {
    if v >= 0 && v < u_head.len {
        u_ii.push(ii)
        u_next.push(u_head[v])
        u_head[v] = u_ii.len - 1
    }
}

fn rotr_mark_bad(has_bad $&[]bool, v int) {
    if v >= 0 && v < has_bad.len {
        has_bad[v] = true
    }
}

fn rotr_u32_unwrap(f &MFn, def_cnt &[]int, def_ii &[]int, v int) int {
    if v < 0 || v >= def_cnt.len || def_cnt[v] != 1 { << -1 }
    vi := def_ii[v]
    vins := &f.instrs[vi]
    if vins.kind == MI_BIN && vins.b == BIN_AND {
        if vins.d <= -2 && fold_cval(f, vins.d) == 4294967295 && vins.c >= 0 {
            << vins.c
        }
        if vins.c <= -2 && fold_cval(f, vins.c) == 4294967295 && vins.d >= 0 {
            << vins.d
        }
    }
    << -1
}

fn rotr_is_u32_clean(f &MFn, def_cnt &[]int, def_ii &[]int, v int) bool {
    if v < 0 || v >= def_cnt.len || def_cnt[v] != 1 { << false }
    vi := def_ii[v]
    vins := &f.instrs[vi]
    if vins.kind == MI_LOAD_PTR {
        << vins.d == 1 || vins.d == 2 || vins.d == 4
    }
    if vins.kind == MI_BIN {
        if vins.b == BIN_ROTR32 || fold_is_cmp(vins.b) {
            << true
        }
        if vins.b == BIN_AND {
            if vins.d <= -2 {
                m := fold_cval(f, vins.d)
                if m >= 0 && m <= 4294967295 { << true }
            }
            if vins.c <= -2 {
                m := fold_cval(f, vins.c)
                if m >= 0 && m <= 4294967295 { << true }
            }
        }
    }
    << false
}

fn rotr_is_nonneg64(f &MFn, def_cnt &[]int, def_ii &[]int, v int) bool {
    if v < 0 || v >= def_cnt.len || def_cnt[v] != 1 { << false }
    vi := def_ii[v]
    vins := &f.instrs[vi]
    if vins.kind == MI_LOAD_PTR {
        << vins.d == 1 || vins.d == 2 || vins.d == 4
    }
    if vins.kind == MI_BIN {
        if vins.b == BIN_ROTR32 || fold_is_cmp(vins.b) { << true }
        if vins.b == BIN_AND {
            if vins.d <= -2 && fold_cval(f, vins.d) >= 0 { << true }
            if vins.c <= -2 && fold_cval(f, vins.c) >= 0 { << true }
        }
    }
    << false
}

fn rotr_low32_only(f &MFn, def_cnt &[]int, has_bad &[]bool, u_head &[]int, u_ii &[]int, u_next &[]int, v int, depth int) bool {
    if depth >= 6 || v < 0 || v >= u_head.len || has_bad[v] { << false }
    $ui := u_head[v]
    if ui < 0 { << false }
    while ui >= 0 {
        ii := u_ii[ui]
        uins := &f.instrs[ii]
        uk := uins.kind
        if uk == MI_COPY {
            if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
            if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
        } else if uk == MI_STORE_PTR {
            if uins.a == v || uins.b != v || (uins.d != 1 && uins.d != 2 && uins.d != 4) { << false }
        } else if uk == MI_BIN {
            ub := uins.b
            if ub == BIN_AND {
                $masked := false
                if uins.d <= -2 {
                    mc := fold_cval(f, uins.d)
                    if mc >= 0 && mc <= 4294967295 { masked = true }
                }
                if !masked && uins.c <= -2 {
                    mc := fold_cval(f, uins.c)
                    if mc >= 0 && mc <= 4294967295 { masked = true }
                }
                if !masked {
                    if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
                    if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
                }
            } else if ub == BIN_ROTR32 {
                if uins.c != v || uins.d == v { << false }
            } else if ub == BIN_ADD || ub == BIN_SUB || ub == BIN_MUL || ub == BIN_OR || ub == BIN_XOR {
                if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
                if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
            } else if ub == BIN_SHL && uins.c == v && uins.d != v {
                if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
                if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
            } else {
                << false
            }
        } else {
            << false
        }
        ui = u_next[ui]
    }
    << true
}

fn rotr_try32(f &MFn, def_cnt &[]int, def_ii &[]int, has_bad &[]bool, u_head &[]int, u_ii &[]int, u_next &[]int, dst int, a int, b int, out_kr $&[]int) int {
    if a < 0 || a >= def_cnt.len || b < 0 || b >= def_cnt.len { << -1 }
    if def_cnt[a] != 1 || def_cnt[b] != 1 { << -1 }
    $shl_ii := def_ii[a]
    $need_low32 := true
    ains := &f.instrs[shl_ii]
    if ains.kind == MI_BIN && ains.b == BIN_AND {
        $inner := -1
        if ains.d <= -2 && fold_cval(f, ains.d) == 4294967295 {
            inner = ains.c
        } else if ains.c <= -2 && fold_cval(f, ains.c) == 4294967295 {
            inner = ains.d
        }
        if inner < 0 || inner >= def_cnt.len || def_cnt[inner] != 1 { << -1 }
        shl_ii = def_ii[inner]
        need_low32 = false
    }
    sins := &f.instrs[shl_ii]
    if sins.kind != MI_BIN || sins.b != BIN_SHL || sins.c < 0 || sins.d > -2 { << -1 }
    kl := fold_cval(f, sins.d)
    if kl < 1 || kl > 31 { << -1 }
    lx := sins.c
    ri := def_ii[b]
    rins := &f.instrs[ri]
    if rins.kind != MI_BIN || rins.b != BIN_SHR || rins.c < 0 || rins.d > -2 { << -1 }
    kr := fold_cval(f, rins.d)
    if kr != 32 - kl { << -1 }
    rx := rins.c
    if !rotr_is_u32_clean(f, def_cnt, def_ii, rx) { << -1 }
    rx_u := rotr_u32_unwrap(f, def_cnt, def_ii, rx)
    lx_u := rotr_u32_unwrap(f, def_cnt, def_ii, lx)
    $base := -1
    if lx == rx {
        if rx_u >= 0 { base = rx_u }
        else { base = rx }
    } else if rx_u >= 0 && lx == rx_u {
        base = rx_u
    } else if lx_u >= 0 && rx == lx_u {
        base = lx_u
    } else if rx_u >= 0 && lx_u >= 0 && rx_u == lx_u {
        base = rx_u
    }
    if base < 0 || base >= def_cnt.len || def_cnt[base] != 1 { << -1 }
    if need_low32 && !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, dst, 0) {
        << -1
    }
    out_kr[0] = kr
    << base
}

fn rotr_try64(f &MFn, def_cnt &[]int, def_ii &[]int, a int, b int, out_kr $&[]int) int {
    if a < 0 || a >= def_cnt.len || b < 0 || b >= def_cnt.len { << -1 }
    if def_cnt[a] != 1 || def_cnt[b] != 1 { << -1 }
    ai := def_ii[a]
    sins := &f.instrs[ai]
    if sins.kind != MI_BIN || sins.b != BIN_SHL || sins.c < 0 || sins.d > -2 { << -1 }
    kl := fold_cval(f, sins.d)
    if kl < 1 || kl > 63 { << -1 }
    lx := sins.c
    $bi := def_ii[b]
    bins := &f.instrs[bi]
    $need_nonneg := true
    if bins.kind == MI_BIN && bins.b == BIN_AND {
        $exp := 9223372036854775807
        if kl < 63 { exp = (1 << kl) - 1 }
        $inner := -1
        if bins.d <= -2 && fold_cval(f, bins.d) == exp {
            inner = bins.c
        } else if bins.c <= -2 && fold_cval(f, bins.c) == exp {
            inner = bins.d
        }
        if inner < 0 || inner >= def_cnt.len || def_cnt[inner] != 1 { << -1 }
        bi = def_ii[inner]
        need_nonneg = false
    }
    rins := &f.instrs[bi]
    if rins.kind != MI_BIN || rins.b != BIN_SHR || rins.c != lx || rins.d > -2 { << -1 }
    kr := fold_cval(f, rins.d)
    if kr != 64 - kl { << -1 }
    if need_nonneg && !rotr_is_nonneg64(f, def_cnt, def_ii, lx) { << -1 }
    if lx >= def_cnt.len || def_cnt[lx] != 1 { << -1 }
    out_kr[0] = kr
    << lx
}

pub fn opt_rotr(f $&MFn) bool {
    $has_cand := false
    for ii in 0:f.instrs.len {
        ins := &f.instrs[ii]
        if !fold_known_kind(ins.kind) {
            << false
        }
        if ins.kind == MI_BIN && ins.b == BIN_OR {
            has_cand = true
        } else if ins.kind == MI_CALL && (ins.sval == "_xu_math_bits_rotate_right" || ins.sval == "_xu_math_bits_rotate_left") {
            has_cand = true
        }
    }
    if !has_cand { << false }
    nt := f.temps.len
    reach := rotr_reach(f)
    $def_cnt := []int{}
    $def_ii := []int{}
    $has_bad := []bool{}
    $u_head := []int{}
    for _ in 0:nt {
        def_cnt.push(0)
        def_ii.push(-1)
        has_bad.push(false)
        u_head.push(-1)
    }
    $u_ii := []int{}
    $u_next := []int{}
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                def_cnt[ins.a] = def_cnt[ins.a] + 1
                def_ii[ins.a] = ii
            }
            if k == MI_COPY {
                rotr_add_use($&u_head, $&u_ii, $&u_next, ins.b, ii)
            } else if k == MI_STORE_LOCAL {
                rotr_mark_bad($&has_bad, ins.b)
            } else if k == MI_LOAD_PTR {
                rotr_mark_bad($&has_bad, ins.b)
            } else if k == MI_STORE_PTR {
                rotr_mark_bad($&has_bad, ins.a)
                rotr_add_use($&u_head, $&u_ii, $&u_next, ins.b, ii)
            } else if k == MI_BIN {
                rotr_add_use($&u_head, $&u_ii, $&u_next, ins.c, ii)
                if ins.d != ins.c {
                    rotr_add_use($&u_head, $&u_ii, $&u_next, ins.d, ii)
                }
            } else if k == MI_UN {
                rotr_mark_bad($&has_bad, ins.c)
            } else if k == MI_SELECT {
                rotr_mark_bad($&has_bad, ins.b)
                rotr_mark_bad($&has_bad, ins.c)
                rotr_mark_bad($&has_bad, ins.d)
            } else if k == MI_CALL || k == MI_CALL_IND {
                if k == MI_CALL_IND { rotr_mark_bad($&has_bad, ins.b) }
                $mi := ins.c
                while mi >= 0 {
                    rotr_mark_bad($&has_bad, f.margs[mi].v)
                    mi = f.margs[mi].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_RETURN || tk == TKIND_BRANCH {
            rotr_mark_bad($&has_bad, f.blocks[bi].ta)
        }
    }
    $changed := false
    $out_kr := []int{}
    out_kr.push(0)
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            nx := ins.next
            if ins.kind == MI_BIN && ins.b == BIN_OR && ins.a >= 0 {
                $base := rotr_try32(f, &def_cnt, &def_ii, &has_bad, &u_head, &u_ii, &u_next, ins.a, ins.c, ins.d, $&out_kr)
                $op := BIN_ROTR32
                if base < 0 {
                    base = rotr_try32(f, &def_cnt, &def_ii, &has_bad, &u_head, &u_ii, &u_next, ins.a, ins.d, ins.c, $&out_kr)
                }
                if base < 0 {
                    op = BIN_ROTR64
                    base = rotr_try64(f, &def_cnt, &def_ii, ins.c, ins.d, $&out_kr)
                }
                if base < 0 {
                    base = rotr_try64(f, &def_cnt, &def_ii, ins.d, ins.c, $&out_kr)
                }
                if base >= 0 {
                    kc := alloc_const(f, out_kr[0])
                    f.instrs[ii].b = op
                    f.instrs[ii].c = base
                    f.instrs[ii].d = kc
                    changed = true
                }
            } else if ins.kind == MI_CALL && (ins.sval == "_xu_math_bits_rotate_right" || ins.sval == "_xu_math_bits_rotate_left") {
                c0 := ins.c
                if c0 >= 0 {
                    c1 := f.margs[c0].next
                    if c1 >= 0 && f.margs[c1].next < 0 {
                        arg0 := f.margs[c0].v
                        arg1 := f.margs[c1].v
                        if ins.sval == "_xu_math_bits_rotate_right" {
                            if ins.a >= 0 {
                                f.instrs[ii].kind = MI_BIN
                                f.instrs[ii].b = BIN_ROTR64
                                f.instrs[ii].c = arg0
                                f.instrs[ii].d = arg1
                                f.instrs[ii].sval = ""
                            } else {
                                f.instrs[ii].kind = MI_NOP
                                f.instrs[ii].c = -1
                                f.instrs[ii].sval = ""
                            }
                            changed = true
                        } else if arg1 <= -2 {
                            kl := fold_cval(f, arg1) & 63
                            kr := (64 - kl) & 63
                            if ins.a >= 0 {
                                kc := alloc_const(f, kr)
                                f.instrs[ii].kind = MI_BIN
                                f.instrs[ii].b = BIN_ROTR64
                                f.instrs[ii].c = arg0
                                f.instrs[ii].d = kc
                                f.instrs[ii].sval = ""
                            } else {
                                f.instrs[ii].kind = MI_NOP
                                f.instrs[ii].c = -1
                                f.instrs[ii].sval = ""
                            }
                            changed = true
                        }
                    }
                }
            }
            ii = nx
        }
    }
    << changed
}
