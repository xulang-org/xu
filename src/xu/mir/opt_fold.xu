@xu/mir
// Constant folding and dead-code removal for typed MIR.
//
// Only understands the instruction kinds typed lowering emits; a function
// containing anything else is left untouched. Constants propagate through
// temps defined exactly once by a constant copy, branches on constants
// become jumps, unreachable blocks are emptied and pure definitions whose
// temp is never read are removed.

fn fold_known_kind(k int) bool {
    << k == MI_NOP || k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_STORE_LOCAL ||
       k == MI_ADDR || k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_BIN ||
       k == MI_UN || k == MI_CALL || k == MI_CALL_IND || k == MI_STR_CONST ||
       k == MI_LOAD_FN_ADDR
}

fn fold_defines(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_LOAD_PTR ||
       k == MI_BIN || k == MI_UN || k == MI_CALL || k == MI_CALL_IND ||
       k == MI_STR_CONST || k == MI_LOAD_FN_ADDR
}

// Removing these cannot change behaviour when the result is unused.
fn fold_pure(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_BIN ||
       k == MI_UN || k == MI_STR_CONST || k == MI_LOAD_FN_ADDR
}

fn fold_sub(v int, tconst &[]int) int {
    if v >= 0 && v < tconst.len && tconst[v] <= -2 {
        << tconst[v]
    }
    << v
}

fn fold_cval(f &MFn, v int) int {
    << f.consts[0 - v - 2]
}

// Folds op on two constants; ok[0] reports whether it applied. Division by
// 0 or -1 and float ops keep their run-time semantics.
fn fold_bin(op int, x int, y int, ok $&[]bool) int {
    ok[0] = true
    if op == BIN_ADD { << x + y }
    if op == BIN_SUB { << x - y }
    if op == BIN_MUL { << x * y }
    if op == BIN_AND { << x & y }
    if op == BIN_OR { << x | y }
    if op == BIN_XOR { << x ^ y }
    if op == BIN_SHL {
        r := x << (y & 63)
        << r
    }
    if op == BIN_SHR {
        r := x >> (y & 63)
        << r
    }
    if (op == BIN_DIV || op == BIN_MOD) && y != 0 && y != -1 {
        if op == BIN_DIV { << x / y }
        << x % y
    }
    if op == BIN_EQ {
        if x == y { << 1 }
        << 0
    }
    if op == BIN_NE {
        if x != y { << 1 }
        << 0
    }
    if op == BIN_LT {
        if x < y { << 1 }
        << 0
    }
    if op == BIN_LE {
        if x <= y { << 1 }
        << 0
    }
    if op == BIN_GT {
        if x > y { << 1 }
        << 0
    }
    if op == BIN_GE {
        if x >= y { << 1 }
        << 0
    }
    ok[0] = false
    << 0
}

// k when v == 1 << k, else -1.
fn fold_log2(v int) int {
    if v <= 0 || (v & (v - 1)) != 0 {
        << -1
    }
    $k := 0
    while (1 << k) != v {
        k += 1
    }
    << k
}

fn fold_use(uses $&[]int, v int) {
    if v >= 0 && v < uses.len {
        uses[v] = uses[v] + 1
    }
}

pub fn opt_fold(f $&MFn) {
    nt := f.temps.len
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            <<
        }
    }
    $reach := []bool{}
    for _ in 0:f.blocks.len {
        reach.push(false)
    }
    for _ in 0:8 {
        $changed := false
        // Temps defined once, by a constant copy.
        $ndef := []int{}
        $tconst := []int{}
        for _ in 0:nt {
            ndef.push(0)
            tconst.push(-1)
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    ndef[ins.a] = ndef[ins.a] + 1
                    if ins.kind == MI_COPY && ins.b <= -2 {
                        tconst[ins.a] = ins.b
                    }
                }
                ii = ins.next
            }
        }
        for t in 0:nt {
            if ndef[t] != 1 {
                tconst[t] = -1
            }
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                $ins := ~f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    ins.b = fold_sub(ins.b, &tconst)
                } else if k == MI_STORE_PTR {
                    ins.a = fold_sub(ins.a, &tconst)
                    ins.b = fold_sub(ins.b, &tconst)
                } else if k == MI_UN {
                    ins.c = fold_sub(ins.c, &tconst)
                } else if k == MI_BIN {
                    ins.c = fold_sub(ins.c, &tconst)
                    ins.d = fold_sub(ins.d, &tconst)
                    if ins.c <= -2 && ins.d <= -2 {
                        $ok := []bool{}
                        ok.push(false)
                        r := fold_bin(ins.b, fold_cval(f, ins.c), fold_cval(f, ins.d), $&ok)
                        if ok[0] {
                            ins.kind = MI_COPY
                            ins.b = alloc_const(f, r)
                        }
                    } else if ins.b == BIN_MUL && ins.d <= -2 && fold_log2(fold_cval(f, ins.d)) > 0 {
                        ins.b = BIN_SHL
                        ins.d = alloc_const(f, fold_log2(fold_cval(f, ins.d)))
                    } else if ins.b == BIN_AND && ((ins.c <= -2 && fold_cval(f, ins.c) == 0) || (ins.d <= -2 && fold_cval(f, ins.d) == 0)) {
                        ins.kind = MI_COPY
                        ins.b = alloc_const(f, 0)
                    }
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        f.margs[a].v = fold_sub(f.margs[a].v, &tconst)
                        a = f.margs[a].next
                    }
                }
                if ins.kind != k || ins.b != f.instrs[ii].b || ins.c != f.instrs[ii].c || ins.d != f.instrs[ii].d || ins.a != f.instrs[ii].a {
                    changed = true
                }
                f.instrs[ii] = ~ins
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                ta := fold_sub(f.blocks[bi].ta, &tconst)
                if tk == TKIND_BRANCH && ta <= -2 {
                    $dest := f.blocks[bi].tc
                    if fold_cval(f, ta) != 0 {
                        dest = f.blocks[bi].tb
                    }
                    f.blocks[bi].tkind = TKIND_JUMP
                    f.blocks[bi].ta = dest
                    f.blocks[bi].tb = -1
                    f.blocks[bi].tc = -1
                    changed = true
                } else {
                    f.blocks[bi].ta = ta
                }
            }
        }
        // Unreachable blocks keep their label but lose their code.
        for bi in 0:f.blocks.len {
            reach[bi] = false
        }
        if f.blocks.len > 0 {
            reach[0] = true
            $work := []int{}
            work.push(0)
            $wi := 0
            while wi < work.len {
                b := work[wi]
                wi += 1
                tk := f.blocks[b].tkind
                $succ := []int{}
                if tk == TKIND_JUMP {
                    succ.push(f.blocks[b].ta)
                } else if tk == TKIND_BRANCH {
                    succ.push(f.blocks[b].tb)
                    succ.push(f.blocks[b].tc)
                }
                for si in 0:succ.len {
                    s := succ[si]
                    if s >= 0 && s < f.blocks.len && !reach[s] {
                        reach[s] = true
                        work.push(s)
                    }
                }
            }
        }
        for bi in 0:f.blocks.len {
            if !reach[bi] && (f.blocks[bi].head >= 0 || f.blocks[bi].tkind != TKIND_OPEN) {
                f.blocks[bi].head = -1
                f.blocks[bi].tail = -1
                f.blocks[bi].tkind = TKIND_OPEN
                f.blocks[bi].ta = -1
                f.blocks[bi].tb = -1
                f.blocks[bi].tc = -1
                changed = true
            }
        }
        // Dead pure definitions.
        $uses := []int{}
        for _ in 0:nt {
            uses.push(0)
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    fold_use($&uses, ins.b)
                } else if k == MI_STORE_PTR {
                    fold_use($&uses, ins.a)
                    fold_use($&uses, ins.b)
                } else if k == MI_UN {
                    fold_use($&uses, ins.c)
                } else if k == MI_BIN {
                    fold_use($&uses, ins.c)
                    fold_use($&uses, ins.d)
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        fold_use($&uses, f.margs[a].v)
                        a = f.margs[a].next
                    }
                }
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                fold_use($&uses, f.blocks[bi].ta)
            }
        }
        for bi in 0:f.blocks.len {
            $prev := -1
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := ~f.instrs[ii]
                nx := ins.next
                if fold_pure(ins.kind) && ins.a >= 0 && ins.a < nt && uses[ins.a] == 0 {
                    if prev < 0 {
                        f.blocks[bi].head = nx
                    } else {
                        f.instrs[prev].next = nx
                    }
                    f.instrs[ii].kind = MI_NOP
                    changed = true
                } else {
                    prev = ii
                }
                ii = nx
            }
            f.blocks[bi].tail = prev
        }
        if !changed {
            <-
        }
    }
}
