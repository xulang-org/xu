@xu/mir
// Constant folding and dead-code removal for typed MIR.
//
// Only understands the instruction kinds typed lowering emits; a function
// containing anything else is left untouched. Constants propagate through
// temps defined exactly once by a constant copy, branches on constants
// become jumps, unreachable blocks are emptied and pure definitions whose
// temp is never read are removed.

fn fold_known_kind(k int) bool {
    << k == MI_NOP || k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_STORE_LOCAL ||
       k == MI_ADDR || k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_BIN ||
       k == MI_UN || k == MI_CALL || k == MI_CALL_IND || k == MI_STR_CONST ||
       k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

fn fold_defines(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_LOAD_PTR ||
       k == MI_BIN || k == MI_UN || k == MI_CALL || k == MI_CALL_IND ||
       k == MI_STR_CONST || k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

// Removing these cannot change behaviour when the result is unused.
fn fold_pure(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_BIN ||
       k == MI_UN || k == MI_STR_CONST || k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

pub struct FoldWork {
    nt int
    wlen int
    ok []bool
    reach []bool
    ndef []int
    tconst []int
    ub []int
    dblk []int
    seen_here []bool
    npred []int
    uses []int
    work []int
    pos []int
}

pub fn fold_work_new() FoldWork {
    $ok := []bool{}
    ok.push(false)
    << FoldWork{
        nt: 0,
        wlen: 0,
        ok: ok,
        reach: []bool{},
        ndef: []int{},
        tconst: []int{},
        ub: []int{},
        dblk: []int{},
        seen_here: []bool{},
        npred: []int{},
        uses: []int{},
        work: []int{},
        pos: []int{}
    }
}

fn mir_fill_int(arr $&[]int, n int, val int) {
    $limit := arr.len
    if n < limit {
        limit = n
    }
    for i in 0:limit {
        arr[i] = val
    }
    while arr.len < n {
        arr.push(val)
    }
}

fn mir_fill_bool(arr $&[]bool, n int, val bool) {
    $limit := arr.len
    if n < limit {
        limit = n
    }
    for i in 0:limit {
        arr[i] = val
    }
    while arr.len < n {
        arr.push(val)
    }
}

// v's replacement: a constant, or the temp it copies.
fn fold_sub(v int, tconst &[]int, nt int) int {
    $cur := v
    for _ in 0:8 {
        if cur >= 0 && cur < nt && tconst[cur] != -1 {
            cur = tconst[cur]
        } else {
            << cur
        }
    }
    << cur
}

fn fold_mark_use(ub $&[]int, v int, bi int, nt int) {
    if v >= 0 && v < nt {
        if ub[v] == -1 {
            ub[v] = bi
        } else if ub[v] != bi {
            ub[v] = -2
        }
    }
}

fn fold_use_blocks_into(f &MFn, ub $&[]int, nt int) {
    mir_fill_int(ub, nt, -1)
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                fold_mark_use(ub, ins.b, bi, nt)
            } else if k == MI_STORE_PTR {
                fold_mark_use(ub, ins.a, bi, nt)
                fold_mark_use(ub, ins.b, bi, nt)
            } else if k == MI_UN {
                fold_mark_use(ub, ins.c, bi, nt)
            } else if k == MI_BIN {
                fold_mark_use(ub, ins.c, bi, nt)
                fold_mark_use(ub, ins.d, bi, nt)
            } else if k == MI_SELECT {
                fold_mark_use(ub, ins.b, bi, nt)
                fold_mark_use(ub, ins.c, bi, nt)
                fold_mark_use(ub, ins.d, bi, nt)
            }
            if k == MI_CALL || k == MI_CALL_IND {
                $a := ins.c
                while a >= 0 {
                    fold_mark_use(ub, f.margs[a].v, bi, nt)
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            fold_mark_use(ub, f.blocks[bi].ta, bi, nt)
        }
    }
}

// The block reading each temp: -1 when unread, -2 when read in several.
fn fold_use_blocks(f &MFn) []int {
    $ub := []int{}
    fold_use_blocks_into(f, $&ub, f.temps.len)
    << ub
}

fn fold_cval(f &MFn, v int) int {
    << f.consts[0 - v - 2]
}

// Folds op on two constants; ok[0] reports whether it applied. Division by
// 0 or -1 and float ops keep their run-time semantics.
fn fold_bin(op int, x int, y int, ok $&[]bool) int {
    ok[0] = true
    if op == BIN_ADD { << x + y }
    if op == BIN_SUB { << x - y }
    if op == BIN_MUL { << x * y }
    if op == BIN_AND { << x & y }
    if op == BIN_OR { << x | y }
    if op == BIN_XOR { << x ^ y }
    if op == BIN_SHL {
        r := x << (y & 63)
        << r
    }
    if op == BIN_SHR {
        r := x >> (y & 63)
        << r
    }
    if op == BIN_MULH { << dc_mulhs(x, y) }
    if (op == BIN_DIV || op == BIN_MOD) && y != 0 && y != -1 {
        if op == BIN_DIV { << x / y }
        << x % y
    }
    if op == BIN_EQ {
        if x == y { << 1 }
        << 0
    }
    if op == BIN_NE {
        if x != y { << 1 }
        << 0
    }
    if op == BIN_LT {
        if x < y { << 1 }
        << 0
    }
    if op == BIN_LE {
        if x <= y { << 1 }
        << 0
    }
    if op == BIN_GT {
        if x > y { << 1 }
        << 0
    }
    if op == BIN_GE {
        if x >= y { << 1 }
        << 0
    }
    ok[0] = false
    << 0
}

// k when v == 1 << k, else -1.
fn fold_log2(v int) int {
    if v <= 0 || (v & (v - 1)) != 0 {
        << -1
    }
    $k := 0
    while (1 << k) != v {
        k += 1
    }
    << k
}

fn fold_thread(f &MFn, b int) int {
    $cur := b
    for _ in 0:8 {
        if cur > 0 && cur < f.blocks.len && f.blocks[cur].head < 0 && f.blocks[cur].tkind == TKIND_JUMP && f.blocks[cur].ta != cur {
            cur = f.blocks[cur].ta
        } else {
            << cur
        }
    }
    << cur
}

fn fold_use(w $&FoldWork, v int) {
    if v >= 0 && v < w.nt {
        w.uses[v] = w.uses[v] + 1
    }
}

fn fold_work_push(w $&FoldWork, b int) {
    if w.wlen < w.work.len {
        w.work[w.wlen] = b
    } else {
        w.work.push(b)
    }
    w.wlen += 1
}

fn fold_visit(f &MFn, w $&FoldWork, s int) {
    if s >= 0 && s < f.blocks.len && !w.reach[s] {
        w.reach[s] = true
        fold_work_push(w, s)
    }
}

fn fold_reachable(f &MFn, w $&FoldWork) {
    nb := f.blocks.len
    mir_fill_bool($&w.reach, nb, false)
    if nb <= 0 {
        <<
    }
    w.reach[0] = true
    w.wlen = 0
    fold_work_push(w, 0)
    $wi := 0
    while wi < w.wlen {
        b := w.work[wi]
        wi += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            fold_visit(f, w, f.blocks[b].ta)
        } else if tk == TKIND_BRANCH {
            fold_visit(f, w, f.blocks[b].tb)
            fold_visit(f, w, f.blocks[b].tc)
        }
    }
}

pub fn opt_fold(f $&MFn) {
    $w := fold_work_new()
    opt_fold_with(f, $&w)
}

pub fn opt_fold_with(f $&MFn, w $&FoldWork) {
    nt := f.temps.len
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            <<
        }
    }
    w.nt = nt
    for _ in 0:8 {
        $changed := false
        // Temps defined once, by a constant copy.
        mir_fill_int($&w.ndef, nt, 0)
        mir_fill_int($&w.tconst, nt, -1)
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    w.ndef[ins.a] = w.ndef[ins.a] + 1
                    if ins.kind == MI_COPY && ins.b <= -2 {
                        w.tconst[ins.a] = ins.b
                    }
                }
                ii = ins.next
            }
        }
        for t in 0:nt {
            if w.ndef[t] != 1 {
                w.tconst[t] = -1
            }
        }
        // t = copy s, both defined once and t only read in its own block:
        // s cannot change between t's definition and those reads.
        fold_use_blocks_into(f, $&w.ub, nt)
        mir_fill_int($&w.dblk, nt, -1)
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                if fold_defines(f.instrs[ii].kind) && f.instrs[ii].a >= 0 && f.instrs[ii].a < nt {
                    w.dblk[f.instrs[ii].a] = bi
                }
                ii = f.instrs[ii].next
            }
        }
        mir_fill_bool($&w.seen_here, nt, false)
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_COPY && ins.a >= 0 && ins.a < nt && ins.b >= 0 && ins.b < nt && ins.a != ins.b && w.ndef[ins.a] == 1 && w.ndef[ins.b] == 1 && w.tconst[ins.a] == -1 && (w.ub[ins.a] == bi || w.ub[ins.a] == -1) && (w.dblk[ins.b] != bi || w.seen_here[ins.b]) {
                    w.tconst[ins.a] = ins.b
                }
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    w.seen_here[ins.a] = true
                }
                ii = ins.next
            }
            $jj := f.blocks[bi].head
            while jj >= 0 {
                if fold_defines(f.instrs[jj].kind) && f.instrs[jj].a >= 0 && f.instrs[jj].a < nt {
                    w.seen_here[f.instrs[jj].a] = false
                }
                jj = f.instrs[jj].next
            }
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                $ins := ~f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    ins.b = fold_sub(ins.b, &w.tconst, nt)
                } else if k == MI_STORE_PTR {
                    ins.a = fold_sub(ins.a, &w.tconst, nt)
                    ins.b = fold_sub(ins.b, &w.tconst, nt)
                } else if k == MI_UN {
                    ins.c = fold_sub(ins.c, &w.tconst, nt)
                } else if k == MI_BIN {
                    ins.c = fold_sub(ins.c, &w.tconst, nt)
                    ins.d = fold_sub(ins.d, &w.tconst, nt)
                    if ins.c <= -2 && ins.d <= -2 {
                        w.ok[0] = false
                        r := fold_bin(ins.b, fold_cval(f, ins.c), fold_cval(f, ins.d), $&w.ok)
                        if w.ok[0] {
                            ins.kind = MI_COPY
                            ins.b = alloc_const(f, r)
                        }
                    } else if ins.b == BIN_MUL && ins.d <= -2 && fold_log2(fold_cval(f, ins.d)) > 0 {
                        ins.b = BIN_SHL
                        ins.d = alloc_const(f, fold_log2(fold_cval(f, ins.d)))
                    } else if ins.b == BIN_AND && ((ins.c <= -2 && fold_cval(f, ins.c) == 0) || (ins.d <= -2 && fold_cval(f, ins.d) == 0)) {
                        ins.kind = MI_COPY
                        ins.b = alloc_const(f, 0)
                    }
                } else if k == MI_SELECT {
                    ins.b = fold_sub(ins.b, &w.tconst, nt)
                    ins.c = fold_sub(ins.c, &w.tconst, nt)
                    ins.d = fold_sub(ins.d, &w.tconst, nt)
                    if ins.b <= -2 || ins.c == ins.d {
                        $v := ins.d
                        if ins.c == ins.d || fold_cval(f, ins.b) != 0 {
                            v = ins.c
                        }
                        ins.kind = MI_COPY
                        ins.b = v
                        ins.c = -1
                        ins.d = -1
                    }
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        f.margs[a].v = fold_sub(f.margs[a].v, &w.tconst, nt)
                        a = f.margs[a].next
                    }
                }
                if ins.kind != k || ins.b != f.instrs[ii].b || ins.c != f.instrs[ii].c || ins.d != f.instrs[ii].d || ins.a != f.instrs[ii].a {
                    changed = true
                }
                f.instrs[ii] = ~ins
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                ta := fold_sub(f.blocks[bi].ta, &w.tconst, nt)
                if tk == TKIND_BRANCH && ta <= -2 {
                    $dest := f.blocks[bi].tc
                    if fold_cval(f, ta) != 0 {
                        dest = f.blocks[bi].tb
                    }
                    f.blocks[bi].tkind = TKIND_JUMP
                    f.blocks[bi].ta = dest
                    f.blocks[bi].tb = -1
                    f.blocks[bi].tc = -1
                    changed = true
                } else {
                    f.blocks[bi].ta = ta
                }
            }
        }
        // Jumps into empty blocks that only jump go straight to the target.
        for bi in 0:f.blocks.len {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                t := fold_thread(f, f.blocks[bi].ta)
                if t != f.blocks[bi].ta {
                    f.blocks[bi].ta = t
                    changed = true
                }
            } else if tk == TKIND_BRANCH {
                tb := fold_thread(f, f.blocks[bi].tb)
                tc := fold_thread(f, f.blocks[bi].tc)
                if tb != f.blocks[bi].tb || tc != f.blocks[bi].tc {
                    f.blocks[bi].tb = tb
                    f.blocks[bi].tc = tc
                    changed = true
                }
            }
        }
        // A block jumping to a block it alone enters absorbs it.
        nb := f.blocks.len
        mir_fill_int($&w.npred, nb, 0)
        for bi in 0:nb {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                w.npred[f.blocks[bi].ta] = w.npred[f.blocks[bi].ta] + 1
            } else if tk == TKIND_BRANCH {
                w.npred[f.blocks[bi].tb] = w.npred[f.blocks[bi].tb] + 1
                w.npred[f.blocks[bi].tc] = w.npred[f.blocks[bi].tc] + 1
            }
        }
        for bi in 0:nb {
            for _ in 0:64 {
                t := f.blocks[bi].ta
                if f.blocks[bi].tkind != TKIND_JUMP || t <= 0 || t == bi || w.npred[t] != 1 {
                    <-
                }
                th := f.blocks[t].head
                if th >= 0 {
                    if f.blocks[bi].head < 0 {
                        f.blocks[bi].head = th
                    } else {
                        $last := f.blocks[bi].head
                        while f.instrs[last].next >= 0 {
                            last = f.instrs[last].next
                        }
                        f.instrs[last].next = th
                    }
                }
                tb := ~f.blocks[t]
                f.blocks[bi].tkind = tb.tkind
                f.blocks[bi].ta = tb.ta
                f.blocks[bi].tb = tb.tb
                f.blocks[bi].tc = tb.tc
                f.blocks[bi].keep_branch = tb.keep_branch
                f.blocks[t].head = -1
                f.blocks[t].tail = -1
                f.blocks[t].tkind = TKIND_OPEN
                f.blocks[t].ta = -1
                f.blocks[t].tb = -1
                f.blocks[t].tc = -1
                w.npred[t] = 0
                changed = true
            }
        }
        // Unreachable blocks keep their label but lose their code.
        fold_reachable(f, w)
        for bi in 0:nb {
            if !w.reach[bi] && (f.blocks[bi].head >= 0 || f.blocks[bi].tkind != TKIND_OPEN) {
                f.blocks[bi].head = -1
                f.blocks[bi].tail = -1
                f.blocks[bi].tkind = TKIND_OPEN
                f.blocks[bi].ta = -1
                f.blocks[bi].tb = -1
                f.blocks[bi].tc = -1
                changed = true
            }
        }
        // Dead pure definitions.
        mir_fill_int($&w.uses, nt, 0)
        for bi in 0:nb {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    fold_use(w, ins.b)
                } else if k == MI_STORE_PTR {
                    fold_use(w, ins.a)
                    fold_use(w, ins.b)
                } else if k == MI_UN {
                    fold_use(w, ins.c)
                } else if k == MI_BIN {
                    fold_use(w, ins.c)
                    fold_use(w, ins.d)
                } else if k == MI_SELECT {
                    fold_use(w, ins.b)
                    fold_use(w, ins.c)
                    fold_use(w, ins.d)
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        fold_use(w, f.margs[a].v)
                        a = f.margs[a].next
                    }
                }
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                fold_use(w, f.blocks[bi].ta)
            }
        }
        for bi in 0:nb {
            $prev := -1
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                nx := ins.next
                if fold_pure(ins.kind) && ins.a >= 0 && ins.a < nt && w.uses[ins.a] == 0 {
                    if prev < 0 {
                        f.blocks[bi].head = nx
                    } else {
                        f.instrs[prev].next = nx
                    }
                    f.instrs[ii].kind = MI_NOP
                    changed = true
                } else {
                    prev = ii
                }
                ii = nx
            }
            f.blocks[bi].tail = prev
        }
        if !changed {
            <-
        }
    }
    fold_compact(f, w)
}

// Drops unreachable blocks from the layout (block 0 stays first).
fn fold_compact(f $&MFn, w $&FoldWork) {
    fold_reachable(f, w)
    nb := f.blocks.len
    mir_fill_int($&w.pos, nb, -1)
    $n := 0
    for bi in 0:nb {
        if w.reach[bi] {
            w.pos[bi] = n
            n += 1
        }
    }
    if n == nb {
        <<
    }
    $nbl := []MBlock{}
    for bi in 0:nb {
        if !w.reach[bi] { -> }
        $blk := ~f.blocks[bi]
        if blk.tkind == TKIND_JUMP {
            blk.ta = w.pos[blk.ta]
        } else if blk.tkind == TKIND_BRANCH {
            blk.tb = w.pos[blk.tb]
            blk.tc = w.pos[blk.tc]
        }
        nbl.push(~blk)
    }
    f.blocks = ~nbl
}
