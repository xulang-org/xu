@xu/mir
// Constant folding and dead-code removal for typed MIR.
//
// Only understands the instruction kinds typed lowering emits; a function
// containing anything else is left untouched. Constants propagate through
// temps defined exactly once by a constant copy, branches on constants
// become jumps, unreachable blocks are emptied and pure definitions whose
// temp is never read are removed.

fn fold_known_kind(k int) bool {
    << k == MI_NOP || k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_STORE_LOCAL ||
       k == MI_ADDR || k == MI_LOAD_PTR || k == MI_STORE_PTR || k == MI_BIN ||
       k == MI_UN || k == MI_CALL || k == MI_CALL_IND || k == MI_STR_CONST ||
       k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

fn fold_defines(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_LOAD_PTR ||
       k == MI_BIN || k == MI_UN || k == MI_CALL || k == MI_CALL_IND ||
       k == MI_STR_CONST || k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

// Removing these cannot change behaviour when the result is unused.
fn fold_pure(k int) bool {
    << k == MI_COPY || k == MI_LOAD_LOCAL || k == MI_ADDR || k == MI_BIN ||
       k == MI_UN || k == MI_STR_CONST || k == MI_LOAD_FN_ADDR || k == MI_SELECT
}

pub struct FoldWork {
    nt int
    wlen int
    ok []bool
    reach []bool
    ndef []int
    tconst []int
    ub []int
    dblk []int
    seen_here []bool
    npred []int
    uses []int
    work []int
    pos []int
}

pub fn fold_work_new() FoldWork {
    $ok := []bool{}
    ok.push(false)
    << FoldWork{
        nt: 0,
        wlen: 0,
        ok: ok,
        reach: []bool{},
        ndef: []int{},
        tconst: []int{},
        ub: []int{},
        dblk: []int{},
        seen_here: []bool{},
        npred: []int{},
        uses: []int{},
        work: []int{},
        pos: []int{}
    }
}

fn mir_fill_int(arr $&[]int, n int, val int) {
    $limit := arr.len
    if n < limit {
        limit = n
    }
    for i in 0:limit {
        arr[i] = val
    }
    while arr.len < n {
        arr.push(val)
    }
}

fn mir_fill_bool(arr $&[]bool, n int, val bool) {
    $limit := arr.len
    if n < limit {
        limit = n
    }
    for i in 0:limit {
        arr[i] = val
    }
    while arr.len < n {
        arr.push(val)
    }
}

// v's replacement: a constant, or the temp it copies.
fn fold_sub(v int, tconst &[]int, nt int) int {
    $cur := v
    for _ in 0:8 {
        if cur >= 0 && cur < nt && tconst[cur] != -1 {
            cur = tconst[cur]
        } else {
            << cur
        }
    }
    << cur
}

fn fold_mark_use(ub $&[]int, v int, bi int, nt int) {
    if v >= 0 && v < nt {
        if ub[v] == -1 {
            ub[v] = bi
        } else if ub[v] != bi {
            ub[v] = -2
        }
    }
}

fn fold_use_blocks_into(f &MFn, ub $&[]int, nt int) {
    mir_fill_int(ub, nt, -1)
    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                fold_mark_use(ub, ins.b, bi, nt)
            } else if k == MI_STORE_PTR {
                fold_mark_use(ub, ins.a, bi, nt)
                fold_mark_use(ub, ins.b, bi, nt)
            } else if k == MI_UN {
                fold_mark_use(ub, ins.c, bi, nt)
            } else if k == MI_BIN {
                fold_mark_use(ub, ins.c, bi, nt)
                fold_mark_use(ub, ins.d, bi, nt)
            } else if k == MI_SELECT {
                fold_mark_use(ub, ins.b, bi, nt)
                fold_mark_use(ub, ins.c, bi, nt)
                fold_mark_use(ub, ins.d, bi, nt)
            }
            if k == MI_CALL || k == MI_CALL_IND {
                $a := ins.c
                while a >= 0 {
                    fold_mark_use(ub, f.margs[a].v, bi, nt)
                    a = f.margs[a].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH || tk == TKIND_RETURN {
            fold_mark_use(ub, f.blocks[bi].ta, bi, nt)
        }
    }
}

// The block reading each temp: -1 when unread, -2 when read in several.
fn fold_use_blocks(f &MFn) []int {
    $ub := []int{}
    fold_use_blocks_into(f, $&ub, f.temps.len)
    << ub
}

fn fold_cval(f &MFn, v int) int {
    << f.consts[0 - v - 2]
}

// Folds op on two constants; ok[0] reports whether it applied. Division by
// 0 or -1 and float ops keep their run-time semantics.
fn fold_bin(op int, x int, y int, ok $&[]bool) int {
    ok[0] = true
    if op == BIN_ADD { << x + y }
    if op == BIN_SUB { << x - y }
    if op == BIN_MUL { << x * y }
    if op == BIN_AND { << x & y }
    if op == BIN_OR { << x | y }
    if op == BIN_XOR { << x ^ y }
    if op == BIN_SHL {
        r := x << (y & 63)
        << r
    }
    if op == BIN_SHR {
        r := x >> (y & 63)
        << r
    }
    if op == BIN_MULH { << dc_mulhs(x, y) }
    if op == BIN_ROTR32 {
        k := y & 31
        v := x & 4294967295
        if k == 0 { << v }
        r := (v >> k) | ((v << (32 - k)) & 4294967295)
        << r
    }
    if op == BIN_ROTR64 {
        k := y & 63
        if k == 0 { << x }
        $mask := 9223372036854775807
        if k > 1 { mask = (1 << (64 - k)) - 1 }
        r := ((x >> k) & mask) | (x << (64 - k))
        << r
    }
    if (op == BIN_DIV || op == BIN_MOD) && y != 0 && y != -1 {
        if op == BIN_DIV { << x / y }
        << x % y
    }
    if op == BIN_EQ {
        if x == y { << 1 }
        << 0
    }
    if op == BIN_NE {
        if x != y { << 1 }
        << 0
    }
    if op == BIN_LT {
        if x < y { << 1 }
        << 0
    }
    if op == BIN_LE {
        if x <= y { << 1 }
        << 0
    }
    if op == BIN_GT {
        if x > y { << 1 }
        << 0
    }
    if op == BIN_GE {
        if x >= y { << 1 }
        << 0
    }
    ok[0] = false
    << 0
}

// k when v == 1 << k, else -1.
fn fold_log2(v int) int {
    if v <= 0 || (v & (v - 1)) != 0 {
        << -1
    }
    $k := 0
    while (1 << k) != v {
        k += 1
    }
    << k
}

fn fold_thread(f &MFn, b int) int {
    $cur := b
    for _ in 0:8 {
        if cur > 0 && cur < f.blocks.len && f.blocks[cur].head < 0 && f.blocks[cur].tkind == TKIND_JUMP && f.blocks[cur].ta != cur {
            cur = f.blocks[cur].ta
        } else {
            << cur
        }
    }
    << cur
}

fn fold_use(w $&FoldWork, v int) {
    if v >= 0 && v < w.nt {
        w.uses[v] = w.uses[v] + 1
    }
}

fn fold_work_push(w $&FoldWork, b int) {
    if w.wlen < w.work.len {
        w.work[w.wlen] = b
    } else {
        w.work.push(b)
    }
    w.wlen += 1
}

fn fold_visit(f &MFn, w $&FoldWork, s int) {
    if s >= 0 && s < f.blocks.len && !w.reach[s] {
        w.reach[s] = true
        fold_work_push(w, s)
    }
}

fn fold_reachable(f &MFn, w $&FoldWork) {
    nb := f.blocks.len
    mir_fill_bool($&w.reach, nb, false)
    if nb <= 0 {
        <<
    }
    w.reach[0] = true
    w.wlen = 0
    fold_work_push(w, 0)
    $wi := 0
    while wi < w.wlen {
        b := w.work[wi]
        wi += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            fold_visit(f, w, f.blocks[b].ta)
        } else if tk == TKIND_BRANCH {
            fold_visit(f, w, f.blocks[b].tb)
            fold_visit(f, w, f.blocks[b].tc)
        }
    }
}

pub fn opt_fold(f $&MFn) {
    $w := fold_work_new()
    opt_fold_with(f, $&w)
}

pub fn opt_fold_with(f $&MFn, w $&FoldWork) {
    nt := f.temps.len
    for ii in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[ii].kind) {
            <<
        }
    }
    w.nt = nt
    for _ in 0:8 {
        $changed := false
        // Temps defined once, by a constant copy.
        mir_fill_int($&w.ndef, nt, 0)
        mir_fill_int($&w.tconst, nt, -1)
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    w.ndef[ins.a] = w.ndef[ins.a] + 1
                    if ins.kind == MI_COPY && ins.b <= -2 {
                        w.tconst[ins.a] = ins.b
                    }
                }
                ii = ins.next
            }
        }
        for t in 0:nt {
            if w.ndef[t] != 1 {
                w.tconst[t] = -1
            }
        }
        // t = copy s, both defined once and t only read in its own block:
        // s cannot change between t's definition and those reads.
        fold_use_blocks_into(f, $&w.ub, nt)
        mir_fill_int($&w.dblk, nt, -1)
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                if fold_defines(f.instrs[ii].kind) && f.instrs[ii].a >= 0 && f.instrs[ii].a < nt {
                    w.dblk[f.instrs[ii].a] = bi
                }
                ii = f.instrs[ii].next
            }
        }
        mir_fill_bool($&w.seen_here, nt, false)
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                if ins.kind == MI_COPY && ins.a >= 0 && ins.a < nt && ins.b >= 0 && ins.b < nt && ins.a != ins.b && w.ndef[ins.a] == 1 && w.ndef[ins.b] == 1 && w.tconst[ins.a] == -1 && (w.ub[ins.a] == bi || w.ub[ins.a] == -1) && (w.dblk[ins.b] != bi || w.seen_here[ins.b]) {
                    w.tconst[ins.a] = ins.b
                }
                if fold_defines(ins.kind) && ins.a >= 0 && ins.a < nt {
                    w.seen_here[ins.a] = true
                }
                ii = ins.next
            }
            $jj := f.blocks[bi].head
            while jj >= 0 {
                if fold_defines(f.instrs[jj].kind) && f.instrs[jj].a >= 0 && f.instrs[jj].a < nt {
                    w.seen_here[f.instrs[jj].a] = false
                }
                jj = f.instrs[jj].next
            }
        }
        for bi in 0:f.blocks.len {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                $ins := ~f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    ins.b = fold_sub(ins.b, &w.tconst, nt)
                } else if k == MI_STORE_PTR {
                    ins.a = fold_sub(ins.a, &w.tconst, nt)
                    ins.b = fold_sub(ins.b, &w.tconst, nt)
                } else if k == MI_UN {
                    ins.c = fold_sub(ins.c, &w.tconst, nt)
                } else if k == MI_BIN {
                    ins.c = fold_sub(ins.c, &w.tconst, nt)
                    ins.d = fold_sub(ins.d, &w.tconst, nt)
                    if ins.c <= -2 && ins.d <= -2 {
                        w.ok[0] = false
                        r := fold_bin(ins.b, fold_cval(f, ins.c), fold_cval(f, ins.d), $&w.ok)
                        if w.ok[0] {
                            ins.kind = MI_COPY
                            ins.b = alloc_const(f, r)
                        }
                    } else if ins.b == BIN_MUL && ins.d <= -2 && fold_log2(fold_cval(f, ins.d)) > 0 {
                        ins.b = BIN_SHL
                        ins.d = alloc_const(f, fold_log2(fold_cval(f, ins.d)))
                    } else if ins.b == BIN_AND && ((ins.c <= -2 && fold_cval(f, ins.c) == 0) || (ins.d <= -2 && fold_cval(f, ins.d) == 0)) {
                        ins.kind = MI_COPY
                        ins.b = alloc_const(f, 0)
                    }
                } else if k == MI_SELECT {
                    ins.b = fold_sub(ins.b, &w.tconst, nt)
                    ins.c = fold_sub(ins.c, &w.tconst, nt)
                    ins.d = fold_sub(ins.d, &w.tconst, nt)
                    if ins.b <= -2 || ins.c == ins.d {
                        $v := ins.d
                        if ins.c == ins.d || fold_cval(f, ins.b) != 0 {
                            v = ins.c
                        }
                        ins.kind = MI_COPY
                        ins.b = v
                        ins.c = -1
                        ins.d = -1
                    }
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        f.margs[a].v = fold_sub(f.margs[a].v, &w.tconst, nt)
                        a = f.margs[a].next
                    }
                }
                if ins.kind != k || ins.b != f.instrs[ii].b || ins.c != f.instrs[ii].c || ins.d != f.instrs[ii].d || ins.a != f.instrs[ii].a {
                    changed = true
                }
                f.instrs[ii] = ~ins
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                ta := fold_sub(f.blocks[bi].ta, &w.tconst, nt)
                if tk == TKIND_BRANCH && ta <= -2 {
                    $dest := f.blocks[bi].tc
                    if fold_cval(f, ta) != 0 {
                        dest = f.blocks[bi].tb
                    }
                    f.blocks[bi].tkind = TKIND_JUMP
                    f.blocks[bi].ta = dest
                    f.blocks[bi].tb = -1
                    f.blocks[bi].tc = -1
                    changed = true
                } else {
                    f.blocks[bi].ta = ta
                }
            }
        }
        // Jumps into empty blocks that only jump go straight to the target.
        for bi in 0:f.blocks.len {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                t := fold_thread(f, f.blocks[bi].ta)
                if t != f.blocks[bi].ta {
                    f.blocks[bi].ta = t
                    changed = true
                }
            } else if tk == TKIND_BRANCH {
                tb := fold_thread(f, f.blocks[bi].tb)
                tc := fold_thread(f, f.blocks[bi].tc)
                if tb != f.blocks[bi].tb || tc != f.blocks[bi].tc {
                    f.blocks[bi].tb = tb
                    f.blocks[bi].tc = tc
                    changed = true
                }
            }
        }
        // A block jumping to a block it alone enters absorbs it.
        nb := f.blocks.len
        mir_fill_int($&w.npred, nb, 0)
        for bi in 0:nb {
            tk := f.blocks[bi].tkind
            if tk == TKIND_JUMP {
                w.npred[f.blocks[bi].ta] = w.npred[f.blocks[bi].ta] + 1
            } else if tk == TKIND_BRANCH {
                w.npred[f.blocks[bi].tb] = w.npred[f.blocks[bi].tb] + 1
                w.npred[f.blocks[bi].tc] = w.npred[f.blocks[bi].tc] + 1
            }
        }
        for bi in 0:nb {
            for _ in 0:64 {
                t := f.blocks[bi].ta
                if f.blocks[bi].tkind != TKIND_JUMP || t <= 0 || t == bi || w.npred[t] != 1 {
                    <-
                }
                th := f.blocks[t].head
                if th >= 0 {
                    if f.blocks[bi].head < 0 {
                        f.blocks[bi].head = th
                    } else {
                        $last := f.blocks[bi].head
                        while f.instrs[last].next >= 0 {
                            last = f.instrs[last].next
                        }
                        f.instrs[last].next = th
                    }
                }
                tb := ~f.blocks[t]
                f.blocks[bi].tkind = tb.tkind
                f.blocks[bi].ta = tb.ta
                f.blocks[bi].tb = tb.tb
                f.blocks[bi].tc = tb.tc
                f.blocks[bi].keep_branch = tb.keep_branch
                f.blocks[t].head = -1
                f.blocks[t].tail = -1
                f.blocks[t].tkind = TKIND_OPEN
                f.blocks[t].ta = -1
                f.blocks[t].tb = -1
                f.blocks[t].tc = -1
                w.npred[t] = 0
                changed = true
            }
        }
        // Unreachable blocks keep their label but lose their code.
        fold_reachable(f, w)
        for bi in 0:nb {
            if !w.reach[bi] && (f.blocks[bi].head >= 0 || f.blocks[bi].tkind != TKIND_OPEN) {
                f.blocks[bi].head = -1
                f.blocks[bi].tail = -1
                f.blocks[bi].tkind = TKIND_OPEN
                f.blocks[bi].ta = -1
                f.blocks[bi].tb = -1
                f.blocks[bi].tc = -1
                changed = true
            }
        }
        // Dead pure definitions.
        mir_fill_int($&w.uses, nt, 0)
        for bi in 0:nb {
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                k := ins.kind
                if k == MI_COPY || k == MI_STORE_LOCAL || k == MI_LOAD_PTR || k == MI_CALL_IND {
                    fold_use(w, ins.b)
                } else if k == MI_STORE_PTR {
                    fold_use(w, ins.a)
                    fold_use(w, ins.b)
                } else if k == MI_UN {
                    fold_use(w, ins.c)
                } else if k == MI_BIN {
                    fold_use(w, ins.c)
                    fold_use(w, ins.d)
                } else if k == MI_SELECT {
                    fold_use(w, ins.b)
                    fold_use(w, ins.c)
                    fold_use(w, ins.d)
                }
                if k == MI_CALL || k == MI_CALL_IND {
                    $a := ins.c
                    while a >= 0 {
                        fold_use(w, f.margs[a].v)
                        a = f.margs[a].next
                    }
                }
                ii = ins.next
            }
            tk := f.blocks[bi].tkind
            if tk == TKIND_BRANCH || tk == TKIND_RETURN {
                fold_use(w, f.blocks[bi].ta)
            }
        }
        for bi in 0:nb {
            $prev := -1
            $ii := f.blocks[bi].head
            while ii >= 0 {
                ins := &f.instrs[ii]
                nx := ins.next
                if fold_pure(ins.kind) && ins.a >= 0 && ins.a < nt && w.uses[ins.a] == 0 {
                    if prev < 0 {
                        f.blocks[bi].head = nx
                    } else {
                        f.instrs[prev].next = nx
                    }
                    f.instrs[ii].kind = MI_NOP
                    changed = true
                } else {
                    prev = ii
                }
                ii = nx
            }
            f.blocks[bi].tail = prev
        }
        if !changed {
            <-
        }
    }
    fold_compact(f, w)
}

// Drops unreachable blocks from the layout (block 0 stays first).
fn fold_compact(f $&MFn, w $&FoldWork) {
    fold_reachable(f, w)
    nb := f.blocks.len
    mir_fill_int($&w.pos, nb, -1)
    $n := 0
    for bi in 0:nb {
        if w.reach[bi] {
            w.pos[bi] = n
            n += 1
        }
    }
    if n == nb {
        <<
    }
    $nbl := []MBlock{}
    for bi in 0:nb {
        if !w.reach[bi] { -> }
        $blk := ~f.blocks[bi]
        if blk.tkind == TKIND_JUMP {
            blk.ta = w.pos[blk.ta]
        } else if blk.tkind == TKIND_BRANCH {
            blk.tb = w.pos[blk.tb]
            blk.tc = w.pos[blk.tc]
        }
        nbl.push(~blk)
    }
    f.blocks = ~nbl
}

fn fold_is_cmp(op int) bool {
    << (op >= BIN_EQ && op <= BIN_GE) || (op >= BIN_FEQ && op <= BIN_FGE)
}

pub fn lower_target_sqrt(u $&Mir) {
    for fi in 0:u.fns.len {
        $f := $&u.fns[fi]
        if f.label == "_xu_math_sqrt" { -> }
        for ii in 0:f.instrs.len {
            if f.instrs[ii].kind == MI_CALL && f.instrs[ii].sval == "_xu_math_sqrt" {
                c := f.instrs[ii].c
                if c >= 0 && f.margs[c].next < 0 {
                    arg := f.margs[c].v
                    if f.instrs[ii].a >= 0 {
                        f.instrs[ii].kind = MI_UN
                        f.instrs[ii].b = UN_FSQRT
                        f.instrs[ii].c = arg
                        f.instrs[ii].d = 0
                        f.instrs[ii].sval = ""
                    } else {
                        f.instrs[ii].kind = MI_NOP
                        f.instrs[ii].c = -1
                        f.instrs[ii].sval = ""
                    }
                }
            }
        }
    }
}

fn rotr_reach(f &MFn) []bool {
    nb := f.blocks.len
    $r := []bool{}
    for _ in 0:nb { r.push(false) }
    if nb == 0 { << r }
    $q := []int{}
    r[0] = true
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !r[s] {
                r[s] = true
                q.push(s)
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            if sb >= 0 && sb < nb && !r[sb] {
                r[sb] = true
                q.push(sb)
            }
            sc := f.blocks[b].tc
            if sc >= 0 && sc < nb && !r[sc] {
                r[sc] = true
                q.push(sc)
            }
        }
    }
    << r
}

fn rotr_add_use(u_head $&[]int, u_ii $&[]int, u_next $&[]int, v int, ii int) {
    if v >= 0 && v < u_head.len {
        u_ii.push(ii)
        u_next.push(u_head[v])
        u_head[v] = u_ii.len - 1
    }
}

fn rotr_mark_bad(has_bad $&[]bool, v int) {
    if v >= 0 && v < has_bad.len {
        has_bad[v] = true
    }
}

fn rotr_u32_unwrap(f &MFn, def_cnt &[]int, def_ii &[]int, v int) int {
    if v < 0 || v >= def_cnt.len || def_cnt[v] != 1 { << -1 }
    vi := def_ii[v]
    vins := &f.instrs[vi]
    if vins.kind == MI_BIN && vins.b == BIN_AND {
        if vins.d <= -2 && fold_cval(f, vins.d) == 4294967295 && vins.c >= 0 {
            << vins.c
        }
        if vins.c <= -2 && fold_cval(f, vins.c) == 4294967295 && vins.d >= 0 {
            << vins.d
        }
    }
    << -1
}

fn rotr_is_u32_clean(f &MFn, def_cnt &[]int, def_ii &[]int, v int) bool {
    if v < 0 || v >= def_cnt.len || def_cnt[v] != 1 { << false }
    vi := def_ii[v]
    vins := &f.instrs[vi]
    if vins.kind == MI_LOAD_PTR {
        << vins.d == 1 || vins.d == 2 || vins.d == 4
    }
    if vins.kind == MI_BIN {
        if vins.b == BIN_ROTR32 || fold_is_cmp(vins.b) {
            << true
        }
        if vins.b == BIN_AND {
            if vins.d <= -2 {
                m := fold_cval(f, vins.d)
                if m >= 0 && m <= 4294967295 { << true }
            }
            if vins.c <= -2 {
                m := fold_cval(f, vins.c)
                if m >= 0 && m <= 4294967295 { << true }
            }
        }
    }
    << false
}

fn rotr_is_nonneg64(f &MFn, def_cnt &[]int, def_ii &[]int, v int) bool {
    if v < 0 || v >= def_cnt.len || def_cnt[v] != 1 { << false }
    vi := def_ii[v]
    vins := &f.instrs[vi]
    if vins.kind == MI_LOAD_PTR {
        << vins.d == 1 || vins.d == 2 || vins.d == 4
    }
    if vins.kind == MI_BIN {
        if vins.b == BIN_ROTR32 || fold_is_cmp(vins.b) { << true }
        if vins.b == BIN_AND {
            if vins.d <= -2 && fold_cval(f, vins.d) >= 0 { << true }
            if vins.c <= -2 && fold_cval(f, vins.c) >= 0 { << true }
        }
    }
    << false
}

fn rotr_low32_only(f &MFn, def_cnt &[]int, has_bad &[]bool, u_head &[]int, u_ii &[]int, u_next &[]int, v int, depth int) bool {
    if depth >= 6 || v < 0 || v >= u_head.len || has_bad[v] { << false }
    $ui := u_head[v]
    if ui < 0 { << false }
    while ui >= 0 {
        ii := u_ii[ui]
        uins := &f.instrs[ii]
        uk := uins.kind
        if uk == MI_COPY {
            if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
            if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
        } else if uk == MI_STORE_PTR {
            if uins.a == v || uins.b != v || (uins.d != 1 && uins.d != 2 && uins.d != 4) { << false }
        } else if uk == MI_BIN {
            ub := uins.b
            if ub == BIN_AND {
                $masked := false
                if uins.d <= -2 {
                    mc := fold_cval(f, uins.d)
                    if mc >= 0 && mc <= 4294967295 { masked = true }
                }
                if !masked && uins.c <= -2 {
                    mc := fold_cval(f, uins.c)
                    if mc >= 0 && mc <= 4294967295 { masked = true }
                }
                if !masked {
                    if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
                    if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
                }
            } else if ub == BIN_ROTR32 {
                if uins.c != v || uins.d == v { << false }
            } else if ub == BIN_ADD || ub == BIN_SUB || ub == BIN_MUL || ub == BIN_OR || ub == BIN_XOR {
                if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
                if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
            } else if ub == BIN_SHL && uins.c == v && uins.d != v {
                if uins.a < 0 || uins.a == v || def_cnt[uins.a] != 1 { << false }
                if !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, uins.a, depth + 1) { << false }
            } else {
                << false
            }
        } else {
            << false
        }
        ui = u_next[ui]
    }
    << true
}

fn rotr_try32(f &MFn, def_cnt &[]int, def_ii &[]int, has_bad &[]bool, u_head &[]int, u_ii &[]int, u_next &[]int, dst int, a int, b int, out_kr $&[]int) int {
    if a < 0 || a >= def_cnt.len || b < 0 || b >= def_cnt.len { << -1 }
    if def_cnt[a] != 1 || def_cnt[b] != 1 { << -1 }
    $shl_ii := def_ii[a]
    $need_low32 := true
    ains := &f.instrs[shl_ii]
    if ains.kind == MI_BIN && ains.b == BIN_AND {
        $inner := -1
        if ains.d <= -2 && fold_cval(f, ains.d) == 4294967295 {
            inner = ains.c
        } else if ains.c <= -2 && fold_cval(f, ains.c) == 4294967295 {
            inner = ains.d
        }
        if inner < 0 || inner >= def_cnt.len || def_cnt[inner] != 1 { << -1 }
        shl_ii = def_ii[inner]
        need_low32 = false
    }
    sins := &f.instrs[shl_ii]
    if sins.kind != MI_BIN || sins.b != BIN_SHL || sins.c < 0 || sins.d > -2 { << -1 }
    kl := fold_cval(f, sins.d)
    if kl < 1 || kl > 31 { << -1 }
    lx := sins.c
    ri := def_ii[b]
    rins := &f.instrs[ri]
    if rins.kind != MI_BIN || rins.b != BIN_SHR || rins.c < 0 || rins.d > -2 { << -1 }
    kr := fold_cval(f, rins.d)
    if kr != 32 - kl { << -1 }
    rx := rins.c
    if !rotr_is_u32_clean(f, def_cnt, def_ii, rx) { << -1 }
    rx_u := rotr_u32_unwrap(f, def_cnt, def_ii, rx)
    lx_u := rotr_u32_unwrap(f, def_cnt, def_ii, lx)
    $base := -1
    if lx == rx {
        if rx_u >= 0 { base = rx_u }
        else { base = rx }
    } else if rx_u >= 0 && lx == rx_u {
        base = rx_u
    } else if lx_u >= 0 && rx == lx_u {
        base = lx_u
    } else if rx_u >= 0 && lx_u >= 0 && rx_u == lx_u {
        base = rx_u
    }
    if base < 0 || base >= def_cnt.len || def_cnt[base] != 1 { << -1 }
    if need_low32 && !rotr_low32_only(f, def_cnt, has_bad, u_head, u_ii, u_next, dst, 0) {
        << -1
    }
    out_kr[0] = kr
    << base
}

fn rotr_try64(f &MFn, def_cnt &[]int, def_ii &[]int, a int, b int, out_kr $&[]int) int {
    if a < 0 || a >= def_cnt.len || b < 0 || b >= def_cnt.len { << -1 }
    if def_cnt[a] != 1 || def_cnt[b] != 1 { << -1 }
    ai := def_ii[a]
    sins := &f.instrs[ai]
    if sins.kind != MI_BIN || sins.b != BIN_SHL || sins.c < 0 || sins.d > -2 { << -1 }
    kl := fold_cval(f, sins.d)
    if kl < 1 || kl > 63 { << -1 }
    lx := sins.c
    $bi := def_ii[b]
    bins := &f.instrs[bi]
    $need_nonneg := true
    if bins.kind == MI_BIN && bins.b == BIN_AND {
        $exp := 9223372036854775807
        if kl < 63 { exp = (1 << kl) - 1 }
        $inner := -1
        if bins.d <= -2 && fold_cval(f, bins.d) == exp {
            inner = bins.c
        } else if bins.c <= -2 && fold_cval(f, bins.c) == exp {
            inner = bins.d
        }
        if inner < 0 || inner >= def_cnt.len || def_cnt[inner] != 1 { << -1 }
        bi = def_ii[inner]
        need_nonneg = false
    }
    rins := &f.instrs[bi]
    if rins.kind != MI_BIN || rins.b != BIN_SHR || rins.c != lx || rins.d > -2 { << -1 }
    kr := fold_cval(f, rins.d)
    if kr != 64 - kl { << -1 }
    if need_nonneg && !rotr_is_nonneg64(f, def_cnt, def_ii, lx) { << -1 }
    if lx >= def_cnt.len || def_cnt[lx] != 1 { << -1 }
    out_kr[0] = kr
    << lx
}

pub fn opt_rotr(f $&MFn) bool {
    $has_cand := false
    for ii in 0:f.instrs.len {
        ins := &f.instrs[ii]
        if !fold_known_kind(ins.kind) {
            << false
        }
        if ins.kind == MI_BIN && ins.b == BIN_OR {
            has_cand = true
        } else if ins.kind == MI_CALL && (ins.sval == "_xu_math_bits_rotate_right" || ins.sval == "_xu_math_bits_rotate_left") {
            has_cand = true
        }
    }
    if !has_cand { << false }
    nt := f.temps.len
    reach := rotr_reach(f)
    $def_cnt := []int{}
    $def_ii := []int{}
    $has_bad := []bool{}
    $u_head := []int{}
    for _ in 0:nt {
        def_cnt.push(0)
        def_ii.push(-1)
        has_bad.push(false)
        u_head.push(-1)
    }
    $u_ii := []int{}
    $u_next := []int{}
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := &f.instrs[ii]
            k := ins.kind
            if fold_defines(k) && ins.a >= 0 && ins.a < nt {
                def_cnt[ins.a] = def_cnt[ins.a] + 1
                def_ii[ins.a] = ii
            }
            if k == MI_COPY {
                rotr_add_use($&u_head, $&u_ii, $&u_next, ins.b, ii)
            } else if k == MI_STORE_LOCAL {
                rotr_mark_bad($&has_bad, ins.b)
            } else if k == MI_LOAD_PTR {
                rotr_mark_bad($&has_bad, ins.b)
            } else if k == MI_STORE_PTR {
                rotr_mark_bad($&has_bad, ins.a)
                rotr_add_use($&u_head, $&u_ii, $&u_next, ins.b, ii)
            } else if k == MI_BIN {
                rotr_add_use($&u_head, $&u_ii, $&u_next, ins.c, ii)
                if ins.d != ins.c {
                    rotr_add_use($&u_head, $&u_ii, $&u_next, ins.d, ii)
                }
            } else if k == MI_UN {
                rotr_mark_bad($&has_bad, ins.c)
            } else if k == MI_SELECT {
                rotr_mark_bad($&has_bad, ins.b)
                rotr_mark_bad($&has_bad, ins.c)
                rotr_mark_bad($&has_bad, ins.d)
            } else if k == MI_CALL || k == MI_CALL_IND {
                if k == MI_CALL_IND { rotr_mark_bad($&has_bad, ins.b) }
                $mi := ins.c
                while mi >= 0 {
                    rotr_mark_bad($&has_bad, f.margs[mi].v)
                    mi = f.margs[mi].next
                }
            }
            ii = ins.next
        }
        tk := f.blocks[bi].tkind
        if tk == TKIND_RETURN || tk == TKIND_BRANCH {
            rotr_mark_bad($&has_bad, f.blocks[bi].ta)
        }
    }
    $changed := false
    $out_kr := []int{}
    out_kr.push(0)
    for bi in 0:f.blocks.len {
        if !reach[bi] { -> }
        $ii := f.blocks[bi].head
        while ii >= 0 {
            ins := ~f.instrs[ii]
            nx := ins.next
            if ins.kind == MI_BIN && ins.b == BIN_OR && ins.a >= 0 {
                $base := rotr_try32(f, &def_cnt, &def_ii, &has_bad, &u_head, &u_ii, &u_next, ins.a, ins.c, ins.d, $&out_kr)
                $op := BIN_ROTR32
                if base < 0 {
                    base = rotr_try32(f, &def_cnt, &def_ii, &has_bad, &u_head, &u_ii, &u_next, ins.a, ins.d, ins.c, $&out_kr)
                }
                if base < 0 {
                    op = BIN_ROTR64
                    base = rotr_try64(f, &def_cnt, &def_ii, ins.c, ins.d, $&out_kr)
                }
                if base < 0 {
                    base = rotr_try64(f, &def_cnt, &def_ii, ins.d, ins.c, $&out_kr)
                }
                if base >= 0 {
                    kc := alloc_const(f, out_kr[0])
                    f.instrs[ii].b = op
                    f.instrs[ii].c = base
                    f.instrs[ii].d = kc
                    changed = true
                }
            } else if ins.kind == MI_CALL && (ins.sval == "_xu_math_bits_rotate_right" || ins.sval == "_xu_math_bits_rotate_left") {
                c0 := ins.c
                if c0 >= 0 {
                    c1 := f.margs[c0].next
                    if c1 >= 0 && f.margs[c1].next < 0 {
                        arg0 := f.margs[c0].v
                        arg1 := f.margs[c1].v
                        if ins.sval == "_xu_math_bits_rotate_right" {
                            if ins.a >= 0 {
                                f.instrs[ii].kind = MI_BIN
                                f.instrs[ii].b = BIN_ROTR64
                                f.instrs[ii].c = arg0
                                f.instrs[ii].d = arg1
                                f.instrs[ii].sval = ""
                            } else {
                                f.instrs[ii].kind = MI_NOP
                                f.instrs[ii].c = -1
                                f.instrs[ii].sval = ""
                            }
                            changed = true
                        } else if arg1 <= -2 {
                            kl := fold_cval(f, arg1) & 63
                            kr := (64 - kl) & 63
                            if ins.a >= 0 {
                                kc := alloc_const(f, kr)
                                f.instrs[ii].kind = MI_BIN
                                f.instrs[ii].b = BIN_ROTR64
                                f.instrs[ii].c = arg0
                                f.instrs[ii].d = kc
                                f.instrs[ii].sval = ""
                            } else {
                                f.instrs[ii].kind = MI_NOP
                                f.instrs[ii].c = -1
                                f.instrs[ii].sval = ""
                            }
                            changed = true
                        }
                    }
                }
            }
            ii = nx
        }
    }
    << changed
}
