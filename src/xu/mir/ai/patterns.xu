@xu/mir/ai

#xu/ast
#xu/parser
#xu/types

// Match the typed range and index before ordinary lowering expands a fixed
// array into a descriptor, bounds branches, and pointer arithmetic.
pub fn static_range_extent(p &parser.Parser, n int) int {
    if n < 0 || p.nodes[n].kind != ast.NK_FOR { << 0 }
    lo_id := p.nodes[n].a
    hi_id := p.nodes[n].b
    if lo_id < 0 || hi_id < 0 { << 0 }
    lo := &p.nodes[lo_id]
    hi := &p.nodes[hi_id]
    if lo.kind != ast.NK_INT || lo.ival != 0 || hi.kind != ast.NK_INT { << 0 }
    << hi.ival
}

pub fn range_uses_iv(p &parser.Parser, tp &types.TypedProgram, n int, id int) bool {
    << n >= 0 && p.nodes[n].kind == ast.NK_IDENT && tp.local_of(n) == id
}

pub const TENSOR_I8 = 7

pub const TENSOR_F64 = 4

pub const TENSOR_F32 = 14

pub fn tensor_assignment(p &parser.Parser, stmt int, assign int, op int) int {
    if stmt < 0 || p.nodes[stmt].kind != ast.NK_ASSIGN ||
       p.nodes[stmt].ival != assign || p.nodes[stmt].next >= 0 {
        << -1
    }
    rhs := p.nodes[stmt].b
    if p.nodes[rhs].kind != ast.NK_BIN_OP || p.nodes[rhs].ival != op {
        << -1
    }
    << stmt
}

// Match before scalar lowering erases the static extent and unit stride.
pub fn pointwise_assignment(p &parser.Parser, loop int, extent int, op int) int {
    if static_range_extent(p, loop) != extent { << -1 }
    << tensor_assignment(p, p.nodes[loop].c, ast.AS_ASSIGN, op)
}

pub fn pointwise_base(p &parser.Parser, tp &types.TypedProgram, index int, loop int) int {
    if p.nodes[index].kind != ast.NK_INDEX || tp.type_of(index) != TENSOR_F32 ||
       !range_uses_iv(p, tp, p.nodes[index].b, tp.local_of(loop)) {
        << -1
    }
    base := p.nodes[index].a
    if p.nodes[base].kind != ast.NK_IDENT { << -1 }
    << base
}

// A fresh binding can only be observed after these adjacent statements
// through a later reference to its name. Include nested statements and
// function literal bodies, where a capture has a different typed local ID.
// Shadowed uses conservatively keep the temporary. Bound recursion even
// when presented with a deeply nested or synthesized tree.
pub fn tensor_may_reference(p &parser.Parser, head int, name &string, depth int) bool {
    $n := head
    while n >= 0 {
        if n >= p.nodes.len || depth >= 64 { << true }
        node := &p.nodes[n]
        if node.kind == ast.NK_IDENT && node.sval == *name { << true }
        if node.kind == ast.NK_ARM_RANGE {
            // A range arm's d is a literal bound, not a child.
            if tensor_may_reference(p, node.c, name, depth + 1) { << true }
        } else if tensor_may_reference(p, node.a, name, depth + 1) ||
                  tensor_may_reference(p, node.b, name, depth + 1) ||
                  tensor_may_reference(p, node.c, name, depth + 1) ||
                  tensor_may_reference(p, node.d, name, depth + 1) ||
                  tensor_may_reference(p, node.e, name, depth + 1) {
            << true
        }
        n = node.next
    }
    << false
}

// A scalar literal initializer may sit between the residual and reduction
// loops. It cannot read the residual, change an input, or fail.
pub fn reduction_seed(p &parser.Parser, tp &types.TypedProgram, stmt int) bool {
    if stmt < 0 || p.nodes[stmt].kind != ast.NK_LET { << false }
    value := p.nodes[stmt].a
    if tp.type_of(value) != TENSOR_F32 { << false }
    if p.nodes[value].kind == ast.NK_FLOAT { << true }
    if p.nodes[value].kind == ast.NK_CAST && p.nodes[value].ival == TENSOR_F32 {
        arg := p.nodes[value].a
        << p.nodes[arg].kind == ast.NK_INT || p.nodes[arg].kind == ast.NK_FLOAT
    }
    << false
}

// Match either sum += r[j] * r[j] or a scalar read followed by sum += v * v.
pub fn tensor_square_sum(p &parser.Parser, tp &types.TypedProgram, loop int, residual int) int {
    $stmt := p.nodes[loop].c
    if stmt < 0 { << -1 }
    $value := -1
    if p.nodes[stmt].kind == ast.NK_LET {
        base := pointwise_base(p, tp, p.nodes[stmt].a, loop)
        if tp.local_of(base) != residual { << -1 }
        value = tp.local_of(stmt)
        if value < 0 { << -1 }
        stmt = p.nodes[stmt].next
    }
    reduce := tensor_assignment(p, stmt, ast.AS_ADD, ast.OP_MUL)
    if reduce < 0 { << -1 }
    square := p.nodes[reduce].b
    a := p.nodes[square].a
    b := p.nodes[square].b
    if value >= 0 {
        if !range_uses_iv(p, tp, a, value) || !range_uses_iv(p, tp, b, value) { << -1 }
    } else {
        if tp.local_of(pointwise_base(p, tp, a, loop)) != residual ||
           tp.local_of(pointwise_base(p, tp, b, loop)) != residual {
            << -1
        }
    }
    if tp.type_of(square) != TENSOR_F32 { << -1 }
    << reduce
}

pub fn tensor_dynamic_bound(p &parser.Parser, loop int) int {
    if loop < 0 || p.nodes[loop].kind != ast.NK_FOR { << -1 }
    lo := p.nodes[loop].a
    if lo < 0 || p.nodes[lo].kind != ast.NK_INT || p.nodes[lo].ival != 0 { << -1 }
    << p.nodes[loop].b
}

pub fn tensor_same_offset(p &parser.Parser, tp &types.TypedProgram, off_a int, off_b int) bool {
    if off_a < 0 && off_b < 0 { << true }
    if off_a < 0 || off_b < 0 { << false }
    na := &p.nodes[off_a]
    nb := &p.nodes[off_b]
    if na.kind == ast.NK_INT && nb.kind == ast.NK_INT {
        << na.ival == nb.ival
    }
    if na.kind == ast.NK_IDENT && nb.kind == ast.NK_IDENT {
        << tp.local_of(off_a) == tp.local_of(off_b)
    }
    << false
}

fn tensor_neg_f64(p &parser.Parser, tp &types.TypedProgram, n int, expect_id int) bool {
    if n < 0 || tp.type_of(n) != TENSOR_F64 { << false }
    if p.nodes[n].kind == ast.NK_CAST {
        arg := p.nodes[n].a
        << arg >= 0 && p.nodes[arg].kind == ast.NK_UN_OP && p.nodes[arg].ival == ast.UN_NEG &&
           tensor_ident_id(p, tp, p.nodes[arg].a, expect_id)
    }
    if p.nodes[n].kind == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_NEG {
        << tensor_f64_cast_ident(p, tp, p.nodes[n].a, expect_id)
    }
    << false
}

pub fn tensor_math_exp_call(p &parser.Parser, tp &types.TypedProgram, n int, expect_id int) bool {
    if n < 0 { << false }
    k := p.nodes[n].kind
    if k != ast.NK_CALL && k != ast.NK_METHOD_CALL { << false }
    fi := tp.call_of(n)
    if fi < 0 || fi >= tp.fns.len || tp.fns[fi].label != "_xu_math_exp" { << false }
    $arg := p.nodes[n].a
    if k == ast.NK_METHOD_CALL { arg = p.nodes[n].b }
    << arg >= 0 && p.nodes[arg].next < 0 && tensor_neg_f64(p, tp, arg, expect_id)
}

pub fn tensor_mul_pair_ids(p &parser.Parser, tp &types.TypedProgram, e int, id_a int, id_b int) bool {
    if e < 0 || p.nodes[e].kind != ast.NK_BIN_OP || p.nodes[e].ival != ast.OP_MUL || tp.type_of(e) != TENSOR_F32 {
        << false
    }
    a := p.nodes[e].a
    b := p.nodes[e].b
    << (tensor_ident_id(p, tp, a, id_a) && tensor_ident_id(p, tp, b, id_b)) ||
       (tensor_ident_id(p, tp, b, id_a) && tensor_ident_id(p, tp, a, id_b))
}

pub fn tensor_unwrap_f32_cast(p &parser.Parser, tp &types.TypedProgram, e int) int {
    if e >= 0 && p.nodes[e].kind == ast.NK_CAST && tp.type_of(e) == TENSOR_F32 &&
       p.nodes[e].a >= 0 && tp.type_of(p.nodes[e].a) == TENSOR_F32 {
        << p.nodes[e].a
    }
    << e
}

pub fn tensor_same_bound_atom(p &parser.Parser, tp &types.TypedProgram, a int, b int) bool {
    if a < 0 || b < 0 { << false }
    if p.nodes[b].kind == ast.NK_INT {
        << tensor_int_lit(p, a, p.nodes[b].ival)
    }
    bid := tp.local_of(b)
    << bid >= 0 && tensor_ident_id(p, tp, a, bid)
}

pub fn tensor_mul_iv_bound(p &parser.Parser, tp &types.TypedProgram, expr int, iv int, bound_node int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_MUL {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (range_uses_iv(p, tp, a, iv) && tensor_same_bound_atom(p, tp, b, bound_node)) ||
       (range_uses_iv(p, tp, b, iv) && tensor_same_bound_atom(p, tp, a, bound_node))
}

pub fn tensor_i8_cast_ident(p &parser.Parser, tp &types.TypedProgram, expr int, expect_base_id int, expect_iv int) int {
    if expr < 0 || p.nodes[expr].kind != ast.NK_CAST || tp.type_of(expr) != 1 { << -1 }
    idx := p.nodes[expr].a
    if idx < 0 || p.nodes[idx].kind != ast.NK_INDEX || tp.type_of(idx) != TENSOR_I8 { << -1 }
    if !tensor_add_local_iv(p, tp, p.nodes[idx].b, expect_base_id, expect_iv) { << -1 }
    << p.nodes[idx].a
}
