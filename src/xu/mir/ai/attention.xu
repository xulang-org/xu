@xu/mir/ai

#xu/ast
#xu/parser
#xu/types

pub fn tensor_collect_add_terms(p &parser.Parser, expr int, out $&[]int, depth int) bool {
    if expr < 0 || depth >= 16 { << false }
    if p.nodes[expr].kind == ast.NK_BIN_OP && p.nodes[expr].ival == ast.OP_ADD {
        << tensor_collect_add_terms(p, p.nodes[expr].a, out, depth + 1) &&
           tensor_collect_add_terms(p, p.nodes[expr].b, out, depth + 1)
    }
    out.push(expr)
    << true
}

pub fn tensor_mul_pair_of(p &parser.Parser, tp &types.TypedProgram, expr int, a_id int, b_id int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_MUL {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_ident_id(p, tp, a, a_id) && tensor_ident_id(p, tp, b, b_id)) ||
       (tensor_ident_id(p, tp, b, a_id) && tensor_ident_id(p, tp, a, b_id))
}

// Match cg * 4 * row_bytes or (cg * 4) * row_bytes or cg * (4 * row_bytes).
pub fn tensor_pack_base0(p &parser.Parser, tp &types.TypedProgram, expr int, cg_iv int, row_bytes_id int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_MUL {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    if tensor_ident_id(p, tp, b, row_bytes_id) && tensor_scaled_mul_iv(p, tp, a, cg_iv, 4) { << true }
    if tensor_ident_id(p, tp, a, row_bytes_id) && tensor_scaled_mul_iv(p, tp, b, cg_iv, 4) { << true }
    if tensor_ident_id(p, tp, a, cg_iv) && tensor_scaled_mul_iv(p, tp, b, row_bytes_id, 4) { << true }
    if tensor_ident_id(p, tp, b, cg_iv) && tensor_scaled_mul_iv(p, tp, a, row_bytes_id, 4) { << true }
    << false
}

pub fn tensor_shr_4(p &parser.Parser, tp &types.TypedProgram, expr int, iv int) bool {
    << expr >= 0 && p.nodes[expr].kind == ast.NK_BIN_OP && p.nodes[expr].ival == ast.OP_SHR &&
       range_uses_iv(p, tp, p.nodes[expr].a, iv) && tensor_int_lit(p, p.nodes[expr].b, 4)
}

pub fn tensor_and_15(p &parser.Parser, tp &types.TypedProgram, expr int, iv int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_BIT_AND {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (range_uses_iv(p, tp, a, iv) && tensor_int_lit(p, b, 15)) ||
       (range_uses_iv(p, tp, b, iv) && tensor_int_lit(p, a, 15))
}
