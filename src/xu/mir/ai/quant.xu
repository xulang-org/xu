@xu/mir/ai

#xu/ast
#xu/parser
#xu/types

pub fn tensor_ident_id(p &parser.Parser, tp &types.TypedProgram, n int, expect_id int) bool {
    << n >= 0 && p.nodes[n].kind == ast.NK_IDENT && tp.local_of(n) == expect_id &&
       !tp.borrows_place(n) && tp.clone_of(n) == 0 && tp.box_of(n) == 0
}

pub fn tensor_int_lit(p &parser.Parser, n int, want int) bool {
    << n >= 0 && p.nodes[n].kind == ast.NK_INT && p.nodes[n].ival == want
}

pub fn tensor_is_f32_zero(p &parser.Parser, tp &types.TypedProgram, n int) bool {
    if n < 0 || tp.type_of(n) != TENSOR_F32 || p.nodes[n].kind != ast.NK_CAST {
        << false
    }
    arg := p.nodes[n].a
    if arg < 0 { << false }
    << (p.nodes[arg].kind == ast.NK_INT && p.nodes[arg].ival == 0) ||
       (p.nodes[arg].kind == ast.NK_FLOAT && p.nodes[arg].ival == 0)
}

pub fn tensor_scaled_mul_iv(p &parser.Parser, tp &types.TypedProgram, expr int, iv int, stride int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_MUL {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (range_uses_iv(p, tp, a, iv) && tensor_int_lit(p, b, stride)) ||
       (range_uses_iv(p, tp, b, iv) && tensor_int_lit(p, a, stride))
}

pub fn tensor_add_local_iv(p &parser.Parser, tp &types.TypedProgram, expr int, base_id int, iv int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_ADD {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_ident_id(p, tp, a, base_id) && range_uses_iv(p, tp, b, iv)) ||
       (tensor_ident_id(p, tp, b, base_id) && range_uses_iv(p, tp, a, iv))
}

pub fn tensor_add_local_const(p &parser.Parser, tp &types.TypedProgram, expr int, base_id int, cval int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_ADD {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_ident_id(p, tp, a, base_id) && tensor_int_lit(p, b, cval)) ||
       (tensor_ident_id(p, tp, b, base_id) && tensor_int_lit(p, a, cval))
}

fn tensor_add_const_iv(p &parser.Parser, tp &types.TypedProgram, expr int, cval int, iv int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_ADD {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_int_lit(p, a, cval) && range_uses_iv(p, tp, b, iv)) ||
       (tensor_int_lit(p, b, cval) && range_uses_iv(p, tp, a, iv))
}

fn tensor_add_local_const_iv(p &parser.Parser, tp &types.TypedProgram, expr int, base_id int, cval int, iv int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_ADD {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_add_local_const(p, tp, a, base_id, cval) && range_uses_iv(p, tp, b, iv)) ||
       (range_uses_iv(p, tp, a, iv) && tensor_add_local_const(p, tp, b, base_id, cval)) ||
       (tensor_add_local_iv(p, tp, a, base_id, iv) && tensor_int_lit(p, b, cval)) ||
       (tensor_int_lit(p, a, cval) && tensor_add_local_iv(p, tp, b, base_id, iv)) ||
       (tensor_ident_id(p, tp, a, base_id) && tensor_add_const_iv(p, tp, b, cval, iv)) ||
       (tensor_add_const_iv(p, tp, a, cval, iv) && tensor_ident_id(p, tp, b, base_id))
}

pub fn tensor_bit_and_byte_15(p &parser.Parser, tp &types.TypedProgram, expr int, byte_id int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_BIT_AND {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_ident_id(p, tp, a, byte_id) && tensor_int_lit(p, b, 15)) ||
       (tensor_ident_id(p, tp, b, byte_id) && tensor_int_lit(p, a, 15))
}

pub fn tensor_shr_byte_4(p &parser.Parser, tp &types.TypedProgram, expr int, byte_id int) bool {
    if expr >= 0 && p.nodes[expr].kind == ast.NK_BIN_OP && p.nodes[expr].ival == ast.OP_SHR &&
       tensor_ident_id(p, tp, p.nodes[expr].a, byte_id) && tensor_int_lit(p, p.nodes[expr].b, 4) {
        << true
    }
    if expr >= 0 && p.nodes[expr].kind == ast.NK_BIN_OP && p.nodes[expr].ival == ast.OP_BIT_AND {
        a := p.nodes[expr].a
        b := p.nodes[expr].b
        if tensor_int_lit(p, b, 15) && a >= 0 && p.nodes[a].kind == ast.NK_BIN_OP &&
           p.nodes[a].ival == ast.OP_SHR && tensor_ident_id(p, tp, p.nodes[a].a, byte_id) &&
           tensor_int_lit(p, p.nodes[a].b, 4) {
            << true
        }
        if tensor_int_lit(p, a, 15) && b >= 0 && p.nodes[b].kind == ast.NK_BIN_OP &&
           p.nodes[b].ival == ast.OP_SHR && tensor_ident_id(p, tp, p.nodes[b].a, byte_id) &&
           tensor_int_lit(p, p.nodes[b].b, 4) {
            << true
        }
    }
    << false
}

pub fn tensor_f32_cast_ident(p &parser.Parser, tp &types.TypedProgram, expr int, expect_id int) bool {
    if expr < 0 || tp.type_of(expr) != TENSOR_F32 || p.nodes[expr].kind != ast.NK_CAST {
        << false
    }
    << tensor_ident_id(p, tp, p.nodes[expr].a, expect_id)
}

pub fn tensor_q4_term(p &parser.Parser, tp &types.TypedProgram, expr int, q_id int, x_base_id int, cval int, j_iv int, x_out $&int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP ||
       p.nodes[expr].ival != ast.OP_MUL || tp.type_of(expr) != TENSOR_F32 {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    $idx := -1
    if tensor_f32_cast_ident(p, tp, a, q_id) && b >= 0 && p.nodes[b].kind == ast.NK_INDEX {
        idx = b
    } else if tensor_f32_cast_ident(p, tp, b, q_id) && a >= 0 && p.nodes[a].kind == ast.NK_INDEX {
        idx = a
    } else {
        << false
    }
    if tp.type_of(idx) != TENSOR_F32 { << false }
    if cval == 0 {
        if !tensor_add_local_iv(p, tp, p.nodes[idx].b, x_base_id, j_iv) { << false }
    } else {
        if !tensor_add_local_const_iv(p, tp, p.nodes[idx].b, x_base_id, cval, j_iv) { << false }
    }
    *x_out = p.nodes[idx].a
    << true
}

pub fn tensor_int_zero(p &parser.Parser, n int) bool {
    << n >= 0 && p.nodes[n].kind == ast.NK_INT && p.nodes[n].ival == 0
}

pub fn tensor_q4_q8_term(p &parser.Parser, tp &types.TypedProgram, expr int, q_id int, x_base_id int, cval int, j_iv int, xq_out $&int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP ||
       p.nodes[expr].ival != ast.OP_MUL || tp.type_of(expr) != 1 {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    $cast := -1
    if tensor_ident_id(p, tp, a, q_id) {
        cast = b
    } else if tensor_ident_id(p, tp, b, q_id) {
        cast = a
    } else {
        << false
    }
    if cast < 0 || p.nodes[cast].kind != ast.NK_CAST || tp.type_of(cast) != 1 {
        << false
    }
    idx := p.nodes[cast].a
    if idx < 0 || p.nodes[idx].kind != ast.NK_INDEX || tp.type_of(idx) != TENSOR_I8 {
        << false
    }
    if cval == 0 {
        if !tensor_add_local_iv(p, tp, p.nodes[idx].b, x_base_id, j_iv) { << false }
    } else {
        if !tensor_add_local_const_iv(p, tp, p.nodes[idx].b, x_base_id, cval, j_iv) { << false }
    }
    *xq_out = p.nodes[idx].a
    << true
}

pub fn tensor_f64_lit(p &parser.Parser, tp &types.TypedProgram, n int, want_bits int) bool {
    if n < 0 || tp.type_of(n) != TENSOR_F64 { << false }
    if p.nodes[n].kind == ast.NK_FLOAT {
        << p.nodes[n].ival == want_bits
    }
    if want_bits == 0 && p.nodes[n].kind == ast.NK_CAST {
        arg := p.nodes[n].a
        << arg >= 0 && ((p.nodes[arg].kind == ast.NK_INT && p.nodes[arg].ival == 0) ||
                       (p.nodes[arg].kind == ast.NK_FLOAT && p.nodes[arg].ival == 0))
    }
    << false
}

fn tensor_signed_int_lit(p &parser.Parser, n int, want int) bool {
    if n < 0 { << false }
    if p.nodes[n].kind == ast.NK_INT && p.nodes[n].ival == want { << true }
    if want < 0 && p.nodes[n].kind == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_NEG {
        << tensor_int_lit(p, p.nodes[n].a, -want)
    }
    << false
}

pub fn tensor_f64_cast_ident(p &parser.Parser, tp &types.TypedProgram, n int, expect_id int) bool {
    << n >= 0 && tp.type_of(n) == TENSOR_F64 && p.nodes[n].kind == ast.NK_CAST &&
       tensor_ident_id(p, tp, p.nodes[n].a, expect_id)
}

pub fn tensor_q8_clamp_if(p &parser.Parser, tp &types.TypedProgram, stmt int, q_id int, op int, lim int) bool {
    if stmt < 0 || p.nodes[stmt].kind != ast.NK_IF { << false }
    br := p.nodes[stmt].a
    if br < 0 || p.nodes[br].next >= 0 { << false }
    cond := p.nodes[br].a
    if cond < 0 || p.nodes[cond].kind != ast.NK_BIN_OP || p.nodes[cond].ival != op ||
       !tensor_ident_id(p, tp, p.nodes[cond].a, q_id) ||
       !tensor_signed_int_lit(p, p.nodes[cond].b, lim) {
        << false
    }
    body := p.nodes[br].b
    if body < 0 || p.nodes[body].kind != ast.NK_ASSIGN || p.nodes[body].ival != ast.AS_ASSIGN ||
       p.nodes[body].next >= 0 {
        << false
    }
    << tensor_ident_id(p, tp, p.nodes[body].a, q_id) && tensor_signed_int_lit(p, p.nodes[body].b, lim)
}

fn tensor_p4k4_shr2_mul16(p &parser.Parser, tp &types.TypedProgram, expr int, j_iv int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_MUL {
        << false
    }
    $shr := p.nodes[expr].a
    $cst := p.nodes[expr].b
    if tensor_int_lit(p, p.nodes[expr].a, 16) {
        shr = p.nodes[expr].b
        cst = p.nodes[expr].a
    }
    if !tensor_int_lit(p, cst, 16) || shr < 0 || p.nodes[shr].kind != ast.NK_BIN_OP ||
       p.nodes[shr].ival != ast.OP_SHR {
        << false
    }
    << range_uses_iv(p, tp, p.nodes[shr].a, j_iv) && tensor_int_lit(p, p.nodes[shr].b, 2)
}

fn tensor_p4k4_and3(p &parser.Parser, tp &types.TypedProgram, expr int, j_iv int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_BIT_AND {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (range_uses_iv(p, tp, a, j_iv) && tensor_int_lit(p, b, 3)) ||
       (range_uses_iv(p, tp, b, j_iv) && tensor_int_lit(p, a, 3))
}

pub fn tensor_p4k4_idx(p &parser.Parser, tp &types.TypedProgram, expr int, q_base_id int, j_iv int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_ADD {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    // (q_base + (j >> 2) * 16) + (j & 3)
    if tensor_p4k4_and3(p, tp, b, j_iv) && a >= 0 && p.nodes[a].kind == ast.NK_BIN_OP && p.nodes[a].ival == ast.OP_ADD {
        aa := p.nodes[a].a
        ab := p.nodes[a].b
        if (tensor_ident_id(p, tp, aa, q_base_id) && tensor_p4k4_shr2_mul16(p, tp, ab, j_iv)) ||
           (tensor_ident_id(p, tp, ab, q_base_id) && tensor_p4k4_shr2_mul16(p, tp, aa, j_iv)) {
            << true
        }
    }
    if tensor_p4k4_and3(p, tp, a, j_iv) && b >= 0 && p.nodes[b].kind == ast.NK_BIN_OP && p.nodes[b].ival == ast.OP_ADD {
        ba := p.nodes[b].a
        bb := p.nodes[b].b
        if (tensor_ident_id(p, tp, ba, q_base_id) && tensor_p4k4_shr2_mul16(p, tp, bb, j_iv)) ||
           (tensor_ident_id(p, tp, bb, q_base_id) && tensor_p4k4_shr2_mul16(p, tp, ba, j_iv)) {
            << true
        }
    }
    << false
}

pub fn tensor_i8_cast_p4k4_ident(p &parser.Parser, tp &types.TypedProgram, expr int, q_base_id int, j_iv int) int {
    if expr < 0 || tp.type_of(expr) != 1 || p.nodes[expr].kind != ast.NK_CAST { << -1 }
    idx := p.nodes[expr].a
    if idx < 0 || p.nodes[idx].kind != ast.NK_INDEX || tp.type_of(idx) != TENSOR_I8 { << -1 }
    if !tensor_p4k4_idx(p, tp, p.nodes[idx].b, q_base_id, j_iv) { << -1 }
    << p.nodes[idx].a
}

pub fn tensor_p4_add_scaled_iv(p &parser.Parser, tp &types.TypedProgram, expr int,
                           id_a int, s_a int, id_b int, s_b int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_ADD {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_scaled_mul_iv(p, tp, a, id_a, s_a) && tensor_scaled_mul_iv(p, tp, b, id_b, s_b)) ||
       (tensor_scaled_mul_iv(p, tp, b, id_a, s_a) && tensor_scaled_mul_iv(p, tp, a, id_b, s_b))
}

pub fn tensor_p4_scale_idx(p &parser.Parser, tp &types.TypedProgram, expr int, gb_id int, r4_id int) bool {
    if expr < 0 || p.nodes[expr].kind != ast.NK_BIN_OP || p.nodes[expr].ival != ast.OP_ADD {
        << false
    }
    a := p.nodes[expr].a
    b := p.nodes[expr].b
    << (tensor_scaled_mul_iv(p, tp, a, gb_id, 4) && tensor_ident_id(p, tp, b, r4_id)) ||
       (tensor_scaled_mul_iv(p, tp, b, gb_id, 4) && tensor_ident_id(p, tp, a, r4_id))
}
