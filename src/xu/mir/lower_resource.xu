@xu/mir

#xu/types

// Unique-resource arrays cannot be cloned. Their element hooks run once
// before their buffer is released; ordinary buffer-only lowering is unchanged.
fn resource_drop_walk(tp &types.TypedProgram, ty int, seen $&[]int) bool {
    if types.is_ref_type(ty) { << false }
    for i in 0:seen.len { if seen[i] == ty { << false } }
    seen.push(ty)
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if tp.structs[si].has_drop { << true }
        for i in 0:tp.structs[si].fields.len {
            if resource_drop_walk(tp, tp.structs[si].fields[i].ty, seen) { << true }
        }
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if tp.arrays[ai].fixed_len == 0 {
            << resource_drop_walk(tp, tp.arrays[ai].elem_ty, seen)
        }
    }
    << false
}

fn resource_drop_type(tp &types.TypedProgram, ty int) bool {
    $seen := []int{}
    << resource_drop_walk(tp, ty, $&seen)
}

fn resource_drop_label(ty int) string { << "_xu_resource_drop_" + str(ty) }

fn resource_drop_types(tp &types.TypedProgram) []int {
    $out := []int{}
    for i in 0:tp.structs.len {
        ty := types.struct_type(i)
        if resource_drop_type(tp, ty) { out.push(ty) }
    }
    for i in 0:tp.arrays.len {
        ty := types.array_type(i)
        if resource_drop_type(tp, ty) { out.push(ty) }
    }
    << out
}

// Separate MIR functions keep recursive resource arrays finite at compile time.
// Calls to a hook are discovered by the ordinary demand-driven function queue.
fn lower_resource_drop(tp &types.TypedProgram, ty int, os int, arch int,
    names &[]string, labels &[]string) MFn {
    $w := lw_new("resource_drop", resource_drop_label(ty), -1, os, arch)
    for i in 0:names.len {
        w.core_names.push(names[i] + "")
        w.core_labels.push(labels[i] + "")
    }
    w.f.blocks.push(mblock_new())
    w.f.active_bb = 0
    slot := w.new_local(1, 1, "value")
    w.f.nparams = 1
    address := w.load_local(slot, 0)
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        hook := tp.structs[si].drop_label + ""
        if hook.len > 0 {
            args := [address]
            w.call(hook, &args)
        }
        for i in 0:tp.structs[si].fields.len {
            field := &tp.structs[si].fields[i]
            if w.needs_drop(tp, field.ty) {
                at := w.bin(BIN_ADD, address, w.konst(field.offset))
                w.drop_value(tp, at, field.ty)
            }
        }
    } else {
        ai := types.array_index(ty)
        element := tp.arrays[ai].elem_ty
        // Dynamic arrays may be interned before a forward/cross-module
        // struct is laid out. Use its final size, as element stores do.
        size := tp.size_of(element)
        count := w.load_ptr(address, 8, 8)
        data := w.load_ptr(address, 0, 8)
        index := w.new_local(1, 1, "index")
        w.store_local(index, 0, w.konst(0))
        cond := w.new_block()
        body := w.new_block()
        done := w.new_block()
        w.jump(cond)
        w.f.active_bb = cond
        current := w.load_local(index, 0)
        w.branch(w.bin(BIN_LT, current, count), body, done)
        w.f.active_bb = body
        offset := w.bin(BIN_MUL, current, w.konst(size))
        w.drop_value(tp, w.bin(BIN_ADD, data, offset), element)
        w.store_local(index, 0, w.bin(BIN_ADD, current, w.konst(1)))
        w.jump(cond)
        w.f.active_bb = done
        args := [address]
        w.call_core("str_free", &args)
    }
    w.ret(w.konst(0))
    << mfn_copy(&w.f)
}
