@xu/mir

#xu/types

// Unique-resource arrays cannot be cloned. Their element hooks run once
// before their buffer is released; ordinary buffer-only lowering is unchanged.
fn type_needs_elem_drop(tp &types.TypedProgram, ty int, seen $&[]int) bool {
    if types.is_ref_type(ty) { << false }
    if ty == 3 { << true }
    for i in 0:seen.len { if seen[i] == ty { << false } }
    seen.push(ty)
    if types.is_array_type(ty) {
        << tp.arrays[types.array_index(ty)].fixed_len == 0
    }
    if types.is_map_type(ty) || types.is_interface_type(ty) || types.is_fn_type(ty) || is_dyn_box_type(ty) {
        << true
    }
    if types.is_enum_type(ty) {
        if !is_wide(tp, ty) { << false }
        ei := types.enum_index(ty)
        for vi in 0:tp.enums[ei].variants.len {
            for fi in 0:tp.enums[ei].variants[vi].fields.len {
                if type_needs_elem_drop(tp, tp.enums[ei].variants[vi].fields[fi], seen) {
                    << true
                }
            }
        }
    }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if tp.structs[si].has_drop { << true }
        for i in 0:tp.structs[si].fields.len {
            if type_needs_elem_drop(tp, tp.structs[si].fields[i].ty, seen) { << true }
        }
    }
    << false
}

fn resource_drop_walk(tp &types.TypedProgram, ty int, seen $&[]int) bool {
    if types.is_ref_type(ty) { << false }
    for i in 0:seen.len { if seen[i] == ty { << false } }
    seen.push(ty)
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        if tp.structs[si].has_drop { << true }
        for i in 0:tp.structs[si].fields.len {
            if resource_drop_walk(tp, tp.structs[si].fields[i].ty, seen) { << true }
        }
    }
    if types.is_map_type(ty) || types.is_interface_type(ty) || types.is_fn_type(ty) || is_dyn_box_type(ty) {
        << true
    }
    if types.is_enum_type(ty) {
        if !is_wide(tp, ty) { << false }
        ei := types.enum_index(ty)
        for vi in 0:tp.enums[ei].variants.len {
            $eseens := []int{}
            for fi in 0:tp.enums[ei].variants[vi].fields.len {
                if type_needs_elem_drop(tp, tp.enums[ei].variants[vi].fields[fi], $&eseens) {
                    << true
                }
            }
        }
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if tp.arrays[ai].fixed_len == 0 {
            $eseens := []int{}
            << type_needs_elem_drop(tp, tp.arrays[ai].elem_ty, $&eseens)
        }
    }
    << false
}

fn resource_drop_type(tp &types.TypedProgram, ty int) bool {
    $seen := []int{}
    << resource_drop_walk(tp, ty, $&seen)
}

fn resource_drop_label(ty int) string { << "_xu_resource_drop_" + str(ty) }

// Every type that can own heap memory gets a glue label. Scope exits call
// the glue only for resource_drop_type; boxes and closure environments store
// the glue address of whatever they hold (strings and buffer-only structs
// included), so those labels must resolve too. Glue is lowered on demand.
fn resource_drop_types(tp &types.TypedProgram) []int {
    $out := []int{}
    out.push(3)
    out.push(types.temp_type_id())
    out.push(types.any_type_id())
    for i in 0:tp.structs.len {
        ty := types.struct_type(i)
        $seen := []int{}
        if type_needs_elem_drop(tp, ty, $&seen) { out.push(ty) }
    }
    for i in 0:tp.arrays.len {
        ty := types.array_type(i)
        if tp.arrays[i].fixed_len == 0 { out.push(ty) }
    }
    for i in 0:tp.enums.len {
        ty := types.enum_type(i)
        $seen := []int{}
        if type_needs_elem_drop(tp, ty, $&seen) { out.push(ty) }
    }
    for i in 0:tp.maps.len {
        out.push(types.map_type(i))
    }
    for i in 0:tp.sig_ret.len {
        out.push(types.fn_type(i))
    }
    $i := 0
    while i + 1 < tp.boxed.len {
        ity := tp.boxed[i]
        $found := false
        for j in 0:out.len {
            if out[j] == ity {
                found = true
            }
        }
        if !found {
            out.push(ity)
        }
        i += 2
    }
    for n in 0:tp.base_type.len {
        bty := tp.base_type[n]
        if types.is_interface_type(bty) {
            $found := false
            for j in 0:out.len {
                if out[j] == bty {
                    found = true
                }
            }
            if !found {
                out.push(bty)
            }
        }
    }
    << out
}

// Separate MIR functions keep recursive resource arrays finite at compile time.
// Calls to a hook are discovered by the ordinary demand-driven function queue.
fn lower_resource_drop(tp &types.TypedProgram, ty int, os int, arch int,
    names &[]string, labels &[]string) MFn {
    $w := lw_new("resource_drop", resource_drop_label(ty), -1, os, arch)
    for i in 0:names.len {
        w.core_names.push(names[i] + "")
        w.core_labels.push(labels[i] + "")
    }
    w.f.blocks.push(mblock_new())
    w.f.active_bb = 0
    slot := w.new_local(1, 1, "value")
    w.f.nparams = 1
    address := w.load_local(slot, 0)
    if ty == 3 {
        args := [address]
        w.call_core("str_free", &args)
    } else if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        hook := tp.structs[si].drop_label + ""
        if hook.len > 0 {
            args := [address]
            w.call(hook, &args)
        }
        for i in 0:tp.structs[si].fields.len {
            field := &tp.structs[si].fields[i]
            if w.needs_drop(tp, field.ty) {
                at := w.bin(BIN_ADD, address, w.konst(field.offset))
                w.drop_value(tp, at, field.ty)
            }
        }
    } else if types.is_enum_type(ty) {
        ei := types.enum_index(ty)
        tag := w.load_ptr(address, 0, 8)
        done_b := w.new_block()
        for vi in 0:tp.enums[ei].variants.len {
            $has_drop := false
            for fi in 0:tp.enums[ei].variants[vi].fields.len {
                if w.needs_drop(tp, tp.enums[ei].variants[vi].fields[fi]) {
                    has_drop = true
                }
            }
            if !has_drop {
                ->
            }
            then_b := w.new_block()
            next_b := w.new_block()
            w.branch(w.bin(BIN_EQ, tag, w.konst(vi)), then_b, next_b)
            w.f.active_bb = then_b
            for fi in 0:tp.enums[ei].variants[vi].fields.len {
                fty := tp.enums[ei].variants[vi].fields[fi]
                if w.needs_drop(tp, fty) {
                    at := w.bin(BIN_ADD, address, w.konst(tp.enums[ei].variants[vi].offsets[fi]))
                    w.drop_value(tp, at, fty)
                }
            }
            w.jump(done_b)
            w.f.active_bb = next_b
        }
        w.jump(done_b)
        w.f.active_bb = done_b
    } else if types.is_map_type(ty) {
        m := w.load_ptr(address, 0, 8)
        w.map_drop_values(tp, m, ty)
        $args := []int{}
        args.push(m)
        w.call_core("map_free", &args)
    } else if types.is_interface_type(ty) {
        w.box_release(tp, w.load_ptr(address, 0, 8))
    } else if types.is_fn_type(ty) {
        w.fnval_drop(tp, address)
    } else if is_dyn_box_type(ty) {
        w.dyn_drop(tp, address)
    } else {
        ai := types.array_index(ty)
        element := tp.arrays[ai].elem_ty
        // Dynamic arrays may be interned before a forward/cross-module
        // struct is laid out. Use its final size, as element stores do.
        if w.needs_drop(tp, element) {
            size := tp.size_of(element)
            count := w.load_ptr(address, 8, 8)
            data := w.load_ptr(address, 0, 8)
            index := w.new_local(1, 1, "index")
            w.store_local(index, 0, w.konst(0))
            cond := w.new_block()
            body := w.new_block()
            done := w.new_block()
            w.jump(cond)
            w.f.active_bb = cond
            current := w.load_local(index, 0)
            w.branch(w.bin(BIN_LT, current, count), body, done)
            w.f.active_bb = body
            offset := w.bin(BIN_MUL, current, w.konst(size))
            w.drop_value(tp, w.bin(BIN_ADD, data, offset), element)
            w.store_local(index, 0, w.bin(BIN_ADD, current, w.konst(1)))
            w.jump(cond)
            w.f.active_bb = done
        }
        args := [address]
        w.call_core("str_free", &args)
    }
    w.ret(w.konst(0))
    << mfn_copy(&w.f)
}

// ===== clone glue =====

fn clone_glue_label(ty int) string { << "_xu_clone_" + str(ty) }

// Dynamic arrays and maps whose elements own memory are deep-copied by a
// glue function _xu_clone_<ty>(dst, src).
fn (w &Lw) uses_clone_glue(tp &types.TypedProgram, ty int) bool {
    << clone_glue_type(tp, ty)
}

fn clone_glue_type(tp &types.TypedProgram, ty int) bool {
    $seen := []int{}
    if types.is_map_type(ty) {
        mi := types.map_index(ty)
        << type_needs_elem_drop(tp, tp.maps[mi].val_ty, $&seen)
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if tp.arrays[ai].fixed_len != 0 { << false }
        << type_needs_elem_drop(tp, tp.arrays[ai].elem_ty, $&seen)
    }
    << false
}

fn clone_glue_types(tp &types.TypedProgram) []int {
    $out := []int{}
    for i in 0:tp.arrays.len {
        ty := types.array_type(i)
        if clone_glue_type(tp, ty) { out.push(ty) }
    }
    for i in 0:tp.maps.len {
        ty := types.map_type(i)
        if clone_glue_type(tp, ty) { out.push(ty) }
    }
    << out
}

fn lower_clone_glue(tp &types.TypedProgram, ty int, os int, arch int,
    names &[]string, labels &[]string) MFn {
    $w := lw_new("clone", clone_glue_label(ty), -1, os, arch)
    for i in 0:names.len {
        w.core_names.push(names[i] + "")
        w.core_labels.push(labels[i] + "")
    }
    w.f.blocks.push(mblock_new())
    w.f.active_bb = 0
    dslot := w.new_local(1, 1, "dst")
    sslot := w.new_local(1, 1, "src")
    w.f.nparams = 2
    w.in_clone_glue = true
    w.clone_into(tp, w.load_local(dslot, 0), w.load_local(sslot, 0), ty)
    w.ret(w.konst(0))
    << mfn_copy(&w.f)
}

// ===== shared heap boxes =====

// Give up one holder of box bx (0 is no box). The last holder runs the
// value's drop glue and frees the box.
fn (w $&Lw) box_release(tp &types.TypedProgram, bx int) {
    slot := w.new_local(1, 1, "bx")
    w.store_local(slot, 0, bx)
    some_b := w.new_block()
    done_b := w.new_block()
    w.branch(bx, some_b, done_b)
    w.f.active_bb = some_b
    b := w.load_local(slot, 0)
    rc := w.load_ptr(b, BOX_RC, 8)
    shared_b := w.new_block()
    last_b := w.new_block()
    w.branch(rc, shared_b, last_b)
    w.f.active_bb = shared_b
    w.store_ptr(w.load_local(slot, 0), BOX_RC, w.bin(BIN_SUB, w.load_ptr(w.load_local(slot, 0), BOX_RC, 8), w.konst(1)), 8)
    w.jump(done_b)
    w.f.active_bb = last_b
    b2 := w.load_local(slot, 0)
    tag := w.load_ptr(b2, 0, 8)
    drop_fn := w.load_ptr(b2, 8, 8)
    has_drop_b := w.new_block()
    free_b := w.new_block()
    w.branch(drop_fn, has_drop_b, free_b)
    w.f.active_bb = has_drop_b
    $cargs := []int{}
    cargs.push(w.bin(BIN_ADD, w.load_local(slot, 0), w.konst(BOX_HDR)))
    w.call_ind(drop_fn, &cargs)
    w.jump(free_b)
    w.f.active_bb = free_b
    is_str_b := w.new_block()
    after_str_b := w.new_block()
    w.branch(w.bin(BIN_EQ, tag, w.konst(ERR_STR_TAG)), is_str_b, after_str_b)
    w.f.active_bb = is_str_b
    $sargs := []int{}
    sargs.push(w.bin(BIN_ADD, w.load_local(slot, 0), w.konst(BOX_HDR)))
    w.call_core("str_free", &sargs)
    w.jump(after_str_b)
    w.f.active_bb = after_str_b
    $fargs := []int{}
    fargs.push(w.load_local(slot, 0))
    w.call_core("free_owned", &fargs)
    w.jump(done_b)
    w.f.active_bb = done_b
}

// Add a holder to box bx (0 is no box).
fn (w $&Lw) box_retain(bx int) {
    slot := w.new_local(1, 1, "bx")
    w.store_local(slot, 0, bx)
    some_b := w.new_block()
    done_b := w.new_block()
    w.branch(bx, some_b, done_b)
    w.f.active_bb = some_b
    b := w.load_local(slot, 0)
    w.store_ptr(b, BOX_RC, w.bin(BIN_ADD, w.load_ptr(b, BOX_RC, 8), w.konst(1)), 8)
    w.jump(done_b)
    w.f.active_bb = done_b
}
