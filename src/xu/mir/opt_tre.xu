@xu/mir
// Eliminate self tail calls when the frame has no address-taken storage.
// Arguments are MIR temps, so all are evaluated before any parameter write.

pub fn opt_tre(f $&MFn) bool {
    if !f.scalar_params || f.nparams == 0 || f.param_locals.len != f.nparams || f.blocks.len == 0 {
        << false
    }
    for i in 0:f.nparams {
        if f.param_locals[i] != i { << false }
    }
    for i in 0:f.instrs.len {
        if !fold_known_kind(f.instrs[i].kind) || f.instrs[i].kind == MI_ADDR {
            << false
        }
    }
    $changed := false
    for bi in 0:f.blocks.len {
        if f.blocks[bi].tkind != TKIND_RETURN { -> }
        ii := f.blocks[bi].tail
        if ii < 0 || f.instrs[ii].kind != MI_CALL || f.instrs[ii].sval != f.label ||
           f.instrs[ii].a != f.blocks[bi].ta || f.instrs[ii].a < 0 {
            ->
        }

        $args := []int{}
        $arg := f.instrs[ii].c
        while arg >= 0 {
            args.push(f.margs[arg].v)
            arg = f.margs[arg].next
        }
        if args.len != f.nparams { -> }
        f.instrs[ii].kind = MI_NOP
        for i in 0:args.len {
            add_instr(f, bi, new_instr(MI_STORE_LOCAL, i, args[i], 0, 0, f.blocks[bi].line))
        }
        f.blocks[bi].tkind = TKIND_JUMP
        f.blocks[bi].ta = f.blocks.len
        f.blocks[bi].tb = -1
        f.blocks[bi].tc = -1
        changed = true
    }
    if changed {
        // Keep entry outside the loop so the allocator models the backedge
        // and retains incoming values even when they are read in the header.
        header := f.blocks.len
        f.blocks.push(~f.blocks[0])
        f.blocks[0] = mblock_new()
        f.blocks[0].tkind = TKIND_JUMP
        f.blocks[0].ta = header
    }
    << changed
}
