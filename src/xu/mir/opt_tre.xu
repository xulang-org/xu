@xu/mir
// Tail Recursion Elimination (TRE) pass.
//
// Layer 3 module: transforms self-tail-calls into in-place parameter updates
// and direct jumps to the entry block, reducing call overhead and collapsing
// call stack depth from O(N) to O(1).

pub fn opt_tre(mfn $&MFn) bool {
    if mfn.blocks.len == 0 || mfn.nparams == 0 {
        << false
    }

    $changed := false

    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].tkind == TKIND_RETURN {
            ret_val := mfn.blocks[bi].ta
            if ret_val >= 0 {
                // Find instruction defining ret_val
                $tail_ii := -1
                $curr := mfn.blocks[bi].head
                while curr >= 0 && curr < mfn.instrs.len {
                    ins := ~mfn.instrs[curr]
                    if ins.kind == MI_CALL && ins.a == ret_val {
                        // Check if calling self
                        fn_name := ins.sval
                        if fn_name == mfn.name || fn_name == mfn.label || fn_name == "_" + mfn.name {
                            tail_ii = curr
                        }
                    }
                    if curr == mfn.blocks[bi].tail { <- }
                    curr = ins.next
                }

                if tail_ii >= 0 {
                    // Collect actual arguments
                    $args := []int{}
                    $arg_idx := mfn.instrs[tail_ii].c
                    while arg_idx >= 0 && arg_idx < mfn.margs.len {
                        args.push(mfn.margs[arg_idx].v)
                        arg_idx = mfn.margs[arg_idx].next
                    }

                    if args.len == mfn.nparams {
                        // Direct store to parameter slots
                        for pi in 0:args.len {
                            $st := minstr_new(MI_STORE_LOCAL)
                            st.a = pi
                            st.b = args[pi]
                            emit_to_bb(mfn, bi, st)
                        }

                        // Remove the MI_CALL instruction
                        mfn.instrs[tail_ii].kind = MI_NOP

                        // Convert block terminator to unconditional jump to entry block 0
                        mfn.blocks[bi].tkind = TKIND_JUMP
                        mfn.blocks[bi].ta = 0
                        mfn.blocks[bi].tb = -1
                        mfn.blocks[bi].tc = -1

                        changed = true
                    }
                }
            }
        }
    }

    << changed
}
