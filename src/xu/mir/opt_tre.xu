@xu/mir
// Eliminate self tail calls when the frame has no address-taken storage.
// Arguments are MIR temps, so all are evaluated before any parameter write.

// Last non-NOP instruction in block bi, or -1.
fn tre_last_nonnop(f &MFn, bi int) int {
    $last := -1
    $ii := f.blocks[bi].head
    while ii >= 0 {
        if f.instrs[ii].kind != MI_NOP {
            last = ii
        }
        ii = f.instrs[ii].next
    }
    << last
}

// Follow a chain of empty (NOP-only) TKIND_JUMP blocks (<= 4 hops) from start.
// If it lands on an empty TKIND_RETURN block, return that block index, else -1.
fn tre_empty_ret_target(f &MFn, start int) int {
    nb := f.blocks.len
    $cur := start
    for _ in 0:4 {
        if cur < 0 || cur >= nb { << -1 }
        if tre_last_nonnop(f, cur) >= 0 { << -1 }
        if f.blocks[cur].tkind == TKIND_RETURN { << cur }
        if f.blocks[cur].tkind != TKIND_JUMP { << -1 }
        cur = f.blocks[cur].ta
    }
    << -1
}

// True when every reachable base-case TKIND_RETURN in f returns the constant cval.
fn tre_all_returns_const(f &MFn, cval int) bool {
    nb := f.blocks.len
    $reach := []bool{}
    for _ in 0:nb { reach.push(false) }
    $q := []int{}
    reach[0] = true
    q.push(0)
    $qh := 0
    while qh < q.len {
        b := q[qh]
        qh += 1
        tk := f.blocks[b].tkind
        if tk == TKIND_JUMP {
            s := f.blocks[b].ta
            if s >= 0 && s < nb && !reach[s] {
                reach[s] = true
                q.push(s)
            }
        } else if tk == TKIND_BRANCH {
            sb := f.blocks[b].tb
            sc := f.blocks[b].tc
            if sb >= 0 && sb < nb && !reach[sb] {
                reach[sb] = true
                q.push(sb)
            }
            if sc >= 0 && sc < nb && !reach[sc] {
                reach[sc] = true
                q.push(sc)
            }
        }
    }
    for bi in 0:nb {
        if !reach[bi] || f.blocks[bi].tkind != TKIND_RETURN { -> }
        rta := f.blocks[bi].ta
        if rta <= -2 && f.consts[0 - rta - 2] == cval { -> }
        tii := tre_last_nonnop(f, bi)
        if tii >= 0 && f.instrs[tii].kind == MI_CALL && f.instrs[tii].sval == f.label &&
           f.instrs[tii].a == rta && f.instrs[tii].a >= 0 {
            ->
        }
        << false
    }
    << true
}

// Record per-parameter write counts and single-def instruction indices;
// returns false if any instruction has an unknown kind or takes a local address.
fn tre_collect_param_info(f &MFn, pre_stores $&[]int, ndef $&[]int, def_ii $&[]int) bool {
    nt := f.temps.len
    for _ in 0:f.nparams { pre_stores.push(0) }
    for _ in 0:nt {
        ndef.push(0)
        def_ii.push(-1)
    }
    for i in 0:f.instrs.len {
        ins := &f.instrs[i]
        k := ins.kind
        if !fold_known_kind(k) || k == MI_ADDR {
            << false
        }
        if k == MI_STORE_LOCAL && ins.a >= 0 && ins.a < f.nparams {
            pre_stores[ins.a] = pre_stores[ins.a] + 1
        }
        if fold_defines(k) && ins.a >= 0 && ins.a < nt {
            ndef[ins.a] = ndef[ins.a] + 1
            def_ii[ins.a] = i
        }
    }
    << true
}

// True if recursive call arg av simply reloads unmodified parameter i.
fn tre_is_self_param_arg(f &MFn, pre_stores &[]int, ndef &[]int, def_ii &[]int, i int, av int) bool {
    if i < 0 || i >= pre_stores.len || pre_stores[i] != 0 || av < 0 || av >= ndef.len || ndef[av] != 1 {
        << false
    }
    dii := def_ii[av]
    << dii >= 0 && f.instrs[dii].kind == MI_LOAD_LOCAL && f.instrs[dii].b == i && f.instrs[dii].c == 0
}

pub fn opt_tre(f $&MFn) bool {
    if f.is_extern || f.is_naked || f.nparams == 0 || f.param_locals.len != f.nparams || f.blocks.len == 0 {
        << false
    }
    if f.local_names.len < f.nparams || f.locals_nslots.len < f.nparams {
        << false
    }
    for i in 0:f.nparams {
        if f.param_locals[i] != i || f.locals_nslots[i] != 1 { << false }
        if f.local_names[i] == ".okp" || f.local_names[i] == ".sret" { << false }
        if i < f.locals_owning.len && f.locals_owning[i] { << false }
    }
    for i in 0:f.local_names.len {
        if f.local_names[i] == ".acc" { << false }
    }
    $pre_stores := []int{}
    $ndef := []int{}
    $def_ii := []int{}
    if !tre_collect_param_info(f, $&pre_stores, $&ndef, $&def_ii) {
        << false
    }
    $checked_const := false
    $const_ok := false
    $const_val := 0
    $changed := false
    orig_nb := f.blocks.len
    for bi in 0:orig_nb {
        tk := f.blocks[bi].tkind
        if tk != TKIND_RETURN && tk != TKIND_JUMP { -> }
        ii := tre_last_nonnop(f, bi)
        if ii < 0 || f.instrs[ii].kind != MI_CALL || f.instrs[ii].sval != f.label {
            ->
        }
        $rb := bi
        if tk == TKIND_JUMP {
            rb = tre_empty_ret_target(f, f.blocks[bi].ta)
        }
        $ret_ok := false
        if rb >= 0 {
            rta := f.blocks[rb].ta
            if f.instrs[ii].a >= 0 && f.instrs[ii].a == rta {
                ret_ok = true
            } else if rta <= -2 {
                cv := f.consts[0 - rta - 2]
                if !checked_const {
                    checked_const = true
                    const_val = cv
                    const_ok = tre_all_returns_const(f, cv)
                }
                if const_ok && cv == const_val {
                    ret_ok = true
                }
            }
        }
        if !ret_ok { -> }

        $args := []int{}
        $arg := f.instrs[ii].c
        while arg >= 0 {
            args.push(f.margs[arg].v)
            arg = f.margs[arg].next
        }
        if args.len != f.nparams { -> }
        f.instrs[ii].kind = MI_NOP
        for i in 0:args.len {
            if !tre_is_self_param_arg(f, &pre_stores, &ndef, &def_ii, i, args[i]) {
                add_instr(f, bi, new_instr(MI_STORE_LOCAL, i, args[i], 0, 0, f.blocks[bi].line))
            }
        }
        f.blocks[bi].tkind = TKIND_JUMP
        f.blocks[bi].ta = orig_nb
        f.blocks[bi].tb = -1
        f.blocks[bi].tc = -1
        changed = true
    }
    if changed {
        // Keep entry outside the loop so the allocator models the backedge
        // and retains incoming values even when they are read in the header.
        header := f.blocks.len
        f.blocks.push(~f.blocks[0])
        f.blocks[0] = mblock_new()
        f.blocks[0].tkind = TKIND_JUMP
        f.blocks[0].ta = header
    }
    << changed
}
