@xu/mir
// Inline small, straight-line leaves using the typed ABI's incoming words.

const INLINE_MAX_INSTRS = 16
const INLINE_MAX_GROWTH = 128

fn inline_leaf(f &MFn) bool {
    if f.is_extern || f.blocks.len == 0 || f.instrs.len == 0 ||
       f.instrs.len > INLINE_MAX_INSTRS || f.blocks[0].tkind != TKIND_RETURN {
        << false
    }
    // The only other blocks can be empty continuations after a return.
    for bi in 1:f.blocks.len {
        if f.blocks[bi].head >= 0 { << false }
    }
    for ii in 0:f.instrs.len {
        ins := &f.instrs[ii]
        k := ins.kind
        if k == MI_LOAD_LOCAL {
            if ins.b < 0 || ins.b >= f.nparams || ins.c != 0 { << false }
        } else if k != MI_COPY && k != MI_BIN && k != MI_UN &&
                  k != MI_LOAD_PTR && k != MI_STORE_PTR {
            << false
        }
    }
    << true
}

fn inline_value(v int, temp_base int, constants &[]int) int {
    if v >= 0 { << temp_base + v }
    if v <= -2 { << constants[0 - v - 2] }
    << v
}

fn inline_leaf_at(caller $&MFn, bi int, call int, prev int, leaf &MFn) int {
    $args := []int{}
    $arg := caller.instrs[call].c
    while arg >= 0 {
        args.push(caller.margs[arg].v)
        arg = caller.margs[arg].next
    }
    if args.len != leaf.nparams { << call }

    $constants := []int{}
    for i in 0:leaf.consts.len {
        constants.push(alloc_const(caller, leaf.consts[i]))
    }
    base := caller.temps.len
    for i in 0:leaf.temps.len {
        caller.temps.push(leaf.temps[i])
        caller.temps_nslots.push(leaf.temps_nslots[i])
    }

    line := caller.instrs[call].line
    $tail := prev
    $ii := leaf.blocks[0].head
    while ii >= 0 {
        $ins := ~leaf.instrs[ii]
        k := ins.kind
        ins.a = inline_value(ins.a, base, &constants)
        if k == MI_LOAD_LOCAL {
            ins.kind = MI_COPY
            ins.b = args[ins.b]
        } else if k == MI_COPY || k == MI_LOAD_PTR || k == MI_STORE_PTR {
            ins.b = inline_value(ins.b, base, &constants)
        } else if k == MI_BIN || k == MI_UN {
            ins.c = inline_value(ins.c, base, &constants)
            if k == MI_BIN { ins.d = inline_value(ins.d, base, &constants) }
        }
        ii = ins.next
        ins.next = call
        ins.line = line
        idx := caller.instrs.len
        caller.instrs.push(ins)
        if tail < 0 {
            caller.blocks[bi].head = idx
        } else {
            caller.instrs[tail].next = idx
        }
        tail = idx
    }

    if caller.instrs[call].a >= 0 && leaf.blocks[0].ta != -1 {
        caller.instrs[call].kind = MI_COPY
        caller.instrs[call].b = inline_value(leaf.blocks[0].ta, base, &constants)
        tail = call
    } else if tail >= 0 {
        caller.instrs[tail].next = caller.instrs[call].next
    } else {
        caller.blocks[bi].head = caller.instrs[call].next
    }
    if tail != call { caller.instrs[call].kind = MI_NOP }
    caller.instrs[call].c = -1
    caller.instrs[call].sval = ""
    << tail
}

pub fn opt_inline(unit $&Mir, native_entries &[]bool) {
    // The machine backend replaces these bodies after MIR optimization.
    $leaves := label_index_new(unit.fns.len * 2 + 16)
    for fi in 0:unit.fns.len {
        if !native_entries[fi] && inline_leaf(&unit.fns[fi]) {
            leaves.put(&unit.fns[fi].label, fi)
        }
    }
    for fi in 0:unit.fns.len {
        limit := unit.fns[fi].instrs.len + INLINE_MAX_GROWTH
        for bi in 0:unit.fns[fi].blocks.len {
            $ii := unit.fns[fi].blocks[bi].head
            $prev := -1
            while ii >= 0 {
                next := unit.fns[fi].instrs[ii].next
                $tail := ii
                if unit.fns[fi].instrs[ii].kind == MI_CALL && unit.fns[fi].instrs.len < limit {
                    callee := leaves.get(&unit.fns[fi].instrs[ii].sval)
                    if callee >= 0 {
                        leaf := mfn_copy(&unit.fns[callee])
                        tail = inline_leaf_at($&unit.fns[fi], bi, ii, prev, &leaf)
                    }
                }
                prev = tail
                ii = next
            }
            unit.fns[fi].blocks[bi].tail = prev
        }
    }
}
