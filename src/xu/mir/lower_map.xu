@xu/mir
// Native maps and for-in over channels.
//
// A map value is one word: the address of a runtime/core map record (see
// runtime/core/map.xu). Keys are handed to the runtime by address (the int
// word or the string descriptor); values are copied in and out by
// size_of(V) bytes at the value address the runtime returns.

#xu/ast
#xu/parser
#xu/types

fn map_val_ty(tp &types.TypedProgram, mt int) int {
    mi := types.map_index(tp.deref(tp.deref(mt)))
    if mi >= 0 && mi < tp.maps.len {
        << tp.maps[mi].val_ty
    }
    << 1
}

fn map_key_ty(tp &types.TypedProgram, mt int) int {
    mi := types.map_index(tp.deref(tp.deref(mt)))
    if mi >= 0 && mi < tp.maps.len {
        << tp.maps[mi].key_ty
    }
    << 1
}

// Free the owned values of every live entry of map m (keys and the record
// are freed by map_free).
fn (w $&Lw) map_drop_values(tp &types.TypedProgram, m int, mt int) {
    vty := map_val_ty(tp, mt)
    if !w.needs_drop(tp, vty) {
        <<
    }
    ms := w.new_local(1, 1, "md")
    w.store_local(ms, 0, m)
    ix := w.new_local(1, 1, "mdi")
    $a0 := []int{}
    a0.push(m)
    a0.push(w.konst(0))
    w.store_local(ix, 0, w.call_core("map_next", &a0))
    cond_b := w.new_block()
    body_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    w.branch(w.bin(BIN_GE, w.load_local(ix, 0), w.konst(0)), body_b, done_b)
    w.f.active_bb = body_b
    $va := []int{}
    va.push(w.load_local(ms, 0))
    va.push(w.load_local(ix, 0))
    w.drop_value(tp, w.call_core("map_val_at", &va), vty)
    $na := []int{}
    na.push(w.load_local(ms, 0))
    na.push(w.bin(BIN_ADD, w.load_local(ix, 0), w.konst(1)))
    w.store_local(ix, 0, w.call_core("map_next", &na))
    w.jump(cond_b)
    w.f.active_bb = done_b
}

// dst = deep copy of the map whose handle is at src.
fn (w $&Lw) map_clone_into(tp &types.TypedProgram, dst int, src int, mt int) {
    kty := map_key_ty(tp, mt)
    vty := map_val_ty(tp, mt)
    $kstr := 0
    if kty == 3 {
        kstr = 1
    }
    sm := w.new_local(1, 1, "mcs")
    w.store_local(sm, 0, w.load_ptr(src, 0, 8))
    $nargs := []int{}
    nargs.push(w.konst(kstr))
    nargs.push(w.konst(tp.size_of(vty)))
    $largs := []int{}
    largs.push(w.load_local(sm, 0))
    nargs.push(w.call_core("map_len", &largs))
    dm := w.new_local(1, 1, "mcd")
    w.store_local(dm, 0, w.call_core("map_new", &nargs))
    ix := w.new_local(1, 1, "mci")
    $a0 := []int{}
    a0.push(w.load_local(sm, 0))
    a0.push(w.konst(0))
    w.store_local(ix, 0, w.call_core("map_next", &a0))
    cond_b := w.new_block()
    body_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    w.branch(w.bin(BIN_GE, w.load_local(ix, 0), w.konst(0)), body_b, done_b)
    w.f.active_bb = body_b
    $ka := []int{}
    ka.push(w.load_local(sm, 0))
    ka.push(w.load_local(ix, 0))
    kaddr := w.call_core("map_key_at", &ka)
    $pa := []int{}
    pa.push(w.load_local(dm, 0))
    pa.push(kaddr)
    dv := w.call_core("map_put", &pa)
    $va := []int{}
    va.push(w.load_local(sm, 0))
    va.push(w.load_local(ix, 0))
    sv := w.call_core("map_val_at", &va)
    if w.needs_drop(tp, vty) {
        w.clone_into(tp, dv, sv, vty)
    } else {
        w.copy_mem(dv, sv, tp.size_of(vty))
    }
    $na := []int{}
    na.push(w.load_local(sm, 0))
    na.push(w.bin(BIN_ADD, w.load_local(ix, 0), w.konst(1)))
    w.store_local(ix, 0, w.call_core("map_next", &na))
    w.jump(cond_b)
    w.f.active_bb = done_b
    w.store_ptr(dst, 0, w.load_local(dm, 0), 8)
}

// Map handle of expression n (loaded through a reference when needed).
fn (w $&Lw) map_handle(p &parser.Parser, tp &types.TypedProgram, n int) int {
    v := w.lower_expr(p, tp, n)
    if w.expr_is_ref(p, tp, n) {
        << w.load_ptr(v, 0, 8)
    }
    << v
}

// Address of the key value of expression n.
fn (w $&Lw) map_key_addr(p &parser.Parser, tp &types.TypedProgram, n int, kty int) int {
    if kty == 3 {
        << w.base_addr(p, tp, n)
    }
    $v := w.lower_expr(p, tp, n)
    if w.expr_is_ref(p, tp, n) {
        v = w.load_ptr(v, 0, 8)
    }
    a := w.scratch_words(1)
    w.store_ptr(a, 0, v, 8)
    << a
}

fn (w $&Lw) map_value_at(tp &types.TypedProgram, addr int, vty int) int {
    if is_wide(tp, vty) {
        << addr
    }
    << w.load_ptr(addr, 0, width_of(tp, vty))
}

fn (w $&Lw) map_key_call(p &parser.Parser, tp &types.TypedProgram, recv int, key int, name string) int {
    mt := tp.type_of(recv)
    kty := map_key_ty(tp, mt)
    m := w.map_handle(p, tp, recv)
    k := w.map_key_addr(p, tp, key, kty)
    $args := []int{}
    args.push(m)
    args.push(k)
    res := w.call_core(name, &args)
    if kty == 3 {
        w.drop_fresh_str(p, tp, key, k)
    }
    << res
}

// Address of the value stored under m[k] for index node n; a missing key
// ends the program.
fn (w $&Lw) map_elem_addr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    << w.map_key_call(p, tp, p.nodes[n].a, p.nodes[n].b, "map_val_ptr")
}

fn (w $&Lw) map_index(p &parser.Parser, tp &types.TypedProgram, n int) int {
    addr := w.map_elem_addr(p, tp, n)
    << w.map_value_at(tp, addr, map_val_ty(tp, tp.type_of(p.nodes[n].a)))
}

fn (w $&Lw) map_assign(p &parser.Parser, tp &types.TypedProgram, s int) {
    target := p.nodes[s].a
    vty := map_val_ty(tp, tp.type_of(p.nodes[target].a))
    $v := w.own_val(p, tp, p.nodes[s].b, w.lower_expr(p, tp, p.nodes[s].b), vty)
    if is_wide(tp, vty) {
        // `m[a] = m[b]` reads a value in the slot buffer; map_put may
        // rehash and release that buffer before the value is stored.
        held := w.scratch(tp, vty)
        w.copy_mem(held, v, tp.size_of(vty))
        v = held
    }
    recv := p.nodes[target].a
    key := p.nodes[target].b
    mt := tp.type_of(recv)
    kty := map_key_ty(tp, mt)
    m := w.map_handle(p, tp, recv)
    k := w.map_key_addr(p, tp, key, kty)
    existed := w.scratch_words(1)
    $pa := []int{}
    pa.push(m)
    pa.push(k)
    pa.push(existed)
    dst := w.call_core("map_put_has", &pa)
    if kty == 3 {
        w.drop_fresh_str(p, tp, key, k)
    }
    if w.needs_drop(tp, vty) {
        drop_b := w.new_block()
        store_b := w.new_block()
        w.branch(w.load_ptr(existed, 0, 8), drop_b, store_b)
        w.f.active_bb = drop_b
        w.drop_value(tp, dst, vty)
        w.jump(store_b)
        w.f.active_bb = store_b
    }
    w.store_value(tp, dst, 0, v, vty)
}

fn (w $&Lw) map_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if p.nodes[n].kind != ast.NK_MAP_INIT {
        << NOT_HANDLED
    }
    ty := tp.type_of(n)
    $kstr := 0
    if map_key_ty(tp, ty) == 3 {
        kstr = 1
    }
    $args := []int{}
    args.push(w.konst(kstr))
    args.push(w.konst(tp.size_of(map_val_ty(tp, ty))))
    if p.nodes[n].c >= 0 {
        args.push(w.lower_expr(p, tp, p.nodes[n].c))
    } else {
        args.push(w.konst(0))
    }
    << w.call_core("map_new", &args)
}

fn (w $&Lw) map_method_call(p &parser.Parser, tp &types.TypedProgram, n int, code int) int {
    if code < -88 || code > -84 {
        << NOT_HANDLED
    }
    recv := p.nodes[n].a
    arg := p.nodes[n].b
    vty := map_val_ty(tp, tp.type_of(recv))
    if code == -85 {
        $args := []int{}
        args.push(w.map_handle(p, tp, recv))
        << w.call_core("map_len", &args)
    }
    if code == -84 {
        << w.map_key_call(p, tp, recv, arg, "map_has")
    }
    if code == -86 {
        mt := tp.type_of(recv)
        kty := map_key_ty(tp, mt)
        m := w.map_handle(p, tp, recv)
        k := w.map_key_addr(p, tp, arg, kty)
        if w.needs_drop(tp, vty) {
            $fa := []int{}
            fa.push(m)
            fa.push(k)
            found := w.call_core("map_find_val", &fa)
            hit_b := w.new_block()
            next_b := w.new_block()
            w.branch(w.bin(BIN_NE, found, w.konst(0)), hit_b, next_b)
            w.f.active_bb = hit_b
            w.drop_value(tp, found, vty)
            w.jump(next_b)
            w.f.active_bb = next_b
        }
        $da := []int{}
        da.push(m)
        da.push(k)
        w.call_core("map_delete", &da)
        if kty == 3 {
            w.drop_fresh_str(p, tp, arg, k)
        }
        << w.konst(0)
    }
    if code == -88 {
        mt := tp.type_of(recv)
        kty := map_key_ty(tp, mt)
        m := w.map_handle(p, tp, recv)
        k := w.map_key_addr(p, tp, arg, kty)
        $dst := -1
        if is_wide(tp, vty) {
            dst = w.scratch(tp, vty)
        } else {
            dst = w.scratch_words(1)
        }
        $args := []int{}
        args.push(m)
        args.push(k)
        args.push(dst)
        w.call_core("map_take", &args)
        if kty == 3 {
            w.drop_fresh_str(p, tp, arg, k)
        }
        << w.map_value_at(tp, dst, vty)
    }
    // get_or
    found := w.map_key_call(p, tp, recv, arg, "map_find_val")
    fslot := w.new_local(1, 1, "mf")
    w.store_local(fslot, 0, found)
    wide := is_wide(tp, vty)
    $res := -1
    if wide {
        res = w.new_local(vty, tp.words_of(vty), "mg")
    } else {
        res = w.new_local(vty, 1, "mg")
    }
    hit_b := w.new_block()
    miss_b := w.new_block()
    done_b := w.new_block()
    w.branch(w.bin(BIN_NE, found, w.konst(0)), hit_b, miss_b)
    w.f.active_bb = hit_b
    // get_or returns a value of its own: the entry stays in the map.
    if w.needs_drop(tp, vty) {
        w.clone_into(tp, w.addr_local(res), w.load_local(fslot, 0), vty)
    } else if wide {
        w.copy_mem(w.addr_local(res), w.load_local(fslot, 0), tp.size_of(vty))
    } else {
        w.store_local(res, 0, w.load_ptr(w.load_local(fslot, 0), 0, width_of(tp, vty)))
    }
    w.jump(done_b)
    w.f.active_bb = miss_b
    dn := p.nodes[arg].next
    dv := w.own_val(p, tp, dn, w.lower_expr(p, tp, dn), vty)
    if wide {
        w.copy_mem(w.addr_local(res), dv, tp.size_of(vty))
    } else {
        w.store_local(res, 0, dv)
    }
    w.jump(done_b)
    w.f.active_bb = done_b
    if wide {
        << w.addr_local(res)
    }
    << w.load_local(res, 0)
}

fn (w $&Lw) map_for_each(p &parser.Parser, tp &types.TypedProgram, s int) {
    iter := p.nodes[s].a
    mt := tp.type_of(iter)
    kty := map_key_ty(tp, mt)
    vty := map_val_ty(tp, mt)
    mslot := w.new_local(1, 1, "mit")
    w.store_local(mslot, 0, w.map_handle(p, tp, iter))
    islot := w.new_local(1, 1, "mi")
    $a0 := []int{}
    a0.push(w.load_local(mslot, 0))
    a0.push(w.konst(0))
    w.store_local(islot, 0, w.call_core("map_next", &a0))
    cond_b := w.new_block()
    body_b := w.new_block()
    step_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    w.branch(w.bin(BIN_GE, w.load_local(islot, 0), w.konst(0)), body_b, done_b)
    w.f.active_bb = body_b
    $ka := []int{}
    ka.push(w.load_local(mslot, 0))
    ka.push(w.load_local(islot, 0))
    kaddr := w.call_core("map_key_at", &ka)
    w.store_to_local(tp, tp.local_of(s), w.map_value_at(tp, kaddr, kty))
    $va := []int{}
    va.push(w.load_local(mslot, 0))
    va.push(w.load_local(islot, 0))
    vaddr := w.call_core("map_val_at", &va)
    w.store_to_local(tp, tp.const_of(s), w.map_value_at(tp, vaddr, vty))
    w.loop_enter(done_b, step_b)
    w.lower_block(p, tp, p.nodes[s].c)
    w.jump(step_b)
    w.loop_depth -= 1
    w.f.active_bb = step_b
    $na := []int{}
    na.push(w.load_local(mslot, 0))
    na.push(w.bin(BIN_ADD, w.load_local(islot, 0), w.konst(1)))
    w.store_local(islot, 0, w.call_core("map_next", &na))
    w.jump(cond_b)
    w.f.active_bb = done_b
}

// for x in ch: receive until the channel is closed and drained.
fn (w $&Lw) chan_for_each(p &parser.Parser, tp &types.TypedProgram, s int) {
    id := tp.local_of(s)
    ety := w.local_type(tp, id)
    cslot := w.new_local(1, 1, "cit")
    w.store_local(cslot, 0, w.chan_operand(p, tp, p.nodes[s].a))
    buf := w.chan_elem_slot(tp, ety)
    bslot := w.new_local(1, 1, "cbuf")
    w.store_local(bslot, 0, buf)
    cond_b := w.new_block()
    body_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    $args := []int{}
    args.push(w.load_local(cslot, 0))
    args.push(w.load_local(bslot, 0))
    args.push(w.konst(chan_esize(tp, ety)))
    ok := w.call_core("chan_recv", &args)
    w.branch(ok, body_b, done_b)
    w.f.active_bb = body_b
    w.store_to_local(tp, id, w.chan_elem_value(tp, w.load_local(bslot, 0), ety))
    w.loop_enter(done_b, cond_b)
    // The received element belongs to the loop variable for one iteration.
    mark := w.scope_ids.len
    w.own_declare(tp, id)
    w.lower_block(p, tp, p.nodes[s].c)
    if w.scope_ids.len > mark {
        if w.open() {
            w.drop_owned_from(mark)
        }
        w.scope_truncate(mark)
    }
    w.jump(cond_b)
    w.loop_depth -= 1
    w.f.active_bb = done_b
}
