@xu/mir

#xu/ast
#xu/parser
#xu/types

const TENSOR_F32 = 14

fn tensor_assignment(p &parser.Parser, stmt int, assign int, op int) int {
    if stmt < 0 || p.nodes[stmt].kind != ast.NK_ASSIGN ||
       p.nodes[stmt].ival != assign || p.nodes[stmt].next >= 0 {
        << -1
    }
    rhs := p.nodes[stmt].b
    if p.nodes[rhs].kind != ast.NK_BIN_OP || p.nodes[rhs].ival != op {
        << -1
    }
    << stmt
}

// Match before scalar lowering erases the static extent and unit stride.
fn pointwise_assignment(p &parser.Parser, loop int, extent int, op int) int {
    if static_range_extent(p, loop) != extent { << -1 }
    << tensor_assignment(p, p.nodes[loop].c, ast.AS_ASSIGN, op)
}

fn pointwise_base(p &parser.Parser, tp &types.TypedProgram, index int, loop int) int {
    if p.nodes[index].kind != ast.NK_INDEX || tp.type_of(index) != TENSOR_F32 ||
       !range_uses_iv(p, tp, p.nodes[index].b, tp.local_of(loop)) {
        << -1
    }
    base := p.nodes[index].a
    if p.nodes[base].kind != ast.NK_IDENT { << -1 }
    << base
}

// A fresh binding can only be observed after these adjacent statements
// through a later reference to its name. Include nested statements and
// function literal bodies, where a capture has a different typed local ID.
// Shadowed uses conservatively keep the temporary. Bound recursion even
// when presented with a deeply nested or synthesized tree.
fn tensor_may_reference(p &parser.Parser, head int, name &string, depth int) bool {
    $n := head
    while n >= 0 {
        if n >= p.nodes.len || depth >= 64 { << true }
        node := &p.nodes[n]
        if node.kind == ast.NK_IDENT && node.sval == *name { << true }
        if node.kind == ast.NK_ARM_RANGE {
            // A range arm's d is a literal bound, not a child.
            if tensor_may_reference(p, node.c, name, depth + 1) { << true }
        } else if tensor_may_reference(p, node.a, name, depth + 1) ||
                  tensor_may_reference(p, node.b, name, depth + 1) ||
                  tensor_may_reference(p, node.c, name, depth + 1) ||
                  tensor_may_reference(p, node.d, name, depth + 1) ||
                  tensor_may_reference(p, node.e, name, depth + 1) {
            << true
        }
        n = node.next
    }
    << false
}

fn (w &Lw) pointwise_slot(p &parser.Parser, tp &types.TypedProgram, base int, extent int) int {
    if base < 0 || fixed_len_of(tp, tp.type_of(base)) != extent { << -1 }
    << w.fixed_array_slot(p, tp, base, extent, TENSOR_F32)
}

fn (w &Lw) tensor_temp_extent(p &parser.Parser, tp &types.TypedProgram, decl int) int {
    binding := &p.nodes[decl]
    if binding.kind != ast.NK_LET { << -1 }
    init := binding.a
    if p.nodes[init].kind != ast.NK_ARRAY_LIT || p.nodes[init].a >= 0 { << -1 }
    ty := tp.type_of(init)
    extent := fixed_len_of(tp, ty)
    if extent <= 0 || !types.is_array_type(ty) || tp.elem_of(ty) != TENSOR_F32 { << -1 }
    tmp := tp.local_of(decl)
    if tmp < 0 || w.local_type(tp, tmp) != ty { << -1 }
    << extent
}

fn (w $&Lw) lower_tensor_fusion(p &parser.Parser, tp &types.TypedProgram, decl int) int {
    if p.nodes[decl].kind == ast.NK_FOR {
        gemm_p4 := w.lower_tensor_gemm_p4(p, tp, decl)
        if gemm_p4 >= 0 { << gemm_p4 }
        gemm := w.lower_tensor_gemm(p, tp, decl)
        if gemm >= 0 { << gemm }
        gemv_p4 := w.lower_tensor_gemv_p4(p, tp, decl)
        if gemv_p4 >= 0 { << gemv_p4 }
        gemv := w.lower_tensor_gemv(p, tp, decl)
        if gemv >= 0 { << gemv }
        dot := w.lower_tensor_dot(p, tp, decl)
        if dot >= 0 { << dot }
        q4 := w.lower_tensor_dot_q4_0(p, tp, decl)
        if q4 >= 0 { << q4 }
        q4q8 := w.lower_tensor_dot_q4_0_q8_0(p, tp, decl)
        if q4q8 >= 0 { << q4q8 }
        q8 := w.lower_tensor_quantize_q8_0(p, tp, decl)
        if q8 >= 0 { << q8 }
        swiglu := w.lower_tensor_swiglu(p, tp, decl)
        if swiglu >= 0 { << swiglu }
        sqsum_off := w.lower_tensor_sqsum_offset(p, tp, decl)
        if sqsum_off >= 0 { << sqsum_off }
        norm_off := w.lower_tensor_norm_offset(p, tp, decl)
        if norm_off >= 0 { << norm_off }
        vscale := w.lower_tensor_vscale(p, tp, decl)
        if vscale >= 0 { << vscale }
        rope := w.lower_tensor_rope(p, tp, decl)
        if rope >= 0 { << rope }
        copy_blk := w.lower_tensor_copy16_32(p, tp, decl)
        if copy_blk >= 0 { << copy_blk }
        << w.lower_tensor_axpy_or_vadd(p, tp, decl)
    }
    argmax_hit := w.lower_tensor_argmax(p, tp, decl)
    if argmax_hit >= 0 { << argmax_hit }
    extent := w.tensor_temp_extent(p, tp, decl)
    if extent <= 0 { << -1 }
    first := p.nodes[decl].next
    mul := pointwise_assignment(p, first, extent, ast.OP_MUL)
    if mul >= 0 { << w.lower_tensor_mul_add(p, tp, decl, extent, first, mul) }
    add := pointwise_assignment(p, first, extent, ast.OP_ADD)
    if add >= 0 { << w.lower_tensor_add_square_sum(p, tp, decl, extent, first, add) }
    dynamic_mul := w.lower_tensor_dynamic_mul_add(p, tp, decl, extent)
    if dynamic_mul >= 0 { << dynamic_mul }
    << w.lower_tensor_dynamic_add_square_sum(p, tp, decl, extent)
}

fn (w $&Lw) lower_tensor_mul_add(p &parser.Parser, tp &types.TypedProgram, decl int, extent int, mul_loop int, mul int) int {
    binding := &p.nodes[decl]
    tmp := tp.local_of(decl)
    add_loop := p.nodes[mul_loop].next
    add := pointwise_assignment(p, add_loop, extent, ast.OP_ADD)
    if add < 0 { << -1 }
    prod_id := p.nodes[mul].b
    sum_id := p.nodes[add].b
    prod := &p.nodes[prod_id]
    sum := &p.nodes[sum_id]
    tmp_write := pointwise_base(p, tp, p.nodes[mul].a, mul_loop)
    tmp_read := pointwise_base(p, tp, sum.a, add_loop)
    if tp.local_of(tmp_write) != tmp || tp.local_of(tmp_read) != tmp {
        << -1
    }

    x := w.pointwise_slot(p, tp, pointwise_base(p, tp, prod.a, mul_loop), extent)
    scale := w.pointwise_slot(p, tp, pointwise_base(p, tp, prod.b, mul_loop), extent)
    bias := w.pointwise_slot(p, tp, pointwise_base(p, tp, sum.b, add_loop), extent)
    out := w.pointwise_slot(p, tp, pointwise_base(p, tp, p.nodes[add].a, add_loop), extent)
    if x < 0 || scale < 0 || bias < 0 || out < 0 || out == x || out == scale || out == bias {
        << -1
    }
    if tensor_may_reference(p, p.nodes[add_loop].next, &binding.sval, 0) { << -1 }

    // All indices are in bounds and the destination is a separate frame
    // object. Emit a single scalar loop without allocating the producer.
    w.cur_line = p.nodes[mul_loop].line
    x_addr := w.addr_local(x)
    scale_addr := w.addr_local(scale)
    bias_addr := w.addr_local(bias)
    out_addr := w.addr_local(out)
    w.emit_tensor_mul_add_loop(tp, w.konst(extent), x_addr, scale_addr, bias_addr, out_addr,
                               p.nodes[add_loop].line, "tensor_i")
    << add_loop
}

fn (w $&Lw) emit_tensor_mul_add_loop(tp &types.TypedProgram, extent int, x_addr int, scale_addr int, bias_addr int, out_addr int, add_line int, iv_name string) {
    if w.tgt_arch == 0 || w.tgt_arch == 1 {
        w.cur_line = add_line
        $stub := "__xu_tensor_mul_add_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_mul_add_fma_f32" }
        $args := []int{}
        args.push(out_addr)
        args.push(x_addr)
        args.push(scale_addr)
        args.push(bias_addr)
        args.push(extent)
        w.call(stub, &args)
        <<
    }
    iv := w.new_local(1, 1, iv_name)
    loop := w.begin_lowered_range(iv, w.konst(0), extent, 1)
    width := tp.size_of(TENSOR_F32)
    offset := w.bin(BIN_MUL, w.load_local(iv, 0), w.konst(width))
    a := w.load_ptr(w.bin(BIN_ADD, x_addr, offset), 0, width)
    b := w.load_ptr(w.bin(BIN_ADD, scale_addr, offset), 0, width)
    // checked_bin narrows each operation to f32, including the multiply.
    product := w.checked_bin(BIN_FMUL, a, b, TENSOR_F32)
    w.cur_line = add_line
    c := w.load_ptr(w.bin(BIN_ADD, bias_addr, offset), 0, width)
    value := w.checked_bin(BIN_FADD, product, c, TENSOR_F32)
    w.store_ptr(w.bin(BIN_ADD, out_addr, offset), 0, value, width)
    w.end_lowered_range(&loop)
}

fn (w $&Lw) lower_tensor_dynamic_mul_add(p &parser.Parser, tp &types.TypedProgram, decl int, capacity int) int {
    plan := w.tensor_dynamic_mul_add_plan(p, tp, decl)
    if plan.mul_loop < 0 { << -1 }

    w.cur_line = p.nodes[plan.mul_loop].line
    n := w.lower_expr(p, tp, plan.bound)
    check := w.new_block()
    done := w.new_block()
    w.branch(w.bin(BIN_GT, n, w.konst(0)), check, done)

    w.f.active_bb = check
    inputs := w.tensor_dynamic_inputs(p, tp, &plan, n, capacity)
    fast := w.new_block()
    slow := w.new_block()
    w.branch(inputs.valid, fast, slow)

    w.f.active_bb = fast
    w.emit_tensor_mul_add_loop(tp, n, inputs.x, inputs.scale, inputs.bias, inputs.out,
                               p.nodes[plan.add_loop].line, "tensor_dynamic_i")
    w.jump(done)

    // Keep the source loops in the cold path. In particular, a short bias or
    // output must fail after the same prefix of writes as the source program.
    w.f.active_bb = slow
    w.lower_stmt(p, tp, decl)
    w.lower_stmt(p, tp, plan.mul_loop)
    w.lower_stmt(p, tp, plan.add_loop)
    w.jump(done)
    w.f.active_bb = done
    << plan.add_loop
}

// A scalar literal initializer may sit between the residual and reduction
// loops. It cannot read the residual, change an input, or fail.
fn reduction_seed(p &parser.Parser, tp &types.TypedProgram, stmt int) bool {
    if stmt < 0 || p.nodes[stmt].kind != ast.NK_LET { << false }
    value := p.nodes[stmt].a
    if tp.type_of(value) != TENSOR_F32 { << false }
    if p.nodes[value].kind == ast.NK_FLOAT { << true }
    if p.nodes[value].kind == ast.NK_CAST && p.nodes[value].ival == TENSOR_F32 {
        arg := p.nodes[value].a
        << p.nodes[arg].kind == ast.NK_INT || p.nodes[arg].kind == ast.NK_FLOAT
    }
    << false
}

// Match either sum += r[j] * r[j] or a scalar read followed by sum += v * v.
fn tensor_square_sum(p &parser.Parser, tp &types.TypedProgram, loop int, residual int) int {
    $stmt := p.nodes[loop].c
    if stmt < 0 { << -1 }
    $value := -1
    if p.nodes[stmt].kind == ast.NK_LET {
        base := pointwise_base(p, tp, p.nodes[stmt].a, loop)
        if tp.local_of(base) != residual { << -1 }
        value = tp.local_of(stmt)
        if value < 0 { << -1 }
        stmt = p.nodes[stmt].next
    }
    reduce := tensor_assignment(p, stmt, ast.AS_ADD, ast.OP_MUL)
    if reduce < 0 { << -1 }
    square := p.nodes[reduce].b
    a := p.nodes[square].a
    b := p.nodes[square].b
    if value >= 0 {
        if !range_uses_iv(p, tp, a, value) || !range_uses_iv(p, tp, b, value) { << -1 }
    } else {
        if tp.local_of(pointwise_base(p, tp, a, loop)) != residual ||
           tp.local_of(pointwise_base(p, tp, b, loop)) != residual {
            << -1
        }
    }
    if tp.type_of(square) != TENSOR_F32 { << -1 }
    << reduce
}

// Fuse the residual Add with a serial sum of squares, as used by RMSNorm.
// The reduction gets the same rounded f32 residual at each index, in order.
// An eligible normalization can use its fresh output to hold the residual.
// Otherwise keep a separate frame object only while the residual has uses.
fn (w $&Lw) lower_tensor_add_square_sum(p &parser.Parser, tp &types.TypedProgram, decl int, extent int, add_loop int, add int) int {
    residual := tp.local_of(decl)
    dest := pointwise_base(p, tp, p.nodes[add].a, add_loop)
    if tp.local_of(dest) != residual { << -1 }

    sum_expr := p.nodes[add].b
    left := w.pointwise_slot(p, tp, pointwise_base(p, tp, p.nodes[sum_expr].a, add_loop), extent)
    right := w.pointwise_slot(p, tp, pointwise_base(p, tp, p.nodes[sum_expr].b, add_loop), extent)
    if left < 0 || right < 0 { << -1 }

    after_add := p.nodes[add_loop].next
    seed := reduction_seed(p, tp, after_add)
    $reduce_loop := after_add
    if seed { reduce_loop = p.nodes[after_add].next }
    if static_range_extent(p, reduce_loop) != extent { << -1 }
    reduce := tensor_square_sum(p, tp, reduce_loop, residual)
    if reduce < 0 { << -1 }
    target := p.nodes[reduce].a
    accumulator := tp.local_of(target)
    if p.nodes[target].kind != ast.NK_IDENT || accumulator < 0 ||
       w.local_type(tp, accumulator) != TENSOR_F32 {
        << -1
    }
    if seed {
        if tp.local_of(after_add) != accumulator { << -1 }
    } else {
        if accumulator >= w.lslot.len { << -1 }
        slot := w.lslot[accumulator]
        if slot < 0 || w.byref(slot) { << -1 }
    }

    normalize := w.tensor_normalize_plan(p, tp, reduce_loop, decl, extent)
    binding := &p.nodes[decl]
    $buffer_decl := -1
    if normalize.loop >= 0 {
        buffer_decl = normalize.output_decl
    } else if tensor_may_reference(p, p.nodes[reduce_loop].next, &binding.sval, 0) {
        buffer_decl = decl
    }
    $buffer_addr := -1
    if buffer_decl >= 0 {
        // The reduction writes the whole array before any later consumer.
        slot := w.declare_local(tp, tp.local_of(buffer_decl), 0)
        w.cur_line = p.nodes[buffer_decl].line
        buffer_addr = w.addr_local(slot)
    }
    if seed { w.lower_stmt(p, tp, after_add) }
    accum_slot := w.lslot[accumulator]

    w.cur_line = p.nodes[add_loop].line
    left_addr := w.addr_local(left)
    right_addr := w.addr_local(right)
    w.emit_tensor_square_sum_loop(tp, w.konst(extent), left_addr, right_addr, buffer_addr, accum_slot,
                                  p.nodes[reduce_loop].line, "tensor_reduce_i")
    if normalize.loop >= 0 {
        w.lower_tensor_normalize(p, tp, &normalize, buffer_addr, extent)
        << normalize.loop
    }
    << reduce_loop
}

fn (w $&Lw) emit_tensor_square_sum_loop(tp &types.TypedProgram, extent int, left_addr int, right_addr int, buffer_addr int, accum_slot int, reduce_line int, iv_name string) {
    if w.tgt_arch == 0 || w.tgt_arch == 1 {
        w.cur_line = reduce_line
        $stub := "__xu_tensor_add_sqsum_f32"
        if w.tensor_fast_math { stub = "__xu_tensor_add_sqsum_fast_f32" }
        $dst := buffer_addr
        if dst < 0 { dst = w.konst(0) }
        $args := []int{}
        args.push(dst)
        args.push(left_addr)
        args.push(right_addr)
        args.push(extent)
        args.push(w.load_local(accum_slot, 0))
        sum := w.call(stub, &args)
        w.store_local(accum_slot, 0, sum)
        <<
    }
    iv := w.new_local(1, 1, iv_name)
    loop := w.begin_lowered_range(iv, w.konst(0), extent, 1)
    width := tp.size_of(TENSOR_F32)
    offset := w.bin(BIN_MUL, w.load_local(iv, 0), w.konst(width))
    x := w.load_ptr(w.bin(BIN_ADD, left_addr, offset), 0, width)
    skip := w.load_ptr(w.bin(BIN_ADD, right_addr, offset), 0, width)
    value := w.checked_bin(BIN_FADD, x, skip, TENSOR_F32)
    if buffer_addr >= 0 {
        w.store_ptr(w.bin(BIN_ADD, buffer_addr, offset), 0, value, width)
    }
    w.cur_line = reduce_line
    squared := w.checked_bin(BIN_FMUL, value, value, TENSOR_F32)
    sum := w.checked_bin(BIN_FADD, w.load_local(accum_slot, 0), squared, TENSOR_F32)
    w.store_local(accum_slot, 0, sum)
    w.end_lowered_range(&loop)
}

fn (w &Lw) has_core(name string) bool {
    for i in 0:w.core_names.len {
        if w.core_names[i] == name { << true }
    }
    << false
}

fn (w $&Lw) zero_tensor_bytes(addr int, bytes int) {
    $args := []int{}
    args.push(addr)
    args.push(bytes)
    w.call_core("mem_zero", &args)
}

// A live residual must read as zero outside the written prefix, including
// when the source loops have no iterations.
fn (w $&Lw) zero_tensor_tail(addr int, start int, capacity int, width int, done int) {
    if w.has_core("mem_zero") {
        rem := w.bin(BIN_SUB, w.konst(capacity), start)
        zero_b := w.new_block()
        w.branch(w.bin(BIN_GT, rem, w.konst(0)), zero_b, done)
        w.f.active_bb = zero_b
        offset := w.bin(BIN_MUL, start, w.konst(width))
        bytes := w.bin(BIN_MUL, rem, w.konst(width))
        w.zero_tensor_bytes(w.bin(BIN_ADD, addr, offset), bytes)
        w.jump(done)
        <<
    }
    iv := w.new_local(1, 1, "tensor_tail_i")
    loop := w.begin_lowered_range(iv, start, w.konst(capacity), 1)
    offset := w.bin(BIN_MUL, w.load_local(iv, 0), w.konst(width))
    w.store_ptr(w.bin(BIN_ADD, addr, offset), 0, w.konst(0), width)
    w.end_lowered_range(&loop)
    w.jump(done)
}

fn (w $&Lw) lower_tensor_dynamic_add_square_sum(p &parser.Parser, tp &types.TypedProgram, decl int, capacity int) int {
    plan := w.tensor_dynamic_reduction_plan(p, tp, decl)
    if plan.add_loop < 0 { << -1 }

    done := w.new_block()
    if plan.norm_loop >= 0 {
        scale_slot := w.declare_local(tp, tp.local_of(plan.scale_decl), 0)
        w.cur_line = p.nodes[plan.add_loop].line
        n := w.lower_expr(p, tp, plan.bound)
        nonempty := w.bin(BIN_GT, n, w.konst(0))
        empty := w.new_block()
        check := w.new_block()
        w.branch(nonempty, check, empty)

        w.f.active_bb = empty
        w.cur_line = p.nodes[plan.scale_decl].line
        empty_scale := w.lower_expr(p, tp, p.nodes[plan.scale_decl].a)
        w.store_local(scale_slot, 0, empty_scale)
        w.jump(done)

        w.f.active_bb = check
        inputs := w.tensor_dynamic_reduction_inputs(p, tp, &plan, n, capacity)
        fast := w.new_block()
        slow := w.new_block()
        w.branch(inputs.valid, fast, slow)

        w.f.active_bb = fast
        w.emit_tensor_square_sum_loop(tp, n, inputs.x, inputs.skip, inputs.out, plan.accum_slot,
                                      p.nodes[plan.reduce_loop].line, "tensor_dynamic_reduce_i")
        w.cur_line = p.nodes[plan.scale_decl].line
        fast_scale := w.lower_expr(p, tp, p.nodes[plan.scale_decl].a)
        w.store_local(scale_slot, 0, fast_scale)
        w.emit_tensor_normalize_loop(tp, n, inputs.out, inputs.out, inputs.weight, fast_scale,
                                     p.nodes[plan.norm_loop].line, "tensor_dynamic_normalize_i")
        w.jump(done)

        w.f.active_bb = slow
        w.lower_stmt(p, tp, decl)
        w.lower_stmt(p, tp, plan.add_loop)
        w.lower_stmt(p, tp, plan.reduce_loop)
        w.cur_line = p.nodes[plan.scale_decl].line
        slow_scale := w.lower_expr(p, tp, p.nodes[plan.scale_decl].a)
        w.store_local(scale_slot, 0, slow_scale)
        w.lower_stmt(p, tp, plan.norm_loop)
        w.jump(done)

        w.f.active_bb = done
        << plan.norm_loop
    }

    $tail := done
    $buffer_addr := -1
    if plan.keep_residual {
        tail = w.new_block()
        slot := w.declare_local(tp, tp.local_of(decl), 0)
        w.cur_line = p.nodes[decl].line
        buffer_addr = w.addr_local(slot)
    }

    w.cur_line = p.nodes[plan.add_loop].line
    n := w.lower_expr(p, tp, plan.bound)
    nonempty := w.bin(BIN_GT, n, w.konst(0))
    check := w.new_block()
    w.branch(nonempty, check, tail)

    w.f.active_bb = check
    inputs := w.tensor_dynamic_reduction_inputs(p, tp, &plan, n, capacity)
    fast := w.new_block()
    slow := w.new_block()
    w.branch(inputs.valid, fast, slow)

    w.f.active_bb = fast
    w.emit_tensor_square_sum_loop(tp, n, inputs.x, inputs.skip, buffer_addr, plan.accum_slot,
                                  p.nodes[plan.reduce_loop].line, "tensor_dynamic_reduce_i")
    w.jump(tail)

    w.f.active_bb = slow
    width := tp.size_of(TENSOR_F32)
    if plan.keep_residual {
        // The slot is already declared. Initialize it as the source
        // literal would, without assigning it a different scope ID.
        w.cur_line = p.nodes[decl].line
        if w.has_core("mem_zero") {
            w.zero_tensor_bytes(buffer_addr, w.konst(capacity * width))
        } else {
            w.zero_mem(buffer_addr, capacity * width)
        }
    } else {
        w.lower_stmt(p, tp, decl)
    }
    w.lower_stmt(p, tp, plan.add_loop)
    w.lower_stmt(p, tp, plan.reduce_loop)
    w.jump(done)

    if plan.keep_residual {
        w.f.active_bb = tail
        w.cur_line = p.nodes[decl].line
        start := w.new_temp()
        $choose := minstr_new(MI_SELECT)
        choose.a = start
        choose.b = nonempty
        choose.c = n
        choose.d = w.konst(0)
        w.emit(choose)
        w.zero_tensor_tail(buffer_addr, start, capacity, width, done)
    }
    w.f.active_bb = done
    << plan.reduce_loop
}
