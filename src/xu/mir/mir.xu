@xu/mir
// Medium-level Intermediate Representation (MIR) core data structures.
//
// Layer 3 module: defines SSA/linear 3-address instructions, basic blocks,
// and function representations completely independent of AST and Checker.

// MIR instruction kinds.
//
// Operands are temps (>= 0) or constants (<= -2, index -op-2 into consts).
// Every temp holds one 64-bit word. Values wider than a word (strings,
// arrays, structs) live in memory; expressions of those types yield the
// address of the value. Locals occupy locals_nslots words each.
//
// Typed lowering emits this core set:
//   MI_LOAD_LOCAL  a=dst  b=local  c=word offset
//   MI_STORE_LOCAL a=local b=value c=word offset
//   MI_ADDR        a=dst  b=local                  address of word 0
//   MI_LOAD_PTR    a=dst  b=base   c=byte offset d=width (1, 4, 8; -4 sign-extends)
//   MI_STORE_PTR   a=base b=value  c=byte offset d=width
//   MI_BIN         a=dst  b=BIN_*  c=lhs d=rhs
//   MI_UN          a=dst  b=UN_*   c=operand       int <-> f64 conversions
//   MI_COPY        a=dst  b=src
//   MI_CALL        a=dst  c=first MArg sval=label
//   MI_STR_CONST   a=dst  sval=bytes               address of static bytes
//   MI_LOAD_FN_ADDR a=dst sval=label               code address of a function
//   MI_CALL_IND    a=dst  b=code address c=first MArg
// Terminators: TKIND_JUMP ta=block; TKIND_BRANCH ta=cond tb=then tc=else;
// TKIND_RETURN ta=value.
pub const MI_NOP = 0
pub const MI_COPY = 1
pub const MI_LOAD_LOCAL = 2
pub const MI_STORE_LOCAL = 3
pub const MI_BIN = 4
pub const MI_UN = 5
pub const MI_STR_CONST = 6
pub const MI_CALL = 7
pub const MI_DROP = 8
pub const MI_STR_CLONE = 9
pub const MI_LOAD_FIELD = 10
pub const MI_STORE_FIELD = 11
pub const MI_ARRAY_LIT = 12
pub const MI_ARR_PUSH = 13
pub const MI_LOAD_INDEX = 14
pub const MI_RESULT_TEST = 15
pub const MI_ADDR = 16
pub const MI_LOAD_PTR = 17
pub const MI_STORE_PTR = 18
pub const MI_THROW_UNWRAP = 19
pub const MI_STORE_INDEX = 20
pub const MI_DROP_FIELD = 21
pub const MI_DROP_PTR_FIELD = 22
pub const MI_ELEM_ADDR = 23
pub const MI_DROP_BUF_FIELD = 24
pub const MI_STORE_BUF_PTR = 25
pub const MI_LOAD_BUF_PTR = 26
pub const MI_CHAN_NEW = 30
pub const MI_CHAN_SEND = 31
pub const MI_CHAN_RECV = 32
pub const MI_XU = 33
pub const MI_CHAN_CLOSE = 34
pub const MI_CHAN_TRY_SEND = 35
pub const MI_CHAN_TRY_RECV = 36
pub const MI_XU_PUMP = 37
pub const MI_LOAD_FN_ADDR = 38
pub const MI_MAKE_CLOSURE = 39
pub const MI_BOX_INTERFACE = 40
pub const MI_INTERFACE_IS = 41
pub const MI_INTERFACE_AS = 42
pub const MI_INTERFACE_METHOD = 43
pub const MI_BOX_TEMP = 44
pub const MI_THROW_UNWRAP_ERR = 45
pub const MI_ARR_PUSH4 = 46
pub const MI_INDEX_RMW = 47
pub const MI_FIELD_RMW = 48
pub const MI_SELECT = 55
pub const MI_MADD = 56
pub const MI_MSUB = 57
pub const MI_CRYPTO_CRC32 = 58
pub const MI_CRYPTO_AES = 59
pub const MI_CALL_IND = 60

// Block terminators (tkind)
pub const TKIND_OPEN = 0
pub const TKIND_JUMP = 1
pub const TKIND_BRANCH = 2
pub const TKIND_RETURN = 3

// Binary operation codes
pub const BIN_ADD = 1
pub const BIN_SUB = 2
pub const BIN_MUL = 3
pub const BIN_DIV = 4
pub const BIN_EQ = 5
pub const BIN_NE = 6
pub const BIN_LT = 7
pub const BIN_LE = 8
pub const BIN_GT = 9
pub const BIN_GE = 10
pub const BIN_AND = 11
pub const BIN_OR = 12
pub const BIN_MOD = 13
pub const BIN_STR_EQ = 14
pub const BIN_STR_NE = 15
pub const BIN_XOR = 16
pub const BIN_SHL = 17
pub const BIN_SHR = 18
pub const BIN_STR_ADD = 19
// f64 operands and results are IEEE-754 bit patterns held in ordinary words;
// comparisons yield 0/1 (unordered: only FNE is true).
pub const BIN_FADD = 40
pub const BIN_FSUB = 41
pub const BIN_FMUL = 42
pub const BIN_FDIV = 43
pub const BIN_FEQ = 44
pub const BIN_FNE = 45
pub const BIN_FLT = 46
pub const BIN_FLE = 47
pub const BIN_FGT = 48
pub const BIN_FGE = 49

// MI_UN a=dst b=UN_* c=operand
pub const UN_I2F = 1
pub const UN_F2I = 2

pub struct MInstr {
    pub kind int
    pub a int
    pub b int
    pub c int
    pub d int
    pub sval string
    pub next int
    pub line int
    pub col int
    pub file int
}

pub fn minstr_new(kind int) MInstr {
    << MInstr{
        kind: kind,
        a: -1,
        b: -1,
        c: -1,
        d: -1,
        sval: "",
        next: -1,
        line: 0,
        col: 0,
        file: 0
    }
}

pub struct MArg {
    pub v int
    pub next int
}

pub struct MBlock {
    pub head int
    pub tail int
    pub tkind int
    pub ta int
    pub tb int
    pub tc int
    pub line int
}

pub fn mblock_new() MBlock {
    << MBlock{
        head: -1,
        tail: -1,
        tkind: TKIND_OPEN,
        ta: -1,
        tb: -1,
        tc: -1,
        line: 0
    }
}

pub struct MFn {
    pub name string
    pub label string
    pub ret int
    pub ret_nslots int
    pub nparams int
    pub receiver bool
    pub is_extern bool
    pub is_pub bool
    pub local_names []string
    pub locals []int
    pub locals_nslots []int
    pub locals_owning []bool
    pub temps []int
    pub temps_nslots []int
    pub instrs []MInstr
    pub margs []MArg
    pub blocks []MBlock
    pub active_bb int
    pub consts []int
}

pub fn mfn_new(name string, label string) MFn {
    << MFn{
        name: ~name,
        label: ~label,
        ret: 0,
        ret_nslots: 1,
        nparams: 0,
        receiver: false,
        is_extern: false,
        is_pub: false,
        local_names: []string{},
        locals: []int{},
        locals_nslots: []int{},
        locals_owning: []bool{},
        temps: []int{},
        temps_nslots: []int{},
        instrs: []MInstr{},
        margs: []MArg{},
        blocks: []MBlock{},
        active_bb: 0,
        consts: []int{}
    }
}

pub struct Mir {
    pub fns []MFn
}

pub struct TargetModel {
    pub ptr_size int
    pub has_cond_select bool
    pub has_fast_mul bool
    pub has_fused_madd bool
    pub unroll_factor int
    pub vector_bits int
    pub has_crypto_aes bool
    pub has_crypto_sha2 bool
    pub has_crc32 bool
    pub has_lse bool
    pub has_bmi2 bool
    pub has_dsp bool
}

pub fn target_model_default() TargetModel {
    << TargetModel{
        ptr_size: 8,
        has_cond_select: true,
        has_fast_mul: true,
        has_fused_madd: true,
        unroll_factor: 1,
        vector_bits: 0,
        has_crypto_aes: false,
        has_crypto_sha2: false,
        has_crc32: false,
        has_lse: false,
        has_bmi2: false,
        has_dsp: false
    }
}

pub fn mir_new() Mir {
    << Mir{ fns: []MFn{} }
}

pub fn (m $&Mir) add_fn(f MFn) int {
    idx := m.fns.len
    m.fns.push(f)
    << idx
}

pub fn alloc_const(mfn $&MFn, val int) int {
    for i in 0:mfn.consts.len {
        if mfn.consts[i] == val {
            << 0 - i - 2
        }
    }
    cidx := mfn.consts.len
    mfn.consts.push(val)
    << 0 - cidx - 2
}

pub fn alloc_temp(mfn $&MFn) int {
    tid := mfn.temps.len
    mfn.temps.push(1)
    mfn.temps_nslots.push(1)
    << tid
}

pub fn emit_instr(mfn $&MFn, ins MInstr) int {
    idx := mfn.instrs.len
    mfn.instrs.push(ins)

    cur_bi := mfn.active_bb
    if cur_bi >= 0 && cur_bi < mfn.blocks.len {
        if mfn.blocks[cur_bi].head < 0 {
            mfn.blocks[cur_bi].head = idx
            mfn.blocks[cur_bi].tail = idx
        } else {
            tail_idx := mfn.blocks[cur_bi].tail
            if tail_idx >= 0 && tail_idx < mfn.instrs.len {
                mfn.instrs[tail_idx].next = idx
            }
            mfn.blocks[cur_bi].tail = idx
        }
    }
    << idx
}

pub fn emit_to_bb(mfn $&MFn, bi int, ins MInstr) int {
    idx := mfn.instrs.len
    mfn.instrs.push(ins)
    if bi >= 0 && bi < mfn.blocks.len {
        if mfn.blocks[bi].head < 0 {
            mfn.blocks[bi].head = idx
            mfn.blocks[bi].tail = idx
        } else {
            last_idx := mfn.blocks[bi].tail
            if last_idx >= 0 && last_idx < mfn.instrs.len {
                mfn.instrs[last_idx].next = idx
            }
            mfn.blocks[bi].tail = idx
        }
    }
    << idx
}
