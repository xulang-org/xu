@xu/mir
// Typed AST to MIR lowering.
//
// Layer 3 module: lowers checked functions to MIR using the checker's typed
// view (node types, local ids, call targets, struct layouts). See mir.xu for
// the value model: scalars are one word, wider values are addressed.
//
// Calling convention (MIR level, every backend implements it the same way):
//   incoming words = [sret ptr if the result is wide] [receiver ptr] params
//   a wide parameter arrives as the address of the caller's value and is
//   copied into the callee's frame on entry; a wide result is written
//   through the sret pointer. Receivers are always passed by address.
//
// Constructs without a lowering are reported with their source position
// and fail the build; nothing is skipped silently.
//
// Errors and interfaces (shared by every lowering file):
//   - an interface value, errors.Error included, is one word: 0 or the
//     address of a heap box laid out as [type id word][concrete value]
//   - a function that may throw takes a hidden first word okp (where its
//     ok value is stored; 0 when the ok type is void) ahead of the
//     receiver and params, and returns the error word (0 = success)
//   - lowering any throwing call (user function or hosted builtin) yields
//     the ok value like a normal call and leaves the error word in the
//     temp w.last_err; the caller decides how to handle it
//
// Maps (lower_map): a map value is one word, the address of a runtime/core
// map record; m[k] reads, writes and borrows go through the address of the
// stored value, which the runtime returns for a key passed by address.
//
// Function values (lower_fnval): a fn-typed value is wide, two words
// [code address][env word]. A non-zero env word is passed to the code as an
// extra word after the sret/okp word (closure env, method receiver); a call
// through a value passes it only when non-zero. Throwing functions are
// reached through a shim that panics on an error.
//
// temp/any values are two words [type id][payload]; see lower_iface.
//
// Feature files (lower_err, lower_host, lower_float, lower_enum,
// lower_chan, lower_map, lower_fnval, lower_iface, lower_intrin) each expose <feature>_expr / _stmt / _call / _method_call
// hooks returning NOT_HANDLED (or false) for nodes they do not own.

#xu/ast
#xu/parser
#xu/types

struct Lw {
    f MFn
    fi int
    tgt_os int
    tgt_arch int
    task_poll bool
    poll_loops bool
    affine_tile bool
    tensor_fusion bool
    tensor_fast_math bool
    // Line of the statement being lowered; stamped on emitted instructions.
    cur_line int
    // checker local id -> MIR local; -1 until declared
    lslot []int
    // MIR local holds the address of the value instead of the value
    lbyref []bool
    brk []int
    cont []int
    loop_depth int
    ret_ty int
    sret int
    errors int
    core_names []string
    core_labels []string
    // error word of the most recent throwing call (-1 when none)
    last_err int
    // hidden okp incoming local of a throwing function (-1 otherwise)
    okp int
    // node being lowered as its unboxed value (see err_box)
    unboxed int
    // node being lowered as the source of its own checker-required clone
    noclone int
    // String locals that own their buffer (let bindings and by-value
    // params), by checker local id. Other string locals are views.
    lowned []bool
    // The owned buffer was moved out on the current path.
    lmoved []bool
    // Owned locals in declaration order, innermost scope last; dropped in
    // reverse at scope exit, return, break and continue.
    scope_ids []int
    // Start in scope_offs of each scope_ids entry's descriptor offsets.
    scope_ostart []int
    scope_offs []int
    // Empty label frees a descriptor; otherwise invoke typed resource glue.
    scope_drop_labels []string
    // needs_drop memo by struct index: 0 unknown, 1 yes, 2 no.
    sdrop []int
    // scope_ids length at the entry of each enclosing loop body.
    loop_scope []int
    // Lowering a branch condition or match subject: the checker forgives a
    // string move there when the branch returns, though the local lives on.
    in_cond int
    // Run-time drop flag slot of a local (-1: its moved state is tracked
    // statically in lmoved). See dyn_ids.
    ldrop_flag []int
    // Locals whose moved state differs between the paths that reach a join
    // (moved or re-assigned inside a loop or a conditional arm). A flag
    // word records at run time whether such a local still owns its value.
    // dyn_ids is fixed for one lowering pass; dyn_found collects the locals
    // this pass discovers, and lower_fn repeats the pass when it grew.
    dyn_ids []int
    dyn_found []int
    block_depth int
    // Set while lowering the body of a clone glue function, so its own
    // type is cloned inline once instead of calling itself.
    in_clone_glue bool
    lscope []int
    slot_scope []int
    temp_scope []int
    next_scope_id int
}

// Hook result for "this feature does not lower the node".
const NOT_HANDLED = -1

fn lw_new(name string, label string, fi int, tgt_os int, tgt_arch int) Lw {
    << Lw{
        f: mfn_new(name, label),
        fi: fi,
        tgt_os: tgt_os,
        tgt_arch: tgt_arch,
        task_poll: false,
        poll_loops: false,
        affine_tile: false,
        tensor_fusion: false,
        tensor_fast_math: false,
        cur_line: 0,
        lslot: []int{},
        lbyref: []bool{},
        brk: []int{},
        cont: []int{},
        loop_depth: 0,
        ret_ty: 0,
        sret: -1,
        errors: 0,
        core_names: []string{},
        core_labels: []string{},
        last_err: -1,
        okp: -1,
        unboxed: -1,
        noclone: -1,
        lowned: []bool{},
        lmoved: []bool{},
        scope_ids: []int{},
        scope_ostart: []int{},
        scope_offs: []int{},
        scope_drop_labels: []string{},
        sdrop: []int{},
        loop_scope: []int{},
        in_cond: 0,
        ldrop_flag: []int{},
        dyn_ids: []int{},
        dyn_found: []int{},
        block_depth: 0,
        in_clone_glue: false,
        lscope: []int{},
        slot_scope: []int{},
        temp_scope: []int{},
        next_scope_id: 1
    }
}

// ===== emission helpers =====

fn (w $&Lw) emit(ins MInstr) {
    idx := w.f.instrs.len
    w.f.instrs.push(ins)
    if w.f.instrs[idx].line == 0 {
        w.f.instrs[idx].line = w.cur_line
    }
    bi := w.f.active_bb
    if w.f.blocks[bi].head < 0 {
        w.f.blocks[bi].head = idx
    } else {
        tail := w.f.blocks[bi].tail
        w.f.instrs[tail].next = idx
    }
    w.f.blocks[bi].tail = idx
}

fn (w $&Lw) new_block() int {
    id := w.f.blocks.len
    w.f.blocks.push(mblock_new())
    << id
}

fn (w &Lw) open() bool {
    << w.f.blocks[w.f.active_bb].tkind == TKIND_OPEN
}

fn (w $&Lw) jump(target int) {
    if w.open() {
        w.f.blocks[w.f.active_bb].tkind = TKIND_JUMP
        w.f.blocks[w.f.active_bb].ta = target
    }
}

fn (w $&Lw) branch(cond int, then_b int, else_b int) {
    if w.open() {
        w.f.blocks[w.f.active_bb].tkind = TKIND_BRANCH
        w.f.blocks[w.f.active_bb].ta = cond
        w.f.blocks[w.f.active_bb].tb = then_b
        w.f.blocks[w.f.active_bb].tc = else_b
    }
}

fn (w $&Lw) ret(v int) {
    if w.open() {
        if w.f.label == "_xu_main" && w.tgt_os != 3 {
            $none := []int{}
            w.call_core("task_drain", &none)
        }
        w.drop_owned_from(0)
        w.f.blocks[w.f.active_bb].tkind = TKIND_RETURN
        w.f.blocks[w.f.active_bb].ta = v
    }
}

// Statements after a terminator land in a fresh unreachable block.
fn (w $&Lw) ensure_open() {
    if !w.open() {
        w.f.active_bb = w.new_block()
    }
}

fn (w $&Lw) new_temp() int {
    id := w.f.temps.len
    w.f.temps.push(1)
    w.f.temps_nslots.push(1)
    << id
}

fn (w $&Lw) konst(v int) int {
    for i in 0:w.f.consts.len {
        if w.f.consts[i] == v {
            << 0 - i - 2
        }
    }
    idx := w.f.consts.len
    w.f.consts.push(v)
    << 0 - idx - 2
}

fn (w $&Lw) new_local(ty int, words int, name string) int {
    id := w.f.locals.len
    w.f.locals.push(ty)
    $n := words
    if n < 1 {
        n = 1
    }
    w.f.locals_nslots.push(n)
    w.f.locals_owning.push(false)
    // Compiler-made locals start with "."; source locals are renamed by
    // ensure_local and the parameter setup (debug info shows only those).
    w.f.local_names.push("." + name)
    << id
}

fn (w $&Lw) set_lscope(id int, sid int) {
    while w.lscope.len <= id {
        w.lscope.push(0)
    }
    w.lscope[id] = sid
    if id < w.lslot.len && w.lslot[id] >= 0 {
        w.set_slot_scope(w.lslot[id], sid)
    }
}

fn (w $&Lw) set_slot_scope(slot int, sid int) {
    while w.slot_scope.len <= slot {
        w.slot_scope.push(0)
    }
    w.slot_scope[slot] = sid
}

fn (w $&Lw) set_temp_scope(t int, sid int) {
    while w.temp_scope.len <= t {
        w.temp_scope.push(0)
    }
    w.temp_scope[t] = sid
}

fn (w $&Lw) bin(op int, a int, b int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_BIN)
    ins.a = t
    ins.b = op
    ins.c = a
    ins.d = b
    w.emit(ins)
    if op == BIN_ADD {
        if a >= 0 && a < w.temp_scope.len && w.temp_scope[a] > 0 {
            w.set_temp_scope(t, w.temp_scope[a])
        } else if b >= 0 && b < w.temp_scope.len && w.temp_scope[b] > 0 {
            w.set_temp_scope(t, w.temp_scope[b])
        }
    }
    << t
}

fn (w $&Lw) load_local(slot int, word int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_LOAD_LOCAL)
    ins.a = t
    ins.b = slot
    ins.c = word
    w.emit(ins)
    if slot >= 0 && slot < w.slot_scope.len && w.slot_scope[slot] > 0 {
        w.set_temp_scope(t, w.slot_scope[slot])
    }
    << t
}

fn (w $&Lw) store_local(slot int, word int, v int) {
    $ins := minstr_new(MI_STORE_LOCAL)
    ins.a = slot
    ins.b = v
    ins.c = word
    w.emit(ins)
}

fn (w $&Lw) addr_local(slot int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_ADDR)
    ins.a = t
    ins.b = slot
    w.emit(ins)
    if slot >= 0 && slot < w.slot_scope.len && w.slot_scope[slot] > 0 {
        w.set_temp_scope(t, w.slot_scope[slot])
    }
    << t
}

// Width codes beyond the MIR's 1/2/4/8/-4: -1 and -2 sign-extend a byte
// or halfword (i8, i16).

fn (w $&Lw) load_ptr(base int, off int, width int) int {
    if width == -1 || width == -2 {
        raw := w.load_ptr(base, off, 0 - width)
        sh := w.konst(64 - 8 * (0 - width))
        << w.bin(BIN_SHR, w.bin(BIN_SHL, raw, sh), sh)
    }
    t := w.new_temp()
    $ins := minstr_new(MI_LOAD_PTR)
    ins.a = t
    ins.b = base
    ins.c = off
    ins.d = width
    if base >= 0 && base < w.temp_scope.len && w.temp_scope[base] > 0 {
        ins.scope_id = w.temp_scope[base]
    }
    w.emit(ins)
    << t
}

fn (w $&Lw) store_ptr(base int, off int, v int, width int) {
    if width == -1 || width == -2 {
        w.store_ptr(base, off, v, 0 - width)
        <<
    }
    $ins := minstr_new(MI_STORE_PTR)
    ins.a = base
    ins.b = v
    ins.c = off
    ins.d = width
    if base >= 0 && base < w.temp_scope.len && w.temp_scope[base] > 0 {
        ins.scope_id = w.temp_scope[base]
    }
    w.emit(ins)
}

fn (w $&Lw) volatile_load(base int, off int, width int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_VOLATILE_LOAD)
    ins.a = t
    ins.b = base
    ins.c = off
    ins.d = width
    w.emit(ins)
    << t
}

fn (w $&Lw) volatile_store(base int, off int, v int, width int) {
    $ins := minstr_new(MI_VOLATILE_STORE)
    ins.a = base
    ins.b = v
    ins.c = off
    ins.d = width
    w.emit(ins)
}

fn (w $&Lw) call(label string, args &[]int) int {
    t := w.new_temp()
    $head := -1
    if args.len > 0 {
        head = w.f.margs.len
        for i in 0:args.len {
            $nx := -1
            if i + 1 < args.len {
                nx = w.f.margs.len + 1
            }
            w.f.margs.push(MArg{v: args[i], next: nx})
        }
    }
    $ins := minstr_new(MI_CALL)
    ins.a = t
    ins.c = head
    ins.sval = label + ""
    w.emit(ins)
    << t
}

fn (w &Lw) core(name string) string {
    for i in 0:w.core_names.len {
        if w.core_names[i] == name {
            << w.core_labels[i] + ""
        }
    }
    << "_runtime_core_missing_" + name
}

fn (w $&Lw) call_core(name string, args &[]int) int {
    << w.call(w.core(name), args)
}

fn (w $&Lw) fail(p &parser.Parser, n int, msg string) {
    $line := 0
    $col := 0
    if n >= 0 && n < p.nodes.len {
        line = p.nodes[n].line
        col = p.nodes[n].col
    }
    eprintln("error: " + str(line) + ":" + str(col) + ": " + msg + " (in " + w.f.name + ")")
    w.errors += 1
}

// ===== type helpers =====

// Memory access width in bytes; -4 is a sign-extending 4-byte access (i32).
fn width_of(tp &types.TypedProgram, ty int) int {
    dt := tp.deref(ty)
    if dt == 8 {
        << -4
    }
    if dt == 7 { << -1 }
    if dt == 11 { << -2 }
    if dt == 12 { << 2 }
    if dt == 14 { << 4 }
    sz := tp.size_of(ty)
    if sz == 1 || sz == 4 {
        << sz
    }
    << 8
}

fn is_wide(tp &types.TypedProgram, ty int) bool {
    << !tp.is_scalar(ty)
}

// Copy n bytes between two addresses (words first, then bytes).
fn (w $&Lw) copy_mem(dst int, src int, n int) {
    $off := 0
    while off + 8 <= n {
        v := w.load_ptr(src, off, 8)
        w.store_ptr(dst, off, v, 8)
        off += 8
    }
    while off < n {
        v := w.load_ptr(src, off, 1)
        w.store_ptr(dst, off, v, 1)
        off += 1
    }
}

fn (w $&Lw) zero_mem(dst int, n int) {
    $off := 0
    zero := w.konst(0)
    while off + 8 <= n {
        w.store_ptr(dst, off, zero, 8)
        off += 8
    }
    while off < n {
        w.store_ptr(dst, off, zero, 1)
        off += 1
    }
}

// Fresh frame memory for a wide value; returns its address.
fn (w $&Lw) scratch(tp &types.TypedProgram, ty int) int {
    sz := tp.size_of(ty)
    slot := w.new_local(ty, (sz + 7) / 8, "tmp")
    << w.addr_local(slot)
}

fn (w $&Lw) scratch_words(words int) int {
    slot := w.new_local(1, words, "tmp")
    << w.addr_local(slot)
}

// Store value v of type ty at address dst (copying wide values).
fn (w $&Lw) store_value(tp &types.TypedProgram, dst int, off int, v int, ty int) {
    if is_wide(tp, ty) {
        $d := dst
        if off != 0 {
            d = w.bin(BIN_ADD, dst, w.konst(off))
        }
        w.copy_mem(d, v, tp.size_of(ty))
    } else {
        w.store_ptr(dst, off, v, width_of(tp, ty))
    }
}

// ===== locals =====

fn (w &Lw) local_type(tp &types.TypedProgram, id int) int {
    if id >= 0 && id < tp.fns[w.fi].locals.len {
        << tp.fns[w.fi].locals[id]
    }
    << 1
}

fn (w $&Lw) ensure_local(tp &types.TypedProgram, id int) int {
    while w.lslot.len <= id {
        w.lslot.push(-1)
    }
    if w.lslot[id] >= 0 {
        << w.lslot[id]
    }
    ty := w.local_type(tp, id)
    $name := ".local"
    if id < tp.fns[w.fi].local_names.len {
        name = tp.fns[w.fi].local_names[id]
    }
    slot := w.new_local(ty, tp.words_of(ty), name + "")
    w.f.local_names[slot] = name + ""
    w.lslot[id] = slot
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    if id >= 0 && id < w.lscope.len && w.lscope[id] > 0 {
        w.set_slot_scope(slot, w.lscope[id])
    }
    << slot
}

fn (w &Lw) byref(slot int) bool {
    << slot >= 0 && slot < w.lbyref.len && w.lbyref[slot]
}

// Address of a local's value.
fn (w $&Lw) local_addr(slot int) int {
    if w.byref(slot) {
        << w.load_local(slot, 0)
    }
    << w.addr_local(slot)
}

// ===== expressions =====

fn bin_code(op int) int {
    if op == ast.OP_ADD { << BIN_ADD }
    if op == ast.OP_SUB { << BIN_SUB }
    if op == ast.OP_MUL { << BIN_MUL }
    if op == ast.OP_DIV { << BIN_DIV }
    if op == ast.OP_MOD { << BIN_MOD }
    if op == ast.OP_EQ { << BIN_EQ }
    if op == ast.OP_NE { << BIN_NE }
    if op == ast.OP_LT { << BIN_LT }
    if op == ast.OP_LE { << BIN_LE }
    if op == ast.OP_GT { << BIN_GT }
    if op == ast.OP_GE { << BIN_GE }
    if op == ast.OP_BIT_AND { << BIN_AND }
    if op == ast.OP_BIT_OR { << BIN_OR }
    if op == ast.OP_BIT_XOR { << BIN_XOR }
    if op == ast.OP_SHL { << BIN_SHL }
    if op == ast.OP_SHR { << BIN_SHR }
    << -1
}

fn assign_bin_code(aop int) int {
    if aop == ast.AS_ADD { << BIN_ADD }
    if aop == ast.AS_SUB { << BIN_SUB }
    if aop == ast.AS_MUL { << BIN_MUL }
    if aop == ast.AS_DIV { << BIN_DIV }
    if aop == ast.AS_MOD { << BIN_MOD }
    << -1
}

// The expression evaluates to a reference (pointer) value.
fn (w $&Lw) expr_is_ref(p &parser.Parser, tp &types.TypedProgram, n int) bool {
    k := p.nodes[n].kind
    if k == ast.NK_BORROW || tp.borrows_place(n) {
        << true
    }
    if k == ast.NK_IDENT {
        id := tp.local_of(n)
        if id >= 0 {
            << types.is_ref_type(w.local_type(tp, id))
        }
    }
    // The checker types an implicitly borrowed field or element argument as
    // the reference parameter type; the place itself holds the declared type.
    if k == ast.NK_FIELD || k == ast.NK_INDEX {
        bty := tp.deref(tp.deref(w.place_type(p, tp, p.nodes[n].a)))
        if k == ast.NK_FIELD && types.is_struct_type(bty) {
            fname := p.nodes[n].sval + ""
            fld := tp.field_of(bty, &fname)
            if fld.offset >= 0 {
                << types.is_ref_type(fld.ty)
            }
        }
        if k == ast.NK_INDEX && types.is_array_type(bty) {
            << types.is_ref_type(tp.elem_of(bty))
        }
        if k == ast.NK_INDEX && bty == 3 {
            << false
        }
    }
    << types.is_ref_type(tp.type_of(n))
}

// Address of the value designated by expression n (a place or a wide value).
fn (w $&Lw) lower_addr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if n != w.noclone && w.wants_clone(p, tp, n) {
        ty := tp.deref(tp.type_of(n))
        v := w.lower_expr(p, tp, n)
        if is_wide(tp, ty) {
            << v
        }
        a := w.scratch_words(1)
        w.store_ptr(a, 0, v, 8)
        << a
    }
    if tp.global_of(n) >= 0 {
        << w.lower_global_addr(tp, tp.global_of(n))
    }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT {
        id := tp.local_of(n)
        if id >= 0 {
            slot := w.ensure_local(tp, id)
            if types.is_ref_type(w.local_type(tp, id)) {
                << w.load_local(slot, 0)
            }
            << w.local_addr(slot)
        }
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_DEREF {
        << w.lower_expr(p, tp, p.nodes[n].a)
    }
    if (k == ast.NK_FIELD && tp.call_of(n) != -30 && tp.const_of(n) < 0 && !fnval_owns(p, tp, n)) || k == ast.NK_INDEX {
        if k == ast.NK_FIELD && p.nodes[n].sval == "len" && tp.call_of(n) != -96 {
            base := p.nodes[n].a
            bty := tp.deref(tp.deref(w.place_type(p, tp, base)))
            if bty == 3 || types.is_array_type(bty) {
                << w.bin(BIN_ADD, w.base_addr(p, tp, base), w.konst(8))
            }
        }
        << w.lower_place_addr(p, tp, n)
    }
    ty := tp.type_of(n)
    v := w.lower_expr(p, tp, n)
    if is_wide(tp, ty) || types.is_ref_type(ty) && w.expr_is_ref(p, tp, n) {
        << v
    }
    a := w.scratch_words(1)
    w.store_ptr(a, 0, v, 8)
    << a
}

// Address of the storage behind a wide or ref-typed operand.
fn (w $&Lw) base_addr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if w.expr_is_ref(p, tp, n) {
        << w.lower_expr(p, tp, n)
    }
    << w.lower_addr(p, tp, n)
}

// Address of a field or element place.
fn (w $&Lw) lower_place_addr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    base := p.nodes[n].a
    bty := tp.deref(tp.deref(w.place_type(p, tp, base)))
    if k == ast.NK_FIELD {
        if types.is_struct_type(bty) {
            // nlocal is not a field index on assignment targets; match by name.
            fname := p.nodes[n].sval + ""
            fld := tp.field_of(bty, &fname)
            if fld.offset < 0 {
                w.fail(p, n, "unresolved field '" + fname + "'")
                << w.konst(0)
            }
            ba := w.base_addr(p, tp, base)
            off := fld.offset
            if off == 0 {
                << ba
            }
            << w.bin(BIN_ADD, ba, w.konst(off))
        }
        w.fail(p, n, "field access on a non-struct value")
        << w.konst(0)
    }
    if tp.call_of(n) == -77 || tp.call_of(n) == -78 {
        << w.map_elem_addr(p, tp, n)
    }
    // Index: element address with bounds check.
    d := w.array_desc(p, tp, base, bty)
    idx := w.lower_expr(p, tp, p.nodes[n].b)
    n_len := w.load_ptr(d, 8, 8)
    w.bounds_check(idx, n_len)
    data := w.load_ptr(d, 0, 8)
    $esize := 1
    if bty != 3 {
        esize = tp.size_of(tp.elem_of(bty))
    }
    if esize == 1 {
        << w.bin(BIN_ADD, data, idx)
    }
    scaled := w.bin(BIN_MUL, idx, w.konst(esize))
    << w.bin(BIN_ADD, data, scaled)
}

fn (w $&Lw) bounds_check(idx int, n int) {
    neg := w.bin(BIN_LT, idx, w.konst(0))
    over := w.bin(BIN_GE, idx, n)
    // Preserve the descriptor-length check when the OR folds away.
    w.f.instrs[w.f.instrs.len - 1].sval = "bounds"
    bad := w.bin(BIN_OR, neg, over)
    // n is a length (never negative): backends may test idx >= n unsigned.
    w.f.instrs[w.f.instrs.len - 1].sval = "bounds"
    panic_b := w.new_block()
    ok_b := w.new_block()
    w.branch(bad, panic_b, ok_b)
    w.f.active_bb = panic_b
    $args := []int{}
    // runtime.index_panic ignores arguments and calls rt_panic(1); pass constants
    // so cold out-of-line panic blocks never extend idx/len live ranges across hot paths.
    args.push(w.konst(0))
    args.push(w.konst(0))
    w.call_core("index_panic", &args)
    w.jump(ok_b)
    w.f.active_bb = ok_b
}

// Descriptor address for array or string expression n of type ty. A
// fixed-size array is stored inline, so it gets a {data, N, N} view.
fn (w $&Lw) array_desc(p &parser.Parser, tp &types.TypedProgram, n int, ty int) int {
    base := w.base_addr(p, tp, n)
    fl := fixed_len_of(tp, ty)
    if fl == 0 {
        << base
    }
    d := w.scratch_words(3)
    w.store_ptr(d, 0, base, 8)
    w.store_ptr(d, 8, w.konst(fl), 8)
    w.store_ptr(d, 16, w.konst(fl), 8)
    << d
}

fn fixed_len_of(tp &types.TypedProgram, ty int) int {
    t := tp.deref(tp.deref(ty))
    if !types.is_array_type(t) {
        << 0
    }
    << tp.arrays[types.array_index(t)].fixed_len
}

// Calls core.rt_panic(kind) when cond is true (kinds are defined in core.xu).
fn (w $&Lw) panic_if(cond int, kind int) {
    panic_b := w.new_block()
    ok_b := w.new_block()
    w.branch(cond, panic_b, ok_b)
    w.f.active_bb = panic_b
    $args := []int{}
    args.push(w.konst(kind))
    w.call_core("rt_panic", &args)
    w.jump(ok_b)
    w.f.active_bb = ok_b
}

// Integer a <code> b; division and remainder fail loudly on a zero divisor
// and on int minimum / -1.
fn (w $&Lw) checked_bin(code int, a int, b int, ty int) int {
    if ty == 14 {
        r := w.bin(code, w.float_un(UN_F32_LOAD, a), w.float_un(UN_F32_LOAD, b))
        if code >= BIN_FADD && code <= BIN_FDIV { << w.float_un(UN_F32_STORE, r) }
        << r
    }
    if ty == 13 {
        u := w.u64_bin(code, a, b)
        if u != NOT_HANDLED { << u }
    }
    if code == BIN_DIV || code == BIN_MOD {
        w.panic_if(w.bin(BIN_EQ, b, w.konst(0)), 3)
        if ty == 1 {
            min := w.bin(BIN_SHL, w.konst(1), w.konst(63))
            lhs_min := w.bin(BIN_EQ, a, min)
            rhs_m1 := w.bin(BIN_EQ, b, w.konst(-1))
            w.panic_if(w.bin(BIN_AND, lhs_min, rhs_m1), 4)
        }
    }
    r := w.bin(code, a, b)
    if code < BIN_EQ || code == BIN_MOD || code >= BIN_XOR && code <= BIN_SHR {
        << w.wrap_int(r, ty)
    }
    << r
}

// Reduce a 64-bit result to the range of the narrow integer type ty.
fn (w $&Lw) wrap_int(v int, ty int) int {
    if ty == 7 || ty == 11 {
        $sh := w.konst(56)
        if ty == 11 { sh = w.konst(48) }
        << w.bin(BIN_SHR, w.bin(BIN_SHL, v, sh), sh)
    }
    if ty == 12 {
        << w.bin(BIN_AND, v, w.konst(65535))
    }
    if ty == 10 {
        << w.bin(BIN_AND, v, w.konst(255))
    }
    if ty == 9 {
        << w.bin(BIN_AND, v, w.konst(0xffffffff))
    }
    if ty == 8 {
        << w.bin(BIN_SHR, w.bin(BIN_SHL, v, w.konst(32)), w.konst(32))
    }
    << v
}

fn (w $&Lw) lower_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if n < 0 {
        << w.konst(0)
    }
    if tp.borrows_place(n) {
        << w.lower_addr(p, tp, n)
    }
    if n != w.unboxed && w.err_wants_box(tp, n) {
        << w.err_box(p, tp, n)
    }
    if n != w.unboxed && w.iface_wants_box(tp, n) {
        << w.iface_box(p, tp, n)
    }
    k := p.nodes[n].kind
    if n != w.noclone && w.wants_clone(p, tp, n) {
        prev := w.noclone
        w.noclone = n
        r := w.lower_clone(p, tp, n)
        w.noclone = prev
        << r
    }
    if k == ast.NK_IDENT || k == ast.NK_FIELD {
        fv := w.fnval_expr(p, tp, n)
        if fv != NOT_HANDLED {
            << fv
        }
    }
    if k == ast.NK_INT {
        << w.konst(p.nodes[n].ival)
    }
    if k == ast.NK_BOOL {
        if p.nodes[n].ival != 0 {
            << w.konst(1)
        }
        << w.konst(0)
    }
    if k == ast.NK_STR {
        << w.lower_str_lit(p.nodes[n].sval)
    }
    if k == ast.NK_IDENT {
        << w.lower_ident(p, tp, n)
    }
    if k == ast.NK_BIN_OP {
        << w.lower_binop(p, tp, n)
    }
    if k == ast.NK_UN_OP {
        op := p.nodes[n].ival
        if op == ast.UN_NEG {
            v := w.lower_expr(p, tp, p.nodes[n].a)
            if tp.type_of(n) == 14 {
                << w.bin(BIN_XOR, v, w.konst(2147483648))
            }
            if tp.type_of(n) == 4 {
                << w.float_neg(v)
            }
            << w.bin(BIN_SUB, w.konst(0), v)
        }
        if op == ast.UN_NOT {
            v := w.lower_expr(p, tp, p.nodes[n].a)
            << w.bin(BIN_XOR, v, w.konst(1))
        }
        ptr := w.lower_expr(p, tp, p.nodes[n].a)
        ty := tp.type_of(n)
        if is_wide(tp, ty) {
            << ptr
        }
        $sid := 0
        if ptr >= 0 && ptr < w.temp_scope.len && w.temp_scope[ptr] > 0 {
            sid = w.temp_scope[ptr]
        }
        if sid == 0 && p.nodes[n].a >= 0 && p.nodes[p.nodes[n].a].kind == ast.NK_IDENT {
            aid := tp.local_of(p.nodes[n].a)
            if aid >= 0 && aid < w.lscope.len && w.lscope[aid] > 0 {
                sid = w.lscope[aid]
            }
        }
        res := w.load_ptr(ptr, 0, width_of(tp, ty))
        if sid > 0 {
            last_i := w.f.instrs.len - 1
            if last_i >= 0 && w.f.instrs[last_i].kind == MI_LOAD_PTR {
                w.f.instrs[last_i].scope_id = sid
            }
        }
        << res
    }
    if k == ast.NK_BORROW {
        target := p.nodes[n].a
        if p.nodes[target].kind == ast.NK_UN_OP && p.nodes[target].ival == ast.UN_DEREF {
            << w.lower_expr(p, tp, p.nodes[target].a)
        }
        << w.lower_addr(p, tp, target)
    }
    if k == ast.NK_FIELD {
        << w.lower_field(p, tp, n)
    }
    if k == ast.NK_INDEX {
        << w.lower_index(p, tp, n)
    }
    if k == ast.NK_SLICE {
        << w.lower_slice(p, tp, n)
    }
    if k == ast.NK_CALL {
        << w.lower_call(p, tp, n)
    }
    if k == ast.NK_METHOD_CALL {
        << w.lower_method_call(p, tp, n)
    }
    if k == ast.NK_STRUCT_INIT {
        << w.lower_struct_init(p, tp, n)
    }
    if k == ast.NK_ARRAY_LIT || k == ast.NK_EMPTY_ARRAY {
        << w.lower_array_lit(p, tp, n)
    }
    if k == ast.NK_CLONE {
        << w.lower_clone(p, tp, p.nodes[n].a)
    }
    if k == ast.NK_INLINE_ASM {
        $inst := minstr_new(MI_ASM)
        inst.line = p.nodes[n].line
        inst.col = p.nodes[n].col
        inst.sval = p.nodes[n].sval + ""
        w.emit(inst)
        << w.konst(0)
    }
    if k == ast.NK_CAST {
        v := w.lower_expr(p, tp, p.nodes[n].a)
        to := p.nodes[n].ival
        if types.is_float_type(to) || types.is_float_type(tp.deref(tp.type_of(p.nodes[n].a))) {
            << w.float_cast(p, tp, n, v)
        }
        if to == 7 || to == 11 || to == 12 {
            << w.wrap_int(v, to)
        }
        if to == 10 {
            << w.bin(BIN_AND, v, w.konst(255))
        }
        if to == 9 {
            << w.bin(BIN_AND, v, w.konst(4294967295))
        }
        if to == 8 {
            sh := w.bin(BIN_SHL, v, w.konst(32))
            << w.bin(BIN_SHR, sh, w.konst(32))
        }
        << v
    }
    if k == ast.NK_TERNARY {
        << w.lower_ternary(p, tp, n)
    }
    if k == ast.NK_TYPE_AS {
        a := p.nodes[n].a
        aty := tp.deref(tp.deref(tp.type_of(a)))
        rty := tp.deref(tp.deref(tp.type_of(n)))
        if types.is_fn_type(aty) && (types.is_raw_ptr_type(rty) || types.is_integer_type(rty)) {
            ak := p.nodes[a].kind
            afi := tp.call_of(a)
            if (ak == ast.NK_IDENT || ak == ast.NK_FIELD) && tp.local_of(a) < 0 && afi >= 0 && afi < tp.fns.len {
                << w.fn_addr(tp.fns[afi].label)
            }
            fv := w.lower_expr(p, tp, a)
            << w.load_ptr(fv, 0, 8)
        }
        if types.is_raw_ptr_type(rty) || types.is_raw_ptr_type(aty) {
            << w.lower_expr(p, tp, a)
        }
    }
    $r := w.err_expr(p, tp, n)
    if r == NOT_HANDLED { r = w.host_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.float_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.enum_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.chan_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.map_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.fnval_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.iface_expr(p, tp, n) }
    if r != NOT_HANDLED {
        << r
    }
    w.fail(p, n, "expression " + types.ast_kind_name(k) + " is not supported yet")
    << w.konst(0)
}

// A place read in a move position that the checker marked for cloning, so
// the new owner does not share the source's buffers.
fn (w $&Lw) wants_clone(p &parser.Parser, tp &types.TypedProgram, n int) bool {
    if tp.clone_of(n) != 1 || tp.const_of(n) >= 0 {
        << false
    }
    k := p.nodes[n].kind
    if k != ast.NK_IDENT && k != ast.NK_FIELD && k != ast.NK_INDEX && !(k == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_DEREF) {
        << false
    }
    ty := tp.deref(tp.type_of(n))
    << w.needs_drop(tp, ty)
}

// Expression e produces a fresh, unaliased owned value (not a literal, local,
// place borrow, or reference) whose consumer is responsible for dropping it
// once read if ownership is not transferred elsewhere.
fn (w $&Lw) fresh_temp(p &parser.Parser, tp &types.TypedProgram, e int) bool {
    if e < 0 || (tp.box_of(e) != 0 && e != w.unboxed) || tp.const_of(e) >= 0 || tp.borrows_place(e) || w.expr_is_ref(p, tp, e) {
        << false
    }
    if w.wants_clone(p, tp, e) {
        << true
    }
    k := p.nodes[e].kind
    if k == ast.NK_STR || k == ast.NK_IDENT || k == ast.NK_INDEX || k == ast.NK_UN_OP {
        << false
    }
    if k == ast.NK_FIELD {
        c := tp.call_of(e)
        << c == -30 || c == -92
    }
    if k == ast.NK_BIN_OP {
        << p.nodes[e].ival == ast.OP_ADD && tp.deref(tp.type_of(p.nodes[e].a)) == 3
    }
    if k == ast.NK_OR_CATCH {
        << w.fresh_temp(p, tp, p.nodes[e].a)
    }
    if k == ast.NK_TERNARY || k == ast.NK_STRUCT_INIT || k == ast.NK_ARRAY_LIT ||
       k == ast.NK_EMPTY_ARRAY || k == ast.NK_CLONE || k == ast.NK_SLICE ||
       k == ast.NK_MAP_INIT || k == ast.NK_CHAN_INIT || k == ast.NK_RECV ||
       k == ast.NK_TYPE_AS || k == ast.NT_FN_LIT {
        << true
    }
    if k == ast.NK_CALL || k == ast.NK_METHOD_CALL {
        code := tp.call_of(e)
        if code == -19 {
            << w.fresh_temp(p, tp, p.nodes[e].a)
        }
        if code >= 0 || code == -80 || code == -83 || code == -94 ||
           code == -8 || code == -9 || code == -30 ||
           code == -75 || code == -76 || code == -87 || code == -88 {
            << true
        }
        if intrin_wide_name(code).len > 0 {
            << true
        }
        sig := host_sig_of(code)
        << sig.name.len > 0 && (sig.shape == HR_WIDE || sig.shape == HR_TWIDE)
    }
    << false
}

// Drop temporary value v of type ty when expression e produced a fresh owner.
fn (w $&Lw) drop_temp(p &parser.Parser, tp &types.TypedProgram, e int, v int, ty int) {
    if w.needs_drop(tp, ty) && w.fresh_temp(p, tp, e) {
        $addr := v
        if !is_wide(tp, ty) {
            addr = w.scratch_words(1)
            w.store_ptr(addr, 0, v, width_of(tp, ty))
        }
        w.drop_value(tp, addr, ty)
    }
}

// Drop an argument lowered via host_arg when the argument expression produced
// a fresh temporary owner (fixed-size arrays wrap the base address in {p,N,N}).
fn (w $&Lw) drop_host_temp_arg(p &parser.Parser, tp &types.TypedProgram, e int, v int) {
    ty := tp.deref(tp.deref(tp.type_of(e)))
    if !w.needs_drop(tp, ty) || !w.fresh_temp(p, tp, e) {
        <<
    }
    $addr := v
    if is_wide(tp, ty) && types.is_array_type(ty) && fixed_len_of(tp, ty) > 0 {
        addr = w.load_ptr(v, 0, 8)
    } else if !is_wide(tp, ty) {
        addr = w.scratch_words(1)
        w.store_ptr(addr, 0, v, width_of(tp, ty))
    }
    w.drop_value(tp, addr, ty)
}

// Allocate a scoped drop-tracked scratch slot for a temporary owner of type ty.
fn (w $&Lw) own_temp_slot(tp &types.TypedProgram, ty int, name string) int {
    while w.lslot.len < tp.fns[w.fi].locals.len {
        w.lslot.push(-1)
    }
    id := w.lslot.len
    slot := w.new_local(ty, tp.words_of(ty), name)
    w.lslot.push(slot)
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    w.own_grow(id)
    if w.needs_drop(tp, ty) {
        w.lowned[id] = true
        w.lmoved[id] = false
        w.ldrop_flag[id] = -1
        w.scope_ids.push(id)
        w.scope_ostart.push(w.scope_offs.len)
        w.drop_offsets(tp, ty, 0)
    }
    << slot
}

// The string value of e is a new heap buffer that nothing else refers to,
// so its consumer may free it once the bytes have been used.
fn (w $&Lw) fresh_str(p &parser.Parser, tp &types.TypedProgram, e int) bool {
    if e < 0 || tp.type_of(e) != 3 {
        << false
    }
    << w.fresh_temp(p, tp, e)
}

// Free the string at address d when expression e produced a fresh buffer.
fn (w $&Lw) drop_fresh_str(p &parser.Parser, tp &types.TypedProgram, e int, d int) {
    if w.fresh_str(p, tp, e) {
        $args := []int{}
        args.push(d)
        w.call_core("str_free", &args)
    }
}

// ===== string local ownership =====

fn (w &Lw) owns(id int) bool {
    << id >= 0 && id < w.lowned.len && w.lowned[id]
}

fn (w $&Lw) own_grow(id int) {
    while w.lowned.len <= id {
        w.lowned.push(false)
        w.lmoved.push(false)
        w.ldrop_flag.push(-1)
    }
}

// Drop flag slot of local id, or -1.
fn (w &Lw) flag_of(id int) int {
    if id >= 0 && id < w.ldrop_flag.len {
        << w.ldrop_flag[id]
    }
    << -1
}

// Local id needs a drop flag; the current pass cannot add one after the
// fact (earlier drops of the local are already emitted), so it is recorded
// for the next pass.
fn (w $&Lw) note_dynamic(id int) {
    for i in 0:w.dyn_found.len {
        if w.dyn_found[i] == id {
            <<
        }
    }
    w.dyn_found.push(id)
}

fn (w &Lw) is_dynamic(id int) bool {
    for i in 0:w.dyn_ids.len {
        if w.dyn_ids[i] == id {
            << true
        }
    }
    << false
}

// Strings, dynamic arrays and structs with owned fields need cleanup.
// Resource owners also run their hooks, including resource array elements.
fn (w $&Lw) needs_drop(tp &types.TypedProgram, ty int) bool {
    if ty == 3 {
        << true
    }
    if types.is_array_type(ty) {
        ai := types.array_index(ty)
        if tp.arrays[ai].fixed_len == 0 {
            << true
        }
        << w.needs_drop(tp, tp.arrays[ai].elem_ty)
    }
    // A map owns its record, keys and values; copies are deep clones
    // (clone_into) and moves transfer the handle.
    if types.is_map_type(ty) {
        << true
    }
    // An interface value is one word, the address of a shared heap box
    // that counts its holders (see BOX_HDR).
    if types.is_interface_type(ty) || types.is_fn_type(ty) || is_dyn_box_type(ty) || types.is_chan_type(ty) {
        << true
    }
    if types.is_enum_type(ty) {
        if !is_wide(tp, ty) { << false }
        ei := types.enum_index(ty)
        for vi in 0:tp.enums[ei].variants.len {
            for fi in 0:tp.enums[ei].variants[vi].fields.len {
                if w.needs_drop(tp, tp.enums[ei].variants[vi].fields[fi]) {
                    << true
                }
            }
        }
        << false
    }
    if !types.is_struct_type(ty) {
        << false
    }
    si := types.struct_index(ty)
    while w.sdrop.len <= si {
        w.sdrop.push(0)
    }
    if w.sdrop[si] == 0 {
        w.sdrop[si] = 2
        if tp.structs[si].has_drop { w.sdrop[si] = 1 }
        for i in 0:tp.structs[si].fields.len {
            if w.needs_drop(tp, tp.structs[si].fields[i].ty) { w.sdrop[si] = 1 }
        }
    }
    << w.sdrop[si] == 1
}

// Cleanup offsets and labels for the value at base: either a buffer
// descriptor freed with str_free, or the address passed to resource glue.
fn (w $&Lw) drop_offsets(tp &types.TypedProgram, ty int, base int) {
    if resource_drop_type(tp, ty) {
        w.scope_offs.push(base)
        w.scope_drop_labels.push(resource_drop_label(ty))
        <<
    }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        for i in 0:tp.structs[si].fields.len {
            fty := tp.structs[si].fields[i].ty
            if w.needs_drop(tp, fty) {
                w.drop_offsets(tp, fty, base + tp.structs[si].fields[i].offset)
            }
        }
        <<
    }
    w.scope_offs.push(base)
    w.scope_drop_labels.push("")
}

// Free the buffers owned by the value of type ty at address a.
fn (w $&Lw) drop_value(tp &types.TypedProgram, a int, ty int) {
    if resource_drop_type(tp, ty) {
        args := [a]
        w.call(resource_drop_label(ty), &args)
        <<
    }
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        for i in 0:tp.structs[si].fields.len {
            fty := tp.structs[si].fields[i].ty
            if w.needs_drop(tp, fty) {
                w.drop_value(tp, w.bin(BIN_ADD, a, w.konst(tp.structs[si].fields[i].offset)), fty)
            }
        }
        <<
    }
    $args := []int{}
    args.push(a)
    w.call_core("str_free", &args)
}

// Local id now holds an owned value, dropped when its scope ends.
fn (w $&Lw) own_declare(tp &types.TypedProgram, id int) {
    if id < 0 || !w.needs_drop(tp, w.local_type(tp, id)) {
        <<
    }
    if w.lslot.len > id && w.lslot[id] >= 0 && w.byref(w.lslot[id]) {
        <<
    }
    w.own_grow(id)
    w.lowned[id] = true
    w.lmoved[id] = false
    w.ldrop_flag[id] = -1
    if w.is_dynamic(id) {
        flag := w.new_local(1, 1, "drop_flag")
        w.ldrop_flag[id] = flag
        w.store_local(flag, 0, w.konst(1))
    }
    w.scope_ids.push(id)
    w.scope_ostart.push(w.scope_offs.len)
    w.drop_offsets(tp, w.local_type(tp, id), 0)
}

// Close the scopes above mark (their drops are already emitted).
fn (w $&Lw) scope_truncate(mark int) {
    if w.scope_ids.len > mark {
        w.scope_drop_labels = w.scope_drop_labels[0:w.scope_ostart[mark]]
        w.scope_offs = w.scope_offs[0:w.scope_ostart[mark]]
        w.scope_ids = w.scope_ids[0:mark]
        w.scope_ostart = w.scope_ostart[0:mark]
    }
}

// Local id was declared outside the innermost loop. The checker lets a
// loop body move it on a path ending in break/continue, which leaves the
// moved state of the code after the loop unknown here.
fn (w &Lw) outside_loop(id int) bool {
    if w.loop_depth == 0 {
        << false
    }
    mark := w.loop_scope[w.loop_depth - 1]
    for i in 0:mark {
        if w.scope_ids[i] == id {
            << true
        }
    }
    << false
}

// Owned local id was moved out here.
fn (w $&Lw) mark_moved(id int) {
    flag := w.flag_of(id)
    if flag >= 0 {
        w.store_local(flag, 0, w.konst(0))
    } else if w.outside_loop(id) {
        w.note_dynamic(id)
        w.own_disown(id)
    } else {
        w.lmoved[id] = true
    }
}

// The buffer of local id escaped where moves are not tracked; never drop it.
fn (w $&Lw) own_disown(id int) {
    if w.owns(id) {
        w.lowned[id] = false
    }
}

// Calls that free the value of the owned local at scope_ids[i].
fn (w $&Lw) emit_scope_drops(i int) {
    id := w.scope_ids[i]
    slot := w.lslot[id]
    $end := w.scope_offs.len
    if i + 1 < w.scope_ids.len {
        end = w.scope_ostart[i + 1]
    }
    base := w.local_addr(slot)
    for j in w.scope_ostart[i]:end {
        $args := []int{}
        off := w.scope_offs[j]
        if off == 0 {
            args.push(base)
        } else {
            args.push(w.bin(BIN_ADD, base, w.konst(off)))
        }
        if w.scope_drop_labels[j].len == 0 {
            w.call_core("str_free", &args)
        } else {
            w.call(w.scope_drop_labels[j] + "", &args)
        }
    }
}

// Free owned, unmoved locals declared at scope_ids[mark:], innermost first.
// A local with a drop flag is freed when the flag is still set.
fn (w $&Lw) drop_owned_from(mark int) {
    $i := w.scope_ids.len - 1
    while i >= mark {
        id := w.scope_ids[i]
        if w.lowned[id] && w.lslot[id] >= 0 {
            flag := w.flag_of(id)
            if flag >= 0 {
                then_b := w.new_block()
                next_b := w.new_block()
                w.branch(w.load_local(flag, 0), then_b, next_b)
                w.f.active_bb = then_b
                w.emit_scope_drops(i)
                w.jump(next_b)
                w.f.active_bb = next_b
            } else if !w.lmoved[id] {
                w.emit_scope_drops(i)
            }
        }
        i -= 1
    }
}

// The value of e may be stored into a new owner as is: it is fresh (a
// literal, constructor, slice copy or user call result), a checker clone,
// or a local move (lower_ident clones views).
fn (w $&Lw) transfer_safe(p &parser.Parser, tp &types.TypedProgram, e int) bool {
    if e < 0 || tp.const_of(e) >= 0 || w.fresh_temp(p, tp, e) {
        << true
    }
    if w.expr_is_ref(p, tp, e) || tp.borrows_place(e) {
        << false
    }
    // Boxing into temp/any or an interface makes a new box.
    if e != w.unboxed && (w.iface_wants_box(tp, e) || w.err_wants_box(tp, e)) {
        << true
    }
    k := p.nodes[e].kind
    if k == ast.NK_OR_CATCH { << w.transfer_safe(p, tp, p.nodes[e].a) }
    c := tp.clone_of(e)
    if (c == 1 && w.wants_clone(p, tp, e)) || (c == 2 && k == ast.NK_IDENT) {
        << true
    }
    if k == ast.NK_STR {
        << true
    }
    << w.builtin_fresh(p, tp, e)
}

// e is a builtin whose result is a new value nothing else refers to: a
// received channel element, an enum constructor, a map take, or a runtime
// call that fills a fresh buffer. Cloning such a result leaks the original.
fn (w &Lw) builtin_fresh(p &parser.Parser, tp &types.TypedProgram, e int) bool {
    k := p.nodes[e].kind
    if k == ast.NK_RECV {
        << true
    }
    code := tp.call_of(e)
    if code == -30 && (k == ast.NK_CALL || k == ast.NK_METHOD_CALL || k == ast.NK_FIELD) {
        << true
    }
    // `as` on a temp/any hands out a value of its own (taken or copied).
    if k == ast.NK_TYPE_AS && is_dyn_box_type(tp.deref(tp.deref(tp.type_of(p.nodes[e].a)))) && is_wide(tp, tp.type_of(e)) {
        << true
    }
    // A function literal or a value method makes a new function value.
    if k == ast.NT_FN_LIT || (k == ast.NK_FIELD && code == -92) {
        << true
    }
    if k != ast.NK_CALL && k != ast.NK_METHOD_CALL {
        << false
    }
    if code == -75 || code == -76 || code == -87 || code == -88 {
        << true
    }
    if intrin_wide_name(code).len > 0 {
        << true
    }
    sig := host_sig_of(code)
    << sig.name.len > 0 && (sig.shape == HR_WIDE || sig.shape == HR_TWIDE)
}

// Value v of e, of type ty, as a value whose buffers the consumer owns.
fn (w $&Lw) own_val(p &parser.Parser, tp &types.TypedProgram, e int, v int, ty int) int {
    if !w.needs_drop(tp, ty) || w.transfer_safe(p, tp, e) {
        << v
    }
    << w.clone_value(tp, v, ty)
}

// Deep copy of value v of type ty: an address for wide values, the value
// itself for one-word owners such as maps.
fn (w $&Lw) clone_value(tp &types.TypedProgram, v int, ty int) int {
    out := w.scratch(tp, ty)
    if is_wide(tp, ty) {
        w.clone_into(tp, out, v, ty)
        << out
    }
    src := w.scratch_words(1)
    w.store_ptr(src, 0, v, 8)
    w.clone_into(tp, out, src, ty)
    << w.load_ptr(out, 0, 8)
}

fn (w $&Lw) own_str(p &parser.Parser, tp &types.TypedProgram, e int, v int) int {
    << w.own_val(p, tp, e, v, 3)
}

fn (w $&Lw) lower_str_lit(s string) int {
    d := w.scratch_words(3)
    data := w.new_temp()
    $ins := minstr_new(MI_STR_CONST)
    ins.a = data
    ins.sval = s + ""
    w.emit(ins)
    w.store_ptr(d, 0, data, 8)
    w.store_ptr(d, 8, w.konst(s.len), 8)
    w.store_ptr(d, 16, w.konst(0), 8)
    << d
}

fn (w $&Lw) lower_ident(p &parser.Parser, tp &types.TypedProgram, n int) int {
    id := tp.local_of(n)
    if id >= 0 {
        slot := w.ensure_local(tp, id)
        ty := w.local_type(tp, id)
        if tp.clone_of(n) == 2 && w.needs_drop(tp, ty) {
            if w.owns(id) && (w.in_cond == 0 || ty != 3) {
                flag := w.flag_of(id)
                if flag >= 0 {
                    w.store_local(flag, 0, w.konst(0))
                } else if w.outside_loop(id) {
                    // Moved inside a loop it was declared outside of: code
                    // after the loop cannot tell statically. Leak it in
                    // this pass; the next pass gives it a drop flag.
                    w.note_dynamic(id)
                    w.own_disown(id)
                } else {
                    w.lmoved[id] = true
                }
            } else {
                out := w.scratch(tp, ty)
                w.clone_into(tp, out, w.local_addr(slot), ty)
                if is_wide(tp, ty) {
                    << out
                }
                << w.load_ptr(out, 0, width_of(tp, ty))
            }
        }
        if is_wide(tp, ty) {
            << w.local_addr(slot)
        }
        if w.byref(slot) {
            ptr := w.load_local(slot, 0)
            << w.load_ptr(ptr, 0, width_of(tp, ty))
        }
        << w.load_local(slot, 0)
    }
    if tp.const_of(n) >= 0 {
        << w.lower_const(tp, tp.const_of(n))
    }
    if tp.global_of(n) >= 0 {
        << w.lower_global_val(tp, tp.global_of(n))
    }
    w.fail(p, n, "unresolved name '" + p.nodes[n].sval + "'")
    << w.konst(0)
}

// Package constant ci: a string descriptor address or a scalar value.
fn (w $&Lw) lower_const(tp &types.TypedProgram, ci int) int {
    if ci < tp.const_tys.len {
        if tp.const_tys[ci] == 3 {
            si := tp.const_strs[ci]
            if si >= 0 && si < tp.strings.len {
                << w.lower_str_lit(tp.strings[si])
            }
        }
        << w.konst(tp.const_ivals[ci])
    }
    << w.konst(0)
}

fn (w $&Lw) lower_binop(p &parser.Parser, tp &types.TypedProgram, n int) int {
    op := p.nodes[n].ival
    if op == ast.OP_AND || op == ast.OP_OR {
        res := w.new_local(2, 1, "cond")
        lhs := w.lower_expr(p, tp, p.nodes[n].a)
        w.store_local(res, 0, lhs)
        rhs_b := w.new_block()
        done_b := w.new_block()
        if op == ast.OP_AND {
            w.branch(lhs, rhs_b, done_b)
        } else {
            w.branch(lhs, done_b, rhs_b)
        }
        w.f.active_bb = rhs_b
        rhs := w.lower_expr(p, tp, p.nodes[n].b)
        w.store_local(res, 0, rhs)
        w.jump(done_b)
        w.f.active_bb = done_b
        << w.load_local(res, 0)
    }
    lt := tp.deref(tp.type_of(p.nodes[n].a))
    if lt == 3 {
        a := w.base_addr(p, tp, p.nodes[n].a)
        b := w.base_addr(p, tp, p.nodes[n].b)
        if op == ast.OP_ADD {
            out := w.scratch_words(3)
            $args := []int{}
            args.push(out)
            args.push(a)
            args.push(b)
            w.call_core("str_concat", &args)
            w.drop_fresh_str(p, tp, p.nodes[n].a, a)
            w.drop_fresh_str(p, tp, p.nodes[n].b, b)
            << out
        }
        if op == ast.OP_EQ || op == ast.OP_NE {
            $args := []int{}
            args.push(a)
            args.push(b)
            eq := w.call_core("str_eq", &args)
            w.drop_fresh_str(p, tp, p.nodes[n].a, a)
            w.drop_fresh_str(p, tp, p.nodes[n].b, b)
            if op == ast.OP_NE {
                << w.bin(BIN_XOR, eq, w.konst(1))
            }
            << eq
        }
        w.fail(p, n, "string operator " + ast.binop_name(op) + " is not supported yet")
        << w.konst(0)
    }
    if types.is_float_type(lt) {
        << w.float_binop(p, tp, n)
    }
    code := bin_code(op)
    if code < 0 {
        w.fail(p, n, "binary operator " + ast.binop_name(op) + " is not supported yet")
        << w.konst(0)
    }
    a := w.lower_expr(p, tp, p.nodes[n].a)
    b := w.lower_expr(p, tp, p.nodes[n].b)
    << w.checked_bin(code, a, b, lt)
}

fn (w $&Lw) lower_ternary(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    wide := is_wide(tp, ty)
    $res := -1
    if wide {
        res = w.new_local(ty, tp.words_of(ty), "sel")
    } else {
        res = w.new_local(ty, 1, "sel")
    }
    cond := w.lower_expr(p, tp, p.nodes[n].a)
    then_b := w.new_block()
    else_b := w.new_block()
    done_b := w.new_block()
    w.branch(cond, then_b, else_b)
    w.f.active_bb = then_b
    $tv := w.lower_expr(p, tp, p.nodes[n].b)
    if ty != 0 {
        tv = w.own_val(p, tp, p.nodes[n].b, tv, ty)
    }
    if wide {
        w.copy_mem(w.addr_local(res), tv, tp.size_of(ty))
    } else {
        w.store_local(res, 0, tv)
    }
    w.jump(done_b)
    w.f.active_bb = else_b
    $ev := w.lower_expr(p, tp, p.nodes[n].c)
    if ty != 0 {
        ev = w.own_val(p, tp, p.nodes[n].c, ev, ty)
    }
    if wide {
        w.copy_mem(w.addr_local(res), ev, tp.size_of(ty))
    } else {
        w.store_local(res, 0, ev)
    }
    w.jump(done_b)
    w.f.active_bb = done_b
    if wide {
        << w.addr_local(res)
    }
    << w.load_local(res, 0)
}

fn bitfield_mask(w int) int {
    if w >= 64 { << -1 }
    if w == 63 { << 9223372036854775807 }
    $m := 1
    for i in 0:w { m = m * 2 }
    << m - 1
}

fn (w $&Lw) lower_bitfield_read(base_addr int, fld &types.TField) int {
    raw := w.load_ptr(base_addr, fld.offset, fld.bit_unit)
    if fld.bit_width >= 64 { << raw }
    signed := fld.ty == 1 || fld.ty == 7 || fld.ty == 8 || fld.ty == 11
    if signed {
        shl := 64 - fld.bit_off - fld.bit_width
        $v := raw
        if shl > 0 { v = w.bin(BIN_SHL, v, w.konst(shl)) }
        << w.bin(BIN_SHR, v, w.konst(64 - fld.bit_width))
    }
    $v := raw
    if fld.bit_off > 0 { v = w.bin(BIN_SHR, v, w.konst(fld.bit_off)) }
    << w.bin(BIN_AND, v, w.konst(bitfield_mask(fld.bit_width)))
}

fn (w $&Lw) lower_bitfield_write(base_addr int, fld &types.TField, val int) {
    if fld.bit_width >= 64 {
        w.store_ptr(base_addr, fld.offset, val, fld.bit_unit)
        <<
    }
    m := w.konst(bitfield_mask(fld.bit_width))
    $vm := w.bin(BIN_AND, val, m)
    $sm := m
    if fld.bit_off > 0 {
        vm = w.bin(BIN_SHL, vm, w.konst(fld.bit_off))
        sm = w.bin(BIN_SHL, sm, w.konst(fld.bit_off))
    }
    clear := w.bin(BIN_XOR, sm, w.konst(-1))
    old := w.load_ptr(base_addr, fld.offset, fld.bit_unit)
    merged := w.bin(BIN_OR, w.bin(BIN_AND, old, clear), vm)
    w.store_ptr(base_addr, fld.offset, merged, fld.bit_unit)
}

fn (w $&Lw) lower_field(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if tp.const_of(n) >= 0 {
        << w.lower_const(tp, tp.const_of(n))
    }
    if tp.global_of(n) >= 0 {
        << w.lower_global_val(tp, tp.global_of(n))
    }
    if tp.call_of(n) == -30 {
        << w.enum_ctor(p, tp, n, -1)
    }
    base := p.nodes[n].a
    bty := tp.deref(tp.deref(tp.type_of(base)))
    name := p.nodes[n].sval
    if bty == 3 || types.is_array_type(bty) {
        if tp.call_of(n) == -96 {
            << w.konst(tp.local_of(n))
        }
        d := w.array_desc(p, tp, base, bty)
        if name == "len" || name == "cap" {
            $off := 8
            if name == "cap" {
                off = 16
            }
            res := w.load_ptr(d, off, 8)
            if w.needs_drop(tp, bty) && w.fresh_temp(p, tp, base) {
                $ba := d
                if fixed_len_of(tp, bty) > 0 {
                    ba = w.load_ptr(d, 0, 8)
                }
                w.drop_value(tp, ba, bty)
            }
            << res
        }
        w.fail(p, n, "unknown field '" + name + "'")
        << w.konst(0)
    }
    if types.is_struct_type(bty) {
        fname := name + ""
        fld := tp.field_of(bty, &fname)
        if fld.offset >= 0 && fld.bit_width > 0 {
            baddr := w.base_addr(p, tp, base)
            res := w.lower_bitfield_read(baddr, &fld)
            if w.needs_drop(tp, bty) && w.fresh_temp(p, tp, base) {
                w.drop_value(tp, baddr, bty)
            }
            << res
        }
    }
    fty := tp.type_of(n)
    if types.is_struct_type(bty) && !is_wide(tp, fty) && !w.needs_drop(tp, fty) && !types.is_ref_type(fty) && w.needs_drop(tp, bty) && w.fresh_temp(p, tp, base) {
        fname := name + ""
        fld := tp.field_of(bty, &fname)
        if fld.offset >= 0 {
            baddr := w.base_addr(p, tp, base)
            res := w.load_ptr(baddr, fld.offset, width_of(tp, fty))
            w.drop_value(tp, baddr, bty)
            << res
        }
    }
    addr := w.lower_place_addr(p, tp, n)
    if is_wide(tp, fty) {
        << addr
    }
    << w.load_ptr(addr, 0, width_of(tp, fty))
}

fn (w $&Lw) lower_index(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if tp.call_of(n) == -77 {
        << w.map_index(p, tp, n)
    }
    base := p.nodes[n].a
    bty := tp.deref(tp.deref(tp.type_of(base)))
    if bty != 3 && !types.is_array_type(bty) {
        w.fail(p, n, "indexing this type is not supported yet")
        << w.konst(0)
    }
    ety := tp.type_of(n)
    if (bty == 3 || (!is_wide(tp, ety) && !w.needs_drop(tp, ety) && !types.is_ref_type(ety))) && w.needs_drop(tp, bty) && w.fresh_temp(p, tp, base) {
        d := w.array_desc(p, tp, base, bty)
        idx := w.lower_expr(p, tp, p.nodes[n].b)
        w.bounds_check(idx, w.load_ptr(d, 8, 8))
        data := w.load_ptr(d, 0, 8)
        $res := -1
        if bty == 3 {
            res = w.load_ptr(w.bin(BIN_ADD, data, idx), 0, 1)
        } else {
            esize := tp.size_of(ety)
            eaddr := w.bin(BIN_ADD, data, w.bin(BIN_MUL, idx, w.konst(esize)))
            res = w.load_ptr(eaddr, 0, width_of(tp, ety))
        }
        $ba := d
        if fixed_len_of(tp, bty) > 0 {
            ba = w.load_ptr(d, 0, 8)
        }
        w.drop_value(tp, ba, bty)
        << res
    }
    addr := w.lower_place_addr(p, tp, n)
    if bty == 3 {
        << w.load_ptr(addr, 0, 1)
    }
    if is_wide(tp, ety) {
        << addr
    }
    << w.load_ptr(addr, 0, width_of(tp, ety))
}

fn (w $&Lw) lower_slice(p &parser.Parser, tp &types.TypedProgram, n int) int {
    base := p.nodes[n].a
    bty := tp.deref(tp.deref(tp.type_of(base)))
    d := w.base_addr(p, tp, base)
    $lo := w.konst(0)
    if p.nodes[n].b >= 0 {
        lo = w.lower_expr(p, tp, p.nodes[n].b)
    }
    $hi := -1
    if p.nodes[n].c >= 0 {
        hi = w.lower_expr(p, tp, p.nodes[n].c)
    } else {
        hi = w.load_ptr(d, 8, 8)
    }
    out := w.scratch_words(3)
    $args := []int{}
    args.push(out)
    args.push(d)
    args.push(lo)
    args.push(hi)
    if bty == 3 {
        w.call_core("str_slice", &args)
        w.drop_fresh_str(p, tp, base, d)
    } else {
        ety := tp.elem_of(bty)
        args.push(w.konst(tp.size_of(ety)))
        w.call_core("slice_slice", &args)
        // slice_slice copies element words; elements that own buffers must
        // not be shared with the source array, which frees its own.
        if w.needs_drop(tp, ety) {
            w.clone_elems(tp, out, ety)
        }
        if w.needs_drop(tp, bty) && w.fresh_temp(p, tp, base) {
            w.drop_value(tp, d, bty)
        }
    }
    << out
}

fn (w $&Lw) lower_clone(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.deref(tp.type_of(n))
    if !is_wide(tp, ty) {
        $v := w.lower_expr(p, tp, n)
        if w.expr_is_ref(p, tp, n) {
            v = w.load_ptr(v, 0, width_of(tp, ty))
        }
        if w.needs_drop(tp, ty) {
            << w.clone_value(tp, v, ty)
        }
        << v
    }
    src := w.base_addr(p, tp, n)
    out := w.scratch(tp, ty)
    w.clone_into(tp, out, src, ty)
    << out
}

// Deep copy of a value of type ty from src to dst.
fn (w $&Lw) clone_into(tp &types.TypedProgram, dst int, src int, ty int) {
    if ty == 3 {
        $args := []int{}
        args.push(dst)
        args.push(w.load_ptr(src, 0, 8))
        args.push(w.load_ptr(src, 8, 8))
        w.call_core("bytes_new", &args)
        <<
    }
    // Containers of owners clone through a glue function, so a recursive
    // type (a struct holding an array of itself) stays finite.
    if !w.in_clone_glue && w.uses_clone_glue(tp, ty) {
        args := [dst, src]
        w.call(clone_glue_label(ty), &args)
        <<
    }
    w.in_clone_glue = false
    if types.is_map_type(ty) {
        w.map_clone_into(tp, dst, src, ty)
        <<
    }
    if types.is_interface_type(ty) {
        bx := w.load_ptr(src, 0, 8)
        w.store_ptr(dst, 0, bx, 8)
        w.box_retain(bx)
        <<
    }
    if types.is_fn_type(ty) {
        w.fnval_clone_into(dst, src)
        <<
    }
    if is_dyn_box_type(ty) {
        w.dyn_clone_into(dst, src)
        <<
    }
    if types.is_chan_type(ty) {
        ch := w.load_ptr(src, 0, 8)
        w.store_ptr(dst, 0, ch, 8)
        $args := []int{}
        args.push(ch)
        w.call_core("chan_retain", &args)
        <<
    }
    if types.is_array_type(ty) {
        fl := tp.arrays[types.array_index(ty)].fixed_len
        ety := tp.elem_of(ty)
        if fl > 0 {
            w.copy_mem(dst, src, tp.size_of(ty))
            if w.needs_drop(tp, ety) {
                esize := tp.size_of(ety)
                for fi in 0:fl {
                    off := w.konst(fi * esize)
                    w.clone_into(tp, w.bin(BIN_ADD, dst, off), w.bin(BIN_ADD, src, off), ety)
                }
            }
            <<
        }
        $args := []int{}
        args.push(dst)
        args.push(src)
        args.push(w.konst(0))
        args.push(w.load_ptr(src, 8, 8))
        args.push(w.konst(tp.size_of(ety)))
        w.call_core("slice_slice", &args)
        if w.needs_drop(tp, ety) {
            w.clone_elems(tp, dst, ety)
        }
        <<
    }
    if types.is_enum_type(ty) {
        w.enum_clone_into(tp, dst, src, ty)
        <<
    }
    w.copy_mem(dst, src, tp.size_of(ty))
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        for i in 0:tp.structs[si].fields.len {
            fty := tp.structs[si].fields[i].ty
            if w.needs_drop(tp, fty) {
                off := tp.structs[si].fields[i].offset
                fd := w.bin(BIN_ADD, dst, w.konst(off))
                fs := w.bin(BIN_ADD, src, w.konst(off))
                w.clone_into(tp, fd, fs, fty)
            }
        }
    }
}

// Replace each wide element of the array at d by a deep copy of itself.
fn (w $&Lw) clone_elems(tp &types.TypedProgram, d int, ety int) {
    esize := tp.size_of(ety)
    i := w.new_local(1, 1, "ci")
    w.store_local(i, 0, w.konst(0))
    cond_b := w.new_block()
    body_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    iv := w.load_local(i, 0)
    n := w.load_ptr(d, 8, 8)
    w.branch(w.bin(BIN_LT, iv, n), body_b, done_b)
    w.f.active_bb = body_b
    iv2 := w.load_local(i, 0)
    data := w.load_ptr(d, 0, 8)
    ea := w.bin(BIN_ADD, data, w.bin(BIN_MUL, iv2, w.konst(esize)))
    tmp := w.scratch(tp, ety)
    w.clone_into(tp, tmp, ea, ety)
    if is_wide(tp, ety) {
        w.copy_mem(ea, tmp, esize)
    } else {
        w.store_ptr(ea, 0, w.load_ptr(tmp, 0, 8), 8)
    }
    w.store_local(i, 0, w.bin(BIN_ADD, iv2, w.konst(1)))
    w.jump(cond_b)
    w.f.active_bb = done_b
}

fn (w $&Lw) lower_struct_init(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    if !types.is_struct_type(ty) {
        w.fail(p, n, "struct literal of a non-struct type")
        << w.konst(0)
    }
    si := types.struct_index(ty)
    out := w.scratch(tp, ty)
    w.zero_mem(out, tp.size_of(ty))
    $fld := p.nodes[n].a
    while fld >= 0 {
        fname := p.nodes[fld].sval
        $fi := -1
        for i in 0:tp.structs[si].fields.len {
            if tp.structs[si].fields[i].name == fname {
                fi = i
            }
        }
        if fi < 0 {
            w.fail(p, fld, "unknown field '" + fname + "'")
        } else {
            fty := tp.structs[si].fields[fi].ty
            fe := p.nodes[fld].a
            v := w.own_val(p, tp, fe, w.lower_expr(p, tp, fe), fty)
            if tp.structs[si].fields[fi].bit_width > 0 {
                w.lower_bitfield_write(out, &tp.structs[si].fields[fi], v)
            } else {
                w.store_value(tp, out, tp.structs[si].fields[fi].offset, v, fty)
            }
        }
        fld = p.nodes[fld].next
    }
    << out
}

fn (w $&Lw) lower_array_lit(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    if fixed_len_of(tp, ty) > 0 {
        << w.lower_fixed_array_lit(p, tp, n, ty)
    }
    out := w.scratch_words(3)
    w.zero_mem(out, 24)
    if p.nodes[n].kind == ast.NK_EMPTY_ARRAY {
        << out
    }
    ety := tp.elem_of(ty)
    $e := p.nodes[n].a
    while e >= 0 {
        v := w.own_val(p, tp, e, w.lower_expr(p, tp, e), ety)
        w.push_value(tp, out, v, ety)
        e = p.nodes[e].next
    }
    << out
}

// [N]T{...}: elements stored inline; missing trailing elements are zero.
fn (w $&Lw) lower_fixed_array_lit(p &parser.Parser, tp &types.TypedProgram, n int, ty int) int {
    out := w.scratch(tp, ty)
    w.zero_mem(out, tp.size_of(ty))
    ety := tp.elem_of(ty)
    esize := tp.size_of(ety)
    $e := p.nodes[n].a
    $k := 0
    while e >= 0 {
        v := w.own_val(p, tp, e, w.lower_expr(p, tp, e), ety)
        ea := w.bin(BIN_ADD, out, w.konst(k * esize))
        if is_wide(tp, ety) {
            w.copy_mem(ea, v, esize)
        } else {
            w.store_ptr(ea, 0, v, width_of(tp, ety))
        }
        k += 1
        e = p.nodes[e].next
    }
    << out
}

// Append value v (of element type ety) to the array descriptor at d.
fn (w $&Lw) push_value(tp &types.TypedProgram, d int, v int, ety int) {
    $ea := v
    if !is_wide(tp, ety) {
        // Spare capacity: store in place; otherwise slice_push grows.
        esize := tp.size_of(ety)
        n := w.load_ptr(d, 8, 8)
        fast_b := w.new_block()
        slow_b := w.new_block()
        done_b := w.new_block()
        w.branch(w.bin(BIN_LT, n, w.load_ptr(d, 16, 8)), fast_b, slow_b)
        w.f.active_bb = fast_b
        slot := w.bin(BIN_ADD, w.load_ptr(d, 0, 8), w.bin(BIN_MUL, n, w.konst(esize)))
        w.store_ptr(slot, 0, v, width_of(tp, ety))
        w.store_ptr(d, 8, w.bin(BIN_ADD, n, w.konst(1)), 8)
        w.jump(done_b)
        w.f.active_bb = slow_b
        ea = w.scratch_words(1)
        w.store_ptr(ea, 0, v, 8)
        $sargs := []int{}
        sargs.push(d)
        sargs.push(ea)
        sargs.push(w.konst(esize))
        w.call_core("slice_push", &sargs)
        w.jump(done_b)
        w.f.active_bb = done_b
        <<
    }
    $args := []int{}
    args.push(d)
    args.push(ea)
    args.push(w.konst(tp.size_of(ety)))
    w.call_core("slice_push", &args)
}

// ===== calls =====

// Argument value for a parameter of type pty.
fn (w $&Lw) lower_arg(p &parser.Parser, tp &types.TypedProgram, arg int, pty int) int {
    if types.is_ref_type(pty) {
        if w.expr_is_ref(p, tp, arg) {
            << w.lower_expr(p, tp, arg)
        }
        << w.lower_addr(p, tp, arg)
    }
    // Builtins lowered to runtime ABI functions (str(&int) -> itoa) accept
    // a reference where the function takes the scalar.
    plain := pty == 1 || pty == 2 || pty == 8 || pty == 9 || pty == 10 || pty == 6 || pty == 7 || pty == 11 || pty == 12 || pty == 13 || pty == 14
    if plain && types.is_ref_type(tp.type_of(arg)) && w.expr_is_ref(p, tp, arg) {
        << w.load_ptr(w.lower_expr(p, tp, arg), 0, width_of(tp, pty))
    }
    << w.own_val(p, tp, arg, w.lower_expr(p, tp, arg), pty)
}

fn (w $&Lw) finish_call(tp &types.TypedProgram, callee int, args []int) int {
    if fn_throws(tp, callee) {
        << w.err_finish_call(tp, callee, &args)
    }
    rty := tp.fns[callee].ret
    label := tp.fns[callee].label
    if rty != 0 && is_wide(tp, rty) {
        out := w.scratch(tp, rty)
        $all := []int{}
        all.push(out)
        for i in 0:args.len {
            all.push(args[i])
        }
        w.call(label, &all)
        << out
    }
    << w.call(label, &args)
}

// Arguments starting at node arg for user function fi; the trailing
// arguments of a variadic function are packed into its []T parameter.
fn (w $&Lw) lower_call_args(p &parser.Parser, tp &types.TypedProgram, first int, fi int, skip int, args $&[]int) {
    $fixed := tp.fns[fi].params.len
    if tp.fns[fi].variadic {
        fixed -= 1
    }
    $arg := first
    $pi := skip
    while arg >= 0 && pi < fixed {
        args.push(w.lower_arg(p, tp, arg, tp.fns[fi].params[pi]))
        pi += 1
        arg = p.nodes[arg].next
    }
    if !tp.fns[fi].variadic {
        <<
    }
    pack := w.scratch_words(3)
    w.zero_mem(pack, 24)
    ety := tp.elem_of(tp.fns[fi].params[fixed])
    while arg >= 0 {
        $v := w.lower_expr(p, tp, arg)
        if w.needs_drop(tp, ety) {
            v = w.own_val(p, tp, arg, v, ety)
        }
        w.push_value(tp, pack, v, ety)
        arg = p.nodes[arg].next
    }
    args.push(pack)
}

// Call of user function fi with the arguments of call node n.
fn (w $&Lw) lower_user_call(p &parser.Parser, tp &types.TypedProgram, n int, fi int) int {
    if tp.fns[fi].is_extern && tp.fns[fi].decl >= 0 {
        ffi := types.ffi_node_of(p, tp.fns[fi].decl)
        if ffi >= 0 { << w.lower_ffi_call(p, tp, n, fi, ffi) }
    }
    $args := []int{}
    w.lower_call_args(p, tp, p.nodes[n].a, fi, 0, $&args)
    << w.finish_call(tp, fi, args)
}

// `runtime.caller(skip)`: the checker resolves it to this call site, with
// the file in str_of and the line in local_of.
fn (w $&Lw) lower_caller_frame(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    out := w.scratch(tp, ty)
    si := types.struct_index(ty)
    si_file := tp.str_of(n)
    $file := ""
    if si_file >= 0 && si_file < tp.strings.len {
        file = tp.strings[si_file] + ""
    }
    for i in 0:tp.structs[si].fields.len {
        $v := w.konst(1)
        if tp.structs[si].fields[i].name == "file" {
            v = w.lower_str_lit(file)
        } else if tp.structs[si].fields[i].name == "line" {
            v = w.konst(tp.local_of(n))
        }
        w.store_value(tp, out, tp.structs[si].fields[i].offset, v, tp.structs[si].fields[i].ty)
    }
    << out
}

fn is_log_callsite(p &parser.Parser, tp &types.TypedProgram, n int, fi int) bool {
    if tp.fns[fi].mod_id != "log" {
        << false
    }
    want := p.nodes[n].sval + "_at"
    name := tp.fns[fi].name + ""
    if name.len < want.len || want.len == 3 {
        << false
    }
    << name[name.len - want.len:name.len] == want
}

// Call of user function or method fi from method-call node n.
fn (w $&Lw) lower_user_method_call(p &parser.Parser, tp &types.TypedProgram, n int, fi int) int {
    if tp.fns[fi].is_extern && tp.fns[fi].decl >= 0 {
        ffi := types.ffi_node_of(p, tp.fns[fi].decl)
        if ffi >= 0 { << w.lower_ffi_call(p, tp, n, fi, ffi) }
    }
    $args := []int{}
    // `pkg.f(...)` parses as a method call on the package name.
    if tp.fns[fi].recv >= 0 {
        args.push(w.base_addr(p, tp, p.nodes[n].a))
    }
    $skip := 0
    // The checker rewrites log.Logger print calls to their *_at form; the
    // call node carries the file (str_of) and line (local_of) arguments.
    if is_log_callsite(p, tp, n, fi) {
        si := tp.str_of(n)
        $file := ""
        if si >= 0 && si < tp.strings.len {
            file = tp.strings[si] + ""
        }
        args.push(w.lower_str_lit(file))
        args.push(w.konst(tp.local_of(n)))
        skip = 2
    }
    w.lower_call_args(p, tp, p.nodes[n].b, fi, skip, $&args)
    << w.finish_call(tp, fi, args)
}

fn (w $&Lw) lower_call(p &parser.Parser, tp &types.TypedProgram, n int) int {
    code := tp.call_of(n)
    if code >= 0 {
        << w.lower_user_call(p, tp, n, code)
    }
    if code == -2 || code == -7 {
        $fd := 1
        if code == -7 {
            fd = 2
        }
        arg := p.nodes[n].a
        aty := tp.deref(tp.deref(tp.type_of(arg)))
        $args := []int{}
        args.push(w.konst(fd))
        if aty == 3 {
            sd := w.base_addr(p, tp, arg)
            args.push(sd)
            args.push(w.konst(1))
            w.call_core("print_desc", &args)
            w.drop_fresh_str(p, tp, arg, sd)
        } else {
            $v := w.lower_expr(p, tp, arg)
            if w.expr_is_ref(p, tp, arg) {
                v = w.load_ptr(v, 0, width_of(tp, aty))
            }
            if types.is_float_type(aty) {
                if aty == 14 { v = w.float_un(UN_F32_LOAD, v) }
                w.float_print(fd, v)
                << w.konst(0)
            }
            args.push(v)
            args.push(w.konst(1))
            if aty == 2 {
                w.call_core("print_bool", &args)
            } else if aty == 13 {
                w.call_core("print_u64", &args)
            } else {
                w.call_core("print_int", &args)
            }
        }
        << w.konst(0)
    }
    if code == -13 {
        $args := []int{}
        args.push(w.lower_expr(p, tp, p.nodes[n].a))
        w.call_core("exit_process", &args)
        << w.konst(0)
    }
    if code == -19 {
        << w.lower_expr(p, tp, p.nodes[n].a)
    }
    if code == -101 {
        << w.konst(w.tgt_os)
    }
    if code == -103 {
        << w.konst(w.tgt_arch)
    }
    if code == types.NCALL_RT_SYSCALL {
        $args := []int{}
        $arg := p.nodes[n].a
        while arg >= 0 {
            args.push(w.lower_expr(p, tp, arg))
            arg = p.nodes[arg].next
        }
        << w.call("__xu_syscall", &args)
    }
    if code == types.NCALL_RT_LOAD || code == types.NCALL_RT_STORE {
        a0 := p.nodes[n].a
        a1 := p.nodes[a0].next
        if p.nodes[a1].kind != ast.NK_INT {
            w.fail(p, n, "rt_load/rt_store width must be a literal")
            << w.konst(0)
        }
        width := p.nodes[a1].ival
        addr := w.lower_expr(p, tp, a0)
        if code == types.NCALL_RT_LOAD {
            << w.load_ptr(addr, 0, width)
        }
        v := w.lower_expr(p, tp, p.nodes[a1].next)
        w.store_ptr(addr, 0, v, width)
        << w.konst(0)
    }
    if code == -35 || code == -36 {
        addr := w.lower_expr(p, tp, p.nodes[n].a)
        $w_load := 4
        if code == -36 { w_load = 1 }
        << w.volatile_load(addr, 0, w_load)
    }
    if code == -33 || code == -34 {
        a0 := p.nodes[n].a
        a1 := p.nodes[a0].next
        addr := w.lower_expr(p, tp, a0)
        val := w.lower_expr(p, tp, a1)
        $w_store := 4
        if code == -34 { w_store = 1 }
        w.volatile_store(addr, 0, val, w_store)
        << w.konst(0)
    }
    if code == -160 {
        addr := w.lower_expr(p, tp, p.nodes[n].a)
        rty := tp.type_of(n)
        width := width_of(tp, rty)
        << w.volatile_load(addr, 0, width)
    }
    if code == -161 {
        a0 := p.nodes[n].a
        a1 := p.nodes[a0].next
        addr := w.lower_expr(p, tp, a0)
        val := w.lower_expr(p, tp, a1)
        vty := tp.type_of(a1)
        width := width_of(tp, vty)
        w.volatile_store(addr, 0, val, width)
        << w.konst(0)
    }
    if code == types.NCALL_RT_ADDR {
        << w.lower_expr(p, tp, p.nodes[n].a)
    }
    if code == -106 {
        $none := []int{}
        w.call_core("record_test_failure", &none)
        << w.konst(0)
    }
    if code == -108 {
        // Short mode is only set by the test runner.
        << w.konst(0)
    }
    if code == types.NCALL_C_CALLBACK {
        $no_free := [-999999]
        << w.lower_c_callback_ref(p, tp, p.nodes[n].a, 0, $&no_free)
    }
    if code == types.NCALL_C_CALLBACK_FREE {
        w.free_closure_cb(tp, w.lower_expr(p, tp, p.nodes[n].a))
        << w.konst(0)
    }
    if code == types.NCALL_RT_GLOBALS {
        << w.call_noargs("__xu_globals")
    }
    $r := w.err_call(p, tp, n, code)
    if r == NOT_HANDLED { r = w.host_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.float_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.enum_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.chan_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.fnval_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.iface_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.intrin_call(p, tp, n, code) }
    if r != NOT_HANDLED {
        << r
    }
    w.fail(p, n, "builtin '" + p.nodes[n].sval + "' (code " + str(code) + ") is not supported yet")
    << w.konst(0)
}

fn (w $&Lw) lower_method_call(p &parser.Parser, tp &types.TypedProgram, n int) int {
    code := tp.call_of(n)
    recv := p.nodes[n].a
    if code >= 0 {
        << w.lower_user_method_call(p, tp, n, code)
    }
    if code == -4 {
        d := w.base_addr(p, tp, recv)
        ety := tp.elem_of(tp.deref(tp.type_of(recv)))
        a := p.nodes[n].b
        v := w.own_val(p, tp, a, w.lower_expr(p, tp, a), ety)
        w.push_value(tp, d, v, ety)
        << w.konst(0)
    }
    if code == -170 {
        d := w.base_addr(p, tp, recv)
        need := w.lower_expr(p, tp, p.nodes[n].b)
        esize := tp.size_of(tp.elem_of(tp.deref(tp.type_of(recv))))
        $args := []int{}
        args.push(d)
        args.push(need)
        args.push(w.konst(esize))
        w.call_core("desc_reserve", &args)
        << w.konst(0)
    }
    if code == -171 {
        d := w.base_addr(p, tp, recv)
        need := w.lower_expr(p, tp, p.nodes[n].b)
        esize := tp.size_of(tp.elem_of(tp.deref(tp.type_of(recv))))
        done_rz := w.new_block()
        pos_rz := w.new_block()
        w.branch(w.bin(BIN_GE, need, w.konst(0)), pos_rz, done_rz)

        w.f.active_bb = pos_rz
        old_len := w.load_ptr(d, 8, 8)
        old_cap := w.load_ptr(d, 16, 8)
        grow_b := w.new_block()
        chk_zero_b := w.new_block()
        zero_b := w.new_block()
        setlen_b := w.new_block()
        w.branch(w.bin(BIN_GT, need, old_cap), grow_b, chk_zero_b)

        w.f.active_bb = grow_b
        $r_args := []int{}
        r_args.push(d)
        r_args.push(need)
        r_args.push(w.konst(esize))
        w.call_core("desc_reserve", &r_args)
        w.jump(setlen_b)

        w.f.active_bb = chk_zero_b
        w.branch(w.bin(BIN_GT, need, old_len), zero_b, setlen_b)

        w.f.active_bb = zero_b
        base_ptr := w.load_ptr(d, 0, 8)
        $off_b := w.bin(BIN_SUB, need, old_len)
        $z_ptr := base_ptr
        $z_bytes := off_b
        if esize == 1 {
            z_ptr = w.bin(BIN_ADD, base_ptr, old_len)
        } else {
            z_ptr = w.bin(BIN_ADD, base_ptr, w.bin(BIN_MUL, old_len, w.konst(esize)))
            z_bytes = w.bin(BIN_MUL, off_b, w.konst(esize))
        }
        $z_args := []int{}
        z_args.push(z_ptr)
        z_args.push(z_bytes)
        w.call_core("mem_zero", &z_args)
        w.jump(setlen_b)

        w.f.active_bb = setlen_b
        w.store_ptr(d, 8, need, 8)
        w.jump(done_rz)

        w.f.active_bb = done_rz
        << w.konst(0)
    }
    if code == -3 {
        d := w.base_addr(p, tp, recv)
        s := w.base_addr(p, tp, p.nodes[n].b)
        $args := []int{}
        args.push(d)
        args.push(s)
        w.call_core("str_push", &args)
        w.drop_fresh_str(p, tp, p.nodes[n].b, s)
        << w.konst(0)
    }
    if code == -110 {
        d := w.base_addr(p, tp, recv)
        v := w.lower_expr(p, tp, p.nodes[n].b)
        slen := w.load_ptr(d, 8, 8)
        total := w.bin(BIN_ADD, slen, w.konst(1))
        scap := w.load_ptr(d, 16, 8)
        fast_b := w.new_block()
        slow_b := w.new_block()
        done_b := w.new_block()
        w.branch(w.bin(BIN_LT, total, scap), fast_b, slow_b)
        w.f.active_bb = fast_b
        ptr := w.load_ptr(d, 0, 8)
        slot := w.bin(BIN_ADD, ptr, slen)
        w.store_ptr(slot, 0, v, 1)
        w.store_ptr(slot, 1, w.konst(0), 1)
        w.store_ptr(d, 8, total, 8)
        w.jump(done_b)
        w.f.active_bb = slow_b
        args := [d, v]
        w.call_core("str_push_byte", &args)
        w.jump(done_b)
        w.f.active_bb = done_b
        << w.konst(0)
    }
    if code == -75 || code == -76 {
        out := w.scratch_words(3)
        sd := w.base_addr(p, tp, recv)
        $args := []int{}
        args.push(out)
        args.push(sd)
        if code == -75 {
            w.call_core("str_bytes", &args)
        } else {
            w.call_core("str_runes", &args)
        }
        w.drop_fresh_str(p, tp, recv, sd)
        << out
    }
    if code == -70 {
        a := w.host_arg(p, tp, recv)
        b := w.host_arg(p, tp, p.nodes[n].b)
        if tp.deref(tp.deref(tp.type_of(recv))) == 4 {
            << w.bin(BIN_FLT, a, b)
        }
        << w.bin(BIN_LT, a, b)
    }
    if code == -71 {
        sa := w.base_addr(p, tp, recv)
        sb := w.base_addr(p, tp, p.nodes[n].b)
        $args := []int{}
        args.push(sa)
        args.push(sb)
        res := w.call_core("str_less", &args)
        w.drop_fresh_str(p, tp, recv, sa)
        w.drop_fresh_str(p, tp, p.nodes[n].b, sb)
        << res
    }
    if code == -97 {
        << w.lower_caller_frame(p, tp, n)
    }
    $r := w.err_method_call(p, tp, n, code)
    if r == NOT_HANDLED { r = w.host_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.float_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.enum_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.chan_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.map_method_call(p, tp, n, code) }
    if r != NOT_HANDLED {
        << r
    }
    w.fail(p, n, "builtin method '" + p.nodes[n].sval + "' (code " + str(code) + ") is not supported yet")
    << w.konst(0)
}

// ===== statements =====

fn (w $&Lw) lower_block(p &parser.Parser, tp &types.TypedProgram, head int) {
    mark := w.scope_ids.len
    moved := w.lmoved[0:w.lmoved.len]
    w.block_depth += 1
    $s := head
    while s >= 0 {
        w.ensure_open()
        if w.tensor_fusion {
            last := w.lower_tensor_fusion(p, tp, s)
            if last >= 0 {
                s = p.nodes[last].next
                ->
            }
        }
        if !w.affine_tile || !w.lower_affine_tile(p, tp, s) {
            w.lower_stmt(p, tp, s)
        }
        s = p.nodes[s].next
    }
    if w.scope_ids.len > mark {
        if w.open() {
            w.drop_owned_from(mark)
        }
        w.scope_truncate(mark)
    }
    w.block_depth -= 1
    if !w.open() {
        // Moves on a path that ended do not reach the code after the block.
        for i in 0:moved.len {
            w.lmoved[i] = moved[i]
        }
        <<
    }
    if w.block_depth == 0 {
        <<
    }
    // A nested block is a conditional arm or a loop body. When it falls
    // through having moved or re-assigned an outer local, the code after
    // it is also reached by paths that did not, so the static state is
    // wrong for one of them: track that local with a drop flag.
    for i in 0:mark {
        id := w.scope_ids[i]
        if id < moved.len && w.lmoved[id] != moved[id] && w.lowned[id] && w.flag_of(id) < 0 {
            w.note_dynamic(id)
        }
    }
}

fn (w $&Lw) store_to_local(tp &types.TypedProgram, id int, v int) {
    slot := w.ensure_local(tp, id)
    ty := w.local_type(tp, id)
    if is_wide(tp, ty) {
        w.copy_mem(w.local_addr(slot), v, tp.size_of(ty))
    } else if w.byref(slot) {
        w.store_ptr(w.load_local(slot, 0), 0, v, width_of(tp, ty))
    } else {
        w.store_local(slot, 0, v)
    }
}

fn (w $&Lw) declare_local(tp &types.TypedProgram, id int, shared_scope int) int {
    $sid := shared_scope
    if sid == 0 {
        sid = w.next_scope_id
        w.next_scope_id += 1
    }
    w.set_lscope(id, sid)
    slot := w.ensure_local(tp, id)
    w.set_slot_scope(slot, sid)
    << slot
}

fn (w $&Lw) lower_stmt(p &parser.Parser, tp &types.TypedProgram, s int) {
    k := p.nodes[s].kind
    if p.nodes[s].line > 0 {
        w.cur_line = p.nodes[s].line
    }
    if k == ast.NK_LET {
        id := tp.local_of(s)
        e := p.nodes[s].a
        $v := w.lower_expr(p, tp, e)
        if id >= 0 {
            v = w.own_val(p, tp, e, v, w.local_type(tp, id))
        }
        if id < 0 {
            w.fail(p, s, "unresolved binding '" + p.nodes[s].sval + "'")
            <<
        }
        $sid := 0
        if p.nodes[e].kind == ast.NK_BORROW {
            target := p.nodes[e].a
            if p.nodes[target].kind == ast.NK_IDENT {
                tid := tp.local_of(target)
                if tid >= 0 && tid < w.lscope.len && w.lscope[tid] > 0 {
                    sid = w.lscope[tid]
                }
            }
        }
        _ := w.declare_local(tp, id, sid)
        w.store_to_local(tp, id, v)
        w.own_declare(tp, id)
        <<
    }
    if k == ast.NK_ASSIGN {
        w.lower_assign(p, tp, s)
        <<
    }
    if k == ast.NK_EXPR_STMT {
        e := p.nodes[s].a
        $ety := tp.type_of(e)
        if e != w.unboxed && (w.iface_wants_box(tp, e) || w.err_wants_box(tp, e)) {
            ety = tp.box_of(e)
        }
        v := w.lower_expr(p, tp, e)
        // A statement discards its value: free a fresh one of any owning
        // type, not only resource types and concatenations.
        if w.needs_drop(tp, ety) && w.transfer_safe(p, tp, e) {
            $addr := v
            if !is_wide(tp, ety) {
                addr = w.scratch_words(1)
                w.store_ptr(addr, 0, v, width_of(tp, ety))
            }
            w.drop_value(tp, addr, ety)
        } else {
            w.drop_fresh_str(p, tp, e, v)
        }
        <<
    }
    if k == ast.NK_RETURN {
        a := p.nodes[s].a
        if w.okp >= 0 {
            w.err_return(p, tp, a)
            <<
        }
        if a < 0 {
            w.ret(w.konst(0))
            <<
        }
        $v := w.lower_expr(p, tp, a)
        if w.ret_ty != 0 && !types.is_ref_type(w.ret_ty) {
            v = w.own_val(p, tp, a, v, w.ret_ty)
        }
        if w.sret >= 0 {
            dst := w.load_local(w.sret, 0)
            w.copy_mem(dst, v, tp.size_of(w.ret_ty))
            w.ret(w.konst(0))
            <<
        }
        if w.expr_is_ref(p, tp, a) == false && types.is_ref_type(w.ret_ty) {
            w.ret(w.lower_addr(p, tp, a))
            <<
        }
        w.ret(v)
        <<
    }
    if k == ast.NK_IF {
        w.lower_if(p, tp, s)
        <<
    }
    if k == ast.NK_WHILE {
        cond_b := w.new_block()
        body_b := w.new_block()
        done_b := w.new_block()
        counter := w.new_loop_poll_counter()
        $step_b := cond_b
        if counter >= 0 {
            step_b = w.new_block()
        }
        w.jump(cond_b)
        w.f.active_bb = cond_b
        w.in_cond += 1
        c := w.lower_expr(p, tp, p.nodes[s].a)
        w.in_cond -= 1
        w.branch(c, body_b, done_b)
        w.loop_enter(done_b, step_b)
        w.f.active_bb = body_b
        w.lower_block(p, tp, p.nodes[s].c)
        w.jump(step_b)
        w.loop_depth -= 1
        if counter >= 0 {
            w.f.active_bb = step_b
            w.loop_poll(counter)
            w.jump(cond_b)
        }
        w.f.active_bb = done_b
        <<
    }
    if k == ast.NK_FOR {
        id := tp.local_of(s)
        slot := w.ensure_local(tp, id)
        lo := w.lower_expr(p, tp, p.nodes[s].a)
        w.store_local(slot, 0, lo)
        hi_slot := w.new_local(1, 1, "hi")
        w.store_local(hi_slot, 0, w.lower_expr(p, tp, p.nodes[s].b))
        cond_b := w.new_block()
        body_b := w.new_block()
        step_b := w.new_block()
        done_b := w.new_block()
        counter := w.new_loop_poll_counter()
        w.jump(cond_b)
        w.f.active_bb = cond_b
        iv := w.load_local(slot, 0)
        hv := w.load_local(hi_slot, 0)
        w.branch(w.bin(BIN_LT, iv, hv), body_b, done_b)
        w.loop_enter(done_b, step_b)
        w.f.active_bb = body_b
        w.lower_block(p, tp, p.nodes[s].c)
        w.jump(step_b)
        w.loop_depth -= 1
        w.f.active_bb = step_b
        nv := w.bin(BIN_ADD, w.load_local(slot, 0), w.konst(1))
        w.store_local(slot, 0, nv)
        w.loop_poll(counter)
        w.jump(cond_b)
        w.f.active_bb = done_b
        <<
    }
    if k == ast.NK_FOR_EACH {
        w.lower_for_each(p, tp, s)
        <<
    }
    if k == ast.NK_BREAK || k == ast.NK_CONTINUE {
        if w.loop_depth == 0 {
            w.fail(p, s, "break/continue outside a loop")
            <<
        }
        w.drop_owned_from(w.loop_scope[w.loop_depth - 1])
        if k == ast.NK_BREAK {
            w.jump(w.brk[w.loop_depth - 1])
        } else {
            w.jump(w.cont[w.loop_depth - 1])
        }
        <<
    }
    if k == ast.NK_EXIT {
        $args := []int{}
        args.push(w.lower_expr(p, tp, p.nodes[s].a))
        w.call_core("exit_process", &args)
        w.ret(w.konst(0))
        <<
    }
    if w.err_stmt(p, tp, s) || w.enum_stmt(p, tp, s) || w.chan_stmt(p, tp, s) {
        <<
    }
    w.fail(p, s, "statement " + types.ast_kind_name(k) + " is not supported yet")
}

fn (w $&Lw) lower_if(p &parser.Parser, tp &types.TypedProgram, s int) {
    done_b := w.new_block()
    $br := p.nodes[s].a
    while br >= 0 {
        cond := p.nodes[br].a
        if cond < 0 {
            w.lower_block(p, tp, p.nodes[br].b)
            w.jump(done_b)
            <-
        }
        w.in_cond += 1
        c := w.lower_expr(p, tp, cond)
        w.in_cond -= 1
        then_b := w.new_block()
        next_b := w.new_block()
        w.branch(c, then_b, next_b)
        w.f.active_bb = then_b
        w.lower_block(p, tp, p.nodes[br].b)
        w.jump(done_b)
        w.f.active_bb = next_b
        br = p.nodes[br].next
    }
    w.jump(done_b)
    w.f.active_bb = done_b
}

fn (w $&Lw) lower_for_each(p &parser.Parser, tp &types.TypedProgram, s int) {
    iter := p.nodes[s].a
    aty := tp.deref(tp.deref(tp.type_of(iter)))
    if types.is_map_type(aty) {
        w.map_for_each(p, tp, s)
        <<
    }
    if types.is_chan_type(aty) {
        w.chan_for_each(p, tp, s)
        <<
    }
    if !types.is_array_type(aty) {
        w.fail(p, s, "for-in over this type is not supported yet")
        <<
    }
    ety := tp.elem_of(aty)
    esize := tp.size_of(ety)
    d := w.array_desc(p, tp, iter, aty)
    dslot := w.new_local(1, 1, "it")
    w.store_local(dslot, 0, d)
    islot := w.new_local(1, 1, "i")
    w.store_local(islot, 0, w.konst(0))
    id := tp.local_of(s)
    cond_b := w.new_block()
    body_b := w.new_block()
    step_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    iv := w.load_local(islot, 0)
    nv := w.load_ptr(w.load_local(dslot, 0), 8, 8)
    w.branch(w.bin(BIN_LT, iv, nv), body_b, done_b)
    w.f.active_bb = body_b
    data := w.load_ptr(w.load_local(dslot, 0), 0, 8)
    ea := w.bin(BIN_ADD, data, w.bin(BIN_MUL, w.load_local(islot, 0), w.konst(esize)))
    if is_wide(tp, ety) {
        w.store_to_local(tp, id, ea)
    } else {
        w.store_to_local(tp, id, w.load_ptr(ea, 0, width_of(tp, ety)))
    }
    w.loop_enter(done_b, step_b)
    w.lower_block(p, tp, p.nodes[s].c)
    w.jump(step_b)
    w.loop_depth -= 1
    w.f.active_bb = step_b
    w.store_local(islot, 0, w.bin(BIN_ADD, w.load_local(islot, 0), w.konst(1)))
    w.jump(cond_b)
    w.f.active_bb = done_b
}

// Type of an assignment target. The checker does not record node types on
// every target, so derive it from the base value where needed.
fn (w $&Lw) place_type(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_IDENT && tp.local_of(n) >= 0 {
        << tp.deref(w.local_type(tp, tp.local_of(n)))
    }
    if (k == ast.NK_IDENT || k == ast.NK_FIELD) && tp.global_of(n) >= 0 {
        << tp.deref(tp.globals[tp.global_of(n)].ty)
    }
    if k == ast.NK_FIELD || k == ast.NK_INDEX {
        bty := tp.deref(tp.deref(w.place_type(p, tp, p.nodes[n].a)))
        if k == ast.NK_FIELD && types.is_struct_type(bty) {
            fname := p.nodes[n].sval + ""
            fld := tp.field_of(bty, &fname)
            if fld.offset >= 0 {
                << tp.deref(fld.ty)
            }
        }
        if k == ast.NK_INDEX {
            if bty == 3 {
                << 10
            }
            if types.is_array_type(bty) {
                << tp.deref(tp.elem_of(bty))
            }
        }
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_DEREF {
        << tp.deref_ptr(w.place_type(p, tp, p.nodes[n].a))
    }
    << tp.deref(tp.type_of(n))
}

fn (w $&Lw) lower_assign(p &parser.Parser, tp &types.TypedProgram, s int) {
    target := p.nodes[s].a
    aop := p.nodes[s].ival
    tk := p.nodes[target].kind
    tty := w.place_type(p, tp, target)
    // Assigning a reference to a reference-typed place rebinds it.
    if aop == ast.AS_ASSIGN && (tk == ast.NK_IDENT || tk == ast.NK_FIELD || tk == ast.NK_INDEX) && w.expr_is_ref(p, tp, target) && w.expr_is_ref(p, tp, p.nodes[s].b) {
        v := w.lower_expr(p, tp, p.nodes[s].b)
        if tk == ast.NK_IDENT && tp.local_of(target) >= 0 {
            w.store_local(w.ensure_local(tp, tp.local_of(target)), 0, v)
        } else {
            w.store_ptr(w.lower_place_addr(p, tp, target), 0, v, 8)
        }
        <<
    }
    if tk == ast.NK_IDENT && tp.local_of(target) >= 0 && !types.is_ref_type(w.local_type(tp, tp.local_of(target))) {
        id := tp.local_of(target)
        lty := w.local_type(tp, id)
        if lty == 3 && aop == ast.AS_ADD {
            slot := w.ensure_local(tp, id)
            d := w.local_addr(slot)
            rhs := w.base_addr(p, tp, p.nodes[s].b)
            $args := []int{}
            args.push(d)
            args.push(rhs)
            w.call_core("str_push", &args)
            w.drop_fresh_str(p, tp, p.nodes[s].b, rhs)
            <<
        }
        $v := w.own_val(p, tp, p.nodes[s].b, w.lower_expr(p, tp, p.nodes[s].b), lty)
        if aop > ast.AS_ASSIGN {
            old := w.lower_ident(p, tp, target)
            v = w.checked_bin(assign_op_code(lty, aop), old, v, lty)
        }
        flag := w.flag_of(id)
        if aop == ast.AS_ASSIGN && w.owns(id) {
            if flag >= 0 {
                then_b := w.new_block()
                next_b := w.new_block()
                w.branch(w.load_local(flag, 0), then_b, next_b)
                w.f.active_bb = then_b
                w.drop_value(tp, w.local_addr(w.ensure_local(tp, id)), lty)
                w.jump(next_b)
                w.f.active_bb = next_b
            } else if !w.lmoved[id] {
                w.drop_value(tp, w.local_addr(w.ensure_local(tp, id)), lty)
            }
        }
        w.store_to_local(tp, id, v)
        if w.owns(id) {
            if flag >= 0 {
                w.store_local(flag, 0, w.konst(1))
            } else {
                if w.outside_loop(id) && w.lmoved[id] {
                    w.note_dynamic(id)
                }
                w.lmoved[id] = false
            }
        }
        <<
    }
    if tk == ast.NK_INDEX && (tp.call_of(target) == -77 || tp.call_of(target) == -78) {
        w.map_assign(p, tp, s)
        <<
    }
    if tk == ast.NK_FIELD {
        bnode := p.nodes[target].a
        bty_bf := tp.deref(tp.deref(w.place_type(p, tp, bnode)))
        if types.is_struct_type(bty_bf) {
            fname_bf := p.nodes[target].sval + ""
            fld_bf := tp.field_of(bty_bf, &fname_bf)
            if fld_bf.offset >= 0 && fld_bf.bit_width > 0 {
                baddr := w.base_addr(p, tp, bnode)
                $v := w.lower_expr(p, tp, p.nodes[s].b)
                if aop > ast.AS_ASSIGN {
                    old := w.lower_bitfield_read(baddr, &fld_bf)
                    v = w.checked_bin(assign_op_code(tty, aop), old, v, tp.deref(tty))
                }
                w.lower_bitfield_write(baddr, &fld_bf, v)
                <<
            }
        }
    }
    if tk == ast.NK_INDEX {
        base_n := p.nodes[target].a
        bty := tp.deref(tp.deref(w.place_type(p, tp, base_n)))
        if tty == 3 && aop == ast.AS_ADD {
            rhs := w.base_addr(p, tp, p.nodes[s].b)
            idx := w.lower_expr(p, tp, p.nodes[target].b)
            d := w.array_desc(p, tp, base_n, bty)
            w.bounds_check(idx, w.load_ptr(d, 8, 8))
            elem_a := w.bin(BIN_ADD, w.load_ptr(d, 0, 8), w.bin(BIN_MUL, idx, w.konst(tp.size_of(tty))))
            $args := []int{}
            args.push(elem_a)
            args.push(rhs)
            w.call_core("str_push", &args)
            w.drop_fresh_str(p, tp, p.nodes[s].b, rhs)
            <<
        }
        // Evaluate index and RHS before loading destination element address so
        // mutations during RHS evaluation (e.g. slice growth) cannot dangle.
        idx := w.lower_expr(p, tp, p.nodes[target].b)
        $v := w.own_val(p, tp, p.nodes[s].b, w.lower_expr(p, tp, p.nodes[s].b), tty)
        d := w.array_desc(p, tp, base_n, bty)
        if bty == 3 {
            $sargs := []int{}
            sargs.push(d)
            w.call_core("str_ensure_owned", &sargs)
        }
        n_len := w.load_ptr(d, 8, 8)
        w.bounds_check(idx, n_len)
        data := w.load_ptr(d, 0, 8)
        $esize := 1
        $width := width_of(tp, tty)
        if bty == 3 {
            width = 1
        } else {
            esize = tp.size_of(tty)
        }
        $eaddr := data
        if esize == 1 {
            eaddr = w.bin(BIN_ADD, data, idx)
        } else {
            eaddr = w.bin(BIN_ADD, data, w.bin(BIN_MUL, idx, w.konst(esize)))
        }
        if aop == ast.AS_ASSIGN && w.needs_drop(tp, tty) {
            w.drop_value(tp, eaddr, tty)
        }
        if is_wide(tp, tty) {
            w.copy_mem(eaddr, v, tp.size_of(tty))
            <<
        }
        if aop > ast.AS_ASSIGN {
            old := w.load_ptr(eaddr, 0, width)
            v = w.checked_bin(assign_op_code(tty, aop), old, v, tp.deref(tty))
        }
        w.store_ptr(eaddr, 0, v, width)
        <<
    }
    $addr := -1
    if (tk == ast.NK_IDENT || tk == ast.NK_FIELD) && tp.global_of(target) >= 0 {
        addr = w.lower_global_addr(tp, tp.global_of(target))
    } else if tk == ast.NK_IDENT {
        addr = w.lower_addr(p, tp, target)
    } else if tk == ast.NK_FIELD || tk == ast.NK_INDEX {
        addr = w.lower_place_addr(p, tp, target)
    } else if tk == ast.NK_UN_OP && p.nodes[target].ival == ast.UN_DEREF {
        addr = w.lower_expr(p, tp, p.nodes[target].a)
    } else {
        w.fail(p, s, "assignment target " + types.ast_kind_name(tk) + " is not supported yet")
        <<
    }
    $width := width_of(tp, tty)
    if tk == ast.NK_INDEX && tp.deref(tp.deref(tp.type_of(p.nodes[target].a))) == 3 {
        width = 1
    }
    if tty == 3 && aop == ast.AS_ADD {
        rhs := w.base_addr(p, tp, p.nodes[s].b)
        $args := []int{}
        args.push(addr)
        args.push(rhs)
        w.call_core("str_push", &args)
        w.drop_fresh_str(p, tp, p.nodes[s].b, rhs)
        <<
    }
    $v := w.own_val(p, tp, p.nodes[s].b, w.lower_expr(p, tp, p.nodes[s].b), tty)
    if aop == ast.AS_ASSIGN && w.needs_drop(tp, tty) {
        w.drop_value(tp, addr, tty)
    }
    if is_wide(tp, tty) {
        w.copy_mem(addr, v, tp.size_of(tty))
        <<
    }
    if aop > ast.AS_ASSIGN {
        old := w.load_ptr(addr, 0, width)
        v = w.checked_bin(assign_op_code(tty, aop), old, v, tp.deref(tty))
    }
    w.store_ptr(addr, 0, v, width)
    if tk == ast.NK_UN_OP && p.nodes[target].ival == ast.UN_DEREF {
        $sid := 0
        if addr >= 0 && addr < w.temp_scope.len && w.temp_scope[addr] > 0 {
            sid = w.temp_scope[addr]
        }
        if sid == 0 && p.nodes[target].a >= 0 && p.nodes[p.nodes[target].a].kind == ast.NK_IDENT {
            aid := tp.local_of(p.nodes[target].a)
            if aid >= 0 && aid < w.lscope.len && w.lscope[aid] > 0 {
                sid = w.lscope[aid]
            }
        }
        if sid > 0 {
            last_i := w.f.instrs.len - 1
            if last_i >= 0 && w.f.instrs[last_i].kind == MI_STORE_PTR {
                w.f.instrs[last_i].scope_id = sid
            }
        }
    }
}

// ===== functions =====

// Lower function fi. A pass that finds locals needing a drop flag (see
// Lw.dyn_ids) is repeated with those locals flagged from their declaration,
// because the drops it already emitted for them were unconditional.
fn lower_fn(p &parser.Parser, tp $&types.TypedProgram, fi int, tgt_os int, tgt_arch int, debug bool, task_poll bool, affine_tile bool, tensor_fusion bool, tensor_fast_math bool, core_names &[]string, core_labels &[]string, errs $&[]int) MFn {
    $dyn := []int{}
    $pass := 0
    while true {
        $found := []int{}
        $perrs := []int{}
        f := lower_fn_pass(p, tp, fi, tgt_os, tgt_arch, debug, task_poll, affine_tile, tensor_fusion, tensor_fast_math, core_names, core_labels, &dyn, $&found, $&perrs)
        $nerr := 0
        for i in 0:perrs.len {
            nerr += perrs[i]
        }
        $grew := false
        for i in 0:found.len {
            $known := false
            for j in 0:dyn.len {
                if dyn[j] == found[i] {
                    known = true
                }
            }
            if !known {
                dyn.push(found[i])
                grew = true
            }
        }
        pass += 1
        // A pass with errors has reported them; a third repeat means the
        // set did not settle, and the locals it left unflagged are leaked.
        if !grew || nerr > 0 || pass >= 4 {
            errs.push(nerr)
            << f
        }
    }
    << mfn_new("", "")
}

fn lower_fn_pass(p &parser.Parser, tp $&types.TypedProgram, fi int, tgt_os int, tgt_arch int, debug bool, task_poll bool, affine_tile bool, tensor_fusion bool, tensor_fast_math bool, core_names &[]string, core_labels &[]string, dyn &[]int, found $&[]int, errs $&[]int) MFn {
    tp.use_fn(fi)
    $w := lw_new(tp.fns[fi].name, tp.fns[fi].label, fi, tgt_os, tgt_arch)
    for i in 0:dyn.len {
        w.dyn_ids.push(dyn[i])
    }
    for i in 0:core_names.len {
        w.core_names.push(core_names[i] + "")
        w.core_labels.push(core_labels[i] + "")
    }
    tfn := ~tp.fns[fi]
    w.task_poll = task_poll
    w.poll_loops = task_poll && (tfn.mod_id == "" || tfn.mod_id == "main")
    w.affine_tile = affine_tile && !w.poll_loops
    w.tensor_fusion = tensor_fusion && !w.poll_loops
    w.tensor_fast_math = tensor_fast_math && !w.poll_loops
    w.ret_ty = tfn.ret
    w.f.ret = tfn.ret
    if tfn.decl >= 0 && tfn.decl < p.nodes.len {
        w.f.src_file = p.node_file(tfn.decl)
        w.f.src_line = p.nodes[tfn.decl].line
        w.cur_line = w.f.src_line
    }
    w.f.blocks.push(mblock_new())
    w.f.active_bb = 0
    // Incoming words: [okp | sret] [receiver] params.
    if fn_throws(tp, fi) {
        w.okp = w.new_local(1, 1, "okp")
    } else if tfn.ret != 0 && is_wide(tp, tfn.ret) {
        w.sret = w.new_local(1, 1, "sret")
    }
    $nin := 0
    if tfn.recv >= 0 {
        nin = 1
    }
    nin += tfn.params.len
    $incoming := []int{}
    for i in 0:nin {
        incoming.push(w.new_local(1, 1, "arg" + str(i)))
    }
    w.f.nparams = w.f.locals.len
    w.f.scalar_params = w.okp < 0 && w.sret < 0 && tfn.recv < 0
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    for i in 0:nin {
        ty := w.local_type(tp, i)
        sid := w.next_scope_id
        w.next_scope_id += 1
        w.set_lscope(i, sid)
        w.set_slot_scope(incoming[i], sid)
        if ty != 1 { w.f.scalar_params = false }
        while w.lslot.len <= i {
            w.lslot.push(-1)
        }
        if i == 0 && tfn.recv >= 0 && !types.is_ref_type(ty) {
            w.lslot[i] = incoming[i]
            w.lbyref[incoming[i]] = true
        } else if is_wide(tp, ty) {
            slot := w.ensure_local(tp, i)
            w.set_slot_scope(slot, sid)
            src := w.load_local(incoming[i], 0)
            w.copy_mem(w.addr_local(slot), src, tp.size_of(ty))
            w.own_declare(tp, i)
            w.f.param_locals.push(slot)
        } else {
            w.lslot[i] = incoming[i]
            if i < tfn.local_names.len {
                w.f.local_names[incoming[i]] = tfn.local_names[i] + ""
            }
            w.f.param_locals.push(incoming[i])
            // A one-word owner (a map) passed by value belongs to the callee.
            if !types.is_ref_type(ty) && w.needs_drop(tp, ty) {
                w.own_declare(tp, i)
            }
        }
    }
    if debug && w.f.label == "_xu_main" {
        $none := []int{}
        w.call_core("debug_free_enable", &none)
    }
    w.lower_block(p, tp, p.nodes[tfn.decl].c)
    w.ret(w.konst(0))
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    for i in 0:w.dyn_found.len {
        found.push(w.dyn_found[i])
    }
    errs.push(w.errors)
    << mfn_copy(&w.f)
}

// Lower every concrete function. Returns the number of reported errors.
// all=true lowers every concrete function (diagnostics for coverage gaps).
// debug: a debug build; main enables the runtime's memory checks.
pub fn lower_typed(p &parser.Parser, tp $&types.TypedProgram, tgt_os int, tgt_arch int, all bool, debug bool, task_poll bool, affine_tile bool, tensor_fusion bool, tensor_fast_math bool, roots &[]int, out $&Mir) int {
    $core_names := []string{}
    $core_labels := []string{}
    for i in 0:tp.fns.len {
        if tp.fns[i].mod_id == "runtime/core" && tp.fns[i].recv < 0 {
            core_names.push(tp.fns[i].name + "")
            core_labels.push(tp.fns[i].label + "")
        }
    }
    err_collect_boxes(p, tp)
    // Lower on demand from main: a function is lowered once some lowered
    // body calls its label, so unused library code is never required to
    // be lowerable.
    resource_types := resource_drop_types(tp)
    clone_types := clone_glue_types(tp)
    nglue := resource_types.len + clone_types.len
    $by_label := label_index_new(tp.fns.len * 2 + nglue * 2 + 16)
    for fi in 0:tp.fns.len {
        if tp.fns[fi].is_template || tp.fns[fi].is_extern || tp.fns[fi].decl < 0 {
            ->
        }
        by_label.put(tp.fns[fi].label, fi)
    }
    // Queue keys: user function, fn-value shim, then typed resource glue.
    for ri in 0:resource_types.len {
        label := resource_drop_label(resource_types[ri])
        by_label.put(&label, tp.fns.len * 2 + ri)
    }
    for ci in 0:clone_types.len {
        label := clone_glue_label(clone_types[ci])
        by_label.put(&label, tp.fns.len * 2 + resource_types.len + ci)
    }
    $queued := []bool{}
    for fi in 0:tp.fns.len * 2 + nglue {
        queued.push(false)
    }
    $queue := []int{}
    main_label := "_xu_main"
    main_fi := by_label.get(&main_label)
    if main_fi >= 0 {
        queue.push(main_fi)
        queued[main_fi] = true
    }
    for fi in roots {
        if !queued[fi] {
            queue.push(fi)
            queued[fi] = true
        }
    }
    // On WASI the backend's system call stub hands Linux system calls to
    // the runtime's emulation, which no Xu code calls by name.
    if tgt_os == 4 {
        sys_label := "_xu_runtime_core_wasi_sys"
        sys_fi := by_label.get(&sys_label)
        if sys_fi >= 0 && !queued[sys_fi] {
            queue.push(sys_fi)
            queued[sys_fi] = true
        }
    }
    // 32-bit backends call these for f64 arithmetic and 64-bit division.
    if tgt_arch == 2 || tgt_arch == 3 || tgt_arch == 6 {
        helpers := ["sf_add", "sf_sub", "sf_mul", "sf_div", "sf_eq", "sf_lt", "sf_le", "sf_from_int", "sf_to_int", "sf_div64", "sf_mod64"]
        for hi in 0:helpers.len {
            h_label := "_xu_runtime_core_" + helpers[hi]
            h_fi := by_label.get(&h_label)
            if h_fi >= 0 && !queued[h_fi] {
                queue.push(h_fi)
                queued[h_fi] = true
            }
        }
    }
    if all {
        for fi in 0:tp.fns.len {
            if !queued[fi] && by_label.get(&tp.fns[fi].label) == fi {
                queued[fi] = true
                queue.push(fi)
            }
        }
    }
    $errs := []int{}
    $qi := 0
    while qi < queue.len {
        fi := queue[qi]
        qi += 1
        $f := mfn_new("", "")
        if fi >= tp.fns.len * 2 + resource_types.len {
            f = lower_clone_glue(tp, clone_types[fi - tp.fns.len * 2 - resource_types.len], tgt_os, tgt_arch, &core_names, &core_labels)
        } else if fi >= tp.fns.len * 2 {
            f = lower_resource_drop(tp, resource_types[fi - tp.fns.len * 2], tgt_os, tgt_arch, &core_names, &core_labels)
        } else {
            f = lower_queued(p, tp, fi, tgt_os, tgt_arch, debug, task_poll, affine_tile, tensor_fusion, tensor_fast_math, &core_names, &core_labels, $&errs)
        }
        $scan_pos := out.fns.len
        out.fns.push(f)
        while scan_pos < out.fns.len {
            cur_fn := scan_pos
            scan_pos += 1
            n_instrs := out.fns[cur_fn].instrs.len
            for ii in 0:n_instrs {
                ik := out.fns[cur_fn].instrs[ii].kind
                if ik == MI_CALL || ik == MI_LOAD_FN_ADDR {
                    sval := out.fns[cur_fn].instrs[ii].sval + ""
                    $callee := by_label.get(sval)
                    if callee < 0 && ffi_is_thunk(&sval) {
                        callee = ffi_thunk_request(tp, &by_label, &sval, tgt_os, tgt_arch, &core_names, &core_labels, out)
                    }
                    if callee < 0 && ffi_is_sig_adapter(&sval) {
                        ffi_sig_adapter_request(tp, &sval, tgt_os, tgt_arch, &core_names, &core_labels, out)
                    }
                    if callee < 0 {
                        callee = fnval_shim_key(tp, &by_label, sval)
                    }
                    if callee >= 0 && !queued[callee] {
                        queued[callee] = true
                        queue.push(callee)
                    }
                }
            }
        }
    }
    $errors := 0
    for ei in 0:errs.len {
        errors += errs[ei]
    }
    << errors
}

fn (w $&Lw) call_noargs(label string) int {
    $none := []int{}
    << w.call(label, &none)
}

fn (w $&Lw) loop_enter(brk_b int, cont_b int) {
    if w.loop_depth < w.brk.len {
        w.brk[w.loop_depth] = brk_b
        w.cont[w.loop_depth] = cont_b
        w.loop_scope[w.loop_depth] = w.scope_ids.len
    } else {
        w.brk.push(brk_b)
        w.cont.push(cont_b)
        w.loop_scope.push(w.scope_ids.len)
    }
    w.loop_depth += 1
}

fn mfn_copy(f &MFn) MFn {
    $out := mfn_new(f.name + "", f.label + "")
    out.ret = f.ret
    out.ret_nslots = f.ret_nslots
    out.nparams = f.nparams
    out.scalar_params = f.scalar_params
    out.receiver = f.receiver
    out.is_extern = f.is_extern
    out.is_pub = f.is_pub
    for i in 0:f.local_names.len {
        out.local_names.push(f.local_names[i] + "")
    }
    for i in 0:f.locals.len {
        out.locals.push(f.locals[i])
        out.locals_nslots.push(f.locals_nslots[i])
        out.locals_owning.push(f.locals_owning[i])
    }
    for i in 0:f.temps.len {
        out.temps.push(f.temps[i])
        out.temps_nslots.push(f.temps_nslots[i])
    }
    for i in 0:f.instrs.len {
        $ins := minstr_new(f.instrs[i].kind)
        ins.a = f.instrs[i].a
        ins.b = f.instrs[i].b
        ins.c = f.instrs[i].c
        ins.d = f.instrs[i].d
        ins.sval = f.instrs[i].sval + ""
        ins.next = f.instrs[i].next
        ins.line = f.instrs[i].line
        ins.col = f.instrs[i].col
        ins.file = f.instrs[i].file
        ins.scope_id = f.instrs[i].scope_id
        out.instrs.push(ins)
    }
    for i in 0:f.margs.len {
        out.margs.push(MArg{v: f.margs[i].v, next: f.margs[i].next})
    }
    for i in 0:f.blocks.len {
        $b := mblock_new()
        b.head = f.blocks[i].head
        b.tail = f.blocks[i].tail
        b.tkind = f.blocks[i].tkind
        b.ta = f.blocks[i].ta
        b.tb = f.blocks[i].tb
        b.tc = f.blocks[i].tc
        b.line = f.blocks[i].line
        b.keep_branch = f.blocks[i].keep_branch
        out.blocks.push(b)
    }
    for i in 0:f.consts.len {
        out.consts.push(f.consts[i])
    }
    out.active_bb = f.active_bb
    out.src_file = f.src_file
    out.src_line = f.src_line
    for i in 0:f.param_locals.len {
        out.param_locals.push(f.param_locals[i])
    }
    << out
}

// Open-addressing string -> int index (labels to function ids).
struct LabelIndex {
    keys []string
    vals []int
    used []bool
    mask int
}

fn label_index_new(min_cap int) LabelIndex {
    $cap := 16
    while cap < min_cap * 2 {
        cap = cap * 2
    }
    $li := LabelIndex{keys: []string{}, vals: []int{}, used: []bool{}, mask: cap - 1}
    for i in 0:cap {
        li.keys.push("")
        li.vals.push(-1)
        li.used.push(false)
    }
    << li
}

fn label_hash(s &string) int {
    $h := 5381
    for i in 0:s.len {
        h = (h * 33 + s[i]) & 0x3fffffff
    }
    << h
}

fn (li $&LabelIndex) put(key &string, v int) {
    $i := label_hash(key) & li.mask
    while li.used[i] && li.keys[i] != *key {
        i = (i + 1) & li.mask
    }
    li.used[i] = true
    li.keys[i] = *key + ""
    li.vals[i] = v
}

fn (li &LabelIndex) get(key &string) int {
    $i := label_hash(key) & li.mask
    while li.used[i] {
        if li.keys[i] == *key {
            << li.vals[i]
        }
        i = (i + 1) & li.mask
    }
    << -1
}


// u64 operations whose signed form differs: unsigned compare, division,
// remainder and logical shift right. NOT_HANDLED for the shared ones.
fn (w $&Lw) u64_bin(code int, a int, b int) int {
    if code >= BIN_LT && code <= BIN_GE {
        bias := w.bin(BIN_SHL, w.konst(1), w.konst(63))
        << w.bin(code, w.bin(BIN_XOR, a, bias), w.bin(BIN_XOR, b, bias))
    }
    if code == BIN_DIV || code == BIN_MOD {
        w.panic_if(w.bin(BIN_EQ, b, w.konst(0)), 3)
        $args := []int{}
        args.push(a)
        args.push(b)
        q := w.call_core("u64_div", &args)
        if code == BIN_DIV { << q }
        << w.bin(BIN_SUB, a, w.bin(BIN_MUL, q, b))
    }
    if code == BIN_SHR {
        // (a >> s) & ~(-1 << (64 - s)) for 0 < s < 64; s == 0 keeps a.
        s := w.bin(BIN_AND, b, w.konst(63))
        shifted := w.bin(BIN_SHR, a, s)
        mask := w.bin(BIN_XOR, w.bin(BIN_SHL, w.bin(BIN_SHL, w.konst(-1), w.bin(BIN_SUB, w.konst(63), s)), w.konst(1)), w.konst(-1))
        << w.bin(BIN_AND, shifted, mask)
    }
    << NOT_HANDLED
}
