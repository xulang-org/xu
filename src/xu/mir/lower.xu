@xu/mir
// AST to MIR lowering pass.
//
// Layer 3 module: lowers front-end AST and Parser node pools into clean,
// deterministic SSA/linear MIR functions without Checker/Sema coupling.

#xu/ast
#xu/parser

struct LowerEnv {
    names []string
    slots []int
}

fn lower_env_new() LowerEnv {
    << LowerEnv{
        names: []string{},
        slots: []int{}
    }
}

fn (env $&LowerEnv) bind(name string, slot int) {
    env.names.push(~name)
    env.slots.push(slot)
}

fn (env &LowerEnv) lookup(name string) int {
    $i := env.names.len - 1
    while i >= 0 {
        if env.names[i] == name {
            << env.slots[i]
        }
        i -= 1
    }
    << -1
}

fn emit_instr(mfn $&MFn, ins MInstr) int {
    idx := mfn.instrs.len
    mfn.instrs.push(ins)

    cur_bi := mfn.active_bb
    if cur_bi >= 0 && cur_bi < mfn.blocks.len {
        if mfn.blocks[cur_bi].head < 0 {
            mfn.blocks[cur_bi].head = idx
            mfn.blocks[cur_bi].tail = idx
        } else {
            last_idx := mfn.blocks[cur_bi].tail
            mfn.instrs[last_idx].next = idx
            mfn.blocks[cur_bi].tail = idx
        }
    }
    << idx
}

fn alloc_temp(mfn $&MFn) int {
    tid := mfn.temps.len
    mfn.temps.push(1)
    mfn.temps_nslots.push(1)
    << tid
}

fn alloc_const(mfn $&MFn, val int) int {
    for i in 0:mfn.consts.len {
        if mfn.consts[i] == val {
            << 0 - i - 2
        }
    }
    cidx := mfn.consts.len
    mfn.consts.push(val)
    << 0 - cidx - 2
}

fn lower_expr(mfn $&MFn, nodes &[]ast.Node, nid int, env &LowerEnv) int {
    if nid < 0 || nid >= nodes.len {
        << -1
    }

    k := nodes[nid].kind
    if k == ast.NK_INT {
        << alloc_const(mfn, nodes[nid].ival)
    }

    if k == ast.NK_IDENT {
        slot := env.lookup(nodes[nid].sval)
        if slot >= 0 {
            t := alloc_temp(mfn)
            $ins := minstr_new(MI_LOAD_LOCAL)
            ins.a = t
            ins.b = slot
            emit_instr(mfn, ins)
            << t
        }
        << -1
    }

    if k == ast.NK_CALL {
        fn_name := nodes[nid].sval
        callee_sym := "_" + fn_name

        $arg_node := nodes[nid].a
        $head_marg := -1
        $last_marg := -1
        while arg_node >= 0 && arg_node < nodes.len {
            arg_val := lower_expr(mfn, nodes, arg_node, env)
            mid := mfn.margs.len
            mfn.margs.push(MArg{
                v: arg_val,
                next: -1
            })
            if head_marg < 0 {
                head_marg = mid
            } else {
                mfn.margs[last_marg].next = mid
            }
            last_marg = mid
            arg_node = nodes[arg_node].next
        }

        dest := alloc_temp(mfn)
        $ins := minstr_new(MI_CALL)
        ins.a = dest
        ins.c = head_marg
        ins.sval = callee_sym
        emit_instr(mfn, ins)
        << dest
    }

    if k == ast.NK_BIN_OP {
        lhs := lower_expr(mfn, nodes, nodes[nid].a, env)
        rhs := lower_expr(mfn, nodes, nodes[nid].b, env)

        $op_code := BIN_ADD
        ast_op := nodes[nid].ival
        if ast_op == 1 {
            op_code = BIN_ADD
        } else if ast_op == 2 {
            op_code = BIN_SUB
        } else if ast_op == 3 {
            op_code = BIN_MUL
        } else if ast_op == 4 {
            op_code = BIN_DIV
        } else if ast_op == 6 {
            op_code = BIN_EQ
        } else if ast_op == 7 {
            op_code = BIN_NE
        } else if ast_op == 8 {
            op_code = BIN_LT
        } else if ast_op == 9 {
            op_code = BIN_LE
        } else if ast_op == 10 {
            op_code = BIN_GT
        } else if ast_op == 11 {
            op_code = BIN_GE
        } else if ast_op == 12 || ast_op == 14 {
            op_code = BIN_AND
        } else if ast_op == 13 || ast_op == 15 {
            op_code = BIN_OR
        }

        dest := alloc_temp(mfn)
        $ins := minstr_new(MI_BIN)
        ins.a = dest
        ins.b = op_code
        ins.c = lhs
        ins.d = rhs
        emit_instr(mfn, ins)
        << dest
    }

    << -1
}

pub fn lower_parser(p &parser.Parser) Mir {
    $unit := mir_new()

    for di in 0:p.decls.len {
        d_idx := p.decls[di]
        if d_idx < 0 || d_idx >= p.nodes.len { -> }

        decl := ~p.nodes[d_idx]
        if decl.kind != ast.NK_FN { -> }

        fn_name := ~decl.sval
        $fn_label := "_" + fn_name
        if fn_name == "main" {
            fn_label = "_main"
        }

        $mfn := mfn_new(fn_name, fn_label)
        $env := lower_env_new()

        $prm_idx := decl.a
        while prm_idx >= 0 && prm_idx < p.nodes.len {
            prm := ~p.nodes[prm_idx]
            slot := mfn.locals.len
            mfn.locals.push(1)
            mfn.locals_nslots.push(1)
            mfn.locals_owning.push(false)
            mfn.local_names.push(~prm.sval)
            env.bind(prm.sval, slot)
            mfn.nparams += 1
            prm_idx = prm.next
        }

        $entry_bb := mblock_new()
        mfn.blocks.push(entry_bb)
        mfn.active_bb = 0

        $stmt_idx := decl.c
        while stmt_idx >= 0 && stmt_idx < p.nodes.len {
            s := ~p.nodes[stmt_idx]

            if s.kind == ast.NK_LET {
                val := lower_expr($&mfn, &p.nodes, s.a, &env)
                slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval)
                env.bind(s.sval, slot)

                $ins := minstr_new(MI_STORE_LOCAL)
                ins.a = slot
                ins.b = val
                emit_instr($&mfn, ins)
            } else if s.kind == ast.NK_ASSIGN {
                target_name := ~p.nodes[s.a].sval
                slot := env.lookup(target_name)
                val := lower_expr($&mfn, &p.nodes, s.b, &env)

                if slot >= 0 {
                    $ins := minstr_new(MI_STORE_LOCAL)
                    ins.a = slot
                    ins.b = val
                    emit_instr($&mfn, ins)
                }
            } else if s.kind == ast.NK_RETURN {
                ret_val := lower_expr($&mfn, &p.nodes, s.a, &env)
                cur_bb := mfn.active_bb
                if cur_bb >= 0 && cur_bb < mfn.blocks.len {
                    mfn.blocks[cur_bb].tkind = TKIND_RETURN
                    mfn.blocks[cur_bb].ta = ret_val
                }
            } else if s.kind == ast.NK_IF {
                cur_br := s.a
                if cur_br >= 0 && cur_br < p.nodes.len {
                    br_node := ~p.nodes[cur_br]
                    cond_val := lower_expr($&mfn, &p.nodes, br_node.a, &env)

                    cur_bb := mfn.active_bb

                    then_id := mfn.blocks.len
                    $then_bb := mblock_new()
                    mfn.blocks.push(then_bb)

                    $else_id := -1
                    if br_node.next >= 0 && br_node.next < p.nodes.len {
                        else_id = mfn.blocks.len
                        $else_bb := mblock_new()
                        mfn.blocks.push(else_bb)
                    }

                    merge_id := mfn.blocks.len
                    $merge_bb := mblock_new()
                    mfn.blocks.push(merge_bb)

                    mfn.blocks[cur_bb].tkind = TKIND_BRANCH
                    mfn.blocks[cur_bb].ta = cond_val
                    mfn.blocks[cur_bb].tb = then_id
                    if else_id >= 0 {
                        mfn.blocks[cur_bb].tc = else_id
                    } else {
                        mfn.blocks[cur_bb].tc = merge_id
                    }

                    // Lower then statements in then_bb
                    mfn.active_bb = then_id
                    $then_stmt := br_node.b
                    while then_stmt >= 0 && then_stmt < p.nodes.len {
                        ts := ~p.nodes[then_stmt]
                        if ts.kind == ast.NK_LET {
                            val := lower_expr($&mfn, &p.nodes, ts.a, &env)
                            slot := mfn.locals.len
                            mfn.locals.push(1)
                            mfn.locals_nslots.push(1)
                            mfn.locals_owning.push(false)
                            mfn.local_names.push(~ts.sval)
                            env.bind(ts.sval, slot)
                            $ins := minstr_new(MI_STORE_LOCAL)
                            ins.a = slot
                            ins.b = val
                            emit_instr($&mfn, ins)
                        } else if ts.kind == ast.NK_ASSIGN {
                            target_name := ~p.nodes[ts.a].sval
                            slot := env.lookup(target_name)
                            val := lower_expr($&mfn, &p.nodes, ts.b, &env)
                            if slot >= 0 {
                                $ins := minstr_new(MI_STORE_LOCAL)
                                ins.a = slot
                                ins.b = val
                                emit_instr($&mfn, ins)
                            }
                        } else if ts.kind == ast.NK_RETURN {
                            ret_val := lower_expr($&mfn, &p.nodes, ts.a, &env)
                            cur_b := mfn.active_bb
                            mfn.blocks[cur_b].tkind = TKIND_RETURN
                            mfn.blocks[cur_b].ta = ret_val
                        }
                        then_stmt = ts.next
                    }
                    if mfn.blocks[then_id].tkind == TKIND_OPEN {
                        mfn.blocks[then_id].tkind = TKIND_JUMP
                        mfn.blocks[then_id].ta = merge_id
                    }

                    // Lower else statements in else_bb if present
                    if else_id >= 0 {
                        mfn.active_bb = else_id
                        else_node := ~p.nodes[br_node.next]
                        $else_stmt := else_node.b
                        while else_stmt >= 0 && else_stmt < p.nodes.len {
                            es := ~p.nodes[else_stmt]
                            if es.kind == ast.NK_LET {
                                val := lower_expr($&mfn, &p.nodes, es.a, &env)
                                slot := mfn.locals.len
                                mfn.locals.push(1)
                                mfn.locals_nslots.push(1)
                                mfn.locals_owning.push(false)
                                mfn.local_names.push(~es.sval)
                                env.bind(es.sval, slot)
                                $ins := minstr_new(MI_STORE_LOCAL)
                                ins.a = slot
                                ins.b = val
                                emit_instr($&mfn, ins)
                            } else if es.kind == ast.NK_ASSIGN {
                                target_name := ~p.nodes[es.a].sval
                                slot := env.lookup(target_name)
                                val := lower_expr($&mfn, &p.nodes, es.b, &env)
                                if slot >= 0 {
                                    $ins := minstr_new(MI_STORE_LOCAL)
                                    ins.a = slot
                                    ins.b = val
                                    emit_instr($&mfn, ins)
                                }
                            } else if es.kind == ast.NK_RETURN {
                                ret_val := lower_expr($&mfn, &p.nodes, es.a, &env)
                                cur_b := mfn.active_bb
                                mfn.blocks[cur_b].tkind = TKIND_RETURN
                                mfn.blocks[cur_b].ta = ret_val
                            }
                            else_stmt = es.next
                        }
                        if mfn.blocks[else_id].tkind == TKIND_OPEN {
                            mfn.blocks[else_id].tkind = TKIND_JUMP
                            mfn.blocks[else_id].ta = merge_id
                        }
                    }

                    // Continue with merge block
                    mfn.active_bb = merge_id
                }
            }

            stmt_idx = s.next
        }

        last_bb := mfn.blocks.len - 1
        if mfn.blocks[last_bb].tkind == TKIND_OPEN {
            zero_const := alloc_const($&mfn, 0)
            mfn.blocks[last_bb].tkind = TKIND_RETURN
            mfn.blocks[last_bb].ta = zero_const
        }

        unit.add_fn(mfn)
    }

    << unit
}
