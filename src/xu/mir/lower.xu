@xu/mir
// Typed AST to MIR lowering.
//
// Layer 3 module: lowers checked functions to MIR using the checker's typed
// view (node types, local ids, call targets, struct layouts). See mir.xu for
// the value model: scalars are one word, wider values are addressed.
//
// Calling convention (MIR level, every backend implements it the same way):
//   incoming words = [sret ptr if the result is wide] [receiver ptr] params
//   a wide parameter arrives as the address of the caller's value and is
//   copied into the callee's frame on entry; a wide result is written
//   through the sret pointer. Receivers are always passed by address.
//
// Constructs without a lowering are reported with their source position
// and fail the build; nothing is skipped silently.
//
// Errors and interfaces (shared by every lowering file):
//   - an interface value, errors.Error included, is one word: 0 or the
//     address of a heap box laid out as [type id word][concrete value]
//   - a function that may throw takes a hidden first word okp (where its
//     ok value is stored; 0 when the ok type is void) ahead of the
//     receiver and params, and returns the error word (0 = success)
//   - lowering any throwing call (user function or hosted builtin) yields
//     the ok value like a normal call and leaves the error word in the
//     temp w.last_err; the caller decides how to handle it
//
// Maps (lower_map): a map value is one word, the address of a runtime/core
// map record; m[k] reads, writes and borrows go through the address of the
// stored value, which the runtime returns for a key passed by address.
//
// Function values (lower_fnval): a fn-typed value is wide, two words
// [code address][env word]. A non-zero env word is passed to the code as an
// extra word after the sret/okp word (closure env, method receiver); a call
// through a value passes it only when non-zero. Throwing functions are
// reached through a shim that panics on an error.
//
// temp/any values are two words [type id][payload]; see lower_iface.
//
// Feature files (lower_err, lower_host, lower_float, lower_enum,
// lower_chan, lower_map, lower_fnval, lower_iface, lower_intrin) each expose <feature>_expr / _stmt / _call / _method_call
// hooks returning NOT_HANDLED (or false) for nodes they do not own.

#xu/ast
#xu/parser
#xu/types

struct Lw {
    f MFn
    fi int
    tgt_os int
    // checker local id -> MIR local; -1 until declared
    lslot []int
    // MIR local holds the address of the value instead of the value
    lbyref []bool
    brk []int
    cont []int
    loop_depth int
    ret_ty int
    sret int
    errors int
    core_names []string
    core_labels []string
    // error word of the most recent throwing call (-1 when none)
    last_err int
    // hidden okp incoming local of a throwing function (-1 otherwise)
    okp int
    // node being lowered as its unboxed value (see err_box)
    unboxed int
}

// Hook result for "this feature does not lower the node".
const NOT_HANDLED = -1

fn lw_new(name string, label string, fi int, tgt_os int) Lw {
    << Lw{
        f: mfn_new(name, label),
        fi: fi,
        tgt_os: tgt_os,
        lslot: []int{},
        lbyref: []bool{},
        brk: []int{},
        cont: []int{},
        loop_depth: 0,
        ret_ty: 0,
        sret: -1,
        errors: 0,
        core_names: []string{},
        core_labels: []string{},
        last_err: -1,
        okp: -1,
        unboxed: -1
    }
}

// ===== emission helpers =====

fn (w $&Lw) emit(ins MInstr) {
    idx := w.f.instrs.len
    w.f.instrs.push(ins)
    bi := w.f.active_bb
    if w.f.blocks[bi].head < 0 {
        w.f.blocks[bi].head = idx
    } else {
        tail := w.f.blocks[bi].tail
        w.f.instrs[tail].next = idx
    }
    w.f.blocks[bi].tail = idx
}

fn (w $&Lw) new_block() int {
    id := w.f.blocks.len
    w.f.blocks.push(mblock_new())
    << id
}

fn (w &Lw) open() bool {
    << w.f.blocks[w.f.active_bb].tkind == TKIND_OPEN
}

fn (w $&Lw) jump(target int) {
    if w.open() {
        w.f.blocks[w.f.active_bb].tkind = TKIND_JUMP
        w.f.blocks[w.f.active_bb].ta = target
    }
}

fn (w $&Lw) branch(cond int, then_b int, else_b int) {
    if w.open() {
        w.f.blocks[w.f.active_bb].tkind = TKIND_BRANCH
        w.f.blocks[w.f.active_bb].ta = cond
        w.f.blocks[w.f.active_bb].tb = then_b
        w.f.blocks[w.f.active_bb].tc = else_b
    }
}

fn (w $&Lw) ret(v int) {
    if w.open() {
        if w.f.label == "_xu_main" {
            $none := []int{}
            w.call_core("task_drain", &none)
        }
        w.f.blocks[w.f.active_bb].tkind = TKIND_RETURN
        w.f.blocks[w.f.active_bb].ta = v
    }
}

// Statements after a terminator land in a fresh unreachable block.
fn (w $&Lw) ensure_open() {
    if !w.open() {
        w.f.active_bb = w.new_block()
    }
}

fn (w $&Lw) new_temp() int {
    id := w.f.temps.len
    w.f.temps.push(1)
    w.f.temps_nslots.push(1)
    << id
}

fn (w $&Lw) konst(v int) int {
    for i in 0:w.f.consts.len {
        if w.f.consts[i] == v {
            << 0 - i - 2
        }
    }
    idx := w.f.consts.len
    w.f.consts.push(v)
    << 0 - idx - 2
}

fn (w $&Lw) new_local(ty int, words int, name string) int {
    id := w.f.locals.len
    w.f.locals.push(ty)
    $n := words
    if n < 1 {
        n = 1
    }
    w.f.locals_nslots.push(n)
    w.f.locals_owning.push(false)
    w.f.local_names.push(name + "")
    << id
}

fn (w $&Lw) bin(op int, a int, b int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_BIN)
    ins.a = t
    ins.b = op
    ins.c = a
    ins.d = b
    w.emit(ins)
    << t
}

fn (w $&Lw) load_local(slot int, word int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_LOAD_LOCAL)
    ins.a = t
    ins.b = slot
    ins.c = word
    w.emit(ins)
    << t
}

fn (w $&Lw) store_local(slot int, word int, v int) {
    $ins := minstr_new(MI_STORE_LOCAL)
    ins.a = slot
    ins.b = v
    ins.c = word
    w.emit(ins)
}

fn (w $&Lw) addr_local(slot int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_ADDR)
    ins.a = t
    ins.b = slot
    w.emit(ins)
    << t
}

fn (w $&Lw) load_ptr(base int, off int, width int) int {
    t := w.new_temp()
    $ins := minstr_new(MI_LOAD_PTR)
    ins.a = t
    ins.b = base
    ins.c = off
    ins.d = width
    w.emit(ins)
    << t
}

fn (w $&Lw) store_ptr(base int, off int, v int, width int) {
    $ins := minstr_new(MI_STORE_PTR)
    ins.a = base
    ins.b = v
    ins.c = off
    ins.d = width
    w.emit(ins)
}

fn (w $&Lw) call(label string, args &[]int) int {
    t := w.new_temp()
    $head := -1
    if args.len > 0 {
        head = w.f.margs.len
        for i in 0:args.len {
            $nx := -1
            if i + 1 < args.len {
                nx = w.f.margs.len + 1
            }
            w.f.margs.push(MArg{v: args[i], next: nx})
        }
    }
    $ins := minstr_new(MI_CALL)
    ins.a = t
    ins.c = head
    ins.sval = label + ""
    w.emit(ins)
    << t
}

fn (w &Lw) core(name string) string {
    for i in 0:w.core_names.len {
        if w.core_names[i] == name {
            << w.core_labels[i] + ""
        }
    }
    << "_runtime_core_missing_" + name
}

fn (w $&Lw) call_core(name string, args &[]int) int {
    << w.call(w.core(name), args)
}

fn (w $&Lw) fail(p &parser.Parser, n int, msg string) {
    $line := 0
    $col := 0
    if n >= 0 && n < p.nodes.len {
        line = p.nodes[n].line
        col = p.nodes[n].col
    }
    eprintln("error: " + str(line) + ":" + str(col) + ": " + msg + " (in " + w.f.name + ")")
    w.errors += 1
}

// ===== type helpers =====

// Memory access width in bytes; -4 is a sign-extending 4-byte access (i32).
fn width_of(tp &types.TypedProgram, ty int) int {
    if tp.deref(ty) == 8 {
        << -4
    }
    sz := tp.size_of(ty)
    if sz == 1 || sz == 4 {
        << sz
    }
    << 8
}

fn is_wide(tp &types.TypedProgram, ty int) bool {
    << !tp.is_scalar(ty)
}

// Copy n bytes between two addresses (words first, then bytes).
fn (w $&Lw) copy_mem(dst int, src int, n int) {
    $off := 0
    while off + 8 <= n {
        v := w.load_ptr(src, off, 8)
        w.store_ptr(dst, off, v, 8)
        off += 8
    }
    while off < n {
        v := w.load_ptr(src, off, 1)
        w.store_ptr(dst, off, v, 1)
        off += 1
    }
}

fn (w $&Lw) zero_mem(dst int, n int) {
    $off := 0
    zero := w.konst(0)
    while off + 8 <= n {
        w.store_ptr(dst, off, zero, 8)
        off += 8
    }
    while off < n {
        w.store_ptr(dst, off, zero, 1)
        off += 1
    }
}

// Fresh frame memory for a wide value; returns its address.
fn (w $&Lw) scratch(tp &types.TypedProgram, ty int) int {
    sz := tp.size_of(ty)
    slot := w.new_local(ty, (sz + 7) / 8, "tmp")
    << w.addr_local(slot)
}

fn (w $&Lw) scratch_words(words int) int {
    slot := w.new_local(1, words, "tmp")
    << w.addr_local(slot)
}

// Store value v of type ty at address dst (copying wide values).
fn (w $&Lw) store_value(tp &types.TypedProgram, dst int, off int, v int, ty int) {
    if is_wide(tp, ty) {
        $d := dst
        if off != 0 {
            d = w.bin(BIN_ADD, dst, w.konst(off))
        }
        w.copy_mem(d, v, tp.size_of(ty))
    } else {
        w.store_ptr(dst, off, v, width_of(tp, ty))
    }
}

// ===== locals =====

fn (w $&Lw) local_type(tp &types.TypedProgram, id int) int {
    if id >= 0 && id < tp.fns[w.fi].locals.len {
        << tp.fns[w.fi].locals[id]
    }
    << 1
}

fn (w $&Lw) ensure_local(tp &types.TypedProgram, id int) int {
    while w.lslot.len <= id {
        w.lslot.push(-1)
    }
    if w.lslot[id] >= 0 {
        << w.lslot[id]
    }
    ty := w.local_type(tp, id)
    $name := "local"
    if id < tp.fns[w.fi].local_names.len {
        name = tp.fns[w.fi].local_names[id]
    }
    slot := w.new_local(ty, tp.words_of(ty), name)
    w.lslot[id] = slot
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    << slot
}

fn (w &Lw) byref(slot int) bool {
    << slot >= 0 && slot < w.lbyref.len && w.lbyref[slot]
}

// Address of a local's value.
fn (w $&Lw) local_addr(slot int) int {
    if w.byref(slot) {
        << w.load_local(slot, 0)
    }
    << w.addr_local(slot)
}

// ===== expressions =====

fn bin_code(op int) int {
    if op == ast.OP_ADD { << BIN_ADD }
    if op == ast.OP_SUB { << BIN_SUB }
    if op == ast.OP_MUL { << BIN_MUL }
    if op == ast.OP_DIV { << BIN_DIV }
    if op == ast.OP_MOD { << BIN_MOD }
    if op == ast.OP_EQ { << BIN_EQ }
    if op == ast.OP_NE { << BIN_NE }
    if op == ast.OP_LT { << BIN_LT }
    if op == ast.OP_LE { << BIN_LE }
    if op == ast.OP_GT { << BIN_GT }
    if op == ast.OP_GE { << BIN_GE }
    if op == ast.OP_BIT_AND { << BIN_AND }
    if op == ast.OP_BIT_OR { << BIN_OR }
    if op == ast.OP_BIT_XOR { << BIN_XOR }
    if op == ast.OP_SHL { << BIN_SHL }
    if op == ast.OP_SHR { << BIN_SHR }
    << -1
}

fn assign_bin_code(aop int) int {
    if aop == ast.AS_ADD { << BIN_ADD }
    if aop == ast.AS_SUB { << BIN_SUB }
    if aop == ast.AS_MUL { << BIN_MUL }
    if aop == ast.AS_DIV { << BIN_DIV }
    if aop == ast.AS_MOD { << BIN_MOD }
    << -1
}

// The expression evaluates to a reference (pointer) value.
fn (w $&Lw) expr_is_ref(p &parser.Parser, tp &types.TypedProgram, n int) bool {
    k := p.nodes[n].kind
    if k == ast.NK_BORROW {
        << true
    }
    if k == ast.NK_IDENT {
        id := tp.local_of(n)
        if id >= 0 {
            << types.is_ref_type(w.local_type(tp, id))
        }
    }
    // The checker types an implicitly borrowed field or element argument as
    // the reference parameter type; the place itself holds the declared type.
    if k == ast.NK_FIELD || k == ast.NK_INDEX {
        bty := tp.deref(tp.deref(w.place_type(p, tp, p.nodes[n].a)))
        if k == ast.NK_FIELD && types.is_struct_type(bty) {
            fname := p.nodes[n].sval + ""
            fld := tp.field_of(bty, &fname)
            if fld.offset >= 0 {
                << types.is_ref_type(fld.ty)
            }
        }
        if k == ast.NK_INDEX && types.is_array_type(bty) {
            << types.is_ref_type(tp.elem_of(bty))
        }
        if k == ast.NK_INDEX && bty == 3 {
            << false
        }
    }
    << types.is_ref_type(tp.type_of(n))
}

// Address of the value designated by expression n (a place or a wide value).
fn (w $&Lw) lower_addr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_IDENT {
        id := tp.local_of(n)
        if id >= 0 {
            slot := w.ensure_local(tp, id)
            if types.is_ref_type(w.local_type(tp, id)) {
                << w.load_local(slot, 0)
            }
            << w.local_addr(slot)
        }
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_DEREF {
        << w.lower_expr(p, tp, p.nodes[n].a)
    }
    if (k == ast.NK_FIELD && tp.call_of(n) != -30 && tp.const_of(n) < 0 && !fnval_owns(p, tp, n)) || k == ast.NK_INDEX {
        << w.lower_place_addr(p, tp, n)
    }
    ty := tp.type_of(n)
    v := w.lower_expr(p, tp, n)
    if is_wide(tp, ty) || types.is_ref_type(ty) && w.expr_is_ref(p, tp, n) {
        << v
    }
    a := w.scratch_words(1)
    w.store_ptr(a, 0, v, 8)
    << a
}

// Address of the storage behind a wide or ref-typed operand.
fn (w $&Lw) base_addr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if w.expr_is_ref(p, tp, n) {
        << w.lower_expr(p, tp, n)
    }
    << w.lower_addr(p, tp, n)
}

// Address of a field or element place.
fn (w $&Lw) lower_place_addr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    base := p.nodes[n].a
    bty := tp.deref(tp.deref(w.place_type(p, tp, base)))
    if k == ast.NK_FIELD {
        if types.is_struct_type(bty) {
            // nlocal is not a field index on assignment targets; match by name.
            fname := p.nodes[n].sval + ""
            fld := tp.field_of(bty, &fname)
            if fld.offset < 0 {
                w.fail(p, n, "unresolved field '" + fname + "'")
                << w.konst(0)
            }
            ba := w.base_addr(p, tp, base)
            off := fld.offset
            if off == 0 {
                << ba
            }
            << w.bin(BIN_ADD, ba, w.konst(off))
        }
        w.fail(p, n, "field access on a non-struct value")
        << w.konst(0)
    }
    if tp.call_of(n) == -77 || tp.call_of(n) == -78 {
        << w.map_elem_addr(p, tp, n)
    }
    // Index: element address with bounds check.
    d := w.array_desc(p, tp, base, bty)
    idx := w.lower_expr(p, tp, p.nodes[n].b)
    n_len := w.load_ptr(d, 8, 8)
    w.bounds_check(idx, n_len)
    data := w.load_ptr(d, 0, 8)
    $esize := 1
    if bty != 3 {
        esize = tp.size_of(tp.elem_of(bty))
    }
    if esize == 1 {
        << w.bin(BIN_ADD, data, idx)
    }
    scaled := w.bin(BIN_MUL, idx, w.konst(esize))
    << w.bin(BIN_ADD, data, scaled)
}

fn (w $&Lw) bounds_check(idx int, n int) {
    neg := w.bin(BIN_LT, idx, w.konst(0))
    over := w.bin(BIN_GE, idx, n)
    bad := w.bin(BIN_OR, neg, over)
    panic_b := w.new_block()
    ok_b := w.new_block()
    w.branch(bad, panic_b, ok_b)
    w.f.active_bb = panic_b
    $args := []int{}
    args.push(idx)
    args.push(n)
    w.call_core("index_panic", &args)
    w.jump(ok_b)
    w.f.active_bb = ok_b
}

// Descriptor address for array or string expression n of type ty. A
// fixed-size array is stored inline, so it gets a {data, N, N} view.
fn (w $&Lw) array_desc(p &parser.Parser, tp &types.TypedProgram, n int, ty int) int {
    base := w.base_addr(p, tp, n)
    fl := fixed_len_of(tp, ty)
    if fl == 0 {
        << base
    }
    d := w.scratch_words(3)
    w.store_ptr(d, 0, base, 8)
    w.store_ptr(d, 8, w.konst(fl), 8)
    w.store_ptr(d, 16, w.konst(fl), 8)
    << d
}

fn fixed_len_of(tp &types.TypedProgram, ty int) int {
    t := tp.deref(tp.deref(ty))
    if !types.is_array_type(t) {
        << 0
    }
    << tp.arrays[types.array_index(t)].fixed_len
}

// Calls core.rt_panic(kind) when cond is true (kinds are defined in core.xu).
fn (w $&Lw) panic_if(cond int, kind int) {
    panic_b := w.new_block()
    ok_b := w.new_block()
    w.branch(cond, panic_b, ok_b)
    w.f.active_bb = panic_b
    $args := []int{}
    args.push(w.konst(kind))
    w.call_core("rt_panic", &args)
    w.jump(ok_b)
    w.f.active_bb = ok_b
}

// Integer a <code> b; division and remainder fail loudly on a zero divisor
// and on int minimum / -1.
fn (w $&Lw) checked_bin(code int, a int, b int, ty int) int {
    if code == BIN_DIV || code == BIN_MOD {
        w.panic_if(w.bin(BIN_EQ, b, w.konst(0)), 3)
        if ty == 1 {
            min := w.bin(BIN_SHL, w.konst(1), w.konst(63))
            lhs_min := w.bin(BIN_EQ, a, min)
            rhs_m1 := w.bin(BIN_EQ, b, w.konst(-1))
            w.panic_if(w.bin(BIN_AND, lhs_min, rhs_m1), 4)
        }
    }
    r := w.bin(code, a, b)
    if code < BIN_EQ || code == BIN_MOD || code >= BIN_XOR && code <= BIN_SHR {
        << w.wrap_int(r, ty)
    }
    << r
}

// Reduce a 64-bit result to the range of the narrow integer type ty.
fn (w $&Lw) wrap_int(v int, ty int) int {
    if ty == 10 {
        << w.bin(BIN_AND, v, w.konst(255))
    }
    if ty == 9 {
        << w.bin(BIN_AND, v, w.konst(0xffffffff))
    }
    if ty == 8 {
        << w.bin(BIN_SHR, w.bin(BIN_SHL, v, w.konst(32)), w.konst(32))
    }
    << v
}

fn (w $&Lw) lower_expr(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if n < 0 {
        << w.konst(0)
    }
    if n != w.unboxed && w.err_wants_box(tp, n) {
        << w.err_box(p, tp, n)
    }
    if n != w.unboxed && w.iface_wants_box(tp, n) {
        << w.iface_box(p, tp, n)
    }
    k := p.nodes[n].kind
    if k == ast.NK_IDENT || k == ast.NK_FIELD {
        fv := w.fnval_expr(p, tp, n)
        if fv != NOT_HANDLED {
            << fv
        }
    }
    if k == ast.NK_INT {
        << w.konst(p.nodes[n].ival)
    }
    if k == ast.NK_BOOL {
        if p.nodes[n].ival != 0 {
            << w.konst(1)
        }
        << w.konst(0)
    }
    if k == ast.NK_STR {
        << w.lower_str_lit(p.nodes[n].sval)
    }
    if k == ast.NK_IDENT {
        << w.lower_ident(p, tp, n)
    }
    if k == ast.NK_BIN_OP {
        << w.lower_binop(p, tp, n)
    }
    if k == ast.NK_UN_OP {
        op := p.nodes[n].ival
        if op == ast.UN_NEG {
            v := w.lower_expr(p, tp, p.nodes[n].a)
            if tp.type_of(n) == 4 {
                << w.float_neg(v)
            }
            << w.bin(BIN_SUB, w.konst(0), v)
        }
        if op == ast.UN_NOT {
            v := w.lower_expr(p, tp, p.nodes[n].a)
            << w.bin(BIN_XOR, v, w.konst(1))
        }
        ptr := w.lower_expr(p, tp, p.nodes[n].a)
        ty := tp.type_of(n)
        if is_wide(tp, ty) {
            << ptr
        }
        << w.load_ptr(ptr, 0, width_of(tp, ty))
    }
    if k == ast.NK_BORROW {
        target := p.nodes[n].a
        if p.nodes[target].kind == ast.NK_UN_OP && p.nodes[target].ival == ast.UN_DEREF {
            << w.lower_expr(p, tp, p.nodes[target].a)
        }
        << w.lower_addr(p, tp, target)
    }
    if k == ast.NK_FIELD {
        << w.lower_field(p, tp, n)
    }
    if k == ast.NK_INDEX {
        << w.lower_index(p, tp, n)
    }
    if k == ast.NK_SLICE {
        << w.lower_slice(p, tp, n)
    }
    if k == ast.NK_CALL {
        << w.lower_call(p, tp, n)
    }
    if k == ast.NK_METHOD_CALL {
        << w.lower_method_call(p, tp, n)
    }
    if k == ast.NK_STRUCT_INIT {
        << w.lower_struct_init(p, tp, n)
    }
    if k == ast.NK_ARRAY_LIT || k == ast.NK_EMPTY_ARRAY {
        << w.lower_array_lit(p, tp, n)
    }
    if k == ast.NK_CLONE {
        << w.lower_clone(p, tp, p.nodes[n].a)
    }
    if k == ast.NK_CAST {
        v := w.lower_expr(p, tp, p.nodes[n].a)
        to := p.nodes[n].ival
        if to == 4 || tp.deref(tp.type_of(p.nodes[n].a)) == 4 {
            << w.float_cast(p, tp, n, v)
        }
        if to == 10 {
            << w.bin(BIN_AND, v, w.konst(255))
        }
        if to == 9 {
            << w.bin(BIN_AND, v, w.konst(4294967295))
        }
        if to == 8 {
            sh := w.bin(BIN_SHL, v, w.konst(32))
            << w.bin(BIN_SHR, sh, w.konst(32))
        }
        << v
    }
    if k == ast.NK_TERNARY {
        << w.lower_ternary(p, tp, n)
    }
    $r := w.err_expr(p, tp, n)
    if r == NOT_HANDLED { r = w.host_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.float_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.enum_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.chan_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.map_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.fnval_expr(p, tp, n) }
    if r == NOT_HANDLED { r = w.iface_expr(p, tp, n) }
    if r != NOT_HANDLED {
        << r
    }
    w.fail(p, n, "expression " + types.ast_kind_name(k) + " is not supported yet")
    << w.konst(0)
}

fn (w $&Lw) lower_str_lit(s string) int {
    d := w.scratch_words(3)
    data := w.new_temp()
    $ins := minstr_new(MI_STR_CONST)
    ins.a = data
    ins.sval = s + ""
    w.emit(ins)
    w.store_ptr(d, 0, data, 8)
    w.store_ptr(d, 8, w.konst(s.len), 8)
    w.store_ptr(d, 16, w.konst(0), 8)
    << d
}

fn (w $&Lw) lower_ident(p &parser.Parser, tp &types.TypedProgram, n int) int {
    id := tp.local_of(n)
    if id >= 0 {
        slot := w.ensure_local(tp, id)
        ty := w.local_type(tp, id)
        if is_wide(tp, ty) {
            << w.local_addr(slot)
        }
        if w.byref(slot) {
            ptr := w.load_local(slot, 0)
            << w.load_ptr(ptr, 0, width_of(tp, ty))
        }
        << w.load_local(slot, 0)
    }
    if tp.const_of(n) >= 0 {
        << w.lower_const(tp, tp.const_of(n))
    }
    w.fail(p, n, "unresolved name '" + p.nodes[n].sval + "'")
    << w.konst(0)
}

// Package constant ci: a string descriptor address or a scalar value.
fn (w $&Lw) lower_const(tp &types.TypedProgram, ci int) int {
    if ci < tp.const_tys.len {
        if tp.const_tys[ci] == 3 {
            si := tp.const_strs[ci]
            if si >= 0 && si < tp.strings.len {
                << w.lower_str_lit(tp.strings[si])
            }
        }
        << w.konst(tp.const_ivals[ci])
    }
    << w.konst(0)
}

fn (w $&Lw) lower_binop(p &parser.Parser, tp &types.TypedProgram, n int) int {
    op := p.nodes[n].ival
    if op == ast.OP_AND || op == ast.OP_OR {
        res := w.new_local(2, 1, "cond")
        lhs := w.lower_expr(p, tp, p.nodes[n].a)
        w.store_local(res, 0, lhs)
        rhs_b := w.new_block()
        done_b := w.new_block()
        if op == ast.OP_AND {
            w.branch(lhs, rhs_b, done_b)
        } else {
            w.branch(lhs, done_b, rhs_b)
        }
        w.f.active_bb = rhs_b
        rhs := w.lower_expr(p, tp, p.nodes[n].b)
        w.store_local(res, 0, rhs)
        w.jump(done_b)
        w.f.active_bb = done_b
        << w.load_local(res, 0)
    }
    lt := tp.deref(tp.type_of(p.nodes[n].a))
    if lt == 3 {
        a := w.base_addr(p, tp, p.nodes[n].a)
        b := w.base_addr(p, tp, p.nodes[n].b)
        if op == ast.OP_ADD {
            out := w.scratch_words(3)
            $args := []int{}
            args.push(out)
            args.push(a)
            args.push(b)
            w.call_core("str_concat", &args)
            << out
        }
        if op == ast.OP_EQ || op == ast.OP_NE {
            $args := []int{}
            args.push(a)
            args.push(b)
            eq := w.call_core("str_eq", &args)
            if op == ast.OP_NE {
                << w.bin(BIN_XOR, eq, w.konst(1))
            }
            << eq
        }
        w.fail(p, n, "string operator " + ast.binop_name(op) + " is not supported yet")
        << w.konst(0)
    }
    if lt == 4 {
        << w.float_binop(p, tp, n)
    }
    code := bin_code(op)
    if code < 0 {
        w.fail(p, n, "binary operator " + ast.binop_name(op) + " is not supported yet")
        << w.konst(0)
    }
    a := w.lower_expr(p, tp, p.nodes[n].a)
    b := w.lower_expr(p, tp, p.nodes[n].b)
    << w.checked_bin(code, a, b, lt)
}

fn (w $&Lw) lower_ternary(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    wide := is_wide(tp, ty)
    $res := -1
    if wide {
        res = w.new_local(ty, tp.words_of(ty), "sel")
    } else {
        res = w.new_local(ty, 1, "sel")
    }
    cond := w.lower_expr(p, tp, p.nodes[n].a)
    then_b := w.new_block()
    else_b := w.new_block()
    done_b := w.new_block()
    w.branch(cond, then_b, else_b)
    w.f.active_bb = then_b
    tv := w.lower_expr(p, tp, p.nodes[n].b)
    if wide {
        w.copy_mem(w.addr_local(res), tv, tp.size_of(ty))
    } else {
        w.store_local(res, 0, tv)
    }
    w.jump(done_b)
    w.f.active_bb = else_b
    ev := w.lower_expr(p, tp, p.nodes[n].c)
    if wide {
        w.copy_mem(w.addr_local(res), ev, tp.size_of(ty))
    } else {
        w.store_local(res, 0, ev)
    }
    w.jump(done_b)
    w.f.active_bb = done_b
    if wide {
        << w.addr_local(res)
    }
    << w.load_local(res, 0)
}

fn (w $&Lw) lower_field(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if tp.const_of(n) >= 0 {
        << w.lower_const(tp, tp.const_of(n))
    }
    if tp.call_of(n) == -30 {
        << w.enum_ctor(p, tp, n, -1)
    }
    base := p.nodes[n].a
    bty := tp.deref(tp.deref(tp.type_of(base)))
    name := p.nodes[n].sval
    if bty == 3 || types.is_array_type(bty) {
        if tp.call_of(n) == -96 {
            << w.konst(tp.local_of(n))
        }
        d := w.array_desc(p, tp, base, bty)
        if name == "len" {
            << w.load_ptr(d, 8, 8)
        }
        if name == "cap" {
            << w.load_ptr(d, 16, 8)
        }
        w.fail(p, n, "unknown field '" + name + "'")
        << w.konst(0)
    }
    addr := w.lower_place_addr(p, tp, n)
    fty := tp.type_of(n)
    if is_wide(tp, fty) {
        << addr
    }
    << w.load_ptr(addr, 0, width_of(tp, fty))
}

fn (w $&Lw) lower_index(p &parser.Parser, tp &types.TypedProgram, n int) int {
    if tp.call_of(n) == -77 {
        << w.map_index(p, tp, n)
    }
    bty := tp.deref(tp.deref(tp.type_of(p.nodes[n].a)))
    if bty != 3 && !types.is_array_type(bty) {
        w.fail(p, n, "indexing this type is not supported yet")
        << w.konst(0)
    }
    addr := w.lower_place_addr(p, tp, n)
    ety := tp.type_of(n)
    if bty == 3 {
        << w.load_ptr(addr, 0, 1)
    }
    if is_wide(tp, ety) {
        << addr
    }
    << w.load_ptr(addr, 0, width_of(tp, ety))
}

fn (w $&Lw) lower_slice(p &parser.Parser, tp &types.TypedProgram, n int) int {
    base := p.nodes[n].a
    bty := tp.deref(tp.deref(tp.type_of(base)))
    d := w.base_addr(p, tp, base)
    $lo := w.konst(0)
    if p.nodes[n].b >= 0 {
        lo = w.lower_expr(p, tp, p.nodes[n].b)
    }
    $hi := -1
    if p.nodes[n].c >= 0 {
        hi = w.lower_expr(p, tp, p.nodes[n].c)
    } else {
        hi = w.load_ptr(d, 8, 8)
    }
    out := w.scratch_words(3)
    $args := []int{}
    args.push(out)
    args.push(d)
    args.push(lo)
    args.push(hi)
    if bty == 3 {
        w.call_core("str_slice", &args)
    } else {
        args.push(w.konst(tp.size_of(tp.elem_of(bty))))
        w.call_core("slice_slice", &args)
    }
    << out
}

fn (w $&Lw) lower_clone(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.deref(tp.type_of(n))
    if !is_wide(tp, ty) {
        if w.expr_is_ref(p, tp, n) {
            ptr := w.lower_expr(p, tp, n)
            << w.load_ptr(ptr, 0, width_of(tp, ty))
        }
        << w.lower_expr(p, tp, n)
    }
    src := w.base_addr(p, tp, n)
    out := w.scratch(tp, ty)
    w.clone_into(tp, out, src, ty)
    << out
}

// Deep copy of a value of type ty from src to dst.
fn (w $&Lw) clone_into(tp &types.TypedProgram, dst int, src int, ty int) {
    if ty == 3 {
        $args := []int{}
        args.push(dst)
        args.push(w.load_ptr(src, 0, 8))
        args.push(w.load_ptr(src, 8, 8))
        w.call_core("bytes_new", &args)
        <<
    }
    if types.is_array_type(ty) && tp.arrays[types.array_index(ty)].fixed_len == 0 {
        ety := tp.elem_of(ty)
        $args := []int{}
        args.push(dst)
        args.push(src)
        args.push(w.konst(0))
        args.push(w.load_ptr(src, 8, 8))
        args.push(w.konst(tp.size_of(ety)))
        w.call_core("slice_slice", &args)
        if is_wide(tp, ety) {
            w.clone_elems(tp, dst, ety)
        }
        <<
    }
    if types.is_enum_type(ty) {
        w.enum_clone_into(tp, dst, src, ty)
        <<
    }
    w.copy_mem(dst, src, tp.size_of(ty))
    if types.is_struct_type(ty) {
        si := types.struct_index(ty)
        for i in 0:tp.structs[si].fields.len {
            fty := tp.structs[si].fields[i].ty
            if fty == 3 || types.is_array_type(fty) || types.is_struct_type(fty) || types.is_enum_type(fty) {
                off := tp.structs[si].fields[i].offset
                fd := w.bin(BIN_ADD, dst, w.konst(off))
                fs := w.bin(BIN_ADD, src, w.konst(off))
                w.clone_into(tp, fd, fs, fty)
            }
        }
    }
}

// Replace each wide element of the array at d by a deep copy of itself.
fn (w $&Lw) clone_elems(tp &types.TypedProgram, d int, ety int) {
    esize := tp.size_of(ety)
    i := w.new_local(1, 1, "ci")
    w.store_local(i, 0, w.konst(0))
    cond_b := w.new_block()
    body_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    iv := w.load_local(i, 0)
    n := w.load_ptr(d, 8, 8)
    w.branch(w.bin(BIN_LT, iv, n), body_b, done_b)
    w.f.active_bb = body_b
    iv2 := w.load_local(i, 0)
    data := w.load_ptr(d, 0, 8)
    ea := w.bin(BIN_ADD, data, w.bin(BIN_MUL, iv2, w.konst(esize)))
    tmp := w.scratch(tp, ety)
    w.clone_into(tp, tmp, ea, ety)
    w.copy_mem(ea, tmp, esize)
    w.store_local(i, 0, w.bin(BIN_ADD, iv2, w.konst(1)))
    w.jump(cond_b)
    w.f.active_bb = done_b
}

fn (w $&Lw) lower_struct_init(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    if !types.is_struct_type(ty) {
        w.fail(p, n, "struct literal of a non-struct type")
        << w.konst(0)
    }
    si := types.struct_index(ty)
    out := w.scratch(tp, ty)
    w.zero_mem(out, tp.size_of(ty))
    $fld := p.nodes[n].a
    while fld >= 0 {
        fname := p.nodes[fld].sval
        $fi := -1
        for i in 0:tp.structs[si].fields.len {
            if tp.structs[si].fields[i].name == fname {
                fi = i
            }
        }
        if fi < 0 {
            w.fail(p, fld, "unknown field '" + fname + "'")
        } else {
            fty := tp.structs[si].fields[fi].ty
            v := w.lower_expr(p, tp, p.nodes[fld].a)
            w.store_value(tp, out, tp.structs[si].fields[fi].offset, v, fty)
        }
        fld = p.nodes[fld].next
    }
    << out
}

fn (w $&Lw) lower_array_lit(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    if fixed_len_of(tp, ty) > 0 {
        << w.lower_fixed_array_lit(p, tp, n, ty)
    }
    out := w.scratch_words(3)
    w.zero_mem(out, 24)
    if p.nodes[n].kind == ast.NK_EMPTY_ARRAY {
        << out
    }
    ety := tp.elem_of(ty)
    $e := p.nodes[n].a
    while e >= 0 {
        v := w.lower_expr(p, tp, e)
        w.push_value(tp, out, v, ety)
        e = p.nodes[e].next
    }
    << out
}

// [N]T{...}: elements stored inline; missing trailing elements are zero.
fn (w $&Lw) lower_fixed_array_lit(p &parser.Parser, tp &types.TypedProgram, n int, ty int) int {
    out := w.scratch(tp, ty)
    w.zero_mem(out, tp.size_of(ty))
    ety := tp.elem_of(ty)
    esize := tp.size_of(ety)
    $e := p.nodes[n].a
    $k := 0
    while e >= 0 {
        v := w.lower_expr(p, tp, e)
        ea := w.bin(BIN_ADD, out, w.konst(k * esize))
        if is_wide(tp, ety) {
            w.copy_mem(ea, v, esize)
        } else {
            w.store_ptr(ea, 0, v, width_of(tp, ety))
        }
        k += 1
        e = p.nodes[e].next
    }
    << out
}

// Append value v (of element type ety) to the array descriptor at d.
fn (w $&Lw) push_value(tp &types.TypedProgram, d int, v int, ety int) {
    $ea := v
    if !is_wide(tp, ety) {
        // Spare capacity: store in place; otherwise slice_push grows.
        esize := tp.size_of(ety)
        n := w.load_ptr(d, 8, 8)
        fast_b := w.new_block()
        slow_b := w.new_block()
        done_b := w.new_block()
        w.branch(w.bin(BIN_LT, n, w.load_ptr(d, 16, 8)), fast_b, slow_b)
        w.f.active_bb = fast_b
        slot := w.bin(BIN_ADD, w.load_ptr(d, 0, 8), w.bin(BIN_MUL, n, w.konst(esize)))
        w.store_ptr(slot, 0, v, width_of(tp, ety))
        w.store_ptr(d, 8, w.bin(BIN_ADD, n, w.konst(1)), 8)
        w.jump(done_b)
        w.f.active_bb = slow_b
        ea = w.scratch_words(1)
        w.store_ptr(ea, 0, v, 8)
        $sargs := []int{}
        sargs.push(d)
        sargs.push(ea)
        sargs.push(w.konst(esize))
        w.call_core("slice_push", &sargs)
        w.jump(done_b)
        w.f.active_bb = done_b
        <<
    }
    $args := []int{}
    args.push(d)
    args.push(ea)
    args.push(w.konst(tp.size_of(ety)))
    w.call_core("slice_push", &args)
}

// ===== calls =====

// Argument value for a parameter of type pty.
fn (w $&Lw) lower_arg(p &parser.Parser, tp &types.TypedProgram, arg int, pty int) int {
    if types.is_ref_type(pty) {
        if w.expr_is_ref(p, tp, arg) {
            << w.lower_expr(p, tp, arg)
        }
        << w.lower_addr(p, tp, arg)
    }
    // Builtins lowered to runtime ABI functions (str(&int) -> itoa) accept
    // a reference where the function takes the scalar.
    plain := pty == 1 || pty == 2 || pty == 8 || pty == 9 || pty == 10
    if plain && types.is_ref_type(tp.type_of(arg)) && w.expr_is_ref(p, tp, arg) {
        << w.load_ptr(w.lower_expr(p, tp, arg), 0, width_of(tp, pty))
    }
    << w.lower_expr(p, tp, arg)
}

fn (w $&Lw) finish_call(tp &types.TypedProgram, callee int, args []int) int {
    if fn_throws(tp, callee) {
        << w.err_finish_call(tp, callee, &args)
    }
    rty := tp.fns[callee].ret
    label := tp.fns[callee].label
    if rty != 0 && is_wide(tp, rty) {
        out := w.scratch(tp, rty)
        $all := []int{}
        all.push(out)
        for i in 0:args.len {
            all.push(args[i])
        }
        w.call(label, &all)
        << out
    }
    << w.call(label, &args)
}

// Arguments starting at node arg for user function fi; the trailing
// arguments of a variadic function are packed into its []T parameter.
fn (w $&Lw) lower_call_args(p &parser.Parser, tp &types.TypedProgram, first int, fi int, skip int, args $&[]int) {
    $fixed := tp.fns[fi].params.len
    if tp.fns[fi].variadic {
        fixed -= 1
    }
    $arg := first
    $pi := skip
    while arg >= 0 && pi < fixed {
        args.push(w.lower_arg(p, tp, arg, tp.fns[fi].params[pi]))
        pi += 1
        arg = p.nodes[arg].next
    }
    if !tp.fns[fi].variadic {
        <<
    }
    pack := w.scratch_words(3)
    w.zero_mem(pack, 24)
    ety := tp.elem_of(tp.fns[fi].params[fixed])
    while arg >= 0 {
        w.push_value(tp, pack, w.lower_expr(p, tp, arg), ety)
        arg = p.nodes[arg].next
    }
    args.push(pack)
}

// Call of user function fi with the arguments of call node n.
fn (w $&Lw) lower_user_call(p &parser.Parser, tp &types.TypedProgram, n int, fi int) int {
    $args := []int{}
    w.lower_call_args(p, tp, p.nodes[n].a, fi, 0, $&args)
    << w.finish_call(tp, fi, args)
}

// `runtime.caller(skip)`: the checker resolves it to this call site, with
// the file in str_of and the line in local_of.
fn (w $&Lw) lower_caller_frame(p &parser.Parser, tp &types.TypedProgram, n int) int {
    ty := tp.type_of(n)
    out := w.scratch(tp, ty)
    si := types.struct_index(ty)
    si_file := tp.str_of(n)
    $file := ""
    if si_file >= 0 && si_file < tp.strings.len {
        file = tp.strings[si_file] + ""
    }
    for i in 0:tp.structs[si].fields.len {
        $v := w.konst(1)
        if tp.structs[si].fields[i].name == "file" {
            v = w.lower_str_lit(file)
        } else if tp.structs[si].fields[i].name == "line" {
            v = w.konst(tp.local_of(n))
        }
        w.store_value(tp, out, tp.structs[si].fields[i].offset, v, tp.structs[si].fields[i].ty)
    }
    << out
}

fn is_log_callsite(p &parser.Parser, tp &types.TypedProgram, n int, fi int) bool {
    if tp.fns[fi].mod_id != "log" {
        << false
    }
    want := p.nodes[n].sval + "_at"
    name := tp.fns[fi].name + ""
    if name.len < want.len || want.len == 3 {
        << false
    }
    << name[name.len - want.len:name.len] == want
}

// Call of user function or method fi from method-call node n.
fn (w $&Lw) lower_user_method_call(p &parser.Parser, tp &types.TypedProgram, n int, fi int) int {
    $args := []int{}
    // `pkg.f(...)` parses as a method call on the package name.
    if tp.fns[fi].recv >= 0 {
        args.push(w.base_addr(p, tp, p.nodes[n].a))
    }
    $skip := 0
    // The checker rewrites log.Logger print calls to their *_at form; the
    // call node carries the file (str_of) and line (local_of) arguments.
    if is_log_callsite(p, tp, n, fi) {
        si := tp.str_of(n)
        $file := ""
        if si >= 0 && si < tp.strings.len {
            file = tp.strings[si] + ""
        }
        args.push(w.lower_str_lit(file))
        args.push(w.konst(tp.local_of(n)))
        skip = 2
    }
    w.lower_call_args(p, tp, p.nodes[n].b, fi, skip, $&args)
    << w.finish_call(tp, fi, args)
}

fn (w $&Lw) lower_call(p &parser.Parser, tp &types.TypedProgram, n int) int {
    code := tp.call_of(n)
    if code >= 0 {
        << w.lower_user_call(p, tp, n, code)
    }
    if code == -2 || code == -7 {
        $fd := 1
        if code == -7 {
            fd = 2
        }
        arg := p.nodes[n].a
        aty := tp.deref(tp.deref(tp.type_of(arg)))
        $args := []int{}
        args.push(w.konst(fd))
        if aty == 3 {
            args.push(w.base_addr(p, tp, arg))
            args.push(w.konst(1))
            w.call_core("print_desc", &args)
        } else {
            $v := w.lower_expr(p, tp, arg)
            if w.expr_is_ref(p, tp, arg) {
                v = w.load_ptr(v, 0, width_of(tp, aty))
            }
            if aty == 4 {
                w.float_print(fd, v)
                << w.konst(0)
            }
            args.push(v)
            args.push(w.konst(1))
            if aty == 2 {
                w.call_core("print_bool", &args)
            } else {
                w.call_core("print_int", &args)
            }
        }
        << w.konst(0)
    }
    if code == -13 {
        $args := []int{}
        args.push(w.lower_expr(p, tp, p.nodes[n].a))
        w.call_core("exit_process", &args)
        << w.konst(0)
    }
    if code == -19 {
        << w.lower_expr(p, tp, p.nodes[n].a)
    }
    if code == -101 {
        << w.konst(w.tgt_os)
    }
    if code == types.NCALL_RT_SYSCALL {
        $args := []int{}
        $arg := p.nodes[n].a
        while arg >= 0 {
            args.push(w.lower_expr(p, tp, arg))
            arg = p.nodes[arg].next
        }
        << w.call("__xu_syscall", &args)
    }
    if code == types.NCALL_RT_LOAD || code == types.NCALL_RT_STORE {
        a0 := p.nodes[n].a
        a1 := p.nodes[a0].next
        if p.nodes[a1].kind != ast.NK_INT {
            w.fail(p, n, "rt_load/rt_store width must be a literal")
            << w.konst(0)
        }
        width := p.nodes[a1].ival
        addr := w.lower_expr(p, tp, a0)
        if code == types.NCALL_RT_LOAD {
            << w.load_ptr(addr, 0, width)
        }
        v := w.lower_expr(p, tp, p.nodes[a1].next)
        w.store_ptr(addr, 0, v, width)
        << w.konst(0)
    }
    if code == types.NCALL_RT_ADDR {
        << w.lower_expr(p, tp, p.nodes[n].a)
    }
    if code == -106 {
        $none := []int{}
        w.call_core("test_soft_fail", &none)
        << w.konst(0)
    }
    if code == -108 {
        // Short mode is only set by the test runner.
        << w.konst(0)
    }
    if code == -102 {
        // No native UI host is linked into these binaries: 127 is the
        // "host not linked" status.
        w.lower_expr(p, tp, p.nodes[n].a)
        << w.konst(127)
    }
    if code == types.NCALL_RT_GLOBALS {
        << w.call_noargs("__xu_globals")
    }
    $r := w.err_call(p, tp, n, code)
    if r == NOT_HANDLED { r = w.host_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.float_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.enum_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.chan_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.fnval_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.iface_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.intrin_call(p, tp, n, code) }
    if r != NOT_HANDLED {
        << r
    }
    w.fail(p, n, "builtin '" + p.nodes[n].sval + "' (code " + str(code) + ") is not supported yet")
    << w.konst(0)
}

fn find_fn(tp &types.TypedProgram, mod_id string, name string) int {
    for fi in 0:tp.fns.len {
        if tp.fns[fi].name == name && tp.fns[fi].mod_id == mod_id && !tp.fns[fi].is_template {
            << fi
        }
    }
    << -1
}

fn (w $&Lw) lower_method_call(p &parser.Parser, tp &types.TypedProgram, n int) int {
    code := tp.call_of(n)
    recv := p.nodes[n].a
    if code >= 0 {
        << w.lower_user_method_call(p, tp, n, code)
    }
    if code == -4 {
        d := w.base_addr(p, tp, recv)
        ety := tp.elem_of(tp.deref(tp.type_of(recv)))
        v := w.lower_expr(p, tp, p.nodes[n].b)
        w.push_value(tp, d, v, ety)
        << w.konst(0)
    }
    if code == -3 {
        d := w.base_addr(p, tp, recv)
        s := w.base_addr(p, tp, p.nodes[n].b)
        $args := []int{}
        args.push(d)
        args.push(d)
        args.push(s)
        w.call_core("str_concat", &args)
        << w.konst(0)
    }
    if code == -110 {
        d := w.base_addr(p, tp, recv)
        v := w.lower_expr(p, tp, p.nodes[n].b)
        ea := w.scratch_words(1)
        w.store_ptr(ea, 0, v, 8)
        $args := []int{}
        args.push(d)
        args.push(ea)
        args.push(w.konst(1))
        w.call_core("slice_push", &args)
        << w.konst(0)
    }
    if code == -75 || code == -76 {
        out := w.scratch_words(3)
        $args := []int{}
        args.push(out)
        args.push(w.base_addr(p, tp, recv))
        if code == -75 {
            w.call_core("str_bytes", &args)
        } else {
            w.call_core("str_runes", &args)
        }
        << out
    }
    if code == -70 {
        a := w.host_arg(p, tp, recv)
        b := w.host_arg(p, tp, p.nodes[n].b)
        if tp.deref(tp.deref(tp.type_of(recv))) == 4 {
            << w.bin(BIN_FLT, a, b)
        }
        << w.bin(BIN_LT, a, b)
    }
    if code == -71 {
        fi := find_fn(tp, "cmp", "less_string")
        if fi >= 0 {
            $args := []int{}
            args.push(w.lower_arg(p, tp, recv, tp.fns[fi].params[0]))
            args.push(w.lower_arg(p, tp, p.nodes[n].b, tp.fns[fi].params[1]))
            << w.finish_call(tp, fi, args)
        }
    }
    if code == -97 {
        << w.lower_caller_frame(p, tp, n)
    }
    $r := w.err_method_call(p, tp, n, code)
    if r == NOT_HANDLED { r = w.host_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.float_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.enum_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.chan_method_call(p, tp, n, code) }
    if r == NOT_HANDLED { r = w.map_method_call(p, tp, n, code) }
    if r != NOT_HANDLED {
        << r
    }
    w.fail(p, n, "builtin method '" + p.nodes[n].sval + "' (code " + str(code) + ") is not supported yet")
    << w.konst(0)
}

// ===== statements =====

fn (w $&Lw) lower_block(p &parser.Parser, tp &types.TypedProgram, head int) {
    $s := head
    while s >= 0 {
        w.ensure_open()
        w.lower_stmt(p, tp, s)
        s = p.nodes[s].next
    }
}

fn (w $&Lw) store_to_local(tp &types.TypedProgram, id int, v int) {
    slot := w.ensure_local(tp, id)
    ty := w.local_type(tp, id)
    if is_wide(tp, ty) {
        w.copy_mem(w.local_addr(slot), v, tp.size_of(ty))
    } else if w.byref(slot) {
        w.store_ptr(w.load_local(slot, 0), 0, v, width_of(tp, ty))
    } else {
        w.store_local(slot, 0, v)
    }
}

fn (w $&Lw) lower_stmt(p &parser.Parser, tp &types.TypedProgram, s int) {
    k := p.nodes[s].kind
    if k == ast.NK_LET {
        id := tp.local_of(s)
        $v := -1
        if p.nodes[s].ival == 1 && w.local_type(tp, id) == 3 {
            v = w.string_copy_init(p, tp, p.nodes[s].a)
        } else {
            v = w.lower_expr(p, tp, p.nodes[s].a)
        }
        if id < 0 {
            w.fail(p, s, "unresolved binding '" + p.nodes[s].sval + "'")
            <<
        }
        w.store_to_local(tp, id, v)
        <<
    }
    if k == ast.NK_ASSIGN {
        w.lower_assign(p, tp, s)
        <<
    }
    if k == ast.NK_EXPR_STMT {
        w.lower_expr(p, tp, p.nodes[s].a)
        <<
    }
    if k == ast.NK_RETURN {
        a := p.nodes[s].a
        if w.okp >= 0 {
            w.err_return(p, tp, a)
            <<
        }
        if a < 0 {
            w.ret(w.konst(0))
            <<
        }
        v := w.lower_expr(p, tp, a)
        if w.sret >= 0 {
            dst := w.load_local(w.sret, 0)
            w.copy_mem(dst, v, tp.size_of(w.ret_ty))
            w.ret(w.konst(0))
            <<
        }
        if w.expr_is_ref(p, tp, a) == false && types.is_ref_type(w.ret_ty) {
            w.ret(w.lower_addr(p, tp, a))
            <<
        }
        w.ret(v)
        <<
    }
    if k == ast.NK_IF {
        w.lower_if(p, tp, s)
        <<
    }
    if k == ast.NK_WHILE {
        cond_b := w.new_block()
        body_b := w.new_block()
        done_b := w.new_block()
        w.jump(cond_b)
        w.f.active_bb = cond_b
        c := w.lower_expr(p, tp, p.nodes[s].a)
        w.branch(c, body_b, done_b)
        w.loop_enter(done_b, cond_b)
        w.f.active_bb = body_b
        w.lower_block(p, tp, p.nodes[s].c)
        w.jump(cond_b)
        w.loop_depth -= 1
        w.f.active_bb = done_b
        <<
    }
    if k == ast.NK_FOR {
        id := tp.local_of(s)
        slot := w.ensure_local(tp, id)
        lo := w.lower_expr(p, tp, p.nodes[s].a)
        w.store_local(slot, 0, lo)
        hi_slot := w.new_local(1, 1, "hi")
        w.store_local(hi_slot, 0, w.lower_expr(p, tp, p.nodes[s].b))
        cond_b := w.new_block()
        body_b := w.new_block()
        step_b := w.new_block()
        done_b := w.new_block()
        w.jump(cond_b)
        w.f.active_bb = cond_b
        iv := w.load_local(slot, 0)
        hv := w.load_local(hi_slot, 0)
        w.branch(w.bin(BIN_LT, iv, hv), body_b, done_b)
        w.loop_enter(done_b, step_b)
        w.f.active_bb = body_b
        w.lower_block(p, tp, p.nodes[s].c)
        w.jump(step_b)
        w.loop_depth -= 1
        w.f.active_bb = step_b
        nv := w.bin(BIN_ADD, w.load_local(slot, 0), w.konst(1))
        w.store_local(slot, 0, nv)
        w.jump(cond_b)
        w.f.active_bb = done_b
        <<
    }
    if k == ast.NK_FOR_EACH {
        w.lower_for_each(p, tp, s)
        <<
    }
    if k == ast.NK_BREAK || k == ast.NK_CONTINUE {
        if w.loop_depth == 0 {
            w.fail(p, s, "break/continue outside a loop")
            <<
        }
        if k == ast.NK_BREAK {
            w.jump(w.brk[w.loop_depth - 1])
        } else {
            w.jump(w.cont[w.loop_depth - 1])
        }
        <<
    }
    if k == ast.NK_EXIT {
        $args := []int{}
        args.push(w.lower_expr(p, tp, p.nodes[s].a))
        w.call_core("exit_process", &args)
        w.ret(w.konst(0))
        <<
    }
    if w.err_stmt(p, tp, s) || w.enum_stmt(p, tp, s) || w.chan_stmt(p, tp, s) {
        <<
    }
    w.fail(p, s, "statement " + types.ast_kind_name(k) + " is not supported yet")
}

fn (w $&Lw) lower_if(p &parser.Parser, tp &types.TypedProgram, s int) {
    done_b := w.new_block()
    $br := p.nodes[s].a
    while br >= 0 {
        cond := p.nodes[br].a
        if cond < 0 {
            w.lower_block(p, tp, p.nodes[br].b)
            w.jump(done_b)
            <-
        }
        c := w.lower_expr(p, tp, cond)
        then_b := w.new_block()
        next_b := w.new_block()
        w.branch(c, then_b, next_b)
        w.f.active_bb = then_b
        w.lower_block(p, tp, p.nodes[br].b)
        w.jump(done_b)
        w.f.active_bb = next_b
        br = p.nodes[br].next
    }
    w.jump(done_b)
    w.f.active_bb = done_b
}

fn (w $&Lw) lower_for_each(p &parser.Parser, tp &types.TypedProgram, s int) {
    iter := p.nodes[s].a
    aty := tp.deref(tp.deref(tp.type_of(iter)))
    if types.is_map_type(aty) {
        w.map_for_each(p, tp, s)
        <<
    }
    if types.is_chan_type(aty) {
        w.chan_for_each(p, tp, s)
        <<
    }
    if !types.is_array_type(aty) {
        w.fail(p, s, "for-in over this type is not supported yet")
        <<
    }
    ety := tp.elem_of(aty)
    esize := tp.size_of(ety)
    d := w.array_desc(p, tp, iter, aty)
    dslot := w.new_local(1, 1, "it")
    w.store_local(dslot, 0, d)
    islot := w.new_local(1, 1, "i")
    w.store_local(islot, 0, w.konst(0))
    id := tp.local_of(s)
    cond_b := w.new_block()
    body_b := w.new_block()
    step_b := w.new_block()
    done_b := w.new_block()
    w.jump(cond_b)
    w.f.active_bb = cond_b
    iv := w.load_local(islot, 0)
    nv := w.load_ptr(w.load_local(dslot, 0), 8, 8)
    w.branch(w.bin(BIN_LT, iv, nv), body_b, done_b)
    w.f.active_bb = body_b
    data := w.load_ptr(w.load_local(dslot, 0), 0, 8)
    ea := w.bin(BIN_ADD, data, w.bin(BIN_MUL, w.load_local(islot, 0), w.konst(esize)))
    if is_wide(tp, ety) {
        w.store_to_local(tp, id, ea)
    } else {
        w.store_to_local(tp, id, w.load_ptr(ea, 0, width_of(tp, ety)))
    }
    w.loop_enter(done_b, step_b)
    w.lower_block(p, tp, p.nodes[s].c)
    w.jump(step_b)
    w.loop_depth -= 1
    w.f.active_bb = step_b
    w.store_local(islot, 0, w.bin(BIN_ADD, w.load_local(islot, 0), w.konst(1)))
    w.jump(cond_b)
    w.f.active_bb = done_b
}

// Type of an assignment target. The checker does not record node types on
// every target, so derive it from the base value where needed.
fn (w $&Lw) place_type(p &parser.Parser, tp &types.TypedProgram, n int) int {
    k := p.nodes[n].kind
    if k == ast.NK_IDENT && tp.local_of(n) >= 0 {
        << tp.deref(w.local_type(tp, tp.local_of(n)))
    }
    if k == ast.NK_FIELD || k == ast.NK_INDEX {
        bty := tp.deref(tp.deref(w.place_type(p, tp, p.nodes[n].a)))
        if k == ast.NK_FIELD && types.is_struct_type(bty) {
            fname := p.nodes[n].sval + ""
            fld := tp.field_of(bty, &fname)
            if fld.offset >= 0 {
                << tp.deref(fld.ty)
            }
        }
        if k == ast.NK_INDEX {
            if bty == 3 {
                << 10
            }
            if types.is_array_type(bty) {
                << tp.deref(tp.elem_of(bty))
            }
        }
    }
    if k == ast.NK_UN_OP && p.nodes[n].ival == ast.UN_DEREF {
        << tp.deref(w.place_type(p, tp, p.nodes[n].a))
    }
    << tp.deref(tp.type_of(n))
}

fn (w $&Lw) lower_assign(p &parser.Parser, tp &types.TypedProgram, s int) {
    target := p.nodes[s].a
    aop := p.nodes[s].ival
    tk := p.nodes[target].kind
    tty := w.place_type(p, tp, target)
    // Assigning a reference to a reference-typed place rebinds it.
    if aop == ast.AS_ASSIGN && (tk == ast.NK_IDENT || tk == ast.NK_FIELD || tk == ast.NK_INDEX) && w.expr_is_ref(p, tp, target) && w.expr_is_ref(p, tp, p.nodes[s].b) {
        v := w.lower_expr(p, tp, p.nodes[s].b)
        if tk == ast.NK_IDENT && tp.local_of(target) >= 0 {
            w.store_local(w.ensure_local(tp, tp.local_of(target)), 0, v)
        } else {
            w.store_ptr(w.lower_place_addr(p, tp, target), 0, v, 8)
        }
        <<
    }
    if tk == ast.NK_IDENT && tp.local_of(target) >= 0 && !types.is_ref_type(w.local_type(tp, tp.local_of(target))) {
        id := tp.local_of(target)
        lty := w.local_type(tp, id)
        if lty == 3 && aop == ast.AS_ADD {
            slot := w.ensure_local(tp, id)
            d := w.local_addr(slot)
            rhs := w.base_addr(p, tp, p.nodes[s].b)
            $args := []int{}
            args.push(d)
            args.push(d)
            args.push(rhs)
            w.call_core("str_concat", &args)
            <<
        }
        $v := -1
        if lty == 3 {
            v = w.string_copy_init(p, tp, p.nodes[s].b)
        } else {
            v = w.lower_expr(p, tp, p.nodes[s].b)
        }
        if aop > ast.AS_ASSIGN {
            old := w.lower_ident(p, tp, target)
            v = w.checked_bin(assign_op_code(lty, aop), old, v, lty)
        }
        w.store_to_local(tp, id, v)
        <<
    }
    if tk == ast.NK_INDEX && (tp.call_of(target) == -77 || tp.call_of(target) == -78) {
        w.map_assign(p, tp, s)
        <<
    }
    $addr := -1
    if tk == ast.NK_IDENT {
        addr = w.lower_addr(p, tp, target)
    } else if tk == ast.NK_FIELD || tk == ast.NK_INDEX {
        addr = w.lower_place_addr(p, tp, target)
    } else if tk == ast.NK_UN_OP && p.nodes[target].ival == ast.UN_DEREF {
        addr = w.lower_expr(p, tp, p.nodes[target].a)
    } else {
        w.fail(p, s, "assignment target " + types.ast_kind_name(tk) + " is not supported yet")
        <<
    }
    $width := width_of(tp, tty)
    if tk == ast.NK_INDEX && tp.deref(tp.deref(tp.type_of(p.nodes[target].a))) == 3 {
        width = 1
    }
    if tty == 3 && aop == ast.AS_ADD {
        rhs := w.base_addr(p, tp, p.nodes[s].b)
        $args := []int{}
        args.push(addr)
        args.push(addr)
        args.push(rhs)
        w.call_core("str_concat", &args)
        <<
    }
    $v := w.lower_expr(p, tp, p.nodes[s].b)
    if is_wide(tp, tty) {
        w.copy_mem(addr, v, tp.size_of(tty))
        <<
    }
    if aop > ast.AS_ASSIGN {
        old := w.load_ptr(addr, 0, width)
        v = w.checked_bin(assign_op_code(tty, aop), old, v, tp.deref(tty))
    }
    w.store_ptr(addr, 0, v, width)
}

// ===== functions =====

fn lower_fn(p &parser.Parser, tp $&types.TypedProgram, fi int, tgt_os int, core_names &[]string, core_labels &[]string, errs $&[]int) MFn {
    tp.use_fn(fi)
    $w := lw_new(tp.fns[fi].name, tp.fns[fi].label, fi, tgt_os)
    for i in 0:core_names.len {
        w.core_names.push(core_names[i] + "")
        w.core_labels.push(core_labels[i] + "")
    }
    tfn := ~tp.fns[fi]
    w.ret_ty = tfn.ret
    w.f.ret = tfn.ret
    w.f.blocks.push(mblock_new())
    w.f.active_bb = 0
    // Incoming words: [okp | sret] [receiver] params.
    if fn_throws(tp, fi) {
        w.okp = w.new_local(1, 1, "okp")
    } else if tfn.ret != 0 && is_wide(tp, tfn.ret) {
        w.sret = w.new_local(1, 1, "sret")
    }
    $nin := 0
    if tfn.recv >= 0 {
        nin = 1
    }
    nin += tfn.params.len
    $incoming := []int{}
    for i in 0:nin {
        incoming.push(w.new_local(1, 1, "arg" + str(i)))
    }
    w.f.nparams = w.f.locals.len
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    for i in 0:nin {
        ty := w.local_type(tp, i)
        while w.lslot.len <= i {
            w.lslot.push(-1)
        }
        if i == 0 && tfn.recv >= 0 && !types.is_ref_type(ty) {
            w.lslot[i] = incoming[i]
            w.lbyref[incoming[i]] = true
        } else if is_wide(tp, ty) {
            slot := w.ensure_local(tp, i)
            src := w.load_local(incoming[i], 0)
            w.copy_mem(w.addr_local(slot), src, tp.size_of(ty))
        } else {
            w.lslot[i] = incoming[i]
        }
    }
    w.lower_block(p, tp, p.nodes[tfn.decl].c)
    w.ret(w.konst(0))
    while w.lbyref.len < w.f.locals.len {
        w.lbyref.push(false)
    }
    errs.push(w.errors)
    << mfn_copy(&w.f)
}

// Lower every concrete function. Returns the number of reported errors.
// all=true lowers every concrete function (diagnostics for coverage gaps).
pub fn lower_typed(p &parser.Parser, tp $&types.TypedProgram, tgt_os int, all bool, out $&Mir) int {
    $core_names := []string{}
    $core_labels := []string{}
    for i in 0:tp.fns.len {
        if tp.fns[i].mod_id == "runtime/core" && tp.fns[i].recv < 0 {
            core_names.push(tp.fns[i].name + "")
            core_labels.push(tp.fns[i].label + "")
        }
    }
    err_collect_boxes(p, tp)
    // Lower on demand from main: a function is lowered once some lowered
    // body calls its label, so unused library code is never required to
    // be lowerable.
    $by_label := label_index_new(tp.fns.len * 2 + 16)
    for fi in 0:tp.fns.len {
        if tp.fns[fi].is_template || tp.fns[fi].is_extern || tp.fns[fi].decl < 0 {
            ->
        }
        by_label.put(tp.fns[fi].label, fi)
    }
    // Queue keys: function index, or tp.fns.len + index for its fn-value shim.
    $queued := []bool{}
    for fi in 0:tp.fns.len * 2 {
        queued.push(false)
    }
    $queue := []int{}
    main_label := "_xu_main"
    main_fi := by_label.get(&main_label)
    if main_fi >= 0 {
        queue.push(main_fi)
        queued[main_fi] = true
    }
    if all {
        for fi in 0:tp.fns.len {
            if !queued[fi] && by_label.get(&tp.fns[fi].label) == fi {
                queued[fi] = true
                queue.push(fi)
            }
        }
    }
    $errs := []int{}
    $qi := 0
    while qi < queue.len {
        fi := queue[qi]
        qi += 1
        $f := lower_queued(p, tp, fi, tgt_os, &core_names, &core_labels, $&errs)
        for ii in 0:f.instrs.len {
            if f.instrs[ii].kind == MI_CALL || f.instrs[ii].kind == MI_LOAD_FN_ADDR {
                $callee := by_label.get(f.instrs[ii].sval)
                if callee < 0 {
                    callee = fnval_shim_key(tp, &by_label, f.instrs[ii].sval)
                }
                if callee >= 0 && !queued[callee] {
                    queued[callee] = true
                    queue.push(callee)
                }
            }
        }
        out.fns.push(f)
    }
    $errors := 0
    for ei in 0:errs.len {
        errors += errs[ei]
    }
    << errors
}

fn (w $&Lw) call_noargs(label string) int {
    $none := []int{}
    << w.call(label, &none)
}

fn (w $&Lw) loop_enter(brk_b int, cont_b int) {
    if w.loop_depth < w.brk.len {
        w.brk[w.loop_depth] = brk_b
        w.cont[w.loop_depth] = cont_b
    } else {
        w.brk.push(brk_b)
        w.cont.push(cont_b)
    }
    w.loop_depth += 1
}

fn mfn_copy(f &MFn) MFn {
    $out := mfn_new(f.name + "", f.label + "")
    out.ret = f.ret
    out.ret_nslots = f.ret_nslots
    out.nparams = f.nparams
    out.receiver = f.receiver
    out.is_extern = f.is_extern
    out.is_pub = f.is_pub
    for i in 0:f.local_names.len {
        out.local_names.push(f.local_names[i] + "")
    }
    for i in 0:f.locals.len {
        out.locals.push(f.locals[i])
        out.locals_nslots.push(f.locals_nslots[i])
        out.locals_owning.push(f.locals_owning[i])
    }
    for i in 0:f.temps.len {
        out.temps.push(f.temps[i])
        out.temps_nslots.push(f.temps_nslots[i])
    }
    for i in 0:f.instrs.len {
        $ins := minstr_new(f.instrs[i].kind)
        ins.a = f.instrs[i].a
        ins.b = f.instrs[i].b
        ins.c = f.instrs[i].c
        ins.d = f.instrs[i].d
        ins.sval = f.instrs[i].sval + ""
        ins.next = f.instrs[i].next
        ins.line = f.instrs[i].line
        ins.col = f.instrs[i].col
        ins.file = f.instrs[i].file
        out.instrs.push(ins)
    }
    for i in 0:f.margs.len {
        out.margs.push(MArg{v: f.margs[i].v, next: f.margs[i].next})
    }
    for i in 0:f.blocks.len {
        $b := mblock_new()
        b.head = f.blocks[i].head
        b.tail = f.blocks[i].tail
        b.tkind = f.blocks[i].tkind
        b.ta = f.blocks[i].ta
        b.tb = f.blocks[i].tb
        b.tc = f.blocks[i].tc
        b.line = f.blocks[i].line
        out.blocks.push(b)
    }
    for i in 0:f.consts.len {
        out.consts.push(f.consts[i])
    }
    out.active_bb = f.active_bb
    << out
}

// Open-addressing string -> int index (labels to function ids).
struct LabelIndex {
    keys []string
    vals []int
    used []bool
    mask int
}

fn label_index_new(min_cap int) LabelIndex {
    $cap := 16
    while cap < min_cap * 2 {
        cap = cap * 2
    }
    $li := LabelIndex{keys: []string{}, vals: []int{}, used: []bool{}, mask: cap - 1}
    for i in 0:cap {
        li.keys.push("")
        li.vals.push(-1)
        li.used.push(false)
    }
    << li
}

fn label_hash(s &string) int {
    $h := 5381
    for i in 0:s.len {
        h = (h * 33 + s[i]) & 0x3fffffff
    }
    << h
}

fn (li $&LabelIndex) put(key &string, v int) {
    $i := label_hash(key) & li.mask
    while li.used[i] && li.keys[i] != *key {
        i = (i + 1) & li.mask
    }
    li.used[i] = true
    li.keys[i] = *key + ""
    li.vals[i] = v
}

fn (li &LabelIndex) get(key &string) int {
    $i := label_hash(key) & li.mask
    while li.used[i] {
        if li.keys[i] == *key {
            << li.vals[i]
        }
        i = (i + 1) & li.mask
    }
    << -1
}
