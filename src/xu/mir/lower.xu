@xu/mir
// AST to MIR lowering pass.
//
// Layer 3 module: lowers front-end AST and Parser node pools into clean,
// deterministic SSA/linear MIR functions without Checker/Sema coupling.

#xu/ast
#xu/parser

fn is_str_len(s &string) bool {
    if s.len != 3 {
        << false
    }
    if s[0] == 108 && s[1] == 101 && s[2] == 110 {
        << true
    }
    << false
}

fn is_str_cap(s &string) bool {
    if s.len != 3 {
        << false
    }
    if s[0] == 99 && s[1] == 97 && s[2] == 112 {
        << true
    }
    << false
}

fn is_str_push(s &string) bool {
    if s.len != 4 {
        << false
    }
    if s[0] == 112 && s[1] == 117 && s[2] == 115 && s[3] == 104 {
        << true
    }
    << false
}

fn is_str_main(s &string) bool {
    if s.len != 4 {
        << false
    }
    if s[0] == 109 && s[1] == 97 && s[2] == 105 && s[3] == 110 {
        << true
    }
    << false
}

struct LowerEnv {
    names []string
    slots []int
    is_string []bool
    is_ptr []bool
    is_slice_ref []bool
}

fn lower_env_new() LowerEnv {
    << LowerEnv{
        names: []string{},
        slots: []int{},
        is_string: []bool{},
        is_ptr: []bool{},
        is_slice_ref: []bool{}
    }
}

fn (env $&LowerEnv) bind(name string, slot int) {
    env.names.push(~name)
    env.slots.push(slot)
    while env.is_string.len <= slot {
        env.is_string.push(false)
    }
    while env.is_ptr.len <= slot {
        env.is_ptr.push(false)
    }
    while env.is_slice_ref.len <= slot {
        env.is_slice_ref.push(false)
    }
}

fn (env $&LowerEnv) mark_ptr(slot int) {
    while env.is_ptr.len <= slot {
        env.is_ptr.push(false)
    }
    env.is_ptr[slot] = true
}

fn (env $&LowerEnv) mark_string(slot int) {
    while env.is_string.len <= slot {
        env.is_string.push(false)
    }
    env.is_string[slot] = true
}

fn (env $&LowerEnv) mark_slice_ref(slot int) {
    while env.is_slice_ref.len <= slot {
        env.is_slice_ref.push(false)
    }
    env.is_slice_ref[slot] = true
}

fn (env &LowerEnv) lookup(name string) int {
    $i := env.names.len - 1
    while i >= 0 {
        if env.names[i] == name {
            << env.slots[i]
        }
        i -= 1
    }
    << -1
}

fn is_string_expr(nodes &[]ast.Node, nid int, env &LowerEnv) bool {
    if nid < 0 || nid >= nodes.len {
        << false
    }
    k := nodes[nid].kind
    if k == ast.NK_STR {
        << true
    }
    if k == ast.NK_CLONE {
        << is_string_expr(nodes, nodes[nid].a, env)
    }
    if k == ast.NK_CALL {
        if nodes[nid].sval == "str" || nodes[nid].sval == "read" || nodes[nid].sval == "read_file" || nodes[nid].sval == "getenv" || nodes[nid].sval == "string" {
            << true
        }
    }
    if k == ast.NK_IDENT {
        slot := env.lookup(nodes[nid].sval)
        if slot >= 0 && slot < env.is_string.len && env.is_string[slot] {
            << true
        }
    }
    if k == ast.NK_BIN_OP && nodes[nid].ival == 1 {
        if is_string_expr(nodes, nodes[nid].a, env) || is_string_expr(nodes, nodes[nid].b, env) {
            << true
        }
    }
    << false
}

fn find_field_idx(nodes &[]ast.Node, field_name string) int {
    for i in 0:nodes.len {
        if nodes[i].kind == ast.NK_STRUCT {
            $fld := nodes[i].a
            $idx := 0
            while fld >= 0 && fld < nodes.len {
                fnode := ~nodes[fld]
                if fnode.sval == field_name {
                    << idx
                }
                idx += 1
                fld = fnode.next
            }
        }
    }
    << 0
}

fn lower_expr(mfn $&MFn, nodes &[]ast.Node, nid int, env &LowerEnv) int {
    if nid < 0 || nid >= nodes.len {
        << -1
    }

    k := nodes[nid].kind
    if k == ast.NK_INT {
        << alloc_const(mfn, nodes[nid].ival)
    }

    if k == ast.NK_STR {
        dest := alloc_temp(mfn)
        $ins := minstr_new(MI_STR_CONST)
        ins.a = dest
        ins.sval = ~nodes[nid].sval
        emit_instr(mfn, ins)
        << dest
    }

    if k == ast.NK_IDENT {
        slot := env.lookup(nodes[nid].sval)
        if slot >= 0 {
            t := alloc_temp(mfn)
            $ins := minstr_new(MI_LOAD_LOCAL)
            ins.a = t
            ins.b = slot
            emit_instr(mfn, ins)
            << t
        }
        << -1
    }

    if k == ast.NK_CALL {
        fn_name := nodes[nid].sval
        $callee_sym := "_" + fn_name
        if fn_name == "println" {
            arg_node := nodes[nid].a
            if arg_node >= 0 && arg_node < nodes.len {
                if is_string_expr(nodes, arg_node, env) {
                    callee_sym = "_println_str"
                } else {
                    callee_sym = "_println_int"
                }
            }
        }

        $arg_node := nodes[nid].a
        $head_marg := -1
        $last_marg := -1
        while arg_node >= 0 && arg_node < nodes.len {
            arg_val := lower_expr(mfn, nodes, arg_node, env)
            mid := mfn.margs.len
            mfn.margs.push(MArg{
                v: arg_val,
                next: -1
            })
            if head_marg < 0 {
                head_marg = mid
            } else {
                mfn.margs[last_marg].next = mid
            }
            last_marg = mid
            arg_node = nodes[arg_node].next
        }

        dest := alloc_temp(mfn)
        $ins := minstr_new(MI_CALL)
        ins.a = dest
        ins.c = head_marg
        ins.sval = callee_sym
        emit_instr(mfn, ins)
        << dest
    }

    if k == ast.NK_INDEX {
        base_node := nodes[nid].a
        idx_node := nodes[nid].b
        $is_ref := false
        if base_node >= 0 && base_node < nodes.len && nodes[base_node].kind == ast.NK_IDENT {
            bslot := env.lookup(nodes[base_node].sval)
            if bslot >= 0 && bslot < env.is_slice_ref.len && env.is_slice_ref[bslot] {
                is_ref = true
            }
        }
        $t_base := lower_expr(mfn, nodes, base_node, env)
        if is_ref {
            c_zero := alloc_const(mfn, 0)
            t_data := alloc_temp(mfn)
            $ins_deref := minstr_new(MI_LOAD_INDEX)
            ins_deref.a = t_data
            ins_deref.b = t_base
            ins_deref.c = c_zero
            emit_instr(mfn, ins_deref)
            t_base = t_data
        }
        t_idx := lower_expr(mfn, nodes, idx_node, env)
        dest := alloc_temp(mfn)
        $ins := minstr_new(MI_LOAD_INDEX)
        ins.a = dest
        ins.b = t_base
        ins.c = t_idx
        if is_string_expr(nodes, base_node, env) {
            ins.d = 1
        }
        emit_instr(mfn, ins)
        << dest
    }

    if k == ast.NK_BIN_OP {
        lhs := lower_expr(mfn, nodes, nodes[nid].a, env)
        rhs := lower_expr(mfn, nodes, nodes[nid].b, env)

        $op_code := BIN_ADD
        ast_op := nodes[nid].ival
        if ast_op == 1 {
            if is_string_expr(nodes, nodes[nid].a, env) || is_string_expr(nodes, nodes[nid].b, env) {
                op_code = BIN_STR_ADD
            } else {
                op_code = BIN_ADD
            }
        } else if ast_op == 2 {
            op_code = BIN_SUB
        } else if ast_op == 3 {
            op_code = BIN_MUL
        } else if ast_op == 4 {
            op_code = BIN_DIV
        } else if ast_op == 5 {
            op_code = BIN_MOD
        } else if ast_op == 6 {
            if is_string_expr(nodes, nodes[nid].a, env) || is_string_expr(nodes, nodes[nid].b, env) {
                op_code = BIN_STR_EQ
            } else {
                op_code = BIN_EQ
            }
        } else if ast_op == 7 {
            if is_string_expr(nodes, nodes[nid].a, env) || is_string_expr(nodes, nodes[nid].b, env) {
                op_code = BIN_STR_NE
            } else {
                op_code = BIN_NE
            }
        } else if ast_op == 8 {
            op_code = BIN_LT
        } else if ast_op == 9 {
            op_code = BIN_LE
        } else if ast_op == 10 {
            op_code = BIN_GT
        } else if ast_op == 11 {
            op_code = BIN_GE
        } else if ast_op == 12 || ast_op == 14 {
            op_code = BIN_AND
        } else if ast_op == 13 || ast_op == 15 {
            op_code = BIN_OR
        }

        dest := alloc_temp(mfn)
        $ins := minstr_new(MI_BIN)
        ins.a = dest
        ins.b = op_code
        ins.c = lhs
        ins.d = rhs
        emit_instr(mfn, ins)
        << dest
    }

    if k == ast.NK_FIELD {
        base_node := nodes[nid].a
        if base_node >= 0 && base_node < nodes.len && nodes[base_node].kind == ast.NK_FIELD {
            inner_base := nodes[base_node].a
            inner_field := nodes[base_node].sval
            outer_field := nodes[nid].sval

            $inner_base_slot := -1
            if inner_base >= 0 && inner_base < nodes.len && nodes[inner_base].kind == ast.NK_IDENT {
                inner_base_slot = env.lookup(nodes[inner_base].sval)
            }
            if inner_base_slot >= 0 {
                // If it's a local struct field like "s.a.len", check env lookup first
                full_field_name := nodes[inner_base].sval + "." + inner_field + "." + outer_field
                full_slot := env.lookup(full_field_name)
                if full_slot >= 0 {
                    t_fast := alloc_temp(mfn)
                    $ins_fast := minstr_new(MI_LOAD_LOCAL)
                    ins_fast.a = t_fast
                    ins_fast.b = full_slot
                    emit_instr(mfn, ins_fast)
                    << t_fast
                }

                $t_struct := -1
                if inner_base_slot < env.is_ptr.len && env.is_ptr[inner_base_slot] {
                    // inner_base is already a pointer (e.g. method receiver s &Sorter)
                    t_struct = alloc_temp(mfn)
                    $ins_ld := minstr_new(MI_LOAD_LOCAL)
                    ins_ld.a = t_struct
                    ins_ld.b = inner_base_slot
                    emit_instr(mfn, ins_ld)
                } else {
                    // inner_base is a local value on stack, take its address
                    t_struct = alloc_temp(mfn)
                    $ins_addr := minstr_new(MI_ADDR)
                    ins_addr.a = t_struct
                    ins_addr.b = inner_base_slot
                    emit_instr(mfn, ins_addr)
                }

                f_base := find_field_idx(nodes, inner_field)
                $sub_off := 0
                if is_str_len(&outer_field) {
                    sub_off = 1
                } else if is_str_cap(&outer_field) {
                    sub_off = 2
                }
                c_idx := alloc_const(mfn, f_base + sub_off)
                dest := alloc_temp(mfn)
                $ins_fld := minstr_new(MI_LOAD_INDEX)
                ins_fld.a = dest
                ins_fld.b = t_struct
                ins_fld.c = c_idx
                emit_instr(mfn, ins_fld)
                << dest
            }
        }
        $t_base := -1
        if base_node >= 0 && base_node < nodes.len {
            if nodes[base_node].kind == ast.NK_IDENT {
                field_name := nodes[base_node].sval + "." + nodes[nid].sval
                slot := env.lookup(field_name)
                if slot >= 0 {
                    t := alloc_temp(mfn)
                    $ins := minstr_new(MI_LOAD_LOCAL)
                    ins.a = t
                    ins.b = slot
                    emit_instr(mfn, ins)
                    << t
                }
                base_slot := env.lookup(nodes[base_node].sval)
                if base_slot >= 0 {
                    t_base = alloc_temp(mfn)
                    $ins_base := minstr_new(MI_LOAD_LOCAL)
                    ins_base.a = t_base
                    ins_base.b = base_slot
                    emit_instr(mfn, ins_base)
                }
            } else {
                t_base = lower_expr(mfn, nodes, base_node, env)
            }
        }
        if t_base >= 0 {
            $f_idx := find_field_idx(nodes, nodes[nid].sval)
            if is_str_len(&nodes[nid].sval) {
                f_idx = 1
            } else if is_str_cap(&nodes[nid].sval) {
                f_idx = 2
            }
            c_idx := alloc_const(mfn, f_idx)

            dest := alloc_temp(mfn)
            $ins_ld := minstr_new(MI_LOAD_INDEX)
            ins_ld.a = dest
            ins_ld.b = t_base
            ins_ld.c = c_idx
            emit_instr(mfn, ins_ld)
            << dest
        }
        << -1
    }

    if k == ast.NK_TERNARY {
        cond_node := nodes[nid].a
        then_node := nodes[nid].b
        else_node := nodes[nid].c

        cur_bb := mfn.active_bb
        then_id := mfn.blocks.len
        $then_bb := mblock_new()
        mfn.blocks.push(then_bb)

        else_id := mfn.blocks.len
        $else_bb := mblock_new()
        mfn.blocks.push(else_bb)

        merge_id := mfn.blocks.len
        $merge_bb := mblock_new()
        mfn.blocks.push(merge_bb)

        cond_val := lower_expr(mfn, nodes, cond_node, env)
        mfn.blocks[cur_bb].tkind = TKIND_BRANCH
        mfn.blocks[cur_bb].ta = cond_val
        mfn.blocks[cur_bb].tb = then_id
        mfn.blocks[cur_bb].tc = else_id

        dest := alloc_temp(mfn)

        // Lower then branch
        mfn.active_bb = then_id
        then_val := lower_expr(mfn, nodes, then_node, env)
        $ins_then := minstr_new(MI_COPY)
        ins_then.a = dest
        ins_then.b = then_val
        emit_instr(mfn, ins_then)
        cur_then := mfn.active_bb
        if mfn.blocks[cur_then].tkind == TKIND_OPEN {
            mfn.blocks[cur_then].tkind = TKIND_JUMP
            mfn.blocks[cur_then].ta = merge_id
        }

        // Lower else branch
        mfn.active_bb = else_id
        else_val := lower_expr(mfn, nodes, else_node, env)
        $ins_else := minstr_new(MI_COPY)
        ins_else.a = dest
        ins_else.b = else_val
        emit_instr(mfn, ins_else)
        cur_else := mfn.active_bb
        if mfn.blocks[cur_else].tkind == TKIND_OPEN {
            mfn.blocks[cur_else].tkind = TKIND_JUMP
            mfn.blocks[cur_else].ta = merge_id
        }

        mfn.active_bb = merge_id
        << dest
    }

    if k == ast.NK_BOOL {
        << alloc_const(mfn, nodes[nid].ival)
    }

    if k == ast.NK_CLONE {
        << lower_expr(mfn, nodes, nodes[nid].a, env)
    }

    if k == ast.NK_OR_CATCH {
        << lower_expr(mfn, nodes, nodes[nid].a, env)
    }

    if k == ast.NK_BORROW {
        arg_nid := nodes[nid].a
        if arg_nid >= 0 && arg_nid < nodes.len && nodes[arg_nid].kind == ast.NK_IDENT {
            slot := env.lookup(nodes[arg_nid].sval)
            if slot >= 0 {
                t_addr := alloc_temp(mfn)
                $ins_addr := minstr_new(MI_ADDR)
                ins_addr.a = t_addr
                ins_addr.b = slot
                emit_instr(mfn, ins_addr)
                << t_addr
            }
        }
        << lower_expr(mfn, nodes, arg_nid, env)
    }

    if k == ast.NK_UN_OP {
        op := nodes[nid].ival
        operand := lower_expr(mfn, nodes, nodes[nid].a, env)
        if op == 1 { // UN_NEG: 0 - x
            czero := alloc_const(mfn, 0)
            dest := alloc_temp(mfn)
            $ins := minstr_new(MI_BIN)
            ins.a = dest
            ins.b = BIN_SUB
            ins.c = czero
            ins.d = operand
            emit_instr(mfn, ins)
            << dest
        } else if op == 2 { // UN_NOT: x == 0
            czero := alloc_const(mfn, 0)
            dest := alloc_temp(mfn)
            $ins := minstr_new(MI_BIN)
            ins.a = dest
            ins.b = BIN_EQ
            ins.c = operand
            ins.d = czero
            emit_instr(mfn, ins)
            << dest
        }
        << operand
    }

    if k == ast.NK_METHOD_CALL {
        method_name := nodes[nid].sval
        rec_nid := nodes[nid].a
        $is_pkg_call := false
        $rec_slot := -1
        if rec_nid >= 0 && rec_nid < nodes.len && nodes[rec_nid].kind == ast.NK_IDENT {
            rec_name := nodes[rec_nid].sval
            rec_slot = env.lookup(rec_name)
            if rec_slot < 0 {
                is_pkg_call = true
            }
        }

        if is_str_push(&method_name) && rec_slot >= 0 {
            t_addr := alloc_temp(mfn)
            $ins_addr := minstr_new(MI_ADDR)
            ins_addr.a = t_addr
            ins_addr.b = rec_slot
            emit_instr(mfn, ins_addr)

            arg_nid := nodes[nid].b
            t_val := lower_expr(mfn, nodes, arg_nid, env)

            m0 := mfn.margs.len
            mfn.margs.push(MArg{ v: t_addr, next: m0 + 1 })
            mfn.margs.push(MArg{ v: t_val, next: -1 })

            dest := alloc_temp(mfn)
            $ins_call := minstr_new(MI_CALL)
            ins_call.a = dest
            ins_call.c = m0
            ins_call.sval = "_xu_slice_push"
            emit_instr(mfn, ins_call)
            << dest
        }

        $head_marg := -1
        $last_marg := -1

        if !is_pkg_call {
            $t_rec := -1
            if rec_slot >= 0 {
                t_rec = alloc_temp(mfn)
                if rec_slot < env.is_ptr.len && env.is_ptr[rec_slot] {
                    $ins_ld := minstr_new(MI_LOAD_LOCAL)
                    ins_ld.a = t_rec
                    ins_ld.b = rec_slot
                    emit_instr(mfn, ins_ld)
                } else {
                    $ins_addr := minstr_new(MI_ADDR)
                    ins_addr.a = t_rec
                    ins_addr.b = rec_slot
                    emit_instr(mfn, ins_addr)
                }
            } else {
                t_rec = lower_expr(mfn, nodes, rec_nid, env)
            }
            if t_rec >= 0 {
                mid := mfn.margs.len
                mfn.margs.push(MArg{ v: t_rec, next: -1 })
                head_marg = mid
                last_marg = mid
            }
        }

        $arg_node := nodes[nid].b
        while arg_node >= 0 && arg_node < nodes.len {
            arg_val := lower_expr(mfn, nodes, arg_node, env)
            mid := mfn.margs.len
            mfn.margs.push(MArg{
                v: arg_val,
                next: -1
            })
            if head_marg < 0 {
                head_marg = mid
            } else {
                mfn.margs[last_marg].next = mid
            }
            last_marg = mid
            arg_node = nodes[arg_node].next
        }

        dest := alloc_temp(mfn)
        $ins := minstr_new(MI_CALL)
        ins.a = dest
        ins.c = head_marg
        ins.sval = "_" + method_name
        emit_instr(mfn, ins)
        << dest
    }

    << -1
}

fn lower_stmt_list(mfn $&MFn, p &parser.Parser, head int, env $&LowerEnv) {
    $cur := head
    while cur >= 0 && cur < p.nodes.len {
        s := ~p.nodes[cur]

        if s.kind == ast.NK_LET {
            rhs_k := p.nodes[s.a].kind
            $is_args_call := false
            if rhs_k == ast.NK_CALL || rhs_k == ast.NK_METHOD_CALL {
                if p.nodes[s.a].sval == "argv" || p.nodes[s.a].sval == "sys_args" || p.nodes[s.a].sval == "args" {
                    is_args_call = true
                }
            }
            if is_args_call {
                ptr_slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval)

                len_slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval + ".len")

                cap_slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval + ".cap")

                env.bind(s.sval, ptr_slot)
                env.bind(s.sval + ".len", len_slot)
                env.bind(s.sval + ".cap", cap_slot)

                desc_val := lower_expr(mfn, &p.nodes, s.a, env)

                c0 := alloc_const(mfn, 0)
                t_ptr := alloc_temp(mfn)
                $ins_ld0 := minstr_new(MI_LOAD_INDEX)
                ins_ld0.a = t_ptr
                ins_ld0.b = desc_val
                ins_ld0.c = c0
                emit_instr(mfn, ins_ld0)

                $ins_st0 := minstr_new(MI_STORE_LOCAL)
                ins_st0.a = ptr_slot
                ins_st0.b = t_ptr
                emit_instr(mfn, ins_st0)

                c1 := alloc_const(mfn, 1)
                t_len := alloc_temp(mfn)
                $ins_ld1 := minstr_new(MI_LOAD_INDEX)
                ins_ld1.a = t_len
                ins_ld1.b = desc_val
                ins_ld1.c = c1
                emit_instr(mfn, ins_ld1)

                $ins_st1 := minstr_new(MI_STORE_LOCAL)
                ins_st1.a = len_slot
                ins_st1.b = t_len
                emit_instr(mfn, ins_st1)

                c2 := alloc_const(mfn, 2)
                t_cap := alloc_temp(mfn)
                $ins_ld2 := minstr_new(MI_LOAD_INDEX)
                ins_ld2.a = t_cap
                ins_ld2.b = desc_val
                ins_ld2.c = c2
                emit_instr(mfn, ins_ld2)

                $ins_st2 := minstr_new(MI_STORE_LOCAL)
                ins_st2.a = cap_slot
                ins_st2.b = t_cap
                emit_instr(mfn, ins_st2)
            } else if rhs_k == ast.NK_ARRAY_LIT || rhs_k == ast.NK_EMPTY_ARRAY {
                // Slice variable: allocate 3 consecutive slots (ptr, len, cap)
                ptr_slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval)

                len_slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval + ".len")

                cap_slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval + ".cap")

                env.bind(s.sval, ptr_slot)
                env.bind(s.sval + ".len", len_slot)
                env.bind(s.sval + ".cap", cap_slot)

                czero := alloc_const(mfn, 0)
                $ins0 := minstr_new(MI_STORE_LOCAL)
                ins0.a = ptr_slot
                ins0.b = czero
                emit_instr(mfn, ins0)

                $ins1 := minstr_new(MI_STORE_LOCAL)
                ins1.a = len_slot
                ins1.b = czero
                emit_instr(mfn, ins1)

                $ins2 := minstr_new(MI_STORE_LOCAL)
                ins2.a = cap_slot
                ins2.b = czero
                emit_instr(mfn, ins2)
            } else if rhs_k == ast.NK_STRUCT_INIT {
                $fld := p.nodes[s.a].a
                $is_first := true
                while fld >= 0 && fld < p.nodes.len {
                    fnode := ~p.nodes[fld]
                    fname := s.sval + "." + fnode.sval
                    fval := lower_expr(mfn, &p.nodes, fnode.a, env)
                    fslot := mfn.locals.len
                    mfn.locals.push(1)
                    mfn.locals_nslots.push(1)
                    mfn.locals_owning.push(false)
                    mfn.local_names.push(~fname)
                    env.bind(~fname, fslot)
                    if is_first {
                        env.bind(s.sval, fslot)
                        is_first = false
                    }

                    $ins_st := minstr_new(MI_STORE_LOCAL)
                    ins_st.a = fslot
                    ins_st.b = fval
                    emit_instr(mfn, ins_st)

                    // If field argument is a slice, copy its len and cap slots consecutively
                    if fnode.a >= 0 && fnode.a < p.nodes.len && p.nodes[fnode.a].kind == ast.NK_IDENT {
                        src_ident := p.nodes[fnode.a].sval
                        src_len_slot := env.lookup(src_ident + ".len")
                        src_cap_slot := env.lookup(src_ident + ".cap")
                        if src_len_slot >= 0 {
                            fname_len := s.sval + "." + fnode.sval + ".len"
                            len_slot := mfn.locals.len
                            mfn.locals.push(1)
                            mfn.locals_nslots.push(1)
                            mfn.locals_owning.push(false)
                            mfn.local_names.push(~fname_len)
                            env.bind(~fname_len, len_slot)

                            t_len := alloc_temp(mfn)
                            $ins_ld_len := minstr_new(MI_LOAD_LOCAL)
                            ins_ld_len.a = t_len
                            ins_ld_len.b = src_len_slot
                            emit_instr(mfn, ins_ld_len)

                            $ins_st_len := minstr_new(MI_STORE_LOCAL)
                            ins_st_len.a = len_slot
                            ins_st_len.b = t_len
                            emit_instr(mfn, ins_st_len)

                            if src_cap_slot >= 0 {
                                fname_cap := s.sval + "." + fnode.sval + ".cap"
                                cap_slot := mfn.locals.len
                                mfn.locals.push(1)
                                mfn.locals_nslots.push(1)
                                mfn.locals_owning.push(false)
                                mfn.local_names.push(~fname_cap)
                                env.bind(~fname_cap, cap_slot)

                                t_cap := alloc_temp(mfn)
                                $ins_ld_cap := minstr_new(MI_LOAD_LOCAL)
                                ins_ld_cap.a = t_cap
                                ins_ld_cap.b = src_cap_slot
                                emit_instr(mfn, ins_ld_cap)

                                $ins_st_cap := minstr_new(MI_STORE_LOCAL)
                                ins_st_cap.a = cap_slot
                                ins_st_cap.b = t_cap
                                emit_instr(mfn, ins_st_cap)
                            }
                        }
                    }

                    fld = fnode.next
                }
            } else {
                val := lower_expr(mfn, &p.nodes, s.a, env)
                slot := mfn.locals.len
                mfn.locals.push(1)
                mfn.locals_nslots.push(1)
                mfn.locals_owning.push(false)
                mfn.local_names.push(~s.sval)
                env.bind(s.sval, slot)
                if is_string_expr(&p.nodes, s.a, env) {
                    env.mark_string(slot)
                }

                $ins := minstr_new(MI_STORE_LOCAL)
                ins.a = slot
                ins.b = val
                emit_instr(mfn, ins)
            }
        } else if s.kind == ast.NK_ASSIGN {
            target_node := ~p.nodes[s.a]
            if target_node.kind == ast.NK_INDEX {
                // a[idx] = val or a[idx] += val
                base_expr := target_node.a
                idx_expr := target_node.b
                $is_ref := false
                if base_expr >= 0 && base_expr < p.nodes.len && p.nodes[base_expr].kind == ast.NK_IDENT {
                    bslot := env.lookup(p.nodes[base_expr].sval)
                    if bslot >= 0 && bslot < env.is_slice_ref.len && env.is_slice_ref[bslot] {
                        is_ref = true
                    }
                }
                $t_base := lower_expr(mfn, &p.nodes, base_expr, env)
                if is_ref {
                    c_zero := alloc_const(mfn, 0)
                    t_data := alloc_temp(mfn)
                    $ins_deref := minstr_new(MI_LOAD_INDEX)
                    ins_deref.a = t_data
                    ins_deref.b = t_base
                    ins_deref.c = c_zero
                    emit_instr(mfn, ins_deref)
                    t_base = t_data
                }
                t_idx := lower_expr(mfn, &p.nodes, idx_expr, env)
                $t_val := lower_expr(mfn, &p.nodes, s.b, env)

                if s.ival > 1 {
                    // Compound assignment
                    t_old := alloc_temp(mfn)
                    $ins_ld := minstr_new(MI_LOAD_INDEX)
                    ins_ld.a = t_old
                    ins_ld.b = t_base
                    ins_ld.c = t_idx
                    if is_string_expr(&p.nodes, base_expr, env) {
                        ins_ld.d = 1
                    }
                    emit_instr(mfn, ins_ld)

                    $op_code := BIN_ADD
                    if s.ival == 2 { op_code = BIN_ADD }
                    else if s.ival == 3 { op_code = BIN_SUB }
                    else if s.ival == 4 { op_code = BIN_MUL }
                    else if s.ival == 5 { op_code = BIN_DIV }
                    else if s.ival == 6 { op_code = BIN_MOD }

                    t_new := alloc_temp(mfn)
                    $ins_bin := minstr_new(MI_BIN)
                    ins_bin.a = t_new
                    ins_bin.b = op_code
                    ins_bin.c = t_old
                    ins_bin.d = t_val
                    emit_instr(mfn, ins_bin)

                    t_val = t_new
                }

                $ins_st := minstr_new(MI_STORE_INDEX)
                ins_st.a = t_base
                ins_st.b = t_idx
                ins_st.c = t_val
                if is_string_expr(&p.nodes, base_expr, env) {
                    ins_st.d = 1
                }
                emit_instr(mfn, ins_st)
            } else if target_node.kind == ast.NK_FIELD {
                base_node := target_node.a
                if base_node >= 0 && base_node < p.nodes.len && p.nodes[base_node].kind == ast.NK_IDENT {
                    field_name := p.nodes[base_node].sval + "." + target_node.sval
                    slot := env.lookup(field_name)
                    $val := lower_expr(mfn, &p.nodes, s.b, env)
                    if slot >= 0 {
                        if s.ival > 1 {
                            old_t := alloc_temp(mfn)
                            $load_ins := minstr_new(MI_LOAD_LOCAL)
                            load_ins.a = old_t
                            load_ins.b = slot
                            emit_instr(mfn, load_ins)

                            $op_code := BIN_ADD
                            if s.ival == 2 {
                                if (slot >= 0 && slot < env.is_string.len && env.is_string[slot]) || is_string_expr(&p.nodes, s.a, env) {
                                    op_code = BIN_STR_ADD
                                } else {
                                    op_code = BIN_ADD
                                }
                            }
                            else if s.ival == 3 { op_code = BIN_SUB }
                            else if s.ival == 4 { op_code = BIN_MUL }
                            else if s.ival == 5 { op_code = BIN_DIV }
                            else if s.ival == 6 { op_code = BIN_MOD }

                            res_t := alloc_temp(mfn)
                            $bin_ins := minstr_new(MI_BIN)
                            bin_ins.a = res_t
                            bin_ins.b = op_code
                            bin_ins.c = old_t
                            bin_ins.d = val
                            emit_instr(mfn, bin_ins)

                            val = res_t
                        }

                        $ins := minstr_new(MI_STORE_LOCAL)
                        ins.a = slot
                        ins.b = val
                        emit_instr(mfn, ins)
                    } else {
                        base_slot := env.lookup(p.nodes[base_node].sval)
                        if base_slot >= 0 {
                            t_base := alloc_temp(mfn)
                            $ins_base := minstr_new(MI_LOAD_LOCAL)
                            ins_base.a = t_base
                            ins_base.b = base_slot
                            emit_instr(mfn, ins_base)

                            f_idx := find_field_idx(&p.nodes, target_node.sval)
                            c_idx := alloc_const(mfn, f_idx)

                            if s.ival > 1 {
                                old_t := alloc_temp(mfn)
                                $ins_ld := minstr_new(MI_LOAD_INDEX)
                                ins_ld.a = old_t
                                ins_ld.b = t_base
                                ins_ld.c = c_idx
                                emit_instr(mfn, ins_ld)

                                $op_code := BIN_ADD
                                if s.ival == 2 { op_code = BIN_ADD }
                                else if s.ival == 3 { op_code = BIN_SUB }
                                else if s.ival == 4 { op_code = BIN_MUL }
                                else if s.ival == 5 { op_code = BIN_DIV }
                                else if s.ival == 6 { op_code = BIN_MOD }

                                res_t := alloc_temp(mfn)
                                $bin_ins := minstr_new(MI_BIN)
                                bin_ins.a = res_t
                                bin_ins.b = op_code
                                bin_ins.c = old_t
                                bin_ins.d = val
                                emit_instr(mfn, bin_ins)

                                val = res_t
                            }

                            $ins_st := minstr_new(MI_STORE_INDEX)
                            ins_st.a = t_base
                            ins_st.b = c_idx
                            ins_st.c = val
                            emit_instr(mfn, ins_st)
                        }
                    }
                }
            } else {
                target_name := ~p.nodes[s.a].sval
                slot := env.lookup(target_name)
                $val := lower_expr(mfn, &p.nodes, s.b, env)

                if slot >= 0 {
                    if s.ival > 1 {
                        old_t := alloc_temp(mfn)
                        $load_ins := minstr_new(MI_LOAD_LOCAL)
                        load_ins.a = old_t
                        load_ins.b = slot
                        emit_instr(mfn, load_ins)

                        $op_code := BIN_ADD
                        if s.ival == 2 {
                            if (slot >= 0 && slot < env.is_string.len && env.is_string[slot]) || is_string_expr(&p.nodes, s.a, env) {
                                op_code = BIN_STR_ADD
                            } else {
                                op_code = BIN_ADD
                            }
                        }
                        else if s.ival == 3 { op_code = BIN_SUB }
                        else if s.ival == 4 { op_code = BIN_MUL }
                        else if s.ival == 5 { op_code = BIN_DIV }
                        else if s.ival == 6 { op_code = BIN_MOD }

                        res_t := alloc_temp(mfn)
                        $bin_ins := minstr_new(MI_BIN)
                        bin_ins.a = res_t
                        bin_ins.b = op_code
                        bin_ins.c = old_t
                        bin_ins.d = val
                        emit_instr(mfn, bin_ins)

                        val = res_t
                    }

                    $ins := minstr_new(MI_STORE_LOCAL)
                    ins.a = slot
                    ins.b = val
                    emit_instr(mfn, ins)
                }
            }
        } else if s.kind == ast.NK_EXPR_STMT {
            ea := s.a
            if ea >= 0 && ea < p.nodes.len && p.nodes[ea].kind == ast.NK_METHOD_CALL && is_str_push(&p.nodes[ea].sval) {
                // a.push(expr)
                rec := p.nodes[ea].a
                if rec >= 0 && rec < p.nodes.len && p.nodes[rec].kind == ast.NK_IDENT {
                    var_name := ~p.nodes[rec].sval
                    slot := env.lookup(var_name)
                    if slot >= 0 {
                        // Address of slice
                        t_addr := alloc_temp(mfn)
                        $ins_addr := minstr_new(MI_ADDR)
                        ins_addr.a = t_addr
                        ins_addr.b = slot
                        emit_instr(mfn, ins_addr)

                        // Argument value
                        arg_node := p.nodes[ea].b
                        t_val := lower_expr(mfn, &p.nodes, arg_node, env)

                        // MArg chain: arg0 = t_addr, arg1 = t_val
                        m0 := mfn.margs.len
                        mfn.margs.push(MArg{ v: t_addr, next: m0 + 1 })
                        mfn.margs.push(MArg{ v: t_val, next: -1 })

                        dest_unused := alloc_temp(mfn)
                        $ins_call := minstr_new(MI_CALL)
                        ins_call.a = dest_unused
                        ins_call.c = m0
                        ins_call.sval = "_xu_slice_push"
                        emit_instr(mfn, ins_call)
                    }
                }
            } else {
                lower_expr(mfn, &p.nodes, s.a, env)
            }
        } else if s.kind == ast.NK_WHILE {
            cur_bb := mfn.active_bb

            // Check if loop condition has a large integer constant RHS that can be hoisted to cur_bb (preheader)
            $hoisted_rhs_slot := -1
            $hoist_op_code := 0
            $hoist_lhs_node := -1
            if mfn.locals.len < 7 && s.a >= 0 && s.a < p.nodes.len && p.nodes[s.a].kind == ast.NK_BIN_OP {
                ast_op := p.nodes[s.a].ival
                if ast_op >= 6 && ast_op <= 11 {
                    rhs_n := p.nodes[s.a].b
                    if rhs_n >= 0 && rhs_n < p.nodes.len && p.nodes[rhs_n].kind == ast.NK_INT {
                        cval := p.nodes[rhs_n].ival
                        if cval > 4095 {
                            slot := mfn.locals.len
                            mfn.locals.push(1)
                            mfn.locals_nslots.push(1)
                            mfn.locals_owning.push(false)
                            name := "__loop_bound_" + str(slot)
                            mfn.local_names.push(~name)

                            c_vreg := alloc_const(mfn, cval)
                            $ins_st := minstr_new(MI_STORE_LOCAL)
                            ins_st.a = slot
                            ins_st.b = c_vreg
                            emit_instr(mfn, ins_st)

                            hoisted_rhs_slot = slot
                            hoist_lhs_node = p.nodes[s.a].a
                            if ast_op == 6 { hoist_op_code = BIN_EQ }
                            else if ast_op == 7 { hoist_op_code = BIN_NE }
                            else if ast_op == 8 { hoist_op_code = BIN_LT }
                            else if ast_op == 9 { hoist_op_code = BIN_LE }
                            else if ast_op == 10 { hoist_op_code = BIN_GT }
                            else if ast_op == 11 { hoist_op_code = BIN_GE }
                        }
                    }
                }
            }

            // Loop Inversion / Bottom-condition Rotation:
            // Order: [body_bb ... cur_body] -> [cond_bb] -> [exit_bb]
            // cur_bb jumps to cond_bb to check entry condition.
            // When loop iterates: cur_body falls through to cond_bb (0-cost),
            // cond_bb branches back to body_bb with a single backward branch,
            // and falls through to exit_bb on loop termination.
            body_id := mfn.blocks.len
            $body_bb := mblock_new()
            mfn.blocks.push(body_bb)

            // Lower body in body_bb
            mfn.active_bb = body_id
            lower_stmt_list(mfn, p, s.c, env)
            cur_body := mfn.active_bb

            // cond_bb is placed immediately after cur_body
            cond_id := mfn.blocks.len
            $cond_bb := mblock_new()
            mfn.blocks.push(cond_bb)

            if mfn.blocks[cur_body].tkind == TKIND_OPEN {
                mfn.blocks[cur_body].tkind = TKIND_JUMP
                mfn.blocks[cur_body].ta = cond_id
            }

            // exit_bb is placed immediately after cond_bb
            exit_id := mfn.blocks.len
            $exit_bb := mblock_new()
            mfn.blocks.push(exit_bb)

            // Lower condition in cond_bb
            mfn.active_bb = cond_id
            $cond_val := -1
            if hoisted_rhs_slot >= 0 {
                lhs_val := lower_expr(mfn, &p.nodes, hoist_lhs_node, env)
                rhs_val := alloc_temp(mfn)
                $ins_ld := minstr_new(MI_LOAD_LOCAL)
                ins_ld.a = rhs_val
                ins_ld.b = hoisted_rhs_slot
                emit_instr(mfn, ins_ld)

                cond_val = alloc_temp(mfn)
                $ins_cmp := minstr_new(MI_BIN)
                ins_cmp.a = cond_val
                ins_cmp.b = hoist_op_code
                ins_cmp.c = lhs_val
                ins_cmp.d = rhs_val
                emit_instr(mfn, ins_cmp)
            } else {
                cond_val = lower_expr(mfn, &p.nodes, s.a, env)
            }
            mfn.blocks[cond_id].tkind = TKIND_BRANCH
            mfn.blocks[cond_id].ta = cond_val
            mfn.blocks[cond_id].tb = body_id
            mfn.blocks[cond_id].tc = exit_id

            // Jump from cur_bb to cond_bb
            if cur_bb >= 0 && cur_bb < mfn.blocks.len {
                if mfn.blocks[cur_bb].tkind == TKIND_OPEN {
                    mfn.blocks[cur_bb].tkind = TKIND_JUMP
                    mfn.blocks[cur_bb].ta = cond_id
                }
            }

            mfn.active_bb = exit_id
        } else if s.kind == ast.NK_RETURN {
            ret_val := lower_expr(mfn, &p.nodes, s.a, env)
            cur_bb := mfn.active_bb
            if cur_bb >= 0 && cur_bb < mfn.blocks.len {
                mfn.blocks[cur_bb].tkind = TKIND_RETURN
                mfn.blocks[cur_bb].ta = ret_val
            }
        } else if s.kind == ast.NK_IF {
            cur_br := s.a
            if cur_br >= 0 && cur_br < p.nodes.len {
                br_node := ~p.nodes[cur_br]
                cond_val := lower_expr(mfn, &p.nodes, br_node.a, env)

                cur_bb := mfn.active_bb

                then_id := mfn.blocks.len
                $then_bb := mblock_new()
                mfn.blocks.push(then_bb)

                $else_id := -1
                if br_node.next >= 0 && br_node.next < p.nodes.len {
                    else_id = mfn.blocks.len
                    $else_bb := mblock_new()
                    mfn.blocks.push(else_bb)
                }

                merge_id := mfn.blocks.len
                $merge_bb := mblock_new()
                mfn.blocks.push(merge_bb)

                mfn.blocks[cur_bb].tkind = TKIND_BRANCH
                mfn.blocks[cur_bb].ta = cond_val
                mfn.blocks[cur_bb].tb = then_id
                if else_id >= 0 {
                    mfn.blocks[cur_bb].tc = else_id
                } else {
                    mfn.blocks[cur_bb].tc = merge_id
                }

                // Lower then branch
                mfn.active_bb = then_id
                lower_stmt_list(mfn, p, br_node.b, env)
                cur_then := mfn.active_bb
                if mfn.blocks[cur_then].tkind == TKIND_OPEN {
                    mfn.blocks[cur_then].tkind = TKIND_JUMP
                    mfn.blocks[cur_then].ta = merge_id
                }

                // Lower else branch
                if else_id >= 0 {
                    mfn.active_bb = else_id
                    else_node := ~p.nodes[br_node.next]
                    lower_stmt_list(mfn, p, else_node.b, env)
                    cur_else := mfn.active_bb
                    if mfn.blocks[cur_else].tkind == TKIND_OPEN {
                        mfn.blocks[cur_else].tkind = TKIND_JUMP
                        mfn.blocks[cur_else].ta = merge_id
                    }
                }

                mfn.active_bb = merge_id
            }
        }

        cur = s.next
    }
}

pub fn lower_parser(p &parser.Parser) Mir {
    $unit := mir_new()

    for di in 0:p.decls.len {
        d_idx := p.decls[di]
        if d_idx < 0 || d_idx >= p.nodes.len { -> }

        decl := ~p.nodes[d_idx]
        if decl.kind != ast.NK_FN { -> }

        fn_name := ~decl.sval
        $fn_label := "_" + fn_name
        if is_str_main(&fn_name) {
            fn_label = "_main"
        }

        $mfn := mfn_new(fn_name, fn_label)
        $env := lower_env_new()

        $recv_idx := decl.d
        if recv_idx >= 0 && recv_idx < p.nodes.len {
            recv_node := ~p.nodes[recv_idx]
            slot := mfn.locals.len
            mfn.locals.push(1)
            mfn.locals_nslots.push(1)
            mfn.locals_owning.push(false)
            mfn.local_names.push(~recv_node.sval)
            env.bind(recv_node.sval, slot)
            env.mark_ptr(slot)
            mfn.nparams += 1
        }

        $prm_idx := decl.a
        while prm_idx >= 0 && prm_idx < p.nodes.len {
            prm := ~p.nodes[prm_idx]
            slot := mfn.locals.len
            mfn.locals.push(1)
            mfn.locals_nslots.push(1)
            mfn.locals_owning.push(false)
            mfn.local_names.push(~prm.sval)
            env.bind(prm.sval, slot)
            if prm.a >= 0 && prm.a < p.nodes.len {
                if p.nodes[prm.a].kind == ast.NT_STR {
                    env.mark_string(slot)
                } else if p.nodes[prm.a].kind == ast.NT_REF {
                    inner_t := p.nodes[prm.a].a
                    if inner_t >= 0 && inner_t < p.nodes.len && p.nodes[inner_t].kind == ast.NT_ARRAY {
                        env.mark_slice_ref(slot)
                    }
                }
            }
            mfn.nparams += 1
            prm_idx = prm.next
        }

        $entry_bb := mblock_new()
        mfn.blocks.push(entry_bb)
        mfn.active_bb = 0

        lower_stmt_list($&mfn, p, decl.c, $&env)

        last_bb := mfn.blocks.len - 1
        if mfn.blocks[last_bb].tkind == TKIND_OPEN {
            zero_const := alloc_const($&mfn, 0)
            mfn.blocks[last_bb].tkind = TKIND_RETURN
            mfn.blocks[last_bb].ta = zero_const
        }

        unit.add_fn(mfn)
    }

    << unit
}
