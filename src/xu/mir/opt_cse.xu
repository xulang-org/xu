@xu/mir
// Common Subexpression Elimination (CSE) pass.
//
// Layer 3 module: identifies redundant arithmetic and comparison calculations
// within basic blocks, canonicalizes commutative operands, and folds duplicate
// computations into fast copy operations.

fn is_commutative(sub_op int) bool {
    << sub_op == BIN_ADD || sub_op == BIN_MUL || sub_op == BIN_AND || sub_op == BIN_OR
}

pub fn opt_cse(mfn $&MFn) {
    if mfn.instrs.len == 0 || mfn.blocks.len == 0 {
        <<
    }

    for bi in 0:mfn.blocks.len {
        $expr_kinds := []int{}
        $expr_ops := []int{}
        $expr_lhs := []int{}
        $expr_rhs := []int{}
        $expr_dests := []int{}

        $ii := mfn.blocks[bi].head
        while ii >= 0 && ii < mfn.instrs.len {
            $ins := ~mfn.instrs[ii]
            k := ins.kind

            if k == MI_BIN {
                sub_op := ins.b
                $lhs := ins.c
                $rhs := ins.d
                dest := ins.a

                // Canonicalize commutative binary operations
                if is_commutative(sub_op) && lhs > rhs {
                    tmp := lhs
                    lhs = rhs
                    rhs = tmp
                }

                $found_idx := -1
                for ei in 0:expr_kinds.len {
                    if expr_kinds[ei] == MI_BIN && expr_ops[ei] == sub_op && expr_lhs[ei] == lhs && expr_rhs[ei] == rhs {
                        found_idx = ei
                        <-
                    }
                }

                if found_idx >= 0 {
                    // Replace duplicate computation with MI_COPY from previously computed dest
                    ins.kind = MI_COPY
                    ins.a = dest
                    ins.b = expr_dests[found_idx]
                    ins.c = -1
                    ins.d = -1
                    mfn.instrs[ii] = ~ins
                } else {
                    expr_kinds.push(MI_BIN)
                    expr_ops.push(sub_op)
                    expr_lhs.push(lhs)
                    expr_rhs.push(rhs)
                    expr_dests.push(dest)
                }
            }

            if ii == mfn.blocks[bi].tail {
                <-
            }
            ii = mfn.instrs[ii].next
        }
    }
}
