    empty_l := []string{}
    a := RunArgs{root: "", list: empty_l, list_mode: 0, escape: 1}
    << run_prepared(t, d, &a) or >>
}

pub fn execute_list_html(t &Template, items []string) string {
    empty := new_dict()
    a := RunArgs{root: "", list: items, list_mode: 1, escape: 1}
    << run_prepared(t, &empty, &a) or >>
