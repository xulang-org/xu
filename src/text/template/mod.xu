@text/template


#errors
#html
#strconv

// Minimal text/template without reflect or user FuncMap.
// Supports: literal text, {{.}} , {{.Key}} , pipes {{. | html | len}},
// {{if}}/{{with}}/{{range}}, {{define}}/{{template}}/{{block}}.
// Dict is parallel key/value strings. Execute walks actions once.
// execute_*html escapes interpolation via html.escape_string (M114)
// unless the pipeline already applied `| html` (M141).

pub struct Template {
    pub src string
}

pub struct Dict {
    pub keys []string
    pub vals []string
}

struct Env {
    root       string
    keys       []string
    vals       []string
    list       []string
    list_mode  int
    escape     int
    def_names  []string
    def_bodies []string
}

pub fn new(src string) Template {
    << Template{src: src}
}

pub fn new_dict() Dict {
    << Dict{keys: []string{}, vals: []string{}}
}

pub fn (d &mut Dict) set(k string, v string) {
    for i in 0:d.keys.len {
        if d.keys[i] == k {
            d.vals[i] = v
            <<
        }
    }
    d.keys.push(k)
    d.vals.push(v)
}

pub fn get(d &Dict, k string) string {
    for i in 0:d.keys.len {
        if d.keys[i] == k {
            << d.vals[i] + ""
        }
    }
    << ""
}

fn env_lookup(e &Env, k string) string {
    for i in 0:e.keys.len {
        if e.keys[i] == k {
            << e.vals[i] + ""
        }
    }
    << ""
}

fn skip_ws_bytes(s &string, i int) int {
    mut p := i
    while p < s.len {
        c := s[p] & 255
        if c != 32 && c != 9 && c != 10 && c != 13 {
            << p
        }
        p = p + 1
    }
    << p
}

fn truthy(s &string) bool {
    << s.len > 0
}

fn is_kw_if(s &string, j int) bool {
    << (s[j] & 255) == 105 && j + 1 < s.len && (s[j + 1] & 255) == 102
}

fn is_kw_with(s &string, j int) bool {
    << (s[j] & 255) == 119 && j + 3 < s.len && (s[j + 1] & 255) == 105 && (s[j + 2] & 255) == 116 && (s[j + 3] & 255) == 104
}

fn is_kw_range(s &string, j int) bool {
    << (s[j] & 255) == 114 && j + 4 < s.len && (s[j + 1] & 255) == 97 && (s[j + 2] & 255) == 110 && (s[j + 3] & 255) == 103 && (s[j + 4] & 255) == 101
}

fn is_kw_define(s &string, j int) bool {
    << (s[j] & 255) == 100 && j + 5 < s.len && (s[j + 1] & 255) == 101 && (s[j + 2] & 255) == 102 && (s[j + 3] & 255) == 105 && (s[j + 4] & 255) == 110 && (s[j + 5] & 255) == 101
}

fn is_kw_printf(s &string, j int) bool {
    << (s[j] & 255) == 112 && j + 5 < s.len && (s[j + 1] & 255) == 114 && (s[j + 2] & 255) == 105 && (s[j + 3] & 255) == 110 && (s[j + 4] & 255) == 116 && (s[j + 5] & 255) == 102
}

fn is_kw_template(s &string, j int) bool {
    << (s[j] & 255) == 116 && j + 7 < s.len && (s[j + 1] & 255) == 101 && (s[j + 2] & 255) == 109 && (s[j + 3] & 255) == 112 && (s[j + 4] & 255) == 108 && (s[j + 5] & 255) == 97 && (s[j + 6] & 255) == 116 && (s[j + 7] & 255) == 101
}

fn is_kw_block(s &string, j int) bool {
    << (s[j] & 255) == 98 && j + 4 < s.len && (s[j + 1] & 255) == 108 && (s[j + 2] & 255) == 111 && (s[j + 3] & 255) == 99 && (s[j + 4] & 255) == 107
}

fn find_end(s &string, from int) int {
    mut depth := 1
    mut i := from
    while i < s.len {
        if i + 1 < s.len && (s[i] & 255) == 123 && (s[i + 1] & 255) == 123 {
            j := skip_ws_bytes(s, i + 2)
            if j + 3 <= s.len {
                if (s[j] & 255) == 101 && (s[j + 1] & 255) == 110 && (s[j + 2] & 255) == 100 {
                    k := skip_ws_bytes(s, j + 3)
                    if k + 1 < s.len && (s[k] & 255) == 125 && (s[k + 1] & 255) == 125 {
                        depth = depth - 1
                        if depth == 0 {
                            << i
                        }
                        i = k + 2
                    } else {
                        i = i + 1
                    }
                } else {
                    if is_kw_if(s, j) || is_kw_with(s, j) || is_kw_define(s, j) || is_kw_block(s, j) {
                        depth = depth + 1
                        i = i + 1
                    } else {
                        if is_kw_range(s, j) {
                            depth = depth + 1
                        }
                        i = i + 1
                    }
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    << -1
}

fn find_else(s &string, from int, endpos int) int {
    mut depth := 1
    mut i := from
    while i < endpos {
        if i + 1 < s.len && (s[i] & 255) == 123 && (s[i + 1] & 255) == 123 {
            j := skip_ws_bytes(s, i + 2)
            if j + 4 <= s.len && (s[j] & 255) == 101 && (s[j + 1] & 255) == 108 && (s[j + 2] & 255) == 115 && (s[j + 3] & 255) == 101 {
                k := skip_ws_bytes(s, j + 4)
                if k + 1 < s.len && (s[k] & 255) == 125 && (s[k + 1] & 255) == 125 {
                    if depth == 1 {
                        << i
                    }
                    i = k + 2
                } else {
                    if is_kw_if(s, k) {
                        eb := close_action(s, j)
                        if eb < 0 {
                            i = i + 1
                        } else {
                            if depth == 1 {
                                << i
                            }
                            i = eb + 2
                        }
                    } else {
                        i = i + 1
                    }
                }
            } else {
                if j + 3 <= s.len && (s[j] & 255) == 101 && (s[j + 1] & 255) == 110 && (s[j + 2] & 255) == 100 {
                    k := skip_ws_bytes(s, j + 3)
                    if k + 1 < s.len && (s[k] & 255) == 125 && (s[k + 1] & 255) == 125 {
                        depth = depth - 1
                        i = k + 2
                    } else {
                        i = i + 1
                    }
                } else {
                    if is_kw_if(s, j) || is_kw_with(s, j) || is_kw_define(s, j) || is_kw_block(s, j) {
                        depth = depth + 1
                    }
                    if is_kw_range(s, j) {
                        depth = depth + 1
                    }
                    i = i + 1
                }
            }
        } else {
            i = i + 1
        }
    }
    << -1
}

fn cond_from_dot(env &Env, key string, kl int) string {
    if kl == 0 {
        << env.root + ""
    }
    << env_lookup(env, key)
}

fn is_plain_else_action(s &string, else_pos int) bool {
    j := skip_ws_bytes(s, else_pos + 2)
    if j + 4 > s.len {
        << false
    }
    if !((s[j] & 255) == 101 && (s[j + 1] & 255) == 108 && (s[j + 2] & 255) == 115 && (s[j + 3] & 255) == 101) {
        << false
    }
    k := skip_ws_bytes(s, j + 4)
    << k + 1 < s.len && (s[k] & 255) == 125 && (s[k + 1] & 255) == 125
}

fn parse_else_if_key(s &string, else_pos int) string {
    j := skip_ws_bytes(s, else_pos + 2)
    k := skip_ws_bytes(s, j + 4)
    if !is_kw_if(s, k) {
        >> errors.new("template: bad else if")
    }
    end_br := close_action(s, j)
    if end_br < 0 {
        >> errors.new("template: unclosed action")
    }
    p := skip_ws_bytes(s, k + 2)
    if p >= end_br || (s[p] & 255) != 46 {
        >> errors.new("template: else if needs .Key")
    }
    << read_ident2(s, p + 1) + ""
}

fn close_action(s &string, j int) int {
    mut p := j
    while p + 1 < s.len {
        if (s[p] & 255) == 125 && (s[p + 1] & 255) == 125 {
            << p
        }
        p = p + 1
    }
    << -1
}

fn read_ident2(s &string, start int) string {
    mut p := start
    mut key := []int{}
    mut going := 1
    while going == 1 {
        if p >= s.len {
            going = 0
        } else {
            c := s[p] & 255
            if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 {
                key.push(c)
                p = p + 1
            } else {
                going = 0
            }
        }
    }
    << string_from_bytes(key)
}

fn read_quoted(s &string, start int) string {
    if start >= s.len || (s[start] & 255) != 34 {
        >> errors.new("template: expected quoted name")
    }
    mut p := start + 1
    mut out := []int{}
    while p < s.len {
        c := s[p] & 255
        if c == 34 {
            << string_from_bytes(out)
        }
        out.push(c)
        p = p + 1
    }
    >> errors.new("template: unclosed quote")
}

fn quoted_end(s &string, start int) int {
    if start >= s.len || (s[start] & 255) != 34 {
        << -1
    }
    mut p := start + 1
    while p < s.len {
        if (s[p] & 255) == 34 {
            << p
        }
        p = p + 1
    }
    << -1
}

fn def_put(names &mut []string, bodies &mut []string, name string, body string) {
    for i in 0:names.len {
        n := names[i] + ""
        if n == name {
            bodies[i] = body
            <<
        }
    }
    names.push(name)
    bodies.push(body)
}

fn def_lookup(e &Env, name string) string {
    for i in 0:e.def_names.len {
        n := e.def_names[i] + ""
        if n == name {
            << e.def_bodies[i] + ""
        }
    }
    >> errors.new("template: no template \"" + name + "\"")
}

struct Prepared {
    main   string
    names  []string
    bodies []string
}

fn emit_template_inv(mainb &mut []int, name &string) {
    mainb.push(123)
    mainb.push(123)
    mainb.push(116)
    mainb.push(101)
    mainb.push(109)
    mainb.push(112)
    mainb.push(108)
    mainb.push(97)
    mainb.push(116)
    mainb.push(101)
    mainb.push(32)
    mainb.push(34)
    for i in 0:name.len {
        mainb.push(name[i] & 255)
    }
    mainb.push(34)
    mainb.push(125)
    mainb.push(125)
}

fn prepare_src(src &string) Prepared {
    mut mainb := []int{}
    mut names := []string{}
    mut bodies := []string{}
    mut i := 0
    while i < src.len {
        if i + 1 < src.len && (src[i] & 255) == 123 && (src[i + 1] & 255) == 123 {
            j := skip_ws_bytes(src, i + 2)
            end_br := close_action(src, j)
            if end_br < 0 {
                >> errors.new("template: unclosed action")
            }
            if is_kw_define(src, j) || is_kw_block(src, j) {
                mut kwlen := 6
                if is_kw_block(src, j) {
                    kwlen = 5
                }
                p := skip_ws_bytes(src, j + kwlen)
                name := read_quoted(src, p)
                qe := quoted_end(src, p)
                if qe < 0 || qe >= end_br {
                    >> errors.new("template: bad define name")
                }
                body_start := end_br + 2
                endpos := find_end(src, body_start)
                if endpos < 0 {
                    >> errors.new("template: define missing end")
                }
                mut bodyb := []int{}
                for k in body_start:endpos {
                    bodyb.push(src[k] & 255)
                }
                body := string_from_bytes(bodyb)
                nm := name + ""
                def_put(mut &names, mut &bodies, nm + "", body)
                if is_kw_block(src, j) {
                    n2 := nm + ""
                    emit_template_inv(mut &mainb, &n2)
                }
                eb2 := close_action(src, skip_ws_bytes(src, endpos + 2))
                if eb2 < 0 {
                    >> errors.new("template: define missing end")
                }
                i = eb2 + 2
            } else {
                for k in i:(end_br + 2) {
                    mainb.push(src[k] & 255)
                }
                i = end_br + 2
            }
        } else {
            mainb.push(src[i] & 255)
            i = i + 1
        }
    }
    << Prepared{main: string_from_bytes(mainb), names: names, bodies: bodies}
}

fn clone_env(e &Env, root string, list_mode int) Env {
    mut keys := []string{}
    mut vals := []string{}
    mut list := []string{}
    mut def_names := []string{}
    mut def_bodies := []string{}
    for i in 0:e.keys.len {
        keys.push(e.keys[i] + "")
        vals.push(e.vals[i] + "")
    }
    for i in 0:e.list.len {
        list.push(e.list[i] + "")
    }
    for i in 0:e.def_names.len {
        def_names.push(e.def_names[i] + "")
        def_bodies.push(e.def_bodies[i] + "")
    }
    << Env{root: root, keys: keys, vals: vals, list: list, list_mode: list_mode, escape: e.escape, def_names: def_names, def_bodies: def_bodies}
}

fn ascii_upper(s string) string {
    mut b := []int{}
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c >= 97 && c <= 122 {
            b.push(c - 32)
        } else {
            b.push(c)
        }
        i = i + 1
    }
    << string_from_bytes(b)
}

fn ascii_lower(s string) string {
    mut b := []int{}
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c >= 65 && c <= 90 {
            b.push(c + 32)
        } else {
            b.push(c)
        }
        i = i + 1
    }
    << string_from_bytes(b)
}

fn pipe_name_is(src &string, start int, flen int, want string) bool {
    if flen != want.len {
        << false
    }
    mut i := 0
    while i < flen {
        if (src[start + i] & 255) != (want[i] & 255) {
            << false
        }
        i = i + 1
    }
    << true
}

fn apply_pipe_at(src &string, start int, flen int, val string) string {
    if pipe_name_is(src, start, flen, "html") {
        << html.escape_string(&val)
    }
    if pipe_name_is(src, start, flen, "len") {
        << strconv.itoa(val.len)
    }
    if pipe_name_is(src, start, flen, "upper") {
        << ascii_upper(val)
    }
    if pipe_name_is(src, start, flen, "lower") {
        << ascii_lower(val)
    }
    >> errors.new("template: unknown pipe function")
}

fn apply_printf(fmt string, val string) string {
    mut out := []int{}
    mut i := 0
    while i < fmt.len {
        c := fmt[i] & 255
        if c != 37 {
            out.push(c)
            i = i + 1
        } else {
            if i + 1 >= fmt.len {
                >> errors.new("template: bad printf format")
            }
            n := fmt[i + 1] & 255
            if n == 37 {
                out.push(37)
                i = i + 2
            } else {
                if n == 115 {
                    mut k := 0
                    while k < val.len {
                        out.push(val[k] & 255)
                        k = k + 1
                    }
                    i = i + 2
                } else {
                    if n == 113 {
                        q := strconv.quote(&val)
                        mut k := 0
                        while k < q.len {
                            out.push(q[k] & 255)
                            k = k + 1
                        }
                        i = i + 2
                    } else {
                        >> errors.new("template: unsupported printf verb")
                    }
                }
            }
        }
    }
    << string_from_bytes(out)
}

// Evaluate `.` / `.Key` [| name]* inside an action. Returns emitted text.
fn eval_dot_pipes(src &string, dot_pos int, end_br int, env &Env) string {
    key_owned := read_ident2(src, dot_pos + 1) + ""
    kl := key_owned.len
    got := env_lookup(env, key_owned)
    mut val := got + ""
    if kl == 0 {
        val = env.root + ""
    }
    mut q := skip_ws_bytes(src, dot_pos + 1 + kl)
    mut used_html := 0
    while q < end_br && (src[q] & 255) == 124 {
        q = skip_ws_bytes(src, q + 1)
        if q >= end_br {
            >> errors.new("template: pipe needs function")
        }
        fname := read_ident2(src, q) + ""
        flen := fname.len
        if flen == 0 {
            >> errors.new("template: pipe needs function")
        }
        if pipe_name_is(src, q, flen, "html") {
            used_html = 1
        }
        mut q2 := skip_ws_bytes(src, q + flen)
        if pipe_name_is(src, q, flen, "printf") {
            if q2 >= end_br || (src[q2] & 255) != 34 {
                >> errors.new("template: printf needs format string")
            }
            fmt := read_quoted(src, q2)
            qe := quoted_end(src, q2)
            if qe < 0 {
                >> errors.new("template: unclosed quote")
            }
            val = apply_printf(fmt, val)
            q = skip_ws_bytes(src, qe + 1)
        } else {
            val = apply_pipe_at(src, q, flen, val)
            q = q2
        }
    }
    if q < end_br {
        >> errors.new("template: junk after pipeline")
    }
    if env.escape != 0 && used_html == 0 {
        val = html.escape_string(&val)
    }
    << val
}

fn exec_body(src &string, from int, to int, env &Env) string {
    mut out := []int{}
    mut i := from
    while i < to {
        if i + 1 < to && (src[i] & 255) == 123 && (src[i + 1] & 255) == 123 {
            j := skip_ws_bytes(src, i + 2)
            end_br := close_action(src, j)
            if end_br < 0 {
                >> errors.new("template: unclosed action")
            }
            if j + 3 <= end_br && (src[j] & 255) == 101 && (src[j + 1] & 255) == 110 && (src[j + 2] & 255) == 100 {
                >> errors.new("template: unexpected end")
            }
            if j + 4 <= end_br && (src[j] & 255) == 101 && (src[j + 1] & 255) == 108 && (src[j + 2] & 255) == 115 && (src[j + 3] & 255) == 101 {
                >> errors.new("template: unexpected else")
            }
            if is_kw_if(src, j) && j + 1 < end_br {
                p := skip_ws_bytes(src, j + 2)
                if p >= end_br || (src[p] & 255) != 46 {
                    >> errors.new("template: if needs .Key")
                }
                mut key_owned := read_ident2(src, p + 1) + ""
                mut kl := key_owned.len
                body_start := end_br + 2
                endpos := find_end(src, body_start)
                if endpos < 0 || endpos > to {
                    >> errors.new("template: if missing end")
                }
                mut scan := body_start
                mut chosen := ""
                child := clone_env(env, env.root + "", env.list_mode)
                mut done := 0
                while done == 0 {
                    elsepos := find_else(src, scan, endpos)
                    mut bto := endpos
                    if elsepos >= 0 {
                        bto = elsepos
                    }
                    cond := cond_from_dot(&child, key_owned, kl)
                    if truthy(&cond) {
                        chosen = exec_body(src, scan, bto, &child)
                        done = 1
                    } else {
                        if elsepos < 0 {
                            done = 1
                        } else {
                            if is_plain_else_action(src, elsepos) {
                                eb := close_action(src, skip_ws_bytes(src, elsepos + 2))
                                chosen = exec_body(src, eb + 2, endpos, &child)
                                done = 1
                            } else {
                                key2 := parse_else_if_key(src, elsepos)
                                key_owned = key2 + ""
                                kl = key_owned.len
                                eb := close_action(src, skip_ws_bytes(src, elsepos + 2))
                                if eb < 0 {
                                    >> errors.new("template: unclosed action")
                                }
                                scan = eb + 2
                            }
                        }
                    }
                }
                for k in 0:chosen.len {
                    out.push(chosen[k] & 255)
                }
                eb2 := close_action(src, skip_ws_bytes(src, endpos + 2))
                i = eb2 + 2
            } else {
                if is_kw_with(src, j) && j + 3 < end_br {
                    p := skip_ws_bytes(src, j + 4)
                    if p >= end_br || (src[p] & 255) != 46 {
                        >> errors.new("template: with needs .Key")
                    }
                    key_owned := read_ident2(src, p + 1) + ""
                    kl := key_owned.len
                    got := env_lookup(env, key_owned)
                    body_start := end_br + 2
                    endpos := find_end(src, body_start)
                    if endpos < 0 || endpos > to {
                        >> errors.new("template: with missing end")
                    }
                    elsepos := find_else(src, body_start, endpos)
                    mut cond := got + ""
                    if kl == 0 {
                        cond = env.root + ""
                    }
                    mut chosen := ""
                    if truthy(&cond) {
                        mut bto := endpos
                        if elsepos >= 0 {
                            bto = elsepos
                        }
                        child := clone_env(env, cond, env.list_mode)
                        chosen = exec_body(src, body_start, bto, &child)
                    } else {
                        if elsepos >= 0 {
                            eb := close_action(src, skip_ws_bytes(src, elsepos + 2))
                            child := clone_env(env, env.root + "", env.list_mode)
                            chosen = exec_body(src, eb + 2, endpos, &child)
                        }
                    }
                    for k in 0:chosen.len {
                        out.push(chosen[k] & 255)
                    }
                    eb2 := close_action(src, skip_ws_bytes(src, endpos + 2))
                    i = eb2 + 2
                } else {
                    if is_kw_range(src, j) && j + 4 < end_br {
                        p := skip_ws_bytes(src, j + 5)
                        if p >= end_br || (src[p] & 255) != 46 {
                            >> errors.new("template: range needs .")
                        }
                        body_start := end_br + 2
                        endpos := find_end(src, body_start)
                        if endpos < 0 || endpos > to {
                            >> errors.new("template: range missing end")
                        }
                        if env.list_mode == 0 {
                            >> errors.new("template: range needs list")
                        }
                        mut k := 0
                        while k < env.list.len {
                            item := env.list[k] + ""
                            child := clone_env(env, item, 0)
                            piece := exec_body(src, body_start, endpos, &child)
                            for t in 0:piece.len {
                                out.push(piece[t] & 255)
                            }
                            k = k + 1
                        }
                        eb2 := close_action(src, skip_ws_bytes(src, endpos + 2))
                        i = eb2 + 2
                    } else {
                        if is_kw_define(src, j) {
                            >> errors.new("template: unexpected define")
                        }
                        if is_kw_template(src, j) && j + 7 < end_br {
                            p := skip_ws_bytes(src, j + 8)
                            name := read_quoted(src, p)
                            body := def_lookup(env, name)
                            child := clone_env(env, env.root + "", env.list_mode)
                            piece := exec_body(&body, 0, body.len, &child)
                            for t in 0:piece.len {
                                out.push(piece[t] & 255)
                            }
                            i = end_br + 2
                        } else {
                            if is_kw_printf(src, j) && j + 5 < end_br {
                                p := skip_ws_bytes(src, j + 6)
                                if p >= end_br || (src[p] & 255) != 34 {
                                    >> errors.new("template: printf needs format string")
                                }
                                fmt := read_quoted(src, p)
                                qe := quoted_end(src, p)
                                if qe < 0 {
                                    >> errors.new("template: unclosed quote")
                                }
                                p2 := skip_ws_bytes(src, qe + 1)
                                if p2 >= end_br || (src[p2] & 255) != 46 {
                                    >> errors.new("template: printf needs .")
                                }
                                key_owned := read_ident2(src, p2 + 1) + ""
                                kl := key_owned.len
                                got := env_lookup(env, key_owned)
                                mut raw := got + ""
                                if kl == 0 {
                                    raw = env.root + ""
                                }
                                val := apply_printf(fmt, raw)
                                mut outv := val + ""
                                if env.escape != 0 {
                                    outv = html.escape_string(&outv)
                                }
                                for t in 0:outv.len {
                                    out.push(outv[t] & 255)
                                }
                                i = end_br + 2
                            } else {
                            p := skip_ws_bytes(src, j)
                            if p >= end_br || (src[p] & 255) != 46 {
                                >> errors.new("template: expected .")
                            }
                            val := eval_dot_pipes(src, p, end_br, env)
                            for t in 0:val.len {
                                out.push(val[t] & 255)
                            }
                            i = end_br + 2
                            }
                        }
                    }
                }
            }
        } else {
            out.push(src[i] & 255)
            i = i + 1
        }
    }
    << string_from_bytes(out)
}

fn dict_to_env(d &Dict, a &RunArgs, prep &Prepared) Env {
    mut keys := []string{}
    mut vals := []string{}
    mut ls := []string{}
    mut def_names := []string{}
    mut def_bodies := []string{}
    for i in 0:d.keys.len {
        keys.push(d.keys[i] + "")
        vals.push(d.vals[i] + "")
    }
    for i in 0:a.list.len {
        ls.push(a.list[i] + "")
    }
    for i in 0:prep.names.len {
        def_names.push(prep.names[i] + "")
        def_bodies.push(prep.bodies[i] + "")
    }
    << Env{root: a.root + "", keys: keys, vals: vals, list: ls, list_mode: a.list_mode, escape: a.escape, def_names: def_names, def_bodies: def_bodies}
}

struct RunArgs {
    root      string
    list      []string
    list_mode int
    escape    int
}

fn run_prepared(t &Template, d &Dict, a &RunArgs) string {
    src := t.src + ""
    prep := prepare_src(&src) or >>
    main := prep.main + ""
    env := dict_to_env(d, a, &prep) or >>
    << exec_body(&main, 0, main.len, &env) or >>
}

pub fn execute_str(t &Template, root string) string {
    empty := new_dict()
    empty_l := []string{}
    a := RunArgs{root: root, list: empty_l, list_mode: 0, escape: 0}
    << run_prepared(t, &empty, &a) or >>
}

pub fn execute(t &Template, d &Dict) string {
    empty_l := []string{}
    a := RunArgs{root: "", list: empty_l, list_mode: 0, escape: 0}
    << run_prepared(t, d, &a) or >>
}

pub fn execute_list(t &Template, items []string) string {
    empty := new_dict()
    a := RunArgs{root: "", list: items, list_mode: 1, escape: 0}
    << run_prepared(t, &empty, &a) or >>
}

pub fn execute_str_html(t &Template, root string) string {
    empty := new_dict()
    empty_l := []string{}
    a := RunArgs{root: root, list: empty_l, list_mode: 0, escape: 1}
    << run_prepared(t, &empty, &a) or >>
}

