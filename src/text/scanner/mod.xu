@text/scanner

#unicode

// Tokenizer aligned with Go `text/scanner` default GoTokens:
// skip whitespace and comments; recognize Ident / Int / Float /
// Char / String / RawString; other bytes are single-char tokens.
// Source is an owning string (no io.Reader). ASCII column = byte count.

pub const EOF = -1
pub const IDENT = -2
pub const SCAN_INT = -3
pub const FLOAT = -4
pub const CHAR = -5
pub const SCAN_STRING = -6
pub const RAW_STRING = -7
pub const COMMENT = -8

pub struct Scanner {
    pub src string
    pub pos int
    pub line int
    pub col int
    pub tok int
    pub text string
    pub tok_line int
    pub tok_col int
}

pub fn new(src &string) Scanner {
    << Scanner{src: src + "", pos: 0, line: 1, col: 1, tok: 0, text: "", tok_line: 1, tok_col: 1}
}

fn is_ws(c int) bool {
    << c == 32 || c == 9 || c == 10 || c == 13
}

fn is_ident_start(c int) bool {
    if c == 95 {
        << true
    }
    << unicode.is_letter(c)
}

fn is_ident_cont(c int) bool {
    if is_ident_start(c) {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    << unicode.is_digit(c)
}

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn is_hex(c int) bool {
    if is_digit(c) {
        << true
    }
    if c >= 97 && c <= 102 {
        << true
    }
    if c >= 65 && c <= 70 {
        << true
    }
    << false
}

pub fn (s &mut Scanner) peek() int {
    if s.pos >= s.src.len {
        << 0 - 1
    }
    << s.src[s.pos] & 255
}

pub fn (s &mut Scanner) next() int {
    << s.nextc()
}

fn (s &mut Scanner) nextc() int {
    if s.pos >= s.src.len {
        << 0 - 1
    }
    c := s.src[s.pos] & 255
    s.pos = s.pos + 1
    if c == 10 {
        s.line = s.line + 1
        s.col = 1
    } else {
        s.col = s.col + 1
    }
    << c
}

fn (s &mut Scanner) skip_ws() {
    mut done := 0
    while done == 0 {
        c := s.peek()
        if c < 0 || !is_ws(c) {
            done = 1
        } else {
            _ := s.nextc()
        }
    }
}

fn (s &mut Scanner) collect_ident() {
    mut b := []int{}
    mut done := 0
    while done == 0 {
        c := s.peek()
        if c < 0 || !is_ident_cont(c) {
            done = 1
        } else {
            b.push(s.nextc() & 255)
        }
    }
    s.text = string_from_bytes(b)
}

fn (s &mut Scanner) collect_number() int {
    mut b := []int{}
    mut kind := SCAN_INT
    c0 := s.nextc()
    b.push(c0 & 255)
    if c0 == 48 {
        n := s.peek()
        if n == 120 || n == 88 {
            b.push(s.nextc() & 255)
            mut hx := 0
            while is_hex(s.peek()) {
                b.push(s.nextc() & 255)
                hx = 1
            }
            _ := hx
            s.text = string_from_bytes(b)
            << SCAN_INT
        }
    }
    while is_digit(s.peek()) {
        b.push(s.nextc() & 255)
    }
    if s.peek() == 46 {
        mut n1 := 0
        if s.pos + 1 < s.src.len {
            n1 = s.src[s.pos + 1] & 255
        }
        if is_digit(n1) {
            b.push(s.nextc() & 255)
            while is_digit(s.peek()) {
                b.push(s.nextc() & 255)
            }
            kind = FLOAT
        }
    }
    e := s.peek()
    if e == 101 || e == 69 {
        b.push(s.nextc() & 255)
        sgn := s.peek()
        if sgn == 43 || sgn == 45 {
            b.push(s.nextc() & 255)
        }
        while is_digit(s.peek()) {
            b.push(s.nextc() & 255)
        }
        kind = FLOAT
    }
    s.text = string_from_bytes(b)
    << kind
}

fn (s &mut Scanner) collect_quoted(q int) {
    mut b := []int{}
    b.push(q & 255)
    _ := s.nextc()
    mut done := 0
    while done == 0 {
        c := s.peek()
        if c < 0 {
            done = 1
        } else {
            b.push(s.nextc() & 255)
            if c == 92 {
                n := s.peek()
                if n >= 0 {
                    b.push(s.nextc() & 255)
                }
            } else {
                if c == q {
                    done = 1
                }
            }
        }
    }
    s.text = string_from_bytes(b)
}

fn (s &mut Scanner) collect_raw() {
    mut b := []int{}
    b.push(96)
    _ := s.nextc()
    mut done := 0
    while done == 0 {
        c := s.peek()
        if c < 0 {
            done = 1
        } else {
            b.push(s.nextc() & 255)
            if c == 96 {
                done = 1
            }
        }
    }
    s.text = string_from_bytes(b)
}

fn (s &mut Scanner) skip_line_comment() {
    mut done := 0
    while done == 0 {
        c := s.peek()
        if c < 0 || c == 10 {
            done = 1
        } else {
            _ := s.nextc()
        }
    }
}

fn (s &mut Scanner) skip_block_comment() {
    mut done := 0
    while done == 0 {
        c := s.peek()
        if c < 0 {
            done = 1
        } else {
            _ := s.nextc()
            if c == 42 && s.peek() == 47 {
                _ := s.nextc()
                done = 1
            }
        }
    }
}

pub fn (s &mut Scanner) scan() int {
    mut looping := 1
    while looping == 1 {
        s.skip_ws()
        s.tok_line = s.line
        s.tok_col = s.col
        c := s.peek()
        if c < 0 {
            s.tok = EOF
            s.text = ""
            << EOF
        }
        if is_ident_start(c) {
            s.collect_ident()
            s.tok = IDENT
            << IDENT
        }
        if is_digit(c) {
            s.tok = s.collect_number()
            << s.tok
        }
        if c == 34 {
            s.collect_quoted(34)
            s.tok = SCAN_STRING
            << SCAN_STRING
        }
        if c == 39 {
            s.collect_quoted(39)
            s.tok = CHAR
            << CHAR
        }
        if c == 96 {
            s.collect_raw()
            s.tok = RAW_STRING
            << RAW_STRING
        }
        if c == 47 {
            _ := s.nextc()
            n := s.peek()
            if n == 47 {
                _ := s.nextc()
                s.skip_line_comment()
            } else {
                if n == 42 {
                    _ := s.nextc()
                    s.skip_block_comment()
                } else {
                    s.tok = 47
                    s.text = "/"
                    << 47
                }
            }
        } else {
            _ := s.nextc()
            s.tok = c
            s.text = string_from_byte(c)
            looping = 0
        }
    }
    << s.tok
}

pub fn (s Scanner) token_text() string {
    << s.text + ""
}

pub fn (s Scanner) line() int {
    << s.tok_line
}

pub fn (s Scanner) column() int {
    << s.tok_col
}

pub fn (s Scanner) token() int {
    << s.tok
}
