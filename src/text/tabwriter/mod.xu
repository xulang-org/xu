@text/tabwriter

// Elastic tabstops aligned with Go `text/tabwriter` (Write + Flush).
// ASCII cell width = byte length. No HTML filter, no Escape, no
// formfeed flush. padchar tab (tabwidth alignment) is not implemented.
// flush returns the formatted owning string (no io.Writer).
//
// Cells store (start,len) into the raw buffer — not owning strings.
// Gen1 corrupts `[]Cell` element-0 `.text` after a second push (SEGV on
// read); widths stay intact. Offsets avoid that (see text_tabwriter).

pub const align_right = 4
pub const debug = 32

pub struct Writer {
    pub minwidth int
    pub tabwidth int
    pub padding int
    pub padchar int
    pub flags int
    pub raw string
}

pub struct Cell {
    pub text string
    pub width int
    pub htab int
}

struct OffCell {
    start int
    len int
    htab int
}

struct Fmt {
    data     string
    cells    []OffCell
    start    []int
    count    []int
    nlines   int
    minwidth int
    padding  int
    padchar  int
    flags    int
}

pub fn new_writer(minwidth int, tabwidth int, padding int, padchar int, flags int) Writer {
    << Writer{minwidth: minwidth, tabwidth: tabwidth, padding: padding, padchar: padchar, flags: flags, raw: ""}
}

pub fn (w &mut Writer) write(s &string) {
    w.raw = w.raw + s
}

fn at_i(xs &[]int, i int) int {
    << xs[i]
}

fn cell_slice(f &Fmt, i int) string {
    c := f.cells[i]
    if c.len <= 0 {
        << ""
    }
    << f.data[c.start:(c.start + c.len)] + ""
}

fn cell_width(f &Fmt, i int) int {
    << f.cells[i].len
}

fn pad_n(n int, ch int) string {
    mut out := []int{}
    mut i := 0
    while i < n {
        out.push(ch & 255)
        i = i + 1
    }
    << string_from_bytes(out)
}

fn soft_col_count(f &Fmt) int {
    mut max_soft := 0
    mut i := 0
    while i < f.nlines {
        n := at_i(&f.count, i)
        if n > 1 {
            soft := n - 1
            if soft > max_soft {
                max_soft = soft
            }
        }
        i = i + 1
    }
    << max_soft
}

fn col_width(f &Fmt, column int) int {
    mut width := f.minwidth
    mut i := 0
    while i < f.nlines {
        n := at_i(&f.count, i)
        if column < n - 1 {
            st := at_i(&f.start, i)
            ix := st + column
            cw := cell_width(f, ix) + f.padding
            if cw > width {
                width = cw
            }
        }
        i = i + 1
    }
    << width
}

fn write_lines(f &Fmt, widths &[]int) string {
    mut out := ""
    mut i := 0
    while i < f.nlines {
        mut st := at_i(&f.start, i)
        n := at_i(&f.count, i)
        mut j := 0
        while j < n {
            if j > 0 && (f.flags & debug) != 0 {
                out = out + "|"
            }
            tw := cell_width(f, st)
            t := cell_slice(f, st)
            if t.len == 0 {
                if j < widths.len {
                    out = out + pad_n(at_i(widths, j) - tw, f.padchar)
                }
            } else {
                if (f.flags & align_right) == 0 {
                    out = out + t
                    if j < widths.len {
                        out = out + pad_n(at_i(widths, j) - tw, f.padchar)
                    }
                } else {
                    if j < widths.len {
                        out = out + pad_n(at_i(widths, j) - tw, f.padchar)
                    }
                    out = out + t
                }
            }
            st = st + 1
            j = j + 1
        }
        if i + 1 != f.nlines {
            out = out + "\n"
        }
        i = i + 1
    }
    << out
}

fn parse_fmt(data &string, minwidth int, padding int, padchar int, flags int) Fmt {
    src := data + ""
    mut cells := []OffCell{}
    mut start := []int{}
    mut count := []int{}
    mut cur_start := 0
    mut cur_len := 0
    mut ncur := 0
    mut line_start := 0
    mut last_nl := 0
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 9 {
            cells.push(OffCell{start: cur_start, len: cur_len, htab: 1})
            i = i + 1
            cur_start = i
            cur_len = 0
            ncur = ncur + 1
            last_nl = 0
            ->
        }
        if c == 10 {
            cells.push(OffCell{start: cur_start, len: cur_len, htab: 0})
            ncur = ncur + 1
            start.push(line_start)
            count.push(ncur)
            line_start = cells.len
            ncur = 0
            i = i + 1
            cur_start = i
            cur_len = 0
            last_nl = 1
            ->
        }
        cur_len = cur_len + 1
        i = i + 1
        last_nl = 0
    }
    if cur_len > 0 || ncur > 0 {
        cells.push(OffCell{start: cur_start, len: cur_len, htab: 0})
        ncur = ncur + 1
        start.push(line_start)
        count.push(ncur)
    } else {
        if src.len > 0 && last_nl == 1 {
            start.push(line_start)
            count.push(0)
        }
    }
    nlines := count.len
    << Fmt{data: src, cells: cells, start: start, count: count, nlines: nlines, minwidth: minwidth, padding: padding, padchar: padchar, flags: flags}
}

pub fn (w &mut Writer) flush() string {
    data := w.raw + ""
    f := parse_fmt(&data, w.minwidth, w.padding, w.padchar, w.flags)
    nsoft := soft_col_count(&f)
    mut widths := []int{}
    mut c := 0
    while c < nsoft {
        widths.push(col_width(&f, c))
        c = c + 1
    }
    out := write_lines(&f, &widths)
    w.raw = ""
    << out
}
