@regexp


#errors
// Minimal regexp subset (Go regexp-shaped API, not full RE2).
// Flat node pool + bounded backtracking (step budget). No backrefs.

const kind_lit = 1
const kind_any = 2
const kind_class = 3
const kind_nclass = 4
const kind_star = 5
const kind_plus = 6
const kind_quest = 7
const kind_alt = 8
const kind_cat = 9
const kind_bol = 10
const kind_eol = 11
const kind_empty = 12
const kind_cap_start = 13
const kind_cap_end = 14

const steps_default = 1000000

pub struct Regexp {
    pub nodes []Node
    pub root int
    pub class_data string
    pub steps_max int
    pub num_caps int
}

struct Node {
    kind int
    a int
    b int
}

struct Parser {
    expr string
    pos int
    nodes []Node
    class_data string
    err string
    num_caps int
}

struct Matcher {
    re Regexp
    text string
    steps int
    ok bool
    end_pos int
    cont []int
    cap_start []int
    cap_end []int
}

fn is_meta(c int) bool {
    if c == 92 || c == 46 || c == 43 || c == 42 || c == 63 || c == 40 || c == 41 {
        << true
    }
    if c == 124 || c == 91 || c == 93 || c == 123 || c == 125 || c == 94 || c == 36 {
        << true
    }
    << false
}

pub fn quote_meta(s &string) string {
    src := s + ""
    mut out := ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if is_meta(c) {
            out.push_byte(92)
        }
        out.push_byte(c)
        i = i + 1
    }
    << out
}

pub fn compile(expr string) Regexp {
    mut p := Parser{expr: expr, pos: 0, nodes: []Node{}, class_data: "", err: "", num_caps: 0}
    root := p.parse_alt()
    if p.err.len > 0 {
        >> errors.new(p.err + "")
    }
    if p.pos != p.expr.len {
        >> errors.new("regexp: unexpected trailing input")
    }
    mut nodes := []Node{}
    for i in 0:p.nodes.len {
        n := p.nodes[i]
        nodes.push(Node{kind: n.kind, a: n.a, b: n.b})
    }
    cd := p.class_data + ""
    << Regexp{nodes: nodes, root: root, class_data: cd, steps_max: steps_default, num_caps: p.num_caps}
}

fn (p &mut Parser) fail(msg string) {
    if p.err.len == 0 {
        p.err = msg + ""
    }
}

fn (p &mut Parser) peek() int {
    if p.pos >= p.expr.len {
        << -1
    }
    << p.expr[p.pos] & 255
}

fn (p &mut Parser) next() int {
    if p.pos >= p.expr.len {
        << -1
    }
    c := p.expr[p.pos] & 255
    p.pos = p.pos + 1
    << c
}

fn (p &mut Parser) add(kind int, a int, b int) int {
    p.nodes.push(Node{kind: kind, a: a, b: b})
    << p.nodes.len - 1
}

fn (p &mut Parser) parse_alt() int {
    mut left := p.parse_concat()
    if p.err.len > 0 {
        << left
    }
    while p.peek() == 124 {
        _ := p.next()
        right := p.parse_concat()
        if p.err.len > 0 {
            << left
        }
        left = p.add(kind_alt, left, right)
    }
    << left
}

fn (p &mut Parser) parse_concat() int {
    if p.pos >= p.expr.len || p.peek() == 41 || p.peek() == 124 {
        << p.add(kind_empty, 0, 0)
    }
    mut left := p.parse_quant()
    if p.err.len > 0 {
        << left
    }
    while p.pos < p.expr.len && p.peek() != 41 && p.peek() != 124 {
        right := p.parse_quant()
        if p.err.len > 0 {
            << left
        }
        left = p.add(kind_cat, left, right)
    }
    << left
}

fn (p &mut Parser) parse_quant() int {
    n := p.parse_atom()
    if p.err.len > 0 {
        << n
    }
    c := p.peek()
    if c == 42 {
        _ := p.next()
        << p.add(kind_star, n, 0)
    }
    if c == 43 {
        _ := p.next()
        << p.add(kind_plus, n, 0)
    }
    if c == 63 {
        _ := p.next()
        << p.add(kind_quest, n, 0)
    }
    << n
}

fn (p &mut Parser) parse_atom() int {
    c := p.peek()
    if c < 0 {
        p.fail("regexp: unexpected end")
        << 0
    }
    if c == 40 {
        _ := p.next()
        idx := p.num_caps
        p.num_caps = p.num_caps + 1
        start_n := p.add(kind_cap_start, idx, 0)
        inner := p.parse_alt()
        if p.next() != 41 {
            p.fail("regexp: missing )")
        }
        end_n := p.add(kind_cap_end, idx, 0)
        mid := p.add(kind_cat, inner, end_n)
        << p.add(kind_cat, start_n, mid)
    }
    if c == 91 {
        << p.parse_class()
    }
    if c == 46 {
        _ := p.next()
        << p.add(kind_any, 0, 0)
    }
    if c == 94 {
        _ := p.next()
        << p.add(kind_bol, 0, 0)
    }
    if c == 36 {
        _ := p.next()
        << p.add(kind_eol, 0, 0)
    }
    if c == 92 {
        _ := p.next()
        << p.parse_escape(false)
    }
    if c == 41 || c == 42 || c == 43 || c == 63 || c == 124 {
        p.fail("regexp: unexpected metacharacter")
        << 0
    }
    _ := p.next()
    << p.add(kind_lit, c, 0)
}

fn (p &mut Parser) parse_escape(in_class bool) int {
    e := p.next()
    if e < 0 {
        p.fail("regexp: trailing backslash")
        << 0
    }
    if e == 110 {
        << p.add(kind_lit, 10, 0)
    }
    if e == 116 {
        << p.add(kind_lit, 9, 0)
    }
    if e == 114 {
        << p.add(kind_lit, 13, 0)
    }
    if e == 100 {
        << p.push_class_preset(false, true, false, false)
    }
    if e == 68 {
        << p.push_class_preset(true, true, false, false)
    }
    if e == 119 {
        << p.push_class_preset(false, false, true, false)
    }
    if e == 87 {
        << p.push_class_preset(true, false, true, false)
    }
    if e == 115 {
        << p.push_class_preset(false, false, false, true)
    }
    if e == 83 {
        << p.push_class_preset(true, false, false, true)
    }
    if in_class {
        << p.add(kind_lit, e, 0)
    }
    << p.add(kind_lit, e, 0)
}

fn (p &mut Parser) push_class_preset(neg bool, digit bool, word bool, space bool) int {
    off := p.class_data.len
    mut n := 0
    if digit {
        for c in 48:58 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
    }
    if word {
        for c in 48:58 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
        for c in 65:91 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
        for c in 97:123 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
        p.class_data = p.class_data + string_from_byte(95)
        n = n + 1
    }
    if space {
        p.class_data = p.class_data + string_from_byte(32)
        p.class_data = p.class_data + string_from_byte(9)
        p.class_data = p.class_data + string_from_byte(10)
        p.class_data = p.class_data + string_from_byte(13)
        p.class_data = p.class_data + string_from_byte(12)
        n = n + 5
    }
    mut kind := kind_class
    if neg {
        kind = kind_nclass
    }
    << p.add(kind, off, n)
}

fn (p &mut Parser) parse_class() int {
    _ := p.next()
    mut neg := false
    if p.peek() == 94 {
        _ := p.next()
        neg = true
    }
    off := p.class_data.len
    mut n := 0
    if p.peek() == 93 {
        p.class_data = p.class_data + string_from_byte(93)
        n = n + 1
        _ := p.next()
    }
    while p.pos < p.expr.len && p.peek() != 93 {
        mut c := p.next()
        if c == 92 {
            e := p.next()
            if e < 0 {
                p.fail("regexp: bad class escape")
                << 0
            }
            if e == 110 {
                c = 10
            } else if e == 116 {
                c = 9
            } else if e == 114 {
                c = 13
            } else if e == 100 || e == 68 || e == 119 || e == 87 || e == 115 || e == 83 {
                p.fail("regexp: class preset escape unsupported inside []")
                << 0
            } else {
                c = e
            }
        }
        if p.peek() == 45 && p.pos + 1 < p.expr.len && (p.expr[p.pos + 1] & 255) != 93 {
            _ := p.next()
            hi := p.next()
            if hi < 0 {
                p.fail("regexp: bad class range")
                << 0
            }
            if hi < c {
                p.fail("regexp: inverted class range")
                << 0
            }
            for x in c:(hi + 1) {
                p.class_data = p.class_data + string_from_byte(x)
                n = n + 1
            }
        } else {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
    }
    if p.next() != 93 {
        p.fail("regexp: missing ]")
        << 0
    }
    mut kind := kind_class
    if neg {
        kind = kind_nclass
    }
    << p.add(kind, off, n)
}

fn class_has_data(data &string, off int, n int, ch int) bool {
    for i in 0:n {
        if (data[off + i] & 255) == ch {
            << true
        }
    }
    << false
}

fn (m &mut Matcher) bump() bool {
    m.steps = m.steps + 1
    if m.steps > m.re.steps_max {
        m.ok = false
        << false
    }
    << true
}

fn (m &mut Matcher) cont_push(ni int) {
    m.cont.push(ni)
}

fn (m &mut Matcher) cont_pop() int {
    if m.cont.len == 0 {
        << -1
    }
    last := m.cont[m.cont.len - 1]
    mut next := []int{}
    for i in 0:(m.cont.len - 1) {
        next.push(m.cont[i])
    }
    m.cont = next
    << last
}

fn (m &mut Matcher) cont_clone() []int {
    mut c := []int{}
    for i in 0:m.cont.len {
        c.push(m.cont[i])
    }
    << c
}

fn (m &mut Matcher) cont_restore(saved &[]int) {
    mut c := []int{}
    for i in 0:saved.len {
        c.push(saved[i])
    }
    m.cont = c
}

fn (m &mut Matcher) caps_clone_start() []int {
    mut c := []int{}
    for i in 0:m.cap_start.len {
        c.push(m.cap_start[i])
    }
    << c
}

fn (m &mut Matcher) caps_clone_end() []int {
    mut c := []int{}
    for i in 0:m.cap_end.len {
        c.push(m.cap_end[i])
    }
    << c
}

fn (m &mut Matcher) caps_restore(starts &[]int, ends &[]int) {
    mut cs := []int{}
    mut ce := []int{}
    for i in 0:starts.len {
        cs.push(starts[i])
    }
    for i in 0:ends.len {
        ce.push(ends[i])
    }
    m.cap_start = cs
    m.cap_end = ce
}

fn (m &mut Matcher) finish(pos int) bool {
    if m.cont.len == 0 {
        m.end_pos = pos
        << true
    }
    ni := m.cont_pop()
    << m.go(ni, pos)
}

fn (m &mut Matcher) go(ni int, pos int) bool {
    if !m.bump() {
        << false
    }
    node := m.re.nodes[ni]
    kind := node.kind
    if kind == kind_empty {
        << m.finish(pos)
    }
    if kind == kind_cap_start {
        idx := node.a
        if idx >= 0 && idx < m.cap_start.len {
            m.cap_start[idx] = pos
            m.cap_end[idx] = -1
        }
        << m.finish(pos)
    }
    if kind == kind_cap_end {
        idx := node.a
        if idx >= 0 && idx < m.cap_end.len {
            m.cap_end[idx] = pos
        }
        << m.finish(pos)
    }
    if kind == kind_bol {
        if pos != 0 {
            << false
        }
        << m.finish(pos)
    }
    if kind == kind_eol {
        if pos != m.text.len {
            << false
        }
        << m.finish(pos)
    }
    if kind == kind_lit {
        if pos >= m.text.len {
            << false
        }
        if (m.text[pos] & 255) != node.a {
            << false
        }
        << m.finish(pos + 1)
    }
    if kind == kind_any {
        if pos >= m.text.len {
            << false
        }
        << m.finish(pos + 1)
    }
    if kind == kind_class {
        if pos >= m.text.len {
            << false
        }
        cd := m.re.class_data + ""
        ch := m.text[pos] & 255
        if !class_has_data(&cd, node.a, node.b, ch) {
            << false
        }
        << m.finish(pos + 1)
    }
    if kind == kind_nclass {
        if pos >= m.text.len {
            << false
        }
        cd := m.re.class_data + ""
        ch := m.text[pos] & 255
        if class_has_data(&cd, node.a, node.b, ch) {
            << false
        }
        << m.finish(pos + 1)
    }
    if kind == kind_cat {
        m.cont_push(node.b)
        << m.go(node.a, pos)
    }
    if kind == kind_alt {
        saved := m.cont_clone()
        save_cs := m.caps_clone_start()
        save_ce := m.caps_clone_end()
        save_steps := m.steps
        if m.go(node.a, pos) {
            << true
        }
        if !m.ok {
            << false
        }
        m.cont_restore(&saved)
        m.caps_restore(&save_cs, &save_ce)
        m.steps = save_steps
        << m.go(node.b, pos)
    }
    if kind == kind_quest {
        saved := m.cont_clone()
        save_cs := m.caps_clone_start()
        save_ce := m.caps_clone_end()
        save_steps := m.steps
        if m.go(node.a, pos) {
            << true
        }
        if !m.ok {
            << false
        }
        m.cont_restore(&saved)
        m.caps_restore(&save_cs, &save_ce)
        m.steps = save_steps
        << m.finish(pos)
    }
    if kind == kind_star {
        << m.go_star(node.a, pos, true)
    }
    if kind == kind_plus {
        << m.go_star(node.a, pos, false)
    }
    << false
}

fn (m &mut Matcher) go_star(child int, pos int, allow_zero bool) bool {
    // greedy: prefer consuming one more child, then backtrack into continuation
    saved := m.cont_clone()
    save_cs := m.caps_clone_start()
    save_ce := m.caps_clone_end()
    save_steps := m.steps
    outer := m.cont_clone()
    m.cont = []int{}
    mut took := false
    mut mid := pos
    if m.go(child, pos) {
        if m.ok {
            mid = m.end_pos
            if mid != pos {
                took = true
            }
        }
    }
    if !m.ok {
        << false
    }
    m.cont_restore(&outer)
    m.steps = save_steps
    if took {
        if m.go_star(child, mid, true) {
            << true
        }
        if !m.ok {
            << false
        }
        m.cont_restore(&saved)
        m.caps_restore(&save_cs, &save_ce)
        m.steps = save_steps
    }
    if allow_zero {
        m.cont_restore(&saved)
        m.caps_restore(&save_cs, &save_ce)
        m.steps = save_steps
        << m.finish(pos)
    }
    << false
}

fn clone_re(re &Regexp) Regexp {
    mut nodes := []Node{}
    for i in 0:re.nodes.len {
        n := re.nodes[i]
        nodes.push(Node{kind: n.kind, a: n.a, b: n.b})
    }
    << Regexp{nodes: nodes, root: re.root, class_data: re.class_data + "", steps_max: re.steps_max, num_caps: re.num_caps}
}

fn make_matcher(re &Regexp, text &string) Matcher {
    mut cs := []int{}
    mut ce := []int{}
    for i in 0:re.num_caps {
        cs.push(-1)
        ce.push(-1)
    }
    << Matcher{re: clone_re(re), text: text + "", steps: 0, ok: true, end_pos: -1, cont: []int{}, cap_start: cs, cap_end: ce}
}

fn (re Regexp) try_at(text &string, start int) int {
    mut m := make_matcher(&re, text)
    if m.go(re.root, start) && m.ok {
        << m.end_pos
    }
    if !m.ok {
        << -2
    }
    << -1
}

pub fn (re Regexp) num_subexp() int {
    << re.num_caps
}

pub fn (re Regexp) find_submatch(s &string) []string {
    text := s + ""
    mut i := 0
    while i <= text.len {
        mut m := make_matcher(&re, &text)
        if m.go(re.root, i) && m.ok {
            mut out := []string{}
            out.push(text[i:m.end_pos] + "")
            for g in 0:re.num_caps {
                gs := m.cap_start[g]
                ge := m.cap_end[g]
                if gs >= 0 && ge >= gs && ge <= text.len {
                    out.push(text[gs:ge] + "")
                } else {
                    out.push("")
                }
            }
            << out
        }
        if !m.ok {
            << []string{}
        }
        i = i + 1
    }
    << []string{}
}

pub struct Submatch {
    pub start int
    pub end int
    pub parts []string
}

fn (re Regexp) fill_into(s &string, from int, sm &mut Submatch) bool {
    text := s + ""
    mut i := from
    while i <= text.len {
        mut m := make_matcher(&re, &text)
        if m.go(re.root, i) && m.ok {
            mut out := []string{}
            out.push(text[i:m.end_pos] + "")
            for g in 0:re.num_caps {
                gs := m.cap_start[g]
                ge := m.cap_end[g]
                if gs >= 0 && ge >= gs && ge <= text.len {
                    out.push(text[gs:ge] + "")
                } else {
                    out.push("")
                }
            }
            sm.start = i
            sm.end = m.end_pos
            sm.parts = out
            << true
        }
        if !m.ok {
            << false
        }
        i = i + 1
    }
    << false
}

pub fn (re Regexp) find_all_submatch(s &string, n int) [][]string {
    mut rows := [][]string{}
    text := s + ""
    mut i := 0
    mut found := 0
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    while i <= text.len {
        if n >= 0 && found >= n {
            <-
        }
        if !re.fill_into(&text, i, mut &sm) {
            <-
        }
        mut row := []string{}
        for k in 0:sm.parts.len {
            row.push(sm.parts[k] + "")
        }
        rows.push(row)
        found = found + 1
        if sm.end == sm.start {
            i = sm.start + 1
        } else {
            i = sm.end
        }
    }
    << rows
}

fn expand_repl(sm &Submatch, repl &string) string {
    src := repl + ""
    mut out := ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c != 36 {
            out = out + string_from_byte(c)
            i = i + 1
        } else if i + 1 >= src.len {
            out = out + "$$"
            i = i + 1
        } else {
            nch := src[i + 1] & 255
            if nch == 36 {
                out = out + "$$"
                i = i + 2
            } else if nch == 38 {
                if sm.parts.len > 0 {
                    out = out + (sm.parts[0] + "")
                }
                i = i + 2
            } else if nch >= 48 && nch <= 57 {
                idx := nch - 48
                if idx < sm.parts.len {
                    out = out + (sm.parts[idx] + "")
                }
                i = i + 2
            } else {
                out = out + "$$"
                i = i + 1
            }
        }
    }
    << out
}

pub fn (re Regexp) expand(s &string, repl &string) string {
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    if !re.fill_into(s, 0, mut &sm) {
        << ""
    }
    << expand_repl(&sm, repl)
}

pub struct LiteralPrefix {
    pub prefix string
    pub complete bool
}

struct PrefixWalk {
    prefix string
    complete bool
    stop bool
}

fn (re &Regexp) prefix_walk(idx int, out0 string) PrefixWalk {
    n := re.nodes[idx]
    if n.kind == kind_lit {
        << PrefixWalk{prefix: out0 + string_from_byte(n.a), complete: true, stop: false}
    }
    if n.kind == kind_cat {
        left := re.prefix_walk(n.a, out0)
        if left.stop {
            << PrefixWalk{prefix: left.prefix, complete: false, stop: true}
        }
        right := re.prefix_walk(n.b, left.prefix)
        mut complete := false
        if left.complete && right.complete && !right.stop {
            complete = true
        }
        << PrefixWalk{prefix: right.prefix, complete: complete, stop: right.stop}
    }
    if n.kind == kind_empty || n.kind == kind_bol || n.kind == kind_eol || n.kind == kind_cap_start || n.kind == kind_cap_end {
        << PrefixWalk{prefix: out0, complete: true, stop: false}
    }
    << PrefixWalk{prefix: out0, complete: false, stop: true}
}

pub fn (re Regexp) literal_prefix() LiteralPrefix {
    w := re.prefix_walk(re.root, "")
    << LiteralPrefix{prefix: w.prefix, complete: w.complete}
}

pub fn (re Regexp) match_string(s &string) bool {
    text := s + ""
    mut i := 0
    while i <= text.len {
        end := re.try_at(&text, i)
        if end == -2 {
            << false
        }
        if end >= 0 {
            << true
        }
        i = i + 1
    }
    << false
}

pub fn (re Regexp) find(s &string) string {
    text := s + ""
    mut i := 0
    while i <= text.len {
        end := re.try_at(&text, i)
        if end == -2 {
            << ""
        }
        if end >= 0 {
            << text[i:end]
        }
        i = i + 1
    }
    << ""
}

pub struct Index {
    pub start int
    pub end int
}

pub fn (re Regexp) find_index(s &string) Index {
    text := s + ""
    mut i := 0
    while i <= text.len {
        end := re.try_at(&text, i)
        if end == -2 {
            << Index{start: 0 - 1, end: 0 - 1}
        }
        if end >= 0 {
            << Index{start: i, end: end}
        }
        i = i + 1
    }
    << Index{start: 0 - 1, end: 0 - 1}
}

pub fn (re Regexp) find_all_index(s &string, n int) []Index {
    mut out := []Index{}
    if n == 0 {
        << out
    }
    text := s + ""
    mut i := 0
    mut found := 0
    while i <= text.len {
        if n >= 0 && found >= n {
            <-
        }
        end := re.try_at(&text, i)
        if end == -2 {
            << out
        }
        if end >= 0 {
            out.push(Index{start: i, end: end})
            found = found + 1
            if end == i {
                i = i + 1
            } else {
                i = end
            }
            ->
        }
        i = i + 1
    }
    << out
}

pub fn (re Regexp) find_all(s &string, n int) []string {
    mut out := []string{}
    text := s + ""
    mut i := 0
    mut found := 0
    while i <= text.len {
        if n >= 0 && found >= n {
            <-
        }
        end := re.try_at(&text, i)
        if end == -2 {
            << out
        }
        if end >= 0 {
            out.push(text[i:end] + "")
            found = found + 1
            if end == i {
                i = i + 1
            } else {
                i = end
            }
            ->
        }
        i = i + 1
    }
    << out
}

pub fn (re Regexp) split(s &string, n int) []string {
    mut out := []string{}
    if n == 0 {
        << out
    }
    text := s + ""
    if n == 1 {
        out.push(text)
        << out
    }
    mut i := 0
    mut parts := 0
    mut last := 0
    while i <= text.len {
        if n > 0 && parts >= n - 1 {
            <-
        }
        end := re.try_at(&text, i)
        if end == -2 {
            <-
        }
        if end >= 0 {
            out.push(text[last:i] + "")
            parts = parts + 1
            if end == i {
                last = i + 1
                i = i + 1
            } else {
                last = end
                i = end
            }
            ->
        }
        i = i + 1
    }
    out.push(text[last:text.len] + "")
    << out
}

pub fn (re Regexp) find_submatch_index(s &string) []Index {
    text := s + ""
    mut i := 0
    while i <= text.len {
        mut m := make_matcher(&re, &text)
        if m.go(re.root, i) && m.ok {
            mut out := []Index{}
            out.push(Index{start: i, end: m.end_pos})
            for g in 0:re.num_caps {
                gs := m.cap_start[g]
                ge := m.cap_end[g]
                if gs >= 0 && ge >= gs && ge <= text.len {
                    out.push(Index{start: gs, end: ge})
                } else {
                    out.push(Index{start: 0 - 1, end: 0 - 1})
                }
            }
            << out
        }
        if !m.ok {
            << []Index{}
        }
        i = i + 1
    }
    << []Index{}
}

pub fn (re Regexp) replace_all_literal(s &string, repl &string) string {
    text := s + ""
    mut out := ""
    mut i := 0
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    while i <= text.len {
        if !re.fill_into(&text, i, mut &sm) {
            out = out + text[i:text.len]
            <-
        }
        out = out + text[i:sm.start]
        lit := repl + ""
        out = out + lit
        if sm.end == sm.start {
            if sm.start >= text.len {
                <-
            }
            out = out + string_from_byte(text[sm.start])
            i = sm.start + 1
        } else {
            i = sm.end
        }
    }
    << out
}

pub fn (re Regexp) replace_all(s &string, repl &string) string {
    text := s + ""
    mut out := ""
    mut i := 0
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    while i <= text.len {
        if !re.fill_into(&text, i, mut &sm) {
            out = out + text[i:text.len]
            <-
        }
        out = out + text[i:sm.start]
        out = out + expand_repl(&sm, repl)
        if sm.end == sm.start {
            if sm.start >= text.len {
                <-
            }
            out = out + string_from_byte(text[sm.start])
            i = sm.start + 1
        } else {
            i = sm.end
        }
    }
    << out
}
