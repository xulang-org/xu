@regexp


#errors
// Minimal regexp subset (Go regexp-shaped API, not full RE2).
// Flat node pool + iterative, bounded backtracking. No native recursion while matching.

const KIND_LIT = 1
const KIND_ANY = 2
const KIND_CLASS = 3
const KIND_NCLASS = 4
const KIND_STAR = 5
const KIND_PLUS = 6
const KIND_QUEST = 7
const KIND_ALT = 8
const KIND_CAT = 9
const KIND_BOL = 10
const KIND_EOL = 11
const KIND_EMPTY = 12
const KIND_CAP_START = 13
const KIND_CAP_END = 14

const STEPS_DEFAULT = 16000000

pub struct Regexp {
    pub nodes []Node
    pub root int
    pub class_data string
    pub steps_max int
    pub num_caps int
}

struct Node {
    kind int
    a int
    b int
}

struct Parser {
    expr string
    pos int
    nodes []Node
    class_data string
    err string
    num_caps int
    depth int
}

struct Matcher {
    re Regexp
    text string
    steps int
    ok bool
    end_pos int
    tasks []MatchTask
    task_count int
    choices []MatchChoice
    choice_count int
    saved_tasks []MatchTask
    saved_count int
    saved_captures []int
    capture_count int
    cap_start []int
    cap_end []int
}

fn is_meta(c int) bool {
    if c == 92 || c == 46 || c == 43 || c == 42 || c == 63 || c == 40 || c == 41 {
        << true
    }
    if c == 124 || c == 91 || c == 93 || c == 123 || c == 125 || c == 94 || c == 36 {
        << true
    }
    << false
}

pub fn quote_meta(s &string) string {
    src := s + ""
    mut out := ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if is_meta(c) {
            out.push_byte(92)
        }
        out.push_byte(c)
        i = i + 1
    }
    << out
}

pub fn compile(expr string) Regexp {
    if expr.len > 65536 { >> errors.new("regexp: expression exceeds 65536 bytes") }
    mut p := Parser{expr: expr, pos: 0, nodes: []Node{}, class_data: "", err: "", num_caps: 0, depth: 0}
    root := p.parse_alt()
    if p.err.len > 0 {
        >> errors.new(p.err + "")
    }
    if p.pos != p.expr.len {
        >> errors.new("regexp: unexpected trailing input")
    }
    mut nodes := []Node{}
    for i in 0:p.nodes.len {
        n := p.nodes[i]
        nodes.push(Node{kind: n.kind, a: n.a, b: n.b})
    }
    cd := p.class_data + ""
    << Regexp{nodes: nodes, root: root, class_data: cd, steps_max: STEPS_DEFAULT, num_caps: p.num_caps}
}

fn (p &mut Parser) fail(msg string) {
    if p.err.len == 0 {
        p.err = msg + ""
    }
}

fn (p &mut Parser) peek() int {
    if p.pos >= p.expr.len {
        << -1
    }
    << p.expr[p.pos] & 255
}

fn (p &mut Parser) next() int {
    if p.pos >= p.expr.len {
        << -1
    }
    c := p.expr[p.pos] & 255
    p.pos = p.pos + 1
    << c
}

fn (p &mut Parser) add(kind int, a int, b int) int {
    p.nodes.push(Node{kind: kind, a: a, b: b})
    << p.nodes.len - 1
}

fn (p &mut Parser) parse_alt() int {
    mut left := p.parse_concat()
    if p.err.len > 0 {
        << left
    }
    while p.peek() == 124 {
        _ := p.next()
        right := p.parse_concat()
        if p.err.len > 0 {
            << left
        }
        left = p.add(KIND_ALT, left, right)
    }
    << left
}

fn (p &mut Parser) parse_concat() int {
    if p.pos >= p.expr.len || p.peek() == 41 || p.peek() == 124 {
        << p.add(KIND_EMPTY, 0, 0)
    }
    mut left := p.parse_quant()
    if p.err.len > 0 {
        << left
    }
    while p.pos < p.expr.len && p.peek() != 41 && p.peek() != 124 {
        right := p.parse_quant()
        if p.err.len > 0 {
            << left
        }
        left = p.add(KIND_CAT, left, right)
    }
    << left
}

fn (p &mut Parser) parse_quant() int {
    n := p.parse_atom()
    if p.err.len > 0 {
        << n
    }
    c := p.peek()
    if c == 42 {
        _ := p.next()
        << p.add(KIND_STAR, n, 0)
    }
    if c == 43 {
        _ := p.next()
        << p.add(KIND_PLUS, n, 0)
    }
    if c == 63 {
        _ := p.next()
        << p.add(KIND_QUEST, n, 0)
    }
    << n
}

fn (p &mut Parser) parse_atom() int {
    c := p.peek()
    if c < 0 {
        p.fail("regexp: unexpected end")
        << 0
    }
    if c == 40 {
        if p.depth >= 64 {
            p.fail("regexp: group nesting exceeds 64")
            << 0
        }
        p.depth += 1
        _ := p.next()
        idx := p.num_caps
        p.num_caps = p.num_caps + 1
        start_n := p.add(KIND_CAP_START, idx, 0)
        inner := p.parse_alt()
        p.depth -= 1
        if p.next() != 41 {
            p.fail("regexp: missing )")
        }
        end_n := p.add(KIND_CAP_END, idx, 0)
        mid := p.add(KIND_CAT, inner, end_n)
        << p.add(KIND_CAT, start_n, mid)
    }
    if c == 91 {
        << p.parse_class()
    }
    if c == 46 {
        _ := p.next()
        << p.add(KIND_ANY, 0, 0)
    }
    if c == 94 {
        _ := p.next()
        << p.add(KIND_BOL, 0, 0)
    }
    if c == 36 {
        _ := p.next()
        << p.add(KIND_EOL, 0, 0)
    }
    if c == 92 {
        _ := p.next()
        << p.parse_escape(false)
    }
    if c == 41 || c == 42 || c == 43 || c == 63 || c == 124 {
        p.fail("regexp: unexpected metacharacter")
        << 0
    }
    _ := p.next()
    << p.add(KIND_LIT, c, 0)
}

fn (p &mut Parser) parse_escape(in_class bool) int {
    e := p.next()
    if e < 0 {
        p.fail("regexp: trailing backslash")
        << 0
    }
    if e == 110 {
        << p.add(KIND_LIT, 10, 0)
    }
    if e == 116 {
        << p.add(KIND_LIT, 9, 0)
    }
    if e == 114 {
        << p.add(KIND_LIT, 13, 0)
    }
    if e == 100 {
        << p.push_class_preset(false, true, false, false)
    }
    if e == 68 {
        << p.push_class_preset(true, true, false, false)
    }
    if e == 119 {
        << p.push_class_preset(false, false, true, false)
    }
    if e == 87 {
        << p.push_class_preset(true, false, true, false)
    }
    if e == 115 {
        << p.push_class_preset(false, false, false, true)
    }
    if e == 83 {
        << p.push_class_preset(true, false, false, true)
    }
    if in_class {
        << p.add(KIND_LIT, e, 0)
    }
    << p.add(KIND_LIT, e, 0)
}

fn (p &mut Parser) push_class_preset(neg bool, digit bool, word bool, space bool) int {
    off := p.class_data.len
    mut n := 0
    if digit {
        for c in 48:58 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
    }
    if word {
        for c in 48:58 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
        for c in 65:91 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
        for c in 97:123 {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
        p.class_data = p.class_data + string_from_byte(95)
        n = n + 1
    }
    if space {
        p.class_data = p.class_data + string_from_byte(32)
        p.class_data = p.class_data + string_from_byte(9)
        p.class_data = p.class_data + string_from_byte(10)
        p.class_data = p.class_data + string_from_byte(13)
        p.class_data = p.class_data + string_from_byte(12)
        n = n + 5
    }
    mut kind := KIND_CLASS
    if neg {
        kind = KIND_NCLASS
    }
    << p.add(kind, off, n)
}

fn (p &mut Parser) parse_class() int {
    _ := p.next()
    mut neg := false
    if p.peek() == 94 {
        _ := p.next()
        neg = true
    }
    off := p.class_data.len
    mut n := 0
    if p.peek() == 93 {
        p.class_data = p.class_data + string_from_byte(93)
        n = n + 1
        _ := p.next()
    }
    while p.pos < p.expr.len && p.peek() != 93 {
        mut c := p.next()
        if c == 92 {
            e := p.next()
            if e < 0 {
                p.fail("regexp: bad class escape")
                << 0
            }
            if e == 110 {
                c = 10
            } else if e == 116 {
                c = 9
            } else if e == 114 {
                c = 13
            } else if e == 100 || e == 68 || e == 119 || e == 87 || e == 115 || e == 83 {
                p.fail("regexp: class preset escape unsupported inside []")
                << 0
            } else {
                c = e
            }
        }
        if p.peek() == 45 && p.pos + 1 < p.expr.len && (p.expr[p.pos + 1] & 255) != 93 {
            _ := p.next()
            hi := p.next()
            if hi < 0 {
                p.fail("regexp: bad class range")
                << 0
            }
            if hi < c {
                p.fail("regexp: inverted class range")
                << 0
            }
            for x in c:(hi + 1) {
                p.class_data = p.class_data + string_from_byte(x)
                n = n + 1
            }
        } else {
            p.class_data = p.class_data + string_from_byte(c)
            n = n + 1
        }
    }
    if p.next() != 93 {
        p.fail("regexp: missing ]")
        << 0
    }
    mut kind := KIND_CLASS
    if neg {
        kind = KIND_NCLASS
    }
    << p.add(kind, off, n)
}

fn class_has_data(data &string, off int, n int, ch int) bool {
    for i in 0:n {
        if (data[off + i] & 255) == ch {
            << true
        }
    }
    << false
}

fn (m &mut Matcher) bump() bool {
    if m.re.steps_max <= 0 || m.steps >= m.re.steps_max {
        m.ok = false
        << false
    }
    m.steps += 1
    << true
}

struct MatchTask {
    node int
    previous int
}

struct MatchChoice {
    pos int
    task_start int
    task_count int
    capture_start int
}

fn (m &mut Matcher) task_push(node int, previous int) {
    task := MatchTask{node: node, previous: previous}
    if m.task_count < m.tasks.len { m.tasks[m.task_count] = task } else { m.tasks.push(task) }
    m.task_count += 1
}

fn (m &mut Matcher) choice_push(pos int) bool {
    if !m.bump() { << false }
    choice := MatchChoice{pos: pos, task_start: m.saved_count, task_count: m.task_count, capture_start: m.capture_count}
    for i in 0:m.task_count {
        if !m.bump() { << false }
        task := m.tasks[i]
        if m.saved_count < m.saved_tasks.len { m.saved_tasks[m.saved_count] = task } else { m.saved_tasks.push(task) }
        m.saved_count += 1
    }
    for i in 0:m.cap_start.len {
        if !m.bump() { << false }
        if m.capture_count < m.saved_captures.len {
            m.saved_captures[m.capture_count] = m.cap_start[i]
            m.saved_captures[m.capture_count + 1] = m.cap_end[i]
        } else {
            m.saved_captures.push(m.cap_start[i])
            m.saved_captures.push(m.cap_end[i])
        }
        m.capture_count += 2
    }
    if m.choice_count < m.choices.len { m.choices[m.choice_count] = choice } else { m.choices.push(choice) }
    m.choice_count += 1
    << true
}

fn (m &mut Matcher) backtrack() int {
    if m.choice_count == 0 { << -1 }
    m.choice_count -= 1
    choice := m.choices[m.choice_count]
    m.task_count = 0
    for i in 0:choice.task_count {
        task := m.saved_tasks[choice.task_start + i]
        m.task_push(task.node, task.previous)
    }
    for i in 0:m.cap_start.len {
        m.cap_start[i] = m.saved_captures[choice.capture_start + i * 2]
        m.cap_end[i] = m.saved_captures[choice.capture_start + i * 2 + 1]
    }
    m.saved_count = choice.task_start
    m.capture_count = choice.capture_start
    << choice.pos
}

// Native stack usage is independent of input length. Choices keep the
// pending continuation and captures on the heap, including alternatives
// inside a repeated group.
fn (m &mut Matcher) go(root int, start int) bool {
    m.task_count = 0
    m.choice_count = 0
    m.saved_count = 0
    m.capture_count = 0
    for i in 0:m.cap_start.len {
        m.cap_start[i] = -1
        m.cap_end[i] = -1
    }
    m.task_push(root, -1)
    mut pos := start
    while true {
        if !m.bump() { << false }
        if m.task_count == 0 {
            m.end_pos = pos
            << true
        }
        m.task_count -= 1
        task := m.tasks[m.task_count]
        mut ni := task.node
        mut repeat := false
        if ni < 0 {
            if pos == task.previous { -> }
            ni = 0 - ni - 1
            repeat = true
        }
        node := m.re.nodes[ni]
        kind := node.kind
        mut failed := false
        if kind == KIND_EMPTY {
            ->
        } else if kind == KIND_CAT {
            m.task_push(node.b, -1)
            m.task_push(node.a, -1)
        } else if kind == KIND_ALT {
            m.task_push(node.b, -1)
            if !m.choice_push(pos) { << false }
            m.task_count -= 1
            m.task_push(node.a, -1)
        } else if kind == KIND_QUEST {
            if !m.choice_push(pos) { << false }
            m.task_push(node.a, -1)
        } else if kind == KIND_STAR || kind == KIND_PLUS {
            if kind == KIND_STAR || repeat { if !m.choice_push(pos) { << false } }
            m.task_push(0 - ni - 1, pos)
            m.task_push(node.a, -1)
        } else if kind == KIND_CAP_START {
            m.cap_start[node.a] = pos
            m.cap_end[node.a] = -1
        } else if kind == KIND_CAP_END {
            m.cap_end[node.a] = pos
        } else if kind == KIND_BOL {
            failed = pos != 0
        } else if kind == KIND_EOL {
            failed = pos != m.text.len
        } else {
            if pos >= m.text.len {
                failed = true
            } else {
                ch := m.text[pos] & 255
                if kind == KIND_LIT {
                    failed = ch != node.a
                } else if kind == KIND_CLASS || kind == KIND_NCLASS {
                    has := class_has_data(&m.re.class_data, node.a, node.b, ch)
                    failed = !has
                    if kind == KIND_NCLASS { failed = has }
                } else if kind != KIND_ANY {
                    failed = true
                }
                if !failed { pos += 1 }
            }
        }
        if failed {
            pos = m.backtrack()
            if pos < 0 { << false }
        }
    }
    << false
}

fn clone_re(re &Regexp) Regexp {
    mut nodes := []Node{}
    for i in 0:re.nodes.len {
        n := re.nodes[i]
        nodes.push(Node{kind: n.kind, a: n.a, b: n.b})
    }
    << Regexp{nodes: nodes, root: re.root, class_data: re.class_data + "", steps_max: re.steps_max, num_caps: re.num_caps}
}

fn make_matcher(re &Regexp, text &string) Matcher {
    mut cs := []int{}
    mut ce := []int{}
    for i in 0:re.num_caps {
        cs.push(-1)
        ce.push(-1)
    }
    << Matcher{re: clone_re(re), text: text + "", steps: 0, ok: true, end_pos: -1, tasks: []MatchTask{}, task_count: 0, choices: []MatchChoice{}, choice_count: 0, saved_tasks: []MatchTask{}, saved_count: 0, saved_captures: []int{}, capture_count: 0, cap_start: cs, cap_end: ce}
}

fn (m &mut Matcher) try_at(start int) int {
    matched := m.go(m.re.root, start)
    if matched && m.ok {
        << m.end_pos
    }
    if !m.ok {
        << -2
    }
    << -1
}

pub fn (re Regexp) num_subexp() int {
    << re.num_caps
}

pub fn (re Regexp) find_submatch(s &string) []string {
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    while i <= text.len {
        matched := m.go(m.re.root, i)
        if matched && m.ok {
            mut out := []string{}
            out.push(text[i:m.end_pos] + "")
            for g in 0:re.num_caps {
                gs := m.cap_start[g]
                ge := m.cap_end[g]
                if gs >= 0 && ge >= gs && ge <= text.len {
                    out.push(text[gs:ge] + "")
                } else {
                    out.push("")
                }
            }
            << out
        }
        if !m.ok {
            << []string{}
        }
        i = i + 1
    }
    << []string{}
}

pub struct Submatch {
    pub start int
    pub end int
    pub parts []string
}

fn (m &mut Matcher) fill_into(from int, sm &mut Submatch) bool {
    mut i := from
    while i <= m.text.len {
        matched := m.go(m.re.root, i)
        if matched && m.ok {
            mut out := []string{}
            out.push(m.text[i:m.end_pos] + "")
            for g in 0:m.re.num_caps {
                gs := m.cap_start[g]
                ge := m.cap_end[g]
                if gs >= 0 && ge >= gs && ge <= m.text.len {
                    out.push(m.text[gs:ge] + "")
                } else {
                    out.push("")
                }
            }
            sm.start = i
            sm.end = m.end_pos
            sm.parts = out
            << true
        }
        if !m.ok {
            << false
        }
        i = i + 1
    }
    << false
}

pub fn (re Regexp) find_all_submatch(s &string, n int) [][]string {
    mut rows := [][]string{}
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    mut found := 0
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    while i <= text.len {
        if n >= 0 && found >= n {
            <-
        }
        found_match := m.fill_into(i, mut &sm)
        if !found_match {
            <-
        }
        mut row := []string{}
        for k in 0:sm.parts.len {
            row.push(sm.parts[k] + "")
        }
        rows.push(row)
        found = found + 1
        if sm.end == sm.start {
            i = sm.start + 1
        } else {
            i = sm.end
        }
    }
    << rows
}

fn expand_repl(sm &Submatch, repl &string) string {
    src := repl + ""
    mut out := ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c != 36 {
            out = out + string_from_byte(c)
            i = i + 1
        } else if i + 1 >= src.len {
            out = out + "$$"
            i = i + 1
        } else {
            nch := src[i + 1] & 255
            if nch == 36 {
                out = out + "$$"
                i = i + 2
            } else if nch == 38 {
                if sm.parts.len > 0 {
                    out = out + (sm.parts[0] + "")
                }
                i = i + 2
            } else if nch >= 48 && nch <= 57 {
                idx := nch - 48
                if idx < sm.parts.len {
                    out = out + (sm.parts[idx] + "")
                }
                i = i + 2
            } else {
                out = out + "$$"
                i = i + 1
            }
        }
    }
    << out
}

pub fn (re Regexp) expand(s &string, repl &string) string {
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    mut m := make_matcher(&re, s)
    found_match := m.fill_into(0, mut &sm)
    if !found_match {
        << ""
    }
    << expand_repl(&sm, repl)
}

pub struct LiteralPrefix {
    pub prefix string
    pub complete bool
}

struct PrefixWalk {
    prefix string
    complete bool
    stop bool
}

fn (re &Regexp) prefix_walk(idx int, out0 string) PrefixWalk {
    mut stack := []int{}
    stack.push(idx)
    mut top := 1
    mut out := out0 + ""
    while top > 0 {
        top -= 1
        n := re.nodes[stack[top]]
        if n.kind == KIND_LIT {
            out = out + string_from_byte(n.a)
        } else if n.kind == KIND_CAT {
            if top < stack.len { stack[top] = n.b } else { stack.push(n.b) }
            top += 1
            if top < stack.len { stack[top] = n.a } else { stack.push(n.a) }
            top += 1
        } else if n.kind != KIND_EMPTY && n.kind != KIND_BOL && n.kind != KIND_EOL && n.kind != KIND_CAP_START && n.kind != KIND_CAP_END {
            << PrefixWalk{prefix: out, complete: false, stop: true}
        }
    }
    << PrefixWalk{prefix: out, complete: true, stop: false}
}

pub fn (re Regexp) literal_prefix() LiteralPrefix {
    w := re.prefix_walk(re.root, "")
    << LiteralPrefix{prefix: w.prefix, complete: w.complete}
}

pub fn (re Regexp) match_string(s &string) bool {
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    while i <= text.len {
        end := m.try_at(i)
        if end == -2 {
            << false
        }
        if end >= 0 {
            << true
        }
        i = i + 1
    }
    << false
}

pub fn (re Regexp) find(s &string) string {
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    while i <= text.len {
        end := m.try_at(i)
        if end == -2 {
            << ""
        }
        if end >= 0 {
            << text[i:end]
        }
        i = i + 1
    }
    << ""
}

pub struct Index {
    pub start int
    pub end int
}

pub fn (re Regexp) find_index(s &string) Index {
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    while i <= text.len {
        end := m.try_at(i)
        if end == -2 {
            << Index{start: 0 - 1, end: 0 - 1}
        }
        if end >= 0 {
            << Index{start: i, end: end}
        }
        i = i + 1
    }
    << Index{start: 0 - 1, end: 0 - 1}
}

pub fn (re Regexp) find_all_index(s &string, n int) []Index {
    mut out := []Index{}
    if n == 0 {
        << out
    }
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    mut found := 0
    while i <= text.len {
        if n >= 0 && found >= n {
            <-
        }
        end := m.try_at(i)
        if end == -2 {
            << out
        }
        if end >= 0 {
            out.push(Index{start: i, end: end})
            found = found + 1
            if end == i {
                i = i + 1
            } else {
                i = end
            }
            ->
        }
        i = i + 1
    }
    << out
}

pub fn (re Regexp) find_all(s &string, n int) []string {
    mut out := []string{}
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    mut found := 0
    while i <= text.len {
        if n >= 0 && found >= n {
            <-
        }
        end := m.try_at(i)
        if end == -2 {
            << out
        }
        if end >= 0 {
            out.push(text[i:end] + "")
            found = found + 1
            if end == i {
                i = i + 1
            } else {
                i = end
            }
            ->
        }
        i = i + 1
    }
    << out
}

pub fn (re Regexp) split(s &string, n int) []string {
    mut out := []string{}
    if n == 0 {
        << out
    }
    text := s + ""
    if n == 1 {
        out.push(text)
        << out
    }
    mut m := make_matcher(&re, &text)
    mut i := 0
    mut parts := 0
    mut last := 0
    while i <= text.len {
        if n > 0 && parts >= n - 1 {
            <-
        }
        end := m.try_at(i)
        if end == -2 {
            <-
        }
        if end >= 0 {
            out.push(text[last:i] + "")
            parts = parts + 1
            if end == i {
                last = i + 1
                i = i + 1
            } else {
                last = end
                i = end
            }
            ->
        }
        i = i + 1
    }
    out.push(text[last:text.len] + "")
    << out
}

pub fn (re Regexp) find_submatch_index(s &string) []Index {
    text := s + ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    while i <= text.len {
        matched := m.go(m.re.root, i)
        if matched && m.ok {
            mut out := []Index{}
            out.push(Index{start: i, end: m.end_pos})
            for g in 0:re.num_caps {
                gs := m.cap_start[g]
                ge := m.cap_end[g]
                if gs >= 0 && ge >= gs && ge <= text.len {
                    out.push(Index{start: gs, end: ge})
                } else {
                    out.push(Index{start: 0 - 1, end: 0 - 1})
                }
            }
            << out
        }
        if !m.ok {
            << []Index{}
        }
        i = i + 1
    }
    << []Index{}
}

pub fn (re Regexp) replace_all_literal(s &string, repl &string) string {
    text := s + ""
    mut out := ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    while i <= text.len {
        found_match := m.fill_into(i, mut &sm)
        if !found_match {
            out = out + text[i:text.len]
            <-
        }
        out = out + text[i:sm.start]
        lit := repl + ""
        out = out + lit
        if sm.end == sm.start {
            if sm.start >= text.len {
                <-
            }
            out = out + string_from_byte(text[sm.start])
            i = sm.start + 1
        } else {
            i = sm.end
        }
    }
    << out
}

pub fn (re Regexp) replace_all(s &string, repl &string) string {
    text := s + ""
    mut out := ""
    mut m := make_matcher(&re, &text)
    mut i := 0
    mut sm := Submatch{start: 0, end: 0, parts: []string{}}
    while i <= text.len {
        found_match := m.fill_into(i, mut &sm)
        if !found_match {
            out = out + text[i:text.len]
            <-
        }
        out = out + text[i:sm.start]
        out = out + expand_repl(&sm, repl)
        if sm.end == sm.start {
            if sm.start >= text.len {
                <-
            }
            out = out + string_from_byte(text[sm.start])
            i = sm.start + 1
        } else {
            i = sm.end
        }
    }
    << out
}
