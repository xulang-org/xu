@embedded/display/memory

#embedded/display
#embedded/display/geometry

// Portable reference backend; no GPIO, controller, bus, timer or OS dependency.
pub const MAX_PIXELS = 262144

pub struct Framebuffer {
    width int
    height int
    pixels []int
}
fn fill(frame $&Framebuffer, area &geometry.Rect, color int) bool {
    for y in area.y:area.y + area.height {
        for x in area.x:area.x + area.width { frame.pixels[y * frame.width + x] = color }
    }
    << true
}
fn write(frame $&Framebuffer, span &geometry.Span, pixels &[]int) bool {
    at := span.y * frame.width + span.x
    for i in 0:span.count { frame.pixels[at + i] = pixels[span.offset + i] }
    << true
}
pub fn create(width int, height int) display.Surface#Framebuffer {
    if width < 1 || height < 1 || width > display.MAX_DIMENSION ||
        height > display.MAX_DIMENSION || width > MAX_PIXELS / height {
        << display.create(0,0,Framebuffer{width: 0,height: 0,pixels: []int{}},fill,write)
    }
    $pixels := []int{}
    for i in 0:width * height { pixels.push(0) }
    backend := Framebuffer{width: width,height: height,pixels: pixels}
    << display.create(width,height,backend,fill,write)
}
pub fn pixel(x int, y int, surface &display.Surface#Framebuffer) int {
    if x < 0 || y < 0 || x >= surface.width() || y >= surface.height() { << -1 }
    frame := &surface.backend
    << frame.pixels[y * frame.width + x]
}
// Independent packed RGB565 copy for snapshots, high byte first.
pub fn rgb565_bytes(surface &display.Surface#Framebuffer) string {
    frame := &surface.backend
    $out := make_string(frame.pixels.len * 2)
    for i in 0:frame.pixels.len {
        color := frame.pixels[i]
        out[i * 2] = (color >> 8) & 255
        out[i * 2 + 1] = color & 255
    }
    << out
}
