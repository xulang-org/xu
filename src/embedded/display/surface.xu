@embedded/display

#embedded/display/geometry

// Logical coordinates and RGB565 colors are independent of the controller,
// bus, and wire byte order. Backends receive clipped, synchronous operations.
pub const MAX_DIMENSION = 32768

// Typed backend ownership avoids globals, erased context pointers and an
// escaping borrow of driver state. Only board/driver code uses backend.
pub struct Surface#T {
    pub backend T
    pixel_width int
    pixel_height int
    fill fn($&T, &geometry.Rect, int) bool
    write fn($&T, &geometry.Span, &[]int) bool
}

pub fn create#T(width int, height int, backend T,
    fill fn($&T, &geometry.Rect, int) bool,
    write fn($&T, &geometry.Span, &[]int) bool) Surface#T {
    $w := width
    $h := height
    if w < 1 || h < 1 || w > MAX_DIMENSION || h > MAX_DIMENSION {
        w = 0
        h = 0
    }
    << Surface#T{backend: backend, pixel_width: w, pixel_height: h,
        fill: fill, write: write}
}

pub fn (surface &Surface#T) width() int { << surface.pixel_width }
pub fn (surface &Surface#T) height() int { << surface.pixel_height }
pub fn (surface &Surface#T) valid() bool {
    << surface.pixel_width > 0 && surface.pixel_height > 0 &&
        surface.pixel_width <= MAX_DIMENSION && surface.pixel_height <= MAX_DIMENSION
}

fn clipped_rect(width int, height int, x int, y int, w int, h int) geometry.Rect {
    $area := geometry.Rect{x: x, y: y, width: w, height: h}
    if w <= 0 || h <= 0 || x >= width || y >= height {
        area.width = 0
        area.height = 0
        << area
    }
    // Add negative origins only after excluding an entirely clipped extent.
    // This avoids x+w/y+h overflow, including minimum signed coordinates.
    if x < 0 {
        if x <= 0 - w { area.width = 0
            << area }
        area.width = w + x
        area.x = 0
    }
    if y < 0 {
        if y <= 0 - h { area.height = 0
            << area }
        area.height = h + y
        area.y = 0
    }
    if area.width > width - area.x { area.width = width - area.x }
    if area.height > height - area.y { area.height = height - area.y }
    << area
}

pub fn (surface $&Surface#T) fill_rect(x int, y int, width int, height int, color int) bool {
    if !surface.valid() || color < 0 || color > 65535 { << false }
    area := clipped_rect(surface.pixel_width,surface.pixel_height,x,y,width,height)
    if area.width <= 0 || area.height <= 0 { << true }
    draw := surface.fill
    << draw($&surface.backend,&area,color)
}

pub fn (surface $&Surface#T) clear(color int) bool {
    << surface.fill_rect(0,0,surface.pixel_width,surface.pixel_height,color)
}

// One horizontal row of count logical RGB565 values (one integer per pixel).
// Buffers may be reused immediately after this call; a backend must not
// retain their borrow. Clipping adjusts the source offset without copying pixels.
pub fn (surface $&Surface#T) write_rgb565(x int, y int, pixels &[]int, count int) bool {
    if !surface.valid() || count < 0 || count > pixels.len { << false }
    if count == 0 || y < 0 || y >= surface.pixel_height || x >= surface.pixel_width { << true }
    $span := geometry.Span{x: x, y: y, offset: 0, count: count}
    if x < 0 {
        if x <= 0 - count { << true }
        span.offset = 0 - x
        span.count = count + x
        span.x = 0
    }
    if span.count > surface.pixel_width - span.x { span.count = surface.pixel_width - span.x }
    for i in 0:span.count {
        color := pixels[span.offset + i]
        if color < 0 || color > 65535 { << false }
    }
    draw := surface.write
    << draw($&surface.backend,&span,pixels)
}
