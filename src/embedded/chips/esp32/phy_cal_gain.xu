@embedded/chips/esp32

// Native BT PA encodings and digital attenuation differences from the
// bt_tx_gain_cal switch table, independently checked against its hardware
// loop assembly (the decompiler omits all but the first iteration).
fn phy_cal_pa(level int) int {
    if level == 2 { << 0x34 }
    if level == 3 { << 0x38 }
    if level == 4 { << 0x3C }
    if level == 5 { << 0x39 }
    if level == 6 { << 0x3D }
    if level == 7 { << 0x3E }
    << 0x30
}

fn phy_cal_digital_offset(level int) int {
    if level == 1 { << -6 }
    if level == 3 { << 8 }
    if level == 6 || level == 7 { << 4 }
    << 6
}

fn phy_cal_write_gain(low int, high int, address int) {
    // ram_write_gain_mem: byte enables F0 and 0F latch high and low
    // halves of one 64-bit gain entry through the shared FE memory port.
    volatile_store(0x3FF45038, high)
    volatile_store(0x3FF45034, (volatile_load(0x3FF45034) & 0xFFFC0000) | ((address << 8) + 0x100F0))
    volatile_store(0x3FF45038, low)
    volatile_store(0x3FF45034, (volatile_load(0x3FF45034) & 0xFFFC0000) | ((address << 8) + 0x1000F))
    volatile_store(0x3FF45034, volatile_load(0x3FF45034) & 0xFFFCFFFF)
}

pub fn phy_cal_bt_gain_memory() bool {
    if (volatile_load(0x3FFD741C) & 63) != 63 || phy_cal_i2c_error() != 0 { << false }
    $index := volatile_load(0x3FFD7520)
    base := volatile_load(0x3FFD7524)
    if index < 0 || index > 2 || base < -24 || base > 90 { << false }
    // bt_correct_bbgain's two correction trials, retaining the adjustment
    // for all eight attenuation entries and choosing the calibrated row.
    $correction := 0
    $first_atten := base + 6
    if first_atten < 0 { first_atten = 0 }
    if first_atten > 64 { first_atten = 64 }
    for i in 0:2 {
        if first_atten > 48 && index > 0 {
            index = index - 1
            first_atten = first_atten - 24
            correction = correction - 24
        } else if first_atten < 12 && index < 3 {
            index = index + 1
            first_atten = first_atten + 24
            correction = correction + 24
        }
    }
    if index == 3 { index = 1 }
    $bb := 0
    $dc0 := volatile_load(0x3FFD7480)
    $dc1 := volatile_load(0x3FFD7484)
    $iq := volatile_load(0x3FFD74B0)
    if index == 1 {
        bb = 0x20
        dc0 = volatile_load(0x3FFD7488)
        dc1 = volatile_load(0x3FFD748C)
        iq = volatile_load(0x3FFD74B4)
    } else if index == 2 {
        bb = 0x30
        dc0 = volatile_load(0x3FFD7490)
        dc1 = volatile_load(0x3FFD7494)
        iq = volatile_load(0x3FFD74B8)
    }
    i0 := dc0 & 0xFFFF
    q0 := (dc0 >> 16) & 0xFFFF
    i1 := dc1 & 0xFFFF
    q1 := (dc1 >> 16) & 0xFFFF
    // Native set_tx_gain_table initializes the shared TX table base before
    // wr_bt_tx_gain_mem uses base+8. Cold SRAM/register state is not this
    // contract: this board previously read base224, uploading BT at232.
    // The working C firmware programs base110, hence BT entries118..125.
    volatile_store(0x3FF46000, (volatile_load(0x3FF46000) & 0xFC03FFFF) | 0x01B80000)
    start := ((volatile_load(0x3FF46000) >> 18) & 255) + 8
    if start != 118 { << false }
    $atten0 := 0
    $atten1 := 0
    for level in 0:8 {
        $atten := base + phy_cal_digital_offset(level)
        if atten < 0 { atten = 0 }
        if atten > 64 { atten = 64 }
        atten = atten + correction
        if atten < 0 || atten > 127 {
            volatile_store(0x3FFD7400, 23)
            << false
        }
        low := (i0 << 12) | (q0 << 3) | (i1 >> 6) | (iq << 21)
        high := (phy_cal_pa(level) << 10) | (q1 << 17) | (i1 << 26) |
            (bb >> 6) | ((bb & 63) << 3)
        phy_cal_write_gain(low, high, start + level)
        // Retain exactly the uploaded entries for review/debugging.
        volatile_store(0x3FFD75E0, low)
        volatile_store(0x3FFD75E4, high)
        rom_call6(0x4000C2C8, 0x3FFD7560 + level * 8, 0x3FFD75E0, 8, 0, 0, 0)
        if level < 4 { atten0 = atten0 | (((0 - atten) & 255) << (level * 8)) }
        else { atten1 = atten1 | (((0 - atten) & 255) << ((level - 4) * 8)) }
    }
    volatile_store(0x3FF4600C, atten0)
    volatile_store(0x3FF46010, atten1)
    volatile_store(0x3FFD75A0, atten0)
    volatile_store(0x3FFD75A4, atten1)
    volatile_store(0x3FFD75A8, bb)
    volatile_store(0x3FFD75AC, start)
    if volatile_load(0x3FF4600C) != atten0 || volatile_load(0x3FF46010) != atten1 ||
        (volatile_load(0x3FF45034) & 0x30000) != 0 || phy_cal_i2c_error() != 0 { << false }
    volatile_store(0x3FFD741C, volatile_load(0x3FFD741C) | 64)
    << true
}
