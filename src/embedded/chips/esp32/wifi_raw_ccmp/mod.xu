@embedded/chips/esp32/wifi_raw_ccmp

// Select the measured raw protected-frame path for Wi-Fi interface zero.
// The caller owns the MAC, DMA arena, software keys and replay counters. It
// must already have configured raw RX routing and the station ACK address.
// This does not initialize the radio, install keys, or connect WifiDevice.
//
// Native hal_crypto_init's 0x30000 is not a software-CCMP receive profile:
// with own-address matching enabled it suppresses the protected unicast path
// used by our raw receiver. Zero permits the complete encrypted MPDU to reach
// DMA, where the caller must verify CCMP MIC and PN before releasing plaintext.
// Preserve hardware RX status, frame bounds, and address validation as well.
pub fn prepare() bool {
    // Change the policy only while RX is stopped, with no native keys. Never
    // silently switch an active hardware-crypto connection to software mode.
    if (volatile_load(0x3FF000CC) & 0x406) != 0x406 ||
        (volatile_load(0x3FF73084) & 0x80000000) != 0 ||
        volatile_load(0x3FF73814) != 0 ||
        (volatile_load(0x3FF73064) & 0x1FFFF) != 0x1FFFF { << false }
    volatile_store(0x3FF73800,0)
    << volatile_load(0x3FF73800) == 0
}
