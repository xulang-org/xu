@embedded/chips/esp32

// ESP32 mask-ROM addresses from IDF components/esp_rom/esp32/ld/esp32.rom.ld.
// Calls use the windowed ROM ABI, not Xu's call0/function-value ABI.
pub const ROM_ETS_GET_CPU_FREQUENCY = 0x4000855C
pub const ROM_ETS_DELAY_US = 0x40008534
pub const ROM_MEMSET = 0x4000C44C
pub const ROM_MEMCPY = 0x4000C2C8
pub const ROM_BTDM_VERSION_GET = 0x40010078
pub const ROM_BTDM_DATA_INIT = 0x4001002C
pub const ROM_PHY_GET_ROMFUNCS = 0x40004100
pub const ROM_BTDM_BSS_START = 0x3FFB8000
pub const ROM_BTDM_BSS_BYTES = 32624

pub fn rom_cpu_mhz() int {
    << rom_call6(ROM_ETS_GET_CPU_FREQUENCY, 0, 0, 0, 0, 0, 0)
}

pub fn rom_delay_us(us int) {
    rom_call6(ROM_ETS_DELAY_US, us, 0, 0, 0, 0, 0)
}

pub fn rom_bt_version() int {
    << rom_call6(ROM_BTDM_VERSION_GET, 0, 0, 0, 0, 0, 0)
}

pub fn rom_phy_functions() int {
    << rom_call6(ROM_PHY_GET_ROMFUNCS, 0, 0, 0, 0, 0, 0)
}
