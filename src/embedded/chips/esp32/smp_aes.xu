@embedded/chips/esp32

// ESP32 AES accelerator, specialized to SMP's 128-bit little-endian octets.
// Sources: ESP-IDF esp32/rom/aes.h, hal/esp32/aes_ll.h, soc/hwcrypto_reg.h;
// The ROM's six swap=false arguments select conventional AES byte order
// (its implementation writes AES_ENDIAN=0x3F). Convert full 128-bit values
// at this boundary, as SMP uses the reverse octet sequence.
// The radio firmware runs on PRO CPU with APP CPU held in reset. All
// maskable PRO CPU interrupts stay disabled while the AES registers and
// the reserved 0x3FFD7F00..7F7F scratch area are owned by this call.

fn smp_aes_word(bytes &[]int, offset int) int {
    << bytes[15 - offset] | (bytes[14 - offset] << 8) |
        (bytes[13 - offset] << 16) | (bytes[12 - offset] << 24)
}

fn smp_aes_clear() {
    // Wipe all eight key words, including the unused AES-192/256 tail.
    volatile_store(0x3FF01010, 0)
    volatile_store(0x3FF01014, 0)
    volatile_store(0x3FF01018, 0)
    volatile_store(0x3FF0101C, 0)
    volatile_store(0x3FF01020, 0)
    volatile_store(0x3FF01024, 0)
    volatile_store(0x3FF01028, 0)
    volatile_store(0x3FF0102C, 0)
    volatile_store(0x3FF01030, 0)
    volatile_store(0x3FF01034, 0)
    volatile_store(0x3FF01038, 0)
    volatile_store(0x3FF0103C, 0)
    volatile_store(0x3FF01008, 0)
    volatile_store(0x3FF01040, 0)
    rom_call6(0x4000C44C, 0x3FFD7F00, 0, 128, 0, 0, 0) // ROM memset
    rom_call6(0x4005C8F8, 0, 0, 0, 0, 0, 0) // ets_aes_disable/reset
}

// Encrypt one BLE e(k, plaintext) block. Key, plaintext and result are
// exactly 16 octets, least-significant byte first. Empty result signals
// invalid input, hardware configuration failure or the bounded timeout.
// No software AES tables are linked and no key is cached between calls.
pub fn smp_aes128_le(key &[]int, block &[]int) []int {
    if key.len != 16 || block.len != 16 { << []int{} }
    for i in 0:16 {
        if key[i] < 0 || key[i] > 255 || block[i] < 0 || block[i] > 255 {
            << []int{}
        }
    }
    // Allocate the result before taking the hardware critical section.
    $out := []int{}
    for i in 0:16 { out.push(0) }
    saved := irq_rom_mask(0 - 1)
    rom_call6(0x4005C8CC, 0, 0, 0, 0, 0, 0) // ets_aes_enable
    rom_call6(0x4005C928, 0, 0, 0, 0, 0, 0) // no swaps: conventional AES bytes
    volatile_store(0x3FFD7F00, smp_aes_word(key, 0))
    volatile_store(0x3FFD7F04, smp_aes_word(key, 4))
    volatile_store(0x3FFD7F08, smp_aes_word(key, 8))
    volatile_store(0x3FFD7F0C, smp_aes_word(key, 12))
    // This board returns zero for KEY/ENDIAN configuration reads, even
    // after a successful nonzero ROM setkey. The official AES LL writes
    // key words without reading those ports back. Check ROM's success
    // result here and verify actual key replacement with cipher vectors.
    configured := rom_call6(0x4005C97C, 0x3FFD7F00, 0, 0, 0, 0, 0) != 0
    $complete := false
    if configured {
        volatile_store(0x3FF01030, smp_aes_word(block, 0))
        volatile_store(0x3FF01034, smp_aes_word(block, 4))
        volatile_store(0x3FF01038, smp_aes_word(block, 8))
        volatile_store(0x3FF0103C, smp_aes_word(block, 12))
        volatile_store(0x3FF01000, 1)
        // AES-128 normally takes 11 hardware clocks. A failed engine
        // cannot hold the LL interrupt critical section indefinitely.
        $polls := 0
        while !complete && polls < 1000 {
            complete = volatile_load(0x3FF01004) == 1
            if !complete { rom_delay_us(1) }
            polls += 1
        }
        if complete {
            r0 := volatile_load(0x3FF01030)
            r1 := volatile_load(0x3FF01034)
            r2 := volatile_load(0x3FF01038)
            r3 := volatile_load(0x3FF0103C)
            for i in 0:4 {
                out[15 - i] = (r0 >> (i * 8)) & 255
                out[11 - i] = (r1 >> (i * 8)) & 255
                out[7 - i] = (r2 >> (i * 8)) & 255
                out[3 - i] = (r3 >> (i * 8)) & 255
            }
        }
    }
    // This cleanup runs on every path that acquired the accelerator.
    smp_aes_clear()
    irq_rom_unmask(saved)
    if !complete { << []int{} }
    << out
}
