@embedded/chips/esp32

// Analog-bus prerequisites recovered from ESP32 libphy reg_init_begin(0)
// and i2cmst_reg_init. This does not run RF/PLL/IQ/TX-power calibration.
// The ROM PHY function table must be populated before using its I2C slots.
pub fn phy_prepare_analog_bus() bool {
    if volatile_load(0x3FFAE16C) != 0x400041FC { << false }
    if !phy_cal_cold_reset() { << false }
    volatile_store(0x3FFAE0C0, 0x3FFAE0C4)
    rom_call6(0x400041A4, 0x66, 4, 12, 0, 0, 0)
    ana := volatile_load(0x3FF48030)
    // Match native reg_init_begin's write, including bit29 which reads zero
    // on this silicon. Validate the persistent PLL/CKGEN/RX PBUS/TXRF bits.
    volatile_store(0x3FF48030, ana | 0xF8000000)
    clk := volatile_load(0x3FF66000)
    volatile_store(0x3FF66000, clk | 0x400)
    // Cold-start front end prerequisites (fe_reg_init).
    volatile_store(0x3FF460A0, volatile_load(0x3FF460A0) | 0x01000000)
    volatile_store(0x3FF45114, volatile_load(0x3FF45114) | 0x200)
    volatile_store(0x3FF450DC, volatile_load(0x3FF450DC) | 0xC0000000)
    volatile_store(0x3FF450D8, volatile_load(0x3FF450D8) | 0x02000000)
    volatile_store(0x3FF460B8, volatile_load(0x3FF460B8) | 0x20000000)
    volatile_store(0x3FF4609C, volatile_load(0x3FF4609C) | 0x4000)
    // Program the analog I2C masters' clock/mux fields in their observed
    // order, preserving the other bits at every write.
    $ctrl := volatile_load(0x3FF4E0C4)
    volatile_store(0x3FF4E0C4, (ctrl & 0xFFF0FFFF) | 0x00020000)
    ctrl = volatile_load(0x3FF4E0C4)
    volatile_store(0x3FF4E0C4, (ctrl & 0xFF0FFFFF) | 0x00400000)
    ctrl = volatile_load(0x3FF4E0C4)
    volatile_store(0x3FF4E0C4, ctrl | 0x01000000)
    ctrl = volatile_load(0x3FF4E0C4)
    volatile_store(0x3FF4E0C4, ctrl | 0x40000000)
    ctrl = volatile_load(0x3FF4E0C4)
    volatile_store(0x3FF4E0C4, ctrl & 0xDFFFFFFF)
    rom_delay_us(1000)
    << (volatile_load(0x3FF48030) & 0xD8000000) == 0xD8000000 &&
        (volatile_load(0x3FF4E0C4) & 0x61FF0000) == 0x41420000
}

// Cold-start probe only: select one analog slave before using the ROM's
// raw I2C primitives. libphy's ram_chip_i2c_readReg adds this selection;
// the ROM implementation itself does not. No controller/ISR may use the
// analog bus concurrently with this operation.
pub fn phy_select_analog_block(block int) bool {
    $mask := 0
    if block == 0x62 { mask = 0x800 }
    else if block == 0x63 { mask = 0x200 }
    else if block == 0x64 { mask = 0x100 }
    else if block == 0x65 { mask = 0x10000 }
    else if block == 0x66 { mask = 0x20000 }
    else if block == 0x67 { mask = 0x400 }
    else if block == 0x68 { mask = 0x8000 }
    else if block == 0x6A { mask = 0x2000 }
    else if block == 0x6B { mask = 0x1000 }
    else if block == 0x6D { mask = 0x4000 }
    else { << false }
    current := volatile_load(0x3FF4E044)
    volatile_store(0x3FF4E044, (current & 0xFFFC00FF) | 0x3F000)
    volatile_store(0x3FF4E044, volatile_load(0x3FF4E044) & (0 - 1 - mask))
    << (volatile_load(0x3FF4E044) & mask) == 0
}
