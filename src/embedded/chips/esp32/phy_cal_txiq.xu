@embedded/chips/esp32

// Actual SAR-based TX IQ calibration. Work 74A0..74CF holds the last
// measured tone power, attenuation, trims, per-gain IQ words and residuals.
// This stage does not initialize the final TX gain/power/attenuation RAM.
fn phy_cal_s8(value int) int {
    x := value & 255
    if x >= 128 { << x - 256 }
    << x
}

fn phy_cal_fm_ratio() int {
    volatile_store(0x3FF4E050, volatile_load(0x3FF4E050) & 0xFFFFFFFD)
    volatile_store(0x3FF4E050, volatile_load(0x3FF4E050) | 2)
    rom_delay_us(10)
    $ready := false
    $i := 0
    while i < 1000 && !ready {
        if (volatile_load(0x3FF4E050) & 0x07000000) == 0 {
            ready = true
        } else {
            rom_delay_us(1)
            i = i + 1
        }
    }
    if !ready {
        volatile_store(0x3FFD7400, 14)
        << 0
    }
    // ram_read_sar_dout: invert each physical twelve-bit ADC result.
    e2 := (volatile_load(0x3FF4E088) ^ 0xFFF) & 0xFFF
    e3 := (volatile_load(0x3FF4E08C) ^ 0xFFF) & 0xFFF
    e4 := (volatile_load(0x3FF4E090) ^ 0xFFF) & 0xFFF
    e5 := (volatile_load(0x3FF4E094) ^ 0xFFF) & 0xFFF
    e6 := (volatile_load(0x3FF4E098) ^ 0xFFF) & 0xFFF
    e7 := (volatile_load(0x3FF4E09C) ^ 0xFFF) & 0xFFF
    dc := e6 + e7
    $signal := e2 + e3 - dc
    $reference := e4 + e5 - dc
    if signal < 0 { signal = 0 }
    if reference < 0 { reference = 0 }
    volatile_store(0x3FFD7510, signal | (reference << 16))
    volatile_store(0x3FFD7514, (e3 + e4 + e5 + e6) >> 2)
    if reference < 1 { reference = 1 }
    << (signal << 10) / reference
}

// ROM txtone_linear_pwr(false), using the RAM revision's twelve-bit SAR
// reader and bounded acquisition instead of the older ROM SAR primitive.
pub fn phy_cal_tone_power() int {
    $power := 0
    for i in 0:4 { power = power + phy_cal_fm_ratio() }
    volatile_store(0x3FFD74A0, power)
    << power
}

fn phy_cal_iq_pair(gain_en int, atten int, frequency int) {
    control := ((frequency >> 2) & 0x0FFFFFFF) | 0x002C0000 | (gain_en << 26) |
        (((0 - atten) & 255) << 10) | (volatile_load(0x3FF460B8) & 0xF0000000)
    volatile_store(0x3FF460B8, control)
    volatile_store(0x3FF450A8, (volatile_load(0x3FF450A8) & 0xFFFFFFFC) | (frequency & 3))
    rom_delay_us(10)
    first := phy_cal_tone_power()
    volatile_store(0x3FF460B8, (volatile_load(0x3FF460B8) & 0xF0FFFFFF) |
        (((gain_en ^ 1) | (gain_en << 3)) << 24))
    rom_delay_us(10)
    second := phy_cal_tone_power()
    volatile_store(0x3FFD74C0, first)
    volatile_store(0x3FFD74C4, second)
    if first < 1 || second < 1 || first > 32767 || second > 32767 {
        volatile_store(0x3FFD7400, 17)
    }
}

fn phy_cal_txiq_cover(atten int) bool {
    $amp := 0
    $phase := 0
    $amp_sum := 0
    $phase_sum := 0
    $amp_error := 127
    $phase_error := 127
    $done := false
    $iteration := 0
    $gain_atten := atten - 12
    if gain_atten < 0 { gain_atten = 0 }
    while iteration < 7 && !done && phy_cal_i2c_error() == 0 {
        if iteration < 4 {
            amp = phy_cal_s8(rom_call6(0x40005154, amp, 1, 0, 0, 0, 0))
            phase = phy_cal_s8(rom_call6(0x40005154, phase, 0, 0, 0, 0, 0))
        }
        phy_cal_iq_pair(1, gain_atten, 32)
        first := volatile_load(0x3FFD74C0)
        second := volatile_load(0x3FFD74C4)
        $minimum := first
        if second < minimum { minimum = second }
        if minimum < 1 { minimum = 1 }
        amp_error = phy_cal_s8(((((second - first) * 2048) / minimum) + 16) >> 5)
        phy_cal_iq_pair(0, atten, 32)
        p1 := volatile_load(0x3FFD74C0)
        p2 := volatile_load(0x3FFD74C4)
        $sum := p1 + p2
        if sum < 1 { sum = 1 }
        phase_error = phy_cal_s8(((((p1 - p2) * 4096) / sum) + 16) >> 5)
        if iteration < 3 {
            amp = phy_cal_s8(amp - amp_error)
            phase = phy_cal_s8(phase - phase_error)
        } else {
            amp_sum = phy_cal_s8(amp_sum + amp_error)
            phase_sum = phy_cal_s8(phase_sum + phase_error)
            if amp_error > -2 && amp_error < 2 && phase_error > -2 && phase_error < 2 {
                done = true
            } else if iteration == 6 {
                amp = phy_cal_s8(amp - ((phy_cal_s8(amp_sum + 2)) >> 2))
                phase = phy_cal_s8(phase - ((phy_cal_s8(phase_sum + 2)) >> 2))
                done = true
            }
        }
        iteration = iteration + 1
    }
    if amp < -15 { amp = -15 }
    if amp > 15 { amp = 15 }
    if phase < -31 { phase = -31 }
    if phase > 31 { phase = 31 }
    rom_call6(0x40005154, amp, 1, 0, 0, 0, 0)
    rom_call6(0x40005154, phase, 0, 0, 0, 0, 0)
    volatile_store(0x3FFD74A8, amp)
    volatile_store(0x3FFD74AC, phase)
    volatile_store(0x3FFD74C8, amp_error)
    volatile_store(0x3FFD74CC, phase_error)
    if !done || phy_cal_i2c_error() != 0 || amp_error < -8 || amp_error > 8 ||
        phase_error < -8 || phase_error > 8 {
        if phy_cal_i2c_error() == 0 { volatile_store(0x3FFD7400, 15) }
        << false
    }
    << true
}

// Apply the calibrated center-frequency tuple and settle at 2442 MHz,
// corresponding to the native calibration's Wi-Fi channel 7.
fn phy_cal_txiq_frequency() bool {
    volatile_store(0x3FF4E0C4, (volatile_load(0x3FF4E0C4) & 0xFFFFFF00) | (42 * 3))
    caps := volatile_load(0x3FF4E0C0)
    phy_cal_write(0x62, 1, 1, caps & 255)
    fraction := (2442 * 262144) / 120 - 2097152
    packed := ((fraction >> 16) & 255) | (fraction & 0xFF00) | ((fraction & 255) << 16)
    volatile_store(0x3FFD7428, packed)
    rom_call6(0x40004740, 0x3FFD7428, 0, 0, 0, 0, 0)
    phy_cal_pll_restart()
    << phy_cal_pll_wait()
}

fn phy_cal_txiq_gain(gain int) bool {
    if gain < 0 || gain > 3 { << false }
    tone_old := volatile_load(0x3FF460B8)
    volatile_store(0x3FF450DC, (volatile_load(0x3FF450DC) | 0x800) & 0xFFFFEFFF)
    rom_call6(0x40004458, 0, 0, 0, 0, 0, 0)
    phy_cal_pbus_force(0, 1, 1)
    phy_cal_pbus_force(1, 1, 0x7C)
    phy_cal_pbus_force(1, 2, 0x120)
    phy_cal_pbus_force(4, 1, 0x7F)
    phy_cal_pbus_force(5, 1, 0x5F)
    rom_call6(0x40003564, 1, 0, 0, 0, 0, 0) // TX clock
    if !phy_cal_power_detector_init() {
        volatile_store(0x3FFD7400, 18)
        rom_call6(0x4000510C, 0, 0, 0, 0, 0, 0)
        volatile_store(0x3FF460B8, tone_old)
        volatile_store(0x3FF450DC, volatile_load(0x3FF450DC) | 0x1000)
        << false
    }
    $bb := 0
    if gain == 1 { bb = 0x20 }
    else if gain == 2 { bb = 0x30 }
    else if gain == 3 { bb = 0xA0 }
    phy_cal_pbus_force(1, 2, bb)
    active := rom_call6(0x40004414, 1, 1, 0, 0, 0, 0)
    phy_cal_pbus_force(1, 1, active | 2)
    rom_call6(0x40004638, 0x3FFD7480 + gain * 8, 0, 0, 0, 0, 0)
    // Replace the native four-trial search's Wi-Fi power-cal dependent
    // starting estimate with a bounded measured search over the full range.
    $atten := 42
    $level := false
    $trial := 0
    while trial < 32 && !level && phy_cal_i2c_error() == 0 {
        rom_call6(0x400035D0, 1, 32, atten, 0, 0, 0)
        rom_delay_us(2)
        power := phy_cal_tone_power()
        if power >= 600 && power <= 1000 {
            level = true
        } else if power > 1000 { atten = atten + 4 }
        else { atten = atten - 4 }
        if atten < 0 { atten = 0 }
        if atten > 120 { atten = 120 }
        trial = trial + 1
    }
    volatile_store(0x3FFD74A4, atten)
    $ok := level
    if level { ok = phy_cal_txiq_cover(atten) }
    else if phy_cal_i2c_error() == 0 { volatile_store(0x3FFD7400, 16) }
    rom_call6(0x4000510C, 0, 0, 0, 0, 0, 0) // stop tone / restore PBUS work mode
    volatile_store(0x3FF460B8, tone_old)
    volatile_store(0x3FF450DC, volatile_load(0x3FF450DC) | 0x1000)
    if !ok || phy_cal_i2c_error() != 0 { << false }
    encoded := ((volatile_load(0x3FFD74A8) & 31) << 6) | (volatile_load(0x3FFD74AC) & 63)
    if gain == 0 { volatile_store(0x3FFD74B0, encoded) }
    else if gain == 1 { volatile_store(0x3FFD74B4, encoded) }
    else if gain == 2 { volatile_store(0x3FFD74B8, encoded) }
    else { volatile_store(0x3FFD74BC, encoded) }
    << true
}

pub fn phy_cal_txiq_bt() bool {
    if (volatile_load(0x3FFD741C) & 7) != 7 || phy_cal_i2c_error() != 0 { << false }
    if !phy_cal_hw_frequency_disable() || !phy_cal_txiq_frequency() { << false }
    for gain in 0:3 {
        if !phy_cal_txiq_gain(gain) { << false }
    }
    volatile_store(0x3FFD741C, volatile_load(0x3FFD741C) | 8)
    << true
}
