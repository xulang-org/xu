@embedded/chips/esp32

// Install the vendor ESP-IDF PHY function table into the ESP32 mask ROM.
//
// The ROM baseband does not own the RF. It reaches PHY code only through the
// ROM DRAM function-pointer table P that `phy_get_romfuncs` (0x40004100)
// returns, 0x3FFAE0C4 (ROM symbol g_phyFuns_instance).
//
// Native ESP-IDF overrides 44 of those slots with the libphy/librtc
// implementations from `phy_get_romfunc_addr`; the remaining slots keep the
// ROM's own 2016 defaults. Without the override the ROM transmits with its
// legacy PHY, which never reaches the air.
//
// The vendor implementations are linked into this image as a pre-built blob
// (examples/esp32/tools/build_vendor_phy_blob.sh). This module calls the
// vendor installer and verifies that the table really changed.
//
// Measured on the board before the override (2026-11-02):
//   P[0]  = 0x40002F6C  rom_phy_disable_agc      (ROM default)
//   P[12] = 0x400031A4  rom_set_pbus_mem         (ROM default)
//   P[15] = 0x40003564  rom_set_txclk_en         (ROM default)
//   P[54] = 0x400045E0  rom_pbus_xpd_tx_on        (ROM default)
// After the override these hold the libphy/librtc entries.

// Blob symbol addresses. Regenerated by build_vendor_phy_blob.sh; keep in
// sync with examples/esp32/tools/vendor_phy_blob_map.txt.
// Blob segments: DRAM 0x3FFD9000, IRAM 0x4008C000, IROM 0x40150000.
pub const VENDOR_PHY_GET_ROMFUNC_ADDR = 0x40153E4C
pub const VENDOR_BT_BB_INIT_CMPLX = 0x4008E294

// ROM DRAM base of the PHY function table.
pub const PHY_ROM_TABLE = 0x3FFAE0C4

// ROM default of slot 0 (rom_phy_disable_agc). Used as the "not overridden"
// witness: the vendor installer replaces it with ram_disable_agc.
pub const PHY_ROM_DEFAULT_SLOT0 = 0x40002F6C

// ROM import table (r_import_rf_phy_func). Slot 1 is the baseband init hook.
pub const PHY_ROM_IMPORT = 0x3FFB8354

pub fn phy_rom_table_base() int {
    << rom_phy_functions()
}

// Call the vendor installer and check that the ROM table now holds the
// vendor PHY entries instead of the ROM defaults.
//
// Call this after the PHY calibration chain and before the controller is
// started: the calibration wants the Xu analog I2C replacements, the radio
// wants the vendor PHY entries.
pub fn phy_rom_vendor_install() bool {
    if rom_phy_functions() != PHY_ROM_TABLE { << false }
    rom_call6(VENDOR_PHY_GET_ROMFUNC_ADDR, 0, 0, 0, 0, 0, 0)
    slot0 := volatile_load(0x3FFAE0C4)
    if slot0 == PHY_ROM_DEFAULT_SLOT0 { << false }
    // The vendor entries live in the blob's code range, never in the ROM.
    if slot0 < 0x40080000 || slot0 >= 0x40400000 { << false }
    << true
}

// Install the vendor baseband init into the ROM import table, so the ROM RF
// init calls the official bt_bb_init_cmplx sequence.
pub fn phy_rom_vendor_bb_install() bool {
    volatile_store(0x3FFB8358, VENDOR_BT_BB_INIT_CMPLX)
    << volatile_load(0x3FFB8358) == VENDOR_BT_BB_INIT_CMPLX
}

// Read one PHY table slot at runtime.
pub fn phy_rom_slot(index int) int {
    rom_call6(0x4000C2C8, 0x3FFD7F20, PHY_ROM_TABLE + index * 4, 4, 0, 0, 0)
    << volatile_load(0x3FFD7F20)
}
