@embedded/chips/esp32

// Cold-start RF analog defaults and per-MHz PLL capacitor calibration.
// This is one stage of the PHY port: RX DC/IQ, TX DC/IQ/power and the
// hardware channel-programmer command descriptors are separate stages.
// Layout 0x3FFD7400..743F: transport error, count, frequency, capacitor
// pair, RC sample, RC cap, PLL-valid marker, flags, DCO[4], x_reg[3].
fn phy_cal_write(block int, host int, reg int, value int) {
    rom_call6(0x400041A4, block, host, reg, value, 0, 0)
}

pub fn phy_cal_analog_defaults() bool {
    bb10 := rom_call6(0x40004148, 0x66, 4, 10, 0, 0, 0)
    bb11 := rom_call6(0x40004148, 0x66, 4, 11, 0, 0, 0)
    bb9 := rom_call6(0x40004148, 0x66, 4, 9, 0, 0, 0)
    // phy_i2c_init's independent writes, serialized through the Xu bridge.
    phy_cal_write(0x63, 0, 1, 0xF3)
    phy_cal_write(0x6B, 2, 3, 0xA8)
    phy_cal_write(0x62, 1, 3, 0x77)
    phy_cal_write(0x62, 1, 8, 0)
    phy_cal_write(0x6B, 2, 4, 7)
    phy_cal_write(0x66, 4, 10, (bb10 & 0xCF) | 0x10)
    phy_cal_write(0x62, 1, 10, 0xB0)
    phy_cal_write(0x6B, 2, 5, 8)
    phy_cal_write(0x66, 4, 11, bb11 & 0xFE)
    phy_cal_write(0x62, 1, 9, 7)
    phy_cal_write(0x6B, 2, 6, 0xB8)
    phy_cal_write(0x62, 1, 0, 0x3F)
    phy_cal_write(0x6B, 2, 7, 0x5D)
    phy_cal_write(0x62, 1, 4, 0xBF)
    phy_cal_write(0x6B, 2, 10, 0x74)
    phy_cal_write(0x67, 1, 9, 0x71)
    phy_cal_write(0x68, 3, 0, 0x63)
    phy_cal_write(0x6A, 2, 2, 0x68)
    phy_cal_write(0x66, 4, 8, 0x21)
    phy_cal_write(0x67, 1, 11, 0x61)
    phy_cal_write(0x68, 3, 1, 0x80)
    phy_cal_write(0x6A, 2, 0, 0x26)
    phy_cal_write(0x66, 4, 9, (bb9 & 0xF0) | 4)
    // i2c_bt_filter_set.
    phy_cal_write(0x67, 1, 11, 0x61)
    phy_cal_write(0x67, 1, 12, 0x10)
    phy_cal_write(0x67, 1, 15, 0xEA)
    phy_cal_write(0x67, 1, 6, 0x7F)
    phy_cal_write(0x67, 1, 5, 0x7F)
    phy_cal_write(0x67, 1, 8, 0x7F)
    phy_cal_write(0x67, 1, 7, 0x7F)
    << phy_cal_i2c_error() == 0
}

pub fn phy_cal_rf_bus_init() bool {
    if !phy_cal_hw_frequency_disable() || !phy_cal_analog_defaults() { << false }
    rom_call6(0x40004458, 0, 0, 0, 0, 0, 0) // pbus_debugmode
    volatile_store(0x3FFD7420, 0x01000100)
    volatile_store(0x3FFD7424, 0x01000100)
    rom_call6(0x40004638, 0x3FFD7420, 0, 0, 0, 0, 0) // pbus_set_dco
    rom_call6(0x40004590, 0, 0, 0, 0, 0, 0) // pbus_xpd_tx_off
    rom_call6(0x40004508, 0, 0, 0, 0, 0, 0) // pbus_xpd_rx_off
    rom_call6(0x4000446C, 0, 0, 0, 0, 0, 0) // pbus_workmode
    << phy_cal_i2c_error() == 0
}

fn phy_cal_pll_restart() {
    // ram_restart_cal, including both edges of calibration bit 5.
    rom_call6(0x400041FC, 0x62, 1, 0, 6, 6, 1)
    rom_call6(0x400041FC, 0x62, 1, 0, 5, 5, 0)
    rom_call6(0x400041FC, 0x62, 1, 0, 5, 5, 1)
    rom_call6(0x400041FC, 0x62, 1, 0, 6, 6, 0)
}

fn phy_cal_pll_wait() bool {
    for i in 0:100 {
        rom_delay_us(20)
        if rom_call6(0x400041C0, 0x62, 1, 7, 7, 7, 0) != 0 {
            << phy_cal_i2c_error() == 0
        }
    }
    volatile_store(0x3FFD7400, 5)
    << false
}

fn phy_cal_rx_analog_caps(cap int) int {
    // chip_v7_rxmax_ext_ana(0), signed C division truncates toward zero.
    $lna := (cap * 24 - 340) / 227
    if lna < 0 { lna = 0 }
    if lna > 15 { lna = 15 }
    $vga := (cap * 23 + 29) / 207
    if vga > 15 { vga = 15 }
    phy_cal_write(0x64, 0, 4, lna | 0x40)
    phy_cal_write(0x64, 0, 7, vga | 0x40)
    << ((vga | 0x40) << 8) | lna | 0x40
}

fn phy_cal_frequency_word(address int, word int) bool {
    volatile_store(0x3FF4E0C4, (volatile_load(0x3FF4E0C4) & 0xFFFFFF00) | address)
    volatile_store(0x3FF4E148, word)
    volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) | 0x200)
    volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) & 0xFFFFFDFF)
    << volatile_load(0x3FF4E0C0) == word
}

// ESP32 / 40 MHz XTAL only. Calibrate all 85 frequencies 2400..2484 MHz
// used by the ROM PHY's Wi-Fi/BT shared lookup memory. Hardware PLL done
// is checked at every frequency, with a maximum 2 ms wait per sample.
// Calling this does not mark the complete PHY or channel programmer ready.
pub fn phy_cal_pll_40mhz() bool {
    volatile_store(0x3FFD7404, 0)
    volatile_store(0x3FFD7418, 0)
    volatile_store(0x3FFD74DC, 0)
    volatile_store(0x3FFD75C4, 0)
    if !phy_cal_hw_frequency_disable() { << false }
    rom_call6(0x400041FC, 0x62, 1, 0, 7, 7, 0)
    rom_call6(0x400041FC, 0x62, 1, 2, 7, 7, 0)
    $seed := 0x6E
    for channel in 0:85 {
        freq := 2400 + channel
        volatile_store(0x3FFD7408, freq)
        phy_cal_write(0x62, 1, 1, seed)
        // ram_rfpll_set_freq at offset=0, crystal_select=0 (40 MHz).
        // Compute its 8.16 SDM ratio in integer arithmetic; the largest
        // numerator is 651,165,696 and fits a 32-bit int.
        fraction := (freq * 262144) / 120 - 2097152
        packed := ((fraction >> 16) & 255) | (fraction & 0xFF00) | ((fraction & 255) << 16)
        volatile_store(0x3FFD7428, packed)
        rom_call6(0x40004740, 0x3FFD7428, 0, 0, 0, 0, 0) // write_rfpll_sdm
        phy_cal_pll_restart()
        if !phy_cal_pll_wait() { << false }
        cap := rom_call6(0x400041C0, 0x62, 1, 5, 7, 0, 0)
        if cap == 0 || cap == 255 {
            volatile_store(0x3FFD7400, 6)
            << false
        }
        gain := phy_cal_rx_analog_caps(cap)
        pll2 := rom_call6(0x40004148, 0x62, 1, 2, 0, 0, 0)
        pll6 := rom_call6(0x400041C0, 0x62, 1, 6, 3, 0, 0)
        caps := cap | (((pll2 & 0xF0) | pll6 | 0x80) << 8)
        if !phy_cal_frequency_word(channel * 3, caps) ||
            !phy_cal_frequency_word(channel * 3 + 1, fraction) ||
            !phy_cal_frequency_word(channel * 3 + 2, gain) {
            volatile_store(0x3FFD7400, 7)
            << false
        }
        if phy_cal_i2c_error() != 0 { << false }
        volatile_store(0x3FFD740C, caps)
        volatile_store(0x3FFD7404, channel + 1)
        seed = cap
    }
    volatile_store(0x3FFD7418, 0x504C4C31) // PLL1: capacitor sweep only
    << true
}
