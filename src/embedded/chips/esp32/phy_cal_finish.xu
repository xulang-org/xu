@embedded/chips/esp32

// Native force_txrxoff(0) followed by the register_chipv7_phy tail.
// Caller must finish static BB initialization first. This releases the
// calibrated TX/PLL path to the MAC; it does not certify RX DC/IQ or start
// advertising, and does not commit the separate IRQ tracking ready marker.
pub fn phy_cal_tx_release() bool {
    if (volatile_load(0x3FFD741C) & 255) != 255 ||
        volatile_load(0x3FFD7418) != 0x504C4C31 || phy_cal_i2c_error() != 0 ||
        volatile_load(0x3FFD74DC) != 0x434F4D31 ||
        volatile_load(0x3FFD75C4) != 0x53485231 ||
        volatile_load(0x3FFD75C0) != 110 ||
        volatile_load(0x3FFD7404) != 85 || volatile_load(0x3FFD7408) != 2484 ||
        ((volatile_load(0x3FF4E0C4) >> 10) & 31) != 11 ||
        volatile_load(0x3FF46040) != 0x1D1C1B17 ||
        (((volatile_load(0x3FF46000) >> 18) & 255) + 8) != volatile_load(0x3FFD75AC) ||
        volatile_load(0x3FF4600C) != volatile_load(0x3FFD75A0) ||
        volatile_load(0x3FF46010) != volatile_load(0x3FFD75A4) { << false }
    volatile_store(0x3FF460A0, volatile_load(0x3FF460A0) & 0xFFFFF3FF)
    volatile_store(0x3FF460A0, volatile_load(0x3FF460A0) & 0xFFFFFCFF)
    volatile_store(0x3FF460A0, volatile_load(0x3FF460A0) & 0xFFFFCFFF)
    phy_cal_hw_frequency_enable()
    // enable_wifi_agc: this is the shared PHY AGC path even in BLE-only
    // IDF bring-up; no Wi-Fi MAC or Wi-Fi mode is enabled by these writes.
    volatile_store(0x3FF5C080, volatile_load(0x3FF5C080) & 0xFFFFFFFE)
    volatile_store(0x3FF5C030, (volatile_load(0x3FF5C030) & 0xFFFFFFCF) | 0x10)
    volatile_store(0x3FF5C01C, (volatile_load(0x3FF5C01C) & 0xFF00FFFF) | 0xC0000)
    volatile_store(0x3FF5C038, volatile_load(0x3FF5C038) | 0x04000000)
    << phy_cal_bt_priority() &&
        (volatile_load(0x3FF460A0) & 0x3F00) == 0 &&
        (volatile_load(0x3FF46094) & 1) == 0 &&
        (volatile_load(0x3FF4609C) & 0x08000000) == 0 &&
        (volatile_load(0x3FF4E0C4) & 0x02000000) == 0
}
