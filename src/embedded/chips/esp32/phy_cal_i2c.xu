@embedded/chips/esp32

// Analog I2C fixup for the mask-ROM PHY table. Work word 0x3FFD7400 is
// reserved by the radio bring-up layout; zero means no transport error.
// The full calibration controller must check this word after ROM calls.
// No vendor RAM code is copied or linked into the image.
fn phy_cal_i2c_master(host int) int {
    if host == 0 { << volatile_load(0x3FF4E000) }
    if host == 1 { << volatile_load(0x3FF4E004) }
    if host == 2 { << volatile_load(0x3FF4E008) }
    if host == 3 { << volatile_load(0x3FF4E00C) }
    if host == 4 { << volatile_load(0x3FF4E010) }
    << -1
}

fn phy_cal_i2c_command(host int, command int) {
    if host == 0 { volatile_store(0x3FF4E000, command) }
    else if host == 1 { volatile_store(0x3FF4E004, command) }
    else if host == 2 { volatile_store(0x3FF4E008, command) }
    else if host == 3 { volatile_store(0x3FF4E00C, command) }
    else if host == 4 { volatile_store(0x3FF4E010, command) }
}

fn phy_cal_i2c_wait(host int) bool {
    // One millisecond maximum, rather than the ROM's unbounded busy poll.
    for i in 0:1000 {
        if (phy_cal_i2c_master(host) & 0x02000000) == 0 { << true }
        rom_delay_us(1)
    }
    volatile_store(0x3FFD7400, 1)
    << false
}

fn phy_cal_i2c_read(block int, host int, reg int) int {
    if host < 0 || host > 4 || reg < 0 || reg > 255 {
        volatile_store(0x3FFD7400, 2)
        << 255
    }
    old_mask := rom_call6(0x4000BFAC, -1, 0, 0, 0, 0, 0)
    paused := host < 2 && (volatile_load(0x3FF4E0C4) & 0x02000000) == 0
    $ready := true
    if paused { ready = phy_cal_hw_frequency_disable() }
    $value := 255
    if !ready {
        value = 255
    } else if !phy_select_analog_block(block) {
        volatile_store(0x3FFD7400, 3)
    } else if phy_cal_i2c_wait(host) {
        phy_cal_i2c_command(host, block | (reg << 8))
        if phy_cal_i2c_wait(host) {
            value = (phy_cal_i2c_master(host) >> 16) & 255
        }
    }
    if paused && ready { phy_cal_hw_frequency_enable() }
    rom_call6(0x4000BF88, old_mask, 0, 0, 0, 0, 0)
    << value
}

fn phy_cal_i2c_write(block int, host int, reg int, value int) int {
    if host < 0 || host > 4 || reg < 0 || reg > 255 || value < 0 || value > 255 {
        volatile_store(0x3FFD7400, 2)
        << 1
    }
    old_mask := rom_call6(0x4000BFAC, -1, 0, 0, 0, 0, 0)
    paused := host < 2 && (volatile_load(0x3FF4E0C4) & 0x02000000) == 0
    $ready := true
    if paused { ready = phy_cal_hw_frequency_disable() }
    $status := 1
    if !ready {
        status = 1
    } else if !phy_select_analog_block(block) {
        volatile_store(0x3FFD7400, 3)
    } else if phy_cal_i2c_wait(host) {
        phy_cal_i2c_command(host, block | (reg << 8) | (value << 16) | 0x01000000)
        if phy_cal_i2c_wait(host) { status = 0 }
    }
    if paused && ready { phy_cal_hw_frequency_enable() }
    rom_call6(0x4000BF88, old_mask, 0, 0, 0, 0, 0)
    << status
}

// Install after bt_power_domain_on, bt_rf_clock_enable and
// phy_prepare_analog_bus. All ROM PHY functions then use the Xu slave
// selection and bounded polling through their existing raw I2C slots.
pub fn phy_cal_install_i2c() bool {
    read_entry := volatile_load(0x3FFAE158)
    write_entry := volatile_load(0x3FFAE160)
    replacement_read := rom_callback(phy_cal_i2c_read)
    replacement_write := rom_callback(phy_cal_i2c_write)
    if (read_entry != 0x40004110 && read_entry != replacement_read) ||
        (write_entry != 0x40004168 && write_entry != replacement_write) { << false }
    volatile_store(0x3FFD7400, 0)
    volatile_store(0x3FFAE158, replacement_read)
    volatile_store(0x3FFAE160, replacement_write)
    << volatile_load(0x3FFAE158) == replacement_read &&
        volatile_load(0x3FFAE160) == replacement_write
}

pub fn phy_cal_i2c_error() int {
    << volatile_load(0x3FFD7400)
}

pub fn phy_cal_restore_i2c() {
    volatile_store(0x3FFAE158, 0x40004110)
    volatile_store(0x3FFAE160, 0x40004168)
}
