@embedded/chips/esp32

// BLE on this ESP32 profile consumes the common TX bank (base110), even
// though the separate BT bank at base+8 is also initialized. A same-boot
// address-step probe established that distinction. Native set_tx_gain_table
// writes one common gain row eight times; it does not copy the BT rows.
// Scratch: 7498/749C are the measured common DC pair after PA-cap calibration;
// 74BC is common IQ, 74DC its commit, 75B8..75C4 retain upload metadata.
pub fn phy_cal_shared_tx_calibrate() bool {
    volatile_store(0x3FFD74DC, 0)
    if (volatile_load(0x3FFD741C) & 63) != 63 || phy_cal_i2c_error() != 0 ||
        !phy_cal_hw_frequency_disable() || !phy_cal_txiq_frequency() { << false }
    // A0 is native ram_txbbgain_to_index's supported common gain index2.
    // Measure its DC rather than using the BT gain20 DC or saved C values.
    if !phy_cal_power_tx_start(0xA0, 0x3FFD7488) { << false }
    ok := phy_cal_dc_trim()
    if ok {
        volatile_store(0x3FFD7498, volatile_load(0x3FFD7450))
        volatile_store(0x3FFD749C, volatile_load(0x3FFD7454))
    }
    rom_call6(0x4000510C, 0, 0, 0, 0, 0, 0)
    if !ok || phy_cal_i2c_error() != 0 || !phy_cal_txiq_gain(3) { << false }
    volatile_store(0x3FFD74DC, 0x434F4D31)
    << true
}

pub fn phy_cal_shared_gain_memory() bool {
    if volatile_load(0x3FFD74DC) != 0x434F4D31 || phy_cal_i2c_error() != 0 { << false }
    dc0 := volatile_load(0x3FFD7498)
    dc1 := volatile_load(0x3FFD749C)
    iq := volatile_load(0x3FFD74BC)
    i0 := dc0 & 0xFFFF
    q0 := (dc0 >> 16) & 0xFFFF
    i1 := dc1 & 0xFFFF
    q1 := (dc1 >> 16) & 0xFFFF
    if i0 > 511 || q0 > 511 || i1 > 511 || q1 > 511 || iq > 0x7FF { << false }
    // Match native shared-row packing. PA3F is the common calibration PA,
    // A0 is calibrated above; IQ/DC always come from this boot's measurements.
    low := (i0 << 12) | (q0 << 3) | (i1 >> 6) | (iq << 21)
    high := (0x3F << 10) | (q1 << 17) | (i1 << 26) | (0xA0 >> 6) | ((0xA0 & 63) << 3)
    volatile_store(0x3FF46000, (volatile_load(0x3FF46000) & 0xFC03FFFF) | 0x01B80000)
    start := (volatile_load(0x3FF46000) >> 18) & 255
    if start != 110 { << false }
    for j in 0:8 { phy_cal_write_gain(low, high, start + j) }
    volatile_store(0x3FFD75B8, low)
    volatile_store(0x3FFD75BC, high)
    volatile_store(0x3FFD75C0, start)
    volatile_store(0x3FFD75C4, 0x53485231)
    << (volatile_load(0x3FF45034) & 0x30000) == 0 && phy_cal_i2c_error() == 0
}
