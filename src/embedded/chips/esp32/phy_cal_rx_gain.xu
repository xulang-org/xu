@embedded/chips/esp32

// Pure arithmetic specialization of ram_gen_rx_gain_table for the native
// BT sweep (8 RF gains, LPF maximum 28, final baseband gain 6). Index 72 is
// deliberately included: the native generator emits before testing >28.
pub fn phy_cal_rx_bt_rf_gain(index int) int {
    if index == 0 { << 0 }
    if index == 1 { << 4 }
    if index == 2 { << 0x30 }
    if index == 3 { << 0x34 }
    if index == 4 { << 0x38 }
    if index == 5 { << 0x40 }
    if index == 6 { << 0x44 }
    if index == 7 { << 0x50 }
    << -1
}

fn phy_cal_rx_bt_step(index int) int {
    if index == 0 || index == 3 { << 5 }
    if index == 1 { << 9 }
    if index == 2 || index == 5 { << 6 }
    if index == 4 { << 3 }
    if index == 6 { << 15 }
    << 0
}

fn phy_cal_rx_bb_coarse(index int) int {
    if index == 0 { << 0 }
    if index == 1 { << 1 }
    if index == 2 { << 5 }
    if index == 3 { << 13 }
    if index == 4 { << 29 }
    << -1
}

pub fn phy_cal_rx_bt_gain_at(index int) int {
    if index < 0 || index > 72 { << -1 }
    $rf := 0
    $bb := 0
    for n in 0:index + 1 {
        if bb == phy_cal_rx_bt_step(rf) && rf < 7 {
            rf += 1
            bb = 0
            if rf == 7 { bb = 6 }
        }
        if n == index {
            << (phy_cal_rx_bt_rf_gain(rf) << 8) +
                phy_cal_rx_bb_coarse(bb / 6) * 8 + bb % 6
        }
        bb += 1
    }
    << -1
}
