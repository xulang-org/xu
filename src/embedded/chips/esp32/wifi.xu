@embedded/chips/esp32

// Wi-Fi configuration API. A real RX/TX/IP backend is not installed yet.
// Unsupported operations return failure and never fabricate APs, leases,
// link state, MAC addresses, or signal measurements. No RF MMIO is touched.

// Wi-Fi Operating Modes
pub const WIFI_MODE_NULL   = 0
pub const WIFI_MODE_STA    = 1 // Station mode (connect to AP)
pub const WIFI_MODE_AP     = 2 // Access Point mode (host hotspot)
pub const WIFI_MODE_APSTA  = 3 // Dual AP + Station mode

// Wi-Fi Authentication Modes
pub const WIFI_AUTH_UNKNOWN      = -1
pub const WIFI_AUTH_OPEN         = 0
pub const WIFI_AUTH_WEP          = 1
pub const WIFI_AUTH_WPA_PSK      = 2
pub const WIFI_AUTH_WPA2_PSK     = 3
pub const WIFI_AUTH_WPA_WPA2_PSK = 4
pub const WIFI_AUTH_WPA3_PSK     = 5

// Wi-Fi Connection States
pub const WIFI_STATUS_IDLE         = 0
pub const WIFI_STATUS_SCANNING     = 1
pub const WIFI_STATUS_CONNECTING   = 2
pub const WIFI_STATUS_CONNECTED    = 3
pub const WIFI_STATUS_DISCONNECTED = 4
pub const WIFI_STATUS_AP_ACTIVE    = 5
pub const WIFI_STATUS_ERROR        = 6

// Wi-Fi Hardware Baseband & DPORT Power Domain Registers
pub const DPORT_WIFI_CLK_EN_REG     = 0x3FF000CC
pub const DPORT_CORE_RST_EN_REG     = 0x3FF000D0
pub const DPORT_WIFI_RST_EN_REG     = 0x3FF000D0 // shared CORE reset register; D4 is BT clock divider
pub const DPORT_WIFI_CLK_WIFI_EN    = 0x00000406

// No DHCP client/server has provided a lease yet. Preserve API compatibility.
pub fn dhcp_lease_ip(subnet int, slot int) string { << "" }

pub fn dhcp_gateway(subnet int) string { << "" }

pub struct WifiApConfig {
    pub ssid string
    pub password string
    pub channel int
    pub authmode int
    pub max_connections int
    pub hidden bool
}

pub struct WifiStaConfig {
    pub ssid string
    pub password string
    pub channel int
    pub authmode int
}

pub struct WifiScanResult {
    pub ssid string
    pub rssi int
    pub channel int
    pub authmode int
    pub bssid string
}

pub struct WifiDevice {
    pub mode int
    pub status int
    pub ssid string
    pub password string
    pub ip string
    pub gateway string
    pub netmask string
    pub dns string
    pub mac string
    pub channel int
    pub rssi int
    pub ap_active bool
    pub sta_connected bool
    pub dhcp_enabled bool
    pub static_ip string
    pub static_gateway string
    pub static_netmask string
    pub static_dns string
    pub ap_client_pool_next int
}

pub fn wifi_create() WifiDevice {
    << WifiDevice{
        mode: WIFI_MODE_NULL,
        status: WIFI_STATUS_IDLE,
        ssid: "",
        password: "",
        ip: "0.0.0.0",
        gateway: "0.0.0.0",
        netmask: "255.255.255.0",
        dns: "0.0.0.0",
        mac: "", // unknown until read from hardware
        channel: 1,
        rssi: 0,
        ap_active: false,
        sta_connected: false,
        dhcp_enabled: true,
        static_ip: "",
        static_gateway: "",
        static_netmask: "",
        static_dns: "",
        ap_client_pool_next: 2
    }
}

fn wifi_unavailable(dev $&WifiDevice) {
    dev.status = WIFI_STATUS_ERROR
    dev.sta_connected = false
    dev.ap_active = false
    dev.ip = "0.0.0.0"
    dev.gateway = "0.0.0.0"
    dev.dns = "0.0.0.0"
    dev.rssi = 0
}

pub fn (dev $&WifiDevice) init() bool {
    dev.mode = WIFI_MODE_NULL
    wifi_unavailable(dev)
    << false
}

pub fn (dev $&WifiDevice) set_mode(mode int) {
    dev.mode = mode
}

// Configure static IP (disables automatic DHCP)
pub fn (dev $&WifiDevice) config_static_ip(ip string, gateway string, netmask string, dns string) {
    dev.dhcp_enabled = false
    dev.static_ip = ip
    dev.static_gateway = gateway
    dev.static_netmask = netmask
    dev.static_dns = dns
}

// Enable or disable dynamic DHCP client
pub fn (dev $&WifiDevice) config_dhcp(enable bool) {
    dev.dhcp_enabled = enable
}

// Start Wi-Fi Access Point (SoftAP) with default subnet
pub fn (dev $&WifiDevice) start_ap(ssid string, password string, channel int) bool {
    << dev.start_ap_ip(ssid, password, channel, "192.168.4.1", "192.168.4.1")
}

// Start Wi-Fi Access Point (SoftAP) with custom IP configuration
pub fn (dev $&WifiDevice) start_ap_ip(ssid string, password string, channel int, ap_ip string, gateway string) bool {
    dev.mode = WIFI_MODE_AP
    dev.ssid = ssid
    dev.password = password
    dev.channel = channel
    wifi_unavailable(dev)
    << false
}

// No address can be leased without an active DHCP server.
pub fn (dev $&WifiDevice) allocate_client_ip() string { << "" }

// Connect to target Wi-Fi AP (Station mode) with dynamic DHCP or static IP
pub fn (dev $&WifiDevice) connect(ssid string, password string) bool {
    dev.mode = WIFI_MODE_STA
    dev.ssid = ssid
    dev.password = password
    wifi_unavailable(dev)
    << false
}

// Connect with timeout in milliseconds
pub fn (dev $&WifiDevice) connect_timeout(ssid string, password string, timeout_ms int) bool {
    << dev.connect(ssid,password)
}

// Disconnect from currently connected Wi-Fi network
pub fn (dev $&WifiDevice) disconnect() {
    dev.status = WIFI_STATUS_DISCONNECTED
    dev.sta_connected = false
    dev.ip = "0.0.0.0"
    dev.gateway = "0.0.0.0"
    dev.rssi = 0
}

// Reconnect to previously saved network
pub fn (dev $&WifiDevice) reconnect() bool {
    if dev.ssid.len > 0 {
        << dev.connect(dev.ssid, dev.password)
    }
    << false
}

// Check whether Station is currently connected to an AP
pub fn (dev &WifiDevice) is_connected() bool {
    << dev.sta_connected && dev.status == WIFI_STATUS_CONNECTED
}

// Get assigned IP address string
pub fn (dev &WifiDevice) get_ip() string {
    << dev.ip
}

// Get gateway IP address string
pub fn (dev &WifiDevice) get_gateway() string {
    << dev.gateway
}

// Get netmask string
pub fn (dev &WifiDevice) get_netmask() string {
    << dev.netmask
}

// Get DNS server IP string
pub fn (dev &WifiDevice) get_dns() string {
    << dev.dns
}

// Get current RSSI in dBm
pub fn (dev &WifiDevice) get_rssi() int {
    << dev.rssi
}

// Get SSID
pub fn (dev &WifiDevice) get_ssid() string {
    << dev.ssid
}

// Scan for available 2.4GHz Wi-Fi networks (returns number of detected networks)
pub fn (dev $&WifiDevice) scan() int {
    wifi_unavailable(dev)
    << -1
}

// Get scanned network SSID by index
pub fn (dev &WifiDevice) scan_get_ssid(idx int) string { << "" }

// Get scanned network RSSI signal in dBm by index
pub fn (dev &WifiDevice) scan_get_rssi(idx int) int { << 0 }

// Get scanned network channel by index
pub fn (dev &WifiDevice) scan_get_channel(idx int) int { << 0 }

// Get scanned network authentication mode by index
pub fn (dev &WifiDevice) scan_get_auth(idx int) int { << WIFI_AUTH_UNKNOWN }

// Get scanned network authentication mode name string by index
pub fn (dev &WifiDevice) scan_get_auth_str(idx int) string {
    << authmode_to_string(dev.scan_get_auth(idx))
}

// Get scanned network BSSID MAC by index
pub fn (dev &WifiDevice) scan_get_bssid(idx int) string { << "" }

// Get scanned network item as a value struct
pub fn (dev &WifiDevice) get_scan_result(idx int) WifiScanResult {
    << WifiScanResult{
        ssid: dev.scan_get_ssid(idx),
        rssi: dev.scan_get_rssi(idx),
        channel: dev.scan_get_channel(idx),
        authmode: dev.scan_get_auth(idx),
        bssid: dev.scan_get_bssid(idx)
    }
}

// Print formatted Wi-Fi scan list to UART console
pub fn (dev &WifiDevice) print_scan_list(count int) {
    if count < 0 { uart_println("[Wi-Fi] scan unavailable")
        << }
    uart_println("[Wi-Fi] Scan found networks:")
    for i in 0:count {
        uart_write("  - ")
        uart_write(dev.scan_get_ssid(i))
        uart_write(" (")
        uart_print_int(dev.scan_get_rssi(i))
        uart_println(" dBm)")
    }
}

pub fn authmode_to_string(auth int) string {
    if auth == WIFI_AUTH_OPEN { << "OPEN" }
    else if auth == WIFI_AUTH_WEP { << "WEP" }
    else if auth == WIFI_AUTH_WPA_PSK { << "WPA" }
    else if auth == WIFI_AUTH_WPA2_PSK { << "WPA2" }
    else if auth == WIFI_AUTH_WPA_WPA2_PSK { << "WPA/WPA2" }
    else if auth == WIFI_AUTH_WPA3_PSK { << "WPA3" }
    << "UNKNOWN"
}

pub fn (dev &WifiDevice) get_status_str() string {
    if dev.status == WIFI_STATUS_CONNECTED {
        << "CONNECTED"
    } else if dev.status == WIFI_STATUS_AP_ACTIVE {
        << "AP ACTIVE"
    } else if dev.status == WIFI_STATUS_CONNECTING {
        << "CONNECTING"
    } else if dev.status == WIFI_STATUS_SCANNING {
        << "SCANNING"
    }
    << "IDLE"
}
