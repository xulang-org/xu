@embedded/chips/esp32

// ESP32 High-Speed SPI Master Bus Driver

pub struct SpiBus {
    pub sck_pin int
    pub mosi_pin int
    pub miso_pin int
    pub cs_pin int
    pub sck_mask int
    pub mosi_mask int
    pub cs_mask int
}

pub fn spi_init(sck int, mosi int, miso int, cs int) SpiBus {
    gpio_init(sck, PIN_OUTPUT)
    gpio_init(mosi, PIN_OUTPUT)
    if cs >= 0 {
        gpio_init(cs, PIN_OUTPUT)
    }
    if miso >= 0 {
        gpio_init(miso, PIN_INPUT)
    }

    sck_m := gpio_pin_mask(sck)
    mosi_m := gpio_pin_mask(mosi)
    $cs_m := 0
    if cs >= 0 {
        cs_m = gpio_pin_mask(cs)
        volatile_store(GPIO_OUT_W1TS_REG, cs_m) // CS inactive (HIGH)
    }
    volatile_store(GPIO_OUT_W1TC_REG, sck_m)  // SCK LOW
    volatile_store(GPIO_OUT_W1TC_REG, mosi_m) // MOSI LOW

    << SpiBus{
        sck_pin: sck,
        mosi_pin: mosi,
        miso_pin: miso,
        cs_pin: cs,
        sck_mask: sck_m,
        mosi_mask: mosi_m,
        cs_mask: cs_m
    }
}

pub fn (bus &SpiBus) cs_low() {
    if bus.cs_mask != 0 {
        volatile_store(GPIO_OUT_W1TC_REG, bus.cs_mask) // CS active (LOW)
    }
}

pub fn (bus &SpiBus) cs_high() {
    if bus.cs_mask != 0 {
        volatile_store(GPIO_OUT_W1TS_REG, bus.cs_mask) // CS inactive (HIGH)
    }
}

pub fn (bus &SpiBus) write_byte(b int) {
    sck_m := bus.sck_mask
    mosi_m := bus.mosi_mask

    $val := b
    $mask := 0x80
    while mask > 0 {
        if (val & mask) != 0 {
            volatile_store(GPIO_OUT_W1TS_REG, mosi_m)
        } else {
            volatile_store(GPIO_OUT_W1TC_REG, mosi_m)
        }
        volatile_store(GPIO_OUT_W1TS_REG, sck_m) // SCK HIGH
        volatile_store(GPIO_OUT_W1TC_REG, sck_m) // SCK LOW
        mask = mask >> 1
    }
}

pub fn (bus &SpiBus) write_word(w int) {
    bus.write_byte((w >> 8) & 0xFF)
    bus.write_byte(w & 0xFF)
}

pub fn (bus &SpiBus) write_fill(val16 int, count int) {
    hi := (val16 >> 8) & 0xFF
    lo := val16 & 0xFF
    $n := count
    while n > 0 {
        bus.write_byte(hi)
        bus.write_byte(lo)
        n = n - 1
    }
}
