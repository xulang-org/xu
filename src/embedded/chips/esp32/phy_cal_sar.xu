@embedded/chips/esp32

// ram_en_pwdet + pwdet_sar2_init. The ROM's older power-detector setup
// does not initialize the revised SAR2 path used by the 12-bit RAM reader.
pub fn phy_cal_power_detector_init() bool {
    volatile_store(0x3FF4E05C, volatile_load(0x3FF4E05C) & 0xFF7FFFFF)
    volatile_store(0x3FF4E05C, volatile_load(0x3FF4E05C) & 0xFFDFFFFF)
    volatile_store(0x3FF4E050, volatile_load(0x3FF4E050) & 0xFFFFFFFE)
    volatile_store(0x3FF460C0, volatile_load(0x3FF460C0) | 0x80)
    volatile_store(0x3FF4E050, volatile_load(0x3FF4E050) | 0xC0)
    // set_xpd_sar(1): force both SAR power bits to the active value.
    volatile_store(0x3FF4880C, (volatile_load(0x3FF4880C) & 0xFFF3FFFF) | 0xC0000)
    volatile_store(0x3FF48890, volatile_load(0x3FF48890) | 0x08000000)
    volatile_store(0x3FF66010, volatile_load(0x3FF66010) & 0xFFFFFFFB)
    volatile_store(0x3FF48890, volatile_load(0x3FF48890) & 0xEFFFFFFF)
    volatile_store(0x3FF48894, volatile_load(0x3FF48894) | 0x80000000)
    volatile_store(0x3FF48894, volatile_load(0x3FF48894) & 0x8007FFFF)
    volatile_store(0x3FF4882C, volatile_load(0x3FF4882C) | 0xC)
    volatile_store(0x3FF48838, volatile_load(0x3FF48838) & 0x3FFFFFFF)
    volatile_store(0x3FF48838, volatile_load(0x3FF48838) & 0xFFFFFFFC)
    volatile_store(0x3FF4882C, (volatile_load(0x3FF4882C) & 0xFFFFFF1F) | 0x80)
    << (volatile_load(0x3FF4880C) & 0xC0000) == 0xC0000 &&
        (volatile_load(0x3FF48890) & 0x08000000) != 0
}

// Native ram_tx_pwctrl_bg_init, called again after static BB setup.
// ROM 4000662C also pulses E060.bit0 and reruns the older SAR setup;
// the working RAM revision only initializes SAR2 and enables bit1.
fn phy_cal_background_power_init() bool {
    if !phy_cal_power_detector_init() { << false }
    volatile_store(0x3FF4E060, volatile_load(0x3FF4E060) | 2)
    << (volatile_load(0x3FF4E060) & 2) != 0
}
