@embedded/chips/esp32

// RAM libphy phy_reg_init and its static register helpers, specialized to
// the cold-start ESP32 path. These settings do not replace RX calibration.
// Every volatile access has an Xtensa MEMW fence in the product compiler.
fn phy_cal_tx_paon_regs() {
    volatile_store(0x3FF5D000, (volatile_load(0x3FF5D000) & 0xE00007FF) | 0x1FE48000)
    volatile_store(0x3FF46048, (volatile_load(0x3FF46048) & 0xFFFF00FF) | 0xA400)
    volatile_store(0x3FF5C400, (volatile_load(0x3FF5C400) & 0xFFF8FFFF) | 0x20000)
}

fn phy_cal_static_bb_regs() {
    volatile_store(0x3FF5CC48, 0x170433AF)
    volatile_store(0x3FF5CCE4, volatile_load(0x3FF5CCE4) & 0xFFBFFFFF)
    volatile_store(0x3FF5C400, 0x1AE0A5)
    volatile_store(0x3FF5CD04, 0x51510556)
    volatile_store(0x3FF5CD08, 0x51510556)
    volatile_store(0x3FF5CC0C, 0x1241FC)
    volatile_store(0x3FF5CC08, 0x090B4D20)
    volatile_store(0x3FF5CCDC, 0x0195C83C)
    volatile_store(0x3FF5C044, (volatile_load(0x3FF5C044) & 0xFE00FFFF) | 0x01FB0000)
    volatile_store(0x3FF5C024, (volatile_load(0x3FF5C024) & 0xFFFC01FF) | 0x36800)
    volatile_store(0x3FF5C094, 0x01B8DD03)
    volatile_store(0x3FF5CC04, (volatile_load(0x3FF5CC04) & 0xFFFFFE03) | 0x2C)
    volatile_store(0x3FF5CCD8, 0x186)
}

fn phy_cal_static_agc_regs() {
    volatile_store(0x3FF5C004, volatile_load(0x3FF5C004) & 0xFFFEFFFF)
    volatile_store(0x3FF5C0A4, 0x00E21E3C)
    volatile_store(0x3FF5C0C4, 0x6450403F)
    volatile_store(0x3FF5C030, 0x03C1A4D5)
    volatile_store(0x3FF5C094, 0x01B8DD03)
    volatile_store(0x3FF5C02C, 0x324048FE)
    volatile_store(0x3FF5C02C, volatile_load(0x3FF5C02C) | 0x800000)
    volatile_store(0x3FF5C02C, volatile_load(0x3FF5C02C) & 0xFF7FFFFF)
    volatile_store(0x3FF5C018, (volatile_load(0x3FF5C018) & 0xFFFFFFF8) | 4)
    volatile_store(0x3FF5C018, volatile_load(0x3FF5C018) | 0x40000000)
    volatile_store(0x3FF5C01C, (volatile_load(0x3FF5C01C) & 0xFFFFFF00) | 0xBF)
    volatile_store(0x3FF5C028, (volatile_load(0x3FF5C028) & 0xFFFFFE00) | 0x1BA)
    volatile_store(0x3FF5C0F8, (volatile_load(0x3FF5C0F8) & 0xFFFC01FF) | 0x37400)
    volatile_store(0x3FF5C038, volatile_load(0x3FF5C038) & 0xF7FFFFFF)
    volatile_store(0x3FF5C088, (volatile_load(0x3FF5C088) & 0xFFFFFF00) | 5)
    volatile_store(0x3FF5C104, volatile_load(0x3FF5C104) & 0xFFFF7FFF)
    volatile_store(0x3FF5C07C, (volatile_load(0x3FF5C07C) & 0xFF00FFFF) | 0x009C0000)
}

fn phy_cal_mac_enable_bb() {
    volatile_store(0x3FF00024, volatile_load(0x3FF00024) | 0x10000000)
    // Preserve all three restart pulses from mac_enable_bb.
    for i in 0:3 {
        volatile_store(0x3FF00024, volatile_load(0x3FF00024) & 0xFFFFFFFD)
        volatile_store(0x3FF00024, volatile_load(0x3FF00024) | 2)
    }
}

fn phy_cal_opt_11b_restart() {
    volatile_store(0x3FF5C0A0, (volatile_load(0x3FF5C0A0) & 0xFF00FFFF) | 0x800000)
    volatile_store(0x3FF5C01C, (volatile_load(0x3FF5C01C) & 0xFF00FFFF) | 0xC0000)
    volatile_store(0x3FF5C094, (volatile_load(0x3FF5C094) & 0xFFFF01FF) | 0xDC00)
    volatile_store(0x3FF5C0F0, (volatile_load(0x3FF5C0F0) & 0xFFFFFF00) | 0x80)
    volatile_store(0x3FF5C0B8, volatile_load(0x3FF5C0B8) | 0x800)
}

pub fn phy_cal_bb_registers_init() bool {
    if (volatile_load(0x3FFD741C) & 0x7F) != 0x7F || phy_cal_i2c_error() != 0 { << false }
    phy_cal_tx_paon_regs()
    phy_cal_static_bb_regs()
    phy_cal_static_agc_regs()
    volatile_store(0x3FF5D040, volatile_load(0x3FF5D040) | 0x80000000)
    volatile_store(0x3FF5D03C, 0x401800AA)
    phy_cal_mac_enable_bb()
    // phy_set_bbfreq_init(1).
    volatile_store(0x3FF5CCB8, (volatile_load(0x3FF5CCB8) & 0x1FFFFFFF) | 0x20000000)
    volatile_store(0x3FF5C85C, volatile_load(0x3FF5C85C) & 0xFFFFFFF0)
    if !phy_cal_background_power_init() { << false }
    rom_call6(0x40003BDC, 0, 0, 0, 0, 0, 0)
    volatile_store(0x3FF5C030, (volatile_load(0x3FF5C030) & 0xFFFC07FF) | 0x1A000)
    volatile_store(0x3FF5C11C, 0xE000)
    volatile_store(0x3FF5C120, 0x1E101E1C)
    phy_cal_opt_11b_restart()
    // Check ordinary persistent fields, not pulse or reserved bits.
    ok := (volatile_load(0x3FF00024) & 0x10000002) == 0x10000002 &&
        (volatile_load(0x3FF5C028) & 0x1FF) == 0x1BA &&
        (volatile_load(0x3FF5CCB8) & 0xE0000000) == 0x20000000 &&
        (volatile_load(0x3FF5C030) & 0x3F800) == 0x1A000
    if ok { volatile_store(0x3FFD741C, volatile_load(0x3FFD741C) | 0x80) }
    << ok && phy_cal_i2c_error() == 0
}
