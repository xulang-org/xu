@embedded/chips/esp32

// The working RAM rwble.o checks RX ownership when END and RX coincide.
// ROM 40054E08 always handles END first, which can retire the RX owner.
// Native 40087B2F..8E chooses RX first unless a completed RX descriptor
// belongs to a different CS. Preserve that decision using the ROM layout.
// Run only when the higher-priority fine-timer source is absent; otherwise
// leave the entire status snapshot to ROM so its priority is unchanged.
// IRQs are masked by bt_irq_rom_service. No allocation or Xu owned values.
// 77B0: simultaneous snapshots; B4: RX-first; B8: fine-timer deferrals;
// BC: invalid-layout bits; C0: last handle/count/index; C4: last RX header.
fn irq_ble_rx_before_end(status int) {
    if (status & 10) != 10 { << }
    volatile_store(0x3FFD77B0, volatile_load(0x3FFD77B0) + 1)
    if (status & 0x80) != 0 {
        volatile_store(0x3FFD77B8, volatile_load(0x3FFD77B8) + 1)
        <<
    }
    head := volatile_load(0x3FFB9704)
    if head != 0 {
        if head < 0x3FFD2000 || head > 0x3FFD7000 - 0x9C || head % 4 != 0 {
            volatile_store(0x3FFD77BC, volatile_load(0x3FFD77BC) | 1)
            <<
        }
        handle := irq_ble_u16(head + 0x90)
        if handle >= 14 {
            volatile_store(0x3FFD77BC, volatile_load(0x3FFD77BC) | 2)
            <<
        }
        index := volatile_load8(0x3FFB933C)
        if index >= 8 {
            volatile_store(0x3FFD77BC, volatile_load(0x3FFD77BC) | 4)
            <<
        }
        count := (irq_ble_u16(0x3FFB00BA + handle * 0x5A) >> 12) & 15
        volatile_store(0x3FFD77C0, handle | (count << 8) | (index << 16))
        for i in 0:count {
            descriptor := 0x3FFB0948 + ((index + i) & 7) * 12
            if (irq_ble_u16(descriptor) & 0x8000) == 0 { <- }
            header := irq_ble_u16(descriptor + 2)
            volatile_store(0x3FFD77C4, header)
            if ((header >> 11) & 31) != handle { << }
        }
    }
    // ACK only RX, then let the real ROM RX handler consume the ring.
    // ROM's subsequent ISR entry reads fresh pending state, so it does not
    // replay this RX bit. END, error recovery and other sources remain ROM's.
    volatile_store(0x3FF71218, 2)
    rom_call6(0x40048678, 0, 0, 0, 0, 0, 0)
    volatile_store(0x3FFD77B4, volatile_load(0x3FFD77B4) + 1)
}
