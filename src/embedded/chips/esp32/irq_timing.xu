@embedded/chips/esp32

// Diagnostic CCOUNT samples for returning controller ISR service calls.
// 77A0/A4: CPU4 last/max; 77A8/AC: CPU8 last/max. These words are outside
// tracking state (7780..7798), retry state (77D0..) and IRQ memcpy scratch.
// Attach clears the corresponding pair before that source is enabled.
//
// The interval begins at the service's first CCOUNT read and ends at the
// recorder's CCOUNT read, before restoring the original interrupt mask.
// It includes the clock-call bridges and recorder entry overhead, but not
// the final statistic stores, unmask/return, or ROM vector/callback prologue.
// This is service execution time, not hardware IRQ assertion-to-entry latency.
// At 80 MHz divide cycles by 80 for microseconds. The modulo calculation is
// valid for intervals below 2^31 cycles; fatal/non-returning handlers do not
// publish a completed sample. Each getter is an independent word snapshot.

fn irq_timing_record_ble(started int) {
    elapsed := (irq_rom_cycle_count() - started) & 0x7FFFFFFF
    volatile_store(0x3FFD77A0, elapsed)
    if elapsed > volatile_load(0x3FFD77A4) { volatile_store(0x3FFD77A4, elapsed) }
}

fn irq_timing_record_bb(started int) {
    elapsed := (irq_rom_cycle_count() - started) & 0x7FFFFFFF
    volatile_store(0x3FFD77A8, elapsed)
    if elapsed > volatile_load(0x3FFD77AC) { volatile_store(0x3FFD77AC, elapsed) }
}

pub fn bt_irq_rom_last_cycles() int { << volatile_load(0x3FFD77A0) }
pub fn bt_irq_rom_max_cycles() int { << volatile_load(0x3FFD77A4) }
pub fn bt_irq_rom_bb_last_cycles() int { << volatile_load(0x3FFD77A8) }
pub fn bt_irq_rom_bb_max_cycles() int { << volatile_load(0x3FFD77AC) }
