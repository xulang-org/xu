@embedded/chips/esp32

// ESP32 BLE/HID constants and real hardware clock/reset hooks.
// HCI transport, ATT/HOGP and security state live in embedded/bluetooth;
// these clock prerequisites alone do not establish an encrypted link.

// BLE GAP Advertising Types
pub const BLE_ADV_TYPE_IND         = 0x00 // Connectable undirected advertising
pub const BLE_ADV_TYPE_DIRECT_IND  = 0x01 // Connectable directed advertising
pub const BLE_ADV_TYPE_SCAN_IND    = 0x02 // Scannable undirected advertising
pub const BLE_ADV_TYPE_NONCONN_IND = 0x03 // Non-connectable undirected advertising

// BLE GAP AD (Advertising Data) Types per Bluetooth SIG
pub const BLE_GAP_AD_FLAGS            = 0x01
pub const BLE_GAP_AD_UUID16_SOME      = 0x02
pub const BLE_GAP_AD_UUID16_ALL       = 0x03
pub const BLE_GAP_AD_UUID32_SOME      = 0x04
pub const BLE_GAP_AD_UUID32_ALL       = 0x05
pub const BLE_GAP_AD_UUID128_SOME     = 0x06
pub const BLE_GAP_AD_UUID128_ALL      = 0x07
pub const BLE_GAP_AD_NAME_SHORT       = 0x08
pub const BLE_GAP_AD_NAME_COMPLETE    = 0x09
pub const BLE_GAP_AD_TX_PWR           = 0x0A

// BLE Advertising Flags
pub const BLE_GAP_FLAG_LE_LIMITED_DISC = 0x01
pub const BLE_GAP_FLAG_LE_GEN_DISC     = 0x02
pub const BLE_GAP_FLAG_BR_EDR_NOT_SUPP = 0x04

// Standard GATT Service UUIDs
pub const BLE_UUID_SERV_HID       = 0x1812 // Human Interface Device
pub const BLE_UUID_SERV_BATTERY   = 0x180F // Battery Service
pub const BLE_UUID_SERV_DEVINFO   = 0x180A // Device Information

// HID Mouse Button Masks
pub const HID_MOUSE_BTN_NONE   = 0x00
pub const HID_MOUSE_BTN_LEFT   = 0x01
pub const HID_MOUSE_BTN_RIGHT  = 0x02
pub const HID_MOUSE_BTN_MIDDLE = 0x04

// HID Keyboard Modifiers
pub const HID_MOD_LCTRL  = 0x01
pub const HID_MOD_LSHIFT = 0x02
pub const HID_MOD_LALT   = 0x04
pub const HID_MOD_LGUI   = 0x08 // Command / Windows Key
pub const HID_MOD_RCTRL  = 0x10
pub const HID_MOD_RSHIFT = 0x20
pub const HID_MOD_RALT   = 0x40
pub const HID_MOD_RGUI   = 0x80

// Standard HID Keycodes
pub const HID_KEY_A     = 0x04
pub const HID_KEY_B     = 0x05
pub const HID_KEY_C     = 0x06
pub const HID_KEY_H     = 0x0B
pub const HID_KEY_ENTER = 0x28
pub const HID_KEY_ESC   = 0x29
pub const HID_KEY_SPACE = 0x2C

// HID Consumer Usage Codes (Volume / Media)
pub const HID_CONSUMER_VOLUME_UP   = 0xE9
pub const HID_CONSUMER_VOLUME_DOWN = 0xEA
pub const HID_CONSUMER_MUTE        = 0xE2
pub const HID_CONSUMER_MENU        = 0x40

// Bluetooth Baseband & Low-Power Clock Registers
//
// Corrected against components/soc/esp32/include/soc/dport_reg.h:
//   DR_REG_DPORT_BASE                = 0x3FF00000
//   DPORT_BT_LPCK_DIV_INT_REG        = DR_REG_DPORT_BASE + 0x0D4 = 0x3FF000D4
//   DPORT_BT_LPCK_DIV_FRAC_REG       = DR_REG_DPORT_BASE + 0x0D8 = 0x3FF000D8
// The previous values (0x3FF66044 / 0x3FF66048) point into
// DR_REG_APB_CTRL_BASE on ESP32 and never reached the Bluetooth low power
// clock divider.
pub const DPORT_BT_LPCK_DIV_INT_REG   = 0x3FF000D4
pub const DPORT_BT_LPCK_DIV_FRAC_REG  = 0x3FF000D8

// -------------------------------------------------------------
// ESP32 binding for the portable Bluetooth stack
//
// The BTDM application layer (OSI table, controller lifecycle, modem sleep,
// low power clock, VHCI transport) lives in the `embedded/bluetooth` standard
// library package.  The helpers below expose it through the chip layer so
// applications do not have to know about the module layout.  The controller
// value is owned by the caller: xu has no mutable package globals.

// ===== Chip hooks ==========================================================
//
// The only chip specific part of the BTDM app layer is the Bluetooth low
// power clock.  These hooks write the DPORT registers directly; the portable
// layer only decides *what* to write.

fn bt_not_mask(v int) int {
    << 0 - 1 - v
}

pub const BT_LPCLK_SEL_XTAL     = 0
pub const BT_LPCLK_SEL_XTAL32K  = 1
pub const BT_LPCLK_SEL_RTC_SLOW = 2
pub const BT_LPCLK_SEL_8M       = 3

pub const BT_LPCK_SEL_XTAL      = 0x04000000
pub const BT_LPCK_SEL_XTAL32K   = 0x08000000
pub const BT_LPCK_SEL_RTC_SLOW  = 0x01000000
pub const BT_LPCK_SEL_8M        = 0x02000000
pub const BT_LPCK_SEL_MASK      = 0x0F000000
pub const BT_LPCK_DIV_NUM_MASK  = 0x00000FFF

fn bt_esp32_lpclk_select_src(sel int) bool {
    if sel != BT_LPCLK_SEL_XTAL && sel != BT_LPCLK_SEL_XTAL32K &&
        sel != BT_LPCLK_SEL_RTC_SLOW && sel != BT_LPCLK_SEL_8M {
        << false
    }
    $frac := volatile_load(DPORT_BT_LPCK_DIV_FRAC_REG)
    frac = frac & bt_not_mask(BT_LPCK_SEL_MASK)
    if sel == BT_LPCLK_SEL_XTAL {
        frac = frac | BT_LPCK_SEL_XTAL
    } else if sel == BT_LPCLK_SEL_XTAL32K {
        frac = frac | BT_LPCK_SEL_XTAL32K
    } else if sel == BT_LPCLK_SEL_RTC_SLOW {
        frac = frac | BT_LPCK_SEL_RTC_SLOW
    } else {
        frac = frac | BT_LPCK_SEL_8M
    }
    volatile_store(DPORT_BT_LPCK_DIV_FRAC_REG, frac)
    << true
}

fn bt_esp32_lpclk_set_div(div int) bool {
    if div < 0 || div > 4095 { << false }
    $reg := volatile_load(DPORT_BT_LPCK_DIV_INT_REG)
    reg = reg & bt_not_mask(BT_LPCK_DIV_NUM_MASK)
    reg = reg | (div & BT_LPCK_DIV_NUM_MASK)
    volatile_store(DPORT_BT_LPCK_DIV_INT_REG, reg)
    << true
}

fn bt_esp32_lpclk_read_div() int {
    << volatile_load(DPORT_BT_LPCK_DIV_INT_REG) & BT_LPCK_DIV_NUM_MASK
}

fn bt_esp32_lpclk_read_src() int {
    << volatile_load(DPORT_BT_LPCK_DIV_FRAC_REG)
}

// DPORT Wi-Fi & Baseband Clock & Reset Registers
pub const DPORT_BB_CLK_EN_REG           = 0x3FF000CC
pub const DPORT_BB_RST_EN_REG           = 0x3FF000D0
pub const DPORT_PRO_BT_MAC_INTR_MAP_REG = 0x3FF00110
pub const DPORT_PRO_BT_BB_INTR_MAP_REG  = 0x3FF00114
pub const DPORT_PRO_RWBT_IRQ_MAP_REG   = 0x3FF0011C
pub const DPORT_PRO_RWBLE_IRQ_MAP_REG  = 0x3FF00120

// DPORT Clock Enable bits for BT Baseband
pub const DPORT_WIFI_CLK_WIFI_BT_COMMON_M = 0x000003C9 // Bits 0,3,6..9
pub const DPORT_WIFI_CLK_BT_EN_M          = 0x00030800 // Bits 11,16,17
pub const DPORT_WIFI_CLK_BT_LC_EN_M       = 0x00030000 // Bits 16,17
pub const DPORT_BT_RST_M                  = 0x00000008 // Bit 3 (not EMAC bit 14)

// Enable 2.4GHz RF Baseband Clocks & Release Reset
pub fn bt_power_domain_on() bool {
    // IDF phy_init.c esp_wifi_bt_power_domain_on, ESP32 variant.
    pwc := volatile_load(0x3FF48084)
    volatile_store(0x3FF48084, pwc & bt_not_mask(0x00020000))
    iso := volatile_load(0x3FF48088)
    volatile_store(0x3FF48088, iso & bt_not_mask(0x10000000))
    << (volatile_load(0x3FF48084) & 0x00020000) == 0 &&
        (volatile_load(0x3FF48088) & 0x10000000) == 0
}

pub fn bt_rf_clock_enable() {
    $clk := volatile_load(DPORT_BB_CLK_EN_REG)
    clk = clk | DPORT_WIFI_CLK_WIFI_BT_COMMON_M | DPORT_WIFI_CLK_BT_EN_M | DPORT_WIFI_CLK_BT_LC_EN_M
    volatile_store(DPORT_BB_CLK_EN_REG, clk)

    // Clear reset bit for Bluetooth baseband
    $rst := volatile_load(DPORT_BB_RST_EN_REG)
    rst = rst & bt_not_mask(DPORT_BT_RST_M)
    volatile_store(DPORT_BB_RST_EN_REG, rst)
    uart_println("[RF] Baseband 2.4GHz Clock enabled & Reset released.")
}

// Route the two link-layer level sources to one level-1 CPU interrupt.
// These are RWBT/RWBLE (sources 6/7), not BT_MAC/BT_BB (sources 3/4).
// BT_BB has a separate PHY/tracking handler and must not share this route.
pub fn bt_interrupt_route() {
    volatile_store(DPORT_PRO_RWBT_IRQ_MAP_REG,
        (volatile_load(DPORT_PRO_RWBT_IRQ_MAP_REG) & 0xFFFFFFE0) | 4)
    volatile_store(DPORT_PRO_RWBLE_IRQ_MAP_REG,
        (volatile_load(DPORT_PRO_RWBLE_IRQ_MAP_REG) & 0xFFFFFFE0) | 4)
}

// Clock/reset prerequisites. PHY calibration and controller startup remain pending.
pub fn bt_rf_bringup_sequence() bool {
    if !bt_power_domain_on() { << false }
    // 1. Enable Clocks & Release Reset
    bt_rf_clock_enable()

    // 2. Setup Low-Power Clock (Main XTAL, divider 79)
    bt_esp32_lpclk_select_src(BT_LPCLK_SEL_XTAL)
    bt_esp32_lpclk_set_div(79)

    uart_println("[RF] Baseband clocks configured; PHY calibration and controller startup pending.")
    << true
}
