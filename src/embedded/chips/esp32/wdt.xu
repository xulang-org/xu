@embedded/chips/esp32

// ESP32 Watchdog Timer Control

pub fn wdt_disable() {
    // Disable TIMG0 WDT
    volatile_store(TIMG0_WDTWPROTECT_REG, WDT_WKEY)
    volatile_store(TIMG0_WDTCONFIG0_REG, 0)
    volatile_store(TIMG0_WDTWPROTECT_REG, 0)

    // Disable TIMG1 WDT
    volatile_store(TIMG1_WDTWPROTECT_REG, WDT_WKEY)
    volatile_store(TIMG1_WDTCONFIG0_REG, 0)
    volatile_store(TIMG1_WDTWPROTECT_REG, 0)

    // Disable RTC Watchdog
    volatile_store(RTC_CNTL_WDTWPROTECT_REG, WDT_WKEY)
    volatile_store(RTC_CNTL_WDTCONFIG0_REG, 0)
    volatile_store(RTC_CNTL_WDTWPROTECT_REG, 0)
}

pub fn wdt_feed() {
    volatile_store(TIMG0_WDTWPROTECT_REG, WDT_WKEY)
    volatile_store(TIMG0_WDTFEED_REG, 1)
    volatile_store(TIMG0_WDTWPROTECT_REG, 0)
}

// Global initialization for ESP32 hardware
pub fn init() {
    wdt_disable()
}
