@embedded/chips/esp32

// Cold-start radio prerequisites for the ESP32-D0WD-V3 / 40 MHz crystal.
// Uses real mask-ROM RF/EA entries, never archive machine code. Call with
// controller IRQs/events stopped, before LL initialization or scheduling.
// Owns 3FFD7C00..7C1F: error, stages (clock=1/RF=2/EA=4), BTBB call count,
// BTBB result, saved import, EM mismatch offset, stored XTAL word, copy word.

pub fn radio_rf_error() int { << volatile_load(0x3FFD7C00) }
pub fn radio_rf_stages() int { << volatile_load(0x3FFD7C04) }

// Cold boot only, with controller IRQs masked and before PHY/RF/LL init.
// ROM DATA_INIT does not clear exchange memory. IDF's caller supplies this
// separate initialization; this Xu profile reserves the whole 32 KiB EM.
pub fn radio_controller_memory_init() bool {
    rom_call6(ROM_BTDM_DATA_INIT, 0, 0, 0, 0, 0, 0)
    rom_call6(0x4000C44C, 0x3FFB0000, 0, 0x8000, 0, 0, 0)
    for i in 0:8192 {
        rom_call6(0x4000C2C8, 0x3FFD7C1C, 0x3FFB0000 + i * 4, 4, 0, 0, 0)
        if volatile_load(0x3FFD7C1C) != 0 { << false }
    }
    << true
}

pub fn radio_clock_xtal_40mhz() bool {
    volatile_store(0x3FFD7C00, 0)
    volatile_store(0x3FFD7C04, 0)
    volatile_store(0x3FFD7C08, 0)
    volatile_store(0x3FFD7C0C, 0)
    volatile_store(0x3FFD7C10, 0)
    volatile_store(0x3FFD7C14, 0 - 1)
    // Same repeated-half representation as IDF clk_ll_xtal_load_freq_mhz.
    // Bit zero in each half controls ROM logging and is not frequency.
    stored := volatile_load(0x3FF480B0)
    volatile_store(0x3FFD7C18, stored)
    if (stored & 0xFFFF) != ((stored >> 16) & 0xFFFF) || (stored & 0xFFFE) != 40 {
        volatile_store(0x3FFD7C00, 1)
        << false
    }
    // Native btdm_lpclk_select_src(sel=0): XTAL is bit26, not bit24.
    volatile_store(0x3FF000D8, (volatile_load(0x3FF000D8) & 0xFFF) | 0x04000000)
    volatile_store(0x3FF000D4, (volatile_load(0x3FF000D4) & 0xFFFFF000) | 79)
    if (volatile_load(0x3FF000D8) & 0x0F000000) != 0x04000000 ||
        (volatile_load(0x3FF000D4) & 0xFFF) != 79 {
        volatile_store(0x3FFD7C00, 2)
        << false
    }
    volatile_store(0x3FFD7C04, 1)
    << true
}

fn radio_rf_btbb_import() int {
    volatile_store(0x3FFD7C08, volatile_load(0x3FFD7C08) + 1)
    volatile_store(0x3FFD7C0C, 2)
    // RAM btdm_rf_bb_init_phase1 does this after the EM base write.
    // The mask-ROM caller has just configured EM before this import.
    volatile_store(0x3FF5106C, volatile_load(0x3FF5106C) & 0xFFFFBFFF)
    if phy_cal_bt_baseband_init() {
        volatile_store(0x3FFD7C0C, 1)
        << 0
    }
    // ROM's import is void; retain the failure and refuse later startup.
    volatile_store(0x3FFD7C00, 6)
    << 1
}

fn radio_rf_descriptor_valid() bool {
    << volatile_load(0x3FFBDB28) == 0x400546D0 &&
        volatile_load(0x3FFBDB2C) == 0x400547D0 &&
        volatile_load(0x3FFBDB30) == 0x400546E8 &&
        volatile_load(0x3FFBDB34) == 0x40054728 &&
        volatile_load(0x3FFBDB38) == 0x40054764 &&
        volatile_load(0x3FFBDB3C) == 0x40054810 &&
        volatile_load(0x3FFBDB40) == 0x40054798 &&
        volatile_load(0x3FFBDB44) == 0x400546AC &&
        volatile_load(0x3FFBDB48) == 0x40054698 &&
        volatile_load(0x3FFBDB4C) == 0x400546A0 &&
        volatile_load(0x3FFBDB50) == 0x40054820 &&
        volatile_load(0x3FFBDB54) == 0xBAC4EC06
}

// Also call after LL initialization, before enabling radio IRQs/events,
// to detect any later initializer overwriting the reserved frequency map.
pub fn radio_rf_readback() bool {
    if radio_rf_error() != 0 { << false }
    if !radio_rf_descriptor_valid() ||
        (volatile_load(0x3FF510A0) & 0xFFFF8000) != 0x3FFB0000 {
        volatile_store(0x3FFD7C00, 7)
        << false
    }
    // All 80 physical EM bytes must match, rather than only an upload
    // shadow. The first 40 are even channels, the second 40 odd channels.
    for word in 0:20 {
        $base := word * 8
        if word >= 10 { base = (word - 10) * 8 + 1 }
        expected := base | ((base + 2) << 8) | ((base + 4) << 16) | ((base + 6) << 24)
        rom_call6(0x4000C2C8, 0x3FFD7C1C, 0x3FFB0040 + word * 4, 4, 0, 0, 0)
        if volatile_load(0x3FFD7C1C) != expected {
            volatile_store(0x3FFD7C14, word * 4)
            volatile_store(0x3FFD7C00, 8)
            << false
        }
    }
    << true
}

pub fn radio_rf_cold_init() bool {
    if radio_rf_error() != 0 || radio_rf_stages() != 1 {
        volatile_store(0x3FFD7C00, 3)
        << false
    }
    // Do not rely on the bootloader leaving RF clocks/power/reset set.
    // Calibration owns enabling them; this step checks actual registers.
    if (volatile_load(0x3FF000CC) & 0x00030BC9) != 0x00030BC9 ||
        (volatile_load(0x3FF000D0) & 8) != 0 ||
        (volatile_load(0x3FF48084) & 0x00020000) != 0 ||
        (volatile_load(0x3FF48088) & 0x10000000) != 0 ||
        (volatile_load(0x3FFD741C) & 255) != 255 ||
        !phy_cal_rx_bt_calibrated() || phy_cal_i2c_error() != 0 {
        volatile_store(0x3FFD7C00, 4)
        << false
    }
    // Real r_rf_rw_init calls these exact table slots. It does not run
    // register_chipv7_phy/import[0] or slv_ana/import[2]. Keep those intact.
    if volatile_load(0x3FFAFD64) != 0x3FFB8354 ||
        volatile_load(0x3FFAFD68) != 0x3FFAFD6C ||
        volatile_load(0x3FFAFEB8) != 0x40054868 ||
        volatile_load(0x3FFAFEBC) != 0x400549D0 {
        volatile_store(0x3FFD7C00, 5)
        << false
    }
    old_import := volatile_load(0x3FFB8358)
    entry := rom_callback(radio_rf_btbb_import)
    volatile_store(0x3FFD7C10, old_import)
    // DATA_INIT clears the import table in BSS. NULL is an unbound slot
    // we implement here, not permission to fill unrelated slots with noops.
    if old_import != 0 && old_import != entry &&
        (old_import < 0x40000000 || old_import >= 0x40070000 || old_import % 4 != 0) {
        volatile_store(0x3FFD7C00, 5)
        << false
    }
    volatile_store(0x3FFB8358, entry)
    // Full ROM contract: RF descriptor at DB28, EM-base register,
    // EM0040..008F even/odd frequency map, Xu BTBB import, BT/LE regs.
    rom_call6(0x40054B0C, 0x3FFBDB28, 0, 0, 0, 0, 0)
    if volatile_load(0x3FFD7C08) != 1 || volatile_load(0x3FFD7C0C) != 1 ||
        phy_cal_i2c_error() != 0 {
        volatile_store(0x3FFD7C00, 6)
        << false
    }
    if !radio_rf_readback() { << false }
    volatile_store(0x3FFD7C04, 3)
    << true
}

pub fn radio_event_arbiter_init() bool {
    if radio_rf_error() != 0 || radio_rf_stages() != 3 {
        volatile_store(0x3FFD7C00, 9)
        << false
    }
    // r_ea_init calls modules[0] four times, initializing the real
    // 20-byte co_list headers, then zeros ea_env+20. It allocates nothing.
    if volatile_load(0x3FFAFD68) != 0x3FFAFD6C ||
        volatile_load(0x3FFAFD6C) != 0x40013F14 {
        volatile_store(0x3FFD7C00, 10)
        << false
    }
    rom_call6(0x40015228, 0, 0, 0, 0, 0, 0)
    if (volatile_load(0x3FFB80EC) | volatile_load(0x3FFB80F0) |
        volatile_load(0x3FFB80F4) | volatile_load(0x3FFB80F8) |
        volatile_load(0x3FFB8100) | volatile_load(0x3FFB8104) |
        volatile_load(0x3FFB8108) | volatile_load(0x3FFB810C) |
        volatile_load(0x3FFB8110) | volatile_load(0x3FFB8118) |
        volatile_load(0x3FFB811C) | volatile_load(0x3FFB8120) |
        volatile_load(0x3FFB8124) | volatile_load(0x3FFB812C) |
        volatile_load(0x3FFB8130) | volatile_load(0x3FFB8134) |
        volatile_load(0x3FFB8138)) != 0 ||
        volatile_load(0x3FFB80FC) != 0xFFFFFFFF ||
        volatile_load(0x3FFB8114) != 0xFFFFFFFF ||
        volatile_load(0x3FFB8128) != 0xFFFFFFFF ||
        volatile_load(0x3FFB813C) != 0xFFFFFFFF {
        volatile_store(0x3FFD7C00, 11)
        << false
    }
    volatile_store(0x3FFD7C04, 7)
    << true
}
