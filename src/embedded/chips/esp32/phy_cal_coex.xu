@embedded/chips/esp32

// ESP32 esp_phy_enable's post-calibration coex_bt_high_prio contract.
// Call while controller events/IRQs are stopped. This enables hardware
// arbitration and gives BT priority; it is not the force_bt_mode override.
// Keep each native RMW separate because intermediate values reach hardware.
pub fn phy_cal_bt_priority() bool {
    volatile_store(0x3FF5C080, volatile_load(0x3FF5C080) & 0xFFFFFF3F)
    volatile_store(0x3FF710D0, volatile_load(0x3FF710D0) & 0xFFFFFF0F)
    volatile_store(0x3FF71300, volatile_load(0x3FF71300) & 0xFFFFFF0F)
    volatile_store(0x3FF73D30, volatile_load(0x3FF73D30) | 1)
    volatile_store(0x3FF73D30, (volatile_load(0x3FF73D30) & 0xF0FFFFFF) | 0x01000000)
    volatile_store(0x3FF73D30, (volatile_load(0x3FF73D30) & 0xFF0FFFFF) | 0x00400000)
    volatile_store(0x3FF73D38, (volatile_load(0x3FF73D38) & 0xFFFF) | 0x0C800000)
    volatile_store(0x3FF73D38, (volatile_load(0x3FF73D38) & 0xFFFF0000) | 10)
    volatile_store(0x3FF73D40, (volatile_load(0x3FF73D40) & 0xFFFFFFC7) | 0x10)
    volatile_store(0x3FF441C4, volatile_load(0x3FF441C4) | 0x40)
    volatile_store(0x3FF710D0, volatile_load(0x3FF710D0) | 1)
    volatile_store(0x3FF71300, volatile_load(0x3FF71300) | 1)
    volatile_store(0x3FF5D040, volatile_load(0x3FF5D040) & 0x7FFFFFFF)
    << (volatile_load(0x3FF5C080) & 0xC0) == 0 &&
        (volatile_load(0x3FF710D0) & 0xF1) == 1 &&
        (volatile_load(0x3FF71300) & 0xF1) == 1 &&
        (volatile_load(0x3FF73D30) & 0x0FF00001) == 0x01400001 &&
        volatile_load(0x3FF73D38) == 0x0C80000A &&
        (volatile_load(0x3FF73D40) & 0x38) == 0x10 &&
        (volatile_load(0x3FF441C4) & 0x40) != 0 &&
        (volatile_load(0x3FF5D040) & 0x80000000) == 0
}
