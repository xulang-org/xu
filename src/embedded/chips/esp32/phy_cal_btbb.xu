@embedded/chips/esp32

// Cold-start BT baseband register port, not PHY calibration. Recovered
// from librtc.a:bt_bb.o, bt_bb_init_cmplx and BT_init_rx_filters. The
// 0x600xxxxx APB addresses use their equivalent 0x3FFxxxxx aliases here.
pub fn phy_cal_hw_frequency_disable() bool {
    $idle := false
    $i := 0
    while i < 2000 && !idle {
        if (volatile_load(0x3FF4E168) & 0x80000000) == 0 ||
            (volatile_load(0x3FF4E0C4) & 0x100) != 0 {
            idle = true
        } else {
            rom_delay_us(1)
            i = i + 1
        }
    }
    if !idle {
        volatile_store(0x3FFD7400, 4)
        << false
    }
    volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) | 0x02000000)
    volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) & 0xFFFFFEFF)
    rom_delay_us(2)
    << true
}

pub fn phy_cal_hw_frequency_enable() {
    volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) & 0xFDFFFFFF)
    volatile_store(0x3FF5C07C, (volatile_load(0x3FF5C07C) & 0xFF00FFFF) | 0x009C0000)
}

fn phy_cal_bt_tx_if() {
    volatile_store(0x3FF5103C, (volatile_load(0x3FF5103C) & 0x801FFFFF) | (0x122 << 21))
    $delay := 0
    if (volatile_load(0x3FF450D0) & 0x40000000) == 0 {
        delay = volatile_load(0x3FF450F0) & 0x1FF
    }
    // Preserve all native parameter/enable writes and fresh readbacks.
    // Keep the native write contract even when final values coincide.
    // The exact transient-bit mechanism is not established by the A/B/A test.
    volatile_store(0x3FF5103C, (volatile_load(0x3FF5103C) & 0xFFE007FF) |
        (((1000 - delay) & 0x3FF) << 11))
    volatile_store(0x3FF5103C, (volatile_load(0x3FF5103C) & 0xFFFFF801) | (200 << 1))
    volatile_store(0x3FF5103C, volatile_load(0x3FF5103C) | 0x80000000)
    volatile_store(0x3FF5103C, volatile_load(0x3FF5103C) | 1)
}

fn phy_cal_bt_rx_filters() {
    volatile_store(0x3FF51028, 0x17)
    volatile_store(0x3FF5105C, (volatile_load(0x3FF5105C) & 0xFC1FFFFF) | 0x03400000)
    volatile_store(0x3FF5105C, (volatile_load(0x3FF5105C) & 0xFFFF07FF) | 0x00009800)
    volatile_store(0x3FF51058, (volatile_load(0x3FF51058) & 0xFFFF03FF) | 0x00005000)
    volatile_store(0x3FF51020, (volatile_load(0x3FF51020) & 0xFFFFFFC0) | 8)
    volatile_store(0x3FF5C07C, (volatile_load(0x3FF5C07C) & 0xFF00FFFF) | 0x00A10000)
    volatile_store(0x3FF5C090, (volatile_load(0x3FF5C090) & 0xC1FFFFFF) | 0x32000000)
    volatile_store(0x3FF5C090, (volatile_load(0x3FF5C090) & 0xFE0FFFFF) | 0x00700000)
    volatile_store(0x3FF5C080, (volatile_load(0x3FF5C080) & 0xFFFE00FF) | 0x0001D400)
    volatile_store(0x3FF5C0D0, (volatile_load(0x3FF5C0D0) & 0xFFFFFE00) | 0x000001D4)
    volatile_store(0x3FF5C080, (volatile_load(0x3FF5C080) & 0xFF81FFFF) | 0x00180000)
    volatile_store(0x3FF5104C, (volatile_load(0x3FF5104C) & 0xFFFF83FF) | 0x00007800)
    volatile_store(0x3FF5C07C, (volatile_load(0x3FF5C07C) & 0xF0FFFFFF) | 0x03000000)
    volatile_store(0x3FF5C080, (volatile_load(0x3FF5C080) & 0xFFFFFFC1) | 8)
    volatile_store(0x3FF5C07C, volatile_load(0x3FF5C07C) & 0xCFFFFFFF)
    volatile_store(0x3FF5C080, (volatile_load(0x3FF5C080) & 0x1FFFFFFF) | 0x60000000)
    volatile_store(0x3FF5C084, (volatile_load(0x3FF5C084) & 0xFFE07FFF) | 0x00188000)
    volatile_store(0x3FF5C084, (volatile_load(0x3FF5C084) & 0xFFFF81FF) | 0x00001E00)
    volatile_store(0x3FF5C084, volatile_load(0x3FF5C084) & 0xE7FFFFFF)
    volatile_store(0x3FF5C084, (volatile_load(0x3FF5C084) & 0xF83FFFFF) | 0x00800000)
    volatile_store(0x3FF5106C, (volatile_load(0x3FF5106C) & 0xFFF0FFFF) | 0x00060000)
    volatile_store(0x3FF72124, volatile_load(0x3FF72124) | 0x200)
    volatile_store(0x3FF51084, (volatile_load(0x3FF51084) & 0xFF00FFFF) | 0x00FB0000)
}

// RAM bt_bb_init_cmplx_reg, also used after the BT-only reset pulse.
// Keep this separate from cold PHY setup: recovery must preserve PLL/I2C,
// clock gates and the radio ownership selected by the running controller.
fn phy_cal_bt_baseband_registers() {
    volatile_store(0x3FF51000, volatile_load(0x3FF51000) & 0xFFFFFFC3)
    volatile_store(0x3FF51014, 0x18021)
    volatile_store(0x3FF51044, (volatile_load(0x3FF51044) & 0xFFFFFF00) | 0xA0)
    volatile_store(0x3FF51040, volatile_load(0x3FF51040) & 0xF81FFFFF)
    volatile_store(0x3FF51040, volatile_load(0x3FF51040) | 1)
    phy_cal_bt_tx_if()
    phy_cal_bt_rx_filters()
    volatile_store(0x3FF51040, (volatile_load(0x3FF51040) & 0xFFE00001) | 0x199A)
    // The radio digital gain tables are shared between WiFi and BT; the base
    // register selects where the BT table starts.  Left at its power-on value
    // the BT table points at the wrong offset, so the RF calibration data
    // lands in the wrong table.  These belong to the shared "registers"
    // function so the recovery path (which only calls
    // phy_cal_bt_baseband_registers) sets the same values as the cold start.
    volatile_store(0x3FF72130, (volatile_load(0x3FF72130) & 0xFFFF0000) | 0x88E6)
    volatile_store(0x3FF720F4, (volatile_load(0x3FF720F4) & 0xFFFFC0FF) | 0xA3F)
    volatile_store(0x3FF720F0, (volatile_load(0x3FF720F0) & 0xFE00FE00) | 0x00DC00DC)
    volatile_store(0x3FF720DC, volatile_load(0x3FF720DC) & 0xFFFF7FFF)
}

// Requires the PHY analog bus and Xu I2C callbacks to be installed.
// This supplies the register work of import_rf_phy slot +4, but does not
// claim RF/PLL/IQ/TX calibration or permission to start a radio event.
pub fn phy_cal_bt_baseband_init() bool {
    if !phy_cal_hw_frequency_disable() { << false }
    rom_delay_us(2)
    phy_cal_bt_baseband_registers()
    rom_call6(0x400041FC, 0x67, 1, 15, 2, 0, 1)
    rom_call6(0x400041FC, 0x67, 1, 15, 3, 3, 1)
    rom_call6(0x400041FC, 0x67, 1, 6, 6, 0, 0x6E)
    rom_call6(0x400041FC, 0x67, 1, 5, 6, 0, 0x6C)
    rom_call6(0x400041FC, 0x67, 1, 15, 4, 4, 0)
    rom_call6(0x400041FC, 0x67, 1, 11, 4, 3, 0)
    rom_call6(0x400041FC, 0x67, 1, 8, 6, 0, 12)
    rom_call6(0x400041FC, 0x67, 1, 7, 6, 0, 10)
    volatile_store(0x3FF4604C, (volatile_load(0x3FF4604C) & 0xFFFF00FF) | 0xC800)
    phy_cal_hw_frequency_enable()
    // On rev3.1 the 0x18021 command reads back 0x18020 and filter command
    // 0x17 reads back 1. Do not require transient command bits to persist.
    filter6 := rom_call6(0x400041C0, 0x67, 1, 6, 6, 0, 0)
    filter5 := rom_call6(0x400041C0, 0x67, 1, 5, 6, 0, 0)
    << phy_cal_i2c_error() == 0 &&
        (volatile_load(0x3FF51014) & 0x1FFFE) == 0x18020 &&
        (volatile_load(0x3FF51028) & 1) == 1 && filter6 == 0x6E && filter5 == 0x6C
}
