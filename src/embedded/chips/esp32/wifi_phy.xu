@embedded/chips/esp32

// Fixed-profile Wi-Fi PHY calibration, measured on ESP32-D0WD-V3 at 40MHz.
// Caller owns the radio and the reserved 0x3FFD5500..0x3FFD57FF workspace.
// Failed measurements stop initialization before any station transmission.
fn wifi_work_get(address int) int {
    if address < 0x3FFD5500 || address > 0x3FFD57FC || address % 4 != 0 { << -1 }
    rom_call6(0x4000C2C8,0x3FFD57FC,address,4,0,0,0)
    << volatile_load(0x3FFD57FC)
}
fn wifi_work_put(address int, value int) {
    if address < 0x3FFD5500 || address > 0x3FFD57F8 || address % 4 != 0 { << }
    volatile_store(0x3FFD57FC,value)
    rom_call6(0x4000C2C8,address,0x3FFD57FC,4,0,0,0)
}
fn wifi_rf(index int) int {
    if index < 7 { << phy_cal_rx_bt_rf_gain(index) }
    if index == 7 { << 0x48 }
    if index == 8 { << 0x50 }
    << -1
}
fn wifi_step(index int) int {
    if index < 6 { << phy_cal_rx_bt_step(index) }
    if index == 6 { << 5 }
    if index == 7 { << 4 }
    << 6
}
fn wifi_gain(index int) int {
    if index < 0 || index > 72 { << -1 }
    $rf := 0
    $bb := 0
    for n in 0:index + 1 {
        if bb == wifi_step(rf) && rf < 8 { rf += 1
            bb = 0 }
        if n == index { << (wifi_rf(rf) << 8) | (phy_cal_rx_bb_coarse(bb / 6) << 3) | (bb % 6) }
        bb += 1
    }
    << -1
}
fn wifi_frequency(channel int) bool {
    if channel < 1 || channel > 14 || !phy_cal_hw_frequency_disable() { << false }
    $frequency := 2412 + (channel - 1) * 5
    if channel == 14 { frequency = 2484 }
    index := frequency - 2400
    volatile_store(0x3FF4E0C4,(volatile_load(0x3FF4E0C4) & 0xFFFFFF00) | (index * 3))
    cap := volatile_load(0x3FF4E0C0) & 255
    phy_cal_write(0x62,1,1,cap)
    fraction := (frequency * 262144) / 120 - 2097152
    packed := ((fraction >> 16) & 255) | (fraction & 0xFF00) | ((fraction & 255) << 16)
    volatile_store(0x3FFD7B50,packed)
    rom_call6(0x40004740,0x3FFD7B50,0,0,0,0,0)
    phy_cal_pll_restart()
    if !phy_cal_pll_wait() { << false }
    phy_cal_rx_analog_caps(cap)
    << phy_cal_i2c_error() == 0
}
fn wifi_dc(mode int, initial int) bool {
    $i := (initial >> 16) & 65535
    $q := initial & 65535
    $bits := 0
    coarse := rom_call6(0x40004414,1,2,0,0,0,0) & 255
    for bit in 0:8 { bits += (coarse >> bit) & 1 }
    $threshold := 1
    $shift := 0
    $limit := 20
    if mode == 0 { limit = 8
        if bits >= 3 { threshold = bits - 1 }
        if bits >= 2 { shift = bits - 1 } }
    $ok := false
    for iteration in 0:limit {
        $selector := 1
        if mode == 0 { selector = 2 }
        phy_cal_pbus_force(2,selector,i)
        phy_cal_pbus_force(3,selector,q)
        $base_i := 0
        $base_q := 0
        $di := 0
        $dq := 0
        $high_i := 0
        $high_q := 0
        if mode == 0 {
            rom_delay_us(10)
            if !phy_cal_rx_est_min() { << false }
            di = phy_cal_rx_s32(volatile_load(0x3FFD7810))
            dq = phy_cal_rx_s32(volatile_load(0x3FFD7814))
        } else {
            phy_cal_pbus_force(1,2,0)
            rom_delay_us(10)
            if !phy_cal_rx_est_min() { << false }
            base_i = phy_cal_rx_s32(volatile_load(0x3FFD7810))
            base_q = phy_cal_rx_s32(volatile_load(0x3FFD7814))
            phy_cal_pbus_force(1,2,0x20)
            rom_delay_us(10)
            if !phy_cal_rx_est_min() { << false }
            high_i = phy_cal_rx_s32(volatile_load(0x3FFD7810))
            high_q = phy_cal_rx_s32(volatile_load(0x3FFD7814))
            di = high_i - base_i
            dq = high_q - base_q
        }
        if phy_cal_rx_abs(di) <= threshold && phy_cal_rx_abs(dq) <= threshold {
            i -= base_i
            q -= base_q
            if mode != 0 && initial != 0x01000100 {
                if phy_cal_rx_abs(base_i) > 20 || phy_cal_rx_abs(high_i) > 20 ||
                    phy_cal_rx_abs(di) > 5 || phy_cal_rx_abs(i - ((initial >> 16) & 65535)) > 40 {
                    i = (initial >> 16) & 65535 }
                if phy_cal_rx_abs(base_q) > 20 || phy_cal_rx_abs(high_q) > 20 ||
                    phy_cal_rx_abs(dq) > 5 || phy_cal_rx_abs(q - (initial & 65535)) > 40 {
                    q = initial & 65535 }
            }
            ok = true
            <-
        }
        $step_i := di
        $step_q := dq
        if mode == 0 { step_i = (di * 2) >> shift
            step_q = (dq * 2) >> shift }
        if mode == 2 {
            if step_i > 5 { step_i = 5 }
            if step_i < -5 { step_i = -5 }
            if step_q > 5 { step_q = 5 }
            if step_q < -5 { step_q = -5 }
        }
        if phy_cal_rx_abs(di) > threshold { i -= step_i }
        if phy_cal_rx_abs(dq) > threshold { q -= step_q }
        if i < 0 { i = 0 }
        if q < 0 { q = 0 }
        if i > 511 { i = 511 }
        if q > 511 { q = 511 }
    }
    if !ok || i < 0 || i > 511 || q < 0 || q > 511 { << false }
    $selector := 1
    if mode == 0 { selector = 2 }
    phy_cal_pbus_force(2,selector,i)
    phy_cal_pbus_force(3,selector,q)
    volatile_store(0x3FFD57F0,(i << 16) | q)
    << phy_cal_i2c_error() == 0
}
fn wifi_iq_tone_power() int {
    volatile_store(0x3FF46060,(volatile_load(0x3FF46060) & 0xF3FFFFFF) | 0x04000000)
    volatile_store(0x3FF4607C,(volatile_load(0x3FF4607C) & 0xFFE7FFFF) | 0x00100000)
    volatile_store(0x3FF4607C,(volatile_load(0x3FF4607C) & 0xFFFE0003) | (1023 << 2))
    volatile_store(0x3FF4607C,volatile_load(0x3FF4607C) | 1)
    rom_delay_us(1)
    volatile_store(0x3FF4607C,volatile_load(0x3FF4607C) | 2)
    $ready := false
    for i in 0:2000 {
        if (volatile_load(0x3FF4607C) & 0x80000000) != 0 { ready = true
            <- }
        rom_delay_us(1)
    }
    power := phy_cal_rx_s32(volatile_load(0x3FF460E4)) >> 7
    phy_cal_rx_est_disable()
    if !ready { << -1 }
    << power
}
fn wifi_iq() bool {
    // Native loopback uses RF TX rows [13,12,4,0,0] and four RX coarse
    // states [0x20,0x28,0x2C,0x2E]. RF measurements are not constants.
    rf := [13,12,4,0,0]
    bb := [0x20,0x28,0x2C,0x2E]
    rom_call6(0x400030F8,1,0,0,0,0,0)
    rom_call6(0x400041FC,0x64,0,4,7,7,1)
    volatile_store(0x3FF450DC,volatile_load(0x3FF450DC) | 0x08000000)
    volatile_store(0x3FF450DC,volatile_load(0x3FF450DC) & 0xEFFFFFFF)
    volatile_store(0x3FF450DC,volatile_load(0x3FF450DC) & 0xFFFFEFFF)
    encoded := volatile_load(0x3FFD74BC)
    $amp := (encoded >> 6) & 31
    $phase := encoded & 63
    if amp > 15 { amp -= 32 }
    if phase > 31 { phase -= 64 }
    rom_call6(0x40005154,amp,1,0,0,0,0)
    rom_call6(0x40005154,phase,0,0,0,0,0)
    $ok := true
    for row in 0:4 {
        rom_call6(0x40003060,rf[row + 1],0x104,bb[row] + 0x80,0,0,0)
        volatile_store(0x3FFD57F0,0x01000100)
        if !wifi_dc(1,0x01000100) { ok = false
            <- }
        $atten := 24
        $tx := rf[row + 1]
        for trial in 0:2 {
            phy_cal_pbus_force(1,1,0x1F1)
            phy_cal_pbus_force(1,1,0x1F9)
            rom_call6(0x400035D0,1,128,atten,0,0,0)
            power := wifi_iq_tone_power()
            if power < 0 { ok = false }
            rom_call6(0x40003F98,1,0,0,0,0,0)
            if !ok { <- }
            if power > 4095 && power < 131073 { <- }
            if power < 4096 {
                if trial == 0 && row > 0 { tx = rf[row] }
                else { atten = 0 }
            } else {
                if trial == 0 && tx != 0 { tx = rf[row + 2] }
                else { atten += 24
                    if atten > 120 { atten = 120 } }
            }
            phy_cal_pbus_force(5,1,tx)
        }
        if !ok { <- }
        value := rom_call6(0x40005BBC,128,atten,0,0,0,0)
        if value < 0 || value > 2047 || phy_cal_i2c_error() != 0 { ok = false
            <- }
        wifi_work_put(0x3FFD5640 + row * 4,value)
    }
    rom_call6(0x400030F8,0,0,0,0,0,0)
    rom_call6(0x400041FC,0x64,0,4,7,7,0)
    volatile_store(0x3FF450DC,volatile_load(0x3FF450DC) | 0x10000000)
    volatile_store(0x3FF450DC,volatile_load(0x3FF450DC) | 0x1000)
    << ok
}
pub fn wifi_phy_calibrate() bool {
    volatile_store(0x3FFD57E0,0)
    if !phy_cal_rx_bt_calibrated() || wifi_gain(72) != 0x50ED { << false }
    // The reused BLE baseline has already released/enabled AGC. Native
    // set_rx_gain_table executes BEFORE that release: stop the automatic
    // receiver before forcing gain/DC states, or it can compete with PBUS.
    volatile_store(0x3FF5C01C,(volatile_load(0x3FF5C01C) & 0xFF00FFFF) | 0x7F0000)
    volatile_store(0x3FF5C038,volatile_load(0x3FF5C038) | 0x04000000)
    volatile_store(0x3FF5C030,volatile_load(0x3FF5C030) & 0xFFFFFFCF)
    volatile_store(0x3FF5C080,volatile_load(0x3FF5C080) | 1)
    // Reapply the measured RC-derived 20MHz filter after the BLE stage.
    tx := volatile_load(0x3FFD7430)
    rx := volatile_load(0x3FFD7434)
    phy_cal_write(0x67,1,3,(tx - 2) & 255)
    phy_cal_write(0x67,1,4,tx)
    phy_cal_write(0x67,1,10,0x10)
    phy_cal_write(0x67,1,1,((rx + 10) & 255) | 0x80)
    phy_cal_write(0x67,1,2,((rx + 10) & 255) | 0x80)
    phy_cal_write(0x67,1,9,0x71)
    rom_call6(0x40003BAC,0,0,0,0,0,0)
    volatile_store(0x3FF5D000,(volatile_load(0x3FF5D000) & 0xFF81FFFF) | 0x640000)
    if !phy_cal_hw_frequency_disable() { << false }
    volatile_store(0x3FF460A0,volatile_load(0x3FF460A0) | 0xC000)
    rom_call6(0x40004458,0,0,0,0,0,0)
    rom_call6(0x4000453C,0,0,0,0,0,0)
    volatile_store(0x3FFD57E0,1)
    if !wifi_iq() { << false }
    volatile_store(0x3FFD57E0,2)
    volatile_store(0x3FF450DC,volatile_load(0x3FF450DC) & 0xF7FFFFFF)
    rom_call6(0x4000453C,0,0,0,0,0,0)
    rom_call6(0x40003594,1,0,0,0,0,0)
    rom_call6(0x40003564,1,0,0,0,0,0)
    if !wifi_frequency(14) { << false }
    $dc := 0x01000100
    phy_cal_pbus_force(2,1,256)
    phy_cal_pbus_force(3,1,256)
    for row in 0:30 {
        volatile_store(0x3FFD57E4,row)
        phy_cal_pbus_force(0,1,0x184)
        rom_call6(0x40004480,(phy_cal_rx_bb_coarse(row / 6) << 3) | (row % 6),0,0,0,0,0)
        phy_cal_pbus_force(0,1,0)
        if !wifi_dc(0,dc) { << false }
        dc = volatile_load(0x3FFD57F0)
        wifi_work_put(0x3FFD5550 + row * 4,dc)
    }
    volatile_store(0x3FFD57E0,3)
    dc = 0x01000100
    for row in 0:9 {
        volatile_store(0x3FFD57E4,row)
        phy_cal_pbus_force(0,1,0x184)
        rom_call6(0x40004480,wifi_rf(row) << 8,0,0,0,0,0)
        zero := wifi_work_get(0x3FFD5550)
        phy_cal_pbus_force(2,2,(zero >> 16) & 511)
        phy_cal_pbus_force(3,2,zero & 511)
        if !wifi_dc(1,dc) { << false }
        dc = volatile_load(0x3FFD57F0)
        wifi_work_put(0x3FFD55D0 + row * 4,dc)
    }
    volatile_store(0x3FFD57E0,4)
    for channel in 1:15 {
        volatile_store(0x3FFD57E4,channel)
        if !wifi_frequency(channel) { << false }
        if !wifi_dc(2,dc) { << false }
        dc = volatile_load(0x3FFD57F0)
        wifi_work_put(0x3FFD5600 + (channel - 1) * 4,dc)
    }
    rom_call6(0x40003594,0,0,0,0,0,0)
    rom_call6(0x40003564,0,0,0,0,0,0)
    volatile_store(0x3FF460A0,volatile_load(0x3FF460A0) & 0xFFFF7FFF)
    rom_call6(0x4000453C,0,0,0,0,0,0)
    rom_call6(0x4000446C,0,0,0,0,0,0)
    volatile_store(0x3FFD57E0,5)
    << phy_cal_i2c_error() == 0
}

pub fn wifi_phy_select(channel int) bool {
    if volatile_load(0x3FFD57E0) != 5 || channel < 1 || channel > 14 { << false }
    volatile_store(0x3FF5C01C,(volatile_load(0x3FF5C01C) & 0xFF00FFFF) | 0x7F0000)
    volatile_store(0x3FF5C030,volatile_load(0x3FF5C030) & 0xFFFFFFCF)
    volatile_store(0x3FF5C080,volatile_load(0x3FF5C080) | 1)
    if !wifi_frequency(channel) { << false }
    $frequency := 2412 + (channel - 1) * 5
    if channel == 14 { frequency = 2484 }
    rom_call6(0x40003AC8,channel,frequency,0,0,0,0)
    $rf := 0
    for row in 0:73 {
        gain := wifi_gain(row)
        if (gain >> 8) != wifi_rf(rf) { rf += 1 }
        if rf > 8 || (gain >> 8) != wifi_rf(rf) { << false }
        $dc := wifi_work_get(0x3FFD55D0 + rf * 4)
        $bb_index := (((gain >> 3) & 1) * 6) + (gain & 7)
        if row >= 43 { dc = wifi_work_get(0x3FFD5600 + (channel - 1) * 4)
            bb_index = row - 43 }
        bb_dc := wifi_work_get(0x3FFD5550 + bb_index * 4)
        i_bb := (bb_dc >> 16) & 65535
        q_bb := bb_dc & 65535
        coarse := (gain >> 3) & 31
        $iq_index := 0
        for bit in 0:5 { iq_index += (coarse >> bit) & 1 }
        if iq_index > 3 { iq_index = 3 }
        iq := wifi_work_get(0x3FFD5640 + iq_index * 4) & 2047
        low := (gain * 0x20000 + (((dc >> 16) & 65535) << 8) + (i_bb >> 1)) & 0xFFFFFFFF
        high := (((dc & 65535) << 22) + (i_bb << 31) + (q_bb << 13) + (iq << 2)) & 0xFFFFFFFF
        phy_cal_write_gain(low,high,row)
    }
    volatile_store(0x3FF5C02C,(volatile_load(0x3FF5C02C) & 0xFFFF80FF) | (72 << 8))
    volatile_store(0x3FF450DC,volatile_load(0x3FF450DC) | 0x18001800)
    volatile_store(0x3FF5D008,volatile_load(0x3FF5D008) & 0xDFFFFFFF)
    volatile_store(0x3FF5C080,volatile_load(0x3FF5C080) & 0xFFFFFFFE)
    volatile_store(0x3FF5C030,(volatile_load(0x3FF5C030) & 0xFFFFFFCF) | 0x10)
    volatile_store(0x3FF5C01C,(volatile_load(0x3FF5C01C) & 0xFF00FFFF) | 0xC0000)
    volatile_store(0x3FF5C038,volatile_load(0x3FF5C038) | 0x04000000)
    << phy_cal_i2c_error() == 0
}
