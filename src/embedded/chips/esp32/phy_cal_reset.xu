@embedded/chips/esp32

// Cold-start prefix from the working C image's register_chipv7_phy:
// reset_rf_dig -> phy_dis_hw_set_freq -> i2c_master_reset. Call only after
// RF power/clocks are on, with controller IRQs/events stopped, before any
// calibration. This is not the runtime BT-only recovery reset.
pub fn phy_cal_cold_reset() bool {
    // disable_wifi_agc controls the shared analog receiver path.
    volatile_store(0x3FF5C01C, (volatile_load(0x3FF5C01C) & 0xFF00FFFF) | 0x007F0000)
    volatile_store(0x3FF5C038, volatile_load(0x3FF5C038) | 0x04000000)
    volatile_store(0x3FF5C030, volatile_load(0x3FF5C030) & 0xFFFFFFCF)
    volatile_store(0x3FF5C080, volatile_load(0x3FF5C080) | 1)
    volatile_store(0x3FF00024, volatile_load(0x3FF00024) & 0xFFFFFFFD)
    volatile_store(0x3FF000D0, volatile_load(0x3FF000D0) | 3)
    rom_delay_us(1)
    volatile_store(0x3FF000D0, volatile_load(0x3FF000D0) & 0xFFFFFFFC)
    volatile_store(0x3FF48030, volatile_load(0x3FF48030) & 0x27FFFFFF)
    rom_delay_us(1)
    // force_txrxoff(1), preserving the three separate transitions.
    volatile_store(0x3FF460A0, (volatile_load(0x3FF460A0) & 0xFFFFCFFF) | 0x2000)
    rom_delay_us(1)
    volatile_store(0x3FF460A0, (volatile_load(0x3FF460A0) & 0xFFFFF3FF) | 0x800)
    rom_delay_us(1)
    volatile_store(0x3FF460A0, (volatile_load(0x3FF460A0) & 0xFFFFFCFF) | 0x200)
    rom_delay_us(1)
    if !phy_cal_hw_frequency_disable() { << false }
    volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) & 0xFFFFFEFF)
    // Native waits 3 us for a busy host before resetting that host alone.
    // Preserve the conditional reset; bound its formerly unbounded tail.
    mhz := rom_cpu_mhz()
    if mhz < 1 || mhz > 240 { << false }
    reset_wait := mhz * 3
    for host in 0:5 {
        started := irq_rom_cycle_count()
        $elapsed := 0
        while (phy_cal_i2c_master(host) & 0x02000000) != 0 && elapsed < reset_wait {
            elapsed = (irq_rom_cycle_count() - started) & 0x7FFFFFFF
        }
        if (phy_cal_i2c_master(host) & 0x02000000) != 0 {
            phy_cal_i2c_command(host, 0)
            if !phy_cal_i2c_wait(host) { << false }
        }
    }
    << true
}
