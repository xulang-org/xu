@embedded/chips/esp32

fn phy_cal_sequence_word(index int, word int) {
    volatile_store(0x3FF45038, word)
    volatile_store(0x3FF45034, (volatile_load(0x3FF45034) & 0xFFFC00FF) | ((0x200 + index) << 8))
    volatile_store(0x3FF45034, volatile_load(0x3FF45034) & 0xFFFCFFFF)
}

// ram_set_pbus_mem's complete Wi-Fi/BT RX/TX/PA transition microsequences.
// These are PHY register commands generated by Xu, not executable machine
// code imported from an archive. Call while controller events/IRQs are off.
pub fn phy_cal_pbus_memory_init() bool {
    if !phy_cal_hw_frequency_disable() { << false }
    // Match native ram_set_pbus_mem: install one selector half, then
    // upload that group before changing the next selector half.
    // wifi_rx_on, words 0..3.
    volatile_store(0x3FF46030, (volatile_load(0x3FF46030) & 0xFFFF0000) | 0x00000300)
    phy_cal_sequence_word(0, 0x000709FF)
    phy_cal_sequence_word(1, 0x001713FF)
    phy_cal_sequence_word(2, 0x00F50000)
    phy_cal_sequence_word(3, 0x00F60000)
    // wifi_rx_off, words 4..5.
    volatile_store(0x3FF46030, (volatile_load(0x3FF46030) & 0x0000FFFF) | 0x05040000)
    phy_cal_sequence_word(4, 0x000401FF)
    phy_cal_sequence_word(5, 0x001401FF)
    // wifi_tx_on, words 6..10.
    volatile_store(0x3FF46034, (volatile_load(0x3FF46034) & 0xFFFF0000) | 0x00000A06)
    phy_cal_sequence_word(6, 0x000403FF)
    phy_cal_sequence_word(7, 0x0014F9FF)
    phy_cal_sequence_word(8, 0x00F00000)
    phy_cal_sequence_word(9, 0x00F10000)
    phy_cal_sequence_word(10, 0x00F20000)
    // wifi_tx_off, words 11..12.
    volatile_store(0x3FF46034, (volatile_load(0x3FF46034) & 0x0000FFFF) | 0x0C0B0000)
    phy_cal_sequence_word(11, 0x000401FF)
    phy_cal_sequence_word(12, 0x001401FF)
    // wifi_pa_on, words 13..14.
    volatile_store(0x3FF46038, (volatile_load(0x3FF46038) & 0xFFFF0000) | 0x00000E0D)
    phy_cal_sequence_word(13, 0x0044FFFF)
    phy_cal_sequence_word(14, 0x00F30000)
    // wifi_pa_off, words 15..16.
    volatile_store(0x3FF46038, (volatile_load(0x3FF46038) & 0x0000FFFF) | 0x100F0000)
    phy_cal_sequence_word(15, 0x004401FF)
    phy_cal_sequence_word(16, 0x005401FF)
    // bt_rx_on, words 17..20.
    volatile_store(0x3FF4603C, (volatile_load(0x3FF4603C) & 0xFFFF0000) | 0x00001411)
    phy_cal_sequence_word(17, 0x000709FF)
    phy_cal_sequence_word(18, 0x001717FF)
    phy_cal_sequence_word(19, 0x00F50000)
    phy_cal_sequence_word(20, 0x00F60000)
    // bt_rx_off, words 21..22.
    volatile_store(0x3FF4603C, (volatile_load(0x3FF4603C) & 0x0000FFFF) | 0x16150000)
    phy_cal_sequence_word(21, 0x000401FF)
    phy_cal_sequence_word(22, 0x001401FF)
    // bt_tx_on, words 23..27.
    volatile_store(0x3FF46040, (volatile_load(0x3FF46040) & 0xFFFF0000) | 0x00001B17)
    phy_cal_sequence_word(23, 0x000403FF)
    phy_cal_sequence_word(24, 0x0014FDFF)
    phy_cal_sequence_word(25, 0x00F00000)
    phy_cal_sequence_word(26, 0x00F10000)
    phy_cal_sequence_word(27, 0x00F20000)
    // bt_tx_off, words 28..29.
    volatile_store(0x3FF46040, (volatile_load(0x3FF46040) & 0x0000FFFF) | 0x1D1C0000)
    phy_cal_sequence_word(28, 0x000401FF)
    phy_cal_sequence_word(29, 0x001401FF)
    // bt_pa_on, words 30..31.
    volatile_store(0x3FF46044, (volatile_load(0x3FF46044) & 0xFFFF0000) | 0x00001F1E)
    phy_cal_sequence_word(30, 0x0044FFFF)
    phy_cal_sequence_word(31, 0x00F30000)
    // bt_pa_off, words 32..33.
    volatile_store(0x3FF46044, (volatile_load(0x3FF46044) & 0x0000FFFF) | 0x21200000)
    phy_cal_sequence_word(32, 0x004401FF)
    phy_cal_sequence_word(33, 0x005401FF)
    << volatile_load(0x3FF46030) == 0x05040300 &&
        volatile_load(0x3FF46040) == 0x1D1C1B17 &&
        volatile_load(0x3FF46044) == 0x21201F1E &&
        (volatile_load(0x3FF45034) & 0x30000) == 0
}
