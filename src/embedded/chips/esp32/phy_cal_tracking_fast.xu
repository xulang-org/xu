@embedded/chips/esp32

// Runtime PLL tracking only: the caller already owns all maskable IRQs
// and the hardware frequency hold. Calibration keeps the general I2C path.
// Specialize block 62 / host 1 / register 5 so a radio ISR does not repeat
// generic host dispatch, IRQ locking, slave selection or frequency gating.
fn phy_tracking_i2c_wait() bool {
    for i in 0:1000 {
        if (volatile_load(0x3FF4E004) & 0x02000000) == 0 { << true }
    }
    volatile_store(0x3FFD7400, 1)
    << false
}

fn phy_tracking_read_direction() int {
    if (volatile_load(0x3FF4E0C4) & 0x02000000) == 0 { << -1 }
    volatile_store(0x3FF4E044, (volatile_load(0x3FF4E044) & 0xFFFC00FF) | 0x3F000)
    volatile_store(0x3FF4E044, volatile_load(0x3FF4E044) & 0xFFFFF7FF)
    if (volatile_load(0x3FF4E044) & 0x800) != 0 {
        volatile_store(0x3FFD7400, 3)
        << -1
    }
    if !phy_tracking_i2c_wait() { << -1 }
    volatile_store(0x3FF4E004, 0x562)
    if !phy_tracking_i2c_wait() { << -1 }
    << (volatile_load(0x3FF4E004) >> 16) & 255
}
