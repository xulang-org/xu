@embedded/chips/esp32

// ESP32 UART0 Console Driver

pub fn uart_write_char(ch int) {
    while ((volatile_load(UART0_STATUS_REG) >> 16) & 0xFF) >= 120 {}
    volatile_store(UART0_FIFO_REG, ch & 0xFF)
}

pub fn uart_rx_available() bool {
    << (volatile_load(UART0_STATUS_REG) & 0xFF) > 0
}

pub fn uart_read_char() int {
    if (volatile_load(UART0_STATUS_REG) & 0xFF) > 0 {
        << volatile_load(UART0_FIFO_REG) & 0xFF
    }
    << -1
}

pub fn uart_write(s string) {
    for i in 0:s.len {
        ch := s[i]
        if ch == 10 {
            uart_write_char(13)
        }
        uart_write_char(ch)
    }
}

pub fn uart_print(s string) {
    uart_write(s)
}

pub fn uart_println(s string) {
    uart_write(s)
    uart_write_char(13)
    uart_write_char(10)
}

pub fn uart_print_int(n int) {
    if n == 0 {
        uart_write_char(48)
        <<
    }
    $v := n
    if v < 0 {
        uart_write_char(45) // '-'
        v = -v
    }
    $div := 1
    while (v / div) >= 10 {
        div = div * 10
    }
    while div > 0 {
        digit := (v / div) % 10
        uart_write_char(48 + digit)
        div = div / 10
    }
}

pub fn uart_println_int(n int) {
    uart_print_int(n)
    uart_write_char(13)
    uart_write_char(10)
}

pub fn uart_print_hex(n int) {
    uart_write("0x")
    $shift := 28
    while shift >= 0 {
        nibble := (n >> shift) & 0xF
        if nibble < 10 {
            uart_write_char(48 + nibble)
        } else {
            uart_write_char(65 + (nibble - 10))
        }
        shift = shift - 4
    }
}
