@embedded/chips/esp32

// BT-only runtime PLL-cap tracking, ported from libphy's bt_track_pll_cap,
// pll_correct_dcap, phy_dis_hw_set_freq and phy_en_hw_set_freq.
// The calibration driver owns the commit at 3FFD7780: write TRACKING_READY
// only after complete TX RF/channel-table initialization and readback pass.
// This runtime PLL marker does not authorize receiving or BLE connections.
// PLL1 alone only validates the PLL sweep, not the remaining PHY work.
pub const PHY_TRACKING_READY = 0x5452414B

pub fn phy_tracking_is_ready() bool {
    << volatile_load(0x3FFD7418) == 0x504C4C31 &&
        (volatile_load(0x3FFD741C) & 1) != 0 &&
        volatile_load(0x3FFD7780) == PHY_TRACKING_READY
}

pub fn phy_tracking_error() int { << volatile_load(0x3FFD7784) }
pub fn phy_tracking_count() int { << volatile_load(0x3FFD7788) }

// Hold software frequency programming against the hardware sequencer. The
// vendor waits forever; a bounded wait reports a fault instead of hanging ISR.
fn phy_tracking_hold_frequency() bool {
    mhz := rom_cpu_mhz()
    if mhz < 1 || mhz > 240 { << false }
    wait_limit := mhz * 2000
    started := irq_rom_cycle_count()
    $elapsed := 0
    // The native wait is unbounded. Use a 2 ms implementation limit,
    // measured using the ROM's CPU-frequency calibration.
    // A 100-iteration delay budget could reject a normal active switch.
    while elapsed < wait_limit {
        if (volatile_load(0x3FF4E168) & 0x80000000) == 0 ||
            (volatile_load(0x3FF4E0C4) & 0x100) != 0 {
            // Lock immediately after the idle observation. A second status
            // check after diagnostics can see the next automatic switch
            // and falsely fail even with elapsed == 0.
            volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) | 0x02000000)
            volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) & 0xFFFFFEFF)
            rom_delay_us(2)
            volatile_store(0x3FFD7794, elapsed)
            if elapsed > volatile_load(0x3FFD7798) { volatile_store(0x3FFD7798, elapsed) }
            << true
        }
        rom_delay_us(1)
        elapsed = (irq_rom_cycle_count() - started) & 0x7FFFFFFF
    }
    volatile_store(0x3FFD7794, elapsed)
    if elapsed > volatile_load(0x3FFD7798) { volatile_store(0x3FFD7798, elapsed) }
    << false
}

fn phy_tracking_release_frequency() {
    volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) & 0xFDFFFFFF)
    volatile_store(0x3FF5C07C, (volatile_load(0x3FF5C07C) & 0xFF00FFFF) | 0x009C0000)
}

pub fn phy_bt_track_pll_cap() bool {
    if !phy_tracking_is_ready() {
        volatile_store(0x3FFD7784, 1)
        << false
    }
    saved := irq_rom_mask(0 - 1)
    // Exactly the BT-mode guard in the original routine. The pure-BLE
    // binding does not offer Wi-Fi force-channel or software-channel modes.
    if (volatile_load(0x3FF5D008) & 0x20000000) == 0 {
        irq_rom_unmask(saved)
        << true
    }
    frequency := (volatile_load(0x3FF4E168) >> 24) & 0x7F
    if !phy_tracking_hold_frequency() {
        volatile_store(0x3FFD7784, 2)
        irq_rom_unmask(saved)
        << false
    }
    direction := phy_tracking_read_direction()
    // Native pll_correct_dcap reads through the runtime chip-I2C helper.
    // That nested read releases hardware frequency programming before the
    // cap-memory update. Keep this release here as well as the final one;
    // the Xu ISR must preserve that boundary.
    phy_tracking_release_frequency()
    if direction < 0 || phy_cal_i2c_error() != 0 {
        volatile_store(0x3FFD7784, 4)
        irq_rom_unmask(saved)
        << false
    }
    $delta := 0
    if (direction & 2) != 0 { delta = -1 }
    else if (direction & 1) != 0 { delta = 1 }
    if delta != 0 {
        volatile_store(0x3FF4E0C4,
            (volatile_load(0x3FF4E0C4) & 0xFFFFFF00) | ((frequency * 3) & 0xFF))
        memory := volatile_load(0x3FF4E0C0)
        cap := (memory + delta) & 0xFF
        updated := ((((memory >> 24) + delta) & 0xFF) << 24) |
            (memory & 0x00FFFF00) | cap
        volatile_store(0x3FF4E148, updated)
        volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) | 0x200)
        volatile_store(0x3FF4E0C4, volatile_load(0x3FF4E0C4) & 0xFFFFFDFF)
        volatile_store(0x3FFD7790, cap)
    }
    // This Xu port currently implements PLL tracking only. The working
    // C phase2 explicitly enables its TX-power temperature tracking; that
    // separate algorithm has not been ported or claimed here.
    phy_tracking_release_frequency()
    volatile_store(0x3FFD7788, volatile_load(0x3FFD7788) + 1)
    volatile_store(0x3FFD778C, delta)
    irq_rom_unmask(saved)
    << true
}
