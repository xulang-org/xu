@embedded/chips/esp32

// Fixed-profile Wi-Fi/BLE cold-start handoff. This does not allocate
// protocol state or perform dynamic software priority scheduling.
// Call after Wi-Fi association and controller_init, before any BLE event or
// CPU4/8 source is enabled. The caller must not retune either radio concurrently.
// Source-bound native write_wifi_chan_data / bt_i2c_set_wifi_data evidence:
// ev_c00ea65d6b1f0e5fe623a00394bb0fc1529bddd44406dd46e6fe26633988522c
// ev_faa7fe328e0ce4d7db7b80f522b60c37f79e0e6183c17c53818508ff98f346fa
fn wifi_coexist_frequency_prepare(channel int) bool {
    if channel < 1 || channel > 14 || phy_cal_i2c_error() != 0 ||
        volatile_load(0x3FFD7418) != 0x504C4C31 ||
        volatile_load(0x3FFB9704) != 0 ||
        (volatile_load(0x3FF73D20) & 0xC0000000) != 0 ||
        ((volatile_load(0x3FF4E0C4) >> 10) & 31) != 11 ||
        volatile_load(0x3FF4E164) != 1 ||
        volatile_load(0x3FF4E100) != 0x110 { << false }
    // Stop reception without rebuilding/recycling the already-owned DMA chain.
    // As in stop_engines, allow the previously started PPDU to finish first.
    rx_filter := volatile_load(0x3FF73064) & 0x10000
    rx_enable := volatile_load(0x3FF73084) & 0x80000000
    volatile_store(0x3FF73064,volatile_load(0x3FF73064) & 0xFFFEFFFF)
    volatile_store(0x3FF73084,volatile_load(0x3FF73084) & 0x7FFFFFFF)
    rom_delay_us(25000)
    if !phy_cal_hw_frequency_disable() { << false }
    // The table index is MHz above 2400, not the 802.11 channel number.
    $frequency := 2412 + (channel - 1) * 5
    if channel == 14 { frequency = 2484 }
    index := (frequency - 2400) * 3
    volatile_store(0x3FF4E0C4,(volatile_load(0x3FF4E0C4) & 0xFFFFFF00) | index)
    w0 := volatile_load(0x3FF4E0C0)
    volatile_store(0x3FF4E0C4,(volatile_load(0x3FF4E0C4) & 0xFFFFFF00) | (index + 1))
    w1 := volatile_load(0x3FF4E0C0)
    volatile_store(0x3FF4E0C4,(volatile_load(0x3FF4E0C4) & 0xFFFFFF00) | (index + 2))
    w2 := volatile_load(0x3FF4E0C0)
    // Preserve bt_get_i2c_data's native start/reset byte, including bit7.
    reset := (volatile_load(0x3FF4E0C8) >> 16) & 255
    if (reset & 0xE0) != 0xA0 { << false }
    restore0 := 0x07000000 | ((w0 & 0xFFFF) << 8)
    restore1 := 0x17000000 | ((w1 & 0xFFFF) << 8) | ((w1 >> 16) & 255)
    restore2 := reset | ((w2 & 0xFFFF) << 8)
    volatile_store(0x3FF4E130,restore0)
    volatile_store(0x3FF4E134,restore1)
    volatile_store(0x3FF4E138,(volatile_load(0x3FF4E138) & 0xFF000000) | restore2)
    if volatile_load(0x3FF4E130) != restore0 ||
        volatile_load(0x3FF4E134) != restore1 ||
        (volatile_load(0x3FF4E138) & 0xFFFFFF) != restore2 { << false }
    phy_cal_hw_frequency_enable()
    // Hardware PTA with BT priority, never a force_wifi/force_bt override.
    // coex_bt_high_prio: ev_0d75b526f9f21994352f77ae2674f837ebe997105b9a59a51c11b52a9ffe0ebd.
    if !phy_cal_bt_priority() || (volatile_load(0x3FF4E0C4) & 0x02000000) != 0 {
        << false
    }
    volatile_store(0x3FF73084,(volatile_load(0x3FF73084) & 0x7FFFFFFF) | rx_enable)
    volatile_store(0x3FF73064,(volatile_load(0x3FF73064) & 0xFFFEFFFF) | rx_filter)
    << true
}

pub fn wifi_phy_coexist_enable(channel int) bool {
    if channel < 1 || channel > 14 { << false }
    saved_level := irq_rom_set_level(15)
    saved_mask := irq_rom_mask(0 - 1)
    $ok := false
    if (saved_mask & 0x110) == 0 { ok = wifi_coexist_frequency_prepare(channel) }
    irq_rom_unmask(saved_mask)
    irq_rom_set_level(saved_level)
    << ok
}

// Cache-off flash work requires BLE disconnected, advertising stopped, the
// event list empty and all PRO IRQs masked by the caller. Pause DMA without
// revoking the station lease/keys; the caller must resume with this token.
pub fn wifi_coexist_pause_receive() int {
    if irq_rom_mask(0) != 0 || volatile_load(0x3FFB9704) != 0 ||
        (volatile_load(0x3FF73D20) & 0xC0000000) != 0 ||
        (volatile_load(0x3FF000A8) & 0x60) != 0 { << -1 }
    $saved := 0
    if (volatile_load(0x3FF73064) & 0x10000) != 0 { saved = saved | 1 }
    if (volatile_load(0x3FF73084) & 0x80000000) != 0 { saved = saved | 2 }
    volatile_store(0x3FF73064,volatile_load(0x3FF73064) & 0xFFFEFFFF)
    volatile_store(0x3FF73084,volatile_load(0x3FF73084) & 0x7FFFFFFF)
    rom_delay_us(25000)
    if (volatile_load(0x3FF73D20) & 0xC0000000) != 0 { << -1 }
    << saved
}

pub fn wifi_coexist_resume_receive(saved int) bool {
    if saved < 0 || saved > 3 || irq_rom_mask(0) != 0 ||
        (volatile_load(0x3FF000A8) & 0x60) != 0 { << false }
    $filter := 0
    $receive := 0
    if (saved & 1) != 0 { filter = 0x10000 }
    if (saved & 2) != 0 { receive = 0x80000000 }
    volatile_store(0x3FF73084,(volatile_load(0x3FF73084) & 0x7FFFFFFF) | receive)
    volatile_store(0x3FF73064,(volatile_load(0x3FF73064) & 0xFFFEFFFF) | filter)
    << (volatile_load(0x3FF73084) & 0x80000000) == receive &&
        (volatile_load(0x3FF73064) & 0x10000) == filter
}
