@embedded/chips/esp32

// ESP32 Delay & Timing Utilities

pub fn delay_cycles(cycles int) {
    $c := cycles
    while c > 0 {
        c = c - 1
    }
}

pub fn delay_us(us int) {
    $u := us
    while u > 0 {
        $c := 27
        while c > 0 {
            c = c - 1
        }
        u = u - 1
    }
}

pub fn delay_ms(ms int) {
    $m := ms
    while m > 0 {
        delay_us(1000)
        m = m - 1
    }
}
