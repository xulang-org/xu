@embedded/chips/esp32

// Native ram_pbus_force_mode, installed in PHY table slot +AC. The
// retained ROM helper omits FE 4609C.bit27; live C/Xu snapshots differed
// by exactly that bit after calibration. Both mode transitions clear it.
fn phy_cal_pbus_mode(force int) int {
    if force != 0 {
        volatile_store(0x3FF4609C, volatile_load(0x3FF4609C) & 0xF7FFFFFF)
        volatile_store(0x3FF46094, volatile_load(0x3FF46094) | 1)
        << 0
    }
    volatile_store(0x3FF46094, volatile_load(0x3FF46094) & 0xFFFFFFFE)
    volatile_store(0x3FF4609C, volatile_load(0x3FF4609C) & 0xF7FFFFFF)
    if (volatile_load(0x3FF00024) & 2) != 0 {
        rom_delay_us(1)
        volatile_store(0x3FF5C02C, (volatile_load(0x3FF5C02C) & 0x00FFFFFF) | 0x32000000)
        volatile_store(0x3FF5C02C, volatile_load(0x3FF5C02C) | 0x00800000)
        rom_delay_us(2)
        volatile_store(0x3FF5C02C, volatile_load(0x3FF5C02C) & 0xFF7FFFFF)
    }
    << 0
}
