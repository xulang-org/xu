@embedded/chips/esp32

// The ESP32 mask-ROM level-1 exception dispatcher preserves the interrupted
// register window and returns with RFE. Its handlers use the windowed ABI:
// pass rom_callback(named_scalar_function), never an ordinary Xu fn value.
// VECBASE must be 0x40000000 and PS.UM must be set before enabling a source.
// These entry points are for PRO CPU 0, not the APP CPU or IDF's own vectors.

pub fn irq_rom_mask(mask int) int {
    << rom_call6(0x4000BFAC, mask, 0, 0, 0, 0, 0)
}

pub fn irq_rom_unmask(mask int) int {
    << rom_call6(0x4000BF88, mask, 0, 0, 0, 0, 0)
}

pub fn irq_rom_set_level(level int) int {
    << rom_call6(0x4000BFDC, level & 15, 0, 0, 0, 0, 0)
}

// CPU 4 is a level-1 external level interrupt, used by RWBT/RWBLE sources.
// ROM indexes its handler table in reverse CPU-interrupt order.
pub fn irq_rom_attach_bt(callback_address int, context int) bool {
    if callback_address < 0x400D0000 || callback_address >= 0x40400000 ||
        callback_address % 4 != 0 { << false }
    rom_call6(0x4000BF34, 4, callback_address, context, 0, 0, 0)
    << volatile_load(0x3FFE0730) == callback_address &&
        volatile_load(0x3FFE0734) == context
}

// CPU 6 is CCOMPARE0, a level-1 timer interrupt. The hardware source is
// acknowledged by writing a new CCOMPARE0 value, not by raise_irq().
pub fn irq_rom_attach_timer0(callback_address int, context int) bool {
    if callback_address < 0x400D0000 || callback_address >= 0x40400000 ||
        callback_address % 4 != 0 { << false }
    rom_call6(0x4000BF34, 6, callback_address, context, 0, 0, 0)
    << volatile_load(0x3FFE0720) == callback_address &&
        volatile_load(0x3FFE0724) == context
}

pub fn irq_rom_timer0_arm(cycle_count int) {
    rom_call6(0x4000C058, 0, cycle_count, 0, 0, 0, 0)
}

pub fn irq_rom_cycle_count() int {
    << rom_call6(0x4000C050, 0, 0, 0, 0, 0, 0)
}

pub fn irq_rom_pending() int {
    << rom_call6(0x4000C1E4, 0, 0, 0, 0, 0, 0)
}

// RAM intc.o's r_rwbtdm_isr calls the ROM BLE and BR/EDR handlers in this
// order. Both inspect/acknowledge their own peripheral status, so sharing
// one CPU level input is valid (the IDF wrapper does this on CPU IRQ 5).
// The controller task consumes the work flag outside the interrupt frame.
// State: count 3FFD73D0, pending work 3FFD73D4, last CPU pending 3FFD73D8.
// Never enable this before complete LL/RF/platform table initialization.
pub fn bt_irq_rom_service() int {
    started := irq_rom_cycle_count()
    saved := irq_rom_mask(0 - 1)
    volatile_store(0x3FFD73D0, volatile_load(0x3FFD73D0) + 1)
    volatile_store(0x3FFD73D8, irq_rom_pending())
    // Observe the exact ISR input before either native handler acknowledges
    // it. ROM 40054E0B/4005527C load literals 3FF71210/3FF71010.
    // 7120C is initialized to 0x33A by native LLD init; 71214 is retained
    // as a separate raw-register snapshot, not substituted for ISR status.
    ble_status := volatile_load(0x3FF71210)
    volatile_store(0x3FFD73A0, volatile_load(0x3FFD73A0) | ble_status)
    volatile_store(0x3FFD73A4, volatile_load(0x3FFD73A4) | volatile_load(0x3FF71214))
    volatile_store(0x3FFD73A8, volatile_load(0x3FF7120C))
    volatile_store(0x3FFD73AC, volatile_load(0x3FFD73AC) | volatile_load(0x3FF71010))
    // These meanings come from actual ROM dispatch, not inferred names:
    // bit3 -> r_lld_evt_end_isr(0), bit8 -> the same handler with (1),
    // bit1 -> r_lld_evt_rx_isr(), bit7 -> r_ea_finetimer_isr().
    if (ble_status & 8) != 0 {
        volatile_store(0x3FFD73B0, volatile_load(0x3FFD73B0) + 1)
    }
    if (ble_status & 0x100) != 0 {
        volatile_store(0x3FFD73B4, volatile_load(0x3FFD73B4) + 1)
    }
    if (ble_status & 2) != 0 {
        volatile_store(0x3FFD73B8, volatile_load(0x3FFD73B8) + 1)
    }
    if (ble_status & 0x80) != 0 {
        volatile_store(0x3FFD73BC, volatile_load(0x3FFD73BC) + 1)
    }
    // Retain unclassified bit0/bit2 observations and error bit5 separately
    // from BTBB state. Fine-timer dispatch is BLE bit7 (above), and RWBT
    // bit9 can also drive EA; a zero bit0 count says nothing about LL clocks.
    if (ble_status & 1) != 0 {
        volatile_store(0x3FFD71C0, volatile_load(0x3FFD71C0) + 1)
    }
    if (ble_status & 4) != 0 {
        volatile_store(0x3FFD71C4, volatile_load(0x3FFD71C4) + 1)
    }
    if (ble_status & 0x20) != 0 {
        volatile_store(0x3FFD71C8, volatile_load(0x3FFD71C8) + 1)
        error := volatile_load(0x3FF71260)
        volatile_store(0x3FFD71CC, volatile_load(0x3FFD71CC) | error)
        volatile_store(0x3FFD71D4, error)
    }
    irq_ble_rx_before_end(ble_status)
    rom_call6(0x40054E08, 0, 0, 0, 0, 0, 0) // r_rwble_isr
    rom_call6(0x40055248, 0, 0, 0, 0, 0, 0) // r_rwbt_isr
    volatile_store(0x3FFD73D4, 1)
    irq_timing_record_ble(started)
    irq_rom_unmask(saved)
    << 0
}

// Attaching and enabling are separate: bringing up the controller can bind
// its tables while all link-layer interrupt sources remain masked.
pub fn bt_irq_rom_attach() bool {
    irq_rom_mask(16)
    if volatile_load(0x3FFAE70C) != 0x3FFAE710 ||
        volatile_load(0x3FFAF278) != 0x40054E08 ||
        volatile_load(0x3FFAF288) != 0x40055248 { << false }
    volatile_store(0x3FFD73A0, 0)
    volatile_store(0x3FFD73A4, 0)
    volatile_store(0x3FFD73A8, 0)
    volatile_store(0x3FFD73AC, 0)
    volatile_store(0x3FFD73B0, 0)
    volatile_store(0x3FFD73B4, 0)
    volatile_store(0x3FFD73B8, 0)
    volatile_store(0x3FFD73BC, 0)
    rom_call6(0x4000C44C, 0x3FFD71C0, 0, 64, 0, 0, 0)
    volatile_store(0x3FFD73D0, 0)
    volatile_store(0x3FFD73D4, 0)
    volatile_store(0x3FFD73D8, 0)
    volatile_store(0x3FFD77A0, 0)
    volatile_store(0x3FFD77A4, 0)
    rom_call6(0x4000C44C, 0x3FFD77B0, 0, 24, 0, 0, 0)
    if !irq_rom_attach_bt(rom_callback(bt_irq_rom_service), 0) { << false }
    bt_interrupt_route()
    << (volatile_load(0x3FF0011C) & 31) == 4 &&
        (volatile_load(0x3FF00120) & 31) == 4
}

pub fn bt_irq_rom_enable() bool {
    expected := rom_callback(bt_irq_rom_service)
    if volatile_load(0x3FFE0730) != expected ||
        (volatile_load(0x3FF0011C) & 31) != 4 ||
        (volatile_load(0x3FF00120) & 31) != 4 { << false }
    irq_rom_unmask(16)
    << true
}

pub fn bt_irq_rom_disable() {
    irq_rom_mask(16)
}

pub fn bt_irq_rom_count() int { << volatile_load(0x3FFD73D0) }

pub fn bt_irq_rom_take_work() bool {
    previous := irq_rom_mask(16)
    pending := volatile_load(0x3FFD73D4)
    volatile_store(0x3FFD73D4, 0)
    irq_rom_unmask(previous & 16)
    << pending != 0
}
