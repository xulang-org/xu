@embedded/chips/esp32/wifi_rx_layout

// Decode one completed, owned ESP32 Wi-Fi RX DMA snapshot. The caller must
// already have checked descriptor ownership/completion, capacity, RX buffer
// identity and sentinels. This helper performs no MMIO and allocates no packet
// storage. It models the measured DMA profile that strips the four-byte FCS.
pub struct Layout {
    pub valid bool // bounded layout and selected hardware status == 0
    pub bounded bool // selected frame and zero word padding fit exactly
    pub status int // selected hardware state; -1 if no safe selection exists
    pub frame_offset int
    pub frame_length int // excludes the hardware-stripped FCS
    pub csi_length int // effective aligned CSI bytes; zero after bug case 2
    pub bug_case int // -1: no CSI; 0/1/2: native selection; 3: rejected bug
}

fn invalid(bug_case int) Layout {
    << Layout{valid: false, bounded: false, status: -1, frame_offset: 0,
        frame_length: 0, csi_length: 0, bug_case: bug_case}
}

// Decode the two 12-bit length fields without building a signed 32-bit word.
fn first_length(raw &string, at int) int {
    << raw[at] | ((raw[at + 1] & 15) << 8)
}

fn second_length(raw &string, at int) int {
    << (raw[at + 1] >> 4) | (raw[at + 2] << 4)
}

pub fn parse_owned_packet(raw &string) Layout {
    if raw.len < 28 || raw.len > 2652 { << invalid(-1) }
    // wdev_csi_len_align: word at +20, bits 8..17, rounded up to 4.
    reported_csi := raw[21] | ((raw[22] & 3) << 8)
    $csi := ((reported_csi + 3) / 4) * 4
    $vector := 24
    $frame := 28
    $bug := -1
    if reported_csi != 0 {
        shifted := 24 + csi
        if shifted > raw.len - 4 { << invalid(-1) }
        a := first_length(raw,24)
        b := second_length(raw,24)
        c := first_length(raw,shifted)
        d := second_length(raw,shifted)
        // Exact reduction of wdev_csi_hw_bug_check. The +8 comparisons
        // are ordinary additions, not arithmetic modulo 4096.
        if (a == b && a != 0) || a == b + 8 {
            if a == c { bug = 1 }
            else { bug = 2 }
        } else {
            if c == d || c == d + 8 { bug = 0 }
            else { << invalid(3) }
        }
        if bug == 0 { vector = shifted }
        if bug == 2 { csi = 0 }
        frame += csi
    }
    signal_length := first_length(raw,vector)
    if signal_length < 28 { << invalid(bug) }
    length := signal_length - 4
    if length > 1600 { << invalid(bug) }
    if frame > raw.len || length > raw.len - frame { << invalid(bug) }
    end := frame + length
    expected := ((end + 3) / 4) * 4
    if expected != raw.len { << invalid(bug) }
    for i in end:raw.len { if raw[i] != 0 { << invalid(bug) } }
    state := raw[vector + 3]
    << Layout{valid: state == 0, bounded: true, status: state,
        frame_offset: frame, frame_length: length, csi_length: csi, bug_case: bug}
}
