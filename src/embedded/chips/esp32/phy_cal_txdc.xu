@embedded/chips/esp32

// Bounded Xu port of ram_pbus_force_test. ROM PHY operations call this
// through the existing +0xB8 slot; hardware address/command encoding is
// unchanged. Error 12 means the PBUS transaction did not finish in 1 ms.
fn phy_cal_pbus_force(no int, bus int, value int) int {
    if no < 0 || no > 15 || bus < 0 || bus > 3 || value < 0 || value > 511 {
        volatile_store(0x3FFD7400, 13)
        << 1
    }
    command := (((value << 6) | (no << 2) | (bus << 15)) & 0x1FFFC) | 2 |
        (volatile_load(0x3FF46094) & 0xFFFE0001)
    volatile_store(0x3FF46094, command)
    $ready := false
    $i := 0
    while i < 1000 && !ready {
        if (volatile_load(0x3FF460A0) & 0x80000000) == 0 {
            ready = true
        } else {
            rom_delay_us(1)
            i = i + 1
        }
    }
    volatile_store(0x3FF46094, volatile_load(0x3FF46094) & 0xFFFFFFFD)
    if !ready {
        volatile_store(0x3FFD7400, 12)
        << 1
    }
    << 0
}

pub fn phy_cal_install_pbus() bool {
    entry := rom_callback(phy_cal_pbus_force)
    old := volatile_load(0x3FFAE17C)
    mode_entry := rom_callback(phy_cal_pbus_mode)
    old_mode := volatile_load(0x3FFAE170)
    if old != 0x400043C0 && old != entry { << false }
    if old_mode != 0x40004270 && old_mode != mode_entry { << false }
    volatile_store(0x3FFAE17C, entry)
    volatile_store(0x3FFAE170, mode_entry)
    << volatile_load(0x3FFAE17C) == entry && volatile_load(0x3FFAE170) == mode_entry
}

fn phy_cal_dc_comparator() int {
    volatile_store(0x3FF4E04C, (volatile_load(0x3FF4E04C) & 0xFF000000) | 0x113CF1)
    volatile_store(0x3FF4E04C, (volatile_load(0x3FF4E04C) & 0xFF000000) | 0x113CF3)
    for i in 0:1000 {
        value := volatile_load(0x3FF4E04C)
        if (value & 0x01000000) != 0 { << value }
        rom_delay_us(1)
    }
    volatile_store(0x3FFD7400, 9)
    << 0
}

// ram_txdc_cal_v70's two stages, twelve successive-approximation trials
// each, averaging the final four comparator-derived settings. Retain the
// actual four nine-bit trims at 0x3FFD7450/7454.
fn phy_cal_dc_trim() bool {
    phy_cal_pbus_force(2, 2, 256)
    phy_cal_pbus_force(3, 2, 256)
    $ok := true
    $stage := 1
    while stage < 3 && ok {
        $idc := 256
        $qdc := 256
        $step := 124
        $isum := 0
        $qsum := 0
        $trial := 0
        while trial < 12 && ok {
            phy_cal_pbus_force(3, stage, qdc)
            phy_cal_pbus_force(2, stage, idc)
            rom_delay_us(2)
            status := phy_cal_dc_comparator()
            if phy_cal_i2c_error() != 0 {
                ok = false
            } else {
                if (status & 0x80000000) != 0 { idc = idc - step }
                else { idc = idc + step }
                if idc < 0 { idc = 0 }
                if idc > 511 { idc = 511 }
                if (status & 0x40000000) != 0 { qdc = qdc - step }
                else { qdc = qdc + step }
                if qdc < 0 { qdc = 0 }
                if qdc > 511 { qdc = 511 }
                if step == 2 { step = 1 }
                else { step = (step >> 1) + 1 }
                if trial > 7 {
                    isum = isum + idc
                    qsum = qsum + qdc
                }
                trial = trial + 1
            }
        }
        if ok {
            avg_i := (isum + 2) >> 2
            avg_q := (qsum + 2) >> 2
            phy_cal_pbus_force(3, stage, avg_q)
            phy_cal_pbus_force(2, stage, avg_i)
            packed := avg_i | (avg_q << 16)
            if stage == 1 { volatile_store(0x3FFD7450, packed) }
            else { volatile_store(0x3FFD7454, packed) }
            stage = stage + 1
        }
    }
    volatile_store(0x3FF4E04C, (volatile_load(0x3FF4E04C) & 0xFF000000) | 0x113CF0)
    << ok && phy_cal_i2c_error() == 0
}

pub fn phy_cal_txdc_bt() bool {
    if volatile_load(0x3FFD7418) != 0x504C4C31 ||
        (volatile_load(0x3FFD741C) & 3) != 3 || phy_cal_i2c_error() != 0 { << false }
    if !phy_cal_hw_frequency_disable() || !phy_cal_install_pbus() { << false }
    rom_call6(0x40004458, 0, 0, 0, 0, 0, 0) // pbus_debugmode
    // ram_pbus_xpd_tx_on(0x5F, 0x120), the native default RF gains.
    volatile_store(0x3FFD7420, 0x01000100)
    volatile_store(0x3FFD7424, 0x01000100)
    rom_call6(0x40004638, 0x3FFD7420, 0, 0, 0, 0, 0)
    phy_cal_pbus_force(0, 1, 1)
    phy_cal_pbus_force(1, 1, 0x7C)
    phy_cal_pbus_force(1, 2, 0x120)
    phy_cal_pbus_force(4, 1, 0x7F)
    phy_cal_pbus_force(5, 1, 0x5F)
    active := rom_call6(0x40004414, 1, 1, 0, 0, 0, 0)
    phy_cal_pbus_force(1, 1, active | 2)
    $gain := 0
    $ok := true
    while gain < 3 && ok {
        $bb := 0
        if gain == 1 { bb = 0x20 }
        else if gain == 2 { bb = 0x30 }
        phy_cal_pbus_force(1, 2, bb)
        ok = phy_cal_dc_trim()
        if ok {
            first := volatile_load(0x3FFD7450)
            second := volatile_load(0x3FFD7454)
            if (first == 0 && second == 0) ||
                (first == 0x01FF01FF && second == 0x01FF01FF) {
                volatile_store(0x3FFD7400, 10)
                ok = false
            } else if gain == 0 {
                volatile_store(0x3FFD7480, first)
                volatile_store(0x3FFD7484, second)
            } else if gain == 1 {
                volatile_store(0x3FFD7488, first)
                volatile_store(0x3FFD748C, second)
            } else {
                volatile_store(0x3FFD7490, first)
                volatile_store(0x3FFD7494, second)
            }
            gain = gain + 1
        }
    }
    rom_call6(0x4000453C, 0, 0, 0, 0, 0, 0) // pbus_xpd_rx_on(0)
    rom_call6(0x4000446C, 0, 0, 0, 0, 0, 0) // pbus_workmode
    if !ok || phy_cal_i2c_error() != 0 { << false }
    volatile_store(0x3FFD741C, volatile_load(0x3FFD741C) | 4)
    << true
}
