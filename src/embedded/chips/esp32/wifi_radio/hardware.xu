@embedded/chips/esp32/wifi_radio

#embedded/chips/esp32
#embedded/chips/esp32/wifi_raw_ccmp
#embedded/wifi
#embedded/wifi/session
#embedded/wifi/ccmp
#embedded/wifi/key_data
#embedded/wifi/ipv4

// Exclusive Wi-Fi-only MAC owner. Requires the --radio memory profile.
const RX_DESC = 0x3FFD2000
const RX_BUFFER = 0x3FFD2100
const RX_STRIDE = 0x680
const RX_SIZE = 1600
const RX_COUNT = 8
const TX_DESC = 0x3FFD5800
const TX_BUFFER = 0x3FFD5900

fn word(address int) int {
    if address < 0x3FFD2000 || address > 0x3FFD6FFC || address % 4 != 0 { << -1 }
    rom_call6(0x4000C2C8,0x3FFD7DF0,address,4,0,0,0)
    << volatile_load(0x3FFD7DF0)
}

fn put(address int, value int) bool {
    if address < 0x3FFD2000 || address > 0x3FFD6FFC || address % 4 != 0 { << false }
    volatile_store(0x3FFD7DF0,value)
    rom_call6(0x4000C2C8,address,0x3FFD7DF0,4,0,0,0)
    << word(address) == value
}

fn arena_init() bool {
    rom_call6(0x4000C44C,RX_DESC,0,0x3500,0,0,0)
    for i in 0:RX_COUNT {
        descriptor := RX_DESC + i * 12
        buffer := RX_BUFFER + i * RX_STRIDE
        $next := 0
        if i + 1 < RX_COUNT { next = descriptor + 12 }
        if !put(descriptor,0x80000000 | (RX_SIZE << 12) | RX_SIZE) ||
            !put(descriptor + 4,buffer) || !put(descriptor + 8,next) ||
            !put(buffer,0xDEADBEEF) || !put(buffer + RX_SIZE,0xDEADBEEF) { << false }
    }
    << true
}

fn mac_prepare() bool {
    // Official hal_init first enables bit1, THEN waits for bit0 ready.
    // The decompiler incorrectly treats this device register as invariant.
    volatile_store(0x3FF73D24,volatile_load(0x3FF73D24) | 2)
    $ready := false
    for i in 0:2000 {
        if (volatile_load(0x3FF73D24) & 1) != 0 { ready = true
            <- }
        esp32.rom_delay_us(1)
    }
    if !ready { << false }
    volatile_store(0x3FF73C40,0)
    volatile_store(0x3FF73C4C,0xFFFFFFFF)
    volatile_store(0x3FF73084,volatile_load(0x3FF73084) & 0x7FFFFFFF)
    // mac_rxbuf_init: hardware address aperture, then the owned DMA head.
    volatile_store(0x3FF7311C,0x3FFAE000)
    volatile_store(0x3FF73124,0x3FFAE000)
    volatile_store(0x3FF73118,0x400A0000)
    volatile_store(0x3FF73120,0x400A0000)
    volatile_store(0x3FF73088,RX_DESC)
    volatile_store(0x3FF73080,volatile_load(0x3FF73080) & 0xDFFFFF00)
    << volatile_load(0x3FF73088) == RX_DESC &&
        (volatile_load(0x3FF73084) & 0x80000000) == 0 &&
        volatile_load(0x3FF73C40) == 0
}

fn calibrate_radio() bool {
    rom_call6(esp32.ROM_MEMSET, 0x3FFD7400, 0, 0x800, 0, 0, 0)
    if !esp32.bt_power_domain_on() { << false }
    esp32.bt_rf_clock_enable()
    if !esp32.phy_prepare_analog_bus() || !esp32.phy_cal_install_i2c() ||
        !esp32.phy_cal_pbus_memory_init() || !esp32.phy_cal_rf_bus_init() ||
        !esp32.phy_cal_pll_40mhz() || !esp32.phy_cal_channel_programmer() ||
        !esp32.phy_cal_rc_40mhz() || !esp32.phy_cal_txdc_bt() ||
        !esp32.phy_cal_txiq_bt() || !esp32.phy_cal_txcap_bt() ||
        !esp32.phy_cal_txpower_bt() || !esp32.phy_cal_shared_tx_calibrate() ||
        !esp32.phy_cal_bt_gain_memory() ||
        !esp32.phy_cal_rx_bt() || !esp32.phy_cal_rx_bt_calibrated() ||
        !esp32.phy_cal_bb_registers_init() || !esp32.phy_cal_shared_gain_memory() ||
        !esp32.phy_cal_bt_gain_memory() ||
        !esp32.phy_cal_tx_release() {
        << false
    }
    << true
}

