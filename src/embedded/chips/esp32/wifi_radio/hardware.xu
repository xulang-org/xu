fn tx_defaults(mac &string) {
    // Program the factory MAC read from this device, with hardware ACK enabled.
    volatile_store(0x3FF73040,mac[0] | (mac[1] << 8) | (mac[2] << 16) | (mac[3] << 24))
    volatile_store(0x3FF73044,mac[4] | (mac[5] << 8))
    volatile_store(0x3FF73060,0xFFFFFFFF)
    volatile_store(0x3FF73064,0x0001FFFF)
    // Native hal_mac_rate_autoack_init, basic rates in hardware encoding.
    volatile_store(0x3FF73404,0)
    volatile_store(0x3FF73400,0)
    volatile_store(0x3FF7340C,0x03020100)
    volatile_store(0x3FF73408,0x07060500)
    volatile_store(0x3FF73414,0x0B0B0B0B)
    volatile_store(0x3FF73410,0x0B0B0B0B)
    volatile_store(0x3FF7341C,0x090B0B0B)
    volatile_store(0x3FF73418,0x09090909)
}

fn send_frame(frame &string) bool {
    if frame.len < 24 || frame.len > 1500 { << false }
    if (volatile_load(0x3FF73D20) & 0xC0000000) != 0 { << false }
    rom_call6(esp32.ROM_MEMSET,TX_DESC,0,0x700,0,0,0)
    for i in 0:(frame.len + 3) / 4 {
        $v := 0
        for j in 0:4 { if i * 4 + j < frame.len { v = v | (frame[i * 4 + j] << (j * 8)) } }
        if !put(TX_BUFFER + i * 4,v) { << false }
    }
    if !put(TX_BUFFER + 1536,0xDEADBEEF) ||
        !put(TX_DESC,0xC0000000 | ((frame.len + 4) << 12) | 1536) ||
        !put(TX_DESC + 4,TX_BUFFER) || !put(TX_DESC + 8,0) { << false }
    volatile_store(0x3FF73CC4,15)
    volatile_store(0x3FF73CBC,0x07FF07FF)
    volatile_store(0x3FF73C4C,0xFFFFFFFF)
    volatile_store(0x3FF73D20,(TX_DESC & 0xFFFFF) | 0x00600000)
    volatile_store(0x3FF74258,frame.len + 4)
    volatile_store(0x3FF7425C,0x20)
    volatile_store(0x3FF74268,0)
    volatile_store(0x3FF73D1C,0x0200300A)
    volatile_store(0x3FF73D20,volatile_load(0x3FF73D20) | 0xC0000000)
    << true
}

fn start_receive() bool {
    volatile_store(0x3FF73084,volatile_load(0x3FF73084) & 0x7FFFFFFF)
    if (volatile_load(0x3FF73D20) & 0xC0000000) != 0 {
        // Native hal_mac_txq_disable cancels any queued retry. Allow an
        // already-started maximum low-rate PPDU to finish before DMA reuse.
        volatile_store(0x3FF73D20,volatile_load(0x3FF73D20) & 0x3FFFFFFF)
        esp32.rom_delay_us(25000)
    }
    if !arena_init() { << false }
    volatile_store(0x3FF73088,RX_DESC)
    volatile_store(0x3FF73C4C,0xFFFFFFFF)
    volatile_store(0x3FF73084,volatile_load(0x3FF73084) | 0x80000000)
    volatile_store(0x3FF73064,volatile_load(0x3FF73064) | 0x10000)
    << true
}

fn finish_receive() []string {
    volatile_store(0x3FF73084,volatile_load(0x3FF73084) & 0x7FFFFFFF)
    esp32.rom_delay_us(25000)
    $frames := []string{}
    for index in 0:RX_COUNT {
        descriptor := RX_DESC + index * 12
        buffer := RX_BUFFER + index * RX_STRIDE
        flags := word(descriptor)
        length := (flags >> 12) & 4095
        if (flags & 0x40000000) != 0 && length >= 52 && length <= RX_SIZE &&
            word(descriptor + 4) == buffer && word(buffer + RX_SIZE) == 0xDEADBEEF {
            // CSI is inserted before the terminal RX-vector word.
            csi_length := (word(buffer + 20) >> 8) & 1023
            aligned_csi := (csi_length + 3) & 0xFFFFFFFC
            if aligned_csi > RX_SIZE - 52 || length < aligned_csi + 52 { -> }
            vector := word(buffer + 24 + aligned_csi)
            frame_length := (vector & 4095) - 4
            if (vector >> 24) == 0 && frame_length >= 24 &&
                ((frame_length + 31 + aligned_csi) & 0xFFFFFFFC) == length {
                $frame := make_string(frame_length)
                for part in 0:(frame_length + 3) / 4 {
                    value := word(buffer + 28 + aligned_csi + part * 4)
                    for j in 0:4 {
                        if part * 4 + j < frame_length { frame[part * 4 + j] = (value >> (j * 8)) & 255 }
                    }
                }
                frames.push(frame)
            }
        }
    }
    << frames
}

fn client_filters(bssid &string) {
    low := bssid[0] | (bssid[1] << 8) | (bssid[2] << 16) | (bssid[3] << 24)
    high := bssid[4] | (bssid[5] << 8)
    volatile_store(0x3FF73024,volatile_load(0x3FF73024) & 0xFFFEFFFF)
    volatile_store(0x3FF73000,low)
    volatile_store(0x3FF73004,high)
    volatile_store(0x3FF73020,0xFFFFFFFF)
    volatile_store(0x3FF73024,0x0001FFFF)
    volatile_store(0x3FF730D8,(volatile_load(0x3FF730D8) & 0xFFFFFFFD) | 0x110)
    volatile_store(0x3FF73024,volatile_load(0x3FF73024) & 0xFFFEFFFF)
}

fn byte_copy(value &string) string {
    $out := make_string(value.len)
    for i in 0:value.len { out[i] = value[i] }
    << out
}

fn raw_rsn(frame &string) string {
    if frame.len < 38 { << "" }
    $offset := 36
    while offset < frame.len {
        if frame.len - offset < 2 { << "" }
        length := frame[offset + 1] + 2
        if length > frame.len - offset { << "" }
        if frame[offset] == 48 {
            $out := make_string(length)
            for i in 0:length { out[i] = frame[offset + i] }
            << out
        }
        offset += length
    }
    << ""
}

fn fresh_random(count int) string {
    // Called only after measured PHY startup and real target AP reception.
    // With WiFi PHY active, WDEV_RANDOM gets fresh RF entropy. Delay at least
    // one us per sample, exceeding the documented 16 APB-cycle refill bound.
    if count < 1 || count > 64 || (volatile_load(0x3FF000CC) & 0x406) != 0x406 { << "" }
    $out := make_string(count)
    $first := 0
    $different := false
    $bits := 0
    for sample in 0:(count + 3) / 4 {
        a := volatile_load(0x3FF75144)
        esp32.rom_delay_us(1)
        v := a ^ volatile_load(0x3FF75144)
        if sample == 0 { first = v }
        else if v != first { different = true }
        bits = bits | v
        for j in 0:4 { if sample * 4 + j < count { out[sample * 4 + j] = (v >> (j * 8)) & 255 } }
    }
    if bits == 0 || (count >= 8 && !different) { << "" }
    << out
}

fn eapol_message(frame &string, mac &string, bssid &string) string {
    if frame.len < 131 || (frame[0] != 8 && frame[0] != 0x88) ||
        (frame[1] & 0xC7) != 2 || (frame[22] & 15) != 0 { << "" }
    for i in 0:6 { if frame[4 + i] != mac[i] || frame[10 + i] != bssid[i] { << "" } }
    $header := 24
    if frame[0] == 0x88 { header = 26
        if (frame[24] & 128) != 0 { << "" } }
    if frame.len < header + 107 || frame[header] != 170 || frame[header + 1] != 170 ||
        frame[header + 2] != 3 || frame[header + 3] != 0 || frame[header + 4] != 0 ||
        frame[header + 5] != 0 || frame[header + 6] != 136 || frame[header + 7] != 142 { << "" }
    offset := header + 8
    length := 4 + (frame[offset + 2] << 8) + frame[offset + 3]
    if length < 99 || length > frame.len - offset { << "" }
    $packet := make_string(length)
    for i in 0:length { packet[i] = frame[offset + i] }
    parsed := wifi.wpa2_key_parse(&packet)
    if !parsed.valid { << "" }
    << packet
}

fn data_header(mac &string, bssid &string, destination &string, sequence int) string {
    if mac.len != 6 || bssid.len != 6 || destination.len != 6 { << "" }
    $out := make_string(24)
    out[0] = 8
    out[1] = 1 // ordinary data, ToDS; CCMP adds Protected when needed.
    for i in 0:6 { out[4 + i] = bssid[i]
        out[10 + i] = mac[i]
        out[16 + i] = destination[i] }
    out[22] = (sequence & 15) << 4
    out[23] = (sequence >> 4) & 255
    << out
}

fn eapol_frame(packet &string, mac &string, bssid &string, sequence int) string {
    header := data_header(mac,bssid,bssid,sequence)
    if header.len != 24 { << "" }
    $out := make_string(32 + packet.len)
    for i in 0:24 { out[i] = header[i] }
    out[24] = 170
    out[25] = 170
    out[26] = 3
    out[30] = 136
    out[31] = 142
    for i in 0:packet.len { out[32 + i] = packet[i] }
    << out
}
