@embedded/chips/esp32/wifi_radio

const TX_FATAL = 0
const TX_UNCONFIRMED = 1
const TX_ACKED = 2

// Queue 0 completion/channel errors and the native PMD protocol result are
// independent. Missing ACK/CTS and channel access failure are retryable;
// invalid key selection and unknown protocol states fail closed.
fn classify_tx_status(completed bool, channel_errors int, pmd int) int {
    if !completed || (channel_errors & 0x10001) != 0 { << TX_UNCONFIRMED }
    category := (pmd >> 12) & 15
    detail := pmd & 255
    if category == 0 { << TX_ACKED }
    if category == 2 || category == 5 ||
        (category == 1 && (detail == 1 || detail > 2)) ||
        (category == 4 && (detail == 0 || (detail > 1 && detail < 6))) { << TX_UNCONFIRMED }
    << TX_FATAL
}
