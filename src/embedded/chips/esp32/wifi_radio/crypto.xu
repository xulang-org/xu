@embedded/chips/esp32/wifi_radio

#embedded/chips/esp32
#embedded/wifi
#embedded/wifi/session
#embedded/wifi/ccmp
#embedded/wifi/key_data

fn process_eapol(state $&session.State, packet &string) string {
    step := wifi.wpa2_handshake_receive($&state.handshake,packet)
    if !step.valid { << "" }
    if step.validate_key_data {
        if state.keys.valid { << "" }
        plain := key_data.unwrap(&step.kek,&step.key_data)
        group := key_data.parse(&plain,state.ap_rsn)
        if !group.valid || packet[71] != 0 || packet[72] != 0 {
            << ""
        }
        $rsc := make_string(6)
        for i in 0:6 { rsc[i] = packet[65 + i] }
        // Installing fresh software CCMP contexts exactly once. PN floors
        // are never reset by M3 retries; no plaintext is released pre-MIC.
        state.keys.tk = step.tk
        state.keys.gtk = group.key
        state.keys.gtk_index = group.index
        state.keys.tx_pn = make_string(6)
        for i in 0:17 { state.keys.rx_group[i] = byte_copy(&rsc) }
        state.keys.valid = true
        << wifi.wpa2_handshake_confirm_keys($&state.handshake,packet)
    }
    if step.transmit.len != 0 { << step.transmit }
    << ""
}
fn decrypt_payload(state $&session.State, frame &string) string {
    if !state.keys.valid || frame.len < 40 || (frame[0] != 8 && frame[0] != 0x88) ||
        (frame[1] & 0xC7) != 0x42 || (frame[22] & 15) != 0 { << "" }
    for i in 0:6 { if frame[10 + i] != state.ap.bssid[i] { << "" } }
    $tid := 16
    $header := 24
    if frame[0] == 0x88 { tid = frame[24] & 15
        header = 26 }
    index := (frame[header + 3] >> 6) & 3
    if (frame[4] & 1) == 0 {
        for i in 0:6 { if frame[4 + i] != state.mac[i] { << "" } }
        if index != 0 { << "" }
        packet := ccmp.unprotect(&state.keys.tk,frame,&state.keys.rx_unicast[tid])
        if !packet.valid || packet.key_index != 0 { << "" }
        state.keys.rx_unicast[tid] = packet.pn
        << packet.payload
    }
    if index != state.keys.gtk_index { << "" }
    packet := ccmp.unprotect(&state.keys.gtk,frame,&state.keys.rx_group[tid])
    if !packet.valid || packet.key_index != state.keys.gtk_index { << "" }
    state.keys.rx_group[tid] = packet.pn
    << packet.payload
}
fn broadcast_mac() string {
    $out := make_string(6)
    for i in 0:6 { out[i] = 255 }
    << out
}
fn prepare_encrypted(state $&session.State, payload &string, destination &string, sequence int) string {
    if !state.keys.valid || payload.len == 0 { << "" }
    next := ccmp.next_pn(&state.keys.tx_pn)
    if next.len != 6 { << "" }
    state.keys.tx_pn = next
    header := data_header(state.mac,state.ap.bssid,destination,sequence)
    << ccmp.protect(&state.keys.tk,&header,payload,&state.keys.tx_pn,0)
}
