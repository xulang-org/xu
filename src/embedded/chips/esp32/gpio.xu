@embedded/chips/esp32

// ESP32 GPIO & IO_MUX Driver

pub const PIN_INPUT          = 0
pub const PIN_OUTPUT         = 1
pub const PIN_INPUT_PULLUP   = 2
pub const PIN_INPUT_PULLDOWN = 3

pub const PIN_LOW  = 0
pub const PIN_HIGH = 1

pub fn gpio_pin_mask(pin int) int {
    if pin >= 0 && pin < 32 {
        << 1 << pin
    }
    << 0
}

pub fn gpio_config_mux(pin int, mux_val int) {
    if pin == 2 { volatile_store(IO_MUX_GPIO2_REG, mux_val) }
    else if pin == 13 { volatile_store(IO_MUX_GPIO13_REG, mux_val) }
    else if pin == 14 { volatile_store(IO_MUX_GPIO14_REG, mux_val) }
    else if pin == 15 { volatile_store(IO_MUX_GPIO15_REG, mux_val) }
    else if pin == 17 { volatile_store(IO_MUX_GPIO17_REG, mux_val) }
    else if pin == 21 { volatile_store(IO_MUX_GPIO21_REG, mux_val) }
    else if pin == 25 { volatile_store(IO_MUX_GPIO25_REG, mux_val) }
    else if pin == 32 { volatile_store(IO_MUX_GPIO32_REG, mux_val) }
    else if pin == 33 { volatile_store(IO_MUX_GPIO33_REG, mux_val) }
    else if pin == 36 { volatile_store(IO_MUX_GPIO36_REG, mux_val) }
    else if pin == 39 { volatile_store(IO_MUX_GPIO39_REG, mux_val) }
}

// Routes the GPIO matrix output to the physical pad (SIG_GPIO_OUT_IDX = 0x100)
// Crucial for pins that default to JTAG or strapping functions at boot (e.g., 14, 13, 15, 2).
pub fn gpio_route_out(pin int) {
    if pin == 2 { volatile_store(0x3FF44538, 0x100) }
    else if pin == 13 { volatile_store(0x3FF44564, 0x100) }
    else if pin == 14 { volatile_store(0x3FF44568, 0x100) }
    else if pin == 15 { volatile_store(0x3FF4456C, 0x100) }
    else if pin == 17 { volatile_store(0x3FF44574, 0x100) }
    else if pin == 21 { volatile_store(0x3FF44584, 0x100) }
    else if pin == 25 { volatile_store(0x3FF44594, 0x100) }
    else if pin == 32 { volatile_store(0x3FF445B0, 0x100) }
    else if pin == 33 { volatile_store(0x3FF445B4, 0x100) }
}

pub fn gpio_init(pin int, mode int) {
    if pin < 32 {
        if mode == PIN_INPUT {
            gpio_config_mux(pin, 0x2200) // IE = 1
            mask := gpio_pin_mask(pin)
            volatile_store(GPIO_ENABLE_W1TC_REG, mask)
        } else if mode == PIN_INPUT_PULLUP {
            gpio_config_mux(pin, 0x2300) // IE = 1, WPU = 1
            mask := gpio_pin_mask(pin)
            volatile_store(GPIO_ENABLE_W1TC_REG, mask)
        } else if mode == PIN_INPUT_PULLDOWN {
            gpio_config_mux(pin, 0x2280) // IE = 1, WPD = 1
            mask := gpio_pin_mask(pin)
            volatile_store(GPIO_ENABLE_W1TC_REG, mask)
        } else {
            // Output mode: MCU_SEL=2 (GPIO), FUN_DRV=3 (40mA strong drive)
            gpio_config_mux(pin, 0x2C00)
            gpio_route_out(pin) // Connect direct GPIO_OUT register to pad
            mask := gpio_pin_mask(pin)
            volatile_store(GPIO_ENABLE_W1TS_REG, mask)
        }
    } else {
        shift := pin - 32
        mask := 1 << shift
        if mode == PIN_OUTPUT {
            if pin == 32 || pin == 33 {
                gpio_config_mux(pin, 0x2C00)
                gpio_route_out(pin)
                volatile_store(GPIO_ENABLE1_W1TS_REG, mask)
            }
        } else {
            // Input mode for GPIO 32..39
            gpio_config_mux(pin, 0x2200) // MCU_SEL=2, FUN_IE=1
            volatile_store(GPIO_ENABLE1_W1TC_REG, mask)
        }
    }
}

pub fn gpio_set_high(pin int) {
    if pin < 32 {
        mask := gpio_pin_mask(pin)
        volatile_store(GPIO_OUT_W1TS_REG, mask)
    } else {
        shift := pin - 32
        mask := 1 << shift
        volatile_store(GPIO_OUT1_W1TS_REG, mask)
    }
}

pub fn gpio_set_low(pin int) {
    if pin < 32 {
        mask := gpio_pin_mask(pin)
        volatile_store(GPIO_OUT_W1TC_REG, mask)
    } else {
        shift := pin - 32
        mask := 1 << shift
        volatile_store(GPIO_OUT1_W1TC_REG, mask)
    }
}

pub fn gpio_set_high_mask(mask int) {
    if mask != 0 {
        volatile_store(GPIO_OUT_W1TS_REG, mask)
    }
}

pub fn gpio_set_low_mask(mask int) {
    if mask != 0 {
        volatile_store(GPIO_OUT_W1TC_REG, mask)
    }
}

pub fn gpio_set(pin int, val int) {
    if val != 0 {
        gpio_set_high(pin)
    } else {
        gpio_set_low(pin)
    }
}

pub fn gpio_get(pin int) int {
    if pin < 32 {
        reg := volatile_load(GPIO_IN_REG)
        mask := gpio_pin_mask(pin)
        if (reg & mask) != 0 {
            << 1
        }
        << 0
    }
    shift := pin - 32
    mask := 1 << shift
    reg1 := volatile_load(GPIO_IN1_REG)
    if (reg1 & mask) != 0 {
        << 1
    }
    << 0
}

pub fn gpio_toggle(pin int) {
    if gpio_get(pin) != 0 {
        gpio_set_low(pin)
    } else {
        gpio_set_high(pin)
    }
}
