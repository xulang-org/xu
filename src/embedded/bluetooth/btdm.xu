// `_coex_schm_interval_get(void)`
fn osi_coex_schm_interval_get(ctx $&BtdmController) int {
    << 0
}

// `_coex_schm_curr_period_get(void)`
fn osi_coex_schm_curr_period_get(ctx $&BtdmController) int {
    << 1
}

// `_coex_schm_curr_phase_get(void)`
fn osi_coex_schm_curr_phase_get(ctx $&BtdmController) int {
    << 0
