// `_coex_schm_register_btdm_callback(void *callback)`
fn osi_coex_schm_register_btdm_callback(ctx $&BtdmController, callback int) int {
    << ESP_ERR_NOT_SUPPORTED
}

// `_coex_schm_status_bit_clear(uint32_t type, uint32_t status)`
fn osi_coex_schm_status_bit_clear(ctx $&BtdmController, type int, status int) {
}

// `_coex_schm_status_bit_set(uint32_t type, uint32_t status)`
fn osi_coex_schm_status_bit_set(ctx $&BtdmController, type int, status int) {
