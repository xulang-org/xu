// `bredr_sco_datapath_set(uint8_t data_path)`
pub fn bredr_sco_datapath_set(data_path int) {
}

// `btdm_controller_scan_duplicate_list_clear(void)`
pub fn btdm_controller_scan_duplicate_list_clear(ctl $&BtdmController) {
}

// `btdm_rf_bb_init_phase2(void)`
//
