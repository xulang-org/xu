// ===== Interrupt dispatch ==================================================

// Look up the interrupt handler that the OSI `_set_isr` slot registered for
// interrupt `n` and return its handler id (-1 when nothing is registered).
//
// The C `_set_isr` slot takes a function pointer.  An Xu `fn` value cannot be
// nested inside a function type, so the Xu table stores a handler *id* and
// the application maps that id to its own handler.  The application calls
// this from its `fn irq_N` entry.
pub fn btdm_irq_dispatch(ctx &BtdmController, n int) int {
    if n < 0 || n >= ctx.isr_handlers.len { << -1 }
    << ctx.isr_handlers[n]
}
