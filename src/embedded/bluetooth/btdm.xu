// ===== The OSI table =======================================================

// Build the read only OSI table.  The field order mirrors
// `struct osi_funcs_t` in bt.c line by line.
pub fn btdm_osi_funcs_ro() OsiFuncs {
    << OsiFuncs{
        version: OSI_VERSION,
        set_isr: osi_set_isr,
        ints_on: osi_ints_on,
        interrupt_disable: osi_interrupt_disable,
        interrupt_restore: osi_interrupt_restore,
        task_yield: osi_task_yield,
        task_yield_from_isr: osi_task_yield_from_isr,
        semphr_create: osi_semphr_create,
        semphr_delete: osi_semphr_delete,
        semphr_take_from_isr: osi_semphr_take_from_isr,
        semphr_give_from_isr: osi_semphr_give_from_isr,
        semphr_take: osi_semphr_take,
        semphr_give: osi_semphr_give,
        mutex_create: osi_mutex_create,
        mutex_delete: osi_mutex_delete,
        mutex_lock: osi_mutex_lock,
        mutex_unlock: osi_mutex_unlock,
        queue_create: osi_queue_create,
        queue_delete: osi_queue_delete,
        queue_send: osi_queue_send,
        queue_send_from_isr: osi_queue_send_from_isr,
        queue_recv: osi_queue_recv,
        queue_recv_from_isr: osi_queue_recv_from_isr,
        task_create: osi_task_create,
        task_delete: osi_task_delete,
        is_in_isr: osi_is_in_isr,
        cause_sw_intr_to_core: osi_cause_sw_intr_to_core,
        malloc: osi_malloc,
        malloc_internal: osi_malloc_internal,
        free: osi_free,
        read_efuse_mac: osi_read_efuse_mac,
        srand: osi_srand,
        rand: osi_rand,
        btdm_lpcycles_2_us: osi_btdm_lpcycles_2_us,
        btdm_us_2_lpcycles: osi_btdm_us_2_lpcycles,
        btdm_sleep_check_duration: osi_btdm_sleep_check_duration,
        btdm_sleep_enter_phase1: osi_btdm_sleep_enter_phase1,
        btdm_sleep_enter_phase2: osi_btdm_sleep_enter_phase2,
        btdm_sleep_exit_phase1: osi_btdm_sleep_exit_phase1,
        btdm_sleep_exit_phase2: osi_btdm_sleep_exit_phase2,
        btdm_sleep_exit_phase3: osi_btdm_sleep_exit_phase3,
        coex_bt_wakeup_request: osi_coex_bt_wakeup_request,
        coex_bt_wakeup_request_end: osi_coex_bt_wakeup_request_end,
        coex_bt_request: osi_coex_bt_request,
        coex_bt_release: osi_coex_bt_release,
        coex_register_bt_cb: osi_coex_register_bt_cb,
        coex_bb_reset_lock: osi_coex_bb_reset_lock,
        coex_bb_reset_unlock: osi_coex_bb_reset_unlock,
        coex_schm_register_btdm_callback: osi_coex_schm_register_btdm_callback,
        coex_schm_status_bit_clear: osi_coex_schm_status_bit_clear,
        coex_schm_status_bit_set: osi_coex_schm_status_bit_set,
        coex_schm_interval_get: osi_coex_schm_interval_get,
        coex_schm_curr_period_get: osi_coex_schm_curr_period_get,
        coex_schm_curr_phase_get: osi_coex_schm_curr_phase_get,
        coex_wifi_channel_get: osi_coex_wifi_channel_get,
        coex_register_wifi_channel_change_callback: osi_coex_register_wifi_channel_change_callback,
        set_isr_l3: osi_set_isr_l3,
        interrupt_l3_disable: osi_interrupt_l3_disable,
        interrupt_l3_restore: osi_interrupt_l3_restore,
        customer_queue_create: osi_customer_queue_create,
        magic: OSI_MAGIC_VALUE
    }
}

// `btdm_osi_funcs_register(void *osi_funcs)`
//
// The C version hands the table to the closed source controller.  The Xu
// version validates the table identity and records it on the controller.
//
// The validation order and the return codes below are not guesses: they are
// recovered from the closed library by REA/Ghidra.  The esp32 variant is
//
//     undefined4 btdm_osi_funcs_register(int *param_1) {
//         uVar1 = -1;                          // null pointer
//         if (param_1 != NULL) {
//             uVar1 = -2;                      // magic mismatch
//             if ((param_1[0x3c] == 0xFADEBEAD)   // _magic, offset 0xF0
//                 && (uVar1 = -3, *param_1 == 0x00010003)) {  // _version, offset 0x00
//                 uVar1 = 0;
//                 r_osi_funcs_p = param_1;
//             }
//         }
//         return uVar1;
//     }
//
// So the magic is compared FIRST (short-circuit `&&`), the version SECOND.
// The esp32 controller prints no diagnostic on mismatch, which is why the
// return code is the only signal a caller gets.
pub fn btdm_osi_funcs_register(ctl $&BtdmController) int {
    if ctl.osi.magic != OSI_MAGIC_VALUE { << BTDM_OSI_ERR_MAGIC }
    if ctl.osi.version != OSI_VERSION { << BTDM_OSI_ERR_VERSION }
    ctl.registered = true
    << ESP_OK
}

// ===== Controller task ====================================================

// Controller task event handler.  The work items are dispatched here, in
// the controller task context, exactly like `btdm_task_post_impl` does in the
// C implementation.
fn btdm_ke_event_handler(id int, param int) int {
    << 0
}

// Controller task timer handler.
fn btdm_ke_timer_handler(id int) int {
    << 0
}

// Dispatch work to the controller task context.
//
// The C signature is
//   int btdm_dispatch_work_to_controller(workitem_handler_t cb, void *arg,
//                                        bool blocking)
// The Xu version identifies the work item by an id instead of a function
// pointer, because an Xu `fn` value cannot be nested inside a function type.
// `blocking` selects whether the caller waits for the work to be executed.
pub fn btdm_dispatch_work_to_controller(ctl $&BtdmController, work_id int, arg int, blocking bool) int {
    // Phase-tagged ring cursors distinguish empty from full while keeping
    // all eight slots usable and the counters bounded on 32-bit targets.
    tail := ctl.work_tail
    next := (tail + 1) % (BTDM_WORK_SLOTS * 2)
    if (tail + BTDM_WORK_SLOTS) % (BTDM_WORK_SLOTS * 2) == ctl.work_head {
        << ESP_ERR_NO_MEM
    }
    if !ke_post_event($&ctl.task, BTDM_EVT_WORK, work_id) { << ESP_ERR_NO_MEM }
    slot := tail % BTDM_WORK_SLOTS
    ctl.work_ids[slot] = work_id
    ctl.work_args[slot] = arg
    ctl.work_tail = next
    if blocking {
        // Run the controller loop until the work item has been consumed.
        $guard := 0
        while guard < 64 {
            if ctl.work_head == next { << ESP_OK }
            if btdm_controller_pump(ctl, 1) == 0 { << ESP_ERR_INVALID_STATE }
            guard = guard + 1
        }
        << ESP_ERR_INVALID_STATE
    }
    << ESP_OK
}

// Run the controller task loop for up to `max_events` posted events.
pub fn btdm_controller_pump(ctl $&BtdmController, max_events int) int {
    ctl.tick = ctl.tick + 1
    $now := ctl.tick
    ke_timer_poll($&ctl.task, now)
    $n := 0
    while n < max_events {
        id := ke_peek_event_id(&ctl.task)
        if ke_run_once($&ctl.task) == 0 { << n }
        if id == BTDM_EVT_WORK && ctl.work_head != ctl.work_tail {
            ctl.work_head = (ctl.work_head + 1) % (BTDM_WORK_SLOTS * 2)
        }
        n += 1
    }
    << n
}

// ===== VHCI ================================================================

// `api_vhci_host_register_callback(const vhci_host_callback_t *callback)`
pub fn api_vhci_host_register_callback(ctx $&BtdmController, cb VhciHostCallback) int {
    ctx.vhci.notify_host_send_available = cb.notify_host_send_available
    ctx.vhci.notify_host_recv = cb.notify_host_recv
    ctx.vhci.registered = true
    ctx.vhci.send_available = true
    << ESP_OK
}

// `api_vhci_host_check_send_available(void)`
//
// True when the controller can accept another packet from the host.
pub fn api_vhci_host_check_send_available(ctx $&BtdmController) bool {
    << ctx.vhci.send_available
}

// `api_vhci_host_send_packet(uint8_t *data, uint16_t len)`
//
// `frame` is the H4 framed packet (type byte + payload).  The C contract is
// a *copy* contract: the host frees its buffer as soon as the call returns
// (`ble_hci_trans_buf_free(cmd)` in the NimBLE transport), so the controller
// must copy the bytes before returning.  The Xu port copies the frame into
// the transmit pool of the context.
pub fn api_vhci_host_send_packet(ctx $&BtdmController, frame []int) {
    if !ctx.vhci.send_available { << }
    $slot := ctx.vhci.tx_slot
    if slot >= BTDM_VHCI_TX_SLOTS { slot = 0 }
    $i := 0
    while i < frame.len {
        btdm_vhci_tx_store(ctx, slot, i, frame[i])
        i = i + 1
    }
    ctx.vhci.tx_slot = slot + 1
    ctx.vhci.tx_len = frame.len
    ctx.vhci.tx_packets = ctx.vhci.tx_packets + 1
    ctx.vhci.tx_bytes = ctx.vhci.tx_bytes + frame.len
    ctx.vhci.send_available = false
    // Hand the packet to the controller task and tell the host that the
    // transport can accept more.
    ke_post_event($&ctx.task, BTDM_EVT_VHCI_RX, slot)
    ctx.vhci.send_available = true
    $h := ctx.vhci.notify_host_send_available
    h()
    ctx.vhci.notify_send_available_calls = ctx.vhci.notify_send_available_calls + 1
}

// Bytes of a transmitted frame, for inspection and for the self test.
pub fn btdm_vhci_tx_byte(ctx &BtdmController, slot int, index int) int {
    << btdm_vhci_tx_load(ctx, slot, index)
}

// Deliver a packet from the controller to the host.
//
// The controller owns the buffer: the host callback receives a slot index and
// the length, and reads the bytes with `btdm_vhci_rx_byte`.
pub fn btdm_vhci_deliver_to_host(ctx $&BtdmController, frame []int) int {
    $slot := ctx.vhci.rx_slot
    if slot >= BTDM_VHCI_RX_SLOTS { slot = 0 }
    $i := 0
    while i < frame.len {
        btdm_vhci_rx_store(ctx, slot, i, frame[i])
        i = i + 1
    }
    ctx.vhci.rx_slot = slot + 1
    ctx.vhci.rx_len = frame.len
    ctx.vhci.rx_packets = ctx.vhci.rx_packets + 1
    $h := ctx.vhci.notify_host_recv
    $r := h(slot, frame.len)
    ctx.vhci.notify_recv_calls = ctx.vhci.notify_recv_calls + 1
    << r
}

// Byte of a received frame.
pub fn btdm_vhci_rx_byte(ctx &BtdmController, slot int, index int) int {
    << btdm_vhci_rx_load(ctx, slot, index)
}

// The transmit and receive pools are byte arrays inside the context.  They
// are modelled as fixed size int arrays so the pool slots stay contiguous.
fn btdm_vhci_tx_store(ctx $&BtdmController, slot int, index int, value int) {
    // The pool is a flat int array in the context; the index is bounded by
    // the slot size.
    if index < 0 || index >= HCI_MAX_FRAME { << }
    btdm_pool_store(ctx, slot * HCI_MAX_FRAME + index, value)
}

fn btdm_vhci_tx_load(ctx &BtdmController, slot int, index int) int {
    if index < 0 || index >= HCI_MAX_FRAME { << 0 }
    << btdm_pool_load(ctx, slot * HCI_MAX_FRAME + index)
}

fn btdm_vhci_rx_store(ctx $&BtdmController, slot int, index int, value int) {
    if index < 0 || index >= HCI_MAX_FRAME { << }
    btdm_pool_store(ctx, (BTDM_VHCI_TX_SLOTS + slot) * HCI_MAX_FRAME + index, value)
}

fn btdm_vhci_rx_load(ctx &BtdmController, slot int, index int) int {
    if index < 0 || index >= HCI_MAX_FRAME { << 0 }
    << btdm_pool_load(ctx, (BTDM_VHCI_TX_SLOTS + slot) * HCI_MAX_FRAME + index)
}

// ===== VHCI / HCI byte pool ===============================================
//
// The pool is a plain int array in the context.  xu has no way to take the
// address of an array element, so the pool is addressed by index.

fn btdm_pool_store(ctx $&BtdmController, index int, value int) {
    if index < 0 || index >= ctx.pool.len { << }
    ctx.pool[index] = value
}

fn btdm_pool_load(ctx &BtdmController, index int) int {
    if index < 0 || index >= ctx.pool.len { << 0 }
    << ctx.pool[index]
}

// ===== Sleep / power =======================================================

// Asynchronous wake up request sources (bt.c lines 1031-1034).
pub const BTDM_ASYNC_WAKEUP_REQ_HCI = 0
pub const BTDM_ASYNC_WAKEUP_REQ_COEX = 1
pub const BTDM_ASYNC_WAKEUP_REQ_CTRL_DISA = 2

// `btdm_power_state_active(void)`
pub fn btdm_power_state_active(ctl &BtdmController) bool {
    << ctl.power_active
}

// `btdm_wakeup_request(void)`
//
// TODO(BTDM-P2): the real wake up request pokes the closed source
// controller (`rwip.o`).  The xu port raises the power state and asks the
// controller task to run.
pub fn btdm_wakeup_request(ctl $&BtdmController) {
    ctl.power_active = true
    btdm_dispatch_work_to_controller(ctl, BTDM_WORK_WAKEUP_REQUEST, 0, false)
}

// `btdm_in_wakeup_requesting_set(bool in_wakeup_requesting)`
pub fn btdm_in_wakeup_requesting_set(ctl $&BtdmController, in_wakeup_requesting bool) {
    ctl.in_wakeup_requesting = in_wakeup_requesting
}

// `btdm_controller_enable_sleep(bool enable)`
pub fn btdm_controller_enable_sleep(ctl $&BtdmController, enable bool) {
    ctl.sleep_enabled = enable
}

// `btdm_controller_set_sleep_mode(uint8_t mode)`
pub fn btdm_controller_set_sleep_mode(ctl $&BtdmController, mode int) {
    ctl.sleep_mode = mode
}

// `btdm_controller_get_sleep_mode(void)`
pub fn btdm_controller_get_sleep_mode(ctl &BtdmController) int {
    << ctl.sleep_mode
}

// Asynchronous wake up handshake (bt.c lines 1052-1108).
pub fn btdm_async_wakeup_request(ctx $&BtdmController, event int) bool {
    if event == BTDM_ASYNC_WAKEUP_REQ_HCI {
        ctx.in_wakeup_requesting = true
    }
    if event == BTDM_ASYNC_WAKEUP_REQ_HCI || event == BTDM_ASYNC_WAKEUP_REQ_CTRL_DISA {
        if !ctx.power_active {
            ctx.power_active = true
            btdm_dispatch_work_to_controller(ctx, BTDM_WORK_WAKEUP_REQUEST, 0, false)
            << true
        }
        << false
    }
    if event == BTDM_ASYNC_WAKEUP_REQ_COEX {
        if !ctx.power_active {
            ctx.power_active = true
            << true
        }
    }
    << false
}

pub fn btdm_async_wakeup_request_end(ctx $&BtdmController, event int) {
    if event == BTDM_ASYNC_WAKEUP_REQ_HCI {
        ctx.in_wakeup_requesting = false
    }
}

// ===== Low power clock =====================================================

// `btdm_lpclk_select_src(uint32_t sel)`
//
// Selects the low power clock source.  The source selection is a chip
// register, so the actual write goes through the chip binding hooks in
// `backend.xu`; this layer only validates the request.
pub fn btdm_lpclk_select_src(ctl $&BtdmController, sel int) bool {
    if !btdm_lpclk_select_src_raw(&ctl.backend, sel) { << false }
    ctl.lpclk_sel = sel
    << true
}

// `btdm_lpclk_set_div(uint32_t div)`
//
// Writes the 12 bit integer divider of the low power clock.  The fractional
// divider fields are left untouched because the C contract only carries an
// integer divider.
pub fn btdm_lpclk_set_div(ctl $&BtdmController, div int) bool {
    if !btdm_lpclk_set_div_raw(&ctl.backend, div) { << false }
    ctl.lpclk_div = div
    << true
}

// Low power clock source selection without a controller instance.
//
// `sel` is one of BTDM_LPCLK_SEL_XTAL / _XTAL32K / _RTC_SLOW / _8M.  The
// mapping from that selection to the chip register bits belongs to the chip
// binding.
pub fn btdm_lpclk_select_src_raw(backend &BtBackend, sel int) bool {
    if sel != BTDM_LPCLK_SEL_XTAL && sel != BTDM_LPCLK_SEL_XTAL32K &&
        sel != BTDM_LPCLK_SEL_RTC_SLOW && sel != BTDM_LPCLK_SEL_8M {
        << false
    }
    << bt_lpclk_select_src(backend, sel)
}

// Low power clock divider without a controller instance.
//
// ESP-IDF computes the divider as `esp_clk_xtal_freq() * 2 / MHZ - 1`,
// which is 79 for the 40 MHz main crystal of the ESP32.
pub fn btdm_lpclk_set_div_raw(backend &BtBackend, div int) bool {
    if div < 0 || div > 4095 { << false }
    << bt_lpclk_set_div(backend, div)
}

// Configure the Bluetooth low power clock the way the C init path does:
// main crystal as the source and the 40 MHz / 80 / 2 divider.
pub fn btdm_lpclk_configure_default(backend &BtBackend) bool {
    if !bt_lpclk_select_src(backend, BTDM_LPCLK_SEL_XTAL) { << false }
    << bt_lpclk_set_div(backend, 79)
}

// Read back the low power clock state, for the self test.
pub fn btdm_lpclk_div_int(backend &BtBackend) int {
    << bt_lpclk_read_div(backend)
}

pub fn btdm_lpclk_frac(backend &BtBackend) int {
    << bt_lpclk_read_src(backend)
}

// ===== Controller lifecycle ===============================================

// Configuration mask of this build (bt.c lines 1251-1269).
//
// The ESP32 build scans with duplicates enabled and reserves the extra
// advertising room; the UART transport and the second CPU are off.
pub fn btdm_config_mask_load() int {
    $mask := 0
    mask = mask | BTDM_CFG_SCAN_DUPLICATE_OPTIONS
    mask = mask | BTDM_CFG_SEND_ADV_RESERVED_SIZE
    << mask
}

// `btdm_controller_init(uint32_t config_mask, esp_bt_controller_config_t *cfg)`
//
// The C version hands the configuration to the closed source controller.  The
// Xu port initialises the OSI table, the low power clock and the controller
// task, and records the requested mode.
pub fn btdm_controller_init(ctl $&BtdmController, config_mask int, mode int) int {
    if ctl.status != ESP_BT_CONTROLLER_STATUS_IDLE { << ESP_ERR_INVALID_STATE }
    if btdm_osi_funcs_register(ctl) != ESP_OK { << ESP_ERR_INVALID_ARG }
    ctl.config_mask = config_mask
    ctl.mode = mode
    ctl.power_active = true
    ctl.lpcycle_us = BTDM_LPCYCLE_US_DEFAULT
    ctl.lpcycle_us_frac = RTC_CLK_CAL_FRACT
    // Default low power clock: main crystal, divider 79 (40 MHz / 80 / 2).
    btdm_lpclk_select_src(ctl, BTDM_LPCLK_SEL_XTAL)
    btdm_lpclk_set_div(ctl, 79)
    ctl.status = ESP_BT_CONTROLLER_STATUS_INITED
    << ESP_OK
}

// `btdm_controller_enable(esp_bt_mode_t mode)`
pub fn btdm_controller_enable(ctl $&BtdmController, mode int) int {
    if ctl.status != ESP_BT_CONTROLLER_STATUS_INITED { << ESP_ERR_INVALID_STATE }
    if mode != ctl.mode { << ESP_ERR_INVALID_ARG }
    if ctl.sleep_mode == BTDM_MODEM_SLEEP_MODE_ORIG {
        btdm_controller_enable_sleep(ctl, true)
    }
    ctl.status = ESP_BT_CONTROLLER_STATUS_ENABLED
    << ESP_OK
}

// `btdm_controller_disable(void)`
pub fn btdm_controller_disable(ctl $&BtdmController) int {
    if ctl.status != ESP_BT_CONTROLLER_STATUS_ENABLED { << ESP_ERR_INVALID_STATE }
    if ctl.sleep_mode == BTDM_MODEM_SLEEP_MODE_ORIG {
        btdm_controller_enable_sleep(ctl, false)
        btdm_async_wakeup_request(ctl, BTDM_ASYNC_WAKEUP_REQ_CTRL_DISA)
    }
    ctl.status = ESP_BT_CONTROLLER_STATUS_INITED
    << ESP_OK
}

// `btdm_controller_deinit(void)`
pub fn btdm_controller_deinit(ctl $&BtdmController) int {
    if ctl.status != ESP_BT_CONTROLLER_STATUS_INITED { << ESP_ERR_INVALID_STATE }
    ctl.registered = false
    ctl.status = ESP_BT_CONTROLLER_STATUS_IDLE
    ctl.lpcycle_us = 0
    ctl.sleep_mode = BTDM_MODEM_SLEEP_MODE_NONE
    ctl.power_active = false
    << ESP_OK
}

// `btdm_controller_get_mode(void)`
pub fn btdm_controller_get_mode(ctl &BtdmController) int {
    << ctl.mode
}

// `btdm_controller_get_compile_version(void)`
pub fn btdm_controller_get_compile_version(ctl &BtdmController) string {
    << "ESP32_BT_Controller_XU_V01"
}

// `esp_bt_controller_shutdown(void)`
//
// TODO(BTDM-P2): the C version stops the controller and powers the PHY off.
// The xu port stops the controller task and marks the controller idle.
pub fn esp_bt_controller_shutdown(ctl $&BtdmController) {
    btdm_controller_disable(ctl)
    btdm_controller_deinit(ctl)
}

// Inject the Bluetooth MAC into the context (see `osi_read_efuse_mac`).
pub fn btdm_set_mac(ctl $&BtdmController, mac []int) {
    $i := 0
    while i < BTDM_MAC_SLOT_BYTES && i < mac.len {
        ctl.mac_bytes[i] = mac[i] & 0xFF
        i = i + 1
    }
}

