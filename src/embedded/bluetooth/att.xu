@embedded/bluetooth

// One-connection, fixed-database ATT/GATT HID server. A 23-byte ATT MTU
// keeps an entire L2CAP SDU within the baseline 27-byte LE ACL buffer.
// SMP and HCI ACL fragmentation/reassembly belong to the host transport.
pub const ATT_CID = 0x0004
pub const ATT_SERVER_MTU = 23
pub const ATT_LAST_HANDLE = 0x0032
pub const ATT_OP_ERROR_RSP = 0x01
pub const ATT_OP_EXCHANGE_MTU_REQ = 0x02
pub const ATT_OP_EXCHANGE_MTU_RSP = 0x03
pub const ATT_OP_FIND_INFO_REQ = 0x04
pub const ATT_OP_FIND_INFO_RSP = 0x05
pub const ATT_OP_FIND_BY_TYPE_VALUE_REQ = 0x06
pub const ATT_OP_FIND_BY_TYPE_VALUE_RSP = 0x07
pub const ATT_OP_READ_BY_TYPE_REQ = 0x08
pub const ATT_OP_READ_BY_TYPE_RSP = 0x09
pub const ATT_OP_READ_REQ = 0x0A
pub const ATT_OP_READ_RSP = 0x0B
pub const ATT_OP_READ_BLOB_REQ = 0x0C
pub const ATT_OP_READ_BLOB_RSP = 0x0D
pub const ATT_OP_READ_BY_GROUP_TYPE_REQ = 0x10
pub const ATT_OP_READ_BY_GROUP_TYPE_RSP = 0x11
pub const ATT_OP_WRITE_REQ = 0x12
pub const ATT_OP_WRITE_RSP = 0x13
pub const ATT_OP_HANDLE_VALUE_NTF = 0x1B
pub const ATT_OP_WRITE_CMD = 0x52
pub const ATT_ERR_INVALID_HANDLE = 0x01
pub const ATT_ERR_READ_NOT_PERMITTED = 0x02
pub const ATT_ERR_WRITE_NOT_PERMITTED = 0x03
pub const ATT_ERR_INVALID_PDU = 0x04
pub const ATT_ERR_REQUEST_NOT_SUPPORTED = 0x06
pub const ATT_ERR_INVALID_OFFSET = 0x07
pub const ATT_ERR_ATTR_NOT_FOUND = 0x0A
pub const ATT_ERR_INVALID_VALUE_LENGTH = 0x0D
pub const ATT_ERR_INSUFFICIENT_ENCRYPTION = 0x0F
pub const ATT_ERR_UNSUPPORTED_GROUP_TYPE = 0x10
pub const ATT_ERR_VALUE_NOT_ALLOWED = 0x13

pub struct AttServer {
    pub mtu int
    pub notifications_enabled bool // aggregate compatibility view; never authorizes a report
    pub dev_name string
    pub encrypted bool
    pub suspended bool
    pub mouse_cccd int
    pub keyboard_cccd int
    pub consumer_cccd int
    pub service_changed_cccd int
    report_map []int
    mouse_value []int
    keyboard_value []int
    consumer_value []int
}

pub fn att_server_create(name string) AttServer {
    << AttServer{
        mtu: ATT_SERVER_MTU, notifications_enabled: false, dev_name: name,
        encrypted: false, suspended: false,
        mouse_cccd: 0, keyboard_cccd: 0, consumer_cccd: 0, service_changed_cccd: 0,
        report_map: hogp_report_map(), mouse_value: hci_zeros(5),
        keyboard_value: hci_zeros(8), consumer_value: hci_zeros(1)
    }
}

// Call only from verified HCI Encryption Change handling, not from an ATT
// request or a mere connection event. This does not implement pairing.
pub fn (s $&AttServer) set_link_encrypted(encrypted bool) {
    s.encrypted = encrypted
}

pub fn (s $&AttServer) reset_link() {
    s.mtu = ATT_SERVER_MTU
    s.encrypted = false
    s.suspended = false
    s.mouse_cccd = 0
    s.keyboard_cccd = 0
    s.consumer_cccd = 0
    s.service_changed_cccd = 0
    s.notifications_enabled = false
    for i in 0:5 { s.mouse_value[i] = 0 }
    for i in 0:8 { s.keyboard_value[i] = 0 }
    s.consumer_value[0] = 0
}

fn att_byte(bytes &[]int, i int) int {
    $view := bytes
    << view[i] & 255
}

fn att_word(bytes &[]int, i int) int {
    << att_byte(bytes, i) | (att_byte(bytes, i + 1) << 8)
}

fn att_push_word(bytes $&[]int, value int) {
    bytes.push(value & 255)
    bytes.push((value >> 8) & 255)
}

pub fn att_error_response(request int, handle int, code int) []int {
    $out := []int{}
    out.push(ATT_OP_ERROR_RSP)
    out.push(request & 255)
    att_push_word($&out, handle)
    out.push(code)
    << out
}

// GAP 1..7; GATT 8..B; Device Information C..10; HID 16..32.
// Unassigned handles are not fabricated attributes. Boot Protocol mode is
// not advertised: all three reports use Report Protocol and Report IDs.
fn att_uuid(handle int) int {
    if handle == 1 || handle == 8 || handle == 0xC || handle == 0x16 { << 0x2800 }
    if handle == 2 || handle == 4 || handle == 6 || handle == 9 || handle == 0xD ||
        handle == 0xF || handle == 0x17 || handle == 0x19 || handle == 0x1F ||
        handle == 0x27 || handle == 0x2B || handle == 0x2F { << 0x2803 }
    if handle == 3 { << 0x2A00 }
    if handle == 5 { << 0x2A01 }
    if handle == 7 { << 0x2A04 }
    if handle == 0xA { << 0x2A05 }
    if handle == 0xE { << 0x2A29 }
    if handle == 0x10 { << 0x2A24 }
    if handle == 0x18 { << 0x2A4A }
    if handle == 0x1A { << 0x2A4C }
    if handle == 0x20 { << 0x2A4B }
    if handle == 0x28 || handle == 0x2C || handle == 0x30 { << 0x2A4D }
    if handle == 0xB || handle == 0x29 || handle == 0x2D || handle == 0x31 { << 0x2902 }
    if handle == 0x2A || handle == 0x2E || handle == 0x32 { << 0x2908 }
    << 0
}

fn att_group_end(handle int) int {
    if handle == 1 { << 7 }
    if handle == 8 { << 0xB }
    if handle == 0xC { << 0x10 }
    if handle == 0x16 { << 0x32 }
    << handle
}

fn att_service_uuid(handle int) int {
    if handle == 1 { << 0x1800 }
    if handle == 8 { << 0x1801 }
    if handle == 0xC { << 0x180A }
    if handle == 0x16 { << 0x1812 }
    << 0
}

fn att_properties(declaration int) int {
    if declaration == 9 { << 0x20 } // Service Changed: indicate
    if declaration == 0x19 { << 0x04 } // HID Control Point: write without response
    if declaration == 0x27 || declaration == 0x2B || declaration == 0x2F { << 0x12 }
    << 0x02
}

fn att_read_error(s &AttServer, handle int) int {
    uuid := att_uuid(handle)
    if uuid == 0 { << ATT_ERR_INVALID_HANDLE }
    if handle == 0x1A || handle == 0xA { << ATT_ERR_READ_NOT_PERMITTED }
    // Discoveries remain available before pairing; actual HID values and
    // descriptors require link encryption. No ATT operation can set it.
    if handle >= 0x16 && uuid != 0x2800 && uuid != 0x2803 && !s.encrypted {
        << ATT_ERR_INSUFFICIENT_ENCRYPTION
    }
    << 0
}

fn att_value_length(s &AttServer, handle int) int {
    uuid := att_uuid(handle)
    if uuid == 0x2800 { << 2 }
    if uuid == 0x2803 { << 5 }
    if uuid == 0x2902 || uuid == 0x2908 || handle == 5 { << 2 }
    if handle == 3 { << s.dev_name.len }
    if handle == 7 || handle == 0x2C { << 8 }
    if handle == 0x18 { << 4 }
    if handle == 0x28 { << 5 }
    if handle == 0x20 { << s.report_map.len }
    if handle == 0xE { << 6 }
    if handle == 0x10 { << 11 }
    if handle == 0x30 { << 1 }
    << 0
}

fn att_value_byte(s &AttServer, handle int, i int) int {
    uuid := att_uuid(handle)
    if uuid == 0x2800 { << (att_service_uuid(handle) >> (i * 8)) & 255 }
    if uuid == 0x2803 {
        if i == 0 { << att_properties(handle) }
        if i < 3 { << ((handle + 1) >> ((i - 1) * 8)) & 255 }
        << (att_uuid(handle + 1) >> ((i - 3) * 8)) & 255
    }
    if handle == 3 { << s.dev_name[i] & 255 }
    if handle == 5 { if i == 0 { << 0xC2 } << 0x03 }
    if handle == 7 {
        if i == 0 { << 6 }
        if i == 2 { << 12 }
        if i == 6 { << 0x90 }
        if i == 7 { << 1 }
        << 0
    }
    if handle == 0xE { value := "XuLang"
        << value[i] }
    if handle == 0x10 { value := "Pure Xu HID"
        << value[i] }
    if handle == 0x18 {
        if i == 0 { << 0x11 }
        if i == 1 { << 1 }
        if i == 3 { << 2 }
        << 0
    }
    if handle == 0x20 { << att_byte(&s.report_map, i) }
    if handle == 0x28 { << att_byte(&s.mouse_value, i) }
    if handle == 0x2C { << att_byte(&s.keyboard_value, i) }
    if handle == 0x30 { << att_byte(&s.consumer_value, i) }
    if uuid == 0x2908 {
        if i == 1 { << 1 } // Report Type: Input
        if handle == 0x2A { << HID_RPT_ID_MOUSE }
        if handle == 0x2E { << HID_RPT_ID_KEYBOARD }
        << HID_RPT_ID_CONSUMER
    }
    if uuid == 0x2902 {
        if i == 1 { << 0 }
        if handle == 0x29 { << s.mouse_cccd }
        if handle == 0x2D { << s.keyboard_cccd }
        if handle == 0x31 { << s.consumer_cccd }
        << s.service_changed_cccd
    }
    << 0
}

// Normalize a 16-bit UUID or its Bluetooth Base UUID 128-bit encoding.
fn att_request_uuid(pdu &[]int, offset int, length int) int {
    if length == 2 { << att_word(pdu, offset) }
    if length != 16 { << -1 }
    if att_byte(pdu, offset) != 0xFB || att_byte(pdu, offset + 1) != 0x34 ||
        att_byte(pdu, offset + 2) != 0x9B || att_byte(pdu, offset + 3) != 0x5F ||
        att_byte(pdu, offset + 4) != 0x80 || att_byte(pdu, offset + 5) != 0 ||
        att_byte(pdu, offset + 6) != 0 || att_byte(pdu, offset + 7) != 0x80 ||
        att_byte(pdu, offset + 8) != 0 || att_byte(pdu, offset + 9) != 0x10 ||
        att_byte(pdu, offset + 10) != 0 || att_byte(pdu, offset + 11) != 0 ||
        att_byte(pdu, offset + 14) != 0 || att_byte(pdu, offset + 15) != 0 { << -1 }
    << att_word(pdu, offset + 12)
}

fn att_read(s &AttServer, opcode int, handle int, offset int) []int {
    error := att_read_error(s, handle)
    if error != 0 { << att_error_response(opcode, handle, error) }
    length := att_value_length(s, handle)
    if offset > length { << att_error_response(opcode, handle, ATT_ERR_INVALID_OFFSET) }
    $out := []int{}
    if opcode == ATT_OP_READ_REQ { out.push(ATT_OP_READ_RSP) }
    else { out.push(ATT_OP_READ_BLOB_RSP) }
    $end := length
    if end > offset + s.mtu - 1 { end = offset + s.mtu - 1 }
    for i in offset:end { out.push(att_value_byte(s, handle, i)) }
    << out
}

fn att_discover(s &AttServer, pdu &[]int) []int {
    opcode := att_byte(pdu, 0)
    start := att_word(pdu, 1)
    end := att_word(pdu, 3)
    if start == 0 || start > end { << att_error_response(opcode, start, ATT_ERR_INVALID_HANDLE) }
    $uuid := 0
    if opcode != ATT_OP_FIND_INFO_REQ { uuid = att_request_uuid(pdu, 5, pdu.len - 5) }
    if opcode == ATT_OP_READ_BY_GROUP_TYPE_REQ && uuid != 0x2800 && uuid != 0x2801 {
        << att_error_response(opcode, start, ATT_ERR_UNSUPPORTED_GROUP_TYPE)
    }
    $out := []int{}
    out.push(opcode + 1)
    if opcode == ATT_OP_FIND_INFO_REQ { out.push(1) }
    else { out.push(0) }
    $item_length := 0
    for handle in 1:51 {
        if handle < start || handle > end { -> }
        attribute_uuid := att_uuid(handle)
        if attribute_uuid == 0 { -> }
        if opcode == ATT_OP_FIND_INFO_REQ {
            if out.len + 4 > s.mtu { <- }
            att_push_word($&out, handle)
            att_push_word($&out, attribute_uuid)
        } else if attribute_uuid == uuid {
            if opcode == ATT_OP_READ_BY_GROUP_TYPE_REQ {
                if out.len + 6 > s.mtu { <- }
                out[1] = 6
                att_push_word($&out, handle)
                $last := att_group_end(handle)
                if last > end { last = end }
                att_push_word($&out, last)
                att_push_word($&out, att_service_uuid(handle))
            } else {
                error := att_read_error(s, handle)
                if error != 0 {
                    if out.len > 2 { <- }
                    << att_error_response(opcode, handle, error)
                }
                $length := att_value_length(s, handle)
                if length > s.mtu - 4 { length = s.mtu - 4 }
                if item_length != 0 && item_length != length + 2 { <- }
                item_length = length + 2
                if out.len + item_length > s.mtu { <- }
                out[1] = item_length
                att_push_word($&out, handle)
                for i in 0:length { out.push(att_value_byte(s, handle, i)) }
            }
        }
    }
    if out.len == 2 { << att_error_response(opcode, start, ATT_ERR_ATTR_NOT_FOUND) }
    << out
}

fn att_find_service(s &AttServer, pdu &[]int) []int {
    start := att_word(pdu, 1)
    end := att_word(pdu, 3)
    if start == 0 || start > end { << att_error_response(6, start, ATT_ERR_INVALID_HANDLE) }
    // GATT primary-service discovery by UUID. Other types have no groups.
    if att_word(pdu, 5) != 0x2800 { << att_error_response(6, start, ATT_ERR_ATTR_NOT_FOUND) }
    uuid := att_request_uuid(pdu, 7, pdu.len - 7)
    $out := []int{}
    out.push(ATT_OP_FIND_BY_TYPE_VALUE_RSP)
    for handle in 1:51 {
        if handle < start || handle > end || att_service_uuid(handle) != uuid { -> }
        if out.len + 4 > s.mtu { <- }
        att_push_word($&out, handle)
        $last := att_group_end(handle)
        if last > end { last = end }
        att_push_word($&out, last)
    }
    if out.len == 1 { << att_error_response(6, start, ATT_ERR_ATTR_NOT_FOUND) }
    << out
}

fn att_write(s $&AttServer, pdu &[]int) []int {
    opcode := att_byte(pdu, 0)
    handle := att_word(pdu, 1)
    $error := 0
    uuid := att_uuid(handle)
    if uuid == 0 { error = ATT_ERR_INVALID_HANDLE }
    else if uuid != 0x2902 && handle != 0x1A { error = ATT_ERR_WRITE_NOT_PERMITTED }
    else if !s.encrypted { error = ATT_ERR_INSUFFICIENT_ENCRYPTION }
    else if handle == 0x1A {
        if pdu.len != 4 { error = ATT_ERR_INVALID_VALUE_LENGTH }
        else if att_byte(pdu, 3) > 1 { error = ATT_ERR_VALUE_NOT_ALLOWED }
        else { s.suspended = att_byte(pdu, 3) == 0 }
    } else if pdu.len != 5 { error = ATT_ERR_INVALID_VALUE_LENGTH }
    else {
        value := att_word(pdu, 3)
        if (handle == 0xB && value != 0 && value != 2) ||
            (handle != 0xB && value != 0 && value != 1) { error = ATT_ERR_VALUE_NOT_ALLOWED }
        else {
            if handle == 0x29 { s.mouse_cccd = value }
            else if handle == 0x2D { s.keyboard_cccd = value }
            else if handle == 0x31 { s.consumer_cccd = value }
            else { s.service_changed_cccd = value }
            s.notifications_enabled = s.mouse_cccd != 0 || s.keyboard_cccd != 0 || s.consumer_cccd != 0
        }
    }
    if opcode == ATT_OP_WRITE_CMD { << []int{} }
    if error != 0 { << att_error_response(opcode, handle, error) }
    $out := []int{}
    out.push(ATT_OP_WRITE_RSP)
    << out
}

pub fn (s $&AttServer) handle_att_pdu(pdu &[]int) []int {
    if pdu.len == 0 { << []int{} }
    opcode := att_byte(pdu, 0)
    if pdu.len > s.mtu {
        if (opcode & 0x40) != 0 { << []int{} }
        << att_error_response(opcode, 0, ATT_ERR_INVALID_PDU)
    }
    if opcode == ATT_OP_EXCHANGE_MTU_REQ {
        if pdu.len != 3 || att_word(pdu, 1) < 23 { << att_error_response(opcode, 0, ATT_ERR_INVALID_PDU) }
        s.mtu = ATT_SERVER_MTU
        $out := []int{}
        out.push(ATT_OP_EXCHANGE_MTU_RSP)
        att_push_word($&out, ATT_SERVER_MTU)
        << out
    }
    if opcode == ATT_OP_FIND_INFO_REQ {
        if pdu.len != 5 { << att_error_response(opcode, 0, ATT_ERR_INVALID_PDU) }
        << att_discover(s, pdu)
    }
    if opcode == ATT_OP_READ_BY_TYPE_REQ || opcode == ATT_OP_READ_BY_GROUP_TYPE_REQ {
        if pdu.len != 7 && pdu.len != 21 { << att_error_response(opcode, 0, ATT_ERR_INVALID_PDU) }
        << att_discover(s, pdu)
    }
    if opcode == ATT_OP_FIND_BY_TYPE_VALUE_REQ {
        if pdu.len < 7 { << att_error_response(opcode, 0, ATT_ERR_INVALID_PDU) }
        << att_find_service(s, pdu)
    }
    if opcode == ATT_OP_READ_REQ || opcode == ATT_OP_READ_BLOB_REQ {
        if (opcode == ATT_OP_READ_REQ && pdu.len != 3) ||
            (opcode == ATT_OP_READ_BLOB_REQ && pdu.len != 5) {
            << att_error_response(opcode, 0, ATT_ERR_INVALID_PDU)
        }
        $offset := 0
        if opcode == ATT_OP_READ_BLOB_REQ { offset = att_word(pdu, 3) }
        << att_read(s, opcode, att_word(pdu, 1), offset)
    }
    if opcode == ATT_OP_WRITE_REQ || opcode == ATT_OP_WRITE_CMD {
        if pdu.len < 3 {
            if opcode == ATT_OP_WRITE_CMD { << []int{} }
            << att_error_response(opcode, 0, ATT_ERR_INVALID_PDU)
        }
        << att_write(s, pdu)
    }
    // Never answer commands, peer responses, or Handle Value Confirmation.
    if (opcode & 0x40) != 0 || (opcode & 1) != 0 || opcode == 0x1E { << []int{} }
    << att_error_response(opcode, 0, ATT_ERR_REQUEST_NOT_SUPPORTED)
}

fn att_invalid_packet() HciPacket {
    << HciPacket{valid: false, kind: 0, opcode: 0, handle: 0, len: 0, payload: []int{}}
}

// Only complete, single-SDU ACL packets are accepted. A transport with a
// smaller controller ACL buffer must reassemble continuation packets before
// calling this method; truncated/concatenated SDUs are never indexed.
pub fn (s $&AttServer) process_acl_packet(packet &HciPacket) HciPacket {
    if !packet.valid || packet.kind != HCI_PKT_ACLDATA || packet.len < 4 ||
        packet.len != packet.payload.len || (packet.handle & 0xC000) != 0 ||
        (packet.handle & 0x3000) == 0x1000 || (packet.handle & 0x3000) == 0x3000 {
        << att_invalid_packet()
    }
    $payload := &packet.payload
    length := att_word(payload, 0)
    if att_word(payload, 2) != ATT_CID || length < 1 || length + 4 != packet.len {
        << att_invalid_packet()
    }
    $request := []int{}
    for i in 0:length { request.push(att_byte(payload, i + 4)) }
    response := s.handle_att_pdu(&request)
    if response.len == 0 { << att_invalid_packet() }
    $out := []int{}
    att_push_word($&out, response.len)
    att_push_word($&out, ATT_CID)
    for i in 0:response.len { out.push(att_byte(&response, i)) }
    << hci_packet_acl(packet.handle & 0x0FFF, out)
}

pub fn (s &AttServer) report_notifications_enabled(handle int) bool {
    if !s.encrypted || s.suspended { << false }
    if handle == ATT_HANDLE_MOUSE_REPORT { << s.mouse_cccd == 1 }
    if handle == ATT_HANDLE_KEYBOARD_REPORT { << s.keyboard_cccd == 1 }
    if handle == ATT_HANDLE_CONSUMER_REPORT { << s.consumer_cccd == 1 }
    << false
}

// Prefer this method over the raw HOGP packet builder: it enforces the
// selected characteristic's CCCD, encrypted link, report length and suspend.
pub fn (s $&AttServer) make_hid_notification(connection int, handle int, report []int) HciPacket {
    if connection < 0 || connection > 0x0EFF || !s.report_notifications_enabled(handle) {
        << att_invalid_packet()
    }
    $expected := 0
    if handle == ATT_HANDLE_MOUSE_REPORT { expected = 5 }
    if handle == ATT_HANDLE_KEYBOARD_REPORT { expected = 8 }
    if handle == ATT_HANDLE_CONSUMER_REPORT { expected = 1 }
    if report.len != expected { << att_invalid_packet() }
    for i in 0:report.len { if report[i] < 0 || report[i] > 255 { << att_invalid_packet() } }
    if handle == ATT_HANDLE_MOUSE_REPORT {
        if report[0] > 7 { << att_invalid_packet() }
        x := report[1] | (report[2] << 8)
        y := report[3] | (report[4] << 8)
        if x > HID_MOUSE_ABS_MAX || y > HID_MOUSE_ABS_MAX { << att_invalid_packet() }
    }
    if handle == ATT_HANDLE_KEYBOARD_REPORT {
        if report[1] != 0 { << att_invalid_packet() }
        for i in 2:8 { if report[i] > 0x73 { << att_invalid_packet() } }
    }
    if handle == ATT_HANDLE_CONSUMER_REPORT && report[0] > 0x1F { << att_invalid_packet() }
    packet := hogp_make_acl_notification_ref(connection, handle, &report)
    if handle == ATT_HANDLE_MOUSE_REPORT {
        for i in 0:5 { s.mouse_value[i] = report[i] }
    } else if handle == ATT_HANDLE_KEYBOARD_REPORT {
        for i in 0:8 { s.keyboard_value[i] = report[i] }
    } else { s.consumer_value[0] = report[0] }
    << packet
}
