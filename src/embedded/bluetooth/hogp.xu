@embedded/bluetooth

// HID Over GATT Profile (HOGP) & USB HID Report Map
//
// Defines the standard BLE HID Report Descriptor matching iOS/macOS/Android,
// and builders for Mouse, Consumer Control (Volume Up / Down / Home), and Keyboard.

pub const HID_RPT_ID_MOUSE    = 1
pub const HID_RPT_ID_KEYBOARD = 2
pub const HID_RPT_ID_CONSUMER = 3

// Standard USB HID Consumer Usage Codes
pub const HID_CC_VOLUME_UP   = 0x01
pub const HID_CC_VOLUME_DOWN = 0x02
pub const HID_CC_MUTE        = 0x04
pub const HID_CC_POWER       = 0x08
pub const HID_CC_MENU        = 0x10

// GATT Handles for HID Attributes
pub const ATT_HANDLE_MOUSE_REPORT    = 0x0028
pub const ATT_HANDLE_KEYBOARD_REPORT = 0x002C
pub const ATT_HANDLE_CONSUMER_REPORT = 0x0030

// Standard BLE HID Report Map (136 bytes)
pub fn hogp_report_map() []int {
    $m := []int{}
    // Mouse Report (ID 1)
    m.push(0x05)
    m.push(0x01) // Usage Page (Generic Desktop)
    m.push(0x09)
    m.push(0x02) // Usage (Mouse)
    m.push(0xA1)
    m.push(0x01) // Collection (Application)
    m.push(0x85)
    m.push(0x01) //   Report ID (1)
    m.push(0x09)
    m.push(0x01) //   Usage (Pointer)
    m.push(0xA1)
    m.push(0x00) //   Collection (Physical)
    m.push(0x05)
    m.push(0x09) //     Usage Page (Buttons)
    m.push(0x19)
    m.push(0x01) //     Usage Min (1)
    m.push(0x29)
    m.push(0x03) //     Usage Max (3)
    m.push(0x15)
    m.push(0x00) //     Logical Min (0)
    m.push(0x25)
    m.push(0x01) //     Logical Max (1)
    m.push(0x75)
    m.push(0x01) //     Report Size (1)
    m.push(0x95)
    m.push(0x03) //     Report Count (3)
    m.push(0x81)
    m.push(0x02) //     Input (Data, Var, Abs)
    m.push(0x75)
    m.push(0x05) //     Report Size (5)
    m.push(0x95)
    m.push(0x01) //     Report Count (1)
    m.push(0x81)
    m.push(0x01) //     Input (Const)
    m.push(0x05)
    m.push(0x01) //     Usage Page (Generic Desktop)
    m.push(0x09)
    m.push(0x30) //     Usage (X)
    m.push(0x09)
    m.push(0x31) //     Usage (Y)
    m.push(0x09)
    m.push(0x38) //     Usage (Wheel)
    m.push(0x15)
    m.push(0x81) //     Logical Min (-127)
    m.push(0x25)
    m.push(0x7F) //     Logical Max (127)
    m.push(0x75)
    m.push(0x08) //     Report Size (8)
    m.push(0x95)
    m.push(0x03) //     Report Count (3)
    m.push(0x81)
    m.push(0x06) //     Input (Data, Var, Rel)
    m.push(0xC0) //   End Collection
    m.push(0xC0) // End Collection

    // Keyboard Report (ID 2)
    m.push(0x05)
    m.push(0x01) // Usage Page (Generic Desktop)
    m.push(0x09)
    m.push(0x06) // Usage (Keyboard)
    m.push(0xA1)
    m.push(0x01) // Collection (Application)
    m.push(0x85)
    m.push(0x02) //   Report ID (2)
    m.push(0x05)
    m.push(0x07) //   Usage Page (Key Codes)
    m.push(0x19)
    m.push(0xE0) //   Usage Min (224)
    m.push(0x29)
    m.push(0xE7) //   Usage Max (231)
    m.push(0x15)
    m.push(0x00) //   Logical Min (0)
    m.push(0x25)
    m.push(0x01) //   Logical Max (1)
    m.push(0x75)
    m.push(0x01) //   Report Size (1)
    m.push(0x95)
    m.push(0x08) //   Report Count (8)
    m.push(0x81)
    m.push(0x02) //   Input (Data, Var, Abs)
    m.push(0x95)
    m.push(0x01) //   Report Count (1)
    m.push(0x75)
    m.push(0x08) //   Report Size (8)
    m.push(0x81)
    m.push(0x01) //   Input (Const)
    m.push(0x95)
    m.push(0x06) //   Report Count (6)
    m.push(0x75)
    m.push(0x08) //   Report Size (8)
    m.push(0x15)
    m.push(0x00) //   Logical Min (0)
    m.push(0x25)
    m.push(0x73) //   Logical Max (115): includes F13 through F24
    m.push(0x05)
    m.push(0x07) //   Usage Page (Key Codes)
    m.push(0x19)
    m.push(0x00) //   Usage Min (0)
    m.push(0x29)
    m.push(0x73) //   Usage Max (115 / F24)
    m.push(0x81)
    m.push(0x00) //   Input (Data, Array)
    m.push(0xC0) // End Collection

    // Consumer Devices (ID 3)
    m.push(0x05)
    m.push(0x0C) // Usage Page (Consumer Devices)
    m.push(0x09)
    m.push(0x01) // Usage (Consumer Control)
    m.push(0xA1)
    m.push(0x01) // Collection (Application)
    m.push(0x85)
    m.push(0x03) //   Report ID (3)
    m.push(0x09)
    m.push(0xE9) //   Usage (Volume Up)
    m.push(0x09)
    m.push(0xEA) //   Usage (Volume Down)
    m.push(0x09)
    m.push(0xE2) //   Usage (Mute)
    m.push(0x09)
    m.push(0x30) //   Usage (Power)
    m.push(0x09)
    m.push(0x40) //   Usage (Menu / Home)
    m.push(0x15)
    m.push(0x00) //   Logical Min (0)
    m.push(0x25)
    m.push(0x01) //   Logical Max (1)
    m.push(0x75)
    m.push(0x01) //   Report Size (1)
    m.push(0x95)
    m.push(0x05) //   Report Count (5)
    m.push(0x81)
    m.push(0x02) //   Input (Data, Var, Abs)
    m.push(0x75)
    m.push(0x03) //   Report Size (3)
    m.push(0x95)
    m.push(0x01) //   Report Count (1)
    m.push(0x81)
    m.push(0x01) //   Input (Const)
    m.push(0xC0) // End Collection
    << m
}

// Build Mouse Report (Report ID 1)
fn hogp_relative_byte(value int) int {
    if value < -127 { << 0x81 }
    if value > 127 { << 0x7F }
    << value & 0xFF
}

pub fn hogp_build_mouse(buttons int, dx int, dy int, wheel int) []int {
    $r := []int{}
    r.push(buttons & 0x07)
    r.push(hogp_relative_byte(dx))
    r.push(hogp_relative_byte(dy))
    r.push(hogp_relative_byte(wheel))
    << r
}

// Build Consumer Control Report (Report ID 3)
pub fn hogp_build_consumer(mask int) []int {
    $r := []int{}
    r.push(mask & 0x1F)
    << r
}

// Build Keyboard Report (Report ID 2)
pub fn hogp_build_keyboard(modifier int, keycode int) []int {
    $r := []int{}
    r.push(modifier & 0xFF)
    r.push(0) // reserved
    r.push(keycode & 0xFF)
    r.push(0)
    r.push(0)
    r.push(0)
    r.push(0)
    r.push(0)
    << r
}

// Raw wire builder only: it does not imply encryption or a subscribed CCCD.
// Use AttServer.make_hid_notification for the connection's permission gate.
pub fn hogp_make_acl_notification(conn_handle int, att_handle int, report []int) HciPacket {
    << hogp_make_acl_notification_ref(conn_handle, att_handle, &report)
}

pub fn hogp_make_acl_notification_ref(conn_handle int, att_handle int, report &[]int) HciPacket {
    $l2cap := []int{}
    length := 3 + report.len
    l2cap.push(length & 255)
    l2cap.push((length >> 8) & 255)
    l2cap.push(0x04)
    l2cap.push(0x00)
    l2cap.push(0x1B)
    l2cap.push(att_handle & 255)
    l2cap.push((att_handle >> 8) & 255)
    for i in 0:report.len { l2cap.push(report[i] & 255) }
    << hci_packet_acl(conn_handle, l2cap)
}
