@embedded/bluetooth/control

// Bounded command envelope. Identifiers and operation names are ASCII;
// commands never contain credentials or arbitrary GATT/MMIO writes.
pub const STATUS = 1
pub const ADVERTISING_START = 2
pub const ADVERTISING_STOP = 3
pub const DISCONNECT = 4
pub const RELEASE_ALL = 5
pub const KEYBOARD = 6
pub const MOUSE = 7
pub const CONSUMER = 8

pub struct Command {
    pub valid bool
    pub id string
    pub op int
    pub report []int
}
fn empty() Command { << Command{valid: false,id: "",op: 0,report: []int{}} }
fn space(bytes &string, at int) int {
    $i := at
    while i < bytes.len && (bytes[i] == 32 || bytes[i] == 9 || bytes[i] == 10 || bytes[i] == 13) { i += 1 }
    << i
}
fn part(bytes &string, start int, count int) string {
    $out := make_string(count)
    for i in 0:count { out[i] = bytes[start + i] }
    << out
}
fn string_end(bytes &string, at int) int {
    if at >= bytes.len || bytes[at] != 34 { << -1 }
    for i in at + 1:bytes.len {
        if bytes[i] == 34 { << i }
        if bytes[i] < 32 || bytes[i] > 126 || bytes[i] == 92 { << -1 }
    }
    << -1
}
fn id_valid(id &string) bool {
    if id.len < 1 || id.len > 64 { << false }
    for i in 0:id.len {
        c := id[i]
        if !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95) { << false }
    }
    << true
}
fn report_valid(command &Command) bool {
    op := command.op
    report := &command.report
    if op == STATUS || op == ADVERTISING_START || op == ADVERTISING_STOP || op == DISCONNECT || op == RELEASE_ALL { << report.len == 0 }
    if op == KEYBOARD {
        if report.len != 8 || report[1] != 0 { << false }
        for i in 2:8 { if report[i] > 115 { << false } }
        << true
    }
    if op == MOUSE {
        << report.len == 4 && report[0] <= 7 && report[1] != 128 && report[2] != 128 && report[3] != 128
    }
    if op == CONSUMER { << report.len == 1 && report[0] <= 31 }
    << false
}
fn parse_fields(bytes &string, out $&Command) bool {
    if bytes.len > 512 { << false }
    $at := space(bytes,0)
    if at >= bytes.len || bytes[at] != 123 { << false }
    at = space(bytes,at + 1)
    $seen := 0
    while at < bytes.len && bytes[at] != 125 {
        last := string_end(bytes,at)
        if last < 0 { << false }
        name := part(bytes,at + 1,last - at - 1)
        at = space(bytes,last + 1)
        if at >= bytes.len || bytes[at] != 58 { << false }
        at = space(bytes,at + 1)
        if name == "id" || name == "op" {
            $bit := 1
            if name == "op" { bit = 2 }
            if (seen & bit) != 0 { << false }
            end := string_end(bytes,at)
            if end < 0 { << false }
            value := part(bytes,at + 1,end - at - 1)
            if bit == 1 { out.id = value } else { out.op = operation(&value) }
            seen = seen | bit
            at = space(bytes,end + 1)
        } else if name == "report" {
            if (seen & 4) != 0 || at >= bytes.len || bytes[at] != 91 { << false }
            seen = seen | 4
            at = space(bytes,at + 1)
            while at < bytes.len && bytes[at] != 93 {
                if out.report.len >= 8 || bytes[at] < 48 || bytes[at] > 57 { << false }
                $value := 0
                $digits := 0
                $zero := false
                while at < bytes.len && bytes[at] >= 48 && bytes[at] <= 57 {
                    if digits == 0 && bytes[at] == 48 { zero = true }
                    if digits > 0 && zero { << false }
                    value = value * 10 + bytes[at] - 48
                    if value > 255 { << false }
                    digits += 1
                    at += 1
                }
                out.report.push(value)
                at = space(bytes,at)
                if at < bytes.len && bytes[at] == 44 {
                    at = space(bytes,at + 1)
                    if at >= bytes.len || bytes[at] == 93 { << false }
                } else { <- }
            }
            if at >= bytes.len || bytes[at] != 93 { << false }
            at = space(bytes,at + 1)
        } else { << false }
        if at < bytes.len && bytes[at] == 44 {
            at = space(bytes,at + 1)
            if at >= bytes.len || bytes[at] == 125 { << false }
        } else { <- }
    }
    if at >= bytes.len || bytes[at] != 125 || space(bytes,at + 1) != bytes.len || (seen & 3) != 3 ||
        !id_valid(&out.id) || !report_valid(out) { << false }
    << true
}

fn operation(name &string) int {
    if *name == "status" { << STATUS }
    if *name == "advertising.start" { << ADVERTISING_START }
    if *name == "advertising.stop" { << ADVERTISING_STOP }
    if *name == "disconnect" { << DISCONNECT }
    if *name == "release.all" { << RELEASE_ALL }
    if *name == "hid.keyboard" { << KEYBOARD }
    if *name == "hid.mouse" { << MOUSE }
    if *name == "hid.consumer" { << CONSUMER }
    << 0
}
pub fn parse(bytes &string) Command {
    $out := empty()
    if parse_fields(bytes,$&out) { out.valid = true }
    else { out.id = ""
        out.op = 0
        out.report = []int{} }
    << out
}
