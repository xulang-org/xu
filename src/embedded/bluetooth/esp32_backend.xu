@embedded/bluetooth

// ESP32 Chip Hooks Implementation for embedded/bluetooth
// Moved here so that embedded/chips/esp32 does not pull in the entire Bluetooth stack unconditionally.

pub const DPORT_BT_LPCK_DIV_INT_REG   = 0x3FF000D4
pub const DPORT_BT_LPCK_DIV_FRAC_REG  = 0x3FF000D8

fn bt_not_mask(v int) int {
    << 0 - 1 - v
}

fn bt_esp32_lpclk_select_src(sel int) bool {
    if sel != BTDM_LPCLK_SEL_XTAL && sel != BTDM_LPCLK_SEL_XTAL32K &&
        sel != BTDM_LPCLK_SEL_RTC_SLOW && sel != BTDM_LPCLK_SEL_8M {
        << false
    }
    $frac := volatile_load(DPORT_BT_LPCK_DIV_FRAC_REG)
    frac = frac & bt_not_mask(BTDM_LPCK_SEL_MASK)
    if sel == BTDM_LPCLK_SEL_XTAL {
        frac = frac | BTDM_LPCK_SEL_XTAL
    } else if sel == BTDM_LPCLK_SEL_XTAL32K {
        frac = frac | BTDM_LPCK_SEL_XTAL32K
    } else if sel == BTDM_LPCLK_SEL_RTC_SLOW {
        frac = frac | BTDM_LPCK_SEL_RTC_SLOW
    } else {
        frac = frac | BTDM_LPCK_SEL_8M
    }
    volatile_store(DPORT_BT_LPCK_DIV_FRAC_REG, frac)
    << true
}

fn bt_esp32_lpclk_set_div(div int) bool {
    if div < 0 || div > 4095 { << false }
    $reg := volatile_load(DPORT_BT_LPCK_DIV_INT_REG)
    reg = reg & bt_not_mask(BTDM_LPCK_DIV_NUM_MASK)
    reg = reg | (div & BTDM_LPCK_DIV_NUM_MASK)
    volatile_store(DPORT_BT_LPCK_DIV_INT_REG, reg)
    << true
}

fn bt_esp32_lpclk_read_div() int {
    << volatile_load(DPORT_BT_LPCK_DIV_INT_REG) & BTDM_LPCK_DIV_NUM_MASK
}

fn bt_esp32_lpclk_read_src() int {
    << volatile_load(DPORT_BT_LPCK_DIV_FRAC_REG)
}

fn bt_esp32_wakeup_request() { }
fn bt_esp32_rf_init_phase2() { }

pub fn bt_backend_esp32() BtBackend {
    << BtBackend{
        lpclk_select_src: bt_esp32_lpclk_select_src,
        lpclk_set_div: bt_esp32_lpclk_set_div,
        lpclk_read_div: bt_esp32_lpclk_read_div,
        lpclk_read_src: bt_esp32_lpclk_read_src,
        wakeup_request: bt_esp32_wakeup_request,
        rf_init_phase2: bt_esp32_rf_init_phase2
    }
}

pub fn ble_btdm_create() BtdmController {
    $ctl := btdm_controller_create()
    ctl.backend = bt_backend_esp32()
    << ctl
}

pub fn ble_btdm_init(ctl $&BtdmController, mode int) bool {
    << btdm_controller_init(ctl, btdm_config_mask_load(), mode) == ESP_OK
}

pub fn ble_btdm_enable(ctl $&BtdmController) bool {
    << btdm_controller_enable(ctl, btdm_controller_get_mode(ctl)) == ESP_OK
}

pub fn ble_btdm_disable(ctl $&BtdmController) bool {
    << btdm_controller_disable(ctl) == ESP_OK
}
