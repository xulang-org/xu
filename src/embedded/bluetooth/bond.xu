@embedded/bluetooth

// Portable single-peer legacy bond storage codec. The 64 bytes contain keys;
// the platform owns storage and must not print or send this record to a log.
// This restores a key cache only: link encryption/CCCDs still require actual
// controller and ATT events. Peer identity resolution is not implemented.
pub const BOND_RECORD_BYTES = 64

pub fn bond_crc32(data &[]int, count int) int {
    if count < 0 || count > data.len { << 0 }
    $crc := 0xFFFFFFFF
    for i in 0:count {
        if data[i] < 0 || data[i] > 255 { << 0 }
        crc = crc ^ data[i]
        for bit in 0:8 {
            low := crc & 1
            crc = (crc >> 1) & 0x7FFFFFFF
            if low != 0 { crc = crc ^ 0xEDB88320 }
        }
    }
    << (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF
}

pub fn bond_record_valid(data &[]int) bool {
    if !smp_bytes_valid(data,64) { << false }
    if data[0] != 0x58 || data[1] != 0x55 || data[2] != 0x42 || data[3] != 0x31 ||
        data[4] != 1 || data[5] > 1 || data[6] > 1 || data[7] > 1 { << false }
    if data[46] != 0 || data[47] != 0 || data[50] != 0 || data[51] != 0 { << false }
    for i in 56:60 { if data[i] != 0 { << false } }
    if data[60] != 0x42 || data[61] != 0x4E || data[62] != 0x44 || data[63] != 0x31 { << false }
    if (data[48] | (data[49] << 8)) == 0 { << false }
    checksum := data[52] | (data[53] << 8) | (data[54] << 16) | (data[55] << 24)
    if checksum != bond_crc32(data,52) { << false }
    if data[7] == 0 {
        if data[6] != 0 { << false }
        for i in 14:46 { if data[i] != 0 { << false } }
    } else {
        $identifier := data[20] | data[21]
        for i in 22:30 { identifier = identifier | data[i] }
        if identifier == 0 { << false }
    }
    << true
}

pub fn bond_record_generation(data &[]int) int {
    if !bond_record_valid(data) { << 0 }
    << data[48] | (data[49] << 8)
}

// -1 no valid slot, -2 conflicting generations/content; no arbitrary choice.
pub fn bond_record_select(first &[]int, second &[]int) int {
    a := bond_record_generation(first)
    b := bond_record_generation(second)
    if a == 0 && b == 0 { << -1 }
    if a == 0 { << 1 }
    if b == 0 { << 0 }
    delta := (b - a) & 65535
    if delta == 0 {
        if smp_equal(first,second) { << 0 }
        << -2
    }
    if delta == 32768 { << -2 }
    if delta < 32768 { << 1 }
    << 0
}

pub fn bond_record_next_generation(generation int) int {
    if generation < 0 || generation > 65535 { << 0 }
    if generation == 65535 { << 1 }
    << generation + 1
}

fn bond_record_header(local_type int, local &[]int, generation int, active int) []int {
    if local_type < 0 || local_type > 1 || !smp_bytes_valid(local,6) ||
        generation < 1 || generation > 65535 || active < 0 || active > 1 { << []int{} }
    $out := hci_zeros(64)
    out[0] = 0x58
    out[1] = 0x55
    out[2] = 0x42
    out[3] = 0x31
    out[4] = 1
    out[5] = local_type
    out[7] = active
    for i in 0:6 { out[8 + i] = local[i] }
    out[48] = generation & 255
    out[49] = (generation >> 8) & 255
    out[60] = 0x42
    out[61] = 0x4E
    out[62] = 0x44
    out[63] = 0x31
    << out
}

fn bond_record_finish(data $&[]int) {
    checksum := bond_crc32(&*data,52)
    for i in 0:4 { data[52 + i] = (checksum >> (i * 8)) & 255 }
}

pub fn (h &PeripheralHost) bond_snapshot(generation int) []int {
    if !h.ready || !h.bond_available || h.bond_peer_type < 0 || h.bond_peer_type > 1 ||
        h.bond_ediv < 0 || h.bond_ediv > 65535 || !smp_bytes_valid(&h.bond_peer,6) ||
        !smp_bytes_valid(&h.bond_ltk,16) || !smp_bytes_valid(&h.bond_random,8) ||
        (h.bond_ediv == 0 && smp_all_zero(&h.bond_random)) { << []int{} }
    $out := bond_record_header(h.local_type,&h.local,generation,1)
    if out.len != 64 { << out }
    out[6] = h.bond_peer_type
    for i in 0:6 { out[14 + i] = h.bond_peer[i] }
    out[20] = h.bond_ediv & 255
    out[21] = (h.bond_ediv >> 8) & 255
    for i in 0:8 { out[22 + i] = h.bond_random[i] }
    for i in 0:16 { out[30 + i] = h.bond_ltk[i] }
    bond_record_finish($&out)
    << out
}

// Persist this higher-generation tombstone before retiring the old slot.
// Erasing both slots alone is not a power-fail-safe revocation operation.
pub fn (h &PeripheralHost) bond_clear_snapshot(generation int) []int {
    if !h.ready { << []int{} }
    $out := bond_record_header(h.local_type,&h.local,generation,0)
    if out.len == 64 { bond_record_finish($&out) }
    << out
}

pub fn (h $&PeripheralHost) restore_bond_snapshot(data &[]int) bool {
    if !h.ready || h.connected || h.closing || !bond_record_valid(data) || data[5] != h.local_type { << false }
    for i in 0:6 { if data[8 + i] != h.local[i] { << false } }
    // All validation precedes mutation; an invalid record cannot destroy
    // an already-restored valid key. Neither branch authorizes the link.
    for i in 0:6 { h.bond_peer[i] = data[14 + i] }
    for i in 0:8 { h.bond_random[i] = data[22 + i] }
    for i in 0:16 { h.bond_ltk[i] = data[30 + i] }
    h.bond_peer_type = data[6]
    h.bond_ediv = data[20] | (data[21] << 8)
    h.bond_available = data[7] == 1
    << true
}

// Avoid flash wear on an unchanged restored bond; generation/CRC are ignored.
pub fn bond_record_same_payload(first &[]int, second &[]int) bool {
    if !bond_record_valid(first) || !bond_record_valid(second) { << false }
    $difference := 0
    for i in 0:48 { difference = difference | (first[i] ^ second[i]) }
    << difference == 0
}
