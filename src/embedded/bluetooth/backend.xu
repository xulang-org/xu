@embedded/bluetooth

// Chip binding hooks for the portable BTDM core.
//
// The BTDM application layer is Espressif-generic: the same OSI table,
// controller lifecycle, VHCI transport and scheduler semantics serve esp32,
// esp32c3 and esp32s3.  Only a handful of operations touch chip registers or
// ROM entry points, and those sit behind this hook table so that the core
// package never imports a chip package.
//
// xu has no mutable package globals, so the hook table is carried by the
// caller: either standalone (when only the low power clock is needed) or
// inside a `BtdmController` instance.
//
// A chip package registers its implementation by filling the table, e.g.
//
//   import bt #embedded/bluetooth
//
//   $ctl := bt.btdm_controller_create()
//   ctl.backend = esp32.bt_backend_esp32()
//
// Every hook has a defined default, so a controller created without a chip
// binding still behaves predictably (the clock hooks report failure instead
// of touching an unknown register).

pub struct BtBackend {
    // Selects the low power clock source.  `sel` is one of
    // BTDM_LPCLK_SEL_XTAL / _XTAL32K / _RTC_SLOW / _8M.  Returns false when
    // the chip cannot honour the request.
    pub lpclk_select_src fn(int) bool

    // Writes the 12 bit integer divider of the low power clock.
    pub lpclk_set_div fn(int) bool

    // Reads the low power clock integer divider back.
    pub lpclk_read_div fn() int

    // Reads the low power clock source selection bits back.
    pub lpclk_read_src fn() int

    // Asks the radio to leave deep sleep.
    pub wakeup_request fn()

    // Second phase of the baseband / RF bring up, after the PHY is powered.
    pub rf_init_phase2 fn()
}

// ===== Default hooks =======================================================

fn bt_default_lpclk_select_src(sel int) bool { << false }

fn bt_default_lpclk_set_div(div int) bool { << false }

fn bt_default_lpclk_read_div() int { << 0 }

fn bt_default_lpclk_read_src() int { << 0 }

fn bt_default_wakeup_request() { }

fn bt_default_rf_init_phase2() { }

// A backend whose hooks do nothing but report failure.  Use it when the
// application does not drive the radio clock directly.
pub fn bt_default_backend() BtBackend {
    << BtBackend{
        lpclk_select_src: bt_default_lpclk_select_src,
        lpclk_set_div: bt_default_lpclk_set_div,
        lpclk_read_div: bt_default_lpclk_read_div,
        lpclk_read_src: bt_default_lpclk_read_src,
        wakeup_request: bt_default_wakeup_request,
        rf_init_phase2: bt_default_rf_init_phase2
    }
}

// ===== Portable primitives ==================================================
//
// A `fn` field cannot be called as a method, so each hook is taken out into
// a local first and then called.

pub fn bt_lpclk_select_src(backend &BtBackend, sel int) bool {
    $f := backend.lpclk_select_src
    << f(sel)
}

pub fn bt_lpclk_set_div(backend &BtBackend, div int) bool {
    $f := backend.lpclk_set_div
    << f(div)
}

pub fn bt_lpclk_read_div(backend &BtBackend) int {
    $f := backend.lpclk_read_div
    << f()
}

pub fn bt_lpclk_read_src(backend &BtBackend) int {
    $f := backend.lpclk_read_src
    << f()
}

pub fn bt_wakeup_request(backend &BtBackend) {
    $f := backend.wakeup_request
    f()
}

pub fn bt_rf_init_phase2(backend &BtBackend) {
    $f := backend.rf_init_phase2
    f()
}
