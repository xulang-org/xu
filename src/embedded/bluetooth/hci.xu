@embedded/bluetooth

// HCI Transport Framing (H4) for the Bluetooth controller.
//
// The ESP32 VHCI transport carries *H4 framed* HCI packets: every packet is
// prefixed with a one byte packet indicator.  This matches what the ESP-IDF
// host stack hands over:
//
//   bluedroid  components/bt/host/bluedroid/hci/hci_hal_h4.c:204
//              writes the type byte into data[0] and calls
//              esp_vhci_host_send_packet(data, length)
//   nimble     components/bt/host/nimble/esp-hci/src/esp_nimble_hci.c:80
//              len = BLE_HCI_CMD_HDR_LEN + cmd[3] + 1  (the +1 is the
//              packet type byte)
//
// So the framing belongs to the *host* side of the VHCI link, and the
// controller side receives an already framed buffer.  This module owns that
// framing for the xu port.
//
// Packet layouts (all multi byte fields little endian):
//
//   0x01 COMMAND   type(1) opcode(2) param_len(1) params(n)
//   0x02 ACL_DATA  type(1) handle(2) dlen(2)     data(n)
//   0x03 SCO_DATA  type(1) handle(2) dlen(1)     data(n)
//   0x04 EVENT     type(1) code(1)   param_len(1) params(n)

pub const HCI_PKT_COMMAND = 0x01
pub const HCI_PKT_ACLDATA = 0x02
pub const HCI_PKT_SCODATA = 0x03
pub const HCI_PKT_EVENT   = 0x04

// Header sizes, excluding the packet type byte.
pub const HCI_HDR_COMMAND = 3 // opcode(2) + param_len(1)
pub const HCI_HDR_ACL     = 4 // handle(2) + dlen(2)
pub const HCI_HDR_SCO     = 3 // handle(2) + dlen(1)
pub const HCI_HDR_EVENT   = 2 // code(1)   + param_len(1)

pub const HCI_MAX_PAYLOAD = 255
// 1 (type byte) + HCI_HDR_ACL (4) + HCI_MAX_PAYLOAD (255).
// xu const initialisers must be literals, so the sum is written out.
pub const HCI_MAX_FRAME   = 260

// HCI packet types as seen on the wire.
pub const HCI_BTLE_ENC_RND      = 0x01
pub const HCI_BTLE_ACL_START    = 0x02
pub const HCI_BTLE_ACL_CONT     = 0x03
pub const HCI_BTLE_SCO_START    = 0x08
pub const HCI_BTLE_SCO_CONT     = 0x09
pub const HCI_BTLE_SCO_COMPLETE = 0x0A

// A decoded HCI packet.
pub struct HciPacket {
    pub valid bool
    pub kind int      // HCI_PKT_*
    pub opcode int    // command opcode, or event code for events
    pub handle int    // ACL/SCO handle
    pub len int       // payload length in bytes
    pub payload []int // payload bytes, 0..255 each
}

// Allocate a zero filled byte buffer of `n` entries.
pub fn hci_zeros(n int) []int {
    $out := []int{}
    $i := 0
    while i < n {
        out.push(0)
        i = i + 1
    }
    << out
}

pub fn hci_packet_command(opcode int, params []int) HciPacket {
    << HciPacket{
        valid: true,
        kind: HCI_PKT_COMMAND,
        opcode: opcode & 0xFFFF,
        handle: 0,
        len: params.len,
        payload: params
    }
}

pub fn hci_packet_acl(handle int, params []int) HciPacket {
    << HciPacket{
        valid: true,
        kind: HCI_PKT_ACLDATA,
        opcode: 0,
        handle: handle & 0x0FFF,
        len: params.len,
        payload: params
    }
}

pub fn hci_packet_sco(handle int, params []int) HciPacket {
    << HciPacket{
        valid: true,
        kind: HCI_PKT_SCODATA,
        opcode: 0,
        handle: handle & 0x0FFF,
        len: params.len,
        payload: params
    }
}

pub fn hci_packet_event(code int, params []int) HciPacket {
    << HciPacket{
        valid: true,
        kind: HCI_PKT_EVENT,
        opcode: code & 0xFF,
        handle: 0,
        len: params.len,
        payload: params
    }
}

// Header size of a packet kind, or -1 for an unknown kind.
pub fn hci_header_len(kind int) int {
    if kind == HCI_PKT_COMMAND { << HCI_HDR_COMMAND }
    if kind == HCI_PKT_ACLDATA { << HCI_HDR_ACL }
    if kind == HCI_PKT_SCODATA { << HCI_HDR_SCO }
    if kind == HCI_PKT_EVENT   { << HCI_HDR_EVENT }
    << -1
}

// Total wire length of a packet (type byte + header + payload).
pub fn hci_frame_length(p &HciPacket) int {
    hdr := hci_header_len(p.kind)
    if hdr < 0 { << -1 }
    << 1 + hdr + p.len
}

// Allocate a buffer large enough to hold the framed packet.
pub fn hci_frame_buffer(p &HciPacket) []int {
    n := hci_frame_length(p)
    if n < 0 { << hci_zeros(0) }
    << hci_zeros(n)
}

// Encode `p` into a freshly allocated wire buffer.
// Returns the framed buffer; an invalid packet yields an empty buffer.
//
// xu slices are owning values: passing one to a function moves it, so the
// encoder allocates instead of filling a caller supplied buffer.  Use
// `hci_encode_into` when the caller already owns a buffer and is done with
// it afterwards.
pub fn hci_encode(p &HciPacket) []int {
    total := hci_frame_length(p)
    if total < 0 { << hci_zeros(0) }
    if p.len > HCI_MAX_PAYLOAD { << hci_zeros(0) }
    $buf := []int{}
    buf.push(p.kind)
    if p.kind == HCI_PKT_COMMAND {
        buf.push(p.opcode & 0xFF)
        buf.push((p.opcode >> 8) & 0xFF)
        buf.push(p.len & 0xFF)
    } else if p.kind == HCI_PKT_ACLDATA {
        buf.push(p.handle & 0xFF)
        buf.push((p.handle >> 8) & 0xFF)
        buf.push(p.len & 0xFF)
        buf.push((p.len >> 8) & 0xFF)
    } else if p.kind == HCI_PKT_SCODATA {
        buf.push(p.handle & 0xFF)
        buf.push((p.handle >> 8) & 0xFF)
        buf.push(p.len & 0xFF)
    } else if p.kind == HCI_PKT_EVENT {
        buf.push(p.opcode & 0xFF)
        buf.push(p.len & 0xFF)
    } else {
        << hci_zeros(0)
    }
    $i := 0
    while i < p.len {
        buf.push(hci_payload_at(p, i))
        i = i + 1
    }
    << buf
}

// Read a wire byte through a borrowed slice. Keeping the borrow local lets
// packet fields stay owned by their packet while sharing this byte mask.
fn hci_at(src &[]int, i int) int {
    $local := src
    << local[i] & 0xFF
}

// Read one byte out of a packet's borrowed payload.
//
// The payload slice is reached by address rather than by value: xu forbids
// moving a non-string field out of a struct (M2b), and taking the address
// keeps the packet in place.
fn hci_payload_at(p &HciPacket, i int) int {
    $field := &p.payload
    << hci_at(field, i)
}

// Decode one framed packet from `buf[0..n)`.
//
// The decoder is tolerant: a truncated buffer yields an invalid packet instead
// of trapping, so the caller can resynchronise on the next type byte.
pub fn hci_decode(buf &[]int, n int) HciPacket {
    bad := HciPacket{valid: false, kind: 0, opcode: 0, handle: 0, len: 0, payload: []int{}}
    if n < 1 { << bad }
    kind := hci_at(buf, 0)
    hdr := hci_header_len(kind)
    if hdr < 0 { << bad }
    if n < 1 + hdr { << bad }
    $plen := 0
    $opcode := 0
    $handle := 0
    if kind == HCI_PKT_COMMAND {
        opcode = hci_at(buf, 1) | (hci_at(buf, 2) << 8)
        plen = hci_at(buf, 3)
    } else if kind == HCI_PKT_ACLDATA {
        handle = hci_at(buf, 1) | (hci_at(buf, 2) << 8)
        plen = hci_at(buf, 3) | (hci_at(buf, 4) << 8)
    } else if kind == HCI_PKT_SCODATA {
        handle = hci_at(buf, 1) | (hci_at(buf, 2) << 8)
        plen = hci_at(buf, 3)
    } else {
        opcode = hci_at(buf, 1)
        plen = hci_at(buf, 2)
    }
    if n < 1 + hdr + plen { << bad }
    $payload := []int{}
    $i := 0
    while i < plen {
        payload.push(hci_at(buf, 1 + hdr + i))
        i = i + 1
    }
    << HciPacket{
        valid: true,
        kind: kind,
        opcode: opcode,
        handle: handle,
        len: plen,
        payload: payload
    }
}

// Convenience: build the wire buffer for a packet in one step.
pub fn hci_frame(p &HciPacket) []int {
    << hci_encode(p)
}

// Classify a raw packet type byte.  Returns 0 for an unknown type.
pub fn hci_classify(kind int) int {
    if kind == HCI_PKT_COMMAND { << HCI_PKT_COMMAND }
    if kind == HCI_PKT_ACLDATA { << HCI_PKT_ACLDATA }
    if kind == HCI_PKT_SCODATA { << HCI_PKT_SCODATA }
    if kind == HCI_PKT_EVENT   { << HCI_PKT_EVENT }
    << 0
}

// ===== HCI GAP Advertising Commands =========================================

// 1. HCI_Reset (0x0C03)
pub fn hci_cmd_reset() HciPacket {
    << hci_packet_command(0x0C03, []int{})
}

// 2. HCI_LE_Set_Advertising_Parameters (0x2006)
// min_int, max_int in units of 0.625ms (e.g. 0x0030 = 30ms)
pub fn hci_cmd_set_adv_params(min_int int, max_int int) HciPacket {
    $p := []int{}
    p.push(min_int & 0xFF)
    p.push((min_int >> 8) & 0xFF)
    p.push(max_int & 0xFF)
    p.push((max_int >> 8) & 0xFF)
    p.push(0x00) // Adv type: ADV_IND (connectable undirected)
    p.push(0x00) // Own addr type: Public
    p.push(0x00) // Peer addr type: Public
    for i in 0:6 { p.push(0) } // Peer addr: 00:00:00:00:00:00
    p.push(0x07) // Adv channel map: CH37, CH38, CH39
    p.push(0x00) // Filter policy: allow scan any, allow conn any
    << hci_packet_command(0x2006, p)
}

// 3. HCI_LE_Set_Advertising_Data (0x2008)
// flags + appearance (0x03C2 Mouse) + 16-bit UUID (0x1812 HID) + Complete Name
pub fn hci_cmd_set_adv_data(name string) HciPacket {
    $d := []int{}
    // Flags AD: 2 bytes payload: Flags: 0x06 (LE Gen Disc | BR/EDR Not Supp)
    d.push(0x02)
    d.push(0x01)
    d.push(0x06)

    // Appearance AD: 0x03C2 (HID Mouse)
    d.push(0x03)
    d.push(0x19)
    d.push(0xC2)
    d.push(0x03)

    // 16-bit Service UUID AD: 0x1812 (HID Service)
    d.push(0x03)
    d.push(0x03)
    d.push(0x12)
    d.push(0x18)

    // Complete Local Name AD: type 0x09
    $nlen := name.len
    if nlen > 15 { nlen = 15 } // keep within 31 bytes total
    d.push(nlen + 1)
    d.push(0x09)
    for i in 0:nlen {
        d.push(name[i])
    }

    // HCI LE Set Adv Data command payload: 1 byte len, followed by 31-byte buffer
    $p := []int{}
    p.push(d.len & 0xFF)
    for i in 0:31 {
        if i < d.len {
            p.push(d[i])
        } else {
            p.push(0)
        }
    }
    << hci_packet_command(0x2008, p)
}

// 4. HCI_LE_Set_Advertise_Enable (0x200A)
pub fn hci_cmd_set_adv_enable(enable bool) HciPacket {
    $p := []int{}
    if enable { p.push(1) } else { p.push(0) }
    << hci_packet_command(0x200A, p)
}
