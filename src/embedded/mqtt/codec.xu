@embedded/mqtt

pub const MAX_PACKET = 2048
pub const MAX_PAYLOAD = 768
fn copy(bytes &string) string { << part(bytes,0,bytes.len) }
fn part(bytes &string, at int, count int) string {
    if at < 0 || count < 0 || at > bytes.len || count > bytes.len - at { << "" }
    $out := make_string(count)
    for i in 0:count { out[i] = bytes[at + i] }
    << out
}
fn word(bytes &string, at int) int { << (bytes[at] << 8) | bytes[at + 1] }
fn pair(value int) string {
    $out := make_string(2)
    out[0] = (value >> 8) & 255
    out[1] = value & 255
    << out
}
fn field(bytes &string) string { << pair(bytes.len) + copy(bytes) }
fn topic_valid(topic &string) bool {
    if topic.len < 1 || topic.len > 128 { << false }
    for i in 0:topic.len { if topic[i] < 33 || topic[i] > 126 || topic[i] == 35 || topic[i] == 43 { << false } }
    << true
}
fn packet(header int, body &string) string {
    if body.len > MAX_PACKET - 4 { << "" }
    $prefix := make_string(2)
    prefix[0] = header
    $left := body.len
    prefix[1] = left & 127
    if left >= 128 {
        prefix[1] = prefix[1] | 128
        $high := make_string(1)
        high[0] = left / 128
        prefix = prefix + high
    }
    << prefix + copy(body)
}
fn connect_packet(id &string, will_topic &string) string {
    $head := make_string(10)
    head[1] = 4
    head[2] = 77
    head[3] = 81
    head[4] = 84
    head[5] = 84
    head[6] = 4
    head[7] = 0x2E // clean session, retained QoS1 last will.
    head[9] = 20
    $offline := make_string(1)
    offline[0] = 48
    body := head + field(id) + field(will_topic) + field(&offline)
    << packet(0x10,&body)
}
fn subscribe_packet(topic &string) string {
    $qos := make_string(1)
    qos[0] = 1
    body := pair(1) + field(topic) + qos
    << packet(0x82,&body)
}
fn publish_packet(topic &string, payload &string, id int, retain bool) string {
    $header := 0x32
    if retain { header = header | 1 }
    body := field(topic) + pair(id) + copy(payload)
    << packet(header,&body)
}
fn ack_packet(id int) string {
    body := pair(id)
    << packet(0x40,&body)
}
fn ping_packet() string {
    $out := make_string(2)
    out[0] = 0xC0
    << out
}
// Positive = complete frame length, zero = incomplete, negative = invalid.
fn frame_length(bytes &string) int {
    if bytes.len < 2 { << 0 }
    $length := 0
    $multiplier := 1
    for i in 1:5 {
        if i >= bytes.len { << 0 }
        b := bytes[i]
        length += (b & 127) * multiplier
        if length > MAX_PACKET - i - 1 { << -1 }
        if (b & 128) == 0 {
            if i > 1 && b == 0 { << -1 }
            if length > bytes.len - i - 1 { << 0 }
            << length + i + 1
        }
        multiplier *= 128
    }
    << -1
}
fn body_offset(bytes &string) int {
    for i in 1:5 { if (bytes[i] & 128) == 0 { << i + 1 } }
    << 0
}
fn elapsed(now int, before int) int { << (now - before) & 0x7FFFFFFF }
