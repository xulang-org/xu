@embedded/mqtt

pub struct Message {
    pub valid bool
    pub payload string
    pub retained bool
}
struct Pending { id int bytes string }
pub struct Client {
    topic string
    will_topic string
    initial string
    phase int
    buffer string
    outgoing []Pending
    acks []string
    messages []Message
    seen []int
    pending string
    pending_id int
    next_id int
    sent_at int
    phase_at int
    retries int
    last_tx int
    ping_at int
    pub error int
    pub received int
    pub published int
    pub retransmits int
}
pub fn create(id string, command_topic string, will_topic string, now int) Client {
    $c := Client{topic: command_topic,will_topic: will_topic,initial: "",phase: 0,buffer: "",
        outgoing: []Pending{},acks: []string{},messages: []Message{},seen: []int{},pending: "",pending_id: 0,
        next_id: 1,sent_at: now,phase_at: now,retries: 0,last_tx: now,ping_at: -1,
        error: 0,received: 0,published: 0,retransmits: 0}
    if id.len < 1 || id.len > 23 || !topic_valid(&c.topic) || !topic_valid(&c.will_topic) { c.error = 1
        << c }
    for i in 0:id.len { if id[i] < 33 || id[i] > 126 { c.error = 1
        << c } }
    c.initial = connect_packet(&id,&c.will_topic)
    c.phase = 1
    << c
}
pub fn (c &Client) ready() bool { << c.phase == 3 && c.error == 0 }
pub fn (c &Client) failed() bool { << c.error != 0 }
pub fn (c &Client) can_publish() bool { << c.ready() && c.outgoing.len < 8 }
pub fn (c $&Client) publish(topic &string, payload &string, retain bool) bool {
    if !c.can_publish() || !topic_valid(topic) || payload.len > MAX_PAYLOAD { << false }
    c.next_id = (c.next_id % 65535) + 1
    bytes := publish_packet(topic,payload,c.next_id,retain)
    c.outgoing.push(Pending{id: c.next_id,bytes: bytes})
    << true
}
fn discard_first(c $&Client) {
    $rest := []Pending{}
    for i in 1:c.outgoing.len { rest.push(c.outgoing[i]) }
    c.outgoing = rest
}
fn receive_publish(c $&Client, bytes &string, at int) {
    flags := bytes[0]
    qos := (flags >> 1) & 3
    if qos > 1 || (qos == 0 && (flags & 8) != 0) || bytes.len - at < 2 { c.error = 2
        << }
    length := word(bytes,at)
    $offset := at + 2 + length
    if length < 1 || length > 128 || offset > bytes.len { c.error = 2
        << }
    topic := part(bytes,at + 2,length)
    if !topic_valid(&topic) { c.error = 2
        << }
    $id := 0
    if qos == 1 {
        if bytes.len - offset < 2 { c.error = 2
            << }
        id = word(bytes,offset)
        offset += 2
        if id == 0 || c.acks.len >= 4 { c.error = 2
            << }
        c.acks.push(ack_packet(id))
        if (flags & 8) != 0 {
            for i in 0:c.seen.len { if c.seen[i] == id { << } }
        }
    }
    if bytes.len - offset > MAX_PAYLOAD || topic != c.topic { c.error = 2
        << }
    if c.messages.len >= 4 { c.error = 3
        << }
    c.messages.push(Message{valid: true,payload: part(bytes,offset,bytes.len - offset),retained: (flags & 1) != 0})
    c.received += 1
    if id != 0 {
        if c.seen.len >= 16 {
            $seen := []int{}
            for i in 1:c.seen.len { seen.push(c.seen[i]) }
            c.seen = seen
        }
        c.seen.push(id)
    }
}
fn receive_packet(c $&Client, bytes &string, now int) {
    at := body_offset(bytes)
    header := bytes[0]
    if c.phase == 1 {
        if header != 0x20 || bytes.len - at != 2 || bytes[at] != 0 || bytes[at + 1] != 0 { c.error = 4
            << }
        c.phase = 2
        c.phase_at = now
        c.initial = subscribe_packet(&c.topic)
        <<
    }
    if c.phase == 2 {
        // A broker may deliver matching retained publications before SUBACK.
        if (header >> 4) == 3 { receive_publish(c,bytes,at)
            << }
        if header != 0x90 || bytes.len - at != 3 || word(bytes,at) != 1 || bytes[at + 2] > 1 { c.error = 5
            << }
        c.phase = 3
        c.initial = ""
        <<
    }
    if c.phase != 3 { c.error = 2
        << }
    if (header >> 4) == 3 { receive_publish(c,bytes,at)
        << }
    if header == 0x40 && bytes.len - at == 2 && word(bytes,at) != 0 {
        if c.pending_id == word(bytes,at) {
            c.pending = ""
            c.pending_id = 0
            discard_first(c)
            c.published += 1
        }
        <<
    }
    if header == 0xD0 && bytes.len == at && c.ping_at >= 0 { c.ping_at = -1
        << }
    c.error = 2
}
pub fn (c $&Client) feed(bytes &string, now int) bool {
    if c.failed() || bytes.len > MAX_PACKET || bytes.len > MAX_PACKET * 2 - c.buffer.len { << false }
    c.buffer = c.buffer + copy(bytes)
    for n in 0:32 {
        length := frame_length(&c.buffer)
        if length < 0 { c.error = 2
            << false }
        if length == 0 { << true }
        one := part(&c.buffer,0,length)
        c.buffer = part(&c.buffer,length,c.buffer.len - length)
        receive_packet(c,&one,now)
        if c.failed() { << false }
    }
    c.error = 3
    << false
}
pub fn (c $&Client) read() Message {
    if c.messages.len == 0 { << Message{valid: false,payload: "",retained: false} }
    first := Message{valid: true,payload: copy(&c.messages[0].payload),retained: c.messages[0].retained}
    $rest := []Message{}
    for i in 1:c.messages.len { rest.push(c.messages[i]) }
    c.messages = rest
    << first
}
pub fn (c $&Client) poll(now int) string {
    if c.failed() { << "" }
    if c.phase != 3 && elapsed(now,c.phase_at) > 10000 { c.error = 6
        << "" }
    if c.initial.len > 0 {
        out := copy(&c.initial)
        c.initial = ""
        c.last_tx = now
        << out
    }
    if !c.ready() { << "" }
    if c.ping_at >= 0 && elapsed(now,c.ping_at) >= 10000 { c.error = 6
        << "" }
    if c.acks.len > 0 {
        out := copy(&c.acks[0])
        $rest := []string{}
        for i in 1:c.acks.len { rest.push(c.acks[i]) }
        c.acks = rest
        c.last_tx = now
        << out
    }
    if c.pending.len > 0 {
        if elapsed(now,c.sent_at) >= 3000 {
            if c.retries >= 3 { c.error = 6
                << "" }
            $out := copy(&c.pending)
            out[0] = out[0] | 8
            c.retries += 1
            c.retransmits += 1
            c.sent_at = now
            c.last_tx = now
            << out
        }
    } else if c.outgoing.len > 0 {
        c.pending = copy(&c.outgoing[0].bytes)
        c.pending_id = c.outgoing[0].id
        c.retries = 0
        c.sent_at = now
        c.last_tx = now
        << copy(&c.pending)
    }
    if elapsed(now,c.last_tx) >= 10000 && c.ping_at < 0 {
        c.ping_at = now
        c.last_tx = now
        << ping_packet()
    }
    << ""
}

pub fn (c $&Client) reset(id string, command_topic string, will_topic string, now int) {
    c.topic = command_topic
    c.will_topic = will_topic
    c.initial = ""
    c.phase = 0
    c.buffer = ""
    c.outgoing = []Pending{}
    c.acks = []string{}
    c.messages = []Message{}
    c.seen = []int{}
    c.pending = ""
    c.pending_id = 0
    c.next_id = 1
    c.sent_at = now
    c.phase_at = now
    c.retries = 0
    c.last_tx = now
    c.ping_at = -1
    c.error = 0
    c.received = 0
    c.published = 0
    c.retransmits = 0
    if id.len < 1 || id.len > 23 || !topic_valid(&c.topic) || !topic_valid(&c.will_topic) { c.error = 1
        << }
    for i in 0:id.len { if id[i] < 33 || id[i] > 126 { c.error = 1
        << } }
    c.initial = connect_packet(&id,&c.will_topic)
    c.phase = 1
}
