@embedded/wifi/ipv4

pub const DHCP_READY = 0
pub const DHCP_SELECTING = 1
pub const DHCP_REQUESTING = 2
pub const DHCP_LEASED = 3
pub const DHCP_FAILED = 4

pub struct Client {
    pub state int
    pub mac string
    pub xid string
    pub offered string
    pub server string
    pub address string // empty until a matching, valid DHCPACK
    pub mask string
    pub router string
    pub lease_seconds string // network-order uint32; not a host-width int
    request_sent bool
}

// The caller supplies an unpredictable four-byte XID for each new exchange.
// This is initial acquisition only. Retry clocks, lease expiration, renewal,
// duplicate-address detection and DHCPDECLINE belong to the caller.
pub fn create(mac string, xid string) Client {
    $state := DHCP_READY
    if !mac_valid(&mac) || xid.len != 4 { state = DHCP_FAILED }
    << Client{state: state, mac: mac, xid: xid, offered: "", server: "",
        address: "", mask: "", router: "", lease_seconds: "", request_sent: false}
}

fn dhcp_packet(c &Client, kind int) string {
    if !mac_valid(&c.mac) || c.xid.len != 4 || (kind != 1 && kind != 3) { << "" }
    if kind == 3 && (!unicast4(&c.offered) || !unicast4(&c.server)) { << "" }
    // A 300-byte BOOTP message gives zeros after the DHCP end option.
    // The IPv4 datagram is 328 bytes; the UDP segment is 308 bytes.
    $out := make_string(8 + 20 + 8 + 300)
    out[0] = 170
    out[1] = 170
    out[2] = 3
    out[6] = 8
    out[7] = 0
    zero := make_string(4)
    $broadcast := make_string(4)
    for i in 0:4 { broadcast[i] = 255 }
    out[8] = 0x45
    out[10] = 1
    out[11] = 72
    out[14] = 0x40
    out[16] = 64
    out[17] = 17
    for i in 0:4 { out[20 + i] = zero[i]
        out[24 + i] = broadcast[i] }
    ip_check := checksum(&out,8,20,0)
    out[18] = (ip_check >> 8) & 255
    out[19] = ip_check & 255
    out[29] = 68
    out[31] = 67
    out[32] = 1
    out[33] = 52
    at := 36
    out[at] = 1
    out[at + 1] = 1
    out[at + 2] = 6
    for i in 0:c.xid.len { out[at + 4 + i] = c.xid[i] }
    out[at + 10] = 128 // broadcast reply requested before the address exists
    for i in 0:c.mac.len { out[at + 28 + i] = c.mac[i] }
    out[at + 236] = 99
    out[at + 237] = 130
    out[at + 238] = 83
    out[at + 239] = 99
    $pos := at + 240
    out[pos] = 53
    out[pos + 1] = 1
    out[pos + 2] = kind
    pos += 3
    out[pos] = 61
    out[pos + 1] = 7
    out[pos + 2] = 1
    for i in 0:c.mac.len { out[pos + 3 + i] = c.mac[i] }
    pos += 9
    out[pos] = 57
    out[pos + 1] = 2
    out[pos + 2] = 5
    out[pos + 3] = 220
    pos += 4
    if kind == 3 {
        out[pos] = 50
        out[pos + 1] = 4
        for i in 0:c.offered.len { out[pos + 2 + i] = c.offered[i] }
        pos += 6
        out[pos] = 54
        out[pos + 1] = 4
        for i in 0:c.server.len { out[pos + 2 + i] = c.server[i] }
        pos += 6
    }
    out[pos] = 55
    out[pos + 1] = 3
    out[pos + 2] = 1
    out[pos + 3] = 3
    out[pos + 4] = 51
    out[pos + 5] = 255
    pseudo := sum16(&out,20,8,17 + 308)
    $check := checksum(&out,28,308,pseudo)
    if check == 0 { check = 65535 }
    out[34] = (check >> 8) & 255
    out[35] = check & 255
    << out
}

pub fn (c $&Client) discover() string {
    if c.state != DHCP_READY && c.state != DHCP_SELECTING { << "" }
    out := dhcp_packet(c,1)
    if out.len != 0 { c.state = DHCP_SELECTING }
    << out
}

pub fn (c $&Client) request() string {
    if c.state != DHCP_REQUESTING { << "" }
    out := dhcp_packet(c,3)
    if out.len != 0 { c.request_sent = true }
    << out
}

fn dhcp_receive(c $&Client, bytes &string, ip int) bool {
    if !mac_valid(&c.mac) || c.xid.len != 4 ||
        (c.state != DHCP_SELECTING && c.state != DHCP_REQUESTING) { << false }
    length := ip_length(bytes,ip,17)
    if length < 20 + 8 + 241 { << false }
    udp := ip + 20
    udp_length := u16(bytes,udp + 4)
    if udp_length != length - 20 || u16(bytes,udp) != 67 || u16(bytes,udp + 2) != 68 { << false }
    pseudo := sum16(bytes,ip + 12,8,17 + udp_length)
    // A zero UDP checksum is explicitly permitted for IPv4 (RFC 768).
    if u16(bytes,udp + 6) != 0 && sum16(bytes,udp,udp_length,pseudo) != 65535 { << false }
    at := udp + 8
    end := ip + length
    if bytes[at] != 2 || bytes[at + 1] != 1 || bytes[at + 2] != 6 ||
        bytes[at + 3] > 16 || (u16(bytes,at + 10) & 0x7FFF) != 0 ||
        !equal_at(bytes,at + 4,&c.xid) || !equal_at(bytes,at + 28,&c.mac) ||
        bytes[at + 236] != 99 || bytes[at + 237] != 130 ||
        bytes[at + 238] != 83 || bytes[at + 239] != 99 { << false }
    ciaddr := part(bytes,at + 12,4)
    source := part(bytes,ip + 12,4)
    destination := part(bytes,ip + 16,4)
    offered := part(bytes,at + 16,4)
    if !zero4(&ciaddr) || !unicast4(&source) ||
        (!broadcast4(&destination) && destination != offered) { << false }
    $kind := 0
    $server := ""
    $mask := ""
    $router := ""
    $lease := ""
    $client_seen := false
    $ended := false
    $pos := at + 240
    while pos < end {
        option := bytes[pos]
        pos += 1
        if option == 255 { ended = true
            <- }
        if option == 0 { -> }
        if pos >= end { << false }
        size := bytes[pos]
        pos += 1
        if size > end - pos { << false }
        if option == 53 {
            if kind != 0 || size != 1 { << false }
            kind = bytes[pos]
            if kind != 2 && kind != 5 && kind != 6 { << false }
        } else if option == 54 {
            if server.len != 0 || size != 4 { << false }
            server = part(bytes,pos,4)
            if !unicast4(&server) { << false }
        } else if option == 1 {
            if mask.len != 0 || size != 4 { << false }
            mask = part(bytes,pos,4)
            if !mask_valid(&mask) { << false }
        } else if option == 3 {
            if router.len != 0 || size < 4 || size % 4 != 0 { << false }
            router = part(bytes,pos,4)
            if !unicast4(&router) { << false }
        } else if option == 51 {
            if lease.len != 0 || size != 4 { << false }
            lease = part(bytes,pos,4)
            if zero4(&lease) { << false }
        } else if option == 61 {
            if client_seen || size != 7 || bytes[pos] != 1 ||
                !equal_at(bytes,pos + 1,&c.mac) { << false }
            client_seen = true
        } else if option == 52 {
            // Overloaded BOOTP file/sname option storage is unsupported.
            << false
        }
        pos += size
    }
    if !ended || kind == 0 || server.len != 4 { << false }
    if c.state == DHCP_SELECTING {
        if kind != 2 || !unicast4(&offered) { << false }
        if mask.len != 0 && !usable_host(&offered,&mask) { << false }
        if mask.len != 0 && router.len != 0 && !config_valid(&offered,&mask,&router) { << false }
        c.offered = offered
        c.server = server
        c.request_sent = false
        c.state = DHCP_REQUESTING
        << true
    }
    if !c.request_sent || server != c.server { << false }
    if kind == 6 {
        if !zero4(&offered) || !broadcast4(&destination) { << false }
        c.address = ""
        c.mask = ""
        c.router = ""
        c.lease_seconds = ""
        c.state = DHCP_FAILED
        << true
    }
    if kind != 5 || offered != c.offered || lease.len != 4 ||
        !config_valid(&offered,&mask,&router) { << false }
    c.address = offered
    c.mask = mask
    c.router = router
    c.lease_seconds = lease
    c.state = DHCP_LEASED
    << true
}

// True means one accepted state transition, including a matching DHCPNAK.
// The caller checks state == DHCP_LEASED before using address/mask/router.
pub fn (c $&Client) receive_llc(payload &string) bool {
    if !llc_type(payload,0x0800) { << false }
    << dhcp_receive(c,payload,8)
}

// Ethernet II without FCS or VLAN tags; intended for host packet fixtures or
// an independently authenticated bridge. 802.11 callers use receive_llc.
pub fn (c $&Client) receive_ethernet(frame &string) bool {
    if frame.len < 14 || frame.len > 1614 || u16(frame,12) != 0x0800 { << false }
    source := part(frame,6,6)
    if !mac_valid(&source) { << false }
    $broadcast := true
    for i in 0:6 { if frame[i] != 255 { broadcast = false } }
    if !broadcast && !equal_at(frame,0,&c.mac) { << false }
    << dhcp_receive(c,frame,14)
}
