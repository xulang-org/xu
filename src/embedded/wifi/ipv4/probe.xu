@embedded/wifi/ipv4

// The caller uses a successfully ACKed configuration and performs conflict
// detection before enabling application traffic. An ARP response alone is
// evidence of a neighbor, not proof of Internet reachability.
pub fn arp_request(mac &string, source_ip &string, target_ip &string) string {
    if !mac_valid(mac) || !unicast4(source_ip) || !unicast4(target_ip) || same(source_ip,target_ip) { << "" }
    $out := make_string(36)
    out[0] = 170
    out[1] = 170
    out[2] = 3
    out[6] = 8
    out[7] = 6
    out[9] = 1
    out[10] = 8
    out[12] = 6
    out[13] = 4
    out[15] = 1
    for i in 0:mac.len { out[16 + i] = mac[i] }
    for i in 0:source_ip.len { out[22 + i] = source_ip[i] }
    for i in 0:target_ip.len { out[32 + i] = target_ip[i] }
    << out
}

// Return the matched responder's six-byte MAC, or empty on malformed,
// unsolicited, multicast/zero sender, or another target's reply.
pub fn arp_reply_mac(payload &string, own_mac &string, own_ip &string, target_ip &string) string {
    if !mac_valid(own_mac) || !unicast4(own_ip) || !unicast4(target_ip) ||
        !llc_type(payload,0x0806) || payload.len < 36 ||
        u16(payload,8) != 1 || u16(payload,10) != 0x0800 ||
        payload[12] != 6 || payload[13] != 4 || u16(payload,14) != 2 ||
        !equal_at(payload,22,target_ip) || !equal_at(payload,26,own_mac) ||
        !equal_at(payload,32,own_ip) { << "" }
    mac := part(payload,16,6)
    if !mac_valid(&mac) || same(&mac,own_mac) { << "" }
    << mac
}

pub fn echo_request(source_ip &string, target_ip &string, id int, sequence int, body &string) string {
    if !unicast4(source_ip) || !unicast4(target_ip) || same(source_ip,target_ip) ||
        id < 0 || id > 65535 || sequence < 0 || sequence > 65535 || body.len > 1200 { << "" }
    $out := make_string(36 + body.len)
    out[0] = 170
    out[1] = 170
    out[2] = 3
    out[6] = 8
    out[7] = 0
    out[8] = 0x45
    out[10] = ((28 + body.len) >> 8) & 255
    out[11] = (28 + body.len) & 255
    out[14] = 0x40
    out[16] = 64
    out[17] = 1
    for i in 0:4 { out[20 + i] = source_ip[i]
        out[24 + i] = target_ip[i] }
    ip_check := checksum(&out,8,20,0)
    out[18] = (ip_check >> 8) & 255
    out[19] = ip_check & 255
    out[28] = 8
    out[32] = (id >> 8) & 255
    out[33] = id & 255
    out[34] = (sequence >> 8) & 255
    out[35] = sequence & 255
    for i in 0:body.len { out[36 + i] = body[i] }
    icmp_check := checksum(&out,28,8 + body.len,0)
    out[30] = (icmp_check >> 8) & 255
    out[31] = icmp_check & 255
    << out
}

// source_ip is our local address and target_ip is the peer we queried.
// Validate the full returned body in addition to identifier and sequence.
pub fn echo_reply_valid(payload &string, source_ip &string, target_ip &string,
    id int, sequence int, body &string) bool {
    if !unicast4(source_ip) || !unicast4(target_ip) || same(source_ip,target_ip) ||
        id < 0 || id > 65535 || sequence < 0 || sequence > 65535 || body.len > 1200 ||
        !llc_type(payload,0x0800) { << false }
    length := ip_length(payload,8,1)
    << length == 28 + body.len && equal_at(payload,20,target_ip) &&
        equal_at(payload,24,source_ip) && payload[28] == 0 && payload[29] == 0 &&
        u16(payload,32) == id && u16(payload,34) == sequence &&
        equal_at(payload,36,body) && sum16(payload,28,8 + body.len,0) == 65535
}

pub struct ArpResponse {
    pub valid bool
    pub destination string
    pub payload string
}

// Answer an ordinary IPv4 peer's request for our acquired address. ARP
// probes (sender IP zero), conflicts and other targets need separate policy.
pub fn arp_response(payload &string, own_mac &string, own_ip &string) ArpResponse {
    invalid := ArpResponse{valid: false, destination: "", payload: ""}
    if !mac_valid(own_mac) || !unicast4(own_ip) || !llc_type(payload,0x0806) ||
        payload.len < 36 || u16(payload,8) != 1 || u16(payload,10) != 0x0800 ||
        payload[12] != 6 || payload[13] != 4 || u16(payload,14) != 1 ||
        !equal_at(payload,32,own_ip) { << invalid }
    peer_mac := part(payload,16,6)
    peer_ip := part(payload,22,4)
    if !mac_valid(&peer_mac) || same(&peer_mac,own_mac) ||
        !unicast4(&peer_ip) || same(&peer_ip,own_ip) { << invalid }
    $out := make_string(36)
    out[0] = 170
    out[1] = 170
    out[2] = 3
    out[6] = 8
    out[7] = 6
    out[9] = 1
    out[10] = 8
    out[12] = 6
    out[13] = 4
    out[15] = 2
    for i in 0:6 { out[16 + i] = own_mac[i]
        out[26 + i] = peer_mac[i] }
    for i in 0:4 { out[22 + i] = own_ip[i]
        out[32 + i] = peer_ip[i] }
    << ArpResponse{valid: true, destination: peer_mac, payload: out}
}

// Validate an Echo Request before constructing an exact-length reply. Link
// padding is excluded, and both checksums are recomputed after the changes.
pub fn echo_response(payload &string, own_ip &string) string {
    if !unicast4(own_ip) || !llc_type(payload,0x0800) { << "" }
    length := ip_length(payload,8,1)
    if length < 28 || length > 1228 || !equal_at(payload,24,own_ip) ||
        payload[28] != 8 || payload[29] != 0 || sum16(payload,28,length - 20,0) != 65535 { << "" }
    source := part(payload,20,4)
    if !unicast4(&source) || same(&source,own_ip) { << "" }
    $out := part(payload,0,8 + length)
    for i in 0:4 { out[20 + i] = own_ip[i]
        out[24 + i] = source[i] }
    out[14] = 0x40
    out[15] = 0
    out[16] = 64
    out[18] = 0
    out[19] = 0
    out[28] = 0
    out[30] = 0
    out[31] = 0
    ip_check := checksum(&out,8,20,0)
    out[18] = (ip_check >> 8) & 255
    out[19] = ip_check & 255
    icmp_check := checksum(&out,28,length - 20,0)
    out[30] = (icmp_check >> 8) & 255
    out[31] = icmp_check & 255
    << out
}
