@embedded/wifi/ipv4

// Small, bounded IPv4 bootstrap codecs. All addresses and DHCP transaction
// IDs are network-order byte strings, independent of the target int width.
// Input LLC bytes must already have passed 802.11/CCMP authentication, replay
// checking and deaggregation. These functions do not establish a radio link.

fn equal_at(bytes &string, at int, value &string) bool {
    if at < 0 || value.len > bytes.len - at { << false }
    for i in 0:value.len { if bytes[at + i] != value[i] { << false } }
    << true
}

fn same(a &string, b &string) bool { << a.len == b.len && equal_at(a,0,b) }

fn part(bytes &string, at int, length int) string {
    if at < 0 || length < 0 || at > bytes.len || length > bytes.len - at { << "" }
    $out := make_string(length)
    for i in 0:length { out[i] = bytes[at + i] }
    << out
}

fn u16(bytes &string, at int) int { << (bytes[at] << 8) | bytes[at + 1] }

fn mac_valid(mac &string) bool {
    if mac.len != 6 || (mac[0] & 1) != 0 { << false }
    $bits := 0
    for i in 0:6 { bits = bits | mac[i] }
    << bits != 0
}

fn zero4(ip &string) bool {
    << ip.len == 4 && ip[0] == 0 && ip[1] == 0 && ip[2] == 0 && ip[3] == 0
}

fn broadcast4(ip &string) bool {
    << ip.len == 4 && ip[0] == 255 && ip[1] == 255 && ip[2] == 255 && ip[3] == 255
}

fn unicast4(ip &string) bool {
    << ip.len == 4 && ip[0] > 0 && ip[0] < 224 && ip[0] != 127
}

// Ordinary routed LAN profile: a contiguous /1 through /30 subnet, usable
// local and gateway host addresses, and a distinct gateway on that subnet.
fn mask_valid(mask &string) bool {
    if mask.len != 4 { << false }
    $zero := false
    $ones := 0
    for i in 0:4 {
        for j in 0:8 {
            bit := mask[i] & (128 >> j)
            if bit == 0 { zero = true }
            else { if zero { << false }
                ones += 1 }
        }
    }
    << ones >= 1 && ones <= 30
}

fn usable_host(ip &string, mask &string) bool {
    if !unicast4(ip) || !mask_valid(mask) { << false }
    $host := 0
    $inverse := 0
    for i in 0:4 {
        host = host | (ip[i] & (255 ^ mask[i]))
        inverse = inverse | ((255 ^ ip[i]) & (255 ^ mask[i]))
    }
    << host != 0 && inverse != 0
}

fn config_valid(ip &string, mask &string, router &string) bool {
    if !usable_host(ip,mask) || !usable_host(router,mask) || same(ip,router) { << false }
    for i in 0:4 { if (ip[i] & mask[i]) != (router[i] & mask[i]) { << false } }
    << true
}

fn sum16(bytes &string, at int, length int, initial int) int {
    $sum := initial
    $pos := 0
    while pos + 1 < length {
        sum += u16(bytes,at + pos)
        pos += 2
    }
    if pos < length { sum += bytes[at + pos] << 8 }
    while sum > 65535 { sum = (sum & 65535) + (sum >> 16) }
    << sum
}

fn checksum(bytes &string, at int, length int, initial int) int {
    << 65535 ^ sum16(bytes,at,length,initial)
}

fn llc_type(payload &string, kind int) bool {
    << payload.len >= 8 && payload.len <= 1600 && payload[0] == 170 &&
        payload[1] == 170 && payload[2] == 3 && payload[3] == 0 &&
        payload[4] == 0 && payload[5] == 0 && u16(payload,6) == kind
}

// Validate a complete unfragmented datagram. A bridge can retain Ethernet's
// minimum 46-byte payload padding; those bytes are outside the IP datagram
// and must not affect its checksum or upper-layer validation. Other trailing
// storage is accepted only when zero. IPv4 options are outside this profile.
fn ip_length(bytes &string, at int, protocol int) int {
    if at < 0 || at > bytes.len || bytes.len - at < 20 || bytes[at] != 0x45 { << 0 }
    length := u16(bytes,at + 2)
    if length < 20 || length > 1500 || length > bytes.len - at ||
        (u16(bytes,at + 6) & 0xBFFF) != 0 || bytes[at + 8] == 0 ||
        bytes[at + 9] != protocol || sum16(bytes,at,20,0) != 65535 { << 0 }
    if length < 46 && bytes.len - at == 46 { << length }
    for i in at + length:bytes.len { if bytes[i] != 0 { << 0 } }
    << length
}
