@embedded/wifi/tcp

// One cooperative, bounded TCP active open. Call receive after link validation,
// drain read regularly and submit poll output outside the radio receive frame.
pub struct Client {
    local string
    peer string
    local_port int
    peer_port int
    phase int
    sent string
    received string
    initial string
    mss int
    window int
    input string
    output string
    offset int
    pending string
    pending_at int
    retries int
    ack_needed bool
    peer_fin bool
    pub retransmits int
}
pub fn create(local string, peer string, local_port int, peer_port int, initial string, now int) Client {
    $c := Client{local: local,peer: peer,local_port: local_port,peer_port: peer_port,phase: 0,
        sent: initial,received: make_string(4),initial: "",mss: 536,window: 0,input: "",output: "",offset: 0,
        pending: "",pending_at: now,retries: 0,ack_needed: false,peer_fin: false,retransmits: 0}
    if !ip_valid(&c.local) || !ip_valid(&c.peer) || c.sent.len != 4 || local_port < 1 || local_port > 65535 || peer_port < 1 || peer_port > 65535 { << c }
    c.pending = encode(&c.local,&c.peer,local_port,peer_port,&c.sent,&c.received,2,&"",2048)
    c.sent = seq_add(&c.sent,1)
    c.phase = 1
    c.pending_at = (now - 1000) & 0x7FFFFFFF
    c.retries = -1
    << c
}
pub fn (c &Client) connected() bool { << c.phase == 2 && !c.peer_fin }
pub fn (c &Client) failed() bool { << c.phase == 0 }
pub fn (c &Client) writable() bool { << c.connected() && c.output.len == 0 }
pub fn (c $&Client) write(bytes &string) bool {
    if !c.writable() || bytes.len < 1 || bytes.len > 2048 { << false }
    c.output = copy(bytes)
    c.offset = 0
    << true
}
pub fn (c $&Client) read() string {
    out := copy(&c.input)
    if c.input.len > 0 { c.ack_needed = true }
    c.input = ""
    << out
}
fn distance(a &string, b &string) int {
    if a.len != 4 || b.len != 4 { << -1 }
    $borrow := 0
    $low := 0
    for n in 0:4 {
        i := 3 - n
        $value := a[i] - b[i] - borrow
        borrow = 0
        if value < 0 { value += 256
            borrow = 1 }
        if n < 2 { low = low | (value << (n * 8)) }
        else if value != 0 { << -1 }
    }
    << low
}
fn receive_segment(c $&Client, seg &Segment, packet &string) {
    seq := part(packet,32,4)
    ack := part(packet,36,4)
    if c.phase == 3 {
        if (seg.flags & 0x10) != 0 && ack == c.sent { c.phase = 0 }
        else if (seg.flags & 1) != 0 { c.ack_needed = true }
        <<
    }
    if (seg.flags & 4) != 0 {
        if (c.phase == 1 && (seg.flags & 0x10) != 0 && ack == c.sent) ||
            (c.phase == 2 && seq == c.received) { c.phase = 0 }
        else { c.ack_needed = true }
        <<
    }
    if c.phase == 1 {
        if (seg.flags & 0x17) != 0x12 || ack != c.sent || seg.data_len != 0 { << }
        c.initial = copy(&seq)
        c.received = seq_add(&seq,1)
        c.mss = seg.mss
        c.window = seg.window
        c.pending = ""
        c.phase = 2
        c.ack_needed = true
        <<
    }
    if c.phase != 2 { << }
    if (seg.flags & 2) != 0 && seq == c.initial && ack == c.sent {
        c.ack_needed = true
        << }
    if (seg.flags & 0x12) != 0x10 { << }
    if ack == c.sent { c.pending = "" }
    else if c.pending.len > 0 {
        start := part(&c.pending,32,4)
        delta := distance(&ack,&start)
        total := distance(&c.sent,&start)
        if delta < 0 || delta > total { c.ack_needed = true
            << }
    } else { c.ack_needed = true
        << }
    c.window = seg.window
    $skip := 0
    if seq != c.received {
        skip = distance(&c.received,&seq)
        if skip < 0 || skip > seg.data_len { c.ack_needed = true
            << }
    }
    count := seg.data_len - skip
    if seg.data_len > 0 { c.ack_needed = true }
    if count > 2048 - c.input.len { c.ack_needed = true
        << }
    if count > 0 {
        c.input = c.input + part(packet,seg.data_at + skip,count)
        c.received = seq_add(&c.received,count)
        c.ack_needed = true
    }
    if (seg.flags & 1) != 0 && !c.peer_fin {
        c.received = seq_add(&c.received,1)
        c.peer_fin = true
        c.ack_needed = true
    }
}
pub fn (c $&Client) receive(packet &string) {
    if c.phase == 0 || packet.len < 48 || !equal_at(packet,20,&c.peer) || word(packet,28) != c.peer_port { << }
    seg := decode(packet,&c.local,c.local_port)
    if !seg.valid { << }
    receive_segment(c,&seg,packet)
}
pub fn (c $&Client) poll(now int) string {
    if c.phase == 0 { << "" }
    if c.ack_needed && (c.phase == 2 || c.phase == 3) {
        c.ack_needed = false
        if c.peer_fin && c.phase == 2 {
            c.pending = encode(&c.local,&c.peer,c.local_port,c.peer_port,&c.sent,&c.received,0x11,&"",2048 - c.input.len)
            c.sent = seq_add(&c.sent,1)
            c.phase = 3
            c.pending_at = now
            c.retries = 0
            << copy(&c.pending)
        }
        out := encode(&c.local,&c.peer,c.local_port,c.peer_port,&c.sent,&c.received,0x10,&"",2048 - c.input.len)
        << out
    }
    if c.pending.len != 0 {
        $wait := 1000
        if c.retries > 0 { wait = 2000 }
        if c.retries > 1 { wait = 4000 }
        if elapsed(now,c.pending_at) < wait { << "" }
        if c.retries >= 4 { c.phase = 0
            << "" }
        if c.retries >= 0 { c.retransmits += 1 }
        c.retries += 1
        c.pending_at = now
        << copy(&c.pending)
    }
    if c.phase == 2 && c.output.len != 0 && c.window > 0 {
        $count := c.output.len - c.offset
        if count > c.mss { count = c.mss }
        if count > c.window { count = c.window }
        data := part(&c.output,c.offset,count)
        c.offset += count
        c.pending = encode(&c.local,&c.peer,c.local_port,c.peer_port,&c.sent,&c.received,0x18,&data,2048 - c.input.len)
        c.sent = seq_add(&c.sent,count)
        c.pending_at = now
        c.retries = 0
        if c.offset == c.output.len { c.output = ""
            c.offset = 0 }
        << copy(&c.pending)
    }
    << ""
}

pub fn (c $&Client) reset(local string, peer string, local_port int, peer_port int, initial string, now int) {
    c.local = local
    c.peer = peer
    c.local_port = local_port
    c.peer_port = peer_port
    c.phase = 0
    c.sent = initial
    c.received = make_string(4)
    c.initial = ""
    c.mss = 536
    c.window = 0
    c.input = ""
    c.output = ""
    c.offset = 0
    c.pending = ""
    c.pending_at = now
    c.retries = 0
    c.ack_needed = false
    c.peer_fin = false
    c.retransmits = 0
    if !ip_valid(&c.local) || !ip_valid(&c.peer) || c.sent.len != 4 || local_port < 1 || local_port > 65535 || peer_port < 1 || peer_port > 65535 { << }
    c.pending = encode(&c.local,&c.peer,local_port,peer_port,&c.sent,&c.received,2,&"",2048)
    c.sent = seq_add(&c.sent,1)
    c.phase = 1
    c.pending_at = (now - 1000) & 0x7FFFFFFF
    c.retries = -1
}
