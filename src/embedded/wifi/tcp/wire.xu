@embedded/wifi/tcp

// Bounded IPv4/TCP wire codec. Addresses and sequence numbers remain byte
// strings so sequence arithmetic is identical on 32-bit and 64-bit targets.
fn copy(bytes &string) string { << part(bytes,0,bytes.len) }
fn part(bytes &string, at int, count int) string {
    if at < 0 || count < 0 || at > bytes.len || count > bytes.len - at { << "" }
    $out := make_string(count)
    for i in 0:count { out[i] = bytes[at + i] }
    << out
}
fn word(bytes &string, at int) int { << (bytes[at] << 8) | bytes[at + 1] }
fn equal_at(bytes &string, at int, value &string) bool {
    if at < 0 || at > bytes.len || value.len > bytes.len - at { << false }
    for i in 0:value.len { if bytes[at + i] != value[i] { << false } }
    << true
}
fn ip_valid(ip &string) bool {
    << ip.len == 4 && ip[0] > 0 && ip[0] < 224 && ip[0] != 127
}
fn mac_valid(mac &string) bool {
    if mac.len != 6 || (mac[0] & 1) != 0 { << false }
    $bits := 0
    for i in 0:6 { bits = bits | mac[i] }
    << bits != 0
}
fn sum16(bytes &string, at int, count int, initial int) int {
    $sum := initial
    $i := 0
    while i + 1 < count { sum += word(bytes,at + i)
        i += 2 }
    if i < count { sum += bytes[at + i] << 8 }
    while sum > 65535 { sum = (sum & 65535) + (sum >> 16) }
    << sum
}
fn seq_add(seq &string, count int) string {
    if seq.len != 4 || count < 0 || count > 65535 { << "" }
    $out := copy(seq)
    $carry := count
    for n in 0:4 {
        i := 3 - n
        value := out[i] + (carry & 255)
        out[i] = value & 255
        carry = (carry >> 8) + (value >> 8)
    }
    << out
}
fn elapsed(now int, before int) int { << (now - before) & 0x7FFFFFFF }

struct Segment {
    valid bool
    flags int
    window int
    mss int
    data_at int
    data_len int
}
fn invalid_segment() Segment {
    << Segment{valid: false,flags: 0,window: 0,mss: 536,data_at: 0,data_len: 0}
}
fn wire_valid(packet &string, own_ip &string, port int) bool {
    if !ip_valid(own_ip) || packet.len < 48 || packet.len > 1508 ||
        packet[0] != 170 || packet[1] != 170 || packet[2] != 3 ||
        packet[3] != 0 || packet[4] != 0 || packet[5] != 0 || word(packet,6) != 0x800 ||
        packet[8] != 0x45 || (word(packet,14) & 0xBFFF) != 0 || packet[16] == 0 ||
        packet[17] != 6 || !equal_at(packet,24,own_ip) || sum16(packet,8,20,0) != 65535 { << false }
    length := word(packet,10)
    if length < 40 || length > 1500 || length > packet.len - 8 { << false }
    if !(length < 46 && packet.len == 54) {
        for i in 8 + length:packet.len { if packet[i] != 0 { << false } }
    }
    if packet[20] < 1 || packet[20] >= 224 || packet[20] == 127 || equal_at(packet,20,own_ip) || word(packet,28) == 0 || word(packet,30) != port { << false }
    header := (packet[40] >> 4) * 4
    if header < 20 || header > length - 20 || (packet[40] & 15) != 0 || (packet[41] & 0x20) != 0 { << false }
    pseudo := sum16(packet,20,8,6 + length - 20)
    if sum16(packet,28,length - 20,pseudo) != 65535 { << false }
    << true
}
fn peer_mss(packet &string, header int) int {
    $mss := 536
    $seen_mss := false
    $at := 48
    while at < 28 + header {
        kind := packet[at]
        if kind == 0 { <- }
        if kind == 1 { at += 1
            -> }
        if at + 1 >= 28 + header { << -1 }
        size := packet[at + 1]
        if size < 2 || size > 28 + header - at { << -1 }
        if kind == 2 {
            if size != 4 || seen_mss || word(packet,at + 2) == 0 { << -1 }
            mss = word(packet,at + 2)
            if mss > 1200 { mss = 1200 }
            seen_mss = true
        }
        at += size
    }
    << mss
}
fn decode(packet &string, own_ip &string, port int) Segment {
    if !wire_valid(packet,own_ip,port) { << invalid_segment() }
    length := word(packet,10)
    header := (packet[40] >> 4) * 4
    mss := peer_mss(packet,header)
    if mss < 0 { << invalid_segment() }
    << Segment{valid: true,flags: packet[41],window: word(packet,42),mss: mss,
        data_at: 28 + header,data_len: length - 20 - header}
}
fn encode(own_ip &string, peer_ip &string, port int, peer_port int,
    seq &string, ack &string, flags int, data &string, window int) string {
    if !ip_valid(own_ip) || !ip_valid(peer_ip) || seq.len != 4 || ack.len != 4 || data.len > 1200 || window < 0 || window > 2048 { << "" }
    $header := 20
    if (flags & 2) != 0 { header = 24 }
    length := 20 + header + data.len
    $out := make_string(8 + length)
    out[0] = 170
    out[1] = 170
    out[2] = 3
    out[6] = 8
    out[8] = 0x45
    out[10] = (length >> 8) & 255
    out[11] = length & 255
    out[14] = 0x40
    out[16] = 64
    out[17] = 6
    for i in 0:4 { out[20 + i] = own_ip[i]
        out[24 + i] = peer_ip[i]
        out[32 + i] = seq[i]
        out[36 + i] = ack[i] }
    out[28] = (port >> 8) & 255
    out[29] = port & 255
    out[30] = (peer_port >> 8) & 255
    out[31] = peer_port & 255
    out[40] = (header / 4) << 4
    out[41] = flags
    out[42] = (window >> 8) & 255
    out[43] = window & 255
    if header == 24 { out[48] = 2
        out[49] = 4
        out[50] = 4
        out[51] = 176 } // MSS 1200, no timestamps/window scale/SACK negotiation.
    for i in 0:data.len { out[28 + header + i] = data[i] }
    ip_check := 65535 ^ sum16(&out,8,20,0)
    out[18] = (ip_check >> 8) & 255
    out[19] = ip_check & 255
    tcp_check := 65535 ^ sum16(&out,28,header + data.len,sum16(&out,20,8,6 + header + data.len))
    out[44] = (tcp_check >> 8) & 255
    out[45] = tcp_check & 255
    << out
}
