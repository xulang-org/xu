@embedded/wifi

// WPA2-PSK/CCMP pairwise handshake primitives. EAPOL input starts at its
// four-byte 802.1X header, after the driver has checked the peer and LLC/SNAP.
// This module does not transmit, install hardware keys, or report IP/link
// success. M3 key-data decryption/RSN/KDE validation belongs to the caller.
// Sources: RFC 2104, RFC 2898, RFC 3174; hostap wpa_common.c and wpa.c.
// SHA-1 reuses its 80-word schedule; byte outputs remain owned Xu strings.
// These routines do not promise constant-time execution or secure erasure.

const WPA2_M32 = 0xFFFFFFFF
pub const WPA2_WAIT_M1 = 1
pub const WPA2_WAIT_M3 = 2
pub const WPA2_KEY_DATA_PENDING = 3
pub const WPA2_M4_READY = 4

struct Wpa2Sha1 {
    h0 int
    h1 int
    h2 int
    h3 int
    h4 int
    w []int
}

struct Wpa2Hmac {
    inner []int
    outer []int
    work Wpa2Sha1
}

fn wpa2_sha1_new() Wpa2Sha1 {
    << Wpa2Sha1{h0: 0x67452301, h1: 0xEFCDAB89,
        h2: 0x98BADCFE, h3: 0x10325476, h4: 0xC3D2E1F0,
        w: make_ints(80)}
}

fn wpa2_sha1_iv(s $&Wpa2Sha1) {
    s.h0 = 0x67452301
    s.h1 = 0xEFCDAB89
    s.h2 = 0x98BADCFE
    s.h3 = 0x10325476
    s.h4 = 0xC3D2E1F0
}

fn wpa2_sha1_block(s $&Wpa2Sha1, bytes &string, offset int) {
    for i in 0:16 {
        j := offset + i * 4
        s.w[i] = ((bytes[j] << 24) | (bytes[j + 1] << 16) |
            (bytes[j + 2] << 8) | bytes[j + 3]) & WPA2_M32
    }
    for i in 16:80 {
        v := s.w[i - 3] ^ s.w[i - 8] ^ s.w[i - 14] ^ s.w[i - 16]
        s.w[i] = ((v << 1) | ((v >> 31) & 1)) & WPA2_M32
    }
    $a := s.h0
    $b := s.h1
    $c := s.h2
    $d := s.h3
    $e := s.h4
    for i in 0:80 {
        $f := (b & c) | ((b ^ WPA2_M32) & d)
        $k := 0x5A827999
        if i >= 20 && i < 40 { f = b ^ c ^ d
            k = 0x6ED9EBA1 }
        else if i >= 40 && i < 60 { f = (b & c) | (b & d) | (c & d)
            k = 0x8F1BBCDC }
        else if i >= 60 { f = b ^ c ^ d
            k = 0xCA62C1D6 }
        t := ((((a << 5) | ((a >> 27) & 31)) + f + e + k + s.w[i]) & WPA2_M32)
        e = d
        d = c
        c = ((b << 30) | ((b >> 2) & 0x3FFFFFFF)) & WPA2_M32
        b = a
        a = t
    }
    s.h0 = (s.h0 + a) & WPA2_M32
    s.h1 = (s.h1 + b) & WPA2_M32
    s.h2 = (s.h2 + c) & WPA2_M32
    s.h3 = (s.h3 + d) & WPA2_M32
    s.h4 = (s.h4 + e) & WPA2_M32
}

fn wpa2_sha1_finish(s $&Wpa2Sha1, start &[]int, bytes &string) string {
    $out := make_string(20)
    $tail := make_string(64)
    s.h0 = start[0]
    s.h1 = start[1]
    s.h2 = start[2]
    s.h3 = start[3]
    s.h4 = start[4]
    $offset := 0
    while offset + 64 <= bytes.len {
        wpa2_sha1_block(s, bytes, offset)
        offset += 64
    }
    remaining := bytes.len - offset
    for i in 0:64 { tail[i] = 0 }
    for i in 0:remaining { tail[i] = bytes[offset + i] }
    tail[remaining] = 128
    if remaining >= 56 {
        wpa2_sha1_block(s, &tail, 0)
        for i in 0:64 { tail[i] = 0 }
    }
    // The input is bounded to 4096 bytes. Prefix is the 64-byte HMAC pad.
    bits := (64 + bytes.len) * 8
    for i in 0:4 { tail[60 + i] = (bits >> (24 - i * 8)) & 255 }
    wpa2_sha1_block(s, &tail, 0)
    for i in 0:4 {
        shift := 24 - i * 8
        out[i] = (s.h0 >> shift) & 255
        out[4 + i] = (s.h1 >> shift) & 255
        out[8 + i] = (s.h2 >> shift) & 255
        out[12 + i] = (s.h3 >> shift) & 255
        out[16 + i] = (s.h4 >> shift) & 255
    }
    << out
}

fn wpa2_hmac_new(key &string) Wpa2Hmac {
    $work := wpa2_sha1_new()
    $pad := make_string(64)
    for i in 0:64 {
        $v := 0
        if i < key.len { v = key[i] }
        pad[i] = v ^ 0x36
    }
    wpa2_sha1_block($&work, &pad, 0)
    inner := [work.h0, work.h1, work.h2, work.h3, work.h4]
    wpa2_sha1_iv($&work)
    for i in 0:64 { pad[i] = pad[i] ^ 0x36 ^ 0x5C }
    wpa2_sha1_block($&work, &pad, 0)
    outer := [work.h0, work.h1, work.h2, work.h3, work.h4]
    << Wpa2Hmac{inner: inner, outer: outer, work: work}
}

fn wpa2_hmac_run(h $&Wpa2Hmac, data &string) string {
    inner := [h.inner[0],h.inner[1],h.inner[2],h.inner[3],h.inner[4]]
    outer := [h.outer[0],h.outer[1],h.outer[2],h.outer[3],h.outer[4]]
    digest := wpa2_sha1_finish($&h.work, &inner, data)
    << wpa2_sha1_finish($&h.work, &outer, &digest)
}

// Raw 20-byte HMAC-SHA1 for WPA2 keys (at most 64 bytes) and bounded packets.
// Long HMAC keys are outside this protocol profile and are rejected explicitly.
pub fn wpa2_hmac_sha1(key &string, data &string) string {
    if key.len > 64 || data.len > 4096 { << "" }
    $h := wpa2_hmac_new(key)
    << wpa2_hmac_run($&h, data)
}

// PBKDF2-HMAC-SHA1(passphrase, SSID, 4096, 32). Input is the WPA passphrase
// form, not a raw 64-character PSK. Empty return means invalid input.
pub fn wpa2_pmk(passphrase &string, ssid &string) string {
    if passphrase.len < 8 || passphrase.len > 63 || ssid.len < 1 || ssid.len > 32 { << "" }
    for i in 0:passphrase.len { if passphrase[i] < 32 || passphrase[i] > 126 { << "" } }
    $h := wpa2_hmac_new(passphrase)
    $salt := make_string(ssid.len + 4)
    for i in 0:ssid.len { salt[i] = ssid[i] }
    $u := make_string(20)
    $acc := make_string(20)
    $pmk := make_string(32)
    for block in 1:3 {
        salt[ssid.len + 3] = block
        u = wpa2_hmac_run($&h, &salt)
        for i in 0:20 { acc[i] = u[i] }
        for iteration in 1:4096 {
            next := wpa2_hmac_run($&h, &u)
            for i in 0:20 { acc[i] = acc[i] ^ next[i] }
            u = next
        }
        $take := 20
        if block == 2 { take = 12 }
        for i in 0:take { pmk[(block - 1) * 20 + i] = acc[i] }
    }
    << pmk
}

fn wpa2_compare(a &string, b &string) int {
    for i in 0:a.len {
        if a[i] < b[i] { << -1 }
        if a[i] > b[i] { << 1 }
    }
    << 0
}

fn wpa2_copy(bytes &string, offset int, size int) string {
    $out := make_string(size)
    for i in 0:size { out[i] = bytes[offset + i] }
    << out
}

fn wpa2_equal(a &string, b &string) bool {
    if a.len != b.len { << false }
    $different := 0
    for i in 0:a.len { different = different | (a[i] ^ b[i]) }
    << different == 0
}

fn wpa2_nonzero(bytes &string) bool {
    $bits := 0
    for i in 0:bytes.len { bits = bits | bytes[i] }
    << bits != 0
}

fn wpa2_unicast(address &string) bool {
    << address.len == 6 && (address[0] & 1) == 0 && wpa2_nonzero(address)
}

// PRF-512: KCK = bytes 0..15, KEK = 16..31, CCMP TK = 32..47.
// Last 16 bytes are not used by the CCMP profile. Peer MACs/nonces sort as
// unsigned octets; the counter begins at zero after label || NUL || context.
pub fn wpa2_ptk(pmk &string, aa &string, spa &string, anonce &string, snonce &string) string {
    if pmk.len != 32 || !wpa2_unicast(aa) || !wpa2_unicast(spa) ||
        wpa2_equal(aa, spa) || anonce.len != 32 || snonce.len != 32 ||
        !wpa2_nonzero(anonce) || !wpa2_nonzero(snonce) || wpa2_equal(anonce, snonce) { << "" }
    label := "Pairwise key expansion"
    $data := make_string(label.len + 78)
    for i in 0:label.len { data[i] = label[i] }
    context := label.len + 1
    $first_mac := aa
    $second_mac := spa
    if wpa2_compare(aa, spa) > 0 { first_mac = spa
        second_mac = aa }
    for i in 0:6 { data[context + i] = first_mac[i]
        data[context + 6 + i] = second_mac[i] }
    $first_nonce := anonce
    $second_nonce := snonce
    if wpa2_compare(anonce, snonce) > 0 { first_nonce = snonce
        second_nonce = anonce }
    for i in 0:32 { data[context + 12 + i] = first_nonce[i]
        data[context + 44 + i] = second_nonce[i] }
    $h := wpa2_hmac_new(pmk)
    $ptk := make_string(64)
    for counter in 0:4 {
        data[data.len - 1] = counter
        part := wpa2_hmac_run($&h, &data)
        $take := 20
        if counter == 3 { take = 4 }
        for i in 0:take { ptk[counter * 20 + i] = part[i] }
    }
    << ptk
}

pub struct Wpa2Key {
    pub valid bool
    pub version int
    pub info int
    pub key_length int
    pub replay string
    pub nonce string
    pub mic string
    pub key_data string
}

fn wpa2_key_invalid() Wpa2Key {
    << Wpa2Key{valid: false, version: 0, info: 0, key_length: 0,
        replay: "", nonce: "", mic: "", key_data: ""}
}

// Exact EAPOL length is required; callers strip Ethernet/Wi-Fi padding first.
// RSN key descriptor type2/version2 only: no WPA1/TKIP, PMF, SHA256 AKM or SAE.
pub fn wpa2_key_parse(frame &string) Wpa2Key {
    if frame.len < 99 || frame.len > 2147 || frame[0] < 1 || frame[0] > 3 ||
        frame[1] != 3 || frame[4] != 2 { << wpa2_key_invalid() }
    size := (frame[2] << 8) | frame[3]
    data_size := (frame[97] << 8) | frame[98]
    info := (frame[5] << 8) | frame[6]
    if size + 4 != frame.len || data_size + 99 != frame.len ||
        (info & 7) != 2 || (info & 0xE430) != 0 { << wpa2_key_invalid() }
    << Wpa2Key{valid: true, version: frame[0], info: info,
        key_length: (frame[7] << 8) | frame[8],
        replay: wpa2_copy(frame, 9, 8), nonce: wpa2_copy(frame, 17, 32),
        mic: wpa2_copy(frame, 81, 16), key_data: wpa2_copy(frame, 99, data_size)}
}

fn wpa2_key_mic(ptk &string, frame &string) string {
    $copy := wpa2_copy(frame, 0, frame.len)
    for i in 81:97 { copy[i] = 0 }
    kck := wpa2_copy(ptk, 0, 16)
    raw := wpa2_hmac_sha1(&kck, &copy)
    << wpa2_copy(&raw, 0, 16)
}

fn wpa2_reply(ptk &string, key &Wpa2Key, nonce &string, key_data &string, info int) string {
    $reply := make_string(99 + key_data.len)
    reply[0] = key.version
    reply[1] = 3
    reply[2] = ((reply.len - 4) >> 8) & 255
    reply[3] = (reply.len - 4) & 255
    reply[4] = 2
    reply[5] = (info >> 8) & 255
    reply[6] = info & 255
    for i in 0:8 { reply[9 + i] = key.replay[i] }
    for i in 0:nonce.len { reply[17 + i] = nonce[i] }
    reply[97] = (key_data.len >> 8) & 255
    reply[98] = key_data.len & 255
    for i in 0:key_data.len { reply[99 + i] = key_data[i] }
    mic := wpa2_key_mic(ptk, &reply)
    for i in 0:16 { reply[81 + i] = mic[i] }
    << reply
}

pub struct Wpa2Handshake {
    pub valid bool
    pub phase int
    aa string
    spa string
    pmk string
    snonce string
    anonce string
    rsn_ie string
    ptk string
    m1 string
    m2 string
    m3 string
    m4 string
}

pub struct Wpa2Step {
    pub valid bool
    pub transmit string
    // True once per transaction after M3 MIC/nonce/replay verification. The
    // caller must decrypt/validate key_data before installing TK/GTK. A retry
    // does not request installation again (including after M4 was generated).
    pub validate_key_data bool
    pub key_data string
    pub kek string
    pub tk string
}

fn wpa2_step_invalid() Wpa2Step {
    << Wpa2Step{valid: false, transmit: "", validate_key_data: false,
        key_data: "", kek: "", tk: ""}
}

// A fresh cryptographic 32-byte SNonce is supplied by the hardware owner on
// every new exchange. Reuse across reconnects is forbidden by this contract.
// rsn_ie must be the complete PSK/CCMP RSN IE sent in association (22 bytes).
pub fn wpa2_handshake_start(pmk &string, aa &string, spa &string,
    snonce &string, rsn_ie &string) Wpa2Handshake {
    $s := Wpa2Handshake{valid: false, phase: 0, aa: "", spa: "", pmk: "",
        snonce: "", anonce: "", rsn_ie: "", ptk: "", m1: "", m2: "", m3: "", m4: ""}
    if pmk.len != 32 || !wpa2_unicast(aa) || !wpa2_unicast(spa) ||
        wpa2_equal(aa, spa) || snonce.len != 32 || !wpa2_nonzero(snonce) ||
        rsn_ie.len != 22 { << s }
    // This intentionally fixed profile requests no PMF/extended capabilities.
    expected := [48,20,1,0,0,15,172,4,1,0,0,15,172,4,1,0,0,15,172,2,0,0]
    for i in 0:22 { if rsn_ie[i] != expected[i] { << s } }
    s.aa = wpa2_copy(aa, 0, 6)
    s.spa = wpa2_copy(spa, 0, 6)
    s.pmk = wpa2_copy(pmk, 0, 32)
    s.snonce = wpa2_copy(snonce, 0, 32)
    s.rsn_ie = wpa2_copy(rsn_ie, 0, 22)
    s.phase = WPA2_WAIT_M1
    s.valid = true
    << s
}

// Invalid/unrelated frames leave the exchange unchanged. A new M1 after M2
// requires a caller-controlled reset with a fresh SNonce; it cannot silently
// replace an in-progress or installed PTK. Replay counters stay as 8 octets,
// so no 64-bit integer conversion can truncate them on ESP32.
pub fn wpa2_handshake_receive(s $&Wpa2Handshake, frame &string) Wpa2Step {
    if !s.valid { << wpa2_step_invalid() }
    key := wpa2_key_parse(frame)
    if !key.valid || key.key_length != 16 { << wpa2_step_invalid() }
    $out := wpa2_step_invalid()
    if s.phase == WPA2_WAIT_M1 {
        if key.info != 0x008A || !wpa2_nonzero(&key.nonce) { << out }
        for i in 49:97 { if frame[i] != 0 { << out } }
        ptk := wpa2_ptk(&s.pmk, &s.aa, &s.spa, &key.nonce, &s.snonce)
        if ptk.len != 64 { << out }
        s.ptk = ptk
        s.anonce = key.nonce
        s.m1 = wpa2_copy(frame, 0, frame.len)
        s.m2 = wpa2_reply(&s.ptk, &key, &s.snonce, &s.rsn_ie, 0x010A)
        s.phase = WPA2_WAIT_M3
        out.valid = true
        out.transmit = wpa2_copy(&s.m2, 0, s.m2.len)
        << out
    }
    if s.phase == WPA2_WAIT_M3 && wpa2_equal(&s.m1, frame) {
        out.valid = true
        out.transmit = wpa2_copy(&s.m2, 0, s.m2.len)
        << out
    }
    if s.phase >= WPA2_KEY_DATA_PENDING {
        if !wpa2_equal(&s.m3, frame) { << out }
        out.valid = true
        if s.phase == WPA2_M4_READY { out.transmit = wpa2_copy(&s.m4, 0, s.m4.len) }
        << out
    }
    if s.phase != WPA2_WAIT_M3 || key.info != 0x13CA ||
        !wpa2_equal(&s.anonce, &key.nonce) || key.key_data.len < 24 ||
        key.key_data.len % 8 != 0 { << out }
    original := wpa2_key_parse(&s.m1)
    if wpa2_compare(&key.replay, &original.replay) <= 0 { << out }
    mic := wpa2_key_mic(&s.ptk, frame)
    if !wpa2_equal(&mic, &key.mic) { << out }
    // Descriptor-v2 AES key wrap does not consume the legacy RC4 IV.
    // Some APs populate that field; its bytes are already covered by the
    // verified MIC. Only the reserved Key ID is required to be zero here.
    for i in 73:81 { if frame[i] != 0 { << out } }
    s.m3 = wpa2_copy(frame, 0, frame.len)
    s.phase = WPA2_KEY_DATA_PENDING
    out.valid = true
    out.validate_key_data = true
    out.key_data = key.key_data
    out.kek = wpa2_copy(&s.ptk, 16, 16)
    out.tk = wpa2_copy(&s.ptk, 32, 16)
    << out
}

// Call only after AES unwrap integrity, AP RSN consistency, GTK KDE bounds and
// key-install success have all been checked by the owner. This is an explicit
// integration boundary, not validation performed by this module. It generates
// M4 once and retries the cached bytes without requesting any key reinstall.
pub fn wpa2_handshake_confirm_keys(s $&Wpa2Handshake, verified_m3 &string) string {
    if !s.valid || s.phase != WPA2_KEY_DATA_PENDING ||
        !wpa2_equal(&s.m3, verified_m3) { << "" }
    key := wpa2_key_parse(&s.m3)
    empty := ""
    s.m4 = wpa2_reply(&s.ptk, &key, &empty, &empty, 0x030A)
    s.phase = WPA2_M4_READY
    << wpa2_copy(&s.m4, 0, s.m4.len)
}
