@embedded/wifi

// A bounded parser for one complete, FCS-stripped IEEE 802.11 beacon MPDU.
// The radio driver must independently verify DMA ownership, RX status, FCS,
// and the captured length before passing bytes here. This reports an observed
// beacon, never an association, IP lease, or authentication mode.
pub struct Beacon {
    pub valid bool
    pub ssid []int
    pub bssid []int
    pub channel int
    pub interval_tu int
    pub privacy bool
}

fn beacon_invalid() Beacon {
    << Beacon{valid: false, ssid: []int{}, bssid: []int{},
        channel: 0, interval_tu: 0, privacy: false}
}

// Byte storage keeps a DMA snapshot small on targets whose int is wider than
// one byte. A string here is an opaque byte sequence, including embedded NUL.
pub fn beacon_parse_bytes(frame &string) Beacon {
    $out := beacon_invalid()
    if frame.len < 38 || frame.len > 4096 { << out }
    // Version0, management beacon, no DS/protected/ordered/fragmented form.
    if frame[0] != 0x80 || (frame[1] & 0xC7) != 0 || (frame[22] & 15) != 0 { << out }
    for i in 4:10 { if frame[i] != 255 { << out } }
    if (frame[10] & 1) != 0 || (frame[16] & 1) != 0 { << out }
    $source := 0
    $bssid := 0
    for i in 0:6 { source = source | frame[10 + i]
        bssid = bssid | frame[16 + i] }
    if source == 0 || bssid == 0 { << out }
    interval := frame[32] | (frame[33] << 8)
    if interval == 0 { << out }
    $ssid_at := -1
    $ssid_len := 0
    $channel := 0
    $offset := 36
    while offset < frame.len {
        if frame.len - offset < 2 { << out }
        kind := frame[offset]
        length := frame[offset + 1]
        offset += 2
        if length > frame.len - offset { << out }
        if kind == 0 {
            if ssid_at >= 0 || length > 32 { << out }
            ssid_at = offset
            ssid_len = length
        } else if kind == 3 {
            if channel != 0 || length != 1 || frame[offset] < 1 || frame[offset] > 14 { << out }
            channel = frame[offset]
        }
        offset += length
    }
    if ssid_at < 0 { << out }
    $ssid := []int{}
    for i in 0:ssid_len { ssid.push(frame[ssid_at + i]) }
    $address := []int{}
    for i in 16:22 { address.push(frame[i]) }
    out.ssid = ssid
    out.bssid = address
    out.channel = channel
    out.interval_tu = interval
    out.privacy = (frame[34] & 16) != 0
    out.valid = true
    << out
}

// Convenience entry for protocol code using []int as bytes. Reject values
// outside a byte before converting; silently truncating them hides corruption.
pub fn beacon_parse(frame &[]int) Beacon {
    if frame.len < 38 || frame.len > 4096 { << beacon_invalid() }
    for i in 0:frame.len { if frame[i] < 0 || frame[i] > 255 { << beacon_invalid() } }
    $bytes := make_string(frame.len)
    for i in 0:frame.len { bytes[i] = frame[i] }
    << beacon_parse_bytes(&bytes)
}
