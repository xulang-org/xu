@embedded/wifi/session

#embedded/wifi
#embedded/wifi/ipv4

// One owning station session, carried by the device rather than mutable
// package globals. The hardware backend exclusively mutates this context.
pub struct Keys {
    pub valid bool
    pub tk string
    pub gtk string
    pub gtk_index int
    pub tx_pn string
    pub rx_unicast []string
    pub rx_group []string
}

pub struct State {
    pub ready bool
    pub linked bool
    pub status int
    pub error int
    pub mac string
    pub channel int
    pub ap wifi.StationAp
    pub ap_rsn string
    pub handshake wifi.Wpa2Handshake
    pub keys Keys
    pub client ipv4.Client
    pub sequence int
    pub rx_cursor int
    pub rx_tail int
    pub rx_pending []string
    pub lease_clock int
    pub lease_left string
    pub gateway_mac string
    pub echo_next int
    pub echo_waiting int
    pub echo_replies int
    pub last_receive int
    pub rx_packets int
    pub rx_valid int
    pub rx_authenticated int
    pub tx_packets int
    pub rx_status int
}

pub fn copy(bytes &string) string {
    $out := make_string(bytes.len)
    for i in 0:bytes.len { out[i] = bytes[i] }
    << out
}

pub fn empty_keys() Keys {
    << Keys{valid: false, tk: "", gtk: "", gtk_index: -1, tx_pn: "",
        rx_unicast: []string{}, rx_group: []string{}}
}

pub fn fresh_keys() Keys {
    $unicast := []string{}
    $group := []string{}
    for i in 0:17 { unicast.push(make_string(6))
        group.push(make_string(6)) }
    << Keys{valid: false, tk: "", gtk: "", gtk_index: -1,
        tx_pn: make_string(6), rx_unicast: unicast, rx_group: group}
}

pub fn create() State {
    // Construct empty owners directly. Calling a complete frame parser just
    // to obtain its invalid result wastes the fixed bare-metal stack budget.
    handshake := wifi.wpa2_handshake_empty()
    ap := wifi.StationAp{valid: false, ssid: "", bssid: "", channel: 0,
        capability: 0, rates: []int{}, security: -1, rsn: ""}
    << State{ready: false, linked: false, status: 0, error: 0, mac: "", channel: 0,
        ap: ap, ap_rsn: "", handshake: handshake, keys: empty_keys(),
        client: ipv4.create("",""), sequence: 1, rx_cursor: 8,
        rx_tail: -1, rx_pending: []string{}, lease_clock: 0, lease_left: "", gateway_mac: "",
        echo_next: 0, echo_waiting: 0, echo_replies: 0, last_receive: 0, rx_packets: 0, rx_valid: 0, rx_authenticated: 0, tx_packets: 0, rx_status: 0}
}

pub fn leased(state &State) bool {
    << state.linked && state.client.state == ipv4.DHCP_LEASED && state.lease_left.len == 4
}

pub fn ip_text(ip &string) string {
    if ip.len != 4 { << "0.0.0.0" }
    $buffer := make_string(15)
    $at := 0
    for i in 0:4 {
        $value := ip[i]
        if value >= 100 { buffer[at] = 48 + value / 100
            at += 1
            value = value % 100
            buffer[at] = 48 + value / 10
            at += 1 }
        else if value >= 10 { buffer[at] = 48 + value / 10
            at += 1 }
        buffer[at] = 48 + value % 10
        at += 1
        if i != 3 { buffer[at] = 46
            at += 1 }
    }
    $out := make_string(at)
    for i in 0:at { out[i] = buffer[i] }
    << out
}

// Milliseconds modulo 2^31, matching the backend's free-running timer.
// Service intervals must be shorter than half the range.
pub fn elapsed(now int, before int) int { << (now - before) & 0x7FFFFFFF }

// Lease seconds are unsigned big-endian bytes, including on 32-bit targets.
// Return a fresh countdown, or empty when the local validity budget expires.
pub fn lease_tick(left &string, seconds int) string {
    if left.len != 4 || seconds < 0 || seconds > 2147483647 { << "" }
    $out := copy(left)
    $borrow := 0
    $remaining := seconds
    $i := 3
    while i >= 0 {
        $value := out[i] - (remaining & 255) - borrow
        remaining = remaining >> 8
        borrow = 0
        if value < 0 { value += 256
            borrow = 1 }
        out[i] = value
        i -= 1
    }
    if borrow != 0 { << "" }
    $bits := 0
    for j in 0:4 { bits = bits | out[j] }
    if bits == 0 { << "" }
    << out
}
