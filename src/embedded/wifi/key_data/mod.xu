@embedded/wifi/key_data

#crypto/aes

// RFC 3394 AES-128 unwrap for WPA2 descriptor-version 2 key data. Empty
// means malformed ciphertext, a failed AES block or integrity mismatch.
// This does not install keys. The AES implementation is variable-time.
pub fn unwrap(kek &string, cipher &string) string {
    if kek.len != 16 || cipher.len < 24 || cipher.len > 2048 || cipher.len % 8 != 0 { << "" }
    c := aes.new_cipher(kek) or (err) { << "" }
    $a := make_string(8)
    $r := make_string(cipher.len - 8)
    for i in 0:8 { a[i] = cipher[i] }
    for i in 0:r.len { r[i] = cipher[8 + i] }
    count := r.len / 8
    $round := 5
    while round >= 0 {
        $i := count
        while i > 0 {
            $block := make_string(16)
            counter := count * round + i
            for j in 0:8 { block[j] = a[j] }
            for j in 0:4 { block[7 - j] = block[7 - j] ^ ((counter >> (8 * j)) & 255) }
            for j in 0:8 { block[8 + j] = r[(i - 1) * 8 + j] }
            plain := c.decrypt(&block) or (err) { << "" }
            if plain.len != 16 { << "" }
            for j in 0:8 { a[j] = plain[j]
                r[(i - 1) * 8 + j] = plain[8 + j] }
            i -= 1
        }
        round -= 1
    }
    $difference := 0
    for i in 0:8 { difference = difference | (a[i] ^ 0xA6) }
    if difference != 0 { << "" }
    << r
}

pub struct GroupKey {
    pub valid bool
    pub index int
    pub key string
}
fn invalid() GroupKey { << GroupKey{valid: false, index: 0, key: ""} }

// Parse only the deliberately narrow PSK/CCMP profile. Require the complete
// AP RSN IE captured before association, and exactly one CCMP GTK KDE. The
// caller retains the independently verified M3 RSC for replay protection.
// Unknown IEs and incomplete padding fail closed instead of installing keys.
pub fn parse(plain &string, ap_rsn &string) GroupKey {
    if plain.len < 24 || plain.len > 2040 || ap_rsn.len < 20 ||
        ap_rsn.len > 257 || ap_rsn[0] != 48 || ap_rsn[1] + 2 != ap_rsn.len { << invalid() }
    $offset := 0
    $rsn_seen := false
    $gtk_seen := false
    $index := 0
    $gtk := ""
    while offset < plain.len {
        // WPA2 key-wrap padding starts with 0xDD followed by zero bytes.
        if plain[offset] == 0xDD &&
            (offset + 1 == plain.len || plain[offset + 1] == 0) {
            for j in offset + 1:plain.len { if plain[j] != 0 { << invalid() } }
            offset = plain.len
            <-
        }
        if plain.len - offset < 2 { << invalid() }
        kind := plain[offset]
        length := plain[offset + 1]
        if length > plain.len - offset - 2 { << invalid() }
        if kind == 48 {
            if rsn_seen || length + 2 != ap_rsn.len { << invalid() }
            for j in 0:ap_rsn.len { if plain[offset + j] != ap_rsn[j] { << invalid() } }
            rsn_seen = true
        } else if kind == 221 {
            if gtk_seen || length != 22 || plain[offset + 2] != 0 ||
                plain[offset + 3] != 15 || plain[offset + 4] != 172 ||
                plain[offset + 5] != 1 || (plain[offset + 6] & 0xF8) != 0 ||
                plain[offset + 7] != 0 { << invalid() }
            index = plain[offset + 6] & 3
            $key := make_string(16)
            for j in 0:16 { key[j] = plain[offset + 8 + j] }
            gtk = key
            gtk_seen = true
        } else { << invalid() }
        offset += length + 2
    }
    if !rsn_seen || !gtk_seen { << invalid() }
    << GroupKey{valid: true, index: index, key: gtk}
}
