@net/stream

#errors
#net
#io

// Stream wraps net.Conn with the same method names tls.Conn uses
// (read / write / set_*_deadline / close) so a service loop can be
// written once. Xu has no interfaces — tls.Conn already has this
// method set; branch on a bool at the dial site if you mix both.
//
// net/stream does not import crypto/tls (tls already imports net).
// read may throw (deadline/IO); write/close follow net.Conn.

pub struct Stream {
    pub c net.Conn
}

// from_tcp wraps a net.Conn.
pub fn from_tcp(c net.Conn) Stream {
    << Stream{c: c}
}

pub fn (s &Stream) fd() int {
    c := &s.c
    << c.descriptor() or >>
}

pub fn (s Stream) remote_addr() string {
    << s.c.raddr + ""
}

// read may throw on IO/deadline error.
pub fn (s $&Stream) read(max int) string {
    c := &s.c
    << c.read(max) or >>
}

pub fn (s $&Stream) write(data &string) int {
    c := &s.c
    << c.write(data) or >>
}

pub fn (s $&Stream) set_read_deadline(t_ns int) int {
    c := $&s.c
    n := c.set_read_deadline(t_ns)
    << n
}

pub fn (s $&Stream) set_write_deadline(t_ns int) int {
    c := $&s.c
    n := c.set_write_deadline(t_ns)
    << n
}

pub fn (s $&Stream) set_deadline(t_ns int) int {
    a := s.set_read_deadline(t_ns)
    b := s.set_write_deadline(t_ns)
    if a != 0 {
        << a
    }
    << b
}

pub fn (s $&Stream) close() int {
    c := $&s.c
    << c.close() or >>
}

pub fn (s $&Stream) read_result(n int) io.ReadResult {
    c := &s.c
    << c.read_result(n)
}

pub fn (s $&Stream) write_result(data string) io.WriteResult {
    c := &s.c
    << c.write_result(data)
}
