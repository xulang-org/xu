@net

#errors

// Name lookup (Go net/lookup.go): numeric / localhost / hosts / DNS-over-TCP.

pub struct MX {
    pub host string
    pub pref int
}

pub struct NS {
    pub host string
}

pub struct SRV {
    pub target string
    pub port int
    pub priority int
    pub weight int
}

fn txt_decode(data &string) string {
    mut out := ""
    mut i := 0
    while i < data.len {
        n := data[i] & 255
        i = i + 1
        if i + n > data.len {
            << out
        }
        for k in 0:n {
            out = out + string_from_byte(data[i] & 255)
            i = i + 1
        }
    }
    << out
}

fn append_unique(out &mut []string, s string) int {
    mut i := 0
    while i < out.len {
        if out[i] == s {
            << 0
        }
        i = i + 1
    }
    out.push(s)
    << 1
}

fn lookup_host_local(host &string) []string {
    mut out := []string{}
    if host.len == 0 {
        << out
    }
    ip := parse_ip(host)
    if ip.len > 0 {
        out.push(host + "")
        << out
    }
    if is_localhost_name(host) {
        out.push("127.0.0.1")
        out.push("::1")
        from_hosts := lookup_hosts_by_name(host + "")
        mut i := 0
        while i < from_hosts.len {
            _ := append_unique(mut &out, from_hosts[i] + "")
            i = i + 1
        }
        << out
    }
    << lookup_hosts_by_name(host + "")
}

fn rr_data_of_type(rrs []DnsRR, qtype int) []string {
    mut out := []string{}
    mut i := 0
    while i < rrs.len {
        if rrs[i].typ == qtype {
            out.push(rrs[i].data + "")
        }
        i = i + 1
    }
    << out
}

fn empty_dns() DnsMsg {
    << DnsMsg{id: 0, flags: 0, question: []DnsRR{}, answer: []DnsRR{}}
}

fn dns_query_or_empty(name string, qtype int) DnsMsg {
    msg := dns_query(name, qtype) or (err) {
        << empty_dns()
    }
    << msg
}

fn lookup_dns_ips(host string, want4 bool, want6 bool) []string {
    mut out := []string{}
    name := host + ""
    if want4 {
        msg := dns_query_or_empty(name, dns_type_a)
        mut i := 0
        while i < msg.answer.len {
            if msg.answer[i].typ == dns_type_a && msg.answer[i].data.len == 4 {
                data := msg.answer[i].data + ""
                txt := ip_string(&data)
                _ := append_unique(mut &out, txt)
            }
            i = i + 1
        }
    }
    if want6 {
        msg6 := dns_query_or_empty(name, dns_type_aaaa)
        mut j := 0
        while j < msg6.answer.len {
            if msg6.answer[j].typ == dns_type_aaaa && msg6.answer[j].data.len == 16 {
                data6 := msg6.answer[j].data + ""
                txt := ip_string(&data6)
                _ := append_unique(mut &out, txt)
            }
            j = j + 1
        }
    }
    << out
}

pub fn lookup_host(host string) []string {
    if host.len == 0 {
        >> errors.new("no such host")
    }
    local := lookup_host_local(&host)
    if local.len > 0 {
        << local
    }
    ips := lookup_dns_ips(host, true, true)
    if ips.len == 0 {
        >> errors.new("no such host")
    }
    << ips
}

pub fn lookup_ip(host string) []string {
    texts := lookup_host(host)
    mut out := []string{}
    mut i := 0
    while i < texts.len {
        t := texts[i] + ""
        ip := parse_ip(&t)
        if ip.len > 0 {
            out.push(ip)
        }
        i = i + 1
    }
    if out.len == 0 {
        >> errors.new("no such host")
    }
    << out
}

pub fn lookup_cname(host string) string {
    h := host + ""
    if h.len == 0 {
        >> errors.new("no such host")
    }
    ip := parse_ip(&h)
    if ip.len > 0 {
        << h
    }
    q := h + ""
    msg := dns_query(q, dns_type_cname) or >>
    mut i := 0
    while i < msg.answer.len {
        if msg.answer[i].typ == dns_type_cname && msg.answer[i].data.len > 0 {
            << ensure_trailing_dot(msg.answer[i].data + "")
        }
        i = i + 1
    }
    << ensure_trailing_dot(h)
}

pub fn lookup_mx(name string) []MX {
    msg := dns_query(name, dns_type_mx)
    mut out := []MX{}
    mut i := 0
    while i < msg.answer.len {
        if msg.answer[i].typ == dns_type_mx && msg.answer[i].data.len >= 2 {
            data := msg.answer[i].data + ""
            pref := u16_be(&data, 0)
            host := data[2:data.len]
            out.push(MX{host: host, pref: pref})
        }
        i = i + 1
    }
    << out
}

pub fn lookup_ns(name string) []NS {
    msg := dns_query(name, dns_type_ns)
    mut out := []NS{}
    mut i := 0
    while i < msg.answer.len {
        if msg.answer[i].typ == dns_type_ns && msg.answer[i].data.len > 0 {
            out.push(NS{host: msg.answer[i].data + ""})
        }
        i = i + 1
    }
    << out
}

pub fn lookup_txt(name string) []string {
    msg := dns_query(name, dns_type_txt)
    mut out := []string{}
    mut i := 0
    while i < msg.answer.len {
        if msg.answer[i].typ == dns_type_txt {
            data := msg.answer[i].data + ""
            out.push(txt_decode(&data))
        }
        i = i + 1
    }
    << out
}

pub fn lookup_srv(service string, proto string, name string) []SRV {
    q := "_" + service + "._" + proto + "." + name
    msg := dns_query(q, dns_type_srv) or >>
    mut out := []SRV{}
    mut i := 0
    while i < msg.answer.len {
        if msg.answer[i].typ == dns_type_srv && msg.answer[i].data.len >= 6 {
            data := msg.answer[i].data + ""
            prio := u16_be(&data, 0)
            weight := u16_be(&data, 2)
            port := u16_be(&data, 4)
            target := data[6:data.len]
            out.push(SRV{target: target, port: port, priority: prio, weight: weight})
        }
        i = i + 1
    }
    << out
}

fn reverse_ptr_name(ip &string) string {
    v4 := ip_to4(ip)
    if v4.len == 4 {
        << u8_to_dec(v4[3] & 255) + "." + u8_to_dec(v4[2] & 255) + "." + u8_to_dec(v4[1] & 255) + "." + u8_to_dec(v4[0] & 255) + ".in-addr.arpa"
    }
    if ip.len != 16 {
        >> errors.new("unrecognized address")
    }
    hex := "0123456789abcdef"
    mut out := ""
    mut i := 15
    while i >= 0 {
        b := ip[i] & 255
        if out.len > 0 {
            out = out + "."
        }
        out = out + string_from_byte(hex[b & 15])
        out = out + "."
        out = out + string_from_byte(hex[(b >> 4) & 15])
        i = i - 1
    }
    << out + ".ip6.arpa"
}

pub fn lookup_addr(addr string) []string {
    ip := parse_ip(&addr)
    if ip.len == 0 {
        >> errors.new("unrecognized address")
    }
    from_hosts := lookup_hosts_by_addr(addr)
    if from_hosts.len > 0 {
        << from_hosts
    }
    q := reverse_ptr_name(&ip)
    msg := dns_query(q, dns_type_ptr)
    mut out := []string{}
    mut i := 0
    while i < msg.answer.len {
        if msg.answer[i].typ == dns_type_ptr && msg.answer[i].data.len > 0 {
            out.push(msg.answer[i].data + "")
        }
        i = i + 1
    }
    if out.len == 0 {
        >> errors.new("no such host")
    }
    << out
}
