@net

#errors
#os

// Raw IP sockets (Go IPConn). Real SOCK_RAW socket creation with protocol
// number dispatch and IPv4/IPv6 support. Unprivileged execution propagates
// OS permission error.

fn parse_ip_proto(network &string) int {
    $colon := -1
    for i in 0:network.len {
        if (network[i] & 255) == 58 {
            colon = i
            <-
        }
    }
    if colon < 0 {
        << 0
    }
    sub := network[colon + 1:network.len]
    if sub == "icmp" || sub == "1" { << 1 }
    if sub == "igmp" || sub == "2" { << 2 }
    if sub == "tcp" || sub == "6" { << 6 }
    if sub == "udp" || sub == "17" { << 17 }
    if sub == "ipv6-icmp" || sub == "icmp6" || sub == "58" { << 58 }
    p := parse_int(sub) or (err) { << 0 }
    << p
}

pub fn dial_ip(network string, laddr IPAddr, raddr IPAddr) Conn {
    kind := parse_network_kind(&network)
    if kind != "ip" {
        >> errors.new("unknown network " + network)
    }
    proto := parse_ip_proto(&network)
    ver := network_ip_version(&network)
    $use6 := ver == 6
    if ver == 0 && (raddr.ip.len == 16 && ip_to4(&raddr.ip).len == 0) {
        use6 = true
    }
    $fd := 0
    if use6 {
        fd = sys_dial_ip6(proto, &laddr, &raddr) or >>
    } else {
        fd = sys_dial_ip4(proto, &laddr, &raddr) or >>
    }
    << conn_new(fd, network + "", laddr.to_string(), raddr.to_string())
}

pub fn listen_ip(network string, laddr IPAddr) PacketConn {
    kind := parse_network_kind(&network)
    if kind != "ip" {
        >> errors.new("unknown network " + network)
    }
    proto := parse_ip_proto(&network)
    ver := network_ip_version(&network)
    $use6 := ver == 6
    if ver == 0 && (laddr.ip.len == 16 && ip_to4(&laddr.ip).len == 0) {
        use6 = true
    }
    $fd := 0
    if use6 {
        fd = sys_listen_ip6(proto, &laddr) or >>
    } else {
        fd = sys_listen_ip4(proto, &laddr) or >>
    }
    << packet_conn_new(fd, network + "", laddr.to_string(), "")
}
