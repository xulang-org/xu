@net

#errors

// Raw IP sockets (Go IPConn). ResolveIPAddr works; DialIP/ListenIP wait
// on SOCK_RAW runtime support.

pub fn dial_ip(network string, laddr IPAddr, raddr IPAddr) Conn {
    kind := parse_network_kind(&network)
    if kind != "ip" {
        >> errors.new("unknown network " + network)
    }
    if laddr.ip.len < 0 || raddr.ip.len < 0 {
        >> errors.new("net: invalid address")
    }
    >> errors.new("net: raw IP sockets are not available on this target")
    << conn_new(-1, "ip", "", "")
}

pub fn listen_ip(network string, laddr IPAddr) PacketConn {
    kind := parse_network_kind(&network)
    if kind != "ip" {
        >> errors.new("unknown network " + network)
    }
    if laddr.ip.len < 0 {
        >> errors.new("net: invalid address")
    }
    >> errors.new("net: raw IP sockets are not available on this target")
    << PacketConn{fd: -1, network: "ip", laddr: "", raddr: ""}
}
