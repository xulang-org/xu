@net

#errors
#context

// Dialer / ListenConfig and Go-shaped Dial/Listen (network, address).
// Context is for Dial/Listen (Go DialContext / ListenConfig.Listen), not
// for Conn.Read/Write — those use SetDeadline like Go.
// The fd-level dial(addr)/listen(addr) in mod.xu stay for http/smtp.

pub struct Dialer {
    // timeout_ns is a relative connect bound (SO_SNDTIMEO). 0 means
    // no extra bound; context.deadline_ns still applies. dual_stack /
    // local_ip / local_port are stored for API shape and ignored by the
    // stream dialer; UDP callers pass explicit local addresses.
    pub timeout_ns int
    pub dual_stack bool
    pub local_ip string
    pub local_port int
}

pub struct ListenConfig {
    pub reuse bool
}

pub fn new_dialer() Dialer {
    << Dialer{timeout_ns: 0, dual_stack: true, local_ip: "", local_port: 0}
}

pub fn new_listen_config() ListenConfig {
    << ListenConfig{reuse: true}
}

fn ip4_or_throw(ip string, what string) string {
    v4 := ip_to4(&ip)
    if v4.len == 4 {
        << v4
    }
    >> errors.new("net: " + what + " needs IPv4")
    << ""
}

fn ip6_or_throw(ip string, what string) string {
    if ip.len == 16 && ip_to4(&ip).len == 0 {
        << ip + ""
    }
    >> errors.new("net: " + what + " needs IPv6")
    << ""
}

fn dial_tcp4_raw(ip string, port int) int {
    << dial_tcp4_raw_timeout(ip, port, 0)
}

fn dial_tcp4_raw_timeout(ip string, port int, ns int) int {
    v4 := ip4_or_throw(ip, "dial")
    << sys_dial_tcp4_timeout(v4[0] & 255, v4[1] & 255, v4[2] & 255, v4[3] & 255, port, ns)
}

fn listen_tcp4_raw(ip string, port int) int {
    v4 := ip4_or_throw(ip, "listen")
    << sys_listen_tcp4(v4[0] & 255, v4[1] & 255, v4[2] & 255, v4[3] & 255, port)
}

fn dial_tcp6_raw(ip string, port int) int {
    v6 := ip6_or_throw(ip, "dial")
    << sys_dial_tcp6(v6, port, 0)
}

fn dial_tcp6_raw_timeout(ip string, port int, ns int) int {
    v6 := ip6_or_throw(ip, "dial")
    << sys_dial_tcp6(v6, port, ns)
}

fn listen_tcp6_raw(ip string, port int) int {
    v6 := ip6_or_throw(ip, "listen")
    << sys_listen_tcp6(v6, port)
}

fn dial_udp4_raw(laddr &UDPAddr, raddr &UDPAddr) int {
    remote := ip4_or_throw(raddr.ip + "", "UDP dial")
    mut local := ipv4_zero()
    mut bind_local := false
    if laddr.ip.len > 0 {
        local = ip4_or_throw(laddr.ip + "", "UDP local address")
        bind_local = true
    }
    if laddr.port != 0 {
        bind_local = true
    }
    << sys_dial_udp4(
        local[0] & 255, local[1] & 255, local[2] & 255, local[3] & 255, laddr.port,
        remote[0] & 255, remote[1] & 255, remote[2] & 255, remote[3] & 255, raddr.port,
        bind_local
    )
}

fn dial_udp6_raw(laddr &UDPAddr, raddr &UDPAddr) int {
    remote := ip6_or_throw(raddr.ip + "", "UDP dial")
    mut local := ipv6_unspecified()
    mut bind_local := false
    if laddr.ip.len > 0 {
        local = ip6_or_throw(laddr.ip + "", "UDP local address")
        bind_local = true
    }
    if laddr.port != 0 {
        bind_local = true
    }
    << sys_dial_udp6(local, laddr.port, remote, raddr.port, bind_local)
}

pub fn dial_tcp(network string, laddr TCPAddr, raddr TCPAddr) Conn {
    kind := parse_network_kind(&network)
    if kind != "tcp" {
        >> errors.new("unknown network " + network)
    }
    if laddr.port < 0 {
        >> errors.new("net: invalid local address")
    }
    ver := network_ip_version(&network)
    mut use6 := ver == 6
    if ver == 0 && raddr.ip.len == 16 && ip_to4(&raddr.ip).len == 0 {
        use6 = true
    }
    mut fd := 0
    if use6 {
        fd = dial_tcp6_raw(raddr.ip + "", raddr.port)
    } else {
        fd = dial_tcp4_raw(raddr.ip + "", raddr.port)
    }
    rem := raddr.to_string()
    << conn_new(fd, "tcp", "", rem)
}

pub fn listen_tcp(network string, laddr TCPAddr) Listener {
    kind := parse_network_kind(&network)
    if kind != "tcp" {
        >> errors.new("unknown network " + network)
    }
    mut ip := laddr.ip + ""
    if ip.len == 0 {
        if network_ip_version(&network) == 6 {
            ip = ipv6_unspecified()
        } else {
            ip = ipv4_zero()
        }
    }
    ver := network_ip_version(&network)
    mut use6 := ver == 6
    if ver == 0 && ip.len == 16 && ip_to4(&ip).len == 0 {
        use6 = true
    }
    mut fd := 0
    if use6 {
        fd = listen_tcp6_raw(ip, laddr.port)
    } else {
        fd = listen_tcp4_raw(ip, laddr.port)
    }
    loc := laddr.to_string()
    << Listener{fd: fd, network: network + "", addr: loc}
}

pub fn dial_to(network string, address string) Conn {
    kind := parse_network_kind(&network)
    if kind == "tcp" {
        a := resolve_tcp_addr(network, address)
        << dial_tcp(network, new_tcp_addr(), a)
    }
    if kind == "udp" {
        a := resolve_udp_addr(network, address)
        mut local := new_udp_addr()
        mut fd := 0
        if network_ip_version(&network) == 6 || (network_ip_version(&network) == 0 && a.ip.len == 16 && ip_to4(&a.ip).len == 0) {
            fd = dial_udp6_raw(&local, &a)
        } else {
            fd = dial_udp4_raw(&local, &a)
        }
        rem := a.clone().to_string()
        << conn_new(fd, network + "", "", rem)
    }
    if kind == "unix" {
        a := resolve_unix_addr(network, address)
        << dial_unix(network, new_unix_addr(), a)
    }
    if kind == "ip" {
        >> errors.new("net: raw IP sockets are not available on this target")
    }
    >> errors.new("unknown network " + network)
    << conn_new(-1, "", "", "")
}

pub fn listen_on(network string, address string) Listener {
    kind := parse_network_kind(&network)
    if kind == "tcp" {
        a := resolve_tcp_addr(network, address)
        << listen_tcp(network, a)
    }
    if kind == "udp" {
        >> errors.new("net: UDP listen is listen_udp, not Listen")
    }
    if kind == "unix" {
        a := resolve_unix_addr(network, address)
        << listen_unix(network, a)
    }
    if kind == "ip" {
        >> errors.new("net: raw IP sockets are not available on this target")
    }
    >> errors.new("unknown network " + network)
    << Listener{fd: -1, network: "", addr: ""}
}

fn close_fd_ignore(fd int) {
    conn_close(fd) or (err) {
        <<
    }
}

fn connect_ns(ctx &context.Context, extra_ns int) int {
    dl := ctx.deadline_ns
    context.err(ctx) or >>
    mut ns := extra_ns
    if dl > 0 {
        rem := dl - now_ns()
        if rem <= 0 {
            >> errors.new("context deadline exceeded")
        }
        if ns <= 0 || rem < ns {
            ns = rem
        }
    }
    << ns
}

fn dial_to_timeout(network string, address string, ns int) Conn {
    kind := parse_network_kind(&network)
    if kind == "tcp" {
        a := resolve_tcp_addr(network, address)
        mut fd := 0
        if network_ip_version(&network) == 6 || (network_ip_version(&network) == 0 && a.ip.len == 16 && ip_to4(&a.ip).len == 0) {
            fd = dial_tcp6_raw_timeout(a.ip + "", a.port, ns)
        } else {
            fd = dial_tcp4_raw_timeout(a.ip + "", a.port, ns)
        }
        rem := a.to_string()
        << conn_new(fd, "tcp", "", rem)
    }
    if kind == "unix" {
        _ := require_unix_stream(network + "") or >>
        a := resolve_unix_addr(network, address)
        if a.name.len == 0 {
            >> errors.new("net: unix socket path is empty")
        }
        if xu_target_os() == 2 {
            >> errors.new("net: unix sockets are not available on this target")
        }
        fd := sys_dial_unix_timeout("", a.name + "", ns)
        << conn_new(fd, "unix", "", a.name + "")
    }
    << dial_to(network, address)
}

fn dial_context_once(ctx &context.Context, network string, address string) Conn {
    ns := connect_ns(ctx, 0) or >>
    << dial_to_timeout(network, address, ns)
}

fn dial_context_timeout(ctx &context.Context, extra_ns int, network string, address string) Conn {
    ns := connect_ns(ctx, extra_ns) or >>
    << dial_to_timeout(network, address, ns)
}

// dial_context is Go net.DialContext.
pub fn dial_context(ctx &context.Context, network string, address string) Conn {
    << new_dialer().dial_context(ctx, network, address)
}

pub fn (d Dialer) dial(network string, address string) Conn {
    mut ctx := context.background()
    << d.dial_context(&ctx, network, address) or >>
}

pub fn (d Dialer) dial_context(ctx &context.Context, network string, address string) Conn {
    if d.timeout_ns < 0 {
        >> errors.new("net: negative timeout")
    }
    if d.timeout_ns > 0 {
        << dial_context_timeout(ctx, d.timeout_ns, network, address)
    }
    << dial_context_once(ctx, network, address)
}

pub fn dial_timeout(network string, address string, timeout_ns int) Conn {
    mut d := new_dialer()
    d.timeout_ns = timeout_ns
    << d.dial(network, address) or >>
}

// listen is Go ListenConfig.Listen(ctx, network, address).
pub fn (c ListenConfig) listen(ctx &context.Context, network string, address string) Listener {
    context.err(ctx) or >>
    _ := c.reuse
    << listen_on(network, address)
}

pub fn listen_packet(network string, address string) PacketConn {
    kind := parse_network_kind(&network)
    if kind == "udp" {
        a := resolve_udp_addr(network, address)
        << listen_udp(network, a)
    }
    if kind == "unix" {
        >> errors.new("net: unix sockets are not available on this target")
    }
    if kind == "ip" {
        >> errors.new("net: raw IP sockets are not available on this target")
    }
    >> errors.new("unknown network " + network)
    << PacketConn{fd: -1, network: "", laddr: "", raddr: ""}
}
