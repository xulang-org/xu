@net

#errors
#os

// 高层 net runtime：只通过 #os 碰 socket（规划 §0）。

const af_inet = 2
const af_unix = 1
const sock_stream = 1
const sock_dgram = 2
const listen_backlog = 128

fn close_quiet(fd int) {
    // Socket descriptors are SOCKET handles on Windows; use the dedicated
    // close path on every target (it aliases close(2) on Unix).
    os.socket_close(fd) or (err) {
        <<
    }
}

fn remove_quiet_path(path string) {
    os.remove(path) or (err) {
        <<
    }
}

fn af_inet6() int {
    os := xu_target_os()
    if os == 0 {
        << 30 // Darwin AF_INET6
    }
    if os == 2 {
        << 23 // Winsock AF_INET6
    }
    << 10 // Linux and other Unix targets
}

fn sys_dial_tcp4(a int, b int, c int, d int, port int) int {
    << sys_dial_tcp4_timeout(a, b, c, d, port, 0)
}

fn sys_dial_unix(local string, remote string) int {
    << sys_dial_unix_timeout(local, remote, 0)
}

fn sys_dial_unix_timeout(local string, remote string, ns int) int {
    fd := os.socket(af_unix, sock_stream, 0) or >>
    if local.len > 0 {
        os.bind_unix(fd, local + "") or (err) {
            close_quiet(fd)
            >> err
        }
    }
    if ns > 0 {
        os.set_sock_timeout(fd, ns) or (err) {
            close_quiet(fd)
            if local.len > 0 {
                remove_quiet_path(local + "")
            }
            >> err
        }
    }
    os.connect_unix(fd, remote + "") or (err) {
        close_quiet(fd)
        if local.len > 0 {
            remove_quiet_path(local + "")
        }
        >> err
    }
    if ns > 0 {
        os.set_sock_timeout(fd, 0) or (err) {
            close_quiet(fd)
            if local.len > 0 {
                remove_quiet_path(local + "")
            }
            >> err
        }
    }
    << fd
}

fn sys_listen_unix(path string) int {
    fd := os.socket(af_unix, sock_stream, 0) or >>
    os.bind_unix(fd, path + "") or (err) {
        close_quiet(fd)
        >> err
    }
    os.listen(fd, listen_backlog) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_tcp4_timeout(a int, b int, c int, d int, port int, ns int) int {
    fd := os.socket(af_inet, sock_stream, 0) or >>
    if ns > 0 {
        os.set_sock_timeout(fd, ns) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.connect4(fd, a, b, c, d, port) or (err) {
        close_quiet(fd)
        >> err
    }
    if ns > 0 {
        os.set_sock_timeout(fd, 0) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    << fd
}

fn sys_dial_tcp6(ip string, port int, ns int) int {
    if ip.len != 16 {
        >> errors.new("net: IPv6 address must be 16 bytes")
    }
    fd := os.socket(af_inet6(), sock_stream, 0) or >>
    if ns > 0 {
        os.set_sock_timeout(fd, ns) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.connect6(fd, ip + "", port) or (err) {
        close_quiet(fd)
        >> err
    }
    if ns > 0 {
        os.set_sock_timeout(fd, 0) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    << fd
}

fn sys_listen_tcp4(a int, b int, c int, d int, port int) int {
    fd := os.socket(af_inet, sock_stream, 0) or >>
    os.bind4(fd, a, b, c, d, port) or (err) {
        close_quiet(fd)
        >> err
    }
    os.listen(fd, listen_backlog) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_listen_tcp6(ip string, port int) int {
    if ip.len != 16 {
        >> errors.new("net: IPv6 address must be 16 bytes")
    }
    fd := os.socket(af_inet6(), sock_stream, 0) or >>
    os.bind6(fd, ip + "", port) or (err) {
        close_quiet(fd)
        >> err
    }
    os.listen(fd, listen_backlog) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_listen_udp4(a int, b int, c int, d int, port int) int {
    fd := os.socket(af_inet, sock_dgram, 0) or >>
    os.bind4(fd, a, b, c, d, port) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_udp4(la int, lb int, lc int, ld int, lport int, ra int, rb int, rc int, rd int, rport int, bind_local bool) int {
    fd := os.socket(af_inet, sock_dgram, 0) or >>
    if bind_local {
        os.bind4(fd, la, lb, lc, ld, lport) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.connect4(fd, ra, rb, rc, rd, rport) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_udp6(local string, lport int, remote string, rport int, bind_local bool) int {
    if local.len != 16 || remote.len != 16 {
        >> errors.new("net: IPv6 address must be 16 bytes")
    }
    fd := os.socket(af_inet6(), sock_dgram, 0) or >>
    if bind_local {
        os.bind6(fd, local + "", lport) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.connect6(fd, remote + "", rport) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}
