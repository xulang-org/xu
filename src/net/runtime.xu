@net

#errors
#os

// 高层 net runtime：只通过 #os 碰 socket（规划 §0）。

const AF_INET = 2
const AF_UNIX = 1
const SOCK_STREAM = 1
const SOCK_DGRAM = 2
const SOCK_RAW = 3
const LISTEN_BACKLOG = 128

fn close_quiet(fd int) {
    // Socket descriptors are SOCKET handles on Windows; use the dedicated
    // close path on every target (it aliases close(2) on Unix).
    os.socket_close(fd) or (err) {
        <<
    }
}

fn remove_quiet_path(path string) {
    os.remove(path) or (err) {
        <<
    }
}

fn af_inet6() int {
    os := xu_target_os()
    if os == 0 {
        << 30 // Darwin AF_INET6
    }
    if os == 2 {
        << 23 // Winsock AF_INET6
    }
    << 10 // Linux and other Unix targets
}

fn sys_dial_tcp4(a int, b int, c int, d int, port int) int {
    << sys_dial_tcp4_timeout(a, b, c, d, port, 0)
}

fn sys_dial_unix(local string, remote string) int {
    << sys_dial_unix_timeout(local, remote, 0)
}

fn sys_dial_unix_timeout(local string, remote string, ns int) int {
    fd := os.socket(AF_UNIX, SOCK_STREAM, 0) or >>
    if local.len > 0 {
        os.bind_unix(fd, local + "") or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.connect_unix(fd, remote + "") or (err) {
        close_quiet(fd)
        if local.len > 0 {
            remove_quiet_path(local + "")
        }
        >> err
    }
    << fd
}

fn sys_listen_unix(path string) int {
    fd := os.socket(AF_UNIX, SOCK_STREAM, 0) or >>
    os.bind_unix(fd, path + "") or (err) {
        close_quiet(fd)
        >> err
    }
    os.listen(fd, LISTEN_BACKLOG) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_tcp4_timeout(a int, b int, c int, d int, port int, ns int) int {
    fd := os.socket(AF_INET, SOCK_STREAM, 0) or >>
    os.connect4(fd, a, b, c, d, port) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_tcp6(ip string, port int, ns int) int {
    if ip.len != 16 {
        >> errors.new("net: IPv6 address must be 16 bytes")
    }
    fd := os.socket(af_inet6(), SOCK_STREAM, 0) or >>
    os.connect6(fd, ip + "", port) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn setsockopt_ignore(fd int, level int, opt int, val int) {
    os.setsockopt_int(fd, level, opt, val) or (err) {
        <<
    }
}

fn sys_listen_tcp4(a int, b int, c int, d int, port int) int {
    << sys_listen_tcp4_reuse(a, b, c, d, port, true)
}

fn sys_listen_tcp4_reuse(a int, b int, c int, d int, port int, reuse bool) int {
    fd := os.socket(AF_INET, SOCK_STREAM, 0) or >>
    if reuse {
        setsockopt_ignore(fd, sol_socket(), so_reuseaddr(), 1)
        rp := so_reuseport()
        if rp > 0 {
            setsockopt_ignore(fd, sol_socket(), rp, 1)
        }
    }
    os.bind4(fd, a, b, c, d, port) or (err) {
        close_quiet(fd)
        >> err
    }
    os.listen(fd, LISTEN_BACKLOG) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_listen_tcp6(ip string, port int) int {
    << sys_listen_tcp6_reuse(ip, port, true)
}

fn sys_listen_tcp6_reuse(ip string, port int, reuse bool) int {
    if ip.len != 16 {
        >> errors.new("net: IPv6 address must be 16 bytes")
    }
    fd := os.socket(af_inet6(), SOCK_STREAM, 0) or >>
    if reuse {
        setsockopt_ignore(fd, sol_socket(), so_reuseaddr(), 1)
        rp := so_reuseport()
        if rp > 0 {
            setsockopt_ignore(fd, sol_socket(), rp, 1)
        }
    }
    os.bind6(fd, ip + "", port) or (err) {
        close_quiet(fd)
        >> err
    }
    os.listen(fd, LISTEN_BACKLOG) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_listen_udp4(a int, b int, c int, d int, port int) int {
    << sys_listen_udp4_reuse(a, b, c, d, port, false)
}

fn sys_listen_udp4_reuse(a int, b int, c int, d int, port int, reuse bool) int {
    fd := os.socket(AF_INET, SOCK_DGRAM, 0) or >>
    if reuse {
        setsockopt_ignore(fd, sol_socket(), so_reuseaddr(), 1)
        rp := so_reuseport()
        if rp > 0 {
            setsockopt_ignore(fd, sol_socket(), rp, 1)
        }
    }
    os.bind4(fd, a, b, c, d, port) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_listen_udp6(ip string, port int) int {
    << sys_listen_udp6_reuse(ip, port, false)
}

fn sys_listen_udp6_reuse(ip string, port int, reuse bool) int {
    if ip.len != 16 {
        >> errors.new("net: IPv6 address must be 16 bytes")
    }
    fd := os.socket(af_inet6(), SOCK_DGRAM, 0) or >>
    if reuse {
        setsockopt_ignore(fd, sol_socket(), so_reuseaddr(), 1)
        rp := so_reuseport()
        if rp > 0 {
            setsockopt_ignore(fd, sol_socket(), rp, 1)
        }
    }
    os.bind6(fd, ip + "", port) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_udp4(la int, lb int, lc int, ld int, lport int, ra int, rb int, rc int, rd int, rport int, bind_local bool) int {
    fd := os.socket(AF_INET, SOCK_DGRAM, 0) or >>
    if bind_local {
        os.bind4(fd, la, lb, lc, ld, lport) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.connect4(fd, ra, rb, rc, rd, rport) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_udp6(local string, lport int, remote string, rport int, bind_local bool) int {
    if local.len != 16 || remote.len != 16 {
        >> errors.new("net: IPv6 address must be 16 bytes")
    }
    fd := os.socket(af_inet6(), SOCK_DGRAM, 0) or >>
    if bind_local {
        os.bind6(fd, local + "", lport) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.connect6(fd, remote + "", rport) or (err) {
        close_quiet(fd)
        >> err
    }
    << fd
}

fn sys_dial_ip4(proto int, laddr &IPAddr, raddr &IPAddr) int {
    fd := os.socket(AF_INET, SOCK_RAW, proto) or >>
    if laddr.ip.len > 0 {
        v4 := ip_to4(&laddr.ip)
        if v4.len == 4 {
            os.bind4(fd, v4[0] & 255, v4[1] & 255, v4[2] & 255, v4[3] & 255, 0) or (err) {
                close_quiet(fd)
                >> err
            }
        }
    }
    if raddr.ip.len > 0 {
        v4r := ip_to4(&raddr.ip)
        if v4r.len == 4 {
            os.connect4(fd, v4r[0] & 255, v4r[1] & 255, v4r[2] & 255, v4r[3] & 255, 0) or (err) {
                close_quiet(fd)
                >> err
            }
        }
    }
    << fd
}

fn sys_listen_ip4(proto int, laddr &IPAddr) int {
    fd := os.socket(AF_INET, SOCK_RAW, proto) or >>
    if laddr.ip.len > 0 {
        v4 := ip_to4(&laddr.ip)
        if v4.len == 4 {
            os.bind4(fd, v4[0] & 255, v4[1] & 255, v4[2] & 255, v4[3] & 255, 0) or (err) {
                close_quiet(fd)
                >> err
            }
        }
    }
    << fd
}

fn sys_dial_ip6(proto int, laddr &IPAddr, raddr &IPAddr) int {
    fd := os.socket(af_inet6(), SOCK_RAW, proto) or >>
    if laddr.ip.len == 16 {
        os.bind6(fd, laddr.ip + "", 0) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    if raddr.ip.len == 16 {
        os.connect6(fd, raddr.ip + "", 0) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    << fd
}

fn sys_listen_ip6(proto int, laddr &IPAddr) int {
    fd := os.socket(af_inet6(), SOCK_RAW, proto) or >>
    if laddr.ip.len == 16 {
        os.bind6(fd, laddr.ip + "", 0) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    << fd
}
