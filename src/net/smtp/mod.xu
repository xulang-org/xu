@net/smtp


#errors
#net
#net/textproto

// SMTP client subset aligned with Go `net/smtp` Client: Dial + EHLO/HELO
// + MAIL + RCPT + DATA + QUIT over existing IPv4 TCP. No TLS, AUTH, or
// SendMail STARTTLS. Client is filled in-place (no Result<Client> in this
// subset — Dial still mutates a caller-owned client).

// Bytes requested from the SMTP transport per read.
const smtp_read_chunk_bytes = 4096
// Maximum buffered SMTP response size in bytes.
const smtp_max_response_bytes = 1048576
// Read-round budget while waiting for one SMTP response line.
const smtp_max_line_read_rounds = 1024
// Maximum lines in one multiline SMTP reply.
const smtp_max_reply_lines = 64

pub struct Client {
    fd int
    pub buf string
    pub did_hello int
    pub local_name string
    pub sticky string
}

pub fn new_client() Client {
    << Client{fd: -1, buf: "", did_hello: 0, local_name: "localhost", sticky: ""}
}

fn crlf() string {
    << string_from_byte(13) + string_from_byte(10)
}

fn validate_line(s &string) bool {
    for i in 0:s.len {
        c := s[i] & 255
        if c == 13 || c == 10 {
            << false
        }
    }
    << true
}

fn (c &mut Client) read_more() int {
    chunk := net.conn_read(c.fd, smtp_read_chunk_bytes) or >>
    if chunk.len == 0 {
        << 0
    }
    have := c.buf.len
    r := mut &c.buf
    r.push_str(chunk)
    if have + chunk.len > smtp_max_response_bytes {
        >> errors.new("smtp: response too large")
    }
    << chunk.len
}

fn (c &mut Client) read_line() string {
    for round in 0:smtp_max_line_read_rounds {
        mut i := 0
        while i < c.buf.len {
            if (c.buf[i] & 255) == 10 {
                mut end := i
                if end > 0 && (c.buf[end - 1] & 255) == 13 {
                    end = end - 1
                }
                mut line := ""
                if end > 0 {
                    line = c.buf[0:end] + ""
                }
                rest := c.buf[(i + 1):c.buf.len] + ""
                c.buf = rest
                << line
            }
            i = i + 1
        }
        n_r := c.read_more() or >>
        if n_r == 0 {
            >> errors.new("smtp: eof")
        }
    }
    >> errors.new("smtp: line too long")
}

fn (c &mut Client) read_expect(expect int) int {
    mut last := 0
    for round in 0:smtp_max_reply_lines {
        line := c.read_line() or >>
        cl := textproto.parse_code_line(&line) or >>
        last = cl.code
        if !cl.cont {
            if last != expect {
                >> errors.new("smtp: unexpected code")
            }
            << last
        }
    }
    >> errors.new("smtp: too many lines")
}

fn (c &mut Client) cmd(expect int, line &string) int {
    msg := (line + "") + crlf()
    w := net.conn_write(c.fd, &msg) or >>
    _ := w
    << c.read_expect(expect)
}

pub fn (c &mut Client) dial(addr string) int {
    c.close() or >>
    fd := net.dial(addr) or >>
    c.fd = fd
    c.buf = ""
    << c.read_expect(220) or >>
}

pub fn (c &mut Client) hello(name &string) int {
    if c.did_hello != 0 {
        >> errors.new("smtp: Hello called after other methods")
    }
    mut nm := name + ""
    if nm.len == 0 {
        nm = "localhost"
    }
    if !validate_line(&nm) {
        >> errors.new("smtp: a line must not contain CR or LF")
    }
    c.local_name = nm
    << c.do_hello() or >>
}

fn (c &mut Client) do_hello() int {
    if c.did_hello != 0 {
        << 250
    }
    c.did_hello = 1
    eh := "EHLO " + (c.local_name + "")
    er := c.cmd(250, &eh) or >>
    if er == 250 {
        << er
    }
    hh := "HELO " + (c.local_name + "")
    << c.cmd(250, &hh) or >>
}

pub fn (c &mut Client) mail(from &string) int {
    if !validate_line(from) {
        >> errors.new("smtp: a line must not contain CR or LF")
    }
    c.do_hello() or >>
    cmd := "MAIL FROM:<" + (from + "") + ">"
    << c.cmd(250, &cmd) or >>
}

pub fn (c &mut Client) rcpt(to &string) int {
    if !validate_line(to) {
        >> errors.new("smtp: a line must not contain CR or LF")
    }
    cmd := "RCPT TO:<" + (to + "") + ">"
    << c.cmd(250, &cmd) or >>
}

pub fn (c &mut Client) data(body &string) int {
    d := "DATA"
    c.cmd(354, &d) or >>
    nl := crlf()
    mut payload := body + ""
    if payload.len < 2 {
        payload = payload + nl
    } else {
        last_cr := (payload[payload.len - 2] & 255) == 13
        last_lf := (payload[payload.len - 1] & 255) == 10
        if !(last_cr && last_lf) {
            payload = payload + nl
        }
    }
    payload = payload + "." + nl
    w2 := net.conn_write(c.fd, &payload) or >>
    _ := w2
    << c.read_expect(250) or >>
}

pub fn (c &mut Client) send_mail(from &string, to &string, body &string) int {
    c.mail(from) or >>
    c.rcpt(to) or >>
    << c.data(body) or >>
}

pub fn (c &mut Client) quit() int {
    q := "QUIT"
    << c.cmd(221, &q) or >>
}

pub fn (c &mut Client) close() int {
    if c.fd < 0 {
        << 0
    }
    fd := c.fd
    c.fd = -1
    net.conn_close(fd) or >>
    << 0
}

fn (c &mut Client) drop() { c.close() or (err) { << } }
