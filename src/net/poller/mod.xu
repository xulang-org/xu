@net/poller

#errors
#net
#net/stream
#os
#time
core #runtime/core

// Connection registry for long-lived peers (gateway / 5k sessions).
//
// Linux and Darwin use a persistent EventSet. Windows batches the socket
// probes. Event tokens identify registrations independently of reused
// descriptors and slots.

pub const EVENT_READ = 1
pub const EVENT_WRITE = 2
pub const EVENT_ERROR = 4
pub const EVENT_HANGUP = 8

pub struct Event {
    pub id int
    pub events int
}

struct PollSlot {
    id int
    interest int
    conn stream.Stream
    next_free int
}

fn vacant_slot(next_free int) PollSlot {
    << PollSlot{id: 0, interest: 0, conn: stream.from_tcp(net.closed_conn()), next_free: next_free}
}

pub struct Poller {
    slots []PollSlot
    indices map[int]int
    free_head int
    active int
    next_id int
    es EventSet
}

// new creates an empty registry.
pub fn new() Poller {
    $p := Poller{slots: []PollSlot{}, indices: map[int]int{}, free_head: -1, active: 0, next_id: 1, es: EventSet{handle: -1}}
    if event_set_supported() {
        es := new_event_set() or (err) { << p }
        p.es = es
    }
    << p
}

fn find(p $&Poller, id int) int {
    << p.indices.get_or(id, -1)
}

// add registers a stream with default EVENT_READ interest. Returns a stable id (>0).
pub fn (p $&Poller) add(s stream.Stream) int {
    << p.add_interest(s, EVENT_READ)
}

// add_interest registers a stream with the specified event interest mask.
pub fn (p $&Poller) add_interest(s stream.Stream, interest int) int {
    id := p.next_id
    p.next_id = p.next_id + 1
    $idx := p.free_head
    if idx < 0 {
        idx = p.slots.len
        p.slots.push(vacant_slot(-1))
    } else {
        p.free_head = p.slots[idx].next_free
    }
    p.slots[idx] = PollSlot{id: id, interest: interest, conn: s, next_free: -1}
    indices := $&p.indices
    indices[id] = idx
    p.active += 1
    if p.es.handle >= 0 {
        fd := p.slots[idx].conn.fd() or (err) {
            << id
        }
        es := $&p.es
        es.watch(fd, id, interest) or (err) {
            << id
        }
    }
    << id
}

// set_interest modifies event interest for an already registered stream.
pub fn (p $&Poller) set_interest(id int, interest int) bool {
    idx := find(p, id)
    if idx < 0 {
        << false
    }
    p.slots[idx].interest = interest
    if p.es.handle >= 0 {
        fd := p.slots[idx].conn.fd() or (err) {
            << true
        }
        es := $&p.es
        es.modify(fd, id, interest) or (err) {
            << true
        }
    }
    << true
}

fn (p $&Poller) unwatch(idx int) {
    if p.es.handle < 0 { << }
    fd := p.slots[idx].conn.fd() or (err) { << }
    es := $&p.es
    es.remove(fd) or (err) { << }
}

fn (p $&Poller) recycle(id int, idx int) {
    indices := $&p.indices
    indices.delete(id)
    p.slots[idx] = vacant_slot(p.free_head)
    p.free_head = idx
    p.active -= 1
}

// remove drops the registration and its owned stream. Returns true if the
// id existed. Use close_id to observe an OS close error.
pub fn (p $&Poller) remove(id int) bool {
    << p.close_id(id) or (err) { << true }
}

pub fn (p Poller) count() int {
    << p.active
}

fn (p &Poller) wait_windows(timeout_ns int) []Event {
    $watches := []core.WinSocketWatch{}
    for i in 0:p.slots.len {
        id := p.slots[i].id
        if id == 0 { -> }
        fd := p.slots[i].conn.fd() or (err) { -> }
        watches.push(core.WinSocketWatch{fd: fd, interest: p.slots[i].interest, token: id, ready: 0})
    }
    if core.win_wait_sockets($&watches, timeout_ns) <= 0 {
        << []Event{}
    }
    $out := []Event{}
    for watch in watches {
        if watch.ready != 0 {
            out.push(Event{id: watch.token, events: watch.ready})
        }
    }
    << out
}

// wait returns the descriptors that became ready. An empty registry returns
// immediately. With registered streams, zero blocks and a positive timeout
// is in nanoseconds.
pub fn (p $&Poller) wait(timeout_ns int) []Event {
    if p.count() == 0 {
        << []Event{}
    }
    if xu_target_os() == 2 {
        << p.wait_windows(timeout_ns)
    }
    if p.es.handle >= 0 {
        es := $&p.es
        events := es.wait(timeout_ns) or (err) {
            << []Event{}
        }
        $out := []Event{}
        for i in 0:events.len {
            ev := events[i]
            if find(p, ev.id) >= 0 {
                out.push(ev)
            }
        }
        << out
    }
    $out := []Event{}
    $deadline := 0
    if timeout_ns > 0 {
        deadline = time.now() + timeout_ns
    }
    while true {
        $i := 0
        while i < p.slots.len {
            id := p.slots[i].id
            if id != 0 {
                fd := p.slots[i].conn.fd() or (err) {
                    i = i + 1
                    <-
                }
                interest := p.slots[i].interest
                ready := os.socket_wait(fd, interest, -1) or (err) {
                    i = i + 1
                    <-
                }
                if ready != 0 {
                    out.push(Event{id: id, events: ready})
                }
            }
            i = i + 1
        }
        if out.len > 0 {
            << out
        }
        if timeout_ns < 0 {
            << out
        }
        if timeout_ns > 0 && time.now() >= deadline {
            << out
        }
        time.sleep(1000000)
    }
    << out
}

// read_timeout reads up to max bytes, applying a deadline of timeout_ns
// (0 = blocking). Empty string is EOF/timeout/error.
//
// The deadline is per operation.  Conn applies it to SO_RCVTIMEO, so leaving
// it installed would make a later read inherit an already-expired timeout.
// Always clear it after the operation (including the error path).
pub fn (p $&Poller) read_timeout(id int, max int, timeout_ns int) string {
    idx := find(p, id)
    if idx < 0 {
        << ""
    }
    if timeout_ns > 0 {
        s := $&p.slots[idx].conn
        s.set_read_deadline(time.now() + timeout_ns)
    }
    s2 := $&p.slots[idx].conn
    out := s2.read(max) or (err) {
        if timeout_ns > 0 {
            s2.set_read_deadline(0)
        }
        >> err
    }
    if timeout_ns > 0 {
        s2.set_read_deadline(0)
    }
    << out
}

// write_all writes the buffer in one call.
pub fn (p $&Poller) write_all(id int, data &string) int {
    idx := find(p, id)
    if idx < 0 {
        << -1
    }
    s := $&p.slots[idx].conn
    << s.write(data) or >>
}

// close_id closes and removes.
pub fn (p $&Poller) close_id(id int) bool {
    idx := find(p, id)
    if idx < 0 {
        << false
    }
    p.unwatch(idx)
    s := $&p.slots[idx].conn
    s.close() or (err) {
        p.recycle(id, idx)
        >> err
    }
    p.recycle(id, idx)
    << true
}
