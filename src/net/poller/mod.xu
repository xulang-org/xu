@net/poller

#errors
#net
#net/stream
#time

// Connection registry for long-lived peers (gateway / 5k sessions).
//
// **Runtime status:** hosted backends have no epoll/kqueue/IOCP ncall
// (`rt_net` is dial/listen/accept + blocking conn_*). A readiness
// poller needs runtime support (poll(2) / kqueue / IOCP).
//
// v1 is a registry + cooperative helpers:
//   * add / remove / count
//   * read_timeout applies a deadline then reads
//
// Pair with `timer.Wheel` for heartbeats. Swap for readiness events
// when the runtime exposes poll.

pub struct Poller {
    ids []int
    streams []stream.Stream
    live []int
    next_id int
}

// new creates an empty registry.
pub fn new() Poller {
    << Poller{ids: []int{}, streams: []stream.Stream{}, live: []int{}, next_id: 1}
}

fn find(p &mut Poller, id int) int {
    n := p.ids.len
    mut i := 0
    while i < n {
        if p.live[i] == 1 {
            if p.ids[i] == id {
                << i
            }
        }
        i = i + 1
    }
    << -1
}

// add registers a stream. Returns a stable id (>0).
pub fn (p &mut Poller) add(s stream.Stream) int {
    id := p.next_id
    p.next_id = p.next_id + 1
    p.ids.push(id)
    p.streams.push(s)
    p.live.push(1)
    << id
}

// remove drops id. Returns true if it existed.
pub fn (p &mut Poller) remove(id int) bool {
    idx := find(p, id)
    if idx < 0 {
        << false
    }
    p.live[idx] = 0
    << true
}

pub fn (p Poller) count() int {
    mut n := 0
    mut i := 0
    while i < p.live.len {
        if p.live[i] == 1 {
            n = n + 1
        }
        i = i + 1
    }
    << n
}

// read_timeout reads up to max bytes, applying a deadline of timeout_ns
// (0 = blocking). Empty string is EOF/timeout/error.
//
// The deadline is per operation.  Conn applies it to SO_RCVTIMEO, so leaving
// it installed would make a later read inherit an already-expired timeout.
// Always clear it after the operation (including the error path).
pub fn (p &mut Poller) read_timeout(id int, max int, timeout_ns int) string {
    idx := find(p, id)
    if idx < 0 {
        << ""
    }
    if timeout_ns > 0 {
        s := mut &p.streams[idx]
        s.set_read_deadline(time.now() + timeout_ns)
    }
    s2 := mut &p.streams[idx]
    out := s2.read(max) or (err) {
        if timeout_ns > 0 {
            s2.set_read_deadline(0)
        }
        >> err
    }
    if timeout_ns > 0 {
        s2.set_read_deadline(0)
    }
    << out
}

// write_all writes the buffer in one call.
pub fn (p &mut Poller) write_all(id int, data &string) int {
    idx := find(p, id)
    if idx < 0 {
        << -1
    }
    s := mut &p.streams[idx]
    << s.write(data) or >>
}

// close_id closes and removes.
pub fn (p &mut Poller) close_id(id int) bool {
    idx := find(p, id)
    if idx < 0 {
        << false
    }
    s := mut &p.streams[idx]
    s.close() or >>
    p.live[idx] = 0
    << true
}
