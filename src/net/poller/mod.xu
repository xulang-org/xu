@net/poller

#errors
#net
#net/stream
#os
#time

// Connection registry for long-lived peers (gateway / 5k sessions).
//
// Readiness is delegated to the hosted runtime. Linux uses an epoll
// registration, Darwin uses kqueue, and Windows uses an IOCP completion
// request. The low-level primitive is one-shot, so this registry keeps the
// stable ids and performs the fd-to-id mapping here.

pub const EVENT_READ = 1
pub const EVENT_WRITE = 2
pub const EVENT_ERROR = 4
pub const EVENT_HANGUP = 8

pub struct Event {
    pub id int
    pub events int
}

pub struct Poller {
    ids []int
    streams []stream.Stream
    live []int
    next_id int
}

// new creates an empty registry.
pub fn new() Poller {
    << Poller{ids: []int{}, streams: []stream.Stream{}, live: []int{}, next_id: 1}
}

fn find(p $&Poller, id int) int {
    n := p.ids.len
    $i := 0
    while i < n {
        if p.live[i] == 1 {
            if p.ids[i] == id {
                << i
            }
        }
        i = i + 1
    }
    << -1
}

// add registers a stream. Returns a stable id (>0).
pub fn (p $&Poller) add(s stream.Stream) int {
    id := p.next_id
    p.next_id = p.next_id + 1
    p.ids.push(id)
    p.streams.push(s)
    p.live.push(1)
    << id
}

// remove drops id. Returns true if it existed.
pub fn (p $&Poller) remove(id int) bool {
    idx := find(p, id)
    if idx < 0 {
        << false
    }
    p.live[idx] = 0
    << true
}

pub fn (p Poller) count() int {
    $n := 0
    $i := 0
    while i < p.live.len {
        if p.live[i] == 1 {
            n = n + 1
        }
        i = i + 1
    }
    << n
}

// wait returns the descriptors that became ready. A timeout of zero blocks;
// a positive timeout is in nanoseconds. After the first descriptor has been
// checked, subsequent one-shot waits are non-blocking so a ready set cannot
// multiply the caller's deadline by the number of registered streams.
pub fn (p $&Poller) wait(timeout_ns int) []Event {
    $out := []Event{}
    $first := true
    $i := 0
    while i < p.live.len {
        if p.live[i] == 1 {
            fd := p.streams[i].fd() or (err) {
                i = i + 1
                <-
            }
            $wait_ns := -1
            if first {
                wait_ns = timeout_ns
                first = false
            }
            ready := os.socket_wait(fd, EVENT_READ | EVENT_WRITE, wait_ns) or (err) {
                i = i + 1
                <-
            }
            if ready != 0 {
                out.push(Event{id: p.ids[i], events: ready})
            }
        }
        i = i + 1
    }
    << out
}

// read_timeout reads up to max bytes, applying a deadline of timeout_ns
// (0 = blocking). Empty string is EOF/timeout/error.
//
// The deadline is per operation.  Conn applies it to SO_RCVTIMEO, so leaving
// it installed would make a later read inherit an already-expired timeout.
// Always clear it after the operation (including the error path).
pub fn (p $&Poller) read_timeout(id int, max int, timeout_ns int) string {
    idx := find(p, id)
    if idx < 0 {
        << ""
    }
    if timeout_ns > 0 {
        s := $&p.streams[idx]
        s.set_read_deadline(time.now() + timeout_ns)
    }
    s2 := $&p.streams[idx]
    out := s2.read(max) or (err) {
        if timeout_ns > 0 {
            s2.set_read_deadline(0)
        }
        >> err
    }
    if timeout_ns > 0 {
        s2.set_read_deadline(0)
    }
    << out
}

// write_all writes the buffer in one call.
pub fn (p $&Poller) write_all(id int, data &string) int {
    idx := find(p, id)
    if idx < 0 {
        << -1
    }
    s := $&p.streams[idx]
    << s.write(data) or >>
}

// close_id closes and removes.
pub fn (p $&Poller) close_id(id int) bool {
    idx := find(p, id)
    if idx < 0 {
        << false
    }
    s := $&p.streams[idx]
    s.close() or >>
    p.live[idx] = 0
    << true
}
