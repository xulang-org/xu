@net/poller

#errors

// A persistent, non-owning socket event set. Linux uses epoll and Darwin
// kqueue. Other hosted targets explicitly reject construction; the legacy
// Poller remains available there. A set is used by one owner at a time.
pub struct EventSet {
    handle int
}

// EventWake is a non-owning, copyable notification token for worker tasks.
// It does not close the EventSet; the owner must keep the set alive until all
// publishers have stopped.
pub struct EventWake {
    handle int
}

fn event_word(data &string, off int) int {
    $value := 0
    for i in 0:8 { value = value | ((data[off + i] & 255) << (i * 8)) }
    << value
}

pub fn event_set_supported() bool {
    << xu_target_os() == 0 || xu_target_os() == 1
}

pub fn new_event_set() EventSet {
    raw := sys_event_set(0, 0, 0, 0, 0, 0) or >>
    if raw.len != 8 { >> errors.new("poller: invalid kernel handle") }
    << EventSet{handle: event_word(&raw, 0)}
}

fn (p &EventSet) require_open() {
    if p.handle < 0 { >> errors.new("poller: event set closed") }
}

fn valid_interest(fd int, token int, interest int) {
    if fd < 0 || token < 0 || interest <= 0 || (interest & 3) != interest {
        >> errors.new("poller: invalid watch")
    }
}

// watch borrows fd and associates a caller-owned stable token. Closing the
// set does not close fd. Tokens must distinguish a reused connection slot;
// an already-returned event may otherwise name a different connection.
pub fn (p $&EventSet) watch(fd int, token int, interest int) {
    p.require_open() or >>
    valid_interest(fd, token, interest) or >>
    _ := sys_event_set(1, p.handle, fd, interest, token, 0) or >>
}

pub fn (p $&EventSet) modify(fd int, token int, interest int) {
    p.require_open() or >>
    valid_interest(fd, token, interest) or >>
    _ := sys_event_set(2, p.handle, fd, interest, token, 0) or >>
}

// remove tolerates a registration already removed by the kernel. Call it
// before closing/reusing fd; other invalid descriptor failures propagate.
pub fn (p $&EventSet) remove(fd int) {
    p.require_open() or >>
    if fd < 0 { >> errors.new("poller: invalid descriptor") }
    _ := sys_event_set(3, p.handle, fd, 0, 0, 0) or >>
}

// wait returns at most 64 events. timeout_ns: zero=infinite, negative=probe,
// positive=relative deadline. Signals may cause an empty early wake; callers
// with an absolute deadline recompute the remaining time. Darwin can return
// separate read/write events for one token. Readiness never reserves bytes.
pub fn (p $&EventSet) wait(timeout_ns int) []Event {
    p.require_open() or >>
    raw := sys_event_set(4, p.handle, 0, 0, 0, timeout_ns) or >>
    if raw.len % 16 != 0 || raw.len > 1024 { >> errors.new("poller: invalid event batch") }
    $out := []Event{}
    $i := 0
    while i < raw.len {
        id := event_word(&raw, i)
        if id >= 0 {
            out.push(Event{id: id, events: event_word(&raw, i + 8)})
        }
        i += 16
    }
    << out
}

pub fn (p &EventSet) wake_token() EventWake {
    << EventWake{handle: p.handle}
}

pub fn (p &EventSet) wake() {
    _ := sys_event_set(6, p.handle, 0, 0, 0, 0) or >>
}

pub fn (w EventWake) notify() {
    if w.handle < 0 { >> errors.new("poller: event set closed") }
    _ := sys_event_set(6, w.handle, 0, 0, 0, 0) or >>
}

pub fn (p $&EventSet) close() {
    if p.handle < 0 { << }
    handle := p.handle
    p.handle = -1
    _ := sys_event_set(5, handle, 0, 0, 0, 0) or >>
}

fn (p $&EventSet) drop() { p.close() or (err) { << } }
