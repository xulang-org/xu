@net

#errors

// Port and protocol name lookup (Go net/lookup.go services map + /etc/services).

fn lookup_port_builtin(network string, service string) int {
    svc := ascii_lower(&service)
    netw := ascii_lower(&network)
    is_tcp := netw == "tcp" || netw == "tcp4" || netw == "tcp6" || netw == "ip" || netw.len == 0
    is_udp := netw == "udp" || netw == "udp4" || netw == "udp6" || netw == "ip" || netw.len == 0
    if svc == "http" && is_tcp {
        << 80
    }
    if svc == "https" && is_tcp {
        << 443
    }
    if svc == "ssh" && is_tcp {
        << 22
    }
    if svc == "ftp" && is_tcp {
        << 21
    }
    if svc == "ftps" && is_tcp {
        << 990
    }
    if svc == "smtp" && is_tcp {
        << 25
    }
    if svc == "submissions" && is_tcp {
        << 465
    }
    if svc == "imap2" && is_tcp {
        << 143
    }
    if svc == "imap" && is_tcp {
        << 143
    }
    if svc == "imap3" && is_tcp {
        << 220
    }
    if svc == "imaps" && is_tcp {
        << 993
    }
    if svc == "pop3" && is_tcp {
        << 110
    }
    if svc == "pop3s" && is_tcp {
        << 995
    }
    if svc == "telnet" && is_tcp {
        << 23
    }
    if svc == "gopher" && is_tcp {
        << 70
    }
    if svc == "domain" {
        if is_tcp || is_udp {
            << 53
        }
    }
    if svc == "ntp" && is_udp {
        << 123
    }
    if svc == "snmp" && is_udp {
        << 161
    }
    if svc == "tftp" && is_udp {
        << 69
    }
    << -1
}

fn services_file_path() string {
    if xu_target_os() == 2 {
        $root := env_get("SystemRoot")
        if root.len == 0 {
            root = env_get("SYSTEMROOT")
        }
        if root.len == 0 {
            root = "C:\\Windows"
        }
        << root + "\\System32\\drivers\\etc\\services"
    }
    << "/etc/services"
}

fn lookup_port_file(network string, service string) int {
    body := read_file(services_file_path()) or (err) {
        << -1
    }
    svc := ascii_lower(&service)
    netw := ascii_lower(&network)
    $want := "tcp"
    if netw == "udp" || netw == "udp4" || netw == "udp6" {
        want = "udp"
    }
    $i := 0
    while i < body.len {
        $line_end := i
        while line_end < body.len {
            if (body[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        $line := body[i:line_end]
        hash := index_byte(&line, 35)
        if hash >= 0 {
            line = line[0:hash]
        }
        f := get_fields(&line)
        if f.len >= 2 {
            f0 := f[0] + ""
            name := ascii_lower(&f0)
            spec := f[1] + ""
            slash := index_byte(&spec, 47)
            if slash > 0 {
                pstr := spec[0:slash]
                $proto := ascii_lower(&spec)
                proto = ascii_lower_from(slash + 1, &spec)
                p := dtoi_full(&pstr)
                if p >= 0 && p <= 65535 {
                    $hit := name == svc
                    if !hit {
                        $ai := 2
                        while ai < f.len {
                            raw_al := f[ai] + ""
                            al := ascii_lower(&raw_al)
                            if al == svc {
                                hit = true
                                <-
                            }
                            ai = ai + 1
                        }
                    }
                    if hit && proto == want {
                        << p
                    }
                }
            }
        }
        if line_end < body.len {
            i = line_end + 1
        } else {
            i = body.len
        }
    }
    << -1
}

fn ascii_lower_from(start int, s &string) string {
    $out := ""
    $i := start
    while i < s.len {
        $c := s[i] & 255
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out = out + string_from_byte(c)
        i = i + 1
    }
    << out
}

pub fn lookup_port(network string, service string) int {
    netw := network + ""
    svc := service + ""
    if svc.len == 0 {
        << 0
    }
    n := parse_port(&svc)
    if n >= 0 {
        << n
    }
    $p := lookup_port_builtin(netw + "", svc + "")
    if p >= 0 {
        << p
    }
    p = lookup_port_file(netw + "", svc + "")
    if p >= 0 {
        << p
    }
    >> errors.new("unknown port " + netw + "/" + svc)
    << 0
}

pub fn lookup_protocol(name string) int {
    n := ascii_lower(&name)
    if n == "icmp" {
        << 1
    }
    if n == "igmp" {
        << 2
    }
    if n == "tcp" {
        << 6
    }
    if n == "udp" {
        << 17
    }
    if n == "ipv6-icmp" || n == "icmpv6" {
        << 58
    }
    >> errors.new("unknown IP protocol specified")
    << 0
}
