@net

#errors
#os

// net — Go `net` correspondence.
//
// IP values are owning strings of raw bytes (len 4 = IPv4, len 16 = IPv6).
// Stream I/O covers TCP IPv4/IPv6 and Unix pathname sockets on Darwin/Linux.
// UDP IPv4/IPv6 and DNS-over-TCP live in sibling files; raw IP remains stubbed.
// fd-level dial/listen/accept/conn_* stay for net/http and net/smtp.

pub struct HostPort {
    pub host string
    pub port string
}

pub fn new_host_port() HostPort {
    << HostPort{host: "", port: ""}
}

pub fn (hp HostPort) host() string {
    << hp.host + ""
}

pub fn (hp HostPort) port() string {
    << hp.port + ""
}

pub fn ipv4(a int, b int, c int, d int) string {
    mut out := ""
    out.push_byte(a & 255)
    out.push_byte(b & 255)
    out.push_byte(c & 255)
    out.push_byte(d & 255)
    << out
}

fn parse_u8_dec(s &string, start int, end int) int {
    if end <= start || end - start > 3 {
        << -1
    }
    mut v := 0
    for i in start:end {
        c := s[i] & 255
        if c < 48 || c > 57 {
            << -1
        }
        v = v * 10 + (c - 48)
        if v > 255 {
            << -1
        }
    }
    // reject leading zeros unless single 0
    if end - start > 1 && (s[start] & 255) == 48 {
        << -1
    }
    << v
}

fn parse_ipv4(s &string) string {
    mut dots := 0
    mut prev := 0
    mut parts := []int{}
    for i in 0:s.len {
        if (s[i] & 255) == 46 {
            v := parse_u8_dec(s, prev, i)
            if v < 0 {
                << ""
            }
            parts.push(v)
            prev = i + 1
            dots = dots + 1
        }
    }
    if dots != 3 {
        << ""
    }
    v := parse_u8_dec(s, prev, s.len)
    if v < 0 {
        << ""
    }
    parts.push(v)
    if parts.len != 4 {
        << ""
    }
    << ipv4(parts[0], parts[1], parts[2], parts[3])
}

fn hex_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

fn parse_hex_group(s &string, start int, end int) int {
    if end <= start || end - start > 4 {
        << -1
    }
    mut v := 0
    for i in start:end {
        d := hex_val(s[i] & 255)
        if d < 0 {
            << -1
        }
        v = (v << 4) | d
    }
    << v & 65535
}

fn parse_ipv6(s &string) string {
    text := s + ""
    mut v4tail := ""
    mut core := text + ""
    mut last_colon := -1
    for i in 0:text.len {
        if (text[i] & 255) == 58 {
            last_colon = i
        }
    }
    if last_colon >= 0 {
        rest := text[(last_colon + 1):text.len]
        if parse_ipv4(&rest).len == 4 {
            v4tail = parse_ipv4(&rest)
            if last_colon == 0 {
                core = ""
            } else {
                core = text[0:last_colon]
            }
        }
    }

    // Split on '::' (at most one)
    mut left_s := ""
    mut right_s := ""
    mut has_dc := false
    mut i := 0
    while i < core.len {
        if i + 1 < core.len && (core[i] & 255) == 58 && (core[i + 1] & 255) == 58 {
            if has_dc {
                << ""
            }
            has_dc = true
            left_s = core[0:i]
            right_s = core[(i + 2):core.len]
            <-
        }
        i = i + 1
    }
    if !has_dc {
        left_s = core + ""
        right_s = ""
    }

    mut left := []int{}
    mut right := []int{}
    if !parse_v6_groups(&left_s, mut &left) {
        << ""
    }
    if !parse_v6_groups(&right_s, mut &right) {
        << ""
    }

    mut need := 8
    if v4tail.len == 4 {
        need = 6
    }
    total := left.len + right.len
    if has_dc {
        if total > need {
            << ""
        }
    } else {
        if total != need {
            << ""
        }
    }
    mut fill := need - total
    if !has_dc {
        fill = 0
    }

    mut out := ""
    for j in 0:left.len {
        g := left[j]
        out = out + string_from_byte((g >> 8) & 255)
        out = out + string_from_byte(g & 255)
    }
    for j in 0:fill {
        out = out + string_from_byte(0)
        out = out + string_from_byte(0)
        _ := j
    }
    for j in 0:right.len {
        g := right[j]
        out = out + string_from_byte((g >> 8) & 255)
        out = out + string_from_byte(g & 255)
    }
    if v4tail.len == 4 {
        out = out + v4tail
    }
    if out.len != 16 {
        << ""
    }
    << out
}

fn parse_v6_groups(s &string, out &mut []int) bool {
    if s.len == 0 {
        << true
    }
    if (s[0] & 255) == 58 || (s[s.len - 1] & 255) == 58 {
        << false
    }
    mut prev := 0
    for i in 0:s.len {
        if (s[i] & 255) == 58 {
            g := parse_hex_group(s, prev, i)
            if g < 0 {
                << false
            }
            out.push(g)
            prev = i + 1
        }
    }
    g := parse_hex_group(s, prev, s.len)
    if g < 0 {
        << false
    }
    out.push(g)
    << true
}

pub fn parse_ip(s &string) string {
    if s.len == 0 {
        << ""
    }
    // dotted IPv4
    mut has_dot := false
    mut has_colon := false
    for i in 0:s.len {
        c := s[i] & 255
        if c == 46 {
            has_dot = true
        }
        if c == 58 {
            has_colon = true
        }
    }
    if has_dot && !has_colon {
        << parse_ipv4(s)
    }
    if has_colon {
        << parse_ipv6(s)
    }
    << ""
}

fn u8_to_dec(v int) string {
    x := v & 255
    if x == 0 {
        << "0"
    }
    mut digs := ""
    mut n := x
    while n > 0 {
        digs = string_from_byte(48 + (n % 10)) + digs
        n = n / 10
    }
    << digs
}

fn u16_to_hex(v int) string {
    x := v & 65535
    if x == 0 {
        << "0"
    }
    hex := "0123456789abcdef"
    mut started := false
    mut out := ""
    mut shift := 12
    while shift >= 0 {
        d := (x >> shift) & 15
        if d != 0 || started || shift == 0 {
            started = true
            out = out + string_from_byte(hex[d])
        }
        shift = shift - 4
    }
    if out.len == 0 {
        << "0"
    }
    << out
}

pub fn ip_string(ip &string) string {
    if ip.len == 4 {
        << u8_to_dec(ip[0]) + "." + u8_to_dec(ip[1]) + "." + u8_to_dec(ip[2]) + "." + u8_to_dec(ip[3])
    }
    if ip.len != 16 {
        << "?"
    }
    mut best_start := -1
    mut best_len := 0
    mut run_start := -1
    mut run_len := 0
    for i in 0:8 {
        hi := ip[i * 2] & 255
        lo := ip[i * 2 + 1] & 255
        if hi == 0 && lo == 0 {
            if run_start < 0 {
                run_start = i
                run_len = 1
            } else {
                run_len = run_len + 1
            }
        } else {
            if run_len > best_len {
                best_start = run_start
                best_len = run_len
            }
            run_start = -1
            run_len = 0
        }
    }
    if run_len > best_len {
        best_start = run_start
        best_len = run_len
    }
    if best_len < 2 {
        best_start = -1
        best_len = 0
    }
    << ip_string_v6(ip, best_start, best_len)
}

fn ip_string_v6(ip &string, zstart int, zlen int) string {
    // IPv4-mapped ::ffff:a.b.c.d
    mut mapped := true
    for i in 0:10 {
        if (ip[i] & 255) != 0 {
            mapped = false
            <-
        }
    }
    if mapped && (ip[10] & 255) == 255 && (ip[11] & 255) == 255 {
        << "::ffff:" + u8_to_dec(ip[12]) + "." + u8_to_dec(ip[13]) + "." + u8_to_dec(ip[14]) + "." + u8_to_dec(ip[15])
    }
    mut out := ""
    mut i := 0
    mut need_colon := false
    while i < 8 {
        if zstart >= 0 && i == zstart {
            out = out + "::"
            need_colon = false
            i = i + zlen
            ->
        }
        g := ((ip[i * 2] & 255) << 8) | (ip[i * 2 + 1] & 255)
        if need_colon {
            out = out + ":"
        }
        out = out + u16_to_hex(g)
        need_colon = true
        i = i + 1
    }
    << out
}

pub fn ip_is_unspecified(ip &string) bool {
    v4 := ip_to4(ip)
    if v4.len == 4 {
        << (v4[0] | v4[1] | v4[2] | v4[3]) == 0
    }
    if ip.len == 16 {
        for i in 0:16 {
            if (ip[i] & 255) != 0 {
                << false
            }
        }
        << true
    }
    << false
}

pub fn ip_is_loopback(ip &string) bool {
    v4 := ip_to4(ip)
    if v4.len == 4 {
        << (v4[0] & 255) == 127
    }
    if ip.len == 16 {
        for i in 0:15 {
            if (ip[i] & 255) != 0 {
                << false
            }
        }
        << (ip[15] & 255) == 1
    }
    << false
}

pub fn ip_is_private(ip &string) bool {
    v4 := ip_to4(ip)
    if v4.len == 4 {
        a := v4[0] & 255
        b := v4[1] & 255
        if a == 10 {
            << true
        }
        if a == 172 && b >= 16 && b <= 31 {
            << true
        }
        if a == 192 && b == 168 {
            << true
        }
        << false
    }
    if ip.len == 16 {
        b0 := ip[0] & 255
        << (b0 & 254) == 252
    }
    << false
}

pub fn join_host_port(host &string, port &string) string {
    // If host has colon, wrap in []
    mut has_colon := false
    for i in 0:host.len {
        if (host[i] & 255) == 58 {
            has_colon = true
            <-
        }
    }
    if has_colon {
        << "[" + (host + "") + "]:" + (port + "")
    }
    << (host + "") + ":" + (port + "")
}

pub fn (hp &mut HostPort) split(hostport string) int {
    hp.host = ""
    hp.port = ""
    if hostport.len == 0 {
        >> errors.new("missing port in address")
    }
    // [host]:port
    if (hostport[0] & 255) == 91 {
        mut end := -1
        for i in 1:hostport.len {
            if (hostport[i] & 255) == 93 {
                end = i
                <-
            }
        }
        if end < 0 {
            >> errors.new("missing ] in address")
        }
        if end + 1 >= hostport.len || (hostport[end + 1] & 255) != 58 {
            >> errors.new("missing port in address")
        }
        hp.host = hostport[1:end]
        hp.port = hostport[(end + 2):hostport.len]
        if hp.port.len == 0 {
            >> errors.new("missing port in address")
        }
        << 0
    }
    // host:port — last colon (IPv4 host)
    mut last := -1
    mut colons := 0
    for i in 0:hostport.len {
        if (hostport[i] & 255) == 58 {
            last = i
            colons = colons + 1
        }
    }
    if last < 0 {
        >> errors.new("missing port in address")
    }
    if colons > 1 {
        >> errors.new("too many colons in address")
    }
    hp.host = hostport[0:last]
    hp.port = hostport[(last + 1):hostport.len]
    if hp.port.len == 0 {
        >> errors.new("missing port in address")
    }
    << 0
}

// ---- TCP IPv4 runtime wrappers (M43) + Conn/Listener methods ----

pub struct Conn {
    fd int
    pub network string
    pub laddr string
    pub raddr string
    pub read_deadline_ns int
    pub write_deadline_ns int
}

pub struct Listener {
    fd int
    pub network string
    pub addr string
}

fn parse_port(s &string) int {
    if s.len == 0 || s.len > 5 {
        << -1
    }
    mut v := 0
    for i in 0:s.len {
        c := s[i] & 255
        if c < 48 || c > 57 {
            << -1
        }
        v = v * 10 + (c - 48)
        if v > 65535 {
            << -1
        }
    }
    << v
}

fn resolve_ip4_host(host string) string {
    if host.len == 0 {
        << ipv4(0, 0, 0, 0)
    }
    hz := split_host_zone(host)
    h := hz.host + ""
    ip := parse_ip(&h)
    if ip.len == 4 {
        << ip
    }
    v4 := ip_to4(&ip)
    if v4.len == 4 {
        << v4
    }
    addrs := lookup_host(h)
    mut i := 0
    while i < addrs.len {
        a := addrs[i] + ""
        raw := parse_ip(&a)
        got := ip_to4(&raw)
        if got.len == 4 {
            << got
        }
        i = i + 1
    }
    >> errors.new("net: need IPv4 address")
    << ""
}

fn resolve_tcp_port(port_s string) int {
    port := parse_port(&port_s)
    if port >= 0 {
        << port
    }
    << lookup_port("tcp", port_s) or >>
}

// fd-level helpers: sys_* / os_fd_* 内建，由 runtime.xu 组装 listen/dial。

pub fn dial(addr string) int {
    << dial_ns(addr, 0)
}

// dial_ns is the fd-level connect with an optional SO_SNDTIMEO bound.
// ns <= 0 means no extra timeout (same as dial).
pub fn dial_ns(addr string, ns int) int {
    mut hp := new_host_port()
    hp.split(addr) or (err) {
        >> errors.new("net: invalid address")
    }
    host := hp.host()
    port_s := hp.port()
    port := resolve_tcp_port(port_s)
    ip := resolve_ip4_host(host)
    if ns <= 0 {
        << sys_dial_tcp4(ip[0] & 255, ip[1] & 255, ip[2] & 255, ip[3] & 255, port)
    }
    << sys_dial_tcp4_timeout(ip[0] & 255, ip[1] & 255, ip[2] & 255, ip[3] & 255, port, ns)
}

pub fn listen(addr string) int {
    mut hp := new_host_port()
    hp.split(addr) or (err) {
        >> errors.new("net: invalid address")
    }
    host := hp.host()
    port_s := hp.port()
    port := resolve_tcp_port(port_s)
    ip := resolve_ip4_host(host)
    << sys_listen_tcp4(ip[0] & 255, ip[1] & 255, ip[2] & 255, ip[3] & 255, port)
}

pub fn accept(fd int) int {
    << os.accept(fd) or >>
}

pub fn conn_close(fd int) int {
    << os.socket_close(fd) or >>
}

pub fn conn_write(fd int, data &string) int {
    << os.socket_write(fd, data + "") or >>
}

pub fn conn_read(fd int, max int) string {
    << os.socket_read(fd, max) or >>
}

fn conn_new(fd int, network string, laddr string, raddr string) Conn {
    << Conn{fd: fd, network: network, laddr: laddr, raddr: raddr, read_deadline_ns: 0, write_deadline_ns: 0}
}

fn deadline_ok(t_ns int) int {
    if t_ns > 0 {
        if now_ns() >= t_ns {
            >> errors.new("i/o timeout")
        }
    }
    << 0
}

fn clear_sock_timeout(fd int) {
    os.set_sock_timeout(fd, 0) or (err) {
        <<
    }
}

fn apply_sock_deadline(fd int, t_ns int) int {
    deadline_ok(t_ns) or >>
    if t_ns <= 0 {
        << 0
    }
    rem := t_ns - now_ns()
    if rem <= 0 {
        >> errors.new("i/o timeout")
    }
    os.set_sock_timeout(fd, rem) or >>
    << 0
}

// Go Conn.SetDeadline / SetReadDeadline / SetWriteDeadline.
// t_ns is absolute now_ns; 0 clears. Remaining time is applied as
// SO_RCVTIMEO/SO_SNDTIMEO before the next read/write so an in-flight
// syscall can return; 0 does not clear an already-armed kernel timeout
// until the next I/O path that sees t_ns==0 (set_deadline(0) does).
pub fn (c &mut Conn) set_deadline(t_ns int) int {
    c.read_deadline_ns = t_ns
    c.write_deadline_ns = t_ns
    if t_ns <= 0 && c.fd >= 0 {
        clear_sock_timeout(c.fd)
    }
    << 0
}

pub fn (c &mut Conn) set_read_deadline(t_ns int) int {
    c.read_deadline_ns = t_ns
    if t_ns <= 0 && c.fd >= 0 {
        clear_sock_timeout(c.fd)
    }
    << 0
}

pub fn (c &mut Conn) set_write_deadline(t_ns int) int {
    c.write_deadline_ns = t_ns
    if t_ns <= 0 && c.fd >= 0 {
        clear_sock_timeout(c.fd)
    }
    << 0
}

pub fn (c &Conn) read(max int) string {
    if c.fd < 0 { >> errors.new("net: connection is closed") }
    apply_sock_deadline(c.fd, c.read_deadline_ns) or >>
    << conn_read(c.fd, max)
}

pub fn (c &Conn) write(data &string) int {
    if c.fd < 0 { >> errors.new("net: connection is closed") }
    apply_sock_deadline(c.fd, c.write_deadline_ns) or >>
    << conn_write(c.fd, data)
}

pub fn (c &mut Conn) close() int {
    if c.fd < 0 {
        << 0
    }
    fd := c.fd
    c.fd = -1
    conn_close(fd) or >>
    << 0
}

pub fn (c Conn) local_addr() string {
    << c.laddr + ""
}

pub fn (c Conn) remote_addr() string {
    << c.raddr + ""
}

pub fn (l Listener) accept() Conn {
    fd := os.accept(l.fd) or >>
    << conn_new(fd, l.network + "", l.addr + "", "")
}

pub fn (l &mut Listener) close() int {
    if l.fd < 0 {
        << 0
    }
    fd := l.fd
    l.fd = -1
    conn_close(fd) or >>
    // ListenUnix owns its pathname by default, matching Go's unlink-on-close
    // behavior. Ignore unlink errors (the caller may already have removed it).
    if l.network == "unix" && l.addr.len > 0 {
        os.remove(l.addr + "") or (err) {
            << 0
        }
    }
    << 0
}

pub fn (l Listener) addr() string {
    << l.addr + ""
}

pub fn file_conn(fd int) Conn {
    if fd < 0 {
        >> errors.new("net: invalid file descriptor")
    }
    << conn_new(fd, "file", "", "")
}

pub fn file_listener(fd int) Listener {
    if fd < 0 {
        >> errors.new("net: invalid file descriptor")
    }
    << Listener{fd: fd, network: "file", addr: ""}
}

pub fn closed_conn() Conn { << conn_new(-1, "", "", "") }

pub fn (c &Conn) is_closed() bool { << c.fd < 0 }

// Borrowed raw descriptor; platform adapters must not create a second owner.
pub fn (c &Conn) descriptor() int {
    if c.fd < 0 { >> errors.new("net: connection is closed") }
    << c.fd
}

fn (c &mut Conn) drop() { c.close() or (err) { << } }
fn (l &mut Listener) drop() { l.close() or (err) { << } }
