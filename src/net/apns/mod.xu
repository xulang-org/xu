@net/apns

#crypto/ecdsa
#crypto/jwt
#encoding/hex
#errors
#net/http2
#strconv
#time

// Apple Push Notification service provider client (token auth, ES256).
//
//     priv := ecdsa.parse_private_pem(&p8_pem) or ...
//     c := apns.connect(true, &team_id, &key_id, &priv, &bundle_id) or ...
//     r := c.push(&device_token, &payload_json)
//
// connect() opens HTTP/2 to api.push.apple.com (prod) or
// api.sandbox.push.apple.com. JWT is minted per push (APNs allows cache
// up to 1h — minting every send is simpler and still cheap vs TLS).
//
// v1: one stream per push, no connection pool, no retry, no 410 unregistered
// bookkeeping. Payload is raw JSON the caller built (aps + custom).

pub const host_prod = "api.push.apple.com"
pub const host_sandbox = "api.sandbox.push.apple.com"

pub struct Client {
    c http2.TlsClient
    team_id string
    key_id string
    priv string
    topic string
    host string
}

pub struct PushResult {
    pub status int
    pub apns_id string
    pub reason string
    pub ok bool
}

// connect dials the APNs host and completes the h2 preface.
pub fn connect(production bool, team_id string, key_id string, private_key string, topic string) Client {
    mut host := host_prod
    if !production {
        host = host_sandbox
    }
    h := host + ""
    cl := http2.dial_tls(h + ":443", h + "") or >>
    << Client{c: cl, team_id: team_id + "", key_id: key_id + "", priv: private_key + "", topic: topic + "", host: h + ""}
}

fn device_path(token string) string {
    // token is typically 64 hex chars; accept already-lowercase hex only.
    << "/3/device/" + token
}

// push sends payload_json to device_token. Builds a fresh provider JWT.
pub fn (c &mut Client) push(device_token string, payload_json string) PushResult {
    if device_token.len == 0 || device_token.len > 200 {
        << PushResult{status: 0, apns_id: "", reason: "bad token", ok: false}
    }
    iat := time.now_time().unix()
    tok := jwt.sign_es256(&c.priv, c.team_id, c.key_id, iat) or (err) {
        << PushResult{status: 0, apns_id: "", reason: err.msg(), ok: false}
    }
    auth := "bearer " + tok
    path := device_path(device_token)
    h2 := c.host + ""
    cc := mut &c.c
    r := cc.post(h2, path, "application/json", auth, payload_json)
    if !r.ok {
        << PushResult{status: r.status, apns_id: "", reason: r.err, ok: false}
    }
    << PushResult{status: r.status, apns_id: "", reason: r.body, ok: r.status == 200}
}

pub fn (c &mut Client) close() {
    cc := mut &c.c
    cc.close()
}
