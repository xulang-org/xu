@net

#errors

// IP / IPMask / IPNet (Go net/ip.go). Addresses are owning strings of raw
// bytes: len 4 = IPv4, len 16 = IPv6. parse_ip (in mod.xu) keeps that
// length split; IPv4() here also returns 4 bytes (Go's IPv4() is 16-byte
// mapped — callers who want mapped form use ip_to16).

const IPV4_LEN = 4
const IPV6_LEN = 16

pub struct IPNet {
    pub ip string
    pub mask string
}

pub struct CIDR {
    pub ip string
    pub ipnet IPNet
}

pub fn ipv4_zero() string {
    << ipv4(0, 0, 0, 0)
}

pub fn ipv4_bcast() string {
    << ipv4(255, 255, 255, 255)
}

pub fn ipv4_allsys() string {
    << ipv4(224, 0, 0, 1)
}

pub fn ipv4_allrouter() string {
    << ipv4(224, 0, 0, 2)
}

pub fn ipv6_zero() string {
    << zeros_n(16)
}

pub fn ipv6_unspecified() string {
    << ipv6_zero()
}

pub fn ipv6_loopback() string {
    << zeros_n(15) + string_from_byte(1)
}

pub fn ipv6_interface_local_all_nodes() string {
    << string_from_byte(255) + string_from_byte(1) + zeros_n(13) + string_from_byte(1)
}

pub fn ipv6_link_local_all_nodes() string {
    << string_from_byte(255) + string_from_byte(2) + zeros_n(13) + string_from_byte(1)
}

pub fn ipv6_link_local_all_routers() string {
    << string_from_byte(255) + string_from_byte(2) + zeros_n(13) + string_from_byte(2)
}

pub fn ipv4_mask(a int, b int, c int, d int) string {
    << ipv4(a, b, c, d)
}

pub fn cidr_mask(ones int, bits int) string {
    if bits != 32 && bits != 128 {
        << ""
    }
    if ones < 0 || ones > bits {
        << ""
    }
    l := bits / 8
    mut n := ones
    mut out := ""
    for i in 0:l {
        if n >= 8 {
            out.push_byte(255)
            n = n - 8
        } else {
            if n <= 0 {
                out.push_byte(0)
            } else {
                v := (255 << (8 - n)) & 255
                out.push_byte(v)
                n = 0
            }
        }
        _ := i
    }
    << out
}

pub fn ip_to4(ip &string) string {
    if ip.len == 4 {
        << ip + ""
    }
    if ip.len == 16 {
        mut mapped := true
        for i in 0:10 {
            if (ip[i] & 255) != 0 {
                mapped = false
                <-
            }
        }
        if mapped && (ip[10] & 255) == 255 && (ip[11] & 255) == 255 {
            << ipv4(ip[12] & 255, ip[13] & 255, ip[14] & 255, ip[15] & 255)
        }
    }
    << ""
}

pub fn ip_to16(ip &string) string {
    if ip.len == 4 {
        << v4_mapped_prefix() + (ip + "")
    }
    if ip.len == 16 {
        << ip + ""
    }
    << ""
}

fn ip_is_zeros(ip &string) bool {
    for i in 0:ip.len {
        if (ip[i] & 255) != 0 {
            << false
        }
    }
    << ip.len > 0 || ip.len == 0
}

pub fn ip_equal(a &string, b &string) bool {
    if a.len == b.len {
        for i in 0:a.len {
            if (a[i] & 255) != (b[i] & 255) {
                << false
            }
        }
        << true
    }
    a4 := ip_to4(a)
    b4 := ip_to4(b)
    if a4.len == 4 && b4.len == 4 {
        for i in 0:4 {
            if (a4[i] & 255) != (b4[i] & 255) {
                << false
            }
        }
        << true
    }
    << false
}

pub fn ip_mask(ip &string, mask &string) string {
    mut p := ip + ""
    mut m := mask + ""
    if m.len == 16 && p.len == 4 {
        mut allff := true
        for i in 0:12 {
            if (m[i] & 255) != 255 {
                allff = false
                <-
            }
        }
        if allff {
            m = m[12:16]
        }
    }
    if m.len == 4 && p.len == 16 {
        t4 := ip_to4(&p)
        if t4.len == 4 {
            p = t4
        }
    }
    if p.len != m.len {
        << ""
    }
    mut out := ""
    for i in 0:p.len {
        out.push_byte((p[i] & 255) & (m[i] & 255))
    }
    << out
}

pub fn ip_default_mask(ip &string) string {
    v4 := ip_to4(ip)
    if v4.len != 4 {
        << ""
    }
    a := v4[0] & 255
    if a < 128 {
        << ipv4_mask(255, 0, 0, 0)
    }
    if a < 192 {
        << ipv4_mask(255, 255, 0, 0)
    }
    << ipv4_mask(255, 255, 255, 0)
}

fn simple_mask_length(mask &string) int {
    mut n := 0
    mut i := 0
    while i < mask.len {
        mut v := mask[i] & 255
        if v == 255 {
            n = n + 8
            i = i + 1
            ->
        }
        while (v & 128) != 0 {
            n = n + 1
            v = (v << 1) & 255
        }
        if v != 0 {
            << -1
        }
        i = i + 1
        while i < mask.len {
            if (mask[i] & 255) != 0 {
                << -1
            }
            i = i + 1
        }
        << n
    }
    << n
}

pub fn ip_mask_size(mask &string) int {
    n := simple_mask_length(mask)
    if n < 0 {
        << 0
    }
    << n
}

pub fn ip_mask_bits(mask &string) int {
    << mask.len * 8
}

pub fn ip_mask_string(mask &string) string {
    if mask.len == 0 {
        << "<nil>"
    }
    hex := "0123456789abcdef"
    mut out := ""
    for i in 0:mask.len {
        b := mask[i] & 255
        out = out + string_from_byte(hex[(b >> 4) & 15])
        out = out + string_from_byte(hex[b & 15])
    }
    << out
}

pub fn (n IPNet) network() string {
    << "ip+net"
}

pub fn (n IPNet) contains(ip &string) bool {
    mut nn := n.ip + ""
    mut m := n.mask + ""
    v4n := ip_to4(&nn)
    if v4n.len == 4 {
        nn = v4n
    }
    if m.len == 16 && nn.len == 4 {
        m = m[12:16]
    }
    mut x := ip + ""
    x4 := ip_to4(&x)
    if x4.len == 4 {
        x = x4
    }
    if x.len != nn.len || x.len != m.len {
        << false
    }
    for i in 0:x.len {
        if ((nn[i] & 255) & (m[i] & 255)) != ((x[i] & 255) & (m[i] & 255)) {
            << false
        }
    }
    << true
}

pub fn (n IPNet) to_string() string {
    nn := n.ip + ""
    m := n.mask + ""
    if nn.len == 0 || m.len == 0 {
        << "<nil>"
    }
    v4 := ip_to4(&nn)
    mut use := nn
    mut use_m := m
    if v4.len == 4 {
        use = v4
        if use_m.len == 16 {
            use_m = use_m[12:16]
        }
    }
    l := simple_mask_length(&use_m)
    if l < 0 {
        << ip_string(&use) + "/" + ip_mask_string(&use_m)
    }
    << ip_string(&use) + "/" + str(l)
}

pub fn parse_cidr(s &string) CIDR {
    src := s + ""
    slash := index_byte(s, 47)
    if slash < 0 {
        >> errors.new("invalid CIDR address")
    }
    addr := src[0:slash]
    mask_s := src[(slash + 1):src.len]
    ip := parse_ip(&addr)
    if ip.len == 0 {
        >> errors.new("invalid CIDR address")
    }
    ones := dtoi_full(&mask_s)
    mut bits := 32
    if ip.len == 16 {
        bits = 128
    }
    if ones < 0 || ones > bits {
        >> errors.new("invalid CIDR address")
    }
    m := cidr_mask(ones, bits)
    masked := ip_mask(&ip, &m)
    << CIDR{ip: ip, ipnet: IPNet{ip: masked, mask: m}}
}

pub fn ip_is_multicast(ip &string) bool {
    v4 := ip_to4(ip)
    if v4.len == 4 {
        << (v4[0] & 240) == 224
    }
    if ip.len == 16 {
        << (ip[0] & 255) == 255
    }
    << false
}

pub fn ip_is_interface_local_multicast(ip &string) bool {
    if ip.len != 16 {
        << false
    }
    << (ip[0] & 255) == 255 && (ip[1] & 15) == 1
}

pub fn ip_is_link_local_multicast(ip &string) bool {
    v4 := ip_to4(ip)
    if v4.len == 4 {
        << (v4[0] & 255) == 224 && (v4[1] & 255) == 0 && (v4[2] & 255) == 0
    }
    if ip.len == 16 {
        << (ip[0] & 255) == 255 && (ip[1] & 15) == 2
    }
    << false
}

pub fn ip_is_link_local_unicast(ip &string) bool {
    v4 := ip_to4(ip)
    if v4.len == 4 {
        << (v4[0] & 255) == 169 && (v4[1] & 255) == 254
    }
    if ip.len == 16 {
        << (ip[0] & 255) == 254 && (ip[1] & 192) == 128
    }
    << false
}

pub fn ip_is_global_unicast(ip &string) bool {
    if ip.len != 4 && ip.len != 16 {
        << false
    }
    bcast := ipv4_bcast()
    if ip_equal(ip, &bcast) {
        << false
    }
    if ip_is_unspecified(ip) {
        << false
    }
    if ip_is_loopback(ip) {
        << false
    }
    if ip_is_multicast(ip) {
        << false
    }
    if ip_is_link_local_unicast(ip) {
        << false
    }
    << true
}
