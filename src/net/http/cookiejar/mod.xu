@net/http/cookiejar

#net/url
#strings

// Go `net/http/cookiejar`. In-memory Jar. No PublicSuffixList: Domain
// attribute cookies are ignored (same as Go with a nil PSL). Host-only
// cookies are stored. Path defaults follow RFC 6265 / Go defaultPath.

pub struct Cookie {
    pub name string
    pub value string
    pub path string
    pub domain string
    pub secure bool
    pub http_only bool
    pub max_age int
}

pub struct Jar {
    pub names []string
    pub values []string
    pub hosts []string
    pub paths []string
    pub secures []int
}

pub fn new_jar() Jar {
    << Jar{names: []string{}, values: []string{}, hosts: []string{}, paths: []string{}, secures: []int{}}
}

fn canonical_host(host0 string) string {
    h := strings.to_lower(&host0)
    mut last := -1
    mut i := 0
    while i < h.len {
        if (h[i] & 255) == 58 {
            last = i
        }
        i = i + 1
    }
    if last > 0 {
        << h[0:last]
    }
    << h + ""
}

fn default_path(p0 string) string {
    p := p0 + ""
    if p.len == 0 || (p[0] & 255) != 47 {
        << "/"
    }
    mut i := p.len
    while i > 0 {
        i = i - 1
        if (p[i] & 255) == 47 {
            if i == 0 {
                << "/"
            }
            << p[0:i]
        }
    }
    << "/"
}

fn path_match(req string, cookie_path string) bool {
    if req == cookie_path {
        << true
    }
    cp := cookie_path + ""
    if req.len < cp.len {
        << false
    }
    mut i := 0
    while i < cp.len {
        if (req[i] & 255) != (cp[i] & 255) {
            << false
        }
        i = i + 1
    }
    if (cp[cp.len - 1] & 255) == 47 {
        << true
    }
    if (req[cp.len] & 255) == 47 {
        << true
    }
    << false
}

fn host_only_ok(c &Cookie) bool {
    if c.domain.len == 0 {
        << true
    }
    << false
}

pub fn (j &mut Jar) set_cookie(u &url.URL, c Cookie) {
    if c.name.len == 0 {
        <<
    }
    if !host_only_ok(&c) {
        <<
    }
    host := canonical_host(u.host())
    mut pth := c.path + ""
    if pth.len == 0 {
        pth = default_path(u.path())
    }
    if c.max_age < 0 {
        mut i := 0
        mut n := j.names.len
        mut nn := []string{}
        mut vv := []string{}
        mut hh := []string{}
        mut pp := []string{}
        mut ss := []int{}
        while i < n {
            same := j.names[i] == c.name && j.hosts[i] == host && j.paths[i] == pth
            if !same {
                nn.push(j.names[i] + "")
                vv.push(j.values[i] + "")
                hh.push(j.hosts[i] + "")
                pp.push(j.paths[i] + "")
                ss.push(j.secures[i])
            }
            i = i + 1
        }
        j.names = nn
        j.values = vv
        j.hosts = hh
        j.paths = pp
        j.secures = ss
        <<
    }
    mut i := 0
    mut found := 0
    while i < j.names.len {
        if j.names[i] == c.name && j.hosts[i] == host && j.paths[i] == pth {
            j.values[i] = c.value + ""
            mut sec := 0
            if c.secure {
                sec = 1
            }
            j.secures[i] = sec
            found = 1
            <-
        }
        i = i + 1
    }
    if found == 0 {
        j.names.push(c.name + "")
        j.values.push(c.value + "")
        j.hosts.push(host)
        j.paths.push(pth)
        mut sec := 0
        if c.secure {
            sec = 1
        }
        j.secures.push(sec)
    }
}

pub fn (j &Jar) len() int {
    << j.names.len
}

pub fn (j &Jar) cookies(u &url.URL) []Cookie {
    host := canonical_host(u.host())
    reqp := u.path()
    mut rp := reqp + ""
    if rp.len == 0 {
        rp = "/"
    }
    https := u.scheme() == "https"
    mut out := []Cookie{}
    mut i := 0
    while i < j.names.len {
        if j.hosts[i] == host {
            if path_match(rp, j.paths[i] + "") {
                if j.secures[i] == 0 || https {
                    out.push(Cookie{name: j.names[i] + "", value: j.values[i] + "", path: j.paths[i] + "", domain: "", secure: j.secures[i] != 0, http_only: false, max_age: 0})
                }
            }
        }
        i = i + 1
    }
    << out
}

pub fn cookie_header(cs &[]Cookie) string {
    mut out := ""
    mut i := 0
    while i < cs.len {
        if i > 0 {
            out = out + "; "
        }
        out = out + (cs[i].name + "") + "=" + (cs[i].value + "")
        i = i + 1
    }
    << out
}
