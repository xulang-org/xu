@net/http

#errors
#net/url

// Client follows 301/302/303/307/308 like Go net/http.Client (max 10).
// Response.get does not follow. 303 always GET; 301/302 convert POST to GET.

const default_max_redirects = 10

fn is_redirect(code int) bool {
    if code == 301 || code == 302 || code == 303 || code == 307 || code == 308 {
        << true
    }
    << false
}

fn redirect_method(code int, method string) string {
    if code == 303 {
        << "GET"
    }
    if code == 301 || code == 302 {
        if method != "GET" && method != "HEAD" {
            << "GET"
        }
    }
    << method + ""
}

fn (c &mut Client) follow_redirects(method string, raw_url string, body &string, first Response, deadline_ns int) Response {
    mut r := first
    mut cur_url := raw_url + ""
    mut cur_method := method + ""
    mut cur_body := body + ""
    mut lim := c.max_redirects
    if lim < 1 {
        lim = default_max_redirects
    }
    mut n := 0
    while n < lim {
        if !is_redirect(r.status_code) {
            << r
        }
        loc := r.header("Location")
        if loc.len == 0 {
            << r
        }
        mut base := url.new_url()
        base.parse(cur_url + "") or >>
        nextu := base.resolve_reference(loc + "") or >>
        next := nextu.to_string()
        nxt_method := redirect_method(r.status_code, cur_method)
        mut nxt_body := cur_body + ""
        if nxt_method != cur_method {
            nxt_body = ""
        }
        if nxt_method == "GET" || nxt_method == "HEAD" {
            if r.status_code == 301 || r.status_code == 302 || r.status_code == 303 {
                nxt_body = ""
            }
        }
        hop := next + ""
        meth := nxt_method + ""
        r = c.do_once(meth + "", hop + "", &nxt_body, deadline_ns) or >>
        cur_url = hop + ""
        cur_method = meth + ""
        cur_body = nxt_body + ""
        n = n + 1
    }
    >> errors.new("net/http: stopped after 10 redirects")
}
