@net/http

#errors
#net

// Request context (Go `http.Handler` / `HandlerFunc`).
//
// Go:
//   func hello(w http.ResponseWriter, r *http.Request) { fmt.Fprint(w, "ok") }
//   http.ListenAndServe(":8080", http.HandlerFunc(hello))
//
// Xu folds w+r into Context:
//   fn hello(c http.Context) { c.text(200, "ok") }
//   http.listen_and_serve_handler("127.0.0.1:8080", hello)

pub struct Context {
    pub fd int
    pub req Request
}

pub fn (c Context) method() string {
    << c.req.method()
}

pub fn (c Context) raw_path() string {
    << c.req.path()
}

pub fn (c Context) path() string {
    raw := c.req.path()
    << strip_query(raw)
}

pub fn (c Context) query() string {
    raw := c.req.path()
    mut i := 0
    while i < raw.len {
        if (raw[i] & 255) == 63 {
            << raw[(i + 1):raw.len]
        }
        i = i + 1
    }
    << ""
}

pub fn (c Context) header(name string) string {
    << c.req.header(name)
}

pub fn (c Context) body() string {
    << c.req.body()
}

pub fn (c Context) text(status int, body string) int {
    << write(c.fd, status, "text/plain; charset=utf-8", &body) or (err) { >> err }
}

pub fn (c Context) text_extra(status int, extra string, body string) int {
    << write_n(c.fd, status, "text/plain; charset=utf-8", extra, &body, true) or (err) { >> err }
}

pub fn (c Context) html(status int, body string) int {
    << write(c.fd, status, "text/html; charset=utf-8", &body) or (err) { >> err }
}

pub fn (c Context) bytes(status int, content_type string, body string) int {
    << write(c.fd, status, content_type, &body) or (err) { >> err }
}

// serve_conn owns one accepted connection. Keeping request parsing and the
// handler on a separate coroutine prevents a slow or idle peer from blocking
// the accept loop and all following clients.
fn serve_conn(fd int, handle fn(Context)) {
    mut req := new_request()
    req.read(fd) or (err) {
        msg := err.msg()
        write(fd, 400, "text/plain; charset=utf-8", &msg) or (e2) { -> }
        net.conn_close(fd) or (e3) { -> }
        ->
    }
    ctx := Context{fd: fd, req: req}
    handle(ctx)
    net.conn_close(fd) or (err) { -> }
}

fn serve_loop(s Server, handle fn(Context)) int {
    mut running := true
    while running {
        fd := s.accept() or (err) {
            running = false
            <-
        }
        if !running {
            <-
        }
        xu serve_conn(fd, handle)
    }
    << 0
}

// serve is Go (*Server).Serve for an already-listening Server.
// close() from another goroutine unblocks Accept and ends the loop.
pub fn (s Server) serve(handle fn(Context)) int {
    << serve_loop(s, handle)
}

// listen_and_serve_handler is Go ListenAndServe(addr, HandlerFunc(fn)).
pub fn listen_and_serve_handler(addr string, handle fn(Context)) int {
    mut s := new_server()
    s.listen(addr) or (err) { >> err }
    << s.serve(handle)
}
