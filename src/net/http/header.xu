@net/http

#strings

// Header is a case-insensitive MIME header (Go `http.Header` /
// `textproto.MIMEHeader` subset). No map: parallel keys/vals; Add
// appends a second pair with the same canonical key.

pub struct Header {
    pub keys []string
    pub vals []string
}

pub fn new_header() Header {
    << Header{keys: []string{}, vals: []string{}}
}

fn ascii_fold(c int) int {
    if c >= 65 && c <= 90 {
        << c + 32
    }
    << c
}

fn header_key_eq(h &string, start int, end int, name &string) bool {
    n := end - start
    if n != name.len {
        << false
    }
    for i in 0:n {
        if ascii_fold(h[start + i] & 255) != ascii_fold(name[i] & 255) {
            << false
        }
    }
    << true
}

fn http_is_token(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 {
        << true
    }
    if c == 42 || c == 43 || c == 45 || c == 46 {
        << true
    }
    if c == 94 || c == 95 || c == 96 || c == 124 || c == 126 {
        << true
    }
    << false
}

pub fn canonical_header_key(s &string) string {
    if s.len == 0 {
        << ""
    }
    $upper := 1
    $need := 0
    for i in 0:s.len {
        c := s[i] & 255
        if !http_is_token(c) {
            << s + ""
        }
        if upper == 1 {
            if c >= 97 && c <= 122 {
                need = 1
            }
        } else {
            if c >= 65 && c <= 90 {
                need = 1
            }
        }
        if c == 45 {
            upper = 1
        } else {
            upper = 0
        }
    }
    if need == 0 {
        << s + ""
    }
    $out := ""
    upper = 1
    for i in 0:s.len {
        $c := s[i] & 255
        if upper == 1 {
            if c >= 97 && c <= 122 {
                c = c - 32
            }
            upper = 0
        } else {
            if c >= 65 && c <= 90 {
                c = c + 32
            }
        }
        if c == 45 {
            upper = 1
        }
        out.push_byte(c)
    }
    << out
}

pub fn (h $&Header) add(key &string, value &string) {
    h.keys.push(canonical_header_key(key))
    h.vals.push(value + "")
}

pub fn (h $&Header) del(key &string) {
    ck := canonical_header_key(key)
    $nkeys := []string{}
    $nvals := []string{}
    for i in 0:h.keys.len {
        if h.keys[i] != ck {
            nkeys.push(h.keys[i] + "")
            nvals.push(h.vals[i] + "")
        }
    }
    h.keys = nkeys
    h.vals = nvals
}

pub fn (h $&Header) set(key &string, value &string) {
    h.del(key)
    h.add(key, value)
}

pub fn (h Header) get(key &string) string {
    ck := canonical_header_key(key)
    for i in 0:h.keys.len {
        if h.keys[i] == ck {
            << h.vals[i] + ""
        }
    }
    << ""
}

pub fn (h Header) values(key &string) []string {
    ck := canonical_header_key(key)
    $out := []string{}
    for i in 0:h.keys.len {
        if h.keys[i] == ck {
            out.push(h.vals[i] + "")
        }
    }
    << out
}

pub fn (h Header) clone() Header {
    $k := []string{}
    $v := []string{}
    $i := 0
    while i < h.keys.len {
        k.push(h.keys[i] + "")
        v.push(h.vals[i] + "")
        i = i + 1
    }
    << Header{keys: k, vals: v}
}

pub fn (h Header) len() int {
    << h.keys.len
}

pub fn (h Header) write() string {
    $out := ""
    for i in 0:h.keys.len {
        out = out + h.keys[i] + ": " + h.vals[i] + "\r\n"
    }
    << out
}

pub fn parse_header(raw &string) Header {
    $h := new_header()
    text := raw + ""
    $i := 0
    while i < text.len {
        $line_end := i
        while line_end < text.len {
            if (text[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        $last := line_end
        if last > i {
            if (text[last - 1] & 255) == 13 {
                last = last - 1
            }
        }
        if last > i {
            $colon := -1
            $j := i
            while j < last {
                if (text[j] & 255) == 58 {
                    colon = j
                    <-
                }
                j = j + 1
            }
            if colon > i {
                kpart := text[i:colon]
                vpart := text[(colon + 1):last]
                k := strings.trim_space(&kpart)
                v := strings.trim_space(&vpart)
                h.add(&k, &v)
            }
        }
        i = line_end + 1
    }
    << h
}
