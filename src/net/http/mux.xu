@net/http

#strings

// ServeMux is an HTTP request multiplexer (aligned with Go `http.ServeMux`).
// It matches the URL path of each incoming request against a list of registered
// patterns and calls the handler for the pattern that most closely matches.
// Patterns may be exact paths (e.g. "/hello") or prefix trees ending with
// a slash (e.g. "/static/"). Unmatched requests receive a 404 Not Found.

pub struct ServeMux {
    pub patterns []string
    pub handlers []fn(Context)
}

pub fn new_serve_mux() ServeMux {
    << ServeMux{patterns: []string{}, handlers: []fn(Context){}}
}

pub fn (m $&ServeMux) handle_func(pattern string, handler fn(Context)) {
    m.patterns.push(pattern + "")
    m.handlers.push(handler)
}

pub fn (m &ServeMux) serve_http(c Context) {
    p := c.path()
    // 1. Exact match has highest precedence
    $i := 0
    while i < m.patterns.len {
        if m.patterns[i] == p {
            h := m.handlers[i]
            h(c)
            <<
        }
        i = i + 1
    }
    // 2. Longest prefix match for trailing-slash patterns
    $best_idx := -1
    $best_len := -1
    $j := 0
    while j < m.patterns.len {
        pat := m.patterns[j] + ""
        if pat.len > 0 && (pat[pat.len - 1] & 255) == 47 {
            if strings.has_prefix(&p, pat) {
                if pat.len > best_len {
                    best_len = pat.len
                    best_idx = j
                }
            }
        }
        j = j + 1
    }
    if best_idx >= 0 {
        h := m.handlers[best_idx]
        h(c)
        <<
    }
    // 3. Fallback: 404 page not found
    c.text(404, "404 page not found\n") or (err) { << }
}
