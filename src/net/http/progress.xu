@net/http

fn no_download_progress(received int, total int) {}

struct DownloadProgress {
    report fn(int, int)
    active bool
    body_start int
    total int
    last_received int
    last_ns int
}

fn download_progress(report fn(int, int)) DownloadProgress {
    << DownloadProgress{report: report, active: false, body_start: -1, total: -1, last_received: -1, last_ns: 0}
}

fn (p $&DownloadProgress) notify(received int, force bool) {
    if !p.active { << }
    now := now_ns()
    if received == p.last_received { << }
    if !force && p.last_received > 0 && now - p.last_ns < 100000000 { << }
    p.last_received = received
    p.last_ns = now
    report := p.report
    report(received, p.total)
}

fn (b $&MsgBuf) report_progress(received int, force bool) {
    p := $&b.progress
    p.notify(received, force)
}

fn (b $&MsgBuf) report_buffered_progress(force bool) {
    data_len := b.data.len
    p := $&b.progress
    if p.body_start < 0 { << }
    $received := data_len - p.body_start
    if p.total >= 0 && received > p.total { received = p.total }
    p.notify(received, force || (p.total >= 0 && received == p.total))
}

fn (b $&MsgBuf) start_progress(header_end int, total int, chunked bool) {
    line_end := find_crlf_from(&b.data, 0)
    if line_end < 0 { << }
    code := parse_status_line(b.data[0:line_end] + "") or (err) { << }
    // Redirect/error bodies are not the downloaded resource.
    b.progress.active = code >= 200 && code < 300
    b.progress.total = total
    if chunked {
        b.report_progress(0, true)
    } else {
        b.progress.body_start = header_end + 4
        b.report_buffered_progress(true)
    }
}

// Observe successful response-body reads, at most every 100 ms plus the
// initial, first payload and final counts. total is -1 for chunked or
// close-delimited bodies.
// The callback runs synchronously; it must not re-enter this client.
pub fn (c $&Client) set_download_progress(report fn(int, int)) {
    c.progress = report
}
