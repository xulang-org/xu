@net/http


#errors
#strconv
#strings

// Cookie / Set-Cookie subset (RFC 6265) aligned with Go `net/http`
// ParseCookie / ParseSetCookie / Cookie.String. Expires is kept as
// raw text (no time.Time). SameSite is a string: "", Lax, Strict, None.

pub struct Cookie {
    pub name string
    pub value string
    pub path string
    pub domain string
    pub expires string
    pub max_age int
    pub secure bool
    pub http_only bool
    pub same_site string
}

fn parse_max_age(s &string) int {
    src := s + ""
    if src.len == 0 {
        << 0
    }
    mut i := 0
    mut neg := 0
    if (src[0] & 255) == 45 {
        neg = 1
        i = 1
    }
    if i >= src.len {
        << 0
    }
    mut n := 0
    while i < src.len {
        c := src[i] & 255
        if c < 48 || c > 57 {
            << 0
        }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    if neg == 1 {
        << 0 - n
    }
    << n
}

fn cookie_value(v &string) string {
    s := strings.trim_space(v)
    if s.len >= 2 && (s[0] & 255) == 34 && (s[s.len - 1] & 255) == 34 {
        << s[1:(s.len - 1)] + ""
    }
    << s
}

fn valid_cookie_name(s &string) bool {
    if s.len == 0 {
        << false
    }
    for i in 0:s.len {
        if !http_is_token(s[i] & 255) {
            << false
        }
    }
    << true
}

pub fn parse_cookie(line &string) []Cookie {
    src := strings.trim_space(line)
    if src.len == 0 {
        >> errors.new("http: blank cookie")
    }
    parts := strings.split(&src, ";")
    mut out := []Cookie{}
    for i in 0:parts.len {
        rawp := parts[i] + ""
        p := strings.trim_space(&rawp)
        if p.len == 0 {
            >> errors.new("http: = not found in cookie")
        }
        cut := strings.cut(&p, "=")
        if !cut.found {
            >> errors.new("http: = not found in cookie")
        }
        b0 := cut.before + ""
        a0 := cut.after + ""
        name := strings.trim_space(&b0)
        if !valid_cookie_name(&name) {
            >> errors.new("http: invalid cookie name")
        }
        val := cookie_value(&a0)
        out.push(Cookie{
            name: name + "",
            value: val + "",
            path: "",
            domain: "",
            expires: "",
            max_age: 0,
            secure: false,
            http_only: false,
            same_site: ""
        })
    }
    << out
}

pub fn parse_set_cookie(line &string) Cookie {
    src := strings.trim_space(line)
    if src.len == 0 {
        >> errors.new("http: blank cookie")
    }
    parts := strings.split(&src, ";")
    if parts.len == 0 {
        >> errors.new("http: blank cookie")
    }
    firstp := parts[0] + ""
    first := strings.trim_space(&firstp)
    cut := strings.cut(&first, "=")
    if !cut.found {
        >> errors.new("http: = not found in cookie")
    }
    b0 := cut.before + ""
    a0 := cut.after + ""
    name := strings.trim_space(&b0)
    if !valid_cookie_name(&name) {
        >> errors.new("http: invalid cookie name")
    }
    val := cookie_value(&a0)
    mut c := Cookie{
        name: name + "",
        value: val + "",
        path: "",
        domain: "",
        expires: "",
        max_age: 0,
        secure: false,
        http_only: false,
        same_site: ""
    }
    for i in 1:parts.len {
        rawp := parts[i] + ""
        raw := strings.trim_space(&rawp)
        if raw.len == 0 {
        } else {
            av := strings.cut(&raw, "=")
            ab := av.before + ""
            aa := av.after + ""
            attr := strings.to_lower(&ab)
            if attr == "path" {
                c.path = cookie_value(&aa)
            } else if attr == "domain" {
                c.domain = cookie_value(&aa)
            } else if attr == "expires" {
                c.expires = cookie_value(&aa)
            } else if attr == "max-age" {
                tmp := cookie_value(&aa)
                secs := parse_max_age(&tmp)
                if secs <= 0 {
                    c.max_age = 0 - 1
                } else {
                    c.max_age = secs
                }
            } else if attr == "secure" {
                c.secure = true
            } else if attr == "httponly" {
                c.http_only = true
            } else if attr == "samesite" {
                tmp := cookie_value(&aa)
                low := strings.to_lower(&tmp)
                if low == "lax" {
                    c.same_site = "Lax"
                } else if low == "strict" {
                    c.same_site = "Strict"
                } else if low == "none" {
                    c.same_site = "None"
                }
            }
        }
    }
    << c
}

pub fn (c Cookie) to_string() string {
    n := c.name + ""
    v := c.value + ""
    mut out := n + "=" + v
    if c.path.len > 0 {
        out = out + "; Path=" + (c.path + "")
    }
    if c.domain.len > 0 {
        out = out + "; Domain=" + (c.domain + "")
    }
    if c.expires.len > 0 {
        out = out + "; Expires=" + (c.expires + "")
    }
    if c.max_age < 0 {
        out = out + "; Max-Age=0"
    } else if c.max_age > 0 {
        s := strconv.itoa(c.max_age)
        out = out + "; Max-Age=" + s
    }
    if c.http_only {
        out = out + "; HttpOnly"
    }
    if c.secure {
        out = out + "; Secure"
    }
    if c.same_site.len > 0 {
        out = out + "; SameSite=" + (c.same_site + "")
    }
    << out
}

pub fn cookie_header(cookies &[]Cookie) string {
    mut out := ""
    for i in 0:cookies.len {
        if i > 0 {
            out = out + "; "
        }
        n := cookies[i].name + ""
        v := cookies[i].value + ""
        out = out + n + "=" + v
    }
    << out
}

pub fn (r Request) cookies() []Cookie {
    line := r.header("Cookie")
    if line.len == 0 {
        << []Cookie{}
    }
    << parse_cookie(&line) or (err) {
        << []Cookie{}
    }
}
