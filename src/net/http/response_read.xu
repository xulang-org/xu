@net/http

#net
#strings
#errors
#crypto/tls

// Call only after read_response has validated and consumed the entire message.
pub fn (r Response) reusable(method string) bool {
    $keep_alive := false
    lines := strings.split(&r.headers, "\r\n")
    for i in 1:lines.len {
        line := lines[i] + ""
        colon := strings.index_of(&line, ":")
        if colon < 1 { -> }
        name := line[0:colon] + ""
        if strings.to_lower(&name) != "connection" { -> }
        value := line[colon + 1:line.len] + ""
        tokens := strings.split(&value, ",")
        for j in 0:tokens.len {
            raw := tokens[j] + ""
            trimmed := strings.trim_space(&raw)
            token := strings.to_lower(&trimmed)
            if token == "close" { << false }
            if token == "keep-alive" { keep_alive = true }
        }
    }
    if r.status.len < 8 { << false }
    if r.status[0:8] == "HTTP/1.0" && !keep_alive { << false }
    if method == "HEAD" || r.status_code == 204 || r.status_code == 304 { << true }
    length := r.header("Content-Length")
    transfer := r.header("Transfer-Encoding")
    << length.len > 0 || transfer.len > 0
}

// Read one response on a caller-owned socket. Serial keep-alive requests are
// supported; pipelined requests require a persistent buffered transport.
pub fn read_response(fd int, method string) Response {
    $b := MsgBuf{data: "", fd: fd, tls_h: 0, tls_conn: tls.closed_conn(), deadline_ns: 0, max_bytes: 0, progress: download_progress(no_download_progress)}
    for interim in 0:MAX_INTERIM_RESPONSES {
        $end := find_crlf_crlf(&b.data)
        while end < 0 {
            if b.data.len > MAX_HEADER_BYTES { >> errors.new("net/http: response headers too large") }
            if b.read_more() or >> == 0 { >> errors.new("net/http: incomplete response headers") }
            end = find_crlf_crlf(&b.data)
        }
        if end > MAX_HEADER_BYTES { >> errors.new("net/http: response headers too large") }
        head := b.data[0:end] + ""
        lines := strings.split(&head, "\r\n")
        status := lines[0] + ""
        if status.len < 12 || (status[0:9] != "HTTP/1.1 " && status[0:9] != "HTTP/1.0 ") {
            >> errors.new("net/http: invalid status line")
        }
        if status.len > 12 && (status[12] & 255) != 32 { >> errors.new("net/http: invalid status code") }
        code := http_decimal(status[9:12] + "", 999) or >>
        if code < 100 { >> errors.new("net/http: invalid status code") }
        $length := -1
        $transfer := ""
        for i in 1:lines.len {
            line := lines[i] + ""
            colon := strings.index_of(&line, ":")
            if colon < 1 { >> errors.new("net/http: invalid response header") }
            name := line[0:colon] + ""
            low := strings.to_lower(&name)
            raw := line[colon + 1:line.len] + ""
            value := strings.trim_space(&raw)
            if low == "content-length" {
                n := http_decimal(value, MAX_MESSAGE_BYTES) or >>
                if length >= 0 && length != n { >> errors.new("net/http: conflicting Content-Length") }
                length = n
            }
            if low == "transfer-encoding" {
                if transfer.len > 0 { >> errors.new("net/http: duplicate Transfer-Encoding") }
                transfer = strings.to_lower(&value)
            }
        }
        if transfer.len > 0 && transfer != "chunked" { >> errors.new("net/http: unsupported Transfer-Encoding") }
        if transfer.len > 0 && length >= 0 { >> errors.new("net/http: ambiguous response framing") }
        $body := ""
        if code >= 100 && code < 200 {
            if code == 101 { >> errors.new("net/http: protocol upgrade is unsupported") }
            b.data = b.data[end + 4:b.data.len] + ""
            ->
        }
        if method == "HEAD" || code == 204 || code == 304 {
            body = ""
        } else if transfer == "chunked" {
            body = b.decode_chunked(end + 4) or >>
        } else if length >= 0 {
            need := end + 4 + length
            while b.data.len < need {
                if b.read_more() or >> == 0 { >> errors.new("net/http: truncated response body") }
            }
            body = b.data[end + 4:need] + ""
        } else {
            while b.read_more() or >> != 0 {}
            body = b.data[end + 4:b.data.len] + ""
        }
        << Response{status_code: code, status: status, headers: head, body: body, sticky: ""}
    }
    >> errors.new("net/http: too many informational responses")
}

fn http_decimal(raw string, limit int) int {
    if raw.len == 0 { >> errors.new("net/http: empty decimal length") }
    $n := 0
    for i in 0:raw.len {
        digit := (raw[i] & 255) - 48
        if digit < 0 || digit > 9 { >> errors.new("net/http: invalid decimal length") }
        if n > (limit - digit) / 10 { >> errors.new("net/http: decimal length exceeds limit") }
        n = n * 10 + digit
    }
    << n
}
