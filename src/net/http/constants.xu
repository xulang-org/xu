@net/http

// Maximum buffered HTTP message size in bytes.
const max_message_bytes = 10485760
// Bytes requested per TCP or TLS read.
const read_chunk_bytes = 4096
// Maximum response header section size in bytes.
const max_header_bytes = 65536
// Iteration budget for bounded HTTP body reads.
const max_read_iterations = 1000000
// Maximum interim (1xx) responses before the final response.
const max_interim_responses = 16
