@net/http

#errors
#net
#net/url
#os
iofs #io/fs
#path/filepath
#mime
#html
#strconv
#strings

// FileServer + ListenAndServe (Go FileServer / FileServerFS).
// Open goes through os.DirFS + io/fs (ValidPath, no `..` escape).
//
//   http.listen_and_serve("127.0.0.1:8080", ".")
//
// Serves GET/HEAD under `root`. Directories use index.html when present,
// otherwise a listing. Paths are cleaned so `..` cannot escape root.

pub struct FileServer {
    pub root string
}

pub fn file_server(root string) FileServer {
    $r := root + ""
    if r.len == 0 {
        r = "."
    }
    << FileServer{root: r}
}

pub fn listen_and_serve(addr string, root string) int {
    $s := new_server()
    s.listen(addr) >>>
    << serve_file_listener(s.lfd, root)
}

fn file_server_handler(c Context) {
    fs := file_server(".")
    fs.serve_context(c)
}

pub fn (fs FileServer) serve(fd int) {
    $req := new_request()
    req.read_timeout(fd, 10000000000) >>> (err) { close_http_fd(fd)
        << }
    $keep_alive := false
    ctx := Context{fd: fd, req: req, keep_alive: $&keep_alive}
    fs.serve_context(ctx)
    close_http_fd(fd)
}

struct ByteRange {
    start int
    end int
    ok bool
}

fn parse_byte_range(range_hdr string, total_size int) ByteRange {
    if total_size <= 0 {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    r := range_hdr + ""
    if !strings.has_prefix(&r, "bytes=") {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    spec := r[6:r.len]
    dash := strings.index_of(&spec, "-")
    if dash < 0 {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    s_part := spec[0:dash]
    e_part := spec[dash + 1:spec.len]
    $start := 0
    $end := total_size - 1
    if s_part.len == 0 {
        if e_part.len == 0 { << ByteRange{start: 0, end: 0, ok: false} }
        suffix := strconv.atoi(&e_part) >>> (err) { << ByteRange{start: 0, end: 0, ok: false} }
        if suffix <= 0 { << ByteRange{start: 0, end: 0, ok: false} }
        start = total_size - suffix
        if start < 0 { start = 0 }
    } else {
        start = strconv.atoi(&s_part) >>> (err) { << ByteRange{start: 0, end: 0, ok: false} }
        if start < 0 || start >= total_size {
            << ByteRange{start: 0, end: 0, ok: false}
        }
        if e_part.len > 0 {
            end = strconv.atoi(&e_part) >>> (err) { << ByteRange{start: 0, end: 0, ok: false} }
            if end >= total_size { end = total_size - 1 }
        }
    }
    if start > end {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    << ByteRange{start: start, end: end, ok: true}
}

fn static_file_length(fsys &os.DirFS, name string) int {
    $file := fsys.open(name) >>>
    length := file.seek(0, os.SEEK_END) >>>
    file.close() >>>
    << length
}

fn static_header(c Context, status int, content_type string, extra string, length int) int {
    head := response_header_bytes(status, content_type, extra, length, *c.keep_alive)
    << write_response_data(c.fd, &head) >>> (err) {
        *c.keep_alive = false
        >>> err
    }
}

fn static_error(c Context, status int, message string, send_body bool) {
    write_n_mode(c.fd, status, "text/plain; charset=utf-8", "", &message, send_body, *c.keep_alive) >>> (err) {
        *c.keep_alive = false
        <<
    }
}

fn static_file_headers(length int) string {
    << "ETag: \"" + strconv.itoa(length) + "\"\r\nAccept-Ranges: bytes\r\n"
}

fn static_range_outside(c Context, content_type string, size int, send_body bool) {
    extra := "Content-Range: bytes */" + strconv.itoa(size) + "\r\n"
    message := "range not satisfiable\n"
    write_n_mode(c.fd, 416, content_type, extra, &message, send_body, *c.keep_alive) >>> (err) {
        *c.keep_alive = false
        <<
    }
}

fn write_static_range(fd int, file &os.File, length int) int {
    $remaining := length
    while remaining > 0 {
        $take := remaining
        if take > READ_CHUNK_BYTES { take = READ_CHUNK_BYTES }
        chunk := file.read(take) >>>
        if chunk.len == 0 || chunk.len > take { >>> errors.new("net/http: incomplete file range") }
        write_response_data(fd, &chunk) >>>
        remaining -= chunk.len
    }
    << length
}

fn serve_static_range(c Context, fsys &os.DirFS, name string, content_type string, range_header string, size_hint int, send_body bool) {
    original := parse_byte_range(range_header + "", size_hint)
    if !original.ok {
        static_range_outside(c, content_type + "", size_hint, send_body)
        <<
    }
    file := fsys.open(name) >>> (err) {
        static_error(c, 404, "404 page not found\n", send_body)
        <<
    }
    size := file.seek(0, os.SEEK_END) >>> (err) {
        static_error(c, 404, "404 page not found\n", send_body)
        <<
    }
    range := parse_byte_range(range_header, size)
    if !range.ok {
        static_range_outside(c, content_type + "", size, send_body)
        <<
    }
    if send_body {
        _ := file.seek(range.start, os.SEEK_SET) >>> (err) {
            static_error(c, 404, "404 page not found\n", true)
            <<
        }
    }
    length := range.end - range.start + 1
    extra := static_file_headers(size) + "Content-Range: bytes " + strconv.itoa(range.start) + "-" + strconv.itoa(range.end) + "/" + strconv.itoa(size) + "\r\n"
    if !send_body {
        static_header(c, 206, content_type, extra, length) >>> (err) { << }
        <<
    }
    head := response_header_bytes(206, content_type, extra, length, *c.keep_alive)
    write_response_data(c.fd, &head) >>> (err) {
        *c.keep_alive = false
        <<
    }
    // The advertised length requires retiring the connection on any
    // incomplete transfer, before the next response can be sent.
    write_static_range(c.fd, &file, length) >>> (err) {
        *c.keep_alive = false
        <<
    }
}

fn static_index_length(fsys &os.DirFS, name string) int {
    info := iofs.stat(fsys, name + "") >>>
    if info.is_dir { >>> errors.new("net/http: index is a directory") }
    << static_file_length(fsys, name) >>>
}

fn static_listing(c Context, fsys &os.DirFS, path string, name string, send_body bool) {
    html := dir_listing(path, fsys, name)
    write_n_mode(c.fd, 200, "text/html; charset=utf-8", "", &html, send_body, *c.keep_alive) >>> (err) {
        *c.keep_alive = false
        <<
    }
}

pub fn (fs FileServer) serve_context(c Context) {
    fd := c.fd
    method := c.req.method()
    raw := c.req.path()
    if method != "GET" && method != "HEAD" {
        msg := "method not allowed\n"
        write_n_mode(fd, 405, "text/plain; charset=utf-8", "", &msg, true, *c.keep_alive) >>> (err) { << }
        <<
    }
    send_body := method == "GET"
    url_path := strip_query(raw)
    local := map_url_path(&url_path)
    if local.len == 0 {
        static_error(c, 403, "forbidden\n", send_body)
        <<
    }
    fsys := os.dir_fs(fs.root + "")
    loc := local + ""
    info := iofs.stat(&fsys, loc + "") >>> (err) {
        static_error(c, 404, "404 page not found\n", send_body)
        <<
    }
    if info.is_dir {
        slash := ends_with_slash(url_path)
        if !slash {
            loc := url_path + "/"
            write_redirect(fd, loc, *c.keep_alive) >>> (err) { << }
            <<
        }
        $idx := "index.html"
        if loc != "." {
            idx = loc + "/index.html"
        }
        if !send_body {
            length := static_index_length(&fsys, idx + "") >>> (err) {
                static_listing(c, &fsys, url_path, loc, false)
                <<
            }
            static_header(c, 200, "text/html; charset=utf-8", "", length) >>> (err) { << }
            <<
        }
        idx_body := iofs.read_file(&fsys, idx) >>> (err) {
            static_listing(c, &fsys, url_path, loc, true)
            <<
        }
        write_n_mode(fd, 200, "text/html; charset=utf-8", "", &idx_body, true, *c.keep_alive) >>> (err) { << }
        <<
    }
    ext := filepath.ext(&loc)
    $ctype := mime.type_by_extension(&ext)
    if ctype.len == 0 {
        ctype = fallback_type(&ext)
    }
    etag := "\"" + strconv.itoa(info.size) + "\""
    inm := c.header("if-none-match")
    if inm.len > 0 && (inm == etag || inm == "*") {
        static_header(c, 304, ctype, static_file_headers(info.size), 0) >>> (err) { << }
        <<
    }
    range_req := c.header("range")
    if range_req.len > 0 && strings.has_prefix(&range_req, "bytes=") {
        serve_static_range(c, &fsys, loc, ctype, range_req, info.size, send_body)
        <<
    }
    if !send_body {
        length := static_file_length(&fsys, loc) >>> (err) {
            static_error(c, 404, "404 page not found\n", false)
            <<
        }
        static_header(c, 200, ctype, static_file_headers(length), length) >>> (err) { << }
        <<
    }
    body := iofs.read_file(&fsys, loc + "") >>> (err) {
        static_error(c, 404, "404 page not found\n", true)
        <<
    }
    write_n_mode(fd, 200, ctype, static_file_headers(info.size), &body, true, *c.keep_alive) >>> (err) { << }
}

pub fn serve_file(fd int, name string) int {
    body := os.read(name + "") >>>
    ext := filepath.ext(&name)
    $ctype := mime.type_by_extension(&ext)
    if ctype.len == 0 {
        ctype = fallback_type(&ext)
    }
    << write(fd, 200, ctype, &body)
}

fn fallback_type(ext &string) string {
    e := strings.to_lower(ext)
    if e == ".txt" || e == ".md" || e == ".log" {
        << "text/plain; charset=utf-8"
    }
    if e == ".ico" {
        << "image/x-icon"
    }
    if e == ".woff2" {
        << "font/woff2"
    }
    << "application/octet-stream"
}

fn strip_query(p string) string {
    $i := 0
    while i < p.len {
        if (p[i] & 255) == 63 {
            << p[0:i]
        }
        i = i + 1
    }
    << p + ""
}

fn ends_with_slash(p string) bool {
    if p.len == 0 {
        << false
    }
    << (p[p.len - 1] & 255) == 47
}

fn hex_digit(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

fn path_unescape(s string) string {
    src := s + ""
    $out := ""
    $i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 37 && i + 2 < src.len {
            a := hex_digit(src[i + 1] & 255)
            b := hex_digit(src[i + 2] & 255)
            if a >= 0 && b >= 0 {
                out = out + string_from_byte((a << 4) | b)
                i = i + 3
                ->
            }
        }
        out = out + string_from_byte(c)
        i = i + 1
    }
    << out
}

// map_url_path: Go Dir.Open — Clean("/"+name) then drop the leading slash.
// Rooted clean swallows leading `..`, so the result stays inside root.
fn map_url_path(url_path &string) string {
    dec := path_unescape(url_path + "")
    $p := dec + ""
    if p.len == 0 {
        p = "/"
    }
    if (p[0] & 255) != 47 {
        p = "/" + p
    }
    clean_p := filepath.clean(&p)
    c := filepath.to_slash(&clean_p)
    if c == "/" || c == "." {
        << "."
    }
    if c.len > 0 && (c[0] & 255) == 47 {
        << c[1:c.len]
    }
    << c
}

fn join_root(root string, rel string) string {
    $r := root + ""
    if r.len == 0 {
        r = "."
    }
    if rel == "." {
        << filepath.clean(&r)
    }
    $parts := []string{}
    parts.push(r)
    parts.push(rel + "")
    << filepath.join(parts)
}

fn write_redirect(fd int, location string, keep_alive bool) int {
    extra := "Location: " + location + "\r\n"
    body := location + "\n"
    << write_n_mode(fd, 301, "text/html; charset=utf-8", extra, &body, true, keep_alive) >>>
}

fn dir_listing(url_path string, fsys &os.DirFS, name string) string {
    $path := url_path + ""
    if path.len == 0 {
        path = "/"
    }
    ents := iofs.read_dir(fsys, name) >>> (err) {
        << "<pre>cannot list</pre>"
    }
    esc_path := html.escape_string(&path)
    $out := "<!doctype html><html><head><meta charset=\"utf-8\"><title>"
    out = out + esc_path + "</title></head><body><h1>Index of " + esc_path + "</h1><hr><pre>"
    if path != "/" {
        out = out + "<a href=\"../\">../</a>\n"
    }
    $i := 0
    while i < ents.len {
        nm := ents[i].name + ""
        if nm == "." || nm == ".." {
            i = i + 1
            ->
        }
        esc := html.escape_string(&nm)
        href := url.path_escape(&nm)
        if ents[i].is_dir {
            out = out + "<a href=\"" + href + "/\">" + esc + "/</a>\n"
        } else {
            out = out + "<a href=\"" + href + "\">" + esc + "</a>\n"
        }
        i = i + 1
    }
    out = out + "</pre><hr></body></html>"
    << out
}
