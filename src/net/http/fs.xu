@net/http

#errors
#net
#net/url
#os
iofs #io/fs
#path/filepath
#mime
#html
#strconv
#strings

// FileServer + ListenAndServe (Go FileServer / FileServerFS).
// Open goes through os.DirFS + io/fs (ValidPath, no `..` escape).
//
//   http.listen_and_serve("127.0.0.1:8080", ".")
//
// Serves GET/HEAD under `root`. Directories use index.html when present,
// otherwise a listing. Paths are cleaned so `..` cannot escape root.

pub struct FileServer {
    pub root string
}

pub fn file_server(root string) FileServer {
    $r := root + ""
    if r.len == 0 {
        r = "."
    }
    << FileServer{root: r}
}

pub fn listen_and_serve(addr string, root string) int {
    $s := new_server()
    s.listen(addr) or >>
    << serve_file_listener(s.lfd, root)
}

fn file_server_handler(c Context) {
    fs := file_server(".")
    fs.serve_context(c)
}

pub fn (fs FileServer) serve(fd int) {
    $req := new_request()
    req.read_timeout(fd, 10000000000) or (err) { close_http_fd(fd)
        << }
    $keep_alive := false
    ctx := Context{fd: fd, req: req, keep_alive: $&keep_alive}
    fs.serve_context(ctx)
    close_http_fd(fd)
}

struct ByteRange {
    start int
    end int
    ok bool
}

fn parse_byte_range(range_hdr string, total_size int) ByteRange {
    if total_size <= 0 {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    r := range_hdr + ""
    if !strings.has_prefix(&r, "bytes=") {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    spec := r[6:r.len]
    dash := strings.index_of(&spec, "-")
    if dash < 0 {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    s_part := spec[0:dash]
    e_part := spec[dash + 1:spec.len]
    $start := 0
    $end := total_size - 1
    if s_part.len == 0 {
        if e_part.len == 0 { << ByteRange{start: 0, end: 0, ok: false} }
        suffix := strconv.atoi(&e_part) or (err) { << ByteRange{start: 0, end: 0, ok: false} }
        if suffix <= 0 { << ByteRange{start: 0, end: 0, ok: false} }
        start = total_size - suffix
        if start < 0 { start = 0 }
    } else {
        start = strconv.atoi(&s_part) or (err) { << ByteRange{start: 0, end: 0, ok: false} }
        if start < 0 || start >= total_size {
            << ByteRange{start: 0, end: 0, ok: false}
        }
        if e_part.len > 0 {
            end = strconv.atoi(&e_part) or (err) { << ByteRange{start: 0, end: 0, ok: false} }
            if end >= total_size { end = total_size - 1 }
        }
    }
    if start > end {
        << ByteRange{start: 0, end: 0, ok: false}
    }
    << ByteRange{start: start, end: end, ok: true}
}

pub fn (fs FileServer) serve_context(c Context) {
    fd := c.fd
    method := c.req.method()
    raw := c.req.path()
    if method != "GET" && method != "HEAD" {
        msg := "method not allowed\n"
        write_n_mode(fd, 405, "text/plain; charset=utf-8", "", &msg, true, *c.keep_alive) or (err) { << }
        <<
    }
    send_body := method == "GET"
    url_path := strip_query(raw)
    local := map_url_path(&url_path)
    if local.len == 0 {
        msg := "forbidden\n"
        write_n_mode(fd, 403, "text/plain; charset=utf-8", "", &msg, true, *c.keep_alive) or (err) { << }
        <<
    }
    fsys := os.dir_fs(fs.root + "")
    loc := local + ""
    info := iofs.stat(&fsys, loc + "") or (err) {
        msg := "404 page not found\n"
        write_n_mode(fd, 404, "text/plain; charset=utf-8", "", &msg, true, *c.keep_alive) or (e2) { << }
        <<
    }
    if info.is_dir {
        slash := ends_with_slash(url_path)
        if !slash {
            loc := url_path + "/"
            write_redirect(fd, loc, *c.keep_alive) or (err) { << }
            <<
        }
        $idx := "index.html"
        if loc != "." {
            idx = loc + "/index.html"
        }
        idx_body := iofs.read_file(&fsys, idx) or (err) {
            html := dir_listing(url_path, &fsys, loc + "")
            write_n_mode(fd, 200, "text/html; charset=utf-8", "", &html, send_body, *c.keep_alive) or (e2) { << }
            <<
        }
        write_n_mode(fd, 200, "text/html; charset=utf-8", "", &idx_body, send_body, *c.keep_alive) or (err) { << }
        <<
    }
    ext := filepath.ext(&loc)
    $ctype := mime.type_by_extension(&ext)
    if ctype.len == 0 {
        ctype = fallback_type(&ext)
    }
    etag := "\"" + strconv.itoa(info.size) + "\""
    inm := c.header("if-none-match")
    if inm.len > 0 && (inm == etag || inm == "*") {
        extra := "ETag: " + etag + "\r\nAccept-Ranges: bytes\r\n"
        empty := ""
        write_n_mode(fd, 304, ctype, extra, &empty, false, *c.keep_alive) or (err) { << }
        <<
    }
    range_req := c.header("range")
    if range_req.len > 0 && strings.has_prefix(&range_req, "bytes=") {
        br := parse_byte_range(range_req, info.size)
        if br.ok {
            body := iofs.read_file(&fsys, loc + "") or (err) {
                msg := "404 page not found\n"
                write_n_mode(fd, 404, "text/plain; charset=utf-8", "", &msg, true, *c.keep_alive) or (e2) { << }
                <<
            }
            content_range := "bytes " + strconv.itoa(br.start) + "-" + strconv.itoa(br.end) + "/" + strconv.itoa(info.size)
            extra := "ETag: " + etag + "\r\nAccept-Ranges: bytes\r\nContent-Range: " + content_range + "\r\n"
            part := body[br.start:(br.end + 1)]
            write_n_mode(fd, 206, ctype, extra, &part, send_body, *c.keep_alive) or (err) { << }
            <<
        } else {
            extra := "Content-Range: bytes */" + strconv.itoa(info.size) + "\r\n"
            msg := "range not satisfiable\n"
            write_n_mode(fd, 416, "text/plain; charset=utf-8", extra, &msg, true, *c.keep_alive) or (err) { << }
            <<
        }
    }
    body := iofs.read_file(&fsys, loc + "") or (err) {
        msg := "404 page not found\n"
        write_n_mode(fd, 404, "text/plain; charset=utf-8", "", &msg, true, *c.keep_alive) or (e2) { << }
        <<
    }
    extra := "ETag: " + etag + "\r\nAccept-Ranges: bytes\r\n"
    write_n_mode(fd, 200, ctype, extra, &body, send_body, *c.keep_alive) or (err) { << }
}

pub fn serve_file(fd int, name string) int {
    body := os.read(name + "") or >>
    ext := filepath.ext(&name)
    $ctype := mime.type_by_extension(&ext)
    if ctype.len == 0 {
        ctype = fallback_type(&ext)
    }
    << write(fd, 200, ctype, &body)
}

fn fallback_type(ext &string) string {
    e := strings.to_lower(ext)
    if e == ".txt" || e == ".md" || e == ".log" {
        << "text/plain; charset=utf-8"
    }
    if e == ".ico" {
        << "image/x-icon"
    }
    if e == ".woff2" {
        << "font/woff2"
    }
    << "application/octet-stream"
}

fn strip_query(p string) string {
    $i := 0
    while i < p.len {
        if (p[i] & 255) == 63 {
            << p[0:i]
        }
        i = i + 1
    }
    << p + ""
}

fn ends_with_slash(p string) bool {
    if p.len == 0 {
        << false
    }
    << (p[p.len - 1] & 255) == 47
}

fn hex_digit(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

fn path_unescape(s string) string {
    src := s + ""
    $out := ""
    $i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 37 && i + 2 < src.len {
            a := hex_digit(src[i + 1] & 255)
            b := hex_digit(src[i + 2] & 255)
            if a >= 0 && b >= 0 {
                out = out + string_from_byte((a << 4) | b)
                i = i + 3
                ->
            }
        }
        out = out + string_from_byte(c)
        i = i + 1
    }
    << out
}

// map_url_path: Go Dir.Open — Clean("/"+name) then drop the leading slash.
// Rooted clean swallows leading `..`, so the result stays inside root.
fn map_url_path(url_path &string) string {
    dec := path_unescape(url_path + "")
    $p := dec + ""
    if p.len == 0 {
        p = "/"
    }
    if (p[0] & 255) != 47 {
        p = "/" + p
    }
    clean_p := filepath.clean(&p)
    c := filepath.to_slash(&clean_p)
    if c == "/" || c == "." {
        << "."
    }
    if c.len > 0 && (c[0] & 255) == 47 {
        << c[1:c.len]
    }
    << c
}

fn join_root(root string, rel string) string {
    $r := root + ""
    if r.len == 0 {
        r = "."
    }
    if rel == "." {
        << filepath.clean(&r)
    }
    $parts := []string{}
    parts.push(r)
    parts.push(rel + "")
    << filepath.join(parts)
}

fn write_redirect(fd int, location string, keep_alive bool) int {
    extra := "Location: " + location + "\r\n"
    body := location + "\n"
    << write_n_mode(fd, 301, "text/html; charset=utf-8", extra, &body, true, keep_alive) or >>
}

fn dir_listing(url_path string, fsys &os.DirFS, name string) string {
    $path := url_path + ""
    if path.len == 0 {
        path = "/"
    }
    ents := iofs.read_dir(fsys, name) or (err) {
        << "<pre>cannot list</pre>"
    }
    esc_path := html.escape_string(&path)
    $out := "<!doctype html><html><head><meta charset=\"utf-8\"><title>"
    out = out + esc_path + "</title></head><body><h1>Index of " + esc_path + "</h1><hr><pre>"
    if path != "/" {
        out = out + "<a href=\"../\">../</a>\n"
    }
    $i := 0
    while i < ents.len {
        nm := ents[i].name + ""
        if nm == "." || nm == ".." {
            i = i + 1
            ->
        }
        esc := html.escape_string(&nm)
        href := url.path_escape(&nm)
        if ents[i].is_dir {
            out = out + "<a href=\"" + href + "/\">" + esc + "/</a>\n"
        } else {
            out = out + "<a href=\"" + href + "\">" + esc + "</a>\n"
        }
        i = i + 1
    }
    out = out + "</pre><hr></body></html>"
    << out
}
