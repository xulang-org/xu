@net/http

#errors
#net
#net/url
#os
iofs #io/fs
#path/filepath
#mime
#html
#strings

// FileServer + ListenAndServe (Go FileServer / FileServerFS).
// Open goes through os.DirFS + io/fs (ValidPath, no `..` escape).
//
//   http.listen_and_serve("127.0.0.1:8080", ".")
//
// Serves GET/HEAD under `root`. Directories use index.html when present,
// otherwise a listing. Paths are cleaned so `..` cannot escape root.

pub struct FileServer {
    pub root string
}

pub fn file_server(root string) FileServer {
    mut r := root + ""
    if r.len == 0 {
        r = "."
    }
    << FileServer{root: r}
}

pub fn listen_and_serve(addr string, root string) int {
    fs := file_server(root)
    mut s := new_server()
    s.listen(addr) or >>
    r := fs.root + ""
    mut running := true
    while running {
        fd := s.accept() or (err) {
            ->
        }
        if xu_target_os() == 1 {
            file_server_serve(r + "", fd)
        } else {
            xu file_server_serve(r + "", fd)
        }
    }
    << 0
}

fn file_server_serve(root string, fd int) {
    fs := FileServer{root: root}
    fs.serve(fd)
}

pub fn (fs FileServer) serve(fd int) {
    mut req := new_request()
    req.read(fd) or (err) {
        msg := err.msg()
        write(fd, 400, "text/plain; charset=utf-8", &msg) or (e2) { << }
        net.conn_close(fd) or (e3) { << }
        <<
    }
    method := req.method()
    raw := req.path()
    if method != "GET" && method != "HEAD" {
        msg := "method not allowed\n"
        write(fd, 405, "text/plain; charset=utf-8", &msg) or (err) { << }
        net.conn_close(fd) or (err) { << }
        <<
    }
    send_body := method == "GET"
    url_path := strip_query(raw)
    local := map_url_path(&url_path)
    if local.len == 0 {
        msg := "forbidden\n"
        write(fd, 403, "text/plain; charset=utf-8", &msg) or (err) { << }
        net.conn_close(fd) or (err) { << }
        <<
    }
    fsys := os.dir_fs(fs.root + "")
    loc := local + ""
    info := iofs.stat(&fsys, loc + "") or (err) {
        msg := "404 page not found\n"
        write(fd, 404, "text/plain; charset=utf-8", &msg) or (e2) { << }
        net.conn_close(fd) or (e3) { << }
        <<
    }
    if info.is_dir {
        slash := ends_with_slash(url_path)
        if !slash {
            loc := url_path + "/"
            write_redirect(fd, loc) or (err) { << }
            net.conn_close(fd) or (err) { << }
            <<
        }
        mut idx := "index.html"
        if loc != "." {
            idx = loc + "/index.html"
        }
        idx_body := iofs.read_file(&fsys, idx) or (err) {
            html := dir_listing(url_path, &fsys, loc + "")
            write_n(fd, 200, "text/html; charset=utf-8", "", &html, send_body) or (e2) { << }
            net.conn_close(fd) or (e3) { << }
            <<
        }
        write_n(fd, 200, "text/html; charset=utf-8", "", &idx_body, send_body) or (err) { << }
        net.conn_close(fd) or (err) { << }
        <<
    }
    body := iofs.read_file(&fsys, loc + "") or (err) {
        msg := "404 page not found\n"
        write(fd, 404, "text/plain; charset=utf-8", &msg) or (e2) { << }
        net.conn_close(fd) or (e3) { << }
        <<
    }
    ext := filepath.ext(&loc)
    mut ctype := mime.type_by_extension(&ext)
    if ctype.len == 0 {
        ctype = fallback_type(&ext)
    }
    write_n(fd, 200, ctype, "", &body, send_body) or (err) { << }
    net.conn_close(fd) or (err) { << }
}

pub fn serve_file(fd int, name string) int {
    body := os.read(name + "") or >>
    ext := filepath.ext(&name)
    mut ctype := mime.type_by_extension(&ext)
    if ctype.len == 0 {
        ctype = fallback_type(&ext)
    }
    << write(fd, 200, ctype, &body)
}

fn fallback_type(ext &string) string {
    e := strings.to_lower(ext)
    if e == ".txt" || e == ".md" || e == ".log" {
        << "text/plain; charset=utf-8"
    }
    if e == ".ico" {
        << "image/x-icon"
    }
    if e == ".woff2" {
        << "font/woff2"
    }
    << "application/octet-stream"
}

fn strip_query(p string) string {
    mut i := 0
    while i < p.len {
        if (p[i] & 255) == 63 {
            << p[0:i]
        }
        i = i + 1
    }
    << p + ""
}

fn ends_with_slash(p string) bool {
    if p.len == 0 {
        << false
    }
    << (p[p.len - 1] & 255) == 47
}

fn hex_digit(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

fn path_unescape(s string) string {
    src := s + ""
    mut out := ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 37 && i + 2 < src.len {
            a := hex_digit(src[i + 1] & 255)
            b := hex_digit(src[i + 2] & 255)
            if a >= 0 && b >= 0 {
                out = out + string_from_byte((a << 4) | b)
                i = i + 3
                ->
            }
        }
        out = out + string_from_byte(c)
        i = i + 1
    }
    << out
}

// map_url_path: Go Dir.Open — Clean("/"+name) then drop the leading slash.
// Rooted clean swallows leading `..`, so the result stays inside root.
fn map_url_path(url_path &string) string {
    dec := path_unescape(url_path + "")
    mut p := dec + ""
    if p.len == 0 {
        p = "/"
    }
    if (p[0] & 255) != 47 {
        p = "/" + p
    }
    c := filepath.clean(&p)
    if c == "/" {
        << "."
    }
    if c.len > 0 && (c[0] & 255) == 47 {
        << c[1:c.len]
    }
    << c
}

fn join_root(root string, rel string) string {
    mut r := root + ""
    if r.len == 0 {
        r = "."
    }
    if rel == "." {
        << filepath.clean(&r)
    }
    mut parts := []string{}
    parts.push(r)
    parts.push(rel + "")
    << filepath.join(parts)
}

fn write_redirect(fd int, location string) int {
    extra := "Location: " + location + "\r\n"
    body := location + "\n"
    << write_n(fd, 301, "text/html; charset=utf-8", extra, &body, true) or >>
}

fn dir_listing(url_path string, fsys &os.DirFS, name string) string {
    mut path := url_path + ""
    if path.len == 0 {
        path = "/"
    }
    ents := iofs.read_dir(fsys, name) or (err) {
        << "<pre>cannot list</pre>"
    }
    esc_path := html.escape_string(&path)
    mut out := "<!doctype html><html><head><meta charset=\"utf-8\"><title>"
    out = out + esc_path + "</title></head><body><h1>Index of " + esc_path + "</h1><hr><pre>"
    if path != "/" {
        out = out + "<a href=\"../\">../</a>\n"
    }
    mut i := 0
    while i < ents.len {
        nm := ents[i].name + ""
        if nm == "." || nm == ".." {
            i = i + 1
            ->
        }
        esc := html.escape_string(&nm)
        href := url.path_escape(&nm)
        if ents[i].is_dir {
            out = out + "<a href=\"" + href + "/\">" + esc + "/</a>\n"
        } else {
            out = out + "<a href=\"" + href + "\">" + esc + "</a>\n"
        }
        i = i + 1
    }
    out = out + "</pre><hr></body></html>"
    << out
}
