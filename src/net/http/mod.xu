@net/http


#errors
// net.http — HTTP/1.1 client + server helpers (Go `net/http` subset).
// Client: GET/POST over IPv4 TCP; HTTPS via crypto/tls.Dial.
// Cookie jar: net/http/cookiejar (Go CookieJar).
// Server: Request.read + write / FileServer / Context handler.
// There is no ServeMux value in this version; route dispatch is supplied by
// the caller's handler function.
// Client keep-alive reuses one idle HTTP or HTTPS connection per Client.
// No HTTP/2.

#net
#net/url
#os
core #runtime/core
#strconv
#strings
#crypto/tls
#net/http/cookiejar

pub struct Response {
    pub status_code int
    pub status string
    pub headers string
    pub body string
    pub sticky string
}

pub fn new_response() Response {
    << Response{status_code: 0, status: "", headers: "", body: "", sticky: ""}
}

pub fn (r Response) status_code() int {
    << r.status_code
}

pub fn (r Response) status() string {
    << r.status + ""
}

pub fn (r Response) body() string {
    << r.body + ""
}

pub fn (r Response) header(name string) string {
    << header_lookup(&r.headers, name)
}

pub struct Request {
    pub method string
    pub path string
    pub headers string
    pub body string
    pub sticky string
    pub remote_addr string
}

pub fn new_request() Request {
    << Request{method: "", path: "", headers: "", body: "", sticky: "", remote_addr: ""}
}

pub fn (r Request) method() string {
    << r.method + ""
}

pub fn (r Request) path() string {
    << r.path + ""
}

pub fn (r Request) body() string {
    << r.body + ""
}

pub fn (r Request) header(name string) string {
    << header_lookup(&r.headers, name)
}

pub fn (r Request) user_agent() string {
    << r.header("User-Agent")
}

pub fn (r Request) host() string {
    << r.header("Host")
}

pub fn (r Request) remote_addr() string {
    << r.remote_addr + ""
}

pub fn (r Request) query_value(key string) string {
    u := url.parse(r.path + "")
    q := u.query()
    << q.get(key)
}

pub fn (r Request) form_value(key string) string {
    ct := r.header("Content-Type")
    if r.method == "POST" && strings.has_prefix(&ct, "application/x-www-form-urlencoded") {
        q := url.parse_query(r.body + "")
        v := q.get(key)
        if v.len > 0 { << v }
    }
    << r.query_value(key)
}

pub struct Server {
    pub lfd int
    pub laddr string
}

pub fn new_server() Server {
    << Server{lfd: -1, laddr: ""}
}

pub fn (s Server) clone() Server {
    << Server{lfd: s.lfd, laddr: s.laddr + ""}
}

pub fn (s $&Server) listen(addr string) int {
    if addr.len == 0 {
        >>> errors.new("net/http: empty address")
    }
    s.lfd = net.listen(addr) >>>
    s.laddr = net.socket_local_addr(s.lfd)
    << 0
}

pub fn (s Server) addr() string {
    if s.lfd >= 0 {
        loc := net.socket_local_addr(s.lfd)
        if loc.len > 0 { << loc }
    }
    << s.laddr + ""
}

pub fn (s Server) accept() int {
    if s.lfd < 0 {
        >>> errors.new("net/http: not listening")
    }
    << net.accept(s.lfd)
}

pub fn (s $&Server) close() int {
    if s.lfd < 0 {
        << 0
    }
    net.conn_close(s.lfd) >>> (err) {
        s.lfd = -1
        << 1
    }
    s.lfd = -1
    << 0
}

fn http_shutdown_quiet(fd int) {
    os.shutdown(fd, 2) >>> (err) { << }
}

pub fn (s $&Server) shutdown() int {
    if s.lfd < 0 {
        << 0
    }
    http_shutdown_quiet(s.lfd)
    << s.close()
}

fn header_lookup(headers &string, name string) string {
    // Keep a local owning view before indexed access. The bootstrap backend
    // cannot safely index a borrowed string through a non-zero offset on all
    // optimization tiers; this clone is bounded by the 10 MiB message cap and
    // preserves correctness while retaining allocation-free key/value scans.
    h := headers + ""
    hlen := h.len
    $i := 0
    while i < hlen {
        $line_end := i
        while line_end < hlen {
            if (h[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        $line_last := line_end
        if line_last > i {
            if (h[line_last - 1] & 255) == 13 {
                line_last = line_last - 1
            }
        }
        $colon := -1
        $j := i
        while j < line_last {
            if (h[j] & 255) == 58 {
                colon = j
                <-
            }
            j = j + 1
        }
        if colon > i {
            if header_key_eq(&h, i, colon, &name) {
                $v0 := colon + 1
                $v1 := line_last
                while v0 < v1 {
                    c := h[v0] & 255
                    if c == 32 || c == 9 {
                        v0 = v0 + 1
                    } else {
                        <-
                    }
                }
                while v1 > v0 {
                    c := h[v1 - 1] & 255
                    if c == 32 || c == 9 {
                        v1 = v1 - 1
                    } else {
                        <-
                    }
                }
                if v1 > v0 {
                    << h[v0:v1]
                }
                << ""
            }
        }
        i = line_end + 1
    }
    << ""
}

fn find_crlf_crlf(s &string) int {
    << find_crlf_crlf_from(s, 0)
}

fn parse_content_length(headers &string) int {
    << parse_content_length_limit(headers, MAX_MESSAGE_BYTES)
}

fn parse_content_length_limit(headers &string, limit int) int {
    cl := "content-length"
    h := headers + ""
    hlen := h.len
    $i := 0
    while i < hlen {
        $line_end := i
        while line_end < hlen {
            if (h[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        $line_last := line_end
        if line_last > i {
            if (h[line_last - 1] & 255) == 13 {
                line_last = line_last - 1
            }
        }
        $colon := -1
        $j := i
        while j < line_last {
            if (h[j] & 255) == 58 {
                colon = j
                <-
            }
            j = j + 1
        }
        if colon > i {
            if header_key_eq(&h, i, colon, &cl) {
                $v0 := colon + 1
                $v1 := line_last
                while v0 < v1 {
                    c := h[v0] & 255
                    if c == 32 || c == 9 {
                        v0 = v0 + 1
                    } else {
                        <-
                    }
                }
                while v1 > v0 {
                    c := h[v1 - 1] & 255
                    if c == 32 || c == 9 {
                        v1 = v1 - 1
                    } else {
                        <-
                    }
                }
                if v1 <= v0 {
                    << -1
                }
                $n := 0
                $k := v0
                while k < v1 {
                    c := h[k] & 255
                    if c < 48 || c > 57 {
                        << -1
                    }
                    if n > (limit - (c - 48)) / 10 {
                        << -1
                    }
                    n = n * 10 + (c - 48)
                    if n > limit {
                        << -1
                    }
                    k = k + 1
                }
                << n
            }
        }
        i = line_end + 1
    }
    << -1
}

fn dial_addr_for_url(host0 string, https bool) string {
    host := host0 + ""
    if host.len == 0 {
        >>> errors.new("net/http: missing host")
    }
    if (host[0] & 255) == 91 {
        $hp := net.new_host_port()
        h2 := host + ""
        hp.split(h2)
        << host + ""
    }
    $has_port := false
    for i in 0:host.len {
        if (host[i] & 255) == 58 {
            has_port = true
            <-
        }
    }
    if has_port {
        << host + ""
    }
    if https {
        << (host + "") + ":443"
    }
    << (host + "") + ":80"
}

fn host_no_port(host0 string) string {
    host := host0 + ""
    $last := -1
    $i := 0
    while i < host.len {
        if (host[i] & 255) == 58 {
            last = i
        }
        i = i + 1
    }
    if last > 0 {
        << host[0:last]
    }
    << host + ""
}

fn build_request(method string, u &url.URL, body &string, extra string) string {
    $path := u.path()
    if path.len == 0 {
        path = "/"
    }
    q := u.raw_query()
    if q.len > 0 {
        path = path + "?" + q
    }
    host := u.host()
    $out := method + " " + path + " HTTP/1.1\r\n"
    out = out + "Host: " + host + "\r\n"
    out = out + "User-Agent: xu-net-http/1\r\n"
    out = out + "Accept: */*\r\n"
    if extra.len == 0 || !strings.contains(&extra, "Connection:") {
        out = out + "Connection: keep-alive\r\n"
    }
    if extra.len > 0 {
        out = out + extra
    }
    if method == "POST" || body.len > 0 {
        if !strings.contains(&extra, "Content-Type:") {
            out = out + "Content-Type: application/octet-stream\r\n"
        }
        out = out + "Content-Length: " + strconv.itoa(body.len) + "\r\n"
    }
    out = out + "\r\n"
    if body.len > 0 {
        out = out + body
    }
    << out
}

fn parse_status_line(line0 string) int {
    line := line0 + ""
    if !strings.has_prefix(&line, "HTTP/") {
        >>> errors.new("net/http: bad status line")
    }
    $sp1 := -1
    for i in 0:line.len {
        if (line[i] & 255) == 32 {
            sp1 = i
            <-
        }
    }
    if sp1 < 0 {
        >>> errors.new("net/http: bad status line")
    }
    $sp2 := -1
    for i in (sp1 + 1):line.len {
        if (line[i] & 255) == 32 {
            sp2 = i
            <-
        }
    }
    $code_s := ""
    if sp2 < 0 {
        code_s = line[(sp1 + 1):line.len]
    } else {
        code_s = line[(sp1 + 1):sp2]
    }
    if code_s.len != 3 {
        >>> errors.new("net/http: bad status code")
    }
    $code := 0
    for i in 0:3 {
        c := code_s[i] & 255
        if c < 48 || c > 57 {
            >>> errors.new("net/http: bad status code")
        }
        code = code * 10 + (c - 48)
    }
    << code
}

pub fn status_text(code int) string {
    if code == 200 {
        << "OK"
    }
    if code == 201 {
        << "Created"
    }
    if code == 204 {
        << "No Content"
    }
    if code == 206 {
        << "Partial Content"
    }
    if code == 404 {
        << "Not Found"
    }
    if code == 400 {
        << "Bad Request"
    }
    if code == 401 {
        << "Unauthorized"
    }
    if code == 416 {
        << "Range Not Satisfiable"
    }
    if code == 418 {
        << "I'm a teapot"
    }
    if code == 500 {
        << "Internal Server Error"
    }
    if code == 502 {
        << "Bad Gateway"
    }
    if code == 503 {
        << "Service Unavailable"
    }
    if code == 301 {
        << "Moved Permanently"
    }
    if code == 302 {
        << "Found"
    }
    if code == 303 {
        << "See Other"
    }
    if code == 304 {
        << "Not Modified"
    }
    if code == 307 {
        << "Temporary Redirect"
    }
    if code == 308 {
        << "Permanent Redirect"
    }
    if code == 403 {
        << "Forbidden"
    }
    if code == 405 {
        << "Method Not Allowed"
    }
    << "Status"
}

fn is_chunked(headers &string) bool {
    te := header_lookup(headers, "Transfer-Encoding")
    if te.len == 0 {
        << false
    }
    low := strings.to_lower(&te)
    $i := 0
    while i < low.len {
        while i < low.len {
            c := low[i] & 255
            if c != 32 && c != 9 && c != 44 {
                <-
            }
            i = i + 1
        }
        if i + 7 <= low.len {
            if low[i:(i + 7)] == "chunked" {
                << true
            }
        }
        while i < low.len {
            if (low[i] & 255) == 44 {
                <-
            }
            i = i + 1
        }
    }
    << false
}

fn parse_hex_size(s0 string) int {
    << parse_hex_size_limit(s0, MAX_MESSAGE_BYTES) >>>
}

fn parse_hex_size_limit(s0 string, limit int) int {
    s := s0 + ""
    $end := s.len
    for i in 0:s.len {
        if (s[i] & 255) == 59 {
            end = i
            <-
        }
    }
    if end == 0 {
        >>> errors.new("net/http: bad chunk size")
    }
    $n := 0
    for i in 0:end {
        c := s[i] & 255
        $v := -1
        if c >= 48 && c <= 57 {
            v = c - 48
        } else if c >= 97 && c <= 102 {
            v = c - 87
        } else if c >= 65 && c <= 70 {
            v = c - 55
        } else {
            >>> errors.new("net/http: bad chunk size")
        }
        if n > (limit - v) / 16 { >>> errors.new("net/http: chunk too large") }
        n = n * 16 + v
        if n > limit {
            >>> errors.new("net/http: chunk too large")
        }
    }
    << n
}

fn find_crlf_from(s &string, start int) int {
    $i := start
    if i < 0 { i = 0 }
    while i + 1 < s.len {
        p := find_byte(s, 13, i)
        if p < 0 || p + 1 >= s.len { << -1 }
        if (s[p + 1] & 255) == 10 {
            << p
        }
        i = p + 1
    }
    << -1
}

fn find_crlf_crlf_from(s &string, start int) int {
    $i := start
    if i < 0 { i = 0 }
    while i + 3 < s.len {
        p := find_byte(s, 13, i)
        if p < 0 || p + 3 >= s.len { << -1 }
        if (s[p + 1] & 255) == 10 && (s[p + 2] & 255) == 13 && (s[p + 3] & 255) == 10 {
            << p
        }
        i = p + 1
    }
    << -1
}

struct MsgBuf {
    data string
    fd int
    tls_h int
    tls_chan chan tls.Conn
    deadline_ns int
    max_bytes int
    progress DownloadProgress
}

fn (b &MsgBuf) message_limit() int {
    if b.max_bytes > core.MAX_STRING_PAYLOAD { << core.MAX_STRING_PAYLOAD }
    if b.max_bytes > 0 { << b.max_bytes }
    << MAX_MESSAGE_BYTES
}

// frame_end is the end offset of a known fixed-length message, or zero.
fn append_message_data(dst $&string, part &string, limit int, frame_end int) bool {
    if part.len > limit - dst.len { << false }
    // Leave room for the string terminator. Keep a smaller growth step for
    // unknown lengths, and reserve extra beyond a fixed frame only as needed.
    need := dst.len + part.len + 1
    $reserve := limit + 1
    if frame_end == 0 {
        current := core.string_buffer_size(dst)
        if need > current && current / 2 < reserve - current {
            reserve = current + current / 2
        }
    } else if frame_end < limit {
        reserve = frame_end + 1
    }
    if need > reserve { reserve = need }
    << core.string_append_bounded(dst, part, limit, reserve)
}

fn (b $&MsgBuf) read_more(frame_end int, discarded int) int {
    $chunk := ""
    if b.tls_h != 0 {
        $tc := <-b.tls_chan
        chunk = tc.read(READ_CHUNK_BYTES) >>> (err) {
            b.tls_chan <- tc
            >>> err
        }
        b.tls_chan <- tc
    } else {
        if b.deadline_ns > 0 {
            apply_http_deadline(b.fd, b.deadline_ns) >>>
        }
        chunk = net.conn_read(b.fd, READ_CHUNK_BYTES) >>>
    }
    if chunk.len == 0 {
        << 0
    }
    limit := b.message_limit() - discarded
    if !append_message_data($&b.data, &chunk, limit, frame_end) {
        >>> errors.new("net/http: message too large")
    }
    b.report_buffered_progress(false)
    << chunk.len
}

fn (b $&MsgBuf) discard_prefix(n int) {
    if n == 0 { << }
    if n == b.data.len {
        b.data = ""
    } else {
        b.data = b.data[n:b.data.len]
    }
}

fn (b $&MsgBuf) read_chunk_bytes(cursor $&int, discarded $&int) int {
    // Charge dropped bytes against the whole message's wire limit.
    b.discard_prefix(*cursor)
    *discarded += *cursor
    *cursor = 0
    << b.read_more(0, *discarded) >>>
}

fn (b $&MsgBuf) chunk_line_end(cursor $&int, discarded $&int, eof_error string) int {
    $scan := *cursor
    while true {
        end := find_crlf_from(&b.data, scan)
        if end >= 0 { << end }
        // After compaction, resume at the last pending byte so a CRLF
        // split across reads is still found.
        scan = b.data.len - *cursor
        if scan > 0 { scan -= 1 }
        if b.read_chunk_bytes(cursor, discarded) >>> == 0 {
            >>> errors.new(eof_error)
        }
    }
}

fn (b $&MsgBuf) finish_chunked(cursor $&int, discarded $&int) int {
    while true {
        end := b.chunk_line_end(cursor, discarded, "net/http: truncated chunk trailers") >>>
        empty := end == *cursor
        *cursor = end + 2
        if empty {
            b.discard_prefix(*cursor)
            << 0
        }
    }
}

fn (b $&MsgBuf) decode_chunked(body_start int) string {
    limit := b.message_limit()
    if b.data.len > limit { >>> errors.new("net/http: message too large") }
    $i := body_start
    $discarded := 0
    $out := ""
    for _ in 0:100000 {
        line_end := b.chunk_line_end($&i, $&discarded, "net/http: truncated chunk size") >>>
        size_line := b.data[i:line_end]
        size := parse_hex_size_limit(size_line, limit) >>>
        i = line_end + 2
        if size == 0 {
            b.finish_chunked($&i, $&discarded) >>>
            b.report_progress(out.len, true)
            << out
        }
        if size > limit - discarded - i - 2 {
            >>> errors.new("net/http: message too large")
        }
        $remaining := size
        while remaining > 0 {
            if i == b.data.len && (b.read_chunk_bytes($&i, $&discarded) >>>) == 0 {
                >>> errors.new("net/http: truncated chunk")
            }
            $take := b.data.len - i
            if take > remaining { take = remaining }
            part := b.data[i:(i + take)]
            if !append_message_data($&out, &part, limit, 0) {
                >>> errors.new("net/http: message too large")
            }
            i += take
            remaining -= take
            b.report_progress(out.len, false)
        }
        while b.data.len - i < 2 {
            if b.read_chunk_bytes($&i, $&discarded) >>> == 0 {
                >>> errors.new("net/http: truncated chunk")
            }
        }
        if (b.data[i] & 255) != 13 || (b.data[i + 1] & 255) != 10 {
            >>> errors.new("net/http: bad chunk CRLF")
        }
        i += 2
    }
    >>> errors.new("net/http: too many chunks")
}

fn read_http_message(fd int) string {
    << read_http_message_mode(fd, true, 0)
}

fn connection_wants_close(headers &string) bool {
    v := header_lookup(headers, "connection")
    if v.len == 0 {
        << false
    }
    $i := 0
    while i < v.len {
        $c := v[i] & 255
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        if c == 99 {
            if i + 5 <= v.len {
                $j := 0
                want := "close"
                $ok := true
                while j < 5 {
                    $ch := v[i + j] & 255
                    if ch >= 65 && ch <= 90 {
                        ch = ch + 32
                    }
                    if ch != (want[j] & 255) {
                        ok = false
                        <-
                    }
                    j = j + 1
                }
                if ok {
                    << true
                }
            }
        }
        i = i + 1
    }
    << false
}

fn read_http_message_buf(b $&MsgBuf, until_close bool) string {
    $header_end := -1
    $cl := -1
    $chunked := false
    for round in 0:256 {
        if header_end < 0 {
            header_end = find_crlf_crlf(&b.data)
            if header_end >= 0 {
                hdr := b.data[0:header_end]
                cl = parse_content_length_limit(&hdr, b.message_limit())
                chunked = is_chunked(&hdr)
                if chunked {
                    cl = -1
                }
                b.start_progress(header_end, cl, chunked)
            }
        }
        if header_end >= 0 {
            <-
        }
        n_r := b.read_more(0, 0)
        if n_r == 0 {
            <-
        }
        if round > MAX_READ_ITERATIONS {
            <-
        }
    }
    if header_end < 0 {
        >>> errors.new("net/http: incomplete headers")
    }
    head := b.data[0:header_end]
    if chunked {
        body_r := b.decode_chunked(header_end + 4)
        body := body_r
        msg := head + "\r\n\r\n" + body
        << msg
    }
    if cl >= 0 {
        need := header_end + 4 + cl
        while b.data.len < need {
            n_r2 := b.read_more(need, 0)
            if n_r2 == 0 {
                >>> errors.new("net/http: truncated body")
            }
        }
        b.report_buffered_progress(true)
        msg := b.data[0:need] + ""
        if b.data.len > need {
            b.data = b.data[need:b.data.len]
        } else {
            b.data = ""
        }
        << msg
    }
    if until_close {
        $ended := false
        for round in 0:MAX_READ_ITERATIONS {
            if b.read_more(0, 0) == 0 {
                ended = true
                <-
            }
        }
        if !ended { >>> errors.new("net/http: too many reads") }
    }
    b.report_buffered_progress(true)
    msg2 := b.data + ""
    b.data = ""
    << msg2
}

// until_close: response-shaped (no Content-Length means read until eof).
// Requests without Content-Length / chunked encoding have an empty body
// (RFC 7230) and must not block waiting for the client to close.
fn read_http_message_mode(fd int, until_close bool, tls_h int) string {
    $b := MsgBuf{data: "", fd: fd, tls_h: tls_h, tls_chan: chan tls.Conn{cap: 1}, deadline_ns: 0, max_bytes: 0, progress: download_progress(no_download_progress)}
    << read_http_message_buf($&b, until_close) >>> (err) {
        << ""
    }
}

fn (r $&Response) fill_from_message(msg0 string) int {
    << r.fill_from_message_limit(msg0, MAX_MESSAGE_BYTES) >>>
}

fn (r $&Response) fill_from_message_limit(msg0 string, limit int) int {
    msg := msg0 + ""
    header_end := find_crlf_crlf(&msg)
    if header_end < 0 {
        >>> errors.new("net/http: incomplete response headers")
    }
    head := msg[0:header_end]
    $body := msg[(header_end + 4):msg.len]
    cl := parse_content_length_limit(&head, limit)
    if cl >= 0 {
        if body.len < cl {
            >>> errors.new("net/http: truncated body")
        }
        if body.len > cl {
            body = body[0:cl]
        }
    }
    $line_end := 0
    while line_end < head.len {
        if (head[line_end] & 255) == 10 {
            <-
        }
        line_end = line_end + 1
    }
    $status_line := head[0:line_end]
    if status_line.len > 0 && (status_line[status_line.len - 1] & 255) == 13 {
        status_line = status_line[0:(status_line.len - 1)]
    }
    code_r := parse_status_line(status_line + "")
    $hdrs := ""
    if line_end + 1 < head.len {
        hdrs = head[(line_end + 1):head.len]
    }
    r.status_code = code_r
    r.status = status_line + ""
    r.headers = hdrs + ""
    r.body = body + ""
    << 0
}

fn set_cookie_lines(headers &string) []string {
    key := "set-cookie"
    $out := []string{}
    $i := 0
    h := headers + ""
    while i < h.len {
        $line_end := i
        while line_end < h.len {
            if (h[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        $line := h[i:line_end]
        if line.len > 0 && (line[line.len - 1] & 255) == 13 {
            line = line[0:(line.len - 1)]
        }
        $colon := -1
        for j in 0:line.len {
            if (line[j] & 255) == 58 {
                colon = j
                <-
            }
        }
        if colon > 0 {
            name := line[0:colon]
            low := strings.to_lower(&name)
            if low == key {
                rest := line[(colon + 1):line.len]
                out.push(strings.trim_space(&rest))
            }
        }
        i = line_end + 1
    }
    << out
}

fn exchange(https bool, addr string, sni string, req string) string {
    << exchange_once(https, addr, sni, req)
}

fn exchange_once(https bool, addr string, sni string, req string) string {
    << exchange_deadline(https, addr, sni, req, 0) >>>
}

fn exchange_deadline(https bool, addr string, sni string, req string, deadline_ns int) string {
    << exchange_deadline_limit(https, addr, sni, req, deadline_ns, 0, no_download_progress) >>>
}

fn exchange_deadline_limit(https bool, addr string, sni string, req string, deadline_ns int, max_bytes int, report fn(int, int)) string {
    if https {
        $cfg := tls.new_config(sni)
        // This transport speaks HTTP/1.1; advertising h2 makes compliant
        // servers expect an HTTP/2 preface and reject these request bytes.
        cfg.set_next_protos(["http/1.1"])
        remaining := http_remaining(deadline_ns) >>>
        $nc := net.dial_timeout("tcp", addr, remaining) >>>
        nc.set_deadline(deadline_ns)
        $tc := tls.client(nc, &cfg) >>> (err) {
            http_remaining(deadline_ns) >>>
            >>> err
        }
        // The underlying net.Conn also carries the deadline, so each TLS
        // record read/write (including handshake I/O) uses remaining time.
        tc.set_deadline(deadline_ns)
        tc.write(&req) >>> (err) {
            http_remaining(deadline_ns) >>>
            >>> err
        }
        $ch := chan tls.Conn{cap: 1}
        ch <- tc
        $b := MsgBuf{data: "", fd: -1, tls_h: 1, tls_chan: ch, deadline_ns: deadline_ns, max_bytes: max_bytes, progress: download_progress(report)}
        msg := read_http_message_buf($&b, true) >>> (err) {
            $t := <-ch
            _ := t.close()
            http_remaining(deadline_ns) >>>
            >>> err
        }
        $t := <-ch
        t.close() >>> (err) {
            http_remaining(deadline_ns) >>>
            << msg + ""
        }
        http_remaining(deadline_ns) >>>
        << msg
    }
    remaining := http_remaining(deadline_ns) >>>
    fd := net.dial_ns(addr, remaining) >>>
    msg := exchange_http_fd_limit(fd, req, "", deadline_ns, max_bytes, report) >>> (err) {
        close_http_fd(fd)
        http_remaining(deadline_ns) >>>
        >>> err
    }
    close_http_fd(fd)
    << msg.data
}

fn (c $&Client) close_idle() {
    if c.idle_fd >= 0 {
        fd := c.idle_fd
        c.idle_fd = -1
        c.idle_buf = ""
        c.idle_addr = ""
        c.idle_https = 0
        net.conn_close(fd) >>> (err) { << }
    }
    c.idle_buf = ""
    c.idle_addr = ""
    c.idle_sni = ""
    c.idle_https = 0
    select {
        tc := <-c.idle_tls {
            $t := tc
            t.close() >>> (err) { << }
        }
        else {
            <<
        }
    }
}

fn (c $&Client) exchange_https(addr string, sni string, req string, deadline_ns int, retry_safe bool) string {
    $leftover := ""
    $reused := false
    $tc := tls.closed_conn()
    if c.idle_https != 0 && c.idle_addr == addr && c.idle_sni == sni {
        select {
            conn := <-c.idle_tls {
                tc = conn
                leftover = c.idle_buf + ""
                c.idle_buf = ""
                reused = true
            }
            else {
                reused = false
            }
        }
    }
    if !reused {
        c.close_idle()
        $cfg := tls.new_config(sni)
        cfg.insecure_skip_verify = c.insecure_skip_verify
        cfg.set_next_protos(["http/1.1"])
        remaining := http_remaining(deadline_ns) >>>
        $nc := net.dial_timeout("tcp", addr, remaining) >>>
        nc.set_deadline(deadline_ns)
        tc = tls.client(nc, &cfg) >>> (err) {
            http_remaining(deadline_ns) >>>
            >>> err
        }
    }
    tc.set_deadline(deadline_ns)
    tc.write(&req) >>> (err) {
        $t := tc
        _ := t.close()
        http_remaining(deadline_ns) >>>
        if reused && retry_safe {
            << c.exchange_https(addr, sni, req, deadline_ns, false) >>>
        }
        >>> err
    }
    $ch := chan tls.Conn{cap: 1}
    ch <- tc
    $b := MsgBuf{data: leftover, fd: -1, tls_h: 1, tls_chan: ch, deadline_ns: deadline_ns, max_bytes: c.max_response_bytes, progress: download_progress(c.progress)}
    msg := read_http_message_buf($&b, true) >>> (err) {
        $t := <-ch
        _ := t.close()
        http_remaining(deadline_ns) >>>
        if reused && retry_safe {
            << c.exchange_https(addr, sni, req, deadline_ns, false) >>>
        }
        >>> err
    }
    $tc_back := <-ch
    header_end := find_crlf_crlf(&msg)
    $hdrs := ""
    if header_end >= 0 {
        hdrs = msg[0:header_end]
    }
    if connection_wants_close(&hdrs) {
        $t := tc_back
        _ := t.close()
        << msg
    }
    c.idle_https = 1
    c.idle_addr = addr + ""
    c.idle_sni = sni + ""
    c.idle_buf = b.data + ""
    c.idle_tls <- tc_back
    << msg
}

fn (c $&Client) exchange_http(addr string, req string, deadline_ns int, retry_safe bool) string {
    $fd := -1
    $leftover := ""
    $reused := false
    if c.idle_fd >= 0 && c.idle_https == 0 && c.idle_addr == addr {
        fd = c.idle_fd
        leftover = c.idle_buf + ""
        c.idle_fd = -1
        c.idle_buf = ""
        reused = true
    }
    if fd < 0 {
        c.close_idle()
        remaining := http_remaining(deadline_ns) >>>
        fd = net.dial_ns(addr, remaining) >>>
    }
    result := exchange_http_fd_limit(fd, req + "", leftover, deadline_ns, c.max_response_bytes, c.progress) >>> (err) {
        close_http_fd(fd)
        http_remaining(deadline_ns) >>>
        // Retry a stale idle connection once, only for GET/HEAD. The
        // absolute deadline stays unchanged and a POST is never replayed.
        if reused && retry_safe {
            << c.exchange_http(addr, req, deadline_ns, false) >>>
        }
        >>> err
    }
    msg := result.data + ""
    header_end := find_crlf_crlf(&msg)
    $hdrs := ""
    if header_end >= 0 {
        hdrs = msg[0:header_end]
    }
    if connection_wants_close(&hdrs) {
        close_http_fd(fd)
        << msg
    }
    c.idle_fd = fd
    c.idle_https = 0
    c.idle_addr = addr + ""
    c.idle_buf = result.leftover + ""
    << msg
}

fn (r $&Response) do_request_ex(method string, raw_url string, body &string, extra string) int {
    r.status_code = 0
    r.status = ""
    r.headers = ""
    r.body = ""
    r.sticky = ""
    $u := url.new_url()
    u.parse(raw_url)
    scheme := u.scheme()
    https := scheme == "https"
    if scheme != "http" && !https {
        >>> errors.new("net/http: unsupported scheme")
    }
    host := u.host()
    if host.len == 0 {
        >>> errors.new("net/http: missing host")
    }
    h := host + ""
    addr := dial_addr_for_url(h + "", https)
    sni := host_no_port(h)
    req := build_request(method, &u, body, extra)
    msg := exchange(https, addr, sni, req) >>>
    << r.fill_from_message(msg + "")
}

fn (c $&Client) do_exchange(https bool, addr string, sni string, req string, deadline_ns int, retry_safe bool) string {
    if https {
        << c.exchange_https(addr, sni, req, deadline_ns, retry_safe) >>>
    }
    << c.exchange_http(addr, req, deadline_ns, retry_safe) >>>
}

fn (r $&Response) do_request(method string, raw_url string, body &string) int {
    << r.do_request_ex(method, raw_url, body, "") >>>
}

pub fn (r $&Response) get(url string) int {
    empty := ""
    << r.do_request("GET", url, &empty) >>>
}

pub fn (r $&Response) post(url string, body &string) int {
    << r.do_request("POST", url, body) >>>
}

pub fn (r Response) cookies() []Cookie {
    lines := set_cookie_lines(&r.headers)
    $out := []Cookie{}
    $i := 0
    while i < lines.len {
        ln := lines[i] + ""
        ck := parse_set_cookie(&ln) >>> (err) {
            i = i + 1
            ->
        }
        out.push(ck)
        i = i + 1
    }
    << out
}

pub struct Client {
    pub jar cookiejar.Jar
    pub jar_on int
    idle_fd int
    idle_https int
    idle_addr string
    idle_buf string
    idle_sni string
    idle_tls chan tls.Conn
    pub insecure_skip_verify bool
    // One budget for HTTP/TLS I/O and redirects; 0 disables it. Synchronous
    // DNS and Linux TCP connect still need cancellable platform adapters.
    pub timeout_ns int
    // Negative returns redirect responses unchanged; zero uses the default 10.
    pub max_redirects int
    // Positive overrides the default 10 MiB buffered response limit, including headers.
    pub max_response_bytes int
    progress fn(int, int)
}

pub fn new_client() Client {
    << Client{jar: cookiejar.new_jar(), jar_on: 0, idle_fd: -1, idle_https: 0, idle_addr: "", idle_buf: "", idle_sni: "", idle_tls: chan tls.Conn{cap: 1}, insecure_skip_verify: false, timeout_ns: 0, max_redirects: 10, max_response_bytes: 0, progress: no_download_progress}
}

pub fn (c $&Client) set_jar(j cookiejar.Jar) {
    c.jar = j
    c.jar_on = 1
}

pub fn (c $&Client) set_timeout(ns int) {
    c.timeout_ns = ns
}

fn cookie_list(j &cookiejar.Jar, u &url.URL) []cookiejar.Cookie {
    << j.cookies(u)
}

fn ingest_cookies(j $&cookiejar.Jar, u &url.URL, headers &string) {
    lines := set_cookie_lines(headers)
    $i := 0
    while i < lines.len {
        ln := lines[i] + ""
        ck := parse_set_cookie(&ln) >>> (err) {
            i = i + 1
            ->
        }
        jc := cookiejar.Cookie{name: ck.name + "", value: ck.value + "", path: ck.path + "", domain: ck.domain + "", secure: ck.secure, http_only: ck.http_only, max_age: ck.max_age}
        j.set_cookie(u, jc)
        i = i + 1
    }
}

fn (c $&Client) do_once(method string, raw_url string, body &string, extra0 string, deadline_ns int) Response {
    http_remaining(deadline_ns) >>>
    url0 := raw_url + ""
    $u := url.new_url()
    u.parse(url0 + "") >>>
    $extra := extra0 + ""
    if c.jar_on != 0 {
        cs := cookie_list(&c.jar, &u)
        ch := cookiejar.cookie_header(&cs)
        if ch.len > 0 {
            extra = extra + "Cookie: " + ch + "\r\n"
        }
    }
    $r := new_response()
    r.status_code = 0
    r.status = ""
    r.headers = ""
    r.body = ""
    r.sticky = ""
    scheme := u.scheme()
    https := scheme == "https"
    if scheme != "http" && !https {
        >>> errors.new("net/http: unsupported scheme")
    }
    host := u.host()
    if host.len == 0 {
        >>> errors.new("net/http: missing host")
    }
    h := host + ""
    addr := dial_addr_for_url(h + "", https)
    sni := host_no_port(h)
    retry_safe := method == "GET" || method == "HEAD"
    req := build_request(method, &u, body, extra)
    msg := c.do_exchange(https, addr, sni, req, deadline_ns, retry_safe) >>>
    $limit := MAX_MESSAGE_BYTES
    if c.max_response_bytes > 0 { limit = c.max_response_bytes }
    r.fill_from_message_limit(msg + "", limit) >>>
    if c.jar_on != 0 {
        ingest_cookies($&c.jar, &u, &r.headers)
    }
    http_remaining(deadline_ns) >>>
    << r
}

pub fn (c $&Client) do_extra(method string, raw_url string, extra string, body &string) Response {
    m := method + ""
    u := raw_url + ""
    deadline_ns := http_deadline(c.timeout_ns) >>>
    r := c.do_once(m + "", u + "", body, extra, deadline_ns) >>> (err) {
        c.close_idle()
        >>> err
    }
    << c.follow_redirects(m + "", u + "", body, r, deadline_ns) >>> (err) {
        c.close_idle()
        >>> err
    }
}

pub fn (c $&Client) get_extra(raw_url string, extra string) Response {
    empty := ""
    << c.do_extra("GET", raw_url, extra, &empty) >>>
}

pub fn (c $&Client) do(method string, raw_url string, body &string) Response {
    << c.do_extra(method, raw_url, "", body) >>>
}

pub fn (c $&Client) get(raw_url string) Response {
    empty := ""
    << c.do("GET", raw_url, &empty) >>>
}

pub fn (c $&Client) post(raw_url string, body &string) Response {
    << c.do("POST", raw_url, body) >>>
}

pub fn (c $&Client) post_form(raw_url string, data &url.Query) Response {
    body := data.encode()
    extra := "Content-Type: application/x-www-form-urlencoded\r\n"
    deadline_ns := http_deadline(c.timeout_ns) >>>
    r := c.do_once("POST", raw_url + "", &body, extra, deadline_ns) >>> (err) {
        c.close_idle()
        >>> err
    }
    << r
}

pub fn (req $&Request) read(fd int) int {
    << req.read_timeout(fd, 0) >>>
}

// read_timeout applies one absolute budget to all headers and body reads.
// A zero timeout preserves the caller-owned blocking read contract.
pub fn (req $&Request) read_timeout(fd int, timeout_ns int) int {
    deadline := http_deadline(timeout_ns) >>>
    $b := MsgBuf{data: "", fd: fd, tls_h: 0, tls_chan: chan tls.Conn{cap: 1}, deadline_ns: deadline, max_bytes: 0, progress: download_progress(no_download_progress)}
    msg := read_http_message_buf($&b, false) >>>
    << req.parse_message(&msg) >>>
}

fn buffered_request(data string) Request {
    $b := MsgBuf{data: data, fd: -1, tls_h: 0, tls_chan: chan tls.Conn{cap: 1}, deadline_ns: 0, max_bytes: 0, progress: download_progress(no_download_progress)}
    msg := read_http_message_buf($&b, false) >>>
    $req := new_request()
    req.parse_message(&msg) >>>
    << req
}

fn (req $&Request) parse_message(msg &string) int {
    req.method = ""
    req.path = ""
    req.headers = ""
    req.body = ""
    req.sticky = ""
    header_end := find_crlf_crlf(msg)
    if header_end < 0 {
        >>> errors.new("net/http: incomplete request headers")
    }
    head := msg[0:header_end]
    $body := msg[(header_end + 4):msg.len]
    cl := parse_content_length(&head)
    if cl >= 0 {
        if body.len < cl {
            >>> errors.new("net/http: truncated body")
        }
        if body.len > cl {
            body = body[0:cl]
        }
    }
    $line_end := 0
    while line_end < head.len {
        if (head[line_end] & 255) == 10 {
            <-
        }
        line_end = line_end + 1
    }
    $req_line := head[0:line_end]
    if req_line.len > 0 && (req_line[req_line.len - 1] & 255) == 13 {
        req_line = req_line[0:(req_line.len - 1)]
    }
    $sp1 := -1
    $sp2 := -1
    for i in 0:req_line.len {
        if (req_line[i] & 255) == 32 {
            if sp1 < 0 {
                sp1 = i
            } else {
                sp2 = i
                <-
            }
        }
    }
    if sp1 <= 0 || sp2 < 0 {
        >>> errors.new("net/http: bad request line")
    }
    method := req_line[0:sp1]
    path := req_line[(sp1 + 1):sp2]
    $hdrs := ""
    if line_end + 1 < head.len {
        hdrs = head[(line_end + 1):head.len]
    }
    req.method = method
    req.path = path
    req.headers = hdrs
    req.body = body
    << 0
}

pub fn write_response(fd int, status_code int, body &string) int {
    << write(fd, status_code, "text/plain", body) >>>
}

// write is the typed-body form of a one-shot HTTP/1.1 response
// (Go http.ResponseWriter WriteHeader+Write, Connection: close).
pub fn write(fd int, status_code int, content_type string, body &string) int {
    << write_n(fd, status_code, content_type, "", body, true)
}

fn write_n(fd int, status_code int, content_type string, extra string, body &string, send_body bool) int {
    << write_n_mode(fd, status_code, content_type, extra, body, send_body, false) >>>
}

fn response_header_bytes(status_code int, content_type string, extra string, length int, keep_alive bool) string {
    if status_code == 200 && extra.len == 0 {
        $ctype := content_type + ""
        if ctype.len == 0 {
            ctype = "application/octet-stream"
        }
        if ctype == "text/plain; charset=utf-8" {
            if keep_alive {
                << "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: " + strconv.itoa(length) + "\r\nConnection: keep-alive\r\n\r\n"
            }
            << "HTTP/1.1 200 OK\r\nContent-Type: text/plain; charset=utf-8\r\nContent-Length: " + strconv.itoa(length) + "\r\nConnection: close\r\n\r\n"
        }
        $conn := "\r\nConnection: close\r\n\r\n"
        if keep_alive {
            conn = "\r\nConnection: keep-alive\r\n\r\n"
        }
        << "HTTP/1.1 200 OK\r\nContent-Type: " + ctype + "\r\nContent-Length: " + strconv.itoa(length) + conn
    }
    reason := status_text(status_code)
    $ctype := content_type + ""
    if ctype.len == 0 {
        ctype = "application/octet-stream"
    }
    $conn := "Connection: close\r\n\r\n"
    if keep_alive {
        conn = "Connection: keep-alive\r\n\r\n"
    }
    if extra.len == 0 {
        << "HTTP/1.1 " + strconv.itoa(status_code) + " " + reason + "\r\nContent-Type: " + ctype + "\r\nContent-Length: " + strconv.itoa(length) + "\r\n" + conn
    }
    extra_clean := response_extra_without_connection(extra)
    << "HTTP/1.1 " + strconv.itoa(status_code) + " " + reason + "\r\nContent-Type: " + ctype + "\r\nContent-Length: " + strconv.itoa(length) + "\r\n" + extra_clean + conn
}

fn write_response_data(fd int, data &string) int {
    if data.len == 0 { << 0 }
    $sent := net.conn_write(fd, data) >>>
    if sent <= 0 || sent > data.len { >>> errors.new("net/http: invalid write progress") }
    while sent < data.len {
        part := data[sent:data.len]
        n := net.conn_write(fd, &part) >>>
        if n <= 0 || n > part.len { >>> errors.new("net/http: invalid write progress") }
        sent += n
    }
    << sent
}

// Server contexts use this form to match response framing to the request's
// HTTP/1.x persistence rules. Public write helpers remain one-shot.
fn write_n_mode(fd int, status_code int, content_type string, extra string, body &string, send_body bool, keep_alive bool) int {
    if fd < 0 { >>> errors.new("net/http: bad fd") }
    head := response_header_bytes(status_code, content_type, extra, body.len, keep_alive)
    if !send_body || body.len == 0 { << write_response_data(fd, &head) >>> }
    if body.len <= 4096 {
        packet := head + body
        << write_response_data(fd, &packet) >>>
    }
    sent_head := write_response_data(fd, &head) >>>
    sent_body := write_response_data(fd, body) >>>
    << sent_head + sent_body
}

fn response_extra_without_connection(extra string) string {
    x := extra + ""
    connection := "Connection"
    $out := ""
    $start := 0
    while start < x.len {
        $end := find_crlf_from(&x, start)
        if end < 0 { end = x.len }
        $colon := -1
        for i in start:end {
            if (x[i] & 255) == 58 { colon = i
                <- }
        }
        if colon < 0 || !header_key_eq(&x, start, colon, &connection) {
            line := x[start:end]
            out = out + line + "\r\n"
        }
        if end >= x.len { <- }
        start = end + 2
    }
    << out
}

fn response_extra_closes(extra &string) bool {
    if extra.len == 0 { << false }
    connection := "Connection"
    $start := 0
    while start < extra.len {
        $end := find_crlf_from(extra, start)
        if end < 0 { end = extra.len }
        $colon := -1
        for i in start:end {
            if (extra[i] & 255) == 58 { colon = i
                <- }
        }
        if colon >= 0 && header_key_eq(extra, start, colon, &connection) {
            value := extra[(colon + 1):end]
            parts := strings.split(&value, ",")
            for i in 0:parts.len {
                part := strings.trim_space(&parts[i])
                lowered := strings.to_lower(&part)
                if lowered == "close" { << true }
            }
        }
        if end >= extra.len { <- }
        start = end + 2
    }
    << false
}

fn (c $&Client) drop() { c.close_idle() }

pub fn (c &Client) has_idle_connection() bool {
    if c.idle_fd >= 0 {
        << true
    }
    << c.idle_https != 0
}

pub fn (c $&Client) close_idle_connections() { c.close_idle() }
