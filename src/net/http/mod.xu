@net/http


#errors
// net.http — HTTP/1.1 client + server helpers (Go `net/http` subset).
// Client: GET/POST over IPv4 TCP; HTTPS via crypto/tls.Dial.
// Cookie jar: net/http/cookiejar (Go CookieJar).
// Server: Request.read + write / FileServer / Context handler.
// There is no ServeMux value in this version; route dispatch is supplied by
// the caller's handler function.
// Client keep-alive reuses one idle HTTP (not HTTPS) connection per Client.
// No HTTP/2.

#net
#net/url
#strconv
#strings
#crypto/tls
#net/http/cookiejar

pub struct Response {
    pub status_code int
    pub status string
    pub headers string
    pub body string
    pub sticky string
}

pub fn new_response() Response {
    << Response{status_code: 0, status: "", headers: "", body: "", sticky: ""}
}

pub fn (r Response) status_code() int {
    << r.status_code
}

pub fn (r Response) status() string {
    << r.status + ""
}

pub fn (r Response) body() string {
    << r.body + ""
}

pub fn (r Response) header(name string) string {
    << header_lookup(&r.headers, name)
}

pub struct Request {
    pub method string
    pub path string
    pub headers string
    pub body string
    pub sticky string
}

pub fn new_request() Request {
    << Request{method: "", path: "", headers: "", body: "", sticky: ""}
}

pub fn (r Request) method() string {
    << r.method + ""
}

pub fn (r Request) path() string {
    << r.path + ""
}

pub fn (r Request) body() string {
    << r.body + ""
}

pub fn (r Request) header(name string) string {
    << header_lookup(&r.headers, name)
}

pub fn (r Request) user_agent() string {
    << r.header("User-Agent")
}

pub fn (r Request) host() string {
    << r.header("Host")
}

pub struct Server {
    pub lfd int
}

pub fn new_server() Server {
    << Server{lfd: -1}
}

pub fn (s &mut Server) listen(addr string) int {
    if addr.len == 0 {
        >> errors.new("net/http: empty address")
    }
    s.lfd = net.listen(addr) or >>
    << 0
}

pub fn (s Server) accept() int {
    if s.lfd < 0 {
        >> errors.new("net/http: not listening")
    }
    << net.accept(s.lfd)
}

pub fn (s &mut Server) close() int {
    if s.lfd < 0 {
        << 0
    }
    net.conn_close(s.lfd) or (err) {
        s.lfd = -1
        << 1
    }
    s.lfd = -1
    << 0
}

fn header_lookup(headers &string, name string) string {
    // Keep a local owning view before indexed access. The bootstrap backend
    // cannot safely index a borrowed string through a non-zero offset on all
    // optimization tiers; this clone is bounded by the 10 MiB message cap and
    // preserves correctness while retaining allocation-free key/value scans.
    h := headers + ""
    hlen := h.len
    mut i := 0
    while i < hlen {
        mut line_end := i
        while line_end < hlen {
            if (h[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        mut line_last := line_end
        if line_last > i {
            if (h[line_last - 1] & 255) == 13 {
                line_last = line_last - 1
            }
        }
        mut colon := -1
        mut j := i
        while j < line_last {
            if (h[j] & 255) == 58 {
                colon = j
                <-
            }
            j = j + 1
        }
        if colon > i {
            if header_key_eq(&h, i, colon, &name) {
                mut v0 := colon + 1
                mut v1 := line_last
                while v0 < v1 {
                    c := h[v0] & 255
                    if c == 32 || c == 9 {
                        v0 = v0 + 1
                    } else {
                        <-
                    }
                }
                while v1 > v0 {
                    c := h[v1 - 1] & 255
                    if c == 32 || c == 9 {
                        v1 = v1 - 1
                    } else {
                        <-
                    }
                }
                if v1 > v0 {
                    << h[v0:v1]
                }
                << ""
            }
        }
        i = line_end + 1
    }
    << ""
}

fn find_crlf_crlf(s &string) int {
    n := s.len
    mut i := 0
    while i + 3 < n {
        if (s[i] & 255) != 13 {
            i = i + 1
            ->
        }
        if (s[i + 1] & 255) == 10 {
            if (s[i + 2] & 255) == 13 {
                if (s[i + 3] & 255) == 10 {
                    << i
                }
            }
        }
        i = i + 1
    }
    << -1
}

fn parse_content_length(headers &string) int {
    cl := "content-length"
    h := headers + ""
    hlen := h.len
    mut i := 0
    while i < hlen {
        mut line_end := i
        while line_end < hlen {
            if (h[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        mut line_last := line_end
        if line_last > i {
            if (h[line_last - 1] & 255) == 13 {
                line_last = line_last - 1
            }
        }
        mut colon := -1
        mut j := i
        while j < line_last {
            if (h[j] & 255) == 58 {
                colon = j
                <-
            }
            j = j + 1
        }
        if colon > i {
            if header_key_eq(&h, i, colon, &cl) {
                mut v0 := colon + 1
                mut v1 := line_last
                while v0 < v1 {
                    c := h[v0] & 255
                    if c == 32 || c == 9 {
                        v0 = v0 + 1
                    } else {
                        <-
                    }
                }
                while v1 > v0 {
                    c := h[v1 - 1] & 255
                    if c == 32 || c == 9 {
                        v1 = v1 - 1
                    } else {
                        <-
                    }
                }
                if v1 <= v0 {
                    << -1
                }
                mut n := 0
                mut k := v0
                while k < v1 {
                    c := h[k] & 255
                    if c < 48 || c > 57 {
                        << -1
                    }
                    n = n * 10 + (c - 48)
                    if n > 10485760 {
                        << -1
                    }
                    k = k + 1
                }
                << n
            }
        }
        i = line_end + 1
    }
    << -1
}

fn dial_addr_for_url(host0 string, https bool) string {
    host := host0 + ""
    if host.len == 0 {
        >> errors.new("net/http: missing host")
    }
    if (host[0] & 255) == 91 {
        mut hp := net.new_host_port()
        h2 := host + ""
        hp.split(h2)
        << host + ""
    }
    mut has_port := false
    for i in 0:host.len {
        if (host[i] & 255) == 58 {
            has_port = true
            <-
        }
    }
    if has_port {
        << host + ""
    }
    if https {
        << (host + "") + ":443"
    }
    << (host + "") + ":80"
}

fn host_no_port(host0 string) string {
    host := host0 + ""
    mut last := -1
    mut i := 0
    while i < host.len {
        if (host[i] & 255) == 58 {
            last = i
        }
        i = i + 1
    }
    if last > 0 {
        << host[0:last]
    }
    << host + ""
}

fn build_request(method string, u &url.URL, body &string, extra string) string {
    mut path := u.path()
    if path.len == 0 {
        path = "/"
    }
    q := u.raw_query()
    if q.len > 0 {
        path = path + "?" + q
    }
    host := u.host()
    mut out := method + " " + path + " HTTP/1.1\r\n"
    out = out + "Host: " + host + "\r\n"
    out = out + "User-Agent: xu-net-http/1\r\n"
    out = out + "Accept: */*\r\n"
    if extra.len == 0 || !strings.contains(&extra, "Connection:") {
        out = out + "Connection: keep-alive\r\n"
    }
    if extra.len > 0 {
        out = out + extra
    }
    if method == "POST" || body.len > 0 {
        out = out + "Content-Type: application/octet-stream\r\n"
        out = out + "Content-Length: " + strconv.itoa(body.len) + "\r\n"
    }
    out = out + "\r\n"
    if body.len > 0 {
        out = out + body
    }
    << out
}

fn parse_status_line(line0 string) int {
    line := line0 + ""
    if !strings.has_prefix(&line, "HTTP/") {
        >> errors.new("net/http: bad status line")
    }
    mut sp1 := -1
    for i in 0:line.len {
        if (line[i] & 255) == 32 {
            sp1 = i
            <-
        }
    }
    if sp1 < 0 {
        >> errors.new("net/http: bad status line")
    }
    mut sp2 := -1
    for i in (sp1 + 1):line.len {
        if (line[i] & 255) == 32 {
            sp2 = i
            <-
        }
    }
    mut code_s := ""
    if sp2 < 0 {
        code_s = line[(sp1 + 1):line.len]
    } else {
        code_s = line[(sp1 + 1):sp2]
    }
    if code_s.len != 3 {
        >> errors.new("net/http: bad status code")
    }
    mut code := 0
    for i in 0:3 {
        c := code_s[i] & 255
        if c < 48 || c > 57 {
            >> errors.new("net/http: bad status code")
        }
        code = code * 10 + (c - 48)
    }
    << code
}

pub fn status_text(code int) string {
    if code == 200 {
        << "OK"
    }
    if code == 201 {
        << "Created"
    }
    if code == 204 {
        << "No Content"
    }
    if code == 404 {
        << "Not Found"
    }
    if code == 400 {
        << "Bad Request"
    }
    if code == 401 {
        << "Unauthorized"
    }
    if code == 418 {
        << "I'm a teapot"
    }
    if code == 500 {
        << "Internal Server Error"
    }
    if code == 301 {
        << "Moved Permanently"
    }
    if code == 302 {
        << "Found"
    }
    if code == 303 {
        << "See Other"
    }
    if code == 307 {
        << "Temporary Redirect"
    }
    if code == 308 {
        << "Permanent Redirect"
    }
    if code == 403 {
        << "Forbidden"
    }
    if code == 405 {
        << "Method Not Allowed"
    }
    << "Status"
}

fn is_chunked(headers &string) bool {
    te := header_lookup(headers, "Transfer-Encoding")
    if te.len == 0 {
        << false
    }
    low := strings.to_lower(&te)
    mut i := 0
    while i < low.len {
        while i < low.len {
            c := low[i] & 255
            if c != 32 && c != 9 && c != 44 {
                <-
            }
            i = i + 1
        }
        if i + 7 <= low.len {
            if low[i:(i + 7)] == "chunked" {
                << true
            }
        }
        while i < low.len {
            if (low[i] & 255) == 44 {
                <-
            }
            i = i + 1
        }
    }
    << false
}

fn parse_hex_size(s0 string) int {
    s := s0 + ""
    mut end := s.len
    for i in 0:s.len {
        if (s[i] & 255) == 59 {
            end = i
            <-
        }
    }
    if end == 0 {
        >> errors.new("net/http: bad chunk size")
    }
    mut n := 0
    for i in 0:end {
        c := s[i] & 255
        mut v := -1
        if c >= 48 && c <= 57 {
            v = c - 48
        } else if c >= 97 && c <= 102 {
            v = c - 87
        } else if c >= 65 && c <= 70 {
            v = c - 55
        } else {
            >> errors.new("net/http: bad chunk size")
        }
        n = n * 16 + v
        if n > 10485760 {
            >> errors.new("net/http: chunk too large")
        }
    }
    << n
}

fn find_crlf_from(s &string, start int) int {
    mut i := start
    while i + 1 < s.len {
        if (s[i] & 255) == 13 && (s[i + 1] & 255) == 10 {
            << i
        }
        i = i + 1
    }
    << -1
}

fn find_crlf_crlf_from(s &string, start int) int {
    mut i := start
    while i + 3 < s.len {
        if (s[i] & 255) == 13 && (s[i + 1] & 255) == 10 && (s[i + 2] & 255) == 13 && (s[i + 3] & 255) == 10 {
            << i
        }
        i = i + 1
    }
    << -1
}

struct MsgBuf {
    data string
    fd int
    tls_h int
    tls_conn tls.Conn
    deadline_ns int
}

fn (b &mut MsgBuf) read_more() int {
    mut chunk := ""
    if b.tls_h != 0 {
        t := mut &b.tls_conn
        chunk = t.read(4096) or >>
    } else {
        if b.deadline_ns > 0 {
            apply_http_deadline(b.fd, b.deadline_ns) or >>
        }
        chunk = net.conn_read(b.fd, 4096) or >>
    }
    if chunk.len == 0 {
        << 0
    }
    b.data = b.data + chunk
    if b.data.len > 10485760 {
        >> errors.new("net/http: message too large")
    }
    << chunk.len
}

fn (b &mut MsgBuf) decode_chunked(body_start int) string {
    mut i := body_start
    mut out := ""
    for round in 0:100000 {
        mut line_end := find_crlf_from(&b.data, i)
        while line_end < 0 {
            n_r := b.read_more() or >>
            if n_r == 0 {
                >> errors.new("net/http: truncated chunk size")
            }
            line_end = find_crlf_from(&b.data, i)
        }
        size_line := b.data[i:line_end]
        size_r := parse_hex_size(size_line + "") or >>
        size := size_r
        i = line_end + 2
        if size == 0 {
            if i + 1 < b.data.len && (b.data[i] & 255) == 13 && (b.data[i + 1] & 255) == 10 {
                << out + ""
            }
            mut trailer_end := find_crlf_crlf_from(&b.data, i)
            while trailer_end < 0 {
                if i + 1 < b.data.len && (b.data[i] & 255) == 13 && (b.data[i + 1] & 255) == 10 {
                    << out + ""
                }
                n_r2 := b.read_more() or >>
                if n_r2 == 0 {
                    >> errors.new("net/http: truncated chunk trailers")
                }
                trailer_end = find_crlf_crlf_from(&b.data, i)
            }
            << out + ""
        }
        need := i + size + 2
        while b.data.len < need {
            n_r3 := b.read_more() or >>
            if n_r3 == 0 {
                >> errors.new("net/http: truncated chunk")
            }
        }
        out = out + b.data[i:(i + size)]
        i = i + size
        if (b.data[i] & 255) != 13 || (b.data[i + 1] & 255) != 10 {
            >> errors.new("net/http: bad chunk CRLF")
        }
        i = i + 2
        if round > 1000000 {
            >> errors.new("net/http: too many chunks")
        }
    }
    >> errors.new("net/http: too many chunks")
}

fn read_http_message(fd int) string {
    << read_http_message_mode(fd, true, 0)
}

fn connection_wants_close(headers &string) bool {
    v := header_lookup(headers, "connection")
    if v.len == 0 {
        << false
    }
    mut i := 0
    while i < v.len {
        mut c := v[i] & 255
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        if c == 99 {
            if i + 5 <= v.len {
                mut j := 0
                want := "close"
                mut ok := true
                while j < 5 {
                    mut ch := v[i + j] & 255
                    if ch >= 65 && ch <= 90 {
                        ch = ch + 32
                    }
                    if ch != (want[j] & 255) {
                        ok = false
                        <-
                    }
                    j = j + 1
                }
                if ok {
                    << true
                }
            }
        }
        i = i + 1
    }
    << false
}

fn read_http_message_buf(b &mut MsgBuf, until_close bool) string {
    mut header_end := -1
    mut cl := -1
    mut chunked := false
    for round in 0:256 {
        if header_end < 0 {
            header_end = find_crlf_crlf(&b.data)
            if header_end >= 0 {
                hdr := b.data[0:header_end]
                cl = parse_content_length(&hdr)
                chunked = is_chunked(&hdr)
                if chunked {
                    cl = -1
                }
            }
        }
        if header_end >= 0 {
            if chunked {
                <-
            }
            body_so_far := b.data.len - (header_end + 4)
            if cl >= 0 && body_so_far >= cl {
                <-
            }
            if cl < 0 && !until_close {
                <-
            }
        }
        n_r := b.read_more()
        if n_r == 0 {
            <-
        }
        if round > 1000000 {
            <-
        }
    }
    if header_end < 0 {
        >> errors.new("net/http: incomplete headers")
    }
    head := b.data[0:header_end]
    if chunked {
        body_r := b.decode_chunked(header_end + 4)
        body := body_r
        msg := head + "\r\n\r\n" + body
        b.data = ""
        << msg
    }
    if cl >= 0 {
        need := header_end + 4 + cl
        while b.data.len < need {
            n_r2 := b.read_more()
            if n_r2 == 0 {
                >> errors.new("net/http: truncated body")
            }
        }
        msg := b.data[0:need] + ""
        if b.data.len > need {
            b.data = b.data[need:b.data.len]
        } else {
            b.data = ""
        }
        << msg
    }
    msg2 := b.data + ""
    b.data = ""
    << msg2
}

// until_close: response-shaped (no Content-Length means read until eof).
// Requests without Content-Length / chunked encoding have an empty body
// (RFC 7230) and must not block waiting for the client to close.
fn read_http_message_mode(fd int, until_close bool, tls_h int) string {
    mut b := MsgBuf{data: "", fd: fd, tls_h: tls_h, tls_conn: tls.closed_conn(), deadline_ns: 0}
    << read_http_message_buf(mut &b, until_close) or (err) {
        << ""
    }
}

fn (r &mut Response) fill_from_message(msg0 string) int {
    msg := msg0 + ""
    header_end := find_crlf_crlf(&msg)
    if header_end < 0 {
        >> errors.new("net/http: incomplete response headers")
    }
    head := msg[0:header_end]
    mut body := msg[(header_end + 4):msg.len]
    cl := parse_content_length(&head)
    if cl >= 0 {
        if body.len < cl {
            >> errors.new("net/http: truncated body")
        }
        if body.len > cl {
            body = body[0:cl]
        }
    }
    mut line_end := 0
    while line_end < head.len {
        if (head[line_end] & 255) == 10 {
            <-
        }
        line_end = line_end + 1
    }
    mut status_line := head[0:line_end]
    if status_line.len > 0 && (status_line[status_line.len - 1] & 255) == 13 {
        status_line = status_line[0:(status_line.len - 1)]
    }
    code_r := parse_status_line(status_line + "")
    mut hdrs := ""
    if line_end + 1 < head.len {
        hdrs = head[(line_end + 1):head.len]
    }
    r.status_code = code_r
    r.status = status_line + ""
    r.headers = hdrs + ""
    r.body = body + ""
    << 0
}

fn set_cookie_lines(headers &string) []string {
    key := "set-cookie"
    mut out := []string{}
    mut i := 0
    h := headers + ""
    while i < h.len {
        mut line_end := i
        while line_end < h.len {
            if (h[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        mut line := h[i:line_end]
        if line.len > 0 && (line[line.len - 1] & 255) == 13 {
            line = line[0:(line.len - 1)]
        }
        mut colon := -1
        for j in 0:line.len {
            if (line[j] & 255) == 58 {
                colon = j
                <-
            }
        }
        if colon > 0 {
            name := line[0:colon]
            low := strings.to_lower(&name)
            if low == key {
                rest := line[(colon + 1):line.len]
                out.push(strings.trim_space(&rest))
            }
        }
        i = line_end + 1
    }
    << out
}

fn exchange(https bool, addr string, sni string, req string) string {
    << exchange_once(https, addr, sni, req)
}

fn exchange_once(https bool, addr string, sni string, req string) string {
    << exchange_deadline(https, addr, sni, req, 0) or >>
}

fn exchange_deadline(https bool, addr string, sni string, req string, deadline_ns int) string {
    if https {
        mut cfg := tls.new_config(sni)
        remaining := http_remaining(deadline_ns) or >>
        mut nc := net.dial_timeout("tcp", addr, remaining) or >>
        nc.set_deadline(deadline_ns) or (err) {
            >> err
        }
        mut tc := tls.client(nc, &cfg) or (err) {
            http_remaining(deadline_ns) or >>
            >> err
        }
        // The underlying net.Conn also carries the deadline, so each TLS
        // record read/write (including handshake I/O) uses remaining time.
        tc.set_deadline(deadline_ns) or >>
        tc.write(&req) or (err) {
            http_remaining(deadline_ns) or >>
            >> err
        }
        mut b := MsgBuf{data: "", fd: -1, tls_h: 1, tls_conn: tc, deadline_ns: deadline_ns}
        msg := read_http_message_buf(mut &b, true) or (err) {
            http_remaining(deadline_ns) or >>
            >> err
        }
        t := mut &b.tls_conn
        t.close() or (err) {
            http_remaining(deadline_ns) or >>
            << msg + ""
        }
        http_remaining(deadline_ns) or >>
        << msg
    }
    remaining := http_remaining(deadline_ns) or >>
    fd := net.dial_ns(addr, remaining) or >>
    msg := exchange_http_fd(fd, req, "", deadline_ns) or (err) {
        close_http_fd(fd)
        http_remaining(deadline_ns) or >>
        >> err
    }
    close_http_fd(fd)
    << msg.data
}

fn (c &mut Client) close_idle() {
    if c.idle_fd >= 0 {
        fd := c.idle_fd
        c.idle_fd = -1
        c.idle_buf = ""
        net.conn_close(fd) or (err) { << }
    }
}

fn (c &mut Client) exchange_http(addr string, req string, deadline_ns int, retry_safe bool) string {
    mut fd := -1
    mut leftover := ""
    mut reused := false
    if c.idle_fd >= 0 && c.idle_https == 0 && c.idle_addr == addr {
        fd = c.idle_fd
        leftover = c.idle_buf + ""
        c.idle_fd = -1
        c.idle_buf = ""
        reused = true
    }
    if fd < 0 {
        c.close_idle()
        remaining := http_remaining(deadline_ns) or >>
        fd = net.dial_ns(addr, remaining) or >>
    }
    result := exchange_http_fd(fd, req + "", leftover, deadline_ns) or (err) {
        close_http_fd(fd)
        http_remaining(deadline_ns) or >>
        // Retry a stale idle connection once, only for GET/HEAD. The
        // absolute deadline stays unchanged and a POST is never replayed.
        if reused && retry_safe {
            << c.exchange_http(addr, req, deadline_ns, false) or >>
        }
        >> err
    }
    msg := result.data + ""
    header_end := find_crlf_crlf(&msg)
    mut hdrs := ""
    if header_end >= 0 {
        hdrs = msg[0:header_end]
    }
    if connection_wants_close(&hdrs) {
        close_http_fd(fd)
        << msg
    }
    c.idle_fd = fd
    c.idle_https = 0
    c.idle_addr = addr + ""
    c.idle_buf = result.leftover + ""
    << msg
}

fn (r &mut Response) do_request_ex(method string, raw_url string, body &string, extra string) int {
    r.status_code = 0
    r.status = ""
    r.headers = ""
    r.body = ""
    r.sticky = ""
    mut u := url.new_url()
    u.parse(raw_url)
    scheme := u.scheme()
    https := scheme == "https"
    if scheme != "http" && !https {
        >> errors.new("net/http: unsupported scheme")
    }
    host := u.host()
    if host.len == 0 {
        >> errors.new("net/http: missing host")
    }
    h := host + ""
    addr := dial_addr_for_url(h + "", https)
    sni := host_no_port(h)
    req := build_request(method, &u, body, extra)
    msg := exchange(https, addr, sni, req) or >>
    << r.fill_from_message(msg + "")
}

fn (c &mut Client) do_exchange(https bool, addr string, sni string, req string, deadline_ns int, retry_safe bool) string {
    if https {
        c.close_idle()
        << exchange_deadline(true, addr, sni, req, deadline_ns) or >>
    }
    << c.exchange_http(addr, req, deadline_ns, retry_safe) or >>
}

fn (r &mut Response) do_request(method string, raw_url string, body &string) int {
    << r.do_request_ex(method, raw_url, body, "") or >>
}

pub fn (r &mut Response) get(url string) int {
    empty := ""
    << r.do_request("GET", url, &empty) or >>
}

pub fn (r &mut Response) post(url string, body &string) int {
    << r.do_request("POST", url, body) or >>
}

pub fn (r Response) cookies() []Cookie {
    lines := set_cookie_lines(&r.headers)
    mut out := []Cookie{}
    mut i := 0
    while i < lines.len {
        ln := lines[i] + ""
        ck := parse_set_cookie(&ln) or (err) {
            i = i + 1
            ->
        }
        out.push(ck)
        i = i + 1
    }
    << out
}

pub struct Client {
    pub jar cookiejar.Jar
    pub jar_on int
    idle_fd int
    idle_https int
    idle_addr string
    idle_buf string
    // One budget for HTTP/TLS I/O and redirects; 0 disables it. Synchronous
    // DNS and Linux TCP connect still need cancellable platform adapters.
    pub timeout_ns int
    pub max_redirects int
}

pub fn new_client() Client {
    << Client{jar: cookiejar.new_jar(), jar_on: 0, idle_fd: -1, idle_https: 0, idle_addr: "", idle_buf: "", timeout_ns: 0, max_redirects: 10}
}

pub fn (c &mut Client) set_jar(j cookiejar.Jar) {
    c.jar = j
    c.jar_on = 1
}

pub fn (c &mut Client) set_timeout(ns int) {
    c.timeout_ns = ns
}

fn cookie_list(j &cookiejar.Jar, u &url.URL) []cookiejar.Cookie {
    << j.cookies(u)
}

fn ingest_cookies(j &mut cookiejar.Jar, u &url.URL, headers &string) {
    lines := set_cookie_lines(headers)
    mut i := 0
    while i < lines.len {
        ln := lines[i] + ""
        ck := parse_set_cookie(&ln) or (err) {
            i = i + 1
            ->
        }
        jc := cookiejar.Cookie{name: ck.name + "", value: ck.value + "", path: ck.path + "", domain: ck.domain + "", secure: ck.secure, http_only: ck.http_only, max_age: ck.max_age}
        j.set_cookie(u, jc)
        i = i + 1
    }
}

fn (c &mut Client) do_once(method string, raw_url string, body &string, deadline_ns int) Response {
    http_remaining(deadline_ns) or >>
    url0 := raw_url + ""
    mut u := url.new_url()
    u.parse(url0 + "") or >>
    mut extra := ""
    if c.jar_on != 0 {
        cs := cookie_list(&c.jar, &u)
        ch := cookiejar.cookie_header(&cs)
        if ch.len > 0 {
            extra = "Cookie: " + ch + "\r\n"
        }
    }
    mut r := new_response()
    r.status_code = 0
    r.status = ""
    r.headers = ""
    r.body = ""
    r.sticky = ""
    scheme := u.scheme()
    https := scheme == "https"
    if scheme != "http" && !https {
        >> errors.new("net/http: unsupported scheme")
    }
    host := u.host()
    if host.len == 0 {
        >> errors.new("net/http: missing host")
    }
    h := host + ""
    addr := dial_addr_for_url(h + "", https)
    sni := host_no_port(h)
    retry_safe := method == "GET" || method == "HEAD"
    req := build_request(method, &u, body, extra)
    msg := c.do_exchange(https, addr, sni, req, deadline_ns, retry_safe) or >>
    r.fill_from_message(msg + "") or >>
    if c.jar_on != 0 {
        ingest_cookies(mut &c.jar, &u, &r.headers)
    }
    http_remaining(deadline_ns) or >>
    << r
}

pub fn (c &mut Client) do(method string, raw_url string, body &string) Response {
    m := method + ""
    u := raw_url + ""
    deadline_ns := http_deadline(c.timeout_ns) or >>
    r := c.do_once(m + "", u + "", body, deadline_ns) or (err) {
        c.close_idle()
        >> err
    }
    << c.follow_redirects(m + "", u + "", body, r, deadline_ns) or (err) {
        c.close_idle()
        >> err
    }
}

pub fn (c &mut Client) get(raw_url string) Response {
    empty := ""
    << c.do("GET", raw_url, &empty) or >>
}

pub fn (c &mut Client) post(raw_url string, body &string) Response {
    << c.do("POST", raw_url, body) or >>
}

pub fn (req &mut Request) read(fd int) int {
    req.method = ""
    req.path = ""
    req.headers = ""
    req.body = ""
    req.sticky = ""
    msg_r := read_http_message_mode(fd, false, 0)
        msg := msg_r
    header_end := find_crlf_crlf(&msg)
    if header_end < 0 {
        >> errors.new("net/http: incomplete request headers")
    }
    head := msg[0:header_end]
    mut body := msg[(header_end + 4):msg.len]
    cl := parse_content_length(&head)
    if cl >= 0 {
        if body.len < cl {
            >> errors.new("net/http: truncated body")
        }
        if body.len > cl {
            body = body[0:cl]
        }
    }
    mut line_end := 0
    while line_end < head.len {
        if (head[line_end] & 255) == 10 {
            <-
        }
        line_end = line_end + 1
    }
    mut req_line := head[0:line_end]
    if req_line.len > 0 && (req_line[req_line.len - 1] & 255) == 13 {
        req_line = req_line[0:(req_line.len - 1)]
    }
    mut sp1 := -1
    for i in 0:req_line.len {
        if (req_line[i] & 255) == 32 {
            sp1 = i
            <-
        }
    }
    if sp1 <= 0 {
        >> errors.new("net/http: bad request line")
    }
    mut sp2 := -1
    for i in (sp1 + 1):req_line.len {
        if (req_line[i] & 255) == 32 {
            sp2 = i
            <-
        }
    }
    if sp2 < 0 {
        >> errors.new("net/http: bad request line")
    }
    method := req_line[0:sp1]
    path := req_line[(sp1 + 1):sp2]
    mut hdrs := ""
    if line_end + 1 < head.len {
        hdrs = head[(line_end + 1):head.len]
    }
    req.method = method + ""
    req.path = path + ""
    req.headers = hdrs + ""
    req.body = body + ""
    << 0
}

pub fn write_response(fd int, status_code int, body &string) int {
    << write(fd, status_code, "text/plain", body) or >>
}

// write is the typed-body form of a one-shot HTTP/1.1 response
// (Go http.ResponseWriter WriteHeader+Write, Connection: close).
pub fn write(fd int, status_code int, content_type string, body &string) int {
    << write_n(fd, status_code, content_type, "", body, true)
}

fn write_n(fd int, status_code int, content_type string, extra string, body &string, send_body bool) int {
    if fd < 0 {
        >> errors.new("net/http: bad fd")
    }
    reason := status_text(status_code)
    mut ctype := content_type + ""
    if ctype.len == 0 {
        ctype = "application/octet-stream"
    }
    mut out := "HTTP/1.1 " + strconv.itoa(status_code) + " " + reason + "\r\n"
    out = out + "Content-Type: " + ctype + "\r\n"
    out = out + "Content-Length: " + strconv.itoa(body.len) + "\r\n"
    out = out + extra
    if extra.len == 0 || !strings.contains(&extra, "Connection:") {
        out = out + "Connection: close\r\n"
    }
    out = out + "\r\n"
    if send_body {
        out = out + body
    }
    << net.conn_write(fd, &out) or >>
}

fn (c &mut Client) drop() { c.close_idle() }

pub fn (c &Client) has_idle_connection() bool { << c.idle_fd >= 0 }
