@net/http

#strings

// DetectContentType subset of Go `http.DetectContentType` / WHATWG
// MIME sniffing: first 512 bytes, always a valid MIME type.

const sniff_len = 512

fn sniff_prefix(data &string, n int, pat &string) bool {
    if n < pat.len {
        << false
    }
    mut i := 0
    while i < pat.len {
        if (data[i] & 255) != (pat[i] & 255) {
            << false
        }
        i = i + 1
    }
    << true
}

fn sniff_skip_ws(data &string, n int) int {
    mut i := 0
    while i < n {
        c := data[i] & 255
        if c != 9 && c != 10 && c != 13 && c != 32 {
            << i
        }
        i = i + 1
    }
    << n
}

fn sniff_ci_eq(a int, b int) bool {
    mut x := a & 255
    mut y := b & 255
    if x >= 65 && x <= 90 {
        x = x + 32
    }
    if y >= 65 && y <= 90 {
        y = y + 32
    }
    << x == y
}

fn sniff_html_tag(data &string, n int, tag &string) bool {
    start := sniff_skip_ws(data, n)
    if start >= n {
        << false
    }
    if (data[start] & 255) != 60 {
        << false
    }
    mut i := 0
    while i < tag.len {
        p := start + 1 + i
        if p >= n {
            << false
        }
        if !sniff_ci_eq(data[p], tag[i]) {
            << false
        }
        i = i + 1
    }
    endp := start + 1 + tag.len
    if endp >= n {
        << false
    }
    c := data[endp] & 255
    if c == 32 || c == 62 {
        << true
    }
    << false
}

fn sniff_is_text(data &string, n int) bool {
    mut i := 0
    while i < n {
        c := data[i] & 255
        if c <= 8 {
            << false
        }
        if c == 11 {
            << false
        }
        if c >= 14 && c <= 31 {
            << false
        }
        if c == 127 {
            << false
        }
        i = i + 1
    }
    << true
}

fn sniff_bytes(xs []int) string {
    << string_from_bytes(xs)
}

pub fn detect_content_type(data &string) string {
    mut n := data.len
    if n > sniff_len {
        n = sniff_len
    }
    mut pngb := []int{}
    pngb.push(137)
    pngb.push(80)
    pngb.push(78)
    pngb.push(71)
    pngb.push(13)
    pngb.push(10)
    pngb.push(26)
    pngb.push(10)
    png := sniff_bytes(pngb)
    if sniff_prefix(data, n, &png) {
        << "image/png"
    }
    gif87 := "GIF87a"
    gif89 := "GIF89a"
    if sniff_prefix(data, n, &gif87) || sniff_prefix(data, n, &gif89) {
        << "image/gif"
    }
    if n >= 3 {
        if (data[0] & 255) == 255 && (data[1] & 255) == 216 && (data[2] & 255) == 255 {
            << "image/jpeg"
        }
    }
    pdf := "%PDF-"
    if sniff_prefix(data, n, &pdf) {
        << "application/pdf"
    }
    mut zipb := []int{}
    zipb.push(80)
    zipb.push(75)
    zipb.push(3)
    zipb.push(4)
    zip := sniff_bytes(zipb)
    if sniff_prefix(data, n, &zip) {
        << "application/zip"
    }
    mut gzb := []int{}
    gzb.push(31)
    gzb.push(139)
    gzb.push(8)
    gz := sniff_bytes(gzb)
    if sniff_prefix(data, n, &gz) {
        << "application/x-gzip"
    }
    html := "HTML"
    head := "HEAD"
    body := "BODY"
    if sniff_html_tag(data, n, &html) || sniff_html_tag(data, n, &head) || sniff_html_tag(data, n, &body) {
        << "text/html; charset=utf-8"
    }
    start := sniff_skip_ws(data, n)
    xml := "<?xml"
    if start + xml.len <= n {
        mut ok := true
        mut i := 0
        while i < xml.len {
            if !sniff_ci_eq(data[start + i], xml[i]) {
                ok = false
                <-
            }
            i = i + 1
        }
        if ok {
            << "text/xml; charset=utf-8"
        }
    }
    if sniff_is_text(data, n) {
        << "text/plain; charset=utf-8"
    }
    << "application/octet-stream"
}
