@net/http/httptest

#errors
#net
#net/http

// Go `net/http/httptest` subset: in-process ResponseRecorder,
// new_request, and a loopback Server (Listen + goroutine Accept).
// write_header after the first write is ignored. header_set is recorded
// until then. new_request keeps a path; `http://host/path` is stripped
// to `/path`. Server binds 127.0.0.1 on an ephemeral high port (no
// getsockname); close unblocks Accept.

pub struct ResponseRecorder {
    pub code int
    pub hdr string
    pub body string
    pub wrote int
}

pub fn new_recorder() ResponseRecorder {
    << ResponseRecorder{code: 200, hdr: "", body: "", wrote: 0}
}

pub fn (r $&ResponseRecorder) write_header(code int) {
    if r.wrote == 0 {
        r.code = code
        r.wrote = 1
    }
}

pub fn (r $&ResponseRecorder) header_set(key string, val string) {
    if r.wrote != 0 {
        <<
    }
    ck := http.canonical_header_key(&key)
    r.hdr = r.hdr + ck + ": " + val + "\r\n"
}

pub fn (r $&ResponseRecorder) write(b &string) int {
    if r.wrote == 0 {
        r.write_header(200)
    }
    r.body = r.body + b
    << b.len
}

pub fn (r ResponseRecorder) result_code() int {
    << r.code
}

pub fn (r ResponseRecorder) result_body() string {
    << r.body + ""
}

pub fn (r ResponseRecorder) result_header(name string) string {
    << header_get(&r.hdr, name)
}

fn header_get(headers &string, name string) string {
    h := headers + ""
    want := http.canonical_header_key(&name)
    $i := 0
    while i < h.len {
        $line_end := i
        while line_end < h.len {
            if (h[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        $last := line_end
        if last > i {
            if (h[last - 1] & 255) == 13 {
                last = last - 1
            }
        }
        $colon := -1
        $j := i
        while j < last {
            if (h[j] & 255) == 58 {
                colon = j
                <-
            }
            j = j + 1
        }
        if colon > i {
            key := h[i:colon]
            if http.canonical_header_key(&key) == want {
                $v0 := colon + 1
                $v1 := last
                while v0 < v1 {
                    c := h[v0] & 255
                    if c == 32 || c == 9 {
                        v0 = v0 + 1
                    } else {
                        <-
                    }
                }
                while v1 > v0 {
                    c := h[v1 - 1] & 255
                    if c == 32 || c == 9 {
                        v1 = v1 - 1
                    } else {
                        <-
                    }
                }
                if v1 > v0 {
                    << h[v0:v1]
                }
                << ""
            }
        }
        i = line_end + 1
    }
    << ""
}

fn request_path(target string) string {
    t := target + ""
    if t.len == 0 {
        << "/"
    }
    $i := 0
    while i + 2 < t.len {
        if (t[i] & 255) == 58 {
            if (t[i + 1] & 255) == 47 {
                if (t[i + 2] & 255) == 47 {
                    i = i + 3
                    while i < t.len {
                        if (t[i] & 255) == 47 {
                            << t[i:t.len]
                        }
                        i = i + 1
                    }
                    << "/"
                }
            }
        }
        i = i + 1
    }
    << t
}

pub struct Server {
    pub url string
    pub addr string
    pub lfd int
}

fn httptest_serve(lfd int, handle fn(http.Context)) {
    _ := http.serve_listener(lfd, handle)
}

fn bind_loopback() Server {
    $port := 19901
    $n := 0
    while n < 64 {
        addr := "127.0.0.1:" + str(port)
        fd := net.listen(addr + "") or (err) {
            port = port + 1
            n = n + 1
            ->
        }
        u := "http://" + (addr + "")
        << Server{url: u, addr: addr, lfd: fd}
    }
    >> errors.new("httptest: no loopback port")
    << Server{url: "", addr: "", lfd: -1}
}

pub fn new_server(handle fn(http.Context)) Server {
    s := bind_loopback() or >>
    xu httptest_serve(s.lfd, handle)
    << s
}

pub fn (s $&Server) close() int {
    if s.lfd < 0 {
        << 0
    }
    net.conn_close(s.lfd) or (err) {
        s.lfd = -1
        << 0
    }
    s.lfd = -1
    << 0
}

pub fn new_request(method string, target string, body string) http.Request {
    << http.Request{
        method: method + "",
        path: request_path(target),
        headers: "",
        body: body + "",
        sticky: ""
    }
}
