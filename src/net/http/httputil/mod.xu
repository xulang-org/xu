@net/http/httputil

#errors
#net/http
#os
#strconv
#strings

// Package httputil provides HTTP utility functions, complementing the more
// common ones in net/http. Aligned with Go `net/http/httputil`.

pub struct ReverseProxy {
    pub target string
    pub client http.Client
}

pub fn new_single_host_reverse_proxy(target string) ReverseProxy {
    $t := target + ""
    if t.len > 0 && (t[t.len - 1] & 255) == 47 {
        t = t[0:t.len - 1] + ""
    }
    << ReverseProxy{target: t, client: http.new_client()}
}

// is_hop_by_hop returns true for HTTP/1.1 hop-by-hop headers that should
// not be forwarded by a proxy per RFC 7230 §6.1.
fn is_hop_by_hop(name string) bool {
    n := strings.to_lower(&name)
    if n == "connection" || n == "keep-alive" || n == "proxy-authenticate" ||
       n == "proxy-authorization" || n == "te" || n == "trailers" ||
       n == "transfer-encoding" || n == "upgrade" {
        << true
    }
    << false
}

pub fn (p $&ReverseProxy) serve_http(c http.Context) {
    req_path := c.path()
    $dest := p.target + req_path
    q := c.query()
    if q.len > 0 {
        dest = dest + "?" + q
    }
    req_body := c.body()
    method := c.method()
    cli := $&p.client
    resp := cli.do(method, dest, &req_body) or (err) {
        c.text(502, "502 Bad Gateway: failed to reach upstream\n") or (e) { << }
        <<
    }
    code := resp.status_code()
    if code <= 0 {
        c.text(502, "502 Bad Gateway: failed to reach upstream\n") or (err) { << }
        <<
    }
    body := resp.body()
    $ct := resp.header("content-type")
    if ct.len == 0 {
        ct = "application/octet-stream"
    }
    http.write(c.fd, code, ct, &body) or (err) { << }
}

// dump_request returns the incoming HTTP request in wire representation.
pub fn dump_request(c http.Context) string {
    $out := c.method() + " " + c.raw_path() + " HTTP/1.1\r\n"
    host := c.header("host")
    if host.len > 0 {
        out = out + "Host: " + host + "\r\n"
    }
    body := c.body()
    if body.len > 0 {
        out = out + "Content-Length: " + strconv.itoa(body.len) + "\r\n\r\n" + body
    } else {
        out = out + "\r\n"
    }
    << out
}

// dump_response returns the HTTP response in wire representation.
pub fn dump_response(resp http.Response) string {
    $out := "HTTP/1.1 " + strconv.itoa(resp.status_code()) + " " + resp.status() + "\r\n"
    body := resp.body()
    if body.len > 0 {
        out = out + "Content-Length: " + strconv.itoa(body.len) + "\r\n\r\n" + body
    } else {
        out = out + "\r\n"
    }
    << out
}
