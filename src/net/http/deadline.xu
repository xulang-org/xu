@net/http

#errors
#net
#os
#crypto/tls

fn http_deadline(ns int) int {
    if ns < 0 {
        >> errors.new("net/http: negative timeout")
    }
    if ns == 0 {
        << 0
    }
    now := now_ns()
    // Saturate instead of wrapping a long positive timeout into the past.
    if ns > 9223372036854775807 - now {
        << 9223372036854775807
    }
    << now + ns
}

fn http_remaining(deadline_ns int) int {
    if deadline_ns == 0 {
        << 0
    }
    remaining := deadline_ns - now_ns()
    if remaining <= 0 {
        >> errors.new("net/http: request timeout")
    }
    << remaining
}

fn apply_http_deadline(fd int, deadline_ns int) int {
    remaining := http_remaining(deadline_ns) or >>
    // Also clear the previous request's socket timeout on idle reuse when
    // this request has no deadline.
    os.set_sock_timeout(fd, remaining) or >>
    << 0
}

fn close_http_fd(fd int) {
    net.conn_close(fd) or (err) { << }
}

struct HttpMessage {
    data string
    leftover string
}

fn exchange_http_fd(fd int, req string, leftover string, deadline_ns int) HttpMessage {
    // write(2) can make partial progress. Refresh the remaining budget on
    // every syscall, rather than restarting a relative timeout each time.
    source := req + ""
    mut sent := 0
    while sent < source.len {
        apply_http_deadline(fd, deadline_ns) or >>
        part := source[sent:source.len]
        n := net.conn_write(fd, &part) or >>
        if n <= 0 {
            >> errors.new("net/http: write failed")
        }
        sent = sent + n
    }
    mut b := MsgBuf{data: leftover, fd: fd, tls_h: 0, tls_conn: tls.closed_conn(), deadline_ns: deadline_ns}
    msg := read_http_message_buf(mut &b, true) or >>
    http_remaining(deadline_ns) or >>
    << HttpMessage{data: msg, leftover: b.data + ""}
}
