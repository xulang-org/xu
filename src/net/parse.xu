@net

#errors

// Shared parse helpers (Go net/parse.go). Decimal/hex, field split, and
// byte-string builders. Unexported; used across the net package files.

const net_big = 16777215

fn index_byte(s &string, b int) int {
    want := b & 255
    for i in 0:s.len {
        if (s[i] & 255) == want {
            << i
        }
    }
    << -1
}

fn last_index_byte(s &string, b int) int {
    want := b & 255
    mut last := -1
    for i in 0:s.len {
        if (s[i] & 255) == want {
            last = i
        }
    }
    << last
}

fn contains_byte(s &string, b int) bool {
    << index_byte(s, b) >= 0
}

fn ascii_lower(s &string) string {
    mut out := ""
    for i in 0:s.len {
        mut c := s[i] & 255
        if c >= 65 && c <= 90 {
            c = c + 32
        }
        out = out + string_from_byte(c)
    }
    << out
}

fn is_ws_byte(c int) bool {
    << c == 32 || c == 9 || c == 10 || c == 13
}

fn get_fields(s &string) []string {
    src := s + ""
    mut out := []string{}
    mut i := 0
    while i < src.len {
        if is_ws_byte(src[i] & 255) {
            i = i + 1
        } else {
            start := i
            while i < src.len {
                if is_ws_byte(src[i] & 255) {
                    <-
                }
                i = i + 1
            }
            out.push(src[start:i])
        }
    }
    << out
}

fn dtoi_full(s &string) int {
    if s.len == 0 {
        << -1
    }
    mut v := 0
    for i in 0:s.len {
        c := s[i] & 255
        if c < 48 || c > 57 {
            << -1
        }
        v = v * 10 + (c - 48)
        if v > net_big {
            << -1
        }
    }
    << v
}

fn xtoi2(s &string, start int, sep int) int {
    if start < 0 || start + 2 > s.len {
        << -1
    }
    if sep != 0 && start + 2 < s.len {
        if (s[start + 2] & 255) != (sep & 255) {
            << -1
        }
    }
    a := hex_val(s[start] & 255)
    b := hex_val(s[start + 1] & 255)
    if a < 0 || b < 0 {
        << -1
    }
    << (a << 4) | b
}

fn be16(v int) string {
    mut out := ""
    out.push_byte((v >> 8) & 255)
    out.push_byte(v & 255)
    << out
}

fn u16_be(s &string, off int) int {
    if off < 0 || off + 2 > s.len {
        << -1
    }
    << ((s[off] & 255) << 8) | (s[off + 1] & 255)
}

fn u32_be(s &string, off int) int {
    if off < 0 || off + 4 > s.len {
        << -1
    }
    << ((s[off] & 255) << 24) | ((s[off + 1] & 255) << 16) | ((s[off + 2] & 255) << 8) | (s[off + 3] & 255)
}

fn append_bytes(dst string, src &string, start int, end int) string {
    mut out := dst
    mut i := start
    while i < end {
        if i >= src.len {
            <-
        }
        out.push_byte(src[i] & 255)
        i = i + 1
    }
    << out
}

fn clone_bytes(src &string) string {
    << src + ""
}

fn byte_eq_range(a &string, a0 int, b &string, b0 int, n int) bool {
    if a0 < 0 || b0 < 0 || n < 0 {
        << false
    }
    if a0 + n > a.len || b0 + n > b.len {
        << false
    }
    for i in 0:n {
        if (a[a0 + i] & 255) != (b[b0 + i] & 255) {
            << false
        }
    }
    << true
}

fn v4_mapped_prefix() string {
    mut p := ""
    for i in 0:10 {
        p.push_byte(0)
        _ := i
    }
    p.push_byte(255)
    p.push_byte(255)
    << p
}

fn zeros_n(n int) string {
    mut out := ""
    mut i := 0
    while i < n {
        out.push_byte(0)
        i = i + 1
    }
    << out
}

fn ones_n(n int) string {
    mut out := ""
    mut i := 0
    while i < n {
        out.push_byte(255)
        i = i + 1
    }
    << out
}

fn strip_trailing_dot(s string) string {
    if s.len > 0 && (s[s.len - 1] & 255) == 46 {
        << s[0:(s.len - 1)]
    }
    << s + ""
}

fn ensure_trailing_dot(s string) string {
    if s.len == 0 {
        << "."
    }
    if (s[s.len - 1] & 255) == 46 {
        << s + ""
    }
    << s + "."
}

fn count_dots(s &string) int {
    mut n := 0
    for i in 0:s.len {
        if (s[i] & 255) == 46 {
            n = n + 1
        }
    }
    << n
}

fn split_host_zone(s string) HostPort {
    mut hp := new_host_port()
    mut last := -1
    for i in 0:s.len {
        if (s[i] & 255) == 37 {
            last = i
        }
    }
    if last > 0 {
        hp.host = s[0:last]
        hp.port = s[(last + 1):s.len]
        << hp
    }
    hp.host = s + ""
    hp.port = ""
    << hp
}
