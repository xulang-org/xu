@net

#errors
#encoding/hex
#os
#strings

// Network interfaces (Go net/interface.go). The runtime exposes a compact,
// platform-neutral snapshot instead of leaking getifaddrs/
// GetAdaptersAddresses layouts into the public package.

const flag_up = 1
const flag_broadcast = 2
const flag_loopback = 4
const flag_point_to_point = 8
const flag_multicast = 16
const flag_running = 32

pub struct Interface {
    pub index int
    pub mtu int
    pub name string
    pub hardware_addr string
    pub flags int
}

pub fn new_interface() Interface {
    << Interface{index: 0, mtu: 0, name: "", hardware_addr: "", flags: 0}
}

pub fn flags_string(f int) string {
    mut s := ""
    if (f & flag_up) != 0 {
        s = s + "up"
    }
    if (f & flag_broadcast) != 0 {
        if s.len > 0 {
            s = s + "|"
        }
        s = s + "broadcast"
    }
    if (f & flag_loopback) != 0 {
        if s.len > 0 {
            s = s + "|"
        }
        s = s + "loopback"
    }
    if (f & flag_point_to_point) != 0 {
        if s.len > 0 {
            s = s + "|"
        }
        s = s + "pointtopoint"
    }
    if (f & flag_multicast) != 0 {
        if s.len > 0 {
            s = s + "|"
        }
        s = s + "multicast"
    }
    if (f & flag_running) != 0 {
        if s.len > 0 {
            s = s + "|"
        }
        s = s + "running"
    }
    if s.len == 0 {
        << "0"
    }
    << s
}

pub fn (ifi Interface) addrs() []string {
    if ifi.index < 0 {
        >> errors.new("net: invalid interface")
    }
    if ifi.name.len == 0 {
        >> errors.new("net: invalid interface")
    }
    raw := os.interface_data(ifi.name + "") or >>
    mut out := interface_record_addrs(&raw) or >>
    if xu_target_os() == 1 {
        v6 := linux_interface_ipv6_addrs(ifi.name + "")
        for i in 0:v6.len {
            if !interface_addr_seen(&out, &v6[i]) {
                out.push(v6[i] + "")
            }
        }
    }
    << out
}

pub fn interfaces() []Interface {
    names := interface_names() or >>
    mut out := []Interface{}
    for i in 0:names.len {
        raw := os.interface_data(names[i] + "") or >>
        ifi := interface_from_record(names[i] + "", &raw) or >>
        out.push(ifi)
    }
    << out
}

pub fn interface_addrs() []string {
    all := interfaces() or >>
    mut out := []string{}
    for i in 0:all.len {
        aa := all[i].addrs() or >>
        for j in 0:aa.len {
            out.push(aa[j] + "")
        }
    }
    << out
}

pub fn interface_by_name(name string) Interface {
    if name.len == 0 {
        >> errors.new("net: invalid interface name")
    }
    all := interfaces() or >>
    for i in 0:all.len {
        if all[i].name == name {
            << clone_interface_at(&all, i)
        }
    }
    >> errors.new("net: no such network interface")
    << new_interface()
}

pub fn interface_by_index(index int) Interface {
    if index < 0 {
        >> errors.new("net: invalid interface index")
    }
    all := interfaces() or >>
    for i in 0:all.len {
        if all[i].index == index {
            << clone_interface_at(&all, i)
        }
    }
    >> errors.new("net: no such network interface")
    << new_interface()
}

// Runtime record v1:
//   byte 0       version (=1)
//   bytes 1..4   index, little endian u32
//   bytes 5..8   MTU, little endian u32
//   bytes 9..12  public flags, little endian u32
//   byte 13      hardware address length (0..20)
//   bytes 14..33 hardware address, zero padded
//   byte 34      address count (0..8)
//   address[i]   18 bytes: byte length (4/16), prefix, 16 address bytes
const interface_record_head = 35
const interface_record_addr = 18
const interface_max_addrs = 8

fn record_u32(raw &string, off int) int {
    << (raw[off] & 255) |
        ((raw[off + 1] & 255) << 8) |
        ((raw[off + 2] & 255) << 16) |
        ((raw[off + 3] & 255) << 24)
}

fn clone_interface_at(ifs &[]Interface, index int) Interface {
    mut name := ""
    for i in 0:ifs[index].name.len {
        name.push_byte(ifs[index].name[i] & 255)
    }
    mut hardware_addr := ""
    for i in 0:ifs[index].hardware_addr.len {
        hardware_addr.push_byte(ifs[index].hardware_addr[i] & 255)
    }
    << Interface{
        index: ifs[index].index,
        mtu: ifs[index].mtu,
        name: name,
        hardware_addr: hardware_addr,
        flags: ifs[index].flags
    }
}

fn validate_interface_record(raw &string) int {
    if raw.len < interface_record_head || (raw[0] & 255) != 1 {
        >> errors.new("net: invalid interface data")
    }
    hwlen := raw[13] & 255
    naddr := raw[34] & 255
    if hwlen > 20 || naddr > interface_max_addrs {
        >> errors.new("net: invalid interface data")
    }
    if raw.len < interface_record_head + naddr * interface_record_addr {
        >> errors.new("net: invalid interface data")
    }
    for i in 0:naddr {
        n := raw[interface_record_head + i * interface_record_addr] & 255
        if n != 4 && n != 16 {
            >> errors.new("net: invalid interface data")
        }
    }
    << naddr
}

fn interface_from_record(name string, raw &string) Interface {
    _ := validate_interface_record(raw) or >>
    hwlen := raw[13] & 255
    mut hw := ""
    if hwlen > 0 {
        for i in 0:hwlen {
            hw.push_byte(raw[14 + i] & 255)
        }
    }
    << Interface{
        index: record_u32(raw, 1),
        mtu: record_u32(raw, 5),
        name: name + "",
        hardware_addr: hw,
        flags: record_u32(raw, 9)
    }
}

fn interface_record_addrs(raw &string) []string {
    naddr := validate_interface_record(raw) or >>
    mut out := []string{}
    for i in 0:naddr {
        off := interface_record_head + i * interface_record_addr
        n := raw[off] & 255
        prefix := raw[off + 1] & 255
        mut ip := ""
        for j in 0:n {
            ip.push_byte(raw[off + 2 + j] & 255)
        }
        out.push(ip_string(&ip) + "/" + str(prefix))
    }
    << out
}

fn interface_name_seen(names &[]string, name &string) bool {
    target := name + ""
    for i in 0:names.len {
        if names[i] == target {
            << true
        }
    }
    << false
}

fn interface_addr_seen(addrs &[]string, addr &string) bool {
    target := addr + ""
    for i in 0:addrs.len {
        if addrs[i] == target {
            << true
        }
    }
    << false
}

fn interface_hex_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

fn interface_hex_byte(s &string) int {
    if s.len != 2 {
        << -1
    }
    hi := interface_hex_val(s[0] & 255)
    lo := interface_hex_val(s[1] & 255)
    if hi < 0 || lo < 0 {
        << -1
    }
    << hi * 16 + lo
}

// Linux exposes IPv6 interface addresses through this stable procfs text
// format rather than SIOCGIFADDR. Each record has six whitespace-separated
// fields: 32 hex address bytes, index, prefix, scope, flags and name.
// Missing procfs (for example when IPv6 is disabled) means no IPv6 addresses,
// not a failure of the otherwise usable interface metadata API.
fn linux_interface_ipv6_addrs(name string) []string {
    mut out := []string{}
    raw := os.read("/proc/net/if_inet6") or (err) {
        << out
    }
    fields := strings.fields(&raw)
    mut i := 0
    while i + 5 < fields.len {
        if fields[i].len == 32 && fields[i + 2].len == 2 && fields[i + 5] == name {
            prefix_hex := fields[i + 2] + ""
            prefix := interface_hex_byte(&prefix_hex)
            if prefix >= 0 && prefix <= 128 {
                ip := hex.decode_string(fields[i] + "") or (err) {
                    i = i + 6
                    ->
                }
                if ip.len == 16 {
                    out.push(ip_string(&ip) + "/" + str(prefix))
                }
            }
        }
        i = i + 6
    }
    << out
}

fn parse_interface_names(raw &string) []string {
    mut out := []string{}
    mut start := 0
    for i in 0:raw.len {
        c := raw[i] & 255
        if c == 0 || c == 10 || c == 13 {
            if i > start {
                mut name := ""
                for j in start:i {
                    name.push_byte(raw[j] & 255)
                }
                if !interface_name_seen(&out, &name) {
                    out.push(name)
                }
            }
            start = i + 1
        }
    }
    if start < raw.len {
        mut name := ""
        for j in start:raw.len {
            name.push_byte(raw[j] & 255)
        }
        if !interface_name_seen(&out, &name) {
            out.push(name)
        }
    }
    << out
}

fn interface_names() []string {
    mut raw := ""
    if xu_target_os() == 1 {
        // Linux keeps the authoritative interface names in sysfs. Metadata
        // and addresses still come from ioctl through interface_data(name).
        raw = os.read_dir("/sys/class/net") or >>
    } else {
        raw = os.interface_data("") or >>
    }
    names := parse_interface_names(&raw)
    if names.len == 0 {
        >> errors.new("net: no network interfaces")
    }
    << names
}
