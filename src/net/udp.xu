@net

#errors
#os

// UDP types (Go UDPConn / PacketConn). Datagram I/O is IPv4; socket/bind
// composition lives in runtime.xu. Packed peer: 4-byte IP + 2-byte BE port.

pub struct PacketConn {
    fd int
    pub network string
    pub laddr string
    pub raddr string
}

pub struct UDPPacket {
    pub addr UDPAddr
    pub data string
}

fn pack_udp4_addr(ip string, port int) string {
    v4 := ip_to4(&ip)
    if v4.len != 4 {
        >> errors.new("net: UDP needs IPv4")
    }
    if port < 0 || port > 65535 {
        >> errors.new("net: invalid port")
    }
    a := v4[0] & 255
    b := v4[1] & 255
    c := v4[2] & 255
    d := v4[3] & 255
    mut out := ""
    out.push_byte(a)
    out.push_byte(b)
    out.push_byte(c)
    out.push_byte(d)
    out.push_byte((port >> 8) & 255)
    out.push_byte(port & 255)
    << out
}

fn unpack_udp_packet(raw string) UDPPacket {
    if raw.len < 6 {
        >> errors.new("net: short datagram")
    }
    ip := raw[0:4]
    hi := raw[4] & 255
    lo := raw[5] & 255
    port := (hi << 8) | lo
    mut data := ""
    if raw.len > 6 {
        data = raw[6:raw.len]
    }
    << UDPPacket{addr: UDPAddr{ip: ip, port: port, zone: ""}, data: data}
}

pub fn (c PacketConn) local_addr() string {
    << c.laddr + ""
}

pub fn (c PacketConn) remote_addr() string {
    << c.raddr + ""
}

// Connected packet I/O uses socket recv/send so the Windows path reaches
// Winsock rather than the file-handle WriteFile/ReadFile helpers.
pub fn (c &PacketConn) read(max int) string {
    if c.fd < 0 {
        >> errors.new("net: use of closed packet connection")
    }
    if c.raddr.len == 0 {
        >> errors.new("net: read requires connected packet connection")
    }
    << os.socket_read(c.fd, max) or >>
}

pub fn (c &PacketConn) write(data &string) int {
    if c.fd < 0 {
        >> errors.new("net: use of closed packet connection")
    }
    if c.raddr.len == 0 {
        >> errors.new("net: write requires connected packet connection")
    }
    << os.socket_write(c.fd, data + "") or >>
}

pub fn (c PacketConn) read_from(max int) UDPPacket {
    if max < 0 {
        >> errors.new("net: invalid buffer size")
    }
    raw := os.recvfrom(c.fd, max) or >>
    << unpack_udp_packet(raw)
}

pub fn (c PacketConn) write_to(data &string, addr &UDPAddr) int {
    packed := pack_udp4_addr(addr.ip + "", addr.port)
    << os.sendto(c.fd, packed, data + "") or >>
}

pub fn (c &mut PacketConn) close() int {
    if c.fd < 0 {
        << 0
    }
    fd := c.fd
    c.fd = -1
    os.socket_close(fd) or >>
    << 0
}

pub fn dial_udp(network string, laddr UDPAddr, raddr UDPAddr) PacketConn {
    kind := parse_network_kind(&network)
    if kind != "udp" {
        >> errors.new("unknown network " + network)
    }
    if laddr.port < 0 || raddr.port < 0 {
        >> errors.new("net: invalid address")
    }
    mut fd := 0
    if network_ip_version(&network) == 6 || (network_ip_version(&network) == 0 && raddr.ip.len == 16 && ip_to4(&raddr.ip).len == 0) {
        fd = dial_udp6_raw(&laddr, &raddr)
    } else {
        fd = dial_udp4_raw(&laddr, &raddr)
    }
    local_text := laddr.clone().to_string()
    remote_text := raddr.clone().to_string()
    << PacketConn{fd: fd, network: network + "", laddr: local_text, raddr: remote_text}
}

pub fn listen_udp(network string, laddr UDPAddr) PacketConn {
    kind := parse_network_kind(&network)
    if kind != "udp" {
        >> errors.new("unknown network " + network)
    }
    if laddr.port < 0 {
        >> errors.new("net: invalid address")
    }
    if network_ip_version(&network) == 6 {
        >> errors.new("net: IPv6 UDP not supported")
    }
    mut ip := laddr.ip + ""
    if ip.len == 0 {
        ip = ipv4_zero()
    }
    v4 := ip_to4(&ip)
    if v4.len != 4 {
        >> errors.new("net: UDP needs IPv4")
    }
    a := v4[0] & 255
    b := v4[1] & 255
    c := v4[2] & 255
    d := v4[3] & 255
    fd := sys_listen_udp4(a, b, c, d, laddr.port)
    loc := laddr.to_string()
    << PacketConn{fd: fd, network: "udp", laddr: loc, raddr: ""}
}

fn (c &mut PacketConn) drop() { c.close() or (err) { << } }
