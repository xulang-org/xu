@net

#errors
#os

// UDP types (Go UDPConn / PacketConn). Datagram I/O is IPv4; socket/bind
// composition lives in runtime.xu. Packed peer: 4-byte IP + 2-byte BE port.

pub struct PacketConn {
    fd int
    pub network string
    pub laddr string
    pub raddr string
    read_deadline_ns int
    write_deadline_ns int
}

fn packet_conn_new(fd int, network string, laddr string, raddr string) PacketConn {
    << PacketConn{
        fd: fd,
        network: network,
        laddr: laddr,
        raddr: raddr,
        read_deadline_ns: 0,
        write_deadline_ns: 0
    }
}

pub struct UDPPacket {
    pub addr UDPAddr
    pub data string
}

fn pack_udp_addr(ip string, port int) string {
    if port < 0 || port > 65535 {
        >>> errors.new("net: invalid port")
    }
    v4 := ip_to4(&ip)
    if v4.len == 4 {
        a := v4[0] & 255
        b := v4[1] & 255
        c := v4[2] & 255
        d := v4[3] & 255
        $out := ""
        out.push_byte(4)
        out.push_byte((port >> 8) & 255)
        out.push_byte(port & 255)
        out.push_byte(a)
        out.push_byte(b)
        out.push_byte(c)
        out.push_byte(d)
        << out
    }
    if ip.len == 16 {
        $out := ""
        out.push_byte(6)
        out.push_byte((port >> 8) & 255)
        out.push_byte(port & 255)
        for i in 0:16 {
            out.push_byte(ip[i] & 255)
        }
        << out
    }
    >>> errors.new("net: invalid IP address")
}

fn pack_udp4_addr(ip string, port int) string {
    << pack_udp_addr(ip, port)
}

fn unpack_udp_packet(raw string) UDPPacket {
    if raw.len == 0 {
        >>> errors.new("net: short datagram")
    }
    tag := raw[0] & 255
    if tag == 4 && raw.len >= 7 {
        port := ((raw[1] & 255) << 8) | (raw[2] & 255)
        ip := raw[3:7]
        $data := ""
        if raw.len > 7 {
            data = raw[7:raw.len]
        }
        << UDPPacket{addr: UDPAddr{ip: ip, port: port, zone: ""}, data: data}
    }
    if tag == 6 && raw.len >= 19 {
        port := ((raw[1] & 255) << 8) | (raw[2] & 255)
        ip := raw[3:19]
        $data := ""
        if raw.len > 19 {
            data = raw[19:raw.len]
        }
        << UDPPacket{addr: UDPAddr{ip: ip, port: port, zone: ""}, data: data}
    }
    if raw.len >= 6 {
        ip := raw[0:4]
        hi := raw[4] & 255
        lo := raw[5] & 255
        port := (hi << 8) | lo
        $data := ""
        if raw.len > 6 {
            data = raw[6:raw.len]
        }
        << UDPPacket{addr: UDPAddr{ip: ip, port: port, zone: ""}, data: data}
    }
    >>> errors.new("net: short datagram")
}

pub fn (c PacketConn) local_addr() string {
    if c.laddr.len > 0 && !(c.laddr.len >= 2 && c.laddr[c.laddr.len - 2:c.laddr.len] == ":0") {
        << c.laddr + ""
    }
    if c.fd >= 0 {
        raw := getsockname_safe(c.fd)
        if raw.len > 0 {
            addr := unpack_sockaddr(raw)
            if addr.len > 0 { << addr }
        }
    }
    << c.laddr + ""
}

pub fn (c PacketConn) remote_addr() string {
    << c.raddr + ""
}

pub fn (c $&PacketConn) set_deadline(t_ns int) int {
    c.read_deadline_ns = t_ns
    c.write_deadline_ns = t_ns
    if t_ns <= 0 && c.fd >= 0 {
        clear_sock_timeout(c.fd)
    }
    << 0
}

pub fn (c $&PacketConn) set_read_deadline(t_ns int) int {
    c.read_deadline_ns = t_ns
    if t_ns <= 0 && c.fd >= 0 {
        clear_sock_timeout(c.fd)
    }
    << 0
}

pub fn (c $&PacketConn) set_write_deadline(t_ns int) int {
    c.write_deadline_ns = t_ns
    if t_ns <= 0 && c.fd >= 0 {
        clear_sock_timeout(c.fd)
    }
    << 0
}

pub fn (c &PacketConn) set_broadcast(on bool) int {
    if c.fd < 0 {
        >>> errors.new("net: use of closed packet connection")
    }
    $v := 0
    if on { v = 1 }
    << os.setsockopt_int(c.fd, sol_socket(), so_broadcast(), v) >>>
}

pub fn (c &PacketConn) set_read_buffer(bytes int) int {
    if c.fd < 0 {
        >>> errors.new("net: use of closed packet connection")
    }
    if bytes <= 0 {
        >>> errors.new("net: invalid buffer size")
    }
    << os.setsockopt_int(c.fd, sol_socket(), so_rcvbuf(), bytes) >>>
}

pub fn (c &PacketConn) set_write_buffer(bytes int) int {
    if c.fd < 0 {
        >>> errors.new("net: use of closed packet connection")
    }
    if bytes <= 0 {
        >>> errors.new("net: invalid buffer size")
    }
    << os.setsockopt_int(c.fd, sol_socket(), so_sndbuf(), bytes) >>>
}

// Connected packet I/O uses socket recv/send so the Windows path reaches
// Winsock rather than the file-handle WriteFile/ReadFile helpers.
pub fn (c &PacketConn) read(max int) string {
    if c.fd < 0 {
        >>> errors.new("net: use of closed packet connection")
    }
    if c.raddr.len == 0 {
        >>> errors.new("net: read requires connected packet connection")
    }
    apply_sock_deadline(c.fd, c.read_deadline_ns) >>>
    << os.socket_read(c.fd, max) >>>
}

pub fn (c &PacketConn) write(data &string) int {
    if c.fd < 0 {
        >>> errors.new("net: use of closed packet connection")
    }
    if c.raddr.len == 0 {
        >>> errors.new("net: write requires connected packet connection")
    }
    apply_sock_deadline(c.fd, c.write_deadline_ns) >>>
    << os.socket_write(c.fd, data + "") >>>
}

pub fn (c &PacketConn) read_from(max int) UDPPacket {
    if c.fd < 0 {
        >>> errors.new("net: use of closed packet connection")
    }
    if max < 0 {
        >>> errors.new("net: invalid buffer size")
    }
    apply_sock_deadline(c.fd, c.read_deadline_ns) >>>
    raw := os.recvfrom(c.fd, max) >>>
    << unpack_udp_packet(raw)
}

pub fn (c &PacketConn) write_to(data &string, addr &UDPAddr) int {
    if c.fd < 0 {
        >>> errors.new("net: use of closed packet connection")
    }
    apply_sock_deadline(c.fd, c.write_deadline_ns) >>>
    packed := pack_udp_addr(addr.ip + "", addr.port)
    << os.sendto(c.fd, packed, data + "") >>>
}

pub fn (c $&PacketConn) close() int {
    if c.fd < 0 {
        << 0
    }
    fd := c.fd
    c.fd = -1
    os.socket_close(fd) >>>
    << 0
}

pub fn dial_udp(network string, laddr UDPAddr, raddr UDPAddr) PacketConn {
    kind := parse_network_kind(&network)
    if kind != "udp" {
        >>> errors.new("unknown network " + network)
    }
    if laddr.port < 0 || raddr.port < 0 {
        >>> errors.new("net: invalid address")
    }
    $fd := 0
    if network_ip_version(&network) == 6 || (network_ip_version(&network) == 0 && raddr.ip.len == 16 && ip_to4(&raddr.ip).len == 0) {
        fd = dial_udp6_raw(&laddr, &raddr)
    } else {
        fd = dial_udp4_raw(&laddr, &raddr)
    }
    local_text := laddr.clone().to_string()
    remote_text := raddr.clone().to_string()
    << packet_conn_new(fd, network + "", local_text, remote_text)
}

pub fn listen_udp_config(network string, laddr UDPAddr, reuse bool) PacketConn {
    kind := parse_network_kind(&network)
    if kind != "udp" {
        >>> errors.new("unknown network " + network)
    }
    if laddr.port < 0 {
        >>> errors.new("net: invalid address")
    }
    ver := network_ip_version(&network)
    $use6 := ver == 6
    if ver == 0 && laddr.ip.len == 16 && ip_to4(&laddr.ip).len == 0 {
        use6 = true
    }
    $fd := -1
    if use6 {
        $ip := laddr.ip + ""
        if ip.len == 0 {
            ip = ipv6_unspecified()
        }
        if ip.len != 16 {
            >>> errors.new("net: UDP needs IPv6")
        }
        fd = sys_listen_udp6_reuse(ip, laddr.port, reuse) >>>
    } else {
        $ip := laddr.ip + ""
        if ip.len == 0 {
            ip = ipv4_zero()
        }
        v4 := ip_to4(&ip)
        if v4.len != 4 {
            >>> errors.new("net: UDP needs IPv4")
        }
        a := v4[0] & 255
        b := v4[1] & 255
        c := v4[2] & 255
        d := v4[3] & 255
        fd = sys_listen_udp4_reuse(a, b, c, d, laddr.port, reuse) >>>
    }
    $loc := laddr.to_string()
    if laddr.port == 0 && fd >= 0 {
        raw := getsockname_safe(fd)
        if raw.len > 0 {
            addr := unpack_sockaddr(raw)
            if addr.len > 0 { loc = addr }
        }
    }
    << packet_conn_new(fd, network + "", loc, "")
}

pub fn listen_udp(network string, laddr UDPAddr) PacketConn {
    << listen_udp_config(network, laddr, false)
}

fn (c $&PacketConn) drop() { c.close() >>> (err) { << } }
