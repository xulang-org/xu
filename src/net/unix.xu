@net

#errors

// Unix domain stream sockets (Go UnixConn / UnixListener). Pathname sockets
// are hosted on Darwin/Linux. Windows stays an explicit unsupported target.

fn require_unix_stream(network string) UnixAddr {
    a := resolve_unix_addr(network, "")
    if a.network != "unix" {
        >> errors.new("net: only unix stream sockets are supported")
    }
    << a
}

pub fn dial_unix(network string, laddr UnixAddr, raddr UnixAddr) Conn {
    _ := require_unix_stream(network + "") or >>
    a := resolve_unix_addr(network, raddr.name + "")
    if a.name.len == 0 {
        >> errors.new("net: unix socket path is empty")
    }
    if xu_target_os() == 2 {
        >> errors.new("net: unix sockets are not available on this target")
    }
    fd := sys_dial_unix(laddr.name + "", a.name + "") or >>
    << conn_new(fd, "unix", laddr.name + "", a.name + "")
}

pub fn listen_unix(network string, laddr UnixAddr) Listener {
    _ := require_unix_stream(network + "") or >>
    a := resolve_unix_addr(network, laddr.name + "")
    if a.name.len == 0 {
        >> errors.new("net: unix socket path is empty")
    }
    if xu_target_os() == 2 {
        >> errors.new("net: unix sockets are not available on this target")
    }
    fd := sys_listen_unix(a.name + "") or >>
    << Listener{fd: fd, network: "unix", addr: a.name + ""}
}
