@net

#errors
#os

// IPv4 UDP multicast (Go ListenMulticastUDP shape). Option numbers differ per
// host ABI: Darwin and Winsock share the BSD values, Linux has its own.

const IPPROTO_IP = 0

fn sol_socket() int {
    if xu_target_os() == 1 { << 1 }
    << 65535
}

fn so_reuseaddr() int {
    if xu_target_os() == 1 { << 2 }
    << 4
}

// 0 where the host has no SO_REUSEPORT (Winsock: SO_REUSEADDR already
// permits several multicast listeners on one port).
fn so_reuseport() int {
    os := xu_target_os()
    if os == 0 { << 512 }
    if os == 1 { << 15 }
    << 0
}

fn ip_multicast_if() int {
    if xu_target_os() == 1 { << 32 }
    << 9
}

fn ip_multicast_ttl() int {
    if xu_target_os() == 1 { << 33 }
    << 10
}

fn ip_multicast_loop() int {
    if xu_target_os() == 1 { << 34 }
    << 11
}

fn ip_add_membership() int {
    if xu_target_os() == 1 { << 35 }
    << 12
}

fn ip_drop_membership() int {
    if xu_target_os() == 1 { << 36 }
    << 13
}

// Darwin takes u_char for IP_MULTICAST_TTL/LOOP; Linux and Winsock take int.
fn multicast_byte_opt(fd int, opt int, v int) int {
    if xu_target_os() == 0 {
        $b := ""
        b.push_byte(v & 255)
        << os.setsockopt(fd, IPPROTO_IP, opt, b) or >>
    }
    << os.setsockopt_int(fd, IPPROTO_IP, opt, v) or >>
}

// Interface address text ("" = any) → 4 raw bytes, network order.
fn iface_v4(iface_ip &string) string {
    if iface_ip.len == 0 {
        << ipv4_zero()
    }
    parsed := parse_ip(iface_ip)
    v4 := ip_to4(&parsed)
    if v4.len != 4 {
        >> errors.new("net: multicast interface must be IPv4")
    }
    << v4
}

fn group_v4(group &string) string {
    v4 := ip_to4(group)
    if v4.len != 4 || !ip_is_multicast(&v4) {
        >> errors.new("net: not an IPv4 multicast group")
    }
    << v4
}

fn ip_mreq(group &string, iface &string) string {
    << group + iface
}

// listen_multicast_udp binds 0.0.0.0:gaddr.port with address/port reuse, so
// it can share the port with a system responder (e.g. mDNS on 5353), and
// joins gaddr on the default interface. Use join_group for more interfaces.
pub fn listen_multicast_udp(network string, gaddr UDPAddr) PacketConn {
    kind := parse_network_kind(&network)
    if kind != "udp" || network_ip_version(&network) == 6 {
        >> errors.new("net: multicast supports udp4 only: " + network)
    }
    if gaddr.port <= 0 || gaddr.port > 65535 {
        >> errors.new("net: invalid multicast port")
    }
    group := group_v4(&gaddr.ip) or >>
    fd := os.socket(AF_INET, SOCK_DGRAM, 0) or >>
    os.setsockopt_int(fd, sol_socket(), so_reuseaddr(), 1) or (err) {
        close_quiet(fd)
        >> err
    }
    rp := so_reuseport()
    if rp != 0 {
        os.setsockopt_int(fd, sol_socket(), rp, 1) or (err) {
            close_quiet(fd)
            >> err
        }
    }
    os.bind4(fd, 0, 0, 0, 0, gaddr.port) or (err) {
        close_quiet(fd)
        >> err
    }
    wildcard := ipv4_zero()
    os.setsockopt(fd, IPPROTO_IP, ip_add_membership(), ip_mreq(&group, &wildcard)) or (err) {
        close_quiet(fd)
        >> err
    }
    laddr := UDPAddr{ip: ipv4_zero(), port: gaddr.port, zone: ""}
    << PacketConn{fd: fd, network: "udp4", laddr: laddr.to_string(), raddr: ""}
}

pub fn (c &PacketConn) join_group(group string, iface_ip string) int {
    if c.fd < 0 { >> errors.new("net: use of closed packet connection") }
    parsed := parse_ip(&group)
    g := group_v4(&parsed) or >>
    i := iface_v4(&iface_ip) or >>
    << os.setsockopt(c.fd, IPPROTO_IP, ip_add_membership(), ip_mreq(&g, &i)) or >>
}

pub fn (c &PacketConn) leave_group(group string, iface_ip string) int {
    if c.fd < 0 { >> errors.new("net: use of closed packet connection") }
    parsed := parse_ip(&group)
    g := group_v4(&parsed) or >>
    i := iface_v4(&iface_ip) or >>
    << os.setsockopt(c.fd, IPPROTO_IP, ip_drop_membership(), ip_mreq(&g, &i)) or >>
}

// Outgoing multicast interface by IPv4 address ("" = system default).
pub fn (c &PacketConn) set_multicast_interface(iface_ip string) int {
    if c.fd < 0 { >> errors.new("net: use of closed packet connection") }
    i := iface_v4(&iface_ip) or >>
    << os.setsockopt(c.fd, IPPROTO_IP, ip_multicast_if(), i) or >>
}

pub fn (c &PacketConn) set_multicast_ttl(ttl int) int {
    if c.fd < 0 { >> errors.new("net: use of closed packet connection") }
    if ttl < 0 || ttl > 255 { >> errors.new("net: multicast TTL out of range") }
    << multicast_byte_opt(c.fd, ip_multicast_ttl(), ttl) or >>
}

pub fn (c &PacketConn) set_multicast_loopback(on bool) int {
    if c.fd < 0 { >> errors.new("net: use of closed packet connection") }
    $v := 0
    if on { v = 1 }
    << multicast_byte_opt(c.fd, ip_multicast_loop(), v) or >>
}
