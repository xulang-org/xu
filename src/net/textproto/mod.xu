@net/textproto


#errors
#strings

// Text protocol helpers aligned with Go `net/textproto`:
// CanonicalMIMEHeaderKey, TrimString, ReadMIMEHeader (from an owning
// string), and a status-line parse (SMTP/HTTP-style `250 OK` / `250-`).
// No map: MIMEHeader uses parallel keys/vals.

pub struct MIMEHeader {
    pub keys []string
    pub vals []string
}

pub struct HeaderRead {
    pub header MIMEHeader
    pub rest string
}

pub struct CodeLine {
    pub code int
    pub msg string
    pub cont bool
}

fn is_token(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 {
        << true
    }
    if c == 42 || c == 43 || c == 45 || c == 46 {
        << true
    }
    if c == 94 || c == 95 || c == 96 || c == 124 || c == 126 {
        << true
    }
    << false
}

pub fn canonical_mime_header_key(s &string) string {
    src := s + ""
    if src.len == 0 {
        << ""
    }
    $upper := 1
    $need := 0
    for i in 0:src.len {
        c := src[i] & 255
        if !is_token(c) {
            << src
        }
        if upper == 1 {
            if c >= 97 && c <= 122 {
                need = 1
            }
        } else {
            if c >= 65 && c <= 90 {
                need = 1
            }
        }
        if c == 45 {
            upper = 1
        } else {
            upper = 0
        }
    }
    if need == 0 {
        << src
    }
    $out := ""
    upper = 1
    for i in 0:src.len {
        $c := src[i] & 255
        if upper == 1 {
            if c >= 97 && c <= 122 {
                c = c - 32
            }
            upper = 0
        } else {
            if c >= 65 && c <= 90 {
                c = c + 32
            }
        }
        if c == 45 {
            upper = 1
        }
        out.push_byte(c)
    }
    << out
}

pub fn trim_string(s &string) string {
    src := s + ""
    $i := 0
    $j := src.len
    while i < j {
        c := src[i] & 255
        if c == 32 || c == 9 {
            i = i + 1
        } else {
            <-
        }
    }
    while j > i {
        c := src[j - 1] & 255
        if c == 32 || c == 9 {
            j = j - 1
        } else {
            <-
        }
    }
    if j > i {
        << src[i:j] + ""
    }
    << ""
}

fn line_after(s &string, start int) int {
    $i := start
    while i < s.len {
        if (s[i] & 255) == 10 {
            << i + 1
        }
        i = i + 1
    }
    << s.len
}

fn line_text(s &string, start int, after int) string {
    text := s + ""
    $end := after
    if end > start && (text[end - 1] & 255) == 10 {
        end = end - 1
    }
    if end > start && (text[end - 1] & 255) == 13 {
        end = end - 1
    }
    if end > start {
        << text[start:end] + ""
    }
    << ""
}

pub fn new_header() MIMEHeader {
    << MIMEHeader{keys: []string{}, vals: []string{}}
}

pub fn (h MIMEHeader) get(key &string) string {
    ck := canonical_mime_header_key(key)
    for i in 0:h.keys.len {
        if h.keys[i] == ck {
            << h.vals[i] + ""
        }
    }
    << ""
}

pub fn (h MIMEHeader) values(key &string) []string {
    ck := canonical_mime_header_key(key)
    $out := []string{}
    for i in 0:h.keys.len {
        if h.keys[i] == ck {
            out.push(h.vals[i] + "")
        }
    }
    << out
}

pub fn (h $&MIMEHeader) add(key &string, value &string) {
    h.keys.push(canonical_mime_header_key(key))
    h.vals.push(value + "")
}

pub fn (h $&MIMEHeader) del(key &string) {
    ck := canonical_mime_header_key(key)
    $nkeys := []string{}
    $nvals := []string{}
    for i in 0:h.keys.len {
        if h.keys[i] != ck {
            nkeys.push(h.keys[i] + "")
            nvals.push(h.vals[i] + "")
        }
    }
    h.keys = nkeys
    h.vals = nvals
}

pub fn (h $&MIMEHeader) set(key &string, value &string) {
    h.del(key)
    h.add(key, value)
}

pub fn (h MIMEHeader) len() int {
    << h.keys.len
}

pub fn (h MIMEHeader) clone() MIMEHeader {
    $k := []string{}
    $v := []string{}
    $i := 0
    while i < h.keys.len {
        k.push(h.keys[i] + "")
        v.push(h.vals[i] + "")
        i = i + 1
    }
    << MIMEHeader{keys: k, vals: v}
}

pub fn read_mime_header(src &string) HeaderRead {
    s := src + ""
    $keys := []string{}
    $vals := []string{}
    $i := 0
    $rest := ""
    $done := 0
    while done == 0 && i < s.len {
        nxt := line_after(&s, i)
        ln := line_text(&s, i, nxt)
        if ln.len == 0 {
            rest = s[nxt:s.len] + ""
            done = 1
        } else {
            c0 := ln[0] & 255
            if (c0 == 32 || c0 == 9) && keys.len > 0 {
                t := trim_string(&ln)
                last := keys.len - 1
                prev := vals[last] + ""
                vals[last] = prev + " " + t
            } else {
                col := strings.index_of(&ln, ":")
                if col > 0 {
                    kpart := ln[0:col] + ""
                    vpart := ln[(col + 1):ln.len] + ""
                    k := canonical_mime_header_key(&kpart)
                    v := trim_string(&vpart)
                    keys.push(k)
                    vals.push(v)
                }
            }
            i = nxt
        }
    }
    if done == 0 {
        rest = ""
    }
    << HeaderRead{header: MIMEHeader{keys: keys, vals: vals}, rest: rest}
}

pub fn parse_code_line(line &string) CodeLine {
    src := trim_string(line)
    if src.len < 3 {
        >> errors.new("textproto: short response")
    }
    c0 := src[0] & 255
    c1 := src[1] & 255
    c2 := src[2] & 255
    if c0 < 48 || c0 > 57 || c1 < 48 || c1 > 57 || c2 < 48 || c2 > 57 {
        >> errors.new("textproto: not a code")
    }
    code := (c0 - 48) * 100 + (c1 - 48) * 10 + (c2 - 48)
    $cont := false
    $msg := ""
    if src.len > 3 {
        sep := src[3] & 255
        if sep == 45 {
            cont = true
        } else if sep != 32 {
            >> errors.new("textproto: malformed code line")
        }
        if src.len > 4 {
            msg = src[4:src.len] + ""
        }
    }
    << CodeLine{code: code, msg: msg, cont: cont}
}
