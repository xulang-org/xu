@net/url

#errors
#path
#strings

// net.url — URL parsing and escaping, same slot as Go `net/url`.
// RFC 3986 subset: scheme, authority host, path, raw query, fragment.
// No userinfo and no URL.Query() Values map (Xu has no map type):
// parse_query returns decoded "key=value" pairs instead ('=' always
// present, so the caller can split deterministically). string() re-emits
// the stored raw components verbatim (Go escapes the path in String();
// our components round-trip exactly — documented simplification).
// All parsing is bounds-checked; failures throw — never a partial URL.

// Maximum raw URL size accepted by parse, in bytes.
const MAX_URL_BYTES = 1048576

const HEX = "0123456789ABCDEF"

pub struct URL {
    pub scheme string
    pub host string
    pub path string
    pub raw_query string
    pub fragment string
    pub has_auth bool
}

pub fn (u URL) scheme() string {
    << u.scheme + ""
}

pub fn (u URL) host() string {
    << u.host + ""
}

pub fn (u URL) path() string {
    << u.path + ""
}

pub fn (u URL) raw_query() string {
    << u.raw_query + ""
}

pub fn (u URL) fragment() string {
    << u.fragment + ""
}

pub fn (u URL) query() Query {
    $q := new_query()
    raw := u.raw_query + ""
    q.parse(raw) or >>
    << q
}

pub fn (u URL) hostname() string {
    h := u.host + ""
    if h.len == 0 {
        << ""
    }
    if (h[0] & 255) == 91 {
        $i := 1
        while i < h.len {
            if (h[i] & 255) == 93 {
                << h[1:i]
            }
            i = i + 1
        }
        << h
    }
    $colon := 0 - 1
    $i := 0
    while i < h.len {
        if (h[i] & 255) == 58 {
            colon = i
        }
        i = i + 1
    }
    if colon < 0 {
        << h
    }
    << h[0:colon]
}

pub fn (u URL) port() string {
    h := u.host + ""
    if h.len == 0 {
        << ""
    }
    if (h[0] & 255) == 91 {
        $i := 1
        while i < h.len {
            if (h[i] & 255) == 93 {
                if i + 1 < h.len {
                    if (h[i + 1] & 255) == 58 {
                        << h[(i + 2):h.len]
                    }
                }
                << ""
            }
            i = i + 1
        }
        << ""
    }
    $colon := 0 - 1
    $i := 0
    while i < h.len {
        if (h[i] & 255) == 58 {
            colon = i
        }
        i = i + 1
    }
    if colon < 0 {
        << ""
    }
    << h[(colon + 1):h.len]
}

pub fn (u URL) request_uri() string {
    $p := u.path + ""
    if p.len == 0 {
        p = "/"
    }
    q := u.raw_query + ""
    if q.len == 0 {
        << p
    }
    << p + "?" + q
}

pub fn (u URL) join_path(elem <-> string) URL {
    $p := u.path + ""
    $i := 0
    while i < elem.len {
        e := elem[i] + ""
        if e.len == 0 {
            i = i + 1
            ->
        }
        if p.len == 0 {
            p = e
        } else if (p[p.len - 1] & 255) == 47 {
            if (e[0] & 255) == 47 {
                p = p + e[1:e.len]
            } else {
                p = p + e
            }
        } else {
            if (e[0] & 255) == 47 {
                p = p + e
            } else {
                p = p + "/" + e
            }
        }
        i = i + 1
    }
    $slash := false
    if p.len > 0 {
        if (p[p.len - 1] & 255) == 47 {
            slash = true
        }
    }
    $cleaned := path.clean(&p)
    if slash {
        if cleaned.len == 0 {
            cleaned = "/"
        } else if (cleaned[cleaned.len - 1] & 255) != 47 {
            cleaned = cleaned + "/"
        }
    }
    << URL{
        scheme: u.scheme + "",
        host: u.host + "",
        path: cleaned,
        raw_query: u.raw_query + "",
        fragment: u.fragment + "",
        has_auth: u.has_auth
    }
}

fn is_scheme_char(c int) bool {
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 43 || c == 45 || c == 46 {
        << true
    }
    << false
}

fn hex_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

fn url_throw(msg string) URL {
    >> errors.new(msg)
    << new_url()
}

// new_url returns an empty URL for in-place parse().
pub fn new_url() URL {
    << URL{scheme: "", host: "", path: "", raw_query: "", fragment: "", has_auth: false}
}

pub fn parse_url(s string) URL {
    $u := new_url()
    u.parse(s) or (err) {
        << new_url()
    }
    << u
}

// parse fills u from a raw URL (RFC 3986 appendix B shape:
// scheme://host/path?query#fragment). On error the URL keeps its previous
// components — never a partial parse result.
pub fn (u $&URL) parse(s string) int {
    if s.len > MAX_URL_BYTES {
        >> errors.new("net/url: url larger than " + str(MAX_URL_BYTES) + " bytes")
    }
    for i in 0:s.len {
        c := s[i]
        if c <= 32 || c == 127 {
            >> errors.new("net/url: invalid control character in url")
        }
    }
    $i := 0
    // scheme: letters/digits/+-. followed by ':' before temp '/', '?', '#'.
    $sc := -1
    for j in i:s.len {
        c := s[j]
        if c == 58 {
            sc = j
            <-
        }
        if c == 47 || c == 63 || c == 35 {
            <-
        }
    }
    if sc >= 0 {
        if sc == 0 {
            >> errors.new("net/url: missing protocol scheme")
        }
        first := s[0]
        if !((first >= 97 && first <= 122) || (first >= 65 && first <= 90)) {
            >> errors.new("net/url: invalid protocol scheme")
        }
        for j in 0:sc {
            if !is_scheme_char(s[j]) {
                >> errors.new("net/url: invalid protocol scheme")
            }
        }
        u.scheme = s[0:sc] + ""
        i = sc + 1
    }
    // authority: //host until '/', '?', '#'.
    if s.len - i >= 2 && s[i] == 47 && s[i + 1] == 47 {
        u.has_auth = true
        i += 2
        start := i
        while i < s.len {
            c := s[i]
            if c == 47 || c == 63 || c == 35 {
                <-
            }
            i += 1
        }
        u.host = s[start:i] + ""
    }
    // path
    start := i
    while i < s.len {
        c := s[i]
        if c == 63 || c == 35 {
            <-
        }
        i += 1
    }
    u.path = s[start:i] + ""
    // query
    if i < s.len && s[i] == 63 {
        i += 1
        qstart := i
        while i < s.len {
            c := s[i]
            if c == 35 {
                <-
            }
            i += 1
        }
        u.raw_query = s[qstart:i] + ""
    }
    // fragment
    if i < s.len && s[i] == 35 {
        i += 1
        u.fragment = s[i:s.len] + ""
    }
    << 0
}

// to_string re-emits the URL from its stored components (Go URL.String).
pub fn (u URL) to_string() string {
    $out := ""
    if u.scheme.len > 0 {
        out = u.scheme + ":"
    }
    if u.has_auth {
        out = out + "//" + u.host
    }
    out = out + u.path
    if u.raw_query.len > 0 {
        out = out + "?" + u.raw_query
    }
    if u.fragment.len > 0 {
        out = out + "#" + u.fragment
    }
    << out
}

fn unescape(s &string) string {
    $out := ""
    $i := 0
    while i < s.len {
        c := s[i]
        if c == 43 {
            out.push_byte(32)
            i += 1
        } else if c == 37 {
            if s.len - i < 3 {
                >> errors.new("net/url: invalid URL escape")
            }
            hi := hex_val(s[i + 1])
            lo := hex_val(s[i + 2])
            if hi < 0 || lo < 0 {
                >> errors.new("net/url: invalid URL escape")
            }
            out.push_byte((hi * 16 + lo) & 255)
            i += 3
        } else {
            out.push_byte(c & 255)
            i += 1
        }
    }
    << out
}

pub struct Query {
    pub pairs []string
}

pub fn new_query() Query {
    << Query{pairs: []string{}}
}

pub fn (q Query) len() int {
    << q.pairs.len
}

pub fn (q Query) at(i int) string {
    << q.pairs[i] + ""
}

// parse decodes a query string into "key=value" pairs ('+' is a space,
// %XX are unescaped; '=' always present). Bad escapes throw — never a
// partial result. Caller-owned Query: pairs live in q.
pub fn (q $&Query) parse(query string) int {
    q.pairs = []string{}
    $out := []string{}
    if query.len == 0 {
        q.pairs = out
        << 0
    }
    $start := 0
    $i := 0
    while i <= query.len {
        if i == query.len || query[i] == 38 { // '&'
            pair := query[start:i]
            $eq := -1
            for j in 0:pair.len {
                if pair[j] == 61 {
                    eq = j
                    <-
                }
            }
            if eq < 0 {
                k := unescape(&pair) or >>
                out.push(k + "=")
            } else {
                ks := pair[0:eq] + ""
                vs := pair[eq + 1:pair.len] + ""
                k2 := unescape(&ks) or >>
                v2 := unescape(&vs) or >>
                out.push(k2 + "=" + v2)
            }
            i += 1
            start = i
        } else {
            i += 1
        }
    }
    q.pairs = out
    << 0
}

// query_escape percent-encodes for a query component: unreserved
// (a-Za-z0-9-._~) kept, space becomes '+', everything else %XX.
pub fn query_unescape(s &string) string {
    << unescape(s) or >>
}

fn unescape_path(s &string) string {
    $out := ""
    $i := 0
    while i < s.len {
        c := s[i]
        if c == 37 {
            if s.len - i < 3 {
                >> errors.new("net/url: invalid URL escape")
            }
            hi := hex_val(s[i + 1])
            lo := hex_val(s[i + 2])
            if hi < 0 || lo < 0 {
                >> errors.new("net/url: invalid URL escape")
            }
            out.push_byte((hi * 16 + lo) & 255)
            i += 3
        } else {
            out.push_byte(c & 255)
            i += 1
        }
    }
    << out
}

pub fn path_unescape(s &string) string {
    << unescape_path(s) or >>
}

pub fn (q Query) get(key string) string {
    k := key + ""
    $i := 0
    while i < q.pairs.len {
        p := q.pairs[i]
        eq := k.len
        if p.len > eq {
            if (p[eq] & 255) == 61 {
                $ok := true
                $j := 0
                while j < k.len {
                    if (p[j] & 255) != (k[j] & 255) {
                        ok = false
                        <-
                    }
                    j = j + 1
                }
                if ok {
                    << p[(eq + 1):p.len] + ""
                }
            }
        }
        i = i + 1
    }
    << ""
}

pub fn (q $&Query) set(key string, val string) {
    k := key + ""
    v := val + ""
    pair := k + "=" + v
    $i := 0
    while i < q.pairs.len {
        p := q.pairs[i]
        eq := k.len
        if p.len > eq {
            if (p[eq] & 255) == 61 {
                $ok := true
                $j := 0
                while j < k.len {
                    if (p[j] & 255) != (k[j] & 255) {
                        ok = false
                        <-
                    }
                    j = j + 1
                }
                if ok {
                    q.pairs[i] = pair
                    <<
                }
            }
        }
        i = i + 1
    }
    q.pairs.push(pair)
}

pub fn (q $&Query) add(key string, val string) {
    k := key + ""
    v := val + ""
    q.pairs.push(k + "=" + v)
}

pub fn (q $&Query) del(key string) {
    k := key + ""
    $out := []string{}
    $i := 0
    while i < q.pairs.len {
        p := q.pairs[i]
        eq := k.len
        $keep := true
        if p.len > eq {
            if (p[eq] & 255) == 61 {
                $ok := true
                $j := 0
                while j < k.len {
                    if (p[j] & 255) != (k[j] & 255) {
                        ok = false
                        <-
                    }
                    j = j + 1
                }
                if ok {
                    keep = false
                }
            }
        }
        if keep {
            out.push(p + "")
        }
        i = i + 1
    }
    q.pairs = out
}

fn pair_key(p &string) string {
    $i := 0
    while i < p.len {
        if (p[i] & 255) == 61 {
            << p[0:i] + ""
        }
        i = i + 1
    }
    << p + ""
}

fn pair_val(p &string) string {
    $i := 0
    while i < p.len {
        if (p[i] & 255) == 61 {
            << p[(i + 1):p.len] + ""
        }
        i = i + 1
    }
    << ""
}

pub fn (q Query) has(key string) bool {
    k := key + ""
    $i := 0
    while i < q.pairs.len {
        p := q.pairs[i]
        eq := k.len
        if p.len > eq {
            if (p[eq] & 255) == 61 {
                $ok := true
                $j := 0
                while j < k.len {
                    if (p[j] & 255) != (k[j] & 255) {
                        ok = false
                        <-
                    }
                    j = j + 1
                }
                if ok {
                    << true
                }
            }
        }
        i = i + 1
    }
    << false
}

pub fn (q Query) encode() string {
    n := q.pairs.len
    $keys := []string{}
    $vals := []string{}
    $i := 0
    while i < n {
        p := q.pairs[i]
        keys.push(pair_key(&p))
        vals.push(pair_val(&p))
        i = i + 1
    }
    $j := 1
    while j < n {
        k := keys[j] + ""
        v := vals[j] + ""
        $p := j
        while p > 0 {
            prevk := keys[p - 1] + ""
            lhs := k + ""
            rhs := prevk + ""
            if strings.compare(&lhs, &rhs) >= 0 {
                <-
            }
            keys[p] = prevk
            vals[p] = vals[p - 1] + ""
            p = p - 1
        }
        keys[p] = k
        vals[p] = v
        j = j + 1
    }
    $out := ""
    i = 0
    while i < n {
        if i > 0 {
            out.push_byte(38)
        }
        kk := keys[i] + ""
        vv := vals[i] + ""
        ek := query_escape(&kk)
        ev := query_escape(&vv)
        out = out + ek + "=" + ev
        i = i + 1
    }
    << out
}

pub fn query_escape(s &string) string {
    $out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if c == 32 {
            out.push_byte(43)
        } else if is_unreserved(c) {
            out.push_byte(c)
        } else {
            out.push_byte(37)
            out.push_byte(HEX[c >> 4] & 255)
            out.push_byte(HEX[c & 15] & 255)
        }
    }
    << out
}

// path_escape percent-encodes for a path segment: unreserved plus
// $&+,/:;=@ kept, everything else %XX (space becomes %20).
pub fn path_escape(s &string) string {
    $out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if is_unreserved(c) {
            out.push_byte(c)
        } else if c == 36 || c == 38 || c == 43 || c == 44 || c == 47 || c == 58 || c == 59 || c == 61 || c == 64 {
            out.push_byte(c)
        } else {
            out.push_byte(37)
            out.push_byte(HEX[c >> 4] & 255)
            out.push_byte(HEX[c & 15] & 255)
        }
    }
    << out
}

fn is_unreserved(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 45 || c == 46 || c == 95 || c == 126 {
        << true
    }
    << false
}

fn merge_rel_path(base_path string, rel string) string {
    bp := base_path + ""
    $last := 0 - 1
    $i := 0
    while i < bp.len {
        if (bp[i] & 255) == 47 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        << rel + ""
    }
    << bp[0:(last + 1)] + rel
}

// resolve_reference is Go URL.ResolveReference for this RFC 3986 subset
// (scheme/host/path/query/fragment; no userinfo).
pub fn (base &URL) resolve_reference(ref string) URL {
    $r := new_url()
    r.parse(ref) or >>
    if r.scheme.len > 0 {
        << r
    }
    $out := new_url()
    out.scheme = base.scheme + ""
    if r.has_auth {
        out.has_auth = true
        out.host = r.host + ""
        out.path = r.path + ""
        out.raw_query = r.raw_query + ""
        out.fragment = r.fragment + ""
        << out
    }
    out.has_auth = base.has_auth
    out.host = base.host + ""
    if r.path.len > 0 {
        if (r.path[0] & 255) == 47 {
            out.path = r.path + ""
        } else {
            out.path = merge_rel_path(base.path + "", r.path + "")
        }
        out.raw_query = r.raw_query + ""
        out.fragment = r.fragment + ""
        << out
    }
    out.path = base.path + ""
    if r.raw_query.len > 0 {
        out.raw_query = r.raw_query + ""
    } else {
        out.raw_query = base.raw_query + ""
    }
    out.fragment = r.fragment + ""
    << out
}
