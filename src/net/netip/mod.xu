@net/netip

#net
#errors

// netip — Go `net/netip` subset. Addr is a parsed IP (raw bytes + zone).
// No allocation-heavy net.IP slice; the owning string is 4 or 16 bytes.

pub struct Addr {
    pub ip string
    pub zone string
}

pub struct AddrPort {
    pub addr Addr
    pub port int
}

pub struct Prefix {
    pub addr Addr
    pub bits int
}

pub fn addr_from4(a int, b int, c int, d int) Addr {
    << Addr{ip: net.ipv4(a, b, c, d), zone: ""}
}

pub fn addr_from16(ip string) Addr {
    if ip.len != 16 {
        >> errors.new("netip: need 16-byte address")
    }
    << Addr{ip: ip, zone: ""}
}

pub fn parse_addr(s string) Addr {
    src := s + ""
    mut zone := ""
    mut host := src + ""
    mut last := -1
    for i in 0:src.len {
        if (src[i] & 255) == 37 {
            last = i
        }
    }
    if last > 0 {
        host = src[0:last]
        zone = src[(last + 1):src.len]
    }
    ip := net.parse_ip(&host)
    if ip.len == 0 {
        >> errors.new("ParseAddr(" + src + "): unable to parse IP")
    }
    << Addr{ip: ip, zone: zone}
}

pub fn (a Addr) is_valid() bool {
    << a.ip.len == 4 || a.ip.len == 16
}

pub fn (a Addr) is4() bool {
    << net.ip_to4(&a.ip).len == 4
}

pub fn (a Addr) is6() bool {
    << a.ip.len == 16 && net.ip_to4(&a.ip).len == 0
}

pub fn (a Addr) is4_in6() bool {
    << a.ip.len == 16 && net.ip_to4(&a.ip).len == 4
}

pub fn (a Addr) unmap() Addr {
    v4 := net.ip_to4(&a.ip)
    if v4.len == 4 {
        << Addr{ip: v4, zone: ""}
    }
    << Addr{ip: a.ip + "", zone: a.zone + ""}
}

pub fn (a Addr) with_zone(zone string) Addr {
    << Addr{ip: a.ip + "", zone: zone + ""}
}

pub fn (a Addr) to_string() string {
    if a.ip.len == 0 {
        << "invalid IP"
    }
    s := net.ip_string(&a.ip)
    if a.zone.len > 0 {
        << s + "%" + a.zone
    }
    << s
}

pub fn (a Addr) is_unspecified() bool {
    << net.ip_is_unspecified(&a.ip)
}

pub fn (a Addr) is_loopback() bool {
    << net.ip_is_loopback(&a.ip)
}

pub fn (a Addr) is_private() bool {
    << net.ip_is_private(&a.ip)
}

pub fn (a Addr) is_multicast() bool {
    << net.ip_is_multicast(&a.ip)
}

pub fn (a Addr) is_global_unicast() bool {
    << net.ip_is_global_unicast(&a.ip)
}

pub fn (a Addr) is_link_local_unicast() bool {
    << net.ip_is_link_local_unicast(&a.ip)
}

pub fn parse_addr_port(s string) AddrPort {
    mut hp := net.new_host_port()
    hp.split(s + "") or (err) {
        >> err
    }
    host := hp.host()
    port_s := hp.port()
    addr := parse_addr(host)
    mut port := 0
    mut i := 0
    while i < port_s.len {
        c := port_s[i] & 255
        if c < 48 || c > 57 {
            >> errors.new("invalid port")
        }
        port = port * 10 + (c - 48)
        if port > 65535 {
            >> errors.new("invalid port")
        }
        i = i + 1
    }
    << AddrPort{addr: addr, port: port}
}

pub fn (ap AddrPort) to_string() string {
    a := ap.addr.to_string()
    p := str(ap.port)
    << net.join_host_port(&a, &p)
}

pub fn (ap AddrPort) is_valid() bool {
    << ap.addr.is_valid() && ap.port >= 0 && ap.port <= 65535
}

pub fn parse_prefix(s string) Prefix {
    cidr := net.parse_cidr(&s) or >>
    mask := cidr.ipnet.mask + ""
    bits := net.ip_mask_size(&mask)
    << Prefix{addr: Addr{ip: cidr.ip, zone: ""}, bits: bits}
}

pub fn (p Prefix) to_string() string {
    ip := p.addr.ip + ""
    << net.ip_string(&ip) + "/" + str(p.bits)
}

pub fn (p Prefix) contains(a Addr) bool {
    ip := p.addr.ip + ""
    n := net.IPNet{ip: ip + "", mask: net.cidr_mask(p.bits, ip.len * 8)}
    x := a.ip + ""
    << n.contains(&x)
}
