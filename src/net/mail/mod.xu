@net/mail


#errors
#strings

// RFC 5322 address subset aligned with Go `net/mail` ParseAddress /
// ParseAddressList. No CFWS folding, no groups (`Name: a, b;`), no
// RFC 2047 encoded-words. Name quoting is `"` with `\"`.

pub struct Address {
    pub name string
    pub address string
}

fn is_atext(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 {
        << true
    }
    if c == 45 || c == 47 || c == 61 || c == 63 || c == 94 || c == 95 || c == 96 {
        << true
    }
    if c == 123 || c == 124 || c == 125 || c == 126 {
        << true
    }
    << false
}

fn valid_addr(s &string) bool {
    src := s + ""
    at := strings.last_index(&src, "@")
    if at <= 0 {
        << false
    }
    if at >= src.len - 1 {
        << false
    }
    for i in 0:src.len {
        c := src[i] & 255
        if c == 32 || c == 9 || c == 60 || c == 62 || c == 44 {
            << false
        }
    }
    << true
}

fn unquote_name(s &string) string {
    src := strings.trim_space(s)
    if src.len >= 2 && (src[0] & 255) == 34 && (src[src.len - 1] & 255) == 34 {
        inner := src[1:(src.len - 1)] + ""
        $out := ""
        $i := 0
        while i < inner.len {
            c := inner[i] & 255
            if c == 92 && i + 1 < inner.len {
                i = i + 1
                out = out + string_from_byte(inner[i] & 255)
                i = i + 1
            } else {
                out = out + string_from_byte(c)
                i = i + 1
            }
        }
        << out
    }
    << src
}

fn needs_quote(s &string) bool {
    if s.len == 0 {
        << false
    }
    for i in 0:s.len {
        if !is_atext(s[i] & 255) {
            << true
        }
    }
    << false
}

fn escape_name(s &string) string {
    $out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if c == 34 || c == 92 {
            out = out + string_from_byte(92)
        }
        out = out + string_from_byte(c)
    }
    << out
}

pub fn parse_address(s &string) Address {
    src := strings.trim_space(s)
    if src.len == 0 {
        >> errors.new("mail: no address")
    }
    lt := strings.index_of(&src, "<")
    if lt >= 0 {
        gt := strings.last_index(&src, ">")
        if gt < 0 || gt < lt {
            >> errors.new("mail: missing >")
        }
        npart := src[0:lt] + ""
        apart := src[(lt + 1):gt] + ""
        name := unquote_name(&npart)
        addr := strings.trim_space(&apart)
        if !valid_addr(&addr) {
            >> errors.new("mail: invalid address")
        }
        << Address{name: name, address: addr}
    }
    if !valid_addr(&src) {
        >> errors.new("mail: invalid address")
    }
    << Address{name: "", address: src}
}

fn split_list(s &string) []string {
    text := s + ""
    $parts := []string{}
    $cur := ""
    $quote := 0
    $angle := 0
    for i in 0:text.len {
        c := text[i] & 255
        if quote == 1 {
            cur = cur + string_from_byte(c)
            if c == 34 {
                if i == 0 {
                    quote = 0
                } else {
                    if (text[i - 1] & 255) != 92 {
                        quote = 0
                    }
                }
            }
        } else if c == 34 {
            quote = 1
            cur = cur + string_from_byte(c)
        } else if c == 60 {
            angle = 1
            cur = cur + string_from_byte(c)
        } else if c == 62 {
            angle = 0
            cur = cur + string_from_byte(c)
        } else if c == 44 && angle == 0 {
            tlen := strings.trim_space(&cur).len
            if tlen > 0 {
                parts.push(strings.trim_space(&cur))
            }
            cur = ""
        } else {
            cur = cur + string_from_byte(c)
        }
    }
    tlen := strings.trim_space(&cur).len
    if tlen > 0 {
        parts.push(strings.trim_space(&cur))
    }
    << parts
}

pub fn parse_address_list(s &string) []Address {
    src := strings.trim_space(s)
    if src.len == 0 {
        >> errors.new("mail: no address")
    }
    parts := split_list(&src)
    $out := []Address{}
    for i in 0:parts.len {
        p := parts[i] + ""
        a := parse_address(&p)
        out.push(a)
    }
    if out.len == 0 {
        >> errors.new("mail: no address")
    }
    << out
}

pub fn (a Address) to_string() string {
    addr := a.address + ""
    wrapped := "<" + addr + ">"
    if a.name.len == 0 {
        << wrapped
    }
    nm := a.name + ""
    if needs_quote(&nm) {
        << "\"" + escape_name(&nm) + "\" " + wrapped
    }
    << nm + " " + wrapped
}
