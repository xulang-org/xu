@net

#errors

// HardwareAddr (Go net/mac.go). Raw bytes as an owning string; parse_mac
// accepts MAC-48 / EUI-48 / EUI-64 / 20-octet InfiniBand forms.

pub fn hardware_addr_string(a &string) string {
    if a.len == 0 {
        << ""
    }
    hex := "0123456789abcdef"
    $out := ""
    for i in 0:a.len {
        if i > 0 {
            out = out + ":"
        }
        b := a[i] & 255
        out = out + string_from_byte(hex[(b >> 4) & 15])
        out = out + string_from_byte(hex[b & 15])
    }
    << out
}

pub fn parse_mac(s &string) string {
    src := s + ""
    if src.len < 12 {
        >> errors.new("invalid MAC address")
    }
    if src.len >= 3 && ((src[2] & 255) == 58 || (src[2] & 255) == 45) {
        sep := src[2] & 255
        if (src.len + 1) % 3 != 0 {
            >> errors.new("invalid MAC address")
        }
        n := (src.len + 1) / 3
        if n != 6 && n != 8 && n != 20 {
            >> errors.new("invalid MAC address")
        }
        $hw := ""
        $x := 0
        for i in 0:n {
            b := xtoi2(s, x, sep)
            if b < 0 {
                >> errors.new("invalid MAC address")
            }
            hw = hw + string_from_byte(b)
            x = x + 3
            _ := i
        }
        << hw
    }
    if src.len >= 5 && (src[4] & 255) == 46 {
        if (src.len + 1) % 5 != 0 {
            >> errors.new("invalid MAC address")
        }
        n := 2 * (src.len + 1) / 5
        if n != 6 && n != 8 && n != 20 {
            >> errors.new("invalid MAC address")
        }
        $hw := ""
        $x := 0
        $i := 0
        while i < n {
            b0 := xtoi2(s, x, 0)
            b1 := xtoi2(s, x + 2, 46)
            if b0 < 0 || b1 < 0 {
                >> errors.new("invalid MAC address")
            }
            hw = hw + string_from_byte(b0) + string_from_byte(b1)
            x = x + 5
            i = i + 2
        }
        << hw
    }
    if src.len % 2 != 0 {
        >> errors.new("invalid MAC address")
    }
    n := src.len / 2
    if n != 6 && n != 8 && n != 20 {
        >> errors.new("invalid MAC address")
    }
    $hw := ""
    $x := 0
    for i in 0:n {
        b := xtoi2(s, x, 0)
        if b < 0 {
            >> errors.new("invalid MAC address")
        }
        hw = hw + string_from_byte(b)
        x = x + 2
        _ := i
    }
    << hw
}
