@net/pool

#net

// The state channel serializes lifecycle changes, not network dialing/I/O.
pub struct State {
    pub closed int
    pub idle []int
    pub borrowed []int
}

pub struct SocketPool {
    pub state chan State
    pub max_idle int
}

pub fn new_state() chan State {
    ch := chan State{cap: 1}
    initial := State{closed: 0, idle: []int{}, borrowed: []int{}}
    ch <- initial
    << ch
}

fn close_fd(fd int) {
    if fd >= 0 { net.conn_close(fd) or (err) { << } }
}

// -1 means dial a new socket; -2 means the pool is closed.
pub fn (p &SocketPool) take() int {
    $st := <-p.state
    if st.closed != 0 { p.state <- st
        << -2 }
    if st.idle.len == 0 { p.state <- st
        << -1 }
    fd := st.idle[st.idle.len - 1]
    $kept := []int{}
    for i in 0:st.idle.len - 1 { kept.push(st.idle[i]) }
    st.idle = kept
    st.borrowed.push(fd)
    p.state <- st
    << fd
}

// A close concurrent with an outstanding dial wins; the new fd is closed.
pub fn (p &SocketPool) adopt(fd int) bool {
    if fd < 0 { << false }
    $st := <-p.state
    if st.closed != 0 { close_fd(fd)
        p.state <- st
        << false }
    st.borrowed.push(fd)
    p.state <- st
    << true
}

// max_idle limits retained sockets, not the total number of open sockets.
// Borrowers must return/discard each fd exactly once, before borrowing again.
pub fn (p &SocketPool) release(fd int, reusable bool) {
    if fd < 0 { << }
    $st := <-p.state
    $found := false
    $kept := []int{}
    for i in 0:st.borrowed.len {
        if st.borrowed[i] == fd { found = true } else { kept.push(st.borrowed[i]) }
    }
    st.borrowed = kept
    if found {
        if st.closed == 0 && reusable && st.idle.len < p.max_idle {
            st.idle.push(fd)
        } else {
            close_fd(fd)
        }
    }
    p.state <- st
}

pub fn (p &SocketPool) close() {
    $st := <-p.state
    st.closed = 1
    for i in 0:st.idle.len { close_fd(st.idle[i]) }
    st.idle = []int{}
    p.state <- st
}
