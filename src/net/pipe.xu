@net

#errors

// In-memory full-duplex pipe (Go net.Pipe). Ends are channel-backed
// PipeConn values, not socket fds.

pub struct PipeConn {
    pub w chan string
    pub r chan string
    pub closed int
}

pub struct PipePair {
    pub c1 PipeConn
    pub c2 PipeConn
}

pub fn pipe() PipePair {
    a := chan string{cap: 16}
    b := chan string{cap: 16}
    << PipePair{
        c1: PipeConn{w: a, r: b, closed: 0},
        c2: PipeConn{w: b, r: a, closed: 0}
    }
}

pub fn (c PipeConn) read() string {
    if c.closed != 0 {
        >> errors.new("use of closed network connection")
    }
    s := <-c.r
    << s
}

pub fn (c PipeConn) write(data string) int {
    if c.closed != 0 {
        >> errors.new("use of closed network connection")
    }
    n := data.len
    c.w <- data
    << n
}

pub fn (c $&PipeConn) close() int {
    if c.closed != 0 {
        << 0
    }
    c.closed = 1
    close(c.w)
    << 0
}

pub fn (c PipeConn) local_addr() string {
    << "pipe"
}

pub fn (c PipeConn) remote_addr() string {
    << "pipe"
}

pub fn (c PipeConn) network() string {
    << "pipe"
}
