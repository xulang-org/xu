@net

#errors

// In-memory full-duplex pipe (Go net.Pipe). Ends are channel-backed
// PipeConn values, not socket fds. Create endpoints with pipe() so their
// shared close notifications and guards are initialized together.

pub struct PipeConn {
    pub w chan string
    pub r chan string
    pub closed int
    done chan int
    peer_done chan int
    close_guard chan int
}

pub struct PipePair {
    pub c1 PipeConn
    pub c2 PipeConn
}

pub fn pipe() PipePair {
    a := chan string{cap: 16}
    b := chan string{cap: 16}
    a_done := chan int{cap: 0}
    b_done := chan int{cap: 0}
    a_guard := chan int{cap: 1}
    b_guard := chan int{cap: 1}
    a_guard <- 1
    b_guard <- 1
    << PipePair{
        c1: PipeConn{w: a, r: b, closed: 0, done: a_done, peer_done: b_done, close_guard: a_guard},
        c2: PipeConn{w: b, r: a, closed: 0, done: b_done, peer_done: a_done, close_guard: b_guard}
    }
}

pub fn (c PipeConn) read() string {
    if c.closed != 0 || sys_wait_cancel(c.done, 0) {
        >> errors.new("use of closed network connection")
    }
    select {
        s := <-c.r { << s }
        _ := <-c.done { >> errors.new("use of closed network connection") }
        _ := <-c.peer_done {
            // Keep the existing buffered contract: data accepted before
            // peer close can still be drained, then an empty read is EOF.
            select {
                s := <-c.r { << s }
                else { << "" }
            }
        }
    }
    << ""
}

pub fn (c PipeConn) write(data string) int {
    if c.closed != 0 || sys_wait_cancel(c.done, 0) || sys_wait_cancel(c.peer_done, 0) {
        >> errors.new("use of closed network connection")
    }
    n := data.len
    select {
        c.w <- data { << n }
        _ := <-c.done { >> errors.new("use of closed network connection") }
        _ := <-c.peer_done { >> errors.new("use of closed network connection") }
    }
    << 0
}

pub fn (c $&PipeConn) close() int {
    token := <-c.close_guard
    if !sys_wait_cancel(c.done, 0) { close(c.done) }
    c.close_guard <- token
    c.closed = 1
    // Data channels stay open: closing one while a writer is selecting can
    // turn ordinary peer shutdown into a process-level send-on-closed error.
    << 0
}

pub fn (c PipeConn) local_addr() string {
    << "pipe"
}

pub fn (c PipeConn) remote_addr() string {
    << "pipe"
}

pub fn (c PipeConn) network() string {
    << "pipe"
}
