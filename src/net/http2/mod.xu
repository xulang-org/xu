@net/http2

// Minimal HTTP/2 client (RFC 9113 / HPACK RFC 7541 subset).
//
// v1:
//   * frame codec (encode_frame / decode_frame)
//   * GET headers HPACK (static table + raw literals, no Huffman)
//   * h2c TcpClient (prior knowledge)
//   * TlsClient via dial_tls (ClientHello ALPN offers h2 + http/1.1)
//
// TCP and TLS share completion and field-block validation. Responses are
// limited to 4096 received frames, 64 KiB field blocks and 16 MiB bodies;
// the advertised incoming frame limit remains 16 KiB. Limit exhaustion and
// transport/protocol failure close the connection and return ok=false.
//
// Still excluded: HPACK Huffman/dynamic indexes, flow control, GOAWAY retry
// and server push. TLS POST supports one DATA frame of at most 16 KiB.

// Default timeout in nanoseconds for an HTTP/2 TLS connection.
const DEFAULT_TLS_TIMEOUT_NS = 30000000000

const FRAME_DATA = 0
const FRAME_HEADERS = 1
const FRAME_SETTINGS = 4
const FRAME_GOAWAY = 7
const FLAG_END_STREAM = 1
const FLAG_END_HEADERS = 4
const FLAG_ACK = 1

pub const PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

pub struct Frame {
    pub typ int
    pub flags int
    pub stream_id int
    pub payload string
}

pub struct Decoded {
    pub f Frame
    pub need int
}

pub struct Response {
    pub status int
    pub body string
    pub ok bool
    pub err string
}

fn be24(n int) string {
    $b := []int{}
    b.push((n >> 16) & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn be32(n int) string {
    $b := []int{}
    b.push((n >> 24) & 255)
    b.push((n >> 16) & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn u24_at(s &string, off int) int {
    << ((s[off] & 255) << 16) | ((s[off + 1] & 255) << 8) | (s[off + 2] & 255)
}

fn u32_at(s &string, off int) int {
    << ((s[off] & 255) << 24) | ((s[off + 1] & 255) << 16) | ((s[off + 2] & 255) << 8) | (s[off + 3] & 255)
}

// encode_frame builds a raw HTTP/2 frame.
pub fn encode_frame(typ int, flags int, sid int, payload string) string {
    $out := ""
    out = out + be24(payload.len)
    out.push_byte(typ & 255)
    out.push_byte(flags & 255)
    out = out + be32(sid)
    out = out + payload
    << out
}

// decode_frame parses one frame. need=0 when buf is short.
pub fn decode_frame(buf string) Decoded {
    if buf.len < 9 {
        << Decoded{f: Frame{typ: 0, flags: 0, stream_id: 0, payload: ""}, need: 0}
    }
    ln := u24_at(&buf, 0)
    total := 9 + ln
    if buf.len < total {
        << Decoded{f: Frame{typ: 0, flags: 0, stream_id: 0, payload: ""}, need: 0}
    }
    typ := buf[3] & 255
    flags := buf[4] & 255
    sid := u32_at(&buf, 5) & 2147483647
    payload := buf[9:total]
    << Decoded{f: Frame{typ: typ, flags: flags, stream_id: sid, payload: payload}, need: total}
}

fn hpack_int(n int, prefix_bits int) string {
    maxv := (1 << prefix_bits) - 1
    if n < maxv {
        << string_from_byte(n)
    }
    $b := ""
    b.push_byte(maxv)
    $v := n - maxv
    while v >= 128 {
        b.push_byte((v & 127) | 128)
        v = v / 128
    }
    b.push_byte(v)
    << b
}

fn hpack_lit_indexed_name(name_idx int, value string) string {
    $out := ""
    if name_idx < 63 {
        out.push_byte(64 | name_idx)
    } else {
        out.push_byte(64 | 63)
        out = out + hpack_int(name_idx - 63, 7)
    }
    out = out + hpack_int(value.len, 7)
    out = out + value
    << out
}

// encode_get_headers builds a HEADERS payload for GET.
pub fn encode_get_headers(authority string, path string) string {
    $blk := ""
    blk.push_byte(130)
    if path == "/" {
        blk.push_byte(132)
    } else {
        blk = blk + hpack_lit_indexed_name(4, path)
    }
    blk.push_byte(135)
    blk = blk + hpack_lit_indexed_name(1, authority)
    << blk
}

// encode_post_headers builds HEADERS for POST with content-type + optional bearer.
pub fn encode_post_headers(authority string, path string, content_type string, authorization string) string {
    $blk := ""
    blk.push_byte(131) // :method POST
    if path == "/" {
        blk.push_byte(132)
    } else {
        blk = blk + hpack_lit_indexed_name(4, path)
    }
    blk.push_byte(135) // :scheme https
    blk = blk + hpack_lit_indexed_name(1, authority)
    // content-type: incremental indexing, static name index 31
    blk.push_byte(95)
    blk = blk + hpack_int(content_type.len, 7)
    blk = blk + content_type
    if authorization.len > 0 {
        blk.push_byte(0)
        blk = blk + hpack_int(13, 7)
        blk = blk + "authorization"
        blk = blk + hpack_int(authorization.len, 7)
        blk = blk + authorization
    }
    << blk
}
