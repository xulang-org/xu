@net/http2

#errors

// Deliberately bounded HPACK subset: static indexes and raw literal strings.
// Reject unsupported encodings instead of trusting a status found before an
// invalid or truncated remainder of the field block.
struct HpackInt {
    value int
    next int
}

struct HpackString {
    value string
    next int
}

fn hpack_read_int(data &string, off int, prefix int) HpackInt {
    if off < 0 || off >= data.len { >> errors.new("http2: truncated HPACK integer") }
    mask := (1 << prefix) - 1
    $value := data[off] & mask
    $next := off + 1
    if value < mask { << HpackInt{value: value, next: next} }
    $scale := 1
    for i in 0:5 {
        if next >= data.len { >> errors.new("http2: truncated HPACK integer") }
        octet := data[next] & 255
        part := octet & 127
        if part > (2147483647 - value) / scale { >> errors.new("http2: HPACK integer overflow") }
        value += part * scale
        next += 1
        if (octet & 128) == 0 { << HpackInt{value: value, next: next} }
        if i == 4 { >> errors.new("http2: HPACK integer overflow") }
        scale *= 128
    }
    >> errors.new("http2: HPACK integer overflow")
}

fn hpack_read_string(data &string, off int) HpackString {
    if off < 0 || off >= data.len { >> errors.new("http2: truncated HPACK string") }
    if (data[off] & 128) != 0 { >> errors.new("http2: HPACK Huffman is unsupported") }
    size := hpack_read_int(data, off, 7) or >>
    if size.value > data.len - size.next { >> errors.new("http2: truncated HPACK string") }
    end := size.next + size.value
    << HpackString{value: data[size.next:end] + "", next: end}
}

fn static_status(index int) int {
    if index == 8 { << 200 }
    if index == 9 { << 204 }
    if index == 10 { << 206 }
    if index == 11 { << 304 }
    if index == 12 { << 400 }
    if index == 13 { << 404 }
    if index == 14 { << 500 }
    << 0
}

fn status_value(value &string) int {
    if value.len != 3 { >> errors.new("http2: invalid status") }
    $status := 0
    for i in 0:3 {
        octet := value[i] & 255
        if octet < 48 || octet > 57 { >> errors.new("http2: invalid status") }
        status = status * 10 + octet - 48
    }
    if status < 100 || status > 599 { >> errors.new("http2: invalid status") }
    << status
}

fn header_status(data &string) int {
    $off := 0
    $status := 0
    $fields := false
    $regular := false
    while off < data.len {
        first := data[off] & 255
        if (first & 224) == 32 {
            if fields { >> errors.new("http2: late HPACK table update") }
            size := hpack_read_int(data, off, 5) or >>
            if size.value != 0 { >> errors.new("http2: HPACK dynamic table is unsupported") }
            off = size.next
            ->
        }
        fields = true
        if (first & 128) != 0 {
            index := hpack_read_int(data, off, 7) or >>
            if index.value <= 0 || index.value > 61 { >> errors.new("http2: unsupported HPACK index") }
            found := static_status(index.value)
            if found > 0 {
                if status != 0 || regular { >> errors.new("http2: duplicate or late status") }
                status = found
            } else {
                if index.value <= 7 { >> errors.new("http2: invalid response pseudo-header") }
                regular = true
            }
            off = index.next
            ->
        }
        $prefix := 4
        if (first & 64) != 0 { prefix = 6 }
        index := hpack_read_int(data, off, prefix) or >>
        if index.value > 61 { >> errors.new("http2: unsupported HPACK index") }
        off = index.next
        $is_status := index.value >= 8 && index.value <= 14
        if index.value == 0 {
            name := hpack_read_string(data, off) or >>
            if name.value.len == 0 { >> errors.new("http2: empty header name") }
            is_status = name.value == ":status"
            if !is_status && name.value[0] == 58 { >> errors.new("http2: invalid response pseudo-header") }
            off = name.next
        } else if index.value <= 7 {
            >> errors.new("http2: invalid response pseudo-header")
        }
        value := hpack_read_string(data, off) or >>
        off = value.next
        if is_status {
            if status != 0 || regular { >> errors.new("http2: duplicate or late status") }
            status = status_value(&value.value) or >>
        } else {
            regular = true
        }
    }
    << status
}

// Unsupported or malformed blocks have no usable status in this compatibility API.
pub fn parse_status(blk string) int {
    << header_status(&blk) or (err) { << 0 }
}
