@net/websocket

#crypto/sha1
#encoding/base64
#encoding/hex
#errors
#net/http
#os
#strings

// WebSocket protocol implementation (RFC 6455).
// Supports frame encoding/decoding, masking/unmasking, handshake key negotiation,
// and high-level message read/write connections for both clients and servers.

pub const OP_CONTINUATION = 0
pub const OP_TEXT = 1
pub const OP_BINARY = 2
pub const OP_CLOSE = 8
pub const OP_PING = 9
pub const OP_PONG = 10

pub const STATUS_NORMAL = 1000
pub const STATUS_GOING_AWAY = 1001
pub const STATUS_PROTOCOL_ERROR = 1002
pub const STATUS_UNSUPPORTED = 1003

const WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

// compute_accept_key computes the Sec-WebSocket-Accept response header value
// from the client's Sec-WebSocket-Key challenge according to RFC 6455 §4.2.2.
pub fn compute_accept_key(challenge_key string) string {
    trimmed := strings.trim_space(&challenge_key)
    full := trimmed + WS_GUID
    hex_digest := sha1.sum(full)
    raw := hex.decode_string(hex_digest) or (err) {
        << ""
    }
    << base64.encode_to_string(raw)
}

pub struct Frame {
    pub fin bool
    pub opcode int
    pub masked bool
    pub payload string
}

fn apply_mask(payload &string, m0 int, m1 int, m2 int, m3 int) string {
    $out := []int{}
    for i in 0:payload.len {
        b := payload[i] & 255
        idx := i % 4
        $m := m0
        if idx == 1 {
            m = m1
        } else if idx == 2 {
            m = m2
        } else if idx == 3 {
            m = m3
        }
        out.push(b ^ m)
    }
    << string_from_bytes(out)
}

// encode_frame serializes a WebSocket data frame into wire bytes.
pub fn encode_frame(fin bool, opcode int, payload &string, mask bool) string {
    $b0 := opcode & 15
    if fin {
        b0 = b0 | 128
    }
    $hdr := []int{}
    hdr.push(b0)
    plen := payload.len
    $mbit := 0
    if mask {
        mbit = 128
    }
    if plen <= 125 {
        hdr.push(mbit | plen)
    } else if plen <= 65535 {
        hdr.push(mbit | 126)
        hdr.push((plen >> 8) & 255)
        hdr.push(plen & 255)
    } else {
        hdr.push(mbit | 127)
        for s in 0:8 {
            shift := (7 - s) * 8
            hdr.push((plen >> shift) & 255)
        }
    }
    if mask {
        // Deterministic masking key for predictable wire encoding
        m0 := 0x12
        m1 := 0x34
        m2 := 0x56
        m3 := 0x78
        hdr.push(m0)
        hdr.push(m1)
        hdr.push(m2)
        hdr.push(m3)
        masked_data := apply_mask(payload, m0, m1, m2, m3)
        << string_from_bytes(hdr) + masked_data
    }
    << string_from_bytes(hdr) + payload
}

// decode_frame parses a single WebSocket frame from a byte buffer.
pub fn decode_frame(raw &string) Frame {
    if raw.len < 2 {
        >> errors.new("net/websocket: frame too short")
    }
    b0 := raw[0] & 255
    b1 := raw[1] & 255
    fin := (b0 & 128) != 0
    opcode := b0 & 15
    masked := (b1 & 128) != 0
    $len_code := b1 & 127
    $offset := 2
    $plen := len_code
    if len_code == 126 {
        if raw.len < 4 {
            >> errors.new("net/websocket: truncated 16-bit payload length")
        }
        plen = ((raw[2] & 255) << 8) | (raw[3] & 255)
        offset = 4
    } else if len_code == 127 {
        if raw.len < 10 {
            >> errors.new("net/websocket: truncated 64-bit payload length")
        }
        $hi := 0
        for i in 0:4 {
            hi = (hi << 8) | (raw[2 + i] & 255)
        }
        $lo := 0
        for j in 0:4 {
            lo = (lo << 8) | (raw[6 + j] & 255)
        }
        plen = (hi << 32) | lo
        offset = 10
    }
    $m0 := 0
    $m1 := 0
    $m2 := 0
    $m3 := 0
    if masked {
        if raw.len < offset + 4 {
            >> errors.new("net/websocket: truncated masking key")
        }
        m0 = raw[offset] & 255
        m1 = raw[offset + 1] & 255
        m2 = raw[offset + 2] & 255
        m3 = raw[offset + 3] & 255
        offset = offset + 4
    }
    if raw.len < offset + plen {
        >> errors.new("net/websocket: incomplete frame payload")
    }
    body := raw[offset:(offset + plen)] + ""
    $payload := ""
    if masked {
        payload = apply_mask(&body, m0, m1, m2, m3)
    } else {
        payload = body
    }
    << Frame{fin: fin, opcode: opcode, masked: masked, payload: payload}
}

// Conn represents an active WebSocket connection over an underlying socket.
pub struct Conn {
    pub fd int
    pub is_client bool
    pub closed bool
}

pub fn new_conn(fd int, is_client bool) Conn {
    << Conn{fd: fd, is_client: is_client, closed: false}
}

pub fn (c $&Conn) write_message(opcode int, payload string) int {
    if c.closed {
        >> errors.new("net/websocket: write on closed connection")
    }
    wire := encode_frame(true, opcode, &payload, c.is_client)
    << os.socket_write(c.fd, wire) or >>
}

pub fn (c $&Conn) write_text(text string) int {
    << c.write_message(OP_TEXT, text) or >>
}

pub fn (c $&Conn) write_binary(data string) int {
    << c.write_message(OP_BINARY, data) or >>
}

pub fn (c $&Conn) write_ping(data string) int {
    << c.write_message(OP_PING, data) or >>
}

pub fn (c $&Conn) write_pong(data string) int {
    << c.write_message(OP_PONG, data) or >>
}

pub fn (c $&Conn) close(code int, reason string) int {
    if c.closed {
        << 0
    }
    $pl := []int{}
    pl.push((code >> 8) & 255)
    pl.push(code & 255)
    for i in 0:reason.len {
        pl.push(reason[i] & 255)
    }
    payload := string_from_bytes(pl)
    c.write_message(OP_CLOSE, payload) or (err) { << 0 }
    c.closed = true
    << os.socket_close(c.fd) or >>
}

// upgrade upgrades an HTTP server request to a WebSocket connection.
// It verifies the required headers, computes the Sec-WebSocket-Accept token,
// sends the HTTP 101 Switching Protocols response, and returns the Conn.
pub fn upgrade(ctx http.Context) Conn {
    challenge := ctx.header("sec-websocket-key")
    if challenge.len == 0 {
        ctx.text(400, "Missing Sec-WebSocket-Key\r\n") or (err) { >> errors.new("net/websocket: missing Sec-WebSocket-Key header") }
        >> errors.new("net/websocket: missing Sec-WebSocket-Key header")
    }
    accept_val := compute_accept_key(challenge)
    response := "HTTP/1.1 101 Switching Protocols\r\n" +
        "Upgrade: websocket\r\n" +
        "Connection: Upgrade\r\n" +
        "Sec-WebSocket-Accept: " + accept_val + "\r\n\r\n"
    os.socket_write(ctx.fd, response) or >>
    << new_conn(ctx.fd, false)
}
