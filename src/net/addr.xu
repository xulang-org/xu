@net

#errors

// Addr types (Go TCPAddr / UDPAddr / IPAddr / UnixAddr) plus SplitHostPort
// as a value-returning helper. IP fields are raw-byte strings.

pub struct TCPAddr {
    pub ip string
    pub port int
    pub zone string
}

pub struct UDPAddr {
    pub ip string
    pub port int
    pub zone string
}

pub struct IPAddr {
    pub ip string
    pub zone string
}

pub struct UnixAddr {
    pub name string
    pub network string
}

pub fn new_tcp_addr() TCPAddr {
    << TCPAddr{ip: "", port: 0, zone: ""}
}

pub fn new_udp_addr() UDPAddr {
    << UDPAddr{ip: "", port: 0, zone: ""}
}

pub fn new_ip_addr() IPAddr {
    << IPAddr{ip: "", zone: ""}
}

pub fn new_unix_addr() UnixAddr {
    << UnixAddr{name: "", network: "unix"}
}

pub fn (a TCPAddr) network() string {
    << "tcp"
}

pub fn (a UDPAddr) network() string {
    << "udp"
}

pub fn (a IPAddr) network() string {
    << "ip"
}

pub fn (a UnixAddr) network() string {
    << a.network + ""
}

fn ip_empty_string(ip &string) string {
    if ip.len == 0 {
        << ""
    }
    v4 := ip_to4(ip)
    if v4.len == 4 {
        << ip_string(&v4)
    }
    << ip_string(ip)
}

pub fn (a TCPAddr) to_string() string {
    ip := ip_empty_string(&a.ip)
    if a.zone.len > 0 {
        host := ip + "%" + a.zone
        ps := str(a.port)
        << join_host_port(&host, &ps)
    }
    ps := str(a.port)
    << join_host_port(&ip, &ps)
}

pub fn (a &UDPAddr) clone() UDPAddr {
    << UDPAddr{ip: a.ip + "", port: a.port, zone: a.zone + ""}
}

pub fn (a UDPAddr) to_string() string {
    ip := ip_empty_string(&a.ip)
    if a.zone.len > 0 {
        host := ip + "%" + a.zone
        ps := str(a.port)
        << join_host_port(&host, &ps)
    }
    ps := str(a.port)
    << join_host_port(&ip, &ps)
}

pub fn (a IPAddr) to_string() string {
    ip := ip_empty_string(&a.ip)
    if a.zone.len > 0 {
        << ip + "%" + a.zone
    }
    << ip
}

pub fn (a UnixAddr) to_string() string {
    << a.name + ""
}

pub fn split_host_port(hostport string) HostPort {
    $hp := new_host_port()
    hp.split(hostport) or (err) {
        >> err
    }
    << hp
}

fn parse_network_kind(network &string) string {
    n := ascii_lower(network)
    if n == "tcp" || n == "tcp4" || n == "tcp6" {
        << "tcp"
    }
    if n == "udp" || n == "udp4" || n == "udp6" {
        << "udp"
    }
    if n == "ip" || n == "ip4" || n == "ip6" {
        << "ip"
    }
    if n == "unix" || n == "unixgram" || n == "unixpacket" {
        << "unix"
    }
    if n.len >= 3 && (n[0] & 255) == 105 && (n[1] & 255) == 112 && (n[2] & 255) == 58 {
        << "ip"
    }
    >> errors.new("unknown network " + network)
    << ""
}

fn network_ip_version(network &string) int {
    if network.len == 0 {
        << 0
    }
    last := network[network.len - 1] & 255
    if last == 52 {
        << 4
    }
    if last == 54 {
        << 6
    }
    << 0
}

fn host_with_zone(host string) HostPort {
    << split_host_zone(host)
}

fn resolve_host_ip(network string, host string) string {
    hz := host_with_zone(host)
    h := hz.host + ""
    if h.len == 0 {
        if network_ip_version(&network) == 6 {
            << ipv6_unspecified()
        }
        << ipv4_zero()
    }
    ip := parse_ip(&h)
    if ip.len > 0 {
        ver := network_ip_version(&network)
        if ver == 4 {
            v4 := ip_to4(&ip)
            if v4.len != 4 {
                >> errors.new("no suitable address found")
            }
            << v4
        }
        if ver == 6 {
            if ip.len == 16 && ip_to4(&ip).len == 0 {
                << ip
            }
            t16 := ip_to16(&ip)
            if t16.len == 16 && ip.len == 16 && ip_to4(&ip).len == 4 {
                >> errors.new("no suitable address found")
            }
            if ip.len == 16 {
                << ip
            }
            >> errors.new("no suitable address found")
        }
        << ip
    }
    addrs := lookup_host(h)
    ver := network_ip_version(&network)
    for i in 0:addrs.len {
        a := addrs[i] + ""
        raw := parse_ip(&a)
        if raw.len == 0 {
            ->
        }
        if ver == 4 {
            v4 := ip_to4(&raw)
            if v4.len == 4 {
                << v4
            }
        } else {
            if ver == 6 {
                if raw.len == 16 && ip_to4(&raw).len == 0 {
                    << raw
                }
            } else {
                << raw
            }
        }
    }
    >> errors.new("no suitable address found")
    << ""
}

pub fn resolve_tcp_addr(network string, address string) TCPAddr {
    $netw := network + ""
    if netw.len == 0 {
        netw = "tcp"
    }
    kind := parse_network_kind(&netw)
    if kind != "tcp" {
        >> errors.new("unknown network " + network)
    }
    $hp := new_host_port()
    hp.split(address + "") or (err) {
        >> err
    }
    host := hp.host()
    port_s := hp.port()
    $port := parse_port(&port_s)
    if port < 0 {
        port = lookup_port(netw, port_s)
    }
    hz := host_with_zone(host)
    ip := resolve_host_ip(netw, hz.host + "")
    << TCPAddr{ip: ip, port: port, zone: hz.port + ""}
}

pub fn resolve_udp_addr(network string, address string) UDPAddr {
    $netw := network + ""
    if netw.len == 0 {
        netw = "udp"
    }
    kind := parse_network_kind(&netw)
    if kind != "udp" {
        >> errors.new("unknown network " + network)
    }
    $hp := new_host_port()
    hp.split(address + "") or (err) {
        >> err
    }
    host := hp.host()
    port_s := hp.port()
    $port := parse_port(&port_s)
    if port < 0 {
        port = lookup_port(netw, port_s)
    }
    hz := host_with_zone(host)
    ip := resolve_host_ip(netw, hz.host + "")
    << UDPAddr{ip: ip, port: port, zone: hz.port + ""}
}

pub fn resolve_ip_addr(network string, address string) IPAddr {
    $netw := network + ""
    if netw.len == 0 {
        netw = "ip"
    }
    kind := parse_network_kind(&netw)
    if kind != "ip" {
        >> errors.new("unknown network " + network)
    }
    src := address + ""
    if src.len == 0 {
        << IPAddr{ip: ipv4_zero(), zone: ""}
    }
    hz := host_with_zone(src)
    ip := resolve_host_ip(netw, hz.host + "")
    << IPAddr{ip: ip, zone: hz.port + ""}
}

pub fn resolve_unix_addr(network string, address string) UnixAddr {
    n := ascii_lower(&network)
    if n != "unix" && n != "unixgram" && n != "unixpacket" {
        >> errors.new("unknown network " + network)
    }
    << UnixAddr{name: address + "", network: n}
}
