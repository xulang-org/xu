@net

#errors

// /etc/hosts reader (Go net/hosts.go). No cache: Xu has no package-level
// mutable state. Each lookup re-reads the file.

fn hosts_file_path() string {
    if xu_target_os() == 2 {
        << hosts_file_path_win()
    }
    << "/etc/hosts"
}

fn hosts_file_path_win() string {
    mut root := env_get("SystemRoot")
    if root.len == 0 {
        root = env_get("SYSTEMROOT")
    }
    if root.len == 0 {
        << "C:\\Windows\\System32\\drivers\\etc\\hosts"
    }
    << root + "\\System32\\drivers\\etc\\hosts"
}

fn read_hosts_body() string {
    body := read_file(hosts_file_path()) or (err) {
        if xu_target_os() != 2 {
            b2 := read_file(hosts_file_path_win()) or (err2) {
                << ""
            }
            << b2
        }
        << ""
    }
    << body
}

fn lookup_hosts_by_name(name string) []string {
    low := ascii_lower(&name)
    key := strip_trailing_dot(low)
    mut out := []string{}
    body := read_hosts_body()
    mut i := 0
    while i < body.len {
        mut line_end := i
        while line_end < body.len {
            if (body[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        mut line := body[i:line_end]
        hash := index_byte(&line, 35)
        if hash >= 0 {
            line = line[0:hash]
        }
        f := get_fields(&line)
        if f.len >= 2 {
            addr := f[0] + ""
            ip := parse_ip(&addr)
            if ip.len > 0 {
                mut hi := 1
                while hi < f.len {
                    raw_hn := f[hi] + ""
                    hn_low := ascii_lower(&raw_hn)
                    hn := strip_trailing_dot(hn_low)
                    if hn == key {
                        txt := ip_string(&ip)
                        mut dup := false
                        for k in 0:out.len {
                            if out[k] == txt {
                                dup = true
                            }
                        }
                        if !dup {
                            out.push(txt)
                        }
                    }
                    hi = hi + 1
                }
            }
        }
        if line_end < body.len {
            i = line_end + 1
        } else {
            i = body.len
        }
    }
    << out
}

fn lookup_hosts_by_addr(addr string) []string {
    want := parse_ip(&addr)
    mut out := []string{}
    if want.len == 0 {
        << out
    }
    body := read_hosts_body()
    mut i := 0
    while i < body.len {
        mut line_end := i
        while line_end < body.len {
            if (body[line_end] & 255) == 10 {
                <-
            }
            line_end = line_end + 1
        }
        mut line := body[i:line_end]
        hash := index_byte(&line, 35)
        if hash >= 0 {
            line = line[0:hash]
        }
        f := get_fields(&line)
        if f.len >= 2 {
            a0 := f[0] + ""
            ip := parse_ip(&a0)
            if ip.len > 0 && ip_equal(&ip, &want) {
                mut hi := 1
                while hi < f.len {
                    nm := f[hi] + ""
                    mut dup := false
                    for k in 0:out.len {
                        if out[k] == nm {
                            dup = true
                        }
                    }
                    if !dup {
                        out.push(nm)
                    }
                    hi = hi + 1
                }
            }
        }
        if line_end < body.len {
            i = line_end + 1
        } else {
            i = body.len
        }
    }
    << out
}

fn is_localhost_name(s &string) bool {
    tlow := ascii_lower(s)
    t := strip_trailing_dot(tlow)
    if t == "localhost" {
        << true
    }
    if t == "localhost.localdomain" {
        << true
    }
    << false
}
