@net

#errors
#os

// Common socket options and level definitions across Darwin, Linux, and Windows.
// Level and optname numbers match host operating system ABIs.

pub const IPPROTO_TCP = 6
pub const TCP_NODELAY = 1

fn sol_socket() int {
    if xu_target_os() == 1 { << 1 }
    << 65535
}

fn so_reuseaddr() int {
    if xu_target_os() == 1 { << 2 }
    << 4
}

// 0 where the host has no SO_REUSEPORT (Winsock: SO_REUSEADDR already
// permits several multicast listeners on one port).
fn so_reuseport() int {
    os := xu_target_os()
    if os == 0 { << 512 }
    if os == 1 { << 15 }
    << 0
}

fn so_broadcast() int {
    if xu_target_os() == 1 { << 6 }
    << 32
}

fn so_keepalive() int {
    if xu_target_os() == 1 { << 9 }
    << 8
}

fn so_sndbuf() int {
    if xu_target_os() == 1 { << 7 }
    << 4097
}

fn so_rcvbuf() int {
    if xu_target_os() == 1 { << 8 }
    << 4098
}
