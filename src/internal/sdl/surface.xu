@internal/sdl
// Swapchain surfaces and frames (former surface.h).
// Window records store the bound surface at WR_BINDING. window_close calls
// release_window_surface before destroying the native window.

#ffi

extern "C" fn sdl_claim_window_for_gpu_device(fn_ptr c_ptr, device c_ptr, window c_ptr) u8 = dynamic
extern "C" fn sdl_release_window_from_gpu_device(fn_ptr c_ptr, device c_ptr, window c_ptr) = dynamic
extern "C" fn sdl_window_supports_gpu_present_mode(fn_ptr c_ptr, device c_ptr, window c_ptr, mode u32) u8 = dynamic
extern "C" fn sdl_set_gpu_swapchain_parameters(fn_ptr c_ptr, device c_ptr, window c_ptr, composition u32, mode u32) u8 = dynamic
extern "C" fn sdl_get_gpu_swapchain_texture_format(fn_ptr c_ptr, device c_ptr, window c_ptr) u32 = dynamic
extern "C" fn sdl_wait_and_acquire_gpu_swapchain_texture(fn_ptr c_ptr, command c_ptr, window c_ptr, texture c_ptr, width c_ptr, height c_ptr) u8 = dynamic
extern "C" fn sdl_submit_gpu_command_buffer(fn_ptr c_ptr, command c_ptr) u8 = dynamic

const SF_ID = 0
const SF_FRAME = 8
const SF_OWNER = 16
const SF_WIN = 24
const SF_FORMAT = 32
const SF_NEXT = 40
const SF_SIZE = 48

fn surface_record(d c_ptr, id int) c_ptr {
    unsafe {
        $s := ffi.read_ptr(d, D_SURFACES)
        while !ffi.is_null(s) {
            if ffi.read_i64(s, SF_ID) == id { << s }
            s = ffi.read_ptr(s, SF_NEXT)
        }
        fail("closed, foreign or invalid GPU surface")
        << ffi.null()
    }
}

fn swapchain_format(d c_ptr, w c_ptr) int {
    unsafe {
        native := sdl_get_gpu_swapchain_texture_format(sym(SYM_GET_GPU_SWAPCHAIN_TEXTURE_FORMAT), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE))
        for format in 1:22 {
            if sdl_tex_format(format) == native { << format }
        }
        fail("GPU swapchain format is not represented by gpu/layout")
        << 0
    }
}

fn surface_encoder_released(e c_ptr) {
    unsafe {
        s := ffi.read_ptr(e, E_SURFACE)
        if ffi.is_null(s) { << }
        if ffi.read_i64(s, SF_FRAME) == ffi.read_i64(e, E_ID) { ffi.write_i64(s, SF_FRAME, 0) }
    }
}

fn abandon_surface(e c_ptr) bool {
    $bad := false
    $saved := ffi.null()
    unsafe {
        target := ffi.calloc(64)
        if ffi.is_null(target) {
            fail("GPU command encoder allocation failed")
            << false
        }
        ffi.write_ptr(target, 0, ffi.read_ptr(present_of(e), R_GPU))
        ffi.write_u32(target, 32, u32(1))
        ffi.write_f32(target, 28, f32(1.0))
        clear := sdl_begin_gpu_render_pass(sym(SYM_BEGIN_GPU_RENDER_PASS), ffi.read_ptr(e, E_COMMAND), target, u32(1), ffi.null())
        ffi.free(target)
        if !ffi.is_null(clear) {
            sdl_end_gpu_render_pass(sym(SYM_END_GPU_RENDER_PASS), clear)
        } else {
            sdl_fail()
            saved = error_save()
            bad = true
        }
        if sdl_submit_gpu_command_buffer(sym(SYM_SUBMIT_GPU_COMMAND_BUFFER), ffi.read_ptr(e, E_COMMAND)) == u8(0) {
            sdl_fail()
            if !bad { saved = error_save() }
            bad = true
        }
    }
    if bad { error_restore(saved) }
    << !bad
}

fn unlink_surface(d c_ptr, s c_ptr) {
    unsafe {
        $prev := ffi.null()
        $cur := ffi.read_ptr(d, D_SURFACES)
        while !ffi.is_null(cur) {
            if cur == s { <- }
            prev = cur
            cur = ffi.read_ptr(cur, SF_NEXT)
        }
        if ffi.is_null(cur) { << }
        next := ffi.read_ptr(s, SF_NEXT)
        if ffi.is_null(prev) {
            ffi.write_ptr(d, D_SURFACES, next)
        } else {
            ffi.write_ptr(prev, SF_NEXT, next)
        }
    }
}

fn destroy_surface(s c_ptr, wait bool) bool {
    $bad := false
    $saved := ffi.null()
    unsafe {
        d := ffi.read_ptr(s, SF_OWNER)
        frame := ffi.read_i64(s, SF_FRAME)
        if frame != 0 {
            e := encoder_record(d, frame, false)
            if !ffi.is_null(e) && !free_encoder(d, e, true) {
                saved = error_save()
                bad = true
            }
        }
        if wait && sdl_wait_for_gpu_idle(sym(SYM_WAIT_FOR_GPU_IDLE), ffi.read_ptr(d, D_GPU)) == u8(0) {
            sdl_fail()
            if !bad { saved = error_save() }
            bad = true
        }
        w := ffi.read_ptr(s, SF_WIN)
        sdl_release_window_from_gpu_device(sym(SYM_RELEASE_WINDOW_FROM_GPU_DEVICE), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE))
        ffi.write_ptr(w, WR_BINDING, ffi.null())
        unlink_surface(d, s)
        ffi.free(s)
    }
    if bad { error_restore(saved) }
    << !bad
}

fn release_window_surface(binding c_ptr) bool {
    << destroy_surface(binding, true)
}

fn close_surfaces(d c_ptr) bool {
    $bad := false
    $saved := ffi.null()
    unsafe {
        while !ffi.is_null(ffi.read_ptr(d, D_SURFACES)) {
            if !destroy_surface(ffi.read_ptr(d, D_SURFACES), false) {
                if !bad { saved = error_save() }
                bad = true
            }
        }
    }
    if bad { error_restore(saved) }
    << !bad
}

fn release_claimed(d c_ptr, w c_ptr) {
    unsafe {
        sdl_release_window_from_gpu_device(sym(SYM_RELEASE_WINDOW_FROM_GPU_DEVICE), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE))
    }
}

pub fn surface_new(owner int, window_id int, mode int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_render_syms() || !load_surface_syms() { << -1 }
    w := window_record(window_id)
    if ffi.is_null(w) { << -1 }
    unsafe {
        if !ffi.is_null(ffi.read_ptr(w, WR_BINDING)) || mode < 0 || mode > 2 {
            << fail("window already bound or invalid present mode")
        }
        s := ffi.calloc(SF_SIZE)
        if ffi.is_null(s) { << fail("GPU surface allocation failed") }
        id := identifier()
        if id < 0 {
            ffi.free(s)
            << -1
        }
        ffi.write_i64(s, SF_ID, id)
        if sdl_claim_window_for_gpu_device(sym(SYM_CLAIM_WINDOW_FOR_GPU_DEVICE), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE)) == u8(0) {
            sdl_fail()
            ffi.free(s)
            << -1
        }
        if sdl_window_supports_gpu_present_mode(sym(SYM_WINDOW_SUPPORTS_GPU_PRESENT_MODE), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE), u32(mode)) == u8(0) {
            fail("GPU present mode is unsupported for this window")
            release_claimed(d, w)
            ffi.free(s)
            << -1
        }
        if mode != 0 && sdl_set_gpu_swapchain_parameters(sym(SYM_SET_GPU_SWAPCHAIN_PARAMETERS), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE), u32(0), u32(mode)) == u8(0) {
            sdl_fail()
            release_claimed(d, w)
            ffi.free(s)
            << -1
        }
        format := swapchain_format(d, w)
        if format == 0 {
            release_claimed(d, w)
            ffi.free(s)
            << -1
        }
        ffi.write_ptr(s, SF_OWNER, d)
        ffi.write_ptr(s, SF_WIN, w)
        ffi.write_i64(s, SF_FORMAT, format)
        ffi.write_ptr(s, SF_NEXT, ffi.read_ptr(d, D_SURFACES))
        ffi.write_ptr(d, D_SURFACES, s)
        ffi.write_ptr(w, WR_BINDING, s)
        << id
    }
}

pub fn surface_close(owner int, id int) int {
    if !on_main() { << -1 }
    d := device_by_id(owner)
    if ffi.is_null(d) { << 0 }
    unsafe {
        $s := ffi.read_ptr(d, D_SURFACES)
        while !ffi.is_null(s) {
            if ffi.read_i64(s, SF_ID) == id {
                if destroy_surface(s, true) { << 0 }
                << -1
            }
            s = ffi.read_ptr(s, SF_NEXT)
        }
        << 0
    }
}

pub fn surface_format(owner int, id int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    s := surface_record(d, id)
    if ffi.is_null(s) { << -1 }
    unsafe { << ffi.read_i64(s, SF_FORMAT) }
}

pub fn surface_supports_mode(owner int, id int, mode int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    s := surface_record(d, id)
    if ffi.is_null(s) { << -1 }
    if mode < 0 || mode > 2 { << fail("invalid GPU present mode") }
    unsafe {
        w := ffi.read_ptr(s, SF_WIN)
        if sdl_window_supports_gpu_present_mode(sym(SYM_WINDOW_SUPPORTS_GPU_PRESENT_MODE), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE), u32(mode)) != u8(0) {
            << 1
        }
        << 0
    }
}

pub fn surface_mode(owner int, id int, mode int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    s := surface_record(d, id)
    if ffi.is_null(s) { << -1 }
    unsafe {
        if ffi.read_i64(s, SF_FRAME) != 0 || mode < 0 || mode > 2 {
            << fail("invalid present mode or reconfiguration with acquired frame")
        }
        w := ffi.read_ptr(s, SF_WIN)
        if sdl_window_supports_gpu_present_mode(sym(SYM_WINDOW_SUPPORTS_GPU_PRESENT_MODE), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE), u32(mode)) == u8(0) {
            << fail("unsupported GPU present mode")
        }
        if sdl_set_gpu_swapchain_parameters(sym(SYM_SET_GPU_SWAPCHAIN_PARAMETERS), ffi.read_ptr(d, D_GPU), ffi.read_ptr(w, WR_NATIVE), u32(0), u32(mode)) == u8(0) {
            << sdl_fail()
        }
        format := swapchain_format(d, w)
        if format == 0 {
            saved := error_save()
            destroy_surface(s, true)
            error_restore(saved)
            << -1
        }
        ffi.write_i64(s, SF_FORMAT, format)
        << 0
    }
}

pub fn frame_acquire(owner int, id int, output $&[]int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    s := surface_record(d, id)
    if ffi.is_null(s) { << -1 }
    unsafe {
        w := ffi.read_ptr(s, SF_WIN)
        if ffi.read_i64(s, SF_FRAME) != 0 || ffi.read_i64(w, WR_CLOSED) != 0 || output.len != 3 {
            << fail("GPU surface already has an acquired frame or invalid frame output")
        }
    }
    handle := encoder_new(owner)
    if handle < 0 { << -1 }
    e := encoder_record(d, handle, false)
    if ffi.is_null(e) { << -1 }
    unsafe {
        slot := ffi.calloc(16)
        if ffi.is_null(slot) {
            free_encoder(d, e, true)
            << fail("GPU command encoder allocation failed")
        }
        w := ffi.read_ptr(s, SF_WIN)
        ok := sdl_wait_and_acquire_gpu_swapchain_texture(sym(SYM_WAIT_AND_ACQUIRE_GPU_SWAPCHAIN_TEXTURE), ffi.read_ptr(e, E_COMMAND), ffi.read_ptr(w, WR_NATIVE), slot, ffi.offset(slot, 8), ffi.offset(slot, 12))
        if ok == u8(0) {
            sdl_fail()
            saved := error_save()
            ffi.free(slot)
            free_encoder(d, e, true)
            error_restore(saved)
            << -1
        }
        image := ffi.read_ptr(slot, 0)
        width := int(ffi.read_u32(slot, 8))
        height := int(ffi.read_u32(slot, 12))
        ffi.free(slot)
        if ffi.is_null(image) {
            if !free_encoder(d, e, true) { << -1 }
            output[0] = 0
            output[1] = 0
            output[2] = 0
            << 0
        }
        ffi.write_ptr(e, E_SURFACE, s)
        ffi.write_i64(s, SF_FRAME, ffi.read_i64(e, E_ID))
        pt := present_of(e)
        ffi.write_ptr(pt, R_GPU, image)
        format := swapchain_format(d, w)
        if format == 0 || width == 0 || height == 0 {
            if format != 0 { fail("GPU acquired an empty swapchain image") }
            saved := error_save()
            free_encoder(d, e, true)
            error_restore(saved)
            << -1
        }
        ffi.write_i64(pt, R_KIND, KIND_TEXTURE)
        ffi.write_i64(pt, R_FORMAT, format)
        ffi.write_i64(pt, R_WIDTH, width)
        ffi.write_i64(pt, R_HEIGHT, height)
        ffi.write_i64(pt, R_LEVELS, 1)
        ffi.write_i64(pt, R_USAGE, 2)
        output[0] = width
        output[1] = height
        output[2] = format
        << ffi.read_i64(e, E_ID)
    }
}

pub fn frame_begin(owner int, id int, desc &[]int, red f64, green f64, blue f64, alpha f64, clear_depth f64) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, false)
    if ffi.is_null(e) { << -1 }
    unsafe {
        if ffi.is_null(ffi.read_ptr(e, E_SURFACE)) || desc.len != 4 || (ffi.read_i64(e, E_PPASS) == 0 && desc[0] == 0) {
            << fail("invalid GPU frame descriptor or LOAD before initial render")
        }
    }
    $depth := ffi.null()
    if desc[1] != 0 {
        depth = resource_record(d, desc[1], KIND_TEXTURE)
        if ffi.is_null(depth) { << -1 }
    }
    pass := begin_render_pass(e, present_of(e), 0, desc[0], 0, depth, desc[2], desc[3], red, green, blue, alpha, clear_depth)
    if pass > 0 {
        unsafe { ffi.write_i64(e, E_PPASS, ffi.read_i64(e, E_PPASS) + 1) }
    }
    << pass
}

pub fn frame_submit(owner int, id int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, false)
    if ffi.is_null(e) { << -1 }
    unsafe {
        if ffi.is_null(ffi.read_ptr(e, E_SURFACE)) || ffi.read_i64(e, E_PPASS) == 0 {
            << fail("GPU frame needs a render pass before presentation")
        }
    }
    << encoder_submit(owner, id)
}

pub fn frame_close(owner int, id int) int {
    << encoder_close(owner, id)
}
