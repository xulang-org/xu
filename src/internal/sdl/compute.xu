@internal/sdl
// Compute pipelines and passes (former compute.h).

#ffi

extern "C" fn sdl_create_gpu_compute_pipeline(fn_ptr c_ptr, device c_ptr, info c_ptr) c_ptr = dynamic
extern "C" fn sdl_release_gpu_compute_pipeline(fn_ptr c_ptr, device c_ptr, pipeline c_ptr) = dynamic
extern "C" fn sdl_begin_gpu_compute_pass(fn_ptr c_ptr, command c_ptr, textures c_ptr, ntex u32, buffers c_ptr, nbuf u32) c_ptr = dynamic
extern "C" fn sdl_end_gpu_compute_pass(fn_ptr c_ptr, pass c_ptr) = dynamic
extern "C" fn sdl_bind_gpu_compute_pipeline(fn_ptr c_ptr, pass c_ptr, pipeline c_ptr) = dynamic
extern "C" fn sdl_bind_gpu_compute_storage_buffers(fn_ptr c_ptr, pass c_ptr, slot u32, buffers c_ptr, count u32) = dynamic
extern "C" fn sdl_push_gpu_compute_uniform_data(fn_ptr c_ptr, command c_ptr, slot u32, data c_ptr, len u32) = dynamic
extern "C" fn sdl_dispatch_gpu_compute(fn_ptr c_ptr, pass c_ptr, x u32, y u32, z u32) = dynamic
extern "C" fn sdl_bind_gpu_compute_samplers(fn_ptr c_ptr, pass c_ptr, slot u32, bindings c_ptr, count u32) = dynamic
extern "C" fn sdl_bind_gpu_compute_storage_textures(fn_ptr c_ptr, pass c_ptr, slot u32, textures c_ptr, count u32) = dynamic
extern "C" fn sdl_dispatch_gpu_compute_indirect(fn_ptr c_ptr, pass c_ptr, buffer c_ptr, offset u32) = dynamic

const COMPUTE_STORAGE_SLOTS = 8
const COMPUTE_THREADS = 1024
const COMPUTE_THREADS_Z = 64
const COMPUTE_GROUPS = 65535

fn create_compute_pipeline(owner int, format int, samplers int, read_textures int, read_buffers int, write_textures int, write_buffers int, tx int, ty int, tz int, sizes &[]int, entry &[]u8, code &[]u8) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_compute_syms() { << -1 }
    if samplers < 0 || samplers > SAMPLER_SLOTS || read_textures < 0 || read_textures > COMPUTE_STORAGE_SLOTS || read_buffers < 0 || read_buffers > COMPUTE_STORAGE_SLOTS || write_textures < 0 || write_textures > COMPUTE_STORAGE_SLOTS || write_buffers < 0 || write_buffers > COMPUTE_STORAGE_SLOTS || tx < 1 || tx > COMPUTE_THREADS || ty < 1 || ty > COMPUTE_THREADS || tz < 1 || tz > COMPUTE_THREADS_Z || tx * ty * tz > COMPUTE_THREADS {
        << fail("invalid GPU compute binding counts or local thread dimensions")
    }
    src := prepare_shader(owner, format, sizes, entry, code)
    if ffi.is_null(src) { << -1 }
    unsafe {
        r := allocate_resource(KIND_COMPUTE)
        if ffi.is_null(r) {
            free_shader_source(src)
            << -1
        }
        ffi.write_i64(r, R_CSAMPS, samplers)
        ffi.write_i64(r, R_CRTEX, read_textures)
        ffi.write_i64(r, R_READS, read_buffers)
        ffi.write_i64(r, R_CWTEX, write_textures)
        ffi.write_i64(r, R_WRITES, write_buffers)
        set_bind_field(r, 0, BND_COUNT, sizes.len)
        for i in 0:sizes.len { set_bind_field(r, 0, BND_SIZES + i * 4, sizes[i]) }
        info := ffi.calloc(72)
        if ffi.is_null(info) {
            ffi.free(r)
            free_shader_source(src)
            << fail("GPU resource allocation failed")
        }
        ffi.write_u64(info, 0, u64(code.len))
        ffi.write_ptr(info, 8, ffi.read_ptr(src, SS_BYTES))
        ffi.write_ptr(info, 16, ffi.read_ptr(src, SS_NAME))
        ffi.write_u32(info, 24, u32(format) << 1)
        ffi.write_u32(info, 28, u32(samplers))
        ffi.write_u32(info, 32, u32(read_textures))
        ffi.write_u32(info, 36, u32(read_buffers))
        ffi.write_u32(info, 40, u32(write_textures))
        ffi.write_u32(info, 44, u32(write_buffers))
        ffi.write_u32(info, 48, u32(sizes.len))
        ffi.write_u32(info, 52, u32(tx))
        ffi.write_u32(info, 56, u32(ty))
        ffi.write_u32(info, 60, u32(tz))
        gpu := sdl_create_gpu_compute_pipeline(sym(SYM_CREATE_GPU_COMPUTE_PIPELINE), ffi.read_ptr(d, D_GPU), info)
        ffi.free(info)
        free_shader_source(src)
        if ffi.is_null(gpu) {
            sdl_fail()
            ffi.free(r)
            << -1
        }
        ffi.write_ptr(r, R_GPU, gpu)
        << add_resource(d, r)
    }
}

pub fn compute_pipeline_new(owner int, desc &[]int, sizes &[]int, entry &[]u8, code &[]u8) int {
    if desc.len != 6 { << fail("invalid GPU compute descriptor") }
    << create_compute_pipeline(owner, desc[0], 0, 0, desc[1], 0, desc[2], desc[3], desc[4], desc[5], sizes, entry, code)
}

pub fn compute_pipeline_resources_new(owner int, desc &[]int, sizes &[]int, entry &[]u8, code &[]u8) int {
    if desc.len != 9 { << fail("invalid GPU compute descriptor") }
    << create_compute_pipeline(owner, desc[0], desc[1], desc[2], desc[3], desc[4], desc[5], desc[6], desc[7], desc[8], sizes, entry, code)
}

fn compute_pass(d c_ptr, id int) c_ptr {
    unsafe {
        $e := ffi.read_ptr(d, D_ENCODERS)
        while !ffi.is_null(e) {
            if !ffi.is_null(ffi.read_ptr(e, E_COMPUTE)) && ffi.read_i64(e, E_PASS_ID) == id { << e }
            e = ffi.read_ptr(e, E_NEXT)
        }
        fail("closed or invalid GPU compute pass")
        << ffi.null()
    }
}

pub fn compute_begin_resources(owner int, id int, tex_writes &[]int, writes &[]int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_compute_syms() { << -1 }
    e := encoder_record(d, id, false)
    if ffi.is_null(e) { << -1 }
    unsafe {
        if !ffi.is_null(ffi.read_ptr(e, E_PASS)) || !ffi.is_null(ffi.read_ptr(e, E_COMPUTE)) || tex_writes.len < 0 || tex_writes.len > COMPUTE_STORAGE_SLOTS * 4 || (tex_writes.len % 4) != 0 || writes.len < 0 || writes.len > COMPUTE_STORAGE_SLOTS * 2 || (writes.len % 2) != 0 {
            << fail("invalid GPU compute pass state or write bindings")
        }
        tcount := tex_writes.len / 4
        bcount := writes.len / 2
        tbindings := ffi.calloc(192)
        texs := ffi.calloc(64)
        bindings := ffi.calloc(128)
        bufs := ffi.calloc(64)
        if ffi.is_null(tbindings) || ffi.is_null(texs) || ffi.is_null(bindings) || ffi.is_null(bufs) {
            ffi.free(tbindings)
            ffi.free(texs)
            ffi.free(bindings)
            ffi.free(bufs)
            << fail("GPU command encoder allocation failed")
        }
        for i in 0:tcount {
            t := resource_record(d, tex_writes[i * 4], KIND_TEXTURE)
            if ffi.is_null(t) {
                ffi.free(tbindings)
                ffi.free(texs)
                ffi.free(bindings)
                ffi.free(bufs)
                << -1
            }
            mip := tex_writes[i * 4 + 1]
            layer := tex_writes[i * 4 + 2]
            cycle := tex_writes[i * 4 + 3]
            usage := ffi.read_i64(t, R_USAGE)
            if (usage & 96) == 0 || mip < 0 || mip >= ffi.read_i64(t, R_LEVELS) || layer < 0 || cycle < 0 || cycle > 1 {
                ffi.free(tbindings)
                ffi.free(texs)
                ffi.free(bindings)
                ffi.free(bufs)
                << fail("invalid GPU compute texture write usage, mip, layer or cycle flag")
            }
            for j in 0:i {
                if ffi.read_ptr(texs, j * 8) == t && tex_writes[j * 4 + 1] == mip && tex_writes[j * 4 + 2] == layer {
                    ffi.free(tbindings)
                    ffi.free(texs)
                    ffi.free(bindings)
                    ffi.free(bufs)
                    << fail("duplicate GPU compute write texture subresource")
                }
            }
            ffi.write_ptr(texs, i * 8, t)
            ffi.write_ptr(tbindings, i * 24, ffi.read_ptr(t, R_GPU))
            ffi.write_u32(tbindings, i * 24 + 8, u32(mip))
            ffi.write_u32(tbindings, i * 24 + 12, u32(layer))
            if cycle != 0 { ffi.write_u8(tbindings, i * 24 + 16, u8(1)) }
        }
        for i in 0:bcount {
            b := buffer_record(d, writes[i * 2])
            if ffi.is_null(b) {
                ffi.free(tbindings)
                ffi.free(texs)
                ffi.free(bindings)
                ffi.free(bufs)
                << -1
            }
            cycle := writes[i * 2 + 1]
            if (int(ffi.read_u32(b, B_USAGE)) & 32) == 0 || cycle < 0 || cycle > 1 {
                ffi.free(tbindings)
                ffi.free(texs)
                ffi.free(bindings)
                ffi.free(bufs)
                << fail("invalid GPU compute write usage or cycle flag")
            }
            for j in 0:i {
                if ffi.read_ptr(bufs, j * 8) == b {
                    ffi.free(tbindings)
                    ffi.free(texs)
                    ffi.free(bindings)
                    ffi.free(bufs)
                    << fail("duplicate GPU compute write buffer")
                }
            }
            ffi.write_ptr(bufs, i * 8, b)
            ffi.write_ptr(bindings, i * 16, ffi.read_ptr(b, B_GPU))
            if cycle != 0 { ffi.write_u8(bindings, i * 16 + 8, u8(1)) }
        }
        pass_id := identifier()
        if pass_id < 0 {
            ffi.free(tbindings)
            ffi.free(texs)
            ffi.free(bindings)
            ffi.free(bufs)
            << -1
        }
        for i in 0:tcount {
            if !retain(e, ffi.read_ptr(texs, i * 8), false) {
                ffi.free(tbindings)
                ffi.free(texs)
                ffi.free(bindings)
                ffi.free(bufs)
                << -1
            }
        }
        for i in 0:bcount {
            if !retain(e, ffi.read_ptr(bufs, i * 8), true) {
                ffi.free(tbindings)
                ffi.free(texs)
                ffi.free(bindings)
                ffi.free(bufs)
                << -1
            }
        }
        $tp := ffi.null()
        if tcount > 0 { tp = tbindings }
        $bp := ffi.null()
        if bcount > 0 { bp = bindings }
        pass := sdl_begin_gpu_compute_pass(sym(SYM_BEGIN_GPU_COMPUTE_PASS), ffi.read_ptr(e, E_COMMAND), tp, u32(tcount), bp, u32(bcount))
        ffi.free(tbindings)
        ffi.free(bindings)
        if ffi.is_null(pass) {
            ffi.free(texs)
            ffi.free(bufs)
            << sdl_fail()
        }
        ffi.write_ptr(e, E_COMPUTE, pass)
        ffi.write_i64(e, E_PASS_ID, pass_id)
        ffi.write_i64(e, E_WTCOUNT, tcount)
        ffi.write_i64(e, E_WCOUNT, bcount)
        ffi.write_ptr(e, E_PIPE, ffi.null())
        ffi.write_i64(e, E_CREADS, 0)
        ffi.write_i64(e, E_CSAMPS, 0)
        ffi.write_i64(e, E_CRTEX, 0)
        ffi.write_i64(e, E_UNIF, 0)
        for i in 0:tcount { ffi.write_ptr(e, E_WTEX + i * 8, ffi.read_ptr(texs, i * 8)) }
        for i in 0:bcount { ffi.write_ptr(e, E_WRITES + i * 8, ffi.read_ptr(bufs, i * 8)) }
        ffi.free(texs)
        ffi.free(bufs)
        << pass_id
    }
}

pub fn compute_begin(owner int, id int, writes &[]int) int {
    no_tex := []int{}
    << compute_begin_resources(owner, id, &no_tex, writes)
}

fn compute_write_texture_aliases(e c_ptr, t c_ptr) bool {
    unsafe {
        n := ffi.read_i64(e, E_WTCOUNT)
        for i in 0:n {
            if ffi.read_ptr(e, E_WTEX + i * 8) == t { << true }
        }
        << false
    }
}

pub fn compute_pipeline(owner int, id int, pipeline int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := compute_pass(d, id)
    if ffi.is_null(e) { << -1 }
    r := resource_record(d, pipeline, KIND_COMPUTE)
    if ffi.is_null(r) { << -1 }
    unsafe {
        if ffi.read_i64(r, R_WRITES) != ffi.read_i64(e, E_WCOUNT) || ffi.read_i64(r, R_CWTEX) != ffi.read_i64(e, E_WTCOUNT) {
            << fail("GPU compute pipeline write count does not match pass")
        }
        if !retain(e, r, false) { << -1 }
        sdl_bind_gpu_compute_pipeline(sym(SYM_BIND_GPU_COMPUTE_PIPELINE), ffi.read_ptr(e, E_COMPUTE), ffi.read_ptr(r, R_GPU))
        ffi.write_ptr(e, E_PIPE, r)
        ffi.write_i64(e, E_CREADS, 0)
        ffi.write_i64(e, E_CSAMPS, 0)
        ffi.write_i64(e, E_CRTEX, 0)
        ffi.write_i64(e, E_UNIF, 0)
        << 0
    }
}

pub fn compute_sampler(owner int, id int, slot int, texture int, sampler int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := compute_pass(d, id)
    if ffi.is_null(e) { << -1 }
    t := resource_record(d, texture, KIND_TEXTURE)
    if ffi.is_null(t) { << -1 }
    s := resource_record(d, sampler, KIND_SAMPLER)
    if ffi.is_null(s) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || slot < 0 || slot >= ffi.read_i64(pipe, R_CSAMPS) || (ffi.read_i64(t, R_USAGE) & 1) == 0 || compute_write_texture_aliases(e, t) {
            << fail("GPU compute sampler binding is undeclared, not sampled or aliases a write texture")
        }
        if !retain(e, t, false) || !retain(e, s, false) { << -1 }
        binding := ffi.calloc(16)
        if ffi.is_null(binding) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(binding, 0, ffi.read_ptr(t, R_GPU))
        ffi.write_ptr(binding, 8, ffi.read_ptr(s, R_GPU))
        sdl_bind_gpu_compute_samplers(sym(SYM_BIND_GPU_COMPUTE_SAMPLERS), ffi.read_ptr(e, E_COMPUTE), u32(slot), binding, u32(1))
        ffi.free(binding)
        ffi.write_i64(e, E_CSAMPS, ffi.read_i64(e, E_CSAMPS) | (1 << slot))
        << 0
    }
}

pub fn compute_read_texture(owner int, id int, slot int, texture int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := compute_pass(d, id)
    if ffi.is_null(e) { << -1 }
    t := resource_record(d, texture, KIND_TEXTURE)
    if ffi.is_null(t) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || slot < 0 || slot >= ffi.read_i64(pipe, R_CRTEX) || (ffi.read_i64(t, R_USAGE) & 16) == 0 || compute_write_texture_aliases(e, t) {
            << fail("GPU compute read texture is undeclared, unreadable or aliases a write texture")
        }
        if !retain(e, t, false) { << -1 }
        slotp := ffi.calloc(8)
        if ffi.is_null(slotp) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(slotp, 0, ffi.read_ptr(t, R_GPU))
        sdl_bind_gpu_compute_storage_textures(sym(SYM_BIND_GPU_COMPUTE_STORAGE_TEXTURES), ffi.read_ptr(e, E_COMPUTE), u32(slot), slotp, u32(1))
        ffi.free(slotp)
        ffi.write_i64(e, E_CRTEX, ffi.read_i64(e, E_CRTEX) | (1 << slot))
        << 0
    }
}

pub fn compute_buffer(owner int, id int, slot int, buffer_id int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := compute_pass(d, id)
    if ffi.is_null(e) { << -1 }
    b := buffer_record(d, buffer_id)
    if ffi.is_null(b) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || slot < 0 || slot >= ffi.read_i64(pipe, R_READS) || (int(ffi.read_u32(b, B_USAGE)) & 16) == 0 {
            << fail("GPU compute read buffer is undeclared or has invalid usage")
        }
        nwrite := ffi.read_i64(e, E_WCOUNT)
        for i in 0:nwrite {
            if ffi.read_ptr(e, E_WRITES + i * 8) == b {
                << fail("GPU compute read buffer aliases a write binding")
            }
        }
        if !retain(e, b, true) { << -1 }
        slotp := ffi.calloc(8)
        if ffi.is_null(slotp) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(slotp, 0, ffi.read_ptr(b, B_GPU))
        sdl_bind_gpu_compute_storage_buffers(sym(SYM_BIND_GPU_COMPUTE_STORAGE_BUFFERS), ffi.read_ptr(e, E_COMPUTE), u32(slot), slotp, u32(1))
        ffi.free(slotp)
        ffi.write_i64(e, E_CREADS, ffi.read_i64(e, E_CREADS) | (1 << slot))
        << 0
    }
}

pub fn compute_uniform(owner int, id int, slot int, data &[]u8) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := compute_pass(d, id)
    if ffi.is_null(e) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || slot < 0 || slot >= bind_field(pipe, 0, BND_COUNT) || data.len != bind_field(pipe, 0, BND_SIZES + slot * 4) {
            << fail("GPU compute uniform requires its declared exact byte size")
        }
        raw := bytes_data(data)
        if ffi.is_null(raw) { << fail("GPU compute uniform requires its declared exact byte size") }
        sdl_push_gpu_compute_uniform_data(sym(SYM_PUSH_GPU_COMPUTE_UNIFORM_DATA), ffi.read_ptr(e, E_COMMAND), u32(slot), raw, u32(data.len))
        ffi.free(raw)
        ffi.write_i64(e, E_UNIF, ffi.read_i64(e, E_UNIF) | (1 << slot))
        << 0
    }
}

fn check_compute_bindings(e c_ptr, pipe c_ptr) bool {
    unsafe {
        << ffi.read_i64(e, E_CREADS) == mask_n(ffi.read_i64(pipe, R_READS)) && ffi.read_i64(e, E_UNIF) == mask_n(bind_field(pipe, 0, BND_COUNT)) && ffi.read_i64(e, E_CSAMPS) == mask_n(ffi.read_i64(pipe, R_CSAMPS)) && ffi.read_i64(e, E_CRTEX) == mask_n(ffi.read_i64(pipe, R_CRTEX))
    }
}

pub fn compute_dispatch(owner int, id int, x int, y int, z int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := compute_pass(d, id)
    if ffi.is_null(e) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || x < 1 || x > COMPUTE_GROUPS || y < 1 || y > COMPUTE_GROUPS || z < 1 || z > COMPUTE_GROUPS {
            << fail("invalid GPU compute dispatch range or missing pipeline")
        }
        if !check_compute_bindings(e, pipe) {
            << fail("GPU compute dispatch has missing sampler, texture, buffer or uniform bindings")
        }
        sdl_dispatch_gpu_compute(sym(SYM_DISPATCH_GPU_COMPUTE), ffi.read_ptr(e, E_COMPUTE), u32(x), u32(y), u32(z))
        << 0
    }
}

pub fn compute_dispatch_indirect(owner int, id int, buffer_id int, offset int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := compute_pass(d, id)
    if ffi.is_null(e) { << -1 }
    b := buffer_record(d, buffer_id)
    if ffi.is_null(b) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || offset < 0 || (offset % 4) != 0 {
            << fail("invalid GPU indirect compute dispatch offset or missing pipeline")
        }
        buf_size := int(ffi.read_u32(b, B_SIZE))
        usage := int(ffi.read_u32(b, B_USAGE))
        if (usage & 4) == 0 || offset > buf_size || 12 > buf_size - offset {
            << fail("GPU indirect compute buffer has invalid usage or exceeds bounds")
        }
        if !check_compute_bindings(e, pipe) {
            << fail("GPU compute dispatch has missing sampler, texture, buffer or uniform bindings")
        }
        if !retain(e, b, true) { << -1 }
        sdl_dispatch_gpu_compute_indirect(sym(SYM_DISPATCH_GPU_COMPUTE_INDIRECT), ffi.read_ptr(e, E_COMPUTE), ffi.read_ptr(b, B_GPU), u32(offset))
        << 0
    }
}

pub fn compute_end(owner int, id int) int {
    if !on_main() { << -1 }
    d := device_by_id(owner)
    if ffi.is_null(d) { << 0 }
    unsafe {
        $e := ffi.read_ptr(d, D_ENCODERS)
        while !ffi.is_null(e) {
            if !ffi.is_null(ffi.read_ptr(e, E_COMPUTE)) && ffi.read_i64(e, E_PASS_ID) == id {
                sdl_end_gpu_compute_pass(sym(SYM_END_GPU_COMPUTE_PASS), ffi.read_ptr(e, E_COMPUTE))
                ffi.write_ptr(e, E_COMPUTE, ffi.null())
                << 0
            }
            e = ffi.read_ptr(e, E_NEXT)
        }
        << 0
    }
}
