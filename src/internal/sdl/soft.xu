@internal/sdl
// Process-local SoftBlob byte store. SoftBlobRef is a non-owning (owner, handle, bytes) identity.

#ffi

// Slot 1 in process storage for soft blob store head pointer.
const SLOT_SOFT = 1

// SoftBlobRecord (calloc 40 bytes):
// owner (8), handle (8), bytes (8), data (8), next (8)
const SB_OWNER = 0
const SB_HANDLE = 8
const SB_BYTES = 16
const SB_DATA = 24
const SB_NEXT = 32
const SB_RECORD_SIZE = 40

fn soft_head() c_ptr {
    unsafe { << ffi.process_get(SLOT_SOFT) }
}

fn set_soft_head(p c_ptr) {
    unsafe { ffi.process_set(SLOT_SOFT, p) }
}

fn soft_find(owner int, handle int) c_ptr {
    unsafe {
        $b := soft_head()
        while !ffi.is_null(b) {
            if ffi.read_i64(b, SB_OWNER) == owner && ffi.read_i64(b, SB_HANDLE) == handle {
                << b
            }
            b = ffi.read_ptr(b, SB_NEXT)
        }
        << ffi.null()
    }
}

pub fn soft_owner_new() int {
    if !on_main() { << -1 }
    id := identifier()
    if id <= 0 { << fail("soft owner allocation failed") }
    << id
}

pub fn soft_owner_close(owner int) int {
    if !on_main() { << -1 }
    if owner <= 0 { << fail("invalid soft owner") }
    unsafe {
        $prev := ffi.null()
        $b := soft_head()
        while !ffi.is_null(b) {
            next := ffi.read_ptr(b, SB_NEXT)
            if ffi.read_i64(b, SB_OWNER) == owner {
                data := ffi.read_ptr(b, SB_DATA)
                if !ffi.is_null(data) { ffi.free(data) }
                ffi.free(b)
                if ffi.is_null(prev) {
                    set_soft_head(next)
                } else {
                    ffi.write_ptr(prev, SB_NEXT, next)
                }
            } else {
                prev = b
            }
            b = next
        }
    }
    << 0
}

pub fn soft_blob_create(owner int, bytes &[]u8) int {
    if !on_main() { << -1 }
    if owner <= 0 { << fail("soft blob requires soft owner") }
    if bytes.len < 0 || bytes.len > 67108864 {
        << fail("soft blob exceeds 64 MiB or invalid bytes")
    }
    handle := identifier()
    if handle <= 0 { << fail("soft blob allocation failed") }
    unsafe {
        b := ffi.calloc(SB_RECORD_SIZE)
        if ffi.is_null(b) { << fail("soft blob allocation failed") }
        $data := ffi.null()
        if bytes.len > 0 {
            data = ffi.malloc(bytes.len)
            if ffi.is_null(data) {
                ffi.free(b)
                << fail("soft blob allocation failed")
            }
            for i in 0:bytes.len {
                ffi.write_u8(data, i, bytes[i])
            }
        }
        ffi.write_i64(b, SB_OWNER, owner)
        ffi.write_i64(b, SB_HANDLE, handle)
        ffi.write_i64(b, SB_BYTES, bytes.len)
        ffi.write_ptr(b, SB_DATA, data)
        ffi.write_ptr(b, SB_NEXT, soft_head())
        set_soft_head(b)
        << handle
    }
}

pub fn soft_blob_close(owner int, handle int) int {
    if !on_main() { << -1 }
    unsafe {
        $prev := ffi.null()
        $b := soft_head()
        while !ffi.is_null(b) {
            if ffi.read_i64(b, SB_OWNER) == owner && ffi.read_i64(b, SB_HANDLE) == handle {
                next := ffi.read_ptr(b, SB_NEXT)
                data := ffi.read_ptr(b, SB_DATA)
                if !ffi.is_null(data) { ffi.free(data) }
                ffi.free(b)
                if ffi.is_null(prev) {
                    set_soft_head(next)
                } else {
                    ffi.write_ptr(prev, SB_NEXT, next)
                }
                << 0
            }
            prev = b
            b = ffi.read_ptr(b, SB_NEXT)
        }
    }
    << 0
}

pub fn soft_blob_bytes(owner int, handle int) int {
    b := soft_find(owner, handle)
    if ffi.is_null(b) { << fail("soft blob reference is empty") }
    unsafe { << ffi.read_i64(b, SB_BYTES) }
}

pub fn soft_blob_read_u32(owner int, handle int, offset int, out $&[]int) int {
    b := soft_find(owner, handle)
    if ffi.is_null(b) { << fail("soft blob reference is empty") }
    if out.len != 1 { << fail("soft blob read requires one output word") }
    unsafe {
        total_bytes := ffi.read_i64(b, SB_BYTES)
        if offset < 0 || offset > total_bytes - 4 { << fail("soft blob read out of range") }
        data := ffi.read_ptr(b, SB_DATA)
        b0 := int(ffi.read_u8(data, offset))
        b1 := int(ffi.read_u8(data, offset + 1))
        b2 := int(ffi.read_u8(data, offset + 2))
        b3 := int(ffi.read_u8(data, offset + 3))
        out[0] = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
        << 0
    }
}

pub fn soft_blob_read_rgba8(owner int, handle int, index int, out $&[]int) int {
    b := soft_find(owner, handle)
    if ffi.is_null(b) { << fail("soft blob reference is empty") }
    if out.len != 1 { << fail("soft blob read requires one output word") }
    unsafe {
        total_bytes := ffi.read_i64(b, SB_BYTES)
        if index < 0 || index > (total_bytes / 4) - 1 { << fail("soft blob read out of range") }
        data := ffi.read_ptr(b, SB_DATA)
        pos := index * 4
        r := int(ffi.read_u8(data, pos))
        g := int(ffi.read_u8(data, pos + 1))
        b_val := int(ffi.read_u8(data, pos + 2))
        a := int(ffi.read_u8(data, pos + 3))
        out[0] = (r << 24) | (g << 16) | (b_val << 8) | a
        << 0
    }
}
