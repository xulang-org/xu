@internal/sdl
// Graphics resources and render passes (former render.h).

#ffi
#math

extern "C" fn sdl_create_gpu_texture(fn_ptr c_ptr, device c_ptr, info c_ptr) c_ptr = dynamic
extern "C" fn sdl_release_gpu_texture(fn_ptr c_ptr, device c_ptr, texture c_ptr) = dynamic
extern "C" fn sdl_gpu_texture_supports_format(fn_ptr c_ptr, device c_ptr, format u32, ty u32, usage u32) u8 = dynamic
extern "C" fn sdl_create_gpu_sampler(fn_ptr c_ptr, device c_ptr, info c_ptr) c_ptr = dynamic
extern "C" fn sdl_release_gpu_sampler(fn_ptr c_ptr, device c_ptr, sampler c_ptr) = dynamic
extern "C" fn sdl_create_gpu_shader(fn_ptr c_ptr, device c_ptr, info c_ptr) c_ptr = dynamic
extern "C" fn sdl_release_gpu_shader(fn_ptr c_ptr, device c_ptr, shader c_ptr) = dynamic
extern "C" fn sdl_create_gpu_graphics_pipeline(fn_ptr c_ptr, device c_ptr, info c_ptr) c_ptr = dynamic
extern "C" fn sdl_release_gpu_graphics_pipeline(fn_ptr c_ptr, device c_ptr, pipeline c_ptr) = dynamic
extern "C" fn sdl_upload_to_gpu_texture(fn_ptr c_ptr, copy c_ptr, src c_ptr, dst c_ptr, cycle u8) = dynamic
extern "C" fn sdl_download_from_gpu_texture(fn_ptr c_ptr, copy c_ptr, src c_ptr, dst c_ptr) = dynamic
extern "C" fn sdl_generate_mipmaps_for_gpu_texture(fn_ptr c_ptr, command c_ptr, texture c_ptr) = dynamic
extern "C" fn sdl_begin_gpu_render_pass(fn_ptr c_ptr, command c_ptr, colors c_ptr, count u32, depth c_ptr) c_ptr = dynamic
extern "C" fn sdl_end_gpu_render_pass(fn_ptr c_ptr, pass c_ptr) = dynamic
extern "C" fn sdl_bind_gpu_graphics_pipeline(fn_ptr c_ptr, pass c_ptr, pipeline c_ptr) = dynamic
extern "C" fn sdl_bind_gpu_vertex_buffers(fn_ptr c_ptr, pass c_ptr, slot u32, bindings c_ptr, count u32) = dynamic
extern "C" fn sdl_bind_gpu_index_buffer(fn_ptr c_ptr, pass c_ptr, binding c_ptr, elem u32) = dynamic
extern "C" fn sdl_bind_gpu_vertex_samplers(fn_ptr c_ptr, pass c_ptr, slot u32, bindings c_ptr, count u32) = dynamic
extern "C" fn sdl_bind_gpu_fragment_samplers(fn_ptr c_ptr, pass c_ptr, slot u32, bindings c_ptr, count u32) = dynamic
extern "C" fn sdl_push_gpu_vertex_uniform_data(fn_ptr c_ptr, command c_ptr, slot u32, data c_ptr, len u32) = dynamic
extern "C" fn sdl_push_gpu_fragment_uniform_data(fn_ptr c_ptr, command c_ptr, slot u32, data c_ptr, len u32) = dynamic
extern "C" fn sdl_draw_gpu_primitives(fn_ptr c_ptr, pass c_ptr, count u32, instances u32, first u32, first_inst u32) = dynamic
extern "C" fn sdl_draw_gpu_indexed_primitives(fn_ptr c_ptr, pass c_ptr, count u32, instances u32, first u32, vertex_offset i32, first_inst u32) = dynamic
extern "C" fn sdl_set_gpu_viewport(fn_ptr c_ptr, pass c_ptr, viewport c_ptr) = dynamic
extern "C" fn sdl_set_gpu_scissor(fn_ptr c_ptr, pass c_ptr, rect c_ptr) = dynamic
extern "C" fn sdl_bind_gpu_vertex_storage_textures(fn_ptr c_ptr, pass c_ptr, slot u32, textures c_ptr, count u32) = dynamic
extern "C" fn sdl_bind_gpu_vertex_storage_buffers(fn_ptr c_ptr, pass c_ptr, slot u32, buffers c_ptr, count u32) = dynamic
extern "C" fn sdl_bind_gpu_fragment_storage_textures(fn_ptr c_ptr, pass c_ptr, slot u32, textures c_ptr, count u32) = dynamic
extern "C" fn sdl_bind_gpu_fragment_storage_buffers(fn_ptr c_ptr, pass c_ptr, slot u32, buffers c_ptr, count u32) = dynamic
extern "C" fn sdl_draw_gpu_primitives_indirect(fn_ptr c_ptr, pass c_ptr, buffer c_ptr, offset u32, draw_count u32) = dynamic
extern "C" fn sdl_draw_gpu_indexed_primitives_indirect(fn_ptr c_ptr, pass c_ptr, buffer c_ptr, offset u32, draw_count u32) = dynamic

const KIND_TEXTURE = 1
const KIND_SAMPLER = 2
const KIND_SHADER = 3
const KIND_PIPELINE = 4
const KIND_COMPUTE = 5
const VERTEX_SLOTS = 16
const SAMPLER_SLOTS = 16
const UNIFORM_SLOTS = 4
const STORAGE_SLOTS = 8
const COLOR_TARGET_SLOTS = 4
const MAX_TEXTURE_2D = 16384

// Resource record. Bindings are 24-byte {samplers, count, sizes[4]} blocks.
// Vertex descriptions are SDL_GPUVertexBufferDescription (16 bytes * 16).
const R_ID = 0
const R_BYTES = 8
const R_KIND = 16
const R_CLOSED = 24
const R_REFS = 32
const R_GPU = 40
const R_WIDTH = 48
const R_HEIGHT = 56
const R_LEVELS = 64
const R_USAGE = 72
const R_FORMAT = 80
const R_STAGE = 88
const R_MIP = 96
const R_BIND0 = 216
const R_BIND1 = 240
const R_VERTS = 264
const R_VCOUNT = 520
const R_COLOR = 528
const R_DEPTH = 536
const R_READS = 544
const R_WRITES = 552
const R_COLOR_COUNT = 560
const R_COLORS = 568
const R_STAGE_STEX = 600
const R_STAGE_SBUF = 616
const R_CSAMPS = 632
const R_CRTEX = 640
const R_CWTEX = 648
const R_NEXT = 656
const R_SIZE = 664
const BND_SAMP = 0
const BND_COUNT = 4
const BND_SIZES = 8

const RF_PTR = 0
const RF_BUF = 8
const RF_NEXT = 16
const RF_SIZE = 24

// Encoder. E_PRESENT is an embedded resource (swapchain image, not in the list).
const E_ID = 0
const E_PASS_ID = 8
const E_COMMAND = 16
const E_PASS = 24
const E_COMPUTE = 32
const E_SURFACE = 40
const E_PRESENT = 48
const E_PPASS = 712
const E_REFS = 720
const E_COLOR = 728
const E_DEPTH = 736
const E_PIPE = 744
const E_WIDTH = 752
const E_HEIGHT = 760
const E_VERTS = 768
const E_INDEX = 896
const E_OFFS = 904
const E_IOFF = 1032
const E_ISZ = 1040
const E_SAMP = 1048
const E_UNIF = 1064
const E_WRITES = 1080
const E_WCOUNT = 1144
const E_CREADS = 1152
const E_COLORS = 1160
const E_CCOUNT = 1192
const E_STEX = 1200
const E_SBUF = 1216
const E_CSAMPS = 1232
const E_CRTEX = 1240
const E_WTEX = 1248
const E_WTCOUNT = 1312
const E_NEXT = 1320
const E_SIZE = 1328

const SS_NAME = 0
const SS_TEXT = 8
const SS_BYTES = 16
const SS_SIZE = 24

fn bytes_data(b &[]u8) c_ptr {
    if b.len < 1 { << ffi.null() }
    unsafe {
        p := ffi.calloc(b.len)
        if ffi.is_null(p) { << ffi.null() }
        for i in 0:b.len { ffi.write_u8(p, i, b[i]) }
        << p
    }
}

fn sdl_tex_format(format int) u32 {
    if format < 1 || format > 21 { << u32(0) }
    fmts := [0, 2, 3, 4, 52, 12, 53, 27, 28, 29, 30, 31, 32, 60, 13, 54, 15, 56, 17, 18, 57, 40]
    << u32(fmts[format])
}

fn vertex_format(format int, size_out c_ptr) u32 {
    unsafe {
        if format < 1 || format > 9 {
            ffi.write_i64(size_out, 0, 0)
            << u32(0)
        }
        sizes := [0, 4, 8, 12, 16, 4, 4, 8, 12, 16]
        fmts := [0, 9, 10, 11, 12, 20, 5, 6, 7, 8]
        ffi.write_i64(size_out, 0, sizes[format])
        << u32(fmts[format])
    }
}

fn real_color(v f64) bool {
    if math.is_nan(v) || math.is_inf(v) { << false }
    << math.abs(v) <= 3.4e38
}

fn mask_n(n int) int { << (1 << n) - 1 }

fn bind_base(r c_ptr, stage int) c_ptr {
    unsafe {
        if stage == 0 { << ffi.offset(r, R_BIND0) }
        << ffi.offset(r, R_BIND1)
    }
}

fn bind_field(r c_ptr, stage int, off int) int {
    unsafe { << int(ffi.read_u32(bind_base(r, stage), off)) }
}

fn set_bind_field(r c_ptr, stage int, off int, v int) {
    unsafe { ffi.write_u32(bind_base(r, stage), off, u32(v)) }
}

fn mip_bytes(r c_ptr, level int) int {
    unsafe { << ffi.read_i64(r, R_MIP + level * 8) }
}

fn mip_extent(size int, level int) int {
    n := size >> level
    if n < 1 { << 1 }
    << n
}

fn present_of(e c_ptr) c_ptr {
    unsafe { << ffi.offset(e, E_PRESENT) }
}

fn resource_record(d c_ptr, id int, kind int) c_ptr {
    unsafe {
        $r := ffi.read_ptr(d, D_RESOURCES)
        while !ffi.is_null(r) {
            if ffi.read_i64(r, R_ID) == id && ffi.read_i64(r, R_KIND) == kind && ffi.read_i64(r, R_CLOSED) == 0 {
                << r
            }
            r = ffi.read_ptr(r, R_NEXT)
        }
        fail("closed, foreign or invalid GPU graphics resource")
        << ffi.null()
    }
}

fn allocate_resource(kind int) c_ptr {
    unsafe {
        r := ffi.calloc(R_SIZE)
        if ffi.is_null(r) {
            fail("GPU resource allocation failed")
            << ffi.null()
        }
        id := identifier()
        if id < 0 {
            ffi.free(r)
            << ffi.null()
        }
        ffi.write_i64(r, R_ID, id)
        ffi.write_i64(r, R_KIND, kind)
        << r
    }
}

fn add_resource(d c_ptr, r c_ptr) int {
    unsafe {
        ffi.write_ptr(r, R_NEXT, ffi.read_ptr(d, D_RESOURCES))
        ffi.write_ptr(d, D_RESOURCES, r)
        << ffi.read_i64(r, R_ID)
    }
}

fn free_resource(d c_ptr, r c_ptr) {
    unsafe {
        gpu := ffi.read_ptr(r, R_GPU)
        if !ffi.is_null(gpu) {
            dev := ffi.read_ptr(d, D_GPU)
            kind := ffi.read_i64(r, R_KIND)
            if kind == KIND_TEXTURE {
                sdl_release_gpu_texture(sym(SYM_RELEASE_GPU_TEXTURE), dev, gpu)
            } else if kind == KIND_SAMPLER {
                sdl_release_gpu_sampler(sym(SYM_RELEASE_GPU_SAMPLER), dev, gpu)
            } else if kind == KIND_SHADER {
                sdl_release_gpu_shader(sym(SYM_RELEASE_GPU_SHADER), dev, gpu)
            } else if kind == KIND_PIPELINE {
                sdl_release_gpu_graphics_pipeline(sym(SYM_RELEASE_GPU_GRAPHICS_PIPELINE), dev, gpu)
            } else {
                sdl_release_gpu_compute_pipeline(sym(SYM_RELEASE_GPU_COMPUTE_PIPELINE), dev, gpu)
            }
        }
        ffi.free(r)
    }
}

fn collect_resources(d c_ptr) {
    unsafe {
        $prev := ffi.null()
        $r := ffi.read_ptr(d, D_RESOURCES)
        while !ffi.is_null(r) {
            next := ffi.read_ptr(r, R_NEXT)
            if ffi.read_i64(r, R_CLOSED) != 0 && ffi.read_i64(r, R_REFS) == 0 {
                if ffi.is_null(prev) {
                    ffi.write_ptr(d, D_RESOURCES, next)
                } else {
                    ffi.write_ptr(prev, R_NEXT, next)
                }
                free_resource(d, r)
            } else {
                prev = r
            }
            r = next
        }
        prev = ffi.null()
        $b := ffi.read_ptr(d, D_BUFFERS)
        while !ffi.is_null(b) {
            next := ffi.read_ptr(b, B_NEXT)
            if ffi.read_i64(b, B_CLOSED) != 0 && ffi.read_u32(b, B_REFS) == u32(0) {
                if ffi.is_null(prev) {
                    ffi.write_ptr(d, D_BUFFERS, next)
                } else {
                    ffi.write_ptr(prev, B_NEXT, next)
                }
                sdl_release_gpu_buffer(sym(SYM_RELEASE_GPU_BUFFER), ffi.read_ptr(d, D_GPU), ffi.read_ptr(b, B_GPU))
                ffi.free(b)
            } else {
                prev = b
            }
            b = next
        }
    }
}

fn bump_buffer_refs(b c_ptr, delta int) {
    unsafe {
        n := int(ffi.read_u32(b, B_REFS)) + delta
        ffi.write_u32(b, B_REFS, u32(n))
    }
}

fn retain(e c_ptr, pointer c_ptr, is_buffer bool) bool {
    unsafe {
        $link := ffi.read_ptr(e, E_REFS)
        while !ffi.is_null(link) {
            same := ffi.read_ptr(link, RF_PTR) == pointer
            buf := ffi.read_i64(link, RF_BUF) != 0
            if same && buf == is_buffer { << true }
            link = ffi.read_ptr(link, RF_NEXT)
        }
        node := ffi.calloc(RF_SIZE)
        if ffi.is_null(node) {
            fail("GPU command resource retention failed")
            << false
        }
        ffi.write_ptr(node, RF_PTR, pointer)
        if is_buffer { ffi.write_i64(node, RF_BUF, 1) }
        ffi.write_ptr(node, RF_NEXT, ffi.read_ptr(e, E_REFS))
        ffi.write_ptr(e, E_REFS, node)
        if is_buffer {
            bump_buffer_refs(pointer, 1)
        } else {
            ffi.write_i64(pointer, R_REFS, ffi.read_i64(pointer, R_REFS) + 1)
        }
        << true
    }
}

fn release_refs(e c_ptr) {
    unsafe {
        $node := ffi.read_ptr(e, E_REFS)
        while !ffi.is_null(node) {
            next := ffi.read_ptr(node, RF_NEXT)
            pointer := ffi.read_ptr(node, RF_PTR)
            if ffi.read_i64(node, RF_BUF) != 0 {
                bump_buffer_refs(pointer, -1)
            } else {
                ffi.write_i64(pointer, R_REFS, ffi.read_i64(pointer, R_REFS) - 1)
            }
            ffi.free(node)
            node = next
        }
        ffi.write_ptr(e, E_REFS, ffi.null())
    }
}

fn encoder_record(d c_ptr, id int, is_pass bool) c_ptr {
    unsafe {
        $e := ffi.read_ptr(d, D_ENCODERS)
        while !ffi.is_null(e) {
            if is_pass {
                if !ffi.is_null(ffi.read_ptr(e, E_PASS)) && ffi.read_i64(e, E_PASS_ID) == id { << e }
            } else if ffi.read_i64(e, E_ID) == id {
                << e
            }
            e = ffi.read_ptr(e, E_NEXT)
        }
        if is_pass { fail("closed or invalid GPU render pass") } else { fail("closed or invalid GPU command encoder") }
        << ffi.null()
    }
}

fn clear_pass_state(e c_ptr) {
    unsafe {
        for i in 0:VERTEX_SLOTS {
            ffi.write_ptr(e, E_VERTS + i * 8, ffi.null())
            ffi.write_i64(e, E_OFFS + i * 8, 0)
        }
        ffi.write_ptr(e, E_INDEX, ffi.null())
        ffi.write_i64(e, E_IOFF, 0)
        ffi.write_i64(e, E_ISZ, 0)
        ffi.write_i64(e, E_SAMP, 0)
        ffi.write_i64(e, E_SAMP + 8, 0)
        ffi.write_i64(e, E_UNIF, 0)
        ffi.write_i64(e, E_UNIF + 8, 0)
        ffi.write_i64(e, E_STEX, 0)
        ffi.write_i64(e, E_STEX + 8, 0)
        ffi.write_i64(e, E_SBUF, 0)
        ffi.write_i64(e, E_SBUF + 8, 0)
    }
}

fn unlink_encoder(d c_ptr, e c_ptr) {
    unsafe {
        $prev := ffi.null()
        $cur := ffi.read_ptr(d, D_ENCODERS)
        while !ffi.is_null(cur) {
            if cur == e { <- }
            prev = cur
            cur = ffi.read_ptr(cur, E_NEXT)
        }
        if ffi.is_null(cur) { << }
        next := ffi.read_ptr(e, E_NEXT)
        if ffi.is_null(prev) {
            ffi.write_ptr(d, D_ENCODERS, next)
        } else {
            ffi.write_ptr(prev, E_NEXT, next)
        }
    }
}

fn free_encoder(d c_ptr, e c_ptr, cancel bool) bool {
    $ok := true
    unsafe {
        pass := ffi.read_ptr(e, E_PASS)
        if !ffi.is_null(pass) {
            sdl_end_gpu_render_pass(sym(SYM_END_GPU_RENDER_PASS), pass)
            ffi.write_ptr(e, E_PASS, ffi.null())
        }
        comp := ffi.read_ptr(e, E_COMPUTE)
        if !ffi.is_null(comp) {
            sdl_end_gpu_compute_pass(sym(SYM_END_GPU_COMPUTE_PASS), comp)
            ffi.write_ptr(e, E_COMPUTE, ffi.null())
        }
        if cancel {
            if !ffi.is_null(ffi.read_ptr(e, E_SURFACE)) {
                if !abandon_surface(e) { ok = false }
            } else if sdl_cancel_gpu_command_buffer(sym(SYM_CANCEL_GPU_COMMAND_BUFFER), ffi.read_ptr(e, E_COMMAND)) == u8(0) {
                sdl_fail()
                ok = false
            }
        }
        release_refs(e)
        unlink_encoder(d, e)
        if !ffi.is_null(ffi.read_ptr(e, E_SURFACE)) { surface_encoder_released(e) }
        ffi.free(e)
        collect_resources(d)
    }
    << ok
}

fn close_graphics(d c_ptr) bool {
    $bad := false
    $saved := ffi.null()
    unsafe {
        while !ffi.is_null(ffi.read_ptr(d, D_ENCODERS)) {
            if !free_encoder(d, ffi.read_ptr(d, D_ENCODERS), true) {
                if !bad { saved = error_save() }
                bad = true
            }
        }
        while !ffi.is_null(ffi.read_ptr(d, D_RESOURCES)) {
            r := ffi.read_ptr(d, D_RESOURCES)
            ffi.write_ptr(d, D_RESOURCES, ffi.read_ptr(r, R_NEXT))
            free_resource(d, r)
        }
    }
    if bad { error_restore(saved) }
    << !bad
}

fn graphics_stats(d c_ptr, field int) int {
    if field < 4 || field > 14 { << fail("invalid GPU accounting field") }
    $total := 0
    unsafe {
        $r := ffi.read_ptr(d, D_RESOURCES)
        while !ffi.is_null(r) {
            $add := 0
            if ffi.read_i64(r, R_CLOSED) == 0 {
                kind := ffi.read_i64(r, R_KIND)
                if field == 4 && kind == KIND_TEXTURE { add = 1 }
                if field == 5 && kind == KIND_TEXTURE { add = ffi.read_i64(r, R_BYTES) }
                if field >= 6 && field <= 8 && kind == field - 4 { add = 1 }
                if field == 11 && kind == KIND_COMPUTE { add = 1 }
            }
            if add > 9223372036854775807 - total { << fail("GPU accounting overflow") }
            total += add
            r = ffi.read_ptr(r, R_NEXT)
        }
        $e := ffi.read_ptr(d, D_ENCODERS)
        while !ffi.is_null(e) {
            $add := 0
            if field == 9 { add = 1 }
            if field == 10 && !ffi.is_null(ffi.read_ptr(e, E_PASS)) { add = 1 }
            if field == 12 && !ffi.is_null(ffi.read_ptr(e, E_COMPUTE)) { add = 1 }
            if field == 14 && !ffi.is_null(ffi.read_ptr(e, E_SURFACE)) { add = 1 }
            if add > 9223372036854775807 - total { << fail("GPU accounting overflow") }
            total += add
            e = ffi.read_ptr(e, E_NEXT)
        }
        if field == 13 {
            $s := ffi.read_ptr(d, D_SURFACES)
            while !ffi.is_null(s) {
                if total == 9223372036854775807 { << fail("GPU accounting overflow") }
                total += 1
                s = ffi.read_ptr(s, SF_NEXT)
            }
        }
    }
    << total
}

fn texture_usage_ok(format int, usage int) bool {
    if sdl_tex_format(format) == u32(0) || usage < 1 || usage > 127 { << false }
    if format == 13 { << (usage & (2 | 32 | 64)) == 0 }
    if (usage & 4) != 0 { << false }
    if format >= 14 && format <= 20 { << usage == 1 }
    << true
}

pub fn texture_supports(owner int, format int, usage int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_render_syms() { << -1 }
    if !texture_usage_ok(format, usage) { << fail("invalid GPU texture format or usage combination") }
    unsafe {
        ok := sdl_gpu_texture_supports_format(sym(SYM_GPU_TEXTURE_SUPPORTS_FORMAT), ffi.read_ptr(d, D_GPU), sdl_tex_format(format), u32(0), u32(usage))
        if ok != u8(0) { << 1 }
        << 0
    }
}

pub fn texture_new(owner int, desc &[]int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_render_syms() { << -1 }
    if desc.len < 7 { << fail("invalid GPU texture descriptor") }
    format := desc[0]
    width := desc[1]
    height := desc[2]
    levels := desc[3]
    usage := desc[4]
    bytes := desc[5]
    if !texture_usage_ok(format, usage) || width < 1 || width > MAX_TEXTURE_2D || height < 1 || height > MAX_TEXTURE_2D || bytes < 1 {
        << fail("invalid GPU texture size, format or usage")
    }
    $max_levels := 1
    $size := width
    if height > size { size = height }
    while size > 1 {
        size = size / 2
        max_levels += 1
    }
    if levels < 1 || levels > max_levels || desc.len != 6 + levels || (format == 13 && levels != 1) {
        << fail("invalid GPU texture mip count")
    }
    for i in 0:levels {
        n := desc[6 + i]
        if n < 1 || n > bytes { << fail("invalid GPU mip byte size") }
    }
    unsafe {
        if sdl_gpu_texture_supports_format(sym(SYM_GPU_TEXTURE_SUPPORTS_FORMAT), ffi.read_ptr(d, D_GPU), sdl_tex_format(format), u32(0), u32(usage)) == u8(0) {
            << fail("GPU texture format is unsupported for this usage on the selected device")
        }
        r := allocate_resource(KIND_TEXTURE)
        if ffi.is_null(r) { << -1 }
        ffi.write_i64(r, R_FORMAT, format)
        ffi.write_i64(r, R_WIDTH, width)
        ffi.write_i64(r, R_HEIGHT, height)
        ffi.write_i64(r, R_LEVELS, levels)
        ffi.write_i64(r, R_USAGE, usage)
        ffi.write_i64(r, R_BYTES, bytes)
        for i in 0:levels { ffi.write_i64(r, R_MIP + i * 8, desc[6 + i]) }
        info := ffi.calloc(36)
        if ffi.is_null(info) {
            ffi.free(r)
            << fail("GPU resource allocation failed")
        }
        ffi.write_u32(info, 4, sdl_tex_format(format))
        ffi.write_u32(info, 8, u32(usage))
        ffi.write_u32(info, 12, u32(width))
        ffi.write_u32(info, 16, u32(height))
        ffi.write_u32(info, 20, u32(1))
        ffi.write_u32(info, 24, u32(levels))
        gpu := sdl_create_gpu_texture(sym(SYM_CREATE_GPU_TEXTURE), ffi.read_ptr(d, D_GPU), info)
        ffi.free(info)
        if ffi.is_null(gpu) {
            sdl_fail()
            ffi.free(r)
            << -1
        }
        ffi.write_ptr(r, R_GPU, gpu)
        << add_resource(d, r)
    }
}

fn texture_transfer(d c_ptr, r c_ptr, level int, size int, input &[]u8, download bool) int {
    unsafe {
        levels := ffi.read_i64(r, R_LEVELS)
        if level < 0 || level >= levels || size < 1 || size > 4294967295 || size != mip_bytes(r, level) || ffi.read_i64(r, R_FORMAT) == 13 {
            << fail("invalid GPU texture transfer mip, size or depth format")
        }
        t := new_transfer(d, u32(size), true, download)
        if ffi.is_null(t) { << -1 }
        if !download {
            mapped := sdl_map_gpu_transfer_buffer(sym(SYM_MAP_GPU_TRANSFER_BUFFER), ffi.read_ptr(d, D_GPU), ffi.read_ptr(t, T_STAGING), u8(0))
            if ffi.is_null(mapped) {
                sdl_fail()
                free_transfer(d, t)
                << -1
            }
            for i in 0:input.len { ffi.write_u8(mapped, i, input[i]) }
            sdl_unmap_gpu_transfer_buffer(sym(SYM_UNMAP_GPU_TRANSFER_BUFFER), ffi.read_ptr(d, D_GPU), ffi.read_ptr(t, T_STAGING))
        }
        xfer := ffi.calloc(24)
        region := ffi.calloc(40)
        slot := ffi.calloc(8)
        if ffi.is_null(xfer) || ffi.is_null(region) || ffi.is_null(slot) {
            ffi.free(xfer)
            ffi.free(region)
            ffi.free(slot)
            free_transfer(d, t)
            << fail("GPU submission allocation failed")
        }
        copy := begin_copy(d, t, slot)
        if ffi.is_null(copy) {
            ffi.free(xfer)
            ffi.free(region)
            ffi.free(slot)
            << -1
        }
        command := ffi.read_ptr(slot, 0)
        ffi.free(slot)
        write_xfer := ffi.read_ptr(t, T_STAGING)
        ffi.write_ptr(xfer, 0, write_xfer)
        w := mip_extent(ffi.read_i64(r, R_WIDTH), level)
        h := mip_extent(ffi.read_i64(r, R_HEIGHT), level)
        ffi.write_ptr(region, 0, ffi.read_ptr(r, R_GPU))
        ffi.write_u32(region, 8, u32(level))
        ffi.write_u32(region, 28, u32(w))
        ffi.write_u32(region, 32, u32(h))
        ffi.write_u32(region, 36, u32(1))
        if download {
            sdl_download_from_gpu_texture(sym(SYM_DOWNLOAD_FROM_GPU_TEXTURE), copy, region, xfer)
        } else {
            sdl_upload_to_gpu_texture(sym(SYM_UPLOAD_TO_GPU_TEXTURE), copy, xfer, region, u8(0))
        }
        ffi.free(xfer)
        ffi.free(region)
        << submit_transfer(d, t, command, copy)
    }
}

pub fn texture_upload(owner int, id int, level int, bytes &[]u8) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    r := resource_record(d, id, KIND_TEXTURE)
    if ffi.is_null(r) { << -1 }
    if bytes.len < 1 { << fail("invalid GPU texture upload bytes") }
    << texture_transfer(d, r, level, bytes.len, bytes, false)
}

pub fn texture_download(owner int, id int, level int, size int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    r := resource_record(d, id, KIND_TEXTURE)
    if ffi.is_null(r) { << -1 }
    empty := []u8{}
    << texture_transfer(d, r, level, size, empty, true)
}

pub fn texture_mips(owner int, id int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    r := resource_record(d, id, KIND_TEXTURE)
    if ffi.is_null(r) { << -1 }
    unsafe {
        levels := ffi.read_i64(r, R_LEVELS)
        usage := ffi.read_i64(r, R_USAGE)
        format := ffi.read_i64(r, R_FORMAT)
        if levels < 2 || (usage & 3) != 3 || format == 13 || format >= 14 {
            << fail("GPU mip generation requires an uncompressed sampled color target with multiple levels")
        }
        t := new_transfer(d, u32(0), false, false)
        if ffi.is_null(t) { << -1 }
        command := sdl_acquire_gpu_command_buffer(sym(SYM_ACQUIRE_GPU_COMMAND_BUFFER), ffi.read_ptr(d, D_GPU))
        if ffi.is_null(command) {
            sdl_fail()
            free_transfer(d, t)
            << -1
        }
        sdl_generate_mipmaps_for_gpu_texture(sym(SYM_GENERATE_MIPMAPS_FOR_GPU_TEXTURE), command, ffi.read_ptr(r, R_GPU))
        fence := sdl_submit_gpu_command_buffer_and_acquire_fence(sym(SYM_SUBMIT_GPU_COMMAND_BUFFER_AND_ACQUIRE_FENCE), command)
        if ffi.is_null(fence) {
            sdl_fail()
            free_transfer(d, t)
            << -1
        }
        ffi.write_ptr(t, T_FENCE, fence)
        ffi.write_ptr(t, T_NEXT, ffi.read_ptr(d, D_TRANSFERS))
        ffi.write_ptr(d, D_TRANSFERS, t)
        << ffi.read_i64(t, T_ID)
    }
}

pub fn sampler_new(owner int, desc &[]int, min_lod f64, max_lod f64) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_render_syms() { << -1 }
    if desc.len != 6 || math.is_nan(min_lod) || math.is_inf(min_lod) || math.is_nan(max_lod) || math.is_inf(max_lod) || min_lod < 0.0 || max_lod < min_lod || max_lod > 1000.0 {
        << fail("invalid GPU sampler descriptor or LOD range")
    }
    for i in 0:6 {
        $limit := 2
        if i < 3 { limit = 1 }
        if desc[i] < 0 || desc[i] > limit { << fail("invalid GPU sampler filter or address mode") }
    }
    unsafe {
        r := allocate_resource(KIND_SAMPLER)
        if ffi.is_null(r) { << -1 }
        info := ffi.calloc(52)
        if ffi.is_null(info) {
            ffi.free(r)
            << fail("GPU resource allocation failed")
        }
        ffi.write_u32(info, 0, u32(desc[0]))
        ffi.write_u32(info, 4, u32(desc[1]))
        ffi.write_u32(info, 8, u32(desc[2]))
        ffi.write_u32(info, 12, u32(desc[3]))
        ffi.write_u32(info, 16, u32(desc[4]))
        ffi.write_u32(info, 20, u32(desc[5]))
        ffi.write_f32(info, 36, f32(min_lod))
        ffi.write_f32(info, 40, f32(max_lod))
        gpu := sdl_create_gpu_sampler(sym(SYM_CREATE_GPU_SAMPLER), ffi.read_ptr(d, D_GPU), info)
        ffi.free(info)
        if ffi.is_null(gpu) {
            sdl_fail()
            ffi.free(r)
            << -1
        }
        ffi.write_ptr(r, R_GPU, gpu)
        << add_resource(d, r)
    }
}

fn has_nul(b &[]u8) bool {
    for i in 0:b.len {
        if b[i] == u8(0) { << true }
    }
    << false
}

fn copy_c_bytes(b &[]u8) c_ptr {
    unsafe {
        p := ffi.malloc(b.len + 1)
        if ffi.is_null(p) { << ffi.null() }
        for i in 0:b.len { ffi.write_u8(p, i, b[i]) }
        ffi.write_u8(p, b.len, u8(0))
        << p
    }
}

fn prepare_shader(owner int, format int, sizes &[]int, entry &[]u8, code &[]u8) c_ptr {
    if format < 1 || format > 16 || (format & (format - 1)) != 0 {
        fail("invalid GPU shader format, bindings, entrypoint or code")
        << ffi.null()
    }
    known := shader_formats(owner)
    if known < 0 { << ffi.null() }
    if (format & known) == 0 || sizes.len < 0 || sizes.len > UNIFORM_SLOTS || entry.len < 1 || entry.len > 1024 || code.len < 1 || code.len > 4294967295 {
        fail("invalid GPU shader format, bindings, entrypoint or code")
        << ffi.null()
    }
    if has_nul(entry) {
        fail("GPU shader entrypoint contains NUL")
        << ffi.null()
    }
    for i in 0:sizes.len {
        n := sizes[i]
        if n < 16 || n > 16384 || (n % 16) != 0 {
            fail("GPU uniform size must be 16-byte aligned and in 16...16384")
            << ffi.null()
        }
    }
    if format == 1 && (code.len < 20 || (code.len % 4) != 0 || code[0] != u8(3) || code[1] != u8(2) || code[2] != u8(35) || code[3] != u8(7)) {
        fail("invalid GPU shader container")
        << ffi.null()
    }
    if (format == 2 || format == 4) && (code.len < 32 || code[0] != u8(68) || code[1] != u8(88) || code[2] != u8(66) || code[3] != u8(67)) {
        fail("invalid GPU shader container")
        << ffi.null()
    }
    if format == 16 && (code.len < 16 || code[0] != u8(77) || code[1] != u8(84) || code[2] != u8(76) || code[3] != u8(66)) {
        fail("invalid GPU shader container")
        << ffi.null()
    }
    if format == 8 && has_nul(code) {
        fail("MSL source must not contain NUL")
        << ffi.null()
    }
    unsafe {
        src := ffi.calloc(SS_SIZE)
        name := copy_c_bytes(entry)
        $text := ffi.null()
        if format == 8 { text = copy_c_bytes(code) }
        if ffi.is_null(src) || ffi.is_null(name) || (format == 8 && ffi.is_null(text)) {
            ffi.free(src)
            ffi.free(name)
            ffi.free(text)
            fail("GPU shader source allocation failed")
            << ffi.null()
        }
        ffi.write_ptr(src, SS_NAME, name)
        if format == 8 {
            ffi.write_ptr(src, SS_TEXT, text)
            ffi.write_ptr(src, SS_BYTES, text)
        } else {
            raw := bytes_data(code)
            if ffi.is_null(raw) {
                ffi.free(src)
                ffi.free(name)
                fail("GPU shader source allocation failed")
                << ffi.null()
            }
            ffi.write_ptr(src, SS_TEXT, raw)
            ffi.write_ptr(src, SS_BYTES, raw)
        }
        << src
    }
}

fn free_shader_source(src c_ptr) {
    unsafe {
        if ffi.is_null(src) { << }
        ffi.free(ffi.read_ptr(src, SS_NAME))
        ffi.free(ffi.read_ptr(src, SS_TEXT))
        ffi.free(src)
    }
}

fn create_shader(owner int, stage int, format int, samplers int, storage_textures int, storage_buffers int, sizes &[]int, entry &[]u8, code &[]u8) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_render_syms() { << -1 }
    if stage < 0 || stage > 1 || samplers < 0 || samplers > SAMPLER_SLOTS || storage_textures < 0 || storage_textures > STORAGE_SLOTS || storage_buffers < 0 || storage_buffers > STORAGE_SLOTS {
        << fail("invalid GPU shader stage or resource count")
    }
    src := prepare_shader(owner, format, sizes, entry, code)
    if ffi.is_null(src) { << -1 }
    unsafe {
        r := allocate_resource(KIND_SHADER)
        if ffi.is_null(r) {
            free_shader_source(src)
            << -1
        }
        ffi.write_i64(r, R_STAGE, stage)
        set_bind_field(r, stage, BND_SAMP, samplers)
        set_bind_field(r, stage, BND_COUNT, sizes.len)
        for i in 0:sizes.len { set_bind_field(r, stage, BND_SIZES + i * 4, sizes[i]) }
        ffi.write_i64(r, R_STAGE_STEX + stage * 8, storage_textures)
        ffi.write_i64(r, R_STAGE_SBUF + stage * 8, storage_buffers)
        info := ffi.calloc(56)
        if ffi.is_null(info) {
            ffi.free(r)
            free_shader_source(src)
            << fail("GPU resource allocation failed")
        }
        ffi.write_u64(info, 0, u64(code.len))
        ffi.write_ptr(info, 8, ffi.read_ptr(src, SS_BYTES))
        ffi.write_ptr(info, 16, ffi.read_ptr(src, SS_NAME))
        ffi.write_u32(info, 24, u32(format) << 1)
        ffi.write_u32(info, 28, u32(stage))
        ffi.write_u32(info, 32, u32(samplers))
        ffi.write_u32(info, 36, u32(storage_textures))
        ffi.write_u32(info, 40, u32(storage_buffers))
        ffi.write_u32(info, 44, u32(sizes.len))
        gpu := sdl_create_gpu_shader(sym(SYM_CREATE_GPU_SHADER), ffi.read_ptr(d, D_GPU), info)
        ffi.free(info)
        free_shader_source(src)
        if ffi.is_null(gpu) {
            sdl_fail()
            ffi.free(r)
            << -1
        }
        ffi.write_ptr(r, R_GPU, gpu)
        << add_resource(d, r)
    }
}

pub fn shader_new(owner int, stage int, format int, samplers int, sizes &[]int, entry &[]u8, code &[]u8) int {
    << create_shader(owner, stage, format, samplers, 0, 0, sizes, entry, code)
}

pub fn shader_resources_new(owner int, counts &[]int, sizes &[]int, entry &[]u8, code &[]u8) int {
    if counts.len != 5 { << fail("invalid GPU shader resource descriptor") }
    << create_shader(owner, counts[0], counts[1], counts[2], counts[3], counts[4], sizes, entry, code)
}

fn create_pipeline_targets(owner int, vertex int, fragment int, targets &[]int, state &[]int, vertices &[]int, attributes &[]int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_render_syms() { << -1 }
    vs := resource_record(d, vertex, KIND_SHADER)
    if ffi.is_null(vs) { << -1 }
    fs := resource_record(d, fragment, KIND_SHADER)
    if ffi.is_null(fs) { << -1 }
    if state.len != 8 || (targets.len % 2) != 0 || targets.len > COLOR_TARGET_SLOTS * 2 || vertices.len < 0 || vertices.len > VERTEX_SLOTS * 3 || (vertices.len % 3) != 0 || attributes.len < 0 || attributes.len > VERTEX_SLOTS * 4 || (attributes.len % 4) != 0 {
        << fail("invalid GPU graphics pipeline descriptor")
    }
    tcount := targets.len / 2
    depth_fmt := state[1]
    if (tcount == 0 && depth_fmt == 0) || (depth_fmt != 0 && depth_fmt != 13) || state[2] < 0 || state[2] > 4 || state[3] < 0 || state[3] > 2 || state[4] < 0 || state[4] > 1 || state[5] < 0 || state[5] > 8 || state[6] < 0 || state[6] > 1 || (depth_fmt == 0 && (state[5] != 0 || state[6] != 0)) {
        << fail("invalid GPU pipeline target, depth, blend or primitive state")
    }
    for i in 0:tcount {
        cfmt := targets[i * 2]
        cblend := targets[i * 2 + 1]
        if sdl_tex_format(cfmt) == u32(0) || cfmt == 13 || cblend < 0 || cblend > 2 || (cfmt == 21 && cblend != 0) {
            << fail("invalid GPU pipeline target, depth, blend or primitive state")
        }
    }
    unsafe {
        if ffi.read_i64(vs, R_STAGE) != 0 || ffi.read_i64(fs, R_STAGE) != 1 {
            << fail("invalid GPU graphics pipeline descriptor")
        }
        for i in 0:tcount {
            if sdl_gpu_texture_supports_format(sym(SYM_GPU_TEXTURE_SUPPORTS_FORMAT), ffi.read_ptr(d, D_GPU), sdl_tex_format(targets[i * 2]), u32(0), u32(2)) == u8(0) {
                << fail("unsupported GPU pipeline color format")
            }
        }
        vb := ffi.calloc(256)
        va := ffi.calloc(256)
        if ffi.is_null(vb) || ffi.is_null(va) {
            ffi.free(vb)
            ffi.free(va)
            << fail("GPU resource allocation failed")
        }
        $slots := 0
        $pitches := []int{}
        for i in 0:VERTEX_SLOTS { pitches.push(0) }
        count := vertices.len / 3
        for i in 0:count {
            slot := vertices[i * 3]
            pitch := vertices[i * 3 + 1]
            rate := vertices[i * 3 + 2]
            if slot < 0 || slot >= VERTEX_SLOTS || (slots & (1 << slot)) != 0 || pitch < 4 || pitch > 2048 || (pitch % 4) != 0 || rate < 0 || rate > 1 {
                ffi.free(vb)
                ffi.free(va)
                << fail("invalid GPU vertex buffer slot, stride or input rate")
            }
            ffi.write_u32(vb, i * 16, u32(slot))
            ffi.write_u32(vb, i * 16 + 4, u32(pitch))
            ffi.write_u32(vb, i * 16 + 8, u32(rate))
            slots = slots | (1 << slot)
            pitches[slot] = pitch
        }
        $locations := 0
        acount := attributes.len / 4
        size_slot := ffi.calloc(8)
        if ffi.is_null(size_slot) {
            ffi.free(vb)
            ffi.free(va)
            << fail("GPU resource allocation failed")
        }
        for i in 0:acount {
            loc := attributes[i * 4]
            slot := attributes[i * 4 + 1]
            fmt_id := attributes[i * 4 + 2]
            off := attributes[i * 4 + 3]
            fmt := vertex_format(fmt_id, size_slot)
            sz := ffi.read_i64(size_slot, 0)
            if loc < 0 || loc >= VERTEX_SLOTS || (locations & (1 << loc)) != 0 || slot < 0 || slot >= VERTEX_SLOTS || (slots & (1 << slot)) == 0 || sz == 0 || off < 0 || (off % 4) != 0 || off + sz > pitches[slot] {
                ffi.free(vb)
                ffi.free(va)
                ffi.free(size_slot)
                << fail("invalid GPU vertex attribute location, slot, format or offset")
            }
            locations = locations | (1 << loc)
            ffi.write_u32(va, i * 16, u32(loc))
            ffi.write_u32(va, i * 16 + 4, u32(slot))
            ffi.write_u32(va, i * 16 + 8, fmt)
            ffi.write_u32(va, i * 16 + 12, u32(off))
        }
        ffi.free(size_slot)
        r := allocate_resource(KIND_PIPELINE)
        if ffi.is_null(r) {
            ffi.free(vb)
            ffi.free(va)
            << -1
        }
        ffi.memcpy(bind_base(r, 0), bind_base(vs, 0), 24)
        ffi.memcpy(bind_base(r, 1), bind_base(fs, 1), 24)
        ffi.write_i64(r, R_STAGE_STEX, ffi.read_i64(vs, R_STAGE_STEX))
        ffi.write_i64(r, R_STAGE_STEX + 8, ffi.read_i64(fs, R_STAGE_STEX + 8))
        ffi.write_i64(r, R_STAGE_SBUF, ffi.read_i64(vs, R_STAGE_SBUF))
        ffi.write_i64(r, R_STAGE_SBUF + 8, ffi.read_i64(fs, R_STAGE_SBUF + 8))
        ffi.write_i64(r, R_VCOUNT, count)
        ffi.memcpy(ffi.offset(r, R_VERTS), vb, 256)
        ffi.write_i64(r, R_COLOR_COUNT, tcount)
        $color_fmt := 0
        if tcount > 0 { color_fmt = targets[0] }
        ffi.write_i64(r, R_COLOR, color_fmt)
        for i in 0:tcount { ffi.write_i64(r, R_COLORS + i * 8, targets[i * 2]) }
        ffi.write_i64(r, R_DEPTH, depth_fmt)
        $color := ffi.null()
        if tcount > 0 {
            color = ffi.calloc(tcount * 36)
            if ffi.is_null(color) {
                ffi.free(vb)
                ffi.free(va)
                ffi.free(r)
                << fail("GPU resource allocation failed")
            }
            for i in 0:tcount {
                cfmt := targets[i * 2]
                cblend := targets[i * 2 + 1]
                base := i * 36
                ffi.write_u32(color, base, sdl_tex_format(cfmt))
                $src_color := u32(2)
                if cblend == 1 { src_color = u32(7) }
                ffi.write_u32(color, base + 4, src_color)
                ffi.write_u32(color, base + 8, u32(8))
                ffi.write_u32(color, base + 12, u32(1))
                ffi.write_u32(color, base + 16, u32(2))
                ffi.write_u32(color, base + 20, u32(8))
                ffi.write_u32(color, base + 24, u32(1))
                if cblend != 0 { ffi.write_u8(color, base + 29, u8(1)) }
            }
        }
        info := ffi.calloc(168)
        if ffi.is_null(info) {
            ffi.free(color)
            ffi.free(vb)
            ffi.free(va)
            ffi.free(r)
            << fail("GPU resource allocation failed")
        }
        ffi.write_ptr(info, 0, ffi.read_ptr(vs, R_GPU))
        ffi.write_ptr(info, 8, ffi.read_ptr(fs, R_GPU))
        ffi.write_ptr(info, 16, vb)
        ffi.write_u32(info, 24, u32(count))
        ffi.write_ptr(info, 32, va)
        ffi.write_u32(info, 40, u32(acount))
        ffi.write_u32(info, 48, u32(state[2]))
        ffi.write_u32(info, 56, u32(state[3]))
        ffi.write_u32(info, 60, u32(state[4]))
        ffi.write_u8(info, 77, u8(1))
        ffi.write_u32(info, 92, u32(state[5]))
        if state[5] != 0 { ffi.write_u8(info, 130, u8(1)) }
        if state[6] != 0 { ffi.write_u8(info, 131, u8(1)) }
        ffi.write_ptr(info, 136, color)
        ffi.write_u32(info, 144, u32(tcount))
        ffi.write_u32(info, 148, sdl_tex_format(depth_fmt))
        if depth_fmt != 0 { ffi.write_u8(info, 152, u8(1)) }
        gpu := sdl_create_gpu_graphics_pipeline(sym(SYM_CREATE_GPU_GRAPHICS_PIPELINE), ffi.read_ptr(d, D_GPU), info)
        ffi.free(info)
        ffi.free(color)
        ffi.free(vb)
        ffi.free(va)
        if ffi.is_null(gpu) {
            sdl_fail()
            ffi.free(r)
            << -1
        }
        ffi.write_ptr(r, R_GPU, gpu)
        << add_resource(d, r)
    }
}

pub fn pipeline_new(owner int, vertex int, fragment int, state &[]int, vertices &[]int, attributes &[]int) int {
    if state.len != 8 || sdl_tex_format(state[0]) == u32(0) || state[0] == 13 || state[7] < 0 || state[7] > 2 {
        << fail("invalid GPU pipeline target, depth, blend or primitive state")
    }
    targets := [state[0], state[7]]
    << create_pipeline_targets(owner, vertex, fragment, &targets, state, vertices, attributes)
}

pub fn pipeline_targets_new(owner int, vertex int, fragment int, targets &[]int, state &[]int, vertices &[]int, attributes &[]int) int {
    << create_pipeline_targets(owner, vertex, fragment, targets, state, vertices, attributes)
}

pub fn encoder_new(owner int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    if !load_render_syms() { << -1 }
    unsafe {
        e := ffi.calloc(E_SIZE)
        if ffi.is_null(e) { << fail("GPU command encoder allocation failed") }
        id := identifier()
        if id < 0 {
            ffi.free(e)
            << -1
        }
        ffi.write_i64(e, E_ID, id)
        command := sdl_acquire_gpu_command_buffer(sym(SYM_ACQUIRE_GPU_COMMAND_BUFFER), ffi.read_ptr(d, D_GPU))
        if ffi.is_null(command) {
            sdl_fail()
            ffi.free(e)
            << -1
        }
        ffi.write_ptr(e, E_COMMAND, command)
        ffi.write_ptr(e, E_NEXT, ffi.read_ptr(d, D_ENCODERS))
        ffi.write_ptr(d, D_ENCODERS, e)
        << id
    }
}

pub fn encoder_close(owner int, id int) int {
    if !on_main() { << -1 }
    d := device_by_id(owner)
    if ffi.is_null(d) { << 0 }
    unsafe {
        $e := ffi.read_ptr(d, D_ENCODERS)
        while !ffi.is_null(e) {
            if ffi.read_i64(e, E_ID) == id {
                if free_encoder(d, e, true) { << 0 }
                << -1
            }
            e = ffi.read_ptr(e, E_NEXT)
        }
        << 0
    }
}

pub fn encoder_submit(owner int, id int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, false)
    if ffi.is_null(e) { << -1 }
    unsafe {
        if !ffi.is_null(ffi.read_ptr(e, E_PASS)) || !ffi.is_null(ffi.read_ptr(e, E_COMPUTE)) {
            << fail("end the GPU pass before submitting its encoder")
        }
        t := new_transfer(d, u32(0), false, false)
        if ffi.is_null(t) { << -1 }
        fence := sdl_submit_gpu_command_buffer_and_acquire_fence(sym(SYM_SUBMIT_GPU_COMMAND_BUFFER_AND_ACQUIRE_FENCE), ffi.read_ptr(e, E_COMMAND))
        if ffi.is_null(fence) {
            sdl_fail()
            free_transfer(d, t)
            free_encoder(d, e, false)
            << -1
        }
        free_encoder(d, e, false)
        ffi.write_ptr(t, T_FENCE, fence)
        ffi.write_ptr(t, T_NEXT, ffi.read_ptr(d, D_TRANSFERS))
        ffi.write_ptr(d, D_TRANSFERS, t)
        << ffi.read_i64(t, T_ID)
    }
}

fn color_aliases(e c_ptr, t c_ptr) bool {
    unsafe {
        ccount := ffi.read_i64(e, E_CCOUNT)
        for i in 0:ccount {
            if ffi.read_ptr(e, E_COLORS + i * 8) == t { << true }
        }
        << false
    }
}

fn begin_render_pass_raw(e c_ptr, ccount int, colors_ptrs c_ptr, mips &[]int, loads &[]int, stores &[]int, clear_rgba &[]f64, depth c_ptr, depth_load int, depth_store int, clear_depth f64) int {
    unsafe {
        if !ffi.is_null(ffi.read_ptr(e, E_PASS)) || !ffi.is_null(ffi.read_ptr(e, E_COMPUTE)) || ccount < 0 || ccount > COLOR_TARGET_SLOTS || (ccount == 0 && ffi.is_null(depth)) || mips.len != ccount || loads.len != ccount || stores.len != ccount || clear_rgba.len != ccount * 4 || math.is_nan(clear_depth) || math.is_inf(clear_depth) || clear_depth < 0.0 || clear_depth > 1.0 || depth_load < 0 || depth_load > 2 || depth_store < 0 || depth_store > 1 {
            << fail("invalid GPU render pass state or clear values")
        }
        $width := 0
        $height := 0
        for i in 0:ccount {
            c := ffi.read_ptr(colors_ptrs, i * 8)
            if ffi.is_null(c) { << fail("invalid GPU render color target") }
            for j in 0:i {
                if ffi.read_ptr(colors_ptrs, j * 8) == c { << fail("duplicate GPU render color target") }
            }
            red := clear_rgba[i * 4]
            green := clear_rgba[i * 4 + 1]
            blue := clear_rgba[i * 4 + 2]
            alpha := clear_rgba[i * 4 + 3]
            if !real_color(red) || !real_color(green) || !real_color(blue) || !real_color(alpha) {
                << fail("invalid GPU render pass state or clear values")
            }
            usage := ffi.read_i64(c, R_USAGE)
            levels := ffi.read_i64(c, R_LEVELS)
            mip := mips[i]
            load := loads[i]
            store := stores[i]
            if (usage & 2) == 0 || mip < 0 || mip >= levels || load < 0 || load > 2 || store < 0 || store > 1 {
                << fail("invalid GPU render attachment usage, mip or operations")
            }
            cw := mip_extent(ffi.read_i64(c, R_WIDTH), mip)
            ch := mip_extent(ffi.read_i64(c, R_HEIGHT), mip)
            if i == 0 {
                width = cw
                height = ch
            } else if cw != width || ch != height {
                << fail("GPU render attachments must share dimensions")
            }
        }
        if !ffi.is_null(depth) {
            if ccount == 0 {
                width = ffi.read_i64(depth, R_WIDTH)
                height = ffi.read_i64(depth, R_HEIGHT)
            }
            if (ffi.read_i64(depth, R_USAGE) & 4) == 0 || ffi.read_i64(depth, R_WIDTH) != width || ffi.read_i64(depth, R_HEIGHT) != height {
                << fail("GPU depth attachment extent or usage mismatch")
            }
        }
        pass_id := identifier()
        if pass_id < 0 { << -1 }
        for i in 0:ccount {
            c := ffi.read_ptr(colors_ptrs, i * 8)
            if c != present_of(e) && !retain(e, c, false) { << -1 }
        }
        if !ffi.is_null(depth) && !retain(e, depth, false) { << -1 }
        $target := ffi.null()
        if ccount > 0 {
            target = ffi.calloc(ccount * 64)
            if ffi.is_null(target) { << fail("GPU command encoder allocation failed") }
            for i in 0:ccount {
                c := ffi.read_ptr(colors_ptrs, i * 8)
                base := i * 64
                ffi.write_ptr(target, base, ffi.read_ptr(c, R_GPU))
                ffi.write_u32(target, base + 8, u32(mips[i]))
                ffi.write_f32(target, base + 16, f32(clear_rgba[i * 4]))
                ffi.write_f32(target, base + 20, f32(clear_rgba[i * 4 + 1]))
                ffi.write_f32(target, base + 24, f32(clear_rgba[i * 4 + 2]))
                ffi.write_f32(target, base + 28, f32(clear_rgba[i * 4 + 3]))
                ffi.write_u32(target, base + 32, u32(loads[i]))
                ffi.write_u32(target, base + 36, u32(stores[i]))
            }
        }
        z := ffi.calloc(32)
        if ffi.is_null(z) {
            ffi.free(target)
            << fail("GPU command encoder allocation failed")
        }
        $depth_ptr := ffi.null()
        if !ffi.is_null(depth) {
            ffi.write_ptr(z, 0, ffi.read_ptr(depth, R_GPU))
            ffi.write_f32(z, 8, f32(clear_depth))
            ffi.write_u32(z, 12, u32(depth_load))
            ffi.write_u32(z, 16, u32(depth_store))
            depth_ptr = z
        }
        pass := sdl_begin_gpu_render_pass(sym(SYM_BEGIN_GPU_RENDER_PASS), ffi.read_ptr(e, E_COMMAND), target, u32(ccount), depth_ptr)
        ffi.free(target)
        ffi.free(z)
        if ffi.is_null(pass) { << sdl_fail() }
        ffi.write_ptr(e, E_PASS, pass)
        ffi.write_i64(e, E_PASS_ID, pass_id)
        ffi.write_i64(e, E_CCOUNT, ccount)
        if ccount > 0 {
            ffi.write_ptr(e, E_COLOR, ffi.read_ptr(colors_ptrs, 0))
        } else {
            ffi.write_ptr(e, E_COLOR, ffi.null())
        }
        for i in 0:COLOR_TARGET_SLOTS {
            if i < ccount {
                ffi.write_ptr(e, E_COLORS + i * 8, ffi.read_ptr(colors_ptrs, i * 8))
            } else {
                ffi.write_ptr(e, E_COLORS + i * 8, ffi.null())
            }
        }
        ffi.write_ptr(e, E_DEPTH, depth)
        ffi.write_ptr(e, E_PIPE, ffi.null())
        ffi.write_i64(e, E_WIDTH, width)
        ffi.write_i64(e, E_HEIGHT, height)
        clear_pass_state(e)
        << pass_id
    }
}

fn begin_render_pass(e c_ptr, color c_ptr, mip int, load int, store int, depth c_ptr, depth_load int, depth_store int, red f64, green f64, blue f64, alpha f64, clear_depth f64) int {
    unsafe {
        ptrs := ffi.calloc(8)
        if ffi.is_null(ptrs) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(ptrs, 0, color)
        mips := [mip]
        loads := [load]
        stores := [store]
        rgba := [red, green, blue, alpha]
        id := begin_render_pass_raw(e, 1, ptrs, &mips, &loads, &stores, &rgba, depth, depth_load, depth_store, clear_depth)
        ffi.free(ptrs)
        << id
    }
}

pub fn pass_begin(owner int, id int, desc &[]int, red f64, green f64, blue f64, alpha f64, clear_depth f64) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, false)
    if ffi.is_null(e) { << -1 }
    unsafe {
        if !ffi.is_null(ffi.read_ptr(e, E_SURFACE)) || desc.len != 7 {
            << fail("invalid GPU offscreen render descriptor or encoder")
        }
    }
    color := resource_record(d, desc[0], KIND_TEXTURE)
    if ffi.is_null(color) { << -1 }
    $depth := ffi.null()
    if desc[4] != 0 {
        depth = resource_record(d, desc[4], KIND_TEXTURE)
        if ffi.is_null(depth) { << -1 }
    }
    << begin_render_pass(e, color, desc[1], desc[2], desc[3], depth, desc[5], desc[6], red, green, blue, alpha, clear_depth)
}

pub fn pass_begin_targets(owner int, id int, colors_desc &[]int, depth_desc &[]int, clear_rgba &[]f64, clear_depth f64) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, false)
    if ffi.is_null(e) { << -1 }
    unsafe {
        if !ffi.is_null(ffi.read_ptr(e, E_SURFACE)) || (colors_desc.len % 4) != 0 || colors_desc.len > COLOR_TARGET_SLOTS * 4 || depth_desc.len != 3 {
            << fail("invalid GPU offscreen render descriptor or encoder")
        }
        ccount := colors_desc.len / 4
        if ccount == 0 && depth_desc[0] == 0 {
            << fail("GPU render pass requires at least one color or depth attachment")
        }
        ptrs := ffi.calloc(32)
        if ffi.is_null(ptrs) { << fail("GPU command encoder allocation failed") }
        $mips := []int{}
        $loads := []int{}
        $stores := []int{}
        for i in 0:ccount {
            c := resource_record(d, colors_desc[i * 4], KIND_TEXTURE)
            if ffi.is_null(c) {
                ffi.free(ptrs)
                << -1
            }
            ffi.write_ptr(ptrs, i * 8, c)
            mips.push(colors_desc[i * 4 + 1])
            loads.push(colors_desc[i * 4 + 2])
            stores.push(colors_desc[i * 4 + 3])
        }
        $depth := ffi.null()
        if depth_desc[0] != 0 {
            depth = resource_record(d, depth_desc[0], KIND_TEXTURE)
            if ffi.is_null(depth) {
                ffi.free(ptrs)
                << -1
            }
        }
        pass_id := begin_render_pass_raw(e, ccount, ptrs, &mips, &loads, &stores, clear_rgba, depth, depth_desc[1], depth_desc[2], clear_depth)
        ffi.free(ptrs)
        << pass_id
    }
}

pub fn pass_end(owner int, id int) int {
    if !on_main() { << -1 }
    d := device_by_id(owner)
    if ffi.is_null(d) { << 0 }
    unsafe {
        $e := ffi.read_ptr(d, D_ENCODERS)
        while !ffi.is_null(e) {
            if !ffi.is_null(ffi.read_ptr(e, E_PASS)) && ffi.read_i64(e, E_PASS_ID) == id {
                sdl_end_gpu_render_pass(sym(SYM_END_GPU_RENDER_PASS), ffi.read_ptr(e, E_PASS))
                ffi.write_ptr(e, E_PASS, ffi.null())
                << 0
            }
            e = ffi.read_ptr(e, E_NEXT)
        }
        << 0
    }
}

pub fn pass_pipeline(owner int, id int, pipeline int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    r := resource_record(d, pipeline, KIND_PIPELINE)
    if ffi.is_null(r) { << -1 }
    unsafe {
        ccount := ffi.read_i64(e, E_CCOUNT)
        depth := ffi.read_ptr(e, E_DEPTH)
        $depth_fmt := 0
        if !ffi.is_null(depth) { depth_fmt = ffi.read_i64(depth, R_FORMAT) }
        if ffi.read_i64(r, R_COLOR_COUNT) != ccount || ffi.read_i64(r, R_DEPTH) != depth_fmt {
            << fail("GPU pipeline attachment formats do not match render pass")
        }
        for i in 0:ccount {
            c := ffi.read_ptr(e, E_COLORS + i * 8)
            if ffi.read_i64(r, R_COLORS + i * 8) != ffi.read_i64(c, R_FORMAT) {
                << fail("GPU pipeline attachment formats do not match render pass")
            }
        }
        if !retain(e, r, false) { << -1 }
        sdl_bind_gpu_graphics_pipeline(sym(SYM_BIND_GPU_GRAPHICS_PIPELINE), ffi.read_ptr(e, E_PASS), ffi.read_ptr(r, R_GPU))
        ffi.write_ptr(e, E_PIPE, r)
        clear_pass_state(e)
        << 0
    }
}

fn binding_aligned(offset int, index_size int) bool {
    if index_size == 0 || index_size == 4 { << (offset % 4) == 0 }
    if index_size == 2 { << (offset % 2) == 0 }
    << false
}

pub fn pass_buffer(owner int, id int, buffer_id int, slot int, offset int, index_size int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    b := buffer_record(d, buffer_id)
    if ffi.is_null(b) { << -1 }
    unsafe {
        if ffi.is_null(ffi.read_ptr(e, E_PIPE)) { << fail("invalid GPU vertex/index binding, offset or usage") }
        buf_size := int(ffi.read_u32(b, B_SIZE))
        $need := 1
        if index_size != 0 { need = 2 }
        usage := int(ffi.read_u32(b, B_USAGE))
        if offset < 0 || offset >= buf_size || !binding_aligned(offset, index_size) || slot < 0 || slot >= VERTEX_SLOTS || (usage & need) == 0 {
            << fail("invalid GPU vertex/index binding, offset or usage")
        }
        if !retain(e, b, true) { << -1 }
        binding := ffi.calloc(16)
        if ffi.is_null(binding) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(binding, 0, ffi.read_ptr(b, B_GPU))
        ffi.write_u32(binding, 8, u32(offset))
        if index_size != 0 {
            $elem := u32(1)
            if index_size == 2 { elem = u32(0) }
            sdl_bind_gpu_index_buffer(sym(SYM_BIND_GPU_INDEX_BUFFER), ffi.read_ptr(e, E_PASS), binding, elem)
            ffi.write_ptr(e, E_INDEX, b)
            ffi.write_i64(e, E_IOFF, offset)
            ffi.write_i64(e, E_ISZ, index_size)
        } else {
            sdl_bind_gpu_vertex_buffers(sym(SYM_BIND_GPU_VERTEX_BUFFERS), ffi.read_ptr(e, E_PASS), u32(slot), binding, u32(1))
            ffi.write_ptr(e, E_VERTS + slot * 8, b)
            ffi.write_i64(e, E_OFFS + slot * 8, offset)
        }
        ffi.free(binding)
        << 0
    }
}

pub fn pass_sampler(owner int, id int, stage int, slot int, texture int, sampler int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    t := resource_record(d, texture, KIND_TEXTURE)
    if ffi.is_null(t) { << -1 }
    s := resource_record(d, sampler, KIND_SAMPLER)
    if ffi.is_null(s) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || stage < 0 || stage > 1 || slot < 0 || slot >= bind_field(pipe, stage, BND_SAMP) || (ffi.read_i64(t, R_USAGE) & 1) == 0 || color_aliases(e, t) || t == ffi.read_ptr(e, E_DEPTH) {
            << fail("GPU sampler binding is undeclared, not sampled or aliases an active attachment")
        }
        if !retain(e, t, false) || !retain(e, s, false) { << -1 }
        binding := ffi.calloc(16)
        if ffi.is_null(binding) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(binding, 0, ffi.read_ptr(t, R_GPU))
        ffi.write_ptr(binding, 8, ffi.read_ptr(s, R_GPU))
        if stage == 0 {
            sdl_bind_gpu_vertex_samplers(sym(SYM_BIND_GPU_VERTEX_SAMPLERS), ffi.read_ptr(e, E_PASS), u32(slot), binding, u32(1))
        } else {
            sdl_bind_gpu_fragment_samplers(sym(SYM_BIND_GPU_FRAGMENT_SAMPLERS), ffi.read_ptr(e, E_PASS), u32(slot), binding, u32(1))
        }
        ffi.free(binding)
        bits := ffi.read_i64(e, E_SAMP + stage * 8) | (1 << slot)
        ffi.write_i64(e, E_SAMP + stage * 8, bits)
        << 0
    }
}

pub fn pass_uniform(owner int, id int, stage int, slot int, data &[]u8) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || stage < 0 || stage > 1 || slot < 0 || slot >= bind_field(pipe, stage, BND_COUNT) || data.len != bind_field(pipe, stage, BND_SIZES + slot * 4) {
            << fail("GPU uniform binding requires its declared exact byte size")
        }
        raw := bytes_data(data)
        if ffi.is_null(raw) { << fail("GPU uniform binding requires its declared exact byte size") }
        if stage == 0 {
            sdl_push_gpu_vertex_uniform_data(sym(SYM_PUSH_GPU_VERTEX_UNIFORM_DATA), ffi.read_ptr(e, E_COMMAND), u32(slot), raw, u32(data.len))
        } else {
            sdl_push_gpu_fragment_uniform_data(sym(SYM_PUSH_GPU_FRAGMENT_UNIFORM_DATA), ffi.read_ptr(e, E_COMMAND), u32(slot), raw, u32(data.len))
        }
        ffi.free(raw)
        bits := ffi.read_i64(e, E_UNIF + stage * 8) | (1 << slot)
        ffi.write_i64(e, E_UNIF + stage * 8, bits)
        << 0
    }
}

pub fn pass_rect(owner int, id int, x int, y int, width int, height int, scissor int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    unsafe {
        ew := ffi.read_i64(e, E_WIDTH)
        eh := ffi.read_i64(e, E_HEIGHT)
        if x < 0 || y < 0 || width < 1 || height < 1 || x > ew || y > eh || width > ew - x || height > eh - y {
            << fail("GPU viewport/scissor must fit the render attachment")
        }
        if scissor != 0 {
            rect := ffi.calloc(16)
            if ffi.is_null(rect) { << fail("GPU command encoder allocation failed") }
            ffi.write_i32(rect, 0, i32(x))
            ffi.write_i32(rect, 4, i32(y))
            ffi.write_i32(rect, 8, i32(width))
            ffi.write_i32(rect, 12, i32(height))
            sdl_set_gpu_scissor(sym(SYM_SET_GPU_SCISSOR), ffi.read_ptr(e, E_PASS), rect)
            ffi.free(rect)
        } else {
            vp := ffi.calloc(24)
            if ffi.is_null(vp) { << fail("GPU command encoder allocation failed") }
            ffi.write_f32(vp, 0, f32(x))
            ffi.write_f32(vp, 4, f32(y))
            ffi.write_f32(vp, 8, f32(width))
            ffi.write_f32(vp, 12, f32(height))
            ffi.write_f32(vp, 16, f32(0.0))
            ffi.write_f32(vp, 20, f32(1.0))
            sdl_set_gpu_viewport(sym(SYM_SET_GPU_VIEWPORT), ffi.read_ptr(e, E_PASS), vp)
            ffi.free(vp)
        }
        << 0
    }
}

pub fn pass_storage_texture(owner int, id int, stage int, slot int, texture int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    t := resource_record(d, texture, KIND_TEXTURE)
    if ffi.is_null(t) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || stage < 0 || stage > 1 || slot < 0 || slot >= ffi.read_i64(pipe, R_STAGE_STEX + stage * 8) || (ffi.read_i64(t, R_USAGE) & 8) == 0 || color_aliases(e, t) || t == ffi.read_ptr(e, E_DEPTH) {
            << fail("GPU storage texture binding is undeclared, unreadable or aliases an active attachment")
        }
        if !retain(e, t, false) { << -1 }
        slotp := ffi.calloc(8)
        if ffi.is_null(slotp) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(slotp, 0, ffi.read_ptr(t, R_GPU))
        if stage == 0 {
            sdl_bind_gpu_vertex_storage_textures(sym(SYM_BIND_GPU_VERTEX_STORAGE_TEXTURES), ffi.read_ptr(e, E_PASS), u32(slot), slotp, u32(1))
        } else {
            sdl_bind_gpu_fragment_storage_textures(sym(SYM_BIND_GPU_FRAGMENT_STORAGE_TEXTURES), ffi.read_ptr(e, E_PASS), u32(slot), slotp, u32(1))
        }
        ffi.free(slotp)
        bits := ffi.read_i64(e, E_STEX + stage * 8) | (1 << slot)
        ffi.write_i64(e, E_STEX + stage * 8, bits)
        << 0
    }
}

pub fn pass_storage_buffer(owner int, id int, stage int, slot int, buffer_id int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    b := buffer_record(d, buffer_id)
    if ffi.is_null(b) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || stage < 0 || stage > 1 || slot < 0 || slot >= ffi.read_i64(pipe, R_STAGE_SBUF + stage * 8) || (int(ffi.read_u32(b, B_USAGE)) & 8) == 0 {
            << fail("GPU storage buffer binding is undeclared or unreadable by graphics")
        }
        if !retain(e, b, true) { << -1 }
        slotp := ffi.calloc(8)
        if ffi.is_null(slotp) { << fail("GPU command encoder allocation failed") }
        ffi.write_ptr(slotp, 0, ffi.read_ptr(b, B_GPU))
        if stage == 0 {
            sdl_bind_gpu_vertex_storage_buffers(sym(SYM_BIND_GPU_VERTEX_STORAGE_BUFFERS), ffi.read_ptr(e, E_PASS), u32(slot), slotp, u32(1))
        } else {
            sdl_bind_gpu_fragment_storage_buffers(sym(SYM_BIND_GPU_FRAGMENT_STORAGE_BUFFERS), ffi.read_ptr(e, E_PASS), u32(slot), slotp, u32(1))
        }
        ffi.free(slotp)
        bits := ffi.read_i64(e, E_SBUF + stage * 8) | (1 << slot)
        ffi.write_i64(e, E_SBUF + stage * 8, bits)
        << 0
    }
}

fn check_render_bindings(e c_ptr, pipe c_ptr) bool {
    unsafe {
        for stage in 0:2 {
            if ffi.read_i64(e, E_SAMP + stage * 8) != mask_n(bind_field(pipe, stage, BND_SAMP)) || ffi.read_i64(e, E_UNIF + stage * 8) != mask_n(bind_field(pipe, stage, BND_COUNT)) || ffi.read_i64(e, E_STEX + stage * 8) != mask_n(ffi.read_i64(pipe, R_STAGE_STEX + stage * 8)) || ffi.read_i64(e, E_SBUF + stage * 8) != mask_n(ffi.read_i64(pipe, R_STAGE_SBUF + stage * 8)) {
                << false
            }
        }
        << true
    }
}

pub fn pass_draw(owner int, id int, count int, first int, instances int, first_instance int, indexed int, vertex_offset int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || count < 1 || count > 4294967295 || first < 0 || first > 4294967295 || count > 4294967295 - first || instances < 1 || instances > 4294967295 || first_instance < 0 || first_instance > 4294967295 || instances > 4294967295 - first_instance || vertex_offset < -2147483648 || vertex_offset > 2147483647 {
            << fail("invalid GPU draw range or missing pipeline")
        }
        if !check_render_bindings(e, pipe) {
            << fail("GPU draw has missing sampler, storage or uniform bindings")
        }
        vcount := ffi.read_i64(pipe, R_VCOUNT)
        for i in 0:vcount {
            slot := int(ffi.read_u32(pipe, R_VERTS + i * 16))
            pitch := int(ffi.read_u32(pipe, R_VERTS + i * 16 + 4))
            rate := int(ffi.read_u32(pipe, R_VERTS + i * 16 + 8))
            b := ffi.read_ptr(e, E_VERTS + slot * 8)
            if ffi.is_null(b) { << fail("GPU draw has missing vertex buffers") }
            $elements := first + count
            if indexed != 0 { elements = 1 }
            if rate == 1 { elements = first_instance + instances }
            off := ffi.read_i64(e, E_OFFS + slot * 8)
            if elements * pitch > int(ffi.read_u32(b, B_SIZE)) - off { << fail("GPU draw exceeds vertex/instance buffer bounds") }
        }
        if indexed != 0 {
            index := ffi.read_ptr(e, E_INDEX)
            isz := ffi.read_i64(e, E_ISZ)
            ioff := ffi.read_i64(e, E_IOFF)
            if ffi.is_null(index) || (first + count) * isz > int(ffi.read_u32(index, B_SIZE)) - ioff {
                << fail("GPU indexed draw exceeds index buffer bounds")
            }
            sdl_draw_gpu_indexed_primitives(sym(SYM_DRAW_GPU_INDEXED_PRIMITIVES), ffi.read_ptr(e, E_PASS), u32(count), u32(instances), u32(first), i32(vertex_offset), u32(first_instance))
        } else {
            sdl_draw_gpu_primitives(sym(SYM_DRAW_GPU_PRIMITIVES), ffi.read_ptr(e, E_PASS), u32(count), u32(instances), u32(first), u32(first_instance))
        }
        << 0
    }
}

pub fn pass_draw_indirect(owner int, id int, buffer_id int, offset int, draw_count int, indexed int) int {
    d := device_record(owner)
    if ffi.is_null(d) { << -1 }
    e := encoder_record(d, id, true)
    if ffi.is_null(e) { << -1 }
    b := buffer_record(d, buffer_id)
    if ffi.is_null(b) { << -1 }
    unsafe {
        pipe := ffi.read_ptr(e, E_PIPE)
        if ffi.is_null(pipe) || draw_count < 0 || draw_count > 4294967295 || offset < 0 || (offset % 4) != 0 {
            << fail("invalid GPU indirect draw range or missing pipeline")
        }
        $stride := 16
        if indexed != 0 { stride = 20 }
        buf_size := int(ffi.read_u32(b, B_SIZE))
        usage := int(ffi.read_u32(b, B_USAGE))
        if (usage & 4) == 0 || offset > buf_size || draw_count > (buf_size - offset) / stride {
            << fail("GPU indirect draw buffer has invalid usage or exceeds bounds")
        }
        if !check_render_bindings(e, pipe) {
            << fail("GPU draw has missing sampler, storage or uniform bindings")
        }
        vcount := ffi.read_i64(pipe, R_VCOUNT)
        for i in 0:vcount {
            slot := int(ffi.read_u32(pipe, R_VERTS + i * 16))
            pitch := int(ffi.read_u32(pipe, R_VERTS + i * 16 + 4))
            vb := ffi.read_ptr(e, E_VERTS + slot * 8)
            if ffi.is_null(vb) || pitch > int(ffi.read_u32(vb, B_SIZE)) - ffi.read_i64(e, E_OFFS + slot * 8) {
                << fail("GPU indirect draw has missing or empty vertex buffer")
            }
        }
        if indexed != 0 {
            index := ffi.read_ptr(e, E_INDEX)
            if ffi.is_null(index) || ffi.read_i64(e, E_ISZ) > int(ffi.read_u32(index, B_SIZE)) - ffi.read_i64(e, E_IOFF) {
                << fail("GPU indirect indexed draw has missing or empty index buffer")
            }
        }
        if !retain(e, b, true) { << -1 }
        if indexed != 0 {
            sdl_draw_gpu_indexed_primitives_indirect(sym(SYM_DRAW_GPU_INDEXED_PRIMITIVES_INDIRECT), ffi.read_ptr(e, E_PASS), ffi.read_ptr(b, B_GPU), u32(offset), u32(draw_count))
        } else {
            sdl_draw_gpu_primitives_indirect(sym(SYM_DRAW_GPU_PRIMITIVES_INDIRECT), ffi.read_ptr(e, E_PASS), ffi.read_ptr(b, B_GPU), u32(offset), u32(draw_count))
        }
        << 0
    }
}

pub fn resource_close(owner int, id int) int {
    if !on_main() { << -1 }
    d := device_by_id(owner)
    if ffi.is_null(d) { << 0 }
    unsafe {
        $r := ffi.read_ptr(d, D_RESOURCES)
        while !ffi.is_null(r) {
            if ffi.read_i64(r, R_ID) == id {
                ffi.write_i64(r, R_CLOSED, 1)
                <-
            }
            r = ffi.read_ptr(r, R_NEXT)
        }
        collect_resources(d)
        << 0
    }
}
