@internal/sdl
// Text-input and pointer-mode helpers (former input.h).

#ffi

extern "C" fn sdl_start_text_input(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_stop_text_input(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_text_input_active(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_set_text_input_area(fn_ptr c_ptr, win c_ptr, rect c_ptr, cursor c_int) u8 = dynamic
extern "C" fn sdl_set_window_relative_mouse(fn_ptr c_ptr, win c_ptr, enabled u8) u8 = dynamic
extern "C" fn sdl_get_window_relative_mouse(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_set_window_mouse_grab(fn_ptr c_ptr, win c_ptr, enabled u8) u8 = dynamic
extern "C" fn sdl_get_window_mouse_grab(fn_ptr c_ptr, win c_ptr) u8 = dynamic

pub fn window_text(id int, action int) int {
    w := window_record(id)
    if ffi.is_null(w) || !load_input_syms() { << -1 }
    unsafe {
        native := ffi.read_ptr(w, WR_NATIVE)
        if action == 2 {
            if sdl_text_input_active(sym(SYM_TEXT_INPUT_ACTIVE), native) != u8(0) { << 1 }
            << 0
        }
        if action == 1 {
            if sdl_start_text_input(sym(SYM_START_TEXT_INPUT), native) != u8(0) { << 0 }
            << sdl_fail()
        }
        if action == 0 {
            if sdl_stop_text_input(sym(SYM_STOP_TEXT_INPUT), native) != u8(0) { << 0 }
            << sdl_fail()
        }
        << fail("invalid window text input operation")
    }
}

pub fn window_text_area(id int, area &[]int) int {
    w := window_record(id)
    if ffi.is_null(w) || !load_input_syms() { << -1 }
    unsafe {
        native := ffi.read_ptr(w, WR_NATIVE)
        if area.len == 0 {
            if sdl_set_text_input_area(sym(SYM_SET_TEXT_INPUT_AREA), native, ffi.null(), i32(0)) != u8(0) { << 0 }
            << sdl_fail()
        }
        if area.len != 5 { << fail("invalid text input area") }
        for i in 0:5 {
            // i32 range check approximated via cast round-trip.
            if area[i] != int(i32(area[i])) { << fail("text input area exceeds int32 range") }
        }
        if area[2] <= 0 || area[3] <= 0 || area[4] < 0 || area[4] > area[2] {
            << fail("invalid text input area extent or cursor")
        }
        buf := ffi.calloc(16)
        if ffi.is_null(buf) { << fail("text input area allocation failed") }
        ffi.write_i32(buf, 0, i32(area[0]))
        ffi.write_i32(buf, 4, i32(area[1]))
        ffi.write_i32(buf, 8, i32(area[2]))
        ffi.write_i32(buf, 12, i32(area[3]))
        ok := sdl_set_text_input_area(sym(SYM_SET_TEXT_INPUT_AREA), native, buf, i32(area[4]))
        ffi.free(buf)
        if ok != u8(0) { << 0 }
        << sdl_fail()
    }
}

pub fn window_pointer_mode(id int, kind int, enabled int) int {
    w := window_record(id)
    if ffi.is_null(w) || !load_input_syms() { << -1 }
    if kind < 0 || kind > 1 || enabled < 0 || enabled > 2 { << fail("invalid pointer mode") }
    unsafe {
        native := ffi.read_ptr(w, WR_NATIVE)
        if enabled == 2 {
            $on := u8(0)
            if kind != 0 {
                on = sdl_get_window_mouse_grab(sym(SYM_GET_WINDOW_MOUSE_GRAB), native)
            } else {
                on = sdl_get_window_relative_mouse(sym(SYM_GET_WINDOW_RELATIVE_MOUSE), native)
            }
            if on != u8(0) { << 1 }
            << 0
        }
        $flag := u8(0)
        if enabled != 0 { flag = u8(1) }
        $ok := u8(0)
        if kind != 0 {
            ok = sdl_set_window_mouse_grab(sym(SYM_SET_WINDOW_MOUSE_GRAB), native, flag)
        } else {
            ok = sdl_set_window_relative_mouse(sym(SYM_SET_WINDOW_RELATIVE_MOUSE), native, flag)
        }
        if ok != u8(0) { << 0 }
        << sdl_fail()
    }
}
