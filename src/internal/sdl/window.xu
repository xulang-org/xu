@internal/sdl
// Window lifecycle (former window.h). Event/input queues live in events.xu.

#ffi

extern "C" fn sdl_create_window(fn_ptr c_ptr, title c_ptr, w c_int, h c_int, flags u64) c_ptr = dynamic
extern "C" fn sdl_destroy_window(fn_ptr c_ptr, win c_ptr) = dynamic
extern "C" fn sdl_get_window_id(fn_ptr c_ptr, win c_ptr) u32 = dynamic
extern "C" fn sdl_get_window_flags(fn_ptr c_ptr, win c_ptr) u64 = dynamic
extern "C" fn sdl_get_window_size(fn_ptr c_ptr, win c_ptr, w c_ptr, h c_ptr) u8 = dynamic
extern "C" fn sdl_get_window_size_in_pixels(fn_ptr c_ptr, win c_ptr, w c_ptr, h c_ptr) u8 = dynamic
extern "C" fn sdl_set_window_size(fn_ptr c_ptr, win c_ptr, w c_int, h c_int) u8 = dynamic
extern "C" fn sdl_show_window(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_hide_window(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_minimize_window(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_restore_window(fn_ptr c_ptr, win c_ptr) u8 = dynamic
extern "C" fn sdl_pump_events(fn_ptr c_ptr) = dynamic
extern "C" fn sdl_filter_events(fn_ptr c_ptr, filter c_ptr, userdata c_ptr) = dynamic

// WindowRecord (calloc): id, event_id, native, closed, close_requested, next, input.
const WR_ID = 0
const WR_EVENT_ID = 8
const WR_NATIVE = 16
const WR_CLOSED = 24
const WR_CLOSE_REQ = 32
const WR_NEXT = 40
const WR_INPUT = 48
// Input blob: header + keys[232] + 256 event slots of 22 words.
const WR_SIZE = 45400 // WR_INPUT + 296 + EVENT_CAPACITY * 176

fn window_record(id int) c_ptr {
    if !on_main() { << ffi.null() }
    unsafe {
        $w := windows_head()
        while !ffi.is_null(w) {
            if ffi.read_i64(w, WR_ID) == id && ffi.read_i64(w, WR_CLOSED) == 0 { << w }
            w = ffi.read_ptr(w, WR_NEXT)
        }
        fail("closed or invalid window")
        << ffi.null()
    }
}

pub fn window_open(title &[]u8, width int, height int, options int) int {
    if title.len < 1 || title.len > 4096 || width < 1 || height < 1 || options < 0 || options > 7 {
        << fail("invalid window title, dimensions or options")
    }
    for i in 0:title.len {
        if title[i] == u8(0) { << fail("invalid window title, dimensions or options") }
    }
    if !load_window_syms() { << -1 }
    unsafe {
        w := ffi.calloc(WR_SIZE)
        $title_s := ""
        for i in 0:title.len { title_s = title_s + string_from_byte(int(title[i])) }
        name := ffi.cstring(&title_s)
        if ffi.is_null(w) || ffi.is_null(name) {
            ffi.free(w)
            ffi.free(name)
            << fail("window allocation failed")
        }
        id := identifier()
        if id < 0 {
            ffi.free(w)
            ffi.free(name)
            << -1
        }
        ffi.write_i64(w, WR_ID, id)
        if sdl_init_subsystem(sym(SYM_INIT_SUBSYSTEM), u32(SDL_INIT_VIDEO)) == u8(0) {
            ffi.free(w)
            ffi.free(name)
            << sdl_fail()
        }
        $flags := u64(0)
        if (options & 1) != 0 { flags = flags | u64(SDL_WINDOW_RESIZABLE) }
        if (options & 2) != 0 { flags = flags | u64(SDL_WINDOW_HIGH_PIXEL_DENSITY) }
        if (options & 4) != 0 { flags = flags | u64(SDL_WINDOW_HIDDEN) }
        native := sdl_create_window(sym(SYM_CREATE_WINDOW), name, i32(width), i32(height), flags)
        ffi.free(name)
        if ffi.is_null(native) {
            sdl_fail()
            sdl_quit_subsystem(sym(SYM_QUIT_SUBSYSTEM), u32(SDL_INIT_VIDEO))
            ffi.free(w)
            << -1
        }
        event_id := sdl_get_window_id(sym(SYM_GET_WINDOW_ID), native)
        if event_id == u32(0) {
            sdl_fail()
            sdl_destroy_window(sym(SYM_DESTROY_WINDOW), native)
            sdl_quit_subsystem(sym(SYM_QUIT_SUBSYSTEM), u32(SDL_INIT_VIDEO))
            ffi.free(w)
            << -1
        }
        ffi.write_u32(w, WR_EVENT_ID, event_id)
        ffi.write_ptr(w, WR_NATIVE, native)
        ffi.write_ptr(w, WR_NEXT, windows_head())
        set_windows_head(w)
        << id
    }
}

pub fn window_close(id int) int {
    if !on_main() { << -1 }
    unsafe {
        $prev := ffi.null()
        $w := windows_head()
        while !ffi.is_null(w) {
            if ffi.read_i64(w, WR_ID) == id { <- }
            prev = w
            w = ffi.read_ptr(w, WR_NEXT)
        }
        if ffi.is_null(w) || ffi.read_i64(w, WR_CLOSED) != 0 { << 0 }
        ffi.write_i64(w, WR_CLOSED, 1)
        // Match C window_close: drain owned events via FilterEvents around
        // DestroyWindow so stale SDL events cannot outlive the record.
        if !load_window_syms() { << -1 }
        filter := c_callback(filter_window_events)
        sdl_filter_events(sym(SYM_FILTER_EVENTS), filter, ffi.null())
        native := ffi.read_ptr(w, WR_NATIVE)
        if !ffi.is_null(native) {
            sdl_destroy_window(sym(SYM_DESTROY_WINDOW), native)
            ffi.write_ptr(w, WR_NATIVE, ffi.null())
        }
        sdl_filter_events(sym(SYM_FILTER_EVENTS), filter, ffi.null())
        clear_window_events(w)
        next := ffi.read_ptr(w, WR_NEXT)
        if ffi.is_null(prev) {
            set_windows_head(next)
        } else {
            ffi.write_ptr(prev, WR_NEXT, next)
        }
        ffi.free(w)
        sdl_quit_subsystem(sym(SYM_QUIT_SUBSYSTEM), u32(SDL_INIT_VIDEO))
        << 0
    }
}

pub fn window_pump() int {
    if !on_main() { << -1 }
    if ffi.is_null(windows_head()) { << 0 }
    if !load_window_syms() { << -1 }
    unsafe {
        sdl_pump_events(sym(SYM_PUMP_EVENTS))
        filter := c_callback(filter_window_events)
        sdl_filter_events(sym(SYM_FILTER_EVENTS), filter, ffi.null())
        << 0
    }
}

pub fn window_state(id int, output $&[]int) int {
    w := window_record(id)
    if ffi.is_null(w) { << -1 }
    if output.len != 8 { << fail("window state requires eight output words") }
    unsafe {
        native := ffi.read_ptr(w, WR_NATIVE)
        buf := ffi.calloc(16)
        if ffi.is_null(buf) { << fail("window size allocation failed") }
        if sdl_get_window_size(sym(SYM_GET_WINDOW_SIZE), native, buf, ffi.offset(buf, 4)) == u8(0) {
            ffi.free(buf)
            << sdl_fail()
        }
        if sdl_get_window_size_in_pixels(sym(SYM_GET_WINDOW_SIZE_IN_PIXELS), native, ffi.offset(buf, 8), ffi.offset(buf, 12)) == u8(0) {
            ffi.free(buf)
            << sdl_fail()
        }
        flags := sdl_get_window_flags(sym(SYM_GET_WINDOW_FLAGS), native)
        output[0] = int(ffi.read_i32(buf, 0))
        output[1] = int(ffi.read_i32(buf, 4))
        output[2] = int(ffi.read_i32(buf, 8))
        output[3] = int(ffi.read_i32(buf, 12))
        output[4] = ffi.read_i64(w, WR_CLOSE_REQ)
        if (flags & u64(SDL_WINDOW_MINIMIZED)) != u64(0) { output[5] = 1 } else { output[5] = 0 }
        if (flags & u64(SDL_WINDOW_HIDDEN)) != u64(0) { output[6] = 0 } else { output[6] = 1 }
        if (flags & u64(SDL_WINDOW_INPUT_FOCUS)) != u64(0) { output[7] = 1 } else { output[7] = 0 }
        ffi.free(buf)
        << 0
    }
}

pub fn window_resize(id int, width int, height int) int {
    w := window_record(id)
    if ffi.is_null(w) { << -1 }
    if width < 1 || height < 1 { << fail("invalid window dimensions") }
    unsafe {
        native := ffi.read_ptr(w, WR_NATIVE)
        if sdl_set_window_size(sym(SYM_SET_WINDOW_SIZE), native, i32(width), i32(height)) != u8(0) { << 0 }
        << sdl_fail()
    }
}

pub fn window_visibility(id int, action int) int {
    w := window_record(id)
    if ffi.is_null(w) { << -1 }
    unsafe {
        native := ffi.read_ptr(w, WR_NATIVE)
        $ok := u8(0)
        if action == 0 { ok = sdl_hide_window(sym(SYM_HIDE_WINDOW), native) }
        else if action == 1 { ok = sdl_show_window(sym(SYM_SHOW_WINDOW), native) }
        else if action == 2 { ok = sdl_minimize_window(sym(SYM_MINIMIZE_WINDOW), native) }
        else if action == 3 { ok = sdl_restore_window(sym(SYM_RESTORE_WINDOW), native) }
        else { << fail("invalid window visibility operation") }
        if ok != u8(0) { << 0 }
        << sdl_fail()
    }
}

pub fn window_count() int {
    if !on_main() { << -1 }
    unsafe {
        $n := 0
        $w := windows_head()
        while !ffi.is_null(w) {
            if ffi.read_i64(w, WR_CLOSED) == 0 { n += 1 }
            w = ffi.read_ptr(w, WR_NEXT)
        }
        << n
    }
}
