const SYM_SET_WINDOW_SIZE = 11
const SYM_SHOW_WINDOW = 12
const SYM_HIDE_WINDOW = 13
const SYM_MINIMIZE_WINDOW = 14
const SYM_RESTORE_WINDOW = 15
const SYM_PUMP_EVENTS = 16
const SYM_FILTER_EVENTS = 17
const SYM_GET_WINDOW_FROM_EVENT = 18
const SYM_START_TEXT_INPUT = 19
const SYM_STOP_TEXT_INPUT = 20
const SYM_TEXT_INPUT_ACTIVE = 21
const SYM_SET_TEXT_INPUT_AREA = 22
const SYM_SET_WINDOW_RELATIVE_MOUSE = 23
const SYM_GET_WINDOW_RELATIVE_MOUSE = 24
const SYM_SET_WINDOW_MOUSE_GRAB = 25
