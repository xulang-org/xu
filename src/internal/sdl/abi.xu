@internal/sdl
// SDL 3 ABI subset used by the Xu backend. Opaque handles are c_ptr;
// layout structs match the private headers formerly in this directory.

#ffi

// ----- Opaque SDL objects -----
// (typed only as c_ptr at call sites)

// ----- GPU buffer / transfer descriptors (sdl_abi.h) -----
@repr("C")
struct GPUBufferCreateInfo {
    usage u32
    size u32
    props u32
}

@repr("C")
struct GPUTransferBufferCreateInfo {
    usage c_int
    size u32
    props u32
}

@repr("C")
struct GPUBufferLocation {
    buffer c_ptr
    offset u32
}

@repr("C")
struct GPUBufferRegion {
    buffer c_ptr
    offset u32
    size u32
}

@repr("C")
struct GPUTransferBufferLocation {
    transfer_buffer c_ptr
    offset u32
}

@repr("C")
struct Rect {
    x c_int
    y c_int
    w c_int
    h c_int
}

// SDL_InitSubSystem flag for video/GPU.
const SDL_INIT_VIDEO = 0x20

const SDL_WINDOW_HIDDEN = 0x8
const SDL_WINDOW_RESIZABLE = 0x20
const SDL_WINDOW_MINIMIZED = 0x40
const SDL_WINDOW_INPUT_FOCUS = 0x200
const SDL_WINDOW_HIGH_PIXEL_DENSITY = 0x2000

const SDL_EVENT_QUIT = 0x100
const SDL_EVENT_WINDOW_FIRST = 0x202
const SDL_EVENT_WINDOW_RESIZED = 0x206
const SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED = 0x207
const SDL_EVENT_WINDOW_FOCUS_GAINED = 0x20e
const SDL_EVENT_WINDOW_FOCUS_LOST = 0x20f
const SDL_EVENT_WINDOW_CLOSE_REQUESTED = 0x210
const SDL_EVENT_WINDOW_LAST = 0x21a
const SDL_EVENT_KEY_DOWN = 0x300
const SDL_EVENT_KEY_UP = 0x301
const SDL_EVENT_TEXT_EDITING = 0x302
const SDL_EVENT_TEXT_INPUT = 0x303
const SDL_EVENT_MOUSE_MOTION = 0x400
const SDL_EVENT_MOUSE_BUTTON_DOWN = 0x401
const SDL_EVENT_MOUSE_BUTTON_UP = 0x402
const SDL_EVENT_MOUSE_WHEEL = 0x403
const SDL_EVENT_USER = 0x8000

const EVENT_WORDS = 21
const EVENT_CAPACITY = 256
const EVENT_TEXT_LIMIT = 65536
const EVENT_TEXT_BUDGET = 262144
const EVENT_KEY_COUNT = 232

const W_NONE = 0
const W_CLOSE = 1
const W_FOCUS_GAINED = 2
const W_FOCUS_LOST = 3
const W_RESIZED = 4
const W_PIXEL_SIZE = 5
const W_KEY_DOWN = 6
const W_KEY_UP = 7
const W_POINTER_MOVE = 8
const W_POINTER_DOWN = 9
const W_POINTER_UP = 10
const W_WHEEL = 11
const W_TEXT = 12
const W_EDIT = 13
const W_RESET = 14

const RESET_QUEUE = 1
const RESET_TEXT = 2
const RESET_INVALID = 3
const RESET_ALLOC = 4

// Core + window entry points resolved by name after dlopen.
const SYM_SET_MAIN_READY = 0
const SYM_IS_MAIN_THREAD = 1
const SYM_INIT_SUBSYSTEM = 2
const SYM_QUIT_SUBSYSTEM = 3
const SYM_GET_ERROR = 4
const SYM_CREATE_WINDOW = 5
const SYM_DESTROY_WINDOW = 6
const SYM_GET_WINDOW_ID = 7
const SYM_GET_WINDOW_FLAGS = 8
const SYM_GET_WINDOW_SIZE = 9
const SYM_GET_WINDOW_SIZE_IN_PIXELS = 10
const SYM_SET_WINDOW_SIZE = 11
const SYM_SHOW_WINDOW = 12
const SYM_HIDE_WINDOW = 13
const SYM_MINIMIZE_WINDOW = 14
const SYM_RESTORE_WINDOW = 15
const SYM_PUMP_EVENTS = 16
const SYM_FILTER_EVENTS = 17
const SYM_GET_WINDOW_FROM_EVENT = 18
const SYM_START_TEXT_INPUT = 19
const SYM_STOP_TEXT_INPUT = 20
const SYM_TEXT_INPUT_ACTIVE = 21
const SYM_SET_TEXT_INPUT_AREA = 22
const SYM_SET_WINDOW_RELATIVE_MOUSE = 23
const SYM_GET_WINDOW_RELATIVE_MOUSE = 24
const SYM_SET_WINDOW_MOUSE_GRAB = 25
const SYM_GET_WINDOW_MOUSE_GRAB = 26
const SYM_COUNT = 27

fn sym_name(i int) string {
    if i == SYM_SET_MAIN_READY { << "SDL_SetMainReady" }
    if i == SYM_IS_MAIN_THREAD { << "SDL_IsMainThread" }
    if i == SYM_INIT_SUBSYSTEM { << "SDL_InitSubSystem" }
    if i == SYM_QUIT_SUBSYSTEM { << "SDL_QuitSubSystem" }
    if i == SYM_GET_ERROR { << "SDL_GetError" }
    if i == SYM_CREATE_WINDOW { << "SDL_CreateWindow" }
    if i == SYM_DESTROY_WINDOW { << "SDL_DestroyWindow" }
    if i == SYM_GET_WINDOW_ID { << "SDL_GetWindowID" }
    if i == SYM_GET_WINDOW_FLAGS { << "SDL_GetWindowFlags" }
    if i == SYM_GET_WINDOW_SIZE { << "SDL_GetWindowSize" }
    if i == SYM_GET_WINDOW_SIZE_IN_PIXELS { << "SDL_GetWindowSizeInPixels" }
    if i == SYM_SET_WINDOW_SIZE { << "SDL_SetWindowSize" }
    if i == SYM_SHOW_WINDOW { << "SDL_ShowWindow" }
    if i == SYM_HIDE_WINDOW { << "SDL_HideWindow" }
    if i == SYM_MINIMIZE_WINDOW { << "SDL_MinimizeWindow" }
    if i == SYM_RESTORE_WINDOW { << "SDL_RestoreWindow" }
    if i == SYM_PUMP_EVENTS { << "SDL_PumpEvents" }
    if i == SYM_FILTER_EVENTS { << "SDL_FilterEvents" }
    if i == SYM_GET_WINDOW_FROM_EVENT { << "SDL_GetWindowFromEvent" }
    if i == SYM_START_TEXT_INPUT { << "SDL_StartTextInput" }
    if i == SYM_STOP_TEXT_INPUT { << "SDL_StopTextInput" }
    if i == SYM_TEXT_INPUT_ACTIVE { << "SDL_TextInputActive" }
    if i == SYM_SET_TEXT_INPUT_AREA { << "SDL_SetTextInputArea" }
    if i == SYM_SET_WINDOW_RELATIVE_MOUSE { << "SDL_SetWindowRelativeMouseMode" }
    if i == SYM_GET_WINDOW_RELATIVE_MOUSE { << "SDL_GetWindowRelativeMouseMode" }
    if i == SYM_SET_WINDOW_MOUSE_GRAB { << "SDL_SetWindowMouseGrab" }
    if i == SYM_GET_WINDOW_MOUSE_GRAB { << "SDL_GetWindowMouseGrab" }
    << ""
}
