const SYM_UPLOAD_TO_GPU_TEXTURE = 59
const SYM_DOWNLOAD_FROM_GPU_TEXTURE = 60
const SYM_GENERATE_MIPMAPS_FOR_GPU_TEXTURE = 61
const SYM_BEGIN_GPU_RENDER_PASS = 62
const SYM_END_GPU_RENDER_PASS = 63
const SYM_BIND_GPU_GRAPHICS_PIPELINE = 64
const SYM_BIND_GPU_VERTEX_BUFFERS = 65
const SYM_BIND_GPU_INDEX_BUFFER = 66
const SYM_BIND_GPU_VERTEX_SAMPLERS = 67
const SYM_BIND_GPU_FRAGMENT_SAMPLERS = 68
