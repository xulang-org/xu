const SYM_GPU_END = 50
const SYM_RENDER_END = 75
const SYM_COMPUTE_END = 83
const SYM_SURFACE_END = 89
const SYM_COUNT = 89

fn sym_name(i int) string {
    if i == SYM_SET_MAIN_READY { << "SDL_SetMainReady" }
    if i == SYM_IS_MAIN_THREAD { << "SDL_IsMainThread" }
    if i == SYM_INIT_SUBSYSTEM { << "SDL_InitSubSystem" }
    if i == SYM_QUIT_SUBSYSTEM { << "SDL_QuitSubSystem" }
    if i == SYM_GET_ERROR { << "SDL_GetError" }
    if i == SYM_CREATE_WINDOW { << "SDL_CreateWindow" }
    if i == SYM_DESTROY_WINDOW { << "SDL_DestroyWindow" }
    if i == SYM_GET_WINDOW_ID { << "SDL_GetWindowID" }
    if i == SYM_GET_WINDOW_FLAGS { << "SDL_GetWindowFlags" }
    if i == SYM_GET_WINDOW_SIZE { << "SDL_GetWindowSize" }
    if i == SYM_GET_WINDOW_SIZE_IN_PIXELS { << "SDL_GetWindowSizeInPixels" }
    if i == SYM_SET_WINDOW_SIZE { << "SDL_SetWindowSize" }
    if i == SYM_SHOW_WINDOW { << "SDL_ShowWindow" }
    if i == SYM_HIDE_WINDOW { << "SDL_HideWindow" }
    if i == SYM_MINIMIZE_WINDOW { << "SDL_MinimizeWindow" }
    if i == SYM_RESTORE_WINDOW { << "SDL_RestoreWindow" }
    if i == SYM_PUMP_EVENTS { << "SDL_PumpEvents" }
    if i == SYM_FILTER_EVENTS { << "SDL_FilterEvents" }
    if i == SYM_GET_WINDOW_FROM_EVENT { << "SDL_GetWindowFromEvent" }
    if i == SYM_START_TEXT_INPUT { << "SDL_StartTextInput" }
    if i == SYM_STOP_TEXT_INPUT { << "SDL_StopTextInput" }
    if i == SYM_TEXT_INPUT_ACTIVE { << "SDL_TextInputActive" }
    if i == SYM_SET_TEXT_INPUT_AREA { << "SDL_SetTextInputArea" }
    if i == SYM_SET_WINDOW_RELATIVE_MOUSE { << "SDL_SetWindowRelativeMouseMode" }
    if i == SYM_GET_WINDOW_RELATIVE_MOUSE { << "SDL_GetWindowRelativeMouseMode" }
    if i == SYM_SET_WINDOW_MOUSE_GRAB { << "SDL_SetWindowMouseGrab" }
    if i == SYM_GET_WINDOW_MOUSE_GRAB { << "SDL_GetWindowMouseGrab" }
    if i == SYM_CREATE_GPU_DEVICE { << "SDL_CreateGPUDevice" }
    if i == SYM_DESTROY_GPU_DEVICE { << "SDL_DestroyGPUDevice" }
    if i == SYM_GET_GPU_DEVICE_DRIVER { << "SDL_GetGPUDeviceDriver" }
    if i == SYM_GET_GPU_SHADER_FORMATS { << "SDL_GetGPUShaderFormats" }
    if i == SYM_CREATE_GPU_BUFFER { << "SDL_CreateGPUBuffer" }
    if i == SYM_RELEASE_GPU_BUFFER { << "SDL_ReleaseGPUBuffer" }
    if i == SYM_CREATE_GPU_TRANSFER_BUFFER { << "SDL_CreateGPUTransferBuffer" }
    if i == SYM_RELEASE_GPU_TRANSFER_BUFFER { << "SDL_ReleaseGPUTransferBuffer" }
    if i == SYM_MAP_GPU_TRANSFER_BUFFER { << "SDL_MapGPUTransferBuffer" }
    if i == SYM_UNMAP_GPU_TRANSFER_BUFFER { << "SDL_UnmapGPUTransferBuffer" }
    if i == SYM_ACQUIRE_GPU_COMMAND_BUFFER { << "SDL_AcquireGPUCommandBuffer" }
    if i == SYM_CANCEL_GPU_COMMAND_BUFFER { << "SDL_CancelGPUCommandBuffer" }
    if i == SYM_BEGIN_GPU_COPY_PASS { << "SDL_BeginGPUCopyPass" }
    if i == SYM_END_GPU_COPY_PASS { << "SDL_EndGPUCopyPass" }
    if i == SYM_UPLOAD_TO_GPU_BUFFER { << "SDL_UploadToGPUBuffer" }
    if i == SYM_COPY_GPU_BUFFER_TO_BUFFER { << "SDL_CopyGPUBufferToBuffer" }
    if i == SYM_DOWNLOAD_FROM_GPU_BUFFER { << "SDL_DownloadFromGPUBuffer" }
    if i == SYM_SUBMIT_GPU_COMMAND_BUFFER_AND_ACQUIRE_FENCE { << "SDL_SubmitGPUCommandBufferAndAcquireFence" }
    if i == SYM_QUERY_GPU_FENCE { << "SDL_QueryGPUFence" }
    if i == SYM_WAIT_FOR_GPU_FENCES { << "SDL_WaitForGPUFences" }
    if i == SYM_RELEASE_GPU_FENCE { << "SDL_ReleaseGPUFence" }
    if i == SYM_WAIT_FOR_GPU_IDLE { << "SDL_WaitForGPUIdle" }
    if i == SYM_SUBMIT_GPU_COMMAND_BUFFER { << "SDL_SubmitGPUCommandBuffer" }
    if i == SYM_CREATE_GPU_TEXTURE { << "SDL_CreateGPUTexture" }
    if i == SYM_RELEASE_GPU_TEXTURE { << "SDL_ReleaseGPUTexture" }
    if i == SYM_GPU_TEXTURE_SUPPORTS_FORMAT { << "SDL_GPUTextureSupportsFormat" }
    if i == SYM_CREATE_GPU_SAMPLER { << "SDL_CreateGPUSampler" }
    if i == SYM_RELEASE_GPU_SAMPLER { << "SDL_ReleaseGPUSampler" }
    if i == SYM_CREATE_GPU_SHADER { << "SDL_CreateGPUShader" }
    if i == SYM_RELEASE_GPU_SHADER { << "SDL_ReleaseGPUShader" }
    if i == SYM_CREATE_GPU_GRAPHICS_PIPELINE { << "SDL_CreateGPUGraphicsPipeline" }
    if i == SYM_RELEASE_GPU_GRAPHICS_PIPELINE { << "SDL_ReleaseGPUGraphicsPipeline" }
    if i == SYM_UPLOAD_TO_GPU_TEXTURE { << "SDL_UploadToGPUTexture" }
    if i == SYM_DOWNLOAD_FROM_GPU_TEXTURE { << "SDL_DownloadFromGPUTexture" }
    if i == SYM_GENERATE_MIPMAPS_FOR_GPU_TEXTURE { << "SDL_GenerateMipmapsForGPUTexture" }
    if i == SYM_BEGIN_GPU_RENDER_PASS { << "SDL_BeginGPURenderPass" }
    if i == SYM_END_GPU_RENDER_PASS { << "SDL_EndGPURenderPass" }
    if i == SYM_BIND_GPU_GRAPHICS_PIPELINE { << "SDL_BindGPUGraphicsPipeline" }
    if i == SYM_BIND_GPU_VERTEX_BUFFERS { << "SDL_BindGPUVertexBuffers" }
    if i == SYM_BIND_GPU_INDEX_BUFFER { << "SDL_BindGPUIndexBuffer" }
    if i == SYM_BIND_GPU_VERTEX_SAMPLERS { << "SDL_BindGPUVertexSamplers" }
    if i == SYM_BIND_GPU_FRAGMENT_SAMPLERS { << "SDL_BindGPUFragmentSamplers" }
    if i == SYM_PUSH_GPU_VERTEX_UNIFORM_DATA { << "SDL_PushGPUVertexUniformData" }
    if i == SYM_PUSH_GPU_FRAGMENT_UNIFORM_DATA { << "SDL_PushGPUFragmentUniformData" }
    if i == SYM_DRAW_GPU_PRIMITIVES { << "SDL_DrawGPUPrimitives" }
    if i == SYM_DRAW_GPU_INDEXED_PRIMITIVES { << "SDL_DrawGPUIndexedPrimitives" }
    if i == SYM_SET_GPU_VIEWPORT { << "SDL_SetGPUViewport" }
    if i == SYM_SET_GPU_SCISSOR { << "SDL_SetGPUScissor" }
    if i == SYM_CREATE_GPU_COMPUTE_PIPELINE { << "SDL_CreateGPUComputePipeline" }
    if i == SYM_RELEASE_GPU_COMPUTE_PIPELINE { << "SDL_ReleaseGPUComputePipeline" }
    if i == SYM_BEGIN_GPU_COMPUTE_PASS { << "SDL_BeginGPUComputePass" }
    if i == SYM_END_GPU_COMPUTE_PASS { << "SDL_EndGPUComputePass" }
    if i == SYM_BIND_GPU_COMPUTE_PIPELINE { << "SDL_BindGPUComputePipeline" }
    if i == SYM_BIND_GPU_COMPUTE_STORAGE_BUFFERS { << "SDL_BindGPUComputeStorageBuffers" }
    if i == SYM_PUSH_GPU_COMPUTE_UNIFORM_DATA { << "SDL_PushGPUComputeUniformData" }
    if i == SYM_DISPATCH_GPU_COMPUTE { << "SDL_DispatchGPUCompute" }
    if i == SYM_CLAIM_WINDOW_FOR_GPU_DEVICE { << "SDL_ClaimWindowForGPUDevice" }
    if i == SYM_RELEASE_WINDOW_FROM_GPU_DEVICE { << "SDL_ReleaseWindowFromGPUDevice" }
    if i == SYM_WINDOW_SUPPORTS_GPU_PRESENT_MODE { << "SDL_WindowSupportsGPUPresentMode" }
    if i == SYM_SET_GPU_SWAPCHAIN_PARAMETERS { << "SDL_SetGPUSwapchainParameters" }
    if i == SYM_GET_GPU_SWAPCHAIN_TEXTURE_FORMAT { << "SDL_GetGPUSwapchainTextureFormat" }
    if i == SYM_WAIT_AND_ACQUIRE_GPU_SWAPCHAIN_TEXTURE { << "SDL_WaitAndAcquireGPUSwapchainTexture" }
    << ""
}
