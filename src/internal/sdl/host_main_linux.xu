@internal/sdl
$linux

#ffi

extern "C" fn c_getpid() c_int = "getpid"
extern "C" fn c_gettid() c_int = "gettid"

fn host_is_main_thread() bool {
    unsafe {
        p := ensure_host_probed()
        if !ffi.is_null(p) {
            fn_ptr := ffi.read_ptr(p, OFF_PHONE_THREAD_FN)
            if !ffi.is_null(fn_ptr) { << sdl_call_i32_0(fn_ptr) != i32(0) }
        }
        << c_gettid() == c_getpid()
    }
}
