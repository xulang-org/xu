@internal/sdl
// Process-wide SDL loader: library handle, resolved symbols, error text,
// identity counter, and the window/device list heads. State lives in a
// calloc'd blob hung from #ffi process slot 0 (Xu has no package globals).

#ffi
#os

const SLOT_SDL = 0

// Blob layout (bytes).
const OFF_LIBRARY = 0
const OFF_LOADED = 8
const OFF_WINDOW_LOADED = 16
const OFF_INPUT_LOADED = 24
const OFF_NEXT_ID = 32
const OFF_WINDOWS = 40
const OFF_DEVICES = 48
const OFF_PHONE_PROBED = 56
const OFF_PHONE_LIB = 64
const OFF_PHONE_SDL_SYM = 72
const OFF_PHONE_THREAD_FN = 80
const OFF_CB_MODE_FN = 88
const OFF_CB_TAKE_FN = 96
const OFF_CB_POP_FN = 104
const OFF_ERROR = 112
const ERROR_CAP = 1024
const OFF_SYMS = 1136 // OFF_ERROR + ERROR_CAP
const BLOB_SIZE = 4096 // OFF_SYMS + SYM_COUNT * 8

extern "C" fn sdl_set_main_ready(fn_ptr c_ptr) = dynamic
extern "C" fn sdl_is_main_thread(fn_ptr c_ptr) u8 = dynamic
extern "C" fn sdl_init_subsystem(fn_ptr c_ptr, flags u32) u8 = dynamic
extern "C" fn sdl_quit_subsystem(fn_ptr c_ptr, flags u32) = dynamic
extern "C" fn sdl_get_error(fn_ptr c_ptr) c_ptr = dynamic
extern "C" fn sdl_phone_sym_lookup(fn_ptr c_ptr, name cstr) c_ptr = dynamic
extern "C" fn sdl_call_i32_0(fn_ptr c_ptr) c_int = dynamic

fn blob() c_ptr {
    unsafe {
        $p := ffi.process_get(SLOT_SDL)
        if !ffi.is_null(p) { << p }
        p = ffi.calloc(BLOB_SIZE)
        if ffi.is_null(p) { << ffi.null() }
        ffi.write_i64(p, OFF_NEXT_ID, 1)
        ffi.process_set(SLOT_SDL, p)
        << p
    }
}

fn fail(message string) int {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << -1 }
        $n := message.len
        if n >= ERROR_CAP { n = ERROR_CAP - 1 }
        for i in 0:n { ffi.write_u8(p, OFF_ERROR + i, u8(message[i])) }
        ffi.write_u8(p, OFF_ERROR + n, u8(0))
        // Clear the rest so error_len stops at the first NUL.
        for i in n + 1:ERROR_CAP { ffi.write_u8(p, OFF_ERROR + i, u8(0)) }
    }
    << -1
}

fn sdl_fail() int {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << -1 }
        fn_ptr := sym(SYM_GET_ERROR)
        if ffi.is_null(fn_ptr) { << fail("SDL_GetError unresolved") }
        msg := ffi.string_from(sdl_get_error(fn_ptr))
        << fail(msg)
    }
}

fn sym(i int) c_ptr {
    unsafe {
        p := blob()
        if ffi.is_null(p) || i < 0 || i >= SYM_COUNT { << ffi.null() }
        << ffi.read_ptr(p, OFF_SYMS + i * 8)
    }
}

fn set_sym(i int, v c_ptr) {
    unsafe {
        p := blob()
        if ffi.is_null(p) || i < 0 || i >= SYM_COUNT { << }
        ffi.write_ptr(p, OFF_SYMS + i * 8, v)
    }
}

pub fn error_len() int {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << 0 }
        $n := 0
        while n < ERROR_CAP {
            if ffi.read_u8(p, OFF_ERROR + n) == u8(0) { << n }
            n += 1
        }
        << ERROR_CAP
    }
}

pub fn error_byte(i int) int {
    unsafe {
        p := blob()
        if ffi.is_null(p) || i < 0 { << 0 }
        n := error_len()
        if i >= n { << 0 }
        << int(ffi.read_u8(p, OFF_ERROR + i))
    }
}

fn identifier() int {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << fail("SDL state allocation failed") }
        id := ffi.read_i64(p, OFF_NEXT_ID)
        if id < 1 { << fail("SDL resource identity space exhausted") }
        ffi.write_i64(p, OFF_NEXT_ID, id + 1)
        << id
    }
}

fn on_main() bool {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << false }
        if ffi.read_i64(p, OFF_LOADED) != 0 {
            fn_ptr := sym(SYM_IS_MAIN_THREAD)
            if ffi.is_null(fn_ptr) {
                fail("SDL operations require the application main thread")
                << false
            }
            if sdl_is_main_thread(fn_ptr) == u8(0) {
                fail("SDL operations require the application main thread")
                << false
            }
            << true
        }
    }
    if !host_is_main_thread() {
        fail("SDL operations require the application main thread")
        << false
    }
    << true
}

fn ensure_host_probed() c_ptr {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << ffi.null() }
        if ffi.read_i64(p, OFF_PHONE_PROBED) == 0 {
            ffi.write_i64(p, OFF_PHONE_PROBED, 1)
            $lib := ffi.null()
            if xu_target_os() == 0 { lib = c_ptr(0 - 2) }
            if xu_target_os() == 1 {
                s_probe := "xu_phone_game_on_main_thread"
                if ffi.is_null(ffi.dlsym(lib, &s_probe)) {
                    so := "libmain.so"
                    h := ffi.dlopen_local(&so)
                    if !ffi.is_null(h) { lib = h }
                }
            }
            ffi.write_ptr(p, OFF_PHONE_LIB, lib)
            s_sdl := "xu_phone_sdl_sym"
            f_sdl := ffi.dlsym(lib, &s_sdl)
            if !ffi.is_null(f_sdl) {
                test_sym := "SDL_CreateWindow"
                if !ffi.is_null(sdl_phone_sym_lookup(f_sdl, &test_sym)) {
                    ffi.write_ptr(p, OFF_PHONE_SDL_SYM, f_sdl)
                }
            }
            s_thr := "xu_phone_game_on_main_thread"
            s_cbm := "xu_phone_callback_mode"
            s_cbt := "xu_phone_callback_take"
            s_cbp := "xu_phone_callback_pop"
            ffi.write_ptr(p, OFF_PHONE_THREAD_FN, ffi.dlsym(lib, &s_thr))
            ffi.write_ptr(p, OFF_CB_MODE_FN, ffi.dlsym(lib, &s_cbm))
            ffi.write_ptr(p, OFF_CB_TAKE_FN, ffi.dlsym(lib, &s_cbt))
            ffi.write_ptr(p, OFF_CB_POP_FN, ffi.dlsym(lib, &s_cbp))
        }
        << p
    }
}

fn is_callback_mode() bool {
    unsafe {
        p := ensure_host_probed()
        if ffi.is_null(p) { << false }
        fn_ptr := ffi.read_ptr(p, OFF_CB_MODE_FN)
        if ffi.is_null(fn_ptr) { << false }
        << sdl_call_i32_0(fn_ptr) != i32(0)
    }
}

fn sdl_find_sym(name &string) c_ptr {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << ffi.null() }
        phone_fn := ffi.read_ptr(p, OFF_PHONE_SDL_SYM)
        if !ffi.is_null(phone_fn) {
            << sdl_phone_sym_lookup(phone_fn, name)
        }
        library := ffi.read_ptr(p, OFF_LIBRARY)
        if ffi.is_null(library) { << ffi.null() }
        << ffi.dlsym(library, name)
    }
}

fn ensure_sym(i int, err_prefix string) bool {
    unsafe {
        if !ffi.is_null(sym(i)) { << true }
        name := sym_name(i)
        f := sdl_find_sym(&name)
        if ffi.is_null(f) {
            fail(err_prefix + name)
            << false
        }
        set_sym(i, f)
        << true
    }
}

fn load_sym_range(from int, until int, err_prefix string) bool {
    for i in from:until {
        if !ensure_sym(i, err_prefix + "") { << false }
    }
    << true
}

fn load_sdl() bool {
    if !on_main() { << false }
    unsafe {
        p := ensure_host_probed()
        if ffi.is_null(p) {
            fail("SDL state allocation failed")
            << false
        }
        if ffi.read_i64(p, OFF_LOADED) != 0 { << true }
        phone_fn := ffi.read_ptr(p, OFF_PHONE_SDL_SYM)
        $library := ffi.null()
        if ffi.is_null(phone_fn) {
            library = open_sdl_library()
            if ffi.is_null(library) {
                fail("SDL 3 runtime unavailable; install SDL3 or set XU_SDL_LIBRARY")
                << false
            }
            ffi.write_ptr(p, OFF_LIBRARY, library)
        } else {
            ffi.write_ptr(p, OFF_LIBRARY, c_ptr(1))
        }
        if !load_sym_range(0, 5, "SDL 3 runtime is missing ") {
            if ffi.is_null(phone_fn) && !ffi.is_null(library) { ffi.dlclose(library) }
            ffi.write_ptr(p, OFF_LIBRARY, ffi.null())
            << false
        }
        sdl_set_main_ready(sym(SYM_SET_MAIN_READY))
        ffi.write_i64(p, OFF_LOADED, 1)
        << true
    }
}

fn open_sdl_library() c_ptr {
    unsafe {
        override := os.getenv("XU_SDL_LIBRARY")
        if override.len > 0 {
            << ffi.dlopen_local(&override)
        }
        os_code := xu_target_os()
        if os_code == 0 {
            names := ["libSDL3.dylib", "/opt/homebrew/lib/libSDL3.dylib", "/usr/local/lib/libSDL3.dylib"]
            for i in 0:names.len {
                n := names[i]
                h := ffi.dlopen_local(&n)
                if !ffi.is_null(h) { << h }
            }
        } else if os_code == 2 {
            win := "SDL3.dll"
            << ffi.dlopen_local(&win)
        } else {
            names := ["libSDL3.so.0", "libSDL3.so"]
            for i in 0:names.len {
                n := names[i]
                h := ffi.dlopen_local(&n)
                if !ffi.is_null(h) { << h }
            }
        }
        << ffi.null()
    }
}

fn load_window_syms() bool {
    if !load_sdl() { << false }
    unsafe {
        p := blob()
        if ffi.read_i64(p, OFF_WINDOW_LOADED) != 0 { << true }
        if !load_sym_range(5, 19, "SDL runtime is missing ") { << false }
        ffi.write_i64(p, OFF_WINDOW_LOADED, 1)
        << true
    }
}

fn load_input_syms() bool {
    if !load_window_syms() { << false }
    unsafe {
        p := blob()
        if ffi.read_i64(p, OFF_INPUT_LOADED) != 0 { << true }
        if !load_sym_range(19, SYM_INPUT_END, "SDL runtime is missing ") { << false }
        ffi.write_i64(p, OFF_INPUT_LOADED, 1)
        << true
    }
}

fn load_gpu_syms() bool {
    if !load_sdl() { << false }
    if !ffi.is_null(sym(SYM_CREATE_GPU_DEVICE)) { << true }
    << load_sym_range(SYM_CREATE_GPU_DEVICE, SYM_GPU_END, "SDL 3 GPU runtime is missing ")
}

fn load_range_syms(from int, until int, _label string) bool {
    if !ffi.is_null(sym(from)) { << true }
    if !load_gpu_syms() { << false }
    << load_sym_range(from, until, "SDL GPU runtime is missing ")
}

fn load_render_syms() bool {
    << load_range_syms(SYM_GPU_END, SYM_RENDER_END, "render") && load_range_syms(SYM_RENDER_EXT_START, SYM_RENDER_EXT_END, "render")
}
fn load_compute_syms() bool {
    << load_range_syms(SYM_RENDER_END, SYM_COMPUTE_END, "compute") && load_range_syms(SYM_COMPUTE_EXT_START, SYM_COMPUTE_EXT_END, "compute")
}
fn load_surface_syms() bool {
    if !ffi.is_null(sym(SYM_CLAIM_WINDOW_FOR_GPU_DEVICE)) { << true }
    if !load_gpu_syms() { << false }
    << load_sym_range(SYM_COMPUTE_END, SYM_SURFACE_END, "SDL runtime is missing ")
}

fn windows_head() c_ptr {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << ffi.null() }
        << ffi.read_ptr(p, OFF_WINDOWS)
    }
}

fn set_windows_head(h c_ptr) {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << }
        ffi.write_ptr(p, OFF_WINDOWS, h)
    }
}

fn devices_head() c_ptr {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << ffi.null() }
        << ffi.read_ptr(p, OFF_DEVICES)
    }
}

fn set_devices_head(h c_ptr) {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << }
        ffi.write_ptr(p, OFF_DEVICES, h)
    }
}

fn error_save() c_ptr {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << ffi.null() }
        buf := ffi.malloc(ERROR_CAP)
        if ffi.is_null(buf) { << ffi.null() }
        ffi.memcpy(buf, ffi.offset(p, OFF_ERROR), ERROR_CAP)
        << buf
    }
}

fn error_restore(saved c_ptr) {
    unsafe {
        if ffi.is_null(saved) { << }
        p := blob()
        if !ffi.is_null(p) { ffi.memcpy(ffi.offset(p, OFF_ERROR), saved, ERROR_CAP) }
        ffi.free(saved)
    }
}
