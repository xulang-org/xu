@internal/sdk

#os

// 终端进度渲染：交互终端把进度刷新在同一行，不再每 100ms 追加一行把
// 终端刷满；非交互环境（重定向到文件、CI 管道）不输出中间进度，调用方
// 自己的开始/结束日志仍然保留，日志既干净又不刷屏。
//
// 渲染保持无状态：每次进度回调都重画整行，各字段定宽，因此整行长度
// 恒定，刷新时不会残留上一轮的尾巴，也不需要跨调用保存行长度。

// 进度条固定 24 格。
const TERM_BAR_CELLS = 24
// 已下载、总量、百分比各占固定宽度，保证整行长度恒定。
const TERM_SIZE_WIDTH = 11
const TERM_PERCENT_WIDTH = 5

// stat 返回的 mode 是原始 st_mode。字符设备（终端）落在
// [0o20000, 0o40000)，管道是 0o10000，普通文件是 0o100000，
// 因此用范围比较即可区分，不需要位运算。
const TERM_CHAR_DEVICE_MIN = 8192
const TERM_CHAR_DEVICE_MAX = 16384

// stdout 是否连接终端。只有终端才原地刷新。
pub fn term_interactive() bool {
    // Windows 的 stdout 句柄不能直接写，用控制台设备在写入时探测。
    if xu_target_os() == 2 { << true }
    info := os.stat("/dev/stdout") or (err) { << false }
    if info.mode < TERM_CHAR_DEVICE_MIN { << false }
    << (info.mode < TERM_CHAR_DEVICE_MAX)
}

// 写原始字节到 stdout，不追加换行。终端渲染靠它原地覆盖同一行。
fn term_write_raw(data string) bool {
    if xu_target_os() == 2 {
        // Windows 的 fd 不是可写句柄，改用控制台设备写入。
        mut console := os.create("CONOUT$$") or (err) { << false }
        console.write(data) or (err) {
            console.close() or (err) { << true }
            << false
        }
        console.close() or (err) { << true }
        << true
    }
    os_fd_write(1, data) or (err) {
        << false
    }
    << true
}

// 左侧补空格到指定宽度。
fn term_pad_left(text &string, width int) string {
    mut out := ""
    mut i := text.len
    while i < width {
        out = " " + out
        i = i + 1
    }
    << out + text + ""
}

// 一行进度文本：标签 + 进度条 + 已下载/总量 + 百分比。
// 总量未知时显示占位符，字段宽度保持不变。
pub fn term_progress_text(label &string, received int, total int) string {
    mut percent_text := "??%"
    mut total_text := "?"
    mut filled := 0
    if total > 0 {
        mut percent := received * 100 / total
        if percent > 100 { percent = 100 }
        percent_text = str(percent) + "%"
        total_text = format_size(total)
        filled = percent * TERM_BAR_CELLS / 100
    }
    mut bar := ""
    mut i := 0
    while i < TERM_BAR_CELLS {
        if i < filled { bar = bar + "#" } else { bar = bar + "-" }
        i = i + 1
    }
    << label + ": [" + bar + "] " + term_pad_left(&format_size(received), TERM_SIZE_WIDTH) + " / " + term_pad_left(&total_text, TERM_SIZE_WIDTH) + " (" + term_pad_left(&percent_text, TERM_PERCENT_WIDTH) + ")"
}

// 原地刷新一行进度。非交互环境（重定向到文件、CI 管道）不输出中间进度，
// 调用方自己的开始/结束日志已经说明下载在进行。
pub fn term_progress(label &string, received int, total int) {
    if !term_interactive() { << }
    line := term_progress_text(label, received, total)
    term_write_raw("\r" + line)
}

// 结束进度行，把光标移到下一行，让后续日志另起一行。
pub fn term_progress_end() {
    if !term_interactive() { << }
    term_write_raw("\n")
}
