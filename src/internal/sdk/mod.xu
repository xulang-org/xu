@internal/sdk

#errors
#internal/semver
#net/http

// Release URLs must contain a canonical SemVer, never arbitrary path input.
pub fn release_version(version &string) string {
    canon := semver.canonical(version)
    if !semver.valid(&canon) { >> errors.new("invalid release version '" + version + "'") }
    << canon[1:canon.len] + ""
}

fn no_progress(received int, total int) {}

// Fetch a small release document without displaying progress.
pub fn get(raw_url string, timeout_ns int) string {
    << download(raw_url, timeout_ns, no_progress) or >>
}

// Fetch an SDK through verified HTTPS and redirects. Progress runs on this
// thread with total=-1 when unknown. The buffered response limit is 512 MiB.
pub fn download(raw_url string, timeout_ns int, report fn(int, int)) string {
    mut client := http.new_client()
    client.set_timeout(timeout_ns)
    client.max_response_bytes = 536870912
    client.set_download_progress(report)
    report(0, -1)
    response := client.get(raw_url) or >>
    if response.status_code != 200 { >> errors.new("HTTP " + str(response.status_code)) }
    << response.body + ""
}

pub fn format_size(bytes int) string {
    if bytes < 1024 { << str(bytes) + " B" }
    mut unit := 1024
    mut label := " KiB"
    if bytes >= 1048576 {
        unit = 1048576
        label = " MiB"
    }
    tenths := bytes * 10 / unit
    << str(tenths / 10) + "." + str(tenths % 10) + label
}
