@internal/sdk

#archive/tar
#archive/zip
#compress/gzip
#errors
#os
#path/filepath
#strings

// Release archives contain only directories and regular files. Reject links,
// absolute names and traversal before creating anything under the private stage.
fn entry_path(dest &string, name &string) string {
    if name.len == 0 || name[0] == 47 || name[0] == 92 {
        >> errors.new("unsafe archive path")
    }
    for i in 0:name.len {
        if name[i] == 0 || name[i] == 92 || name[i] == 58 {
            >> errors.new("unsafe archive path: " + name)
        }
    }
    parts := strings.split(name, "/")
    for i in 0:parts.len {
        if parts[i] == ".." { >> errors.new("unsafe archive path: " + name) }
    }
    clean := filepath.clean(name)
    if clean == "." { >> errors.new("empty archive path") }
    << dest + "/" + clean
}

fn write_entry(dest &string, name &string, body &string, directory bool, mode int) int {
    path := entry_path(dest, name) or >>
    if directory {
        os.mkdir_all(path) or >>
        << 0
    }
    parent := filepath.dir(&path)
    os.mkdir_all(parent) or >>
    os.write(path + "", body + "") or >>
    if xu_target_os() != 2 {
        // Strip special permission bits; directories remain writable until done.
        os.chmod(path, mode & 511) or >>
    }
    << 0
}

// Extract a tar.gz or Windows ZIP into a caller-owned private staging directory.
// The destination must not contain symlinks. Reject traversal, links and special
// entries, and propagate format/checksum/write failures before installation.
pub fn extract(data &string, dest &string, is_windows bool) int {
    if is_windows {
        // Validate the central-directory trailer before the local-entry reader.
        zip.comment(data) or >>
        mut reader := zip.new_reader(data)
        for count in 0:100000 {
            entry := reader.next() or (err) {
                if err.msg() == "EOF" { << 0 }
                >> err
            }
            name := entry.name + ""
            directory := strings.has_suffix(&name, "/")
            write_entry(dest, &name, &entry.body, directory, 420) or >>
        }
        >> errors.new("too many ZIP entries")
    }
    mut compressed := gzip.new_reader(data + "")
    plain := compressed.read_all() or >>
    mut reader := tar.new_reader(&plain)
    for count in 0:100000 {
        entry := reader.next() or (err) {
            if err.msg() == "EOF" { << 0 }
            >> err
        }
        if entry.typeflag != 0 && entry.typeflag != tar.TYPE_REG && entry.typeflag != tar.TYPE_DIR {
            >> errors.new("unsupported archive entry: " + entry.name)
        }
        write_entry(dest, &entry.name, &entry.body, entry.typeflag == tar.TYPE_DIR, entry.mode) or >>
    }
    >> errors.new("too many tar entries")
}
