@internal/dependency

#crypto/sha256
#os
#errors
#strconv

// Dependency digests are ordinary stdlib code, outside compiler mechanisms.
// Maximum recursive depth when hashing a dependency directory tree.
const MAX_TREE_DEPTH = 64

pub fn source_key(module &string, locator &string) string {
    << sha256.sum256("xu-source-v2\n" + strconv.itoa(module.len) + ":" + module + strconv.itoa(locator.len) + ":" + locator)
}

fn names(body string) []string {
    $out := []string{}
    $start := 0
    for i in 0:body.len {
        if body[i] == 10 {
            if i > start { out.push(body[start:i]) }
            start = i + 1
        }
    }
    if start < body.len { out.push(body[start:body.len]) }
    << out
}

fn less(a &string, b &string) bool {
    $n := a.len
    if b.len < n { n = b.len }
    for i in 0:n {
        if a[i] < b[i] { << true }
        if a[i] > b[i] { << false }
    }
    << a.len < b.len
}

fn sorted_names(body string) []string {
    $out := names(body)
    for i in 0:out.len {
        $j := i
        while j > 0 {
            left := out[j - 1]
            right := out[j]
            if !less(&right, &left) { <- }
            out[j - 1] = right + ""
            out[j] = left + ""
            j = j - 1
        }
    }
    << out
}

fn linked(path &string) bool {
    os.readlink(path + "") or (err) { << false }
    << true
}

fn record(root &string, rel string, depth int) string {
    if depth > MAX_TREE_DEPTH { >> errors.new("require: dependency tree too deep") }
    $p := root + ""
    if rel.len > 0 { p = root + "/" + rel }
    if linked(&p) { >> errors.new("require: symlink is not allowed in dependency content: " + p) }
    info := os.stat(p + "") or >>
    if info.is_dir {
        listing := os.listdir(p + "") or >>
        entries := sorted_names(listing)
        $out := "D" + strconv.itoa(rel.len) + ":" + rel + "\n"
        for i in 0:entries.len {
            nm := entries[i]
            if nm == "." || nm == ".." { -> }
            if rel.len == 0 && (nm == ".git" || nm == ".ok" || nm == "pkg.tgz" || nm == ".xu-deps.lck" || nm == ".xu-lock.lck") { -> }
            $child := nm + ""
            if rel.len > 0 { child = rel + "/" + nm }
            out = out + (record(root, child, depth + 1) or >>)
        }
        << out
    }
    body := os.read(p) or >>
    << "F" + strconv.itoa(rel.len) + ":" + rel + ":" + sha256.sum256(body) + "\n"
}

// Fixed framing authenticates node types, paths, content and tree membership.
pub fn tree_hash(root &string) string {
    bytes := record(root, "", 0) or >>
    << sha256.sum256("xu-tree-v1\n" + bytes)
}
