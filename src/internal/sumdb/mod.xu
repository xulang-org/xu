@internal/sumdb

#crypto/ed25519
#crypto/sha256
#encoding/base64
#encoding/hex
#errors
#unicode/utf8

// Wire formats follow golang.org/x/mod/sumdb/{note,tlog}. The record
// payload is Xu's sha256-tree-v1 checksum, not a Go module h1 checksum.
// Maximum complete signed SumDB note size in bytes.
const MAX_SIGNED_NOTE_BYTES = 16384
// Maximum SumDB record response size in bytes.
const MAX_RECORD_BYTES = 65536

pub struct Verifier {
    pub name string
    pub public_key string
    pub key_hash string
}

pub struct Tree {
    pub size int
    pub hash string
    pub note string
}

pub struct Record {
    pub id int
    pub text string
    pub note string
}

pub struct Roots {
    pub full string
    pub prefix string
}

fn rows(s &string) []string {
    mut out := []string{}
    mut start := 0
    for i in 0:s.len {
        if s[i] == 10 { out.push(s[start:i])
            start = i + 1 }
    }
    if start != s.len { >> errors.new("sumdb: unterminated text") }
    << out
}

pub fn number(s &string) int {
    if s.len == 0 || (s.len > 1 && s[0] == 48) { >> errors.new("sumdb: noncanonical number") }
    mut n := 0
    for i in 0:s.len {
        d := s[i] - 48
        if d < 0 || d > 9 || n > (1099511627776 - d) / 10 { >> errors.new("sumdb: number out of range") }
        n = n * 10 + d
    }
    << n
}

fn decoded(s &string) string {
    out := base64.decode_string(s + "") or (err) { >> errors.new("sumdb: " + err.msg()) }
    if base64.encode_to_string(out + "") != s + "" { >> errors.new("sumdb: noncanonical base64") }
    << out
}

pub fn cache_identity(encoded &string) string {
    << sha256.sum256("xu-sumdb-v1\n" + encoded)
}

pub fn verifier(s &string) Verifier {
    mut first := -1
    mut second := -1
    for i in 0:s.len {
        if s[i] == 43 {
            if first < 0 { first = i }
            else if second < 0 { second = i
                <- }
        }
    }
    if first <= 0 || second != first + 9 { >> errors.new("sumdb: malformed verifier key") }
    name := s[0:first]
    for i in 0:name.len {
        if name[i] <= 32 || name[i] >= 127 { >> errors.new("sumdb: invalid verifier name") }
    }
    hash16 := s[first + 1:second]
    encoded := s[second + 1:s.len]
    key := decoded(&encoded) or >>
    if key.len != 33 || key[0] != 1 { >> errors.new("sumdb: expected Ed25519 verifier key") }
    hash := sha256.sum256_bytes(name + "\n" + key)
    key_hash := hash[0:4]
    if hex.encode_to_string(key_hash + "") != hash16 { >> errors.new("sumdb: verifier key hash mismatch") }
    << Verifier{name: name + "", public_key: key[1:33], key_hash: key_hash + ""}
}

pub fn checkpoint(msg &string, v &Verifier) Tree {
    if msg.len == 0 || msg.len > MAX_SIGNED_NOTE_BYTES || !utf8.valid(msg) { >> errors.new("sumdb: malformed signed note") }
    mut split := -1
    for i in 0:msg.len {
        b := msg[i] & 255
        if b < 32 && b != 10 { >> errors.new("sumdb: control byte in signed note") }
        if i + 1 < msg.len && b == 10 && msg[i + 1] == 10 { split = i }
    }
    if split < 0 { >> errors.new("sumdb: missing note signature") }
    text := msg[0:split + 1]
    sigs := msg[split + 2:msg.len]
    lines := rows(&sigs) or >>
    if lines.len == 0 || lines.len > 16 { >> errors.new("sumdb: invalid signature count") }
    mut verified := false
    for i in 0:lines.len {
        line := lines[i]
        if line.len < 5 || line[0:4] != "— " { >> errors.new("sumdb: malformed note signature") }
        mut space := -1
        for j in 4:line.len { if line[j] == 32 { space = j
            <- } }
        if space < 5 { >> errors.new("sumdb: malformed signature name") }
        name := line[4:space]
        encoded := line[space + 1:line.len]
        raw := decoded(&encoded) or >>
        if raw.len != 68 { >> errors.new("sumdb: malformed Ed25519 signature") }
        if name != v.name || raw[0:4] != v.key_hash { -> }
        sig := raw[4:68]
        if !ed25519.verify(&v.public_key, &text, &sig) { >> errors.new("sumdb: invalid checkpoint signature") }
        verified = true
    }
    if !verified { >> errors.new("sumdb: checkpoint has no trusted signature") }
    fields := rows(&text) or >>
    if fields.len != 3 || fields[0] != "go.sum database tree" { >> errors.new("sumdb: malformed tree description") }
    size_text := fields[1]
    size := number(&size_text) or >>
    hash_text := fields[2]
    hash := decoded(&hash_text) or >>
    if size <= 0 || hash.len != 32 { >> errors.new("sumdb: invalid tree size or hash") }
    << Tree{size: size, hash: hash + "", note: msg + ""}
}

pub fn record(msg &string) Record {
    if msg.len == 0 || msg.len > MAX_RECORD_BYTES { >> errors.new("sumdb: invalid record size") }
    mut first := -1
    mut end := -1
    for i in 0:msg.len {
        if msg[i] == 10 {
            if first < 0 { first = i }
            if i + 1 < msg.len && msg[i + 1] == 10 { end = i
                <- }
        }
    }
    if first < 0 || end <= first { >> errors.new("sumdb: malformed lookup record") }
    id_text := msg[0:first]
    id := number(&id_text) or >>
    << Record{id: id, text: msg[first + 1:end + 1], note: msg[end + 2:msg.len]}
}

pub fn checksum(text &string, module &string, version &string) string {
    lines := rows(text) or >>
    if lines.len != 1 { >> errors.new("sumdb: expected one Xu checksum record") }
    prefix := module + " " + version + " sha256-tree-v1:"
    line := lines[0]
    if line.len != prefix.len + 64 || line[0:prefix.len] != prefix { >> errors.new("sumdb: checksum record identity mismatch") }
    value := line[prefix.len:line.len]
    for i in 0:value.len {
        b := value[i]
        if !(b >= 48 && b <= 57) && !(b >= 97 && b <= 102) { >> errors.new("sumdb: malformed tree checksum") }
    }
    << value
}

pub fn leaf(text &string) string {
    mut framed := ""
    framed.push_byte(0)
    << sha256.sum256_bytes(framed + text)
}

pub fn combine(a &string, b &string) string {
    mut framed := ""
    framed.push_byte(1)
    << sha256.sum256_bytes(framed + a + b)
}

pub fn split(n int) int {
    mut k := 1
    while k <= (n - 1) / 2 { k = k * 2 }
    << k
}

pub fn fold(hashes &string) string {
    if hashes.len == 32 { << hashes + "" }
    if hashes.len < 32 || hashes.len % 32 != 0 { >> errors.new("sumdb: invalid tile hash range") }
    count := hashes.len / 32
    k := split(count)
    if k * 2 != count { >> errors.new("sumdb: tile subtree must be a power of two") }
    left := hashes[0:k * 32]
    right := hashes[k * 32:hashes.len]
    a := fold(&left) or >>
    b := fold(&right) or >>
    << combine(&a, &b)
}
