@internal/semver

fn numeric(s &string) bool {
    if s.len == 0 { << false }
    for i in 0:s.len { if s[i] < 48 || s[i] > 57 { << false } }
    << true
}

// Canonical module versions omit build metadata. Compare numeric components
// by digit count, avoiding overflow for arbitrarily large SemVer integers.
pub fn valid(s &string) bool {
    if s.len < 6 || s[0] != 118 { << false }
    $start := 1
    $parts := 0
    $pre := false
    for i in 1:s.len + 1 {
        if i == s.len || s[i] == 46 || (!pre && s[i] == 45) {
            part := s[start:i]
            if part.len == 0 { << false }
            if !pre {
                if !numeric(&part) || (part.len > 1 && part[0] == 48) { << false }
                parts += 1
                if parts > 3 { << false }
                if i < s.len && s[i] == 45 {
                    if parts != 3 { << false }
                    pre = true
                }
            } else {
                if numeric(&part) && part.len > 1 && part[0] == 48 { << false }
            }
            start = i + 1
        } else {
            b := s[i]
            if !pre && (b < 48 || b > 57) { << false }
            if pre && !(b >= 48 && b <= 57) && !(b >= 65 && b <= 90) && !(b >= 97 && b <= 122) && b != 45 { << false }
        }
    }
    << parts == 3
}

pub fn canonical(s &string) string {
    if s.len > 0 && s[0] == 118 { << s + "" }
    << "v" + s
}

fn lexical(a &string, b &string) int {
    $n := a.len
    if b.len < n { n = b.len }
    for i in 0:n {
        if a[i] < b[i] { << -1 }
        if a[i] > b[i] { << 1 }
    }
    if a.len < b.len { << -1 }
    if a.len > b.len { << 1 }
    << 0
}

fn number_compare(a &string, b &string) int {
    if a.len < b.len { << -1 }
    if a.len > b.len { << 1 }
    << lexical(a, b)
}

pub fn compare(a &string, b &string) int {
    $ai := 1
    $bi := 1
    for part in 0:3 {
        $ae := ai
        $be := bi
        while ae < a.len && a[ae] != 46 && a[ae] != 45 { ae += 1 }
        while be < b.len && b[be] != 46 && b[be] != 45 { be += 1 }
        av := a[ai:ae]
        bv := b[bi:be]
        cmp := number_compare(&av, &bv)
        if cmp != 0 { << cmp }
        ai = ae + 1
        bi = be + 1
    }
    if ai > a.len && bi > b.len { << 0 }
    if ai > a.len { << 1 }
    if bi > b.len { << -1 }
    while ai <= a.len && bi <= b.len {
        $ae := ai
        $be := bi
        while ae < a.len && a[ae] != 46 { ae += 1 }
        while be < b.len && b[be] != 46 { be += 1 }
        av := a[ai:ae]
        bv := b[bi:be]
        an := numeric(&av)
        bn := numeric(&bv)
        if an && !bn { << -1 }
        if !an && bn { << 1 }
        $cmp := lexical(&av, &bv)
        if an && bn { cmp = number_compare(&av, &bv) }
        if cmp != 0 { << cmp }
        ai = ae + 1
        bi = be + 1
    }
    if ai <= a.len { << 1 }
    if bi <= b.len { << -1 }
    << 0
}
