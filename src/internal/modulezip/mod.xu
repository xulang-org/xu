@internal/modulezip

#errors
#os
#compress/flate
#hash/crc32
#internal/modulepath

// Maximum module ZIP entry path length in bytes.
const MAX_PATH_BYTES = 1024
// Fixed end-of-central-directory record length, excluding its comment.
const EOCD_HEADER_BYTES = 22
// Fixed central-directory entry length, excluding variable fields.
const CENTRAL_HEADER_BYTES = 46
// Fixed local-file header length, excluding its name and extra fields.
const LOCAL_HEADER_BYTES = 30

const SIZE_LIMIT = 67108864

fn zip_u16(s &string, i int) int { << (s[i] & 255) | ((s[i + 1] & 255) << 8) }
fn zip_u32(s &string, i int) int { << zip_u16(s, i) | (zip_u16(s, i + 2) << 16) }

fn lower(s &string) string {
    mut out := ""
    for i in 0:s.len {
        mut b := s[i]
        if b >= 65 && b <= 90 { b += 32 }
        out = out + string_from_byte(b)
    }
    << out
}

fn file_path(s &string) bool {
    mut start := 0
    for i in 0:s.len + 1 {
        if i == s.len || s[i] == 47 {
            part := s[start:i]
            if part.len == 0 || part == "." || part == ".." || part == ".git" || part == "vendor" || part[part.len - 1] == 46 || part[part.len - 1] == 32 { << false }
            // Reuse the portable reserved-name check, including DOS aliases.
            mut ordinary := part + ""
            if ordinary[0] == 46 { ordinary = "x" + ordinary }
            mut simple := ""
            for j in 0:ordinary.len {
                b := ordinary[j]
                if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 46 || b == 126 { simple = simple + string_from_byte(b) }
                else { simple = simple + "_" }
            }
            portable := "x/" + simple
            if !modulepath.valid_path(&portable) { << false }
            start = i + 1
        } else {
            b := s[i]
            if b < 32 || b > 126 || b == 58 || b == 92 || b == 34 || b == 60 || b == 62 || b == 124 || b == 42 || b == 63 { << false }
        }
    }
    << true
}

fn mkdirs(path &string) int {
    for i in 1:path.len {
        if path[i] == 47 {
            p := path[0:i]
            os.stat(p + "") or (err) { os.mkdir(p + "") or >>
                -> }
        }
    }
    << 0
}

// Central-directory sizes support ZIP data descriptors. Extraction accepts
// only portable ASCII names and regular files, with a bounded total output.
pub fn extract(data &string, dest &string, module &string, version &string) int {
    if data.len < EOCD_HEADER_BYTES || data.len > SIZE_LIMIT { >> errors.new("require: invalid or oversized module ZIP") }
    mut eocd := data.len - EOCD_HEADER_BYTES
    mut found := false
    mut floor := data.len - 65557
    if floor < 0 { floor = 0 }
    while eocd >= floor {
        if zip_u32(data, eocd) == 101010256 && eocd + EOCD_HEADER_BYTES + zip_u16(data, eocd + 20) == data.len { found = true
            <- }
        eocd -= 1
    }
    if !found || zip_u16(data, eocd + 4) != 0 || zip_u16(data, eocd + 6) != 0 { >> errors.new("require: unsupported module ZIP") }
    count := zip_u16(data, eocd + 10)
    if count == 0 || count > 10000 || count != zip_u16(data, eocd + 8) { >> errors.new("require: invalid module ZIP entries") }
    mut pos := zip_u32(data, eocd + 16)
    if pos + zip_u32(data, eocd + 12) != eocd { >> errors.new("require: invalid module ZIP directory") }
    prefix := module + "@" + version + "/"
    mut seen := []string{}
    mut spellings := []string{}
    mut kinds := []int{}
    mut total := 0
    for i in 0:count {
        if pos < 0 || pos + CENTRAL_HEADER_BYTES > eocd || zip_u32(data, pos) != 33639248 { >> errors.new("require: invalid module ZIP directory entry") }
        flags := zip_u16(data, pos + 8)
        method := zip_u16(data, pos + 10)
        crc := zip_u32(data, pos + 16)
        csize := zip_u32(data, pos + 20)
        usize := zip_u32(data, pos + 24)
        nlen := zip_u16(data, pos + 28)
        extra := zip_u16(data, pos + 30)
        comment := zip_u16(data, pos + 32)
        mode := (zip_u32(data, pos + 38) >> 16) & 61440
        off := zip_u32(data, pos + 42)
        if csize < 0 || usize < 0 || off < 0 || (flags & 1) != 0 || (method != 0 && method != 8) || zip_u16(data, pos + 34) != 0 || (mode != 0 && mode != 32768 && mode != 16384) {
            >> errors.new("require: ZIP links, special files and encryption are not allowed")
        }
        if nlen == 0 || pos + CENTRAL_HEADER_BYTES + nlen + extra + comment > eocd { >> errors.new("require: invalid module ZIP name") }
        name := data[pos + CENTRAL_HEADER_BYTES:pos + CENTRAL_HEADER_BYTES + nlen]
        pos += CENTRAL_HEADER_BYTES + nlen + extra + comment
        if name == prefix && usize == 0 { -> }
        if name.len <= prefix.len || name[0:prefix.len] != prefix { >> errors.new("require: wrong module ZIP prefix") }
        mut rel := name[prefix.len:name.len]
        directory := rel[rel.len - 1] == 47
        if directory { rel = rel[0:rel.len - 1] }
        if rel.len > MAX_PATH_BYTES || !file_path(&rel) { >> errors.new("require: unsafe module ZIP path") }
        if rel == ".ok" || rel == "pkg.tgz" || rel == "xu.lock" { >> errors.new("require: reserved module ZIP path") }
        // Check every ancestor as well as the leaf: A/x and a/y collide on
        // case-insensitive filesystems even though their full paths differ.
        for end in 0:rel.len + 1 {
            if end != rel.len && rel[end] != 47 { -> }
            part := rel[0:end]
            folded := lower(&part)
            mut kind := 1
            if end == rel.len && !directory { kind = 2 }
            mut prior := -1
            for j in 0:seen.len { if seen[j] == folded { prior = j
                <- } }
            if prior >= 0 {
                if spellings[prior] != part || kinds[prior] != kind || kind == 2 { >> errors.new("require: module ZIP path collision") }
            } else {
                seen.push(folded)
                spellings.push(part + "")
                kinds.push(kind)
            }
        }
        if off < 0 || off + LOCAL_HEADER_BYTES > eocd || zip_u32(data, off) != 67324752 { >> errors.new("require: invalid module ZIP local header") }
        ln := zip_u16(data, off + 26)
        le := zip_u16(data, off + 28)
        start := off + LOCAL_HEADER_BYTES + ln + le
        if start > eocd || start + csize > eocd || ln != name.len || data[off + LOCAL_HEADER_BYTES:off + LOCAL_HEADER_BYTES + ln] != name || zip_u16(data, off + 8) != method || zip_u16(data, off + 6) != flags { >> errors.new("require: inconsistent module ZIP local header") }
        if usize > SIZE_LIMIT || total + usize > SIZE_LIMIT { >> errors.new("require: module ZIP exceeds output limit") }
        total += usize
        if directory { if usize != 0 { >> errors.new("require: nonempty ZIP directory") }
            -> }
        payload := data[start:start + csize]
        mut body := payload + ""
        if method == 8 { body = flate.inflate_limit(&payload, usize + 1) or >> }
        if body.len != usize || crc32.checksum_ieee(&body) != crc { >> errors.new("require: module ZIP checksum mismatch") }
        path := dest + "/" + rel
        mkdirs(&path) or >>
        os.write(path, body) or >>
    }
    if pos != eocd { >> errors.new("require: trailing module ZIP directory data") }
    << total
}
