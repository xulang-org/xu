@internal/toolpath

#errors
#os
#path/filepath
#os/exec

// Resolve links before '..', including links in a not-yet-created prefix.
pub fn real_path(path &string) string {
    $pending := filepath.to_slash(path)
    if !filepath.is_abs(&pending) { pending = os.getwd() + "/" + pending }
    $done := ""
    $start := 0
    $links := 0
    if pending.len >= 2 && pending[1] == 58 {
        done = pending[0:2] + ""
        start = 2
    }
    while start < pending.len {
        if pending[start] == 47 {
            if done.len == 0 { done = "/" }
            start = start + 1
            ->
        }
        $end := start
        while end < pending.len && pending[end] != 47 { end = end + 1 }
        part := pending[start:end] + ""
        start = end
        if part == "." { -> }
        if part == ".." {
            done = filepath.dir(&done)
            ->
        }
        next := filepath.join([done + "", part])
        link := os.readlink(next + "") or (err) {
            done = next + ""
            ->
        }
        links = links + 1
        if links > 40 { >> errors.new("too many path symlinks") }
        rest := pending[start:pending.len] + ""
        if filepath.is_abs(&link) { pending = link + rest }
        else { pending = filepath.join([done + "", link]) + rest }
        done = ""
        start = 0
        if pending.len >= 2 && pending[1] == 58 {
            done = pending[0:2] + ""
            start = 2
        }
    }
    << done
}

fn has_ui_host(root &string) bool {
    host := os.stat(root + "/src/ui/host/macos_host.swift") or (err) { << false }
    abi := os.stat(root + "/src/ui/host/xu_content_abi.h") or (err) { << false }
    << !host.is_dir && !abi.is_dir
}
fn find_ui_host(start &string) string {
    $current := start + ""
    for _ in 0:12 {
        if has_ui_host(&current) { << current }
        parent := filepath.dir(&current)
        if parent.len == 0 || parent == current { << "" }
        current = parent
    }
    << ""
}
// Sibling tools follow the invoked executable, including PATH and symlink use.
pub fn sibling(name &string) string {
    argv := os.argv()
    if argv.len == 0 { << "" }
    resolved := exec.look_path(argv[0] + "") or (err) { << "" }
    actual := real_path(&resolved) or >>
    $filename := name + ""
    if xu_target_os() == 2 { filename = filename + ".exe" }
    candidate := filepath.join([filepath.dir(&actual), filename])
    info := os.stat(candidate + "") or (err) { << "" }
    if info.is_dir { << "" }
    << candidate
}
fn executable_ui_root() string {
    argv := os.argv()
    if argv.len == 0 { << "" }
    resolved := exec.look_path(argv[0] + "") or (err) { << "" }
    actual := real_path(&resolved) or >>
    directory := filepath.dir(&actual)
    << find_ui_host(&directory)
}
// Installed tools belong to their own SDK even when the shell still points at
// another checkout. Detached development tools retain the explicit/CWD fallback.
pub fn ui_root() string {
    root := executable_ui_root() or >>
    if root.len > 0 { << root }
    configured := os.getenv("XU_ROOT")
    if configured.len > 0 && has_ui_host(&configured) { << real_path(&configured) or >> }
    current := os.getwd()
    << find_ui_host(&current)
}
