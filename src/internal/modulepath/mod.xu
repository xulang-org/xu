@internal/modulepath

// Package identities preserve slash separators and domain punctuation.
pub fn is_external(id &string) bool {
    for i in 0:id.len {
        if id[i] == 47 { << false }
        if id[i] == 46 { << true }
    }
    << false
}

fn ascii_lower(b int) int {
    if b >= 65 && b <= 90 { << b + 32 }
    << b
}

fn reserved_element(s &string) bool {
    $base := ""
    for i in 0:s.len {
        if s[i] == 46 { <- }
        base = base + string_from_byte(ascii_lower(s[i]))
    }
    if base == "con" || base == "prn" || base == "aux" || base == "nul" { << true }
    if base.len == 4 {
        prefix := base[0:3]
        if (prefix == "com" || prefix == "lpt") && base[3] >= 49 && base[3] <= 57 { << true }
    }
    $tilde := -1
    for i in 0:base.len {
        if base[i] == 126 { tilde = i }
    }
    if tilde >= 0 && tilde + 1 < base.len {
        $numeric := true
        for i in tilde + 1:base.len {
            if base[i] < 48 || base[i] > 57 { numeric = false }
        }
        if numeric { << true }
    }
    << false
}

// Portable Go-style lexical path rules, with a lowercase DNS authority.
pub fn valid_path(s &string) bool {
    if s.len == 0 { << false }
    $start := 0
    $first := true
    for i in 0:s.len + 1 {
        if i == s.len || s[i] == 47 {
            if i == start { << false }
            elem := s[start:i]
            if elem[0] == 46 || elem[elem.len - 1] == 46 || reserved_element(&elem) { << false }
            if first && is_external(&elem) {
                $dots := 0
                $label_start := true
                $previous := 0
                for j in 0:elem.len {
                    b := elem[j]
                    if b == 46 {
                        if label_start || previous == 45 { << false }
                        dots += 1
                        label_start = true
                    } else {
                        if !(b >= 97 && b <= 122) && !(b >= 48 && b <= 57) && b != 45 { << false }
                        if label_start && b == 45 { << false }
                        label_start = false
                    }
                    previous = b
                }
                if dots == 0 || previous == 45 { << false }
            }
            first = false
            start = i + 1
        } else {
            b := s[i]
            if !(b >= 65 && b <= 90) && !(b >= 97 && b <= 122) && !(b >= 48 && b <= 57) && b != 45 && b != 46 && b != 95 && b != 126 { << false }
        }
    }
    << true
}

fn numeric_suffix(s &string) bool {
    if s.len == 0 { << false }
    for i in 0:s.len {
        if !(s[i] >= 48 && s[i] <= 57) && s[i] != 46 { << false }
    }
    << true
}

fn starts(s &string, prefix string) bool {
    if s.len < prefix.len { << false }
    for i in 0:prefix.len {
        if s[i] != prefix[i] { << false }
    }
    << true
}

// A numeric-looking final vN component must describe major >= 2.
pub fn valid_module(s &string) bool {
    if !valid_path(s) { << false }
    if starts(s, "gopkg.in/") {
        $dot := -1
        for i in 0:s.len {
            if s[i] == 46 { dot = i }
        }
        if dot < 9 || dot + 2 >= s.len || s[dot + 1] != 118 { << false }
        major := s[dot + 2:s.len]
        if !numeric_suffix(&major) || (major.len > 1 && major[0] == 48) { << false }
        for i in 0:major.len { if major[i] == 46 { << false } }
        << true
    }
    $slash := -1
    for i in 0:s.len { if s[i] == 47 { slash = i } }
    if slash >= 0 && slash + 2 < s.len && s[slash + 1] == 118 {
        suffix := s[slash + 2:s.len]
        if numeric_suffix(&suffix) {
            if suffix[0] == 48 || suffix == "1" { << false }
            for i in 0:suffix.len { if suffix[i] == 46 { << false } }
        }
    }
    << true
}

pub fn version_matches(s &string, version &string) bool {
    $end := 0
    for i in 0:version.len {
        if version[i] == 46 { end = i
            <- }
    }
    if end == 0 { << false }
    major := version[0:end]
    $last := 0
    for i in 0:s.len { if s[i] == 47 { last = i + 1 } }
    tail := s[last:s.len]
    if starts(s, "gopkg.in/") {
        want := ".v" + major
        if s.len < want.len { << false }
        << s[s.len - want.len:s.len] == want
    }
    if major == "0" || major == "1" {
        if tail.len > 1 && tail[0] == 118 {
            numeric := tail[1:tail.len]
            if numeric_suffix(&numeric) { << false }
        }
        << true
    }
    << tail == "v" + major
}

pub fn identity(path &string) string { << path + "" }

// Escape uppercase letters for case-insensitive cache/vendor filesystems.
pub fn storage_path(id &string) string {
    $out := ""
    for i in 0:id.len {
        b := id[i]
        if b >= 65 && b <= 90 { out = out + "!" + string_from_byte(b + 32) }
        else { out = out + string_from_byte(b) }
    }
    << out
}

// '.' cannot occur in legacy mangled IDs. The byte encoding is injective.
pub fn symbol(id &string) string {
    digits := "0123456789abcdef"
    $out := "path."
    for i in 0:id.len {
        b := id[i]
        out = out + string_from_byte(digits[b / 16]) + string_from_byte(digits[b % 16])
    }
    << out
}
