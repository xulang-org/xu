pub struct SearchResult {
    pub index int
    pub found bool
}

pub fn binary_search_ints(xs &[]int, v int) SearchResult {
    n := xs.len
    mut lo := 0
    mut hi := n
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        if xs[mid] < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    mut found := false
    if lo < n {
        if xs[lo] == v {
            found = true
        }
    }
    << SearchResult{index: lo, found: found}
}

pub fn binary_search_strs(xs &[]string, v string) SearchResult {
    n := xs.len
    mut lo := 0
    mut hi := n
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        left := xs[mid]
        if str_cmp(&left, &v) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    mut found := false
    if lo < n {
        if xs[lo] == v {
            found = true
        }
    }
    << SearchResult{index: lo, found: found}
}

pub fn binary_search_f64s(xs &[]f64, v f64) SearchResult {
    n := xs.len
    mut lo := 0
    mut hi := n
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        if xs[mid] < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    mut found := false
    if lo < n {
        if xs[lo] == v {
            found = true
        }
    }
    << SearchResult{index: lo, found: found}
}

pub fn replace_ints(xs &[]int, i int, j int, add &[]int) []int {
    mut lo := i
    mut hi := j
    if lo < 0 {
        lo = 0
    }
    if hi > xs.len {
        hi = xs.len
    }
    if hi < lo {
        hi = lo
    }
    mut out := []int{}
    mut k := 0
    while k < lo {
        out.push(xs[k])
        k = k + 1
    }
    k = 0
    while k < add.len {
        out.push(add[k])
        k = k + 1
    }
    k = hi
    while k < xs.len {
        out.push(xs[k])
        k = k + 1
    }
    << out
}

pub fn replace_strs(xs &[]string, i int, j int, add &[]string) []string {
    mut lo := i
    mut hi := j
    if lo < 0 {
        lo = 0
    }
    if hi > xs.len {
        hi = xs.len
    }
    if hi < lo {
        hi = lo
    }
    mut out := []string{}
    mut k := 0
    while k < lo {
        out.push(xs[k] + "")
        k = k + 1
    }
    k = 0
    while k < add.len {
        out.push(add[k] + "")
        k = k + 1
    }
    k = hi
    while k < xs.len {
        out.push(xs[k] + "")
        k = k + 1
    }
    << out
}

pub fn concat_ints(a &[]int, b &[]int) []int {
    mut out := []int{}
    mut i := 0
    while i < a.len {
        out.push(a[i])
        i = i + 1
    }
    i = 0
    while i < b.len {
        out.push(b[i])
        i = i + 1
    }
    << out
}

pub fn repeat_ints(xs &[]int, n int) []int {
    mut out := []int{}
    if n < 0 {
        >> errors.new("slices: negative Repeat count")
    }
    mut k := 0
    while k < n {
        mut i := 0
        while i < xs.len {
            out.push(xs[i])
            i = i + 1
        }
        k = k + 1
    }
    << out
}

pub fn repeat_strs(xs &[]string, n int) []string {
    mut out := []string{}
    if n < 0 {
        >> errors.new("slices: negative Repeat count")
    }
    mut k := 0
    while k < n {
        mut i := 0
        while i < xs.len {
            out.push(xs[i] + "")
            i = i + 1
        }
        k = k + 1
    }
    << out
}

pub fn index_func_ints(xs &[]int, f fn(int) bool) int {
    mut i := 0
    while i < xs.len {
        if f(xs[i]) {
            << i
        }
        i = i + 1
    }
    << 0 - 1
}

pub fn contains_func_ints(xs &[]int, f fn(int) bool) bool {
    << index_func_ints(xs, f) >= 0
}

pub fn index_func_strs(xs &[]string, f fn(string) bool) int {
    mut i := 0
    while i < xs.len {
        cur := xs[i] + ""
        if f(cur) {
            << i
        }
        i = i + 1
    }
    << 0 - 1
}

pub fn concat_strs(a &[]string, b &[]string) []string {
    mut out := []string{}
    mut i := 0
    while i < a.len {
        out.push(a[i] + "")
        i = i + 1
    }
    i = 0
    while i < b.len {
        out.push(b[i] + "")
        i = i + 1
    }
    << out
}

// Concrete SortFunc stand-ins. Generic `sort_func#T` wrapping
// `sort.slice_func` panics the frozen primer (xuhir index 263) and
// would fail every oracle fixture that imports this package.
pub fn sort_ints_func(a &mut []int, less fn(int, int) bool) {
    n := a.len
    mut i := 1
    while i < n {
        v := a[i]
        mut j := i
        while j > 0 {
            if !less(v, a[j - 1]) {
                <-
            }
            a[j] = a[j - 1]
            j = j - 1
        }
        a[j] = v
        i = i + 1
    }
}

pub fn sort_strs_func(a &mut []string, less fn(string, string) bool) {
    n := a.len
    mut i := 1
    while i < n {
        v := a[i] + ""
        mut j := i
        while j > 0 {
            prev := a[j - 1] + ""
            lhs := v + ""
            rhs := prev + ""
            if !less(lhs, rhs) {
                <-
            }
            a[j] = prev
            j = j - 1
        }
        a[j] = v
        i = i + 1
    }
}

pub fn last_index_func_ints(xs &[]int, f fn(int) bool) int {
    mut i := xs.len - 1
    while i >= 0 {
        if f(xs[i]) {
            << i
        }
        i = i - 1
    }
    << 0 - 1
}

pub fn last_index_func_strs(xs &[]string, f fn(string) bool) int {
    mut i := xs.len - 1
    while i >= 0 {
        cur := xs[i] + ""
        if f(cur) {
            << i
        }
        i = i - 1
    }
    << 0 - 1
}

pub fn min_str(xs &[]string) string {
    if xs.len == 0 {
        >> errors.new("slices: empty")
    }
    mut m := xs[0] + ""
    mut i := 1
    while i < xs.len {
        cur := xs[i] + ""
        lhs := cur + ""
        rhs := m + ""
        if strings.compare(&lhs, &rhs) < 0 {
            m = cur
        }
        i = i + 1
    }
    << m
}

pub fn max_str(xs &[]string) string {
    if xs.len == 0 {
        >> errors.new("slices: empty")
    }
    mut m := xs[0] + ""
    mut i := 1
    while i < xs.len {
        cur := xs[i] + ""
        lhs := cur + ""
        rhs := m + ""
        if strings.compare(&lhs, &rhs) > 0 {
            m = cur
        }
        i = i + 1
    }
    << m
}

pub fn is_sorted_ints(xs &[]int) bool {
    mut i := 1
    while i < xs.len {
        if xs[i] < xs[i - 1] {
            << false
        }
        i = i + 1
    }
    << true
}

pub fn is_sorted_strs(xs &[]string) bool {
    mut i := 1
    while i < xs.len {
        a := xs[i - 1] + ""
        b := xs[i] + ""
        if strings.compare(&a, &b) > 0 {
            << false
        }
        i = i + 1
    }
    << true
}

