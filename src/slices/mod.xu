@slices


#errors
#strings

// Concrete helpers: generic `==` is not allowed on Type::Param at check time.

pub fn contains_int(xs []int, v int) bool {
    for i in 0:xs.len {
        if xs[i] == v {
            << true
        }
    }
    << false
}

pub fn index_of_int(xs []int, v int) int {
    for i in 0:xs.len {
        if xs[i] == v {
            << i
        }
    }
    << -1
}

pub fn last_index_int(xs &[]int, v int) int {
    mut i := xs.len - 1
    while i >= 0 {
        if xs[i] == v {
            << i
        }
        i = i - 1
    }
    << 0 - 1
}

pub fn last_index_str(xs &[]string, v string) int {
    want := v + ""
    mut i := xs.len - 1
    while i >= 0 {
        cur := xs[i] + ""
        if cur == want {
            << i
        }
        i = i - 1
    }
    << 0 - 1
}

pub fn sum_int(xs []int) int {
    mut t := 0
    for i in 0:xs.len {
        t = t + xs[i]
    }
    << t
}

pub fn contains_str(xs []string, v string) bool {
    for i in 0:xs.len {
        if xs[i] == v {
            << true
        }
    }
    << false
}

// Go `slices.Index` — first index of v, -1 when absent.
pub fn index_of_str(xs []string, v string) int {
    for i in 0:xs.len {
        if xs[i] == v {
            << i
        }
    }
    << -1
}

// Go `slices.Equal` — element-wise equality (read-only borrows).
pub fn equal_ints(a &[]int, b &[]int) bool {
    if a.len != b.len {
        << false
    }
    for i in 0:a.len {
        if a[i] != b[i] {
            << false
        }
    }
    << true
}

pub fn equal_strs(a &[]string, b &[]string) bool {
    if a.len != b.len {
        << false
    }
    for i in 0:a.len {
        if a[i] != b[i] {
            << false
        }
    }
    << true
}

// Go `slices.Reverse` — in place, through the exclusive borrow. Every
// element store is bounds-checked and overwriting an owning (string)
// element drops its old value first (S1/S3).
pub fn reverse_ints(a &mut []int) {
    n := a.len
    for i in 0:(n >> 1) {
        t := a[i]
        a[i] = a[n - 1 - i]
        a[n - 1 - i] = t
    }
}

pub fn reverse_strs(a &mut []string) {
    n := a.len
    for i in 0:(n >> 1) {
        t := a[i]
        a[i] = a[n - 1 - i]
        a[n - 1 - i] = t
    }
}

// Go `slices.Clone` — owning copies; the source is only read.
pub fn clone_ints(xs &[]int) []int {
    mut out := []int{}
    for i in 0:xs.len {
        out.push(xs[i])
    }
    << out
}

pub fn clone_strs(xs &[]string) []string {
    mut out := []string{}
    for i in 0:xs.len {
        out.push(xs[i])
    }
    << out
}

pub fn compare_ints(a &[]int, b &[]int) int {
    mut n := a.len
    if b.len < n {
        n = b.len
    }
    for i in 0:n {
        if a[i] < b[i] {
            << -1
        }
        if a[i] > b[i] {
            << 1
        }
    }
    if a.len < b.len {
        << -1
    }
    if a.len > b.len {
        << 1
    }
    << 0
}

fn str_cmp(a &string, b &string) int {
    << strings.compare(a, b)
}

pub fn compare_strs(a &[]string, b &[]string) int {
    mut n := a.len
    if b.len < n {
        n = b.len
    }
    for i in 0:n {
        left := a[i]
        right := b[i]
        c := str_cmp(&left, &right)
        if c != 0 {
            << c
        }
    }
    if a.len < b.len {
        << -1
    }
    if a.len > b.len {
        << 1
    }
    << 0
}

pub fn compact_ints(xs &[]int) []int {
    mut out := []int{}
    if xs.len == 0 {
        << out
    }
    out.push(xs[0])
    for i in 1:xs.len {
        if xs[i] != xs[i - 1] {
            out.push(xs[i])
        }
    }
    << out
}

pub fn compact_strs(xs &[]string) []string {
    mut out := []string{}
    if xs.len == 0 {
        << out
    }
    out.push(xs[0] + "")
    for i in 1:xs.len {
        if xs[i] != xs[i - 1] {
            out.push(xs[i] + "")
        }
    }
    << out
}

pub fn insert_int(xs &[]int, i int, v int) []int {
    mut out := []int{}
    mut p := i
    if p < 0 {
        p = 0
    }
    if p > xs.len {
        p = xs.len
    }
    for k in 0:p {
        out.push(xs[k])
    }
    out.push(v)
    for k in p:xs.len {
        out.push(xs[k])
    }
    << out
}

pub fn insert_str(xs &[]string, i int, v string) []string {
    mut out := []string{}
    mut p := i
    if p < 0 {
        p = 0
    }
    if p > xs.len {
        p = xs.len
    }
    for k in 0:p {
        out.push(xs[k] + "")
    }
    out.push(v + "")
    for k in p:xs.len {
        out.push(xs[k] + "")
    }
    << out
}

pub fn delete_ints(xs &[]int, i int, j int) []int {
    mut out := []int{}
    mut lo := i
    mut hi := j
    if lo < 0 {
        lo = 0
    }
    if hi > xs.len {
        hi = xs.len
    }
    if hi < lo {
        hi = lo
    }
    for k in 0:lo {
        out.push(xs[k])
    }
    for k in hi:xs.len {
        out.push(xs[k])
    }
    << out
}

pub fn delete_strs(xs &[]string, i int, j int) []string {
    mut out := []string{}
    mut lo := i
    mut hi := j
    if lo < 0 {
        lo = 0
    }
    if hi > xs.len {
        hi = xs.len
    }
    if hi < lo {
        hi = lo
    }
    for k in 0:lo {
        out.push(xs[k] + "")
    }
    for k in hi:xs.len {
        out.push(xs[k] + "")
    }
    << out
}

pub fn min_int(xs &[]int) int {
    if xs.len == 0 {
        >> errors.new("slices: empty")
    }
    mut m := xs[0]
    for i in 1:xs.len {
        if xs[i] < m {
            m = xs[i]
        }
    }
    << m
}

pub fn max_int(xs &[]int) int {
    if xs.len == 0 {
        >> errors.new("slices: empty")
    }
    mut m := xs[0]
    for i in 1:xs.len {
        if xs[i] > m {
            m = xs[i]
        }
    }
    << m
}

