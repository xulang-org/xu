pub fn contains_func_strs(xs &[]string, f fn(string) bool) bool {
    << index_func_strs(xs, f) >= 0
}

pub fn compact_func_ints(xs &[]int, eq fn(int, int) bool) []int {
    mut out := []int{}
    if xs.len == 0 {
        << out
    }
    out.push(xs[0])
    mut i := 1
    while i < xs.len {
        prev := out[out.len - 1]
        cur := xs[i]
        if !eq(prev, cur) {
            out.push(cur)
        }
        i = i + 1
    }
    << out
}

pub fn delete_func_ints(xs &[]int, f fn(int) bool) []int {
    mut out := []int{}
    mut i := 0
    while i < xs.len {
        v := xs[i]
        if !f(v) {
            out.push(v)
        }
        i = i + 1
    }
    << out
}
