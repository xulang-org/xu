@ffi
// C interoperation helpers for code that calls extern "C" functions.
//
// Pointers are c_ptr values: addresses of C memory that Xu cannot borrow
// check. Everything here that touches memory behind a c_ptr is an unsafe
// fn, callable only inside `unsafe { }`; the caller vouches that the
// address is valid for the access. Offsets are in bytes.

extern "C" {
    fn c_malloc(n c_size) c_ptr = "malloc"
    fn c_calloc(n c_size, size c_size) c_ptr = "calloc"
    fn c_realloc(p c_ptr, n c_size) c_ptr = "realloc"
    fn c_free(p c_ptr) = "free"
    fn c_memcpy(dst c_ptr, src c_ptr, n c_size) c_ptr = "memcpy"
    fn c_memset(dst c_ptr, b c_int, n c_size) c_ptr = "memset"
    fn c_strlen(s c_ptr) c_size = "strlen"
    fn c_dlopen(path cstr, flags c_int) c_ptr = "dlopen"
    fn c_dlsym(h c_ptr, name cstr) c_ptr = "dlsym"
    fn c_dlclose(h c_ptr) c_int = "dlclose"
    fn c_dlerror() c_ptr = "dlerror"
}

// The null pointer.
pub fn null() c_ptr { << c_ptr(0) }

pub fn is_null(p c_ptr) bool { << int(p) == 0 }

// Address arithmetic; no access happens.
pub fn offset(p c_ptr, bytes int) c_ptr { << c_ptr(int(p) + bytes) }

pub fn addr(p c_ptr) int { << int(p) }

// C heap (the C library's malloc family; release with free).
pub unsafe fn malloc(n int) c_ptr { << c_malloc(u64(n)) }
pub unsafe fn calloc(n int) c_ptr { << c_calloc(u64(n), u64(1)) }
pub unsafe fn realloc(p c_ptr, n int) c_ptr { << c_realloc(p, u64(n)) }
pub unsafe fn free(p c_ptr) { c_free(p) }
pub unsafe fn memcpy(dst c_ptr, src c_ptr, n int) { c_memcpy(dst, src, u64(n)) }
pub unsafe fn memset(dst c_ptr, b int, n int) { c_memset(dst, i32(b), u64(n)) }

pub unsafe fn read_i8(p c_ptr, off int) i8 { << i8(rt_load(int(p) + off, 1)) }
pub unsafe fn read_u8(p c_ptr, off int) u8 { << u8(rt_load(int(p) + off, 1)) }
pub unsafe fn read_i16(p c_ptr, off int) i16 { << i16(rt_load(int(p) + off, 2)) }
pub unsafe fn read_u16(p c_ptr, off int) u16 { << u16(rt_load(int(p) + off, 2)) }
pub unsafe fn read_i32(p c_ptr, off int) i32 { << i32(rt_load(int(p) + off, 4)) }
pub unsafe fn read_u32(p c_ptr, off int) u32 { << u32(rt_load(int(p) + off, 4)) }
pub unsafe fn read_i64(p c_ptr, off int) int { << rt_load(int(p) + off, 8) }
pub unsafe fn read_u64(p c_ptr, off int) u64 { << u64(rt_load(int(p) + off, 8)) }
pub unsafe fn read_f32(p c_ptr, off int) f32 { << f32_from_bits(rt_load(int(p) + off, 4)) }
pub unsafe fn read_f64(p c_ptr, off int) f64 { << f64_from_bits(rt_load(int(p) + off, 8)) }
pub unsafe fn read_ptr(p c_ptr, off int) c_ptr { << c_ptr(rt_load(int(p) + off, 8)) }

pub unsafe fn write_i8(p c_ptr, off int, v i8) { rt_store(int(p) + off, 1, int(v)) }
pub unsafe fn write_u8(p c_ptr, off int, v u8) { rt_store(int(p) + off, 1, int(v)) }
pub unsafe fn write_i16(p c_ptr, off int, v i16) { rt_store(int(p) + off, 2, int(v)) }
pub unsafe fn write_u16(p c_ptr, off int, v u16) { rt_store(int(p) + off, 2, int(v)) }
pub unsafe fn write_i32(p c_ptr, off int, v i32) { rt_store(int(p) + off, 4, int(v)) }
pub unsafe fn write_u32(p c_ptr, off int, v u32) { rt_store(int(p) + off, 4, int(v)) }
pub unsafe fn write_i64(p c_ptr, off int, v int) { rt_store(int(p) + off, 8, v) }
pub unsafe fn write_u64(p c_ptr, off int, v u64) { rt_store(int(p) + off, 8, int(v)) }
pub unsafe fn write_f32(p c_ptr, off int, v f32) { rt_store(int(p) + off, 4, f32_bits(v)) }
pub unsafe fn write_f64(p c_ptr, off int, v f64) { rt_store(int(p) + off, 8, f64_bits(v)) }
pub unsafe fn write_ptr(p c_ptr, off int, v c_ptr) { rt_store(int(p) + off, 8, int(v)) }

// Bit patterns: an f32 value is its single-precision bits.
fn f32_bits(v f32) int {
    $x := v
    << rt_load(rt_addr(&x), 4)
}

fn f32_from_bits(b int) f32 {
    $x := f32(0.0)
    rt_store(rt_addr(&x), 4, b)
    << x
}

fn f64_bits(v f64) int {
    $x := v
    << rt_load(rt_addr(&x), 8)
}

fn f64_from_bits(b int) f64 {
    $x := 0.0
    rt_store(rt_addr(&x), 8, b)
    << x
}

// Length of the NUL-terminated C string at p.
pub unsafe fn strlen(p c_ptr) int { << int(c_strlen(p)) }

// Copy of the NUL-terminated C string at p ("" for null).
pub unsafe fn string_from(p c_ptr) string {
    if is_null(p) { << "" }
    << string_n(p, strlen(p))
}

// Copy of n bytes at p as a string.
pub unsafe fn string_n(p c_ptr, n int) string {
    $b := []int{}
    for i in 0:n { b.push(int(read_u8(p, i))) }
    << string_from_bytes(b)
}

// Copy of n bytes at p.
pub unsafe fn bytes(p c_ptr, n int) []u8 {
    $b := []u8{}
    for i in 0:n { b.push(read_u8(p, i)) }
    << b
}

// Copy b into the C memory at p (which must hold b.len bytes).
pub unsafe fn copy_in(p c_ptr, b &[]u8) {
    for i in 0:b.len { write_u8(p, i, b[i]) }
}

// Address of the first element. Null when the slice is empty.
pub unsafe fn bytes_ptr(b &[]u8) c_ptr {
    if b.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(b), 8))
}

pub unsafe fn bytes_mut_ptr(b $&[]u8) c_ptr {
    if b.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(b), 8))
}

pub unsafe fn f32_ptr(b &[]f32) c_ptr {
    if b.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(b), 8))
}

pub unsafe fn f32_mut_ptr(b $&[]f32) c_ptr {
    if b.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(b), 8))
}

pub unsafe fn i8_ptr(b &[]i8) c_ptr {
    if b.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(b), 8))
}

pub unsafe fn u16_ptr(b &[]u16) c_ptr {
    if b.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(b), 8))
}

pub unsafe fn int_ptr(b &[]int) c_ptr {
    if b.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(b), 8))
}

pub unsafe fn str_ptr(s &string) c_ptr {
    if s.len <= 0 { << null() }
    << c_ptr(rt_load(rt_addr(s), 8))
}

// A NUL-terminated malloc'd copy of s (release with free).
pub unsafe fn cstring(s &string) c_ptr {
    p := malloc(s.len + 1)
    for i in 0:s.len { write_u8(p, i, u8(s[i])) }
    write_u8(p, s.len, u8(0))
    << p
}

// errno of the calling thread (meaningful right after a failing C call).
pub unsafe fn errno() int {
    << int(read_i32(errno_ptr(), 0))
}

pub unsafe fn set_errno(v int) {
    write_i32(errno_ptr(), 0, i32(v))
}

extern "C" fn c_errno_location() c_ptr = "__errno_location"
extern "C" fn c_error() c_ptr = "__error"
extern "C" fn c_win_errno() c_ptr = "_errno"
extern "C" link "kernel32" {
    fn c_load_library(path cstr) c_ptr = "LoadLibraryA"
    fn c_get_proc_address(h c_ptr, name cstr) c_ptr = "GetProcAddress"
    fn c_free_library(h c_ptr) c_int = "FreeLibrary"
    fn c_get_last_error() u32 = "GetLastError"
}

unsafe fn errno_ptr() c_ptr {
    os := xu_target_os()
    if os == 0 { << c_error() }
    if os == 2 { << c_win_errno() }
    << c_errno_location()
}

// Process-wide pointer slots in rt_globals (the 64 KiB state block).
// Slot 0 is reserved for #internal/sdl; further slots are unassigned.
const PROCESS_SLOT_BASE = 27

pub unsafe fn process_ptr(slot int) c_ptr {
    << c_ptr(rt_globals() + (PROCESS_SLOT_BASE + slot) * 8)
}

pub unsafe fn process_get(slot int) c_ptr {
    << read_ptr(process_ptr(slot), 0)
}

pub unsafe fn process_set(slot int, p c_ptr) {
    write_ptr(process_ptr(slot), 0, p)
}

// Dynamic loading (dlopen/dlsym; LoadLibraryA/GetProcAddress on Windows).
// RTLD_NOW | RTLD_GLOBAL by default; dlopen_local keeps the library out of
// the global namespace (SDL uses that).
pub unsafe fn dlopen(path &string) c_ptr {
    << dlopen_flags(path, false)
}

pub unsafe fn dlopen_local(path &string) c_ptr {
    << dlopen_flags(path, true)
}

unsafe fn dlopen_flags(path &string, local bool) c_ptr {
    os := xu_target_os()
    if os == 2 { << c_load_library(path) }
    // macOS: NOW=2 LOCAL=4 GLOBAL=8; Linux: NOW=2 LOCAL=0 GLOBAL=256.
    $flags := 258
    if os == 0 {
        if local { flags = 6 } else { flags = 10 }
    } else if local {
        flags = 2
    }
    << c_dlopen(path, i32(flags))
}

pub unsafe fn dlsym(h c_ptr, name &string) c_ptr {
    if xu_target_os() == 2 { << c_get_proc_address(h, name) }
    << c_dlsym(h, name)
}

// Look up a C symbol in the process default namespace (macOS RTLD_DEFAULT,
// Linux RTLD_DEFAULT, or Windows C runtime/system DLLs).
pub unsafe fn dlsym_default(name &string) c_ptr {
    os := xu_target_os()
    if os == 0 { << c_dlsym(c_ptr(-2), name) }
    if os == 1 { << c_dlsym(null(), name) }
    if os == 2 {
        dlls := ["ucrtbase.dll", "msvcrt.dll", "kernel32.dll", "user32.dll"]
        for i in 0:dlls.len {
            d := dlls[i]
            h := c_load_library(&d)
            if !is_null(h) {
                f := c_get_proc_address(h, name)
                if !is_null(f) { << f }
            }
        }
        << null()
    }
    << c_dlsym(null(), name)
}

pub unsafe fn dlclose(h c_ptr) int {
    if xu_target_os() == 2 {
        if int(c_free_library(h)) != 0 { << 0 }
        << -1
    }
    << int(c_dlclose(h))
}

pub unsafe fn dlerror() string {
    if xu_target_os() == 2 { << "Windows error " + str(int(c_get_last_error())) }
    << string_from(c_dlerror())
}

// Releases a closure callback slot allocated by `c_callback(...)`.
// Safe to pass `null()` or static top-level `c_callback` pointers (no-op).
pub unsafe fn callback_free(cb c_ptr) {
    c_callback_free(cb)
}
