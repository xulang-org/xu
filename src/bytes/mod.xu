@bytes


#errors
#strings
#unicode/utf8
// Owning byte helpers aligned with Go `bytes` (Buffer, Equal, Compare,
// IndexByte, Count, Replace, HasPrefix). Unread views are copied strings,
// never a shared []byte header. Do not wrap Buffer in Result.
// Text cutsets, callbacks and simple case mappings share `#strings` Unicode
// semantics. IndexByte and MapBytes retain their explicit byte contracts.

pub struct Buffer {
    pub data string
    pub off int
    prev_rune int
}

pub fn buffer() Buffer {
    << Buffer{data: "", off: 0, prev_rune: 0 - 1}
}

pub fn buffer_from(s string) Buffer {
    << Buffer{data: s, off: 0, prev_rune: 0 - 1}
}

pub fn (b &mut Buffer) write(data &string) int {
    r := mut &b.data
    r.push_str(*data)
    b.prev_rune = 0 - 1
    << data.len
}

pub fn (b &mut Buffer) write_byte(c int) int {
    if c < 0 {
        >> errors.new("bytes: byte out of range")
    }
    if c > 255 {
        >> errors.new("bytes: byte out of range")
    }
    r := mut &b.data
    r.push_byte(c)
    b.prev_rune = 0 - 1
    << 1
}

pub fn (b &mut Buffer) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    rest := b.data.len - b.off
    if rest <= 0 {
        << ""
    }
    mut take := n
    if take > rest {
        take = rest
    }
    start := b.off
    b.off = b.off + take
    b.prev_rune = 0 - 1
    << b.data[start:b.off]
}

pub fn (b &Buffer) length() int {
    rest := b.data.len - b.off
    if rest < 0 {
        << 0
    }
    << rest
}

pub fn (b &Buffer) text() string {
    if b.off >= b.data.len {
        << ""
    }
    << b.data[b.off:b.data.len]
}

pub fn (b &Buffer) bytes() string {
    << b.text()
}

pub fn (b &mut Buffer) reset() {
    b.data = ""
    b.off = 0
    b.prev_rune = 0 - 1
}

pub fn (b &mut Buffer) truncate(n int) int {
    if n < 0 {
        >> errors.new("bytes: truncate out of range")
    }
    unread := b.data.len - b.off
    if n > unread {
        >> errors.new("bytes: truncate out of range")
    }
    if n == 0 {
        b.data = ""
        b.off = 0
        << 0
    }
    start := b.off
    piece := b.data[start:start + n]
    b.data = piece
    b.off = 0
    << n
}

pub fn view_of(s &string) strings.ByteView {
    << strings.view_of(s)
}

pub fn view_slice(s &string, off int, n int) strings.ByteView {
    << strings.view_slice(s, off, n)
}

pub fn equal(a &string, b &string) bool {
    << strings.compare(a, b) == 0
}

pub fn compare(a &string, b &string) int {
    << strings.compare(a, b)
}

pub fn has_prefix(s &string, prefix string) bool {
    << strings.has_prefix(s, prefix)
}

pub fn has_suffix(s &string, suffix string) bool {
    << strings.has_suffix(s, suffix)
}

pub fn index_byte(s &string, c int) int {
    << strings.index_byte(s, c)
}

pub fn last_index_byte(s &string, c int) int {
    << strings.last_index_byte(s, c)
}

pub fn last_index(s &string, sub string) int {
    << strings.last_index(s, sub)
}

pub fn count(s &string, sub string) int {
    << strings.count(s, sub)
}

pub fn replace(s &string, old string, new string, n int) string {
    << strings.replace(s, old, new, n)
}

pub fn replace_all(s &string, old string, new string) string {
    << strings.replace_all(s, old, new)
}

pub fn contains(s &string, sub string) bool {
    << strings.contains(s, sub)
}

pub fn index(s &string, sub string) int {
    << strings.index_of(s, sub)
}

pub fn trim_left(s &string, cutset string) string {
    << strings.trim_left(s, cutset)
}

pub fn trim_right(s &string, cutset string) string {
    << strings.trim_right(s, cutset)
}

pub fn trim(s &string, cutset string) string {
    << strings.trim(s, cutset)
}

pub fn trim_space(s &string) string {
    << strings.trim_space(s)
}

pub fn trim_prefix(s &string, pre string) string {
    << strings.trim_prefix(s, pre)
}

pub fn trim_suffix(s &string, suf string) string {
    << strings.trim_suffix(s, suf)
}

pub fn join(parts []string, sep string) string {
    << strings.join(parts, sep)
}

pub fn split(s &string, sep string) []string {
    << strings.split(s, sep)
}

pub fn fields(s &string) []string {
    << strings.fields(s)
}

// Text callbacks receive runes, aligned with strings. MapBytes remains byte-based.
pub fn index_func(s &string, f fn(int) bool) int {
    << strings.index_func(s, f)
}

pub fn last_index_func(s &string, f fn(int) bool) int {
    << strings.last_index_func(s, f)
}

pub fn map_bytes(s &string, f fn(int) int) string {
    << strings.map_bytes(s, f)
}

pub fn fields_func(s &string, f fn(int) bool) []string {
    << strings.fields_func(s, f)
}

pub fn clone(s &string) string {
    << strings.clone(s)
}

pub fn contains_func(s &string, f fn(int) bool) bool {
    << strings.contains_func(s, f)
}

pub fn index_any(s &string, chars string) int {
    << strings.index_any(s, chars)
}

pub fn last_index_any(s &string, chars string) int {
    << strings.last_index_any(s, chars)
}

pub fn contains_any(s &string, chars string) bool {
    << strings.contains_any(s, chars)
}

pub fn index_rune(s &string, r int) int {
    << strings.index_rune(s, r)
}

pub fn contains_rune(s &string, r int) bool {
    << strings.contains_rune(s, r)
}

pub fn split_n(s &string, sep string, n int) []string {
    << strings.split_n(s, sep, n)
}

pub fn split_after(s &string, sep string) []string {
    << strings.split_after(s, sep)
}

pub fn split_after_n(s &string, sep string, n int) []string {
    << strings.split_after_n(s, sep, n)
}

pub fn trim_left_func(s &string, f fn(int) bool) string {
    << strings.trim_left_func(s, f)
}

pub fn trim_right_func(s &string, f fn(int) bool) string {
    << strings.trim_right_func(s, f)
}

pub fn trim_func(s &string, f fn(int) bool) string {
    << strings.trim_func(s, f)
}

pub fn to_valid_utf8(s &string, replacement string) string {
    << strings.to_valid_utf8(s, replacement)
}

pub fn repeat(s &string, n int) string {
    << strings.repeat(s, n)
}

pub fn equal_fold(a &string, b &string) bool {
    << strings.equal_fold(a, b)
}

pub fn to_lower(s &string) string {
    << strings.to_lower(s)
}

pub fn to_upper(s &string) string {
    << strings.to_upper(s)
}

pub fn (b &mut Buffer) grow(n int) {
    _ := n
}

pub fn (b &mut Buffer) write_string(s &string) int {
    << b.write(s)
}

pub fn (b &mut Buffer) write_rune(r int) int {
    piece := utf8.encode(r) or >>
    << b.write(&piece)
}

pub fn (b &mut Buffer) read_byte() int {
    if b.off >= b.data.len {
        >> errors.new("EOF")
    }
    c := b.data[b.off] & 255
    b.off = b.off + 1
    b.prev_rune = 0 - 1
    << c
}

pub fn (b &mut Buffer) unread_byte() int {
    if b.off <= 0 {
        >> errors.new("bytes: unread_byte at start")
    }
    b.off = b.off - 1
    b.prev_rune = 0 - 1
    << 0
}

pub fn (b &mut Buffer) read_rune() RuneRead {
    if b.off >= b.data.len {
        b.prev_rune = 0 - 1
        >> errors.new("EOF")
    }
    b.prev_rune = b.off
    c0 := b.data[b.off] & 255
    if c0 < 128 {
        b.off = b.off + 1
        << RuneRead{ch: c0, size: 1}
    }
    src := b.data + ""
    off := b.off
    ch := utf8.decode(&src, off) or (err) {
        b.off = b.off + 1
        << RuneRead{ch: 65533, size: 1}
    }
    w := utf8.rune_len(ch) or (err) {
        b.off = b.off + 1
        << RuneRead{ch: 65533, size: 1}
    }
    b.off = b.off + w
    << RuneRead{ch: ch, size: w}
}

pub fn (b &mut Buffer) unread_rune() int {
    if b.off <= 0 {
        >> errors.new("bytes: UnreadRune at beginning")
    }
    if b.prev_rune < 0 {
        >> errors.new("bytes: UnreadRune previous was not ReadRune")
    }
    b.off = b.prev_rune
    b.prev_rune = 0 - 1
    << 0
}

pub fn (b &Buffer) cap() int {
    << b.data.len
}

pub fn (b &mut Buffer) next(n int) string {
    << b.read_n(n)
}

pub struct Cut {
    pub before string
    pub after string
    pub found bool
}

pub fn cut(s &string, sep string) Cut {
    c := strings.cut(s, sep)
    << Cut{before: c.before, after: c.after, found: c.found}
}

pub fn cut_prefix(s &string, pre string) Cut {
    c := strings.cut_prefix(s, pre)
    << Cut{before: c.before, after: c.after, found: c.found}
}

pub fn cut_suffix(s &string, suf string) Cut {
    c := strings.cut_suffix(s, suf)
    << Cut{before: c.before, after: c.after, found: c.found}
}

pub fn (b &mut Buffer) read_bytes(delim int) string {
    start := b.off
    mut i := start
    d := delim & 255
    while i < b.data.len {
        if (b.data[i] & 255) == d {
            b.off = i + 1
            << b.data[start:b.off]
        }
        i = i + 1
    }
    b.off = b.data.len
    if start >= b.data.len {
        << ""
    }
    << b.data[start:b.data.len]
}
