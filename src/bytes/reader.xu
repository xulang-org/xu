@bytes

#errors
#unicode/utf8

// Go `bytes.NewReader` subset. Same shape as `#strings` Reader: owning
// string payload (no shared []byte). read_n is empty at EOF; read_byte /
// read_rune throw "EOF". seek whence 0/1/2.

pub struct Reader {
    s string
    i int
    prev_rune int
}

pub struct RuneRead {
    pub ch int
    pub size int
}

pub fn new_reader(s string) Reader {
    << Reader{s: s + "", i: 0, prev_rune: 0 - 1}
}

pub fn (r &Reader) size() int {
    << r.s.len
}

pub fn (r &Reader) length() int {
    rest := r.s.len - r.i
    if rest < 0 {
        << 0
    }
    << rest
}

pub fn (r &mut Reader) reset(s string) {
    r.s = s + ""
    r.i = 0
    r.prev_rune = 0 - 1
}

pub fn (r &mut Reader) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    if r.i >= r.s.len {
        r.prev_rune = 0 - 1
        << ""
    }
    r.prev_rune = 0 - 1
    rest := r.s.len - r.i
    mut take := n
    if take > rest {
        take = rest
    }
    start := r.i
    r.i = r.i + take
    << r.s[start:r.i]
}

pub fn (r &mut Reader) read_byte() int {
    if r.i >= r.s.len {
        r.prev_rune = 0 - 1
        >> errors.new("EOF")
    }
    r.prev_rune = 0 - 1
    c := r.s[r.i] & 255
    r.i = r.i + 1
    << c
}

pub fn (r &mut Reader) unread_byte() int {
    if r.i <= 0 {
        >> errors.new("bytes: UnreadByte at beginning")
    }
    r.prev_rune = 0 - 1
    r.i = r.i - 1
    << 0
}

pub fn (r &mut Reader) read_rune() RuneRead {
    if r.i >= r.s.len {
        r.prev_rune = 0 - 1
        >> errors.new("EOF")
    }
    r.prev_rune = r.i
    c0 := r.s[r.i] & 255
    if c0 < 128 {
        r.i = r.i + 1
        << RuneRead{ch: c0, size: 1}
    }
    src := r.s + ""
    off := r.i
    ch := utf8.decode(&src, off) or (err) {
        r.i = r.i + 1
        << RuneRead{ch: 65533, size: 1}
    }
    w := utf8.rune_len(ch) or (err) {
        r.i = r.i + 1
        << RuneRead{ch: 65533, size: 1}
    }
    r.i = r.i + w
    << RuneRead{ch: ch, size: w}
}

pub fn (r &mut Reader) unread_rune() int {
    if r.i <= 0 {
        >> errors.new("bytes: UnreadRune at beginning")
    }
    if r.prev_rune < 0 {
        >> errors.new("bytes: UnreadRune previous was not ReadRune")
    }
    r.i = r.prev_rune
    r.prev_rune = 0 - 1
    << 0
}

pub fn (r &mut Reader) seek(offset int, whence int) int {
    mut abs := 0
    if whence == 0 {
        abs = offset
    } else {
        if whence == 1 {
            abs = r.i + offset
        } else {
            if whence == 2 {
                abs = r.s.len + offset
            } else {
                >> errors.new("bytes: Seek invalid whence")
            }
        }
    }
    if abs < 0 {
        >> errors.new("bytes: Seek negative position")
    }
    r.i = abs
    r.prev_rune = 0 - 1
    << abs
}

pub fn (r &mut Reader) read_at(n int, off int) string {
    if off < 0 {
        >> errors.new("bytes: ReadAt negative offset")
    }
    if off >= r.s.len {
        >> errors.new("EOF")
    }
    if n <= 0 {
        << ""
    }
    rest := r.s.len - off
    mut take := n
    if take > rest {
        take = rest
    }
    end := off + take
    << r.s[off:end]
}
