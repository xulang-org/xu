@bytes

#io
#errors

pub fn (r $&Reader) read_result(n int) io.ReadResult {
    if n < 0 { << io.ReadResult.Failed("", errors.new("io: invalid count")) }
    if n == 0 { << io.ReadResult.Data("") }
    data := r.read_n(n)
    if r.i >= r.s.len { << io.ReadResult.End(data) }
    << io.ReadResult.Data(data)
}

pub fn (b $&Buffer) read_result(n int) io.ReadResult {
    if n < 0 { << io.ReadResult.Failed("", errors.new("io: invalid count")) }
    if n == 0 { << io.ReadResult.Data("") }
    data := b.read_n(n)
    if b.off >= b.data.len { << io.ReadResult.End(data) }
    << io.ReadResult.Data(data)
}

pub fn (b $&Buffer) write_result(data string) io.WriteResult {
    << io.WriteResult.Written(b.write(&data))
}
