@window

driver #internal/sdl
#errors

pub struct Options {
    pub title string
    pub width int
    pub height int
    pub resizable bool
    pub high_pixel_density bool
    pub hidden bool
}
pub struct Window { handle int }
pub struct State {
    pub width int
    pub height int
    pub pixel_width int
    pub pixel_height int
    pub close_requested bool
    pub minimized bool
    pub visible bool
    pub focused bool
}
fn checked(status int) int {
    if status>=0 { << status }
    $message := "window: "
    count := driver.error_len()
    for i in 0:count { message.push_str(string_from_byte(driver.error_byte(i))) }
    >> errors.new(message)
}
pub fn open(options &Options) Window {
    if options.title.len<1 || options.title.len>4096 { >> errors.new("window: title must contain 1...4096 bytes") }
    $title := []u8{}
    for i in 0:options.title.len { title.push(u8(options.title[i])) }
    $flags := 0
    if options.resizable { flags=flags | 1 }
    if options.high_pixel_density { flags=flags | 2 }
    if options.hidden { flags=flags | 4 }
    handle := checked(driver.window_open(&title,options.width,options.height,flags)) or >>
    << Window{handle: handle}
}
// A process-local, never-reused routing identity; not a native window pointer.
// Creating presentation targets still requires a typed Window borrow.
pub fn (window &Window) id() int { << window.handle }
pub fn pump() int { << checked(driver.window_pump()) or >> }
pub fn live_count() int { << checked(driver.window_count()) or >> }
pub fn (window &Window) state() State {
    $values := [0,0,0,0,0,0,0,0]
    checked(driver.window_state(window.handle,$&values)) or >>
    << State{width: values[0],height: values[1],pixel_width: values[2],pixel_height: values[3],
        close_requested: values[4]!=0,minimized: values[5]!=0,visible: values[6]!=0,focused: values[7]!=0}
}
pub fn (window &Window) resize(width int, height int) int { << checked(driver.window_resize(window.handle,width,height)) or >> }
pub fn (window &Window) show() int { << checked(driver.window_visibility(window.handle,1)) or >> }
pub fn (window &Window) hide() int { << checked(driver.window_visibility(window.handle,0)) or >> }
pub fn (window &Window) minimize() int { << checked(driver.window_visibility(window.handle,2)) or >> }
pub fn (window &Window) restore() int { << checked(driver.window_visibility(window.handle,3)) or >> }
// Closing the window safely invalidates attached presentation objects first.
pub fn (window $&Window) close() int {
    if window.handle==0 { << 0 }
    checked(driver.window_close(window.handle)) or >>
    window.handle=0
    << 0
}
fn (window $&Window) drop() {
    if window.handle>0 { driver.window_close(window.handle)
        window.handle=0 }
}
