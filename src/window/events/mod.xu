// Physical keys use USB HID keyboard-page usages 4...231 (0 = unknown).
// Logical keys are Unicode scalars, or KEY_SPECIAL_BASE + physical key for
// named non-character keys. They are not SDL keycodes or text/IME input.
pub struct Event {
    pub kind int
    pub window_id int
    pub timestamp_ns int
    pub device_id int
    pub physical_key int
    pub logical_key int
    pub modifiers int
    pub repeated bool
    pub button int
    pub clicks int
    pub x f64
    pub y f64
    pub dx f64
    pub dy f64
    pub width int
    pub height int
    pub selection_start int
    pub selection_length int
    pub text string
    pub buttons int
    pub reset_reason int
}
pub struct PointerState {
    pub x f64
    pub y f64
    pub buttons int
    pub modifiers int
}
pub fn empty() Event {
    << Event{kind: EVENT_NONE, window_id: 0, timestamp_ns: 0, device_id: 0,
        physical_key: KEY_UNKNOWN, logical_key: 0, modifiers: 0, repeated: false,
        button: 0, clicks: 0, x: 0.0, y: 0.0, dx: 0.0, dy: 0.0,
        width: 0, height: 0, selection_start: 0, selection_length: 0,
        text: "", buttons: 0, reset_reason: 0}
}
