@window

driver #internal/sdl
#window/events
#math
#unicode/utf8
#errors

// Drain this window's copied queue; pumping is explicit and process-wide.
// A failed Xu allocation before event_read leaves the native event queued.
pub fn (target &Window) poll() events.Event {
    for attempt in 0:2 {
        $words := []int{}
        for i in 0:21 { words.push(0) }
        present := checked(driver.window_event_peek(target.handle, $&words)) or >>
        if present == 0 { << events.empty() }
        $bytes := []u8{}
        for i in 0:words[18] { bytes.push(u8(0)) }
        checked(driver.window_event_read(target.handle, $&bytes)) or >>
        $characters := []int{}
        for i in 0:bytes.len { characters.push(int(bytes[i])) }
        text := string_from_bytes(characters)
        $valid := utf8.valid(&text)
        if valid && words[0] == events.EVENT_TEXT_EDITING {
            count := utf8.rune_count(&text)
            if words[16] > count || words[17] > count { valid = false }
            if words[16] >= 0 && words[17] >= 0 && words[17] > count - words[16] { valid = false }
        }
        if !valid {
            checked(driver.window_input_reset(target.handle)) or >>
            ->
        }
        << events.Event{kind: words[0], window_id: words[1], timestamp_ns: words[2], device_id: words[3],
            physical_key: words[4], logical_key: words[5], modifiers: words[6], repeated: words[7] != 0,
            button: words[8], clicks: words[9], x: math.float64_from_bits(words[10]),
            y: math.float64_from_bits(words[11]), dx: math.float64_from_bits(words[12]),
            dy: math.float64_from_bits(words[13]), width: words[14], height: words[15],
            selection_start: words[16], selection_length: words[17], text: text, buttons: words[19], reset_reason: words[20]}
    }
    >> errors.new("window: failed to deliver input reset")
}
pub fn (target &Window) pending_events() int { << checked(driver.window_event_count(target.handle)) or >> }
pub fn (target &Window) key_down(physical_key int) bool {
    status := checked(driver.window_key_down(target.handle, physical_key)) or >>
    << status != 0
}
pub fn (target &Window) pointer_state() events.PointerState {
    $words := [0,0,0,0]
    checked(driver.window_pointer(target.handle, $&words)) or >>
    << events.PointerState{x: math.float64_from_bits(words[0]), y: math.float64_from_bits(words[1]),
        buttons: words[2], modifiers: words[3]}
}
pub fn (target &Window) start_text_input() int { << checked(driver.window_text(target.handle, 1)) or >> }
pub fn (target &Window) stop_text_input() int { << checked(driver.window_text(target.handle, 0)) or >> }
pub fn (target &Window) text_input_active() bool {
    status := checked(driver.window_text(target.handle, 2)) or >>
    << status != 0
}
// Logical window coordinates. Cursor is an offset inside the positive-width area.
pub fn (target &Window) text_input_area(x int, y int, width int, height int, cursor int) int {
    area := [x,y,width,height,cursor]
    << checked(driver.window_text_area(target.handle, &area)) or >>
}
pub fn (target &Window) clear_text_input_area() int {
    area := []int{}
    << checked(driver.window_text_area(target.handle, &area)) or >>
}
pub fn (target &Window) set_relative_pointer(enabled bool) int {
    $value := 0
    if enabled { value = 1 }
    << checked(driver.window_pointer_mode(target.handle, 0, value)) or >>
}
pub fn (target &Window) relative_pointer() bool {
    status := checked(driver.window_pointer_mode(target.handle, 0, 2)) or >>
    << status != 0
}
pub fn (target &Window) set_pointer_grab(enabled bool) int {
    $value := 0
    if enabled { value = 1 }
    << checked(driver.window_pointer_mode(target.handle, 1, value)) or >>
}
pub fn (target &Window) pointer_grab() bool {
    status := checked(driver.window_pointer_mode(target.handle, 1, 2)) or >>
    << status != 0
}
