@testing/iotest

#errors

// Go `testing/iotest` 常用 Reader 包装：每次少读一点，逼出短读处理。

pub struct OneByteReader {
    pub data string
    pub off int
}

pub fn one_byte_reader(s string) OneByteReader {
    << OneByteReader{data: s + "", off: 0}
}

pub fn (r &mut OneByteReader) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    if r.off >= r.data.len {
        << ""
    }
    r.off = r.off + 1
    << r.data[(r.off - 1):r.off]
}

pub struct HalfReader {
    pub data string
    pub off int
}

pub fn half_reader(s string) HalfReader {
    << HalfReader{data: s + "", off: 0}
}

pub fn (r &mut HalfReader) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    rest := r.data.len - r.off
    if rest <= 0 {
        << ""
    }
    mut take := n / 2
    if take < 1 {
        take = 1
    }
    if take > rest {
        take = rest
    }
    start := r.off
    r.off = r.off + take
    << r.data[start:r.off]
}

pub struct ErrReader {
    pub msg string
}

pub fn err_reader(msg string) ErrReader {
    << ErrReader{msg: msg + ""}
}

pub fn (r ErrReader) read_n(n int) string {
    _ := n
    >> errors.new(r.msg)
    << ""
}
