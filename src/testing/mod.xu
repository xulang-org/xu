@testing

#fmt

// Go `testing` 常用面（蛇形）。套具是语言层 `fn test_*` / `xu test`，不是本包。
// 测试体里 `mut t := testing.t()`。errorf 软失败（harness 在返回后记 FAIL）；
// fatalf / fail_now 走 assert → --test 下 longjmp。skip_now 走 test_skip()。

pub struct T {
    pub failed int
    pub skipped int
    pub name string
    pub cleanups []fn()
}

pub fn t() T {
    << T{failed: 0, skipped: 0, name: "", cleanups: []fn(){}}
}

pub fn t_named(name string) T {
    << T{failed: 0, skipped: 0, name: name + "", cleanups: []fn(){}}
}

pub fn (t T) name() string {
    << t.name + ""
}

pub fn (t T) helper() {
}

pub fn (t T) failed() bool {
    << t.failed != 0
}

pub fn (t T) skipped() bool {
    << t.skipped != 0
}

fn format_msg(f string, args []fmt.Arg) string {
    << fmt.sprintf_args(f, args) or (err) {
        << err.msg()
    }
}

pub fn (t &mut T) log(msg &string) {
    eprintln(msg)
}

pub fn (t &mut T) logf(f string, args <-> fmt.Arg) {
    msg := format_msg(f, args)
    eprintln(&msg)
}

pub fn (t &mut T) fail() {
    t.failed = 1
    test_soft_fail()
}

pub fn (t &mut T) error(msg &string) {
    eprintln(msg)
    t.fail()
}

pub fn (t &mut T) errorf(f string, args <-> fmt.Arg) {
    msg := format_msg(f, args)
    eprintln(&msg)
    t.fail()
}

pub fn (t &mut T) fail_now() {
    t.failed = 1
    assert(false)
}

pub fn (t &mut T) fatal(msg &string) {
    eprintln(msg)
    t.fail_now()
}

pub fn (t &mut T) fatalf(f string, args <-> fmt.Arg) {
    msg := format_msg(f, args)
    eprintln(&msg)
    t.fail_now()
}

pub fn (t &mut T) skip_now() {
    t.skipped = 1
    test_skip()
}

pub fn (t &mut T) skip(msg &string) {
    eprintln(msg)
    t.skip_now()
}

pub fn (t &mut T) skipf(f string, args <-> fmt.Arg) {
    msg := format_msg(f, args)
    eprintln(&msg)
    t.skip_now()
}

pub fn (t &mut T) cleanup(f fn()) {
    t.cleanups.push(f)
}

// LIFO. The language test harness does not call this; tests must invoke it.
pub fn (t &mut T) run_cleanup() {
    mut i := t.cleanups.len
    while i > 0 {
        i = i - 1
        f := t.cleanups[i]
        f()
    }
}

// 返回子 T（不吃闭包：函数类型写不出 `mut &T`）。子测试 fail_now/skip_now 仍走同一 jmpbuf。
pub fn (t T) run(name string) T {
    << t_named(t.name + "/" + name)
}

pub fn short() bool {
    << test_is_short() != 0
}

pub struct B {
    pub n int
    pub failed int
    pub name string
}

pub fn b(n int) B {
    if n <= 0 {
        << B{n: 1, failed: 0, name: ""}
    }
    << B{n: n, failed: 0, name: ""}
}

pub fn (b &mut B) fail() {
    b.failed = 1
    test_soft_fail()
}

pub fn (b &mut B) errorf(f string, args <-> fmt.Arg) {
    msg := format_msg(f, args)
    eprintln(&msg)
    b.fail()
}

pub fn (b &mut B) fatalf(f string, args <-> fmt.Arg) {
    msg := format_msg(f, args)
    eprintln(&msg)
    b.failed = 1
    assert(false)
}

pub fn (b B) failed() bool {
    << b.failed != 0
}
