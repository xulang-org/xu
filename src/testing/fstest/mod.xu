@testing/fstest

#errors
iofs #io/fs

// Go `testing/fstest.MapFS` + `TestFS` 的最小面：内存路径表 + 一致性检查。
// 无 interface 值，检查函数吃本包 `MapFS`。

pub struct MapFile {
    pub name string
    pub body string
    pub dir bool
}

pub struct MapFS {
    pub files []MapFile
}

pub fn map_fs() MapFS {
    << MapFS{files: []MapFile{}}
}

pub fn (fs $&MapFS) add(name string, body string) {
    fs.files.push(MapFile{name: name + "", body: body + "", dir: false})
}

pub fn (fs $&MapFS) add_dir(name string) {
    fs.files.push(MapFile{name: name + "", body: "", dir: true})
}

pub fn (fs MapFS) read_file(name string) string {
    n := name + ""
    for i in 0:fs.files.len {
        if fs.files[i].name == n {
            if fs.files[i].dir {
                >> errors.new("testing/fstest: is a directory")
            }
            << fs.files[i].body + ""
        }
    }
    >> errors.new("testing/fstest: file does not exist")
}

pub fn (fs MapFS) stat_dir(name string) bool {
    n := name + ""
    if n == "." {
        << true
    }
    for i in 0:fs.files.len {
        if fs.files[i].name == n {
            << fs.files[i].dir
        }
    }
    << false
}

pub fn (fs MapFS) has(name string) bool {
    n := name + ""
    for i in 0:fs.files.len {
        if fs.files[i].name == n {
            << true
        }
    }
    << false
}

// test: 路径合法、文件可读、目录可 stat（对齐 Go TestFS 的常见失败点）。
pub fn test(fs &MapFS) int {
    for i in 0:fs.files.len {
        n := fs.files[i].name + ""
        if !iofs.valid_path(&n) {
            >> errors.new("testing/fstest: invalid path")
        }
        if fs.files[i].dir {
            if !fs.stat_dir(n + "") {
                >> errors.new("testing/fstest: missing dir")
            }
        } else {
            body := fs.read_file(n + "") or >>
            if body.len < 0 {
                >> errors.new("testing/fstest: read")
            }
        }
    }
    << 0
}
