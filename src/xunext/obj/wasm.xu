@xunext/obj
// WebAssembly (WASM) binary module serialization.
//
// Layer 4D module: generates WebAssembly standard binary modules (.wasm)
// with standard header, type section, function section, memory section,
// export section, code section, and custom provenance metadata.

#xunext/mc

fn wasm_put_u8(cb $&mc.CodeBuffer, v int) {
    cb.emit_u8(v & 255)
}

fn wasm_put_u32_leb(cb $&mc.CodeBuffer, v int) {
    $n := v
    while n >= 128 {
        cb.emit_u8((n & 127) | 128)
        n = n / 128
    }
    cb.emit_u8(n & 127)
}

fn wasm_put_i32_leb(cb $&mc.CodeBuffer, v int) {
    $n := v
    $done := false
    while !done {
        byte_val := n & 127
        n = n / 128
        is_pos_end := (n == 0 && (byte_val & 64) == 0)
        is_neg_end := (n == -1 && (byte_val & 64) != 0)
        done = is_pos_end || is_neg_end
        if done {
            cb.emit_u8(byte_val)
        } else {
            cb.emit_u8(byte_val | 128)
        }
    }
}

fn wasm_put_name(cb $&mc.CodeBuffer, name string) {
    wasm_put_u32_leb(cb, name.len)
    for i in 0:name.len {
        cb.emit_u8(name[i])
    }
}

fn wasm_emit_section(cb $&mc.CodeBuffer, sec_id int, sec_content &mc.CodeBuffer) {
    cb.emit_u8(sec_id)
    wasm_put_u32_leb(cb, sec_content.bytes.len)
    for i in 0:sec_content.bytes.len {
        cb.emit_u8(sec_content.bytes[i])
    }
}

pub fn wasm_write_module(code_bytes &[]int, entry_offset int) mc.CodeBuffer {
    $cb := mc.code_buffer_new()

    // 1. Magic number (\0asm) & Version 1
    wasm_put_u8($&cb, 0)
    wasm_put_u8($&cb, 97)  // 'a'
    wasm_put_u8($&cb, 115) // 's'
    wasm_put_u8($&cb, 109) // 'm'
    wasm_put_u8($&cb, 1)   // Version 1
    wasm_put_u8($&cb, 0)
    wasm_put_u8($&cb, 0)
    wasm_put_u8($&cb, 0)

    // 2. Section 1: Type Section (id 1)
    // 1 type: () -> i32 (0x60, 0 params, 1 result 0x7f)
    $sec_type := mc.code_buffer_new()
    wasm_put_u32_leb($&sec_type, 1) // 1 type
    wasm_put_u8($&sec_type, 96)     // 0x60 func
    wasm_put_u32_leb($&sec_type, 0) // 0 params
    wasm_put_u32_leb($&sec_type, 1) // 1 result
    wasm_put_u8($&sec_type, 127)    // 0x7f i32
    wasm_emit_section($&cb, 1, &sec_type)

    // 3. Section 3: Function Section (id 3)
    // 1 function using type index 0
    $sec_func := mc.code_buffer_new()
    wasm_put_u32_leb($&sec_func, 1) // 1 function
    wasm_put_u32_leb($&sec_func, 0) // type 0
    wasm_emit_section($&cb, 3, &sec_func)

    // 4. Section 5: Memory Section (id 5)
    // 1 memory: min 1 page (64KB), no max
    $sec_mem := mc.code_buffer_new()
    wasm_put_u32_leb($&sec_mem, 1) // 1 memory
    wasm_put_u8($&sec_mem, 0)      // limits: flag 0 (only min)
    wasm_put_u32_leb($&sec_mem, 1) // 1 page
    wasm_emit_section($&cb, 5, &sec_mem)

    // 5. Section 7: Export Section (id 7)
    // 2 exports: "_start" (func 0), "memory" (mem 0)
    $sec_export := mc.code_buffer_new()
    wasm_put_u32_leb($&sec_export, 2) // 2 exports

    // Export 1: "_start" -> func 0
    wasm_put_name($&sec_export, "_start")
    wasm_put_u8($&sec_export, 0)      // export kind: function
    wasm_put_u32_leb($&sec_export, 0) // func index 0

    // Export 2: "memory" -> mem 0
    wasm_put_name($&sec_export, "memory")
    wasm_put_u8($&sec_export, 2)      // export kind: memory
    wasm_put_u32_leb($&sec_export, 0) // mem index 0
    wasm_emit_section($&cb, 7, &sec_export)

    // 6. Section 10: Code Section (id 10)
    // Function body 0
    $sec_code := mc.code_buffer_new()
    wasm_put_u32_leb($&sec_code, 1)   // 1 function body

    $func_body := mc.code_buffer_new()
    wasm_put_u32_leb($&func_body, 0)  // 0 local declarations

    if code_bytes.len > 0 {
        for i in 0:code_bytes.len {
            func_body.emit_u8(code_bytes[i])
        }
    } else {
        // Default minimal fallback body: i32.const 0, end
        wasm_put_u8($&func_body, 65)  // 0x41 i32.const
        wasm_put_i32_leb($&func_body, 0)
        wasm_put_u8($&func_body, 11)  // 0x0b end
    }

    wasm_put_u32_leb($&sec_code, func_body.len())
    for i in 0:func_body.len() {
        sec_code.emit_u8(func_body.bytes[i])
    }
    wasm_emit_section($&cb, 10, &sec_code)

    // 7. Section 0: Custom Section for compiler provenance metadata
    $sec_custom := mc.code_buffer_new()
    wasm_put_name($&sec_custom, "xu.source")
    provenance := "Xu compiler wasm32 backend; Xu MIR; frame ABI v1"
    for pi in 0:provenance.len {
        sec_custom.emit_u8(provenance[pi])
    }
    wasm_emit_section($&cb, 0, &sec_custom)

    << cb
}
