@xunext/mir
// If-Conversion and Conditional Select (CSEL / CMOV) optimization pass.
//
// Layer 3 module: identifies conditional branch diamonds and single-sided
// conditional assignments, folding them into MI_SELECT instructions. This eliminates
// branches, jumps, and pipeline stalls by unlocking hardware CSEL on ARM64 and CMOV on x64.

fn compute_in_degrees(f &MFn) []int {
    $in_deg := []int{}
    for _ in 0:f.blocks.len {
        in_deg.push(0)
    }
    if f.blocks.len > 0 {
        in_deg[0] = 1
    }

    for bi in 0:f.blocks.len {
        tk := f.blocks[bi].tkind
        if tk == TKIND_JUMP {
            ta := f.blocks[bi].ta
            if ta >= 0 && ta < in_deg.len {
                in_deg[ta] = in_deg[ta] + 1
            }
        } else if tk == TKIND_BRANCH {
            tb := f.blocks[bi].tb
            tc := f.blocks[bi].tc
            if tb >= 0 && tb < in_deg.len {
                in_deg[tb] = in_deg[tb] + 1
            }
            if tc >= 0 && tc < in_deg.len {
                in_deg[tc] = in_deg[tc] + 1
            }
        }
    }
    << in_deg
}

fn analyze_block_assign(f &MFn, bi int) []int {
    $res := []int{}
    if bi < 0 || bi >= f.blocks.len {
        << res
    }

    $target_loc := -1
    $val_kind := -1
    $val_data := -1
    $count_stores := 0

    $temp_loc := []int{}
    for _ in 0:f.temps.len {
        temp_loc.push(-1)
    }

    $ii := f.blocks[bi].head
    while ii >= 0 && ii < f.instrs.len {
        k := f.instrs[ii].kind
        if k != MI_NOP {
            if k == MI_LOAD_LOCAL {
                dest := f.instrs[ii].a
                src := f.instrs[ii].b
                if dest >= 0 && dest < temp_loc.len {
                    temp_loc[dest] = src
                }
            } else if k == MI_STORE_LOCAL {
                target_loc = f.instrs[ii].a
                v := f.instrs[ii].b
                if v <= -2 {
                    val_kind = 0
                    val_data = v
                } else if v >= 0 && v < temp_loc.len && temp_loc[v] >= 0 {
                    val_kind = 1
                    val_data = temp_loc[v]
                } else {
                    val_kind = 2
                    val_data = v
                }
                count_stores += 1
            } else if k == MI_COPY {
                // Allowed
            } else {
                << res
            }
        }

        if ii == f.blocks[bi].tail {
            <-
        }
        ii = f.instrs[ii].next
    }

    if count_stores == 1 && target_loc >= 0 && val_kind >= 0 {
        res.push(target_loc)
        res.push(val_kind)
        res.push(val_data)
        << res
    }
    << res
}

fn analyze_block_ternary(f &MFn, bi int) []int {
    $res := []int{}
    if bi < 0 || bi >= f.blocks.len {
        << res
    }

    $dest_temp := -1
    $val_kind := -1
    $val_data := -1
    $count_copies := 0

    $temp_loc := []int{}
    for _ in 0:f.temps.len {
        temp_loc.push(-1)
    }

    $ii := f.blocks[bi].head
    while ii >= 0 && ii < f.instrs.len {
        k := f.instrs[ii].kind
        if k != MI_NOP {
            if k == MI_LOAD_LOCAL {
                dest := f.instrs[ii].a
                src := f.instrs[ii].b
                if dest >= 0 && dest < temp_loc.len {
                    temp_loc[dest] = src
                }
            } else if k == MI_COPY {
                dest_temp = f.instrs[ii].a
                v := f.instrs[ii].b
                if v <= -2 {
                    val_kind = 0
                    val_data = v
                } else if v >= 0 && v < temp_loc.len && temp_loc[v] >= 0 {
                    val_kind = 1
                    val_data = temp_loc[v]
                } else {
                    val_kind = 2
                    val_data = v
                }
                count_copies += 1
            } else {
                << res
            }
        }

        if ii == f.blocks[bi].tail {
            <-
        }
        ii = f.instrs[ii].next
    }

    if count_copies == 1 && dest_temp >= 0 && val_kind >= 0 {
        res.push(dest_temp)
        res.push(val_kind)
        res.push(val_data)
        << res
    }
    << res
}

fn prepare_select_operand(mfn $&MFn, bi int, val_kind int, val_data int) int {
    if val_kind == 0 {
        << val_data
    } else if val_kind == 1 {
        t := mfn.temps.len
        mfn.temps.push(0)
        mfn.temps_nslots.push(1)
        $ins := minstr_new(MI_LOAD_LOCAL)
        ins.a = t
        ins.b = val_data
        idx := mfn.instrs.len
        mfn.instrs.push(ins)
        mir_append_instr(mfn, bi, idx)
        << t
    } else {
        << val_data
    }
}

fn clear_block_instrs(f $&MFn, bi int) {
    if bi < 0 || bi >= f.blocks.len {
        <<
    }
    $ii := f.blocks[bi].head
    while ii >= 0 && ii < f.instrs.len {
        f.instrs[ii].kind = MI_NOP
        if ii == f.blocks[bi].tail {
            <-
        }
        ii = f.instrs[ii].next
    }
    f.blocks[bi].head = -1
    f.blocks[bi].tail = -1
    f.blocks[bi].tkind = TKIND_OPEN
    f.blocks[bi].ta = -1
    f.blocks[bi].tb = -1
    f.blocks[bi].tc = -1
}

pub fn opt_select(mfn $&MFn) {
    tm := target_model_default()
    opt_select_with_model(mfn, &tm)
}

pub fn opt_select_with_model(mfn $&MFn, tm &TargetModel) {
    if !tm.has_cond_select {
        <<
    }
    if mfn.blocks.len < 3 || mfn.instrs.len == 0 {
        <<
    }

    for _ in 0:2 {
        in_deg := compute_in_degrees(mfn)

        for bi in 0:mfn.blocks.len {
            if mfn.blocks[bi].tkind != TKIND_BRANCH {
                ->
            }

            cond := mfn.blocks[bi].ta
            b_then := mfn.blocks[bi].tb
            b_else := mfn.blocks[bi].tc

            if b_then < 0 || b_else < 0 || b_then >= mfn.blocks.len || b_else >= mfn.blocks.len || b_then == b_else {
                ->
            }

            // Pattern 1: Full Diamond
            // bi branches to b_then and b_else, both jump to join_bb
            if in_deg[b_then] == 1 && in_deg[b_else] == 1 {
                if mfn.blocks[b_then].tkind == TKIND_JUMP && mfn.blocks[b_else].tkind == TKIND_JUMP {
                    join_then := mfn.blocks[b_then].ta
                    join_else := mfn.blocks[b_else].ta
                    if join_then == join_else && join_then >= 0 {
                        join_bb := join_then

                        res_then := analyze_block_assign(mfn, b_then)
                        res_else := analyze_block_assign(mfn, b_else)

                        if res_then.len == 3 && res_else.len == 3 && res_then[0] == res_else[0] {
                            target_local := res_then[0]

                            op_then := prepare_select_operand(mfn, bi, res_then[1], res_then[2])
                            op_else := prepare_select_operand(mfn, bi, res_else[1], res_else[2])

                            // Fold to MI_SELECT
                            dest_temp := mfn.temps.len
                            mfn.temps.push(0)
                            mfn.temps_nslots.push(1)

                            $ins_sel := minstr_new(MI_SELECT)
                            ins_sel.a = dest_temp
                            ins_sel.b = cond
                            ins_sel.c = op_then
                            ins_sel.d = op_else
                            sel_idx := mfn.instrs.len
                            mfn.instrs.push(ins_sel)
                            mir_append_instr(mfn, bi, sel_idx)

                            $ins_st := minstr_new(MI_STORE_LOCAL)
                            ins_st.a = target_local
                            ins_st.b = dest_temp
                            st_idx := mfn.instrs.len
                            mfn.instrs.push(ins_st)
                            mir_append_instr(mfn, bi, st_idx)

                            mfn.blocks[bi].tkind = TKIND_JUMP
                            mfn.blocks[bi].ta = join_bb
                            mfn.blocks[bi].tb = -1
                            mfn.blocks[bi].tc = -1

                            clear_block_instrs(mfn, b_then)
                            clear_block_instrs(mfn, b_else)
                            ->
                        }

                        // Ternary Expression: both branches assign/copy into the same dest temp
                        res_t_then := analyze_block_ternary(mfn, b_then)
                        res_t_else := analyze_block_ternary(mfn, b_else)
                        if res_t_then.len == 3 && res_t_else.len == 3 && res_t_then[0] == res_t_else[0] {
                            dest_temp := res_t_then[0]
                            op_then := prepare_select_operand(mfn, bi, res_t_then[1], res_t_then[2])
                            op_else := prepare_select_operand(mfn, bi, res_t_else[1], res_t_else[2])

                            $ins_sel := minstr_new(MI_SELECT)
                            ins_sel.a = dest_temp
                            ins_sel.b = cond
                            ins_sel.c = op_then
                            ins_sel.d = op_else
                            sel_idx := mfn.instrs.len
                            mfn.instrs.push(ins_sel)
                            mir_append_instr(mfn, bi, sel_idx)

                            mfn.blocks[bi].tkind = TKIND_JUMP
                            mfn.blocks[bi].ta = join_bb
                            mfn.blocks[bi].tb = -1
                            mfn.blocks[bi].tc = -1

                            clear_block_instrs(mfn, b_then)
                            clear_block_instrs(mfn, b_else)
                            ->
                        }
                    }
                }
            }

            // Pattern 2.1: Single-sided If (Then only)
            // bi branches to b_then, else drops directly to join_bb (b_else == join_bb)
            if in_deg[b_then] == 1 && mfn.blocks[b_then].tkind == TKIND_JUMP && mfn.blocks[b_then].ta == b_else {
                res_then := analyze_block_assign(mfn, b_then)

                if res_then.len == 3 {
                    target_local := res_then[0]

                    op_then := prepare_select_operand(mfn, bi, res_then[1], res_then[2])
                    op_else := prepare_select_operand(mfn, bi, 1, target_local)

                    dest_temp := mfn.temps.len
                    mfn.temps.push(0)
                    mfn.temps_nslots.push(1)

                    $ins_sel := minstr_new(MI_SELECT)
                    ins_sel.a = dest_temp
                    ins_sel.b = cond
                    ins_sel.c = op_then
                    ins_sel.d = op_else
                    sel_idx := mfn.instrs.len
                    mfn.instrs.push(ins_sel)
                    mir_append_instr(mfn, bi, sel_idx)

                    $ins_st := minstr_new(MI_STORE_LOCAL)
                    ins_st.a = target_local
                    ins_st.b = dest_temp
                    st_idx := mfn.instrs.len
                    mfn.instrs.push(ins_st)
                    mir_append_instr(mfn, bi, st_idx)

                    mfn.blocks[bi].tkind = TKIND_JUMP
                    mfn.blocks[bi].ta = b_else
                    mfn.blocks[bi].tb = -1
                    mfn.blocks[bi].tc = -1

                    clear_block_instrs(mfn, b_then)
                    ->
                }
            }

            // Pattern 2.2: Inverted Single-sided If (Else only)
            // bi.tb is join_bb, b_else jumps to join_bb
            if in_deg[b_else] == 1 && mfn.blocks[b_else].tkind == TKIND_JUMP && mfn.blocks[b_else].ta == b_then {
                res_else := analyze_block_assign(mfn, b_else)

                if res_else.len == 3 {
                    target_local := res_else[0]

                    op_then := prepare_select_operand(mfn, bi, 1, target_local)
                    op_else := prepare_select_operand(mfn, bi, res_else[1], res_else[2])

                    dest_temp := mfn.temps.len
                    mfn.temps.push(0)
                    mfn.temps_nslots.push(1)

                    $ins_sel := minstr_new(MI_SELECT)
                    ins_sel.a = dest_temp
                    ins_sel.b = cond
                    ins_sel.c = op_then
                    ins_sel.d = op_else
                    sel_idx := mfn.instrs.len
                    mfn.instrs.push(ins_sel)
                    mir_append_instr(mfn, bi, sel_idx)

                    $ins_st := minstr_new(MI_STORE_LOCAL)
                    ins_st.a = target_local
                    ins_st.b = dest_temp
                    st_idx := mfn.instrs.len
                    mfn.instrs.push(ins_st)
                    mir_append_instr(mfn, bi, st_idx)

                    mfn.blocks[bi].tkind = TKIND_JUMP
                    mfn.blocks[bi].ta = b_then
                    mfn.blocks[bi].tb = -1
                    mfn.blocks[bi].tc = -1

                    clear_block_instrs(mfn, b_else)
                    ->
                }
            }
        }
    }
}
