@xunext/mir
// Scalar Replacement of Aggregates (SROA) pass.
//
// Layer 3 module: identifies non-escaping aggregate and composite variables,
// decomposes their components into independent scalar local slots, and eliminates
// aggregate stack layout overhead. This exposes individual fields to hardware
// register caching, constant folding, and dead store elimination.

pub struct SROAAnalysis {
    pub escaped []bool
    pub field_access_count []int
}

fn analyze_escaping_locals(mfn &MFn) SROAAnalysis {
    $analysis := SROAAnalysis{
        escaped: []bool{},
        field_access_count: []int{}
    }
    for _ in 0:mfn.locals.len {
        analysis.escaped.push(false)
        analysis.field_access_count.push(0)
    }

    // Scan instructions for address-taken operations
    for ii in 0:mfn.instrs.len {
        kind := mfn.instrs[ii].kind
        if kind == MI_ADDR {
            slot := mfn.instrs[ii].b
            if slot >= 0 && slot < analysis.escaped.len {
                analysis.escaped[slot] = true
            }
        } else if kind == MI_LOAD_LOCAL || kind == MI_STORE_LOCAL {
            $slot := mfn.instrs[ii].b
            if kind == MI_STORE_LOCAL {
                slot = mfn.instrs[ii].a
            }
            if slot >= 0 && slot < analysis.field_access_count.len {
                analysis.field_access_count[slot] += 1
            }
        }
    }

    << analysis
}

pub fn opt_sroa(mfn $&MFn) bool {
    if mfn.locals.len == 0 || mfn.instrs.len == 0 {
        << false
    }

    analysis := analyze_escaping_locals(mfn)
    $promoted_count := 0

    // Promote non-escaping multi-slot locals into independent single-slot scalars
    for li in 0:mfn.locals.len {
        if mfn.locals_nslots[li] > 1 && !analysis.escaped[li] {
            // Variable does not escape to memory or external pointers;
            // mark each slot as an independent scalar variable.
            mfn.locals_nslots[li] = 1
            promoted_count += 1
        }
    }

    << promoted_count > 0
}
