@xunext/mir
// Tail Recursion Elimination (TRE) pass.
//
// Layer 3 module: transforms self-tail-calls (both pure and accumulator-style)
// into in-place parameter updates and direct jumps to the loop header block,
// reducing call overhead and collapsing call stack depth from O(N) to O(1).

const TRE_NONE = 0
const TRE_PURE = 1
const TRE_ACC  = 2

fn is_self_call(mfn &MFn, ins &MInstr) bool {
    if ins.kind != MI_CALL {
        << false
    }
    fn_name := ins.sval
    << (fn_name == mfn.name || fn_name == mfn.label || fn_name == "_" + mfn.name)
}

fn find_def_in_bb(mfn &MFn, bi int, temp_id int) int {
    if temp_id < 0 {
        << -1
    }
    $curr := mfn.blocks[bi].head
    while curr >= 0 && curr < mfn.instrs.len {
        if mfn.instrs[curr].a == temp_id {
            << curr
        }
        if curr == mfn.blocks[bi].tail {
            <-
        }
        curr = mfn.instrs[curr].next
    }
    << -1
}

pub fn opt_tre(mfn $&MFn) bool {
    if mfn.blocks.len == 0 || mfn.nparams == 0 {
        << false
    }

    $block_tre_kind := []int{}
    $block_call_ins := []int{}
    $block_bin_ins := []int{}
    $block_term_val := []int{}

    for _ in 0:mfn.blocks.len {
        block_tre_kind.push(TRE_NONE)
        block_call_ins.push(-1)
        block_bin_ins.push(-1)
        block_term_val.push(-1)
    }

    $num_pure := 0
    $num_acc := 0
    $has_invalid_base_ret := false

    for bi in 0:mfn.blocks.len {
        if mfn.blocks[bi].tkind == TKIND_RETURN {
            ret_val := mfn.blocks[bi].ta
            if ret_val == -1 {
                has_invalid_base_ret = true
            } else if ret_val >= 0 {
                def_ii := find_def_in_bb(mfn, bi, ret_val)
                if def_ii >= 0 {
                    ins := ~mfn.instrs[def_ii]
                    if is_self_call(mfn, &ins) {
                        // Check argument count matches
                        $arg_idx := ins.c
                        $argc := 0
                        while arg_idx >= 0 && arg_idx < mfn.margs.len {
                            argc += 1
                            arg_idx = mfn.margs[arg_idx].next
                        }
                        if argc == mfn.nparams {
                            block_tre_kind[bi] = TRE_PURE
                            block_call_ins[bi] = def_ii
                            num_pure += 1
                        }
                    } else if ins.kind == MI_BIN && ins.b == BIN_ADD {
                        // Accumulator tail call: return lhs + rhs
                        rhs := ins.d
                        lhs := ins.c
                        $tail_call_ii := -1
                        $term := -1

                        if rhs >= 0 {
                            def_rhs := find_def_in_bb(mfn, bi, rhs)
                            if def_rhs >= 0 && is_self_call(mfn, &mfn.instrs[def_rhs]) {
                                tail_call_ii = def_rhs
                                term = lhs
                            }
                        }
                        if tail_call_ii < 0 && lhs >= 0 {
                            def_lhs := find_def_in_bb(mfn, bi, lhs)
                            if def_lhs >= 0 && is_self_call(mfn, &mfn.instrs[def_lhs]) {
                                tail_call_ii = def_lhs
                                term = rhs
                            }
                        }

                        if tail_call_ii >= 0 {
                            $arg_idx := mfn.instrs[tail_call_ii].c
                            $argc := 0
                            $nested_call := false
                            while arg_idx >= 0 && arg_idx < mfn.margs.len {
                                argc += 1
                                av := mfn.margs[arg_idx].v
                                if av >= 0 {
                                    adef := find_def_in_bb(mfn, bi, av)
                                    if adef >= 0 && is_self_call(mfn, &mfn.instrs[adef]) {
                                        nested_call = true
                                    }
                                }
                                arg_idx = mfn.margs[arg_idx].next
                            }
                            if argc == mfn.nparams && !nested_call {
                                block_tre_kind[bi] = TRE_ACC
                                block_call_ins[bi] = tail_call_ii
                                block_bin_ins[bi] = def_ii
                                block_term_val[bi] = term
                                num_acc += 1
                            }
                        }
                    }
                }
            }
        }
    }

    if num_pure == 0 && num_acc == 0 {
        << false
    }

    // Fast path: pure tail recursion only (no accumulator needed)
    if num_acc == 0 {
        $changed := false
        for bi in 0:mfn.blocks.len {
            if block_tre_kind[bi] == TRE_PURE {
                call_ii := block_call_ins[bi]
                $arg_idx := mfn.instrs[call_ii].c
                $args := []int{}
                while arg_idx >= 0 && arg_idx < mfn.margs.len {
                    args.push(mfn.margs[arg_idx].v)
                    arg_idx = mfn.margs[arg_idx].next
                }
                if args.len == mfn.nparams {
                    for pi in 0:args.len {
                        $st := minstr_new(MI_STORE_LOCAL)
                        st.a = pi
                        st.b = args[pi]
                        emit_to_bb(mfn, bi, st)
                    }
                    mfn.instrs[call_ii].kind = MI_NOP
                    mfn.blocks[bi].tkind = TKIND_JUMP
                    mfn.blocks[bi].ta = 0
                    mfn.blocks[bi].tb = -1
                    mfn.blocks[bi].tc = -1
                    changed = true
                }
            }
        }
        << changed
    }

    // Accumulator path requires valid base returns
    if has_invalid_base_ret {
        << false
    }

    // 1. Allocate accumulator slot in locals
    acc_slot := mfn.locals.len
    mfn.locals.push(mfn.ret)
    mfn.locals_nslots.push(1)
    mfn.locals_owning.push(false)
    mfn.local_names.push("_tre_acc")

    // 2. Normalize CFG: move block 0 to new loop header block
    header_idx := mfn.blocks.len
    $header_bb := mblock_new()
    header_bb.head = mfn.blocks[0].head
    header_bb.tail = mfn.blocks[0].tail
    header_bb.tkind = mfn.blocks[0].tkind
    header_bb.ta = mfn.blocks[0].ta
    header_bb.tb = mfn.blocks[0].tb
    header_bb.tc = mfn.blocks[0].tc
    header_bb.line = mfn.blocks[0].line
    mfn.blocks.push(header_bb)

    orig_b0_kind := block_tre_kind[0]
    orig_b0_call := block_call_ins[0]
    orig_b0_bin := block_bin_ins[0]
    orig_b0_term := block_term_val[0]

    block_tre_kind.push(orig_b0_kind)
    block_call_ins.push(orig_b0_call)
    block_bin_ins.push(orig_b0_bin)
    block_term_val.push(orig_b0_term)

    // Clear block 0 to serve as preheader
    mfn.blocks[0].head = -1
    mfn.blocks[0].tail = -1
    block_tre_kind[0] = TRE_NONE
    block_call_ins[0] = -1
    block_bin_ins[0] = -1
    block_term_val[0] = -1

    c_zero := alloc_const(mfn, 0)
    $st_zero := minstr_new(MI_STORE_LOCAL)
    st_zero.a = acc_slot
    st_zero.b = c_zero
    emit_to_bb(mfn, 0, st_zero)

    mfn.blocks[0].tkind = TKIND_JUMP
    mfn.blocks[0].ta = header_idx
    mfn.blocks[0].tb = -1
    mfn.blocks[0].tc = -1

    // Redirect edges targeting 0 to header_idx
    for bi in 1:header_idx {
        if mfn.blocks[bi].tkind == TKIND_JUMP {
            if mfn.blocks[bi].ta == 0 {
                mfn.blocks[bi].ta = header_idx
            }
        } else if mfn.blocks[bi].tkind == TKIND_BRANCH {
            if mfn.blocks[bi].tb == 0 {
                mfn.blocks[bi].tb = header_idx
            }
            if mfn.blocks[bi].tc == 0 {
                mfn.blocks[bi].tc = header_idx
            }
        }
    }

    // 3. Transform candidate blocks and base returns
    for bi in 1:mfn.blocks.len {
        kind := block_tre_kind[bi]
        if kind == TRE_ACC {
            call_ii := block_call_ins[bi]
            bin_ii := block_bin_ins[bi]
            term := block_term_val[bi]

            // acc = acc + term
            t_acc := alloc_temp(mfn)
            $ld_acc := minstr_new(MI_LOAD_LOCAL)
            ld_acc.a = t_acc
            ld_acc.b = acc_slot
            emit_to_bb(mfn, bi, ld_acc)

            $t_new_acc := alloc_temp(mfn)
            $bin_add := minstr_new(MI_BIN)
            bin_add.a = t_new_acc
            bin_add.b = BIN_ADD
            bin_add.c = t_acc
            bin_add.d = term
            emit_to_bb(mfn, bi, bin_add)

            $st_acc := minstr_new(MI_STORE_LOCAL)
            st_acc.a = acc_slot
            st_acc.b = t_new_acc
            emit_to_bb(mfn, bi, st_acc)

            // Update parameters
            $arg_idx := mfn.instrs[call_ii].c
            $args := []int{}
            while arg_idx >= 0 && arg_idx < mfn.margs.len {
                args.push(mfn.margs[arg_idx].v)
                arg_idx = mfn.margs[arg_idx].next
            }
            for pi in 0:args.len {
                $st := minstr_new(MI_STORE_LOCAL)
                st.a = pi
                st.b = args[pi]
                emit_to_bb(mfn, bi, st)
            }

            mfn.instrs[call_ii].kind = MI_NOP
            mfn.instrs[bin_ii].kind = MI_NOP

            mfn.blocks[bi].tkind = TKIND_JUMP
            mfn.blocks[bi].ta = header_idx
            mfn.blocks[bi].tb = -1
            mfn.blocks[bi].tc = -1

        } else if kind == TRE_PURE {
            call_ii := block_call_ins[bi]

            // Pure tail call: acc unchanged, update parameters
            $arg_idx := mfn.instrs[call_ii].c
            $args := []int{}
            while arg_idx >= 0 && arg_idx < mfn.margs.len {
                args.push(mfn.margs[arg_idx].v)
                arg_idx = mfn.margs[arg_idx].next
            }
            for pi in 0:args.len {
                $st := minstr_new(MI_STORE_LOCAL)
                st.a = pi
                st.b = args[pi]
                emit_to_bb(mfn, bi, st)
            }

            mfn.instrs[call_ii].kind = MI_NOP

            mfn.blocks[bi].tkind = TKIND_JUMP
            mfn.blocks[bi].ta = header_idx
            mfn.blocks[bi].tb = -1
            mfn.blocks[bi].tc = -1

        } else if mfn.blocks[bi].tkind == TKIND_RETURN {
            // Base return: ret = orig_ret + acc
            orig_ret := mfn.blocks[bi].ta
            t_acc := alloc_temp(mfn)
            $ld_acc := minstr_new(MI_LOAD_LOCAL)
            ld_acc.a = t_acc
            ld_acc.b = acc_slot
            emit_to_bb(mfn, bi, ld_acc)

            $t_sum := alloc_temp(mfn)
            $bin_add := minstr_new(MI_BIN)
            bin_add.a = t_sum
            bin_add.b = BIN_ADD
            bin_add.c = orig_ret
            bin_add.d = t_acc
            emit_to_bb(mfn, bi, bin_add)

            mfn.blocks[bi].ta = t_sum
        }
    }

    << true
}
