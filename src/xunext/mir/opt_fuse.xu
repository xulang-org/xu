@xunext/mir
// Machine Instruction Pre-Emission Fusion Pass.
//
// Layer 3 module: identifies composable multi-operation instruction patterns
// (such as Fused Multiply-Add/Sub MADD/MSUB, Bit-Clear BIC, and Cryptographic/CRC32
// hardware idioms) and lowers them into compact, chip-specific fused MIR instructions.

fn count_temp_references(f &MFn) []int {
    $uses := []int{}
    for _ in 0:f.temps.len {
        uses.push(0)
    }

    for bi in 0:f.blocks.len {
        $ii := f.blocks[bi].head
        while ii >= 0 && ii < f.instrs.len {
            ins := &f.instrs[ii]
            k := ins.kind
            if k == MI_COPY || k == MI_STORE_LOCAL {
                if ins.b >= 0 && ins.b < uses.len {
                    uses[ins.b] = uses[ins.b] + 1
                }
            } else if k == MI_BIN {
                if ins.c >= 0 && ins.c < uses.len {
                    uses[ins.c] = uses[ins.c] + 1
                }
                if ins.d >= 0 && ins.d < uses.len {
                    uses[ins.d] = uses[ins.d] + 1
                }
            } else if k == MI_UN {
                if ins.b >= 0 && ins.b < uses.len {
                    uses[ins.b] = uses[ins.b] + 1
                }
            } else if k == MI_SELECT {
                if ins.b >= 0 && ins.b < uses.len { uses[ins.b] = uses[ins.b] + 1 }
                if ins.c >= 0 && ins.c < uses.len { uses[ins.c] = uses[ins.c] + 1 }
                if ins.d >= 0 && ins.d < uses.len { uses[ins.d] = uses[ins.d] + 1 }
            } else if k == MI_LOAD_INDEX || k == MI_STORE_INDEX {
                if ins.b >= 0 && ins.b < uses.len { uses[ins.b] = uses[ins.b] + 1 }
                if ins.c >= 0 && ins.c < uses.len { uses[ins.c] = uses[ins.c] + 1 }
                if k == MI_STORE_INDEX && ins.d >= 0 && ins.d < uses.len {
                    uses[ins.d] = uses[ins.d] + 1
                }
            }
            ii = ins.next
        }

        // Terminator uses
        tk := f.blocks[bi].tkind
        if tk == TKIND_BRANCH {
            ta := f.blocks[bi].ta
            if ta >= 0 && ta < uses.len {
                uses[ta] = uses[ta] + 1
            }
        } else if tk == TKIND_RETURN {
            ta := f.blocks[bi].ta
            if ta >= 0 && ta < uses.len {
                uses[ta] = uses[ta] + 1
            }
        }
    }
    << uses
}

pub fn opt_fuse_with_model(mfn $&MFn, tm &TargetModel) {
    if !tm.has_fused_madd && !tm.has_crc32 && !tm.has_crypto_aes {
        <<
    }

    uses := count_temp_references(mfn)

    for bi in 0:mfn.blocks.len {
        $ii := mfn.blocks[bi].head
        while ii >= 0 && ii < mfn.instrs.len {
            $cur_idx := ii
            ii = mfn.instrs[ii].next

            // Fused Multiply-Add / Fused Multiply-Sub
            // Matches:
            //   t_mul = a * b
            //   dest = t_mul + c  (or c + t_mul) => MI_MADD(dest, a, b, c)
            //   dest = c - t_mul                 => MI_MSUB(dest, a, b, c)
            if tm.has_fused_madd && mfn.instrs[cur_idx].kind == MI_BIN && mfn.instrs[cur_idx].b == BIN_MUL {
                t_mul := mfn.instrs[cur_idx].a
                if t_mul >= 0 && t_mul < uses.len && uses[t_mul] == 1 {
                    factor_a := mfn.instrs[cur_idx].c
                    factor_b := mfn.instrs[cur_idx].d

                    // Search for single consumer within the same block
                    $scan := mfn.instrs[cur_idx].next
                    $interfered := false
                    while scan >= 0 && scan < mfn.instrs.len {
                        s_kind := mfn.instrs[scan].kind
                        s_b := mfn.instrs[scan].b
                        s_c := mfn.instrs[scan].c
                        s_d := mfn.instrs[scan].d
                        s_a := mfn.instrs[scan].a
                        s_next := mfn.instrs[scan].next

                        if s_kind == MI_BIN {
                            if s_b == BIN_ADD {
                                if s_c == t_mul && !interfered {
                                    // dest = t_mul + acc
                                    acc := s_d
                                    dest := s_a
                                    mfn.instrs[cur_idx].kind = MI_NOP
                                    mfn.instrs[scan].kind = MI_MADD
                                    mfn.instrs[scan].a = dest
                                    mfn.instrs[scan].b = factor_a
                                    mfn.instrs[scan].c = factor_b
                                    mfn.instrs[scan].d = acc
                                    <-
                                } else if s_d == t_mul && !interfered {
                                    // dest = acc + t_mul
                                    acc := s_c
                                    dest := s_a
                                    mfn.instrs[cur_idx].kind = MI_NOP
                                    mfn.instrs[scan].kind = MI_MADD
                                    mfn.instrs[scan].a = dest
                                    mfn.instrs[scan].b = factor_a
                                    mfn.instrs[scan].c = factor_b
                                    mfn.instrs[scan].d = acc
                                    <-
                                }
                            } else if s_b == BIN_SUB {
                                if s_d == t_mul && !interfered {
                                    // dest = acc - t_mul => MSUB(dest, a, b, acc)
                                    acc := s_c
                                    dest := s_a
                                    mfn.instrs[cur_idx].kind = MI_NOP
                                    mfn.instrs[scan].kind = MI_MSUB
                                    mfn.instrs[scan].a = dest
                                    mfn.instrs[scan].b = factor_a
                                    mfn.instrs[scan].c = factor_b
                                    mfn.instrs[scan].d = acc
                                    <-
                                }
                            }
                        }

                        // Check interference: if any factor is overwritten, abort fusion
                        if (factor_a >= 0 && s_a == factor_a) || (factor_b >= 0 && s_a == factor_b) {
                            interfered = true
                        }
                        // Any call or side effect terminates single-block scan
                        if s_kind == MI_CALL || s_kind == MI_THROW_UNWRAP {
                            <-
                        }

                        scan = s_next
                    }
                }
            }

            // Hardware CRC32 intrinsic call fusion
            if tm.has_crc32 && mfn.instrs[cur_idx].kind == MI_CALL {
                sname := mfn.instrs[cur_idx].sval
                if sname == "__builtin_crc32w" || sname == "__builtin_crc32x" {
                    // Lower directly into hardware MI_CRYPTO_CRC32
                    mfn.instrs[cur_idx].kind = MI_CRYPTO_CRC32
                }
            }
        }
    }
}
