@xunext/target/chips/model
// Common chip metadata and microarchitecture capabilities model.
//
// Layer 4B sub-package: neutral data structures describing hardware instruction
// sets and microarchitecture execution limits across all supported chips.

pub struct ChipCaps {
    pub name string
    pub issue_width int
    pub vector_bits int
    pub unroll_factor int
    pub has_fast_mul bool
    pub has_cond_select bool
    pub has_fused_alu bool
    pub has_shifted_reg bool
    pub has_lse bool
    pub has_popcnt_clz bool
    pub has_crypto_aes bool
    pub has_crypto_sha1 bool
    pub has_crypto_sha2 bool
    pub has_crypto_sha3 bool
    pub has_crypto_sha512 bool
    pub has_crypto_sm3 bool
    pub has_crypto_sm4 bool
    pub has_crc32 bool
    pub has_bmi2 bool
    pub has_dsp bool
    pub has_zero_loop bool
}

pub fn chip_caps_empty(name string) ChipCaps {
    << ChipCaps{
        name: ~name,
        issue_width: 1,
        vector_bits: 0,
        unroll_factor: 1,
        has_fast_mul: false,
        has_cond_select: false,
        has_fused_alu: false,
        has_shifted_reg: false,
        has_lse: false,
        has_popcnt_clz: false,
        has_crypto_aes: false,
        has_crypto_sha1: false,
        has_crypto_sha2: false,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: false,
        has_bmi2: false,
        has_dsp: false,
        has_zero_loop: false
    }
}
