@xunext/target/chips/arm_a53
// ARM Cortex-A53 microarchitecture package.
//
// Layer 4B module: defines instruction capabilities and pipeline limits for
// power-efficient in-order dual-issue ARMv8.0-A processors.

#xunext/target/chips/model

pub fn name() string {
    << "cortex-a53"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "cortex-a53",
        issue_width: 2,
        vector_bits: 128,
        unroll_factor: 1,
        has_fast_mul: false,
        has_cond_select: true,
        has_fused_alu: true,
        has_shifted_reg: true,
        has_lse: false,
        has_popcnt_clz: true,
        has_crypto_aes: false,
        has_crypto_sha1: false,
        has_crypto_sha2: false,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: false,
        has_bmi2: false,
        has_dsp: false,
        has_zero_loop: false
    }
}
