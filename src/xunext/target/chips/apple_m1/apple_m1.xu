@xunext/target/chips/apple_m1
// Apple Silicon (M1/M2/M3/M4, A14-A18) microarchitecture package.
//
// Layer 4B module: defines instruction capabilities, pipeline limits, and
// special cryptographic/system extensions for Apple ARM64 processors.

#xunext/target/chips/model
#xunext/mc

pub fn name() string {
    << "apple-m1"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "apple-m1",
        issue_width: 8,
        vector_bits: 128,
        unroll_factor: 2,
        has_fast_mul: true,
        has_cond_select: true,
        has_fused_alu: true,
        has_shifted_reg: true,
        has_lse: true,
        has_popcnt_clz: true,
        has_crypto_aes: true,
        has_crypto_sha1: true,
        has_crypto_sha2: true,
        has_crypto_sha3: true,
        has_crypto_sha512: true,
        has_crypto_sm3: true,
        has_crypto_sm4: true,
        has_crc32: true,
        has_bmi2: false,
        has_dsp: false,
        has_zero_loop: false
    }
}

pub fn is_crypto_accelerated() bool {
    << true
}

// Apple Silicon special instruction encoders (Chip-specific package):

// CRC32W: 32-bit CRC calculation (Wd = CRC32(Wn, Wm))
// Opcode format: 0x1ac04800 | (rm << 16) | (rn << 5) | rd
pub fn emit_crc32w(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    op := 0x1ac04800 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

// CRC32X: 64-bit CRC calculation (Wd = CRC32(Wn, Xm))
// Opcode format: 0x9ac04800 | (rm << 16) | (rn << 5) | rd
pub fn emit_crc32x(buf $&mc.CodeBuffer, rd int, rn int, rm int) {
    op := 0x9ac04800 | ((rm & 31) << 16) | ((rn & 31) << 5) | (rd & 31)
    buf.emit_u32_le(op)
}

// AESE: AES Single Round Encryption (Vd.16B = AddRoundKey(SubBytes(ShiftRows(Vd.16B))) ^ Vn.16B)
// Opcode format: 0x4e284800 | (vn << 5) | vd
pub fn emit_aese(buf $&mc.CodeBuffer, vd int, vn int) {
    op := 0x4e284800 | ((vn & 31) << 5) | (vd & 31)
    buf.emit_u32_le(op)
}

// AESMC: AES MixColumns Transformation (Vd.16B = MixColumns(Vn.16B))
// Opcode format: 0x4e286800 | (vn << 5) | vd
pub fn emit_aesmc(buf $&mc.CodeBuffer, vd int, vn int) {
    op := 0x4e286800 | ((vn & 31) << 5) | (vd & 31)
    buf.emit_u32_le(op)
}

// AESD: AES Single Round Decryption
// Opcode format: 0x4e285800 | (vn << 5) | vd
pub fn emit_aesd(buf $&mc.CodeBuffer, vd int, vn int) {
    op := 0x4e285800 | ((vn & 31) << 5) | (vd & 31)
    buf.emit_u32_le(op)
}

// AESIMC: AES Inverse MixColumns Transformation
// Opcode format: 0x4e287800 | (vn << 5) | vd
pub fn emit_aesimc(buf $&mc.CodeBuffer, vd int, vn int) {
    op := 0x4e287800 | ((vn & 31) << 5) | (vd & 31)
    buf.emit_u32_le(op)
}

// SHA256H: SHA-256 Hash Update Part 1 (Qd, Qn, Vm.4S)
// Opcode format: 0x5e004000 | (vm << 16) | (qn << 5) | qd
pub fn emit_sha256h(buf $&mc.CodeBuffer, qd int, qn int, vm int) {
    op := 0x5e004000 | ((vm & 31) << 16) | ((qn & 31) << 5) | (qd & 31)
    buf.emit_u32_le(op)
}

// SHA256H2: SHA-256 Hash Update Part 2 (Qd, Qn, Vm.4S)
// Opcode format: 0x5e005000 | (vm << 16) | (qn << 5) | qd
pub fn emit_sha256h2(buf $&mc.CodeBuffer, qd int, qn int, vm int) {
    op := 0x5e005000 | ((vm & 31) << 16) | ((qn & 31) << 5) | (qd & 31)
    buf.emit_u32_le(op)
}

// CASAL: Atomic Compare-and-Swap with Acquire and Release (Ws, Wt, [Xn])
// Opcode format: 0x88e0fc00 | (ws << 16) | (xn << 5) | wt
pub fn emit_casal(buf $&mc.CodeBuffer, ws int, wt int, xn int) {
    op := 0x88e0fc00 | ((ws & 31) << 16) | ((xn & 31) << 5) | (wt & 31)
    buf.emit_u32_le(op)
}
