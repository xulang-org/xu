@xunext/target/chips/x86_64_v3
// x86-64-v3 microarchitecture package (Haswell / Zen 2 baseline).
//
// Layer 4B module: defines instruction capabilities and pipeline limits for
// modern 64-bit x86 processors with AVX2, FMA3, and BMI1/BMI2.

#xunext/target/chips/model
#xunext/mc

pub fn name() string {
    << "x86-64-v3"
}

pub fn caps() model.ChipCaps {
    << model.ChipCaps{
        name: "x86-64-v3",
        issue_width: 4,
        vector_bits: 256,
        unroll_factor: 2,
        has_fast_mul: true,
        has_cond_select: true,
        has_fused_alu: true,
        has_shifted_reg: false,
        has_lse: false,
        has_popcnt_clz: true,
        has_crypto_aes: true,
        has_crypto_sha1: true,
        has_crypto_sha2: true,
        has_crypto_sha3: false,
        has_crypto_sha512: false,
        has_crypto_sm3: false,
        has_crypto_sm4: false,
        has_crc32: true,
        has_bmi2: true,
        has_dsp: false,
        has_zero_loop: false
    }
}

// x86-64-v3 special instruction encoders:

// CRC32: 32/64-bit CRC32 (F2 0F 38 F1 /r)
pub fn emit_crc32(buf $&mc.CodeBuffer, rd int, rm int) {
    buf.emit_u8(0xf2)
    buf.emit_u8(0x48) // REX.W
    buf.emit_u8(0x0f)
    buf.emit_u8(0x38)
    buf.emit_u8(0xf1)
    modrm := 0xc0 | ((rd & 7) << 3) | (rm & 7)
    buf.emit_u8(modrm)
}

// BLSR: Reset lowest set bit (VEX.LZ.0F38.W0 F3 /3)
pub fn emit_blsr(buf $&mc.CodeBuffer, rd int, rm int) {
    buf.emit_u8(0xc4)
    buf.emit_u8(0xe2)
    vex3 := 0x78 | (((~rd) & 15) << 3)
    buf.emit_u8(vex3)
    buf.emit_u8(0xf3)
    modrm := 0xc0 | (1 << 3) | (rm & 7)
    buf.emit_u8(modrm)
}
