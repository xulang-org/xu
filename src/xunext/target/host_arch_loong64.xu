@xunext/target
$loong64

// Compile-time host architecture for loong64 builds.
//
// Exactly one host_arch_*.xu file is compiled into a binary: the compile tag
// above must match the target the compiler is built for. The value is the
// ARCH_* constant of the @xu/target module.

// host_native_arch returns ARCH_LOONG64 (5).
pub fn host_native_arch() int {
    << 5
}
