pub const TOK_NEWLINE = 53
pub const TOK_EOF = 54
pub const TOK_WHILE = 55
pub const TOK_BREAK = 56
pub const TOK_CONTINUE = 57
pub const TOK_CONST = 58
pub const TOK_MINUS_ASSIGN = 59
pub const TOK_STAR_ASSIGN = 60
pub const TOK_SLASH_ASSIGN = 61
pub const TOK_PERCENT_ASSIGN = 62
