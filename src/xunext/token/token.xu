@xunext/token
// Lexical token kinds, precedence and representations.
//
// Layer 1 module: token enum and table definitions.

#xunext/span

pub struct Token {
    pub kind int
    pub line int
    pub col int
    pub ival int
    pub sval string
}

pub fn new_token(kind int, line int, col int, ival int, sval string) Token {
    << Token{
        kind: kind,
        line: line,
        col: col,
        ival: ival,
        sval: sval
    }
}

// ===== Token kinds =====
pub const TOK_IDENT = 1
pub const TOK_INT = 2
pub const TOK_STR = 3
pub const TOK_FN = 4
pub const TOK_MUT = 5
pub const TOK_RETURN = 6
pub const TOK_IF = 7
pub const TOK_ELSE = 8
pub const TOK_FOR = 9
pub const TOK_IN = 10
pub const TOK_STRUCT = 11
pub const TOK_MATCH = 12
pub const TOK_INTERFACE = 13
pub const TOK_TRUE = 14
pub const TOK_FALSE = 15
pub const TOK_KW_INT = 16
pub const TOK_KW_BOOL = 17
pub const TOK_KW_STRING = 18
pub const TOK_L_PAREN = 19
pub const TOK_R_PAREN = 20
pub const TOK_L_BRACE = 21
pub const TOK_R_BRACE = 22
