@bufio

#io
#errors

// Pending owns the terminal error until its accompanying bytes are drained.
// map.take transfers the enum without partially moving an owner field.
pub struct ResultReader#R:ProgressReader {
    pub src R
    pending map[int]io.ReadResult
    pending_bytes int
    size int
    ended bool
    failed bool
    error_text string
}

pub struct ResultWriter#W:ProgressWriter {
    pub dst W
    buf string
    size int
    failed bool
    error_text string
}

pub fn new_result_reader#R:ProgressReader(src R) ResultReader#R {
    << new_result_reader_size(src, buf_size)
}

pub fn new_result_reader_size#R:ProgressReader(src R, size int) ResultReader#R {
    mut n := size
    if n <= 0 { n = buf_size }
    << ResultReader#R{src:src, pending:map[int]io.ReadResult{}, pending_bytes:0,
        size:n, ended:false, failed:false, error_text:""}
}

pub fn new_result_writer#W:ProgressWriter(dst W) ResultWriter#W {
    << new_result_writer_size(dst, buf_size)
}

pub fn new_result_writer_size#W:ProgressWriter(dst W, size int) ResultWriter#W {
    mut n := size
    if n <= 0 { n = buf_size }
    << ResultWriter#W{dst:dst, buf:"", size:n, failed:false, error_text:""}
}

fn (r &mut ResultReader#R) read_failure(text string) io.ReadResult {
    r.failed = true
    r.error_text = text + ""
    << io.ReadResult.Failed("", errors.new(text))
}

fn (r &mut ResultReader#R) take_pending() io.ReadResult {
    pending := mut &r.pending
    << pending.take(0)
}

pub fn (r &mut ResultReader#R) read_result(n int) io.ReadResult {
    if n < 0 { << io.ReadResult.Failed("", errors.new("bufio: invalid count")) }
    if n == 0 { << io.ReadResult.Data("") }
    if r.failed { << io.ReadResult.Failed("", errors.new(r.error_text + "")) }
    if r.ended { << io.ReadResult.End("") }
    if r.size <= 0 { << r.read_failure("bufio: invalid buffer size") }
    if r.pending.len() == 0 {
        size := r.size
        src := mut &r.src
        incoming := src.read_result(size) or (err) {
            r.failed = true
            r.error_text = err.msg()
            << io.ReadResult.Failed("", err)
        }
        r.pending[0] = incoming
    }
    result := r.take_pending()
    r.pending_bytes = 0
    match result {
        ReadResult.Data(data) {
            if data.len > r.size { << r.read_failure("bufio: invalid read count") }
            if data.len == 0 { << r.read_failure("io: no progress") }
            if data.len > n {
                r.pending_bytes = data.len - n
                r.pending[0] = io.ReadResult.Data(data[n:data.len] + "")
                << io.ReadResult.Data(data[0:n] + "")
            }
            << io.ReadResult.Data(data)
        }
        ReadResult.End(data) {
            if data.len > r.size { << r.read_failure("bufio: invalid read count") }
            if data.len > n {
                r.pending_bytes = data.len - n
                r.pending[0] = io.ReadResult.End(data[n:data.len] + "")
                << io.ReadResult.Data(data[0:n] + "")
            }
            r.ended = true
            << io.ReadResult.End(data)
        }
        ReadResult.Failed(data, err) {
            if data.len > r.size { << r.read_failure("bufio: invalid read count") }
            if data.len > n {
                r.pending_bytes = data.len - n
                r.pending[0] = io.ReadResult.Failed(data[n:data.len] + "", err)
                << io.ReadResult.Data(data[0:n] + "")
            }
            r.failed = true
            r.error_text = err.msg()
            << io.ReadResult.Failed(data, err)
        }
    }
    << r.read_failure("bufio: invalid read result")
}

pub fn (r &ResultReader#R) buffered() int { << r.pending_bytes }

pub fn (r &mut ResultReader#R) reset(src R) {
    r.src = src
    r.pending = map[int]io.ReadResult{}
    r.pending_bytes = 0
    r.ended = false
    r.failed = false
    r.error_text = ""
}

// A legacy read defers terminal errors until the returned bytes are consumed.
// The first structured failure transfers its typed error to the caller;
// subsequent sticky failures recreate its message, not its dynamic type.
pub fn (r &mut ResultReader#R) read_n(n int) string {
    result := r.read_result(n)
    match result {
        ReadResult.Data(data) { << data }
        ReadResult.End(data) { << data }
        ReadResult.Failed(data, err) {
            if data.len > 0 { << data }
            >> err
        }
    }
    << ""
}

pub fn (w &mut ResultWriter#W) flush_result() io.WriteResult {
    if w.failed { << io.WriteResult.Failed(0, errors.new(w.error_text + "")) }
    if w.buf.len == 0 { << io.WriteResult.Written(0) }
    if w.size <= 0 { << io.WriteResult.Failed(0, errors.new("bufio: invalid buffer size")) }
    count := w.buf.len
    data := w.buf + ""
    dst := mut &w.dst
    result := dst.write_result(data) or (err) {
        w.failed = true
        w.error_text = err.msg()
        << io.WriteResult.Unknown(err)
    }
    match result {
        WriteResult.Written(n) {
            if n < 0 || n > count {
                w.failed = true
                w.error_text = "bufio: invalid write count"
                << io.WriteResult.Unknown(errors.new(w.error_text + ""))
            }
            w.buf = w.buf[n:count] + ""
            if n != count {
                w.failed = true
                w.error_text = "short write"
                << io.WriteResult.Failed(n, errors.new(w.error_text + ""))
            }
            << io.WriteResult.Written(n)
        }
        WriteResult.Failed(n, err) {
            w.failed = true
            if n < 0 || n > count {
                w.error_text = "bufio: invalid write count"
                << io.WriteResult.Unknown(errors.new(w.error_text + ""))
            }
            w.buf = w.buf[n:count] + ""
            w.error_text = err.msg()
            << io.WriteResult.Failed(n, err)
        }
        WriteResult.Unknown(err) {
            // Keep all unquantified bytes and make this state sticky. Retry
            // would replay a prefix the destination may already have accepted.
            w.failed = true
            w.error_text = err.msg()
            << io.WriteResult.Unknown(err)
        }
    }
    << io.WriteResult.Unknown(errors.new("bufio: invalid write result"))
}

// Progress means bytes accepted by this buffer, including queued bytes.
// flush_result instead reports the underlying destination's progress.
pub fn (w &mut ResultWriter#W) write_result(data string) io.WriteResult {
    if data.len == 0 { << io.WriteResult.Written(0) }
    if w.failed { << io.WriteResult.Failed(0, errors.new(w.error_text + "")) }
    if w.size <= 0 { << io.WriteResult.Failed(0, errors.new("bufio: invalid buffer size")) }
    mut pos := 0
    while pos < data.len {
        mut take := w.size - w.buf.len
        if take > data.len - pos { take = data.len - pos }
        w.buf = w.buf + data[pos:pos + take]
        pos += take
        if w.buf.len >= w.size {
            result := w.flush_result()
            match result {
                WriteResult.Written(n) {}
                WriteResult.Failed(n, err) { << io.WriteResult.Failed(pos, err) }
                WriteResult.Unknown(err) { << io.WriteResult.Failed(pos, err) }
            }
        }
    }
    << io.WriteResult.Written(pos)
}

pub fn (w &ResultWriter#W) buffered() int { << w.buf.len }
pub fn (w &ResultWriter#W) pending() string { << w.buf + "" }

pub fn (w &mut ResultWriter#W) reset(dst W) {
    w.dst = dst
    w.buf = ""
    w.failed = false
    w.error_text = ""
}

pub fn (w &mut ResultWriter#W) flush() int {
    result := w.flush_result()
    match result {
        WriteResult.Written(n) { << n }
        WriteResult.Failed(n, err) { >> err }
        WriteResult.Unknown(err) { >> err }
    }
    << 0
}

pub fn (w &mut ResultWriter#W) write_str(data string) int {
    result := w.write_result(data)
    match result {
        WriteResult.Written(n) { << n }
        WriteResult.Failed(n, err) { >> err }
        WriteResult.Unknown(err) { >> err }
    }
    << 0
}
