@bufio/file

#os
#errors

// File-backed buffered I/O (Go bufio.NewReader(os.File) shape). Kept
// out of #bufio so importing strings-only bufio does not pull #os.

const buf_size = 4096

pub struct FileReader {
    pub src os.File
    pub buf string
    pub r int
    pub err string
    pub size int
    pub last_byte int
}

pub struct FileWriter {
    pub dst os.File
    pub buf string
    pub size int
    pub err string
}

pub fn new_reader(src os.File) FileReader {
    << FileReader{src: src, buf: "", r: 0, err: "", size: buf_size, last_byte: -1}
}

pub fn new_reader_size(src os.File, size int) FileReader {
    mut n := size
    if n <= 0 {
        n = buf_size
    }
    << FileReader{src: src, buf: "", r: 0, err: "", size: n, last_byte: -1}
}

pub fn new_writer(dst os.File) FileWriter {
    << FileWriter{dst: dst, buf: "", size: buf_size, err: ""}
}

pub fn new_writer_size(dst os.File, size int) FileWriter {
    mut n := size
    if n <= 0 {
        n = buf_size
    }
    << FileWriter{dst: dst, buf: "", size: n, err: ""}
}

fn (r &mut FileReader) refill() int {
    if r.err.len > 0 {
        >> errors.new(r.err)
    }
    n := r.size - (r.buf.len - r.r)
    if n <= 0 { >> errors.new("bufio: buffer full") }
    src := &r.src
    chunk := src.read(n) or (err) {
        r.err = err.msg()
        >> errors.new(r.err)
    }
    if chunk.len == 0 {
        r.err = "EOF"
        >> errors.new("EOF")
    }
    if r.r <= 0 {
        r.buf = r.buf + chunk
    } else {
        if r.r >= r.buf.len {
            r.buf = chunk
        } else {
            r.buf = r.buf[r.r:r.buf.len] + chunk
        }
        r.r = 0
    }
    << chunk.len
}

pub fn (r &mut FileReader) read_byte() int {
    if r.r >= r.buf.len {
        r.refill() or (err) {
            r.last_byte = -1
            >> errors.new(r.err)
        }
    }
    b := r.buf[r.r] & 255
    r.r = r.r + 1
    r.last_byte = b
    << b
}

fn append_chunk(out &mut string, chunk string) {
    out.push_str(chunk)
}

pub fn (r &mut FileReader) read_string(delim int) string {
    mut out := ""
    while true {
        mut idx := -1
        mut i := r.r
        while i < r.buf.len {
            if (r.buf[i] & 255) == delim {
                idx = i
                <-
            }
            i = i + 1
        }
        if idx >= 0 {
            start := r.r
            r.r = idx + 1
            r.last_byte = r.buf[idx] & 255
            << out + r.buf[start:idx + 1]
        }
        if r.r < r.buf.len {
            append_chunk(mut &out, r.buf[r.r:r.buf.len] + "")
            r.r = r.buf.len
        }
        r.refill() or (err) {
            if out.len > 0 {
                r.last_byte = out[out.len - 1] & 255
                << out
            }
            r.last_byte = -1
            >> errors.new(r.err)
        }
    }
    << ""
}

// Bounded staging; return bytes accepted from this call, not the flush count.
// A failed flush remains sticky and retains bytes not confirmed as written.
pub fn (w &mut FileWriter) write(data string) int {
    if w.err.len > 0 { >> errors.new(w.err) }
    mut pos := 0
    while pos < data.len {
        mut take := w.size - w.buf.len
        if take <= 0 {
            w.flush() or >>
            take = w.size
        }
        if take > data.len - pos { take = data.len - pos }
        w.buf = w.buf + data[pos:pos + take]
        pos = pos + take
        if w.buf.len >= w.size { w.flush() or >> }
    }
    << data.len
}

pub fn (w &mut FileWriter) flush() int {
    if w.err.len > 0 { >> errors.new(w.err) }
    if w.buf.len == 0 { << 0 }
    data := w.buf + ""
    dst := &w.dst
    n := dst.write(data + "") or (err) {
        w.err = err.msg()
        >> errors.new(w.err)
    }
    if n < 0 || n > data.len {
        w.err = "bufio: invalid write count"
        >> errors.new(w.err)
    }
    w.buf = data[n:data.len] + ""
    if n != data.len {
        w.err = "short write"
        >> errors.new(w.err)
    }
    << n
}
