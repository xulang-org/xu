@bufio

#io
#errors
#unicode/utf8

// Owning, concrete endpoint wrappers. Methods borrow the endpoint field;
// every read/write preserves its position and propagates its errors.
// This is chunked string I/O, not borrowed/shared byte-buffer I/O.
pub struct BufferedReader#R:StreamReader {
    pub src R
    pub buf string
    pub r int
    pub err string
    pub size int
    pub last_byte int
    pub last_rune int
}

pub struct BufferedWriter#W:StreamWriter {
    pub dst W
    pub buf string
    pub size int
    pub err string
}

pub fn new_stream_reader#R:StreamReader(src R) BufferedReader#R {
    << BufferedReader#R{src:src, buf:"", r:0, err:"", size:BUF_SIZE, last_byte:-1, last_rune:-1}
}

pub fn new_stream_reader_size#R:StreamReader(src R, size int) BufferedReader#R {
    mut n := size
    if n <= 0 { n = BUF_SIZE }
    << BufferedReader#R{src:src, buf:"", r:0, err:"", size:n, last_byte:-1, last_rune:-1}
}

pub fn new_stream_writer#W:StreamWriter(dst W) BufferedWriter#W {
    << BufferedWriter#W{dst:dst, buf:"", size:BUF_SIZE, err:""}
}

pub fn new_stream_writer_size#W:StreamWriter(dst W, size int) BufferedWriter#W {
    mut n := size
    if n <= 0 { n = BUF_SIZE }
    << BufferedWriter#W{dst:dst, buf:"", size:n, err:""}
}

// Keep the concrete Buffer API compatible. These methods follow the same
// tested state machine; stream-only read_n/write_str add composable adapters.
fn (r &mut BufferedReader#R) read_chunk(n int) string {
    src := mut &r.src
    << src.read_n(n) or >>
}

fn (r &mut BufferedReader#R) refill_limit(limit int) int {
    if r.err.len > 0 {
        >> errors.new(r.err)
    }
    have := r.buf.len - r.r
    n := limit - have
    if n <= 0 {
        >> errors.new("bufio: buffer full")
    }
    chunk := r.read_chunk(n) or (err) {
        r.err = err.msg()
        >> errors.new(r.err)
    }
    if chunk.len > n {
        r.err = "bufio: invalid read count"
        >> errors.new(r.err)
    }
    if chunk.len == 0 {
        r.err = "EOF"
        >> errors.new(r.err)
    }
    if r.r >= r.buf.len {
        r.buf = chunk
    } else {
        r.buf = r.buf[r.r:r.buf.len] + chunk
    }
    r.r = 0
    << chunk.len
}

fn (r &mut BufferedReader#R) refill() int {
    << r.refill_limit(r.size) or >>
}

pub fn (r &mut BufferedReader#R) read_rune() RuneRead {
    r.last_byte = -1
    r.last_rune = -1
    if r.r >= r.buf.len {
        r.refill() or >>
    }
    c0 := r.buf[r.r] & 255
    mut need := 1
    if c0 >= 194 && c0 < 224 {
        need = 2
    } else if c0 >= 224 && c0 < 240 {
        need = 3
    } else if c0 >= 240 && c0 <= 244 {
        need = 4
    }
    mut limit := r.size
    if limit < 4 { limit = 4 }
    while r.buf.len - r.r < need && r.err.len == 0 {
        r.refill_limit(limit) or (err) { <- }
    }
    mut end := r.r + need
    if end > r.buf.len { end = r.buf.len }
    chunk := r.buf[r.r:end] + ""
    decoded := decode_rune_chunk(&chunk)
    r.r = r.r + decoded.size
    r.last_byte = r.buf[r.r - 1] & 255
    r.last_rune = decoded.size
    << decoded
}

pub fn (r &mut BufferedReader#R) read_byte() int {
    if r.r >= r.buf.len {
        r.refill() or (err) {
            r.last_byte = -1
            r.last_rune = -1
            >> errors.new(r.err)
        }
    }
    b := r.buf[r.r] & 255
    r.r = r.r + 1
    r.last_byte = b
    r.last_rune = -1
    << b
}

fn (r &mut BufferedReader#R) read_string_inner(delim int) string {
    mut out := ""
    while true {
        chunk := r.read_slice(delim) or (err) {
            if out.len > 0 {
                r.last_byte = out[out.len - 1] & 255
                r.last_rune = -1
                << out
            }
            >> err
        }
        found := chunk.len > 0 && (chunk[chunk.len - 1] & 255) == delim
        append_chunk(mut &out, chunk)
        if found {
            << out
        }
    }
    << out
}

pub fn (r &mut BufferedReader#R) read_string(delim int) string {
    << r.read_string_inner(delim)
}

pub fn (r &mut BufferedReader#R) read_line() string {
    line := r.read_string(10)
    mut end := line.len
    if end > 0 && line[end - 1] == 10 {
        end = end - 1
        if end > 0 && line[end - 1] == 13 {
            end = end - 1
        }
    }
    << line[0:end]
}

pub fn (r &mut BufferedReader#R) peek(n int) string {
    r.last_byte = -1
    r.last_rune = -1
    if n < 0 {
        >> errors.new("bufio: invalid count")
    }
    if n == 0 { << "" }
    if n > r.size {
        >> errors.new("bufio: buffer full")
    }
    mut have := r.buf.len - r.r
    while have < n {
        if r.err.len > 0 {
            if have > 0 {
                << r.buf[r.r:r.buf.len]
            }
            >> errors.new(r.err)
        }
        r.refill() or (err) {
            if have > 0 {
                << r.buf[r.r:r.buf.len]
            }
            >> errors.new(r.err)
        }
        have = r.buf.len - r.r
    }
    << r.buf[r.r:r.r + n]
}

fn (w &mut BufferedWriter#W) write_to_dst(data &string) int {
    d := mut &w.dst
    << d.write_str(data + "") or >>
}

fn (w &mut BufferedWriter#W) flush_inner() int {
    if w.err.len > 0 { >> errors.new(w.err) }
    if w.buf.len == 0 { << 0 }
    data := w.buf + ""
    n := w.write_to_dst(&data) or (err) {
        w.err = err.msg()
        >> errors.new(w.err)
    }
    if n < 0 || n > data.len {
        w.err = "bufio: invalid write count"
        >> errors.new(w.err)
    }
    w.buf = data[n:data.len] + ""
    if n != data.len {
        w.err = "short write"
        >> errors.new(w.err)
    }
    << n
}

pub fn (w &mut BufferedWriter#W) flush() int {
    << w.flush_inner() or >>
}

pub fn (w &mut BufferedWriter#W) write_string(s string) int {
    if w.err.len > 0 { >> errors.new(w.err) }
    mut pos := 0
    while pos < s.len {
        mut take := w.size - w.buf.len
        if take <= 0 {
            w.flush() or >>
            take = w.size
        }
        if take > s.len - pos { take = s.len - pos }
        w.buf = w.buf + s[pos:pos + take]
        pos = pos + take
        if w.buf.len >= w.size { w.flush() or >> }
    }
    << s.len
}

pub fn (r &mut BufferedReader#R) buffered() int {
    n := r.buf.len - r.r
    if n < 0 {
        << 0
    }
    << n
}

pub fn (r &mut BufferedReader#R) discard(n int) int {
    r.last_byte = -1
    r.last_rune = -1
    if n < 0 { >> errors.new("bufio: invalid count") }
    if n == 0 { << 0 }
    mut left := n
    while left > 0 {
        mut have := r.buf.len - r.r
        if have <= 0 {
            r.refill() or (err) {
                >> errors.new(r.err)
            }
            have = r.buf.len - r.r
        }
        mut take := left
        if take > have {
            take = have
        }
        r.r = r.r + take
        left = left - take
    }
    << n
}

pub fn (r &mut BufferedReader#R) read_bytes(delim int) string {
    << r.read_string(delim)
}

pub fn (r &mut BufferedReader#R) unread_byte() int {
    if r.last_byte < 0 {
        >> errors.new("bufio: invalid use of unread_byte")
    }
    if r.r > 0 {
        r.r = r.r - 1
        r.last_byte = -1
        r.last_rune = -1
        << 0
    }
    piece := string_from_byte(r.last_byte)
    r.buf = piece + r.buf
    r.last_byte = -1
    r.last_rune = -1
    << 0
}

pub fn (r &mut BufferedReader#R) unread_rune() int {
    n := r.last_rune
    if n <= 0 {
        >> errors.new("bufio: invalid use of unread_rune")
    }
    if r.r < n {
        >> errors.new("bufio: invalid use of unread_rune")
    }
    r.r = r.r - n
    r.last_rune = -1
    r.last_byte = -1
    << 0
}

pub fn (r &mut BufferedReader#R) read_slice(delim int) string {
    while true {
        mut idx := -1
        mut i := r.r
        mut end := r.r + r.size
        if end > r.buf.len { end = r.buf.len }
        while i < end {
            if (r.buf[i] & 255) == delim {
                idx = i
                i = r.buf.len
            } else {
                i = i + 1
            }
        }
        if idx >= 0 {
            start := r.r
            r.r = idx + 1
            r.last_byte = r.buf[idx] & 255
            r.last_rune = -1
            << r.buf[start:idx + 1] + ""
        }
        have := r.buf.len - r.r
        if have >= r.size && r.size > 0 {
            start2 := r.r
            r.r = r.r + r.size
            r.last_byte = r.buf[r.r - 1] & 255
            r.last_rune = -1
            << r.buf[start2:r.r] + ""
        }
        r.refill() or (err) {
            if r.r < r.buf.len {
                start3 := r.r
                last3 := r.buf[r.buf.len - 1] & 255
                r.r = r.buf.len
                r.last_byte = last3
                r.last_rune = -1
                << r.buf[start3:r.buf.len] + ""
            }
            r.last_byte = -1
            r.last_rune = -1
            >> errors.new(r.err)
        }
    }
    << ""
}

pub fn (r &mut BufferedReader#R) reset(src R) {
    r.src = src
    r.buf = ""
    r.r = 0
    r.err = ""
    r.last_byte = -1
    r.last_rune = -1
}

pub fn (w &mut BufferedWriter#W) write_byte(c int) int {
    if c < 0 || c > 255 {
        >> errors.new("bufio: byte out of range")
    }
    piece := string_from_byte(c)
    << w.write_string(piece)
}

pub fn (w &mut BufferedWriter#W) write_rune(r int) int {
    piece := utf8.encode(r)
    << w.write_string(piece) or >>
}

pub fn (w &mut BufferedWriter#W) buffered() int {
    << w.buf.len
}

pub fn (r &BufferedReader#R) size() int {
    << r.size
}

pub fn (w &BufferedWriter#W) size() int {
    << w.size
}

pub fn (w &BufferedWriter#W) available() int {
    n := w.size - w.buf.len
    if n < 0 {
        << 0
    }
    << n
}

pub fn (w &mut BufferedWriter#W) reset(dst W) {
    w.dst = dst
    w.buf = ""
    w.err = ""
}

// A zero-size read does not access the source and invalidates unread state.
// Return buffered bytes first; a deferred source error is reported once those
// bytes are consumed. A negative size is invalid. Returned chunks are owned.
pub fn (r &mut BufferedReader#R) read_n(n int) string {
    r.last_byte = -1
    r.last_rune = -1
    if n < 0 { >> errors.new("bufio: invalid count") }
    if n == 0 { << "" }
    if r.r >= r.buf.len { r.refill() or >> }
    mut take := r.buf.len - r.r
    if take > n { take = n }
    start := r.r
    r.r = r.r + take
    r.last_byte = r.buf[r.r - 1] & 255
    << r.buf[start:r.r] + ""
}

pub fn (w &mut BufferedWriter#W) write_str(data string) int {
    << w.write_string(data) or >>
}
