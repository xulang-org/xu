@bufio

// Concrete Buffer-backed I/O. #bufio/file preserves its File-backed API;
// new_stream_reader/writer also wrap any constrained concrete endpoint.

#io
#errors
#unicode/utf8

const BUF_SIZE = 4096

pub struct Reader {
    pub src io.Buffer
    pub buf string
    pub r int
    pub err string
    pub size int
    pub last_byte int
    pub last_rune int
}

pub struct Writer {
    pub dst io.Buffer
    pub buf string
    pub size int
    pub err string
}

pub fn new_reader(src io.Buffer) Reader {
    << Reader{src: src, buf: "", r: 0, err: "", size: BUF_SIZE, last_byte: -1, last_rune: -1}
}

pub fn new_reader_size(src io.Buffer, size int) Reader {
    $n := size
    if n <= 0 {
        n = BUF_SIZE
    }
    << Reader{src: src, buf: "", r: 0, err: "", size: n, last_byte: -1, last_rune: -1}
}

pub fn new_writer(dst io.Buffer) Writer {
    << Writer{dst: dst, buf: "", size: BUF_SIZE, err: ""}
}

pub fn new_writer_size(dst io.Buffer, size int) Writer {
    $n := size
    if n <= 0 {
        n = BUF_SIZE
    }
    << Writer{dst: dst, buf: "", size: n, err: ""}
}

fn (r $&Reader) read_chunk(n int) string {
    src := $&r.src
    << src.read_n(n) or >>
}

// Only request free capacity. Rune reads permit four bytes even when the
// caller selected a smaller buffer; other operations retain the exact size.
fn (r $&Reader) refill_limit(limit int) int {
    if r.err.len > 0 {
        >> errors.new(r.err)
    }
    have := r.buf.len - r.r
    n := limit - have
    if n <= 0 {
        >> errors.new("bufio: buffer full")
    }
    chunk := r.read_chunk(n) or (err) {
        r.err = err.msg()
        >> errors.new(r.err)
    }
    if chunk.len == 0 {
        r.err = "EOF"
        >> errors.new(r.err)
    }
    if r.r >= r.buf.len {
        r.buf = chunk
    } else {
        r.buf = r.buf[r.r:r.buf.len] + chunk
    }
    r.r = 0
    << chunk.len
}

fn (r $&Reader) refill() int {
    << r.refill_limit(r.size) or >>
}

// read_byte returns the next byte, or throws at end of input.
pub struct RuneRead {
    pub ch int
    pub size int
}

fn decode_rune_chunk(chunk &string) RuneRead {
    ch := utf8.decode(chunk, 0) or (err) { << RuneRead{ch: utf8.RUNE_ERROR, size: 1} }
    width := utf8.rune_len(ch) or (err) { << RuneRead{ch: utf8.RUNE_ERROR, size: 1} }
    << RuneRead{ch: ch, size: width}
}

pub fn (r $&Reader) read_rune() RuneRead {
    r.last_byte = -1
    r.last_rune = -1
    if r.r >= r.buf.len {
        r.refill() or >>
    }
    c0 := r.buf[r.r] & 255
    $need := 1
    if c0 >= 194 && c0 < 224 {
        need = 2
    } else if c0 >= 224 && c0 < 240 {
        need = 3
    } else if c0 >= 240 && c0 <= 244 {
        need = 4
    }
    $limit := r.size
    if limit < 4 { limit = 4 }
    while r.buf.len - r.r < need && r.err.len == 0 {
        r.refill_limit(limit) or (err) { <- }
    }
    $end := r.r + need
    if end > r.buf.len { end = r.buf.len }
    chunk := r.buf[r.r:end] + ""
    decoded := decode_rune_chunk(&chunk)
    r.r = r.r + decoded.size
    r.last_byte = r.buf[r.r - 1] & 255
    r.last_rune = decoded.size
    << decoded
}

pub fn (r $&Reader) read_byte() int {
    if r.r >= r.buf.len {
        r.refill() or (err) {
            r.last_byte = -1
            r.last_rune = -1
            >> errors.new(r.err)
        }
    }
    b := r.buf[r.r] & 255
    r.r = r.r + 1
    r.last_byte = b
    r.last_rune = -1
    << b
}

// read_string reads until delim (inclusive) or eof; the delimiter is kept
// (Go ReadString). At eof with no data it returns Err; with partial data it
// returns the remainder.
fn append_chunk(out $&string, chunk string) {
    out.push_str(chunk)
}

fn (r $&Reader) read_string_inner(delim int) string {
    $out := ""
    while true {
        chunk := r.read_slice(delim) or (err) {
            if out.len > 0 {
                r.last_byte = out[out.len - 1] & 255
                r.last_rune = -1
                << out
            }
            >> err
        }
        found := chunk.len > 0 && (chunk[chunk.len - 1] & 255) == delim
        append_chunk($&out, chunk)
        if found {
            << out
        }
    }
    << out
}

pub fn (r $&Reader) read_string(delim int) string {
    << r.read_string_inner(delim)
}

// read_line reads until '\n' or eof and strips the trailing '\n' (and a
// preceding '\r', i.e. CRLF) — a simplified Go ReadLine.
pub fn (r $&Reader) read_line() string {
    line := r.read_string(10)
    $end := line.len
    if end > 0 && line[end - 1] == 10 {
        end = end - 1
        if end > 0 && line[end - 1] == 13 {
            end = end - 1
        }
    }
    << line[0:end]
}

// peek returns the next n bytes without consuming them. n must be in
// 0..size; n > size throws (Go bufio.ErrBufferFull). At eof with
// fewer than n bytes buffered it returns what is available (or throws).
pub fn (r $&Reader) peek(n int) string {
    r.last_byte = -1
    r.last_rune = -1
    if n < 0 {
        >> errors.new("bufio: invalid count")
    }
    if n == 0 { << "" }
    if n > r.size {
        >> errors.new("bufio: buffer full")
    }
    $have := r.buf.len - r.r
    while have < n {
        if r.err.len > 0 {
            if have > 0 {
                << r.buf[r.r:r.buf.len]
            }
            >> errors.new(r.err)
        }
        r.refill() or (err) {
            if have > 0 {
                << r.buf[r.r:r.buf.len]
            }
            >> errors.new(r.err)
        }
        have = r.buf.len - r.r
    }
    << r.buf[r.r:r.r + n]
}

// write_to_dst flushes the given bytes through to the sink; the borrow of dst
// is scoped here so flush() can reset the buffer afterwards.
fn (w $&Writer) write_to_dst(data &string) int {
    d := $&w.dst
    << d.write(data)
}

// flush writes any buffered bytes to the sink and resets the buffer.
fn (w $&Writer) flush_inner() int {
    if w.err.len > 0 { >> errors.new(w.err) }
    if w.buf.len == 0 { << 0 }
    data := w.buf + ""
    n := w.write_to_dst(&data) or (err) {
        w.err = err.msg()
        >> errors.new(w.err)
    }
    if n < 0 || n > data.len {
        w.err = "bufio: invalid write count"
        >> errors.new(w.err)
    }
    w.buf = data[n:data.len] + ""
    if n != data.len {
        w.err = "short write"
        >> errors.new(w.err)
    }
    << n
}

pub fn (w $&Writer) flush() int {
    << w.flush_inner() or >>
}

// Retain at most size bytes. Preserve the existing auto-flush-on-full contract.
// Errors are sticky until reset; never silently claim an unsuccessful write.
pub fn (w $&Writer) write_string(s string) int {
    if w.err.len > 0 { >> errors.new(w.err) }
    $pos := 0
    while pos < s.len {
        $take := w.size - w.buf.len
        if take <= 0 {
            w.flush() or >>
            take = w.size
        }
        if take > s.len - pos { take = s.len - pos }
        w.buf = w.buf + s[pos:pos + take]
        pos = pos + take
        if w.buf.len >= w.size { w.flush() or >> }
    }
    << s.len
}

// bytes returns the sink's written bytes (for round-trip tests); it does not
// consume the sink's read position.
pub fn (w $&Writer) bytes() string {
    d := $&w.dst
    << d.bytes()
}

pub fn (r $&Reader) buffered() int {
    n := r.buf.len - r.r
    if n < 0 {
        << 0
    }
    << n
}

pub fn (r $&Reader) discard(n int) int {
    r.last_byte = -1
    r.last_rune = -1
    if n < 0 { >> errors.new("bufio: invalid count") }
    if n == 0 { << 0 }
    $left := n
    while left > 0 {
        $have := r.buf.len - r.r
        if have <= 0 {
            r.refill() or (err) {
                >> errors.new(r.err)
            }
            have = r.buf.len - r.r
        }
        $take := left
        if take > have {
            take = have
        }
        r.r = r.r + take
        left = left - take
    }
    << n
}

pub fn (r $&Reader) read_bytes(delim int) string {
    << r.read_string(delim)
}

// unread_byte puts back the last byte from a successful non-peek read
// (Go UnreadByte). Peek/discard/error invalidate it; twice in a row throws.
pub fn (r $&Reader) unread_byte() int {
    if r.last_byte < 0 {
        >> errors.new("bufio: invalid use of unread_byte")
    }
    if r.r > 0 {
        r.r = r.r - 1
        r.last_byte = -1
        r.last_rune = -1
        << 0
    }
    piece := string_from_byte(r.last_byte)
    r.buf = piece + r.buf
    r.last_byte = -1
    r.last_rune = -1
    << 0
}

pub fn (r $&Reader) unread_rune() int {
    n := r.last_rune
    if n <= 0 {
        >> errors.new("bufio: invalid use of unread_rune")
    }
    if r.r < n {
        >> errors.new("bufio: invalid use of unread_rune")
    }
    r.r = r.r - n
    r.last_rune = -1
    r.last_byte = -1
    << 0
}

// read_slice reads until delim (inclusive) in the current buffer (Go
// ReadSlice). It does not accumulate across a full buffer: if the buffer
// fills with no delim, it returns that chunk (Go also returns ErrBufferFull;
// Xu returns the bytes and does not throw — caller sees no delim). eof with
// leftover returns the leftover; empty eof throws.
pub fn (r $&Reader) read_slice(delim int) string {
    while true {
        $idx := -1
        $i := r.r
        $end := r.r + r.size
        if end > r.buf.len { end = r.buf.len }
        while i < end {
            if (r.buf[i] & 255) == delim {
                idx = i
                i = r.buf.len
            } else {
                i = i + 1
            }
        }
        if idx >= 0 {
            start := r.r
            r.r = idx + 1
            r.last_byte = r.buf[idx] & 255
            r.last_rune = -1
            << r.buf[start:idx + 1] + ""
        }
        have := r.buf.len - r.r
        if have >= r.size && r.size > 0 {
            start2 := r.r
            r.r = r.r + r.size
            r.last_byte = r.buf[r.r - 1] & 255
            r.last_rune = -1
            << r.buf[start2:r.r] + ""
        }
        r.refill() or (err) {
            if r.r < r.buf.len {
                start3 := r.r
                last3 := r.buf[r.buf.len - 1] & 255
                r.r = r.buf.len
                r.last_byte = last3
                r.last_rune = -1
                << r.buf[start3:r.buf.len] + ""
            }
            r.last_byte = -1
            r.last_rune = -1
            >> errors.new(r.err)
        }
    }
    << ""
}

pub fn (r $&Reader) reset(src io.Buffer) {
    r.src = src
    r.buf = ""
    r.r = 0
    r.err = ""
    r.last_byte = -1
    r.last_rune = -1
}

pub fn (w $&Writer) write_byte(c int) int {
    if c < 0 || c > 255 {
        >> errors.new("bufio: byte out of range")
    }
    piece := string_from_byte(c)
    << w.write_string(piece)
}

pub fn (w $&Writer) write_rune(r int) int {
    piece := utf8.encode(r)
    << w.write_string(piece) or >>
}

pub fn (w $&Writer) buffered() int {
    << w.buf.len
}

pub fn (r &Reader) size() int {
    << r.size
}

pub fn (w &Writer) size() int {
    << w.size
}

pub fn (w &Writer) available() int {
    n := w.size - w.buf.len
    if n < 0 {
        << 0
    }
    << n
}

// reset discards unflushed bytes and points at a new sink (Go Writer.Reset).
pub fn (w $&Writer) reset(dst io.Buffer) {
    w.dst = dst
    w.buf = ""
    w.err = ""
}

// Scanner is Go `bufio.Scanner` over an in-memory snapshot of `io.Buffer`.
// Default split is ScanLines. Custom SplitFunc via `split_func` (M140).
// Built-in modes: mode_lines / mode_words / mode_bytes. Scan is a single
// forward index walk — O(n) total, one token string per successful scan.

pub const MODE_LINES = 0
pub const MODE_WORDS = 1
pub const MODE_BYTES = 2
pub const MODE_FUNC = 3

// SplitResult mirrors Go SplitFunc's (advance, token, err).
pub struct SplitResult {
    pub advance int
    pub token string
    pub err string
}

pub fn split_ok(advance int, token string) SplitResult {
    << SplitResult{advance: advance, token: token + "", err: ""}
}

pub fn split_fail(msg string) SplitResult {
    << SplitResult{advance: 0, token: "", err: msg + ""}
}

fn noop_split(data string, at_eof int) SplitResult {
    if data.len < 0 || at_eof < 0 {
        << split_fail("noop")
    }
    << split_ok(0, "")
}

pub struct Scanner {
    pub data string
    pub pos int
    pub token string
    pub err string
    pub mode int
    pub has_split int
    pub split_f fn(string, int) SplitResult
}

fn is_word_space(c int) bool {
    << c == 9 || c == 10 || c == 11 || c == 12 || c == 13 || c == 32
}

pub fn new_scanner(src io.Buffer) Scanner {
    $b := src
    data := b.bytes()
    << Scanner{data: data, pos: 0, token: "", err: "", mode: MODE_LINES, has_split: 0, split_f: noop_split}
}

pub fn (s $&Scanner) split(mode int) {
    s.mode = mode
    s.has_split = 0
}

pub fn (s $&Scanner) split_func(f fn(string, int) SplitResult) {
    s.mode = MODE_FUNC
    s.has_split = 1
    s.split_f = f
}

// Public SplitFunc-shaped helpers (Go ScanLines / ScanWords / ScanBytes).
pub fn scan_lines(data string, at_eof int) SplitResult {
    if data.len == 0 {
        << SplitResult{advance: 0, token: "", err: ""}
    }
    $i := 0
    while i < data.len {
        if (data[i] & 255) == 10 {
            $end := i
            if end > 0 && (data[end - 1] & 255) == 13 {
                end = end - 1
            }
            $tok := ""
            if end > 0 {
                tok = data[0:end] + ""
            }
            << SplitResult{advance: i + 1, token: tok, err: ""}
        }
        i = i + 1
    }
    if at_eof != 0 {
        $end2 := data.len
        if end2 > 0 && (data[end2 - 1] & 255) == 13 {
            end2 = end2 - 1
        }
        $tok2 := ""
        if end2 > 0 {
            tok2 = data[0:end2] + ""
        }
        << SplitResult{advance: data.len, token: tok2, err: ""}
    }
    << SplitResult{advance: 0, token: "", err: ""}
}

pub fn scan_words(data string, at_eof int) SplitResult {
    $i := 0
    while i < data.len && is_word_space(data[i] & 255) {
        i = i + 1
    }
    if i >= data.len {
        << SplitResult{advance: data.len, token: "", err: ""}
    }
    $j := i
    while j < data.len && !is_word_space(data[j] & 255) {
        j = j + 1
    }
    if j < data.len || at_eof != 0 {
        << SplitResult{advance: j, token: data[i:j] + "", err: ""}
    }
    << SplitResult{advance: 0, token: "", err: ""}
}

pub fn scan_bytes(data string, at_eof int) SplitResult {
    if at_eof < 0 {
        << SplitResult{advance: 0, token: "", err: ""}
    }
    if data.len == 0 {
        << SplitResult{advance: 0, token: "", err: ""}
    }
    << SplitResult{advance: 1, token: string_from_byte(data[0] & 255), err: ""}
}

fn (s $&Scanner) scan_line() bool {
    if s.pos >= s.data.len {
        << false
    }
    $i := s.pos
    $found := -1
    while i < s.data.len {
        if (s.data[i] & 255) == 10 {
            found = i
            i = s.data.len
        } else {
            i = i + 1
        }
    }
    if found >= 0 {
        $end := found
        if end > s.pos && (s.data[end - 1] & 255) == 13 {
            end = end - 1
        }
        start := s.pos
        s.pos = found + 1
        if end <= start {
            s.token = ""
        } else {
            s.token = s.data[start:end] + ""
        }
        << true
    }
    $end2 := s.data.len
    if end2 > s.pos && (s.data[end2 - 1] & 255) == 13 {
        end2 = end2 - 1
    }
    start2 := s.pos
    s.pos = s.data.len
    if end2 <= start2 {
        s.token = ""
    } else {
        s.token = s.data[start2:end2] + ""
    }
    << true
}

fn (s $&Scanner) scan_word() bool {
    $i := s.pos
    while i < s.data.len && is_word_space(s.data[i] & 255) {
        i = i + 1
    }
    if i >= s.data.len {
        s.pos = i
        << false
    }
    $j := i
    while j < s.data.len && !is_word_space(s.data[j] & 255) {
        j = j + 1
    }
    s.pos = j
    if j <= i {
        s.token = ""
    } else {
        s.token = s.data[i:j] + ""
    }
    << true
}

fn (s $&Scanner) scan_byte() bool {
    if s.pos >= s.data.len {
        << false
    }
    s.token = string_from_byte(s.data[s.pos] & 255)
    s.pos = s.pos + 1
    << true
}

pub fn (s $&Scanner) scan() bool {
    if s.err.len > 0 {
        << false
    }
    if s.mode == MODE_FUNC && s.has_split != 0 {
        << s.scan_custom()
    }
    if s.mode == MODE_WORDS {
        << s.scan_word()
    }
    if s.mode == MODE_BYTES {
        << s.scan_byte()
    }
    << s.scan_line()
}

fn (s $&Scanner) scan_custom() bool {
    if s.pos > s.data.len {
        << false
    }
    $rem := ""
    if s.pos < s.data.len {
        rem = s.data[s.pos:s.data.len] + ""
    }
    rem_len := rem.len
    arg := rem + ""
    f := s.split_f
    r := f(arg, 1)
    if r.err.len > 0 {
        s.err = r.err + ""
        << false
    }
    if r.advance < 0 || r.advance > rem_len {
        s.err = "bufio.Scanner: invalid advance"
        << false
    }
    if r.advance == 0 && r.token.len == 0 {
        << false
    }
    s.pos = s.pos + r.advance
    s.token = r.token + ""
    << true
}

pub fn (s $&Scanner) text() string {
    << s.token + ""
}

pub fn (s $&Scanner) err_text() string {
    << s.err + ""
}
