@tile

// DLPack Standard v0.8+ C-ABI compliant tensor descriptor and zero-copy view.
// Enables seamless zero-copy interop between Xu tile memory slices and AI
// frameworks (TVM, PyTorch, ONNX Runtime, Triton).

pub const DL_DEVICE_CPU = 1
pub const DL_DEVICE_CUDA = 2
pub const DL_DEVICE_CPU_PINNED = 3
pub const DL_DEVICE_OPENCL = 4
pub const DL_DEVICE_VULKAN = 7
pub const DL_DEVICE_METAL = 8
pub const DL_DEVICE_VPI = 9
pub const DL_DEVICE_ROCM = 10
pub const DL_DEVICE_ONEAPI = 14

pub const DL_DTYPE_INT = 0
pub const DL_DTYPE_UINT = 1
pub const DL_DTYPE_FLOAT = 2
pub const DL_DTYPE_OPAQUE = 3
pub const DL_DTYPE_BFLOAT = 4
pub const DL_DTYPE_COMPLEX = 5
pub const DL_DTYPE_BOOL = 6

pub struct DLDevice {
    pub device_type int
    pub device_id int
}

pub struct DLDataType {
    pub code int
    pub bits int
    pub lanes int
}

pub struct DLTensor {
    pub data_ptr int
    pub device DLDevice
    pub ndim int
    pub dtype DLDataType
    pub shape []int
    pub strides []int
    pub byte_offset int
}

pub fn dlpack_cpu_device() DLDevice {
    << DLDevice{device_type: DL_DEVICE_CPU, device_id: 0}
}

pub fn dlpack_dtype_i64() DLDataType {
    << DLDataType{code: DL_DTYPE_INT, bits: 64, lanes: 1}
}

pub fn dlpack_dtype_f64() DLDataType {
    << DLDataType{code: DL_DTYPE_FLOAT, bits: 64, lanes: 1}
}

pub fn dlpack_dtype_u8() DLDataType {
    << DLDataType{code: DL_DTYPE_UINT, bits: 8, lanes: 1}
}

pub fn dlpack_tensor_1d(data_ptr int, length int, dtype DLDataType) DLTensor {
    $shape := [length]
    $strides := [1]
    << DLTensor{
        data_ptr: data_ptr,
        device: dlpack_cpu_device(),
        ndim: 1,
        dtype: dtype,
        shape: shape,
        strides: strides,
        byte_offset: 0
    }
}

pub fn dlpack_tensor_2d(data_ptr int, m int, n int, dtype DLDataType) DLTensor {
    $shape := [m, n]
    $strides := [n, 1]
    << DLTensor{
        data_ptr: data_ptr,
        device: dlpack_cpu_device(),
        ndim: 2,
        dtype: dtype,
        shape: shape,
        strides: strides,
        byte_offset: 0
    }
}

pub fn dlpack_element_count(t &DLTensor) int {
    if t.ndim == 0 { << 0 }
    $total := 1
    for s in t.shape {
        total = total * s
    }
    << total
}

pub fn dlpack_byte_size(t &DLTensor) int {
    elems := dlpack_element_count(t)
    bytes_per_elem := (t.dtype.bits * t.dtype.lanes) / 8
    if bytes_per_elem == 0 { << elems }
    << elems * bytes_per_elem
}

pub fn dlpack_validate(t &DLTensor) bool {
    if t.data_ptr == 0 && dlpack_element_count(t) > 0 { << false }
    if t.ndim < 1 || t.ndim > 8 { << false }
    if t.shape.len != t.ndim { << false }
    if t.strides.len != 0 && t.strides.len != t.ndim { << false }
    if t.dtype.bits < 1 || t.dtype.lanes < 1 { << false }
    for s in t.shape {
        if s < 0 { << false }
    }
    << true
}
