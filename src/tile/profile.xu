@tile

// Architecture Profile and Tuning Parameters for Tile and Vector Operations.
// Inspired by TransTuning & MetaSchedule, decoupling hardcoded tile sizes from
// micro-kernel emitters and enabling microarchitecture-aware blocking.

pub struct TileArchProfile {
    pub arch_name string
    pub l1d_bytes int
    pub l2_bytes int
    pub simd_bits int
    pub pref_bm int
    pub pref_bn int
    pub pref_bk int
    pub reg_m int
    pub reg_n int
}

pub fn tile_arch_generic() TileArchProfile {
    << TileArchProfile{
        arch_name: "generic",
        l1d_bytes: 32768,
        l2_bytes: 262144,
        simd_bits: 128,
        pref_bm: 64,
        pref_bn: 64,
        pref_bk: 64,
        reg_m: 4,
        reg_n: 2
    }
}

pub fn tile_arch_apple_m() TileArchProfile {
    << TileArchProfile{
        arch_name: "apple-m",
        l1d_bytes: 131072,
        l2_bytes: 4194304,
        simd_bits: 128,
        pref_bm: 128,
        pref_bn: 128,
        pref_bk: 64,
        reg_m: 4,
        reg_n: 2
    }
}

pub fn tile_arch_avx512() TileArchProfile {
    << TileArchProfile{
        arch_name: "x64-avx512",
        l1d_bytes: 49152,
        l2_bytes: 1048576,
        simd_bits: 512,
        pref_bm: 96,
        pref_bn: 96,
        pref_bk: 64,
        reg_m: 8,
        reg_n: 4
    }
}

pub fn tile_arch_detect() TileArchProfile {
    << tile_arch_apple_m()
}

fn tile_min_int(a int, b int) int {
    if a < b { << a }
    << b
}

// Compute bounded tile blocking (bm, bn, bk) for a given matrix dimension (m, n, k).
pub fn tile_compute_blocking(prof &TileArchProfile, m int, n int, k int) []int {
    bm := tile_min_int(m, prof.pref_bm)
    bn := tile_min_int(n, prof.pref_bn)
    bk := tile_min_int(k, prof.pref_bk)
    $res := [bm, bn, bk]
    << res
}

// Check if a tile working set (A_tile + B_tile + C_tile) fits within L1D cache.
pub fn tile_working_set_fits_l1(prof &TileArchProfile, bm int, bn int, bk int, elem_bytes int) bool {
    working_elems := (bm * bk) + (bk * bn) + (bm * bn)
    working_bytes := working_elems * elem_bytes
    << working_bytes <= prof.l1d_bytes
}
