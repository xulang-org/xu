@tile

#math

// Pipelined Operator Fusion & Algebraic Correction.
// Inspired by Neptune (ArXiv 2025), fusing memory-bound operator chains
// and loop-carried dependency reductions into single cache-resident passes.

pub fn fused_saxpy_sum_i64(x &[]int, y &[]int, a int, len int) int {
    $acc := 0
    for i in 0:len {
        acc += a * x[i] + y[i]
    }
    << acc
}

pub fn fused_norm2_i64(x &[]int, len int) int {
    $acc := 0
    for i in 0:len {
        v := x[i]
        acc += v * v
    }
    << acc
}

pub fn fused_norm2_f64(x &[]f64, len int) f64 {
    $acc := 0.0
    for i in 0:len {
        v := x[i]
        acc = acc + v * v
    }
    << acc
}

pub struct OnlineSoftmaxState {
    pub max_val f64
    pub sum_exp f64
}

pub fn online_softmax_init(init_val f64) OnlineSoftmaxState {
    << OnlineSoftmaxState{max_val: init_val, sum_exp: 1.0}
}

pub fn online_softmax_update(state $&OnlineSoftmaxState, val f64) {
    if val > state.max_val {
        factor := math.exp(state.max_val - val)
        state.sum_exp = state.sum_exp * factor + 1.0
        state.max_val = val
    } else {
        state.sum_exp = state.sum_exp + math.exp(val - state.max_val)
    }
}

pub fn online_softmax_vector(vals &[]f64) OnlineSoftmaxState {
    if vals.len == 0 {
        << OnlineSoftmaxState{max_val: 0.0, sum_exp: 0.0}
    }
    $state := online_softmax_init(vals[0])
    for i in 1:vals.len {
        online_softmax_update($&state, vals[i])
    }
    << state
}
