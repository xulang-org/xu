@tile

// Explicit 1D/2D tile movement, reduction, and matrix multiplication
// primitives. On hosted arm64 and x64 targets at -O1+, `gemm_i64` and
// canonical 1D loops are automatically lowered by `MirTilePlan` (`tile_gemm`)
// and the whole-loop SIMD matchers into L1-blocked 2D register-tile and
// vector micro-kernels; all other targets and -O0 execute the portable
// reference loops below with identical bounds and wrapping semantics.

fn tile_hw_supported() int {
    << 0
}

// 2D integer matrix multiply-accumulate:
//   C[m x n] += A[m x k] * B[k x n]
pub fn gemm_i64(c &mut []int, a &[]int, b &[]int, m int, n int, k int) {
    for i in 0:m {
        for p in 0:k {
            aik := a[i * k + p]
            for j in 0:n {
                c[i * n + j] += aik * b[p * n + j]
            }
        }
    }
}

// 2D double-precision matrix multiply-accumulate:
//   C[m x n] += A[m x k] * B[k x n]
pub fn gemm_f64(c &mut []f64, a &[]f64, b &[]f64, m int, n int, k int) {
    for i in 0:m {
        for p in 0:k {
            aik := a[i * k + p]
            for j in 0:n {
                c[i * n + j] += aik * b[p * n + j]
            }
        }
    }
}

// 1D tile multiply-accumulate:
//   c[off_c + j] += factor * b[off_b + j]  for j in 0:len
pub fn madd_i64(c &mut []int, off_c int, b &[]int, off_b int, factor int, len int) {
    for j in 0:len {
        c[off_c + j] += factor * b[off_b + j]
    }
}

// 1D tile fill:
//   dst[j] = val  for j in 0:len
pub fn fill_i64(dst &mut []int, val int, len int) {
    for j in 0:len {
        dst[j] = val
    }
}

// 1D tile copy:
//   dst[j] = src[j]  for j in 0:len
pub fn copy_i64(dst &mut []int, src &[]int, len int) {
    for j in 0:len {
        dst[j] = src[j]
    }
}

// 1D tile reduction sum:
//   sum(src[0:len])
pub fn sum_i64(src &[]int, len int) int {
    mut acc := 0
    for j in 0:len {
        acc += src[j]
    }
    << acc
}
