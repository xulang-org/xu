@rate

#errors
#time

// Token-bucket rate limiter (single task; S6 — no `$&` across `xu`).
//
//     $lim := rate.new(100, 100)   // 100 events/s, burst 100
//     if lim.allow() { ... }
//
// For per-peer limits keep one Limiter per peer on the coordinator task.

pub struct Limiter {
    rate_per_sec int
    burst int
    tokens int
    last_ns int
}

// new(events_per_sec, burst). burst must be >= 1.
pub fn new(events_per_sec int, burst int) Limiter {
    $r := events_per_sec
    if r < 1 {
        r = 1
    }
    $b := burst
    if b < 1 {
        b = 1
    }
    << Limiter{rate_per_sec: r, burst: b, tokens: b, last_ns: time.now()}
}

fn refill(l $&Limiter) {
    now := time.now()
    dt := now - l.last_ns
    if dt <= 0 {
        <<
    }
    $add := (dt / 1000000000) * l.rate_per_sec
    frac := ((dt % 1000000000) * l.rate_per_sec) / 1000000000
    add = add + frac
    if add > 0 {
        l.tokens = l.tokens + add
        if l.tokens > l.burst {
            l.tokens = l.burst
        }
        l.last_ns = now
    }
}

// allow consumes one token if available.
pub fn (l $&Limiter) allow() bool {
    refill(l)
    if l.tokens >= 1 {
        l.tokens = l.tokens - 1
        << true
    }
    << false
}

// allow_n consumes n tokens or none (all-or-nothing).
pub fn (l $&Limiter) allow_n(n int) bool {
    refill(l)
    if n <= 0 {
        << true
    }
    if l.tokens >= n {
        l.tokens = l.tokens - n
        << true
    }
    << false
}

pub fn (l Limiter) available() int {
    << l.tokens
}

// sleep_for_hint returns a rough ns until one token exists (0 if ready).
pub fn (l Limiter) sleep_for_hint() int {
    if l.tokens >= 1 {
        << 0
    }
    need := 1 - l.tokens
    $ns := (need * 1000000000) / l.rate_per_sec
    if ns < 1 {
        ns = 1
    }
    << ns
}
