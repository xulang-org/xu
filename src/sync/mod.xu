@sync

// Mutex and WaitGroup are owning channel handles, not user-visible pointers
// and not atomic.Pointer. The token lives in the runtime channel object;
// copies of Mutex share that object (like Go channel variables). Protected
// data still must move through channels — $& must not cross xu (S6).

// Capacity shared by Cond notification buffering and broadcast.
const COND_SIGNAL_CAPACITY = 4096

pub struct Mutex {
    pub tok chan int
}

pub struct WaitGroup {
    pub done chan int
    pub pending int
}

pub fn mutex() Mutex {
    ch := chan int{cap: 1}
    ch <- 1
    << Mutex{tok: ch}
}

pub fn (m $&Mutex) lock() {
    tok := <- m.tok
    if tok != 1 {
        eprintln("sync: corrupted mutex")
        <<< 1
    }
}

pub fn (m $&Mutex) unlock() {
    select {
        m.tok <- 1 {
        }
        else {
            eprintln("sync: unlock of unlocked mutex")
            <<< 1
        }
    }
}

pub fn wait_group() WaitGroup {
    ch := chan int{cap: 0}
    << WaitGroup{done: ch, pending: 0}
}

pub fn (w $&WaitGroup) add(delta int) {
    w.pending = w.pending + delta
}

pub fn (w $&WaitGroup) done() {
    w.done <- 1
}

pub fn (w $&WaitGroup) wait(n int) {
    $i := 0
    while i < n {
        tok := <- w.done
        if tok != 1 {
            eprintln("sync: waitgroup token")
            <<< 1
        }
        i = i + 1
    }
}

pub fn (w $&WaitGroup) wait_pending() {
    n := w.pending
    w.wait(n)
    w.pending = 0
}

// ===== sync/atomic (Go sync/atomic, int-sized) =====
// The runtime builtins are atomic_load / atomic_store / atomic_add /
// atomic_cas — the `atomic_` prefix keeps them distinct from the wrapper
// names below (the same M28 shadowing rule as the os package: a wrapper
// named `atomic_load` would shadow the builtin and self-recurse). Each
// builtin takes a mutable int location (`$&int`; callers write `$&x`).
// add returns the old value; cas returns a bool.

pub fn load_int(x $&int) int {
    << atomic_load(x)
}

pub fn store_int(x $&int, v int) {
    atomic_store(x, v)
}

pub fn add_int(x $&int, d int) int {
    << atomic_add(x, d)
}

pub fn compare_and_swap_int(x $&int, old int, new int) bool {
    << atomic_cas(x, old, new)
}

// ===== Once (Go sync.Once subset) =====
// `do(f)` runs f at most once (M104 named fn values). `first_time()` remains
// for call sites that prefer an explicit branch.

pub struct Once {
    pub state int
    pub mu Mutex
}

pub fn once() Once {
    << Once{state: 0, mu: mutex()}
}

fn (o $&Once) lock_mu() {
    mu := $&o.mu
    mu.lock()
}

fn (o $&Once) unlock_mu() {
    mu := $&o.mu
    mu.unlock()
}

pub fn (o $&Once) first_time() bool {
    if atomic_load($&o.state) != 0 {
        << false
    }
    o.lock_mu()
    if o.state != 0 {
        o.unlock_mu()
        << false
    }
    o.state = 1
    o.unlock_mu()
    << true
}

pub fn (o $&Once) do(f fn()) {
    if o.first_time() {
        f()
    }
}

// Capacity for concurrent readers in RWMutex.
const RW_MAX_READERS = 1024

// ===== RWMutex (Go sync.RWMutex; parallel reads) =====
// Uses an unbuffered writer mutex (mu) and a shared token channel semaphore.
// Multiple readers acquire tokens concurrently without serializing on
// the writer lock. Writers drain all reader tokens before proceeding,
// guaranteeing exclusive writer access while allowing true parallel readers.

pub struct RWMutex {
    pub mu Mutex
    pub tokens chan int
}

pub fn rw_mutex() RWMutex {
    ch := chan int{cap: RW_MAX_READERS}
    $i := 0
    while i < RW_MAX_READERS {
        ch <- 1
        i = i + 1
    }
    << RWMutex{mu: mutex(), tokens: ch}
}

pub fn (m $&RWMutex) read_lock() {
    tok := <- m.tokens
    if tok != 1 {
        eprintln("sync: corrupted rwmutex token")
        <<< 1
    }
}

pub fn (m $&RWMutex) read_unlock() {
    select {
        m.tokens <- 1 {
        }
        else {
            eprintln("sync: read_unlock of unlocked rwmutex")
            <<< 1
        }
    }
}

pub fn (m $&RWMutex) write_lock() {
    mu := $&m.mu
    mu.lock()
    $i := 0
    while i < RW_MAX_READERS {
        tok := <- m.tokens
        if tok != 1 {
            eprintln("sync: corrupted rwmutex token")
            <<< 1
        }
        i = i + 1
    }
}

pub fn (m $&RWMutex) write_unlock() {
    $i := 0
    while i < RW_MAX_READERS {
        select {
            m.tokens <- 1 {
            }
            else {
                eprintln("sync: write_unlock corrupted token capacity")
                <<< 1
            }
        }
        i = i + 1
    }
    mu := $&m.mu
    mu.unlock()
}

// ===== Cond (Go sync.Cond subset; M144) =====
// Locker is the Mutex passed to wait — no Locker interface. Callers must
// re-check the condition after wait returns (same contract as Go).
// Notify is a shared channel so Cond values may be copied across `xu`
// (handles share the runtime object). No per-copy waiter counter.

pub struct Cond {
    pub q chan int
}

pub fn cond() Cond {
    ch := chan int{cap: COND_SIGNAL_CAPACITY}
    << Cond{q: ch}
}

pub fn (c $&Cond) wait(m $&Mutex) {
    m.unlock()
    tok := <-c.q
    if tok != 1 {
        eprintln("sync: corrupted cond")
        <<< 1
    }
    m.lock()
}

pub fn (c $&Cond) signal() {
    select {
        c.q <- 1 {
        }
        else {
        }
    }
}

pub fn (c $&Cond) broadcast() {
    $i := 0
    while i < COND_SIGNAL_CAPACITY {
        $stop := 0
        select {
            c.q <- 1 {
                i = i + 1
            }
            else {
                stop = 1
            }
        }
        if stop != 0 {
            i = COND_SIGNAL_CAPACITY
        }
    }
}

// ===== Map (Go sync.Map subset; thread-safe map) =====
// Uses RWMutex for concurrent reads and exclusive writes.
// Keys and values are strings; values are owned copies.

pub struct MapVal {
    pub value string
    pub found bool
}

pub struct MapEntry {
    pub key string
    pub val string
    pub active bool
}

pub struct Map {
    pub mu RWMutex
    pub entries []MapEntry
}

pub fn sync_map() Map {
    $e := []MapEntry{}
    << Map{mu: rw_mutex(), entries: e}
}

fn (m $&Map) rlock() {
    mu := $&m.mu
    mu.read_lock()
}

fn (m $&Map) runlock() {
    mu := $&m.mu
    mu.read_unlock()
}

fn (m $&Map) wlock() {
    mu := $&m.mu
    mu.write_lock()
}

fn (m $&Map) wunlock() {
    mu := $&m.mu
    mu.write_unlock()
}

pub fn (m $&Map) load(key &string) MapVal {
    m.rlock()
    $i := 0
    k := key + ""
    while i < m.entries.len {
        e := m.entries[i]
        if e.active && e.key == k {
            v := e.val + ""
            m.runlock()
            << MapVal{value: v, found: true}
        }
        i = i + 1
    }
    m.runlock()
    << MapVal{value: "", found: false}
}

pub fn (m $&Map) store(key string, val string) {
    m.wlock()
    $i := 0
    $found := false
    while i < m.entries.len {
        if m.entries[i].key == key {
            m.entries[i].val = val + ""
            m.entries[i].active = true
            found = true
            i = m.entries.len
        } else {
            i = i + 1
        }
    }
    if !found {
        m.entries.push(MapEntry{key: key + "", val: val + "", active: true})
    }
    m.wunlock()
}

pub fn (m $&Map) delete(key &string) {
    m.wlock()
    $i := 0
    k := key + ""
    while i < m.entries.len {
        if m.entries[i].key == k {
            m.entries[i].active = false
            i = m.entries.len
        } else {
            i = i + 1
        }
    }
    m.wunlock()
}

pub fn (m $&Map) load_or_store(key string, val string) MapVal {
    m.wlock()
    $i := 0
    while i < m.entries.len {
        e := m.entries[i]
        if e.active && e.key == key {
            v := e.val + ""
            m.wunlock()
            << MapVal{value: v, found: true}
        }
        i = i + 1
    }
    m.entries.push(MapEntry{key: key + "", val: val + "", active: true})
    m.wunlock()
    << MapVal{value: val, found: false}
}

pub fn (m $&Map) load_and_delete(key &string) MapVal {
    m.wlock()
    $i := 0
    k := key + ""
    while i < m.entries.len {
        if m.entries[i].active && m.entries[i].key == k {
            v := m.entries[i].val + ""
            m.entries[i].active = false
            m.wunlock()
            << MapVal{value: v, found: true}
        }
        i = i + 1
    }
    m.wunlock()
    << MapVal{value: "", found: false}
}

pub fn (m $&Map) len() int {
    m.rlock()
    $count := 0
    $i := 0
    while i < m.entries.len {
        if m.entries[i].active {
            count = count + 1
        }
        i = i + 1
    }
    m.runlock()
    << count
}

// ===== Pool (Go sync.Pool subset; lock-free temporary object cache) =====
// Uses a buffered channel for non-blocking put and get across coroutines.
// If the pool is at capacity, put drops the item without blocking.
// If the pool is empty, get returns found=false without blocking.

pub struct Pool {
    pub ch chan string
}

pub fn pool(capacity int) Pool {
    $cap := capacity
    if cap <= 0 {
        cap = 256
    }
    c := chan string{cap: cap}
    << Pool{ch: c}
}

pub fn (p &Pool) put(val string) {
    select {
        p.ch <- val {
        }
        else {
        }
    }
}

pub fn (p &Pool) get() MapVal {
    select {
        v := <- p.ch {
            << MapVal{value: v, found: true}
        }
        else {
            << MapVal{value: "", found: false}
        }
    }
}


