@sync

// Mutex and WaitGroup are owning channel handles, not user-visible pointers
// and not atomic.Pointer. The token lives in the runtime channel object;
// copies of Mutex share that object (like Go channel variables). Protected
// data still must move through channels — &mut must not cross xu (S6).

pub struct Mutex {
    pub tok chan int
}

pub struct WaitGroup {
    pub done chan int
    pub pending int
}

pub fn mutex() Mutex {
    ch := chan int{cap: 1}
    ch <- 1
    << Mutex{tok: ch}
}

pub fn (m &mut Mutex) lock() {
    tok := <- m.tok
    if tok != 1 {
        eprintln("sync: corrupted mutex")
        <<< 1
    }
}

pub fn (m &mut Mutex) unlock() {
    select {
        m.tok <- 1 {
        }
        else {
            eprintln("sync: unlock of unlocked mutex")
            <<< 1
        }
    }
}

pub fn wait_group() WaitGroup {
    ch := chan int{cap: 0}
    << WaitGroup{done: ch, pending: 0}
}

pub fn (w &mut WaitGroup) add(delta int) {
    w.pending = w.pending + delta
}

pub fn (w &mut WaitGroup) done() {
    w.done <- 1
}

pub fn (w &mut WaitGroup) wait(n int) {
    mut i := 0
    while i < n {
        tok := <- w.done
        if tok != 1 {
            eprintln("sync: waitgroup token")
            <<< 1
        }
        i = i + 1
    }
}

pub fn (w &mut WaitGroup) wait_pending() {
    n := w.pending
    w.wait(n)
    w.pending = 0
}

// ===== sync/atomic (Go sync/atomic, int-sized) =====
// The runtime builtins are atomic_load / atomic_store / atomic_add /
// atomic_cas — the `atomic_` prefix keeps them distinct from the wrapper
// names below (the same M28 shadowing rule as the os package: a wrapper
// named `atomic_load` would shadow the builtin and self-recurse). Each
// builtin takes a mutable int location (`&mut int`; callers write `mut &x`).
// add returns the old value; cas returns a bool.

pub fn load_int(x &mut int) int {
    << atomic_load(x)
}

pub fn store_int(x &mut int, v int) {
    atomic_store(x, v)
}

pub fn add_int(x &mut int, d int) int {
    << atomic_add(x, d)
}

pub fn compare_and_swap_int(x &mut int, old int, new int) bool {
    << atomic_cas(x, old, new)
}

// ===== Once (Go sync.Once subset) =====
// `do(f)` runs f at most once (M104 named fn values). `first_time()` remains
// for call sites that prefer an explicit branch.

pub struct Once {
    pub state int
    pub mu Mutex
}

pub fn once() Once {
    << Once{state: 0, mu: mutex()}
}

fn (o &mut Once) lock_mu() {
    mu := mut &o.mu
    mu.lock()
}

fn (o &mut Once) unlock_mu() {
    mu := mut &o.mu
    mu.unlock()
}

pub fn (o &mut Once) first_time() bool {
    if atomic_load(mut &o.state) != 0 {
        << false
    }
    o.lock_mu()
    if o.state != 0 {
        o.unlock_mu()
        << false
    }
    o.state = 1
    o.unlock_mu()
    << true
}

pub fn (o &mut Once) do(f fn()) {
    if o.first_time() {
        f()
    }
}

// ===== RWMutex (Go sync.RWMutex; reads do not run in parallel) =====
// a single Mutex plus a reader count. Writers take the mutex; a reader
// takes it on entry (first-in) and releases it on exit (last-out), so reads
// serialize with each other and with writers — a documented divergence from
// Go's parallel reads.

pub struct RWMutex {
    pub mu Mutex
    pub readers int
}

pub fn rw_mutex() RWMutex {
    << RWMutex{mu: mutex(), readers: 0}
}

fn (m &mut RWMutex) lock_mu() {
    mu := mut &m.mu
    mu.lock()
}

fn (m &mut RWMutex) unlock_mu() {
    mu := mut &m.mu
    mu.unlock()
}

pub fn (m &mut RWMutex) read_lock() {
    m.lock_mu()
    m.readers = m.readers + 1
}

pub fn (m &mut RWMutex) read_unlock() {
    if m.readers <= 0 {
        eprintln("sync: read_unlock without read_lock")
        <<< 1
    }
    m.readers = m.readers - 1
    m.unlock_mu()
}

pub fn (m &mut RWMutex) write_lock() {
    m.lock_mu()
}

pub fn (m &mut RWMutex) write_unlock() {
    m.unlock_mu()
}

// ===== Cond (Go sync.Cond subset; M144) =====
// Locker is the Mutex passed to wait — no Locker interface. Callers must
// re-check the condition after wait returns (same contract as Go).
// Notify is a shared channel so Cond values may be copied across `xu`
// (handles share the runtime object). No per-copy waiter counter.

pub struct Cond {
    pub q chan int
}

pub fn cond() Cond {
    ch := chan int{cap: 64}
    << Cond{q: ch}
}

pub fn (c &mut Cond) wait(m &mut Mutex) {
    m.unlock()
    tok := <-c.q
    if tok != 1 {
        eprintln("sync: corrupted cond")
        <<< 1
    }
    m.lock()
}

pub fn (c &mut Cond) signal() {
    select {
        c.q <- 1 {
        }
        else {
        }
    }
}

pub fn (c &mut Cond) broadcast() {
    mut i := 0
    while i < 64 {
        mut stop := 0
        select {
            c.q <- 1 {
                i = i + 1
            }
            else {
                stop = 1
            }
        }
        if stop != 0 {
            i = 64
        }
    }
}
