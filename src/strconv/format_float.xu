@strconv

#errors

// ---- f64 formatting ----

fn f_abs(f f64) f64 {
    if f < 0.0 {
        << 0.0 - f
    }
    << f
}

struct Mb {
    m int
    b int
}

// Extract the exact binary representation f = m * 2^b with m in [2^52, 2^53),
// without touching the float's bits: normalize by *2 or /2, then truncate.
fn decompose(f f64) Mb {
    mut a := f_abs(f)
    mut c := 0
    while a >= 2.0 {
        a = a / 2.0
        c += 1
    }
    while a < 1.0 {
        a = a * 2.0
        c -= 1
    }
    m := int(a * f64(F_SPLIT))
    << Mb{m: m, b: c - 52}
}

struct Dp2 {
    d []int
    p int
}

// Exact decimal: value = d / 10^p (d a bignum).
fn exact_decimal(m int, b int) Dp2 {
    if b >= 0 {
        base := big_from_int(m)
        << Dp2{d: big_shl(&base, b), p: 0}
    }
    mut d := big_from_int(m)
    mut i := 0
    k := 0 - b
    while i < k {
        d = big_mul_small(&d, 5)
        i += 1
    }
    << Dp2{d: d, p: k}
}

// Decimal digits of a bignum, most significant first.
fn big_digits(a &[]int) []int {
    if a.len == 0 {
        << [0]
    }
    mut rev := []int{}
    mut x := []int{}
    for i in 0:a.len {
        x.push(a[i])
    }
    while x.len > 0 {
        // divide x by 10 in place, remainder is the next digit (little-end first)
        mut carry := 0
        mut i := x.len - 1
        while i >= 0 {
            cur := (carry << F_LB) | x[i]
            x[i] = cur / 10
            carry = cur % 10
            i -= 1
        }
        rev.push(carry)
        mut n := x.len
        while n > 0 {
            if x[n - 1] != 0 {
                <-
            }
            n -= 1
        }
        mut trimmed := []int{}
        for j in 0:n {
            trimmed.push(x[j])
        }
        x = trimmed
    }
    mut out := []int{}
    mut i := rev.len - 1
    while i >= 0 {
        out.push(rev[i])
        i -= 1
    }
    << out
}

struct Dec {
    d []int
    nd int
    dp int
    neg bool
}

struct RoundMeta {
    nd int
    dp int
    neg bool
}

// Round decimal digits to n significant digits (half-even, tie-aware).
// Returns digit slice only; nd/dp/neg written through meta.
// Gen1: returning `Dec` (embedded []int) can poison d[0] at the caller.
fn round_to(dd &Dec, n0 int, meta &mut RoundMeta) []int {
    mut n := n0
    if n < 0 {
        n = 0
    }
    meta.dp = dd.dp
    meta.neg = dd.neg
    if n >= dd.nd {
        mut nd2 := dd.nd
        while nd2 > 0 {
            idx := nd2 - 1
            if dd.d[idx] != 0 {
                <-
            }
            nd2 -= 1
        }
        mut dd2 := []int{}
        for i in 0:dd.nd {
            dd2.push(dd.d[i])
        }
        meta.nd = nd2
        << dd2
    }
    mut d := []int{}
    for i in 0:dd.nd {
        d.push(dd.d[i])
    }
    mut up := false
    if d[n] > 5 {
        up = true
    } else if d[n] == 5 {
        mut all_zero := true
        mut j := n + 1
        while j < dd.nd {
            if d[j] != 0 {
                all_zero = false
            }
            j += 1
        }
        if !all_zero {
            up = true
        } else if n > 0 {
            prev := n - 1
            if (d[prev] & 1) == 1 {
                up = true
            }
        }
    }
    if !up {
        mut nd2 := n
        while nd2 > 0 {
            idx := nd2 - 1
            if d[idx] != 0 {
                <-
            }
            nd2 -= 1
        }
        meta.nd = nd2
        << d
    }
    mut i := n - 1
    while i >= 0 {
        if d[i] < 9 {
            d[i] = d[i] + 1
            mut nd2 := i + 1
            while nd2 > 0 {
                idx := nd2 - 1
                if d[idx] != 0 {
                    <-
                }
                nd2 -= 1
            }
            meta.nd = nd2
            << d
        }
        d[i] = 0
        i -= 1
    }
    meta.nd = 1
    meta.dp = dd.dp + 1
    << [1]
}

fn max_i(a int, b int) int {
    if a > b {
        << a
    }
    << b
}

// fmtE: -d.dddde±dd (prec digits after the point).
fn fmt_e(d &[]int, nd int, dp int, neg bool, prec int) string {
    mut out := []int{}
    if neg {
        out.push(45)
    }
    if nd == 0 {
        out.push(48)
    } else {
        out.push(48 + d[0])
    }
    if prec > 0 {
        out.push(46)
        mut i := 1
        while i <= prec {
            if i < nd {
                out.push(48 + d[i])
            } else {
                out.push(48)
            }
            i += 1
        }
    }
    out.push(101)
    mut exp := dp - 1
    if nd == 0 {
        exp = 0
    }
    if exp < 0 {
        out.push(45)
        exp = 0 - exp
    } else {
        out.push(43)
    }
    if exp < 10 {
        out.push(48)
        out.push(48 + exp)
    } else if exp < 100 {
        out.push(48 + exp / 10)
        out.push(48 + exp % 10)
    } else {
        out.push(48 + exp / 100)
        out.push(48 + (exp / 10) % 10)
        out.push(48 + exp % 10)
    }
    << string_from_bytes(out)
}

// fmtF: -dddddddddd (prec digits after the point).
fn fmt_f(d &[]int, nd int, dp int, neg bool, prec int) string {
    mut out := []int{}
    if neg {
        out.push(45)
    }
    if dp > 0 {
        mut m := nd
        if m > dp {
            m = dp
        }
        for i in 0:m {
            out.push(48 + d[i])
        }
        mut j := m
        while j < dp {
            out.push(48)
            j += 1
        }
    } else {
        out.push(48)
    }
    if prec > 0 {
        out.push(46)
        for i in 0:prec {
            j := dp + i
            if j >= 0 && j < nd {
                out.push(48 + d[j])
            } else {
                out.push(48)
            }
        }
    }
    << string_from_bytes(out)
}

// The 'g' decision logic, mirroring Go's formatDigits; 'e'/'f' route through.
fn format_digits(d &[]int, nd int, dp int, neg bool, shortest bool, verb int, prec int) string {
    if verb == 101 {
        << fmt_e(d, nd, dp, neg, prec)
    }
    if verb == 102 {
        << fmt_f(d, nd, dp, neg, prec)
    }
    mut eprec := prec
    if eprec > nd && nd >= dp {
        eprec = nd
    }
    if shortest {
        eprec = 6
    }
    exp := dp - 1
    mut p := prec
    if exp < -4 || exp >= eprec {
        if p > nd {
            p = nd
        }
        << fmt_e(d, nd, dp, neg, p - 1)
    }
    if p > dp {
        p = nd
    }
    << fmt_f(d, nd, dp, neg, max_i(p - dp, 0))
}

// Shortest round-trip digits: start at 17 significant digits, decrement while
// the 'e' rendering still parses back to f.
fn shortest_digits(f f64, dd &Dec, meta &mut RoundMeta) []int {
    mut k := 17
    while k >= 1 {
        d := round_to(dd, k, meta)
        s := fmt_e(&d, meta.nd, meta.dp, meta.neg, k - 1)
        v := parse_float(&s) or (err) {
            << round_to(dd, k + 1, meta)
        }
        if v != f {
            << round_to(dd, k + 1, meta)
        }
        k -= 1
    }
    << round_to(dd, 1, meta)
}

// FormatFloat(f, byte, prec, 64): verbs 'f'(102), 'e'(101), 'g'(103).
pub fn format_float(f f64, verb int, prec int) string {
    if verb != 101 && verb != 102 && verb != 103 {
        >> errors.new("strconv: unknown format verb")
    }
    if f != f {
        << "NaN"
    }
    if is_inf(f) {
        if f < 0.0 {
            << "-Inf"
        }
        << "+Inf"
    }
    mut neg := false
    if f < 0.0 {
        neg = true
    } else if f == 0.0 {
        if 1.0 / f < 0.0 {
            neg = true
        }
    }
    if f == 0.0 {
        z := []int{}
        << format_digits(&z, 0, 0, neg, prec < 0, verb, prec)
    }
    mbv := decompose(f_abs(f))
    ex := exact_decimal(mbv.m, mbv.b)
    ds := big_digits(&ex.d)
    dp := ds.len - ex.p
    mut nd := ds.len
    while nd > 0 {
        if ds[nd - 1] != 0 {
            <-
        }
        nd -= 1
    }
    dd := Dec{d: ds, nd: nd, dp: dp, neg: neg}
    shortest := prec < 0
    mut p := prec
    mut out_d := []int{}
    mut out_nd := 0
    mut out_dp := 0
    mut out_neg := neg
    mut meta := RoundMeta{nd: 0, dp: 0, neg: false}
    if shortest {
        out_d = shortest_digits(f, &dd, mut &meta)
        out_nd = meta.nd
        out_dp = meta.dp
        out_neg = meta.neg
        if verb == 101 {
            p = out_nd - 1
            if p < 0 {
                p = 0
            }
        } else if verb == 102 {
            p = out_nd - out_dp
            if p < 0 {
                p = 0
            }
        } else {
            p = out_nd
        }
    } else {
        if verb == 102 {
            out_d = round_to(&dd, dd.dp + prec, mut &meta)
        } else if verb == 101 {
            out_d = round_to(&dd, prec + 1, mut &meta)
        } else {
            if prec == 0 {
                p = 1
            }
            out_d = round_to(&dd, p, mut &meta)
        }
        out_nd = meta.nd
        out_dp = meta.dp
        out_neg = meta.neg
    }
    << format_digits(&out_d, out_nd, out_dp, out_neg, shortest, verb, p)
}
