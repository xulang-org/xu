@strconv

#errors

fn is_inf(f f64) bool {
    << f + f == f && f != 0.0
}

fn str_eq_ci_range(s &string, from int, lit string) bool {
    if s.len - from != lit.len {
        << false
    }
    for i in 0:lit.len {
        $ca := s[from + i]
        $cb := lit[i]
        if ca >= 65 && ca <= 90 {
            ca = ca + 32
        }
        if cb >= 65 && cb <= 90 {
            cb = cb + 32
        }
        if ca != cb {
            << false
        }
    }
    << true
}

// ParseFloat(s, 64): sign / int / fraction / exponent, plus NaN and
// (optionally signed) Inf / Infinity, matched case-insensitively.
pub fn parse_float(s &string) f64 {
    src := s + ""
    if src.len == 0 {
        >> errors.new("parse_float: invalid syntax")
    }
    if str_eq_ci_range(&src, 0, "nan") {
        << 0.0 / 0.0
    }
    $start := 0
    $neg := false
    if src[0] == 43 || src[0] == 45 {
        neg = src[0] == 45
        start = 1
    }
    if str_eq_ci_range(&src, start, "inf") || str_eq_ci_range(&src, start, "infinity") {
        if neg {
            << -1.0 / 0.0
        }
        << 1.0 / 0.0
    }
    $i := start
    $mant := []int{}
    $e10 := 0
    $saw_digit := false
    while i < src.len {
        c := src[i]
        if c < 48 || c > 57 {
            <-
        }
        mant = big_append_digit(&mant, c - 48)
        saw_digit = true
        i += 1
    }
    if i < src.len && src[i] == 46 {
        i += 1
        while i < src.len {
            c := src[i]
            if c < 48 || c > 57 {
                <-
            }
            mant = big_append_digit(&mant, c - 48)
            e10 -= 1
            saw_digit = true
            i += 1
        }
    }
    if !saw_digit {
        >> errors.new("parse_float: invalid syntax")
    }
    $exp10 := 0
    if i < src.len && (src[i] == 101 || src[i] == 69) {
        i += 1
        $eneg := false
        if i < src.len && (src[i] == 43 || src[i] == 45) {
            eneg = src[i] == 45
            i += 1
        }
        $exp_digits := 0
        while i < src.len {
            c := src[i]
            if c < 48 || c > 57 {
                <-
            }
            if exp10 < 100000 {
                exp10 = exp10 * 10 + (c - 48)
            }
            exp_digits += 1
            i += 1
        }
        if exp_digits == 0 {
            >> errors.new("parse_float: invalid syntax")
        }
        if eneg {
            exp10 = 0 - exp10
        }
    }
    if i != src.len {
        >> errors.new("parse_float: invalid syntax")
    }
    e := e10 + exp10
    $result := 0.0
    if mant.len == 0 {
        result = 0.0
    } else if e > 400 {
        result = 1.0 / 0.0
    } else if e < -400 {
        result = 0.0
    } else if e >= 0 {
        $n := big_trim(&mant)
        $j := 0
        while j < e {
            n = big_mul_small(&n, 10)
            j += 1
        }
        one := big_one()
        result = round_ratio(&n, &one)
    } else {
        $d := big_one()
        $j := 0
        while j < 0 - e {
            d = big_mul_small(&d, 10)
            j += 1
        }
        result = round_ratio(&mant, &d)
    }
    if neg {
        result = result * -1.0
    }
    if is_inf(result) {
        >> errors.new("parse_float: value out of range")
    }
    << result
}
