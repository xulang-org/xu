@strconv

#errors
#unicode/utf8
#unicode

// Integer/bool conversions aligned with Go `strconv` (Itoa/Atoi, ParseInt
// / FormatInt for bases 2/8/10/16, ParseBool/FormatBool).
// Overflow is Err, never a wrapped value that could be used as a size or
// pointer. No 0x prefix, no base 0, no '+' sign (matches builtin parse_int).

fn base_ok(base int) bool {
    if base == 2 {
        << true
    }
    if base == 8 {
        << true
    }
    if base == 10 {
        << true
    }
    if base == 16 {
        << true
    }
    << false
}

fn digit_val(c int) int {
    if c >= 48 {
        if c <= 57 {
            << c - 48
        }
    }
    if c >= 97 {
        if c <= 102 {
            << c - 87
        }
    }
    if c >= 65 {
        if c <= 70 {
            << c - 55
        }
    }
    << -1
}

fn int_min() int {
    << 0 - 9223372036854775807 - 1
}

pub fn atoi(s &string) int {
    << parse(s, 10)
}

pub fn itoa(n int) string {
    << str(n)
}

pub fn format_bool(b bool) string {
    if b {
        << "true"
    }
    << "false"
}

pub fn parse_bool(s &string) bool {
    src := *s
    if src == "1" {
        << true
    }
    if src == "t" {
        << true
    }
    if src == "T" {
        << true
    }
    if src == "true" {
        << true
    }
    if src == "TRUE" {
        << true
    }
    if src == "True" {
        << true
    }
    if src == "0" {
        << false
    }
    if src == "f" {
        << false
    }
    if src == "F" {
        << false
    }
    if src == "false" {
        << false
    }
    if src == "FALSE" {
        << false
    }
    if src == "False" {
        << false
    }
    >> errors.new("strconv: invalid bool")
}

fn div_base(x int, base int) int {
    if base == 2 {
        << x / 2
    }
    if base == 8 {
        << x / 8
    }
    if base == 16 {
        << x / 16
    }
    << x / 10
}

fn mod_base(x int, base int) int {
    if base == 2 {
        << x % 2
    }
    if base == 8 {
        << x % 8
    }
    if base == 16 {
        << x % 16
    }
    << x % 10
}

fn lim_base(maxp int, base int) int {
    if base == 2 {
        << maxp / 2
    }
    if base == 8 {
        << maxp / 8
    }
    if base == 16 {
        << maxp / 16
    }
    << maxp / 10
}

pub fn format_int(n int, base int) string {
    if !base_ok(base) {
        >> errors.new("strconv: unsupported base")
    }
    if n == 0 {
        << "0"
    }
    mut x := n
    mut neg := false
    if n < 0 {
        neg = true
    }
    mut digits := []int{}
    while x != 0 {
        mut d := mod_base(x, base)
        x = div_base(x, base)
        if d < 0 {
            d = 0 - d
            x = 0 - x
        }
        if d < 10 {
            digits.push(48 + d)
        } else {
            digits.push(87 + d)
        }
    }
    mut outb := []int{}
    if neg {
        outb.push(45)
    }
    mut i := digits.len
    while i > 0 {
        i = i - 1
        outb.push(digits[i])
    }
    << string_from_bytes(outb)
}

fn parse_decimal_short(s &string, start int) int {
    mut acc := 0
    for i in start:s.len {
        d := s[i] - 48
        if d < 0 || d > 9 { << -1 }
        acc = acc * 10 + d
    }
    << acc
}

pub fn parse(s &string, base int) int {
    // Short decimal inputs bypass throw-wrapper overhead with a borrowed leaf.
    // The sign does not count toward the 18-digit bound. Longer inputs retain
    // the generic checked path for INT_MIN/overflow validation.
    if base == 10 {
        mut start := 0
        mut neg := false
        if s.len > 0 && s[0] == 45 {
            neg = true
            start = 1
        }
        rem := s.len - start
        if rem > 0 && rem <= 18 {
            val := parse_decimal_short(s, start)
            if val >= 0 {
                if neg { << 0 - val }
                << val
            }
        }
    }
    if !base_ok(base) {
        >> errors.new("strconv: unsupported base")
    }
    if s.len == 0 {
        >> errors.new("parse_int: invalid integer")
    }
    mut i := 0
    mut neg := false
    if s[0] == 45 {
        neg = true
        i = 1
        if s.len == 1 {
            >> errors.new("parse_int: invalid integer")
        }
    }
    maxp := 9223372036854775807
    mut acc := 0
    mut saw_digit := false
    lim := lim_base(maxp, base)
    while i < s.len {
        d := digit_val(s[i])
        if d < 0 {
            >> errors.new("parse_int: invalid integer")
        }
        if d >= base {
            >> errors.new("parse_int: invalid integer")
        }
        mut last := false
        if i == s.len - 1 {
            last = true
        }
        if acc > lim {
            if neg {
                if d == 0 {
                    if last {
                        if acc == lim + 1 {
                            << int_min()
                        }
                    }
                }
            }
            >> errors.new("parse_int: out of range")
        }
        prod := acc * base
        room := maxp - prod
        if room < d {
            if neg {
                if last {
                    if room == d - 1 {
                        << int_min()
                    }
                }
            }
            >> errors.new("parse_int: out of range")
        }
        acc = prod + d
        saw_digit = true
        i = i + 1
    }
    if !saw_digit {
        >> errors.new("parse_int: invalid integer")
    }
    if neg {
        << 0 - acc
    }
    << acc
}

// ===================== f64 parsing / formatting (m34) =====================
// parse_float / format_float aligned with Go strconv.ParseFloat(s, 64) and
// strconv.FormatFloat(f, byte, prec, 64). All decimal<->binary conversion is
// done with an exact little-endian base-2^30 bignum (no float bits, no
// recursion); f64 is only touched at the boundary (f64(int) / int(f64) casts
// and ieee arithmetic), so results are correctly rounded and byte-identical
// with Go for the fixture vectors.


pub fn format_uint(n int, base int) string {
    if n < 0 {
        >> errors.new("strconv: unsigned of negative")
    }
    << format_int(n, base)
}

pub fn parse_uint(s &string, base int) int {
    src := *s
    if src.len > 0 && src[0] == 45 {
        >> errors.new("strconv: negative uint")
    }
    << parse(&src, base)
}

pub fn quote(s &string) string {
    src := *s
    mut out := "\""
    for i in 0:src.len {
        c := src[i] & 255
        if c == 92 {
            out.push_str("\\\\")
        } else if c == 34 {
            out.push_str("\\\"")
        } else if c == 10 {
            out.push_str("\\n")
        } else if c == 9 {
            out.push_str("\\t")
        } else if c == 13 {
            out.push_str("\\r")
        } else if c < 32 || c > 126 {
            digits := "0123456789abcdef"
            out.push_str("\\x")
            out.push_byte(digits[c >> 4])
            out.push_byte(digits[c & 15])
        } else {
            out.push_byte(c)
        }
    }
    out.push_str("\"")
    << out
}

pub fn unquote(s &string) string {
    src := *s
    if src.len < 2 || src[0] != 34 || src[src.len - 1] != 34 {
        >> errors.new("strconv: invalid quoted string")
    }
    mut out := ""
    mut i := 1
    while i < src.len - 1 {
        c := src[i] & 255
        if c != 92 {
            out.push_byte(c)
            i = i + 1
        } else {
            if i + 1 >= src.len - 1 {
                >> errors.new("strconv: invalid escape")
            }
            n := src[i + 1] & 255
            if n == 110 {
                out.push_byte(10)
                i = i + 2
            } else if n == 116 {
                out.push_byte(9)
                i = i + 2
            } else if n == 114 {
                out.push_byte(13)
                i = i + 2
            } else if n == 92 {
                out.push_byte(92)
                i = i + 2
            } else if n == 34 {
                out.push_byte(34)
                i = i + 2
            } else if n == 120 {
                if i + 3 >= src.len - 1 {
                    >> errors.new("strconv: invalid escape")
                }
                hi := digit_val(src[i + 2] & 255)
                lo := digit_val(src[i + 3] & 255)
                if hi < 0 || lo < 0 {
                    >> errors.new("strconv: invalid escape")
                }
                out.push_byte(hi * 16 + lo)
                i = i + 4
            } else {
                >> errors.new("strconv: invalid escape")
            }
        }
    }
    << out
}

fn hex_pad(n int, w int) string {
    digits := "0123456789abcdef"
    mut out := ""
    mut i := w - 1
    while i >= 0 {
        d := (n >> (i * 4)) & 15
        out.push_byte(digits[d])
        i = i - 1
    }
    << out
}

// QuoteRune: single-quoted Go character literal. Printable Unicode is kept
// as UTF-8; C0/c1 and other non-ASCII-controls use \x / \u / \U. Not a full
// unicode.IsPrint table — runes >= 0xA0 are emitted as themselves.
pub fn quote_rune(r int) string {
    mut rr := r
    if !utf8.valid_rune(rr) {
        rr = 0xFFFD
    }
    mut inner := ""
    if rr == 39 {
        inner = "\\'"
    } else if rr == 92 {
        inner = "\\\\"
    } else if rr == 7 {
        inner = "\\a"
    } else if rr == 8 {
        inner = "\\b"
    } else if rr == 9 {
        inner = "\\t"
    } else if rr == 10 {
        inner = "\\n"
    } else if rr == 11 {
        inner = "\\v"
    } else if rr == 12 {
        inner = "\\f"
    } else if rr == 13 {
        inner = "\\r"
    } else if rr >= 32 && rr != 127 && rr < 128 {
        inner = ""
        inner.push_byte(rr)
    } else if rr >= 160 {
        inner = utf8.encode(rr) or (err) {
            << "'\\uFFFD'"
        }
    } else if rr < 256 {
        inner = "\\x" + hex_pad(rr, 2)
    } else if rr < 0x10000 {
        inner = "\\u" + hex_pad(rr, 4)
    } else {
        inner = "\\U" + hex_pad(rr, 8)
    }
    << "'" + inner + "'"
}

pub fn is_print(r int) bool {
    << unicode.is_print(r)
}

pub fn is_graphic(r int) bool {
    << unicode.is_graphic(r)
}

pub fn quote_rune_to_ascii(r int) string {
    mut rr := r
    if !utf8.valid_rune(rr) {
        rr = 0xFFFD
    }
    mut inner := ""
    if rr == 39 {
        inner = "\\'"
    } else if rr == 92 {
        inner = "\\\\"
    } else if rr == 7 {
        inner = "\\a"
    } else if rr == 8 {
        inner = "\\b"
    } else if rr == 9 {
        inner = "\\t"
    } else if rr == 10 {
        inner = "\\n"
    } else if rr == 11 {
        inner = "\\v"
    } else if rr == 12 {
        inner = "\\f"
    } else if rr == 13 {
        inner = "\\r"
    } else if rr >= 32 && rr != 127 && rr < 128 {
        inner = ""
        inner.push_byte(rr)
    } else if rr < 128 {
        inner = "\\x" + hex_pad(rr, 2)
    } else if rr < 0x10000 {
        inner = "\\u" + hex_pad(rr, 4)
    } else {
        inner = "\\U" + hex_pad(rr, 8)
    }
    << "'" + inner + "'"
}

pub fn quote_to_ascii(s &string) string {
    src := s + ""
    mut out := "\""
    mut i := 0
    while i < src.len {
        r := utf8.decode(&src, i) or (err) {
            c := src[i] & 255
            out = out + "\\x" + hex_pad(c, 2)
            i = i + 1
            ->
        }
        w := utf8.rune_len(r) or (err) {
            c := src[i] & 255
            out = out + "\\x" + hex_pad(c, 2)
            i = i + 1
            ->
        }
        if r == 34 {
            out = out + "\\\""
        } else if r == 92 {
            out = out + "\\\\"
        } else if r == 7 {
            out = out + "\\a"
        } else if r == 8 {
            out = out + "\\b"
        } else if r == 9 {
            out = out + "\\t"
        } else if r == 10 {
            out = out + "\\n"
        } else if r == 11 {
            out = out + "\\v"
        } else if r == 12 {
            out = out + "\\f"
        } else if r == 13 {
            out = out + "\\r"
        } else if r >= 32 && r != 127 && r < 128 {
            out.push_byte(r)
        } else if r < 128 {
            out = out + "\\x" + hex_pad(r, 2)
        } else if r < 0x10000 {
            out = out + "\\u" + hex_pad(r, 4)
        } else {
            out = out + "\\U" + hex_pad(r, 8)
        }
        i = i + w
    }
    out = out + "\""
    << out
}

pub fn append_quote_to_ascii(dst string, s &string) string {
    << dst + quote_to_ascii(s)
}

pub fn append_quote_rune_to_ascii(dst string, r int) string {
    << dst + quote_rune_to_ascii(r)
}

pub fn quoted_prefix(s &string) string {
    src := s + ""
    if src.len < 2 {
        >> errors.new("strconv: invalid quoted prefix")
    }
    q := src[0] & 255
    if q != 34 && q != 39 {
        >> errors.new("strconv: invalid quoted prefix")
    }
    mut i := 1
    while i < src.len {
        c := src[i] & 255
        if c == 92 {
            if i + 1 >= src.len {
                >> errors.new("strconv: invalid quoted prefix")
            }
            i = i + 2
            ->
        }
        if c == q {
            << src[0:(i + 1)] + ""
        }
        i = i + 1
    }
    >> errors.new("strconv: invalid quoted prefix")
    << ""
}

pub fn can_backquote(s &string) bool {
    src := s + ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c < 32 || c == 96 || c == 127 {
            << false
        }
        i = i + 1
    }
    << true
}

pub fn append_int(dst string, n int, base int) string {
    t := format_int(n, base) or >>
    << dst + t
}

pub fn append_uint(dst string, n int, base int) string {
    t := format_uint(n, base) or >>
    << dst + t
}

pub fn append_bool(dst string, b bool) string {
    << dst + format_bool(b)
}

pub fn append_quote(dst string, s &string) string {
    << dst + quote(s)
}

pub fn append_quote_rune(dst string, r int) string {
    << dst + quote_rune(r)
}

pub fn append_float(dst string, f f64, verb int, prec int) string {
    t := format_float(f, verb, prec) or >>
    << dst + t
}
