@strconv

const f_lb = 30
const f_lm = 1073741823 // 2^30 - 1
const f_split = 4503599627370496 // 2^52

// ---- base-2^30 bignum (little-endian limbs, non-negative) ----

fn big_trim(a &[]int) []int {
    mut n := a.len
    while n > 0 {
        if a[n - 1] != 0 {
            <-
        }
        n -= 1
    }
    mut out := []int{}
    for i in 0:n {
        out.push(a[i])
    }
    << out
}

fn big_one() []int {
    << [1]
}

fn big_from_int(x int) []int {
    if x == 0 {
        << []int{}
    }
    mut out := []int{}
    mut v := x
    while v > 0 {
        out.push(v & f_lm)
        v = v >> f_lb
    }
    << out
}

// a * 10 + d (digit accumulation, d in 0..9)
fn big_append_digit(a &[]int, d int) []int {
    mut c := []int{}
    mut carry := d
    for i in 0:a.len {
        p := a[i] * 10 + carry
        c.push(p & f_lm)
        carry = p >> f_lb
    }
    if carry > 0 {
        c.push(carry)
    }
    << big_trim(&c)
}

fn big_mul_small(a &[]int, b int) []int {
    if b == 0 {
        << []int{}
    }
    mut c := []int{}
    mut carry := 0
    for i in 0:a.len {
        p := a[i] * b + carry
        c.push(p & f_lm)
        carry = p >> f_lb
    }
    if carry > 0 {
        c.push(carry)
    }
    << big_trim(&c)
}

fn big_add(a &[]int, b &[]int) []int {
    mut n := a.len
    if b.len > n {
        n = b.len
    }
    mut c := []int{}
    mut carry := 0
    for i in 0:n {
        mut s := carry
        if i < a.len {
            s = s + a[i]
        }
        if i < b.len {
            s = s + b[i]
        }
        c.push(s & f_lm)
        carry = s >> f_lb
    }
    if carry > 0 {
        c.push(carry)
    }
    << big_trim(&c)
}

fn big_sub(a &[]int, b &[]int) []int {
    mut c := []int{}
    mut borrow := 0
    for i in 0:a.len {
        mut sb := 0
        if i < b.len {
            sb = b[i]
        }
        if sb + borrow > a[i] {
            c.push((a[i] + (1 << f_lb)) - sb - borrow)
            borrow = 1
        } else {
            c.push(a[i] - sb - borrow)
            borrow = 0
        }
    }
    << big_trim(&c)
}

fn big_cmp(a &[]int, b &[]int) int {
    na := big_trim(a)
    nb := big_trim(b)
    if na.len != nb.len {
        if na.len < nb.len {
            << -1
        }
        << 1
    }
    mut i := na.len - 1
    while i >= 0 {
        if na[i] != nb[i] {
            if na[i] < nb[i] {
                << -1
            }
            << 1
        }
        i -= 1
    }
    << 0
}

fn big_shl(a &[]int, s int) []int {
    word := s / f_lb
    bit := s % f_lb
    mut c := []int{}
    for i in 0:a.len + word + 1 {
        c.push(0)
    }
    for i in 0:a.len {
        v := a[i] << bit
        c[i + word] = c[i + word] | (v & f_lm)
        if bit > 0 {
            c[i + word + 1] = c[i + word + 1] | (a[i] >> (f_lb - bit))
        }
    }
    << big_trim(&c)
}

fn big_shr1(a &[]int) []int {
    mut c := []int{}
    for i in 0:a.len {
        mut v := a[i] >> 1
        if i + 1 < a.len {
            v = v | ((a[i + 1] & 1) << (f_lb - 1))
        }
        c.push(v)
    }
    << big_trim(&c)
}

fn big_bitlen(a &[]int) int {
    t := big_trim(a)
    if t.len == 0 {
        << 0
    }
    top := t[t.len - 1]
    mut n := 0
    mut x := top
    while x > 0 {
        x = x >> 1
        n += 1
    }
    << (t.len - 1) * f_lb + n
}

fn big_bit_of(a &[]int, i int) int {
    w := i / f_lb
    if w >= a.len {
        << 0
    }
    << (a[w] >> (i % f_lb)) & 1
}

fn cmp_ratio_pow2(n &[]int, d &[]int, p int) int {
    if p >= 0 {
        sh := big_shl(d, p)
        << big_cmp(n, &sh)
    }
    sh := big_shl(n, 0 - p)
    << big_cmp(&sh, d)
}

struct Qr {
    q []int
    r []int
}

fn big_div_shift(a &[]int, d &[]int, shift int) Qr {
    mut rem := []int{}
    mut q := []int{}
    total := big_bitlen(a) + shift
    mut i := total - 1
    while i >= 0 {
        rem = big_shl(&rem, 1)
        if i >= shift {
            if big_bit_of(a, i - shift) == 1 {
                one := big_one()
                rem = big_add(&rem, &one)
            }
        }
        mut qb := 0
        cmp_res := big_cmp(&rem, d)
        if cmp_res >= 0 {
            rem = big_sub(&rem, d)
            qb = 1
        }
        q = big_shl(&q, 1)
        if qb == 1 {
            one := big_one()
            q = big_add(&q, &one)
        }
        i -= 1
    }
    << Qr{q: q, r: rem}
}

// Convert a (small, < 2^63) bignum back to a plain int.
fn big_to_int(a &[]int) int {
    mut m := 0
    mut i := a.len - 1
    while i >= 0 {
        m = (m << f_lb) | a[i]
        i -= 1
    }
    << m
}

// round(n * 2^shift / d) to nearest integer (half-even), as a bignum.
fn round_frac(n &[]int, d &[]int, shift int) []int {
    res := big_div_shift(n, d, shift)
    two_rem := big_shl(&res.r, 1)
    cmp := big_cmp(&two_rem, d)
    if cmp > 0 {
        one := big_one()
        << big_add(&res.q, &one)
    }
    if cmp == 0 {
        if (res.q[0] & 1) == 1 {
            one := big_one()
            << big_add(&res.q, &one)
        }
    }
    << big_trim(&res.q)
}

// scale x by 2^e exactly (ieee: overflows to inf, underflows gradually).
fn scale_pow2(x f64, e int) f64 {
    mut r := x
    if e >= 0 {
        mut i := 0
        while i < e {
            r = r * 2.0
            i += 1
        }
    } else {
        mut i := 0
        while i < 0 - e {
            r = r / 2.0
            i += 1
        }
    }
    << r
}

// Finish rounding: q is a 54-bit quotient (in [2^53, 2^54)); has_rem reports a
// nonzero division remainder. Rounds half-even to a 53-bit mantissa and scales.
// Caller guarantees the result is normal (k >= -1022).
fn finish_round(q &[]int, has_rem bool, k0 int) f64 {
    mut k := k0
    mut qq := big_trim(q)
    if (qq[0] & 1) == 1 {
        if has_rem || ((qq[0] >> 1) & 1) == 1 {
            one := big_one()
            qq = big_add(&qq, &one)
        }
    }
    qbl := big_bitlen(&qq)
    if qbl == 55 {
        qq = big_shr1(&qq)
        k += 1
    }
    mant := big_shr1(&qq)
    m := big_to_int(&mant)
    exp2 := k - 52
    // value = m * 2^exp2 with m in [2^52, 2^53). Overflow when exp2 >= 972.
    if exp2 >= 972 {
        << 1.0 / 0.0
    }
    << scale_pow2(f64(m), exp2)
}

// Round n/d (n>=0, d>0 bignums) to nearest-even f64 (non-negative result).
fn round_ratio(n &[]int, d &[]int) f64 {
    if n.len == 0 {
        << 0.0
    }
    nb := big_bitlen(n)
    db := big_bitlen(d)
    mut k := nb - db
    if cmp_ratio_pow2(n, d, k) < 0 {
        k -= 1
    } else if cmp_ratio_pow2(n, d, k + 1) >= 0 {
        k += 1
    }
    // Denormal / sub-denormal: value < 2^-1022. Round v * 2^1074 to an integer
    // f in [0, 2^52] and scale by 2^-1074 (this is the f64 denormal lattice).
    if k < -1022 {
        f := round_frac(n, d, 1074)
        fi := big_to_int(&f)
        if fi == 0 {
            << 0.0
        }
        if fi == (1 << 52) {
            << scale_pow2(1.0, 0 - 1022)
        }
        << scale_pow2(f64(fi), 0 - 1074)
    }
    // Normal: round to a 53-bit mantissa.
    t := 53 - k
    if t >= 0 {
        res := big_div_shift(n, d, t)
        has_rem := res.r.len > 0
        << finish_round(&res.q, has_rem, k)
    }
    d2 := big_shl(d, 0 - t)
    res := big_div_shift(n, &d2, 0)
    has_rem := res.r.len > 0
    << finish_round(&res.q, has_rem, k)
}
