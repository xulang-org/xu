@gpu/layout

#errors

// Xu format IDs describe storage, not platform enum values or device support.
pub const R8_UNORM = 1
pub const RG8_UNORM = 2
pub const RGBA8_UNORM = 3
pub const RGBA8_SRGB = 4
pub const BGRA8_UNORM = 5
pub const BGRA8_SRGB = 6
pub const R16_FLOAT = 7
pub const RG16_FLOAT = 8
pub const RGBA16_FLOAT = 9
pub const R32_FLOAT = 10
pub const RG32_FLOAT = 11
pub const RGBA32_FLOAT = 12
pub const DEPTH32_FLOAT = 13
pub const BC1_RGBA_UNORM = 14
pub const BC1_RGBA_SRGB = 15
pub const BC3_RGBA_UNORM = 16
pub const BC3_RGBA_SRGB = 17
pub const BC5_RG_UNORM = 18
pub const BC7_RGBA_UNORM = 19
pub const BC7_RGBA_SRGB = 20

pub struct FormatInfo {
    pub block_width int
    pub block_height int
    pub block_bytes int
    pub srgb bool
    pub depth bool
}
// Metadata is independent of sampler/render/storage usage support. Query the
// actual device before creating a resource with any of these formats.
pub fn format_info(format int) FormatInfo {
    $bytes := 0
    $block := 1
    if format == R8_UNORM { bytes = 1 }
    if format == RG8_UNORM || format == R16_FLOAT { bytes = 2 }
    if format == RGBA8_UNORM || format == RGBA8_SRGB || format == BGRA8_UNORM || format == BGRA8_SRGB ||
        format == RG16_FLOAT || format == R32_FLOAT || format == DEPTH32_FLOAT { bytes = 4 }
    if format == RGBA16_FLOAT || format == RG32_FLOAT { bytes = 8 }
    if format == RGBA32_FLOAT { bytes = 16 }
    if format >= BC1_RGBA_UNORM && format <= BC7_RGBA_SRGB {
        block = 4
        bytes = 16
        if format == BC1_RGBA_UNORM || format == BC1_RGBA_SRGB { bytes = 8 }
    }
    if bytes == 0 { >> errors.new("gpu/layout: unknown format") }
    << FormatInfo{block_width: block, block_height: block, block_bytes: bytes,
        srgb: format == RGBA8_SRGB || format == BGRA8_SRGB || format == BC1_RGBA_SRGB || format == BC3_RGBA_SRGB || format == BC7_RGBA_SRGB,
        depth: format == DEPTH32_FLOAT}
}
