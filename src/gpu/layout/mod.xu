@gpu/layout

#errors

const MAX_BYTES = 9223372036854775807

// One 2D mip level. size_bytes includes padding in every row, including the
// last row. offset aligns the start of this level within a transfer buffer.
pub struct Level2D {
    pub width int
    pub height int
    pub block_columns int
    pub block_rows int
    pub row_bytes int
    pub row_pitch int
    pub offset int
    pub size_bytes int
}
// Immutable computed layout. This describes logical/transfer storage, not a
// driver's physical allocation size. It owns only a bounded metadata array.
pub struct TextureLayout2D {
    levels []Level2D
    bytes int
}
pub fn (texture &TextureLayout2D) level_count() int { << texture.levels.len }
pub fn (texture &TextureLayout2D) total_bytes() int { << texture.bytes }
pub fn (texture &TextureLayout2D) level(index int) Level2D {
    if index < 0 || index >= texture.levels.len { >> errors.new("gpu/layout: mip index out of bounds") }
    << texture.levels[index]
}
fn positive_extents(width int, height int) int {
    if width < 1 || height < 1 { >> errors.new("gpu/layout: dimensions must be positive") }
    << 0
}
fn alignment_valid(alignment int) int {
    if alignment < 1 || (alignment & (alignment - 1)) != 0 {
        >> errors.new("gpu/layout: alignment must be a positive power of two")
    }
    << 0
}
fn add_bytes(a int, b int) int {
    if a < 0 || b < 0 || a > MAX_BYTES - b { >> errors.new("gpu/layout: byte size overflow") }
    << a + b
}
fn multiply_bytes(a int, b int) int {
    if b == 0 { >> errors.new("gpu/layout: byte size overflow") }
    if a < 1 || b < 0 || a > MAX_BYTES / b { >> errors.new("gpu/layout: byte size overflow") }
    << a * b
}
fn align_bytes(value int, alignment int) int {
    if alignment == 0 { >> errors.new("gpu/layout: zero alignment") }
    remainder := value % alignment
    if remainder == 0 { << value }
    << add_bytes(value, alignment - remainder) or >>
}
fn block_count(extent int, block int) int {
    if block == 0 { >> errors.new("gpu/layout: zero block extent") }
    << (extent - 1) / block + 1
}
fn next_extent(value int) int {
    if value > 1 { << value / 2 }
    << 1
}
// Full chain length, including level zero. At most 63 for positive Xu int64
// dimensions. Device-specific maximum dimensions are checked by its caller.
pub fn mip_count_2d(width int, height int) int {
    positive_extents(width, height) or >>
    $w := width
    $h := height
    $count := 1
    while w > 1 || h > 1 {
        w = next_extent(w)
        h = next_extent(h)
        count += 1
    }
    << count
}
// levels=0 means the full mip chain. Otherwise levels is 1...mip_count_2d.
// Alignments are in bytes; (1,1) returns tight logical storage. Device limits,
// resource budgets, allocation, row copies and mip generation are separate.
// All products, sums and rounding are checked before growing the result.
pub fn texture_2d(format int, width int, height int, levels int, row_alignment int, level_alignment int) TextureLayout2D {
    info := format_info(format) or >>
    maximum := mip_count_2d(width, height) or >>
    alignment_valid(row_alignment) or >>
    alignment_valid(level_alignment) or >>
    $count := levels
    if count == 0 { count = maximum }
    if count < 1 || count > maximum { >> errors.new("gpu/layout: invalid mip count") }
    $output := []Level2D{}
    $w := width
    $h := height
    $bytes := 0
    for index in 0:count {
        columns := block_count(w, info.block_width) or >>
        rows := block_count(h, info.block_height) or >>
        row_bytes := multiply_bytes(columns, info.block_bytes) or >>
        pitch := align_bytes(row_bytes, row_alignment) or >>
        offset := align_bytes(bytes, level_alignment) or >>
        size := multiply_bytes(pitch, rows) or >>
        bytes = add_bytes(offset, size) or >>
        output.push(Level2D{width: w, height: h, block_columns: columns, block_rows: rows,
            row_bytes: row_bytes, row_pitch: pitch, offset: offset, size_bytes: size})
        w = next_extent(w)
        h = next_extent(h)
    }
    << TextureLayout2D{levels: output, bytes: bytes}
}
