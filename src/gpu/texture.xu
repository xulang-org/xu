@gpu

driver #internal/sdl
#errors

#gpu/layout

pub const TEXTURE_SAMPLED = 1
pub const TEXTURE_COLOR_TARGET = 2
pub const TEXTURE_DEPTH_TARGET = 4
// SDL's portable 2D limit. Actual format/usage support is device-specific.
pub const MAX_TEXTURE_SIZE_2D = 16384

pub struct Texture2DDesc {
    pub format int
    pub width int
    pub height int
    // Zero requests a full mip chain. Depth targets currently require one.
    pub levels int
    pub usage int
}
pub struct Texture {
    owner int
    handle int
    memory layout.TextureLayout2D
}
// Non-owning subresource identity. Use after owner/device closure is rejected.
pub struct TextureSlice {
    owner int
    handle int
    mip int
}
pub fn (device &Device) supports_texture_2d(format int, usage int) bool {
    status := checked(driver.texture_supports(device.handle, format, usage)) or >>
    << status != 0
}
pub fn (device &Device) texture_2d(desc Texture2DDesc) Texture {
    memory := layout.texture_2d(desc.format, desc.width, desc.height, desc.levels, 1, 1) or >>
    $data := [desc.format, desc.width, desc.height, memory.level_count(), desc.usage, memory.total_bytes()]
    for mip in 0:memory.level_count() {
        level := memory.level(mip) or >>
        data.push(level.size_bytes)
    }
    handle := checked(driver.texture_new(device.handle, &data)) or >>
    << Texture{owner: device.handle, handle: handle, memory: memory}
}
pub fn (texture &Texture) level_count() int { << texture.memory.level_count() }
pub fn (texture &Texture) size_bytes() int { << texture.memory.total_bytes() }
pub fn (texture &Texture) level_layout(mip int) layout.Level2D { << texture.memory.level(mip) or >> }
pub fn (texture &Texture) view(mip int) TextureSlice {
    texture.memory.level(mip) or >>
    << TextureSlice{owner: texture.owner, handle: texture.handle, mip: mip}
}
// Transfers copy a complete tightly packed mip. Compression follows gpu/layout;
// depth transfers are unsupported. Input bytes are copied before returning.
pub fn (device &Device) upload_texture(texture &Texture, mip int, bytes &[]u8) Fence {
    require_owner(device.handle, texture.owner) or >>
    level := texture.memory.level(mip) or >>
    if bytes.len != level.size_bytes { >> errors.new("gpu: texture upload requires exact tight mip bytes") }
    handle := checked(driver.texture_upload(device.handle, texture.handle, mip, bytes)) or >>
    << Fence{owner: device.handle, handle: handle}
}
pub fn (device &Device) download_texture(texture &Texture, mip int) Readback {
    require_owner(device.handle, texture.owner) or >>
    level := texture.memory.level(mip) or >>
    handle := checked(driver.texture_download(device.handle, texture.handle, mip, level.size_bytes)) or >>
    << Readback{owner: device.handle, handle: handle, bytes: level.size_bytes}
}
pub fn (device &Device) generate_mips(texture &Texture) Fence {
    require_owner(device.handle, texture.owner) or >>
    handle := checked(driver.texture_mips(device.handle, texture.handle)) or >>
    << Fence{owner: device.handle, handle: handle}
}
pub fn (texture $&Texture) close() int {
    if texture.handle == 0 { << 0 }
    checked(driver.resource_close(texture.owner, texture.handle)) or >>
    texture.handle = 0
    << 0
}
fn (texture $&Texture) drop() {
    if texture.handle > 0 { driver.resource_close(texture.owner, texture.handle)
        texture.handle = 0 }
}
