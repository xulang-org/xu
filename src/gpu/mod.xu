@gpu

driver #gpu/internal/native
#errors

pub const AUTO = 0
pub const METAL = 1
pub const VULKAN = 2
pub const D3D12 = 3
pub const SHADER_SPIRV = 1
pub const SHADER_DXBC = 2
pub const SHADER_DXIL = 4
pub const SHADER_MSL = 8
pub const SHADER_METALLIB = 16
pub const BUFFER_VERTEX = 1
pub const BUFFER_INDEX = 2
pub const BUFFER_INDIRECT = 4
pub const BUFFER_GRAPHICS_STORAGE_READ = 8
pub const BUFFER_COMPUTE_STORAGE_READ = 16
pub const BUFFER_COMPUTE_STORAGE_WRITE = 32
pub const TRANSFER_ALIGNMENT = 4

pub struct DeviceOptions {
    pub backend int
    pub debug bool
    // Zero permits all known formats; the selected device reports its subset.
    pub shader_formats int
}
// Owning, main-thread resources. Device.close invalidates all children. IDs
// are private and never reused by the backend during the process lifetime.
pub struct Device { handle int }
pub struct Buffer { owner int
    handle int
    bytes int }
pub struct Fence { owner int
    handle int }
pub struct Readback { owner int
    handle int
    bytes int }
// Logical requested bytes and live ownership counts, not driver allocations.
pub struct Stats {
    pub buffer_count int
    pub buffer_bytes int
    pub submission_count int
    pub staging_bytes int
    pub texture_count int
    pub texture_bytes int
    pub sampler_count int
    pub shader_count int
    pub pipeline_count int
    pub encoder_count int
    pub render_pass_count int
    pub compute_pipeline_count int
    pub compute_pass_count int
}
fn checked(status int) int {
    if status >= 0 { << status }
    $message := "gpu: "
    count := driver.error_len()
    for i in 0:count { message.push_str(string_from_byte(driver.error_byte(i))) }
    >> errors.new(message)
}
pub fn open(options DeviceOptions) Device {
    $debug := 0
    if options.debug { debug = 1 }
    handle := checked(driver.open(options.backend, debug, options.shader_formats)) or >>
    << Device{handle: handle}
}
pub fn (device &Device) backend() int { << checked(driver.backend(device.handle)) or >> }
pub fn (device &Device) shader_formats() int { << checked(driver.shader_formats(device.handle)) or >> }
pub fn (device &Device) stats() Stats {
    buffers := checked(driver.stats(device.handle, 0)) or >>
    bytes := checked(driver.stats(device.handle, 1)) or >>
    submissions := checked(driver.stats(device.handle, 2)) or >>
    staging := checked(driver.stats(device.handle, 3)) or >>
    textures := checked(driver.stats(device.handle, 4)) or >>
    texture_bytes := checked(driver.stats(device.handle, 5)) or >>
    samplers := checked(driver.stats(device.handle, 6)) or >>
    shaders := checked(driver.stats(device.handle, 7)) or >>
    pipelines := checked(driver.stats(device.handle, 8)) or >>
    encoders := checked(driver.stats(device.handle, 9)) or >>
    passes := checked(driver.stats(device.handle, 10)) or >>
    compute_pipelines := checked(driver.stats(device.handle, 11)) or >>
    compute_passes := checked(driver.stats(device.handle, 12)) or >>
    << Stats{texture_count: textures, texture_bytes: texture_bytes, sampler_count: samplers,
        compute_pipeline_count: compute_pipelines, compute_pass_count: compute_passes,
        shader_count: shaders, pipeline_count: pipelines, encoder_count: encoders, render_pass_count: passes, buffer_count: buffers, buffer_bytes: bytes, submission_count: submissions, staging_bytes: staging}
}
pub fn (device &Device) buffer(size_bytes int, usage int) Buffer {
    handle := checked(driver.buffer_new(device.handle, size_bytes, usage)) or >>
    << Buffer{owner: device.handle, handle: handle, bytes: size_bytes}
}
pub fn (buffer &Buffer) size_bytes() int { << buffer.bytes }
fn owns(device &Device, buffer &Buffer) int {
    if device.handle <= 0 || buffer.owner != device.handle || buffer.handle <= 0 { >> errors.new("gpu: closed or foreign buffer") }
    << 0
}
// Each transfer is submitted before returning. Upload copies the borrowed
// bytes to owned staging synchronously; no Xu pointer survives the call.
// Fence.close releases ownership without waiting; SDL defers in-flight frees.
pub fn (device &Device) upload(buffer &Buffer, offset int, bytes &[]u8) Fence {
    owns(device, buffer) or >>
    handle := checked(driver.upload(device.handle, buffer.handle, offset, bytes)) or >>
    << Fence{owner: device.handle, handle: handle}
}
pub fn (device &Device) copy(source &Buffer, source_offset int, destination &Buffer, destination_offset int, size_bytes int) Fence {
    owns(device, source) or >>
    owns(device, destination) or >>
    handle := checked(driver.copy(device.handle, source.handle, source_offset, destination.handle, destination_offset, size_bytes)) or >>
    << Fence{owner: device.handle, handle: handle}
}
pub fn (device &Device) download(buffer &Buffer, offset int, size_bytes int) Readback {
    owns(device, buffer) or >>
    handle := checked(driver.download(device.handle, buffer.handle, offset, size_bytes)) or >>
    << Readback{owner: device.handle, handle: handle, bytes: size_bytes}
}
pub fn (fence &Fence) ready() bool {
    status := checked(driver.ready(fence.owner, fence.handle)) or >>
    << status != 0
}
pub fn (fence &Fence) wait() int { << checked(driver.wait(fence.owner, fence.handle)) or >> }
pub fn (readback &Readback) ready() bool {
    status := checked(driver.ready(readback.owner, readback.handle)) or >>
    << status != 0
}
pub fn (readback &Readback) wait() int { << checked(driver.wait(readback.owner, readback.handle)) or >> }
pub fn (readback &Readback) size_bytes() int { << readback.bytes }
// Requires a completed submission and an exact-size destination. Failure
// leaves the byte array untouched. Waiting is explicit and may block.
pub fn (readback &Readback) read(output $&[]u8) int { << checked(driver.read(readback.owner, readback.handle, output)) or >> }
pub fn (device $&Device) close() int {
    if device.handle == 0 { << 0 }
    checked(driver.close(device.handle)) or >>
    device.handle = 0
    << 0
}
pub fn (buffer $&Buffer) close() int {
    if buffer.handle == 0 { << 0 }
    checked(driver.buffer_close(buffer.owner, buffer.handle)) or >>
    buffer.handle = 0
    << 0
}
pub fn (fence $&Fence) close() int {
    if fence.handle == 0 { << 0 }
    checked(driver.transfer_close(fence.owner, fence.handle)) or >>
    fence.handle = 0
    << 0
}
pub fn (readback $&Readback) close() int {
    if readback.handle == 0 { << 0 }
    checked(driver.transfer_close(readback.owner, readback.handle)) or >>
    readback.handle = 0
    << 0
}
fn (device $&Device) drop() { if device.handle > 0 { driver.close(device.handle)
    device.handle = 0 } }
fn (buffer $&Buffer) drop() { if buffer.handle > 0 { driver.buffer_close(buffer.owner, buffer.handle)
    buffer.handle = 0 } }
fn (fence $&Fence) drop() { if fence.handle > 0 { driver.transfer_close(fence.owner, fence.handle)
    fence.handle = 0 } }
fn (readback $&Readback) drop() { if readback.handle > 0 { driver.transfer_close(readback.owner, readback.handle)
    readback.handle = 0 } }
