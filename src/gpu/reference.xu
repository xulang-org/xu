@gpu

driver #internal/sdl
#errors

// Copyable, non-owning identities for retained draw lists and resource tables.
// They never extend owner lifetime. Validation and every binding check the
// backend's never-reused identity, including after the owner/device closes.
// Zero/default references are invalid; no raw platform handles are exposed.
pub struct DeviceRef { handle int }
pub struct BufferRef { owner int
    handle int
    bytes int }
pub struct TextureRef { owner int
    handle int }
pub struct SamplerRef { owner int
    handle int }
pub fn (device &Device) reference() DeviceRef { << DeviceRef{handle: device.handle} }
pub fn (buffer &Buffer) reference() BufferRef { << BufferRef{owner: buffer.owner,handle: buffer.handle,bytes: buffer.bytes} }
pub fn (texture &Texture) reference() TextureRef { << TextureRef{owner: texture.owner,handle: texture.handle} }
pub fn (sampler &Sampler) reference() SamplerRef { << SamplerRef{owner: sampler.owner,handle: sampler.handle} }
// Identity comparison does not assert liveness. Two zero references never match.
pub fn (reference DeviceRef) same(other DeviceRef) bool { << reference.handle>0 && reference.handle==other.handle }
pub fn (reference BufferRef) same(other BufferRef) bool { << reference.handle>0 && reference.owner==other.owner && reference.handle==other.handle }
pub fn (reference TextureRef) same(other TextureRef) bool { << reference.handle>0 && reference.owner==other.owner && reference.handle==other.handle }
pub fn (reference SamplerRef) same(other SamplerRef) bool { << reference.handle>0 && reference.owner==other.owner && reference.handle==other.handle }
pub fn (reference DeviceRef) validate() int { checked(driver.backend(reference.handle)) >>>
    << 0 }
pub fn (reference BufferRef) validate() int { << checked(driver.reference_validate(reference.owner,reference.handle,0)) >>> }
pub fn (reference TextureRef) validate() int { << checked(driver.reference_validate(reference.owner,reference.handle,1)) >>> }
pub fn (reference SamplerRef) validate() int { << checked(driver.reference_validate(reference.owner,reference.handle,2)) >>> }
pub fn (reference BufferRef) size_bytes() int { << reference.bytes }
pub fn (reference DeviceRef) validate_buffer(buffer BufferRef) int {
    require_owner(reference.handle,buffer.owner) >>>
    << buffer.validate() >>>
}
pub fn (reference DeviceRef) validate_texture(texture TextureRef) int {
    require_owner(reference.handle,texture.owner) >>>
    << texture.validate() >>>
}
pub fn (reference DeviceRef) validate_sampler(sampler SamplerRef) int {
    require_owner(reference.handle,sampler.owner) >>>
    << sampler.validate() >>>
}
pub fn (pass &RenderPass) vertex_buffer_ref(slot int, buffer BufferRef, offset int) int {
    require_owner(pass.owner,buffer.owner) >>>
    << checked(driver.pass_buffer(pass.owner,pass.handle,buffer.handle,slot,offset,0)) >>>
}
pub fn (pass &RenderPass) index_buffer_ref(buffer BufferRef, offset int, element_size int) int {
    require_owner(pass.owner,buffer.owner) >>>
    if element_size!=INDEX16 && element_size!=INDEX32 { >>> errors.new("gpu: invalid index element size") }
    << checked(driver.pass_buffer(pass.owner,pass.handle,buffer.handle,0,offset,element_size)) >>>
}
pub fn (pass &RenderPass) sampler_ref(stage int, slot int, texture TextureRef, sampler SamplerRef) int {
    require_owner(pass.owner,texture.owner) >>>
    require_owner(pass.owner,sampler.owner) >>>
    << checked(driver.pass_sampler(pass.owner,pass.handle,stage,slot,texture.handle,sampler.handle)) >>>
}
pub fn (pass &RenderPass) storage_texture_ref(stage int, slot int, texture TextureRef) int {
    require_owner(pass.owner, texture.owner) >>>
    << checked(driver.pass_storage_texture(pass.owner, pass.handle, stage, slot, texture.handle)) >>>
}
pub fn (pass &RenderPass) storage_buffer_ref(stage int, slot int, buffer BufferRef) int {
    require_owner(pass.owner, buffer.owner) >>>
    << checked(driver.pass_storage_buffer(pass.owner, pass.handle, stage, slot, buffer.handle)) >>>
}
pub fn (pass &RenderPass) draw_indirect_ref(buffer BufferRef, offset int, draw_count int) int {
    require_owner(pass.owner, buffer.owner) >>>
    << checked(driver.pass_draw_indirect(pass.owner, pass.handle, buffer.handle, offset, draw_count, 0)) >>>
}
pub fn (pass &RenderPass) draw_indexed_indirect_ref(buffer BufferRef, offset int, draw_count int) int {
    require_owner(pass.owner, buffer.owner) >>>
    << checked(driver.pass_draw_indirect(pass.owner, pass.handle, buffer.handle, offset, draw_count, 1)) >>>
}
pub fn write_buffer_ref(buffer BufferRef, cycle bool) StorageBufferWrite {
    << StorageBufferWrite{owner: buffer.owner, handle: buffer.handle, cycle: cycle}
}
pub fn write_texture_ref(texture TextureRef, mip int, layer int, cycle bool) StorageTextureWrite {
    << StorageTextureWrite{owner: texture.owner, handle: texture.handle, mip: mip, layer: layer, cycle: cycle}
}
pub fn (pass &ComputePass) sampler_ref(slot int, texture TextureRef, sampler SamplerRef) int {
    require_owner(pass.owner, texture.owner) >>>
    require_owner(pass.owner, sampler.owner) >>>
    << checked(driver.compute_sampler(pass.owner, pass.handle, slot, texture.handle, sampler.handle)) >>>
}
pub fn (pass &ComputePass) read_texture_ref(slot int, texture TextureRef) int {
    require_owner(pass.owner, texture.owner) >>>
    << checked(driver.compute_read_texture(pass.owner, pass.handle, slot, texture.handle)) >>>
}
pub fn (pass &ComputePass) read_buffer_ref(slot int, buffer BufferRef) int {
    require_owner(pass.owner, buffer.owner) >>>
    << checked(driver.compute_buffer(pass.owner, pass.handle, slot, buffer.handle)) >>>
}
pub fn (pass &ComputePass) dispatch_indirect_ref(buffer BufferRef, offset int) int {
    require_owner(pass.owner, buffer.owner) >>>
    << checked(driver.compute_dispatch_indirect(pass.owner, pass.handle, buffer.handle, offset)) >>>
}
