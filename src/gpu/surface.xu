@gpu

driver #internal/sdl
#window

pub const PRESENT_VSYNC = 0
pub const PRESENT_IMMEDIATE = 1
pub const PRESENT_MAILBOX = 2
pub struct SurfaceOptions { pub present_mode int }
pub struct Surface { owner int
    handle int }
pub struct Frame { owner int
    handle int
    image_width int
    image_height int
    image_format int }
pub fn (device &Device) surface(target &window.Window, options SurfaceOptions) Surface {
    handle := checked(driver.surface_new(device.handle,target.id(),options.present_mode)) or >>
    << Surface{owner: device.handle,handle: handle}
}
pub fn (surface &Surface) format() int { << checked(driver.surface_format(surface.owner,surface.handle)) or >> }
pub fn (surface &Surface) supports_present_mode(mode int) bool {
    status := checked(driver.surface_supports_mode(surface.owner,surface.handle,mode)) or >>
    << status!=0
}
// Reconfiguration requires no acquired frame and may wait for GPU work.
pub fn (surface &Surface) set_present_mode(mode int) int {
    << checked(driver.surface_mode(surface.owner,surface.handle,mode)) or >>
}
// A successful acquire can have no image (e.g. minimized). Test has_image()
// before rendering. Dimensions/format describe this acquired image in pixels.
pub fn (surface &Surface) acquire() Frame {
    $info := [0,0,0]
    handle := checked(driver.frame_acquire(surface.owner,surface.handle,$&info)) or >>
    << Frame{owner: surface.owner,handle: handle,image_width: info[0],image_height: info[1],image_format: info[2]}
}
pub fn (frame &Frame) has_image() bool { << frame.handle>0 }
pub fn (frame &Frame) width() int { << frame.image_width }
pub fn (frame &Frame) height() int { << frame.image_height }
pub fn (frame &Frame) format() int { << frame.image_format }
// Swapchain images are write-only, restricted to this frame, and always STORE.
// LOAD needs an earlier render pass in the same frame. No owning Texture/view
// or independent CommandEncoder can escape the acquired-image lifetime.
pub fn (frame &Frame) begin_render(load int, clear Color, depth DepthAttachment) RenderPass {
    if depth.present { require_owner(frame.owner,depth.owner) or >> }
    values := [load,depth.handle,depth.load,depth.store]
    handle := checked(driver.frame_begin(frame.owner,frame.handle,&values,clear.r,clear.g,clear.b,clear.a,depth.clear)) or >>
    << RenderPass{owner: frame.owner,handle: handle}
}
pub fn (frame &Frame) begin_compute(writes &[]StorageBufferWrite) ComputePass {
    << compute_pass_on(frame.owner,frame.handle,writes) or >>
}
// End every active pass before presenting. Submission consumes the frame even
// on driver failure; close/drop is safe if a stale CPU owner remains afterward.
pub fn (frame $&Frame) present() Fence {
    handle := checked(driver.frame_submit(frame.owner,frame.handle)) or >>
    frame.handle=0
    << Fence{owner: frame.owner,handle: handle}
}
// An acquired image cannot be cancelled. Abandonment ends active passes,
// clears opaque black and submits without a fence. Errors are reported;
// teardown still consumes the command. No per-frame GPU-idle wait is added.
pub fn (frame $&Frame) close() int {
    if frame.handle==0 { << 0 }
    checked(driver.frame_close(frame.owner,frame.handle)) or >>
    frame.handle=0
    << 0
}
// Closing a surface safely finishes/invalidate its pending frame before
// unclaiming the window. Device/window closure also invalidates descendants.
pub fn (surface $&Surface) close() int {
    if surface.handle==0 { << 0 }
    checked(driver.surface_close(surface.owner,surface.handle)) or >>
    surface.handle=0
    << 0
}
fn (frame $&Frame) drop() { if frame.handle>0 { driver.frame_close(frame.owner,frame.handle)
    frame.handle=0 } }
fn (surface $&Surface) drop() { if surface.handle>0 { driver.surface_close(surface.owner,surface.handle)
    surface.handle=0 } }
