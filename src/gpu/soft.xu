@gpu

driver #internal/sdl
#errors
#math

// CPU-side mesh/texture payloads for software and headless GPU paths.
// SoftBlob owns the native byte snapshot; SoftBlobRef is a copyable identity
// (owner/handle/bytes) matching BufferRef — reads validate against the store.

pub struct SoftBlob {
    owner int
    handle int
    bytes int
    closed bool
}

pub struct SoftBlobRef {
    owner int
    handle int
    bytes int
}

fn soft_checked(status int) int {
    if status >= 0 { << status }
    $message := "gpu: "
    count := driver.error_len()
    for i in 0:count { message.push_str(string_from_byte(driver.error_byte(i))) }
    >> errors.new(message)
}

// Allocates an opaque soft-device owner id used by SoftBlobRef.validate.
pub fn soft_owner_new() int {
    << soft_checked(driver.soft_owner_new()) >>>
}

pub fn soft_owner_close(owner int) int {
    << soft_checked(driver.soft_owner_close(owner)) >>>
}

pub fn soft_blob_create(owner int, bytes &[]u8) SoftBlob {
    handle := soft_checked(driver.soft_blob_create(owner, bytes)) >>>
    << SoftBlob{owner: owner, handle: handle, bytes: bytes.len, closed: false}
}

pub fn empty_soft_blob_ref() SoftBlobRef {
    << SoftBlobRef{owner: 0, handle: 0, bytes: 0}
}

pub fn (blob &SoftBlob) reference() SoftBlobRef {
    if blob.closed || blob.owner <= 0 || blob.handle <= 0 {
        << empty_soft_blob_ref()
    }
    << SoftBlobRef{owner: blob.owner, handle: blob.handle, bytes: blob.bytes}
}

pub fn (blob $&SoftBlob) close() int {
    if blob.closed { << 0 }
    soft_checked(driver.soft_blob_close(blob.owner, blob.handle)) >>>
    blob.handle = 0
    blob.bytes = 0
    blob.closed = true
    << 0
}

pub fn (reference SoftBlobRef) validate(owner int) int {
    if reference.owner <= 0 || reference.handle <= 0 { >> errors.new("gpu: soft blob reference is empty") }
    if owner > 0 && reference.owner != owner { >> errors.new("gpu: soft blob owner mismatch") }
    soft_checked(driver.soft_blob_bytes(reference.owner, reference.handle)) >>>
    << 0
}

pub fn (reference SoftBlobRef) read_u32(offset int) int {
    $out := [0]
    soft_checked(driver.soft_blob_read_u32(reference.owner, reference.handle, offset, $&out)) >>>
    << out[0]
}

pub fn (reference SoftBlobRef) read_f32(offset int) f64 {
    word := reference.read_u32(offset) >>>
    << math.float32_from_bits(word)
}

// Packed RGBA8 texel (R in the high 8 bits) matching game software sampling.
pub fn (reference SoftBlobRef) read_rgba8(index int) int {
    $out := [0]
    soft_checked(driver.soft_blob_read_rgba8(reference.owner, reference.handle, index, $&out)) >>>
    << out[0]
}

fn (blob $&SoftBlob) drop() {
    if !blob.closed && blob.handle > 0 {
        driver.soft_blob_close(blob.owner, blob.handle)
        blob.handle = 0
        blob.closed = true
    }
}
