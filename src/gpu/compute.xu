@gpu

driver #internal/sdl
#errors

pub const MAX_COMPUTE_STORAGE_BUFFERS = 8
pub const MAX_COMPUTE_STORAGE_TEXTURES = 8
pub const MAX_COMPUTE_THREADS = 1024
pub const MAX_COMPUTE_THREADS_Z = 64
pub const MAX_COMPUTE_GROUPS_PER_DIMENSION = 65535

// Buffer-only compute. Resource counts, uniforms and thread dimensions must
// match the shader; code is not reflected or sandboxed by the runtime.
pub struct ComputePipelineDesc {
    pub format int
    pub entrypoint string
    pub read_buffers int
    pub write_buffers int
    pub uniform_sizes []int
    pub threads_x int
    pub threads_y int
    pub threads_z int
}
pub struct ComputeResourcesDesc {
    pub format int
    pub entrypoint string
    pub samplers int
    pub read_textures int
    pub read_buffers int
    pub write_textures int
    pub write_buffers int
    pub uniform_sizes []int
    pub threads_x int
    pub threads_y int
    pub threads_z int
}
pub struct ComputePipeline { owner int
    handle int }
// Non-owning write target. cycle=true discards prior contents when SDL cycles
// an in-use allocation. Use false when a later pass reads the previous result.
pub struct StorageBufferWrite { owner int
    handle int
    cycle bool }
pub struct StorageTextureWrite { owner int
    handle int
    mip int
    layer int
    cycle bool }
pub fn write_buffer(buffer &Buffer, cycle bool) StorageBufferWrite {
    << StorageBufferWrite{owner: buffer.owner, handle: buffer.handle, cycle: cycle}
}
pub fn write_texture(texture &Texture, mip int, layer int, cycle bool) StorageTextureWrite {
    << StorageTextureWrite{owner: texture.owner, handle: texture.handle, mip: mip, layer: layer, cycle: cycle}
}
pub struct ComputePass { owner int
    handle int }
pub fn (device &Device) compute_pipeline(desc &ComputePipelineDesc, code &[]u8) ComputePipeline {
    values := [desc.format, desc.read_buffers, desc.write_buffers, desc.threads_x, desc.threads_y, desc.threads_z]
    entry := shader_entrypoint(&desc.entrypoint) or >>
    handle := checked(driver.compute_pipeline_new(device.handle, &values, &desc.uniform_sizes, &entry, code)) or >>
    << ComputePipeline{owner: device.handle, handle: handle}
}
pub fn (device &Device) compute_pipeline_with_resources(desc &ComputeResourcesDesc, code &[]u8) ComputePipeline {
    values := [desc.format, desc.samplers, desc.read_textures, desc.read_buffers, desc.write_textures, desc.write_buffers, desc.threads_x, desc.threads_y, desc.threads_z]
    entry := shader_entrypoint(&desc.entrypoint) or >>
    handle := checked(driver.compute_pipeline_resources_new(device.handle, &values, &desc.uniform_sizes, &entry, code)) or >>
    << ComputePipeline{owner: device.handle, handle: handle}
}
// Write slots are fixed for the pass. End the pass between dependent
// dispatches: dispatches within one pass have no implicit memory barrier.
pub fn (encoder &CommandEncoder) begin_compute(writes &[]StorageBufferWrite) ComputePass {
    << compute_pass_on(encoder.owner,encoder.handle,writes) or >>
}
pub fn (encoder &CommandEncoder) begin_compute_with_resources(texture_writes &[]StorageTextureWrite, buffer_writes &[]StorageBufferWrite) ComputePass {
    << compute_pass_resources_on(encoder.owner, encoder.handle, texture_writes, buffer_writes) or >>
}
fn compute_pass_resources_on(owner int, encoder int, texture_writes &[]StorageTextureWrite, writes &[]StorageBufferWrite) ComputePass {
    if texture_writes.len > MAX_COMPUTE_STORAGE_TEXTURES { >> errors.new("gpu: too many compute write textures") }
    if writes.len > MAX_COMPUTE_STORAGE_BUFFERS { >> errors.new("gpu: too many compute write buffers") }
    $tvals := []int{}
    for i in 0:texture_writes.len {
        tw := texture_writes[i]
        require_owner(owner, tw.owner) or >>
        tvals.push(tw.handle)
        tvals.push(tw.mip)
        tvals.push(tw.layer)
        $cycle := 0
        if tw.cycle { cycle = 1 }
        tvals.push(cycle)
    }
    $values := []int{}
    for i in 0:writes.len {
        target := writes[i]
        require_owner(owner, target.owner) or >>
        values.push(target.handle)
        $cycle := 0
        if target.cycle { cycle = 1 }
        values.push(cycle)
    }
    handle := checked(driver.compute_begin_resources(owner, encoder, &tvals, &values)) or >>
    << ComputePass{owner: owner, handle: handle}
}
fn compute_pass_on(owner int, encoder int, writes &[]StorageBufferWrite) ComputePass {
    no_tex := []StorageTextureWrite{}
    << compute_pass_resources_on(owner, encoder, &no_tex, writes) or >>
}
// Changing the pipeline requires read buffers and uniforms to be rebound.
pub fn (pass &ComputePass) pipeline(pipeline &ComputePipeline) int {
    require_owner(pass.owner, pipeline.owner) or >>
    << checked(driver.compute_pipeline(pass.owner, pass.handle, pipeline.handle)) or >>
}
pub fn (pass &ComputePass) sampler(slot int, texture &Texture, sampler &Sampler) int {
    require_owner(pass.owner, texture.owner) or >>
    require_owner(pass.owner, sampler.owner) or >>
    << checked(driver.compute_sampler(pass.owner, pass.handle, slot, texture.handle, sampler.handle)) or >>
}
pub fn (pass &ComputePass) read_texture(slot int, texture &Texture) int {
    require_owner(pass.owner, texture.owner) or >>
    << checked(driver.compute_read_texture(pass.owner, pass.handle, slot, texture.handle)) or >>
}
pub fn (pass &ComputePass) read_buffer(slot int, buffer &Buffer) int {
    require_owner(pass.owner, buffer.owner) or >>
    << checked(driver.compute_buffer(pass.owner, pass.handle, slot, buffer.handle)) or >>
}
pub fn (pass &ComputePass) uniform(slot int, bytes &[]u8) int {
    << checked(driver.compute_uniform(pass.owner, pass.handle, slot, bytes)) or >>
}
// Group counts are 1...65535 per axis. Shader indexing and storage bounds
// remain the author's contract; GPU execution is asynchronous and unsandboxed.
pub fn (pass &ComputePass) dispatch(groups_x int, groups_y int, groups_z int) int {
    << checked(driver.compute_dispatch(pass.owner, pass.handle, groups_x, groups_y, groups_z)) or >>
}
pub fn (pass &ComputePass) dispatch_indirect(buffer &Buffer, offset int) int {
    require_owner(pass.owner, buffer.owner) or >>
    << checked(driver.compute_dispatch_indirect(pass.owner, pass.handle, buffer.handle, offset)) or >>
}
pub fn (pass $&ComputePass) end() int {
    if pass.handle == 0 { << 0 }
    checked(driver.compute_end(pass.owner, pass.handle)) or >>
    pass.handle = 0
    << 0
}
pub fn (pipeline $&ComputePipeline) close() int {
    if pipeline.handle == 0 { << 0 }
    checked(driver.resource_close(pipeline.owner, pipeline.handle)) or >>
    pipeline.handle = 0
    << 0
}
fn (pipeline $&ComputePipeline) drop() {
    if pipeline.handle > 0 { driver.resource_close(pipeline.owner, pipeline.handle)
        pipeline.handle = 0 }
}
fn (pass $&ComputePass) drop() {
    if pass.handle > 0 { driver.compute_end(pass.owner, pass.handle)
        pass.handle = 0 }
}
