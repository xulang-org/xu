@gpu

driver #gpu/internal/native
#errors

pub const VERTEX = 0
pub const FRAGMENT = 1
pub const NEAREST = 0
pub const LINEAR = 1
pub const REPEAT = 0
pub const MIRRORED_REPEAT = 1
pub const CLAMP_TO_EDGE = 2
pub const TRIANGLES = 0
pub const TRIANGLE_STRIP = 1
pub const LINES = 2
pub const LINE_STRIP = 3
pub const POINTS = 4
pub const CULL_NONE = 0
pub const CULL_FRONT = 1
pub const CULL_BACK = 2
pub const COUNTER_CLOCKWISE = 0
pub const CLOCKWISE = 1
pub const DEPTH_DISABLED = 0
pub const NEVER = 1
pub const LESS = 2
pub const EQUAL = 3
pub const LESS_EQUAL = 4
pub const GREATER = 5
pub const NOT_EQUAL = 6
pub const GREATER_EQUAL = 7
pub const ALWAYS = 8
pub const BLEND_DISABLED = 0
pub const BLEND_ALPHA = 1
pub const BLEND_PREMULTIPLIED = 2
pub const PER_VERTEX = 0
pub const PER_INSTANCE = 1
pub const FLOAT = 1
pub const FLOAT2 = 2
pub const FLOAT3 = 3
pub const FLOAT4 = 4
pub const UNORM8X4 = 5
pub const UINT = 6
pub const UINT2 = 7
pub const UINT3 = 8
pub const UINT4 = 9

pub struct SamplerDesc {
    pub min_filter int
    pub mag_filter int
    pub mip_filter int
    pub address_u int
    pub address_v int
    pub address_w int
    pub min_lod f64
    pub max_lod f64
}
pub fn sampler_defaults() SamplerDesc {
    << SamplerDesc{min_filter: LINEAR, mag_filter: LINEAR, mip_filter: LINEAR,
        address_u: CLAMP_TO_EDGE, address_v: CLAMP_TO_EDGE, address_w: CLAMP_TO_EDGE, min_lod: 0.0, max_lod: 1000.0}
}
pub struct ShaderDesc {
    pub stage int
    pub format int
    pub entrypoint string
    pub samplers int
    // One exact std140-compatible byte size per uniform slot (16...16384).
    // The caller must match these declarations and bindings to the shader.
    pub uniform_sizes []int
}
pub struct VertexBufferLayout {
    pub slot int
    pub stride int
    pub rate int
}
pub struct VertexAttribute {
    pub location int
    pub slot int
    pub format int
    pub offset int
}
pub struct PipelineDesc {
    pub color_format int
    // Zero means no depth attachment.
    pub depth_format int
    pub primitive int
    pub cull int
    pub front_face int
    pub depth_compare int
    pub depth_write bool
    pub blend int
    pub vertex_buffers []VertexBufferLayout
    pub attributes []VertexAttribute
}
pub fn pipeline_defaults(color_format int) PipelineDesc {
    << PipelineDesc{color_format: color_format, depth_format: 0, primitive: TRIANGLES,
        cull: CULL_NONE, front_face: COUNTER_CLOCKWISE, depth_compare: DEPTH_DISABLED, depth_write: false,
        blend: BLEND_DISABLED, vertex_buffers: []VertexBufferLayout{}, attributes: []VertexAttribute{}}
}
pub struct Sampler { owner int
    handle int }
pub struct Shader { owner int
    handle int }
pub struct GraphicsPipeline { owner int
    handle int }
pub fn (device &Device) sampler(desc SamplerDesc) Sampler {
    values := [desc.min_filter, desc.mag_filter, desc.mip_filter, desc.address_u, desc.address_v, desc.address_w]
    handle := checked(driver.sampler_new(device.handle, &values, desc.min_lod, desc.max_lod)) or >>
    << Sampler{owner: device.handle, handle: handle}
}
pub fn (device &Device) shader(desc &ShaderDesc, code &[]u8) Shader {
    $entry := []u8{}
    for i in 0:desc.entrypoint.len { entry.push(u8(desc.entrypoint[i])) }
    handle := checked(driver.shader_new(device.handle, desc.stage, desc.format, desc.samplers,
        &desc.uniform_sizes, &entry, code)) or >>
    << Shader{owner: device.handle, handle: handle}
}
pub fn (device &Device) graphics_pipeline(vertex &Shader, fragment &Shader, desc &PipelineDesc) GraphicsPipeline {
    require_owner(device.handle, vertex.owner) or >>
    require_owner(device.handle, fragment.owner) or >>
    $write := 0
    if desc.depth_write { write = 1 }
    state := [desc.color_format, desc.depth_format, desc.primitive, desc.cull, desc.front_face, desc.depth_compare, write, desc.blend]
    $buffers := []int{}
    for i in 0:desc.vertex_buffers.len {
        b := desc.vertex_buffers[i]
        buffers.push(b.slot)
        buffers.push(b.stride)
        buffers.push(b.rate)
    }
    $attributes := []int{}
    for i in 0:desc.attributes.len {
        a := desc.attributes[i]
        attributes.push(a.location)
        attributes.push(a.slot)
        attributes.push(a.format)
        attributes.push(a.offset)
    }
    handle := checked(driver.pipeline_new(device.handle, vertex.handle, fragment.handle, &state, &buffers, &attributes)) or >>
    << GraphicsPipeline{owner: device.handle, handle: handle}
}
pub fn (sampler $&Sampler) close() int {
    if sampler.handle == 0 { << 0 }
    checked(driver.resource_close(sampler.owner, sampler.handle)) or >>
    sampler.handle = 0
    << 0
}
pub fn (shader $&Shader) close() int {
    if shader.handle == 0 { << 0 }
    checked(driver.resource_close(shader.owner, shader.handle)) or >>
    shader.handle = 0
    << 0
}
pub fn (pipeline $&GraphicsPipeline) close() int {
    if pipeline.handle == 0 { << 0 }
    checked(driver.resource_close(pipeline.owner, pipeline.handle)) or >>
    pipeline.handle = 0
    << 0
}
fn (sampler $&Sampler) drop() { if sampler.handle > 0 { driver.resource_close(sampler.owner, sampler.handle)
    sampler.handle = 0 } }
fn (shader $&Shader) drop() { if shader.handle > 0 { driver.resource_close(shader.owner, shader.handle)
    shader.handle = 0 } }
fn (pipeline $&GraphicsPipeline) drop() { if pipeline.handle > 0 { driver.resource_close(pipeline.owner, pipeline.handle)
    pipeline.handle = 0 } }
