@gpu

driver #gpu/internal/native
#errors

pub const LOAD = 0
pub const CLEAR = 1
pub const DISCARD = 2
pub const STORE = 0
pub const DONT_STORE = 1
pub const INDEX16 = 2
pub const INDEX32 = 4

pub struct Color { pub r f64
    pub g f64
    pub b f64
    pub a f64 }
pub struct ColorAttachment {
    pub view TextureSlice
    pub load int
    pub store int
    pub clear Color
}
pub struct DepthAttachment {
    present bool
    owner int
    handle int
    load int
    store int
    clear f64
}
pub fn no_depth() DepthAttachment { << DepthAttachment{present: false, owner: 0, handle: 0, load: DISCARD, store: DONT_STORE, clear: 1.0} }
// Depth attachment uses mip zero; its extent must match the color view.
pub fn depth_attachment(texture &Texture, load int, store int, clear f64) DepthAttachment {
    << DepthAttachment{present: true, owner: texture.owner, handle: texture.handle, load: load, store: store, clear: clear}
}
pub struct CommandEncoder { owner int
    handle int }
pub struct RenderPass { owner int
    handle int }
fn require_owner(expected int, actual int) int {
    if expected <= 0 || expected != actual { >> errors.new("gpu: closed or foreign resource owner") }
    << 0
}
pub fn (device &Device) command_encoder() CommandEncoder {
    handle := checked(driver.encoder_new(device.handle)) or >>
    << CommandEncoder{owner: device.handle, handle: handle}
}
pub fn (encoder &CommandEncoder) begin_render(color ColorAttachment, depth DepthAttachment) RenderPass {
    require_owner(encoder.owner, color.view.owner) or >>
    if depth.present {
        require_owner(encoder.owner, depth.owner) or >>
        if depth.handle <= 0 { >> errors.new("gpu: closed depth attachment") }
    }
    values := [color.view.handle, color.view.mip, color.load, color.store, depth.handle, depth.load, depth.store]
    handle := checked(driver.pass_begin(encoder.owner, encoder.handle, &values,
        color.clear.r, color.clear.g, color.clear.b, color.clear.a, depth.clear)) or >>
    << RenderPass{owner: encoder.owner, handle: handle}
}
// Submit requires all passes ended. Success consumes the native encoder;
// failure may also consume it, so close/drop is idempotent on stale IDs.
pub fn (encoder $&CommandEncoder) submit() Fence {
    handle := checked(driver.encoder_submit(encoder.owner, encoder.handle)) or >>
    encoder.handle = 0
    << Fence{owner: encoder.owner, handle: handle}
}
pub fn (pass &RenderPass) pipeline(pipeline &GraphicsPipeline) int {
    require_owner(pass.owner, pipeline.owner) or >>
    << checked(driver.pass_pipeline(pass.owner, pass.handle, pipeline.handle)) or >>
}
// Set the pipeline before bindings; a pipeline change resets required bindings.
pub fn (pass &RenderPass) vertex_buffer(slot int, buffer &Buffer, offset int) int {
    require_owner(pass.owner, buffer.owner) or >>
    << checked(driver.pass_buffer(pass.owner, pass.handle, buffer.handle, slot, offset, 0)) or >>
}
pub fn (pass &RenderPass) index_buffer(buffer &Buffer, offset int, element_size int) int {
    require_owner(pass.owner, buffer.owner) or >>
    if element_size != INDEX16 && element_size != INDEX32 { >> errors.new("gpu: invalid index element size") }
    << checked(driver.pass_buffer(pass.owner, pass.handle, buffer.handle, 0, offset, element_size)) or >>
}
pub fn (pass &RenderPass) sampler(stage int, slot int, texture &Texture, sampler &Sampler) int {
    require_owner(pass.owner, texture.owner) or >>
    require_owner(pass.owner, sampler.owner) or >>
    << checked(driver.pass_sampler(pass.owner, pass.handle, stage, slot, texture.handle, sampler.handle)) or >>
}
pub fn (pass &RenderPass) uniform(stage int, slot int, bytes &[]u8) int {
    << checked(driver.pass_uniform(pass.owner, pass.handle, stage, slot, bytes)) or >>
}
pub fn (pass &RenderPass) viewport(x int, y int, width int, height int) int {
    << checked(driver.pass_rect(pass.owner, pass.handle, x, y, width, height, 0)) or >>
}
pub fn (pass &RenderPass) scissor(x int, y int, width int, height int) int {
    << checked(driver.pass_rect(pass.owner, pass.handle, x, y, width, height, 1)) or >>
}
pub fn (pass &RenderPass) draw(vertex_count int, first_vertex int, instance_count int, first_instance int) int {
    << checked(driver.pass_draw(pass.owner, pass.handle, vertex_count, first_vertex, instance_count, first_instance, 0, 0)) or >>
}
// Index values and shader accesses must address valid vertex/storage data.
// The API checks the index-byte range without reading GPU buffers on the CPU.
pub fn (pass &RenderPass) draw_indexed(index_count int, first_index int, vertex_offset int, instance_count int, first_instance int) int {
    << checked(driver.pass_draw(pass.owner, pass.handle, index_count, first_index, instance_count, first_instance, 1, vertex_offset)) or >>
}
pub fn (pass $&RenderPass) end() int {
    if pass.handle == 0 { << 0 }
    checked(driver.pass_end(pass.owner, pass.handle)) or >>
    pass.handle = 0
    << 0
}
// Cancel closes an active pass, discards recorded commands and frees references.
pub fn (encoder $&CommandEncoder) close() int {
    if encoder.handle == 0 { << 0 }
    checked(driver.encoder_close(encoder.owner, encoder.handle)) or >>
    encoder.handle = 0
    << 0
}
fn (encoder $&CommandEncoder) drop() { if encoder.handle > 0 { driver.encoder_close(encoder.owner, encoder.handle)
    encoder.handle = 0 } }
fn (pass $&RenderPass) drop() { if pass.handle > 0 { driver.pass_end(pass.owner, pass.handle)
    pass.handle = 0 } }
