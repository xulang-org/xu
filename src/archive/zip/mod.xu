@archive/zip


#errors
#compress/flate
#hash/crc32

// ZIP subset aligned with Go `archive/zip` Reader/Writer common path.
// Archives are owning strings (no io.Reader). Writer emits Store or
// deflate (via compress.flate). Reader inflates method 8. No ZIP64,
// data descriptor, encryption, or disk spanning.

// Fixed end-of-central-directory record length, excluding its comment.
const EOCD_HEADER_BYTES = 22
// Fixed local-file header length, excluding its name and extra fields.
const LOCAL_HEADER_BYTES = 30

pub const STORE = 0
pub const DEFLATE = 8

const LOCAL_SIG = 67324752
const CD_SIG = 33639248
const EOCD_SIG = 101010256
const U16MAX = 65535
const UTF8_FLAG = 2048

pub struct File {
    pub name string
    pub method int
    pub crc32 int
    pub compressed_size int
    pub uncompressed_size int
    pub body string
}

pub struct Reader {
    pub data string
    pub pos int
}

pub struct Writer {
    pub buf string
    pub names []string
    pub methods []int
    pub crcs []int
    pub comps []int
    pub uncomps []int
    pub offsets []int
    pub closed int
    pub comment string
}

pub fn new_reader(data &string) Reader {
    << Reader{data: data + "", pos: 0}
}

pub fn new_writer() Writer {
    << Writer{
        buf: "",
        names: []string{},
        methods: []int{},
        crcs: []int{},
        comps: []int{},
        uncomps: []int{},
        offsets: []int{},
        closed: 0,
        comment: ""
    }
}

pub fn (w $&Writer) set_comment(s string) {
    w.comment = s + ""
}

pub fn (w &Writer) file_count() int {
    << w.names.len
}

pub fn comment(data &string) string {
    src := data + ""
    if src.len < EOCD_HEADER_BYTES {
        >> errors.new("zip: invalid archive")
    }
    $i := src.len - EOCD_HEADER_BYTES
    while i >= 0 {
        if get_u32(&src, i) == EOCD_SIG {
            clen := get_u16(&src, i + 20)
            if i + EOCD_HEADER_BYTES + clen <= src.len {
                if clen == 0 {
                    << ""
                }
                << src[(i + EOCD_HEADER_BYTES):(i + EOCD_HEADER_BYTES + clen)] + ""
            }
        }
        i = i - 1
    }
    >> errors.new("zip: missing end of central directory")
}

fn push_u16(b $&[]int, v int) {
    b.push(v & 255)
    b.push((v >> 8) & 255)
}

fn push_u32(b $&[]int, v int) {
    b.push(v & 255)
    b.push((v >> 8) & 255)
    b.push((v >> 16) & 255)
    b.push((v >> 24) & 255)
}

fn get_u16(s &string, off int) int {
    << (s[off] & 255) | ((s[off + 1] & 255) << 8)
}

fn get_u32(s &string, off int) int {
    << (s[off] & 255) | ((s[off + 1] & 255) << 8) | ((s[off + 2] & 255) << 16) | ((s[off + 3] & 255) << 24)
}

fn local_hdr(method int, crc int, csize int, usize int, nlen int) string {
    $b := []int{}
    push_u32($&b, LOCAL_SIG)
    push_u16($&b, 20)
    push_u16($&b, UTF8_FLAG)
    push_u16($&b, method)
    push_u16($&b, 0)
    push_u16($&b, 0)
    push_u32($&b, crc)
    push_u32($&b, csize)
    push_u32($&b, usize)
    push_u16($&b, nlen)
    push_u16($&b, 0)
    << string_from_bytes(b)
}

fn cd_hdr(method int, crc int, csize int, usize int, nlen int, off int) string {
    $b := []int{}
    push_u32($&b, CD_SIG)
    push_u16($&b, 20)
    push_u16($&b, 20)
    push_u16($&b, UTF8_FLAG)
    push_u16($&b, method)
    push_u16($&b, 0)
    push_u16($&b, 0)
    push_u32($&b, crc)
    push_u32($&b, csize)
    push_u32($&b, usize)
    push_u16($&b, nlen)
    push_u16($&b, 0)
    push_u16($&b, 0)
    push_u16($&b, 0)
    push_u16($&b, 0)
    push_u32($&b, 0)
    push_u32($&b, off)
    << string_from_bytes(b)
}

pub fn (w &Writer) bytes() string {
    << w.buf + ""
}

pub fn (w $&Writer) write_file(name &string, body &string) int {
    << w.write_file_method(name, body, STORE)
}

pub fn (w $&Writer) write_file_deflate(name &string, body &string) int {
    << w.write_file_method(name, body, DEFLATE)
}

fn (w $&Writer) write_file_method(name &string, body &string, method int) int {
    if w.closed != 0 {
        >> errors.new("zip: write after close")
    }
    nm := name + ""
    if nm.len == 0 {
        >> errors.new("zip: empty name")
    }
    if nm.len > U16MAX {
        >> errors.new("zip: FileHeader.Name too long")
    }
    raw := body + ""
    crc := crc32.checksum_ieee(&raw)
    $payload := raw + ""
    $meth := method
    if method == DEFLATE {
        dr := flate.deflate(&raw)
                payload = dr
        meth = DEFLATE
    } else {
        meth = STORE
    }
    off := w.buf.len
    hdr := local_hdr(meth, crc, payload.len, raw.len, nm.len)
    r := $&w.buf
    r.push_str(hdr)
    r.push_str(nm)
    r.push_str(payload)
    w.names.push(nm + "")
    w.methods.push(meth)
    w.crcs.push(crc)
    w.comps.push(payload.len)
    w.uncomps.push(raw.len)
    w.offsets.push(off)
    << raw.len
}

pub fn (w $&Writer) close() int {
    if w.closed != 0 {
        << 0
    }
    n := w.names.len
    if n > U16MAX {
        >> errors.new("zip: too many files")
    }
    cd_off := w.buf.len
    $i := 0
    while i < n {
        nm := w.names[i] + ""
        hdr := cd_hdr(w.methods[i], w.crcs[i], w.comps[i], w.uncomps[i], nm.len, w.offsets[i])
        r := $&w.buf
        r.push_str(hdr)
        r.push_str(nm)
        i = i + 1
    }
    cd_size := w.buf.len - cd_off
    $e := []int{}
    push_u32($&e, EOCD_SIG)
    push_u16($&e, 0)
    push_u16($&e, 0)
    push_u16($&e, n)
    push_u16($&e, n)
    push_u32($&e, cd_size)
    push_u32($&e, cd_off)
    cmt := w.comment + ""
    clen := cmt.len
    if clen > U16MAX {
        >> errors.new("zip: comment too long")
    }
    push_u16($&e, clen)
    tail := string_from_bytes(e)
    r2 := $&w.buf
    r2.push_str(tail)
    if clen > 0 {
        r2.push_str(cmt)
    }
    w.closed = 1
    << 0
}

pub fn (r $&Reader) next() File {
    src := r.data + ""
    if r.pos + 4 > src.len {
        >> errors.new("EOF")
    }
    sig := get_u32(&src, r.pos)
    if sig == CD_SIG {
        >> errors.new("EOF")
    }
    if sig == EOCD_SIG {
        >> errors.new("EOF")
    }
    if sig != LOCAL_SIG {
        >> errors.new("zip: invalid ZIP file")
    }
    if r.pos + LOCAL_HEADER_BYTES > src.len {
        >> errors.new("zip: unexpected EOF")
    }
    flags := get_u16(&src, r.pos + 6)
    if (flags & 8) != 0 {
        >> errors.new("zip: data descriptor not supported")
    }
    method := get_u16(&src, r.pos + 8)
    crc := get_u32(&src, r.pos + 14)
    csize := get_u32(&src, r.pos + 18)
    usize := get_u32(&src, r.pos + 22)
    nlen := get_u16(&src, r.pos + 26)
    elen := get_u16(&src, r.pos + 28)
    start := r.pos + LOCAL_HEADER_BYTES
    if start + nlen + elen + csize > src.len {
        >> errors.new("zip: unexpected EOF")
    }
    nm := src[start:(start + nlen)] + ""
    data_off := start + nlen + elen
    $comp := ""
    if csize > 0 {
        comp = src[data_off:(data_off + csize)] + ""
    }
    r.pos = data_off + csize
    $body := comp + ""
    if method == DEFLATE {
        ir := flate.inflate(&comp)
                body = ir
    } else {
        if method != STORE {
            >> errors.new("zip: unsupported compression")
        }
    }
    got := crc32.checksum_ieee(&body)
    if got != crc {
        >> errors.new("zip: checksum error")
    }
    << File{
        name: nm,
        method: method,
        crc32: crc,
        compressed_size: csize,
        uncompressed_size: usize,
        body: body
    }
}
