@archive/tar


#errors
// USTAR tar subset aligned with Go `archive/tar` Header + Reader/Writer
// common path. Archives are owning strings (no io.Reader). ustar headers
// plus GNU longname/longlink (`L`/`K`) and per-file PAX metadata (`x`).
// Global PAX records may contain timestamps and ownership, but not path/size.
// No sparse files or streaming FileInfo.

pub const BLOCK_SIZE = 512
pub const TYPE_REG = 48
pub const TYPE_LINK = 49
pub const TYPE_SYMLINK = 50
pub const TYPE_DIR = 53
pub const TYPE_GNU_LONGLINK = 75
pub const TYPE_GNU_LONGNAME = 76
pub const TYPE_XHEADER = 120
pub const TYPE_XGLOBAL_HEADER = 103

pub struct Header {
    pub name string
    pub size int
    pub mode int
    pub typeflag int
    pub linkname string
    pub uname string
    pub gname string
    pub mtime int
}

pub struct File {
    pub name string
    pub size int
    pub mode int
    pub typeflag int
    pub linkname string
    pub uname string
    pub gname string
    pub mtime int
    pub body string
}

pub struct Reader {
    pub data string
    pub pos int
}

pub struct Writer {
    pub buf string
    pub closed int
    pub nfiles int
}

pub fn new_header() Header {
    << Header{
        name: "",
        size: 0,
        mode: 0,
        typeflag: TYPE_REG,
        linkname: "",
        uname: "",
        gname: "",
        mtime: 0
    }
}

pub fn new_reader(data &string) Reader {
    << Reader{data: data + "", pos: 0}
}

pub fn new_writer() Writer {
    << Writer{buf: "", closed: 0, nfiles: 0}
}

pub fn (w &Writer) file_count() int {
    << w.nfiles
}

fn octal_digits(x int) string {
    if x == 0 {
        << "0"
    }
    mut n := x
    mut digits := []int{}
    while n > 0 {
        digits.push(48 + (n % 8))
        n = n / 8
    }
    mut b := []int{}
    mut i := digits.len
    while i > 0 {
        i = i - 1
        b.push(digits[i])
    }
    << string_from_bytes(b)
}

fn put_str(b &mut []int, off int, n int, s &string) {
    mut i := 0
    while i < n {
        mut v := 0
        if i < s.len {
            v = s[i] & 255
        }
        b[off + i] = v
        i = i + 1
    }
}

fn put_octal(b &mut []int, off int, n int, x int) int {
    if x < 0 {
        >> errors.new("archive/tar: negative field")
    }
    s := octal_digits(x)
    if s.len > n - 1 {
        >> errors.new("archive/tar: field too long")
    }
    mut pad := n - 1 - s.len
    mut i := 0
    while i < pad {
        b[off + i] = 48
        i = i + 1
    }
    mut j := 0
    while j < s.len {
        b[off + pad + j] = s[j] & 255
        j = j + 1
    }
    b[off + n - 1] = 0
    << 0
}

fn parse_cstr(b &[]int, off int, n int) string {
    mut i := 0
    while i < n {
        if (b[off + i] & 255) == 0 {
            <-
        }
        i = i + 1
    }
    mut out := []int{}
    for k in 0:i {
        out.push(b[off + k] & 255)
    }
    << string_from_bytes(out)
}

fn parse_octal(b &[]int, off int, n int) int {
    mut i := off
    end := off + n
    while i < end {
        c := b[i] & 255
        if c == 0 || c == 32 {
            i = i + 1
        } else {
            <-
        }
    }
    mut j := end
    while j > i {
        c := b[j - 1] & 255
        if c == 0 || c == 32 {
            j = j - 1
        } else {
            <-
        }
    }
    mut v := 0
    mut p := i
    while p < j {
        c := b[p] & 255
        if c < 48 || c > 55 {
            >> errors.new("archive/tar: invalid tar header")
        }
        v = v * 8 + (c - 48)
        p = p + 1
    }
    << v
}

fn checksum_unsigned(b &[]int) int {
    mut s := 0
    for i in 0:BLOCK_SIZE {
        if i >= 148 && i < 156 {
            s = s + 32
        } else {
            s = s + (b[i] & 255)
        }
    }
    << s
}

fn checksum_signed(b &[]int) int {
    mut s := 0
    for i in 0:BLOCK_SIZE {
        mut v := 32
        if i < 148 || i >= 156 {
            v = b[i] & 255
            if v >= 128 {
                v = v - 256
            }
        }
        s = s + v
    }
    << s
}

fn bytes512(src &string, off int) []int {
    if off < 0 || off + BLOCK_SIZE > src.len {
        >> errors.new("archive/tar: truncated header")
    }
    mut b := []int{}
    for i in 0:BLOCK_SIZE {
        b.push(src[off + i] & 255)
    }
    << b
}

fn is_zero(b &[]int) bool {
    for i in 0:b.len {
        if (b[i] & 255) != 0 {
            << false
        }
    }
    << true
}

fn pad512(n int) string {
    mut r := n % BLOCK_SIZE
    if r == 0 {
        << ""
    }
    mut b := []int{}
    need := BLOCK_SIZE - r
    for i in 0:need {
        b.push(0)
    }
    << string_from_bytes(b)
}

pub fn encode_header(h &Header) string {
    nm := h.name + ""
    if nm.len == 0 {
        >> errors.new("archive/tar: empty name")
    }
    if nm.len > 100 {
        >> errors.new("archive/tar: field too long")
    }
    mut b := []int{}
    for i in 0:BLOCK_SIZE {
        b.push(0)
    }
    put_str(mut &b, 0, 100, &nm)
    put_octal(mut &b, 100, 8, h.mode)
    put_octal(mut &b, 108, 8, 0)
    put_octal(mut &b, 116, 8, 0)
    put_octal(mut &b, 124, 12, h.size)
    put_octal(mut &b, 136, 12, h.mtime)
    for i in 0:8 {
        b[148 + i] = 32
    }
    mut tf := h.typeflag
    if tf == 0 {
        tf = TYPE_REG
    }
    b[156] = tf & 255
    ln := h.linkname + ""
    if ln.len > 100 {
        >> errors.new("archive/tar: field too long")
    }
    put_str(mut &b, 157, 100, &ln)
    mag := "ustar"
    put_str(mut &b, 257, 5, &mag)
    b[262] = 0
    b[263] = 48
    b[264] = 48
    un := h.uname + ""
    if un.len > 32 {
        >> errors.new("archive/tar: field too long")
    }
    put_str(mut &b, 265, 32, &un)
    gn := h.gname + ""
    if gn.len > 32 {
        >> errors.new("archive/tar: field too long")
    }
    put_str(mut &b, 297, 32, &gn)
    sum := checksum_unsigned(&b)
    put_octal(mut &b, 148, 8, sum)
    << string_from_bytes(b)
}

pub fn parse_header(blk &string) Header {
    br := bytes512(blk, 0)
        b := br
    if is_zero(&b) {
        >> errors.new("EOF")
    }
    stored_r := parse_octal(&b, 148, 8)
        stored := stored_r
    us := checksum_unsigned(&b)
    ss := checksum_signed(&b)
    if stored != us && stored != ss {
        >> errors.new("archive/tar: invalid tar header")
    }
    mut name := parse_cstr(&b, 0, 100)
    prefix := parse_cstr(&b, 345, 155)
    if prefix.len > 0 {
        name = prefix + "/" + name
    }
    size_r := parse_octal(&b, 124, 12)
        mode_r := parse_octal(&b, 100, 8)
        mtime_r := parse_octal(&b, 136, 12)
        tf := b[156] & 255
    ln := parse_cstr(&b, 157, 100)
    un := parse_cstr(&b, 265, 32)
    gn := parse_cstr(&b, 297, 32)
    << Header{
        name: name,
        size: size_r,
        mode: mode_r,
        typeflag: tf,
        linkname: ln,
        uname: un,
        gname: gn,
        mtime: mtime_r
    }
}

fn strip_nul(s string) string {
    mut end := s.len
    while end > 0 {
        if (s[end - 1] & 255) != 0 {
            <-
        }
        end = end - 1
    }
    if end == s.len {
        << s
    }
    if end == 0 {
        << ""
    }
    << s[0:end] + ""
}

// PAX records include their own decimal byte length, including the newline.
// Unknown metadata is ignored; layout-changing sparse records are rejected.
fn pax_fields(body &string) []string {
    mut fields := ["", "", ""]
    mut pos := 0
    while pos < body.len {
        mut end := pos
        mut length := 0
        while end < body.len && body[end] >= 48 && body[end] <= 57 {
            digit := body[end] - 48
            if length > (body.len - digit) / 10 { >> errors.new("archive/tar: invalid PAX length") }
            length = length * 10 + digit
            end = end + 1
        }
        if end == pos || end >= body.len || body[end] != 32 || length > body.len - pos || length <= end - pos + 2 {
            >> errors.new("archive/tar: invalid PAX record")
        }
        stop := pos + length
        if body[stop - 1] != 10 { >> errors.new("archive/tar: invalid PAX newline") }
        mut equal := end + 1
        while equal < stop - 1 && body[equal] != 61 { equal = equal + 1 }
        if equal == end + 1 || equal >= stop - 1 { >> errors.new("archive/tar: invalid PAX field") }
        key := body[end + 1:equal] + ""
        value := body[equal + 1:stop - 1] + ""
        if key == "path" { fields[0] = value + "" }
        if key == "linkpath" { fields[1] = value + "" }
        if key == "size" { fields[2] = value + "" }
        if key.len >= 10 && key[0:10] == "GNU.sparse" { >> errors.new("archive/tar: sparse PAX unsupported") }
        pos = stop
    }
    << fields
}

fn pax_size(text &string) int {
    mut size := 0
    for i in 0:text.len {
        digit := text[i] - 48
        if digit < 0 || digit > 9 || size > (9223372036854775807 - digit) / 10 {
            >> errors.new("archive/tar: invalid PAX size")
        }
        size = size * 10 + digit
    }
    << size
}

fn (r &mut Reader) next_one() File {
    src := r.data + ""
    br := bytes512(&src, r.pos)
        b := br
    if is_zero(&b) {
        >> errors.new("EOF")
    }
    blk := src[r.pos:(r.pos + BLOCK_SIZE)] + ""
    hr := parse_header(&blk)
        h := hr
    start := r.pos + BLOCK_SIZE
    if start + h.size > src.len {
        >> errors.new("archive/tar: truncated archive")
    }
    mut body := ""
    if h.size > 0 {
        body = src[start:(start + h.size)] + ""
    }
    pad := (BLOCK_SIZE - (h.size % BLOCK_SIZE)) % BLOCK_SIZE
    r.pos = start + h.size + pad
    << File{
        name: h.name + "",
        size: h.size,
        mode: h.mode,
        typeflag: h.typeflag,
        linkname: h.linkname + "",
        uname: h.uname + "",
        gname: h.gname + "",
        mtime: h.mtime,
        body: body
    }
}

pub fn (r &mut Reader) next() File {
    mut longname := ""
    mut longlink := ""
    mut have_name := 0
    mut have_link := 0
    mut pax := ["", "", ""]
    mut n := 0
    while n < 8 {
        n = n + 1
        mut f := r.next_one() or >>
        if f.typeflag == TYPE_XHEADER || f.typeflag == TYPE_XGLOBAL_HEADER {
            fields := pax_fields(&f.body) or >>
            if f.typeflag == TYPE_XGLOBAL_HEADER {
                if fields[0].len > 0 || fields[1].len > 0 || fields[2].len > 0 {
                    >> errors.new("archive/tar: global PAX path/size unsupported")
                }
            } else {
                for i in 0:3 { pax[i] = fields[i] + "" }
            }
            ->
        }
        if f.typeflag == TYPE_GNU_LONGNAME {
            longname = strip_nul(f.body + "")
            have_name = 1
            ->
        }
        if f.typeflag == TYPE_GNU_LONGLINK {
            longlink = strip_nul(f.body + "")
            have_link = 1
            ->
        }
        if have_name != 0 {
            f.name = longname + ""
        }
        if have_link != 0 {
            f.linkname = longlink + ""
        }
        if pax[0].len > 0 { f.name = pax[0] + "" }
        if pax[1].len > 0 { f.linkname = pax[1] + "" }
        if pax[2].len > 0 {
            size := pax_size(&pax[2]) or >>
            if size != f.size { >> errors.new("archive/tar: PAX size override unsupported") }
        }
        << f
    }
    >> errors.new("archive/tar: too many special headers")
}

pub fn (w &Writer) bytes() string {
    << w.buf + ""
}

pub fn (w &mut Writer) write_header(h &Header, body &string) int {
    if w.closed != 0 {
        >> errors.new("archive/tar: write after close")
    }
    if h.size != body.len {
        >> errors.new("archive/tar: write too long")
    }
    blk := encode_header(h)
    r := mut &w.buf
    r.push_str(blk)
    r.push_str(body + "")
    r.push_str(pad512(body.len))
    << body.len
}

fn gnu_longlink_name() string {
    << "././@LongLink"
}

fn (w &mut Writer) write_gnu_special(tf int, payload &string) int {
    mut body := payload + ""
    body.push_byte(0)
    nm := gnu_longlink_name()
    h := Header{
        name: nm,
        size: body.len,
        mode: 0,
        typeflag: tf,
        linkname: "",
        uname: "",
        gname: "",
        mtime: 0
    }
    << w.write_header(&h, &body) or >>
}

fn tar_short_name(name string) string {
    if name.len <= 100 {
        << name
    }
    << name[0:100] + ""
}

pub fn (w &mut Writer) write_file(name &string, body &string, mode int) int {
    mut nm := name + ""
    if nm.len == 0 {
        >> errors.new("archive/tar: empty name")
    }
    if nm.len > 100 {
        w.write_gnu_special(TYPE_GNU_LONGNAME, &nm) or >>
        nm = tar_short_name(nm)
    }
    h := Header{
        name: nm,
        size: body.len,
        mode: mode,
        typeflag: TYPE_REG,
        linkname: "",
        uname: "",
        gname: "",
        mtime: 0
    }
    n := w.write_header(&h, body) or >>
    w.nfiles = w.nfiles + 1
    << n
}

pub fn (w &mut Writer) write_dir(name &string, mode int) int {
    mut nm := name + ""
    if nm.len == 0 {
        >> errors.new("archive/tar: empty name")
    }
    if (nm[nm.len - 1] & 255) != 47 {
        nm = nm + "/"
    }
    if nm.len > 100 {
        w.write_gnu_special(TYPE_GNU_LONGNAME, &nm) or >>
        nm = tar_short_name(nm)
    }
    empty := ""
    h := Header{
        name: nm,
        size: 0,
        mode: mode,
        typeflag: TYPE_DIR,
        linkname: "",
        uname: "",
        gname: "",
        mtime: 0
    }
    n := w.write_header(&h, &empty) or >>
    w.nfiles = w.nfiles + 1
    << n
}

pub fn (w &mut Writer) close() int {
    if w.closed != 0 {
        << 0
    }
    mut z := []int{}
    for i in 0:1024 {
        z.push(0)
    }
    r := mut &w.buf
    r.push_str(string_from_bytes(z))
    w.closed = 1
    << 0
}
