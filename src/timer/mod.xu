@timer

#errors
#time

// High-density timers for heartbeats / TTL / file RTO.
//
// time.AfterFunc / Ticker spawn one sleeper task each. A gateway holding
// 5k heartbeats must not own 5k tasks.
//
// v1 Wheel is **poll-based**: the caller owns the list (no `$&` across
// `xu`, S6). Typical use is one coordinator task:
//
//     w := timer.new()
//     w.after_ns(30 * time.millisecond())
//     w.every_ns(time.second())
//     for {
//         id := w.run()   // sleeps until next deadline, returns due id
//         ...
//     }
//
// A background `xu` wrapper can sit on top once channel-of-struct is
// proven on the self-host path.

pub struct Item {
    deadline_ns int
    interval_ns int
    id int
    live bool
}

pub struct Wheel {
    tick_ns int
    list []Item
    next_id int
}

// new creates an empty wheel with 1 ms floor resolution.
pub fn new() Wheel {
    << Wheel{tick_ns: 1000000, list: []Item{}, next_id: 1}
}

fn insert_bubble(list $&[]Item, it Item) {
    list.push(it)
    $i := list.len - 1
    while i > 0 {
        if list[i].deadline_ns >= list[i - 1].deadline_ns {
            <-
        }
        tmp := list[i]
        list[i] = list[i - 1]
        list[i - 1] = tmp
        i = i - 1
    }
}

fn next_live(list &[]Item) int {
    $i := 0
    while i < list.len {
        if list[i].live {
            << i
        }
        i = i + 1
    }
    << -1
}

// after_ns arms a one-shot. Returns id (>0).
pub fn (w $&Wheel) after_ns(delay_ns int) int {
    $d := delay_ns
    if d < 0 {
        d = 0
    }
    id := w.next_id
    w.next_id = w.next_id + 1
    insert_bubble($&w.list, Item{deadline_ns: time.now() + d, interval_ns: 0, id: id, live: true})
    << id
}

// every_ns arms a repeating timer.
pub fn (w $&Wheel) every_ns(period_ns int) int {
    $p := period_ns
    if p < w.tick_ns {
        p = w.tick_ns
    }
    id := w.next_id
    w.next_id = w.next_id + 1
    insert_bubble($&w.list, Item{deadline_ns: time.now() + p, interval_ns: p, id: id, live: true})
    << id
}

// cancel disarms. Returns true if the id was still armed.
pub fn (w $&Wheel) cancel(id int) bool {
    $i := 0
    $ok := false
    while i < w.list.len {
        if w.list[i].id == id && w.list[i].live {
            e := $&w.list[i]
            e.live = false
            ok = true
        }
        i = i + 1
    }
    << ok
}

// try_due pops one due id without sleeping. 0 when none.
pub fn (w $&Wheel) try_due() int {
    now := time.now()
    di := next_live(&w.list)
    if di < 0 {
        << 0
    }
    if w.list[di].deadline_ns > now {
        << 0
    }
    top := w.list[di]
    // write through by value (ref field assign has been unreliable here)
    w.list[di] = Item{deadline_ns: top.deadline_ns, interval_ns: top.interval_ns, id: top.id, live: false}
    if top.interval_ns > 0 {
        $nd := top.deadline_ns + top.interval_ns
        if nd < now {
            nd = now + top.interval_ns
        }
        insert_bubble($&w.list, Item{deadline_ns: nd, interval_ns: top.interval_ns, id: top.id, live: true})
    }
    << top.id
}

// run sleeps until the next deadline (or tick), then pops due ids.
// Returns 0 when nothing is armed (after sleeping one tick).
pub fn (w $&Wheel) run() int {
    id := w.try_due()
    if id != 0 {
        << id
    }
    di := next_live(&w.list)
    if di < 0 {
        time.sleep(w.tick_ns)
        << 0
    }
    now := time.now()
    delta := w.list[di].deadline_ns - now
    if delta > 0 {
        time.sleep(delta)
    } else {
        time.sleep(1)
    }
    << w.try_due()
}
