@html

// HTML escaping aligned with Go `html.EscapeString` / `UnescapeString` subset.
// Named entities: five XML specials plus a small HTML set (nbsp/copy/…);
// numeric &#Dec; / &#xhex;.

pub fn escape_string(s &string) string {
    mut out := ""
    for i in 0:s.len {
        c := s[i] & 255
        if c == 38 {
            out = out + "&amp;"
        } else if c == 60 {
            out = out + "&lt;"
        } else if c == 62 {
            out = out + "&gt;"
        } else if c == 34 {
            out = out + "&#34;"
        } else if c == 39 {
            out = out + "&#39;"
        } else {
            out = out + string_from_byte(c)
        }
    }
    << out
}

fn is_hex(c int) bool {
    if c >= 48 && c <= 57 {
        << true
    }
    if c >= 65 && c <= 70 {
        << true
    }
    if c >= 97 && c <= 102 {
        << true
    }
    << false
}

fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

fn hex_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    << 0
}

fn append_rune(out0 string, cp int) string {
    mut out := out0
    if cp < 0 || cp > 1114111 {
        << out
    }
    if cp < 128 {
        << out + string_from_byte(cp)
    }
    if cp < 2048 {
        out = out + string_from_byte(192 | (cp >> 6))
        out = out + string_from_byte(128 | (cp & 63))
        << out
    }
    if cp < 65536 {
        if cp >= 55296 && cp <= 57343 {
            << out
        }
        out = out + string_from_byte(224 | (cp >> 12))
        out = out + string_from_byte(128 | ((cp >> 6) & 63))
        out = out + string_from_byte(128 | (cp & 63))
        << out
    }
    out = out + string_from_byte(240 | (cp >> 18))
    out = out + string_from_byte(128 | ((cp >> 12) & 63))
    out = out + string_from_byte(128 | ((cp >> 6) & 63))
    out = out + string_from_byte(128 | (cp & 63))
    << out
}

fn named_entity(name string) int {
    if name == "amp" {
        << 38
    }
    if name == "lt" {
        << 60
    }
    if name == "gt" {
        << 62
    }
    if name == "quot" {
        << 34
    }
    if name == "apos" {
        << 39
    }
    if name == "nbsp" {
        << 160
    }
    if name == "copy" {
        << 169
    }
    if name == "reg" {
        << 174
    }
    if name == "deg" {
        << 176
    }
    if name == "plusmn" {
        << 177
    }
    if name == "times" {
        << 215
    }
    if name == "divide" {
        << 247
    }
    if name == "ndash" {
        << 8211
    }
    if name == "mdash" {
        << 8212
    }
    if name == "lsquo" {
        << 8216
    }
    if name == "rsquo" {
        << 8217
    }
    if name == "ldquo" {
        << 8220
    }
    if name == "rdquo" {
        << 8221
    }
    if name == "hellip" {
        << 8230
    }
    if name == "trade" {
        << 8482
    }
    << -1
}

pub fn unescape_string(s &string) string {
    text := s + ""
    mut out := ""
    mut i := 0
    while i < text.len {
        c := text[i] & 255
        if c != 38 {
            out = out + string_from_byte(c)
            i = i + 1
            ->
        }
        if i + 1 >= text.len {
            out = out + "&"
            i = i + 1
            ->
        }
        if (text[i + 1] & 255) == 35 {
            mut j := i + 2
            if j >= text.len {
                out = out + "&"
                i = i + 1
                ->
            }
            mut hex := false
            if (text[j] & 255) == 120 || (text[j] & 255) == 88 {
                hex = true
                j = j + 1
            }
            start := j
            if hex {
                while j < text.len && is_hex(text[j] & 255) {
                    j = j + 1
                }
            } else {
                while j < text.len && is_digit(text[j] & 255) {
                    j = j + 1
                }
            }
            if j == start {
                out = out + "&"
                i = i + 1
                ->
            }
            mut cp := 0
            if hex {
                for k in start:j {
                    cp = cp * 16 + hex_val(text[k] & 255)
                }
            } else {
                for k in start:j {
                    cp = cp * 10 + ((text[k] & 255) - 48)
                }
            }
            if j < text.len && (text[j] & 255) == 59 {
                j = j + 1
            }
            out = append_rune(out, cp)
            i = j
            ->
        }
        mut j := i + 1
        while j < text.len {
            ch := text[j] & 255
            if (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) {
                j = j + 1
            } else {
                <-
            }
        }
        if j == i + 1 {
            out = out + "&"
            i = i + 1
            ->
        }
        name := text[(i + 1):j]
        if j < text.len && (text[j] & 255) == 59 {
            j = j + 1
        }
        ent := named_entity(name)
        if ent < 0 {
            for k in i:j {
                out = out + string_from_byte(text[k])
            }
            i = j
            ->
        }
        out = append_rune(out, ent)
        i = j
    }
    << out
}
