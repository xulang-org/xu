@html/query

#errors
#strings

// Minimal HTML DOM + CSS query subset for scraping.
// Selectors: tag, #id, .class, tag.class, descendant (a b), child (a > b).
// Flat node pool (json.Doc style) — no recursive owning trees.

pub struct Attr {
	pub key   string
	pub value string
}

pub struct Doc {
	pub tags      []string
	pub texts     []string
	pub firsts    []int
	pub nexts     []int
	pub parents   []int
	pub attr_keys []string
	pub attr_vals []string
	pub attr_next []int
	pub attr_head []int
}

fn new_doc() Doc {
	<< Doc{
		tags: []string{},
		texts: []string{},
		firsts: []int{},
		nexts: []int{},
		parents: []int{},
		attr_keys: []string{},
		attr_vals: []string{},
		attr_next: []int{},
		attr_head: []int{}
	}
}

fn (d $&Doc) add_node(tag string, parent int) int {
	id := d.tags.len
	d.tags.push(tag + "")
	d.texts.push("")
	d.firsts.push(-1)
	d.nexts.push(-1)
	d.parents.push(parent)
	d.attr_head.push(-1)
	if parent >= 0 {
		if d.firsts[parent] < 0 {
			d.firsts[parent] = id
		} else {
			$sib := d.firsts[parent]
			while d.nexts[sib] >= 0 {
				sib = d.nexts[sib]
			}
			d.nexts[sib] = id
		}
	}
	<< id
}

fn (d $&Doc) add_attr(node int, key string, val string) {
	aid := d.attr_keys.len
	d.attr_keys.push(key + "")
	d.attr_vals.push(val + "")
	d.attr_next.push(d.attr_head[node])
	d.attr_head[node] = aid
}

fn (d $&Doc) append_text(node int, t string) {
	if t.len == 0 {
		<<
	}
	d.texts[node] = d.texts[node] + t
}

fn is_void(tag string) bool {
	<< tag == "br" || tag == "hr" || tag == "img" || tag == "meta" || tag == "link" || tag == "input" || tag == "area" || tag == "base" || tag == "col" || tag == "embed" || tag == "source" || tag == "wbr"
}

pub fn parse(html0 string) Doc {
	src := html0 + ""
	$d := new_doc()
	root := d.add_node("#document", -1)
	$stack := []int{}
	// Pre-grow so parse never reallocates the stack buffer.
	$gi := 0
	while gi < 32 {
		stack.push(-1)
		gi = gi + 1
	}
	stack[0] = root
	$sp := 1
	$i := 0
	while i < src.len {
		c := src[i] & 255
		if c == 60 {
			if i + 1 < src.len && (src[i + 1] & 255) == 47 {
				i = i + 2
				while i < src.len && (src[i] & 255) != 62 {
					i = i + 1
				}
				if i < src.len {
					i = i + 1
				}
				if sp > 1 {
					sp = sp - 1
				}
			} else if i + 3 < src.len && (src[i + 1] & 255) == 33 && (src[i + 2] & 255) == 45 && (src[i + 3] & 255) == 45 {
				i = i + 4
				while i + 2 < src.len {
					if (src[i] & 255) == 45 && (src[i + 1] & 255) == 45 && (src[i + 2] & 255) == 62 {
						i = i + 3
						<-
					}
					i = i + 1
				}
			} else if i + 1 < src.len && (src[i + 1] & 255) == 33 {
				// <!DOCTYPE ...> — skip
				i = i + 2
				while i < src.len && (src[i] & 255) != 62 {
					i = i + 1
				}
				if i < src.len {
					i = i + 1
				}
			} else {
				// Start of open tag. Bare '<' at EOF is ignored.
				if i + 1 >= src.len {
					<-
				}
				i = i + 1
				$name := ""
				while i < src.len {
					ch := src[i] & 255
					if ch == 62 || ch == 32 || ch == 9 || ch == 10 || ch == 13 || ch == 47 {
						<-
					}
					name = name + string_from_byte(ch)
					i = i + 1
				}
				if name.len == 0 {
					i = src.len
					->
				}
				$has_gt := 0
				$scan := i
				while scan < src.len {
					if (src[scan] & 255) == 62 {
						has_gt = 1
						<-
					}
					scan = scan + 1
				}
				if has_gt == 0 {
					i = src.len
					->
				}
				lname := strings.to_lower(&name)
				if sp <= 0 {
					i = src.len
					->
				}
				parent := stack[sp - 1]
				nid := d.add_node(lname + "", parent)
				while i < src.len {
					ch := src[i] & 255
					if ch == 62 || ch == 47 {
						<-
					}
					if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
						i = i + 1
						->
					}
					$k := ""
					while i < src.len {
						ch2 := src[i] & 255
						if ch2 == 61 || ch2 == 32 || ch2 == 9 || ch2 == 62 || ch2 == 47 {
							<-
						}
						k = k + string_from_byte(ch2)
						i = i + 1
					}
					$v := ""
					if i < src.len && (src[i] & 255) == 61 {
						i = i + 1
						if i < src.len && ((src[i] & 255) == 34 || (src[i] & 255) == 39) {
							q := src[i] & 255
							i = i + 1
							while i < src.len && (src[i] & 255) != q {
								v = v + string_from_byte(src[i] & 255)
								i = i + 1
							}
							if i < src.len {
								i = i + 1
							}
						} else {
							// Unquoted attr values may contain '/'; only WS or '>' ends them.
							while i < src.len {
								ch3 := src[i] & 255
								if ch3 == 32 || ch3 == 9 || ch3 == 10 || ch3 == 13 || ch3 == 62 {
									<-
								}
								v = v + string_from_byte(ch3)
								i = i + 1
							}
						}
					}
					if k.len > 0 {
						lk := strings.to_lower(&k)
						d.add_attr(nid, lk + "", v + "")
					}
				}
				// Self-close only when '/' is immediately before '>'
				$self_close := 0
				if i < src.len && (src[i] & 255) == 47 {
					if i + 1 < src.len && (src[i + 1] & 255) == 62 {
						self_close = 1
						i = i + 1
					}
				}
				while i < src.len && (src[i] & 255) != 62 {
					i = i + 1
				}
				if i < src.len {
					i = i + 1
				} else {
					// Unterminated tag — do not push onto stack.
					i = src.len
					->
				}
				if self_close == 0 && !is_void(lname + "") {
					if sp >= stack.len {
						// Extremely deep nesting — drop further pushes.
						->
					}
					stack[sp] = nid
					sp = sp + 1
				}
			}
		} else {
			$t := ""
			while i < src.len && (src[i] & 255) != 60 {
				t = t + string_from_byte(src[i] & 255)
				i = i + 1
			}
			if sp > 0 {
				d.append_text(stack[sp - 1], t + "")
			}
		}
	}
	<< d
}

pub fn (d &Doc) root() int {
	<< 0
}

pub fn (d &Doc) tag(n int) string {
	if n < 0 || n >= d.tags.len {
		<< ""
	}
	<< d.tags[n] + ""
}

pub fn (d &Doc) attr(n int, key string) string {
	if n < 0 || n >= d.attr_head.len {
		<< ""
	}
	k := strings.to_lower(&key)
	$aid := d.attr_head[n]
	while aid >= 0 {
		if d.attr_keys[aid] == k {
			<< d.attr_vals[aid] + ""
		}
		aid = d.attr_next[aid]
	}
	<< ""
}

pub fn (d &Doc) text_content(n int) string {
	if n < 0 || n >= d.texts.len {
		<< ""
	}
	$out := d.texts[n] + ""
	$c := d.firsts[n]
	while c >= 0 {
		out = out + d.text_content(c)
		c = d.nexts[c]
	}
	<< out
}

fn class_has(d &Doc, n int, cls string) bool {
	raw := d.attr(n, "class")
	$cur := ""
	for i in 0:raw.len {
		ch := raw[i] & 255
		if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
			if cur.len > 0 {
				if cur == cls {
					<< true
				}
				cur = ""
			}
		} else {
			cur = cur + string_from_byte(ch)
		}
	}
	<< cur == cls
}

fn match_simple(d &Doc, n int, sel0 &string) bool {
	sel := strings.trim_space(sel0)
	if sel.len == 0 || n < 0 || n >= d.tags.len {
		<< false
	}
	tg := d.tags[n] + ""
	if tg == "#document" {
		<< false
	}
	$want_tag := ""
	$want_id := ""
	$want_class := ""
	$i := 0
	while i < sel.len {
		ch := sel[i] & 255
		if ch == 35 {
			i = i + 1
			$v := ""
			while i < sel.len {
				c2 := sel[i] & 255
				if c2 == 35 || c2 == 46 {
					<-
				}
				v = v + string_from_byte(c2)
				i = i + 1
			}
			want_id = v + ""
		} else if ch == 46 {
			i = i + 1
			$v := ""
			while i < sel.len {
				c2 := sel[i] & 255
				if c2 == 35 || c2 == 46 {
					<-
				}
				v = v + string_from_byte(c2)
				i = i + 1
			}
			want_class = v + ""
		} else {
			$v := ""
			while i < sel.len {
				c2 := sel[i] & 255
				if c2 == 35 || c2 == 46 {
					<-
				}
				v = v + string_from_byte(c2)
				i = i + 1
			}
			want_tag = strings.to_lower(&v)
		}
	}
	if want_tag.len > 0 && tg != want_tag {
		<< false
	}
	if want_id.len > 0 {
		got := d.attr(n, "id")
		if got != want_id {
			<< false
		}
	}
	if want_class.len > 0 {
		if !class_has(d, n, want_class) {
			<< false
		}
	}
	<< true
}

fn is_under(d &Doc, n int, ancestor int) bool {
	$p := n
	while p >= 0 {
		if p == ancestor {
			<< true
		}
		p = d.parents[p]
	}
	<< false
}

fn split_selector_chain(sel0 string) []string {
	sel := strings.trim_space(&sel0)
	$parts := []string{}
	$cur := ""
	$i := 0
	while i < sel.len {
		ch := sel[i] & 255
		if ch == 62 {
			if cur.len > 0 {
				t := strings.trim_space(&cur)
				parts.push(t + "")
				cur = ""
			}
			parts.push(">")
			i = i + 1
		} else if ch == 32 || ch == 9 || ch == 10 || ch == 13 {
			if cur.len > 0 {
				t := strings.trim_space(&cur)
				parts.push(t + "")
				cur = ""
			}
			i = i + 1
		} else {
			cur = cur + string_from_byte(ch)
			i = i + 1
		}
	}
	if cur.len > 0 {
		t := strings.trim_space(&cur)
		parts.push(t + "")
	}
	<< parts
}

// Iterative query — avoid recursive array ownership pitfalls.
pub fn (d &Doc) query_all(selector string) []int {
	parts := split_selector_chain(selector)
	if parts.len == 0 {
		<< []int{}
	}
	// Fast path: single simple selector — scan all nodes.
	if parts.len == 1 {
		sel := parts[0] + ""
		$out := []int{}
		$node := 0
		while node < d.tags.len {
			if match_simple(d, node, &sel) {
				out.push(node)
			}
			node = node + 1
		}
		<< out
	}
	$cur := []int{}
	cur.push(0)
	$pi := 0
	while pi < parts.len {
		$p := parts[pi] + ""
		$child_only := 0
		if p == ">" {
			pi = pi + 1
			if pi >= parts.len {
				<< cur
			}
			p = parts[pi] + ""
			child_only = 1
		}
		$next := []int{}
		$ni := 0
		while ni < cur.len {
			anc := cur[ni]
			$node := 0
			while node < d.tags.len {
				$ok := 0
				if child_only == 1 {
					if d.parents[node] == anc {
						if match_simple(d, node, &p) {
							ok = 1
						}
					}
				} else {
					if is_under(d, node, anc) {
						if match_simple(d, node, &p) {
							ok = 1
						}
					}
				}
				if ok == 1 {
					next.push(node)
				}
				node = node + 1
			}
			ni = ni + 1
		}
		cur = next
		pi = pi + 1
	}
	<< cur
}

pub fn (d &Doc) query(selector string) int {
	all := d.query_all(selector)
	if all.len > 0 {
		<< all[0]
	}
	<< -1
}
