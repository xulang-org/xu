@html/template

#text/template

// HTML-escaping template facade over text.template (M114).
// Interpolation ({{.}} / {{.Key}}) goes through html.escape_string;
// literal markup in the template source is left unchanged.
// No contextual escaping (script/style/url).

pub struct Template {
    pub src string
}

pub struct Dict {
    pub keys []string
    pub vals []string
}

pub fn new(src string) Template {
    << Template{src: src}
}

pub fn new_dict() Dict {
    << Dict{keys: []string{}, vals: []string{}}
}

pub fn (d $&Dict) set(k string, v string) {
    for i in 0:d.keys.len {
        if d.keys[i] == k {
            d.vals[i] = v
            <<
        }
    }
    d.keys.push(k)
    d.vals.push(v)
}

pub fn get(d &Dict, k string) string {
    for i in 0:d.keys.len {
        if d.keys[i] == k {
            << d.vals[i] + ""
        }
    }
    << ""
}

fn to_text_dict(d &Dict) template.Dict {
    $td := template.new_dict()
    for i in 0:d.keys.len {
        td.set(d.keys[i] + "", d.vals[i] + "")
    }
    << td
}

pub fn execute_str(t &Template, root string) string {
    inner := template.new(t.src + "")
    << template.execute_str_html(&inner, root) or (err) { << "" }
}

pub fn execute(t &Template, d &Dict) string {
    inner := template.new(t.src + "")
    td := to_text_dict(d)
    << template.execute_html(&inner, &td) or (err) { << "" }
}

pub fn execute_list(t &Template, items []string) string {
    inner := template.new(t.src + "")
    << template.execute_list_html(&inner, items) or (err) { << "" }
}
