@id

#crypto/rand
#encoding/hex
#errors
#time

// Sortable identifiers for messages / files / sessions.
//
// ULID (Crockford base32, 26 chars): 48-bit ms timestamp + 80-bit random.
// UUIDv7 (RFC 9562): 48-bit unix ms + version/variant + 62-bit random,
// canonical 8-4-4-4-12 lowercase hex.
//
// Monotonic ULID: same-millisecond ids increment the random field so
// lexicographic order matches issue order on one process. Xu forbids
// package mutable globals — keep a Monotonic generator per producer.

fn b32_enc(v int) int {
    d := "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    if v >= 0 && v < 32 {
        << d[v] & 255
    }
    << 48
}

fn b32_val(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    // Crockford: A=10 … Z=31 skipping I,L,O,U; accept aliases i/l→1 o→0
    if c == 79 || c == 111 {
        << 0
    }
    if c == 73 || c == 105 || c == 76 || c == 108 {
        << 1
    }
    if c >= 65 && c <= 90 {
        d := "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
        ch := c
        mut j := 0
        while j < 32 {
            if (d[j] & 255) == ch {
                << j
            }
            j = j + 1
        }
        << -1
    }
    if c >= 97 && c <= 122 {
        d := "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
        ch := c - 32
        mut j := 0
        while j < 32 {
            if (d[j] & 255) == ch {
                << j
            }
            j = j + 1
        }
        << -1
    }
    << -1
}

fn be48(ms int) string {
    mut b := []int{}
    mut x := ms
    if x < 0 {
        x = 0
    }
    mut i := 0
    while i < 6 {
        sh := 8 * (5 - i)
        b.push((x >> sh) & 255)
        i = i + 1
    }
    << string_from_bytes(b)
}

fn inc_bytes(s string) string {
    mut b := []int{}
    for i in 0:s.len {
        b.push(s[i] & 255)
    }
    mut i := b.len - 1
    mut carry := 1
    while i >= 0 && carry == 1 {
        v := b[i] + carry
        if v > 255 {
            b[i] = 0
            carry = 1
        } else {
            b[i] = v
            carry = 0
        }
        i = i - 1
    }
    << string_from_bytes(b)
}

fn ulid_from(ms int, rnd10 string) string {
    ts := be48(ms)
    mut raw := ts + ""
    r := rnd10 + ""
    if r.len < 10 {
        mut rb := r + ""
        while rb.len < 10 {
            rb = rb + string_from_byte(0)
        }
        raw = raw + rb
    } else {
        raw = raw + r[0:10]
    }
    mut out := ""
    mut acc := 0
    mut bits := 0
    mut i := 0
    while i < 16 {
        acc = (acc << 8) | (raw[i] & 255)
        bits = bits + 8
        while bits >= 5 {
            bits = bits - 5
            v := (acc >> bits) & 31
            out.push_byte(b32_enc(v))
        }
        i = i + 1
    }
    if bits > 0 {
        v := (acc << (5 - bits)) & 31
        out.push_byte(b32_enc(v))
    }
    << out
}

// new_ulid returns a 26-char Crockford ULID for the current wall clock.
pub fn new_ulid() string {
    ms := time.now_time().unix_milli()
    rnd := rand.read(10) or (err) {
        >> err
    }
    << ulid_from(ms, rnd)
}

// Monotonic keeps the last ULID so same-ms ids stay ordered.
pub struct Monotonic {
    last_ms int
    last_rnd string
}

pub fn new_monotonic() Monotonic {
    << Monotonic{last_ms: -1, last_rnd: ""}
}

// next returns a ULID ≥ the previous one from this generator (process-local).
pub fn (m &mut Monotonic) next() string {
    ms := time.now_time().unix_milli()
    if ms > m.last_ms {
        rnd := rand.read(10) or (err) {
            >> err
        }
        m.last_ms = ms
        m.last_rnd = rnd + ""
        << ulid_from(ms, rnd)
    }
    inc := inc_bytes(m.last_rnd + "")
    m.last_rnd = inc + ""
    << ulid_from(m.last_ms, inc)
}

// ulid_time_ms extracts the 48-bit timestamp from a 26-char ULID.
// Returns -1 on bad input.
pub fn ulid_time_ms(s string) int {
    if s.len != 26 {
        << -1
    }
    mut acc := 0
    mut bits := 0
    mut ms := 0
    mut got := 0
    mut i := 0
    while i < 26 && got < 48 {
        v := b32_val(s[i] & 255)
        if v < 0 {
            << -1
        }
        acc = (acc << 5) | v
        bits = bits + 5
        while bits >= 8 && got < 48 {
            bits = bits - 8
            ms = (ms << 8) | ((acc >> bits) & 255)
            got = got + 8
        }
        i = i + 1
    }
    if got < 48 {
        << -1
    }
    << ms
}

fn hexval(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << -1
}

// new_uuid_v7 returns a canonical UUIDv7 (8-4-4-4-12 lowercase hex).
pub fn new_uuid_v7() string {
    ms := time.now_time().unix_milli()
    rnd := rand.read(10) or (err) {
        >> err
    }
    mut body := ""
    ts := be48(ms)
    for i in 0:6 {
        body.push_byte(ts[i] & 255)
    }
    mut rest := []int{}
    for i in 0:10 {
        rest.push(rnd[i] & 255)
    }
    // version 7 in the high nibble of byte 6
    rest[0] = (7 << 4) | (rest[0] & 15)
    // RFC variant 0b10 in the high bits of byte 8
    rest[2] = (2 << 6) | (rest[2] & 63)
    for i in 0:10 {
        body.push_byte(rest[i] & 255)
    }
    mut out := ""
    mut i := 0
    while i < 16 {
        if i == 4 || i == 6 || i == 8 || i == 10 {
            out.push_byte(45)
        }
        b := body[i] & 255
        out.push_byte(hex.hex_ch((b >> 4) & 15))
        out.push_byte(hex.hex_ch(b & 15))
        i = i + 1
    }
    << out
}

// uuid_v7_time_ms extracts unix ms from a UUIDv7 string. -1 if invalid.
pub fn uuid_v7_time_ms(s string) int {
    mut hexs := ""
    for i in 0:s.len {
        c := s[i] & 255
        if c != 45 {
            hexs.push_byte(c)
        }
    }
    if hexs.len != 32 {
        << -1
    }
    mut ms := 0
    mut i := 0
    while i < 12 {
        hi := hexval(hexs[i] & 255)
        lo := hexval(hexs[i + 1] & 255)
        if hi < 0 || lo < 0 {
            << -1
        }
        ms = (ms << 8) | ((hi << 4) | lo)
        i = i + 2
    }
    << ms
}
