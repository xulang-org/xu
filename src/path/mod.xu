@path


#errors
// Slash-separated path helpers, aligned with Go's `path` package
// (not `path/filepath`). All operations allocate owned strings; slices copy.

pub fn is_abs(p &string) bool {
    if p.len == 0 {
        << false
    }
    << p[0] == 47
}

pub fn base(p &string) string {
    src := p + ""
    if src.len == 0 {
        << "."
    }
    $end := src.len
    while end > 0 {
        if src[end - 1] != 47 {
            <-
        }
        end = end - 1
    }
    if end == 0 {
        << "/"
    }
    $start := 0
    for i in 0:end {
        if src[i] == 47 {
            start = i + 1
        }
    }
    << src[start:end]
}

pub fn dir(p &string) string {
    src := p + ""
    if src.len == 0 {
        << "."
    }
    $end := src.len
    while end > 0 {
        if src[end - 1] != 47 {
            <-
        }
        end = end - 1
    }
    if end == 0 {
        << "/"
    }
    $slash := -1
    for i in 0:end {
        if src[i] == 47 {
            slash = i
        }
    }
    if slash < 0 {
        << "."
    }
    if slash == 0 {
        << "/"
    }
    << src[0:slash]
}

pub fn ext(p &string) string {
    b := base(p)
    $dot := -1
    for i in 0:b.len {
        if b[i] == 46 {
            if i > 0 {
                dot = i
            }
        }
    }
    if dot < 0 {
        << ""
    }
    << b[dot:b.len]
}

pub fn split_list(s &string) []string {
    src := s + ""
    $out := []string{}
    if src.len == 0 {
        << out
    }
    $start := 0
    $i := 0
    while i <= src.len {
        if i == src.len || (src[i] & 255) == 58 {
            out.push(src[start:i] + "")
            start = i + 1
        }
        i = i + 1
    }
    << out
}

pub fn join(parts []string) string {
    $out := ""
    $n := 0
    for i in 0:parts.len {
        if parts[i].len > 0 {
            if n > 0 {
                out.push_str("/")
            }
            out.push_str(parts[i])
            n = n + 1
        }
    }
    << clean(&out)
}

// split returns [dir, file] like Go path.Split (dir keeps trailing /).
pub fn split(p &string) []string {
    src := p + ""
    $slash := -1
    for i in 0:src.len {
        if src[i] == 47 {
            slash = i
        }
    }
    if slash < 0 {
        << ["", src]
    }
    << [src[0:slash + 1], src[slash + 1:src.len]]
}


fn int_drop_last(xs []int) []int {
    $np := []int{}
    n := xs.len - 1
    for k in 0:n {
        np.push(xs[k])
    }
    << np
}

// clean folds ., .., and repeated separators (Go path.Clean).
// Uses an int offset stack + string buffer (not []string[len-1] rebuild):
// Gen1 SEGV'd on `parts[parts.len-1]` inside the ".." branch even when
// that branch was not taken (frame/index poison).
pub fn clean(p &string) string {
    src := p + ""
    if src.len == 0 {
        << "."
    }
    rooted := src[0] == 47
    $out := ""
    if rooted {
        out.push_str("/")
    }
    $starts := []int{}
    $i := 0
    if rooted {
        i = 1
    }
    while i < src.len {
        while i < src.len {
            if src[i] != 47 {
                <-
            }
            i = i + 1
        }
        if i >= src.len {
            <-
        }
        $j := i
        while j < src.len {
            if src[j] == 47 {
                <-
            }
            j = j + 1
        }
        $is_dot := false
        $is_dotdot := false
        if j == i + 1 {
            if src[i] == 46 {
                is_dot = true
            }
        }
        if j == i + 2 {
            if src[i] == 46 {
                if src[i + 1] == 46 {
                    is_dotdot = true
                }
            }
        }
        if is_dot {
        } else if is_dotdot {
            if starts.len > 0 {
                idx := starts.len - 1
                st := starts[idx]
                starts = int_drop_last(starts)
                out = out[0:st]
            } else if !rooted {
                if out.len > 0 {
                    out.push_str("/")
                }
                starts.push(out.len)
                out.push_str("..")
            }
        } else {
            starts.push(out.len)
            if rooted {
                if out.len > 1 {
                    out.push_str("/")
                }
            } else {
                if out.len > 0 {
                    out.push_str("/")
                }
            }
            seg := src[i:j]
            out.push_str(seg)
        }
        i = j
    }
    if out.len == 0 {
        << "."
    }
    << out
}
// match reports whether name matches pattern (Go path.Match (Xu: matches)).
pub fn matches(pattern &string, name &string) bool {
    << match_work(pattern + "", name + "")
}

// Explicit-stack matcher (avoids W1 recursive-cycle warning on `*`).
fn match_work(pat string, name string) bool {
    $si := []int{}
    $sj := []int{}
    si.push(0)
    sj.push(0)
    while si.len > 0 {
        $nsi := []int{}
        $nsj := []int{}
        $k := 0
        while k < si.len - 1 {
            nsi.push(si[k])
            nsj.push(sj[k])
            k = k + 1
        }
        $i := si[si.len - 1]
        $j := sj[sj.len - 1]
        si = nsi
        sj = nsj
        $fail := false
        while i < pat.len {
            $c := pat[i] & 255
            if c == 42 {
                i = i + 1
                if i >= pat.len {
                    $jj := j
                    $bad := false
                    while jj < name.len {
                        if (name[jj] & 255) == 47 {
                            bad = true
                        }
                        jj = jj + 1
                    }
                    if !bad {
                        << true
                    }
                    fail = true
                    <-
                }
                $jj := j
                while jj <= name.len {
                    si.push(i)
                    sj.push(jj)
                    if jj >= name.len {
                        <-
                    }
                    if (name[jj] & 255) == 47 {
                        <-
                    }
                    jj = jj + 1
                }
                fail = true
                <-
            }
            if fail {
                <-
            }
            if j >= name.len {
                fail = true
                <-
            }
            if c == 63 {
                if (name[j] & 255) == 47 {
                    fail = true
                    <-
                }
                i = i + 1
                j = j + 1
                ->
            }
            if c == 91 {
                if (name[j] & 255) == 47 {
                    fail = true
                    <-
                }
                ch := name[j] & 255
                i = i + 1
                if i >= pat.len {
                    >> errors.new("path: bad pattern")
                }
                $negated := false
                if (pat[i] & 255) == 94 {
                    negated = true
                    i = i + 1
                }
                $matched := false
                $nclass := 0
                while i < pat.len {
                    $pc := pat[i] & 255
                    if pc == 93 && nclass > 0 {
                        <-
                    }
                    if pc == 92 {
                        i = i + 1
                        if i >= pat.len {
                            >> errors.new("path: bad pattern")
                        }
                        pc = pat[i] & 255
                    }
                    lo := pc
                    $hi := pc
                    if i + 2 < pat.len && (pat[i + 1] & 255) == 45 && (pat[i + 2] & 255) != 93 {
                        hi = pat[i + 2] & 255
                        i = i + 2
                    }
                    if lo <= ch && ch <= hi {
                        matched = true
                    }
                    i = i + 1
                    nclass = nclass + 1
                }
                if i >= pat.len || (pat[i] & 255) != 93 {
                    >> errors.new("path: bad pattern")
                }
                i = i + 1
                if negated {
                    matched = !matched
                }
                if !matched {
                    fail = true
                    <-
                }
                j = j + 1
                ->
            }
            if c == 92 {
                i = i + 1
                if i >= pat.len {
                    >> errors.new("path: bad pattern")
                }
                c = pat[i] & 255
            }
            if (name[j] & 255) != c {
                fail = true
                <-
            }
            i = i + 1
            j = j + 1
        }
        if !fail {
            if j == name.len {
                << true
            }
        }
    }
    << false
}

pub fn has_prefix(p &string, prefix string) bool {
    src := p + ""
    pre := prefix + ""
    if pre.len > src.len {
        << false
    }
    for i in 0:pre.len {
        if src[i] != pre[i] {
            << false
        }
    }
    << true
}

pub fn has_suffix(p &string, suffix string) bool {
    src := p + ""
    suf := suffix + ""
    if suf.len > src.len {
        << false
    }
    off := src.len - suf.len
    for j in 0:suf.len {
        if src[off + j] != suf[j] {
            << false
        }
    }
    << true
}
