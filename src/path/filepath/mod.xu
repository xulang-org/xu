@path/filepath


#errors
#os
#path

// OS path helpers aligned with Go `path/filepath`.
// Both '/' and '\\' are accepted as separators on input. Public path
// results use the native separator (\\ on Windows, / elsewhere), while the
// implementation normalises to '/' for deterministic segment processing.
// Walk (M104) takes a named fn callback. Glob is iterative.

// Canonical separator for internal parsing; native output is selected separately.
const CANONICAL_SLASH_BYTE = 47
// Windows path separator, accepted alongside the canonical slash.
const BACKSLASH_BYTE = 92

pub fn to_slash(p &string) string {
    src := p + ""
    mut need_change := false
    mut i := 0
    while i < src.len {
        if src[i] == BACKSLASH_BYTE {
            need_change = true
            <-
        }
        i = i + 1
    }
    if !need_change {
        << src
    }
    mut out := []int{}
    i = 0
    while i < src.len {
        c := src[i]
        if c == BACKSLASH_BYTE {
            out.push(CANONICAL_SLASH_BYTE)
        } else {
            out.push(c)
        }
        i = i + 1
    }
    << string_from_bytes(out)
}

pub fn from_slash(p &string) string {
    src := p + ""
    if xu_target_os() != 2 {
        << src
    }
    mut needs_replace := false
    mut i := 0
    while i < src.len {
        if src[i] == CANONICAL_SLASH_BYTE {
            needs_replace = true
            <-
        }
        i = i + 1
    }
    if !needs_replace {
        << src
    }
    mut out := []int{}
    i = 0
    while i < src.len {
        c := src[i]
        if c == CANONICAL_SLASH_BYTE {
            out.push(BACKSLASH_BYTE)
        } else {
            out.push(c)
        }
        i = i + 1
    }
    << string_from_bytes(out)
}

// Convert an internally normalised path to the target platform representation.
fn path_output(p string) string {
    << from_slash(&p)
}

pub fn is_abs(p &string) bool {
    src := p + ""
    if src.len == 0 {
        << false
    }
    if xu_target_os() == 2 {
        c0 := src[0] & 255
        if c0 == CANONICAL_SLASH_BYTE || c0 == BACKSLASH_BYTE {
            // A single leading slash is rooted on the current drive, but is
            // not absolute until a volume is known. A double slash is UNC.
            if src.len < 2 {
                << false
            }
            c1 := src[1] & 255
            << c1 == CANONICAL_SLASH_BYTE || c1 == BACKSLASH_BYTE
        }
        if src.len >= 3 {
            letter := (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
            if letter && src[1] == 58 {
                sep := src[2] & 255
                << sep == CANONICAL_SLASH_BYTE || sep == BACKSLASH_BYTE
            }
        }
        << false
    }
    << src[0] == CANONICAL_SLASH_BYTE
}

pub fn base(p &string) string {
    src := to_slash(p)
    if src.len == 0 {
        << "."
    }
    mut end := src.len
    while end > 0 {
        if src[end - 1] != CANONICAL_SLASH_BYTE {
            <-
        }
        end = end - 1
    }
    if xu_target_os() == 2 && end == 2 && src.len >= 3 && src[1] == 58 {
        << path_output("/")
    }
    if end == 0 {
        << path_output("/")
    }
    mut start := 0
    for i in 0:end {
        if src[i] == CANONICAL_SLASH_BYTE {
            start = i + 1
        }
    }
    out := src[start:end]
    << path_output(out)
}

pub fn dir(p &string) string {
    src := to_slash(p)
    if src.len == 0 {
        << "."
    }
    mut end := src.len
    while end > 0 {
        if src[end - 1] != CANONICAL_SLASH_BYTE {
            <-
        }
        end = end - 1
    }
    if xu_target_os() == 2 && end == 2 && src.len >= 3 && src[1] == 58 {
        root := src[0:2] + "/"
        << path_output(root)
    }
    if end == 0 {
        << path_output("/")
    }
    mut slash := -1
    for i in 0:end {
        if src[i] == CANONICAL_SLASH_BYTE {
            slash = i
        }
    }
    if slash < 0 {
        << "."
    }
    if slash == 0 {
        << path_output("/")
    }
    out := src[0:slash]
    << path_output(out)
}

pub fn ext(p &string) string {
    b := base(p)
    mut dot := -1
    for i in 0:b.len {
        if b[i] == 46 {
            if i > 0 {
                dot = i
            }
        }
    }
    if dot < 0 {
        << ""
    }
    << b[dot:b.len]
}

pub fn split(p &string) []string {
    src := to_slash(p)
    mut slash := -1
    for i in 0:src.len {
        if src[i] == CANONICAL_SLASH_BYTE {
            slash = i
        }
    }
    if slash < 0 {
        << ["", src]
    }
    d := path_output(src[0:slash + 1])
    << [d, src[slash + 1:src.len]]
}


// clean folds ., .., and repeated separators (Go filepath.Clean).
// Uses an int offset stack + string buffer (not []string[len-1] rebuild):
// Gen1 SEGV'd on `parts[parts.len-1]` inside the ".." branch even when
// that branch was not taken (frame/index poison).
pub fn clean(p &string) string {
    src := to_slash(p)
    if src.len == 0 {
        << path_output(".")
    }
    mut no_clean := 1
    mut prev_sep := 0
    mut k := 0
    while k < src.len {
        c := src[k]
        if c == CANONICAL_SLASH_BYTE {
            if prev_sep == 1 || k + 1 == src.len {
                no_clean = 0
                <-
            }
            prev_sep = 1
        } else {
            if c == 46 {
                if k == 0 || prev_sep == 1 {
                    if k + 1 == src.len {
                        no_clean = 0
                    } else if src[k + 1] == CANONICAL_SLASH_BYTE {
                        no_clean = 0
                    } else if src[k + 1] == 46 && (k + 2 == src.len || src[k + 2] == CANONICAL_SLASH_BYTE) {
                        no_clean = 0
                    }
                    if no_clean == 0 {
                        <-
                    }
                }
            }
            prev_sep = 0
        }
        k = k + 1
    }
    if no_clean == 1 {
        << path_output(src)
    }
    mut drive_abs := false
    mut unc_root := false
    if xu_target_os() == 2 && src.len >= 3 {
        c0 := src[0] & 255
        letter := (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)
        if letter && src[1] == 58 && src[2] == CANONICAL_SLASH_BYTE {
            drive_abs = true
        }
    }
    if xu_target_os() == 2 && src.len >= 2 && src[0] == CANONICAL_SLASH_BYTE && src[1] == CANONICAL_SLASH_BYTE {
        unc_root = true
    }
    rooted := src[0] == CANONICAL_SLASH_BYTE || drive_abs
    mut out := ""
    if drive_abs {
        out.push_str(src[0:2])
    } else if rooted {
        out.push_str("/")
    }
    mut starts := []int{}
    // The server/share pair is the UNC volume root. A `..` component may
    // not remove either part (Clean(`\\server\share\..`) remains at the
    // share root), so protect those stack entries from backtracking.
    mut volume_parts := 0
    if unc_root {
        volume_parts = 2
    }
    // Leading `..` elements in a relative path are another backtracking
    // boundary: Clean("../../a") must not cancel the two parent traversals.
    mut protected_parts := volume_parts
    mut i := 0
    if drive_abs {
        i = 3
    } else if unc_root {
        i = 2
    } else if rooted {
        i = 1
    }
    while i < src.len {
        while i < src.len {
            if src[i] != CANONICAL_SLASH_BYTE {
                <-
            }
            i = i + 1
        }
        if i >= src.len {
            <-
        }
        mut j := i
        while j < src.len {
            if src[j] == CANONICAL_SLASH_BYTE {
                <-
            }
            j = j + 1
        }
        mut is_dot := false
        mut is_dotdot := false
        if j == i + 1 {
            if src[i] == 46 {
                is_dot = true
            }
        }
        if j == i + 2 {
            if src[i] == 46 {
                if src[i + 1] == 46 {
                    is_dotdot = true
                }
            }
        }
        if is_dot {
        } else if is_dotdot {
            if starts.len > protected_parts {
                idx := starts.len - 1
                st := starts[idx]
                starts = starts[0:idx]
                out = out[0:st]
            } else if !rooted {
                if out.len > 0 {
                    out.push_str("/")
                }
                starts.push(out.len)
                out.push_str("..")
                protected_parts = protected_parts + 1
            }
        } else {
            starts.push(out.len)
            if rooted {
                if out.len > 1 {
                    out.push_str("/")
                }
            } else {
                if out.len > 0 {
                    out.push_str("/")
                }
            }
            seg := src[i:j]
            out.push_str(seg)
        }
        i = j
    }
    if unc_root && out.len > 0 {
        out = "/" + out
    }
    if drive_abs && out.len == 2 {
        out.push_str("/")
    }
    if out.len == 0 {
        << path_output(".")
    }
    << path_output(out)
}
pub fn list_separator() int {
    << os.path_list_separator()
}

pub fn split_list(s &string) []string {
    src := s + ""
    sep := list_separator()
    mut out := []string{}
    if src.len == 0 {
        << out
    }
    mut start := 0
    mut i := 0
    while i <= src.len {
        if i == src.len || (src[i] & 255) == sep {
            out.push(src[start:i] + "")
            start = i + 1
        }
        i = i + 1
    }
    << out
}

pub fn join(parts []string) string {
    // Build with owned string push (path.join style). io.buffer.write(&parts[i])
    // does not append array-element borrows correctly (fixture path_filepath).
    mut out := ""
    mut n := 0
    for i in 0:parts.len {
        if parts[i].len > 0 {
            if n > 0 {
                out.push_str("/")
            }
            out.push_str(parts[i])
            n = n + 1
        }
    }
    << clean(&out)
}

// rel returns a relative path from base_path to target.
// Both are cleaned; if target cannot be made relative, returns Err.
pub fn rel(base_path &string, target &string) string {
    b := clean(base_path)
    t := clean(target)
    if is_abs(&b) != is_abs(&t) {
        >> errors.new("Rel: can't make " + t + " relative to " + b)
    }
    if xu_target_os() == 2 {
        bv := volume_name(&b)
        tv := volume_name(&t)
        if !same_path_word(&bv, &tv) {
            >> errors.new("Rel: can't make " + t + " relative to " + b)
        }
    }
    bs := segs(&b)
    ts := segs(&t)
    // Common-prefix length without `<-` (keep the join stable across calls).
    mut i := 0
    mut stop := false
    while !stop {
        if i >= bs.len || i >= ts.len {
            stop = true
        } else {
            // Copy words first: `&bs[i]` array-element borrows are unreliable
            // after the first rel() (same class as io.Buffer.write).
            mut aw := bs[i] + ""
            mut bw := ts[i] + ""
            if same_path_word(&aw, &bw) {
                i = i + 1
            } else {
                stop = true
            }
        }
    }
    mut out := ""
    mut j := i
    while j < bs.len {
        if bs[j] == ".." {
            >> errors.new("Rel: can't make " + t + " relative to " + b)
        }
        if out.len > 0 {
            out.push_str("/")
        }
        out.push_str("..")
        j = j + 1
    }
    j = i
    while j < ts.len {
        if out.len > 0 {
            out.push_str("/")
        }
        out.push_str(ts[j])
        j = j + 1
    }
    if out.len == 0 {
        << path_output(".")
    }
    << path_output(out)
}

// Windows path volumes and components are compared case-insensitively.
// Keep this ASCII-only: drive letters, UNC hosts, and the portable path
// subset supported by Xu do not require locale-dependent folding.
fn same_path_word(a &string, b &string) bool {
    if a.len != b.len {
        << false
    }
    win := xu_target_os() == 2
    for i in 0:a.len {
        mut ca := a[i] & 255
        mut cb := b[i] & 255
        if win {
            if ca >= 65 && ca <= 90 {
                ca = ca + 32
            }
            if cb >= 65 && cb <= 90 {
                cb = cb + 32
            }
        }
        if ca != cb {
            << false
        }
    }
    << true
}

fn clone_path_str(s &string) string {
    mut z := ""
    z.push_str(*s)
    << z
}

fn segs(p &string) []string {
    src := to_slash(p)
    mut parts := []string{}
    if src.len == 0 || src == "." {
        << parts
    }
    mut i := 0
    if src[0] == CANONICAL_SLASH_BYTE {
        i = 1
    }
    while i < src.len {
        while i < src.len {
            if src[i] != CANONICAL_SLASH_BYTE {
                <-
            }
            i = i + 1
        }
        if i >= src.len {
            <-
        }
        mut j := i
        while j < src.len {
            if src[j] == CANONICAL_SLASH_BYTE {
                <-
            }
            j = j + 1
        }
        seg := src[i:j]
        parts.push(clone_path_str(&seg))
        i = j
    }
    << parts
}

pub fn is_local(p &string) bool {
    src := p + ""
    if src.len == 0 {
        << false
    }
    mut i := 0
    while i < src.len {
        if src[i] == 0 {
            << false
        }
        i = i + 1
    }
    if is_abs(&src) {
        << false
    }
    if xu_target_os() == 2 {
        v := volume_name(&src)
        if v.len > 0 {
            << false
        }
    }
    c := clean(&src)
    if c == ".." {
        << false
    }
    if c.len >= 3 {
        if c[0] == 46 && c[1] == 46 {
            sep := c[2] & 255
            if sep == CANONICAL_SLASH_BYTE || sep == BACKSLASH_BYTE {
                << false
            }
        }
    }
    << true
}

pub fn volume_name(p &string) string {
    src := to_slash(p)
    if src.len >= 2 && ((src[0] >= 65 && src[0] <= 90) || (src[0] >= 97 && src[0] <= 122)) && src[1] == 58 {
        << src[0:2]
    }
    if xu_target_os() == 2 && src.len >= 2 && src[0] == CANONICAL_SLASH_BYTE && src[1] == CANONICAL_SLASH_BYTE {
        mut i := 2
        while i < src.len && src[i] != CANONICAL_SLASH_BYTE {
            i = i + 1
        }
        if i < src.len {
            i = i + 1
            while i < src.len {
                if src[i] == CANONICAL_SLASH_BYTE {
                    <-
                }
                i = i + 1
            }
            if i > 0 {
                vol := src[0:i]
                << path_output(vol)
            }
        }
        << path_output(src)
    }
    << ""
}

pub fn matches(pattern &string, name &string) bool {
    p := to_slash(pattern)
    n := to_slash(name)
    << path.matches(&p, &n) or (err) { << false }
}

pub fn abs(p &string) string {
    src := p + ""
    if is_abs(&src) {
        << clean(&src)
    }
    wd := os.getwd()
    if xu_target_os() == 2 && src.len > 0 {
        c0 := src[0] & 255
        if c0 == CANONICAL_SLASH_BYTE || c0 == BACKSLASH_BYTE {
            // Rooted path (`\foo`): resolve it against the current drive,
            // rather than appending it below the current directory.
            vol := volume_name(&wd)
            if vol.len > 0 {
                rooted := vol + src
                << clean(&rooted)
            }
        }
    }
    joined := join([wd, src])
    << joined
}

fn has_meta(s &string) bool {
    for i in 0:s.len {
        c := s[i] & 255
        if c == 42 || c == 63 || c == 91 {
            << true
        }
    }
    << false
}

fn glob_matches(basep &string, nm &string) bool {
    p := to_slash(basep)
    n := to_slash(nm)
    << path.matches(&p, &n) or >>
}

pub fn glob(pattern &string) []string {
    pat := to_slash(pattern)
    dirp := dir(&pat)
    basep := base(&pat)
    if has_meta(&dirp) && dirp != pat {
        dirs := glob(&dirp) or >>
        mut out := []string{}
        for i in 0:dirs.len {
            sub := join([dirs[i] + "", basep + ""])
            got := glob(&sub) or >>
            for j in 0:got.len {
                out.push(got[j] + "")
            }
        }
        << out
    }
    listing := os.listdir(dirp + "") or (err) {
        if os.is_not_exist(err.msg()) {
            << []string{}
        }
        >> err
    }
    raw := listing + ""
    mut names := []string{}
    mut start := 0
    mut i := 0
    while i <= raw.len {
        if i == raw.len || (raw[i] & 255) == 10 {
            if i > start {
                names.push(raw[start:i] + "")
            }
            start = i + 1
        }
        i = i + 1
    }
    mut out := []string{}
    for k in 0:names.len {
        nm := names[k] + ""
        if glob_matches(&basep, &nm) {
            if dirp == "." {
                out.push(nm + "")
            } else {
                out.push(join([dirp + "", nm + ""]))
            }
        }
    }
    << out
}

// Walk the file tree rooted at `root`. Callback `fn(path, is_dir) int`:
// 0 = ->, 1 = skip directory children, other = stop walking.
// Iterative (no recursion); uses os.entries.
fn walk_push_children(stack &mut []string, cur string) {
    ents := os.entries(cur + "") or (err) {
        <<
    }
    mut i := ents.len
    while i > 0 {
        i = i - 1
        nm := ents[i].name + ""
        mut child := to_slash(&cur) + "/" + nm
        if cur == "." {
            child = nm + ""
        }
        stack.push(path_output(child))
    }
}

pub fn walk(root string, visit fn(string, bool) int) {
    mut stack := []string{}
    stack.push(root + "")
    mut done := 0
    while done == 0 && stack.len > 0 {
        top := stack.len - 1
        cur := stack[top]
        mut nstack := []string{}
        for i in 0:top {
            nstack.push(stack[i] + "")
        }
        stack = nstack
        d := os.is_dir(cur + "")
        code := visit(cur + "", d)
        if code != 0 && code != 1 {
            done = 1
        } else {
            if d && code == 0 {
                walk_push_children(mut &stack, cur + "")
            }
        }
    }
}
