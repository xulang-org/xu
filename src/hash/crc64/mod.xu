@hash/crc64

// CRC-64 aligned with Go `hash/crc64` (iso / ecma).
// Pure i64 arithmetic carrying u64 lanes: arithmetic right shift is
// masked to logical (`>> 1` with 2^63-1, `>> 8` with 2^56-1). No
// mutable globals — each make_table owns a 256-entry table.
// Polynomials that set bit 63 are stored as two's-complement negatives
// (hex 0x8… literals have historically been lexer-hostile).

pub const ISO = -2882303761517117440   // 0xD800000000000000
pub const ECMA = -3932672073523589310  // 0xC96C5795D7870F42

const M63 = 9223372036854775807 // (1<<63)-1 after >>1
const M56 = 72057594037927935   // (1<<56)-1 after >>8

pub struct Table {
    pub entries []int
}

pub fn make_table(poly int) Table {
    $entries := []int{}
    for i in 0:256 {
        $crc := i
        for bit in 0:8 {
            if (crc & 1) != 0 {
                crc = ((crc >> 1) & M63) ^ poly
            } else {
                crc = (crc >> 1) & M63
            }
        }
        entries.push(crc)
    }
    << Table{entries: entries}
}

pub fn update(crc int, tab &Table, data &string) int {
    $c := crc ^ -1
    for i in 0:data.len {
        idx := (c ^ data[i]) & 255
        c = tab.entries[idx] ^ ((c >> 8) & M56)
    }
    << c ^ -1
}

pub fn checksum(data &string, tab &Table) int {
    << update(0, tab, data)
}

