pub struct Digest {
    pub tab Table
    pub crc int
}

pub fn new_iso() Digest {
    << Digest{tab: Table{entries: iso_tab()}, crc: 0}
}

pub fn new_ecma() Digest {
    << Digest{tab: Table{entries: ecma_tab()}, crc: 0}
}

pub fn (d $&Digest) write(p &string) int {
    d.crc = update(d.crc, &d.tab, p)
    << p.len
}

pub fn (d &Digest) sum() int {
    << d.crc
}

pub fn (d &Digest) size() int {
    << 8
}

pub fn (d $&Digest) reset() {
    d.crc = 0
}

pub fn checksum_iso(data &string) int {
    tab := iso_tab()
    $c := 0 ^ -1
    for i in 0:data.len {
        idx := (c ^ data[i]) & 255
        c = tab[idx] ^ ((c >> 8) & M56)
    }
    << c ^ -1
}

pub fn checksum_ecma(data &string) int {
    tab := ecma_tab()
    $c := 0 ^ -1
    for i in 0:data.len {
        idx := (c ^ data[i]) & 255
        c = tab[idx] ^ ((c >> 8) & M56)
    }
    << c ^ -1
}
