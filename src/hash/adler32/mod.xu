@hash/adler32

// Adler-32 (RFC1950) aligned with Go `hash/adler32`.
// Pure i64 arithmetic with masks — no mutable globals.

const mod = 65521
const u32_max = 4294967295

pub fn update(d int, data &string) int {
    mut s1 := d & 65535
    mut s2 := (d >> 16) & 65535
    mut i := 0
    n := data.len
    while i < n {
        mut chunk := n - i
        if chunk > 5552 {
            chunk = 5552
        }
        mut j := 0
        while j < chunk {
            s1 = s1 + (data[i] & 255)
            s2 = s2 + s1
            i += 1
            j += 1
        }
        s1 = s1 % mod
        s2 = s2 % mod
    }
    << ((s2 << 16) | s1) & u32_max
}

pub fn checksum(data &string) int {
    << update(1, data)
}

pub struct Digest {
    pub s int
}

pub fn new() Digest {
    << Digest{s: 1}
}

pub fn (d &mut Digest) write(p &string) int {
    d.s = update(d.s, p)
    << p.len
}

pub fn (d &Digest) sum() int {
    << d.s
}

pub fn (d &Digest) size() int {
    << 4
}

pub fn (d &mut Digest) reset() {
    d.s = 1
}
