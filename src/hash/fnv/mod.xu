@hash/fnv

// FNV-1 and FNV-1a aligned with Go `hash/fnv` (New32 / New32a / New64 /
// New64a). The 64-bit offset exceeds i64, so it is written as the
// two's-complement negative; multiplication wraps (defined Xu i64
// semantics) — exactly Go's uint64 bit pattern.

const offset32 = 2166136261
const prime32 = 16777619
const offset64 = -3750763034362895579 // 0xcbf29ce484222325
const prime64 = 1099511628211
const u32_max = 4294967295

fn step32(h int, b int, one_a bool) int {
    mut x := h
    if one_a {
        x = x ^ b
        x = x * prime32
    } else {
        x = x * prime32
        x = x ^ b
    }
    << x & u32_max
}

fn step64(h int, b int, one_a bool) int {
    mut x := h
    if one_a {
        x = x ^ b
        x = x * prime64
    } else {
        x = x * prime64
        x = x ^ b
    }
    << x
}

pub fn fnv32(s &string) int {
    mut h := offset32
    for i in 0:s.len {
        h = step32(h, s[i], false)
    }
    << h
}

pub fn fnv32a(s &string) int {
    mut h := offset32
    for i in 0:s.len {
        h = step32(h, s[i], true)
    }
    << h
}

pub fn fnv64(s &string) int {
    mut h := offset64
    for i in 0:s.len {
        h = step64(h, s[i], false)
    }
    << h
}

pub fn fnv64a(s &string) int {
    mut h := offset64
    for i in 0:s.len {
        h = step64(h, s[i], true)
    }
    << h
}

pub struct Digest {
    pub h int
    bits int
    one_a bool
}

pub fn new32() Digest {
    << Digest{h: offset32, bits: 32, one_a: false}
}

pub fn new32a() Digest {
    << Digest{h: offset32, bits: 32, one_a: true}
}

pub fn new64() Digest {
    << Digest{h: offset64, bits: 64, one_a: false}
}

pub fn new64a() Digest {
    << Digest{h: offset64, bits: 64, one_a: true}
}

pub fn (d &mut Digest) write(p &string) int {
    src := p + ""
    mut i := 0
    while i < src.len {
        b := src[i]
        if d.bits == 32 {
            d.h = step32(d.h, b, d.one_a)
        } else {
            d.h = step64(d.h, b, d.one_a)
        }
        i = i + 1
    }
    << src.len
}

pub fn (d &Digest) sum() int {
    << d.h
}

pub fn (d &Digest) size() int {
    if d.bits == 32 {
        << 4
    }
    << 8
}

pub fn (d &mut Digest) reset() {
    if d.bits == 32 {
        d.h = offset32
    } else {
        d.h = offset64
    }
}
