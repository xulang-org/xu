@hash/crc32

// CRC-32 aligned with Go `hash/crc32` (ieee / castagnoli / koopman).
// Pure i64 arithmetic with 32-bit masks — no mutable globals (each make_table)
// returns an owning 256-entry table). checksum_ieee uses a precomputed
// ieee table so small checksums do not rebuild 256 entries from the poly.

pub const IEEE = 3988292384          // 0xEDB88320
pub const CASTAGNOLI = 2197175160    // 0x82F63B78
pub const KOOPMAN = 3945912366       // 0xEB31D82E

const U32_MAX = 4294967295

pub struct Table {
    pub entries []int
}

pub fn make_table(poly int) Table {
    p := poly & U32_MAX
    mut entries := []int{}
    for i in 0:256 {
        mut crc := i
        for bit in 0:8 {
            if (crc & 1) != 0 {
                crc = ((crc >> 1) & U32_MAX) ^ p
            } else {
                crc = (crc >> 1) & U32_MAX
            }
            crc = crc & U32_MAX
        }
        entries.push(crc & U32_MAX)
    }
    << Table{entries: entries}
}

pub fn update(tab &Table, crc int, data &string) int {
    mut c := (crc ^ U32_MAX) & U32_MAX
    for i in 0:data.len {
        idx := (c ^ (data[i] & 255)) & 255
        c = (tab.entries[idx] ^ ((c >> 8) & U32_MAX)) & U32_MAX
    }
    << (c ^ U32_MAX) & U32_MAX
}

