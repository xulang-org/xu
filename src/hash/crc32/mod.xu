pub fn checksum(data &string, tab &Table) int {
    << update(tab, 0, data)
}

fn crc32_hw_ieee_supported() int {
    << 0
}

fn crc32_hw_cas_supported() int {
    << 0
}

fn crc32_hw_ieee(crc int, data &string) int {
    << 0
}

fn crc32_hw_castagnoli(crc int, data &string) int {
    << 0
}

pub struct Digest {
    pub tab Table
    pub crc int
    pub is_ieee bool
}

pub fn new_ieee() Digest {
    << Digest{tab: Table{entries: ieee_tab()}, crc: 0, is_ieee: true}
}

pub fn (d &mut Digest) write(p &string) int {
    if d.is_ieee && crc32_hw_ieee_supported() == 1 {
        d.crc = crc32_hw_ieee(d.crc, p)
        << p.len
    }
    d.crc = update(&d.tab, d.crc, p)
    << p.len
}

pub fn (d &Digest) sum() int {
    << d.crc
}

pub fn (d &Digest) size() int {
    << 4
}

pub fn (d &mut Digest) reset() {
    d.crc = 0
}

pub fn checksum_ieee(data &string) int {
    if crc32_hw_ieee_supported() == 1 {
        << crc32_hw_ieee(0, data)
    }
    tab := ieee_tab()
    mut c := U32_MAX
    for i in 0:data.len {
        idx := (c ^ (data[i] & 255)) & 255
        c = (tab[idx] ^ ((c >> 8) & U32_MAX)) & U32_MAX
    }
    << (c ^ U32_MAX) & U32_MAX
}

pub fn checksum_castagnoli(data &string) int {
    if crc32_hw_cas_supported() == 1 {
        << crc32_hw_castagnoli(0, data)
    }
    tab := make_table(CASTAGNOLI)
    << checksum(data, &tab)
}

pub fn checksum_koopman(data &string) int {
    tab := make_table(KOOPMAN)
    << checksum(data, &tab)
}
