@hash/maphash

// Seeded 64-bit hash aligned in *shape* with Go `hash/maphash`
// (Bytes / Hash.Write / Sum64). Not bit-identical: Go uses the
// runtime memhash (AES on amd64); Xu uses a portable splitmix-style
// mix so the same seed+bytes hash the same on every backend.
// Seed 0 is allowed (Go panics on uninitialized Seed).

const m34 = 17179869183
const m37 = 137438953471
const m33 = 8589934591
const golden = -7046029254386353131
const c1 = -4658895280553007687
const c2 = -7723592293110705685

fn mix64(z0 int) int {
    mut z := z0
    z = (z ^ ((z >> 30) & m34)) * c1
    z = (z ^ ((z >> 27) & m37)) * c2
    << z ^ ((z >> 31) & m33)
}

pub fn bytes(seed int, data &string) int {
    src := data + ""
    mut h := seed
    for i in 0:src.len {
        h = mix64(h ^ ((src[i] & 255) + golden))
    }
    << mix64(h + src.len * golden)
}

pub fn of_string(seed int, s &string) int {
    << bytes(seed, s)
}

pub struct Hash {
    pub seed int
    pub state int
    pub n int
}

pub fn new(seed int) Hash {
    << Hash{seed: seed, state: seed, n: 0}
}

pub fn (h &mut Hash) set_seed(seed int) {
    h.seed = seed
    h.state = seed
    h.n = 0
}

pub fn (h &mut Hash) reset() {
    h.state = h.seed
    h.n = 0
}

pub fn (h &mut Hash) write(p &string) int {
    src := p + ""
    for i in 0:src.len {
        h.state = mix64(h.state ^ ((src[i] & 255) + golden))
        h.n = h.n + 1
    }
    << src.len
}

pub fn (h Hash) sum64() int {
    << mix64(h.state + h.n * golden)
}

pub fn (h Hash) seed() int {
    << h.seed
}
