@unicode/utf16

#unicode/utf8
#errors

// UTF-16 aligned with Go `unicode/utf16` (IsSurrogate / DecodeRune /
// EncodeRune / Encode / Decode). Code units are i64 holding u16.
// encode walks a UTF-8 string (fail-loud on illegal UTF-8, unlike Go's
// []rune input). decode never fails: unpaired surrogates become U+FFFD.

const SURR1 = 0xD800
const SURR2 = 0xDC00
const SURR3 = 0xE000
const SELF = 0x10000
const MAX_RUNE = 0x10FFFF
const U16 = 65535

pub fn is_surrogate(r int) bool {
    if r >= SURR1 {
        if r < SURR3 {
            << true
        }
    }
    << false
}

pub fn decode_rune(r1 int, r2 int) int {
    if r1 >= SURR1 && r1 < SURR2 && r2 >= SURR2 && r2 < SURR3 {
        << ((r1 - SURR1) << 10) | (r2 - SURR2) + SELF
    }
    << utf8.RUNE_ERROR
}

pub struct Pair {
    pub r1 int
    pub r2 int
}

pub fn encode_rune(r int) Pair {
    if r < SELF || r > MAX_RUNE {
        << Pair{r1: utf8.RUNE_ERROR, r2: utf8.RUNE_ERROR}
    }
    x := r - SELF
    << Pair{r1: SURR1 + ((x >> 10) & 0x3FF), r2: SURR2 + (x & 0x3FF)}
}

fn utf8_decode_at(s &string, i int) int {
    if i < 0 {
        >> errors.new("utf16: bad index")
    }
    << utf8.decode(s, i)
}

fn utf8_decode_width_at(s &string, i int) int {
    if i < 0 {
        >> errors.new("utf16: bad index")
    }
    << utf8.decode_width(s, i)
}

pub fn encode(s &string) []int {
    if s.len < 0 {
        >> errors.new("utf16: bad input")
    }
    $out := []int{}
    $i := 0
    while i < s.len {
        r := utf8_decode_at(s, i)
        w := utf8_decode_width_at(s, i)
        if r >= SELF {
            p := encode_rune(r)
            out.push(p.r1)
            out.push(p.r2)
        } else {
            out.push(r)
        }
        i = i + w
    }
    << out
}

fn utf8_encode_rune(r int) string {
    if r < 0 {
        >> errors.new("utf16: bad rune")
    }
    << utf8.encode(r)
}

pub fn decode(u &[]int) string {
    if u.len < 0 {
        >> errors.new("utf16: bad input")
    }
    $out := ""
    $i := 0
    while i < u.len {
        x := u[i] & U16
        $r := x
        $step := 1
        if x >= SURR1 && x < SURR2 {
            if i + 1 < u.len {
                y := u[i + 1] & U16
                if y >= SURR2 && y < SURR3 {
                    r = decode_rune(x, y)
                    step = 2
                } else {
                    r = utf8.RUNE_ERROR
                }
            } else {
                r = utf8.RUNE_ERROR
            }
        } else if x >= SURR2 && x < SURR3 {
            r = utf8.RUNE_ERROR
        }
        chunk := utf8_encode_rune(r)
        out = out + chunk
        i = i + step
    }
    << out
}
