const CASE_UPPER_INDEX = "!\"#$%&          '  (        )*+, -  .       /0                                                                                                                        12   3                                                                                   4    56      7           8                                                                                     9                                                                                                                          :"

fn case_upper(r int) int {
    page := r >> 8
    if page < 0 || page >= 490 { << r }
    index := CASE_UPPER_INDEX
    block := index[page] - 32
    if block == 0 { << r }
    data := CASE_PAGE_DATA
    pos := (block - 1) * 768 + (r & 255) * 3
    d := ((data[pos] - 32) << 12) | ((data[pos + 1] - 32) << 6) | (data[pos + 2] - 32)
    << r + d - 131072
}
const CASE_LOWER_INDEX = ";<=>?@          A  B        C DE F  G       H                                                                                                                         IJ                                                                                       K    LM      N           O                                                                                     P                                                                                                                          Q"

fn case_lower(r int) int {
    page := r >> 8
    if page < 0 || page >= 490 { << r }
    index := CASE_LOWER_INDEX
    block := index[page] - 32
    if block == 0 { << r }
    data := CASE_PAGE_DATA
    pos := (block - 1) * 768 + (r & 255) * 3
    d := ((data[pos] - 32) << 12) | ((data[pos + 1] - 32) << 6) | (data[pos + 2] - 32)
    << r + d - 131072
}
const CASE_FOLD_INDEX = "RSTUVW          X  Y        Z*[\\ ]  ^       _0                                                                                                                        `a   3                                                                                   b    cd      e           f                                                                                     g                                                                                                                          h"

fn case_fold(r int) int {
    page := r >> 8
    if page < 0 || page >= 490 { << r }
    index := CASE_FOLD_INDEX
    block := index[page] - 32
    if block == 0 { << r }
    data := CASE_PAGE_DATA
    pos := (block - 1) * 768 + (r & 255) * 3
    d := ((data[pos] - 32) << 12) | ((data[pos + 1] - 32) << 6) | (data[pos + 2] - 32)
    << r + d - 131072
}
const CASE_TITLE_INDEX = "!i#$%&             (        )*+, -  .       /0                                                                                                                        12   3                                                                                   4    56      7           8                                                                                     9                                                                                                                          :"

fn case_title(r int) int {
    page := r >> 8
    if page < 0 || page >= 490 { << r }
    index := CASE_TITLE_INDEX
    block := index[page] - 32
    if block == 0 { << r }
    data := CASE_PAGE_DATA
    pos := (block - 1) * 768 + (r & 255) * 3
    d := ((data[pos] - 32) << 12) | ((data[pos + 1] - 32) << 6) | (data[pos + 2] - 32)
    << r + d - 131072
}
