@unicode/utf8


#errors
// Strict UTF-8, aligned with Go `unicode/utf8` but fail-loud: illegal
// sequences << Err instead of U+FFFD. Every byte read is bounds-checked
// before indexing. Results are owned ints / strings, never a shared view.

fn is_cont(b int) bool {
    << (b & 0xC0) == 0x80
}

pub fn rune_start(b int) bool {
    << (b & 0xC0) != 0x80
}

pub fn rune_len(r int) int {
    if r < 0 {
        >> errors.new("utf8: invalid rune")
    }
    if r < 0x80 {
        << 1
    }
    if r < 0x800 {
        << 2
    }
    if r >= 0xD800 {
        if r <= 0xDFFF {
            >> errors.new("utf8: surrogate")
        }
    }
    if r < 0x10000 {
        << 3
    }
    if r <= 0x10FFFF {
        << 4
    }
    >> errors.new("utf8: invalid rune")
}

pub fn decode(s &string, i int) int {
    if i < 0 {
        >> errors.new("utf8: index out of range")
    }
    if i >= s.len {
        >> errors.new("utf8: index out of range")
    }
    b0 := s[i]
    if b0 < 0x80 {
        << b0
    }
    if b0 < 0xC2 {
        >> errors.new("utf8: invalid sequence")
    }
    if b0 < 0xE0 {
        if i + 1 >= s.len {
            >> errors.new("utf8: truncated")
        }
        b1 := s[i + 1]
        if !is_cont(b1) {
            >> errors.new("utf8: invalid sequence")
        }
        r := ((b0 & 0x1F) << 6) | (b1 & 0x3F)
        if r < 0x80 {
            >> errors.new("utf8: overlong")
        }
        << r
    }
    if b0 < 0xF0 {
        if i + 2 >= s.len {
            >> errors.new("utf8: truncated")
        }
        b1 := s[i + 1]
        b2 := s[i + 2]
        if !is_cont(b1) {
            >> errors.new("utf8: invalid sequence")
        }
        if !is_cont(b2) {
            >> errors.new("utf8: invalid sequence")
        }
        r := ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F)
        if r < 0x800 {
            >> errors.new("utf8: overlong")
        }
        if r >= 0xD800 {
            if r <= 0xDFFF {
                >> errors.new("utf8: surrogate")
            }
        }
        << r
    }
    if b0 < 0xF5 {
        if i + 3 >= s.len {
            >> errors.new("utf8: truncated")
        }
        b1 := s[i + 1]
        b2 := s[i + 2]
        b3 := s[i + 3]
        if !is_cont(b1) {
            >> errors.new("utf8: invalid sequence")
        }
        if !is_cont(b2) {
            >> errors.new("utf8: invalid sequence")
        }
        if !is_cont(b3) {
            >> errors.new("utf8: invalid sequence")
        }
        r := ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F)
        if r < 0x10000 {
            >> errors.new("utf8: overlong")
        }
        if r > 0x10FFFF {
            >> errors.new("utf8: invalid rune")
        }
        << r
    }
    >> errors.new("utf8: invalid sequence")
}

pub fn decode_width(s &string, i int) int {
    r := decode(s, i)
    << rune_len(r)
}

pub fn valid(s &string) bool {
    mut i := 0
    while i < s.len {
        w := decode_width(s, i) or (err) { << false }
        if w <= 0 {
            << false
        }
        i = i + w
    }
    << true
}

pub fn rune_count(s &string) int {
    mut i := 0
    mut n := 0
    while i < s.len {
        w := decode_width(s, i) or (err) { << -1 }
        n = n + 1
        i = i + w
    }
    << n
}

pub fn encode(r int) string {
    n := rune_len(r)
    if n == 1 {
        << string_from_byte(r)
    }
    if n == 2 {
        b0 := 0xC0 | (r >> 6)
        b1 := 0x80 | (r & 0x3F)
        << string_from_byte(b0) + string_from_byte(b1)
    }
    if n == 3 {
        b0 := 0xE0 | (r >> 12)
        b1 := 0x80 | ((r >> 6) & 0x3F)
        b2 := 0x80 | (r & 0x3F)
        << string_from_byte(b0) + string_from_byte(b1) + string_from_byte(b2)
    }
    b0 := 0xF0 | (r >> 18)
    b1 := 0x80 | ((r >> 12) & 0x3F)
    b2 := 0x80 | ((r >> 6) & 0x3F)
    b3 := 0x80 | (r & 0x3F)
    << string_from_byte(b0) + string_from_byte(b1) + string_from_byte(b2) + string_from_byte(b3)
}

pub fn valid_rune(r int) bool {
    if r < 0 || r > 0x10FFFF {
        << false
    }
    if r >= 0xD800 && r <= 0xDFFF {
        << false
    }
    << true
}

pub fn full_rune(s &string) bool {
    if s.len == 0 {
        << false
    }
    w := decode_width(s, 0) or (err) { << false }
    << w > 0 && w <= s.len
}

pub fn decode_last(s &string) int {
    if s.len == 0 {
        >> errors.new("utf8: empty")
    }
    mut i := s.len - 1
    mut steps := 0
    while i > 0 && !rune_start(s[i]) {
        i = i - 1
        steps = steps + 1
        if steps > 3 {
            >> errors.new("utf8: invalid sequence")
        }
    }
    << decode(s, i)
}

pub fn append_rune(s &string, r int) string {
    enc := encode(r)
    << (s + "") + enc
}
