@unicode

// Unicode classification and simple case mapping (Go `unicode` parity).
//
// Classification and simple case mapping use deduplicated read-only pages.
// Classification pages store twelve property bits in two printable bytes;
// case pages store biased deltas. Neither path parses hex or allocates.
// Both generators are pinned to Unicode 15.0.0.

const MAX_RUNE = 0x10FFFF

fn valid_rune(r int) bool {
    << r >= 0 && r <= MAX_RUNE
}

fn classification_mask(r int) int {
    if !valid_rune(r) { << 0 }
    index := (r >> 8) * 2
    page := ((CLASSIFICATION_INDEX[index] - 32) << 6) | (CLASSIFICATION_INDEX[index + 1] - 32)
    if page == 0 { << 0 }
    off := page * 512 + (r & 255) * 2
    << ((CLASSIFICATION_PAGES[off] - 32) << 6) | (CLASSIFICATION_PAGES[off + 1] - 32)
}

// is_digit reports whether r is in Unicode category Nd (Go unicode.IsDigit).
pub fn is_digit(r int) bool {
    if r < 0 || r > MAX_RUNE {
        << false
    }
    if r < 128 {
        << r >= 48 && r <= 57
    }
    << (classification_mask(r) & 1) != 0
}

// is_letter reports whether r is in Lu|Ll|Lt|Lm|Lo (Go unicode.IsLetter).
pub fn is_letter(r int) bool {
    if r < 0 || r > MAX_RUNE {
        << false
    }
    if r < 128 {
        if r >= 65 && r <= 90 {
            << true
        }
        << r >= 97 && r <= 122
    }
    << (classification_mask(r) & 2) != 0
}

// is_space reports Unicode whitespace: Zs, ASCII whitespace and
// U+0085/U+2028/U+2029 (the same set as Go unicode.IsSpace).
pub fn is_space(r int) bool {
    if r < 0 || r > MAX_RUNE {
        << false
    }
    // ASCII whitespace uses a direct check; pages cover non-ASCII spaces.
    if r < 128 {
        if r == 32 {
            << true
        }
        << r >= 9 && r <= 13
    }
    << (classification_mask(r) & 4) != 0
}

pub fn is_control(r int) bool {
    if r < 0 {
        << false
    }
    if r < 32 {
        << true
    }
    if r == 127 {
        << true
    }
    << r >= 0x80 && r <= 0x9F
}

pub fn is_print(r int) bool {
    if !valid_rune(r) {
        << false
    }
    << (classification_mask(r) & 512) != 0
}

pub fn is_graphic(r int) bool {
    if !valid_rune(r) {
        << false
    }
    << (classification_mask(r) & 1024) != 0
}

pub fn is_punct(r int) bool {
    if !valid_rune(r) {
        << false
    }
    << (classification_mask(r) & 128) != 0
}

pub fn is_number(r int) bool {
    if !valid_rune(r) {
        << false
    }
    << (classification_mask(r) & 64) != 0
}

pub fn is_title(r int) bool {
    if !valid_rune(r) {
        << false
    }
    << (classification_mask(r) & 32) != 0
}

pub fn to_title(r int) int {
    if r >= 0 && r < 128 {
        << to_upper(r)
    }
    if !valid_rune(r) {
        << r
    }
    << case_title(r)
}

pub fn max_rune_value() int {
    << MAX_RUNE
}

// is_upper reports whether r is in Unicode category Lu (Go unicode.IsUpper).
pub fn is_upper(r int) bool {
    if r < 0 || r > MAX_RUNE {
        << false
    }
    if r < 128 {
        << r >= 65 && r <= 90
    }
    << (classification_mask(r) & 8) != 0
}

// is_lower reports whether r is in Unicode category Ll (Go unicode.IsLower).
pub fn is_lower(r int) bool {
    if r < 0 || r > MAX_RUNE {
        << false
    }
    if r < 128 {
        << r >= 97 && r <= 122
    }
    << (classification_mask(r) & 16) != 0
}

// to_upper returns the simple upper-case mapping of r (Go unicode.ToUpper);
// non-letter runes (and runes with no single-rune upper) are returned as-is.
pub fn to_upper(r int) int {
    if r >= 0 && r < 128 {
        if r >= 97 && r <= 122 {
            << r - 32
        }
        << r
    }
    if !valid_rune(r) {
        << r
    }
    << case_upper(r)
}

// to_lower returns the simple lower-case mapping of r (Go unicode.ToLower).
// U+0130 maps to U+0069 ('i'), using the Unicode simple single-rune mapping.
pub fn to_lower(r int) int {
    if r >= 0 && r < 128 {
        if r >= 65 && r <= 90 {
            << r + 32
        }
        << r
    }
    if !valid_rune(r) {
        << r
    }
    << case_lower(r)
}

pub fn simple_fold(r int) int {
    if !valid_rune(r) {
        << r
    }
    << case_fold(r)
}

// is_symbol includes all Unicode S categories (Sm|Sc|Sk|So).
pub fn is_symbol(r int) bool {
    if !valid_rune(r) {
        << false
    }
    << (classification_mask(r) & 256) != 0
}
