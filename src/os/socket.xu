@os

#errors

// 低层 socket（规划：无顶层 socket 包）。内建是 sys_*，本包装成 os.socket。

pub fn socket(domain int, typ int, proto int) int {
    << sys_socket(domain, typ, proto) or >>
}

pub fn bind4(fd int, a int, b int, c int, d int, port int) int {
    << sys_bind4(fd, a, b, c, d, port) or >>
}

pub fn connect4(fd int, a int, b int, c int, d int, port int) int {
    << sys_connect4(fd, a, b, c, d, port) or >>
}

// IPv6 socket address helpers. `ip` is the 16-byte raw IPv6 value used by
// net.IP; the runtime validates its length before touching the host socket.
pub fn bind6(fd int, ip string, port int) int {
    << sys_bind6(fd, ip, port) or >>
}

pub fn connect6(fd int, ip string, port int) int {
    << sys_connect6(fd, ip, port) or >>
}

// Unix-domain pathname sockets. These calls are available on Darwin/Linux;
// the hosted runtime returns an explicit unsupported error on Windows.
pub fn bind_unix(fd int, path string) int {
    << sys_bind_unix(fd, path) or >>
}

pub fn connect_unix(fd int, path string) int {
    << sys_connect_unix(fd, path) or >>
}

pub fn listen(fd int, backlog int) int {
    << sys_listen(fd, backlog) or >>
}

pub fn accept(fd int) int {
    << sys_accept(fd) or >>
}

pub fn sendto(fd int, addr string, data string) int {
    << sys_sendto(fd, addr, data) or >>
}

pub fn recvfrom(fd int, max int) string {
    << sys_recvfrom(fd, max) or >>
}

pub fn fd_read(fd int, max int) string {
    << os_fd_read(fd, max) or >>
}

pub fn fd_write(fd int, data string) int {
    << os_fd_write(fd, data) or >>
}

pub fn fd_close(fd int) int {
    << os_fd_close(fd) or >>
}

// Socket-specific I/O.  Generic fd_* maps to file handles on Windows;
// Winsock SOCKETs must instead use recv/send/closesocket.  Keep these
// wrappers private to the net package's higher-level Conn/PacketConn paths.
pub fn socket_read(fd int, max int) string {
    << sys_socket_read(fd, max) or >>
}

pub fn socket_write(fd int, data string) int {
    << sys_socket_write(fd, data) or >>
}

pub fn socket_close(fd int) int {
    << sys_socket_close(fd) or >>
}

// socket_poll checks readiness immediately. events is 1 for read/accept or
// 4 for write. Returns 0 when pending and 1 when ready (including EOF).
// The descriptor's blocking mode is unchanged.
pub fn socket_poll(fd int, events int) int {
    << sys_socket_poll(fd, events) or >>
}

// set_sock_timeout sets SO_SNDTIMEO and SO_RCVTIMEO. ns is relative;
// 0 clears. connect() honors it on Darwin; Linux connect still uses
// SYN retries. read/write honor it on both.
pub fn set_sock_timeout(fd int, ns int) int {
    << sys_setsockopt_timeo(fd, ns) or >>
}

// socket_wait waits for non-consuming readiness. events uses read=1 and
// write=2; the runtime normalizes error=4 and hangup=8 across platforms.
pub fn socket_wait(fd int, events int, timeout_ns int) int {
    << sys_socket_wait(fd, events, timeout_ns) or >>
}

// fd_wait_read waits for file/pipe readability without consuming bytes or
// changing blocking mode. Returns 1 for data/EOF and 0 for a timeout.
// timeout_ns uses 0=infinite, negative=immediate. The caller must own reads
// from fd; readiness does not reserve bytes against another reader.
// POSIX poll accepts regular files, unlike Linux epoll. Windows probes pipe
// HANDLEs (0/1/2 map to standard handles) and treats disks as ready. Console
// signals can include non-key events, so complete console lines are not
// guaranteed. Polling has millisecond sleep granularity, not sub-ms latency;
// no overlapped I/O or background reader remains after a timeout.
pub fn fd_wait_read(fd int, timeout_ns int) int {
    if xu_target_os() == 2 {
        started := now_ns()
        while true {
            ready := sys_fd_peek_read(fd) or >>
            if ready != 0 { << 1 }
            if timeout_ns < 0 { << 0 }
            $delay := 1000000
            if timeout_ns > 0 {
                remaining := timeout_ns - (now_ns() - started)
                if remaining <= 0 { << 0 }
                if delay > remaining { delay = remaining }
            }
            sleep_ns(delay)
        }
        << 0
    }
    << socket_wait_read(fd, timeout_ns) or >>
}

// socket_wait_read uses non-consuming poll and bounded sleeps. It preserves
// socket mode, works with POSIX pipes/files, and never leaves a blocking read
// or timer coroutine behind. Recompute from the monotonic start after every
// wakeup; partial progress must not extend the caller's relative timeout.
// Returns 1 for data/EOF, 0 for timeout; timeout_ns uses 0=infinite and
// negative=immediate. Poll errors propagate. The caller must own reads.
pub fn socket_wait_read(fd int, timeout_ns int) int {
    started := now_ns()
    while true {
        ready := sys_socket_poll(fd, 1) or >>
        if ready != 0 { << 1 }
        if timeout_ns < 0 { << 0 }
        $delay := 1000000
        if timeout_ns > 0 {
            remaining := timeout_ns - (now_ns() - started)
            if remaining <= 0 { << 0 }
            if delay > remaining { delay = remaining }
        }
        sleep_ns(delay)
    }
    << 0
}

// interface_data returns the host network-interface snapshot used by the
// net package. Passing an empty name returns NUL-separated interface names;
// passing a name returns a fixed binary metadata record. Platform ABI structs
// stay behind this os/runtime boundary.
pub fn interface_data(name string) string {
    << sys_interface_data(name) or >>
}
