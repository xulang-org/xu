@os/user

#errors
#os
#strconv

// Go `os/user` subset. Current is filled from uid/gid + USER/HOME
// (no getpwuid). Lookup/LookupId succeed only for the current user.

pub struct User {
    pub uid string
    pub gid string
    pub username string
    pub name string
    pub home_dir string
}

pub fn current() User {
    uid := os.getuid()
    gid := os.getgid()
    $username := os.getenv("USER")
    if username.len == 0 {
        username = os.getenv("LOGNAME")
    }
    if username.len == 0 {
        username = os.getenv("USERNAME")
    }
    home := os.home_dir()
    << User{uid: strconv.itoa(uid), gid: strconv.itoa(gid), username: username + "", name: username + "", home_dir: home}
}

pub fn lookup(username string) User {
    u := current()
    if username.len > 0 && u.username == username {
        << u
    }
    >> errors.new("user: unknown user " + username)
    << u
}

pub fn lookup_id(uid string) User {
    u := current()
    if uid.len > 0 && u.uid == uid {
        << u
    }
    >> errors.new("user: unknown userid " + uid)
    << u
}
