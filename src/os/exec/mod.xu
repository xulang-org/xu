@os/exec

#errors
#os
#strconv
#context
#io

// Go `os/exec` subset: command / run / output / combined_output /
// command_context / start / wait / stdout_pipe / stdin_pipe.
// Run is direct exec, not a shell. PATH lookup is look_path.
// stdout_pipe / stdin_pipe are Unix-only (Windows throws).
// stdin must be written and the write end closed before start.

pub struct Cmd {
    pub path string
    pub args []string
    pub dir string
    pub ctx context.Context
    pub has_ctx int
    stdout_r os.File
    stdout_w os.File
    has_out_pipe int
    stdin_r os.File
    stdin_w os.File
    has_in_pipe int
    done chan int
    started int
    waited int
}



pub fn (c &mut Cmd) set_dir(dir string) {
    c.dir = dir + ""
}

pub fn command(name string, args <-> string) Cmd {
    mut a := []string{}
    a.push(name + "")
    mut i := 0
    while i < args.len {
        a.push(args[i] + "")
        i = i + 1
    }
    bg := context.background()
    ch := chan int{cap: 1}
    << Cmd{path: name + "", args: a, dir: "", ctx: bg, has_ctx: 0, stdout_r: os.closed_file(), stdout_w: os.closed_file(), has_out_pipe: 0, stdin_r: os.closed_file(), stdin_w: os.closed_file(), has_in_pipe: 0, done: ch, started: 0, waited: 0}
}

pub fn command_context(ctx context.Context, name string, args <-> string) Cmd {
    mut a := []string{}
    a.push(name + "")
    mut i := 0
    while i < args.len {
        a.push(args[i] + "")
        i = i + 1
    }
    ch := chan int{cap: 1}
    << Cmd{path: name + "", args: a, dir: "", ctx: ctx, has_ctx: 1, stdout_r: os.closed_file(), stdout_w: os.closed_file(), has_out_pipe: 0, stdin_r: os.closed_file(), stdin_w: os.closed_file(), has_in_pipe: 0, done: ch, started: 0, waited: 0}
}

fn win_quote(s string) string {
    if s.len == 0 {
        << "\"\""
    }
    mut i := 0
    mut special := 0
    while i < s.len {
        c := s[i] & 255
        if c == 32 || c == 9 || c == 34 {
            special = 1
            <-
        }
        i = i + 1
    }
    if special == 0 {
        << s + ""
    }
    mut out := io.buffer()
    out.write_str( "\"")
    i = 0
    mut slashes := 0
    while i < s.len {
        c := s[i] & 255
        if c == 92 {
            slashes = slashes + 1
        } else {
            mut count := slashes
            if c == 34 { count = slashes * 2 + 1 }
            for j in 0:count { out.write_str(string_from_byte(92)) }
            out.write_str( string_from_byte(c))
            slashes = 0
        }
        i = i + 1
    }
    for j in 0:slashes * 2 { out.write_str(string_from_byte(92)) }
    out.write_str( string_from_byte(34))
    << out.bytes()
}

fn pack_blob(c &Cmd) string {
    mut out := io.buffer()
    out.write_str( c.dir + "")
    out.write_str( string_from_byte(0))
    if xu_target_os() == 2 {
        mut line := io.buffer()
        line.write_str( win_quote(c.path + ""))
        mut i := 0
        if c.args.len > 0 {
            if c.args[0] == c.path {
                i = 1
            }
        }
        while i < c.args.len {
            line.write_str( " ")
            line.write_str( win_quote(c.args[i] + ""))
            i = i + 1
        }
        mut line_s := line.bytes()
        out.write(&line_s)
        << out.bytes()
    }
    mut i := 0
    while i < c.args.len {
        out.write_str( c.args[i] + "")
        out.write_str( string_from_byte(0))
        i = i + 1
    }
    << out.bytes()
}

fn wait_exit(status int) int {
    if (status & 127) != 0 {
        << status
    }
    << (status >> 8) & 255
}

fn has_sep(s &string) int {
    mut i := 0
    while i < s.len {
        if os.is_path_separator(s[i]) {
            << 1
        }
        i = i + 1
    }
    << 0
}

fn path_list_sep() int {
    if xu_target_os() == 2 {
        << 59
    }
    << 58
}

fn stat_ok(p string) int {
    os.stat(p + "") or (err) {
        << 0
    }
    << 1
}

pub fn look_path(file string) string {
    src := file + ""
    if has_sep(&src) != 0 {
        if stat_ok(src + "") != 0 {
            << src
        }
        if xu_target_os() == 2 {
            exe := src + ".exe"
            if stat_ok(exe + "") != 0 {
                << exe
            }
        }
        >> errors.new("exec: " + src + ": executable file not found in PATH")
        << ""
    }
    path := os.getenv("PATH")
    list_sep := path_list_sep()
    mut start := 0
    mut i := 0
    while i <= path.len {
        if i == path.len || (path[i] & 255) == list_sep {
            if i > start {
                dir := path[start:i]
                cand := dir + string_from_byte(os.path_separator()) + src
                if stat_ok(cand + "") != 0 {
                    << cand
                }
                if xu_target_os() == 2 {
                    exe := cand + ".exe"
                    if stat_ok(exe + "") != 0 {
                        << exe
                    }
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    >> errors.new("exec: " + src + ": executable file not found in PATH")
    << ""
}

fn resolve_path(c &Cmd) string {
    src := c.path + ""
    if has_sep(&src) != 0 {
        << src
    }
    << look_path(src) or >>
}

fn check_exec_string(s &string) int {
    for i in 0:s.len {
        if s[i] == 0 { >> errors.new("os/exec: NUL in command argument") }
    }
    << 0
}

fn check_exec_args(c &Cmd) int {
    check_exec_string(&c.path) or >>
    check_exec_string(&c.dir) or >>
    for i in 0:c.args.len {
        arg := c.args[i]
        check_exec_string(&arg) or >>
    }
    << 0
}

fn drop_file(p string) {
    os.remove(p) or (err) {
        <<
    }
}

fn cmd_ctx_err_on(has_ctx int, deadline_ns int, done chan int) int {
    if has_ctx == 0 {
        << 0
    }
    if deadline_ns > 0 {
        if now_ns() >= deadline_ns {
            >> errors.new("context deadline exceeded")
        }
    }
    select {
        x := <-done {
            _ := x
            >> errors.new("context canceled")
        }
        else {
            << 0
        }
    }
    << 0
}

fn cmd_ctx_err(c &Cmd) int {
    << cmd_ctx_err_on(c.has_ctx, c.ctx.deadline_ns, c.ctx.done)
}

fn cmd_ctx_err_mut(c &mut Cmd) int {
    << cmd_ctx_err_on(c.has_ctx, c.ctx.deadline_ns, c.ctx.done)
}

fn run_status(c &Cmd) int {
    check_exec_args(c) or >>
    cmd_ctx_err(c) or >>
    path := resolve_path(c) or >>
    blob := pack_blob(c)
    st := os_exec(path + "", blob, "")
    << wait_exit(st)
}

pub fn (c &Cmd) run() int {
    code := run_status(c) or >>
    if code != 0 {
        >> errors.new("exit status " + strconv.itoa(code))
    }
    << 0
}

pub fn (c &Cmd) output() string {
    check_exec_args(c) or >>
    cmd_ctx_err(c) or >>
    path := resolve_path(c) or >>
    blob := pack_blob(c)
    tmp := os.temp_dir() + "/xu-exec-" + strconv.itoa(os.getpid()) + "-" + strconv.itoa(now_ns())
    st := os_exec(path + "", blob, tmp + "")
    code := wait_exit(st)
    s := os.read(tmp + "") or (err) {
        drop_file(tmp + "")
        >> err
    }
    drop_file(tmp)
    if code != 0 {
        >> errors.new("exit status " + strconv.itoa(code))
    }
    << s
}

fn pack_blob_mut(c &mut Cmd) string {
    mut out := io.buffer()
    out.write_str(c.dir + "")
    out.write_str(string_from_byte(0))
    if xu_target_os() == 2 {
        mut line := io.buffer()
        line.write_str(win_quote(c.path + ""))
        mut i := 0
        if c.args.len > 0 {
            if c.args[0] == c.path {
                i = 1
            }
        }
        while i < c.args.len {
            line.write_str(" ")
            line.write_str(win_quote(c.args[i] + ""))
            i = i + 1
        }
        mut line_s := line.bytes()
        out.write(&line_s)
        << out.bytes()
    }
    mut i := 0
    while i < c.args.len {
        out.write_str(c.args[i] + "")
        out.write_str(string_from_byte(0))
        i = i + 1
    }
    << out.bytes()
}

// Packs the os_exec redir blob (encoding is defined by `_rt_os_exec`).
fn pack_stdio_fds(out_fd int, in_fd int) string {
    mut out := io.buffer()
    mut x := 0
    mut i := 0
    if out_fd < 0 {
        out.write_str(string_from_byte(3))
        x = in_fd
        i = 0
        while i < 8 {
            out.write_str(string_from_byte(x & 255))
            x = x >> 8
            i = i + 1
        }
        << out.bytes()
    }
    out.write_str(string_from_byte(2))
    x = out_fd
    i = 0
    while i < 8 {
        out.write_str(string_from_byte(x & 255))
        x = x >> 8
        i = i + 1
    }
    if in_fd >= 0 {
        x = in_fd
        i = 0
        while i < 8 {
            out.write_str(string_from_byte(x & 255))
            x = x >> 8
            i = i + 1
        }
    }
    << out.bytes()
}

fn start_worker(path string, blob string, redir string, done chan int) {
    st := os_exec(path + "", blob, redir)
    done <- st
}

fn close_unstarted_file(f &mut os.File) {
    f.close() or (err) { << }
}

// Release pipe endpoints when setup fails before start. Once started, the
// runtime owns the child endpoints; closing those stale fd numbers is unsafe.
pub fn (c &mut Cmd) close_unstarted_pipes() {
    if c.started != 0 { << }
    close_unstarted_file(mut &c.stdout_r)
    close_unstarted_file(mut &c.stdout_w)
    close_unstarted_file(mut &c.stdin_r)
    close_unstarted_file(mut &c.stdin_w)
    c.has_out_pipe = 0
    c.has_in_pipe = 0
}

pub fn (c &mut Cmd) stdout_pipe() os.File {
    if xu_target_os() == 2 {
        >> errors.new("os/exec: stdout pipe is not available on this target")
    }
    if c.started != 0 {
        >> errors.new("os/exec: stdout_pipe after start")
    }
    if c.has_out_pipe != 0 {
        r := mut &c.stdout_r
        << r.take() or >>
    }
    mut p := os.pipe() or >>
    pr := mut &p.r
    c.stdout_r = pr.take() or >>
    pw := mut &p.w
    c.stdout_w = pw.take() or >>
    c.has_out_pipe = 1
    r := mut &c.stdout_r
    << r.take() or >>
}

pub fn (c &mut Cmd) stdin_pipe() os.File {
    if xu_target_os() == 2 {
        >> errors.new("os/exec: stdin pipe is not available on this target")
    }
    if c.started != 0 {
        >> errors.new("os/exec: stdin_pipe after start")
    }
    if c.has_in_pipe != 0 {
        w := mut &c.stdin_w
        << w.take() or >>
    }
    mut p := os.pipe() or >>
    pr := mut &p.r
    c.stdin_r = pr.take() or >>
    pw := mut &p.w
    c.stdin_w = pw.take() or >>
    c.has_in_pipe = 1
    w := mut &c.stdin_w
    << w.take() or >>
}

pub fn (c &mut Cmd) start() int {
    if c.started != 0 {
        >> errors.new("os/exec: already started")
    }
    check_exec_string(&c.path) or >>
    check_exec_string(&c.dir) or >>
    for i in 0:c.args.len {
        arg := c.args[i]
        check_exec_string(&arg) or >>
    }
    cmd_ctx_err_mut(c) or >>
    src := c.path + ""
    mut path := src + ""
    if has_sep(&src) == 0 {
        path = look_path(src) or >>
    }
    blob := pack_blob_mut(c)
    mut out_fd := -1
    mut in_fd := -1
    if c.has_out_pipe != 0 {
        out_ref := mut &c.stdout_w
        out_fd = out_ref.release_descriptor() or >>
    }
    if c.has_in_pipe != 0 {
        in_ref := mut &c.stdin_r
        in_fd = in_ref.release_descriptor() or >>
    }
    mut redir := ""
    if out_fd >= 0 || in_fd >= 0 {
        redir = pack_stdio_fds(out_fd, in_fd)
    }
    c.started = 1
    xu start_worker(path + "", blob, redir, c.done)
    << 0
}

pub fn (c &mut Cmd) wait() int {
    if c.started == 0 {
        >> errors.new("os/exec: not started")
    }
    if c.waited != 0 {
        >> errors.new("os/exec: already waited")
    }
    st := <-c.done
    c.waited = 1
    code := wait_exit(st)
    if code != 0 {
        >> errors.new("exit status " + strconv.itoa(code))
    }
    << 0
}

pub fn (c &Cmd) combined_output() string {
    check_exec_args(c) or >>
    cmd_ctx_err(c) or >>
    path := resolve_path(c) or >>
    blob := pack_blob(c)
    tmp := os.temp_dir() + "/xu-exec-" + strconv.itoa(os.getpid()) + "-" + strconv.itoa(now_ns())
    mark := string_from_byte(1) + tmp
    st := os_exec(path + "", blob, mark)
    code := wait_exit(st)
    s := os.read(tmp + "") or (err) {
        drop_file(tmp + "")
        >> err
    }
    drop_file(tmp)
    if code != 0 {
        mut extra := io.buffer()
        mut extra_len := 0
        mut i := 0
        while i < s.len {
            ch := s[i] & 255
            if ch == 10 || ch == 13 {
                extra.write_str( " ")
                extra_len = extra_len + 1
            } else {
                extra.write_str( string_from_byte(ch))
                extra_len = extra_len + 1
            }
            i = i + 1
            if extra_len >= 160 {
                <-
            }
        }
        mut em := extra.bytes()
        if em.len > 0 {
            >> errors.new("exit status " + strconv.itoa(code) + ": " + em)
        }
        >> errors.new("exit status " + strconv.itoa(code))
    }
    << s
}
