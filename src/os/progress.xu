@os

#io
#errors

pub fn (f &File) read_result(n int) io.ReadResult {
    if n < 0 { << io.ReadResult.Failed("", errors.new("io: invalid count")) }
    if n == 0 { << io.ReadResult.Data("") }
    data := f.read(n) or (err) { << io.ReadResult.Failed("", err) }
    if data.len == 0 { << io.ReadResult.End("") }
    << io.ReadResult.Data(data)
}

pub fn (f &File) write_result(data string) io.WriteResult {
    if data.len == 0 { << io.WriteResult.Written(0) }
    if f.fd < 0 { << io.WriteResult.Failed(0, errors.new("os: file is closed")) }
    // Keep the cross-platform adapter conservative when the old syscall
    // bridge throws without exposing an OS partial-progress count.
    n := f.write(data) or (err) { << io.WriteResult.Unknown(err) }
    << io.WriteResult.Written(n)
}
