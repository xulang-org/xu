@os

#errors

// Go `os.DirFS`: a rooted tree that implements the io/fs.FS method set
// (Open / Stat / ReadFile / ReadDir / Sub).
//
// Go: os imports io/fs; DirFS is `fs.FS` via interfaces.
// Xu: no interface values, so this concrete type lives here; io/fs helpers
// take `&os.DirFS`. This package does not import io/fs (no cycle).

pub struct DirFS {
    pub dir string
}

pub fn dir_fs(dir string) DirFS {
    << DirFS{dir: dir + ""}
}

// Same algorithm as io/fs.valid_path (Go fs.ValidPath). Keep in sync.
fn dirfs_valid_path(name &string) bool {
    n := name.len
    if n == 0 {
        << false
    }
    if n == 1 && (name[0] & 255) == 46 {
        << true
    }
    mut start := 0
    mut k := 0
    while k <= n {
        if k < n {
            ch := name[k] & 255
            if ch == 92 || ch == 0 {
                << false
            }
        }
        if k == n || (name[k] & 255) == 47 {
            elen := k - start
            if elen == 0 {
                << false
            }
            if elen == 1 && (name[start] & 255) == 46 {
                << false
            }
            if elen == 2 && (name[start] & 255) == 46 && (name[start + 1] & 255) == 46 {
                << false
            }
            start = k + 1
        }
        k = k + 1
    }
    << true
}

fn dirfs_join(root string, name string) string {
    if root.len == 0 {
        >> errors.new("os: DirFS with empty root")
    }
    if !dirfs_valid_path(&name) {
        >> errors.new("invalid name")
    }
    mut i := 0
    while i < name.len {
        if (name[i] & 255) == 0 {
            >> errors.new("invalid name")
        }
        i = i + 1
    }
    if name == "." {
        << root
    }
    last := root[root.len - 1] & 255
    if last == 47 {
        << root + name
    }
    << root + "/" + name
}

pub fn (d &DirFS) open(name string) File {
    p := dirfs_join(d.dir + "", name) or >>
    << open(p)
}

pub fn (d &DirFS) stat(name string) FileInfo {
    p := dirfs_join(d.dir + "", name) or >>
    << stat(p)
}

pub fn (d &DirFS) read_dir(name string) []DirEntry {
    p := dirfs_join(d.dir + "", name) or >>
    << entries(p)
}

pub fn (d &DirFS) read_file(name string) string {
    mut f := d.open(name) or >>
    mut out := ""
    mut n := 0
    while n < 262144 {
        chunk := f.read(4096) or (err) {
            f.close() or >>
            >> err
        }
        if chunk.len == 0 {
            f.close() or >>
            << out
        }
        out = out + chunk
        n = n + 1
    }
    f.close() or >>
    >> errors.new("file too large")
    << ""
}

pub fn (d &DirFS) sub(name string) DirFS {
    p := dirfs_join(d.dir + "", name) or >>
    << DirFS{dir: p}
}
