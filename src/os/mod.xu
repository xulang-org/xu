@os

#errors
#strconv
#unicode/utf8

// Process and file helpers aligned with Go `os` (Args / ReadFile / WriteFile /
// ReadDir / File / DirFS). Exit stays the language builtin `exit` — naming a
// wrapper `exit` would shadow it. File owns an fd; close reports errors and drop closes as a fallback.
//
// Go layering: kernel → os.File/Open/socket → io/fs (FS helpers) and net.
// DirFS (dirfs.xu) is Go os.DirFS. Socket is os.socket (socket.xu), not a
// top-level socket package.
//
// Public API is >>/or. Hosted builtins return the same private throw slot as
// ordinary may-throw functions; wrappers preserve package-level naming.

// sys_args is the private builtin spelling.  Calling args() from this module
// would resolve to the public wrapper below and recurse.
pub fn args() []string {
    << sys_args()
}

// argv is retained as the compatibility spelling used by older Xu programs.
pub fn argv() []string {
    << sys_args()
}


// read reads the file named by path and returns the contents.
pub fn read(path string) string {
    << read_file(path) or >>
}

// write writes data to the named file, creating it if necessary.
pub fn write(path string, data string) int {
    << write_file(path, data) or >>
}

// Streaming file owner. Non-Copy via its compiler-managed drop hook.
pub struct File {
    fd int
}

pub const O_RDONLY = 0
pub const O_CREATE = 1
pub const O_APPEND = 2
pub const O_EXCL = 3
pub const O_LOCK = 4
pub const O_LOCK_EXISTING = 5

// Exclusive nonblocking process lock. Closing File or process termination
// releases it. The stable lock file must never be unlinked while in use.
// o_lock creates without truncating; o_lock_existing opens read-only.
pub fn open_lock(path string, existing bool) File {
    mut mode := O_LOCK
    if existing { mode = O_LOCK_EXISTING }
    fd := os_open(path, mode) or >>
    << File{fd: fd}
}

pub fn open(path string) File {
    fd := os_open(path, O_RDONLY) or >>
    << File{fd: fd}
}

pub fn create(path string) File {
    fd := os_open(path, O_CREATE) or >>
    << File{fd: fd}
}

pub fn open_append(path string) File {
    fd := os_open(path, O_APPEND) or >>
    << File{fd: fd}
}

pub fn create_excl(path string) File {
    fd := os_open(path, O_EXCL) or >>
    << File{fd: fd}
}

pub fn (f &File) read(max int) string {
    if f.fd < 0 { >> errors.new("os: file is closed") }
    << os_fd_read(f.fd, max) or >>
}

pub fn (f &File) write(data string) int {
    if f.fd < 0 { >> errors.new("os: file is closed") }
    << os_fd_write(f.fd, data) or >>
}

pub fn (f &mut File) close() int {
    if f.fd < 0 {
        << 0
    }
    fd := f.fd
    // Invalidate before calling the OS. A failed close must never allow a
    // later cleanup to close an unrelated descriptor reused by the kernel.
    f.fd = -1
    os_fd_close(fd) or >>
    << 0
}

pub const SEEK_SET = 0
pub const SEEK_CUR = 1
pub const SEEK_END = 2

pub fn (f &File) seek(offset int, whence int) int {
    if f.fd < 0 { >> errors.new("os: file is closed") }
    << os_fd_seek(f.fd, offset, whence) or >>
}

pub struct Pipe {
    pub r File
    pub w File
}

pub fn pipe() Pipe {
    packed := os_pipe() or >>
    rfd := packed >> 32
    wfd := packed & 4294967295
    << Pipe{r: File{fd: rfd}, w: File{fd: wfd}}
}

// sys_read_dir avoids the same-name wrapper shadowing the private builtin.
pub fn read_dir(path string) string {
    << sys_read_dir(path) or >>
}

// listdir is retained as a compatibility spelling.
pub fn listdir(path string) string {
    << sys_read_dir(path) or >>
}


// ===== System information =====

pub fn getpid() int {
    << pid()
}

pub fn getppid() int {
    << ppid()
}

pub fn getuid() int {
    << uid()
}

pub fn getgid() int {
    << gid()
}

pub fn geteuid() int {
    << euid()
}

pub fn getegid() int {
    << egid()
}

pub fn getpagesize() int {
    << pagesize()
}

pub fn hostname() string {
    << host_name()
}

// getwd returns a rooted path name corresponding to the current directory.
pub fn getwd() string {
    << cwd()
}

// getenv retrieves the value of the environment variable named by the key.
pub fn getenv(name string) string {
    << env_get(name)
}

// EnvVal is Go os.LookupEnv's two results: found is false when unset
// (empty value with found true is a defined empty string).
pub struct EnvVal {
    pub value string
    pub found bool
}

pub fn lookup_env(name string) EnvVal {
    key := name + ""
    if key.len == 0 {
        << EnvVal{value: "", found: false}
    }
    vars := environ()
    mut i := 0
    while i < vars.len {
        e := vars[i]
        if e.len > key.len {
            if (e[key.len] & 255) == 61 {
                mut ok := true
                mut j := 0
                while j < key.len {
                    if (e[j] & 255) != (key[j] & 255) {
                        ok = false
                        <-
                    }
                    j = j + 1
                }
                if ok {
                    << EnvVal{value: e[(key.len + 1):e.len] + "", found: true}
                }
            }
        }
        i = i + 1
    }
    << EnvVal{value: "", found: false}
}

pub fn environ() []string {
    << env_list()
}

pub fn temp_dir() string {
    << tmp_dir()
}

pub fn home_dir() string {
    // Native Windows uses USERPROFILE (or HOMEDRIVE/HOMEPATH).  Prefer
    // those variables even when a POSIX compatibility layer also provides
    // HOME, so native cache/config paths never inherit a Unix-style home.
    if xu_target_os() == 2 {
        h2 := env_get("USERPROFILE")
        if h2.len > 0 {
            << h2
        }
        drive := env_get("HOMEDRIVE")
        home := env_get("HOMEPATH")
        if drive.len > 0 && home.len > 0 {
            << drive + home
        }
        h := env_get("HOME")
        if h.len > 0 {
            << h
        }
        << ""
    }
    h := env_get("HOME")
    if h.len > 0 {
        << h
    }
    h2 := env_get("USERPROFILE")
    if h2.len > 0 {
        << h2
    }
    << ""
}

pub fn user_home_dir() string {
    h := home_dir()
    if h.len == 0 {
        >> errors.new("os: user home directory not found")
    }
    << h
}

pub fn path_separator() int {
    if xu_target_os() == 2 {
        << 92
    }
    << 47
}

pub fn is_path_separator(c int) bool {
    b := c & 255
    if b == 47 {
        << true
    }
    if xu_target_os() == 2 && b == 92 {
        << true
    }
    << false
}

// path_list_separator is Go os.PathListSeparator: ';' on Windows, ':' elsewhere.
pub fn path_list_separator() int {
    if xu_target_os() == 2 {
        << 59
    }
    << 58
}

// dev_null is Go os.DevNull: "NUL" on Windows, "/dev/null" elsewhere.
pub fn dev_null() string {
    if xu_target_os() == 2 {
        << "NUL"
    }
    << "/dev/null"
}

pub fn user_cache_dir() string {
    os := xu_target_os()
    if os == 2 {
        d := getenv("LocalAppData")
        if d.len > 0 {
            << d + ""
        }
        h := home_dir()
        if h.len > 0 {
            << h + "\\AppData\\Local"
        }
        >> errors.new("os: user cache directory not found")
    }
    if os == 0 {
        h := home_dir()
        if h.len == 0 {
            >> errors.new("os: user cache directory not found")
        }
        << h + "/Library/Caches"
    }
    xdg := getenv("XDG_CACHE_HOME")
    if xdg.len > 0 {
        if (xdg[0] & 255) != 47 {
            >> errors.new("os: XDG_CACHE_HOME is relative")
        }
        << xdg + ""
    }
    h := home_dir()
    if h.len == 0 {
        >> errors.new("os: user cache directory not found")
    }
    << h + "/.cache"
}

pub fn user_config_dir() string {
    os := xu_target_os()
    if os == 2 {
        d := getenv("AppData")
        if d.len > 0 {
            << d + ""
        }
        h := home_dir()
        if h.len > 0 {
            << h + "\\AppData\\Roaming"
        }
        >> errors.new("os: user config directory not found")
    }
    if os == 0 {
        h := home_dir()
        if h.len == 0 {
            >> errors.new("os: user config directory not found")
        }
        << h + "/Library/Application Support"
    }
    xdg := getenv("XDG_CONFIG_HOME")
    if xdg.len > 0 {
        if (xdg[0] & 255) != 47 {
            >> errors.new("os: XDG_CONFIG_HOME is relative")
        }
        << xdg + ""
    }
    h := home_dir()
    if h.len == 0 {
        >> errors.new("os: user config directory not found")
    }
    << h + "/.config"
}

// ===== Filesystem ops =====

pub fn stat(path string) FileInfo {
    << os_stat(path) or >>
}

pub fn mkdir(path string) int {
    << os_mkdir(path) or >>
}

pub fn rename(old string, new string) int {
    << os_rename(old, new) or >>
}

pub fn remove(path string) int {
    << os_remove(path) or >>
}

pub fn chmod(path string, mode int) int {
    << os_chmod(path, mode) or >>
}

pub fn chdir(path string) int {
    << os_chdir(path) or >>
}

pub fn symlink(oldpath string, newpath string) int {
    << os_symlink(oldpath, newpath) or >>
}

fn utf8_of_cp(cp int) string {
    mut b := []int{}
    if cp < 128 {
        b.push(cp)
    } else if cp < 2048 {
        b.push(192 | (cp >> 6))
        b.push(128 | (cp & 63))
    } else if cp < 65536 {
        b.push(224 | (cp >> 12))
        b.push(128 | ((cp >> 6) & 63))
        b.push(128 | (cp & 63))
    } else {
        b.push(240 | (cp >> 18))
        b.push(128 | ((cp >> 12) & 63))
        b.push(128 | ((cp >> 6) & 63))
        b.push(128 | (cp & 63))
    }
    << string_from_bytes(b)
}

fn win_utf16le_utf8(raw string) string {
    mut n := raw.len
    if (n & 1) != 0 {
        n = n - 1
    }
    if n <= 0 {
        << ""
    }
    mut out := ""
    mut i := 0
    while i < n {
        lo := raw[i] & 255
        hi := raw[i + 1] & 255
        mut cp := lo | (hi << 8)
        i = i + 2
        if cp >= 55296 && cp < 56320 {
            if i + 1 < n {
                lo2 := raw[i] & 255
                hi2 := raw[i + 1] & 255
                cp2 := lo2 | (hi2 << 8)
                if cp2 >= 56320 && cp2 < 57344 {
                    i = i + 2
                    cp = 65536 + (((cp - 55296) << 10) | (cp2 - 56320))
                } else {
                    cp = utf8.RUNE_ERROR
                }
            } else {
                cp = utf8.RUNE_ERROR
            }
        } else if cp >= 56320 && cp < 57344 {
            cp = utf8.RUNE_ERROR
        }
        out = out + utf8_of_cp(cp)
    }
    if out.len >= 4 {
        if (out[0] & 255) == 92 && (out[1] & 255) == 63 && (out[2] & 255) == 63 && (out[3] & 255) == 92 {
            << out[4:out.len]
        }
    }
    << out
}

pub fn readlink(path string) string {
    raw := os_readlink(path) or >>
    if xu_target_os() != 2 {
        << raw
    }
    << win_utf16le_utf8(raw)
}

pub fn is_dir(path string) bool {
    info := stat(path + "") or (err) {
        << false
    }
    << info.is_dir
}

pub fn is_not_exist(msg string) bool {
    m := msg + ""
    mut i := 0
    while i + 8 < m.len {
        if m[i:(i + 9)] == "not found" {
            << true
        }
        i = i + 1
    }
    i = 0
    while i + 6 < m.len {
        if m[i:(i + 7)] == "no such" {
            << true
        }
        i = i + 1
    }
    i = 0
    while i + 7 < m.len {
        if m[i:(i + 8)] == "No such" {
            << true
        }
        i = i + 1
    }
    << false
}

pub fn is_exist(msg string) bool {
    m := msg + ""
    mut i := 0
    while i + 5 < m.len {
        if m[i:(i + 6)] == "exists" {
            << true
        }
        i = i + 1
    }
    << false
}

pub fn is_permission(msg string) bool {
    m := msg + ""
    mut i := 0
    while i + 9 < m.len {
        if m[i:(i + 10)] == "permission" {
            << true
        }
        i = i + 1
    }
    i = 0
    while i + 5 < m.len {
        if m[i:(i + 6)] == "denied" {
            << true
        }
        i = i + 1
    }
    << false
}

pub fn is_timeout(msg string) bool {
    m := msg + ""
    mut i := 0
    while i + 6 < m.len {
        if m[i:(i + 7)] == "timeout" {
            << true
        }
        i = i + 1
    }
    i = 0
    while i + 8 < m.len {
        if m[i:(i + 9)] == "timed out" {
            << true
        }
        i = i + 1
    }
    << false
}

pub struct DirEntry {
    pub name string
    pub is_dir bool
}

fn split_lines(s &string) []string {
    src := s + ""
    mut out := []string{}
    mut start := 0
    mut i := 0
    while i <= src.len {
        if i == src.len || (src[i] & 255) == 10 {
            if i > start {
                out.push(src[start:i] + "")
            }
            start = i + 1
        }
        i = i + 1
    }
    << out
}

fn join_path(dir string, name string) string {
    if dir == "." {
        << name + ""
    }
    sep := string_from_byte(path_separator())
    << dir + sep + name
}

pub fn entries(path0 string) []DirEntry {
    raw := read_dir(path0 + "") or >>
    names := split_lines(&raw)
    mut out := []DirEntry{}
    for i in 0:names.len {
        nm := names[i] + ""
        full := join_path(path0 + "", nm + "")
        d := is_dir(full)
        out.push(DirEntry{name: nm + "", is_dir: d})
    }
    << out
}

fn ensure_dir(path string) int {
    p1 := path + ""
    p2 := path + ""
    mkdir(p1) or (err) {
        info := stat(p2) or (err2) {
            >> errors.new("os: mkdir_all failed")
        }
        if !info.is_dir {
            >> errors.new("os: mkdir_all: not a directory")
        }
        << 0
    }
    << 0
}

pub fn mkdir_all(path0 string) int {
    src := path0 + ""
    if src.len == 0 {
        << 0
    }
    mut acc := ""
    mut i := 0
    if is_path_separator(src[0]) {
        acc = string_from_byte(path_separator())
        i = 1
    }
    sepch := path_separator()
    while i <= src.len {
        if i == src.len || is_path_separator(src[i]) {
            if acc.len > 0 && !(acc.len == 1 && is_path_separator(acc[0])) {
                // Propagate a failed directory creation to the caller; Gen2
                // correctly preserves the may-throw effect of ensure_dir.
                ensure_dir(acc + "") or >>
            }
            if i < src.len && is_path_separator(src[i]) {
                if !(acc.len == 1 && is_path_separator(acc[0])) {
                    acc = acc + string_from_byte(sepch)
                }
            }
        } else {
            acc = acc + string_from_byte(src[i])
        }
        i = i + 1
    }
    << 0
}

struct TempName {
    prefix string
    suffix string
}

fn parse_temp_pattern(pattern string) TempName {
    src := pattern + ""
    mut star := -1
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 47 || c == 92 {
            >> errors.new("os: pattern contains path separator")
        }
        if c == 42 {
            star = i
        }
        i = i + 1
    }
    if star < 0 {
        << TempName{prefix: src, suffix: ""}
    }
    << TempName{prefix: src[0:star] + "", suffix: src[(star + 1):src.len] + ""}
}

fn temp_parent(dir string) string {
    if dir.len > 0 {
        << dir + ""
    }
    t := temp_dir()
    if t.len == 0 {
        >> errors.new("os: temp directory not found")
    }
    << t + ""
}

pub fn mkdir_temp(dir string, pattern string) string {
    base := temp_parent(dir)
    mut n := 0
    while n < 100 {
        pat := parse_temp_pattern(pattern + "")
        name := pat.prefix + strconv.itoa(getpid()) + "-" + strconv.itoa(now_ns() + n) + pat.suffix
        path := join_path(base + "", name)
        mkdir(path + "") or (err) {
            if is_exist(err.msg()) {
                n = n + 1
                ->
            }
            >> errors.new(err.msg())
        }
        << path
    }
    >> errors.new("os: mkdir_temp failed")
    << ""
}

pub fn create_temp(dir string, pattern string) string {
    base := temp_parent(dir)
    mut n := 0
    while n < 100 {
        pat := parse_temp_pattern(pattern + "")
        name := pat.prefix + strconv.itoa(getpid()) + "-" + strconv.itoa(now_ns() + n) + pat.suffix
        path := join_path(base + "", name)
        mut f := create_excl(path + "") or (err2) {
            if is_exist(err2.msg()) {
                n = n + 1
                ->
            }
            >> errors.new(err2.msg())
        }
        f.close() or (err3) {
            >> errors.new(err3.msg())
        }
        << path
    }
    >> errors.new("os: create_temp failed")
    << ""
}

pub fn remove_all(path0 string) int {
    p := path0 + ""
    stat(p + "") or (err) {
        << 0
    }
    mut walk := []string{}
    mut files := []string{}
    mut dirs := []string{}
    walk.push(p + "")
    while walk.len > 0 {
        mut next := []string{}
        mut wi := 0
        while wi < walk.len - 1 {
            next.push(walk[wi] + "")
            wi = wi + 1
        }
        cur := walk[walk.len - 1] + ""
        walk = next
        if is_dir(cur + "") {
            dirs.push(cur + "")
            raw := read_dir(cur + "") or (err) {
                ->
            }
            names := split_lines(&raw)
            for i in 0:names.len {
                child := join_path(cur + "", names[i] + "")
                walk.push(child + "")
            }
        } else {
            files.push(cur + "")
        }
    }
    for fi in 0:files.len {
        remove(files[fi] + "") or (err) {
            ->
        }
    }
    mut di := dirs.len
    while di > 0 {
        di = di - 1
        remove(dirs[di] + "") or (err) {
            ->
        }
    }
    << 0
}

pub fn expand_env(s &string) string {
    src := s + ""
    mut out := ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c != 36 {
            out = out + string_from_byte(c)
            i = i + 1
        } else {
            if i + 1 < src.len && (src[i + 1] & 255) == 123 {
                i = i + 2
                start := i
                while i < src.len && (src[i] & 255) != 125 {
                    i = i + 1
                }
                name := src[start:i]
                out = out + getenv(name + "")
                if i < src.len {
                    i = i + 1
                }
            } else {
                i = i + 1
                start := i
                while i < src.len {
                    ch := src[i] & 255
                    ok := (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 95
                    if !ok {
                        <-
                    }
                    i = i + 1
                }
                name := src[start:i]
                out = out + getenv(name + "")
            }
        }
    }
    << out
}

// A closed owner for aggregate initialization; no resource is acquired.
pub fn closed_file() File { << File{fd: -1} }

// Transfer a field-owned File without cloning or moving through a borrow.
pub fn (f &mut File) take() File {
    if f.fd < 0 { >> errors.new("os: file is closed") }
    fd := f.fd
    f.fd = -1
    << File{fd: fd}
}

// Explicit ownership handoff to a raw platform adapter. The adapter must
// release the returned descriptor exactly once; this owner becomes closed.
pub fn (f &mut File) release_descriptor() int {
    if f.fd < 0 { >> errors.new("os: file is closed") }
    fd := f.fd
    f.fd = -1
    << fd
}

// Borrowed raw descriptor for platform adapters. It does not transfer ownership;
// callers must not close it or manufacture another owner from it.
pub fn (f &File) descriptor() int {
    if f.fd < 0 { >> errors.new("os: file is closed") }
    << f.fd
}

fn (f &mut File) drop() {
    f.close() or (err) { << }
}
