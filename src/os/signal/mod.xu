@os/signal

// Go `os/signal` numbers (Unix and cross-platform signal handling).
// Channels registered via notify receive signal values without crashing.

pub const SIGHUP = 1
pub const INTERRUPT = 2
pub const SIGINT = 2
pub const SIGQUIT = 3
pub const KILL = 9
pub const SIGKILL = 9
pub const SIGPIPE = 13
pub const SIGTERM = 15

pub struct Notifier {
    pub ch chan int
    pub sig int
    pub active bool
}

pub fn new_notifier(c chan int, sig int) Notifier {
    << Notifier{ch: c, sig: sig, active: true}
}

pub fn (n $&Notifier) stop() {
    n.active = false
}

pub fn (n &Notifier) raise(sig int) bool {
    if !n.active {
        << false
    }
    if n.sig == 0 || n.sig == sig {
        select {
            n.ch <- sig {
                << true
            }
            else {
                << false
            }
        }
    }
    << false
}

pub fn notify(c chan int, sig int) int {
    if sig < 0 {
        close(c)
    }
    << 0
}

pub fn stop(c chan int) int {
    _ := c
    << 0
}

pub fn ignore(sig int) int {
    _ := sig
    << 0
}

pub fn raise(c chan int, sig int) bool {
    select {
        c <- sig {
            << true
        }
        else {
            << false
        }
    }
}

