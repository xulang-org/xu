@os/signal

#errors

// Go `os/signal` numbers (Unix). Notify is not hooked to the kernel
// (needs lang-dep); it throws so callers do not silently miss signals.

pub const sighup = 1
pub const interrupt = 2
pub const sigint = 2
pub const sigquit = 3
pub const kill = 9
pub const sigkill = 9
pub const sigpipe = 13
pub const sigterm = 15

pub fn notify(c chan int, sig int) int {
    if sig < 0 {
        close(c)
    }
    >> errors.new("os/signal: notify is not available")
    << 0
}

pub fn stop(c chan int) int {
    _ := c
    >> errors.new("os/signal: notify is not available")
    << 0
}

pub fn ignore(sig int) int {
    _ := sig
    >> errors.new("os/signal: notify is not available")
    << 0
}
