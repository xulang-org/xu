@os

// io.StreamReader/StreamWriter adapters. These use the existing descriptor;
// callers retain responsibility for close and may continue using File APIs.
pub fn (f &File) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    << f.read(n) or >>
}

pub fn (f &File) write_str(data string) int {
    << f.write(data) or >>
}
