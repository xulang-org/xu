@cmp

// Ordered comparison surface. Constraint name is a single ident, so Ord
// lives here and `sort.slice` constrains `T: Ord` across modules.
// `Self` in method signatures means the concrete implementing type.

struct@ Ord {
    fn less(Self) bool
}

// Lexicographic string compare (same rules as former sort.str_less).
// Used when builtin `string.less` is lowered; also callable directly.
pub fn less_string(a string, b string) bool {
    $lim := a.len
    if b.len < lim {
        lim = b.len
    }
    for i in 0:lim {
        if a[i] < b[i] {
            << true
        }
        if a[i] > b[i] {
            << false
        }
    }
    << a.len < b.len
}

// Go 1.21 cmp.Less / Compare as paired functions (no generic Ordered).
// Go 1.22 cmp.Or as two-arg or_int / or_string (string args borrowed).

pub fn less_int(a int, b int) bool {
    << a < b
}

pub fn compare_int(a int, b int) int {
    if a < b {
        << -1
    }
    if a > b {
        << 1
    }
    << 0
}

fn f64_nan(x f64) bool {
    << x != x
}

pub fn less_f64(a f64, b f64) bool {
    if f64_nan(a) {
        if f64_nan(b) {
            << false
        }
        << true
    }
    << a < b
}

pub fn compare_f64(a f64, b f64) int {
    an := f64_nan(a)
    bn := f64_nan(b)
    if an {
        if bn {
            << 0
        }
        << -1
    }
    if bn {
        << 1
    }
    if a < b {
        << -1
    }
    if a > b {
        << 1
    }
    << 0
}

// Go 1.22 `cmp.Or` as two-arg pairs (no generic comparable / variadic).
pub fn or_int(a int, b int) int {
    if a != 0 {
        << a
    }
    << b
}

pub fn or_string(a &string, b &string) string {
    if a.len != 0 {
        << a + ""
    }
    << b + ""
}

pub fn or_f64(a f64, b f64) f64 {
    if a != 0.0 {
        << a
    }
    << b
}

pub fn compare_string(a string, b string) int {
    $lim := a.len
    if b.len < lim {
        lim = b.len
    }
    for i in 0:lim {
        if a[i] < b[i] {
            << -1
        }
        if a[i] > b[i] {
            << 1
        }
    }
    if a.len < b.len {
        << -1
    }
    if a.len > b.len {
        << 1
    }
    << 0
}
