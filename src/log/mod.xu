@log

#fmt
#time
#strconv

// Minimal logger aligned with Go `log` (Logger + Print/Println/Printf).
// No package-global logger (Xu forbids mutable globals). Callers hold a
// Logger. Output defaults to eprintln; set_output_stdout switches to println.
// No io.Writer struct@ values (L0).
// Time flags: ldate/ltime/lmicroseconds/lutc/lstd_flags.
// File flags: lshortfile/llongfile via output/println_at (explicit file:line).
// M170: print/println/printf/fatal auto-inject callsite when those flags are set
// (compiler rewrites to *at with compile-time file/line).

pub const ldate = 1
pub const ltime = 2
pub const lmicroseconds = 4
pub const lutc = 8
pub const llongfile = 16
pub const lshortfile = 32
pub const lmsgprefix = 64
pub const lstd_flags = 3

pub struct Logger {
    pub prefix string
    pub use_stdout bool
    pub flags int
    pub buf string
    pub use_buf bool
}

pub fn new_logger() Logger {
    << Logger{prefix: "", use_stdout: false, flags: 0, buf: "", use_buf: false}
}

pub fn (l &mut Logger) set_prefix(p string) {
    l.prefix = p
}

pub fn (l &Logger) prefix() string {
    << l.prefix + ""
}

pub fn (l &Logger) flags() int {
    << l.flags
}

pub fn (l &mut Logger) set_output_stdout(on bool) {
    l.use_stdout = on
}

pub fn (l &mut Logger) set_flags(f int) {
    l.flags = f
}

pub fn (l &mut Logger) set_output_buffer() {
    l.use_buf = true
    l.buf = ""
}

pub fn (l &mut Logger) buffer_text() string {
    << l.buf + ""
}

fn file_base(path string) string {
    mut i := path.len - 1
    while i >= 0 {
        c := path[i] & 255
        if c == 47 || c == 92 {
            << path[(i + 1):path.len] + ""
        }
        i = i - 1
    }
    << path + ""
}

fn (l &mut Logger) format_line(file string, line int, msg string) string {
    mut head := ""
    if (l.flags & lmsgprefix) == 0 {
        head = l.prefix + ""
    }
    mut want_date := 0
    mut want_tod := 0
    mut want_micro := 0
    if (l.flags & ldate) != 0 {
        want_date = 1
    }
    if (l.flags & ltime) != 0 {
        want_tod = 1
    }
    if (l.flags & lmicroseconds) != 0 {
        want_micro = 1
    }
    if want_date != 0 || want_tod != 0 || want_micro != 0 {
        t := time.unix_from_ns(wall_time_ns())
        stamp := t.format_log(want_date, want_tod, want_micro)
        if stamp.len > 0 {
            head = head + stamp + " "
        }
    }
    if file.len > 0 && line > 0 && ((l.flags & llongfile) != 0 || (l.flags & lshortfile) != 0) {
        mut path := file + ""
        if (l.flags & llongfile) == 0 {
            path = file_base(file)
        }
        head = head + path + ":" + strconv.itoa(line) + ": "
    }
    if (l.flags & lmsgprefix) != 0 {
        head = head + l.prefix
    }
    << head + msg
}

fn (l &mut Logger) emit_line(line string) {
    if l.use_buf {
        r := mut &l.buf
        r.push_str(line)
        r.push_str("\n")
        <<
    }
    if l.use_stdout {
        println(line)
    } else {
        eprintln(line)
    }
}

fn (l &mut Logger) emit(msg string) {
    l.emit_line(l.format_line("", 0, msg))
}

pub fn (l &mut Logger) output(file string, line int, s string) {
    l.emit_line(l.format_line(file, line, s))
}

pub fn (l &mut Logger) println_at(file string, line int, args <-> fmt.Arg) {
    l.output(file, line, fmt.sprint_args(args))
}

pub fn (l &mut Logger) print_at(file string, line int, args <-> fmt.Arg) {
    l.output(file, line, fmt.sprint_args(args))
}

pub fn (l &mut Logger) printf_at(file string, line int, f string, args <-> fmt.Arg) {
    msg := fmt.sprintf_args(f, args) or (err) {
        l.output(file + "", line, "%!(BADFORMAT)")
        <<
    }
    l.output(file + "", line, msg)
}

pub fn (l &mut Logger) fatal_at(file string, line int, args <-> fmt.Arg) {
    l.output(file, line, fmt.sprint_args(args))
    <<< 1
}

pub fn (l &mut Logger) print(args <-> fmt.Arg) {
    l.emit(fmt.sprint_args(args))
}

pub fn (l &mut Logger) println(args <-> fmt.Arg) {
    l.emit(fmt.sprint_args(args))
}

pub fn (l &mut Logger) printf(f string, args <-> fmt.Arg) {
    msg := fmt.sprintf_args(f, args) or (err) {
        l.emit("%!(BADFORMAT)")
        <<
    }
    l.emit(msg)
}

pub fn (l &mut Logger) fatal(args <-> fmt.Arg) {
    l.emit(fmt.sprint_args(args))
    <<< 1
}
