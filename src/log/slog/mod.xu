@log/slog

#time
#strconv
#encoding/json

// Go `log/slog` text + JSON handler subset. No default logger (Xu has no
// mutable globals). Attributes via with() or on debug/info/warn/error/log
// as trailing string pairs (odd leftover is !BADKEY, same as Go).
// Levels match slog.Level*.
// Context methods exist for the D1 hook; v1 does not extract trace IDs.
// JSON is new_json_logger (Go NewJSONHandler shape, no io.Writer).
// with_group nests subsequent attrs (text: dotted keys; JSON: objects).
// Empty group name is a no-op (same as Go). No syslog.

pub const level_debug = -4
pub const level_info = 0
pub const level_warn = 4
pub const level_error = 8

pub struct Logger {
    pub min_level int
    pub add_source int
    pub add_time int
    pub use_stdout bool
    json_mode int
    group string
    keys []string
    vals []string
    gpre []string
}

pub fn new_logger() Logger {
    << Logger{min_level: level_info, add_source: 0, add_time: 1, use_stdout: false, json_mode: 0, group: "", keys: []string{}, vals: []string{}, gpre: []string{}}
}

pub fn new_json_logger() Logger {
    << Logger{min_level: level_info, add_source: 0, add_time: 1, use_stdout: false, json_mode: 1, group: "", keys: []string{}, vals: []string{}, gpre: []string{}}
}

pub fn (l &mut Logger) set_level(level int) {
    l.min_level = level
}

fn slog_group_join(base string, name string) string {
    if base.len == 0 {
        << name + ""
    }
    sep := string_from_byte(31)
    << (base + "") + sep + (name + "")
}

fn slog_split_us(s string) []string {
    mut parts := []string{}
    if s.len == 0 {
        << parts
    }
    mut cur := ""
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c == 31 {
            parts.push(cur)
            cur = ""
        } else {
            cur = cur + string_from_byte(c)
        }
        i = i + 1
    }
    parts.push(cur)
    << parts
}

fn slog_text_key(gpre string, key string) string {
    if gpre.len == 0 {
        << key + ""
    }
    parts := slog_split_us(gpre)
    mut k := ""
    mut i := 0
    while i < parts.len {
        if k.len > 0 {
            k = k + "."
        }
        k = k + (parts[i] + "")
        i = i + 1
    }
    << k + "." + key
}

fn slog_pop_str(a []string) []string {
    mut n := []string{}
    mut i := 0
    last := a.len - 1
    while i < last {
        n.push(a[i] + "")
        i = i + 1
    }
    << n
}

fn slog_pop_int(a []int) []int {
    mut n := []int{}
    mut i := 0
    last := a.len - 1
    while i < last {
        n.push(a[i])
        i = i + 1
    }
    << n
}

fn with_pairs(l &Logger, kvs []string) Logger {
    mut keys := []string{}
    mut i := 0
    while i < l.keys.len {
        keys.push(l.keys[i] + "")
        i = i + 1
    }
    mut vals := []string{}
    i = 0
    while i < l.vals.len {
        vals.push(l.vals[i] + "")
        i = i + 1
    }
    mut gpre := []string{}
    i = 0
    while i < l.gpre.len {
        gpre.push(l.gpre[i] + "")
        i = i + 1
    }
    g := l.group + ""
    i = 0
    while i < kvs.len {
        if i + 1 >= kvs.len {
            keys.push("!BADKEY")
            vals.push(kvs[i] + "")
            gpre.push(g + "")
            <-
        }
        keys.push(kvs[i] + "")
        vals.push(kvs[i + 1] + "")
        gpre.push(g + "")
        i = i + 2
    }
    << Logger{min_level: l.min_level, add_source: l.add_source, add_time: l.add_time, use_stdout: l.use_stdout, json_mode: l.json_mode, group: g + "", keys: keys, vals: vals, gpre: gpre}
}

pub fn (l Logger) with(kvs <-> string) Logger {
    << with_pairs(&l, kvs)
}

pub fn (l Logger) with_group(name string) Logger {
    if name.len == 0 {
        << l
    }
    g := slog_group_join(l.group + "", name)
    mut keys := []string{}
    mut i := 0
    while i < l.keys.len {
        keys.push(l.keys[i] + "")
        i = i + 1
    }
    mut vals := []string{}
    i = 0
    while i < l.vals.len {
        vals.push(l.vals[i] + "")
        i = i + 1
    }
    mut gpre := []string{}
    i = 0
    while i < l.gpre.len {
        gpre.push(l.gpre[i] + "")
        i = i + 1
    }
    << Logger{min_level: l.min_level, add_source: l.add_source, add_time: l.add_time, use_stdout: l.use_stdout, json_mode: l.json_mode, group: g, keys: keys, vals: vals, gpre: gpre}
}

fn slog_quote(s string) string {
    mut need := 0
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c <= 32 || c == 34 || c == 61 {
            need = 1
            <-
        }
        i = i + 1
    }
    if need == 0 {
        << s + ""
    }
    mut out := "\""
    i = 0
    while i < s.len {
        c := s[i] & 255
        if c == 34 {
            out = out + "\\\""
        } else {
            out = out + string_from_byte(c)
        }
        i = i + 1
    }
    << out + "\""
}

fn slog_pair(key string, val string) string {
    << (key + "") + "=" + slog_quote(val)
}

fn slog_json_pair(key string, val string) string {
    k := key + ""
    v := val + ""
    << json.quote(&k) + ":" + json.quote(&v)
}

fn slog_text_attrs(l &Logger) string {
    mut out := ""
    mut i := 0
    while i < l.keys.len {
        if out.len > 0 {
            out = out + " "
        }
        p := l.gpre[i] + ""
        k0 := l.keys[i] + ""
        k := slog_text_key(p, k0)
        v := l.vals[i] + ""
        out = out + slog_pair(k, v)
        i = i + 1
    }
    << out
}

fn slog_json_attrs(l &Logger) string {
    mut out := ""
    mut stack := []string{}
    mut has := []int{}
    has.push(0)
    mut i := 0
    while i < l.keys.len {
        p := l.gpre[i] + ""
        want := slog_split_us(p)
        mut common := 0
        while common < stack.len {
            if common >= want.len {
                <-
            }
            sa := stack[common] + ""
            wb := want[common] + ""
            if sa != wb {
                <-
            }
            common = common + 1
        }
        while stack.len > common {
            out = out + "}"
            stack = slog_pop_str(stack)
            has = slog_pop_int(has)
        }
        while stack.len < want.len {
            idx := stack.len
            name := want[idx] + ""
            d := has.len - 1
            if has[d] != 0 {
                out = out + ","
            }
            has[d] = 1
            out = out + json.quote(&name) + ":{"
            stack.push(name + "")
            has.push(0)
        }
        d := has.len - 1
        if has[d] != 0 {
            out = out + ","
        }
        has[d] = 1
        k := l.keys[i] + ""
        v := l.vals[i] + ""
        out = out + slog_json_pair(k, v)
        i = i + 1
    }
    while stack.len > 0 {
        out = out + "}"
        stack = slog_pop_str(stack)
    }
    << out
}

fn level_name(level int) string {
    if level <= level_debug {
        << "DEBUG"
    }
    if level < level_warn {
        << "INFO"
    }
    if level < level_error {
        << "WARN"
    }
    << "ERROR"
}

pub fn (l Logger) enabled(level int) bool {
    << level >= l.min_level
}

pub fn (l &Logger) log(level int, msg string) {
    if !l.enabled(level) {
        <<
    }
    mut line := ""
    if l.json_mode != 0 {
        line = slog_json_line(l, level, msg)
    } else {
        if l.add_time != 0 {
            t := time.unix_from_ns(wall_time_ns())
            line = "time=" + t.format_rfc3339() + " "
        }
        line = line + "level=" + level_name(level) + " msg=" + slog_quote(msg)
        ta := slog_text_attrs(l)
        if ta.len > 0 {
            line = line + " " + ta
        }
    }
    if l.use_stdout {
        println(line)
    } else {
        eprintln(line)
    }
}

fn slog_json_line(l &Logger, level int, msg string) string {
    mut line := "{"
    mut need_comma := 0
    if l.add_time != 0 {
        t := time.unix_from_ns(wall_time_ns())
        ts := t.format_rfc3339()
        line = line + "\"time\":" + json.quote(&ts)
        need_comma = 1
    }
    ln := level_name(level)
    if need_comma != 0 {
        line = line + ","
    }
    line = line + "\"level\":" + json.quote(&ln)
    m := msg + ""
    line = line + ",\"msg\":" + json.quote(&m)
    ja := slog_json_attrs(l)
    if ja.len > 0 {
        line = line + "," + ja
    }
    << line + "}"
}

fn log_with(l &Logger, level int, msg string, kvs []string) {
    if kvs.len == 0 {
        l.log(level, msg)
        <<
    }
    mut w := with_pairs(l, kvs)
    w.log(level, msg)
}

pub fn (l &Logger) debug(msg string, kvs <-> string) {
    log_with(l, level_debug, msg, kvs)
}

pub fn (l &Logger) info(msg string, kvs <-> string) {
    log_with(l, level_info, msg, kvs)
}

pub fn (l &Logger) warn(msg string, kvs <-> string) {
    log_with(l, level_warn, msg, kvs)
}

pub fn (l &Logger) error(msg string, kvs <-> string) {
    log_with(l, level_error, msg, kvs)
}
