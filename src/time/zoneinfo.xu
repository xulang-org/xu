@time

#errors
#os

fn tz_unknown() string {
    << "time: unknown location"
}

fn valid_tz_name(name string) bool {
    if name.len == 0 {
        << false
    }
    if (name[0] & 255) == 47 {
        << false
    }
    mut i := 0
    while i < name.len {
        c := name[i] & 255
        if c == 0 || c == 92 {
            << false
        }
        if c == 46 {
            if i + 1 < name.len {
                if (name[i + 1] & 255) == 46 {
                    << false
                }
            }
        }
        i = i + 1
    }
    << true
}

fn tzif_footer(raw &string) string {
    s := raw + ""
    if s.len < 5 {
        << ""
    }
    if (s[0] & 255) != 84 {
        << ""
    }
    mut last := 0 - 1
    mut prev := 0 - 1
    mut i := 0
    while i < s.len {
        if (s[i] & 255) == 10 {
            prev = last
            last = i
        }
        i = i + 1
    }
    if last < 0 || prev < 0 {
        << ""
    }
    if last <= prev + 1 {
        << ""
    }
    << s[(prev + 1):last] + ""
}

fn tz_is_alpha(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    << false
}

fn tz_parse_offset_at(s &string, start int) []int {
    src := s + ""
    mut i := start
    if i >= src.len {
        >> errors.new(tz_unknown())
    }
    mut sign := 1
    c0 := src[i] & 255
    if c0 == 43 {
        i = i + 1
    } else if c0 == 45 {
        sign = 0 - 1
        i = i + 1
    }
    if i >= src.len {
        >> errors.new(tz_unknown())
    }
    d0 := loc_digit(src[i] & 255)
    if d0 < 0 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    mut hh := d0
    if i < src.len {
        d1 := loc_digit(src[i] & 255)
        if d1 >= 0 {
            hh = hh * 10 + d1
            i = i + 1
        }
    }
    mut mm := 0
    mut ss := 0
    if i < src.len {
        if (src[i] & 255) == 58 {
            i = i + 1
            if i + 1 >= src.len {
                >> errors.new(tz_unknown())
            }
            m0 := loc_digit(src[i] & 255)
            m1 := loc_digit(src[i + 1] & 255)
            if m0 < 0 || m1 < 0 {
                >> errors.new(tz_unknown())
            }
            mm = m0 * 10 + m1
            i = i + 2
            if i < src.len {
                if (src[i] & 255) == 58 {
                    i = i + 1
                    if i + 1 >= src.len {
                        >> errors.new(tz_unknown())
                    }
                    s0 := loc_digit(src[i] & 255)
                    s1 := loc_digit(src[i + 1] & 255)
                    if s0 < 0 || s1 < 0 {
                        >> errors.new(tz_unknown())
                    }
                    ss = s0 * 10 + s1
                    i = i + 2
                }
            }
        }
    }
    if hh > 24 || mm > 59 || ss > 59 {
        >> errors.new(tz_unknown())
    }
    posix := sign * (hh * 3600 + mm * 60 + ss)
    mut out := []int{}
    out.push(posix)
    out.push(i)
    << out
}

fn tz_parse_mrule(s &string, start int) []int {
    src := s + ""
    mut i := start
    if i >= src.len {
        >> errors.new(tz_unknown())
    }
    if (src[i] & 255) != 77 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    d0 := loc_digit(src[i] & 255)
    if d0 < 0 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    mut month := d0
    if i < src.len {
        d1 := loc_digit(src[i] & 255)
        if d1 >= 0 {
            month = month * 10 + d1
            i = i + 1
        }
    }
    if i >= src.len || (src[i] & 255) != 46 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    n := loc_digit(src[i] & 255)
    if n < 1 || n > 5 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    if i >= src.len || (src[i] & 255) != 46 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    w := loc_digit(src[i] & 255)
    if w < 0 || w > 6 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    mut tod := 7200
    if i < src.len {
        if (src[i] & 255) == 47 {
            i = i + 1
            off := tz_parse_offset_at(s, i) or >>
            mut posix := off[0]
            if posix < 0 {
                posix = 0 - posix
            }
            tod = posix
            i = off[1]
        }
    }
    if month < 1 || month > 12 {
        >> errors.new(tz_unknown())
    }
    mut out := []int{}
    out.push(month)
    out.push(n)
    out.push(w)
    out.push(tod)
    out.push(i)
    << out
}

fn tz_skip_name(s &string, start int) int {
    src := s + ""
    mut i := start
    if i < src.len {
        if (src[i] & 255) == 60 {
            i = i + 1
            while i < src.len {
                if (src[i] & 255) == 62 {
                    << i + 1
                }
                i = i + 1
            }
            >> errors.new(tz_unknown())
        }
    }
    while i < src.len {
        if !tz_is_alpha(src[i] & 255) {
            <-
        }
        i = i + 1
    }
    << i
}

fn parse_posix_tz(spec string) Location {
    s := spec + ""
    if s.len == 0 {
        >> errors.new(tz_unknown())
    }
    i0 := tz_skip_name(&s, 0) or >>
    if i0 >= s.len {
        >> errors.new(tz_unknown())
    }
    o1 := tz_parse_offset_at(&s, i0) or >>
    posix_std := o1[0]
    mut i := o1[1]
    std_east := 0 - posix_std
    mut loc := loc_std(s + "", std_east)
    if i >= s.len {
        << loc
    }
    if (s[i] & 255) == 44 {
        >> errors.new(tz_unknown())
    }
    i = tz_skip_name(&s, i) or >>
    mut posix_dst := posix_std - 3600
    if i < s.len {
        c := s[i] & 255
        if c == 43 || c == 45 || loc_digit(c) >= 0 {
            o2 := tz_parse_offset_at(&s, i) or >>
            posix_dst = o2[0]
            i = o2[1]
        }
    }
    if i >= s.len || (s[i] & 255) != 44 {
        loc.dst_offset_sec = 0 - posix_dst
        loc.has_dst = 0
        << loc
    }
    i = i + 1
    st := tz_parse_mrule(&s, i) or >>
    i = st[4]
    if i >= s.len || (s[i] & 255) != 44 {
        >> errors.new(tz_unknown())
    }
    i = i + 1
    en := tz_parse_mrule(&s, i) or >>
    loc.dst_offset_sec = 0 - posix_dst
    loc.has_dst = 1
    loc.dst_sm = st[0]
    loc.dst_sn = st[1]
    loc.dst_sd = st[2]
    loc.dst_st = st[3]
    loc.dst_em = en[0]
    loc.dst_en = en[1]
    loc.dst_ed = en[2]
    loc.dst_et = en[3]
    << loc
}

fn mrule_day(year int, month int, n int, wday int) int {
    first := date(year, month, 1, 12, 0, 0, 0)
    fw := first.weekday()
    mut day := 1 + ((wday - fw + 7) % 7)
    if n < 5 {
        day = day + (n - 1) * 7
        << day
    }
    dim := days_in_month(year, month)
    while day + 7 <= dim {
        day = day + 7
    }
    << day
}

fn mrule_unix(year int, month int, n int, wday int, tod int, east_off int) int {
    day := mrule_day(year, month, n, wday)
    base := date(year, month, day, 0, 0, 0, 0)
    << base.unix() + tod - east_off
}

fn loc_posix_offset(loc &Location, sec int) int {
    if loc.has_dst == 0 {
        << loc.offset_sec
    }
    t := unix(sec, 0)
    c := civil_in(t, loc.offset_sec)
    y := c.y
    start := mrule_unix(y, loc.dst_sm, loc.dst_sn, loc.dst_sd, loc.dst_st, loc.offset_sec)
    endt := mrule_unix(y, loc.dst_em, loc.dst_en, loc.dst_ed, loc.dst_et, loc.dst_offset_sec)
    if start < endt {
        if sec >= start && sec < endt {
            << loc.dst_offset_sec
        }
        << loc.offset_sec
    }
    if sec >= start || sec < endt {
        << loc.dst_offset_sec
    }
    << loc.offset_sec
}

fn loc_offset_at(loc &Location, sec int) int {
    n := loc.trans_sec.len
    if n > 0 && n == loc.trans_off.len {
        if sec < loc.trans_sec[0] {
            << loc.before_off
        }
        mut lo := 0
        mut hi := n
        while lo + 1 < hi {
            mid := lo + (hi - lo) / 2
            if loc.trans_sec[mid] <= sec {
                lo = mid
            } else {
                hi = mid
            }
        }
        if lo < n - 1 || loc.has_dst == 0 {
            << loc.trans_off[lo]
        }
        << loc_posix_offset(loc, sec)
    }
    << loc_posix_offset(loc, sec)
}

fn tzif_magic(s &string, off int) bool {
    src := s + ""
    if off + 4 > src.len {
        << false
    }
    << (src[off] & 255) == 84 && (src[off + 1] & 255) == 90 && (src[off + 2] & 255) == 105 && (src[off + 3] & 255) == 102
}

fn be_u32(s &string, off int) int {
    src := s + ""
    if off + 4 > src.len {
        >> errors.new(tz_unknown())
    }
    b0 := src[off] & 255
    b1 := src[off + 1] & 255
    b2 := src[off + 2] & 255
    b3 := src[off + 3] & 255
    << b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
}

fn be_i32(s &string, off int) int {
    u := be_u32(s, off) or >>
    if u >= 2147483648 {
        << u - 4294967296
    }
    << u
}

fn be_i64(s &string, off int) int {
    hi := be_u32(s, off) or >>
    lo := be_u32(s, off + 4) or >>
    << (hi << 32) + lo
}

fn tzif_hdr(s &string, off int) []int {
    if !tzif_magic(s, off) {
        >> errors.new(tz_unknown())
    }
    src := s + ""
    if off + 44 > src.len {
        >> errors.new(tz_unknown())
    }
    ver := src[off + 4] & 255
    base := off + 20
    isut := be_u32(s, base) or >>
    isstd := be_u32(s, base + 4) or >>
    leap := be_u32(s, base + 8) or >>
    timecnt := be_u32(s, base + 12) or >>
    typecnt := be_u32(s, base + 16) or >>
    charcnt := be_u32(s, base + 20) or >>
    mut out := []int{}
    out.push(ver)
    out.push(isut)
    out.push(isstd)
    out.push(leap)
    out.push(timecnt)
    out.push(typecnt)
    out.push(charcnt)
    out.push(off + 44)
    << out
}

fn parse_tzif_into(loc &mut Location, raw &string) int {
    src := raw + ""
    h0 := tzif_hdr(&src, 0) or >>
    ver := h0[0]
    isut := h0[1]
    isstd := h0[2]
    leap := h0[3]
    mut timecnt := h0[4]
    mut typecnt := h0[5]
    charcnt := h0[6]
    data := h0[7]
    mut time_size := 4
    mut start := data
    if ver == 50 || ver == 51 || ver == 52 {
        v1 := timecnt * 4 + timecnt + typecnt * 6 + charcnt + leap * 8 + isstd + isut
        h2 := tzif_hdr(&src, data + v1) or >>
        timecnt = h2[4]
        typecnt = h2[5]
        start = h2[7]
        time_size = 8
    }
    if timecnt < 0 || typecnt < 1 {
        << 0
    }
    if timecnt > 4096 || typecnt > 256 {
        << 0
    }
    mut offs := []int{}
    mut isdst := []int{}
    tt_off := start + timecnt * time_size + timecnt
    mut ti := 0
    while ti < typecnt {
        utoff := be_i32(&src, tt_off + ti * 6) or >>
        mut dstb := 0
        if tt_off + ti * 6 + 4 < src.len {
            dstb = src[tt_off + ti * 6 + 4] & 255
        }
        offs.push(utoff)
        isdst.push(dstb)
        ti = ti + 1
    }
    mut before := offs[0]
    mut k := 0
    while k < isdst.len {
        if isdst[k] == 0 {
            before = offs[k]
            <-
        }
        k = k + 1
    }
    mut times := []int{}
    mut t_off := []int{}
    mut i := 0
    while i < timecnt {
        mut at := 0
        if time_size == 8 {
            at = be_i64(&src, start + i * 8) or >>
        } else {
            at = be_i32(&src, start + i * 4) or >>
        }
        tidx_off := start + timecnt * time_size + i
        if tidx_off >= src.len {
            >> errors.new(tz_unknown())
        }
        tidx := src[tidx_off] & 255
        mut offv := before
        if tidx < offs.len {
            offv = offs[tidx]
        }
        times.push(at)
        t_off.push(offv)
        i = i + 1
    }
    loc.before_off = before
    loc.trans_sec = times
    loc.trans_off = t_off
    << 0
}

fn apply_tzif_trans(loc &mut Location, raw &string) {
    parse_tzif_into(loc, raw) or (err) { << }
}

fn zoneinfo_file(name string) string {
    env := os.getenv("ZONEINFO")
    if env.len > 0 {
        << env + "/" + name
    }
    << "/usr/share/zoneinfo/" + name
}

fn load_zoneinfo(name string) Location {
    if xu_target_os() == 2 {
        >> errors.new(tz_unknown())
    }
    src := name + ""
    if !valid_tz_name(src + "") {
        >> errors.new(tz_unknown())
    }
    path := zoneinfo_file(src + "")
    raw := os.read(path) or (err) {
        >> errors.new(tz_unknown())
    }
    footer := tzif_footer(&raw)
    if footer.len == 0 {
        >> errors.new(tz_unknown())
    }
    mut loc := parse_posix_tz(footer) or >>
    loc.name = src + ""
    apply_tzif_trans(mut &loc, &raw)
    << loc
}
