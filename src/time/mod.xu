@time

#errors
#os

// Duration is an int count of nanoseconds. now/since use the monotonic clock;
// now_time/until use wall_time_ns (Unix epoch). sleep wraps the hosted sleep
// primitive. Freestanding rejects all hosted clock builtins at check time.
//
// Location is UTC or a fixed offset (`fixed_zone`). There is no IANA tzdata
// or DST. `load_location` accepts "", "UTC", "GMT", and `UTC±H[H][:MM]` /
// `GMT±H[H][:MM]`. Time itself stays Unix UTC; `*_in(loc)` /
// `format_rfc3339_in` apply offset.

pub fn nanosecond() int {
    << 1
}

pub fn microsecond() int {
    << ns_per_microsecond
}

pub fn millisecond() int {
    << ns_per_millisecond
}

pub fn second() int {
    << ns_per_second
}

pub fn minute() int {
    << ns_per_minute
}

pub fn hour() int {
    << ns_per_hour
}

pub fn now() int {
    << now_ns()
}

pub fn sleep(d int) {
    sleep_ns(d)
}

pub fn since(t int) int {
    << now_ns() - t
}

pub struct Time {
    pub sec int
    pub nsec int
}

pub fn unix(sec int, nsec int) Time {
    mut s := sec
    mut n := nsec
    while n >= ns_per_second {
        n = n - ns_per_second
        s = s + 1
    }
    while n < 0 {
        n = n + ns_per_second
        s = s - 1
    }
    << Time{sec: s, nsec: n}
}

pub fn unix_from_ns(ns int) Time {
    mut sec := ns / ns_per_second
    mut nsec := ns % ns_per_second
    if nsec < 0 {
        sec = sec - 1
        nsec = nsec + ns_per_second
    }
    << Time{sec: sec, nsec: nsec}
}

pub fn (t Time) unix() int {
    << t.sec
}

pub fn (t Time) is_zero() bool {
    << t.sec == 0 && t.nsec == 0
}

pub fn (t Time) unix_nano() int {
    << t.sec * ns_per_second + t.nsec
}

pub fn (t Time) unix_milli() int {
    << t.sec * (ns_per_second / ns_per_millisecond) + t.nsec / ns_per_millisecond
}

pub fn (t Time) unix_micro() int {
    << t.sec * (ns_per_second / ns_per_microsecond) + t.nsec / ns_per_microsecond
}

pub fn unix_milli(ms int) Time {
    << unix_from_ns(ms * ns_per_millisecond)
}

pub fn unix_micro(us int) Time {
    << unix_from_ns(us * ns_per_microsecond)
}

pub fn (t Time) add(d int) Time {
    << unix_from_ns(t.unix_nano() + d)
}

pub fn (t Time) sub(u Time) int {
    << t.unix_nano() - u.unix_nano()
}

pub fn (t Time) before(u Time) bool {
    << t.unix_nano() < u.unix_nano()
}

pub fn (t Time) after(u Time) bool {
    << t.unix_nano() > u.unix_nano()
}

pub fn (t Time) equal(u Time) bool {
    << t.sec == u.sec && t.nsec == u.nsec
}

pub fn now_time() Time {
    << unix_from_ns(wall_time_ns())
}

fn parse_u(s &string, i int, n int) int {
    if i + n > s.len {
        >> errors.new("time: bad duration")
    }
    mut v := 0
    for k in 0:n {
        c := s[i + k] & 255
        if c < 48 || c > 57 {
            >> errors.new("time: bad duration")
        }
        v = v * 10 + (c - 48)
    }
    << v
}

fn parse_u_or_throw(s &string, i int, n int) int {
    << parse_u(s, i, n)
}

pub fn parse_duration(s &string) int {
    if s.len == 0 {
        >> errors.new("time: empty duration")
    }
    mut i := 0
    mut neg := false
    if s[0] == 45 {
        neg = true
        i = 1
    }
    mut total := 0
    if i >= s.len {
        >> errors.new("time: empty duration")
    }
    while i < s.len {
        mut n := 0
        mut saw_digit := false
        while i < s.len {
            c := s[i] & 255
            if c < 48 || c > 57 {
                <-
            }
            n = n * 10 + (c - 48)
            i = i + 1
            saw_digit = true
        }
        if !saw_digit {
            >> errors.new("time: bad duration")
        }
        if i >= s.len {
            >> errors.new("time: unknown unit")
        }
        c := s[i] & 255
        mut mul := 0
        if c == 110 {
            // ns
            if i + 1 >= s.len || s[i + 1] != 115 {
                >> errors.new("time: unknown unit")
            }
            mul = 1
            i = i + 2
        } else if c == 117 {
            // us
            if i + 1 >= s.len || s[i + 1] != 115 {
                >> errors.new("time: unknown unit")
            }
            mul = ns_per_microsecond
            i = i + 2
        } else if c == 194 {
            // µs (UTF-8 0xC2 0xB5)
            if i + 2 >= s.len || s[i + 1] != 181 || s[i + 2] != 115 {
                >> errors.new("time: unknown unit")
            }
            mul = ns_per_microsecond
            i = i + 3
        } else if c == 109 {
            if i + 1 < s.len && s[i + 1] == 115 {
                // ms
                mul = ns_per_millisecond
                i = i + 2
            } else {
                // m
                mul = ns_per_minute
                i = i + 1
            }
        } else if c == 115 {
            // s
            mul = ns_per_second
            i = i + 1
        } else if c == 104 {
            // h
            mul = ns_per_hour
            i = i + 1
        } else {
            >> errors.new("time: unknown unit")
        }
        total = total + n * mul
    }
    if neg {
        << 0 - total
    }
    << total
}

pub fn format_duration(d int) string {
    if d == 0 {
        << "0s"
    }
    mut x := d
    mut sign := ""
    if x < 0 {
        sign = "-"
        x = 0 - x
    }
    mut out := ""
    h := x / ns_per_hour
    x = x % ns_per_hour
    m := x / ns_per_minute
    x = x % ns_per_minute
    s := x / ns_per_second
    x = x % ns_per_second
    ms := x / ns_per_millisecond
    x = x % ns_per_millisecond
    us := x / ns_per_microsecond
    ns := x % ns_per_microsecond
    if h > 0 {
        out = out + str(h) + "h"
    }
    if m > 0 {
        out = out + str(m) + "m"
    }
    if s > 0 {
        out = out + str(s) + "s"
    }
    if ms > 0 {
        out = out + str(ms) + "ms"
    }
    if us > 0 {
        out = out + str(us) + "us"
    }
    if ns > 0 {
        out = out + str(ns) + "ns"
    }
    if out.len == 0 {
        << "0s"
    }
    << sign + out
}

fn pad2(n int) string {
    if n < 10 {
        << "0" + str(n)
    }
    << str(n)
}

fn pad3(n int) string {
    if n < 10 {
        << "00" + str(n)
    }
    if n < 100 {
        << "0" + str(n)
    }
    << str(n)
}

fn days_in_month(y int, m int) int {
    if m == 2 {
        leap := (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)
        if leap {
            << 29
        }
        << 28
    }
    if m == 4 || m == 6 || m == 9 || m == 11 {
        << 30
    }
    << 31
}

fn pad6(n int) string {
    mut v := n
    if v < 0 {
        v = 0
    }
    if v > 999999 {
        v = 999999
    }
    mut s := str(v)
    while s.len < 6 {
        s = "0" + s
    }
    << s
}

struct Civil {
    y    int
    mo   int
    day  int
    hour int
    min  int
    sec  int
}

fn days_in_year(y int) int {
    if leap_year(y) {
        << 366
    }
    << 365
}

fn civil_utc(t Time) Civil {
    mut days := t.sec / seconds_per_day
    mut rem := t.sec % seconds_per_day
    if rem < 0 {
        days = days - 1
        rem = rem + seconds_per_day
    }
    hour := rem / seconds_per_hour
    rem = rem % seconds_per_hour
    min := rem / 60
    sec := rem % 60
    mut y := 1970
    mut left := days
    while left < 0 {
        y = y - 1
        left = left + days_in_year(y)
    }
    while true {
        diy := days_in_year(y)
        if left < diy {
            <-
        }
        left = left - diy
        y = y + 1
    }
    mut mo := 1
    while mo <= 12 {
        dim := days_in_month(y, mo)
        if left < dim {
            <-
        }
        left = left - dim
        mo = mo + 1
    }
    day := left + 1
    << Civil{y: y, mo: mo, day: day, hour: hour, min: min, sec: sec}
}

pub fn (t Time) format_rfc3339() string {
    c := civil_utc(t)
    mut frac := ""
    if t.nsec != 0 {
        mut ns := t.nsec
        mut digits := ""
        mut k := 0
        mut p := 100000000
        while k < 9 {
            if p > 0 {
                digits = digits + str(ns / p)
                ns = ns % p
                p = p / 10
            }
            k = k + 1
        }
        frac = "." + digits
    }
    << str(c.y) + "-" + pad2(c.mo) + "-" + pad2(c.day) + "T" + pad2(c.hour) + ":" + pad2(c.min) + ":" + pad2(c.sec) + frac + "Z"
}

// Go log header shape: "2006/01/02 15:04:05[.micros]" (UTC). No trailing space.
// date/tod/micro are 0 or 1 switches.
pub fn (t Time) format_log(date int, tod int, micro int) string {
    c := civil_utc(t)
    mut out := ""
    if date != 0 {
        out = str(c.y) + "/" + pad2(c.mo) + "/" + pad2(c.day)
    }
    if tod != 0 {
        if out.len > 0 {
            out = out + " "
        }
        out = out + pad2(c.hour) + ":" + pad2(c.min) + ":" + pad2(c.sec)
        if micro != 0 {
            out = out + "." + pad6(t.nsec / ns_per_microsecond)
        }
    } else {
        if micro != 0 {
            if out.len > 0 {
                out = out + " "
            }
            out = out + pad6(t.nsec / ns_per_microsecond)
        }
    }
    << out
}

pub fn parse_rfc3339(s &string) Time {
    src := s + ""
    if src.len < 20 {
        >> errors.new("time: bad rfc3339")
    }
    y := parse_u_or_throw(&src, 0, 4)
    if (src[4] & 255) != 45 {
        >> errors.new("time: bad rfc3339")
    }
    mo := parse_u_or_throw(&src, 5, 2)
    if (src[7] & 255) != 45 {
        >> errors.new("time: bad rfc3339")
    }
    d := parse_u_or_throw(&src, 8, 2)
    c := src[10] & 255
    if c != 84 && c != 116 {
        >> errors.new("time: bad rfc3339")
    }
    hh := parse_u_or_throw(&src, 11, 2)
    if (src[13] & 255) != 58 {
        >> errors.new("time: bad rfc3339")
    }
    mm := parse_u_or_throw(&src, 14, 2)
    if (src[16] & 255) != 58 {
        >> errors.new("time: bad rfc3339")
    }
    ss := parse_u_or_throw(&src, 17, 2)
    if mo < 1 || mo > 12 || d < 1 || d > days_in_month(y, mo) || hh > 23 || mm > 59 || ss > 59 {
        >> errors.new("time: invalid rfc3339 date")
    }
    mut i := 19
    mut nsec := 0
    if i < src.len && (src[i] & 255) == 46 {
        i = i + 1
        mut f := 0
        mut n := 0
        while i < src.len && n < 9 {
            c2 := src[i] & 255
            if c2 < 48 || c2 > 57 {
                <-
            }
            f = f * 10 + (c2 - 48)
            n = n + 1
            i = i + 1
        }
        if n == 0 {
            >> errors.new("time: bad rfc3339 fraction")
        }
        while n < 9 {
            f = f * 10
            n = n + 1
        }
        nsec = f
    }
    if i >= src.len {
        >> errors.new("time: missing rfc3339 zone")
    }
    mut zone_offset := 0
    zone := src[i] & 255
    if zone == 90 || zone == 122 {
        i = i + 1
    } else if zone == 43 || zone == 45 {
        mut sign := 1
        if zone == 45 {
            sign = -1
        }
        if i + 6 > src.len || (src[i + 3] & 255) != 58 {
            >> errors.new("time: bad rfc3339 zone")
        }
        zh := parse_u_or_throw(&src, i + 1, 2)
        zm := parse_u_or_throw(&src, i + 4, 2)
        if zh > 23 || zm > 59 {
            >> errors.new("time: bad rfc3339 zone")
        }
        zone_offset = sign * (zh * seconds_per_hour + zm * 60)
        i = i + 6
    } else {
        >> errors.new("time: bad rfc3339 zone")
    }
    if i != src.len {
        >> errors.new("time: trailing rfc3339 data")
    }
    base := date(y, mo, d, hh, mm, ss, nsec)
    << unix_from_ns(base.unix_nano() - zone_offset * second())
}

fn leap_year(y int) bool {
    << (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0)
}

fn days_before_year(year int) int {
    mut days := 0
    if year >= 1970 {
        mut yy := 1970
        while yy < year {
            mut diy := 365
            if leap_year(yy) {
                diy = 366
            }
            days = days + diy
            yy = yy + 1
        }
        << days
    }
    mut yy2 := year
    while yy2 < 1970 {
        mut diy2 := 365
        if leap_year(yy2) {
            diy2 = 366
        }
        days = days - diy2
        yy2 = yy2 + 1
    }
    << days
}

pub fn (t Time) add_date(years int, months int, days int) Time {
    c := civil_utc(t)
    mut y := c.y + years
    mut mo := c.mo + months
    while mo > 12 {
        mo = mo - 12
        y = y + 1
    }
    while mo < 1 {
        mo = mo + 12
        y = y - 1
    }
    dim := days_in_month(y, mo)
    mut d := c.day
    if d > dim {
        d = dim
    }
    base := date(y, mo, d, c.hour, c.min, c.sec, t.nsec)
    << unix(base.sec + days * seconds_per_day, base.nsec)
}

pub fn date(year int, month int, day int, hour int, min int, sec int, nsec int) Time {
    mut days := days_before_year(year)
    mut mo := 1
    while mo < month {
        days = days + days_in_month(year, mo)
        mo = mo + 1
    }
    days = days + (day - 1)
    unix_sec := days * seconds_per_day + hour * seconds_per_hour + min * 60 + sec
    << unix(unix_sec, nsec)
}

pub fn (t Time) year() int {
    c := civil_utc(t)
    << c.y
}

pub fn (t Time) month() int {
    c := civil_utc(t)
    << c.mo
}

pub fn (t Time) day() int {
    c := civil_utc(t)
    << c.day
}

// year_day is Go Time.YearDay: 1..365 (366 in a leap year).
pub fn (t Time) year_day() int {
    c := civil_utc(t)
    mut n := c.day
    mut mo := 1
    while mo < c.mo {
        n = n + days_in_month(c.y, mo)
        mo = mo + 1
    }
    << n
}

pub struct Clock {
    pub hour int
    pub min int
    pub sec int
}

pub fn (t Time) clock() Clock {
    << Clock{hour: t.hour(), min: t.minute(), sec: t.second()}
}

pub fn (t Time) nanosecond() int {
    << t.nsec
}

// date_parts is Go Time.Date's three results (year, month, day) as a struct.
pub struct DateParts {
    pub year int
    pub month int
    pub day int
}

pub fn (t Time) date_parts() DateParts {
    c := civil_utc(t)
    << DateParts{year: c.y, month: c.mo, day: c.day}
}

pub fn (t Time) hour() int {
    mut rem := t.sec % seconds_per_day
    if rem < 0 {
        rem = rem + seconds_per_day
    }
    << rem / seconds_per_hour
}

pub fn (t Time) minute() int {
    mut rem := t.sec % seconds_per_day
    if rem < 0 {
        rem = rem + seconds_per_day
    }
    rem = rem % seconds_per_hour
    << rem / 60
}

pub fn (t Time) second() int {
    mut rem := t.sec % seconds_per_day
    if rem < 0 {
        rem = rem + seconds_per_day
    }
    << rem % 60
}

pub struct ISOWeek {
    pub year int
    pub week int
}

pub fn (t Time) iso_week() ISOWeek {
    wd := t.weekday()
    mut iso := wd
    if iso == 0 {
        iso = 7
    }
    th := t.add_date(0, 0, 4 - iso)
    y := th.year()
    yd := th.year_day()
    week := (yd - 1) / 7 + 1
    << ISOWeek{year: y, week: week}
}

pub fn (t Time) weekday() int {
    mut days := t.sec / seconds_per_day
    mut rem := t.sec % seconds_per_day
    if rem < 0 {
        days = days - 1
    }
    mut w := (days + 4) % 7
    if w < 0 {
        w = w + 7
    }
    << w
}

// weekday_name is Go time.Weekday.String (English, all platforms).
pub fn weekday_name(d int) string {
    if d == 0 {
        << "Sunday"
    }
    if d == 1 {
        << "Monday"
    }
    if d == 2 {
        << "Tuesday"
    }
    if d == 3 {
        << "Wednesday"
    }
    if d == 4 {
        << "Thursday"
    }
    if d == 5 {
        << "Friday"
    }
    if d == 6 {
        << "Saturday"
    }
    << ""
}

// month_name is Go time.Month.String (English, 1..12; else "").
pub fn month_name(m int) string {
    if m == 1 {
        << "January"
    }
    if m == 2 {
        << "February"
    }
    if m == 3 {
        << "March"
    }
    if m == 4 {
        << "April"
    }
    if m == 5 {
        << "May"
    }
    if m == 6 {
        << "June"
    }
    if m == 7 {
        << "July"
    }
    if m == 8 {
        << "August"
    }
    if m == 9 {
        << "September"
    }
    if m == 10 {
        << "October"
    }
    if m == 11 {
        << "November"
    }
    if m == 12 {
        << "December"
    }
    << ""
}

pub fn (t Time) truncate(d int) Time {
    if d <= 0 {
        << t
    }
    ns := t.unix_nano()
    mut r := ns % d
    if r < 0 {
        r = r + d
    }
    << unix_from_ns(ns - r)
}

pub fn (t Time) round(d int) Time {
    if d <= 0 {
        << t
    }
    ns := t.unix_nano()
    mut r := ns % d
    if r < 0 {
        r = r + d
    }
    if r >= d - r {
        << unix_from_ns(ns + (d - r))
    }
    << unix_from_ns(ns - r)
}

pub fn until(t Time) int {
    << t.unix_nano() - wall_time_ns()
}

fn timer_fire(ns int, c chan int, stop chan int) {
    if sys_wait_cancel(stop, ns) { << }
    select {
        x := <-stop {
            _ := x
            <<
        }
        c <- 1 {
        }
    }
}

pub struct Timer {
    pub c chan int
    pub stop chan int
}

pub fn new_timer(d int) Timer {
    ch := chan int{cap: 1}
    st := chan int{cap: 1}
    mut ns := d
    if ns < 0 {
        ns = 0
    }
    xu timer_fire(ns, ch, st)
    << Timer{c: ch, stop: st}
}

pub fn (t Timer) stop() {
    select {
        t.stop <- 1 {
        }
        else {
        }
    }
}

fn ticker_loop(period int, c chan int, stop chan int) {
    mut ns := period
    if ns < 1 {
        ns = 1
    }
    while true {
        if sys_wait_cancel(stop, ns) { << }
        select {
            x := <-stop {
                _ := x
                <<
            }
            c <- 1 {
            }
            else {
                // A ticker drops a tick when its one-slot channel is full.
            }
        }
    }
}

pub struct Ticker {
    pub c chan int
    pub stop chan int
}

pub fn new_ticker(d int) Ticker {
    ch := chan int{cap: 1}
    st := chan int{cap: 1}
    mut ns := d
    if ns < 1 {
        ns = 1
    }
    xu ticker_loop(ns, ch, st)
    << Ticker{c: ch, stop: st}
}

pub fn (t Ticker) stop() {
    select {
        t.stop <- 1 {
        }
        else {
        }
    }
}

// Location is a named UTC offset in seconds east of UTC, plus optional POSIX
// DST rules and TZif transition tables. IANA names are loaded from
// /usr/share/zoneinfo (Unix TZif v2 64-bit transitions + POSIX footer).
// No bundled tzdata; Windows has no zoneinfo path in v1.
pub struct Location {
    pub name string
    pub offset_sec int
    pub dst_offset_sec int
    pub has_dst int
    pub dst_sm int
    pub dst_sn int
    pub dst_sd int
    pub dst_st int
    pub dst_em int
    pub dst_en int
    pub dst_ed int
    pub dst_et int
    pub before_off int
    pub trans_sec []int
    pub trans_off []int
}

fn loc_std(name string, off int) Location {
    << Location{
        name: name + "",
        offset_sec: off,
        dst_offset_sec: off,
        has_dst: 0,
        dst_sm: 0,
        dst_sn: 0,
        dst_sd: 0,
        dst_st: 7200,
        dst_em: 0,
        dst_en: 0,
        dst_ed: 0,
        dst_et: 7200,
        before_off: off,
        trans_sec: []int{},
        trans_off: []int{}
    }
}

pub fn utc() Location {
    << loc_std("UTC", 0)
}

pub fn fixed_zone(name string, offset_sec int) Location {
    << loc_std(name, offset_sec)
}

fn loc_digit(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    << -1
}

fn parse_fixed_offset(rest string) int {
    if rest.len == 0 {
        << 0
    }
    mut i := 0
    mut sign := 1
    c0 := rest[0] & 255
    if c0 == 43 {
        i = 1
    } else if c0 == 45 {
        sign = 0 - 1
        i = 1
    } else {
        >> errors.new("time: unknown location")
    }
    if i >= rest.len {
        >> errors.new("time: unknown location")
    }
    d0 := loc_digit(rest[i] & 255)
    if d0 < 0 {
        >> errors.new("time: unknown location")
    }
    i = i + 1
    mut hh := d0
    if i < rest.len {
        d1 := loc_digit(rest[i] & 255)
        if d1 >= 0 {
            hh = hh * 10 + d1
            i = i + 1
        }
    }
    mut mm := 0
    if i < rest.len {
        if (rest[i] & 255) != 58 {
            >> errors.new("time: unknown location")
        }
        i = i + 1
        if i + 1 >= rest.len {
            >> errors.new("time: unknown location")
        }
        m0 := loc_digit(rest[i] & 255)
        m1 := loc_digit(rest[i + 1] & 255)
        if m0 < 0 || m1 < 0 {
            >> errors.new("time: unknown location")
        }
        mm = m0 * 10 + m1
        i = i + 2
    }
    if i != rest.len {
        >> errors.new("time: unknown location")
    }
    if hh > 23 || mm > 59 {
        >> errors.new("time: unknown location")
    }
    << sign * (hh * seconds_per_hour + mm * 60)
}

fn loc_prefix3(s string, a int, b int, c int) bool {
    if s.len < 3 {
        << false
    }
    << (s[0] & 255) == a && (s[1] & 255) == b && (s[2] & 255) == c
}

pub fn load_location(name string) Location {
    if name.len == 0 || name == "UTC" || name == "GMT" {
        << utc()
    }
    mut pref := 0
    if loc_prefix3(name, 85, 84, 67) {
        pref = 3
    } else if loc_prefix3(name, 71, 77, 84) {
        pref = 3
    }
    if pref == 3 {
        rest := name[pref:name.len] + ""
        if rest.len == 0 {
            << utc()
        }
        c0 := rest[0] & 255
        if c0 == 43 || c0 == 45 {
            off := parse_fixed_offset(rest) or >>
            << loc_std(name + "", off)
        }
    }
    << load_zoneinfo(name) or >>
}

fn civil_in(t Time, offset_sec int) Civil {
    << civil_utc(unix(t.sec + offset_sec, t.nsec))
}

pub fn (t Time) year_in(loc &Location) int {
    c := civil_in(t, loc_offset_at(loc, t.sec))
    << c.y
}

pub fn (t Time) month_in(loc &Location) int {
    c := civil_in(t, loc_offset_at(loc, t.sec))
    << c.mo
}

pub fn (t Time) day_in(loc &Location) int {
    c := civil_in(t, loc_offset_at(loc, t.sec))
    << c.day
}

pub fn (t Time) hour_in(loc &Location) int {
    c := civil_in(t, loc_offset_at(loc, t.sec))
    << c.hour
}

pub fn (t Time) minute_in(loc &Location) int {
    c := civil_in(t, loc_offset_at(loc, t.sec))
    << c.min
}

pub fn (t Time) second_in(loc &Location) int {
    c := civil_in(t, loc_offset_at(loc, t.sec))
    << c.sec
}

fn format_zone(offset_sec int) string {
    if offset_sec == 0 {
        << "Z"
    }
    mut off := offset_sec
    mut sign := "+"
    if off < 0 {
        sign = "-"
        off = 0 - off
    }
    hh := off / seconds_per_hour
    mm := (off % seconds_per_hour) / 60
    << sign + pad2(hh) + ":" + pad2(mm)
}

pub fn (t Time) format_rfc3339_in(loc &Location) string {
    off := loc_offset_at(loc, t.sec)
    c := civil_in(t, off)
    mut frac := ""
    if t.nsec != 0 {
        mut ns := t.nsec
        mut digits := ""
        mut k := 0
        mut p := 100000000
        while k < 9 {
            if p > 0 {
                digits = digits + str(ns / p)
                ns = ns % p
                p = p / 10
            }
            k = k + 1
        }
        frac = "." + digits
    }
    << str(c.y) + "-" + pad2(c.mo) + "-" + pad2(c.day) + "T" + pad2(c.hour) + ":" + pad2(c.min) + ":" + pad2(c.sec) + frac + format_zone(off)
}
