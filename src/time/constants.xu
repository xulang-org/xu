@time

// Nanoseconds in one second; durations and subsecond normalization use this scale.
const NS_PER_SECOND = 1000000000
// Nanoseconds in one millisecond.
const NS_PER_MILLISECOND = 1000000
// Nanoseconds in one microsecond.
const NS_PER_MICROSECOND = 1000
// Nanoseconds in one minute.
const NS_PER_MINUTE = 60000000000
// Nanoseconds in one hour.
const NS_PER_HOUR = 3600000000000
// Seconds in one calendar day for Unix date arithmetic.
const SECONDS_PER_DAY = 86400
// Seconds in one hour, including fixed-zone offsets.
const SECONDS_PER_HOUR = 3600
// Maximum transition entries accepted from a TZif file.
const TZIF_MAX_TRANSITIONS = 4096
// Maximum local-time types accepted from a TZif file.
const TZIF_MAX_LOCAL_TYPES = 256
