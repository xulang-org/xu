@time

#errors

const DURATION_MAX = 9223372036854775807
fn duration_min() int { << -9223372036854775807 - 1 }

// Duration is signed elapsed time, independent of calendars and wall clocks.
// Legacy int-based units, now/sleep/since and Timer/Ticker remain compatible.
pub struct Duration { ns int }
pub fn duration(ns int) Duration { << Duration{ns: ns} }
fn scaled_duration(value int,unit int) Duration {
    if unit <= 0 { >> errors.new("time: invalid duration unit") }
    if value > DURATION_MAX / unit || value < duration_min() / unit {
        >> errors.new("time: duration overflow")
    }
    << duration(value * unit)
}
pub fn microseconds(value int) Duration { << scaled_duration(value,NS_PER_MICROSECOND) or >> }
pub fn milliseconds(value int) Duration { << scaled_duration(value,NS_PER_MILLISECOND) or >> }
pub fn seconds(value int) Duration { << scaled_duration(value,NS_PER_SECOND) or >> }
pub fn minutes(value int) Duration { << scaled_duration(value,NS_PER_MINUTE) or >> }
pub fn hours(value int) Duration { << scaled_duration(value,NS_PER_HOUR) or >> }
pub fn (d Duration) nanoseconds() int { << d.ns }
pub fn (d Duration) milliseconds() int { << d.ns / NS_PER_MILLISECOND }
pub fn (d Duration) seconds() f64 { << f64(d.ns) / f64(NS_PER_SECOND) }
pub fn (d Duration) is_zero() bool { << d.ns == 0 }
pub fn (d Duration) is_negative() bool { << d.ns < 0 }
pub fn (d Duration) format() string { << format_duration(d.ns) }
pub fn parse_duration_value(value &string) Duration {
    ns := parse_duration(value) or >>
    << duration(ns)
}
fn checked_time_add(a int,b int) int {
    if (b > 0 && a > DURATION_MAX - b) || (b < 0 && a < duration_min() - b) {
        >> errors.new("time: duration overflow")
    }
    << a + b
}
pub fn (d Duration) add(other Duration) Duration {
    ns := checked_time_add(d.ns,other.ns) or >>
    << duration(ns)
}
pub fn (d Duration) sub(other Duration) Duration {
    if (other.ns > 0 && d.ns < duration_min() + other.ns) || (other.ns < 0 && d.ns > DURATION_MAX + other.ns) {
        >> errors.new("time: duration overflow")
    }
    << duration(d.ns - other.ns)
}
pub fn (d Duration) sleep() { sleep(d.ns) }
pub fn (d Duration) timer() Timer { << new_timer(d.ns) }
pub fn (d Duration) ticker() Ticker {
    if d.ns <= 0 { >> errors.new("time: ticker duration must be positive") }
    << new_ticker(d.ns)
}

// Instant is a process-local monotonic reading. It cannot be formatted as a
// date or interchanged with Time. Zero denotes an unset deadline in UI loops.
pub struct Instant { ns int }
pub fn zero_instant() Instant { << Instant{ns: 0} }
pub fn instant() Instant { << Instant{ns: now()} }
// Use for native monotonic event timestamps and deterministic clocks only.
pub fn instant_from_ns(ns int) Instant {
    if ns < 0 { >> errors.new("time: negative monotonic timestamp") }
    << Instant{ns: ns}
}
pub fn (t Instant) nanoseconds() int { << t.ns }
pub fn (t Instant) is_zero() bool { << t.ns == 0 }
pub fn (t Instant) before(other Instant) bool { << t.ns < other.ns }
pub fn (t Instant) after(other Instant) bool { << t.ns > other.ns }
pub fn (t Instant) equal(other Instant) bool { << t.ns == other.ns }
pub fn (t Instant) since(earlier Instant) Duration { << duration(t.ns - earlier.ns) }
pub fn (t Instant) elapsed() Duration { << instant().since(t) }
pub fn (t Instant) add(d Duration) Instant {
    ns := checked_time_add(t.ns,d.ns) or >>
    << instant_from_ns(ns) or >>
}
pub fn (t Time) add_duration(d Duration) Time {
    if t.nsec < 0 || t.nsec >= NS_PER_SECOND { >> errors.new("time: unnormalized Time") }
    mut sec := checked_time_add(t.sec,d.ns / NS_PER_SECOND) or >>
    mut ns := t.nsec + d.ns % NS_PER_SECOND
    if ns < 0 { sec = checked_time_add(sec,-1) or >>
        ns = ns + NS_PER_SECOND }
    else if ns >= NS_PER_SECOND { sec = checked_time_add(sec,1) or >>
        ns = ns - NS_PER_SECOND }
    << Time{sec: sec,nsec: ns}
}
pub fn (t Time) duration_since(earlier Time) Duration {
    if t.nsec < 0 || t.nsec >= NS_PER_SECOND || earlier.nsec < 0 || earlier.nsec >= NS_PER_SECOND {
        >> errors.new("time: unnormalized Time")
    }
    delta := duration(t.sec).sub(duration(earlier.sec)) or >>
    mut sec := delta.ns
    mut ns := t.nsec - earlier.nsec
    // Reduce before multiplying so the full signed Duration range is usable.
    if sec > 0 && ns < 0 { sec = sec - 1
        ns = ns + NS_PER_SECOND }
    else if sec < 0 && ns > 0 { sec = sec + 1
        ns = ns - NS_PER_SECOND }
    whole := scaled_duration(sec,NS_PER_SECOND) or >>
    << whole.add(duration(ns)) or >>
}
