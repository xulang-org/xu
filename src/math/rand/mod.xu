@math/rand

// Deterministic pseudo-random numbers aligned with Go `math/rand`
// (Source + Int63/Seed, Intn with rejection sampling, Float64). No
// global state: Go's top-level Intn uses a package-global source, which
// Xu forbids (no mutable globals, memory-safety rule); every Source is
// an explicit owning instance. xorshift64* — a well-tested linear
// feedback generator; all arithmetic is plain i64 wrapping (identical
// bit patterns on every backend). Intn uses rejection sampling so small
// bounds have no modulo bias. B3b adds Int31, Perm, and Shuffle([]int).

const m63 = 9223372036854775807

pub struct Source {
    pub state int
}

pub fn new_source(seed int) Source {
    if seed == 0 {
        << Source{state: 1}
    }
    << Source{state: seed}
}

pub fn (s &mut Source) seed(seed int) {
    if seed == 0 {
        s.state = 1
    } else {
        s.state = seed
    }
}

fn (s &mut Source) next() int {
    mut x := s.state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    s.state = x
    << x
}

pub fn (s &mut Source) int63() int {
    << s.next() & m63
}

pub fn (s &mut Source) intn(n int) int {
    if n <= 0 {
        eprintln("math/rand: invalid bound")
        <<< 1
    }
    limit := m63 - (m63 % n)
    mut v := 0
    mut ok := 0
    while ok == 0 {
        v = s.next() & m63
        if v < limit {
            ok = 1
        }
    }
    << v % n
}

pub fn (s &mut Source) float64() f64 {
    << f64(s.next() & m63) / 9223372036854775808.0
}

pub fn (s &mut Source) int31() int {
    << s.int63() >> 32
}

pub fn (s &mut Source) perm(n int) []int {
    if n < 0 {
        eprintln("math/rand: negative argument to perm")
        <<< 1
    }
    mut m := []int{}
    mut i := 0
    while i < n {
        j := s.intn(i + 1)
        if j == i {
            m.push(i)
        } else {
            t := m[j]
            m.push(t)
            m[j] = i
        }
        i = i + 1
    }
    << m
}

pub fn (s &mut Source) shuffle(a &mut []int) {
    mut i := a.len
    while i > 1 {
        i = i - 1
        j := s.intn(i + 1)
        t := a[i]
        a[i] = a[j]
        a[j] = t
    }
}
