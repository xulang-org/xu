@math

core #runtime/core

const F64_FRACTION = 4503599627370495
const F64_HIDDEN = 4503599627370496
const F32_FRACTION = 8388607
const F32_HIDDEN = 8388608

// Binary64 bit reinterpretation, not a numeric cast. Xu int carries all 64
// bits, including sign; zero signs and all NaN payload bits are preserved.
pub fn float64_bits(value f64) int { << core.float64_bits(value) }
pub fn float64_from_bits(bits int) f64 { << core.float64_from_bits(bits) }

// value is a positive binary64 significand, shift is in 29...53. Integer
// rounding makes binary32 conversion independent of the host FPU's mode.
fn round_shift_even(value int, shift int) int {
    truncated := value >> shift
    remainder := value & ((1 << shift) - 1)
    halfway := 1 << (shift - 1)
    if remainder > halfway || (remainder == halfway && (truncated & 1) != 0) { << truncated + 1 }
    << truncated
}

// Xu numeric floats are binary64. Convert to a binary32 bit pattern in the
// low 32 bits of int, round-to-nearest/ties-to-even, with gradual underflow.
// Overflow yields signed infinity. NaNs retain sign/high payload and become
// quiet; no floating-point arithmetic is used to inspect the input.
pub fn float32_bits(value f64) int {
    bits := float64_bits(value)
    sign := (bits >> 32) & 2147483648
    exponent := (bits >> 52) & 2047
    fraction := bits & F64_FRACTION
    if exponent == 2047 {
        if fraction == 0 { << sign | 2139095040 }
        << sign | 2143289344 | (fraction >> 29)
    }
    if exponent > 1150 { << sign | 2139095040 }
    if exponent < 873 { << sign }
    significand := fraction | F64_HIDDEN
    if exponent < 897 {
        // Rounding up to 2^23 naturally produces the smallest normal value.
        << sign | round_shift_even(significand, 926 - exponent)
    }
    $mantissa := round_shift_even(significand, 29)
    $encoded_exponent := exponent - 896
    if mantissa == 16777216 {
        mantissa = mantissa >> 1
        encoded_exponent += 1
    }
    if encoded_exponent >= 255 { << sign | 2139095040 }
    << sign | (encoded_exponent << 23) | (mantissa & F32_FRACTION)
}

// Interpret the low 32 bits as binary32 and expand exactly to Xu binary64.
// Zero signs, infinities and the complete binary32 NaN payload/signaling bit
// are preserved in their binary64 positions. Arithmetic on NaNs may quiet them.
pub fn float32_from_bits(bits int) f64 {
    sign := (bits & 2147483648) << 32
    exponent := (bits >> 23) & 255
    fraction := bits & F32_FRACTION
    if exponent == 255 { << float64_from_bits(sign | (2047 << 52) | (fraction << 29)) }
    if exponent > 0 { << float64_from_bits(sign | ((exponent + 896) << 52) | (fraction << 29)) }
    if fraction == 0 { << float64_from_bits(sign) }
    $mantissa := fraction
    $unbiased := 0 - 126
    // A nonzero 23-bit subnormal needs at most 23 shifts to normalize.
    while mantissa < F32_HIDDEN {
        mantissa = mantissa << 1
        unbiased -= 1
    }
    << float64_from_bits(sign | ((unbiased + 1023) << 52) | ((mantissa - F32_HIDDEN) << 29))
}
