@math/bits


#errors
// Go `math/bits` over the u64 lanes carried in i64 (two's-complement
// wrapping, identical bit patterns on every backend). Every place that
// would be a logical right shift on a uint64 is written as an arithmetic
// shift plus an explicit mask (`(x >> n) & ((1 << (64-n)) - 1)`, the
// sha512 idiom), so negative inputs never leak sign bits. All high-bit
// constants are hex literals: `1 << 63` wraps to INT64_MIN, so the
// values are spelled out (0x8000… etc.) rather than computed by shifting
// a possibly-negative value. Zero-value semantics match Go: Len(0)=0,
// LeadingZeros(0)=64, TrailingZeros(0)=64, OnesCount(0)=0.
// These Xu bodies are the semantic implementation on every target. Hosted
// compilers may lower the exact canonical leading_zeros / trailing_zeros /
// reverse calls to the matching scalar instruction (CLZ/CTZ/RBIT) when the
// backend has one; other targets and any non-canonical call keep this body.

const m0 = 0x5555555555555555
const m1 = 0x3333333333333333
const m2 = 0x0f0f0f0f0f0f0f0f
const m3 = 0x00ff00ff00ff00ff
const m4 = 0x0000ffff0000ffff
const m5 = 0x00000000ffffffff

// len: minimum number of bits needed to represent x (0 for x == 0).
// Equal to 64 - leading_zeros(x), matching Go `bits.Len64`.
pub fn len(x int) int {
    << 64 - leading_zeros(x)
}

// leading_zeros: number of zero bits before the highest set bit. Binary
// search: each `(v >> n) == 0` test is sign-agnostic (arithmetic shift
// yields 0 iff the top n bits are all zero, since the sign bit is in
// that window), then the low bits are shifted up.
pub fn leading_zeros(x int) int {
    if x == 0 {
        << 64
    }
    mut n := 0
    mut v := x
    if (v >> 32) == 0 {
        n = n + 32
        v = v << 32
    }
    if (v >> 48) == 0 {
        n = n + 16
        v = v << 16
    }
    if (v >> 56) == 0 {
        n = n + 8
        v = v << 8
    }
    if (v >> 60) == 0 {
        n = n + 4
        v = v << 4
    }
    if (v >> 62) == 0 {
        n = n + 2
        v = v << 2
    }
    if (v >> 63) == 0 {
        n = n + 1
    }
    << n
}

// trailing_zeros: number of zero bits after the lowest set bit. Binary
// search on the low bits; the arithmetic right shifts are safe because
// only the low (64-n) bits of the result are ever inspected, and those
// are identical for arithmetic and logical shifts.
pub fn trailing_zeros(x int) int {
    if x == 0 {
        << 64
    }
    mut n := 0
    mut v := x
    if (v & 0xffffffff) == 0 {
        n = n + 32
        v = v >> 32
    }
    if (v & 0xffff) == 0 {
        n = n + 16
        v = v >> 16
    }
    if (v & 0xff) == 0 {
        n = n + 8
        v = v >> 8
    }
    if (v & 0xf) == 0 {
        n = n + 4
        v = v >> 4
    }
    if (v & 0x3) == 0 {
        n = n + 2
        v = v >> 2
    }
    if (v & 0x1) == 0 {
        n = n + 1
    }
    << n
}

// ones_count: population count via SWAR parallel summing of adjacent
// bits (Go `bits.OnesCount64`, from "Hacker's Delight" ch. 5). The three
// mask constants m0/m1/m2 zero the sign-extension bits after the
// arithmetic shifts, and after the `& m2` step the value is non-negative
// so the trailing `+ (v >> n)` folds are plain logical shifts.
pub fn ones_count(x int) int {
    mut v := x
    v = ((v >> 1) & m0) + (v & m0)
    v = ((v >> 2) & m1) + (v & m1)
    v = ((v >> 4) + v) & m2
    v = v + (v >> 8)
    v = v + (v >> 16)
    v = v + (v >> 32)
    << v & 127
}

// rotate_left: k is reduced mod 64 (Go `bits.RotateLeft64`). The low part
// is a logical right shift by (64-s) masked to s bits; s == 0 is handled
// separately so no shift-by-64 is ever emitted.
pub fn rotate_left(x int, k int) int {
    s := k & 63
    if s == 0 {
        << x
    }
    << (x << s) | ((x >> (64 - s)) & ((1 << s) - 1))
}

// rotate_right: Go `bits.RotateRight64` (k mod 64). The low part is a
// logical right shift by s masked to (64-s) bits; the high part moves the
// low s bits to the top.
pub fn rotate_right(x int, k int) int {
    s := k & 63
    if s == 0 {
        << x
    }
    << ((x >> s) & ((1 << (64 - s)) - 1)) | (x << (64 - s))
}

// reverse: full bit reversal (Go `bits.Reverse64`). 5-stage mask swap
// over the bit-swap masks m0/m1/m2 then the byte-swap masks m3/m4/m5;
// each `(v >> n) & mask` zeroes the sign extension.
pub fn reverse(x int) int {
    mut v := x
    v = ((v >> 1) & m0) | ((v & m0) << 1)
    v = ((v >> 2) & m1) | ((v & m1) << 2)
    v = ((v >> 4) & m2) | ((v & m2) << 4)
    << reverse_bytes(v)
}

// reverse_bytes: byte-order reversal (Go `bits.ReverseBytes64`).
pub fn reverse_bytes(x int) int {
    mut v := x
    v = ((v >> 8) & m3) | ((v & m3) << 8)
    v = ((v >> 16) & m4) | ((v & m4) << 16)
    << ((v >> 32) & m5) | ((v & m5) << 32)
}

pub struct Carry {
    pub lo int
    pub carry int
}

pub fn add64(x int, y int, carry_in int) Carry {
    s1 := x + y
    s := s1 + (carry_in & 1)
    nots := s ^ (0 - 1)
    c := ((x & y) | ((x | y) & nots)) >> 63
    mut carry := 0
    if c != 0 {
        carry = 1
    }
    << Carry{lo: s, carry: carry}
}

pub fn sub64(x int, y int, borrow_in int) Carry {
    d1 := x - y
    d := d1 - (borrow_in & 1)
    notx := x ^ (0 - 1)
    b := ((notx & y) | ((notx | y) & d)) >> 63
    mut borrow := 0
    if b != 0 {
        borrow = 1
    }
    << Carry{lo: d, carry: borrow}
}

fn mul64_hi(x int, y int) int {
    mask32 := 4294967295
    x0 := x & mask32
    x1 := (x >> 32) & mask32
    y0 := y & mask32
    y1 := (y >> 32) & mask32
    w0 := x0 * y0
    t := x1 * y0 + (w0 >> 32)
    mut w1 := t & mask32
    w2 := t >> 32
    w1 = w1 + x0 * y1
    << x1 * y1 + w2 + (w1 >> 32)
}

pub fn mul64(x int, y int) Carry {
    << Carry{lo: x * y, carry: mul64_hi(x, y)}
}

pub fn div64(hi int, lo int, y int) Carry {
    if y == 0 {
        >> errors.new("math/bits: division by zero")
    }
    _ := hi
    << Carry{lo: lo / y, carry: lo % y}
}

pub fn len32(x int) int {
    << 32 - leading_zeros32(x)
}

pub fn leading_zeros32(x int) int {
    v := x & 4294967295
    if v == 0 {
        << 32
    }
    << leading_zeros(v) - 32
}

pub fn trailing_zeros32(x int) int {
    v := x & 4294967295
    if v == 0 {
        << 32
    }
    << trailing_zeros(v)
}

pub fn ones_count32(x int) int {
    << ones_count(x & 4294967295)
}

pub fn ones_count16(x int) int {
    << ones_count(x & 65535)
}

pub fn ones_count8(x int) int {
    << ones_count(x & 255)
}

pub fn trailing_zeros16(x int) int {
    v := x & 65535
    if v == 0 {
        << 16
    }
    << trailing_zeros(v)
}

pub fn trailing_zeros8(x int) int {
    v := x & 255
    if v == 0 {
        << 8
    }
    << trailing_zeros(v)
}

pub fn len16(x int) int {
    v := x & 65535
    if v == 0 {
        << 0
    }
    << 16 - (leading_zeros(v) - 48)
}

pub fn len8(x int) int {
    v := x & 255
    if v == 0 {
        << 0
    }
    << 8 - (leading_zeros(v) - 56)
}

pub fn leading_zeros16(x int) int {
    v := x & 65535
    if v == 0 {
        << 16
    }
    << leading_zeros(v) - 48
}

pub fn leading_zeros8(x int) int {
    v := x & 255
    if v == 0 {
        << 8
    }
    << leading_zeros(v) - 56
}

pub fn reverse16(x int) int {
    << (reverse(x & 65535) >> 48) & 65535
}

pub fn reverse8(x int) int {
    << (reverse(x & 255) >> 56) & 255
}

pub fn reverse_bytes16(x int) int {
    v := x & 65535
    << ((v >> 8) & 255) | ((v & 255) << 8)
}

pub fn reverse_bytes8(x int) int {
    << x & 255
}

pub fn rotate_left16(x int, k int) int {
    v := x & 65535
    s := k & 15
    if s == 0 {
        << v
    }
    << ((v << s) | (v >> (16 - s))) & 65535
}

pub fn rotate_left8(x int, k int) int {
    v := x & 255
    s := k & 7
    if s == 0 {
        << v
    }
    << ((v << s) | (v >> (8 - s))) & 255
}

pub fn rotate_right16(x int, k int) int {
    << rotate_left16(x, 0 - k)
}

pub fn rotate_right8(x int, k int) int {
    << rotate_left8(x, 0 - k)
}
