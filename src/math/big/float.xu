@math/big

#errors
#math
#strconv

// Go `math/big.Float` subset. A finite value is ±mant·2^exp with `prec`
// significant bits (default 53, max 4096). Also +Inf/-Inf/NaN.
// Rounding: to_zero (default), to_nearest_even, to_neg_inf, to_pos_inf,
// away_from_zero. Methods mutate the receiver like Int.

pub const TO_ZERO = 0
pub const TO_NEAREST_EVEN = 1
pub const TO_NEG_INF = 2
pub const TO_POS_INF = 3
pub const AWAY_FROM_ZERO = 4

const FORM_FINITE = 0
const FORM_INF = 1
const FORM_NAN = 2

pub struct Float {
    pub prec int
    pub neg bool
    pub mant Int
    pub exp int
    pub form int
    pub mode int
}

pub fn new_float() Float {
    << Float{prec: 53, neg: false, mant: new_int(0), exp: 0, form: 0, mode: 0}
}

fn f_cap_prec(p int) int {
    if p < 1 {
        << 1
    }
    if p > 4096 {
        << 4096
    }
    << p
}

fn f_zero(z $&Float) {
    z.form = FORM_FINITE
    z.neg = false
    mm := $&z.mant
    mm.set_int64(0)
    z.exp = 0
}

fn f_set_inf(z $&Float, neg bool) {
    z.form = FORM_INF
    z.neg = neg
    mm := $&z.mant
    mm.set_int64(0)
    z.exp = 0
}

fn f_set_nan(z $&Float) {
    z.form = FORM_NAN
    z.neg = false
    mm := $&z.mant
    mm.set_int64(0)
    z.exp = 0
}

fn f_round_up(m $&Int) {
    $one := new_int(1)
    $src := new_int(0)
    src.neg = m.neg
    src.abs = nat_clone(&m.abs)
    m.add(&src, &one)
}

fn f_any_below(m &Int, s int) int {
    $k := 0
    while k < s {
        if m.bit(k) != 0 {
            << 1
        }
        k = k + 1
    }
    << 0
}

fn f_norm(z $&Float) {
    if z.form != FORM_FINITE {
        <<
    }
    if z.prec < 1 {
        z.prec = 53
    }
    if z.mant.sign() == 0 {
        f_zero(z)
        <<
    }
    bl := z.mant.bit_len()
    if bl > z.prec {
        $s := bl - z.prec
        $m := int_copy(&z.mant)
        if s > 0 && z.mode == TO_NEAREST_EVEN {
            rb := m.bit(s - 1)
            $sticky := 0
            $k := 0
            while k < s - 1 {
                if m.bit(k) != 0 {
                    sticky = 1
                }
                k = k + 1
            }
            m.rsh(&m, s)
            lsb := m.bit(0)
            if rb != 0 {
                if sticky != 0 || lsb != 0 {
                    f_round_up($&m)
                }
            }
        } else if s > 0 && z.mode == AWAY_FROM_ZERO {
            lost := f_any_below(&m, s)
            m.rsh(&m, s)
            if lost != 0 {
                f_round_up($&m)
            }
        } else if s > 0 && z.mode == TO_POS_INF {
            lost := f_any_below(&m, s)
            m.rsh(&m, s)
            if lost != 0 && !z.neg {
                f_round_up($&m)
            }
        } else if s > 0 && z.mode == TO_NEG_INF {
            lost := f_any_below(&m, s)
            m.rsh(&m, s)
            if lost != 0 && z.neg {
                f_round_up($&m)
            }
        } else {
            m.rsh(&m, s)
        }
        if m.bit_len() > z.prec {
            m.rsh(&m, 1)
            s = s + 1
        }
        mm := $&z.mant
        mm.set(&m)
        z.exp = z.exp + s
    }
}

pub fn (z $&Float) set_prec(p int) {
    z.prec = f_cap_prec(p)
    f_norm(z)
}

pub fn (z &Float) precision() int {
    << z.prec
}

pub fn (z $&Float) set_mode(m int) {
    if m == TO_NEAREST_EVEN || m == TO_NEG_INF || m == TO_POS_INF || m == AWAY_FROM_ZERO {
        z.mode = m
    } else {
        z.mode = TO_ZERO
    }
}

pub fn (z &Float) rounding() int {
    << z.mode
}

pub fn (z $&Float) set_inf(neg bool) {
    f_set_inf(z, neg)
}

pub fn (z $&Float) set_nan() {
    f_set_nan(z)
}

pub fn (z &Float) is_inf() bool {
    << z.form == FORM_INF
}

pub fn (z &Float) is_nan() bool {
    << z.form == FORM_NAN
}

pub fn (z $&Float) set(x &Float) {
    z.prec = x.prec
    z.neg = x.neg
    mm := $&z.mant
    mm.set(&x.mant)
    z.exp = x.exp
    z.form = x.form
    z.mode = x.mode
}

pub fn (z $&Float) set_int64(x int) {
    if z.prec < 1 {
        z.prec = 53
    }
    z.form = FORM_FINITE
    $tmp := new_int(x)
    z.neg = tmp.neg
    tmp.neg = false
    mm := $&z.mant
    mm.set(&tmp)
    z.exp = 0
    f_norm(z)
}

pub fn (z $&Float) set_int(x &Int) {
    if z.prec < 1 {
        z.prec = 53
    }
    z.form = FORM_FINITE
    $tmp := int_copy(x)
    z.neg = tmp.neg
    tmp.neg = false
    mm := $&z.mant
    mm.set(&tmp)
    z.exp = 0
    f_norm(z)
}

fn float_limbs_i64(abs &[]int, neg bool) int {
    $v := 0
    $i := abs.len
    while i > 0 {
        i = i - 1
        v = (v << W) | abs[i]
    }
    if neg {
        << 0 - v
    }
    << v
}

pub fn (z &Float) to_int64() int {
    if z.form != FORM_FINITE {
        >> errors.new("math/big: not finite")
    }
    $m := int_copy(&z.mant)
    if z.exp > 0 {
        $src := int_copy(&m)
        m.lsh(&src, z.exp)
    } else if z.exp < 0 {
        sh := 0 - z.exp
        $one := new_int(1)
        $den := new_int(0)
        den.lsh(&one, sh)
        $q := new_int(0)
        q.quo(&m, &den) or >>
        m.set(&q)
    }
    << float_limbs_i64(&m.abs, z.neg)
}

pub fn (z &Float) signbit() bool {
    << z.neg
}

pub fn (z &Float) unbiased_exp() int {
    if z.form != FORM_FINITE || z.mant.sign() == 0 {
        << 0
    }
    << z.mant.bit_len() + z.exp
}

pub fn (z &Float) mantissa() Float {
    $m := new_float()
    m.set(z)
    if z.form == FORM_FINITE && z.mant.sign() != 0 {
        e := z.mant.bit_len() + z.exp
        m.exp = z.exp - e
    }
    << m
}

pub fn (z $&Float) set_mant_exp(mant &Float, exp int) {
    z.set(mant)
    if z.form == FORM_FINITE {
        z.exp = z.exp + exp
        f_norm(z)
    }
}

pub fn (z &Float) sign() int {
    if z.form == FORM_NAN {
        << 0
    }
    if z.form == FORM_INF {
        if z.neg {
            << 0 - 1
        }
        << 1
    }
    if z.mant.sign() == 0 {
        << 0
    }
    if z.neg {
        << 0 - 1
    }
    << 1
}

pub fn (z &Float) cmp(y &Float) int {
    if z.form == FORM_NAN || y.form == FORM_NAN {
        >> errors.new("math/big: NaN")
    }
    sz := z.sign()
    sy := y.sign()
    if sz < sy {
        << 0 - 1
    }
    if sz > sy {
        << 1
    }
    if sz == 0 {
        << 0
    }
    $xm := int_copy(&z.mant)
    $ym := int_copy(&y.mant)
    if z.exp > y.exp {
        d := z.exp - y.exp
        $t := int_copy(&ym)
        t.lsh(&ym, d)
        ym.set(&t)
    } else if y.exp > z.exp {
        d := y.exp - z.exp
        $t := int_copy(&xm)
        t.lsh(&xm, d)
        xm.set(&t)
    }
    c := xm.cmp(&ym)
    if z.neg {
        << 0 - c
    }
    << c
}

pub fn (z $&Float) add(x &Float, y &Float) {
    z.prec = x.prec
    if y.prec > z.prec {
        z.prec = y.prec
    }
    z.mode = x.mode
    if x.form == FORM_NAN || y.form == FORM_NAN {
        f_set_nan(z)
        <<
    }
    if x.form == FORM_INF && y.form == FORM_INF {
        if x.neg != y.neg {
            f_set_nan(z)
            <<
        }
        f_set_inf(z, x.neg)
        <<
    }
    if x.form == FORM_INF {
        f_set_inf(z, x.neg)
        <<
    }
    if y.form == FORM_INF {
        f_set_inf(z, y.neg)
        <<
    }
    if x.mant.sign() == 0 {
        z.set(y)
        z.prec = f_cap_prec(z.prec)
        <<
    }
    if y.mant.sign() == 0 {
        z.set(x)
        z.prec = f_cap_prec(z.prec)
        <<
    }
    $xm := int_copy(&x.mant)
    $ym := int_copy(&y.mant)
    $e := x.exp
    if x.exp > y.exp {
        d := x.exp - y.exp
        $t := int_copy(&ym)
        t.lsh(&ym, d)
        ym.set(&t)
        e = x.exp
    } else if y.exp > x.exp {
        d := y.exp - x.exp
        $t := int_copy(&xm)
        t.lsh(&xm, d)
        xm.set(&t)
        e = y.exp
    }
    xm.neg = x.neg
    ym.neg = y.neg
    $s := new_int(0)
    s.add(&xm, &ym)
    z.neg = s.neg
    s.neg = false
    mm := $&z.mant
    mm.set(&s)
    z.exp = e
    f_norm(z)
}

pub fn (z $&Float) sub(x &Float, y &Float) {
    $ny := Float{prec: y.prec, neg: !y.neg, mant: int_copy(&y.mant), exp: y.exp, form: y.form, mode: y.mode}
    if y.form == FORM_FINITE && y.mant.sign() == 0 {
        ny.neg = false
    }
    z.add(x, &ny)
}

pub fn (z $&Float) mul(x &Float, y &Float) {
    z.prec = x.prec
    if y.prec > z.prec {
        z.prec = y.prec
    }
    z.mode = x.mode
    if x.form == FORM_NAN || y.form == FORM_NAN {
        f_set_nan(z)
        <<
    }
    xs := x.sign()
    ys := y.sign()
    if x.form == FORM_INF || y.form == FORM_INF {
        if xs == 0 || ys == 0 {
            f_set_nan(z)
            <<
        }
        f_set_inf(z, x.neg != y.neg)
        <<
    }
    if x.mant.sign() == 0 || y.mant.sign() == 0 {
        f_zero(z)
        <<
    }
    z.neg = x.neg != y.neg
    $m := new_int(0)
    m.mul(&x.mant, &y.mant)
    mm := $&z.mant
    mm.set(&m)
    z.exp = x.exp + y.exp
    f_norm(z)
}

pub fn (z $&Float) quo(x &Float, y &Float) int {
    z.prec = x.prec
    if y.prec > z.prec {
        z.prec = y.prec
    }
    z.mode = x.mode
    if x.form == FORM_NAN || y.form == FORM_NAN {
        f_set_nan(z)
        << 0
    }
    xs := x.sign()
    ys := y.sign()
    if x.form == FORM_INF && y.form == FORM_INF {
        f_set_nan(z)
        << 0
    }
    if y.form == FORM_FINITE && y.mant.sign() == 0 {
        if xs == 0 {
            f_set_nan(z)
            << 0
        }
        f_set_inf(z, x.neg != y.neg)
        << 0
    }
    if x.form == FORM_INF {
        f_set_inf(z, x.neg != y.neg)
        << 0
    }
    if y.form == FORM_INF {
        f_zero(z)
        z.neg = x.neg != y.neg
        << 0
    }
    if x.mant.sign() == 0 {
        f_zero(z)
        << 0
    }
    extra := z.prec + 8
    $mx := int_copy(&x.mant)
    $t := int_copy(&mx)
    t.lsh(&mx, extra)
    mx.set(&t)
    $q := new_int(0)
    q.quo(&mx, &y.mant) or >>
    z.neg = x.neg != y.neg
    mm := $&z.mant
    mm.set(&q)
    z.exp = x.exp - y.exp - extra
    f_norm(z)
    << 0
}

fn f_trim_frac(s string) string {
    $end := s.len
    while end > 0 {
        if (s[end - 1] & 255) != 48 {
            <-
        }
        end = end - 1
    }
    if end == 0 {
        << ""
    }
    << s[0:end] + ""
}

pub fn (z &Float) text() string {
    if z.form == FORM_NAN {
        << "NaN"
    }
    if z.form == FORM_INF {
        if z.neg {
            << "-Inf"
        }
        << "+Inf"
    }
    if z.mant.sign() == 0 {
        << "0"
    }
    $m := int_copy(&z.mant)
    $ip := ""
    $frac := ""
    if z.exp >= 0 {
        $t := int_copy(&m)
        t.lsh(&m, z.exp)
        m.set(&t)
        ip = m.text()
    } else {
        sh := 0 - z.exp
        $den := new_int(1)
        $one := new_int(1)
        den.lsh(&one, sh)
        $q := new_int(0)
        q.quo(&m, &den) or (err) {
            << "0"
        }
        $r := new_int(0)
        r.rem(&m, &den) or (err) {
            << "0"
        }
        ip = q.text()
        $k := 0
        $ten := new_int(10)
        while k < 20 {
            if r.sign() == 0 {
                <-
            }
            $rr := int_copy(&r)
            r.mul(&rr, &ten)
            $d := new_int(0)
            d.quo(&r, &den) or (err) {
                <-
            }
            $nx := new_int(0)
            nx.rem(&r, &den) or (err) {
                <-
            }
            r.set(&nx)
            frac = frac + d.text()
            k = k + 1
        }
        frac = f_trim_frac(frac)
    }
    $out := ip + ""
    if frac.len > 0 {
        out = out + "." + frac
    }
    if z.neg {
        << "-" + out
    }
    << out
}

fn f_eq_ci(s &string, start int, lit string) bool {
    if start + lit.len > s.len {
        << false
    }
    $i := 0
    while i < lit.len {
        $a := s[start + i] & 255
        $b := lit[i] & 255
        if a >= 65 && a <= 90 {
            a = a + 32
        }
        if b >= 65 && b <= 90 {
            b = b + 32
        }
        if a != b {
            << false
        }
        i = i + 1
    }
    << true
}

fn f_pow10(n int) Int {
    $p := new_int(1)
    $ten := new_int(10)
    $i := 0
    while i < n {
        $t := int_copy(&p)
        p.mul(&t, &ten)
        i = i + 1
    }
    << p
}

pub fn (z $&Float) set_string(s string) int {
    src := s + ""
    $i := 0
    while i < src.len {
        c := src[i] & 255
        if c != 32 && c != 9 {
            <-
        }
        i = i + 1
    }
    if i >= src.len {
        >> errors.new("math/big: invalid number")
    }
    if f_eq_ci(&src, i, "nan") {
        f_set_nan(z)
        << 0
    }
    $neg := false
    c0 := src[i] & 255
    if c0 == 43 || c0 == 45 {
        neg = c0 == 45
        i = i + 1
    }
    if i >= src.len {
        >> errors.new("math/big: invalid number")
    }
    if f_eq_ci(&src, i, "inf") {
        f_set_inf(z, neg)
        << 0
    }
    $digits := new_int(0)
    $ten := new_int(10)
    $saw := 0
    $frac := 0
    $in_frac := 0
    while i < src.len {
        c := src[i]
        if c == 46 {
            if in_frac != 0 {
                >> errors.new("math/big: invalid number")
            }
            in_frac = 1
            i = i + 1
        } else {
            if c < 48 || c > 57 {
                <-
            }
            $t := int_copy(&digits)
            digits.mul(&t, &ten)
            $d := new_int(c - 48)
            t = int_copy(&digits)
            digits.add(&t, &d)
            saw = 1
            if in_frac != 0 {
                frac = frac + 1
            }
            i = i + 1
        }
    }
    if saw == 0 {
        >> errors.new("math/big: invalid number")
    }
    $exp10 := 0
    if i < src.len {
        e := src[i] & 255
        if e == 101 || e == 69 {
            i = i + 1
            $es := 1
            if i < src.len {
                sg := src[i] & 255
                if sg == 43 || sg == 45 {
                    if sg == 45 {
                        es = 0 - 1
                    }
                    i = i + 1
                }
            }
            $ev := 0
            $ed := 0
            while i < src.len {
                c := src[i] & 255
                if c < 48 || c > 57 {
                    <-
                }
                ev = ev * 10 + (c - 48)
                ed = 1
                i = i + 1
            }
            if ed == 0 {
                >> errors.new("math/big: invalid number")
            }
            exp10 = es * ev
        }
    }
    if i != src.len {
        >> errors.new("math/big: invalid number")
    }
    z.form = FORM_FINITE
    z.neg = neg
    ten_exp := exp10 - frac
    if z.prec < 1 {
        z.prec = 53
    }
    if ten_exp >= 0 {
        p := f_pow10(ten_exp)
        $m := new_int(0)
        m.mul(&digits, &p)
        mm := $&z.mant
        mm.set(&m)
        z.exp = 0
        f_norm(z)
        << 0
    }
    extra := z.prec + 16
    $mx := int_copy(&digits)
    $sh := int_copy(&mx)
    sh.lsh(&mx, extra)
    mx.set(&sh)
    den := f_pow10(0 - ten_exp)
    $q := new_int(0)
    q.quo(&mx, &den) or >>
    mm2 := $&z.mant
    mm2.set(&q)
    z.exp = 0 - extra
    f_norm(z)
    << 0
}

pub fn (z $&Float) set_float64(x f64) int {
    if math.is_nan(x) {
        f_set_nan(z)
        << 0
    }
    if math.is_inf(x) {
        f_set_inf(z, x < 0.0)
        << 0
    }
    t := strconv.format_float(x, 103, 0 - 1) or >>
    << z.set_string(t) or >>
}
