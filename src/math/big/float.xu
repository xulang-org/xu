@math/big

#errors
#math
#strconv

// Go `math/big.Float` subset. A finite value is ±mant·2^exp with `prec`
// significant bits (default 53, max 4096). Also +Inf/-Inf/NaN.
// Rounding: to_zero (default), to_nearest_even, to_neg_inf, to_pos_inf,
// away_from_zero. Methods mutate the receiver like Int.

pub const to_zero = 0
pub const to_nearest_even = 1
pub const to_neg_inf = 2
pub const to_pos_inf = 3
pub const away_from_zero = 4

const form_finite = 0
const form_inf = 1
const form_nan = 2

pub struct Float {
    pub prec int
    pub neg bool
    pub mant Int
    pub exp int
    pub form int
    pub mode int
}

pub fn new_float() Float {
    << Float{prec: 53, neg: false, mant: new_int(0), exp: 0, form: 0, mode: 0}
}

fn f_cap_prec(p int) int {
    if p < 1 {
        << 1
    }
    if p > 4096 {
        << 4096
    }
    << p
}

fn f_zero(z &mut Float) {
    z.form = form_finite
    z.neg = false
    mm := mut &z.mant
    mm.set_int64(0)
    z.exp = 0
}

fn f_set_inf(z &mut Float, neg bool) {
    z.form = form_inf
    z.neg = neg
    mm := mut &z.mant
    mm.set_int64(0)
    z.exp = 0
}

fn f_set_nan(z &mut Float) {
    z.form = form_nan
    z.neg = false
    mm := mut &z.mant
    mm.set_int64(0)
    z.exp = 0
}

fn f_round_up(m &mut Int) {
    mut one := new_int(1)
    mut src := new_int(0)
    src.neg = m.neg
    src.abs = nat_clone(&m.abs)
    m.add(&src, &one)
}

fn f_any_below(m &Int, s int) int {
    mut k := 0
    while k < s {
        if m.bit(k) != 0 {
            << 1
        }
        k = k + 1
    }
    << 0
}

fn f_norm(z &mut Float) {
    if z.form != form_finite {
        <<
    }
    if z.prec < 1 {
        z.prec = 53
    }
    if z.mant.sign() == 0 {
        f_zero(z)
        <<
    }
    bl := z.mant.bit_len()
    if bl > z.prec {
        mut s := bl - z.prec
        mut m := int_copy(&z.mant)
        if s > 0 && z.mode == to_nearest_even {
            rb := m.bit(s - 1)
            mut sticky := 0
            mut k := 0
            while k < s - 1 {
                if m.bit(k) != 0 {
                    sticky = 1
                }
                k = k + 1
            }
            m.rsh(&m, s)
            lsb := m.bit(0)
            if rb != 0 {
                if sticky != 0 || lsb != 0 {
                    f_round_up(mut &m)
                }
            }
        } else if s > 0 && z.mode == away_from_zero {
            lost := f_any_below(&m, s)
            m.rsh(&m, s)
            if lost != 0 {
                f_round_up(mut &m)
            }
        } else if s > 0 && z.mode == to_pos_inf {
            lost := f_any_below(&m, s)
            m.rsh(&m, s)
            if lost != 0 && !z.neg {
                f_round_up(mut &m)
            }
        } else if s > 0 && z.mode == to_neg_inf {
            lost := f_any_below(&m, s)
            m.rsh(&m, s)
            if lost != 0 && z.neg {
                f_round_up(mut &m)
            }
        } else {
            m.rsh(&m, s)
        }
        if m.bit_len() > z.prec {
            m.rsh(&m, 1)
            s = s + 1
        }
        mm := mut &z.mant
        mm.set(&m)
        z.exp = z.exp + s
    }
}

pub fn (z &mut Float) set_prec(p int) {
    z.prec = f_cap_prec(p)
    f_norm(z)
}

pub fn (z &Float) precision() int {
    << z.prec
}

pub fn (z &mut Float) set_mode(m int) {
    if m == to_nearest_even || m == to_neg_inf || m == to_pos_inf || m == away_from_zero {
        z.mode = m
    } else {
        z.mode = to_zero
    }
}

pub fn (z &Float) rounding() int {
    << z.mode
}

pub fn (z &mut Float) set_inf(neg bool) {
    f_set_inf(z, neg)
}

pub fn (z &mut Float) set_nan() {
    f_set_nan(z)
}

pub fn (z &Float) is_inf() bool {
    << z.form == form_inf
}

pub fn (z &Float) is_nan() bool {
    << z.form == form_nan
}

pub fn (z &mut Float) set(x &Float) {
    z.prec = x.prec
    z.neg = x.neg
    mm := mut &z.mant
    mm.set(&x.mant)
    z.exp = x.exp
    z.form = x.form
    z.mode = x.mode
}

pub fn (z &mut Float) set_int64(x int) {
    if z.prec < 1 {
        z.prec = 53
    }
    z.form = form_finite
    mut tmp := new_int(x)
    z.neg = tmp.neg
    tmp.neg = false
    mm := mut &z.mant
    mm.set(&tmp)
    z.exp = 0
    f_norm(z)
}

pub fn (z &mut Float) set_int(x &Int) {
    if z.prec < 1 {
        z.prec = 53
    }
    z.form = form_finite
    mut tmp := int_copy(x)
    z.neg = tmp.neg
    tmp.neg = false
    mm := mut &z.mant
    mm.set(&tmp)
    z.exp = 0
    f_norm(z)
}

fn float_limbs_i64(abs &[]int, neg bool) int {
    mut v := 0
    mut i := abs.len
    while i > 0 {
        i = i - 1
        v = (v << w) | abs[i]
    }
    if neg {
        << 0 - v
    }
    << v
}

pub fn (z &Float) to_int64() int {
    if z.form != form_finite {
        >> errors.new("math/big: not finite")
    }
    mut m := int_copy(&z.mant)
    if z.exp > 0 {
        mut src := int_copy(&m)
        m.lsh(&src, z.exp)
    } else if z.exp < 0 {
        sh := 0 - z.exp
        mut one := new_int(1)
        mut den := new_int(0)
        den.lsh(&one, sh)
        mut q := new_int(0)
        q.quo(&m, &den) or >>
        m.set(&q)
    }
    << float_limbs_i64(&m.abs, z.neg)
}

pub fn (z &Float) signbit() bool {
    << z.neg
}

pub fn (z &Float) unbiased_exp() int {
    if z.form != form_finite || z.mant.sign() == 0 {
        << 0
    }
    << z.mant.bit_len() + z.exp
}

pub fn (z &Float) mantissa() Float {
    mut m := new_float()
    m.set(z)
    if z.form == form_finite && z.mant.sign() != 0 {
        e := z.mant.bit_len() + z.exp
        m.exp = z.exp - e
    }
    << m
}

pub fn (z &mut Float) set_mant_exp(mant &Float, exp int) {
    z.set(mant)
    if z.form == form_finite {
        z.exp = z.exp + exp
        f_norm(z)
    }
}

pub fn (z &Float) sign() int {
    if z.form == form_nan {
        << 0
    }
    if z.form == form_inf {
        if z.neg {
            << 0 - 1
        }
        << 1
    }
    if z.mant.sign() == 0 {
        << 0
    }
    if z.neg {
        << 0 - 1
    }
    << 1
}

pub fn (z &Float) cmp(y &Float) int {
    if z.form == form_nan || y.form == form_nan {
        >> errors.new("math/big: NaN")
    }
    sz := z.sign()
    sy := y.sign()
    if sz < sy {
        << 0 - 1
    }
    if sz > sy {
        << 1
    }
    if sz == 0 {
        << 0
    }
    mut xm := int_copy(&z.mant)
    mut ym := int_copy(&y.mant)
    if z.exp > y.exp {
        d := z.exp - y.exp
        mut t := int_copy(&ym)
        t.lsh(&ym, d)
        ym.set(&t)
    } else if y.exp > z.exp {
        d := y.exp - z.exp
        mut t := int_copy(&xm)
        t.lsh(&xm, d)
        xm.set(&t)
    }
    c := xm.cmp(&ym)
    if z.neg {
        << 0 - c
    }
    << c
}

pub fn (z &mut Float) add(x &Float, y &Float) {
    z.prec = x.prec
    if y.prec > z.prec {
        z.prec = y.prec
    }
    z.mode = x.mode
    if x.form == form_nan || y.form == form_nan {
        f_set_nan(z)
        <<
    }
    if x.form == form_inf && y.form == form_inf {
        if x.neg != y.neg {
            f_set_nan(z)
            <<
        }
        f_set_inf(z, x.neg)
        <<
    }
    if x.form == form_inf {
        f_set_inf(z, x.neg)
        <<
    }
    if y.form == form_inf {
        f_set_inf(z, y.neg)
        <<
    }
    if x.mant.sign() == 0 {
        z.set(y)
        z.prec = f_cap_prec(z.prec)
        <<
    }
    if y.mant.sign() == 0 {
        z.set(x)
        z.prec = f_cap_prec(z.prec)
        <<
    }
    mut xm := int_copy(&x.mant)
    mut ym := int_copy(&y.mant)
    mut e := x.exp
    if x.exp > y.exp {
        d := x.exp - y.exp
        mut t := int_copy(&ym)
        t.lsh(&ym, d)
        ym.set(&t)
        e = x.exp
    } else if y.exp > x.exp {
        d := y.exp - x.exp
        mut t := int_copy(&xm)
        t.lsh(&xm, d)
        xm.set(&t)
        e = y.exp
    }
    xm.neg = x.neg
    ym.neg = y.neg
    mut s := new_int(0)
    s.add(&xm, &ym)
    z.neg = s.neg
    s.neg = false
    mm := mut &z.mant
    mm.set(&s)
    z.exp = e
    f_norm(z)
}

pub fn (z &mut Float) sub(x &Float, y &Float) {
    mut ny := Float{prec: y.prec, neg: !y.neg, mant: int_copy(&y.mant), exp: y.exp, form: y.form, mode: y.mode}
    if y.form == form_finite && y.mant.sign() == 0 {
        ny.neg = false
    }
    z.add(x, &ny)
}

pub fn (z &mut Float) mul(x &Float, y &Float) {
    z.prec = x.prec
    if y.prec > z.prec {
        z.prec = y.prec
    }
    z.mode = x.mode
    if x.form == form_nan || y.form == form_nan {
        f_set_nan(z)
        <<
    }
    xs := x.sign()
    ys := y.sign()
    if x.form == form_inf || y.form == form_inf {
        if xs == 0 || ys == 0 {
            f_set_nan(z)
            <<
        }
        f_set_inf(z, x.neg != y.neg)
        <<
    }
    if x.mant.sign() == 0 || y.mant.sign() == 0 {
        f_zero(z)
        <<
    }
    z.neg = x.neg != y.neg
    mut m := new_int(0)
    m.mul(&x.mant, &y.mant)
    mm := mut &z.mant
    mm.set(&m)
    z.exp = x.exp + y.exp
    f_norm(z)
}

pub fn (z &mut Float) quo(x &Float, y &Float) int {
    z.prec = x.prec
    if y.prec > z.prec {
        z.prec = y.prec
    }
    z.mode = x.mode
    if x.form == form_nan || y.form == form_nan {
        f_set_nan(z)
        << 0
    }
    xs := x.sign()
    ys := y.sign()
    if x.form == form_inf && y.form == form_inf {
        f_set_nan(z)
        << 0
    }
    if y.form == form_finite && y.mant.sign() == 0 {
        if xs == 0 {
            f_set_nan(z)
            << 0
        }
        f_set_inf(z, x.neg != y.neg)
        << 0
    }
    if x.form == form_inf {
        f_set_inf(z, x.neg != y.neg)
        << 0
    }
    if y.form == form_inf {
        f_zero(z)
        z.neg = x.neg != y.neg
        << 0
    }
    if x.mant.sign() == 0 {
        f_zero(z)
        << 0
    }
    extra := z.prec + 8
    mut mx := int_copy(&x.mant)
    mut t := int_copy(&mx)
    t.lsh(&mx, extra)
    mx.set(&t)
    mut q := new_int(0)
    q.quo(&mx, &y.mant) or >>
    z.neg = x.neg != y.neg
    mm := mut &z.mant
    mm.set(&q)
    z.exp = x.exp - y.exp - extra
    f_norm(z)
    << 0
}

fn f_trim_frac(s string) string {
    mut end := s.len
    while end > 0 {
        if (s[end - 1] & 255) != 48 {
            <-
        }
        end = end - 1
    }
    if end == 0 {
        << ""
    }
    << s[0:end] + ""
}

pub fn (z &Float) text() string {
    if z.form == form_nan {
        << "NaN"
    }
    if z.form == form_inf {
        if z.neg {
            << "-Inf"
        }
        << "+Inf"
    }
    if z.mant.sign() == 0 {
        << "0"
    }
    mut m := int_copy(&z.mant)
    mut ip := ""
    mut frac := ""
    if z.exp >= 0 {
        mut t := int_copy(&m)
        t.lsh(&m, z.exp)
        m.set(&t)
        ip = m.text()
    } else {
        sh := 0 - z.exp
        mut den := new_int(1)
        mut one := new_int(1)
        den.lsh(&one, sh)
        mut q := new_int(0)
        q.quo(&m, &den) or (err) {
            << "0"
        }
        mut r := new_int(0)
        r.rem(&m, &den) or (err) {
            << "0"
        }
        ip = q.text()
        mut k := 0
        mut ten := new_int(10)
        while k < 20 {
            if r.sign() == 0 {
                <-
            }
            mut rr := int_copy(&r)
            r.mul(&rr, &ten)
            mut d := new_int(0)
            d.quo(&r, &den) or (err) {
                <-
            }
            mut nx := new_int(0)
            nx.rem(&r, &den) or (err) {
                <-
            }
            r.set(&nx)
            frac = frac + d.text()
            k = k + 1
        }
        frac = f_trim_frac(frac)
    }
    mut out := ip + ""
    if frac.len > 0 {
        out = out + "." + frac
    }
    if z.neg {
        << "-" + out
    }
    << out
}

fn f_eq_ci(s &string, start int, lit string) bool {
    if start + lit.len > s.len {
        << false
    }
    mut i := 0
    while i < lit.len {
        mut a := s[start + i] & 255
        mut b := lit[i] & 255
        if a >= 65 && a <= 90 {
            a = a + 32
        }
        if b >= 65 && b <= 90 {
            b = b + 32
        }
        if a != b {
            << false
        }
        i = i + 1
    }
    << true
}

fn f_pow10(n int) Int {
    mut p := new_int(1)
    mut ten := new_int(10)
    mut i := 0
    while i < n {
        mut t := int_copy(&p)
        p.mul(&t, &ten)
        i = i + 1
    }
    << p
}

pub fn (z &mut Float) set_string(s string) int {
    src := s + ""
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c != 32 && c != 9 {
            <-
        }
        i = i + 1
    }
    if i >= src.len {
        >> errors.new("math/big: invalid number")
    }
    if f_eq_ci(&src, i, "nan") {
        f_set_nan(z)
        << 0
    }
    mut neg := false
    c0 := src[i] & 255
    if c0 == 43 || c0 == 45 {
        neg = c0 == 45
        i = i + 1
    }
    if i >= src.len {
        >> errors.new("math/big: invalid number")
    }
    if f_eq_ci(&src, i, "inf") {
        f_set_inf(z, neg)
        << 0
    }
    mut digits := new_int(0)
    mut ten := new_int(10)
    mut saw := 0
    mut frac := 0
    mut in_frac := 0
    while i < src.len {
        c := src[i]
        if c == 46 {
            if in_frac != 0 {
                >> errors.new("math/big: invalid number")
            }
            in_frac = 1
            i = i + 1
        } else {
            if c < 48 || c > 57 {
                <-
            }
            mut t := int_copy(&digits)
            digits.mul(&t, &ten)
            mut d := new_int(c - 48)
            t = int_copy(&digits)
            digits.add(&t, &d)
            saw = 1
            if in_frac != 0 {
                frac = frac + 1
            }
            i = i + 1
        }
    }
    if saw == 0 {
        >> errors.new("math/big: invalid number")
    }
    mut exp10 := 0
    if i < src.len {
        e := src[i] & 255
        if e == 101 || e == 69 {
            i = i + 1
            mut es := 1
            if i < src.len {
                sg := src[i] & 255
                if sg == 43 || sg == 45 {
                    if sg == 45 {
                        es = 0 - 1
                    }
                    i = i + 1
                }
            }
            mut ev := 0
            mut ed := 0
            while i < src.len {
                c := src[i] & 255
                if c < 48 || c > 57 {
                    <-
                }
                ev = ev * 10 + (c - 48)
                ed = 1
                i = i + 1
            }
            if ed == 0 {
                >> errors.new("math/big: invalid number")
            }
            exp10 = es * ev
        }
    }
    if i != src.len {
        >> errors.new("math/big: invalid number")
    }
    z.form = form_finite
    z.neg = neg
    ten_exp := exp10 - frac
    if z.prec < 1 {
        z.prec = 53
    }
    if ten_exp >= 0 {
        p := f_pow10(ten_exp)
        mut m := new_int(0)
        m.mul(&digits, &p)
        mm := mut &z.mant
        mm.set(&m)
        z.exp = 0
        f_norm(z)
        << 0
    }
    extra := z.prec + 16
    mut mx := int_copy(&digits)
    mut sh := int_copy(&mx)
    sh.lsh(&mx, extra)
    mx.set(&sh)
    den := f_pow10(0 - ten_exp)
    mut q := new_int(0)
    q.quo(&mx, &den) or >>
    mm2 := mut &z.mant
    mm2.set(&q)
    z.exp = 0 - extra
    f_norm(z)
    << 0
}

pub fn (z &mut Float) set_float64(x f64) int {
    if math.is_nan(x) {
        f_set_nan(z)
        << 0
    }
    if math.is_inf(x) {
        f_set_inf(z, x < 0.0)
        << 0
    }
    t := strconv.format_float(x, 103, 0 - 1) or >>
    << z.set_string(t) or >>
}
