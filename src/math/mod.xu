@math

// f64 helpers aligned with Go `math` (Abs / Min / max / Floor / Ceil /
// Sqrt / Pow with integer exponent; pow_f64 is Go Pow; plus exp/log/trig).
// Pure f64 arithmetic; no tables, no pointers. The standard library owns
// these algorithms on every target. Hosted arm64/x64/loong64 compilers may
// lower the exact canonical math.sqrt(f64) call to the target scalar sqrt
// instruction; other targets keep this implementation as the semantic fallback.
// sqrt(x<0) returns NaN (ieee, same policy as Go and Xu's G3 ruling
// for f64); pow overflows to inf per ieee.

fn math_hw_supported() int {
    << 0
}

fn math_hw_floor(x f64) f64 {
    << x
}

fn math_hw_ceil(x f64) f64 {
    << x
}

fn math_hw_trunc(x f64) f64 {
    << x
}

fn math_hw_round_to_even(x f64) f64 {
    << x
}

fn math_hw_fma(x f64, y f64, z f64) f64 {
    << x * y + z
}

pub fn fma(x f64, y f64, z f64) f64 {
    if math_hw_supported() == 1 {
        << math_hw_fma(x, y, z)
    }
    << x * y + z
}

pub fn abs(x f64) f64 {
    if x < 0.0 {
        << 0.0 - x
    }
    << x
}

pub fn min(a f64, b f64) f64 {
    if a < b {
        << a
    }
    << b
}

pub fn max(a f64, b f64) f64 {
    if a > b {
        << a
    }
    << b
}

pub fn floor(x f64) f64 {
    if math_hw_supported() == 1 {
        << math_hw_floor(x)
    }
    t := int(x)
    f := f64(t)
    if f > x {
        << f - 1.0
    }
    << f
}

pub fn ceil(x f64) f64 {
    if math_hw_supported() == 1 {
        << math_hw_ceil(x)
    }
    t := int(x)
    f := f64(t)
    if f < x {
        << f + 1.0
    }
    << f
}

pub fn sqrt(x f64) f64 {
    if x < 0.0 {
        << 0.0 / 0.0 // NaN (ieee)
    }
    if x == 0.0 {
        << x // preserve the sign of -0.0, matching IEEE/Go hardware sqrt
    }
    inf := 1.0 / 0.0
    if x == inf {
        << x
    }
    mut xr := x
    mut e := 0
    while xr >= 2.0 {
        xr = xr * 0.5
        e += 1
    }
    while xr < 0.5 {
        xr = xr * 2.0
        e -= 1
    }
    mut g := 0.5 + xr * 0.5
    mut i := 0
    while i < 6 {
        g = (g + xr / g) * 0.5
        i += 1
    }
    if (e & 1) != 0 {
        g = g * 1.4142135623730951
        e -= 1
    }
    mut s := e / 2
    if s > 0 {
        mut j := 0
        while j < s {
            g = g * 2.0
            j += 1
        }
    } else if s < 0 {
        mut j := 0
        ns := 0 - s
        while j < ns {
            g = g * 0.5
            j += 1
        }
    }
    << g
}

pub fn pow(x f64, n int) f64 {
    mut neg := 0
    mut e := n
    if e < 0 {
        neg = 1
        e = 0 - e
    }
    mut r := 1.0
    mut b := x
    mut done := 0
    while done == 0 {
        if e == 0 {
            done = 1
        } else {
            if e % 2 != 0 {
                r = r * b
            }
            e = e / 2
            b = b * b
        }
    }
    if neg == 1 {
        << 1.0 / r
    }
    << r
}

pub fn exp(x f64) f64 {
    // e^x = 2^n * exp(r), r = x - n*ln2 in ~[-ln2/2, ln2/2], Taylor on r.
    inf := 1.0 / 0.0
    if x > 709.0 {
        << inf
    }
    if x < -745.0 {
        << 0.0
    }
    ln2 := 0.6931471805599453
    invln2 := 1.4426950408889634
    mut adj := 0.5
    if x < 0.0 {
        adj = 0.0 - 0.5
    }
    n := int(x * invln2 + adj)
    r := x - f64(n) * ln2
    mut term := 1.0
    mut sum := 1.0
    mut k := 1
    while k < 14 {
        term = term * r / f64(k)
        sum = sum + term
        k += 1
    }
    << sum * pow(2.0, n)
}

pub fn log(x f64) f64 {
    // ln(x) = ln(m) + e*ln2, m in [1, 2); artanh series on (m-1)/(m+1).
    if x <= 0.0 {
        << 0.0 / 0.0
    }
    ln2 := 0.6931471805599453
    mut xr := x
    mut m := 0
    while xr >= 2.0 {
        xr = xr * 0.5
        m += 1
    }
    while xr < 1.0 {
        xr = xr * 2.0
        m -= 1
    }
    f := (xr - 1.0) / (xr + 1.0)
    f2 := f * f
    mut term := f
    mut sum := f
    mut n := 1
    while n < 12 {
        term = term * f2
        sum = sum + term / f64(2 * n + 1)
        n += 1
    }
    << sum + sum + f64(m) * ln2
}

pub fn hypot(a f64, b f64) f64 {
    << sqrt(a * a + b * b)
}

pub fn pi() f64 {
    << 3.141592653589793
}

pub fn e() f64 {
    << 2.718281828459045
}

pub fn ln2() f64 {
    << 0.6931471805599453
}

pub fn is_nan(x f64) bool {
    << x != x
}

pub struct Frexp {
    pub frac f64
    pub exp int
}

pub fn ldexp(frac f64, exp int) f64 {
    mut x := frac
    mut e := exp
    while e > 0 {
        x = x * 2.0
        e = e - 1
    }
    while e < 0 {
        x = x * 0.5
        e = e + 1
    }
    << x
}

pub fn frexp(x f64) Frexp {
    if x == 0.0 {
        << Frexp{frac: 0.0, exp: 0}
    }
    mut mag := abs(x)
    mut e := 0
    while mag >= 1.0 {
        mag = mag * 0.5
        e = e + 1
    }
    while mag > 0.0 && mag < 0.5 {
        mag = mag * 2.0
        e = e - 1
    }
    if x < 0.0 {
        mag = 0.0 - mag
    }
    << Frexp{frac: mag, exp: e}
}

pub fn dim(x f64, y f64) f64 {
    d := x - y
    if d > 0.0 {
        << d
    }
    << 0.0
}

pub fn remainder(x f64, y f64) f64 {
    if y == 0.0 {
        << nan()
    }
    q := round_to_even(x / y)
    << x - q * y
}

pub fn is_inf(x f64) bool {
    inf := 1.0 / 0.0
    << x == inf || x == (0.0 - inf)
}

pub fn copysign(mag f64, sign f64) f64 {
    a := abs(mag)
    if sign < 0.0 {
        << 0.0 - a
    }
    if sign == 0.0 && 1.0 / sign < 0.0 {
        << 0.0 - a
    }
    << a
}

pub fn trunc(x f64) f64 {
    if math_hw_supported() == 1 {
        << math_hw_trunc(x)
    }
    t := int(x)
    << f64(t)
}

pub fn mod(x f64, y f64) f64 {
    if y == 0.0 {
        << 0.0 / 0.0
    }
    q := trunc(x / y)
    << x - q * y
}

pub fn round(x f64) f64 {
    if x >= 0.0 {
        << floor(x + 0.5)
    }
    << ceil(x - 0.5)
}

pub fn round_to_even(x f64) f64 {
    if math_hw_supported() == 1 {
        << math_hw_round_to_even(x)
    }
    t := floor(x)
    frac := x - t
    if frac > 0.5 {
        << t + 1.0
    }
    if frac < 0.5 {
        << t
    }
    n := int(t)
    if n % 2 == 0 {
        << t
    }
    << t + 1.0
}

fn sin_poly(x f64) f64 {
    // sin on [-pi/2, pi/2]; 8 odd Taylor terms.
    x2 := x * x
    mut term := x
    mut sum := x
    mut n := 1
    while n < 8 {
        term = 0.0 - term * x2 / f64((2 * n) * (2 * n + 1))
        sum = sum + term
        n = n + 1
    }
    << sum
}

fn reduce_pi(x f64) f64 {
    twopi := 6.283185307179586
    mut y := mod(x, twopi)
    if y > pi() {
        y = y - twopi
    }
    if y < 0.0 - pi() {
        y = y + twopi
    }
    << y
}

pub fn sin(x f64) f64 {
    mut y := reduce_pi(x)
    half := 1.5707963267948966
    if y > half {
        y = pi() - y
    }
    if y < 0.0 - half {
        y = 0.0 - pi() - y
    }
    << sin_poly(y)
}

pub fn cos(x f64) f64 {
    << sin(x + 1.5707963267948966)
}

pub fn tan(x f64) f64 {
    c := cos(x)
    if c == 0.0 {
        << 1.0 / 0.0
    }
    << sin(x) / c
}

fn atan_small(x f64) f64 {
    x2 := x * x
    mut term := x
    mut sum := x
    mut n := 1
    while n < 12 {
        term = 0.0 - term * x2
        sum = sum + term / f64(2 * n + 1)
        n = n + 1
    }
    << sum
}

pub fn atan(x f64) f64 {
    if x > 1.0 {
        << 1.5707963267948966 - atan(1.0 / x)
    }
    if x < -1.0 {
        << 0.0 - 1.5707963267948966 - atan(1.0 / x)
    }
    ax := abs(x)
    tanpi12 := 0.2679491924311227
    if ax > tanpi12 {
        sqrt3 := 1.7320508075688772
        t := (ax * sqrt3 - 1.0) / (sqrt3 + ax)
        v := 0.5235987755982988 + atan_small(t)
        if x < 0.0 {
            << 0.0 - v
        }
        << v
    }
    << atan_small(x)
}

pub fn atan2(y f64, x f64) f64 {
    if x > 0.0 {
        << atan(y / x)
    }
    if x < 0.0 && y >= 0.0 {
        << atan(y / x) + pi()
    }
    if x < 0.0 && y < 0.0 {
        << atan(y / x) - pi()
    }
    if x == 0.0 && y > 0.0 {
        << pi() / 2.0
    }
    if x == 0.0 && y < 0.0 {
        << 0.0 - pi() / 2.0
    }
    << 0.0
}

pub fn nan() f64 {
    << 0.0 / 0.0
}

pub fn inf(sign int) f64 {
    v := 1.0 / 0.0
    if sign < 0 {
        << 0.0 - v
    }
    << v
}

pub fn signbit(x f64) bool {
    if x < 0.0 {
        << true
    }
    if x == 0.0 && 1.0 / x < 0.0 {
        << true
    }
    << false
}

// pow_f64 is Go math.Pow. The existing pow(x, n int) stays because Xu
// has no overloads (same split as cmp.less_int / less_f64).
pub fn pow_f64(x f64, y f64) f64 {
    if y == 0.0 {
        << 1.0
    }
    if x != x || y != y {
        << nan()
    }
    if x == 1.0 {
        << 1.0
    }
    ay := abs(y)
    if ay < 1000000000.0 {
        yi := int(y)
        if f64(yi) == y {
            << pow(x, yi)
        }
    }
    if x < 0.0 {
        << nan()
    }
    if x == 0.0 {
        if y > 0.0 {
            << 0.0
        }
        << inf(1)
    }
    << exp(y * log(x))
}

pub fn log10(x f64) f64 {
    ln10 := 2.302585092994046
    << log(x) / ln10
}

pub fn log2(x f64) f64 {
    << log(x) / ln2()
}

pub fn exp2(x f64) f64 {
    << pow_f64(2.0, x)
}

pub fn cbrt(x f64) f64 {
    if x == 0.0 || x != x || is_inf(x) {
        << x
    }
    mut a := x
    mut neg := false
    if a < 0.0 {
        neg = true
        a = 0.0 - a
    }
    mut y := sqrt(a)
    if a < 1.0 {
        y = a
        if y == 0.0 {
            y = 1.0
        }
    }
    mut i := 0
    while i < 24 {
        y2 := y * y
        if y2 == 0.0 {
            <-
        }
        y = (y + y + a / y2) / 3.0
        i = i + 1
    }
    if neg {
        << 0.0 - y
    }
    << y
}

pub fn asin(x f64) f64 {
    if x != x {
        << x
    }
    if x > 1.0 || x < -1.0 {
        << nan()
    }
    if x == 1.0 {
        << pi() / 2.0
    }
    if x == -1.0 {
        << 0.0 - pi() / 2.0
    }
    if x == 0.0 {
        << x
    }
    << atan(x / sqrt(1.0 - x * x))
}

pub fn acos(x f64) f64 {
    << pi() / 2.0 - asin(x)
}

pub struct ModfResult {
    pub intg f64
    pub frac f64
}

pub fn sinh(x f64) f64 {
    e := exp(x)
    em := exp(0.0 - x)
    << (e - em) * 0.5
}

pub fn cosh(x f64) f64 {
    e := exp(x)
    em := exp(0.0 - x)
    << (e + em) * 0.5
}

pub fn tanh(x f64) f64 {
    c := cosh(x)
    if c == 0.0 {
        << 0.0
    }
    << sinh(x) / c
}

// Inverse hyperbolic functions (Go Asinh/Acosh/Atanh). Combined from
// log/sqrt like sinh/cosh/tanh; large |x| uses log(2*|x|) so x*x does
// not overflow to Inf.
pub fn asinh(x f64) f64 {
    if x != x {
        << x
    }
    if x == 0.0 {
        << 0.0
    }
    ax := abs(x)
    mut s := 0.0
    if ax > 1.0e150 {
        s = log(ax) + log(2.0)
    } else {
        s = log(ax + sqrt(ax * ax + 1.0))
    }
    if x < 0.0 {
        << 0.0 - s
    }
    << s
}

pub fn acosh(x f64) f64 {
    if x != x {
        << x
    }
    if x < 1.0 {
        << nan()
    }
    if x == 1.0 {
        << 0.0
    }
    if x > 1.0e150 {
        << log(x) + log(2.0)
    }
    << log(x + sqrt(x * x - 1.0))
}

pub fn atanh(x f64) f64 {
    if x != x {
        << x
    }
    ax := abs(x)
    if ax > 1.0 {
        << nan()
    }
    if ax == 1.0 {
        if x < 0.0 {
            << inf(0 - 1)
        }
        << inf(1)
    }
    << 0.5 * log((1.0 + x) / (1.0 - x))
}

pub fn modf(x f64) ModfResult {
    if x != x {
        << ModfResult{intg: x, frac: x}
    }
    if is_inf(x) {
        << ModfResult{intg: x, frac: 0.0}
    }
    i := trunc(x)
    << ModfResult{intg: i, frac: x - i}
}

// log1p is Go Log1p: ln(1+x). Small |x| returns x so 1+x does not
// round away the addend.
pub fn log1p(x f64) f64 {
    if x != x {
        << x
    }
    if x == 0.0 {
        << 0.0
    }
    if x <= -1.0 {
        if x == -1.0 {
            << inf(0 - 1)
        }
        << nan()
    }
    ax := abs(x)
    if ax < 1.0e-8 {
        << x
    }
    << log(1.0 + x)
}

// expm1 is Go Expm1: e^x - 1. Small |x| returns x so exp(x)-1 does not
// collapse to 0.
pub fn expm1(x f64) f64 {
    if x != x {
        << x
    }
    if x == 0.0 {
        << 0.0
    }
    ax := abs(x)
    if ax < 1.0e-8 {
        << x
    }
    << exp(x) - 1.0
}
