@index/suffixarray

// In-memory suffix array aligned with Go `index/suffixarray`
// New + Lookup. Construction is Manber–Myers doubling with introsort
// on rank pairs (Go is O(N) SA-IS). Lookup is binary search then a
// linear scan of the match run.

pub struct Index {
    pub data string
    pub sa []int
}

fn pair_less(rank &[]int, k int, n int, i int, j int) bool {
    ri := rank[i]
    rj := rank[j]
    if ri != rj {
        << ri < rj
    }
    mut yi := -1
    mut yj := -1
    if i + k < n {
        yi = rank[i + k]
    }
    if j + k < n {
        yj = rank[j + k]
    }
    << yi < yj
}

fn pair_eq(rank &[]int, k int, n int, i int, j int) bool {
    if rank[i] != rank[j] {
        << false
    }
    mut yi := -1
    mut yj := -1
    if i + k < n {
        yi = rank[i + k]
    }
    if j + k < n {
        yj = rank[j + k]
    }
    << yi == yj
}

fn log_limit(n int) int {
    mut v := n
    mut r := 0
    while v > 1 {
        v = v >> 1
        r += 1
    }
    << r + r
}

fn int_stack(n int) []int {
    mut a := []int{}
    mut i := 0
    while i < n {
        a.push(0)
        i += 1
    }
    << a
}

fn insertion_sa(sa &mut []int, rank &[]int, k int, nn int, lo int, hi int) {
    mut i := lo + 1
    while i < hi {
        v := sa[i]
        mut j := i
        while j > lo {
            if pair_less(rank, k, nn, sa[j - 1], v) {
                <-
            }
            sa[j] = sa[j - 1]
            j -= 1
        }
        sa[j] = v
        i += 1
    }
}

fn sift_sa(sa &mut []int, rank &[]int, k int, nn int, lo int, hi int, start int) {
    mut root := start
    mut done := 0
    while done == 0 {
        mut child := lo + (root - lo) * 2 + 1
        if child >= hi {
            done = 1
        } else {
            if child + 1 < hi {
                if pair_less(rank, k, nn, sa[child], sa[child + 1]) {
                    child += 1
                }
            }
            if pair_less(rank, k, nn, sa[root], sa[child]) {
                t := sa[root]
                sa[root] = sa[child]
                sa[child] = t
                root = child
            } else {
                done = 1
            }
        }
    }
}

fn heapsort_sa_range(sa &mut []int, rank &[]int, k int, nn int, lo int, hi int) {
    n := hi - lo
    if n < 2 {
        <<
    }
    mut start := lo + (n >> 1) - 1
    mut building := 1
    while building == 1 {
        sift_sa(sa, rank, k, nn, lo, hi, start)
        if start == lo {
            building = 0
        } else {
            start -= 1
        }
    }
    mut end := hi - 1
    while end > lo {
        t := sa[lo]
        sa[lo] = sa[end]
        sa[end] = t
        sift_sa(sa, rank, k, nn, lo, end, lo)
        end -= 1
    }
}

fn partition_sa(sa &mut []int, rank &[]int, k int, nn int, lo int, hi int) int {
    mid := lo + ((hi - lo) >> 1)
    last := hi - 1
    if pair_less(rank, k, nn, sa[mid], sa[lo]) {
        t := sa[mid]
        sa[mid] = sa[lo]
        sa[lo] = t
    }
    if pair_less(rank, k, nn, sa[last], sa[lo]) {
        t := sa[last]
        sa[last] = sa[lo]
        sa[lo] = t
    }
    if pair_less(rank, k, nn, sa[last], sa[mid]) {
        t := sa[last]
        sa[last] = sa[mid]
        sa[mid] = t
    }
    t0 := sa[mid]
    sa[mid] = sa[lo]
    sa[lo] = t0
    pivot := sa[lo]
    mut i := lo
    mut j := hi
    while true {
        i += 1
        while i < hi {
            if !pair_less(rank, k, nn, sa[i], pivot) {
                <-
            }
            i += 1
        }
        j -= 1
        while j > lo {
            if !pair_less(rank, k, nn, pivot, sa[j]) {
                <-
            }
            j -= 1
        }
        if i >= j {
            t := sa[lo]
            sa[lo] = sa[j]
            sa[j] = t
            << j
        }
        t2 := sa[i]
        sa[i] = sa[j]
        sa[j] = t2
    }
    << lo
}

fn heap_sort_sa(sa &mut []int, rank &[]int, k int, n int) {
    if n < 2 {
        <<
    }
    depth0 := log_limit(n)
    mut capn := depth0 + 2
    if capn < 4 {
        capn = 4
    }
    mut slo := int_stack(capn)
    mut shi := int_stack(capn)
    mut sd := int_stack(capn)
    slo[0] = 0
    shi[0] = n
    sd[0] = depth0
    mut top := 1
    while top > 0 {
        top -= 1
        lo := slo[top]
        hi := shi[top]
        depth := sd[top]
        ln := hi - lo
        if ln < 16 {
            insertion_sa(sa, rank, k, n, lo, hi)
        } else if depth == 0 {
            heapsort_sa_range(sa, rank, k, n, lo, hi)
        } else {
            p := partition_sa(sa, rank, k, n, lo, hi)
            d2 := depth - 1
            left := p - lo
            right := hi - p - 1
            mut a_lo := lo
            mut a_hi := p
            mut b_lo := p + 1
            mut b_hi := hi
            if left >= right {
                a_lo = p + 1
                a_hi = hi
                b_lo = lo
                b_hi = p
            }
            if a_hi - a_lo >= 2 {
                if top == slo.len {
                    slo.push(a_lo)
                    shi.push(a_hi)
                    sd.push(d2)
                } else {
                    slo[top] = a_lo
                    shi[top] = a_hi
                    sd[top] = d2
                }
                top += 1
            }
            if b_hi - b_lo >= 2 {
                if top == slo.len {
                    slo.push(b_lo)
                    shi.push(b_hi)
                    sd.push(d2)
                } else {
                    slo[top] = b_lo
                    shi[top] = b_hi
                    sd[top] = d2
                }
                top += 1
            }
        }
    }
}

fn cmp_suf(data &string, off int, s &string) int {
    mut i := 0
    while i < s.len && off + i < data.len {
        a := data[off + i] & 255
        b := s[i] & 255
        if a < b {
            << 0 - 1
        }
        if a > b {
            << 1
        }
        i = i + 1
    }
    if i < s.len {
        << 0 - 1
    }
    if off + i < data.len {
        << 1
    }
    << 0
}

fn has_pref(data &string, off int, s &string) bool {
    if off + s.len > data.len {
        << false
    }
    for i in 0:s.len {
        if (data[off + i] & 255) != (s[i] & 255) {
            << false
        }
    }
    << true
}

pub fn new(data &string) Index {
    src := data + ""
    n := src.len
    mut sa := []int{}
    mut rank := []int{}
    mut tmp := []int{}
    for i in 0:n {
        sa.push(i)
        rank.push(src[i] & 255)
        tmp.push(0)
    }
    if n >= 2 {
        mut k := 1
        mut looping := 1
        while looping == 1 {
            heap_sort_sa(mut &sa, &rank, k, n)
            tmp[sa[0]] = 0
            mut r := 0
            mut i := 1
            while i < n {
                prev := sa[i - 1]
                cur := sa[i]
                if !pair_eq(&rank, k, n, prev, cur) {
                    r = r + 1
                }
                tmp[cur] = r
                i = i + 1
            }
            mut j := 0
            while j < n {
                rank[j] = tmp[j]
                j = j + 1
            }
            if r >= n - 1 {
                looping = 0
            } else {
                if k > n {
                    looping = 0
                } else {
                    k = k * 2
                }
            }
        }
    }
    << Index{data: src, sa: sa}
}

pub fn lookup(x &Index, s &string, n int) []int {
    mut out := []int{}
    if s.len == 0 || n == 0 {
        << out
    }
    nsa := x.sa.len
    mut lo := 0
    mut hi := nsa
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        off := x.sa[mid]
        if cmp_suf(&x.data, off, s) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    mut j := lo
    mut count := 0
    mut lim := n
    if lim < 0 {
        lim = nsa
    }
    while j < nsa && count < lim {
        off := x.sa[j]
        if !has_pref(&x.data, off, s) {
            j = nsa
        } else {
            out.push(off)
            count = count + 1
            j = j + 1
        }
    }
    << out
}

// Match is a half-open [from, to) index into the indexed string (M143).
pub struct Match {
    pub from int
    pub to int
}

// FindAllIndex aligned with Go `Index.FindAllIndex`.
pub fn find_all_index(x &Index, s &string, n int) []Match {
    mut out := []Match{}
    qlen := s.len
    offs := lookup(x, s, n)
    mut i := 0
    while i < offs.len {
        off := offs[i]
        out.push(Match{from: off, to: off + qlen})
        i = i + 1
    }
    << out
}

pub fn (x Index) len() int {
    << x.data.len
}
