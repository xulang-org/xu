@container/ring

// Circular list aligned with Go `container/ring`, specialized to owning
// strings (no `temp`, no element pointers). a Ring owns a dense circular
// arena; element handles are indices. Unlink/link rebuild the active
// cycle (O(n)) — fine for the small rings this package targets.
// Do(fn) available since M137 (fn values).

pub struct Ring {
    pub val []string
    pub next []int
    pub prev []int
    pub cur int
}

pub fn new(n int) Ring {
    mut r := Ring{val: []string{}, next: []int{}, prev: []int{}, cur: -1}
    if n <= 0 {
        << r
    }
    for i in 0:n {
        r.val.push("")
        r.next.push(0)
        r.prev.push(0)
    }
    for i in 0:n {
        r.next[i] = (i + 1) % n
        r.prev[i] = (i + n - 1) % n
    }
    r.cur = 0
    << r
}

pub fn len(r &Ring) int {
    if r.cur < 0 {
        << 0
    }
    mut n := 1
    mut e := r.next[r.cur]
    while e != r.cur {
        n = n + 1
        e = r.next[e]
    }
    << n
}

pub fn next(r &Ring, e int) int {
    if r.cur < 0 || e < 0 || e >= r.next.len {
        << -1
    }
    << r.next[e]
}

pub fn prev(r &Ring, e int) int {
    if r.cur < 0 || e < 0 || e >= r.prev.len {
        << -1
    }
    << r.prev[e]
}

pub fn move(r &Ring, e int, n int) int {
    if r.cur < 0 || e < 0 {
        << -1
    }
    mut p := e
    if n > 0 {
        mut i := 0
        while i < n {
            p = r.next[p]
            i = i + 1
        }
    } else {
        mut i := 0
        while i > n {
            p = r.prev[p]
            i = i - 1
        }
    }
    << p
}

pub fn value(r &Ring, e int) string {
    if e < 0 || e >= r.val.len {
        << ""
    }
    << r.val[e] + ""
}

pub fn (r &mut Ring) set_value(e int, v string) {
    if e < 0 || e >= r.val.len {
        <<
    }
    r.val[e] = v
}

pub fn cur(r &Ring) int {
    << r.cur
}

pub fn (r &mut Ring) set_cur(e int) {
    if e < 0 || e >= r.val.len {
        <<
    }
    r.cur = e
}

pub fn values(r &Ring) []string {
    mut out := []string{}
    if r.cur < 0 {
        << out
    }
    out.push(r.val[r.cur] + "")
    mut e := r.next[r.cur]
    while e != r.cur {
        out.push(r.val[e] + "")
        e = r.next[e]
    }
    << out
}

// Do visits each element once, clockwise from cur (M137).
pub fn do(r &Ring, f fn(string)) {
    if r.cur < 0 {
        <<
    }
    f(r.val[r.cur] + "")
    mut e := r.next[r.cur]
    while e != r.cur {
        f(r.val[e] + "")
        e = r.next[e]
    }
}

fn rebuild_from(vals &[]string) Ring {
    n := vals.len
    mut r := Ring{val: []string{}, next: []int{}, prev: []int{}, cur: -1}
    if n == 0 {
        << r
    }
    for i in 0:n {
        r.val.push(vals[i] + "")
        r.next.push(0)
        r.prev.push(0)
    }
    for i in 0:n {
        r.next[i] = (i + 1) % n
        r.prev[i] = (i + n - 1) % n
    }
    r.cur = 0
    << r
}

fn (r &mut Ring) install(vals &[]string) {
    mut nv := []string{}
    mut nn := []int{}
    mut np := []int{}
    n := vals.len
    if n == 0 {
        r.val = nv
        r.next = nn
        r.prev = np
        r.cur = -1
        <<
    }
    for i in 0:n {
        nv.push(vals[i] + "")
        nn.push(0)
        np.push(0)
    }
    for i in 0:n {
        nn[i] = (i + 1) % n
        np[i] = (i + n - 1) % n
    }
    r.val = nv
    r.next = nn
    r.prev = np
    r.cur = 0
}

fn (s &mut Ring) clear() {
    mut nv := []string{}
    mut nn := []int{}
    mut np := []int{}
    s.val = nv
    s.next = nn
    s.prev = np
    s.cur = -1
}

// unlink removes n % Len elements starting at next(e). Returns the removed
// subring. If n % Len == 0, returns empty and leaves r unchanged.
pub fn (r &mut Ring) unlink(e int, n int) Ring {
    empty := Ring{val: []string{}, next: []int{}, prev: []int{}, cur: -1}
    if r.cur < 0 || e < 0 || n <= 0 {
        << empty
    }
    mut ln := 0
    if r.cur >= 0 {
        ln = 1
        mut e0 := r.next[r.cur]
        while e0 != r.cur {
            ln = ln + 1
            e0 = r.next[e0]
        }
    }
    mut k := n % ln
    if k == 0 {
        << empty
    }
    mut all := []string{}
    all.push(r.val[e] + "")
    mut p := r.next[e]
    while p != e {
        all.push(r.val[p] + "")
        p = r.next[p]
    }
    mut rem := []string{}
    mut keep := []string{}
    keep.push(all[0] + "")
    mut i := 1
    while i < all.len {
        if i <= k {
            rem.push(all[i] + "")
        } else {
            keep.push(all[i] + "")
        }
        i = i + 1
    }
    out := rebuild_from(&rem)
    r.install(&keep)
    << out
}

// link splices s after e so next(e) becomes s.cur. Consumes s (left empty).
// Returns the original next(e) as the new index of that element in r, or -1.
pub fn (r &mut Ring) link(e int, s &mut Ring) int {
    if s.cur < 0 {
        if r.cur < 0 {
            << -1
        }
        << r.next[e]
    }
    if r.cur < 0 {
        mut sv := []string{}
        if s.cur >= 0 {
            sv.push(s.val[s.cur] + "")
            mut q := s.next[s.cur]
            while q != s.cur {
                sv.push(s.val[q] + "")
                q = s.next[q]
            }
        }
        r.install(&sv)
        s.clear()
        << r.cur
    }
    mut merged := []string{}
    merged.push(r.val[e] + "")
    mut sv2 := []string{}
    if s.cur >= 0 {
        sv2.push(s.val[s.cur] + "")
        mut q2 := s.next[s.cur]
        while q2 != s.cur {
            sv2.push(s.val[q2] + "")
            q2 = s.next[q2]
        }
    }
    for i in 0:sv2.len {
        merged.push(sv2[i] + "")
    }
    mut p := r.next[e]
    while p != e {
        merged.push(r.val[p] + "")
        p = r.next[p]
    }
    mut old_next_pos := 1 + sv2.len
    if old_next_pos >= merged.len {
        old_next_pos = 0
    }
    r.install(&merged)
    s.clear()
    << old_next_pos
}
