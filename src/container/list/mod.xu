@container/list

// Doubly-linked list aligned with Go `container/list`, specialized to
// owning strings (no `temp`). Nodes live in parallel arrays; 0 is a
// circular sentinel. Remove recycles indices via a free list so
// insert/remove stay O(1) and do not compact.

pub struct List {
    pub val []string
    pub next []int
    pub prev []int
    pub len int
    pub free int
}

pub fn (l &mut List) init() {
    // Rebuild sentinel in place. Moving slice fields out of `new()`
    // is a partial move (M2b); assign whole new slices instead.
    mut val := []string{}
    mut next := []int{}
    mut prev := []int{}
    val.push("")
    next.push(0)
    prev.push(0)
    l.val = val
    l.next = next
    l.prev = prev
    l.len = 0
    l.free = 0 - 1
}

pub fn new() List {
    mut val := []string{}
    mut next := []int{}
    mut prev := []int{}
    val.push("")
    next.push(0)
    prev.push(0)
    << List{val: val, next: next, prev: prev, len: 0, free: -1}
}

fn (l &mut List) insert_after_node(after int, v string) int {
    mut i := 0
    if l.free >= 0 {
        i = l.free
        l.free = l.next[i]
    } else {
        l.val.push("")
        l.next.push(0)
        l.prev.push(0)
        i = l.val.len - 1
    }
    l.val[i] = v
    b := l.next[after]
    l.next[after] = i
    l.prev[i] = after
    l.next[i] = b
    l.prev[b] = i
    l.len = l.len + 1
    << i
}

fn (l &mut List) unlink(e int) {
    a := l.prev[e]
    b := l.next[e]
    l.next[a] = b
    l.prev[b] = a
}

fn (l &mut List) relink_after(after int, e int) {
    b := l.next[after]
    l.next[after] = e
    l.prev[e] = after
    l.next[e] = b
    l.prev[b] = e
}

pub fn (l &mut List) push_back(v string) int {
    back := l.prev[0]
    << l.insert_after_node(back, v)
}

pub fn (l &mut List) push_front(v string) int {
    << l.insert_after_node(0, v)
}

pub fn (l &mut List) insert_after(e int, v string) int {
    if e < 0 {
        << 0
    }
    << l.insert_after_node(e, v)
}

pub fn (l &mut List) insert_before(e int, v string) int {
    if e <= 0 {
        << 0
    }
    p := l.prev[e]
    << l.insert_after_node(p, v)
}

pub fn (l &mut List) remove(e int) string {
    if e <= 0 {
        << ""
    }
    l.unlink(e)
    out := l.val[e] + ""
    l.val[e] = ""
    l.next[e] = l.free
    l.prev[e] = 0
    l.free = e
    l.len = l.len - 1
    << out
}

pub fn (l &mut List) move_to_front(e int) {
    if e <= 0 {
        <<
    }
    l.unlink(e)
    l.relink_after(0, e)
}

pub fn (l &mut List) move_to_back(e int) {
    if e <= 0 {
        <<
    }
    l.unlink(e)
    back := l.prev[0]
    l.relink_after(back, e)
}

pub fn (l &mut List) move_after(e int, mark int) {
    if e <= 0 || mark <= 0 || e == mark {
        <<
    }
    l.unlink(e)
    l.relink_after(mark, e)
}

pub fn (l &mut List) move_before(e int, mark int) {
    if e <= 0 || mark <= 0 || e == mark {
        <<
    }
    l.unlink(e)
    p := l.prev[mark]
    l.relink_after(p, e)
}

pub fn len(l &List) int {
    << l.len
}

pub fn front(l &List) int {
    << l.next[0]
}

pub fn back(l &List) int {
    << l.prev[0]
}

pub fn next(l &List, e int) int {
    if e < 0 || e >= l.next.len {
        << 0
    }
    << l.next[e]
}

pub fn prev(l &List, e int) int {
    if e < 0 || e >= l.prev.len {
        << 0
    }
    << l.prev[e]
}

pub fn value(l &List, e int) string {
    if e <= 0 || e >= l.val.len {
        << ""
    }
    << l.val[e] + ""
}
