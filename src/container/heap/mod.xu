@container/heap


#errors
// Binary min-heap aligned with Go `container/heap` Init/Push/Pop,
// specialized to `IntHeap` / `StrHeap` (no Interface / function values).
// Logical length `n` is separate from backing capacity so Pop is O(log n)
// and does not rebuild the array. Mutating API is methods (field `.push`
// on `&mut Struct` params does not write the descriptor back).

pub struct IntHeap {
    pub a []int
    pub n int
}

pub struct StrHeap {
    pub a []string
    pub n int
}

pub fn new_ints() IntHeap {
    << IntHeap{a: []int{}, n: 0}
}

pub fn new_strs() StrHeap {
    << StrHeap{a: []string{}, n: 0}
}

pub fn from_ints(xs []int) IntHeap {
    n := xs.len
    mut h := IntHeap{a: xs, n: n}
    h.init()
    << h
}

pub fn from_strs(xs []string) StrHeap {
    n := xs.len
    mut h := StrHeap{a: xs, n: n}
    h.init()
    << h
}

pub fn len_ints(h &IntHeap) int {
    << h.n
}

pub fn len_strs(h &StrHeap) int {
    << h.n
}

pub fn (h &mut StrHeap) init() {
    n := h.n
    if n < 2 {
        <<
    }
    mut start := (n >> 1) - 1
    mut going := 1
    while going == 1 {
        mut root := start
        mut done := 0
        while done == 0 {
            mut child := root * 2 + 1
            if child >= n {
                done = 1
            } else {
                if child + 1 < n {
                    c1 := h.a[child + 1]
                    c0 := h.a[child]
                    if str_lt(&c1, &c0) {
                        child += 1
                    }
                }
                cr := h.a[child]
                rt := h.a[root]
                if str_lt(&cr, &rt) {
                    t := h.a[root]
                    h.a[root] = h.a[child]
                    h.a[child] = t
                    root = child
                } else {
                    done = 1
                }
            }
        }
        if start == 0 {
            going = 0
        } else {
            start -= 1
        }
    }
}

fn sift_down_ints(a &mut []int, root0 int, n int, x int) {
    mut root := root0
    while true {
        mut child := root * 2 + 1
        if child >= n { <- }
        mut value := a[child]
        if child + 1 < n {
            right := a[child + 1]
            if right < value {
                child += 1
                value = right
            }
        }
        if x <= value { <- }
        a[root] = value
        root = child
    }
    a[root] = x
}

fn sift_up_ints(a &mut []int, j0 int, x int) {
    mut j := j0
    while j > 0 {
        i := (j - 1) >> 1
        parent := a[i]
        if x >= parent { <- }
        a[j] = parent
        j = i
    }
    a[j] = x
}

pub fn (h &mut IntHeap) init() {
    n := h.n
    if n < 2 {
        <<
    }
    mut start := (n >> 1) - 1
    mut going := 1
    while going == 1 {
        x := h.a[start]
        sift_down_ints(mut &h.a, start, n, x)
        if start == 0 {
            going = 0
        } else {
            start -= 1
        }
    }
}

pub fn (h &mut IntHeap) push(x int) {
    if h.n >= h.a.len {
        h.a.push(0)
    }
    h.n = h.n + 1
    mut j := h.n - 1
    while j > 0 {
        i := (j - 1) >> 1
        parent := h.a[i]
        if x >= parent { <- }
        h.a[j] = parent
        j = i
    }
    h.a[j] = x
}

pub fn (h &mut IntHeap) pop() int {
    if h.n == 0 {
        >> errors.new("heap: empty")
    }
    out := h.a[0]
    h.n = h.n - 1
    if h.n > 0 {
        x := h.a[h.n]
        n := h.n
        sift_down_ints(mut &h.a, 0, n, x)
    }
    << out
}

fn str_lt(a &string, b &string) bool {
    mut i := 0
    while i < a.len && i < b.len {
        ca := a[i] & 255
        cb := b[i] & 255
        if ca != cb {
            << ca < cb
        }
        i = i + 1
    }
    << a.len < b.len
}

pub fn (h &mut StrHeap) push(x string) {
    if h.n >= h.a.len {
        h.a.push("")
    }
    h.a[h.n] = x
    h.n = h.n + 1
    mut j := h.n - 1
    mut done := 0
    while done == 0 {
        if j <= 0 {
            done = 1
        } else {
            i := (j - 1) >> 1
            left := h.a[j]
            right := h.a[i]
            if !str_lt(&left, &right) {
                done = 1
            } else {
                t := h.a[j]
                h.a[j] = h.a[i]
                h.a[i] = t
                j = i
            }
        }
    }
}

pub fn (h &mut StrHeap) pop() string {
    if h.n == 0 {
        >> errors.new("heap: empty")
    }
    out := h.a[0] + ""
    h.n = h.n - 1
    if h.n > 0 {
        last := h.a[h.n] + ""
        h.a[h.n] = ""
        h.a[0] = last
        n := h.n
        mut root := 0
        mut done := 0
        while done == 0 {
            mut child := root * 2 + 1
            if child >= n {
                done = 1
            } else {
                if child + 1 < n {
                    c1 := h.a[child + 1]
                    c0 := h.a[child]
                    if str_lt(&c1, &c0) {
                        child += 1
                    }
                }
                cr := h.a[child]
                rt := h.a[root]
                if str_lt(&cr, &rt) {
                    t := h.a[root]
                    h.a[root] = h.a[child]
                    h.a[child] = t
                    root = child
                } else {
                    done = 1
                }
            }
        }
    }
    << out
}
