@io

#errors

// read_n(n>0) returns at most n bytes. Empty string or an error with message
// eof ends the stream; other errors propagate. Unlike Go Reader, this API
// cannot return bytes and an error in the same operation.
pub struct@ StreamReader {
    fn read_n(int) string
}

// write_str consumes one owning chunk. It must accept the whole chunk or
// throw; returning a shorter count is a short write, never an invitation to
// replay a partially accepted chunk. The destination may retain data itself.
pub struct@ StreamWriter {
    fn write_str(string) int
}

// The three public forms retain their independently tested copy contracts.
// Generic forwarding is supported; no additional whole-stream staging is used.
// Both endpoints are borrowed; their partial effects remain visible on errors.
pub fn copy_stream#W:StreamWriter,R:StreamReader(dst &mut W, src &mut R) int {
    size := copy_chunk
    limit := -1
    if size <= 0 {
        >> errors.new("io: invalid buffer size")
    }
    mut total := 0
    while limit < 0 || total < limit {
        mut request := size
        if limit >= 0 && request > limit - total {
            request = limit - total
        }
        chunk := src.read_n(request) or (err) {
            if err.msg() == eof && limit < 0 {
                << total
            }
            >> err
        }
        if chunk.len > request {
            >> errors.new("io: invalid read count")
        }
        if chunk.len == 0 {
            if limit >= 0 {
                >> errors.new(eof)
            }
            << total
        }
        count := chunk.len
        if total > 9223372036854775807 - count {
            >> errors.new("io: copy count overflow")
        }
        n := dst.write_str(chunk) or >>
        if n < 0 || n > count {
            >> errors.new("io: invalid write count")
        }
        if n != count {
            >> errors.new("short write")
        }
        total = total + count
    }
    << total
}

// Maximum owning chunk size, with no whole-stream staging.
pub fn copy_stream_buffer#W:StreamWriter,R:StreamReader(dst &mut W, src &mut R, size int) int {
    limit := -1
    if size <= 0 {
        >> errors.new("io: invalid buffer size")
    }
    mut total := 0
    while limit < 0 || total < limit {
        mut request := size
        if limit >= 0 && request > limit - total {
            request = limit - total
        }
        chunk := src.read_n(request) or (err) {
            if err.msg() == eof && limit < 0 {
                << total
            }
            >> err
        }
        if chunk.len > request {
            >> errors.new("io: invalid read count")
        }
        if chunk.len == 0 {
            if limit >= 0 {
                >> errors.new(eof)
            }
            << total
        }
        count := chunk.len
        if total > 9223372036854775807 - count {
            >> errors.new("io: copy count overflow")
        }
        n := dst.write_str(chunk) or >>
        if n < 0 || n > count {
            >> errors.new("io: invalid write count")
        }
        if n != count {
            >> errors.new("short write")
        }
        total = total + count
    }
    << total
}

// Exactly n bytes, with no over-read. n=0 touches neither endpoint.
pub fn copy_stream_n#W:StreamWriter,R:StreamReader(dst &mut W, src &mut R, n int) int {
    if n < 0 {
        >> errors.new("io: invalid count")
    }
    size := copy_chunk
    limit := n
    if size <= 0 {
        >> errors.new("io: invalid buffer size")
    }
    mut total := 0
    while limit < 0 || total < limit {
        mut request := size
        if limit >= 0 && request > limit - total {
            request = limit - total
        }
        chunk := src.read_n(request) or (err) {
            if err.msg() == eof && limit < 0 {
                << total
            }
            >> err
        }
        if chunk.len > request {
            >> errors.new("io: invalid read count")
        }
        if chunk.len == 0 {
            if limit >= 0 {
                >> errors.new(eof)
            }
            << total
        }
        count := chunk.len
        if total > 9223372036854775807 - count {
            >> errors.new("io: copy count overflow")
        }
        n := dst.write_str(chunk) or >>
        if n < 0 || n > count {
            >> errors.new("io: invalid write count")
        }
        if n != count {
            >> errors.new("short write")
        }
        total = total + count
    }
    << total
}

pub fn (d &mut Discard) write_str(data string) int {
    << d.write(&data)
}
