@io

#errors

// Writer / Reader are the legacy Go-shaped method sets (structural). copy is
// Cursor→Buffer and returns owned string. stream.xu supplies generic borrowed
// StreamReader/StreamWriter copying with bounded owning string chunks.
// copy_to returns Buffer (M181). Cursor/SectionCursor provide seek/read_at.

struct@ Writer {
    fn write(&string) int
}

struct@ Reader {
    fn read_n(int) string
}

pub struct Buffer {
    pub data string
    pub off int
}

pub struct Cursor {
    pub data string
    pub off int
}

pub fn buffer() Buffer {
    << Buffer{data: "", off: 0}
}

pub fn buffer_from(s string) Buffer {
    << Buffer{data: s, off: 0}
}

pub fn cursor(s string) Cursor {
    << Cursor{data: s, off: 0}
}

pub fn (c $&Cursor) reset(s string) {
    c.data = s + ""
    c.off = 0
}

pub fn (b $&Buffer) reset() {
    b.data = ""
    b.off = 0
}

pub fn (b &Buffer) len() int {
    n := b.data.len - b.off
    if n < 0 {
        << 0
    }
    << n
}

pub fn (b &Buffer) cap() int {
    << b.data.len
}

pub fn (c &Cursor) size() int {
    << c.data.len
}

pub fn (b $&Buffer) write(data &string) int {
    // Clone the borrow to an owned string first: `push_str(*data)` does not
    // see through array-element `&string` (path/filepath join/rel).
    s := data + ""
    r := $&b.data
    r.push_str(s)
    << data.len
}

// write_str appends an owned string without requiring a borrow of a local.
pub fn (b $&Buffer) write_str(s string) int {
    r := $&b.data
    r.push_str(s)
    << s.len
}

pub fn (b $&Buffer) write_byte(c int) int {
    r := $&b.data
    r.push_byte(c & 255)
    << 1
}

pub fn (b $&Buffer) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    rest := b.data.len - b.off
    if rest <= 0 {
        << ""
    }
    $take := n
    if take > rest {
        take = rest
    }
    start := b.off
    b.off = b.off + take
    << b.data[start:b.off]
}

pub fn (b &Buffer) bytes() string {
    if b.off >= b.data.len {
        << ""
    }
    << b.data[b.off:b.data.len]
}

pub fn (c $&Cursor) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    rest := c.data.len - c.off
    if rest <= 0 {
        << ""
    }
    $take := n
    if take > rest {
        take = rest
    }
    start := c.off
    c.off = c.off + take
    << c.data[start:c.off]
}

const COPY_CHUNK = 4096
const COPY_MAX_CHUNKS = 1048576

fn copy_drain(dst Buffer, src Cursor) Buffer {
    $d := dst
    $s := src

    // Fast path: when the whole source fits in one chunk, avoid the loop.
    $remaining := s.data.len - s.off
    if remaining <= COPY_CHUNK {
        if remaining > 0 {
            chunk := s.read_n(remaining)
            n := d.write(&chunk)
            if n != chunk.len {
                >> errors.new("short write")
            }
        }
        << d
    }

    $i := 0
    $done := false
    while !done {
        if i >= COPY_MAX_CHUNKS {
            >> errors.new("copy: too many chunks")
        }
        chunk := s.read_n(COPY_CHUNK)
        if chunk.len == 0 {
            done = true
        } else {
            n := d.write(&chunk)
            if n != chunk.len {
                >> errors.new("short write")
            }
        }
        i = i + 1
    }
    << d
}

// copy drains src into dst and returns the remaining dst bytes as a string.
pub fn copy(dst Buffer, src Cursor) string {
    d := copy_drain(dst, src)
    << d.bytes()
}

// copy_to is the Buffer-returning form (M181).
pub fn copy_to(dst Buffer, src Cursor) Buffer {
    << copy_drain(dst, src)
}

pub fn read_all(src Cursor) string {
    << copy(buffer(), src)
}

pub const EOF = "EOF"

pub fn (c &Cursor) remaining() int {
    rest := c.data.len - c.off
    if rest < 0 {
        << 0
    }
    << rest
}

pub fn (c $&Cursor) seek(offset int, whence int) int {
    $abs := 0
    if whence == 0 {
        abs = offset
    } else if whence == 1 {
        abs = c.off + offset
    } else if whence == 2 {
        abs = c.data.len + offset
    } else {
        >> errors.new("io: invalid whence")
    }
    if abs < 0 {
        >> errors.new("io: negative position")
    }
    c.off = abs
    << abs
}

pub fn (c &Cursor) read_at(n int, off int) string {
    if off < 0 {
        >> errors.new("io: negative offset")
    }
    if off >= c.data.len {
        >> errors.new(EOF)
    }
    if n <= 0 {
        << ""
    }
    rest := c.data.len - off
    $take := n
    if take > rest {
        take = rest
    }
    << c.data[off:(off + take)]
}

pub fn read_full(src Cursor, n int) string {
    << read_at_least(src, n, n)
}

pub fn read_at_least(src Cursor, min int, max int) string {
    $s := src
    if min < 0 || max < min {
        >> errors.new("io: invalid count")
    }
    if max == 0 {
        << ""
    }
    if min == max {
        out := s.read_n(max)
        if out.len < max {
            >> errors.new(EOF)
        }
        << out
    }
    $out := s.read_n(max)
    if out.len == max {
        << out
    }
    if out.len == 0 {
        if out.len >= min {
            << out
        }
        >> errors.new(EOF)
    }
    while out.len < max {
        need := max - out.len
        chunk := s.read_n(need)
        if chunk.len == 0 {
            if out.len >= min {
                << out
            }
            >> errors.new(EOF)
        }
        out.push_str(chunk)
    }
    << out
}

pub fn copy_n(dst Buffer, src Cursor, n int) string {
    if n <= 0 {
        << ""
    }
    got := read_full(src, n)
    $d := dst
    wr := d.write(&got)
    if wr != got.len {
        >> errors.new("short write")
    }
    << d.bytes()
}

pub struct LimitCursor {
    pub src Cursor
    pub n int
}

pub fn limit_cursor(src Cursor, n int) LimitCursor {
    << LimitCursor{src: src, n: n}
}

pub fn (l LimitCursor) remaining() int {
    if l.n < 0 {
        << 0
    }
    << l.n
}

pub fn (l $&LimitCursor) read_n(n int) string {
    if l.n <= 0 {
        << ""
    }
    $take := n
    if take > l.n {
        take = l.n
    }
    s := $&l.src
    chunk := s.read_n(take)
    l.n = l.n - chunk.len
    << chunk
}

pub struct Discard {
    pub n int
}

pub fn discard() Discard {
    << Discard{n: 0}
}

pub fn (d $&Discard) write(data &string) int {
    d.n = d.n + data.len
    << data.len
}

pub fn (d Discard) written() int {
    << d.n
}

// Concatenate string snapshots (Go MultiReader, bound to Cursor-shaped
// chunks — no generic Reader). One read_n drains the current chunk only;
// empty/exhausted chunks are skipped in the same call.
pub struct MultiCursor {
    pub chunks []string
    pub i int
    pub off int
}

pub fn multi_cursor(parts <-> string) MultiCursor {
    $chunks := []string{}
    for k in 0:parts.len {
        chunks.push(parts[k])
    }
    << MultiCursor{chunks: chunks, i: 0, off: 0}
}

pub fn (m $&MultiCursor) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    while m.i < m.chunks.len {
        chunk := m.chunks[m.i]
        rest := chunk.len - m.off
        if rest <= 0 {
            m.i = m.i + 1
            m.off = 0
            ->
        }
        $take := n
        if take > rest {
            take = rest
        }
        start := m.off
        m.off = m.off + take
        if m.off >= chunk.len {
            m.i = m.i + 1
            m.off = 0
        }
        << chunk[start:(start + take)]
    }
    << ""
}

// Write the same bytes to n owning destinations (Go MultiWriter).
pub struct MultiBuffer {
    pub parts []string
}

pub fn multi_buffer(n int) MultiBuffer {
    $parts := []string{}
    $k := 0
    $count := n
    if count < 0 {
        count = 0
    }
    while k < count {
        parts.push("")
        k = k + 1
    }
    << MultiBuffer{parts: parts}
}

pub fn (m $&MultiBuffer) write(data &string) int {
    $k := 0
    while k < m.parts.len {
        $cur := m.parts[k]
        cur.push_str(*data)
        m.parts[k] = cur
        k = k + 1
    }
    << data.len
}

pub fn (m &MultiBuffer) text(i int) string {
    if i < 0 || i >= m.parts.len {
        << ""
    }
    << m.parts[i]
}

// Read from src, copy each chunk into dst (Go TeeReader).
pub struct Tee {
    pub src Cursor
    pub dst Buffer
}

pub fn tee(src Cursor, dst Buffer) Tee {
    << Tee{src: src, dst: dst}
}

pub fn (t $&Tee) read_n(n int) string {
    s := $&t.src
    chunk := s.read_n(n)
    if chunk.len > 0 {
        // Append directly: calling Buffer.write from read_n would mark every
        // io.read_n as may-throw (same-module method-name throw propagation).
        t.dst.data = t.dst.data + chunk
    }
    << chunk
}

pub fn (t &Tee) copied() string {
    << t.dst.data
}

// Window into a string snapshot (Go SectionReader + ReadAt/Seek).
pub struct SectionCursor {
    pub data string
    pub base int
    pub limit int
    pub off int
}

pub fn section_cursor(s string, off int, n int) SectionCursor {
    src := s
    $base := off
    if base < 0 {
        base = 0
    }
    if base > src.len {
        base = src.len
    }
    $lim := base
    if n > 0 {
        lim = base + n
        if lim > src.len {
            lim = src.len
        }
    }
    << SectionCursor{data: src, base: base, limit: lim, off: 0}
}

pub fn (s $&SectionCursor) read_n(n int) string {
    rest := s.limit - (s.base + s.off)
    if rest <= 0 || n <= 0 {
        << ""
    }
    $take := n
    if take > rest {
        take = rest
    }
    start := s.base + s.off
    s.off = s.off + take
    << s.data[start:(start + take)]
}

pub fn (s &SectionCursor) size() int {
    n := s.limit - s.base
    if n < 0 {
        << 0
    }
    << n
}

pub fn (s $&SectionCursor) seek(offset int, whence int) int {
    sz := s.size()
    $abs := 0
    if whence == 0 {
        abs = offset
    } else if whence == 1 {
        abs = s.off + offset
    } else if whence == 2 {
        abs = sz + offset
    } else {
        >> errors.new("io: invalid whence")
    }
    if abs < 0 {
        >> errors.new("io: negative position")
    }
    s.off = abs
    << abs
}

pub fn (s &SectionCursor) read_at(n int, off int) string {
    if off < 0 {
        >> errors.new("io: negative offset")
    }
    sz := s.size()
    if off >= sz {
        >> errors.new(EOF)
    }
    if n <= 0 {
        << ""
    }
    rest := sz - off
    $take := n
    if take > rest {
        take = rest
    }
    start := s.base + off
    << s.data[start:(start + take)]
}

// In-memory one-way pipe (Go io.Pipe shape; queue is a bounded chan like
// net.pipe, not a synchronous unbuffered handshake).
pub struct PipeReader {
    pub r chan string
    pub buf string
    pub off int
}

pub struct PipeWriter {
    pub w chan string
    // state is shared by copied writers.  Token 1 means open; token 0 means
    // closed.  The writer holds the token while enqueueing so close cannot
    // race a send on the underlying channel.
    state chan int
    pub closed int
}

pub struct Pipe {
    pub r PipeReader
    pub w PipeWriter
}

pub fn pipe() Pipe {
    ch := chan string{cap: 16}
    state := chan int{cap: 1}
    state <- 1
    << Pipe{
        r: PipeReader{r: ch, buf: "", off: 0},
        w: PipeWriter{w: ch, state: state, closed: 0}
    }
}

pub fn (p $&PipeReader) read_n(n int) string {
    if n <= 0 {
        << ""
    }
    if p.off >= p.buf.len {
        s := <-p.r
        if s.len == 0 {
            << ""
        }
        p.buf = s
        p.off = 0
    }
    rest := p.buf.len - p.off
    $take := n
    if take > rest {
        take = rest
    }
    start := p.off
    p.off = p.off + take
    << p.buf[start:p.off]
}

pub fn (w PipeWriter) write(data &string) int {
    token := <-w.state
    if token == 0 || w.closed != 0 {
        w.state <- 0
        >> errors.new("io: write on closed pipe")
    }
    w.w <- *data
    w.state <- 1
    << data.len
}

pub fn (w $&PipeWriter) close() int {
    token := <-w.state
    if token == 0 || w.closed != 0 {
        w.state <- 0
        << 0
    }
    w.closed = 1
    close(w.w)
    w.state <- 0
    << 0
}
