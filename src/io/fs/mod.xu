@io/fs

#errors
#os

// Go `io/fs`.
//
// Go layers:
//   kernel  →  os.File / Open / Stat / ReadDir
//   io/fs   →  FS / File / FileInfo / DirEntry
//              ValidPath, ReadFile, ReadDir, Stat, Sub
//   os.DirFS implements fs.FS
//   net/http.FileServer consumes io/fs (D7)
//
// Xu has no interface values, so the FS implementation is concrete
// `os.DirFS` (Go os.DirFS). Package functions take `&os.DirFS`.
// Open is the method on DirFS (Go FS.Open), not a package function.

// Method set of Go fs.FS / fs.File (constraints only; no interface values).
struct@ FS {
    fn open(string) os.File
}

struct@ File {
    fn read(int) string
    fn close() int
}

// FileInfo is the language builtin (M35: size / is_dir / mode), same as
// os.Stat — Go fs.FileInfo.Name() is path.base of the lookup name.

pub struct DirEntry {
    pub name string
    pub is_dir bool
}

// valid_path is Go fs.ValidPath: unrooted slash-separated name; "." is
// the only allowed "." / empty / ".." exception (the FS root).
pub fn valid_path(name &string) bool {
    n := name.len
    if n == 0 {
        << false
    }
    if n == 1 && (name[0] & 255) == 46 {
        << true
    }
    mut start := 0
    mut k := 0
    while k <= n {
        if k < n {
            ch := name[k] & 255
            // Go fs.ValidPath: backslash and NUL are never valid.
            if ch == 92 || ch == 0 {
                << false
            }
        }
        if k == n || (name[k] & 255) == 47 {
            elen := k - start
            if elen == 0 {
                << false
            }
            if elen == 1 && (name[start] & 255) == 46 {
                << false
            }
            if elen == 2 && (name[start] & 255) == 46 && (name[start + 1] & 255) == 46 {
                << false
            }
            start = k + 1
        }
        k = k + 1
    }
    << true
}

pub fn read_file(fsys &os.DirFS, name string) string {
    << fsys.read_file(name) or >>
}

pub fn read_dir(fsys &os.DirFS, name string) []DirEntry {
    ents := fsys.read_dir(name) or >>
    mut out := []DirEntry{}
    mut i := 0
    while i < ents.len {
        nm := ents[i].name + ""
        d := ents[i].is_dir
        out.push(DirEntry{name: nm, is_dir: d})
        i = i + 1
    }
    << out
}

pub fn stat(fsys &os.DirFS, name string) FileInfo {
    << fsys.stat(name) or >>
}

pub fn sub(fsys &os.DirFS, dir string) os.DirFS {
    << fsys.sub(dir) or >>
}
