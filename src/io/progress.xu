@io

#errors

// Owned chunks; terminal conditions may accompany the last bytes.
pub enum ReadResult {
    Data(string)
    End(string)
    Failed(string, errors.Error)
}

// Counts acknowledge a prefix of this call's input. Unknown is required
// when a legacy operation throws after effects it cannot quantify.
pub enum WriteResult {
    Written(int)
    Failed(int, errors.Error)
    Unknown(errors.Error)
}

// Failed has an exact accepted count; Uncertain has a confirmed lower bound.
pub enum CopyResult {
    Copied(int)
    Failed(int, errors.Error)
    Uncertain(int, errors.Error)
}

pub struct@ ProgressReader {
    fn read_result(int) ReadResult
}

pub struct@ ProgressWriter {
    fn write_result(string) WriteResult
}

// Legacy readers cannot recover bytes that were lost when throwing.
pub struct LegacyReader#R:StreamReader { pub src R }
pub struct LegacyWriter#W:StreamWriter { pub dst W }

pub fn progress_reader#R:StreamReader(src R) LegacyReader#R {
    << LegacyReader#R{src: src}
}

pub fn progress_writer#W:StreamWriter(dst W) LegacyWriter#W {
    << LegacyWriter#W{dst: dst}
}

pub fn (r &mut LegacyReader#R) read_result(n int) ReadResult {
    if n < 0 { << ReadResult.Failed("", errors.new("io: invalid count")) }
    if n == 0 { << ReadResult.Data("") }
    src := mut &r.src
    data := src.read_n(n) or (err) {
        if err.msg() == eof { << ReadResult.End("") }
        << ReadResult.Failed("", err)
    }
    if data.len > n { << ReadResult.Failed("", errors.new("io: invalid read count")) }
    if data.len == 0 { << ReadResult.End("") }
    << ReadResult.Data(data)
}

pub fn (w &mut LegacyWriter#W) write_result(data string) WriteResult {
    if data.len == 0 { << WriteResult.Written(0) }
    dst := mut &w.dst
    n := dst.write_str(data) or (err) { << WriteResult.Unknown(err) }
    << WriteResult.Written(n)
}

// Bounded owning strings, no shared byte views or unbounded retry loops.
// Destination errors win if both endpoints report terminal errors.
fn copy_progress#W:ProgressWriter,R:ProgressReader(dst &mut W, src &mut R, size int, limit int) CopyResult {
    if size <= 0 { << CopyResult.Failed(0, errors.new("io: invalid buffer size")) }
    mut total := 0
    while limit < 0 || total < limit {
        mut request := size
        if limit >= 0 && request > limit - total { request = limit - total }
        incoming := src.read_result(request) or (err) { << CopyResult.Failed(total, err) }
        match incoming {
            ReadResult.Data(data) {
                if data.len == 0 { << CopyResult.Failed(total, errors.new("io: no progress")) }
                if data.len > request { << CopyResult.Failed(total, errors.new("io: invalid read count")) }
                if total > 9223372036854775807 - data.len { << CopyResult.Failed(total, errors.new("io: copy count overflow")) }
                count := data.len
                written := dst.write_result(data) or (err) { << CopyResult.Uncertain(total, err) }
                match written {
                    WriteResult.Written(n) {
                        if n < 0 || n > count { << CopyResult.Uncertain(total, errors.new("io: invalid write count")) }
                        total += n
                        if n != count { << CopyResult.Failed(total, errors.new("short write")) }
                    }
                    WriteResult.Failed(n, err) {
                        if n < 0 || n > count { << CopyResult.Uncertain(total, errors.new("io: invalid write count")) }
                        << CopyResult.Failed(total + n, err)
                    }
                    WriteResult.Unknown(err) { << CopyResult.Uncertain(total, err) }
                }
            }
            ReadResult.End(data) {
                if data.len > request { << CopyResult.Failed(total, errors.new("io: invalid read count")) }
                if total > 9223372036854775807 - data.len { << CopyResult.Failed(total, errors.new("io: copy count overflow")) }
                count := data.len
                if count > 0 {
                    written := dst.write_result(data) or (err) { << CopyResult.Uncertain(total, err) }
                    match written {
                        WriteResult.Written(n) {
                            if n < 0 || n > count { << CopyResult.Uncertain(total, errors.new("io: invalid write count")) }
                            total += n
                            if n != count { << CopyResult.Failed(total, errors.new("short write")) }
                        }
                        WriteResult.Failed(n, err) {
                            if n < 0 || n > count { << CopyResult.Uncertain(total, errors.new("io: invalid write count")) }
                            << CopyResult.Failed(total + n, err)
                        }
                        WriteResult.Unknown(err) { << CopyResult.Uncertain(total, err) }
                    }
                }
                if limit >= 0 && total < limit { << CopyResult.Failed(total, errors.new(eof)) }
                << CopyResult.Copied(total)
            }
            ReadResult.Failed(data, read_err) {
                if data.len > request { << CopyResult.Failed(total, errors.new("io: invalid read count")) }
                if total > 9223372036854775807 - data.len { << CopyResult.Failed(total, errors.new("io: copy count overflow")) }
                count := data.len
                if count > 0 {
                    written := dst.write_result(data) or (err) { << CopyResult.Uncertain(total, err) }
                    match written {
                        WriteResult.Written(n) {
                            if n < 0 || n > count { << CopyResult.Uncertain(total, errors.new("io: invalid write count")) }
                            total += n
                            if n != count { << CopyResult.Failed(total, errors.new("short write")) }
                        }
                        WriteResult.Failed(n, err) {
                            if n < 0 || n > count { << CopyResult.Uncertain(total, errors.new("io: invalid write count")) }
                            << CopyResult.Failed(total + n, err)
                        }
                        WriteResult.Unknown(err) { << CopyResult.Uncertain(total, err) }
                    }
                }
                << CopyResult.Failed(total, read_err)
            }
        }
    }
    << CopyResult.Copied(total)
}

pub fn copy_result#W:ProgressWriter,R:ProgressReader(dst &mut W, src &mut R) CopyResult {
    << copy_progress(dst, src, copy_chunk, -1)
}

pub fn copy_result_buffer#W:ProgressWriter,R:ProgressReader(dst &mut W, src &mut R, size int) CopyResult {
    << copy_progress(dst, src, size, -1)
}

pub fn copy_result_n#W:ProgressWriter,R:ProgressReader(dst &mut W, src &mut R, n int) CopyResult {
    if n < 0 { << CopyResult.Failed(0, errors.new("io: invalid count")) }
    << copy_progress(dst, src, copy_chunk, n)
}

pub fn (c &mut Cursor) read_result(n int) ReadResult {
    if n < 0 { << ReadResult.Failed("", errors.new("io: invalid count")) }
    if n == 0 { << ReadResult.Data("") }
    data := c.read_n(n)
    if c.off >= c.data.len { << ReadResult.End(data) }
    << ReadResult.Data(data)
}

pub fn (b &mut Buffer) read_result(n int) ReadResult {
    if n < 0 { << ReadResult.Failed("", errors.new("io: invalid count")) }
    if n == 0 { << ReadResult.Data("") }
    data := b.read_n(n)
    if b.off >= b.data.len { << ReadResult.End(data) }
    << ReadResult.Data(data)
}

pub fn (b &mut Buffer) write_result(data string) WriteResult {
    << WriteResult.Written(b.write_str(data))
}

pub fn (d &mut Discard) write_result(data string) WriteResult {
    << WriteResult.Written(data.len)
}

// ReadInto reports how many bytes were stored in the caller's buffer.
// The destination is exclusively borrowed for the call and is never grown.
// The result owns only the count and error; it does not borrow the buffer.
// Bytes outside the written prefix stay unchanged. A zero count performs no I/O.
pub enum ReadInto {
    Filled(int)
    End(int)
    Failed(int, errors.Error)
}

// 0 = usable window, 1 = negative count, 2 = window outside dst.
fn read_into_window(dst_len int, off int, n int) int {
    if off < 0 || n < 0 {
        << 1
    }
    if off > dst_len {
        << 2
    }
    if n > dst_len - off {
        << 2
    }
    << 0
}

fn read_into_reject(code int) ReadInto {
    if code == 1 {
        << ReadInto.Failed(0, errors.new("io: invalid count"))
    }
    << ReadInto.Failed(0, errors.new("io: buffer too small"))
}

fn write_window_at(dst &mut []int, off int, data &string, start int, n int) {
    mut i := 0
    while i < n {
        dst[off + i] = data[start + i] & 255
        i = i + 1
    }
}

fn take_into(dst &mut []int, off int, data &string, start int, available int, n int) int {
    mut take := n
    if take > available {
        take = available
    }
    if take > 0 {
        write_window_at(dst, off, data, start, take)
    }
    << take
}

pub fn (c &mut Cursor) read_into(dst &mut []int, off int, n int) ReadInto {
    code := read_into_window(dst.len, off, n)
    if code != 0 {
        << read_into_reject(code)
    }
    if n == 0 {
        << ReadInto.Filled(0)
    }
    mut rest := 0
    if c.off < c.data.len {
        rest = c.data.len - c.off
    }
    if rest == 0 {
        << ReadInto.End(0)
    }
    take := take_into(dst, off, &c.data, c.off, rest, n)
    c.off = c.off + take
    if c.off >= c.data.len {
        << ReadInto.End(take)
    }
    << ReadInto.Filled(take)
}

pub fn (b &mut Buffer) read_into(dst &mut []int, off int, n int) ReadInto {
    code := read_into_window(dst.len, off, n)
    if code != 0 {
        << read_into_reject(code)
    }
    if n == 0 {
        << ReadInto.Filled(0)
    }
    mut rest := 0
    if b.off < b.data.len {
        rest = b.data.len - b.off
    }
    if rest == 0 {
        << ReadInto.End(0)
    }
    take := take_into(dst, off, &b.data, b.off, rest, n)
    b.off = b.off + take
    if b.off >= b.data.len {
        << ReadInto.End(take)
    }
    << ReadInto.Filled(take)
}

// One synchronous read_result, then a copy into the exclusive window.
// The temporary owned chunk dies before return. Invalid counts are not stored.
// This does not retry and does not replace Cursor/Buffer.read_into.
pub fn read_into#R:ProgressReader(src &mut R, dst &mut []int, off int, n int) ReadInto {
    code := read_into_window(dst.len, off, n)
    if code != 0 {
        << read_into_reject(code)
    }
    if n == 0 {
        << ReadInto.Filled(0)
    }
    incoming := src.read_result(n) or (err) {
        << ReadInto.Failed(0, err)
    }
    match incoming {
        ReadResult.Data(data) {
            count := data.len
            if count == 0 {
                << ReadInto.Failed(0, errors.new("io: no progress"))
            }
            if count > n {
                << ReadInto.Failed(0, errors.new("io: invalid read count"))
            }
            write_window_at(dst, off, &data, 0, count)
            << ReadInto.Filled(count)
        }
        ReadResult.End(data) {
            count := data.len
            if count > n {
                << ReadInto.Failed(0, errors.new("io: invalid read count"))
            }
            if count > 0 {
                write_window_at(dst, off, &data, 0, count)
            }
            << ReadInto.End(count)
        }
        ReadResult.Failed(data, err) {
            count := data.len
            if count > n {
                << ReadInto.Failed(0, errors.new("io: invalid read count"))
            }
            if count > 0 {
                write_window_at(dst, off, &data, 0, count)
            }
            << ReadInto.Failed(count, err)
        }
    }
    << ReadInto.Filled(0)
}
