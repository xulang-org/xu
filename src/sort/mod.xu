@sort

#cmp

// In-place sorts. Large integer arrays use signed MSD byte radix buckets;
// short arrays use introsort (insertion / Hoare partition / heap fallback).
// Float and string arrays retain introsort, using Tukey ninther for n>40
// and median-of-3 otherwise. Strings compare via cmp.less_string by index
// so owning strings are not held across a call (M2b). Generic slice#T:Ord
// and slice_func retain iterative heapsort. These are ordinary Xu routines
// using the same MIR and register planner as user code.
// Builtins int/string/f64 auto-satisfy Ord; user structs need
// fn (t T) less(other T) bool. Callers pass mut &a.

const INSERT = 16
// Small integer buckets avoid an extra pivot/partition call below 32.
const INSERT_INT = 32

fn log_limit(n int) int {
    mut v := n
    mut r := 0
    while v > 1 {
        v = v >> 1
        r += 1
    }
    << r + r
}

fn int_stack(n int) []int {
    mut a := []int{}
    mut i := 0
    while i < n {
        a.push(0)
        i += 1
    }
    << a
}

fn insertion_ints(a &mut []int, lo int, hi int) {
    mut i := lo + 1
    while i < hi {
        v := a[i]
        mut j := i
        while j > lo {
            previous := a[j - 1]
            if previous <= v {
                <-
            }
            a[j] = previous
            j -= 1
        }
        a[j] = v
        i += 1
    }
}

fn sift_ints(a &mut []int, lo int, hi int, start int) {
    mut root := start
    mut done := 0
    while done == 0 {
        mut child := lo + (root - lo) * 2 + 1
        if child >= hi {
            done = 1
        } else {
            if child + 1 < hi {
                if a[child] < a[child + 1] {
                    child += 1
                }
            }
            if a[root] < a[child] {
                t := a[root]
                a[root] = a[child]
                a[child] = t
                root = child
            } else {
                done = 1
            }
        }
    }
}

fn heapsort_ints(a &mut []int, lo int, hi int) {
    n := hi - lo
    if n < 2 {
        <<
    }
    mut start := lo + (n >> 1) - 1
    mut building := 1
    while building == 1 {
        sift_ints(a, lo, hi, start)
        if start == lo {
            building = 0
        } else {
            start -= 1
        }
    }
    mut end := hi - 1
    while end > lo {
        t := a[lo]
        a[lo] = a[end]
        a[end] = t
        sift_ints(a, lo, end, lo)
        end -= 1
    }
}

fn med3_ints(a &mut []int, i int, j int, k int) int {
    vi := a[i]
    vj := a[j]
    vk := a[k]
    if vi < vj {
        if vj < vk {
            << j
        }
        if vi < vk {
            << k
        }
        << i
    }
    if vj > vk {
        << j
    }
    if vi > vk {
        << k
    }
    << i
}

fn pivot_ints(a &mut []int, lo int, hi int) int {
    n := hi - lo
    mid := lo + (n >> 1)
    last := hi - 1
    if n > 40 {
        s := n / 8
        l := med3_ints(a, lo, lo + s, lo + s * 2)
        m := med3_ints(a, mid - s, mid, mid + s)
        r := med3_ints(a, last - s * 2, last - s, last)
        << med3_ints(a, l, m, r)
    }
    << med3_ints(a, lo, mid, last)
}

fn partition_ints(a &mut []int, lo int, hi int) int {
    pidx := pivot_ints(a, lo, hi)
    v := a[pidx]
    t0 := a[lo]
    a[lo] = v
    a[pidx] = t0
    mut i := lo
    mut j := hi
    while true {
        i += 1
        while i < hi {
            if a[i] >= v {
                <-
            }
            i += 1
        }
        j -= 1
        while j > lo {
            if a[j] <= v {
                <-
            }
            j -= 1
        }
        if i >= j {
            t := a[lo]
            a[lo] = a[j]
            a[j] = t
            << j
        }
        t2 := a[i]
        a[i] = a[j]
        a[j] = t2
    }
    << lo
}

// Recurse into the smaller side and iterate over the larger one.
// Nested ranges at least halve, so call-stack depth is logarithmic.
fn intro_ints(a &mut []int, lo0 int, hi0 int, depth0 int) {
    mut lo := lo0
    mut hi := hi0
    mut depth := depth0
    while hi - lo >= INSERT_INT {
        if depth == 0 {
            heapsort_ints(a, lo, hi)
            <<
        }
        depth -= 1
        p := partition_ints(a, lo, hi)
        if p - lo < hi - p - 1 {
            if p - lo >= 2 { intro_ints(a, lo, p, depth) }
            lo = p + 1
        } else {
            if hi - p - 1 >= 2 { intro_ints(a, p + 1, hi, depth) }
            hi = p
        }
    }
    insertion_ints(a, lo, hi)
}

fn insertion_f64s(a &mut []f64, lo int, hi int) {
    mut i := lo + 1
    while i < hi {
        v := a[i]
        mut j := i
        while j > lo {
            if a[j - 1] <= v {
                <-
            }
            a[j] = a[j - 1]
            j -= 1
        }
        a[j] = v
        i += 1
    }
}

fn sift_f64s(a &mut []f64, lo int, hi int, start int) {
    mut root := start
    mut done := 0
    while done == 0 {
        mut child := lo + (root - lo) * 2 + 1
        if child >= hi {
            done = 1
        } else {
            if child + 1 < hi {
                if a[child] < a[child + 1] {
                    child += 1
                }
            }
            if a[root] < a[child] {
                t := a[root]
                a[root] = a[child]
                a[child] = t
                root = child
            } else {
                done = 1
            }
        }
    }
}

fn heapsort_f64s(a &mut []f64, lo int, hi int) {
    n := hi - lo
    if n < 2 {
        <<
    }
    mut start := lo + (n >> 1) - 1
    mut building := 1
    while building == 1 {
        sift_f64s(a, lo, hi, start)
        if start == lo {
            building = 0
        } else {
            start -= 1
        }
    }
    mut end := hi - 1
    while end > lo {
        t := a[lo]
        a[lo] = a[end]
        a[end] = t
        sift_f64s(a, lo, end, lo)
        end -= 1
    }
}

fn med3_f64s(a &mut []f64, i int, j int, k int) int {
    if a[i] < a[j] {
        if a[j] < a[k] {
            << j
        }
        if a[i] < a[k] {
            << k
        }
        << i
    }
    if a[j] > a[k] {
        << j
    }
    if a[i] > a[k] {
        << k
    }
    << i
}

fn pivot_f64s(a &mut []f64, lo int, hi int) int {
    n := hi - lo
    mid := lo + (n >> 1)
    last := hi - 1
    if n > 40 {
        s := n / 8
        l := med3_f64s(a, lo, lo + s, lo + s * 2)
        m := med3_f64s(a, mid - s, mid, mid + s)
        r := med3_f64s(a, last - s * 2, last - s, last)
        << med3_f64s(a, l, m, r)
    }
    << med3_f64s(a, lo, mid, last)
}

fn partition_f64s(a &mut []f64, lo int, hi int) int {
    last := hi - 1
    pidx := pivot_f64s(a, lo, hi)
    t0 := a[pidx]
    a[pidx] = a[last]
    a[last] = t0
    v := a[last]
    mut i := lo
    mut j := lo
    while j < last {
        if a[j] < v {
            t := a[i]
            a[i] = a[j]
            a[j] = t
            i += 1
        }
        j += 1
    }
    t2 := a[i]
    a[i] = a[last]
    a[last] = t2
    << i
}

fn intro_f64s(a &mut []f64, lo0 int, hi0 int, depth0 int) {
    mut capn := depth0 + 2
    if capn < 4 {
        capn = 4
    }
    mut slo := int_stack(capn)
    mut shi := int_stack(capn)
    mut sd := int_stack(capn)
    slo[0] = lo0
    shi[0] = hi0
    sd[0] = depth0
    mut top := 1
    while top > 0 {
        top -= 1
        lo := slo[top]
        hi := shi[top]
        depth := sd[top]
        n := hi - lo
        if n < INSERT {
            insertion_f64s(a, lo, hi)
        } else if depth == 0 {
            heapsort_f64s(a, lo, hi)
        } else {
            p := partition_f64s(a, lo, hi)
            d2 := depth - 1
            left := p - lo
            right := hi - p - 1
            mut a_lo := lo
            mut a_hi := p
            mut b_lo := p + 1
            mut b_hi := hi
            if left >= right {
                a_lo = p + 1
                a_hi = hi
                b_lo = lo
                b_hi = p
            }
            if a_hi - a_lo >= 2 {
                if top == slo.len {
                    slo.push(a_lo)
                    shi.push(a_hi)
                    sd.push(d2)
                } else {
                    slo[top] = a_lo
                    shi[top] = a_hi
                    sd[top] = d2
                }
                top += 1
            }
            if b_hi - b_lo >= 2 {
                if top == slo.len {
                    slo.push(b_lo)
                    shi.push(b_hi)
                    sd.push(d2)
                } else {
                    slo[top] = b_lo
                    shi[top] = b_hi
                    sd[top] = d2
                }
                top += 1
            }
        }
    }
}

fn str_lt(a &mut []string, i int, j int) bool {
    << cmp.less_string(a[i], a[j])
}

fn swap_str(a &mut []string, i int, j int) {
    if i == j {
        <<
    }
    t := a[i]
    a[i] = a[j]
    a[j] = t
}

fn insertion_strings(a &mut []string, lo int, hi int) {
    mut i := lo + 1
    while i < hi {
        mut j := i
        while j > lo {
            if !str_lt(a, j, j - 1) {
                <-
            }
            swap_str(a, j, j - 1)
            j -= 1
        }
        i += 1
    }
}

fn sift_strings(a &mut []string, lo int, hi int, start int) {
    mut root := start
    mut done := 0
    while done == 0 {
        mut child := lo + (root - lo) * 2 + 1
        if child >= hi {
            done = 1
        } else {
            if child + 1 < hi {
                if str_lt(a, child, child + 1) {
                    child += 1
                }
            }
            if str_lt(a, root, child) {
                swap_str(a, root, child)
                root = child
            } else {
                done = 1
            }
        }
    }
}

fn heapsort_strings(a &mut []string, lo int, hi int) {
    n := hi - lo
    if n < 2 {
        <<
    }
    mut start := lo + (n >> 1) - 1
    mut building := 1
    while building == 1 {
        sift_strings(a, lo, hi, start)
        if start == lo {
            building = 0
        } else {
            start -= 1
        }
    }
    mut end := hi - 1
    while end > lo {
        swap_str(a, lo, end)
        sift_strings(a, lo, end, lo)
        end -= 1
    }
}

fn med3_strings(a &mut []string, i int, j int, k int) int {
    if str_lt(a, i, j) {
        if str_lt(a, j, k) {
            << j
        }
        if str_lt(a, i, k) {
            << k
        }
        << i
    }
    if str_lt(a, k, j) {
        << j
    }
    if str_lt(a, k, i) {
        << k
    }
    << i
}

fn pivot_strings(a &mut []string, lo int, hi int) int {
    n := hi - lo
    mid := lo + (n >> 1)
    last := hi - 1
    if n > 40 {
        s := n / 8
        l := med3_strings(a, lo, lo + s, lo + s * 2)
        m := med3_strings(a, mid - s, mid, mid + s)
        r := med3_strings(a, last - s * 2, last - s, last)
        << med3_strings(a, l, m, r)
    }
    << med3_strings(a, lo, mid, last)
}

fn partition_strings(a &mut []string, lo int, hi int) int {
    pidx := pivot_strings(a, lo, hi)
    swap_str(a, lo, pidx)
    mut i := lo
    mut j := hi
    while true {
        i += 1
        while i < hi {
            if !str_lt(a, i, lo) {
                <-
            }
            i += 1
        }
        j -= 1
        while j > lo {
            if !str_lt(a, lo, j) {
                <-
            }
            j -= 1
        }
        if i >= j {
            swap_str(a, lo, j)
            << j
        }
        swap_str(a, i, j)
    }
    << lo
}

fn intro_strings(a &mut []string, lo0 int, hi0 int, depth0 int) {
    mut capn := depth0 + 2
    if capn < 4 {
        capn = 4
    }
    mut slo := int_stack(capn)
    mut shi := int_stack(capn)
    mut sd := int_stack(capn)
    slo[0] = lo0
    shi[0] = hi0
    sd[0] = depth0
    mut top := 1
    while top > 0 {
        top -= 1
        lo := slo[top]
        hi := shi[top]
        depth := sd[top]
        n := hi - lo
        if n < INSERT {
            insertion_strings(a, lo, hi)
        } else if depth == 0 {
            heapsort_strings(a, lo, hi)
        } else {
            p := partition_strings(a, lo, hi)
            d2 := depth - 1
            left := p - lo
            right := hi - p - 1
            mut a_lo := lo
            mut a_hi := p
            mut b_lo := p + 1
            mut b_hi := hi
            if left >= right {
                a_lo = p + 1
                a_hi = hi
                b_lo = lo
                b_hi = p
            }
            if a_hi - a_lo >= 2 {
                if top == slo.len {
                    slo.push(a_lo)
                    shi.push(a_hi)
                    sd.push(d2)
                } else {
                    slo[top] = a_lo
                    shi[top] = a_hi
                    sd[top] = d2
                }
                top += 1
            }
            if b_hi - b_lo >= 2 {
                if top == slo.len {
                    slo.push(b_lo)
                    shi.push(b_hi)
                    sd.push(d2)
                } else {
                    slo[top] = b_lo
                    shi[top] = b_hi
                    sd[top] = d2
                }
                top += 1
            }
        }
    }
}

pub fn slice#T:Ord(a &mut []T) {
    n := a.len
    if n < 2 {
        <<
    }
    mut start := (n >> 1) - 1
    mut phase := 0
    while phase == 0 {
        mut root := start
        mut done := 0
        while done == 0 {
            mut child := root * 2 + 1
            if child >= n {
                done = 1
            } else {
                if child + 1 < n {
                    c0 := a[child]
                    c1 := a[child + 1]
                    if c0.less(c1) {
                        child += 1
                    }
                }
                r0 := a[root]
                c2 := a[child]
                if r0.less(c2) {
                    t := a[root]
                    a[root] = a[child]
                    a[child] = t
                    root = child
                } else {
                    done = 1
                }
            }
        }
        if start == 0 {
            phase = 1
        } else {
            start -= 1
        }
    }
    mut end := n - 1
    mut phase2 := 0
    while phase2 == 0 {
        t := a[0]
        a[0] = a[end]
        a[end] = t
        if end == 0 {
            phase2 = 1
        } else {
            end -= 1
            mut root2 := 0
            mut done2 := 0
            while done2 == 0 {
                mut child2 := root2 * 2 + 1
                if child2 > end {
                    done2 = 1
                } else {
                    if child2 + 1 <= end {
                        d0 := a[child2]
                        d1 := a[child2 + 1]
                        if d0.less(d1) {
                            child2 += 1
                        }
                    }
                    e0 := a[root2]
                    e1 := a[child2]
                    if e0.less(e1) {
                        t2 := a[root2]
                        a[root2] = a[child2]
                        a[child2] = t2
                        root2 = child2
                    } else {
                        done2 = 1
                    }
                }
            }
        }
    }
}

// Signed order differs from unsigned order only in the most significant
// byte: xor its bucket with 128 to put negative values first. Lower bytes
// use ordinary unsigned order. Shifts and masks avoid signed subtraction.
// Bucket cursors advance to their precomputed ends. Cycle swaps place each
// displaced value into the next free slot of its own bucket; every slot is
// consumed exactly once. At most eight radix levels retain two 256-word
// tables each (32 KiB of integer payload, independent of input length).
// Leaves below 128 use bounded-depth introsort; no full-size copy is made.
// The global varying mask also skips common bytes between active bytes.
// Children contain a subset of the input, so globally common bytes stay common.
fn radix_ints(a &mut []int, lo int, hi int, shift int, varying int) {
    if hi - lo < 128 {
        intro_ints(a, lo, hi, log_limit(hi - lo))
        <<
    }
    mut ends := int_stack(256)
    mut next := int_stack(256)
    mut bias := 0
    if shift == 56 { bias = 128 }
    for i in lo:hi {
        b := ((a[i] >> shift) & 255) ^ bias
        ends[b] += 1
    }
    mut sum := lo
    for b in 0:256 {
        next[b] = sum
        sum += ends[b]
        ends[b] = sum
    }
    for b in 0:256 {
        // The inner cycle only reads cursors of other buckets. Keep this
        // bucket's cursor local, then publish its end for later buckets.
        mut i := next[b]
        end := ends[b]
        while i < end {
            mut v := a[i]
            mut bucket := ((v >> shift) & 255) ^ bias
            while bucket != b {
                j := next[bucket]
                t := a[j]
                a[j] = v
                next[bucket] = j + 1
                v = t
                bucket = ((v >> shift) & 255) ^ bias
            }
            a[i] = v
            i += 1
        }
        next[b] = end
    }
    mut next_shift := shift - 8
    while next_shift >= 0 {
        if ((varying >> next_shift) & 255) != 0 { <- }
        next_shift -= 8
    }
    if next_shift >= 0 {
        mut start := lo
        for b in 0:256 {
            end := ends[b]
            if end - start >= 2 { radix_ints(a, start, end, next_shift, varying) }
            start = end
        }
    }
}

// Skip shared high bytes; varying != 0 guarantees a byte is found.
fn radix_start_ints(a &mut []int) {
    first := a[0]
    mut varying := 0
    for i in 1:a.len { varying = varying | (a[i] ^ first) }
    if varying == 0 { << }
    mut shift := 56
    while ((varying >> shift) & 255) == 0 { shift -= 8 }
    radix_ints(a, 0, a.len, shift, varying)
}

fn descending_ints(a &[]int) bool {
    for i in 1:a.len { if a[i] > a[i - 1] { << false } }
    << true
}

pub fn ints(a &mut []int) {
    n := a.len
    if n < 2 { << }
    if n < 128 {
        intro_ints(a, 0, n, log_limit(n))
        <<
    }
    if is_sorted_ints(&*a) { << }
    if descending_ints(&*a) {
        flip_ints(a)
        <<
    }
    radix_start_ints(a)
}

pub fn strings(a &mut []string) {
    n := a.len
    if n < 2 {
        <<
    }
    intro_strings(a, 0, n, log_limit(n))
}

pub fn f64s(a &mut []f64) {
    n := a.len
    if n < 2 {
        <<
    }
    intro_f64s(a, 0, n, log_limit(n))
}

// Small integer ranges and f64s use introsort. Generic `slice_func` keeps the original
// heapsort so owning T and fn-values stay on the M2b-safe path.
pub fn slice_func#T(a &mut []T, less fn(T, T) bool) {
    n := a.len
    if n < 2 {
        <<
    }
    mut start := (n >> 1) - 1
    mut phase := 0
    while phase == 0 {
        mut root := start
        mut done := 0
        while done == 0 {
            mut child := root * 2 + 1
            if child >= n {
                done = 1
            } else {
                if child + 1 < n {
                    c0 := a[child]
                    c1 := a[child + 1]
                    if less(c0, c1) {
                        child += 1
                    }
                }
                r0 := a[root]
                c2 := a[child]
                if less(r0, c2) {
                    t := a[root]
                    a[root] = a[child]
                    a[child] = t
                    root = child
                } else {
                    done = 1
                }
            }
        }
        if start == 0 {
            phase = 1
        } else {
            start -= 1
        }
    }
    mut end := n - 1
    mut phase2 := 0
    while phase2 == 0 {
        t := a[0]
        a[0] = a[end]
        a[end] = t
        if end == 0 {
            phase2 = 1
        } else {
            end -= 1
            mut root2 := 0
            mut done2 := 0
            while done2 == 0 {
                mut child2 := root2 * 2 + 1
                if child2 > end {
                    done2 = 1
                } else {
                    if child2 + 1 <= end {
                        d0 := a[child2]
                        d1 := a[child2 + 1]
                        if less(d0, d1) {
                            child2 += 1
                        }
                    }
                    e0 := a[root2]
                    e1 := a[child2]
                    if less(e0, e1) {
                        t2 := a[root2]
                        a[root2] = a[child2]
                        a[child2] = t2
                        root2 = child2
                    } else {
                        done2 = 1
                    }
                }
            }
        }
    }
}

fn str_less(a string, b string) bool {
    << cmp.less_string(a, b)
}

pub struct Search {
    pub index int
    pub found bool
}

pub fn lookup_ints(a &[]int, v int) Search {
    i := search_ints(a, v)
    mut found := false
    if i < a.len {
        if a[i] == v {
            found = true
        }
    }
    << Search{index: i, found: found}
}

pub fn lookup_strings(a &[]string, v string) Search {
    want := v + ""
    i := search_strings(a, want + "")
    mut found := false
    if i < a.len {
        got := a[i] + ""
        if got == want {
            found = true
        }
    }
    << Search{index: i, found: found}
}

pub fn lookup_f64s(a &[]f64, v f64) Search {
    i := search_f64s(a, v)
    mut found := false
    if i < a.len {
        if a[i] == v {
            found = true
        }
    }
    << Search{index: i, found: found}
}

pub fn search_ints(a &[]int, v int) int {
    // Compact binary search: lo/hi/mid stay scalars. `n := a.len` plus
    // `hi := n` lets the checker prove 0 <= mid < n (lo < hi, mid is the
    // half-span, hi is a copy of len) and skip the repeated bounds check.
    n := a.len
    mut lo := 0
    mut hi := n
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        if a[mid] < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    << lo
}

pub fn search_strings(a &[]string, v string) int {
    want := v + ""
    n := a.len
    mut lo := 0
    mut hi := n
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        cur := a[mid] + ""
        w := want + ""
        if str_less(cur, w) {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    << lo
}

pub fn search_f64s(a &[]f64, v f64) int {
    n := a.len
    mut lo := 0
    mut hi := n
    while lo < hi {
        mid := lo + ((hi - lo) >> 1)
        if a[mid] < v {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    << lo
}

pub fn is_sorted_ints(a &[]int) bool {
    for i in 1:a.len {
        if a[i] < a[i - 1] {
            << false
        }
    }
    << true
}

pub fn is_sorted_strings(a &[]string) bool {
    for i in 1:a.len {
        left := a[i] + ""
        right := a[i - 1] + ""
        if str_less(left, right) {
            << false
        }
    }
    << true
}

pub fn is_sorted_f64s(a &[]f64) bool {
    for i in 1:a.len {
        if a[i] < a[i - 1] {
            << false
        }
    }
    << true
}

// Reverse-order sorts (Go sort.Reverse(IntSlice) then Sort). In-package
// reverse after ascending sort — slices.reverse_* is a different API and
// importing slices here would cycle (slices already imports sort).

fn flip_ints(a &mut []int) {
    n := a.len
    for i in 0:(n >> 1) {
        t := a[i]
        a[i] = a[n - 1 - i]
        a[n - 1 - i] = t
    }
}

fn flip_strs(a &mut []string) {
    n := a.len
    for i in 0:(n >> 1) {
        t := a[i]
        a[i] = a[n - 1 - i]
        a[n - 1 - i] = t
    }
}

fn flip_f64s(a &mut []f64) {
    n := a.len
    for i in 0:(n >> 1) {
        t := a[i]
        a[i] = a[n - 1 - i]
        a[n - 1 - i] = t
    }
}

pub fn reverse_ints(a &mut []int) {
    ints(a)
    flip_ints(a)
}

pub fn reverse_strings(a &mut []string) {
    strings(a)
    flip_strs(a)
}

pub fn reverse_f64s(a &mut []f64) {
    f64s(a)
    flip_f64s(a)
}
