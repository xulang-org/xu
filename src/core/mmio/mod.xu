@core/mmio

// Strongly-typed volatile MMIO register wrappers for baremetal kernels and drivers.
// Each wrapper has exact C layout matching its scalar width (`u8`/`u16`/`u32`/`u64`).

@repr("C")
pub struct VolatileU8 {
    raw u8
}

@repr("C")
pub struct VolatileU16 {
    raw u16
}

@repr("C")
pub struct VolatileU32 {
    raw u32
}

@repr("C")
pub struct VolatileU64 {
    raw u64
}

@repr("C")
pub struct ReadOnlyU8 {
    raw u8
}

@repr("C")
pub struct ReadOnlyU16 {
    raw u16
}

@repr("C")
pub struct ReadOnlyU32 {
    raw u32
}

@repr("C")
pub struct ReadOnlyU64 {
    raw u64
}

@repr("C")
pub struct WriteOnlyU8 {
    raw u8
}

@repr("C")
pub struct WriteOnlyU16 {
    raw u16
}

@repr("C")
pub struct WriteOnlyU32 {
    raw u32
}

@repr("C")
pub struct WriteOnlyU64 {
    raw u64
}

pub fn (r &VolatileU8) read() u8 {
    unsafe { << volatile_read((&r.raw) as *raw u8) }
}

pub fn (r $&VolatileU8) write(val u8) {
    unsafe { volatile_write((&r.raw) as *raw u8, val) }
}

pub fn (r $&VolatileU8) set_bits(bits u8) {
    r.write(r.read() | bits)
}

pub fn (r $&VolatileU8) clear_bits(bits u8) {
    cur := r.read()
    r.write(cur ^ (cur & bits))
}

pub fn (r &VolatileU16) read() u16 {
    unsafe { << volatile_read((&r.raw) as *raw u16) }
}

pub fn (r $&VolatileU16) write(val u16) {
    unsafe { volatile_write((&r.raw) as *raw u16, val) }
}

pub fn (r $&VolatileU16) set_bits(bits u16) {
    r.write(r.read() | bits)
}

pub fn (r $&VolatileU16) clear_bits(bits u16) {
    cur := r.read()
    r.write(cur ^ (cur & bits))
}

pub fn (r &VolatileU32) read() u32 {
    unsafe { << volatile_read((&r.raw) as *raw u32) }
}

pub fn (r $&VolatileU32) write(val u32) {
    unsafe { volatile_write((&r.raw) as *raw u32, val) }
}

pub fn (r $&VolatileU32) set_bits(bits u32) {
    r.write(r.read() | bits)
}

pub fn (r $&VolatileU32) clear_bits(bits u32) {
    cur := r.read()
    r.write(cur ^ (cur & bits))
}

pub fn (r &VolatileU64) read() u64 {
    unsafe { << volatile_read((&r.raw) as *raw u64) }
}

pub fn (r $&VolatileU64) write(val u64) {
    unsafe { volatile_write((&r.raw) as *raw u64, val) }
}

pub fn (r $&VolatileU64) set_bits(bits u64) {
    r.write(r.read() | bits)
}

pub fn (r $&VolatileU64) clear_bits(bits u64) {
    cur := r.read()
    r.write(cur ^ (cur & bits))
}

pub fn (r &ReadOnlyU8) read() u8 {
    unsafe { << volatile_read((&r.raw) as *raw u8) }
}

pub fn (r &ReadOnlyU16) read() u16 {
    unsafe { << volatile_read((&r.raw) as *raw u16) }
}

pub fn (r &ReadOnlyU32) read() u32 {
    unsafe { << volatile_read((&r.raw) as *raw u32) }
}

pub fn (r &ReadOnlyU64) read() u64 {
    unsafe { << volatile_read((&r.raw) as *raw u64) }
}

pub fn (r $&WriteOnlyU8) write(val u8) {
    unsafe { volatile_write((&r.raw) as *raw u8, val) }
}

pub fn (r $&WriteOnlyU16) write(val u16) {
    unsafe { volatile_write((&r.raw) as *raw u16, val) }
}

pub fn (r $&WriteOnlyU32) write(val u32) {
    unsafe { volatile_write((&r.raw) as *raw u32, val) }
}

pub fn (r $&WriteOnlyU64) write(val u64) {
    unsafe { volatile_write((&r.raw) as *raw u64, val) }
}

pub fn read8(base u64, off u64) u8 {
    unsafe { << volatile_read((base + off) as *raw u8) }
}

pub fn read16(base u64, off u64) u16 {
    unsafe { << volatile_read((base + off) as *raw u16) }
}

pub fn read32(base u64, off u64) u32 {
    unsafe { << volatile_read((base + off) as *raw u32) }
}

pub fn read64(base u64, off u64) u64 {
    unsafe { << volatile_read((base + off) as *raw u64) }
}

pub fn write8(base u64, off u64, val u8) {
    unsafe { volatile_write((base + off) as *raw u8, val) }
}

pub fn write16(base u64, off u64, val u16) {
    unsafe { volatile_write((base + off) as *raw u16, val) }
}

pub fn write32(base u64, off u64, val u32) {
    unsafe { volatile_write((base + off) as *raw u32, val) }
}

pub fn write64(base u64, off u64, val u64) {
    unsafe { volatile_write((base + off) as *raw u64, val) }
}
