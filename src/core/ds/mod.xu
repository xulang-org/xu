@core/ds

// Zero-allocation freestanding kernel data structures:
// intrusive doubly-linked list, bitmap allocator, and fixed-capacity ring buffer.

#core/mem

// ===== Intrusive Circular Doubly-Linked List =====

@repr("C")
pub struct ListHead {
    pub prev *raw ListHead
    pub next *raw ListHead
}

pub fn list_init(head *raw ListHead) {
    unsafe {
        (*head).prev = head
        (*head).next = head
    }
}

pub fn list_is_empty(head *raw ListHead) bool {
    unsafe { << (*head).next == head }
}

pub fn list_push_front(head *raw ListHead, node *raw ListHead) {
    unsafe {
        first := (*head).next
        (*node).next = first
        (*node).prev = head
        (*first).prev = node
        (*head).next = node
    }
}

pub fn list_push_back(head *raw ListHead, node *raw ListHead) {
    unsafe {
        last := (*head).prev
        (*node).next = head
        (*node).prev = last
        (*last).next = node
        (*head).prev = node
    }
}

pub fn list_remove(node *raw ListHead) {
    unsafe {
        p := (*node).prev
        n := (*node).next
        if p != 0 as *raw ListHead && n != 0 as *raw ListHead {
            (*p).next = n
            (*n).prev = p
        }
        (*node).prev = node
        (*node).next = node
    }
}

pub fn list_pop_front(head *raw ListHead) *raw ListHead {
    if list_is_empty(head) {
        << 0 as *raw ListHead
    }
    unsafe {
        node := (*head).next
        list_remove(node)
        << node
    }
}

// ===== Freestanding BitMap =====

@repr("C")
pub struct BitMap {
    pub words *raw u64
    pub num_bits usize
}

pub fn bitmap_init(bm *raw BitMap, words *raw u64, num_bits usize) {
    unsafe {
        (*bm).words = words
        (*bm).num_bits = num_bits
        num_words := (num_bits + usize(63)) / usize(64)
        mem.memset(words as *raw u8, u8(0), int(num_words) * 8)
    }
}

pub fn (bm &BitMap) test(idx usize) bool {
    if idx >= bm.num_bits || bm.words == 0 as *raw u64 {
        << false
    }
    w_idx := idx / usize(64)
    bit := u64(idx % usize(64))
    unsafe {
        wp := ((bm.words as usize) + w_idx * usize(8)) as *raw u64
        << ((*wp) & (u64(1) << bit)) != u64(0)
    }
}

pub fn (bm $&BitMap) set(idx usize) {
    if idx >= bm.num_bits || bm.words == 0 as *raw u64 {
        <<
    }
    w_idx := idx / usize(64)
    bit := u64(idx % usize(64))
    unsafe {
        wp := ((bm.words as usize) + w_idx * usize(8)) as *raw u64
        *wp = (*wp) | (u64(1) << bit)
    }
}

pub fn (bm $&BitMap) clear(idx usize) {
    if idx >= bm.num_bits || bm.words == 0 as *raw u64 {
        <<
    }
    w_idx := idx / usize(64)
    bit := u64(idx % usize(64))
    mask := u64(1) << bit
    unsafe {
        wp := ((bm.words as usize) + w_idx * usize(8)) as *raw u64
        cur := *wp
        *wp = cur ^ (cur & mask)
    }
}

pub fn (bm &BitMap) find_first_zero() isize {
    $i := usize(0)
    while i < bm.num_bits {
        w_idx := i / usize(64)
        unsafe {
            wp := ((bm.words as usize) + w_idx * usize(8)) as *raw u64
            w := *wp
            if w == (u64(0) - u64(1)) && i + usize(64) <= bm.num_bits {
                i += usize(64)
                ->
            }
            bit := u64(i % usize(64))
            if (w & (u64(1) << bit)) == u64(0) {
                << isize(i)
            }
        }
        i += usize(1)
    }
    << isize(-1)
}

pub fn (bm $&BitMap) alloc_bit() isize {
    pos := bm.find_first_zero()
    if pos >= isize(0) {
        bm.set(usize(pos))
    }
    << pos
}

pub fn (bm $&BitMap) free_bit(idx usize) {
    bm.clear(idx)
}

// ===== Fixed-Capacity Byte Ring Buffer =====

@repr("C")
pub struct RingBufU8 {
    pub buf *raw u8
    pub cap usize
    pub head usize
    pub tail usize
    pub count usize
}

pub fn ringbuf_u8_init(rb *raw RingBufU8, buf *raw u8, cap usize) {
    unsafe {
        (*rb).buf = buf
        (*rb).cap = cap
        (*rb).head = usize(0)
        (*rb).tail = usize(0)
        (*rb).count = usize(0)
    }
}

pub fn (rb &RingBufU8) is_empty() bool {
    << rb.count == usize(0)
}

pub fn (rb &RingBufU8) is_full() bool {
    << rb.count >= rb.cap || rb.cap == usize(0)
}

pub fn (rb &RingBufU8) len() usize {
    << rb.count
}

pub fn (rb $&RingBufU8) push(b u8) bool {
    if rb.cap == usize(0) || rb.is_full() || rb.buf == 0 as *raw u8 {
        << false
    }
    unsafe {
        p := ((rb.buf as usize) + rb.tail) as *raw u8
        *p = b
    }
    $next_tail := rb.tail + usize(1)
    if next_tail >= rb.cap { next_tail = usize(0) }
    rb.tail = next_tail
    rb.count += usize(1)
    << true
}

pub fn (rb $&RingBufU8) pop() int {
    if rb.cap == usize(0) || rb.is_empty() || rb.buf == 0 as *raw u8 {
        << -1
    }
    $val := 0
    unsafe {
        p := ((rb.buf as usize) + rb.head) as *raw u8
        val = int(*p)
    }
    $next_head := rb.head + usize(1)
    if next_head >= rb.cap { next_head = usize(0) }
    rb.head = next_head
    rb.count -= usize(1)
    << val
}
