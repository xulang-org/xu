@core/arch

// Freestanding architecture and CPU control instructions.

pub fn cli() {
    unsafe { asm!("cli") }
}

pub fn sti() {
    unsafe { asm!("sti") }
}

pub fn irq_disable() {
    unsafe { asm!("cli") }
}

pub fn irq_enable() {
    unsafe { asm!("sti") }
}

pub fn halt() {
    unsafe { asm!("hlt") }
}

pub fn pause() {
    unsafe { asm!("pause") }
}

pub fn cpu_relax() {
    unsafe { asm!("pause") }
}

pub fn wfi() {
    unsafe { asm!("wfi") }
}

pub fn fence() {
    unsafe { asm!("dsb sy") }
}

pub fn mb() {
    unsafe { asm!("mb") }
}

pub fn rmb() {
    unsafe { asm!("rmb") }
}

pub fn wmb() {
    unsafe { asm!("wmb") }
}

pub fn compiler_fence() {
    unsafe { asm!("compiler_fence") }
}

// Low-level port I/O routines
