@core/arch

// Freestanding architecture and CPU control instructions.

pub fn cli() {
    unsafe { asm!("cli") }
}

pub fn sti() {
    unsafe { asm!("sti") }
}

pub fn irq_disable() {
    unsafe { asm!("cli") }
}

pub fn irq_enable() {
    unsafe { asm!("sti") }
}

pub fn halt() {
    unsafe { asm!("hlt") }
}

pub fn pause() {
    unsafe { asm!("pause") }
}

pub fn cpu_relax() {
    unsafe { asm!("pause") }
}

pub fn wfi() {
    unsafe { asm!("wfi") }
}

pub fn fence() {
    unsafe { asm!("dsb sy") }
}

pub fn mb() {
    unsafe { asm!("mb") }
}

pub fn rmb() {
    unsafe { asm!("rmb") }
}

pub fn wmb() {
    unsafe { asm!("wmb") }
}

// Low-level port I/O routines
pub extern "C" fn in8(port u16) u8
pub extern "C" fn out8(port u16, val u8)
pub extern "C" fn in16(port u16) u16
pub extern "C" fn out16(port u16, val u16)
pub extern "C" fn in32(port u16) u32
pub extern "C" fn out32(port u16, val u32)

// Control registers and system descriptor table registers
pub extern "C" fn load_idt(ptr *raw IdtPointer)
pub extern "C" fn read_cr2() u64
pub extern "C" fn read_cr3() u64
pub extern "C" fn write_cr3(val u64)
pub extern "C" fn invlpg(addr u64)
pub extern "C" fn set_vbar(addr u64)
pub extern "C" fn set_trap_vector(addr u64)
pub extern "C" fn syscall_entry()

// Interrupt state save/restore (x86_64 RFLAGS.IF, AArch64 DAIF.I,
// RISC-V sstatus.SIE). irq_save disables interrupts and returns the previous
// state; irq_restore re-enables them only if they were enabled in `flags`.
pub extern "C" fn irq_save() u64
pub extern "C" fn irq_restore(flags u64)

// Boot handoff (x64-none): the Multiboot magic (EAX) and info pointer (EBX)
// captured by the built-in Multiboot entry; both are 0 when the image was
// entered through its 64-bit ELF entry point instead.
pub extern "C" fn boot_magic() u64
pub extern "C" fn boot_info_addr() u64

// Hardware atomic primitives (x86_64 LOCK, AArch64 LDXR/STXR + acquire/release,
// RISC-V A-extension AMO/LR-SC) for SMP-safe synchronization.
pub extern "C" fn atomic_load_u32(ptr *raw u32) u32
pub extern "C" fn atomic_store_u32(ptr *raw u32, val u32)
pub extern "C" fn atomic_xchg_u32(ptr *raw u32, val u32) u32
pub extern "C" fn atomic_cas_u32(ptr *raw u32, expected u32, desired u32) u32
pub extern "C" fn atomic_fetch_add_u32(ptr *raw u32, delta u32) u32
pub extern "C" fn atomic_load_u64(ptr *raw u64) u64
pub extern "C" fn atomic_store_u64(ptr *raw u64, val u64)
pub extern "C" fn atomic_xchg_u64(ptr *raw u64, val u64) u64
pub extern "C" fn atomic_cas_u64(ptr *raw u64, expected u64, desired u64) u64
pub extern "C" fn atomic_fetch_add_u64(ptr *raw u64, delta u64) u64

// Extended system registers, GDT/TSS, MSR, and timestamp primitives.
pub const MSR_IA32_APIC_BASE = 0x1B
pub const MSR_IA32_EFER = 0xC0000080
pub const MSR_IA32_STAR = 0xC0000081
pub const MSR_IA32_LSTAR = 0xC0000082
pub const MSR_IA32_FMASK = 0xC0000084
pub const MSR_IA32_FS_BASE = 0xC0000100
pub const MSR_IA32_GS_BASE = 0xC0000101
pub const MSR_IA32_KERNEL_GS_BASE = 0xC0000102

@repr("C", packed)
pub struct GdtPointer {
    pub limit u16
    pub base u64
}

pub extern "C" fn read_cr0() u64
pub extern "C" fn write_cr0(val u64)
pub extern "C" fn read_cr4() u64
pub extern "C" fn write_cr4(val u64)
pub extern "C" fn load_gdt(ptr *raw GdtPointer)
pub extern "C" fn load_tr(sel u16)
pub extern "C" fn rdmsr(msr u32) u64
pub extern "C" fn wrmsr(msr u32, val u64)
pub extern "C" fn rdtsc() u64
pub extern "C" fn swapgs()

@repr("C")
pub struct CpuidResult {
    pub eax u32
    pub ebx u32
    pub ecx u32
    pub edx u32
}

pub extern "C" fn cpuid(leaf u32, subleaf u32, out *raw CpuidResult)
pub extern "C" fn read_rflags() u64
pub extern "C" fn syscall4(nr u64, a0 u64, a1 u64, a2 u64, a3 u64) u64

pub fn syscall0(nr u64) u64 {
    unsafe { << syscall4(nr, u64(0), u64(0), u64(0), u64(0)) }
}

pub fn syscall1(nr u64, a0 u64) u64 {
    unsafe { << syscall4(nr, a0, u64(0), u64(0), u64(0)) }
}

pub fn syscall2(nr u64, a0 u64, a1 u64) u64 {
    unsafe { << syscall4(nr, a0, a1, u64(0), u64(0)) }
}

pub fn syscall3(nr u64, a0 u64, a1 u64, a2 u64) u64 {
    unsafe { << syscall4(nr, a0, a1, a2, u64(0)) }
}

// x86_64 16-byte Interrupt Gate Descriptor
@repr("C")
pub struct IdtEntry {
    pub offset_low u16
    pub selector u16
    pub ist u8
    pub type_attr u8
    pub offset_mid u16
    pub offset_high u32
    pub zero u32
}

// 10-byte packed IDTR pointer for LIDT instruction
@repr("C", packed)
pub struct IdtPointer {
    pub limit u16
    pub base u64
}

// IDT Type and Attribute Flags
pub const IDT_FLAG_PRESENT = 0x80
pub const IDT_FLAG_RING0 = 0x00
pub const IDT_FLAG_RING3 = 0x60
pub const IDT_GATE_INTERRUPT = 0x0E
pub const IDT_GATE_TRAP = 0x0F
pub const IDT_ATTR_INT32 = 0x8E
pub const IDT_ATTR_TRAP32 = 0x8F
pub const IDT_ATTR_USER_INT32 = 0xEE

pub fn (e $&IdtEntry) set_gate(handler u64, selector u16, attr u8) {
    e.offset_low = u16(handler & 0xFFFF)
    e.selector = selector
    e.ist = 0
    e.type_attr = attr
    e.offset_mid = u16((handler >> 16) & 0xFFFF)
    e.offset_high = u32((handler >> 32) & 0xFFFFFFFF)
    e.zero = 0
}

// 8259A Programmable Interrupt Controller (PIC) definitions
pub const PIC1_CMD = 0x20
pub const PIC1_DATA = 0x21
pub const PIC2_CMD = 0xA0
pub const PIC2_DATA = 0xA1
pub const PIC_EOI = 0x20

pub fn pic_remap(offset1 u8, offset2 u8) {
    unsafe {
        // ICW1: start initialization sequence (cascade mode)
        out8(u16(PIC1_CMD), 0x11)
        out8(u16(PIC2_CMD), 0x11)

        // ICW2: Vector offset
        out8(u16(PIC1_DATA), offset1)
        out8(u16(PIC2_DATA), offset2)

        // ICW3: tell Master PIC that there is a slave PIC at IRQ2
        out8(u16(PIC1_DATA), 0x04)
        // ICW3: tell Slave PIC its cascade identity (2)
        out8(u16(PIC2_DATA), 0x02)

        // ICW4: 8086/88 mode
        out8(u16(PIC1_DATA), 0x01)
        out8(u16(PIC2_DATA), 0x01)

        // Leave every line masked: unmasking IRQs for which no IDT gate is
        // installed yet faults as soon as interrupts are enabled. Use
        // pic_unmask(irq) for each line once its handler is in place.
        out8(u16(PIC1_DATA), 0xFF)
        out8(u16(PIC2_DATA), 0xFF)
    }
}

pub fn pic_unmask(irq u8) {
    unsafe {
        if irq >= 8 {
            m := in8(u16(PIC2_DATA))
            out8(u16(PIC2_DATA), m & (u8(255) ^ (u8(1) << (irq - 8))))
            // The slave PIC is cascaded through master line 2.
            m1 := in8(u16(PIC1_DATA))
            out8(u16(PIC1_DATA), m1 & u8(0xFB))
        } else {
            m := in8(u16(PIC1_DATA))
            out8(u16(PIC1_DATA), m & (u8(255) ^ (u8(1) << irq)))
        }
    }
}

pub fn pic_mask(irq u8) {
    unsafe {
        if irq >= 8 {
            m := in8(u16(PIC2_DATA))
            out8(u16(PIC2_DATA), m | (u8(1) << (irq - 8)))
        } else {
            m := in8(u16(PIC1_DATA))
            out8(u16(PIC1_DATA), m | (u8(1) << irq))
        }
    }
}

pub fn pic_eoi(irq u8) {
    unsafe {
        if irq >= 8 {
            out8(u16(PIC2_CMD), u8(PIC_EOI))
        }
        out8(u16(PIC1_CMD), u8(PIC_EOI))
    }
}

pub fn pic_disable() {
    unsafe {
        out8(u16(PIC1_DATA), 0xFF)
        out8(u16(PIC2_DATA), 0xFF)
    }
}

// 8254 Programmable Interval Timer (PIT) definitions
pub const PIT_CHANNEL0 = 0x40
pub const PIT_COMMAND = 0x43
pub const PIT_BASE_FREQ = 1193182

pub fn pit_init(freq_hz u32) {
    if freq_hz == 0 {
        <<
    }
    $divisor := u32(PIT_BASE_FREQ) / freq_hz
    if divisor == 0 {
        divisor = 1
    }
    unsafe {
        // Channel 0, Access lobyte/hibyte, Mode 3 (Square wave generator)
        out8(u16(PIT_COMMAND), 0x36)
        out8(u16(PIT_CHANNEL0), u8(divisor & 0xFF))
        out8(u16(PIT_CHANNEL0), u8((divisor >> 8) & 0xFF))
    }
}
