@core/arch

// Freestanding architecture and CPU control instructions.

pub fn cli() {
    unsafe { asm!("cli") }
}

pub fn sti() {
    unsafe { asm!("sti") }
}

pub fn irq_disable() {
    unsafe { asm!("cli") }
}

pub fn irq_enable() {
    unsafe { asm!("sti") }
}

pub fn halt() {
    unsafe { asm!("hlt") }
}

pub fn pause() {
    unsafe { asm!("pause") }
}

pub fn cpu_relax() {
    unsafe { asm!("pause") }
}

pub fn wfi() {
    unsafe { asm!("wfi") }
}

pub fn fence() {
    unsafe { asm!("dsb sy") }
}

// Low-level port I/O routines
pub extern "C" fn in8(port u16) u8
pub extern "C" fn out8(port u16, val u8)
pub extern "C" fn in16(port u16) u16
pub extern "C" fn out16(port u16, val u16)
pub extern "C" fn in32(port u16) u32
pub extern "C" fn out32(port u16, val u32)

// Control registers and system descriptor table registers
pub extern "C" fn load_idt(ptr *raw IdtPointer)
pub extern "C" fn read_cr2() u64
pub extern "C" fn read_cr3() u64
pub extern "C" fn write_cr3(val u64)
pub extern "C" fn invlpg(addr u64)
pub extern "C" fn set_vbar(addr u64)
pub extern "C" fn set_trap_vector(addr u64)
pub extern "C" fn syscall_entry()

// x86_64 16-byte Interrupt Gate Descriptor
@repr("C")
pub struct IdtEntry {
    pub offset_low u16
    pub selector u16
    pub ist u8
    pub type_attr u8
    pub offset_mid u16
    pub offset_high u32
    pub zero u32
}

// 10-byte packed IDTR pointer for LIDT instruction
@repr("C", packed)
pub struct IdtPointer {
    pub limit u16
    pub base u64
}

// IDT Type and Attribute Flags
pub const IDT_FLAG_PRESENT = 0x80
pub const IDT_FLAG_RING0 = 0x00
pub const IDT_FLAG_RING3 = 0x60
pub const IDT_GATE_INTERRUPT = 0x0E
pub const IDT_GATE_TRAP = 0x0F
pub const IDT_ATTR_INT32 = 0x8E
pub const IDT_ATTR_TRAP32 = 0x8F
pub const IDT_ATTR_USER_INT32 = 0xEE

pub fn (e $&IdtEntry) set_gate(handler u64, selector u16, attr u8) {
    e.offset_low = u16(handler & 0xFFFF)
    e.selector = selector
    e.ist = 0
    e.type_attr = attr
    e.offset_mid = u16((handler >> 16) & 0xFFFF)
    e.offset_high = u32((handler >> 32) & 0xFFFFFFFF)
    e.zero = 0
}

// 8259A Programmable Interrupt Controller (PIC) definitions
pub const PIC1_CMD = 0x20
pub const PIC1_DATA = 0x21
pub const PIC2_CMD = 0xA0
pub const PIC2_DATA = 0xA1
pub const PIC_EOI = 0x20

pub fn pic_remap(offset1 u8, offset2 u8) {
    unsafe {
        // ICW1: start initialization sequence (cascade mode)
        out8(u16(PIC1_CMD), 0x11)
        out8(u16(PIC2_CMD), 0x11)

        // ICW2: Vector offset
        out8(u16(PIC1_DATA), offset1)
        out8(u16(PIC2_DATA), offset2)

        // ICW3: tell Master PIC that there is a slave PIC at IRQ2
        out8(u16(PIC1_DATA), 0x04)
        // ICW3: tell Slave PIC its cascade identity (2)
        out8(u16(PIC2_DATA), 0x02)

        // ICW4: 8086/88 mode
        out8(u16(PIC1_DATA), 0x01)
        out8(u16(PIC2_DATA), 0x01)

        // Unmask interrupts
        out8(u16(PIC1_DATA), 0x00)
        out8(u16(PIC2_DATA), 0x00)
    }
}

pub fn pic_eoi(irq u8) {
    unsafe {
        if irq >= 8 {
            out8(u16(PIC2_CMD), u8(PIC_EOI))
        }
        out8(u16(PIC1_CMD), u8(PIC_EOI))
    }
}

pub fn pic_disable() {
    unsafe {
        out8(u16(PIC1_DATA), 0xFF)
        out8(u16(PIC2_DATA), 0xFF)
    }
}

// 8254 Programmable Interval Timer (PIT) definitions
pub const PIT_CHANNEL0 = 0x40
pub const PIT_COMMAND = 0x43
pub const PIT_BASE_FREQ = 1193182

pub fn pit_init(freq_hz u32) {
    if freq_hz == 0 {
        <<
    }
    $divisor := u32(PIT_BASE_FREQ) / freq_hz
    if divisor == 0 {
        divisor = 1
    }
    unsafe {
        // Channel 0, Access lobyte/hibyte, Mode 3 (Square wave generator)
        out8(u16(PIT_COMMAND), 0x36)
        out8(u16(PIT_CHANNEL0), u8(divisor & 0xFF))
        out8(u16(PIT_CHANNEL0), u8((divisor >> 8) & 0xFF))
    }
}
