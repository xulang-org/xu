// Interrupt state save/restore (x86_64 RFLAGS.IF, AArch64 DAIF.I,
// RISC-V sstatus.SIE). irq_save disables interrupts and returns the previous
// state; irq_restore re-enables them only if they were enabled in `flags`.
pub extern "C" fn irq_save() u64
pub extern "C" fn irq_restore(flags u64)

// Boot handoff (x64-none): the Multiboot magic (EAX) and info pointer (EBX)
// captured by the built-in Multiboot entry; both are 0 when the image was
// entered through its 64-bit ELF entry point instead.
pub extern "C" fn boot_magic() u64
pub extern "C" fn boot_info_addr() u64

