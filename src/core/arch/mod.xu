@repr("C")
pub struct CpuidResult {
    pub eax u32
    pub ebx u32
    pub ecx u32
    pub edx u32
}

pub extern "C" fn cpuid(leaf u32, subleaf u32, out *raw CpuidResult)
pub extern "C" fn read_rflags() u64
pub extern "C" fn syscall4(nr u64, a0 u64, a1 u64, a2 u64, a3 u64) u64

pub fn syscall0(nr u64) u64 {
    unsafe { << syscall4(nr, u64(0), u64(0), u64(0), u64(0)) }
}

pub fn syscall1(nr u64, a0 u64) u64 {
    unsafe { << syscall4(nr, a0, u64(0), u64(0), u64(0)) }
}

pub fn syscall2(nr u64, a0 u64, a1 u64) u64 {
    unsafe { << syscall4(nr, a0, a1, u64(0), u64(0)) }
}

pub fn syscall3(nr u64, a0 u64, a1 u64, a2 u64) u64 {
    unsafe { << syscall4(nr, a0, a1, a2, u64(0)) }
}

// x86_64 16-byte Interrupt Gate Descriptor
@repr("C")
pub struct IdtEntry {
    pub offset_low u16
    pub selector u16
    pub ist u8
    pub type_attr u8
    pub offset_mid u16
    pub offset_high u32
    pub zero u32
}

// 10-byte packed IDTR pointer for LIDT instruction
@repr("C", packed)
pub struct IdtPointer {
    pub limit u16
    pub base u64
}

// IDT Type and Attribute Flags
pub const IDT_FLAG_PRESENT = 0x80
pub const IDT_FLAG_RING0 = 0x00
pub const IDT_FLAG_RING3 = 0x60
pub const IDT_GATE_INTERRUPT = 0x0E
pub const IDT_GATE_TRAP = 0x0F
pub const IDT_ATTR_INT32 = 0x8E
pub const IDT_ATTR_TRAP32 = 0x8F
pub const IDT_ATTR_USER_INT32 = 0xEE

pub fn (e $&IdtEntry) set_gate(handler u64, selector u16, attr u8) {
    e.offset_low = u16(handler & 0xFFFF)
    e.selector = selector
    e.ist = 0
    e.type_attr = attr
    e.offset_mid = u16((handler >> 16) & 0xFFFF)
    e.offset_high = u32((handler >> 32) & 0xFFFFFFFF)
    e.zero = 0
}

// 8259A Programmable Interrupt Controller (PIC) definitions
pub const PIC1_CMD = 0x20
pub const PIC1_DATA = 0x21
pub const PIC2_CMD = 0xA0
pub const PIC2_DATA = 0xA1
pub const PIC_EOI = 0x20

pub fn pic_remap(offset1 u8, offset2 u8) {
    unsafe {
        // ICW1: start initialization sequence (cascade mode)
        out8(u16(PIC1_CMD), 0x11)
        out8(u16(PIC2_CMD), 0x11)

        // ICW2: Vector offset
        out8(u16(PIC1_DATA), offset1)
        out8(u16(PIC2_DATA), offset2)

        // ICW3: tell Master PIC that there is a slave PIC at IRQ2
        out8(u16(PIC1_DATA), 0x04)
        // ICW3: tell Slave PIC its cascade identity (2)
        out8(u16(PIC2_DATA), 0x02)

        // ICW4: 8086/88 mode
        out8(u16(PIC1_DATA), 0x01)
        out8(u16(PIC2_DATA), 0x01)

        // Leave every line masked: unmasking IRQs for which no IDT gate is
        // installed yet faults as soon as interrupts are enabled. Use
        // pic_unmask(irq) for each line once its handler is in place.
        out8(u16(PIC1_DATA), 0xFF)
        out8(u16(PIC2_DATA), 0xFF)
    }
}

pub fn pic_unmask(irq u8) {
    unsafe {
        if irq >= 8 {
            m := in8(u16(PIC2_DATA))
            out8(u16(PIC2_DATA), m & (u8(255) ^ (u8(1) << (irq - 8))))
            // The slave PIC is cascaded through master line 2.
            m1 := in8(u16(PIC1_DATA))
            out8(u16(PIC1_DATA), m1 & u8(0xFB))
        } else {
            m := in8(u16(PIC1_DATA))
            out8(u16(PIC1_DATA), m & (u8(255) ^ (u8(1) << irq)))
        }
    }
}

pub fn pic_mask(irq u8) {
    unsafe {
        if irq >= 8 {
            m := in8(u16(PIC2_DATA))
            out8(u16(PIC2_DATA), m | (u8(1) << (irq - 8)))
        } else {
            m := in8(u16(PIC1_DATA))
            out8(u16(PIC1_DATA), m | (u8(1) << irq))
        }
    }
}

pub fn pic_eoi(irq u8) {
    unsafe {
        if irq >= 8 {
            out8(u16(PIC2_CMD), u8(PIC_EOI))
        }
        out8(u16(PIC1_CMD), u8(PIC_EOI))
    }
}

pub fn pic_disable() {
    unsafe {
        out8(u16(PIC1_DATA), 0xFF)
        out8(u16(PIC2_DATA), 0xFF)
    }
}

// 8254 Programmable Interval Timer (PIT) definitions
pub const PIT_CHANNEL0 = 0x40
pub const PIT_COMMAND = 0x43
pub const PIT_BASE_FREQ = 1193182

pub fn pit_init(freq_hz u32) {
    if freq_hz == 0 {
        <<
    }
    $divisor := u32(PIT_BASE_FREQ) / freq_hz
    if divisor == 0 {
        divisor = 1
    }
    unsafe {
        // Channel 0, Access lobyte/hibyte, Mode 3 (Square wave generator)
        out8(u16(PIT_COMMAND), 0x36)
        out8(u16(PIT_CHANNEL0), u8(divisor & 0xFF))
        out8(u16(PIT_CHANNEL0), u8((divisor >> 8) & 0xFF))
    }
}

// x86_64 Local APIC MMIO definitions and helpers
pub const LAPIC_DEFAULT_BASE = 0xFEE00000
pub const LAPIC_REG_ID = 0x020
pub const LAPIC_REG_VER = 0x030
pub const LAPIC_REG_TPR = 0x080
pub const LAPIC_REG_EOI = 0x0B0
pub const LAPIC_REG_SVR = 0x0F0
pub const LAPIC_REG_ICR_LOW = 0x300
pub const LAPIC_REG_ICR_HIGH = 0x310
pub const LAPIC_REG_LVT_TIMER = 0x320
pub const LAPIC_REG_TIMER_INIT = 0x380
pub const LAPIC_REG_TIMER_CUR = 0x390
pub const LAPIC_REG_TIMER_DIV = 0x3E0

pub fn lapic_base() u64 {
    unsafe { << rdmsr(u32(MSR_IA32_APIC_BASE)) & u64(0xFFFFF000) }
}

pub fn lapic_read(base u64, reg u32) u32 {
    unsafe { << volatile_read((base + u64(reg)) as *raw u32) }
}

pub fn lapic_write(base u64, reg u32, val u32) {
    unsafe { volatile_write((base + u64(reg)) as *raw u32, val) }
}

pub fn lapic_id(base u64) u32 {
    << (lapic_read(base, u32(LAPIC_REG_ID)) >> 24) & u32(0xFF)
}

pub fn lapic_version(base u64) u32 {
    << lapic_read(base, u32(LAPIC_REG_VER))
}

pub fn lapic_eoi(base u64) {
    lapic_write(base, u32(LAPIC_REG_EOI), u32(0))
}

pub fn lapic_enable(base u64, spurious_vec u8) {
    svr := lapic_read(base, u32(LAPIC_REG_SVR))
    lapic_write(base, u32(LAPIC_REG_SVR), (svr & u32(0xFFFFFF00)) | u32(0x100) | u32(spurious_vec))
}

// Local APIC ICR / SMP / Timer helpers
pub const LAPIC_ICR_DELIV_FIXED = 0x000
pub const LAPIC_ICR_DELIV_INIT = 0x500
pub const LAPIC_ICR_DELIV_STARTUP = 0x600
pub const LAPIC_ICR_PENDING = 0x1000
pub const LAPIC_ICR_LEVEL_ASSERT = 0x4000
pub const LAPIC_TIMER_MASKED = 0x10000
pub const LAPIC_TIMER_PERIODIC = 0x20000

pub fn lapic_icr_wait(base u64) {
    while (lapic_read(base, u32(LAPIC_REG_ICR_LOW)) & u32(LAPIC_ICR_PENDING)) != u32(0) {
        pause()
    }
}

pub fn lapic_send_init(base u64, dest_apic_id u8) {
    lapic_icr_wait(base)
    lapic_write(base, u32(LAPIC_REG_ICR_HIGH), u32(dest_apic_id) << 24)
    lapic_write(base, u32(LAPIC_REG_ICR_LOW), u32(LAPIC_ICR_DELIV_INIT | LAPIC_ICR_LEVEL_ASSERT))
    lapic_icr_wait(base)
}

pub fn lapic_send_sipi(base u64, dest_apic_id u8, vector_page u8) {
    lapic_icr_wait(base)
    lapic_write(base, u32(LAPIC_REG_ICR_HIGH), u32(dest_apic_id) << 24)
    lapic_write(base, u32(LAPIC_REG_ICR_LOW), u32(LAPIC_ICR_DELIV_STARTUP) | u32(vector_page))
    lapic_icr_wait(base)
}

pub fn lapic_send_ipi(base u64, dest_apic_id u8, vector u8) {
    lapic_icr_wait(base)
    lapic_write(base, u32(LAPIC_REG_ICR_HIGH), u32(dest_apic_id) << 24)
    lapic_write(base, u32(LAPIC_REG_ICR_LOW), u32(LAPIC_ICR_DELIV_FIXED | LAPIC_ICR_LEVEL_ASSERT) | u32(vector))
    lapic_icr_wait(base)
}

pub fn lapic_timer_init(base u64, vector u8, div_val u32, init_count u32, periodic bool) {
    lapic_write(base, u32(LAPIC_REG_TIMER_DIV), div_val)
    $lvt := u32(vector)
    if periodic {
        lvt = lvt | u32(LAPIC_TIMER_PERIODIC)
    }
    lapic_write(base, u32(LAPIC_REG_LVT_TIMER), lvt)
    lapic_write(base, u32(LAPIC_REG_TIMER_INIT), init_count)
}

// x86_64 I/O APIC MMIO definitions and helpers
pub const IOAPIC_DEFAULT_BASE = 0xFEC00000
pub const IOAPIC_REGSEL = 0x00
pub const IOAPIC_IOWIN = 0x10
pub const IOAPIC_REG_ID = 0x00
pub const IOAPIC_REG_VER = 0x01
pub const IOAPIC_REG_REDTBL = 0x10

pub fn ioapic_read(base u64, reg u32) u32 {
    unsafe {
        volatile_write((base + u64(IOAPIC_REGSEL)) as *raw u32, reg)
        << volatile_read((base + u64(IOAPIC_IOWIN)) as *raw u32)
    }
}

pub fn ioapic_write(base u64, reg u32, val u32) {
    unsafe {
        volatile_write((base + u64(IOAPIC_REGSEL)) as *raw u32, reg)
        volatile_write((base + u64(IOAPIC_IOWIN)) as *raw u32, val)
    }
}

pub fn ioapic_version(base u64) u32 {
    << ioapic_read(base, u32(IOAPIC_REG_VER)) & u32(0xFF)
}

pub fn ioapic_max_redir(base u64) u32 {
    << (ioapic_read(base, u32(IOAPIC_REG_VER)) >> 16) & u32(0xFF)
}

pub fn ioapic_set_irq(base u64, irq u8, vector u8, dest_apic_id u8, flags u32) {
    reg := u32(IOAPIC_REG_REDTBL) + u32(irq) * u32(2)
    ioapic_write(base, reg + u32(1), u32(dest_apic_id) << 24)
    ioapic_write(base, reg, u32(vector) | flags)
}
