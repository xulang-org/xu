@core/elf

// Pure zero-allocation ELF64 parser & validator for freestanding kernels.

pub const ELF_MAGIC = 0x464C457F // "\x7FELF" little-endian
pub const ELFCLASS64 = 2
pub const ELFDATA2LSB = 1
pub const ET_EXEC = 2
pub const ET_DYN = 3
pub const EM_X86_64 = 62
pub const EM_AARCH64 = 183
pub const EM_RISCV = 243
pub const PT_NULL = 0
pub const PT_LOAD = 1
pub const PF_X = 1
pub const PF_W = 2
pub const PF_R = 4

@repr("C")
pub struct Elf64Ehdr {
    pub magic u32
    pub elf_class u8
    pub elf_data u8
    pub elf_version u8
    pub osabi u8
    pub pad0 u64
    pub e_type u16
    pub e_machine u16
    pub e_version u32
    pub e_entry u64
    pub e_phoff u64
    pub e_shoff u64
    pub e_flags u32
    pub e_ehsize u16
    pub e_phentsize u16
    pub e_phnum u16
    pub e_shentsize u16
    pub e_shnum u16
    pub e_shstrndx u16
}

@repr("C")
pub struct Elf64Phdr {
    pub p_type u32
    pub p_flags u32
    pub p_offset u64
    pub p_vaddr u64
    pub p_paddr u64
    pub p_filesz u64
    pub p_memsz u64
    pub p_align u64
}

static_assert(sizeof(Elf64Ehdr) == 64 && offsetof(Elf64Ehdr, e_entry) == 24 && offsetof(Elf64Ehdr, e_phoff) == 32 && offsetof(Elf64Ehdr, e_phnum) == 56, "Elf64Ehdr ABI mismatch")
static_assert(sizeof(Elf64Phdr) == 56 && offsetof(Elf64Phdr, p_offset) == 8 && offsetof(Elf64Phdr, p_vaddr) == 16 && offsetof(Elf64Phdr, p_filesz) == 32 && offsetof(Elf64Phdr, p_memsz) == 40, "Elf64Phdr ABI mismatch")

@repr("C")
pub struct Elf64Image {
    pub data *raw u8
    pub len usize
}

pub fn elf64_parse(data *raw u8, len usize) Elf64Image {
    << Elf64Image{data: data, len: len}
}

pub fn (img &Elf64Image) ehdr() *raw Elf64Ehdr {
    << img.data as *raw Elf64Ehdr
}

pub fn (img &Elf64Image) validate_exec(expected_machine u16) bool {
    if img.data == 0 as *raw u8 || img.len < usize(64) {
        << false
    }
    unsafe {
        eh := img.ehdr()
        if (*eh).magic != u32(ELF_MAGIC) { << false }
        if (*eh).elf_class != u8(ELFCLASS64) { << false }
        if (*eh).elf_data != u8(ELFDATA2LSB) { << false }
        if (*eh).elf_version != u8(1) { << false }
        if (*eh).e_type != u16(ET_EXEC) { << false }
        if (*eh).e_machine != expected_machine { << false }
        if (*eh).e_phentsize != u16(56) { << false }
        if (*eh).e_phnum == u16(0) { << false }
        phoff := (*eh).e_phoff
        phsz := u64((*eh).e_phnum) * u64(56)
        total := u64(img.len)
        if phoff > total || phsz > total - phoff {
            << false
        }
    }
    << true
}

pub fn (img &Elf64Image) entry() u64 {
    if img.data == 0 as *raw u8 || img.len < usize(64) {
        << u64(0)
    }
    unsafe {
        << (*img.ehdr()).e_entry
    }
}

pub fn (img &Elf64Image) phdr_count() int {
    if img.data == 0 as *raw u8 || img.len < usize(64) {
        << 0
    }
    unsafe {
        << int((*img.ehdr()).e_phnum)
    }
}

pub fn (img &Elf64Image) phdr_at(idx int) *raw Elf64Phdr {
    if img.data == 0 as *raw u8 || img.len < usize(64) || idx < 0 {
        << 0 as *raw Elf64Phdr
    }
    unsafe {
        eh := img.ehdr()
        if idx >= int((*eh).e_phnum) {
            << 0 as *raw Elf64Phdr
        }
        off := (*eh).e_phoff + u64(idx) * u64(56)
        << ((img.data as usize) + usize(off)) as *raw Elf64Phdr
    }
}

pub fn (img &Elf64Image) segment_valid(ph *raw Elf64Phdr) bool {
    if ph == 0 as *raw Elf64Phdr || img.data == 0 as *raw u8 {
        << false
    }
    unsafe {
        if (*ph).p_filesz > (*ph).p_memsz {
            << false
        }
        total := u64(img.len)
        off := (*ph).p_offset
        fsz := (*ph).p_filesz
        if off > total || fsz > total - off {
            << false
        }
    }
    << true
}

pub fn (img &Elf64Image) segment_data(ph *raw Elf64Phdr) *raw u8 {
    if ph == 0 as *raw Elf64Phdr || img.data == 0 as *raw u8 {
        << 0 as *raw u8
    }
    unsafe {
        << ((img.data as usize) + usize((*ph).p_offset)) as *raw u8
    }
}
