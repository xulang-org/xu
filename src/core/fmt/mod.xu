@core/fmt

// Zero-allocation freestanding formatter writing directly into caller-supplied
// byte buffers (serial logs, stack buffers, panic messages, /proc text).

#core/addr

@repr("C")
struct FmtScratch24 {
    a u64
    b u64
    c u64
}

@repr("C")
pub struct FmtBuf {
    pub buf *raw u8
    pub cap usize
    pub len usize
    pub truncated u8
}

pub fn fmt_buf_new(buf *raw u8, cap usize) FmtBuf {
    << FmtBuf{buf: buf, cap: cap, len: usize(0), truncated: u8(0)}
}

pub fn fmt_buf_from_slice(s addr.MutByteSlice) FmtBuf {
    << FmtBuf{buf: s.ptr, cap: s.len, len: usize(0), truncated: u8(0)}
}

pub fn (f $&FmtBuf) reset() {
    f.len = usize(0)
    f.truncated = u8(0)
}

pub fn (f &FmtBuf) is_truncated() bool {
    << f.truncated != u8(0)
}

pub fn (f &FmtBuf) remaining() usize {
    if f.cap <= f.len {
        << usize(0)
    }
    << f.cap - f.len
}

pub fn (f &FmtBuf) as_slice() addr.ByteSlice {
    << addr.byte_slice(f.buf, f.len)
}

pub fn (f $&FmtBuf) write_byte(b u8) {
    if f.buf == 0 as *raw u8 || f.len >= f.cap {
        f.truncated = u8(1)
        <<
    }
    unsafe {
        p := ((f.buf as usize) + f.len) as *raw u8
        *p = b
    }
    f.len += usize(1)
}

pub fn (f $&FmtBuf) write_bytes(s &addr.ByteSlice) {
    $i := usize(0)
    while i < s.len {
        f.write_byte(s.get(i))
        i += usize(1)
    }
}

pub fn (f $&FmtBuf) write_str(s string) {
    for i in 0:s.len {
        f.write_byte(u8(s[i]))
    }
}

pub fn (f $&FmtBuf) write_repeat(b u8, count usize) {
    $i := usize(0)
    while i < count {
        f.write_byte(b)
        i += usize(1)
    }
}

pub fn (f $&FmtBuf) write_bool(v bool) {
    if v {
        f.write_str("true")
    } else {
        f.write_str("false")
    }
}

pub fn (f $&FmtBuf) write_u64(v u64) {
    if v == u64(0) {
        f.write_byte(u8(48))
        <<
    }
    $sc := FmtScratch24{a: u64(0), b: u64(0), c: u64(0)}
    $cur := v
    $cnt := usize(0)
    while cur > u64(0) && cnt < usize(24) {
        rem := cur % u64(10)
        cur = cur / u64(10)
        unsafe {
            sp := (&sc) as *raw u8
            dp := ((sp as usize) + cnt) as *raw u8
            *dp = u8(48 + int(rem))
        }
        cnt += usize(1)
    }
    $i := cnt
    while i > usize(0) {
        i -= usize(1)
        unsafe {
            sp := (&sc) as *raw u8
            dp := ((sp as usize) + i) as *raw u8
            f.write_byte(*dp)
        }
    }
}

pub fn (f $&FmtBuf) write_i64(v i64) {
    if v < i64(0) {
        f.write_byte(u8(45)) // '-'
        f.write_u64(u64(0) - u64(v))
    } else {
        f.write_u64(u64(v))
    }
}

pub fn (f $&FmtBuf) write_usize(v usize) {
    f.write_u64(u64(v))
}

pub fn (f $&FmtBuf) write_isize(v isize) {
    f.write_i64(i64(v))
}

pub fn (f $&FmtBuf) write_hex_padded(v u64, width usize, uppercase bool) {
    $digits := usize(1)
    $tmp := v >> u64(4)
    while tmp != u64(0) {
        digits += usize(1)
        tmp = tmp >> u64(4)
    }
    if width > digits {
        f.write_repeat(u8(48), width - digits)
    }
    $d := digits
    while d > usize(0) {
        d -= usize(1)
        nib := int((v >> (u64(d) * u64(4))) & u64(0xF))
        if nib < 10 {
            f.write_byte(u8(48 + nib))
        } else if uppercase {
            f.write_byte(u8(55 + nib))
        } else {
            f.write_byte(u8(87 + nib))
        }
    }
}

pub fn (f $&FmtBuf) write_hex_u64(v u64) {
    f.write_hex_padded(v, usize(1), false)
}

pub fn (f $&FmtBuf) write_hex_upper_u64(v u64) {
    f.write_hex_padded(v, usize(1), true)
}

pub fn (f $&FmtBuf) write_hex_prefixed(v u64) {
    f.write_str("0x")
    f.write_hex_u64(v)
}

pub fn (f $&FmtBuf) write_ptr(p *raw u8) {
    f.write_str("0x")
    max_u := u64(usize(0) - usize(1))
    $ptr_w := usize(8)
    if max_u > u64(0xFFFFFFFFu64) {
        ptr_w = usize(16)
    }
    f.write_hex_padded(u64(p as usize), ptr_w, false)
}

pub fn (f $&FmtBuf) write_bin_u64(v u64, min_bits usize) {
    $bits := usize(1)
    $tmp := v >> u64(1)
    while tmp != u64(0) {
        bits += usize(1)
        tmp = tmp >> u64(1)
    }
    $eff_min := min_bits
    if eff_min > usize(64) {
        eff_min = usize(64)
    }
    if eff_min > bits {
        f.write_repeat(u8(48), eff_min - bits)
    }
    $b := bits
    while b > usize(0) {
        b -= usize(1)
        bit := (v >> u64(b)) & u64(1)
        if bit != u64(0) {
            f.write_byte(u8(49))
        } else {
            f.write_byte(u8(48))
        }
    }
}

pub fn (f $&FmtBuf) nul_terminate() bool {
    if f.buf == 0 as *raw u8 || f.len >= f.cap {
        << false
    }
    unsafe {
        p := ((f.buf as usize) + f.len) as *raw u8
        *p = u8(0)
    }
    << true
}

pub fn (f &FmtBuf) eq_str(s string) bool {
    if f.len != usize(s.len) {
        << false
    }
    if f.len == usize(0) {
        << true
    }
    if f.buf == 0 as *raw u8 {
        << false
    }
    for i in 0:s.len {
        unsafe {
            p := ((f.buf as usize) + usize(i)) as *raw u8
            if int(*p) != (s[i] & 255) {
                << false
            }
        }
    }
    << true
}
