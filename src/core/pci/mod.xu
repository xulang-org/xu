@core/pci
$freestanding

#core/arch

pub const PCI_CONFIG_ADDR = 0x0CF8
pub const PCI_CONFIG_DATA = 0x0CFC
pub const PCI_VENDOR_INVALID = 0xFFFF
pub const PCI_CMD_OFFSET = 0x04
pub const PCI_CMD_IO_SPACE = 0x0001
pub const PCI_CMD_MEM_SPACE = 0x0002
pub const PCI_CMD_BUS_MASTER = 0x0004
pub const PCI_CAP_MSI = 0x05
pub const PCI_CAP_VENDOR = 0x09
pub const PCI_CAP_PCIE = 0x10
pub const PCI_CAP_MSIX = 0x11

@repr("C")
pub struct PciDevice {
    pub bus u8
    pub dev u8
    pub func u8
    pub header_type u8
    pub vendor_id u16
    pub device_id u16
    pub class_code u8
    pub subclass u8
    pub prog_if u8
    pub irq_line u8
    pub bar0 u32
    pub bar1 u32
}

pub fn pci_addr(bus u8, dev u8, func u8, offset u8) u32 {
    << u32(0x80000000) | (u32(bus) << 16) | ((u32(dev) & u32(0x1F)) << 11) |
       ((u32(func) & u32(0x07)) << 8) | (u32(offset) & u32(0xFC))
}

pub fn pci_read32(bus u8, dev u8, func u8, offset u8) u32 {
    unsafe {
        arch.out32(u16(PCI_CONFIG_ADDR), pci_addr(bus, dev, func, offset))
        << arch.in32(u16(PCI_CONFIG_DATA))
    }
}

pub fn pci_write32(bus u8, dev u8, func u8, offset u8, val u32) {
    unsafe {
        arch.out32(u16(PCI_CONFIG_ADDR), pci_addr(bus, dev, func, offset))
        arch.out32(u16(PCI_CONFIG_DATA), val)
    }
}

pub fn pci_read16(bus u8, dev u8, func u8, offset u8) u16 {
    dword := pci_read32(bus, dev, func, offset)
    shift := u32(offset & u8(2)) * u32(8)
    << u16((dword >> shift) & u32(0xFFFF))
}

pub fn pci_read8(bus u8, dev u8, func u8, offset u8) u8 {
    dword := pci_read32(bus, dev, func, offset)
    shift := u32(offset & u8(3)) * u32(8)
    << u8((dword >> shift) & u32(0xFF))
}

pub fn pci_write16(bus u8, dev u8, func u8, offset u8, val u16) {
    old := pci_read32(bus, dev, func, offset)
    shift := u32(offset & u8(2)) * u32(8)
    mask := u32(0xFFFF) << shift
    nv := (old & (u32(0xFFFFFFFF) ^ mask)) | (u32(val) << shift)
    pci_write32(bus, dev, func, offset, nv)
}

pub fn pci_bar_addr(bar u32) u64 {
    if (bar & u32(1)) != u32(0) {
        << u64(bar & u32(0xFFFFFFFC))
    }
    << u64(bar & u32(0xFFFFFFF0))
}

pub fn pci_enable_bus_master(bus u8, dev u8, func u8) {
    cmd := pci_read16(bus, dev, func, u8(PCI_CMD_OFFSET))
    pci_write16(bus, dev, func, u8(PCI_CMD_OFFSET), cmd | u16(PCI_CMD_BUS_MASTER | PCI_CMD_MEM_SPACE | PCI_CMD_IO_SPACE))
}

pub fn pci_probe(bus u8, dev u8, func u8, out *raw PciDevice) bool {
    id := pci_read32(bus, dev, func, u8(0x00))
    vendor := u16(id & u32(0xFFFF))
    if vendor == u16(PCI_VENDOR_INVALID) || vendor == u16(0) {
        << false
    }
    dev_id := u16((id >> 16) & u32(0xFFFF))
    cls := pci_read32(bus, dev, func, u8(0x08))
    hdr := pci_read8(bus, dev, func, u8(0x0E))
    bar0 := pci_read32(bus, dev, func, u8(0x10))
    bar1 := pci_read32(bus, dev, func, u8(0x14))
    irq_line := pci_read8(bus, dev, func, u8(0x3C))
    unsafe {
        if (out as u64) != u64(0) {
            *out = PciDevice{
                bus: bus,
                dev: dev,
                func: func,
                header_type: hdr,
                vendor_id: vendor,
                device_id: dev_id,
                class_code: u8((cls >> 24) & u32(0xFF)),
                subclass: u8((cls >> 16) & u32(0xFF)),
                prog_if: u8((cls >> 8) & u32(0xFF)),
                irq_line: irq_line,
                bar0: bar0,
                bar1: bar1
            }
        }
    }
    << true
}

pub fn pci_scan_bus(bus u8, out *raw PciDevice, max_devs int) int {
    $count := 0
    $d := 0
    while d < 32 {
        $probe0 := PciDevice{
            bus: u8(0), dev: u8(0), func: u8(0), header_type: u8(0),
            vendor_id: u16(0), device_id: u16(0), class_code: u8(0),
            subclass: u8(0), prog_if: u8(0), irq_line: u8(0), bar0: u32(0), bar1: u32(0)
        }
        unsafe {
            if pci_probe(bus, u8(d), u8(0), (&probe0) as *raw PciDevice) {
                $nfuncs := 1
                if (probe0.header_type & u8(0x80)) != u8(0) {
                    nfuncs = 8
                }
                $f := 0
                while f < nfuncs {
                    $cur := PciDevice{
                        bus: u8(0), dev: u8(0), func: u8(0), header_type: u8(0),
                        vendor_id: u16(0), device_id: u16(0), class_code: u8(0),
                        subclass: u8(0), prog_if: u8(0), irq_line: u8(0), bar0: u32(0), bar1: u32(0)
                    }
                    if pci_probe(bus, u8(d), u8(f), (&cur) as *raw PciDevice) {
                        if (out as u64) != u64(0) && count < max_devs {
                            slot := ((out as u64) + u64(count * sizeof(PciDevice))) as *raw PciDevice
                            *slot = cur
                        }
                        count += 1
                    }
                    f += 1
                }
            }
        }
        d += 1
    }
    << count
}

pub fn pci_find_device(vendor u16, device u16, out *raw PciDevice) bool {
    $d := 0
    while d < 32 {
        $f := 0
        while f < 8 {
            $cur := PciDevice{
                bus: u8(0), dev: u8(0), func: u8(0), header_type: u8(0),
                vendor_id: u16(0), device_id: u16(0), class_code: u8(0),
                subclass: u8(0), prog_if: u8(0), irq_line: u8(0), bar0: u32(0), bar1: u32(0)
            }
            unsafe {
                if pci_probe(u8(0), u8(d), u8(f), (&cur) as *raw PciDevice) {
                    if cur.vendor_id == vendor && cur.device_id == device {
                        if (out as u64) != u64(0) {
                            *out = cur
                        }
                        << true
                    }
                    if f == 0 && (cur.header_type & u8(0x80)) == u8(0) {
                        f = 8
                        ->
                    }
                } else if f == 0 {
                    f = 8
                    ->
                }
            }
            f += 1
        }
        d += 1
    }
    << false
}

pub fn pci_class_name(class_code u8, subclass u8) string {
    if class_code == u8(0x01) {
        if subclass == u8(0x06) { << "SATA" }
        if subclass == u8(0x08) { << "NVMe" }
        << "Storage"
    }
    if class_code == u8(0x02) { << "Network" }
    if class_code == u8(0x03) { << "Display" }
    if class_code == u8(0x06) {
        if subclass == u8(0x00) { << "HostBridge" }
        if subclass == u8(0x01) { << "ISABridge" }
        if subclass == u8(0x04) { << "PCIBridge" }
        << "Bridge"
    }
    if class_code == u8(0x0C) {
        if subclass == u8(0x03) { << "USB" }
        << "SerialBus"
    }
    << "Other"
}

pub fn pci_bar_is_64bit(bar u32) bool {
    << (bar & u32(1)) == u32(0) && (bar & u32(0x06)) == u32(0x04)
}

pub fn pci_bar_addr64(bar_lo u32, bar_hi u32) u64 {
    lo := pci_bar_addr(bar_lo)
    if pci_bar_is_64bit(bar_lo) {
        << lo | (u64(bar_hi) << u64(32))
    }
    << lo
}

pub fn pci_find_capability(bus u8, dev u8, func u8, cap_id u8) u8 {
    status := pci_read16(bus, dev, func, u8(0x06))
    if (status & u16(0x0010)) == u16(0) {
        << u8(0)
    }
    $ptr := pci_read8(bus, dev, func, u8(0x34)) & u8(0xFC)
    $steps := 0
    while ptr != u8(0) && steps < 48 {
        cid := pci_read8(bus, dev, func, ptr)
        if cid == cap_id {
            << ptr
        }
        next_ptr := pci_read8(bus, dev, func, u8(int(ptr) + 1)) & u8(0xFC)
        if next_ptr == ptr {
            <-
        }
        ptr = next_ptr
        steps += 1
    }
    << u8(0)
}

pub fn pci_enable_msi(bus u8, dev u8, func u8, lapic_addr u64, apic_id u8, vector u8) bool {
    cap := pci_find_capability(bus, dev, func, u8(PCI_CAP_MSI))
    if cap == u8(0) {
        << false
    }
    ctrl := pci_read16(bus, dev, func, u8(int(cap) + 2))
    $msg_addr_lo := u32(0xFEE00000) | (u32(apic_id) << u32(12))
    if lapic_addr != u64(0) {
        msg_addr_lo = u32(lapic_addr & u64(0xFFF00000)) | (u32(apic_id) << u32(12))
    }
    pci_write32(bus, dev, func, u8(int(cap) + 4), msg_addr_lo)
    is_64 := (ctrl & u16(0x0080)) != u16(0)
    if is_64 {
        pci_write32(bus, dev, func, u8(int(cap) + 8), u32(0))
        pci_write16(bus, dev, func, u8(int(cap) + 12), u16(vector))
    } else {
        pci_write16(bus, dev, func, u8(int(cap) + 8), u16(vector))
    }
    // Clear multiple-message enable (bits 6:4) for 1 vector and set bit 0 (MSI Enable)
    new_ctrl := (ctrl & u16(0xFF8F)) | u16(0x0001)
    pci_write16(bus, dev, func, u8(int(cap) + 2), new_ctrl)
    << true
}

pub fn pci_scan_all(out *raw PciDevice, max_devs int) int {
    $visited := [256]bool{}
    $queue := [256]u8{}
    $qhead := 0
    $qtail := 0
    visited[0] = true
    queue[0] = u8(0)
    qtail = 1
    $total := 0

    while qhead < qtail {
        bus := queue[qhead]
        qhead += 1
        $bus_devs := [32]PciDevice{}
        unsafe {
            cnt := pci_scan_bus(bus, ($&bus_devs[0]) as *raw PciDevice, 32)
            $limit := cnt
            if limit > 32 { limit = 32 }
            for i in 0:limit {
                d := bus_devs[i]
                if (out as u64) != u64(0) && total < max_devs {
                    slot := ((out as u64) + u64(total * sizeof(PciDevice))) as *raw PciDevice
                    *slot = d
                }
                total += 1
                if d.class_code == u8(0x06) && d.subclass == u8(0x04) {
                    sec_bus := int(pci_read8(d.bus, d.dev, d.func, u8(0x19)))
                    if sec_bus > 0 && sec_bus < 256 && !visited[sec_bus] && qtail < 256 {
                        visited[sec_bus] = true
                        queue[qtail] = u8(sec_bus)
                        qtail += 1
                    }
                }
            }
        }
    }
    << total
}

pub fn ecam_offset(bus u8, dev u8, func u8, offset u16) u64 {
    << (u64(bus) << u64(20)) | ((u64(dev) & u64(0x1F)) << u64(15)) |
       ((u64(func) & u64(0x07)) << u64(12)) | u64(offset & u16(0x0FFC))
}

pub fn ecam_read32(ecam_base u64, bus u8, dev u8, func u8, offset u16) u32 {
    unsafe {
        << volatile_read((ecam_base + ecam_offset(bus, dev, func, offset)) as *raw u32)
    }
}

pub fn ecam_write32(ecam_base u64, bus u8, dev u8, func u8, offset u16, val u32) {
    unsafe {
        volatile_write((ecam_base + ecam_offset(bus, dev, func, offset)) as *raw u32, val)
    }
}

pub fn ecam_read16(ecam_base u64, bus u8, dev u8, func u8, offset u16) u16 {
    dword := ecam_read32(ecam_base, bus, dev, func, offset)
    shift := u32(offset & u16(2)) * u32(8)
    << u16((dword >> shift) & u32(0xFFFF))
}

pub fn ecam_read8(ecam_base u64, bus u8, dev u8, func u8, offset u16) u8 {
    dword := ecam_read32(ecam_base, bus, dev, func, offset)
    shift := u32(offset & u16(3)) * u32(8)
    << u8((dword >> shift) & u32(0xFF))
}

pub fn ecam_probe(ecam_base u64, bus u8, dev u8, func u8, out *raw PciDevice) bool {
    if ecam_base == u64(0) { << false }
    id := ecam_read32(ecam_base, bus, dev, func, u16(0x00))
    vendor := u16(id & u32(0xFFFF))
    if vendor == u16(PCI_VENDOR_INVALID) || vendor == u16(0) {
        << false
    }
    dev_id := u16((id >> 16) & u32(0xFFFF))
    cls := ecam_read32(ecam_base, bus, dev, func, u16(0x08))
    hdr := ecam_read8(ecam_base, bus, dev, func, u16(0x0E))
    bar0 := ecam_read32(ecam_base, bus, dev, func, u16(0x10))
    bar1 := ecam_read32(ecam_base, bus, dev, func, u16(0x14))
    irq_line := ecam_read8(ecam_base, bus, dev, func, u16(0x3C))
    unsafe {
        if (out as u64) != u64(0) {
            *out = PciDevice{
                bus: bus,
                dev: dev,
                func: func,
                header_type: hdr,
                vendor_id: vendor,
                device_id: dev_id,
                class_code: u8((cls >> 24) & u32(0xFF)),
                subclass: u8((cls >> 16) & u32(0xFF)),
                prog_if: u8((cls >> 8) & u32(0xFF)),
                irq_line: irq_line,
                bar0: bar0,
                bar1: bar1
            }
        }
    }
    << true
}

pub fn ecam_scan_bus(ecam_base u64, bus u8, out *raw PciDevice, max_devs int) int {
    if ecam_base == u64(0) { << 0 }
    $count := 0
    $d := 0
    while d < 32 {
        $probe0 := PciDevice{
            bus: u8(0), dev: u8(0), func: u8(0), header_type: u8(0),
            vendor_id: u16(0), device_id: u16(0), class_code: u8(0),
            subclass: u8(0), prog_if: u8(0), irq_line: u8(0), bar0: u32(0), bar1: u32(0)
        }
        unsafe {
            if ecam_probe(ecam_base, bus, u8(d), u8(0), (&probe0) as *raw PciDevice) {
                $nfuncs := 1
                if (probe0.header_type & u8(0x80)) != u8(0) {
                    nfuncs = 8
                }
                $f := 0
                while f < nfuncs {
                    $cur := PciDevice{
                        bus: u8(0), dev: u8(0), func: u8(0), header_type: u8(0),
                        vendor_id: u16(0), device_id: u16(0), class_code: u8(0),
                        subclass: u8(0), prog_if: u8(0), irq_line: u8(0), bar0: u32(0), bar1: u32(0)
                    }
                    if ecam_probe(ecam_base, bus, u8(d), u8(f), (&cur) as *raw PciDevice) {
                        if (out as u64) != u64(0) && count < max_devs {
                            slot := ((out as u64) + u64(count * sizeof(PciDevice))) as *raw PciDevice
                            *slot = cur
                        }
                        count += 1
                    }
                    f += 1
                }
            }
        }
        d += 1
    }
    << count
}
