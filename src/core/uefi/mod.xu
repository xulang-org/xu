@core/uefi
$freestanding

#core/mem

pub extern "C" fn uefi_image_handle() u64
pub extern "C" fn uefi_system_table() u64
pub extern "C" fn efi_call0(func u64) u64
pub extern "C" fn efi_call1(func u64, a0 u64) u64
pub extern "C" fn efi_call2(func u64, a0 u64, a1 u64) u64
pub extern "C" fn efi_call3(func u64, a0 u64, a1 u64, a2 u64) u64
pub extern "C" fn efi_call4(func u64, a0 u64, a1 u64, a2 u64, a3 u64) u64
pub extern "C" fn efi_call5(func u64, a0 u64, a1 u64, a2 u64, a3 u64, a4 u64) u64
pub extern "C" fn efi_call6(func u64, a0 u64, a1 u64, a2 u64, a3 u64, a4 u64, a5 u64) u64

pub const EFI_SYSTEM_TABLE_SIGNATURE = 0x5453595320494249u64
pub const EFI_RESET_COLD = 0
pub const EFI_RESET_WARM = 1
pub const EFI_RESET_SHUTDOWN = 2
pub const EFI_LOADER_DATA = 2

@repr("C")
pub struct EfiGuid {
    pub data1 u32
    pub data2 u16
    pub data3 u16
    pub data4 [8]u8
}

@repr("C")
pub struct EfiConfigurationTable {
    pub vendor_guid EfiGuid
    pub vendor_table u64
}

@repr("C")
pub struct EfiTableHeader {
    pub signature u64
    pub revision u32
    pub header_size u32
    pub crc32 u32
    pub reserved u32
}

@repr("C")
pub struct EfiSimpleTextOutputProtocol {
    pub reset u64
    pub output_string u64
    pub test_string u64
    pub query_mode u64
    pub set_mode u64
    pub set_attribute u64
    pub clear_screen u64
    pub set_cursor_position u64
    pub enable_cursor u64
    pub mode u64
}

@repr("C")
pub struct EfiGopModeInfo {
    pub version u32
    pub horizontal_resolution u32
    pub vertical_resolution u32
    pub pixel_format u32
    pub red_mask u32
    pub green_mask u32
    pub blue_mask u32
    pub reserved_mask u32
    pub pixels_per_scan_line u32
}

@repr("C")
pub struct EfiGopMode {
    pub max_mode u32
    pub mode u32
    pub info *raw EfiGopModeInfo
    pub size_of_info u64
    pub frame_buffer_base u64
    pub frame_buffer_size u64
}

@repr("C")
pub struct EfiGraphicsOutputProtocol {
    pub query_mode u64
    pub set_mode u64
    pub blt u64
    pub mode *raw EfiGopMode
}

@repr("C")
pub struct EfiRuntimeServices {
    pub hdr EfiTableHeader
    pub get_time u64
    pub set_time u64
    pub get_wakeup_time u64
    pub set_wakeup_time u64
    pub set_virtual_address_map u64
    pub convert_pointer u64
    pub get_variable u64
    pub get_next_variable_name u64
    pub set_variable u64
    pub get_next_high_mono_count u64
    pub reset_system u64
}

@repr("C")
pub struct EfiBootServices {
    pub hdr EfiTableHeader
    pub raise_tpl u64
    pub restore_tpl u64
    pub allocate_pages u64
    pub free_pages u64
    pub get_memory_map u64
    pub allocate_pool u64
    pub free_pool u64
    pub create_event u64
    pub set_timer u64
    pub wait_for_event u64
    pub signal_event u64
    pub close_event u64
    pub check_event u64
    pub install_protocol_interface u64
    pub reinstall_protocol_interface u64
    pub uninstall_protocol_interface u64
    pub handle_protocol u64
    pub reserved u64
    pub register_protocol_notify u64
    pub locate_handle u64
    pub locate_device_path u64
    pub install_configuration_table u64
    pub load_image u64
    pub start_image u64
    pub exit u64
    pub unload_image u64
    pub exit_boot_services u64
    pub get_next_monotonic_count u64
    pub stall u64
    pub set_watchdog_timer u64
    pub connect_controller u64
    pub disconnect_controller u64
    pub open_protocol u64
    pub close_protocol u64
    pub open_protocol_information u64
    pub protocols_per_handle u64
    pub locate_handle_buffer u64
    pub locate_protocol u64
}

@repr("C")
pub struct EfiSystemTable {
    pub hdr EfiTableHeader
    pub firmware_vendor u64
    pub firmware_revision u32
    pub _pad_fw u32
    pub console_in_handle u64
    pub con_in u64
    pub console_out_handle u64
    pub con_out *raw EfiSimpleTextOutputProtocol
    pub standard_error_handle u64
    pub std_err u64
    pub runtime_services *raw EfiRuntimeServices
    pub boot_services *raw EfiBootServices
    pub number_of_table_entries u64
    pub configuration_table u64
}

@repr("C")
pub struct EfiMemoryDescriptor {
    pub mem_type u32
    pub pad u32
    pub physical_start u64
    pub virtual_start u64
    pub number_of_pages u64
    pub attribute u64
}

fn make_guid(d1 u32, d2 u16, d3 u16, b0 u8, b1 u8, b2 u8, b3 u8, b4 u8, b5 u8, b6 u8, b7 u8) EfiGuid {
    $g := EfiGuid{ data1: d1, data2: d2, data3: d3, data4: [8]u8{} }
    g.data4[0] = b0
    g.data4[1] = b1
    g.data4[2] = b2
    g.data4[3] = b3
    g.data4[4] = b4
    g.data4[5] = b5
    g.data4[6] = b6
    g.data4[7] = b7
    << g
}

pub fn acpi_20_guid() EfiGuid {
    << make_guid(u32(0x8868E871), u16(0xE4F1), u16(0x11D3), u8(0xBC), u8(0x22), u8(0x00), u8(0x80), u8(0xC7), u8(0x3C), u8(0x88), u8(0x81))
}

pub fn acpi_10_guid() EfiGuid {
    << make_guid(u32(0xEB9D2D30), u16(0x2D88), u16(0x11D3), u8(0x9A), u8(0x16), u8(0x00), u8(0x90), u8(0x27), u8(0x3F), u8(0xC1), u8(0x4D))
}

pub fn gop_guid() EfiGuid {
    << make_guid(u32(0x9042A9DE), u16(0x23DC), u16(0x4A38), u8(0x96), u8(0xFB), u8(0x7A), u8(0xDE), u8(0xD0), u8(0x80), u8(0x51), u8(0x6A))
}

pub fn guid_eq(a *raw EfiGuid, b *raw EfiGuid) bool {
    unsafe {
        if (a as u64) == u64(0) || (b as u64) == u64(0) { << false }
        ga := *a
        gb := *b
        if ga.data1 != gb.data1 || ga.data2 != gb.data2 || ga.data3 != gb.data3 { << false }
        for i in 0:8 {
            if ga.data4[i] != gb.data4[i] { << false }
        }
    }
    << true
}

pub fn image_handle() u64 {
    unsafe { << uefi_image_handle() }
}

pub fn system_table() *raw EfiSystemTable {
    unsafe { << uefi_system_table() as *raw EfiSystemTable }
}

pub fn con_out_clear(st *raw EfiSystemTable) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        co := (*st).con_out
        if (co as u64) == u64(0) { << u64(1) }
        << efi_call1((*co).clear_screen, co as u64)
    }
}

pub fn con_out_puts(st *raw EfiSystemTable, s string) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        co := (*st).con_out
        if (co as u64) == u64(0) { << u64(1) }
        $buf := [128]u16{}
        $bi := 0
        $i := 0
        while i < s.len {
            ch := s[i]
            if ch == 10 {
                if bi + 2 >= 127 {
                    buf[bi] = u16(0)
                    efi_call2((*co).output_string, co as u64, (($&buf[0]) as *raw u16) as u64)
                    bi = 0
                }
                buf[bi] = u16(13)
                buf[bi + 1] = u16(10)
                bi += 2
            } else {
                if bi + 1 >= 127 {
                    buf[bi] = u16(0)
                    efi_call2((*co).output_string, co as u64, (($&buf[0]) as *raw u16) as u64)
                    bi = 0
                }
                buf[bi] = u16(ch)
                bi += 1
            }
            i += 1
        }
        buf[bi] = u16(0)
        << efi_call2((*co).output_string, co as u64, (($&buf[0]) as *raw u16) as u64)
    }
}

pub fn con_out_put_u64(st *raw EfiSystemTable, v u64) {
    if v == u64(0) {
        con_out_puts(st, "0")
        <<
    }
    $digits := [24]u8{}
    $n := 0
    $x := v
    while x > u64(0) {
        d := int(x % u64(10))
        digits[n] = u8(48 + d)
        n += 1
        x = x / u64(10)
    }
    $out := [25]u16{}
    $i := 0
    while i < n {
        out[i] = u16(digits[n - 1 - i])
        i += 1
    }
    out[n] = u16(0)
    unsafe {
        if (st as u64) == u64(0) { << }
        co := (*st).con_out
        if (co as u64) != u64(0) {
            efi_call2((*co).output_string, co as u64, (($&out[0]) as *raw u16) as u64)
        }
    }
}

pub fn con_out_put_hex(st *raw EfiSystemTable, v u64) {
    $out := [20]u16{}
    out[0] = u16(48)
    out[1] = u16(120)
    $i := 0
    while i < 16 {
        shift := u64((15 - i) * 4)
        nib := int((v >> shift) & u64(0xF))
        $ch := 48 + nib
        if nib >= 10 { ch = 97 + (nib - 10) }
        out[2 + i] = u16(ch)
        i += 1
    }
    out[18] = u16(0)
    unsafe {
        if (st as u64) == u64(0) { << }
        co := (*st).con_out
        if (co as u64) != u64(0) {
            efi_call2((*co).output_string, co as u64, (($&out[0]) as *raw u16) as u64)
        }
    }
}

pub fn find_config_table(st *raw EfiSystemTable, target_guid *raw EfiGuid) u64 {
    unsafe {
        if (st as u64) == u64(0) || (*st).configuration_table == u64(0) { << u64(0) }
        n := int((*st).number_of_table_entries)
        base := (*st).configuration_table
        $i := 0
        while i < n {
            entry := (base + u64(i * sizeof(EfiConfigurationTable))) as *raw EfiConfigurationTable
            $eg := (*entry).vendor_guid
            if guid_eq((&eg) as *raw EfiGuid, target_guid) {
                << (*entry).vendor_table
            }
            i += 1
        }
    }
    << u64(0)
}

pub fn find_acpi_rsdp(st *raw EfiSystemTable) u64 {
    $g2 := acpi_20_guid()
    unsafe {
        r2 := find_config_table(st, (&g2) as *raw EfiGuid)
        if r2 != u64(0) { << r2 }
        $g1 := acpi_10_guid()
        << find_config_table(st, (&g1) as *raw EfiGuid)
    }
}

pub fn get_memory_map(st *raw EfiSystemTable, map_size *raw u64, buf *raw u8, map_key *raw u64, desc_size *raw u64, desc_ver *raw u32) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        bs := (*st).boot_services
        if (bs as u64) == u64(0) { << u64(1) }
        << efi_call5((*bs).get_memory_map, map_size as u64, buf as u64, map_key as u64, desc_size as u64, desc_ver as u64)
    }
}

pub fn allocate_pool(st *raw EfiSystemTable, pool_type u32, size u64, out_buf *raw u64) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        bs := (*st).boot_services
        if (bs as u64) == u64(0) { << u64(1) }
        << efi_call3((*bs).allocate_pool, u64(pool_type), size, out_buf as u64)
    }
}

pub fn free_pool(st *raw EfiSystemTable, buf u64) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        bs := (*st).boot_services
        if (bs as u64) == u64(0) { << u64(1) }
        << efi_call1((*bs).free_pool, buf)
    }
}

pub fn locate_protocol(st *raw EfiSystemTable, guid *raw EfiGuid, out_iface *raw u64) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        bs := (*st).boot_services
        if (bs as u64) == u64(0) { << u64(1) }
        << efi_call3((*bs).locate_protocol, guid as u64, u64(0), out_iface as u64)
    }
}

pub fn locate_gop(st *raw EfiSystemTable) *raw EfiGraphicsOutputProtocol {
    $g := gop_guid()
    $iface := u64(0)
    unsafe {
        st_rc := locate_protocol(st, (&g) as *raw EfiGuid, (&iface) as *raw u64)
        if st_rc != u64(0) || iface == u64(0) {
            << u64(0) as *raw EfiGraphicsOutputProtocol
        }
        << iface as *raw EfiGraphicsOutputProtocol
    }
}

pub fn exit_boot_services(st *raw EfiSystemTable, img u64, map_key u64) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        bs := (*st).boot_services
        if (bs as u64) == u64(0) { << u64(1) }
        << efi_call2((*bs).exit_boot_services, img, map_key)
    }
}

pub fn stall(st *raw EfiSystemTable, microseconds u64) u64 {
    unsafe {
        if (st as u64) == u64(0) { << u64(1) }
        bs := (*st).boot_services
        if (bs as u64) == u64(0) { << u64(1) }
        << efi_call1((*bs).stall, microseconds)
    }
}

pub fn shutdown(st *raw EfiSystemTable) {
    unsafe {
        if (st as u64) == u64(0) { << }
        rt := (*st).runtime_services
        if (rt as u64) != u64(0) {
            efi_call4((*rt).reset_system, u64(EFI_RESET_SHUTDOWN), u64(0), u64(0), u64(0))
        }
    }
}
