@core/addr

// Physical/virtual address, page/frame, explicit endianness, and borrowed
// zero-allocation slice types for baremetal kernels and device drivers.

pub const PAGE_SIZE = 4096
pub const PAGE_SHIFT = 12

// ===== Physical & Virtual Addresses =====

@repr("C")
pub struct PhysAddr {
    pub raw u64
}

pub fn phys_addr(v u64) PhysAddr {
    << PhysAddr{raw: v}
}

pub fn (a PhysAddr) as_u64() u64 {
    << a.raw
}

pub fn (a PhysAddr) is_null() bool {
    << a.raw == u64(0)
}

pub fn (a PhysAddr) is_aligned(align u64) bool {
    if align <= u64(1) { << true }
    << (a.raw & (align - u64(1))) == u64(0)
}

pub fn (a PhysAddr) align_down(align u64) PhysAddr {
    if align <= u64(1) { << a }
    mask := align - u64(1)
    << PhysAddr{raw: a.raw - (a.raw & mask)}
}

pub fn (a PhysAddr) align_up(align u64) PhysAddr {
    if align <= u64(1) { << a }
    mask := align - u64(1)
    sum := a.raw + mask
    << PhysAddr{raw: sum - (sum & mask)}
}

pub fn (a PhysAddr) add(off u64) PhysAddr {
    << PhysAddr{raw: a.raw + off}
}

pub fn (a PhysAddr) sub(off u64) PhysAddr {
    << PhysAddr{raw: a.raw - off}
}

pub fn (a PhysAddr) frame_index() u64 {
    << a.raw >> u64(PAGE_SHIFT)
}

pub fn (a PhysAddr) page_offset() u64 {
    << a.raw & (u64(PAGE_SIZE) - u64(1))
}

@repr("C")
pub struct VirtAddr {
    pub raw u64
}

pub fn virt_addr(v u64) VirtAddr {
    << VirtAddr{raw: v}
}

pub fn (a VirtAddr) as_u64() u64 {
    << a.raw
}

pub fn (a VirtAddr) as_ptr() *raw u8 {
    << a.raw as *raw u8
}

pub fn (a VirtAddr) is_null() bool {
    << a.raw == u64(0)
}

pub fn (a VirtAddr) is_aligned(align u64) bool {
    if align <= u64(1) { << true }
    << (a.raw & (align - u64(1))) == u64(0)
}

pub fn (a VirtAddr) align_down(align u64) VirtAddr {
    if align <= u64(1) { << a }
    mask := align - u64(1)
    << VirtAddr{raw: a.raw - (a.raw & mask)}
}

pub fn (a VirtAddr) align_up(align u64) VirtAddr {
    if align <= u64(1) { << a }
    mask := align - u64(1)
    sum := a.raw + mask
    << VirtAddr{raw: sum - (sum & mask)}
}

pub fn (a VirtAddr) add(off u64) VirtAddr {
    << VirtAddr{raw: a.raw + off}
}

pub fn (a VirtAddr) sub(off u64) VirtAddr {
    << VirtAddr{raw: a.raw - off}
}

pub fn (a VirtAddr) page_offset() u64 {
    << a.raw & (u64(PAGE_SIZE) - u64(1))
}

pub fn (a VirtAddr) p4_index() int {
    << int((a.raw >> u64(39)) & u64(0x1FF))
}

pub fn (a VirtAddr) p3_index() int {
    << int((a.raw >> u64(30)) & u64(0x1FF))
}

pub fn (a VirtAddr) p2_index() int {
    << int((a.raw >> u64(21)) & u64(0x1FF))
}

pub fn (a VirtAddr) p1_index() int {
    << int((a.raw >> u64(12)) & u64(0x1FF))
}

pub fn (a VirtAddr) is_canonical_x64() bool {
    top := a.raw >> u64(47)
    << top == u64(0) || top == u64(0x1FFFF)
}

@repr("C")
pub struct PhysFrame {
    pub start u64
}

pub fn phys_frame_containing(a PhysAddr) PhysFrame {
    << PhysFrame{start: a.align_down(u64(PAGE_SIZE)).raw}
}

pub fn phys_frame_from_index(idx u64) PhysFrame {
    << PhysFrame{start: idx << u64(PAGE_SHIFT)}
}

pub fn (f PhysFrame) start_addr() PhysAddr {
    << PhysAddr{raw: f.start}
}

pub fn (f PhysFrame) index() u64 {
    << f.start >> u64(PAGE_SHIFT)
}

@repr("C")
pub struct Page {
    pub start u64
}

pub fn page_containing(a VirtAddr) Page {
    << Page{start: a.align_down(u64(PAGE_SIZE)).raw}
}

pub fn (p Page) start_addr() VirtAddr {
    << VirtAddr{raw: p.start}
}

// ===== Explicit Endianness Types (Little-Endian Host Targets) =====

pub fn bswap16(v u16) u16 {
    lo := (v & u16(0xFF)) << u16(8)
    hi := (v >> u16(8)) & u16(0xFF)
    << lo | hi
}

pub fn bswap32(v u32) u32 {
    b0 := (v & u32(0xFF)) << u32(24)
    b1 := ((v >> u32(8)) & u32(0xFF)) << u32(16)
    b2 := ((v >> u32(16)) & u32(0xFF)) << u32(8)
    b3 := (v >> u32(24)) & u32(0xFF)
    << b0 | b1 | b2 | b3
}

pub fn bswap64(v u64) u64 {
    b0 := (v & u64(0xFF)) << u64(56)
    b1 := ((v >> u64(8)) & u64(0xFF)) << u64(48)
    b2 := ((v >> u64(16)) & u64(0xFF)) << u64(40)
    b3 := ((v >> u64(24)) & u64(0xFF)) << u64(32)
    b4 := ((v >> u64(32)) & u64(0xFF)) << u64(24)
    b5 := ((v >> u64(40)) & u64(0xFF)) << u64(16)
    b6 := ((v >> u64(48)) & u64(0xFF)) << u64(8)
    b7 := (v >> u64(56)) & u64(0xFF)
    << b0 | b1 | b2 | b3 | b4 | b5 | b6 | b7
}

@repr("C")
pub struct Le16 {
    pub raw u16
}

pub fn le16_new(native u16) Le16 {
    << Le16{raw: native}
}

pub fn (v Le16) to_native() u16 {
    << v.raw
}

pub fn (v Le16) raw_bits() u16 {
    << v.raw
}

@repr("C")
pub struct Le32 {
    pub raw u32
}

pub fn le32_new(native u32) Le32 {
    << Le32{raw: native}
}

pub fn (v Le32) to_native() u32 {
    << v.raw
}

pub fn (v Le32) raw_bits() u32 {
    << v.raw
}

@repr("C")
pub struct Le64 {
    pub raw u64
}

pub fn le64_new(native u64) Le64 {
    << Le64{raw: native}
}

pub fn (v Le64) to_native() u64 {
    << v.raw
}

pub fn (v Le64) raw_bits() u64 {
    << v.raw
}

@repr("C")
pub struct Be16 {
    pub raw u16
}

pub fn be16_new(native u16) Be16 {
    << Be16{raw: bswap16(native)}
}

pub fn (v Be16) to_native() u16 {
    << bswap16(v.raw)
}

pub fn (v Be16) raw_bits() u16 {
    << v.raw
}

@repr("C")
pub struct Be32 {
    pub raw u32
}

pub fn be32_new(native u32) Be32 {
    << Be32{raw: bswap32(native)}
}

pub fn (v Be32) to_native() u32 {
    << bswap32(v.raw)
}

pub fn (v Be32) raw_bits() u32 {
    << v.raw
}

@repr("C")
pub struct Be64 {
    pub raw u64
}

pub fn be64_new(native u64) Be64 {
    << Be64{raw: bswap64(native)}
}

pub fn (v Be64) to_native() u64 {
    << bswap64(v.raw)
}

pub fn (v Be64) raw_bits() u64 {
    << v.raw
}

// ===== Zero-Allocation Borrowed Slices =====

@repr("C")
pub struct ByteSlice {
    pub ptr *raw u8
    pub len usize
}

pub fn byte_slice(ptr *raw u8, len usize) ByteSlice {
    << ByteSlice{ptr: ptr, len: len}
}

pub fn (s &ByteSlice) is_empty() bool {
    << s.len == usize(0)
}

pub fn (s &ByteSlice) get(idx usize) u8 {
    if idx >= s.len || s.ptr == 0 as *raw u8 {
        << u8(0)
    }
    unsafe {
        p := ((s.ptr as usize) + idx) as *raw u8
        << *p
    }
}

pub fn (s &ByteSlice) get_or(idx usize, fallback u8) u8 {
    if idx >= s.len || s.ptr == 0 as *raw u8 {
        << fallback
    }
    unsafe {
        p := ((s.ptr as usize) + idx) as *raw u8
        << *p
    }
}

pub fn (s &ByteSlice) subslice(start usize, end usize) ByteSlice {
    $a := start
    $b := end
    if a > s.len { a = s.len }
    if b > s.len { b = s.len }
    if b <= a {
        << ByteSlice{ptr: 0 as *raw u8, len: usize(0)}
    }
    << ByteSlice{ptr: ((s.ptr as usize) + a) as *raw u8, len: b - a}
}

@repr("C")
pub struct MutByteSlice {
    pub ptr *raw u8
    pub len usize
}

pub fn mut_byte_slice(ptr *raw u8, len usize) MutByteSlice {
    << MutByteSlice{ptr: ptr, len: len}
}

pub fn (s &MutByteSlice) is_empty() bool {
    << s.len == usize(0)
}

pub fn (s &MutByteSlice) get(idx usize) u8 {
    if idx >= s.len || s.ptr == 0 as *raw u8 {
        << u8(0)
    }
    unsafe {
        p := ((s.ptr as usize) + idx) as *raw u8
        << *p
    }
}

pub fn (s $&MutByteSlice) set(idx usize, val u8) bool {
    if idx >= s.len || s.ptr == 0 as *raw u8 {
        << false
    }
    unsafe {
        p := ((s.ptr as usize) + idx) as *raw u8
        *p = val
    }
    << true
}

pub fn (s $&MutByteSlice) fill(val u8) {
    $i := usize(0)
    base := s.ptr as usize
    while i < s.len {
        unsafe {
            p := (base + i) as *raw u8
            *p = val
        }
        i += usize(1)
    }
}

pub fn (s $&MutByteSlice) copy_from(src &ByteSlice) usize {
    $n := src.len
    if s.len < n { n = s.len }
    if s.ptr == 0 as *raw u8 || src.ptr == 0 as *raw u8 {
        << usize(0)
    }
    d_base := s.ptr as usize
    s_base := src.ptr as usize
    $i := usize(0)
    while i < n {
        unsafe {
            dp := (d_base + i) as *raw u8
            sp := (s_base + i) as *raw u8
            *dp = *sp
        }
        i += usize(1)
    }
    << n
}

pub fn (s &MutByteSlice) as_readonly() ByteSlice {
    << ByteSlice{ptr: s.ptr, len: s.len}
}

pub fn (s &MutByteSlice) subslice(start usize, end usize) MutByteSlice {
    $a := start
    $b := end
    if a > s.len { a = s.len }
    if b > s.len { b = s.len }
    if b <= a {
        << MutByteSlice{ptr: 0 as *raw u8, len: usize(0)}
    }
    << MutByteSlice{ptr: ((s.ptr as usize) + a) as *raw u8, len: b - a}
}
