@core/virtio

// Zero-allocation, freestanding VirtIO driver framework (VirtIO MMIO, VirtIO-Blk, VirtIO-Net).

#core/arch
#core/sync

// VirtIO MMIO Register Offsets
pub const VIRTIO_MMIO_MAGIC_VALUE = 0x000
pub const VIRTIO_MMIO_VERSION = 0x004
pub const VIRTIO_MMIO_DEVICE_ID = 0x008
pub const VIRTIO_MMIO_VENDOR_ID = 0x00C
pub const VIRTIO_MMIO_DEVICE_FEATURES = 0x010
pub const VIRTIO_MMIO_DEVICE_FEATURES_SEL = 0x014
pub const VIRTIO_MMIO_DRIVER_FEATURES = 0x020
pub const VIRTIO_MMIO_DRIVER_FEATURES_SEL = 0x024
pub const VIRTIO_MMIO_QUEUE_SEL = 0x030
pub const VIRTIO_MMIO_QUEUE_NUM_MAX = 0x034
pub const VIRTIO_MMIO_QUEUE_NUM = 0x038
pub const VIRTIO_MMIO_QUEUE_READY = 0x044
pub const VIRTIO_MMIO_QUEUE_NOTIFY = 0x050
pub const VIRTIO_MMIO_INTERRUPT_STATUS = 0x060
pub const VIRTIO_MMIO_INTERRUPT_ACK = 0x064
pub const VIRTIO_MMIO_STATUS = 0x070
pub const VIRTIO_MMIO_QUEUE_DESC_LOW = 0x080
pub const VIRTIO_MMIO_QUEUE_DESC_HIGH = 0x084
pub const VIRTIO_MMIO_QUEUE_DRIVER_LOW = 0x090
pub const VIRTIO_MMIO_QUEUE_DRIVER_HIGH = 0x094
pub const VIRTIO_MMIO_QUEUE_DEVICE_LOW = 0x0A0
pub const VIRTIO_MMIO_QUEUE_DEVICE_HIGH = 0x0A4

// Magic constants
pub const VIRTIO_MAGIC = 0x74726976 // "virt"
pub const VIRTIO_DEV_NET = 1
pub const VIRTIO_DEV_BLK = 2
pub const VIRTIO_DEV_CONSOLE = 3
pub const VIRTIO_DEV_ENTROPY = 4
pub const VIRTIO_DEV_GPU = 18

// Device status bits
pub const VIRTIO_STATUS_RESET = 0
pub const VIRTIO_STATUS_ACKNOWLEDGE = 1
pub const VIRTIO_STATUS_DRIVER = 2
pub const VIRTIO_STATUS_DRIVER_OK = 4
pub const VIRTIO_STATUS_FEATURES_OK = 8
pub const VIRTIO_STATUS_DEVICE_NEEDS_RESET = 64
pub const VIRTIO_STATUS_FAILED = 128

// Virtqueue descriptor flags
pub const VIRTQ_DESC_F_NEXT = 1
pub const VIRTQ_DESC_F_WRITE = 2
pub const VIRTQ_DESC_F_INDIRECT = 4

// VirtqDesc: 16-byte buffer descriptor
@repr("C")
pub struct VirtqDesc {
    pub addr u64
    pub len u32
    pub flags u16
    pub next u16
}

// VirtqUsedElem: 8-byte used buffer element
@repr("C")
pub struct VirtqUsedElem {
    pub id u32
    pub len u32
}

// VirtIO-Blk request types
pub const VIRTIO_BLK_T_IN = 0   // Read
pub const VIRTIO_BLK_T_OUT = 1  // Write
pub const VIRTIO_BLK_T_FLUSH = 4

// VirtIO-Blk request header
@repr("C")
pub struct VirtioBlkReq {
    pub req_type u32
    pub reserved u32
    pub sector u64
}

// VirtIO-Net packet header (12 bytes)
@repr("C")
pub struct VirtioNetHdr {
    pub flags u8
    pub gso_type u8
    pub hdr_len u16
    pub gso_size u16
    pub csum_start u16
    pub csum_offset u16
    pub num_buffers u16
}

// VirtioDevice: High-level hardware abstraction wrapper
pub struct VirtioDevice {
    pub base u64
}

pub fn virtio_device_new(base u64) VirtioDevice {
    << VirtioDevice{base: base}
}

pub fn (dev &VirtioDevice) read_reg(offset u64) u32 {
    unsafe {
        p := (dev.base + offset) as *raw u32
        << volatile_read(p)
    }
}

pub fn (dev &VirtioDevice) write_reg(offset u64, val u32) {
    unsafe {
        p := (dev.base + offset) as *raw u32
        volatile_write(p, val)
    }
}

pub fn (dev &VirtioDevice) probe() u32 {
    magic := dev.read_reg(u64(VIRTIO_MMIO_MAGIC_VALUE))
    if magic != u32(VIRTIO_MAGIC) {
        << 0
    }
    version := dev.read_reg(u64(VIRTIO_MMIO_VERSION))
    if version != 2 && version != 1 {
        << 0
    }
    << dev.read_reg(u64(VIRTIO_MMIO_DEVICE_ID))
}

pub fn (dev &VirtioDevice) init_device() bool {
    // 1. Reset device
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_RESET))

    // 2. Acknowledge device
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE))

    // 3. Set driver status
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER))

    // 4. Negotiate features
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK))

    // 5. Driver OK
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK | VIRTIO_STATUS_DRIVER_OK))
    << true
}

// VirtIO-Blk Driver wrapper
pub struct VirtioBlkDriver {
    pub dev VirtioDevice
    pub capacity_sectors u64
}

pub fn virtio_blk_new(base u64) VirtioBlkDriver {
    << VirtioBlkDriver{
        dev: virtio_device_new(base),
        capacity_sectors: 0
    }
}

pub fn (blk $&VirtioBlkDriver) init() bool {
    dev_type := blk.dev.probe()
    if dev_type != u32(VIRTIO_DEV_BLK) {
        << false
    }
    if !blk.dev.init_device() {
        << false
    }
    // Read device config space for capacity (offset 0x100)
    low := blk.dev.read_reg(0x100)
    high := blk.dev.read_reg(0x104)
    blk.capacity_sectors = (u64(high) << 32) | u64(low)
    << true
}

// VirtIO-Net Driver wrapper
pub struct VirtioNetDriver {
    pub dev VirtioDevice
    pub mac0 u8
    pub mac1 u8
    pub mac2 u8
    pub mac3 u8
    pub mac4 u8
    pub mac5 u8
}

pub fn virtio_net_new(base u64) VirtioNetDriver {
    << VirtioNetDriver{
        dev: virtio_device_new(base),
        mac0: 0, mac1: 0, mac2: 0, mac3: 0, mac4: 0, mac5: 0
    }
}

pub fn (net $&VirtioNetDriver) init() bool {
    dev_type := net.dev.probe()
    if dev_type != u32(VIRTIO_DEV_NET) {
        << false
    }
    if !net.dev.init_device() {
        << false
    }
    // Read MAC address from config space (offset 0x100..0x105)
    w0 := net.dev.read_reg(0x100)
    w1 := net.dev.read_reg(0x104)
    net.mac0 = u8(w0 & 0xFF)
    net.mac1 = u8((w0 >> 8) & 0xFF)
    net.mac2 = u8((w0 >> 16) & 0xFF)
    net.mac3 = u8((w0 >> 24) & 0xFF)
    net.mac4 = u8(w1 & 0xFF)
    net.mac5 = u8((w1 >> 8) & 0xFF)
    << true
}
