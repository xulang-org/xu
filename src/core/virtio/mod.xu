@core/virtio

// Zero-allocation, freestanding VirtIO driver framework (Split Virtqueue,
// Modern VirtIO-MMIO v2, Legacy/Transitional VirtIO-PCI, VirtIO-Blk, VirtIO-Net).

#core/arch
#core/mem
#core/sync

// VirtIO MMIO Register Offsets
pub const VIRTIO_MMIO_MAGIC_VALUE = 0x000
pub const VIRTIO_MMIO_VERSION = 0x004
pub const VIRTIO_MMIO_DEVICE_ID = 0x008
pub const VIRTIO_MMIO_VENDOR_ID = 0x00C
pub const VIRTIO_MMIO_DEVICE_FEATURES = 0x010
pub const VIRTIO_MMIO_DEVICE_FEATURES_SEL = 0x014
pub const VIRTIO_MMIO_DRIVER_FEATURES = 0x020
pub const VIRTIO_MMIO_DRIVER_FEATURES_SEL = 0x024
pub const VIRTIO_MMIO_QUEUE_SEL = 0x030
pub const VIRTIO_MMIO_QUEUE_NUM_MAX = 0x034
pub const VIRTIO_MMIO_QUEUE_NUM = 0x038
pub const VIRTIO_MMIO_QUEUE_READY = 0x044
pub const VIRTIO_MMIO_QUEUE_NOTIFY = 0x050
pub const VIRTIO_MMIO_INTERRUPT_STATUS = 0x060
pub const VIRTIO_MMIO_INTERRUPT_ACK = 0x064
pub const VIRTIO_MMIO_STATUS = 0x070
pub const VIRTIO_MMIO_QUEUE_DESC_LOW = 0x080
pub const VIRTIO_MMIO_QUEUE_DESC_HIGH = 0x084
pub const VIRTIO_MMIO_QUEUE_DRIVER_LOW = 0x090
pub const VIRTIO_MMIO_QUEUE_DRIVER_HIGH = 0x094
pub const VIRTIO_MMIO_QUEUE_DEVICE_LOW = 0x0A0
pub const VIRTIO_MMIO_QUEUE_DEVICE_HIGH = 0x0A4
pub const VIRTIO_MMIO_CONFIG = 0x100

// Magic & Device IDs
pub const VIRTIO_MAGIC = 0x74726976 // "virt"
pub const VIRTIO_DEV_NET = 1
pub const VIRTIO_DEV_BLK = 2
pub const VIRTIO_DEV_CONSOLE = 3
pub const VIRTIO_DEV_ENTROPY = 4
pub const VIRTIO_DEV_GPU = 18

// Device status bits
pub const VIRTIO_STATUS_RESET = 0
pub const VIRTIO_STATUS_ACKNOWLEDGE = 1
pub const VIRTIO_STATUS_DRIVER = 2
pub const VIRTIO_STATUS_DRIVER_OK = 4
pub const VIRTIO_STATUS_FEATURES_OK = 8
pub const VIRTIO_STATUS_DEVICE_NEEDS_RESET = 64
pub const VIRTIO_STATUS_FAILED = 128

// Virtqueue descriptor flags
pub const VIRTQ_DESC_F_NEXT = 1
pub const VIRTQ_DESC_F_WRITE = 2
pub const VIRTQ_DESC_F_INDIRECT = 4

// VirtIO-Blk request types and status codes
pub const VIRTIO_BLK_T_IN = 0   // Read
pub const VIRTIO_BLK_T_OUT = 1  // Write
pub const VIRTIO_BLK_T_FLUSH = 4
pub const VIRTIO_BLK_S_OK = 0
pub const VIRTIO_BLK_S_IOERR = 1
pub const VIRTIO_BLK_S_UNSUPP = 2

// x86 PCI configuration & Legacy/Transitional VirtIO-PCI BAR0 offsets
pub const PCI_CONFIG_ADDR = 0x0CF8
pub const PCI_CONFIG_DATA = 0x0CFC
pub const VIRTIO_PCI_VENDOR = 0x1AF4
pub const VIRTIO_PCI_DEV_BLK_LEGACY = 0x1001
pub const VIRTIO_PCI_DEV_BLK_MODERN = 0x1042

// VirtIO 1.0 PCI Capability Types (PCI Cap ID 0x09)
pub const VIRTIO_PCI_CAP_COMMON_CFG = 1
pub const VIRTIO_PCI_CAP_NOTIFY_CFG = 2
pub const VIRTIO_PCI_CAP_ISR_CFG = 3
pub const VIRTIO_PCI_CAP_DEVICE_CFG = 4

// VirtIO 1.0 Common Configuration register offsets
pub const VIRTIO_COMMON_DEV_FEAT_SEL = 0x00
pub const VIRTIO_COMMON_DEV_FEAT = 0x04
pub const VIRTIO_COMMON_DRV_FEAT_SEL = 0x08
pub const VIRTIO_COMMON_DRV_FEAT = 0x0C
pub const VIRTIO_COMMON_MSIX_VEC = 0x10
pub const VIRTIO_COMMON_NUM_QUEUES = 0x12
pub const VIRTIO_COMMON_STATUS = 0x14
pub const VIRTIO_COMMON_CFG_GEN = 0x15
pub const VIRTIO_COMMON_Q_SELECT = 0x16
pub const VIRTIO_COMMON_Q_SIZE = 0x18
pub const VIRTIO_COMMON_Q_MSIX = 0x1A
pub const VIRTIO_COMMON_Q_ENABLE = 0x1C
pub const VIRTIO_COMMON_Q_NOTIFY_OFF = 0x1E
pub const VIRTIO_COMMON_Q_DESC_LO = 0x20
pub const VIRTIO_COMMON_Q_DESC_HI = 0x24
pub const VIRTIO_COMMON_Q_AVAIL_LO = 0x28
pub const VIRTIO_COMMON_Q_AVAIL_HI = 0x2C
pub const VIRTIO_COMMON_Q_USED_LO = 0x30
pub const VIRTIO_COMMON_Q_USED_HI = 0x34

pub const VIRTIO_PCI_DEV_FEATURES = 0x00
pub const VIRTIO_PCI_GUEST_FEATURES = 0x04
pub const VIRTIO_PCI_QUEUE_PFN = 0x08
pub const VIRTIO_PCI_QUEUE_NUM = 0x0C
pub const VIRTIO_PCI_QUEUE_SEL = 0x0E
pub const VIRTIO_PCI_QUEUE_NOTIFY = 0x10
pub const VIRTIO_PCI_STATUS = 0x12
pub const VIRTIO_PCI_ISR = 0x13
pub const VIRTIO_PCI_BLK_CAP_LO = 0x14
pub const VIRTIO_PCI_BLK_CAP_HI = 0x18

// VirtqDesc: 16-byte buffer descriptor
@repr("C")
pub struct VirtqDesc {
    pub addr u64
    pub len u32
    pub flags u16
    pub next u16
}

// VirtqUsedElem: 8-byte used buffer element
@repr("C")
pub struct VirtqUsedElem {
    pub id u32
    pub len u32
}

// VirtIO-Blk request header (16 bytes)
@repr("C")
pub struct VirtioBlkReq {
    pub req_type u32
    pub reserved u32
    pub sector u64
}

// VirtIO-Net packet header (12 bytes)
@repr("C")
pub struct VirtioNetHdr {
    pub flags u8
    pub gso_type u8
    pub hdr_len u16
    pub gso_size u16
    pub csum_start u16
    pub csum_offset u16
    pub num_buffers u16
}

// ===== Shared Split Virtqueue Helpers =====

fn align_up_4k(v u64) u64 {
    << ((v + u64(4095)) / u64(4096)) * u64(4096)
}

fn virtq_prepare_blk(desc_addr u64, avail_addr u64, req_addr u64, status_addr u64,
                     q_size u32, avail_idx u16, sector u64, data_phys u64, is_write bool) u16 {
    << virtq_prepare_blk_n(desc_addr, avail_addr, req_addr, status_addr,
                           q_size, avail_idx, sector, data_phys, u32(512), is_write)
}

fn virtq_prepare_blk_n(desc_addr u64, avail_addr u64, req_addr u64, status_addr u64,
                       q_size u32, avail_idx u16, sector u64, data_phys u64, data_bytes u32, is_write bool) u16 {
    $rtype := u32(VIRTIO_BLK_T_IN)
    $d1_flags := u16(VIRTQ_DESC_F_NEXT | VIRTQ_DESC_F_WRITE)
    if is_write {
        rtype = u32(VIRTIO_BLK_T_OUT)
        d1_flags = u16(VIRTQ_DESC_F_NEXT)
    }

    unsafe {
        req := usize(req_addr) as *raw VirtioBlkReq
        *req = VirtioBlkReq{req_type: rtype, reserved: u32(0), sector: sector}

        st := usize(status_addr) as *raw u8
        *st = u8(0xFF)

        d0 := usize(desc_addr) as *raw VirtqDesc
        *d0 = VirtqDesc{addr: req_addr, len: u32(16), flags: u16(VIRTQ_DESC_F_NEXT), next: u16(1)}

        d1 := usize(desc_addr + u64(16)) as *raw VirtqDesc
        *d1 = VirtqDesc{addr: data_phys, len: data_bytes, flags: d1_flags, next: u16(2)}

        d2 := usize(desc_addr + u64(32)) as *raw VirtqDesc
        *d2 = VirtqDesc{addr: status_addr, len: u32(1), flags: u16(VIRTQ_DESC_F_WRITE), next: u16(0)}

        slot := u64(avail_idx) & u64(q_size - u32(1))
        ring_p := usize(avail_addr + u64(4) + slot * u64(2)) as *raw u16
        volatile_write(ring_p, u16(0))

        arch.wmb()
        new_idx := u16((u32(avail_idx) + u32(1)) & u32(0xFFFF))
        idx_p := usize(avail_addr + u64(2)) as *raw u16
        volatile_write(idx_p, new_idx)
        arch.mb()
        << new_idx
    }
}

fn virtq_wait_used(used_addr u64, last_used u16, status_addr u64) int {
    $spins := 0
    $cur_used := last_used
    unsafe {
        idx_p := usize(used_addr + u64(2)) as *raw u16
        while spins < 10000000 {
            arch.rmb()
            cur_used = volatile_read(idx_p)
            if cur_used != last_used {
                <-
            }
            arch.pause()
            spins += 1
        }
        if cur_used == last_used {
            << -1
        }
        arch.rmb()
        st := volatile_read(usize(status_addr) as *raw u8)
        if st != u8(VIRTIO_BLK_S_OK) {
            << -2
        }
    }
    << int(cur_used)
}

// ===== VirtioDevice (VirtIO-MMIO) =====

@repr("C")
pub struct VirtioDevice {
    pub base u64
}

pub fn virtio_device_new(base u64) VirtioDevice {
    << VirtioDevice{base: base}
}

pub fn (dev &VirtioDevice) read_reg(offset u64) u32 {
    unsafe {
        p := usize(dev.base + offset) as *raw u32
        << volatile_read(p)
    }
}

pub fn (dev &VirtioDevice) write_reg(offset u64, val u32) {
    unsafe {
        p := usize(dev.base + offset) as *raw u32
        volatile_write(p, val)
    }
}

pub fn (dev &VirtioDevice) probe() u32 {
    magic := dev.read_reg(u64(VIRTIO_MMIO_MAGIC_VALUE))
    if magic != u32(VIRTIO_MAGIC) {
        << u32(0)
    }
    version := dev.read_reg(u64(VIRTIO_MMIO_VERSION))
    if version != u32(2) && version != u32(1) {
        << u32(0)
    }
    << dev.read_reg(u64(VIRTIO_MMIO_DEVICE_ID))
}

pub fn virtio_mmio_find_blk(start_addr u64, stride u64, count int) u64 {
    $i := 0
    while i < count {
        base := start_addr + u64(i) * stride
        dev := virtio_device_new(base)
        if dev.read_reg(u64(VIRTIO_MMIO_MAGIC_VALUE)) == u32(VIRTIO_MAGIC) {
            if dev.read_reg(u64(VIRTIO_MMIO_VERSION)) == u32(2) {
                if dev.read_reg(u64(VIRTIO_MMIO_DEVICE_ID)) == u32(VIRTIO_DEV_BLK) {
                    << base
                }
            }
        }
        i += 1
    }
    << u64(0)
}

pub fn (dev &VirtioDevice) init_features() bool {
    // Spec Section 3.1.1 steps 1..5: reset -> ack -> driver -> features -> features_ok
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_RESET))
    arch.fence()
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE))
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER))

    ver := dev.read_reg(u64(VIRTIO_MMIO_VERSION))
    dev.write_reg(u64(VIRTIO_MMIO_DRIVER_FEATURES_SEL), u32(0))
    dev.write_reg(u64(VIRTIO_MMIO_DRIVER_FEATURES), u32(0))
    if ver == u32(2) {
        dev.write_reg(u64(VIRTIO_MMIO_DEVICE_FEATURES_SEL), u32(1))
        hi := dev.read_reg(u64(VIRTIO_MMIO_DEVICE_FEATURES))
        dev.write_reg(u64(VIRTIO_MMIO_DRIVER_FEATURES_SEL), u32(1))
        dev.write_reg(u64(VIRTIO_MMIO_DRIVER_FEATURES), hi & u32(1)) // VIRTIO_F_VERSION_1

        dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK))
        st := dev.read_reg(u64(VIRTIO_MMIO_STATUS))
        if (st & u32(VIRTIO_STATUS_FEATURES_OK)) == u32(0) {
            << false
        }
    }
    << true
}

pub fn (dev &VirtioDevice) init_device() bool {
    if !dev.init_features() {
        << false
    }
    dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK | VIRTIO_STATUS_DRIVER_OK))
    << true
}

// ===== VirtIO-Blk MMIO v2 Driver =====

@repr("C")
pub struct VirtioBlkDriver {
    pub dev VirtioDevice
    pub capacity_sectors u64
    pub queue_size u32
    pub avail_idx u16
    pub last_used_idx u16
    pub desc_addr u64
    pub avail_addr u64
    pub used_addr u64
    pub req_addr u64
    pub status_addr u64
}

pub fn virtio_blk_new(base u64) VirtioBlkDriver {
    << VirtioBlkDriver{
        dev: virtio_device_new(base),
        capacity_sectors: u64(0),
        queue_size: u32(0),
        avail_idx: u16(0),
        last_used_idx: u16(0),
        desc_addr: u64(0),
        avail_addr: u64(0),
        used_addr: u64(0),
        req_addr: u64(0),
        status_addr: u64(0)
    }
}

pub fn (blk $&VirtioBlkDriver) init() bool {
    dev_type := blk.dev.probe()
    if dev_type != u32(VIRTIO_DEV_BLK) {
        << false
    }
    if !blk.dev.init_device() {
        << false
    }
    low := blk.dev.read_reg(u64(VIRTIO_MMIO_CONFIG))
    high := blk.dev.read_reg(u64(VIRTIO_MMIO_CONFIG + 4))
    blk.capacity_sectors = (u64(high) << u64(32)) | u64(low)
    << true
}

pub fn (blk $&VirtioBlkDriver) init_with_dma(dma_base u64, dma_bytes u64) bool {
    if dma_base == u64(0) || (dma_base & u64(4095)) != u64(0) || dma_bytes < u64(8192) {
        << false
    }
    if blk.dev.probe() != u32(VIRTIO_DEV_BLK) {
        << false
    }
    if blk.dev.read_reg(u64(VIRTIO_MMIO_VERSION)) != u32(2) {
        << false
    }
    if !blk.dev.init_features() {
        << false
    }

    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_SEL), u32(0))
    qmax := blk.dev.read_reg(u64(VIRTIO_MMIO_QUEUE_NUM_MAX))
    if qmax < u32(16) {
        << false
    }
    q_size := u32(16)

    mem.memset(usize(dma_base) as *raw u8, u8(0), 8192)
    desc_a := dma_base
    avail_a := dma_base + u64(256)
    req_a := dma_base + u64(512)
    stat_a := dma_base + u64(544)
    used_a := dma_base + u64(4096)

    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_NUM), q_size)
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_DESC_LOW), u32(desc_a & u64(0xFFFFFFFF)))
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_DESC_HIGH), u32(desc_a >> u64(32)))
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_DRIVER_LOW), u32(avail_a & u64(0xFFFFFFFF)))
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_DRIVER_HIGH), u32(avail_a >> u64(32)))
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_DEVICE_LOW), u32(used_a & u64(0xFFFFFFFF)))
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_DEVICE_HIGH), u32(used_a >> u64(32)))
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_READY), u32(1))

    blk.dev.write_reg(u64(VIRTIO_MMIO_STATUS), u32(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK | VIRTIO_STATUS_DRIVER_OK))

    low := blk.dev.read_reg(u64(VIRTIO_MMIO_CONFIG))
    high := blk.dev.read_reg(u64(VIRTIO_MMIO_CONFIG + 4))
    blk.capacity_sectors = (u64(high) << u64(32)) | u64(low)
    blk.queue_size = q_size
    blk.avail_idx = u16(0)
    blk.last_used_idx = u16(0)
    blk.desc_addr = desc_a
    blk.avail_addr = avail_a
    blk.used_addr = used_a
    blk.req_addr = req_a
    blk.status_addr = stat_a
    << true
}

pub fn (blk $&VirtioBlkDriver) rw_sector(sector u64, buf *raw u8, is_write bool) bool {
    if buf == 0 as *raw u8 || blk.queue_size == u32(0) || sector >= blk.capacity_sectors {
        << false
    }
    data_phys := u64(buf as usize)
    blk.avail_idx = virtq_prepare_blk(blk.desc_addr, blk.avail_addr, blk.req_addr, blk.status_addr,
                                      blk.queue_size, blk.avail_idx, sector, data_phys, is_write)
    blk.dev.write_reg(u64(VIRTIO_MMIO_QUEUE_NOTIFY), u32(0))
    res := virtq_wait_used(blk.used_addr, blk.last_used_idx, blk.status_addr)
    isr := blk.dev.read_reg(u64(VIRTIO_MMIO_INTERRUPT_STATUS))
    if isr != u32(0) {
        blk.dev.write_reg(u64(VIRTIO_MMIO_INTERRUPT_ACK), isr)
    }
    if res < 0 {
        << false
    }
    blk.last_used_idx = u16(res & 0xFFFF)
    << true
}

pub fn (blk $&VirtioBlkDriver) read_sector(sector u64, buf *raw u8) bool {
    << blk.rw_sector(sector, buf, false)
}

pub fn (blk $&VirtioBlkDriver) write_sector(sector u64, buf *raw u8) bool {
    << blk.rw_sector(sector, buf, true)
}

// ===== PCI Configuration Space & Legacy/Transitional VirtIO-PCI Blk =====

pub fn pci_read32(bus u8, dev u8, func u8, offset u8) u32 {
    addr := u32(0x80000000) |
            (u32(bus) << u32(16)) |
            (u32(dev & u8(0x1F)) << u32(11)) |
            (u32(func & u8(7)) << u32(8)) |
            u32(offset & u8(0xFC))
    unsafe {
        arch.out32(u16(PCI_CONFIG_ADDR), addr)
        << arch.in32(u16(PCI_CONFIG_DATA))
    }
}

pub fn pci_write32(bus u8, dev u8, func u8, offset u8, val u32) {
    addr := u32(0x80000000) |
            (u32(bus) << u32(16)) |
            (u32(dev & u8(0x1F)) << u32(11)) |
            (u32(func & u8(7)) << u32(8)) |
            u32(offset & u8(0xFC))
    unsafe {
        arch.out32(u16(PCI_CONFIG_ADDR), addr)
        arch.out32(u16(PCI_CONFIG_DATA), val)
    }
}

pub fn pci_find_virtio_blk() int {
    $d := 0
    while d < 32 {
        id := pci_read32(u8(0), u8(d), u8(0), u8(0))
        vendor := id & u32(0xFFFF)
        device := (id >> u32(16)) & u32(0xFFFF)
        if vendor == u32(VIRTIO_PCI_VENDOR) &&
           (device == u32(VIRTIO_PCI_DEV_BLK_LEGACY) || device == u32(VIRTIO_PCI_DEV_BLK_MODERN)) {
            << d
        }
        d += 1
    }
    << -1
}

@repr("C")
pub struct VirtioPciModernCaps {
    pub pci_dev u8
    pub pad0 u8
    pub pad1 u16
    pub notify_off_multiplier u32
    pub bar_phys u64
    pub bar_span u64
    pub common_cfg u64
    pub notify_base u64
    pub isr_cfg u64
    pub device_cfg u64
}

fn pci_read_mmio_bar(bus u8, dev u8, func u8, bar_idx u8) u64 {
    if bar_idx >= u8(6) {
        << u64(0)
    }
    reg := u8(0x10) + bar_idx * u8(4)
    lo := pci_read32(bus, dev, func, reg)
    if (lo & u32(1)) != u32(0) {
        << u64(0)
    }
    bar_type := (lo >> u32(1)) & u32(0x3)
    $base := u64(lo & u32(0xFFFFFFF0))
    if bar_type == u32(2) && bar_idx < u8(5) {
        hi := pci_read32(bus, dev, func, reg + u8(4))
        base = (u64(hi) << u64(32)) | base
    }
    << base
}

pub fn pci_probe_virtio_blk_modern(out *raw VirtioPciModernCaps) bool {
    if (out as usize) == usize(0) {
        << false
    }
    dev := pci_find_virtio_blk()
    if dev < 0 {
        << false
    }
    st_cmd := pci_read32(u8(0), u8(dev), u8(0), u8(0x04))
    status := (st_cmd >> u32(16)) & u32(0xFFFF)
    if (status & u32(0x10)) == u32(0) {
        << false
    }

    $cap_off := pci_read32(u8(0), u8(dev), u8(0), u8(0x34)) & u32(0xFC)
    $common := u64(0)
    $notify := u64(0)
    $isr := u64(0)
    $devcfg := u64(0)
    $mult := u32(0)
    $min_pa := u64(0)
    $max_pa := u64(0)
    $steps := 0

    while cap_off >= u32(0x40) && cap_off < u32(0xFF) && steps < 48 {
        d0 := pci_read32(u8(0), u8(dev), u8(0), u8(cap_off))
        cap_id := d0 & u32(0xFF)
        next_off := (d0 >> u32(8)) & u32(0xFC)
        if cap_id == u32(0x09) {
            cfg_type := (d0 >> u32(24)) & u32(0xFF)
            d1 := pci_read32(u8(0), u8(dev), u8(0), u8(cap_off + u32(4)))
            bar_idx := u8(d1 & u32(0xFF))
            off := pci_read32(u8(0), u8(dev), u8(0), u8(cap_off + u32(8)))
            $length := pci_read32(u8(0), u8(dev), u8(0), u8(cap_off + u32(12)))
            if length == u32(0) || length > u32(0x10000) {
                length = u32(4096)
            }
            bar_base := pci_read_mmio_bar(u8(0), u8(dev), u8(0), bar_idx)
            if bar_base != u64(0) {
                pa := bar_base + u64(off)
                pa_end := pa + u64(length)
                if cfg_type == u32(VIRTIO_PCI_CAP_COMMON_CFG) && common == u64(0) {
                    common = pa
                } else if cfg_type == u32(VIRTIO_PCI_CAP_NOTIFY_CFG) && notify == u64(0) {
                    notify = pa
                    mult = pci_read32(u8(0), u8(dev), u8(0), u8(cap_off + u32(16)))
                } else if cfg_type == u32(VIRTIO_PCI_CAP_ISR_CFG) && isr == u64(0) {
                    isr = pa
                } else if cfg_type == u32(VIRTIO_PCI_CAP_DEVICE_CFG) && devcfg == u64(0) {
                    devcfg = pa
                }
                if cfg_type >= u32(VIRTIO_PCI_CAP_COMMON_CFG) && cfg_type <= u32(VIRTIO_PCI_CAP_DEVICE_CFG) {
                    if min_pa == u64(0) || pa < min_pa {
                        min_pa = pa
                    }
                    if pa_end > max_pa {
                        max_pa = pa_end
                    }
                }
            }
        }
        if next_off == cap_off {
            <-
        }
        cap_off = next_off
        steps += 1
    }

    if common == u64(0) || notify == u64(0) || isr == u64(0) || devcfg == u64(0) || min_pa == u64(0) {
        << false
    }

    aligned_base := min_pa - (min_pa & u64(4095))
    aligned_end := align_up_4k(max_pa)
    span := aligned_end - aligned_base
    if span == u64(0) || span > u64(0x100000) {
        << false
    }

    unsafe {
        *out = VirtioPciModernCaps{
            pci_dev: u8(dev),
            pad0: u8(0),
            pad1: u16(0),
            notify_off_multiplier: mult,
            bar_phys: aligned_base,
            bar_span: span,
            common_cfg: common,
            notify_base: notify,
            isr_cfg: isr,
            device_cfg: devcfg
        }
    }
    << true
}

@repr("C")
pub struct VirtioPciBlkDriver {
    pub io_base u16
    pub pci_dev u8
    pub pad0 u8
    pub queue_size u32
    pub avail_idx u16
    pub last_used_idx u16
    pub is_modern u32
    pub capacity_sectors u64
    pub desc_addr u64
    pub avail_addr u64
    pub used_addr u64
    pub req_addr u64
    pub status_addr u64
    pub common_cfg u64
    pub notify_addr u64
    pub isr_addr u64
    pub device_cfg u64
}

pub fn virtio_pci_blk_new() VirtioPciBlkDriver {
    << VirtioPciBlkDriver{
        io_base: u16(0),
        pci_dev: u8(0),
        pad0: u8(0),
        queue_size: u32(0),
        avail_idx: u16(0),
        last_used_idx: u16(0),
        is_modern: u32(0),
        capacity_sectors: u64(0),
        desc_addr: u64(0),
        avail_addr: u64(0),
        used_addr: u64(0),
        req_addr: u64(0),
        status_addr: u64(0),
        common_cfg: u64(0),
        notify_addr: u64(0),
        isr_addr: u64(0),
        device_cfg: u64(0)
    }
}

pub fn (blk $&VirtioPciBlkDriver) init_pci_modern(caps *raw VirtioPciModernCaps, dma_base u64, dma_bytes u64) bool {
    if (caps as usize) == usize(0) || dma_base == u64(0) || (dma_base & u64(4095)) != u64(0) || dma_bytes < u64(16384) {
        << false
    }
    unsafe {
        c := *caps
        if c.common_cfg == u64(0) || c.notify_base == u64(0) || c.isr_cfg == u64(0) || c.device_cfg == u64(0) {
            << false
        }
        // Enable PCI Memory Space (bit 1) + Bus Master DMA (bit 2)
        cmd := pci_read32(u8(0), c.pci_dev, u8(0), u8(0x04))
        pci_write32(u8(0), c.pci_dev, u8(0), u8(0x04), cmd | u32(0x06))

        st_p := usize(c.common_cfg + u64(VIRTIO_COMMON_STATUS)) as *raw u8
        volatile_write(st_p, u8(VIRTIO_STATUS_RESET))
        arch.fence()
        volatile_write(st_p, u8(VIRTIO_STATUS_ACKNOWLEDGE))
        volatile_write(st_p, u8(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER))

        // Negotiate VIRTIO_F_VERSION_1 (bit 32 -> dword 1 bit 0) when offered
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_DRV_FEAT_SEL)) as *raw u32, u32(0))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_DRV_FEAT)) as *raw u32, u32(0))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_DEV_FEAT_SEL)) as *raw u32, u32(1))
        feat_hi := volatile_read(usize(c.common_cfg + u64(VIRTIO_COMMON_DEV_FEAT)) as *raw u32)
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_DRV_FEAT_SEL)) as *raw u32, u32(1))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_DRV_FEAT)) as *raw u32, feat_hi & u32(1))

        st_fok := u8(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_FEATURES_OK)
        volatile_write(st_p, st_fok)
        if (volatile_read(st_p) & u8(VIRTIO_STATUS_FEATURES_OK)) == u8(0) {
            volatile_write(st_p, u8(VIRTIO_STATUS_FAILED))
            << false
        }

        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_SELECT)) as *raw u16, u16(0))
        $q_size := u32(volatile_read(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_SIZE)) as *raw u16))
        if q_size < u32(8) || (q_size & (q_size - u32(1))) != u32(0) {
            volatile_write(st_p, u8(VIRTIO_STATUS_FAILED))
            << false
        }
        if q_size > u32(256) {
            q_size = u32(256)
            volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_SIZE)) as *raw u16, u16(q_size))
        }

        avail_off := u64(q_size) * u64(16)
        used_off := align_up_4k(avail_off + u64(6) + u64(q_size) * u64(2))
        if used_off + u64(6) + u64(q_size) * u64(8) > u64(12288) {
            volatile_write(st_p, u8(VIRTIO_STATUS_FAILED))
            << false
        }

        mem.memset(usize(dma_base) as *raw u8, u8(0), 16384)
        arch.fence()

        desc_pa := dma_base
        avail_pa := dma_base + avail_off
        used_pa := dma_base + used_off

        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_DESC_LO)) as *raw u32, u32(desc_pa & u64(0xFFFFFFFF)))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_DESC_HI)) as *raw u32, u32(desc_pa >> u64(32)))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_AVAIL_LO)) as *raw u32, u32(avail_pa & u64(0xFFFFFFFF)))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_AVAIL_HI)) as *raw u32, u32(avail_pa >> u64(32)))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_USED_LO)) as *raw u32, u32(used_pa & u64(0xFFFFFFFF)))
        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_USED_HI)) as *raw u32, u32(used_pa >> u64(32)))

        q_notify_off := volatile_read(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_NOTIFY_OFF)) as *raw u16)
        notify_pa := c.notify_base + u64(q_notify_off) * u64(c.notify_off_multiplier)

        volatile_write(usize(c.common_cfg + u64(VIRTIO_COMMON_Q_ENABLE)) as *raw u16, u16(1))
        volatile_write(st_p, st_fok | u8(VIRTIO_STATUS_DRIVER_OK))

        cap_lo := volatile_read(usize(c.device_cfg) as *raw u32)
        cap_hi := volatile_read(usize(c.device_cfg + u64(4)) as *raw u32)

        blk.io_base = u16(0)
        blk.pci_dev = c.pci_dev
        blk.queue_size = q_size
        blk.avail_idx = u16(0)
        blk.last_used_idx = u16(0)
        blk.is_modern = u32(1)
        blk.capacity_sectors = (u64(cap_hi) << u64(32)) | u64(cap_lo)
        blk.desc_addr = desc_pa
        blk.avail_addr = avail_pa
        blk.used_addr = used_pa
        blk.req_addr = dma_base + u64(12288)
        blk.status_addr = dma_base + u64(12352)
        blk.common_cfg = c.common_cfg
        blk.notify_addr = notify_pa
        blk.isr_addr = c.isr_cfg
        blk.device_cfg = c.device_cfg
    }
    << true
}

pub fn (blk $&VirtioPciBlkDriver) init_pci(dma_base u64, dma_bytes u64) bool {
    if dma_base == u64(0) || (dma_base & u64(4095)) != u64(0) || dma_bytes < u64(16384) {
        << false
    }
    dev := pci_find_virtio_blk()
    if dev < 0 {
        << false
    }
    bar0 := pci_read32(u8(0), u8(dev), u8(0), u8(0x10))
    if (bar0 & u32(1)) == u32(0) {
        << false
    }
    io := u16(bar0 & u32(0xFFFC))
    if io == u16(0) {
        << false
    }

    // Enable PCI I/O Space (bit 0) + Bus Master DMA (bit 2)
    cmd := pci_read32(u8(0), u8(dev), u8(0), u8(0x04))
    pci_write32(u8(0), u8(dev), u8(0), u8(0x04), cmd | u32(0x05))

    unsafe {
        arch.out8(io + u16(VIRTIO_PCI_STATUS), u8(VIRTIO_STATUS_RESET))
        arch.fence()
        arch.out8(io + u16(VIRTIO_PCI_STATUS), u8(VIRTIO_STATUS_ACKNOWLEDGE))
        arch.out8(io + u16(VIRTIO_PCI_STATUS), u8(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER))
        arch.out32(io + u16(VIRTIO_PCI_GUEST_FEATURES), u32(0))

        arch.out16(io + u16(VIRTIO_PCI_QUEUE_SEL), u16(0))
        $q_size := u32(arch.in16(io + u16(VIRTIO_PCI_QUEUE_NUM)))
        if q_size < u32(8) || q_size > u32(256) || (q_size & (q_size - u32(1))) != u32(0) {
            arch.out8(io + u16(VIRTIO_PCI_STATUS), u8(VIRTIO_STATUS_FAILED))
            << false
        }

        avail_off := u64(q_size) * u64(16)
        used_off := align_up_4k(avail_off + u64(6) + u64(q_size) * u64(2))
        if used_off + u64(6) + u64(q_size) * u64(8) > u64(12288) {
            arch.out8(io + u16(VIRTIO_PCI_STATUS), u8(VIRTIO_STATUS_FAILED))
            << false
        }

        mem.memset(usize(dma_base) as *raw u8, u8(0), 16384)
        arch.fence()
        arch.out32(io + u16(VIRTIO_PCI_QUEUE_PFN), u32(dma_base >> u64(12)))
        arch.out8(io + u16(VIRTIO_PCI_STATUS), u8(VIRTIO_STATUS_ACKNOWLEDGE | VIRTIO_STATUS_DRIVER | VIRTIO_STATUS_DRIVER_OK))

        cap_lo := arch.in32(io + u16(VIRTIO_PCI_BLK_CAP_LO))
        cap_hi := arch.in32(io + u16(VIRTIO_PCI_BLK_CAP_HI))
        blk.io_base = io
        blk.pci_dev = u8(dev)
        blk.queue_size = q_size
        blk.avail_idx = u16(0)
        blk.last_used_idx = u16(0)
        blk.is_modern = u32(0)
        blk.capacity_sectors = (u64(cap_hi) << u64(32)) | u64(cap_lo)
        blk.desc_addr = dma_base
        blk.avail_addr = dma_base + avail_off
        blk.used_addr = dma_base + used_off
        blk.req_addr = dma_base + u64(12288)
        blk.status_addr = dma_base + u64(12352)
        blk.common_cfg = u64(0)
        blk.notify_addr = u64(0)
        blk.isr_addr = u64(0)
        blk.device_cfg = u64(0)
    }
    << true
}

pub fn (blk $&VirtioPciBlkDriver) rw_sector(sector u64, buf *raw u8, is_write bool) bool {
    if (buf as usize) == usize(0) || blk.queue_size == u32(0) || sector >= blk.capacity_sectors {
        << false
    }
    data_phys := u64(buf as usize)
    blk.avail_idx = virtq_prepare_blk(blk.desc_addr, blk.avail_addr, blk.req_addr, blk.status_addr,
                                      blk.queue_size, blk.avail_idx, sector, data_phys, is_write)
    unsafe {
        if blk.is_modern != u32(0) {
            volatile_write(usize(blk.notify_addr) as *raw u16, u16(0))
        } else {
            arch.out16(blk.io_base + u16(VIRTIO_PCI_QUEUE_NOTIFY), u16(0))
        }
        res := virtq_wait_used(blk.used_addr, blk.last_used_idx, blk.status_addr)
        if blk.is_modern != u32(0) {
            _isr := volatile_read(usize(blk.isr_addr) as *raw u8)
        } else {
            arch.in8(blk.io_base + u16(VIRTIO_PCI_ISR))
        }
        if res < 0 {
            << false
        }
        blk.last_used_idx = u16(res & 0xFFFF)
    }
    << true
}

pub fn (blk $&VirtioPciBlkDriver) read_sectors(sector u64, count int, buf *raw u8) bool {
    if (buf as usize) == usize(0) || blk.queue_size == u32(0) || count <= 0 || count > 128 {
        << false
    }
    if sector + u64(count) > blk.capacity_sectors {
        << false
    }
    data_phys := u64(buf as usize)
    blk.avail_idx = virtq_prepare_blk_n(blk.desc_addr, blk.avail_addr, blk.req_addr, blk.status_addr,
                                        blk.queue_size, blk.avail_idx, sector, data_phys, u32(count * 512), false)
    unsafe {
        if blk.is_modern != u32(0) {
            volatile_write(usize(blk.notify_addr) as *raw u16, u16(0))
        } else {
            arch.out16(blk.io_base + u16(VIRTIO_PCI_QUEUE_NOTIFY), u16(0))
        }
        res := virtq_wait_used(blk.used_addr, blk.last_used_idx, blk.status_addr)
        if blk.is_modern != u32(0) {
            _isr := volatile_read(usize(blk.isr_addr) as *raw u8)
        } else {
            arch.in8(blk.io_base + u16(VIRTIO_PCI_ISR))
        }
        if res < 0 {
            << false
        }
        blk.last_used_idx = u16(res & 0xFFFF)
    }
    << true
}

pub fn (blk $&VirtioPciBlkDriver) read_sector(sector u64, buf *raw u8) bool {
    << blk.rw_sector(sector, buf, false)
}

pub fn (blk $&VirtioPciBlkDriver) write_sector(sector u64, buf *raw u8) bool {
    << blk.rw_sector(sector, buf, true)
}

// ===== VirtIO-Net Driver wrapper =====

pub struct VirtioNetDriver {
    pub dev VirtioDevice
    pub mac0 u8
    pub mac1 u8
    pub mac2 u8
    pub mac3 u8
    pub mac4 u8
    pub mac5 u8
}

pub fn virtio_net_new(base u64) VirtioNetDriver {
    << VirtioNetDriver{
        dev: virtio_device_new(base),
        mac0: 0, mac1: 0, mac2: 0, mac3: 0, mac4: 0, mac5: 0
    }
}

pub fn (net $&VirtioNetDriver) init() bool {
    dev_type := net.dev.probe()
    if dev_type != u32(VIRTIO_DEV_NET) {
        << false
    }
    if !net.dev.init_device() {
        << false
    }
    // Read MAC address from config space (offset 0x100..0x105)
    w0 := net.dev.read_reg(u64(VIRTIO_MMIO_CONFIG))
    w1 := net.dev.read_reg(u64(VIRTIO_MMIO_CONFIG + 4))
    net.mac0 = u8(w0 & u32(0xFF))
    net.mac1 = u8((w0 >> u32(8)) & u32(0xFF))
    net.mac2 = u8((w0 >> u32(16)) & u32(0xFF))
    net.mac3 = u8((w0 >> u32(24)) & u32(0xFF))
    net.mac4 = u8(w1 & u32(0xFF))
    net.mac5 = u8((w1 >> u32(8)) & u32(0xFF))
    << true
}
