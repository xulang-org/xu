@core/fdt
$freestanding

pub const FDT_MAGIC = 0xD00DFEED
pub const FDT_BEGIN_NODE = 1
pub const FDT_END_NODE = 2
pub const FDT_PROP = 3
pub const FDT_NOP = 4
pub const FDT_END = 9

const KIND_NONE = 0
const KIND_MEMORY = 1
const KIND_UART = 2
const KIND_GIC = 3
const KIND_PLIC = 4
const KIND_CLINT = 5

pub struct FdtSummary {
    pub total_size u32
    pub node_count int
    pub cpu_count int
    pub mem_base u64
    pub mem_size u64
    pub has_uart bool
    pub uart_base u64
    pub has_gic bool
    pub gic_dist_base u64
    pub has_plic bool
    pub plic_base u64
    pub has_clint bool
    pub clint_base u64
}

pub fn fdt_be32(addr u64) u32 {
    unsafe {
        b0 := u32(*((addr + u64(0)) as *raw u8))
        b1 := u32(*((addr + u64(1)) as *raw u8))
        b2 := u32(*((addr + u64(2)) as *raw u8))
        b3 := u32(*((addr + u64(3)) as *raw u8))
        << (b0 << u32(24)) | (b1 << u32(16)) | (b2 << u32(8)) | b3
    }
}

pub fn fdt_be64(addr u64) u64 {
    hi := u64(fdt_be32(addr))
    lo := u64(fdt_be32(addr + u64(4)))
    << (hi << u64(32)) | lo
}

pub fn fdt_valid(dtb_addr u64) bool {
    if dtb_addr == u64(0) {
        << false
    }
    if fdt_be32(dtb_addr) != u32(FDT_MAGIC) {
        << false
    }
    tsize := fdt_be32(dtb_addr + u64(4))
    << tsize >= u32(40)
}

pub fn fdt_total_size(dtb_addr u64) u32 {
    if !fdt_valid(dtb_addr) {
        << u32(0)
    }
    << fdt_be32(dtb_addr + u64(4))
}

fn cstr_eq(addr u64, target &string) bool {
    unsafe {
        $i := 0
        while i < target.len {
            c := *((addr + u64(i)) as *raw u8)
            if c != u8((*target)[i]) {
                << false
            }
            i += 1
        }
        << *((addr + u64(target.len)) as *raw u8) == u8(0)
    }
}

fn cstr_prefix(addr u64, pfx &string) bool {
    unsafe {
        $i := 0
        while i < pfx.len {
            c := *((addr + u64(i)) as *raw u8)
            if c != u8((*pfx)[i]) {
                << false
            }
            i += 1
        }
        << true
    }
}

fn cstr_len(addr u64, max_len u64) u64 {
    unsafe {
        $i := u64(0)
        while i < max_len {
            if *((addr + i) as *raw u8) == u8(0) {
                << i
            }
            i += u64(1)
        }
        << max_len
    }
}

fn cstr_list_has(addr u64, prop_len int, target &string) bool {
    if addr == u64(0) || prop_len <= 0 {
        << false
    }
    unsafe {
        $off := 0
        while off < prop_len {
            if cstr_eq(addr + u64(off), target) {
                << true
            }
            $sl := 0
            while off + sl < prop_len && *((addr + u64(off + sl)) as *raw u8) != u8(0) {
                sl += 1
            }
            off += sl + 1
        }
    }
    << false
}

fn fdt_align4(v u64) u64 {
    << ((v + u64(3)) / u64(4)) * u64(4)
}

fn read_cells(addr u64, cells int) u64 {
    if cells <= 1 {
        << u64(fdt_be32(addr))
    }
    << fdt_be64(addr)
}

pub fn fdt_parse_summary(dtb_addr u64, out *raw FdtSummary) bool {
    if !fdt_valid(dtb_addr) {
        << false
    }
    unsafe {
        if (out as u64) == u64(0) {
            << false
        }
        total_size := fdt_be32(dtb_addr + u64(4))
        off_struct := u64(fdt_be32(dtb_addr + u64(8)))
        off_strings := u64(fdt_be32(dtb_addr + u64(12)))
        if off_struct < u64(40) || off_struct >= u64(total_size) || off_strings >= u64(total_size) {
            << false
        }

        $sum := FdtSummary{
            total_size: total_size,
            node_count: 0,
            cpu_count: 0,
            mem_base: u64(0),
            mem_size: u64(0),
            has_uart: false,
            uart_base: u64(0),
            has_gic: false,
            gic_dist_base: u64(0),
            has_plic: false,
            plic_base: u64(0),
            has_clint: false,
            clint_base: u64(0)
        }

        $nkind := [16]int{}
        $nreg_ptr := [16]u64{}
        $nreg_len := [16]int{}
        $nacells := [16]int{}
        $nscells := [16]int{}
        for di in 0:16 {
            nkind[di] = KIND_NONE
            nreg_ptr[di] = u64(0)
            nreg_len[di] = 0
            nacells[di] = 2
            nscells[di] = 2
        }

        $depth := -1
        $in_cpus := false
        $cpus_depth := -1
        $p := dtb_addr + off_struct
        $end_p := dtb_addr + u64(total_size)

        while p + u64(4) <= end_p {
            tok := fdt_be32(p)
            p += u64(4)
            if tok == u32(FDT_NOP) {
                ->
            } else if tok == u32(FDT_END) {
                <-
            } else if tok == u32(FDT_BEGIN_NODE) {
                max_name := end_p - p
                nlen := cstr_len(p, max_name)
                $d := depth + 1
                depth = d
                sum.node_count += 1
                if d >= 0 && d < 16 {
                    nkind[d] = KIND_NONE
                    nreg_ptr[d] = u64(0)
                    nreg_len[d] = 0
                    if d > 0 {
                        nacells[d] = nacells[d - 1]
                        nscells[d] = nscells[d - 1]
                    } else {
                        nacells[d] = 2
                        nscells[d] = 2
                    }
                    s_cpus := "cpus"
                    s_cpu_pfx := "cpu@"
                    s_mem_pfx := "memory"
                    if cstr_eq(p, &s_cpus) {
                        in_cpus = true
                        cpus_depth = d
                    } else if in_cpus && d == cpus_depth + 1 && cstr_prefix(p, &s_cpu_pfx) {
                        sum.cpu_count += 1
                    } else if cstr_prefix(p, &s_mem_pfx) {
                        nkind[d] = KIND_MEMORY
                    }
                }
                p = fdt_align4(p + nlen + u64(1))
            } else if tok == u32(FDT_END_NODE) {
                if depth >= 0 && depth < 16 {
                    k := nkind[depth]
                    rp := nreg_ptr[depth]
                    rlen := nreg_len[depth]
                    $ac := 2
                    $sc := 2
                    if depth > 0 {
                        ac = nacells[depth - 1]
                        sc = nscells[depth - 1]
                    }
                    need := (ac + sc) * 4
                    if rp != u64(0) && rlen >= ac * 4 {
                        base_val := read_cells(rp, ac)
                        $size_val := u64(0)
                        if rlen >= need && sc > 0 {
                            size_val = read_cells(rp + u64(ac * 4), sc)
                        }
                        if k == KIND_MEMORY && sum.mem_size == u64(0) {
                            sum.mem_base = base_val
                            sum.mem_size = size_val
                        } else if k == KIND_UART && !sum.has_uart {
                            sum.has_uart = true
                            sum.uart_base = base_val
                        } else if k == KIND_GIC && !sum.has_gic {
                            sum.has_gic = true
                            sum.gic_dist_base = base_val
                        } else if k == KIND_PLIC && !sum.has_plic {
                            sum.has_plic = true
                            sum.plic_base = base_val
                        } else if k == KIND_CLINT && !sum.has_clint {
                            sum.has_clint = true
                            sum.clint_base = base_val
                        }
                    }
                }
                if in_cpus && depth == cpus_depth {
                    in_cpus = false
                    cpus_depth = -1
                }
                depth -= 1
            } else if tok == u32(FDT_PROP) {
                if p + u64(8) > end_p {
                    <-
                }
                plen := int(fdt_be32(p))
                name_off := u64(fdt_be32(p + u64(4)))
                p += u64(8)
                prop_name := dtb_addr + off_strings + name_off
                if p + u64(plen) > end_p {
                    <-
                }
                if depth >= 0 && depth < 16 && prop_name < end_p {
                    s_ac := "#address-cells"
                    s_sc := "#size-cells"
                    s_reg := "reg"
                    s_dt := "device_type"
                    s_mem := "memory"
                    s_cmp := "compatible"
                    s_pl011 := "arm,pl011"
                    s_ns1 := "ns16550a"
                    s_ns2 := "ns16550"
                    s_gic1 := "arm,cortex-a15-gic"
                    s_gic2 := "arm,gic-v3"
                    s_gic3 := "arm,gic-400"
                    s_plic1 := "riscv,plic0"
                    s_plic2 := "sifive,plic-1.0.0"
                    s_cl1 := "riscv,clint0"
                    s_cl2 := "sifive,clint0"
                    if cstr_eq(prop_name, &s_ac) && plen >= 4 {
                        nacells[depth] = int(fdt_be32(p))
                    } else if cstr_eq(prop_name, &s_sc) && plen >= 4 {
                        nscells[depth] = int(fdt_be32(p))
                    } else if cstr_eq(prop_name, &s_reg) {
                        nreg_ptr[depth] = p
                        nreg_len[depth] = plen
                    } else if cstr_eq(prop_name, &s_dt) {
                        if cstr_list_has(p, plen, &s_mem) {
                            nkind[depth] = KIND_MEMORY
                        }
                    } else if cstr_eq(prop_name, &s_cmp) {
                        if cstr_list_has(p, plen, &s_pl011) ||
                           cstr_list_has(p, plen, &s_ns1) ||
                           cstr_list_has(p, plen, &s_ns2) {
                            nkind[depth] = KIND_UART
                        } else if cstr_list_has(p, plen, &s_gic1) ||
                                  cstr_list_has(p, plen, &s_gic2) ||
                                  cstr_list_has(p, plen, &s_gic3) {
                            nkind[depth] = KIND_GIC
                        } else if cstr_list_has(p, plen, &s_plic1) ||
                                  cstr_list_has(p, plen, &s_plic2) {
                            nkind[depth] = KIND_PLIC
                        } else if cstr_list_has(p, plen, &s_cl1) ||
                                  cstr_list_has(p, plen, &s_cl2) {
                            nkind[depth] = KIND_CLINT
                        }
                    }
                }
                p = fdt_align4(p + u64(plen))
            } else {
                <-
            }
        }
        *out = sum
    }
    << true
}
