@core/alloc

// Memory allocation contracts for kernels, drivers, and embedded systems.

pub struct Layout {
    size int
    align int
}

pub fn layout_new(size int, align int) Layout {
    << Layout{size: size, align: align}
}

pub struct@ GlobalAlloc {
    fn alloc(layout Layout) *raw u8
    fn dealloc(ptr *raw u8, layout Layout)
}
