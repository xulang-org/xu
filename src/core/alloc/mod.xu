@core/alloc

// Memory allocation contracts and zero-dependency freestanding allocators
// (BumpAllocator, FixedPoolAllocator, LinkedListAllocator) for baremetal
// kernels, drivers, and embedded systems.

#core/mem

pub struct Layout {
    pub size int
    pub align int
}

pub fn layout_new(size int, align int) Layout {
    << Layout{size: size, align: align}
}

pub struct@ GlobalAlloc {
    fn alloc(Layout) *raw u8
    fn dealloc(*raw u8, Layout)
}

pub fn is_power_of_two(n usize) bool {
    << n > usize(0) && (n & (n - usize(1))) == usize(0)
}

pub fn align_up(addr usize, align usize) usize {
    if align <= usize(1) {
        << addr
    }
    mask := align - usize(1)
    max_u := usize(0) - usize(1)
    if addr > max_u - mask {
        << usize(0)
    }
    sum := addr + mask
    << sum - (sum & mask)
}

pub fn align_down(addr usize, align usize) usize {
    if align <= usize(1) {
        << addr
    }
    mask := align - usize(1)
    << addr - (addr & mask)
}

pub fn (l Layout) byte_size() usize {
    if l.size <= 0 {
        << usize(0)
    }
    << usize(l.size)
}

pub fn (l Layout) byte_align() usize {
    if l.align <= 0 {
        << usize(0)
    }
    << usize(l.align)
}

pub fn (l Layout) is_valid() bool {
    << l.size >= 0 && l.align > 0 && is_power_of_two(usize(l.align))
}

// ===== 1. BumpAllocator (O(1) arena / early-boot allocator) =====

@repr("C")
pub struct BumpAllocator {
    pub base usize
    pub limit usize
    pub cursor usize
    pub allocs usize
}

pub fn bump_init(a *raw BumpAllocator, base *raw u8, size usize) {
    start := base as usize
    max_u := usize(0) - usize(1)
    $lim := start
    if size > max_u - start {
        lim = max_u
    } else {
        lim = start + size
    }
    unsafe {
        (*a).base = start
        (*a).limit = lim
        (*a).cursor = start
        (*a).allocs = usize(0)
    }
}

pub fn (a $&BumpAllocator) alloc_raw(size usize, align usize) *raw u8 {
    if size == usize(0) {
        << 0 as *raw u8
    }
    if align != usize(0) && !is_power_of_two(align) {
        << 0 as *raw u8
    }
    $eff_align := align
    if eff_align == usize(0) {
        eff_align = usize(1)
    }
    start := align_up(a.cursor, eff_align)
    if start < a.cursor || start > a.limit || size > a.limit - start {
        << 0 as *raw u8
    }
    a.cursor = start + size
    a.allocs += usize(1)
    << start as *raw u8
}

pub fn (a $&BumpAllocator) alloc_zeroed(size usize, align usize) *raw u8 {
    ptr := a.alloc_raw(size, align)
    if ptr != 0 as *raw u8 {
        mem.memset(ptr, u8(0), int(size))
    }
    << ptr
}

pub fn (a $&BumpAllocator) alloc(layout Layout) *raw u8 {
    if !layout.is_valid() || layout.size == 0 {
        << 0 as *raw u8
    }
    << a.alloc_raw(usize(layout.size), usize(layout.align))
}

pub fn (a $&BumpAllocator) dealloc(ptr *raw u8, layout Layout) {
    if ptr == 0 as *raw u8 && layout.size == 0 {
        <<
    }
}

pub fn (a $&BumpAllocator) reset() {
    a.cursor = a.base
    a.allocs = usize(0)
}

pub fn (a &BumpAllocator) used() usize {
    if a.cursor <= a.base {
        << usize(0)
    }
    << a.cursor - a.base
}

pub fn (a &BumpAllocator) remaining() usize {
    if a.limit <= a.cursor {
        << usize(0)
    }
    << a.limit - a.cursor
}

// ===== 2. FixedPoolAllocator (O(1) slab / fixed-slot object pool) =====

@repr("C")
pub struct FixedPoolAllocator {
    pub base usize
    pub end usize
    pub slot_size usize
    pub capacity usize
    pub free_head usize
    pub free_count usize
}

pub fn fixed_pool_init(p *raw FixedPoolAllocator, mem_base *raw u8, mem_bytes usize, slot_size usize, slot_align usize) usize {
    unsafe {
        (*p).base = usize(0)
        (*p).end = usize(0)
        (*p).slot_size = usize(0)
        (*p).capacity = usize(0)
        (*p).free_head = usize(0)
        (*p).free_count = usize(0)
    }
    $eff_align := usize(8)
    if slot_align > usize(8) {
        if !is_power_of_two(slot_align) {
            << usize(0)
        }
        eff_align = slot_align
    }
    $eff_size := slot_size
    if eff_size < usize(8) {
        eff_size = usize(8)
    }
    stride := align_up(eff_size, eff_align)
    if stride == usize(0) {
        << usize(0)
    }
    raw_start := mem_base as usize
    max_u := usize(0) - usize(1)
    $raw_end := raw_start
    if mem_bytes > max_u - raw_start {
        raw_end = max_u
    } else {
        raw_end = raw_start + mem_bytes
    }
    start := align_up(raw_start, eff_align)
    if start < raw_start || start >= raw_end {
        << usize(0)
    }

    $cur := start
    $prev := usize(0)
    $count := usize(0)
    while cur <= raw_end && (raw_end - cur) >= stride {
        unsafe {
            *(cur as *raw usize) = usize(0)
            if prev != usize(0) {
                *(prev as *raw usize) = cur
            }
        }
        prev = cur
        count += usize(1)
        if stride > max_u - cur {
            cur = raw_end
            <-
        }
        cur += stride
    }
    $head := usize(0)
    if count > usize(0) {
        head = start
    }
    unsafe {
        (*p).base = start
        (*p).end = cur
        (*p).slot_size = stride
        (*p).capacity = count
        (*p).free_head = head
        (*p).free_count = count
    }
    << count
}

pub fn (p $&FixedPoolAllocator) alloc_slot() *raw u8 {
    if p.free_head == usize(0) {
        << 0 as *raw u8
    }
    slot := p.free_head
    unsafe {
        nxt := *(slot as *raw usize)
        p.free_head = nxt
    }
    if p.free_count > usize(0) {
        p.free_count -= usize(1)
    }
    << slot as *raw u8
}

pub fn (p $&FixedPoolAllocator) free_slot(ptr *raw u8) bool {
    if ptr == 0 as *raw u8 {
        << false
    }
    addr := ptr as usize
    if addr < p.base || addr >= p.end || p.free_count >= p.capacity {
        << false
    }
    if is_power_of_two(p.slot_size) && ((addr - p.base) & (p.slot_size - usize(1))) != usize(0) {
        << false
    }
    unsafe {
        *(addr as *raw usize) = p.free_head
    }
    p.free_head = addr
    p.free_count += usize(1)
    << true
}

pub fn (p &FixedPoolAllocator) available() usize {
    << p.free_count
}

pub fn (p &FixedPoolAllocator) in_use() usize {
    if p.capacity <= p.free_count {
        << usize(0)
    }
    << p.capacity - p.free_count
}

// ===== 3. LinkedListAllocator (first-fit heap with coalescing & alignment) =====

const HEAP_MAGIC = 0x5855484541503031u64 // "XUHEAP01"
const HEAP_HDR_SIZE = 48
const HEAP_MIN_PAYLOAD = 16

@repr("C")
struct HeapNode {
    magic u64
    size u64
    is_free u64
    prev u64
    next u64
    pad u64
}

@repr("C")
pub struct LinkedListAllocator {
    pub base usize
    pub end usize
    pub head usize
    pub bytes_used usize
    pub bytes_free usize
    pub block_count usize
    pub alloc_count usize
    pub free_count usize
}

pub fn linked_list_init(a *raw LinkedListAllocator, base *raw u8, size usize) bool {
    unsafe {
        (*a).base = usize(0)
        (*a).end = usize(0)
        (*a).head = usize(0)
        (*a).bytes_used = usize(0)
        (*a).bytes_free = usize(0)
        (*a).block_count = usize(0)
        (*a).alloc_count = usize(0)
        (*a).free_count = usize(0)
    }
    raw_start := base as usize
    max_u := usize(0) - usize(1)
    $raw_end := raw_start
    if size > max_u - raw_start {
        raw_end = max_u
    } else {
        raw_end = raw_start + size
    }
    start := align_up(raw_start, usize(16))
    aligned_end := align_down(raw_end, usize(16))
    if start < raw_start || aligned_end <= start {
        << false
    }
    if (aligned_end - start) < usize(HEAP_HDR_SIZE + HEAP_MIN_PAYLOAD) {
        << false
    }
    usable := aligned_end - start - usize(HEAP_HDR_SIZE)
    unsafe {
        blk := start as *raw HeapNode
        *blk = HeapNode{
            magic: HEAP_MAGIC,
            size: u64(usable),
            is_free: u64(1),
            prev: u64(0),
            next: u64(0),
            pad: u64(0)
        }
        (*a).base = start
        (*a).end = aligned_end
        (*a).head = start
        (*a).bytes_used = usize(0)
        (*a).bytes_free = usable
        (*a).block_count = usize(1)
        (*a).alloc_count = usize(0)
        (*a).free_count = usize(0)
    }
    << true
}

pub fn (a $&LinkedListAllocator) alloc_raw(size usize, align usize) *raw u8 {
    if size == usize(0) {
        << 0 as *raw u8
    }
    if align != usize(0) && !is_power_of_two(align) {
        << 0 as *raw u8
    }
    $eff_align := align
    if eff_align < usize(16) {
        eff_align = usize(16)
    }
    $req := align_up(size, usize(16))
    if req == usize(0) {
        << 0 as *raw u8
    }
    if req < usize(HEAP_MIN_PAYLOAD) {
        req = usize(HEAP_MIN_PAYLOAD)
    }

    unsafe {
        $cur := a.head
        while cur != usize(0) {
            $blk := cur as *raw HeapNode
            if (*blk).magic != HEAP_MAGIC {
                << 0 as *raw u8
            }
            if (*blk).is_free == u64(1) {
                raw_payload := cur + usize(HEAP_HDR_SIZE)
                $aligned := align_up(raw_payload, eff_align)
                if aligned < raw_payload {
                    cur = usize((*blk).next)
                    ->
                }
                if aligned > raw_payload && (aligned - raw_payload) < usize(HEAP_HDR_SIZE) {
                    aligned = align_up(raw_payload + usize(HEAP_HDR_SIZE), eff_align)
                    if aligned < raw_payload {
                        cur = usize((*blk).next)
                        ->
                    }
                }
                front_gap := aligned - raw_payload
                $blk_sz := usize((*blk).size)
                if blk_sz >= front_gap && (blk_sz - front_gap) >= req {
                    if front_gap > usize(0) {
                        mid := cur + front_gap
                        mid_sz := blk_sz - front_gap
                        old_next := (*blk).next
                        mid_blk := mid as *raw HeapNode
                        *mid_blk = HeapNode{
                            magic: HEAP_MAGIC,
                            size: u64(mid_sz),
                            is_free: u64(1),
                            prev: u64(cur),
                            next: old_next,
                            pad: u64(0)
                        }
                        if old_next != u64(0) {
                            nxt_blk := usize(old_next) as *raw HeapNode
                            (*nxt_blk).prev = u64(mid)
                        }
                        (*blk).size = u64(front_gap - usize(HEAP_HDR_SIZE))
                        (*blk).next = u64(mid)
                        a.block_count += usize(1)
                        a.bytes_free -= usize(HEAP_HDR_SIZE)
                        cur = mid
                        blk = mid_blk
                        blk_sz = mid_sz
                    }

                    rem := blk_sz - req
                    if rem >= usize(HEAP_HDR_SIZE + HEAP_MIN_PAYLOAD) {
                        tail := cur + usize(HEAP_HDR_SIZE) + req
                        tail_sz := rem - usize(HEAP_HDR_SIZE)
                        old_next2 := (*blk).next
                        tail_blk := tail as *raw HeapNode
                        *tail_blk = HeapNode{
                            magic: HEAP_MAGIC,
                            size: u64(tail_sz),
                            is_free: u64(1),
                            prev: u64(cur),
                            next: old_next2,
                            pad: u64(0)
                        }
                        if old_next2 != u64(0) {
                            nxt_blk2 := usize(old_next2) as *raw HeapNode
                            (*nxt_blk2).prev = u64(tail)
                        }
                        (*blk).size = u64(req)
                        (*blk).next = u64(tail)
                        a.block_count += usize(1)
                        a.bytes_free -= usize(HEAP_HDR_SIZE)
                    }

                    final_sz := usize((*blk).size)
                    (*blk).is_free = u64(0)
                    a.alloc_count += usize(1)
                    a.bytes_used += final_sz
                    a.bytes_free -= final_sz
                    << (cur + usize(HEAP_HDR_SIZE)) as *raw u8
                }
            }
            cur = usize((*blk).next)
        }
    }
    << 0 as *raw u8
}

pub fn (a $&LinkedListAllocator) alloc_zeroed(size usize, align usize) *raw u8 {
    ptr := a.alloc_raw(size, align)
    if ptr != 0 as *raw u8 {
        mem.memset(ptr, u8(0), int(size))
    }
    << ptr
}

pub fn (a $&LinkedListAllocator) dealloc_raw(ptr *raw u8) bool {
    if ptr == 0 as *raw u8 {
        << false
    }
    addr := ptr as usize
    if addr < a.base + usize(HEAP_HDR_SIZE) || addr >= a.end {
        << false
    }
    $cur := addr - usize(HEAP_HDR_SIZE)
    unsafe {
        $blk := cur as *raw HeapNode
        if (*blk).magic != HEAP_MAGIC || (*blk).is_free != u64(0) {
            << false
        }
        (*blk).is_free = u64(1)
        sz := usize((*blk).size)
        a.free_count += usize(1)
        a.bytes_used -= sz
        a.bytes_free += sz

        // Coalesce forward with next block if free.
        nxt_addr := usize((*blk).next)
        if nxt_addr != usize(0) {
            nxt := nxt_addr as *raw HeapNode
            if (*nxt).magic == HEAP_MAGIC && (*nxt).is_free == u64(1) {
                (*blk).size += u64(HEAP_HDR_SIZE) + (*nxt).size
                after := (*nxt).next
                (*blk).next = after
                if after != u64(0) {
                    after_blk := usize(after) as *raw HeapNode
                    (*after_blk).prev = u64(cur)
                }
                (*nxt).magic = u64(0)
                a.block_count -= usize(1)
                a.bytes_free += usize(HEAP_HDR_SIZE)
            }
        }

        // Coalesce backward with prev block if free.
        prv_addr := usize((*blk).prev)
        if prv_addr != usize(0) {
            prv := prv_addr as *raw HeapNode
            if (*prv).magic == HEAP_MAGIC && (*prv).is_free == u64(1) {
                (*prv).size += u64(HEAP_HDR_SIZE) + (*blk).size
                after := (*blk).next
                (*prv).next = after
                if after != u64(0) {
                    after_blk := usize(after) as *raw HeapNode
                    (*after_blk).prev = u64(prv_addr)
                }
                (*blk).magic = u64(0)
                a.block_count -= usize(1)
                a.bytes_free += usize(HEAP_HDR_SIZE)
            }
        }
    }
    << true
}

pub fn (a $&LinkedListAllocator) alloc(layout Layout) *raw u8 {
    if !layout.is_valid() || layout.size == 0 {
        << 0 as *raw u8
    }
    << a.alloc_raw(usize(layout.size), usize(layout.align))
}

pub fn (a $&LinkedListAllocator) dealloc(ptr *raw u8, layout Layout) {
    ok := a.dealloc_raw(ptr)
    if !ok && layout.size < 0 {
        <<
    }
}

pub fn (a &LinkedListAllocator) used() usize {
    << a.bytes_used
}

pub fn (a &LinkedListAllocator) free_bytes() usize {
    << a.bytes_free
}

pub fn (a &LinkedListAllocator) blocks() usize {
    << a.block_count
}

pub fn (a &LinkedListAllocator) allocs() usize {
    << a.alloc_count
}

pub fn (a &LinkedListAllocator) frees() usize {
    << a.free_count
}
