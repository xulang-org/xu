@core/task

// Kernel multi-tasking, context switching, and execution control for baremetal kernels.

#core/arch

pub const TASK_UNUSED = 0
pub const TASK_READY = 1
pub const TASK_RUNNING = 2
pub const TASK_BLOCKED = 3
pub const TASK_DEAD = 4

// TaskContext: Architecture-independent 192-byte callee-saved register record.
// Standard layout across x86_64, AArch64, RISC-V 64:
// - offsets 0..72: General callee-saved registers (rbx/r12-r15; x19-x28; s1-s9,s11)
// - offset 80: Frame Pointer (rbp / x29 / s0)
// - offset 88: Instruction Pointer / Return Address (rip / x30 / ra)
// - offset 96: Stack Pointer (rsp / sp / sp)
// - offsets 104..184: Callee-saved vector/floating-point registers and padding
@repr("C", align: 16)
pub struct TaskContext {
    pub regs0 u64
    pub regs1 u64
    pub regs2 u64
    pub regs3 u64
    pub regs4 u64
    pub regs5 u64
    pub regs6 u64
    pub regs7 u64
    pub regs8 u64
    pub regs9 u64
    pub fp u64    // offset 80
    pub pc u64    // offset 88
    pub sp u64    // offset 96
    pub pad0 u64  // offset 104
    pub pad1 u64  // offset 112
    pub pad2 u64  // offset 120
    pub pad3 u64  // offset 128
    pub pad4 u64  // offset 136
    pub pad5 u64  // offset 144
    pub pad6 u64  // offset 152
    pub pad7 u64  // offset 160
    pub pad8 u64  // offset 168
    pub pad9 u64  // offset 176
    pub pad10 u64 // offset 184
}

pub fn task_context_new() TaskContext {
    << TaskContext{
        regs0: 0, regs1: 0, regs2: 0, regs3: 0,
        regs4: 0, regs5: 0, regs6: 0, regs7: 0,
        regs8: 0, regs9: 0, fp: 0, pc: 0, sp: 0,
        pad0: 0, pad1: 0, pad2: 0, pad3: 0,
        pad4: 0, pad5: 0, pad6: 0, pad7: 0,
        pad8: 0, pad9: 0, pad10: 0
    }
}

pub fn (ctx $&TaskContext) init(entry u64, stack_top u64) {
    // `~` is Xu's clone operator, not bitwise NOT: clear the low four bits
    // explicitly so the stack stays 16-byte aligned.
    aligned := stack_top - (stack_top & u64(15))
    ctx.sp = aligned - 16
    ctx.pc = entry
    ctx.fp = 0
}

// Low-level assembly context switch emitted directly into the freestanding binary
pub extern "C" fn switch_context(prev *raw TaskContext, next *raw TaskContext)

// Safe ergonomic context switch wrapper between two task contexts.
pub fn task_switch(prev $&TaskContext, next &TaskContext) {
    unsafe {
        p := (&*prev) as *raw TaskContext
        n := (&next) as *raw TaskContext
        switch_context(p, n)
    }
}

// TrapFrame: Complete processor register snapshot pushed upon interrupt/exception.
// Follows System V x86_64, AAPCS64, and RISC-V 64 interrupt frame conventions.
@repr("C", align: 16)
pub struct TrapFrame {
    // Saved General Purpose Registers (GPRs)
    pub r15 u64
    pub r14 u64
    pub r13 u64
    pub r12 u64
    pub r11 u64
    pub r10 u64
    pub r9 u64
    pub r8 u64
    pub rbp u64
    pub rdi u64
    pub rsi u64
    pub rdx u64
    pub rcx u64
    pub rbx u64
    pub rax u64

    // Interrupt / Exception vector and error code
    pub vec u64
    pub error_code u64

    // Hardware-pushed stack frame
    pub rip u64
    pub cs u64
    pub rflags u64
    pub rsp u64
    pub ss u64
}

pub fn trap_frame_new() TrapFrame {
    << TrapFrame{
        r15: 0, r14: 0, r13: 0, r12: 0,
        r11: 0, r10: 0, r9: 0, r8: 0,
        rbp: 0, rdi: 0, rsi: 0, rdx: 0,
        rcx: 0, rbx: 0, rax: 0,
        vec: 0, error_code: 0,
        rip: 0, cs: 0, rflags: 0, rsp: 0, ss: 0
    }
}
