@repr("C")
pub struct AtomicPtr {
    addr u64
}

pub fn atomic_ptr_new(p *raw u8) AtomicPtr {
    << AtomicPtr{addr: p as u64}
}

pub fn (a &AtomicPtr) load() *raw u8 {
    unsafe {
        p := (&a.addr) as *raw u64
        << arch.atomic_load_u64(p) as *raw u8
    }
}

pub fn (a $&AtomicPtr) store(ptr *raw u8) {
    unsafe {
        p := (&a.addr) as *raw u64
        arch.atomic_store_u64(p, ptr as u64)
    }
}

pub fn (a $&AtomicPtr) swap(ptr *raw u8) *raw u8 {
    unsafe {
        p := (&a.addr) as *raw u64
        << arch.atomic_xchg_u64(p, ptr as u64) as *raw u8
    }
}

pub fn (a $&AtomicPtr) compare_exchange(expected *raw u8, desired *raw u8) *raw u8 {
    unsafe {
        p := (&a.addr) as *raw u64
        << arch.atomic_cas_u64(p, expected as u64, desired as u64) as *raw u8
    }
}

// ===== Kernel Reader-Writer Lock, SeqLock, and Once =====

const RW_WRITER_BIT = 0x80000000

@repr("C")
pub struct RwSpinlock {
    state u32
}

pub fn rw_spinlock_new() RwSpinlock {
    << RwSpinlock{state: u32(0)}
}

pub fn (rw $&RwSpinlock) read_lock() {
    unsafe {
        p := (&rw.state) as *raw u32
        while true {
            cur := arch.atomic_load_u32(p)
            if (cur & u32(RW_WRITER_BIT)) == u32(0) {
                if arch.atomic_cas_u32(p, cur, cur + u32(1)) == cur {
                    <-
                }
            } else {
                arch.pause()
            }
        }
    }
}

pub fn (rw $&RwSpinlock) read_unlock() {
    unsafe {
        p := (&rw.state) as *raw u32
        arch.atomic_fetch_add_u32(p, u32(0) - u32(1))
    }
}

pub fn (rw $&RwSpinlock) write_lock() {
    unsafe {
        p := (&rw.state) as *raw u32
        while true {
            if arch.atomic_cas_u32(p, u32(0), u32(RW_WRITER_BIT)) == u32(0) {
                <-
            }
            while arch.atomic_load_u32(p) != u32(0) {
                arch.pause()
            }
        }
    }
}

pub fn (rw $&RwSpinlock) write_unlock() {
    unsafe {
        p := (&rw.state) as *raw u32
        arch.atomic_store_u32(p, u32(0))
    }
}

pub struct RwReadGuard {
    pub lock *raw RwSpinlock
}

pub fn (g $&RwReadGuard) drop() {
    if g.lock != 0 as *raw RwSpinlock {
        unsafe { (*g.lock).read_unlock() }
        g.lock = 0 as *raw RwSpinlock
    }
}

pub fn (rw $&RwSpinlock) read() RwReadGuard {
    rw.read_lock()
    << RwReadGuard{lock: (&*rw) as *raw RwSpinlock}
}

pub struct RwWriteGuard {
    pub lock *raw RwSpinlock
}

pub fn (g $&RwWriteGuard) drop() {
    if g.lock != 0 as *raw RwSpinlock {
        unsafe { (*g.lock).write_unlock() }
        g.lock = 0 as *raw RwSpinlock
    }
}

pub fn (rw $&RwSpinlock) write() RwWriteGuard {
    rw.write_lock()
    << RwWriteGuard{lock: (&*rw) as *raw RwSpinlock}
}

@repr("C")
pub struct SeqLock {
    seq u32
    lock Spinlock
}

pub fn seqlock_new() SeqLock {
    << SeqLock{seq: u32(0), lock: spinlock_new()}
}

pub fn (sl $&SeqLock) write_begin() {
    unsafe {
        lp := (&sl.lock) as *raw Spinlock
        (*lp).lock()
        p := (&sl.seq) as *raw u32
        arch.atomic_fetch_add_u32(p, u32(1))
    }
    arch.fence()
}

pub fn (sl $&SeqLock) write_end() {
    arch.fence()
    unsafe {
        p := (&sl.seq) as *raw u32
        arch.atomic_fetch_add_u32(p, u32(1))
        lp := (&sl.lock) as *raw Spinlock
        (*lp).unlock()
    }
}

pub fn (sl &SeqLock) read_begin() u32 {
    unsafe {
        p := (&sl.seq) as *raw u32
        while true {
            s0 := arch.atomic_load_u32(p)
            if (s0 & u32(1)) == u32(0) {
                arch.fence()
                << s0
            }
            arch.pause()
        }
    }
    << u32(0)
}

pub fn (sl &SeqLock) read_retry(start u32) bool {
    arch.fence()
    unsafe {
        p := (&sl.seq) as *raw u32
        << arch.atomic_load_u32(p) != start
    }
}

@repr("C")
pub struct Once {
    state u32
}

pub fn once_new() Once {
    << Once{state: u32(0)}
}

pub fn (o &Once) is_completed() bool {
    unsafe {
        p := (&o.state) as *raw u32
        << arch.atomic_load_u32(p) == u32(2)
    }
}

pub fn (o $&Once) try_begin() bool {
    unsafe {
        p := (&o.state) as *raw u32
        prev := arch.atomic_cas_u32(p, u32(0), u32(1))
        if prev == u32(0) {
            << true
        }
        while arch.atomic_load_u32(p) == u32(1) {
            arch.pause()
        }
    }
    << false
}

pub fn (o $&Once) finish() {
    unsafe {
        p := (&o.state) as *raw u32
        arch.atomic_store_u32(p, u32(2))
    }
}
