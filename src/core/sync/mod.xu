@core/sync

// Interrupt-safe spinlock and deterministic RAII synchronization for baremetal kernels.

#core/arch

// C layout so kernels can embed locks in @repr("C") state blocks.
@repr("C")
pub struct Spinlock {
    locked u32
}

pub fn spinlock_new() Spinlock {
    << Spinlock{locked: 0}
}

pub fn (s $&Spinlock) try_lock() bool {
    unsafe {
        p := (&s.locked) as *raw u32
        << arch.atomic_xchg_u32(p, u32(1)) == u32(0)
    }
}

pub fn (s $&Spinlock) lock() {
    unsafe {
        p := (&s.locked) as *raw u32
        while true {
            if arch.atomic_xchg_u32(p, u32(1)) == u32(0) {
                <-
            }
            while arch.atomic_load_u32(p) != u32(0) {
                arch.pause()
            }
        }
    }
}

pub fn (s $&Spinlock) unlock() {
    unsafe {
        p := (&s.locked) as *raw u32
        arch.atomic_store_u32(p, u32(0))
    }
}

pub struct SpinGuard {
    pub lock *raw Spinlock
}

pub fn (g $&SpinGuard) drop() {
    if g.lock != 0 as *raw Spinlock {
        unsafe {
            p_locked := (&(*g.lock).locked) as *raw u32
            arch.atomic_store_u32(p_locked, u32(0))
        }
        g.lock = 0 as *raw Spinlock
    }
}

pub fn (s $&Spinlock) acquire() SpinGuard {
    s.lock()
    << SpinGuard{lock: (&*s) as *raw Spinlock}
}

// IrqSpinlock disables local CPU interrupts before spinning, preventing
// deadlock if an interrupt handler attempts to acquire the same lock.
// The interrupt state of the outermost acquisition is saved and restored on
// release (spin_lock_irqsave semantics): taking the lock while interrupts
// are already disabled (early boot, inside a handler) never enables them.
@repr("C")
pub struct IrqSpinlock {
    pub lock Spinlock
    pub depth u32
    pub saved u64
}

pub fn irq_spinlock_new() IrqSpinlock {
    << IrqSpinlock{lock: spinlock_new(), depth: 0, saved: 0}
}

pub fn (s $&IrqSpinlock) lock() {
    $flags := u64(0)
    unsafe {
        flags = arch.irq_save()
        p := (&s.lock.locked) as *raw u32
        while true {
            if arch.atomic_xchg_u32(p, u32(1)) == u32(0) {
                <-
            }
            while arch.atomic_load_u32(p) != u32(0) {
                arch.cpu_relax()
            }
        }
    }
    if s.depth == 0 {
        s.saved = flags
    }
    s.depth += 1
}

pub fn (s $&IrqSpinlock) unlock() {
    $restore := false
    $saved := u64(0)
    if s.depth > 0 {
        s.depth -= 1
        if s.depth == 0 {
            saved = s.saved
            restore = true
        }
    }
    unsafe {
        p := (&s.lock.locked) as *raw u32
        arch.atomic_store_u32(p, u32(0))
        if restore {
            arch.irq_restore(saved)
        }
    }
}

pub struct IrqGuard {
    pub lock *raw IrqSpinlock
}

pub fn (g $&IrqGuard) drop() {
    if g.lock != 0 as *raw IrqSpinlock {
        unsafe {
            $restore := false
            $saved := u64(0)
            p_depth := (&(*g.lock).depth) as *raw u32
            d := volatile_read(p_depth)
            if d > 0 {
                volatile_write(p_depth, d - 1)
                if d == 1 {
                    p_saved := (&(*g.lock).saved) as *raw u64
                    saved = volatile_read(p_saved)
                    restore = true
                }
            }
            p_locked := (&(*g.lock).lock.locked) as *raw u32
            arch.atomic_store_u32(p_locked, u32(0))
            if restore {
                arch.irq_restore(saved)
            }
        }
        g.lock = 0 as *raw IrqSpinlock
    }
}

pub fn (s $&IrqSpinlock) acquire() IrqGuard {
    s.lock()
    << IrqGuard{lock: (&*s) as *raw IrqSpinlock}
}

// ===== Strongly-Typed Hardware Atomics (@repr("C")) =====

@repr("C")
pub struct AtomicBool {
    val u32
}

pub fn atomic_bool_new(v bool) AtomicBool {
    $init := u32(0)
    if v { init = u32(1) }
    << AtomicBool{val: init}
}

pub fn (a &AtomicBool) load() bool {
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_load_u32(p) != u32(0)
    }
}

pub fn (a $&AtomicBool) store(v bool) {
    $raw := u32(0)
    if v { raw = u32(1) }
    unsafe {
        p := (&a.val) as *raw u32
        arch.atomic_store_u32(p, raw)
    }
}

pub fn (a $&AtomicBool) swap(v bool) bool {
    $raw := u32(0)
    if v { raw = u32(1) }
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_xchg_u32(p, raw) != u32(0)
    }
}

pub fn (a $&AtomicBool) compare_exchange(expected bool, desired bool) bool {
    $exp := u32(0)
    $des := u32(0)
    if expected { exp = u32(1) }
    if desired { des = u32(1) }
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_cas_u32(p, exp, des) == exp
    }
}

@repr("C")
pub struct AtomicU32 {
    val u32
}

pub fn atomic_u32_new(v u32) AtomicU32 {
    << AtomicU32{val: v}
}

pub fn (a &AtomicU32) load() u32 {
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_load_u32(p)
    }
}

pub fn (a $&AtomicU32) store(v u32) {
    unsafe {
        p := (&a.val) as *raw u32
        arch.atomic_store_u32(p, v)
    }
}

pub fn (a $&AtomicU32) swap(v u32) u32 {
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_xchg_u32(p, v)
    }
}

pub fn (a $&AtomicU32) compare_exchange(expected u32, desired u32) u32 {
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_cas_u32(p, expected, desired)
    }
}

pub fn (a $&AtomicU32) fetch_add(delta u32) u32 {
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_fetch_add_u32(p, delta)
    }
}

pub fn (a $&AtomicU32) fetch_sub(delta u32) u32 {
    unsafe {
        p := (&a.val) as *raw u32
        << arch.atomic_fetch_add_u32(p, u32(0) - delta)
    }
}

@repr("C")
pub struct AtomicU64 {
