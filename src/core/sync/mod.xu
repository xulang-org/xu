@core/sync

// Interrupt-safe spinlock and deterministic RAII synchronization for baremetal kernels.

#core/arch

pub struct Spinlock {
    locked u32
}

pub fn spinlock_new() Spinlock {
    << Spinlock{locked: 0}
}

pub fn (s $&Spinlock) try_lock() bool {
    unsafe {
        p := (&s.locked) as *raw u32
        old := volatile_read(p)
        if old == 0 {
            volatile_write(p, 1)
            << true
        }
    }
    << false
}

pub fn (s $&Spinlock) lock() {
    while true {
        if s.try_lock() {
            <-
        }
        arch.pause()
    }
}

pub fn (s $&Spinlock) unlock() {
    unsafe {
        p := (&s.locked) as *raw u32
        volatile_write(p, 0)
    }
}

pub struct SpinGuard {
    pub lock *raw Spinlock
}

pub fn (g $&SpinGuard) drop() {
    if g.lock != 0 as *raw Spinlock {
        unsafe {
            p_locked := (&(*g.lock).locked) as *raw u32
            volatile_write(p_locked, 0)
        }
        g.lock = 0 as *raw Spinlock
    }
}

pub fn (s $&Spinlock) acquire() SpinGuard {
    s.lock()
    << SpinGuard{lock: (&*s) as *raw Spinlock}
}

// IrqSpinlock disables local CPU interrupts before spinning, preventing
// deadlock if an interrupt handler attempts to acquire the same lock.
pub struct IrqSpinlock {
    pub lock Spinlock
    pub depth u32
}

pub fn irq_spinlock_new() IrqSpinlock {
    << IrqSpinlock{lock: spinlock_new(), depth: 0}
}

pub fn (s $&IrqSpinlock) lock() {
    arch.cli()
    s.depth += 1
    unsafe {
        p := (&s.lock.locked) as *raw u32
        while volatile_read(p) != 0 {
            arch.cpu_relax()
        }
        volatile_write(p, 1)
    }
}

pub fn (s $&IrqSpinlock) unlock() {
    unsafe {
        p := (&s.lock.locked) as *raw u32
        volatile_write(p, 0)
    }
    if s.depth > 0 {
        s.depth -= 1
        if s.depth == 0 {
            arch.sti()
        }
    }
}

pub struct IrqGuard {
    pub lock *raw IrqSpinlock
}

pub fn (g $&IrqGuard) drop() {
    if g.lock != 0 as *raw IrqSpinlock {
        unsafe {
            p_locked := (&(*g.lock).lock.locked) as *raw u32
            volatile_write(p_locked, 0)
            p_depth := (&(*g.lock).depth) as *raw u32
            d := volatile_read(p_depth)
            if d > 0 {
                volatile_write(p_depth, d - 1)
                if d == 1 {
                    arch.sti()
                }
            }
        }
        g.lock = 0 as *raw IrqSpinlock
    }
}

pub fn (s $&IrqSpinlock) acquire() IrqGuard {
    s.lock()
    << IrqGuard{lock: (&*s) as *raw IrqSpinlock}
}
