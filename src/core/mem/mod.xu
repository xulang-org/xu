@core/mem

// Pure, zero-allocation memory primitives for freestanding environments.

pub fn memcpy(dst *raw u8, src *raw u8, n int) *raw u8 {
    $i := 0
    d_addr := dst as int
    s_addr := src as int
    while i < n {
        unsafe {
            dp := (d_addr + i) as *raw u8
            sp := (s_addr + i) as *raw u8
            *dp = *sp
        }
        i += 1
    }
    << dst
}

pub fn memset(dst *raw u8, val u8, n int) *raw u8 {
    $i := 0
    d_addr := dst as int
    while i < n {
        unsafe {
            dp := (d_addr + i) as *raw u8
            *dp = val
        }
        i += 1
    }
    << dst
}

pub fn memcmp(s1 *raw u8, s2 *raw u8, n int) int {
    $i := 0
    a1 := s1 as int
    a2 := s2 as int
    while i < n {
        unsafe {
            p1 := (a1 + i) as *raw u8
            p2 := (a2 + i) as *raw u8
            b1 := int(*p1)
            b2 := int(*p2)
            if b1 != b2 {
                << b1 - b2
            }
        }
        i += 1
    }
    << 0
}
