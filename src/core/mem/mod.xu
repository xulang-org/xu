@core/mem

// Pure, zero-allocation memory primitives for freestanding environments.

pub fn memcpy(dst *raw u8, src *raw u8, n int) *raw u8 {
    $i := 0
    d_addr := dst as int
    s_addr := src as int
    if n >= 8 && (d_addr & 7) == 0 && (s_addr & 7) == 0 {
        while i + 8 <= n {
            unsafe {
                dp := (d_addr + i) as *raw u64
                sp := (s_addr + i) as *raw u64
                *dp = *sp
            }
            i += 8
        }
    }
    while i < n {
        unsafe {
            dp := (d_addr + i) as *raw u8
            sp := (s_addr + i) as *raw u8
            *dp = *sp
        }
        i += 1
    }
    << dst
}

pub fn memmove(dst *raw u8, src *raw u8, n int) *raw u8 {
    d_addr := dst as int
    s_addr := src as int
    if d_addr == s_addr || n <= 0 {
        << dst
    }
    if d_addr > s_addr && d_addr < s_addr + n {
        $i := n
        while i > 0 {
            i -= 1
            unsafe {
                dp := (d_addr + i) as *raw u8
                sp := (s_addr + i) as *raw u8
                *dp = *sp
            }
        }
        << dst
    }
    << memcpy(dst, src, n)
}

pub fn memset(dst *raw u8, val u8, n int) *raw u8 {
    $i := 0
    d_addr := dst as int
    if n >= 8 && (d_addr & 7) == 0 {
        w8 := u64(val) & u64(0xFF)
        w16 := w8 | (w8 << u64(8))
        w32 := w16 | (w16 << u64(16))
        word := w32 | (w32 << u64(32))
        while i + 8 <= n {
            unsafe {
                dp := (d_addr + i) as *raw u64
                *dp = word
            }
            i += 8
        }
    }
    while i < n {
        unsafe {
            dp := (d_addr + i) as *raw u8
            *dp = val
        }
        i += 1
    }
    << dst
}

pub fn bitnot_u8(v u8) u8 {
    << v ^ u8(0xFF)
}

pub fn bitnot_u16(v u16) u16 {
    << v ^ u16(0xFFFF)
}

pub fn bitnot_u32(v u32) u32 {
    << v ^ u32(0xFFFFFFFF)
}

pub fn bitnot_u64(v u64) u64 {
    << v ^ (u64(0) - u64(1))
}

pub fn memcmp(s1 *raw u8, s2 *raw u8, n int) int {
    $i := 0
    a1 := s1 as int
    a2 := s2 as int
    while i < n {
        unsafe {
            p1 := (a1 + i) as *raw u8
            p2 := (a2 + i) as *raw u8
            b1 := int(*p1)
            b2 := int(*p2)
            if b1 != b2 {
                << b1 - b2
            }
        }
        i += 1
    }
    << 0
}
