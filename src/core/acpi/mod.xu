@core/acpi
$freestanding

#core/mem

@repr("C", packed)
pub struct RsdpV1 {
    pub signature [8]u8
    pub checksum u8
    pub oem_id [6]u8
    pub revision u8
    pub rsdt_addr u32
}

@repr("C", packed)
pub struct RsdpV2 {
    pub v1 RsdpV1
    pub length u32
    pub xsdt_addr u64
    pub ext_checksum u8
    pub reserved [3]u8
}

@repr("C", packed)
pub struct SdtHeader {
    pub signature [4]u8
    pub length u32
    pub revision u8
    pub checksum u8
    pub oem_id [6]u8
    pub oem_table_id [8]u8
    pub oem_revision u32
    pub creator_id u32
    pub creator_revision u32
}

@repr("C", packed)
pub struct MadtHeader {
    pub hdr SdtHeader
    pub lapic_addr u32
    pub flags u32
}

@repr("C")
pub struct MadtIso {
    pub bus u8
    pub irq u8
    pub gsi u32
    pub flags u16
}

@repr("C")
pub struct MadtInfo {
    pub lapic_addr u64
    pub ioapic_addr u64
    pub ioapic_id u8
    pub ioapic_gsi_base u32
    pub lapic_count int
    pub lapic_ids [32]u8
    pub iso_count int
    pub isos [16]MadtIso
}

@repr("C")
pub struct FadtInfo {
    pub sci_int u16
    pub smi_cmd u32
    pub pm1a_evt_blk u32
    pub pm1a_cnt_blk u32
    pub pm_tmr_blk u32
    pub flags u32
    pub reset_reg_addr u64
    pub reset_value u8
}

@repr("C")
pub struct McfgEntry {
    pub base_addr u64
    pub seg_group u16
    pub start_bus u8
    pub end_bus u8
}

@repr("C")
pub struct McfgInfo {
    pub count int
    pub entries [8]McfgEntry
}

pub struct HpetInfo {
    pub base_addr u64
    pub min_tick u16
    pub comparator_count u8
    pub counter_64bit bool
    pub vendor_id u16
}

pub fn acpi_checksum_ok(ptr *raw u8, len int) bool {
    if len <= 0 {
        << false
    }
    $sum := u32(0)
    unsafe {
        if (ptr as u64) == u64(0) {
            << false
        }
        base := ptr as u64
        $i := 0
        while i < len {
            b := *((base + u64(i)) as *raw u8)
            sum = (sum + u32(b)) & u32(0xFF)
            i += 1
        }
    }
    << sum == u32(0)
}

fn match_rsdp_sig(ptr u64) bool {
    unsafe {
        if *((ptr + u64(0)) as *raw u8) != u8(82) { << false }
        if *((ptr + u64(1)) as *raw u8) != u8(83) { << false }
        if *((ptr + u64(2)) as *raw u8) != u8(68) { << false }
        if *((ptr + u64(3)) as *raw u8) != u8(32) { << false }
        if *((ptr + u64(4)) as *raw u8) != u8(80) { << false }
        if *((ptr + u64(5)) as *raw u8) != u8(84) { << false }
        if *((ptr + u64(6)) as *raw u8) != u8(82) { << false }
        if *((ptr + u64(7)) as *raw u8) != u8(32) { << false }
    }
    << true
}

fn check_rsdp_at(addr u64) bool {
    if !match_rsdp_sig(addr) {
        << false
    }
    p := addr as *raw u8
    if !acpi_checksum_ok(p, 20) {
        << false
    }
    unsafe {
        r1 := addr as *raw RsdpV1
        if (*r1).revision >= u8(2) {
            r2 := addr as *raw RsdpV2
            ext_len := int((*r2).length)
            if ext_len < 36 || ext_len > 256 || !acpi_checksum_ok(p, ext_len) {
                << false
            }
        }
    }
    << true
}

pub fn find_rsdp() u64 {
    unsafe {
        ebda_seg := *(u64(0x40E) as *raw u16)
        ebda_base := u64(ebda_seg) << u64(4)
        if ebda_base >= u64(0x80000) && ebda_base < u64(0xA0000) {
            $off := u64(0)
            while off < u64(1024) {
                if check_rsdp_at(ebda_base + off) {
                    << ebda_base + off
                }
                off += u64(16)
            }
        }
        $addr := u64(0x000E0000)
        while addr < u64(0x00100000) {
            if check_rsdp_at(addr) {
                << addr
            }
            addr += u64(16)
        }
    }
    << u64(0)
}

pub fn find_table(rsdp_addr u64, sig0 u8, sig1 u8, sig2 u8, sig3 u8) u64 {
    if rsdp_addr == u64(0) {
        << u64(0)
    }
    unsafe {
        r1 := rsdp_addr as *raw RsdpV1
        if (*r1).revision >= u8(2) {
            r2 := rsdp_addr as *raw RsdpV2
            if (*r2).xsdt_addr != u64(0) {
                xsdt_hdr := (*r2).xsdt_addr as *raw SdtHeader
                xsdt_len := int((*xsdt_hdr).length)
                if xsdt_len >= 36 && acpi_checksum_ok(xsdt_hdr as *raw u8, xsdt_len) {
                    entries := (xsdt_len - 36) / 8
                    base := (*r2).xsdt_addr + u64(36)
                    $i := 0
                    while i < entries {
                        tbl_addr := *((base + u64(i * 8)) as *raw u64)
                        if tbl_addr != u64(0) {
                            hdr := tbl_addr as *raw SdtHeader
                            if (*hdr).signature[0] == sig0 &&
                               (*hdr).signature[1] == sig1 &&
                               (*hdr).signature[2] == sig2 &&
                               (*hdr).signature[3] == sig3 &&
                               int((*hdr).length) >= 36 &&
                               acpi_checksum_ok(hdr as *raw u8, int((*hdr).length)) {
                                << tbl_addr
                            }
                        }
                        i += 1
                    }
                }
            }
        }
        rsdt_addr := u64((*r1).rsdt_addr)
        if rsdt_addr != u64(0) {
            rsdt_hdr := rsdt_addr as *raw SdtHeader
            rsdt_len := int((*rsdt_hdr).length)
            if rsdt_len >= 36 && acpi_checksum_ok(rsdt_hdr as *raw u8, rsdt_len) {
                entries := (rsdt_len - 36) / 4
                base := rsdt_addr + u64(36)
                $i := 0
                while i < entries {
                    tbl_addr := u64(*((base + u64(i * 4)) as *raw u32))
                    if tbl_addr != u64(0) {
                        hdr := tbl_addr as *raw SdtHeader
                        if (*hdr).signature[0] == sig0 &&
                           (*hdr).signature[1] == sig1 &&
                           (*hdr).signature[2] == sig2 &&
                           (*hdr).signature[3] == sig3 &&
                           int((*hdr).length) >= 36 &&
                           acpi_checksum_ok(hdr as *raw u8, int((*hdr).length)) {
                            << tbl_addr
                        }
                    }
                    i += 1
                }
            }
        }
    }
    << u64(0)
}

pub fn parse_madt(madt_addr u64, out *raw MadtInfo) bool {
    if madt_addr == u64(0) {
        << false
    }
    unsafe {
        if (out as u64) == u64(0) {
            << false
        }
        madt := madt_addr as *raw MadtHeader
        total_len := int((*madt).hdr.length)
        if total_len < 44 || !acpi_checksum_ok(madt as *raw u8, total_len) {
            << false
        }
        $info := MadtInfo{
            lapic_addr: u64((*madt).lapic_addr),
            ioapic_addr: u64(0),
            ioapic_id: u8(0),
            ioapic_gsi_base: u32(0),
            lapic_count: 0,
            lapic_ids: [32]u8{},
            iso_count: 0,
            isos: [16]MadtIso{}
        }

        $off := 44
        base := madt_addr
        while off + 2 <= total_len {
            etype := *((base + u64(off)) as *raw u8)
            elen := int(*((base + u64(off + 1)) as *raw u8))
            if elen < 2 || off + elen > total_len {
                <-
            }
            ep := base + u64(off)
            if etype == u8(0) && elen >= 8 {
                // Processor Local APIC: acpi_id[2], apic_id[3], flags[4..7]
                apic_id := *((ep + u64(3)) as *raw u8)
                flags := *((ep + u64(4)) as *raw u32)
                if (flags & u32(3)) != u32(0) && info.lapic_count < 32 {
                    info.lapic_ids[info.lapic_count] = apic_id
                    info.lapic_count += 1
                }
            } else if etype == u8(1) && elen >= 12 {
                // I/O APIC: id[2], addr[4..7], gsi_base[8..11]
                if info.ioapic_addr == u64(0) {
                    info.ioapic_id = *((ep + u64(2)) as *raw u8)
                    info.ioapic_addr = u64(*((ep + u64(4)) as *raw u32))
                    info.ioapic_gsi_base = *((ep + u64(8)) as *raw u32)
                }
            } else if etype == u8(2) && elen >= 10 {
                // Interrupt Source Override: bus[2], irq[3], gsi[4..7], flags[8..9]
                if info.iso_count < 16 {
                    info.isos[info.iso_count] = MadtIso{
                        bus: *((ep + u64(2)) as *raw u8),
                        irq: *((ep + u64(3)) as *raw u8),
                        gsi: *((ep + u64(4)) as *raw u32),
                        flags: *((ep + u64(8)) as *raw u16)
                    }
                    info.iso_count += 1
                }
            } else if etype == u8(5) && elen >= 12 {
                // Local APIC Address Override: 64-bit addr at [4..11]
                info.lapic_addr = *((ep + u64(4)) as *raw u64)
            }
            off += elen
        }
        *out = info
    }
    << true
}

pub fn find_madt(rsdp_addr u64) u64 {
    << find_table(rsdp_addr, u8(65), u8(80), u8(73), u8(67)) // "APIC"
}

pub fn find_fadt(rsdp_addr u64) u64 {
    << find_table(rsdp_addr, u8(70), u8(65), u8(67), u8(80)) // "FACP"
}

pub fn find_mcfg(rsdp_addr u64) u64 {
    << find_table(rsdp_addr, u8(77), u8(67), u8(70), u8(71)) // "MCFG"
}

pub fn find_hpet(rsdp_addr u64) u64 {
    << find_table(rsdp_addr, u8(72), u8(80), u8(69), u8(84)) // "HPET"
}

pub fn parse_fadt(fadt_addr u64, out *raw FadtInfo) bool {
    if fadt_addr == u64(0) {
        << false
    }
    unsafe {
        if (out as u64) == u64(0) {
            << false
        }
        hdr := fadt_addr as *raw SdtHeader
        total_len := int((*hdr).length)
        if total_len < 116 || !acpi_checksum_ok(hdr as *raw u8, total_len) {
            << false
        }
        $info := FadtInfo{
            sci_int: *((fadt_addr + u64(46)) as *raw u16),
            smi_cmd: *((fadt_addr + u64(48)) as *raw u32),
            pm1a_evt_blk: *((fadt_addr + u64(56)) as *raw u32),
            pm1a_cnt_blk: *((fadt_addr + u64(64)) as *raw u32),
            pm_tmr_blk: *((fadt_addr + u64(76)) as *raw u32),
            flags: *((fadt_addr + u64(112)) as *raw u32),
            reset_reg_addr: u64(0),
            reset_value: u8(0)
        }
        if total_len >= 129 {
            info.reset_reg_addr = *((fadt_addr + u64(120)) as *raw u64)
            info.reset_value = *((fadt_addr + u64(128)) as *raw u8)
        }
        *out = info
    }
    << true
}

pub fn parse_mcfg(mcfg_addr u64, out *raw McfgInfo) bool {
    if mcfg_addr == u64(0) {
        << false
    }
    unsafe {
        if (out as u64) == u64(0) {
            << false
        }
        hdr := mcfg_addr as *raw SdtHeader
        total_len := int((*hdr).length)
        if total_len < 44 || !acpi_checksum_ok(hdr as *raw u8, total_len) {
            << false
        }
        $info := McfgInfo{
            count: 0,
            entries: [8]McfgEntry{}
        }
        $off := 44
        while off + 16 <= total_len && info.count < 8 {
            ep := mcfg_addr + u64(off)
            info.entries[info.count] = McfgEntry{
                base_addr: *((ep + u64(0)) as *raw u64),
                seg_group: *((ep + u64(8)) as *raw u16),
                start_bus: *((ep + u64(10)) as *raw u8),
                end_bus: *((ep + u64(11)) as *raw u8)
            }
            info.count += 1
            off += 16
        }
        *out = info
    }
    << true
}

pub fn parse_hpet(hpet_addr u64, out *raw HpetInfo) bool {
    if hpet_addr == u64(0) {
        << false
    }
    unsafe {
        if (out as u64) == u64(0) {
            << false
        }
        hdr := hpet_addr as *raw SdtHeader
        total_len := int((*hdr).length)
        if total_len < 55 || !acpi_checksum_ok(hdr as *raw u8, total_len) {
            << false
        }
        blk_id := *((hpet_addr + u64(36)) as *raw u32)
        base_addr := *((hpet_addr + u64(44)) as *raw u64)
        min_tick := *((hpet_addr + u64(53)) as *raw u16)
        *out = HpetInfo{
            base_addr: base_addr,
            min_tick: min_tick,
            comparator_count: u8(((blk_id >> u32(8)) & u32(0x1F)) + u32(1)),
            counter_64bit: (blk_id & u32(0x2000)) != u32(0),
            vendor_id: u16((blk_id >> u32(16)) & u32(0xFFFF))
        }
    }
    << true
}
