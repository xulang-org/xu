@mime


#errors
#strings

// MIME type helpers aligned with Go `mime` (ParseMediaType +
// TypeByExtension builtins). No map type: parameters are parallel
// keys/vals slices. TypeByExtension uses Go's hardcoded table only
// (no /etc/mime.types, no Windows registry).

pub struct MediaType {
    pub typ string
    pub keys []string
    pub vals []string
}

fn is_token(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 {
        << true
    }
    if c == 42 || c == 43 || c == 45 || c == 46 {
        << true
    }
    if c == 94 || c == 95 || c == 96 || c == 124 || c == 126 {
        << true
    }
    << false
}

fn skip_ws(s &string, i int) int {
    mut p := i
    while p < s.len {
        c := s[p] & 255
        if c == 32 || c == 9 {
            p = p + 1
        } else {
            <-
        }
    }
    << p
}

pub fn parse_media_type(v &string) MediaType {
    src := strings.trim_space(v)
    mut i := 0
    start := i
    while i < src.len && is_token(src[i] & 255) {
        i = i + 1
    }
    if i == start || i >= src.len || (src[i] & 255) != 47 {
        >> errors.new("mime: expected type/subtype")
    }
    i = i + 1
    sub0 := i
    while i < src.len && is_token(src[i] & 255) {
        i = i + 1
    }
    if i == sub0 {
        >> errors.new("mime: expected type/subtype")
    }
    seg := src[start:i] + ""
    typ := strings.to_lower(&seg)
    i = skip_ws(&src, i)
    mut keys := []string{}
    mut vals := []string{}
    while i < src.len {
        if (src[i] & 255) != 59 {
            >> errors.new("mime: malformed media type")
        }
        i = i + 1
        i = skip_ws(&src, i)
        if i >= src.len {
            <-
        }
        k0 := i
        while i < src.len && is_token(src[i] & 255) {
            i = i + 1
        }
        if i == k0 {
            >> errors.new("mime: malformed parameter")
        }
        kseg := src[k0:i] + ""
        k := strings.to_lower(&kseg)
        i = skip_ws(&src, i)
        if i >= src.len || (src[i] & 255) != 61 {
            >> errors.new("mime: malformed parameter")
        }
        i = i + 1
        i = skip_ws(&src, i)
        mut val := ""
        if i < src.len && (src[i] & 255) == 34 {
            i = i + 1
            mut raw := []int{}
            mut closed := 0
            while i < src.len {
                c := src[i] & 255
                if c == 34 {
                    closed = 1
                    i = i + 1
                    <-
                }
                if c == 92 && i + 1 < src.len {
                    i = i + 1
                    raw.push(src[i] & 255)
                    i = i + 1
                } else {
                    raw.push(c)
                    i = i + 1
                }
            }
            if closed == 0 {
                >> errors.new("mime: malformed parameter")
            }
            val = string_from_bytes(raw)
        } else {
            v0 := i
            while i < src.len && is_token(src[i] & 255) {
                i = i + 1
            }
            if i == v0 {
                >> errors.new("mime: malformed parameter")
            }
            val = src[v0:i] + ""
        }
        keys.push(k)
        vals.push(val)
        i = skip_ws(&src, i)
    }
    << MediaType{typ: typ, keys: keys, vals: vals}
}

fn needs_param_quote(s &string) bool {
    if s.len == 0 {
        << true
    }
    mut i := 0
    while i < s.len {
        if !is_token(s[i] & 255) {
            << true
        }
        i = i + 1
    }
    << false
}

fn quote_param(s &string) string {
    mut out := "\""
    mut i := 0
    while i < s.len {
        c := s[i] & 255
        if c == 34 || c == 92 {
            out.push_byte(92)
        }
        out.push_byte(c)
        i = i + 1
    }
    out.push_byte(34)
    << out
}

pub fn format_media_type(mt &MediaType) string {
    typ := mt.typ + ""
    mut out := strings.to_lower(&typ)
    mut i := 0
    while i < mt.keys.len {
        kraw := mt.keys[i] + ""
        k := strings.to_lower(&kraw)
        v := mt.vals[i] + ""
        out = out + "; " + k + "="
        if needs_param_quote(&v) {
            out = out + quote_param(&v)
        } else {
            out = out + v
        }
        i = i + 1
    }
    << out
}

pub fn type_by_extension(ext &string) string {
    e := strings.to_lower(ext)
    if e == ".avif" {
        << "image/avif"
    }
    if e == ".css" {
        << "text/css; charset=utf-8"
    }
    if e == ".gif" {
        << "image/gif"
    }
    if e == ".htm" {
        << "text/html; charset=utf-8"
    }
    if e == ".html" {
        << "text/html; charset=utf-8"
    }
    if e == ".jpeg" {
        << "image/jpeg"
    }
    if e == ".jpg" {
        << "image/jpeg"
    }
    if e == ".js" {
        << "text/javascript; charset=utf-8"
    }
    if e == ".json" {
        << "application/json"
    }
    if e == ".mjs" {
        << "text/javascript; charset=utf-8"
    }
    if e == ".pdf" {
        << "application/pdf"
    }
    if e == ".png" {
        << "image/png"
    }
    if e == ".svg" {
        << "image/svg+xml"
    }
    if e == ".wasm" {
        << "application/wasm"
    }
    if e == ".webp" {
        << "image/webp"
    }
    if e == ".xml" {
        << "text/xml; charset=utf-8"
    }
    << ""
}

pub fn extensions_by_type(typ &string) []string {
    t := strings.to_lower(typ)
    mut base := t + ""
    mut i := 0
    while i < t.len {
        if (t[i] & 255) == 59 {
            raw := t[0:i] + ""
            base = strings.trim_space(&raw)
            <-
        }
        i = i + 1
    }
    mut out := []string{}
    if base == "text/html" {
        out.push(".html")
        out.push(".htm")
        << out
    }
    if base == "text/css" {
        out.push(".css")
        << out
    }
    if base == "image/gif" {
        out.push(".gif")
        << out
    }
    if base == "image/jpeg" {
        out.push(".jpeg")
        out.push(".jpg")
        << out
    }
    if base == "text/javascript" {
        out.push(".js")
        out.push(".mjs")
        << out
    }
    if base == "application/json" {
        out.push(".json")
        << out
    }
    if base == "application/pdf" {
        out.push(".pdf")
        << out
    }
    if base == "image/png" {
        out.push(".png")
        << out
    }
    if base == "image/svg+xml" {
        out.push(".svg")
        << out
    }
    if base == "application/wasm" {
        out.push(".wasm")
        << out
    }
    if base == "image/webp" {
        out.push(".webp")
        << out
    }
    if base == "text/xml" {
        out.push(".xml")
        << out
    }
    if base == "image/avif" {
        out.push(".avif")
        << out
    }
    << out
}
