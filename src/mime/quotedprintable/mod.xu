@mime/quotedprintable


#errors
// Quoted-printable (RFC 2045) aligned with Go `mime/quotedprintable`
// NewReader/NewWriter core: encode_to_string / decode_string over owning
// strings (no io.Reader). Soft breaks `=\r\n` and `=\n`; trailing `=` at
// eof ignored. Encoder wraps at 76 and encodes trailing space/tab.

const hex = "0123456789ABCDEF"
const line = 75

fn from_hex(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    << 0 - 1
}

fn crlf_bytes(out &mut []int) {
    out.push(13)
    out.push(10)
}

fn must_qp(c int) bool {
    if c == 61 {
        << true
    }
    if c == 9 || c == 32 {
        << false
    }
    if c == 10 || c == 13 {
        << false
    }
    if c >= 33 && c <= 126 {
        << false
    }
    << true
}

pub fn decode_string(s &string) string {
    src := s + ""
    mut out := []int{}
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c != 61 {
            out.push(c)
            i = i + 1
        } else if i + 1 >= src.len {
            i = src.len
        } else {
            n := src[i + 1] & 255
            if n == 13 {
                i = i + 2
                if i < src.len && (src[i] & 255) == 10 {
                    i = i + 1
                }
            } else if n == 10 {
                i = i + 2
            } else {
                if i + 2 >= src.len {
                    >> errors.new("quotedprintable: invalid hex")
                }
                hb := from_hex(src[i + 1] & 255)
                lb := from_hex(src[i + 2] & 255)
                if hb < 0 || lb < 0 {
                    >> errors.new("quotedprintable: invalid hex")
                }
                out.push((hb * 16) + lb)
                i = i + 3
            }
        }
    }
    << string_from_bytes(out)
}

pub fn encode_to_string(s &string) string {
    src := s + ""
    mut out := []int{}
    mut col := 0
    mut i := 0
    while i < src.len {
        c := src[i] & 255
        if c == 13 || c == 10 {
            if c == 13 {
                if i + 1 < src.len && (src[i + 1] & 255) == 10 {
                    i = i + 1
                }
            }
            crlf_bytes(mut &out)
            col = 0
            i = i + 1
        } else {
            mut need := 1
            mut enc := 0
            if must_qp(c) {
                need = 3
                enc = 1
            } else if c == 32 || c == 9 {
                mut eol := 0
                if i + 1 >= src.len {
                    eol = 1
                } else {
                    n := src[i + 1] & 255
                    if n == 10 || n == 13 {
                        eol = 1
                    }
                }
                if eol == 1 {
                    need = 3
                    enc = 1
                }
            }
            if col + need > line {
                out.push(61)
                crlf_bytes(mut &out)
                col = 0
            }
            if enc == 1 {
                out.push(61)
                out.push(hex[c >> 4])
                out.push(hex[c & 15])
                col = col + 3
            } else {
                out.push(c)
                col = col + 1
            }
            i = i + 1
        }
    }
    << string_from_bytes(out)
}
