@mime/multipart


#errors
#path
#strings

// MIME multipart (RFC 2046 / RFC 2388 form-data) aligned with Go
// `mime/multipart` Reader.NextPart + Writer write-field subset.
// Parts are owning strings (no io.Reader). Headers are parallel slices.

pub struct Part {
    pub keys []string
    pub vals []string
    pub body string
}

pub struct Reader {
    pub data string
    pub boundary string
    pub pos int
    pub closed int
}

pub struct Writer {
    pub boundary string
    pub buf string
    pub started int
    pub closed int
}

fn crlf() string {
    << string_from_byte(13) + string_from_byte(10)
}

fn index_from(s &string, sub &string, from int) int {
    text := s + ""
    needle := sub + ""
    if needle.len == 0 {
        << from
    }
    $i := from
    while i + needle.len <= text.len {
        $ok := 1
        for j in 0:needle.len {
            if (text[i + j] & 255) != (needle[j] & 255) {
                ok = 0
            }
        }
        if ok == 1 {
            << i
        }
        i = i + 1
    }
    << -1
}

fn dash_bound(boundary &string) string {
    << "--" + (boundary + "")
}

fn is_token(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    if c >= 97 && c <= 122 {
        << true
    }
    if c >= 48 && c <= 57 {
        << true
    }
    if c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 {
        << true
    }
    if c == 42 || c == 43 || c == 45 || c == 46 {
        << true
    }
    if c == 94 || c == 95 || c == 96 || c == 124 || c == 126 {
        << true
    }
    << false
}

fn parse_disp(v &string) []string {
    // returns [typ, k0, v0, k1, v1, ...]
    $out := []string{}
    src := strings.trim_space(v)
    $i := 0
    while i < src.len && is_token(src[i] & 255) {
        i = i + 1
    }
    typ := src[0:i] + ""
    out.push(strings.to_lower(&typ))
    while i < src.len {
        c := src[i] & 255
        if c == 32 || c == 9 {
            i = i + 1
        } else if c == 59 {
            i = i + 1
            while i < src.len && ((src[i] & 255) == 32 || (src[i] & 255) == 9) {
                i = i + 1
            }
            k0 := i
            while i < src.len && is_token(src[i] & 255) {
                i = i + 1
            }
            if i == k0 {
                <-
            }
            kseg := src[k0:i] + ""
            k := strings.to_lower(&kseg)
            while i < src.len && ((src[i] & 255) == 32 || (src[i] & 255) == 9) {
                i = i + 1
            }
            $val := ""
            if i < src.len && (src[i] & 255) == 61 {
                i = i + 1
                while i < src.len && ((src[i] & 255) == 32 || (src[i] & 255) == 9) {
                    i = i + 1
                }
                if i < src.len && (src[i] & 255) == 34 {
                    i = i + 1
                    v0 := i
                    while i < src.len && (src[i] & 255) != 34 {
                        i = i + 1
                    }
                    val = src[v0:i] + ""
                    if i < src.len {
                        i = i + 1
                    }
                } else {
                    v0 := i
                    while i < src.len && is_token(src[i] & 255) {
                        i = i + 1
                    }
                    val = src[v0:i] + ""
                }
            }
            out.push(k)
            out.push(val)
        } else {
            <-
        }
    }
    << out
}

pub fn (p Part) header(name string) string {
    want := strings.to_lower(&name)
    $i := 0
    while i < p.keys.len {
        k := p.keys[i] + ""
        lk := strings.to_lower(&k)
        if lk == want {
            << p.vals[i] + ""
        }
        i = i + 1
    }
    << ""
}

pub fn (p Part) form_name() string {
    cd := p.header("Content-Disposition")
    kv := parse_disp(&cd)
    $out := ""
    if kv.len > 0 {
        if kv[0] == "form-data" {
            $i := 1
            while i + 1 < kv.len {
                k := kv[i] + ""
                $hit := 0
                if k == "name" {
                    hit = 1
                }
                if hit == 1 {
                    if out.len == 0 {
                        out = kv[i + 1] + ""
                    }
                }
                i = i + 2
            }
        }
    }
    << out
}

pub fn (p Part) file_name() string {
    cd := p.header("Content-Disposition")
    kv := parse_disp(&cd)
    $out := ""
    $i := 1
    while i + 1 < kv.len {
        k := kv[i] + ""
        $hit := 0
        if k == "filename" {
            hit = 1
        }
        if hit == 1 {
            if out.len == 0 {
                fnm := kv[i + 1] + ""
                out = path.base(&fnm)
            }
        }
        i = i + 2
    }
    << out
}

pub fn (p Part) body() string {
    << p.body + ""
}

pub fn new_reader(body &string, boundary &string) Reader {
    << Reader{data: body + "", boundary: boundary + "", pos: 0, closed: 0}
}

fn skip_line(s &string, i int) int {
    $p := i
    while p < s.len {
        c := s[p] & 255
        p = p + 1
        if c == 10 {
            << p
        }
    }
    << p
}

pub fn (r $&Reader) next_part() Part {
    if r.closed != 0 {
        >> errors.new("EOF")
    }
    src := r.data + ""
    bound := dash_bound(&r.boundary)
    p := index_from(&src, &bound, r.pos)
    if p < 0 {
        r.closed = 1
        >> errors.new("EOF")
    }
    $i := p + bound.len
    if i + 1 < src.len && (src[i] & 255) == 45 && (src[i + 1] & 255) == 45 {
        r.closed = 1
        >> errors.new("EOF")
    }
    i = skip_line(&src, i)
    $keys := []string{}
    $vals := []string{}
    while i < src.len {
        nxt := skip_line(&src, i)
        $line := src[i:nxt] + ""
        if line.len > 0 && (line[line.len - 1] & 255) == 10 {
            line = line[0:(line.len - 1)] + ""
        }
        if line.len > 0 && (line[line.len - 1] & 255) == 13 {
            line = line[0:(line.len - 1)] + ""
        }
        if line.len == 0 {
            i = nxt
            <-
        }
        col := strings.index_of(&line, ":")
        if col <= 0 {
            >> errors.new("mime/multipart: malformed header")
        }
        kpart := line[0:col] + ""
        vpart := line[(col + 1):line.len] + ""
        keys.push(strings.trim_space(&kpart))
        vals.push(strings.trim_space(&vpart))
        i = nxt
    }
    crlfb := crlf() + bound
    nlb := string_from_byte(10) + bound
    a := index_from(&src, &crlfb, i)
    b := index_from(&src, &nlb, i)
    $end := -1
    $delim := 0
    if a >= 0 && (b < 0 || a <= b) {
        end = a
        delim = 2
    } else if b >= 0 {
        end = b
        delim = 1
    }
    if end < 0 {
        r.closed = 1
        >> errors.new("mime/multipart: missing terminator")
    }
    body := src[i:end] + ""
    r.pos = end + delim
    << Part{keys: keys, vals: vals, body: body}
}

pub fn new_writer() Writer {
    b := "XuBoundary7MA4YWxkTrZu0gW"
    << new_writer_with_boundary(&b)
}

pub fn new_writer_with_boundary(boundary &string) Writer {
    << Writer{boundary: boundary + "", buf: "", started: 0, closed: 0}
}

pub fn (w Writer) boundary() string {
    << w.boundary + ""
}

pub fn (w Writer) form_data_content_type() string {
    << "multipart/form-data; boundary=" + w.boundary
}

fn (w $&Writer) start_part() {
    d := crlf()
    db := dash_bound(&w.boundary)
    started := w.started
    r := $&w.buf
    if started == 0 {
        r.push_str(db)
        r.push_str(d)
    } else {
        r.push_str(d)
        r.push_str(db)
        r.push_str(d)
    }
    w.started = 1
}

pub fn (w $&Writer) write_field(name &string, value &string) {
    w.start_part()
    d := crlf()
    nm := name + ""
    r := $&w.buf
    r.push_str("Content-Disposition: form-data; name=\"")
    r.push_str(nm)
    r.push_str("\"")
    r.push_str(d)
    r.push_str(d)
    r.push_str(value + "")
}

pub fn (w $&Writer) write_file(name &string, filename &string, content_type &string, body &string) {
    w.start_part()
    d := crlf()
    nm := name + ""
    fnm := filename + ""
    ct := content_type + ""
    r := $&w.buf
    r.push_str("Content-Disposition: form-data; name=\"")
    r.push_str(nm)
    r.push_str("\"; filename=\"")
    r.push_str(fnm)
    r.push_str("\"")
    r.push_str(d)
    r.push_str("Content-Type: ")
    r.push_str(ct)
    r.push_str(d)
    r.push_str(d)
    r.push_str(body + "")
}

pub fn (w $&Writer) close() {
    if w.closed != 0 {
        <<
    }
    d := crlf()
    db := dash_bound(&w.boundary)
    r := $&w.buf
    r.push_str(d)
    r.push_str(db)
    r.push_str("--")
    r.push_str(d)
    w.closed = 1
}

pub fn (w &Writer) bytes() string {
    << w.buf + ""
}
