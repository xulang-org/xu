@runtime/core
// Software f64 arithmetic and 64-bit division for 32-bit bare-metal
// targets, whose backends call these instead of FPU or 64-bit divide
// instructions. Values are IEEE-754 binary64 bit patterns in int.
// Round to nearest even; results match the hosted FPUs, except that a NaN
// produced from non-NaN operands is always the positive default NaN.
//
// Only integer +, -, *, shifts, bitwise ops and comparisons appear here:
// no division or modulo, which would call back into this file.

const SF_FRAC = 4503599627370495       // 2^52 - 1
const SF_HIDDEN = 4503599627370496     // 2^52
const SF_QNAN = 9221120237041090560    // 0x7ff8000000000000
const SF_QUIET = 2251799813685248      // 2^51
const SF_INT_MAX = 9223372036854775807

fn sf_min() int {
    << 0 - 9223372036854775807 - 1
}

// Logical shift right for 0 <= n < 64.
fn sf_lsr(x int, n int) int {
    if n == 0 { << x }
    << (x >> n) & ((1 << (64 - n)) - 1)
}

fn sf_exp(a int) int {
    << sf_lsr(a, 52) & 2047
}

fn sf_is_nan(a int) bool {
    << sf_exp(a) == 2047 && (a & SF_FRAC) != 0
}

// m >> n keeping a sticky bit for anything shifted out (m >= 0).
fn sf_shr_sticky(m int, n int) int {
    if n <= 0 { << m }
    if n >= 62 {
        if m != 0 { << 1 }
        << 0
    }
    $r := m >> n
    if (m & ((1 << n) - 1)) != 0 {
        r = r | 1
    }
    << r
}

fn sf_pack(sign int, e int, frac int) int {
    << (sign << 63) | (e << 52) | frac
}

// m holds the significand with its leading bit at 55 for normal values
// (three guard/round/sticky bits below the 52-bit fraction); e is the
// biased exponent, 1 for subnormal values.
fn sf_round_pack(sign int, e0 int, m0 int) int {
    $e := e0
    $m := m0
    if e >= 2047 { << sf_pack(sign, 2047, 0) }
    low := m & 7
    m = m >> 3
    if low > 4 || (low == 4 && (m & 1) != 0) {
        m += 1
        if m == (SF_HIDDEN << 1) {
            m = m >> 1
            e += 1
            if e >= 2047 { << sf_pack(sign, 2047, 0) }
        }
    }
    if m < SF_HIDDEN {
        e = 0
    }
    << sf_pack(sign, e, m & SF_FRAC)
}

// Significand with the hidden bit, exponent raised to 1 for subnormals.
fn sf_mant(a int) int {
    if sf_exp(a) == 0 { << a & SF_FRAC }
    << (a & SF_FRAC) | SF_HIDDEN
}

fn sf_bexp(a int) int {
    e := sf_exp(a)
    if e == 0 { << 1 }
    << e
}

fn sf_nan_of(a int, b int) int {
    if sf_is_nan(a) { << a | SF_QUIET }
    << b | SF_QUIET
}

pub fn sf_add(a int, b int) int {
    if sf_is_nan(a) || sf_is_nan(b) { << sf_nan_of(a, b) }
    sa := sf_lsr(a, 63)
    sb := sf_lsr(b, 63)
    if sf_exp(a) == 2047 {
        if sf_exp(b) == 2047 && sa != sb { << SF_QNAN }
        << a
    }
    if sf_exp(b) == 2047 { << b }
    $ea := sf_bexp(a)
    $eb := sf_bexp(b)
    $ma := sf_mant(a) << 3
    $mb := sf_mant(b) << 3
    $s1 := sa
    $s2 := sb
    if ea < eb || (ea == eb && ma < mb) {
        t := ea
        ea = eb
        eb = t
        tm := ma
        ma = mb
        mb = tm
        s1 = sb
        s2 = sa
    }
    mb = sf_shr_sticky(mb, ea - eb)
    $e := ea
    $m := 0
    if s1 == s2 {
        m = ma + mb
        if m >= (SF_HIDDEN << 4) {
            m = sf_shr_sticky(m, 1)
            e += 1
        }
    } else {
        m = ma - mb
        if m == 0 { << 0 }
        while m < (SF_HIDDEN << 3) && e > 1 {
            m = m << 1
            e -= 1
        }
    }
    << sf_round_pack(s1, e, m)
}

pub fn sf_sub(a int, b int) int {
    if sf_is_nan(b) { << sf_nan_of(a, b) }
    << sf_add(a, b ^ sf_min())
}

// Normalized significand (leading bit at 52) and adjusted exponent of a
// finite non-zero value.
fn sf_norm_mant(a int) int {
    $m := sf_mant(a)
    while m < SF_HIDDEN {
        m = m << 1
    }
    << m
}

fn sf_norm_exp(a int) int {
    $m := sf_mant(a)
    $e := sf_bexp(a)
    while m < SF_HIDDEN {
        m = m << 1
        e -= 1
    }
    << e
}

fn sf_finish(sign int, e int, m int) int {
    if e <= 0 {
        << sf_round_pack(sign, 1, sf_shr_sticky(m, 1 - e))
    }
    << sf_round_pack(sign, e, m)
}

fn sf_is_zero(a int) bool {
    << (a & SF_INT_MAX) == 0
}

pub fn sf_mul(a int, b int) int {
    if sf_is_nan(a) || sf_is_nan(b) { << sf_nan_of(a, b) }
    sign := sf_lsr(a, 63) ^ sf_lsr(b, 63)
    if sf_exp(a) == 2047 || sf_exp(b) == 2047 {
        if sf_is_zero(a) || sf_is_zero(b) { << SF_QNAN }
        << sf_pack(sign, 2047, 0)
    }
    if sf_is_zero(a) || sf_is_zero(b) { << (sign << 63) }
    ma := sf_norm_mant(a)
    mb := sf_norm_mant(b)
    $e := sf_norm_exp(a) + sf_norm_exp(b) - 1023
    // 53 x 53-bit product as hi * 2^52 + lo, from 27/26-bit halves.
    m26 := (1 << 26) - 1
    ah := ma >> 26
    al := ma & m26
    bh := mb >> 26
    bl := mb & m26
    mid := ah * bl + al * bh
    $lo := al * bl + ((mid & m26) << 26)
    $hi := ah * bh + (mid >> 26) + (lo >> 52)
    lo = lo & SF_FRAC
    $m := 0
    if hi >= (SF_HIDDEN << 1) {
        m = (hi << 2) | (lo >> 50)
        if (lo & ((1 << 50) - 1)) != 0 { m = m | 1 }
        e += 1
    } else {
        m = (hi << 3) | (lo >> 49)
        if (lo & ((1 << 49) - 1)) != 0 { m = m | 1 }
    }
    << sf_finish(sign, e, m)
}

pub fn sf_div(a int, b int) int {
    if sf_is_nan(a) || sf_is_nan(b) { << sf_nan_of(a, b) }
    sign := sf_lsr(a, 63) ^ sf_lsr(b, 63)
    if sf_exp(a) == 2047 {
        if sf_exp(b) == 2047 { << SF_QNAN }
        << sf_pack(sign, 2047, 0)
    }
    if sf_exp(b) == 2047 { << (sign << 63) }
    if sf_is_zero(b) {
        if sf_is_zero(a) { << SF_QNAN }
        << sf_pack(sign, 2047, 0)
    }
    if sf_is_zero(a) { << (sign << 63) }
    $r := sf_norm_mant(a)
    mb := sf_norm_mant(b)
    $e := sf_norm_exp(a) - sf_norm_exp(b) + 1023
    if r < mb {
        r = r << 1
        e -= 1
    }
    $q := 0
    for _ in 0:56 {
        q = q << 1
        if r >= mb {
            r -= mb
            q = q | 1
        }
        r = r << 1
    }
    if r != 0 { q = q | 1 }
    << sf_finish(sign, e, q)
}

// Order-preserving integer key for a non-NaN value; -0 and +0 map to 0.
fn sf_key(a int) int {
    if a < 0 { << 0 - (a & SF_INT_MAX) }
    << a
}

pub fn sf_eq(a int, b int) bool {
    if sf_is_nan(a) || sf_is_nan(b) { << false }
    << sf_key(a) == sf_key(b)
}

pub fn sf_lt(a int, b int) bool {
    if sf_is_nan(a) || sf_is_nan(b) { << false }
    << sf_key(a) < sf_key(b)
}

pub fn sf_le(a int, b int) bool {
    if sf_is_nan(a) || sf_is_nan(b) { << false }
    << sf_key(a) <= sf_key(b)
}

pub fn sf_from_int(x int) int {
    if x == 0 { << 0 }
    if x == sf_min() { << -4332462841530417152 } // -2^63
    $sign := 0
    $u := x
    if x < 0 {
        sign = 1
        u = 0 - x
    }
    $p := 62
    while (u >> p) == 0 {
        p -= 1
    }
    if p <= 52 {
        << sf_pack(sign, 1023 + p, (u << (52 - p)) & SF_FRAC)
    }
    $m := 0
    if p > 55 {
        m = sf_shr_sticky(u, p - 55)
    } else {
        m = u << (55 - p)
    }
    << sf_round_pack(sign, 1023 + p, m)
}

// Truncates toward zero, saturating; NaN gives 0.
pub fn sf_to_int(a int) int {
    if sf_is_nan(a) { << 0 }
    e := sf_exp(a)
    if e < 1023 { << 0 }
    if e >= 1086 {
        if a < 0 { << sf_min() }
        << SF_INT_MAX
    }
    m := (a & SF_FRAC) | SF_HIDDEN
    $v := 0
    if e >= 1075 {
        v = m << (e - 1075)
    } else {
        v = m >> (1075 - e)
    }
    if a < 0 { << 0 - v }
    << v
}

// Unsigned a < b.
fn sf_ult(a int, b int) bool {
    << (a ^ sf_min()) < (b ^ sf_min())
}

// Unsigned n / d (d != 0); the remainder when rem is set.
fn sf_udivmod(n int, d int, rem bool) int {
    $q := 0
    $r := 0
    $i := 63
    while i >= 0 {
        r = (r << 1) | (sf_lsr(n, i) & 1)
        if !sf_ult(r, d) {
            r = r - d
            q = q | (1 << i)
        }
        i -= 1
    }
    if rem { << r }
    << q
}

// The hosted division semantics: x / 0 = 0, x % 0 = x, MIN / -1 wraps.
pub fn sf_div64(a int, b int) int {
    if b == 0 { << 0 }
    if b == -1 { << 0 - a }
    $ua := a
    if a < 0 { ua = 0 - a }
    $ub := b
    if b < 0 { ub = 0 - b }
    q := sf_udivmod(ua, ub, false)
    if (a < 0) != (b < 0) { << 0 - q }
    << q
}

pub fn sf_mod64(a int, b int) int {
    if b == 0 { << a }
    if b == -1 { << 0 }
    $ua := a
    if a < 0 { ua = 0 - a }
    $ub := b
    if b < 0 { ub = 0 - b }
    r := sf_udivmod(ua, ub, true)
    if a < 0 { << 0 - r }
    << r
}
