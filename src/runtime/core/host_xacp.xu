@runtime/core

const XACP_CAPACITY = 0
const XACP_CONTROL = 8
const XACP_TOTALS = 16
const XACP_RINGS = 32

// A capacity of zero queries the control fd without enabling capture.
pub fn host_xacp_output_init(capacity int) int {
    state := gword(G_XACP_OUTPUT)
    if state != 0 { << rt_load(state + XACP_CONTROL, 8) }
    if capacity < 4096 || capacity > 16777216 { << -1 }
    os := xu_target_os()
    if os != OS_LINUX && os != OS_MACOS { << -1 }
    // F_DUPFD_CLOEXEC keeps control frames out of the stdout ring.
    $command := 67
    if os == OS_LINUX { command = 1030 }
    fd := rt_syscall(host_nr(92, 25), 1, command, 3, 0, 0, 0)
    if fd < 0 { << -1 }
    fresh := alloc(XACP_RINGS + capacity * 2)
    rt_store(fresh + XACP_CAPACITY, 8, capacity)
    rt_store(fresh + XACP_CONTROL, 8, fd)
    set_gword(G_XACP_OUTPUT, fresh)
    << fd
}

// No allocation, blocking I/O or scheduler yield while updating a ring.
fn xacp_output_append(fd int, buf int, size int) {
    state := gword(G_XACP_OUTPUT)
    if state == 0 || size <= 0 { << }
    capacity := rt_load(state + XACP_CAPACITY, 8)
    if capacity <= 0 { << }
    counter := state + XACP_TOTALS + (fd - 1) * 8
    total := rt_load(counter, 8) + size
    $count := size
    if count > capacity { count = capacity }
    src := buf + size - count
    ring := state + XACP_RINGS + (fd - 1) * capacity
    offset := (total - count) % capacity
    $first := capacity - offset
    if first > count { first = count }
    mem_copy(ring + offset, src, first)
    mem_copy(ring, src + first, count - first)
    rt_store(counter, 8, total)
}

pub fn host_xacp_output_read(out int, fd int, since int, limit int) {
    set_desc(out, 0, 0, 0)
    state := gword(G_XACP_OUTPUT)
    if state == 0 || (fd != 1 && fd != 2) || since < 0 || limit < 0 { << }
    capacity := rt_load(state + XACP_CAPACITY, 8)
    if capacity <= 0 { << }
    total := rt_load(state + XACP_TOTALS + (fd - 1) * 8, 8)
    $base := total - capacity
    if base < 0 { base = 0 }
    $start := since
    if start < base { start = base }
    if start > total { start = total }
    $count := total - start
    if count > limit { count = limit }
    size := 16 + count
    snapshot := alloc(size)
    rt_store(snapshot, 8, base)
    rt_store(snapshot + 8, 8, total)
    ring := state + XACP_RINGS + (fd - 1) * capacity
    offset := start % capacity
    $first := capacity - offset
    if first > count { first = count }
    mem_copy(snapshot + 16, ring + offset, first)
    mem_copy(snapshot + 16 + first, ring, count - first)
    set_desc(out, snapshot, size, size)
}
