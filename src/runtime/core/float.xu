@runtime/core
// f64 printing. An f64 is its IEEE-754 bit pattern in one word.

fn f64_bits(f f64) int {
    $x := f
    << rt_load(rt_addr(&x), 8)
}

fn f64_from_bits(b int) f64 {
    $x := 0.0
    rt_store(rt_addr(&x), 8, b)
    << x
}

// Format of the product compiler: sign, truncated integer part, then up to
// six fraction digits with trailing zeros trimmed. Conversions saturate
// (fcvtzs), so huge values and infinities print as 9223372036854775807
// followed by '/' digits, and NaN prints as 0.
pub fn print_f64(fd int, f f64, newline bool) {
    buf := alloc(64)
    $pos := 0
    $x := f
    if f64_bits(f) < 0 {
        rt_store(buf, 1, 45)
        pos = 1
        x = f64_from_bits(f64_bits(f) & 9223372036854775807)
    }
    ip := int(x)
    if ip == 0 {
        rt_store(buf + pos, 1, 48)
        pos += 1
    } else {
        tmp := alloc(24)
        $tp := 24
        $v := ip
        while v != 0 {
            tp -= 1
            rt_store(tmp + tp, 1, 48 + v % 10)
            v = v / 10
        }
        while tp < 24 {
            rt_store(buf + pos, 1, rt_load(tmp + tp, 1))
            pos += 1
            tp += 1
        }
    }
    $frac := x - f64(ip)
    if f64_bits(frac) != 0 {
        rt_store(buf + pos, 1, 46)
        pos += 1
        start := pos
        $k := 0
        while k < 6 {
            frac = frac * 10.0
            d := int(frac)
            rt_store(buf + pos, 1, 48 + d)
            pos += 1
            frac = frac - f64(d)
            k += 1
            if f64_bits(frac) == 0 {
                <-
            }
        }
        while pos > start && rt_load(buf + pos - 1, 1) == 48 {
            pos -= 1
        }
        if pos == start {
            pos -= 1
        }
    }
    if newline {
        rt_store(buf + pos, 1, 10)
        pos += 1
    }
    write_fd(fd, buf, pos)
}
