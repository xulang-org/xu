@runtime/core
// Hosted process, environment, time and string builtins (see host.xu).

pub fn host_string_from_byte(out int, b int) {
    buf := alloc(2)
    rt_store(buf, 1, b & 255)
    set_desc(out, buf, 1, 1)
}

// Low bytes of the int array at arr[lo:hi]; hi < 0 means arr.len.
pub fn host_string_from_bytes(out int, arr int, lo int, hi int) {
    $end := hi
    if end < 0 {
        end = desc_len(arr)
    }
    slice_check(lo, end, desc_len(arr))
    n := end - lo
    buf := alloc(n + 1)
    src := desc_ptr(arr) + lo * 8
    for i in 0:n {
        rt_store(buf + i, 1, rt_load(src + i * 8, 1))
    }
    set_desc(out, buf, n, n)
}

// ===== arguments and environment =====

pub fn host_args(out int) {
    set_desc(out, 0, 0, 0)
    argc := gword(G_ARGC)
    argv := gword(G_ARGV)
    for i in 0:argc {
        s := rt_load(argv + i * 8, 8)
        host_push_string(out, s, host_strlen(s))
    }
}

pub fn host_env_list(out int) {
    set_desc(out, 0, 0, 0)
    envp := gword(G_ENVP)
    if envp == 0 {
        <<
    }
    $i := 0
    while rt_load(envp + i * 8, 8) != 0 {
        s := rt_load(envp + i * 8, 8)
        host_push_string(out, s, host_strlen(s))
        i += 1
    }
}

// Address of the value of environment variable name (descriptor), or 0.
fn host_env_find(name int) int {
    envp := gword(G_ENVP)
    if envp == 0 {
        << 0
    }
    np := desc_ptr(name)
    nl := desc_len(name)
    $i := 0
    while rt_load(envp + i * 8, 8) != 0 {
        s := rt_load(envp + i * 8, 8)
        $j := 0
        while j < nl && rt_load(s + j, 1) == rt_load(np + j, 1) && rt_load(s + j, 1) != 0 {
            j += 1
        }
        if j == nl && rt_load(s + j, 1) == 61 {
            << s + j + 1
        }
        i += 1
    }
    << 0
}

pub fn host_env_get(out int, name int) {
    v := host_env_find(name)
    if v == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    bytes_new(out, v, host_strlen(v))
}

pub fn host_tmp_dir(out int) {
    $key := "TMPDIR"
    v := host_env_find(rt_addr(&key))
    if v != 0 && rt_load(v, 1) != 0 {
        bytes_new(out, v, host_strlen(v))
        <<
    }
    $dflt := "/tmp"
    bytes_new(out, desc_ptr(rt_addr(&dflt)), 4)
}

pub fn host_cwd(out int) {
    set_desc(out, 0, 0, 0)
    buf := alloc(4096)
    if host_linux() {
        r := rt_syscall(17, buf, 4096, 0, 0, 0, 0)
        if r < 0 {
            <<
        }
    } else {
        $dot := "."
        fd := host_open(host_cstr(rt_addr(&dot)), host_o_directory(), 0)
        if fd < 0 {
            <<
        }
        r := rt_syscall(92, fd, 50, buf, 0, 0, 0)
        host_close(fd)
        if r < 0 {
            <<
        }
    }
    bytes_new(out, buf, host_strlen(buf))
}

pub fn host_host_name(out int) {
    set_desc(out, 0, 0, 0)
    if host_linux() {
        buf := alloc(65 * 6)
        if rt_syscall(160, buf, 0, 0, 0, 0, 0) < 0 {
            <<
        }
        bytes_new(out, buf + 65, host_strlen(buf + 65))
        <<
    }
    mib := alloc(16)
    rt_store(mib, 4, 1)
    rt_store(mib + 4, 4, 10)
    buf := alloc(256)
    lenp := alloc(16)
    rt_store(lenp, 8, 255)
    if rt_syscall(202, mib, 2, buf, lenp, 0, 0) < 0 {
        <<
    }
    bytes_new(out, buf, host_strlen(buf))
}

// ===== identity =====

pub fn host_pid() int {
    << rt_syscall(host_nr(20, 172), 0, 0, 0, 0, 0, 0)
}

pub fn host_ppid() int {
    << rt_syscall(host_nr(39, 173), 0, 0, 0, 0, 0, 0)
}

pub fn host_uid() int {
    << rt_syscall(host_nr(24, 174), 0, 0, 0, 0, 0, 0)
}

pub fn host_euid() int {
    << rt_syscall(host_nr(25, 175), 0, 0, 0, 0, 0, 0)
}

pub fn host_gid() int {
    << rt_syscall(host_nr(47, 176), 0, 0, 0, 0, 0, 0)
}

pub fn host_egid() int {
    << rt_syscall(host_nr(43, 177), 0, 0, 0, 0, 0, 0)
}

pub fn host_pagesize() int {
    << host_nr(16384, 4096)
}

// ===== time =====

// Nanoseconds from a fixed origin. Linux uses CLOCK_MONOTONIC; macOS has no
// raw monotonic clock system call, so it reads the wall clock.
pub fn host_now_ns() int {
    if host_linux() {
        ts := alloc(16)
        rt_syscall(113, 1, ts, 0, 0, 0, 0)
        << rt_load(ts, 8) * 1000000000 + rt_load(ts + 8, 8)
    }
    << host_now_wall()
}

pub fn host_wall_time_ns() int {
    << host_now_wall()
}

pub fn host_sleep_ns(ns int) {
    if ns <= 0 {
        <<
    }
    t := alloc(16)
    if host_linux() {
        rt_store(t, 8, ns / 1000000000)
        rt_store(t + 8, 8, ns % 1000000000)
        $r := rt_syscall(101, t, t, 0, 0, 0, 0)
        while r == 0 - EINTR {
            r = rt_syscall(101, t, t, 0, 0, 0, 0)
        }
        <<
    }
    $us := (ns + 999) / 1000
    deadline := host_now_wall() + ns
    while us > 0 {
        rt_store(t, 8, us / 1000000)
        rt_store(t + 8, 8, us % 1000000)
        r := rt_syscall(93, 0, 0, 0, 0, t, 0)
        if r != 0 - EINTR {
            <<
        }
        us = (deadline - host_now_wall() + 999) / 1000
    }
}

// Waits up to ns for cancellation of done. Channel readiness is not
// observable from the runtime yet, so this always runs to the timeout.
pub fn host_wait_cancel(done int, ns int) bool {
    host_sleep_ns(ns)
    << false
}

// ===== processes =====

// fork(2): 0 in the child, the child pid in the parent, -errno on failure.
fn host_fork() int {
    if host_linux() {
        << rt_syscall(220, 17, 0, 0, 0, 0, 0)
    }
    r := rt_syscall(2, 0, 0, 0, 0, 0, 0)
    if r < 0 {
        << r
    }
    if host_sys_r1() != 0 {
        << 0
    }
    << r
}

fn host_execve(path int, argv int) {
    rt_syscall(host_nr(59, 221), path, argv, gword(G_ENVP), 0, 0, 0)
}

fn host_kill(pid int, sig int) int {
    << rt_syscall(host_nr(37, 129), pid, sig, 0, 0, 0, 0)
}

// wait4(pid, &status, options); returns the reaped pid, 0 or -errno and
// stores the status word at st.
fn host_wait4(pid int, st int, options int) int {
    while true {
        r := rt_syscall(host_nr(7, 260), pid, st, options, 0, 0, 0)
        if r != 0 - EINTR {
            << r
        }
    }
    << 0
}

// os_system(cmd): wait(2) status of `/bin/sh -c cmd`.
pub fn host_system(cmd int) int {
    $sh := "/bin/sh"
    $dash := "-c"
    shp := host_cstr(rt_addr(&sh))
    argv := alloc(32)
    rt_store(argv, 8, shp)
    rt_store(argv + 8, 8, host_cstr(rt_addr(&dash)))
    rt_store(argv + 16, 8, host_cstr(cmd))
    pid := host_fork()
    if pid < 0 {
        << 32512
    }
    if pid == 0 {
        host_execve(shp, argv)
        exit_process(127)
    }
    st := alloc(16)
    if host_wait4(pid, st, 0) < 0 {
        << 32512
    }
    << rt_load(st, 4)
}

fn host_le64(p int) int {
    $v := 0
    for i in 0:8 {
        v = v | (rt_load(p + i, 1) << (8 * i))
    }
    << v
}

// os_exec(path, blob, redir [, cancel, deadline]) -> wait(2) status.
// blob = dir NUL then each argument NUL-terminated. redir:
//   empty            inherit stdio
//   [1] path         stdout and stderr to the file
//   [2] out [in]     8-byte little-endian stdout (and stdin) fds
//   [3] in           8-byte little-endian stdin fd
//   other            the whole string is the stdout file path
// The parent closes passed fds. Negative results: -2 deadline passed (the
// child is killed and reaped), -3 process or wait failure.
pub fn host_exec(path int, blob int, redir int, has_deadline bool, deadline int) int {
    pathz := host_cstr(path)
    bz := host_cstr(blob)
    bl := desc_len(blob)
    $dir := 0
    $i := 0
    while i < bl && rt_load(bz + i, 1) != 0 {
        i += 1
    }
    if i > 0 {
        dir = bz
    }
    $start := i + 1
    $nargs := 0
    $j := start
    while j < bl {
        if rt_load(bz + j, 1) == 0 {
            nargs += 1
        }
        j += 1
    }
    argv := alloc((nargs + 2) * 8)
    if nargs == 0 {
        rt_store(argv, 8, pathz)
    } else {
        $k := 0
        $s := start
        j = start
        while j < bl {
            if rt_load(bz + j, 1) == 0 {
                rt_store(argv + k * 8, 8, bz + s)
                k += 1
                s = j + 1
            }
            j += 1
        }
    }
    $out_fd := -1
    $in_fd := -1
    $file := 0
    $both := false
    rl := desc_len(redir)
    if rl > 0 {
        rp := desc_ptr(redir)
        tag := rt_load(rp, 1)
        if tag == 2 {
            if rl >= 9 {
                out_fd = host_le64(rp + 1)
            }
            if rl >= 17 {
                in_fd = host_le64(rp + 9)
            }
        } else if tag == 3 {
            if rl >= 9 {
                in_fd = host_le64(rp + 1)
            }
        } else {
            $fp := rp
            $fl := rl
            if tag == 1 {
                both = true
                fp = rp + 1
                fl = rl - 1
            }
            if fl > 0 {
                file = alloc(fl + 1)
                mem_copy(file, fp, fl)
            }
        }
    }
    pid := host_fork()
    if pid == 0 {
        if dir != 0 {
            rt_syscall(host_nr(12, 49), dir, 0, 0, 0, 0, 0)
        }
        if in_fd >= 0 {
            host_dup2(in_fd, 0)
            host_close(in_fd)
        }
        if out_fd >= 0 {
            host_dup2(out_fd, 1)
            host_close(out_fd)
        } else if file != 0 {
            fd := host_open(file, host_o_trunc_write(), 438)
            if fd < 0 {
                exit_process(127)
            }
            host_dup2(fd, 1)
            if both {
                host_dup2(fd, 2)
            }
            host_close(fd)
        }
        host_execve(pathz, argv)
        exit_process(127)
    }
    if out_fd >= 0 {
        host_close(out_fd)
    }
    if in_fd >= 0 {
        host_close(in_fd)
    }
    if pid < 0 {
        << -3
    }
    st := alloc(16)
    $late := 0
    $options := 0
    if has_deadline && deadline > 0 {
        options = 1
    }
    while true {
        r := host_wait4(pid, st, options)
        if r < 0 {
            << -3
        }
        if r > 0 {
            <-
        }
        if late == 0 && host_now_ns() >= deadline {
            late = -2
            host_kill(pid, 9)
        }
        host_sleep_ns(10000000)
    }
    if late != 0 {
        << late
    }
    << rt_load(st, 4)
}
