@runtime/core
// Hosted file-system builtins (see host.xu for the calling convention).

const DIR_BUF_BYTES = 4096

pub fn host_read_file(out int, path int) int {
    set_desc(out, 0, 0, 0)
    if ui_mailbox_path(path) {
        << host_ui_read(out, path)
    }
    zc1 := host_cstr(path)
    fd := host_open(zc1, 0, 0)
    free(zc1)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    max_cap := MAX_STRING_PAYLOAD + 1
    $cap := 65536
    size := host_lseek(fd, 0, 2)
    if size >= 0 {
        if size > MAX_STRING_PAYLOAD {
            host_close(fd)
            << host_err_msg("read: file too large")
        }
        rewind := host_lseek(fd, 0, 0)
        if rewind < 0 {
            host_close(fd)
            << host_err("seek", path, 0 - rewind)
        }
        if size + 1 > cap {
            cap = size + 1
        }
    }
    $buf := alloc(cap)
    $n := 0
    while true {
        // The final byte can confirm EOF before we allocate a larger buffer.
        r := host_read(fd, buf + n, cap - n)
        if r < 0 {
            host_close(fd)
            free(buf)
            << host_err("read", path, 0 - r)
        }
        if r == 0 {
            <-
        }
        n += r
        if n == cap {
            if cap == max_cap {
                host_close(fd)
                free(buf)
                << host_err_msg("read: file too large")
            }
            next_cap := cap + min_int(cap, max_cap - cap)
            nbuf := alloc(next_cap)
            mem_copy(nbuf, buf, n)
            free(buf)
            buf = nbuf
            cap = next_cap
        }
    }
    host_close(fd)
    if n == 0 {
        free(buf)
        << 0
    }
    rt_store(buf + n, 1, 0)
    set_desc(out, buf, n, cap)
    << 0
}

pub fn host_write_file(okp int, path int, data int) int {
    if ui_mailbox_path(path) {
        << host_ui_write(okp, path, data)
    }
    zc2 := host_cstr(path)
    fd := host_open(zc2, host_o_trunc_write(), 493)
    free(zc2)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    r := host_write_all(fd, desc_ptr(data), desc_len(data))
    host_close(fd)
    if r < 0 {
        << host_err("write", path, 0 - r)
    }
    << host_ok(okp, r)
}

// Names in directory order, each followed by a newline; "." and ".." skipped.
pub fn host_read_dir(out int, path int) int {
    set_desc(out, 0, 0, 0)
    if host_win() {
        << win_read_dir(out, path)
    }
    zc3 := host_cstr(path)
    fd := host_open(zc3, host_o_directory(), 0)
    free(zc3)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    buf := alloc(DIR_BUF_BYTES)
    basep := alloc(16)
    $nl := 10
    while true {
        $r := 0
        if host_linux() {
            r = rt_syscall(61, fd, buf, DIR_BUF_BYTES, 0, 0, 0)
        } else {
            r = rt_syscall(344, fd, buf, DIR_BUF_BYTES, basep, 0, 0)
        }
        if r < 0 {
            host_close(fd)
            free(buf)
            free(basep)
            << host_err("readdir", path, 0 - r)
        }
        if r == 0 {
            <-
        }
        $off := 0
        while off < r {
            ent := buf + off
            reclen := rt_load(ent + 16, 1) | (rt_load(ent + 17, 1) << 8)
            if reclen == 0 {
                <-
            }
            $name := ent + 19
            $nlen := 0
            if host_linux() {
                nlen = host_strlen(name)
            } else {
                name = ent + 21
                nlen = rt_load(ent + 18, 1) | (rt_load(ent + 19, 1) << 8)
            }
            $skip := nlen == 0
            if nlen == 1 && rt_load(name, 1) == 46 {
                skip = true
            }
            if nlen == 2 && rt_load(name, 1) == 46 && rt_load(name + 1, 1) == 46 {
                skip = true
            }
            if !skip {
                host_append(out, name, nlen)
                host_append(out, rt_addr(&nl), 1)
            }
            off += reclen
        }
    }
    host_close(fd)
    free(buf)
    free(basep)
    << 0
}

// FileInfo{size, is_dir, mode} at out.
pub fn host_stat(out int, path int) int {
    if host_win() {
        << win_stat(out, path)
    }
    buf := alloc(256)
    $r := 0
    loong := host_linux() && xu_target_arch() == ARCH_LOONG64
    if loong {
        // statx(STATX_BASIC_STATS): older LoongArch kernels have no newfstatat.
        zc4 := host_cstr(path)
        r = rt_syscall(291, AT_FDCWD, zc4, 0, 2047, buf, 0)
        free(zc4)
    } else if host_linux() {
        zc5 := host_cstr(path)
        r = rt_syscall(79, AT_FDCWD, zc5, buf, 0, 0, 0)
        free(zc5)
    } else {
        zc6 := host_cstr(path)
        r = rt_syscall(338, zc6, buf, 0, 0, 0, 0)
        free(zc6)
    }
    if r < 0 {
        free(buf)
        << host_err("stat", path, 0 - r)
    }
    $size := 0
    $mode := 0
    if loong {
        size = rt_load(buf + 40, 8)
        mode = rt_load(buf + 28, 4) & 65535
    } else if host_linux() {
        size = rt_load(buf + 48, 8)
        if arch_x64() {
            mode = rt_load(buf + 24, 4)
        } else {
            mode = rt_load(buf + 16, 4)
        }
    } else {
        size = rt_load(buf + 96, 8)
        mode = rt_load(buf + 4, 1) | (rt_load(buf + 5, 1) << 8)
    }
    rt_store(out, 8, size)
    $is_dir := 0
    if (mode & 61440) == 16384 {
        is_dir = 1
    }
    rt_store(out + 8, 8, is_dir)
    rt_store(out + 16, 8, mode)
    free(buf)
    << 0
}

pub fn host_mkdir(okp int, path int) int {
    $r := 0
    if host_win() {
        zw1 := host_cstr(path)
        r = win_bool_result(win_call(W_CREATE_DIRECTORY, zw1, 0, 0, 0, 0, 0))
        free(zw1)
    } else if host_linux() {
        zc7 := host_cstr(path)
        r = rt_syscall(34, AT_FDCWD, zc7, 511, 0, 0, 0)
        free(zc7)
    } else {
        zc8 := host_cstr(path)
        r = rt_syscall(136, zc8, 511, 0, 0, 0, 0)
        free(zc8)
    }
    if r < 0 {
        << host_err("mkdir", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_rename(okp int, from int, to int) int {
    $r := 0
    if host_win() {
        // MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED
        zw2 := host_cstr(from)
        zw3 := host_cstr(to)
        r = win_bool_result(win_call(W_MOVE_FILE_EX, zw2, zw3, 3, 0, 0, 0))
        free(zw2)
        free(zw3)
    } else if host_linux() {
        // riscv64 and loong64 only have renameat2.
        $nr := 38
        if xu_target_arch() == ARCH_RISCV64 || xu_target_arch() == ARCH_LOONG64 {
            nr = 276
        }
        zc9 := host_cstr(from)
        zc10 := host_cstr(to)
        r = rt_syscall(nr, AT_FDCWD, zc9, AT_FDCWD, zc10, 0, 0)
        free(zc9)
        free(zc10)
    } else {
        zc11 := host_cstr(from)
        zc12 := host_cstr(to)
        r = rt_syscall(128, zc11, zc12, 0, 0, 0, 0)
        free(zc11)
        free(zc12)
    }
    if r < 0 {
        << host_err("rename", from, 0 - r)
    }
    << host_ok(okp, 0)
}

// Removes a file or an empty directory.
pub fn host_remove(okp int, path int) int {
    cp := host_cstr(path)
    $r := 0
    if host_win() {
        r = win_remove(cp)
    } else if host_linux() {
        r = rt_syscall(35, AT_FDCWD, cp, 0, 0, 0, 0)
        if r == -21 {
            r = rt_syscall(35, AT_FDCWD, cp, 512, 0, 0, 0)
        }
    } else {
        r = rt_syscall(10, cp, 0, 0, 0, 0, 0)
        if r == -1 || r == -21 {
            r = rt_syscall(137, cp, 0, 0, 0, 0, 0)
        }
    }
    free(cp)
    if r < 0 {
        << host_err("remove", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_chmod(okp int, path int, mode int) int {
    $r := 0
    if host_win() {
        // Only the owner-write bit maps: FILE_ATTRIBUTE_READONLY or NORMAL.
        $attr := 128
        if (mode & 128) == 0 {
            attr = 1
        }
        zw4 := host_cstr(path)
        r = win_bool_result(win_call(W_SET_FILE_ATTRIBUTES, zw4, attr, 0, 0, 0, 0))
        free(zw4)
    } else if host_linux() {
        zc13 := host_cstr(path)
        r = rt_syscall(53, AT_FDCWD, zc13, mode, 0, 0, 0)
        free(zc13)
    } else {
        zc14 := host_cstr(path)
        r = rt_syscall(15, zc14, mode, 0, 0, 0, 0)
        free(zc14)
    }
    if r < 0 {
        << host_err("chmod", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_chdir(okp int, path int) int {
    $r := 0
    if host_win() {
        zw5 := host_cstr(path)
        r = win_bool_result(win_call(W_SET_CURRENT_DIRECTORY, zw5, 0, 0, 0, 0, 0))
        free(zw5)
    } else {
        zc15 := host_cstr(path)
        r = rt_syscall(host_nr(12, 49), zc15, 0, 0, 0, 0, 0)
        free(zc15)
    }
    if r < 0 {
        << host_err("chdir", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_symlink(okp int, target int, link int) int {
    $r := 0
    if host_win() {
        // SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE; the result is a BOOLEAN.
        zw6 := host_cstr(link)
        zw7 := host_cstr(target)
        if (win_call(W_CREATE_SYMBOLIC_LINK, zw6, zw7, 2, 0, 0, 0) & 255) == 0 {
            r = win_fail()
        }
        free(zw6)
        free(zw7)
    } else if host_linux() {
        zc16 := host_cstr(target)
        zc17 := host_cstr(link)
        r = rt_syscall(36, zc16, AT_FDCWD, zc17, 0, 0, 0)
        free(zc16)
        free(zc17)
    } else {
        zc18 := host_cstr(target)
        zc19 := host_cstr(link)
        r = rt_syscall(57, zc18, zc19, 0, 0, 0, 0)
        free(zc18)
        free(zc19)
    }
    if r < 0 {
        << host_err("symlink", link, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_readlink(out int, path int) int {
    set_desc(out, 0, 0, 0)
    buf := alloc(4096)
    $r := 0
    if host_linux() {
        zc20 := host_cstr(path)
        r = rt_syscall(78, AT_FDCWD, zc20, buf, 4096, 0, 0)
        free(zc20)
    } else {
        zc21 := host_cstr(path)
        r = rt_syscall(58, zc21, buf, 4096, 0, 0, 0)
        free(zc21)
    }
    if r < 0 {
        free(buf)
        << host_err("readlink", path, 0 - r)
    }
    bytes_new(out, buf, r)
    free(buf)
    << 0
}

// mode: 0 read, 1 create/truncate, 2 append, 3 exclusive create,
// 4 lock (create, no truncation), 5 lock an existing file.
pub fn host_os_open(okp int, path int, mode int) int {
    $flags := 0
    $lock := mode >= 4
    if mode == 1 {
        flags = host_o_trunc_write()
    } else if mode == 2 {
        flags = host_o_wronly_create(1024, 8)
    } else if mode == 3 {
        flags = host_o_wronly_create(128, 2048)
    } else if lock {
        if host_win() {
            flags = 2
            if mode == 4 {
                flags = 2 | 64
            }
        } else if host_linux() {
            flags = 524288 | host_o_nofollow_linux()
            if mode == 4 {
                flags = flags | 2 | 64
            }
        } else {
            flags = 16777216 | 256 | 32 | 4
            if mode == 4 {
                flags = flags | 2 | 512
            }
        }
    }
    zc22 := host_cstr(path)
    fd := host_open(zc22, flags, 420)
    free(zc22)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    if lock && host_win() {
        r := win_lock(fd)
        if r < 0 {
            host_close(fd)
            << host_err("flock", path, 0 - r)
        }
    }
    if lock && host_linux() {
        r := rt_syscall(32, fd, 6, 0, 0, 0, 0)
        if r < 0 {
            host_close(fd)
            << host_err("flock", path, 0 - r)
        }
    }
    << host_ok(okp, fd)
}

pub fn host_fd_read(out int, fd int, max int) int {
    set_desc(out, 0, 0, 0)
    if max < 0 {
        << host_err("read", 0, 22)
    }
    if max == 0 {
        << 0
    }
    cap := max
    ready := host_wait_io(fd, 1)
    if ready < 0 {
        << host_err("read", 0, 0 - ready)
    }
    if cap > 16384 && cap <= 65536 && !debug_free() && !rt_mt_active() {
        $sb := gword(G_IO_SCRATCH)
        if sb == 0 {
            sb = alloc(65536)
            set_gword(G_IO_SCRATCH, sb)
        }
        r := host_read(fd, sb, cap)
        if r < 0 {
            << host_err("read", 0, 0 - r)
        }
        if r > 0 { task_io_progress() }
        $rcap := r
        if rcap < 1 { rcap = 1 }
        res := alloc(rcap)
        if r > 0 { mem_copy(res, sb, r) }
        set_desc(out, res, r, rcap)
        << 0
    }
    buf := alloc(cap)
    r := host_read(fd, buf, cap)
    if r < 0 {
        free(buf)
        << host_err("read", 0, 0 - r)
    }
    if r > 0 { task_io_progress() }
    set_desc(out, buf, r, cap)
    << 0
}

pub fn host_fd_write(okp int, fd int, data int) int {
    ready := host_wait_io(fd, 4)
    if ready < 0 {
        << host_err("write", 0, 0 - ready)
    }
    r := host_write_all(fd, desc_ptr(data), desc_len(data))
    if r < 0 {
        << host_err("write", 0, 0 - r)
    }
    if r > 0 { task_io_progress() }
    << host_ok(okp, r)
}

pub fn host_fd_close(okp int, fd int) int {
    r := host_close(fd)
    if r < 0 {
        << host_err("close", 0, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_fd_seek(okp int, fd int, off int, whence int) int {
    r := host_lseek(fd, off, whence)
    if r < 0 {
        << host_err("seek", 0, 0 - r)
    }
    << host_ok(okp, r)
}

// ok = (read fd << 32) | write fd.
pub fn host_pipe(okp int) int {
    if host_win() {
        << win_pipe(okp)
    }
    $rfd := 0
    $wfd := 0
    if host_linux() {
        fds := alloc(16)
        r := rt_syscall(59, fds, 0, 0, 0, 0, 0)
        rfd = rt_load(fds, 4)
        wfd = rt_load(fds + 4, 4)
        free(fds)
        if r < 0 {
            << host_err("pipe", 0, 0 - r)
        }
    } else {
        $r1 := 0
        r := host_macos_syscall_r1(42, 0, 0, $&r1)
        if r < 0 {
            << host_err("pipe", 0, 0 - r)
        }
        rfd = r
        wfd = r1
    }
    host_fd_timeo_clear(rfd)
    host_fd_timeo_clear(wfd)
    << host_ok(okp, (rfd << 32) | wfd)
}

// 1 when a read on fd would not block (data, EOF or error), else 0.
pub fn host_fd_peek_read(okp int, fd int) int {
    r := host_poll_ms(fd, 1, 0)
    if r < 0 {
        << host_err("poll", 0, 0 - r)
    }
    $ready := 0
    if r != 0 {
        ready = 1
    }
    << host_ok(okp, ready)
}

pub fn host_random_fill(out int, n int) int {
    set_desc(out, 0, 0, 0)
    if n < 0 {
        << host_err("random", 0, 22)
    }
    if n == 0 {
        << 0
    }
    if n > 9223372036854775807 - 16399 {
        fatal_no_memory()
    }
    cap := n
    buf := alloc(cap)
    $done := 0
    while done < n {
        $chunk := n - done
        $r := 0
        if host_win() {
            r = win_random(buf + done, chunk)
        } else if host_linux() {
            r = rt_syscall(278, buf + done, chunk, 0, 0, 0, 0)
        } else {
            if chunk > 256 {
                chunk = 256
            }
            r = rt_syscall(500, buf + done, chunk, 0, 0, 0, 0)
            if r == 0 {
                r = chunk
            }
        }
        if r < 0 {
            if r != 0 - EINTR {
                free(buf)
                << host_err("random", 0, 0 - r)
            }
        } else {
            done += r
        }
    }
    set_desc(out, buf, n, cap)
    << 0
}
