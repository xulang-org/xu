@runtime/core
// Hosted file-system builtins (see host.xu for the calling convention).

const DIR_BUF_BYTES = 4096

pub fn host_read_file(out int, path int) int {
    set_desc(out, 0, 0, 0)
    fd := host_open(host_cstr(path), 0, 0)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    $cap := 65536
    size := host_lseek(fd, 0, 2)
    if size >= 0 {
        host_lseek(fd, 0, 0)
        if size + 1 > cap {
            cap = size + 1
        }
    }
    $buf := alloc(cap)
    $n := 0
    while true {
        if n + 1 >= cap {
            nbuf := alloc(cap * 2)
            mem_copy(nbuf, buf, n)
            buf = nbuf
            cap = cap * 2
        }
        r := host_read(fd, buf + n, cap - 1 - n)
        if r < 0 {
            host_close(fd)
            << host_err("read", path, 0 - r)
        }
        if r == 0 {
            <-
        }
        n += r
    }
    host_close(fd)
    set_desc(out, buf, n, cap)
    << 0
}

pub fn host_write_file(okp int, path int, data int) int {
    fd := host_open(host_cstr(path), host_o_trunc_write(), 493)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    r := host_write_all(fd, desc_ptr(data), desc_len(data))
    host_close(fd)
    if r < 0 {
        << host_err("write", path, 0 - r)
    }
    << host_ok(okp, r)
}

// Names in directory order, each followed by a newline; "." and ".." skipped.
pub fn host_read_dir(out int, path int) int {
    set_desc(out, 0, 0, 0)
    if host_win() {
        << win_read_dir(out, path)
    }
    fd := host_open(host_cstr(path), host_o_directory(), 0)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    buf := alloc(DIR_BUF_BYTES)
    basep := alloc(16)
    $nl := 10
    while true {
        $r := 0
        if host_linux() {
            r = rt_syscall(61, fd, buf, DIR_BUF_BYTES, 0, 0, 0)
        } else {
            r = rt_syscall(344, fd, buf, DIR_BUF_BYTES, basep, 0, 0)
        }
        if r < 0 {
            host_close(fd)
            << host_err("readdir", path, 0 - r)
        }
        if r == 0 {
            <-
        }
        $off := 0
        while off < r {
            ent := buf + off
            reclen := rt_load(ent + 16, 1) | (rt_load(ent + 17, 1) << 8)
            if reclen == 0 {
                <-
            }
            $name := ent + 19
            $nlen := 0
            if host_linux() {
                nlen = host_strlen(name)
            } else {
                name = ent + 21
                nlen = rt_load(ent + 18, 1) | (rt_load(ent + 19, 1) << 8)
            }
            $skip := nlen == 0
            if nlen == 1 && rt_load(name, 1) == 46 {
                skip = true
            }
            if nlen == 2 && rt_load(name, 1) == 46 && rt_load(name + 1, 1) == 46 {
                skip = true
            }
            if !skip {
                host_append(out, name, nlen)
                host_append(out, rt_addr(&nl), 1)
            }
            off += reclen
        }
    }
    host_close(fd)
    << 0
}

// FileInfo{size, is_dir, mode} at out.
pub fn host_stat(out int, path int) int {
    if host_win() {
        << win_stat(out, path)
    }
    buf := alloc(256)
    $r := 0
    loong := host_linux() && xu_target_arch() == ARCH_LOONG64
    if loong {
        // statx(STATX_BASIC_STATS): older LoongArch kernels have no newfstatat.
        r = rt_syscall(291, AT_FDCWD, host_cstr(path), 0, 2047, buf, 0)
    } else if host_linux() {
        r = rt_syscall(79, AT_FDCWD, host_cstr(path), buf, 0, 0, 0)
    } else {
        r = rt_syscall(338, host_cstr(path), buf, 0, 0, 0, 0)
    }
    if r < 0 {
        << host_err("stat", path, 0 - r)
    }
    $size := 0
    $mode := 0
    if loong {
        size = rt_load(buf + 40, 8)
        mode = rt_load(buf + 28, 4) & 65535
    } else if host_linux() {
        size = rt_load(buf + 48, 8)
        if arch_x64() {
            mode = rt_load(buf + 24, 4)
        } else {
            mode = rt_load(buf + 16, 4)
        }
    } else {
        size = rt_load(buf + 96, 8)
        mode = rt_load(buf + 4, 1) | (rt_load(buf + 5, 1) << 8)
    }
    rt_store(out, 8, size)
    $is_dir := 0
    if (mode & 61440) == 16384 {
        is_dir = 1
    }
    rt_store(out + 8, 8, is_dir)
    rt_store(out + 16, 8, mode)
    << 0
}

pub fn host_mkdir(okp int, path int) int {
    $r := 0
    if host_win() {
        r = win_bool_result(win_call(W_CREATE_DIRECTORY, host_cstr(path), 0, 0, 0, 0, 0))
    } else if host_linux() {
        r = rt_syscall(34, AT_FDCWD, host_cstr(path), 511, 0, 0, 0)
    } else {
        r = rt_syscall(136, host_cstr(path), 511, 0, 0, 0, 0)
    }
    if r < 0 {
        << host_err("mkdir", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_rename(okp int, from int, to int) int {
    $r := 0
    if host_win() {
        // MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED
        r = win_bool_result(win_call(W_MOVE_FILE_EX, host_cstr(from), host_cstr(to), 3, 0, 0, 0))
    } else if host_linux() {
        // riscv64 and loong64 only have renameat2.
        $nr := 38
        if xu_target_arch() == ARCH_RISCV64 || xu_target_arch() == ARCH_LOONG64 {
            nr = 276
        }
        r = rt_syscall(nr, AT_FDCWD, host_cstr(from), AT_FDCWD, host_cstr(to), 0, 0)
    } else {
        r = rt_syscall(128, host_cstr(from), host_cstr(to), 0, 0, 0, 0)
    }
    if r < 0 {
        << host_err("rename", from, 0 - r)
    }
    << host_ok(okp, 0)
}

// Removes a file or an empty directory.
pub fn host_remove(okp int, path int) int {
    cp := host_cstr(path)
    $r := 0
    if host_win() {
        r = win_remove(cp)
    } else if host_linux() {
        r = rt_syscall(35, AT_FDCWD, cp, 0, 0, 0, 0)
        if r == -21 {
            r = rt_syscall(35, AT_FDCWD, cp, 512, 0, 0, 0)
        }
    } else {
        r = rt_syscall(10, cp, 0, 0, 0, 0, 0)
        if r == -1 || r == -21 {
            r = rt_syscall(137, cp, 0, 0, 0, 0, 0)
        }
    }
    if r < 0 {
        << host_err("remove", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_chmod(okp int, path int, mode int) int {
    $r := 0
    if host_win() {
        // Only the owner-write bit maps: FILE_ATTRIBUTE_READONLY or NORMAL.
        $attr := 128
        if (mode & 128) == 0 {
            attr = 1
        }
        r = win_bool_result(win_call(W_SET_FILE_ATTRIBUTES, host_cstr(path), attr, 0, 0, 0, 0))
    } else if host_linux() {
        r = rt_syscall(53, AT_FDCWD, host_cstr(path), mode, 0, 0, 0)
    } else {
        r = rt_syscall(15, host_cstr(path), mode, 0, 0, 0, 0)
    }
    if r < 0 {
        << host_err("chmod", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_chdir(okp int, path int) int {
    $r := 0
    if host_win() {
        r = win_bool_result(win_call(W_SET_CURRENT_DIRECTORY, host_cstr(path), 0, 0, 0, 0, 0))
    } else {
        r = rt_syscall(host_nr(12, 49), host_cstr(path), 0, 0, 0, 0, 0)
    }
    if r < 0 {
        << host_err("chdir", path, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_symlink(okp int, target int, link int) int {
    $r := 0
    if host_win() {
        // SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE; the result is a BOOLEAN.
        if (win_call(W_CREATE_SYMBOLIC_LINK, host_cstr(link), host_cstr(target), 2, 0, 0, 0) & 255) == 0 {
            r = win_fail()
        }
    } else if host_linux() {
        r = rt_syscall(36, host_cstr(target), AT_FDCWD, host_cstr(link), 0, 0, 0)
    } else {
        r = rt_syscall(57, host_cstr(target), host_cstr(link), 0, 0, 0, 0)
    }
    if r < 0 {
        << host_err("symlink", link, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_readlink(out int, path int) int {
    set_desc(out, 0, 0, 0)
    buf := alloc(4096)
    $r := 0
    if host_linux() {
        r = rt_syscall(78, AT_FDCWD, host_cstr(path), buf, 4096, 0, 0)
    } else {
        r = rt_syscall(58, host_cstr(path), buf, 4096, 0, 0, 0)
    }
    if r < 0 {
        << host_err("readlink", path, 0 - r)
    }
    bytes_new(out, buf, r)
    << 0
}

// mode: 0 read, 1 create/truncate, 2 append, 3 exclusive create,
// 4 lock (create, no truncation), 5 lock an existing file.
pub fn host_os_open(okp int, path int, mode int) int {
    $flags := 0
    $lock := mode >= 4
    if mode == 1 {
        flags = host_o_trunc_write()
    } else if mode == 2 {
        flags = host_o_wronly_create(1024, 8)
    } else if mode == 3 {
        flags = host_o_wronly_create(128, 2048)
    } else if lock {
        if host_win() {
            flags = 2
            if mode == 4 {
                flags = 2 | 64
            }
        } else if host_linux() {
            flags = 524288 | host_o_nofollow_linux()
            if mode == 4 {
                flags = flags | 2 | 64
            }
        } else {
            flags = 16777216 | 256 | 32 | 4
            if mode == 4 {
                flags = flags | 2 | 512
            }
        }
    }
    fd := host_open(host_cstr(path), flags, 420)
    if fd < 0 {
        << host_err("open", path, 0 - fd)
    }
    if lock && host_win() {
        r := win_lock(fd)
        if r < 0 {
            host_close(fd)
            << host_err("flock", path, 0 - r)
        }
    }
    if lock && host_linux() {
        r := rt_syscall(32, fd, 6, 0, 0, 0, 0)
        if r < 0 {
            host_close(fd)
            << host_err("flock", path, 0 - r)
        }
    }
    << host_ok(okp, fd)
}

pub fn host_fd_read(out int, fd int, max int) int {
    set_desc(out, 0, 0, 0)
    $cap := max
    if cap < 1 {
        cap = 1
    }
    buf := alloc(cap)
    host_poll_task(fd, 1, -1)
    r := host_read(fd, buf, cap)
    if r < 0 {
        << host_err("read", 0, 0 - r)
    }
    set_desc(out, buf, r, cap)
    << 0
}

pub fn host_fd_write(okp int, fd int, data int) int {
    host_poll_task(fd, 4, -1)
    r := host_write_all(fd, desc_ptr(data), desc_len(data))
    if r < 0 {
        << host_err("write", 0, 0 - r)
    }
    << host_ok(okp, r)
}

pub fn host_fd_close(okp int, fd int) int {
    r := host_close(fd)
    if r < 0 {
        << host_err("close", 0, 0 - r)
    }
    << host_ok(okp, 0)
}

pub fn host_fd_seek(okp int, fd int, off int, whence int) int {
    r := host_lseek(fd, off, whence)
    if r < 0 {
        << host_err("seek", 0, 0 - r)
    }
    << host_ok(okp, r)
}

// ok = (read fd << 32) | write fd.
pub fn host_pipe(okp int) int {
    if host_win() {
        << win_pipe(okp)
    }
    $rfd := 0
    $wfd := 0
    if host_linux() {
        fds := alloc(16)
        r := rt_syscall(59, fds, 0, 0, 0, 0, 0)
        if r < 0 {
            << host_err("pipe", 0, 0 - r)
        }
        rfd = rt_load(fds, 4)
        wfd = rt_load(fds + 4, 4)
    } else {
        r := rt_syscall(42, 0, 0, 0, 0, 0, 0)
        if r < 0 {
            << host_err("pipe", 0, 0 - r)
        }
        rfd = r
        wfd = host_sys_r1()
    }
    << host_ok(okp, (rfd << 32) | wfd)
}

// 1 when a read on fd would not block (data, EOF or error), else 0.
pub fn host_fd_peek_read(okp int, fd int) int {
    r := host_poll_ms(fd, 1, 0)
    if r < 0 {
        << host_err("poll", 0, 0 - r)
    }
    $ready := 0
    if r != 0 {
        ready = 1
    }
    << host_ok(okp, ready)
}

pub fn host_random_fill(out int, n int) int {
    set_desc(out, 0, 0, 0)
    $cap := n
    if cap < 1 {
        cap = 1
    }
    buf := alloc(cap)
    $done := 0
    while done < n {
        $chunk := n - done
        $r := 0
        if host_win() {
            r = win_random(buf + done, chunk)
        } else if host_linux() {
            r = rt_syscall(278, buf + done, chunk, 0, 0, 0, 0)
        } else {
            if chunk > 256 {
                chunk = 256
            }
            r = rt_syscall(500, buf + done, chunk, 0, 0, 0, 0)
            if r == 0 {
                r = chunk
            }
        }
        if r < 0 {
            if r != 0 - EINTR {
                << host_err("random", 0, 0 - r)
            }
        } else {
            done += r
        }
    }
    set_desc(out, buf, n, cap)
    << 0
}
