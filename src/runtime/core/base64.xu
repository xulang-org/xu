@runtime/core

// The alphabet and output size are checked once for the complete conversion.
// Allocate the destination here so the raw stores only touch fresh storage.
pub fn base64_encode(src &string, alphabet &string, pad bool) string {
    n := src.len
    if n == 0 || alphabet.len < 64 { << "" }
    blocks := n / 3
    tail := n % 3
    if blocks > (9223372036854775807 - 32768) / 4 {
        intrin_fatal("make_string: invalid length\n")
    }
    $length := blocks * 4
    if tail != 0 {
        if pad { length += 4 } else { length += tail + 1 }
    }
    output := alloc(length + 1)
    input := str_ptr(src)
    table := str_ptr(alphabet)
    limit := blocks * 3
    $i := 0
    $w := 0
    while i < limit {
        a := rt_load(input + i, 1)
        b := rt_load(input + i + 1, 1)
        c := rt_load(input + i + 2, 1)
        v0 := rt_load(table + (a >> 2), 1)
        v1 := rt_load(table + (((a & 3) << 4) | (b >> 4)), 1)
        v2 := rt_load(table + (((b & 15) << 2) | (c >> 6)), 1)
        v3 := rt_load(table + (c & 63), 1)
        rt_store(output + w, 4, v0 | (v1 << 8) | (v2 << 16) | (v3 << 24))
        i += 3
        w += 4
    }
    if tail != 0 {
        a := rt_load(input + i, 1)
        rt_store(output + w, 1, rt_load(table + (a >> 2), 1))
        if tail == 2 {
            b := rt_load(input + i + 1, 1)
            rt_store(output + w + 1, 1, rt_load(table + (((a & 3) << 4) | (b >> 4)), 1))
            rt_store(output + w + 2, 1, rt_load(table + ((b & 15) << 2), 1))
        } else {
            rt_store(output + w + 1, 1, rt_load(table + ((a & 3) << 4), 1))
            if pad { rt_store(output + w + 2, 1, 61) }
        }
        if pad { rt_store(output + w + 3, 1, 61) }
    }
    $out := ""
    set_desc(rt_addr($&out), output, length, length)
    << out
}

// On malformed input, return the empty descriptor so the caller can report
// the original structured error. A valid nonempty encoding decodes to >= 1 byte.
pub fn base64_decode(src &string, alphabet &string) string {
    n := src.len
    if n < 4 || n % 4 != 0 || alphabet.len < 256 { << "" }
    input := str_ptr(src)
    table := str_ptr(alphabet)
    limit := n - 4
    last0 := rt_load(table + rt_load(input + limit, 1), 1) - 33
    last1 := rt_load(table + rt_load(input + limit + 1, 1), 1) - 33
    ch2 := rt_load(input + limit + 2, 1)
    ch3 := rt_load(input + limit + 3, 1)
    if last0 < 0 || last1 < 0 || (ch2 == 61 && ch3 != 61) { << "" }
    $last2 := 0
    $last3 := 0
    $tail := 1
    if ch2 != 61 {
        last2 = rt_load(table + ch2, 1) - 33
        tail += 1
        if ch3 != 61 {
            last3 = rt_load(table + ch3, 1) - 33
            tail += 1
        }
    }
    if (last2 | last3) < 0 { << "" }
    length := (limit / 4) * 3 + tail
    output := alloc(length + 1)
    $i := 0
    $w := 0
    $bad := 0
    while i < limit {
        a := rt_load(table + rt_load(input + i, 1), 1) - 33
        b := rt_load(table + rt_load(input + i + 1, 1), 1) - 33
        c := rt_load(table + rt_load(input + i + 2, 1), 1) - 33
        d := rt_load(table + rt_load(input + i + 3, 1), 1) - 33
        bad = bad | a | b | c | d
        rt_store(output + w, 1, (a << 2) | (b >> 4))
        rt_store(output + w + 1, 1, (b << 4) | (c >> 2))
        rt_store(output + w + 2, 1, (c << 6) | d)
        i += 4
        w += 3
    }
    if bad < 0 {
        free(output)
        << ""
    }
    rt_store(output + w, 1, (last0 << 2) | (last1 >> 4))
    if tail >= 2 { rt_store(output + w + 1, 1, (last1 << 4) | (last2 >> 2)) }
    if tail == 3 { rt_store(output + w + 2, 1, (last2 << 6) | last3) }
    $out := ""
    set_desc(rt_addr($&out), output, length, length)
    << out
}
