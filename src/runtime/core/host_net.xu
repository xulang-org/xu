@runtime/core
// Hosted socket builtins (see host.xu). Socket domains, types, levels and
// option names are host numbers chosen by the caller.

fn host_sock_ok(okp int, op string, r int) int {
    if r < 0 {
        << host_err(op, 0, 0 - r)
    }
    << host_ok(okp, r)
}

// Socket address header: macOS {len u8, family u8}, Linux {family u16}.
fn host_sa_head(sa int, len int, family int) {
    if host_linux() || host_win() {
        rt_store(sa, 1, family)
        rt_store(sa + 1, 1, 0)
    } else {
        rt_store(sa, 1, len)
        rt_store(sa + 1, 1, family)
    }
}

fn host_sa_in4(a int, b int, c int, d int, port int) int {
    sa := alloc(16)
    host_sa_head(sa, 16, 2)
    rt_store(sa + 2, 1, (port >> 8) & 255)
    rt_store(sa + 3, 1, port & 255)
    rt_store(sa + 4, 1, a & 255)
    rt_store(sa + 5, 1, b & 255)
    rt_store(sa + 6, 1, c & 255)
    rt_store(sa + 7, 1, d & 255)
    << sa
}

fn host_sa_in6(ip int, port int) int {
    sa := alloc(32)
    $af6 := host_nr(30, 10)
    if host_win() {
        af6 = 23
    }
    host_sa_head(sa, 28, af6)
    rt_store(sa + 2, 1, (port >> 8) & 255)
    rt_store(sa + 3, 1, port & 255)
    mem_copy(sa + 8, desc_ptr(ip), 16)
    << sa
}

fn host_sa_unix(path int) int {
    sa := alloc(112)
    host_sa_head(sa, 106, 1)
    mem_copy(sa + 2, desc_ptr(path), desc_len(path))
    << sa
}

fn host_sock_bind(fd int, sa int, len int) int {
    if host_win() {
        << win_sock_bind(fd, sa, len)
    }
    << rt_syscall(host_nr(104, 200), fd, sa, len, 0, 0, 0)
}

fn host_sock_connect(fd int, sa int, len int) int {
    if host_win() {
        << win_sock_connect(fd, sa, len)
    }
    while true {
        r := rt_syscall(host_nr(98, 203), fd, sa, len, 0, 0, 0)
        if r != 0 - EINTR {
            << r
        }
    }
    << 0
}

fn host_sock_setopt(fd int, level int, opt int, val int, len int) int {
    if host_win() {
        << win_sock_setopt(fd, level, opt, val, len)
    }
    << rt_syscall(host_nr(105, 208), fd, level, opt, val, len, 0)
}

fn host_sock_timeout_option(events int) int {
    if (events & 1) != 0 {
        << host_nr(4102, 20) // SO_RCVTIMEO
    }
    << host_nr(4101, 21) // SO_SNDTIMEO
}

// poll and WSAPoll take a signed 32-bit millisecond timeout.
const POLL_TIMEOUT_MAX_MS = 2147483647

// Return the socket timeout in milliseconds, or -1 for a blocking wait.
// Files and pipes have no socket timeout.
fn host_sock_timeout_ms(fd int, events int) int {
    if host_win() && !win_is_sock(fd) {
        << -1
    }
    opt := host_sock_timeout_option(events)
    value := alloc(16)
    $length := 16
    $r := 0
    if host_win() {
        length = 4
        r = win_sock_getopt(fd, 65535, opt, value, rt_addr($&length))
    } else {
        r = rt_syscall(host_nr(118, 209), fd, host_nr(65535, 1), opt, value, rt_addr($&length), 0)
    }
    $ms := 0
    if r == 0 {
        if host_win() {
            ms = rt_load(value, 4)
        } else {
            sec := rt_load(value, 8)
            usec := rt_load(value + 8, 4)
            ms = min_int(sec, POLL_TIMEOUT_MAX_MS / 1000 + 1) * 1000 + (usec + 999) / 1000
        }
    }
    free(value)
    if ms <= 0 {
        << -1
    }
    << min_int(ms, POLL_TIMEOUT_MAX_MS)
}

// A lone task can let the OS apply the timeout in the I/O syscall. With
// runnable peers, wait for readiness cooperatively using the same timeout.
fn host_wait_io(fd int, events int) int {
    if !host_fd_in_range(fd) {
        << 0 - EBADF
    }
    if !task_others() {
        << 0
    }
    ms := host_sock_timeout_ms(fd, events)
    ready := host_poll_task(fd, events, ms)
    if ready == 0 && ms > 0 {
        if host_win() {
            << -110
        }
        << 0 - host_nr(35, 11)
    }
    if ready == 0 - EINTR {
        // The I/O syscall still handles interrupted reads and writes.
        << 0
    }
    << min_int(0, ready)
}

pub fn host_socket(okp int, domain int, typ int, proto int) int {
    if host_win() {
        << host_sock_ok(okp, "socket", win_socket(domain, typ, proto))
    }
    << host_sock_ok(okp, "socket", rt_syscall(host_nr(97, 198), domain, typ, proto, 0, 0, 0))
}

// SO_REUSEADDR, then bind.
pub fn host_bind4(okp int, fd int, a int, b int, c int, d int, port int) int {
    // Winsock's SO_REUSEADDR lets a second socket take a bound port.
    if !host_win() {
        one := alloc(16)
        rt_store(one, 4, 1)
        host_sock_setopt(fd, host_nr(65535, 1), host_nr(4, 2), one, 4)
    }
    << host_sock_ok(okp, "bind", host_sock_bind(fd, host_sa_in4(a, b, c, d, port), 16))
}

pub fn host_connect4(okp int, fd int, a int, b int, c int, d int, port int) int {
    << host_sock_ok(okp, "connect", host_sock_connect(fd, host_sa_in4(a, b, c, d, port), 16))
}

pub fn host_bind6(okp int, fd int, ip int, port int) int {
    if desc_len(ip) != 16 {
        << host_err_msg("bind: invalid IPv6 address")
    }
    << host_sock_ok(okp, "bind", host_sock_bind(fd, host_sa_in6(ip, port), 28))
}

pub fn host_connect6(okp int, fd int, ip int, port int) int {
    if desc_len(ip) != 16 {
        << host_err_msg("connect: invalid IPv6 address")
    }
    << host_sock_ok(okp, "connect", host_sock_connect(fd, host_sa_in6(ip, port), 28))
}

fn host_unix_path_ok(path int) bool {
    n := desc_len(path)
    if n == 0 || n > 103 {
        << false
    }
    for i in 0:n {
        if rt_load(desc_ptr(path) + i, 1) == 0 {
            << false
        }
    }
    << true
}

pub fn host_bind_unix(okp int, fd int, path int) int {
    if !host_unix_path_ok(path) {
        << host_err_msg("net: invalid unix socket path")
    }
    << host_sock_ok(okp, "bind", host_sock_bind(fd, host_sa_unix(path), 3 + desc_len(path)))
}

pub fn host_connect_unix(okp int, fd int, path int) int {
    if !host_unix_path_ok(path) {
        << host_err_msg("net: invalid unix socket path")
    }
    << host_sock_ok(okp, "connect", host_sock_connect(fd, host_sa_unix(path), 3 + desc_len(path)))
}

pub fn host_listen(okp int, fd int, backlog int) int {
    if host_win() {
        << host_sock_ok(okp, "listen", win_listen(fd, backlog))
    }
    << host_sock_ok(okp, "listen", rt_syscall(host_nr(106, 201), fd, backlog, 0, 0, 0, 0))
}

pub fn host_accept(okp int, fd int) int {
    ready := host_wait_io(fd, 1)
    if ready < 0 {
        << host_sock_ok(okp, "accept", ready)
    }
    if host_win() {
        << host_sock_ok(okp, "accept", win_accept(fd))
    }
    while true {
        r := rt_syscall(host_nr(30, 202), fd, 0, 0, 0, 0, 0)
        if r != 0 - EINTR {
            << host_sock_ok(okp, "accept", r)
        }
    }
    << 0
}

// addr = 4 IPv4 bytes then the big-endian port.
pub fn host_sendto(okp int, fd int, addr int, data int) int {
    if desc_len(addr) != 6 {
        << host_err_msg("sendto: invalid address")
    }
    ap := desc_ptr(addr)
    port := (rt_load(ap + 4, 1) << 8) | rt_load(ap + 5, 1)
    sa := host_sa_in4(rt_load(ap, 1), rt_load(ap + 1, 1), rt_load(ap + 2, 1), rt_load(ap + 3, 1), port)
    $r := 0
    if host_win() {
        r = win_sendto(fd, desc_ptr(data), desc_len(data), sa, 16)
    } else {
        r = rt_syscall(host_nr(133, 206), fd, desc_ptr(data), desc_len(data), 0, sa, 16)
    }
    << host_sock_ok(okp, "sendto", r)
}

// Result = 4 IPv4 bytes, big-endian port, payload.
pub fn host_recvfrom(out int, fd int, max int) int {
    set_desc(out, 0, 0, 0)
    if max <= 0 {
        << host_err_msg("recvfrom: invalid size")
    }
    ready := host_wait_io(fd, 1)
    if ready < 0 {
        << host_err("recvfrom", 0, 0 - ready)
    }
    buf := alloc(max + 6)
    sa := alloc(32)
    lenp := alloc(16)
    rt_store(lenp, 4, 16)
    $r := 0
    if host_win() {
        r = win_recvfrom(fd, buf + 6, max, sa, lenp)
    } else {
        r = rt_syscall(host_nr(29, 207), fd, buf + 6, max, 0, sa, lenp)
    }
    if r < 0 {
        << host_err("recvfrom", 0, 0 - r)
    }
    for i in 0:4 {
        rt_store(buf + i, 1, rt_load(sa + 4 + i, 1))
    }
    rt_store(buf + 4, 1, rt_load(sa + 2, 1))
    rt_store(buf + 5, 1, rt_load(sa + 3, 1))
    set_desc(out, buf, r + 6, max + 6)
    << 0
}

// SO_SNDTIMEO and SO_RCVTIMEO from a relative ns; ns <= 0 clears.
pub fn host_setsockopt_timeo(okp int, fd int, ns int) int {
    if host_win() {
        // SO_SNDTIMEO / SO_RCVTIMEO take a DWORD of milliseconds.
        ms := alloc(8)
        if ns > 0 {
            rt_store(ms, 4, (ns + 999999) / 1000000)
        }
        w1 := win_sock_setopt(fd, 65535, host_sock_timeout_option(4), ms, 4)
        if w1 < 0 {
            << host_err("setsockopt", 0, 0 - w1)
        }
        << host_sock_ok(okp, "setsockopt", win_sock_setopt(fd, 65535, host_sock_timeout_option(1), ms, 4))
    }
    tv := alloc(16)
    if ns > 0 {
        $us := ns / 1000
        if us < 1 {
            us = 1
        }
        rt_store(tv, 8, us / 1000000)
        rt_store(tv + 8, 8, us % 1000000)
    }
    level := host_nr(65535, 1)
    r1 := host_sock_setopt(fd, level, host_sock_timeout_option(4), tv, 16)
    if r1 < 0 {
        << host_err("setsockopt", 0, 0 - r1)
    }
    r2 := host_sock_setopt(fd, level, host_sock_timeout_option(1), tv, 16)
    << host_sock_ok(okp, "setsockopt", r2)
}

pub fn host_setsockopt(okp int, fd int, level int, opt int, value int) int {
    r := host_sock_setopt(fd, level, opt, desc_ptr(value), desc_len(value))
    << host_sock_ok(okp, "setsockopt", r)
}

pub fn host_socket_close(okp int, fd int) int {
    << host_fd_close(okp, fd)
}

// events: 1 read, 4 write. ok = 1 when ready (EOF and errors included).
pub fn host_socket_poll(okp int, fd int, events int) int {
    r := host_poll_ms(fd, events, 0)
    if r < 0 {
        << host_err("poll", 0, 0 - r)
    }
    $ready := 0
    if r != 0 {
        ready = 1
    }
    << host_ok(okp, ready)
}

// events: read 1, write 2. ok = mask of read 1, write 2, error 4, hangup 8.
// timeout_ns: 0 waits forever, negative polls once.
pub fn host_socket_wait(okp int, fd int, events int, timeout_ns int) int {
    $pev := 0
    if (events & 1) != 0 {
        pev = pev | 1
    }
    if (events & 2) != 0 {
        pev = pev | 4
    }
    $ms := -1
    if timeout_ns < 0 {
        ms = 0
    } else if timeout_ns > 0 {
        ms = (timeout_ns + 999999) / 1000000
    }
    r := host_poll_task(fd, pev, ms)
    if r < 0 {
        << host_err("poll", 0, 0 - r)
    }
    $mask := 0
    if (r & 1) != 0 {
        mask = mask | 1
    }
    if (r & 4) != 0 {
        mask = mask | 2
    }
    if (r & 8) != 0 {
        mask = mask | 4
    }
    if (r & 16) != 0 {
        mask = mask | 8
    }
    << host_ok(okp, mask)
}
