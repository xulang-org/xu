@runtime/core
// Function values (see xu/mir/lower_fnval.xu).

// A throwing function called through a function value has no caller that
// can receive its error.
pub fn fnval_error_panic(e int) {
    msg := "panic: error returned through a function value"
    print_desc(2, rt_addr(&msg), true)
    if rt_load(e, 8) == ERR_STR_TAG {
        print_desc(2, e + 8, true)
    }
    backtrace(2)
    exit_process(2)
}
