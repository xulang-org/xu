@runtime/core
// Failure paths of type queries and assert (see xu/mir/lower_iface.xu).

// `x as T` on a value of another type.
pub fn type_assert_fail() {
    msg := "type assert failed"
    print_desc(2, rt_addr(&msg), true)
    exit_process(1)
}

// assert(cond[, msg]) failed at path:line:col; msg is a string address or 0.
pub fn assert_fail(path int, line int, col int, msg int) {
    sep := ":"
    if desc_len(path) > 0 {
        print_desc(2, path, false)
        print_desc(2, rt_addr(&sep), false)
    }
    print_int(2, line, false)
    print_desc(2, rt_addr(&sep), false)
    print_int(2, col, false)
    head := ": assertion failed"
    print_desc(2, rt_addr(&head), msg == 0)
    if msg != 0 {
        colon := ": "
        print_desc(2, rt_addr(&colon), false)
        print_desc(2, msg, true)
    }
    exit_process(1)
}
