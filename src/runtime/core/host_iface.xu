@runtime/core
// sys_interface_data(name) for net/interface.xu. An empty name gives the
// interface names, NUL-separated. A name gives one record: byte 0 is the
// version (1), then u32 index at 1, u32 mtu at 5, u32 public flags at 9,
// the hardware address length at 13 and its bytes at 14..34, the address
// count at 34, and from 35 up to 8 entries of [len][prefix][16 bytes].

const IF_REC = 179
const IF_NAMES = 4096

pub fn host_interface_data(out int, name int) int {
    set_desc(out, 0, 0, 0)
    if host_linux() {
        << if_linux(out, name)
    }
    << if_darwin(out, name)
}

fn if_fail() int {
    << host_err_msg("net: interface query failed")
}

// Public flags: up 1, broadcast 2, loopback 4, point-to-point 8,
// multicast 16, running 32.
fn if_flags(f int) int {
    $mcast := 32768
    if host_linux() {
        mcast = 4096
    }
    $r := 0
    if (f & 1) != 0 { r = r | 1 }
    if (f & 2) != 0 { r = r | 2 }
    if (f & 8) != 0 { r = r | 4 }
    if (f & 16) != 0 { r = r | 8 }
    if (f & mcast) != 0 { r = r | 16 }
    if (f & 64) != 0 { r = r | 32 }
    << r
}

// Leading one bits of each of the n mask bytes at p, summed.
fn if_prefix(p int, n int) int {
    $bits := 0
    for i in 0:n {
        $b := rt_load(p + i, 1)
        while (b & 128) != 0 {
            bits += 1
            b = (b << 1) & 255
        }
    }
    << bits
}

fn if_new_rec() int {
    rec := alloc(IF_REC)
    rt_store(rec, 1, 1)
    << rec
}

fn if_add_addr(rec int, addr int, n int, prefix int) {
    k := rt_load(rec + 34, 1)
    if k >= 8 {
        <<
    }
    e := rec + 35 + k * 18
    rt_store(e, 1, n)
    rt_store(e + 1, 1, prefix)
    mem_copy(e + 2, addr, n)
    rt_store(rec + 34, 1, k + 1)
}

fn if_ok(out int, rec int) int {
    set_desc(out, rec, 35 + rt_load(rec + 34, 1) * 18, IF_REC)
    << 0
}

fn if_name_eq(p int, n int, name int) bool {
    if n != desc_len(name) {
        << false
    }
    q := desc_ptr(name)
    for i in 0:n {
        if rt_load(p + i, 1) != rt_load(q + i, 1) {
            << false
        }
    }
    << true
}

// ===== Darwin: the sysctl NET_RT_IFLIST routing dump getifaddrs reads =====

// The sockaddr for RTA bit want among those present in addrs, laid out
// from p (each padded to 4 bytes), or 0.
fn if_sa(p int, end int, addrs int, want int) int {
    $q := p
    for bit in 0:8 {
        m := 1 << bit
        if (addrs & m) != 0 {
            if q >= end {
                << 0
            }
            if m == want {
                << q
            }
            $l := rt_load(q, 1)
            if l == 0 {
                l = 4
            } else {
                l = ((l - 1) | 3) + 1
            }
            q += l
        }
    }
    << 0
}

fn if_darwin(out int, name int) int {
    mib := alloc(24)
    rt_store(mib, 4, 4)
    rt_store(mib + 4, 4, 17)
    rt_store(mib + 16, 4, 3)
    lenp := alloc(8)
    $buf := 0
    $tries := 0
    while buf == 0 {
        rt_store(lenp, 8, 0)
        if rt_syscall(202, mib, 6, 0, lenp, 0, 0) < 0 {
            << if_fail()
        }
        b := alloc(rt_load(lenp, 8))
        r := rt_syscall(202, mib, 6, b, lenp, 0, 0)
        if r >= 0 {
            buf = b
        } else if r != -12 || tries >= 4 {
            << if_fail()
        }
        tries += 1
    }
    total := rt_load(lenp, 8)
    names := desc_len(name) == 0
    $nbuf := 0
    $nlen := 0
    if names {
        nbuf = alloc(IF_NAMES)
    }
    rec := if_new_rec()
    $cur := 0
    $off := 0
    while off + 4 <= total {
        m := buf + off
        mlen := rt_load(m, 2)
        if mlen == 0 {
            <-
        }
        typ := rt_load(m + 3, 1)
        addrs := rt_load(m + 4, 4)
        if typ == 14 {
            sdl := if_sa(m + 112, m + mlen, addrs, 16)
            if sdl != 0 {
                sn := rt_load(sdl + 5, 1)
                if names {
                    if nlen + sn + 1 <= IF_NAMES {
                        mem_copy(nbuf + nlen, sdl + 8, sn)
                        nlen += sn + 1
                    }
                } else if cur == 0 && if_name_eq(sdl + 8, sn, name) {
                    cur = rt_load(m + 12, 2)
                    rt_store(rec + 1, 4, cur)
                    rt_store(rec + 5, 4, rt_load(m + 24, 4))
                    rt_store(rec + 9, 4, if_flags(rt_load(m + 8, 4)))
                    alen := rt_load(sdl + 6, 1)
                    if alen > 0 && alen <= 20 {
                        rt_store(rec + 13, 1, alen)
                        mem_copy(rec + 14, sdl + 8 + sn, alen)
                    }
                }
            }
        } else if typ == 12 && cur != 0 && rt_load(m + 12, 2) == cur {
            ifa := if_sa(m + 20, m + mlen, addrs, 32)
            if ifa != 0 {
                fam := rt_load(ifa + 1, 1)
                $n := 0
                $at := 0
                if fam == 2 {
                    n = 4
                    at = 4
                } else if fam == 30 {
                    n = 16
                    at = 8
                }
                if n > 0 {
                    $prefix := n * 8
                    mask := if_sa(m + 20, m + mlen, addrs, 4)
                    if mask != 0 {
                        $avail := rt_load(mask, 1) - at
                        if avail < 0 {
                            avail = 0
                        }
                        if avail > n {
                            avail = n
                        }
                        prefix = if_prefix(mask + at, avail)
                    }
                    a := alloc(16)
                    mem_copy(a, ifa + at, n)
                    // The kernel embeds the scope id of an fe80::/10
                    // address in bytes 2..3.
                    if n == 16 && rt_load(a, 1) == 254 && (rt_load(a + 1, 1) & 192) == 128 {
                        rt_store(a + 2, 2, 0)
                    }
                    if_add_addr(rec, a, n, prefix)
                }
            }
        }
        off += mlen
    }
    if names {
        set_desc(out, nbuf, nlen, IF_NAMES)
        << 0
    }
    << if_ok(out, rec)
}

// ===== Linux: SIOCGIF* ioctls on one named interface =====

fn if_ioctl(fd int, req int, ifr int) int {
    << rt_syscall(29, fd, req, ifr, 0, 0, 0)
}

fn if_linux(out int, name int) int {
    n := desc_len(name)
    if n < 1 || n > 15 {
        << if_fail()
    }
    fd := rt_syscall(198, 2, 2, 0, 0, 0, 0)
    if fd < 0 {
        << if_fail()
    }
    rec := if_new_rec()
    // struct ifreq: 16-byte name, then a 24-byte union.
    ifr := alloc(40)
    mem_copy(ifr, desc_ptr(name), n)
    if if_ioctl(fd, 35123, ifr) < 0 {
        es_close_fd(fd)
        << if_fail()
    }
    rt_store(rec + 1, 4, rt_load(ifr + 16, 4))
    if if_ioctl(fd, 35105, ifr) < 0 {
        es_close_fd(fd)
        << if_fail()
    }
    rt_store(rec + 5, 4, rt_load(ifr + 16, 4))
    if if_ioctl(fd, 35091, ifr) < 0 {
        es_close_fd(fd)
        << if_fail()
    }
    rt_store(rec + 9, 4, if_flags(rt_load(ifr + 16, 2)))
    if if_ioctl(fd, 35111, ifr) >= 0 {
        $hw := 0
        for i in 0:6 {
            hw = hw | rt_load(ifr + 18 + i, 1)
        }
        if hw != 0 {
            rt_store(rec + 13, 1, 6)
            mem_copy(rec + 14, ifr + 18, 6)
        }
    }
    if if_ioctl(fd, 35093, ifr) >= 0 {
        addr := alloc(4)
        mem_copy(addr, ifr + 20, 4)
        $prefix := 32
        if if_ioctl(fd, 35099, ifr) >= 0 {
            prefix = if_prefix(ifr + 20, 4)
        }
        if_add_addr(rec, addr, 4, prefix)
    }
    es_close_fd(fd)
    << if_ok(out, rec)
}
