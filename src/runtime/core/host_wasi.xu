@runtime/core
// WASI (preview 1) host layer. The runtime runs its Linux paths on WASI:
// os_code() reports Linux, and the backend's system call stub hands every
// Linux system call number to wasi_sys, which emulates it on the WASI
// imports. Results are -errno with Linux numbering.
//
// Paths resolve against the preopened directories, longest prefix first;
// relative paths join an emulated working directory (initially $PWD).
// Processes, sockets and event queues fail with ENOSYS.

// rt_syscall number of WASI import 0 (xu/codegen wasm_base.xu).
const WASI_SLOT_BASE = 65536

// Imports, in the order of xu/codegen wasm_base.xu wasi_import_names.
const WI_ARGS_GET = 0
const WI_ARGS_SIZES_GET = 1
const WI_ENVIRON_GET = 2
const WI_ENVIRON_SIZES_GET = 3
const WI_CLOCK_TIME_GET = 4
const WI_FD_CLOSE = 5
const WI_FD_READ = 6
const WI_FD_WRITE = 7
const WI_FD_SEEK = 8
const WI_FD_READDIR = 10
const WI_FD_PRESTAT_GET = 11
const WI_FD_PRESTAT_DIR_NAME = 12
const WI_PATH_CREATE_DIRECTORY = 13
const WI_PATH_FILESTAT_GET = 14
const WI_PATH_OPEN = 15
const WI_PATH_READLINK = 16
const WI_PATH_REMOVE_DIRECTORY = 17
const WI_PATH_RENAME = 18
const WI_PATH_SYMLINK = 19
const WI_PATH_UNLINK_FILE = 20
const WI_POLL_ONEOFF = 21
const WI_PROC_EXIT = 22
const WI_RANDOM_GET = 23
const WI_FD_FDSTAT_GET = 25

// rt_globals() words (the Windows-only slots are free on WASI).
const G_WASI_READY = 48
const G_WASI_CWD = 49
const G_WASI_PRE = 50
const G_WASI_NPRE = 51
const G_WASI_DIRS = 52
// Result of wasi_resolve: relative path (NUL-terminated) and length, and
// the cleaned absolute path.
const G_WASI_PPTR = 53
const G_WASI_PLEN = 54
const G_WASI_FULL = 55
// 256 bytes of out-parameter scratch; tasks never switch inside a call.
const G_WASI_SCRATCH = 128

const WASI_MAX_PRE = 64

fn host_wasi() bool {
    << xu_target_os() == OS_WASI
}

fn wasi_call(k int, a int, b int, c int, d int, e int, f int) int {
    << rt_syscall(WASI_SLOT_BASE + k, a, b, c, d, e, f)
}

fn wasi_scratch() int {
    << rt_globals() + G_WASI_SCRATCH * 8
}

// -errno (Linux numbering) for a WASI errno; 0 stays 0.
fn wasi_res(e int) int {
    if e == 0 { << 0 }
    << 0 - wasi_errno(e)
}

fn wasi_errno(e int) int {
    if e == 1 { << 7 }
    if e == 2 { << 13 }
    if e == 6 { << 11 }
    if e == 8 { << 9 }
    if e == 10 { << 16 }
    if e == 14 { << 111 }
    if e == 16 { << 35 }
    if e == 20 { << 17 }
    if e == 21 { << 14 }
    if e == 22 { << 27 }
    if e == 27 { << 4 }
    if e == 28 { << 22 }
    if e == 29 { << 5 }
    if e == 31 { << 21 }
    if e == 32 { << 40 }
    if e == 33 { << 24 }
    if e == 37 { << 36 }
    if e == 41 { << 23 }
    if e == 44 { << 2 }
    if e == 48 { << 12 }
    if e == 51 { << 28 }
    if e == 52 { << 38 }
    if e == 54 { << 20 }
    if e == 55 { << 39 }
    if e == 58 { << 95 }
    if e == 59 { << 25 }
    if e == 63 { << 1 }
    if e == 64 { << 32 }
    if e == 69 { << 30 }
    if e == 70 { << 29 }
    if e == 73 { << 110 }
    if e == 75 { << 18 }
    if e == 76 { << 13 }
    << 5
}

// ===== arguments, environment and preopens =====

// Converts the 4-byte pointers WASI writes into the runtime's 8-byte argv
// and NULL-terminated envp.
fn wasi_init_args() {
    if gword(G_WASI_READY) != 0 {
        <<
    }
    set_gword(G_WASI_READY, 1)
    sc := wasi_scratch()
    wasi_call(WI_ARGS_SIZES_GET, sc, sc + 8, 0, 0, 0, 0)
    argc := rt_load(sc, 4)
    abytes := rt_load(sc + 8, 4)
    ap := alloc(argc * 4 + 8)
    abuf := alloc(abytes + 1)
    wasi_call(WI_ARGS_GET, ap, abuf, 0, 0, 0, 0)
    argv := alloc(argc * 8 + 8)
    for i in 0:argc {
        rt_store(argv + i * 8, 8, rt_load(ap + i * 4, 4))
    }
    set_gword(G_ARGC, argc)
    set_gword(G_ARGV, argv)
    wasi_call(WI_ENVIRON_SIZES_GET, sc, sc + 8, 0, 0, 0, 0)
    envc := rt_load(sc, 4)
    ebytes := rt_load(sc + 8, 4)
    ep := alloc(envc * 4 + 8)
    ebuf := alloc(ebytes + 1)
    wasi_call(WI_ENVIRON_GET, ep, ebuf, 0, 0, 0, 0)
    envp := alloc(envc * 8 + 8)
    for i in 0:envc {
        rt_store(envp + i * 8, 8, rt_load(ep + i * 4, 4))
    }
    set_gword(G_ENVP, envp)
}

fn wasi_init() {
    wasi_init_args()
    if gword(G_WASI_CWD) != 0 {
        <<
    }
    $root := "/"
    $start := desc_ptr(rt_addr(&root))
    $slen := 1
    $key := "PWD"
    pwd := host_env_find(rt_addr(&key))
    if pwd != 0 && rt_load(pwd, 1) == 47 {
        start = pwd
        slen = host_strlen(pwd)
    }
    set_gword(G_WASI_CWD, wasi_clean(start, slen))
    tab := alloc(WASI_MAX_PRE * 16)
    sc := wasi_scratch()
    $n := 0
    $fd := 3
    while n < WASI_MAX_PRE {
        if wasi_call(WI_FD_PRESTAT_GET, fd, sc, 0, 0, 0, 0) != 0 {
            <-
        }
        if rt_load(sc, 1) == 0 {
            nlen := rt_load(sc + 4, 4)
            name := alloc(nlen + 1)
            wasi_call(WI_FD_PRESTAT_DIR_NAME, fd, name, nlen, 0, 0, 0)
            $clean := 0
            if nlen > 0 && rt_load(name, 1) == 47 {
                clean = wasi_clean(name, nlen)
            } else {
                clean = wasi_join(gword(G_WASI_CWD), name, nlen)
            }
            rt_store(tab + n * 16, 8, fd)
            rt_store(tab + n * 16 + 8, 8, clean)
            n += 1
        }
        fd += 1
    }
    set_gword(G_WASI_PRE, tab)
    set_gword(G_WASI_NPRE, n)
}

// Cleaned absolute path (NUL-terminated) of the n bytes at src: no ".",
// "..", empty components or trailing slash.
fn wasi_clean(src int, n int) int {
    out := alloc(n + 2)
    rt_store(out, 1, 47)
    $olen := 1
    $i := 0
    while i < n {
        while i < n && rt_load(src + i, 1) == 47 {
            i += 1
        }
        s := i
        while i < n && rt_load(src + i, 1) != 47 {
            i += 1
        }
        clen := i - s
        if clen == 0 || (clen == 1 && rt_load(src + s, 1) == 46) {
            ->
        }
        if clen == 2 && rt_load(src + s, 1) == 46 && rt_load(src + s + 1, 1) == 46 {
            $k := olen - 1
            while k > 0 && rt_load(out + k, 1) != 47 {
                k -= 1
            }
            olen = k
            if olen == 0 {
                olen = 1
            }
            ->
        }
        if olen > 1 {
            rt_store(out + olen, 1, 47)
            olen += 1
        }
        mem_copy(out + olen, src + s, clen)
        olen += clen
    }
    rt_store(out + olen, 1, 0)
    << out
}

// Cleaned base/rel: base is a cleaned absolute path.
fn wasi_join(base int, rel int, n int) int {
    bl := host_strlen(base)
    buf := alloc(bl + n + 2)
    mem_copy(buf, base, bl)
    rt_store(buf + bl, 1, 47)
    mem_copy(buf + bl + 1, rel, n)
    out := wasi_clean(buf, bl + 1 + n)
    free(buf)
    << out
}

// Preopen fd for the NUL-terminated path p, or -errno. Sets G_WASI_PPTR,
// G_WASI_PLEN and G_WASI_FULL.
fn wasi_resolve(p int) int {
    wasi_init()
    n := host_strlen(p)
    $full := 0
    if n > 0 && rt_load(p, 1) == 47 {
        full = wasi_clean(p, n)
    } else {
        full = wasi_join(gword(G_WASI_CWD), p, n)
    }
    flen := host_strlen(full)
    tab := gword(G_WASI_PRE)
    $best := -1
    $blen := -1
    for i in 0:gword(G_WASI_NPRE) {
        name := rt_load(tab + i * 16 + 8, 8)
        $nl := host_strlen(name)
        if nl == 1 {
            nl = 0
        }
        if nl > blen && nl <= flen && mem_eq(name, full, nl) && (nl == flen || rt_load(full + nl, 1) == 47) {
            best = rt_load(tab + i * 16, 8)
            blen = nl
        }
    }
    set_gword(G_WASI_FULL, full)
    if best < 0 {
        << -2
    }
    $rel := full + blen
    while rt_load(rel, 1) == 47 {
        rel += 1
    }
    if rt_load(rel, 1) == 0 {
        $dot := "."
        rel = host_cstr(rt_addr(&dot))
    }
    set_gword(G_WASI_PPTR, rel)
    set_gword(G_WASI_PLEN, host_strlen(rel))
    << best
}

// ===== directory read positions =====

// Record {fd, cookie, next} for fd, created at cookie 0.
fn wasi_dir_pos(fd int) int {
    $r := gword(G_WASI_DIRS)
    while r != 0 {
        if rt_load(r, 8) == fd {
            << r
        }
        r = rt_load(r + 16, 8)
    }
    rec := alloc(24)
    rt_store(rec, 8, fd)
    rt_store(rec + 16, 8, gword(G_WASI_DIRS))
    set_gword(G_WASI_DIRS, rec)
    << rec
}

fn wasi_dir_forget(fd int) {
    $r := gword(G_WASI_DIRS)
    while r != 0 {
        if rt_load(r, 8) == fd {
            rt_store(r + 8, 8, 0)
        }
        r = rt_load(r + 16, 8)
    }
}

// getdents64: Linux dirent64 records {ino, off, reclen u16, type u8, name}.
fn wasi_getdents(fd int, out int, size int) int {
    pos := wasi_dir_pos(fd)
    $cookie := rt_load(pos + 8, 8)
    tmp := alloc(4096)
    sc := wasi_scratch()
    e := wasi_call(WI_FD_READDIR, fd, tmp, 4096, cookie, sc, 0)
    if e != 0 {
        free(tmp)
        << wasi_res(e)
    }
    used := rt_load(sc, 4)
    $off := 0
    $w := 0
    while off + 24 <= used {
        nlen := rt_load(tmp + off + 16, 4)
        if off + 24 + nlen > used {
            <-
        }
        rec := (19 + nlen + 1 + 7) / 8 * 8
        if w + rec > size {
            <-
        }
        at := out + w
        mem_zero(at, rec)
        rt_store(at, 8, rt_load(tmp + off + 8, 8))
        rt_store(at + 8, 8, rt_load(tmp + off, 8))
        rt_store(at + 16, 1, rec & 255)
        rt_store(at + 17, 1, rec >> 8)
        rt_store(at + 18, 1, wasi_dtype(rt_load(tmp + off + 20, 1)))
        mem_copy(at + 19, tmp + off + 24, nlen)
        cookie = rt_load(tmp + off, 8)
        w += rec
        off += 24 + nlen
    }
    free(tmp)
    rt_store(pos + 8, 8, cookie)
    if w == 0 && off + 24 <= used {
        << -22
    }
    << w
}

fn wasi_dtype(t int) int {
    if t == 1 { << 6 }
    if t == 2 { << 2 }
    if t == 3 { << 4 }
    if t == 4 { << 8 }
    if t == 5 || t == 6 { << 12 }
    if t == 7 { << 10 }
    << 0
}

// ===== system call emulation =====

fn wasi_rw(k int, fd int, buf int, n int) int {
    sc := wasi_scratch()
    rt_store(sc, 4, buf)
    rt_store(sc + 4, 4, n)
    e := wasi_call(k, fd, sc, 1, sc + 8, 0, 0)
    if e != 0 {
        << wasi_res(e)
    }
    << rt_load(sc + 8, 4)
}

// openat(AT_FDCWD, path, flags): Linux generic (arm64) open flags.
fn wasi_open(path int, flags int) int {
    pfd := wasi_resolve(path)
    if pfd < 0 {
        << pfd
    }
    $of := 0
    if (flags & 64) != 0 { of = of | 1 }
    if (flags & 16384) != 0 { of = of | 2 }
    if (flags & 128) != 0 { of = of | 4 }
    if (flags & 512) != 0 { of = of | 8 }
    $look := 1
    if (flags & 32768) != 0 {
        look = 0
    }
    $fdf := 0
    if (flags & 1024) != 0 {
        fdf = 1
    }
    sc := wasi_scratch()
    // Ask for everything the directory can pass on.
    $rights := 0
    if wasi_call(WI_FD_FDSTAT_GET, pfd, sc, 0, 0, 0, 0) == 0 {
        rights = rt_load(sc + 16, 8)
    }
    // Hosts derive the open mode from the base rights: drop the write
    // rights (datasync, write, allocate, set size) for O_RDONLY and the
    // read rights (read, readdir) for O_WRONLY.
    $base := rights
    acc := flags & 3
    if acc == 0 {
        base = base & (0 - 1 - 1 - 64 - 256 - 4194304)
    } else if acc == 1 {
        base = base & (0 - 1 - 2 - 16384)
    }
    args := sc + 16
    rt_store(args, 8, pfd)
    rt_store(args + 8, 8, look)
    rt_store(args + 16, 8, gword(G_WASI_PPTR))
    rt_store(args + 24, 8, gword(G_WASI_PLEN))
    rt_store(args + 32, 8, of)
    rt_store(args + 40, 8, base)
    rt_store(args + 48, 8, rights)
    rt_store(args + 56, 8, fdf)
    rt_store(args + 64, 8, sc)
    e := rt_syscall(WASI_SLOT_BASE + 4096 + WI_PATH_OPEN, args, 0, 0, 0, 0, 0)
    if e != 0 {
        << wasi_res(e)
    }
    fd := rt_load(sc, 4)
    wasi_dir_forget(fd)
    << fd
}

// newfstatat into a Linux arm64 struct stat.
fn wasi_stat(path int, st int, flags int) int {
    pfd := wasi_resolve(path)
    if pfd < 0 {
        << pfd
    }
    $look := 1
    if (flags & 256) != 0 {
        look = 0
    }
    sc := wasi_scratch()
    e := wasi_call(WI_PATH_FILESTAT_GET, pfd, look, gword(G_WASI_PPTR), gword(G_WASI_PLEN), sc, 0)
    if e != 0 {
        << wasi_res(e)
    }
    ft := rt_load(sc + 16, 1)
    $mode := 33188
    if ft == 3 {
        mode = 16877
    } else if ft == 7 {
        mode = 41471
    } else if ft == 2 {
        mode = 8630
    } else if ft == 1 {
        mode = 25014
    }
    mem_zero(st, 128)
    rt_store(st, 8, rt_load(sc, 8))
    rt_store(st + 8, 8, rt_load(sc + 8, 8))
    rt_store(st + 16, 4, mode)
    rt_store(st + 20, 4, rt_load(sc + 24, 4))
    size := rt_load(sc + 32, 8)
    rt_store(st + 48, 8, size)
    rt_store(st + 56, 4, 4096)
    rt_store(st + 64, 8, (size + 511) / 512)
    for i in 0:3 {
        t := rt_load(sc + 40 + i * 8, 8)
        rt_store(st + 72 + i * 16, 8, t / 1000000000)
        rt_store(st + 80 + i * 16, 8, t % 1000000000)
    }
    << 0
}

fn wasi_is_dir(path int) bool {
    st := alloc(128)
    r := wasi_stat(path, st, 0)
    d := r == 0 && (rt_load(st + 16, 4) & 61440) == 16384
    free(st)
    << d
}

fn wasi_unlink(path int, flags int) int {
    pfd := wasi_resolve(path)
    if pfd < 0 {
        << pfd
    }
    $k := WI_PATH_UNLINK_FILE
    if (flags & 512) != 0 {
        k = WI_PATH_REMOVE_DIRECTORY
    }
    e := wasi_call(k, pfd, gword(G_WASI_PPTR), gword(G_WASI_PLEN), 0, 0, 0)
    if e != 0 && k == WI_PATH_UNLINK_FILE && wasi_is_dir(path) {
        << -21
    }
    << wasi_res(e)
}

fn wasi_rename(from int, to int) int {
    ofd := wasi_resolve(from)
    if ofd < 0 {
        << ofd
    }
    optr := gword(G_WASI_PPTR)
    olen := gword(G_WASI_PLEN)
    nfd := wasi_resolve(to)
    if nfd < 0 {
        << nfd
    }
    << wasi_res(wasi_call(WI_PATH_RENAME, ofd, optr, olen, nfd, gword(G_WASI_PPTR), gword(G_WASI_PLEN)))
}

fn wasi_getcwd(buf int, size int) int {
    wasi_init()
    cwd := gword(G_WASI_CWD)
    n := host_strlen(cwd)
    if n + 1 > size {
        << -34
    }
    mem_copy(buf, cwd, n + 1)
    << n + 1
}

fn wasi_chdir(path int) int {
    st := alloc(128)
    r := wasi_stat(path, st, 0)
    if r < 0 {
        free(st)
        << r
    }
    is_dir := (rt_load(st + 16, 4) & 61440) == 16384
    free(st)
    if !is_dir {
        << -20
    }
    set_gword(G_WASI_CWD, gword(G_WASI_FULL))
    << 0
}

fn wasi_clock(clk int, ts int) int {
    sc := wasi_scratch()
    e := wasi_call(WI_CLOCK_TIME_GET, clk, 1, sc, 0, 0, 0)
    if e != 0 {
        << wasi_res(e)
    }
    t := rt_load(sc, 8)
    rt_store(ts, 8, t / 1000000000)
    rt_store(ts + 8, 8, t % 1000000000)
    << 0
}

// One relative CLOCK_MONOTONIC subscription.
fn wasi_nanosleep(req int) int {
    ns := rt_load(req, 8) * 1000000000 + rt_load(req + 8, 8)
    sc := wasi_scratch()
    mem_zero(sc, 128)
    rt_store(sc + 16, 4, 1)
    rt_store(sc + 24, 8, ns)
    << wasi_res(wasi_call(WI_POLL_ONEOFF, sc, sc + 64, 1, sc + 112, 0, 0))
}

// ppoll: every descriptor reports the requested read/write readiness.
fn wasi_ppoll(pfd int, n int) int {
    $ready := 0
    for i in 0:n {
        ev := rt_load(pfd + i * 8 + 4, 1) & 5
        rt_store(pfd + i * 8 + 6, 1, ev)
        rt_store(pfd + i * 8 + 7, 1, 0)
        if ev != 0 {
            ready += 1
        }
    }
    << ready
}

fn wasi_uname(buf int) int {
    mem_zero(buf, 65 * 6)
    $sys := "wasi"
    mem_copy(buf, desc_ptr(rt_addr(&sys)), sys.len)
    $node := "localhost"
    mem_copy(buf + 65, desc_ptr(rt_addr(&node)), node.len)
    << 0
}

// Linux generic system call nr on WASI; called by the backend's stub.
pub fn wasi_sys(nr int, a int, b int, c int, d int, e int, f int) int {
    if nr == 222 {
        << rt_syscall(-7, b, 0, 0, 0, 0, 0)
    }
    if nr == 215 || nr == 32 {
        << 0
    }
    if nr == 64 {
        << wasi_rw(WI_FD_WRITE, a, b, c)
    }
    if nr == 63 {
        << wasi_rw(WI_FD_READ, a, b, c)
    }
    if nr == 93 || nr == 94 {
        wasi_call(WI_PROC_EXIT, a, 0, 0, 0, 0, 0)
        << 0
    }
    if nr == 57 {
        wasi_dir_forget(a)
        << wasi_res(wasi_call(WI_FD_CLOSE, a, 0, 0, 0, 0, 0))
    }
    if nr == 62 {
        sc := wasi_scratch()
        r := wasi_call(WI_FD_SEEK, a, b, c, sc, 0, 0)
        if r != 0 {
            << wasi_res(r)
        }
        << rt_load(sc, 8)
    }
    if nr == 56 {
        << wasi_open(b, c)
    }
    if nr == 61 {
        << wasi_getdents(a, b, c)
    }
    if nr == 79 {
        << wasi_stat(b, c, d)
    }
    // fchmodat: WASI has no permission bits; succeed when the path exists.
    if nr == 53 {
        st := alloc(128)
        r := wasi_stat(b, st, 0)
        free(st)
        << r
    }
    if nr == 34 {
        pfd := wasi_resolve(b)
        if pfd < 0 {
            << pfd
        }
        << wasi_res(wasi_call(WI_PATH_CREATE_DIRECTORY, pfd, gword(G_WASI_PPTR), gword(G_WASI_PLEN), 0, 0, 0))
    }
    if nr == 35 {
        << wasi_unlink(b, c)
    }
    if nr == 38 {
        << wasi_rename(b, d)
    }
    if nr == 36 {
        pfd := wasi_resolve(c)
        if pfd < 0 {
            << pfd
        }
        << wasi_res(wasi_call(WI_PATH_SYMLINK, a, host_strlen(a), pfd, gword(G_WASI_PPTR), gword(G_WASI_PLEN), 0))
    }
    if nr == 78 {
        pfd := wasi_resolve(b)
        if pfd < 0 {
            << pfd
        }
        sc := wasi_scratch()
        r := wasi_call(WI_PATH_READLINK, pfd, gword(G_WASI_PPTR), gword(G_WASI_PLEN), c, d, sc)
        if r != 0 {
            << wasi_res(r)
        }
        << rt_load(sc, 4)
    }
    if nr == 17 {
        << wasi_getcwd(a, b)
    }
    if nr == 49 {
        << wasi_chdir(a)
    }
    if nr == 113 {
        << wasi_clock(a, b)
    }
    if nr == 101 {
        << wasi_nanosleep(a)
    }
    if nr == 73 {
        << wasi_ppoll(a, b)
    }
    if nr == 278 {
        r := wasi_call(WI_RANDOM_GET, a, b, 0, 0, 0, 0)
        if r != 0 {
            << wasi_res(r)
        }
        << b
    }
    if nr == 160 {
        << wasi_uname(a)
    }
    if nr == 172 {
        << 1
    }
    if nr >= 173 && nr <= 177 {
        << 0
    }
    << -38
}
