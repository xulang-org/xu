@runtime/core

// String, array, assert and atomic builtins (see xu/mir/lower_intrin.xu).
// String and array arguments are descriptor addresses; string and array
// results are written through a leading out descriptor.

fn intrin_fatal(msg string) {
    write_fd(2, str_ptr(&msg), msg.len)
    exit_process(1)
}

// make_string(n): n zero bytes; n == 0 is the empty descriptor.
pub fn intrin_make_string(out int, n int) {
    if n < 0 || n > 9223372036854775807 - 16400 {
        intrin_fatal("make_string: invalid length\n")
    }
    if n == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    set_desc(out, alloc(n + 1), n, n)
}

// make_ints(n): n zero ints.
pub fn intrin_make_ints(out int, n int) {
    if n < 0 || n > (9223372036854775807 - 16399) / 8 {
        intrin_fatal("make_ints: invalid length\n")
    }
    if n == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    set_desc(out, alloc(n * 8), n, n)
}

const BYTE_LANES = 0x0101010101010101

// One low bit per matching byte. Masking before addition prevents carries
// between lanes, including where equal and differing bytes are adjacent.
fn byte_match_lanes(word int, pattern int) int {
    mask := 0x7f7f7f7f7f7f7f7f
    x := word ^ pattern
    high := ((x & mask) + mask) | x
    << ((high >> 7) & BYTE_LANES) ^ BYTE_LANES
}

pub fn intrin_count_byte(s int, b int) int {
    p := desc_ptr(s)
    n := desc_len(s)
    if n == 0 { << 0 }
    want := b & 255
    $c := 0
    if n >= 8 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
        $i := 0
        pattern := want * BYTE_LANES
        while i + 16 <= n {
            l1 := byte_match_lanes(rt_load(p + i, 8), pattern)
            l2 := byte_match_lanes(rt_load(p + i + 8, 8), pattern)
            both := l1 | l2
            if both != 0 {
                if l1 != 0 {
                    c += ((l1 * BYTE_LANES) >> 56) & 255
                }
                if l2 != 0 {
                    c += ((l2 * BYTE_LANES) >> 56) & 255
                }
            }
            i += 16
        }
        if i + 8 <= n {
            l := byte_match_lanes(rt_load(p + i, 8), pattern)
            if l != 0 {
                c += ((l * BYTE_LANES) >> 56) & 255
            }
            i += 8
        }
        if i < n {
            // The final 8-byte load overlaps earlier input. Drop the
            // already-counted lanes before summing the trailing bytes.
            l := byte_match_lanes(rt_load(p + n - 8, 8), pattern)
            if l != 0 {
                tail := l >> ((8 - (n - i)) * 8)
                c += ((tail * BYTE_LANES) >> 56) & 255
            }
        }
        << c
    }
    for i in 0:n {
        if rt_load(p + i, 1) == want { c += 1 }
    }
    << c
}

// Index of the first byte b at or after from, or -1.
pub fn intrin_find_byte(s int, b int, from int) int {
    if from < 0 { << -1 }
    << find_byte_from(desc_ptr(s), desc_len(s), b & 255, from)
}

fn intrin_trailing_zeros(x int) int {
    if x == 0 { << 64 }
    $n := 0
    $v := x
    if (v & 0xffffffff) == 0 {
        n = n + 32
        v = v >> 32
    }
    if (v & 0xffff) == 0 {
        n = n + 16
        v = v >> 16
    }
    if (v & 0xff) == 0 {
        n = n + 8
        v = v >> 8
    }
    if (v & 0xf) == 0 {
        n = n + 4
        v = v >> 4
    }
    if (v & 0x3) == 0 {
        n = n + 2
        v = v >> 2
    }
    if (v & 0x1) == 0 {
        n = n + 1
    }
    << n
}

fn intrin_first_msb_byte(hits int) int {
    m := (hits >> 7) & BYTE_LANES
    lsb := m & (0 - m)
    << (((lsb - 1) & BYTE_LANES) * BYTE_LANES) >> 56
}

fn find_byte_from(p int, n int, want int, from int) int {
    $i := from
    if n - i >= 8 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
        ones := 0x0101010101010101
        pattern := want * ones
        while i <= n - 8 {
            x := rt_load(p + i, 8) ^ pattern
            // Borrow propagates toward higher lanes, so the first set
            // high bit corresponds to the first matching byte.
            hits := (x - ones) & (x ^ (0 - 1)) & (ones << 7)
            if hits != 0 { << i + intrin_first_msb_byte(hits) }
            i += 8
        }
    }
    while i < n {
        if rt_load(p + i, 1) == want {
            << i
        }
        i += 1
    }
    << -1
}

// Return an owned copy with every occurrence of old_byte replaced.
pub fn string_replace_byte(src &string, old_byte int, new_byte int) string {
    n := src.len
    if n == 0 { << "" }
    p := str_ptr(src)
    buf := alloc_unzeroed(n + 1)
    old := old_byte & 255
    new := new_byte & 255
    $i := 0
    if n >= 32 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
        from := old * BYTE_LANES
        to := new * BYTE_LANES
        word_end := n & (0 - 8)
        while i < word_end {
            word := rt_load(p + i, 8)
            matches := byte_match_lanes(word, from) * 255
            rt_store(buf + i, 8, word ^ ((word ^ to) & matches))
            i += 8
        }
    }
    while i < n {
        c := rt_load(p + i, 1)
        if c == old {
            rt_store(buf + i, 1, new)
        } else {
            rt_store(buf + i, 1, c)
        }
        i += 1
    }
    rt_store(buf + n, 1, 0)
    $out := ""
    set_desc(rt_addr($&out), buf, n, n)
    << out
}

fn split_emit_fragment(arr int, k int, p int, start int, flen int, g int) {
    dst := arr + k * 24
    if flen == 0 {
        set_desc(dst, 0, 0, 0)
        <<
    }
    if flen <= 63 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
        $c := flen >> 4
        if c > 2 { c = 2 }
        buf := alloc_small_raw(c)
        copy_short_bytes(buf, p + start, flen)
        rt_store(buf + flen, 1, 0)
        set_desc(dst, buf, flen, flen)
        <<
    }
    bytes_new(dst, p + start, flen)
}

// split_byte(s, b): the pieces between occurrences of b; "" gives [""].
pub fn intrin_split_byte(out int, s int, b int) {
    p := desc_ptr(s)
    n := desc_len(s)
    want := b & 255
    cnt := intrin_count_byte(s, want)
    if cnt < 0 || cnt >= (9223372036854775807 - 16399) / 24 {
        intrin_fatal("split_byte: length overflow\n")
    }
    parts := cnt + 1
    arr := alloc_unzeroed(parts * 24)
    if cnt == 0 {
        bytes_new(arr, p, n)
        set_desc(out, arr, 1, 1)
        <<
    }
    g := rt_globals()
    $start := 0
    $k := 0
    $i := 0
    if n >= 8 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
        ones := 0x0101010101010101
        pattern := want * ones
        while i <= n - 8 && k < parts - 1 {
            $m := byte_match_lanes(rt_load(p + i, 8), pattern)
            while m != 0 && k < parts - 1 {
                lsb := m & (0 - m)
                tz := (((lsb - 1) & ones) * ones) >> 56
                match_pos := i + tz
                split_emit_fragment(arr, k, p, start, match_pos - start, g)
                start = match_pos + 1
                k += 1
                m = m & (m - 1)
            }
            i += 8
        }
    }
    while i < n && k < parts - 1 {
        if rt_load(p + i, 1) == want {
            split_emit_fragment(arr, k, p, start, i - start, g)
            start = i + 1
            k += 1
        }
        i += 1
    }
    split_emit_fragment(arr, parts - 1, p, start, n - start, g)
    set_desc(out, arr, parts, parts)
}

// join_strings(parts, sep).
pub fn intrin_join_strings(out int, arr int, sep int) {
    cnt := desc_len(arr)
    if cnt == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    elems := desc_ptr(arr)
    slen := desc_len(sep)
    sptr := desc_ptr(sep)
    $separator := 0
    if slen == 1 { separator = rt_load(sptr, 1) & 255 }
    max_s := 9223372036854775807 - 16400
    if cnt < 0 || slen < 0 || slen > max_s {
        intrin_fatal("join_strings: length overflow\n")
    }
    if cnt > 1 {
        gaps := cnt - 1
        if gaps == 0 {
            intrin_fatal("join_strings: length overflow\n")
            <<
        }
        if gaps < 0 || slen > max_s / gaps {
            intrin_fatal("join_strings: length overflow\n")
        }
    }
    $total := slen * (cnt - 1)
    $ep := elems
    for i in 0:cnt {
        el := desc_len(ep)
        if el < 0 || el > max_s - total {
            intrin_fatal("join_strings: length overflow\n")
        }
        total += el
        ep += 24
    }
    if total == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    buf := alloc_unzeroed(total + 1)
    $pos := 0
    if slen == 1 {
        $ep1 := elems
        el0 := desc_len(ep1)
        if el0 > 0 {
            src0 := desc_ptr(ep1)
            if el0 <= 64 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
                copy_short_bytes(buf, src0, el0)
            } else {
                mem_copy(buf, src0, el0)
            }
            pos = el0
        }
        ep1 += 24
        for i in 1:cnt {
            rt_store(buf + pos, 1, separator)
            pos += 1
            el := desc_len(ep1)
            if el > 0 {
                src := desc_ptr(ep1)
                if el <= 64 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
                    copy_short_bytes(buf + pos, src, el)
                } else {
                    mem_copy(buf + pos, src, el)
                }
                pos += el
            }
            ep1 += 24
        }
    } else {
        $ep2 := elems
        for i in 0:cnt {
            if i > 0 && slen > 0 {
                mem_copy(buf + pos, sptr, slen)
                pos += slen
            }
            el := desc_len(ep2)
            if el > 0 {
                src := desc_ptr(ep2)
                if el <= 64 && (xu_target_arch() == ARCH_ARM64 || xu_target_arch() == ARCH_X64) {
                    copy_short_bytes(buf + pos, src, el)
                } else {
                    mem_copy(buf + pos, src, el)
                }
                pos += el
            }
            ep2 += 24
        }
    }
    rt_store(buf + total, 1, 0)
    set_desc(out, buf, total, total)
}

pub fn intrin_str_bool(out int, b bool) {
    if b {
        s := "true"
        mem_copy(out, rt_addr(&s), 24)
    } else {
        s := "false"
        mem_copy(out, rt_addr(&s), 24)
    }
}

// "<file>:<line>:<col>: assertion failed[: msg]" on stderr, exit status 1.
// msg is a string descriptor address or 0.
pub fn intrin_assert_fail(file int, line int, col int, msg int) {
    sep := ":"
    if desc_len(file) > 0 {
        print_desc(2, file, false)
        print_desc(2, rt_addr(&sep), false)
    }
    print_int(2, line, false)
    print_desc(2, rt_addr(&sep), false)
    print_int(2, col, false)
    text := ": assertion failed"
    print_desc(2, rt_addr(&text), false)
    if msg != 0 && desc_len(msg) > 0 {
        colon := ": "
        print_desc(2, rt_addr(&colon), false)
        print_desc(2, msg, false)
    }
    nl := ""
    print_desc(2, rt_addr(&nl), true)
    exit_process(1)
}

// Tasks are cooperative on one thread, so plain memory accesses are atomic.
pub fn intrin_atomic_add(p int, d int) int {
    old := rt_load(p, 8)
    rt_store(p, 8, old + d)
    << old
}

pub fn intrin_atomic_cas(p int, old int, new int) bool {
    if rt_load(p, 8) != old {
        << false
    }
    rt_store(p, 8, new)
    << true
}

// Unsigned 64-bit division of the bit patterns a / b (b != 0), for u64.
pub fn u64_div(a int, b int) int {
    if b == 0 { << 0 }
    min := -9223372036854775807 - 1
    if b < 0 {
        if (a ^ min) < (b ^ min) { << 0 }
        << 1
    }
    if a >= 0 { << a / b }
    $q := (((a >> 1) & 9223372036854775807) / b) << 1
    r := a - q * b
    if (r ^ min) >= (b ^ min) { q += 1 }
    << q
}

pub fn print_u64(fd int, v int, newline bool) {
    if v >= 0 {
        print_int(fd, v, newline)
        <<
    }
    q := u64_div(v, 10)
    print_int(fd, q, false)
    print_int(fd, v - q * 10, newline)
}
