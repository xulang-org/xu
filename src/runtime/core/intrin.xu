@runtime/core
// String, array, assert and atomic builtins (see xu/mir/lower_intrin.xu).
// String and array arguments are descriptor addresses; string and array
// results are written through a leading out descriptor.

fn intrin_fatal(msg string) {
    write_fd(2, str_ptr(&msg), msg.len)
    exit_process(1)
}

// make_string(n): n zero bytes; n == 0 is the empty descriptor.
pub fn intrin_make_string(out int, n int) {
    if n < 0 {
        intrin_fatal("make_string: invalid length\n")
    }
    if n == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    set_desc(out, alloc(n + 1), n, n)
}

// make_ints(n): n zero ints.
pub fn intrin_make_ints(out int, n int) {
    if n < 0 || n > 1152921504606846975 {
        intrin_fatal("make_ints: invalid length\n")
    }
    if n == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    set_desc(out, alloc(n * 8), n, n)
}

pub fn intrin_count_byte(s int, b int) int {
    p := desc_ptr(s)
    n := desc_len(s)
    want := b & 255
    $c := 0
    for i in 0:n {
        if rt_load(p + i, 1) == want {
            c += 1
        }
    }
    << c
}

// Index of the first byte b at or after from, or -1.
pub fn intrin_find_byte(s int, b int, from int) int {
    p := desc_ptr(s)
    n := desc_len(s)
    if from < 0 {
        << -1
    }
    want := b & 255
    $i := from
    while i < n {
        if rt_load(p + i, 1) == want {
            << i
        }
        i += 1
    }
    << -1
}

// split_byte(s, b): the pieces between occurrences of b; "" gives [""].
pub fn intrin_split_byte(out int, s int, b int) {
    p := desc_ptr(s)
    n := desc_len(s)
    want := b & 255
    parts := intrin_count_byte(s, b) + 1
    arr := alloc(parts * 24)
    set_desc(out, arr, 0, parts)
    $start := 0
    $k := 0
    for i in 0:n {
        if rt_load(p + i, 1) == want {
            bytes_new(arr + k * 24, p + start, i - start)
            k += 1
            start = i + 1
        }
    }
    bytes_new(arr + k * 24, p + start, n - start)
    rt_store(out + 8, 8, parts)
}

// join_strings(parts, sep).
pub fn intrin_join_strings(out int, arr int, sep int) {
    cnt := desc_len(arr)
    if cnt == 0 {
        set_desc(out, 0, 0, 0)
        <<
    }
    elems := desc_ptr(arr)
    slen := desc_len(sep)
    $total := slen * (cnt - 1)
    for i in 0:cnt {
        total += desc_len(elems + i * 24)
    }
    buf := alloc(total + 1)
    $pos := 0
    for i in 0:cnt {
        if i > 0 && slen > 0 {
            mem_copy(buf + pos, desc_ptr(sep), slen)
            pos += slen
        }
        e := elems + i * 24
        el := desc_len(e)
        if el > 0 {
            mem_copy(buf + pos, desc_ptr(e), el)
            pos += el
        }
    }
    set_desc(out, buf, total, total)
}

pub fn intrin_str_bool(out int, b bool) {
    if b {
        s := "true"
        mem_copy(out, rt_addr(&s), 24)
    } else {
        s := "false"
        mem_copy(out, rt_addr(&s), 24)
    }
}

// "<file>:<line>:<col>: assertion failed[: msg]" on stderr, exit status 1.
// msg is a string descriptor address or 0.
pub fn intrin_assert_fail(file int, line int, col int, msg int) {
    sep := ":"
    if desc_len(file) > 0 {
        print_desc(2, file, false)
        print_desc(2, rt_addr(&sep), false)
    }
    print_int(2, line, false)
    print_desc(2, rt_addr(&sep), false)
    print_int(2, col, false)
    text := ": assertion failed"
    print_desc(2, rt_addr(&text), false)
    if msg != 0 && desc_len(msg) > 0 {
        colon := ": "
        print_desc(2, rt_addr(&colon), false)
        print_desc(2, msg, false)
    }
    nl := ""
    print_desc(2, rt_addr(&nl), true)
    exit_process(1)
}

// Tasks are cooperative on one thread, so plain memory accesses are atomic.
pub fn intrin_atomic_add(p int, d int) int {
    old := rt_load(p, 8)
    rt_store(p, 8, old + d)
    << old
}

pub fn intrin_atomic_cas(p int, old int, new int) bool {
    if rt_load(p, 8) != old {
        << false
    }
    rt_store(p, 8, new)
    << true
}
