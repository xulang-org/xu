@runtime/core
// Error values for hosted builtins. See the error/interface contract in
// xu/mir/lower.xu: an error word is 0 (success) or an interface box
// [type id word][concrete value].

// Box type id of runtime-made errors. The payload is laid out like
// errors.StrErr {text string}; must match ERR_STR_TAG in xu/mir/lower_err.xu.
const ERR_STR_TAG = 2147483647

// Error word carrying a copy of message msg.
pub fn err_from_str(msg &string) int {
    box := alloc(32)
    rt_store(box, 8, ERR_STR_TAG)
    d := rt_addr(msg)
    bytes_new(box + 8, desc_ptr(d), desc_len(d))
    << box
}

// out = msg() of a runtime-made error box.
pub fn err_msg_copy(out int, box int) {
    bytes_new(out, desc_ptr(box + 8), desc_len(box + 8))
}

// A struct@ value whose type id matches no lowered method dispatch case.
pub fn iface_tag_panic(tag int) {
    msg := "panic: interface value has unexpected type id "
    print_desc(2, rt_addr(&msg), false)
    print_int(2, tag, true)
    exit_process(2)
}
