@runtime/core
// Windows host layer: the POSIX-shaped primitives of host.xu on kernel32.
//
// Descriptors are Windows handles, except 0, 1 and 2, which name the
// standard handles. Failures return -errno with Linux numbering (see
// win_errno). BOOL and DWORD results only define the low 32 bits of the
// result word.

// rt_syscall number of IAT slot 0 (xu/codegen x64_win.xu WIN_SLOT_BASE).
const WIN_SLOT_BASE = 65536

// IAT slots, in the order of xu/codegen x64_win.xu win_import_names.
const W_EXIT_PROCESS = 0
const W_GET_STD_HANDLE = 1
const W_WRITE_FILE = 2
const W_READ_FILE = 3
const W_VIRTUAL_ALLOC = 4
const W_VIRTUAL_FREE = 5
const W_GET_LAST_ERROR = 6
const W_GET_COMMAND_LINE = 7
const W_GET_ENVIRONMENT_STRINGS = 8
const W_CREATE_FILE = 9
const W_CLOSE_HANDLE = 10
const W_SET_FILE_POINTER_EX = 11
const W_GET_FILE_ATTRIBUTES_EX = 12
const W_CREATE_DIRECTORY = 13
const W_REMOVE_DIRECTORY = 14
const W_DELETE_FILE = 15
const W_MOVE_FILE_EX = 16
const W_FIND_FIRST_FILE = 17
const W_FIND_NEXT_FILE = 18
const W_FIND_CLOSE = 19
const W_GET_CURRENT_DIRECTORY = 20
const W_SET_CURRENT_DIRECTORY = 21
const W_QUERY_PERF_COUNTER = 22
const W_QUERY_PERF_FREQUENCY = 23
const W_GET_SYSTEM_TIME_AS_FILE_TIME = 24
const W_SLEEP = 25
const W_GET_CURRENT_PROCESS_ID = 26
const W_GET_COMPUTER_NAME = 27
const W_CREATE_PIPE = 28
const W_PEEK_NAMED_PIPE = 29
const W_GET_FILE_TYPE = 30
const W_CREATE_PROCESS = 31
const W_WAIT_FOR_SINGLE_OBJECT = 32
const W_GET_EXIT_CODE_PROCESS = 33
const W_TERMINATE_PROCESS = 34
const W_SET_HANDLE_INFORMATION = 35
const W_SET_FILE_ATTRIBUTES = 36
const W_CREATE_SYMBOLIC_LINK = 37
const W_GET_FILE_SIZE_EX = 38
const W_LOCK_FILE_EX = 39
const W_LOAD_LIBRARY = 40
const W_GET_PROC_ADDRESS = 41

const WIN_INVALID_HANDLE = -1

fn host_win() bool {
    << os_code() == OS_WINDOWS
}

fn win_call(slot int, a int, b int, c int, d int, e int, f int) int {
    << rt_syscall(WIN_SLOT_BASE + slot, a, b, c, d, e, f)
}

// Call with up to 12 arguments from the word array at args.
fn win_callv(slot int, args int) int {
    << rt_syscall(WIN_SLOT_BASE + 4096 + slot, args, 0, 0, 0, 0, 0)
}

fn win_ok(r int) bool {
    << (r & 4294967295) != 0
}

// Scratch word for out parameters; tasks never switch inside a call.
fn win_io() int {
    rt_store(rt_globals() + G_WIN_IO * 8, 8, 0)
    << rt_globals() + G_WIN_IO * 8
}

fn win_io_value() int {
    << rt_load(rt_globals() + G_WIN_IO * 8, 8)
}

// GetLastError as a Linux errno.
fn win_errno() int {
    e := win_call(W_GET_LAST_ERROR, 0, 0, 0, 0, 0, 0) & 4294967295
    if e == 2 || e == 3 || e == 123 || e == 161 { << 2 }
    if e == 5 { << 13 }
    if e == 6 { << 9 }
    if e == 8 || e == 14 { << 12 }
    if e == 32 || e == 33 { << 11 }
    if e == 80 || e == 183 { << 17 }
    if e == 87 { << 22 }
    if e == 109 || e == 232 { << 32 }
    if e == 112 { << 28 }
    if e == 145 { << 39 }
    if e == 267 { << 20 }
    if e == 50 || e == 120 { << 38 }
    << 1000 + e
}

fn win_fail() int {
    << 0 - win_errno()
}

fn win_handle(fd int) int {
    if fd >= 0 && fd <= 2 {
        << win_call(W_GET_STD_HANDLE, -10 - fd, 0, 0, 0, 0, 0)
    }
    << fd
}

fn win_clamp(n int) int {
    if n > 1073741824 { << 1073741824 }
    << n
}

fn win_write(fd int, p int, n int) int {
    if win_is_sock(fd) {
        << win_send(fd, p, n)
    }
    io := win_io()
    if !win_ok(win_call(W_WRITE_FILE, win_handle(fd), p, win_clamp(n), io, 0, 0)) {
        << win_fail()
    }
    << win_io_value() & 4294967295
}

// End of file and a closed pipe both read as 0 bytes.
fn win_read(fd int, p int, n int) int {
    if win_is_sock(fd) {
        << win_recv(fd, p, n)
    }
    io := win_io()
    if !win_ok(win_call(W_READ_FILE, win_handle(fd), p, win_clamp(n), io, 0, 0)) {
        e := win_call(W_GET_LAST_ERROR, 0, 0, 0, 0, 0, 0) & 4294967295
        if e == 109 || e == 38 {
            << 0
        }
        << 0 - win_errno_of(e)
    }
    << win_io_value() & 4294967295
}

fn win_errno_of(e int) int {
    if e == 5 { << 13 }
    if e == 6 { << 9 }
    if e == 1 || e == 87 { << 22 }
    << 1000 + e
}

// open(2) on CreateFileA; flags use the Linux numbering (O_WRONLY 1,
// O_RDWR 2, O_CREAT 64, O_EXCL 128, O_TRUNC 512, O_APPEND 1024).
fn win_open(path int, flags int) int {
    acc := flags & 3
    $access := 0x80000000
    if acc == 1 {
        access = 0x40000000
    } else if acc == 2 {
        access = 0xC0000000
    }
    if (flags & 1024) != 0 {
        // FILE_APPEND_DATA | SYNCHRONIZE keeps every write at the end.
        access = (access & 0x80000000) | 4 | 0x100000
    }
    creat := (flags & 64) != 0
    trunc := (flags & 512) != 0
    $disp := 3
    if creat && (flags & 128) != 0 {
        disp = 1
    } else if creat && trunc {
        disp = 2
    } else if creat {
        disp = 4
    } else if trunc {
        disp = 5
    }
    args := alloc(96)
    rt_store(args, 8, path)
    rt_store(args + 8, 8, access)
    // FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE
    rt_store(args + 16, 8, 7)
    rt_store(args + 32, 8, disp)
    // FILE_ATTRIBUTE_NORMAL | FILE_FLAG_BACKUP_SEMANTICS (directories)
    rt_store(args + 40, 8, 0x80 | 0x02000000)
    h := win_callv(W_CREATE_FILE, args)
    free(args)
    if h == WIN_INVALID_HANDLE {
        << win_fail()
    }
    << h
}

fn win_close(fd int) int {
    if win_is_sock(fd) {
        << win_closesocket(fd)
    }
    if !win_ok(win_call(W_CLOSE_HANDLE, win_handle(fd), 0, 0, 0, 0, 0)) {
        << win_fail()
    }
    << 0
}

fn win_lseek(fd int, off int, whence int) int {
    io := win_io()
    if !win_ok(win_call(W_SET_FILE_POINTER_EX, win_handle(fd), off, io, whence, 0, 0)) {
        << win_fail()
    }
    << win_io_value()
}

// Exclusive, non-blocking lock of the whole file.
fn win_lock(fd int) int {
    ov := alloc(32)
    // LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY
    r := win_call(W_LOCK_FILE_EX, fd, 3, 0, 4294967295, 4294967295, ov)
    free(ov)
    if !win_ok(r) {
        << win_fail()
    }
    << 0
}

// Builds argc/argv from GetCommandLineA (Microsoft quoting rules) and envp
// from GetEnvironmentStringsA on first use.
fn win_init_args() {
    if host_wasi() {
        wasi_init_args()
        <<
    }
    if !host_win() || gword(G_ARGV) != 0 {
        <<
    }
    env := win_call(W_GET_ENVIRONMENT_STRINGS, 0, 0, 0, 0, 0, 0)
    $cnt := 0
    $p := env
    while env != 0 && rt_load(p, 1) != 0 {
        cnt += 1
        p += host_strlen(p) + 1
    }
    envp := alloc((cnt + 1) * 8)
    $k := 0
    p = env
    while env != 0 && rt_load(p, 1) != 0 {
        // Entries like "=C:=C:\dir" are per-drive directories, not variables.
        if rt_load(p, 1) != 61 {
            rt_store(envp + k * 8, 8, p)
            k += 1
        }
        p += host_strlen(p) + 1
    }
    set_gword(G_ENVP, envp)

    cl := win_call(W_GET_COMMAND_LINE, 0, 0, 0, 0, 0, 0)
    n := host_strlen(cl)
    argv := alloc((n / 2 + 2) * 8)
    buf := alloc(n + 2)
    $argc := 0
    $i := 0
    $o := 0
    while true {
        while i < n && (rt_load(cl + i, 1) == 32 || rt_load(cl + i, 1) == 9) {
            i += 1
        }
        if i >= n {
            <-
        }
        rt_store(argv + argc * 8, 8, buf + o)
        argc += 1
        $quoted := false
        while i < n {
            c := rt_load(cl + i, 1)
            if !quoted && (c == 32 || c == 9) {
                <-
            }
            if c == 92 {
                $nb := 0
                while i < n && rt_load(cl + i, 1) == 92 {
                    nb += 1
                    i += 1
                }
                $lit := nb
                if i < n && rt_load(cl + i, 1) == 34 {
                    lit = nb / 2
                }
                for j in 0:lit {
                    rt_store(buf + o, 1, 92)
                    o += 1
                }
                if i < n && rt_load(cl + i, 1) == 34 && nb % 2 == 1 {
                    rt_store(buf + o, 1, 34)
                    o += 1
                    i += 1
                }
                ->
            }
            if c == 34 {
                if quoted && i + 1 < n && rt_load(cl + i + 1, 1) == 34 {
                    rt_store(buf + o, 1, 34)
                    o += 1
                    i += 2
                    ->
                }
                quoted = !quoted
                i += 1
                ->
            }
            rt_store(buf + o, 1, c)
            o += 1
            i += 1
        }
        rt_store(buf + o, 1, 0)
        o += 1
    }
    set_gword(G_ARGC, argc)
    set_gword(G_ARGV, argv)
}

fn win_now_wall() int {
    io := win_io()
    win_call(W_GET_SYSTEM_TIME_AS_FILE_TIME, io, 0, 0, 0, 0, 0)
    // 100ns ticks since 1601-01-01.
    << (win_io_value() - 116444736000000000) * 100
}

fn win_now_ns() int {
    io := win_io()
    win_call(W_QUERY_PERF_FREQUENCY, io, 0, 0, 0, 0, 0)
    $f := win_io_value()
    if f <= 0 {
        f = 1
    }
    win_call(W_QUERY_PERF_COUNTER, win_io(), 0, 0, 0, 0, 0)
    c := win_io_value()
    << (c / f) * 1000000000 + (c % f) * 1000000000 / f
}

fn win_sleep(ns int) {
    win_call(W_SLEEP, (ns + 999999) / 1000000, 0, 0, 0, 0, 0)
}

// poll(2) for one descriptor. Only pipes can be not ready for reading;
// writes never wait.
fn win_poll(fd int, events int, timeout_ms int) int {
    if win_is_sock(fd) {
        << win_sock_poll(fd, events, timeout_ms)
    }
    if (events & 1) == 0 {
        << events & 4
    }
    h := win_handle(fd)
    // FILE_TYPE_PIPE
    if (win_call(W_GET_FILE_TYPE, h, 0, 0, 0, 0, 0) & 4294967295) != 3 {
        << 1
    }
    $waited := 0
    while true {
        io := win_io()
        if !win_ok(win_call(W_PEEK_NAMED_PIPE, h, 0, 0, 0, io, 0)) {
            // Closed write end: readable (EOF) and hung up.
            << 1 | 16
        }
        if (win_io_value() & 4294967295) > 0 {
            << 1
        }
        if timeout_ms >= 0 && waited >= timeout_ms {
            << 0
        }
        win_call(W_SLEEP, 1, 0, 0, 0, 0, 0)
        waited += 1
    }
    << 0
}

// FileInfo{size, is_dir, mode} at out, from GetFileAttributesExA.
fn win_stat(out int, path int) int {
    data := alloc(40)
    if !win_ok(win_call(W_GET_FILE_ATTRIBUTES_EX, host_cstr(path), 0, data, 0, 0, 0)) {
        << host_err("stat", path, win_errno())
    }
    attr := rt_load(data, 4)
    size := (rt_load(data + 28, 4) << 32) | rt_load(data + 32, 4)
    $mode := 33188
    $is_dir := 0
    if (attr & 16) != 0 {
        mode = 16877
        is_dir = 1
    } else if (attr & 1) != 0 {
        mode = 33060
    }
    rt_store(out, 8, size)
    rt_store(out + 8, 8, is_dir)
    rt_store(out + 16, 8, mode)
    << 0
}

fn win_read_dir(out int, path int) int {
    $pat := host_string_at(path)
    if pat.len > 0 && pat[pat.len - 1] != 47 && pat[pat.len - 1] != 92 {
        pat.push_byte(92)
    }
    pat.push_byte(42)
    // WIN32_FIND_DATAA; cFileName at 44.
    fd := alloc(336)
    h := win_call(W_FIND_FIRST_FILE, host_cstr(rt_addr(&pat)), fd, 0, 0, 0, 0)
    if h == WIN_INVALID_HANDLE {
        << host_err("open", path, win_errno())
    }
    $nl := 10
    while true {
        name := fd + 44
        nlen := host_strlen(name)
        $skip := nlen == 0
        if nlen == 1 && rt_load(name, 1) == 46 {
            skip = true
        }
        if nlen == 2 && rt_load(name, 1) == 46 && rt_load(name + 1, 1) == 46 {
            skip = true
        }
        if !skip {
            host_append(out, name, nlen)
            host_append(out, rt_addr(&nl), 1)
        }
        if !win_ok(win_call(W_FIND_NEXT_FILE, h, fd, 0, 0, 0, 0)) {
            <-
        }
    }
    win_call(W_FIND_CLOSE, h, 0, 0, 0, 0, 0)
    << 0
}

// Removes a file or an empty directory.
fn win_remove(cp int) int {
    if win_ok(win_call(W_DELETE_FILE, cp, 0, 0, 0, 0, 0)) {
        << 0
    }
    e1 := win_errno()
    if e1 == 2 {
        << -2
    }
    if win_ok(win_call(W_REMOVE_DIRECTORY, cp, 0, 0, 0, 0, 0)) {
        << 0
    }
    e2 := win_errno()
    if e2 == 20 {
        << 0 - e1
    }
    << 0 - e2
}

fn win_bool_result(r int) int {
    if !win_ok(r) {
        << win_fail()
    }
    << 0
}

fn win_cwd(out int) {
    buf := alloc(4096)
    n := win_call(W_GET_CURRENT_DIRECTORY, 4096, buf, 0, 0, 0, 0) & 4294967295
    if n == 0 || n >= 4096 {
        <<
    }
    bytes_new(out, buf, n)
}

fn win_host_name(out int) {
    buf := alloc(256)
    io := win_io()
    rt_store(io, 4, 255)
    if !win_ok(win_call(W_GET_COMPUTER_NAME, buf, io, 0, 0, 0, 0)) {
        <<
    }
    bytes_new(out, buf, host_strlen(buf))
}

// ok = (read handle << 32) | write handle.
fn win_pipe(okp int) int {
    hs := alloc(16)
    if !win_ok(win_call(W_CREATE_PIPE, hs, hs + 8, 0, 0, 0, 0)) {
        << host_err("pipe", 0, win_errno())
    }
    << host_ok(okp, (rt_load(hs, 8) << 32) | rt_load(hs + 8, 8))
}

fn win_random(buf int, n int) int {
    f := win_fn(WF_BCRYPT_GEN_RANDOM, "bcrypt.dll", "BCryptGenRandom")
    if f == 0 {
        << -5
    }
    // BCRYPT_USE_SYSTEM_PREFERRED_RNG
    st := win_callp(f, 0, buf, n, 2, 0, 0) & 4294967295
    if st != 0 {
        << -5
    }
    << n
}

// Exports resolved at run time, by cache slot (G_WIN_FN + slot).
const WF_CERT_OPEN_SYSTEM_STORE = 0
const WF_CERT_ENUM_CERTIFICATES = 1
const WF_CERT_CLOSE_STORE = 2
const WF_BCRYPT_GEN_RANDOM = 19

// Address of export name of dll, loaded on first use; 0 if unavailable.
fn win_fn(slot int, dll string, name string) int {
    at := rt_globals() + (G_WIN_FN + slot) * 8
    $f := rt_load(at, 8)
    if f != 0 {
        << f
    }
    h := win_call(W_LOAD_LIBRARY, host_cstr(rt_addr(&dll)), 0, 0, 0, 0, 0)
    if h == 0 {
        << 0
    }
    f = win_call(W_GET_PROC_ADDRESS, h, host_cstr(rt_addr(&name)), 0, 0, 0, 0)
    rt_store(at, 8, f)
    << f
}

// Calls function pointer f with six arguments.
fn win_callp(f int, a int, b int, c int, d int, e int, g int) int {
    args := rt_globals() + G_WIN_ARGS * 8
    rt_store(args, 8, a)
    rt_store(args + 8, 8, b)
    rt_store(args + 16, 8, c)
    rt_store(args + 24, 8, d)
    rt_store(args + 32, 8, e)
    rt_store(args + 40, 8, g)
    << rt_syscall(-6, f, args, 0, 0, 0, 0)
}

// sys_security_store(name): the certificates of system store name, each
// framed as a little-endian u32 length and the DER bytes.
pub fn host_security_store(out int, name int) int {
    set_desc(out, 0, 0, 0)
    if !host_win() {
        << host_err_msg("security store: not available on this host")
    }
    open := win_fn(WF_CERT_OPEN_SYSTEM_STORE, "crypt32.dll", "CertOpenSystemStoreA")
    next := win_fn(WF_CERT_ENUM_CERTIFICATES, "crypt32.dll", "CertEnumCertificatesInStore")
    close := win_fn(WF_CERT_CLOSE_STORE, "crypt32.dll", "CertCloseStore")
    if open == 0 || next == 0 || close == 0 {
        << host_err_msg("security store: crypt32 unavailable")
    }
    st := win_callp(open, 0, host_cstr(name), 0, 0, 0, 0)
    if st == 0 {
        << host_err("security store", name, win_errno())
    }
    hdr := alloc(8)
    $ctx := 0
    while true {
        ctx = win_callp(next, st, ctx, 0, 0, 0, 0)
        if ctx == 0 {
            <-
        }
        // CERT_CONTEXT: pbCertEncoded at 8, cbCertEncoded at 16.
        n := rt_load(ctx + 16, 4)
        rt_store(hdr, 4, n)
        host_append(out, hdr, 4)
        host_append(out, rt_load(ctx + 8, 8), n)
    }
    win_callp(close, st, 0, 0, 0, 0, 0)
    free(hdr)
    << 0
}

fn win_inheritable(h int) {
    // HANDLE_FLAG_INHERIT
    win_call(W_SET_HANDLE_INFORMATION, h, 1, 1, 0, 0, 0)
}

// Runs command line cmd (application app, directory dir; 0 for none) and
// returns its wait(2)-style status: exit code << 8, 127 << 8 when the
// process cannot start, -2 when the deadline passed (the child is
// terminated), -3 on a wait failure. out_fd/in_fd (>= 0) replace the
// child's stdout/stdin and are closed here; file names a stdout file
// (also stderr when both).
fn win_exec(app int, cmd int, dir int, out_fd int, in_fd int, file int, both bool, has_deadline bool, deadline int) int {
    si := alloc(104)
    rt_store(si, 4, 104)
    $inherit := 0
    $fh := -1
    $failed := app == 0 && cmd == 0
    if in_fd >= 0 || out_fd >= 0 || file != 0 {
        inherit = 1
        $hin := win_handle(0)
        $hout := win_handle(1)
        $herr := win_handle(2)
        if in_fd >= 0 {
            hin = in_fd
        }
        if out_fd >= 0 {
            hout = out_fd
        } else if file != 0 {
            fh = win_open(file, 1 | 64 | 512)
            if fh < 0 {
                failed = true
            } else {
                hout = fh
                if both {
                    herr = fh
                }
            }
        }
        win_inheritable(hin)
        win_inheritable(hout)
        win_inheritable(herr)
        // STARTF_USESTDHANDLES
        rt_store(si + 60, 4, 256)
        rt_store(si + 80, 8, hin)
        rt_store(si + 88, 8, hout)
        rt_store(si + 96, 8, herr)
    }
    pi := alloc(24)
    $started := false
    if !failed {
        args := alloc(96)
        rt_store(args, 8, app)
        rt_store(args + 8, 8, cmd)
        rt_store(args + 32, 8, inherit)
        rt_store(args + 56, 8, dir)
        rt_store(args + 64, 8, si)
        rt_store(args + 72, 8, pi)
        started = win_ok(win_callv(W_CREATE_PROCESS, args))
        free(args)
    }
    if fh >= 0 {
        win_close(fh)
    }
    if out_fd >= 0 {
        win_close(out_fd)
    }
    if in_fd >= 0 {
        win_close(in_fd)
    }
    if !started {
        << 32512
    }
    hp := rt_load(pi, 8)
    win_close(rt_load(pi + 8, 8))
    timed := has_deadline && deadline > 0
    while true {
        $ms := 0
        if !timed && !task_others() {
            ms = 4294967295
        }
        w := win_call(W_WAIT_FOR_SINGLE_OBJECT, hp, ms, 0, 0, 0, 0) & 4294967295
        if w == 0 {
            <-
        }
        // WAIT_TIMEOUT
        if w != 258 {
            win_close(hp)
            << -3
        }
        if timed && host_now_ns() >= deadline {
            win_call(W_TERMINATE_PROCESS, hp, 1, 0, 0, 0, 0)
            win_call(W_WAIT_FOR_SINGLE_OBJECT, hp, 4294967295, 0, 0, 0, 0)
            win_close(hp)
            << -2
        }
        host_sleep_ns(1000000)
    }
    io := win_io()
    win_call(W_GET_EXIT_CODE_PROCESS, hp, io, 0, 0, 0, 0)
    win_close(hp)
    << (win_io_value() & 255) << 8
}

// ===== Winsock =====
//
// Socket descriptors are SOCKET values plus WIN_SOCK_TAG, so reads, writes,
// polls and closes can tell them from file handles (both stay below 2^48).

const WIN_SOCK_TAG = 281474976710656

const WF_WSA_STARTUP = 3
const WF_SOCKET = 4
const WF_BIND = 5
const WF_CONNECT = 6
const WF_LISTEN = 7
const WF_ACCEPT = 8
const WF_SEND = 9
const WF_RECV = 10
const WF_SENDTO = 11
const WF_RECVFROM = 12
const WF_SETSOCKOPT = 13
const WF_CLOSESOCKET = 14
const WF_WSA_POLL = 15
const WF_WSA_GET_LAST_ERROR = 16
const WF_GET_ADAPTERS_ADDRESSES = 17
const WF_GETSOCKOPT = 18

fn win_is_sock(fd int) bool {
    << fd >= WIN_SOCK_TAG
}

// ws2_32 export name, after WSAStartup on first use.
fn win_ws(slot int, name string) int {
    if rt_load(rt_globals() + (G_WIN_FN + WF_WSA_STARTUP) * 8, 8) == 0 {
        start := win_fn(WF_WSA_STARTUP, "ws2_32.dll", "WSAStartup")
        if start == 0 {
            << 0
        }
        data := alloc(512)
        win_callp(start, 514, data, 0, 0, 0, 0)
        free(data)
    }
    << win_fn(slot, "ws2_32.dll", name)
}

// WSAGetLastError as a Linux errno.
fn win_wsa_errno() int {
    e := win_callp(win_ws(WF_WSA_GET_LAST_ERROR, "WSAGetLastError"), 0, 0, 0, 0, 0, 0) & 4294967295
    if e == 10004 { << 4 }
    if e == 10009 || e == 10038 { << 9 }
    if e == 10013 { << 13 }
    if e == 10014 || e == 10022 { << 22 }
    if e == 10035 { << 11 }
    if e == 10036 { << 115 }
    if e == 10047 { << 97 }
    if e == 10048 { << 98 }
    if e == 10049 { << 99 }
    if e == 10050 { << 100 }
    if e == 10051 { << 101 }
    if e == 10053 { << 103 }
    if e == 10054 { << 104 }
    if e == 10056 { << 106 }
    if e == 10057 { << 107 }
    if e == 10058 { << 32 }
    if e == 10060 { << 110 }
    if e == 10061 { << 111 }
    if e == 10065 { << 113 }
    << 1000 + e
}

// int results: SOCKET_ERROR (-1) becomes -errno.
fn win_sock_r(r int) int {
    v := r & 4294967295
    if v == 4294967295 {
        << 0 - win_wsa_errno()
    }
    << v
}

fn win_socket(domain int, typ int, proto int) int {
    s := win_callp(win_ws(WF_SOCKET, "socket"), domain, typ, proto, 0, 0, 0)
    if s == -1 {
        << 0 - win_wsa_errno()
    }
    << s + WIN_SOCK_TAG
}

fn win_sock_bind(fd int, sa int, len int) int {
    << win_sock_r(win_callp(win_ws(WF_BIND, "bind"), fd - WIN_SOCK_TAG, sa, len, 0, 0, 0))
}

fn win_sock_connect(fd int, sa int, len int) int {
    << win_sock_r(win_callp(win_ws(WF_CONNECT, "connect"), fd - WIN_SOCK_TAG, sa, len, 0, 0, 0))
}

fn win_sock_setopt(fd int, level int, opt int, val int, len int) int {
    << win_sock_r(win_callp(win_ws(WF_SETSOCKOPT, "setsockopt"), fd - WIN_SOCK_TAG, level, opt, val, len, 0))
}

fn win_sock_getopt(fd int, level int, opt int, val int, lenp int) int {
    << win_sock_r(win_callp(win_ws(WF_GETSOCKOPT, "getsockopt"), fd - WIN_SOCK_TAG, level, opt, val, lenp, 0))
}

fn win_listen(fd int, backlog int) int {
    << win_sock_r(win_callp(win_ws(WF_LISTEN, "listen"), fd - WIN_SOCK_TAG, backlog, 0, 0, 0, 0))
}

fn win_accept(fd int) int {
    s := win_callp(win_ws(WF_ACCEPT, "accept"), fd - WIN_SOCK_TAG, 0, 0, 0, 0, 0)
    if s == -1 {
        << 0 - win_wsa_errno()
    }
    << s + WIN_SOCK_TAG
}

fn win_send(fd int, p int, n int) int {
    << win_sock_r(win_callp(win_ws(WF_SEND, "send"), fd - WIN_SOCK_TAG, p, win_clamp(n), 0, 0, 0))
}

fn win_recv(fd int, p int, n int) int {
    << win_sock_r(win_callp(win_ws(WF_RECV, "recv"), fd - WIN_SOCK_TAG, p, win_clamp(n), 0, 0, 0))
}

fn win_sendto(fd int, p int, n int, sa int, salen int) int {
    << win_sock_r(win_callp(win_ws(WF_SENDTO, "sendto"), fd - WIN_SOCK_TAG, p, win_clamp(n), 0, sa, salen))
}

fn win_recvfrom(fd int, p int, n int, sa int, lenp int) int {
    << win_sock_r(win_callp(win_ws(WF_RECVFROM, "recvfrom"), fd - WIN_SOCK_TAG, p, win_clamp(n), 0, sa, lenp))
}

fn win_closesocket(fd int) int {
    << win_sock_r(win_callp(win_ws(WF_CLOSESOCKET, "closesocket"), fd - WIN_SOCK_TAG, 0, 0, 0, 0, 0))
}

// poll(2) result bits (read 1, write 4, error 8, hang-up 16) from WSAPoll.
fn win_sock_poll(fd int, events int, timeout_ms int) int {
    pfd := alloc(16)
    rt_store(pfd, 8, fd - WIN_SOCK_TAG)
    $ev := 0
    if (events & 1) != 0 {
        // POLLRDNORM
        ev = ev | 256
    }
    if (events & 4) != 0 {
        // POLLWRNORM
        ev = ev | 16
    }
    rt_store(pfd + 8, 2, ev)
    r := win_sock_r(win_callp(win_ws(WF_WSA_POLL, "WSAPoll"), pfd, 1, timeout_ms, 0, 0, 0))
    re := rt_load(pfd + 10, 2)
    free(pfd)
    if r < 0 {
        << r
    }
    $out := 0
    if (re & 768) != 0 {
        out = out | 1
    }
    if (re & 16) != 0 {
        out = out | 4
    }
    if (re & 4) != 0 { // POLLNVAL
        << 0 - EBADF
    }
    if (re & 1) != 0 { // POLLERR
        out = out | 8
    }
    if (re & 2) != 0 {
        out = out | 16 | (events & 1)
    }
    << out
}
