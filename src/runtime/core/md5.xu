@runtime/core

// MD5 (RFC 1321) compression and hex digest formatting.
// Kept in runtime/core so full blocks and 32-byte inputs read words and
// write the 32-byte hex digest without per-byte bounds checks or temporary
// padding buffers. Every 32-bit lane is explicitly masked for identical
// results across all backends.

const MD5_M32 = 4294967295
const MD5_HEX = "0123456789abcdef"

fn md5_load32(p int) int {
    arch := xu_target_arch()
    if arch == 0 || arch == ARCH_X64 {
        << rt_load(p, 4)
    }
    << rt_load(p, 1) | (rt_load(p + 1, 1) << 8) | (rt_load(p + 2, 1) << 16) | (rt_load(p + 3, 1) << 24)
}

fn md5_hex_word(hex int, v int) int {
    c0 := rt_load(hex + ((v >> 4) & 15), 1)
    c1 := rt_load(hex + (v & 15), 1)
    c2 := rt_load(hex + ((v >> 12) & 15), 1)
    c3 := rt_load(hex + ((v >> 8) & 15), 1)
    c4 := rt_load(hex + ((v >> 20) & 15), 1)
    c5 := rt_load(hex + ((v >> 16) & 15), 1)
    c6 := rt_load(hex + ((v >> 28) & 15), 1)
    c7 := rt_load(hex + ((v >> 24) & 15), 1)
    << c0 | (c1 << 8) | (c2 << 16) | (c3 << 24) | (c4 << 32) | (c5 << 40) | (c6 << 48) | (c7 << 56)
}

fn md5_store_hex_bytes(dst int, hex int, v int) {
    rt_store(dst, 1, rt_load(hex + ((v >> 4) & 15), 1))
    rt_store(dst + 1, 1, rt_load(hex + (v & 15), 1))
    rt_store(dst + 2, 1, rt_load(hex + ((v >> 12) & 15), 1))
    rt_store(dst + 3, 1, rt_load(hex + ((v >> 8) & 15), 1))
    rt_store(dst + 4, 1, rt_load(hex + ((v >> 20) & 15), 1))
    rt_store(dst + 5, 1, rt_load(hex + ((v >> 16) & 15), 1))
    rt_store(dst + 6, 1, rt_load(hex + ((v >> 28) & 15), 1))
    rt_store(dst + 7, 1, rt_load(hex + ((v >> 24) & 15), 1))
}

pub fn md5_hex(h0 int, h1 int, h2 int, h3 int) string {
    buf := alloc_small_unzeroed(33)
    digits := MD5_HEX
    hex := str_ptr(&digits)
    arch := xu_target_arch()
    if arch == 0 || arch == ARCH_X64 {
        rt_store(buf, 8, md5_hex_word(hex, h0))
        rt_store(buf + 8, 8, md5_hex_word(hex, h1))
        rt_store(buf + 16, 8, md5_hex_word(hex, h2))
        rt_store(buf + 24, 8, md5_hex_word(hex, h3))
    } else {
        md5_store_hex_bytes(buf, hex, h0)
        md5_store_hex_bytes(buf + 8, hex, h1)
        md5_store_hex_bytes(buf + 16, hex, h2)
        md5_store_hex_bytes(buf + 24, hex, h3)
    }
    rt_store(buf + 32, 1, 0)
    $out := ""
    set_desc(rt_addr($&out), buf, 32, 32)
    << out
}

fn md5_block_words(h0 $&int, h1 $&int, h2 $&int, h3 $&int,
                   w0 int, w1 int, w2 int, w3 int, w4 int, w5 int, w6 int, w7 int,
                   w8 int, w9 int, w10 int, w11 int, w12 int, w13 int, w14 int, w15 int) {
    $a := *h0
    $b := *h1
    $c := *h2
    $d := *h3
    $x := 0

    // Round 1
    x = (a + (d ^ (b & (c ^ d))) + 0xd76aa478 + w0) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0xe8c7b756 + w1) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0x242070db + w2) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0xc1bdceee + w3) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32
    x = (a + (d ^ (b & (c ^ d))) + 0xf57c0faf + w4) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0x4787c62a + w5) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0xa8304613 + w6) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0xfd469501 + w7) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32
    x = (a + (d ^ (b & (c ^ d))) + 0x698098d8 + w8) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0x8b44f7af + w9) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0xffff5bb1 + w10) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0x895cd7be + w11) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32
    x = (a + (d ^ (b & (c ^ d))) + 0x6b901122 + w12) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0xfd987193 + w13) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0xa679438e + w14) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0x49b40821 + w15) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32

    // Round 2
    x = (a + (c ^ (d & (b ^ c))) + 0xf61e2562 + w1) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0xc040b340 + w6) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0x265e5a51 + w11) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0xe9b6c7aa + w0) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32
    x = (a + (c ^ (d & (b ^ c))) + 0xd62f105d + w5) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0x02441453 + w10) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0xd8a1e681 + w15) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0xe7d3fbc8 + w4) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32
    x = (a + (c ^ (d & (b ^ c))) + 0x21e1cde6 + w9) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0xc33707d6 + w14) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0xf4d50d87 + w3) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0x455a14ed + w8) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32
    x = (a + (c ^ (d & (b ^ c))) + 0xa9e3e905 + w13) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0xfcefa3f8 + w2) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0x676f02d9 + w7) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0x8d2a4c8a + w12) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32

    // Round 3
    x = (a + (b ^ c ^ d) + 0xfffa3942 + w5) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0x8771f681 + w8) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0x6d9d6122 + w11) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0xfde5380c + w14) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32
    x = (a + (b ^ c ^ d) + 0xa4beea44 + w1) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0x4bdecfa9 + w4) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0xf6bb4b60 + w7) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0xbebfbc70 + w10) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32
    x = (a + (b ^ c ^ d) + 0x289b7ec6 + w13) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0xeaa127fa + w0) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0xd4ef3085 + w3) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0x04881d05 + w6) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32
    x = (a + (b ^ c ^ d) + 0xd9d4d039 + w9) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0xe6db99e5 + w12) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0x1fa27cf8 + w15) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0xc4ac5665 + w2) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32

    // Round 4
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0xf4292244 + w0) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0x432aff97 + w7) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0xab9423a7 + w14) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0xfc93a039 + w5) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0x655b59c3 + w12) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0x8f0ccc92 + w3) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0xffeff47d + w10) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0x85845dd1 + w1) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0x6fa87e4f + w8) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0xfe2ce6e0 + w15) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0xa3014314 + w6) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0x4e0811a1 + w13) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0xf7537e82 + w4) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0xbd3af235 + w11) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0x2ad7d2bb + w2) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0xeb86d391 + w9) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32

    *h0 = (*h0 + a) & MD5_M32
    *h1 = (*h1 + b) & MD5_M32
    *h2 = (*h2 + c) & MD5_M32
    *h3 = (*h3 + d) & MD5_M32
}

pub fn md5_compress_block(h0 $&int, h1 $&int, h2 $&int, h3 $&int, s &string, off int) {
    if off < 0 || off + 64 > s.len {
        intrin_fatal("md5_compress_block: out of bounds\n")
    }
    p := str_ptr(s) + off
    md5_block_words(
        h0, h1, h2, h3,
        md5_load32(p), md5_load32(p + 4), md5_load32(p + 8), md5_load32(p + 12),
        md5_load32(p + 16), md5_load32(p + 20), md5_load32(p + 24), md5_load32(p + 28),
        md5_load32(p + 32), md5_load32(p + 36), md5_load32(p + 40), md5_load32(p + 44),
        md5_load32(p + 48), md5_load32(p + 52), md5_load32(p + 56), md5_load32(p + 60)
    )
}

fn md5_sum32(p int) string {
    w0 := md5_load32(p)
    w1 := md5_load32(p + 4)
    w2 := md5_load32(p + 8)
    w3 := md5_load32(p + 12)
    w4 := md5_load32(p + 16)
    w5 := md5_load32(p + 20)
    w6 := md5_load32(p + 24)
    w7 := md5_load32(p + 28)
    $a := 0x67452301
    $b := 0xefcdab89
    $c := 0x98badcfe
    $d := 0x10325476
    $x := 0

    // Round 1 (w8 = 0x80, w9..w13 = 0, w14 = 256, w15 = 0)
    x = (a + (d ^ (b & (c ^ d))) + 0xd76aa478 + w0) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0xe8c7b756 + w1) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0x242070db + w2) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0xc1bdceee + w3) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32
    x = (a + (d ^ (b & (c ^ d))) + 0xf57c0faf + w4) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0x4787c62a + w5) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0xa8304613 + w6) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0xfd469501 + w7) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32
    x = (a + (d ^ (b & (c ^ d))) + 0x69809958) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0x8b44f7af) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0xffff5bb1) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0x895cd7be) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32
    x = (a + (d ^ (b & (c ^ d))) + 0x6b901122) & MD5_M32
    a = (b + ((x << 7) | (x >> 25))) & MD5_M32
    x = (d + (c ^ (a & (b ^ c))) + 0xfd987193) & MD5_M32
    d = (a + ((x << 12) | (x >> 20))) & MD5_M32
    x = (c + (b ^ (d & (a ^ b))) + 0xa679448e) & MD5_M32
    c = (d + ((x << 17) | (x >> 15))) & MD5_M32
    x = (b + (a ^ (c & (d ^ a))) + 0x49b40821) & MD5_M32
    b = (c + ((x << 22) | (x >> 10))) & MD5_M32

    // Round 2
    x = (a + (c ^ (d & (b ^ c))) + 0xf61e2562 + w1) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0xc040b340 + w6) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0x265e5a51) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0xe9b6c7aa + w0) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32
    x = (a + (c ^ (d & (b ^ c))) + 0xd62f105d + w5) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0x02441453) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0xd8a1e681) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0xe7d3fbc8 + w4) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32
    x = (a + (c ^ (d & (b ^ c))) + 0x21e1cde6) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0xc33708d6) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0xf4d50d87 + w3) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0x455a156d) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32
    x = (a + (c ^ (d & (b ^ c))) + 0xa9e3e905) & MD5_M32
    a = (b + ((x << 5) | (x >> 27))) & MD5_M32
    x = (d + (b ^ (c & (a ^ b))) + 0xfcefa3f8 + w2) & MD5_M32
    d = (a + ((x << 9) | (x >> 23))) & MD5_M32
    x = (c + (a ^ (b & (d ^ a))) + 0x676f02d9 + w7) & MD5_M32
    c = (d + ((x << 14) | (x >> 18))) & MD5_M32
    x = (b + (d ^ (a & (c ^ d))) + 0x8d2a4c8a) & MD5_M32
    b = (c + ((x << 20) | (x >> 12))) & MD5_M32

    // Round 3
    x = (a + (b ^ c ^ d) + 0xfffa3942 + w5) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0x8771f701) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0x6d9d6122) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0xfde5390c) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32
    x = (a + (b ^ c ^ d) + 0xa4beea44 + w1) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0x4bdecfa9 + w4) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0xf6bb4b60 + w7) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0xbebfbc70) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32
    x = (a + (b ^ c ^ d) + 0x289b7ec6) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0xeaa127fa + w0) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0xd4ef3085 + w3) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0x04881d05 + w6) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32
    x = (a + (b ^ c ^ d) + 0xd9d4d039) & MD5_M32
    a = (b + ((x << 4) | (x >> 28))) & MD5_M32
    x = (d + (a ^ b ^ c) + 0xe6db99e5) & MD5_M32
    d = (a + ((x << 11) | (x >> 21))) & MD5_M32
    x = (c + (d ^ a ^ b) + 0x1fa27cf8) & MD5_M32
    c = (d + ((x << 16) | (x >> 16))) & MD5_M32
    x = (b + (c ^ d ^ a) + 0xc4ac5665 + w2) & MD5_M32
    b = (c + ((x << 23) | (x >> 9))) & MD5_M32

    // Round 4
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0xf4292244 + w0) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0x432aff97 + w7) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0xab9424a7) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0xfc93a039 + w5) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0x655b59c3) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0x8f0ccc92 + w3) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0xffeff47d) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0x85845dd1 + w1) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0x6fa87ecf) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0xfe2ce6e0) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0xa3014314 + w6) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0x4e0811a1) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32
    x = (a + (c ^ (b | (d ^ MD5_M32))) + 0xf7537e82 + w4) & MD5_M32
    a = (b + ((x << 6) | (x >> 26))) & MD5_M32
    x = (d + (b ^ (a | (c ^ MD5_M32))) + 0xbd3af235) & MD5_M32
    d = (a + ((x << 10) | (x >> 22))) & MD5_M32
    x = (c + (a ^ (d | (b ^ MD5_M32))) + 0x2ad7d2bb + w2) & MD5_M32
    c = (d + ((x << 15) | (x >> 17))) & MD5_M32
    x = (b + (d ^ (c | (a ^ MD5_M32))) + 0xeb86d391) & MD5_M32
    b = (c + ((x << 21) | (x >> 11))) & MD5_M32

    << md5_hex(
        (0x67452301 + a) & MD5_M32,
        (0xefcdab89 + b) & MD5_M32,
        (0x98badcfe + c) & MD5_M32,
        (0x10325476 + d) & MD5_M32
    )
}

pub fn md5_finish_tail(h0 $&int, h1 $&int, h2 $&int, h3 $&int, s &string, off int, total int) string {
    rem := s.len - off
    if rem < 0 || rem >= 64 {
        intrin_fatal("md5_finish_tail: invalid remainder\n")
    }
    $size := 64
    if rem >= 56 { size = 128 }
    tail := alloc(size)
    if rem > 0 {
        mem_copy(tail, str_ptr(s) + off, rem)
    }
    rt_store(tail + rem, 1, 128)
    bits := total * 8
    for j in 0:8 {
        rt_store(tail + size - 8 + j, 1, (bits >> (8 * j)) & 255)
    }
    $po := 0
    while po < size {
        p := tail + po
        md5_block_words(
            h0, h1, h2, h3,
            md5_load32(p), md5_load32(p + 4), md5_load32(p + 8), md5_load32(p + 12),
            md5_load32(p + 16), md5_load32(p + 20), md5_load32(p + 24), md5_load32(p + 28),
            md5_load32(p + 32), md5_load32(p + 36), md5_load32(p + 40), md5_load32(p + 44),
            md5_load32(p + 48), md5_load32(p + 52), md5_load32(p + 56), md5_load32(p + 60)
        )
        po += 64
    }
    free(tail)
    << md5_hex(*h0, *h1, *h2, *h3)
}

pub fn md5_sum(s &string) string {
    n := s.len
    if n == 32 {
        << md5_sum32(str_ptr(s))
    }
    $h0 := 0x67452301
    $h1 := 0xefcdab89
    $h2 := 0x98badcfe
    $h3 := 0x10325476
    p := str_ptr(s)
    $off := 0
    while off + 64 <= n {
        b := p + off
        md5_block_words(
            $&h0, $&h1, $&h2, $&h3,
            md5_load32(b), md5_load32(b + 4), md5_load32(b + 8), md5_load32(b + 12),
            md5_load32(b + 16), md5_load32(b + 20), md5_load32(b + 24), md5_load32(b + 28),
            md5_load32(b + 32), md5_load32(b + 36), md5_load32(b + 40), md5_load32(b + 44),
            md5_load32(b + 48), md5_load32(b + 52), md5_load32(b + 56), md5_load32(b + 60)
        )
        off += 64
    }
    << md5_finish_tail($&h0, $&h1, $&h2, $&h3, s, off, n)
}
