@runtime/core
// Channels and `xu` tasks: cooperative green threads on one OS thread.
//
// Every task runs on its own mapped stack; switching saves and restores the
// callee-saved registers (x19-x28, fp, lr, sp, d8-d15) through the
// TASK_SWITCH pseudo system call handled by the backend's __xu_syscall stub.
// x28 (the runtime state block) is identical in every task. The T_* slots
// are named after arm64 registers; x64 maps them to rbx, r12-r15, rbp and
// the resume address (see codegen/x64_base.xu).
//
// Blocking operations poll: a task that cannot proceed yields to the next
// task in a round-robin queue. Every completed channel operation, spawn or
// task exit starts a new epoch; when every live task has failed to proceed
// within one epoch the program is deadlocked.
//
// Channel elements are copied by size (scalars as one 8-byte word). The
// element buffer is allocated by the first operation, which knows the size.

// rt_syscall numbers for task switching and multi-core runtime support.
const SYS_TASK_SWITCH = -1
const SYS_THREAD_ID = -10
const SYS_THREAD_ENTRY = -11
const SYS_M0_G0_ENTRY = -13
const SYS_LINUX_CLONE = -16
const SYS_SET_TLS = -17

const TASK_STACK = 1048576
const TASK_STACK_GUARD = 16384
const TASK_STACK_CACHE_LIMIT = 8
const TASK_TINY_STACK = 16384
const G0_STACK = 65536

// Task record. The register context comes first (see __xu_task_switch).
const T_X19 = 0
const T_X20 = 8
const T_X21 = 16
const T_X22 = 24
const T_X28 = 72
const T_FP = 80
const T_LR = 88
const T_SP = 96
const T_PREV = 168
const T_NEXT = 176
const T_EPOCH = 184
const T_STACK = 192
// Owned argument block, the scheduler's shared empty area, or zero for a
// task whose entire argument payload fits in T_X21.
const T_ARGS = 200
const T_WAIT_FD = 208
const T_WAIT_EVENTS = 216
const T_WAIT_REVENTS = 224
const T_WAIT_DEADLINE = 232
const T_WAIT_NEXT = 240
const T_IS_TINY = 248
const T_SEEN_EPOCH = 256
const T_WAIT_MINE = 264
const T_WAIT_CH_NEXT = 272
const T_SIZE = 288

// Scheduler record, reached through G_SCHED.
const S_CUR = 0
const S_HEAD = 8
const S_TAIL = 16
const S_NBLOCKED = 40
const S_FREE = 48
const S_DRAIN = 56
const S_IO_PROBE = 64
const S_IO_IDLE = 72
const S_ES_DEPTH = 80
const S_FREE_COUNT = 88
const S_WAIT_HEAD = 96
const S_WAIT_TAIL = 104
const S_WAIT_COUNT = 112
const S_POLL_PFD = 120
const S_POLL_TASKS = 128
const S_POLL_CAP = 136
const S_AFFINITY = 144
const S_AFFINITY_TICKS = 152
const S_TINY_FREE = 160
// The task entry trampoline always reads 16 words, even for a zero-argument
// target. These zeroed words are read-only for the scheduler's lifetime.
const S_EMPTY_ARGS = 176
const S_MT_STATE = 304
const S_MT_INIT = 312
// Hot scheduler counters isolated onto dedicated 64-byte cache lines.
const S_EPOCH = 384
const S_NTASKS = 448
const S_RUNQ_LEN = 512
const S_SIZE = 576

// Channel record.
const C_CAP = 0
const C_ESIZE = 8
const C_BUF = 16
const C_HEAD = 24
const C_COUNT = 32
const C_CLOSED = 40
const C_RWAIT = 48
const C_SENT = 56
const C_RECVD = 64
// Holders beyond the first (alloc zeroes it). Every copy of a channel
// value adds a holder and every drop removes one; the last drop frees the
// unread elements, the buffer and the record.
const C_RC = 72
const C_WAITER = 80
const C_RDST = 88
const C_DIRECT = 96
const C_LOCK = 104
const C_SWAIT_HEAD = 112
const C_SWAIT_TAIL = 120
const C_RWAIT_HEAD = 128
const C_RWAIT_TAIL = 136
// Dedicated MT slot for the single in-flight unbuffered sender (isolated from
// single-threaded C_WAITER so pre-MT select/default never leaves a stale pointer).
const C_UNBUF_WAITER = 144
// Dedicated ST slot recording the exact receiver task that registered C_RDST.
const C_RDST_TASK = 152
const C_SIZE = 160

// M:N multi-core scheduler state (initialized lazily on first `xu` spawn or
// explicit set_max_procs). Cold/read-mostly fields occupy 0..255; each hot
// atomic occupies its own 64-byte cache line (256..1151) to prevent false sharing.
const MT_MAX_M = 64
const MT_NPROCS = 0
const MT_MAIN_TASK = 8
const MT_BACKEND = 16
const MT_OWNED_SYNC = 24
const MT_MU = 32
const MT_CV = 40
const MT_M0_CV = 48
const MT_THREAD_ENTRY = 56
const MT_FP_CREATE = 64
const MT_FP_JOIN = 72
const MT_FP_LOCK = 80
const MT_FP_UNLOCK = 88
const MT_FP_WAIT = 96
const MT_FP_SIGNAL = 104
const MT_FP_BROADCAST = 112
const MT_FP_DESTROY_MU = 120
const MT_FP_DESTROY_CV = 128
const MT_FP_YIELD = 136
const MT_BLK_HEAD = 144
const MT_BLK_TAIL = 152
const MT_POLLING = 160

const MT_ACTIVE_M = 256
const MT_TOTAL_RUNNABLE = 320
const MT_WAKE_SEQ = 384
const MT_M0_WAKE_SEQ = 448
const MT_SLEEPING = 512
const MT_M0_SLEEPING = 576
const MT_SPINNING = 640
const MT_BLK_COUNT = 704
const MT_SEL_BLK_COUNT = 768
const MT_MAIN_READY = 832
const MT_DRAIN_WAITER = 896
const MT_STOP = 960
const MT_SPAWNED_M = 1024
const MT_SPAWNING = 1088
const MT_HDR_SIZE = 1152

const MT_BACKEND_PTHREAD = 0
const MT_BACKEND_LINUX_CLONE = 1
const MT_BACKEND_WIN = 2

// Open-addressed (tid -> wid+1) table for O(1) lock-free current_m() lookup.
const MT_TID_OFF = 1152
const MT_TID_SLOTS = 512
const MT_TID_MASK = 511
const MT_M_OFF = 9344 // 1152 + 512 * 16

// Per-M local work-stealing runqueue capacity (power of two).
const MT_RQ_CAP = 256
const MT_RQ_MASK = 255
const MT_RQ_HALF = 128

// Per-M record (576 bytes = 9 cache lines, zero false sharing between Ms).
// Offsets 0 and 8 are read directly by __xu_thread_entry(arg).
const MT_M_STRIDE = 576
const MT_M_GLOBALS = 0
const MT_M_WID = 8
const MT_M_G0 = 16
const MT_M_CUR = 24
const MT_M_PARK_TASK = 32
const MT_M_PARK_MODE = 40
const MT_M_PARK_ARG = 48
const MT_M_TID = 56
const MT_M_PTHREAD = 64
const MT_M_RQ_LOCK = 72
const MT_M_RUNNEXT = 80
const MT_M_RQ_BUF = 88
const MT_M_RQ_HEAD = 96
const MT_M_RQ_TAIL = 104
const MT_M_RAND = 112
const MT_M_TICK = 120
const MT_M_MCACHE_CUR = 128
const MT_M_MCACHE_END = 136
const MT_M_MCACHE_FREE = 144 // 11 words (NCLASS) -> 232
const MT_M_MCACHE_CNT = 232  // 11 words (NCLASS) -> 320
const MT_M_FFI_BLK = 320     // 200 bytes -> 520
const MT_M_TLS_SELF = 520
const MT_M_CTID = 528
const MT_M_OS_STACK = 536

const PARK_YIELD = 1
const PARK_BLOCK = 2
const PARK_WAIT_IO = 3
const PARK_EXIT = 4
const PARK_DRAIN = 5
const PARK_CHAN_SEND = 6
const PARK_CHAN_RECV = 7
const PARK_CHAN_UNBUF = 8

fn ld(addr int) int {
    << rt_load(addr, 8)
}

fn st(addr int, v int) {
    rt_store(addr, 8, v)
}

fn sched() int {
    $s := gword(G_SCHED)
    if s != 0 {
        << s
    }
    s = alloc(S_SIZE)
    st(s + S_CUR, alloc(T_SIZE))
    st(s + S_NTASKS, 1)
    st(s + S_EPOCH, 1)
    set_gword(G_SCHED, s)
    << s
}

fn sched_m_state() int {
    s := gword(G_SCHED)
    if s == 0 { << 0 }
    mt := ld(s + S_MT_STATE)
    if mt != 0 && atomic_load(c_ptr(mt + MT_NPROCS)) > 1 { << mt }
    << 0
}

fn m_slot(mt int, wid int) int {
    << mt + MT_M_OFF + wid * MT_M_STRIDE
}

fn mt_tid_hash(tid int) int {
    << (tid ^ (tid >> 13) ^ (tid >> 27)) & MT_TID_MASK
}

fn mt_tid_register_locked(mt int, tid int, wid int) {
    if tid == 0 { << }
    base := mt + MT_TID_OFF
    $idx := mt_tid_hash(tid)
    for _ in 0:MT_TID_SLOTS {
        slot := base + idx * 16
        cur := ld(slot)
        if cur == 0 || cur == tid {
            st(slot, tid)
            atomic_store(c_ptr(slot + 8), wid + 1)
            st(m_slot(mt, wid) + MT_M_TID, tid)
            <<
        }
        idx = (idx + 1) & MT_TID_MASK
    }
}

fn mt_tid_clear_locked(mt int) {
    mem_zero(mt + MT_TID_OFF, MT_TID_SLOTS * 16)
}

// O(1) lock-free identification of the calling OS thread using the hardware
// TLS register. Returns -1 when the caller is not a registered scheduler M
// (e.g. a ThreadPool worker thread) so per-M caches remain strictly isolated.
fn current_m_strict(mt int) int {
    tid := rt_syscall(SYS_THREAD_ID, 0, 0, 0, 0, 0, 0)
    if tid > 0 {
        base := mt + MT_TID_OFF
        $idx := mt_tid_hash(tid)
        for _ in 0:MT_TID_SLOTS {
            slot := base + idx * 16
            v := atomic_load(c_ptr(slot + 8))
            if v == 0 { <- }
            if ld(slot) == tid {
                << v - 1
            }
            idx = (idx + 1) & MT_TID_MASK
        }
    }
    << -1
}

fn current_m(mt int) int {
    w := current_m_strict(mt)
    if w >= 0 { << w }
    << 0
}

fn rt_mcache_current() int {
    s := gword(G_SCHED)
    if s == 0 { << 0 }
    mt := ld(s + S_MT_STATE)
    if mt == 0 || atomic_load(c_ptr(mt + MT_NPROCS)) <= 1 { << 0 }
    w := current_m_strict(mt)
    if w < 0 { << 0 }
    << m_slot(mt, w)
}

fn current_task_mt(s int, mt int) int {
    if mt == 0 { << ld(s + S_CUR) }
    << atomic_load(c_ptr(m_slot(mt, current_m(mt)) + MT_M_CUR))
}

fn mt_ccall1(blk int, fp int, a0 int) int {
    mem_zero(blk, 200)
    rt_store(blk, 8, a0)
    ffi_call(fp, blk)
    << rt_load(blk + 19 * 8, 8)
}

fn mt_ccall2(blk int, fp int, a0 int, a1 int) int {
    mem_zero(blk, 200)
    rt_store(blk, 8, a0)
    rt_store(blk + 8, 8, a1)
    ffi_call(fp, blk)
    << rt_load(blk + 19 * 8, 8)
}

fn mt_ccall4(blk int, fp int, a0 int, a1 int, a2 int, a3 int) int {
    mem_zero(blk, 200)
    rt_store(blk, 8, a0)
    rt_store(blk + 8, 8, a1)
    rt_store(blk + 16, 8, a2)
    rt_store(blk + 24, 8, a3)
    ffi_call(fp, blk)
    << rt_load(blk + 19 * 8, 8)
}

fn mt_dlsym_str(blk int, dlsym_fp int, name string) int {
    c := host_cstr(rt_addr(&name))
    $deflt := 0
    if xu_target_os() == OS_MACOS { deflt = -2 }
    r := mt_ccall2(blk, dlsym_fp, deflt, c)
    free(c)
    << r
}

fn mt_parse_env_procs() int {
    $k := "XU_PROCS"
    p := host_env_find(rt_addr(&k))
    if p == 0 { << 0 }
    $v := 0
    $i := 0
    while true {
        b := rt_load(p + i, 1)
        if b == 0 { <- }
        if b < 48 || b > 57 { << 0 }
        v = v * 10 + (b - 48)
        if v > MT_MAX_M { << MT_MAX_M }
        i += 1
    }
    if i == 0 { << 0 }
    << v
}

fn mt_linux_ncpu() int {
    mask := alloc(128)
    r := rt_syscall(123, 0, 128, mask, 0, 0, 0) // sched_getaffinity (arm64 123, x64 204)
    $cnt := 0
    if r > 0 {
        $nb := r
        if nb > 128 { nb = 128 }
        for i in 0:nb {
            $b := rt_load(mask + i, 1)
            while b != 0 {
                cnt += b & 1
                b = b >> 1
            }
        }
    }
    free(mask)
    if cnt < 1 { << 1 }
    << cnt
}

fn mt_win_k32(name string) int {
    k32 := "kernel32.dll"
    kz := host_cstr(rt_addr(&k32))
    h := win_call(W_LOAD_LIBRARY, kz, 0, 0, 0, 0, 0)
    free(kz)
    if h == 0 { << 0 }
    nz := host_cstr(rt_addr(&name))
    f := win_call(W_GET_PROC_ADDRESS, h, nz, 0, 0, 0, 0)
    free(nz)
    << f
}

fn mt_wake_m0_if_sleeping(mt int, wid int) {
    if atomic_load(c_ptr(mt + MT_M0_SLEEPING)) == 0 { << }
    os := xu_target_os()
    if os == OS_LINUX {
        _ := rt_syscall(98, mt + MT_M0_WAKE_SEQ, 129, 1, 0, 0, 0)
        <<
    }
    if os == OS_WINDOWS {
        mu := ld(mt + MT_MU)
        m0_cv := ld(mt + MT_M0_CV)
        _ := win_callp(ld(mt + MT_FP_LOCK), mu, 0, 0, 0, 0, 0)
        _ := win_callp(ld(mt + MT_FP_SIGNAL), m0_cv, 0, 0, 0, 0, 0)
        _ := win_callp(ld(mt + MT_FP_UNLOCK), mu, 0, 0, 0, 0, 0)
        <<
    }
    $blk := 0
    $owned := false
    if wid >= 0 {
        blk = m_slot(mt, wid) + MT_M_FFI_BLK
    } else {
        blk = alloc(200)
        owned = true
    }
    mu := ld(mt + MT_MU)
    m0_cv := ld(mt + MT_M0_CV)
    _ := mt_ccall1(blk, ld(mt + MT_FP_LOCK), mu)
    _ := mt_ccall1(blk, ld(mt + MT_FP_SIGNAL), m0_cv)
    _ := mt_ccall1(blk, ld(mt + MT_FP_UNLOCK), mu)
    if owned { free(blk) }
}

fn mt_signal_one_if_sleeping(mt int, wid int) {
    // Dekker fast-skip: MT_WAKE_SEQ was already incremented before this call,
    // and every spinning M re-checks MT_WAKE_SEQ after decrementing MT_SPINNING.
    if atomic_load(c_ptr(mt + MT_SPINNING)) > 0 { << }
    if atomic_load(c_ptr(mt + MT_SLEEPING)) > 0 {
        os := xu_target_os()
        if os == OS_LINUX {
            _ := rt_syscall(98, mt + MT_WAKE_SEQ, 129, 1, 0, 0, 0)
            <<
        }
        if os == OS_WINDOWS {
            mu := ld(mt + MT_MU)
            cv := ld(mt + MT_CV)
            _ := win_callp(ld(mt + MT_FP_LOCK), mu, 0, 0, 0, 0, 0)
            _ := win_callp(ld(mt + MT_FP_SIGNAL), cv, 0, 0, 0, 0, 0)
            _ := win_callp(ld(mt + MT_FP_UNLOCK), mu, 0, 0, 0, 0, 0)
            <<
        }
        $blk := 0
        $owned := false
        if wid >= 0 {
            blk = m_slot(mt, wid) + MT_M_FFI_BLK
        } else {
            blk = alloc(200)
            owned = true
        }
        mu := ld(mt + MT_MU)
        cv := ld(mt + MT_CV)
        _ := mt_ccall1(blk, ld(mt + MT_FP_LOCK), mu)
        _ := mt_ccall1(blk, ld(mt + MT_FP_SIGNAL), cv)
        _ := mt_ccall1(blk, ld(mt + MT_FP_UNLOCK), mu)
        if owned { free(blk) }
        <<
    }
    if wid != 0 && atomic_load(c_ptr(mt + MT_M0_SLEEPING)) != 0 {
        _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
        mt_wake_m0_if_sleeping(mt, wid)
    }
}

fn mt_broadcast_if_sleeping(mt int, wid int) {
    w_slp := atomic_load(c_ptr(mt + MT_SLEEPING)) > 0
    m0_slp := atomic_load(c_ptr(mt + MT_M0_SLEEPING)) != 0
    if !w_slp && !m0_slp { << }
    os := xu_target_os()
    if os == OS_LINUX {
        if w_slp {
            // FUTEX_WAKE_PRIVATE = 129, INT_MAX
            _ := rt_syscall(98, mt + MT_WAKE_SEQ, 129, 2147483647, 0, 0, 0)
        }
        if m0_slp {
            _ := rt_syscall(98, mt + MT_M0_WAKE_SEQ, 129, 1, 0, 0, 0)
        }
        <<
    }
    if os == OS_WINDOWS {
        mu := ld(mt + MT_MU)
        _ := win_callp(ld(mt + MT_FP_LOCK), mu, 0, 0, 0, 0, 0)
        if w_slp {
            _ := win_callp(ld(mt + MT_FP_BROADCAST), ld(mt + MT_CV), 0, 0, 0, 0, 0)
        }
        if m0_slp {
            _ := win_callp(ld(mt + MT_FP_SIGNAL), ld(mt + MT_M0_CV), 0, 0, 0, 0, 0)
        }
        _ := win_callp(ld(mt + MT_FP_UNLOCK), mu, 0, 0, 0, 0, 0)
        <<
    }
    $blk := 0
    $owned := false
    if wid >= 0 {
        blk = m_slot(mt, wid) + MT_M_FFI_BLK
    } else {
        blk = alloc(200)
        owned = true
    }
    mu := ld(mt + MT_MU)
    _ := mt_ccall1(blk, ld(mt + MT_FP_LOCK), mu)
    if w_slp {
        _ := mt_ccall1(blk, ld(mt + MT_FP_BROADCAST), ld(mt + MT_CV))
    }
    if m0_slp {
        _ := mt_ccall1(blk, ld(mt + MT_FP_SIGNAL), ld(mt + MT_M0_CV))
    }
    _ := mt_ccall1(blk, ld(mt + MT_FP_UNLOCK), mu)
    if owned { free(blk) }
}

fn mt_wake_all(mt int, wid int) {
    _ := atomic_add(c_ptr(mt + MT_WAKE_SEQ), 1)
    _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
    mt_broadcast_if_sleeping(mt, wid)
}

fn mt_park_m(mt int, wid int, seq int, m0_seq int) {
    // At most 2 idle Ms spin briefly; excess idle Ms sleep immediately to save CPU.
    old_sp := atomic_add(c_ptr(mt + MT_SPINNING), 1)
    if old_sp < 2 {
        $spin := 0
        while spin < 1000 {
            if atomic_load(c_ptr(mt + MT_WAKE_SEQ)) != seq || atomic_load(c_ptr(mt + MT_STOP)) != 0 {
                _ := atomic_add(c_ptr(mt + MT_SPINNING), -1)
                <<
            }
            if wid == 0 && atomic_load(c_ptr(mt + MT_M0_WAKE_SEQ)) != m0_seq {
                _ := atomic_add(c_ptr(mt + MT_SPINNING), -1)
                <<
            }
            rt_syscall(SYS_CPU_PAUSE, 0, 0, 0, 0, 0, 0)
            spin += 1
        }
    }
    _ := atomic_add(c_ptr(mt + MT_SPINNING), -1)
    if atomic_load(c_ptr(mt + MT_WAKE_SEQ)) != seq || atomic_load(c_ptr(mt + MT_STOP)) != 0 {
        <<
    }
    if wid == 0 && atomic_load(c_ptr(mt + MT_M0_WAKE_SEQ)) != m0_seq {
        <<
    }
    os := xu_target_os()
    if os == OS_LINUX {
        if wid == 0 {
            _ := atomic_add(c_ptr(mt + MT_M0_SLEEPING), 1)
            while atomic_load(c_ptr(mt + MT_WAKE_SEQ)) == seq && atomic_load(c_ptr(mt + MT_M0_WAKE_SEQ)) == m0_seq && atomic_load(c_ptr(mt + MT_STOP)) == 0 {
                _ := rt_syscall(98, mt + MT_M0_WAKE_SEQ, 128, m0_seq & 4294967295, 0, 0, 0)
            }
            _ := atomic_add(c_ptr(mt + MT_M0_SLEEPING), -1)
            <<
        }
        _ := atomic_add(c_ptr(mt + MT_SLEEPING), 1)
        while atomic_load(c_ptr(mt + MT_WAKE_SEQ)) == seq && atomic_load(c_ptr(mt + MT_STOP)) == 0 {
            // FUTEX_WAIT_PRIVATE = 128 on low 32 bits of MT_WAKE_SEQ.
            _ := rt_syscall(98, mt + MT_WAKE_SEQ, 128, seq & 4294967295, 0, 0, 0)
        }
        _ := atomic_add(c_ptr(mt + MT_SLEEPING), -1)
        <<
    }
    if os == OS_WINDOWS {
        mu := ld(mt + MT_MU)
        fp_lock := ld(mt + MT_FP_LOCK)
        fp_unlock := ld(mt + MT_FP_UNLOCK)
        fp_wait := ld(mt + MT_FP_WAIT)
        _ := win_callp(fp_lock, mu, 0, 0, 0, 0, 0)
        if wid == 0 {
            m0_cv := ld(mt + MT_M0_CV)
            _ := atomic_add(c_ptr(mt + MT_M0_SLEEPING), 1)
            while atomic_load(c_ptr(mt + MT_WAKE_SEQ)) == seq && atomic_load(c_ptr(mt + MT_M0_WAKE_SEQ)) == m0_seq && atomic_load(c_ptr(mt + MT_STOP)) == 0 {
                _ := win_callp(fp_wait, m0_cv, mu, 4294967295, 0, 0, 0)
            }
            _ := atomic_add(c_ptr(mt + MT_M0_SLEEPING), -1)
        } else {
            cv := ld(mt + MT_CV)
            _ := atomic_add(c_ptr(mt + MT_SLEEPING), 1)
            while atomic_load(c_ptr(mt + MT_WAKE_SEQ)) == seq && atomic_load(c_ptr(mt + MT_STOP)) == 0 {
                _ := win_callp(fp_wait, cv, mu, 4294967295, 0, 0, 0)
            }
            _ := atomic_add(c_ptr(mt + MT_SLEEPING), -1)
        }
        _ := win_callp(fp_unlock, mu, 0, 0, 0, 0, 0)
        <<
    }
    blk := m_slot(mt, wid) + MT_M_FFI_BLK
    mu := ld(mt + MT_MU)
    fp_lock := ld(mt + MT_FP_LOCK)
    fp_unlock := ld(mt + MT_FP_UNLOCK)
    fp_wait := ld(mt + MT_FP_WAIT)
    _ := mt_ccall1(blk, fp_lock, mu)
    if wid == 0 {
        m0_cv := ld(mt + MT_M0_CV)
        _ := atomic_add(c_ptr(mt + MT_M0_SLEEPING), 1)
        while atomic_load(c_ptr(mt + MT_WAKE_SEQ)) == seq && atomic_load(c_ptr(mt + MT_M0_WAKE_SEQ)) == m0_seq && atomic_load(c_ptr(mt + MT_STOP)) == 0 {
            _ := mt_ccall2(blk, fp_wait, m0_cv, mu)
        }
        _ := atomic_add(c_ptr(mt + MT_M0_SLEEPING), -1)
    } else {
        cv := ld(mt + MT_CV)
        _ := atomic_add(c_ptr(mt + MT_SLEEPING), 1)
        while atomic_load(c_ptr(mt + MT_WAKE_SEQ)) == seq && atomic_load(c_ptr(mt + MT_STOP)) == 0 {
            _ := mt_ccall2(blk, fp_wait, cv, mu)
        }
        _ := atomic_add(c_ptr(mt + MT_SLEEPING), -1)
    }
    _ := mt_ccall1(blk, fp_unlock, mu)
}

fn mt_spawn_worker(mt int, caller_wid int, spawn_wid int) {
    ms := m_slot(mt, spawn_wid)
    st(ms + MT_M_GLOBALS, rt_globals())
    st(ms + MT_M_WID, spawn_wid)
    st(ms + MT_M_CUR, 0)
    st(ms + MT_M_PTHREAD, 0)
    backend := ld(mt + MT_BACKEND)
    if backend == MT_BACKEND_LINUX_CLONE {
        stk := map_pages(G0_STACK)
        st(ms + MT_M_OS_STACK, stk)
        tls_p := ms + MT_M_TLS_SELF
        st(tls_p, tls_p)
        st(ms + MT_M_CTID, 0)
        // CLONE_VM|CLONE_FS|CLONE_FILES|CLONE_SIGHAND|CLONE_THREAD|CLONE_SYSVSEM|CLONE_SETTLS|CLONE_PARENT_SETTID|CLONE_CHILD_CLEARTID
        flags := 0x3D0F00
        tid := rt_syscall(SYS_LINUX_CLONE, flags, stk + G0_STACK, ms + MT_M_CTID, tls_p, ld(mt + MT_THREAD_ENTRY), ms)
        if tid <= 0 {
            unmap_pages(stk, G0_STACK)
            st(ms + MT_M_OS_STACK, 0)
            st(ms + MT_M_CTID, 0)
        }
    } else if backend == MT_BACKEND_WIN {
        // Pass G0_STACK as initial commit size (dwCreationFlags=0 keeps PE 16 MiB reserve)
        // so Windows worker threads do not eagerly commit PE SizeOfStackCommit (4 MiB) each.
        h := win_callp(ld(mt + MT_FP_CREATE), 0, G0_STACK, ld(mt + MT_THREAD_ENTRY), ms, 0, 0)
        st(ms + MT_M_PTHREAD, h)
    } else {
        blk := m_slot(mt, caller_wid) + MT_M_FFI_BLK
        r := mt_ccall4(blk, ld(mt + MT_FP_CREATE), ms + MT_M_PTHREAD, 0, ld(mt + MT_THREAD_ENTRY), ms)
        if (r & 4294967295) != 0 {
            st(ms + MT_M_PTHREAD, 0)
        }
    }
    _ := atomic_add(c_ptr(mt + MT_SPAWNING), -1)
}

pub fn task_empty_args() int {
    << sched() + S_EMPTY_ARGS
}

fn progress_locked(s int, mt int) {
    _ := atomic_add(c_ptr(s + S_EPOCH), 1)
    st(s + S_NBLOCKED, 0)
    st(s + S_IO_IDLE, 0)
    if mt != 0 {
        $b := ld(mt + MT_BLK_HEAD)
        $n_sel := 0
        while b != 0 {
            nx := ld(b + T_NEXT)
            st(b + T_NEXT, 0)
            st(b + T_SEEN_EPOCH, 0)
            if b == ld(mt + MT_MAIN_TASK) {
                atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
            } else {
                queue_push(s, b)
                _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), 1)
            }
            n_sel += 1
            b = nx
        }
        st(mt + MT_BLK_HEAD, 0)
        st(mt + MT_BLK_TAIL, 0)
        if n_sel > 0 {
            _ := atomic_add(c_ptr(mt + MT_SEL_BLK_COUNT), 0 - n_sel)
            _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), 0 - n_sel)
        }
        if atomic_load(c_ptr(mt + MT_DRAIN_WAITER)) != 0 && atomic_load(c_ptr(s + S_NTASKS)) <= 1 {
            atomic_store(c_ptr(mt + MT_DRAIN_WAITER), 0)
            atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
        }
    }
}

fn mt_wake_select_waiters(s int, mt int, wid int) {
    if atomic_load(c_ptr(mt + MT_SEL_BLK_COUNT)) <= 0 { << }
    $woke := false
    spin_lock(G_SCHED_LOCK)
    $b := ld(mt + MT_BLK_HEAD)
    $n_sel := 0
    while b != 0 {
        nx := ld(b + T_NEXT)
        st(b + T_NEXT, 0)
        st(b + T_SEEN_EPOCH, 0)
        if b == ld(mt + MT_MAIN_TASK) {
            atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
        } else {
            queue_push(s, b)
            _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), 1)
        }
        n_sel += 1
        b = nx
    }
    st(mt + MT_BLK_HEAD, 0)
    st(mt + MT_BLK_TAIL, 0)
    if n_sel > 0 {
        _ := atomic_add(c_ptr(mt + MT_SEL_BLK_COUNT), 0 - n_sel)
        _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), 0 - n_sel)
        _ := atomic_add(c_ptr(mt + MT_WAKE_SEQ), 1)
        _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
        woke = true
    }
    spin_unlock(G_SCHED_LOCK)
    if woke {
        mt_broadcast_if_sleeping(mt, wid)
        mt_maybe_spawn_worker(s, mt, wid)
    }
}

fn progress() {
    s := sched()
    mt := sched_m_state()
    if mt != 0 {
        wid := current_m_strict(mt)
        spin_lock(G_SCHED_LOCK)
        progress_locked(s, mt)
        spin_unlock(G_SCHED_LOCK)
        mt_wake_all(mt, wid)
        <<
    }
    st(s + S_EPOCH, ld(s + S_EPOCH) + 1)
    st(s + S_NBLOCKED, 0)
    st(s + S_IO_IDLE, 0)
}

pub fn task_io_progress() {
    s := gword(G_SCHED)
    if s != 0 {
        mt := sched_m_state()
        if mt != 0 {
            wid := current_m_strict(mt)
            spin_lock(G_SCHED_LOCK)
            progress_locked(s, mt)
            spin_unlock(G_SCHED_LOCK)
            mt_wake_all(mt, wid)
            <<
        }
        progress()
    }
}

pub fn task_es_enter() {
    s := sched()
    if rt_mt_active() {
        _ := atomic_add(c_ptr(s + S_ES_DEPTH), 1)
        <<
    }
    st(s + S_ES_DEPTH, ld(s + S_ES_DEPTH) + 1)
}

pub fn task_es_leave() {
    s := sched()
    if rt_mt_active() {
        _ := atomic_add(c_ptr(s + S_ES_DEPTH), -1)
        <<
    }
    d := ld(s + S_ES_DEPTH)
    if d > 0 {
        st(s + S_ES_DEPTH, d - 1)
    }
}

fn queue_push(s int, t int) {
    st(t + T_NEXT, 0)
    tail := ld(s + S_TAIL)
    st(t + T_PREV, tail)
    if tail == 0 {
        st(s + S_HEAD, t)
    } else {
        st(tail + T_NEXT, t)
    }
    st(s + S_TAIL, t)
    st(s + S_RUNQ_LEN, ld(s + S_RUNQ_LEN) + 1)
}

fn queue_pop(s int) int {
    t := ld(s + S_HEAD)
    if t != 0 {
        nx := ld(t + T_NEXT)
        st(s + S_HEAD, nx)
        if nx == 0 {
            st(s + S_TAIL, 0)
        } else {
            st(nx + T_PREV, 0)
        }
        st(t + T_PREV, 0)
        st(t + T_NEXT, 0)
        qlen := ld(s + S_RUNQ_LEN)
        if qlen > 0 { st(s + S_RUNQ_LEN, qlen - 1) }
    }
    << t
}

fn queue_unlink(s int, target int) bool {
    if target == 0 {
        << false
    }
    prev := ld(target + T_PREV)
    if prev == 0 && ld(s + S_HEAD) != target {
        << false
    }
    nx := ld(target + T_NEXT)
    if prev == 0 {
        st(s + S_HEAD, nx)
    } else {
        st(prev + T_NEXT, nx)
    }
    if nx == 0 {
        st(s + S_TAIL, prev)
    } else {
        st(nx + T_PREV, prev)
    }
    st(target + T_PREV, 0)
    st(target + T_NEXT, 0)
    qlen := ld(s + S_RUNQ_LEN)
    if qlen > 0 { st(s + S_RUNQ_LEN, qlen - 1) }
    << true
}

fn sched_pop_next(s int) int {
    aff := ld(s + S_AFFINITY)
    if aff != 0 {
        st(s + S_AFFINITY, 0)
        << aff
    }
    st(s + S_AFFINITY_TICKS, 0)
    << queue_pop(s)
}

fn switch_to(from int, to int) {
    if from == to {
        <<
    }
    if xu_target_arch() == ARCH_WASM {
        msg := "fatal error: tasks cannot switch on wasm32 (no stack switching)\n"
        write_fd(2, str_ptr(&msg), msg.len)
        exit_process(2)
    }
    st(sched() + S_CUR, to)
    rt_syscall(SYS_TASK_SWITCH, from, to, 0, 0, 0, 0)
}

fn fatal_deadlock() {
    msg := "fatal error: all tasks are asleep - deadlock!\n"
    write_fd(2, str_ptr(&msg), msg.len)
    exit_process(2)
}

fn enqueue_runnable_locked(s int, mt int, t int) {
    st(t + T_NEXT, 0)
    st(t + T_SEEN_EPOCH, 0)
    if t == ld(mt + MT_MAIN_TASK) {
        atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
    } else {
        queue_push(s, t)
        _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), 1)
    }
}

fn blk_push_locked(mt int, t int) {
    st(t + T_NEXT, 0)
    tail := ld(mt + MT_BLK_TAIL)
    if tail == 0 {
        st(mt + MT_BLK_HEAD, t)
    } else {
        st(tail + T_NEXT, t)
    }
    st(mt + MT_BLK_TAIL, t)
}

fn mt_maybe_spawn_worker(s int, mt int, wid int) {
    if wid < 0 { << }
    if atomic_load(c_ptr(mt + MT_SPAWNED_M)) >= atomic_load(c_ptr(mt + MT_NPROCS)) { << }
    if atomic_load(c_ptr(mt + MT_STOP)) != 0 { << }
    runnable := atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE))
    spawned := atomic_load(c_ptr(mt + MT_SPAWNED_M))
    active := atomic_load(c_ptr(mt + MT_ACTIVE_M))
    if runnable <= spawned - active { << }
    $spawn_wid := -1
    spin_lock(G_SCHED_LOCK)
    sp := atomic_load(c_ptr(mt + MT_SPAWNED_M))
    if sp < atomic_load(c_ptr(mt + MT_NPROCS)) && atomic_load(c_ptr(mt + MT_STOP)) == 0 {
        idle_m := sp - atomic_load(c_ptr(mt + MT_ACTIVE_M))
        if atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) > idle_m {
            spawn_wid = sp
            atomic_store(c_ptr(mt + MT_SPAWNED_M), sp + 1)
            _ := atomic_add(c_ptr(mt + MT_SPAWNING), 1)
        }
    }
    spin_unlock(G_SCHED_LOCK)
    if spawn_wid > 0 {
        mt_spawn_worker(mt, wid, spawn_wid)
    }
}

// Push a detached T_NEXT-linked chain onto the global runqueue.
// When add_total is true, MT_TOTAL_RUNNABLE is incremented by cnt.
fn global_push_chain(s int, mt int, head int, tail int, cnt int, add_total bool) {
    if head == 0 || cnt <= 0 { << }
    if add_total {
        _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), cnt)
    }
    spin_lock(G_SCHED_LOCK)
    st(tail + T_NEXT, 0)
    gtail := ld(s + S_TAIL)
    st(head + T_PREV, gtail)
    if gtail == 0 {
        st(s + S_HEAD, head)
    } else {
        st(gtail + T_NEXT, head)
    }
    st(s + S_TAIL, tail)
    st(s + S_RUNQ_LEN, ld(s + S_RUNQ_LEN) + cnt)
    spin_unlock(G_SCHED_LOCK)
}

fn global_push_one(s int, mt int, wid int, t int) {
    st(t + T_NEXT, 0)
    st(t + T_PREV, 0)
    st(t + T_SEEN_EPOCH, 0)
    if t == ld(mt + MT_MAIN_TASK) {
        atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
        _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
        mt_wake_m0_if_sleeping(mt, wid)
        <<
    }
    global_push_chain(s, mt, t, t, 1, true)
    _ := atomic_add(c_ptr(mt + MT_WAKE_SEQ), 1)
    mt_signal_one_if_sleeping(mt, wid)
}

// GMP per-M local runqueue push (never nests M_RQ_LOCK with G_SCHED_LOCK).
// When wake is false (immediate local handoff), returns true if an older
// runnext task was displaced and therefore a peer M was woken for it.
fn local_push_inner(s int, mt int, wid int, t int, as_next bool, wake bool) bool {
    st(t + T_NEXT, 0)
    st(t + T_PREV, 0)
    st(t + T_SEEN_EPOCH, 0)
    if t == ld(mt + MT_MAIN_TASK) {
        atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
        if wake || wid != 0 {
            _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
            mt_wake_m0_if_sleeping(mt, wid)
            << true
        }
        << false
    }
    if wid < 0 {
        global_push_one(s, mt, wid, t)
        << true
    }
    ms := m_slot(mt, wid)
    buf := atomic_load(c_ptr(ms + MT_M_RQ_BUF))
    if buf == 0 {
        global_push_one(s, mt, wid, t)
        << true
    }
    _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), 1)
    $ov_head := 0
    $ov_tail := 0
    $ov_cnt := 0
    $displaced := false
    spin_lock_addr(ms + MT_M_RQ_LOCK)
    $to_ring := t
    if as_next {
        old := ld(ms + MT_M_RUNNEXT)
        st(ms + MT_M_RUNNEXT, t)
        to_ring = old
        if old != 0 { displaced = true }
    }
    if to_ring != 0 {
        h := ld(ms + MT_M_RQ_HEAD)
        tl := ld(ms + MT_M_RQ_TAIL)
        if tl - h < MT_RQ_CAP {
            st(buf + (tl & MT_RQ_MASK) * 8, to_ring)
            st(ms + MT_M_RQ_TAIL, tl + 1)
        } else {
            // Overflow half of the local ring plus to_ring to the global queue.
            for i in 0:MT_RQ_HALF {
                x := ld(buf + ((h + i) & MT_RQ_MASK) * 8)
                st(x + T_NEXT, 0)
                st(x + T_PREV, ov_tail)
                if ov_tail == 0 {
                    ov_head = x
                } else {
                    st(ov_tail + T_NEXT, x)
                }
                ov_tail = x
            }
            st(ms + MT_M_RQ_HEAD, h + MT_RQ_HALF)
            st(to_ring + T_NEXT, 0)
            st(to_ring + T_PREV, ov_tail)
            st(ov_tail + T_NEXT, to_ring)
            ov_tail = to_ring
            ov_cnt = MT_RQ_HALF + 1
        }
    }
    spin_unlock_addr(ms + MT_M_RQ_LOCK)
    if ov_cnt > 0 {
        global_push_chain(s, mt, ov_head, ov_tail, ov_cnt, false)
    }
    if wake || displaced || ov_cnt > 0 {
        _ := atomic_add(c_ptr(mt + MT_WAKE_SEQ), 1)
        mt_signal_one_if_sleeping(mt, wid)
        << true
    }
    << false
}

fn local_push(s int, mt int, wid int, t int, as_next bool) {
    _ := local_push_inner(s, mt, wid, t, as_next, true)
}

fn local_pop(mt int, wid int) int {
    ms := m_slot(mt, wid)
    if ld(ms + MT_M_RUNNEXT) == 0 && ld(ms + MT_M_RQ_HEAD) == ld(ms + MT_M_RQ_TAIL) {
        << 0
    }
    $t := 0
    spin_lock_addr(ms + MT_M_RQ_LOCK)
    t = ld(ms + MT_M_RUNNEXT)
    if t != 0 {
        st(ms + MT_M_RUNNEXT, 0)
    } else {
        h := ld(ms + MT_M_RQ_HEAD)
        tl := ld(ms + MT_M_RQ_TAIL)
        if h < tl {
            t = ld(ld(ms + MT_M_RQ_BUF) + (h & MT_RQ_MASK) * 8)
            st(ms + MT_M_RQ_HEAD, h + 1)
        }
    }
    spin_unlock_addr(ms + MT_M_RQ_LOCK)
    if t != 0 {
        _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), -1)
    }
    << t
}

fn local_push_batch_from_chain(s int, mt int, wid int, head int) {
    if head == 0 { << }
    ms := m_slot(mt, wid)
    buf := ld(ms + MT_M_RQ_BUF)
    $rem_head := 0
    $rem_tail := 0
    $rem_cnt := 0
    spin_lock_addr(ms + MT_M_RQ_LOCK)
    $cur := head
    while cur != 0 {
        nx := ld(cur + T_NEXT)
        st(cur + T_NEXT, 0)
        st(cur + T_PREV, 0)
        h := ld(ms + MT_M_RQ_HEAD)
        tl := ld(ms + MT_M_RQ_TAIL)
        if buf != 0 && tl - h < MT_RQ_CAP {
            st(buf + (tl & MT_RQ_MASK) * 8, cur)
            st(ms + MT_M_RQ_TAIL, tl + 1)
        } else {
            st(cur + T_PREV, rem_tail)
            if rem_tail == 0 {
                rem_head = cur
            } else {
                st(rem_tail + T_NEXT, cur)
            }
            rem_tail = cur
            rem_cnt += 1
        }
        cur = nx
    }
    spin_unlock_addr(ms + MT_M_RQ_LOCK)
    if rem_cnt > 0 {
        global_push_chain(s, mt, rem_head, rem_tail, rem_cnt, false)
    }
}

fn global_pop_batch(s int, mt int, wid int) int {
    if atomic_load(c_ptr(s + S_RUNQ_LEN)) == 0 { << 0 }
    $first := 0
    $bh := 0
    $bt := 0
    spin_lock(G_SCHED_LOCK)
    first = queue_pop(s)
    if first != 0 {
        $want := ld(s + S_RUNQ_LEN) / 2
        if want > 64 { want = 64 }
        for _ in 0:want {
            x := queue_pop(s)
            if x == 0 { <- }
            st(x + T_NEXT, 0)
            if bt == 0 {
                bh = x
            } else {
                st(bt + T_NEXT, x)
            }
            bt = x
        }
    }
    spin_unlock(G_SCHED_LOCK)
    if first == 0 { << 0 }
    _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), -1)
    if bh != 0 {
        local_push_batch_from_chain(s, mt, wid, bh)
    }
    << first
}

// Steal half of a random peer's local runqueue (or its runnext as fallback).
// Never holds two M_RQ_LOCKs at the same time.
fn steal_work(s int, mt int, wid int) int {
    spawned := atomic_load(c_ptr(mt + MT_SPAWNED_M))
    if spawned <= 1 { << 0 }
    ms := m_slot(mt, wid)
    $r := ld(ms + MT_M_RAND)
    if r == 0 {
        r = 0x1e3779b97f4a7c15 ^ ((wid + 1) * 0x517cc1b727220a95)
    }
    r = r ^ (r << 13)
    r = r ^ (r >> 7)
    r = r ^ (r << 17)
    st(ms + MT_M_RAND, r)
    start := (r & 0x7fffffffffffffff) % spawned
    for i in 0:spawned {
        v := (start + i) % spawned
        if v == wid { -> }
        vs := m_slot(mt, v)
        if atomic_load(c_ptr(vs + MT_M_RQ_BUF)) == 0 { -> }
        if atomic_load(c_ptr(vs + MT_M_RQ_TAIL)) <= atomic_load(c_ptr(vs + MT_M_RQ_HEAD)) && atomic_load(c_ptr(vs + MT_M_RUNNEXT)) == 0 {
            ->
        }
        $stolen := 0
        $bh := 0
        $bt := 0
        spin_lock_addr(vs + MT_M_RQ_LOCK)
        vbuf := ld(vs + MT_M_RQ_BUF)
        if vbuf != 0 {
            h := ld(vs + MT_M_RQ_HEAD)
            tl := ld(vs + MT_M_RQ_TAIL)
            n := tl - h
            if n > 0 {
                $k := (n + 1) / 2
                if k > 64 { k = 64 }
                stolen = ld(vbuf + (h & MT_RQ_MASK) * 8)
                for j in 1:k {
                    x := ld(vbuf + ((h + j) & MT_RQ_MASK) * 8)
                    st(x + T_NEXT, 0)
                    if bt == 0 {
                        bh = x
                    } else {
                        st(bt + T_NEXT, x)
                    }
                    bt = x
                }
                st(vs + MT_M_RQ_HEAD, h + k)
            } else {
                rn := ld(vs + MT_M_RUNNEXT)
                if rn != 0 {
                    st(vs + MT_M_RUNNEXT, 0)
                    stolen = rn
                }
            }
        }
        spin_unlock_addr(vs + MT_M_RQ_LOCK)
        if stolen != 0 {
            _ := atomic_add(c_ptr(mt + MT_TOTAL_RUNNABLE), -1)
            if bh != 0 {
                local_push_batch_from_chain(s, mt, wid, bh)
            }
            << stolen
        }
    }
    << 0
}

fn chan_push_swait_locked(ch int, t int) {
    st(t + T_WAIT_CH_NEXT, 0)
    tail := ld(ch + C_SWAIT_TAIL)
    if tail == 0 {
        st(ch + C_SWAIT_HEAD, t)
    } else {
        st(tail + T_WAIT_CH_NEXT, t)
    }
    st(ch + C_SWAIT_TAIL, t)
}

fn chan_pop_swait_locked(ch int) int {
    t := ld(ch + C_SWAIT_HEAD)
    if t != 0 {
        nx := ld(t + T_WAIT_CH_NEXT)
        st(ch + C_SWAIT_HEAD, nx)
        if nx == 0 { st(ch + C_SWAIT_TAIL, 0) }
        st(t + T_WAIT_CH_NEXT, 0)
    }
    << t
}

fn chan_push_rwait_locked(ch int, t int) {
    st(t + T_WAIT_CH_NEXT, 0)
    tail := ld(ch + C_RWAIT_TAIL)
    if tail == 0 {
        st(ch + C_RWAIT_HEAD, t)
    } else {
        st(tail + T_WAIT_CH_NEXT, t)
    }
    st(ch + C_RWAIT_TAIL, t)
}

fn chan_pop_rwait_locked(ch int) int {
    t := ld(ch + C_RWAIT_HEAD)
    if t != 0 {
        nx := ld(t + T_WAIT_CH_NEXT)
        st(ch + C_RWAIT_HEAD, nx)
        if nx == 0 { st(ch + C_RWAIT_TAIL, 0) }
        st(t + T_WAIT_CH_NEXT, 0)
    }
    << t
}

fn chan_wake_one(s int, mt int, wid int, t int, as_next bool) {
    if t == 0 { << }
    st(t + T_WAIT_CH_NEXT, 0)
    _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), -1)
    local_push(s, mt, wid, t, as_next)
    mt_maybe_spawn_worker(s, mt, wid)
}

// Local-handoff variant for unbuffered sends that are immediately about to park
// on the calling M: avoids waking a sleeping OS worker when only t is runnable.
fn chan_wake_one_local(s int, mt int, wid int, t int, as_next bool) bool {
    if t == 0 { << false }
    st(t + T_WAIT_CH_NEXT, 0)
    _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), -1)
    woke := local_push_inner(s, mt, wid, t, as_next, false)
    if woke {
        mt_maybe_spawn_worker(s, mt, wid)
    }
    << woke
}

fn chan_wake_list(s int, mt int, wid int, head int) {
    $cur := head
    while cur != 0 {
        nx := ld(cur + T_WAIT_CH_NEXT)
        st(cur + T_WAIT_CH_NEXT, 0)
        chan_wake_one(s, mt, wid, cur, false)
        cur = nx
    }
}

fn chan_notify_epoch_mt(s int, mt int, wid int) {
    _ := atomic_add(c_ptr(s + S_EPOCH), 1)
    if atomic_load(c_ptr(mt + MT_SEL_BLK_COUNT)) > 0 {
        mt_wake_select_waiters(s, mt, wid)
    }
}

// Detach args and optional evicted stack under G_SCHED_LOCK; caller releases
// them after unlocking so munmap/free never run under the scheduler spinlock.
fn recycle_exited_task_locked(s int, t int, out_args $&int, out_evict $&int) {
    args := ld(t + T_ARGS)
    if args != s + S_EMPTY_ARGS {
        *out_args = args
    }
    st(t + T_ARGS, 0)
    if ld(t + T_IS_TINY) != 0 {
        st(t + T_NEXT, ld(s + S_TINY_FREE))
        st(s + S_TINY_FREE, t)
    } else {
        $head := ld(s + S_FREE)
        cached := ld(s + S_FREE_COUNT)
        os := xu_target_os()
        if cached >= TASK_STACK_CACHE_LIMIT && (os == OS_LINUX || os == OS_MACOS || os == OS_WINDOWS) {
            old := head
            head = ld(old + T_NEXT)
            *out_evict = old
        } else {
            st(s + S_FREE_COUNT, cached + 1)
        }
        st(t + T_NEXT, head)
        st(s + S_FREE, t)
    }
}

fn sched_poll_waiters_mt(s int, mt int, wid int, blocking bool) bool {
    cnt := ld(s + S_WAIT_COUNT)
    if cnt <= 0 || ld(mt + MT_POLLING) != 0 {
        << false
    }
    st(mt + MT_POLLING, 1)
    $cap := ld(s + S_POLL_CAP)
    $pfd := ld(s + S_POLL_PFD)
    $tasks := ld(s + S_POLL_TASKS)
    if cnt > cap {
        ncap := max_int(cnt, 32)
        if pfd != 0 { free(pfd) }
        if tasks != 0 { free(tasks) }
        pfd = alloc(ncap * 8)
        tasks = alloc(ncap * 8)
        st(s + S_POLL_PFD, pfd)
        st(s + S_POLL_TASKS, tasks)
        st(s + S_POLL_CAP, ncap)
    }
    $curr := ld(s + S_WAIT_HEAD)
    $i := 0
    $earliest_deadline := 0
    $now := host_now_ns()
    while curr != 0 && i < cnt {
        fd := ld(curr + T_WAIT_FD)
        events := ld(curr + T_WAIT_EVENTS)
        deadline := ld(curr + T_WAIT_DEADLINE)
        rt_store(pfd + i * 8, 8, fd | ((events & 65535) << 32))
        rt_store(tasks + i * 8, 8, curr)
        if deadline > 0 {
            if earliest_deadline == 0 || deadline < earliest_deadline {
                earliest_deadline = deadline
            }
        }
        curr = ld(curr + T_WAIT_NEXT)
        i += 1
    }
    actual_cnt := i
    st(s + S_WAIT_HEAD, 0)
    st(s + S_WAIT_TAIL, 0)
    st(s + S_WAIT_COUNT, 0)
    if actual_cnt == 0 {
        st(mt + MT_POLLING, 0)
        << false
    }
    $timeout_ms := 0
    if blocking {
        if earliest_deadline > 0 {
            rem_ns := earliest_deadline - now
            if rem_ns <= 0 {
                timeout_ms = 0
            } else {
                timeout_ms = min_int((rem_ns + 999999) / 1000000, 2147483647)
            }
        } else {
            timeout_ms = -1
        }
        if atomic_load(c_ptr(mt + MT_ACTIVE_M)) > 0 || wid > 0 || atomic_load(c_ptr(s + S_DRAIN)) != 0 {
            if timeout_ms < 0 || timeout_ms > 5 { timeout_ms = 5 }
        }
    }
    spin_unlock(G_SCHED_LOCK)
    r := host_poll_batch(pfd, tasks, actual_cnt, timeout_ms)
    spin_lock(G_SCHED_LOCK)
    st(mt + MT_POLLING, 0)
    if r < 0 && r != 0 - EINTR {
        for j in 0:actual_cnt {
            t := rt_load(tasks + j * 8, 8)
            st(t + T_WAIT_REVENTS, r)
            enqueue_runnable_locked(s, mt, t)
        }
        progress_locked(s, mt)
        << true
    }
    now = host_now_ns()
    $woken := 0
    for j in 0:actual_cnt {
        t := rt_load(tasks + j * 8, 8)
        pollfd := rt_load(pfd + j * 8, 8)
        revents := (pollfd >> 48) & 65535
        deadline := ld(t + T_WAIT_DEADLINE)
        $ready := -1
        if (revents & 32) != 0 {
            ready = 0 - EBADF
        } else if revents != 0 {
            ready = revents
        } else if deadline > 0 && now >= deadline {
            ready = 0
        }
        if ready != -1 {
            st(t + T_WAIT_REVENTS, ready)
            enqueue_runnable_locked(s, mt, t)
            woken += 1
        } else {
            st(t + T_WAIT_NEXT, 0)
            waiter_add(s, t, ld(t + T_WAIT_FD), ld(t + T_WAIT_EVENTS), deadline)
        }
    }
    if woken > 0 { progress_locked(s, mt) }
    << woken > 0
}

fn sched_m_loop(wid int) {
    s := sched()
    mt := ld(s + S_MT_STATE)
    ms := m_slot(mt, wid)
    g0 := ld(ms + MT_M_G0)
    while true {
        $free_args := 0
        $evict_t := 0
        $wake_peers := false
        $yielded_main := false
        atomic_store(c_ptr(ms + MT_M_CUR), 0)
        pt := ld(ms + MT_M_PARK_TASK)
        if pt != 0 {
            st(ms + MT_M_PARK_TASK, 0)
            pm := ld(ms + MT_M_PARK_MODE)
            if pm == PARK_YIELD {
                if pt == ld(mt + MT_MAIN_TASK) {
                    yielded_main = true
                    atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
                } else if atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) > 0 {
                    global_push_one(s, mt, wid, pt)
                } else {
                    local_push(s, mt, wid, pt, false)
                }
                _ := atomic_add(c_ptr(mt + MT_ACTIVE_M), -1)
            } else if pm == PARK_CHAN_SEND || pm == PARK_CHAN_RECV || pm == PARK_CHAN_UNBUF {
                ch := ld(ms + MT_M_PARK_ARG)
                $requeue := false
                chan_lock(ch)
                if pm == PARK_CHAN_SEND {
                    if ld(ch + C_CLOSED) != 0 || ld(ch + C_COUNT) < chan_slots(ch) {
                        requeue = true
                    } else {
                        chan_push_swait_locked(ch, pt)
                        _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), 1)
                    }
                } else if pm == PARK_CHAN_RECV {
                    if ld(ch + C_COUNT) > 0 || ld(ch + C_CLOSED) != 0 {
                        requeue = true
                    } else {
                        chan_push_rwait_locked(ch, pt)
                        _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), 1)
                    }
                } else {
                    if ld(ch + C_RECVD) >= ld(pt + T_WAIT_MINE) || ld(ch + C_CLOSED) != 0 {
                        requeue = true
                    } else {
                        st(ch + C_UNBUF_WAITER, pt)
                        _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), 1)
                    }
                }
                chan_unlock(ch)
                if requeue {
                    local_push(s, mt, wid, pt, false)
                }
                _ := atomic_add(c_ptr(mt + MT_ACTIVE_M), -1)
            } else {
                spin_lock(G_SCHED_LOCK)
                if pm == PARK_BLOCK {
                    bep := ld(ms + MT_M_PARK_ARG)
                    _ := atomic_add(c_ptr(mt + MT_SEL_BLK_COUNT), 1)
                    if bep != atomic_load(c_ptr(s + S_EPOCH)) {
                        _ := atomic_add(c_ptr(mt + MT_SEL_BLK_COUNT), -1)
                        enqueue_runnable_locked(s, mt, pt)
                    } else {
                        blk_push_locked(mt, pt)
                        _ := atomic_add(c_ptr(mt + MT_BLK_COUNT), 1)
                    }
                } else if pm == PARK_DRAIN {
                    nt := atomic_load(c_ptr(s + S_NTASKS))
                    if nt <= 1 || (atomic_load(c_ptr(mt + MT_ACTIVE_M)) <= 1 && atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) == 0 && ld(s + S_WAIT_COUNT) == 0 && ld(mt + MT_POLLING) == 0 && atomic_load(c_ptr(mt + MT_BLK_COUNT)) >= nt - 1) {
                        atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
                        wake_peers = true
                    } else {
                        atomic_store(c_ptr(mt + MT_DRAIN_WAITER), 1)
                    }
                } else if pm == PARK_WAIT_IO {
                    waiter_add(s, pt, ld(pt + T_WAIT_FD), ld(pt + T_WAIT_EVENTS), ld(pt + T_WAIT_DEADLINE))
                } else if pm == PARK_EXIT {
                    _ := atomic_add(c_ptr(s + S_NTASKS), -1)
                    recycle_exited_task_locked(s, pt, $&free_args, $&evict_t)
                    progress_locked(s, mt)
                    wake_peers = true
                }
                _ := atomic_add(c_ptr(mt + MT_ACTIVE_M), -1)
                spin_unlock(G_SCHED_LOCK)
                if free_args != 0 { free_owned(free_args) }
                if evict_t != 0 {
                    unmap_pages(ld(evict_t + T_STACK), task_stack())
                    free_owned(evict_t)
                }
                if wake_peers {
                    mt_wake_all(mt, wid)
                }
            }
        }
        if wid > 0 && atomic_load(c_ptr(mt + MT_STOP)) != 0 {
            <<
        }

        // Fast path: pick next task using per-M local runqueue and work-stealing.
        // Capture MT_WAKE_SEQ (and MT_M0_WAKE_SEQ on M0) *before* scanning queues
        // for Dekker wakeup safety.
        $seq := atomic_load(c_ptr(mt + MT_WAKE_SEQ))
        $m0_seq := 0
        if wid == 0 {
            m0_seq = atomic_load(c_ptr(mt + MT_M0_WAKE_SEQ))
        }
        $nx := 0
        if wid == 0 && !yielded_main && atomic_load(c_ptr(mt + MT_MAIN_READY)) != 0 && atomic_load(c_ptr(mt + MT_DRAIN_WAITER)) == 0 {
            if atomic_load(c_ptr(s + S_DRAIN)) == 0 || atomic_load(c_ptr(s + S_NTASKS)) <= 1 || atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) == 0 {
                if atomic_cas(c_ptr(mt + MT_MAIN_READY), 1, 0) {
                    nx = ld(mt + MT_MAIN_TASK)
                }
            }
        }
        tick := ld(ms + MT_M_TICK) + 1
        st(ms + MT_M_TICK, tick)
        if nx == 0 && (tick % 61) == 0 {
            nx = global_pop_batch(s, mt, wid)
        }
        if nx == 0 {
            nx = local_pop(mt, wid)
        }
        if nx == 0 {
            nx = global_pop_batch(s, mt, wid)
        }
        if nx == 0 {
            nx = steal_work(s, mt, wid)
        }
        if nx == 0 && wid == 0 && yielded_main && atomic_load(c_ptr(mt + MT_MAIN_READY)) != 0 && atomic_load(c_ptr(mt + MT_DRAIN_WAITER)) == 0 {
            if atomic_cas(c_ptr(mt + MT_MAIN_READY), 1, 0) {
                nx = ld(mt + MT_MAIN_TASK)
            }
        }
        if nx != 0 {
            st(nx + T_SEEN_EPOCH, 0)
            _ := atomic_add(c_ptr(mt + MT_ACTIVE_M), 1)
            atomic_store(c_ptr(ms + MT_M_CUR), nx)
            if wid == 0 { st(s + S_CUR, nx) }
            if atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) > 0 {
                if atomic_load(c_ptr(mt + MT_SPINNING)) == 0 && (atomic_load(c_ptr(mt + MT_SLEEPING)) > 0 || (wid > 0 && atomic_load(c_ptr(mt + MT_M0_SLEEPING)) != 0)) {
                    _ := atomic_add(c_ptr(mt + MT_WAKE_SEQ), 1)
                    mt_signal_one_if_sleeping(mt, wid)
                }
            }
            if wid > 0 && atomic_load(c_ptr(mt + MT_MAIN_READY)) != 0 && atomic_load(c_ptr(mt + MT_M0_SLEEPING)) != 0 {
                _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
                mt_wake_m0_if_sleeping(mt, wid)
            }
            rt_syscall(SYS_TASK_SWITCH, g0, nx, 0, 0, 0, 0)
            ->
        }

        // Slow path: I/O polling, drain completion, deadlock check, or park M.
        spin_lock(G_SCHED_LOCK)
        if atomic_load(c_ptr(mt + MT_DRAIN_WAITER)) != 0 {
            nt := atomic_load(c_ptr(s + S_NTASKS))
            if nt <= 1 || (atomic_load(c_ptr(mt + MT_ACTIVE_M)) == 0 && atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) == 0 && ld(s + S_WAIT_COUNT) == 0 && ld(mt + MT_POLLING) == 0 && atomic_load(c_ptr(mt + MT_BLK_COUNT)) >= nt - 1) {
                atomic_store(c_ptr(mt + MT_DRAIN_WAITER), 0)
                atomic_store(c_ptr(mt + MT_MAIN_READY), 1)
                _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
                spin_unlock(G_SCHED_LOCK)
                mt_wake_m0_if_sleeping(mt, wid)
                ->
            }
        }
        if ld(s + S_WAIT_COUNT) > 0 && ld(mt + MT_POLLING) == 0 {
            woke := sched_poll_waiters_mt(s, mt, wid, true)
            if woke {
                _ := atomic_add(c_ptr(mt + MT_WAKE_SEQ), 1)
                _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
            }
            spin_unlock(G_SCHED_LOCK)
            if woke { mt_broadcast_if_sleeping(mt, wid) }
            ->
        }
        if atomic_load(c_ptr(mt + MT_WAKE_SEQ)) != seq || (wid == 0 && atomic_load(c_ptr(mt + MT_M0_WAKE_SEQ)) != m0_seq) || atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) > 0 || (wid == 0 && atomic_load(c_ptr(mt + MT_MAIN_READY)) != 0 && atomic_load(c_ptr(mt + MT_DRAIN_WAITER)) == 0) {
            spin_unlock(G_SCHED_LOCK)
            ->
        }
        if atomic_load(c_ptr(mt + MT_ACTIVE_M)) == 0 && atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) == 0 && atomic_load(c_ptr(mt + MT_MAIN_READY)) == 0 && ld(s + S_WAIT_COUNT) == 0 && ld(mt + MT_POLLING) == 0 && atomic_load(c_ptr(s + S_DRAIN)) == 0 && atomic_load(c_ptr(mt + MT_BLK_COUNT)) >= atomic_load(c_ptr(s + S_NTASKS)) && !rt_signal_has_waiters() {
            spin_unlock(G_SCHED_LOCK)
            fatal_deadlock()
        }
        need_wake_m0 := wid > 0 && atomic_load(c_ptr(mt + MT_MAIN_READY)) != 0
        if need_wake_m0 {
            _ := atomic_add(c_ptr(mt + MT_M0_WAKE_SEQ), 1)
        }
        spin_unlock(G_SCHED_LOCK)
        if need_wake_m0 { mt_wake_m0_if_sleeping(mt, wid) }
        if wid > 0 && atomic_load(c_ptr(mt + MT_STOP)) != 0 {
            <<
        }
        mt_park_m(mt, wid, seq, m0_seq)
    }
}

fn m_park_switch(mt int, t int, mode int, arg int) {
    wid := current_m(mt)
    ms := m_slot(mt, wid)
    st(ms + MT_M_PARK_TASK, t)
    st(ms + MT_M_PARK_MODE, mode)
    st(ms + MT_M_PARK_ARG, arg)
    rt_syscall(SYS_TASK_SWITCH, t, ld(ms + MT_M_G0), 0, 0, 0, 0)
}

pub fn sched_m0_entry() {
    sched_m_loop(0)
}

pub fn sched_worker_run(wid int) {
    s := sched()
    mt := ld(s + S_MT_STATE)
    tid := rt_syscall(SYS_THREAD_ID, 0, 0, 0, 0, 0, 0)
    spin_lock(G_SCHED_LOCK)
    mt_tid_register_locked(mt, tid, wid)
    spin_unlock(G_SCHED_LOCK)
    ms := m_slot(mt, wid)
    if atomic_load(c_ptr(mt + MT_STOP)) != 0 {
        mcache_flush_all(ms)
        <<
    }
    g0 := alloc(T_SIZE)
    rq_buf := alloc(MT_RQ_CAP * 8)
    st(ms + MT_M_G0, g0)
    st(ms + MT_M_RUNNEXT, 0)
    st(ms + MT_M_RQ_HEAD, 0)
    st(ms + MT_M_RQ_TAIL, 0)
    st(ms + MT_M_RAND, 0x1e3779b97f4a7c15 ^ ((wid + 1) * 0x517cc1b727220a95))
    st(ms + MT_M_TICK, 0)
    atomic_store(c_ptr(ms + MT_M_RQ_BUF), rq_buf)
    atomic_store(c_ptr(ms + MT_M_CUR), 0)
    sched_m_loop(wid)
    spin_lock_addr(ms + MT_M_RQ_LOCK)
    st(ms + MT_M_RUNNEXT, 0)
    st(ms + MT_M_RQ_HEAD, 0)
    st(ms + MT_M_RQ_TAIL, 0)
    atomic_store(c_ptr(ms + MT_M_RQ_BUF), 0)
    spin_unlock_addr(ms + MT_M_RQ_LOCK)
    free_owned(rq_buf)
    free_owned(g0)
    mcache_flush_all(ms)
}

// Initialize built-in M:N runtime on M0 (while still single-threaded).
// target_procs <= 0 honors XU_PROCS if set, otherwise online CPU core count.
fn sched_init_mt_n(s int, target_procs int) int {
    // Keep sched_worker_run and sched_m0_entry reachable whenever task_start
    // is lowered so codegen emits __xu_thread_entry and __xu_m0_g0_entry.
    if ld(s + S_MT_INIT) == -999 {
        sched_worker_run(0)
        sched_m0_entry()
    }
    os := xu_target_os()
    arch := xu_target_arch()
    if (os != OS_MACOS && os != OS_LINUX && os != OS_WINDOWS) || (arch != ARCH_ARM64 && arch != ARCH_X64) {
        << 1
    }
    thread_entry := rt_syscall(SYS_THREAD_ENTRY, 0, 0, 0, 0, 0, 0)
    m0_entry := rt_syscall(SYS_M0_G0_ENTRY, 0, 0, 0, 0, 0, 0)
    if thread_entry <= 4096 || m0_entry <= 4096 {
        << 1
    }

    $mt := ld(s + S_MT_STATE)
    $blk := 0
    $blk_owned := false
    if mt != 0 {
        blk = m_slot(mt, 0) + MT_M_FFI_BLK
    } else if os != OS_WINDOWS {
        blk = alloc(200)
        blk_owned = true
    }

    $dlsym_fp := 0
    if os == OS_MACOS || os == OS_LINUX {
        dlsym_fp = ffi_loader(1)
    }
    if os == OS_MACOS && dlsym_fp <= 4096 {
        if blk_owned { free(blk) }
        << 1
    }

    $n := target_procs
    if n <= 0 {
        env_p := mt_parse_env_procs()
        if env_p > 0 {
            n = env_p
        } else if os == OS_LINUX {
            n = mt_linux_ncpu()
        } else if os == OS_WINDOWS {
            fp_si := mt_win_k32("GetSystemInfo")
            if fp_si > 4096 {
                si := alloc(64)
                _ := win_callp(fp_si, si, 0, 0, 0, 0, 0)
                n = rt_load(si + 32, 4)
                free(si)
            }
        } else {
            fp_sysconf := mt_dlsym_str(blk, dlsym_fp, "sysconf")
            if fp_sysconf > 4096 {
                // macOS _SC_NPROCESSORS_ONLN = 58
                n = mt_ccall1(blk, fp_sysconf, 58)
            }
        }
    }
    if n > MT_MAX_M { n = MT_MAX_M }
    if n <= 1 {
        if blk_owned { free(blk) }
        << 1
    }

    $backend := MT_BACKEND_PTHREAD
    $fp_create := 0
    $fp_join := 0
    $fp_mu_lock := 0
    $fp_mu_unlock := 0
    $fp_mu_destroy := 0
    $fp_cv_wait := 0
    $fp_cv_signal := 0
    $fp_cv_bcast := 0
    $fp_cv_destroy := 0
    $fp_yield := 0
    $mu := 0
    $cv := 0
    $m0_cv := 0
    $owned_sync := 0

    if os == OS_LINUX {
        if dlsym_fp > 4096 {
            fp_create = mt_dlsym_str(blk, dlsym_fp, "pthread_create")
            fp_join = mt_dlsym_str(blk, dlsym_fp, "pthread_join")
            if fp_create <= 4096 || fp_join <= 4096 {
                dlopen_fp := ffi_loader(0)
                if dlopen_fp > 4096 {
                    lp := "libpthread.so.0"
                    lc := host_cstr(rt_addr(&lp))
                    _ := mt_ccall2(blk, dlopen_fp, lc, 258)
                    free(lc)
                    fp_create = mt_dlsym_str(blk, dlsym_fp, "pthread_create")
                    fp_join = mt_dlsym_str(blk, dlsym_fp, "pthread_join")
                }
            }
        }
        if fp_create > 4096 && fp_join > 4096 {
            backend = MT_BACKEND_PTHREAD
        } else {
            backend = MT_BACKEND_LINUX_CLONE
            fp_create = 0
            fp_join = 0
        }
    } else if os == OS_WINDOWS {
        backend = MT_BACKEND_WIN
        fp_create = mt_win_k32("CreateThread")
        fp_mu_init := mt_win_k32("InitializeSRWLock")
        fp_mu_lock = mt_win_k32("AcquireSRWLockExclusive")
        fp_mu_unlock = mt_win_k32("ReleaseSRWLockExclusive")
        fp_cv_init := mt_win_k32("InitializeConditionVariable")
        fp_cv_wait = mt_win_k32("SleepConditionVariableSRW")
        fp_cv_signal = mt_win_k32("WakeConditionVariable")
        fp_cv_bcast = mt_win_k32("WakeAllConditionVariable")
        if fp_create <= 4096 || fp_mu_init <= 4096 || fp_mu_lock <= 4096 || fp_mu_unlock <= 4096 || fp_cv_init <= 4096 || fp_cv_wait <= 4096 || fp_cv_signal <= 4096 || fp_cv_bcast <= 4096 {
            if blk_owned { free(blk) }
            << 1
        }
        mu = alloc(16)
        cv = alloc(16)
        m0_cv = alloc(16)
        _ := win_callp(fp_mu_init, mu, 0, 0, 0, 0, 0)
        _ := win_callp(fp_cv_init, cv, 0, 0, 0, 0, 0)
        _ := win_callp(fp_cv_init, m0_cv, 0, 0, 0, 0, 0)
        owned_sync = 1
    } else {
        fp_create = mt_dlsym_str(blk, dlsym_fp, "pthread_create")
        fp_join = mt_dlsym_str(blk, dlsym_fp, "pthread_join")
        fp_mu_init := mt_dlsym_str(blk, dlsym_fp, "pthread_mutex_init")
        fp_mu_lock = mt_dlsym_str(blk, dlsym_fp, "pthread_mutex_lock")
        fp_mu_unlock = mt_dlsym_str(blk, dlsym_fp, "pthread_mutex_unlock")
        fp_mu_destroy = mt_dlsym_str(blk, dlsym_fp, "pthread_mutex_destroy")
        fp_cv_init := mt_dlsym_str(blk, dlsym_fp, "pthread_cond_init")
        fp_cv_wait = mt_dlsym_str(blk, dlsym_fp, "pthread_cond_wait")
        fp_cv_signal = mt_dlsym_str(blk, dlsym_fp, "pthread_cond_signal")
        fp_cv_bcast = mt_dlsym_str(blk, dlsym_fp, "pthread_cond_broadcast")
        fp_cv_destroy = mt_dlsym_str(blk, dlsym_fp, "pthread_cond_destroy")
        fp_yield = mt_dlsym_str(blk, dlsym_fp, "sched_yield")
        if fp_create <= 4096 || fp_join <= 4096 || fp_mu_init <= 4096 || fp_mu_lock <= 4096 || fp_mu_unlock <= 4096 || fp_mu_destroy <= 4096 || fp_cv_init <= 4096 || fp_cv_wait <= 4096 || fp_cv_signal <= 4096 || fp_cv_bcast <= 4096 || fp_cv_destroy <= 4096 {
            if blk_owned { free(blk) }
            << 1
        }
        mu = alloc(128)
        cv = alloc(128)
        m0_cv = alloc(128)
        if (mt_ccall2(blk, fp_mu_init, mu, 0) & 4294967295) != 0 {
            free(m0_cv)
            free(cv)
            free(mu)
            if blk_owned { free(blk) }
            << 1
        }
        if (mt_ccall2(blk, fp_cv_init, cv, 0) & 4294967295) != 0 {
            _ := mt_ccall1(blk, fp_mu_destroy, mu)
            free(m0_cv)
            free(cv)
            free(mu)
            if blk_owned { free(blk) }
            << 1
        }
        if (mt_ccall2(blk, fp_cv_init, m0_cv, 0) & 4294967295) != 0 {
            _ := mt_ccall1(blk, fp_cv_destroy, cv)
            _ := mt_ccall1(blk, fp_mu_destroy, mu)
            free(m0_cv)
            free(cv)
            free(mu)
            if blk_owned { free(blk) }
            << 1
        }
        owned_sync = 1
    }

    if mt == 0 {
        if blk_owned { free(blk) }
        mt = alloc(MT_M_OFF + MT_MAX_M * MT_M_STRIDE)
        t_main := ld(s + S_CUR)
        st(mt + MT_MAIN_TASK, t_main)
        g0 := alloc(T_SIZE)
        g0_stk := map_pages(G0_STACK)
        st(g0 + T_STACK, g0_stk)
        st(g0 + T_X28, rt_globals())
        st(g0 + T_LR, m0_entry)
        st(g0 + T_SP, g0_stk + G0_STACK)
        ms0 := m_slot(mt, 0)
        st(ms0 + MT_M_GLOBALS, rt_globals())
        st(ms0 + MT_M_WID, 0)
        st(ms0 + MT_M_G0, g0)
        atomic_store(c_ptr(ms0 + MT_M_CUR), t_main)
        st(s + S_MT_STATE, mt)
    } else {
        t_main := ld(s + S_CUR)
        st(mt + MT_MAIN_TASK, t_main)
        atomic_store(c_ptr(m_slot(mt, 0) + MT_M_CUR), t_main)
    }

    ms0 := m_slot(mt, 0)
    if ld(ms0 + MT_M_RQ_BUF) == 0 {
        st(ms0 + MT_M_RQ_BUF, alloc(MT_RQ_CAP * 8))
    }
    st(ms0 + MT_M_RUNNEXT, 0)
    st(ms0 + MT_M_RQ_HEAD, 0)
    st(ms0 + MT_M_RQ_TAIL, 0)
    st(ms0 + MT_M_RAND, 0x1e3779b97f4a7c15)
    st(ms0 + MT_M_TICK, 0)

    if os == OS_LINUX {
        // Ensure M0 has a non-zero hardware TLS pointer (tpidr_el0 / FS_BASE)
        // on static-PIE Linux binaries while leaving libc's TCB untouched.
        cur_tls := rt_syscall(SYS_SET_TLS, 0, 0, 0, 0, 0, 0)
        if cur_tls == 0 {
            ms0_tls := ms0 + MT_M_TLS_SELF
            st(ms0_tls, ms0_tls)
            _ := rt_syscall(SYS_SET_TLS, ms0_tls, 0, 0, 0, 0, 0)
        }
    }

    mt_tid_clear_locked(mt)
    mt_tid_register_locked(mt, rt_syscall(SYS_THREAD_ID, 0, 0, 0, 0, 0, 0), 0)

    st(mt + MT_BACKEND, backend)
    st(mt + MT_MU, mu)
    st(mt + MT_CV, cv)
    st(mt + MT_M0_CV, m0_cv)
    st(mt + MT_OWNED_SYNC, owned_sync)
    st(mt + MT_FP_CREATE, fp_create)
    st(mt + MT_FP_JOIN, fp_join)
    st(mt + MT_FP_LOCK, fp_mu_lock)
    st(mt + MT_FP_UNLOCK, fp_mu_unlock)
    st(mt + MT_FP_WAIT, fp_cv_wait)
    st(mt + MT_FP_SIGNAL, fp_cv_signal)
    st(mt + MT_FP_BROADCAST, fp_cv_bcast)
    st(mt + MT_FP_DESTROY_MU, fp_mu_destroy)
    st(mt + MT_FP_DESTROY_CV, fp_cv_destroy)
    st(mt + MT_FP_YIELD, fp_yield)
    st(mt + MT_THREAD_ENTRY, thread_entry)
    atomic_store(c_ptr(mt + MT_SPAWNED_M), 1)
    atomic_store(c_ptr(mt + MT_ACTIVE_M), 1)
    atomic_store(c_ptr(mt + MT_SPAWNING), 0)
    atomic_store(c_ptr(mt + MT_SLEEPING), 0)
    atomic_store(c_ptr(mt + MT_M0_SLEEPING), 0)
    atomic_store(c_ptr(mt + MT_SPINNING), 0)
    atomic_store(c_ptr(mt + MT_STOP), 0)
    atomic_store(c_ptr(mt + MT_DRAIN_WAITER), 0)
    atomic_store(c_ptr(mt + MT_MAIN_READY), 0)
    st(mt + MT_BLK_HEAD, 0)
    st(mt + MT_BLK_TAIL, 0)
    atomic_store(c_ptr(mt + MT_BLK_COUNT), 0)
    atomic_store(c_ptr(mt + MT_SEL_BLK_COUNT), 0)
    atomic_store(c_ptr(mt + MT_TOTAL_RUNNABLE), ld(s + S_RUNQ_LEN))
    st(mt + MT_POLLING, 0)

    rt_mt_enable()
    atomic_store(c_ptr(mt + MT_NPROCS), n)
    << n
}

fn sched_maybe_auto_mt(s int) {
    if ld(s + S_MT_INIT) != 0 { << }
    st(s + S_MT_INIT, 1)
    _ := sched_init_mt_n(s, 0)
}

pub fn sched_set_max_procs(nprocs int) int {
    s := sched()
    cur := sched_max_procs()
    if cur > 1 { << cur }
    st(s + S_MT_INIT, 1)
    << sched_init_mt_n(s, nprocs)
}

pub fn sched_stop_mt_and_join() {
    s := gword(G_SCHED)
    if s == 0 { << }
    mt := sched_m_state()
    if mt == 0 { << }
    if current_task_mt(s, mt) != ld(mt + MT_MAIN_TASK) { << }
    // Drain any in-flight or runnable tasks before stopping workers so exiting
    // tasks complete task_exit() cleanly and S_NTASKS stays accurate.
    if atomic_load(c_ptr(s + S_NTASKS)) > 1 && atomic_load(c_ptr(s + S_DRAIN)) == 0 {
        atomic_store(c_ptr(s + S_DRAIN), 1)
        t := ld(mt + MT_MAIN_TASK)
        m_park_switch(mt, t, PARK_DRAIN, 0)
        atomic_store(c_ptr(s + S_DRAIN), 0)
    }
    while atomic_load(c_ptr(mt + MT_SPAWNING)) > 0 {
        rt_syscall(SYS_CPU_PAUSE, 0, 0, 0, 0, 0, 0)
    }
    atomic_store(c_ptr(mt + MT_STOP), 1)
    mt_wake_all(mt, 0)
    spawned := atomic_load(c_ptr(mt + MT_SPAWNED_M))
    backend := ld(mt + MT_BACKEND)
    fp_join := ld(mt + MT_FP_JOIN)
    blk0 := m_slot(mt, 0) + MT_M_FFI_BLK
    for wid in 1:spawned {
        ms := m_slot(mt, wid)
        if backend == MT_BACKEND_LINUX_CLONE {
            stk := ld(ms + MT_M_OS_STACK)
            if stk != 0 {
                while true {
                    ctid := atomic_load(c_ptr(ms + MT_M_CTID)) & 4294967295
                    if ctid == 0 { <- }
                    // Kernel CLONE_CHILD_CLEARTID uses shared FUTEX_WAKE, so wait with FUTEX_WAIT=0.
                    _ := rt_syscall(98, ms + MT_M_CTID, 0, ctid, 0, 0, 0)
                }
                unmap_pages(stk, G0_STACK)
                st(ms + MT_M_OS_STACK, 0)
            }
        } else if backend == MT_BACKEND_WIN {
            th := ld(ms + MT_M_PTHREAD)
            if th != 0 {
                _ := win_call(W_WAIT_FOR_SINGLE_OBJECT, th, 4294967295, 0, 0, 0, 0)
                _ := win_call(W_CLOSE_HANDLE, th, 0, 0, 0, 0, 0)
                st(ms + MT_M_PTHREAD, 0)
            }
        } else {
            th := ld(ms + MT_M_PTHREAD)
            if th != 0 && fp_join > 4096 {
                _ := mt_ccall2(blk0, fp_join, th, 0)
                st(ms + MT_M_PTHREAD, 0)
            }
        }
    }
    ms0 := m_slot(mt, 0)
    buf0 := ld(ms0 + MT_M_RQ_BUF)
    st(ms0 + MT_M_RUNNEXT, 0)
    st(ms0 + MT_M_RQ_HEAD, 0)
    st(ms0 + MT_M_RQ_TAIL, 0)
    st(ms0 + MT_M_RQ_BUF, 0)
    if buf0 != 0 { free_owned(buf0) }
    mcache_flush_all(ms0)
    atomic_store(c_ptr(mt + MT_NPROCS), 1)
    atomic_store(c_ptr(mt + MT_SPAWNED_M), 1)
    atomic_store(c_ptr(mt + MT_STOP), 0)
    atomic_store(c_ptr(mt + MT_ACTIVE_M), 0)
    atomic_store(c_ptr(mt + MT_SLEEPING), 0)
    atomic_store(c_ptr(mt + MT_M0_SLEEPING), 0)
    atomic_store(c_ptr(mt + MT_SPINNING), 0)
    atomic_store(c_ptr(mt + MT_DRAIN_WAITER), 0)
    atomic_store(c_ptr(mt + MT_MAIN_READY), 0)
    st(mt + MT_BLK_HEAD, 0)
    st(mt + MT_BLK_TAIL, 0)
    atomic_store(c_ptr(mt + MT_BLK_COUNT), 0)
    atomic_store(c_ptr(mt + MT_SEL_BLK_COUNT), 0)
    atomic_store(c_ptr(mt + MT_TOTAL_RUNNABLE), 0)
    st(s + S_NTASKS, 1)
    st(s + S_HEAD, 0)
    st(s + S_TAIL, 0)
    st(s + S_RUNQ_LEN, 0)
    mt_tid_clear_locked(mt)
    rt_mt_disable()
    if ld(mt + MT_OWNED_SYNC) != 0 {
        mu := ld(mt + MT_MU)
        cv := ld(mt + MT_CV)
        m0_cv := ld(mt + MT_M0_CV)
        if backend == MT_BACKEND_WIN {
            if m0_cv != 0 { free(m0_cv) }
            if cv != 0 { free(cv) }
            if mu != 0 { free(mu) }
        } else {
            if m0_cv != 0 {
                _ := mt_ccall1(blk0, ld(mt + MT_FP_DESTROY_CV), m0_cv)
                free(m0_cv)
            }
            if cv != 0 {
                _ := mt_ccall1(blk0, ld(mt + MT_FP_DESTROY_CV), cv)
                free(cv)
            }
            if mu != 0 {
                _ := mt_ccall1(blk0, ld(mt + MT_FP_DESTROY_MU), mu)
                free(mu)
            }
        }
        st(mt + MT_OWNED_SYNC, 0)
    }
    st(mt + MT_MU, 0)
    st(mt + MT_CV, 0)
    st(mt + MT_M0_CV, 0)
}

// Legacy hooks retained for backwards compatibility with older callers.
pub fn sched_prepare_mt() int {
    << 0
}

pub fn sched_run_m0_g0() {
    sched_m_loop(0)
}

pub fn sched_enable_mt(nprocs int, mu int, cv int, fp_lock int, fp_unlock int, fp_wait int, fp_broadcast int, fp_yield int) int {
    << sched_set_max_procs(nprocs)
}

pub fn sched_stop_mt() {
    sched_stop_mt_and_join()
}

pub fn sched_finish_stop_mt() {
}

pub fn sched_max_procs() int {
    mt := sched_m_state()
    if mt == 0 { << 1 }
    << ld(mt + MT_NPROCS)
}

// The current task cannot proceed: let the others run.
pub fn task_block() {
    mt := sched_m_state()
    if mt != 0 {
        s := sched()
        t := current_task_mt(s, mt)
        $bep := ld(t + T_SEEN_EPOCH)
        st(t + T_SEEN_EPOCH, 0)
        if bep != 0 && bep != atomic_load(c_ptr(s + S_EPOCH)) {
            <<
        }
        if bep == 0 { bep = atomic_load(c_ptr(s + S_EPOCH)) }
        m_park_switch(mt, t, PARK_BLOCK, bep)
        <<
    }
    if rt_signal_poll(0) { << }
    s := sched()
    t := ld(s + S_CUR)
    mark := ld(s + S_EPOCH) + 1
    if ld(t + T_EPOCH) != mark {
        st(t + T_EPOCH, mark)
        st(s + S_NBLOCKED, ld(s + S_NBLOCKED) + 1)
    }
    if ld(s + S_NBLOCKED) + ld(s + S_WAIT_COUNT) >= ld(s + S_NTASKS) && ld(s + S_DRAIN) == 0 {
        if ld(s + S_WAIT_COUNT) > 0 {
            sched_poll_waiters(s, true)
            queue_push(s, t)
            switch_to(t, sched_pop_next(s))
            <<
        }
        if rt_signal_has_waiters() {
            rt_signal_poll(4294967295) // INFINITE
            queue_push(s, t)
            switch_to(t, sched_pop_next(s))
            <<
        }
        fatal_deadlock()
    }
    queue_push(s, t)
    switch_to(t, sched_pop_next(s))
}

// Bare-metal boards have a few MiB of RAM in all.
fn task_stack() int {
    if xu_target_os() == OS_NONE {
        << 65536
    }
    << TASK_STACK
}

fn map_task_stack() int {
    size := task_stack()
    if host_win() {
        // Reserve the entire stack and leave its low pages uncommitted.
        // The reservation base is also the address passed to MEM_RELEASE.
        stk := win_call(W_VIRTUAL_ALLOC, 0, size, 0x2000, 1, 0, 0) // MEM_RESERVE, PAGE_NOACCESS
        if stk == 0 {
            fatal_no_memory()
        }
        committed := win_call(W_VIRTUAL_ALLOC, stk + TASK_STACK_GUARD, size - TASK_STACK_GUARD, 0x1000, 4, 0, 0) // MEM_COMMIT, PAGE_READWRITE
        if committed == 0 {
            unmap_pages(stk, size)
            fatal_no_memory()
        }
        << stk
    }
    stk := map_pages(size)
    if xu_target_os() == OS_MACOS {
        rt_syscall(74, stk, TASK_STACK_GUARD, 0, 0, 0, 0)
    } else if xu_target_os() == OS_LINUX {
        rt_syscall(226, stk, TASK_STACK_GUARD, 0, 0, 0, 0)
    }
    << stk
}

fn map_tiny_stack() int {
    size := TASK_TINY_STACK
    if host_win() {
        stk := win_call(W_VIRTUAL_ALLOC, 0, size, 0x3000, 4, 0, 0)
        if stk == 0 {
            fatal_no_memory()
        }
        << stk
    }
    << map_pages(size)
}

// The entry trampoline interprets arg as either a block address or a
// register word. args records which allocation task_exit needs to release.
fn task_start(entry int, fn_addr int, exit_addr int, arg int, args int, tiny bool) {
    s := sched()
    sched_maybe_auto_mt(s)
    mt := sched_m_state()
    if mt != 0 {
        wid := current_m_strict(mt)
        $free_slot := S_FREE
        $stack_size := TASK_TINY_STACK
        if tiny {
            free_slot = S_TINY_FREE
        } else {
            stack_size = task_stack()
        }
        spin_lock(G_SCHED_LOCK)
        $t := ld(s + free_slot)
        if t != 0 {
            st(s + free_slot, ld(t + T_NEXT))
            if !tiny {
                st(s + S_FREE_COUNT, ld(s + S_FREE_COUNT) - 1)
            }
        }
        spin_unlock(G_SCHED_LOCK)
        if t == 0 {
            t = alloc(T_SIZE)
            if tiny {
                st(t + T_STACK, map_tiny_stack())
            } else {
                st(t + T_STACK, map_task_stack())
            }
        } else {
            words := T_SIZE / 8
            for i in 0:words {
                if i * 8 != T_STACK {
                    st(t + i * 8, 0)
                }
            }
        }
        if tiny { st(t + T_IS_TINY, 1) }
        st(t + T_X19, t)
        st(t + T_X20, fn_addr)
        st(t + T_X21, arg)
        st(t + T_ARGS, args)
        st(t + T_X22, exit_addr)
        st(t + T_X28, rt_globals())
        st(t + T_LR, entry)
        st(t + T_SP, ld(t + T_STACK) + stack_size)

        _ := atomic_add(c_ptr(s + S_NTASKS), 1)
        local_push(s, mt, wid, t, true)
        chan_notify_epoch_mt(s, mt, wid)
        mt_maybe_spawn_worker(s, mt, wid)
        <<
    }
    $free_slot := S_FREE
    $stack_size := TASK_TINY_STACK
    if tiny {
        free_slot = S_TINY_FREE
    } else {
        stack_size = task_stack()
    }
    $t := ld(s + free_slot)
    if t != 0 {
        st(s + free_slot, ld(t + T_NEXT))
        if !tiny {
            st(s + S_FREE_COUNT, ld(s + S_FREE_COUNT) - 1)
        }
        st(t + T_FP, 0)
        st(t + T_PREV, 0)
        st(t + T_NEXT, 0)
        st(t + T_EPOCH, 0)
        st(t + T_WAIT_FD, 0)
        st(t + T_WAIT_EVENTS, 0)
        st(t + T_WAIT_REVENTS, 0)
        st(t + T_WAIT_DEADLINE, 0)
        st(t + T_WAIT_NEXT, 0)
        st(t + T_IS_TINY, 0)
    } else {
        t = alloc(T_SIZE)
        if tiny {
            st(t + T_STACK, map_tiny_stack())
        } else {
            st(t + T_STACK, map_task_stack())
        }
    }
    if tiny {
        st(t + T_IS_TINY, 1)
    }
    st(t + T_X19, t)
    st(t + T_X20, fn_addr)
    st(t + T_X21, arg)
    st(t + T_ARGS, args)
    st(t + T_X22, exit_addr)
    st(t + T_X28, rt_globals())
    st(t + T_LR, entry)
    st(t + T_SP, ld(t + T_STACK) + stack_size)
    st(s + S_NTASKS, ld(s + S_NTASKS) + 1)
    queue_push(s, t)
    progress()
}

// The block contains the incoming register and stack argument words.
pub fn task_spawn(entry int, fn_addr int, exit_addr int, block int) {
    task_start(entry, fn_addr, exit_addr, block, block, false)
}

pub fn task_spawn_tiny(entry int, fn_addr int, exit_addr int, block int) {
    task_start(entry, fn_addr, exit_addr, block, block, true)
}

// The saved argument travels in the task context until first entry. It
// needs no frame storage and task_exit has no argument block to release.
pub fn task_spawn_word(entry int, fn_addr int, exit_addr int, word int, tiny bool) {
    task_start(entry, fn_addr, exit_addr, word, 0, tiny)
}

// Whether other tasks exist that could run while this one waits.
pub fn task_others() bool {
    s := gword(G_SCHED)
    if s == 0 { << false }
    if rt_mt_active() {
        << atomic_load(c_ptr(s + S_NTASKS)) > 1
    }
    << ld(s + S_NTASKS) > 1
}

pub fn sched_epoch() int {
    s := sched()
    if rt_mt_active() {
        << atomic_load(c_ptr(s + S_EPOCH))
    }
    << ld(s + S_EPOCH)
}

// Only one I/O waiter may block the OS thread after full rounds without
// progress. When an event-set waiter is active on this single-threaded
// scheduler, single-fd callers defer blocking sleep so they cannot stall an
// in-process peer server waiting on kqueue/epoll.
fn task_io_yield_kind(from_es bool) bool {
    s := sched()
    if sched_m_state() != 0 {
        epoch := atomic_load(c_ptr(s + S_EPOCH))
        task_yield()
        << atomic_load(c_ptr(s + S_EPOCH)) == epoch
    }
    if ld(s + S_IO_PROBE) != 0 {
        task_yield()
        << false
    }
    if !from_es && ld(s + S_ES_DEPTH) > 0 {
        task_yield()
        << false
    }
    st(s + S_IO_PROBE, 1)
    epoch := ld(s + S_EPOCH)
    task_yield()
    st(s + S_IO_PROBE, 0)
    if ld(s + S_EPOCH) != epoch {
        st(s + S_IO_IDLE, 0)
        << false
    }
    idle := ld(s + S_IO_IDLE) + 1
    st(s + S_IO_IDLE, idle)
    << idle >= 2
}

fn task_io_yield() bool {
    << task_io_yield_kind(false)
}

fn waiter_add(s int, t int, fd int, events int, deadline int) {
    st(t + T_WAIT_FD, fd)
    st(t + T_WAIT_EVENTS, events)
    st(t + T_WAIT_REVENTS, 0)
    st(t + T_WAIT_DEADLINE, deadline)
    st(t + T_WAIT_NEXT, 0)
    tail := ld(s + S_WAIT_TAIL)
    if tail == 0 {
        st(s + S_WAIT_HEAD, t)
    } else {
        st(tail + T_WAIT_NEXT, t)
    }
    st(s + S_WAIT_TAIL, t)
    st(s + S_WAIT_COUNT, ld(s + S_WAIT_COUNT) + 1)
}

fn sched_poll_waiters(s int, blocking bool) {
    while true {
        cnt := ld(s + S_WAIT_COUNT)
        if cnt <= 0 {
            <<
        }
        $cap := ld(s + S_POLL_CAP)
        $pfd := ld(s + S_POLL_PFD)
        $tasks := ld(s + S_POLL_TASKS)
        if cnt > cap {
            ncap := max_int(cnt, 32)
            if pfd != 0 {
                free(pfd)
            }
            if tasks != 0 {
                free(tasks)
            }
            pfd = alloc(ncap * 8)
            tasks = alloc(ncap * 8)
            st(s + S_POLL_PFD, pfd)
            st(s + S_POLL_TASKS, tasks)
            st(s + S_POLL_CAP, ncap)
        }
        $curr := ld(s + S_WAIT_HEAD)
        $i := 0
        $earliest_deadline := 0
        $now := host_now_ns()

        while curr != 0 && i < cnt {
            fd := ld(curr + T_WAIT_FD)
            events := ld(curr + T_WAIT_EVENTS)
            deadline := ld(curr + T_WAIT_DEADLINE)

            rt_store(pfd + i * 8, 8, fd | ((events & 65535) << 32))
            rt_store(tasks + i * 8, 8, curr)

            if deadline > 0 {
                if earliest_deadline == 0 || deadline < earliest_deadline {
                    earliest_deadline = deadline
                }
            }
            curr = ld(curr + T_WAIT_NEXT)
            i += 1
        }
        actual_cnt := i
        if actual_cnt == 0 {
            <<
        }

        $timeout_ms := 0
        if blocking {
            if earliest_deadline > 0 {
                rem_ns := earliest_deadline - now
                if rem_ns <= 0 {
                    timeout_ms = 0
                } else {
                    timeout_ms = min_int((rem_ns + 999999) / 1000000, 2147483647)
                }
            } else {
                timeout_ms = -1
            }
        }

        r := host_poll_batch(pfd, tasks, actual_cnt, timeout_ms)
        rt_signal_poll(0)

        if r < 0 && r != 0 - EINTR {
            for j in 0:actual_cnt {
                t := rt_load(tasks + j * 8, 8)
                st(t + T_WAIT_REVENTS, r)
                st(t + T_WAIT_NEXT, 0)
                queue_push(s, t)
            }
            st(s + S_WAIT_HEAD, 0)
            st(s + S_WAIT_TAIL, 0)
            st(s + S_WAIT_COUNT, 0)
            <<
        }

        now = host_now_ns()
        $new_head := 0
        $new_tail := 0
        $new_count := 0
        $woken := 0

        for j in 0:actual_cnt {
            t := rt_load(tasks + j * 8, 8)
            pollfd := rt_load(pfd + j * 8, 8)
            revents := (pollfd >> 48) & 65535
            deadline := ld(t + T_WAIT_DEADLINE)
            $ready := -1

            if (revents & 32) != 0 {
                ready = 0 - EBADF
            } else if revents != 0 {
                ready = revents
            } else if deadline > 0 && now >= deadline {
                ready = 0
            }

            if ready != -1 {
                st(t + T_WAIT_REVENTS, ready)
                st(t + T_WAIT_NEXT, 0)
                queue_push(s, t)
                woken += 1
            } else {
                st(t + T_WAIT_NEXT, 0)
                if new_tail == 0 {
                    new_head = t
                } else {
                    st(new_tail + T_WAIT_NEXT, t)
                }
                new_tail = t
                new_count += 1
            }
        }

        st(s + S_WAIT_HEAD, new_head)
        st(s + S_WAIT_TAIL, new_tail)
        st(s + S_WAIT_COUNT, new_count)

        if woken > 0 {
            task_io_progress()
            <<
        }
        if !blocking || new_count == 0 {
            <<
        }
    }
}

pub fn task_poll_wait(fd int, events int, timeout_ms int) int {
    if !host_fd_in_range(fd) {
        << 0 - EBADF
    }
    r := host_poll_ms(fd, events, 0)
    if r != 0 {
        if r > 0 { task_io_progress() }
        << r
    }
    if timeout_ms == 0 {
        << 0
    }
    s := sched()
    if !task_others() {
        << host_poll_ms(fd, events, timeout_ms)
    }

    $deadline := 0
    if timeout_ms > 0 {
        deadline = host_now_ns() + timeout_ms * 1000000
    }

    mt := sched_m_state()
    if mt != 0 {
        t := current_task_mt(s, mt)
        st(t + T_WAIT_FD, fd)
        st(t + T_WAIT_EVENTS, events)
        st(t + T_WAIT_REVENTS, 0)
        st(t + T_WAIT_DEADLINE, deadline)
        m_park_switch(mt, t, PARK_WAIT_IO, 0)
        rev := ld(t + T_WAIT_REVENTS)
        if rev > 0 { task_io_progress() }
        << rev
    }

    t := ld(s + S_CUR)
    waiter_add(s, t, fd, events, deadline)

    $nx := sched_pop_next(s)
    if nx == 0 {
        sched_poll_waiters(s, true)
        nx = sched_pop_next(s)
    }

    if nx != 0 {
        switch_to(t, nx)
    }

    rev := ld(t + T_WAIT_REVENTS)
    if rev > 0 {
        task_io_progress()
    }
    << rev
}

// Let the other tasks run without counting this task as blocked (it is
// waiting for time or I/O, not for another task). Once main has returned
// it does count: a task only waiting on the outside world must not keep
// the process alive, as a thread would be killed at exit.
pub fn task_yield() {
    mt := sched_m_state()
    if mt != 0 {
        s := sched()
        t := current_task_mt(s, mt)
        m_park_switch(mt, t, PARK_YIELD, 0)
        <<
    }
    rt_signal_poll(0)
    s := sched()
    if ld(s + S_WAIT_COUNT) > 0 {
        sched_poll_waiters(s, false)
    }
    t := ld(s + S_CUR)
    if ld(s + S_DRAIN) != 0 {
        mark := ld(s + S_EPOCH) + 1
        if ld(t + T_EPOCH) != mark {
            st(t + T_EPOCH, mark)
            st(s + S_NBLOCKED, ld(s + S_NBLOCKED) + 1)
        }
    }
    queue_push(s, t)
    switch_to(t, sched_pop_next(s))
}

// A compiler-inserted loop poll only enters the scheduler when a peer exists.
pub fn task_poll() {
    mt := sched_m_state()
    if mt != 0 {
        if atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) > 0 || atomic_load(c_ptr(mt + MT_MAIN_READY)) != 0 {
            task_yield()
        }
        <<
    }
    if task_others() {
        task_yield()
    }
}

// A value is buffered or the channel is closed.
pub fn chan_ready(ch int) bool {
    if ch == 0 { << false }
    if rt_mt_active() {
        << atomic_load(c_ptr(ch + C_COUNT)) > 0 || atomic_load(c_ptr(ch + C_CLOSED)) != 0
    }
    << ld(ch + C_COUNT) > 0 || ld(ch + C_CLOSED) != 0
}

fn chan_ready_not_closed(ch int) bool {
    if ch == 0 { << false }
    if rt_mt_active() {
        << atomic_load(c_ptr(ch + C_CLOSED)) == 0
    }
    << ld(ch + C_CLOSED) == 0
}

// Called when main returns: other tasks run to completion first, until they
// have all exited or none of them can make progress.
pub fn task_drain() {
    s := gword(G_SCHED)
    if s == 0 {
        ffi_flush()
        <<
    }
    mt := sched_m_state()
    if mt != 0 {
        atomic_store(c_ptr(s + S_DRAIN), 1)
        nt := atomic_load(c_ptr(s + S_NTASKS))
        if nt > 1 {
            t := ld(mt + MT_MAIN_TASK)
            m_park_switch(mt, t, PARK_DRAIN, 0)
        }
        sched_stop_mt_and_join()
        ffi_flush()
        <<
    }
    ffi_flush()
    st(s + S_DRAIN, 1)
    while ld(s + S_NTASKS) > 1 {
        t := ld(s + S_CUR)
        mark := ld(s + S_EPOCH) + 1
        if ld(t + T_EPOCH) != mark {
            st(t + T_EPOCH, mark)
            st(s + S_NBLOCKED, ld(s + S_NBLOCKED) + 1)
        }
        if ld(s + S_NBLOCKED) + ld(s + S_WAIT_COUNT) >= ld(s + S_NTASKS) {
            if ld(s + S_WAIT_COUNT) > 0 {
                sched_poll_waiters(s, true)
            } else {
                <<
            }
        }
        queue_push(s, t)
        switch_to(t, sched_pop_next(s))
    }
}

// Called by __xu_task_entry when the task function returns.
pub fn task_exit(t int) {
    s := sched()
    mt := sched_m_state()
    if mt != 0 {
        m_park_switch(mt, t, PARK_EXIT, 0)
        <<
    }
    st(s + S_NTASKS, ld(s + S_NTASKS) - 1)
    progress()
    args := ld(t + T_ARGS)
    if args != s + S_EMPTY_ARGS {
        free_owned(args)
    }
    st(t + T_ARGS, 0)
    if ld(t + T_IS_TINY) != 0 {
        st(t + T_NEXT, ld(s + S_TINY_FREE))
        st(s + S_TINY_FREE, t)
    } else {
        $head := ld(s + S_FREE)
        cached := ld(s + S_FREE_COUNT)
        os := xu_target_os()
        if cached >= TASK_STACK_CACHE_LIMIT && (os == OS_LINUX || os == OS_MACOS || os == OS_WINDOWS) {
            // The cached task already switched away. Keep the current stack
            // mapped until its own switch has finished.
            old := head
            head = ld(old + T_NEXT)
            unmap_pages(ld(old + T_STACK), task_stack())
            free_owned(old)
        } else {
            st(s + S_FREE_COUNT, cached + 1)
        }
        st(t + T_NEXT, head)
        st(s + S_FREE, t)
    }
    $nx := sched_pop_next(s)
    if nx == 0 && ld(s + S_WAIT_COUNT) > 0 {
        sched_poll_waiters(s, true)
        nx = sched_pop_next(s)
    }
    if nx == 0 {
        exit_process(0)
    }
    st(s + S_CUR, nx)
    rt_syscall(SYS_TASK_SWITCH, t, nx, 0, 0, 0, 0)
}

// ===== channels =====

pub fn chan_new(cap int) int {
    if cap > 1152921504606846975 {
        fatal_no_memory()
    }
    ch := alloc(C_SIZE)
    $c := cap
    if c < 0 {
        c = 0
    }
    st(ch + C_CAP, c)
    << ch
}

fn chan_lock(ch int) {
    spin_lock_addr(ch + C_LOCK)
}

fn chan_unlock(ch int) {
    spin_unlock_addr(ch + C_LOCK)
}

fn chan_record_epoch(s int, mt int, ep int) {
    wid := current_m_strict(mt)
    if wid < 0 { << }
    t := atomic_load(c_ptr(m_slot(mt, wid) + MT_M_CUR))
    if t != 0 && ld(t + T_SEEN_EPOCH) == 0 {
        st(t + T_SEEN_EPOCH, ep)
    }
}

fn chan_clear_epoch(s int, mt int) {
    wid := current_m_strict(mt)
    if wid < 0 { << }
    t := atomic_load(c_ptr(m_slot(mt, wid) + MT_M_CUR))
    if t != 0 {
        st(t + T_SEEN_EPOCH, 0)
    }
}

// Add a holder to channel ch (0 is no channel).
pub fn chan_retain(ch int) {
    if ch != 0 {
        if rt_mt_active() {
            _ := atomic_add(c_ptr(ch + C_RC), 1)
        } else {
            st(ch + C_RC, ld(ch + C_RC) + 1)
        }
    }
}

// Give up a holder of ch. Returns 1 when it was the last one: the caller
// then drops the unread elements (chan_take_unread) and calls chan_free.
pub fn chan_release(ch int) int {
    if ch == 0 {
        << 0
    }
    if rt_mt_active() {
        old := atomic_add(c_ptr(ch + C_RC), -1)
        if old > 0 { << 0 }
        << 1
    }
    rc := ld(ch + C_RC)
    if rc > 0 {
        st(ch + C_RC, rc - 1)
        << 0
    }
    << 1
}

// Move the oldest unread element of ch to dst; 0 when none is left.
// Only called by the last holder during channel drop (no waiters exist).
pub fn chan_take_unread(ch int, dst int, esize int) int {
    if ld(ch + C_COUNT) > 0 {
        chan_take_ring(ch, dst, esize)
        << 1
    }
    << 0
}

pub fn chan_free(ch int) {
    free_owned(ld(ch + C_BUF))
    free_owned(ch)
}

fn chan_slots(ch int) int {
    c := ld(ch + C_CAP)
    if c < 1 {
        << 1
    }
    << c
}

fn chan_buf(ch int, esize int) int {
    $buf := ld(ch + C_BUF)
    if buf == 0 {
        slots := chan_slots(ch)
        if esize < 0 {
            fatal_no_memory()
        }
        if esize > 0 {
            if slots > (9223372036854775807 - 16399) / esize {
                fatal_no_memory()
            }
        }
        buf = alloc(slots * esize)
        st(ch + C_BUF, buf)
        st(ch + C_ESIZE, esize)
    }
    << buf
}

fn chan_put(ch int, src int, esize int) {
    buf := chan_buf(ch, esize)
    n := chan_slots(ch)
    count := ld(ch + C_COUNT)
    $at := ld(ch + C_HEAD) + count
    if at >= n {
        at -= n
    }
    if esize == 8 {
        rt_store(buf + at * 8, 8, rt_load(src, 8))
    } else {
        mem_copy(buf + at * esize, src, esize)
    }
    st(ch + C_COUNT, count + 1)
    st(ch + C_SENT, ld(ch + C_SENT) + 1)
    waiter := ld(ch + C_WAITER)
    if waiter != 0 {
        st(ch + C_WAITER, 0)
        s := sched()
        streak := ld(s + S_AFFINITY_TICKS)
        if streak < 8 && ld(s + S_AFFINITY) == 0 {
            if queue_unlink(s, waiter) {
                st(s + S_AFFINITY_TICKS, streak + 1)
                st(s + S_AFFINITY, waiter)
            }
        }
    }
    progress()
}

fn chan_take(ch int, dst int, esize int) {
    buf := chan_buf(ch, esize)
    head := ld(ch + C_HEAD)
    if esize == 8 {
        rt_store(dst, 8, rt_load(buf + head * 8, 8))
    } else {
        mem_copy(dst, buf + head * esize, esize)
    }
    $nh := head + 1
    if nh >= chan_slots(ch) {
        nh = 0
    }
    st(ch + C_HEAD, nh)
    st(ch + C_COUNT, ld(ch + C_COUNT) - 1)
    st(ch + C_RECVD, ld(ch + C_RECVD) + 1)
    waiter := ld(ch + C_WAITER)
    if waiter != 0 {
        st(ch + C_WAITER, 0)
        s := sched()
        streak := ld(s + S_AFFINITY_TICKS)
        if streak < 8 && ld(s + S_AFFINITY) == 0 {
            if queue_unlink(s, waiter) {
                st(s + S_AFFINITY_TICKS, streak + 1)
                st(s + S_AFFINITY, waiter)
            }
        }
    }
    progress()
}

fn panic_send_closed() {
    msg := "panic: send on closed channel\n"
    write_fd(2, str_ptr(&msg), msg.len)
    exit_process(1)
}

fn chan_put_ring(ch int, src int, esize int) {
    buf := chan_buf(ch, esize)
    n := chan_slots(ch)
    count := ld(ch + C_COUNT)
    $at := ld(ch + C_HEAD) + count
    if at >= n {
        at -= n
    }
    if esize == 8 {
        rt_store(buf + at * 8, 8, rt_load(src, 8))
    } else {
        mem_copy(buf + at * esize, src, esize)
    }
    st(ch + C_COUNT, count + 1)
    st(ch + C_SENT, ld(ch + C_SENT) + 1)
}

fn chan_take_ring(ch int, dst int, esize int) {
    buf := chan_buf(ch, esize)
    head := ld(ch + C_HEAD)
    if esize == 8 {
        rt_store(dst, 8, rt_load(buf + head * 8, 8))
    } else {
        mem_copy(dst, buf + head * esize, esize)
    }
    $nh := head + 1
    if nh >= chan_slots(ch) {
        nh = 0
    }
    st(ch + C_HEAD, nh)
    st(ch + C_COUNT, ld(ch + C_COUNT) - 1)
    st(ch + C_RECVD, ld(ch + C_RECVD) + 1)
}

// 1 when the value was sent, 0 when the send would block.
pub fn chan_try_send(ch int, src int, esize int) int {
    if ch == 0 {
        << 0
    }
    mt := sched_m_state()
    if mt != 0 {
        s := sched()
        ep := atomic_load(c_ptr(s + S_EPOCH))
        chan_lock(ch)
        if ld(ch + C_CLOSED) != 0 {
            chan_unlock(ch)
            panic_send_closed()
        }
        count := ld(ch + C_COUNT)
        if ld(ch + C_CAP) == 0 {
            if count != 0 || ld(ch + C_RWAIT) == 0 {
                chan_unlock(ch)
                chan_record_epoch(s, mt, ep)
                << 0
            }
        } else if count >= ld(ch + C_CAP) {
            chan_unlock(ch)
            chan_record_epoch(s, mt, ep)
            << 0
        }
        chan_put_ring(ch, src, esize)
        w := chan_pop_rwait_locked(ch)
        chan_unlock(ch)
        wid := current_m_strict(mt)
        chan_clear_epoch(s, mt)
        chan_wake_one(s, mt, wid, w, true)
        chan_notify_epoch_mt(s, mt, wid)
        << 1
    }
    if ld(ch + C_CLOSED) != 0 {
        panic_send_closed()
    }
    count := ld(ch + C_COUNT)
    if ld(ch + C_CAP) == 0 {
        if count != 0 || ld(ch + C_DIRECT) != 0 || ld(ch + C_RWAIT) == 0 {
            << 0
        }
        rdst := ld(ch + C_RDST)
        rtask := ld(ch + C_RDST_TASK)
        if rdst != 0 && rtask != 0 {
            if esize == 8 {
                rt_store(rdst, 8, rt_load(src, 8))
            } else {
                mem_copy(rdst, src, esize)
            }
            st(ch + C_RDST, 0)
            st(ch + C_RDST_TASK, 0)
            st(ch + C_DIRECT, rtask)
            st(ch + C_COUNT, 1)
            st(ch + C_SENT, ld(ch + C_SENT) + 1)
            s := sched()
            streak := ld(s + S_AFFINITY_TICKS)
            if streak < 8 && ld(s + S_AFFINITY) == 0 {
                if queue_unlink(s, rtask) {
                    st(s + S_AFFINITY_TICKS, streak + 1)
                    st(s + S_AFFINITY, rtask)
                }
            }
            progress()
            << 1
        }
    } else if count >= ld(ch + C_CAP) {
        << 0
    }
    chan_put(ch, src, esize)
    << 1
}

// 1 with a value, 2 when the channel is closed and drained (dst zeroed),
// 0 when the receive would block.
pub fn chan_try_recv(ch int, dst int, esize int) int {
    if ch == 0 {
        << 0
    }
    mt := sched_m_state()
    if mt != 0 {
        s := sched()
        ep := atomic_load(c_ptr(s + S_EPOCH))
        chan_lock(ch)
        if ld(ch + C_COUNT) > 0 {
            chan_take_ring(ch, dst, esize)
            $wu := 0
            if ld(ch + C_CAP) == 0 {
                wu = ld(ch + C_UNBUF_WAITER)
                st(ch + C_UNBUF_WAITER, 0)
            }
            ws := chan_pop_swait_locked(ch)
            chan_unlock(ch)
            wid := current_m_strict(mt)
            chan_clear_epoch(s, mt)
            chan_wake_one(s, mt, wid, wu, true)
            chan_wake_one(s, mt, wid, ws, wu == 0)
            chan_notify_epoch_mt(s, mt, wid)
            << 1
        }
        if ld(ch + C_CLOSED) != 0 {
            chan_unlock(ch)
            for i in 0:esize { rt_store(dst + i, 1, 0) }
            chan_clear_epoch(s, mt)
            << 2
        }
        chan_unlock(ch)
        chan_record_epoch(s, mt, ep)
        << 0
    }
    direct := ld(ch + C_DIRECT)
    if direct != 0 {
        s := sched()
        if direct != ld(s + S_CUR) {
            << 0
        }
        st(ch + C_DIRECT, 0)
        st(ch + C_COUNT, 0)
        st(ch + C_RECVD, ld(ch + C_RECVD) + 1)
        waiter := ld(ch + C_WAITER)
        if waiter != 0 {
            st(ch + C_WAITER, 0)
            streak := ld(s + S_AFFINITY_TICKS)
            if streak < 8 && ld(s + S_AFFINITY) == 0 {
                if queue_unlink(s, waiter) {
                    st(s + S_AFFINITY_TICKS, streak + 1)
                    st(s + S_AFFINITY, waiter)
                }
            }
        }
        progress()
        << 1
    }
    if ld(ch + C_COUNT) > 0 {
        chan_take(ch, dst, esize)
        << 1
    }
    if ld(ch + C_CLOSED) != 0 {
        for i in 0:esize {
            rt_store(dst + i, 1, 0)
        }
        << 2
    }
    << 0
}

// Unbuffered sends complete once a receiver has taken the value.
pub fn chan_send(ch int, src int, esize int) {
    mt := sched_m_state()
    if mt != 0 {
        s := sched()
        while true {
            if ch == 0 {
                task_block()
                ->
            }
            chan_lock(ch)
            if ld(ch + C_CLOSED) != 0 {
                chan_unlock(ch)
                panic_send_closed()
            }
            if ld(ch + C_COUNT) < chan_slots(ch) {
                chan_put_ring(ch, src, esize)
                is_unbuf := ld(ch + C_CAP) == 0
                mine := ld(ch + C_SENT)
                w := chan_pop_rwait_locked(ch)
                chan_unlock(ch)
                wid := current_m_strict(mt)
                if is_unbuf && w != 0 && wid >= 0 && (w != ld(mt + MT_MAIN_TASK) || wid == 0) {
                    woke_peer := chan_wake_one_local(s, mt, wid, w, true)
                    chan_notify_epoch_mt(s, mt, wid)
                    $first := true
                    while true {
                        chan_lock(ch)
                        done := ld(ch + C_RECVD) >= mine || ld(ch + C_CLOSED) != 0
                        chan_unlock(ch)
                        if done {
                            if first && !woke_peer && w != ld(mt + MT_MAIN_TASK) && atomic_load(c_ptr(mt + MT_TOTAL_RUNNABLE)) > 0 {
                                _ := atomic_add(c_ptr(mt + MT_WAKE_SEQ), 1)
                                mt_signal_one_if_sleeping(mt, wid)
                            }
                            <<
                        }
                        first = false
                        t := current_task_mt(s, mt)
                        st(t + T_WAIT_MINE, mine)
                        m_park_switch(mt, t, PARK_CHAN_UNBUF, ch)
                    }
                }
                chan_wake_one(s, mt, wid, w, true)
                chan_notify_epoch_mt(s, mt, wid)
                if is_unbuf {
                    while true {
                        chan_lock(ch)
                        done := ld(ch + C_RECVD) >= mine || ld(ch + C_CLOSED) != 0
                        chan_unlock(ch)
                        if done { << }
                        t := current_task_mt(s, mt)
                        st(t + T_WAIT_MINE, mine)
                        m_park_switch(mt, t, PARK_CHAN_UNBUF, ch)
                    }
                }
                <<
            }
            chan_unlock(ch)
            t := current_task_mt(s, mt)
            m_park_switch(mt, t, PARK_CHAN_SEND, ch)
        }
    }
    while true {
        if ch != 0 {
            if ld(ch + C_CLOSED) != 0 {
                panic_send_closed()
            }
            if ld(ch + C_CAP) == 0 && ld(ch + C_COUNT) == 0 && ld(ch + C_DIRECT) == 0 && ld(ch + C_RWAIT) > 0 {
                rdst := ld(ch + C_RDST)
                rtask := ld(ch + C_RDST_TASK)
                if rdst != 0 && rtask != 0 {
                    if esize == 8 {
                        rt_store(rdst, 8, rt_load(src, 8))
                    } else {
                        mem_copy(rdst, src, esize)
                    }
                    st(ch + C_RDST, 0)
                    st(ch + C_RDST_TASK, 0)
                    st(ch + C_DIRECT, rtask)
                    st(ch + C_COUNT, 1)
                    st(ch + C_SENT, ld(ch + C_SENT) + 1)
                    s := sched()
                    streak := ld(s + S_AFFINITY_TICKS)
                    if streak < 8 && ld(s + S_AFFINITY) == 0 {
                        if queue_unlink(s, rtask) {
                            st(s + S_AFFINITY_TICKS, streak + 1)
                            st(s + S_AFFINITY, rtask)
                        }
                    }
                    progress()
                    mine := ld(ch + C_SENT)
                    cur := ld(s + S_CUR)
                    while ld(ch + C_RECVD) < mine && ld(ch + C_CLOSED) == 0 {
                        st(ch + C_WAITER, cur)
                        task_block()
                    }
                    if ld(ch + C_WAITER) == cur { st(ch + C_WAITER, 0) }
                    <<
                }
            }
            if ld(ch + C_COUNT) < chan_slots(ch) && ld(ch + C_DIRECT) == 0 {
                chan_put(ch, src, esize)
                if ld(ch + C_CAP) == 0 {
                    mine := ld(ch + C_SENT)
                    cur := ld(sched() + S_CUR)
                    while ld(ch + C_RECVD) < mine && ld(ch + C_CLOSED) == 0 {
                        st(ch + C_WAITER, cur)
                        task_block()
                    }
                    if ld(ch + C_WAITER) == cur { st(ch + C_WAITER, 0) }
                }
                <<
            }
            if ld(ch + C_DIRECT) == 0 {
                st(ch + C_WAITER, ld(sched() + S_CUR))
            }
        }
        task_block()
    }
}

// Receive into dst; false when the channel is closed and drained.
pub fn chan_recv(ch int, dst int, esize int) bool {
    mt := sched_m_state()
    if mt != 0 {
        s := sched()
        if ch == 0 {
            while true { task_block() }
            << false
        }
        chan_lock(ch)
        was_zero := ld(ch + C_RWAIT) == 0
        st(ch + C_RWAIT, ld(ch + C_RWAIT) + 1)
        if ld(ch + C_COUNT) > 0 {
            chan_take_ring(ch, dst, esize)
            st(ch + C_RWAIT, ld(ch + C_RWAIT) - 1)
            $wu := 0
            if ld(ch + C_CAP) == 0 {
                wu = ld(ch + C_UNBUF_WAITER)
                st(ch + C_UNBUF_WAITER, 0)
            }
            ws := chan_pop_swait_locked(ch)
            chan_unlock(ch)
            wid := current_m_strict(mt)
            chan_wake_one(s, mt, wid, wu, true)
            chan_wake_one(s, mt, wid, ws, wu == 0)
            chan_notify_epoch_mt(s, mt, wid)
            << true
        }
        if ld(ch + C_CLOSED) != 0 {
            st(ch + C_RWAIT, ld(ch + C_RWAIT) - 1)
            chan_unlock(ch)
            for i in 0:esize { rt_store(dst + i, 1, 0) }
            << false
        }
        chan_unlock(ch)
        if was_zero {
            chan_notify_epoch_mt(s, mt, current_m_strict(mt))
        }
        while true {
            t := current_task_mt(s, mt)
            m_park_switch(mt, t, PARK_CHAN_RECV, ch)
            chan_lock(ch)
            if ld(ch + C_COUNT) > 0 {
                chan_take_ring(ch, dst, esize)
                st(ch + C_RWAIT, ld(ch + C_RWAIT) - 1)
                $wu := 0
                if ld(ch + C_CAP) == 0 {
                    wu = ld(ch + C_UNBUF_WAITER)
                    st(ch + C_UNBUF_WAITER, 0)
                }
                ws := chan_pop_swait_locked(ch)
                chan_unlock(ch)
                wid := current_m_strict(mt)
                chan_wake_one(s, mt, wid, wu, true)
                chan_wake_one(s, mt, wid, ws, wu == 0)
                chan_notify_epoch_mt(s, mt, wid)
                << true
            }
            if ld(ch + C_CLOSED) != 0 {
                st(ch + C_RWAIT, ld(ch + C_RWAIT) - 1)
                chan_unlock(ch)
                for i in 0:esize { rt_store(dst + i, 1, 0) }
                << false
            }
            chan_unlock(ch)
        }
        << false
    }
    if ch != 0 {
        st(ch + C_RWAIT, ld(ch + C_RWAIT) + 1)
        progress()
    }
    while true {
        r := chan_try_recv(ch, dst, esize)
        if r != 0 {
            if ch != 0 {
                cur := ld(sched() + S_CUR)
                st(ch + C_RWAIT, ld(ch + C_RWAIT) - 1)
                if ld(ch + C_RDST_TASK) == cur {
                    st(ch + C_RDST, 0)
                    st(ch + C_RDST_TASK, 0)
                }
                if ld(ch + C_WAITER) == cur {
                    st(ch + C_WAITER, 0)
                }
            }
            << r == 1
        }
        if ch != 0 && ld(ch + C_DIRECT) == 0 {
            cur := ld(sched() + S_CUR)
            st(ch + C_WAITER, cur)
            if ld(ch + C_CAP) == 0 && ld(ch + C_RDST) == 0 {
                st(ch + C_RDST, dst)
                st(ch + C_RDST_TASK, cur)
            }
        }
        task_block()
    }
    << false
}

pub fn chan_close(ch int) {
    if ch == 0 {
        <<
    }
    mt := sched_m_state()
    if mt != 0 {
        s := sched()
        chan_lock(ch)
        st(ch + C_CLOSED, 1)
        st(ch + C_RDST, 0)
        st(ch + C_RDST_TASK, 0)
        wu := ld(ch + C_UNBUF_WAITER)
        st(ch + C_UNBUF_WAITER, 0)
        rhead := ld(ch + C_RWAIT_HEAD)
        st(ch + C_RWAIT_HEAD, 0)
        st(ch + C_RWAIT_TAIL, 0)
        shead := ld(ch + C_SWAIT_HEAD)
        st(ch + C_SWAIT_HEAD, 0)
        st(ch + C_SWAIT_TAIL, 0)
        chan_unlock(ch)
        wid := current_m_strict(mt)
        chan_wake_one(s, mt, wid, wu, false)
        chan_wake_list(s, mt, wid, rhead)
        chan_wake_list(s, mt, wid, shead)
        chan_notify_epoch_mt(s, mt, wid)
        <<
    }
    st(ch + C_CLOSED, 1)
    st(ch + C_RDST, 0)
    st(ch + C_RDST_TASK, 0)
    if host_win() && gword(G_SIGNAL_EVENT) != 0 {
        signal_update_os_hook()
    }
    progress()
}

