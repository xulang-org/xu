@runtime/core
// Hosted builtins on raw system calls (arm64 and x64, macOS and Linux;
// Windows through host_win.xu).
//
// Entry points called by xu/mir/lower_host.xu take descriptor addresses for
// string and array arguments. A string or array result is written through
// a leading out descriptor. Builtins that may throw return the error word
// (0 = success) and store a word-sized ok value through a leading okp, or
// fill the leading out value in place.

const AT_FDCWD = -100

const EINTR = 4
const EBADF = 9

fn host_linux() bool {
    << os_code() == OS_LINUX
}

fn host_nr(mac int, linux int) int {
    if host_linux() { << linux }
    << mac
}

fn host_sys_r1() int {
    << gword(G_SYS_R1)
}

// NUL-terminated copy of the string described by d.
fn host_cstr(d int) int {
    n := desc_len(d)
    buf := alloc(n + 1)
    if n > 0 {
        mem_copy(buf, desc_ptr(d), n)
    }
    rt_store(buf + n, 1, 0)
    << buf
}

fn host_strlen(p int) int {
    $n := 0
    while rt_load(p + n, 1) != 0 {
        n += 1
    }
    << n
}

fn host_string_at(d int) string {
    $s := ""
    bytes_new(rt_addr(&s), desc_ptr(d), desc_len(d))
    << s
}

// Append n bytes at src to the byte descriptor d.
fn host_append(d int, src int, n int) {
    len := desc_len(d)
    desc_reserve(d, len + n + 1, 1)
    if n > 0 {
        mem_copy(desc_ptr(d) + len, src, n)
    }
    rt_store(d + 8, 8, len + n)
}

// Append a fresh string holding n bytes at src to the []string at arr.
fn host_push_string(arr int, src int, n int) {
    elem := alloc(24)
    bytes_new(elem, src, n)
    slice_push(arr, elem, 24)
}

fn host_int_text(v int) string {
    if v == 0 {
        << "0"
    }
    $digits := ""
    $x := v
    if x < 0 {
        x = 0 - x
    }
    while x > 0 {
        digits.push_byte(48 + x % 10)
        x = x / 10
    }
    $out := ""
    if v < 0 {
        out.push_byte(45)
    }
    $i := digits.len - 1
    while i >= 0 {
        out.push_byte(digits[i])
        i -= 1
    }
    << out
}

fn host_errno_text(e int) string {
    if e == 1 { << "operation not permitted" }
    if e == 2 { << "no such file or directory" }
    if e == EBADF { << "bad file descriptor" }
    if e == 13 { << "permission denied" }
    if e == 17 { << "file exists" }
    if e == 20 { << "not a directory" }
    if e == 21 { << "is a directory" }
    if e == 22 { << "invalid argument" }
    if e == 28 { << "no space left on device" }
    if host_linux() || host_win() {
        if e == 11 { << "resource temporarily unavailable" }
        if e == 39 { << "directory not empty" }
        if e == 110 { << "connection timed out" }
        if e == 111 { << "connection refused" }
    } else {
        if e == 35 { << "resource temporarily unavailable" }
        if e == 60 { << "operation timed out" }
        if e == 61 { << "connection refused" }
        if e == 66 { << "directory not empty" }
    }
    << "errno " + host_int_text(e)
}

// Error word for "<op> <path>: <errno text>"; path 0 omits the path.
fn host_err(op string, path int, e int) int {
    $msg := op
    if path != 0 {
        msg = msg + " " + host_string_at(path)
    }
    msg = msg + ": " + host_errno_text(e)
    << err_from_str(&msg)
}

fn host_err_msg(msg string) int {
    << err_from_str(&msg)
}

fn host_ok(okp int, v int) int {
    if okp != 0 {
        rt_store(okp, 8, v)
    }
    << 0
}

// ===== system call wrappers (results are -errno on failure) =====

fn host_open(path int, flags int, mode int) int {
    if host_win() {
        << win_open(path, flags)
    }
    if host_linux() {
        << rt_syscall(56, AT_FDCWD, path, flags, mode, 0, 0)
    }
    << rt_syscall(5, path, flags, mode, 0, 0, 0)
}

fn host_close(fd int) int {
    if host_win() {
        << win_close(fd)
    }
    << rt_syscall(host_nr(6, 57), fd, 0, 0, 0, 0, 0)
}

fn host_read(fd int, buf int, n int) int {
    if host_win() {
        << win_read(fd, buf, n)
    }
    while true {
        r := rt_syscall(host_nr(3, 63), fd, buf, n, 0, 0, 0)
        if r != 0 - EINTR {
            << r
        }
    }
    << 0
}

fn host_write_all(fd int, buf int, n int) int {
    $done := 0
    while done < n {
        $r := 0
        if host_win() {
            r = win_write(fd, buf + done, n - done)
        } else {
            r = rt_syscall(sys_nr_write(), fd, buf + done, n - done, 0, 0, 0)
        }
        if r < 0 {
            if r != 0 - EINTR {
                << r
            }
        } else {
            done += r
        }
    }
    << done
}

fn host_lseek(fd int, off int, whence int) int {
    if host_win() {
        << win_lseek(fd, off, whence)
    }
    << rt_syscall(host_nr(199, 62), fd, off, whence, 0, 0, 0)
}

fn host_dup2(from int, to int) int {
    if host_linux() {
        << rt_syscall(24, from, to, 0, 0, 0, 0)
    }
    << rt_syscall(90, from, to, 0, 0, 0, 0)
}

// open(2) flags by host.
fn host_o_wronly_create(extra_linux int, extra_mac int) int {
    if host_linux() || host_win() { << 1 | 64 | extra_linux }
    << 1 | 512 | extra_mac
}

fn host_o_trunc_write() int {
    << host_o_wronly_create(512, 1024)
}

// x64, riscv64 and loong64 Linux share O_DIRECTORY/O_NOFOLLOW values that
// differ from arm64's, which the WASI shim also expects.
fn host_o_flags_x64_style() bool {
    a := xu_target_arch()
    << a == ARCH_X64 || a == ARCH_RISCV64 || a == ARCH_LOONG64
}

fn host_o_directory() int {
    if host_linux() && host_o_flags_x64_style() { << 65536 }
    << host_nr(1048576, 16384)
}

fn host_o_nofollow_linux() int {
    if host_o_flags_x64_style() { << 131072 }
    << 32768
}

// Microseconds/nanoseconds helpers for time structures.
fn host_now_wall() int {
    if host_win() {
        << win_now_wall()
    }
    if host_linux() {
        ts := alloc(16)
        rt_syscall(113, 0, ts, 0, 0, 0, 0)
        << rt_load(ts, 8) * 1000000000 + rt_load(ts + 8, 8)
    }
    tv := alloc(16)
    r := rt_syscall(116, tv, 0, 0, 0, 0, 0)
    if r > 0 {
        << r * 1000000000 + (host_sys_r1() & 4294967295) * 1000
    }
    << rt_load(tv, 8) * 1000000000 + rt_load(tv + 8, 4) * 1000
}

// POSIX poll ignores negative fds, even with an infinite timeout.
fn host_fd_in_range(fd int) bool {
    << fd >= 0 && (host_win() || fd <= 2147483647)
}

fn host_poll_ms(fd int, events int, timeout_ms int) int {
    if !host_fd_in_range(fd) {
        << 0 - EBADF
    }
    if host_win() {
        << win_poll(fd, events, timeout_ms)
    }
    // struct pollfd contains int fd, short events, short revents.
    $pollfd := fd | ((events & 65535) << 32)
    pfd := rt_addr($&pollfd)
    $r := 0
    if host_linux() {
        $ts := 0
        if timeout_ms >= 0 {
            ts = alloc(16)
            rt_store(ts, 8, timeout_ms / 1000)
            rt_store(ts + 8, 8, (timeout_ms % 1000) * 1000000)
        }
        r = rt_syscall(73, pfd, 1, ts, 0, 0, 0)
        free(ts)
    } else {
        r = rt_syscall(230, pfd, 1, timeout_ms, 0, 0, 0)
    }
    if r <= 0 {
        << r
    }
    revents := (pollfd >> 48) & 65535
    if (revents & 32) != 0 { // POLLNVAL
        << 0 - EBADF
    }
    << revents
}

// poll(2) for fd that lets other tasks run meanwhile; timeout_ms < 0 waits
// forever. Blocks the OS thread only while no other task can make progress.
fn host_poll_task(fd int, events int, timeout_ms int) int {
    if !task_others() || timeout_ms == 0 {
        << host_poll_ms(fd, events, timeout_ms)
    }
    deadline := host_now_ns() + timeout_ms * 1000000
    while true {
        r := host_poll_ms(fd, events, 0)
        if r != 0 {
            << r
        }
        if timeout_ms > 0 && host_now_ns() >= deadline {
            << 0
        }
        if !task_others() {
            $ms := -1
            if timeout_ms > 0 {
                remaining := deadline - host_now_ns()
                if remaining <= 0 {
                    << 0
                }
                ms = (remaining + 999999) / 1000000
            }
            << host_poll_ms(fd, events, ms)
        }
        if task_io_yield() {
            if timeout_ms > 0 && host_now_ns() >= deadline { << 0 }
            r2 := host_poll_ms(fd, events, 1)
            if r2 != 0 {
                << r2
            }
        }
    }
    << 0
}
