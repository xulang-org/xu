@runtime/core

#internal/uiabi

const UI_UINT_MAX = 4294967295

fn ui_host_linked() bool {
    << gword(uiabi.STATE_OFFSET / 8) != 0
}

fn ui_mailbox_path(path int) bool {
    // Little-endian bytes of ":xu:".
    << ui_host_linked() && desc_len(path) >= 4 && rt_load(desc_ptr(path), 4) == 0x3a75783a
}

fn ui_task_tick() int {
    if !task_others() {
        << 0
    }
    task_yield()
    << 1
}

pub fn host_ui_run(path int) int {
    if !ui_host_linked() {
        << 127
    }
    zpath := host_cstr(path)
    tick := ui_task_tick
    entry := rt_load(rt_addr(&tick), 8)
    rc := rt_syscall(uiabi.RUN, zpath, entry, rt_globals(), 0, 0, 0)
    free(zpath)
    << rc
}

fn host_ui_read(out int, path int) int {
    zpath := host_cstr(path)
    $len := 0
    handled := rt_syscall(uiabi.READ_LEN, zpath, rt_addr($&len), 0, 0, 0, 0)
    if handled != 1 || len >= UI_UINT_MAX {
        free(zpath)
        << host_err("read", path, 22)
    }
    if len == 0 {
        free(zpath)
        << 0
    }
    cap := len + 1
    buf := alloc(cap)
    rt_syscall(-5, buf, cap, 0, 0, 0, 0)
    copied := rt_syscall(uiabi.READ_COPY, zpath, buf, cap, 0, 0, 0)
    free(zpath)
    if copied != 1 {
        free(buf)
        << host_err("read", path, 22)
    }
    set_desc(out, buf, len, cap)
    << 0
}

fn host_ui_write(okp int, path int, data int) int {
    size := desc_len(data)
    if size > UI_UINT_MAX {
        << host_err("write", path, 22)
    }
    zpath := host_cstr(path)
    $written := 0
    handled := rt_syscall(uiabi.WRITE, zpath, desc_ptr(data), size, rt_addr($&written), 0, 0)
    free(zpath)
    if handled != 1 {
        << host_err("write", path, 22)
    }
    << host_ok(okp, written)
}
