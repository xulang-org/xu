@runtime/core
// Native maps: open addressing with linear probing.
//
// A map value is one word, the address of a header record. Slots live in a
// separate buffer; each slot is [tagged hash][key][value], where the key is
// an 8-byte int or a 24-byte string descriptor (its bytes copied on insert)
// and the value is copied by size. Deleted slots stay as tombstones until
// the next rehash. Iteration walks the slots in table order.
//
// Keys are passed by address: the int word or the string descriptor.

const M_LEN = 0
const M_USED = 8
const M_CAP = 16
const M_SLOTS = 24
const M_KSTR = 32
const M_KSIZE = 40
const M_VSIZE = 48
const M_STRIDE = 56
const M_SIZE = 64

const SLOT_EMPTY = 0
const SLOT_DELETED = 1

const MS_KEY = 8

fn mword(m int, off int) int {
    << rt_load(m + off, 8)
}

fn set_mword(m int, off int, v int) {
    rt_store(m + off, 8, v)
}

fn map_live_limit(cap int) int {
    // Keep room for new entries and tombstones. Compute without multiplying
    // the capacity, which can be near the allocation limit.
    << cap - cap / 4 + cap / 16
}

// kstr: 1 for string keys, 0 for int keys; vsize: value bytes.
pub fn map_new(kstr int, vsize int, cap int) int {
    if vsize < 0 || vsize > 9223372036854775807 - 128 || cap < 0 {
        fatal_no_memory()
    }
    $ksize := 8
    if kstr != 0 {
        ksize = 24
    }
    stride := MS_KEY + ksize + (vsize + 7) / 8 * 8
    if stride == 0 {
        fatal_no_memory()
        << 0
    }
    if stride < 0 {
        fatal_no_memory()
    }
    max_slots := (9223372036854775807 - 16399) / stride
    $n := 8
    while map_live_limit(n) < cap {
        if n > max_slots / 2 {
            fatal_no_memory()
        }
        n = n * 2
    }
    if n > max_slots {
        fatal_no_memory()
    }
    m := alloc(M_SIZE)
    set_mword(m, M_KSTR, kstr)
    set_mword(m, M_KSIZE, ksize)
    set_mword(m, M_VSIZE, vsize)
    set_mword(m, M_STRIDE, stride)
    map_alloc_slots(m, n)
    << m
}

fn map_alloc_slots(m int, n int) {
    stride := mword(m, M_STRIDE)
    if stride == 0 {
        fatal_no_memory()
        <<
    }
    if n <= 0 || stride < 0 {
        fatal_no_memory()
    }
    if n > (9223372036854775807 - 16399) / stride {
        fatal_no_memory()
    }
    set_mword(m, M_SLOTS, alloc(n * stride))
    set_mword(m, M_CAP, n)
    set_mword(m, M_LEN, 0)
    set_mword(m, M_USED, 0)
}

// Live hashes use the sign bit, which is outside every valid capacity mask.
// Zero and one mark empty slots and tombstones, respectively.
fn map_tag_hash(h int) int {
    << (h ^ ((h >> 32) & 4294967295)) | (1 << 63)
}

fn map_hash_str(key int) int {
    $h := -3750763034362895579
    p := desc_ptr(key)
    n := desc_len(key)
    for i in 0:n {
        h = (h ^ rt_load(p + i, 1)) * 1099511628211
    }
    << map_tag_hash(h)
}

fn map_hash_int(kv int) int {
    << map_tag_hash(kv * -7046029254386353131)
}

fn map_hash(m int, key int) int {
    if mword(m, M_KSTR) != 0 {
        << map_hash_str(key)
    }
    << map_hash_int(rt_load(key, 8))
}

fn map_key_eq(m int, slot int, key int) bool {
    if mword(m, M_KSTR) != 0 {
        << str_eq(slot + MS_KEY, key)
    }
    << rt_load(slot + MS_KEY, 8) == rt_load(key, 8)
}

fn map_slot_at(m int, i int) int {
    << mword(m, M_SLOTS) + i * mword(m, M_STRIDE)
}

fn map_val_off(m int) int {
    << MS_KEY + mword(m, M_KSIZE)
}

// Live slot holding key, or 0.
fn map_find(m int, key int) int {
    if m == 0 {
        << 0
    }
    kstr := mword(m, M_KSTR)
    slots := mword(m, M_SLOTS)
    stride := mword(m, M_STRIDE)
    mask := mword(m, M_CAP) - 1
    if kstr == 0 {
        kv := rt_load(key, 8)
        h := map_hash_int(kv)
        $i := h & mask
        while true {
            slot := slots + i * stride
            state := rt_load(slot, 8)
            if state == SLOT_EMPTY {
                << 0
            }
            if state == h && rt_load(slot + MS_KEY, 8) == kv {
                << slot
            }
            i = (i + 1) & mask
        }
        << 0
    }
    h := map_hash_str(key)
    $i := h & mask
    while true {
        slot := slots + i * stride
        state := rt_load(slot, 8)
        if state == SLOT_EMPTY {
            << 0
        }
        if state == h && str_eq(slot + MS_KEY, key) {
            << slot
        }
        i = (i + 1) & mask
    }
    << 0
}

fn map_rehash(m int, n int) {
    old := mword(m, M_SLOTS)
    ocap := mword(m, M_CAP)
    stride := mword(m, M_STRIDE)
    live := mword(m, M_LEN)
    map_alloc_slots(m, n)
    slots := mword(m, M_SLOTS)
    mask := n - 1
    if stride == 24 {
        for oi in 0:ocap {
            src := old + oi * 24
            hash := rt_load(src, 8)
            if hash < 0 {
                $i := hash & mask
                $dst := slots + i * 24
                while rt_load(dst, 8) != SLOT_EMPTY {
                    i = (i + 1) & mask
                    dst = slots + i * 24
                }
                rt_store(dst, 8, hash)
                rt_store(dst + 8, 8, rt_load(src + 8, 8))
                rt_store(dst + 16, 8, rt_load(src + 16, 8))
            }
        }
    } else {
        words := stride / 8
        for oi in 0:ocap {
            src := old + oi * stride
            hash := rt_load(src, 8)
            if hash < 0 {
                $i := hash & mask
                $dst := slots + i * stride
                while rt_load(dst, 8) != SLOT_EMPTY {
                    i = (i + 1) & mask
                    dst = slots + i * stride
                }
                rt_store(dst, 8, hash)
                for wi in 1:words {
                    off := wi * 8
                    rt_store(dst + off, 8, rt_load(src + off, 8))
                }
            }
        }
    }
    set_mword(m, M_LEN, live)
    set_mword(m, M_USED, live)
    free_owned(old)
}

fn map_nil_panic() {
    msg := "panic: assignment to entry in nil map\n"
    write_fd(2, str_ptr(&msg), msg.len)
    exit_process(1)
}

// Value address for key, inserting a zeroed value when it is absent.
// If existed_out != 0, stores 1 when key already existed and 0 when inserted.
pub fn map_put_has(m int, key int, existed_out int) int {
    if m == 0 {
        map_nil_panic()
    }
    kstr := mword(m, M_KSTR)
    slots := mword(m, M_SLOTS)
    cap := mword(m, M_CAP)
    stride := mword(m, M_STRIDE)
    val_off := MS_KEY + mword(m, M_KSIZE)
    mask := cap - 1
    $kv := 0
    $h := 0
    if kstr == 0 {
        kv = rt_load(key, 8)
        h = map_hash_int(kv)
    } else {
        h = map_hash_str(key)
    }
    $i := h & mask
    $first_del := 0
    while true {
        slot := slots + i * stride
        state := rt_load(slot, 8)
        if state == SLOT_EMPTY {
            <-
        }
        if state == SLOT_DELETED {
            if first_del == 0 {
                first_del = slot
            }
        } else if state == h {
            if kstr == 0 {
                if rt_load(slot + MS_KEY, 8) == kv {
                    if existed_out != 0 {
                        rt_store(existed_out, 8, 1)
                    }
                    << slot + val_off
                }
            } else if str_eq(slot + MS_KEY, key) {
                if existed_out != 0 {
                    rt_store(existed_out, 8, 1)
                }
                << slot + val_off
            }
        }
        i = (i + 1) & mask
    }
    if existed_out != 0 {
        rt_store(existed_out, 8, 0)
    }
    used := mword(m, M_USED)
    live := mword(m, M_LEN)
    $target := slots + i * stride
    if first_del != 0 {
        target = first_del
    }
    grow := live >= map_live_limit(cap)
    if grow || (first_del == 0 && used >= cap - cap / 8) {
        $n := cap
        if grow {
            if cap > 4611686018427387903 {
                fatal_no_memory()
            }
            n = cap * 2
        }
        map_rehash(m, n)
        nslots := mword(m, M_SLOTS)
        nmask := n - 1
        $ni := h & nmask
        while true {
            cand := nslots + ni * stride
            if rt_load(cand, 8) == SLOT_EMPTY {
                target = cand
                <-
            }
            ni = (ni + 1) & nmask
        }
        first_del = 0
    }
    if first_del == 0 {
        set_mword(m, M_USED, mword(m, M_USED) + 1)
    }
    set_mword(m, M_LEN, mword(m, M_LEN) + 1)
    rt_store(target, 8, h)
    if kstr != 0 {
        bytes_new(target + MS_KEY, desc_ptr(key), desc_len(key))
    } else {
        rt_store(target + MS_KEY, 8, kv)
    }
    val := target + val_off
    // map_alloc_slots zeroes the table. An empty slot still has its initial
    // value bytes; a tombstone can contain a previous entry's payload.
    if first_del == 0 {
        << val
    }
    vsize := mword(m, M_VSIZE)
    if vsize == 8 {
        rt_store(val, 8, 0)
    } else {
        for b in 0:vsize {
            rt_store(val + b, 1, 0)
        }
    }
    << val
}

pub fn map_put(m int, key int) int {
    << map_put_has(m, key, 0)
}

// Value address for key, or 0 when absent.
pub fn map_find_val(m int, key int) int {
    slot := map_find(m, key)
    if slot == 0 {
        << 0
    }
    << slot + map_val_off(m)
}

// Value address for key; a missing key ends the program.
pub fn map_val_ptr(m int, key int) int {
    slot := map_find(m, key)
    if slot == 0 {
        map_missing_key()
    }
    << slot + map_val_off(m)
}

fn map_missing_key() {
    msg := "map key not found\n"
    write_fd(2, str_ptr(&msg), msg.len)
    exit_process(1)
}

pub fn map_has(m int, key int) bool {
    << map_find(m, key) != 0
}

pub fn map_len(m int) int {
    if m == 0 {
        << 0
    }
    << mword(m, M_LEN)
}

pub fn map_delete(m int, key int) {
    slot := map_find(m, key)
    if slot != 0 {
        if mword(m, M_KSTR) != 0 {
            str_free(slot + MS_KEY)
        }
        rt_store(slot, 8, SLOT_DELETED)
        set_mword(m, M_LEN, mword(m, M_LEN) - 1)
    }
}

pub fn map_free(m int) {
    if m == 0 { << }
    cap := mword(m, M_CAP)
    if mword(m, M_KSTR) != 0 {
        for i in 0:cap {
            slot := map_slot_at(m, i)
            if rt_load(slot, 8) < 0 {
                str_free(slot + MS_KEY)
            }
        }
    }
    free_owned(mword(m, M_SLOTS))
    free_owned(m)
}

// Move the value for key to dst and remove the entry; a missing key ends
// the program.
pub fn map_take(m int, key int, dst int) {
    slot := map_find(m, key)
    if slot == 0 {
        map_missing_key()
    }
    mem_copy(dst, slot + map_val_off(m), mword(m, M_VSIZE))
    if mword(m, M_KSTR) != 0 {
        str_free(slot + MS_KEY)
    }
    rt_store(slot, 8, SLOT_DELETED)
    set_mword(m, M_LEN, mword(m, M_LEN) - 1)
}

// Index of the first live slot at or after i, or -1.
pub fn map_next(m int, i int) int {
    if m == 0 {
        << -1
    }
    cap := mword(m, M_CAP)
    $j := i
    while j < cap {
        if rt_load(map_slot_at(m, j), 8) < 0 {
            << j
        }
        j += 1
    }
    << -1
}

pub fn map_key_at(m int, i int) int {
    << map_slot_at(m, i) + MS_KEY
}

pub fn map_val_at(m int, i int) int {
    << map_slot_at(m, i) + map_val_off(m)
}
