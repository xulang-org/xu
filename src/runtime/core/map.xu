@runtime/core
// Native maps: open addressing with linear probing.
//
// A map value is one word, the address of a header record. Slots live in a
// separate buffer; each slot is [state][hash][key][value], where the key is
// an 8-byte int or a 24-byte string descriptor (its bytes copied on insert)
// and the value is copied by size. Deleted slots stay as tombstones until
// the next rehash. Iteration walks the slots in table order.
//
// Keys are passed by address: the int word or the string descriptor.

const M_LEN = 0
const M_USED = 8
const M_CAP = 16
const M_SLOTS = 24
const M_KSTR = 32
const M_KSIZE = 40
const M_VSIZE = 48
const M_STRIDE = 56
const M_SIZE = 64

const SLOT_EMPTY = 0
const SLOT_DELETED = 1
const SLOT_LIVE = 2

// Slot offsets: state word, hash word, then key and value.
const MS_HASH = 8
const MS_KEY = 16

fn mword(m int, off int) int {
    << rt_load(m + off, 8)
}

fn set_mword(m int, off int, v int) {
    rt_store(m + off, 8, v)
}

// kstr: 1 for string keys, 0 for int keys; vsize: value bytes.
pub fn map_new(kstr int, vsize int, cap int) int {
    m := alloc(M_SIZE)
    $ksize := 8
    if kstr != 0 {
        ksize = 24
    }
    set_mword(m, M_KSTR, kstr)
    set_mword(m, M_KSIZE, ksize)
    set_mword(m, M_VSIZE, vsize)
    set_mword(m, M_STRIDE, MS_KEY + ksize + (vsize + 7) / 8 * 8)
    $n := 8
    while n * 3 < cap * 4 {
        n = n * 2
    }
    map_alloc_slots(m, n)
    << m
}

fn map_alloc_slots(m int, n int) {
    set_mword(m, M_SLOTS, alloc(n * mword(m, M_STRIDE)))
    set_mword(m, M_CAP, n)
    set_mword(m, M_LEN, 0)
    set_mword(m, M_USED, 0)
}

fn map_hash(m int, key int) int {
    $h := 0
    if mword(m, M_KSTR) != 0 {
        h = -3750763034362895579
        p := desc_ptr(key)
        n := desc_len(key)
        for i in 0:n {
            h = (h ^ rt_load(p + i, 1)) * 1099511628211
        }
    } else {
        h = rt_load(key, 8) * -7046029254386353131
    }
    << h ^ ((h >> 32) & 4294967295)
}

fn map_key_eq(m int, slot int, key int) bool {
    if mword(m, M_KSTR) != 0 {
        << str_eq(slot + MS_KEY, key)
    }
    << rt_load(slot + MS_KEY, 8) == rt_load(key, 8)
}

fn map_slot_at(m int, i int) int {
    << mword(m, M_SLOTS) + i * mword(m, M_STRIDE)
}

fn map_val_off(m int) int {
    << MS_KEY + mword(m, M_KSIZE)
}

// Live slot holding key, or 0.
fn map_find(m int, key int) int {
    if m == 0 {
        << 0
    }
    h := map_hash(m, key)
    mask := mword(m, M_CAP) - 1
    $i := h & mask
    while true {
        slot := map_slot_at(m, i)
        state := rt_load(slot, 8)
        if state == SLOT_EMPTY {
            << 0
        }
        if state == SLOT_LIVE && rt_load(slot + MS_HASH, 8) == h && map_key_eq(m, slot, key) {
            << slot
        }
        i = (i + 1) & mask
    }
    << 0
}

fn map_rehash(m int, n int) {
    old := mword(m, M_SLOTS)
    ocap := mword(m, M_CAP)
    stride := mword(m, M_STRIDE)
    live := mword(m, M_LEN)
    map_alloc_slots(m, n)
    mask := n - 1
    for oi in 0:ocap {
        src := old + oi * stride
        if rt_load(src, 8) == SLOT_LIVE {
            $i := rt_load(src + MS_HASH, 8) & mask
            while rt_load(map_slot_at(m, i), 8) != SLOT_EMPTY {
                i = (i + 1) & mask
            }
            mem_copy(map_slot_at(m, i), src, stride)
        }
    }
    set_mword(m, M_LEN, live)
    set_mword(m, M_USED, live)
}

// Value address for key, inserting a zeroed value when it is absent.
pub fn map_put(m int, key int) int {
    found := map_find(m, key)
    if found != 0 {
        << found + map_val_off(m)
    }
    cap := mword(m, M_CAP)
    if (mword(m, M_USED) + 1) * 4 > cap * 3 {
        $n := cap
        if (mword(m, M_LEN) + 1) * 2 > cap {
            n = cap * 2
        }
        map_rehash(m, n)
    }
    h := map_hash(m, key)
    mask := mword(m, M_CAP) - 1
    $i := h & mask
    while rt_load(map_slot_at(m, i), 8) == SLOT_LIVE {
        i = (i + 1) & mask
    }
    slot := map_slot_at(m, i)
    if rt_load(slot, 8) == SLOT_EMPTY {
        set_mword(m, M_USED, mword(m, M_USED) + 1)
    }
    set_mword(m, M_LEN, mword(m, M_LEN) + 1)
    rt_store(slot, 8, SLOT_LIVE)
    rt_store(slot + MS_HASH, 8, h)
    if mword(m, M_KSTR) != 0 {
        bytes_new(slot + MS_KEY, desc_ptr(key), desc_len(key))
    } else {
        rt_store(slot + MS_KEY, 8, rt_load(key, 8))
    }
    val := slot + map_val_off(m)
    vsize := mword(m, M_VSIZE)
    for b in 0:vsize {
        rt_store(val + b, 1, 0)
    }
    << val
}

// Value address for key, or 0 when absent.
pub fn map_find_val(m int, key int) int {
    slot := map_find(m, key)
    if slot == 0 {
        << 0
    }
    << slot + map_val_off(m)
}

// Value address for key; a missing key ends the program.
pub fn map_val_ptr(m int, key int) int {
    slot := map_find(m, key)
    if slot == 0 {
        map_missing_key()
    }
    << slot + map_val_off(m)
}

fn map_missing_key() {
    msg := "map key not found\n"
    write_fd(2, str_ptr(&msg), msg.len)
    exit_process(1)
}

pub fn map_has(m int, key int) bool {
    << map_find(m, key) != 0
}

pub fn map_len(m int) int {
    if m == 0 {
        << 0
    }
    << mword(m, M_LEN)
}

pub fn map_delete(m int, key int) {
    slot := map_find(m, key)
    if slot != 0 {
        rt_store(slot, 8, SLOT_DELETED)
        set_mword(m, M_LEN, mword(m, M_LEN) - 1)
    }
}

// Move the value for key to dst and remove the entry; a missing key ends
// the program.
pub fn map_take(m int, key int, dst int) {
    slot := map_find(m, key)
    if slot == 0 {
        map_missing_key()
    }
    mem_copy(dst, slot + map_val_off(m), mword(m, M_VSIZE))
    rt_store(slot, 8, SLOT_DELETED)
    set_mword(m, M_LEN, mword(m, M_LEN) - 1)
}

// Index of the first live slot at or after i, or -1.
pub fn map_next(m int, i int) int {
    if m == 0 {
        << -1
    }
    cap := mword(m, M_CAP)
    $j := i
    while j < cap {
        if rt_load(map_slot_at(m, j), 8) == SLOT_LIVE {
            << j
        }
        j += 1
    }
    << -1
}

pub fn map_key_at(m int, i int) int {
    << map_slot_at(m, i) + MS_KEY
}

pub fn map_val_at(m int, i int) int {
    << map_slot_at(m, i) + map_val_off(m)
}
