@runtime

#errors

// Ordinary XU algorithms for string/ASCII builtins (COMPILE_LAYERING_PLAN P1).
// These go through normal typecheck / MIR / codegen. They must not use
// Assembler, and must not call back into the builtins they replace.
//
// Versioned signatures, ownership, syntax aliases and conservative effect
// declarations live in src/runtime/ABI.json. The generated checker table
// validates ordinary Xu value shapes before lowering; effects are not proof
// of purity and confer no primitive/host capability. In particular parse_int
// may allocate on its boxed errors.Error path, and fail-loud paths can write.
// Grammar builtin names stay as syntax entry; check_call_expr binds them to
// these functions (user fn of the same name in cur_mod still wins).
// Read-only string inputs borrow their descriptor. Builtin syntax uses
// the ordinary typed pointer-argument lowering and keeps the owner alive.
// Retired ncall IDs (kept for collision safety): -25, -15, -16, -17, -18.

// starts_with(s, prefix) → bool. S7 guard: negative descriptor lengths
// fail-loud. No arbitrary size cap — prefixes may come from runtime data.
pub fn starts_with(s &string, prefix &string) bool {
    if s.len < 0 || prefix.len < 0 {
        eprintln("xu: starts_with: invalid string length")
        <<< 1
    }
    if prefix.len > s.len {
        << false
    }
    for i in 0:prefix.len {
        if s[i] != prefix[i] {
            << false
        }
    }
    << true
}

// ASCII character predicates. Ranges are the historical byte ranges only —
// do not widen to Unicode whitespace or locale classes.
pub fn is_digit(c int) bool {
    << c >= 48 && c <= 57
}

pub fn is_alpha(c int) bool {
    if c >= 65 && c <= 90 {
        << true
    }
    << c >= 97 && c <= 122
}

pub fn is_alnum(c int) bool {
    if c >= 48 && c <= 57 {
        << true
    }
    if c >= 65 && c <= 90 {
        << true
    }
    << c >= 97 && c <= 122
}

pub fn is_space(c int) bool {
    if c == 32 {
        << true
    }
    if c == 9 {
        << true
    }
    if c == 10 {
        << true
    }
    << c == 13
}

// itoa(n) uses a decimal slice buffer and single-argument string_from_bytes.
// Keep the quotient signed; negating only the remainder handles INT_MIN.
pub fn itoa(n int) string {
    if n == 0 { << "0" }
    $x := n
    $neg := false
    if n < 0 {
        neg = true
    }
    $digits := []int{}
    while x != 0 {
        $d := x % 10
        x = x / 10
        if d < 0 {
            d = 0 - d
        }
        digits.push(48 + d)
    }
    $outb := []int{}
    if neg {
        outb.push(45)
    }
    $i := digits.len
    while i > 0 {
        i = i - 1
        outb.push(digits[i])
    }
    << string_from_bytes(outb)
}

// parse_int(s) → int, may-throw. Ordinary replacement for rt_emit_parse_int.
// Messages and edge cases match the old helper and strconv.parse:
// empty / lone '-' / non-digit → "parse_int: invalid integer";
// overflow → "parse_int: out of range"; INT_MIN is accepted.
// Up to 18 decimal digits fit in a positive int. Keep that common scan in
// a non-throwing borrowed leaf; the caller checks its length and applies
// the sign. Longer inputs retain the checked INT_MIN/overflow path below.
fn parse_decimal_short(s &string, start int) int {
    $acc := 0
    for i in start:s.len {
        d := s[i] - 48
        if d < 0 || d > 9 { << -1 }
        acc = acc * 10 + d
    }
    << acc
}

pub fn parse_int(s &string) int {
    if s.len == 0 {
        >> errors.new("parse_int: invalid integer")
    }
    $i := 0
    $neg := false
    if s[0] == 45 {
        neg = true
        i = 1
        if s.len == 1 {
            >> errors.new("parse_int: invalid integer")
        }
    }
    if s.len - i <= 18 {
        value := parse_decimal_short(s, i)
        if value < 0 { >> errors.new("parse_int: invalid integer") }
        if neg { << 0 - value }
        << value
    }
    maxp := 9223372036854775807
    $acc := 0
    $saw_digit := false
    // lim = maxp / 10 = 922337203685477580
    lim := 922337203685477580
    while i < s.len {
        c := s[i]
        if c < 48 || c > 57 {
            >> errors.new("parse_int: invalid integer")
        }
        d := c - 48
        $last := false
        if i == s.len - 1 {
            last = true
        }
        if acc > lim {
            // Negative last-digit INT_MIN is handled below via room == d - 1.
            // No other acc > lim value is representable.
            >> errors.new("parse_int: out of range")
        }
        prod := acc * 10
        room := maxp - prod
        if room < d {
            if neg {
                if last {
                    if room == d - 1 {
                        << 0 - 9223372036854775807 - 1
                    }
                }
            }
            >> errors.new("parse_int: out of range")
        }
        acc = prod + d
        saw_digit = true
        i = i + 1
    }
    if !saw_digit {
        >> errors.new("parse_int: invalid integer")
    }
    if neg {
        << 0 - acc
    }
    << acc
}

// str_bytes(s) → []int of byte values. Ordinary replacement for
// rt_emit_str_bytes / s.bytes(). Bounded index loop, first-stage array base.
pub fn str_bytes(s &string) []int {
    $out := []int{}
    for i in 0:s.len {
        out.push(s[i] & 255)
    }
    << out
}

// UTF-8 continuation byte test (0b10xxxxxx).
fn utf8_cont(b int) bool {
    << (b & 192) == 128
}

// Decode one rune at i. Invalid / truncated / overlong sequences fail-loud
// on stderr with exit 1 (old _rt_utf8_next). Borrowed string: callers such as
// str_runes must not clone the whole buffer per codepoint.
fn utf8_next(s &string, i int) int {
    if i < 0 || i >= s.len {
        eprintln("invalid utf-8")
        <<< 1
    }
    b0 := s[i] & 255
    if b0 < 128 {
        << b0
    }
    if b0 < 194 {
        eprintln("invalid utf-8")
        <<< 1
    }
    if b0 < 224 {
        // 2-byte
        if i + 1 >= s.len {
            eprintln("invalid utf-8")
            <<< 1
        }
        b1 := s[i + 1] & 255
        if !utf8_cont(b1) {
            eprintln("invalid utf-8")
            <<< 1
        }
        r := ((b0 & 31) << 6) | (b1 & 63)
        if r < 128 {
            eprintln("invalid utf-8")
            <<< 1
        }
        << r
    }
    if b0 < 240 {
        // 3-byte
        if i + 2 >= s.len {
            eprintln("invalid utf-8")
            <<< 1
        }
        b1 := s[i + 1] & 255
        b2 := s[i + 2] & 255
        if !utf8_cont(b1) || !utf8_cont(b2) {
            eprintln("invalid utf-8")
            <<< 1
        }
        r := ((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)
        if r < 2048 {
            eprintln("invalid utf-8")
            <<< 1
        }
        if r >= 55296 && r <= 57343 {
            eprintln("invalid utf-8")
            <<< 1
        }
        << r
    }
    if b0 < 245 {
        // 4-byte
        if i + 3 >= s.len {
            eprintln("invalid utf-8")
            <<< 1
        }
        b1 := s[i + 1] & 255
        b2 := s[i + 2] & 255
        b3 := s[i + 3] & 255
        if !utf8_cont(b1) || !utf8_cont(b2) || !utf8_cont(b3) {
            eprintln("invalid utf-8")
            <<< 1
        }
        r := ((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)
        if r < 65536 {
            eprintln("invalid utf-8")
            <<< 1
        }
        if r > 1114111 {
            eprintln("invalid utf-8")
            <<< 1
        }
        << r
    }
    eprintln("invalid utf-8")
    <<< 1
    << 0
}

// utf8_advance(s, i) → index after the rune at i. Fail-loud like utf8_next.
fn utf8_advance(s &string, i int) int {
    if i < 0 || i >= s.len {
        eprintln("invalid utf-8")
        <<< 1
    }
    b0 := s[i] & 255
    if b0 < 128 {
        << i + 1
    }
    if b0 < 224 {
        << i + 2
    }
    if b0 < 240 {
        << i + 3
    }
    << i + 4
}

// str_runes(s) → []int of codepoints. Ordinary replacement for
// rt_emit_str_runes / s.runes(). Invalid UTF-8 fail-louds (stderr + exit 1).
// Helpers take &string so heap strings are not cloned per codepoint.
pub fn str_runes(s &string) []int {
    $out := []int{}
    $i := 0
    while i < s.len {
        r := utf8_next(s, i)
        out.push(r)
        i = utf8_advance(s, i)
    }
    << out
}
