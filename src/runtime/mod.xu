@runtime

// Compile-time callsite frame (M170/M174). `caller(0)` and `caller(1)` are
// rewritten to a Frame literal for this call site. Other skip values are
// rejected at compile time (no runtime stack walk).
pub struct Frame {
    pub file string
    pub line int
    pub ok bool
}

pub fn caller(skip int) Frame {
    // Body never runs: bootstrap/Gen1 lower `runtime.caller` to a Frame
    // literal at the call site.
    << Frame{file: "", line: 0, ok: false}
}
