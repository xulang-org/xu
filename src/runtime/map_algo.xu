@runtime

// Pure ordinary Xu policy. No Assembler, container allocation or raw memory
// capability: native map adapters supply scalar state and borrowed keys.
// Arithmetic is modulo 2^64; masks turn Xu's signed shifts into logical shifts.
pub fn map_mix64(value int) int {
    mut x := value
    x = x ^ ((x >> 30) & 17179869183)
    x = x * (0 - 4658895280553007687)
    x = x ^ ((x >> 27) & 137438953471)
    x = x * (0 - 7723592293110705685)
    << x ^ ((x >> 31) & 8589934591)
}

pub fn map_hash_int(key int, seed int) int {
    // Keep the seeded scalar entry call-free. These are the same mix64
    // rounds above; duplicating the short expression avoids an extra frame
    // per key without adding a seed-xor to every byte of string hashing.
    // Runtime policy regressions compare both entries against one oracle.
    mut x := key ^ seed
    x = x ^ ((x >> 30) & 17179869183)
    x = x * (0 - 4658895280553007687)
    x = x ^ ((x >> 27) & 137438953471)
    x = x * (0 - 7723592293110705685)
    << x ^ ((x >> 31) & 8589934591)
}

pub fn map_hash_string(key &string, seed int) int {
    mut h := seed
    for i in 0:key.len {
        b := key[i] & 255
        mut x := h ^ (b + (0 - 7046029254386353131))
        x = x ^ ((x >> 30) & 17179869183)
        x = x * (0 - 4658895280553007687)
        x = x ^ ((x >> 27) & 137438953471)
        x = x * (0 - 7723592293110705685)
        h = x ^ ((x >> 31) & 8589934591)
    }
    mut end_x := h + key.len * (0 - 7046029254386353131)
    end_x = end_x ^ ((end_x >> 30) & 17179869183)
    end_x = end_x * (0 - 4658895280553007687)
    end_x = end_x ^ ((end_x >> 27) & 137438953471)
    end_x = end_x * (0 - 7723592293110705685)
    << end_x ^ ((end_x >> 31) & 8589934591)
}

// 0=keep, 1=grow, 2=compact. Native storage guarantees 0<=live<=used<=cap
// and power-of-two cap>=16. cap-cap/4 avoids overflow at large capacities.
pub fn map_insert_action(live int, used int, cap int) int {
    if cap <= 0 { << 1 }
    threshold := cap - cap / 4
    if used < threshold { << 0 }
    if live >= threshold { << 1 }
    << 2
}
