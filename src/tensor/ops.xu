@tensor

#math

// Pure-Xu canonical f32 and Q8_0 tensor operations.
// Loop structures match the compiler's MIR tensor fusion passes so builds with
// XU_TENSOR_FUSION=1 automatically lower them to native ARM64 NEON / x64 SSE2 kernels.

pub fn dot_f32(a &[]f32, b &[]f32, n int) f32 {
    $acc := f32(0)
    for i in 0:n {
        acc += a[i] * b[i]
    }
    << acc
}

pub fn axpy_f32(dst $&[]f32, src &[]f32, alpha f32, n int) {
    for i in 0:n {
        dst[i] += alpha * src[i]
    }
}

pub fn vadd_f32(dst $&[]f32, src &[]f32, n int) {
    for i in 0:n {
        dst[i] += src[i]
    }
}

pub fn vmul_f32(out $&[]f32, a &[]f32, b &[]f32, n int) {
    for i in 0:n {
        out[i] = a[i] * b[i]
    }
}

pub fn vscale_f32(dst $&[]f32, scale f32, n int) {
    base := 0
    for i in 0:n {
        dst[base + i] = dst[base + i] * scale
    }
}

pub fn rmsnorm_f32(out $&[]f32, x &[]f32, weight &[]f32, n int, eps f64) {
    if n <= 0 { << }
    base := 0
    $sum := f32(0)
    for j in 0:n {
        v := x[base + j]
        sum += v * v
    }
    inv := f32(1.0 / math.sqrt(f64(sum) / f64(n) + eps))
    for k in 0:n {
        out[base + k] = (x[base + k] * inv) * weight[k]
    }
}

pub fn softmax_f32(scores $&[]f32, n int, scale f32) {
    if n <= 0 || n > scores.len { << }
    $max_v := scores[0] * scale
    scores[0] = max_v
    for t in 1:n {
        v := scores[t] * scale
        scores[t] = v
        if v > max_v { max_v = v }
    }
    $sum_v := 0.0
    for t in 0:n {
        ew := f32(math.exp(f64(scores[t] - max_v)))
        scores[t] = ew
        sum_v += f64(ew)
    }
    inv := f32(1.0 / sum_v)
    for t in 0:n {
        scores[t] = scores[t] * inv
    }
}

pub fn swiglu_f32(out $&[]f32, gate &[]f32, up &[]f32, n int) {
    for i in 0:n {
        g := gate[i]
        silu := f32(f64(g) / (1.0 + math.exp(f64(-g))))
        out[i] = silu * up[i]
    }
}

pub fn matvec_f32(out $&[]f32, x &[]f32, weights &[]f32, rows int, cols int) {
    w_off := 0
    for r in 0:rows {
        row_off := w_off + r * cols
        $acc := f32(0)
        for c in 0:cols {
            acc += weights[row_off + c] * x[c]
        }
        out[r] = acc
    }
}

pub fn matmul_f32(out $&[]f32, x &[]f32, weights &[]f32, m_cnt int, rows int, cols int) {
    w_off := 0
    for m in 0:m_cnt {
        x_off := m * cols
        out_off := m * rows
        for r in 0:rows {
            row_off := w_off + r * cols
            $acc := f32(0)
            for c in 0:cols {
                acc += weights[row_off + c] * x[x_off + c]
            }
            out[out_off + r] = acc
        }
    }
}

pub fn argmax_f32(x &[]f32, n int) int {
    if n <= 0 || n > x.len { << 0 }
    $best_i := 0
    $best_v := x[0]
    for i in 1:n {
        if x[i] > best_v {
            best_v = x[i]
            best_i = i
        }
    }
    << best_i
}

pub fn quantize_q8_0(x &[]f32, xq $&[]i8, scales $&[]f32, n int) {
    nb := n / 32
    for b in 0:nb {
        base := b * 32
        $amax := 0.0
        for i in 0:32 {
            $v := f64(x[base + i])
            if v < 0.0 { v = -v }
            if v > amax { amax = v }
        }
        scale := f32(amax / 127.0)
        scales[b] = scale
        $inv := 0.0
        if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
        for i in 0:32 {
            vf := f64(x[base + i]) * inv
            $q := 0
            if vf >= 0.0 { q = int(vf + 0.5) } else { q = -int(0.5 - vf) }
            if q > 127 { q = 127 }
            if q < -127 { q = -127 }
            xq[base + i] = i8(q)
        }
    }
}

pub fn vsub_f32(out $&[]f32, a &[]f32, b &[]f32, n int) {
    for i in 0:n {
        out[i] = a[i] - b[i]
    }
}

pub fn silu_f32(out $&[]f32, x &[]f32, n int) {
    for i in 0:n {
        v := f64(x[i])
        if v < -88.0 {
            out[i] = f32(0)
        } else {
            out[i] = f32(v / (1.0 + math.exp(-v)))
        }
    }
}

pub fn gelu_f32(out $&[]f32, x &[]f32, n int) {
    sqrt_2_over_pi := 0.7978845608028654
    for i in 0:n {
        v := f64(x[i])
        t := math.tanh(sqrt_2_over_pi * (v + 0.044715 * v * v * v))
        out[i] = f32(0.5 * v * (1.0 + t))
    }
}

pub fn layernorm_f32(out $&[]f32, x &[]f32, weight &[]f32, bias &[]f32, n int, eps f64) {
    if n <= 0 { << }
    $sum := 0.0
    for i in 0:n {
        sum += f64(x[i])
    }
    mean := sum / f64(n)
    $var_sum := 0.0
    for i in 0:n {
        d := f64(x[i]) - mean
        var_sum += d * d
    }
    inv := 1.0 / math.sqrt(var_sum / f64(n) + eps)
    for i in 0:n {
        out[i] = f32(((f64(x[i]) - mean) * inv) * f64(weight[i]) + f64(bias[i]))
    }
}

pub fn l2_normalize_f32(out $&[]f32, x &[]f32, n int, eps f64) {
    if n <= 0 { << }
    sq := f64(dot_f32(x, x, n))
    inv := f32(1.0 / math.sqrt(sq + eps))
    for i in 0:n {
        out[i] = x[i] * inv
    }
}

pub fn cosine_similarity_f32(a &[]f32, b &[]f32, n int) f32 {
    if n <= 0 { << f32(0) }
    da := f64(dot_f32(a, a, n))
    db := f64(dot_f32(b, b, n))
    denom := math.sqrt(da * db)
    if denom <= 0.0 { << f32(0) }
    << f32(f64(dot_f32(a, b, n)) / denom)
}

pub fn rope_f32(vec $&[]f32, n_heads int, head_dim int, pos int, theta f64) {
    if n_heads <= 0 || head_dim <= 0 || (head_dim % 2) != 0 || theta <= 0.0 { << }
    half := head_dim / 2
    log_theta := math.log(theta)
    for h in 0:n_heads {
        h_off := h * head_dim
        h_off1 := h_off + half
        for j in 0:half {
            freq := math.exp(-log_theta * (f64(2 * j) / f64(head_dim)))
            angle := f64(pos) * freq
            c := f32(math.cos(angle))
            s := f32(math.sin(angle))
            v0 := vec[h_off + j]
            v1 := vec[h_off1 + j]
            vec[h_off + j] = f32(v0 * c - v1 * s)
            vec[h_off1 + j] = f32(v0 * s + v1 * c)
        }
    }
}

pub fn quantize_q4_0_row(x &[]f32, qs $&[]u8, scales $&[]f32, n int) {
    nb := n / 32
    for b in 0:nb {
        base := b * 32
        $amax := 0.0
        for i in 0:32 {
            $v := f64(x[base + i])
            if v < 0.0 { v = -v }
            if v > amax { amax = v }
        }
        scale := f32(amax / 7.0)
        scales[b] = scale
        $inv := 0.0
        if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
        q_off := b * 16
        for j in 0:16 {
            vf0 := f64(x[base + j]) * inv
            $q0 := 0
            if vf0 >= 0.0 { q0 = int(vf0 + 0.5) + 8 } else { q0 = 8 - int(0.5 - vf0) }
            if q0 < 0 { q0 = 0 }
            if q0 > 15 { q0 = 15 }

            vf1 := f64(x[base + 16 + j]) * inv
            $q1 := 0
            if vf1 >= 0.0 { q1 = int(vf1 + 0.5) + 8 } else { q1 = 8 - int(0.5 - vf1) }
            if q1 < 0 { q1 = 0 }
            if q1 > 15 { q1 = 15 }

            qs[q_off + j] = u8((q0 & 15) | ((q1 & 15) << 4))
        }
    }
}

pub fn rope_interleaved_f32(vec $&[]f32, n_heads int, head_dim int, pos int, theta f64) {
    if n_heads <= 0 || head_dim <= 0 || (head_dim % 2) != 0 || theta <= 0.0 { << }
    half := head_dim / 2
    log_theta := math.log(theta)
    for h in 0:n_heads {
        h_off := h * head_dim
        for j in 0:half {
            freq := math.exp(-log_theta * (f64(2 * j) / f64(head_dim)))
            angle := f64(pos) * freq
            c := f32(math.cos(angle))
            s := f32(math.sin(angle))
            i0 := h_off + 2 * j
            v0 := vec[i0]
            v1 := vec[i0 + 1]
            vec[i0] = f32(v0 * c - v1 * s)
            vec[i0 + 1] = f32(v0 * s + v1 * c)
        }
    }
}

pub fn geglu_f32(out $&[]f32, gate &[]f32, up &[]f32, n int) {
    sqrt_2_over_pi := 0.7978845608028654
    for i in 0:n {
        v := f64(gate[i])
        t := math.tanh(sqrt_2_over_pi * (v + 0.044715 * v * v * v))
        gelu := f32(0.5 * v * (1.0 + t))
        out[i] = gelu * up[i]
    }
}

pub fn log_softmax_f32(scores $&[]f32, n int) {
    if n <= 0 || n > scores.len { << }
    $max_v := scores[0]
    for i in 1:n {
        if scores[i] > max_v { max_v = scores[i] }
    }
    $sum_v := 0.0
    for i in 0:n {
        sum_v += math.exp(f64(scores[i] - max_v))
    }
    log_denom := f64(max_v) + math.log(sum_v)
    for i in 0:n {
        scores[i] = f32(f64(scores[i]) - log_denom)
    }
}

pub fn add_rmsnorm_f32(norm_out $&[]f32, residual_out $&[]f32, x &[]f32, residual &[]f32, weight &[]f32, n int, eps f64) {
    if n <= 0 { << }
    $sum := f32(0)
    for i in 0:n {
        r := x[i] + residual[i]
        residual_out[i] = r
        sum += r * r
    }
    inv := f32(1.0 / math.sqrt(f64(sum) / f64(n) + eps))
    for i in 0:n {
        norm_out[i] = (residual_out[i] * inv) * weight[i]
    }
}

pub fn topk_f32(x &[]f32, n int, k int, out_idx $&[]int, out_val $&[]f32) int {
    $limit := k
    if n < limit { limit = n }
    if out_idx.len < limit { limit = out_idx.len }
    if out_val.len < limit { limit = out_val.len }
    if limit <= 0 { << 0 }
    for p in 0:limit {
        $best_i := -1
        $best_v := f32(0)
        for i in 0:n {
            $used := false
            for prev in 0:p {
                if out_idx[prev] == i {
                    used = true
                    <-
                }
            }
            if !used {
                v := x[i]
                if best_i < 0 || v > best_v {
                    best_i = i
                    best_v = v
                }
            }
        }
        out_idx[p] = best_i
        out_val[p] = best_v
    }
    << limit
}

pub fn moe_router_f32(logits &[]f32, n_experts int, top_k int, use_sigmoid bool, norm_topk bool,
                      scale f64, bias &[]f32, out_idx $&[]int, out_w $&[]f32) int {
    if n_experts <= 0 || logits.len < n_experts { << 0 }
    $probs := []f32{}
    $scores := []f32{}
    probs.reserve(n_experts)
    scores.reserve(n_experts)
    has_bias := bias.len >= n_experts
    if use_sigmoid {
        for e in 0:n_experts {
            v := f64(logits[e])
            $p := 0.0
            if v >= 0.0 {
                p = 1.0 / (1.0 + math.exp(-v))
            } else {
                ev := math.exp(v)
                p = ev / (1.0 + ev)
            }
            pf := f32(p)
            probs.push(pf)
            if has_bias {
                scores.push(pf + bias[e])
            } else {
                scores.push(pf)
            }
        }
    } else {
        $max_l := logits[0]
        for e in 1:n_experts {
            if logits[e] > max_l { max_l = logits[e] }
        }
        $sum_e := 0.0
        for e in 0:n_experts {
            ev := math.exp(f64(logits[e] - max_l))
            probs.push(f32(ev))
            sum_e += ev
        }
        inv_s := 1.0 / sum_e
        for e in 0:n_experts {
            pf := f32(f64(probs[e]) * inv_s)
            probs[e] = pf
            if has_bias {
                scores.push(pf + bias[e])
            } else {
                scores.push(pf)
            }
        }
    }
    actual := topk_f32(&scores, n_experts, top_k, out_idx, out_w)
    if actual <= 0 { << 0 }
    $wsum := 0.0
    for j in 0:actual {
        pw := probs[out_idx[j]]
        out_w[j] = pw
        wsum += f64(pw)
    }
    $eff_scale := scale
    if eff_scale <= 0.0 { eff_scale = 1.0 }
    if norm_topk && wsum > 0.0 {
        inv_w := eff_scale / wsum
        for j in 0:actual {
            out_w[j] = f32(f64(out_w[j]) * inv_w)
        }
    } else if eff_scale != 1.0 {
        for j in 0:actual {
            out_w[j] = f32(f64(out_w[j]) * eff_scale)
        }
    }
    << actual
}

pub fn rope_yarn_f32(vec $&[]f32, n_heads int, head_dim int, rope_dim int, interleaved bool,
                     pos int, theta f64, scale f64, orig_ctx int, beta_fast f64, beta_slow f64,
                     attn_factor f64) {
    $rdim := rope_dim
    if rdim <= 0 || rdim > head_dim { rdim = head_dim }
    if n_heads <= 0 || head_dim <= 0 || (rdim % 2) != 0 || theta <= 0.0 { << }
    $eff_scale := scale
    if eff_scale <= 0.0 { eff_scale = 1.0 }
    half := rdim / 2
    log_theta := math.log(theta)
    two_pi := 6.283185307179586
    use_ntk := eff_scale > 1.0 && orig_ctx > 0 && beta_fast > 0.0 && beta_slow > 0.0
    $low := 0.0
    $high := f64(half - 1)
    if use_ntk {
        low = (f64(rdim) * math.log(f64(orig_ctx) / (beta_fast * two_pi))) / (2.0 * log_theta)
        high = (f64(rdim) * math.log(f64(orig_ctx) / (beta_slow * two_pi))) / (2.0 * log_theta)
        if low < 0.0 { low = 0.0 }
        if high > f64(half - 1) { high = f64(half - 1) }
        if high <= low { high = low + 0.001 }
    }
    $mscale := attn_factor
    if mscale <= 0.0 {
        if eff_scale > 1.0 {
            mscale = 0.1 * math.log(eff_scale) + 1.0
        } else {
            mscale = 1.0
        }
    }
    for j in 0:half {
        base_freq := math.exp(-log_theta * (f64(2 * j) / f64(rdim)))
        $freq := base_freq / eff_scale
        if use_ntk {
            $ramp := (f64(j) - low) / (high - low)
            if ramp < 0.0 { ramp = 0.0 }
            if ramp > 1.0 { ramp = 1.0 }
            gamma := 1.0 - ramp
            freq = (1.0 - gamma) * (base_freq / eff_scale) + gamma * base_freq
        }
        angle := f64(pos) * freq
        c := f32(math.cos(angle) * mscale)
        s := f32(math.sin(angle) * mscale)
        for h in 0:n_heads {
            h_off := h * head_dim
            if interleaved {
                i0 := h_off + 2 * j
                v0 := vec[i0]
                v1 := vec[i0 + 1]
                vec[i0] = f32(v0 * c - v1 * s)
                vec[i0 + 1] = f32(v0 * s + v1 * c)
            } else {
                i0 := h_off + j
                i1 := h_off + half + j
                v0 := vec[i0]
                v1 := vec[i1]
                vec[i0] = f32(v0 * c - v1 * s)
                vec[i1] = f32(v0 * s + v1 * c)
            }
        }
    }
}

pub fn topk_cosine_f32(query &[]f32, corpus &[]f32, n_docs int, dim int, k int,
                       out_idx $&[]int, out_score $&[]f32) int {
    if n_docs <= 0 || dim <= 0 || query.len < dim || corpus.len < n_docs * dim { << 0 }
    $qa := 0.0
    for i in 0:dim {
        qv := f64(query[i])
        qa += qv * qv
    }
    $scores := []f32{}
    scores.reserve(n_docs)
    for d in 0:n_docs {
        base := d * dim
        $dot := 0.0
        $da := 0.0
        for i in 0:dim {
            qv := f64(query[i])
            dv := f64(corpus[base + i])
            dot += qv * dv
            da += dv * dv
        }
        denom := math.sqrt(qa * da)
        if denom > 0.0 {
            scores.push(f32(dot / denom))
        } else {
            scores.push(f32(0))
        }
    }
    << topk_f32(&scores, n_docs, k, out_idx, out_score)
}

pub fn cross_entropy_grad_f32(dlogits $&[]f32, logits &[]f32, target int, n int) f32 {
    if n <= 0 || target < 0 || target >= n { << f32(0) }
    $mx := f64(logits[0])
    for i in 1:n {
        v := f64(logits[i])
        if v > mx { mx = v }
    }
    $sum_exp := 0.0
    for i in 0:n {
        sum_exp += math.exp(f64(logits[i]) - mx)
    }
    log_z := mx + math.log(sum_exp)
    for i in 0:n {
        $p := math.exp(f64(logits[i]) - log_z)
        if i == target { p -= 1.0 }
        dlogits[i] = f32(p)
    }
    << f32(log_z - f64(logits[target]))
}

pub fn adamw_step_f32(param $&[]f32, grad &[]f32, m $&[]f32, v $&[]f32, n int,
                      lr f32, beta1 f32, beta2 f32, eps f32, weight_decay f32, step int) {
    if n <= 0 || step <= 0 { << }
    b1 := f64(beta1)
    b2 := f64(beta2)
    $b1p := 1.0
    $b2p := 1.0
    for _ in 0:step {
        b1p *= b1
        b2p *= b2
    }
    bc1 := 1.0 - b1p
    bc2 := 1.0 - b2p
    lr64 := f64(lr)
    eps64 := f64(eps)
    wd64 := f64(weight_decay)
    for i in 0:n {
        g := f64(grad[i])
        mi := b1 * f64(m[i]) + (1.0 - b1) * g
        vi := b2 * f64(v[i]) + (1.0 - b2) * g * g
        m[i] = f32(mi)
        v[i] = f32(vi)
        m_hat := mi / bc1
        v_hat := vi / bc2
        p := f64(param[i]) * (1.0 - lr64 * wd64) - lr64 * m_hat / (math.sqrt(v_hat) + eps64)
        param[i] = f32(p)
    }
}

pub fn lora_add_f32(out $&[]f32, x &[]f32, a &[]f32, b &[]f32,
                    rows int, cols int, rank int, scale f32) {
    if rows <= 0 || cols <= 0 || rank <= 0 { << }
    $h := []f64{}
    h.reserve(rank)
    for k in 0:rank {
        base := k * cols
        $acc := 0.0
        for c in 0:cols {
            acc += f64(a[base + c]) * f64(x[c])
        }
        h.push(acc)
    }
    sc := f64(scale)
    for r in 0:rows {
        base := r * rank
        $acc := 0.0
        for k in 0:rank {
            acc += f64(b[base + k]) * h[k]
        }
        out[r] = f32(f64(out[r]) + sc * acc)
    }
}

pub fn lora_backward_f32(dx $&[]f32, da $&[]f32, db $&[]f32,
                         dy &[]f32, x &[]f32, a &[]f32, b &[]f32,
                         out_dim int, in_dim int, rank int, scale f64) {
    if out_dim <= 0 || in_dim <= 0 || rank <= 0 { << }
    if dy.len < out_dim || x.len < in_dim || a.len < rank * in_dim || b.len < out_dim * rank { << }
    $h := []f64{}
    $dh := []f64{}
    h.reserve(rank)
    dh.reserve(rank)
    for r in 0:rank {
        a_base := r * in_dim
        $hacc := 0.0
        for j in 0:in_dim {
            hacc += f64(a[a_base + j]) * f64(x[j])
        }
        h.push(hacc)
        $bacc := 0.0
        for i in 0:out_dim {
            bacc += f64(b[i * rank + r]) * f64(dy[i])
        }
        dh.push(scale * bacc)
    }
    if db.len >= out_dim * rank {
        for i in 0:out_dim {
            d_i := scale * f64(dy[i])
            b_base := i * rank
            for r in 0:rank {
                db[b_base + r] = f32(f64(db[b_base + r]) + d_i * h[r])
            }
        }
    }
    if da.len >= rank * in_dim {
        for r in 0:rank {
            dh_r := dh[r]
            a_base := r * in_dim
            for j in 0:in_dim {
                da[a_base + j] = f32(f64(da[a_base + j]) + dh_r * f64(x[j]))
            }
        }
    }
    if dx.len >= in_dim {
        for j in 0:in_dim {
            $xacc := 0.0
            for r in 0:rank {
                xacc += f64(a[r * in_dim + j]) * dh[r]
            }
            dx[j] = f32(f64(dx[j]) + xacc)
        }
    }
}

pub fn rmsnorm_backward_f32(dx $&[]f32, dw $&[]f32,
                            dy &[]f32, x &[]f32, w &[]f32, n int, eps f64) {
    if n <= 0 || dy.len < n || x.len < n || w.len < n { << }
    $sq := 0.0
    $dot_yw_x := 0.0
    for i in 0:n {
        xi := f64(x[i])
        sq += xi * xi
        dot_yw_x += (f64(dy[i]) * f64(w[i])) * xi
    }
    inv_rms := 1.0 / math.sqrt(sq / f64(n) + eps)
    coeff := dot_yw_x * inv_rms * inv_rms * inv_rms / f64(n)
    has_dx := dx.len >= n
    has_dw := dw.len >= n
    for i in 0:n {
        xi := f64(x[i])
        dyi := f64(dy[i])
        if has_dx {
            dx[i] = f32(dyi * f64(w[i]) * inv_rms - xi * coeff)
        }
        if has_dw {
            dw[i] = f32(f64(dw[i]) + dyi * xi * inv_rms)
        }
    }
}

pub fn swiglu_backward_f32(dgate $&[]f32, dup $&[]f32,
                           dy &[]f32, gate &[]f32, up &[]f32, n int) {
    if n <= 0 || dy.len < n || gate.len < n || up.len < n { << }
    has_dg := dgate.len >= n
    has_du := dup.len >= n
    for i in 0:n {
        g := f64(gate[i])
        u := f64(up[i])
        dyi := f64(dy[i])
        $sig := 0.0
        if g >= 0.0 {
            sig = 1.0 / (1.0 + math.exp(-g))
        } else {
            eg := math.exp(g)
            sig = eg / (1.0 + eg)
        }
        if has_du {
            dup[i] = f32(dyi * (g * sig))
        }
        if has_dg {
            dgate[i] = f32(dyi * u * sig * (1.0 + g * (1.0 - sig)))
        }
    }
}

pub fn layernorm_backward_f32(dx $&[]f32, dw $&[]f32, db $&[]f32,
                              dy &[]f32, x &[]f32, weight &[]f32, n int, eps f64) {
    if n <= 0 || dy.len < n || x.len < n || weight.len < n { << }
    $sum := 0.0
    for i in 0:n {
        sum += f64(x[i])
    }
    mean := sum / f64(n)
    $vsum := 0.0
    for i in 0:n {
        diff := f64(x[i]) - mean
        vsum += diff * diff
    }
    inv := 1.0 / math.sqrt(vsum / f64(n) + eps)
    $s1 := 0.0
    $s2 := 0.0
    for i in 0:n {
        dyw := f64(dy[i]) * f64(weight[i])
        xh := (f64(x[i]) - mean) * inv
        s1 += dyw
        s2 += dyw * xh
    }
    has_dx := dx.len >= n
    has_dw := dw.len >= n
    has_db := db.len >= n
    inv_n := inv / f64(n)
    fn_val := f64(n)
    for i in 0:n {
        dyi := f64(dy[i])
        xh := (f64(x[i]) - mean) * inv
        if has_dw {
            dw[i] = f32(f64(dw[i]) + dyi * xh)
        }
        if has_db {
            db[i] = f32(f64(db[i]) + dyi)
        }
        if has_dx {
            dx[i] = f32(inv_n * (fn_val * dyi * f64(weight[i]) - s1 - xh * s2))
        }
    }
}

pub fn softmax_backward_f32(dx $&[]f32, dy &[]f32, probs &[]f32, n int) {
    if n <= 0 || dx.len < n || dy.len < n || probs.len < n { << }
    $dot := 0.0
    for i in 0:n {
        dot += f64(probs[i]) * f64(dy[i])
    }
    for i in 0:n {
        dx[i] = f32(f64(probs[i]) * (f64(dy[i]) - dot))
    }
}

pub fn grad_clip_norm_f32(grad $&[]f32, n int, max_norm f32) f32 {
    if n <= 0 || grad.len < n { << f32(0) }
    $sq := 0.0
    for i in 0:n {
        v := f64(grad[i])
        sq += v * v
    }
    norm := math.sqrt(sq)
    mn := f64(max_norm)
    if mn > 0.0 && norm > mn {
        scale := mn / norm
        for i in 0:n {
            grad[i] = f32(f64(grad[i]) * scale)
        }
    }
    << f32(norm)
}

pub fn kl_div_grad_f32(grad_student $&[]f32, student_logits &[]f32,
                       teacher_logits &[]f32, n int, temperature f32) f32 {
    if n <= 0 || grad_student.len < n || student_logits.len < n || teacher_logits.len < n {
        << f32(0)
    }
    $t := f64(temperature)
    if t <= 0.0 { t = 1.0 }

    $mx_s := f64(student_logits[0]) / t
    $mx_t := f64(teacher_logits[0]) / t
    for i in 1:n {
        vs := f64(student_logits[i]) / t
        vt := f64(teacher_logits[i]) / t
        if vs > mx_s { mx_s = vs }
        if vt > mx_t { mx_t = vt }
    }

    $sum_s := 0.0
    $sum_t := 0.0
    for i in 0:n {
        sum_s += math.exp(f64(student_logits[i]) / t - mx_s)
        sum_t += math.exp(f64(teacher_logits[i]) / t - mx_t)
    }
    lse_s := mx_s + math.log(sum_s)
    lse_t := mx_t + math.log(sum_t)

    $kl := 0.0
    for i in 0:n {
        log_ps := f64(student_logits[i]) / t - lse_s
        log_pt := f64(teacher_logits[i]) / t - lse_t
        ps := math.exp(log_ps)
        pt := math.exp(log_pt)
        kl += pt * (log_pt - log_ps)
        grad_student[i] = f32((ps - pt) * t)
    }
    << f32(kl)
}

pub fn dpo_loss_grad_f32(pi_chosen_logp f32, pi_rejected_logp f32,
                         ref_chosen_logp f32, ref_rejected_logp f32,
                         beta f32, out_grad $&[]f32) f32 {
    b := f64(beta)
    margin := (f64(pi_chosen_logp) - f64(ref_chosen_logp)) - (f64(pi_rejected_logp) - f64(ref_rejected_logp))
    h := b * margin
    $loss := 0.0
    $sig_neg_h := 0.0
    if h >= 0.0 {
        e := math.exp(-h)
        loss = math.log(1.0 + e)
        sig_neg_h = e / (1.0 + e)
    } else {
        e := math.exp(h)
        loss = -h + math.log(1.0 + e)
        sig_neg_h = 1.0 / (1.0 + e)
    }
    if out_grad.len >= 2 {
        out_grad[0] = f32(-b * sig_neg_h)
        out_grad[1] = f32(b * sig_neg_h)
    }
    << f32(loss)
}

pub fn grpo_advantages_f32(out_adv $&[]f32, rewards &[]f32, n int, eps f32) {
    if n <= 0 || out_adv.len < n || rewards.len < n { << }
    $sum := 0.0
    for i in 0:n {
        sum += f64(rewards[i])
    }
    mean := sum / f64(n)
    $vsum := 0.0
    for i in 0:n {
        d := f64(rewards[i]) - mean
        vsum += d * d
    }
    inv_std := 1.0 / math.sqrt(vsum / f64(n) + f64(eps))
    for i in 0:n {
        out_adv[i] = f32((f64(rewards[i]) - mean) * inv_std)
    }
}

pub fn conv1d_causal_step_f32(out $&[]f32, state $&[]f32, x &[]f32,
                                weight &[]f32, bias &[]f32, d_inner int, k_size int) {
    if d_inner <= 0 || k_size <= 0 || out.len < d_inner || x.len < d_inner || weight.len < d_inner * k_size {
        <<
    }
    if k_size > 1 && state.len < d_inner * (k_size - 1) { << }
    has_bias := bias.len >= d_inner
    for d in 0:d_inner {
        $acc := 0.0
        if has_bias { acc = f64(bias[d]) }
        wbase := d * k_size
        if k_size > 1 {
            sbase := d * (k_size - 1)
            for j in 0:(k_size - 1) {
                acc += f64(state[sbase + j]) * f64(weight[wbase + j])
            }
            acc += f64(x[d]) * f64(weight[wbase + k_size - 1])
            for j in 0:(k_size - 2) {
                state[sbase + j] = state[sbase + j + 1]
            }
            state[sbase + k_size - 2] = x[d]
        } else {
            acc += f64(x[d]) * f64(weight[wbase])
        }
        out[d] = f32(acc)
    }
}

pub fn ssm_scan_step_f32(out $&[]f32, state $&[]f32, x &[]f32, dt &[]f32,
                         a_log &[]f32, b_vec &[]f32, c_vec &[]f32, d_skip &[]f32,
                         d_inner int, d_state int) {
    if d_inner <= 0 || d_state <= 0 || out.len < d_inner || state.len < d_inner * d_state ||
       x.len < d_inner || dt.len < d_inner || a_log.len < d_inner * d_state ||
       b_vec.len < d_state || c_vec.len < d_state {
        <<
    }
    has_skip := d_skip.len >= d_inner
    for d in 0:d_inner {
        xv := f64(x[d])
        dtv := f64(dt[d])
        sbase := d * d_state
        $y := 0.0
        for s in 0:d_state {
            da := math.exp(dtv * f64(a_log[sbase + s]))
            h_new := da * f64(state[sbase + s]) + dtv * f64(b_vec[s]) * xv
            state[sbase + s] = f32(h_new)
            y += h_new * f64(c_vec[s])
        }
        if has_skip { y += f64(d_skip[d]) * xv }
        out[d] = f32(y)
    }
}

pub fn linear_attn_step_f32(out $&[]f32, state $&[]f32, z_state $&[]f32,
                            q &[]f32, k &[]f32, v &[]f32,
                            decay f32, n_heads int, head_dim int, eps f32) {
    total_d := n_heads * head_dim
    if n_heads <= 0 || head_dim <= 0 || out.len < total_d ||
       state.len < total_d * head_dim || z_state.len < total_d ||
       q.len < total_d || k.len < total_d || v.len < total_d {
        <<
    }
    dec := f64(decay)
    $ev := f64(eps)
    if ev <= 0.0 { ev = 1e-6 }
    for h in 0:n_heads {
        vbase := h * head_dim
        sbase := h * head_dim * head_dim
        for i in 0:head_dim {
            ki := f64(k[vbase + i])
            z_state[vbase + i] = f32(dec * f64(z_state[vbase + i]) + ki)
            row := sbase + i * head_dim
            for j in 0:head_dim {
                state[row + j] = f32(dec * f64(state[row + j]) + ki * f64(v[vbase + j]))
            }
        }
        $den := 0.0
        for i in 0:head_dim {
            den += f64(q[vbase + i]) * f64(z_state[vbase + i])
        }
        if den >= 0.0 && den < ev { den = ev }
        else if den < 0.0 && -den < ev { den = -ev }
        inv_den := 1.0 / den
        for j in 0:head_dim {
            $num := 0.0
            for i in 0:head_dim {
                num += f64(q[vbase + i]) * f64(state[sbase + i * head_dim + j])
            }
            out[vbase + j] = f32(num * inv_den)
        }
    }
}

pub fn ppo_clip_grad_f32(new_logp f32, old_logp f32, ref_logp f32,
                         advantage f32, clip_eps f32, kl_beta f32, out_grad $&[]f32) f32 {
    adv := f64(advantage)
    $eps := f64(clip_eps)
    if eps <= 0.0 { eps = 0.2 }
    $lr := f64(new_logp) - f64(old_logp)
    if lr > 20.0 { lr = 20.0 } else if lr < -20.0 { lr = -20.0 }
    ratio := math.exp(lr)
    $rc := ratio
    if rc < 1.0 - eps { rc = 1.0 - eps } else if rc > 1.0 + eps { rc = 1.0 + eps }
    s1 := ratio * adv
    s2 := rc * adv
    $surr := s1
    $dsurr := -ratio * adv
    if s2 < s1 {
        surr = s2
        dsurr = 0.0
    }
    beta := f64(kl_beta)
    $dref := f64(ref_logp) - f64(new_logp)
    if dref > 20.0 { dref = 20.0 } else if dref < -20.0 { dref = -20.0 }
    er := math.exp(dref)
    kl := er - dref - 1.0
    dkl := 1.0 - er
    if out_grad.len >= 1 {
        out_grad[0] = f32(dsurr + beta * dkl)
    }
    << f32(-surr + beta * kl)
}

pub fn conv2d_patch_embed_f32(out $&[]f32, img &[]f32, weight &[]f32, bias &[]f32,
                                  in_c int, img_h int, img_w int, out_c int, patch int) {
    if patch <= 0 || in_c <= 0 || out_c <= 0 || img_h < patch || img_w < patch { << }
    gh := img_h / patch
    gw := img_w / patch
    has_bias := bias.len >= out_c
    hw := img_h * img_w
    p2 := patch * patch
    for py in 0:gh {
        for px in 0:gw {
            tok := py * gw + px
            out_base := tok * out_c
            for oc in 0:out_c {
                $acc := 0.0
                if has_bias { acc = f64(bias[oc]) }
                oc_base := oc * in_c * p2
                for ic in 0:in_c {
                    c_base := ic * hw
                    w_base := oc_base + ic * p2
                    for dy in 0:patch {
                        iy := py * patch + dy
                        for dx in 0:patch {
                            ix := px * patch + dx
                            acc += f64(img[c_base + iy * img_w + ix]) * f64(weight[w_base + dy * patch + dx])
                        }
                    }
                }
                out[out_base + oc] = f32(acc)
            }
        }
    }
}

pub fn mha_sdpa_f32(out $&[]f32, q &[]f32, k &[]f32, v &[]f32,
                    seq_q int, seq_k int, n_heads int, head_dim int, causal bool) {
    if seq_q <= 0 || seq_k <= 0 || n_heads <= 0 || head_dim <= 0 { << }
    d_model := n_heads * head_dim
    scale := 1.0 / math.sqrt(f64(head_dim))
    for qi in 0:seq_q {
        $eff_k := seq_k
        if causal && qi + 1 < eff_k { eff_k = qi + 1 }
        for h in 0:n_heads {
            h_off := h * head_dim
            q_base := qi * d_model + h_off
            $mx := -1e300
            for ki in 0:eff_k {
                k_base := ki * d_model + h_off
                $s := 0.0
                for d in 0:head_dim {
                    s += f64(q[q_base + d]) * f64(k[k_base + d])
                }
                sc := s * scale
                if sc > mx { mx = sc }
            }
            $denom := 0.0
            for ki in 0:eff_k {
                k_base := ki * d_model + h_off
                $s := 0.0
                for d in 0:head_dim {
                    s += f64(q[q_base + d]) * f64(k[k_base + d])
                }
                denom += math.exp(s * scale - mx)
            }
            inv_d := 1.0 / denom
            for d in 0:head_dim { out[q_base + d] = f32(0) }
            for ki in 0:eff_k {
                k_base := ki * d_model + h_off
                $s := 0.0
                for d in 0:head_dim {
                    s += f64(q[q_base + d]) * f64(k[k_base + d])
                }
                w := math.exp(s * scale - mx) * inv_d
                for d in 0:head_dim {
                    out[q_base + d] = f32(f64(out[q_base + d]) + w * f64(v[k_base + d]))
                }
            }
        }
    }
}

pub fn avg_pool2d_f32(out $&[]f32, x &[]f32, channels int, h int, w int, kernel int, stride int) {
    if channels <= 0 || kernel <= 0 || stride <= 0 || h < kernel || w < kernel { << }
    oh := (h - kernel) / stride + 1
    ow := (w - kernel) / stride + 1
    inv := 1.0 / f64(kernel * kernel)
    hw := h * w
    ohw := oh * ow
    for c in 0:channels {
        c_in := c * hw
        c_out := c * ohw
        for oy in 0:oh {
            iy0 := oy * stride
            for ox in 0:ow {
                ix0 := ox * stride
                $acc := 0.0
                for ky in 0:kernel {
                    row_off := c_in + (iy0 + ky) * w
                    for kx in 0:kernel {
                        acc += f64(x[row_off + ix0 + kx])
                    }
                }
                out[c_out + oy * ow + ox] = f32(acc * inv)
            }
        }
    }
}
