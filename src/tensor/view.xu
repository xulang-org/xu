@tensor

#errors

const MAX_VIEW_INT = 9223372036854775807

// TensorView describes a dense tensor in caller-owned little-endian storage.
// Offsets are in bytes. Strides are in elements and can be zero for broadcast.
pub struct TensorView {
    kind DType
    shape []int
    strides []int
    start int
    end int
    elements int
    contiguous bool
}

fn copy_indices(input &[]int) []int {
    $out := []int{}
    out.reserve(input.len)
    for value in input { out.push(value) }
    << out
}

fn shape_count(shape &[]int) int {
    $empty := false
    for axis in 0:shape.len {
        if shape[axis] < 0 { >> errors.new("negative tensor dimension") }
        if shape[axis] == 0 { empty = true }
    }
    if empty { << 0 }

    $count := 1
    for dim in shape {
        if dim > 1 {
            if count > MAX_VIEW_INT / dim { >> errors.new("tensor element count overflow") }
            count *= dim
        }
    }
    << count
}

// Create a view over storage_bytes bytes and validate the entire reachable span.
pub fn strided_view(kind DType, shape &[]int, strides &[]int,
                    byte_offset int, storage_bytes int) TensorView {
    if shape.len != strides.len { >> errors.new("tensor shape and stride rank differ") }
    if byte_offset < 0 || byte_offset > storage_bytes { >> errors.new("tensor byte offset outside storage") }

    count := shape_count(shape) or >>
    for stride in strides {
        if stride < 0 { >> errors.new("negative tensor stride") }
    }
    if count == 0 {
        << TensorView{kind: kind, shape: copy_indices(shape), strides: copy_indices(strides),
                      start: byte_offset, end: byte_offset, elements: 0, contiguous: true}
    }

    width := kind.element_bytes()
    remaining := storage_bytes - byte_offset
    if width < 1 || remaining < width { >> errors.new("tensor view exceeds storage") }
    max_index := (remaining - width) / width
    $span := 0
    $row_stride := 1
    $contiguous := true
    $axis := shape.len - 1
    while axis >= 0 {
        extent := shape[axis] - 1
        stride := strides[axis]
        if extent > 0 {
            if stride > (max_index - span) / extent { >> errors.new("tensor view exceeds storage") }
            span += stride * extent
            if stride != row_stride { contiguous = false }
        }
        row_stride *= shape[axis]
        axis -= 1
    }
    << TensorView{kind: kind, shape: copy_indices(shape), strides: copy_indices(strides),
                  start: byte_offset, end: byte_offset + (span + 1) * width,
                  elements: count, contiguous: contiguous}
}

// Create a row-major view. An empty shape is a scalar and a zero axis is empty.
pub fn contiguous_view(kind DType, shape &[]int, byte_offset int, storage_bytes int) TensorView {
    count := shape_count(shape) or >>
    $strides := []int{}
    strides.resize_zero(shape.len)
    if count > 0 {
        $step := 1
        $axis := shape.len - 1
        while axis >= 0 {
            strides[axis] = step
            step *= shape[axis]
            axis -= 1
        }
    }
    << strided_view(kind, shape, &strides, byte_offset, storage_bytes) or >>
}

pub fn (v &TensorView) dtype() DType { << v.kind }
pub fn (v &TensorView) rank() int { << v.shape.len }
pub fn (v &TensorView) element_count() int { << v.elements }
pub fn (v &TensorView) storage_start() int { << v.start }
pub fn (v &TensorView) storage_end() int { << v.end }
pub fn (v &TensorView) is_contiguous() bool { << v.contiguous }

pub fn (v &TensorView) dimension(axis int) int {
    if axis < 0 || axis >= v.shape.len { >> errors.new("tensor axis outside rank") }
    << v.shape[axis]
}

pub fn (v &TensorView) stride(axis int) int {
    if axis < 0 || axis >= v.shape.len { >> errors.new("tensor axis outside rank") }
    << v.strides[axis]
}

// Swap two axes and keep the same caller-owned buffer.
pub fn (v &TensorView) transpose(a int, b int) TensorView {
    if a < 0 || a >= v.shape.len || b < 0 || b >= v.shape.len { >> errors.new("tensor axis outside rank") }
    $shape := copy_indices(&v.shape)
    $strides := copy_indices(&v.strides)
    shape[a] = v.shape[b]
    shape[b] = v.shape[a]
    strides[a] = v.strides[b]
    strides[b] = v.strides[a]
    << strided_view(v.kind, &shape, &strides, v.start, v.end) or >>
}

// Slice one axis over [first, stop) with a positive element step.
pub fn (v &TensorView) slice(axis int, first int, stop int, step int) TensorView {
    length := v.dimension(axis) or >>
    if first < 0 || stop < first || stop > length || step <= 0 { >> errors.new("invalid tensor slice") }
    $shape := copy_indices(&v.shape)
    $strides := copy_indices(&v.strides)
    $offset := v.start
    shape[axis] = 0
    if stop > first { shape[axis] = 1 + (stop - first - 1) / step }
    stride := v.strides[axis]
    if step > 1 && stride > MAX_VIEW_INT / step { >> errors.new("tensor slice stride overflow") }
    strides[axis] = stride * step
    if v.elements > 0 && shape[axis] > 0 {
        offset += first * stride * v.kind.element_bytes()
    }
    << strided_view(v.kind, &shape, &strides, offset, v.end) or >>
}

pub fn (v &TensorView) byte_offset(indices &[]int) int {
    if v.elements == 0 { >> errors.new("tensor view is empty") }
    if indices.len != v.shape.len { >> errors.new("tensor index rank mismatch") }
    $index := 0
    for axis in 0:v.shape.len {
        coord := indices[axis]
        if coord < 0 || coord >= v.shape[axis] { >> errors.new("tensor index outside shape") }
        index += coord * v.strides[axis]
    }
    << v.start + index * v.kind.element_bytes()
}

fn (v &TensorView) element_offset(linear int) int {
    if v.contiguous { << linear }
    $position := linear
    $index := 0
    $axis := v.shape.len - 1
    while axis >= 0 {
        dim := v.shape[axis]
        if dim > 1 {
            index += (position % dim) * v.strides[axis]
            position /= dim
        }
        axis -= 1
    }
    << index
}

// Read one scalar without copying or taking ownership of the storage.
pub fn (v &TensorView) read_f32(storage &string, indices &[]int) f32 {
    if storage.len < v.end { >> errors.new("tensor backing storage is too short") }
    offset := v.byte_offset(indices) or >>
    << v.kind.decode_bits(scalar_bits_le(storage, offset, v.kind.element_bytes()))
}

// Read by logical row-major index, including transposed and stepped views.
pub fn (v &TensorView) read_f32_linear(storage &string, linear int) f32 {
    if linear < 0 || linear >= v.elements { >> errors.new("tensor linear index outside shape") }
    if storage.len < v.end { >> errors.new("tensor backing storage is too short") }
    width := v.kind.element_bytes()
    offset := v.start + v.element_offset(linear) * width
    << v.kind.decode_bits(scalar_bits_le(storage, offset, width))
}

// Append decoded values in logical row-major order after validating storage.
pub fn (v &TensorView) append_f32(storage &string, out $&[]f32) int {
    if storage.len < v.end { >> errors.new("tensor backing storage is too short") }
    width := v.kind.element_bytes()
    for linear in 0:v.elements {
        offset := v.start + v.element_offset(linear) * width
        out.push(v.kind.decode_bits(scalar_bits_le(storage, offset, width)))
    }
    << v.elements
}

// Decode a logical range into an existing output buffer.
pub fn (v &TensorView) copy_f32(storage &string, first int, count int, out $&[]f32, output_offset int) int {
    if first < 0 || first > v.elements || count < 0 || count > v.elements - first {
        >> errors.new("tensor copy outside shape")
    }
    if output_offset < 0 || output_offset > out.len || count > out.len - output_offset {
        >> errors.new("tensor copy outside output")
    }
    if storage.len < v.end { >> errors.new("tensor backing storage is too short") }
    width := v.kind.element_bytes()
    for i in 0:count {
        offset := v.start + v.element_offset(first + i) * width
        out[output_offset + i] = v.kind.decode_bits(scalar_bits_le(storage, offset, width))
    }
    << count
}
