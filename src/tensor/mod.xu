@tensor

#errors

// Dense scalar encodings with little-endian storage.
pub struct DType { tag int }

const F32_TAG = 0
const F16_TAG = 1
const BF16_TAG = 2
const E4M3FN_TAG = 3
const E5M2_TAG = 4
const E4M3FNUZ_TAG = 5
const E5M2FNUZ_TAG = 6

pub fn dtype_f32() DType { << DType{tag: F32_TAG} }
pub fn dtype_f16() DType { << DType{tag: F16_TAG} }
pub fn dtype_bf16() DType { << DType{tag: BF16_TAG} }
pub fn dtype_fp8_e4m3fn() DType { << DType{tag: E4M3FN_TAG} }
pub fn dtype_fp8_e5m2() DType { << DType{tag: E5M2_TAG} }
pub fn dtype_fp8_e4m3fnuz() DType { << DType{tag: E4M3FNUZ_TAG} }
pub fn dtype_fp8_e5m2fnuz() DType { << DType{tag: E5M2FNUZ_TAG} }

pub fn (dtype DType) is_f32() bool { << dtype.tag == F32_TAG }

pub fn (dtype DType) element_bytes() int {
    if dtype.tag == F32_TAG { << 4 }
    if dtype.tag == F16_TAG || dtype.tag == BF16_TAG { << 2 }
    << 1
}

// Decode scalar bits to f32. Unused upper bits are ignored.
pub fn (dtype DType) decode_bits(raw int) f32 {
    if dtype.tag == F32_TAG { << as_f32_bits(raw) }
    if dtype.tag == F16_TAG {
        value := F16{bits: u16(raw)}
        << value.to_f32()
    }
    if dtype.tag == BF16_TAG {
        value := BF16{bits: u16(raw)}
        << value.to_f32()
    }
    if dtype.tag == E4M3FN_TAG {
        value := Fp8E4M3Fn{bits: u8(raw)}
        << value.to_f32()
    }
    if dtype.tag == E5M2_TAG {
        value := Fp8E5M2{bits: u8(raw)}
        << value.to_f32()
    }
    if dtype.tag == E4M3FNUZ_TAG {
        value := Fp8E4M3Fnuz{bits: u8(raw)}
        << value.to_f32()
    }
    value := Fp8E5M2Fnuz{bits: u8(raw)}
    << value.to_f32()
}

// Encode a compute value to the scalar's storage bits.
pub fn (dtype DType) encode_bits(value f32) int {
    if dtype.tag == F32_TAG { << from_f32_bits(value) }
    if dtype.tag == F16_TAG { << int(f16(value).bits) }
    if dtype.tag == BF16_TAG { << int(bf16(value).bits) }
    if dtype.tag == E4M3FN_TAG { << int(fp8_e4m3fn(value).bits) }
    if dtype.tag == E5M2_TAG { << int(fp8_e5m2(value).bits) }
    if dtype.tag == E4M3FNUZ_TAG { << int(fp8_e4m3fnuz(value).bits) }
    << int(fp8_e5m2fnuz(value).bits)
}

pub fn safetensors_dtype(name &string) DType {
    if *name == "F32" { << dtype_f32() }
    if *name == "F16" { << dtype_f16() }
    if *name == "BF16" { << dtype_bf16() }
    if *name == "F8_E4M3" { << dtype_fp8_e4m3fn() }
    if *name == "F8_E5M2" { << dtype_fp8_e5m2() }
    if *name == "F8_E4M3FNUZ" { << dtype_fp8_e4m3fnuz() }
    if *name == "F8_E5M2FNUZ" { << dtype_fp8_e5m2fnuz() }
    >> errors.new("unsupported Safetensors dtype: " + (*name))
}

// Parse the short names used to select an in-memory tensor encoding.
pub fn dtype_named(name &string) DType {
    if *name == "f32" { << dtype_f32() }
    if *name == "f16" { << dtype_f16() }
    if *name == "bf16" { << dtype_bf16() }
    if *name == "fp8_e4m3fn" { << dtype_fp8_e4m3fn() }
    if *name == "fp8_e5m2" { << dtype_fp8_e5m2() }
    if *name == "fp8_e4m3fnuz" { << dtype_fp8_e4m3fnuz() }
    if *name == "fp8_e5m2fnuz" { << dtype_fp8_e5m2fnuz() }
    >> errors.new("unsupported tensor dtype: " + (*name))
}

fn scalar_bits_le(storage &string, at int, width int) int {
    $raw := 0
    for i in 0:width {
        raw = raw | ((storage[at + i] & 255) << (8 * i))
    }
    << raw
}
