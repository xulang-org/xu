@tensor

#math

// Fixed-width storage scalars. Raw bits are exposed for lossless serialization.
pub struct F16 { pub bits u16 }
pub struct BF16 { pub bits u16 }
pub struct Fp8E4M3Fn { pub bits u8 }
pub struct Fp8E5M2 { pub bits u8 }
pub struct Fp8E4M3Fnuz { pub bits u8 }
pub struct Fp8E5M2Fnuz { pub bits u8 }

struct NarrowFloat {
    sign_bit int
    fraction_bits int
    bias int
    largest int
    infinity int
    nan int
    unsigned_zero bool
}

fn binary16_format() NarrowFloat {
    << NarrowFloat{sign_bit: 15, fraction_bits: 10, bias: 15, largest: 0x7bff,
                   infinity: 0x7c00, nan: 0x7e00, unsigned_zero: false}
}

fn e4m3_format(fnuz bool) NarrowFloat {
    if fnuz {
        << NarrowFloat{sign_bit: 7, fraction_bits: 3, bias: 8, largest: 0x7f,
                       infinity: 0, nan: 0x80, unsigned_zero: true}
    }
    << NarrowFloat{sign_bit: 7, fraction_bits: 3, bias: 7, largest: 0x7e,
                   infinity: 0, nan: 0x7f, unsigned_zero: false}
}

fn e5m2_format(fnuz bool) NarrowFloat {
    if fnuz {
        << NarrowFloat{sign_bit: 7, fraction_bits: 2, bias: 16, largest: 0x7f,
                       infinity: 0, nan: 0x80, unsigned_zero: true}
    }
    << NarrowFloat{sign_bit: 7, fraction_bits: 2, bias: 15, largest: 0x7b,
                   infinity: 0x7c, nan: 0x7e, unsigned_zero: false}
}

// Round a positive binary32 significand. All nonzero shifts fit in a Xu int.
fn round_even(significand int, shift int) int {
    if shift > 24 { << 0 }
    whole := significand >> shift
    half := 1 << (shift - 1)
    rest := significand & ((1 << shift) - 1)
    if rest > half || (rest == half && (whole & 1) != 0) { << whole + 1 }
    << whole
}

fn from_f32_bits(value f32) int {
    << math.float32_bits(f64(value))
}

fn as_f32_bits(bits int) f32 {
    << f32(math.float32_from_bits(bits))
}

fn encode_narrow(value f32, fmt &NarrowFloat, saturate bool) int {
    bits := from_f32_bits(value)
    sign := ((bits >> 31) & 1) << fmt.sign_bit
    fraction := bits & 0x7fffff
    exponent := (bits >> 23) & 255
    if exponent == 255 {
        if fraction != 0 {
            if fmt.unsigned_zero { << fmt.nan }
            << sign | fmt.nan
        }
        if fmt.infinity != 0 { << sign | fmt.infinity }
        << sign | fmt.largest
    }
    if exponent == 0 {
        if fmt.unsigned_zero { << 0 }
        << sign
    }
    significand := 0x800000 | fraction
    encoded_exponent := exponent - 127 + fmt.bias
    precision_shift := 23 - fmt.fraction_bits
    $magnitude := 0
    if encoded_exponent <= 0 {
        magnitude = round_even(significand, precision_shift + 1 - encoded_exponent)
    } else {
        magnitude = (encoded_exponent << fmt.fraction_bits) +
            round_even(significand, precision_shift) - (1 << fmt.fraction_bits)
    }
    if magnitude > fmt.largest {
        if !saturate && fmt.infinity != 0 { << sign | fmt.infinity }
        magnitude = fmt.largest
    }
    if magnitude == 0 && fmt.unsigned_zero { << 0 }
    << sign | magnitude
}

fn decode_fp8(raw int, fmt &NarrowFloat) f32 {
    sign := (raw & 0x80) << 24
    magnitude := raw & 0x7f
    if fmt.unsigned_zero && raw == fmt.nan { << as_f32_bits(0x7fc00000) }
    if magnitude > fmt.largest {
        if magnitude == fmt.infinity { << as_f32_bits(sign | 0x7f800000) }
        << as_f32_bits(sign | 0x7fc00000)
    }
    exponent := magnitude >> fmt.fraction_bits
    hidden := 1 << fmt.fraction_bits
    $fraction := magnitude & (hidden - 1)
    $unbiased := exponent - fmt.bias
    if exponent == 0 {
        if fraction == 0 { << as_f32_bits(sign) }
        unbiased = 1 - fmt.bias
        while fraction < hidden {
            fraction = fraction << 1
            unbiased -= 1
        }
        fraction -= hidden
    }
    << as_f32_bits(sign | ((unbiased + 127) << 23) | (fraction << (23 - fmt.fraction_bits)))
}

// Convert to IEEE binary16, rounding to nearest with ties to even.
pub fn f16(value f32) F16 {
    fmt := binary16_format()
    << F16{bits: u16(encode_narrow(value, &fmt, false))}
}

pub fn (x &F16) to_f32() f32 { << math.float16_to_f32(int(x.bits)) }

// Convert to bfloat16, rounding to nearest with ties to even and quieting NaNs.
pub fn bf16(value f32) BF16 {
    bits := from_f32_bits(value)
    high := bits >> 16
    if (bits & 0x7fffffff) > 0x7f800000 { << BF16{bits: u16(high | 0x40)} }
    << BF16{bits: u16((bits + 0x7fff + (high & 1)) >> 16)}
}

pub fn (x &BF16) to_f32() f32 { << as_f32_bits(int(x.bits) << 16) }

// FP8 constructors saturate finite overflow and round ties to even.
// Formats with infinity preserve it. FNUZ formats use an unsigned zero.
pub fn fp8_e4m3fn(value f32) Fp8E4M3Fn {
    fmt := e4m3_format(false)
    << Fp8E4M3Fn{bits: u8(encode_narrow(value, &fmt, true))}
}

pub fn fp8_e5m2(value f32) Fp8E5M2 {
    fmt := e5m2_format(false)
    << Fp8E5M2{bits: u8(encode_narrow(value, &fmt, true))}
}

pub fn fp8_e4m3fnuz(value f32) Fp8E4M3Fnuz {
    fmt := e4m3_format(true)
    << Fp8E4M3Fnuz{bits: u8(encode_narrow(value, &fmt, true))}
}

pub fn fp8_e5m2fnuz(value f32) Fp8E5M2Fnuz {
    fmt := e5m2_format(true)
    << Fp8E5M2Fnuz{bits: u8(encode_narrow(value, &fmt, true))}
}

pub fn (x &Fp8E4M3Fn) to_f32() f32 {
    fmt := e4m3_format(false)
    << decode_fp8(int(x.bits), &fmt)
}

pub fn (x &Fp8E5M2) to_f32() f32 {
    fmt := e5m2_format(false)
    << decode_fp8(int(x.bits), &fmt)
}

pub fn (x &Fp8E4M3Fnuz) to_f32() f32 {
    fmt := e4m3_format(true)
    << decode_fp8(int(x.bits), &fmt)
}

pub fn (x &Fp8E5M2Fnuz) to_f32() f32 {
    fmt := e5m2_format(true)
    << decode_fp8(int(x.bits), &fmt)
}
