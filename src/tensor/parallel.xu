@tensor

#ffi
#math

// Raw-pointer SIMD entry points lowered directly to ARM64 NEON / x86-64 SSE/SSSE3
// microkernels in xu/mir/lower_tensor_quant.xu, plus no-poll row-slice loops so
// multi-OS-thread workers never touch heap allocations, slices, or coroutine polls.

pub unsafe fn raw_dot_q4_k_q8_k_f32(src c_ptr, qs c_ptr, d c_ptr, bs c_ptr, nb int) f32 {
    if nb <= 0 { << f32(0) }
    $total := f32(0)
    for b in 0:nb {
        off := b * Q4_K_BYTES
        dv := math.float16_to_f32(int(ffi.read_u16(src, off)))
        dmv := math.float16_to_f32(int(ffi.read_u16(src, off + 2)))
        sc_off := off + 4
        qs_base := off + 16
        xb := b * QK_K
        $sum_q := 0
        $sum_m := 0
        for chunk in 0:4 {
            is0 := chunk * 2
            is1 := is0 + 1
            $sc1 := 0
            $m1 := 0
            $sc2 := 0
            $m2 := 0
            if chunk < 2 {
                sc1 = int(ffi.read_u8(src, sc_off + is0)) & 63
                m1 = int(ffi.read_u8(src, sc_off + is0 + 4)) & 63
                sc2 = int(ffi.read_u8(src, sc_off + is1)) & 63
                m2 = int(ffi.read_u8(src, sc_off + is1 + 4)) & 63
            } else {
                sc1 = (int(ffi.read_u8(src, sc_off + is0 + 4)) & 15) | (((int(ffi.read_u8(src, sc_off + is0 - 4)) >> 6) & 3) << 4)
                m1 = ((int(ffi.read_u8(src, sc_off + is0 + 4)) >> 4) & 15) | (((int(ffi.read_u8(src, sc_off + is0)) >> 6) & 3) << 4)
                sc2 = (int(ffi.read_u8(src, sc_off + is1 + 4)) & 15) | (((int(ffi.read_u8(src, sc_off + is1 - 4)) >> 6) & 3) << 4)
                m2 = ((int(ffi.read_u8(src, sc_off + is1 + 4)) >> 4) & 15) | (((int(ffi.read_u8(src, sc_off + is1)) >> 6) & 3) << 4)
            }
            bs0 := (b * 16 + chunk * 4) * 8
            sum_m += m1 * (ffi.read_i64(bs, bs0) + ffi.read_i64(bs, bs0 + 8)) +
                     m2 * (ffi.read_i64(bs, bs0 + 16) + ffi.read_i64(bs, bs0 + 24))
            q_off := qs_base + chunk * 32
            x_lo := xb + chunk * 64
            x_hi := x_lo + 32
            $iq_lo := 0
            $iq_hi := 0
            for l in 0:32 {
                qb := int(ffi.read_u8(src, q_off + l)) & 255
                iq_lo += (qb & 15) * int(ffi.read_i8(qs, x_lo + l))
                iq_hi += ((qb >> 4) & 15) * int(ffi.read_i8(qs, x_hi + l))
            }
            sum_q += sc1 * iq_lo + sc2 * iq_hi
        }
        total += ffi.read_f32(d, b * 4) * (dv * f32(sum_q) - dmv * f32(sum_m))
    }
    << total
}

pub unsafe fn raw_dot_q5_k_q8_k_f32(src c_ptr, qs c_ptr, d c_ptr, bs c_ptr, nb int) f32 {
    if nb <= 0 { << f32(0) }
    $total := f32(0)
    for b in 0:nb {
        off := b * Q5_K_BYTES
        dv := math.float16_to_f32(int(ffi.read_u16(src, off)))
        dmv := math.float16_to_f32(int(ffi.read_u16(src, off + 2)))
        sc_off := off + 4
        qh_base := off + 16
        qs_base := off + 48
        xb := b * QK_K
        $sum_q := 0
        $sum_m := 0
        for chunk in 0:4 {
            is0 := chunk * 2
            is1 := is0 + 1
            $sc1 := 0
            $m1 := 0
            $sc2 := 0
            $m2 := 0
            if chunk < 2 {
                sc1 = int(ffi.read_u8(src, sc_off + is0)) & 63
                m1 = int(ffi.read_u8(src, sc_off + is0 + 4)) & 63
                sc2 = int(ffi.read_u8(src, sc_off + is1)) & 63
                m2 = int(ffi.read_u8(src, sc_off + is1 + 4)) & 63
            } else {
                sc1 = (int(ffi.read_u8(src, sc_off + is0 + 4)) & 15) | (((int(ffi.read_u8(src, sc_off + is0 - 4)) >> 6) & 3) << 4)
                m1 = ((int(ffi.read_u8(src, sc_off + is0 + 4)) >> 4) & 15) | (((int(ffi.read_u8(src, sc_off + is0)) >> 6) & 3) << 4)
                sc2 = (int(ffi.read_u8(src, sc_off + is1 + 4)) & 15) | (((int(ffi.read_u8(src, sc_off + is1 - 4)) >> 6) & 3) << 4)
                m2 = ((int(ffi.read_u8(src, sc_off + is1 + 4)) >> 4) & 15) | (((int(ffi.read_u8(src, sc_off + is1)) >> 6) & 3) << 4)
            }
            bs0 := (b * 16 + chunk * 4) * 8
            sum_m += m1 * (ffi.read_i64(bs, bs0) + ffi.read_i64(bs, bs0 + 8)) +
                     m2 * (ffi.read_i64(bs, bs0 + 16) + ffi.read_i64(bs, bs0 + 24))
            q_off := qs_base + chunk * 32
            x_lo := xb + chunk * 64
            x_hi := x_lo + 32
            sh_lo := chunk * 2
            sh_hi := sh_lo + 1
            $iq_lo := 0
            $iq_hi := 0
            for l in 0:32 {
                qb := int(ffi.read_u8(src, q_off + l)) & 255
                hb := int(ffi.read_u8(src, qh_base + l)) & 255
                ql := (qb & 15) | (((hb >> sh_lo) & 1) << 4)
                qh := ((qb >> 4) & 15) | (((hb >> sh_hi) & 1) << 4)
                iq_lo += ql * int(ffi.read_i8(qs, x_lo + l))
                iq_hi += qh * int(ffi.read_i8(qs, x_hi + l))
            }
            sum_q += sc1 * iq_lo + sc2 * iq_hi
        }
        total += ffi.read_f32(d, b * 4) * (dv * f32(sum_q) - dmv * f32(sum_m))
    }
    << total
}

pub unsafe fn raw_dot_q6_k_q8_k_f32(src c_ptr, qs c_ptr, d c_ptr, nb int) f32 {
    if nb <= 0 { << f32(0) }
    $total := f32(0)
    for b in 0:nb {
        off := b * Q6_K_BYTES
        dv := math.float16_to_f32(int(ffi.read_u16(src, off + 208)))
        xb := b * QK_K
        $isum := 0
        for h in 0:2 {
            y_off := xb + h * 128
            ql_off := off + h * 64
            qh_off := off + 128 + h * 32
            sc_off := off + 192 + h * 8
            for l in 0:32 {
                is_idx := l / 16
                ql0 := int(ffi.read_u8(src, ql_off + l)) & 255
                ql1 := int(ffi.read_u8(src, ql_off + l + 32)) & 255
                qhv := int(ffi.read_u8(src, qh_off + l)) & 255
                q1 := ((ql0 & 15) | ((qhv & 3) << 4)) - 32
                q2 := ((ql1 & 15) | (((qhv >> 2) & 3) << 4)) - 32
                q3 := (((ql0 >> 4) & 15) | (((qhv >> 4) & 3) << 4)) - 32
                q4 := (((ql1 >> 4) & 15) | (((qhv >> 6) & 3) << 4)) - 32
                s1 := int(ffi.read_i8(src, sc_off + is_idx)) * q1
                s2 := int(ffi.read_i8(src, sc_off + is_idx + 2)) * q2
                s3 := int(ffi.read_i8(src, sc_off + is_idx + 4)) * q3
                s4 := int(ffi.read_i8(src, sc_off + is_idx + 6)) * q4
                isum += s1 * int(ffi.read_i8(qs, y_off + l)) +
                        s2 * int(ffi.read_i8(qs, y_off + l + 32)) +
                        s3 * int(ffi.read_i8(qs, y_off + l + 64)) +
                        s4 * int(ffi.read_i8(qs, y_off + l + 96))
            }
        }
        total += dv * ffi.read_f32(d, b * 4) * f32(isum)
    }
    << total
}

pub unsafe fn raw_gemv4_f32(out c_ptr, w c_ptr, x c_ptr, rows int, cols int) {
    for r in 0:rows {
        $acc := f32(0)
        rw := ffi.offset(w, r * cols * 4)
        for c in 0:cols {
            acc += ffi.read_f32(rw, c * 4) * ffi.read_f32(x, c * 4)
        }
        ffi.write_f32(out, r * 4, acc)
    }
}

pub unsafe fn raw_gemv4_q4_0_p4k4_f16_q8_0(out c_ptr, qs c_ptr, ws c_ptr, xq c_ptr, xs c_ptr, rg_cnt int, nb int) {
    for rg in 0:rg_cnt {
        g_off := rg * nb
        for r4 in 0:4 {
            $acc := f32(0)
            for b in 0:nb {
                gb := g_off + b
                q_base := gb * 64 + r4 * 4
                x_base := b * 32
                $isum := 0
                for j in 0:16 {
                    bv := int(ffi.read_u8(qs, q_base + (j >> 2) * 16 + (j & 3))) ^ 136
                    q0 := (bv & 15) - 8
                    q1 := (bv >> 4) - 8
                    isum += q0 * int(ffi.read_i8(xq, x_base + j)) + q1 * int(ffi.read_i8(xq, x_base + 16 + j))
                }
                acc += f32(isum) * (math.float16_to_f32(int(ffi.read_u16(ws, (gb * 4 + r4) * 2))) * ffi.read_f32(xs, b * 4))
            }
            ffi.write_f32(out, (rg * 4 + r4) * 4, acc)
        }
    }
}

pub unsafe fn raw_gemv4_q8_0_p4k4_f16_q8_0(out c_ptr, qs c_ptr, ws c_ptr, xq c_ptr, xs c_ptr, rg_cnt int, nb int) {
    for rg in 0:rg_cnt {
        g_off := rg * nb
        for r4 in 0:4 {
            $acc := f32(0)
            for b in 0:nb {
                gb := g_off + b
                q_base := gb * 128 + r4 * 4
                x_base := b * 32
                $isum := 0
                for j in 0:32 {
                    isum += int(ffi.read_i8(qs, q_base + (j >> 2) * 16 + (j & 3))) * int(ffi.read_i8(xq, x_base + j))
                }
                acc += f32(isum) * (math.float16_to_f32(int(ffi.read_u16(ws, (gb * 4 + r4) * 2))) * ffi.read_f32(xs, b * 4))
            }
            ffi.write_f32(out, (rg * 4 + r4) * 4, acc)
        }
    }
}

pub unsafe fn raw_gemv_q4_k_q8_k(out c_ptr, w_row c_ptr, qs c_ptr, d c_ptr, bs c_ptr, rows int, nb int) {
    stride := nb * Q4_K_BYTES
    for r in 0:rows {
        v := raw_dot_q4_k_q8_k_f32(ffi.offset(w_row, r * stride), qs, d, bs, nb)
        ffi.write_f32(out, r * 4, v)
    }
}

pub unsafe fn raw_gemv_q5_k_q8_k(out c_ptr, w_row c_ptr, qs c_ptr, d c_ptr, bs c_ptr, rows int, nb int) {
    stride := nb * Q5_K_BYTES
    for r in 0:rows {
        v := raw_dot_q5_k_q8_k_f32(ffi.offset(w_row, r * stride), qs, d, bs, nb)
        ffi.write_f32(out, r * 4, v)
    }
}

pub unsafe fn raw_gemv_q6_k_q8_k(out c_ptr, w_row c_ptr, qs c_ptr, d c_ptr, rows int, nb int) {
    stride := nb * Q6_K_BYTES
    for r in 0:rows {
        v := raw_dot_q6_k_q8_k_f32(ffi.offset(w_row, r * stride), qs, d, nb)
        ffi.write_f32(out, r * 4, v)
    }
}

pub unsafe fn raw_gemm4x4_f32(out c_ptr, w c_ptr, x c_ptr, m_cnt int, rows int, cols int) {
    for mi in 0:m_cnt {
        raw_gemv4_f32(ffi.offset(out, mi * rows * 4), w, ffi.offset(x, mi * cols * 4), rows, cols)
    }
}

pub unsafe fn raw_gemm4x8_q4_0_p4k4_signed_f16_q8_0(out c_ptr, qs c_ptr, ws c_ptr, xq c_ptr, xs c_ptr, m_cnt int, rg_cnt int, nb int) {
    rows := rg_cnt * 4
    for mi in 0:m_cnt {
        raw_gemv4_q4_0_p4k4_f16_q8_0(
            ffi.offset(out, mi * rows * 4), qs, ws,
            ffi.offset(xq, mi * nb * 32), ffi.offset(xs, mi * nb * 4),
            rg_cnt, nb
        )
    }
}

pub unsafe fn raw_gemm4x8_q8_0_p4k4_f16_q8_0(out c_ptr, qs c_ptr, ws c_ptr, xq c_ptr, xs c_ptr, m_cnt int, rg_cnt int, nb int) {
    rows := rg_cnt * 4
    for mi in 0:m_cnt {
        raw_gemv4_q8_0_p4k4_f16_q8_0(
            ffi.offset(out, mi * rows * 4), qs, ws,
            ffi.offset(xq, mi * nb * 32), ffi.offset(xs, mi * nb * 4),
            rg_cnt, nb
        )
    }
}

pub unsafe fn raw_gemm_q4_k_q8_k(out c_ptr, w_row c_ptr, qs c_ptr, d c_ptr, bs c_ptr, m_cnt int, rows int, nb int) {
    cols := nb * QK_K
    for mi in 0:m_cnt {
        raw_gemv_q4_k_q8_k(
            ffi.offset(out, mi * rows * 4), w_row,
            ffi.offset(qs, mi * cols), ffi.offset(d, mi * nb * 4), ffi.offset(bs, mi * nb * 128),
            rows, nb
        )
    }
}

pub unsafe fn raw_gemm_q5_k_q8_k(out c_ptr, w_row c_ptr, qs c_ptr, d c_ptr, bs c_ptr, m_cnt int, rows int, nb int) {
    cols := nb * QK_K
    for mi in 0:m_cnt {
        raw_gemv_q5_k_q8_k(
            ffi.offset(out, mi * rows * 4), w_row,
            ffi.offset(qs, mi * cols), ffi.offset(d, mi * nb * 4), ffi.offset(bs, mi * nb * 128),
            rows, nb
        )
    }
}

pub unsafe fn raw_gemm_q6_k_q8_k(out c_ptr, w_row c_ptr, qs c_ptr, d c_ptr, m_cnt int, rows int, nb int) {
    cols := nb * QK_K
    for mi in 0:m_cnt {
        raw_gemv_q6_k_q8_k(
            ffi.offset(out, mi * rows * 4), w_row,
            ffi.offset(qs, mi * cols), ffi.offset(d, mi * nb * 4),
            rows, nb
        )
    }
}
