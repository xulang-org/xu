@tensor

#errors

pub const GGML_BLOCK_VALUES = 32
pub const Q4_0_BYTES = 18
pub const Q4_1_BYTES = 20
pub const Q5_0_BYTES = 22
pub const Q5_1_BYTES = 24
pub const Q8_0_BYTES = 34
pub const QK_K = 256
pub const Q2_K_BYTES = 84
pub const Q3_K_BYTES = 110
pub const Q4_K_BYTES = 144
pub const Q5_K_BYTES = 176
pub const Q6_K_BYTES = 210

// GGML Q4_0 stores a little-endian binary16 scale and 16 packed bytes.
// Each byte contains a low nibble for index i and a high nibble for i+16.
pub struct Q4Block {
    pub scale F16
    pub packed [16]u8
}

// GGML Q4_1 stores little-endian f16 d, f16 m, and 16 nibble bytes (x = q*d + m).
pub struct Q41Block {
    pub d F16
    pub m F16
    pub qs [16]u8
}

// GGML Q5_1 stores little-endian f16 d, f16 m, 4 bytes high bits, and 16 nibble bytes.
pub struct Q51Block {
    pub d F16
    pub m F16
    pub qh [4]u8
    pub qs [16]u8
}

// GGML Q2_K super-block encodes 256 values in 84 bytes: 16 scale/min bytes,
// 64 bytes of 2-bit quants, trailing f16 d and f16 dmin.
pub struct Q2KBlock {
    pub scales [16]u8
    pub qs [64]u8
    pub d F16
    pub dmin F16
}

// GGML Q3_K super-block encodes 256 values in 110 bytes: 32 hmask bytes,
// 64 bytes of 2-bit low quants, 12 packed 6-bit scales, and trailing f16 d.
pub struct Q3KBlock {
    pub hmask [32]u8
    pub qs [64]u8
    pub scales [12]u8
    pub d F16
}

// GGML Q5_0 stores a little-endian binary16 scale, 4 bytes of 5th high bits,
// and 16 bytes of packed low nibbles.
pub struct Q5Block {
    pub scale F16
    pub qh [4]u8
    pub qs [16]u8
}

// GGML Q8_0 stores the same scale followed by 32 signed quantized bytes.
pub struct Q8Block {
    pub scale F16
    pub quants [32]i8
}

// GGML Q4_K super-block encodes 256 values in 144 bytes: f16 d/dmin, 12 packed
// 6-bit scale/min bytes, and 128 bytes of 4-bit unsigned nibbles.
pub struct Q4KBlock {
    pub d F16
    pub dmin F16
    pub scales [12]u8
    pub qs [128]u8
}

// GGML Q5_K super-block encodes 256 values in 176 bytes: f16 d/dmin, 12 packed
// 6-bit scale/min bytes, 32 high-bit bytes qh, and 128 low-nibble bytes qs.
pub struct Q5KBlock {
    pub d F16
    pub dmin F16
    pub scales [12]u8
    pub qh [32]u8
    pub qs [128]u8
}

// GGML Q6_K super-block encodes 256 values in 210 bytes: 128 low-nibble bytes,
// 64 high-2-bit bytes, 16 signed int8 sub-scales, and a trailing f16 scale d.
pub struct Q6KBlock {
    pub ql [128]u8
    pub qh [64]u8
    pub scales [16]i8
    pub d F16
}

fn check_block(storage &string, offset int, width int) int {
    if offset < 0 || offset > storage.len || width > storage.len - offset {
        >>> errors.new("truncated quantization block")
    }
    << 0
}

pub fn read_q4_0(storage &string, offset int) Q4Block {
    check_block(storage, offset, Q4_0_BYTES) >>>
    $packed := [16]u8{}
    for i in 0:16 {
        packed[i] = u8(storage[offset + 2 + i])
    }
    << Q4Block{scale: F16{bits: u16(scalar_bits_le(storage, offset, 2))}, packed: packed}
}

pub fn read_q8_0(storage &string, offset int) Q8Block {
    check_block(storage, offset, Q8_0_BYTES) >>>
    $quants := [32]i8{}
    for i in 0:32 {
        quants[i] = i8(storage[offset + 2 + i])
    }
    << Q8Block{scale: F16{bits: u16(scalar_bits_le(storage, offset, 2))}, quants: quants}
}

pub fn (block &Q4Block) at(index int) f32 {
    if index < 0 || index >= GGML_BLOCK_VALUES { >>> errors.new("Q4_0 index outside block") }
    packed := int(block.packed[index & 15])
    q := (packed >> ((index >> 4) * 4)) & 15
    << f32(q - 8) * block.scale.to_f32()
}

pub fn (block &Q8Block) at(index int) f32 {
    if index < 0 || index >= GGML_BLOCK_VALUES { >>> errors.new("Q8_0 index outside block") }
    << f32(int(block.quants[index])) * block.scale.to_f32()
}

pub fn (block &Q4Block) append_f32(out $&[]f32) {
    d := block.scale.to_f32()
    for lane in 0:2 {
        shift := lane * 4
        for i in 0:16 {
            q := (int(block.packed[i]) >> shift) & 15
            out.push(f32(q - 8) * d)
        }
    }
}

pub fn (block &Q8Block) append_f32(out $&[]f32) {
    d := block.scale.to_f32()
    for i in 0:32 {
        out.push(f32(int(block.quants[i])) * d)
    }
}

fn q4_k_scale(scales &[12]u8, j int) int {
    if j < 4 { << int(scales[j]) & 63 }
    << (int(scales[j + 4]) & 15) | ((int(scales[j - 4]) >> 6) << 4)
}

fn q4_k_min(scales &[12]u8, j int) int {
    if j < 4 { << int(scales[j + 4]) & 63 }
    << (int(scales[j + 4]) >> 4) | ((int(scales[j]) >> 6) << 4)
}

pub fn read_q4_k(storage &string, offset int) Q4KBlock {
    check_block(storage, offset, Q4_K_BYTES) >>>
    d := F16{bits: u16(scalar_bits_le(storage, offset, 2))}
    dmin := F16{bits: u16(scalar_bits_le(storage, offset + 2, 2))}
    $scales := [12]u8{}
    for i in 0:12 { scales[i] = u8(storage[offset + 4 + i]) }
    $qs := [128]u8{}
    for i in 0:128 { qs[i] = u8(storage[offset + 16 + i]) }
    << Q4KBlock{d: d, dmin: dmin, scales: scales, qs: qs}
}

pub fn (block &Q4KBlock) at(index int) f32 {
    if index < 0 || index >= QK_K { >>> errors.new("Q4_K index outside block") }
    chunk := index / 64
    within := index % 64
    $is_idx := chunk * 2
    $shift := 0
    if within >= 32 {
        is_idx += 1
        shift = 4
    }
    sc := q4_k_scale(&block.scales, is_idx)
    m := q4_k_min(&block.scales, is_idx)
    q := (int(block.qs[chunk * 32 + (within & 31)]) >> shift) & 15
    << block.d.to_f32() * f32(sc) * f32(q) - block.dmin.to_f32() * f32(m)
}

pub fn (block &Q4KBlock) append_f32(out $&[]f32) {
    d := block.d.to_f32()
    dmin := block.dmin.to_f32()
    for chunk in 0:4 {
        is_idx := chunk * 2
        d1 := d * f32(q4_k_scale(&block.scales, is_idx))
        m1 := dmin * f32(q4_k_min(&block.scales, is_idx))
        d2 := d * f32(q4_k_scale(&block.scales, is_idx + 1))
        m2 := dmin * f32(q4_k_min(&block.scales, is_idx + 1))
        q_off := chunk * 32
        for l in 0:32 {
            out.push(d1 * f32(int(block.qs[q_off + l]) & 15) - m1)
        }
        for l in 0:32 {
            out.push(d2 * f32(int(block.qs[q_off + l]) >> 4) - m2)
        }
    }
}

pub fn (block &Q4KBlock) dot_f32(x &[]f32, x_off int) f32 {
    d := block.d.to_f32()
    dmin := block.dmin.to_f32()
    $acc := f32(0)
    for chunk in 0:4 {
        is_idx := chunk * 2
        d1 := d * f32(q4_k_scale(&block.scales, is_idx))
        m1 := dmin * f32(q4_k_min(&block.scales, is_idx))
        d2 := d * f32(q4_k_scale(&block.scales, is_idx + 1))
        m2 := dmin * f32(q4_k_min(&block.scales, is_idx + 1))
        q_off := chunk * 32
        x_lo := x_off + chunk * 64
        x_hi := x_lo + 32
        $sq_lo := f32(0)
        $sx_lo := f32(0)
        $sq_hi := f32(0)
        $sx_hi := f32(0)
        for l in 0:32 {
            qb := int(block.qs[q_off + l])
            xl := x[x_lo + l]
            xh := x[x_hi + l]
            sq_lo += f32(qb & 15) * xl
            sx_lo += xl
            sq_hi += f32(qb >> 4) * xh
            sx_hi += xh
        }
        acc += (d1 * sq_lo - m1 * sx_lo) + (d2 * sq_hi - m2 * sx_hi)
    }
    << acc
}

pub fn read_q5_k(storage &string, offset int) Q5KBlock {
    check_block(storage, offset, Q5_K_BYTES) >>>
    d := F16{bits: u16(scalar_bits_le(storage, offset, 2))}
    dmin := F16{bits: u16(scalar_bits_le(storage, offset + 2, 2))}
    $scales := [12]u8{}
    for i in 0:12 { scales[i] = u8(storage[offset + 4 + i]) }
    $qh := [32]u8{}
    for i in 0:32 { qh[i] = u8(storage[offset + 16 + i]) }
    $qs := [128]u8{}
    for i in 0:128 { qs[i] = u8(storage[offset + 48 + i]) }
    << Q5KBlock{d: d, dmin: dmin, scales: scales, qh: qh, qs: qs}
}

pub fn (block &Q5KBlock) at(index int) f32 {
    if index < 0 || index >= QK_K { >>> errors.new("Q5_K index outside block") }
    chunk := index / 64
    within := index % 64
    l := within & 31
    $is_idx := chunk * 2
    $shift := 0
    $hshift := chunk * 2
    if within >= 32 {
        is_idx += 1
        shift = 4
        hshift += 1
    }
    sc := q4_k_scale(&block.scales, is_idx)
    m := q4_k_min(&block.scales, is_idx)
    ql := (int(block.qs[chunk * 32 + l]) >> shift) & 15
    qh := ((int(block.qh[l]) >> hshift) & 1) << 4
    q := ql | qh
    << block.d.to_f32() * f32(sc) * f32(q) - block.dmin.to_f32() * f32(m)
}

pub fn (block &Q5KBlock) append_f32(out $&[]f32) {
    d := block.d.to_f32()
    dmin := block.dmin.to_f32()
    for chunk in 0:4 {
        is_idx := chunk * 2
        d1 := d * f32(q4_k_scale(&block.scales, is_idx))
        m1 := dmin * f32(q4_k_min(&block.scales, is_idx))
        d2 := d * f32(q4_k_scale(&block.scales, is_idx + 1))
        m2 := dmin * f32(q4_k_min(&block.scales, is_idx + 1))
        q_off := chunk * 32
        sh_lo := chunk * 2
        sh_hi := sh_lo + 1
        for l in 0:32 {
            qb := int(block.qs[q_off + l])
            hb := int(block.qh[l])
            ql := (qb & 15) | (((hb >> sh_lo) & 1) << 4)
            out.push(d1 * f32(ql) - m1)
        }
        for l in 0:32 {
            qb := int(block.qs[q_off + l])
            hb := int(block.qh[l])
            qh := (qb >> 4) | (((hb >> sh_hi) & 1) << 4)
            out.push(d2 * f32(qh) - m2)
        }
    }
}

pub fn (block &Q5KBlock) dot_f32(x &[]f32, x_off int) f32 {
    d := block.d.to_f32()
    dmin := block.dmin.to_f32()
    $acc := f32(0)
    for chunk in 0:4 {
        is_idx := chunk * 2
        d1 := d * f32(q4_k_scale(&block.scales, is_idx))
        m1 := dmin * f32(q4_k_min(&block.scales, is_idx))
        d2 := d * f32(q4_k_scale(&block.scales, is_idx + 1))
        m2 := dmin * f32(q4_k_min(&block.scales, is_idx + 1))
        q_off := chunk * 32
        x_lo := x_off + chunk * 64
        x_hi := x_lo + 32
        sh_lo := chunk * 2
        sh_hi := sh_lo + 1
        $sq_lo := f32(0)
        $sx_lo := f32(0)
        $sq_hi := f32(0)
        $sx_hi := f32(0)
        for l in 0:32 {
            qb := int(block.qs[q_off + l])
            hb := int(block.qh[l])
            ql := (qb & 15) | (((hb >> sh_lo) & 1) << 4)
            qh := (qb >> 4) | (((hb >> sh_hi) & 1) << 4)
            xl := x[x_lo + l]
            xh := x[x_hi + l]
            sq_lo += f32(ql) * xl
            sx_lo += xl
            sq_hi += f32(qh) * xh
            sx_hi += xh
        }
        acc += (d1 * sq_lo - m1 * sx_lo) + (d2 * sq_hi - m2 * sx_hi)
    }
    << acc
}

pub fn read_q6_k(storage &string, offset int) Q6KBlock {
    check_block(storage, offset, Q6_K_BYTES) >>>
    $ql := [128]u8{}
    for i in 0:128 { ql[i] = u8(storage[offset + i]) }
    $qh := [64]u8{}
    for i in 0:64 { qh[i] = u8(storage[offset + 128 + i]) }
    $scales := [16]i8{}
    for i in 0:16 { scales[i] = i8(storage[offset + 192 + i]) }
    d := F16{bits: u16(scalar_bits_le(storage, offset + 208, 2))}
    << Q6KBlock{ql: ql, qh: qh, scales: scales, d: d}
}

pub fn (block &Q6KBlock) at(index int) f32 {
    if index < 0 || index >= QK_K { >>> errors.new("Q6_K index outside block") }
    h := index / 128
    rem := index % 128
    quad := rem / 32
    l := rem % 32
    is_idx := l / 16
    ql_off := h * 64
    qh_off := h * 32
    sc_off := h * 8
    qh_v := int(block.qh[qh_off + l])
    $q := 0
    $sc := 0
    if quad == 0 {
        q = ((int(block.ql[ql_off + l]) & 15) | ((qh_v & 3) << 4)) - 32
        sc = int(block.scales[sc_off + is_idx])
    } else if quad == 1 {
        q = ((int(block.ql[ql_off + l + 32]) & 15) | (((qh_v >> 2) & 3) << 4)) - 32
        sc = int(block.scales[sc_off + is_idx + 2])
    } else if quad == 2 {
        q = ((int(block.ql[ql_off + l]) >> 4) | (((qh_v >> 4) & 3) << 4)) - 32
        sc = int(block.scales[sc_off + is_idx + 4])
    } else {
        q = ((int(block.ql[ql_off + l + 32]) >> 4) | (((qh_v >> 6) & 3) << 4)) - 32
        sc = int(block.scales[sc_off + is_idx + 6])
    }
    << block.d.to_f32() * f32(sc) * f32(q)
}

pub fn (block &Q6KBlock) append_f32(out $&[]f32) {
    d := block.d.to_f32()
    $buf := [256]f32{}
    for h in 0:2 {
        y_off := h * 128
        ql_off := h * 64
        qh_off := h * 32
        sc_off := h * 8
        for l in 0:32 {
            is_idx := l / 16
            ql0 := int(block.ql[ql_off + l])
            ql1 := int(block.ql[ql_off + l + 32])
            qhv := int(block.qh[qh_off + l])
            q1 := ((ql0 & 15) | ((qhv & 3) << 4)) - 32
            q2 := ((ql1 & 15) | (((qhv >> 2) & 3) << 4)) - 32
            q3 := ((ql0 >> 4) | (((qhv >> 4) & 3) << 4)) - 32
            q4 := ((ql1 >> 4) | (((qhv >> 6) & 3) << 4)) - 32
            buf[y_off + l] = d * f32(int(block.scales[sc_off + is_idx])) * f32(q1)
            buf[y_off + l + 32] = d * f32(int(block.scales[sc_off + is_idx + 2])) * f32(q2)
            buf[y_off + l + 64] = d * f32(int(block.scales[sc_off + is_idx + 4])) * f32(q3)
            buf[y_off + l + 96] = d * f32(int(block.scales[sc_off + is_idx + 6])) * f32(q4)
        }
    }
    for i in 0:256 { out.push(buf[i]) }
}

pub fn (block &Q6KBlock) dot_f32(x &[]f32, x_off int) f32 {
    d := block.d.to_f32()
    $sum := f32(0)
    for h in 0:2 {
        y_off := x_off + h * 128
        ql_off := h * 64
        qh_off := h * 32
        sc_off := h * 8
        for l in 0:32 {
            is_idx := l / 16
            ql0 := int(block.ql[ql_off + l])
            ql1 := int(block.ql[ql_off + l + 32])
            qhv := int(block.qh[qh_off + l])
            q1 := ((ql0 & 15) | ((qhv & 3) << 4)) - 32
            q2 := ((ql1 & 15) | (((qhv >> 2) & 3) << 4)) - 32
            q3 := ((ql0 >> 4) | (((qhv >> 4) & 3) << 4)) - 32
            q4 := ((ql1 >> 4) | (((qhv >> 6) & 3) << 4)) - 32
            s1 := int(block.scales[sc_off + is_idx]) * q1
            s2 := int(block.scales[sc_off + is_idx + 2]) * q2
            s3 := int(block.scales[sc_off + is_idx + 4]) * q3
            s4 := int(block.scales[sc_off + is_idx + 6]) * q4
            sum += f32(s1) * x[y_off + l] + f32(s2) * x[y_off + l + 32] +
                   f32(s3) * x[y_off + l + 64] + f32(s4) * x[y_off + l + 96]
        }
    }
    << d * sum
}

pub fn read_q5_0(storage &string, offset int) Q5Block {
    check_block(storage, offset, Q5_0_BYTES) >>>
    $qh := [4]u8{}
    for i in 0:4 { qh[i] = u8(storage[offset + 2 + i]) }
    $qs := [16]u8{}
    for i in 0:16 { qs[i] = u8(storage[offset + 6 + i]) }
    << Q5Block{scale: F16{bits: u16(scalar_bits_le(storage, offset, 2))}, qh: qh, qs: qs}
}

fn q5_qh_bits(qh &[4]u8) int {
    << int(qh[0]) | (int(qh[1]) << 8) | (int(qh[2]) << 16) | (int(qh[3]) << 24)
}

pub fn (block &Q5Block) at(index int) f32 {
    if index < 0 || index >= GGML_BLOCK_VALUES { >>> errors.new("Q5_0 index outside block") }
    qh := q5_qh_bits(&block.qh)
    $q := 0
    if index < 16 {
        xh := ((qh >> index) & 1) << 4
        q = ((int(block.qs[index]) & 15) | xh) - 16
    } else {
        j := index - 16
        xh := ((qh >> (j + 16)) & 1) << 4
        q = (((int(block.qs[j]) >> 4) & 15) | xh) - 16
    }
    << f32(q) * block.scale.to_f32()
}

pub fn (block &Q5Block) append_f32(out $&[]f32) {
    d := block.scale.to_f32()
    qh := q5_qh_bits(&block.qh)
    for j in 0:16 {
        xh0 := ((qh >> j) & 1) << 4
        q0 := ((int(block.qs[j]) & 15) | xh0) - 16
        out.push(f32(q0) * d)
    }
    for j in 0:16 {
        xh1 := ((qh >> (j + 16)) & 1) << 4
        q1 := (((int(block.qs[j]) >> 4) & 15) | xh1) - 16
        out.push(f32(q1) * d)
    }
}

pub fn (block &Q5Block) dot_f32(x &[]f32, x_off int) f32 {
    d := block.scale.to_f32()
    qh := q5_qh_bits(&block.qh)
    $acc := f32(0)
    for j in 0:16 {
        bv := int(block.qs[j])
        xh0 := ((qh >> j) & 1) << 4
        xh1 := ((qh >> (j + 16)) & 1) << 4
        q0 := ((bv & 15) | xh0) - 16
        q1 := (((bv >> 4) & 15) | xh1) - 16
        acc += f32(q0) * x[x_off + j] + f32(q1) * x[x_off + 16 + j]
    }
    << d * acc
}

// Zero-copy block dot products directly over caller-owned byte storage.
pub fn q5_0_dot_f32(storage &string, offset int, x &[]f32, x_off int) f32 {
    check_block(storage, offset, Q5_0_BYTES) >>>
    d := (F16{bits: u16(scalar_bits_le(storage, offset, 2))}).to_f32()
    qh := scalar_bits_le(storage, offset + 2, 4)
    $acc := f32(0)
    qs_off := offset + 6
    for j in 0:16 {
        bv := (*storage)[qs_off + j] & 255
        xh0 := ((qh >> j) & 1) << 4
        xh1 := ((qh >> (j + 16)) & 1) << 4
        q0 := ((bv & 15) | xh0) - 16
        q1 := (((bv >> 4) & 15) | xh1) - 16
        acc += f32(q0) * x[x_off + j] + f32(q1) * x[x_off + 16 + j]
    }
    << d * acc
}

pub fn q8_0_dot_f32(storage &string, offset int, x &[]f32, x_off int) f32 {
    check_block(storage, offset, Q8_0_BYTES) >>>
    d := (F16{bits: u16(scalar_bits_le(storage, offset, 2))}).to_f32()
    $acc := f32(0)
    q_off := offset + 2
    for i in 0:32 {
        q := int(i8((*storage)[q_off + i]))
        acc += f32(q) * x[x_off + i]
    }
    << d * acc
}

fn q4_k_scale_at(storage &string, sc_off int, j int) int {
    if j < 4 { << (*storage)[sc_off + j] & 63 }
    << ((*storage)[sc_off + j + 4] & 15) | ((((*storage)[sc_off + j - 4] >> 6) & 3) << 4)
}

fn q4_k_min_at(storage &string, sc_off int, j int) int {
    if j < 4 { << (*storage)[sc_off + j + 4] & 63 }
    << (((*storage)[sc_off + j + 4] >> 4) & 15) | ((((*storage)[sc_off + j] >> 6) & 3) << 4)
}

pub fn q4_k_dot_f32(storage &string, offset int, x &[]f32, x_off int) f32 {
    check_block(storage, offset, Q4_K_BYTES) >>>
    d := (F16{bits: u16(scalar_bits_le(storage, offset, 2))}).to_f32()
    dmin := (F16{bits: u16(scalar_bits_le(storage, offset + 2, 2))}).to_f32()
    sc_off := offset + 4
    qs_base := offset + 16
    $acc := f32(0)
    for chunk in 0:4 {
        is_idx := chunk * 2
        d1 := d * f32(q4_k_scale_at(storage, sc_off, is_idx))
        m1 := dmin * f32(q4_k_min_at(storage, sc_off, is_idx))
        d2 := d * f32(q4_k_scale_at(storage, sc_off, is_idx + 1))
        m2 := dmin * f32(q4_k_min_at(storage, sc_off, is_idx + 1))
        q_off := qs_base + chunk * 32
        x_lo := x_off + chunk * 64
        x_hi := x_lo + 32
        $sq_lo := f32(0)
        $sx_lo := f32(0)
        $sq_hi := f32(0)
        $sx_hi := f32(0)
        for l in 0:32 {
            qb := (*storage)[q_off + l] & 255
            xl := x[x_lo + l]
            xh := x[x_hi + l]
            sq_lo += f32(qb & 15) * xl
            sx_lo += xl
            sq_hi += f32((qb >> 4) & 15) * xh
            sx_hi += xh
        }
        acc += (d1 * sq_lo - m1 * sx_lo) + (d2 * sq_hi - m2 * sx_hi)
    }
    << acc
}

pub fn q6_k_dot_f32(storage &string, offset int, x &[]f32, x_off int) f32 {
    check_block(storage, offset, Q6_K_BYTES) >>>
    d := (F16{bits: u16(scalar_bits_le(storage, offset + 208, 2))}).to_f32()
    $sum := f32(0)
    for h in 0:2 {
        y_off := x_off + h * 128
        ql_off := offset + h * 64
        qh_off := offset + 128 + h * 32
        sc_off := offset + 192 + h * 8
        for l in 0:32 {
            is_idx := l / 16
            ql0 := (*storage)[ql_off + l] & 255
            ql1 := (*storage)[ql_off + l + 32] & 255
            qhv := (*storage)[qh_off + l] & 255
            q1 := ((ql0 & 15) | ((qhv & 3) << 4)) - 32
            q2 := ((ql1 & 15) | (((qhv >> 2) & 3) << 4)) - 32
            q3 := (((ql0 >> 4) & 15) | (((qhv >> 4) & 3) << 4)) - 32
            q4 := (((ql1 >> 4) & 15) | (((qhv >> 6) & 3) << 4)) - 32
            s1 := int(i8((*storage)[sc_off + is_idx])) * q1
            s2 := int(i8((*storage)[sc_off + is_idx + 2])) * q2
            s3 := int(i8((*storage)[sc_off + is_idx + 4])) * q3
            s4 := int(i8((*storage)[sc_off + is_idx + 6])) * q4
            sum += f32(s1) * x[y_off + l] + f32(s2) * x[y_off + l + 32] +
                   f32(s3) * x[y_off + l + 64] + f32(s4) * x[y_off + l + 96]
        }
    }
    << d * sum
}

// Bounds-checked once per row, avoiding per-block throwing calls and helpers.
pub fn dot_q5_0_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q5_0_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q5_0 row")
    }
    need_x := n_blocks * GGML_BLOCK_VALUES
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q5_0 input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q5_0_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        qh := ((*storage)[offset + 2] & 255) |
              (((*storage)[offset + 3] & 255) << 8) |
              (((*storage)[offset + 4] & 255) << 16) |
              (((*storage)[offset + 5] & 255) << 24)
        $acc := f32(0)
        qs_off := offset + 6
        xb := x_off + b * GGML_BLOCK_VALUES
        for j in 0:16 {
            bv := (*storage)[qs_off + j] & 255
            xh0 := ((qh >> j) & 1) << 4
            xh1 := ((qh >> (j + 16)) & 1) << 4
            q0 := ((bv & 15) | xh0) - 16
            q1 := (((bv >> 4) & 15) | xh1) - 16
            acc += f32(q0) * x[xb + j] + f32(q1) * x[xb + 16 + j]
        }
        total += d * acc
    }
    << total
}

pub fn dot_q8_0_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q8_0_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q8_0 row")
    }
    need_x := n_blocks * GGML_BLOCK_VALUES
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q8_0 input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q8_0_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        $acc := f32(0)
        q_off := offset + 2
        xb := x_off + b * GGML_BLOCK_VALUES
        for i in 0:32 {
            q := int(i8((*storage)[q_off + i]))
            acc += f32(q) * x[xb + i]
        }
        total += d * acc
    }
    << total
}

pub fn dot_q4_k_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q4_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q4_K row")
    }
    need_x := n_blocks * QK_K
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q4_K input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q4_K_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        dmin := (F16{bits: u16(((*storage)[offset + 2] & 255) | (((*storage)[offset + 3] & 255) << 8))}).to_f32()
        sc_off := offset + 4
        qs_base := offset + 16
        xb := x_off + b * QK_K
        for chunk in 0:4 {
            is0 := chunk * 2
            is1 := is0 + 1
            $sc1 := 0
            $m1 := 0
            $sc2 := 0
            $m2 := 0
            if chunk < 2 {
                sc1 = (*storage)[sc_off + is0] & 63
                m1 = (*storage)[sc_off + is0 + 4] & 63
                sc2 = (*storage)[sc_off + is1] & 63
                m2 = (*storage)[sc_off + is1 + 4] & 63
            } else {
                sc1 = ((*storage)[sc_off + is0 + 4] & 15) | ((((*storage)[sc_off + is0 - 4] >> 6) & 3) << 4)
                m1 = (((*storage)[sc_off + is0 + 4] >> 4) & 15) | ((((*storage)[sc_off + is0] >> 6) & 3) << 4)
                sc2 = ((*storage)[sc_off + is1 + 4] & 15) | ((((*storage)[sc_off + is1 - 4] >> 6) & 3) << 4)
                m2 = (((*storage)[sc_off + is1 + 4] >> 4) & 15) | ((((*storage)[sc_off + is1] >> 6) & 3) << 4)
            }
            d1 := d * f32(sc1)
            min1 := dmin * f32(m1)
            d2 := d * f32(sc2)
            min2 := dmin * f32(m2)
            q_off := qs_base + chunk * 32
            x_lo := xb + chunk * 64
            x_hi := x_lo + 32
            $sq_lo := f32(0)
            $sx_lo := f32(0)
            $sq_hi := f32(0)
            $sx_hi := f32(0)
            for l in 0:32 {
                qb := (*storage)[q_off + l] & 255
                xl := x[x_lo + l]
                xh := x[x_hi + l]
                sq_lo += f32(qb & 15) * xl
                sx_lo += xl
                sq_hi += f32((qb >> 4) & 15) * xh
                sx_hi += xh
            }
            total += (d1 * sq_lo - min1 * sx_lo) + (d2 * sq_hi - min2 * sx_hi)
        }
    }
    << total
}

pub fn dot_q6_k_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q6_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q6_K row")
    }
    need_x := n_blocks * QK_K
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q6_K input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q6_K_BYTES
        d := (F16{bits: u16(((*storage)[offset + 208] & 255) | (((*storage)[offset + 209] & 255) << 8))}).to_f32()
        xb := x_off + b * QK_K
        $sum := f32(0)
        for h in 0:2 {
            y_off := xb + h * 128
            ql_off := offset + h * 64
            qh_off := offset + 128 + h * 32
            sc_off := offset + 192 + h * 8
            for l in 0:32 {
                is_idx := l / 16
                ql0 := (*storage)[ql_off + l] & 255
                ql1 := (*storage)[ql_off + l + 32] & 255
                qhv := (*storage)[qh_off + l] & 255
                q1 := ((ql0 & 15) | ((qhv & 3) << 4)) - 32
                q2 := ((ql1 & 15) | (((qhv >> 2) & 3) << 4)) - 32
                q3 := (((ql0 >> 4) & 15) | (((qhv >> 4) & 3) << 4)) - 32
                q4 := (((ql1 >> 4) & 15) | (((qhv >> 6) & 3) << 4)) - 32
                s1 := int(i8((*storage)[sc_off + is_idx])) * q1
                s2 := int(i8((*storage)[sc_off + is_idx + 2])) * q2
                s3 := int(i8((*storage)[sc_off + is_idx + 4])) * q3
                s4 := int(i8((*storage)[sc_off + is_idx + 6])) * q4
                sum += f32(s1) * x[y_off + l] + f32(s2) * x[y_off + l + 32] +
                       f32(s3) * x[y_off + l + 64] + f32(s4) * x[y_off + l + 96]
            }
        }
        total += d * sum
    }
    << total
}

pub fn quantize_q5_0_row(x &[]f32, out $&[]u8, n int) {
    nb := n / 32
    for b in 0:nb {
        base := b * 32
        $amax := 0.0
        for i in 0:32 {
            $v := f64(x[base + i])
            if v < 0.0 { v = -v }
            if v > amax { amax = v }
        }
        scale := f32(amax / 15.0)
        $inv := 0.0
        if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
        bits := int(f16(scale).bits)
        boff := b * Q5_0_BYTES
        out[boff] = u8(bits & 255)
        out[boff + 1] = u8((bits >> 8) & 255)
        $qh := 0
        for j in 0:16 {
            vf0 := f64(x[base + j]) * inv
            $q0 := 0
            if vf0 >= 0.0 { q0 = int(vf0 + 0.5) + 16 } else { q0 = 16 - int(0.5 - vf0) }
            if q0 < 0 { q0 = 0 }
            if q0 > 31 { q0 = 31 }
            if (q0 & 16) != 0 { qh = qh | (1 << j) }

            vf1 := f64(x[base + 16 + j]) * inv
            $q1 := 0
            if vf1 >= 0.0 { q1 = int(vf1 + 0.5) + 16 } else { q1 = 16 - int(0.5 - vf1) }
            if q1 < 0 { q1 = 0 }
            if q1 > 31 { q1 = 31 }
            if (q1 & 16) != 0 { qh = qh | (1 << (j + 16)) }

            out[boff + 6 + j] = u8((q0 & 15) | ((q1 & 15) << 4))
        }
        out[boff + 2] = u8(qh & 255)
        out[boff + 3] = u8((qh >> 8) & 255)
        out[boff + 4] = u8((qh >> 16) & 255)
        out[boff + 5] = u8((qh >> 24) & 255)
    }
}

pub fn dequant_f16_to_f32(src &string, off int, dst $&[]f32, dst_off int, n int) int {
    if n < 0 || off < 0 || off > src.len || n * 2 > src.len - off {
        >>> errors.new("F16 source out of bounds")
    }
    if dst_off < 0 || dst_off > dst.len || n > dst.len - dst_off {
        >>> errors.new("F16 destination out of bounds")
    }
    for i in 0:n {
        p := off + i * 2
        bits := ((*src)[p] & 255) | (((*src)[p + 1] & 255) << 8)
        dst[dst_off + i] = (F16{bits: u16(bits)}).to_f32()
    }
    << 0
}

pub fn dequant_bf16_to_f32(src &string, off int, dst $&[]f32, dst_off int, n int) int {
    if n < 0 || off < 0 || off > src.len || n * 2 > src.len - off {
        >>> errors.new("BF16 source out of bounds")
    }
    if dst_off < 0 || dst_off > dst.len || n > dst.len - dst_off {
        >>> errors.new("BF16 destination out of bounds")
    }
    for i in 0:n {
        p := off + i * 2
        bits := ((*src)[p] & 255) | (((*src)[p + 1] & 255) << 8)
        dst[dst_off + i] = (BF16{bits: u16(bits)}).to_f32()
    }
    << 0
}

pub const Q8_K_BYTES = 292

pub fn quantize_q8_k_row(x &[]f32, x_off int, qs $&[]i8, d_out $&[]f32, bsums $&[]int, n_blocks int) int {
    if n_blocks <= 0 { << 0 }
    need_x := n_blocks * QK_K
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q8_K input vector out of bounds")
    }
    if qs.len < need_x || d_out.len < n_blocks || bsums.len < n_blocks * 16 {
        >>> errors.new("Q8_K destination out of bounds")
    }
    for b in 0:n_blocks {
        xb := x_off + b * QK_K
        $amax := 0.0
        for i in 0:QK_K {
            $v := f64(x[xb + i])
            if v < 0.0 { v = -v }
            if v > amax { amax = v }
        }
        scale := f32(amax / 127.0)
        d_out[b] = scale
        $inv := 0.0
        if f64(scale) != 0.0 { inv = 1.0 / f64(scale) }
        qb := b * QK_K
        for s in 0:16 {
            $bsum := 0
            s_off := s * 16
            for l in 0:16 {
                vf := f64(x[xb + s_off + l]) * inv
                $q := 0
                if vf >= 0.0 { q = int(vf + 0.5) } else { q = -int(0.5 - vf) }
                if q > 127 { q = 127 }
                if q < -127 { q = -127 }
                qs[qb + s_off + l] = i8(q)
                bsum += q
            }
            bsums[b * 16 + s] = bsum
        }
    }
    << 0
}

pub fn dot_q4_k_q8_k_row_f32(storage &string, row_off int, q8_qs &[]i8, q8_d &[]f32, q8_bsums &[]int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q4_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q4_K row")
    }
    need_x := n_blocks * QK_K
    if q8_qs.len < need_x || q8_d.len < n_blocks || q8_bsums.len < n_blocks * 16 {
        >>> errors.new("Q8_K activation out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q4_K_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        dmin := (F16{bits: u16(((*storage)[offset + 2] & 255) | (((*storage)[offset + 3] & 255) << 8))}).to_f32()
        sc_off := offset + 4
        qs_base := offset + 16
        xb := b * QK_K
        $sum_q_scaled := 0
        $sum_m_bsums := 0
        for chunk in 0:4 {
            is0 := chunk * 2
            is1 := is0 + 1
            $sc1 := 0
            $m1 := 0
            $sc2 := 0
            $m2 := 0
            if chunk < 2 {
                sc1 = (*storage)[sc_off + is0] & 63
                m1 = (*storage)[sc_off + is0 + 4] & 63
                sc2 = (*storage)[sc_off + is1] & 63
                m2 = (*storage)[sc_off + is1 + 4] & 63
            } else {
                sc1 = ((*storage)[sc_off + is0 + 4] & 15) | ((((*storage)[sc_off + is0 - 4] >> 6) & 3) << 4)
                m1 = (((*storage)[sc_off + is0 + 4] >> 4) & 15) | ((((*storage)[sc_off + is0] >> 6) & 3) << 4)
                sc2 = ((*storage)[sc_off + is1 + 4] & 15) | ((((*storage)[sc_off + is1 - 4] >> 6) & 3) << 4)
                m2 = (((*storage)[sc_off + is1 + 4] >> 4) & 15) | ((((*storage)[sc_off + is1] >> 6) & 3) << 4)
            }
            bs0 := b * 16 + chunk * 4
            sum_m_bsums += m1 * (q8_bsums[bs0] + q8_bsums[bs0 + 1]) + m2 * (q8_bsums[bs0 + 2] + q8_bsums[bs0 + 3])
            q_off := qs_base + chunk * 32
            x_lo := xb + chunk * 64
            x_hi := x_lo + 32
            $iq_lo := 0
            $iq_hi := 0
            for l in 0:32 {
                qb := (*storage)[q_off + l] & 255
                iq_lo += (qb & 15) * int(q8_qs[x_lo + l])
                iq_hi += ((qb >> 4) & 15) * int(q8_qs[x_hi + l])
            }
            sum_q_scaled += sc1 * iq_lo + sc2 * iq_hi
        }
        total += q8_d[b] * (d * f32(sum_q_scaled) - dmin * f32(sum_m_bsums))
    }
    << total
}

pub fn dot_q5_k_bytes_f32(storage &string, offset int, x &[]f32, x_off int) f32 {
    << dot_q5_k_row_f32(storage, offset, x, x_off, 1) >>>
}

pub fn dot_q5_k_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q5_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q5_K row")
    }
    need_x := n_blocks * QK_K
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q5_K input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q5_K_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        dmin := (F16{bits: u16(((*storage)[offset + 2] & 255) | (((*storage)[offset + 3] & 255) << 8))}).to_f32()
        sc_off := offset + 4
        qh_base := offset + 16
        qs_base := offset + 48
        xb := x_off + b * QK_K
        for chunk in 0:4 {
            is0 := chunk * 2
            is1 := is0 + 1
            sc1 := q4_k_scale_at(storage, sc_off, is0)
            m1 := q4_k_min_at(storage, sc_off, is0)
            sc2 := q4_k_scale_at(storage, sc_off, is1)
            m2 := q4_k_min_at(storage, sc_off, is1)
            d1 := d * f32(sc1)
            min1 := dmin * f32(m1)
            d2 := d * f32(sc2)
            min2 := dmin * f32(m2)
            q_off := qs_base + chunk * 32
            x_lo := xb + chunk * 64
            x_hi := x_lo + 32
            sh_lo := chunk * 2
            sh_hi := sh_lo + 1
            $sq_lo := f32(0)
            $sx_lo := f32(0)
            $sq_hi := f32(0)
            $sx_hi := f32(0)
            for l in 0:32 {
                qb := (*storage)[q_off + l] & 255
                hb := (*storage)[qh_base + l] & 255
                ql := (qb & 15) | (((hb >> sh_lo) & 1) << 4)
                qh := ((qb >> 4) & 15) | (((hb >> sh_hi) & 1) << 4)
                xl := x[x_lo + l]
                xh := x[x_hi + l]
                sq_lo += f32(ql) * xl
                sx_lo += xl
                sq_hi += f32(qh) * xh
                sx_hi += xh
            }
            total += (d1 * sq_lo - min1 * sx_lo) + (d2 * sq_hi - min2 * sx_hi)
        }
    }
    << total
}

pub fn dot_q5_k_q8_k_row_f32(storage &string, row_off int, q8_qs &[]i8, q8_d &[]f32, q8_bsums &[]int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q5_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q5_K row")
    }
    need_x := n_blocks * QK_K
    if q8_qs.len < need_x || q8_d.len < n_blocks || q8_bsums.len < n_blocks * 16 {
        >>> errors.new("Q8_K activation out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q5_K_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        dmin := (F16{bits: u16(((*storage)[offset + 2] & 255) | (((*storage)[offset + 3] & 255) << 8))}).to_f32()
        sc_off := offset + 4
        qh_base := offset + 16
        qs_base := offset + 48
        xb := b * QK_K
        $sum_q_scaled := 0
        $sum_m_bsums := 0
        for chunk in 0:4 {
            is0 := chunk * 2
            is1 := is0 + 1
            sc1 := q4_k_scale_at(storage, sc_off, is0)
            m1 := q4_k_min_at(storage, sc_off, is0)
            sc2 := q4_k_scale_at(storage, sc_off, is1)
            m2 := q4_k_min_at(storage, sc_off, is1)
            bs0 := b * 16 + chunk * 4
            sum_m_bsums += m1 * (q8_bsums[bs0] + q8_bsums[bs0 + 1]) + m2 * (q8_bsums[bs0 + 2] + q8_bsums[bs0 + 3])
            q_off := qs_base + chunk * 32
            x_lo := xb + chunk * 64
            x_hi := x_lo + 32
            sh_lo := chunk * 2
            sh_hi := sh_lo + 1
            $iq_lo := 0
            $iq_hi := 0
            for l in 0:32 {
                qb := (*storage)[q_off + l] & 255
                hb := (*storage)[qh_base + l] & 255
                ql := (qb & 15) | (((hb >> sh_lo) & 1) << 4)
                qh := ((qb >> 4) & 15) | (((hb >> sh_hi) & 1) << 4)
                iq_lo += ql * int(q8_qs[x_lo + l])
                iq_hi += qh * int(q8_qs[x_hi + l])
            }
            sum_q_scaled += sc1 * iq_lo + sc2 * iq_hi
        }
        total += q8_d[b] * (d * f32(sum_q_scaled) - dmin * f32(sum_m_bsums))
    }
    << total
}

pub fn dot_q6_k_q8_k_row_f32(storage &string, row_off int, q8_qs &[]i8, q8_d &[]f32, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q6_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q6_K row")
    }
    need_x := n_blocks * QK_K
    if q8_qs.len < need_x || q8_d.len < n_blocks {
        >>> errors.new("Q8_K activation out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q6_K_BYTES
        d := (F16{bits: u16(((*storage)[offset + 208] & 255) | (((*storage)[offset + 209] & 255) << 8))}).to_f32()
        xb := b * QK_K
        $isum := 0
        for h in 0:2 {
            y_off := xb + h * 128
            ql_off := offset + h * 64
            qh_off := offset + 128 + h * 32
            sc_off := offset + 192 + h * 8
            for l in 0:32 {
                is_idx := l / 16
                ql0 := (*storage)[ql_off + l] & 255
                ql1 := (*storage)[ql_off + l + 32] & 255
                qhv := (*storage)[qh_off + l] & 255
                q1 := ((ql0 & 15) | ((qhv & 3) << 4)) - 32
                q2 := ((ql1 & 15) | (((qhv >> 2) & 3) << 4)) - 32
                q3 := (((ql0 >> 4) & 15) | (((qhv >> 4) & 3) << 4)) - 32
                q4 := (((ql1 >> 4) & 15) | (((qhv >> 6) & 3) << 4)) - 32
                s1 := int(i8((*storage)[sc_off + is_idx])) * q1
                s2 := int(i8((*storage)[sc_off + is_idx + 2])) * q2
                s3 := int(i8((*storage)[sc_off + is_idx + 4])) * q3
                s4 := int(i8((*storage)[sc_off + is_idx + 6])) * q4
                isum += s1 * int(q8_qs[y_off + l]) + s2 * int(q8_qs[y_off + l + 32]) +
                        s3 * int(q8_qs[y_off + l + 64]) + s4 * int(q8_qs[y_off + l + 96])
            }
        }
        total += d * q8_d[b] * f32(isum)
    }
    << total
}

pub fn read_q4_1(storage &string, offset int) Q41Block {
    check_block(storage, offset, Q4_1_BYTES) >>>
    d := F16{bits: u16(scalar_bits_le(storage, offset, 2))}
    m := F16{bits: u16(scalar_bits_le(storage, offset + 2, 2))}
    $qs := [16]u8{}
    for i in 0:16 { qs[i] = u8(storage[offset + 4 + i]) }
    << Q41Block{d: d, m: m, qs: qs}
}

pub fn (block &Q41Block) append_f32(out $&[]f32) {
    d := block.d.to_f32()
    m := block.m.to_f32()
    for j in 0:16 {
        q0 := int(block.qs[j]) & 15
        out.push(f32(q0) * d + m)
    }
    for j in 0:16 {
        q1 := (int(block.qs[j]) >> 4) & 15
        out.push(f32(q1) * d + m)
    }
}

pub fn (block &Q41Block) dot_f32(x &[]f32, x_off int) f32 {
    d := block.d.to_f32()
    m := block.m.to_f32()
    $sq := f32(0)
    $sx := f32(0)
    for j in 0:16 {
        bv := int(block.qs[j])
        x0 := x[x_off + j]
        x1 := x[x_off + 16 + j]
        sq += f32(bv & 15) * x0 + f32((bv >> 4) & 15) * x1
        sx += x0 + x1
    }
    << d * sq + m * sx
}

pub fn dot_q4_1_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q4_1_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q4_1 row")
    }
    need_x := n_blocks * GGML_BLOCK_VALUES
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q4_1 input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q4_1_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        m := (F16{bits: u16(((*storage)[offset + 2] & 255) | (((*storage)[offset + 3] & 255) << 8))}).to_f32()
        qs_off := offset + 4
        xb := x_off + b * GGML_BLOCK_VALUES
        $sq := f32(0)
        $sx := f32(0)
        for j in 0:16 {
            bv := (*storage)[qs_off + j] & 255
            x0 := x[xb + j]
            x1 := x[xb + 16 + j]
            sq += f32(bv & 15) * x0 + f32((bv >> 4) & 15) * x1
            sx += x0 + x1
        }
        total += d * sq + m * sx
    }
    << total
}

pub fn read_q5_1(storage &string, offset int) Q51Block {
    check_block(storage, offset, Q5_1_BYTES) >>>
    d := F16{bits: u16(scalar_bits_le(storage, offset, 2))}
    m := F16{bits: u16(scalar_bits_le(storage, offset + 2, 2))}
    $qh := [4]u8{}
    for i in 0:4 { qh[i] = u8(storage[offset + 4 + i]) }
    $qs := [16]u8{}
    for i in 0:16 { qs[i] = u8(storage[offset + 8 + i]) }
    << Q51Block{d: d, m: m, qh: qh, qs: qs}
}

pub fn (block &Q51Block) append_f32(out $&[]f32) {
    d := block.d.to_f32()
    m := block.m.to_f32()
    qh := q5_qh_bits(&block.qh)
    for j in 0:16 {
        xh0 := ((qh >> j) & 1) << 4
        q0 := (int(block.qs[j]) & 15) | xh0
        out.push(f32(q0) * d + m)
    }
    for j in 0:16 {
        xh1 := ((qh >> (j + 16)) & 1) << 4
        q1 := ((int(block.qs[j]) >> 4) & 15) | xh1
        out.push(f32(q1) * d + m)
    }
}

pub fn (block &Q51Block) dot_f32(x &[]f32, x_off int) f32 {
    d := block.d.to_f32()
    m := block.m.to_f32()
    qh := q5_qh_bits(&block.qh)
    $sq := f32(0)
    $sx := f32(0)
    for j in 0:16 {
        bv := int(block.qs[j])
        q0 := (bv & 15) | (((qh >> j) & 1) << 4)
        q1 := ((bv >> 4) & 15) | (((qh >> (j + 16)) & 1) << 4)
        x0 := x[x_off + j]
        x1 := x[x_off + 16 + j]
        sq += f32(q0) * x0 + f32(q1) * x1
        sx += x0 + x1
    }
    << d * sq + m * sx
}

pub fn dot_q5_1_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q5_1_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q5_1 row")
    }
    need_x := n_blocks * GGML_BLOCK_VALUES
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q5_1 input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q5_1_BYTES
        d := (F16{bits: u16(((*storage)[offset] & 255) | (((*storage)[offset + 1] & 255) << 8))}).to_f32()
        m := (F16{bits: u16(((*storage)[offset + 2] & 255) | (((*storage)[offset + 3] & 255) << 8))}).to_f32()
        qh := scalar_bits_le(storage, offset + 4, 4)
        qs_off := offset + 8
        xb := x_off + b * GGML_BLOCK_VALUES
        $sq := f32(0)
        $sx := f32(0)
        for j in 0:16 {
            bv := (*storage)[qs_off + j] & 255
            q0 := (bv & 15) | (((qh >> j) & 1) << 4)
            q1 := ((bv >> 4) & 15) | (((qh >> (j + 16)) & 1) << 4)
            x0 := x[xb + j]
            x1 := x[xb + 16 + j]
            sq += f32(q0) * x0 + f32(q1) * x1
            sx += x0 + x1
        }
        total += d * sq + m * sx
    }
    << total
}

pub fn read_q2_k(storage &string, offset int) Q2KBlock {
    check_block(storage, offset, Q2_K_BYTES) >>>
    $scales := [16]u8{}
    for i in 0:16 { scales[i] = u8(storage[offset + i]) }
    $qs := [64]u8{}
    for i in 0:64 { qs[i] = u8(storage[offset + 16 + i]) }
    d := F16{bits: u16(scalar_bits_le(storage, offset + 80, 2))}
    dmin := F16{bits: u16(scalar_bits_le(storage, offset + 82, 2))}
    << Q2KBlock{scales: scales, qs: qs, d: d, dmin: dmin}
}

pub fn (block &Q2KBlock) append_f32(out $&[]f32) {
    d := block.d.to_f32()
    dmin := block.dmin.to_f32()
    $is_idx := 0
    for n in 0:2 {
        q_off := n * 32
        for j in 0:4 {
            shift := j * 2
            sc0 := int(block.scales[is_idx])
            is_idx += 1
            dl0 := d * f32(sc0 & 15)
            ml0 := dmin * f32(sc0 >> 4)
            for l in 0:16 {
                q := (int(block.qs[q_off + l]) >> shift) & 3
                out.push(dl0 * f32(q) - ml0)
            }
            sc1 := int(block.scales[is_idx])
            is_idx += 1
            dl1 := d * f32(sc1 & 15)
            ml1 := dmin * f32(sc1 >> 4)
            for l in 0:16 {
                q := (int(block.qs[q_off + 16 + l]) >> shift) & 3
                out.push(dl1 * f32(q) - ml1)
            }
        }
    }
}

pub fn dot_q2_k_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q2_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q2_K row")
    }
    need_x := n_blocks * QK_K
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q2_K input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q2_K_BYTES
        d := (F16{bits: u16(((*storage)[offset + 80] & 255) | (((*storage)[offset + 81] & 255) << 8))}).to_f32()
        dmin := (F16{bits: u16(((*storage)[offset + 82] & 255) | (((*storage)[offset + 83] & 255) << 8))}).to_f32()
        $is_idx := 0
        $y_off := x_off + b * QK_K
        $sum := f32(0)
        for n in 0:2 {
            q_off := offset + 16 + n * 32
            for j in 0:4 {
                shift := j * 2
                sc0 := (*storage)[offset + is_idx] & 255
                is_idx += 1
                dl0 := d * f32(sc0 & 15)
                ml0 := dmin * f32((sc0 >> 4) & 15)
                $sq0 := f32(0)
                $sx0 := f32(0)
                for l in 0:16 {
                    q := (((*storage)[q_off + l] & 255) >> shift) & 3
                    xv := x[y_off + l]
                    sq0 += f32(q) * xv
                    sx0 += xv
                }
                sum += dl0 * sq0 - ml0 * sx0
                y_off += 16

                sc1 := (*storage)[offset + is_idx] & 255
                is_idx += 1
                dl1 := d * f32(sc1 & 15)
                ml1 := dmin * f32((sc1 >> 4) & 15)
                $sq1 := f32(0)
                $sx1 := f32(0)
                for l in 0:16 {
                    q := (((*storage)[q_off + 16 + l] & 255) >> shift) & 3
                    xv := x[y_off + l]
                    sq1 += f32(q) * xv
                    sx1 += xv
                }
                sum += dl1 * sq1 - ml1 * sx1
                y_off += 16
            }
        }
        total += sum
    }
    << total
}

pub fn dot_q2_k_q8_k_row_f32(storage &string, row_off int, q8_qs &[]i8, q8_d &[]f32, q8_bsums &[]int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q2_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q2_K row")
    }
    need_x := n_blocks * QK_K
    if q8_qs.len < need_x || q8_d.len < n_blocks || q8_bsums.len < n_blocks * 16 {
        >>> errors.new("Q8_K activation out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q2_K_BYTES
        d := (F16{bits: u16(((*storage)[offset + 80] & 255) | (((*storage)[offset + 81] & 255) << 8))}).to_f32()
        dmin := (F16{bits: u16(((*storage)[offset + 82] & 255) | (((*storage)[offset + 83] & 255) << 8))}).to_f32()
        $isum := 0
        $sum_m := 0
        $is_idx := 0
        $y_off := b * QK_K
        $bs_off := b * 16
        for n in 0:2 {
            q_off := offset + 16 + n * 32
            for j in 0:4 {
                shift := j * 2
                sc0 := (*storage)[offset + is_idx] & 255
                sum_m += ((sc0 >> 4) & 15) * q8_bsums[bs_off]
                bs_off += 1
                $iq0 := 0
                for l in 0:16 {
                    q := (((*storage)[q_off + l] & 255) >> shift) & 3
                    iq0 += q * int(q8_qs[y_off + l])
                }
                isum += (sc0 & 15) * iq0
                is_idx += 1
                y_off += 16

                sc1 := (*storage)[offset + is_idx] & 255
                sum_m += ((sc1 >> 4) & 15) * q8_bsums[bs_off]
                bs_off += 1
                $iq1 := 0
                for l in 0:16 {
                    q := (((*storage)[q_off + 16 + l] & 255) >> shift) & 3
                    iq1 += q * int(q8_qs[y_off + l])
                }
                isum += (sc1 & 15) * iq1
                is_idx += 1
                y_off += 16
            }
        }
        total += q8_d[b] * (d * f32(isum) - dmin * f32(sum_m))
    }
    << total
}

fn q3_k_scale_at(storage &string, sc_off int, idx int) int {
    $raw := 0
    if idx < 4 {
        raw = ((*storage)[sc_off + idx] & 15) | (((*storage)[sc_off + 8 + idx] & 3) << 4)
    } else if idx < 8 {
        raw = ((*storage)[sc_off + idx] & 15) | ((((*storage)[sc_off + 4 + idx] >> 2) & 3) << 4)
    } else if idx < 12 {
        raw = (((*storage)[sc_off + idx - 8] >> 4) & 15) | ((((*storage)[sc_off + idx] >> 4) & 3) << 4)
    } else {
        raw = (((*storage)[sc_off + idx - 8] >> 4) & 15) | ((((*storage)[sc_off + idx - 4] >> 6) & 3) << 4)
    }
    << raw - 32
}

pub fn read_q3_k(storage &string, offset int) Q3KBlock {
    check_block(storage, offset, Q3_K_BYTES) >>>
    $hmask := [32]u8{}
    for i in 0:32 { hmask[i] = u8(storage[offset + i]) }
    $qs := [64]u8{}
    for i in 0:64 { qs[i] = u8(storage[offset + 32 + i]) }
    $scales := [12]u8{}
    for i in 0:12 { scales[i] = u8(storage[offset + 96 + i]) }
    d := F16{bits: u16(scalar_bits_le(storage, offset + 108, 2))}
    << Q3KBlock{hmask: hmask, qs: qs, scales: scales, d: d}
}

pub fn (block &Q3KBlock) append_f32(out $&[]f32) {
    d := block.d.to_f32()
    $m := 1
    $is_idx := 0
    for n in 0:2 {
        q_off := n * 32
        for j in 0:4 {
            shift := j * 2
            $sc0 := 0
            if is_idx < 4 { sc0 = (int(block.scales[is_idx]) & 15) | ((int(block.scales[8 + is_idx]) & 3) << 4) }
            else if is_idx < 8 { sc0 = (int(block.scales[is_idx]) & 15) | (((int(block.scales[4 + is_idx]) >> 2) & 3) << 4) }
            else if is_idx < 12 { sc0 = ((int(block.scales[is_idx - 8]) >> 4) & 15) | (((int(block.scales[is_idx]) >> 4) & 3) << 4) }
            else { sc0 = ((int(block.scales[is_idx - 8]) >> 4) & 15) | (((int(block.scales[is_idx - 4]) >> 6) & 3) << 4) }
            dl0 := d * f32(sc0 - 32)
            is_idx += 1
            for l in 0:16 {
                $q := (int(block.qs[q_off + l]) >> shift) & 3
                if (int(block.hmask[l]) & m) == 0 { q -= 4 }
                out.push(dl0 * f32(q))
            }
            $sc1 := 0
            if is_idx < 4 { sc1 = (int(block.scales[is_idx]) & 15) | ((int(block.scales[8 + is_idx]) & 3) << 4) }
            else if is_idx < 8 { sc1 = (int(block.scales[is_idx]) & 15) | (((int(block.scales[4 + is_idx]) >> 2) & 3) << 4) }
            else if is_idx < 12 { sc1 = ((int(block.scales[is_idx - 8]) >> 4) & 15) | (((int(block.scales[is_idx]) >> 4) & 3) << 4) }
            else { sc1 = ((int(block.scales[is_idx - 8]) >> 4) & 15) | (((int(block.scales[is_idx - 4]) >> 6) & 3) << 4) }
            dl1 := d * f32(sc1 - 32)
            is_idx += 1
            for l in 0:16 {
                $q := (int(block.qs[q_off + 16 + l]) >> shift) & 3
                if (int(block.hmask[16 + l]) & m) == 0 { q -= 4 }
                out.push(dl1 * f32(q))
            }
            m = m << 1
        }
    }
}

pub fn dot_q3_k_row_f32(storage &string, row_off int, x &[]f32, x_off int, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q3_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q3_K row")
    }
    need_x := n_blocks * QK_K
    if x_off < 0 || x_off > x.len || need_x > x.len - x_off {
        >>> errors.new("Q3_K input vector out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q3_K_BYTES
        d := (F16{bits: u16(((*storage)[offset + 108] & 255) | (((*storage)[offset + 109] & 255) << 8))}).to_f32()
        sc_off := offset + 96
        $m := 1
        $is_idx := 0
        $y_off := x_off + b * QK_K
        $sum := f32(0)
        for n in 0:2 {
            q_off := offset + 32 + n * 32
            for j in 0:4 {
                shift := j * 2
                dl0 := d * f32(q3_k_scale_at(storage, sc_off, is_idx))
                is_idx += 1
                $sq0 := f32(0)
                for l in 0:16 {
                    $q := (((*storage)[q_off + l] & 255) >> shift) & 3
                    if (((*storage)[offset + l] & 255) & m) == 0 { q -= 4 }
                    sq0 += f32(q) * x[y_off + l]
                }
                sum += dl0 * sq0
                y_off += 16

                dl1 := d * f32(q3_k_scale_at(storage, sc_off, is_idx))
                is_idx += 1
                $sq1 := f32(0)
                for l in 0:16 {
                    $q := (((*storage)[q_off + 16 + l] & 255) >> shift) & 3
                    if (((*storage)[offset + 16 + l] & 255) & m) == 0 { q -= 4 }
                    sq1 += f32(q) * x[y_off + l]
                }
                sum += dl1 * sq1
                y_off += 16
                m = m << 1
            }
        }
        total += sum
    }
    << total
}

pub fn dot_q3_k_q8_k_row_f32(storage &string, row_off int, q8_qs &[]i8, q8_d &[]f32, n_blocks int) f32 {
    if n_blocks <= 0 { << f32(0) }
    need_bytes := n_blocks * Q3_K_BYTES
    if row_off < 0 || row_off > storage.len || need_bytes > storage.len - row_off {
        >>> errors.new("truncated Q3_K row")
    }
    need_x := n_blocks * QK_K
    if q8_qs.len < need_x || q8_d.len < n_blocks {
        >>> errors.new("Q8_K activation out of bounds")
    }
    $total := f32(0)
    for b in 0:n_blocks {
        offset := row_off + b * Q3_K_BYTES
        d := (F16{bits: u16(((*storage)[offset + 108] & 255) | (((*storage)[offset + 109] & 255) << 8))}).to_f32()
        sc_off := offset + 96
        $m := 1
        $is_idx := 0
        $y_off := b * QK_K
        $isum := 0
        for n in 0:2 {
            q_off := offset + 32 + n * 32
            for j in 0:4 {
                shift := j * 2
                sc0 := q3_k_scale_at(storage, sc_off, is_idx)
                is_idx += 1
                $iq0 := 0
                for l in 0:16 {
                    $q := (((*storage)[q_off + l] & 255) >> shift) & 3
                    if (((*storage)[offset + l] & 255) & m) == 0 { q -= 4 }
                    iq0 += q * int(q8_qs[y_off + l])
                }
                isum += sc0 * iq0
                y_off += 16

                sc1 := q3_k_scale_at(storage, sc_off, is_idx)
                is_idx += 1
                $iq1 := 0
                for l in 0:16 {
                    $q := (((*storage)[q_off + 16 + l] & 255) >> shift) & 3
                    if (((*storage)[offset + 16 + l] & 255) & m) == 0 { q -= 4 }
                    iq1 += q * int(q8_qs[y_off + l])
                }
                isum += sc1 * iq1
                y_off += 16
                m = m << 1
            }
        }
        total += d * q8_d[b] * f32(isum)
    }
    << total
}
