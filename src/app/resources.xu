@app

#os
#strings
#errors

fn validate_path(relative &string) int {
    if relative.len == 0 || relative.len > 240 { >>> errors.new("app: invalid relative path") }
    parts := strings.split(relative, "/")
    for part in parts {
        if part.len == 0 || part == "." || part == ".." { >>> errors.new("app: invalid path segment") }
        for i in 0:part.len {
            c := part[i]
            if !((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46) {
                >>> errors.new("app: paths accept ASCII letters, digits, slash, dot, dash and underscore")
            }
        }
    }
    << 0
}
// A portable relative path inside the game profile's packaged resources.
pub fn resource_path(relative string) string {
    validate_path(&relative) >>>
    root := os.getenv("XU_PHONE_RESOURCE_ROOT")
    if root.len == 0 { >>> errors.new("app: resource_path requires a Phone game resource root") }
    << root + "/" + relative
}
// The host creates an app-private writable root. Subdirectories are explicit
// caller-owned paths; this function validates/joins and does not create them.
pub fn data_path(relative string) string {
    validate_path(&relative) >>>
    root := os.getenv("XU_PHONE_DATA_ROOT")
    if root.len == 0 { >>> errors.new("app: data_path requires a Phone game data root") }
    << root + "/" + relative
}
