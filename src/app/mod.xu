@app

#errors
#ffi

const SLOT_APP = 1
const OFF_INIT = 0
const OFF_NEXT_FRAME = 8
const OFF_RESUME_EPOCH = 16
const OFF_IS_HOSTED = 24
const OFF_TRAP_BACK = 32
const APP_BLOB_SIZE = 40

extern "C" fn app_cstr_call(fn_ptr c_ptr, a c_int) c_int = dynamic
extern "C" fn app_call_i32(fn_ptr c_ptr) c_int = dynamic
extern "C" fn app_call_i64(fn_ptr c_ptr) c_long = dynamic

fn app_state() c_ptr {
    unsafe {
        $p := ffi.process_get(SLOT_APP)
        if !ffi.is_null(p) { << p }
        p = ffi.calloc(APP_BLOB_SIZE)
        if ffi.is_null(p) { << ffi.null() }
        $lib := ffi.null()
        if xu_target_os() == 0 {
            lib = c_ptr(0 - 2)
        } else if xu_target_os() == 1 {
            s_probe := "xu_phone_game_is_hosted"
            if ffi.is_null(ffi.dlsym(lib, &s_probe)) {
                so := "libmain.so"
                h := ffi.dlopen_local(&so)
                if !ffi.is_null(h) { lib = h }
            }
        }
        s_next := "xu_phone_game_next_frame"
        s_epoch := "xu_phone_game_resume_epoch"
        s_host := "xu_phone_game_is_hosted"
        s_back := "xu_phone_game_set_trap_back"
        ffi.write_ptr(p, OFF_NEXT_FRAME, ffi.dlsym(lib, &s_next))
        ffi.write_ptr(p, OFF_RESUME_EPOCH, ffi.dlsym(lib, &s_epoch))
        ffi.write_ptr(p, OFF_IS_HOSTED, ffi.dlsym(lib, &s_host))
        ffi.write_ptr(p, OFF_TRAP_BACK, ffi.dlsym(lib, &s_back))
        ffi.write_i64(p, OFF_INIT, 1)
        ffi.process_set(SLOT_APP, p)
        << p
    }
}

// Suspend this application on its own stack until the host requests a frame.
// Local owners remain alive; false requests normal unwinding and shutdown.
// Calling without a Phone game host throws instead of starting a private loop.
pub fn next_frame() bool {
    unsafe {
        p := app_state()
        if ffi.is_null(p) { >>> errors.new("app: next_frame requires an active Phone game host") }
        hosted_fn := ffi.read_ptr(p, OFF_IS_HOSTED)
        next_fn := ffi.read_ptr(p, OFF_NEXT_FRAME)
        if ffi.is_null(hosted_fn) || ffi.is_null(next_fn) || app_call_i32(hosted_fn) == i32(0) {
            >>> errors.new("app: next_frame requires an active Phone game host")
        }
        status := int(app_call_i32(next_fn))
        if status < 0 { >>> errors.new("app: next_frame requires an active Phone game host") }
        << status != 0
    }
}

// Changes after returning from the background. Reset frame-clock accumulation
// when this changes; elapsed background time is not simulation time.
pub fn resume_epoch() int {
    unsafe {
        p := app_state()
        if ffi.is_null(p) { << 0 }
        fn_ptr := ffi.read_ptr(p, OFF_RESUME_EPOCH)
        if ffi.is_null(fn_ptr) { << 0 }
        << int(app_call_i64(fn_ptr))
    }
}

// Reports whether an active Phone game host owns the current execution stack.
pub fn is_hosted() bool {
    unsafe {
        p := app_state()
        if ffi.is_null(p) { << false }
        fn_ptr := ffi.read_ptr(p, OFF_IS_HOSTED)
        if ffi.is_null(fn_ptr) { << false }
        << app_call_i32(fn_ptr) != i32(0)
    }
}

// When enabled on Android, system Back delivers EVENT_BACK_REQUESTED instead
// of closing the Activity immediately.
pub fn intercept_back(enabled bool) int {
    unsafe {
        p := app_state()
        if ffi.is_null(p) { << 0 }
        fn_ptr := ffi.read_ptr(p, OFF_TRAP_BACK)
        if ffi.is_null(fn_ptr) { << 0 }
        $flag := i32(0)
        if enabled { flag = i32(1) }
        if int(app_cstr_call(fn_ptr, flag)) < 0 {
            >>> errors.new("app: failed to configure back interception")
        }
        << 0
    }
}
