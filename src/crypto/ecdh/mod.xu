@crypto/ecdh

#crypto/rand
#crypto/subtle
#errors
#math/big

// Go `crypto/ecdh`: Curve, PrivateKey, PublicKey, X25519.
// Implements RFC 7748 Curve25519 / X25519 Montgomery ladder scalar multiplication.
//
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only
// Curve arithmetic uses math/big; operations are variable-time with fixed sizes.

pub const X25519_KEY_SIZE = 32

pub struct Curve {
    pub name string
}

pub fn x25519() Curve {
    << Curve{name: "X25519"}
}

pub struct PublicKey {
    pub curve Curve
    pub raw string
}

pub fn (k &PublicKey) bytes() string {
    << k.raw + ""
}

pub fn (k &PublicKey) equal(other &PublicKey) bool {
    if k.curve.name != other.curve.name {
        << false
    }
    raw1 := k.raw + ""
    raw2 := other.raw + ""
    << subtle.constant_time_compare(&raw1, &raw2) == 1
}

pub struct PrivateKey {
    pub curve Curve
    pub raw string
    pub pub_key PublicKey
}

pub fn (k &PrivateKey) bytes() string {
    << k.raw + ""
}

pub fn (k &PrivateKey) public_key() PublicKey {
    << PublicKey{curve: Curve{name: k.curve.name + ""}, raw: k.pub_key.raw + ""}
}

pub fn (k &PrivateKey) equal(other &PrivateKey) bool {
    if k.curve.name != other.curve.name {
        << false
    }
    raw1 := k.raw + ""
    raw2 := other.raw + ""
    << subtle.constant_time_compare(&raw1, &raw2) == 1
}

fn fe_p() big.Int {
    $z := big.new_int(0)
    $abs := []int{}
    abs.push(2147483629)
    for i in 0:7 {
        abs.push(2147483647)
    }
    abs.push(127)
    z.abs = abs
    << z
}

fn fe_mod(x &big.Int, p &big.Int) big.Int {
    $z := big.new_int(0)
    z.mod(x, p) or >>
    << z
}

fn fe_add(a &big.Int, b &big.Int, p &big.Int) big.Int {
    $z := big.new_int(0)
    z.add(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_sub(a &big.Int, b &big.Int, p &big.Int) big.Int {
    $z := big.new_int(0)
    z.sub(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_mul(a &big.Int, b &big.Int, p &big.Int) big.Int {
    $z := big.new_int(0)
    z.mul(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_sq(a &big.Int, p &big.Int) big.Int {
    $z := big.new_int(0)
    z.mul(a, a)
    << fe_mod(&z, p) or >>
}

fn fe_inv(a &big.Int, p &big.Int) big.Int {
    $two := big.new_int(2)
    $e := big.new_int(0)
    e.sub(p, &two)
    $z := big.new_int(0)
    z.exp(a, &e, p) or >>
    << z
}

fn from_le(s string) big.Int {
    $tmp := []int{}
    $i := s.len
    while i > 0 {
        i = i - 1
        tmp.push(s[i] & 255)
    }
    $z := big.new_int(0)
    z.set_bytes(string_from_bytes(tmp))
    << z
}

fn to_le32(x &big.Int) string {
    be := x.bytes()
    $tmp := []int{}
    for i in 0:32 {
        tmp.push(0)
    }
    $i := 0
    while i < be.len && i < 32 {
        tmp[i] = be[be.len - 1 - i] & 255
        i = i + 1
    }
    << string_from_bytes(tmp)
}

fn int_clone(x &big.Int) big.Int {
    $z := big.new_int(0)
    z.set(x)
    << z
}

pub fn base_point() string {
    $b := []int{}
    b.push(9)
    for i in 1:32 {
        b.push(0)
    }
    << string_from_bytes(b)
}

fn clamp_scalar(k &string) string {
    $b := []int{}
    for i in 0:32 {
        b.push(k[i] & 255)
    }
    b[0] = b[0] & 248
    b[31] = (b[31] & 127) | 64
    << string_from_bytes(b)
}

fn mask_point(u &string) string {
    $b := []int{}
    for i in 0:32 {
        b.push(u[i] & 255)
    }
    b[31] = b[31] & 127
    << string_from_bytes(b)
}

fn is_all_zero(b &string) bool {
    $i := 0
    while i < b.len {
        if (b[i] & 255) != 0 {
            << false
        }
        i = i + 1
    }
    << true
}

// scalar_mult computes the X25519 scalar multiplication of point u by scalar k
// using the Montgomery ladder per RFC 7748 §5.
pub fn scalar_mult(scalar &string, point &string) string {
    if scalar.len != 32 || point.len != 32 {
        >> errors.new("crypto/ecdh: key size must be 32 bytes")
    }
    k := clamp_scalar(scalar)
    u := mask_point(point)

    x1 := from_le(u)
    $x2 := big.new_int(1)
    $z2 := big.new_int(0)
    $x3 := int_clone(&x1)
    $z3 := big.new_int(1)

    $swap := 0
    $big_a24 := big.new_int(121665)
    pmod := fe_p()

    $t := 254
    while t >= 0 {
        byte_idx := t / 8
        bit_idx := t % 8
        kt := ((k[byte_idx] & 255) >> bit_idx) & 1
        swap = swap ^ kt
        if swap != 0 {
            tmp_x := int_clone(&x2)
            x2 = int_clone(&x3)
            x3 = tmp_x
            tmp_z := int_clone(&z2)
            z2 = int_clone(&z3)
            z3 = tmp_z
        }
        swap = kt

        a := fe_add(&x2, &z2, &pmod) or >>
        aa := fe_sq(&a, &pmod) or >>
        b := fe_sub(&x2, &z2, &pmod) or >>
        bb := fe_sq(&b, &pmod) or >>
        e := fe_sub(&aa, &bb, &pmod) or >>
        c := fe_add(&x3, &z3, &pmod) or >>
        d := fe_sub(&x3, &z3, &pmod) or >>
        da := fe_mul(&d, &a, &pmod) or >>
        cb := fe_mul(&c, &b, &pmod) or >>
        da_plus_cb := fe_add(&da, &cb, &pmod) or >>
        x3 = fe_sq(&da_plus_cb, &pmod) or >>
        da_minus_cb := fe_sub(&da, &cb, &pmod) or >>
        da_minus_cb_sq := fe_sq(&da_minus_cb, &pmod) or >>
        z3 = fe_mul(&x1, &da_minus_cb_sq, &pmod) or >>
        x2 = fe_mul(&aa, &bb, &pmod) or >>
        a24_e := fe_mul(&big_a24, &e, &pmod) or >>
        aa_plus_a24_e := fe_add(&aa, &a24_e, &pmod) or >>
        z2 = fe_mul(&e, &aa_plus_a24_e, &pmod) or >>

        t = t - 1
    }

    if swap != 0 {
        tmp_x := int_clone(&x2)
        x2 = int_clone(&x3)
        x3 = tmp_x
        tmp_z := int_clone(&z2)
        z2 = int_clone(&z3)
        z3 = tmp_z
    }

    z2_inv := fe_inv(&z2, &pmod) or >>
    out_x := fe_mul(&x2, &z2_inv, &pmod) or >>
    << to_le32(&out_x)
}

pub fn new_public_key(c Curve, key &string) PublicKey {
    if c.name != "X25519" {
        >> errors.new("crypto/ecdh: unsupported curve")
    }
    if key.len != X25519_KEY_SIZE {
        >> errors.new("crypto/ecdh: invalid public key length")
    }
    raw := key + ""
    << PublicKey{curve: c, raw: raw}
}

pub fn new_private_key(c Curve, key &string) PrivateKey {
    if c.name != "X25519" {
        >> errors.new("crypto/ecdh: unsupported curve")
    }
    if key.len != X25519_KEY_SIZE {
        >> errors.new("crypto/ecdh: invalid private key length")
    }
    raw := key + ""
    bp := base_point()
    pub_raw := scalar_mult(&raw, &bp) or >>
    pub_key := PublicKey{curve: Curve{name: c.name + ""}, raw: pub_raw}
    << PrivateKey{curve: c, raw: raw, pub_key: pub_key}
}

pub fn generate_key(c Curve) PrivateKey {
    if c.name != "X25519" {
        >> errors.new("crypto/ecdh: unsupported curve")
    }
    raw := rand.read(X25519_KEY_SIZE) or >>
    << new_private_key(c, &raw) or >>
}

// ecdh performs the Diffie-Hellman key exchange per RFC 7748.
pub fn (k &PrivateKey) ecdh(remote &PublicKey) string {
    if k.curve.name != remote.curve.name {
        >> errors.new("crypto/ecdh: curves do not match")
    }
    shared := scalar_mult(&k.raw, &remote.raw) or >>
    if is_all_zero(&shared) {
        >> errors.new("crypto/ecdh: bad input point")
    }
    << shared
}
