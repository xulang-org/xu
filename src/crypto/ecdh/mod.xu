@crypto/ecdh

#crypto/rand
#crypto/subtle
#errors

// Go `crypto/ecdh`: Curve, PrivateKey, PublicKey, X25519.
// Implements RFC 7748 Curve25519 / X25519 Montgomery ladder scalar multiplication.
//
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only
// Curve arithmetic uses math/big; operations are variable-time with fixed sizes.

pub const X25519_KEY_SIZE = 32

pub struct Curve {
    pub name string
}

pub fn x25519() Curve {
    << Curve{name: "X25519"}
}

pub struct PublicKey {
    pub curve Curve
    pub raw string
}

pub fn (k &PublicKey) bytes() string {
    << k.raw + ""
}

pub fn (k &PublicKey) equal(other &PublicKey) bool {
    if k.curve.name != other.curve.name {
        << false
    }
    raw1 := k.raw + ""
    raw2 := other.raw + ""
    << subtle.constant_time_compare(&raw1, &raw2) == 1
}

pub struct PrivateKey {
    pub curve Curve
    pub raw string
    pub pub_key PublicKey
}

pub fn (k &PrivateKey) bytes() string {
    << k.raw + ""
}

pub fn (k &PrivateKey) public_key() PublicKey {
    << PublicKey{curve: Curve{name: k.curve.name + ""}, raw: k.pub_key.raw + ""}
}

pub fn (k &PrivateKey) equal(other &PrivateKey) bool {
    if k.curve.name != other.curve.name {
        << false
    }
    raw1 := k.raw + ""
    raw2 := other.raw + ""
    << subtle.constant_time_compare(&raw1, &raw2) == 1
}

fn fe_zero() []int {
    $o := []int{}
    for _ in 0:16 {
        o.push(0)
    }
    << o
}

fn fe_one() []int {
    $o := fe_zero()
    o[0] = 1
    << o
}

fn fe_clone(a &[]int) []int {
    $o := []int{}
    for i in 0:16 {
        o.push(a[i])
    }
    << o
}

fn fe_carry(o $&[]int) {
    for i in 0:16 {
        c := o[i] >> 16
        o[i] = o[i] & 65535
        if i < 15 {
            o[i + 1] = o[i + 1] + c
        } else {
            o[0] = o[0] + 38 * c
        }
    }
}

fn fe_add(a &[]int, b &[]int) []int {
    $o := []int{}
    for i in 0:16 {
        o.push(a[i] + b[i])
    }
    fe_carry($&o)
    << o
}

fn fe_sub(a &[]int, b &[]int) []int {
    // Add 4*p so every limb stays strictly non-negative before arithmetic carry.
    $o := []int{}
    o.push(a[0] + 262068 - b[0])
    for i in 1:15 {
        o.push(a[i] + 262140 - b[i])
    }
    o.push(a[15] + 131068 - b[15])
    fe_carry($&o)
    << o
}

fn fe_mul(a &[]int, b &[]int) []int {
    $t := []int{}
    for _ in 0:31 {
        t.push(0)
    }
    for i in 0:16 {
        ai := a[i]
        for j in 0:16 {
            t[i + j] = t[i + j] + ai * b[j]
        }
    }
    for i in 0:15 {
        t[i] = t[i] + 38 * t[i + 16]
    }
    $o := []int{}
    for i in 0:16 {
        o.push(t[i])
    }
    fe_carry($&o)
    fe_carry($&o)
    << o
}

fn fe_sq(a &[]int) []int {
    << fe_mul(a, a)
}

fn fe_mul_a24(a &[]int) []int {
    $o := []int{}
    for i in 0:16 {
        o.push(a[i] * 121665)
    }
    fe_carry($&o)
    fe_carry($&o)
    << o
}

fn fe_inv(z &[]int) []int {
    // p - 2 = 2^255 - 21 has binary 1 everywhere in [0..254] except bits 2 and 4.
    $c := fe_clone(z)
    $i := 253
    while i >= 0 {
        c = fe_sq(&c)
        if i != 2 && i != 4 {
            c = fe_mul(&c, z)
        }
        i = i - 1
    }
    << c
}

fn fe_from_le32(s &string) []int {
    $o := []int{}
    for i in 0:16 {
        lo := s[2 * i] & 255
        hi := s[2 * i + 1] & 255
        o.push(lo | (hi << 8))
    }
    o[15] = o[15] & 32767
    << o
}

fn fe_sub_p_if_ge(t $&[]int) {
    $p := []int{}
    p.push(65517)
    for _ in 1:15 {
        p.push(65535)
    }
    p.push(32767)
    $ge := true
    $k := 15
    while k >= 0 {
        if t[k] > p[k] {
            ge = true
            <-
        }
        if t[k] < p[k] {
            ge = false
            <-
        }
        k = k - 1
    }
    if !ge {
        <<
    }
    $borrow := 0
    for i in 0:16 {
        $v := t[i] - p[i] - borrow
        if v < 0 {
            v = v + 65536
            borrow = 1
        } else {
            borrow = 0
        }
        t[i] = v
    }
}

fn fe_to_le32(x &[]int) string {
    $t := fe_clone(x)
    fe_carry($&t)
    fe_carry($&t)
    c15 := t[15] >> 15
    if c15 > 0 {
        t[15] = t[15] & 32767
        t[0] = t[0] + 19 * c15
        fe_carry($&t)
    }
    fe_sub_p_if_ge($&t)
    fe_sub_p_if_ge($&t)
    $out := []int{}
    for i in 0:16 {
        v := t[i]
        out.push(v & 255)
        out.push((v >> 8) & 255)
    }
    << string_from_bytes(out)
}

pub fn base_point() string {
    $b := []int{}
    b.push(9)
    for i in 1:32 {
        b.push(0)
    }
    << string_from_bytes(b)
}

fn clamp_scalar(k &string) string {
    $b := []int{}
    for i in 0:32 {
        b.push(k[i] & 255)
    }
    b[0] = b[0] & 248
    b[31] = (b[31] & 127) | 64
    << string_from_bytes(b)
}

fn mask_point(u &string) string {
    $b := []int{}
    for i in 0:32 {
        b.push(u[i] & 255)
    }
    b[31] = b[31] & 127
    << string_from_bytes(b)
}

fn is_all_zero(b &string) bool {
    $i := 0
    while i < b.len {
        if (b[i] & 255) != 0 {
            << false
        }
        i = i + 1
    }
    << true
}

// scalar_mult computes the X25519 scalar multiplication of point u by scalar k
// using the Montgomery ladder per RFC 7748 §5.
pub fn scalar_mult(scalar &string, point &string) string {
    if scalar.len != 32 || point.len != 32 {
        >> errors.new("crypto/ecdh: key size must be 32 bytes")
    }
    k := clamp_scalar(scalar)
    u := mask_point(point)

    x1 := fe_from_le32(&u)
    $x2 := fe_one()
    $z2 := fe_zero()
    $x3 := fe_clone(&x1)
    $z3 := fe_one()

    $swap := 0
    $t := 254
    while t >= 0 {
        byte_idx := t / 8
        bit_idx := t % 8
        kt := ((k[byte_idx] & 255) >> bit_idx) & 1
        swap = swap ^ kt
        if swap != 0 {
            tmp_x := fe_clone(&x2)
            x2 = fe_clone(&x3)
            x3 = tmp_x
            tmp_z := fe_clone(&z2)
            z2 = fe_clone(&z3)
            z3 = tmp_z
        }
        swap = kt

        a := fe_add(&x2, &z2)
        aa := fe_sq(&a)
        b := fe_sub(&x2, &z2)
        bb := fe_sq(&b)
        e := fe_sub(&aa, &bb)
        c := fe_add(&x3, &z3)
        d := fe_sub(&x3, &z3)
        da := fe_mul(&d, &a)
        cb := fe_mul(&c, &b)
        da_plus_cb := fe_add(&da, &cb)
        x3 = fe_sq(&da_plus_cb)
        da_minus_cb := fe_sub(&da, &cb)
        da_minus_cb_sq := fe_sq(&da_minus_cb)
        z3 = fe_mul(&x1, &da_minus_cb_sq)
        x2 = fe_mul(&aa, &bb)
        a24_e := fe_mul_a24(&e)
        aa_plus_a24_e := fe_add(&aa, &a24_e)
        z2 = fe_mul(&e, &aa_plus_a24_e)

        t = t - 1
    }

    if swap != 0 {
        tmp_x := fe_clone(&x2)
        x2 = fe_clone(&x3)
        x3 = tmp_x
        tmp_z := fe_clone(&z2)
        z2 = fe_clone(&z3)
        z3 = tmp_z
    }

    z2_inv := fe_inv(&z2)
    out_x := fe_mul(&x2, &z2_inv)
    << fe_to_le32(&out_x)
}

pub fn new_public_key(c Curve, key &string) PublicKey {
    if c.name != "X25519" {
        >> errors.new("crypto/ecdh: unsupported curve")
    }
    if key.len != X25519_KEY_SIZE {
        >> errors.new("crypto/ecdh: invalid public key length")
    }
    raw := key + ""
    << PublicKey{curve: c, raw: raw}
}

pub fn new_private_key(c Curve, key &string) PrivateKey {
    if c.name != "X25519" {
        >> errors.new("crypto/ecdh: unsupported curve")
    }
    if key.len != X25519_KEY_SIZE {
        >> errors.new("crypto/ecdh: invalid private key length")
    }
    raw := key + ""
    bp := base_point()
    pub_raw := scalar_mult(&raw, &bp) >>>
    pub_key := PublicKey{curve: Curve{name: c.name + ""}, raw: pub_raw}
    << PrivateKey{curve: c, raw: raw, pub_key: pub_key}
}

pub fn generate_key(c Curve) PrivateKey {
    if c.name != "X25519" {
        >> errors.new("crypto/ecdh: unsupported curve")
    }
    raw := rand.read(X25519_KEY_SIZE) >>>
    << new_private_key(c, &raw) >>>
}

// ecdh performs the Diffie-Hellman key exchange per RFC 7748.
pub fn (k &PrivateKey) ecdh(remote &PublicKey) string {
    if k.curve.name != remote.curve.name {
        >> errors.new("crypto/ecdh: curves do not match")
    }
    shared := scalar_mult(&k.raw, &remote.raw) >>>
    if is_all_zero(&shared) {
        >> errors.new("crypto/ecdh: bad input point")
    }
    << shared
}
