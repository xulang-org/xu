@crypto/ecdsa

#errors
#crypto/sm2

// Go crypto/ecdsa verification subset. Public keys use SEC1 uncompressed
// P-256/P-384/P-521 form (0x04 || X || Y); signatures use ASN.1 DER
// SEQUENCE{r,s} or RFC 7515 fixed-width R||S raw format. The curve is
// selected explicitly for key generation and by canonical raw-key length for
// public/sign operations. Signing uses the platform-independent CSPRNG
// exposed by crypto/rand.
// XU-CT-CLASS: variable-time
// Point/scalar arithmetic is math/big based. ECDSA and ECDH therefore have no
// constant-time contract even where final equality uses crypto/subtle.

pub const PUBLIC_KEY_SIZE_P256 = 65
pub const PUBLIC_KEY_SIZE_P384 = 97
pub const PUBLIC_KEY_SIZE_P521 = 133
pub const PRIVATE_KEY_SIZE_P256 = 32
pub const PRIVATE_KEY_SIZE_P384 = 48
pub const PRIVATE_KEY_SIZE_P521 = 66
pub const P256 = 256
pub const P384 = 384
pub const P521 = 521

fn private_curve(private_key &string) int {
    if private_key.len == PRIVATE_KEY_SIZE_P256 { << P256 }
    if private_key.len == PRIVATE_KEY_SIZE_P384 { << P384 }
    if private_key.len == PRIVATE_KEY_SIZE_P521 { << P521 }
    >> errors.new("crypto/ecdsa: invalid private key length")
}

pub fn generate_key(curve int) string {
    if curve != P256 && curve != P384 && curve != P521 {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    << sm2.nist_generate_key(curve)
}

pub fn public(private_key &string) string {
    curve := private_curve(private_key) or >>
    << sm2.nist_public(curve, private_key)
}

// ecdh returns the fixed-width shared X coordinate for P-256/P-384/P-521.
// The curve is inferred from the private-key width and must match the peer
// SEC1 uncompressed public-key width.
pub fn ecdh(private_key &string, peer_public &string) string {
    curve := private_curve(private_key) or >>
    << sm2.nist_ecdh(curve, private_key, peer_public)
}

pub fn sign_asn1(private_key &string, hash &string) string {
    curve := private_curve(private_key) or >>
    << sm2.nist_sign_asn1(curve, private_key, hash)
}

pub fn sign_raw(private_key &string, hash &string) string {
    curve := private_curve(private_key) or >>
    << sm2.nist_sign_raw(curve, private_key, hash)
}

pub fn sign_raw_p256(private_key &string, hash &string) string {
    if private_key.len != PRIVATE_KEY_SIZE_P256 {
        >> errors.new("crypto/ecdsa: invalid P-256 private key length")
    }
    << sm2.nist_sign_raw(P256, private_key, hash)
}

pub fn verify_asn1(public_key &string, hash &string, signature &string) bool {
    if public_key.len == PUBLIC_KEY_SIZE_P256 {
        << sm2.verify_p256_asn1(public_key, hash, signature)
    }
    if public_key.len == PUBLIC_KEY_SIZE_P384 {
        << sm2.verify_p384_asn1(public_key, hash, signature)
    }
    if public_key.len == PUBLIC_KEY_SIZE_P521 {
        << sm2.verify_p521_asn1(public_key, hash, signature)
    }
    << false
}

pub fn verify_raw(public_key &string, hash &string, signature &string) bool {
    if public_key.len == PUBLIC_KEY_SIZE_P256 {
        << sm2.nist_verify_raw(P256, public_key, hash, signature)
    }
    if public_key.len == PUBLIC_KEY_SIZE_P384 {
        << sm2.nist_verify_raw(P384, public_key, hash, signature)
    }
    if public_key.len == PUBLIC_KEY_SIZE_P521 {
        << sm2.nist_verify_raw(P521, public_key, hash, signature)
    }
    << false
}

pub fn verify_raw_p256(public_key &string, hash &string, signature &string) bool {
    if public_key.len != PUBLIC_KEY_SIZE_P256 {
        << false
    }
    << sm2.nist_verify_raw(P256, public_key, hash, signature)
}
