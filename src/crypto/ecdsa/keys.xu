@crypto/ecdsa

#errors
#encoding/asn1
#encoding/pem
#crypto/subtle
#crypto/sm2

// XU-CT-USE: fixed-shape-only
// Public-key consistency comparison is narrow; the parent ECDSA/ECDH backend
// remains explicitly variable-time.
// RFC 5915 SEC1, RFC 5208 PKCS#8 and RFC 5280 SubjectPublicKeyInfo for
// named NIST curves. The public API returns the package's fixed-width raw
// private scalar or SEC1 uncompressed public point. Encrypted PEM and
// compressed points are intentionally not accepted.

fn key_oid_eq5(a &[]int, a0 int, a1 int, a2 int, a3 int, a4 int) bool {
    if a.len != 5 { << false }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3 && a[4] == a4
}

fn key_oid_eq6(a &[]int, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int) bool {
    if a.len != 6 { << false }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3 && a[4] == a4 && a[5] == a5
}

fn key_oid_eq7(a &[]int, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) bool {
    if a.len != 7 { << false }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3 && a[4] == a4 && a[5] == a5 && a[6] == a6
}

fn key_is_primitive(v &asn1.Value, tag int) bool {
    << v.class == asn1.CLASS_UNIVERSAL && v.constructed == 0 && v.tag == tag
}

fn key_is_sequence(v &asn1.Value) bool {
    << v.class == asn1.CLASS_UNIVERSAL && v.constructed != 0 && v.tag == asn1.TAG_SEQUENCE
}

fn key_ec_public_oid() []int {
    mut a := []int{}
    a.push(1)
    a.push(2)
    a.push(840)
    a.push(10045)
    a.push(2)
    a.push(1)
    << a
}

fn key_curve_oid(curve int) []int {
    mut a := []int{}
    if curve == P256 {
        a.push(1)
        a.push(2)
        a.push(840)
        a.push(10045)
        a.push(3)
        a.push(1)
        a.push(7)
    } else if curve == P384 {
        a.push(1)
        a.push(3)
        a.push(132)
        a.push(0)
        a.push(34)
    } else if curve == P521 {
        a.push(1)
        a.push(3)
        a.push(132)
        a.push(0)
        a.push(35)
    } else {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    << a
}

fn key_curve_from_oid(a &[]int) int {
    if key_oid_eq7(a, 1, 2, 840, 10045, 3, 1, 7) { << P256 }
    if key_oid_eq5(a, 1, 3, 132, 0, 34) { << P384 }
    if key_oid_eq5(a, 1, 3, 132, 0, 35) { << P521 }
    >> errors.new("crypto/ecdsa: unsupported named curve")
}

fn key_private_size(curve int) int {
    if curve == P256 { << PRIVATE_KEY_SIZE_P256 }
    if curve == P384 { << PRIVATE_KEY_SIZE_P384 }
    if curve == P521 { << PRIVATE_KEY_SIZE_P521 }
    << 0
}

fn key_public_size(curve int) int {
    if curve == P256 { << PUBLIC_KEY_SIZE_P256 }
    if curve == P384 { << PUBLIC_KEY_SIZE_P384 }
    if curve == P521 { << PUBLIC_KEY_SIZE_P521 }
    << 0
}

fn key_public_curve(public_key &string) int {
    if public_key.len == PUBLIC_KEY_SIZE_P256 { << P256 }
    if public_key.len == PUBLIC_KEY_SIZE_P384 { << P384 }
    if public_key.len == PUBLIC_KEY_SIZE_P521 { << P521 }
    >> errors.new("crypto/ecdsa: invalid public key length")
}

fn key_der_tlv(tag int, content &string) string {
    mut out := []int{}
    out.push(tag & 255)
    n := content.len
    if n < 128 {
        out.push(n)
    } else {
        mut rev := []int{}
        mut x := n
        while x > 0 {
            rev.push(x & 255)
            x = x / 256
        }
        out.push(128 + rev.len)
        mut i := rev.len
        while i > 0 {
            i = i - 1
            out.push(rev[i])
        }
    }
    for i in 0:content.len {
        out.push(content[i] & 255)
    }
    << string_from_bytes(out)
}

fn key_der_bit(public_key &string) string {
    content := string_from_byte(0) + (public_key + "")
    << key_der_tlv(asn1.TAG_BIT_STRING, &content)
}

fn key_der_context(tag int, inner &string) string {
    << key_der_tlv(160 + (tag & 31), inner)
}

fn key_parse_algorithm(alg &asn1.Value) int {
    if !key_is_sequence(alg) {
        >> errors.new("crypto/ecdsa: invalid key algorithm")
    }
    body := alg.bytes + ""
    mut d := asn1.new_decoder(&body)
    oidv := d.next() or >>
    if !key_is_primitive(&oidv, asn1.TAG_OID) {
        >> errors.new("crypto/ecdsa: invalid key algorithm")
    }
    arcs := oidv.as_oid() or >>
    if !key_oid_eq6(&arcs, 1, 2, 840, 10045, 2, 1) || d.done() {
        >> errors.new("crypto/ecdsa: invalid key algorithm")
    }
    curvev := d.next() or >>
    if !key_is_primitive(&curvev, asn1.TAG_OID) || !d.done() {
        >> errors.new("crypto/ecdsa: invalid key algorithm")
    }
    curve_arcs := curvev.as_oid() or >>
    << key_curve_from_oid(&curve_arcs)
}

fn key_pad_private(raw &string, curve int) string {
    size := key_private_size(curve)
    if size == 0 || raw.len == 0 || raw.len > size {
        >> errors.new("crypto/ecdsa: invalid private key")
    }
    mut out := []int{}
    for _ in 0:size - raw.len { out.push(0) }
    for i in 0:raw.len { out.push(raw[i] & 255) }
    fixed := string_from_bytes(out)
    _ := public(&fixed) or >>
    << fixed
}

fn key_parse_sec1(der &string, outer_curve int) string {
    seq := asn1.unmarshal(der) or >>
    if !key_is_sequence(&seq) || seq.rest.len != 0 {
        >> errors.new("crypto/ecdsa: invalid SEC1 private key")
    }
    body := seq.bytes + ""
    mut d := asn1.new_decoder(&body)
    vv := d.next() or >>
    if !key_is_primitive(&vv, asn1.TAG_INTEGER) {
        >> errors.new("crypto/ecdsa: invalid SEC1 private key")
    }
    ver := vv.as_int() or >>
    if ver != 1 {
        >> errors.new("crypto/ecdsa: invalid SEC1 private key")
    }
    ov := d.next() or >>
    if !key_is_primitive(&ov, asn1.TAG_OCTET_STRING) {
        >> errors.new("crypto/ecdsa: invalid SEC1 private key")
    }
    raw := ov.bytes + ""
    mut curve := outer_curve
    mut public_got := ""
    mut saw_curve := false
    mut saw_public := false
    while !d.done() {
        xv := d.next() or >>
        if xv.class != asn1.CLASS_CONTEXT || xv.constructed == 0 {
            >> errors.new("crypto/ecdsa: invalid SEC1 private key")
        }
        inner := xv.bytes + ""
        if xv.tag == 0 && !saw_curve && !saw_public {
            pv := asn1.unmarshal(&inner) or >>
            if !key_is_primitive(&pv, asn1.TAG_OID) || pv.rest.len != 0 {
                >> errors.new("crypto/ecdsa: invalid SEC1 curve")
            }
            arcs := pv.as_oid() or >>
            got := key_curve_from_oid(&arcs) or >>
            if curve != 0 && curve != got {
                >> errors.new("crypto/ecdsa: curve mismatch")
            }
            curve = got
            saw_curve = true
        } else if xv.tag == 1 && !saw_public {
            bv := asn1.unmarshal(&inner) or >>
            if !key_is_primitive(&bv, asn1.TAG_BIT_STRING) || bv.bytes.len == 0 || (bv.bytes[0] & 255) != 0 || bv.rest.len != 0 {
                >> errors.new("crypto/ecdsa: invalid SEC1 public key")
            }
            public_got = bv.as_bit_string() or >>
            saw_public = true
        } else {
            >> errors.new("crypto/ecdsa: invalid SEC1 private key")
        }
    }
    if curve == 0 {
        >> errors.new("crypto/ecdsa: SEC1 key missing named curve")
    }
    private_key := key_pad_private(&raw, curve) or >>
    if public_got.len != 0 {
        want := public(&private_key) or >>
        if subtle.constant_time_compare(&want, &public_got) != 1 {
            >> errors.new("crypto/ecdsa: SEC1 public key mismatch")
        }
    }
    << private_key
}

fn key_parse_pkcs8(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if !key_is_sequence(&seq) || seq.rest.len != 0 {
        >> errors.new("crypto/ecdsa: invalid PKCS#8 private key")
    }
    body := seq.bytes + ""
    mut d := asn1.new_decoder(&body)
    vv := d.next() or >>
    if !key_is_primitive(&vv, asn1.TAG_INTEGER) {
        >> errors.new("crypto/ecdsa: invalid PKCS#8 private key")
    }
    ver := vv.as_int() or >>
    if ver != 0 {
        >> errors.new("crypto/ecdsa: invalid PKCS#8 private key")
    }
    alg := d.next() or >>
    curve := key_parse_algorithm(&alg) or >>
    ov := d.next() or >>
    if !key_is_primitive(&ov, asn1.TAG_OCTET_STRING) || !d.done() {
        >> errors.new("crypto/ecdsa: invalid PKCS#8 private key")
    }
    inner := ov.bytes + ""
    << key_parse_sec1(&inner, curve)
}

pub fn parse_private_key(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if !key_is_sequence(&seq) || seq.rest.len != 0 {
        >> errors.new("crypto/ecdsa: invalid private key")
    }
    body := seq.bytes + ""
    mut d := asn1.new_decoder(&body)
    vv := d.next() or >>
    if !key_is_primitive(&vv, asn1.TAG_INTEGER) {
        >> errors.new("crypto/ecdsa: invalid private key")
    }
    ver := vv.as_int() or >>
    if ver == 0 { << key_parse_pkcs8(der) }
    if ver == 1 { << key_parse_sec1(der, 0) }
    >> errors.new("crypto/ecdsa: invalid private key version")
}

fn key_marshal_sec1_core(private_key &string, with_curve bool) string {
    curve := private_curve(private_key) or >>
    public_key := public(private_key) or >>
    v1 := asn1.marshal_int(1)
    oct := asn1.marshal_octet(private_key)
    bit := key_der_bit(&public_key)
    c1 := key_der_context(1, &bit)
    mut elems := []string{}
    elems.push(v1)
    elems.push(oct)
    if with_curve {
        arcs := key_curve_oid(curve) or >>
        oid := asn1.marshal_oid(&arcs) or >>
        c0 := key_der_context(0, &oid)
        elems.push(c0)
    }
    elems.push(c1)
    << asn1.marshal_seq(&elems)
}

pub fn marshal_sec1(private_key &string) string {
    << key_marshal_sec1_core(private_key, true)
}

pub fn marshal_pkcs8(private_key &string) string {
    curve := private_curve(private_key) or >>
    inner := key_marshal_sec1_core(private_key, false) or >>
    ver := asn1.marshal_int(0)
    ecp := key_ec_public_oid()
    co := key_curve_oid(curve) or >>
    eo := asn1.marshal_oid(&ecp) or >>
    curve_oid := asn1.marshal_oid(&co) or >>
    mut alg_elems := []string{}
    alg_elems.push(eo)
    alg_elems.push(curve_oid)
    alg := asn1.marshal_seq(&alg_elems)
    oct := asn1.marshal_octet(&inner)
    mut top := []string{}
    top.push(ver)
    top.push(alg)
    top.push(oct)
    << asn1.marshal_seq(&top)
}

pub fn parse_private_pem(text &string) string {
    b := pem.decode(text)
    typ := b.typ + ""
    if (typ != "PRIVATE KEY" && typ != "EC PRIVATE KEY") || b.keys.len != 0 {
        >> errors.new("crypto/ecdsa: invalid PEM type")
    }
    raw := b.bytes + ""
    << parse_private_key(&raw)
}

fn key_pem(typ string, der string) string {
    blk := pem.Block{typ: typ, keys: []string{}, vals: []string{}, bytes: der, rest: ""}
    << pem.encode_to_memory(&blk)
}

pub fn marshal_pkcs8_pem(private_key &string) string {
    der := marshal_pkcs8(private_key) or >>
    << key_pem("PRIVATE KEY", der)
}

pub fn marshal_sec1_pem(private_key &string) string {
    der := marshal_sec1(private_key) or >>
    << key_pem("EC PRIVATE KEY", der)
}

pub fn parse_public_key(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if !key_is_sequence(&seq) || seq.rest.len != 0 {
        >> errors.new("crypto/ecdsa: invalid PKIX public key")
    }
    body := seq.bytes + ""
    mut d := asn1.new_decoder(&body)
    alg := d.next() or >>
    curve := key_parse_algorithm(&alg) or >>
    keyv := d.next() or >>
    if !key_is_primitive(&keyv, asn1.TAG_BIT_STRING) || keyv.bytes.len == 0 || (keyv.bytes[0] & 255) != 0 || !d.done() {
        >> errors.new("crypto/ecdsa: invalid PKIX public key")
    }
    public_key := keyv.as_bit_string() or >>
    if public_key.len != key_public_size(curve) || (public_key[0] & 255) != 4 {
        >> errors.new("crypto/ecdsa: public key does not match named curve")
    }
    sm2.nist_check_public(curve, &public_key) or >>
    << public_key
}

pub fn marshal_pkix(public_key &string) string {
    curve := key_public_curve(public_key) or >>
    sm2.nist_check_public(curve, public_key) or >>
    ecp := key_ec_public_oid()
    co := key_curve_oid(curve) or >>
    eo := asn1.marshal_oid(&ecp) or >>
    curve_oid := asn1.marshal_oid(&co) or >>
    mut alg_elems := []string{}
    alg_elems.push(eo)
    alg_elems.push(curve_oid)
    alg := asn1.marshal_seq(&alg_elems)
    bit := key_der_bit(public_key)
    mut top := []string{}
    top.push(alg)
    top.push(bit)
    << asn1.marshal_seq(&top)
}

pub fn parse_public_pem(text &string) string {
    b := pem.decode(text)
    if b.typ != "PUBLIC KEY" || b.keys.len != 0 {
        >> errors.new("crypto/ecdsa: invalid PEM type")
    }
    raw := b.bytes + ""
    << parse_public_key(&raw)
}

pub fn marshal_pkix_pem(public_key &string) string {
    der := marshal_pkix(public_key) or >>
    << key_pem("PUBLIC KEY", der)
}
