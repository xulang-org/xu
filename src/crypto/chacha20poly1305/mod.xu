@crypto/chacha20poly1305

#crypto/rand
#crypto/subtle
#errors
#math/big

// Go `golang.org/x/crypto/chacha20poly1305`: ChaCha20-Poly1305 AEAD per RFC 8439.
// Key is 32 bytes, Nonce is 12 bytes, Tag is 16 bytes.
//
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only

pub const KEY_SIZE = 32
pub const NONCE_SIZE = 12
pub const TAG_SIZE = 16

pub struct AEAD {
    key string
}

pub fn new(key &string) AEAD {
    if key.len != KEY_SIZE {
        >> errors.new("crypto/chacha20poly1305: bad key length")
    }
    k := key + ""
    << AEAD{key: k}
}

fn rotl32(v int, r int) int {
    v32 := v & 4294967295
    shl := (v32 << r) & 4294967295
    shr := v32 >> (32 - r)
    << (shl | shr) & 4294967295
}

fn qr(s $&[]int, a int, b int, c int, d int) {
    $sa := (s[a] + s[b]) & 4294967295
    $sd := rotl32(s[d] ^ sa, 16)
    $sc := (s[c] + sd) & 4294967295
    $sb := rotl32(s[b] ^ sc, 12)
    sa = (sa + sb) & 4294967295
    sd = rotl32(sd ^ sa, 8)
    sc = (sc + sd) & 4294967295
    sb = rotl32(sb ^ sc, 7)
    s[a] = sa
    s[b] = sb
    s[c] = sc
    s[d] = sd
}

fn read_u32_le(s &string, off int) int {
    b0 := s[off] & 255
    b1 := s[off + 1] & 255
    b2 := s[off + 2] & 255
    b3 := s[off + 3] & 255
    << (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 4294967295
}

fn chacha20_block(key &string, counter int, nonce &string) string {
    $s := []int{}
    s.push(1634760805) // "expa" 0x61707865
    s.push(857760878)  // "nd 3" 0x3320646e
    s.push(2036477234) // "2-by" 0x79622d32
    s.push(1797285236) // "te k" 0x6b206574
    $i := 0
    while i < 8 {
        s.push(read_u32_le(key, i * 4))
        i = i + 1
    }
    s.push(counter & 4294967295)
    $k := 0
    while k < 3 {
        s.push(read_u32_le(nonce, k * 4))
        k = k + 1
    }

    $orig := []int{}
    for j in 0:16 {
        orig.push(s[j])
    }

    for rnd in 0:10 {
        qr($&s, 0, 4, 8, 12)
        qr($&s, 1, 5, 9, 13)
        qr($&s, 2, 6, 10, 14)
        qr($&s, 3, 7, 11, 15)

        qr($&s, 0, 5, 10, 15)
        qr($&s, 1, 6, 11, 12)
        qr($&s, 2, 7, 8, 13)
        qr($&s, 3, 4, 9, 14)
    }

    $out := []int{}
    for m in 0:16 {
        sum := (s[m] + orig[m]) & 4294967295
        out.push(sum & 255)
        out.push((sum >> 8) & 255)
        out.push((sum >> 16) & 255)
        out.push((sum >> 24) & 255)
    }
    << string_from_bytes(out)
}

fn chacha20_xor(key &string, counter int, nonce &string, src &string) string {
    $out := []int{}
    $off := 0
    $ctr := counter
    while off < src.len {
        blk := chacha20_block(key, ctr, nonce)
        $take := src.len - off
        if take > 64 {
            take = 64
        }
        for j in 0:take {
            out.push(((src[off + j] & 255) ^ (blk[j] & 255)) & 255)
        }
        off = off + take
        ctr = ctr + 1
    }
    << string_from_bytes(out)
}

fn from_le_n(s &string, off int, len int) big.Int {
    $tmp := []int{}
    $i := off + len
    while i > off {
        i = i - 1
        tmp.push(s[i] & 255)
    }
    $z := big.new_int(0)
    z.set_bytes(string_from_bytes(tmp))
    << z
}

fn poly1305_tag(key &string, data &string) string {
    $r_bytes := []int{}
    for i in 0:16 {
        r_bytes.push(key[i] & 255)
    }
    r_bytes[3] = r_bytes[3] & 15
    r_bytes[7] = r_bytes[7] & 15
    r_bytes[11] = r_bytes[11] & 15
    r_bytes[15] = r_bytes[15] & 15
    r_bytes[4] = r_bytes[4] & 252
    r_bytes[8] = r_bytes[8] & 252
    r_bytes[12] = r_bytes[12] & 252

    r_str := string_from_bytes(r_bytes)
    r := from_le_n(&r_str, 0, 16)
    s := from_le_n(key, 16, 16)

    $p := big.new_int(1)
    p.lsh(&p, 130)
    $five := big.new_int(5)
    p.sub(&p, &five)

    $a := big.new_int(0)
    $off := 0
    while off < data.len {
        $take := data.len - off
        if take > 16 {
            take = 16
        }
        $chunk := from_le_n(data, off, take)
        $hi := big.new_int(1)
        hi.lsh(&hi, take * 8)
        chunk.add(&chunk, &hi)

        a.add(&a, &chunk)
        a.mod(&a, &p) or >>
        a.mul(&a, &r)
        a.mod(&a, &p) or >>
        off = off + take
    }

    a.add(&a, &s)
    $mod128 := big.new_int(1)
    mod128.lsh(&mod128, 128)
    a.mod(&a, &mod128) or >>

    be := a.bytes()
    $tag := []int{}
    for m in 0:16 {
        tag.push(0)
    }
    $idx := 0
    while idx < be.len && idx < 16 {
        tag[idx] = be[be.len - 1 - idx] & 255
        idx = idx + 1
    }
    << string_from_bytes(tag)
}

fn u64_le(n int) string {
    $b := []int{}
    b.push(n & 255)
    b.push((n >> 8) & 255)
    b.push((n >> 16) & 255)
    b.push((n >> 24) & 255)
    b.push((n >> 32) & 255)
    b.push((n >> 40) & 255)
    b.push((n >> 48) & 255)
    b.push((n >> 56) & 255)
    << string_from_bytes(b)
}

fn pad16(n int) string {
    rem := n % 16
    if rem == 0 {
        << ""
    }
    need := 16 - rem
    $b := []int{}
    for i in 0:need {
        b.push(0)
    }
    << string_from_bytes(b)
}

// seal encrypts and authenticates plaintext with additional data using nonce.
// Returns ciphertext with 16-byte authentication tag appended.
pub fn (a &AEAD) seal(nonce &string, plaintext &string, additional_data &string) string {
    if nonce.len != NONCE_SIZE {
        >> errors.new("crypto/chacha20poly1305: bad nonce length")
    }
    key := a.key + ""
    otk_block := chacha20_block(&key, 0, nonce)
    poly_key := otk_block[0:32] + ""

    ct := chacha20_xor(&key, 1, nonce, plaintext)
    aad := additional_data + ""
    poly_data := aad + pad16(aad.len) + ct + pad16(ct.len) + u64_le(aad.len) + u64_le(ct.len)
    tag := poly1305_tag(&poly_key, &poly_data)
    << ct + tag
}

// open authenticates and decrypts ciphertext_and_tag using nonce and additional data.
pub fn (a &AEAD) open(nonce &string, ciphertext_and_tag &string, additional_data &string) string {
    if nonce.len != NONCE_SIZE {
        >> errors.new("crypto/chacha20poly1305: bad nonce length")
    }
    if ciphertext_and_tag.len < TAG_SIZE {
        >> errors.new("crypto/chacha20poly1305: message authentication failed")
    }
    key := a.key + ""
    otk_block := chacha20_block(&key, 0, nonce)
    poly_key := otk_block[0:32] + ""

    ct_len := ciphertext_and_tag.len - TAG_SIZE
    ct := ciphertext_and_tag[0:ct_len] + ""
    expected_tag := ciphertext_and_tag[ct_len:ciphertext_and_tag.len] + ""

    aad := additional_data + ""
    poly_data := aad + pad16(aad.len) + ct + pad16(ct.len) + u64_le(aad.len) + u64_le(ct.len)
    tag := poly1305_tag(&poly_key, &poly_data)

    if subtle.constant_time_compare(&tag, &expected_tag) != 1 {
        >> errors.new("crypto/chacha20poly1305: message authentication failed")
    }
    << chacha20_xor(&key, 1, nonce, &ct)
}
