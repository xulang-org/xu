@crypto/des


#errors
// DES and Triple DES (FIPS 46-3) aligned with Go `crypto/des`
// NewCipher / NewTripleDESCipher. Single 8-byte block encrypt/decrypt.
// Permutation tables use Go's lsb bit indices. IP/FP/E/P/S-box are
// parsed once in new_cipher and read by field index in crypt_block
// (licm; Xu cannot borrow several fields of one struct in a single call).
// Not constant-time.

pub const BLOCK_SIZE = 8

fn ip_hex() string {
    << "060e161e262e363e040c141c242c343c020a121a222a323a0008101820283038070f171f272f373f050d151d252d353d030b131b232b333b0109111921293139"
}

fn fp_hex() string {
    << "183810300828002019391131092901211a3a12320a2a02221b3b13330b2b03231c3c14340c2c04241d3d15350d2d05251e3e16360e2e06261f3f17370f2f0727"
}

fn e_hex() string {
    << "001f1e1d1c1b1c1b1a19181718171615141314131211100f100f0e0d0c0b0c0b0a09080708070605040304030201001f"
}

fn p_hex() string {
    << "10190c0b0314040f1f1109061b0e01161e18081200051d170d13021a0a151c07"
}

fn pc1_hex() string {
    << "070f171f272f373f060e161e262e363e050d151d252d353d040c141c0109111921293139020a121a222a323a030b131b232b333b242c343c"
}

fn pc2_hex() string {
    << "2a272d203733351c2932232e21252c341e3028311d242b360f04191309011a10050b17080c07110016030a0e06141b18"
}

fn s_hex() string {
    << ""
}

pub struct Cipher {
    pub subkeys []int
    ipt []int
    fpt []int
    et  []int
    pt  []int
    sb  []int
}

pub struct TripleCipher {
    pub k1 []int
    pub k2 []int
    pub k3 []int
    ipt []int
    fpt []int
    et  []int
    pt  []int
    sb  []int
}

fn load_ipt() []int {
    h := ip_hex()
    << hex_bytes(&h)
}

fn load_fpt() []int {
    h := fp_hex()
    << hex_bytes(&h)
}

fn load_et() []int {
    h := e_hex()
    << hex_bytes(&h)
}

fn load_pt() []int {
    h := p_hex()
    << hex_bytes(&h)
}

fn hex_nibble(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << 0
}

fn hex_bytes(h &string) []int {
    $b := []int{}
    $i := 0
    while i + 1 < h.len {
        b.push(hex_nibble(h[i] & 255) * 16 + hex_nibble(h[i + 1] & 255))
        i = i + 2
    }
    << b
}

fn sbox_tab() []int {
    hx := s_hex()
    $t := []int{}
    for i in 0:hx.len {
        t.push(hex_nibble(hx[i] & 255))
    }
    << t
}

fn rot_at(i int) int {
    if i == 0 || i == 1 || i == 8 || i == 15 {
        << 1
    }
    << 2
}

fn permute_into(out $&[]int, src &[]int, table &[]int) {
    n := table.len
    for position in 0:n {
        dest := n - 1 - position
        out[dest] = src[table[position]] & 1
    }
}

fn fill_bits(out $&[]int, x int, n int) {
    for i in 0:n {
        out[i] = (x >> i) & 1
    }
}

fn permute(src &[]int, table &[]int) []int {
    n := table.len
    $out := []int{}
    for i in 0:n {
        out.push(0)
    }
    permute_into($&out, src, table)
    << out
}

fn int_to_bits(x int, n int) []int {
    $b := []int{}
    for i in 0:n {
        b.push(0)
    }
    fill_bits($&b, x, n)
    << b
}

fn bits_to_int(bits &[]int) int {
    $x := 0
    $p := 1
    for i in 0:bits.len {
        if (bits[i] & 1) != 0 {
            x = x + p
        }
        p = p * 2
    }
    << x
}

fn bits32(bits &[]int, off int) int {
    $x := 0
    $p := 1
    for i in 0:32 {
        if (bits[off + i] & 1) != 0 {
            x = x + p
        }
        p = p * 2
    }
    << x
}

fn put32(bits $&[]int, off int, x int) {
    for i in 0:32 {
        bits[off + i] = (x >> i) & 1
    }
}

fn be_to_bits(src &string) []int {
    $bits := []int{}
    for i in 0:64 {
        bits.push(0)
    }
    for i in 0:8 {
        b := src[i] & 255
        for k in 0:8 {
            bits[63 - 8 * i - k] = (b >> (7 - k)) & 1
        }
    }
    << bits
}

fn bits_to_be(bits &[]int) string {
    $out := []int{}
    for i in 0:8 {
        $b := 0
        for k in 0:8 {
            b = (b * 2) | (bits[63 - 8 * i - k] & 1)
        }
        out.push(b)
    }
    << string_from_bytes(out)
}

fn rotl28(x int, r int) int {
    m := 268435455
    v := x & m
    << (((v << r) | (v >> (28 - r))) & m)
}

fn make_subkeys(key &string) []int {
    h1 := pc1_hex()
    h2 := pc2_hex()
    ip1 := hex_bytes(&h1)
    ip2 := hex_bytes(&h2)
    kb := be_to_bits(key)
    pk := permute(&kb, &ip1)
    pv := bits_to_int(&pk)
    $left := (pv / 268435456) & 268435455
    $right := pv & 268435455
    $ks := []int{}
    for i in 0:16 {
        r := rot_at(i)
        left = rotl28(left, r)
        right = rotl28(right, r)
        combined := left * 268435456 + right
        cb := int_to_bits(combined, 56)
        sk := permute(&cb, &ip2)
        ks.push(bits_to_int(&sk))
    }
    << ks
}

fn crypt_block_c(c &Cipher, src &string, decrypt int) string {
    if src.len != 8 {
        >> errors.new("crypto/des: invalid block size")
    }
    bits := be_to_bits(src)
    ipb := permute(&bits, &c.ipt)
    $left := bits32(&ipb, 32)
    $right := bits32(&ipb, 0)
    $rb := []int{}
    $er := []int{}
    $ob := []int{}
    $pb := []int{}
    for i in 0:32 {
        rb.push(0)
        ob.push(0)
        pb.push(0)
    }
    for i in 0:48 {
        er.push(0)
    }
    for i in 0:16 {
        $ki := i
        if decrypt != 0 {
            ki = 15 - i
        }
        k := c.subkeys[ki]
        nleft := right
        fill_bits($&rb, right, 32)
        permute_into($&er, &rb, &c.et)
        ex := bits_to_int(&er) ^ k
        $out32 := 0
        for s in 0:8 {
            six := (ex >> (42 - 6 * s)) & 63
            row := (((six >> 5) & 1) * 2) + (six & 1)
            col := (six >> 1) & 15
            out32 = out32 * 16 + c.sb[s * 64 + row * 16 + col]
        }
        fill_bits($&ob, out32, 32)
        permute_into($&pb, &ob, &c.pt)
        right = left ^ bits_to_int(&pb)
        left = nleft
    }
    $preb := []int{}
    for i in 0:64 {
        preb.push(0)
    }
    put32($&preb, 0, left)
    put32($&preb, 32, right)
    outb := permute(&preb, &c.fpt)
    << bits_to_be(&outb)
}

fn triple_subkey(c &TripleCipher, keysel int, ki int) int {
    if keysel == 1 {
        << c.k1[ki]
    }
    if keysel == 2 {
        << c.k2[ki]
    }
    << c.k3[ki]
}

fn crypt_block_t(c &TripleCipher, keysel int, src &string, decrypt int) string {
    if src.len != 8 {
        >> errors.new("crypto/des: invalid block size")
    }
    bits := be_to_bits(src)
    ipb := permute(&bits, &c.ipt)
    $left := bits32(&ipb, 32)
    $right := bits32(&ipb, 0)
    $rb := []int{}
    $er := []int{}
    $ob := []int{}
    $pb := []int{}
    for i in 0:32 {
        rb.push(0)
        ob.push(0)
        pb.push(0)
    }
    for i in 0:48 {
        er.push(0)
    }
    for i in 0:16 {
        $ki := i
        if decrypt != 0 {
            ki = 15 - i
        }
        k := triple_subkey(c, keysel, ki)
        nleft := right
        fill_bits($&rb, right, 32)
        permute_into($&er, &rb, &c.et)
        ex := bits_to_int(&er) ^ k
        $out32 := 0
        for s in 0:8 {
            six := (ex >> (42 - 6 * s)) & 63
            row := (((six >> 5) & 1) * 2) + (six & 1)
            col := (six >> 1) & 15
            out32 = out32 * 16 + c.sb[s * 64 + row * 16 + col]
        }
        fill_bits($&ob, out32, 32)
        permute_into($&pb, &ob, &c.pt)
        right = left ^ bits_to_int(&pb)
        left = nleft
    }
    $preb := []int{}
    for i in 0:64 {
        preb.push(0)
    }
    put32($&preb, 0, left)
    put32($&preb, 32, right)
    outb := permute(&preb, &c.fpt)
    << bits_to_be(&outb)
}

pub fn new_cipher(key &string) Cipher {
    if key.len != 8 {
        >> errors.new("crypto/des: invalid key size")
    }
    ks := make_subkeys(key)
    << Cipher{subkeys: ks, ipt: load_ipt(), fpt: load_fpt(), et: load_et(), pt: load_pt(), sb: sbox_tab()}
}

pub fn (c &Cipher) block_size() int {
    << BLOCK_SIZE
}

pub fn (c &Cipher) encrypt(src &string) string {
    << crypt_block_c(c, src, 0)
}

pub fn (c &Cipher) decrypt(src &string) string {
    << crypt_block_c(c, src, 1)
}

pub fn new_triple_cipher(key &string) TripleCipher {
    if key.len != 24 {
        >> errors.new("crypto/des: invalid key size")
    }
    raw := key + ""
    k1 := raw[0:8] + ""
    k2 := raw[8:16] + ""
    k3 := raw[16:24] + ""
    << TripleCipher{k1: make_subkeys(&k1), k2: make_subkeys(&k2), k3: make_subkeys(&k3), ipt: load_ipt(), fpt: load_fpt(), et: load_et(), pt: load_pt(), sb: sbox_tab()}
}

pub fn (c &TripleCipher) encrypt(src &string) string {
    a := crypt_block_t(c, 1, src, 0)
        t1 := a
    b := crypt_block_t(c, 2, &t1, 1)
        t2 := b
    << crypt_block_t(c, 3, &t2, 0)
}

pub fn (c &TripleCipher) decrypt(src &string) string {
    a := crypt_block_t(c, 3, src, 1)
        t1 := a
    b := crypt_block_t(c, 2, &t1, 0)
        t2 := b
    << crypt_block_t(c, 1, &t2, 1)
}
