@crypto/sm4


#errors
// SM4-CBC / SM4-CTR / SM4-CFB / SM4-OFB aligned with crypto/cipher's
// AES helpers, bound to this package's Cipher (Xu has no cipher.Block).
// Bare CBC needs whole blocks; PKCS7 helpers pad/unpad. CTR is XOR of
// the SM4 keystream (big-endian counter). CFB/OFB are 128-bit segments
// (OpenSSL SM4-CFB / SM4-OFB).

fn pkcs7_pad(src &string) string {
    mut n := 16 - (src.len % 16)
    if n == 0 {
        n = 16
    }
    mut b := []int{}
    mut i := 0
    while i < src.len {
        b.push(src[i] & 255)
        i = i + 1
    }
    mut j := 0
    while j < n {
        b.push(n)
        j = j + 1
    }
    << string_from_bytes(b)
}

fn pkcs7_unpad(src &string) string {
    data := src + ""
    if data.len == 0 {
        >> errors.new("crypto/sm4: invalid PKCS7 padding")
    }
    n := data[data.len - 1] & 255
    if n < 1 || n > data.len {
        >> errors.new("crypto/sm4: invalid PKCS7 padding")
    }
    mut i := data.len - n
    while i < data.len {
        if (data[i] & 255) != n {
            >> errors.new("crypto/sm4: invalid PKCS7 padding")
        }
        i = i + 1
    }
    if n == data.len {
        << ""
    }
    mut outb := []int{}
    end := data.len - n
    mut k := 0
    while k < end {
        outb.push(data[k] & 255)
        k = k + 1
    }
    << string_from_bytes(outb)
}

pub fn encrypt_cbc(c &Cipher, iv &string, src &string) string {
    if iv.len != 16 {
        >> errors.new("crypto/sm4: IV length must equal block size")
    }
    if src.len % 16 != 0 {
        >> errors.new("crypto/sm4: input not full blocks")
    }
    mut prev := []int{}
    mut x := []int{}
    prev.push(iv[0] & 255)
    prev.push(iv[1] & 255)
    prev.push(iv[2] & 255)
    prev.push(iv[3] & 255)
    prev.push(iv[4] & 255)
    prev.push(iv[5] & 255)
    prev.push(iv[6] & 255)
    prev.push(iv[7] & 255)
    prev.push(iv[8] & 255)
    prev.push(iv[9] & 255)
    prev.push(iv[10] & 255)
    prev.push(iv[11] & 255)
    prev.push(iv[12] & 255)
    prev.push(iv[13] & 255)
    prev.push(iv[14] & 255)
    prev.push(iv[15] & 255)
    for j in 0:16 {
        x.push(0)
    }
    mut outb := []int{}
    mut i := 0
    while i < src.len {
        x[0] = ((src[i] & 255) ^ prev[0]) & 255
        x[1] = ((src[i + 1] & 255) ^ prev[1]) & 255
        x[2] = ((src[i + 2] & 255) ^ prev[2]) & 255
        x[3] = ((src[i + 3] & 255) ^ prev[3]) & 255
        x[4] = ((src[i + 4] & 255) ^ prev[4]) & 255
        x[5] = ((src[i + 5] & 255) ^ prev[5]) & 255
        x[6] = ((src[i + 6] & 255) ^ prev[6]) & 255
        x[7] = ((src[i + 7] & 255) ^ prev[7]) & 255
        x[8] = ((src[i + 8] & 255) ^ prev[8]) & 255
        x[9] = ((src[i + 9] & 255) ^ prev[9]) & 255
        x[10] = ((src[i + 10] & 255) ^ prev[10]) & 255
        x[11] = ((src[i + 11] & 255) ^ prev[11]) & 255
        x[12] = ((src[i + 12] & 255) ^ prev[12]) & 255
        x[13] = ((src[i + 13] & 255) ^ prev[13]) & 255
        x[14] = ((src[i + 14] & 255) ^ prev[14]) & 255
        x[15] = ((src[i + 15] & 255) ^ prev[15]) & 255
        blk := string_from_bytes(x)
        er := c.encrypt(&blk)
        enc := er
        prev[0] = enc[0] & 255
        prev[1] = enc[1] & 255
        prev[2] = enc[2] & 255
        prev[3] = enc[3] & 255
        prev[4] = enc[4] & 255
        prev[5] = enc[5] & 255
        prev[6] = enc[6] & 255
        prev[7] = enc[7] & 255
        prev[8] = enc[8] & 255
        prev[9] = enc[9] & 255
        prev[10] = enc[10] & 255
        prev[11] = enc[11] & 255
        prev[12] = enc[12] & 255
        prev[13] = enc[13] & 255
        prev[14] = enc[14] & 255
        prev[15] = enc[15] & 255
        outb.push(prev[0])
        outb.push(prev[1])
        outb.push(prev[2])
        outb.push(prev[3])
        outb.push(prev[4])
        outb.push(prev[5])
        outb.push(prev[6])
        outb.push(prev[7])
        outb.push(prev[8])
        outb.push(prev[9])
        outb.push(prev[10])
        outb.push(prev[11])
        outb.push(prev[12])
        outb.push(prev[13])
        outb.push(prev[14])
        outb.push(prev[15])
        i = i + 16
    }
    << string_from_bytes(outb)
}

pub fn decrypt_cbc(c &Cipher, iv &string, src &string) string {
    if iv.len != 16 {
        >> errors.new("crypto/sm4: IV length must equal block size")
    }
    if src.len % 16 != 0 {
        >> errors.new("crypto/sm4: input not full blocks")
    }
    mut prev := []int{}
    prev.push(iv[0] & 255)
    prev.push(iv[1] & 255)
    prev.push(iv[2] & 255)
    prev.push(iv[3] & 255)
    prev.push(iv[4] & 255)
    prev.push(iv[5] & 255)
    prev.push(iv[6] & 255)
    prev.push(iv[7] & 255)
    prev.push(iv[8] & 255)
    prev.push(iv[9] & 255)
    prev.push(iv[10] & 255)
    prev.push(iv[11] & 255)
    prev.push(iv[12] & 255)
    prev.push(iv[13] & 255)
    prev.push(iv[14] & 255)
    prev.push(iv[15] & 255)
    mut ctb := []int{}
    for j in 0:16 {
        ctb.push(0)
    }
    mut outb := []int{}
    mut i := 0
    while i < src.len {
        ctb[0] = src[i] & 255
        ctb[1] = src[i + 1] & 255
        ctb[2] = src[i + 2] & 255
        ctb[3] = src[i + 3] & 255
        ctb[4] = src[i + 4] & 255
        ctb[5] = src[i + 5] & 255
        ctb[6] = src[i + 6] & 255
        ctb[7] = src[i + 7] & 255
        ctb[8] = src[i + 8] & 255
        ctb[9] = src[i + 9] & 255
        ctb[10] = src[i + 10] & 255
        ctb[11] = src[i + 11] & 255
        ctb[12] = src[i + 12] & 255
        ctb[13] = src[i + 13] & 255
        ctb[14] = src[i + 14] & 255
        ctb[15] = src[i + 15] & 255
        ct := string_from_bytes(ctb)
        dr := c.decrypt(&ct)
        pt := dr
        outb.push(((pt[0] & 255) ^ prev[0]) & 255)
        outb.push(((pt[1] & 255) ^ prev[1]) & 255)
        outb.push(((pt[2] & 255) ^ prev[2]) & 255)
        outb.push(((pt[3] & 255) ^ prev[3]) & 255)
        outb.push(((pt[4] & 255) ^ prev[4]) & 255)
        outb.push(((pt[5] & 255) ^ prev[5]) & 255)
        outb.push(((pt[6] & 255) ^ prev[6]) & 255)
        outb.push(((pt[7] & 255) ^ prev[7]) & 255)
        outb.push(((pt[8] & 255) ^ prev[8]) & 255)
        outb.push(((pt[9] & 255) ^ prev[9]) & 255)
        outb.push(((pt[10] & 255) ^ prev[10]) & 255)
        outb.push(((pt[11] & 255) ^ prev[11]) & 255)
        outb.push(((pt[12] & 255) ^ prev[12]) & 255)
        outb.push(((pt[13] & 255) ^ prev[13]) & 255)
        outb.push(((pt[14] & 255) ^ prev[14]) & 255)
        outb.push(((pt[15] & 255) ^ prev[15]) & 255)
        prev[0] = ctb[0]
        prev[1] = ctb[1]
        prev[2] = ctb[2]
        prev[3] = ctb[3]
        prev[4] = ctb[4]
        prev[5] = ctb[5]
        prev[6] = ctb[6]
        prev[7] = ctb[7]
        prev[8] = ctb[8]
        prev[9] = ctb[9]
        prev[10] = ctb[10]
        prev[11] = ctb[11]
        prev[12] = ctb[12]
        prev[13] = ctb[13]
        prev[14] = ctb[14]
        prev[15] = ctb[15]
        i = i + 16
    }
    << string_from_bytes(outb)
}

pub fn encrypt_cbc_pkcs7(c &Cipher, iv &string, src &string) string {
    padded := pkcs7_pad(src)
    << encrypt_cbc(c, iv, &padded) or (err) {
        << ""
    }
}

pub fn decrypt_cbc_pkcs7(c &Cipher, iv &string, src &string) string {
    pt := decrypt_cbc(c, iv, src)
    << pkcs7_unpad(&pt) or >>
}

fn ctr_inc(counter &mut []int) {
    mut i := 15
    while i >= 0 {
        v := (counter[i] & 255) + 1
        counter[i] = v & 255
        if v < 256 {
            <<
        }
        i = i - 1
    }
}

fn ctr_keystream_xor(c &Cipher, iv &string, src &string) string {
    if iv.len != 16 {
        >> errors.new("crypto/sm4: IV length must equal block size")
    }
    mut counter := []int{}
    mut i := 0
    while i < 16 {
        counter.push(iv[i] & 255)
        i = i + 1
    }
    mut out := []int{}
    mut off := 0
    while off < src.len {
        blk := string_from_bytes(counter)
        er := c.encrypt(&blk)
        ks := er
        mut j := 0
        while j < 16 && off < src.len {
            out.push(((src[off] & 255) ^ (ks[j] & 255)) & 255)
            off = off + 1
            j = j + 1
        }
        ctr_inc(mut &counter)
    }
    << string_from_bytes(out)
}

pub fn encrypt_ctr(c &Cipher, iv &string, src &string) string {
    << ctr_keystream_xor(c, iv, src)
}

pub fn decrypt_ctr(c &Cipher, iv &string, src &string) string {
    << ctr_keystream_xor(c, iv, src)
}

fn load16(iv &string) []int {
    mut r := []int{}
    mut i := 0
    while i < 16 {
        r.push(iv[i] & 255)
        i = i + 1
    }
    << r
}

fn cfb_crypt(c &Cipher, iv &string, src &string, enc int) string {
    if iv.len != 16 {
        >> errors.new("crypto/sm4: IV length must equal block size")
    }
    mut reg := load16(iv)
    mut out := []int{}
    mut off := 0
    while off < src.len {
        blk := string_from_bytes(reg)
        ks := c.encrypt(&blk)
        mut j := 0
        while j < 16 && off < src.len {
            x := ((src[off] & 255) ^ (ks[j] & 255)) & 255
            out.push(x)
            if enc != 0 {
                reg[j] = x
            } else {
                reg[j] = src[off] & 255
            }
            off = off + 1
            j = j + 1
        }
    }
    << string_from_bytes(out)
}

pub fn encrypt_cfb(c &Cipher, iv &string, src &string) string {
    << cfb_crypt(c, iv, src, 1)
}

pub fn decrypt_cfb(c &Cipher, iv &string, src &string) string {
    << cfb_crypt(c, iv, src, 0)
}

fn ofb_keystream_xor(c &Cipher, iv &string, src &string) string {
    if iv.len != 16 {
        >> errors.new("crypto/sm4: IV length must equal block size")
    }
    mut reg := load16(iv)
    mut out := []int{}
    mut off := 0
    while off < src.len {
        blk := string_from_bytes(reg)
        ks := c.encrypt(&blk)
        mut j := 0
        while j < 16 {
            if off < src.len {
                out.push(((src[off] & 255) ^ (ks[j] & 255)) & 255)
                off = off + 1
            }
            reg[j] = ks[j] & 255
            j = j + 1
        }
    }
    << string_from_bytes(out)
}

pub fn encrypt_ofb(c &Cipher, iv &string, src &string) string {
    << ofb_keystream_xor(c, iv, src)
}

pub fn decrypt_ofb(c &Cipher, iv &string, src &string) string {
    << ofb_keystream_xor(c, iv, src)
}
