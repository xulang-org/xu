@crypto/sm4


#errors
// SM4 (GB/T 32907 / GM/T 0002). Xu addition — Go has no crypto/sm4.
// 128-bit key, 128-bit block, 32 rounds. Single-block encrypt/decrypt
// aligned with crypto/aes (new_cipher + encrypt/decrypt/block_size).
// CBC/CTR/CFB/OFB/GCM live in this package (not crypto/cipher, which stays
// AES-bound). Pure i64 with 32-bit masks. Zero C, not a
// commercial-crypto certification.

pub const block_size = 16
const m32 = 4294967295

pub struct Cipher {
    pub rk []int
    pub sbox []int
}

fn rotl(x0 int, n0 int) int {
    x := x0 & m32
    n := n0 & 31
    if n == 0 {
        << x
    }
    << ((x << n) | ((x >> (32 - n)) & m32)) & m32
}

fn hex_nibble(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << 0
}

fn hex_bytes(h &string) []int {
    mut b := []int{}
    mut i := 0
    while i + 1 < h.len {
        b.push(hex_nibble(h[i] & 255) * 16 + hex_nibble(h[i + 1] & 255))
        i = i + 2
    }
    << b
}

fn sbox_hex() string {
    << "d690e9fecce13db716b614c228fb2c052b679a762abe04c3aa44132649860699" + "9c4250f491ef987a33540b43edcfac62e4b31ca9c908e89580df94fa758f3fa6" + "4707a7fcf37317ba83593c19e6854fa8686b81b27164da8bf8eb0f4b70569d35" + "1e240e5e6358d1a225227c3b01217887d40046579fd327524c3602e7a0c4c89e" + "eabf8ad240c738b5a3f7f2cef96115a1e0ae5da49b341a55ad933230f58cb1e3" + "1df6e22e8266ca60c02923ab0d534e6fd5db3745defd8e2f03ff6a726d6c5b51" + "8d1baf92bbddbc7f11d95c411f105ad80ac13188a5cd7bbd2d74d012b8e5b4b0" + "8969974a0c96777e65b9f109c56ec68418f07dec3adc4d2079ee5f3ed7cb3948"
}

fn make_sbox() []int {
    h := sbox_hex()
    << hex_bytes(&h)
}

fn load_be(src &string, off int) int {
    << (((src[off] & 255) << 24) | ((src[off + 1] & 255) << 16) | ((src[off + 2] & 255) << 8) | (src[off + 3] & 255)) & m32
}

fn tau(x int, sbox &[]int) int {
    b0 := sbox[(x >> 24) & 255] & 255
    b1 := sbox[(x >> 16) & 255] & 255
    b2 := sbox[(x >> 8) & 255] & 255
    b3 := sbox[x & 255] & 255
    << ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & m32
}

fn l_lin(b int) int {
    << (b ^ rotl(b, 2) ^ rotl(b, 10) ^ rotl(b, 18) ^ rotl(b, 24)) & m32
}

fn lp_lin(b int) int {
    << (b ^ rotl(b, 13) ^ rotl(b, 23)) & m32
}

fn expand_key(key &string, sbox &[]int) []int {
    mut k0 := (load_be(key, 0) ^ 0xa3b1bac6) & m32
    mut k1 := (load_be(key, 4) ^ 0x56aa3350) & m32
    mut k2 := (load_be(key, 8) ^ 0x677d9197) & m32
    mut k3 := (load_be(key, 12) ^ 0xb27022dc) & m32
    mut rk := []int{}
    for i in 0:32 {
        mut ck := 0
        for j in 0:4 {
            cj := ((4 * i + j) * 7) & 255
            ck = ((ck << 8) | cj) & m32
        }
        nxt := (k0 ^ lp_lin(tau((k1 ^ k2 ^ k3 ^ ck) & m32, sbox))) & m32
        rk.push(nxt)
        k0 = k1
        k1 = k2
        k2 = k3
        k3 = nxt
    }
    << rk
}

fn sm4_hw_supported() int {
    << 0
}

fn sm4_hw_crypt(out &string, src &string, rk &[]int, inv int) {
}

fn (c &Cipher) crypt(src &string, inv int) string {
    if sm4_hw_supported() == 1 {
        mut out := "                "
        sm4_hw_crypt(&out, src, &c.rk, inv)
        << out
    }
    mut x0 := load_be(src, 0)
    mut x1 := load_be(src, 4)
    mut x2 := load_be(src, 8)
    mut x3 := load_be(src, 12)
    for i in 0:32 {
        mut rki := c.rk[i]
        if inv != 0 {
            rki = c.rk[31 - i]
        }
        x := (x1 ^ x2 ^ x3 ^ rki) & m32
        b0 := c.sbox[(x >> 24) & 255] & 255
        b1 := c.sbox[(x >> 16) & 255] & 255
        b2 := c.sbox[(x >> 8) & 255] & 255
        b3 := c.sbox[x & 255] & 255
        tb := ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & m32
        t := (x0 ^ l_lin(tb)) & m32
        x0 = x1
        x1 = x2
        x2 = x3
        x3 = t
    }
    mut b := []int{}
    b.push((x3 >> 24) & 255)
    b.push((x3 >> 16) & 255)
    b.push((x3 >> 8) & 255)
    b.push(x3 & 255)
    b.push((x2 >> 24) & 255)
    b.push((x2 >> 16) & 255)
    b.push((x2 >> 8) & 255)
    b.push(x2 & 255)
    b.push((x1 >> 24) & 255)
    b.push((x1 >> 16) & 255)
    b.push((x1 >> 8) & 255)
    b.push(x1 & 255)
    b.push((x0 >> 24) & 255)
    b.push((x0 >> 16) & 255)
    b.push((x0 >> 8) & 255)
    b.push(x0 & 255)
    << string_from_bytes(b)
}

pub fn new_cipher(key &string) Cipher {
    if key.len != 16 {
        >> errors.new("crypto/sm4: invalid key size")
    }
    sbox := make_sbox()
    if sbox.len != 256 {
        >> errors.new("crypto/sm4: sbox")
    }
    rk := expand_key(key, &sbox)
    << Cipher{rk: rk, sbox: sbox}
}

pub fn (c &Cipher) block_size() int {
    << block_size
}

pub fn (c &Cipher) encrypt(src &string) string {
    if src.len != 16 {
        >> errors.new("crypto/sm4: invalid block size")
    }
    << c.crypt(src, 0)
}

pub fn (c &Cipher) decrypt(src &string) string {
    if src.len != 16 {
        >> errors.new("crypto/sm4: invalid block size")
    }
    << c.crypt(src, 1)
}
