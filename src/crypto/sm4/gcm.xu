@crypto/sm4


#errors
#crypto/subtle

// SM4-GCM (SP 800-38D) with 96-bit nonce and 128-bit tag.
// seal_gcm returns ciphertext || tag; open_gcm verifies then returns plaintext.
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only
// Same GHASH as crypto/cipher AES-GCM; the block function is SM4.
// GHASH and counter ciphering are zero-heap-allocation with 64-bit scalar registers.

struct GHashState {
    hi int
    lo int
}

fn gcm_load64_be_str(s &string, off int) int {
    mut v := 0
    for i in 0:8 {
        if off + i < s.len {
            v = (v << 8) | (s[off + i] & 255)
        } else {
            v = v << 8
        }
    }
    << v
}

fn ghash_update_block(st &mut GHashState, h_hi int, h_lo int, b_hi int, b_lo int) {
    mut v_hi := st.hi ^ b_hi
    mut v_lo := st.lo ^ b_lo
    mut z_hi := 0
    mut z_lo := 0
    m63 := 9223372036854775807
    poly := 225 << 56
    mut i := 0
    while i < 128 {
        mut bit := 0
        if i < 64 {
            bit = (h_hi >> (63 - i)) & 1
        } else {
            bit = (h_lo >> (127 - i)) & 1
        }
        if bit != 0 {
            z_hi = z_hi ^ v_hi
            z_lo = z_lo ^ v_lo
        }
        lsb := v_lo & 1
        v_lo = ((v_lo >> 1) & m63) | ((v_hi & 1) << 63)
        v_hi = (v_hi >> 1) & m63
        if lsb != 0 {
            v_hi = v_hi ^ poly
        }
        i = i + 1
    }
    st.hi = z_hi
    st.lo = z_lo
}

fn gcm_ghash(h_str &string, aad &string, ct &string) string {
    h_hi := gcm_load64_be_str(h_str, 0)
    h_lo := gcm_load64_be_str(h_str, 8)
    mut st := GHashState{hi: 0, lo: 0}

    mut off := 0
    while off < aad.len {
        b_hi := gcm_load64_be_str(aad, off)
        b_lo := gcm_load64_be_str(aad, off + 8)
        ghash_update_block(mut &st, h_hi, h_lo, b_hi, b_lo)
        off = off + 16
    }

    off = 0
    while off < ct.len {
        b_hi := gcm_load64_be_str(ct, off)
        b_lo := gcm_load64_be_str(ct, off + 8)
        ghash_update_block(mut &st, h_hi, h_lo, b_hi, b_lo)
        off = off + 16
    }

    len_hi := aad.len * 8
    len_lo := ct.len * 8
    ghash_update_block(mut &st, h_hi, h_lo, len_hi, len_lo)

    mut res := make_string(16)
    for k in 0:8 {
        res[k] = (st.hi >> (56 - 8 * k)) & 255
    }
    for k in 0:8 {
        res[8 + k] = (st.lo >> (56 - 8 * k)) & 255
    }
    << res
}

fn gcm_crypt(c &Cipher, nonce &string, c_init int, src &string) string {
    mut ctr_blk := make_string(16)
    for i in 0:12 {
        ctr_blk[i] = nonce[i] & 255
    }
    mut c_val := c_init
    mut out := make_string(src.len)
    mut off := 0
    while off < src.len {
        ctr_blk[12] = (c_val >> 24) & 255
        ctr_blk[13] = (c_val >> 16) & 255
        ctr_blk[14] = (c_val >> 8) & 255
        ctr_blk[15] = c_val & 255
        eb := c.encrypt(&ctr_blk) or (err) { << "" }
        mut j := 0
        while j < 16 && off < src.len {
            out[off] = (src[off] ^ eb[j]) & 255
            off = off + 1
            j = j + 1
        }
        c_val = (c_val + 1) & 4294967295
    }
    << out
}

fn gcm_j0(nonce &string) string {
    mut j := make_string(16)
    for i in 0:12 {
        j[i] = nonce[i] & 255
    }
    j[15] = 1
    << j
}

pub fn seal_gcm(c &Cipher, nonce &string, plaintext &string, aad &string) string {
    if nonce.len != 12 {
        >> errors.new("crypto/sm4: GCM nonce must be 12 bytes")
    }
    zero := make_string(16)
    h := c.encrypt(&zero) or (err) { << "" }
    j0 := gcm_j0(nonce)
    ct := gcm_crypt(c, nonce, 2, plaintext)
    ghash_tag := gcm_ghash(&h, aad, &ct)
    ej := c.encrypt(&j0) or (err) { << "" }
    mut tag := make_string(16)
    for i in 0:16 {
        tag[i] = (ej[i] ^ ghash_tag[i]) & 255
    }
    << ct + tag
}

pub fn open_gcm(c &Cipher, nonce &string, sealed &string, aad &string) string {
    if nonce.len != 12 {
        >> errors.new("crypto/sm4: GCM nonce must be 12 bytes")
    }
    if sealed.len < 16 {
        >> errors.new("crypto/sm4: GCM message too short")
    }
    ct_len := sealed.len - 16
    mut ct := make_string(ct_len)
    for i in 0:ct_len {
        ct[i] = sealed[i] & 255
    }
    mut got_tag := make_string(16)
    for i in 0:16 {
        got_tag[i] = sealed[ct_len + i] & 255
    }
    zero := make_string(16)
    h := c.encrypt(&zero) or (err) { << "" }
    j0 := gcm_j0(nonce)
    ghash_tag := gcm_ghash(&h, aad, &ct)
    ej := c.encrypt(&j0) or (err) { << "" }
    mut want_tag := make_string(16)
    for i in 0:16 {
        want_tag[i] = (ej[i] ^ ghash_tag[i]) & 255
    }
    if subtle.constant_time_compare(&got_tag, &want_tag) != 1 {
        >> errors.new("crypto/sm4: GCM authentication failed")
    }
    << gcm_crypt(c, nonce, 2, &ct)
}
