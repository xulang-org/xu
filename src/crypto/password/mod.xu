@crypto/password

#crypto/hmac
#crypto/rand
#crypto/subtle
#encoding/base64
#encoding/hex
#errors
#strconv
#strings

// Password hashing & Key Derivation (PBKDF2-HMAC-SHA256 + HKDF-SHA256).
// Self-describing encoded hash for login:
//
//   $pbkdf2-sha256$<iterations>$<salt_b64>$<dk_b64>
//
// Inner PBKDF2 loop accumulates XOR in a mutable []int buffer rather than
// allocating a new string per iteration.
// XU-CT-USE: fixed-shape-only
// verify compares digests with crypto/subtle.

// Maximum PBKDF2 derived key length, including verified stored keys.
const max_derived_key_bytes = 1024
// Minimum derived key length accepted from an encoded password hash.
const min_verified_key_bytes = 16

const min_iter = 1
const max_iter = 2000000
const default_iter = 210000
const default_salt_len = 16
const default_key_len = 32

// pbkdf2_hmac_sha256 returns `key_len` raw bytes (RFC 2898).
pub fn pbkdf2_hmac_sha256(password string, salt string, iterations int, key_len int) string {
    if iterations < min_iter || iterations > max_iter {
        >> errors.new("crypto/password: iterations out of range")
    }
    if key_len < 1 || key_len > max_derived_key_bytes {
        >> errors.new("crypto/password: key_len out of range")
    }
    mut out := []int{}
    mut block_i := 1
    while out.len < key_len {
        // U1 = HMAC(password, salt || INT_32_BE(block_i))
        mut ib := []int{}
        ib.push((block_i >> 24) & 255)
        ib.push((block_i >> 16) & 255)
        ib.push((block_i >> 8) & 255)
        ib.push(block_i & 255)
        msg := salt + "" + string_from_bytes(ib)
        mut u := hmac.sum256_bytes(&password, &msg)
        mut t_bytes := []int{}
        mut j := 0
        while j < u.len {
            t_bytes.push(u[j] & 255)
            j = j + 1
        }
        mut i := 1
        while i < iterations {
            u = hmac.sum256_bytes(&password, &u)
            j = 0
            while j < t_bytes.len && j < u.len {
                t_bytes[j] = (t_bytes[j] ^ u[j]) & 255
                j = j + 1
            }
            i = i + 1
        }
        j = 0
        while j < t_bytes.len && out.len < key_len {
            out.push(t_bytes[j])
            j = j + 1
        }
        block_i = block_i + 1
    }
    << string_from_bytes(out)
}

// hkdf_extract_sha256 computes a 32-byte pseudorandom key PRK (RFC 5869 §2.2).
pub fn hkdf_extract_sha256(salt &string, ikm &string) string {
    if salt.len == 0 {
        mut z := []int{}
        mut i := 0
        while i < 32 {
            z.push(0)
            i = i + 1
        }
        zero_salt := string_from_bytes(z)
        << hmac.sum256_bytes(&zero_salt, ikm)
    }
    << hmac.sum256_bytes(salt, ikm)
}

// hkdf_expand_sha256 expands PRK to `key_len` bytes (RFC 5869 §2.3, max 255*32).
pub fn hkdf_expand_sha256(prk &string, info &string, key_len int) string {
    if key_len < 0 || key_len > 255 * 32 {
        >> errors.new("crypto/password: invalid HKDF key_len")
    }
    if prk.len < 32 {
        >> errors.new("crypto/password: HKDF PRK too short")
    }
    mut out := []int{}
    mut prev := ""
    mut counter := 1
    while out.len < key_len {
        input := prev + (info + "") + string_from_byte(counter)
        prev = hmac.sum256_bytes(prk, &input)
        mut j := 0
        while j < prev.len && out.len < key_len {
            out.push(prev[j] & 255)
            j = j + 1
        }
        counter = counter + 1
    }
    << string_from_bytes(out)
}

// hash returns `$pbkdf2-sha256$iter$salt_b64$dk_b64`.
pub fn hash(password string) string {
    << hash_iter(password, default_iter)
}

pub fn hash_iter(password string, iterations int) string {
    salt := rand.read(default_salt_len) or (err) {
        >> err
    }
    sal := salt + ""
    dk := pbkdf2_hmac_sha256(password + "", sal + "", iterations, default_key_len) or (err) {
        >> err
    }
    s64 := base64.encode_raw(sal + "")
    d64 := base64.encode_raw(dk + "")
    dlr := string_from_byte(36)
    << dlr + "pbkdf2-sha256" + dlr + strconv.itoa(iterations) + dlr + s64 + dlr + d64
}

// verify reports whether password matches an encoded hash.
pub fn verify(encoded string, password string) bool {
    mut parts := []string{}
    // split on '$' — format starts with '$' so parts[0] is empty
    mut start := 0
    mut i := 0
    while i < encoded.len {
        if (encoded[i] & 255) == 36 {
            parts.push(encoded[start:i])
            start = i + 1
        }
        i = i + 1
    }
    parts.push(encoded[start:encoded.len])
    // expected: "", "pbkdf2-sha256", iter, salt, dk
    if parts.len != 5 {
        << false
    }
    if parts[0].len != 0 || parts[1] != "pbkdf2-sha256" {
        << false
    }
    ps2 := parts[2] + ""
    iter := strconv.atoi(&ps2) or (err) {
        << false
    }
    if iter < min_iter || iter > max_iter {
        << false
    }
    salt := base64.decode_raw(parts[3]) or (err) {
        << false
    }
    want := base64.decode_raw(parts[4]) or (err) {
        << false
    }
    if want.len < min_verified_key_bytes || want.len > max_derived_key_bytes {
        << false
    }
    got := pbkdf2_hmac_sha256(password + "", salt, iter, want.len) or (err) {
        << false
    }
    if got.len != want.len {
        << false
    }
    << subtle.constant_time_compare(&got, &want) == 1
}
