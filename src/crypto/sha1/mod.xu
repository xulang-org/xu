@crypto/sha1

#encoding/hex

// SHA-1 aligned with Go `crypto/sha1` (Sum). Pure i64 integer arithmetic
// with per-step 32-bit masks (identical bit patterns on every backend).
// Big-endian word order per RFC 3174. sum returns the 40-char lowercase
// hex digest; Digest.write 按 64 字节窗口就地压缩（不整份拼接）。
// Compresses 64-byte windows in place (no full-message copy).

const M32 = 4294967295

struct State {
    h0 int
    h1 int
    h2 int
    h3 int
    h4 int
}

fn iv() State {
    << State{h0: 0x67452301, h1: 0xefcdab89, h2: 0x98badcfe, h3: 0x10325476, h4: 0xc3d2e1f0}
}

fn zeros80() []int {
    mut w := []int{}
    for i in 0:80 {
        w.push(0)
    }
    << w
}

fn pad_tail(s &string, start int, total int) string {
    rem := s.len - start
    mut b := []int{}
    for i in 0:rem {
        b.push(s[start + i])
    }
    b.push(128)
    mut going := 1
    while going == 1 {
        if b.len % 64 == 56 {
            going = 0
        } else {
            b.push(0)
        }
    }
    bits := total * 8
    for j in 0:8 {
        b.push((bits >> (56 - 8 * j)) & 255)
    }
    << string_from_bytes(b)
}

fn hex_state(st &State) string {
    hh := [st.h0, st.h1, st.h2, st.h3, st.h4]
    mut db := []int{}
    for j in 0:5 {
        v := hh[j]
        db.push((v >> 24) & 255)
        db.push((v >> 16) & 255)
        db.push((v >> 8) & 255)
        db.push(v & 255)
    }
    << hex.encode_to_string(string_from_bytes(db))
}

pub fn sum(s string) string {
    mut d := new()
    n := s.len
    mut off := 0
    while off + 64 <= n {
        d.compress_block(&s, off)
        off += 64
    }
    tail := pad_tail(&s, off, n)
    mut po := 0
    while po + 64 <= tail.len {
        d.compress_block(&tail, po)
        po += 64
    }
    << hex_state(&d.st)
}

pub struct Digest {
    st  State
    w   []int
    buf string
    n   int
}

pub fn new() Digest {
    << Digest{st: iv(), w: zeros80(), buf: "", n: 0}
}

fn sha1_hw_supported() int {
    << 0
}

fn sha1_hw_compress_block(st &State, data &string, off int) {
}

fn (d &mut Digest) compress_block(s &string, off int) {
    if sha1_hw_supported() == 1 {
        sha1_hw_compress_block(&d.st, s, off)
        <<
    }
    for i in 0:16 {
        o := off + 4 * i
        d.w[i] = ((s[o] << 24) | (s[o + 1] << 16) | (s[o + 2] << 8) | s[o + 3]) & M32
    }
    for i in 16:80 {
        x := (d.w[i - 3] ^ d.w[i - 8] ^ d.w[i - 14] ^ d.w[i - 16]) & M32
        d.w[i] = ((x << 1) | (x >> 31)) & M32
    }
    mut a := d.st.h0 & M32
    mut b2 := d.st.h1 & M32
    mut c2 := d.st.h2
    mut d2 := d.st.h3
    mut e := d.st.h4
    for i in 0:80 {
        mut f := 0
        mut k := 0x5a827999
        if i < 20 {
            f = (b2 & c2) | ((b2 ^ M32) & d2)
        } else if i < 40 {
            f = b2 ^ c2 ^ d2
            k = 0x6ed9eba1
        } else if i < 60 {
            f = (b2 & c2) | (b2 & d2) | (c2 & d2)
            k = 0x8f1bbcdc
        } else {
            f = b2 ^ c2 ^ d2
            k = 0xca62c1d6
        }
        t := ((((a << 5) | (a >> 27)) + f + e + k + d.w[i]) & M32)
        e = d2
        d2 = c2
        c2 = ((b2 << 30) | (b2 >> 2)) & M32
        b2 = a
        a = t
    }
    d.st.h0 = (d.st.h0 + a) & M32
    d.st.h1 = (d.st.h1 + b2) & M32
    d.st.h2 = (d.st.h2 + c2) & M32
    d.st.h3 = (d.st.h3 + d2) & M32
    d.st.h4 = (d.st.h4 + e) & M32
}

pub fn (d &mut Digest) write(p &string) int {
    n := p.len
    if n == 0 {
        << 0
    }
    mut i := 0
    if d.buf.len > 0 {
        need := 64 - d.buf.len
        mut take := n
        if take > need {
            take = need
        }
        mut piece := []int{}
        mut bi := 0
        while bi < d.buf.len {
            piece.push(d.buf[bi] & 255)
            bi = bi + 1
        }
        mut j := 0
        while j < take {
            piece.push(p[j] & 255)
            j = j + 1
        }
        i = take
        if piece.len == 64 {
            block := string_from_bytes(piece)
            d.compress_block(&block, 0)
            d.buf = ""
        } else {
            d.buf = string_from_bytes(piece)
        }
    }
    while i + 64 <= n {
        d.compress_block(p, i)
        i += 64
    }
    if i < n {
        mut rest := []int{}
        mut j := i
        while j < n {
            rest.push(p[j] & 255)
            j = j + 1
        }
        extra := string_from_bytes(rest)
        r := mut &d.buf
        r.push_str(extra)
    }
    d.n = d.n + n
    << n
}

pub fn (d &mut Digest) reset() {
    d.st = iv()
    d.buf = ""
    d.n = 0
}

pub fn (d Digest) size() int {
    << 20
}

pub fn (d Digest) blocksize() int {
    << 64
}

pub fn (d &Digest) sum() string {
    mut tmp := new()
    tmp.st = State{h0: d.st.h0, h1: d.st.h1, h2: d.st.h2, h3: d.st.h3, h4: d.st.h4}
    buf := d.buf + ""
    tail := pad_tail(&buf, 0, d.n)
    mut po := 0
    while po + 64 <= tail.len {
        tmp.compress_block(&tail, po)
        po += 64
    }
    << hex_state(&tmp.st)
}
