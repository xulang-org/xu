fn zeros80() []int {
    $w := []int{}
    for i in 0:80 {
        w.push(0)
    }
    << w
}

struct State {
    h0 int
    h1 int
    h2 int
    h3 int
    h4 int
    h5 int
    h6 int
    h7 int
}

fn iv() State {
    << State{h0: 7640891576956012808, h1: -4942790177534073029, h2: 4354685564936845355, h3: -6534734903238641935, h4: 5840696475078001361, h5: -7276294671716946913, h6: 2270897969802886507, h7: 6620516959819538809}
}

fn iv384() State {
    << State{h0: -3766243637369397544, h1: 7105036623409894663, h2: -7973340178411365097, h3: 1526699215303891257, h4: 7436329637833083697, h5: -8163818279084223215, h6: -2662702644619276377, h7: 5167115440072839076}
}

fn pad_tail(s &string, start int, total int) string {
    rem := s.len - start
    $b := []int{}
    for i in 0:rem {
        b.push(s[start + i])
    }
    b.push(128)
    $going := 1
    while going == 1 {
        if b.len % 128 == 112 {
            going = 0
        } else {
            b.push(0)
        }
    }
    for j in 0:8 {
        b.push(0)
    }
    bits := total * 8
    for j in 0:8 {
        b.push((bits >> (56 - 8 * j)) & 255)
    }
    << string_from_bytes(b)
}

fn raw_state(st &State) string {
    hh := [st.h0, st.h1, st.h2, st.h3, st.h4, st.h5, st.h6, st.h7]
    $db := []int{}
    for j in 0:8 {
        v := hh[j]
        db.push((v >> 56) & 255)
        db.push((v >> 48) & 255)
        db.push((v >> 40) & 255)
        db.push((v >> 32) & 255)
        db.push((v >> 24) & 255)
        db.push((v >> 16) & 255)
        db.push((v >> 8) & 255)
        db.push(v & 255)
    }
    << string_from_bytes(db)
}

fn hash512(s string) string {
    $d := new()
    n := s.len
    $off := 0
    while off + 128 <= n {
        d.compress_block(&s, off)
        off += 128
    }
    tail := pad_tail(&s, off, n)
    $po := 0
    while po + 128 <= tail.len {
        d.compress_block(&tail, po)
        po += 128
    }
    << raw_state(&d.st)
}

fn hash384(s string) string {
    $d := Digest{st: iv384(), k: k512(), w: zeros80(), buf: "", n: 0}
    n := s.len
    $off := 0
    while off + 128 <= n {
        d.compress_block(&s, off)
        off += 128
    }
    tail := pad_tail(&s, off, n)
    $po := 0
    while po + 128 <= tail.len {
        d.compress_block(&tail, po)
        po += 128
    }
    raw := raw_state(&d.st)
    << raw[0:48] + ""
}

pub fn sum512(s string) string {
    << hash512(s)
}

// sum384 returns the raw 48-byte SHA-384 digest. It shares the SHA-512
// compression function but uses the FIPS 180-4 SHA-384 IV and truncation.
pub fn sum384(s string) string {
    << hash384(s)
}

pub fn sum384_hex(s string) string {
    << hex.encode_to_string(hash384(s))
}

pub fn sum(s string) string {
    << hex.encode_to_string(hash512(s))
}

pub struct Digest {
    st  State
    k   []int
    w   []int
    buf string
    n   int
}

pub fn new() Digest {
    << Digest{st: iv(), k: k512(), w: zeros80(), buf: "", n: 0}
}

fn sha512_hw_supported() int {
    << 0
}

fn sha512_hw_compress_block(st &State, data &string, off int) {
}

fn (d $&Digest) compress_block(s &string, off int) {
    if sha512_hw_supported() == 1 {
        sha512_hw_compress_block(&d.st, s, off)
        <<
    }
    for i in 0:16 {
        o := off + 8 * i
        d.w[i] = (s[o] << 56) | (s[o + 1] << 48) | (s[o + 2] << 40) | (s[o + 3] << 32) | (s[o + 4] << 24) | (s[o + 5] << 16) | (s[o + 6] << 8) | s[o + 7]
    }
    for i in 16:80 {
        x2 := d.w[i - 2]
        x15 := d.w[i - 15]
        r19 := ((x2 & 524287) << 45) | ((x2 >> 19) & 35184372088831)
        r61 := ((x2 & 2305843009213693951) << 3) | ((x2 >> 61) & 7)
        r1 := ((x15 & 1) << 63) | ((x15 >> 1) & 9223372036854775807)
        r8 := ((x15 & 255) << 56) | ((x15 >> 8) & 72057594037927935)
        s1 := r19 ^ r61 ^ ((x2 >> 6) & 288230376151711743)
        s0 := r1 ^ r8 ^ ((x15 >> 7) & 144115188075855871)
        d.w[i] = s1 + d.w[i - 7] + s0 + d.w[i - 16]
    }
    $a := d.st.h0
    $b2 := d.st.h1
    $c2 := d.st.h2
    $d2 := d.st.h3
    $e := d.st.h4
    $f := d.st.h5
    $g := d.st.h6
    $h := d.st.h7
    for i in 0:80 {
        se14 := ((e & 16383) << 50) | ((e >> 14) & 1125899906842623)
        se18 := ((e & 262143) << 46) | ((e >> 18) & 70368744177663)
        se41 := ((e & 2199023255551) << 23) | ((e >> 41) & 8388607)
        s1e := se14 ^ se18 ^ se41
        ch := (e & f) ^ ((e ^ -1) & g)
        t1 := h + s1e + ch + d.k[i] + d.w[i]
        sa28 := ((a & 268435455) << 36) | ((a >> 28) & 68719476735)
        sa34 := ((a & 17179869183) << 30) | ((a >> 34) & 1073741823)
        sa39 := ((a & 549755813887) << 25) | ((a >> 39) & 33554431)
        s0a := sa28 ^ sa34 ^ sa39
        maj := (a & b2) ^ (a & c2) ^ (b2 & c2)
        t2 := s0a + maj
        h = g
        g = f
        f = e
        e = d2 + t1
        d2 = c2
        c2 = b2
        b2 = a
        a = t1 + t2
    }
    d.st.h0 = d.st.h0 + a
    d.st.h1 = d.st.h1 + b2
    d.st.h2 = d.st.h2 + c2
    d.st.h3 = d.st.h3 + d2
    d.st.h4 = d.st.h4 + e
    d.st.h5 = d.st.h5 + f
    d.st.h6 = d.st.h6 + g
    d.st.h7 = d.st.h7 + h
}

pub fn (d $&Digest) write(p &string) int {
    n := p.len
    if n == 0 {
        << 0
    }
    $i := 0
    if d.buf.len > 0 {
        need := 128 - d.buf.len
        $take := n
        if take > need {
            take = need
        }
        $piece := []int{}
        $bi := 0
        while bi < d.buf.len {
            piece.push(d.buf[bi] & 255)
            bi = bi + 1
        }
        $j := 0
        while j < take {
            piece.push(p[j] & 255)
            j = j + 1
        }
        i = take
        if piece.len == 128 {
            block := string_from_bytes(piece)
            d.compress_block(&block, 0)
            d.buf = ""
        } else {
            d.buf = string_from_bytes(piece)
        }
    }
    while i + 128 <= n {
        d.compress_block(p, i)
        i += 128
    }
    if i < n {
        $rest := []int{}
        $j := i
        while j < n {
            rest.push(p[j] & 255)
            j = j + 1
        }
        extra := string_from_bytes(rest)
        r := $&d.buf
        r.push_str(extra)
    }
    d.n = d.n + n
    << n
}

pub fn (d $&Digest) reset() {
    d.st = iv()
    d.buf = ""
    d.n = 0
}

pub fn (d Digest) size() int {
    << 64
}

pub fn (d Digest) blocksize() int {
    << 128
}

pub fn (d &Digest) sum() string {
    $tmp := new()
    tmp.st = State{h0: d.st.h0, h1: d.st.h1, h2: d.st.h2, h3: d.st.h3, h4: d.st.h4, h5: d.st.h5, h6: d.st.h6, h7: d.st.h7}
    buf := d.buf + ""
    tail := pad_tail(&buf, 0, d.n)
    $po := 0
    while po + 128 <= tail.len {
        tmp.compress_block(&tail, po)
        po += 128
    }
    << hex.encode_to_string(raw_state(&tmp.st))
}
