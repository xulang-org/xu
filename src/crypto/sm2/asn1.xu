@crypto/sm2

#errors
#math/big
#encoding/asn1

// GM/T 0009 minimal ASN.1: signature SEQUENCE { r, s } INTEGER;
// ciphertext SM2Cipher { XCoordinate, YCoordinate, HASH, CipherText }.
// Not CMS. GMTLS SKE/CKE emit this encoding (raw still accepted).

fn der_int(x &big.Int) string {
    b := x.bytes()
    mut c := []int{}
    if b.len == 0 {
        c.push(0)
    } else {
        if (b[0] & 128) != 0 {
            c.push(0)
        }
        mut i := 0
        while i < b.len {
            c.push(b[i] & 255)
            i = i + 1
        }
    }
    body := string_from_bytes(c)
    mut out := []int{}
    out.push(asn1.tag_integer)
    n := body.len
    if n >= 128 {
        >> errors.new("crypto/sm2: integer too large")
    }
    out.push(n)
    mut j := 0
    while j < n {
        out.push(body[j] & 255)
        j = j + 1
    }
    << string_from_bytes(out)
}

fn parse_der_int(v &asn1.Value) big.Int {
    if v.tag != asn1.tag_integer || v.bytes.len == 0 {
        >> errors.new("crypto/sm2: bad integer")
    }
    raw := v.bytes + ""
    if (raw[0] & 128) != 0 {
        >> errors.new("crypto/sm2: negative integer")
    }
    mut z := big.new_int(0)
    z.set_bytes(raw)
    << z
}

pub fn marshal_sig(sig &string) string {
    if sig.len != 64 {
        >> errors.new("crypto/sm2: bad signature")
    }
    r := from_be32(sig, 0)
    s := from_be32(sig, 32)
    rb := der_int(&r) or >>
    sb := der_int(&s) or >>
    // der_int already emits tag+length+bytes. Concatenate via a byte buffer
    // (string `+` / []string marshal_seq type-asserted under SM2 sign).
    mut acc := []int{}
    mut i := 0
    while i < rb.len {
        acc.push(rb[i] & 255)
        i = i + 1
    }
    i = 0
    while i < sb.len {
        acc.push(sb[i] & 255)
        i = i + 1
    }
    body := string_from_bytes(acc)
    // SEQUENCE (tag 0x30) + short-form length + content
    mut seq := []int{}
    seq.push(48)
    seq.push(body.len)
    mut k := 0
    while k < body.len {
        seq.push(body[k] & 255)
        k = k + 1
    }
    << string_from_bytes(seq)
}

pub fn parse_sig(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if seq.tag != asn1.tag_sequence {
        >> errors.new("crypto/sm2: bad signature")
    }
    sb := seq.bytes + ""
    mut d := asn1.new_decoder(&sb)
    rv := d.next() or >>
    sv := d.next() or >>
    if !d.done() {
        >> errors.new("crypto/sm2: bad signature")
    }
    r := parse_der_int(&rv) or >>
    s := parse_der_int(&sv) or >>
    n := curve_n() or >>
    if r.sign() == 0 || s.sign() == 0 {
        >> errors.new("crypto/sm2: bad signature")
    }
    if r.cmp(&n) >= 0 || s.cmp(&n) >= 0 {
        >> errors.new("crypto/sm2: bad signature")
    }
    rs := pad32(&r)
    ss := pad32(&s)
    << rs + ss
}

fn marshal_cipher(ct &string) string {
    raw := ct + ""
    if raw.len < 97 || (raw[0] & 255) != 4 {
        >> errors.new("crypto/sm2: bad ciphertext")
    }
    x := from_be32(&raw, 1)
    y := from_be32(&raw, 33)
    c3 := raw[65:97] + ""
    c2 := raw[97:raw.len] + ""
    xb := der_int(&x) or >>
    yb := der_int(&y) or >>
    hb := asn1.marshal_octet(&c3)
    cb := asn1.marshal_octet(&c2)
    mut elems := []string{}
    elems.push(xb)
    elems.push(yb)
    elems.push(hb)
    elems.push(cb)
    << asn1.marshal_seq(&elems)
}

fn parse_cipher(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if seq.tag != asn1.tag_sequence {
        >> errors.new("crypto/sm2: bad ciphertext")
    }
    sb := seq.bytes + ""
    mut d := asn1.new_decoder(&sb)
    xv := d.next() or >>
    yv := d.next() or >>
    hv := d.next() or >>
    cv := d.next() or >>
    if !d.done() {
        >> errors.new("crypto/sm2: bad ciphertext")
    }
    if hv.tag != asn1.tag_octet_string || cv.tag != asn1.tag_octet_string {
        >> errors.new("crypto/sm2: bad ciphertext")
    }
    x := parse_der_int(&xv) or >>
    y := parse_der_int(&yv) or >>
    xc := int_clone(&x)
    yc := int_clone(&y)
    if !on_curve(&xc, &yc) {
        >> errors.new("crypto/sm2: point not on curve")
    }
    c1 := encode_xy(&xc, &yc)
    c3 := hv.bytes + ""
    c2 := cv.bytes + ""
    if c3.len != 32 {
        >> errors.new("crypto/sm2: bad ciphertext")
    }
    << c1 + c3 + c2
}

pub fn sign_id_asn1(d &string, id &string, msg &string) string {
    raw := sign_id(d, id, msg) or >>
    raw2 := raw + ""
    z := marshal_sig(&raw2)
    << z
}

pub fn sign_asn1(d &string, msg &string) string {
    id := default_id()
    << sign_id_asn1(d, &id, msg) or >>
}

pub fn verify_id_asn1(pubk &string, id &string, msg &string, der &string) bool {
    raw := parse_sig(der) or (err) {
        << false
    }
    << verify_id(pubk, id, msg, &raw)
}

pub fn verify_asn1(pubk &string, msg &string, der &string) bool {
    id := default_id()
    << verify_id_asn1(pubk, &id, msg, der)
}

pub fn encrypt_asn1(pubk &string, msg &string) string {
    ct := encrypt(pubk, msg) or >>
    << marshal_cipher(&ct)
}

pub fn decrypt_asn1(d &string, der &string) string {
    ct := parse_cipher(der) or >>
    << decrypt(d, &ct)
}
