@crypto/sm2

// XU-CT-USE: fixed-shape-only
// Key consistency equality is narrow; the parent SM2 backend is variable-time.

#errors
#math/big
#encoding/asn1
#encoding/pem
#crypto/subtle

// PKCS#8 (RFC 5208) and SEC1 / RFC 5915 SM2 private keys;
// PKIX SubjectPublicKeyInfo (RFC 5280) public keys.
// PEM types: PRIVATE KEY, EC PRIVATE KEY, SM2 PRIVATE KEY;
// PUBLIC KEY, SM2 PUBLIC KEY.
// Named curve OID 1.2.156.10197.1.301. No encrypted PEM, no compressed points.

fn oid6(a &[]int, a0 int, a1 int, a2 int, a3 int, a4 int, a5 int) bool {
    if a.len != 6 {
        << false
    }
    << a[0] == a0 && a[1] == a1 && a[2] == a2 && a[3] == a3 && a[4] == a4 && a[5] == a5
}

fn oid_ecpubkey(a &[]int) bool {
    << oid6(a, 1, 2, 840, 10045, 2, 1)
}

fn oid_sm2curve(a &[]int) bool {
    << oid6(a, 1, 2, 156, 10197, 1, 301)
}

fn ecpubkey_oid() []int {
    mut a := []int{}
    a.push(1)
    a.push(2)
    a.push(840)
    a.push(10045)
    a.push(2)
    a.push(1)
    << a
}

fn sm2curve_oid() []int {
    mut a := []int{}
    a.push(1)
    a.push(2)
    a.push(156)
    a.push(10197)
    a.push(1)
    a.push(301)
    << a
}

fn der_len_body(tag int, content &string) string {
    n := content.len
    mut out := []int{}
    out.push(tag & 255)
    if n < 128 {
        out.push(n)
    } else {
        >> errors.new("crypto/sm2: der too long")
    }
    mut i := 0
    while i < n {
        out.push(content[i] & 255)
        i = i + 1
    }
    << string_from_bytes(out)
}

fn der_bit(s &string) string {
    mut c := []int{}
    c.push(0)
    mut i := 0
    while i < s.len {
        c.push(s[i] & 255)
        i = i + 1
    }
    body := string_from_bytes(c)
    << der_len_body(asn1.tag_bit_string, &body) or >>
}

fn der_ctx(n int, inner &string) string {
    t := 160 + (n & 31)
    << der_len_body(t, inner) or >>
}

fn pad_d(raw &string) string {
    if raw.len == 0 || raw.len > 32 {
        >> errors.new("crypto/sm2: bad private key")
    }
    if raw.len == 32 {
        << raw + ""
    }
    mut z := big.new_int(0)
    z.set_bytes(raw + "")
    << pad32(&z)
}

fn parse_sec1(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if seq.tag != asn1.tag_sequence {
        >> errors.new("crypto/sm2: bad private key")
    }
    sb := seq.bytes + ""
    mut d := asn1.new_decoder(&sb)
    vv := d.next() or >>
    ver := vv.as_int() or >>
    if ver != 1 {
        >> errors.new("crypto/sm2: bad private key")
    }
    ov := d.next() or >>
    if ov.tag != asn1.tag_octet_string {
        >> errors.new("crypto/sm2: bad private key")
    }
    ob := ov.bytes + ""
    ds := pad_d(&ob) or >>
    parse_d(&ds) or >>
    mut pub_got := ""
    while !d.done() {
        xv := d.next() or >>
        if xv.class != asn1.class_context {
            >> errors.new("crypto/sm2: bad private key")
        }
        xb := xv.bytes + ""
        if xv.tag == 0 {
            pv := asn1.unmarshal(&xb) or >>
            if pv.tag == asn1.tag_oid {
                arcs := pv.as_oid() or >>
                if !oid_sm2curve(&arcs) {
                    >> errors.new("crypto/sm2: bad curve")
                }
            }
        } else if xv.tag == 1 {
            bv := asn1.unmarshal(&xb) or >>
            pub_got = bv.as_bit_string() or >>
        }
    }
    if pub_got.len != 0 {
        want := public(&ds) or >>
        if subtle.constant_time_compare(&want, &pub_got) != 1 {
            >> errors.new("crypto/sm2: public key mismatch")
        }
    }
    << ds
}

fn parse_pkcs8_alg(alg &asn1.Value) int {
    ab := alg.bytes + ""
    mut d := asn1.new_decoder(&ab)
    oidv := d.next() or >>
    arcs := oidv.as_oid() or >>
    if oid_sm2curve(&arcs) {
        << 0
    }
    if !oid_ecpubkey(&arcs) {
        >> errors.new("crypto/sm2: bad algorithm")
    }
    if d.done() {
        >> errors.new("crypto/sm2: bad algorithm")
    }
    pv := d.next() or >>
    if pv.tag != asn1.tag_oid {
        >> errors.new("crypto/sm2: bad algorithm")
    }
    parcs := pv.as_oid() or >>
    if !oid_sm2curve(&parcs) {
        >> errors.new("crypto/sm2: bad curve")
    }
    << 0
}

fn parse_pkcs8(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if seq.tag != asn1.tag_sequence {
        >> errors.new("crypto/sm2: bad private key")
    }
    sb := seq.bytes + ""
    mut d := asn1.new_decoder(&sb)
    vv := d.next() or >>
    ver := vv.as_int() or >>
    if ver != 0 {
        >> errors.new("crypto/sm2: bad private key")
    }
    alg := d.next() or >>
    parse_pkcs8_alg(&alg) or >>
    ov := d.next() or >>
    if ov.tag != asn1.tag_octet_string {
        >> errors.new("crypto/sm2: bad private key")
    }
    inner := ov.bytes + ""
    << parse_sec1(&inner)
}

pub fn parse_private_key(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if seq.tag != asn1.tag_sequence {
        >> errors.new("crypto/sm2: bad private key")
    }
    sb := seq.bytes + ""
    mut d := asn1.new_decoder(&sb)
    vv := d.next() or >>
    ver := vv.as_int() or >>
    if ver == 0 {
        << parse_pkcs8(der)
    }
    if ver == 1 {
        << parse_sec1(der)
    }
    >> errors.new("crypto/sm2: bad private key")
}

fn marshal_sec1_core(d &string, with_params bool) string {
    dv := parse_d(d) or >>
    db := pad32(&dv)
    pubk := public(d) or >>
    v1 := asn1.marshal_int(1)
    oct := asn1.marshal_octet(&db)
    bits := der_bit(&pubk) or >>
    c1 := der_ctx(1, &bits) or >>
    mut elems := []string{}
    elems.push(v1)
    elems.push(oct)
    if with_params {
        arcs := sm2curve_oid()
        so := asn1.marshal_oid(&arcs) or >>
        c0 := der_ctx(0, &so) or >>
        elems.push(c0)
    }
    elems.push(c1)
    << asn1.marshal_seq(&elems)
}

pub fn marshal_sec1(d &string) string {
    << marshal_sec1_core(d, true)
}

pub fn marshal_pkcs8(d &string) string {
    inner := marshal_sec1_core(d, false) or >>
    ver := asn1.marshal_int(0)
    ecp := ecpubkey_oid()
    sm := sm2curve_oid()
    eo := asn1.marshal_oid(&ecp) or >>
    so := asn1.marshal_oid(&sm) or >>
    mut alg_e := []string{}
    alg_e.push(eo)
    alg_e.push(so)
    alg := asn1.marshal_seq(&alg_e)
    oct := asn1.marshal_octet(&inner)
    mut top := []string{}
    top.push(ver)
    top.push(alg)
    top.push(oct)
    << asn1.marshal_seq(&top)
}

pub fn parse_private_pem(text &string) string {
    b := pem.decode(text)
    if b.typ.len == 0 {
        >> errors.new("crypto/sm2: no pem")
    }
    typ := b.typ + ""
    if typ != "PRIVATE KEY" && typ != "EC PRIVATE KEY" && typ != "SM2 PRIVATE KEY" {
        >> errors.new("crypto/sm2: bad pem type")
    }
    raw := b.bytes + ""
    << parse_private_key(&raw)
}

pub fn marshal_pkcs8_pem(d &string) string {
    der := marshal_pkcs8(d) or >>
    keys := []string{}
    vals := []string{}
    rest := ""
    blk := pem.Block{typ: "PRIVATE KEY", keys: keys, vals: vals, bytes: der, rest: rest}
    << pem.encode_to_memory(&blk)
}

pub fn parse_public_key(der &string) string {
    seq := asn1.unmarshal(der) or >>
    if seq.tag != asn1.tag_sequence {
        >> errors.new("crypto/sm2: bad public key")
    }
    sb := seq.bytes + ""
    mut d := asn1.new_decoder(&sb)
    alg := d.next() or >>
    parse_pkcs8_alg(&alg) or >>
    keyv := d.next() or >>
    bits := keyv.as_bit_string() or >>
    parse_pub(&bits) or >>
    << bits
}

pub fn marshal_pkix(pubk &string) string {
    parse_pub(pubk) or >>
    ecp := ecpubkey_oid()
    sm := sm2curve_oid()
    eo := asn1.marshal_oid(&ecp) or >>
    so := asn1.marshal_oid(&sm) or >>
    mut alg_e := []string{}
    alg_e.push(eo)
    alg_e.push(so)
    alg := asn1.marshal_seq(&alg_e)
    bits := der_bit(pubk) or >>
    mut top := []string{}
    top.push(alg)
    top.push(bits)
    << asn1.marshal_seq(&top)
}

pub fn parse_public_pem(text &string) string {
    b := pem.decode(text)
    if b.typ.len == 0 {
        >> errors.new("crypto/sm2: no pem")
    }
    typ := b.typ + ""
    if typ != "PUBLIC KEY" && typ != "SM2 PUBLIC KEY" {
        >> errors.new("crypto/sm2: bad pem type")
    }
    raw := b.bytes + ""
    << parse_public_key(&raw)
}

pub fn marshal_pkix_pem(pubk &string) string {
    der := marshal_pkix(pubk) or >>
    keys := []string{}
    vals := []string{}
    rest := ""
    blk := pem.Block{typ: "PUBLIC KEY", keys: keys, vals: vals, bytes: der, rest: rest}
    << pem.encode_to_memory(&blk)
}
