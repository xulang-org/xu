@crypto/sm2

#errors
#math/big
#crypto/sm3
#crypto/rand
#crypto/subtle

// SM2 (GM/T 0003). Xu addition — Go has no crypto/sm2.
// Recommended curve sm2p256v1 only. Signatures are raw r||s (32+32)
// or GM/T 0009 DER SEQUENCE{r,s}. Ciphertext is c1||C3||c2 (uncompressed
// c1, SM3 C3) or DER SM2Cipher. Default user id is ASCII
// 1234567812345678. Key exchange is GM/T 0003.3 (see exch.xu).
// PKCS#8 / SEC1 private keys and PKIX public keys (see pkcs8.xu). No compressed points, no
// C1C2C3 alias. Zero C, not a commercial-crypto certification.
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only
// math/big curve arithmetic is variable-time; crypto/subtle covers only final
// fixed-shape integrity/equality checks.

pub const PUBLIC_KEY_SIZE = 65
pub const PRIVATE_KEY_SIZE = 32
pub const SIGNATURE_SIZE = 64

fn default_id() string {
    << "1234567812345678"
}

fn parse_d(d &string) big.Int {
    if d.len != 32 {
        >>> errors.new("crypto/sm2: bad private key")
    }
    $z := big.new_int(0)
    z.set_bytes(d + "")
    n := curve_n() >>>
    if z.sign() == 0 || z.cmp(&n) >= 0 {
        >>> errors.new("crypto/sm2: bad private key")
    }
    << z
}

fn parse_pub(s &string) Point {
    if s.len != PUBLIC_KEY_SIZE || (s[0] & 255) != 4 {
        >>> errors.new("crypto/sm2: bad public key")
    }
    x := from_be32(s, 1)
    y := from_be32(s, 33)
    pmod := curve_p() >>>
    if x.sign() < 0 || y.sign() < 0 || x.cmp(&pmod) >= 0 || y.cmp(&pmod) >= 0 {
        >>> errors.new("crypto/sm2: bad public key")
    }
    if !on_curve(&x, &y) {
        >>> errors.new("crypto/sm2: point not on curve")
    }
    << point_affine(&x, &y)
}

fn encode_xy(x &big.Int, y &big.Int) string {
    xs := pad32(x)
    ys := pad32(y)
    $b := []int{}
    b.push(4)
    $i := 0
    while i < 32 {
        b.push(xs[i] & 255)
        i = i + 1
    }
    i = 0
    while i < 32 {
        b.push(ys[i] & 255)
        i = i + 1
    }
    << string_from_bytes(b)
}

fn append_s(b $&[]int, s &string) {
    $i := 0
    while i < s.len {
        b.push(s[i] & 255)
        i = i + 1
    }
}

fn za(id &string, px &big.Int, py &big.Int) string {
    if id.len > 8191 {
        >>> errors.new("crypto/sm2: id too long")
    }
    bits := id.len * 8
    $b := []int{}
    b.push((bits >> 8) & 255)
    b.push(bits & 255)
    append_s($&b, id)
    aa := curve_a() >>>
    bb := curve_b() >>>
    gx := curve_gx() >>>
    gy := curve_gy() >>>
    pa := pad32(&aa)
    pb := pad32(&bb)
    pgx := pad32(&gx)
    pgy := pad32(&gy)
    ppx := pad32(px)
    ppy := pad32(py)
    append_s($&b, &pa)
    append_s($&b, &pb)
    append_s($&b, &pgx)
    append_s($&b, &pgy)
    append_s($&b, &ppx)
    append_s($&b, &ppy)
    s := string_from_bytes(b)
    r := sm3.sum_bytes(s)
    << r
}

fn hash_e(za_raw &string, msg &string) big.Int {
    $b := []int{}
    append_s($&b, za_raw)
    append_s($&b, msg)
    h := sm3.sum_bytes(string_from_bytes(b))
    $e := big.new_int(0)
    e.set_bytes(h)
    << e
}

fn kdf(z &string, klen int) string {
    if klen <= 0 {
        << ""
    }
    $out := []int{}
    $ct := 1
    while out.len < klen {
        $blk := []int{}
        append_s($&blk, z)
        blk.push((ct >> 24) & 255)
        blk.push((ct >> 16) & 255)
        blk.push((ct >> 8) & 255)
        blk.push(ct & 255)
        h := sm3.sum_bytes(string_from_bytes(blk))
        $i := 0
        while i < h.len {
            if out.len < klen {
                out.push(h[i] & 255)
            }
            i = i + 1
        }
        ct = ct + 1
        if ct > 1000000 {
            >>> errors.new("crypto/sm2: kdf overflow")
        }
    }
    << string_from_bytes(out)
}

fn all_zero(s &string) bool {
    if s.len == 0 {
        << false
    }
    $x := 0
    $i := 0
    while i < s.len {
        x = x | (s[i] & 255)
        i = i + 1
    }
    << x == 0
}

fn xor_eq(a &string, b &string) string {
    $out := []int{}
    $i := 0
    while i < a.len {
        out.push((a[i] & 255) ^ (b[i] & 255))
        i = i + 1
    }
    << string_from_bytes(out)
}

fn point_xy(p &Point) Point {
    pmod := curve_p() >>>
    << point_to_xy(p, &pmod)
}

fn za_from_point(id &string, p &Point) string {
    xy := point_xy(p) >>>
    px := int_clone(&xy.x)
    py := int_clone(&xy.y)
    z := za(id, &px, &py)
    << z
}

pub fn public(d &string) string {
    dv := parse_d(d) >>>
    g := base_point() >>>
    pt := scalarmult(&dv, &g) >>>
    xy := point_xy(&pt) >>>
    px := int_clone(&xy.x)
    py := int_clone(&xy.y)
    << encode_xy(&px, &py)
}

pub fn generate_key() string {
    n := curve_n() >>>
    $guard := 0
    while guard < 64 {
        raw := rand.read(32) >>>
        $d := big.new_int(0)
        d.set_bytes(raw)
        if d.sign() != 0 && d.cmp(&n) < 0 {
            << pad32(&d)
        }
        guard = guard + 1
    }
    >>> errors.new("crypto/sm2: key generation failed")
}

pub fn sign_id(d &string, id &string, msg &string) string {
    dv := parse_d(d) >>>
    n := curve_n() >>>
    g := base_point() >>>
    pa := scalarmult(&dv, &g) >>>
    z := za_from_point(id, &pa) >>>
    e := hash_e(&z, msg)
    $one := big.new_int(1)
    $one_d := big.new_int(0)
    one_d.add(&one, &dv)
    $inv := big.new_int(0)
    inv.mod_inverse(&one_d, &n) >>>
    $guard := 0
    while guard < 128 {
        kb := rand.read(32) >>>
        $k_raw := big.new_int(0)
        k_raw.set_bytes(kb)
        $k := big.new_int(0)
        k.mod(&k_raw, &n) >>>
        if k.sign() == 0 {
            guard = guard + 1
            ->
        }
        kg := scalarmult(&k, &g) >>>
        xy := point_xy(&kg) >>>
        x1 := int_clone(&xy.x)
        $r_raw := big.new_int(0)
        r_raw.add(&e, &x1)
        $r := big.new_int(0)
        r.mod(&r_raw, &n) >>>
        if r.sign() == 0 {
            guard = guard + 1
            ->
        }
        $rk := big.new_int(0)
        rk.add(&r, &k)
        if rk.cmp(&n) == 0 {
            guard = guard + 1
            ->
        }
        $rd_raw := big.new_int(0)
        rd_raw.mul(&r, &dv)
        $rd := big.new_int(0)
        rd.mod(&rd_raw, &n) >>>
        $krd_raw := big.new_int(0)
        krd_raw.sub(&k, &rd)
        $krd := big.new_int(0)
        krd.mod(&krd_raw, &n) >>>
        $s_raw := big.new_int(0)
        s_raw.mul(&inv, &krd)
        $s := big.new_int(0)
        s.mod(&s_raw, &n) >>>
        if s.sign() == 0 {
            guard = guard + 1
            ->
        }
        rs := pad32(&r)
        ss := pad32(&s)
        out := rs + ss
        << out
    }
    >>> errors.new("crypto/sm2: sign failed")
}

pub fn sign(d &string, msg &string) string {
    id := default_id()
    << sign_id(d, &id, msg) >>>
}

pub fn verify_id(pubk &string, id &string, msg &string, sig &string) bool {
    if sig.len != 64 {
        << false
    }
    pa := parse_pub(pubk) >>> (err) {
        << false
    }
    n := curve_n() >>> (err) {
        << false
    }
    r := from_be32(sig, 0)
    s := from_be32(sig, 32)
    if r.sign() == 0 || s.sign() == 0 {
        << false
    }
    if r.cmp(&n) >= 0 || s.cmp(&n) >= 0 {
        << false
    }
    z := za_from_point(id, &pa) >>> (err) {
        << false
    }
    e := hash_e(&z, msg)
    $t_raw := big.new_int(0)
    t_raw.add(&r, &s)
    $t := big.new_int(0)
    t.mod(&t_raw, &n) >>> (err) {
        << false
    }
    if t.sign() == 0 {
        << false
    }
    g := base_point() >>> (err) {
        << false
    }
    sg := scalarmult(&s, &g) >>> (err) {
        << false
    }
    tpa := scalarmult(&t, &pa) >>> (err) {
        << false
    }
    pmod := curve_p() >>> (err) {
        << false
    }
    sum := point_add(&sg, &tpa, &pmod) >>> (err) {
        << false
    }
    if is_inf(&sum) {
        << false
    }
    xy := point_to_xy(&sum, &pmod) >>> (err) {
        << false
    }
    x1 := int_clone(&xy.x)
    $rx_raw := big.new_int(0)
    rx_raw.add(&e, &x1)
    $rx := big.new_int(0)
    rx.mod(&rx_raw, &n) >>> (err) {
        << false
    }
    << rx.cmp(&r) == 0
}

pub fn verify(pubk &string, msg &string, sig &string) bool {
    id := default_id()
    << verify_id(pubk, &id, msg, sig)
}

fn sm3_c3(x2 &string, msg &string, y2 &string) string {
    $b := []int{}
    append_s($&b, x2)
    append_s($&b, msg)
    append_s($&b, y2)
    s := string_from_bytes(b)
    r := sm3.sum_bytes(s)
    << r
}

pub fn encrypt(pubk &string, msg &string) string {
    pb := parse_pub(pubk) >>>
    n := curve_n() >>>
    g := base_point() >>>
    $guard := 0
    while guard < 128 {
        kb := rand.read(32) >>>
        $k_raw := big.new_int(0)
        k_raw.set_bytes(kb)
        $k := big.new_int(0)
        k.mod(&k_raw, &n) >>>
        if k.sign() == 0 {
            guard = guard + 1
            ->
        }
        c1p := scalarmult(&k, &g) >>>
        if is_inf(&c1p) {
            guard = guard + 1
            ->
        }
        xy1 := point_xy(&c1p) >>>
        x1 := int_clone(&xy1.x)
        y1 := int_clone(&xy1.y)
        s := scalarmult(&k, &pb) >>>
        if is_inf(&s) {
            guard = guard + 1
            ->
        }
        xy2 := point_xy(&s) >>>
        x2 := int_clone(&xy2.x)
        y2 := int_clone(&xy2.y)
        x2b := pad32(&x2)
        y2b := pad32(&y2)
        zb := x2b + y2b
        t := kdf(&zb, msg.len) >>>
        if all_zero(&t) {
            guard = guard + 1
            ->
        }
        c2 := xor_eq(msg, &t)
        c3 := sm3_c3(&x2b, msg, &y2b)
        c1 := encode_xy(&x1, &y1)
        << c1 + c3 + c2
    }
    >>> errors.new("crypto/sm2: encrypt failed")
}

pub fn decrypt(d &string, ct &string) string {
    raw := ct + ""
    if raw.len < 97 {
        >>> errors.new("crypto/sm2: bad ciphertext")
    }
    dv := parse_d(d) >>>
    c1 := raw[0:PUBLIC_KEY_SIZE] + ""
    c3 := raw[PUBLIC_KEY_SIZE:97] + ""
    c2 := raw[97:raw.len] + ""
    if c3.len != 32 {
        >>> errors.new("crypto/sm2: bad ciphertext")
    }
    pb := parse_pub(&c1) >>>
    s := scalarmult(&dv, &pb) >>>
    if is_inf(&s) {
        >>> errors.new("crypto/sm2: decryption error")
    }
    xy2 := point_xy(&s) >>>
    x2 := int_clone(&xy2.x)
    y2 := int_clone(&xy2.y)
    x2b := pad32(&x2)
    y2b := pad32(&y2)
    zb := x2b + y2b
    t := kdf(&zb, c2.len) >>>
    if all_zero(&t) {
        >>> errors.new("crypto/sm2: decryption error")
    }
    m := xor_eq(&c2, &t)
    u := sm3_c3(&x2b, &m, &y2b)
    if subtle.constant_time_compare(&u, &c3) != 1 {
        >>> errors.new("crypto/sm2: decryption error")
    }
    << m + ""
}
