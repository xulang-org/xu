@crypto/sm2

#errors
#math/big
#crypto/sm3
#crypto/rand
#crypto/subtle

// SM2 (GM/T 0003). Xu addition — Go has no crypto/sm2.
// Recommended curve sm2p256v1 only. Signatures are raw r||s (32+32)
// or GM/T 0009 DER SEQUENCE{r,s}. Ciphertext is c1||C3||c2 (uncompressed
// c1, SM3 C3) or DER SM2Cipher. Default user id is ASCII
// 1234567812345678. Key exchange is GM/T 0003.3 (see exch.xu).
// PKCS#8 / SEC1 private keys and PKIX public keys (see pkcs8.xu). No compressed points, no
// C1C2C3 alias. Zero C, not a commercial-crypto certification.
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only
// math/big curve arithmetic is variable-time; crypto/subtle covers only final
// fixed-shape integrity/equality checks.

pub const public_key_size = 65
pub const private_key_size = 32
pub const signature_size = 64

fn default_id() string {
    << "1234567812345678"
}

fn parse_d(d &string) big.Int {
    if d.len != 32 {
        >> errors.new("crypto/sm2: bad private key")
    }
    mut z := big.new_int(0)
    z.set_bytes(d + "")
    n := curve_n() or >>
    if z.sign() == 0 || z.cmp(&n) >= 0 {
        >> errors.new("crypto/sm2: bad private key")
    }
    << z
}

fn parse_pub(s &string) Point {
    if s.len != 65 || (s[0] & 255) != 4 {
        >> errors.new("crypto/sm2: bad public key")
    }
    x := from_be32(s, 1)
    y := from_be32(s, 33)
    pmod := curve_p() or >>
    if x.sign() < 0 || y.sign() < 0 || x.cmp(&pmod) >= 0 || y.cmp(&pmod) >= 0 {
        >> errors.new("crypto/sm2: bad public key")
    }
    if !on_curve(&x, &y) {
        >> errors.new("crypto/sm2: point not on curve")
    }
    << point_affine(&x, &y)
}

fn encode_xy(x &big.Int, y &big.Int) string {
    xs := pad32(x)
    ys := pad32(y)
    mut b := []int{}
    b.push(4)
    mut i := 0
    while i < 32 {
        b.push(xs[i] & 255)
        i = i + 1
    }
    i = 0
    while i < 32 {
        b.push(ys[i] & 255)
        i = i + 1
    }
    << string_from_bytes(b)
}

fn append_s(b &mut []int, s &string) {
    mut i := 0
    while i < s.len {
        b.push(s[i] & 255)
        i = i + 1
    }
}

fn za(id &string, px &big.Int, py &big.Int) string {
    if id.len > 8191 {
        >> errors.new("crypto/sm2: id too long")
    }
    bits := id.len * 8
    mut b := []int{}
    b.push((bits >> 8) & 255)
    b.push(bits & 255)
    append_s(mut &b, id)
    aa := curve_a() or >>
    bb := curve_b() or >>
    gx := curve_gx() or >>
    gy := curve_gy() or >>
    pa := pad32(&aa)
    pb := pad32(&bb)
    pgx := pad32(&gx)
    pgy := pad32(&gy)
    ppx := pad32(px)
    ppy := pad32(py)
    append_s(mut &b, &pa)
    append_s(mut &b, &pb)
    append_s(mut &b, &pgx)
    append_s(mut &b, &pgy)
    append_s(mut &b, &ppx)
    append_s(mut &b, &ppy)
    s := string_from_bytes(b)
    r := sm3.sum_bytes(s)
    << r
}

fn hash_e(za_raw &string, msg &string) big.Int {
    mut b := []int{}
    append_s(mut &b, za_raw)
    append_s(mut &b, msg)
    h := sm3.sum_bytes(string_from_bytes(b))
    mut e := big.new_int(0)
    e.set_bytes(h)
    << e
}

fn kdf(z &string, klen int) string {
    if klen <= 0 {
        << ""
    }
    mut out := []int{}
    mut ct := 1
    while out.len < klen {
        mut blk := []int{}
        append_s(mut &blk, z)
        blk.push((ct >> 24) & 255)
        blk.push((ct >> 16) & 255)
        blk.push((ct >> 8) & 255)
        blk.push(ct & 255)
        h := sm3.sum_bytes(string_from_bytes(blk))
        mut i := 0
        while i < h.len {
            if out.len < klen {
                out.push(h[i] & 255)
            }
            i = i + 1
        }
        ct = ct + 1
        if ct > 1000000 {
            >> errors.new("crypto/sm2: kdf overflow")
        }
    }
    << string_from_bytes(out)
}

fn all_zero(s &string) bool {
    if s.len == 0 {
        << false
    }
    mut x := 0
    mut i := 0
    while i < s.len {
        x = x | (s[i] & 255)
        i = i + 1
    }
    << x == 0
}

fn xor_eq(a &string, b &string) string {
    mut out := []int{}
    mut i := 0
    while i < a.len {
        out.push((a[i] & 255) ^ (b[i] & 255))
        i = i + 1
    }
    << string_from_bytes(out)
}

fn point_xy(p &Point) Point {
    pmod := curve_p() or >>
    << point_to_xy(p, &pmod)
}

fn za_from_point(id &string, p &Point) string {
    xy := point_xy(p) or >>
    px := int_clone(&xy.x)
    py := int_clone(&xy.y)
    z := za(id, &px, &py)
    << z
}

pub fn public(d &string) string {
    dv := parse_d(d) or >>
    g := base_point() or >>
    pt := scalarmult(&dv, &g) or >>
    xy := point_xy(&pt) or >>
    px := int_clone(&xy.x)
    py := int_clone(&xy.y)
    << encode_xy(&px, &py)
}

pub fn generate_key() string {
    n := curve_n() or >>
    mut guard := 0
    while guard < 64 {
        raw := rand.read(32) or >>
        mut d := big.new_int(0)
        d.set_bytes(raw)
        if d.sign() != 0 && d.cmp(&n) < 0 {
            << pad32(&d)
        }
        guard = guard + 1
    }
    >> errors.new("crypto/sm2: key generation failed")
}

pub fn sign_id(d &string, id &string, msg &string) string {
    dv := parse_d(d) or >>
    n := curve_n() or >>
    g := base_point() or >>
    pa := scalarmult(&dv, &g) or >>
    z := za_from_point(id, &pa) or >>
    e := hash_e(&z, msg)
    mut one := big.new_int(1)
    mut one_d := big.new_int(0)
    one_d.add(&one, &dv)
    mut inv := big.new_int(0)
    inv.mod_inverse(&one_d, &n) or >>
    mut guard := 0
    while guard < 128 {
        kb := rand.read(32) or >>
        mut k := big.new_int(0)
        k.set_bytes(kb)
        k.mod(&k, &n) or >>
        if k.sign() == 0 {
            guard = guard + 1
            ->
        }
        kg := scalarmult(&k, &g) or >>
        xy := point_xy(&kg) or >>
        x1 := int_clone(&xy.x)
        mut r := big.new_int(0)
        r.add(&e, &x1)
        r.mod(&r, &n) or >>
        if r.sign() == 0 {
            guard = guard + 1
            ->
        }
        mut rk := big.new_int(0)
        rk.add(&r, &k)
        if rk.cmp(&n) == 0 {
            guard = guard + 1
            ->
        }
        mut rd := big.new_int(0)
        rd.mul(&r, &dv)
        rd.mod(&rd, &n) or >>
        mut krd := big.new_int(0)
        krd.sub(&k, &rd)
        krd.mod(&krd, &n) or >>
        mut s := big.new_int(0)
        s.mul(&inv, &krd)
        s.mod(&s, &n) or >>
        if s.sign() == 0 {
            guard = guard + 1
            ->
        }
        rs := pad32(&r)
        ss := pad32(&s)
        out := rs + ss
        << out
    }
    >> errors.new("crypto/sm2: sign failed")
}

pub fn sign(d &string, msg &string) string {
    id := default_id()
    << sign_id(d, &id, msg) or >>
}

pub fn verify_id(pubk &string, id &string, msg &string, sig &string) bool {
    if sig.len != 64 {
        << false
    }
    pa := parse_pub(pubk) or (err) {
        << false
    }
    n := curve_n() or (err) {
        << false
    }
    r := from_be32(sig, 0)
    s := from_be32(sig, 32)
    if r.sign() == 0 || s.sign() == 0 {
        << false
    }
    if r.cmp(&n) >= 0 || s.cmp(&n) >= 0 {
        << false
    }
    z := za_from_point(id, &pa) or (err) {
        << false
    }
    e := hash_e(&z, msg)
    mut t := big.new_int(0)
    t.add(&r, &s)
    t.mod(&t, &n) or (err) {
        << false
    }
    if t.sign() == 0 {
        << false
    }
    g := base_point() or (err) {
        << false
    }
    sg := scalarmult(&s, &g) or (err) {
        << false
    }
    tpa := scalarmult(&t, &pa) or (err) {
        << false
    }
    pmod := curve_p() or (err) {
        << false
    }
    sum := point_add(&sg, &tpa, &pmod) or (err) {
        << false
    }
    if is_inf(&sum) {
        << false
    }
    xy := point_to_xy(&sum, &pmod) or (err) {
        << false
    }
    x1 := int_clone(&xy.x)
    mut rx := big.new_int(0)
    rx.add(&e, &x1)
    rx.mod(&rx, &n) or (err) {
        << false
    }
    << rx.cmp(&r) == 0
}

pub fn verify(pubk &string, msg &string, sig &string) bool {
    id := default_id()
    << verify_id(pubk, &id, msg, sig)
}

fn sm3_c3(x2 &string, msg &string, y2 &string) string {
    mut b := []int{}
    append_s(mut &b, x2)
    append_s(mut &b, msg)
    append_s(mut &b, y2)
    s := string_from_bytes(b)
    r := sm3.sum_bytes(s)
    << r
}

pub fn encrypt(pubk &string, msg &string) string {
    pb := parse_pub(pubk) or >>
    n := curve_n() or >>
    g := base_point() or >>
    mut guard := 0
    while guard < 128 {
        kb := rand.read(32) or >>
        mut k := big.new_int(0)
        k.set_bytes(kb)
        k.mod(&k, &n) or >>
        if k.sign() == 0 {
            guard = guard + 1
            ->
        }
        c1p := scalarmult(&k, &g) or >>
        if is_inf(&c1p) {
            guard = guard + 1
            ->
        }
        xy1 := point_xy(&c1p) or >>
        x1 := int_clone(&xy1.x)
        y1 := int_clone(&xy1.y)
        s := scalarmult(&k, &pb) or >>
        if is_inf(&s) {
            guard = guard + 1
            ->
        }
        xy2 := point_xy(&s) or >>
        x2 := int_clone(&xy2.x)
        y2 := int_clone(&xy2.y)
        x2b := pad32(&x2)
        y2b := pad32(&y2)
        zb := x2b + y2b
        t := kdf(&zb, msg.len) or >>
        if all_zero(&t) {
            guard = guard + 1
            ->
        }
        c2 := xor_eq(msg, &t)
        c3 := sm3_c3(&x2b, msg, &y2b)
        c1 := encode_xy(&x1, &y1)
        << c1 + c3 + c2
    }
    >> errors.new("crypto/sm2: encrypt failed")
}

pub fn decrypt(d &string, ct &string) string {
    raw := ct + ""
    if raw.len < 97 {
        >> errors.new("crypto/sm2: bad ciphertext")
    }
    dv := parse_d(d) or >>
    c1 := raw[0:65] + ""
    c3 := raw[65:97] + ""
    c2 := raw[97:raw.len] + ""
    if c3.len != 32 {
        >> errors.new("crypto/sm2: bad ciphertext")
    }
    pb := parse_pub(&c1) or >>
    s := scalarmult(&dv, &pb) or >>
    if is_inf(&s) {
        >> errors.new("crypto/sm2: decryption error")
    }
    xy2 := point_xy(&s) or >>
    x2 := int_clone(&xy2.x)
    y2 := int_clone(&xy2.y)
    x2b := pad32(&x2)
    y2b := pad32(&y2)
    zb := x2b + y2b
    t := kdf(&zb, c2.len) or >>
    if all_zero(&t) {
        >> errors.new("crypto/sm2: decryption error")
    }
    m := xor_eq(&c2, &t)
    u := sm3_c3(&x2b, &m, &y2b)
    if subtle.constant_time_compare(&u, &c3) != 1 {
        >> errors.new("crypto/sm2: decryption error")
    }
    << m + ""
}
