@crypto/sm2

#errors
#encoding/asn1
#math/big
#crypto/rand

// NIST ECDSA verification helpers shared with crypto/ecdsa and crypto/x509.
// The Jacobian formulas in curve.xu are generic for short-Weierstrass curves
// with a = p-3, which includes P-256, P-384 and P-521 as well as sm2p256v1.
// Keeping the point arithmetic in one standard-library package avoids a
// second security-sensitive copy; no compiler/core special case is involved.

const nist_curve_p256 = 256
const nist_curve_p384 = 384
const nist_curve_p521 = 521

struct NistSignature {
    r big.Int
    s big.Int
}

fn nist_size(curve int) int {
    if curve == nist_curve_p256 { << 32 }
    if curve == nist_curve_p384 { << 48 }
    if curve == nist_curve_p521 { << 66 }
    << 0
}

fn nist_bits(curve int) int {
    if curve == nist_curve_p256 { << 256 }
    if curve == nist_curve_p384 { << 384 }
    if curve == nist_curve_p521 { << 521 }
    << 0
}

fn nist_p(curve int) big.Int {
    mut z := big.new_int(0)
    if curve == nist_curve_p256 {
        z.set_string("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff", 16) or >>
    } else if curve == nist_curve_p384 {
        z.set_string("fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff", 16) or >>
    } else if curve == nist_curve_p521 {
        z.set_string("01ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", 16) or >>
    } else {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    << z
}

fn nist_n(curve int) big.Int {
    mut z := big.new_int(0)
    if curve == nist_curve_p256 {
        z.set_string("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551", 16) or >>
    } else if curve == nist_curve_p384 {
        z.set_string("ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973", 16) or >>
    } else if curve == nist_curve_p521 {
        z.set_string("01fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409", 16) or >>
    } else {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    << z
}

fn nist_b(curve int) big.Int {
    mut z := big.new_int(0)
    if curve == nist_curve_p256 {
        z.set_string("5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b", 16) or >>
    } else if curve == nist_curve_p384 {
        z.set_string("b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef", 16) or >>
    } else if curve == nist_curve_p521 {
        z.set_string("0051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00", 16) or >>
    } else {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    << z
}

fn nist_gx(curve int) big.Int {
    mut z := big.new_int(0)
    if curve == nist_curve_p256 {
        z.set_string("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296", 16) or >>
    } else if curve == nist_curve_p384 {
        z.set_string("aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7", 16) or >>
    } else if curve == nist_curve_p521 {
        z.set_string("00c6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66", 16) or >>
    } else {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    << z
}

fn nist_gy(curve int) big.Int {
    mut z := big.new_int(0)
    if curve == nist_curve_p256 {
        z.set_string("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5", 16) or >>
    } else if curve == nist_curve_p384 {
        z.set_string("3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f", 16) or >>
    } else if curve == nist_curve_p521 {
        z.set_string("011839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650", 16) or >>
    } else {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    << z
}

fn nist_base_point(curve int) Point {
    gx := nist_gx(curve) or >>
    gy := nist_gy(curve) or >>
    << point_affine(&gx, &gy)
}

fn nist_on_curve(curve int, x &big.Int, y &big.Int) bool {
    pmod := nist_p(curve) or >>
    bb := nist_b(curve) or >>
    y2 := fe_sq(y, &pmod) or >>
    x2 := fe_sq(x, &pmod) or >>
    x3 := fe_mul(&x2, x, &pmod) or >>
    three_x0 := fe_add(x, x, &pmod) or >>
    three_x := fe_add(&three_x0, x, &pmod) or >>
    rhs0 := fe_sub(&x3, &three_x, &pmod) or >>
    rhs := fe_add(&rhs0, &bb, &pmod) or >>
    << y2.cmp(&rhs) == 0
}

fn nist_from_be(raw &string, off int, size int) big.Int {
    mut b := []int{}
    mut i := 0
    while i < size {
        b.push(raw[off + i] & 255)
        i = i + 1
    }
    mut z := big.new_int(0)
    z.set_bytes(string_from_bytes(b))
    << z
}

fn nist_parse_public(curve int, raw &string) Point {
    size := nist_size(curve)
    if size == 0 || raw.len != 1 + size * 2 || (raw[0] & 255) != 4 {
        >> errors.new("crypto/ecdsa: invalid public key")
    }
    x := nist_from_be(raw, 1, size)
    y := nist_from_be(raw, 1 + size, size)
    pmod := nist_p(curve) or >>
    if x.sign() < 0 || y.sign() < 0 || x.cmp(&pmod) >= 0 || y.cmp(&pmod) >= 0 {
        >> errors.new("crypto/ecdsa: invalid public key")
    }
    if !nist_on_curve(curve, &x, &y) {
        >> errors.new("crypto/ecdsa: point not on curve")
    }
    << point_affine(&x, &y)
}

fn nist_der_int(v asn1.Value, size int) big.Int {
    if v.tag != asn1.tag_integer || v.bytes.len == 0 || v.bytes.len > size + 1 {
        >> errors.new("crypto/ecdsa: invalid signature")
    }
    if (v.bytes[0] & 128) != 0 {
        >> errors.new("crypto/ecdsa: negative signature integer")
    }
    if v.bytes.len > 1 && (v.bytes[0] & 255) == 0 && (v.bytes[1] & 128) == 0 {
        >> errors.new("crypto/ecdsa: non-minimal signature integer")
    }
    mut b := []int{}
    for i in 0:v.bytes.len {
        b.push(v.bytes[i] & 255)
    }
    mut z := big.new_int(0)
    z.set_bytes(string_from_bytes(b))
    << z
}

fn nist_parse_signature(raw &string, size int) NistSignature {
    top := asn1.unmarshal(raw) or >>
    if top.tag != asn1.tag_sequence || top.constructed == 0 || top.rest.len != 0 {
        >> errors.new("crypto/ecdsa: invalid signature")
    }
    mut d := asn1.new_decoder(&top.bytes)
    rv := d.next() or >>
    sv := d.next() or >>
    if !d.done() {
        >> errors.new("crypto/ecdsa: trailing signature data")
    }
    r := nist_der_int(rv, size) or >>
    s := nist_der_int(sv, size) or >>
    << NistSignature{r: r, s: s}
}

fn nist_scalar_mult(k &big.Int, p &Point, pmod &big.Int, bits int) Point {
    mut r := point_inf()
    mut i := bits - 1
    while i >= 0 {
        nxt := point_dbl(&r, pmod) or >>
        r = nxt
        if k.bit(i) == 1 {
            nxt2 := point_add(&r, p, pmod) or >>
            r = nxt2
        }
        i = i - 1
    }
    << r
}

fn nist_pad(x &big.Int, size int) string {
    b := x.bytes()
    mut out := []int{}
    for _ in 0:size {
        out.push(0)
    }
    if b.len > size {
        >> errors.new("crypto/ecdsa: scalar too large")
    }
    off := size - b.len
    mut i := 0
    while i < b.len {
        out[off + i] = b[i] & 255
        i = i + 1
    }
    << string_from_bytes(out)
}

fn nist_parse_private(curve int, private_key &string) big.Int {
    size := nist_size(curve)
    if size == 0 || private_key.len != size {
        >> errors.new("crypto/ecdsa: invalid private key")
    }
    mut d := big.new_int(0)
    d.set_bytes(private_key + "")
    n := nist_n(curve) or >>
    if d.sign() <= 0 || d.cmp(&n) >= 0 {
        >> errors.new("crypto/ecdsa: invalid private key")
    }
    << d
}

fn nist_hash_int(curve int, hash &string) big.Int {
    if hash.len == 0 {
        >> errors.new("crypto/ecdsa: empty hash")
    }
    n := nist_n(curve) or >>
    order_bits := n.bit_len()
    order_bytes := (order_bits + 7) / 8
    mut limit := hash.len
    if limit > order_bytes {
        limit = order_bytes
    }
    mut hb := []int{}
    for i in 0:limit {
        hb.push(hash[i] & 255)
    }
    mut e := big.new_int(0)
    e.set_bytes(string_from_bytes(hb))
    excess := limit * 8 - order_bits
    if excess > 0 {
        e.rsh(&e, excess)
    }
    << e
}

// Rejection sampling avoids the modulo bias of reducing random bytes mod n.
// P-521 uses 66 bytes for 521 bits, so the seven unused high bits are cleared
// before the range check.
fn nist_random_scalar(curve int) big.Int {
    size := nist_size(curve)
    bits := nist_bits(curve)
    if size == 0 || bits == 0 {
        >> errors.new("crypto/ecdsa: unsupported curve")
    }
    n := nist_n(curve) or >>
    mut guard := 0
    while guard < 128 {
        raw := rand.read(size) or >>
        mut b := []int{}
        for i in 0:raw.len {
            b.push(raw[i] & 255)
        }
        excess := size * 8 - bits
        if excess > 0 {
            b[0] = b[0] & (255 >> excess)
        }
        mut k := big.new_int(0)
        k.set_bytes(string_from_bytes(b))
        if k.sign() > 0 && k.cmp(&n) < 0 {
            << k
        }
        guard = guard + 1
    }
    >> errors.new("crypto/ecdsa: secure random scalar generation failed")
}

fn nist_der_encode_int(x &big.Int) string {
    b := x.bytes()
    mut body := []int{}
    if b.len == 0 {
        body.push(0)
    } else {
        if (b[0] & 128) != 0 {
            body.push(0)
        }
        for i in 0:b.len {
            body.push(b[i] & 255)
        }
    }
    // NIST curve scalars are at most 66 bytes, so the INTEGER content always
    // uses DER's one-byte short-form length.
    mut out := []int{}
    out.push(asn1.tag_integer)
    out.push(body.len)
    for i in 0:body.len {
        out.push(body[i])
    }
    << string_from_bytes(out)
}

fn nist_marshal_signature(r &big.Int, s &big.Int) string {
    rb := nist_der_encode_int(r)
    sb := nist_der_encode_int(s)
    mut elems := []string{}
    elems.push(rb)
    elems.push(sb)
    << asn1.marshal_seq(&elems)
}

// These helpers are exported for crypto/ecdsa. Xu currently has no
// package-private visibility, so the nist_ prefix keeps the shared surface
// explicit without moving cryptographic algorithms into compiler/core.
pub fn nist_generate_key(curve int) string {
    d := nist_random_scalar(curve) or >>
    << nist_pad(&d, nist_size(curve))
}

pub fn nist_public(curve int, private_key &string) string {
    d := nist_parse_private(curve, private_key) or >>
    pmod := nist_p(curve) or >>
    g := nist_base_point(curve) or >>
    q := nist_scalar_mult(&d, &g, &pmod, nist_bits(curve)) or >>
    if is_inf(&q) {
        >> errors.new("crypto/ecdsa: invalid private key")
    }
    xy := point_to_xy(&q, &pmod) or >>
    size := nist_size(curve)
    xb := nist_pad(&xy.x, size) or >>
    yb := nist_pad(&xy.y, size) or >>
    << string_from_byte(4) + xb + yb
}

pub fn nist_check_public(curve int, public_key &string) int {
    nist_parse_public(curve, public_key) or >>
    << 0
}

// NIST ECDH primitive shared by crypto/ecdsa and protocol packages. The
// result is the fixed-width affine X coordinate defined by SEC 1. Public-key
// parsing rejects compressed/off-curve points; all supported curves have
// cofactor one.
pub fn nist_ecdh(curve int, private_key &string, peer_public &string) string {
    d := nist_parse_private(curve, private_key) or >>
    q := nist_parse_public(curve, peer_public) or >>
    pmod := nist_p(curve) or >>
    shared := nist_scalar_mult(&d, &q, &pmod, nist_bits(curve)) or >>
    if is_inf(&shared) {
        >> errors.new("crypto/ecdsa: invalid shared point")
    }
    xy := point_to_xy(&shared, &pmod) or >>
    << nist_pad(&xy.x, nist_size(curve))
}

pub fn nist_sign_asn1(curve int, private_key &string, hash &string) string {
    d := nist_parse_private(curve, private_key) or >>
    e := nist_hash_int(curve, hash) or >>
    n := nist_n(curve) or >>
    pmod := nist_p(curve) or >>
    g := nist_base_point(curve) or >>
    mut guard := 0
    while guard < 128 {
        k := nist_random_scalar(curve) or >>
        kp := nist_scalar_mult(&k, &g, &pmod, nist_bits(curve)) or >>
        xy := point_to_xy(&kp, &pmod) or >>
        mut r := big.new_int(0)
        r.mod(&xy.x, &n) or >>
        if r.sign() == 0 {
            guard = guard + 1
            ->
        }
        mut rd := big.new_int(0)
        rd.mul(&r, &d)
        mut sum := big.new_int(0)
        sum.add(&e, &rd)
        sum.mod(&sum, &n) or >>
        mut kinv := big.new_int(0)
        kinv.mod_inverse(&k, &n) or >>
        mut s := big.new_int(0)
        s.mul(&kinv, &sum)
        s.mod(&s, &n) or >>
        if s.sign() != 0 {
            << nist_marshal_signature(&r, &s)
        }
        guard = guard + 1
    }
    >> errors.new("crypto/ecdsa: signing failed")
}

fn nist_verify_inner(curve int, public_key &string, hash &string, signature &string) bool {
    if hash.len == 0 {
        << false
    }
    size := nist_size(curve)
    bits := nist_bits(curve)
    if size == 0 || bits == 0 {
        << false
    }
    q := nist_parse_public(curve, public_key) or >>
    sig := nist_parse_signature(signature, size) or >>
    n := nist_n(curve) or >>
    mut r := big.new_int(0)
    r.set(&sig.r)
    mut s := big.new_int(0)
    s.set(&sig.s)
    if r.sign() <= 0 || s.sign() <= 0 || r.cmp(&n) >= 0 || s.cmp(&n) >= 0 {
        << false
    }

    // ECDSA converts the leftmost min(hashBits, orderBits) bits to e.
    e := nist_hash_int(curve, hash) or >>

    mut w := big.new_int(0)
    w.mod_inverse(&s, &n) or >>
    mut u1 := big.new_int(0)
    u1.mul(&e, &w)
    u1.mod(&u1, &n) or >>
    mut u2 := big.new_int(0)
    u2.mul(&r, &w)
    u2.mod(&u2, &n) or >>

    pmod := nist_p(curve) or >>
    g := nist_base_point(curve) or >>
    p1 := nist_scalar_mult(&u1, &g, &pmod, bits) or >>
    p2 := nist_scalar_mult(&u2, &q, &pmod, bits) or >>
    sum := point_add(&p1, &p2, &pmod) or >>
    if is_inf(&sum) {
        << false
    }
    xy := point_to_xy(&sum, &pmod) or >>
    mut x := big.new_int(0)
    x.mod(&xy.x, &n) or >>
    << x.cmp(&r) == 0
}

// verify_p256_asn1 verifies a DER ECDSA signature over a precomputed hash.
// It deliberately returns false for malformed inputs, matching Go's
// ecdsa.VerifyASN1 contract.
pub fn verify_p256_asn1(public_key &string, hash &string, signature &string) bool {
    << nist_verify_inner(nist_curve_p256, public_key, hash, signature) or (err) { << false }
}

pub fn verify_p384_asn1(public_key &string, hash &string, signature &string) bool {
    << nist_verify_inner(nist_curve_p384, public_key, hash, signature) or (err) { << false }
}

pub fn verify_p521_asn1(public_key &string, hash &string, signature &string) bool {
    << nist_verify_inner(nist_curve_p521, public_key, hash, signature) or (err) { << false }
}
