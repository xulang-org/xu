@crypto/sm2

// XU-CT-USE: fixed-shape-only
// Confirmation equality is narrow; the parent SM2 backend is variable-time.

#errors
#math/big
#crypto/sm3
#crypto/subtle

// GM/T 0003.3 / GB/T 32918.3 SM2 key exchange. w=127.
// Initiator: exch_new → init_r → confirm_responder.
// Responder: exch_new → respond_r → confirm_initiator.
// Optional SM3 MACs use prefixes 0x02 / 0x03. No ASN.1.

pub struct ExchCap {
    pub point string
    pub mac string
    pub key string
}

pub struct Exch {
    gen_sig bool
    klen int
    uid string
    peer string
    d big.Int
    peer_pub Point
    za_self string
    za_peer string
    r big.Int
    secret Point
    peer_sec Point
    uv Point
    ready int
}

fn parse_r(s &string) big.Int {
    if s.len == 0 || s.len > 32 {
        >> errors.new("crypto/sm2: bad scalar")
    }
    mut z := big.new_int(0)
    z.set_bytes(s + "")
    n := curve_n() or >>
    if z.sign() == 0 || z.cmp(&n) >= 0 {
        >> errors.new("crypto/sm2: bad scalar")
    }
    << z
}

fn xhat(x &big.Int) big.Int {
    s := pad32(x)
    mut b := []int{}
    mut i := 0
    while i < 16 {
        b.push(0)
        i = i + 1
    }
    b.push((s[16] & 127) | 128)
    i = 17
    while i < 32 {
        b.push(s[i] & 255)
        i = i + 1
    }
    mut z := big.new_int(0)
    z.set_bytes(string_from_bytes(b))
    << z
}

fn point_xy_bytes(p &Point) string {
    xy := point_xy(p) or >>
    xc := int_clone(&xy.x)
    yc := int_clone(&xy.y)
    xs := pad32(&xc)
    ys := pad32(&yc)
    << xs + ys
}

fn encode_point(p &Point) string {
    xy := point_xy(p) or >>
    px := int_clone(&xy.x)
    py := int_clone(&xy.y)
    << encode_xy(&px, &py)
}

fn shared_point(t &big.Int, peer_static &Point, peer_eph &Point) Point {
    xy := point_xy(peer_eph) or >>
    x2 := int_clone(&xy.x)
    x2b := xhat(&x2)
    xrb := scalarmult(&x2b, peer_eph) or >>
    pmod := curve_p() or >>
    sum := point_add(peer_static, &xrb, &pmod) or >>
    if is_inf(&sum) {
        >> errors.new("crypto/sm2: invalid peer")
    }
    u := scalarmult(t, &sum) or >>
    if is_inf(&u) {
        >> errors.new("crypto/sm2: invalid shared point")
    }
    << u
}

fn compute_shared(e &mut Exch) Point {
    sec := point_copy(&e.secret)
    xy := point_xy(&sec) or >>
    xown := int_clone(&xy.x)
    xb := xhat(&xown)
    n := curve_n() or >>
    mut tmp := big.new_int(0)
    rc := int_clone(&e.r)
    tmp.mul(&xb, &rc)
    tmp.mod(&tmp, &n) or >>
    dc := int_clone(&e.d)
    mut t := big.new_int(0)
    t.add(&tmp, &dc)
    t.mod(&t, &n) or >>
    if t.sign() == 0 {
        >> errors.new("crypto/sm2: bad t")
    }
    psp := point_copy(&e.peer_sec)
    pstat := point_copy(&e.peer_pub)
    << shared_point(&t, &pstat, &psp)
}

fn exch_mac(e &mut Exch, is_resp bool, prefix int) string {
    uvp := point_copy(&e.uv)
    xy := point_xy(&uvp) or >>
    xc := int_clone(&xy.x)
    yc := int_clone(&xy.y)
    x_u := pad32(&xc)
    y_u := pad32(&yc)
    sec := point_copy(&e.secret)
    psp := point_copy(&e.peer_sec)
    ra := point_xy_bytes(&sec) or >>
    rb := point_xy_bytes(&psp) or >>
    mut inner := []int{}
    append_s(mut &inner, &x_u)
    if is_resp {
        append_s(mut &inner, &e.za_peer)
        append_s(mut &inner, &e.za_self)
        append_s(mut &inner, &rb)
        append_s(mut &inner, &ra)
    } else {
        append_s(mut &inner, &e.za_self)
        append_s(mut &inner, &e.za_peer)
        append_s(mut &inner, &ra)
        append_s(mut &inner, &rb)
    }
    h := sm3.sum_bytes(string_from_bytes(inner))
    mut outer := []int{}
    outer.push(prefix & 255)
    append_s(mut &outer, &y_u)
    append_s(mut &outer, &h)
    << sm3.sum_bytes(string_from_bytes(outer))
}

fn exch_key(e &mut Exch, is_resp bool) string {
    uvp := point_copy(&e.uv)
    xy := point_xy(&uvp) or >>
    xc := int_clone(&xy.x)
    yc := int_clone(&xy.y)
    x_u := pad32(&xc)
    y_u := pad32(&yc)
    mut z := []int{}
    append_s(mut &z, &x_u)
    append_s(mut &z, &y_u)
    if is_resp {
        append_s(mut &z, &e.za_peer)
        append_s(mut &z, &e.za_self)
    } else {
        append_s(mut &z, &e.za_self)
        append_s(mut &z, &e.za_peer)
    }
    zs := string_from_bytes(z)
    t := kdf(&zs, e.klen) or >>
    if all_zero(&t) {
        >> errors.new("crypto/sm2: kdf zero")
    }
    << t
}

pub fn exch_new(d &string, peer_pub &string, uid &string, peer &string, klen int, gen_sig bool) Exch {
    if klen <= 0 {
        >> errors.new("crypto/sm2: bad key length")
    }
    dv := parse_d(d) or >>
    pb := parse_pub(peer_pub) or >>
    g := base_point() or >>
    pa := scalarmult(&dv, &g) or >>
    zs := za_from_point(uid, &pa) or >>
    zp := za_from_point(peer, &pb) or >>
    dv2 := int_clone(&dv)
    pb2 := point_copy(&pb)
    << Exch{
        gen_sig: gen_sig,
        klen: klen,
        uid: uid + "",
        peer: peer + "",
        d: dv2,
        peer_pub: pb2,
        za_self: zs,
        za_peer: zp,
        r: big.new_int(0),
        secret: point_inf(),
        peer_sec: point_inf(),
        uv: point_inf(),
        ready: 0
    }
}

pub fn (e &mut Exch) init_r(r &string) string {
    rv := parse_r(r) or >>
    e.r = int_clone(&rv)
    g := base_point() or >>
    ra := scalarmult(&rv, &g) or >>
    if is_inf(&ra) {
        >> errors.new("crypto/sm2: bad RA")
    }
    e.secret = point_copy(&ra)
    e.ready = 1
    << encode_point(&ra)
}

pub fn (e &mut Exch) init() string {
    rv := generate_key() or >>
    << e.init_r(&rv)
}

pub fn (e &mut Exch) respond_r(r &string, ra &string) ExchCap {
    p := parse_pub(ra) or >>
    if is_inf(&p) {
        >> errors.new("crypto/sm2: bad RA")
    }
    e.peer_sec = point_copy(&p)
    rv := parse_r(r) or >>
    e.r = int_clone(&rv)
    g := base_point() or >>
    rb := scalarmult(&rv, &g) or >>
    if is_inf(&rb) {
        >> errors.new("crypto/sm2: bad RB")
    }
    e.secret = point_copy(&rb)
    uv := compute_shared(e) or >>
    e.uv = point_copy(&uv)
    e.ready = 2
    pt := encode_point(&rb) or >>
    mut mac := ""
    if e.gen_sig {
        mac = exch_mac(e, true, 2) or >>
    }
    << ExchCap{point: pt, mac: mac, key: ""}
}

pub fn (e &mut Exch) respond(ra &string) ExchCap {
    rv := generate_key() or >>
    << e.respond_r(&rv, ra)
}

pub fn (e &mut Exch) confirm_responder(rb &string, sb &string) ExchCap {
    if e.ready < 1 {
        >> errors.new("crypto/sm2: exch not inited")
    }
    p := parse_pub(rb) or >>
    if is_inf(&p) {
        >> errors.new("crypto/sm2: bad RB")
    }
    e.peer_sec = point_copy(&p)
    uv := compute_shared(e) or >>
    e.uv = point_copy(&uv)
    e.ready = 2
    if e.gen_sig {
        if sb.len != 32 {
            >> errors.new("crypto/sm2: bad SB")
        }
        want := exch_mac(e, false, 2) or >>
        if subtle.constant_time_compare(&want, sb) != 1 {
            >> errors.new("crypto/sm2: bad SB")
        }
    }
    key := exch_key(e, false) or >>
    mut mac := ""
    if e.gen_sig {
        mac = exch_mac(e, false, 3) or >>
    }
    << ExchCap{point: "", mac: mac, key: key}
}

pub fn (e &mut Exch) confirm_initiator(sa &string) string {
    if e.ready < 2 {
        >> errors.new("crypto/sm2: exch not ready")
    }
    if e.gen_sig {
        if sa.len != 32 {
            >> errors.new("crypto/sm2: bad SA")
        }
        want := exch_mac(e, true, 3) or >>
        if subtle.constant_time_compare(&want, sa) != 1 {
            >> errors.new("crypto/sm2: bad SA")
        }
    }
    << exch_key(e, true)
}
