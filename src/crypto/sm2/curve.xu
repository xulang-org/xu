@crypto/sm2


#errors
#math/big
// SM2 recommended curve sm2p256v1 (GM/T 0003.5). Jacobian short-Weierstrass
// with a = p-3. Field ops take p so scalarmult can hoist the modulus.

struct Point {
    x big.Int
    y big.Int
    z big.Int
}

fn int_clone(x &big.Int) big.Int {
    mut z := big.new_int(0)
    z.set(x)
    << z
}

fn point_copy(p &Point) Point {
    px := int_clone(&p.x)
    py := int_clone(&p.y)
    pz := int_clone(&p.z)
    << Point{x: px, y: py, z: pz}
}

fn curve_p() big.Int {
    mut z := big.new_int(0)
    z.set_string("fffffffeffffffffffffffffffffffffffffffff00000000ffffffffffffffff", 16) or >>
    << z
}

fn curve_n() big.Int {
    mut z := big.new_int(0)
    z.set_string("fffffffeffffffffffffffffffffffff7203df6b21c6052b53bbf40939d54123", 16) or >>
    << z
}

fn curve_a() big.Int {
    mut z := big.new_int(0)
    z.set_string("fffffffeffffffffffffffffffffffffffffffff00000000fffffffffffffffc", 16) or >>
    << z
}

fn curve_b() big.Int {
    mut z := big.new_int(0)
    z.set_string("28e9fa9e9d9f5e344d5a9e4bcf6509a7f39789f515ab8f92ddbcbd414d940e93", 16) or >>
    << z
}

fn curve_gx() big.Int {
    mut z := big.new_int(0)
    z.set_string("32c4ae2c1f1981195f9904466a39c9948fe30bbff2660be1715a4589334c74c7", 16) or >>
    << z
}

fn curve_gy() big.Int {
    mut z := big.new_int(0)
    z.set_string("bc3736a2f4f6779c59bdcee36b692153d0a9877cc62a474002df32e52139f0a0", 16) or >>
    << z
}

fn fe_mod(x &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mod(x, p) or >>
    << z
}

fn fe_add(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.add(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_sub(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.sub(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_mul(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mul(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_sq(a &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mul(a, a)
    << fe_mod(&z, p) or >>
}

fn fe_inv(a &big.Int, p &big.Int) big.Int {
    mut two := big.new_int(2)
    mut e := big.new_int(0)
    e.sub(p, &two)
    mut z := big.new_int(0)
    z.exp(a, &e, p) or >>
    << z
}

fn pad32(x &big.Int) string {
    b := x.bytes()
    mut out := []int{}
    for i in 0:32 {
        out.push(0)
    }
    if b.len >= 32 {
        mut i := 0
        while i < 32 {
            out[i] = b[b.len - 32 + i] & 255
            i = i + 1
        }
    } else {
        off := 32 - b.len
        mut i := 0
        while i < b.len {
            out[off + i] = b[i] & 255
            i = i + 1
        }
    }
    << string_from_bytes(out)
}

fn from_be32(s &string, off int) big.Int {
    mut b := []int{}
    mut i := 0
    while i < 32 {
        b.push(s[off + i] & 255)
        i = i + 1
    }
    mut z := big.new_int(0)
    z.set_bytes(string_from_bytes(b))
    << z
}

fn point_inf() Point {
    << Point{x: big.new_int(0), y: big.new_int(1), z: big.new_int(0)}
}

fn point_affine(x &big.Int, y &big.Int) Point {
    << Point{x: int_clone(x), y: int_clone(y), z: big.new_int(1)}
}

fn base_point() Point {
    gx := curve_gx() or >>
    gy := curve_gy() or >>
    << point_affine(&gx, &gy)
}

fn is_inf(p &Point) bool {
    z := &p.z
    << z.sign() == 0
}

fn point_to_xy(p &Point, pmod &big.Int) Point {
    if is_inf(p) {
        >> errors.new("crypto/sm2: point at infinity")
    }
    zi := fe_inv(&p.z, pmod) or >>
    z2 := fe_sq(&zi, pmod) or >>
    z3 := fe_mul(&z2, &zi, pmod) or >>
    x := fe_mul(&p.x, &z2, pmod) or >>
    y := fe_mul(&p.y, &z3, pmod) or >>
    << Point{x: x, y: y, z: big.new_int(1)}
}

fn point_dbl(p &Point, pmod &big.Int) Point {
    if is_inf(p) {
        << point_inf()
    }
    mut x1 := int_clone(&p.x)
    mut y1 := int_clone(&p.y)
    mut z1 := int_clone(&p.z)
    xx := fe_sq(&x1, pmod) or >>
    yy := fe_sq(&y1, pmod) or >>
    zz := fe_sq(&z1, pmod) or >>
    yyyy := fe_sq(&yy, pmod) or >>
    xyy := fe_add(&x1, &yy, pmod) or >>
    t0 := fe_sq(&xyy, pmod) or >>
    t1 := fe_sub(&t0, &xx, pmod) or >>
    t2 := fe_sub(&t1, &yyyy, pmod) or >>
    s := fe_add(&t2, &t2, pmod) or >>
    xz := fe_add(&x1, &zz, pmod) or >>
    xd := fe_sub(&x1, &zz, pmod) or >>
    m0 := fe_mul(&xz, &xd, pmod) or >>
    m1 := fe_add(&m0, &m0, pmod) or >>
    m := fe_add(&m1, &m0, pmod) or >>
    m2 := fe_sq(&m, pmod) or >>
    s2 := fe_add(&s, &s, pmod) or >>
    x3 := fe_sub(&m2, &s2, pmod) or >>
    st := fe_sub(&s, &x3, pmod) or >>
    y0 := fe_mul(&m, &st, pmod) or >>
    y8a := fe_add(&yyyy, &yyyy, pmod) or >>
    y8b := fe_add(&y8a, &y8a, pmod) or >>
    y8 := fe_add(&y8b, &y8b, pmod) or >>
    y3 := fe_sub(&y0, &y8, pmod) or >>
    yz := fe_add(&y1, &z1, pmod) or >>
    z3a := fe_sq(&yz, pmod) or >>
    z3b := fe_sub(&z3a, &yy, pmod) or >>
    z3 := fe_sub(&z3b, &zz, pmod) or >>
    << Point{x: x3, y: y3, z: z3}
}

fn point_add(p &Point, q &Point, pmod &big.Int) Point {
    if is_inf(p) {
        qx := int_clone(&q.x)
        qy := int_clone(&q.y)
        qz := int_clone(&q.z)
        << Point{x: qx, y: qy, z: qz}
    }
    if is_inf(q) {
        px := int_clone(&p.x)
        py := int_clone(&p.y)
        pz := int_clone(&p.z)
        << Point{x: px, y: py, z: pz}
    }
    mut x1 := int_clone(&p.x)
    mut y1 := int_clone(&p.y)
    mut z1 := int_clone(&p.z)
    mut x2 := int_clone(&q.x)
    mut y2 := int_clone(&q.y)
    mut z2 := int_clone(&q.z)
    z1z1 := fe_sq(&z1, pmod) or >>
    z2z2 := fe_sq(&z2, pmod) or >>
    u1 := fe_mul(&x1, &z2z2, pmod) or >>
    u2 := fe_mul(&x2, &z1z1, pmod) or >>
    z2_3 := fe_mul(&z2, &z2z2, pmod) or >>
    z1_3 := fe_mul(&z1, &z1z1, pmod) or >>
    s1 := fe_mul(&y1, &z2_3, pmod) or >>
    s2 := fe_mul(&y2, &z1_3, pmod) or >>
    h := fe_sub(&u2, &u1, pmod) or >>
    r := fe_sub(&s2, &s1, pmod) or >>
    if h.sign() == 0 {
        if r.sign() == 0 {
            << point_dbl(p, pmod)
        }
        << point_inf()
    }
    hh := fe_sq(&h, pmod) or >>
    hhh := fe_mul(&h, &hh, pmod) or >>
    v := fe_mul(&u1, &hh, pmod) or >>
    r2 := fe_sq(&r, pmod) or >>
    v2 := fe_add(&v, &v, pmod) or >>
    x3a := fe_sub(&r2, &hhh, pmod) or >>
    x3 := fe_sub(&x3a, &v2, pmod) or >>
    vx := fe_sub(&v, &x3, pmod) or >>
    y3a := fe_mul(&r, &vx, pmod) or >>
    s1h := fe_mul(&s1, &hhh, pmod) or >>
    y3 := fe_sub(&y3a, &s1h, pmod) or >>
    z12 := fe_mul(&z1, &z2, pmod) or >>
    z3 := fe_mul(&z12, &h, pmod) or >>
    << Point{x: x3, y: y3, z: z3}
}

fn scalarmult(k &big.Int, p &Point) Point {
    mut r := point_inf()
    mut pmod := curve_p() or >>
    mut i := 255
    while i >= 0 {
        nxt := point_dbl(&r, &pmod) or >>
        r = nxt
        if k.bit(i) == 1 {
            nxt2 := point_add(&r, p, &pmod) or >>
            r = nxt2
        }
        i = i - 1
    }
    << r
}

fn on_curve(x &big.Int, y &big.Int) bool {
    pmod := curve_p() or >>
    aa := curve_a() or >>
    bb := curve_b() or >>
    y2 := fe_sq(y, &pmod) or >>
    x2 := fe_sq(x, &pmod) or >>
    x3 := fe_mul(&x2, x, &pmod) or >>
    ax := fe_mul(&aa, x, &pmod) or >>
    rhs0 := fe_add(&x3, &ax, &pmod) or >>
    rhs := fe_add(&rhs0, &bb, &pmod) or >>
    << y2.cmp(&rhs) == 0
}
