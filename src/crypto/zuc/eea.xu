@crypto/zuc


#errors
// 128-EEA3 / 128-EIA3 (ETSI SAGE / 3GPP TS 35.221). Built on this
// package's ZUC-128. bit_len is the LENGTH in bits; unused LSBs of
// the last source byte are ignored. EEA3 encrypt/decrypt are the same
// XOR. EIA3 returns a 4-byte MAC-I. No ZUC-256.

fn eea_params(key &string, bearer int, direction int, src &string, bit_len int) int {
    if key.len != 16 {
        >> errors.new("crypto/zuc: invalid key size")
    }
    if bearer < 0 || bearer > 31 {
        >> errors.new("crypto/zuc: bearer")
    }
    if direction != 0 && direction != 1 {
        >> errors.new("crypto/zuc: direction")
    }
    if bit_len < 0 {
        >> errors.new("crypto/zuc: bit length")
    }
    need := (bit_len + 7) / 8
    if src.len < need {
        >> errors.new("crypto/zuc: short data")
    }
    << need
}

fn iv_eea3(count int, bearer int, direction int) string {
    c0 := (count >> 24) & 255
    c1 := (count >> 16) & 255
    c2 := (count >> 8) & 255
    c3 := count & 255
    b4 := ((bearer << 3) | ((direction & 1) << 2)) & 252
    $v := []int{}
    v.push(c0)
    v.push(c1)
    v.push(c2)
    v.push(c3)
    v.push(b4)
    v.push(0)
    v.push(0)
    v.push(0)
    v.push(c0)
    v.push(c1)
    v.push(c2)
    v.push(c3)
    v.push(b4)
    v.push(0)
    v.push(0)
    v.push(0)
    << string_from_bytes(v)
}

fn iv_eia3(count int, bearer int, direction int) string {
    c0 := (count >> 24) & 255
    c1 := (count >> 16) & 255
    c2 := (count >> 8) & 255
    c3 := count & 255
    b4 := (bearer << 3) & 248
    d7 := (direction & 1) << 7
    $v := []int{}
    v.push(c0)
    v.push(c1)
    v.push(c2)
    v.push(c3)
    v.push(b4)
    v.push(0)
    v.push(0)
    v.push(0)
    v.push(c0 ^ d7)
    v.push(c1)
    v.push(c2)
    v.push(c3)
    v.push(b4)
    v.push(0)
    v.push(d7)
    v.push(0)
    << string_from_bytes(v)
}

fn zuc_keystream(key &string, iv &string, nbytes int) string {
    if nbytes == 0 {
        << ""
    }
    $z := []int{}
    $i := 0
    while i < nbytes {
        z.push(0)
        i = i + 1
    }
    zeros := string_from_bytes(z)
    $c := new_cipher(key, iv) or >>
    << c.xor_key_stream(&zeros)
}

fn be32_at(ks &string, word_i int) int {
    o := word_i * 4
    << (((ks[o] & 255) << 24) | ((ks[o + 1] & 255) << 16) | ((ks[o + 2] & 255) << 8) | (ks[o + 3] & 255)) & M32
}

fn get_word(ks &string, bit int) int {
    wi := bit / 32
    off := bit % 32
    w0 := be32_at(ks, wi)
    if off == 0 {
        << w0
    }
    w1 := be32_at(ks, wi + 1)
    << ((w0 << off) | ((w1 >> (32 - off)) & M32)) & M32
}

fn msg_bit(src &string, i int) int {
    b := src[i / 8] & 255
    << (b >> (7 - (i % 8))) & 1
}

pub fn encrypt_eea3(key &string, count int, bearer int, direction int, src &string, bit_len int) string {
    need := eea_params(key, bearer, direction, src, bit_len) or >>
    if need == 0 {
        << ""
    }
    iv := iv_eea3(count, bearer, direction)
    ks := zuc_keystream(key, &iv, need) or >>
    $out := []int{}
    $i := 0
    while i < need {
        out.push(((src[i] & 255) ^ (ks[i] & 255)) & 255)
        i = i + 1
    }
    rem := bit_len % 8
    if rem != 0 {
        unused := 8 - rem
        mask := (255 << unused) & 255
        last := out[need - 1] & mask
        out[need - 1] = last
    }
    << string_from_bytes(out)
}

pub fn decrypt_eea3(key &string, count int, bearer int, direction int, src &string, bit_len int) string {
    << encrypt_eea3(key, count, bearer, direction, src, bit_len) or >>
}

pub fn sum_eia3(key &string, count int, bearer int, direction int, src &string, bit_len int) string {
    _ := eea_params(key, bearer, direction, src, bit_len) or >>
    n := bit_len + 64
    l := (n + 31) / 32
    nbytes := l * 4
    iv := iv_eia3(count, bearer, direction)
    ks := zuc_keystream(key, &iv, nbytes) or >>
    $t := 0
    $i := 0
    while i < bit_len {
        if msg_bit(src, i) != 0 {
            t = (t ^ get_word(&ks, i)) & M32
        }
        i = i + 1
    }
    t = (t ^ get_word(&ks, bit_len)) & M32
    last := be32_at(&ks, l - 1)
    mac := (t ^ last) & M32
    $b := []int{}
    b.push((mac >> 24) & 255)
    b.push((mac >> 16) & 255)
    b.push((mac >> 8) & 255)
    b.push(mac & 255)
    << string_from_bytes(b)
}
