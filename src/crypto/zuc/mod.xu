@crypto/zuc


#errors
// ZUC-128 (ETSI SAGE v1.6). Xu addition — Go has no crypto/zuc.
// Stream cipher: new_cipher(key, iv) each 16 bytes + xor_key_stream
// returns a new string (same shape as crypto/rc4, plus IV). 128-EEA3 /
// 128-EIA3 (3GPP TS 35.221) live in this package. No ZUC-256.
// Pure i64; LFSR cells 31-bit (AddM), F 32-bit wrap. Zero C, not a
// commercial-crypto certification.

const m32 = 4294967295
const m31 = 2147483647

// Gen1 poisons computed sbox indices (`s0[(u >> 24) & 255]`) and LFSR
// shifts (`s[i + 1]`) inside new_cipher's init loop. Tiny helpers.
fn at_i(xs &[]int, i int) int {
    << xs[i]
}

fn set_i(xs &mut []int, i int, v int) {
    xs[i] = v
}

fn sbox_at(sb &[]int, x int) int {
    << sb[x & 255] & 255
}

pub const key_size = 16

pub struct Cipher {
    pub s []int
    pub r1 int
    pub r2 int
    pub x0 int
    pub x1 int
    pub x2 int
    pub x3 int
    pub s0 []int
    pub s1 []int
    pub hold int
    pub nleft int
}

fn hex_nibble(c int) int {
    if c >= 48 && c <= 57 {
        << c - 48
    }
    if c >= 97 && c <= 102 {
        << c - 87
    }
    if c >= 65 && c <= 70 {
        << c - 55
    }
    << 0
}

fn hex_bytes(h &string) []int {
    mut b := []int{}
    mut i := 0
    while i + 1 < h.len {
        b.push(hex_nibble(h[i] & 255) * 16 + hex_nibble(h[i + 1] & 255))
        i = i + 2
    }
    << b
}

fn s0_hex() string {
    << "3e725b47cae0003304d1549809b96dcb7b1bf932af9d6aa5b82dfc1d08530390" + "4d4e8499e4ced991ddb685488b296eaccdc1f81e734369c6b5bdfd396320d438" + "767db2a7cfed57c5f32cbb142106559be3ef5e314f7f5aa40d8251495fba581c" + "4a16d517a892241f8cffd8ae2e01d3ad3b4bda46ebc9de9a8f87d73a806f2fc8" + "b1b437f70a2213287ccc3c89c7c3965607bf7ef00b2b975235417961a64c10fe" + "bc2695888ab0a3fbc01894f2e1e5e95dd0dc1166645cec59427512f5749caa23" + "0e86abbe2a02e767e644a26cc2939ff1f6fa36d250689e6271153dd640c4e20f" + "8e83776b25053f0c30ea70b7a1e8a9658d271adb81b3a0f4457a19dfee783460"
}

fn s1_hex() string {
    << "55c263713bc847869f3cda5b29aafd778cc5940ca61a1300e3a8167240f9f842" + "4426689681d9453e1076c6a78b3943e13ab5562ac06db3052266bfdc0bfa6248" + "dd20110636c9c1cff62752bb69f5d4877f844cd29c57a4bc4f9adffed68d7aeb" + "2b53d85ca11417fb23d57d3067730809eeb7703f61b2198e4ee54b938f5ddba9" + "adf1ae2ecb0dfcf42d466e1d97e8d1e94d37a5755e839eab829db91ce0cd4989" + "01b6bd5824a25f387899159050b895e4d091c7ceed0fb46fa0ccf0024a79c3de" + "a3efea51e66b18ec1b2c80f774e7ff215a6a541e41319235c433070aba7e0e34" + "88b1987cf33d606c7bcad31f3265042864be859b2f598ad7b025acaf1203e2f2"
}

fn dconst(i int) int {
    ds := [0x44d7, 0x26bc, 0x626b, 0x135e, 0x5789, 0x35e2, 0x7135, 0x09af, 0x4d78, 0x2f13, 0x6bc4, 0x1af1, 0x5e26, 0x3c4d, 0x789a, 0x47ac]
    << ds[i]
}

fn addm(a0 int, b0 int) int {
    a := a0 & m31
    b := b0 & m31
    c := a + b
    << (c & m31) + (c >> 31)
}

fn mulp2(x0 int, k int) int {
    x := x0 & m31
    << (((x << k) | (x >> (31 - k))) & m31)
}

fn rot32(x0 int, n0 int) int {
    x := x0 & m32
    n := n0 & 31
    if n == 0 {
        << x
    }
    << ((x << n) | ((x >> (32 - n)) & m32)) & m32
}

fn l1(x int) int {
    << (x ^ rot32(x, 2) ^ rot32(x, 10) ^ rot32(x, 18) ^ rot32(x, 24)) & m32
}

fn l2(x int) int {
    << (x ^ rot32(x, 8) ^ rot32(x, 14) ^ rot32(x, 22) ^ rot32(x, 30)) & m32
}

fn (c &mut Cipher) bit_reorg() {
    c.x0 = (((c.s[15] & 0x7fff8000) << 1) | (c.s[14] & 65535)) & m32
    c.x1 = (((c.s[11] & 65535) << 16) | (c.s[9] >> 15)) & m32
    c.x2 = (((c.s[7] & 65535) << 16) | (c.s[5] >> 15)) & m32
    c.x3 = (((c.s[2] & 65535) << 16) | (c.s[0] >> 15)) & m32
}

fn (c &mut Cipher) f() int {
    w := ((c.x0 ^ c.r1) + c.r2) & m32
    w1 := (c.r1 + c.x1) & m32
    w2 := (c.r2 ^ c.x2) & m32
    u := l1(((w1 << 16) | (w2 >> 16)) & m32)
    v := l2(((w2 << 16) | (w1 >> 16)) & m32)
    u0 := sbox_at(&c.s0, u >> 24)
    u1 := sbox_at(&c.s1, u >> 16)
    u2 := sbox_at(&c.s0, u >> 8)
    u3 := sbox_at(&c.s1, u)
    c.r1 = ((u0 << 24) | (u1 << 16) | (u2 << 8) | u3) & m32
    v0 := sbox_at(&c.s0, v >> 24)
    v1 := sbox_at(&c.s1, v >> 16)
    v2 := sbox_at(&c.s0, v >> 8)
    v3 := sbox_at(&c.s1, v)
    c.r2 = ((v0 << 24) | (v1 << 16) | (v2 << 8) | v3) & m32
    << w
}

fn (c &mut Cipher) lfsr_init(u int) {
    mut f := at_i(&c.s, 0)
    f = addm(f, mulp2(at_i(&c.s, 0), 8))
    f = addm(f, mulp2(at_i(&c.s, 4), 20))
    f = addm(f, mulp2(at_i(&c.s, 10), 21))
    f = addm(f, mulp2(at_i(&c.s, 13), 17))
    f = addm(f, mulp2(at_i(&c.s, 15), 15))
    f = addm(f, u)
    mut i := 0
    while i < 15 {
        nxt := at_i(&c.s, i + 1)
        set_i(mut &c.s, i, nxt)
        i = i + 1
    }
    set_i(mut &c.s, 15, f)
}

fn (c &mut Cipher) lfsr_work() {
    mut f := at_i(&c.s, 0)
    f = addm(f, mulp2(at_i(&c.s, 0), 8))
    f = addm(f, mulp2(at_i(&c.s, 4), 20))
    f = addm(f, mulp2(at_i(&c.s, 10), 21))
    f = addm(f, mulp2(at_i(&c.s, 13), 17))
    f = addm(f, mulp2(at_i(&c.s, 15), 15))
    mut i := 0
    while i < 15 {
        nxt := at_i(&c.s, i + 1)
        set_i(mut &c.s, i, nxt)
        i = i + 1
    }
    set_i(mut &c.s, 15, f)
}

fn (c &mut Cipher) next_word() int {
    c.bit_reorg()
    w := c.f()
    z := (w ^ c.x3) & m32
    c.lfsr_work()
    << z
}

pub fn new_cipher(key &string, iv &string) Cipher {
    if key.len != 16 {
        >> errors.new("crypto/zuc: invalid key size")
    }
    if iv.len != 16 {
        >> errors.new("crypto/zuc: invalid iv size")
    }
    h0 := s0_hex()
    h1 := s1_hex()
    s0 := hex_bytes(&h0)
    s1 := hex_bytes(&h1)
    if s0.len != 256 || s1.len != 256 {
        >> errors.new("crypto/zuc: sbox")
    }
    mut s := []int{}
    for i in 0:16 {
        ki := key[i] & 255
        ii := iv[i] & 255
        s.push(((ki << 23) | (dconst(i) << 8) | ii) & m31)
    }
    mut c := Cipher{s: s, r1: 0, r2: 0, x0: 0, x1: 0, x2: 0, x3: 0, s0: s0, s1: s1, hold: 0, nleft: 0}
    for n in 0:32 {
        c.bit_reorg()
        w := c.f()
        c.lfsr_init(w >> 1)
    }
    c.bit_reorg()
    c.f()
    c.lfsr_work()
    << c
}

pub fn (c &mut Cipher) xor_key_stream(src &string) string {
    data := src + ""
    mut out := []int{}
    mut i := 0
    while i < data.len {
        if c.nleft == 0 {
            c.hold = c.next_word()
            c.nleft = 4
        }
        shift := (c.nleft - 1) * 8
        kb := (c.hold >> shift) & 255
        out.push((data[i] & 255) ^ kb)
        c.nleft = c.nleft - 1
        i = i + 1
    }
    << string_from_bytes(out)
}
