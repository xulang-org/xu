@crypto/ed25519

#errors
#math/big
#crypto/sha512
#crypto/rand
#crypto/subtle

// Go `crypto/ed25519`: GenerateKey / NewKeyFromSeed / Sign / Verify.
// Private key is 64 bytes (seed || public), public 32, signature 64.
// Curve arithmetic uses math/big (Go uses crypto/internal/edwards25519).
// Field ops take p as an argument so scalarmult can hoist 2^255-19 and 2d.
// XU-CT-CLASS: variable-time
// XU-CT-USE: fixed-shape-only
// math/big curve arithmetic is variable-time; crypto/subtle covers only the
// final encoded-point equality check.

pub const PUBLIC_KEY_SIZE = 32
pub const PRIVATE_KEY_SIZE = 64
pub const SIGNATURE_SIZE = 64
pub const SEED_SIZE = 32

struct Point {
    x big.Int
    y big.Int
    z big.Int
    t big.Int
}

fn fe_p() big.Int {
    // 2^255-19 as 31-bit limbs (math/big base). Built here instead of
    // lsh(1,255)-19 so every field op does not redo a 255-bit shift.
    mut z := big.new_int(0)
    mut abs := []int{}
    abs.push(2147483629)
    for i in 0:7 {
        abs.push(2147483647)
    }
    abs.push(127)
    z.abs = abs
    << z
}

fn order_l() big.Int {
    mut l := big.new_int(1)
    l.lsh(&l, 252)
    mut t := big.new_int(0)
    t.set_string("27742317777372353535851937790883648493", 10) or >>
    l.add(&l, &t)
    << l
}

fn ed_d() big.Int {
    mut d := big.new_int(0)
    d.set_string("37095705934669439343138083508754565189542113879843219016388785533085940283555", 10) or >>
    << d
}

fn fe_i() big.Int {
    mut i := big.new_int(0)
    i.set_string("19681161376707505956807079304988542015446066515923890162744021073123829784752", 10) or >>
    << i
}

fn fe_mod(x &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mod(x, p) or >>
    << z
}

fn fe_add(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.add(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_sub(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.sub(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_mul(a &big.Int, b &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mul(a, b)
    << fe_mod(&z, p) or >>
}

fn fe_sq(a &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.mul(a, a)
    << fe_mod(&z, p) or >>
}

fn fe_neg(a &big.Int, p &big.Int) big.Int {
    mut z := big.new_int(0)
    z.neg(a)
    << fe_mod(&z, p) or >>
}

fn fe_inv(a &big.Int, p &big.Int) big.Int {
    mut two := big.new_int(2)
    mut e := big.new_int(0)
    e.sub(p, &two)
    mut z := big.new_int(0)
    z.exp(a, &e, p) or >>
    << z
}

fn two_d_mod(p &big.Int) big.Int {
    mut k := ed_d() or >>
    mut two := big.new_int(2)
    k.mul(&k, &two)
    << fe_mod(&k, p)
}

fn from_le(s string) big.Int {
    mut tmp := []int{}
    mut i := s.len
    while i > 0 {
        i = i - 1
        tmp.push(s[i] & 255)
    }
    mut z := big.new_int(0)
    z.set_bytes(string_from_bytes(tmp))
    << z
}

fn to_le32(x &big.Int) string {
    be := x.bytes()
    mut tmp := []int{}
    for i in 0:32 {
        tmp.push(0)
    }
    mut i := 0
    while i < be.len && i < 32 {
        tmp[i] = be[be.len - 1 - i] & 255
        i = i + 1
    }
    << string_from_bytes(tmp)
}

fn point_ident() Point {
    << Point{x: big.new_int(0), y: big.new_int(1), z: big.new_int(1), t: big.new_int(0)}
}

fn base_point() Point {
    mut x := big.new_int(0)
    x.set_string("15112221349535400772501151409588531511454012693041857206046113283949847762202", 10) or >>
    mut y := big.new_int(0)
    y.set_string("46316835694926478169428394003475163141307993866256225615783033603165251855960", 10) or >>
    mut z := big.new_int(1)
    mut pmod := fe_p()
    t := fe_mul(&x, &y, &pmod) or >>
    << Point{x: x, y: y, z: z, t: t}
}

fn int_clone(x &big.Int) big.Int {
    mut z := big.new_int(0)
    z.set(x)
    << z
}

fn point_add(p &Point, q &Point, pmod &big.Int, two_d &big.Int) Point {
    mut x1 := int_clone(&p.x)
    mut y1 := int_clone(&p.y)
    mut z1 := int_clone(&p.z)
    mut t1 := int_clone(&p.t)
    mut x2 := int_clone(&q.x)
    mut y2 := int_clone(&q.y)
    mut z2 := int_clone(&q.z)
    mut t2 := int_clone(&q.t)
    ymx1 := fe_sub(&y1, &x1, pmod) or >>
    ymx2 := fe_sub(&y2, &x2, pmod) or >>
    a := fe_mul(&ymx1, &ymx2, pmod) or >>
    ypx1 := fe_add(&y1, &x1, pmod) or >>
    ypx2 := fe_add(&y2, &x2, pmod) or >>
    b := fe_mul(&ypx1, &ypx2, pmod) or >>
    c0 := fe_mul(&t1, two_d, pmod) or >>
    c := fe_mul(&c0, &t2, pmod) or >>
    d0 := fe_mul(&z1, &z2, pmod) or >>
    d := fe_add(&d0, &d0, pmod) or >>
    e := fe_sub(&b, &a, pmod) or >>
    f := fe_sub(&d, &c, pmod) or >>
    g := fe_add(&d, &c, pmod) or >>
    h := fe_add(&b, &a, pmod) or >>
    x3 := fe_mul(&e, &f, pmod) or >>
    y3 := fe_mul(&g, &h, pmod) or >>
    t3 := fe_mul(&e, &h, pmod) or >>
    z3 := fe_mul(&f, &g, pmod) or >>
    << Point{x: x3, y: y3, z: z3, t: t3}
}

fn point_dbl(p &Point, pmod &big.Int) Point {
    mut x1 := int_clone(&p.x)
    mut y1 := int_clone(&p.y)
    mut z1 := int_clone(&p.z)
    a := fe_sq(&x1, pmod) or >>
    b := fe_sq(&y1, pmod) or >>
    zz := fe_sq(&z1, pmod) or >>
    c := fe_add(&zz, &zz, pmod) or >>
    d := fe_neg(&a, pmod) or >>
    xy := fe_add(&x1, &y1, pmod) or >>
    xy2 := fe_sq(&xy, pmod) or >>
    e0 := fe_sub(&xy2, &a, pmod) or >>
    e := fe_sub(&e0, &b, pmod) or >>
    g := fe_add(&d, &b, pmod) or >>
    f := fe_sub(&g, &c, pmod) or >>
    h := fe_sub(&d, &b, pmod) or >>
    x3 := fe_mul(&e, &f, pmod) or >>
    y3 := fe_mul(&g, &h, pmod) or >>
    t3 := fe_mul(&e, &h, pmod) or >>
    z3 := fe_mul(&f, &g, pmod) or >>
    << Point{x: x3, y: y3, z: z3, t: t3}
}

fn scalarmult(k &big.Int, p &Point) Point {
    mut r := point_ident()
    mut pmod := fe_p()
    mut two_d := two_d_mod(&pmod) or >>
    mut i := 255
    while i >= 0 {
        nxt := point_dbl(&r, &pmod) or >>
        r = nxt
        if k.bit(i) == 1 {
            nxt2 := point_add(&r, p, &pmod, &two_d) or >>
            r = nxt2
        }
        i = i - 1
    }
    << r
}

fn point_encode(p &Point) string {
    mut pmod := fe_p()
    zinv := fe_inv(&p.z, &pmod) or >>
    x := fe_mul(&p.x, &zinv, &pmod) or >>
    y := fe_mul(&p.y, &zinv, &pmod) or >>
    mut s := to_le32(&y)
    if x.bit(0) == 1 {
        mut b := []int{}
        for i in 0:32 {
            b.push(s[i] & 255)
        }
        b[31] = b[31] | 128
        s = string_from_bytes(b)
    }
    << s
}

fn point_decode(s string) Point {
    if s.len != 32 {
        >> errors.new("ed25519: bad point")
    }
    mut buf := []int{}
    for i in 0:32 {
        buf.push(s[i] & 255)
    }
    x_sign := (buf[31] >> 7) & 1
    buf[31] = buf[31] & 127
    yb := string_from_bytes(buf)
    mut y := from_le(yb)
    mut p := fe_p()
    if y.cmp(&p) >= 0 {
        >> errors.new("ed25519: bad point")
    }
    y2 := fe_sq(&y, &p) or >>
    mut one := big.new_int(1)
    u := fe_sub(&y2, &one, &p) or >>
    mut d := ed_d() or >>
    dy2 := fe_mul(&d, &y2, &p) or >>
    v := fe_add(&dy2, &one, &p) or >>
    vinv := fe_inv(&v, &p) or >>
    x2 := fe_mul(&u, &vinv, &p) or >>
    mut exp := big.new_int(1)
    exp.lsh(&exp, 252)
    mut two := big.new_int(2)
    exp.sub(&exp, &two)
    mut x := big.new_int(0)
    x.exp(&x2, &exp, &p) or >>
    x = fe_mod(&x, &p) or >>
    mut chk := fe_sq(&x, &p) or >>
    if chk.cmp(&x2) != 0 {
        mut ii := fe_i() or >>
        x = fe_mul(&x, &ii, &p) or >>
        chk = fe_sq(&x, &p) or >>
        if chk.cmp(&x2) != 0 {
            >> errors.new("ed25519: bad point")
        }
    }
    if x.sign() == 0 && x_sign == 1 {
        >> errors.new("ed25519: bad point")
    }
    if x.bit(0) != x_sign {
        x = fe_neg(&x, &p) or >>
    }
    mut z := big.new_int(1)
    t := fe_mul(&x, &y, &p) or >>
    << Point{x: x, y: y, z: z, t: t}
}

fn prune_scalar(h string) big.Int {
    mut b := []int{}
    for i in 0:32 {
        b.push(h[i] & 255)
    }
    b[0] = b[0] & 248
    b[31] = b[31] & 127
    b[31] = b[31] | 64
    << from_le(string_from_bytes(b))
}

fn scalar_mod_l(x big.Int) big.Int {
    mut l := order_l() or >>
    mut z := big.new_int(0)
    z.mod(&x, &l) or >>
    << z
}

pub fn new_key_from_seed(seed string) string {
    if seed.len != SEED_SIZE {
        >> errors.new("ed25519: bad seed size")
    }
    sd := seed + ""
    h := sha512.sum512(sd + "")
    a := prune_scalar(h)
    bp := base_point() or >>
    aa := scalarmult(&a, &bp) or >>
    enc := point_encode(&aa) or >>
    mut priv := []int{}
    for i in 0:32 {
        priv.push(sd[i] & 255)
    }
    for i in 0:32 {
        priv.push(enc[i] & 255)
    }
    << string_from_bytes(priv)
}

pub fn generate_key() string {
    seed := rand.read(SEED_SIZE) or >>
    << new_key_from_seed(seed)
}

pub fn public(priv &string) string {
    if priv.len != PRIVATE_KEY_SIZE {
        >> errors.new("ed25519: bad private key")
    }
    p := priv + ""
    << p[32:64]
}

pub fn seed(priv &string) string {
    if priv.len != PRIVATE_KEY_SIZE {
        >> errors.new("ed25519: bad private key")
    }
    p := priv + ""
    << p[0:32]
}

pub fn sign(private_key &string, message &string) string {
    if private_key.len != PRIVATE_KEY_SIZE {
        >> errors.new("ed25519: bad private key")
    }
    pk := private_key + ""
    msg := message + ""
    sd := pk[0:32]
    aenc := pk[32:64]
    h := sha512.sum512(sd)
    a := prune_scalar(h + "")
    prefix := h[32:64]
    rh := sha512.sum512(prefix + (msg + ""))
    r := scalar_mod_l(from_le(rh)) or >>
    bp := base_point() or >>
    rp := scalarmult(&r, &bp) or >>
    renc := point_encode(&rp) or >>
    kh := sha512.sum512((renc + "") + aenc + msg)
    k := scalar_mod_l(from_le(kh)) or >>
    mut s := big.new_int(0)
    s.mul(&k, &a)
    s.add(&s, &r)
    s = scalar_mod_l(s) or >>
    senc := to_le32(&s)
    << renc + senc
}

pub fn verify(public_key &string, message &string, sig &string) bool {
    if public_key.len != PUBLIC_KEY_SIZE {
        << false
    }
    if sig.len != SIGNATURE_SIZE {
        << false
    }
    pk := public_key + ""
    msg := message + ""
    sg := sig + ""
    renc := sg[0:32]
    senc := sg[32:64]
    mut s := from_le(senc)
    mut l := order_l() or (err) {
        << false
    }
    if s.cmp(&l) >= 0 {
        << false
    }
    ap := point_decode(pk + "") or (err) {
        << false
    }
    rp := point_decode(renc + "") or (err) {
        << false
    }
    kh := sha512.sum512(renc + pk + msg)
    k := scalar_mod_l(from_le(kh)) or (err) {
        << false
    }
    bp := base_point() or (err) {
        << false
    }
    sb := scalarmult(&s, &bp) or (err) {
        << false
    }
    ka := scalarmult(&k, &ap) or (err) {
        << false
    }
    mut pmod := fe_p()
    mut two_d := two_d_mod(&pmod) or (err) {
        << false
    }
    rhs := point_add(&rp, &ka, &pmod, &two_d) or (err) {
        << false
    }
    lhs := point_encode(&sb) or (err) {
        << false
    }
    rhse := point_encode(&rhs) or (err) {
        << false
    }
    << subtle.constant_time_compare(&lhs, &rhse) == 1
}
