@crypto/rsa/oaep

// XU-CT-USE: fixed-shape-only
// crypto/subtle covers final fixed-shape checks only; the parent RSA backend
// remains explicitly variable-time.

#crypto/rsa

#errors
#math/big
#crypto/rand
#crypto/subtle
#crypto/sha1
#crypto/sha256
#crypto/sha512
#encoding/hex

// OAEP / PSS (RFC 8017). Hash ids match PKCS1v15 (sha1/sha256/sha512).

fn hash_n(hash int) int {
    if hash == rsa.SHA1 {
        << 20
    }
    if hash == rsa.SHA256 {
        << 32
    }
    if hash == rsa.SHA512 {
        << 64
    }
    << -1
}

fn hash_bytes(hash int, s &string) string {
    if hash == rsa.SHA256 {
        << sha256.sum256_bytes(s + "")
    }
    if hash == rsa.SHA1 {
        hx := sha1.sum(s + "")
        << hex.decode_string(hx) or >>
    }
    if hash == rsa.SHA512 {
        << sha512.sum512(s + "")
    }
    >> errors.new("crypto/rsa: unsupported hash function")
    << ""
}

fn xor_str(a &string, b &string) string {
    n := a.len
    if b.len != n {
        >> errors.new("crypto/rsa: xor length mismatch")
    }
    $out := []int{}
    $i := 0
    while i < n {
        out.push((a[i] ^ b[i]) & 255)
        i = i + 1
    }
    << string_from_bytes(out)
}

fn mgf1(hash int, seed &string, length int) string {
    if length < 0 {
        >> errors.new("crypto/rsa: mgf1 length")
    }
    $t := ""
    $counter := 0
    while t.len < length {
        $ctr := []int{}
        ctr.push((counter >> 24) & 255)
        ctr.push((counter >> 16) & 255)
        ctr.push((counter >> 8) & 255)
        ctr.push(counter & 255)
        block := (seed + "") + string_from_bytes(ctr)
        h := hash_bytes(hash, &block) or >>
        t = t + h
        counter = counter + 1
        if counter > 1048576 {
            >> errors.new("crypto/rsa: mgf1 overflow")
        }
    }
    << t[0:length]
}

fn rsa_crypt(x &big.Int, exp &big.Int, modn &big.Int) big.Int {
    $z := big.new_int(0)
    z.exp(x, exp, modn) or >>
    << z
}

fn i2osp_k(z &big.Int, k int) string {
    b := z.bytes()
    if b.len > k {
        >> errors.new("crypto/rsa: integer too large")
    }
    $out := []int{}
    $pad := k - b.len
    while pad > 0 {
        out.push(0)
        pad = pad - 1
    }
    $i := 0
    while i < b.len {
        out.push(b[i] & 255)
        i = i + 1
    }
    << string_from_bytes(out)
}

fn zeros_str(n int) string {
    $out := []int{}
    $i := 0
    while i < n {
        out.push(0)
        i = i + 1
    }
    << string_from_bytes(out)
}

fn oaep_em(k int, hash int, msg &string, label &string) string {
    hlen := hash_n(hash)
    if hlen < 0 {
        >> errors.new("crypto/rsa: unsupported hash function")
    }
    if k < 2 * hlen + 2 {
        >> errors.new("crypto/rsa: message too long")
    }
    if msg.len > k - 2 * hlen - 2 {
        >> errors.new("crypto/rsa: message too long")
    }
    lhash := hash_bytes(hash, label) or >>
    ps_len := k - msg.len - 2 * hlen - 2
    $dbv := []int{}
    $i := 0
    while i < lhash.len {
        dbv.push(lhash[i] & 255)
        i = i + 1
    }
    i = 0
    while i < ps_len {
        dbv.push(0)
        i = i + 1
    }
    dbv.push(1)
    i = 0
    while i < msg.len {
        dbv.push(msg[i] & 255)
        i = i + 1
    }
    db := string_from_bytes(dbv)
    seed := rand.read(hlen) or >>
    db_mask := mgf1(hash, &seed, k - hlen - 1) or >>
    masked_db := xor_str(&db, &db_mask) or >>
    seed_mask := mgf1(hash, &masked_db, hlen) or >>
    masked_seed := xor_str(&seed, &seed_mask) or >>
    $emv := []int{}
    emv.push(0)
    i = 0
    while i < masked_seed.len {
        emv.push(masked_seed[i] & 255)
        i = i + 1
    }
    i = 0
    while i < masked_db.len {
        emv.push(masked_db[i] & 255)
        i = i + 1
    }
    << string_from_bytes(emv)
}

pub fn encrypt_oaep(pk &rsa.PublicKey, hash int, msg &string, label &string) string {
    k := pk.size()
    em := oaep_em(k, hash, msg, label) or >>
    $m := big.new_int(0)
    m.set_bytes(em)
    $ee := big.new_int(pk.e)
    $nn := big.new_int(0)
    nn.set(&pk.n)
    c := rsa_crypt(&m, &ee, &nn) or >>
    << i2osp_k(&c, k)
}

pub fn decrypt_oaep(priv &rsa.PrivateKey, hash int, ciphertext &string, label &string) string {
    pk := &priv.public
    k := pk.size()
    hlen := hash_n(hash)
    if hlen < 0 {
        >> errors.new("crypto/rsa: unsupported hash function")
    }
    if ciphertext.len != k || k < 2 * hlen + 2 {
        >> errors.new("crypto/rsa: decryption error")
    }
    $c := big.new_int(0)
    c.set_bytes(ciphertext + "")
    $nn := big.new_int(0)
    nn.set(&pk.n)
    if c.cmp(&nn) >= 0 {
        >> errors.new("crypto/rsa: decryption error")
    }
    $dd := big.new_int(0)
    dd.set(&priv.d)
    m := rsa_crypt(&c, &dd, &nn) or >>
    em := i2osp_k(&m, k) or >>
    if (em[0] & 255) != 0 {
        >> errors.new("crypto/rsa: decryption error")
    }
    masked_seed := em[1:(1 + hlen)]
    masked_db := em[(1 + hlen):k]
    seed_mask := mgf1(hash, &masked_db, hlen) or >>
    seed := xor_str(&masked_seed, &seed_mask) or >>
    db_mask := mgf1(hash, &seed, k - hlen - 1) or >>
    db := xor_str(&masked_db, &db_mask) or >>
    lhash := hash_bytes(hash, label) or >>
    got := db[0:hlen]
    if subtle.constant_time_compare(&got, &lhash) != 1 {
        >> errors.new("crypto/rsa: decryption error")
    }
    $i := hlen
    while i < db.len {
        b := db[i] & 255
        if b == 0 {
            i = i + 1
            ->
        }
        if b == 1 {
            << db[(i + 1):db.len]
        }
        >> errors.new("crypto/rsa: decryption error")
    }
    >> errors.new("crypto/rsa: decryption error")
    << ""
}

fn pss_emsa_encode(hash int, hashed &string, em_bits int, salt_len int) string {
    hlen := hash_n(hash)
    if hlen < 0 {
        >> errors.new("crypto/rsa: unsupported hash function")
    }
    if hashed.len != hlen {
        >> errors.new("crypto/rsa: hash length does not match hash function")
    }
    em_len := (em_bits + 7) / 8
    if em_len < hlen + salt_len + 2 {
        >> errors.new("crypto/rsa: message too long")
    }
    salt := rand.read(salt_len) or >>
    $mp := zeros_str(8)
    mp = mp + hashed
    mp = mp + salt
    h := hash_bytes(hash, &mp) or >>
    ps_len := em_len - salt_len - hlen - 2
    $db := zeros_str(ps_len)
    db = db + string_from_byte(1)
    db = db + salt
    db_mask := mgf1(hash, &h, em_len - hlen - 1) or >>
    $masked := xor_str(&db, &db_mask) or >>
    unused := 8 * em_len - em_bits
    if unused > 0 {
        mask := (1 << (8 - unused)) - 1
        $first := string_from_byte((masked[0] & 255) & mask)
        if masked.len > 1 {
            first = first + masked[1:masked.len]
        }
        masked = first + ""
    }
    $em := masked + ""
    em = em + h
    em = em + string_from_byte(188)
    << em
}

fn pss_emsa_verify(hash int, hashed &string, em string, em_bits int, salt_len int) int {
    hlen := hash_n(hash)
    if hlen < 0 {
        >> errors.new("crypto/rsa: verification error")
    }
    if hashed.len != hlen {
        >> errors.new("crypto/rsa: verification error")
    }
    em_len := (em_bits + 7) / 8
    if em.len != em_len || em_len < hlen + salt_len + 2 {
        >> errors.new("crypto/rsa: verification error")
    }
    if (em[em_len - 1] & 255) != 188 {
        >> errors.new("crypto/rsa: verification error")
    }
    db_len := em_len - hlen - 1
    masked := em[0:db_len]
    h := em[db_len:(db_len + hlen)]
    unused := 8 * em_len - em_bits
    if unused > 0 {
        keep := (1 << (8 - unused)) - 1
        if ((masked[0] & 255) & (255 - keep)) != 0 {
            >> errors.new("crypto/rsa: verification error")
        }
    }
    db_mask := mgf1(hash, &h, db_len) or >>
    $db := xor_str(&masked, &db_mask) or >>
    if unused > 0 {
        keep := (1 << (8 - unused)) - 1
        $first := string_from_byte((db[0] & 255) & keep)
        if db.len > 1 {
            first = first + db[1:db.len]
        }
        db = first + ""
    }
    ps_len := em_len - salt_len - hlen - 2
    $i := 0
    while i < ps_len {
        if (db[i] & 255) != 0 {
            >> errors.new("crypto/rsa: verification error")
        }
        i = i + 1
    }
    if (db[ps_len] & 255) != 1 {
        >> errors.new("crypto/rsa: verification error")
    }
    salt := db[(ps_len + 1):db.len]
    $mp := zeros_str(8)
    mp = mp + hashed
    mp = mp + salt
    h2 := hash_bytes(hash, &mp) or >>
    if subtle.constant_time_compare(&h, &h2) != 1 {
        >> errors.new("crypto/rsa: verification error")
    }
    << 0
}

pub fn sign_pss(priv &rsa.PrivateKey, hash int, hashed &string) string {
    pk := &priv.public
    k := pk.size()
    hlen := hash_n(hash)
    if hlen < 0 {
        >> errors.new("crypto/rsa: unsupported hash function")
    }
    $nbits := big.new_int(0)
    nbits.set(&pk.n)
    em_bits := nbits.bit_len() - 1
    em := pss_emsa_encode(hash, hashed, em_bits, hlen) or >>
    $m := big.new_int(0)
    m.set_bytes(em)
    $nn := big.new_int(0)
    nn.set(&pk.n)
    $dd := big.new_int(0)
    dd.set(&priv.d)
    s := rsa_crypt(&m, &dd, &nn) or >>
    << i2osp_k(&s, k)
}

pub fn verify_pss(pk &rsa.PublicKey, hash int, hashed &string, sig &string) int {
    k := pk.size()
    if sig.len != k {
        >> errors.new("crypto/rsa: verification error")
    }
    hlen := hash_n(hash)
    if hlen < 0 {
        >> errors.new("crypto/rsa: verification error")
    }
    $s := big.new_int(0)
    s.set_bytes(sig + "")
    $nn := big.new_int(0)
    nn.set(&pk.n)
    if s.cmp(&nn) >= 0 {
        >> errors.new("crypto/rsa: verification error")
    }
    $ee := big.new_int(pk.e)
    m := rsa_crypt(&s, &ee, &nn) or >>
    $nbits := big.new_int(0)
    nbits.set(&pk.n)
    em_bits := nbits.bit_len() - 1
    em_len := (em_bits + 7) / 8
    em := i2osp_k(&m, em_len) or >>
    << pss_emsa_verify(hash, hashed, em, em_bits, hlen)
}
