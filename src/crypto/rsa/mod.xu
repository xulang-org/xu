@crypto/rsa

#errors
#math/big
#crypto/rand
#crypto/subtle
#encoding/hex

// Go `crypto/rsa` subset: PublicKey / PrivateKey, GenerateKey,
// EncryptPKCS1v15 / DecryptPKCS1v15, SignPKCS1v15 / VerifyPKCS1v15,
// EncryptOAEP / DecryptOAEP, SignPSS / VerifyPSS (RFC 8017; hash SHA-1/256/512).
// Hash IDs match Go `crypto.Hash` (SHA-1=3, SHA-256=5, SHA-384=6, SHA-512=7).
// Includes CRT (Chinese Remainder Theorem) acceleration, RSA blinding when
// prime factors p/q and public exponent e are present, and branchless PKCS#1 v1.5
// padding checks. v1 GenerateKey allows bits>=64 (tests); production keys >=2048.
// XU-CT-CLASS: variable-time
// math/big exponentiation has no constant-time contract; crypto/subtle is used
// for fixed-shape equality and padding checks.

pub const sha1 = 3
pub const sha256 = 5
pub const sha384 = 6
pub const sha512 = 7

pub struct PublicKey {
    pub n big.Int
    pub e int
}

pub struct PrivateKey {
    pub public PublicKey
    pub d big.Int
    pub p big.Int
    pub q big.Int
}

fn n_size(n &big.Int) int {
    << (n.bit_len() + 7) / 8
}

pub fn (pk &PublicKey) size() int {
    << n_size(&pk.n)
}

fn i2osp(z &big.Int, k int) string {
    b := z.bytes()
    if b.len > k {
        >> errors.new("crypto/rsa: integer too large")
    }
    mut out := []int{}
    mut pad := k - b.len
    while pad > 0 {
        out.push(0)
        pad = pad - 1
    }
    mut i := 0
    while i < b.len {
        out.push(b[i] & 255)
        i = i + 1
    }
    << string_from_bytes(out)
}

fn digestinfo(hash int, hashed &string) string {
    if hash == 0 {
        << hashed + ""
    }
    mut pref := ""
    mut want := 0
    if hash == sha1 {
        pref = hex.decode_string("3021300906052b0e03021a05000414") or >>
        want = 20
    } else if hash == sha256 {
        pref = hex.decode_string("3031300d060960864801650304020105000420") or >>
        want = 32
    } else if hash == sha384 {
        pref = hex.decode_string("3041300d060960864801650304020205000430") or >>
        want = 48
    } else if hash == sha512 {
        pref = hex.decode_string("3051300d060960864801650304020305000440") or >>
        want = 64
    } else {
        >> errors.new("crypto/rsa: unsupported hash function")
    }
    if hashed.len != want {
        >> errors.new("crypto/rsa: hash length does not match hash function")
    }
    << pref + hashed
}

fn rsa_crypt(x &big.Int, exp &big.Int, mod &big.Int) big.Int {
    mut z := big.new_int(0)
    z.exp(x, exp, mod) or >>
    << z
}

// Private-key operation with Chinese Remainder Theorem (CRT) and RSA blinding
// when p, q are populated; falls back to c^d mod n for bare {n, d} keys.
fn rsa_priv_op(priv &PrivateKey, c &big.Int) big.Int {
    mut nn := big.new_int(0)
    nn.set(&priv.public.n)
    mut dd := big.new_int(0)
    dd.set(&priv.d)
    if priv.p.sign() <= 0 || priv.q.sign() <= 0 || priv.public.e <= 0 {
        << rsa_crypt(c, &dd, &nn)
    }
    mut p := big.new_int(0)
    p.set(&priv.p)
    mut q := big.new_int(0)
    q.set(&priv.q)
    if p.cmp(&q) == 0 {
        << rsa_crypt(c, &dd, &nn)
    }

    // Once blinding is enabled, entropy/inverse failures must not downgrade
    // to an unblinded private operation. Bare {n,d} keys retain the path above.
    mut one := big.new_int(1)
    mut ee := big.new_int(priv.public.e)
    mut c_blind := big.new_int(0)
    c_blind.set(c)
    mut rinv := big.new_int(1)
    k := n_size(&nn)
    high_mask := 255 >> (k * 8 - nn.bit_len())
    mut draws := 0
    while true {
        if draws >= 128 {
            >> errors.new("crypto/rsa: blinding random retry limit")
        }
        draws = draws + 1
        rbuf := rand.read(k) or >>
        mut rbytes := []int{}
        for i in 0:k {
            mut b := rbuf[i] & 255
            if i == 0 {
                b = b & high_mask
            }
            rbytes.push(b)
        }
        mut r := big.new_int(0)
        r.set_bytes(string_from_bytes(rbytes))
        if r.cmp(&one) <= 0 || r.cmp(&nn) >= 0 {
            ->
        }
        mut g := big.new_int(0)
        g.gcd(&r, &nn)
        if g.cmp(&one) != 0 {
            ->
        }
        rinv.mod_inverse(&r, &nn) or >>
        re := rsa_crypt(&r, &ee, &nn) or >>
        c_blind.mul(&c_blind, &re)
        c_blind.mod(&c_blind, &nn) or >>
        <-
    }

    // CRT: dp = d mod (p-1), dq = d mod (q-1), qinv = q^-1 mod p
    mut pm1 := big.new_int(0)
    pm1.sub(&p, &one)
    mut qm1 := big.new_int(0)
    qm1.sub(&q, &one)
    mut dp := big.new_int(0)
    dp.mod(&dd, &pm1) or >>
    mut dq := big.new_int(0)
    dq.mod(&dd, &qm1) or >>
    mut qinv := big.new_int(0)
    qinv.mod_inverse(&q, &p) or >>

    mut cp := big.new_int(0)
    cp.mod(&c_blind, &p) or >>
    mut cq := big.new_int(0)
    cq.mod(&c_blind, &q) or >>
    m1 := rsa_crypt(&cp, &dp, &p) or >>
    m2 := rsa_crypt(&cq, &dq, &q) or >>

    mut diff := big.new_int(0)
    diff.sub(&m1, &m2)
    while diff.sign() < 0 {
        diff.add(&diff, &p)
    }
    mut h := big.new_int(0)
    h.mul(&qinv, &diff)
    h.mod(&h, &p) or >>

    mut hq := big.new_int(0)
    hq.mul(&h, &q)
    mut m := big.new_int(0)
    m.add(&m2, &hq)
    m.mod(&m, &nn) or >>

    m.mul(&m, &rinv)
    m.mod(&m, &nn) or >>
    << m
}

fn non_zero_ps(n int) string {
    mut out := []int{}
    mut guard := 0
    while out.len < n {
        if guard > 64 {
            >> errors.new("crypto/rsa: random read failed")
        }
        chunk := rand.read(n) or >>
        mut i := 0
        while i < chunk.len {
            b := chunk[i] & 255
            if b != 0 {
                out.push(b)
                if out.len == n {
                    <-
                }
            }
            i = i + 1
        }
        guard = guard + 1
    }
    << string_from_bytes(out)
}

pub fn encrypt_pkcs1v15(pk &PublicKey, msg &string) string {
    k := pk.size()
    if k < 12 {
        >> errors.new("crypto/rsa: message too long")
    }
    if msg.len > k - 11 {
        >> errors.new("crypto/rsa: message too long")
    }
    ps_len := k - msg.len - 3
    ps := non_zero_ps(ps_len) or >>
    mut em := []int{}
    em.push(0)
    em.push(2)
    mut i := 0
    while i < ps.len {
        em.push(ps[i] & 255)
        i = i + 1
    }
    em.push(0)
    i = 0
    while i < msg.len {
        em.push(msg[i] & 255)
        i = i + 1
    }
    raw := string_from_bytes(em)
    mut m := big.new_int(0)
    m.set_bytes(raw)
    mut ee := big.new_int(pk.e)
    mut nn := big.new_int(0)
    nn.set(&pk.n)
    c := rsa_crypt(&m, &ee, &nn) or >>
    << i2osp(&c, k)
}

fn b2i_ct(cond bool) int {
    if cond {
        << 1
    }
    << 0
}

pub fn decrypt_pkcs1v15(priv &PrivateKey, ciphertext &string) string {
    pk := &priv.public
    k := pk.size()
    if ciphertext.len != k || k < 11 {
        >> errors.new("crypto/rsa: decryption error")
    }
    mut c := big.new_int(0)
    c.set_bytes(ciphertext + "")
    mut nn := big.new_int(0)
    nn.set(&pk.n)
    if c.cmp(&nn) >= 0 {
        >> errors.new("crypto/rsa: decryption error")
    }
    m := rsa_priv_op(priv, &c) or >>
    em := i2osp(&m, k) or >>

    // Constant-time scan of PKCS#1 v1.5 header (0x00 0x02 <PS >= 8 bytes> 0x00)
    // to mitigate Bleichenbacher padding oracle side channels.
    b0_ok := subtle.constant_time_byte_eq(em[0] & 255, 0)
    b1_ok := subtle.constant_time_byte_eq(em[1] & 255, 2)
    mut found := 0
    mut sep_idx := 0
    mut i := 2
    while i < em.len {
        is_zero := subtle.constant_time_byte_eq(em[i] & 255, 0)
        first_zero := (1 - found) & is_zero
        sep_idx = subtle.constant_time_select(first_zero, i, sep_idx)
        found = found | is_zero
        i = i + 1
    }
    ps_ok := b2i_ct(sep_idx >= 10)
    valid := b0_ok & b1_ok & found & ps_ok
    if valid != 1 {
        >> errors.new("crypto/rsa: decryption error")
    }
    << em[(sep_idx + 1):em.len]
}

fn emsa_pkcs1v15(k int, hash int, hashed &string) string {
    t := digestinfo(hash, hashed) or >>
    if k < t.len + 11 {
        >> errors.new("crypto/rsa: message too long")
    }
    ps_len := k - t.len - 3
    mut em := []int{}
    em.push(0)
    em.push(1)
    mut i := 0
    while i < ps_len {
        em.push(255)
        i = i + 1
    }
    em.push(0)
    i = 0
    while i < t.len {
        em.push(t[i] & 255)
        i = i + 1
    }
    << string_from_bytes(em)
}

pub fn sign_pkcs1v15(priv &PrivateKey, hash int, hashed &string) string {
    pk := &priv.public
    k := pk.size()
    ems := emsa_pkcs1v15(k, hash, hashed) or >>
    mut m := big.new_int(0)
    m.set_bytes(ems)
    s := rsa_priv_op(priv, &m) or >>
    << i2osp(&s, k)
}

pub fn verify_pkcs1v15(pk &PublicKey, hash int, hashed &string, sig &string) int {
    k := pk.size()
    if sig.len != k {
        >> errors.new("crypto/rsa: verification error")
    }
    want := emsa_pkcs1v15(k, hash, hashed) or >>
    mut s := big.new_int(0)
    s.set_bytes(sig + "")
    mut nn := big.new_int(0)
    nn.set(&pk.n)
    if s.cmp(&nn) >= 0 {
        >> errors.new("crypto/rsa: verification error")
    }
    mut ee := big.new_int(pk.e)
    m := rsa_crypt(&s, &ee, &nn) or >>
    got := i2osp(&m, k) or >>
    if subtle.constant_time_compare(&got, &want) != 1 {
        >> errors.new("crypto/rsa: verification error")
    }
    << 0
}

fn rand_odd(bits int) big.Int {
    if bits < 2 {
        >> errors.new("crypto/rsa: too few bits")
    }
    nbytes := (bits + 7) / 8
    extra := nbytes * 8 - bits
    buf := rand.read(nbytes) or >>
    mut b := []int{}
    mut i := 0
    while i < buf.len {
        b.push(buf[i] & 255)
        i = i + 1
    }
    keep := (1 << (8 - extra)) - 1
    b[0] = b[0] & keep
    b[0] = b[0] | (1 << (7 - extra))
    b[nbytes - 1] = b[nbytes - 1] | 1
    mut z := big.new_int(0)
    z.set_bytes(string_from_bytes(b))
    << z
}

fn coprime_e(p &big.Int, e &big.Int) bool {
    mut one := big.new_int(1)
    mut pm1 := big.new_int(0)
    pm1.sub(p, &one)
    mut g := big.new_int(0)
    g.gcd(&pm1, e)
    << g.cmp(&one) == 0
}

fn rand_prime(bits int) big.Int {
    mut ee := big.new_int(65537)
    mut tries := 0
    while tries < 100000 {
        tries = tries + 1
        mut z := rand_odd(bits) or >>
        if !coprime_e(&z, &ee) {
            ->
        }
        if z.probably_prime(8) {
            << z
        }
    }
    >> errors.new("crypto/rsa: prime generation failed")
    << big.new_int(0)
}

pub fn generate_key(bits int) PrivateKey {
    if bits < 64 {
        >> errors.new("crypto/rsa: too few bits to represent an RSA key")
    }
    pbits := bits / 2
    qbits := bits - pbits
    mut ee := big.new_int(65537)
    mut p := rand_prime(pbits) or >>
    mut q := rand_prime(qbits) or >>
    mut guard := 0
    mut n := big.new_int(0)
    n.mul(&p, &q)
    while n.bit_len() != bits || p.cmp(&q) == 0 {
        if guard > 64 {
            >> errors.new("crypto/rsa: key generation failed")
        }
        // A p near its lower bit boundary can make a full-width product
        // exceptionally unlikely for every q in this retry budget. Draw a
        // fresh pair so rejection does not keep conditioning on that p.
        p = rand_prime(pbits) or >>
        q = rand_prime(qbits) or >>
        n.mul(&p, &q)
        guard = guard + 1
    }
    if p.cmp(&q) < 0 {
        mut t := big.new_int(0)
        t.set(&p)
        p.set(&q)
        q.set(&t)
    }
    mut one := big.new_int(1)
    mut pm1 := big.new_int(0)
    pm1.sub(&p, &one)
    mut qm1 := big.new_int(0)
    qm1.sub(&q, &one)
    mut g := big.new_int(0)
    g.gcd(&pm1, &qm1)
    mut prod := big.new_int(0)
    prod.mul(&pm1, &qm1)
    mut lam := big.new_int(0)
    lam.quo(&prod, &g) or >>
    mut d := big.new_int(0)
    d.mod_inverse(&ee, &lam) or >>
    pk := PublicKey{n: n, e: 65537}
    << PrivateKey{public: pk, d: d, p: p, q: q}
}
