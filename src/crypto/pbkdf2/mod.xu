@crypto/pbkdf2

#crypto/hmac
#crypto/sha256
#errors

// PBKDF2 key derivation function per RFC 2898 / RFC 8018 (using HMAC-SHA-256).
// Aligned with Go `golang.org/x/crypto/pbkdf2`.
//
// Key derives a key of key_len bytes from password and salt using iter iterations
// of HMAC-SHA-256.

const HASH_LEN = 32

fn uint32_be(n int) string {
    $b := []int{}
    b.push((n >> 24) & 255)
    b.push((n >> 16) & 255)
    b.push((n >> 8) & 255)
    b.push(n & 255)
    << string_from_bytes(b)
}

fn xor_bytes(a &string, b &string) string {
    $out := []int{}
    $i := 0
    while i < a.len && i < b.len {
        out.push((a[i] & 255) ^ (b[i] & 255))
        i = i + 1
    }
    << string_from_bytes(out)
}

// key derives a cryptographic key of key_len bytes from password and salt across iter rounds.
pub fn key(password &string, salt &string, iter int, key_len int) string {
    if iter <= 0 {
        >> errors.new("crypto/pbkdf2: iteration count must be positive")
    }
    if key_len <= 0 {
        << ""
    }
    pwd := password + ""
    s := salt + ""
    $out := ""
    $block := 1
    while out.len < key_len {
        be_idx := uint32_be(block)
        init_data := s + be_idx
        $u := hmac.sum256_bytes(&pwd, &init_data)
        $t := u + ""
        $round := 1
        while round < iter {
            u = hmac.sum256_bytes(&pwd, &u)
            t = xor_bytes(&t, &u)
            round = round + 1
        }
        $take := key_len - out.len
        if take > HASH_LEN {
            take = HASH_LEN
        }
        out = out + t[0:take]
        block = block + 1
    }
    << out
}
