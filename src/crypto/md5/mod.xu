pub fn (d &mut Digest) write(p &string) int {
    n := p.len
    if n == 0 {
        << 0
    }
    mut i := 0
    if d.buf.len > 0 {
        need := 64 - d.buf.len
        mut take := n
        if take > need {
            take = need
        }
        mut piece := []int{}
        mut bi := 0
        while bi < d.buf.len {
            piece.push(d.buf[bi] & 255)
            bi = bi + 1
        }
        mut j := 0
        while j < take {
            piece.push(p[j] & 255)
            j = j + 1
        }
        i = take
        if piece.len == 64 {
            block := string_from_bytes(piece)
            d.compress_block(&block, 0)
            d.buf = ""
        } else {
            d.buf = string_from_bytes(piece)
        }
    }
    while i + 64 <= n {
        d.compress_block(p, i)
        i += 64
    }
    if i < n {
        mut rest := []int{}
        mut j := i
        while j < n {
            rest.push(p[j] & 255)
            j = j + 1
        }
        extra := string_from_bytes(rest)
        r := mut &d.buf
        r.push_str(extra)
    }
    d.n = d.n + n
    << n
}

pub fn (d &mut Digest) reset() {
    d.st = iv()
    d.buf = ""
    d.n = 0
}

pub fn (d Digest) size() int {
    << 16
}

pub fn (d Digest) blocksize() int {
    << 64
}

pub fn (d &Digest) sum() string {
    mut tmp := new()
    tmp.st = State{h0: d.st.h0, h1: d.st.h1, h2: d.st.h2, h3: d.st.h3}
    buf := d.buf + ""
    rem := buf.len
    if rem < 56 {
        mut h0 := tmp.st.h0
        mut h1 := tmp.st.h1
        mut h2 := tmp.st.h2
        mut h3 := tmp.st.h3
        compress_words(mut &h0, mut &h1, mut &h2, mut &h3, &buf, 0, d.n)
        tmp.st.h0 = h0
        tmp.st.h1 = h1
        tmp.st.h2 = h2
        tmp.st.h3 = h3
    } else {
        tail := pad_tail(&buf, 0, d.n)
        mut po := 0
        while po + 64 <= tail.len {
            tmp.compress_block(&tail, po)
            po += 64
        }
    }
    << hex_state(&tmp.st)
}
