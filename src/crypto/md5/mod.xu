@crypto/md5

core #runtime/core

// MD5 aligned with Go `crypto/md5` (Sum and streaming Digest).
// Little-endian word order per RFC 1321. sum returns the 32-char lowercase
// hex digest; Digest.write compresses 64-byte windows in place.

struct State {
    h0 int
    h1 int
    h2 int
    h3 int
}

fn iv() State {
    << State{h0: 0x67452301, h1: 0xefcdab89, h2: 0x98badcfe, h3: 0x10325476}
}

pub fn sum(s string) string {
    << core.md5_sum(&s)
}

pub struct Digest {
    st  State
    buf string
    n   int
}

pub fn new() Digest {
    << Digest{st: iv(), buf: "", n: 0}
}

fn (d $&Digest) compress_block(s &string, off int) {
    $h0 := d.st.h0
    $h1 := d.st.h1
    $h2 := d.st.h2
    $h3 := d.st.h3
    core.md5_compress_block($&h0, $&h1, $&h2, $&h3, s, off)
    d.st.h0 = h0
    d.st.h1 = h1
    d.st.h2 = h2
    d.st.h3 = h3
}

pub fn (d $&Digest) write(p &string) int {
    n := p.len
    if n == 0 {
        << 0
    }
    $i := 0
    if d.buf.len > 0 {
        need := 64 - d.buf.len
        $take := n
        if take > need {
            take = need
        }
        r := $&d.buf
        r.push_str(p[0:take])
        i = take
        if d.buf.len == 64 {
            block := d.buf + ""
            d.compress_block(&block, 0)
            d.buf = ""
        }
    }
    while i + 64 <= n {
        d.compress_block(p, i)
        i += 64
    }
    if i < n {
        r := $&d.buf
        r.push_str(p[i:n])
    }
    d.n = d.n + n
    << n
}

pub fn (d $&Digest) reset() {
    d.st = iv()
    d.buf = ""
    d.n = 0
}

pub fn (d Digest) size() int {
    << 16
}

pub fn (d Digest) blocksize() int {
    << 64
}

pub fn (d &Digest) sum() string {
    $h0 := d.st.h0
    $h1 := d.st.h1
    $h2 := d.st.h2
    $h3 := d.st.h3
    buf := d.buf + ""
    << core.md5_finish_tail($&h0, $&h1, $&h2, $&h3, &buf, 0, d.n)
}
