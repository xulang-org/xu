@crypto/hmac

#crypto/sha256
#crypto/sm3
#crypto/subtle
#encoding/hex

// HMAC-SHA-256 aligned with Go `crypto/hmac` used with sha256.New.
// HMAC-SM3 is a Xu addition (Go has no SM3). Key > 64 bytes is hashed
// first (RFC 2104; SM3 block is also 64). sum256 / sum_sm3 return
// 64-char lowercase hex. new256 / new_sm3 return Digest (write/sum/
// reset/size/blocksize) — Xu has no generic hash.Hash. Inner/outer
// hashes use raw 32-byte digests and Digest.write (no hex round-trip,
// no ip||data concatenation). equal uses crypto/subtle.constant_time_compare.
// XU-CT-USE: fixed-shape-only
// Only equal's equal-length comparison inherits that narrow execution-shape
// contract; HMAC and its hash implementations have no whole-operation timing
// contract.

const block = 64
const ipad = 54 // 0x36
const opad = 92 // 0x5c

fn xor_pad(key &string, pad int) string {
    mut b := []int{}
    for i in 0:block {
        mut k := 0
        if i < key.len {
            k = key[i] & 255
        }
        b.push(k ^ pad)
    }
    << string_from_bytes(b)
}

pub fn sum256(key &string, data &string) string {
    mut k := key + ""
    if k.len > block {
        k = sha256.sum256_bytes(k + "")
    }
    ip := xor_pad(&k, ipad)
    op := xor_pad(&k, opad)
    mut inner := sha256.new()
    inner.write(&ip)
    inner.write(data)
    raw := inner.sum_bytes()
    mut outer := sha256.new()
    outer.write(&op)
    outer.write(&raw)
    << outer.sum()
}

pub fn sum_sm3(key &string, data &string) string {
    mut k := key + ""
    if k.len > block {
        k = sm3.sum_bytes(k + "")
    }
    ip := xor_pad(&k, ipad)
    op := xor_pad(&k, opad)
    mut inner := sm3.new()
    inner.write(&ip)
    inner.write(data)
    raw := inner.sum_bytes()
    mut outer := sm3.new()
    outer.write(&op)
    outer.write(&raw)
    << outer.sum()
}

pub fn equal(a &string, b &string) bool {
    << subtle.constant_time_compare(a, b) == 1
}

pub struct Digest {
    kind int
    inner_sha sha256.Digest
    inner_sm3 sm3.Digest
    ipad string
    opad string
}

fn key_sha(key &string) string {
    mut k := key + ""
    if k.len > block {
        k = sha256.sum256_bytes(k + "")
    }
    << k
}

fn key_sm3(key &string) string {
    mut k := key + ""
    if k.len > block {
        k = sm3.sum_bytes(k + "")
    }
    << k
}

pub fn new256(key &string) Digest {
    k := key_sha(key)
    ip := xor_pad(&k, ipad)
    op := xor_pad(&k, opad)
    mut inner := sha256.new()
    inner.write(&ip)
    dummy := sm3.new()
    << Digest{kind: 0, inner_sha: inner, inner_sm3: dummy, ipad: ip, opad: op}
}

pub fn new_sm3(key &string) Digest {
    k := key_sm3(key)
    ip := xor_pad(&k, ipad)
    op := xor_pad(&k, opad)
    mut inner := sm3.new()
    inner.write(&ip)
    dummy := sha256.new()
    << Digest{kind: 1, inner_sha: dummy, inner_sm3: inner, ipad: ip, opad: op}
}

pub fn (d &mut Digest) write(p &string) int {
    kind := d.kind
    if kind == 0 {
        inn := mut &d.inner_sha
        << inn.write(p)
    }
    inn := mut &d.inner_sm3
    << inn.write(p)
}

pub fn (d &Digest) sum_bytes() string {
    op := d.opad + ""
    kind := d.kind
    if kind == 0 {
        inn := &d.inner_sha
        raw := inn.sum_bytes()
        mut outer := sha256.new()
        outer.write(&op)
        outer.write(&raw)
        << outer.sum_bytes()
    }
    inn := &d.inner_sm3
    raw := inn.sum_bytes()
    mut outer := sm3.new()
    outer.write(&op)
    outer.write(&raw)
    << outer.sum_bytes()
}

pub fn (d &Digest) sum() string {
    raw := d.sum_bytes()
    << hex.encode_to_string(raw)
}

pub fn (d &mut Digest) reset() {
    ip := d.ipad + ""
    kind := d.kind
    if kind == 0 {
        inn := mut &d.inner_sha
        inn.reset()
        inn.write(&ip)
        <<
    }
    inn := mut &d.inner_sm3
    inn.reset()
    inn.write(&ip)
}

pub fn (d Digest) size() int {
    << 32
}

pub fn (d Digest) blocksize() int {
    << block
}
